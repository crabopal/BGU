#Область ПрограммныйИнтерфейс

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	ЕстьОшибки = Ложь;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("МетаданныеТабличныхЧастей", Метаданные.Документы.АктОРезультатахИнвентаризации.ТабличныеЧасти);
	ДополнительныеПараметры.Вставить("КодыСтрокПриложений", Новый Соответствие());
	ДополнительныеПараметры.Вставить("ВалютаРУ", Константы.ВалютаРегламентированногоУчета.Получить());
	ДополнительныеПараметры.Вставить("НомераПриложенийКРазделу2", ПолучитьНомераПриложенийКРазделу(2));
	
	// Разделы
	ПроверитьНаличиеСтрокВРазделах(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	
	// Коды строк приложений
	
	ПроверитьКорректностьКодовСтрокПриложений(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьНаличиеСтрокПриложений(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьДублиКодовСтрокПриложений(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	
	// Приложения к разделу 2
	
	ПроверитьПриложение2кРазделу2(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение3кРазделу2(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение4кРазделу2(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение5кРазделу2(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение6кРазделу2(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение7кРазделу2(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение8кРазделу2(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение9кРазделу2(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение10кРазделу2(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение111кРазделу2(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение112кРазделу2(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение12кРазделу2(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	
	// Приложения к разделу 3
	
	ПроверитьПриложение1кРазделу3(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение2кРазделу3(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение3кРазделу3(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение4кРазделу3(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение5кРазделу3(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение6кРазделу3(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	
	ПроверитьПриложение8кРазделу3(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение9кРазделу3(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	ПроверитьПриложение10кРазделу3(ДокументОбъект, ЕстьОшибки, ДополнительныеПараметры);
	
	ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ДокументОбъект, ЕстьОшибки);
	
	Возврат ЕстьОшибки;
	
КонецФункции

#Область НастройкаФорм

Процедура ИнициализироватьФормуДокумента(ФормаДокумента) Экспорт
	
	ФормаДокумента.ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ИнициализироватьДатуРешения(ФормаДокумента);
	
	ИнициализироватьТаблицуОбъектыРешения(ФормаДокумента);
	
	ИнициализироватьКэшУчетныеГруппыКонтрагентов(ФормаДокумента);
	
	ИнициализироватьНастройкиКодовФорм(ФормаДокумента);
	
	ИнициализироватьДопустимостьДобавленияСтрокТабличныхЧастей(ФормаДокумента);
	
	ФормаДокумента.ЗабалансовыеСчетаРасчетов.ЗагрузитьЗначения(ПолучитьСпискиЗабалансовыхСчетовРасчетов().Все);
	ФормаДокумента.Счета30300.ЗагрузитьЗначения(ПолучитьСписокСчетов30300());
	
	ИнициализироватьОписаниеОписиРасходовБудущихПериодов(ФормаДокумента);
	
	ОбщегоНазначенияБГУ.УстановитьНедоступныеЭлементыФормы(ФормаДокумента.Элементы, ФормаДокумента.Объект,
		"Раздел1ПереместитьСтрокуВРаздел2,"
		+ "Раздел1ПереместитьСтрокуВРаздел3,"
		+ "ДобавитьОписьВПриложение2,"
		+ "ДобавитьОписьВПриложение3,"
		
		+ "Приложение1кРазделу2ГрупповоеЗаполнениеСтрок,"
		+ "Приложение2кРазделу2ГрупповоеЗаполнениеСтрок,"
		+ "Приложение3кРазделу2ГрупповоеЗаполнениеСтрок,"
		+ "Приложение4кРазделу2ГрупповоеЗаполнениеСтрок,"
		+ "Приложение5кРазделу2ГрупповоеЗаполнениеСтрок,"
		+ "Приложение6кРазделу2ГрупповоеЗаполнениеСтрок,"
		+ "Приложение7кРазделу2ГрупповоеЗаполнениеСтрок,"
		+ "Приложение8кРазделу2ГрупповоеЗаполнениеСтрок,"
		+ "Приложение9кРазделу2ГрупповоеЗаполнениеСтрок,"
		+ "Приложение10кРазделу2ГрупповоеЗаполнениеСтрок,"
		+ "Приложение111кРазделу2ГрупповоеЗаполнениеСтрок,"
		+ "Приложение112кРазделу2ГрупповоеЗаполнениеСтрок,"
		+ "Приложение12кРазделу2ГрупповоеЗаполнениеСтрок,"
		+ "Приложение13кРазделу2ГрупповоеЗаполнениеСтрок,"
		
		+ "Приложение1кРазделу3ГрупповоеЗаполнениеСтрок,"
		+ "Приложение2кРазделу3ГрупповоеЗаполнениеСтрок,"
		+ "Приложение3кРазделу3ГрупповоеЗаполнениеСтрок,"
		+ "Приложение4кРазделу3ГрупповоеЗаполнениеСтрок,"
		+ "Приложение5кРазделу3ГрупповоеЗаполнениеСтрок,"
		+ "Приложение6кРазделу3ГрупповоеЗаполнениеСтрок,"
		+ "Приложение7кРазделу3ГрупповоеЗаполнениеСтрок,"
		+ "Приложение8кРазделу3ГрупповоеЗаполнениеСтрок,"
		+ "Приложение9кРазделу3ГрупповоеЗаполнениеСтрок,"
		+ "Приложение10кРазделу3ГрупповоеЗаполнениеСтрок");

	// Разделы
	
	ИнициализироватьСпискиВыбораТиповОписей(ФормаДокумента);
	
	// Приложения
	
	ИнициализироватьКэшКодыСтрокПриложений(ФормаДокумента);
	
	НастроитьСпискиВыбораСтатусовЗадолженности0510471(ФормаДокумента);
	
	// Состав комиссии
	
	НедоступныеКолонки = Новый Массив();
	НедоступныеКолонки.Добавить("СоставКомиссииСотрудник");
	
	ИнвентаризацияСервер.НастроитьНедоступностьИзмененияКолонокНаФормеОписи(ФормаДокумента, НедоступныеКолонки, Ложь);
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриСозданииНаСервере(ФормаДокумента);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ИнициализироватьФормуДокументаЗамещениеЧленаКомиссии(ФормаДокумента);
	// Конец ЗамещениеЧленаКомиссии
	
	УстановитьУсловноеОформление(ФормаДокумента);
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_КФО0(ФормаДокумента, НомерРаздела = Неопределено, ДляФормыВыбораСтрокиТаблицыОбъектыРешения = Ложь) Экспорт
	
	Если ДляФормыВыбораСтрокиТаблицыОбъектыРешения Тогда
		ИмяТЧ = "ТаблицаОбъектыРешения";
		
		ИмяПоляУсловия = ИмяТЧ + ".КФО";
	Иначе
		ИмяТЧ = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
		
		ИмяПоляУсловия = "Объект." + ИмяТЧ + ".КФО";
	КонецЕсли;
	
	УсловноеОформление = ФормаДокумента.УсловноеОформление;
	
	ПредставлениеШаблон = НСтр("ru='Представление КФО 0 (%1)'");
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблон, ИмяТЧ);

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляУсловия);
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "0");

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + "КФО");
	
КонецПроцедуры

Процедура ИнициализироватьДатуРешения(ФормаДокумента) Экспорт
	
	ДатаРешения = '00010101';
	
	РешениеОПроведенииИнвентаризации = ФормаДокумента.Объект.РешениеОПроведенииИнвентаризации;
	
	Если ЗначениеЗаполнено(РешениеОПроведенииИнвентаризации) Тогда
		ДатаРешения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РешениеОПроведенииИнвентаризации, "Дата");
	КонецЕсли;
	
	ФормаДокумента.ДатаРешения = ДатаРешения;
	
КонецПроцедуры

Процедура ИнициализироватьТаблицуОбъектыРешения(ФормаДокумента, ТаблицаОбъекты = Неопределено) Экспорт
	
	РешениеОПроведенииИнвентаризации = ФормаДокумента.Объект.РешениеОПроведенииИнвентаризации;
	
	Если Не ЗначениеЗаполнено(РешениеОПроведенииИнвентаризации) Тогда
		ФормаДокумента.ТаблицаОбъектыРешения.Очистить();
		
		Возврат;
	КонецЕсли;
	
	Если ТаблицаОбъекты = Неопределено Тогда
		ДанныеРешения = Документы.ИзменениеРешенияОПроведенииИнвентаризации.ПолучитьДанныеДляЗаполненияНаОсновании(
			РешениеОПроведенииИнвентаризации, Неопределено);
		
		ТаблицаОбъекты = ДанныеРешения.ТаблицаОбъекты;
	КонецЕсли;
	
	Если ТаблицаОбъекты.Колонки.Найти("ТипИзменения") <> Неопределено Тогда
		УдалитьОтмененныеСтроки(ТаблицаОбъекты);
	КонецЕсли;
	
	// Берем не всю таблицу объектов из Решения, а только строки
	// с указанной датой инвентаризацией и номером комиссии.
	Поиск = Новый Структура();
	Если ЗначениеЗаполнено(ФормаДокумента.Объект.ДатаИнвентаризации) Тогда
		Поиск.Вставить("ДатаИнвентаризации");
	КонецЕсли;
	Если ЗначениеЗаполнено(ФормаДокумента.Объект.НомерКомиссии) Тогда
		Поиск.Вставить("НомерКомиссии");
	КонецЕсли;
	Если Поиск.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(Поиск, ФормаДокумента.Объект);

		ТаблицаОбъекты = ТаблицаОбъекты.Скопировать(Поиск);
	КонецЕсли;
	
	ТаблицаОбъекты.Колонки.Сотрудник.Имя = "ОтветственноеЛицо";
	
	ИнвентаризацияСервер.ЗаполнитьКодыФормВТаблицеОбъектыРешения(ТаблицаОбъекты,
		ФормаДокумента.Объект.Организация, ФормаДокумента.ДатаРешения);
	
	ФормаДокумента.ТаблицаОбъектыРешения.Загрузить(ТаблицаОбъекты);
	
КонецПроцедуры

Процедура ИнициализироватьКэшУчетныеГруппыКонтрагентов(ФормаДокумента) Экспорт
	
	КэшУчетныеГруппыКонтрагентов = Новый Структура();
	
	ПустаяУчетнаяГруппаКонтрагентов = Справочники.Контрагенты.ПустаяСсылка();
	
	ОписанияПриложений = ПолучитьОписанияПриложенийСУчетнымиГруппамиКонтрагентов();
	
	Для Каждого ОписаниеПриложения Из ОписанияПриложений Цикл
		НомерПриложения	= ОписаниеПриложения.НомерПриложения;
		НомерРаздела	= ОписаниеПриложения.НомерРаздела;
		
		ТЧУчетныеГруппы = ФормаДокумента.Объект[ПолучитьИмяТабличнойЧастиУчетныеГруппыКонтрагентов(НомерПриложения, НомерРаздела)];
		
		ПорядковыйНомер = ПолучитьПорядковыйНомерУчетнойГруппыКонтрагентов(ПустаяУчетнаяГруппаКонтрагентов, ТЧУчетныеГруппы);
		
		ДанныеПриложения = НовыйДанныеПриложенияСУчетнымиГруппамиКонтрагентов();
		ДанныеПриложения.ПорядковыйНомерПустойУчетнойГруппы.Фактический = ПорядковыйНомер;
		
		Если ПорядковыйНомер = Неопределено Тогда
			ДанныеПриложения.ПорядковыйНомерПустойУчетнойГруппы.Планируемый =
				ПолучитьПланируемыйПорядковыйНомерПустойУчетнойГруппыКонтрагентов(ТЧУчетныеГруппы, Ложь);
		КонецЕсли;
		
		ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
		
		КэшУчетныеГруппыКонтрагентов.Вставить(ИмяТЧПриложения, ДанныеПриложения);
	КонецЦикла;
	
	ФормаДокумента.КэшУчетныеГруппыКонтрагентов = Новый ФиксированнаяСтруктура(КэшУчетныеГруппыКонтрагентов);
	
КонецПроцедуры

Процедура ИнициализироватьКэшКодыСтрокПриложений(ФормаДокумента, ОтборСтрокиРаздела = Неопределено) Экспорт
	
	// Структура
	//	* Ключ		- Строка	- имя табличной части приложения
	//	* Значение	- Структура	- кэшируемые сведения для указанной табличной части
	//
	//		** Ключ "МаксимальныеПорядковыеНомера"
	//		** Значение		- Соответствие - максимальные порядковые номера для каждого номера строки раздела
	//			*** Ключ		- Число	- номер строки раздела
	//			*** Значение	- Число	- максимальный номер для такого номера строки раздела
	//
	//		** Ключ "НоваяСтрока"
	//		** Значение		- СписокЗначений - список значений для кода строки приложения, выводимый для новой строки приложения
	//		
	//		** Предопределенный ключ "СуществующаяСтрока"
	//		** Значение		- Соответствие - списки значений для каждого номера строки раздела, выводимые для уже существующей строки приложения.
	//			*** Ключ		- Число	- номер строки раздела
	//			*** Значение	- СписокЗначений - список значений для кода строки приложения
	
	Если ОтборСтрокиРаздела <> Неопределено Тогда
		МаксимальныеПорядковыеНомера	= ФормаДокумента.КэшКодыСтрокПриложений.МаксимальныеПорядковыеНомера;
		СпискиВыбораНоваяСтрока			= ФормаДокумента.КэшКодыСтрокПриложений.СпискиВыбораНоваяСтрока;
		СпискиВыбораСуществующаяСтрока	= ФормаДокумента.КэшКодыСтрокПриложений.СпискиВыбораСуществующаяСтрока;
	Иначе
		МаксимальныеПорядковыеНомера	= Новый Структура();
		СпискиВыбораНоваяСтрока			= Новый Структура();
		СпискиВыбораСуществующаяСтрока	= Новый Структура();
	КонецЕсли;
		
	ДопустимостьДобавленияСтрок = ДопустимостьДобавленияСтрок();
	
	Для Каждого НомерРаздела Из НомераРазделовСПриложениями() Цикл
		
		Если ОтборСтрокиРаздела <> Неопределено И НомерРаздела <> ОтборСтрокиРаздела.НомерРаздела Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
		
		ТЧРаздела = ФормаДокумента.Объект[ИмяТЧРаздела];
		
		Для Каждого ЭлементПриложения Из ПолучитьНомераПриложенийКРазделу(НомерРаздела) Цикл
			НомерПриложения = ЭлементПриложения.Значение;
			
			Если ОтборСтрокиРаздела <> Неопределено И ЗначениеЗаполнено(ОтборСтрокиРаздела.НомерПриложения) И НомерПриложения <> ОтборСтрокиРаздела.НомерПриложения Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
			
			Если Не ДопустимостьДобавленияСтрок.Свойство(ИмяТЧПриложения) Тогда
				Продолжить;
			КонецЕсли;
			
			ТЧПриложения = ФормаДокумента.Объект[ИмяТЧПриложения];
			
			МаксимальныеНомера = ПолучитьМаксимальныеПорядковыеНомера(ТЧПриложения);
			
			МаксимальныеПорядковыеНомера.Вставить(ИмяТЧПриложения, МаксимальныеНомера);
			
			СпискиВыбора = ПолучитьСпискиВыбораКодаСтрокиПриложения(ТЧРаздела, ТЧПриложения, НомерПриложения, МаксимальныеНомера);
			
			СпискиВыбораНоваяСтрока.Вставить(ИмяТЧПриложения, СпискиВыбора.НоваяСтрока);
			
			СпискиВыбораСуществующаяСтрока.Вставить(ИмяТЧПриложения, СпискиВыбора.СуществующаяСтрока);
			
		КонецЦикла;
		
	КонецЦикла;
	
	КэшКодыСтрокПриложений = Новый Структура();
	КэшКодыСтрокПриложений.Вставить("МаксимальныеПорядковыеНомера",		МаксимальныеПорядковыеНомера);
	КэшКодыСтрокПриложений.Вставить("СпискиВыбораНоваяСтрока",			СпискиВыбораНоваяСтрока);
	КэшКодыСтрокПриложений.Вставить("СпискиВыбораСуществующаяСтрока",	СпискиВыбораСуществующаяСтрока);
	
	ФормаДокумента.КэшКодыСтрокПриложений = КэшКодыСтрокПриложений;
	
КонецПроцедуры

Процедура ИнициализироватьСпискиВыбораТиповОписей(ФормаДокумента) Экспорт
	
	// Типы описей определены в Решении через коды форм.
	
	ДокументыОписей							= ФормаДокумента.КэшНастройкиКодовФорм.ДокументыОписей;
	СоответствиеКодФормыИмяДокумента		= ФормаДокумента.КэшНастройкиКодовФорм.СоответствиеКодФормыИмяДокумента;
	ОписаниеОписиРасходовБудущихПериодов	= ФормаДокумента.КэшОписаниеОписиРасходовБудущихПериодов;
	
	ТаблицаПримененияОписейВРазделах = ПолучитьТаблицуПримененияОписейВРазделах(ДокументыОписей);
	
	СдвинутьОписьРБПвКонецТаблицы(ТаблицаПримененияОписейВРазделах, ОписаниеОписиРасходовБудущихПериодов);
	
	Если ФормаДокумента.ВыбиратьТолькоОписиПредусмотренныеРешением Тогда
		ОтборИменаОписей = ОпределитьОписиПредусмотренныеРешением(
			ФормаДокумента.ТаблицаОбъектыРешения,
			СоответствиеКодФормыИмяДокумента,
			ОписаниеОписиРасходовБудущихПериодов);
	Иначе
		ОтборИменаОписей = ОпределитьОписиДоступныеПоФункциональнымОпциям(СоответствиеКодФормыИмяДокумента, ОписаниеОписиРасходовБудущихПериодов);
	КонецЕсли;
	
	СпискиВыбораТиповОписей = СоставитьСпискиВыбораТиповОписей(ТаблицаПримененияОписейВРазделах, ОтборИменаОписей, ОписаниеОписиРасходовБудущихПериодов);
	
	ФормаДокумента.КэшСпискиВыбораТиповОписей = Новый ФиксированнаяСтруктура(СпискиВыбораТиповОписей);
	
КонецПроцедуры

Процедура ЗаполнитьСлужебныеКолонки(ФормаДокумента) Экспорт
	
	ЗаполнитьСлужебныеКолонки_КодСтроки(ФормаДокумента);
	
	ЗаполнитьСлужебныеКолонки_ЭтоОписьРБП(ФормаДокумента);
	
	ЗаполнитьСлужебныеКолонки_Приложение2кРазделу2(ФормаДокумента);
	ЗаполнитьСлужебныеКолонки_Приложение3кРазделу2(ФормаДокумента);
	
	ЗаполнитьСлужебныеКолонки_Приложение111кРазделу2(ФормаДокумента);
	ЗаполнитьСлужебныеКолонки_Приложение112кРазделу2(ФормаДокумента);
	ЗаполнитьСлужебныеКолонки_Приложение12кРазделу2(ФормаДокумента);
	
	ЗаполнитьСлужебныеКолонки_Приложение1кРазделу3(ФормаДокумента);
	ЗаполнитьСлужебныеКолонки_Приложение2кРазделу3(ФормаДокумента);
	ЗаполнитьСлужебныеКолонки_Приложение10кРазделу3(ФормаДокумента);
	
КонецПроцедуры

Процедура ЗаполнитьСлужебныеКолонкиПриложенияКРазделу(ФормаДокумента, ПараметрыДляДобавленияОписиВПриложение) Экспорт
	
	НомерПриложения	= ПараметрыДляДобавленияОписиВПриложение.НомерПриложения;
	НомерРаздела	= ПараметрыДляДобавленияОписиВПриложение.НомерРаздела;
	
	Если НомерПриложения = 2 И НомерРаздела = 2 Тогда
		ЗаполнитьСлужебныеКолонки_Приложение2кРазделу2(ФормаДокумента);
		
	ИначеЕсли НомерПриложения = 3 И НомерРаздела = 2 Тогда
		ЗаполнитьСлужебныеКолонки_Приложение3кРазделу2(ФормаДокумента);
		
	ИначеЕсли НомерПриложения = 111 И НомерРаздела = 2 Тогда
		ЗаполнитьСлужебныеКолонки_Приложение111кРазделу2(ФормаДокумента);
		
	ИначеЕсли НомерПриложения = 112 И НомерРаздела = 2 Тогда
		ЗаполнитьСлужебныеКолонки_Приложение112кРазделу2(ФормаДокумента);
		
	ИначеЕсли НомерПриложения = 12 И НомерРаздела = 2 Тогда
		ЗаполнитьСлужебныеКолонки_Приложение12кРазделу2(ФормаДокумента);
		
	ИначеЕсли НомерПриложения = 1 И НомерРаздела = 3 Тогда
		ЗаполнитьСлужебныеКолонки_Приложение1кРазделу3(ФормаДокумента);
		
	ИначеЕсли НомерПриложения = 2 И НомерРаздела = 3 Тогда
		ЗаполнитьСлужебныеКолонки_Приложение2кРазделу3(ФормаДокумента);
		
	ИначеЕсли НомерПриложения = 10 И НомерРаздела = 3 Тогда
		ЗаполнитьСлужебныеКолонки_Приложение10кРазделу3(ФормаДокумента);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПервыйКодСтрокиОписиВПриложении(ДокументОбъект, Опись, НомерПриложения, НомерРаздела) Экспорт
	
	Поиск = Новый Структура("Опись", Опись);
	
	ТЧПриложения = ДокументОбъект[ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела)];
	
	МассивСтрок = ТЧПриложения.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Возврат МассивСтрок[0].КодСтроки;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Процедура УдалитьНесопоставленныеСтрокиПриложений(ДокументОбъект, Знач НомерРаздела = Неопределено) Экспорт
	
	Если НомерРаздела = Неопределено Тогда
		НомераРазделовСПриложениями = НомераРазделовСПриложениями();
	Иначе
		НомераРазделовСПриложениями = Новый Массив();
		НомераРазделовСПриложениями.Добавить(НомерРаздела);
	КонецЕсли;
	
	Для Каждого НомерРаздела Из НомераРазделовСПриложениями Цикл
		УдалитьНесопоставленныеСтрокиПриложенийРаздела(ДокументОбъект, НомерРаздела);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриИзмененииОписиВРазделе(ДокументОбъект, ИзмененаСсылкаОписи, СтрокаРаздела, ИменаПолей) Экспорт
	
	Перем СтрокаТаблицыНастроек;
	
	Опись = СтрокаРаздела.Опись;
	
	НомерРаздела = ИменаПолей.НомерРаздела;
	
	Если ИзмененаСсылкаОписи Тогда
		РеквизитыОписи = ПолучитьРеквизитыОписи(Опись);
	
		ЗаполнитьЗначенияСвойств(СтрокаРаздела, РеквизитыОписи);
	Иначе
		РеквизитыОписи = Новый Структура("Опись,НомерОписи,ДатаОписи");
		
		ЗаполнитьЗначенияСвойств(РеквизитыОписи, СтрокаРаздела);
	КонецЕсли;
	
	ОбновитьСведенияОбОписиВПриложениях(ДокументОбъект, НомерРаздела, СтрокаРаздела.ИдентификаторСтроки, РеквизитыОписи);
	
	Если ИзмененаСсылкаОписи Тогда
		ДополнительныеРеквизиты = ПолучитьКодФормыИНомерПриложения(Опись, НомерРаздела);
		
		ЗаполнитьЗначенияСвойств(СтрокаРаздела, ДополнительныеРеквизиты);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеПоРешению

Процедура ЗаполнитьНаОсновании(Объект, ДанныеЗаполнения) Экспорт
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РешениеОПроведенииИнвентаризации")
		Или ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации") Тогда
		
		ЗаполнитьНаОсновании_РешениеОПроведенииИнвентаризации(Объект, ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьОбобщенныеДанныеРешения(РешениеСсылка, ПолучитьТаблицуОбъектыРешения = Ложь) Экспорт
	
	Результат = Новый Структура("
		|ПоследнееИзменение,
		|ТекстОшибки,
		|ДеревоДатИКомиссий,
		|ЕдинственноеЗначение,
		|Шапка,
		|ТаблицаОбъекты");
	
	ЕдинственноеЗначение = Новый Структура("
		|ДатаИнвентаризации,
		|НомерКомиссии,
		|Комиссия,
		|ИФО,
		|Подразделение");
	
	Шапка = Новый Структура("
		|Решение,
		|Организация,
		|ИФО,
		|Подразделение");
	
	РезультатПроверки = ИнвентаризацияСервер.ПостроитьДеревоДокументовДляВводаНаОсновании(РешениеСсылка, Неопределено);
	
	Если РезультатПроверки.Дерево.ТаблицаОшибок.Количество() > 0 Тогда	
		Результат.ТекстОшибки = НСтр("ru='Обнаружены ошибки построения цепочки документов для выбранного Решения.'");
		
		Возврат Результат;
		
	ИначеЕсли РезультатПроверки.Дерево.Аннулирующее = Истина Тогда
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru='Выбранное Решение аннулировано документом
				|%1.'"),
			РезультатПроверки.Дерево.АннулирующееИзменениеСсылка);
			
		Результат.ПоследнееИзменение = РезультатПроверки.Дерево.АннулирующееИзменениеСсылка;
		
		Возврат Результат;
	КонецЕсли;	
	
	ПоследнийДокумент = РезультатПроверки.Дерево.ПоследнийДокумент;
	
	ЭтоИзменениеРешения = (ТипЗнч(ПоследнийДокумент) = Тип("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации"));
	
	Если ЭтоИзменениеРешения Тогда
		Результат.ПоследнееИзменение = ПоследнийДокумент;
	КонецЕсли;
	
	ДеревоДатИКомиссий = Новый ДеревоЗначений();
	ДеревоДатИКомиссий.Колонки.Добавить("ДатаИнвентаризации",	ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ДеревоДатИКомиссий.Колонки.Добавить("НомерКомиссии",		ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный));
	ДеревоДатИКомиссий.Колонки.Добавить("Комиссия",				Новый ОписаниеТипов("СправочникСсылка.ПостоянноДействующиеКомиссии"));
	ДеревоДатИКомиссий.Колонки.Добавить("ЭтоГруппа",			Новый ОписаниеТипов("Булево"));
	
	Данные = Документы.ИзменениеРешенияОПроведенииИнвентаризации.ПолучитьДанныеДляЗаполненияНаОсновании(РешениеСсылка, Неопределено);
	
	ЗаполнитьЗначенияСвойств(Шапка, Данные.Шапка);
	
	ТаблицаОбъекты	= Данные.ТаблицаОбъекты;
	ТаблицаКомиссии	= Данные.ТаблицаКомиссии;
	
	СвернутаяТаблицаОбъекты = ТаблицаОбъекты.Скопировать(, "ДатаИнвентаризации,НомерКомиссии");
	СвернутаяТаблицаОбъекты.Свернуть("ДатаИнвентаризации,НомерКомиссии");
	СвернутаяТаблицаОбъекты.Сортировать("ДатаИнвентаризации ВОЗР,НомерКомиссии ВОЗР");
	
	// Удалим строки с пустой датой
	Поиск = Новый Структура("ДатаИнвентаризации", '00010101');
	МассивСтрок = СвернутаяТаблицаОбъекты.НайтиСтроки(Поиск);
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СвернутаяТаблицаОбъекты.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	// Единственное значение даты инвентаризации
	СвернутаяТаблицаПоДатам = СвернутаяТаблицаОбъекты.Скопировать(, "ДатаИнвентаризации");
	СвернутаяТаблицаПоДатам.Свернуть("ДатаИнвентаризации");
	
	Если СвернутаяТаблицаПоДатам.Количество() = 1 Тогда
		ЕдинственноеЗначение.ДатаИнвентаризации = СвернутаяТаблицаПоДатам[0].ДатаИнвентаризации;
	КонецЕсли;
	
	// Единственное значение номера комиссии
	ВремТаблицаПоКомиссиям = СвернутаяТаблицаОбъекты.Скопировать(, "НомерКомиссии");
	ВремТаблицаПоКомиссиям.Свернуть("НомерКомиссии");
	
	Если ВремТаблицаПоКомиссиям.Количество() = 1 Тогда
		НомерКомиссии = ВремТаблицаПоКомиссиям[0].НомерКомиссии;
		
		ЕдинственноеЗначение.НомерКомиссии = НомерКомиссии;
		ЕдинственноеЗначение.Комиссия = ТаблицаКомиссии[НомерКомиссии - 1].Комиссия;
	КонецЕсли;
	
	// Составляем дерево дат и комиссий
	ПредыдущаяСтрокаСвернутойТаблицы = Неопределено;
	
	Поиск = Новый Структура("ДатаИнвентаризации");
	
	Для Каждого СтрокаДаты Из СвернутаяТаблицаПоДатам Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаДаты);
		
		МассивСтрок = СвернутаяТаблицаОбъекты.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 1 Тогда
			// В дерево добавляем одну строку, без группировки по дате
			
			СтрокаСвернутойТаблицыОбъекты = МассивСтрок[0];
			
			НоваяСтрока = ДеревоДатИКомиссий.Строки.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСвернутойТаблицыОбъекты);
			
			НоваяСтрока.Комиссия = ТаблицаКомиссии[СтрокаСвернутойТаблицыОбъекты.НомерКомиссии - 1].Комиссия;
			
			Продолжить;
		КонецЕсли;
		
		// В дерево добавляем строку группировки по дате, и в нее добавляем дочерние строки
		
		НоваяСтрокаГруппы = ДеревоДатИКомиссий.Строки.Добавить();
		НоваяСтрокаГруппы.ДатаИнвентаризации	= СтрокаДаты.ДатаИнвентаризации;
		НоваяСтрокаГруппы.ЭтоГруппа				= Истина;
		
		Для Каждого СтрокаСвернутойТаблицыОбъекты Из МассивСтрок Цикл
			НоваяСтрока = НоваяСтрокаГруппы.Строки.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСвернутойТаблицыОбъекты);
			
			НоваяСтрока.Комиссия = ТаблицаКомиссии[СтрокаСвернутойТаблицыОбъекты.НомерКомиссии - 1].Комиссия;
		КонецЦикла;
	КонецЦикла;
	
	Результат.ЕдинственноеЗначение = ЕдинственноеЗначение;
	Результат.ДеревоДатИКомиссий = ДеревоДатИКомиссий;
	Результат.Шапка = Шапка;
	
	Если ПолучитьТаблицуОбъектыРешения Тогда
		Результат.ТаблицаОбъекты = ТаблицаОбъекты;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеПоОписям

Процедура ЗаполнитьИтогиПриложенийРасчетов(ТабличныеЧасти) Экспорт
	
	Для Каждого ОписаниеПриложения Из ПолучитьОписанияПриложенийРасчетов() Цикл
		ЗаполнитьИтогиПриложенияРасчетов(ТабличныеЧасти, ОписаниеПриложения);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьИтогиПриложения13КРазделу2(ТабличныеЧасти) Экспорт
	
	Для Каждого ОписаниеПриложения Из ПолучитьОписанияПриложенийРасчетов() Цикл
		ЗаполнитьИтогиПриложения13КРазделу2ПоСчету(ТабличныеЧасти);
	КонецЦикла;
	
КонецПроцедуры

Процедура УпорядочитьСтрокиПриложения(ФормаДокумента, ИмяТЧПриложения, ПараметрыУпорядочивания = Неопределено) Экспорт
	
	Документы.АктОРезультатахИнвентаризации.ИнициализироватьКэшКодыСтрокПриложений(ФормаДокумента);
	
	РассчитатьПеремещенияСтрокПриложения(ФормаДокумента, ИмяТЧПриложения, ПараметрыУпорядочивания);
	
	ПереместитьСтрокиПриложения(ФормаДокумента, ИмяТЧПриложения);
	
КонецПроцедуры

Функция ПолучитьРеквизитыОписи(ОписьСсылка) Экспорт
	
	РеквизитыОписи = Новый Структура("
		|Опись,
		|НомерОписи,
		|ДатаОписи,
		|ОтветственноеЛицо,
		|КФО,
		|Счет,
		|ДатаИнвентаризации,
		|ДатаНачала,
		|ДатаОкончания,
		|МестоИнвентаризации");
	
	РеквизитыОписи.Опись = ОписьСсылка;
	
	Если Не ЗначениеЗаполнено(ОписьСсылка) Или ТипЗнч(ОписьСсылка) = Тип("Строка") Тогда
		Возврат РеквизитыОписи;
	КонецЕсли;
	
	ИменаРеквизитов = СтрРазделить("Номер,Дата,ДатаИнвентаризации,ДатаНачала,ДатаОкончания", ", ", Ложь);
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(ТипЗнч(ОписьСсылка));
	
	СтрокаТаблицыНастроек = ТаблицаНастроек[0];
	
	ОписаниеРеквизитов = ИнвентаризацияСервер.ПолучитьОписаниеРасположенияРеквизитовОписи(СтрокаТаблицыНастроек);
	
	Если ОписаниеРеквизитов.Счет.РасположенВШапке Тогда
		ИменаРеквизитов.Добавить(ОписаниеРеквизитов.Счет.ИмяПоля);
	КонецЕсли;
	
	Если ОписаниеРеквизитов.КФО.РасположенВШапке Тогда
		ИменаРеквизитов.Добавить(ОписаниеРеквизитов.КФО.ИмяПоля);
	КонецЕсли;
	
	Если ОписаниеРеквизитов.Сотрудник.РасположенВШапке Тогда
		ИменаРеквизитов.Добавить(ОписаниеРеквизитов.Сотрудник.ИмяПоля);
	КонецЕсли;
	
	Если ОписаниеРеквизитов.МестоИнвентаризации.РасположенВШапке Тогда
		ИменаРеквизитов.Добавить(ОписаниеРеквизитов.МестоИнвентаризации.ИмяПоля);
	КонецЕсли;
	
	Свойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОписьСсылка, СтрСоединить(ИменаРеквизитов, ","));
	
	ЗаполнитьЗначенияСвойств(РеквизитыОписи, Свойства);
	
	РеквизитыОписи.НомерОписи = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		ОписьСсылка,
		Свойства.Номер);
		
	РеквизитыОписи.ДатаОписи = Свойства.Дата;
	
	Если ОписаниеРеквизитов.Счет.РасположенВШапке Тогда
		РеквизитыОписи.Счет = Свойства[ОписаниеРеквизитов.Счет.ИмяПоля];
	КонецЕсли;
	
	Если ОписаниеРеквизитов.КФО.РасположенВШапке Тогда
		РеквизитыОписи.КФО = Свойства[ОписаниеРеквизитов.КФО.ИмяПоля];
	КонецЕсли;
	
	Если ОписаниеРеквизитов.Сотрудник.РасположенВШапке Тогда
		РеквизитыОписи.ОтветственноеЛицо = Свойства[ОписаниеРеквизитов.Сотрудник.ИмяПоля];
	КонецЕсли;
	
	Если ОписаниеРеквизитов.МестоИнвентаризации.РасположенВШапке Тогда
		РеквизитыОписи.МестоИнвентаризации = Свойства[ОписаниеРеквизитов.МестоИнвентаризации.ИмяПоля];
	КонецЕсли;
	
	Возврат РеквизитыОписи;
	
КонецФункции

Функция ЭтоОписьСОпциональнымУказаниемОтветственногоЛица(ОписьСсылка) Экспорт
	
	ТипОписи = ТипЗнч(ОписьСсылка);
	
	Возврат ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах") // 0510472
		Или ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам") // 0510473
		Или ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям"); // 0510474
	
КонецФункции

