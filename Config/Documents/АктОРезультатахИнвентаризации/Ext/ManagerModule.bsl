#Область ОпределениеМестРегистрацииОписи

Функция ПолучитьПустуюТаблицуМестаРегистрацииОписей()
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Опись");
	Таблица.Колонки.Добавить("ДатаОписи",					ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	Таблица.Колонки.Добавить("НомерОписи",					Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Раздел1",						ТипБулево);
	Таблица.Колонки.Добавить("Раздел2",						ТипБулево);
	Таблица.Колонки.Добавить("Раздел3",						ТипБулево);
	Таблица.Колонки.Добавить("ТаблицаПриложений",			Новый ОписаниеТипов("ТаблицаЗначений"));
	Таблица.Колонки.Добавить("МассивСтрокТаблицыОбъекты",	Новый ОписаниеТипов("Массив"));
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьПустуюТаблицуПриложений()
	
	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный);
	
	ТаблицаПриложений = Новый ТаблицаЗначений();
	ТаблицаПриложений.Колонки.Добавить("СтрокаТаблицыОбъекты");
	ТаблицаПриложений.Колонки.Добавить("СтрокаОписи");
	ТаблицаПриложений.Колонки.Добавить("НомерПриложенияРаздела2",	ТипЧисло);
	ТаблицаПриложений.Колонки.Добавить("НомерПриложенияРаздела3",	ТипЧисло);
	ТаблицаПриложений.Колонки.Добавить("ДополнительныеПараметры",	Новый ОписаниеТипов("Структура"));
	
	Возврат ТаблицаПриложений;
	
КонецФункции

Процедура ИсключитьНекорректныеНастройкиМестРегистрации(ТаблицаМестаРегистрации)
	
	Поиск = Новый Структура("Раздел2,Раздел3", Ложь, Ложь);
	
	МассивСтрок = ТаблицаМестаРегистрации.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СтрокаТаблицы.Раздел1 = Истина;
	КонецЦикла;
	
	Поиск = Новый Структура("Раздел1", Истина);
	
	МассивСтрок = ТаблицаМестаРегистрации.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Если СтрокаТаблицы.Раздел2 Или СтрокаТаблицы.Раздел3 Тогда
			СтрокаТаблицы.Раздел1 = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция УпорядочитьНомераСтрок(НомераСтрок)
	
	ВремСписок = Новый СписокЗначений();
	
	Для Каждого Элемент Из НомераСтрок Цикл
		ВремСписок.Добавить(Элемент.Ключ);
	КонецЦикла;
	
	ВремСписок.СортироватьПоЗначению();
	
	Возврат ВремСписок.ВыгрузитьЗначения();
	
КонецФункции

Функция НовыйПредварительноеОписаниеНомераПриложенияРаздела()
	
	Описание = Новый Структура();
	Описание.Вставить("НомерПриложения");
	Описание.Вставить("ДополнительныеПараметры", Новый Структура());
	
	Возврат Описание;
	
КонецФункции

Процедура ДобавитьМестаРегистрацииПоМассивуНомеровПриложений(СтрокаМестаРегистрации, СтрокаТаблицыОбъекты, СтрокаОписи,
		Знач НомерПриложенияРаздела2, Знач НомерПриложенияРаздела3)
	
	Если ТипЗнч(НомерПриложенияРаздела2) = Тип("Массив") Тогда
		МассивНомеров2 = НомерПриложенияРаздела2;
	Иначе
		МассивНомеров2 = Новый Массив();
		МассивНомеров2.Добавить(НомерПриложенияРаздела2);
	КонецЕсли;
	
	Если ТипЗнч(НомерПриложенияРаздела3) = Тип("Массив") Тогда
		МассивНомеров3 = НомерПриложенияРаздела3;
	Иначе
		МассивНомеров3 = Новый Массив();
		МассивНомеров3.Добавить(НомерПриложенияРаздела3);
	КонецЕсли;
	
	Количество2 = МассивНомеров2.Количество();
	Количество3 = МассивНомеров3.Количество();
	
	ОбщееКоличество = Макс(Количество2, Количество3);
	
	Для Счетчик = 1 По ОбщееКоличество Цикл
		СтрокаПриложения = СтрокаМестаРегистрации.ТаблицаПриложений.Добавить();
		СтрокаПриложения.СтрокаТаблицыОбъекты = СтрокаТаблицыОбъекты;
		СтрокаПриложения.СтрокаОписи = СтрокаОписи;
		
		Если Счетчик <= Количество2 Тогда
			СтрокаМестаРегистрации.Раздел2 = Истина;
			
			Значение = МассивНомеров2[Счетчик - 1];
			
			ЗначениеУказаноОписанием = (ТипЗнч(Значение) = Тип("Структура"));
			
			Если ЗначениеУказаноОписанием Тогда
				СтрокаПриложения.НомерПриложенияРаздела2 = Значение.НомерПриложения;
				СтрокаПриложения.ДополнительныеПараметры = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(Значение.ДополнительныеПараметры);
			Иначе
				СтрокаПриложения.НомерПриложенияРаздела2 = Значение;
			КонецЕсли;
		КонецЕсли;
		
		Если Счетчик <= Количество3 Тогда
			СтрокаМестаРегистрации.Раздел3 = Истина;
			
			Значение = МассивНомеров3[Счетчик - 1];
			
			ЗначениеУказаноОписанием = (ТипЗнч(Значение) = Тип("Структура"));
			
			Если ЗначениеУказаноОписанием Тогда
				СтрокаПриложения.НомерПриложенияРаздела3 = Значение.НомерПриложения;
				СтрокаПриложения.ДополнительныеПараметры = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(Значение.ДополнительныеПараметры);
			Иначе
				СтрокаПриложения.НомерПриложенияРаздела3 = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#Область Описи61н

Процедура ДобавитьМестаРегистрацииОписей(ТаблицаОбъекты, ДополнительныеПараметры)
	
	Перем ДобавитьВРаздел2, ДобавитьВРаздел3;
	
	ТаблицыОписей = ДополнительныеПараметры.Описи61н.ТаблицыОписей;
	
	РезультатыРасчета = ДополнительныеПараметры.Описи61н.РезультатыРасчета;
	
	ТаблицаМестаРегистрации = ПолучитьПустуюТаблицуМестаРегистрацииОписей();
	
	ПоискРегистрацииОпиcи = Новый Структура("Опись");
	
	ПоискВыявленногоОтклонения = Новый Структура("Ссылка,НомерСтроки");
	
	Для Каждого СтрокаТаблицыОбъекты Из ТаблицаОбъекты Цикл
		
		Для Каждого СтрокаСопоставления Из СтрокаТаблицыОбъекты.ТаблицаСопоставленияОписей Цикл
			
			Опись = СтрокаСопоставления.Опись;
			
			ПоискРегистрацииОпиcи.Опись = Опись;
			
			МассивСтрок = ТаблицаМестаРегистрации.НайтиСтроки(ПоискРегистрацииОпиcи);
			
			Если МассивСтрок.Количество() = 0 Тогда
				СтрокаМестаРегистрации = ТаблицаМестаРегистрации.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаМестаРегистрации, СтрокаСопоставления, "Опись,НомерОписи,ДатаОписи");
				
				СтрокаМестаРегистрации.ТаблицаПриложений = ПолучитьПустуюТаблицуПриложений();
				
				СтрокаМестаРегистрации.МассивСтрокТаблицыОбъекты = Новый Массив();
			Иначе
				СтрокаМестаРегистрации = МассивСтрок[0];
			КонецЕсли;
			
			Если СтрокаМестаРегистрации.МассивСтрокТаблицыОбъекты.Найти(СтрокаТаблицыОбъекты) = Неопределено Тогда
				СтрокаМестаРегистрации.МассивСтрокТаблицыОбъекты.Добавить(СтрокаТаблицыОбъекты);
			КонецЕсли;
			
			Если СтрокаСопоставления.СопоставленыОтклонения Тогда
				// Имеются сопоставленные отклонения, необходимо определить место их отражения.
				ИмяДокумента = ОпределитьИмяДокумента(Опись, ДополнительныеПараметры);
				
				ТаблицыДокумента = ТаблицыОписей[ИмяДокумента];
				
				ИмяТаблицыОтклонений = СтрокаСопоставления.ИмяТабличнойЧасти;
				
				ТаблицаОтклоненийОписей = ТаблицыДокумента[ИмяТаблицыОтклонений];
				
				ПоискВыявленногоОтклонения.Ссылка = СтрокаСопоставления.Опись;
				
				РезультатыРасчета.РезультатыСопоставления.ПоискОписиВДанныхОписей.Ссылка = Опись;
				
				ШапкаОписи = ТаблицыДокумента.Шапки.НайтиСтроки(РезультатыРасчета.РезультатыСопоставления.ПоискОписиВДанныхОписей)[0];
				
				НомераСтрок = УпорядочитьНомераСтрок(СтрокаСопоставления.НомераСтрок);
				
				Для Каждого НомерСтроки Из НомераСтрок Цикл
					Если НомерСтроки = 0 Тогда
						// Это строка не сопоставленного отклонения, а сопоставленного отбора.
						Продолжить;
					КонецЕсли;
					
					ПоискВыявленногоОтклонения.НомерСтроки = НомерСтроки;
					
					МассивСтрок = ТаблицаОтклоненийОписей.НайтиСтроки(ПоискВыявленногоОтклонения);
					
					СтрокаОписи = МассивСтрок[0];
					
					ОпределитьМестоРегистрацииСтрокиОписи(ИмяДокумента, СтрокаТаблицыОбъекты, СтрокаОписи, ШапкаОписи, СтрокаМестаРегистрации, ДополнительныеПараметры, ИмяТаблицыОтклонений);
				КонецЦикла;
				
			ИначеЕсли СтрокаСопоставления.СопоставленОтбор Тогда
				// Отсутствуют выявленные отклонения, но опись сопоставлена строке Решения по отбору.
				СтрокаМестаРегистрации.Раздел1 = Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ИсключитьНекорректныеНастройкиМестРегистрации(ТаблицаМестаРегистрации);
	
	РезультатыРасчета.Вставить("МестаРегистрацииОписей", ТаблицаМестаРегистрации);
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрацииСтрокиОписи(ИмяДокумента, СтрокаТаблицыОбъекты, СтрокаОписи, ШапкаОписи, СтрокаМестаРегистрации, ДополнительныеПараметры, ИмяТаблицыОтклонений)

	Перем НомерПриложенияРаздела2, НомерПриложенияРаздела3;
	
	Если ИмяДокумента = "ИнвентаризационнаяОписьОстатковНаСчетах" Тогда
		ОпределитьМестоРегистрации_ИнвентаризационнаяОписьОстатковНаСчетах(
			СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьБСО" Тогда
		ОпределитьМестоРегистрации_ИнвентаризационнаяОписьБСО(
			СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьНФА" Тогда
		ОпределитьМестоРегистрации_ИнвентаризационнаяОписьНФА(
			СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
		ОпределитьМестоРегистрации_ИнвентаризационнаяОписьРасчетовПоПоступлениям(
			СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры, ИмяТаблицыОтклонений);
			
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьРасчетовСКонтрагентами" Тогда
		ОпределитьМестоРегистрации_ИнвентаризационнаяОписьРасчетовСКонтрагентами(
			СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры, ИмяТаблицыОтклонений);
			
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах" Тогда
		ОпределитьМестоРегистрации_ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах(
			СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры, ИмяТаблицыОтклонений);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам" Тогда
		ОпределитьМестоРегистрации_ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам(
			СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры, ИмяТаблицыОтклонений);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям" Тогда
		ОпределитьМестоРегистрации_ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям(
			СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры, ИмяТаблицыОтклонений);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьКредитовИЗаймов" Тогда
		ОпределитьМестоРегистрации_ИнвентаризационнаяОписьКредитовИЗаймов(
			СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры, ИмяТаблицыОтклонений);

	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьЦенныхБумаг" Тогда
		ОпределитьМестоРегистрации_ИнвентаризационнаяОписьЦенныхБумаг(
			СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры);
	КонецЕсли;
	
	Если НомерПриложенияРаздела2 = Неопределено И НомерПриложенияРаздела3 = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаданМассивНомеров = (ТипЗнч(НомерПриложенияРаздела2) = Тип("Массив") Или ТипЗнч(НомерПриложенияРаздела3) = Тип("Массив"));
	
	Если ЗаданМассивНомеров Тогда
		ДобавитьМестаРегистрацииПоМассивуНомеровПриложений(СтрокаМестаРегистрации, СтрокаТаблицыОбъекты, СтрокаОписи,
			НомерПриложенияРаздела2,
			НомерПриложенияРаздела3);
	Иначе
		СтрокаПриложения = СтрокаМестаРегистрации.ТаблицаПриложений.Добавить();
		СтрокаПриложения.СтрокаТаблицыОбъекты = СтрокаТаблицыОбъекты;
		СтрокаПриложения.СтрокаОписи = СтрокаОписи;
		
		Если НомерПриложенияРаздела2 <> Неопределено Тогда
			СтрокаМестаРегистрации.Раздел2 = Истина;
			
			СтрокаПриложения.НомерПриложенияРаздела2 = НомерПриложенияРаздела2;
		КонецЕсли;
		
		Если НомерПриложенияРаздела3 <> Неопределено Тогда
			СтрокаМестаРегистрации.Раздел3 = Истина;
			
			СтрокаПриложения.НомерПриложенияРаздела3 = НомерПриложенияРаздела3;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризационнаяОписьОстатковНаСчетах(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры)
	
	Если СтрокаОписи.СуммаОтклоненийВал <> 0 Или СтрокаОписи.СуммаОтклоненийРуб <> 0 Тогда
		НомерПриложенияРаздела2 = 1;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризационнаяОписьБСО(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры)
	
	Если СтрокаОписи.КоличествоИзлишкиНеПодтверждено <> 0
		Или СтрокаОписи.СуммаИзлишкиНеПодтверждено <> 0
		Или СтрокаОписи.КоличествоНедостачаНеПодтверждено <> 0
		Или СтрокаОписи.СуммаНедостачаНеПодтверждено <> 0 Тогда
		
		НомерПриложенияРаздела2 = 2;
	КонецЕсли;
	
	Если СтрокаОписи.КоличествоНеСоответствует <> 0
		Или СтрокаОписи.СуммаНеСоответствует <> 0 Тогда
		
		НомерПриложенияРаздела3 = 1;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризационнаяОписьНФА(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры)
	
	Если СтрокаОписи.КоличествоНедостачаНеПодтверждено <> 0
		Или СтрокаОписи.СуммаНедостачаНеПодтверждено <> 0
		Или СтрокаОписи.КоличествоИзлишкиНеПодтверждено <> 0 Тогда
		
		НомерПриложенияРаздела2 = 3;
	КонецЕсли;
	
	Если СтрокаОписи.КоличествоНеСоответствует <> 0
		Или СтрокаОписи.СуммаНеСоответствует <> 0
		Или СтрокаОписи.КоличествоОбесценение <> 0
		Или СтрокаОписи.СуммаОбесценение <> 0 Тогда
		
		НомерПриложенияРаздела3 = 2;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры, ИмяТаблицыОтклонений)
	
	Если СтрокаОписи.СуммаНеПодтвержденаАктомСверкиРуб <> 0
		Или СтрокаОписи.СуммаНеПодтвержденаАктомСверкиВал <> 0 Тогда
		
		Если ИмяТаблицыОтклонений = "ВыявленныеОтклоненияРаздел21" Тогда
			НомерПриложенияРаздела2 = 4;
			
		ИначеЕсли ИмяТаблицыОтклонений = "ВыявленныеОтклоненияРаздел22" Тогда
			НомерПриложенияРаздела2 = 5;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяТаблицыОтклонений = "ВыявленныеОтклоненияРаздел21" Тогда
		Если СтрокаОписи.ПросроченнаяСуммаТребуетРеклассификации
			Или СтрокаОписи.СомнительнаяСуммаТребуетРеклассификации
			Или СтрокаОписи.БезнадежнаяСуммаТребуетРеклассификации Тогда
			
			НомерПриложенияРаздела3 = Новый Массив();
			
			Если СтрокаОписи.ПросроченнаяСуммаТребуетРеклассификации Тогда
				Описание = НовыйПредварительноеОписаниеНомераПриложенияРаздела();
				Описание.НомерПриложения = 3;
				Описание.ДополнительныеПараметры.Вставить("ОбозначениеСуммы", "Просроченная");
				
				НомерПриложенияРаздела3.Добавить(Описание);
			КонецЕсли;
			
			Если СтрокаОписи.СомнительнаяСуммаТребуетРеклассификации Тогда
				Описание = НовыйПредварительноеОписаниеНомераПриложенияРаздела();
				Описание.НомерПриложения = 3;
				Описание.ДополнительныеПараметры.Вставить("ОбозначениеСуммы", "Сомнительная");
				
				НомерПриложенияРаздела3.Добавить(Описание);
			КонецЕсли;
			
			Если СтрокаОписи.БезнадежнаяСуммаТребуетРеклассификации Тогда
				Описание = НовыйПредварительноеОписаниеНомераПриложенияРаздела();
				Описание.НомерПриложения = 3;
				Описание.ДополнительныеПараметры.Вставить("ОбозначениеСуммы", "Безнадежная");
				
				НомерПриложенияРаздела3.Добавить(Описание);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ИмяТаблицыОтклонений = "ВыявленныеОтклоненияРаздел22" Тогда
		Если СтрокаОписи.ПросроченнаяСуммаТребуетРеклассификации
			Или СтрокаОписи.СуммаСИстекшимСрокомДавностиТребуетРеклассификации Тогда
			
			НомерПриложенияРаздела3 = Новый Массив();
			
			Если СтрокаОписи.ПросроченнаяСуммаТребуетРеклассификации Тогда
				Описание = НовыйПредварительноеОписаниеНомераПриложенияРаздела();
				Описание.НомерПриложения = 4;
				Описание.ДополнительныеПараметры.Вставить("ОбозначениеСуммы", "Просроченная");
				
				НомерПриложенияРаздела3.Добавить(Описание);
			КонецЕсли;
			
			Если СтрокаОписи.СуммаСИстекшимСрокомДавностиТребуетРеклассификации Тогда
				Описание = НовыйПредварительноеОписаниеНомераПриложенияРаздела();
				Описание.НомерПриложения = 4;
				Описание.ДополнительныеПараметры.Вставить("ОбозначениеСуммы", "СИстекшимСрокомДавности");
				
				НомерПриложенияРаздела3.Добавить(Описание);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризационнаяОписьРасчетовСКонтрагентами(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры, ИмяТаблицыОтклонений)
	
	Если СтрокаОписи.СуммаНеподтвержденнаяВал <> 0
		Или СтрокаОписи.СуммаНеподтвержденнаяРуб <> 0 Тогда
		
		Если ИмяТаблицыОтклонений = "ВыявленныеОтклоненияРаздел21" Тогда
			НомерПриложенияРаздела2 = 6;
			
		ИначеЕсли ИмяТаблицыОтклонений = "ВыявленныеОтклоненияРаздел22" Тогда
			НомерПриложенияРаздела2 = 7;
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаОписи.СуммаТребуетРеклассификации Тогда
		Если ИмяТаблицыОтклонений = "ВыявленныеОтклоненияРаздел21" Тогда
			НомерПриложенияРаздела3 = 5;
			
		ИначеЕсли ИмяТаблицыОтклонений = "ВыявленныеОтклоненияРаздел22" Тогда
			НомерПриложенияРаздела3 = 6;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры, ИмяТаблицыОтклонений)
	
	Если ИмяТаблицыОтклонений = "ВыявленныеОтклонения" Тогда
		НомерПриложенияРаздела2 = 10;
		
	ИначеЕсли ИмяТаблицыОтклонений = "ВыявленнаяПросроченнаяЗадолженность" Тогда
		НомерПриложенияРаздела3 = 9;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры, ИмяТаблицыОтклонений)
	
	Если ИмяТаблицыОтклонений = "Раздел31" Тогда
		НомерПриложенияРаздела2 = 111;
		
	ИначеЕсли ИмяТаблицыОтклонений = "Раздел32" Тогда
		Если ЗначениеЗаполнено(СтрокаОписи.СуммаДолгаВалНеСогласовано)
			Или ЗначениеЗаполнено(СтрокаОписи.СуммаДолгаРубНеСогласовано)
			Или ЗначениеЗаполнено(СтрокаОписи.НачисленныеПроцентыВалНеСогласовано)
			Или ЗначениеЗаполнено(СтрокаОписи.НачисленныеПроцентыРубНеСогласовано) Тогда
			
