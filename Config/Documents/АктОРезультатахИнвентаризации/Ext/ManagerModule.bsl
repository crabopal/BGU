		КонецЕсли;
		
	ИначеЕсли НомерРаздела = 3 Тогда
		
		// Приложения к разделу 3
		
		Если НомерПриложения = 1 Тогда
			ЗаполнитьНовуюСтроку_Приложение1кРазделу3(НоваяСтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры);
			
