	ДанныеПриложения = Новый Структура();
	ДанныеПриложения.Вставить("ПорядковыйНомерПустойУчетнойГруппы", Новый Структура("Фактический,Планируемый"));
	
	Возврат ДанныеПриложения;
	
КонецФункции

Функция ПолучитьПланируемыйПорядковыйНомерПустойУчетнойГруппыКонтрагентов(ТЧУчетныеГруппыКонтрагентов, ПустаяГруппаСодержитсяВТаблице = Истина)
	
	Если ИнвентаризацияКлиентСервер.НачинатьНумерациюУчетныхГруппКонтрагентовСПустойУчетнойГруппы() Тогда
		Возврат 1;
	Иначе
		Возврат ТЧУчетныеГруппыКонтрагентов.Количество()
			+ ?(ПустаяГруппаСодержитсяВТаблице, 0, 1);
	КонецЕсли;
	
КонецФункции

