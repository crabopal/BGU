Процедура ЗаполнитьНовуюСтроку_Приложение3кРазделу3(СтрокаПриложения, СтрокаОписи, СтрокаРегистрации, Параметры, ДополнительныеПараметры)
	
	Перем ОбозначениеСуммы;
	
	Если ТипЗнч(СтрокаОписи.Ссылка) = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям") Тогда
		
		Если СтрокаРегистрации.ДополнительныеПараметры.Свойство("ОбозначениеСуммы", ОбозначениеСуммы) Тогда
			Если ОбозначениеСуммы = "Просроченная" Тогда
				СтрокаПриложения.СуммаВал = СтрокаОписи.СуммаВалПросроченная;
				СтрокаПриложения.СуммаРуб = СтрокаОписи.СуммаРубПросроченная;
				СтрокаПриложения.СтатусЗадолженности = Перечисления.СтатусыЗадолженности.Просроченная;

			ИначеЕсли ОбозначениеСуммы = "Сомнительная" Тогда
				СтрокаПриложения.СуммаВал = СтрокаОписи.СуммаВалСомнительная;
				СтрокаПриложения.СуммаРуб = СтрокаОписи.СуммаРубСомнительная;
				СтрокаПриложения.СтатусЗадолженности = Перечисления.СтатусыЗадолженности.Сомнительная;
				
			ИначеЕсли ОбозначениеСуммы = "Безнадежная" Тогда
				СтрокаПриложения.СуммаВал = СтрокаОписи.СуммаВалБезнадежная;
				СтрокаПриложения.СуммаРуб = СтрокаОписи.СуммаРубБезнадежная;
				СтрокаПриложения.СтатусЗадолженности = Перечисления.СтатусыЗадолженности.Безнадежная;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

