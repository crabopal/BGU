Процедура ЗаполнитьОбластьСтрокаТаблицы_Приложение2кРазделу2(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	// Для пустых Серии и Номеров применяем не прочерк, а число 0.
	// Здесь 0 не устанавливаем, это делается механизмом прочерков.
	
	ЗначенияПараметров = Новый Структура("
		|НаименованиеДокумента,
		|КодДокумента,
		|НедостачаСерия,
		|НедостачаНомер,
		|НедостачаЦена,
		|ИзлишекСерия,
		|ИзлишекНомер,
		|ИзлишекЦена");
	
	ЗначенияПараметров.НедостачаЦена = 0;
	ЗначенияПараметров.ИзлишекЦена = 0;
	
	ЗначенияПараметров.Вставить("КодСтроки", ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(Выборка.НомерСтрокиРаздела, Выборка.ПорядковыйНомер));
	
	ЗаполнитьНедостачу	= (Выборка.НедостачаКоличество <> 0 Или Выборка.НедостачаСумма <> 0);
	ЗаполнитьИзлишек	= (Выборка.ИзлишекКоличество <> 0 Или Выборка.ИзлишекСумма <> 0);
	
	Если ЭтоБСО(Выборка.ВидДокумента) Тогда
		
		ЗначенияПараметров.НаименованиеДокумента	= Выборка.БСОНаименование;
		ЗначенияПараметров.КодДокумента				= Выборка.БСОКод;
		
		Серия = Выборка.БСОСерия;
		ДлинаНомера = Выборка.БСОДлинаНомера;
		
		Если ЗаполнитьНедостачу Тогда
			ЗначенияПараметров.НедостачаЦена = Выборка.Цена;
			ЗначенияПараметров.НедостачаСерия = Серия;
			ЗначенияПараметров.НедостачаНомер = ПолучитьПредставлениеДиапазонаНомеровБСО(
				Выборка.НедостачаНачальныйНомер,
				Выборка.НедостачаКонечныйНомер,
				Выборка.НедостачаКоличество,
				ДлинаНомера);
		КонецЕсли;
		
		Если ЗаполнитьИзлишек Тогда
			ЗначенияПараметров.ИзлишекЦена = Выборка.Цена;
			ЗначенияПараметров.ИзлишекСерия = Серия;
			ЗначенияПараметров.ИзлишекНомер = ПолучитьПредставлениеДиапазонаНомеровБСО(
				Выборка.ИзлишекНачальныйНомер,
				Выборка.ИзлишекКонечныйНомер,
				Выборка.ИзлишекКоличество,
				ДлинаНомера);
		КонецЕсли;
		
	ИначеЕсли ЭтоДенежныйДокумент(Выборка.ВидДокумента) Тогда
		// Денежный документ
		
		ЗначенияПараметров.НаименованиеДокумента	= Выборка.ДенежныйДокументНаименование;
		ЗначенияПараметров.КодДокумента				= Выборка.ДенежныйДокументКод;
		
		НомСтоимость = Выборка.ДенежныйДокументНомСтоимость;
		Серия = Выборка.ДенежныйДокументСерия;
		Номер = Выборка.ДенежныйДокументНомер;
		
		Если ЗаполнитьНедостачу Тогда
			ЗначенияПараметров.НедостачаЦена = Выборка.Цена;
			ЗначенияПараметров.НедостачаСерия = Серия;
			ЗначенияПараметров.НедостачаНомер = Номер;
		КонецЕсли;
		
		Если ЗаполнитьИзлишек Тогда
			ЗначенияПараметров.ИзлишекЦена = Выборка.Цена;
			ЗначенияПараметров.ИзлишекСерия = Серия;
			ЗначенияПараметров.ИзлишекНомер = Номер;
		КонецЕсли;
	КонецЕсли;
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей,
		"Приложение2кРазделу2");
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы_Приложение3кРазделу2(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
