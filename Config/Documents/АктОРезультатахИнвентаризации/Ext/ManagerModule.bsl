Процедура ИнициализироватьДопустимостьДобавленияСтрокТабличныхЧастей(ФормаДокумента)
	
	Элементы = ФормаДокумента.Элементы;
	
	ДопустимостьДобавленияСтрок = ДопустимостьДобавленияСтрок();
	
	Для Каждого Элемент Из ДопустимостьДобавленияСтрок Цикл
		
		ИмяТЧ = Элемент.Ключ;
		Допустимость = Элемент.Значение;
		
		ЭлементТаблицы = Элементы[ИмяТЧ];
		
		ЭлементТаблицы.ИзменятьСоставСтрок		= Допустимость;
		ЭлементТаблицы.ИзменятьПорядокСтрок		= Ложь;
		ЭлементТаблицы.ПоложениеКоманднойПанели	= ?(Допустимость, ПоложениеКоманднойПанелиЭлементаФормы.Авто, ПоложениеКоманднойПанелиЭлементаФормы.Нет);
		
	КонецЦикла;
	
КонецПроцедуры	

Функция ПолучитьСпискиВыбораКодаСтрокиПриложения(ТЧРаздела, ТЧПриложения, НомерПриложения, МаксимальныеНомера)
	
	// Список выбора для уже существующей строки приложения.
	
	СоответствиеСуществующаяСтрока = Новый Соответствие();
	
	Для Каждого ЭлементНомера Из МаксимальныеНомера Цикл
		НомерСтрокиРаздела	= ЭлементНомера.Ключ;
		МаксимальныйНомер	= ЭлементНомера.Значение;
		
		СписокВыбораСуществующаяСтрока = Новый СписокЗначений();
		
		Для Счетчик = 1 По МаксимальныйНомер Цикл
			СписокВыбораСуществующаяСтрока.Добавить(ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(НомерСтрокиРаздела, Счетчик));
		КонецЦикла;
		
		СоответствиеСуществующаяСтрока.Вставить(НомерСтрокиРаздела, СписокВыбораСуществующаяСтрока);
	КонецЦикла;
	
	// Список выбора для новой строки приложения.
	
	СписокВыбораНоваяСтрока = Новый СписокЗначений();
	
	Поиск = Новый Структура("НомерПриложения");
	Поиск.НомерПриложения = НомерПриложения;
	
	МассивСтрокРаздела = ТЧРаздела.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаРаздела Из МассивСтрокРаздела Цикл
		НомерСтрокиРаздела = СтрокаРаздела.НомерСтроки;
		
		МаксимальныйНомер = МаксимальныеНомера.Получить(НомерСтрокиРаздела);
		
		Если МаксимальныйНомер = Неопределено Тогда
			МаксимальныйНомер = 0;
		КонецЕсли;
		
		ПорядковыйНомер = МаксимальныйНомер + 1;
		
		КодСтрокиПриложения = ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(НомерСтрокиРаздела, ПорядковыйНомер);
		
		Представление = СтрШаблон(НСтр("ru='%1 (опись №%2 от %3)'"),
			КодСтрокиПриложения,
			СтрокаРаздела.НомерОписи,
			Формат(СтрокаРаздела.ДатаОписи, "ДФ=дд.ММ.гггг"));
		
		СписокВыбораНоваяСтрока.Добавить(КодСтрокиПриложения, Представление);
	КонецЦикла;
	
	СпискиВыбора = Новый Структура();
	СпискиВыбора.Вставить("НоваяСтрока", СписокВыбораНоваяСтрока);
	СпискиВыбора.Вставить("СуществующаяСтрока", СоответствиеСуществующаяСтрока);
	
	Возврат СпискиВыбора;
	
КонецФункции

Процедура ИнициализироватьНастройкиКодовФорм(ФормаДокумента)
	
	НастройкиКодовФорм = КодыФорм();
	
	Соответствия = Новый Структура();
	Соответствия.Вставить("НомераПриложенийРаздела2", ПолучитьСоответствиеКодФормыНомераПриложений(НастройкиКодовФорм, 2));
	Соответствия.Вставить("НомераПриложенийРаздела3", ПолучитьСоответствиеКодФормыНомераПриложений(НастройкиКодовФорм, 3));
	Соответствия.Вставить("ДокументыОписей", НастройкиКодовФорм.ДокументыОписей);
	Соответствия.Вставить("СоответствиеКодФормыИмяДокумента", НастройкиКодовФорм.СоответствиеКодФормыИмяДокумента);
	
	ФормаДокумента.КэшНастройкиКодовФорм = Новый ФиксированнаяСтруктура(Соответствия);
	
КонецПроцедуры

Процедура ИнициализироватьОписаниеОписиРасходовБудущихПериодов(ФормаДокумента)
	
	ФормаДокумента.КэшОписаниеОписиРасходовБудущихПериодов = Новый ФиксированнаяСтруктура(ПолучитьОписаниеОписиРасходовБудущихПериодов());
	
КонецПроцедуры

Функция ПолучитьСоответствиеКодФормыНомераПриложений(НастройкиКодовФорм, НомерРаздела)
	
	Результат = Новый Соответствие();
	
	ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
	
	НомераПриложений = ПолучитьНомераПриложенийКРазделу(НомерРаздела);
	
	Для Каждого Элемент Из НастройкиКодовФорм[ИмяТЧРаздела] Цикл
		НомерПриложения = Элемент.Ключ;
		
		КодыФорм = СтрРазделить(Элемент.Значение, ", ", Ложь);
		
		Для Каждого КодФормы Из КодыФорм Цикл
			Список = Результат.Получить(КодФормы);
			
			Если Список = Неопределено Тогда
				Список = Новый СписокЗначений();
				Результат.Вставить(КодФормы, Список);
			КонецЕсли;
			
			ЭлементПриложения = НомераПриложений.НайтиПоЗначению(НомерПриложения);
			
			Если ЭлементПриложения <> Неопределено Тогда
				ПредставлениеПриложения = ЭлементПриложения.Представление;
			Иначе
				ПредставлениеПриложения = Неопределено;
			КонецЕсли;
			
			Список.Добавить(НомерПриложения, ПредставлениеПриложения);
			Список.СортироватьПоЗначению();
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОпределитьОписиПредусмотренныеРешением(ТаблицаОбъектыРешения, СоответствиеКодФормыИмяДокумента, ОписаниеОписиРасходовБудущихПериодов)
	
	ИменаОписей = Новый Массив();
	
	Для Каждого СтрокаТаблицыОбъектыРешения Из ТаблицаОбъектыРешения Цикл
		// Для этих описей предусмотрены документы в конфигурации.
		Для Каждого КодФормы Из СтрокаТаблицыОбъектыРешения.МассивКодовФорм Цикл
			МассивИмен = СоответствиеКодФормыИмяДокумента.Получить(КодФормы);
			
			Если МассивИмен = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого ИмяДокумента Из МассивИмен Цикл
				Если ИменаОписей.Найти(ИмяДокумента) = Неопределено Тогда
					ИменаОписей.Добавить(ИмяДокумента);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		// Для описи РБП не предусмотрен документ в конфигурации.
		// В табличной части Объекты из Решения для описи РБП не указывается код формы.
		Если ОписаниеОписиРасходовБудущихПериодов.СписокСчетов.Найти(СтрокаТаблицыОбъектыРешения.Счет) <> Неопределено Тогда
			ИмяДокумента = ОписаниеОписиРасходовБудущихПериодов.НаименованияОписи.ИмяДокумента;
			
			Если ИменаОписей.Найти(ИмяДокумента) = Неопределено Тогда
				ИменаОписей.Добавить(ИмяДокумента);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИменаОписей;
	
КонецФункции

Функция СоставитьСпискиВыбораТиповОписей(ТаблицаПримененияОписейВРазделах, ОтборИменаОписей, ОписаниеОписиРасходовБудущихПериодов)
	
	СпискиВыбораТиповОписей = Новый Структура();
	СпискиВыбораТиповОписей.Вставить("Раздел1", Новый СписокЗначений());
	СпискиВыбораТиповОписей.Вставить("Раздел2", Новый СписокЗначений());
	СпискиВыбораТиповОписей.Вставить("Раздел3", Новый СписокЗначений());
	
	ЗаданОтбор = (ТипЗнч(ОтборИменаОписей) = Тип("Массив"));
	
	Для Каждого СтрокаТаблицыПрименения Из ТаблицаПримененияОписейВРазделах Цикл
		ИмяДокумента = СтрокаТаблицыПрименения.ИмяДокумента;
		ТипДокумента = СтрокаТаблицыПрименения.ТипДокумента;
		
		Если ЗаданОтбор И ОтборИменаОписей.Найти(ИмяДокумента) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтоОписьРБП = (ИмяДокумента = ОписаниеОписиРасходовБудущихПериодов.НаименованияОписи.ИмяДокумента);
		
		Представление = ?(ЭтоОписьРБП,
			ОписаниеОписиРасходовБудущихПериодов.НаименованияОписи.Представление,
			Строка(ТипДокумента));
		
		Если СтрокаТаблицыПрименения.УказываетсяВРазделе1 Тогда
			СпискиВыбораТиповОписей.Раздел1.Добавить(ИмяДокумента, Представление);
		КонецЕсли;
		
		Если СтрокаТаблицыПрименения.УказываетсяВРазделе2 Тогда
			СпискиВыбораТиповОписей.Раздел2.Добавить(ИмяДокумента, Представление);
		КонецЕсли;
		
		Если СтрокаТаблицыПрименения.УказываетсяВРазделе3 Тогда
			СпискиВыбораТиповОписей.Раздел3.Добавить(ИмяДокумента, Представление);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СпискиВыбораТиповОписей;
	
КонецФункции

Функция ОпределитьОписиДоступныеПоФункциональнымОпциям(СоответствиеКодФормыИмяДокумента, ОписаниеОписиРасходовБудущихПериодов)
	
	ИспользоватьУчетКредитовИЗаймов = ПолучитьФункциональнуюОпцию("ИспользоватьУчетКредитовИЗаймов");
	ИспользоватьУчетФинансовыхВложений = ПолучитьФункциональнуюОпцию("ИспользоватьУчетФинансовыхВложений");
	
	ИменаОписей = Новый Массив();
	
	// Для этих описей предусмотрены документы в конфигурации.
	Для Каждого Элемент Из СоответствиеКодФормыИмяДокумента Цикл
		КодФормы = Элемент.Ключ;
		МассивИмен = Элемент.Значение;
		
		Если МассивИмен = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ИмяДокумента Из МассивИмен Цикл
			
			Если Не ИспользоватьУчетКредитовИЗаймов И
				(ИмяДокумента = "ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах"
				Или ИмяДокумента = "ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям"
				Или ИмяДокумента = "ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам"
				Или ИмяДокумента = "ИнвентаризационнаяОписьКредитовИЗаймов") Тогда
				
				Продолжить;
			КонецЕсли;
			
			Если Не ИспользоватьУчетФинансовыхВложений И
				ИмяДокумента = "ИнвентаризационнаяОписьЦенныхБумаг" Тогда
				
				Продолжить;
			КонецЕсли;
			
			Если ИменаОписей.Найти(ИмяДокумента) = Неопределено Тогда
				ИменаОписей.Добавить(ИмяДокумента);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Для описи РБП не предусмотрен документ в конфигурации.
	// В табличной части Объекты из Решения для описи РБП не указывается код формы.
	ИмяДокумента = ОписаниеОписиРасходовБудущихПериодов.НаименованияОписи.ИмяДокумента;
	
	Если ИменаОписей.Найти(ИмяДокумента) = Неопределено Тогда
		ИменаОписей.Добавить(ИмяДокумента);
	КонецЕсли;
	
	Возврат ИменаОписей;
	
КонецФункции

Процедура СдвинутьОписьРБПвКонецТаблицы(ТаблицаПримененияОписейВРазделах, ОписаниеОписиРасходовБудущихПериодов)
	
	СтрокаОписиРБП = ТаблицаПримененияОписейВРазделах.Найти(ОписаниеОписиРасходовБудущихПериодов.НаименованияОписи.ИмяДокумента, "ИмяДокумента");
	
	Если СтрокаОписиРБП = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ТаблицаПримененияОписейВРазделах.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОписиРБП);
	
	ТаблицаПримененияОписейВРазделах.Удалить(СтрокаОписиРБП);
	
КонецПроцедуры

Процедура НастроитьСпискиВыбораСтатусовЗадолженности0510471(ФормаДокумента)
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("Приложение8кРазделу3СтатусЗадолженностиОД");
	ИменаЭлементов.Добавить("Приложение8кРазделу3СтатусЗадолженностиПроцентов");
	ИменаЭлементов.Добавить("Приложение8кРазделу3СтатусЗадолженностиШтрафов");
	ИменаЭлементов.Добавить("Приложение8кРазделу3СтатусЗадолженностиПеней");
	
	Список = ИнвентаризацияКлиентСервер.ПолучитьСтатусыДебиторскойЗадолженностиБалансовыеСчета();
	
	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		ФормаДокумента.Элементы[ИмяЭлемента].СписокВыбора.ЗагрузитьЗначения(Список);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеСлужебныхКолонок

Процедура ЗаполнитьСлужебныеКолонки_КодСтроки(ФормаДокумента)
	
	ДокументОбъект = ФормаДокумента.Объект;
	
	Для Каждого НомерРаздела Из НомераРазделовСПриложениями() Цикл
		
		Для Каждого ЭлементПриложения Из ПолучитьНомераПриложенийКРазделу(НомерРаздела) Цикл
			
			НомерПриложения = ЭлементПриложения.Значение;
			
			ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
			
			ТЧПриложения = ДокументОбъект[ИмяТЧПриложения];

			Для Каждого СтрокаТаблицы Из ТЧПриложения Цикл
				
				СтрокаТаблицы.КодСтроки = ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(СтрокаТаблицы.НомерСтрокиРаздела, СтрокаТаблицы.ПорядковыйНомер);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСлужебныеКолонки_ЭтоОписьРБП(ФормаДокумента)
	
	ДокументОбъект = ФормаДокумента.Объект;
	
	Для НомерРаздела = 1 По 3 Цикл
		ТЧРаздела = ДокументОбъект[ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела)];
		
		Для Каждого СтрокаРаздела Из ТЧРаздела Цикл
			СтрокаРаздела.ЭтоОписьРБП = ВСтрокеРазделаУказанаОписьРБП(СтрокаРаздела);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСлужебныеКолонки_Приложение2кРазделу2(ФормаДокумента)
	
	ИмяТЧПриложения = "Приложение2кРазделу2";
	
	ДокументОбъект = ФормаДокумента.Объект;
	
	ТЧПриложения = ДокументОбъект[ИмяТЧПриложения];
	
	Сведения = ПрочитатьСведенияБСОиДД(ТЧПриложения);
	
	Для Каждого СтрокаТаблицы Из ТЧПриложения Цикл
		
		Если ЭтоБСО(СтрокаТаблицы.ВидДокумента) Тогда
			СтрокаТаблицы.ДокументВладелец = СтрокаТаблицы.БСО;
			СтрокаТаблицы.ДокументПодчиненный = СтрокаТаблицы.Серия;
			
			ДлинаНомера = Сведения.ДлиныНомеровБСО.Получить(СтрокаТаблицы.БСО);
			
			СтрокаТаблицы.ДлинаНомера = ДлинаНомера;
			
			НедостачаНачальныйНомерПредставление = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(СтрокаТаблицы.НедостачаНачальныйНомер, ДлинаНомера);
			НедостачаКонечныйНомерПредставление = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(СтрокаТаблицы.НедостачаКонечныйНомер, ДлинаНомера);
			ИзлишекНачальныйНомерПредставление = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(СтрокаТаблицы.ИзлишекНачальныйНомер, ДлинаНомера);
			ИзлишекКонечныйНомерПредставление = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(СтрокаТаблицы.ИзлишекКонечныйНомер, ДлинаНомера);
			
		ИначеЕсли ЭтоДенежныйДокумент(СтрокаТаблицы.ВидДокумента) Тогда
			СтрокаТаблицы.ДокументВладелец = СтрокаТаблицы.ВидДенежногоДокумента;
			СтрокаТаблицы.ДокументПодчиненный = СтрокаТаблицы.ДенежныйДокумент;
			
			СведенияДД = Сведения.СведенияДенежныхДокументов.Получить(СтрокаТаблицы.ДенежныйДокумент);
			
			Если СведенияДД <> Неопределено Тогда
				НомерДД = СведенияДД.Номер;
				НомСтоимость = СведенияДД.НомСтоимость;
			Иначе
				НомерДД = "";
				НомСтоимость = 0;
			КонецЕсли;
			
			СтрокаТаблицы.НомерДенежногоДокумента = НомерДД;
			СтрокаТаблицы.НомСтоимость = НомСтоимость;
			
			НедостачаНомерПредставление = ?(СтрокаТаблицы.НедостачаКоличество = 0 И СтрокаТаблицы.НедостачаСумма = 0, "", НомерДД);
			ИзлишекНомерПредставление = ?(СтрокаТаблицы.ИзлишекКоличество = 0 И СтрокаТаблицы.ИзлишекСумма = 0, "", НомерДД);
			
			НедостачаНачальныйНомерПредставление = НедостачаНомерПредставление;
			НедостачаКонечныйНомерПредставление = НедостачаНомерПредставление;
			ИзлишекНачальныйНомерПредставление = ИзлишекНомерПредставление;
			ИзлишекКонечныйНомерПредставление = ИзлишекНомерПредставление;
			
		Иначе
			НедостачаНачальныйНомерПредставление = Формат(СтрокаТаблицы.НедостачаНачальныйНомер, "ЧГ=;ЧН=");
			НедостачаКонечныйНомерПредставление = Формат(СтрокаТаблицы.НедостачаКонечныйНомер, "ЧГ=;ЧН=");
			ИзлишекНачальныйНомерПредставление = Формат(СтрокаТаблицы.ИзлишекНачальныйНомер, "ЧГ=;ЧН=");
			ИзлишекКонечныйНомерПредставление = Формат(СтрокаТаблицы.ИзлишекКонечныйНомер, "ЧГ=;ЧН=");
		КонецЕсли;
		
		СтрокаТаблицы.НедостачаНачальныйНомерПредставление = НедостачаНачальныйНомерПредставление;
		СтрокаТаблицы.НедостачаКонечныйНомерПредставление = НедостачаКонечныйНомерПредставление;
		СтрокаТаблицы.ИзлишекНачальныйНомерПредставление = ИзлишекНачальныйНомерПредставление;
		СтрокаТаблицы.ИзлишекКонечныйНомерПредставление = ИзлишекКонечныйНомерПредставление;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСлужебныеКолонки_Приложение3кРазделу2(ФормаДокумента)
	
	ИмяТЧПриложения = "Приложение3кРазделу2";
	
	ЗаполнитьСлужебныеКолонки_ПриложениеНФА(ФормаДокумента.Объект[ИмяТЧПриложения]);
	
