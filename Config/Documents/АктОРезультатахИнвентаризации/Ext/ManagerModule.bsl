Процедура ЗаполнитьНовуюСтроку_Приложение8кРазделу3(СтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры)
	
	ШапкаОписи = ПолучитьШапкуОписиПриЗаполненииСтрокиПриложения(СтрокаОписи, Параметры, ДополнительныеПараметры);
	
	СтрокаПриложения.НаименованиеЗадолженности = ШапкаОписи.НаименованиеЗадолженности;
	
	Если Не СтрокаОписи.СуммаОДТребуетРеклассификации Тогда
		СтрокаПриложения.СуммаОДПросроченнаяВалютная = 0;
		СтрокаПриложения.СуммаОДПросроченная = 0;
	КонецЕсли;
	
	Если Не СтрокаОписи.СуммаПроцентовТребуетРеклассификации Тогда
		СтрокаПриложения.СуммаПроцентовПросроченнаяВалютная = 0;
		СтрокаПриложения.СуммаПроцентовПросроченная = 0;
	КонецЕсли;
	
	Если Не СтрокаОписи.СуммаШтрафовТребуетРеклассификации Тогда
		СтрокаПриложения.СуммаШтрафовПросроченнаяВалютная = 0;
		СтрокаПриложения.СуммаШтрафовПросроченная = 0;
	КонецЕсли;
	
	Если Не СтрокаОписи.СуммаПенейТребуетРеклассификации Тогда
		СтрокаПриложения.СуммаПенейПросроченнаяВалютная = 0;
		СтрокаПриложения.СуммаПенейПросроченная = 0;
	КонецЕсли;
	
	СтрокаПриложения.СуммаИтогоПросроченнаяВалютная =
		СтрокаПриложения.СуммаОДПросроченнаяВалютная
		+ СтрокаПриложения.СуммаПроцентовПросроченнаяВалютная
		+ СтрокаПриложения.СуммаШтрафовПросроченнаяВалютная
		+ СтрокаПриложения.СуммаПенейПросроченнаяВалютная;
		
	СтрокаПриложения.СуммаИтогоПросроченная =
		СтрокаПриложения.СуммаОДПросроченная
		+ СтрокаПриложения.СуммаПроцентовПросроченная
		+ СтрокаПриложения.СуммаШтрафовПросроченная
		+ СтрокаПриложения.СуммаПенейПросроченная;
	
КонецПроцедуры

