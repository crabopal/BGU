Функция ПолучитьПредставлениеДиапазонаНомеровБСО(НомерНач, НомерКон, Количество, ДлинаНомера)
	
	// Для пустых Серии и Номеров применяем не прочерк, а число 0.
	// Здесь 0 не устанавливаем, это делается механизмом прочерков.
	
	Если НомерНач = 0 И НомерКон = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	СимволМинус = НСтр("ru='-'");
	
	Если ЗначениеЗаполнено(НомерНач) Тогда
		НомерНачПредставление = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(НомерНач, ДлинаНомера);
	Иначе
		НомерНачПредставление = СимволМинус;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерКон) Тогда
		НомерКонПредставление = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(НомерКон, ДлинаНомера);
	Иначе
		НомерКонПредставление = СимволМинус;
	КонецЕсли;
	
	Если НомерНач = НомерКон Тогда
		НомерКонПредставление = СимволМинус;
	КонецЕсли;
	
	Возврат СтрШаблон("%1//%2", НомерНачПредставление, НомерКонПредставление);
	
	Возврат "";
	
КонецФункции

Функция ПолучитьПолныйНомерСчета(Выборка)
	
	Если ЗначениеЗаполнено(Выборка.КПС)
		Или ЗначениеЗаполнено(Выборка.КФО)
		Или ЗначениеЗаполнено(Выборка.Счет)
		Или ЗначениеЗаполнено(Выборка.КЭК) Тогда
		
		Возврат ИнвентаризацияКлиентСервер.ПолучитьПолныйНомерСчета(
			Выборка.КПС, Выборка.КФО, Выборка.Счет, Выборка.КЭК,, Выборка.СчетУчетПоКПС, Выборка.СчетУчетПоКЭК);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

