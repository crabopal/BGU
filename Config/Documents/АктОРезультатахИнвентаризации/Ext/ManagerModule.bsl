Функция ПолучитьСоответствиеКодФормыИмяДокумента(ДокументыОписей)
	
	СоответствиеКодФормыИмяДокумента = Новый Соответствие();
	
	Для Каждого Элемент Из ДокументыОписей Цикл
		ИмяДокумента = Элемент.Ключ;
		КодФормы = Элемент.Значение;
		
		Значение = СоответствиеКодФормыИмяДокумента.Получить(КодФормы);
		
		Если Значение = Неопределено Тогда
			Значение = Новый Массив();
		КонецЕсли;
		
		Значение.Добавить(ИмяДокумента);
		
		СоответствиеКодФормыИмяДокумента.Вставить(КодФормы, Значение);
	КонецЦикла;
	
	Возврат СоответствиеКодФормыИмяДокумента;
	
КонецФункции

