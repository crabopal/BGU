// Печать итогов приложений расчетов

Процедура ВывестиИтогиПриложенияРасчетовПоСчету(ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов, НомерПриложения, НомерРаздела,
	НомерЧасти = 0, ПрочеркиватьПоля = Истина)
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ОбластиМакета = ОбластиМакетов[ИмяТЧПриложения];
	
	ИмяТЧИтогов = ПолучитьИмяТабличнойЧастиИтогиПоСчету(НомерПриложения, НомерРаздела);
	
	КлючПрочерков = ?(ЗначениеЗаполнено(НомерЧасти),
		СтрШаблон("%1_Часть%2", ИмяТЧИтогов, НомерЧасти),
		ИмяТЧИтогов);
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборка = Данные.Выборки[ИмяТЧИтогов];
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	КоличествоСтрок = Выборка.Количество();
	
	ОбластьПервая		= ОбластиМакета[ПолучитьИмяОбластиМакетаИтогиПриложенияКРазделуПоСчету("Первая", НомерЧасти)];
	ОбластьОчередная	= ОбластиМакета[ПолучитьИмяОбластиМакетаИтогиПриложенияКРазделуПоСчету("Очередная", НомерЧасти)];
	
	Если КоличествоСтрок = 0 Тогда
		ЗначенияПараметров = Новый Структура("НомерСчета", "");
		
		ОбластьПервая.Параметры.Заполнить(ЗначенияПараметров);
		
		Если ПрочеркиватьПоля Тогда
			ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьПервая, Выборка, Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, КлючПрочерков);
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьПервая);
		
		Возврат;
	КонецЕсли;
	
	ЗначенияПараметров = Новый Структура("НомерСчета");
	
	НомерСтроки = 0;
	
	Пока Выборка.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		
		ЗначенияПараметров.НомерСчета = ПолучитьПолныйНомерСчета(Выборка);
		
		Область = ?(НомерСтроки = 1, ОбластьПервая, ОбластьОчередная);
		
		Область.Параметры.Заполнить(Выборка);
		Область.Параметры.Заполнить(ЗначенияПараметров);
		
		Если ПрочеркиватьПоля Тогда
			ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка, Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, КлючПрочерков);
		КонецЕсли;
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиИтогиПриложенияРасчетовПоКонтрагенту(ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов, НомерПриложения, НомерРаздела,
	НомерЧасти = 0, ПрочеркиватьПоля = Истина)
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ОбластиМакета = ОбластиМакетов[ИмяТЧПриложения];
	
	ИмяТЧИтогов = ПолучитьИмяТабличнойЧастиИтогиПоКонтрагенту(НомерПриложения, НомерРаздела);
	
	КлючПрочерков = ?(ЗначениеЗаполнено(НомерЧасти),
		СтрШаблон("%1_Часть%2", ИмяТЧИтогов, НомерЧасти),
		ИмяТЧИтогов);
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборка = Данные.Выборки[ИмяТЧИтогов];
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	КоличествоСтрок = Выборка.Количество();
	
	ОбластьЕдинственная	= ОбластиМакета[ПолучитьИмяОбластиМакетаИтогиПриложенияКРазделуПоКонтрагенту("Единственная", НомерЧасти)];
	ОбластьПервая		= ОбластиМакета[ПолучитьИмяОбластиМакетаИтогиПриложенияКРазделуПоКонтрагенту("Первая", НомерЧасти)];
	ОбластьОчередная	= ОбластиМакета[ПолучитьИмяОбластиМакетаИтогиПриложенияКРазделуПоКонтрагенту("Очередная", НомерЧасти)];
	ОбластьПоследняя	= ОбластиМакета[ПолучитьИмяОбластиМакетаИтогиПриложенияКРазделуПоКонтрагенту("Последняя", НомерЧасти)];
	
	Если КоличествоСтрок = 0 Тогда
		ЗначенияПараметров = Новый Структура("ИдентификаторКонтрагента,НаименованиеКонтрагента", "", "");
		
		ОбластьЕдинственная.Параметры.Заполнить(ЗначенияПараметров);
		
		Если ПрочеркиватьПоля Тогда
			ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьЕдинственная, Выборка, Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, КлючПрочерков);
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьЕдинственная);
		
		Возврат;
	КонецЕсли;
	
	НомерСтроки = 0;
	
	ЗначенияПараметров = Новый Структура("НаименованиеКонтрагента");
	
	ЭтоОпись0510469 = (
		НомерПриложения = 6 И НомерРаздела = 2
		Или НомерПриложения = 7 И НомерРаздела = 2
		Или НомерПриложения = 5 И НомерРаздела = 3
		Или НомерПриложения = 6 И НомерРаздела = 3);
	
	Пока Выборка.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		
		Если КоличествоСтрок = 1 Тогда
			Область = ОбластьЕдинственная;
			
		ИначеЕсли НомерСтроки = 1 Тогда
			Область = ОбластьПервая;
			
		ИначеЕсли НомерСтроки = КоличествоСтрок Тогда
			Область = ОбластьПоследняя;
			
		Иначе
			Область = ОбластьОчередная;
		КонецЕсли;
		
		Область.Параметры.Заполнить(Выборка);
		
		Если ЭтоОпись0510469 Тогда
			// Для описи 0510469 во всех приложениях есть колонка ВидНалогаИПлатежа,
			// в отличие от остальных приложений расчетов.
			Если Не ЗначениеЗаполнено(Выборка.НаименованиеКонтрагента) И ЗначениеЗаполнено(Выборка.ВидНалогаИПлатежа) Тогда
				ЗначенияПараметров.НаименованиеКонтрагента = Выборка.ВидНалогаИПлатежа;
				
				Область.Параметры.Заполнить(ЗначенияПараметров);
			КонецЕсли;
		КонецЕсли;
		
		Если ПрочеркиватьПоля Тогда
			ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка, Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, КлючПрочерков);
		КонецЕсли;
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
КонецПроцедуры

