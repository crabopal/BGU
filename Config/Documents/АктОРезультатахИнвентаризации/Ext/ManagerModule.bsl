Процедура ДобавитьУсловноеОформление_СнятьОтметкуЗаполненияПустыхБлоковОтклоненийЦеннойБумаги(ФормаДокумента)
	
	// Если излишки и недостача не указаны одновременно, то отметка заполнения отображается платформой самостоятельно.
	// Если указали излишки, то указывать недостачи уже не обязательно. И наоборот.
	// Сбрасываем отметку текущего блока, если все поля текущего блока пустые, и в противоположном блоке заполнено хотя бы одно поле.
	
	ИмяТЧ = "Приложение8кРазделу2";
	
	ВсеПоля = ПолучитьВсеПоляЦеннойБумаги();
	
	ОбязательныеПоля = ПолучитьОбязательныеПоляЦеннойБумаги();
	
	// Ключ - текущий блок, Значение - противоположный блок.
	ПостфиксыБлоков = Новый Структура();
	ПостфиксыБлоков.Вставить("ИзлишкиНеПодтверждено", "НедостачаНеПодтверждено");
	ПостфиксыБлоков.Вставить("НедостачаНеПодтверждено", "ИзлишкиНеПодтверждено");
	
	Для Каждого Элемент Из ПостфиксыБлоков Цикл
		ПостфиксТекущегоБлока = Элемент.Ключ;
		ПостфиксПротивоположногоБлока = Элемент.Значение;
		
		ПредставлениеШаблон = НСтр("ru='Снять отметку пустого блока отклонений ценной бумаги (%1, %2)'");
		
		ЭлементУО = ФормаДокумента.УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблон, ИмяТЧ, ПостфиксТекущегоБлока);
		
		// Условия
		// Все поля текущего блока пустые.
		Для Каждого ИмяПоля Из ВсеПоля Цикл
			Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрШаблон("Объект.%1.%2", ИмяТЧ, ИмяПоля + ПостфиксТекущегоБлока));
			Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		КонецЦикла;
		
		// В противоположном блоке заполнено хотя бы одно поле.
		ГруппаНЕ = ЭлементУО.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаНЕ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе;
		Для Каждого ИмяПоля Из ВсеПоля Цикл
			Условие = ГруппаНЕ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрШаблон("Объект.%1.%2", ИмяТЧ, ИмяПоля + ПостфиксПротивоположногоБлока));
			Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		КонецЦикла;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
		
		// Оформляемые поля
		Для Каждого ИмяПоля Из ОбязательныеПоля Цикл
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоля + ПостфиксТекущегоБлока);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

