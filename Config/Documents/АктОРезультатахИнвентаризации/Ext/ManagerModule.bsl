Процедура ОбновитьСведенияОбОписиВПриложениях(ДокументОбъект, НомерРаздела, ИдентификаторСтроки, РеквизитыОписи)
	
	Поиск = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	
	Для Каждого ЭлементПриложения Из ПолучитьНомераПриложенийКРазделу(НомерРаздела) Цикл
		НомерПриложения = ЭлементПриложения.Значение;
		
		ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
		
		ТЧПриложения = ДокументОбъект[ИмяТЧПриложения];
		
		МассивСтрок = ТЧПриложения.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаПриложения Из МассивСтрок Цикл
			ЗаполнитьЗначенияСвойств(СтрокаПриложения, РеквизитыОписи);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьКодФормыИНомерПриложения(ОписьСсылка, НомерРаздела)
	
	Результат = Новый Структура("КодФормы,НомерПриложения");
	
	КодыФорм = КодыФорм();
	
	ТаблицаПримененияОписейВРазделах = ПолучитьТаблицуПримененияОписейВРазделах(КодыФорм.ДокументыОписей);
	
	СтрокаТаблицыПрименения = ТаблицаПримененияОписейВРазделах.Найти(ТипЗнч(ОписьСсылка), "ТипДокумента");
	
	Если СтрокаТаблицыПрименения = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.КодФормы = СтрокаТаблицыПрименения.КодФормы;
	
	Если НомерРаздела > 1 Тогда
		Результат.НомерПриложения = ОпределитьНомерПриложения(СтрокаТаблицыПрименения, НомерРаздела);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПредставлениеНомераПриложенияКРазделу2(НомерПриложения, НомераПриложенийКРазделу2)
	
	// Особые представления есть только у приложений 11.1 и 11.2 к разделу 2.
	// Представления всех остальных номеров приложений совпадают с номером приложения.
	
	Элемент = НомераПриложенийКРазделу2.НайтиПоЗначению(НомерПриложения);
	
	Если Элемент = Неопределено Тогда
		Возврат Строка(НомерПриложения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Элемент.Представление) Тогда
		Возврат Элемент.Представление;
	КонецЕсли;
	
	Возврат Строка(НомерПриложения);
	
КонецФункции

Процедура УдалитьОтмененныеСтроки(ТаблицаОбъекты)
	
	ТипИзмененияОтмена = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена;
	
	КоличествоСтрок = ТаблицаОбъекты.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		Индекс = КоличествоСтрок - Счетчик;
		
		СтрокаТаблицы = ТаблицаОбъекты[Индекс];
		
		Если СтрокаТаблицы.ТипИзменения = ТипИзмененияОтмена Тогда
			ТаблицаОбъекты.Удалить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

