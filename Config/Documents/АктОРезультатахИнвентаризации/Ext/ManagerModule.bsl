	КонецЕсли;
		
	ЗначенияПараметров.Вставить("КоличествоНеСоответствует", Формат(Выборка.КоличествоНеСоответствует, ФорматнаяСтрокаКоличества));
	ЗначенияПараметров.Вставить("КоличествоПодлежитОбесценению", Формат(Выборка.КоличествоПодлежитОбесценению, ФорматнаяСтрокаКоличества));

	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей,
