	Пока ВыборкаПоУчетнойГруппеКонтрагентов.Следующий() Цикл
		// ЧАСТЬ 1
		
		ПредставлениеНомераПодраздела = СтрШаблон("2.12.%1", ПолучитьНомерУчетнойГруппыКонтрагентовДляПечати(
			ВыборкаПоУчетнойГруппеКонтрагентов.НомерУчетнойГруппыКонтрагентов));
		
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("НомерПодраздела", ПредставлениеНомераПодраздела);
		ЗначенияПараметров.Вставить("НаименованиеГруппыКонтрагентов", ВыборкаПоУчетнойГруппеКонтрагентов.НаименованиеГруппыКонтрагентов);
		
