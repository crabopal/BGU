Процедура ПечатьФормы0510463_Титул(ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов, ТиповыеПараметры)
	
	ОбластиМакета = ОбластиМакетов.Титул;
	
	// УТВЕРЖДАЮ
	
	ЗначенияПараметров = Новый Структура();
	
	ЗаполнитьПараметрыТитулУтверждаю(ЗначенияПараметров, СтрокаШапки);
	
	Область = ОбластиМакетов.Титул.Утверждаю;
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	// ЗАГОЛОВОК
	
	ЗначенияПараметров = Новый Структура();
	
	УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, СтрокаШапки.Ссылка, Данные.СведенияУчреждений);
	
	НомерАкта = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.Ссылка,
		СтрокаШапки.Номер);
		
	Данные.ДополнительныеПараметры.Вставить("НомерАкта", НомерАкта);
	
	ЗначенияПараметров.Вставить("Дата",	СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Номер", Данные.ДополнительныеПараметры.НомерАкта);
	
	Область = ОбластиМакета["Заголовок"];
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛЫ 1, 2, 3
	
	ВывестиРаздел("1", ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов);
	
	ВывестиРаздел("2", ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов);
	
	ВывестиРаздел("3", ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов);
	
	// КОМИССИЯ
	
	ПараметрыВывода = УправлениеПечатьюБГУ.ПараметрыВыводаСоставаКомиссииПриПечати();
	ПараметрыВывода.ЗаголовокПервогоРядовогоЧлена = НСтр("ru='Член комиссии'");
	ПараметрыВывода.ЗаголовокПоследующихРядовыхЧленов = НСтр("ru='Член комиссии'");
	ПараметрыВывода.ВыводитьДополнительныеСведения = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьПричинуОтсутствия = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьЗамещающегоСотрудника = Истина;
	
	УправлениеПечатьюБГУ.ВывестиСоставКомиссииПриПечати(ТабДокумент, СтрокаШапки.Ссылка, ОбластиМакетов.Титул.ЧленКомиссии, Данные.СоставКомиссий, ПараметрыВывода);
	
	// ПОДВАЛ
	
	ЗначенияПараметров = Новый Структура();
	
	ЗаполнитьПараметрыОтветственногоИсполнителя(ЗначенияПараметров, СтрокаШапки);
	
	ОбластьПодвал = ОбластиМакетов.Титул.Подвал;
	ОбластьПодвал.Параметры.Заполнить(ЗначенияПараметров);
	
	Если Не ТабДокумент.ПроверитьВывод(ОбластьПодвал) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьПодвал);	
	
КонецПроцедуры

Процедура ПечатьФормы0510463_Приложения(ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов, ТиповыеПараметры)
	
	// Приложения к разделу 2
	
	НомераРазделов = НомераРазделовСПриложениями();
	
	Для Каждого НомерРаздела Из НомераРазделов Цикл
		
		Для Каждого ЭлементПриложения Из ПолучитьНомераПриложенийКРазделу(НомерРаздела) Цикл
			НомерПриложения = ЭлементПриложения.Значение;
			
			Если Не ЕстьДанныеДляПечатиПриложения(Данные, СтрокаШапки, НомерПриложения, НомерРаздела) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НомерПриложения = 111 И НомерРаздела = 2 Тогда
				ТабДокументПриложение = ВывестиПриложение11кРазделу2(Данные, СтрокаШапки, ОбластиМакетов);
				
			ИначеЕсли НомерПриложения = 12 И НомерРаздела = 2 Тогда
				ТабДокументПриложение = ВывестиПриложение12кРазделу2(Данные, СтрокаШапки, ОбластиМакетов);
				
			ИначеЕсли НомерПриложения = 13 И НомерРаздела = 2 Тогда
				ТабДокументПриложение = ВывестиПриложение13кРазделу2(Данные, СтрокаШапки, ОбластиМакетов);
				
			ИначеЕсли НомерПриложения = 10 И НомерРаздела = 3 Тогда
				ТабДокументПриложение = ВывестиПриложение10кРазделу3(Данные, СтрокаШапки, ОбластиМакетов);
				
			Иначе
				ТабДокументПриложение = ВывестиПриложение(НомерПриложения, НомерРаздела, Данные, СтрокаШапки, ОбластиМакетов);
			КонецЕсли;
			
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			ТабДокумент.Вывести(ТабДокументПриложение);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиРаздел(НомерРазделаСтрокой, ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов)
	
	ОбщаяВыборка = Данные.Выборки["Раздел" + НомерРазделаСтрокой];
	
	Выборка = ПолучитьВыборкуПоДокументу(ОбщаяВыборка, СтрокаШапки.Ссылка);
	
	// В случае отсутствия информации по разделам 2 и 3 указанные разделы не формируются
	Если Выборка.Количество() = 0 И (НомерРазделаСтрокой = "2" Или НомерРазделаСтрокой = "3") Тогда
		Возврат;
	КонецЕсли;
	
	// ЗАГОЛОВОК И ТАБЛИЦА
	
	ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
	
	ПараметрыВыводаТаблицы.Области.Заголовок		= ОбластиМакетов.Титул["Раздел" + НомерРазделаСтрокой + "Заголовок"];
	ПараметрыВыводаТаблицы.Области.ШапкаТаблицы		= ОбластиМакетов.Титул["Раздел" + НомерРазделаСтрокой + "Шапка"];
	ПараметрыВыводаТаблицы.Области.СтрокаТаблицы	= ОбластиМакетов.Титул["Раздел" + НомерРазделаСтрокой + "Строка"];
	
	ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктОРезультатахИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Разделы123";
	
	ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
	
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Ложь;
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
	
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("НаименованияОписей", Данные.НаименованияОписей);
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("СтрокаШапки", СтрокаШапки);
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ДанныеСотрудников", Данные.ДанныеСотрудников);
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("НомерРазделаСтрокой", НомерРазделаСтрокой);
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("НомераПриложенийКРазделу2", Данные.ДополнительныеПараметры.НомераПриложенийКРазделу2);
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ПрочеркиПустыхПолей", Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей);
	
	ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
	
	ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
	
	НастроитьНижнююГраницу(ТабДокумент, ОбластиМакетов.Титул["Раздел" + НомерРазделаСтрокой + "Строка"]);

КонецПроцедуры

Функция ВывестиПриложение(НомерПриложения, НомерРаздела, Данные, СтрокаШапки, ОбластиМакетов)
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = Данные.ДополнительныеПараметры.КлючПараметровПечати;
	
	ИмяТЧ = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	// ОПИСАНИЕ
	
	Область = ОбластиМакетов[ИмяТЧ].Описание;
	
	ЗначенияПараметров = Новый Структура("Номер", Данные.ДополнительныеПараметры.НомерАкта);
	
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	
	ТабДокумент.Вывести(Область);
	
	// ЗАГОЛОВОК
	
	ТабДокумент.Вывести(ОбластиМакетов[ИмяТЧ].Заголовок);
	
	// ТАБЛИЦА
	
	ОбщаяВыборка = Данные.Выборки[ИмяТЧ];
	
	ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
	
	ПараметрыВыводаТаблицы.ДополнительныеПараметры = Данные.ДополнительныеПараметры;
	
	Если ПолучитьКоличествоНаборовКолонокМакетаПечатнойФормыПриложения(НомерПриложения, НомерРаздела) = 2 Тогда
		// Два набора колонок
		
		// Набор колонок №1
		
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы				= ОбластиМакетов[ИмяТЧ].Шапка1;
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы			= ОбластиМакетов[ИмяТЧ].Строка1;
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами	= ОбластиМакетов[ИмяТЧ].Итого1;
		
		ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
		
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Истина;
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
		
		Выборка = ПолучитьВыборкуПоДокументу(ОбщаяВыборка, СтрокаШапки.Ссылка);
		
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ОбщаяВыборка;
		
		УстановитьОбработчикЗаполненияСтрокиМакета(ПараметрыВыводаТаблицы, НомерПриложения, НомерРаздела, 1);
		
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
		
		НомерЧасти = 1;
		
		Если НомерПриложения = 3 И НомерРаздела = 3
			Или НомерПриложения = 4 И НомерРаздела = 3
			Или НомерПриложения = 5 И НомерРаздела = 3
			Или НомерПриложения = 6 И НомерРаздела = 3 Тогда
			ВывестиИтогиПриложенияРасчетовПоСчету(ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов,
				НомерПриложения, НомерРаздела, НомерЧасти);
			
			ВывестиИтогиПриложенияРасчетовПоКонтрагенту(ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов,
				НомерПриложения, НомерРаздела, НомерЧасти);
		КонецЕсли;
		
		// Набор колонок №2
		
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы				= ОбластиМакетов[ИмяТЧ].Шапка2;
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы			= ОбластиМакетов[ИмяТЧ].Строка2;
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами	= ОбластиМакетов[ИмяТЧ].Итого2;
		
		ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
		
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
		
		Выборка = ПолучитьВыборкуПоДокументу(ОбщаяВыборка, СтрокаШапки.Ссылка);
		
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ОбщаяВыборка;
		
		УстановитьОбработчикЗаполненияСтрокиМакета(ПараметрыВыводаТаблицы, НомерПриложения, НомерРаздела, 2);
		
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
		
		НомерЧасти = 2;
		
		Если НомерПриложения = 3 И НомерРаздела = 3
			Или НомерПриложения = 4 И НомерРаздела = 3
			Или НомерПриложения = 5 И НомерРаздела = 3
			Или НомерПриложения = 6 И НомерРаздела = 3 Тогда
			ВывестиИтогиПриложенияРасчетовПоСчету(ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов,
				НомерПриложения, НомерРаздела, НомерЧасти, Ложь);
			
			ВывестиИтогиПриложенияРасчетовПоКонтрагенту(ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов,
				НомерПриложения, НомерРаздела, НомерЧасти, Ложь);
		КонецЕсли;
	Иначе
		// Всего один-единственный набор колонок
		
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы				= ОбластиМакетов[ИмяТЧ].Шапка;
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы			= ОбластиМакетов[ИмяТЧ].Строка;
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами	= ОбластиМакетов[ИмяТЧ].Итого;
		
		ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
		
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
		
		Выборка = ПолучитьВыборкуПоДокументу(ОбщаяВыборка, СтрокаШапки.Ссылка);
		
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ОбщаяВыборка;
		
		УстановитьОбработчикЗаполненияСтрокиМакета(ПараметрыВыводаТаблицы, НомерПриложения, НомерРаздела);
		
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
		
		Если НомерПриложения = 4 И НомерРаздела = 2
			Или НомерПриложения = 5 И НомерРаздела = 2
			Или НомерПриложения = 6 И НомерРаздела = 2
			Или НомерПриложения = 7 И НомерРаздела = 2 Тогда
			ВывестиИтогиПриложенияРасчетовПоСчету(ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов,
				НомерПриложения, НомерРаздела);
			
			ВывестиИтогиПриложенияРасчетовПоКонтрагенту(ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов,
				НомерПриложения, НомерРаздела);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

