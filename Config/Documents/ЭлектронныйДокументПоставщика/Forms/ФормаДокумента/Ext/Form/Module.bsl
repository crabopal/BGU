&НаКлиенте
Процедура СписокНоменклатурыРНПТНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПрослеживаемостьФормыБГУКлиент.ОткрытьФормуПодбораРНПТ(ЭтаФорма, "СписокНоменклатуры");
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыРНПТОчистка(Элемент, СтандартнаяОбработка)
	
	СтрокаТабличнойЧасти = Элементы.СписокНоменклатуры.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		
		Если СтрокаТабличнойЧасти.ПрослеживаемыйТовар 
			И НЕ ПоставщикРезидентТаможенногоСоюза Тогда
			СтрокиСРНПТ = Объект.СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТабличнойЧасти.ИдентификаторСтроки));
			
			Для Каждого СтрокаСРНПТ Из СтрокиСРНПТ Цикл
				Объект.СведенияПрослеживаемости.Удалить(СтрокаСРНПТ);
			КонецЦикла;
		КонецЕсли;
		
		ПрослеживаемостьФормыБГУКлиентСервер.ЗаполнитьПредставлениеРНПТ(ЭтаФорма, СтрокаТабличнойЧасти);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "СписокНоменклатурыРНПТ" Тогда
		ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
		Если ТекущиеДанные.ПрослеживаемыйТовар 
			И НЕ ПоставщикРезидентТаможенногоСоюза Тогда
			ПрослеживаемостьФормыБГУКлиент.ОткрытьФормуПодбораРНПТ(ЭтаФорма, "СписокНоменклатуры");
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Поле.Имя = "СписокНоменклатурыПрослеживаемыйТовар" Тогда
		ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
		Если ТекущиеДанные.ПрослеживаемыйТовар Тогда
			ПрослеживаемостьФормыБГУКлиент.ПоказатьПредупреждениеПрослеживаемыйТовар();
		Конецесли;
	КонецЕсли;
	
КонецПроцедуры

