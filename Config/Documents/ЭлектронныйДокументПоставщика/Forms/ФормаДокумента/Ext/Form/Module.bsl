КонецПроцедуры

&НаКлиенте
Процедура УстановитьСвойстваНоменклатурыОрганизации(Команда)

	ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("Дата", Объект.Дата);
	
	ТипНоменклатурыЭДО = 0;
	Если ТИпЗнч(ТекущиеДанные.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		ТипНоменклатурыЭДО = 0;
	ИначеЕсли ТИпЗнч(ТекущиеДанные.Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		ТипНоменклатурыЭДО = 1;
	ИначеЕсли ТИпЗнч(ТекущиеДанные.Номенклатура) = Тип("СправочникСсылка.ДенежныеДокументы") Тогда
		ТипНоменклатурыЭДО = 2;
	КонецЕсли;	
	ПараметрыФормы.Вставить("ТипНоменклатурыЭДО", ТипНоменклатурыЭДО);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьРеквизитыСтрокЗавершение", ЭтотОбъект);
	ОткрытьФорму("Документ.ЭлектронныйДокументПоставщика.Форма.ФормаГрупповогоИзмененияРеквизитовНоменклатуры", ПараметрыФормы,,,,,
		ОписаниеОповещения);
	
КонецПроцедуры

