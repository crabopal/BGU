&НаКлиенте
Процедура ИзменитьРеквизитыСтрокЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ИдентификаторСтроки Из Элементы.СписокНоменклатуры.ВыделенныеСтроки Цикл
		ТекущиеДанные = Объект.СписокНоменклатуры.НайтиПоИдентификатору(ИдентификаторСтроки);
		ИзменитьРеквизитыНоменклатурыНаСервере(ТекущиеДанные.Номенклатура, Результат);
	КонецЦикла;
	
	ОбновитьТекстВидовНоменклатурыВсехСтрокТаблицыСписокНоменклатуры();	

КонецПроцедуры

&НаСервере
Процедура ИзменитьРеквизитыНоменклатурыНаСервере(Номенклатура, ИзмененныеЗначенияРеквизитов)
	НоменклатураДляИзменения = Номенклатура.ПолучитьОбъект();
	НоменклатураИзменена = Ложь;
	Если ИзмененныеЗначенияРеквизитов.ТипНоменклатурыЭДО = 0 Тогда
		Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			Если ИзмененныеЗначенияРеквизитов.Свойство("ТипНоменклатуры") Тогда
				Если ЗначениеЗаполнено(ИзмененныеЗначенияРеквизитов.ТипНоменклатуры) Тогда
					НоменклатураДляИзменения.ТипНоменклатуры = ИзмененныеЗначенияРеквизитов.ТипНоменклатуры;
					НоменклатураИзменена = Истина;
				КонецЕсли;
			КонецЕсли;	
			Если ИзмененныеЗначенияРеквизитов.Свойство("ЕдиницаИзмерения") Тогда
				Если ЗначениеЗаполнено(ИзмененныеЗначенияРеквизитов.ЕдиницаИзмерения) Тогда
					НоменклатураДляИзменения.ЕдиницаИзмерения = ИзмененныеЗначенияРеквизитов.ЕдиницаИзмерения;
					НоменклатураИзменена = Истина;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	ИначеЕсли ИзмененныеЗначенияРеквизитов.ТипНоменклатурыЭДО = 1 Тогда
		Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			Если ИзмененныеЗначенияРеквизитов.Свойство("ИмуществоКазны") Тогда
				НоменклатураДляИзменения.ИмуществоКазны = ИзмененныеЗначенияРеквизитов.ИмуществоКазны;
				НоменклатураИзменена = Истина;
			КонецЕсли;	
			Если ИзмененныеЗначенияРеквизитов.Свойство("ВидНФА") Тогда
				Если ЗначениеЗаполнено(ИзмененныеЗначенияРеквизитов.ВидНФА) Тогда
					НоменклатураДляИзменения.ВидНФА = ИзмененныеЗначенияРеквизитов.ВидНФА;
					НоменклатураИзменена = Истина;
				КонецЕсли;
			КонецЕсли;	
			Если ИзмененныеЗначенияРеквизитов.Свойство("ТипНФА") Тогда
				Если ЗначениеЗаполнено(ИзмененныеЗначенияРеквизитов.ТипНФА) Тогда
					НоменклатураДляИзменения.ТипНФА = ИзмененныеЗначенияРеквизитов.ТипНФА;
					НоменклатураИзменена = Истина;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	ИначеЕсли ИзмененныеЗначенияРеквизитов.ТипНоменклатурыЭДО = 2 Тогда
		Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ДенежныеДокументы") Тогда
			Если ИзмененныеЗначенияРеквизитов.Свойство("НомСтоимость") Тогда
				НоменклатураДляИзменения.НомСтоимость = ИзмененныеЗначенияРеквизитов.НомСтоимость;
				НоменклатураИзменена = Истина;
			КонецЕсли;	
			Если ИзмененныеЗначенияРеквизитов.Свойство("ЕдиницаИзмерения") Тогда
				Если ЗначениеЗаполнено(ИзмененныеЗначенияРеквизитов.ЕдиницаИзмерения) Тогда
					НоменклатураДляИзменения.ЕдиницаИзмерения = ИзмененныеЗначенияРеквизитов.ЕдиницаИзмерения;
					НоменклатураИзменена = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если НоменклатураИзменена Тогда
		Попытка
			НоменклатураДляИзменения.Записать();
		Исключение
				
			ТекстСообщения  = НСтр("ru='Не удалось записать изменения реквизитов номенклатуры: %ИмяПараметра%'");
			ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%ИмяПараметра%", НоменклатураДляИзменения);
			Сообщение       = Новый СообщениеПользователю();
			Сообщение.Текст = ТекстСообщения;
			Сообщение.Сообщить();
				
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

#Область ОбменСГИСЭПД

&НаСервере
Процедура ОбработкаВыбораЭТрННаСервере(ВыбранноеЗначение)

	ЭлектроннаяТранспортнаяНакладная = ВыбранноеЗначение;
	СостояниеЭТрН = ЭлектронныеДокументыБГУ.СостояниеЭТрН(ЭлектроннаяТранспортнаяНакладная, Объект.Ссылка);

	Если ЗначениеЗаполнено(ЭлектроннаяТранспортнаяНакладная) Тогда
		Если НЕ ЭлектроннаяТранспортнаяНакладнаяПривязанаКДокументуПоставщика(ЭлектроннаяТранспортнаяНакладная, Объект.Ссылка) Тогда
			Попытка
				ОбъектЭПД = ЭлектроннаяТранспортнаяНакладная.ПолучитьОбъект();
				НоваяСтрока = ОбъектЭПД.ДокументыОснования.Добавить();
				НоваяСтрока.ДокументОснование = Объект.Ссылка;
				ОбъектЭПД.Записать();
			Исключение
					
				ТекстСообщения  = НСтр("ru='Не удалось записать этот документ в качестве основания документа: %ИмяПараметра%'");
				ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%ИмяПараметра%", ЭлектроннаяТранспортнаяНакладная);
				Сообщение       = Новый СообщениеПользователю();
				Сообщение.Текст = ТекстСообщения;
				Сообщение.Сообщить();
					
			КонецПопытки;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ЭлектроннаяТранспортнаяНакладнаяПривязанаКДокументуПоставщика(ЭлектроннаяТранспортнаяНакладная, ДокументПоставщика)
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектроннаяТранспортнаяНакладнаяДокументыОснования.ДокументОснование КАК ДокументОснование
	               |ИЗ
	               |	Документ.ЭлектроннаяТранспортнаяНакладная.ДокументыОснования КАК ЭлектроннаяТранспортнаяНакладнаяДокументыОснования
	               |ГДЕ
	               |	ЭлектроннаяТранспортнаяНакладнаяДокументыОснования.Ссылка = &ЭлектроннаяТранспортнаяНакладная
	               |	И ЭлектроннаяТранспортнаяНакладнаяДокументыОснования.ДокументОснование = &ДокументПоставщика";
	Запрос.УстановитьПараметр("ЭлектроннаяТранспортнаяНакладная", ЭлектроннаяТранспортнаяНакладная);
	Запрос.УстановитьПараметр("ДокументПоставщика", ДокументПоставщика);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Истина;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ИсточникВыбора.ИмяФормы = "ЖурналДокументов.ЭлектронныеПеревозочныеДокументы.Форма.ФормаВыбора" Тогда
		ОбработкаВыбораЭТрННаСервере(ВыбранноеЗначение);
	КонецЕсли;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстВсехСтрокТаблицыСписокНоменклатуры(Форма)

	Объект = Форма.Объект;
	Для Каждого ТекущаяСтрока Из Объект.СписокНоменклатуры Цикл
		ОбновитьТекстВСтрокеТаблицыСписокНоменклатуры(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьКартинкиВсехСтрокТаблицыСписокНоменклатуры(Форма)
	Объект = Форма.Объект;
	ТаблицаСДаннымиОРазницеВНоменклатуре = Форма.ДанныеОСравненииНоменклатуры.Выгрузить();
	ЕстьРазличияВНоменклатуре = ?(ТаблицаСДаннымиОРазницеВНоменклатуре.Количество() > 0, Истина, Ложь);
	Если ЕстьРазличияВНоменклатуре Тогда
		Для Каждого ТекущаяСтрока Из ТаблицаСДаннымиОРазницеВНоменклатуре Цикл
			Объект.СписокНоменклатуры[ТекущаяСтрока.НомерСтроки-1].ЕстьЗамечания = ?(Форма.КонтролироватьСоответствиеНаименованияТРУ, 4, 3);		
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьКартинкуВСтрокеТаблицыСписокНоменклатуры(ТекущаяСтрока, НоменклатураСовпадает, КонтролироватьСоответствиеНаименованияТРУ)
	Если НЕ НоменклатураСовпадает Тогда
		ТекущаяСтрока.ЕстьЗамечания = ?(КонтролироватьСоответствиеНаименованияТРУ, 4, 3);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура НоменклатураСовпадает(ИдентификаторПоставщика, Номенклатура, Результат)
	Результат = НЕ ЭлектронныеДокументыБГУ.ЕстьРазличияВНоменклатуреПоставщикаИОрганизации(ИдентификаторПоставщика, Номенклатура);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстВСтрокеТаблицыСписокНоменклатуры(ТекущаяСтрока)
	Если ЗначениеЗаполнено(ТекущаяСтрока.Содержание) И НЕ ЗначениеЗаполнено(ТекущаяСтрока.НаименованиеПоставщика) Тогда
		ТекущаяСтрока.НаименованиеПоставщика = ТекущаяСтрока.Содержание;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущаяСтрока.ИдентификаторПоставщика) Тогда
		ТекущаяСтрока.ЕстьЗамечания = 1;
	Иначе
		ТекущаяСтрока.ЕстьЗамечания = -1;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеНастроекЭДОБГУ()

	КонтролироватьСоответствиеНаименованияТРУ = ЭлектронныеДокументыБГУ.КонтролироватьСоответствиеНаименованияТРУДляДокументовУчетаНаОснованииЭДП(Объект.Организация);

КонецПроцедуры

#КонецОбласти

// ИнтеграцияС1САрхивом
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивомНаСервере(Знач Параметры) Экспорт
	ОбменСАрхивом.ВыполнитьПодключаемуюКоманду(ЭтотОбъект, Параметры);
КонецПроцедуры
