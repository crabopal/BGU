&НаКлиенте
Процедура СписокНоменклатурыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
		ОбновитьТекстЗаголовковВСтрокеТаблицыСписокНоменклатуры(ТекущиеДанные);
	КонецЕсли;	
	
	Если Копирование Тогда
		Элемент.ТекущиеДанные.ИдентификаторСтроки = "";
		Если Элемент.ТекущиеДанные.ПрослеживаемыйТовар Тогда
			Элемент.ТекущиеДанные.РНПТ = "";
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыНоменклатураПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
	
	ДанныеНоменклатурыОрганизацииСтроки = ДанныеНоменклатурыОрганизацииСтроки(ТекущиеДанные.Номенклатура);
	
	ТекущиеДанные.ВидНоменклатурыДляОтраженияВУчете = ДанныеНоменклатурыОрганизацииСтроки.Вид;
	
	Если ТекущиеДанные.ПризнакНоменклатуры = "1ВТ" Тогда
		ТекущиеДанные.ВидНоменклатурыДляОтраженияВУчете = НСтр("ru='Возвратная тара'");	
	КонецЕсли;
	
	ТекущиеДанные.ЕдиницаИзмеренияНоменклатуры = ДанныеНоменклатурыОрганизацииСтроки.ЕдиницаИзмерения;
	
	ОбновитьТекстВСтрокеТаблицыСписокНоменклатуры(ТекущиеДанные);

	НоменклатураСовпадает = Истина;
	Если ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторПоставщика) Тогда
		НоменклатураСовпадает(ТекущиеДанные.ИдентификаторПоставщика, ТекущиеДанные.Номенклатура, НоменклатураСовпадает); 
		ОбновитьКартинкуВСтрокеТаблицыСписокНоменклатуры(ТекущиеДанные, НоменклатураСовпадает, КонтролироватьСоответствиеНаименованияТРУ);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыКоличествоПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
	РассчитатьСтроку(Элементы.СписокНоменклатуры.ТекущиеДанные, Объект.СуммаВключаетНДС, "Количество");
	
