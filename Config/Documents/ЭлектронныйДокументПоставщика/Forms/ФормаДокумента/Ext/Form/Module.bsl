&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыСписокНоменклатуры(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.СписокНоменклатуры Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыСписокНоменклатуры(ТекущаяСтрока);
		
		ПрослеживаемостьФормыБГУКлиентСервер.ЗаполнитьПредставлениеРНПТ(Форма, ТекущаяСтрока);
	КонецЦикла;

	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыСписокНоменклатуры(ТекущаяСтрока)

	ТекущаяСтрока.ЗаголовокНоменклатурыПоставщика = НСтр("ru = 'у поставщика:'");
	ТекущаяСтрока.ЗаголовокНоменклатуры = НСтр("ru = 'в организации:'");
	
	ТекущаяСтрока.ЗаголовокПризнак = НСтр("ru = 'признак:'");
	Если ТекущаяСтрока.ПризнакНоменклатуры = "1" 
		ИЛИ ТекущаяСтрока.ПризнакНоменклатуры = "1МЗ"
		ИЛИ ТекущаяСтрока.ПризнакНоменклатуры = "1ОС" Тогда
		ТекущаяСтрока.ПризнакНоменклатурыПоставщика = НСтр("ru = '1 - имущество'");	
	ИначеЕсли ТекущаяСтрока.ПризнакНоменклатуры = "1ВТ" Тогда
		ТекущаяСтрока.ПризнакНоменклатурыПоставщика = НСтр("ru = '1 - возвратная тара'");	
	ИначеЕсли ТекущаяСтрока.ПризнакНоменклатуры = "2" Тогда
		ТекущаяСтрока.ПризнакНоменклатурыПоставщика = НСтр("ru = '2 - работа'");	
	ИначеЕсли ТекущаяСтрока.ПризнакНоменклатуры = "3" Тогда
		ТекущаяСтрока.ПризнакНоменклатурыПоставщика = НСтр("ru = '3 - услуга'");	
	ИначеЕсли ТекущаяСтрока.ПризнакНоменклатуры = "4" Тогда
		ТекущаяСтрока.ПризнакНоменклатурыПоставщика = НСтр("ru = '4 - имущественные права'");	
	ИначеЕсли ТекущаяСтрока.ПризнакНоменклатуры = "5" Тогда
		ТекущаяСтрока.ПризнакНоменклатурыПоставщика = НСтр("ru = '5 - иное'");	
	Иначе
		ТекущаяСтрока.ПризнакНоменклатурыПоставщика = НСтр("ru = 'не указан'");	
	КонецЕсли;	
	
	ТекущаяСтрока.ЗаголовокВидНоменклатуры = НСтр("ru = 'вид:'");
	
	ТекущаяСтрока.ЗаголовокЕдиницаИзмеренияКод = НСтр("ru = 'код ед.изм.:'");
	ТекущаяСтрока.ЗаголовокЕдиницаИзмерения = НСтр("ru = 'ед.изм.:'");
	
	ТекущаяСтрока.ЗаголовокСтранаПроисхождения = НСтр("ru = 'страна происхождения:'");
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.Содержание) И НЕ ЗначениеЗаполнено(ТекущаяСтрока.НаименованиеПоставщика) Тогда
		ТекущаяСтрока.НаименованиеПоставщика = ТекущаяСтрока.Содержание;
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстВсехСтрокТаблицыКодовМаркировки()

	Для Каждого ТекущаяСтрока Из Объект.КодыУпаковокМаркируемойПродукции Цикл
		ОбновитьТекстВСтрокеТаблицыКодовМаркировки(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстВСтрокеТаблицыКодовМаркировки(ТекущаяСтрока)

	ТекущаяСтрока.МаркируемыйТовар = МаркируемыйТовар(ТекущаяСтрока.ИдентификаторСтроки);

КонецПроцедуры

&НаСервере
Функция МаркируемыйТовар(ИдентификаторСтроки)
	Результат = Справочники.Номенклатура.ПустаяСсылка();
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
	НайденныеСтроки = Объект.СписокНоменклатуры.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()>0 Тогда
		Результат = НайденныеСтроки[0].Номенклатура;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ОбновитьТекстВидовНоменклатурыВсехСтрокТаблицыСписокНоменклатуры()
	ДанныеНоменклатурыОрганизации = ДанныеНоменклатурыОрганизации();
	
	ДанныеВидовНоменклатуры = ДанныеНоменклатурыОрганизации.ВидыНоменклатурыОрганизации;
	ДанныеЕдИзмНоменклатуры = ДанныеНоменклатурыОрганизации.ЕдиницыИзмеренияНоменклатуры;
	ДанныеТребуетсяКонтрольПересчета = ДанныеНоменклатурыОрганизации.ТребуетсяНастройкаПересчетаКоличества;
	
	н = 0;
	Для Каждого ТекущаяСтрока Из Объект.СписокНоменклатуры Цикл
		НаименованиеВидаНоменклатуры = ДанныеВидовНоменклатуры[н];
		Если ЗначениеЗаполнено(НаименованиеВидаНоменклатуры) Тогда
			ТекущаяСтрока.ВидНоменклатурыДляОтраженияВУчете = НаименованиеВидаНоменклатуры;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			Если ТекущаяСтрока.ПризнакНоменклатуры = "1ВТ" Тогда
				ТекущаяСтрока.ВидНоменклатурыДляОтраженияВУчете = НСтр("ru='Возвратная тара'");	
			КонецЕсли;
		КонецЕсли;
		
		ТекущаяСтрока.ЕдиницаИзмеренияНоменклатуры = ДанныеЕдИзмНоменклатуры[н];
		
		ТекущаяСтрока.ТребуетсяНастройкаПересчетаКоличества = ДанныеТребуетсяКонтрольПересчета[н];
		
		н = н + 1;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	СчетФактура = СчетФактураДокументаПоставщика(Объект);

	ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы(ЭтотОбъект, Объект);
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыСписокНоменклатуры(ЭтаФорма);
	ОбновитьТекстВсехСтрокТаблицыКодовМаркировки();
	ОбновитьТекстВидовНоменклатурыВсехСтрокТаблицыСписокНоменклатуры();
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	НадписьОтражениеВУчете = ТекстОтраженияВУчете();
	
	Если Объект.ТипФорматаЭД = 0 Тогда
		НадписьТипФорматаЭД = НСтр("ru='УПД'");
	ИначеЕсли Объект.ТипФорматаЭД = 3 Тогда
		НадписьТипФорматаЭД = НСтр("ru='Документ государственного заказчика'");
	ИначеЕсли Объект.ТипФорматаЭД = 4 Тогда
		НадписьТипФорматаЭД = НСтр("ru='УПД поставщика (ЦС: организация-грузополучатель)'");
	ИначеЕсли Объект.ТипФорматаЭД = 5 Тогда
		НадписьТипФорматаЭД = НСтр("ru='Документ поставщика (ЦС: организация-грузополучатель)'");
	ИначеЕсли Объект.ТипФорматаЭД = 6 Тогда
		НадписьТипФорматаЭД = НСтр("ru='Акт о приемке выполненных работ в строительстве'");
	Иначе
		НадписьТипФорматаЭД = НСтр("ru='Документ поставщика'");
	КонецЕсли;	
	
	НастройкаЗаголовковКоманд();
	
КонецПроцедуры

&НаСервере
Процедура НастройкаЗаголовковКоманд()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаСоздатьНаОсновании", "Заголовок", НСтр("ru = 'Создать документ поступления'"));
    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаДокументПоступлениеМЗСоздатьНаОсновании", "Заголовок", СинонимДокументаУчета(Документы.ПоступлениеМЗ.ПустаяСсылка()));
 	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаДокументПоступлениеОССоздатьНаОсновании", "Заголовок", СинонимДокументаУчета(Документы.ПоступлениеОС.ПустаяСсылка()));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаДокументПоступлениеУслугРаботСоздатьНаОсновании", "Заголовок", СинонимДокументаУчета(Документы.ПоступлениеУслугРабот.ПустаяСсылка()));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаДокументПоступлениеМЗВПутиСоздатьНаОсновании", "Заголовок", СинонимДокументаУчета(Документы.ПоступлениеМЗВПути.ПустаяСсылка()));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаДокументПоступлениеОСВПутиСоздатьНаОсновании", "Заголовок", СинонимДокументаУчета(Документы.ПоступлениеОСВПути.ПустаяСсылка()));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаДокументПоступлениеИКСоздатьНаОсновании", "Заголовок", СинонимДокументаУчета(Документы.ПоступлениеИК.ПустаяСсылка()));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаДокументПрочееОтражениеЭлектронногоДокументаВУчетеСоздатьНаОсновании", "Заголовок", СинонимДокументаУчета(Документы.ПрочееОтражениеЭлектронногоДокументаВУчете.ПустаяСсылка()));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаДокументПриходныйОрдерФондовыйСоздатьНаОсновании", "Заголовок", СинонимДокументаУчета(Документы.ПриходныйОрдерФондовый.ПустаяСсылка()));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаДокументПоступлениеОСИКСоздатьНаОсновании", "Заголовок", СинонимДокументаУчета(Документы.ПоступлениеОСИК.ПустаяСсылка()));

КонецПроцедуры

&НаСервере
Функция СинонимДокументаУчета(ВыбранныйТипДокументаУчета)
	
	Возврат ВыбранныйТипДокументаУчета.Метаданные().Синоним;

КонецФункции

&НаКлиенте
Процедура НадписьВалютаНДСНажатие(Элемент, СтандартнаяОбработка)
	
	// Старые значения (до изменения) запомним в кэше в локальных параметрах.
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СуммаВключаетНДС", Объект.СуммаВключаетНДС);
	
	БухгалтерскийУчетКлиент.ПоказатьФормуВыбораТипаЦеныВалютыНДС(ЭтотОбъект, СтандартнаяОбработка,
		Новый ОписаниеОповещения("ПослеЗакрытияВыбораТипаЦеныВалютыНДС", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика
	 ИЛИ (Объект.ВалютаДокумента <> ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета
	 	И НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня) Тогда
		
		ДатаПриИзмененииНаСервере();
		
		БухгалтерскиеОперацииКлиент.ПоказатьОповещениеПриИзмененииКурсаВалюты(
			ЭтотОбъект.КэшПараметров.Служебные.ИзмениласьДатаДляКонтроляКурса,
			ЭтотОбъект.КэшПараметров.Служебные.ИзмениласьВалютаДляКонтроляКурса);
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
	БухгалтерскиеОперацииКлиентСервер.ОбновитьКурсВалютыВФормеДокумента(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)

	Объект = Форма.Объект;
	
	ПараметрыПредставления = Новый Структура("ТипЦены, ВалютаДокумента, СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(ПараметрыПредставления, Объект);
	ПараметрыПредставления.Вставить("ПоказыватьТипЦены", Ложь);
	ПараметрыПредставления.Вставить("ПоказыватьНДС", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьВалюту", Форма.КэшПараметров.ИспользоватьВалютныйУчет);
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПослеЗакрытияВыбораТипаЦеныВалютыНДС(Результат, ДополнительныеПараметры) Экспорт

	Если ЭтотОбъект.КэшПараметров.ВалютаДокумента <> Объект.ВалютаДокумента Тогда
		БухгалтерскиеОперацииКлиентСервер.ОбновитьКурсВалютыВФормеДокумента(ЭтотОбъект, Объект);
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.Локальные.СуммаВключаетНДС <> Объект.СуммаВключаетНДС Тогда
		Для каждого ТекСтрока Из Объект.СписокНоменклатуры Цикл
			
			РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Всего");
			
		КонецЦикла;
	КонецЕсли;
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
КонецПроцедуры

/////////////////////////////////////////////////////////////
&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДО(Форма, ВидимостьЭлементовЭДО = Истина, ВидимостьДанныхМаркировки = Ложь, ВидимостьЭлементовЭДОДляГосНужд = Истина)
	Объект = Форма.Объект;
	
	ИмяОбъектаМетаданных = Объект.Ссылка.Метаданные().ПолноеИмя();
	МодульМенеджера = Новый (СтрЗаменить(ИмяОбъектаМетаданных, ".", "Менеджер."));
	
	ВидимостьРеквизитовПолучателя = ?(ЗначениеЗаполнено(Объект.Извещение), Истина, Ложь);
	АктПриемкиСтроительныхРабот = ?(Объект.ТипФорматаЭД = 6, Истина, Ложь);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"Отправитель", "Видимость", ВидимостьРеквизитовПолучателя);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"Грузополучатель", "Видимость", НЕ ВидимостьРеквизитовПолучателя);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаСостояниеЭДО", "Видимость", ВидимостьЭлементовЭДО И НЕ ВидимостьРеквизитовПолучателя);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СчетФактура", "Видимость", НЕ ВидимостьРеквизитовПолучателя);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаЗакупкаДляГосударственныхНужд", "Видимость", ВидимостьЭлементовЭДО И ВидимостьЭлементовЭДОДляГосНужд);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаКодыМаркировки", "Видимость", ВидимостьДанныхМаркировки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаПринялТовары", "Видимость", НЕ Объект.ЗагруженИзЕИС);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаДатаОтгрузки", "Видимость", Объект.ТипФорматаЭД = 0);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СписокНоменклатурыИдентификаторНоменклатурыЕИС", 
		"Видимость", Объект.ЗагруженИзЕИС);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СписокНоменклатурыВнешнийИдентификаторЕИС", 
		"Видимость", Объект.ЗагруженИзЕИС);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СписокНоменклатурыТехническийИдентификаторЕИС", 
		"Видимость", Объект.ЗагруженИзЕИС);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СостояниеЭТрН", "Видимость", Форма.МожноОформитьЭПД);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаСведенияЭДП", "Видимость", Форма.МожноОформитьЭПД);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаАктПриемкиСтроительныхРабот", "Видимость", АктПриемкиСтроительныхРабот);
	
	Если АктПриемкиСтроительныхРабот Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"Грузополучатель", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаПринялТовары", "Видимость", Ложь);
		Если Объект.ЗагруженИзЕИС Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
				"ГруппаИнформацияЗаказчикаСтроительства", "Видимость", Ложь);
		КонецЕсли;	
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаИнформацияЗаказчикаСтроительства", "Видимость", Ложь);
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГосударственныйКонтрактЕИС", "Видимость", Объект.ЗагруженИзСведенийОГосКонтрактеЕИС);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ЗагруженИзСведенийОГосКонтрактеЕИС", "Видимость", Объект.ЗагруженИзСведенийОГосКонтрактеЕИС);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ЗаполнитьДатуОтгрузкиПоУПД", "Видимость",НЕ ЗначениеЗаполнено(Объект.ДатаОтгрузки)
		  И ЗначениеЗаполнено(МодульМенеджера.ДатаОтгрузкиДокументаПоУПД(Объект.Ссылка)));
	
КонецПроцедуры	

