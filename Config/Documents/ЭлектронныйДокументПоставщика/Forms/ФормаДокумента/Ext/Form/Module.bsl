&НаСервере
Функция СчетФактураДокументаПоставщика(ЭДПоставщика)
	Результат = Документы.СчетФактураПолученный.ПустаяСсылка();
	
	Если ЭДПоставщика.Ссылка = Документы.ЭлектронныйДокументПоставщика.ПустаяСсылка() Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетФактураПолученный.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
	|ГДЕ
	|	СчетФактураПолученный.ЭДПоставщика = &ЭДПоставщика";
	
	Запрос.УстановитьПараметр("ЭДПоставщика", ЭДПоставщика.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуру() 
	СчетФактура = СчетФактураДокументаПоставщика(Объект);
	
	Если ЗначениеЗаполнено(СчетФактура) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "НомерПервичногоДокумента,ДатаПервичногоДокумента");
		Номер	= ЗначенияРеквизитов["НомерПервичногоДокумента"];
		Дата	= ЗначенияРеквизитов["ДатаПервичногоДокумента"];
		
		ТекстНомер	= ?(НЕ ПустаяСтрока(Номер), Номер, "...");
		ТекстДата	= ?(ЗначениеЗаполнено(Дата), Формат(Дата, "ДЛФ=D"), "...");
		ТекстНадписи = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='№ %1 от %2 г.'"),
			ТекстНомер,
			ТекстДата);
	Иначе
		ТекстНадписи = "";	
	КонецЕсли;	
	
	ЭтаФорма.НадписьСчетФактура = ТекстНадписи;	
	
КонецПРоцедуры

&НаСервере
Функция ТекстОтраженияВУчете()
	Результат = "";
	
	Если ЭтоТрехсторонняяПередача() ИЛИ НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Результат = "";
		Возврат Результат;
	КонецЕсли;	
	
	ДокументыОтражения = ЭлектронныеДокументыБГУВызовСервера.ДокументыОтраженияДляЭДП(Объект.Ссылка);
	СуммаОтраженияВучете = ДокументыОтражения.Итог("Сумма");
	
	Если Объект.СуммаДокумента = СуммаОтраженияВучете Тогда
		Результат = НСтр("ru = 'Отражено в учёте на сумму: '") + Формат(СуммаОтраженияВучете, "ЧЦ=17; ЧДЦ=2") +" "+ Строка(Объект.ВалютаДокумента);
	Иначе
		Результат = НСтр("ru = 'Не отражено в учёте на сумму: '") + Формат(Объект.СуммаДокумента - СуммаОтраженияВучете, "ЧЦ=17; ЧДЦ=2") +" "+ Строка(Объект.ВалютаДокумента);
	КонецЕсли;
	
	Если ЭтоТрехсторонняяПередача() ИЛИ Объект.НеОтражаетсяВУчете Тогда
		Результат = "";
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Функция ДанныеНоменклатурыОрганизации()
	Результат = Новый Структура;
	
	РезультатВиды = Новый Массив;
	РезультатЕдиницыИзмерения = Новый Массив;
	РезультатТребуетсяНастройкаПересчетаКоличества = Новый Массив;
	
	Для каждого ТекСтрока Из Объект.СписокНоменклатуры Цикл
		РезультатВиды.Добавить(ЭлектронныеДокументыБГУВызовСервера.ВидНоменклатурыОрганизации(ТекСтрока.Номенклатура));
		
		ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
		Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			Если ТипЗнч(ТекСтрока.Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
				ЕдиницаИзмерения = ЭлектронныеДокументыБГУ.Штуки();
			Иначе	
				ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.Номенклатура, "ЕдиницаИзмерения");
				ЕдиницаИзмерения = ЗначенияРеквизитов.ЕдиницаИзмерения;
			КонецЕсли;
		КонецЕсли;
		РезультатЕдиницыИзмерения.Добавить(ЕдиницаИзмерения);
		
		ТребуетсяНастройкаПересчетаКоличества = Ложь;
		КоличествоЗнаковПослеЗапятой = ЭлектронныеДокументыБГУВызовСервера.ЧислоЗнаковПослеЗапятой(ТекСтрока.Количество);
		Если КоличествоЗнаковПослеЗапятой > 3 Тогда
			ТребуетсяНастройкаПересчетаКоличества = Истина;
		Иначе
			Если ЗначениеЗаполнено(ЕдиницаИзмерения) И ЗначениеЗаполнено(ТекСтрока.ЕдиницаИзмерения) Тогда
				Если ЕдиницаИзмерения = ТекСтрока.ЕдиницаИзмерения Тогда
					ТребуетсяНастройкаПересчетаКоличества = Ложь;
				Иначе	
					ТребуетсяНастройкаПересчетаКоличества = Истина;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
		РезультатТребуетсяНастройкаПересчетаКоличества.Добавить(ТребуетсяНастройкаПересчетаКоличества);
		
	КонецЦикла;
	
	Результат.Вставить("ВидыНоменклатурыОрганизации", РезультатВиды);
	Результат.Вставить("ЕдиницыИзмеренияНоменклатуры", РезультатЕдиницыИзмерения);
	Результат.Вставить("ТребуетсяНастройкаПересчетаКоличества", РезультатТребуетсяНастройкаПересчетаКоличества);
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ДанныеНоменклатурыОрганизацииСтроки(Номенклатура)
	Результат = Новый Структура;
	ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
	ВидНоменклатуры = НСтр("ru=''");

	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			ЕдиницаИзмерения = ЭлектронныеДокументыБГУ.Штуки();
		Иначе	
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "ЕдиницаИзмерения");
			ЕдиницаИзмерения = ЗначенияРеквизитов.ЕдиницаИзмерения;
		КонецЕсли;
		ВидНоменклатуры = ЭлектронныеДокументыБГУВызовСервера.ВидНоменклатурыОрганизации(Номенклатура);
	КонецЕсли;
	
	Результат.Вставить("Вид", ВидНоменклатуры);
	Результат.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения);
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление() Экспорт

	НастройкиУсловногоОформления = Новый Структура();

	УсловноеОформление.Элементы.Очистить();

	ОбновитьУсловноеОформление(ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьУсловноеОформление(Форма)

	НадоИнициализировать = Ложь;

	Если НЕ Форма.НастройкиУсловногоОформления.Свойство("ОбщееПроинициализировано") Тогда
		НадоИнициализировать = Истина;
	КонецЕсли;
	
	Если НадоИнициализировать Тогда
		Форма.УстановитьУсловноеОформлениеДокумента();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеДокумента() Экспорт

	Если НЕ НастройкиУсловногоОформления.Свойство("ОбщееПроинициализировано") Тогда
		УстановитьУсловноеОформлениеОбщее();
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеОбщее()

	НастройкиУсловногоОформления.Вставить("ОбщееПроинициализировано", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НадписьОтражениеВУчете");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"НадписьОтражениеВУчете", ВидСравненияКомпоновкиДанных.НачинаетсяС, "Отражено в учёте");
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ДосьеХорошаяОценкаЦвет);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НадписьОтражениеВУчете");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"НадписьОтражениеВУчете", ВидСравненияКомпоновкиДанных.НачинаетсяС, "Не отражено в учёте");
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СписокНоменклатурыЕдиницаИзмерения");
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СписокНоменклатурыЕдиницаИзмеренияНоменклатуры");
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СписокНоменклатурыКоличество");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.СписокНоменклатуры.ТребуетсяНастройкаПересчетаКоличества", ВидСравненияКомпоновкиДанных.Равно, Истина);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	
	Если Объект.СведенияПрослеживаемости.Количество() = 0 Тогда
		// Признак прослеживаемости
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СписокНоменклатурыПрослеживаемыйТовар");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			"ВедетсяУчетПрослеживаемыхТоваров", ВидСравненияКомпоновкиДанных.Равно, Ложь);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
		
		// Таможенная декларация или РНПТ
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СписокНоменклатурыПодсказкаРНПТ");
		
		ГруппаОтбора = КомпоновкаДанныхКлиентСервер.ДобавитьГруппуОтбора(
			ЭлементУО.Отбор.Элементы, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);

		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора,
			"ВедетсяУчетПрослеживаемыхТоваров", ВидСравненияКомпоновкиДанных.Равно, Ложь);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора,
			"ПоставщикРезидентТаможенногоСоюза", ВидСравненияКомпоновкиДанных.Равно, Истина);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СписокНоменклатурыРНПТ");
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			"Объект.СписокНоменклатуры.СтранаПроисхождения", ВидСравненияКомпоновкиДанных.НеЗаполнено, "");
		
		ГруппаОтбора = КомпоновкаДанныхКлиентСервер.ДобавитьГруппуОтбора(
			ЭлементУО.Отбор.Элементы, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
			
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора,
			"Объект.СписокНоменклатуры.ПрослеживаемыйТовар", ВидСравненияКомпоновкиДанных.Равно, Ложь);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора,
			"ПоставщикРезидентТаможенногоСоюза", ВидСравненияКомпоновкиДанных.Равно, Истина);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='<Не требуется>'"));
		
		// Страна происхождения
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СписокНоменклатурыСтранаПроисхождения");
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			"Объект.СписокНоменклатуры.ПрослеживаемыйТовар", ВидСравненияКомпоновкиДанных.Равно, Истина);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			"ПоставщикРезидентТаможенногоСоюза", ВидСравненияКомпоновкиДанных.Равно, Ложь);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			"Объект.СписокНоменклатуры.СтранаПроисхождения", ВидСравненияКомпоновкиДанных.НеЗаполнено);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	КонецЕсли;
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДанныеОКоличествеМаркированныхТоваровМаркируемыйТовар");
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДанныеОКоличествеМаркированныхТоваровКоличествоПоДокументу");
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДанныеОКоличествеМаркированныхТоваровКоличествоПоСведениямОМаркировке");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ДанныеОКоличествеМаркированныхТоваров.КоличествоПоДокументу", ВидСравненияКомпоновкиДанных.НеРавно, Новый ПолеКомпоновкиДанных("ДанныеОКоличествеМаркированныхТоваров.КоличествоПоСведениямОМаркировке"));
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	
КонецПроцедуры

#Область ЭДОСКонтрагентами

&НаСервере
Функция ЭтоТрехсторонняяПередача()
	Результат = Ложь;
	Если ЗначениеЗаполнено(Объект.Грузополучатель) Тогда
		Результат = Истина;
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Грузополучатель, "ИНН, КПП");
		ИННГрузополучателя = ЗначенияРеквизитов.ИНН;
		КППГрузополучателя = ЗначенияРеквизитов.КПП;
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Организация, "ИНН, КПП");
		ИННОрганизации = ЗначенияРеквизитов.ИНН;
		КППОрганизации = ЗначенияРеквизитов.КПП;

		Если (ИННГрузополучателя = ИННОрганизации) И (КППГрузополучателя = КППОрганизации) Тогда
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ПриИзмененииКлючевыхРеквизитовСостояниеЭДО()
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ПараметрыПриИзменении = ОбменСКонтрагентами.ПараметрыПриИзмененииКлючевыхРеквизитовЭДО();
	
	ПараметрыПриИзменении.Форма                 = ЭтотОбъект;
	ПараметрыПриИзменении.ДокументСсылка        = Объект.Ссылка;
	ПараметрыПриИзменении.ДокументОбъект        = РеквизитФормыВЗначение("Объект");
	ПараметрыПриИзменении.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПриИзменении.ГруппаСостояниеЭДО    = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриИзмененииКлючевыхРеквизитовЭДО(ПараметрыПриИзменении);
	
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ВидимостьЭлементовЭДО = ЭлектронныеДокументыБГУ.ВидимостьЭлементовЭДО(Объект.Контрагент, Объект.Организация);
	ВидимостьЭлементовЭДОДляГосНужд = НЕ ЭлектронныеДокументыБГУ.НеЗаполнятьСведенияУПДОЗакупкеДляГосНужд(Объект.Организация);
	Если НЕ ВидимостьЭлементовЭДО Тогда
		ВидимостьЭлементовЭДОДляГосНужд = Ложь;
	КонецЕсли;	
	
	УстановитьВидимостьЭлементовЭДО(ЭтаФорма, ВидимостьЭлементовЭДО, , ВидимостьЭлементовЭДОДляГосНужд);
	
	Если ВидимостьЭлементовЭДОДляГосНужд Тогда
		ЗаполнитьСведенияГосЗакупкиПоДоговору(Объект.Договор, Объект.Дата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТипОтветственныйПринялТовары()
	Если Объект.ОтветственныйПринялТоварыВид = 0 Тогда
		ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка.Сотрудники");
		Элементы.ОтветственныйПринялТовары.ОграничениеТипа = ОписаниеТипа;
	Иначе	
		ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица");
		Элементы.ОтветственныйПринялТовары.ОграничениеТипа = ОписаниеТипа;
	КонецЕсли;
	
	УстановитьВидимостьЭлементовОтветственныйЗаТовары(ЭтаФорма);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовОтветственныйЗаТовары(Форма)
	Объект = Форма.Объект;
	
	ВидимостьОтветственныйСотрудник = ?(Объект.ОтветственныйПринялТоварыВид = 0, Истина, Ложь);
	ВидимостьОтветственныйПредставительКонтрагента = ?(Объект.ОтветственныйПринялТоварыВид = 1, Истина, Ложь);
	ВидимостьОтветственныйФизЛицо = ?(Объект.ОтветственныйПринялТоварыВид = 2, Истина, Ложь);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаИное", "Видимость", Объект.ТоварыПриняты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаОтветственныйОрганизация", "Видимость", Объект.ТоварыПриняты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаЛицоИОснование", "Видимость", Объект.ТоварыПриняты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаОтветственныйОрганизация", "Видимость", Объект.ТоварыПриняты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаИное", "Видимость", Объект.ТоварыПриняты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ВидОтветственногоПринявшегоТовары", "Видимость", Объект.ТоварыПриняты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДатаПолученияТоваров", "Видимость", Объект.ТоварыПриняты);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаОтветственныйОрганизация", "Видимость", ВидимостьОтветственныйПредставительКонтрагента);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОтветственныйПринялТоварыДоверенность", "Видимость", НЕ ВидимостьОтветственныйСотрудник);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОтветственныйПринялТоварыОснованиеПолномочий", "Видимость", НЕ ВидимостьОтветственныйФизЛицо);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаРезультатПриемки", "Видимость", Объект.ТоварыПриняты);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияПоУмолчаниюОтветственныйЗаТовары();
	Если НЕ ЗначениеЗаполнено(Объект.ОтветственныйПринялТоварыОснованиеПолномочий) Тогда
		Объект.ОтветственныйПринялТоварыОснованиеПолномочий = НСтр("ru = 'Должностные обязанности'");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДатуОтгрузкиПоУПДНаСервере()
	ДатаОтгрузки = Документы.ЭлектронныйДокументПоставщика.ДатаОтгрузкиДокументаПоУПД(Объект.Ссылка);
	Объект.ДатаОтгрузки = ДатаОтгрузки;
КонецПроцедуры

#КонецОбласти

#Область НоменклатураПоставщика

&НаСервере
Процедура ЗаполнитьНаименованиеТоваровПоставщика()
	
	Если Не ЗначениеЗаполнено(Объект.СписокНоменклатуры) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		РазличающаясяНоменклатураКонтрагентаИОрганизации = ЭлектронныеДокументыБГУ.РазличающаясяНоменклатураКонтрагентаИОрганизации(Объект.Ссылка);
	
		ДанныеОСравненииНоменклатуры.Загрузить(РазличающаясяНоменклатураКонтрагентаИОрганизации);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Извещение) Тогда
		ЭлектронныеДокументыБГУ.ЗаполнитьПредставлениеНоменклатурыКонтрагентовВИсточнике(
			Объект, "Отправитель", "СписокНоменклатуры", "ИдентификаторПоставщика", "НаименованиеПоставщика");
	Иначе	
		ЭлектронныеДокументыБГУ.ЗаполнитьПредставлениеНоменклатурыКонтрагентовВИсточнике(
			Объект, "Контрагент", "СписокНоменклатуры", "ИдентификаторПоставщика", "НаименованиеПоставщика");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПризнакНоменклатуры(Команда)
	ПризнакиНоменклатуры = Новый СписокЗначений;
	ПризнакиНоменклатуры.Добавить("1", НСтр("ru = '1 - имущество'"));
	ПризнакиНоменклатуры.Добавить("1ВТ", НСтр("ru = '1 - возвратная тара'"));
	ПризнакиНоменклатуры.Добавить("2", НСтр("ru = '2 - работа'"));
	ПризнакиНоменклатуры.Добавить("3", НСтр("ru = '3 - услуга'"));
	ПризнакиНоменклатуры.Добавить("4", НСтр("ru = '4 - имущественные права'"));
	ПризнакиНоменклатуры.Добавить("5", НСтр("ru = '5 - иное'"));
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначенияПризнакаНоменклатуры", ЭтаФорма);
	ПризнакиНоменклатуры.ПоказатьВыборЭлемента(Оповещение, "Выберите признак номенклатуры");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЗначенияПризнакаНоменклатуры(ВыбранныйЭлемент, СписокПараметров) Экспорт
    Если ВыбранныйЭлемент = Неопределено Тогда
        Сообщить(НСтр("ru='Признак номенклатуры не выбран.'"));
    Иначе
        ВыбранноеЗначение = ВыбранныйЭлемент.Значение;
		
		МассивСтрок = Элементы.СписокНоменклатуры.ВыделенныеСтроки;
		Для Каждого ЭлМас Из МассивСтрок Цикл
			ТекСтр = Объект.СписокНоменклатуры.НайтиПоИдентификатору(ЭлМас);
			Если ТекСтр <> Неопределено Тогда
				ТекСтр.ПризнакНоменклатуры = ВыбранноеЗначение;
				
				ОбновитьТекстЗаголовковВСтрокеТаблицыСписокНоменклатуры(ТекСтр);
			КонецЕсли;
		КонецЦикла;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзвещениеПриИзмененииНаСервере()
	ВидимостьЭлементовЭДО = ЭлектронныеДокументыБГУ.ВидимостьЭлементовЭДО(Объект.Контрагент, Объект.Организация);
	
	УстановитьВидимостьЭлементовЭДО(ЭтаФорма, ВидимостьЭлементовЭДО);
КонецПроцедуры

&НаКлиенте
Процедура ИзвещениеПриИзменении(Элемент)
	ИзвещениеПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ГосЗакупки

&НаСервере
Процедура ЗаполнитьСведенияГосЗакупкиПоДоговору(ДоговорКонтрагента, ДатаСведений)
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		НаименованиеИКЗ =  ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ИКЗ.Наименование;
		КодЗакупки = РаботаСОбязательствами.ЗначениеХарактеристикиОбязательства(ДоговорКонтрагента, КонецДня(ДатаСведений), НаименованиеИКЗ);
		
		НомерБюджетногоОбязательстваПокупателя = РаботаСОбязательствами.ПолучитьУчетныйНомерОбязательства(ДоговорКонтрагента);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияГосЗакупкиПоОрганизации(ОрганизацияПокупатель)
	
	Если ЗначениеЗаполнено(ОрганизацияПокупатель) Тогда
		СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОрганизацияПокупатель, "Бюджет, КодОКТМО, КодПоРПБС");
		НомерРеестровойЗаписиПокупателя = СтруктураДанных.КодПоРПБС;
		КодОКТМО = СтруктураДанных.КодОКТМО;
		Бюджет = СтруктураДанных.Бюджет;
		
		СтруктураДанныхБюджет = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Бюджет, "НаименованиеФинансовогоОргана");
		НаименованиеФинансовогоОрганаПокупателя = СтруктураДанныхБюджет.НаименованиеФинансовогоОргана;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияГосЗакупкиПоРеквизитамЛС(РеквизитыЛицевогоСчета)
	
	Если ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
		СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыЛицевогоСчета, "КассовыйОрган, Владелец");
		Казначейство = СтруктураДанных.КассовыйОрган;
		СтруктураДанныхКазначейства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Казначейство, "НаименованиеПолное, Код");
		ЛицевойСчет = СтруктураДанных.Владелец;
		СтруктураДанныхЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛицевойСчет, "КодПоРПБС, Код, ИспользоватьДляСчетаУчетныйНомер");
		НомерЛицевогоСчетаПокупателя = СтруктураДанныхЛицевогоСчета.Код;
		КодПоРПБСЛицевогоСчета = СтруктураДанныхЛицевогоСчета.КодПоРПБС;
		ИспользоватьДляСчетаУчетныйНомер = СтруктураДанныхЛицевогоСчета.ИспользоватьДляСчетаУчетныйНомер;
		Если ИспользоватьДляСчетаУчетныйНомер И ЗначениеЗаполнено(КодПоРПБСЛицевогоСчета) Тогда
			НомерРеестровойЗаписиПокупателя = КодПоРПБСЛицевогоСчета;
		КонецЕсли;	
		
		КазначействоПокупателяКод = СтруктураДанныхКазначейства.Код;
		КазначействоПокупателяНаименование = СтруктураДанныхКазначейства.НаименованиеПолное;
	КонецЕсли;
	
КонецПроцедуры

