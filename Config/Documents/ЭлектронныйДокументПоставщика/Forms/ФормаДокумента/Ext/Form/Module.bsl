#Область Маркировка

&НаСервере
Функция КоличествоПоКодуМаркировкиОСУ(ДанныеМаркировки)
	Результат = 0;

	КоличествоСтр = "";
	Если Сред(ДанныеМаркировки, 17, 2) = "37" Тогда
		КоличествоСтр = Сред(ДанныеМаркировки, 19);
	ИначеЕсли Сред(ДанныеМаркировки, 16, 2) = "37" Тогда
		КоличествоСтр = Сред(ДанныеМаркировки, 18);
	ИначеЕсли Сред(ДанныеМаркировки, 15, 2) = "37" Тогда
		КоличествоСтр = Сред(ДанныеМаркировки, 17);
	ИначеЕсли Сред(ДанныеМаркировки, 11, 2) = "37" Тогда
		КоличествоСтр = Сред(ДанныеМаркировки, 13);
	КонецЕсли;	
		
	Если ЗначениеЗаполнено(КоличествоСтр) Тогда
		Если СтрДлина(КоличествоСтр) < 15 Тогда
			Результат = Число(КоличествоСтр);
		КонецЕсли;
	КонецЕсли;	

	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ПроверитьСведенияОМаркировке()

	ЕстьЗамечанияПоСведениямОМаркировке = Ложь;

	ТоварыИзМаркировки = Новый Массив;
	ДанныеОКоличествеМаркированныхТоваров.Очистить();
	
	Для Каждого ТекСтрока Из Объект.КодыУпаковокМаркируемойПродукции Цикл
		КоличествоМаркированныхТоваров = 0;
		ДанныеМаркировки = СокрЛП(ТекСтрока.НомерУпаковки);
		Если ЗначениеЗаполнено(ДанныеМаркировки) Тогда
			Если Сред(ДанныеМаркировки, 1, 2) = "02" Тогда
				КоличествоМаркированныхТоваров = КоличествоПоКодуМаркировкиОСУ(ДанныеМаркировки);
			Иначе
				КоличествоМаркированныхТоваров = 1;
			КонецЕсли;	
		КонецЕсли;
		Если КоличествоМаркированныхТоваров > 0 Тогда
			ТоварыИзМаркировки.Добавить(ТекСтрока.МаркируемыйТовар);
			НоваяСтрока = ДанныеОКоличествеМаркированныхТоваров.Добавить();
			НоваяСтрока.МаркируемыйТовар = ТекСтрока.МаркируемыйТовар;
			НоваяСтрока.КоличествоПоСведениямОМаркировке = КоличествоМаркированныхТоваров;
		КонецЕсли;	
	КонецЦикла;	

	Для Каждого ТекСтрока Из Объект.СписокНоменклатуры Цикл
		Если НЕ ТоварыИзМаркировки.Найти(ТекСтрока.Номенклатура) = Неопределено Тогда
			НоваяСтрока = ДанныеОКоличествеМаркированныхТоваров.Добавить();
			НоваяСтрока.МаркируемыйТовар = ТекСтрока.Номенклатура;
			НоваяСтрока.КоличествоПоДокументу = ТекСтрока.Количество;
		КонецЕсли;	
	КонецЦикла;
	
	ДанныеОКоличестве = ДанныеОКоличествеМаркированныхТоваров.Выгрузить();
	ДанныеОКоличестве.Свернуть("МаркируемыйТовар", "КоличествоПоДокументу, КоличествоПоСведениямОМаркировке");
	ДанныеОКоличествеМаркированныхТоваров.Загрузить(ДанныеОКоличестве);

	Для Каждого ТекСтрока Из ДанныеОКоличествеМаркированныхТоваров Цикл
		Если ТекСтрока.КоличествоПоДокументу <> ТекСтрока.КоличествоПоСведениямОМаркировке Тогда
			ЕстьЗамечанияПоСведениямОМаркировке = Истина;
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаСведенияОМаркировке(Форма)
	
	Объект = Форма.Объект;
	
	Если Форма.ЕстьЗамечанияПоСведениямОМаркировке Тогда
		Форма.ДанныеЗаголовкаСведенияОМаркировке = НСтр("ru='есть расхождения!'");
		Форма.ДанныеЗаголовкаСведенияОМаркировке = НСтр("ru='есть расхождения!'");
		Форма.Элементы.ГруппаКодыМаркировки.Картинка = БиблиотекаКартинок.КрасныйВосклицательныйЗнак;
	Иначе
		Форма.ДанныеЗаголовкаСведенияОМаркировке = НСтр("ru=''");
		Форма.Элементы.ГруппаКодыМаркировки.Картинка = Новый Картинка;
	КонецЕсли;	
	
КонецПроцедуры

