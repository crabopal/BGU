&НаКлиенте
Перем ПеренестиВДокумент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
	КонецЕсли;
	
	Если Параметры.Свойство("Ссылка") Тогда
		ЭДПоставщика = Параметры.Ссылка;
	КонецЕсли;
	Если Параметры.Свойство("ТипДокумента") Тогда
		ТипДокументаДляОтраженияВУчете = Параметры.ТипДокумента;
	КонецЕсли;
	Если Параметры.Свойство("СуммаВключаетНДС") Тогда
		СуммаВключаетНДС = Параметры.СуммаВключаетНДС;
	Иначе
		СуммаВключаетНДС = Ложь;
	КонецЕсли;
	
	ЗаполнитьСписокДоступнойНоменклатуры(ТипДокументаДляОтраженияВУчете, ЭДПоставщика);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Если ПеренестиВДокумент = Истина Тогда
		
		ИмяДокумента = ИмяДокументаУчета(ТипДокументаДляОтраженияВУчете);
		
		ДанныеЭДП = ДанныеДокументаУчетаИзЭДП(ЭДПоставщика);
		ДатаСведений = ДанныеЭДП.ДатаСведений;
		
		ДанныеДляОтраженияВУчета = Новый Структура;
		ДанныеДляОтраженияВУчета.Вставить("Организация", Организация);
		ДанныеДляОтраженияВУчета.Вставить("Основание", ЭДПоставщика);
		ДанныеДляОтраженияВУчета.Вставить("ДокументОснование", ЭДПоставщика);
		ДанныеДляОтраженияВУчета.Вставить("Извещение", ДанныеЭДП.Извещение);
		ДанныеДляОтраженияВУчета.Вставить("Контрагент", ДанныеЭДП.Контрагент);
		ДанныеДляОтраженияВУчета.Вставить("Договор", ДанныеЭДП.Договор);
		ДанныеДляОтраженияВУчета.Вставить("ВидПервичногоДокумента", ДанныеЭДП.ВидПервичногоДокумента);
		ДанныеДляОтраженияВУчета.Вставить("ДатаПервичногоДокумента", ДанныеЭДП.ДатаПервичногоДокумента);
		ДанныеДляОтраженияВУчета.Вставить("НомерПервичногоДокумента", ДанныеЭДП.НомерПервичногоДокумента);
		ДанныеДляОтраженияВУчета.Вставить("Дата", ДатаСведений);
		ДанныеДляОтраженияВУчета.Вставить("НоменклатураДляОтраженияВУчете", НоменклатураДляОтраженияВУчете);
		
		Основание = Новый Структура;
		Если (ТипДокументаДляОтраженияВУчете = ПредопределенноеЗначение("Перечисление.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПринятиеКУчетуОбъектовОС")) Тогда
			ДанныеДляОтраженияВУчета.Вставить("ВидПоступления", ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс"));
		ИначеЕсли (ТипДокументаДляОтраженияВУчете = ПредопределенноеЗначение("Перечисление.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПринятиеКУчетуОбъектовИК")) Тогда
			ДанныеДляОтраженияВУчета.Вставить("ВидПоступления", ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Поступление"));
		ИначеЕсли (ТипДокументаДляОтраженияВУчете = ПредопределенноеЗначение("Перечисление.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПриходныйОрдерФондовый")) Тогда
			ТекущиеДанные = Элементы.НоменклатураДляОтраженияВУчете.ТекущиеДанные;
			Счет20135 = БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("201.35", ДатаСведений);
			ДанныеДляОтраженияВУчета.Вставить("Счет", Счет20135);
			Если ТекущиеДанные <> Неопределено Тогда
				ДанныеДляОтраженияВУчета.Вставить("КорСчет", ТекущиеДанные.СчетУчетаРасчетов);
			КонецЕсли;	
		КонецЕсли;	
		Основание.Вставить("ЗначенияЗаполнения", ДанныеДляОтраженияВУчета);
	
		ОткрытьФорму("Документ." + ИмяДокумента + ".ФормаОбъекта", Основание);
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ДанныеДокументаУчетаИзЭДП(ЭДП)
	
	СтруктураРезультат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭДП,
		"Извещение, Контрагент, Договор, ВидПервичногоДокумента, ДатаПервичногоДокумента, НомерПервичногоДокумента");

	Результат = Новый Структура;
	Результат.Вставить("ДатаСведений", ЭлектронныеДокументыБГУ.ДатаВходящегоИзвещенияЭДП(ЭДП));
	Результат.Вставить("Извещение", СтруктураРезультат.Извещение);
	Результат.Вставить("Контрагент", СтруктураРезультат.Контрагент);
	Результат.Вставить("Договор", СтруктураРезультат.Договор);
	Результат.Вставить("ВидПервичногоДокумента", СтруктураРезультат.ВидПервичногоДокумента);
	Результат.Вставить("ДатаПервичногоДокумента", СтруктураРезультат.ДатаПервичногоДокумента);
	Результат.Вставить("НомерПервичногоДокумента", СтруктураРезультат.НомерПервичногоДокумента);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ИмяДокументаУчета(ВыбранныйТипДокументаУчета)
	
	ИмяПеречисления = ВыбранныйТипДокументаУчета.Метаданные().Имя;
	ИндексЗначенияПеречисления = Перечисления[ИмяПеречисления].Индекс(ВыбранныйТипДокументаУчета);
	ИмяЗначенияПеречисления = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[ИндексЗначенияПеречисления].Имя;

	Возврат ИмяЗначенияПеречисления;

КонецФункции

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПеренестиВДокумент <> Истина И Модифицированность Тогда
	
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), НСтр("ru = 'Список номенклатуры не перенесен в документ.
			|
			|Перенести?'"), РежимДиалогаВопрос.ДаНетОтмена);
			
		Отказ = Истина;
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьВДокумент(Команда)
	
	ПеренестиВДокумент = Истина;
	Закрыть(КодВозвратаДиалога.OK);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыСписокНоменклатуры

&НаКлиенте
Процедура НоменклатураДляОтраженияВУчетеКоличествоПриИзменении(Элемент)
	
	РассчитатьСтроку(Элементы.НоменклатураДляОтраженияВУчете.ТекущиеДанные, СуммаВключаетНДС, "Количество");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписокДоступнойНоменклатуры(ТипДокументаУчета, ДокументОснование)
	
	СписокНоменклатуры = ЭлектронныеДокументыБГУВызовСервера.СписокДоступнойНоменклатурыЭДПоставщика(ТипДокументаУчета, ДокументОснование);
	
	НоменклатураДляОтраженияВУчете.Загрузить(СписокНоменклатуры);
	
	ДатаСведений = ТекущаяДатаСеанса();
	Для Каждого ТекСтрока Из НоменклатураДляОтраженияВУчете Цикл
		Если ТипЗнч(ТекСтрока.Номенклатура) = Тип("СправочникСсылка.ДенежныеДокументы") Тогда
			СтруктураРезультат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.Номенклатура, "Владелец");
			
			ВидДенежногоДокумента = СтруктураРезультат.Владелец;
			ТекСтрока.ВидДенежногоДокумента = ВидДенежногоДокумента;
			Если ЗначениеЗаполнено(ЭДПоставщика.Извещение) Тогда
				ТекСтрока.СчетУчетаРасчетов = БухгалтерскийУчетПовтИсп.СчетПоКоду("304.04", ДатаСведений);
			Иначе	
				Если ВидДенежногоДокумента = Справочники.ВидыДенежныхДокументов.ПочтовыеМарки Тогда
					ТекСтрока.СчетУчетаРасчетов = БухгалтерскийУчетПовтИсп.СчетПоКоду("302.21", ДатаСведений);
				ИначеЕсли ВидДенежногоДокумента = Справочники.ВидыДенежныхДокументов.ТалоныНаБензин
					ИЛИ ВидДенежногоДокумента = Справочники.ВидыДенежныхДокументов.ТалоныНаМасла Тогда
					ТекСтрока.СчетУчетаРасчетов = БухгалтерскийУчетПовтИсп.СчетПоКоду("302.34", ДатаСведений);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	
КонецПроцедуры	

#КонецОбласти
