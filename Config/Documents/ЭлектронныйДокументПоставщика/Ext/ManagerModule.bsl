Процедура ДобавитьДвиженияРасходОстаткиКодовИСМП(ТаблицыДляДвижений, ДокументСсылка)

	Если ОбменИСМПБГУ.ВедетсяКонтрольОстатковКодовИСМП(ДокументСсылка.Организация) Тогда 
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.Ссылка.Дата КАК Период,
		|	ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.Ссылка.Ссылка КАК Регистратор,
		|	ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.Ссылка.Организация КАК Организация,
		|	ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.НомерУпаковки КАК КодИСМП,
		|	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура КАК Номенклатура,
		|	СУММА(1) КАК Количество
		|ПОМЕСТИТЬ ВТКоды
		|ИЗ
		|	Документ.ЭлектронныйДокументПоставщика.КодыУпаковокМаркируемойПродукции КАК ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектронныйДокументПоставщика.СписокНоменклатуры КАК ЭлектронныйДокументПоставщикаСписокНоменклатуры
		|		ПО ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.ИдентификаторСтроки = ЭлектронныйДокументПоставщикаСписокНоменклатуры.ИдентификаторСтроки
		|			И ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.Ссылка = ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка
		|ГДЕ
		|	ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.Ссылка = &ДокументСсылка
		|	И ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.Ссылка.СведенияОВыбытииМаркированныхТоваров <> 1
		|
		|СГРУППИРОВАТЬ ПО
		|	ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.Ссылка.Дата,
		|	ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.Ссылка.Ссылка,
		|	ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.Ссылка.Организация,
		|	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура,
		|	ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.НомерУпаковки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТКоды.Период КАК Период,
		|	ВТКоды.Регистратор КАК Регистратор,
		|	ВТКоды.Организация КАК Организация,
		|	ВТКоды.КодИСМП КАК КодИСМП,
		|	ВТКоды.Номенклатура КАК Номенклатура,
		|	ВТКоды.Количество КАК Количество,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения
		|ИЗ
		|	ВТКоды КАК ВТКоды
		|ГДЕ
		|	ВТКоды.КодИСМП <> """"";
		
		ТаблицаДвиженийОстаткиКодовИСМП = Запрос.Выполнить().Выгрузить();  
		
		Для Каждого СтрокаТаблицы Из ТаблицаДвиженийОстаткиКодовИСМП Цикл 
			ПараметрыСтроки 			= ОбменИСМПБГУКлиентСервер.ПараметрыСтрокиИзКодаИСМП(СтрокаТаблицы.КодИСМП);
			СтрокаТаблицы.Количество 	= ПараметрыСтроки.Количество;
			СтрокаТаблицы.КодИСМП		= ПараметрыСтроки.КодИСМП;
		КонецЦикла;
		
		ТаблицыДляДвижений.Вставить("КодыИСМПБГУ", ТаблицаДвиженийОстаткиКодовИСМП);
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#КонецЕсли
