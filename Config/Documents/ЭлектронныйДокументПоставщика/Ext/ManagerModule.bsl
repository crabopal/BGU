#Область СлужебныеПроцедурыИФункции

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры
//  Ссылка  - ДокументСсылка.ТаксировкаПутевогоЛиста - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ДобавитьДвиженияРасходОстаткиКодовИСМП(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры // ИнициализироватьДанныеДокумента()

#Область ПрограммныйИнтерфейсПодсистемыПечать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЭлектронныйДокументПоставщика";
	КомандаПечати.Идентификатор		= "ПФ_MXL_ЛистСогласованияВходящегоЭД";
	КомандаПечати.Представление		= НСтр("ru = 'Лист согласования входящего электронного документа'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ЛистСогласованияВходящегоЭД") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_ЛистСогласованияВходящегоЭД",
			"Лист согласования входящего электронного документа", ПечатьЛистаСогласованияВходящегоЭД(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать

Функция ДанныеДляЛистаСогласования(МассивОбъектов)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронныйДокументПоставщика.Ссылка КАК Ссылка,
	               |	ЭлектронныйДокументПоставщика.Организация КАК Организация,
	               |	ЭлектронныйДокументПоставщика.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
	               |	ЭлектронныйДокументПоставщика.Договор КАК Договор,
	               |	ЭлектронныйДокументПоставщика.Договор.Представление КАК Основание,
	               |	ЭлектронныйДокументПоставщика.Контрагент КАК Контрагент,
	               |	ЭлектронныйДокументПоставщика.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	               |	ЭлектронныйДокументПоставщика.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	               |	ЭлектронныйДокументПоставщика.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	               |	ЭлектронныйДокументПоставщика.Ответственный КАК Ответственный,
	               |	ЭлектронныйДокументПоставщика.СуммаДокумента КАК СуммаДокумента,
	               |	ЭлектронныйДокументПоставщика.Дата КАК Дата,
	               |	ЭлектронныйДокументПоставщика.Номер КАК Номер,
	               |	ЭлектронныйДокументПоставщика.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель
	               |ИЗ
	               |	Документ.ЭлектронныйДокументПоставщика КАК ЭлектронныйДокументПоставщика
	               |ГДЕ
	               |	ЭлектронныйДокументПоставщика.Ссылка В(&МассивОбъектов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаПервичногоДокумента,
	               |	НомерПервичногоДокумента";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат;
	
КонецФункции	

Функция ПечатьЛистаСогласованияВходящегоЭД(МассивОбъектов, ОбъектыПечати) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ЛистСогласованияВходящегоЭД";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЭлектронныйДокументПоставщика.ПФ_MXL_ЛистСогласованияВходящегоЭД");
	
	ОбластьЗаголовок		= Макет.ПолучитьОбласть("Заголовок");
	ОбластьЗаголовокОтметки	= Макет.ПолучитьОбласть("ЗаголовокОтметок");
	
	ПервыйДокумент = Истина;
	РезультатЗапроса = ДанныеДляЛистаСогласования(МассивОбъектов);
	ВыборкаДокументов = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ВходящийЭД = СтрШаблон("%1 от %2 № %3", ВыборкаДокументов.ВидПервичногоДокумента, 
			Формат(ВыборкаДокументов.ДатаПервичногоДокумента, "ДЛФ=D"), ВыборкаДокументов.НомерПервичногоДокумента);
			
		Сотрудник = ВыборкаДокументов.ОтветственныйИсполнитель;
		ДатаСведений = ВыборкаДокументов.Дата;
		Должность = "";
		ФамилияИнициалы = "";
		ОтветственныйИсполнитель = "";
		Если ЗначениеЗаполнено(Сотрудник) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Должность", Сотрудник, ДатаСведений);	
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
			Должность = ДанныеСотрудника.Должность;
			ФамилияИнициалы = Справочники.Сотрудники.ФамилияИО(Сотрудник, Ложь, ДатаСведений);
			ОтветственныйИсполнитель = СтрШаблон("%1 %2", Должность, ФамилияИнициалы);
		КонецЕсли;
		
		СтруктураОбластьЗаголовок = Новый Структура;
		СтруктураОбластьЗаголовок.Вставить("НаименованиеОрганизации", ВыборкаДокументов.ОрганизацияНаименованиеПолное);
		СтруктураОбластьЗаголовок.Вставить("НомерДокумента", ЭлектронныеДокументыБГУ.НомерДляПечати(ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер));
		СтруктураОбластьЗаголовок.Вставить("ДатаСоставления",Формат(ВыборкаДокументов.Дата, "ДЛФ=D"));
		СтруктураОбластьЗаголовок.Вставить("ВходящийЭД", ВходящийЭД);
		СтруктураОбластьЗаголовок.Вставить("НаименованиеКонтрагента", ВыборкаДокументов.Контрагент);
		СтруктураОбластьЗаголовок.Вставить("НаименованиеОснования", ВыборкаДокументов.Основание);
		СтруктураОбластьЗаголовок.Вставить("ДолжностьОтветственногоИсполнителя", Должность);
		СтруктураОбластьЗаголовок.Вставить("ФИООтветственногоИсполнителя", ФамилияИнициалы);
		СтруктураОбластьЗаголовок.Вставить("ОтветственныйИсполнитель", ОтветственныйИсполнитель);
		
		ОбластьЗаголовок.Параметры.Заполнить(СтруктураОбластьЗаголовок);
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		ТабличныйДокумент.Вывести(ОбластьЗаголовокОтметки);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

