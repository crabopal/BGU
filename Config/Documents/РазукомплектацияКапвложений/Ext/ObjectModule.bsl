#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти
	
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		РаспределитьКапвложения();
	КонецЕсли;	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	ШаблонСообщения  = НСтр("ru = 'В строке %1 таблицы ""Распределение капвложений по объектам"" не заполнена карточка капвложений'");
	ШаблонСообщения1 = НСтр("ru = 'В строке %1 таблицы ""Распределение капвложений по объектам"" не заполнена колонка ""%2""'");
	КолонкаБазы = ?(ВариантРаспределения = 1, "Сумма", "Процент");
	Для каждого СтрокаТЧ из ОбъектыЦелевые Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ[КолонкаБазы]) Тогда
			ТекстСообщения = СтрШаблон(ШаблонСообщения1, СтрокаТЧ.НомерСтроки, КолонкаБазы);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, 
				"ОбъектыЦелевые[" + ОбъектыЦелевые.Индекс(СтрокаТЧ) + "][" + КолонкаБазы + "]", "Объект", Отказ);
		КонецЕсли;	

		Если СтрокаТЧ.ОтразитьВКарточкеКапвложений И НЕ ЗначениеЗаполнено(СтрокаТЧ.КарточкаКапвложений) Тогда
			ТекстСообщения = СтрШаблон(ШаблонСообщения, СтрокаТЧ.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, 
				"ОбъектыЦелевые[" + ОбъектыЦелевые.Индекс(СтрокаТЧ) + "].КарточкаКапвложений", "Объект", Отказ);
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура РаспределитьКапвложения()                    
	КапвложенияЦелевые.Очистить();
	
	ТЧ_Вложения = КапвложенияИсходные.Выгрузить();
	ТЧ_Вложения.Колонки.Добавить("Списано", Новый ОписаниеТипов("Число"));
	ТЧ_Вложения.Колонки.Добавить("СписаноКоличествоВложений", Новый ОписаниеТипов("Число"));
	ТЧ_Объекты  = ОбъектыЦелевые.Выгрузить();
	ТЧ_Объекты.Колонки.Добавить("Сформировано", Новый ОписаниеТипов("Число"));
	
	КапвложенияИсходныеИтого = КапвложенияИсходные.Итог("Сумма");
	Если ВариантРаспределения = 1 Тогда
		ПолеБазы = "Сумма";
		Знаменатель = КапвложенияИсходныеИтого;
	Иначе	
		ПолеБазы = "Процент";
		Знаменатель = 100;     
	КонецЕсли;	
	ЧастичноеСписание = (Знаменатель <> ОбъектыЦелевые.Итог(ПолеБазы));     
	
	Если Знаменатель = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	МаксИндексОбъектов = ТЧ_Объекты.Количество() - 1;
	Для каждого СтрокаОбъекта из ТЧ_Объекты Цикл    
		ЭтоПоследнийОбъект = (ТЧ_Объекты.Индекс(СтрокаОбъекта) = МаксИндексОбъектов);
		КоэффициентОбъекта = СтрокаОбъекта[ПолеБазы] / Знаменатель;
		
		Если ВариантРаспределения = 2 Тогда
			СтрокаОбъекта.Сумма = Окр(КапвложенияИсходныеИтого * КоэффициентОбъекта, 2);
		КонецЕсли;	 
		
		МаксИндексВложений = ТЧ_Вложения.Количество() - 1;
		КоличествоОбъектовПеренесли = Ложь;
		Для каждого СтрокаВложений из ТЧ_Вложения Цикл
			ЭтоПоследнееВложение = (ТЧ_Вложения.Индекс(СтрокаВложений) = МаксИндексВложений);
			НоваяСтрока = КапвложенияЦелевые.Добавить();   
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВложений,, "Сумма");      
			КоличествоВложенийКСписанию = СтрокаВложений.Количество - СтрокаВложений.СписаноКоличествоВложений;
			Если КоличествоВложенийКСписанию > 0 Тогда
				НоваяСтрока.КоличествоВложений = КоличествоВложенийКСписанию;
				СтрокаВложений.СписаноКоличествоВложений = КоличествоВложенийКСписанию;
			КонецЕсли;	
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОбъекта,, "Сумма");
			Если НЕ КоличествоОбъектовПеренесли Тогда
				НоваяСтрока.КоличествоОбъектов = СтрокаОбъекта.Количество;
				КоличествоОбъектовПеренесли = Истина;
			КонецЕсли;	
			НоваяСтрока.ИдентификаторСтрокиКапвложений = СтрокаВложений.ИдентификаторСтроки;
			НоваяСтрока.ИдентификаторСтрокиОбъектов    = СтрокаОбъекта.ИдентификаторСтроки;
			
			Если ЭтоПоследнийОбъект И НЕ ЧастичноеСписание Тогда
				НоваяСтрока.Сумма = СтрокаВложений.Сумма - СтрокаВложений.Списано;
			ИначеЕсли ЭтоПоследнееВложение Тогда	
				НоваяСтрока.Сумма = СтрокаОбъекта.Сумма - СтрокаОбъекта.Сформировано;
				СтрокаВложений.Списано = СтрокаВложений.Списано + НоваяСтрока.Сумма;
				СтрокаОбъекта.Сформировано = СтрокаОбъекта.Сформировано + НоваяСтрока.Сумма;
			Иначе	                     
				НоваяСтрока.Сумма = Окр(СтрокаВложений.Сумма * КоэффициентОбъекта, 2);
				СтрокаВложений.Списано = СтрокаВложений.Списано + НоваяСтрока.Сумма;
				СтрокаОбъекта.Сформировано = СтрокаОбъекта.Сформировано + НоваяСтрока.Сумма;
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;	
КонецПроцедуры	

#КонецОбласти

#КонецЕсли
