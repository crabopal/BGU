&НаКлиенте
Процедура ПодобратьМЦ(Команда)
	
	ОтменитьПодбор = Ложь;
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстОшибки = НСтр("ru='Не выбрана организация!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,
			Объект.Ссылка,"Организация", "Объект");
		ОтменитьПодбор = Истина;	
	ИначеЕсли Не ЗначениеЗаполнено(Объект.ОбъектВложений) Тогда
		ТекстОшибки = НСтр("ru='Не выбран объект вложения!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,
			Объект.Ссылка, "ОбъектВложений", "Объект");
		ОтменитьПодбор = Истина;
	КонецЕсли; 
	
	Если ОтменитьПодбор ИЛИ Элементы.СписокВложенийДокументаОснования.ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПодборПоОстаткамМЦЗавершение", ЭтотОбъект);
	
	ТекущийОбъектВложений = Элементы.СписокВложенийДокументаОснования.ТекущиеДанные.ОбъектВложений; 
	
	ПараметрыОтбора = Новый Структура("Отбор", Новый Структура);
	ПараметрыОтбора.Отбор.Вставить("Организация", Объект.Организация);
	ПараметрыОтбора.Отбор.Вставить("ОсновнойОбъектВложения", Объект.ОбъектВложений);
	ПараметрыОтбора.Вставить("Период", Объект.Дата);  
	
	ТекстЗаголовка = "Подбор материальных ценностей в состав объекта вложений %1";
	ПараметрыОтбора.Вставить("Заголовок", СтрШаблон(ТекстЗаголовка, ТекущийОбъектВложений));
	
	ПараметрыОтбора.Вставить("АдресОСВХранилище", ПоместитьМЦВХранилище(ТекущийОбъектВложений));
	
	ОткрытьФорму("Обработка.ДобавлениеСпискаДМ.Форма.ПодборПоОстаткам", ПараметрыОтбора, ЭтотОбъект,,,, ОповещениеОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРежимОтбораДМПоОбъектуВложений(Команда)
	
	ЭтотОбъект.ИспользоватьОтборДрагМатериаловПоОбъектуВложений = НЕ ЭтотОбъект.ИспользоватьОтборДрагМатериаловПоОбъектуВложений; 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"МатериальныеЦенностиОбъектВложений", "Видимость", НЕ ЭтотОбъект.ИспользоватьОтборДрагМатериаловПоОбъектуВложений);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"МатериальныеЦенностиНомерСтроки", "Видимость", НЕ ЭтотОбъект.ИспользоватьОтборДрагМатериаловПоОбъектуВложений);
	
	УстановитьОтборПоОбъектуВложения();	

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыОбъектыЦелевые(Команда)               
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("СчетУчета", Новый Структура);
	Реквизиты.СчетУчета.Вставить("Счета", "106.00");
	Реквизиты.СчетУчета.Вставить("ВИерархии", Истина);
	Реквизиты.СчетУчета.Вставить("Дата", Объект.Дата);

	Реквизиты.Вставить("ЦМО", Новый Структура);
	Реквизиты.ЦМО.Вставить("Организация", Объект.Организация);
	
	Реквизиты.Вставить("Подразделение", Новый Структура);
	Реквизиты.Подразделение.Вставить("Организация", Объект.Организация);
	
	УправлениеНФАКлиент.ИзменитьРеквизитыСтрокТЧ(ЭтотОбъект, 
	"РазукомплектацияКапвложений", "ОбъектыЦелевые", "ОбъектыЦелевые", 
	Реквизиты);
КонецПроцедуры

