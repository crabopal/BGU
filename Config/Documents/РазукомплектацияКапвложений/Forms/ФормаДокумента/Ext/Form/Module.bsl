#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбъектыЦелевые

&НаКлиенте
Процедура ОбъектыЦелевыеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор();
		Элемент.ТекущиеДанные.ОтразитьВКарточкеКапвложений = Истина;
		ОстатокКапвложений();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыЦелевыеПередУдалением(Элемент, Отказ)
	
	ОбъектНаУдаление = Элементы.ОбъектыЦелевые.ТекущиеДанные.ОбъектВложений;
		
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектВложений", ОбъектНаУдаление);
	НайденныеСтроки = Объект.МЦСДрагоценнымиМатериалами.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()<>0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПараметрыОповещения = Новый Структура("НайденныеСтроки", НайденныеСтроки);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДрагМатериалах", ЭтотОбъект, ПараметрыОповещения);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Удалить данные о содержании материальных ценностей в удаленном объекте вложений ("+
						СокрЛП(ОбъектНаУдаление)+") на закладке ""Драгоценные материалы""?'"), Режим, 0);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВариантРаспределенияПриИзменении(Элемент)
	ВидимостьБазыРаспределения(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СписокВложенийДокументаОснования

&НаКлиенте
Процедура СписокВложенийДокументаОснованияПриАктивизацииСтроки(Элемент)

	УстановитьОтборПоОбъектуВложения();	

КонецПроцедуры

&НаКлиенте
Процедура ОбъектыВложенийСДрагМатериаламиОбъектВложенийПриИзменении(Элемент)
	
	ПараметрыОтбора = Новый Структура;   
	Если Элементы.СписокВложенийДокументаОснования.ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	ПараметрыОтбора.Вставить("ОбъектВложений", Элементы.СписокВложенийДокументаОснования.ТекущиеДанные.ОбъектВложений);
	МассивСтрок = Объект.МЦСДрагоценнымиМатериалами.НайтиСтроки(ПараметрыОтбора); 
	Для Каждого ИндексСтроки Из МассивСтрок Цикл
		ИндексСтроки.ОбъектВложений = Элементы.СписокВложенийДокументаОснования.ТекущиеДанные.ОбъектВложений;
	КонецЦикла;
	
	УстановитьОтборПоОбъектуВложения();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_МатериальныеЦенности

&НаКлиенте
Процедура МатериальныеЦенностиОбъектМЦПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Элементы.МатериальныеЦенности.ТекущиеДанные.ОбъектВложений) Тогда
		
		 Элементы.МатериальныеЦенности.ТекущиеДанные.ОбъектВложений = Элементы.СписокВложенийДокументаОснования.ТекущиеДанные.ОбъектВложений; 
		
	КонецЕсли;
	
	УстановитьОтборПоОбъектуВложения();
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()
	Объект.КапвложенияИсходные.Очистить();
	Объект.КапвложенияЦелевые.Очистить();
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК Сумма,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Дата1,
	|			Счет = &СчетУчета,
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &ОбъектВложений) КАК ЖурналПроводокЕПСБУОстатки";   
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Дата1", КонецДня(Объект.Дата) + 1);
	Запрос.УстановитьПараметр("СчетУчета", Объект.СчетУчета);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ОбъектВложений", Объект.ОбъектВложений);
	
	Выборка = Запрос.Выполнить().Выбрать();  
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.КапвложенияИсходные.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор();
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ОстатокКапвложений()
	Если Объект.ВариантРаспределения = 1 Тогда // Суммы
		Элементы.ОбъектыЦелевые.ТекущиеДанные.Сумма = Объект.КапвложенияИсходные.Итог("Сумма") - Объект.ОбъектыЦелевые.Итог("Сумма");
	Иначе // Проценты	
		Элементы.ОбъектыЦелевые.ТекущиеДанные.Процент = 100 - Объект.ОбъектыЦелевые.Итог("Процент");
	КонецЕсли;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьБазыРаспределения(Форма)
	ВидимостьСуммы = (Форма.Объект.ВариантРаспределения = 1);
	Форма.Элементы.ОбъектыЦелевыеСумма.Видимость     = ВидимостьСуммы;
	Форма.Элементы.ОбъектыЦелевыеИтогСумма.Видимость = ВидимостьСуммы;

	Форма.Элементы.ОбъектыЦелевыеПроцент.Видимость     = НЕ ВидимостьСуммы;
	Форма.Элементы.ОбъектыЦелевыеИтогПроцент.Видимость = НЕ ВидимостьСуммы;
КонецПроцедуры

&НаСервере
Процедура ВидимостьЗакладкиДрагМатериалы()

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СтраницаДрагоценныеМатериалы", "Видимость", УчетДрагМатериалов.ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() 
		ИЛИ Объект.МЦСДрагоценнымиМатериалами.Количество() > 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		Объект.КапвложенияЦелевые.Очистить();
		ОбработкаВыбораПодбораОССервер(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодбораОССервер(Знач ВыбранноеЗначение)
	
	ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
	ИсходныеДанные = Объект.ОбъектыЦелевые.Выгрузить();
	ИсходныеДанные.Индексы.Добавить("ОбъектВложений");
	
	ДобавленныеСтроки = Новый Массив;
	Объект.ОбъектыЦелевые.Очистить();
	Для Каждого СтрокаТаблицыОС Из ТаблицаОС Цикл
		ЭлементКоллекции = Объект.ОбъектыЦелевые.Добавить();
		СтрокаИсходныхДанных = ИсходныеДанные.Найти(СтрокаТаблицыОС.ОбъектВложений,"ОбъектВложений");
		Если СтрокаИсходныхДанных <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаИсходныхДанных);
		Иначе
			ДобавленныеСтроки.Добавить(ЭлементКоллекции);
			ЭлементКоллекции.ИдентификаторСтроки = Новый УникальныйИдентификатор();
		КонецЕсли;
			
		ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаТаблицыОС);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ДопустимыеВидыНФА = Новый Массив;
	ДопустимыеВидыНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС"));
	ДопустимыеВидыНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА"));
	ДопустимыеВидыНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА"));
	ДопустимыеВидыНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения"));
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ВидНФА"		, ДопустимыеВидыНФА);
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения"	, "ПринятиеКУчетуВложения");
	ПараметрыПодбора.Вставить("КолонкиКорзины"	, Новый Структура("ОсновноеСредство", "ОбъектВложений"));
	
	Если Объект.ОбъектыЦелевые.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()
	
	ТаблицаОС = Объект.ОбъектыЦелевые.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);
	
КонецФункции

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаОДрагМатериалах(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Параметры.НайденныеСтроки Цикл
		Объект.МЦСДрагоценнымиМатериалами.Удалить(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьМЦВХранилище(ТекущийОбъектВложений)
	
	МассивДанныхДок = Новый Массив;
	ТаблицаМЦ = Объект.МЦСДрагоценнымиМатериалами.Выгрузить(); 
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("ОбъектВложений", ТекущийОбъектВложений);
	
	МЦТекущегоОбъекта = ТаблицаМЦ.Скопировать(ПараметрыПоиска);
	
	Для Каждого ТекСтрока Из МЦТекущегоОбъекта Цикл
		 ТекСтрока.ОбъектВложений = Объект.ОбъектВложений;
	КонецЦикла;

	МассивДанныхДок.Добавить(МЦТекущегоОбъекта);  
	
	МассивНаУдаление = ТаблицаМЦ.НайтиСтроки(ПараметрыПоиска);
	Для Каждого ТекМЦ Из МассивНаУдаление Цикл
	    ТаблицаМЦ.Удалить(ТекМЦ);
	КонецЦикла;
	
	ТаблицаМЦ.Свернуть("ОбъектМЦ", "КоличествоМЦ");

	МассивДанныхДок.Добавить(ТаблицаМЦ);    
	
	Возврат ПоместитьВоВременноеХранилище(МассивДанныхДок);
	
КонецФункции

&НаКлиенте
Процедура ПодборПоОстаткамМЦЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ТекущийОбъектВложений = Элементы.СписокВложенийДокументаОснования.ТекущиеДанные.ОбъектВложений;
	
		ОбработкаВыбораПодбораМЦНаСервере(Результат, ТекущийОбъектВложений);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ОбработкаВыбораПодбораМЦНаСервере(Знач ВыбранноеЗначение, ТекущийОбъектВложений)
	
	Коллекция = Объект.МЦСДрагоценнымиМатериалами;
	ИмяМЦ = "ОбъектМЦ"; 
	КолонкиПоиска = "ОбъектВложений, ОбъектМЦ";  
	
	Таблица = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
	Таблица.Колонки.ОбъектМЦ.Имя = ИмяМЦ;
	ИсходныеДанные = Коллекция.Выгрузить();
	ИсходныеДанные.Индексы.Добавить(КолонкиПоиска);
	
	ДобавленныеСтроки = Новый Массив;
	СтруктураПоиска = Новый Структура(КолонкиПоиска);
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("ОбъектВложений", ТекущийОбъектВложений);
	
	МассивНаУдаление = Коллекция.НайтиСтроки(ПараметрыПоиска);
	Для Каждого ТекМЦ Из МассивНаУдаление Цикл
			Коллекция.Удалить(ТекМЦ);
	КонецЦикла;
		
	Для Каждого СтрокаТаблицы Из Таблица Цикл 
		СтрокаТаблицы.ОбъектВложений = ТекущийОбъектВложений; 
		ЭлементКоллекции = Коллекция.Добавить();			
		ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстаткиМЦОбъектовВложенийНаСервере()

	ТаблицаВсехОбъектов = Объект.ОбъектыЦелевые.Выгрузить(,
		"ОбъектВложений, Количество");
	
	ТаблицаОбъектовВложений = Новый ТаблицаЗначений;
	ТаблицаОбъектовВложений.Колонки.Добавить("ОбъектВложений", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовВложений.Колонки.Добавить("ОбъектМЦ", УчетДрагМатериалов.ТипОбъектаНФА());
	ТаблицаОбъектовВложений.Колонки.Добавить("КоличествоМЦ", Новый ОписаниеТипов("Число"));   
	
	ТЗОстаткаМЦ = УчетДрагМатериалов.ПолучитьСписокОстатковМЦ(Объект.Дата, Объект.Организация, Объект.ОбъектВложений);
	
	Для Каждого ТекОбъект Из ТаблицаВсехОбъектов Цикл
		Для Каждого ТекСтрока Из ТЗОстаткаМЦ Цикл
			
			КоличествоОбъектовВложений = ?(ТекОбъект.Количество = 0, 1, ТекОбъект.Количество);
			
			Если ТекСтрока.ОбъектМЦ = ТекОбъект.ОбъектВложений И НЕ ТекОбъект.ОбъектВложений = Объект.ОбъектВложений 
														И ТекСтрока.КоличествоОстаток > 0 Тогда
				НоваяСтрока = ТаблицаОбъектовВложений.Добавить();
				НоваяСтрока.ОбъектВложений = ТекОбъект.ОбъектВложений;
				НоваяСтрока.ОбъектМЦ       = ТекСтрока.ОбъектМЦ;
			    НоваяСтрока.КоличествоМЦ   = ?(ТекСтрока.КоличествоОстаток - КоличествоОбъектовВложений > 0, КоличествоОбъектовВложений, ТекСтрока.КоличествоОстаток); 
				
				ТекСтрока.КоличествоОстаток = ТекСтрока.КоличествоОстаток - КоличествоОбъектовВложений;
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;
	
	Объект.МЦСДрагоценнымиМатериалами.Загрузить(ТаблицаОбъектовВложений);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧМатериальныеЦенности()
	
	ТаблицаВсехОбъектов = Объект.ОбъектыЦелевые.Выгрузить(,
		"ОбъектВложений, Количество");
	
	ТаблицаОбъектовОС = Новый ТаблицаЗначений;
	ТаблицаОбъектовОС.Колонки.Добавить("ОбъектВложений",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовОС.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл 
		Если НЕ ТекСтрока.ОбъектВложений = Объект.ОбъектВложений Тогда
			НоваяСтрока = ТаблицаОбъектовОС.Добавить();
			НоваяСтрока.ОбъектВложений = ТекСтрока.ОбъектВложений;
			НоваяСтрока.Количество = ТекСтрока.Количество;
		КонецЕсли;	
	КонецЦикла;
	
	ОбъектыВложенийСМЦ.Загрузить(ТаблицаОбъектовОС);
	Прочитать();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоОбъектуВложения()
	
	Если ЭтотОбъект.ИспользоватьОтборДрагМатериаловПоОбъектуВложений Тогда
		
		Элементы.МатериальныеЦенностиУстановитьРежимОтбораДМПоОбъекту.Пометка = Истина;

		Если Элементы.СписокВложенийДокументаОснования.ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ОбъектВложений = Элементы.СписокВложенийДокументаОснования.ТекущиеДанные.ОбъектВложений;
		
		Элементы.МатериальныеЦенности.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ОбъектВложений",ОбъектВложений));	
	Иначе
		
		Элементы.МатериальныеЦенностиУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
		Элементы.МатериальныеЦенности.ОтборСтрок = Неопределено;
		
	КонецЕсли;	
	
КонецПроцедуры

