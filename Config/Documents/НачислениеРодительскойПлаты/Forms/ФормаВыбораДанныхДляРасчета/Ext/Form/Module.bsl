
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	АдресХранилища = "";
	
	Если Не Параметры.Свойство("АдресХранилища", АдресХранилища) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ТаблицаДанныхДляРасчета = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	Если ТипЗнч(ТаблицаДанныхДляРасчета) <> Тип("ТаблицаЗначений") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ТаблицаДанныхДляРасчета.Колонки.Добавить("ВключатьВРасчет", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповБулево());
	ТаблицаДанныхДляРасчета.ЗаполнитьЗначения(Истина, "ВключатьВРасчет");
	
	ЗначениеВРеквизитФормы(ТаблицаДанныхДляРасчета, "ДанныеДляРасчета");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	АдресХранилища = ВыбратьСтрокиДляРасчета();
	
	Оповестить("НачислениеРодительскойПлаты_ВыбраныДанныеДляРасчета", АдресХранилища);
	
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	Для Каждого Стр Из ДанныеДляРасчета Цикл
		Стр.ВключатьВРасчет = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	Для Каждого Стр Из ДанныеДляРасчета Цикл
		Стр.ВключатьВРасчет = Ложь;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ВыбратьСтрокиДляРасчета()
	ТабЗначений = РеквизитФормыВЗначение("ДанныеДляРасчета");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабЗначений.ВключатьВРасчет КАК ВключатьВРасчет,
	               |	ТабЗначений.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	               |	ТабЗначений.Ребенок КАК Ребенок,
	               |	ТабЗначений.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	ТабЗначений.НачалоПериода КАК НачалоПериода,
	               |	ТабЗначений.КонецПериода КАК КонецПериода,
	               |	ТабЗначений.СтавкаОплаты КАК СтавкаОплаты,
	               |	ТабЗначений.Льгота КАК Льгота,
				   |	ТабЗначений.Контрагент КАК Контрагент
	               |ПОМЕСТИТЬ ВыборкаСтрок
	               |ИЗ
	               |	&ТабЗначений КАК ТабЗначений
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВыборкаСтрок.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	               |	ВыборкаСтрок.Ребенок КАК Ребенок,
	               |	ВыборкаСтрок.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	ВыборкаСтрок.НачалоПериода КАК НачалоПериода,
	               |	ВыборкаСтрок.КонецПериода КАК КонецПериода,
	               |	ВыборкаСтрок.СтавкаОплаты КАК СтавкаОплаты,
	               |	ВыборкаСтрок.Льгота КАК Льгота,
				   |	ВыборкаСтрок.Контрагент КАК Контрагент
	               |ИЗ
	               |	ВыборкаСтрок КАК ВыборкаСтрок
	               |ГДЕ
	               |	ВыборкаСтрок.ВключатьВРасчет";
				   
	Запрос.УстановитьПараметр("ТабЗначений", ТабЗначений);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() > 0 Тогда
		Возврат ПоместитьВоВременноеХранилище(Результат);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

#КонецОбласти
