#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере(ПриСозданииНаСервере = Ложь)
	
	РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставление(ЭтаФорма, "Объект.НачалоПериода", "НачалоПериодаСтрокой");
	РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставление(ЭтаФорма, "Объект.КонецПериода", "КонецПериодаСтрокой");

	ДнейПоГрафику = КоличествоРабочихДнейПериода(Объект.НачалоПериода, Объект.КонецПериода, Объект.ГруппаДетскогоУчреждения);
	
	УстановитьВидимостьПоПериодуРасчета(ЭтотОбъект);
	
	УстановитьВидимостьРасшифровки(ЭтотОбъект);
	УстановитьВидимостьГруппыДетскогоУчреждения(ЭтотОбъект);
	ВидимостьРеквизитовНДС(ЭтотОбъект);
	ОбновитьВидимостьДекорацийКомандЭДОДокумента(ЭтотОбъект);
	
	Если Не ПриСозданииНаСервере Тогда
		УстановитьПредупреждение(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокумент(СДополнительнымОтбором = Ложь)

	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле",
			"Заполнение",
			НСтр("ru = 'Организация'"));  
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Организация", "Объект");
		
		Возврат;
		
	ИначеЕсли Объект.Начисления.Количество() > 0 Тогда
		
		ДополнительныеПараметры = Новый Структура("СДополнительнымОтбором", СДополнительнымОтбором);
		Оповещение = Новый ОписаниеОповещения("ЗапроситьОчисткуТабличнойЧасти", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение,
					   НСтр("ru='При заполнении таблица документа будет очищена.
								|Продолжить?'"),
					   РежимДиалогаВопрос.ДаНет,
					   ,
					   КодВозвратаДиалога.Нет);
		Возврат;
		
	КонецЕсли;

	Если СДополнительнымОтбором Тогда
		
		ОткрытьФормуОтбора();
	
	Иначе
		
		ЗаполнитьСпискомДетей();
		
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ОткрытьФормуОтбора()
		
	Адреса = ПолучитьАдресаСхемыКомпоновкиДанныхВоВременномХранилище();
	
	ПараметрыФормы = РаботаСоСтудентамиКлиент.ПараметрыФормыУпрощеннойНастройкиСхемыКомпоновкиДанных(Адреса, УникальныйИдентификатор);
	ПараметрыФормы.Заголовок = НСтр("ru = 'Настройка параметров отбора детей'");
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Адреса", Адреса);
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоОтбору", ЭтотОбъект, ДопПараметры);
	ОткрытьФорму("ОбщаяФорма.УпрощеннаяНастройкаСхемыКомпоновкиДанных",
		ПараметрыФормы,
		ЭтаФорма, , , ,
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьОчисткуТабличнойЧасти(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если ДопПараметры.СДополнительнымОтбором Тогда
		ОткрытьФормуОтбора();
	Иначе
		ЗаполнитьСпискомДетей();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьВыборСтавкиОплаты(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВыбиратьСОграничением", Истина);
	ПараметрыФормы.Вставить("Период", Объект.НачалоПериода);
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьСтрокиВыбраннойСтавкой", ЭтотОбъект, ДопПараметры);
	ОткрытьФорму("Справочник.СтавкиОплатыОбразование.ФормаВыбора",
		ПараметрыФормы,
		ЭтаФорма, , , ,
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОтбору(Результат, ДопПараметры) Экспорт
	Адреса = ДопПараметры.Адреса;
	
	Если Результат <> Неопределено Тогда
		
		Адреса.НастройкиКомпоновкиДанных = Результат;
		ЗаполнитьСпискомДетей(Адреса);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтрокиВыбраннойСтавкой(Результат, ДопПараметры) Экспорт
		
	Если Результат <> Неопределено Тогда
		
		ЗаполнитьСтрокиВыбраннойСтавкойСервер(Результат);
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокиВыбраннойСтавкойСервер(НоваяСтавка)
	
	Для Каждого СтрокаТЧ Из Объект.Начисления Цикл
		
		СтрокаТЧ.СтавкаОплаты = НоваяСтавка;
		СтрокаТЧ.Подробнее = Неопределено;
		
		Структура = СоздатьСтруктуруКолонокТабличнойЧасти();
		ЗаполнитьЗначенияСвойств(Структура, СтрокаТЧ);

		РезультатРасчета = Новый Структура;	
		РассчитатьСтрокуСервер(Структура, РезультатРасчета);

		СтрокаТЧ.Сумма = РезультатРасчета.Сумма;
		
		РассчитатьСтроку(Объект, СтрокаТЧ, "Сумма");
		
	КонецЦикла;
	
	Объект.РасшифровкаНачисления.Очистить();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресаСхемыКомпоновкиДанныхВоВременномХранилище()
	
	Адреса = Новый Структура("СхемаКомпоновкиДанных, НастройкиКомпоновкиДанных");
	
	СхемаКомпоновкиДанных = Справочники.Дети.ПолучитьМакет("Подбор");
	Адреса.СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Адреса.СхемаКомпоновкиДанных));
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация", Объект.Организация);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НаДату", Объект.КонецПериода);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ГруппаДетскогоУчреждения", Объект.ГруппаДетскогоУчреждения);
	Адреса.НастройкиКомпоновкиДанных = ПоместитьВоВременноеХранилище(КомпоновщикНастроек.ПолучитьНастройки());
	
	Возврат Адреса;
	
КонецФункции


&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПоПериодуРасчета(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КонецПериодаСтрокой",
		"Видимость", Форма.Объект.РасчетЗаНесколькоМесяцев);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьРеквизитовНДС(Форма)
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("НачисленияСтавкаНДС");
	ИменаЭлементов.Добавить("НачисленияСуммаНДС");
	ИменаЭлементов.Добавить("НачисленияВсего");
	ИменаЭлементов.Добавить("НачисленияПорядокВыпискиСФ");
	ИменаЭлементов.Добавить("УправлениеСчетФактурами");
	ИменаЭлементов.Добавить("СуммаВключаетНДС");
	ИменаЭлементов.Добавить("ИтогоНДС");
	ИменаЭлементов.Добавить("СтавкаНДС");
	ИменаЭлементов.Добавить("ПорядокВыпискиСФ");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Видимость", Форма.Объект.УчитыватьНДС);
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция КоличествоРабочихДнейПериода(Знач Начало, Знач Окончание, Знач Группа)
	
	Возврат РодительскаяПлата.КоличествоРабочихДнейПоГрафикуГруппы(Начало, Окончание, Группа);
	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредупреждение(Форма)
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("Организация");
	ИменаЭлементов.Добавить("ГруппаДетскогоУчреждения");
	ИменаЭлементов.Добавить("КонецПериодаСтрокой");
	ИменаЭлементов.Добавить("НачалоПериодаСтрокой");
	ИменаЭлементов.Добавить("Дата");
	ИменаЭлементов.Добавить("РасчетЗаДопУслуги");
	ИменаЭлементов.Добавить("УчитыватьНДС");
	ИменаЭлементов.Добавить("НастройкаРасчета");
	ИменаЭлементов.Добавить("ИФО");
	ИменаЭлементов.Добавить("Подразделение");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(
		Форма.Элементы,
		ИменаЭлементов,
		"ОтображениеПредупрежденияПриРедактировании",
		?(Форма.Объект.Начисления.Количество() > 0,
			ОтображениеПредупрежденияПриРедактировании.Отображать,
			ОтображениеПредупрежденияПриРедактировании.НеОтображать));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитТЧ(ИмяРеквизита, Значение)
	
	Для каждого Строка Из Объект.Начисления Цикл
		
		Строка[ИмяРеквизита] = Значение;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеНачалаПериода(Элемент)
	
	НовоеЗначение = Неопределено;
	
	Если НЕ Объект.РасчетЗаНесколькоМесяцев Тогда
		
		Если НЕ КонецМесяца(Объект.НачалоПериода) = КонецМесяца(Объект.КонецПериода) Тогда
			
			НовоеЗначение =  КонецМесяца(Объект.НачалоПериода);
			
		КонецЕсли;
		
	Иначе
		
		Если КонецМесяца(Объект.НачалоПериода) >  КонецМесяца(Объект.КонецПериода) Тогда
			
			НовоеЗначение =  КонецМесяца(Объект.НачалоПериода);
			
		КонецЕсли;

	КонецЕсли;	
	
	Если НЕ НовоеЗначение = Неопределено Тогда
		
		Объект.КонецПериода = НовоеЗначение;
		
		ЗаполнитьРеквизитТЧ("КонецПериода", Объект.КонецПериода);
		
		РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставление(ЭтаФорма, "Объект.КонецПериода", "КонецПериодаСтрокой", Ложь);

	КонецЕсли;
	
	ДнейПоГрафику = КоличествоРабочихДнейПериода(Объект.НачалоПериода, Объект.КонецПериода, Объект.ГруппаДетскогоУчреждения);

	ЗаполнитьРеквизитТЧ("ДнейПосещенияПоГрафику", ДнейПоГрафику);
	ЗаполнитьРеквизитТЧ("ДнейПосещенияКОплате", ДнейПоГрафику);

КонецПроцедуры	

&НаКлиенте
Процедура ОбработатьИзменениеОкончанияПериода(Элемент)
	
	НовоеЗначение = Неопределено;
	
	Если КонецМесяца(Объект.НачалоПериода) >  КонецМесяца(Объект.КонецПериода) Тогда
			
			НовоеЗначение =  НачалоМесяца(Объект.КонецПериода);
			
	КонецЕсли;

	
	Если НЕ НовоеЗначение = Неопределено Тогда
		
		Объект.НачалоПериода = НовоеЗначение;
		
		ЗаполнитьРеквизитТЧ("НачалоПериода", Объект.НачалоПериода);
		
		РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставление(ЭтаФорма, "Объект.НачалоПериода", "НачалоПериодаСтрокой", Ложь);
		
	КонецЕсли;
	
	ДнейПоГрафику = КоличествоРабочихДнейПериода(Объект.НачалоПериода, Объект.КонецПериода, Объект.ГруппаДетскогоУчреждения);

	ЗаполнитьРеквизитТЧ("ДнейПосещенияПоГрафику", ДнейПоГрафику);
	ЗаполнитьРеквизитТЧ("ДнейПосещенияКОплате", ДнейПоГрафику);
	
КонецПроцедуры	

&НаСервере
Процедура ГруппаДетскогоУчрежденияПриИзмененииНаСервере()

	НужныеСтроки = Объект.Начисления.Выгрузить(Новый Структура("ГруппаДетскогоУчреждения", Объект.ГруппаДетскогоУчреждения));
	Объект.Начисления.Загрузить(НужныеСтроки);
	ДнейПоГрафику = КоличествоРабочихДнейПериода(Объект.НачалоПериода, Объект.КонецПериода, Объект.ГруппаДетскогоУчреждения);
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеСтроки(ИдентификаторСтроки)
	
	СтрокаТЧ = Объект.Начисления.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если Не ЗначениеЗаполнено(СтрокаТЧ.Контрагент) Тогда
		СтрокаТЧ.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Ребенок, "Контрагент");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтрокаТЧ.ДоговорКонтрагента)
		Или Не ЗначениеЗаполнено(СтрокаТЧ.ГруппаДетскогоУчреждения) Тогда
		РодительскаяПлата.ЗаполнитьГруппуИДоговорВСтрокеДокумента(СтрокаТЧ, Объект);
	КонецЕсли;
	
	РассчитатьСуммуВСтроке(ИдентификаторСтроки);

	СведенияДляЭДО = ДанныеРебенкаДляЭДО(СтрокаТЧ.Ребенок, СтрокаТЧ.ДоговорКонтрагента);
	СтрокаТЧ.КонтрагентЭДО = СведенияДляЭДО.КонтрагентЭДО;
	СтрокаТЧ.ДоговорКонтрагентаЭДО = СведенияДляЭДО.ДоговорКонтрагентаЭДО;
	
	НастройкаДоступностиЭДО();
	НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТЧ);

	ВидимостьЭлементовЭДО = ВидимостьЭлементовЭДОДляСтроки(СтрокаТЧ.КонтрагентЭДО);
	СтрокаТЧ.ДоступностьЭДО = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
	СтрокаТЧ.ОформлятьЭД = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуВСтроке(ИдентификаторСтроки)
	
	СтрокаТЧ = Объект.Начисления.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Структура = СоздатьСтруктуруКолонокТабличнойЧасти();
	ЗаполнитьЗначенияСвойств(Структура, СтрокаТЧ);

	РезультатРасчета = Новый Структура;	
	РассчитатьСтрокуСервер(Структура, РезультатРасчета);

	СтрокаТЧ.Сумма = РезультатРасчета.Сумма;
	
	РассчитатьСтроку(Объект, СтрокаТЧ, "Сумма")
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьНДСВТабличнойЧасти(Знач УстановитьСтавку)

	Для Каждого Строка Из Объект.РасшифровкаНачисления Цикл
		
		Если УстановитьСтавку Тогда
			Строка.СтавкаНДС = Объект.СтавкаНДС;
		КонецЕсли;
		
		РассчитатьСтроку(Объект, Строка, "Сумма");
			
	КонецЦикла;

	Отбор = Новый Структура("ГруппаДетскогоУчреждения,Контрагент,ДоговорКонтрагента");

	Для Каждого Строка Из Объект.Начисления Цикл
		
		Если УстановитьСтавку Тогда
			Строка.СтавкаНДС = Объект.СтавкаНДС;
		КонецЕсли;

		ЗаполнитьЗначенияСвойств(Отбор, Строка);
		РасшифровкаНачисления = Объект.РасшифровкаНачисления.Выгрузить(Отбор, "СуммаНДС,Всего");
		Если РасшифровкаНачисления.Количество() > 0 Тогда
			Строка.СуммаНДС = РасшифровкаНачисления.Итог("СуммаНДС");
			Строка.Всего = РасшифровкаНачисления.Итог("Всего");
		Иначе
			РассчитатьСтроку(Объект, Строка, "Сумма");
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(Объект, СтрокаТЧ, ИмяРеквизита)
	
	Если Объект.УчитыватьНДС Тогда
		
		Если ИмяРеквизита = "Сумма" ИЛИ ИмяРеквизита = "СтавкаНДС" Или ИмяРеквизита = "СтавкаОплаты" Тогда 
			
			СтруктураПараметров = Новый Структура("Сумма, СтавкаНДС", СтрокаТЧ.Сумма, СтрокаТЧ.СтавкаНДС);
			СтрокаТЧ.СуммаНДС = УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтруктураПараметров, Объект.СуммаВключаетНДС);
			СтруктураПараметров.Вставить("СуммаНДС", СтрокаТЧ.СуммаНДС);
			СтрокаТЧ.Всего    = УправлениеНФАКлиентСервер.РассчитатьВсегоТабЧасти(СтруктураПараметров, Объект.СуммаВключаетНДС);
			
		ИначеЕсли ИмяРеквизита = "СуммаНДС" Тогда 
			
			СтруктураПараметров = Новый Структура("Сумма, СуммаНДС", СтрокаТЧ.Сумма, СтрокаТЧ.СуммаНДС);
			СтрокаТЧ.Всего    = УправлениеНФАКлиентСервер.РассчитатьВсегоТабЧасти(СтруктураПараметров, Объект.СуммаВключаетНДС);
			
		ИначеЕсли ИмяРеквизита = "Всего" Тогда 
			СтруктураПараметров = Новый Структура("Всего, СтавкаНДС, СуммаНДС", СтрокаТЧ.Всего, СтрокаТЧ.СтавкаНДС, СтрокаТЧ.СуммаНДС);
			СтруктураДанных = УправлениеНФАКлиентСервер.ПриИзмененииВсегоТабЧасти(СтруктураПараметров, "Сумма, СуммаНДС", Объект.СуммаВключаетНДС);
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтруктураДанных);
			
		КонецЕсли;
		
	Иначе
		
		СтрокаТЧ.СтавкаНДС	= ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
		СтрокаТЧ.СуммаНДС 	= 0;
		СтрокаТЧ.Всего	 	= СтрокаТЧ.Сумма;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСтрокуСервер(СтрокаТЧ, РезультатРасчета)
	Если ЗначениеЗаполнено(Объект.НастройкаРасчета) Тогда
		НастройкиРасчета = Объект.НастройкаРасчета;
	Иначе
		НастройкиРасчета = РасчетыПоРодительскойПлате.ПолучитьНастройкуРасчета();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиРасчета) Тогда
		Возврат;
	КонецЕсли;
	
	Настройка = НастройкиРасчета.Настройки[1];
	
	Формула = Настройка.ПредставлениеФормулы;
	
    ОтредактироватьТекстФормулы(Формула);
	
	НачалоПериода              = СтрокаТЧ.НачалоПериода;
	КонецПериода               = СтрокаТЧ.КонецПериода;
	ГруппаДетскогоУчреждения   = СтрокаТЧ.ГруппаДетскогоУчреждения;
	ГрафикРаботы               = РасчетыПоРодительскойПлате.ПолучитьКалендарныйГрафикГруппы(ГруппаДетскогоУчреждения, СтрокаТЧ.НачалоПериода);
	ДоговорКонтрагента         = СтрокаТЧ.ДоговорКонтрагента;
	Ребенок                    = СтрокаТЧ.Ребенок;
	СтавкаОплаты               = СтрокаТЧ.СтавкаОплаты;
	РодительскаяПлатаДопУслуги = Объект.РодительскаяПлатаДопУслуги;
	Организация                = Объект.Организация;
	Льгота                     = СтрокаТЧ.Льгота;
	ДатаОстатка                = Истина;
	ДнейКОплате                = СтрокаТЧ.ДнейПосещенияКОплате;
	
	Попытка
		Парамс = Новый Структура();
		Парамс.Вставить("НачалоПериода", НачалоПериода);
		Парамс.Вставить("КонецПериода", КонецПериода);
		Парамс.Вставить("Ребенок", Ребенок);
		Парамс.Вставить("ГруппаДетскогоУчреждения", ГруппаДетскогоУчреждения);
		Парамс.Вставить("ГрафикРаботы", ГрафикРаботы);
		Парамс.Вставить("ДоговорКонтрагента", ДоговорКонтрагента);
		Парамс.Вставить("СтавкаОплаты", СтавкаОплаты);
		Парамс.Вставить("РодительскаяПлатаДопУслуги", РодительскаяПлатаДопУслуги);
		Парамс.Вставить("Организация", Организация);
		Парамс.Вставить("Льгота", Льгота);
		Парамс.Вставить("ДатаОстатка", ДатаОстатка);
		Парамс.Вставить("ДнейКОплате", ДнейКОплате);
		
		Формула = ФормулаВставитьПараметры(Формула, Парамс);
		Результат = ОбщегоНазначения.ВычислитьВБезопасномРежиме(Формула, Парамс); // Результат = Вычислить(Формула);
	Исключение
		РодительскаяПлата.ВывестиСообщениеОбОшибке(Формула, Объект.Ссылка, ИнформацияОбОшибке());
		Результат = 0;
	КонецПопытки;
	
	РезультатРасчета.Вставить("Сумма", Результат);
КонецПроцедуры

&НаСервере
Функция ФормулаВставитьПараметры(Формула, Парамс)
	Разделители = ",()+-*/= ";
	Результат = "";
	Лексема = "";
	Для НомерСимвола = 1 По СтрДлина(Формула) Цикл
		Символ = Сред(Формула, НомерСимвола, 1);
		Если Найти(Разделители, Символ) > 0 Тогда
			// Закрываем накопленную лексему.
			Если Лексема <> "" Тогда
				Если ЕстьТакойПарам(Парамс, Лексема) Тогда
					Результат = Результат + "Параметры." + Лексема;
				Иначе
					Результат = Результат + Лексема;
				КонецЕсли;
				Лексема = "";
			КонецЕсли;
			// Сам разделитель сохраняем как есть.
			Результат = Результат + Символ;
		Иначе
			Лексема = Лексема + Символ;
		КонецЕсли;
	КонецЦикла;
	// Закрываем последнюю лексему, если формула не закончилась разделителем.
	Если Лексема <> "" Тогда
		Если ЕстьТакойПарам(Парамс, Лексема) Тогда
			Результат = Результат + "Параметры." + Лексема;
		Иначе
			Результат = Результат + Лексема;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервере
// ----------------------------------------------------------------------------
Функция ЕстьТакойПарам(Парамс, Лексема)
	Вернем = Ложь;
	Попытка
		Вернем = Парамс.Свойство(Лексема);
	Исключение
	КонецПопытки;
	Возврат Вернем;
КонецФункции

&НаСервере
Процедура ЗаполнитьСпискомДетей(Адреса = Неопределено)
	
	ДанныеРасчета = РасчетыПоРодительскойПлате.ЗаполнитьИРассчитатьТабличнуюЧасть(Объект, 1, Адреса);
	
	Если ДанныеРасчета.Колонки.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Настройка расчета не инициализирована!
										|Перезапишите настройку, указанную в форме документа или настройку по умолчанию.'");
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Объект.Начисления.Очистить();
	Объект.РасшифровкаНачисления.Очистить();
	
	ОбработатьТаблицу(ДанныеРасчета);

	УстановитьПредупреждение(ЭтотОбъект);

	УстановитьВидимостьРасшифровки(ЭтотОбъект);
	
	//Электронные документы (акты)
	НастройкаДоступностиЭДО();
	Для Каждого СтрТЧ Из Объект.Начисления Цикл
		ЗаполнитьКонтрагентаИДоговорЭДО(СтрТЧ);		
		ВидимостьЭлементовЭДО = ВидимостьЭлементовЭДОДляСтроки(СтрТЧ.КонтрагентЭДО);
		СтрТЧ.ДоступностьЭДО = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
		СтрТЧ.ОформлятьЭД = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
	КонецЦикла;
 	
КонецПроцедуры

&НаСервере
Процедура ОбработатьТаблицу(Таблица)
	
	Для Каждого СтрокаТЧ Из Таблица Цикл
		РассчитатьСтроку(Объект, СтрокаТЧ, "Сумма");
	КонецЦикла;

	ОбработаннаяТаблица = Документы.НачислениеРодительскойПлаты.РассчитатьТаблицуНачислений(Таблица);
	ОбработаннаяТаблица.Сортировать("ГруппаДетскогоУчреждения,Ребенок,НачалоПериода");
	
	ЗаполнитьКолонкуПорядокВыпискиСФ(ОбработаннаяТаблица);
	
	Объект.Начисления.Загрузить(ОбработаннаяТаблица);
	Объект.РасшифровкаНачисления.Загрузить(Документы.НачислениеРодительскойПлаты.РассчитатьТаблицуРасшифровкиНачислений(Таблица));
	
	ЗаполнитьГиперссылками();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКолонкуПорядокВыпискиСФ(Таблица)
	
	Таблица.Колонки.Добавить("ПорядокВыпискиСФ", Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокВыпискиСФЗаУслуги"));
	
	Таблица.ЗаполнитьЗначения(ПорядокВыпискиСФ, "ПорядокВыпискиСФ");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГиперссылками()
	Для Каждого Строка Из Объект.Начисления Цикл
		Контрагент = Строка.Контрагент;
		Договор = Строка.ДоговорКонтрагента;
		
		МассивСтрокРасшифровки = Объект.РасшифровкаНачисления.НайтиСтроки(
			Новый Структура("Контрагент,ДоговорКонтрагента", Контрагент, Договор));
		
		Строка.Подробнее = ТекстКолонкиПодробнее(МассивСтрокРасшифровки.Количество() > 1);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстКолонкиПодробнее(Заполнена)
	
	Если Заполнена Тогда
		Возврат НСтр("ru = 'Подробнее...'");
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРасшифровки(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НачисленияПодробнее", "Видимость",
		Форма.Объект.РасшифровкаНачисления.Количество() > 0);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтветственныхЛиц(Объект)

	Объект.ГлБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Главный бухгалтер", 
		Объект.Организация, Объект.Дата, Объект.Подразделение).ОтветственноеЛицоСсылка;
	Объект.Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Руководитель",
		Объект.Организация, Объект.Дата, Объект.Подразделение).ОтветственноеЛицоСсылка;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРасшифровку(Строка)
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("РежимОткрытияОкна", РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ПараметрыФормы.Вставить("УчитыватьНДС", Объект.УчитыватьНДС);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("НастройкаРасчета", Объект.НастройкаРасчета);
	
	ПолучитьАдрес(ПараметрыФормы, ТекущиеДанные.Контрагент, ТекущиеДанные.ДоговорКонтрагента);	
	
	ОткрытьФорму("Документ.НачислениеРодительскойПлаты.Форма.РасшифровкаРасчета", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ПолучитьАдрес(ПараметрыФормы, Контрагент, ДоговорКонтрагента)
	МассивСтрок = Объект.РасшифровкаНачисления.НайтиСтроки(Новый Структура("Контрагент,ДоговорКонтрагента", Контрагент, ДоговорКонтрагента));
	МассивКолонок = "ГруппаДетскогоУчреждения, Ребенок, Контрагент, ДоговорКонтрагента, СтавкаОплаты, Льгота, НачалоПериода, КонецПериода, ДнейПосещенияПоГрафику, ДнейПосещенияКОплате, Сумма, СтавкаНДС, СуммаНДС, Всего";
	
	Результат = Объект.РасшифровкаНачисления.Выгрузить(МассивСтрок, МассивКолонок);
	
	МассивИмен = Новый Массив;	
	Для Каждого Колонка Из Результат.Колонки Цикл
		Значения = Новый Массив;
		
		Для Каждого Строка Из Результат Цикл
			Если Значения.Найти(Строка[Колонка.Имя]) = Неопределено Тогда
				Если Значения.Количество() = 0  Тогда
					Значения.Добавить(Строка[Колонка.Имя]);
				Иначе
					МассивИмен.Добавить(Колонка.Имя);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
				   
	Адрес = ПоместитьВоВременноеХранилище(Результат, ЭтаФорма.УникальныйИдентификатор);
	
	ПараметрыФормы.Вставить("АдресХранилища", Адрес);
	ПараметрыФормы.Вставить("МассивИмен", МассивИмен);
КонецПроцедуры

&НаСервере
Процедура ЗапомнитьСтроку(ТекущаяСтрока)
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	Стр = ДокОбъект.Начисления.Найти(ТекущаяСтрока, "НомерСтроки");
	
	Массив = Новый Массив;
	Массив.Добавить(Стр);
	Строка = ДокОбъект.Начисления.Выгрузить(Массив);
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Строка, ЭтаФорма.УникальныйИдентификатор);
КонецПроцедуры

&НаСервере
Функция СтрокаИзменена(ТекСтрока)
	Результат = Ложь;
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	Строка = ДокОбъект.Начисления.Найти(ТекСтрока, "НомерСтроки");
	
	ТабЗначений = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	Если ТипЗнч(ТабЗначений) = Тип("ТаблицаЗначений") И ТабЗначений.Количество() > 0 Тогда
		СохраненнаяСтрока = ТабЗначений[0];
	КонецЕсли;
	
	КолонкиТаблицы = ДокОбъект.Начисления.ВыгрузитьКолонки();
	
	Для Каждого Колонка Из КолонкиТаблицы.Колонки Цикл
		Если Строка[Колонка.Имя] <> СохраненнаяСтрока[Колонка.Имя] Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура УдалитьСвязанныеДанные(ТекДанные)
	МассивСтрок = Объект.РасшифровкаНачисления.НайтиСтроки(Новый Структура("Контрагент, ДоговорКонтрагента", ТекДанные.Контрагент, ТекДанные.ДоговорКонтрагента));
	
	Для Каждого Строка Из МассивСтрок Цикл
		Объект.РасшифровкаНачисления.Удалить(Строка);
	КонецЦикла;
	
	УстановитьВидимостьРасшифровки(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ОтменитьРедактирование(ТекСтрока)
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	Строка = ДокОбъект.Начисления.Найти(ТекСтрока, "НомерСтроки");
	
	ТабЗначений = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	Если ТипЗнч(ТабЗначений) = Тип("ТаблицаЗначений") И ТабЗначений.Количество() > 0 Тогда
		СохраненнаяСтрока = ТабЗначений[0];
	КонецЕсли;
	
	КолонкиТаблицы = ДокОбъект.Начисления.ВыгрузитьКолонки();
	
	Для Каждого Колонка Из КолонкиТаблицы.Колонки Цикл
		Если Строка[Колонка.Имя] <> СохраненнаяСтрока[Колонка.Имя] Тогда
			Строка[Колонка.Имя] = СохраненнаяСтрока[Колонка.Имя];
		КонецЕсли;
	КонецЦикла;
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
КонецПроцедуры

&НаСервере
Процедура ОтредактироватьТекстФормулы(Стр)
	Стр = СтрЗаменить(Стр,"НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""МЕСЯЦ"")","НачалоМесяца(НачалоПериода)");
	Стр = СтрЗаменить(Стр,"КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""МЕСЯЦ"")","КонецМесяца(КонецПериода)"); 
	Стр = СтрЗаменить(Стр,"НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаНачала,""МЕСЯЦ"",-1),""МЕСЯЦ"")","РодительскаяПлата.ПредыдущийПериод(НачалоПериода,""МЕСЯЦ"",""НАЧАЛО"")");
	Стр = СтрЗаменить(Стр,"КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаОкончания,""МЕСЯЦ"",-1),""МЕСЯЦ"")","РодительскаяПлата.ПредыдущийПериод(КонецПериода,""МЕСЯЦ"",""ОКОНЧАНИЕ"")");
	Стр = СтрЗаменить(Стр,"НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""КВАРТАЛ"")","НачалоКвартала(НачалоПериода)");
	Стр = СтрЗаменить(Стр,"КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""КВАРТАЛ"")","КонецКвартала(КонецПериода)");
	Стр = СтрЗаменить(Стр,"НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаНачала,""КВАРТАЛ"",-1),""КВАРТАЛ"")","РодительскаяПлата.ПредыдущийПериод(НачалоПериода,""КВАРТАЛ"",""НАЧАЛО"")");
	Стр = СтрЗаменить(Стр,"КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаОкончания,""КВАРТАЛ"",-1),""КВАРТАЛ"")","РодительскаяПлата.ПредыдущийПериод(КонецПериода,""КВАРТАЛ"",""ОКОНЧАНИЕ"")");
	Стр = СтрЗаменить(Стр, "РасчетыПоРодительскойПлате.КолПосещений(НачалоПериода,КонецПериода,ГрафикРаботы,Ребенок,ГруппаДетскогоУчреждения,&РодительскаяПлатаДопУслуги)", "ДнейКОплате");
	Стр = СтрЗаменить(Стр, "РасчетыПоРодительскойПлате.КолПосещений(НачалоМесяца(НачалоПериода),КонецМесяца(КонецПериода),ГрафикРаботы,Ребенок,ГруппаДетскогоУчреждения,&РодительскаяПлатаДопУслуги)", "ДнейКОплате");
	Стр = СтрЗаменить(Стр, "РасчетыПоРодительскойПлате.КолПосещений(НачалоКвартала(НачалоПериода),КонецКвартала(КонецПериода),ГрафикРаботы,Ребенок,ГруппаДетскогоУчреждения,&РодительскаяПлатаДопУслуги)", "ДнейКОплате");
	Стр = СтрЗаменить(Стр,"&РодительскаяПлатаДопУслуги","РодительскаяПлатаДопУслуги");
	Стр = СтрЗаменить(Стр,"&Организация","Организация");
	Стр = СтрЗаменить(Стр, "ВЫБОР", "?(");
	Стр = СтрЗаменить(Стр, "КОГДА", "");
	Стр = СтрЗаменить(Стр, "ТОГДА", ",");
	Стр = СтрЗаменить(Стр, "ИНАЧЕ", ",");
	Стр = СтрЗаменить(Стр, "КОНЕЦ", ")");
	Стр = СтрЗаменить(Стр, " ", "");
КонецПроцедуры

&НаСервере
Функция СоздатьСтруктуруКолонокТабличнойЧасти()
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	
	Структура = Новый Структура;
	Для Каждого Колонка Из ДокОбъект.Метаданные().ТабличныеЧасти["Начисления"].Реквизиты Цикл
		Структура.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Возврат Структура;
КонецФункции

&НаСервере
Функция ПолучитьДанныеРебенка(ДанныеРебенка)
	ТекстЗапроса = "ВЫБРАТЬ
	               |	&НачалоПериода КАК НачалоПериода,
	               |	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) КАК КонецПериода,
	               |	СоставГруппДДУ.Ребенок КАК Ребенок,
	               |	СоставГруппДДУ.Договор КАК Договор,
	               |	СоставГруппДДУ.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	               |	СоставГруппДДУ.СтавкаОплаты КАК СтавкаОплаты,
	               |	СоставГруппДДУ.Льгота КАК Льгота,
	               |	ИСТИНА КАК Актуальность
	               |ПОМЕСТИТЬ ВыборкаПоГруппам
	               |ИЗ
	               |	РегистрСведений.[РегистрСведенийНачало] КАК СоставГруппДДУ
	               |ГДЕ
	               |	СоставГруппДДУ.Актуальность
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА СоставГруппДДУ.Актуальность
	               |			ТОГДА СоставГруппДДУ.Период
	               |		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА НЕ СоставГруппДДУ.Актуальность
	               |			ТОГДА СоставГруппДДУ.Период
	               |		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |	КОНЕЦ,
	               |	СоставГруппДДУ.Ребенок,
	               |	СоставГруппДДУ.Договор,
	               |	СоставГруппДДУ.ГруппаДетскогоУчреждения,
	               |	СоставГруппДДУ.СтавкаОплаты,
	               |	СоставГруппДДУ.Льгота,
	               |	СоставГруппДДУ.Актуальность
	               |ИЗ
	               |	РегистрСведений.[РегистрСведений] КАК СоставГруппДДУ
	               |ГДЕ
	               |	СоставГруппДДУ.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	               |	И СоставГруппДДУ.Ребенок = &Ребенок
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0),
	               |	&ОкончаниеПериода,
	               |	СоставГруппДДУ.Ребенок,
	               |	СоставГруппДДУ.Договор,
	               |	СоставГруппДДУ.ГруппаДетскогоУчреждения,
	               |	СоставГруппДДУ.СтавкаОплаты,
	               |	СоставГруппДДУ.Льгота,
	               |	ИСТИНА
	               |ИЗ
	               |	РегистрСведений.[РегистрСведенийОкончание] КАК СоставГруппДДУ
	               |ГДЕ
	               |	СоставГруппДДУ.Актуальность
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВыборкаПоГруппам.НачалоПериода КАК НачалоПериода,
	               |	ВыборкаПоГруппамВл.КонецПериода КАК КонецПериода,
	               |	ВыборкаПоГруппам.Ребенок КАК Ребенок,
	               |	ВыборкаПоГруппам.Договор КАК ДоговорКонтрагента,
	               |	ВыборкаПоГруппам.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	               |	ВыборкаПоГруппам.СтавкаОплаты КАК СтавкаОплаты,
	               |	ВыборкаПоГруппам.Льгота КАК Льгота,
				   |	ВыборкаПоГруппам.Ребенок.Контрагент КАК Контрагент
	               |ИЗ
	               |	ВыборкаПоГруппам КАК ВыборкаПоГруппам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ВыборкаПоГруппам.КонецПериода КАК КонецПериода,
	               |			ВыборкаПоГруппам.Ребенок КАК Ребенок,
	               |			ВыборкаПоГруппам.Договор КАК Договор,
	               |			ВыборкаПоГруппам.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	               |			ВыборкаПоГруппам.СтавкаОплаты КАК СтавкаОплаты,
	               |			ВыборкаПоГруппам.Льгота КАК Льгота
	               |		ИЗ
	               |			ВыборкаПоГруппам КАК ВыборкаПоГруппам
	               |		ГДЕ
	               |			ВыборкаПоГруппам.КонецПериода <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ВыборкаПоГруппамВл
	               |		ПО ВыборкаПоГруппам.Ребенок = ВыборкаПоГруппамВл.Ребенок
	               |			И ВыборкаПоГруппам.Договор = ВыборкаПоГруппамВл.Договор
	               |			И ВыборкаПоГруппам.ГруппаДетскогоУчреждения = ВыборкаПоГруппамВл.ГруппаДетскогоУчреждения
	               |			И ВыборкаПоГруппам.СтавкаОплаты = ВыборкаПоГруппамВл.СтавкаОплаты
	               |			И ВыборкаПоГруппам.Льгота = ВыборкаПоГруппамВл.Льгота
	               |ГДЕ
	               |	ВыборкаПоГруппам.НачалоПериода <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
				   |	[УсловиеГруппаДетскогоУчреждения]
				   |    [УсловиеДоговор]";
				   
	Если Объект.РодительскаяПлатаДопУслуги = 0 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[РегистрСведенийНачало]", "СоставГруппДДУ.СрезПоследних(&НачалоПериода, Ребенок = &Ребенок И Ребенок.Организация = &Организация)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[РегистрСведений]", "СоставГруппДДУ");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[РегистрСведенийОкончание]", "СоставГруппДДУ.СрезПоследних(&ОкончаниеПериода, Ребенок = &Ребенок И Ребенок.Организация = &Организация)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[РегистрСведенийНачало]", "СоставГруппДДУДополнительныеУслуги.СрезПоследних(&НачалоПериода, Ребенок = &Ребенок И Ребенок.Организация = &Организация)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[РегистрСведений]", "СоставГруппДДУДополнительныеУслуги");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[РегистрСведенийОкончание]", "СоставГруппДДУДополнительныеУслуги.СрезПоследних(&ОкончаниеПериода, Ребенок = &Ребенок И Ребенок.Организация = &Организация)");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеРебенка.ДоговорКонтрагента) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[УсловиеДоговор]", "И ВыборкаПоГруппам.Договор = &Договор");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[УсловиеДоговор]", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеРебенка.ГруппаДетскогоУчреждения) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[УсловиеГруппаДетскогоУчреждения]", "И ВыборкаПоГруппам.ГруппаДетскогоУчреждения = &ГруппаДетскогоУчреждения");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[УсловиеГруппаДетскогоУчреждения]", "");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Договор", ДанныеРебенка.ДоговорКонтрагента);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Объект.НачалоПериода));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(Объект.КонецПериода));
	Запрос.УстановитьПараметр("Ребенок", ДанныеРебенка.Ребенок);
	Запрос.УстановитьПараметр("ГруппаДетскогоУчреждения", ДанныеРебенка.ГруппаДетскогоУчреждения);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 1 Тогда
		ЗаполнитьЗначенияСвойств(ДанныеРебенка,  Результат[0]);
		
		КалендарныйГрафикГруппы = РасчетыПоРодительскойПлате.ПолучитьКалендарныйГрафикГруппы(ДанныеРебенка.ГруппаДетскогоУчреждения,Результат[0].НачалоПериода);
		
		ДанныеРебенка.ДнейПосещенияКОплате = РасчетыПородительскойПлате.КолПосещений(Результат[0].НачалоПериода, 
																					Результат[0].КонецПериода, 
																					КалендарныйГрафикГруппы,
																					ДанныеРебенка.Ребенок, 
																					ДанныеРебенка.ГруппаДетскогоУчреждения, 
																					Объект.РодительскаяПлатаДопУслуги);
																					
		Возврат ДанныеРебенка;
	Иначе
		Адрес = ПоместитьВоВременноеХранилище(Результат);
		Возврат Адрес;
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ОбработатьВыборДанныхДляРасчета(АдресХранилища, МассивСтрокНачислений, МассивСтрокРасшифровки)
	ТабЗначений = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	Если ТипЗнч(ТабЗначений) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ТабЗначений.Колонки.Добавить("ДнейПосещенияПоГрафику", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(3,0));
	ТабЗначений.Колонки.Добавить("ДнейПосещенияКОплате", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(3,0));
	ТабЗначений.Колонки.Добавить("Сумма", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18,2));
	ТабЗначений.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ТабЗначений.Колонки.Добавить("СуммаНДС", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18,2));
	ТабЗначений.Колонки.Добавить("Всего", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18,2));
	ТабЗначений.Колонки.Добавить("ПорядокВыпискиСФ", Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокВыпискиСФЗаУслуги"));
	ТабЗначений.Колонки.Добавить("ИДСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(36));
	
	Для Каждого Стр Из ТабЗначений Цикл
		
		Стр.ДнейПосещенияПоГрафику = ДнейПоГрафику;
		
		КалендарныйГрафикГруппы = РасчетыПоРодительскойПлате.ПолучитьКалендарныйГрафикГруппы(Стр.ГруппаДетскогоУчреждения,Стр.НачалоПериода);
		Стр.ДнейПосещенияКОплате = РасчетыПородительскойПлате.КолПосещений(Стр.НачалоПериода, 
																			Стр.КонецПериода, 
																			КалендарныйГрафикГруппы,
																			Стр.Ребенок, 
																			Стр.ГруппаДетскогоУчреждения, 
																			Объект.РодительскаяПлатаДопУслуги);
		Стр.СтавкаНДС = ?(Объект.УчитыватьНДС, Объект.СтавкаНДС, Перечисления.СтавкиНДС.ПустаяСсылка());
		Стр.ПорядокВыпискиСФ = ПорядокВыпискиСФ;
		
		Структура = СоздатьСтруктуруКолонокТабличнойЧасти();
		ЗаполнитьЗначенияСвойств(Структура, Стр);
	
		РезультатРасчета = Новый Структура;	
		РассчитатьСтрокуСервер(Структура, РезультатРасчета);
	
		Стр.Сумма = РезультатРасчета.Сумма;
		
		СтруктураПараметров = Новый Структура("Сумма, СтавкаНДС", Стр.Сумма, Стр.СтавкаНДС);
		Стр.СуммаНДС = УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтруктураПараметров, Объект.СуммаВключаетНДС);
		СтруктураПараметров.Вставить("СуммаНДС", Стр.СуммаНДС);
		Стр.Всего    = УправлениеНФАКлиентСервер.РассчитатьВсегоТабЧасти(СтруктураПараметров, Объект.СуммаВключаетНДС);
	КонецЦикла;
	
	СтрокиТаблицыНачислений = Документы.НачислениеРодительскойПлаты.РассчитатьТаблицуНачислений(ТабЗначений);
	СтрокиТаблицыРасшифровкиНачислений = Документы.НачислениеРодительскойПлаты.РассчитатьТаблицуРасшифровкиНачислений(ТабЗначений);
	
	Для Каждого Стр Из СтрокиТаблицыНачислений Цикл
		Структура = Новый Структура;
		
		Для Каждого Колонка Из СтрокиТаблицыНачислений.Колонки Цикл
			Структура.Вставить(Колонка.Имя, Стр[Колонка.Имя]);
		КонецЦикла;
		
		МассивСтрокНачислений.Добавить(Структура);
	КонецЦикла;
	
	Для Каждого Стр Из СтрокиТаблицыРасшифровкиНачислений Цикл
		Структура = Новый Структура;
		
		Для Каждого Колонка Из СтрокиТаблицыРасшифровкиНачислений.Колонки Цикл
			Структура.Вставить(Колонка.Имя, Стр[Колонка.Имя]);
		КонецЦикла;
		
		МассивСтрокРасшифровки.Добавить(Структура);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОпределитьГруппыРебенка(Отбор, Ребенок, Договор)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоставГруппДДУ.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
				   |	СоставГруппДДУ.Договор КАК Договор
	               |ПОМЕСТИТЬ ВыборкаПоГруппам
	               |ИЗ
	               |	РегистрСведений.[РегистрСведенийНачало] КАК СоставГруппДДУ
	               |ГДЕ
	               |	СоставГруппДДУ.Актуальность
				   |	И НЕ СоставГруппДДУ.ГруппаДетскогоУчреждения.ЭтоГруппа
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	СоставГруппДДУ.ГруппаДетскогоУчреждения,
				   |	СоставГруппДДУ.Договор
	               |ИЗ
	               |	РегистрСведений.[РегистрСведений] КАК СоставГруппДДУ
	               |ГДЕ
	               |	СоставГруппДДУ.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	               |	И СоставГруппДДУ.Ребенок = &Ребенок
				   |	И СоставГруппДДУ.Актуальность
				   |	И НЕ СоставГруппДДУ.ГруппаДетскогоУчреждения.ЭтоГруппа
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	СоставГруппДДУ.ГруппаДетскогоУчреждения,
				   |	СоставГруппДДУ.Договор
	               |ИЗ
	               |	РегистрСведений.[РегистрСведенийОкончание] КАК СоставГруппДДУ
	               |ГДЕ
	               |	СоставГруппДДУ.Актуальность
				   |	И НЕ СоставГруппДДУ.ГруппаДетскогоУчреждения.ЭтоГруппа
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВыборкаПоГруппам.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения
	               |ИЗ
	               |	ВыборкаПоГруппам КАК ВыборкаПоГруппам
				   |[УсловиеДоговор]";
				   
	Если Объект.РодительскаяПлатаДопУслуги = 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[РегистрСведенийНачало]", "СоставГруппДДУ.СрезПоследних(&НачалоПериода, Ребенок = &Ребенок)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[РегистрСведений]", "СоставГруппДДУ");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[РегистрСведенийОкончание]", "СоставГруппДДУ.СрезПоследних(&ОкончаниеПериода, Ребенок = &Ребенок)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[РегистрСведенийНачало]", "СоставГруппДДУДополнительныеУслуги.СрезПоследних(&НачалоПериода, Ребенок = &Ребенок)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[РегистрСведений]", "СоставГруппДДУДополнительныеУслуги");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[РегистрСведенийОкончание]", "СоставГруппДДУДополнительныеУслуги.СрезПоследних(&ОкончаниеПериода, Ребенок = &Ребенок)");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Договор) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[УсловиеДоговор]", "ГДЕ ВыборкаПоГруппам.Договор = &Договор");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[УсловиеДоговор]", "");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Объект.НачалоПериода));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(Объект.КонецПериода));
	Запрос.УстановитьПараметр("Ребенок", Ребенок);
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() > 0 Тогда
		Отбор.Вставить("СписокГрупп", Результат.ВыгрузитьКолонку("ГруппаДетскогоУчреждения"));
	КонецЕсли;
КонецПроцедуры

