&НаКлиенте
Процедура НачисленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ГруппыДетскогоУчреждения") Тогда
		ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
		
		ТекущаяСтрока.ГруппаДетскогоУчреждения = ВыбранноеЗначение;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачисленияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
	
	Если Не НоваяСтрока И ТекущаяСтрока.Подробнее <> ТекстКолонкиПодробнее(Ложь) Тогда
		ЗапомнитьСтроку(ТекущаяСтрока.НомерСтроки);
	КонецЕсли;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекущаяСтрока.НачалоПериода 			= Объект.НачалоПериода;               
		ТекущаяСтрока.КонецПериода 				= Объект.КонецПериода;
		ТекущаяСтрока.ДнейПосещенияПоГрафику 	= ДнейПоГрафику;
		ТекущаяСтрока.ДнейПосещенияКОплате 		= ДнейПоГрафику;
		ТекущаяСтрока.ГруппаДетскогоУчреждения  = Объект.ГруппаДетскогоУчреждения;
		
		Если Объект.УчитыватьНДС Тогда
			ТекущаяСтрока.СтавкаНДС 				= Объект.СтавкаНДС;
			ТекущаяСтрока.ПорядокВыпискиСФ 			= ПорядокВыпискиСФ;
		КонецЕсли;	

		НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущаяСтрока);
		
	КонецЕсли;
	
    Если НоваяСтрока И Копирование Тогда
		ТекущаяСтрока.ИДСтроки = "";
		ТекущаяСтрока.Подробнее = ТекстКолонкиПодробнее(Ложь);
		ТекущаяСтрока.ИдентификаторЭД = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "НачисленияПодробнее" И ТекущиеДанные.Подробнее = ТекстКолонкиПодробнее(Истина) Тогда
		СтандартнаяОбработка = Ложь;
		ОбработатьРасшифровку(ВыбраннаяСтрока);
	ИначеЕсли Поле.Имя = "НачисленияГруппаДетскогоУчреждения" Тогда
		ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Владелец", Объект.Организация);
		
		ОпределитьГруппыРебенка(Отбор, ТекущаяСтрока.Ребенок, ТекущаяСтрока.ДоговорКонтрагента);
		
		ПараметрыФормы = Новый Структура("Отбор", Отбор);
		ОткрытьФорму("Справочник.ГруппыДетскогоУчреждения.Форма.ФормаВыбора", ПараметрыФормы, Элемент);
		
	ИначеЕсли Поле.Имя = "НачисленияПередаточныйДокументЭДНаименование" Тогда
		ОткрытьПередаточныйДокументЭД(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	ИначеЕсли Поле.Имя = "НачисленияПросмотретьЭД" Тогда
		ОткрытьЭД(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачисленияПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	Если НоваяСтрока Или ОтменаРедактирования Тогда
		АдресХранилища = "";
		Возврат;
	КонецЕсли;
	
	Если АдресХранилища = "" Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.Начисления.ТекущиеДанные;
	
	Если ТекДанные.Подробнее = ТекстКолонкиПодробнее(Ложь) Тогда
		АдресХранилища = "";
		Возврат;
	КонецЕсли;
	
	Если СтрокаИзменена(ТекДанные.НомерСтроки) Тогда
		ТекстВопроса = НСтр("ru='У редактируемой строки есть данные расшифровки сложного расчета. 
								|При сохранении изменений в строке данные расшифровки будут утеряны.
								|Продолжить?'");
								
		ДопПараметры = Новый Структура("ТекДанные, АдресХранилища", ТекДанные, АдресХранилища);
		Оповещение = Новый ОписаниеОповещения("ВопросОбУдаленииДанныхРасшифровка", ЭтотОбъект, ДопПараметры);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет,
			НСтр("ru = 'Внимание'"), КодВозвратаДиалога.Нет);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачисленияПередУдалением(Элемент, Отказ)
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	Если ТекущиеДанные.Подробнее = ТекстКолонкиПодробнее(Ложь) Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	ТекстВопроса = НСтр("ru='Удаляемая строка имеет данные расшифровки сложного расчета. 
							|При удалении строки данные расшифровки будут утеряны.
							|Продолжить?'");
							
	ДопПараметры = Новый Структура("ТекущиеДанные", ТекущиеДанные);
	Оповещение = Новый ОписаниеОповещения("ВопросПередУдалениемСтрокиСРасшифровкой", ЭтотОбъект, ДопПараметры);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет,
		НСтр("ru = 'Внимание'"), КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаКлиенте
Процедура НачисленияПослеУдаления(Элемент)
	Если ЗначениеЗаполнено(АдресХранилища) Тогда
		Структура = ПолучитьИзВременногоХранилища(АдресХранилища);
		МассивСтрок = Объект.РасшифровкаНачисления.НайтиСтроки(Структура);
	
		Для Каждого Строка Из МассивСтрок Цикл
			Объект.РасшифровкаНачисления.Удалить(Строка);
		КонецЦикла;
	
		УстановитьВидимостьРасшифровки(ЭтотОбъект);
		ЗаполнитьГиперссылками();
	КонецЕсли;
	
	АдресХранилища = "";
КонецПроцедуры

&НаКлиенте
Процедура НачисленияРебенокНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("ГруппаДетскогоУчреждения",
		?(ЗначениеЗаполнено(ТекущаяСтрока.ГруппаДетскогоУчреждения),
			ТекущаяСтрока.ГруппаДетскогоУчреждения,
			Объект.ГруппаДетскогоУчреждения));
	ПараметрыФормы.Вставить("НаДату", НачалоДня(Объект.НачалоПериода));

	Если ЗначениеЗаполнено(ТекущаяСтрока.Ребенок) Тогда
		ПараметрыФормы.Вставить("ТекущаяСтрока", ТекущаяСтрока.Ребенок);
	КонецЕсли;
	
	Если Объект.РодительскаяПлатаДопУслуги = 0 Тогда
		ОткрытьФорму("Справочник.Дети.Форма.ФормаВыбора", ПараметрыФормы, Элемент);
	Иначе
		ОткрытьФорму("Справочник.Дети.Форма.ФормаВыбораДопУслуги", ПараметрыФормы, Элемент);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачисленияРебенокОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	РебенокВСтроке = ТекущиеДанные.Ребенок;
		
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, ВыбранноеЗначение);
		ВыбранноеЗначение = ТекущиеДанные.Ребенок;
	КонецЕсли;
		
	Если РебенокВСтроке <> ВыбранноеЗначение Тогда
		ТекущиеДанные.Контрагент = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		ТекущиеДанные.ДоговорКонтрагента = ПредопределенноеЗначение("Справочник.Договоры.ПустаяСсылка");
	КонецЕсли;

КонецПроцедуры

