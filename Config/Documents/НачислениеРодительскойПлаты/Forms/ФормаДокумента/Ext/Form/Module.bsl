		ПоказатьВопрос(Оповещение,
					   НСтр("ru='Для всех строк будет установлена выбранная ставка оплаты.
					            |Данные расшифровок сложного расчета будут удалены.
								|
								|Продолжить?'"),
					   РежимДиалогаВопрос.ДаНет,
					   ,
					   КодВозвратаДиалога.Нет);
		Возврат;
		
	КонецЕсли;
	
