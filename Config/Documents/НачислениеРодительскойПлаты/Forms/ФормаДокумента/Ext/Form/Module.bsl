&НаКлиенте
Процедура НачисленияДоговорКонтрагентаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Начисления.ТекущиеДанные;
	ОбновитьДанныеСтрокиРебенокДоговор(ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеСтрокиРебенокДоговор(ТекущаяСтрока)
	
	Если Не (ЗначениеЗаполнено(ТекущаяСтрока.Ребенок) Или ЗначениеЗаполнено(ТекущаяСтрока.ДоговорКонтрагента)) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеРебенка = Новый Структура("ГруппаДетскогоУчреждения,СтавкаОплаты,ДнейПосещенияКОплате,Льгота,Ребенок,ДоговорКонтрагента");
	ДанныеРебенка.Ребенок = ТекущаяСтрока.Ребенок;
	ДанныеРебенка.ГруппаДетскогоУчреждения = ?(ЗначениеЗаполнено(Объект.ГруппаДетскогоУчреждения), Объект.ГруппаДетскогоУчреждения, ТекущаяСтрока.ГруппаДетскогоУчреждения);
	ДанныеРебенка.ДоговорКонтрагента = ТекущаяСтрока.ДоговорКонтрагента;
	
	Результат = ПолучитьДанныеРебенка(ДанныеРебенка);
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда	
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Результат);
	Иначе
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ДанныеРебенка);
 
		ПараметрыФормы = Новый Структура("АдресХранилища", Результат);
		ОткрытьФорму("Документ.НачислениеРодительскойПлаты.Форма.ФормаВыбораДанныхДляРасчета", ПараметрыФормы, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
	
	ЗаполнитьДанныеСтроки(ТекущаяСтрока.ПолучитьИдентификатор());
	
КонецПроцедуры

