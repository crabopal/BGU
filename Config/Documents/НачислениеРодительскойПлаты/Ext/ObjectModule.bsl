#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ДанныеЗаполнения = Неопределено Тогда
		ЗаполнитьИзДанныхЗаполнения(Новый Структура, СтандартнаяОбработка);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьИзДанныхЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КассовоеПоступление") Тогда	
		Если ДанныеЗаполнения.РодительскаяПлата Тогда
			
			ТекстЗапроса = "ВЫБРАТЬ
			               |	КассовоеПоступление.Организация КАК Организация,
			               |	КассовоеПоступление.ИФО КАК ИФО,
			               |	КассовоеПоступление.Подразделение КАК Подразделение,
			               |	НАЧАЛОПЕРИОДА(&ДатаДокументаОснования, МЕСЯЦ) КАК НачалоПериода,
			               |	КОНЕЦПЕРИОДА(&ДатаДокументаОснования, МЕСЯЦ) КАК КонецПериода,
			               |	КассовоеПоступление.Ссылка КАК ДокументОснование
			               |ИЗ
			               |	Документ.КассовоеПоступление КАК КассовоеПоступление
			               |ГДЕ
			               |	КассовоеПоступление.Ссылка = &Ссылка
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
			               |	КассовоеПоступлениеРасшифровкаПлатежа.Ребенок КАК Ребенок,
			               |	КассовоеПоступлениеРасшифровкаПлатежа.Контрагент КАК Контрагент,
			               |	КассовоеПоступлениеРасшифровкаПлатежа.Договор КАК ДоговорКонтрагента,
			               |	КассовоеПоступлениеРасшифровкаПлатежа.СуммаВал КАК Сумма,
			               |	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18) КАК СтавкаНДС,
			               |	КассовоеПоступлениеРасшифровкаПлатежа.СуммаВал * 18 / 118 КАК СуммаНДС,
			               |	ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно) КАК ПорядокВыпискиСФ,
			               |	НАЧАЛОПЕРИОДА(&ДатаДокументаОснования, МЕСЯЦ) КАК НачалоПериода,
			               |	КОНЕЦПЕРИОДА(&ДатаДокументаОснования, МЕСЯЦ) КАК КонецПериода,
			               |	СоставГруппДДУСрезПоследних.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения
			               |ИЗ
			               |	Документ.КассовоеПоступление.РасшифровкаПлатежа КАК КассовоеПоступлениеРасшифровкаПлатежа
			               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставГруппДДУ.СрезПоследних(&ДатаДокументаОснования, Актуальность = ИСТИНА) КАК СоставГруппДДУСрезПоследних
			               |		ПО КассовоеПоступлениеРасшифровкаПлатежа.Ребенок = СоставГруппДДУСрезПоследних.Ребенок
			               |			И КассовоеПоступлениеРасшифровкаПлатежа.Договор = СоставГруппДДУСрезПоследних.Договор
			               |ГДЕ
			               |	КассовоеПоступлениеРасшифровкаПлатежа.Ссылка = &Ссылка";
			
			Запрос = Новый Запрос(ТекстЗапроса);
			Запрос.УстановитьПараметр("Ссылка",ДанныеЗаполнения);
			Запрос.УстановитьПараметр("ДатаДокументаОснования",ДанныеЗаполнения.Дата);
			
			МассивРезультатов = Запрос.ВыполнитьПакет();
			Выборка = МассивРезультатов[0].Выбрать();			   
			Если Выборка.Следующий() Тогда
				ЗаполнитьЗначенияСвойств(ЭтотОбъект,Выборка);
			КонецЕсли;	
			
			Выборка = МассивРезультатов[1].Выбрать();			   
			Пока  Выборка.Следующий() Цикл
				НоваяСтрока = ЭтотОбъект.Начисления.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				
				ДниПоГрафику = РодительскаяПлата.КоличествоРабочихДнейПоГрафикуГруппы(Выборка.НачалоПериода, Выборка.КонецПериода, Выборка.ГруппаДетскогоУчреждения);
				НоваяСтрока.ДнейПосещенияПоГрафику = ДниПоГрафику;
				НоваяСтрока.ДнейПосещенияКОплате = ДниПоГрафику;		
			КонецЦикла;	
		Иначе
			СтандартнаяОбработка = Ложь;
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не УчитыватьНДС Тогда
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "СтавкаНДС");
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПроверяемыеРеквизиты, "Начисления.СтавкаНДС");
	КонецЕсли;
	
	ШаблонОшибкаДнейПосещения = НСтр("ru = 'Не заполнена колонка ""Дней посещения"" в строке %НомерСтроки% списка ""Начисления""'");
	ШаблонСуммаНДС = НСтр("ru = 'Не заполнена колонка ""Сумма НДС"" в строке %НомерСтроки% списка ""Начисления""'");
	ШаблонНачалоПериода = НСтр("ru = 'Дата начала начисления в строке %НомерСтроки% списка ""Начисления"" меньше, чем период начисления документа'");
	ШаблонКонецПериода = НСтр("ru = 'Дата конца начисления в строке %НомерСтроки% списка ""Начисления"" больше, чем период начисления документа'");
	
	ПроверитьДублиСтрокИСуществующиеНачисления(Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
    МассивИдентификаторовСтрок = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		//Если ссылка пустая, значит документ новый, устанавливаем новые идентификаторы всем строкам
		Для Каждого СтрТЧ Из Начисления Цикл
			Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки) Тогда
				СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);			
			ИначеЕсли МассивИдентификаторовСтрок.Найти(СтрТЧ.ИДСтроки)<>Неопределено Тогда
				СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			МассивИдентификаторовСтрок.Добавить(СтрТЧ.ИДСтроки);
		КонецЦикла;
	Иначе
		//Если ссылка не пустая, нужен анализ идентификаторов строк.
		//Т.к. возможна ситуация, когда строку скопировали, а исходную - удалили.
		//В этом случае нужно ранее присвоенные идентификаторы назначить новым строкам.
		Запрос = Новый Запрос("ВЫБРАТЬ
          |	НачислениеРодительскойПлатыНачисления.НомерСтроки,
          |	НачислениеРодительскойПлатыНачисления.Ребенок КАК Учащийся,
          |	НачислениеРодительскойПлатыНачисления.Контрагент,
          |	НачислениеРодительскойПлатыНачисления.ДоговорКонтрагента,
          |	НачислениеРодительскойПлатыНачисления.ИДСтроки
          |ПОМЕСТИТЬ ТекущиеНачисления
          |ИЗ
          |	&Начисления КАК НачислениеРодительскойПлатыНачисления
          |;
          |
          |////////////////////////////////////////////////////////////////////////////////
          |ВЫБРАТЬ
          |	НачислениеРодительскойПлатыНачисления.НомерСтроки,
          |	НачислениеРодительскойПлатыНачисления.Ребенок КАК Учащийся,
          |	НачислениеРодительскойПлатыНачисления.Контрагент,
          |	НачислениеРодительскойПлатыНачисления.ДоговорКонтрагента,
          |	НачислениеРодительскойПлатыНачисления.ИДСтроки
          |ПОМЕСТИТЬ ДанныеДокумента
          |ИЗ
          |	Документ.НачислениеРодительскойПлаты.Начисления КАК НачислениеРодительскойПлатыНачисления
          |ГДЕ
          |	НачислениеРодительскойПлатыНачисления.Ссылка = &Ссылка
          |;
          |
          |////////////////////////////////////////////////////////////////////////////////
          |ВЫБРАТЬ
          |	ТекущиеНачисления.НомерСтроки,
          |	ТекущиеНачисления.Учащийся,
          |	ТекущиеНачисления.Контрагент,
          |	ТекущиеНачисления.ДоговорКонтрагента,
          |	ТекущиеНачисления.ИДСтроки,
          |	ДанныеДокумента.НомерСтроки КАК НомерСтрокиИсх,
          |	ДанныеДокумента.ИДСтроки КАК ИДСтрокиИсх,
          |	ДанныеДокумента.Учащийся КАК УчащийсяИсх,
          |	ДанныеДокумента.Контрагент КАК КонтрагентИсх,
          |	ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагентаИсх
          |ПОМЕСТИТЬ СвязанныеТаблицы
          |ИЗ
          |	ТекущиеНачисления КАК ТекущиеНачисления
          |		ПОЛНОЕ СОЕДИНЕНИЕ ДанныеДокумента КАК ДанныеДокумента
          |		ПО ТекущиеНачисления.Учащийся = ДанныеДокумента.Учащийся
          |			И ТекущиеНачисления.Контрагент = ДанныеДокумента.Контрагент
          |			И ТекущиеНачисления.ДоговорКонтрагента = ДанныеДокумента.ДоговорКонтрагента
          |			И ТекущиеНачисления.ИДСтроки = ДанныеДокумента.ИДСтроки
          |;
          |
          |////////////////////////////////////////////////////////////////////////////////
          |ВЫБРАТЬ
          |	СвязанныеТаблицы.НомерСтрокиИсх,
          |	СвязанныеТаблицы.ИДСтрокиИсх,
          |	СвязанныеТаблицы.УчащийсяИсх,
          |	СвязанныеТаблицы.КонтрагентИсх,
          |	СвязанныеТаблицы.ДоговорКонтрагентаИсх
          |ПОМЕСТИТЬ СвободныеИдентификаторы
          |ИЗ
          |	СвязанныеТаблицы КАК СвязанныеТаблицы
          |ГДЕ
          |	СвязанныеТаблицы.НомерСтроки ЕСТЬ NULL 
          |;
          |
          |////////////////////////////////////////////////////////////////////////////////
          |ВЫБРАТЬ
          |	СвязанныеТаблицы.НомерСтроки КАК НомерСтроки,
          |	СвободныеИдентификаторы.ИДСтрокиИсх
          |ИЗ
          |	СвязанныеТаблицы КАК СвязанныеТаблицы
          |		ЛЕВОЕ СОЕДИНЕНИЕ СвободныеИдентификаторы КАК СвободныеИдентификаторы
          |		ПО СвязанныеТаблицы.Учащийся = СвободныеИдентификаторы.УчащийсяИсх
          |			И СвязанныеТаблицы.Контрагент = СвободныеИдентификаторы.КонтрагентИсх
          |			И СвязанныеТаблицы.ДоговорКонтрагента = СвободныеИдентификаторы.ДоговорКонтрагентаИсх
          |ГДЕ
          |	СвязанныеТаблицы.НомерСтрокиИсх ЕСТЬ NULL
		  |	И НЕ СвободныеИдентификаторы.ИДСтрокиИсх ЕСТЬ NULL
          |
          |УПОРЯДОЧИТЬ ПО
          |	НомерСтроки
          |ИТОГИ ПО
          |	НомерСтроки");
							  
		Запрос.УстановитьПараметр("Начисления",Начисления.Выгрузить());
		Запрос.УстановитьПараметр("Ссылка",Ссылка);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Для Каждого СтрТЧ Из Начисления Цикл
			Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки) Тогда
				Если Выборка.НайтиСледующий(Новый Структура("НомерСтроки",СтрТЧ.НомерСтроки)) Тогда
					ВыборкаДетальная = Выборка.Выбрать();
					Пока ВыборкаДетальная.Следующий() Цикл
						Если МассивИдентификаторовСтрок.Найти(ВыборкаДетальная.ИДСтрокиИсх) = Неопределено Тогда
							СтрТЧ.ИДСтроки = ВыборкаДетальная.ИДСтрокиИсх;						
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки) Тогда							
					СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
				КонецЕсли;
			ИначеЕсли МассивИдентификаторовСтрок.Найти(СтрТЧ.ИДСтроки)<>Неопределено Тогда
				СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			МассивИдентификаторовСтрок.Добавить(СтрТЧ.ИДСтроки);
		КонецЦикла;
	КонецЕсли;
	
	СуммаДокумента = Начисления.Итог("Всего");
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Для Каждого СтрТЧ Из Начисления Цикл
		СтрТЧ.ИДСтроки = "";
	КонецЦикла;
	
	Для Каждого СтрТЧ Из РасшифровкаНачисления Цикл
		СтрТЧ.ИДСтроки = "";
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьИзДанныхЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "Дата", ОбщегоНазначенияБГУ.РабочаяДатаПользователя());
	КонецЕсли;
	
	НачалоПериода = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "НачалоПериода", НачалоМесяца(Дата));
	КонецПериода  = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "КонецПериода",  КонецМесяца(Дата));
	
	РасчетЗаНесколькоМесяцев = НачалоМесяца(НачалоПериода) <> НачалоМесяца(КонецПериода);

КонецПроцедуры

Процедура ПроверитьДублиСтрокИСуществующиеНачисления(Отказ)
	
	ШаблонТекстДублей = НСтр("ru = 'Для ребенка %1 в периоде с %2 по %3 повторяется начисление по группе ""%4""'");
	ШаблонТекстНачислений = НСтр("ru = 'Для ребенка %1 уже есть начисление в периоде с %2 по %3 и ставке ""%4""'");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	ТаблицаНачислений.НомерСтроки,
	|	ТаблицаНачислений.Ребенок КАК Ребенок,
	|	ТаблицаНачислений.НачалоПериода КАК ПериодНачисленияНачало,
	|	ТаблицаНачислений.КонецПериода КАК ПериодНачисленияКонец,
	|	ТаблицаНачислений.ГруппаДетскогоУчреждения
	|ПОМЕСТИТЬ ТаблицаНачислений
	|ИЗ
	|	&ТаблицаНачислений КАК ТаблицаНачислений
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ребенок,
	|	ПериодНачисленияНачало,
	|	ПериодНачисленияКонец,
	|   ГруппаДетскогоУчреждения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ТаблицаНачислений.НомерСтроки) КАК НомерСтроки,
	|	ТаблицаНачислений.Ребенок,
	|	ТаблицаНачислений.ПериодНачисленияНачало,
	|	ТаблицаНачислений.ПериодНачисленияКонец,
	|	ТаблицаНачислений.ГруппаДетскогоУчреждения
	|ИЗ
	|	ТаблицаНачислений КАК ТаблицаНачислений
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаНачислений.Ребенок,
