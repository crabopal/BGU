#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.НачислениеРодительскойПлаты";
	КомандаПечати.Идентификатор = "ПФ_MXL_ВедомостьПоРасчетамСРодителями";
	КомандаПечати.Представление = Нстр("ru='Ведомость по расчетам с родителями'");
	КомандаПечати.Порядок = 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.НачислениеРодительскойПлаты";
	КомандаПечати.Идентификатор = "АктОбОказанииУслуг";
	КомандаПечати.Представление = "Акт об оказании услуг";
	КомандаПечати.Порядок = 2;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Проверяем, нужно ли для макета формировать табличный документ.
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ВедомостьПоРасчетамСРодителями") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_ВедомостьПоРасчетамСРодителями",
			"Ведомость по расчетам с родителями",
			ПечатьВедомостиПоРасчетамСРодителями(МассивОбъектов, ОбъектыПечати));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктОбОказанииУслуг") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"АктОбОказанииУслуг",
															"Акт об оказании услуг",
															ПечатьАктаОбОказанииУслуг(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;

КонецПроцедуры

// Функция формирует табличный документ с печатной формой ведомости по расчетам с родителями
// за содержание детей в детских учреждениях (форма 327)
//
// Возвращаемое значение:
//  Табличный документ - печатная форма ведомости по расчетам с родителями
//
Функция ПечатьВедомостиПоРасчетамСРодителями(МассивОбъектов, ОбъектыПечати) 
	
	УчетПоИФО 				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	УчетПоПодразделениям	= ПризнакУчетаПоПодразделениям();
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ПолеСлева           = 0;
	ТабДокумент.ПолеСправа          = 0;
	ТабДокумент.ОриентацияСтраницы  = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_РП_Начисление_ВедомостьПоРасчетамСРодителями";

	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.НачислениеРодительскойПлаты.ПФ_MXL_ВедомостьПоРасчетамСРодителями");
	
	ПервыйДокумент = Истина;
	Для Каждого Ссылка Из МассивОбъектов Цикл
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент  	= Ложь;
		НомерСтрокиНачало 	= ТабДокумент.ВысотаТаблицы + 1;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисление.Номер,
	|	Начисление.Дата,
	|	Начисление.Организация,
	|	Начисление.ГруппаДетскогоУчреждения,
	|	Начисление.УчитыватьНДС,
	|	Начисление.СуммаВключаетНДС,
	|	Начисление.Организация.Представление КАК ПредставлениеОрганизации,
	|	Начисление.Организация.КодОКПО КАК КодПоОКПО,
	|	Начисление.ГруппаДетскогоУчреждения.Представление КАК ПредставлениеПодразделения,
	|	Начисление.НачалоПериода,
	|	Начисление.ИФО,
	|	Начисление.Подразделение
	|ИЗ
	|	Документ.НачислениеРодительскойПлаты КАК Начисление
	|ГДЕ
	|	Начисление.Ссылка = &ТекущийДокумент";
	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК СчетЕПСБУ
		|ПОМЕСТИТЬ СчетаРасчетов
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				Выборка.Ссылка
		|			ИЗ
		|				ПланСчетов.ЕПСБУ КАК Выборка
		|			ГДЕ
		|				(Выборка.Код = ""205.30""
		|					ИЛИ Выборка.Код = ""205.55""
		|					ИЛИ Выборка.Код = ""205.80""))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетЕПСБУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК СчетЕПСБУ
		|ПОМЕСТИТЬ СчетаАвансов
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				Выборка.Ссылка
		|			ИЗ
		|				ПланСчетов.ЕПСБУ КАК Выборка
		|			ГДЕ
		|				(Выборка.Код = ""205.3А""
		|					ИЛИ Выборка.Код = ""205.8А""))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетЕПСБУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК СчетЕПСБУ
		|ПОМЕСТИТЬ СчетаДенежныхСредств
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				Выборка.Ссылка
		|			ИЗ
		|				ПланСчетов.ЕПСБУ КАК Выборка
		|			ГДЕ
		|				(Выборка.Код = ""201.11""
		|					ИЛИ Выборка.Код = ""201.21""
		|					ИЛИ Выборка.Код = ""201.34""
		|					ИЛИ Выборка.Код = ""210.02""
		|					ИЛИ Выборка.Код = ""105.00""
		|					ИЛИ Выборка.Код = ""303.05""
		|					ИЛИ Выборка.Код = ""304.05""))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетЕПСБУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РП_Начисление.Ребенок,
		|	РП_Начисление.Ребенок.Контрагент КАК Контрагент,
		|	РП_Начисление.ДоговорКонтрагента,
		|	Плательщики.Плательщик
		|ПОМЕСТИТЬ
		|	ВТ_Плательщики
		|ИЗ
		|	Документ.НачислениеРодительскойПлаты.Начисления КАК РП_Начисление
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлательщикиПоУслугамДДУ.СрезПоследних(
		|				&ДатаКонца,
		|				Ребенок В
		|					(ВЫБРАТЬ
		|						Т1.Ребенок
		|					ИЗ
		|						Документ.НачислениеРодительскойПлаты.Начисления КАК Т1
		|					ГДЕ
		|						Т1.Ссылка = &ТекущийДокумент)) КАК Плательщики
		|		ПО РП_Начисление.Ребенок = Плательщики.Ребенок
		|ГДЕ
		|	РП_Начисление.Ссылка = &ТекущийДокумент;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(Обороты.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
		|	ВЫРАЗИТЬ(Обороты.Субконто2 КАК Справочник.Договоры) КАК Договор,
		|	Обороты.СуммаОборотКт КАК Оплата,
		|	Обороты.Организация КАК Организация,
		|	Обороты.Период КАК ДатаОплаты
		|ПОМЕСТИТЬ ВТ_ВсеОплаты
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
		|			&ДатаНачала,
		|			&ДатаКонца,
		|			Регистратор,
		|			Счет В
		|				(ВЫБРАТЬ
		|					СЧЕТАРАСЧЕТОВ.СчетЕПСБУ
		|				ИЗ
		|					СЧЕТАРАСЧЕТОВ),
		|			,
		|			Организация = &Учреждение
		|				И ВЫРАЗИТЬ(Субконто1 КАК Справочник.Контрагенты) В
		|					(ВЫБРАТЬ
		|						ВТ_Плательщики.Контрагент
		|					ИЗ
		|						ВТ_Плательщики)
		|				И ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры) В
		|					(ВЫБРАТЬ
		|						ВТ_Плательщики.ДоговорКонтрагента
		|					ИЗ
		|						ВТ_Плательщики),
		|			,
		|			) КАК Обороты
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(Обороты.Регистратор) <> ТИП(Документ.ЗакрытиеГодаТехнологическое)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(СторноАвансов.Субконто1 КАК Справочник.Контрагенты),
		|	ВЫРАЗИТЬ(СторноАвансов.Субконто2 КАК Справочник.Договоры),
		|	-СторноАвансов.СуммаОборотДт,
		|	СторноАвансов.Организация,
		|	СторноАвансов.Период
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
		|			&ДатаНачала,
		|			&ДатаКонца,
		|			Регистратор,
		|			Счет В
		|				(ВЫБРАТЬ
		|					СчетаАвансов.СчетЕПСБУ
		|				ИЗ
		|					СчетаАвансов),
		|			,
		|			Организация = &Учреждение
		|				И ВЫРАЗИТЬ(Субконто1 КАК Справочник.Контрагенты) В
		|					(ВЫБРАТЬ
		|						ВТ_Плательщики.Контрагент
		|					ИЗ
		|						ВТ_Плательщики)
		|				И ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры) В
		|					(ВЫБРАТЬ
		|						ВТ_Плательщики.ДоговорКонтрагента
		|					ИЗ
		|						ВТ_Плательщики),
		|			КорСчет В
		|				(ВЫБРАТЬ
		|					СЧЕТАРАСЧЕТОВ.СчетЕПСБУ
		|				ИЗ
		|					СЧЕТАРАСЧЕТОВ),
		|			) КАК СторноАвансов
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ВозвратОплаты.Субконто1 КАК Справочник.Контрагенты),
		|	ВЫРАЗИТЬ(ВозвратОплаты.Субконто2 КАК Справочник.Договоры),
		|	-ВозвратОплаты.СуммаОборотДт,
		|	ВозвратОплаты.Организация,
		|	ВозвратОплаты.Период
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
		|			&ДатаНачала,
		|			&ДатаКонца,
		|			Регистратор,
		|			Счет В
		|				(ВЫБРАТЬ
		|					СЧЕТАРАСЧЕТОВ.СчетЕПСБУ
		|				ИЗ
		|					СЧЕТАРАСЧЕТОВ),
		|			,
		|			Организация = &Учреждение
		|				И ВЫРАЗИТЬ(Субконто1 КАК Справочник.Контрагенты) В
		|					(ВЫБРАТЬ
		|						ВТ_Плательщики.Контрагент
		|					ИЗ
		|						ВТ_Плательщики)
		|				И ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры) В
		|					(ВЫБРАТЬ
		|						ВТ_Плательщики.ДоговорКонтрагента
		|					ИЗ
		|						ВТ_Плательщики),
		|			КорСчет В
		|				(ВЫБРАТЬ
		|					СчетаДенежныхСредств.СчетЕПСБУ
		|				ИЗ
		|					СчетаДенежныхСредств),
		|			) КАК ВозвратОплаты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ВсеОплаты.Контрагент,
		|	ВТ_ВсеОплаты.Договор,
		|	СУММА(ВТ_ВсеОплаты.Оплата) КАК Оплата,
		|	ВТ_ВсеОплаты.Организация,
		|	ВТ_ДатыОплаты.ДатаОплаты
		|ПОМЕСТИТЬ ВТ_Оплаты
		|ИЗ
		|	ВТ_ВсеОплаты КАК ВТ_ВсеОплаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_ВсеОплаты.Контрагент КАК Контрагент,
		|			ВТ_ВсеОплаты.Договор КАК Договор,
		|			ВТ_ВсеОплаты.Организация КАК Организация,
		|			МАКСИМУМ(ВТ_ВсеОплаты.ДатаОплаты) КАК ДатаОплаты
		|		ИЗ
		|			ВТ_ВсеОплаты КАК ВТ_ВсеОплаты
		|		СГРУППИРОВАТЬ ПО
		|			ВТ_ВсеОплаты.Контрагент,
		|			ВТ_ВсеОплаты.Договор,
		|			ВТ_ВсеОплаты.Организация) КАК ВТ_ДатыОплаты
		|		ПО ВТ_ВсеОплаты.Контрагент = ВТ_ДатыОплаты.Контрагент
		|			И ВТ_ВсеОплаты.Договор = ВТ_ДатыОплаты.Договор
		|			И ВТ_ВсеОплаты.Организация = ВТ_ДатыОплаты.Организация
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ВсеОплаты.Контрагент,
		|	ВТ_ВсеОплаты.Договор,
		|	ВТ_ВсеОплаты.Организация,
		|	ВТ_ДатыОплаты.ДатаОплаты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РП_Начисление.НомерСтроки КАК НомерСтроки,
		|	РП_Начисление.Ребенок,
		|	РП_Начисление.Контрагент,
		|	РП_Начисление.Ребенок.Код КАК НомерЛицевогоСчета,
		|	РП_Начисление.ДоговорКонтрагента КАК Договор,
		|	РП_Начисление.СтавкаОплаты КАК СтавкаОплаты,
		|	РП_Начисление.Льгота КАК Льгота,
		|	ВЫБОР
		|		КОГДА НЕ РП_Начисление.СтавкаОплаты.ЭтоФиксированнаяСтавкаЗаПериод ТОГДА
		|			РП_Начисление.СтавкаОплаты.СуммаФиксированнаяСтавкаЗаМесяц * (1 - ЕстьNull(РП_Начисление.Льгота.ПроцентЛьготы,0) / 100) 
		|		ИНАЧЕ 
		|			ВЫБОР
		|				КОГДА (ДЕНЬ(&ДатаКонца) - ДЕНЬ(&ДатаНачала) + 1) <> ДЕНЬ(КОНЕЦПЕРИОДА(&ДатаКонца, МЕСЯЦ)) ТОГДА
		|					СтавкиОплатыФиксированная.СуммаНачисления / ДЕНЬ(КОНЕЦПЕРИОДА(&ДатаКонца, МЕСЯЦ)) * (ДЕНЬ(&ДатаКонца) - ДЕНЬ(&ДатаНачала) + 1)
		|				ИНАЧЕ
		|					СтавкиОплатыФиксированная.СуммаНачисления
		|			КОНЕЦ
		|	КОНЕЦ КАК ФиксированнаяЧасть,
		|	ВЫБОР
		|		КОГДА НЕ РП_Начисление.СтавкаОплаты.ЭтоФиксированнаяСтавкаЗаПериод ТОГДА
		|			РП_Начисление.СтавкаОплаты.СуммаПеременнаяСтавкаЗаМесяц * (1 - ЕстьNull(РП_Начисление.Льгота.ПроцентЛьготы,0) / 100) 
		|		ИНАЧЕ 0 
		|	КОНЕЦ КАК ПеременнаяЧасть,
		|	ВЫБОР
		|		КОГДА НЕ РП_Начисление.СтавкаОплаты.ЭтоФиксированнаяСтавкаЗаПериод ТОГДА
		|			РП_Начисление.СтавкаОплаты.СуммаСтавкаЗаДень * РП_Начисление.ДнейПосещенияКОплате * (1 - ЕстьNull(РП_Начисление.Льгота.ПроцентЛьготы,0) / 100) 
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаПоСтавкеЗаДень,
		|	РП_Начисление.ДнейПосещенияКОплате КАК ДнейПосещения,
		|	РП_Начисление.Сумма,
		|	РП_Начисление.СуммаНДС,
		|	ЕСТЬNULL(ВТ_Оплаты.Оплата, 0) КАК Оплата,
		|	ЕСТЬNULL(ВТ_Оплаты.ДатаОплаты, ДАТАВРЕМЯ(1,1,1,0,0,0)) КАК ДатаОплаты,
		|	ЕСТЬNULL(ЕПСБУОстаткиНачало.СуммаОстаток, 0) КАК ОстатокНаНачало,
		|	ЕСТЬNULL(ЕПСБУОстаткиКонец.СуммаОстаток, 0) КАК ОстатокНаКонец
		|ИЗ
		|	Документ.НачислениеРодительскойПлаты.Начисления КАК РП_Начисление
		|		ЛЕВОЕ СОЕДИНЕНИЕ
		|			Справочник.СтавкиОплатыОбразование.ПорядокНачисления КАК СтавкиОплатыФиксированная
		| 		ПО
		|			РП_Начисление.СтавкаОплаты = СтавкиОплатыФиксированная.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_Плательщики.*
		|		ИЗ
		|			ВТ_Плательщики) КАК Плательщики
		|		ПО
		|			РП_Начисление.Ребенок = Плательщики.Ребенок
		|";
				
		ТекстЗапроса =  ТекстЗапроса + "
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|				&ДатаНачала,
		|				Счет В
		|					(ВЫБРАТЬ
		|						СчетаРасчетов.СчетЕПСБУ
		|					ИЗ
		|						СчетаРасчетов),
		|				,
		|				Организация = &Учреждение ";
		Если УчетПоИФО Тогда
			ТекстЗапроса =  ТекстЗапроса + "
			|				И ИФО = &ИФО  ";
		КонецЕсли;
		Если УчетПоПодразделениям Тогда
			ТекстЗапроса =  ТекстЗапроса + "
			|				И Подразделение = &Подразделение ";
		КонецЕсли;
		
		ТекстЗапроса =  ТекстЗапроса + "
		|					) КАК ЕПСБУОстаткиНачало
		|		ПО (РП_Начисление.Контрагент = (ВЫРАЗИТЬ(ЕПСБУОстаткиНачало.Субконто1 КАК Справочник.Контрагенты)))
		|			И (РП_Начисление.ДоговорКонтрагента = (ВЫРАЗИТЬ(ЕПСБУОстаткиНачало.Субконто2 КАК Справочник.Договоры)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(
		|				&ДатаНачала,
		|				&ДатаКонца,
		|				,
		|				НЕ СчетДт В
		|						(ВЫБРАТЬ
		|							СчетаАвансов.СчетЕПСБУ
		|						ИЗ
		|							СчетаАвансов),
		|				,
		|				СчетКт В
		|					(ВЫБРАТЬ
		|						СчетаРасчетов.СчетЕПСБУ
		|					ИЗ
		|						СчетаРасчетов),
		|				,
		|				Организация = &Учреждение ";
		Если УчетПоИФО Тогда
			ТекстЗапроса =  ТекстЗапроса + "
			|				И ИФО = &ИФО  ";
		КонецЕсли;
		Если УчетПоПодразделениям Тогда
			ТекстЗапроса =  ТекстЗапроса + "
			|				И ПодразделениеКт = &Подразделение ";
		КонецЕсли;
		
	 	ТекстЗапроса =  ТекстЗапроса + "
		|					) КАК ЕПСБУОборотыДтКт
		|		ПО (РП_Начисление.Контрагент = (ВЫРАЗИТЬ(ЕПСБУОборотыДтКт.СубконтоКт1 КАК Справочник.Контрагенты)))
		|			И (РП_Начисление.ДоговорКонтрагента = (ВЫРАЗИТЬ(ЕПСБУОборотыДтКт.СубконтоКт2 КАК Справочник.Договоры)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			МИНИМУМ(ЕПСБУОборотыДтКт.Период) КАК МинимальнаяДатаОплаты,
		|			ВЫРАЗИТЬ(ЕПСБУОборотыДтКт.СубконтоКт1 КАК Справочник.Контрагенты) КАК Контрагент,
		|			ВЫРАЗИТЬ(ЕПСБУОборотыДтКт.СубконтоКт2 КАК Справочник.Договоры) КАК Договор
		|		ИЗ
		|			РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(
		|					&ДатаНачала,
		|					&ДатаКонца,
		|					День,
		|					НЕ СчетДт В
		|							(ВЫБРАТЬ
		|								СчетаАвансов.СчетЕПСБУ
		|							ИЗ
		|								СчетаАвансов),
		|					,
		|					СчетКт В
		|						(ВЫБРАТЬ
		|							СчетаРасчетов.СчетЕПСБУ
		|						ИЗ
		|							СчетаРасчетов),
		|					,
		|					Организация = &Учреждение) КАК ЕПСБУОборотыДтКт
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ЕПСБУОборотыДтКт.СубконтоКт1,
		|			ЕПСБУОборотыДтКт.СубконтоКт2) КАК ОборотыПоДням
		|		ПО РП_Начисление.Контрагент = ОборотыПоДням.Контрагент
		|			И РП_Начисление.ДоговорКонтрагента = ОборотыПоДням.Договор
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|				&ГраницаПериода,
		|				Счет В
		|					(ВЫБРАТЬ
		|						СчетаРасчетов.СчетЕПСБУ
		|					ИЗ
		|						СчетаРасчетов),
		|				,
		|				Организация = &Учреждение ";
		Если УчетПоИФО Тогда
			ТекстЗапроса =  ТекстЗапроса + "
			|				И ИФО = &ИФО  ";
		КонецЕсли;
		Если УчетПоПодразделениям Тогда
			ТекстЗапроса =  ТекстЗапроса + "
			|				И Подразделение = &Подразделение ";
		КонецЕсли;
		
		ТекстЗапроса =  ТекстЗапроса + "
		|					) КАК ЕПСБУОстаткиКонец
		|		ПО (РП_Начисление.Контрагент = (ВЫРАЗИТЬ(ЕПСБУОстаткиКонец.Субконто1 КАК Справочник.Контрагенты)))
		|			И (РП_Начисление.ДоговорКонтрагента = (ВЫРАЗИТЬ(ЕПСБУОстаткиКонец.Субконто2 КАК Справочник.Договоры)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Оплаты 
		|		ПО РП_Начисление.Контрагент = ВТ_Оплаты.Контрагент
		| 		И РП_Начисление.ДоговорКонтрагента = ВТ_Оплаты.Договор
		| 		И РП_Начисление.Ссылка.Организация = ВТ_Оплаты.Организация
		|ГДЕ
		|	РП_Начисление.Ссылка = &ТекущийДокумент
		|	И НАЧАЛОПЕРИОДА(&ДатаНачала) =
		|		ВЫБОР
		|			КОГДА РП_Начисление.СтавкаОплаты.ЭтоФиксированнаяСтавкаЗаПериод ТОГДА
		|				НАЧАЛОПЕРИОДА(СтавкиОплатыФиксированная.ПериодНачисления, МЕСЯЦ)
		|		ИНАЧЕ
		|			НАЧАЛОПЕРИОДА(&ДатаНачала)
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	Запрос = Новый Запрос(ТекстЗапроса);
	
	ДатаКон = КонецМесяца(Шапка.НачалоПериода);
	ГраницаПериода = Новый Граница (ДатаКон,ВидГраницы.Включая);
	Запрос.УстановитьПараметр("ТекущийДокумент",        Ссылка);
	Запрос.УстановитьПараметр("ДатаНачала",             НачалоМесяца(Шапка.НачалоПериода));
	Запрос.УстановитьПараметр("ДатаКонца",              ДатаКон);
	Запрос.УстановитьПараметр("ГраницаПериода",         ГраницаПериода);
	Запрос.УстановитьПараметр("Учреждение",             Шапка.Организация);
	Запрос.УстановитьПараметр("ИФО",                  	Шапка.ИФО);
	Запрос.УстановитьПараметр("Подразделение", 			Шапка.Подразделение);
	Запрос.УстановитьПараметр("ДатаДок",                Шапка.Дата);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	ДатаСведений = КонецМесяца(Шапка.Дата);
	
	ОргБухгалтер      = Корреспонденты.ФИОПоОбъекту(Ссылка.ГлБухгалтер, Истина);
	
	// Выводим заголовок
	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакета.Параметры.Заполнить(Шапка);
	ОбластьМакета.Параметры.ОписаниеПериода      = Формат(КонецМесяца(Шапка.Дата), "ДФ='MMMM yyyy'")+" г.";
	ОбластьМакета.Параметры.ДатаКонцаПериода     = Формат(ДатаСведений, "ДЛФ=Д");
	ТабДокумент.Вывести(ОбластьМакета);
	
	// Выводим таблицу
	ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабДокумент.Вывести(ОбластьМакета);
	
	ИтогоСуммаКвитанции = 0;
	ИтогоНачислено      = 0;
	ИтогоОплата       	= 0;
	ИтогоНедоплата      = 0;
	ИтогоПереплата      = 0;
	ИтогоДнейПосещения  = 0;
	
	Для Каждого Строка Из Таблица Цикл
		
		Если Не Шапка.УчитыватьНДС Тогда
			Начислено = Строка.Сумма;
		Иначе
			Начислено = Строка.Сумма + ?(Шапка.СуммаВключаетНДС, 0, Строка.СуммаНДС);
		КонецЕсли;
		Оплата      = Строка.Оплата;
		Недоплата     = 0;
		Переплата     = 0;
		Разница      = Строка.ОстатокНаКонец;
		Если Разница  < 0 Тогда
			Переплата = - Разница;
		Иначе
			Недоплата = Разница;
		КонецЕсли;
		
		ОбластьМакета = Макет.ПолучитьОбласть("Строка");
		ОбластьМакета.Параметры.Заполнить(Строка);
		ОбластьМакета.Параметры.Ребенок             = Строка(Строка.Ребенок) + Символы.ПС + " л/с "+Строка.НомерЛицевогоСчета;
		ОбластьМакета.Параметры.Начислено           = Начислено;
		ОбластьМакета.Параметры.Недоплата           = Недоплата;
		ОбластьМакета.Параметры.Переплата           = Переплата;
		ОбластьМакета.Параметры.Оплата				= Оплата;
		ТабДокумент.Вывести(ОбластьМакета);
		
		ИтогоНачислено      = ИтогоНачислено + Начислено;
		ИтогоНедоплата      = ИтогоНедоплата + Недоплата;
		ИтогоПереплата      = ИтогоПереплата + Переплата;
		ИтогоОплата			= ИтогоОплата	 + Оплата;
		ИтогоДнейПосещения  = ИтогоДнейПосещения+ Строка.ДнейПосещения;
	КонецЦикла;
	
	// Выводим итоги
	ОбластьМакета = Макет.ПолучитьОбласть("ОбщиеИтоги");
	ОбластьМакета.Параметры.ИтогоНачислено      = ИтогоНачислено;
	ОбластьМакета.Параметры.ИтогоНедоплата      = ИтогоНедоплата;
	ОбластьМакета.Параметры.ИтогоПереплата      = ИтогоПереплата;
	ОбластьМакета.Параметры.ИтогоОплата			= ИтогоОплата;
	ОбластьМакета.Параметры.ИтогоДнейПосещения  = ИтогоДнейПосещения;
	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	ОбластьМакета.Параметры.ОргБухгалтер = ОргБухгалтер;
	ТабДокумент.Вывести(ОбластьМакета);
	
	УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент,
		НомерСтрокиНачало, ОбъектыПечати, Ссылка);
		
	КонецЦикла;
	
	Возврат ТабДокумент;

КонецФункции

Функция ПечатьАктаОбОказанииУслуг(МассивОбъектов, ОбъектыПечати);
	
	РебенокИлиПлательщик = Константы.КонтрагентВАктеОбОказанииУслугНачисленияРодПлаты.Получить();
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_АктВыполненныхУслуг");
	ОбластьШапка 	= Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок 	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьСтрока 	= Макет.ПолучитьОбласть("Строка");
	ОбластьИтоги 	= Макет.ПолучитьОбласть("Итоги");
	ОбластьПодвал 	= Макет.ПолучитьОбласть("Подвал");
	
	МассивДляПроверки = Новый Массив;
	МассивДляПроверки.Добавить(ОбластьИтоги);
	МассивДляПроверки.Добавить(ОбластьПодвал);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументНачисление.Ссылка.Номер КАК НомерНачисления,
	|	ДокументНачисление.Ссылка КАК Начисление,
	|	ДокументНачисление.Ссылка КАК ДокументОснование,
	|	ДокументНачисление.Ссылка.Организация КАК Организация,
	|	ДокументНачисление.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА ДокументНачисление.Ссылка.Организация.НаименованиеПолное = """"
	|			ТОГДА ДокументНачисление.Ссылка.Организация.Наименование
	|		ИНАЧЕ ДокументНачисление.Ссылка.Организация.НаименованиеПолное
	|	КОНЕЦ + "" ИНН "" + ДокументНачисление.Ссылка.Организация.ИНН + "" КПП "" + ДокументНачисление.Ссылка.Организация.КПП КАК пНаименованиеОрганизации,
	|	ВЫБОР
	|		КОГДА &РебенокИлиПлательщик = 0
	|			ТОГДА ДокументНачисление.Контрагент
	|		ИНАЧЕ ПараметрыКомпенсации.Плательщик
	|	КОНЕЦ КАК Контрагент,
	|	ДокументНачисление.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ДокументНачисление.Ссылка.Дата КАК пДата,
	|	ДокументНачисление.ДоговорКонтрагента.Представление КАК пДоговор,
	|	1 КАК пНом,
	|	ДокументНачисление.ГруппаДетскогоУчреждения.Номенклатура.Представление КАК пНаименование,
	|	ДокументНачисление.ГруппаДетскогоУчреждения.Номенклатура.ЕдиницаИзмерения.Представление КАК пЕдИзм,
	|	1 КАК пКоличество,
	|	ДокументНачисление.Сумма КАК пЦена,
	|	ДокументНачисление.Сумма КАК пСумма,
	|	ДокументНачисление.СуммаНДС КАК пИтогНДС,
	|	ДокументНачисление.Всего КАК пИтогСумма,
	|	ДокументНачисление.Всего КАК пИтогВсего,
	|	ВЫРАЗИТЬ(&ВалютаРегламентированногоУчета КАК Справочник.Валюты).Представление КАК пВалюта,
	|	ВЫРАЗИТЬ(&ВалютаРегламентированногоУчета КАК Справочник.Валюты) КАК ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА ДокументНачисление.НомерСтроки = 1
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК НовыйДокумент,
	|	ДокументНачисление.Ссылка.Руководитель КАК Руководитель,
	|	ДокументНачисление.ОформлятьЭД КАК ОформлятьЭД,
	|	ДокументНачисление.ИдентификаторЭД КАК ИдентификаторЭД
	|ПОМЕСТИТЬ Предварительная
	|ИЗ
	|	Документ.НачислениеРодительскойПлаты.Начисления КАК ДокументНачисление
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлательщикиПоУслугамДДУ.СрезПоследних(, ) КАК ПараметрыКомпенсации
	|		ПО ДокументНачисление.Ребенок = ПараметрыКомпенсации.Ребенок
	|ГДЕ
	|	ДокументНачисление.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Предварительная.НомерНачисления КАК НомерНачисления,
	|	Предварительная.Начисление КАК Начисление,
	|	Предварительная.ДокументОснование КАК ДокументОснование,
	|	Предварительная.Организация КАК Организация,
	|	Предварительная.пНаименованиеОрганизации КАК пНаименованиеОрганизации,
	|	Предварительная.Контрагент КАК Контрагент,
	|	Предварительная.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Предварительная.пДата КАК пДата,
	|	Предварительная.пДоговор КАК пДоговор,
	|	Предварительная.пНом КАК пНом,
	|	Предварительная.пНаименование КАК пНаименование,
	|	Предварительная.пЕдИзм КАК пЕдИзм,
	|	Предварительная.пКоличество КАК пКоличество,
	|	Предварительная.пЦена КАК пЦена,
	|	Предварительная.пСумма КАК пСумма,
	|	Предварительная.пИтогНДС КАК пИтогНДС,
	|	Предварительная.пИтогСумма КАК пИтогСумма,
	|	Предварительная.пИтогВсего КАК пИтогВсего,
	|	Предварительная.пВалюта КАК пВалюта,
	|	Предварительная.ВалютаДокумента КАК ВалютаДокумента,
	|	Предварительная.НовыйДокумент КАК НовыйДокумент,
	|	Предварительная.Руководитель КАК Руководитель,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Предварительная.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА """"
	|		КОГДА Предварительная.Контрагент.НаименованиеСокращенное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(Предварительная.Контрагент.ВидКонтрагента, ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ ЕСТЬNULL(Предварительная.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное, """") = """"
	|						ТОГДА Предварительная.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|					ИНАЧЕ Предварительная.Контрагент.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ Предварительная.Контрагент.НаименованиеСокращенное
	|	КОНЕЦ КАК КонтрагентНаименование,
	|	Предварительная.Контрагент.ИНН КАК КонтрагентИНН,
	|	Предварительная.Контрагент.КПП КАК КонтрагентКПП,
	|	Предварительная.ОформлятьЭД КАК ОформлятьЭД,
	|	Предварительная.ИдентификаторЭД КАК ИдентификаторЭД
	|ИЗ
	|	Предварительная КАК Предварительная
	|
	|УПОРЯДОЧИТЬ ПО
	|	Предварительная.НомерНачисления,
	|	Предварительная.НомерСтроки
	|ИТОГИ ПО
	|	ДокументОснование";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("РебенокИлиПлательщик", РебенокИлиПлательщик);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	
	ВыборкаОснование = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	НомерАкта = 1;
	
	Пока ВыборкаОснование.Следующий() Цикл
	
		ВыборкаШапка = ВыборкаОснование.Выбрать();
		ЗапомнитьНачалоОбласти = Истина;
		
		Пока ВыборкаШапка.Следующий() Цикл
			
			Если Не ПервыйДокумент Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			Если ВыборкаШапка.ОформлятьЭД Тогда
				// Электронные акты.
				Продолжить;
			КонецЕсли;	
			
			Если ВыборкаШапка.НовыйДокумент Тогда
				НомерАкта = 1;
			КонецЕсли;
			
			ПервыйДокумент = Ложь;
			Если ЗапомнитьНачалоОбласти Тогда
				НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
				ЗапомнитьНачалоОбласти = Ложь;
			КонецЕсли;
			
			ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
			
			АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
				Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
			ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
				Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
				
			СтруктураОбластьШапка = Новый Структура("пАдресТелефон,пЗаказчик,пДата,пНомер");
			СтруктураОбластьШапка.пАдресТелефон = АдресОрганизации
				+ ?(ПустаяСтрока(ТелефонОрганизации), "", ", тел.:"+ТелефонОрганизации);
			
			ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, Период, НаименованиеПолное, ИНН, КПП", 
				ВыборкаШапка.Контрагент, 
				ВыборкаШапка.пДата);
				
			СтруктураОбластьШапка.пЗаказчик = ВыборкаШапка.КонтрагентНаименование
				+ ?(ПустаяСтрока(ВыборкаШапка.КонтрагентИНН), "", " ИНН " + ВыборкаШапка.КонтрагентИНН)
				+ ?(ПустаяСтрока(ВыборкаШапка.КонтрагентКПП), "", " КПП " + ВыборкаШапка.КонтрагентКПП);
				
			СтруктураОбластьШапка.пДата	= Формат(ВыборкаШапка.пДата, "ДЛФ=DD");		
			СтруктураОбластьШапка.пНомер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Начисление,ВыборкаШапка.НомерНачисления) + "/" + НомерАкта;
			НомерАкта = НомерАкта + 1;
			ОбластьШапка.Параметры.Заполнить(СтруктураОбластьШапка);
			ТабличныйДокумент.Вывести(ОбластьШапка);
			
			ОбластьСтрока.Параметры.Заполнить(ВыборкаШапка);
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
			ОбластьИтоги.Параметры.Заполнить(Новый Структура("пТекстНДС",?(ВыборкаШапка.СуммаВключаетНДС, "В том числе НДС", "Итого НДС")));
			ОбластьИтоги.Параметры.Заполнить(ВыборкаШапка);
			
			ТабличныйДокумент.Вывести(ОбластьИтоги);
			СтруктураОбластьПодвал = Новый Структура("пИтогВсегоПрописью,пИтогНДСПрописью,РуководительДолжность,РуководительФИО");
			СтруктураОбластьПодвал.пИтогВсегоПрописью 	= ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ВыборкаШапка.пИтогВсего, ВыборкаШапка.ВалютаДокумента);
			СтруктураОбластьПодвал.пИтогНДСПрописью 	= ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ВыборкаШапка.пИтогНДС, ВыборкаШапка.ВалютаДокумента);
			
			ДанныеРуководителя = Новый Структура("СсылкаНаОбъект, Период, Должность", ВыборкаШапка.Руководитель, ВыборкаШапка.пДата);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеРуководителя);
			СтруктураОбластьПодвал.РуководительДолжность = ДанныеРуководителя.Должность;
			СтруктураОбластьПодвал.РуководительФИО = Справочники.Сотрудники.ФамилияИО(ВыборкаШапка.Руководитель, Истина, ВыборкаШапка.пДата);
			
			ОбластьПодвал.Параметры.Заполнить(СтруктураОбластьПодвал);
			ТабличныйДокумент.Вывести(ОбластьПодвал);
			
		КонецЦикла;
		
		// В табличном документе зададим имя области, в которую был выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаОснование.ДокументОснование);
		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПризнакУчетаПоПодразделениям()
	УчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");	
	СтруктураУчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("205.30,205.80");
	Возврат СтруктураУчета.УчетПоПодразделениям И УчетПоПодразделениям;
КонецФункции	

#КонецОбласти

#КонецОбласти

#КонецЕсли
