#Область ЗаполнениеДокумента

// Заполняет таблицу списком детей, рассчитывет суммы начислений
//
Функция ЗаполнитьИРассчитатьСуммыНачислений(ДатаНач, ДатаКон, Знач ГруппаДДУ, РодительскаяПлатаДопУслуги = 0) Экспорт
	
	Если РодительскаяПлатаДопУслуги = 0 Тогда
		ТаблицаОплат = РодительскаяПлата.СоставитьСписокДетейГруппыОсновнойОбразовательнойПрограммы(ДатаНач, ДатаКон, ГруппаДДУ);
	ИначеЕсли РодительскаяПлатаДопУслуги = 1 Тогда
		ТаблицаОплат = РодительскаяПлата.СоставитьСписокДетейГруппыДополнительнойОбразовательнойПрограммы(ДатаНач, ДатаКон, ГруппаДДУ);
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	ОписаниеТиповЧ = Новый ОписаниеТипов(Массив);
	ТаблицаОплат.Колонки.Добавить("ДнейПосещенияПоГрафику", ОписаниеТиповЧ);
	ТаблицаОплат.Колонки.Добавить("ДнейПосещенияКОплате", ОписаниеТиповЧ);
    ТаблицаОплат.Колонки.Добавить("Сумма", ОписаниеТиповЧ);

	// заполняем срок действия для измененных в течение расчетного периода данных
	
	ИзмененныеВПериоде = ТаблицаОплат.НайтиСтроки(Новый Структура("КонецПериода", Дата('00010101')));
	
	Для Каждого СтрИзменения Из ИзмененныеВПериоде Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрИзменения.ДатаВыбытия) Тогда
			
			СтрИзменения.ДатаВыбытия =  ДатаКон;
			
		КонецЕсли;	
		
		ОтборСтр = Новый Структура;
		ОтборСтр.Вставить("Ребенок", СтрИзменения.Ребенок);
		
		Если РодительскаяПлатаДопУслуги = 1 Тогда
		    ОтборСтр.Вставить("ГруппаДетскогоУчреждения", СтрИзменения.ГруппаДетскогоучреждения);
			ИмяРегистра = "СоставГруппДДУДополнительныеУслуги";
		Иначе
			ИмяРегистра = "СоставГруппДДУ";
		КонецЕсли;	

		ТекЗнач = РегистрыСведений[ИмяРегистра].СрезПервых(СтрИзменения.НачалоПериода +1, ОтборСтр);
		
		Если ТекЗнач.Количество() > 0 Тогда
			СтрИзменения.КонецПериода = Мин(ТекЗнач[0].Период - 1, СтрИзменения.ДатаВыбытия);
		Иначе
			СтрИзменения.КонецПериода = Мин(ДатаКон, СтрИзменения.ДатаВыбытия);
		КонецЕсли;	
				
	КонецЦикла;	
	
	//определяем количество рабочих дней в рассчитываемом периоде
	КалендарныйГрафикГрупп = РасчетыПоРодительскойПлате.ПолучитьКалендарныйГрафикГруппы(ГруппаДДУ, ДатаНач);
	КоличествоДней = РодительскаяПлата.ПолучитьКоличествоРабочихДнейПоКалендарю(ДатаНач, ДатаКон, 
													?(ТипЗнч(ГруппаДДУ) = Тип("СправочникСсылка.ГруппыДетскогоУчреждения"), КалендарныйГрафикГрупп, Неопределено));
			
	ТаблицаОплат.ЗаполнитьЗначения(КоличествоДней, "ДнейПосещенияПоГрафику,ДнейПосещенияКОплате"); 
	
	РодительскаяПлата.ЗаполнитьКоличествоДнейПосещений(ДатаНач, ДатаКон, ТаблицаОплат, РодительскаяПлатаДопУслуги, 
													?(ТипЗнч(ГруппаДДУ) = Тип("СправочникСсылка.ГруппыДетскогоУчреждения"), КалендарныйГрафикГрупп, Неопределено));

	Для Каждого Стр Из ТаблицаОплат Цикл
		
		Стр.Сумма = РодительскаяПлатаКлиентСервер.ПолучитьСуммуОплаты(Стр.СтавкаОплаты, Стр.ДнейПосещенияПоГрафику, Стр.ДнейПосещенияКОплате, Стр.НачалоПериода, Стр.КонецПериода, Стр.Льгота);

	КонецЦикла;
	
	Возврат ТаблицаОплат;
	
КонецФункции	

Функция РассчитатьТаблицуНачислений(Таблица) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таб.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	Таб.Ребенок КАК Ребенок,
	|	Таб.Контрагент КАК Контрагент,
	|	Таб.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Таб.СтавкаОплаты КАК СтавкаОплаты,
	|	Таб.Льгота КАК Льгота,
	|	Таб.НачалоПериода КАК НачалоПериода,
	|	Таб.КонецПериода КАК КонецПериода,
	|	Таб.ДнейПосещенияПоГрафику КАК ДнейПосещенияПоГрафику,
	|	Таб.ДнейПосещенияКОплате КАК ДнейПосещенияКОплате,
	|	Таб.Сумма КАК Сумма,
	|	Таб.СтавкаНДС КАК СтавкаНДС,
	|	Таб.СуммаНДС КАК СуммаНДС,
	|	Таб.Всего КАК Всего
	|ПОМЕСТИТЬ Таблица
	|ИЗ
	|	&Таблица КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.Контрагент КАК Контрагент,
	|	Таблица.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Таблица.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	МИНИМУМ(Таблица.НачалоПериода) КАК НачалоПериода,
	|	МАКСИМУМ(Таблица.КонецПериода) КАК КонецПериода
	|ПОМЕСТИТЬ втГруппировочныеЗаписиПериоды
	|ИЗ
	|	Таблица КАК Таблица
	|
	|СГРУППИРОВАТЬ ПО
	|	Таблица.Контрагент,
	|	Таблица.ДоговорКонтрагента,
	|	Таблица.ГруппаДетскогоУчреждения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.Контрагент КАК Контрагент,
	|	Таблица.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Таблица.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	СУММА(Таблица.ДнейПосещенияКОплате) КАК ДнейПосещенияКОплате,
	|	СУММА(Таблица.Сумма) КАК Сумма,
	|	СУММА(Таблица.СуммаНДС) КАК СуммаНДС,
	|	СУММА(Таблица.Всего) КАК Всего
	|ПОМЕСТИТЬ втГруппировочныеЗаписиСуммы
	|ИЗ
	|	Таблица КАК Таблица
	|
	|СГРУППИРОВАТЬ ПО
	|	Таблица.Контрагент,
	|	Таблица.ДоговорКонтрагента,
	|	Таблица.ГруппаДетскогоУчреждения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втГруппировочныеЗаписиПериоды.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	Таблица.Ребенок КАК Ребенок,
	|	втГруппировочныеЗаписиПериоды.Контрагент КАК Контрагент,
	|	втГруппировочныеЗаписиПериоды.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Таблица.СтавкаОплаты КАК СтавкаОплаты,
	|	Таблица.Льгота КАК Льгота,
	|	втГруппировочныеЗаписиПериоды.НачалоПериода КАК НачалоПериода,
	|	втГруппировочныеЗаписиПериоды.КонецПериода КАК КонецПериода,
	|	Таблица.ДнейПосещенияПоГрафику КАК ДнейПосещенияПоГрафику,
	|	Таблица.СтавкаНДС КАК СтавкаНДС
	|ПОМЕСТИТЬ втГруппировочныеЗаписи
	|ИЗ
	|	втГруппировочныеЗаписиПериоды КАК втГруппировочныеЗаписиПериоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ Таблица КАК Таблица
	|		ПО втГруппировочныеЗаписиПериоды.Контрагент = Таблица.Контрагент
	|			И втГруппировочныеЗаписиПериоды.ДоговорКонтрагента = Таблица.ДоговорКонтрагента
	|			И втГруппировочныеЗаписиПериоды.НачалоПериода = Таблица.НачалоПериода
	|			И втГруппировочныеЗаписиПериоды.ГруппаДетскогоУчреждения = Таблица.ГруппаДетскогоУчреждения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втГруппировочныеЗаписи.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	втГруппировочныеЗаписи.Ребенок КАК Ребенок,
	|	втГруппировочныеЗаписи.Контрагент КАК Контрагент,
	|	втГруппировочныеЗаписи.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	втГруппировочныеЗаписи.СтавкаОплаты КАК СтавкаОплаты,
	|	втГруппировочныеЗаписи.Льгота КАК Льгота,
	|	втГруппировочныеЗаписи.НачалоПериода КАК НачалоПериода,
	|	втГруппировочныеЗаписи.КонецПериода КАК КонецПериода,
	|	втГруппировочныеЗаписи.ДнейПосещенияПоГрафику КАК ДнейПосещенияПоГрафику,
	|	втГруппировочныеЗаписи.СтавкаНДС КАК СтавкаНДС,
	|	втГруппировочныеЗаписиСуммы.ДнейПосещенияКОплате КАК ДнейПосещенияКОплате,
	|	втГруппировочныеЗаписиСуммы.Сумма КАК Сумма,
	|	втГруппировочныеЗаписиСуммы.СуммаНДС КАК СуммаНДС,
	|	втГруппировочныеЗаписиСуммы.Всего КАК Всего
	|ИЗ
	|	втГруппировочныеЗаписи КАК втГруппировочныеЗаписи
	|		ЛЕВОЕ СОЕДИНЕНИЕ втГруппировочныеЗаписиСуммы КАК втГруппировочныеЗаписиСуммы
	|		ПО втГруппировочныеЗаписи.Контрагент = втГруппировочныеЗаписиСуммы.Контрагент
	|			И втГруппировочныеЗаписи.ДоговорКонтрагента = втГруппировочныеЗаписиСуммы.ДоговорКонтрагента
	|			И втГруппировочныеЗаписи.ГруппаДетскогоУчреждения = втГруппировочныеЗаписиСуммы.ГруппаДетскогоУчреждения";

	Запрос.УстановитьПараметр("Таблица", Таблица);

	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция РассчитатьТаблицуРасшифровкиНачислений(Таблица) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таб.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	Таб.Ребенок КАК Ребенок,
	|	Таб.Контрагент КАК Контрагент,
	|	Таб.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Таб.СтавкаОплаты КАК СтавкаОплаты,
	|	Таб.Льгота КАК Льгота,
	|	Таб.НачалоПериода КАК НачалоПериода,
	|	Таб.КонецПериода КАК КонецПериода,
	|	Таб.ДнейПосещенияПоГрафику КАК ДнейПосещенияПоГрафику,
	|	Таб.ДнейПосещенияКОплате КАК ДнейПосещенияКОплате,
	|	Таб.Сумма КАК Сумма,
	|	Таб.СтавкаНДС КАК СтавкаНДС,
	|	Таб.СуммаНДС КАК СуммаНДС,
	|	Таб.Всего КАК Всего
	|ПОМЕСТИТЬ Таблица
	|ИЗ
	|	&Таблица КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.Контрагент КАК Контрагент,
	|	Таблица.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Таблица.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	КОЛИЧЕСТВО(*) КАК Поле1
	|ПОМЕСТИТЬ Дубли
	|ИЗ
	|	Таблица КАК Таблица
	|
	|СГРУППИРОВАТЬ ПО
	|	Таблица.Контрагент,
	|	Таблица.ДоговорКонтрагента,
	|	Таблица.ГруппаДетскогоУчреждения
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	Таблица.Ребенок КАК Ребенок,
	|	Таблица.Контрагент КАК Контрагент,
	|	Таблица.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Таблица.СтавкаОплаты КАК СтавкаОплаты,
	|	Таблица.Льгота КАК Льгота,
	|	Таблица.НачалоПериода КАК НачалоПериода,
	|	Таблица.КонецПериода КАК КонецПериода,
	|	Таблица.ДнейПосещенияПоГрафику КАК ДнейПосещенияПоГрафику,
	|	Таблица.ДнейПосещенияКОплате КАК ДнейПосещенияКОплате,
	|	Таблица.Сумма КАК Сумма,
	|	Таблица.СтавкаНДС КАК СтавкаНДС,
	|	Таблица.СуммаНДС КАК СуммаНДС,
	|	Таблица.Всего КАК Всего
	|ИЗ
	|	Таблица КАК Таблица
	|ГДЕ
	|	Таблица.Контрагент В
	|			(ВЫБРАТЬ
	|				Дубли.Контрагент
	|			ИЗ
	|				Дубли)";
	
	Запрос.УстановитьПараметр("Таблица", Таблица);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

