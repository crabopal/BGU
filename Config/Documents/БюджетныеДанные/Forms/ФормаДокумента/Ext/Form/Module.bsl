&НаКлиенте
Процедура ЗаполнитьПоТаблицеАссигнований(Команда)
	
	Если Объект.ЛБО.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Текст = "ru = 'Будет произведена очистка таблицы ЛБО.,
				|Продолжить?'";
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьПоТаблицеАссигнованийЗавершение", ЭтотОбъект), НСтр(Текст), Режим, 0);
		
		Возврат;
		
	КонецЕсли;	
	
	ЗаполнитьЛБОПоТаблицеАссигнований();
	
КонецПроцедуры

