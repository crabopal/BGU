&НаКлиенте
Процедура ОчиститьКОСГУ_КПС()
	
	Для Каждого Стр Из Объект.Ассигнования Цикл
		Если СписокДопустимыхКОСГУ.НайтиПоЗначению(Стр.КОСГУ) = Неопределено Тогда
			Стр.КОСГУ = "";
		КонецЕсли;
		Стр.КПС = "";
	КонецЦикла;	
	
	Для Каждого Стр Из Объект.ЛБО Цикл
		Если СписокДопустимыхКОСГУ.НайтиПоЗначению(Стр.КОСГУ) = Неопределено Тогда
			Стр.КОСГУ = "";
		КонецЕсли;
		Стр.КПС = "";
	КонецЦикла;	
	
	Для Каждого Стр Из Объект.ПОФ Цикл
		Если СписокДопустимыхКОСГУ.НайтиПоЗначению(Стр.КОСГУ) = Неопределено Тогда
			Стр.КОСГУ = "";
		КонецЕсли;
		Стр.КПС = "";
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПолучитьУчетнуюПолитику(Организация, Дата)
	Возврат ПлатежноРасчетныеДокументыПовтИсп.ПолучитьУчетнуюПолитикуОрганизации(Организация,Дата);
КонецФункции	

&НаКлиенте
Процедура УстановитьБюджетныеПолномочия()
	
	Элементы.ВидДанных.СписокВыбора.Очистить();
	Если УчетнаяПолитика.ПолномочияПБС ИЛИ УчетнаяПолитика.ПолномочияГРБС ИЛИ УчетнаяПолитика.ПолномочияРБС Тогда
		Элементы.ВидДанных.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));//, "Данные по расходам бюджета");	
	КонецЕсли;
	Если УчетнаяПолитика.ПолномочияГАИВФ ИЛИ УчетнаяПолитика.ПолномочияАИВФ 
		ИЛИ УчетнаяПолитика.ПолномочияГАИВнФ ИЛИ УчетнаяПолитика.ПолномочияАИВнФ Тогда 
		Элементы.ВидДанных.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ"));//, "Данные по источникам финансирования дефицита бюджета");	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииДаты(ИзменитьПринудительно = Ложь)
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаВведенияВДействиеАссигнований) ИЛИ ИзменитьПринудительно Тогда
		Объект.ДатаВведенияВДействиеАссигнований = Объект.Дата;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаВведенияВДействиеЛБО) ИЛИ ИзменитьПринудительно Тогда
		Объект.ДатаВведенияВДействиеЛБО = Объект.Дата;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаВведенияВДействиеПОФ) ИЛИ ИзменитьПринудительно Тогда
		Объект.ДатаВведенияВДействиеПОФ = Объект.Дата;
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПриИзмененииОрганизации()
	
	УчетнаяПолитика = ПолучитьУчетнуюПолитику(Объект.Организация,Объект.Дата);	
	Если ЗначениеЗаполнено(УчетнаяПолитика.Распорядитель) Тогда
		Объект.ОтКого = УчетнаяПолитика.Распорядитель;
	Иначе
		Объект.ОтКого = УчетнаяПолитика.КодПоППП;
	КонецЕсли;	
	
	УстановитьБюджетныеПолномочия();

КонецПроцедуры	

