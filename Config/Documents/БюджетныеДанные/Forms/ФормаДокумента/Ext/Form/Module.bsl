&НаСервереБезКонтекста
Функция СформироватьСписокСсылокКОСГУ(ВидДанных)
	
	Если ВидДанных = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ") Тогда
		СписокКодов = "200,300,310,320,330,340,500,530";
	ИначеЕсли ВидДанных = ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ") Тогда
		СписокКодов = "310,410,500,520,540,550,600,620,630,640,650,700,710,720,800,810,820"; 	
	КонецЕсли;	
	
	СписокСсылок = ПлатежноРасчетныеДокументыПовтИсп.СформироватьСписокСсылокПоКодуОбъекта("Справочник.КОСГУ", СписокКодов, Истина);
	СписокСсылок.Вставить(0, БухгалтерскийУчетПовтИсп.КЭК0());
	
	Возврат СписокСсылок;
	
КонецФункции	

