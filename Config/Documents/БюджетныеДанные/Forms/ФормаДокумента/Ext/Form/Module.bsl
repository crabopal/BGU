Процедура ОрганизацияПриИзменении(Элемент)
	ПриИзмененииОрганизации();
	ПриИзмененииЛицевогоСчета();
	УстановитьДоступностьЛС();
	УстановитьДоступностьПодразделения();
КонецПроцедуры

&НаКлиенте
Процедура ВидДанныхПриИзменении(Элемент)
	СписокДопустимыхКОСГУ.Очистить();
	СписокДопустимыхКОСГУ = СформироватьСписокСсылокКОСГУ(Объект.ВидДанных);
	ОчиститьКОСГУ_КПС();
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ПриИзмененииДаты(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОчереднойПериодПриИзменении(Элемент)
	
	ЗаголовокКолонки = ?(Объект.ОчереднойПериод = 0, "Сумма на текущий год", "Сумма на очередной год");
	Элементы.АссигнованияСуммаНаТекущийГод.Заголовок = ЗаголовокКолонки; 	
	Элементы.ЛБОСуммаНаТекущийГод.Заголовок = ЗаголовокКолонки; 
	
КонецПроцедуры

