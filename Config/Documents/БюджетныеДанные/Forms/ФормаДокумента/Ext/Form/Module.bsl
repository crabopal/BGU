Процедура ЗаполнитьЛБОПоТаблицеАссигнований()
    
    Объект.ЛБО.Очистить();
    Для Каждого СтрАссигнования Из Объект.Ассигнования Цикл
        СтрЛБО = Объект.ЛБО.Добавить();
        ЗаполнитьЗначенияСвойств(СтрЛБО, СтрАссигнования);
    КонецЦикла;	
    Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПОФПоТаблицеЛБО()
    
    Объект.ПОФ.Очистить();
	
	Для Каждого СтрЛБО Из Объект.ЛБО Цикл
		
		СтрПОФ = Объект.ПОФ.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрПОФ, СтрЛБО);
		
	КонецЦикла;	
	
	Модифицированность = Истина;
    
КонецПроцедуры

