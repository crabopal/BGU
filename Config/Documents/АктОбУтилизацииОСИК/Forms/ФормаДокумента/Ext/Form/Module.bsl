&НаСервере
Процедура ЗаполнитьСписокВыбора_СпособыУтилизации()
	Элементы.ОсновныеСредстваСпособУтилизации.СписокВыбора.ЗагрузитьЗначения(УправлениеНФАКлиентСервер.СпособыУтилизацииИмущества());
КонецПроцедуры	

&НаСервере
Процедура УстановитьДопустимыеКодыОперацийПрослеживаемости()

	Если Не ВедетсяУчетПрослеживаемыхТоваров Тогда
		Возврат;
	КонецЕсли;
	
	ВидыОперацийПрослеживаемости = ПрослеживаемостьБГУКлиентСервер.ВидыОперацийПрослеживаемости();
	ВидыОперацийПрослеживаемости.Утилизация = Истина;
	ДанныеВыбора = ПрослеживаемостьБГУКлиентСервер.КодыОперацийПрослеживаемости(ВидыОперацийПрослеживаемости);
	ПрослеживаемостьФормыБГУ.ЗаполнитьСписокВыбораКодаОперацииПрослеживаемости(Элементы.КодОперацииПрослеживаемости, ДанныеВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	РассчитатьПрослеживаемыеТовары();
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТВоВсехСтроках(ЭтотОбъект, "ОсновныеСредства");
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	РезервированиеНФАКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	Элементы = Форма.Элементы;
	
	// Прослеживаемость
	ВидимостьЭлементовПрослеживаемости = Форма.ВедетсяУчетПрослеживаемыхТоваров И Форма.ЕстьПрослеживаемыеТовары;
	
	ИменаЭлементовПрослеживаемости = Новый Массив;
	ИменаЭлементовПрослеживаемости.Добавить("ОсновныеСредстваПрослеживаемыйТовар");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовПрослеживаемости,
		"Видимость", ВидимостьЭлементовПрослеживаемости);
	
	ИменаЭлементовДвиженияПрослеживаемости = Новый Массив;
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("ОсновныеСредстваСтранаПроисхождения");
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("ОсновныеСредстваРНПТ");
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("КодОперацииПрослеживаемости");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовДвиженияПрослеживаемости,
		"Видимость", ВидимостьЭлементовПрослеживаемости);
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ОсновныеСредстваРезолюцияКомиссии");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
		"Видимость", НЕ Форма.Объект.ГолосованиеЗаПолученныеМатериалы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокуПолученногоМатериала(Строка, ИмяКолонки)
	Если ИмяКолонки = "Цена" Или ИмяКолонки = "Количество" Тогда
		Строка.Сумма = Строка.Цена * Строка.Количество;
	ИначеЕсли ИмяКолонки = "Сумма" Тогда
		Если Строка.Количество <> 0 Тогда
			Строка.Цена = Строка.Сумма / Строка.Количество;
		Иначе
			Строка.Цена = 0;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Единица измерения номенклатуры.
// 
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура
// 
// Возвращаемое значение:
//  СправочникСсылка.КлассификаторЕдиницИзмерения - Единица измерения номенклатуры
&НаСервереБезКонтекста
Функция ЕдиницаИзмеренияНоменклатуры(Знач Номенклатура)
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ЕдиницаИзмерения");
	Иначе
		Возврат Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
	КонецЕсли;
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();

	// Решение сотрудника - Основные средства.
	УправлениеНФА.УстановитьУсловноеОформлениеРешенияЧленаКомиссии(УсловноеОформление, "ОсновныеСредства");
	// Решение сотрудника - ПолученныеМатериалы.
	УправлениеНФА.УстановитьУсловноеОформлениеРешенияЧленаКомиссии(УсловноеОформление, "ПолученныеМатериалы");
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("Подразделение"	, Объект.Подразделение);
	ПараметрыПодбора.Отбор.Вставить("ЦМО"			, Объект.ЦМО);
	ПараметрыПодбора.Отбор.Вставить("Счет"			, "02.5");
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаХранении"));
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("СкрытьКолонки", "СчетУчета,Контрагент");
	ПараметрыПодбора.Вставить("ДокументСРезервированиемОС", Истина);	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ЕстьПрослеживаемыеТоварыСохр = ЕстьПрослеживаемыеТовары;
		ОбработкаВыбораПодбораОсновныхСредствНаСервере(Результат);
		Если ЕстьПрослеживаемыеТоварыСохр <> ЕстьПрослеживаемыеТовары Тогда
			УстановитьВидимостьЭлементов(ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(Знач ВыбранноеЗначение)
	
	ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(
		Объект.ОсновныеСредства, ВыбранноеЗначение, , "ОсновноеСредство,ИнвентарныйНомер");
		
	ДобавленныеОсновныеСредства = Новый Массив;
	Для Каждого НоваяСтрока Из ДобавленныеСтроки Цикл
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		Если ЗначениеЗаполнено(НоваяСтрока.ОсновноеСредство) Тогда
			ДобавленныеОсновныеСредства.Добавить(НоваяСтрока.ОсновноеСредство);
		КонецЕсли;
	КонецЦикла;
	
	ДанныеДобавленныхОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДобавленныеОсновныеСредства, "ПрослеживаемыйТовар, СтранаПроисхождения");
	Для Каждого НоваяСтрока Из ДобавленныеСтроки Цикл
		ДанныеОС = ДанныеДобавленныхОС.Получить(НоваяСтрока.ОсновноеСредство);
		Если ДанныеОС <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеОС);
		КонецЕсли;
		Если НоваяСтрока.ПрослеживаемыйТовар Тогда
			ЕстьПрослеживаемыеТовары = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьСведенияДокументаСписания(ДобавленныеСтроки);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()
	
	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);
	
КонецФункции

&НаСервере
Процедура ОСПриИзмененииНаСервере(ИдентификаторСтроки)
	ТекущиеДанные = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	ДанныеОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущиеДанные.ОсновноеСредство, "ПрослеживаемыйТовар, СтранаПроисхождения");
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеОС);
	
	РассчитатьПрослеживаемыеТовары();
КонецПроцедуры

&НаСервере
Функция ИнвентарныйНомерПриИзмененииНаСервере(ТекущаяСтрока)
	
	ДобавленныеСтроки = Новый Массив;
	ДобавленныеСтроки.Добавить(Объект.ОсновныеСредства.НайтиПоИдентификатору(ТекущаяСтрока));
	
	ЗаполнитьСведенияДокументаСписания(ДобавленныеСтроки);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСведенияДокументаСписания(ДобавленныеСтроки)
	
	СписокОС = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из ДобавленныеСтроки Цикл
		СписокОС.Добавить(СтрокаТаблицы.ОсновноеСредство);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"          , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("Организация"     , Объект.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", СписокОС);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОС.Период КАК Период,
	|	СтоимостьОбъектовОС.Регистратор КАК Регистратор,
	|	СтоимостьОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОС.ВидРаспоряжения КАК ВидРаспоряжения,
	|	СтоимостьОбъектовОС.Стоимость КАК Стоимость,
	|	СтоимостьОбъектовОС.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СтоимостьОбъектовОС.Регистратор) В (ТИП(Документ.СписаниеОбъектовОС),
	|			ТИП(Документ.СписаниеОбъектовИК))
	|			ТОГДА СтоимостьОбъектовОС.НазваниеДокумента 
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НазваниеДокумента,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СтоимостьОбъектовОС.Регистратор) В (ТИП(Документ.СписаниеОбъектовОС),
	|			ТИП(Документ.СписаниеОбъектовИК))
	|			ТОГДА СтоимостьОбъектовОС.НомерДокумента 
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НомерДокумента,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СтоимостьОбъектовОС.Регистратор) В (ТИП(Документ.СписаниеОбъектовОС),
	|			ТИП(Документ.СписаниеОбъектовИК))
	|			ТОГДА СтоимостьОбъектовОС.ДатаДокумента 
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ДатаДокумента,
	|	СтоимостьОбъектовОС.Причина КАК ПричинаСписания
	|ПОМЕСТИТЬ ДвиженияСписания1
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС КАК СтоимостьОбъектовОС
	|ГДЕ
	|	СтоимостьОбъектовОС.Организация = &Организация
	|	И СтоимостьОбъектовОС.ВидРаспоряжения В (ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе))
	|	И СтоимостьОбъектовОС.ОсновноеСредство В (&ОсновноеСредство)
	|	И СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|	И СтоимостьОбъектовОС.Активность
	|	И СтоимостьОбъектовОС.Период < &Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СписаниеОбъектовИК.Ссылка.Решение КАК Регистратор,
	|	СписаниеОбъектовИК.ОсновноеСредство КАК ОсновноеСредство,
	|	СписаниеОбъектовИК.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА СписаниеОбъектовИК.Ссылка.ПервичныйДокумент <> ЗНАЧЕНИЕ(Справочник.ПервичныеДокументы.ПустаяСсылка)
	|			ТОГДА СписаниеОбъектовИК.Ссылка.Дата
	|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|	КОНЕЦ КАК ДатаДокумента,
	|	ВЫБОР
	|		КОГДА СписаниеОбъектовИК.Ссылка.ПервичныйДокумент <> ЗНАЧЕНИЕ(Справочник.ПервичныеДокументы.ПустаяСсылка)
	|			ТОГДА СписаниеОбъектовИК.Ссылка.Номер
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НомерДокумента,
	|	ВЫБОР
	|		КОГДА СписаниеОбъектовИК.Ссылка.ПервичныйДокумент <> ЗНАЧЕНИЕ(Справочник.ПервичныеДокументы.ПустаяСсылка)
	|			ТОГДА СписаниеОбъектовИК.Ссылка.ПервичныйДокумент.ВидПервичногоДокумента
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НазваниеДокумента
	|ПОМЕСТИТЬ СписанияИК
	|ИЗ
	|	Документ.СписаниеОбъектовИК.ОсновныеСредства КАК СписаниеОбъектовИК
	|ГДЕ
	|	СписаниеОбъектовИК.Ссылка.Решение В
	|		(ВЫБРАТЬ
	|			Таб.Регистратор
	|		ИЗ
	|			ДвиженияСписания1 КАК Таб)
	|	И СписаниеОбъектовИК.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СписаниеТранспорта.Решение,
	|	СписаниеТранспорта.ОсновноеСредство,
	|	СписаниеТранспорта.ИнвентарныйНомер,
	|	СписаниеТранспорта.Дата,
	|	СписаниеТранспорта.Номер,
	|	СписаниеТранспорта.ВидПервичногоДокумента
	|ИЗ
	|	Документ.СписаниеТранспортаИК КАК СписаниеТранспорта
	|ГДЕ
	|	СписаниеТранспорта.Решение В
	|		(ВЫБРАТЬ
	|			Таб.Регистратор
	|		ИЗ
	|			ДвиженияСписания1 КАК Таб)
	|	И СписаниеТранспорта.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДвиженияСписания1.Период КАК Период,
	|	ДвиженияСписания1.ОсновноеСредство КАК ОсновноеСредство,
	|	ДвиженияСписания1.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ДвиженияСписания1.ВидРаспоряжения КАК ВидРаспоряжения,
	|	ДвиженияСписания1.Стоимость КАК Стоимость,
	|	ДвиженияСписания1.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА НЕ СписанияИК.НазваниеДокумента ЕСТЬ NULL
	|		И СписанияИК.НазваниеДокумента <> """"
	|			ТОГДА СписанияИК.НазваниеДокумента
	|		ИНАЧЕ ДвиженияСписания1.НазваниеДокумента
	|	КОНЕЦ КАК НазваниеДокумента,
	|	ВЫБОР
	|		КОГДА НЕ СписанияИК.НазваниеДокумента ЕСТЬ NULL
	|		И СписанияИК.НазваниеДокумента <> """"
	|			ТОГДА СписанияИК.НомерДокумента
	|		ИНАЧЕ ДвиженияСписания1.НомерДокумента
	|	КОНЕЦ КАК НомерДокумента,
	|	ВЫБОР
	|		КОГДА НЕ СписанияИК.НазваниеДокумента ЕСТЬ NULL
	|		И СписанияИК.НазваниеДокумента <> """"
	|			ТОГДА СписанияИК.ДатаДокумента
	|		ИНАЧЕ ДвиженияСписания1.ДатаДокумента
	|	КОНЕЦ КАК ДатаДокумента,
	|	ДвиженияСписания1.ПричинаСписания КАК ПричинаСписания
	|ПОМЕСТИТЬ ДвиженияСписания
	|ИЗ
	|	ДвиженияСписания1 КАК ДвиженияСписания1
	|		ЛЕВОЕ СОЕДИНЕНИЕ СписанияИК КАК СписанияИК
	|		ПО ДвиженияСписания1.Регистратор = СписанияИК.Регистратор
	|		И ДвиженияСписания1.ОсновноеСредство = СписанияИК.ОсновноеСредство
	|		И ДвиженияСписания1.ИнвентарныйНомер = СписанияИК.ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДвиженияСписания.ОсновноеСредство КАК ОсновноеСредство,
	|	ДвиженияСписания.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	МАКСИМУМ(ДвиженияСписания.Период) КАК Период
	|ПОМЕСТИТЬ МаксПериодСписания
	|ИЗ
	|	ДвиженияСписания КАК ДвиженияСписания
	|СГРУППИРОВАТЬ ПО
	|	ДвиженияСписания.ОсновноеСредство,
	|	ДвиженияСписания.ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ДвиженияСписания.ОсновноеСредство, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)) КАК ОсновноеСредство,
	|	ЕСТЬNULL(ДвиженияСписания.ИнвентарныйНомер, """") КАК ИнвентарныйНомер,
	|	ЕСТЬNULL(ДвиженияСписания.НазваниеДокумента, """") КАК НазваниеДокумента,
	|	ЕСТЬNULL(ДвиженияСписания.НомерДокумента, """") КАК НомерДокумента,
	|	ЕСТЬNULL(ДвиженияСписания.ДатаДокумента, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаДокумента,
	|	ЕСТЬNULL(ДвиженияСписания.ПричинаСписания, """") КАК ПричинаСписания
	|ИЗ
	|	МаксПериодСписания КАК МаксПериодСписания
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДвиженияСписания КАК ДвиженияСписания
	|		ПО МаксПериодСписания.ОсновноеСредство = ДвиженияСписания.ОсновноеСредство
	|		И МаксПериодСписания.ИнвентарныйНомер = ДвиженияСписания.ИнвентарныйНомер
	|		И МаксПериодСписания.Период = ДвиженияСписания.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДвиженияСписания.ОсновноеСредство КАК ОсновноеСредство,
	|	ДвиженияСписания.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СУММА(ДвиженияСписания.Стоимость) КАК Стоимость,
	|	СУММА(ДвиженияСписания.Количество) КАК Количество
	|ИЗ
	|	ДвиженияСписания КАК ДвиженияСписания
	|СГРУППИРОВАТЬ ПО
	|	ДвиженияСписания.ОсновноеСредство,
	|	ДвиженияСписания.ИнвентарныйНомер";
	
	Результат = Запрос.ВыполнитьПакет();
	ДокументыСписания = Результат[4].Выгрузить();
	СтоимостьСписания = Результат[5].Выгрузить();
	
	Для Каждого СтрокаТаблицы Из ДобавленныеСтроки Цикл
		
		Отбор = Новый Структура("ОсновноеСредство,ИнвентарныйНомер", СтрокаТаблицы.ОсновноеСредство, СтрокаТаблицы.ИнвентарныйНомер);
		
		Данные = ДокументыСписания.НайтиСтроки(Отбор);
		Если Данные.Количество() > 0 Тогда
			СтрокаТаблицы.ОснованиеНаименование	= Данные[0].НазваниеДокумента;
			СтрокаТаблицы.ОснованиеДата			= Данные[0].ДатаДокумента;
			СтрокаТаблицы.ОснованиеНомер		= Данные[0].НомерДокумента;
			СтрокаТаблицы.ПричинаСписания		= Данные[0].ПричинаСписания;
		КонецЕсли;
		
		Данные = СтоимостьСписания.НайтиСтроки(Отбор);
		Если Данные.Количество() > 0 Тогда 
			СтрокаТаблицы.БалансоваяСтоимость = СтрокаТаблицы.Количество * 
			Данные[0]["Стоимость"] / ?(Данные[0]["Количество"] = 0, 1, Данные[0]["Количество"]);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомиссияПриИзменении(Элемент)
	
	КомиссияПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура КомиссияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ЗаполнитьСоставКомиссии(ЭтаФорма);
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИдентификаторКонтрагента(Контрагент)
	
	Возврат БухгалтерскийУчет.ИдентификаторКонтрагента(Контрагент);
	
КонецФункции

&НаСервере
Процедура УдалитьСтрокиРНПТ(Знач ИдентификаторСтроки)
	СтрокиСРНПТ = Объект.СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	
	Для Каждого СтрокаСРНПТ Из СтрокиСРНПТ Цикл
		Объект.СведенияПрослеживаемости.Удалить(СтрокаСРНПТ);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьРНПТВХранилище(Адрес, ДополнительныеПараметры) Экспорт
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ПоместитьРНПТВХранилищеНаСервере(Адрес, ДополнительныеПараметры.ИдентификаторСтроки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПоместитьРНПТВХранилищеНаСервере(Адрес, ИдентификаторСтроки)

	ТаблицаРНПТ = Объект.СведенияПрослеживаемости.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	ПоместитьВоВременноеХранилище(ТаблицаРНПТ, Адрес);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораРНПТННаКлиенте(ВыбранноеЗначение)
	
	СтрокаТабличнойЧасти = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
		СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	ОбработкаВыбораРНПТННаСервере(СтрокаТабличнойЧасти.ИдентификаторСтроки, ВыбранноеЗначение, СтрокаТабличнойЧасти.ПолучитьИдентификатор());
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораРНПТННаСервере(Знач ИдентификаторСтроки, Знач ВыбранноеЗначение, Знач ИдентификаторСтрокиВнутр)
	
	СтрокаТабличнойЧасти = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтрокиВнутр);
	ПрослеживаемостьФормыБГУ.ОбработкаВыбораРНПТН(ЭтотОбъект, ИдентификаторСтроки, ВыбранноеЗначение);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТ(ЭтаФорма, СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УправлениеПрослеживаемостью()

	РассчитатьПрослеживаемыеТовары();
	УстановитьВидимостьЭлементов(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура РассчитатьПрослеживаемыеТовары()

	ПрослеживаемыеТовары     = Объект.ОсновныеСредства.НайтиСтроки(Новый Структура("ПрослеживаемыйТовар", Истина));
	ЕстьПрослеживаемыеТовары = ПрослеживаемыеТовары.Количество() > 0;

КонецПроцедуры

#Область УчетДрагМатериалов

&НаСервере
Процедура ЗаполнитьСписокДМДляСписанияНаСервере()
	
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект);
	
	Если НЕ ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков);
	
	УчетДрагМатериалов.ЗаполнитьИсточникиОбразованияЛомаОтходовДрагМатериалов(Объект.Организация, Объект.ДрагоценныеМатериалы, Объект.Дата);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков)
	
	ТаблицаСписанияОбъектов = Объект.ОсновныеСредства.Выгрузить(, "ОсновноеСредство,ИнвентарныйНомер,Количество");
	ТаблицаСписанияОбъектов.Колонки.ОсновноеСредство.Имя = "ОбъектНФА";
	ТаблицаСписанияОбъектов.Колонки.ИнвентарныйНомер.Имя = "ИнвНомер";
	
	ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияОС(Объект.Организация, ТаблицаСписанияОбъектов, ПериодОстатков);
	
	ТаблицаДМДляНФА = Объект.ОсновныеСредства.Выгрузить(, "ОсновноеСредство,ИнвентарныйНомер,Количество");
	ОстаткиДМ = УчетДрагМатериалов.СодержаниеДрагМатериаловСУчетомТехДокументации(ОстаткиДМ, ТаблицаДМДляНФА, "ОС");  
	
	Объект.ДрагоценныеМатериалы.Загрузить(ОстаткиДМ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	
	Для каждого ТекСтрока Из Объект.ДрагоценныеМатериалы Цикл
		ТекСтрока.КлючСтроки = УчетДрагМатериаловКлиент.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, ТекСтрока.ИнвНомер);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбъектыСДрагМатериалами()
	
	ТаблицаВсехОбъектов = Объект.ОсновныеСредства.Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер, Количество");
	
	ТаблицаОбъектовОС = Новый ТаблицаЗначений;
	ТаблицаОбъектовОС.Колонки.Добавить("КлючСтроки"			, Новый ОписаниеТипов("Строка"));
	ТаблицаОбъектовОС.Колонки.Добавить("ОсновноеСредство"	, Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовОС.Колонки.Добавить("ИнвентарныйНомер"	, Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаОбъектовОС.Колонки.Добавить("Количество"			, Новый ОписаниеТипов("Число"));
	ТаблицаОбъектовОС.Колонки.Добавить("КоличествоВсегоДМ"	, Новый ОписаниеТипов("Число"));
	
	МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляОС();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		НоваяСтрока = ТаблицаОбъектовОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.КлючСтроки = УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.ОсновноеСредство, ТекСтрока.ИнвентарныйНомер); 
	КонецЦикла;
	
	ОбъектыНФАСДрагМатериалами.Загрузить(ТаблицаОбъектовОС);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДанныхДрагМатериалов()
	
	Если ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Истина;
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
		
		Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные <> Неопределено Тогда
			ОтборДрагМатериаловДляОбъекта(Элементы.СписокНФАДокументаОснования.ТекущиеДанные.КлючСтроки);
		КонецЕсли;
	Иначе
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
		Элементы.ДрагоценныеМатериалы.ОтборСтрок = Неопределено;
	КонецЕсли;
	
	//Заголовки
	РеквизитыДрагМатериалы = Новый Массив;
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМЗаголовок");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоЗаголовок");
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМ");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличество");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		РеквизитыДрагМатериалы, "Видимость", Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОбъектовДрагМатериалов(ТекущаяСтрока)
	
	ТекущаяСтрока.КоличествоВсегоДМЗаголовок = НСтр("ru = 'Всего:'");
	ТекущаяСтрока.КоличествоЗаголовок = НСтр("ru = 'Списать:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(Форма)
	
	Для каждого ТекущаяСтрока Из Форма.ОбъектыНФАСДрагМатериалами Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОбъектовДрагМатериалов(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДрагМатериаловДляОбъекта(КлючСтроки)
	
	Элементы.ДрагоценныеМатериалы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки",КлючСтроки));
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьКлючиСтрокДрагМатериалов()
	
	Если ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОДрагМатериалах(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Параметры.НайденныеСтроки Цикл
		Объект.ДрагоценныеМатериалы.Удалить(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьСтрокиТаблицыДрагМатериаловПриАктивизацииОбъектаНФА()
	Элемент = Элементы.СписокНФАДокументаОснования;
	ОтборДрагМатериаловДляОбъекта(Элемент.ТекущиеДанные.КлючСтроки);
КонецПроцедуры

&НаСервере
Функция ЕдиницыИзмеренияДрагМатериалов(ВидДрагМатериала)
	Возврат УчетДрагМатериалов.ЕдиницыИзмеренияДрагМатериалов(ВидДрагМатериала);
КонецФункции	

&НаСервере
Процедура ЗаполнитьСписокДрагМатериалыПолученныеПоТехДокументацииНаСервере()
 	КС = Новый КвалификаторыСтроки(100);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
	
	ТаблицаНФА = Объект.ПолученныеМатериалы.Выгрузить();
	ТаблицаНФА.Колонки.Добавить("КлючСтроки", ОписаниеТиповС, "Ключ строки", 100);
	УчетДрагМатериалов.ЗаполнитьДляМЗДанныеОСодержанииДрагМатериаловТехДокументацииПоДеталям(ТаблицаНФА, "ОсновныеСредства");
	Объект.ДрагоценныеМатериалыВПолученныхМЦ.Загрузить(ТаблицаНФА);
КонецПроцедуры	

#КонецОбласти

#Область ГолосованиеКомиссии

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СохранитьРезультатыГолосования1", "Доступность",
			ЗначениеЗаполнено(Форма.Сотрудник)
				И Форма.РешениеСотрудникаМодифицированность
				И Не Форма.Объект.ГолосованиеЗаПолученныеМатериалы);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СохранитьРезультатыГолосования", "Доступность",
			ЗначениеЗаполнено(Форма.Сотрудник)
				И Форма.РешениеСотрудникаМодифицированность
				И Форма.Объект.ГолосованиеЗаПолученныеМатериалы);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРешениеВСтрокахДокумента(РешениеСотрудника, ВоВсехСтроках = Истина)
	
	Если Объект.ГолосованиеЗаПолученныеМатериалы Тогда
		ОбрабатываемаяТаблица = Объект.ПолученныеМатериалы;
		ЭлементТаблица = Элементы.ПолученныеМатериалы;	
	Иначе
		ОбрабатываемаяТаблица = Объект.ОсновныеСредства;
		ЭлементТаблица = Элементы.ОсновныеСредства;
	КонецЕсли;	
	УправлениеНФАКлиентСервер.УстановитьРешениеВСтрокахДокумента(ОбрабатываемаяТаблица,
		РешениеСотрудника,
		ВоВсехСтроках,
		ЭлементТаблица.ВыделенныеСтроки);
	
	РешениеСотрудникаМодифицированность = Истина;
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСохранитьРезультатыГолосованияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СохранитьРезультатыГолосованияНаСервере(ДополнительныеПараметры.Сотрудник, ДополнительныеПараметры.РезультатыГолосования);
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
	
	РешениеСотрудникаМодифицированность = Ложь; // При любом ответе сбрасываем признак модифицированности.
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьРезультатыГолосованияНаСервере(ЧленКомиссии, РезультатыГолосования)
	
	ОбщегоНазначенияБГУ.СохранитьРезультатыГолосованияНаСервере(Объект, ЧленКомиссии, РезультатыГолосования);
	РешениеСотрудникаМодифицированность = Ложь;
	
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросУстановитьРешениеЕдиногласноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		УстановитьРешениеЕдиногласноНаСервере(ДополнительныеПараметры);
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
	
	РешениеСотрудникаМодифицированность = Ложь; // При любом ответе сбрасываем признак модифицированности.
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРешениеЕдиногласноНаСервере(РезультатГолосования)
	
	Если Объект.ГолосованиеЗаПолученныеМатериалы Тогда
		ОбщегоНазначенияБГУ.УстановитьРешениеЕдиногласноНаСервере(Объект, "ПолученныеМатериалы", РезультатГолосования);
	Иначе
		ОбщегоНазначенияБГУ.УстановитьРешениеЕдиногласноНаСервере(Объект, "ОсновныеСредства", РезультатГолосования);
	КонецЕсли;
	РешениеСотрудникаМодифицированность = Ложь;
	
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	
КонецПроцедуры

// Файлы сотрудников

&НаКлиенте
Процедура ОбработатьВыборФайлаСотрудника(ЗначениеВыбора, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ЗначениеВыбора) Тогда
		ОбработатьВыборФайлаСотрудникаНаСервере(ЗначениеВыбора);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборФайлаСотрудникаНаСервере(ЗначениеВыбора)
	
	УправлениеНФА.ОбработатьВыборФайлаСотрудника(ЗначениеВыбора, Сотрудник, ПараметрыФайлаСотрудника());
	
КонецПроцедуры

&НаСервере
Процедура ОткрепитьФайлСотрудникаНаСервере()
	
	УправлениеНФА.ОткрепитьФайлСотрудника(ФайлСотрудника, Сотрудник, ПараметрыФайлаСотрудника());
	
КонецПроцедуры

&НаСервере
Функция ПараметрыФайлаСотрудника()
	ПараметрыФайлаСотрудника = УправлениеНФА.ФайлСотрудника_Параметры(ЭтотОбъект);
	Если НЕ Объект.ГолосованиеЗаПолученныеМатериалы Тогда
		ПараметрыФайлаСотрудника.ПолеФайла = "ФайлСотрудника";
		ПараметрыФайлаСотрудника.ПолеНадписи = "НадписьФайлНеВыбран1";
		ПараметрыФайлаСотрудника.ПолеУдалить = "НадписьУдалитьФайл1";
		ПараметрыФайлаСотрудника.ЭлементПолеФайла = "ФайлСотрудника1";
	КонецЕсли;
	Возврат ПараметрыФайлаСотрудника
КонецФункции

// Конец Файлы сотрудников

#КонецОбласти

#Область ОбработчикиСобытийПроцессыОбработкиДокументов

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента(Команда)
	ОбщегоНазначенияБГУКлиент.ВыполнитьЗадачу(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение(Контекст, ДополнительныеПараметры) Экспорт
	ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст);
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры, Контекст);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст)
	ОбщегоНазначенияБГУ.ВыполнитьЗадачу(ЭтотОбъект, Контекст, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийНаправившегоОткрытие(Элемент, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийНаправившегоОткрытие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийСледующемуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийСледующемуНачалоВыбора(ЭтотОбъект, Элемент, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

