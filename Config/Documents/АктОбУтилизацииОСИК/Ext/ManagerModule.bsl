// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктОбУтилизацииОС";
	КомандаПечати.Идентификатор		= "Акт0510435";
	КомандаПечати.Представление		= НСтр("ru = 'Акт об утилизации (ф. 0510435)'");
	КомандаПечати.Порядок			= 1;

	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктОбУтилизацииОСИК";
	КомандаПечати.Идентификатор		= "ПечатьИнвКарточек61н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Инвентарные карточки объектов'"),, "61н");
	КомандаПечати.Порядок			= 4;
	
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОСодержанииДрагМатериалов", 3);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПечатьИнвКарточек61н") Тогда
		
		ДанныеДляПечати = ДанныеДляПечатиИнвКарточек(МассивОбъектов);
		ИменаФайловПечати = Новый Соответствие;
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПечатьИнвКарточек61н","Инвентарные карточки объектов",
			Справочники.ОсновныеСредства.ПечатьИнвентарнойКарточки61н(
			ДанныеДляПечати, ПараметрыПечати, ОбъектыПечати, ИменаФайловПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеДляПечатиИнвКарточек(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧОсновныеСредства.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.АктОбУтилизацииОСИК.ОсновныеСредства КАК ТЧОсновныеСредства
	|ГДЕ
	|	ТЧОсновныеСредства.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
КонецФункции

Функция ДанныеЗапросаДля0510435() Экспорт
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ТекстЗапросаШапкиДляПечатиАктаОбУтилизации0510435());
	ЧастиЗапроса.Добавить(ТекстЗапросаИнвентарныеОбъектыДляПечатиАктаОбУтилизации0510435());
	ЧастиЗапроса.Добавить(ТекстЗапросаНеинвентарныеОбъектыДляПечатиАктаОбУтилизации0510435());
	ЧастиЗапроса.Добавить(ТекстЗапросаПолученныеМЦДляПечатиАктаОбУтилизации0510435());
	ЧастиЗапроса.Добавить(ТекстЗапросаПолученныеДрагматериалыДляПечатиАктаОбУтилизации0510435());
	ЧастиЗапроса.Добавить(ТекстЗапросаДрагматериалыДляПечатиАктаОбУтилизации0510435());

	Возврат ЧастиЗапроса;
КонецФункции	

Функция ТекстЗапросаШапкиДляПечатиАктаОбУтилизации0510435()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ШапкаДокумента.Ссылка КАК Ссылка,
	|	ШапкаДокумента.Номер КАК Номер,
	|	ШапкаДокумента.Дата КАК ДатаАкта,
	|	ШапкаДокумента.Организация КАК Организация,
	|	ШапкаДокумента.Подразделение КАК СтруктурноеПодразделение,
	|	ШапкаДокумента.ЦМО.Сотрудник КАК Сотрудник,
	|	ШапкаДокумента.ЦМО.МестоХранения КАК МестоХранения,
	|	ШапкаДокумента.Комиссия.НаименованиеПриказа КАК НаименованиеПриказа,
	|	ШапкаДокумента.Комиссия.НомерПриказа КАК НомерПриказа,
	|	ШапкаДокумента.Комиссия.ДатаПриказа КАК ДатаПриказа,
	|	ШапкаДокумента.Ответственный КАК Ответственный,
	|	ШапкаДокумента.Руководитель КАК Руководитель
	|ПОМЕСТИТЬ Шапка
	|ИЗ
	|	Документ.АктОбУтилизацииОСИК КАК ШапкаДокумента
	|ГДЕ
	|	ШапкаДокумента.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МестаХраненияКонтактнаяИнформация.Ссылка КАК МестоХранения,
	|	МестаХраненияКонтактнаяИнформация.Представление КАК АдресМестаХранения
	|ПОМЕСТИТЬ МестаХранения
	|ИЗ
	|	Справочник.МестаХранения.КонтактнаяИнформация КАК МестаХраненияКонтактнаяИнформация
	|ГДЕ
	|	МестаХраненияКонтактнаяИнформация.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				Шапка.МестоХранения
	|			ИЗ
	|				Шапка КАК Шапка)
	|	И МестаХраненияКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресМестаХранения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.Номер КАК Номер,
	|	Шапка.ДатаАкта КАК ДатаАкта,
	|	Шапка.Организация КАК Организация,
	|	Шапка.СтруктурноеПодразделение КАК СтруктурноеПодразделение,
	|	Шапка.Сотрудник КАК Сотрудник,
	|	ВЫБОР
	|		КОГДА МестаХранения.МестоХранения ЕСТЬ NULL
	|				ИЛИ МестаХранения.АдресМестаХранения = """"
	|			ТОГДА Шапка.МестоХранения.Наименование
	|		ИНАЧЕ МестаХранения.АдресМестаХранения
	|	КОНЕЦ КАК Местонахождение,
	|	Шапка.НаименованиеПриказа КАК НаименованиеПриказа,
	|	Шапка.НомерПриказа КАК НомерПриказа,
	|	Шапка.ДатаПриказа КАК ДатаПриказа,
	|	Шапка.Ответственный КАК Ответственный,
	|	Шапка.Руководитель КАК Руководитель
	|ИЗ
	|	Шапка КАК Шапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ МестаХранения КАК МестаХранения
	|		ПО Шапка.МестоХранения = МестаХранения.МестоХранения
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаАкта,
	|	Номер";
		
КонецФункции

Функция ТекстЗапросаИнвентарныеОбъектыДляПечатиАктаОбУтилизации0510435()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
