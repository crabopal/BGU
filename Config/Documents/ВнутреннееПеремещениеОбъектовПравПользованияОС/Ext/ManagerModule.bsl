#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.НакладнаяНаВнутреннееПеремещениеОС2";
	КомандаПечати.Идентификатор		= "Накладная0510450";
	КомандаПечати.Представление		= НСтр("ru = 'Накладная на внутреннее перемещение НФА (ф.0510450) (61н, ред. 100н)'");
	КомандаПечати.Порядок			= 1;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.НакладнаяНаВнутреннееПеремещениеОС2";
	КомандаПечати.Идентификатор		= "Накладная0504102_103н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Накладная на внутреннее перемещение объектов НФА'"), "0504102", "52н", "103н", Истина);
	КомандаПечати.Порядок			= 2;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.НакладнаяНаВнутреннееПеремещениеОС2";
	КомандаПечати.Идентификатор		= "Накладная0504102";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Накладная на внутреннее перемещение объектов НФА'"), "0504102", "52н", , Истина);
	КомандаПечати.Порядок			= 101;
	
КонецПроцедуры

