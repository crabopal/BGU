Процедура РассчитатьСуммы()

	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(
		СтруктураПроверяемыхРеквизитов(), Объект, Истина);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьСуммыНаСервере();

КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыНаСервере()

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ.Договор КАК Договор
	|ПОМЕСТИТЬ Таблица
	|ИЗ
	|	&Таблица КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Договор,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счет),
	|			,
	|			Организация = &Организация
	|				И Подразделение = &Подразделение
	|				И Субконто3 = &ЦМО
	|				И (Субконто1, Субконто2) В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство,
	|						ВТ.Договор
	|					ИЗ
	|						Таблица КАК ВТ)) КАК ЖурналПроводокЕПСБУОстатки";
	
	
	Если Не УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетПравПользованияПоПодразделениям() Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Подразделение = &Подразделение", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период"			, Объект.Дата);
	Запрос.УстановитьПараметр("Счет"			, БухгалтерскийУчет.СписокСчетов("111.40"));
	Запрос.УстановитьПараметр("Организация"		, Объект.Организация);
	Запрос.УстановитьПараметр("ЦМО"				, Объект.ЦМООтправитель);
	Запрос.УстановитьПараметр("Подразделение"	, Объект.ПодразделениеОтправитель);
	Запрос.УстановитьПараметр("Таблица"			, Объект.ОсновныеСредства.Выгрузить());
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТабл Из Объект.ОсновныеСредства Цикл
		Отбор = Новый Структура("ОсновноеСредство,Договор", СтрокаТабл.ОсновноеСредство, СтрокаТабл.Договор);
		Строки = Результат.НайтиСтроки(Отбор);
		Если Строки.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТабл, Строки[0]);
		Иначе
			ЗаполнитьЗначенияСвойств(СтрокаТабл, Новый Структура("КПС,СчетУчета,КФО,Сумма"));
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОСНаСервере()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Договор,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счет),
	|			,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И Подразделение = &Подразделение
	|				И Субконто3 = &ЦМО) КАК ЖурналПроводокЕПСБУОстатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОсновноеСредство,
	|	Договор";
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИФО = &ИФО", "ИСТИНА");
	КонецЕсли;
	
	Если Не УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетПравПользованияПоПодразделениям() Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Подразделение = &Подразделение", "ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период"			, Объект.Дата);
	Запрос.УстановитьПараметр("Счет"			, БухгалтерскийУчет.СписокСчетов("111.40"));
	Запрос.УстановитьПараметр("Организация"		, Объект.Организация);
	Запрос.УстановитьПараметр("ИФО"				, Объект.ИФО);
	Запрос.УстановитьПараметр("ЦМО"				, Объект.ЦМООтправитель);
	Запрос.УстановитьПараметр("Подразделение"	, Объект.ПодразделениеОтправитель);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Объект.ОсновныеСредства.Загрузить(Результат);
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	
	СтруктураРеквизитов.Вставить("Организация");
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО И НЕ ЗначениеЗаполнено(Объект.ИФО) Тогда
		СтруктураРеквизитов.Вставить("ИФО");
	КонецЕсли;
	Если Элементы.ЦМООтправитель.ОтметкаНезаполненного Тогда
		СтруктураРеквизитов.Вставить("ЦМООтправитель", "МОЛ/Место хранения (отправитель)");
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям Тогда
		Если Элементы.ПодразделениеОтправитель.ОтметкаНезаполненного Тогда
			СтруктураРеквизитов.Вставить("ПодразделениеОтправитель", "Подразделение (отправитель)");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("ЦМО"			, Объект.ЦМООтправитель);
	ПараметрыПодбора.Отбор.Вставить("Подразделение"	, Объект.ПодразделениеОтправитель);
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения", "ПраваПользования");
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

