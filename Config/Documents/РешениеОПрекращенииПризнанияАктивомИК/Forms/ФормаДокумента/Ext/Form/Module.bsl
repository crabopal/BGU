&НаСервере
Процедура ЗаполнитьОСНаСервере()
	Объект.ОсновныеСредства.Очистить();
	
	Документы087 = Новый Массив;
	Документы466 = Новый Массив;
	Для каждого СтрокаТЧ из Объект.Основание Цикл
		Если ТипЗнч(СтрокаТЧ.ДокументИнвентаризации) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
			Документы466.Добавить(СтрокаТЧ.ДокументИнвентаризации);
		ИначеЕсли ТипЗнч(СтрокаТЧ.ДокументИнвентаризации) = Тип("ДокументСсылка.ИнвентаризацияИК") Тогда
			Документы087.Добавить(СтрокаТЧ.ДокументИнвентаризации);
		КонецЕсли;	
	КонецЦикла;	
	
	ЕстьДокументы087 = (Документы087.Количество() > 0);	
	ЕстьДокументы466 = (Документы466.Количество() > 0);	
	
	Период = ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата);
	ПервыйПредел = УправлениеОсновнымиСредствами.ПолучитьПараметрыУчетаОС(Объект.Дата).ПервыйПределОС;
	СчетаУчета = СчетаОтбора.ВыгрузитьЗначения();
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документы087", Документы087);
	Запрос.УстановитьПараметр("Документы466", Документы466);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ИнвентарныйУчет", Объект.ИнвентарныйУчет);
	Запрос.УстановитьПараметр("ПервыйПредел", ПервыйПредел);
	Запрос.УстановитьПараметр("ЦМО", Объект.ЦМО);
	Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
	Запрос.УстановитьПараметр("КФО1", ПредопределенноеЗначение("Перечисление.КВД.Бюджет"));
	Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	Запрос.УстановитьПараметр("СчетаУчета", СчетаУчета);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", УчетПоПодразделениям);
	
	Если ЕстьДокументы466 Тогда
		СсылкаЦелевогоДокумента = Неопределено;
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			СсылкаЦелевогоДокумента = Объект.Ссылка;
		КонецЕсли;	
		Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, Документы466, СсылкаЦелевогоДокумента);
	КонецЕсли;	

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Счет,
	|	ЕПСБУ.УчетПоПодразделениям КАК УчетПоПодразделениям
	|ПОМЕСТИТЬ СчетаОснований
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка в (&СчетаУчета)";
	
	Если ЕстьДокументы087 Тогда
		ТекстЗапроса = ТекстЗапроса        
		+ ОбщегоНазначения.РазделительПакетаЗапросов()
		+ ЗапросПо087(Запрос, УчетПоПодразделениям) 
	КонецЕсли;	         
	
	Если ЕстьДокументы466 Тогда
		ТекстЗапроса = ТекстЗапроса        
		+ ОбщегоНазначения.РазделительПакетаЗапросов()
		+ ЗапросПо466(Запрос, УчетПоПодразделениям, Документы466)
	КонецЕсли;
	
	Если ЕстьДокументы087 И ЕстьДокументы466 Тогда
		ТекстЗапроса = ТекстЗапроса        
		+ ОбщегоНазначения.РазделительПакетаЗапросов()
		+ "ВЫБРАТЬ
		|	Данные087.Ссылка КАК Ссылка,
		|	Данные087.НомерСтроки КАК НомерСтроки,
		|	Данные087.ОсновноеСредство КАК ОсновноеСредство,
		|	Данные087.ТипНФА КАК ТипНФА,
		|	Данные087.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	Данные087.СчетУчета КАК СчетУчета,
		|	Данные087.КФО КАК КФО,
		|	Данные087.КПС КАК КПС,
		|	Данные087.СтатусОбъекта КАК СтатусОбъекта,
		|	Данные087.ЦелеваяФункцияАктива КАК ЦелеваяФункцияАктива,
		|	Данные087.КоличествоОстаток КАК КоличествоОстаток,
		|	Данные087.Количество КАК Количество,
		|	Данные087.Сумма КАК Сумма
		|ПОМЕСТИТЬ Данные
		|ИЗ
		|	Данные087 КАК Данные087
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Данные466.Ссылка,
		|	Данные466.НомерСтроки,
		|	Данные466.ОсновноеСредство,
		|	Данные466.ТипНФА,
		|	Данные466.ИнвентарныйНомер,
		|	Данные466.СчетУчета,
		|	Данные466.КФО,
		|	Данные466.КПС,
		|	Данные466.СтатусОбъекта,
		|	Данные466.ЦелеваяФункцияАктива,
		|	Данные466.КоличествоОстаток,
		|	Данные466.Количество,
		|	Данные466.Сумма
		|ИЗ
		|	Данные466 КАК Данные466";
	ИначеЕсли ЕстьДокументы087 Тогда
		ТекстЗапроса = ТекстЗапроса        
		+ ОбщегоНазначения.РазделительПакетаЗапросов()
		+ "ВЫБРАТЬ
		|	Данные087.Ссылка КАК Ссылка,
		|	Данные087.НомерСтроки КАК НомерСтроки,
		|	Данные087.ОсновноеСредство КАК ОсновноеСредство,
		|	Данные087.ТипНФА КАК ТипНФА,
		|	Данные087.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	Данные087.СчетУчета КАК СчетУчета,
		|	Данные087.КФО КАК КФО,
		|	Данные087.КПС КАК КПС,
		|	Данные087.СтатусОбъекта КАК СтатусОбъекта,
		|	Данные087.ЦелеваяФункцияАктива КАК ЦелеваяФункцияАктива,
		|	Данные087.КоличествоОстаток КАК КоличествоОстаток,
		|	Данные087.Количество КАК Количество,
		|	Данные087.Сумма КАК Сумма
		|ПОМЕСТИТЬ Данные
		|ИЗ
		|	Данные087 КАК Данные087";
	ИначеЕсли ЕстьДокументы466 Тогда
		ТекстЗапроса = ТекстЗапроса        
		+ ОбщегоНазначения.РазделительПакетаЗапросов()
		+ "ВЫБРАТЬ
		|	Данные466.Ссылка,
		|	Данные466.НомерСтроки,
		|	Данные466.ОсновноеСредство,
		|	Данные466.ТипНФА,
		|	Данные466.ИнвентарныйНомер,
		|	Данные466.СчетУчета,
		|	Данные466.КФО,
		|	Данные466.КПС,
		|	Данные466.СтатусОбъекта,
		|	Данные466.ЦелеваяФункцияАктива,
		|	Данные466.КоличествоОстаток,
		|	Данные466.Количество,
		|	Данные466.Сумма
		|ПОМЕСТИТЬ Данные
		|ИЗ
		|	Данные466 КАК Данные466";
	КонецЕсли;	

	ТекстЗапроса = ТекстЗапроса        
	+ ОбщегоНазначения.РазделительПакетаЗапросов()
	+ "ВЫБРАТЬ
	|	АмортизацияОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	АмортизацияОбъектовОСОстатки.СуммаАмортизацииОстаток КАК СуммаАмортизации,
	|	АмортизацияОбъектовОСОстатки.СуммаОбесцененияОстаток КАК СуммаОбесценения
	|ПОМЕСТИТЬ ВТ_Амортизация
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС.Остатки(&Период, Организация = &Организация
	|	И (ОсновноеСредство, ИнвентарныйНомер) В
	|		(ВЫБРАТЬ
	|			Данные.ОсновноеСредство КАК ОсновноеСредство,
	|			Данные.ИнвентарныйНомер КАК ИнвентарныйНомер
	|		ИЗ
	|			Данные КАК Данные)) КАК АмортизацияОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Данные.Ссылка КАК ДокументИнвентаризации,
	|	Данные.ОсновноеСредство КАК ОсновноеСредство,
	|	Данные.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Данные.ТипНФА КАК ТипНФА,
	|	Данные.Количество КАК Количество,
	|	Данные.Сумма КАК Сумма,
	|	ВЫБОР
	|		КОГДА Данные.КоличествоОстаток <> Данные.Количество
	|			ТОГДА ВЫРАЗИТЬ(Данные.Количество * ЕСТЬNULL(ВТ_Амортизация.СуммаАмортизации, 0) / Данные.КоличествоОстаток КАК
	|				ЧИСЛО(18, 2))
	|		ИНАЧЕ ЕСТЬNULL(ВТ_Амортизация.СуммаАмортизации, 0)
	|	КОНЕЦ КАК СуммаАмортизации,
	|	ВЫБОР
	|		КОГДА Данные.КоличествоОстаток <> Данные.Количество
	|			ТОГДА ВЫРАЗИТЬ(Данные.Количество * ЕСТЬNULL(ВТ_Амортизация.СуммаОбесценения, 0) / Данные.КоличествоОстаток КАК
	|				ЧИСЛО(18, 2))
	|		ИНАЧЕ ЕСТЬNULL(ВТ_Амортизация.СуммаОбесценения, 0)
	|	КОНЕЦ КАК СуммаОбесценения,
	|	Данные.СчетУчета КАК СчетУчета,
	|	Данные.КФО КАК КФО,
	|	Данные.КПС КАК КПС,
	|	Данные.СтатусОбъекта КАК СтатусОбъекта,
	|	Данные.ЦелеваяФункцияАктива КАК ЦелеваяФункцияАктива
	|ИЗ
	|	Данные КАК Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Амортизация КАК ВТ_Амортизация
	|		ПО Данные.ОсновноеСредство = ВТ_Амортизация.ОсновноеСредство
	|		И Данные.ИнвентарныйНомер = ВТ_Амортизация.ИнвентарныйНомер
	|
	|УПОРЯДОЧИТЬ ПО
	|	Данные.Ссылка,
	|	Данные.НомерСтроки";

	Запрос.Текст = ТекстЗапроса;	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ТипНФА_БиблиотечныйФонд = ПредопределенноеЗначение("Перечисление.ТипыНФА.БиблиотечныйФонд");
	Для каждого СтрокаЗапроса из Результат Цикл
		НоваяСтрока = Объект.ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗапроса);
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);

		// Определим суммы амортизации и обесценения для библиотечного фонда, если списывается не вся сумма.
		Если СтрокаЗапроса.ТипНФА = ТипНФА_БиблиотечныйФонд Тогда   
			Если НоваяСтрока.Количество = 0 ИЛИ НоваяСтрока.Сумма / НоваяСтрока.Количество <= 100000 Тогда
				Если СтрокаЗапроса.СуммаАмортизации <> 0 Тогда
					НоваяСтрока.СуммаАмортизации = Мин(НоваяСтрока.Сумма, СтрокаЗапроса.СуммаАмортизации);
				КонецЕсли;	

				Если СтрокаЗапроса.СуммаОбесценения <> 0 Тогда
					НоваяСтрока.СуммаОбесценения = Мин(НоваяСтрока.Сумма, СтрокаЗапроса.СуммаОбесценения);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	РассчитатьСуммуАмортизацииЗаТекущийМесяц();
КонецПроцедуры

&НаСервере
Функция ЗапросПо087(Запрос, УчетПоПодразделениям)
	Если УчетПоПодразделениям Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЧОстатки.Ссылка КАК Ссылка,
		|	ТЧОстатки.ИФО КАК ИФО,
		|	ТЧОстатки.ЦМО КАК ЦМО,
		|	&КФО1 КАК КФО,
		|	ТЧОстатки.КПС КАК КПС,
		|	ТЧОстатки.Ссылка.Счет КАК Счет,
		|	ТЧОстатки.Подразделение КАК Подразделение,
		|	ЕСТЬNULL(Счета.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениям,
		|	ТЧОстатки.НФА КАК ОсновноеСредство,
		|	ТЧОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТЧОстатки.Количество КАК Количество
		|ПОМЕСТИТЬ Остатки087
		|ИЗ
		|	Документ.ИнвентаризацияИК.Остатки КАК ТЧОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ СчетаОснований КАК Счета
		|		ПО ТЧОстатки.Ссылка.Счет = Счета.Счет
		|ГДЕ
		|	ТЧОстатки.Ссылка В(&Документы087)
		|	И ТЧОстатки.ЦМО = &ЦМО
		|	И ТЧОстатки.ИФО = &ИФО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Остатки.Ссылка КАК Ссылка,
		|	Остатки.ИФО КАК ИФО,
		|	Остатки.ЦМО КАК ЦМО,
		|	Остатки.КФО КАК КФО,
		|	Остатки.КПС КАК КПС,
		|	Остатки.Счет КАК Счет,
		|	Остатки.ОсновноеСредство КАК ОсновноеСредство,
		|	Остатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	Остатки.Количество КАК Количество
		|ПОМЕСТИТЬ ДанныеОстатки087
		|ИЗ
		|	Остатки087 КАК Остатки
		|ГДЕ
		|	(НЕ Остатки.УчетПоПодразделениям
		|			ИЛИ Остатки.Подразделение = &Подразделение)";
	Иначе	
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЧОстатки.Ссылка КАК Ссылка,
		|	ТЧОстатки.ИФО КАК ИФО,
		|	ТЧОстатки.ЦМО КАК ЦМО,
		|	&КФО1 КАК КФО,
		|	ТЧОстатки.КПС КАК КПС,
		|	ТЧОстатки.Ссылка.Счет КАК Счет,
		|	ТЧОстатки.НФА КАК ОсновноеСредство,
		|	ТЧОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТЧОстатки.Количество КАК Количество
		|ПОМЕСТИТЬ ДанныеОстатки087
		|ИЗ
		|	Документ.ИнвентаризацияИК.Остатки КАК ТЧОстатки
		|ГДЕ
		|	ТЧОстатки.Ссылка В(&Документы087)
		|	И ТЧОстатки.ЦМО = &ЦМО
		|	И ТЧОстатки.ИФО = &ИФО";
	КонецЕсли;	

	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	Инвентаризация.Ссылка КАК Ссылка,
	|	Инвентаризация.НомерСтроки КАК НомерСтроки,
	|	Инвентаризация.ОсновноеСредство КАК ОсновноеСредство,
	|	Инвентаризация.ОсновноеСредство.ТипНФА КАК ТипНФА,
	|	Инвентаризация.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Инвентаризация.Счет КАК СчетУчета,
	|	&КФО1 КАК КФО,
	|	Инвентаризация.КПС КАК КПС,
	|	Инвентаризация.СтатусОбъекта КАК СтатусОбъекта,
	|	Инвентаризация.ЦелеваяФункцияАктива КАК ЦелеваяФункцияАктива,
	|	Инвентаризация.КоличествоНеСоответствует КАК Количество,
	|	Инвентаризация.СуммаНеСоответствует КАК Сумма
	|ПОМЕСТИТЬ ДанныеИнвентаризация087
	|ИЗ
	|	Документ.ИнвентаризацияИК.Инвентаризация КАК Инвентаризация
	|ГДЕ
	|	Инвентаризация.Ссылка В(&Документы087)
	|	И ВЫБОР
	|			КОГДА &ИнвентарныйУчет = ИСТИНА
	|				ТОГДА Инвентаризация.ОсновноеСредство.ВидНФА <> ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС)
	|						ИЛИ Инвентаризация.Цена > &ПервыйПредел
	|			ИНАЧЕ Инвентаризация.ОсновноеСредство.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС)
	|					И Инвентаризация.Цена <= &ПервыйПредел
	|		КОНЕЦ
	|	И (Инвентаризация.КоличествоНеСоответствует <> 0
	|			ИЛИ Инвентаризация.СуммаНеСоответствует <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеИнвентаризация.Ссылка КАК Ссылка,
	|	ДанныеИнвентаризация.НомерСтроки КАК НомерСтроки,
	|	ДанныеИнвентаризация.ОсновноеСредство КАК ОсновноеСредство,
	|	ДанныеИнвентаризация.ТипНФА КАК ТипНФА,
	|	ДанныеИнвентаризация.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ДанныеИнвентаризация.СчетУчета КАК СчетУчета,
	|	ДанныеОстатки.КФО КАК КФО,
	|	ДанныеОстатки.КПС КАК КПС,
	|	ДанныеИнвентаризация.СтатусОбъекта КАК СтатусОбъекта,
	|	ДанныеИнвентаризация.ЦелеваяФункцияАктива КАК ЦелеваяФункцияАктива,
	|	ДанныеОстатки.Количество КАК КоличествоОстаток,
	|	ВЫБОР
	|		КОГДА ДанныеОстатки.Количество < ДанныеИнвентаризация.Количество
	|			ТОГДА ДанныеОстатки.Количество
	|		ИНАЧЕ ДанныеИнвентаризация.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ДанныеОстатки.Количество < ДанныеИнвентаризация.Количество
	|			ТОГДА ДанныеОстатки.Количество * ДанныеИнвентаризация.Сумма / ДанныеИнвентаризация.Количество
	|		ИНАЧЕ ДанныеИнвентаризация.Сумма
	|	КОНЕЦ КАК Сумма
	|ПОМЕСТИТЬ Данные087
	|ИЗ
	|	ДанныеИнвентаризация087 КАК ДанныеИнвентаризация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеОстатки087 КАК ДанныеОстатки
	|		ПО ДанныеИнвентаризация.ОсновноеСредство = ДанныеОстатки.ОсновноеСредство
	|			И ДанныеИнвентаризация.ИнвентарныйНомер = ДанныеОстатки.ИнвентарныйНомер
	|			И (ДанныеИнвентаризация.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)
	|				ИЛИ ДанныеИнвентаризация.КФО = ДанныеОстатки.КФО)
	|			И (ДанныеИнвентаризация.КПС = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|				ИЛИ ДанныеИнвентаризация.КПС = ДанныеОстатки.КПС)
	|			И ДанныеИнвентаризация.СчетУчета = ДанныеОстатки.Счет";
	
	Возврат ТекстЗапроса;
КонецФункции	

&НаСервере
Функция ЗапросПо466(Запрос, УчетПоПодразделениям, Документы466)
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации КАК Ссылка,
	|	ДанныеИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	ДанныеИнвентаризации.КФО КАК КФО,
	|	ДанныеИнвентаризации.КПС КАК КПС,
	|	ДанныеИнвентаризации.Счет КАК СчетУчета,
	|	ДанныеИнвентаризации.НФА КАК ОсновноеСредство,
	|	ДанныеИнвентаризации.НФА.ТипНФА КАК ТипНФА,
	|	ДанныеИнвентаризации.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ДанныеИнвентаризации.СтатусОбъекта КАК СтатусОбъекта,
	|	ДанныеИнвентаризации.ЦелеваяФункцияАктива КАК ЦелеваяФункцияАктива,
	|	ДанныеИнвентаризации.Количество КАК КоличествоОстаток,
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.Количество < ДанныеИнвентаризации.КоличествоНеСоответствует
	|			ТОГДА ДанныеИнвентаризации.Количество
	|		ИНАЧЕ ДанныеИнвентаризации.КоличествоНеСоответствует
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.Количество < ДанныеИнвентаризации.КоличествоНеСоответствует
	|			ТОГДА ДанныеИнвентаризации.Количество * ДанныеИнвентаризации.СуммаНеСоответствует / ДанныеИнвентаризации.КоличествоНеСоответствует
	|		ИНАЧЕ ДанныеИнвентаризации.СуммаНеСоответствует
	|	КОНЕЦ КАК Сумма
	|ПОМЕСТИТЬ Данные466
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетаОснований КАК Счета
	|		ПО ДанныеИнвентаризации.Счет = Счета.Счет
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации В(&Документы466)
	|	И ДанныеИнвентаризации.ВидОбъекта В (6, 7)
	|	И ДанныеИнвентаризации.ЦМОРаздела1 = &ЦМО
	|	И ДанныеИнвентаризации.ИФО = &ИФО
	|	И (НЕ &УчетПоПодразделениям
	|			ИЛИ НЕ ЕСТЬNULL(Счета.УчетПоПодразделениям, ЛОЖЬ)
	|			ИЛИ ДанныеИнвентаризации.Подразделение = &Подразделение)
	|	И ВЫБОР
	|			КОГДА &ИнвентарныйУчет = ИСТИНА
	|				ТОГДА ДанныеИнвентаризации.НФА.ВидНФА <> ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС)
	|						ИЛИ ВЫБОР
	|							КОГДА ДанныеИнвентаризации.Количество = 0
	|								ТОГДА ДанныеИнвентаризации.Сумма
	|							ИНАЧЕ ДанныеИнвентаризации.Сумма / ДанныеИнвентаризации.Количество
	|						КОНЕЦ > &ПервыйПредел
	|			ИНАЧЕ ДанныеИнвентаризации.НФА.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС)
	|					И ВЫБОР
	|						КОГДА ДанныеИнвентаризации.Количество = 0
	|							ТОГДА ДанныеИнвентаризации.Сумма
	|						ИНАЧЕ ДанныеИнвентаризации.Сумма / ДанныеИнвентаризации.Количество
	|					КОНЕЦ <= &ПервыйПредел
	|		КОНЕЦ
	|	И (ДанныеИнвентаризации.КоличествоНеСоответствует <> 0
	|			ИЛИ ДанныеИнвентаризации.СуммаНеСоответствует <> 0)";
	
	Возврат ТекстЗапроса;
КонецФункции	

&НаСервере
Процедура ЗаполнитьДокументПоДаннымИнвентаризации()
	Объект.Дата = НачалоДня(ОбщегоНазначения.ТекущаяДатаПользователя());
	ПараметрОснование = Параметры.Основание;
	Если ПараметрОснование.Свойство("ДокументОснование") Тогда
		Объект.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрОснование.ДокументОснование, "Организация");
	КонецЕсли;	
	
	Объект.ИнвентарныйУчет = ПараметрОснование.Разделитель.ПоИнвентарнымОбъектам;
	Объект.ЦМО = ПараметрОснование.Разделитель.ЦМО;
	Объект.Подразделение = ПараметрОснование.Разделитель.Подразделение;
	
	НоваяСтрока = Объект.Основание.Добавить();
	НоваяСтрока.ДокументИнвентаризации = ПараметрОснование.ДокументОснование;

	ДанныеДокумента = ДанныеДокументаИнвентаризации(
		НоваяСтрока.ДокументИнвентаризации, Объект.ИнвентарныйУчет, Объект.Дата);
	НоваяСтрока.КФО = ДанныеДокумента.КФО;
	НоваяСтрока.СчетУчета = ДанныеДокумента.СчетУчета;
	
	ЗаполнитьОСНаСервере();
КонецПроцедуры	

