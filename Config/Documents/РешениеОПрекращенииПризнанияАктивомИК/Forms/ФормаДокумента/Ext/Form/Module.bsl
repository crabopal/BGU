	ЭлементСправочника = ТекущееЗначениеСправочника("ЦелевыеФункцииАктивовДляИнвентаризации", Элементы.ОсновныеСредства.ТекущиеДанные.ЦелеваяФункцияАктива);
	ПараметрыФормы = Новый Структура("ТекущаяСтрока", ЭлементСправочника);
	
	ОткрытьФорму("Справочник.ЦелевыеФункцииАктивовДляИнвентаризации.ФормаВыбора",
		ПараметрыФормы, Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
