#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьРеквизитыТЧ(Команда)
	Реквизиты = Новый Структура("ЦелеваяФункцияАктива, СтатусОбъекта, РезолюцияКомиссии");
	
	Реквизиты.Вставить("ЦелеваяФункцияАктива", Новый Структура);
	Реквизиты.ЦелеваяФункцияАктива.Вставить("ТипыДляВыбора", 
		Новый ОписаниеТипов("СправочникСсылка.ЦелевыеФункцииАктивовДляИнвентаризации"));
	Реквизиты.ЦелеваяФункцияАктива.Вставить("СинонимДляВыбора", "Целевая функция"); 
		
	Реквизиты.Вставить("СтатусОбъекта", Новый Структура);
	Реквизиты.СтатусОбъекта.Вставить("ТипыДляВыбора", 
		Новый ОписаниеТипов("СправочникСсылка.СтатусыОбъектовДляИнвентаризации"));
	Реквизиты.СтатусОбъекта.Вставить("СинонимДляВыбора", "Статус"); 
	
	Реквизиты.Вставить("РезолюцияКомиссии");

	Реквизиты.Вставить("ПричинаСписания", Новый Структура);
	Реквизиты.ПричинаСписания.Вставить("ТипыДляВыбора", 
		Новый ОписаниеТипов("Строка, СправочникСсылка.ПричиныСписанияНФА"));
	Реквизиты.ПричинаСписания.Вставить("СинонимДляВыбора", НСтр("ru = 'Причина списания'")); 

	УправлениеНФАКлиент.ИзменитьРеквизитыСтрокТЧ(ЭтотОбъект, 
