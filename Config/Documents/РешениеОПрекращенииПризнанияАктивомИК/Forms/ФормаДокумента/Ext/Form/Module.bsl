&НаКлиенте
Процедура ИнвентарныйУчетОбработкаВыбора(
	Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)

	ДопПараметры = УправлениеОсновнымиСредствамиКлиент.ДопПараметры_ОбработкаВыбора_ОчисткаТабЧастей();
	ДопПараметры.Вставить("ИмяРеквизита", "ИнвентарныйУчет");
	ДопПараметры.Вставить("ЗаголовокРеквизита", "Формирование");
	ДопПараметры.ИменаТабЧастей.Вставить("ОсновныеСредства", "Основные средства, НМА, НПА");
	УправлениеОсновнымиСредствамиКлиент.ОбработкаВыбора_ОчисткаТабЧастей(
		Элемент, ВыбранноеЗначение, СтандартнаяОбработка, ДопПараметры);
КонецПроцедуры

&НаКлиенте
Процедура ЦМООбработкаВыбора(
	Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)

	ДопПараметры = УправлениеОсновнымиСредствамиКлиент.ДопПараметры_ОбработкаВыбора_ОчисткаТабЧастей();
	ДопПараметры.Вставить("ИмяРеквизита", "ЦМО");
	ДопПараметры.Вставить("ЗаголовокРеквизита", "ЦМО");
	ДопПараметры.ИменаТабЧастей.Вставить("ОсновныеСредства", "Основные средства, НМА, НПА");
	ДопПараметры.ИменаТабЧастей.Вставить("Основание", "Основание");
	УправлениеОсновнымиСредствамиКлиент.ОбработкаВыбора_ОчисткаТабЧастей(
		Элемент, ВыбранноеЗначение, СтандартнаяОбработка, ДопПараметры);
КонецПроцедуры

&НаКлиенте
Процедура ЦМОПриИзменении(Элемент)
	
	ЦМООтбора.ЗагрузитьЗначения(СписокЦМО(Объект.ЦМО));
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникПриИзменении(Элемент)
	
	Если РешениеСотрудникаМодифицированность
		И ЗначениеЗаполнено(ВыбранныйСотрудник)
		И ВыбранныйСотрудник <> Сотрудник Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Сотрудник", ВыбранныйСотрудник);
		ДопПараметры.Вставить("РезультатыГолосования", РезультатыГолосованияСотрудника(Объект.ОсновныеСредства));
		
		Оповещение = Новый ОписаниеОповещения("ВопросСохранитьРезультатыГолосованияЗавершение", ЭтотОбъект, ДопПараметры);
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Сохранить результаты голосования члена комиссии ""%1""?'"), ВыбранныйСотрудник);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
	СотрудникПриИзмененииНаСервере();
	
	ВыбранныйСотрудник = Сотрудник;
	
	РешениеСотрудникаМодифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура СотрудникПриИзмененииНаСервере()
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	РаботаСФайламиБГУ.ПолучитьФайлСотрудника(Сотрудник, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОтборПрисутствующих = Новый Структура("Отсутствует", Ложь);
	ПрисутствующиеЧленыКомиссии = Объект.СоставКомиссии.НайтиСтроки(ОтборПрисутствующих);
	
	// Выбирается из присутствующих членов комиссии.
	Элемент.СписокВыбора.Очистить();
	Для Каждого ЧленКомиссии Из ПрисутствующиеЧленыКомиссии Цикл
		Элемент.СписокВыбора.Добавить(ЧленКомиссии.Сотрудник);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомиссияПриИзменении(Элемент)
	
	КомиссияПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура КомиссияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ЗаполнитьСоставКомиссии(ЭтаФорма);
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
КонецПроцедуры

