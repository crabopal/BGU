	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ТекущиеДанные.РешениеСотрудникаПоРезолюции = ВыбранноеЗначение;
	
	РешениеСотрудникаМодифицированность = Истина;
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСтатусОбъектаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЭлементСправочника = ТекущееЗначениеСправочника("СтатусыОбъектовДляИнвентаризации", Элементы.ОсновныеСредства.ТекущиеДанные.СтатусОбъекта);
	ПараметрыФормы = Новый Структура("ТекущаяСтрока", ЭлементСправочника);
	
	ОткрытьФорму("Справочник.СтатусыОбъектовДляИнвентаризации.ФормаВыбора",
		ПараметрыФормы, Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

