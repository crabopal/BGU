&НаСервере
Процедура РассчитатьСуммуАмортизацииЗаТекущийМесяц(ДобавленныеСтроки = Неопределено)
	
	//Если Справочники.Организации.ПолучитьУчетнуюПолитику(Объект.Организация, Объект.Дата).НачислятьАмортизациюПервымЧислом Тогда
	Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.НачислятьАмортизациюПервымЧислом Тогда
		Возврат;
	КонецЕсли;
	
	Если ДобавленныеСтроки = Неопределено Тогда
		СписокОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	Иначе
		СписокОС = Объект.ОсновныеСредства.Выгрузить(ДобавленныеСтроки).ВыгрузитьКолонку("ОсновноеСредство");
	КонецЕсли;
	
	Реквизиты = Новый Структура("Организация,Дата,ИФО,КФО,Подразделение,Ссылка");
	ЗаполнитьЗначенияСвойств(Реквизиты, Объект);
	
	СписокКФО = Новый Массив;
	СписокКФО.Добавить(ПредопределенноеЗначение("Перечисление.КВД.Бюджет"));
	Реквизиты.КФО = СписокКФО;
	
	ТаблицыАмортизации = УправлениеОсновнымиСредствами.РасчетАмортизацииОСиНМА(СписокОС, Реквизиты, Ложь, Ложь, Истина);
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		Если ДобавленныеСтроки <> Неопределено И ДобавленныеСтроки.Найти(СтрокаТаблицы) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаАмортизации = ТаблицыАмортизации.ТаблицаНачисленияАмортизацииБУ.Найти(СтрокаТаблицы.ОсновноеСредство, "ОсновноеСредство");
		Если СтрокаАмортизации = Неопределено Тогда
			СтрокаТаблицы.СуммаАмортизацииЗаТекущийМесяц = 0;
		Иначе
			СтрокаТаблицы.СуммаАмортизацииЗаТекущийМесяц = СтрокаАмортизации.СуммаАмортизацииБУ;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеДокументаИнвентаризации(Документ, ИнвентарныйУчет, ДатаДокумента)
	
	ПервыйПредел = УправлениеОсновнымиСредствами.ПолучитьПараметрыУчетаОС(ДатаДокумента).ПервыйПределОС;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"			, Документ);
	Запрос.УстановитьПараметр("ИнвентарныйУчет"	, ИнвентарныйУчет);
	Запрос.УстановитьПараметр("ПервыйПредел"	, ПервыйПредел);
	Запрос.УстановитьПараметр("Счет10800", БухгалтерскийУчет.СчетПоКоду("108.00", ДатаДокумента));
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда           
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Раздел1.НФА) = ТИП(Справочник.Номенклатура)
		|				И Раздел1.Счет <> ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
		|				И Раздел1.Счет В ИЕРАРХИИ (&Счет10800)
		|			ТОГДА 9
		|		КОГДА ТИПЗНАЧЕНИЯ(Раздел1.НФА) = ТИП(Справочник.Номенклатура)
		|			ТОГДА 8
		|		КОГДА ТИПЗНАЧЕНИЯ(Раздел1.НФА) = ТИП(Справочник.ОсновныеСредства)
		|				И ВЫРАЗИТЬ(Раздел1.НФА КАК Справочник.ОсновныеСредства).ИмуществоКазны
		|				И ВЫРАЗИТЬ(Раздел1.НФА КАК Справочник.ОсновныеСредства).ТипНФА = ЗНАЧЕНИЕ(Перечисление.ТипыНФА.Транспорт)
		|			ТОГДА 7
		|		КОГДА ТИПЗНАЧЕНИЯ(Раздел1.НФА) = ТИП(Справочник.ОсновныеСредства)
		|				И ВЫРАЗИТЬ(Раздел1.НФА КАК Справочник.ОсновныеСредства).ИмуществоКазны
		|			ТОГДА 6
		|		КОГДА ТИПЗНАЧЕНИЯ(Раздел1.НФА) = ТИП(Справочник.ОсновныеСредства)
		|				И ВЫРАЗИТЬ(Раздел1.НФА КАК Справочник.ОсновныеСредства).ТипНФА = ЗНАЧЕНИЕ(Перечисление.ТипыНФА.БиблиотечныйФонд)
		|			ТОГДА 4
		|		КОГДА ТИПЗНАЧЕНИЯ(Раздел1.НФА) = ТИП(Справочник.ОсновныеСредства)
		|				И ВЫРАЗИТЬ(Раздел1.НФА КАК Справочник.ОсновныеСредства).ТипНФА = ЗНАЧЕНИЕ(Перечисление.ТипыНФА.Транспорт)
		|			ТОГДА 3
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ВидОбъекта,
		|	Раздел1.КФО КАК КФО,
		|	Раздел1.Счет КАК Счет,
		|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК СчетУчета
		|ПОМЕСТИТЬ ДанныеИнвентаризации
		|ИЗ
		|	Документ.ИнвентаризационнаяОписьНФА.Раздел1 КАК Раздел1
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИнвентаризационнаяОписьНФА.Раздел4 КАК Раздел4
		|		ПО Раздел1.НФА = Раздел4.НФА
		|			И Раздел1.ИнвентарныйНомер = Раздел4.ИнвентарныйНомер
		|			И Раздел1.МестоИнвентаризации = Раздел4.МестоИнвентаризации
		|ГДЕ
		|	Раздел1.Ссылка В(&Ссылка)
		|	И ВЫБОР
		|			КОГДА &ИнвентарныйУчет = ИСТИНА
		|				ТОГДА Раздел1.НФА.ВидНФА <> ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС)
		|						ИЛИ ВЫБОР
		|							КОГДА Раздел1.Количество <> 0
		|								ТОГДА Раздел1.Сумма / Раздел1.Количество
		|							ИНАЧЕ Раздел1.Сумма
		|						КОНЕЦ > &ПервыйПредел
		|			ИНАЧЕ Раздел1.НФА.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС)
		|					И ВЫБОР
		|						КОГДА Раздел1.Количество <> 0
		|							ТОГДА Раздел1.Сумма / Раздел1.Количество
		|						ИНАЧЕ Раздел1.Сумма
		|					КОНЕЦ <= &ПервыйПредел
		|		КОНЕЦ
		|	И Раздел4.Ссылка В(&Ссылка)
		|	И (Раздел4.КоличествоНеСоответствует <> 0
		|			ИЛИ Раздел4.СуммаНеСоответствует <> 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеИнвентаризации.КФО КАК КФО,
		|	ДанныеИнвентаризации.Счет КАК Счет,
		|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК СчетУчета
		|ИЗ
		|	ДанныеИнвентаризации КАК ДанныеИнвентаризации
		|ГДЕ
		|	ДанныеИнвентаризации.ВидОбъекта В (6, 7)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеИнвентаризации.КФО,
		|	ДанныеИнвентаризации.Счет";
	Иначе		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Инвентаризация.КФО КАК КФО,
		|	Инвентаризация.Счет КАК Счет,
		|	Инвентаризация.Ссылка.СчетУчета КАК СчетУчета
		|ИЗ
		|	Документ.ИнвентаризацияОС.Инвентаризация КАК Инвентаризация
		|ГДЕ
		|	Инвентаризация.Ссылка В(&Ссылка)
		|	И ВЫБОР
		|			КОГДА &ИнвентарныйУчет = ИСТИНА
		|				ТОГДА Инвентаризация.ОсновноеСредство.ВидНФА <> ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС)
		|						ИЛИ Инвентаризация.Цена > &ПервыйПредел
		|			ИНАЧЕ Инвентаризация.ОсновноеСредство.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС)
		|					И Инвентаризация.Цена <= &ПервыйПредел
		|		КОНЕЦ
		|	И (Инвентаризация.КоличествоНеСоответствует <> 0
		|			ИЛИ Инвентаризация.СуммаНеСоответствует <> 0)";
	КонецЕсли;	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СписокКФО = Новый Массив;
	СписокСчетов = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.КФО) И СписокКФО.Найти(Выборка.КФО) = Неопределено Тогда
			СписокКФО.Добавить(Выборка.КФО);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Счет) И СписокКФО.Найти(Выборка.Счет) = Неопределено Тогда
			СписокСчетов.Добавить(Выборка.Счет);
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("КФО", ?(СписокКФО.Количество() = 1, СписокКФО[0], Перечисления.КВД.ПустаяСсылка()));
	Результат.Вставить("СчетУчета", ?(СписокСчетов.Количество() = 1, СписокСчетов[0],
		?(СписокСчетов.Количество() > 1, Выборка.СчетУчета, ПланыСчетов.ЕПСБУ.ПустаяСсылка())));
	
	Возврат Результат;
	
КонецФункции

