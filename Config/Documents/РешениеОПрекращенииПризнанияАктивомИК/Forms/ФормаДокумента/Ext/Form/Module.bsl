#Область ОбработчикиСобытийЭлементовТаблицыФормы_Основание

&НаКлиенте
Процедура ОснованиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Для Каждого Док Из ВыбранноеЗначение Цикл
		
		ЕстьДок = Ложь;
		Для Каждого СтрокаОснование Из Объект.Основание Цикл
			Если СтрокаОснование.ДокументИнвентаризации = Док Тогда
				ЕстьДок = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЕстьДок Тогда
			
			НоваяСтрока = Объект.Основание.Добавить();
			НоваяСтрока.ДокументИнвентаризации = Док;
			
			ДанныеДокумента = ДанныеДокументаИнвентаризации(Док, Объект.ИнвентарныйУчет, Объект.Дата);
			НоваяСтрока.КФО			= ДанныеДокумента.КФО;
			НоваяСтрока.СчетУчета	= ДанныеДокумента.СчетУчета;
			
			Модифицированность = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОснованиеДокументИнвентаризацииПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Основание.ТекущиеДанные;
	
	ДанныеДокумента = ДанныеДокументаИнвентаризации(ТекущиеДанные.ДокументИнвентаризации, Объект.ИнвентарныйУчет, Объект.Дата);
	ТекущиеДанные.КФО		= ДанныеДокумента.КФО;
	ТекущиеДанные.СчетУчета	= ДанныеДокумента.СчетУчета;
	
КонецПроцедуры

