&НаКлиенте
Процедура ДвиженияДокументаСчетКтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ДвиженияДокумента.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			ТекущиеДанные.СчетКт, 
																			ТекущиеДанные.КПСКт, 
																			ТекущиеДанные.КФО), 
															Объект.Организация,
															ТекущиеДанные.ИФО,
															,
															ТекущиеДанные.КФО,
															,
															Объект.Дата,
															Новый Структура("КорреспонденцияДт", ТекущиеДанные.СчетДт));
КонецПроцедуры

