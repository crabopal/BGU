// ОБРАБОТЧИКИ КОМАНД ФОРМЫ
 
&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	
	Если Объект.ДвиженияДокумента.Количество() > 0 Тогда
		
		ТекстВопроса = НСтр("ru = 'Перед заполнением табличная часть будет очищена. 
		|Продолжить?'") ;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ОчиститьТЧИЗаполнитьДокументЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,);
		
		Возврат;
		
	КонецЕсли;
	
	ПроверитьПроведениеИЗаполнитьДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТЧИЗаполнитьДокументЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ДвиженияДокумента.Очистить();
	
	ПроверитьПроведениеИЗаполнитьДокумент();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПроведениеИЗаполнитьДокумент()
	
	Если Объект.Проведен Тогда
		
		ТекстВопроса = НСтр("ru = 'Для заполнения необходимо отменить проведение документа.
		|Отменить проведение?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Да, отменить проведение'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьДокументЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки, , КодВозвратаДиалога.Да);
		
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьДокументДействие();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокументЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДокументДействие();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокументДействие()
	
	ЗаполнитьДокументНаСервере(СтарыйАлгоритм);
	
	ОповеститьОбИзменении(Объект.Ссылка);

КонецПроцедуры

