////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ ДвиженияДокумента

&НаКлиенте
Процедура ДвиженияДокументаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элементы.ДвиженияДокумента.ТекущиеДанные;
	Если ЗначениеЗаполнено(Объект.ИФО) Тогда
		Если НоваяСтрока Тогда
			ТекущиеДанные.ИФО = Объект.ИФО;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.КФО) Тогда
		Если НоваяСтрока Тогда
			ТекущиеДанные.КФО = Объект.КФО;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДокументаПередНачаломИзменения(Элемент, Отказ)
	Отказ = (Элемент.ТекущийЭлемент.Имя = "ДвиженияДокументаКФО" И ЗначениеЗаполнено(Объект.КФО))
			ИЛИ (Элемент.ТекущийЭлемент.Имя = "ДвиженияДокументаИФО" И ЗначениеЗаполнено(Объект.ИФО))
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДокументаИФОПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.ИФО) Тогда
		Элементы.ДвиженияДокумента.ТекущиеДанные.ИФО = Объект.ИФО;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДокументаКФОПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.КФО) Тогда
		Элементы.ДвиженияДокумента.ТекущиеДанные.КФО = Объект.КФО;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДокументаКПСДтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ДвиженияДокумента.ТекущиеДанные;

	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													ТекущиеДанные.КПСДт, 
													Объект.Организация,
													ТекущиеДанные.ИФО,
													ТекущиеДанные.КФО,
													ТекущиеДанные.СчетДт,
													Объект.Дата);
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДокументаСчетДтПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДвиженияДокумента.ТекущиеДанные;
	ТекущиеДанные.ЖурналОпераций = БухгалтерскиеОперацииВызовСервера.НомерЖурнала(ТекущиеДанные.СчетДт, ТекущиеДанные.СчетКт);
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДокументаСчетДтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ДвиженияДокумента.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			ТекущиеДанные.СчетДт, 
																			ТекущиеДанные.КПСДт, 
																			ТекущиеДанные.КФО), 
															Объект.Организация,
															ТекущиеДанные.ИФО,
															,
															ТекущиеДанные.КФО,
															,
															Объект.Дата,
															Новый Структура("КорреспонденцияКт", ТекущиеДанные.СчетКт));
КонецПроцедуры

