	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

Процедура ЗаполнитьДокументыИзДвиженийРегистраБухгалтерии() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.НомерСтроки КАК Порядок,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ИФО,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ЖурналОпераций,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияКт
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	               |			,
	               |			,
	               |			Регистратор В
	               |				(ВЫБРАТЬ
	               |					ЗакрытиеПроизводственныхСчетов.Ссылка
	               |				ИЗ
	               |					Документ.ЗакрытиеПроизводственныхСчетов КАК ЗакрытиеПроизводственныхСчетов ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗакрытиеПроизводственныхСчетов.ДвиженияДокумента КАК ЗакрытиеПроизводственныхСчетовДвиженияДокумента
	               |						ПО
	               |							ЗакрытиеПроизводственныхСчетов.Ссылка = ЗакрытиеПроизводственныхСчетовДвиженияДокумента.Ссылка
	               |				ГДЕ
	               |					ЗакрытиеПроизводственныхСчетовДвиженияДокумента.Ссылка ЕСТЬ NULL ),
	               |			,
	               |			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Регистратор,
	               |	Порядок
	               |ИТОГИ ПО
	               |	Регистратор";
	ВыборкаДокументы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДокументы.Следующий() Цикл
		
		ДокументОбъект = ВыборкаДокументы.Регистратор.ПолучитьОбъект();
		Выборка = ВыборкаДокументы.Выбрать();
		Пока Выборка.Следующий() Цикл
		
			ЗаполнитьЗначенияСвойств(ДокументОбъект.ДвиженияДокумента.Добавить(), Выборка);
		
		КонецЦикла;
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		
	КонецЦикла;

КонецПроцедуры

