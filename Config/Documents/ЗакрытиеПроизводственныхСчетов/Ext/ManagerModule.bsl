	ДанныеДляУравнений.Вставить("ДеревоДляРасчетаТау",
		Результат[НомераТаблиц.ДеревоДляРасчетаТау].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДляУравнений.Вставить("ДеревоДляРасчетаТауДоп",
		Результат[НомераТаблиц.ДеревоДляРасчетаТауДоп].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДляУравнений.Вставить("ТаблицаВыпущеннойПродукции",
		Результат[НомераТаблиц.ТаблицаВыпущеннойПродукции].Выгрузить(ОбходРезультатаЗапроса.Прямой));
	
	ДанныеДляУравнений.Вставить("МассивВлияющихНомГрупп",
		Результат[НомераТаблиц.ТаблицаВлияющихНомГрупп].Выгрузить(ОбходРезультатаЗапроса.Прямой).ВыгрузитьКолонку("НоменклатурнаяГруппа"));
	
	Возврат ДанныеДляУравнений;
	
КонецФункции

Функция СтрокаДереваПоКФОиИФО(Дерево, ИФО, КФО)
	
	СтрокаИФО = Дерево.Строки.Найти(ИФО, "ИФО", Ложь);
	СтрокаКФО = ?(СтрокаИФО <> Неопределено, СтрокаИФО.Строки.Найти(КФО, "КФО", Ложь), Неопределено);
	
	Возврат СтрокаКФО;
	
КонецФункции

// Тау - Коэффициент распределения стоимости производства внутри номенклатурной группы на единицу продукции.
//
Процедура РассчитатьКоэффициентыТау(СтрокаДляРасчетаТау, ДеревоДляРасчетаТауДоп)
	
	Если СтрокаДляРасчетаТау = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаНоменклатурнойГруппы Из СтрокаДляРасчетаТау.Строки Цикл
		
		Если СтрокаНоменклатурнойГруппы.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.НоменклатурнаяГруппа Тогда
			
			СтруктураПоиска = Новый Структура("МетодРаспределения, НоменклатурнаяГруппа",
				СтрокаНоменклатурнойГруппы.МетодРаспределенияСтоимостиПроизводства,
				СтрокаНоменклатурнойГруппы.НоменклатурнаяГруппа);
			МассивСтрок = ДеревоДляРасчетаТауДоп.Строки.НайтиСтроки(СтруктураПоиска, Истина);
			
			Если МассивСтрок.Количество() <> 0 Тогда
				Если СтрокаНоменклатурнойГруппы.МетодРаспределенияСтоимостиПроизводства = Перечисления.МетодыРаспределенияСтоимостиПроизводства.ПоПлановойСтоимостиПродукции Тогда
					ИмяПоказателя       = "ПлановаяСтоимость";
					СуммарныйПоказатель = МассивСтрок[0].ПлановаяСтоимость;
				Иначе
					ИмяПоказателя		= "Коэффициент";
					СуммарныйПоказатель = МассивСтрок[0].Коэффициент;
				КонецЕсли;
			Иначе	
				СтруктураПоиска = Новый Структура("МетодРаспределения, НоменклатурнаяГруппа",
					Перечисления.МетодыРаспределенияСтоимостиПроизводства.ПустаяСсылка(),
					СтрокаНоменклатурнойГруппы.НоменклатурнаяГруппа);
				МассивСтрок = ДеревоДляРасчетаТауДоп.Строки.НайтиСтроки(СтруктураПоиска, Истина);
				ИмяПоказателя       = "ПлановаяСтоимость";
				СуммарныйПоказатель = МассивСтрок[0].ПлановаяСтоимость;
			КонецЕсли;
			
			МассивКоэффициентов = Новый Массив;
			Для Каждого СтрокаНоменклатуры Из СтрокаНоменклатурнойГруппы.Строки Цикл	
				Если СуммарныйПоказатель <> 0 Тогда
					СтрокаПоказателя = МассивСтрок[0].Строки.Найти(СтрокаНоменклатуры.Номенклатура, "Номенклатура", Ложь);
					МассивКоэффициентов.Добавить(СтрокаПоказателя[ИмяПоказателя]);
				Иначе
					МассивКоэффициентов.Добавить(1); // равномерно по всем строкам
				КонецЕсли;
			КонецЦикла;
			
			// Для расчета коэффициентов Тау распределим единицу (100%) пропорционально полученным коэффициентам.
			МассивКоэффициентовТау = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(1, МассивКоэффициентов);
			СтрокаНоменклатурнойГруппы.Строки.ЗагрузитьКолонку(МассивКоэффициентовТау, "Тау");
			
		Иначе
			Для Каждого СтрокаНоменклатуры Из СтрокаНоменклатурнойГруппы.Строки Цикл
				СтрокаНоменклатуры.Тау = 1;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Тэтта - Коэффициент распределения стоимости производства в рамках подразделения, направления деятельности,
// внутри номенклатурной группы, на субсчете 105 на единицу продукции.
//
Функция РассчитатьКоэффициентыТэтта(СтрокаДляРасчетаТау, СтрокаДляРасчетаТэтта)
	
	ТаблицаТэтта = Новый ТаблицаЗначений;
	ТаблицаТэтта.Колонки.Добавить("Подразделение",	         Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаТэтта.Колонки.Добавить("НаправлениеДеятельности", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ТаблицаТэтта.Колонки.Добавить("НоменклатурнаяГруппа",    Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаТэтта.Колонки.Добавить("Номенклатура",            Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаТэтта.Колонки.Добавить("Счет105",                 Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаТэтта.Колонки.Добавить("КПС105",                  Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаТэтта.Колонки.Добавить("Тэтта",                   Новый ОписаниеТипов("Число"));
	
	Если СтрокаДляРасчетаТау = Неопределено Тогда
		Возврат ТаблицаТэтта;
	КонецЕсли;
	
	Для Каждого СтрокаПодразделения Из СтрокаДляРасчетаТэтта.Строки Цикл
		Для Каждого СтрокаНаправленияДеятельности Из СтрокаПодразделения.Строки Цикл
			Для Каждого СтрокаНоменклатурнойГруппы Из СтрокаНаправленияДеятельности.Строки Цикл
				
				МассивКоэффициентов = Новый Массив;
				Для Каждого СтрокаСчета Из СтрокаНоменклатурнойГруппы.Строки Цикл
					Для Каждого СтрокаКПС Из СтрокаСчета.Строки Цикл
						Для Каждого СтрокаНоменклатуры Из СтрокаКПС.Строки Цикл
							
							СтруктураПоиска = Новый Структура("НоменклатурнаяГруппа, Номенклатура",
								СтрокаНоменклатурнойГруппы.НоменклатурнаяГруппа, СтрокаНоменклатуры.Номенклатура);
							МассивСтрок = СтрокаДляРасчетаТау.Строки.НайтиСтроки(СтруктураПоиска, Истина);
							
							МассивКоэффициентов.Добавить(СтрокаНоменклатуры.Количество * МассивСтрок[0].Тау);
							
							НоваяСтрокаТэтта = ТаблицаТэтта.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрокаТэтта, СтрокаНоменклатуры);
							
						КонецЦикла;
					КонецЦикла;
				КонецЦикла;
				
				// Для расчета коэффициентов Тэтта распределим единицу (100%) пропорционально полученным коэффициентам.
				МассивКоэффициентовТэтта = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(1, МассивКоэффициентов);
				Если МассивКоэффициентовТэтта = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				КоличествоЭлементовМассива = МассивКоэффициентовТэтта.Количество();
				КоличествоСтрокТаблицы = ТаблицаТэтта.Количество();
				Для Ном = 1 По КоличествоЭлементовМассива Цикл
					// Устанавливаем значения коэффициентов в таблице в колонке Тэтта, начиная с последней строки.
					ТаблицаТэтта[КоличествоСтрокТаблицы - Ном].Тэтта = МассивКоэффициентовТэтта[КоличествоЭлементовМассива - Ном];
				КонецЦикла;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаТэтта;
	
КонецФункции

Функция ОпределитьКоэффициентТэтта(ТаблицаТэтта, Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа, Номенклатура, Счет, КПС)
	
	Отбор = Новый Структура("Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа, Номенклатура, Счет105, КПС105",
							Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа, Номенклатура, Счет, КПС);
	СтрокиТэтта = ТаблицаТэтта.НайтиСтроки(Отбор);
	
	Если СтрокиТэтта.Количество() <> 0 Тогда
		Возврат СтрокиТэтта[0].Тэтта;
	Иначе
		Возврат 0;
	КонецЕсли;

КонецФункции

// Альфа - коэффициент распределения косвенных затрат
//
Процедура РассчитатьКоэффициентыАльфа(СтрокаОбъектов, СтрокаОбороты109Косвенные, ПараметрыУчетаЗатрат)

	Если СтрокаОбороты109Косвенные = Неопределено Тогда
		ЗанулитьАльфаКолонки(СтрокаОбъектов, Истина, Истина);
		Возврат;
	КонецЕсли;
	
	СтрокаСписания = СтрокаОбороты109Косвенные.Строки.Найти("Списание", "Направление", Ложь);
	
	Если СтрокаСписания = Неопределено Тогда
		ЗанулитьАльфаКолонки(СтрокаОбъектов, Истина, Истина);
	Иначе	
		ЗаполнитьАльфаКолонки(СтрокаОбъектов, СтрокаСписания, "АльфаОПЗ", ПараметрыУчетаЗатрат);
		ЗаполнитьАльфаКолонки(СтрокаОбъектов, СтрокаСписания, "АльфаОХЗ", ПараметрыУчетаЗатрат);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗанулитьАльфаКолонки(СтрокаДерева, АльфаОПЗ = Ложь, АльфаОХЗ = Ложь)
	
	Для каждого СтрокаДетальная из СтрокаДерева.Строки Цикл
		Если АльфаОПЗ Тогда
			СтрокаДетальная.АльфаОПЗ = 0;
		КонецЕсли;
		Если АльфаОХЗ Тогда
			СтрокаДетальная.АльфаОХЗ = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьАльфаКолонки(СтрокаОбъектовКФО, СтрокаСписания, ИмяКолонки, ПараметрыУчетаЗатрат)
	
	Если ИмяКолонки = "АльфаОХЗ" Тогда
		ОбнулитьОХЗ = Истина;
		ОбнулитьОПЗ = Ложь;
		ИмяСекции   = "ОХЗ";
		ЕстьНаправлениеДеятельности = ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы;
		ЕстьПодразделение           = ПараметрыУчетаЗатрат.ЕстьПодразделениеОбщехозяйственныеРасходы;
	Иначе
		ОбнулитьОХЗ = Ложь;
		ОбнулитьОПЗ = Истина;
		ИмяСекции   = "ОПЗ";
		ЕстьНаправлениеДеятельности = ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы;
		ЕстьПодразделение           = ПараметрыУчетаЗатрат.ЕстьПодразделениеНакладныеРасходы;
	КонецЕсли;
	
	СтрокаКЗ = СтрокаСписания.Строки.Найти(ИмяСекции, "ОПЗ_ОХЗ");
	Если СтрокаКЗ = Неопределено Тогда
		ЗанулитьАльфаКолонки(СтрокаОбъектовКФО, ОбнулитьОПЗ, ОбнулитьОХЗ);
		Возврат;
	КонецЕсли;
	
	СтрокаОткудаКудаПЗ = СтрокаКЗ.Строки.Найти("ПЗ", "ОткудаКуда");
	Если СтрокаОткудаКудаПЗ = Неопределено Тогда
		ЗанулитьАльфаКолонки(СтрокаОбъектовКФО, ОбнулитьОПЗ, ОбнулитьОХЗ);
		Возврат;
	КонецЕсли;
	
	ТаблицаСписаниеОбщихЗатрат = Новый ТаблицаЗначений;
	ТаблицаСписаниеОбщихЗатрат.Колонки.Добавить("НоменклатурнаяГруппа",      Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаСписаниеОбщихЗатрат.Колонки.Добавить("НаправлениеДеятельности",   Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ТаблицаСписаниеОбщихЗатрат.Колонки.Добавить("Подразделение",             Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаСписаниеОбщихЗатрат.Колонки.Добавить("КлючЗатрат",                Новый ОписаниеТипов("Строка"));
	ТаблицаСписаниеОбщихЗатрат.Колонки.Добавить("Сумма",                     Новый ОписаниеТипов("Число"));
	Для каждого СтрокаОткудаКуда из СтрокаКЗ.Строки Цикл
		Для каждого СтрокаВидЗатрат из СтрокаОткудаКуда.Строки Цикл
			Для каждого СтрокаПодразделение из СтрокаВидЗатрат.Строки Цикл
				Для каждого СтрокаНаправлениеДеятельности из СтрокаПодразделение.Строки Цикл
					Для каждого СтрокаДетальные из СтрокаНаправлениеДеятельности.Строки Цикл
						
						НоваяСтрока1 = ТаблицаСписаниеОбщихЗатрат.Добавить();
						НоваяСтрока1.НоменклатурнаяГруппа    = СтрокаДетальные.КорСубконто1;
						НоваяСтрока1.НаправлениеДеятельности = СтрокаДетальные.НаправлениеДеятельности;
						НоваяСтрока1.Подразделение           = СтрокаДетальные.Подразделение;
						НоваяСтрока1.КлючЗатрат              = СтрокаДетальные.КлючЗатрат;
						НоваяСтрока1.Сумма                   = СтрокаДетальные.СуммаОборотКт;
						
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ТаблицаСписаниеОбщихЗатрат.Свернуть("НоменклатурнаяГруппа, НаправлениеДеятельности, Подразделение, КлючЗатрат", "Сумма");
	
	ТаблицаСписаниеОбщихЗатратНаПрямые = Новый ТаблицаЗначений;
	ТаблицаСписаниеОбщихЗатратНаПрямые.Колонки.Добавить("НоменклатурнаяГруппа",      Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаСписаниеОбщихЗатратНаПрямые.Колонки.Добавить("НаправлениеДеятельности",   Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ТаблицаСписаниеОбщихЗатратНаПрямые.Колонки.Добавить("НаправлениеДеятельностиПЗ", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ТаблицаСписаниеОбщихЗатратНаПрямые.Колонки.Добавить("Подразделение",             Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаСписаниеОбщихЗатратНаПрямые.Колонки.Добавить("ПодразделениеПЗ",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаСписаниеОбщихЗатратНаПрямые.Колонки.Добавить("КлючЗатрат",                Новый ОписаниеТипов("Строка"));
	ТаблицаСписаниеОбщихЗатратНаПрямые.Колонки.Добавить("Сумма",                     Новый ОписаниеТипов("Число"));
	Для каждого СтрокаВидЗатрат из СтрокаОткудаКудаПЗ.Строки Цикл
		Для каждого СтрокаПодразделение из СтрокаВидЗатрат.Строки Цикл
			Для каждого СтрокаНаправлениеДеятельности из СтрокаПодразделение.Строки Цикл
				Для каждого СтрокаДетальные из СтрокаНаправлениеДеятельности.Строки Цикл
					
					НоваяСтрока = ТаблицаСписаниеОбщихЗатратНаПрямые.Добавить();
					НоваяСтрока.НоменклатурнаяГруппа      = СтрокаДетальные.КорСубконто1;
					НоваяСтрока.НаправлениеДеятельности   = СтрокаДетальные.НаправлениеДеятельности;
					НоваяСтрока.НаправлениеДеятельностиПЗ = СтрокаДетальные.КорСубконто3;
					НоваяСтрока.Подразделение             = СтрокаДетальные.Подразделение;
					НоваяСтрока.ПодразделениеПЗ           = СтрокаДетальные.КорПодразделение;
					НоваяСтрока.КлючЗатрат                = СтрокаДетальные.КлючЗатрат;
					НоваяСтрока.Сумма                     = СтрокаДетальные.СуммаОборотКт;
				
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ТаблицаСписаниеОбщихЗатратНаПрямые.Свернуть("НоменклатурнаяГруппа, НаправлениеДеятельности, НаправлениеДеятельностиПЗ, Подразделение, ПодразделениеПЗ, КлючЗатрат", "Сумма");
	
	ТаблицаИтогов = ТаблицаСписаниеОбщихЗатратНаПрямые.Скопировать();
	ТаблицаИтогов.Свернуть("Подразделение, НаправлениеДеятельности, КлючЗатрат", "Сумма");
	Для каждого СтрокаИтогов из ТаблицаИтогов Цикл
		
		СтруктураПоиска = Новый Структура("Подразделение, НаправлениеДеятельности, КлючЗатрат",
			СтрокаИтогов.Подразделение, СтрокаИтогов.НаправлениеДеятельности, СтрокаИтогов.КлючЗатрат);
		
		// Рассчитаем общую сумму списания общих затрат.
		СуммаЗатратВсего = 0;
		СтрокиЗатратВсего = ТаблицаСписаниеОбщихЗатрат.НайтиСтроки(СтруктураПоиска);
		Для Каждого Строка из СтрокиЗатратВсего Цикл
			СуммаЗатратВсего = СуммаЗатратВсего + Строка.Сумма;
		КонецЦикла;
		Если СуммаЗатратВсего = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Рассчитаем сумму списания общих затрат только на прямые.
		СуммаЗатратНаПрямые = 0;
		СтрокиЗатратНаПрямые = ТаблицаСписаниеОбщихЗатратНаПрямые.НайтиСтроки(СтруктураПоиска);
		Для Каждого Строка из СтрокиЗатратНаПрямые Цикл
			СуммаЗатратНаПрямые = СуммаЗатратНаПрямые + Строка.Сумма;
		КонецЦикла;
		Если СуммаЗатратНаПрямые = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаАльф  = 0;
		МаксИндекс = СтрокиЗатратНаПрямые.ВГраница();
		Для к = 0 по МаксИндекс Цикл
			
			Если (к = МаксИндекс) И (СуммаЗатратНаПрямые = СуммаЗатратВсего) Тогда
				КоэффициентАльфа = 1 - СуммаАльф;
			Иначе
				КоэффициентАльфа = СтрокиЗатратНаПрямые[к].Сумма / СуммаЗатратВсего;
			КонецЕсли;	
			СуммаАльф = СуммаАльф + КоэффициентАльфа;
			
			СтруктураПоиска = Новый Структура("Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа, КлючЗатрат", 
				СтрокиЗатратНаПрямые[к].ПодразделениеПЗ,
				СтрокиЗатратНаПрямые[к].НаправлениеДеятельностиПЗ,
				СтрокиЗатратНаПрямые[к].НоменклатурнаяГруппа,
				СтрокиЗатратНаПрямые[к].КлючЗатрат);
			МассивСтрок = СтрокаОбъектовКФО.Строки.НайтиСтроки(СтруктураПоиска);
			Для каждого ТекЭлемент из МассивСтрок Цикл
				ТекЭлемент[ИмяКолонки] = КоэффициентАльфа;
			КонецЦикла;
			
			СтруктураПоиска = Новый Структура("КорПодразделение, КорСубконто3, КорСубконто1, КлючЗатрат", 
				СтрокиЗатратНаПрямые[к].ПодразделениеПЗ,
				СтрокиЗатратНаПрямые[к].НаправлениеДеятельностиПЗ,
				СтрокиЗатратНаПрямые[к].НоменклатурнаяГруппа,
				СтрокиЗатратНаПрямые[к].КлючЗатрат);
			Если ЕстьНаправлениеДеятельности Тогда
				СтруктураПоиска.Вставить("НаправлениеДеятельности", СтрокиЗатратНаПрямые[к].НаправлениеДеятельности);
			КонецЕсли;
			Если ЕстьПодразделение Тогда
				СтруктураПоиска.Вставить("Подразделение", СтрокиЗатратНаПрямые[к].Подразделение);
			КонецЕсли;
			МассивСтрок = СтрокаКЗ.Строки.НайтиСтроки(СтруктураПоиска, Истина);
			Для каждого ТекЭлемент из МассивСтрок Цикл
				ТекЭлемент[ИмяКолонки] = КоэффициентАльфа;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

// Гамма - доля по количеству продукции, списанной на себестоимость
//
Функция РассчитатьКоэффициентыГамма(СтрокаОбороты105, СтрокаНачальныеОстатки, СтрокаОбъектов, ДеревоОбороты105, ПараметрыУчетаЗатрат)
	
	ТаблицаКоэффициентовГамма = Новый ТаблицаЗначений;
	ТаблицаКоэффициентовГамма.Колонки.Добавить("КорПодразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаКоэффициентовГамма.Колонки.Добавить("Номенклатура",     Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаКоэффициентовГамма.Колонки.Добавить("Счет",             Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаКоэффициентовГамма.Колонки.Добавить("КПС",              Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	
	СтрокаСвертки = "";
	МаксИндекс    = СтрокаОбъектов.Строки.Количество() - 1;
	ТекущийИндекс = -1;
	Для каждого СтрокаДетальная из СтрокаОбъектов.Строки Цикл
		ТекущийИндекс = ТекущийИндекс + 1;
		ИмяКолонки = "k" + Формат(ТекущийИндекс, "ЧГ=");
		ТаблицаКоэффициентовГамма.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Число"));
		СтрокаСвертки = СтрокаСвертки + ИмяКолонки + ?(ТекущийИндекс = МаксИндекс, "", ",");
	КонецЦикла;
	
	Если СтрокаОбороты105 = Неопределено Тогда
		Возврат ТаблицаКоэффициентовГамма;
	КонецЕсли;
	
	СтрокаСписания105 = СтрокаОбороты105.Строки.Найти("Списание", "Направление");
	Если СтрокаСписания105 = Неопределено Тогда
		Возврат ТаблицаКоэффициентовГамма;
	КонецЕсли;
	
	Для Каждого СтрокаОткудаКуда из СтрокаСписания105.Строки Цикл
		Для Каждого СтрокаПодразделение из СтрокаОткудаКуда.Строки Цикл
			Для Каждого СтрокаДетальная из СтрокаПодразделение.Строки Цикл
				ЗаполнитьЗначенияСвойств(ТаблицаКоэффициентовГамма.Добавить(), СтрокаДетальная, "КорПодразделение, Номенклатура, Счет, КПС");
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаКоэффициентовГамма.Свернуть("КорПодразделение, Номенклатура, Счет, КПС", СтрокаСвертки);
	Для каждого СтрокаГамма из ТаблицаКоэффициентовГамма Цикл
		
		ИндексОбъекта = -1;
		
		Для каждого СтрокаОбъекта из СтрокаОбъектов.Строки Цикл
			
			ИндексОбъекта = ИндексОбъекта + 1;
			
			СтруктураКоличеств = ВернутьСтруктуруКоличеств(
				СтрокаОбороты105, СтрокаНачальныеОстатки,
				СтрокаГамма.Номенклатура, СтрокаГамма.Счет, СтрокаГамма.КПС,
				СтрокаОбъекта.НоменклатурнаяГруппа, СтрокаОбъекта.КлючЗатрат, СтрокаОбъекта.НаправлениеДеятельности, СтрокаОбъекта.Подразделение,
				ПараметрыУчетаЗатрат);
			
			Если СтруктураКоличеств.К_исх = 0 Тогда
				СтрокаГамма["k" + Формат(ИндексОбъекта, "ЧГ=")] = 0;	
			Иначе
				СтруктураАльф = ВернутьСтруктуруАльф(СтрокаОбъектов, СтрокаОбъекта.НоменклатурнаяГруппа, СтрокаОбъекта.КлючЗатрат, СтрокаОбъекта.НаправлениеДеятельности);
				СтрокаГамма["k" + Формат(ИндексОбъекта, "ЧГ=")] = (СтруктураКоличеств.К_гп_пз 
																+ СтруктураКоличеств.К_гп_опз * СтруктураАльф.АльфаОПЗ 
																+ СтруктураКоличеств.К_гп_охз * СтруктураАльф.АльфаОХЗ) / СтруктураКоличеств.К_исх;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаКоэффициентовГамма;
	
КонецФункции

Функция ВернутьСтруктуруКоличеств(СтрокаОбороты105, СтрокаНачальныеОстатки,
			Номенклатура, Счет, КПС, НоменклатурнаяГруппа, КлючЗатрат, НаправлениеДеятельности, Подразделение,
			ПараметрыУчетаЗатрат)
	
	СтруктураПоиска		= Новый Структура("Номенклатура, Счет, КПС", Номенклатура, Счет, КПС);
	К_исх 		= 0;
	К_гп_пз 	= 0;
	К_гп_опз 	= 0;
	К_гп_охз	= 0;
	
	// Учтем в К_исх начальные остатки на счете 105
	Если СтрокаНачальныеОстатки <> Неопределено Тогда
		СтрокаСчета105 = СтрокаНачальныеОстатки.Строки.Найти("105", "НаименованиеСчета");
		Если СтрокаСчета105 <> Неопределено Тогда
			МассивСтрокНО = СтрокаСчета105.Строки.НайтиСтроки(СтруктураПоиска, Ложь);
			Для каждого СтрокаНО из МассивСтрокНО Цикл
				К_исх = К_исх + СтрокаНО.Количество;
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;	
	
	// Учтем в К_исх количество поступившей номенклатуры на счет 105
	СтрокаПоступления105 = СтрокаОбороты105.Строки.Найти("Поступление", "Направление");
	Если СтрокаПоступления105 <> Неопределено Тогда
		Для каждого СтрокаОткудаКуда Из СтрокаПоступления105.Строки Цикл
			Для каждого СтрокаПодразделение Из СтрокаОткудаКуда.Строки Цикл
				МассивСтрокПост = СтрокаПодразделение.Строки.НайтиСтроки(СтруктураПоиска, Ложь);
				Для каждого СтрокаПост из МассивСтрокПост Цикл
					К_исх = К_исх + СтрокаПост.КоличествоОборотДт;
				КонецЦикла;	
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	// Теперь в ключе "К_исх" находится общее количество номенклатуры Нач. остаток + Количество поступивших
	
	СтруктураПоискаПЗ = Новый Структура("ОткудаКуда, Номенклатура, Счет, КПС, КорСубконто1, КлючЗатрат", 
										"ПЗ", 
										Номенклатура, 
										Счет, 
										КПС, 
										НоменклатурнаяГруппа, 
										КлючЗатрат);
	Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
		СтруктураПоискаПЗ.Вставить("КорСубконто3", НаправлениеДеятельности);
	КонецЕсли;
	
	СтруктураПоискаОПЗ = Новый Структура("ОткудаКуда, Номенклатура, Счет, КПС, КлючЗатрат", 
										"ОПЗ", 
										Номенклатура, 
										Счет, 
										КПС, 
										КлючЗатрат);
	Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы Тогда
		СтруктураПоискаОПЗ.Вставить("КорСубконто2", НаправлениеДеятельности);
	КонецЕсли;
	
	СтруктураПоискаОХЗ = Новый Структура("ОткудаКуда, Номенклатура, Счет, КПС, КлючЗатрат", 
										"ОХЗ", 
										Номенклатура, 
										Счет, 
										КПС, 
										КлючЗатрат);
	Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы Тогда
		СтруктураПоискаОХЗ.Вставить("КорСубконто3", НаправлениеДеятельности);
	КонецЕсли;
	
	СтрокаСписания105 = СтрокаОбороты105.Строки.Найти("Списание", "Направление");
	Для каждого СтрокаОткудаКуда из СтрокаСписания105.Строки Цикл
		
		СтрокаПодразделение = СтрокаОткудаКуда.Строки.Найти(Подразделение, "КорПодразделение");
		Если СтрокаПодразделение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрокСписПЗ = СтрокаПодразделение.Строки.НайтиСтроки(СтруктураПоискаПЗ, Ложь);
		Для каждого ТекСтрокаСписПЗ из МассивСтрокСписПЗ Цикл
			К_гп_пз = К_гп_пз + ТекСтрокаСписПЗ.КоличествоОборотКт;
		КонецЦикла;	
		
		МассивСтрокСписОПЗ = СтрокаПодразделение.Строки.НайтиСтроки(СтруктураПоискаОПЗ, Ложь);
		Для каждого ТекСтрокаСписОПЗ из МассивСтрокСписОПЗ Цикл
			К_гп_опз = К_гп_опз + ТекСтрокаСписОПЗ.КоличествоОборотКт;
		КонецЦикла;	
		
		МассивСтрокСписОХЗ = СтрокаПодразделение.Строки.НайтиСтроки(СтруктураПоискаОХЗ, Ложь);
		Для каждого ТекСтрокаСписОХЗ из МассивСтрокСписОХЗ Цикл
			К_гп_охз = К_гп_охз + ТекСтрокаСписОХЗ.КоличествоОборотКт;
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат Новый Структура("К_гп_пз, К_гп_опз, К_гп_охз, К_исх", К_гп_пз, К_гп_опз, К_гп_охз, К_исх);

КонецФункции

Функция ВернутьСтруктуруАльф(СтрокаОбъектов, НоменклатурнаяГруппа, КлючЗатрат, НаправлениеДеятельности)
	
	Структура = Новый Структура("АльфаОПЗ, АльфаОХЗ", 0,0);
	
	СтруктураПоиска = Новый Структура("НоменклатурнаяГруппа, КлючЗатрат, НаправлениеДеятельности",
									  НоменклатурнаяГруппа, 
									  КлючЗатрат, 
									  НаправлениеДеятельности);
	СтрокиНоменклатурнойГруппы = СтрокаОбъектов.Строки.НайтиСтроки(СтруктураПоиска);
	Если СтрокиНоменклатурнойГруппы.Количество() = 0 Тогда
		Структура.АльфаОПЗ = 0;
		Структура.АльфаОХЗ = 0;
	Иначе
		Структура.АльфаОПЗ = СтрокиНоменклатурнойГруппы[0].АльфаОПЗ;
		Структура.АльфаОХЗ = СтрокиНоменклатурнойГруппы[0].АльфаОХЗ;
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции

// Формирует матрицу системы линейных уравнений
//
Функция СформироватьМатрицуСистемыУравнений(Параметры)
	
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число");
	
	МатрицаОбъектов = Новый ТаблицаЗначений;
	МатрицаОбъектов.Колонки.Добавить("Подразделение",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	МатрицаОбъектов.Колонки.Добавить("НоменклатурнаяГруппа",    Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	МатрицаОбъектов.Колонки.Добавить("ТипНоменклатуры",         Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНоменклатуры"));
	МатрицаОбъектов.Колонки.Добавить("ВидЗатрат",               Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	МатрицаОбъектов.Колонки.Добавить("КЭК",                     Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	МатрицаОбъектов.Колонки.Добавить("КлючЗатрат",              Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(12)));
	МатрицаОбъектов.Колонки.Добавить("НаправлениеДеятельности", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	МатрицаОбъектов.Колонки.Добавить("ВидДеятельностиНУ",       Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДеятельностиДляНалоговогоУчетаЗатрат"));
	МатрицаОбъектов.Колонки.Добавить("Сумма",                   ОписаниеТиповЧисло);
	МатрицаОбъектов.Колонки.Добавить("АльфаОПЗ",                ОписаниеТиповЧисло);
	МатрицаОбъектов.Колонки.Добавить("АльфаОХЗ",                ОписаниеТиповЧисло);
	
	Параметры.НачИндексДинамическихКолонок = МатрицаОбъектов.Колонки.Количество();
	
	// Добавим строки матрицы.
	Для Каждого СтрокаДетальная Из Параметры.СтрокаОбъектов.Строки Цикл
		ЗаполнитьЗначенияСвойств(МатрицаОбъектов.Добавить(), СтрокаДетальная);
	КонецЦикла;
	
	// Добавим колонки для коэффициентов и свободного члена.
	МаксИндекс = МатрицаОбъектов.Количество() - 1;
	Для п = 0 по МаксИндекс Цикл
		ИмяКолонки = "k" + Формат(п, "ЧН=; ЧГ=");
		МатрицаОбъектов.Колонки.Добавить(ИмяКолонки, ОписаниеТиповЧисло);
	КонецЦикла;
	МатрицаОбъектов.Колонки.Добавить("q", ОписаниеТиповЧисло);
	
	// Рассчитаем значения коэффициентов и свободного члена.
	Для Индекс = 0 По МаксИндекс Цикл // цикл по строкам матрицы (объектам)
		
		СтрокаОбъекта = МатрицаОбъектов[Индекс];
		
		Если Параметры.ВидУчета = "НУ" И СтрокаОбъекта.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты Тогда
			КоэффициентРаспределения = 1 - Параметры.ДокументОбъект.ДоляЕНВД;
		Иначе
			КоэффициентРаспределения = 1;
		КонецЕсли;
		
		Для п = 0 по МаксИндекс Цикл  // цикл по колонкам матрицы (коэффициентам)
			
			ИндексКолонкиКоэффициента = Параметры.НачИндексДинамическихКолонок + п;
			Если п = Индекс Тогда
				Коэффициент = ВычислитьКоэффициент(Индекс, п, Параметры.ТаблицаКоэффициентовГамма, Параметры.ТаблицаКоэффициентовТэтта, МатрицаОбъектов);
				СтрокаОбъекта[ИндексКолонкиКоэффициента] = 1 + КоэффициентРаспределения * Коэффициент;
 			Иначе
				Если Параметры.МассивВлияющихНомГрупп.Найти(МатрицаОбъектов[п].НоменклатурнаяГруппа) = Неопределено Тогда
					СтрокаОбъекта[ИндексКолонкиКоэффициента] = 0;
				Иначе
					Коэффициент = ВычислитьКоэффициент(Индекс, п, Параметры.ТаблицаКоэффициентовГамма, Параметры.ТаблицаКоэффициентовТэтта, МатрицаОбъектов);
					СтрокаОбъекта[ИндексКолонкиКоэффициента] = КоэффициентРаспределения * Коэффициент;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		СтрокаОбъекта["q"] = ВычислитьСвободныйЧлен(Индекс, СтрокаОбъекта, КоэффициентРаспределения, Параметры);
		
	КонецЦикла;
	
	Возврат МатрицаОбъектов;
	
КонецФункции

Функция ВычислитьКоэффициент(Индекс, п, ТаблицаКоэффициентовГамма, ТаблицаКоэффициентовТэтта, МатрицаОбъектов)
	
	Результат  = 0;
	ИмяКолонки = "k" + Формат(Индекс, "ЧГ=");
	Для Каждого СтрокаГамма Из ТаблицаКоэффициентовГамма Цикл
		
		КоэффициентТэтта = ОпределитьКоэффициентТэтта(ТаблицаКоэффициентовТэтта,
			МатрицаОбъектов[п].Подразделение,
			МатрицаОбъектов[п].НаправлениеДеятельности,
			МатрицаОбъектов[п].НоменклатурнаяГруппа,
			СтрокаГамма.Номенклатура,
			СтрокаГамма.Счет,
			СтрокаГамма.КПС);
		
		Результат = Результат + СтрокаГамма[ИмяКолонки] * КоэффициентТэтта;
		
	КонецЦикла;
	
	Возврат (- Результат);
	
КонецФункции

Функция ВычислитьСвободныйЧлен(Индекс, СтрокаОбъекта, КоэффициентРаспределения, Параметры)

	НоменклатурнаяГруппа    = СтрокаОбъекта.НоменклатурнаяГруппа;
	КлючЗатрат              = СтрокаОбъекта.КлючЗатрат;
	НаправлениеДеятельности = СтрокаОбъекта.НаправлениеДеятельности;
	Подразделение           = СтрокаОбъекта.Подразделение;
	АльфаОПЗ                = СтрокаОбъекта.АльфаОПЗ;
	АльфаОХЗ                = СтрокаОбъекта.АльфаОХЗ;
	
	Опз = 0; // прямые затраты
	Если Параметры.СтрокаОбороты109ПР <> Неопределено Тогда
		СтрокаПоступления = Параметры.СтрокаОбороты109ПР.Строки.Найти("Поступление", "Направление", Ложь);
		Если СтрокаПоступления <> Неопределено Тогда
			Опз = Опз + РассчитатьПрямыеЗатраты(СтрокаПоступления, "Прочее", НоменклатурнаяГруппа, КлючЗатрат, НаправлениеДеятельности, Подразделение, Параметры);
			Опз = Опз + РассчитатьПрямыеЗатраты(СтрокаПоступления, "105",    НоменклатурнаяГруппа, КлючЗатрат, НаправлениеДеятельности, Подразделение, Параметры);
		КонецЕсли;
	КонецЕсли;
	
	// Рассчитаем некорректируемые обороты.
	Оопз = 0; // общепроизводственные затраты
	Оохз = 0; // общехозяйственные затраты
	Если Параметры.СтрокаОбороты109Косвенные <> Неопределено Тогда
		СтрокаПоступления = Параметры.СтрокаОбороты109Косвенные.Строки.Найти("Поступление", "Направление", Ложь);
		Если СтрокаПоступления <> Неопределено Тогда
			
			Оопз = Оопз + РасчитатьКосвенныеЗатраты(СтрокаПоступления, "ОПЗ", "Прочее", КлючЗатрат, НаправлениеДеятельности, Подразделение, Параметры);
			Оопз = Оопз + РасчитатьКосвенныеЗатраты(СтрокаПоступления, "ОПЗ", "105",    КлючЗатрат, НаправлениеДеятельности, Подразделение, Параметры);
			
			Оохз = Оохз + РасчитатьКосвенныеЗатраты(СтрокаПоступления, "ОХЗ", "Прочее", КлючЗатрат, НаправлениеДеятельности, Подразделение, Параметры);
			Оохз = Оохз + РасчитатьКосвенныеЗатраты(СтрокаПоступления, "ОХЗ", "105",    КлючЗатрат, НаправлениеДеятельности, Подразделение, Параметры);
			
		КонецЕсли;
	КонецЕсли;
	
	НОонп = 0;
	Если Параметры.СтрокаНачальныеОстатки <> Неопределено Тогда
		
		СтрокаНачОстатков105 = Параметры.СтрокаНачальныеОстатки.Строки.Найти("105", "НаименованиеСчета");
		СтрокаНачОстатков109 = Параметры.СтрокаНачальныеОстатки.Строки.Найти("109", "НаименованиеСчета");
		
		Если СтрокаНачОстатков109 <> Неопределено Тогда
			СтруктураПоискаОстатков109 = Новый Структура("Номенклатура, КлючЗатрат, НаправлениеДеятельности", НоменклатурнаяГруппа, КлючЗатрат, НаправлениеДеятельности);
			МассивСтрокНачОстатков109  = СтрокаНачОстатков109.Строки.НайтиСтроки(СтруктураПоискаОстатков109, Истина);
			Для каждого СтрокаНачОст109 из МассивСтрокНачОстатков109 Цикл
				НОонп = НОонп + СтрокаНачОст109.Сумма;
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		СтрокаНачОстатков105 = Неопределено;
		СтрокаНачОстатков109 = Неопределено;
	КонецЕсли;
	
	ИмяКолонки = "k" + Формат(Индекс, "ЧГ=");
	НОогп = 0;
	КОонп = 0;
	Для Каждого СтрокаГамма Из Параметры.ТаблицаКоэффициентовГамма Цикл
		
		НО = 0;
		Если СтрокаНачОстатков105 <> Неопределено Тогда
			СтруктураПоискаОстатков105 = Новый Структура("Номенклатура, Счет, КПС", СтрокаГамма.Номенклатура, СтрокаГамма.Счет, СтрокаГамма.КПС);
			МассивСтрокНачОстатков105 = СтрокаНачОстатков105.Строки.НайтиСтроки(СтруктураПоискаОстатков105, Истина);
			Для каждого ТекЭлементНО из МассивСтрокНачОстатков105 Цикл
				НО = НО + ТекЭлементНО.Сумма;
			КонецЦикла;
		КонецЕсли;
		НОогп = НОогп + СтрокаГамма[ИмяКолонки] * НО;
		
		КО = 0;
		Если Параметры.СтрокаКонечныеОстатки <> Неопределено Тогда
			
			СтрокаПодразделение = Параметры.СтрокаКонечныеОстатки.Строки.Найти(Подразделение, "Подразделение", Ложь);
			Если СтрокаПодразделение <> Неопределено Тогда
				
				СтрокаНаправлениеДеятельности = СтрокаПодразделение.Строки.Найти(НаправлениеДеятельности, "НаправлениеДеятельности", Ложь);
				Если СтрокаНаправлениеДеятельности <> Неопределено Тогда
					
					Для Каждого СтрокаНоменклатурнойГруппы Из СтрокаНаправлениеДеятельности.Строки Цикл
						
						КоэффициентТэтта = ОпределитьКоэффициентТэтта(Параметры.ТаблицаКоэффициентовТэтта,
							Подразделение,
							НаправлениеДеятельности,
							СтрокаНоменклатурнойГруппы.НоменклатурнаяГруппа,
							СтрокаГамма.Номенклатура,
							СтрокаГамма.Счет,
							СтрокаГамма.КПС);
						
						КО = КО + СтрокаНоменклатурнойГруппы.Сумма * КоэффициентТэтта;
						
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		КОонп = КОонп + СтрокаГамма[ИмяКолонки] * КО;
		
	КонецЦикла;
	
	Результат = НОонп + КоэффициентРаспределения * (Опз + АльфаОПЗ * Оопз + АльфаОХЗ * Оохз + НОогп - КОонп);
	
	Возврат Результат;
	
КонецФункции

Функция РассчитатьПрямыеЗатраты(ИсходнаяСтрока, ТипЗатрат, НоменклатурнаяГруппа, КлючЗатрат, НаправлениеДеятельности, Подразделение, Параметры)
	
	ЕстьНаправлениеДеятельности = Параметры.ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиСебестоимость;
	ЕстьПодразделение           = Параметры.ПараметрыУчетаЗатрат.ЕстьПодразделениеСебестоимость;
	НаправлениеДеятельности     = ?(ЕстьНаправлениеДеятельности, НаправлениеДеятельности, Справочники.НаправленияДеятельности.ПустаяСсылка());
	Подразделение               = ?(ЕстьПодразделение,           Подразделение,           Справочники.Подразделения.ПустаяСсылка());
	
	Отбор = Новый Структура("ОткудаКуда, НоменклатурнаяГруппа, КлючЗатрат, Подразделение, НаправлениеДеятельности",
							ТипЗатрат, НоменклатурнаяГруппа, КлючЗатрат, Подразделение, НаправлениеДеятельности);
	ДетальныеСтроки = ИсходнаяСтрока.Строки.НайтиСтроки(Отбор, Истина);
	
	Результат = 0;
	Для Каждого СтрокаДетальная из ДетальныеСтроки Цикл
		
		Если СтрокаДетальная.Строки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗатрат = "105" И Параметры.ТаблицаВыпущеннойПродукции.Найти(СтрокаДетальная.КорСубконто1, "Номенклатура") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = Результат + СтрокаДетальная.СуммаОборотДт;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция РасчитатьКосвенныеЗатраты(ИсходнаяСтрока, ВидКЗ, ТипЗатрат, КлючЗатрат, НаправлениеДеятельности, Подразделение, Параметры)
	
	Если ВидКЗ = "ОПЗ" Тогда
		ЕстьНаправлениеДеятельности = Параметры.ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы;
		ЕстьПодразделение           = Параметры.ПараметрыУчетаЗатрат.ЕстьПодразделениеНакладныеРасходы;
	Иначе // ВидКЗ = "ОХЗ"
		ЕстьНаправлениеДеятельности = Параметры.ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы;
		ЕстьПодразделение           = Параметры.ПараметрыУчетаЗатрат.ЕстьПодразделениеОбщехозяйственныеРасходы;
	КонецЕсли;
	НаправлениеДеятельности = ?(ЕстьНаправлениеДеятельности, НаправлениеДеятельности, Справочники.НаправленияДеятельности.ПустаяСсылка());
	Подразделение           = ?(ЕстьПодразделение,           Подразделение,           Справочники.Подразделения.ПустаяСсылка());
	
	Отбор = Новый Структура("ОПЗ_ОХЗ, ОткудаКуда, КлючЗатрат, Подразделение, НаправлениеДеятельности",
							ВидКЗ, ТипЗатрат, КлючЗатрат, Подразделение, НаправлениеДеятельности);
	ДетальныеСтроки = ИсходнаяСтрока.Строки.НайтиСтроки(Отбор, Истина);
	
	Результат = 0;
	Для каждого СтрокаДетальная из ДетальныеСтроки Цикл
		
		Если СтрокаДетальная.Строки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗатрат = "105" И Параметры.ТаблицаВыпущеннойПродукции.Найти(СтрокаДетальная.КорСубконто1, "Номенклатура") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = Результат + СтрокаДетальная.СуммаОборотДт;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Решение системы линейных уравнений
//
Процедура РешитьСистемуЛинейныхУравнений(МатрицаОбъектов, Параметры)
	
	НачальныйИндексДинамическихКолонок = Параметры.НачИндексДинамическихКолонок;
	МаксИндекс = МатрицаОбъектов.Количество() - 1;
	
	МатрицаОбъектов.Колонки.Добавить("X", Новый ОписаниеТипов("Число"));
	// Прямой ход
	Для п = 0 по МаксИндекс Цикл
		УстановитьГлавныйЭлементПоКолонке(МатрицаОбъектов, п, МаксИндекс, НачальныйИндексДинамическихКолонок);
		Делитель = МатрицаОбъектов[п][НачальныйИндексДинамическихКолонок + п];
		Для р = (п + 1) по МаксИндекс Цикл
			Если МатрицаОбъектов[р][НачальныйИндексДинамическихКолонок + п] = 0 Тогда
				Продолжить;
			КонецЕсли;	
			
			Множитель = (- МатрицаОбъектов[р][НачальныйИндексДинамическихКолонок + п]) / Делитель;
			Для т = п по МаксИндекс Цикл
				МатрицаОбъектов[р][НачальныйИндексДинамическихКолонок + т] = МатрицаОбъектов[р][НачальныйИндексДинамическихКолонок + т] 
																			+  МатрицаОбъектов[п][НачальныйИндексДинамическихКолонок + т] * Множитель;
			КонецЦикла;	
			МатрицаОбъектов[р]["q"] = МатрицаОбъектов[р]["q"] +  МатрицаОбъектов[п]["q"] * Множитель;
		КонецЦикла;	
	КонецЦикла;	
	
	// Обратный ход
	п = МаксИндекс;
	Пока п >= 0 Цикл
		Результат = МатрицаОбъектов[п]["q"];
		Для р = (п +1) по МаксИндекс Цикл
			Если МатрицаОбъектов[п][НачальныйИндексДинамическихКолонок + р] <> 0 Тогда
				Результат = Результат - МатрицаОбъектов[п][НачальныйИндексДинамическихКолонок + р] * МатрицаОбъектов[р]["X"];
			КонецЕсли;
		КонецЦикла;	
		МатрицаОбъектов[п]["X"] = ?(МатрицаОбъектов[п][НачальныйИндексДинамическихКолонок + п] = 0, 0,Результат / МатрицаОбъектов[п][НачальныйИндексДинамическихКолонок + п]);
		п = п - 1;
	КонецЦикла;	
	
	Для п = 0 по МаксИндекс Цикл
		МатрицаОбъектов[п]["X"] = Окр(МатрицаОбъектов[п]["X"], 2);
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьГлавныйЭлементПоКолонке(МатрицаОбъектов, п, МаксИндекс, НачальныйИндексДинамическихКолонок)
	
	ТекущееЗначение = МодульЧисла(МатрицаОбъектов[п][НачальныйИндексДинамическихКолонок + п]);
	Для р = (п + 1) по МаксИндекс Цикл
		Если МодульЧисла(МатрицаОбъектов[р][НачальныйИндексДинамическихКолонок + п]) > ТекущееЗначение Тогда 
			МатрицаОбъектов.Сдвинуть(р, (п - р));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция МодульЧисла(Число) Экспорт

	Возврат ?(Число < 0, -Число, Число);

КонецФункции

Процедура РасчитатьФактическиеОбороты(МатрицаОбъектов, СтрокаКонечныеОстатки, ВидУчета)

	Если СтрокаКонечныеОстатки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидУчета = "НУ" Тогда
		// В НУ не ведется учет затрат по КЭК, поэтому нет смысла использовать комплексное поле КлючЗатрат.
		СтруктураПоиска = Новый Структура("ВидЗатрат, Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа");
	Иначе
		// Бух. учет.
		СтруктураПоиска = Новый Структура("КлючЗатрат, Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа");
	КонецЕсли;
	
	Для каждого СтрокаОбъекта из МатрицаОбъектов Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаОбъекта);
		МассивСтрок = СтрокаКонечныеОстатки.Строки.НайтиСтроки(СтруктураПоиска, Истина);
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Вычитаем остаток НЗП.
		СтрокаОбъекта.X = СтрокаОбъекта.X - МассивСтрок[0].Сумма;
		
	КонецЦикла;
	
КонецПроцедуры

// Корректировка оборотов 105 - 109.Себестоимость
//
Функция СформироватьКорректирующиеДвижения105_109ПР(ТаблицаДвижений, МатрицаОбъектов, СтрокаОбороты109ПР, ТаблицаКоэффициентовТэтта, ПараметрыУчетаЗатрат)
	
	ТаблицаКорректировок = Новый ТаблицаЗначений;
	ТаблицаКорректировок.Колонки.Добавить("СчетДт",                    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаКорректировок.Колонки.Добавить("КПСДт",                     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаКорректировок.Колонки.Добавить("КЭКДт",                     Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаКорректировок.Колонки.Добавить("НоменклатураДт",            Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаКорректировок.Колонки.Добавить("ПодразделениеДт",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаКорректировок.Колонки.Добавить("СчетКт",                    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаКорректировок.Колонки.Добавить("КПСКт",                     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаКорректировок.Колонки.Добавить("КЭККт",                     Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаКорректировок.Колонки.Добавить("НоменклатураКт",            Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаКорректировок.Колонки.Добавить("НаправлениеДеятельностиКт", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ТаблицаКорректировок.Колонки.Добавить("ПодразделениеКт",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаКорректировок.Колонки.Добавить("Количество",                Новый ОписаниеТипов("Число"));
	ТаблицаКорректировок.Колонки.Добавить("Сумма",                     Новый ОписаниеТипов("Число"));
	
	СтрокаСписания105_109ПР = СтрокаОбороты109ПР.Строки.Найти("Списание", "Направление", Ложь);
	Если СтрокаСписания105_109ПР = Неопределено Тогда
		Возврат ТаблицаКорректировок;
	КонецЕсли;
	
	СтрокаОткудаКуда105 = СтрокаСписания105_109ПР.Строки.Найти("105", "ОткудаКуда", Ложь);
	Если СтрокаОткудаКуда105 = Неопределено Тогда
		Возврат ТаблицаКорректировок;
	КонецЕсли;
	
	ИФО = СтрокаОбороты109ПР.ИФО;
	КФО = СтрокаОбороты109ПР.КФО;
	
	// 1. Соберем таблицу оборотов, которые нужно скорректировать.
	Для Каждого СтрокаНоменклатурнойГруппы Из СтрокаОткудаКуда105.Строки Цикл
		Для Каждого СтрокаВидЗатрат Из СтрокаНоменклатурнойГруппы.Строки Цикл
			Для Каждого СтрокаПодразделения Из СтрокаВидЗатрат.Строки Цикл
				Для Каждого СтрокаНаправлениеДеятельности Из СтрокаПодразделения.Строки Цикл
					Для Каждого СтрокаДетальная Из СтрокаНаправлениеДеятельности.Строки Цикл
						
						// Сторнируем старые движения Дт 105 Кт 109.Себестоимость по плановым ценам.
						ПроводкаСторно = ТаблицаДвижений.Добавить();
						ПроводкаСторно.ИФО   = ИФО;
						ПроводкаСторно.КФО   = КФО;
						
						ПроводкаСторно.СчетДт          = СтрокаДетальная.КорСчет;
						ПроводкаСторно.КПСДт           = СтрокаДетальная.КорКПС;
						ПроводкаСторно.КЭКДт           = СтрокаДетальная.КорКЭК;
						ПроводкаСторно.СубконтоДт1     = СтрокаДетальная.КорСубконто1;
						ПроводкаСторно.ПодразделениеДт = СтрокаДетальная.КорПодразделение;
						
						ПроводкаСторно.СчетКт          = СтрокаДетальная.Счет;
						ПроводкаСторно.КПСКт           = СтрокаДетальная.КПС;
						ПроводкаСторно.КЭККт           = СтрокаДетальная.КЭК;
						ПроводкаСторно.СубконтоКт1     = СтрокаДетальная.НоменклатурнаяГруппа;
						ПроводкаСторно.СубконтоКт2     = СтрокаДетальная.ВидЗатрат;
						Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
							ПроводкаСторно.СубконтоКт3 = СтрокаДетальная.НаправлениеДеятельности;
						КонецЕсли;
						Если ПараметрыУчетаЗатрат.ЕстьПодразделениеСебестоимость Тогда
							ПроводкаСторно.ПодразделениеКт = СтрокаДетальная.Подразделение;
						КонецЕсли;
						
						ПроводкаСторно.Сумма           = - СтрокаДетальная.СуммаОборотКт;
						ПроводкаСторно.Содержание      = НСтр("ru = 'Сторнирование оборотов по плановым ценам'");
						ПроводкаСторно.ЖурналОпераций  = БухгалтерскийУчетПовтИсп.НомерЖурнала(ПроводкаСторно.СчетДт, ПроводкаСторно.СчетКт);
						
						// Запомним в таблице корректировок.
						НоваяСтрока = ТаблицаКорректировок.Добавить();
						НоваяСтрока.СчетДт						= СтрокаДетальная.КорСчет;
						НоваяСтрока.КПСДт						= СтрокаДетальная.КорКПС;
						НоваяСтрока.КЭКДт						= СтрокаДетальная.КорКЭК;
						НоваяСтрока.НоменклатураДт				= СтрокаДетальная.КорСубконто1;
						НоваяСтрока.ПодразделениеДт				= СтрокаДетальная.КорПодразделение;
						НоваяСтрока.СчетКт						= СтрокаДетальная.Счет;
						НоваяСтрока.КПСКт						= СтрокаДетальная.КПС;
						НоваяСтрока.КЭККт						= СтрокаДетальная.КЭК;
						НоваяСтрока.НоменклатураКт				= СтрокаДетальная.НоменклатурнаяГруппа;
						НоваяСтрока.НаправлениеДеятельностиКт	= СтрокаДетальная.НаправлениеДеятельности;
						НоваяСтрока.ПодразделениеКт				= СтрокаДетальная.Подразделение;
						НоваяСтрока.Количество					= СтрокаДетальная.КоличествоКорОборотКт;
						
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	СписокКолонок = "НоменклатураКт,ПодразделениеКт,НаправлениеДеятельностиКт,СчетДт,КПСДт,НоменклатураДт";
	ТаблицаКорректировок.Сортировать(СписокКолонок);
	
	
	// 2. Рассчитаем суммы и сформируем корректирующие движения.
	ТаблицаРаспределения = ТаблицаКорректировок.Скопировать( ,СписокКолонок);
	ТаблицаРаспределения.Колонки.Добавить("Тэтта", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 2));
	ТаблицаРаспределения.Свернуть(СписокКолонок + ", Тэтта");
	
	СписокКолонокИтогов = "НоменклатураКт,ПодразделениеКт,НаправлениеДеятельностиКт";
	ТаблицаИтогов = ТаблицаРаспределения.Скопировать( ,СписокКолонокИтогов);
	ТаблицаИтогов.Свернуть(СписокКолонокИтогов);
	Для Каждого СтрокаИтогов из ТаблицаИтогов Цикл // по номенклатурным группам, подразделениям и направлениям деятельности
		
		МассивСтрокРешений = МатрицаОбъектов.НайтиСтроки(
			Новый Структура("НоменклатурнаяГруппа, Подразделение, НаправлениеДеятельности",
				СтрокаИтогов.НоменклатураКт, СтрокаИтогов.ПодразделениеКт, СтрокаИтогов.НаправлениеДеятельностиКт));
		Если МассивСтрокРешений.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрокРаспределения = ТаблицаРаспределения.НайтиСтроки(
			Новый Структура(СписокКолонокИтогов,
				СтрокаИтогов.НоменклатураКт, СтрокаИтогов.ПодразделениеКт, СтрокаИтогов.НаправлениеДеятельностиКт));
		
		Для Каждого СтрокаРешения Из МассивСтрокРешений Цикл
			
			МассивКоэффициентовТэтта = Новый Массив;
			Для Каждого Строка Из МассивСтрокРаспределения Цикл
				
				Строка.Тэтта = ОпределитьКоэффициентТэтта(ТаблицаКоэффициентовТэтта,
					Строка.ПодразделениеКт, Строка.НаправлениеДеятельностиКт, Строка.НоменклатураКт, Строка.НоменклатураДт, Строка.СчетДт, Строка.КПСДт);
					
				МассивКоэффициентовТэтта.Добавить(Строка.Тэтта);
				
			КонецЦикла;
			
			// Распределим сумму оборотов пропорционально коэффициентам Тэтта.
			МассивОборотовПоНоменклатуре = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
				СтрокаРешения.X, МассивКоэффициентовТэтта);
			Если МассивОборотовПоНоменклатуре = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Для Индекс = 0 По МассивОборотовПоНоменклатуре.Количество() - 1 Цикл
				
				СуммаОборотовПоНоменклатуре = МассивОборотовПоНоменклатуре[Индекс];
				СтрокаРаспределения         = МассивСтрокРаспределения[Индекс];
				
				Отбор = Новый Структура(СписокКолонок);
				ЗаполнитьЗначенияСвойств(Отбор, СтрокаРаспределения);
				
				МассивСтрокКорректировок = ТаблицаКорректировок.НайтиСтроки(Отбор);
				МассивКоэффициентовПоКоличеству = Новый Массив;
				Для Каждого СтрокаКорректировки Из МассивСтрокКорректировок Цикл
					МассивКоэффициентовПоКоличеству.Добавить(СтрокаКорректировки.Количество);
				КонецЦикла;
				
				// Распределим сумму корректировки пропорционально количеству.
				МассивОборотов = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
					СуммаОборотовПоНоменклатуре, МассивКоэффициентовПоКоличеству);
					
				Если МассивОборотов = Неопределено Тогда
					Продолжить;
				КонецЕсли;
					
				// Формируем корректирующие движения Дт 105 Кт 109.Себестоимость по фактической стоимости.
				Для ИндексОборотов = 0 По МассивОборотов.Количество() - 1 Цикл
					
					СтрокаКорректировки = МассивСтрокКорректировок[ИндексОборотов];
					СуммаОборота        = МассивОборотов[ИндексОборотов];
					
					Проводка = ТаблицаДвижений.Добавить();
					Проводка.ИФО = ИФО;
					Проводка.КФО = КФО;
					
					Проводка.СчетДт          = СтрокаКорректировки.СчетДт;
					Проводка.КПСДт           = СтрокаКорректировки.КПСДт;
					Проводка.КЭКДт           = СтрокаКорректировки.КЭКДт;
					Проводка.СубконтоДт1     = СтрокаКорректировки.НоменклатураДт;
					Проводка.ПодразделениеДт = СтрокаКорректировки.ПодразделениеДт;
					
					Проводка.СчетКт          = СтрокаКорректировки.СчетКт;
					Проводка.КПСКт           = СтрокаКорректировки.КПСКт;
					Проводка.КЭККт           = СтрокаРешения.КЭК;
					Проводка.СубконтоКт1     = СтрокаКорректировки.НоменклатураКт;
					Проводка.СубконтоКт2     = СтрокаРешения.ВидЗатрат;
					Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
						Проводка.СубконтоКт3 = СтрокаКорректировки.НаправлениеДеятельностиКт;
					КонецЕсли;
					Если ПараметрыУчетаЗатрат.ЕстьПодразделениеСебестоимость Тогда
						Проводка.ПодразделениеКт = СтрокаКорректировки.ПодразделениеКт;
					КонецЕсли;
					
					Проводка.Сумма          = СуммаОборота;
					Проводка.Содержание     = НСтр("ru = 'Оборот по фактической стоимости'");
					Проводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
					
					// Запомним сумму корректировки.
					СтрокаКорректировки.Сумма = СтрокаКорректировки.Сумма + СуммаОборота;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаКорректировок;
	
КонецФункции

// Корректировка оборотов ХХХ - 105
//
Функция СформироватьКорректирующиеДвиженияХХХ_105(ТаблицаДвижений, ТаблицаКорректировок105_109ПР, СтрокаОбороты105, СтрокаНачальныеОстатки, ПараметрыУчетаЗатрат)

	ТаблицаКорректировок = Новый ТаблицаЗначений;
	ТаблицаКорректировок.Колонки.Добавить("ОПЗ_ОХЗ",                 Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(30, ДопустимаяДлина.Переменная)));
	ТаблицаКорректировок.Колонки.Добавить("Счет",                    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаКорректировок.Колонки.Добавить("КПС",                     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаКорректировок.Колонки.Добавить("Подразделение",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаКорректировок.Колонки.Добавить("НаправлениеДеятельности", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ТаблицаКорректировок.Колонки.Добавить("НоменклатурнаяГруппа",    Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаКорректировок.Колонки.Добавить("ВидЗатрат",               Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ТаблицаКорректировок.Колонки.Добавить("КЭКЗатрат",               Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаКорректировок.Колонки.Добавить("КлючЗатрат",              Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(12)));
	ТаблицаКорректировок.Колонки.Добавить("Сумма",                   Новый ОписаниеТипов("Число"));
	
	СтрокаСписания = СтрокаОбороты105.Строки.Найти("Списание", "Направление", Ложь);
	Если СтрокаСписания = Неопределено Тогда
		Возврат ТаблицаКорректировок;
	КонецЕсли;
	
	ИФО = СтрокаОбороты105.ИФО;
	КФО = СтрокаОбороты105.КФО;
	
	ДеревоПроводокХХХ_105        = СформироватьДеревоПроводокХХХ_105(СтрокаСписания);
	ТаблицаОстатковИОборотов105  = ПолучитьТаблицуОстатковИОборотов105(ТаблицаКорректировок105_109ПР, СтрокаНачальныеОстатки);
	
	Для каждого СтрокаСчета из ДеревоПроводокХХХ_105.Строки Цикл
		Для каждого СтрокаКПС из СтрокаСчета.Строки Цикл
			Для каждого СтрокаНоменклатуры из СтрокаКПС.Строки Цикл
				
				ВсегоКоличество = СтрокаНоменклатуры.Количество;
				Если ВсегоКоличество = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				СтруктураПоиска = Новый Структура("Счет, КПС, Номенклатура",
					СтрокаНоменклатуры.СчетКт, СтрокаНоменклатуры.КПСКт, СтрокаНоменклатуры.СубконтоКт1);
				МассивСтрок = ТаблицаОстатковИОборотов105.НайтиСтроки(СтруктураПоиска);
				Если МассивСтрок.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				КоличествоНаВходе = МассивСтрок[0].Количество;
				СуммаНаВходе      = МассивСтрок[0].Сумма;
				ЦенаЕдиницы = ?(КоличествоНаВходе = 0, 0, СуммаНаВходе / КоличествоНаВходе);
				
				ВсегоКоличествоСписано = 0;
				ВсегоСуммаСписано      = 0;
				Для каждого СтрокаДетальная из СтрокаНоменклатуры.Строки Цикл
					
					КоличествоСписания     = СтрокаДетальная.Количество;
					СуммаСписанияСтарая    = СтрокаДетальная.Сумма;
					ВсегоКоличествоСписано = ВсегоКоличествоСписано + КоличествоСписания;
					Если ВсегоКоличествоСписано >= КоличествоНаВходе Тогда
						СуммаСписания = СуммаНаВходе - ВсегоСуммаСписано - СуммаСписанияСтарая;
					Иначе
						СуммаСписания = Окр(КоличествоСписания * ЦенаЕдиницы, 2) - СуммаСписанияСтарая;
						ВсегоСуммаСписано = ВсегоСуммаСписано + Окр(КоличествоСписания * ЦенаЕдиницы, 2);
					КонецЕсли;
					
					// Проводка по корректировке списания материалов по фактической стоимости.
					Проводка = ТаблицаДвижений.Добавить();
					Проводка.ИФО = ИФО;
					Проводка.КФО = КФО;
					
					СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаДетальная.СчетДт);
					СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаДетальная.СчетКт);
					
					Проводка.СчетДт = СтрокаДетальная.СчетДт;
					Проводка.КПСДт  = СтрокаДетальная.КПСДт;
					Проводка.КЭКДт  = СтрокаДетальная.КЭКДт;
					Для Индекс = 1 По СвойстваСчетаДт.КоличествоСубконто Цикл
						Проводка["СубконтоДт" + Индекс] = СтрокаДетальная["СубконтоДт" + Индекс];
					КонецЦикла; 
					Проводка.ПодразделениеДт = СтрокаДетальная.ПодразделениеДт;
					
					Проводка.СчетКт          = СтрокаДетальная.СчетКт;
					Проводка.КПСКт           = СтрокаДетальная.КПСКт;
					Проводка.КЭККт           = СтрокаДетальная.КЭККт;
					Проводка.СубконтоКт1     = СтрокаДетальная.СубконтоКт1;
					Проводка.ПодразделениеКт = СтрокаДетальная.ПодразделениеКт;
					
					Проводка.Сумма           = СуммаСписания;
					Проводка.Содержание      = НСтр("ru = 'Корректировка списания материалов по фактической стоимости'");
					Проводка.ЖурналОпераций  = БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
					
					// Запомним в таблице корректировок.
					ЕстьКорректировка = Ложь;
					Если Проводка.СчетДт = ПараметрыУчетаЗатрат.СчетНакладныеРасходы Тогда
						ОПЗ_ОХЗ = "ОПЗ";
						ЕстьКорректировка = Истина;
					ИначеЕсли Проводка.СчетДт = ПараметрыУчетаЗатрат.СчетОбщехозяйственныеРасходы Тогда
						ОПЗ_ОХЗ = "ОХЗ";
						ЕстьКорректировка = Истина;
					ИначеЕсли Проводка.СчетДт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н20.02") Тогда
						ОПЗ_ОХЗ = "КосвенныеРасходыПроизводства";
						ЕстьКорректировка = Истина;
					ИначеЕсли Проводка.СчетДт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н25.02")
						  ИЛИ Проводка.СчетДт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н26.02") Тогда
						ОПЗ_ОХЗ = "КосвенныеОбщиеРасходы";
						ЕстьКорректировка = Истина;
					КонецЕсли;
					Если ЕстьКорректировка = Истина Тогда
						НоваяСтрока = ТаблицаКорректировок.Добавить();
						НоваяСтрока.ОПЗ_ОХЗ                 = ОПЗ_ОХЗ;
						НоваяСтрока.Счет                    = Проводка.СчетДт;
						НоваяСтрока.КПС                     = Проводка.КПСДт;
						НоваяСтрока.КЭКЗатрат               = СтрокаДетальная.КЭКДт;
						НоваяСтрока.КлючЗатрат              = СтрокаДетальная.КлючЗатрат;
						НоваяСтрока.Подразделение           = СтрокаДетальная.ПодразделениеДт;
						Для Сч = 1 По 3 Цикл
							Если СвойстваСчетаДт["ВидСубконто"+Сч] = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
								НоваяСтрока.НоменклатурнаяГруппа    = СтрокаДетальная["СубконтоДт"+Сч];
							ИначеЕсли СвойстваСчетаДт["ВидСубконто"+Сч] = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
								НоваяСтрока.ВидЗатрат               = СтрокаДетальная["СубконтоДт"+Сч];
							ИначеЕсли СвойстваСчетаДт["ВидСубконто"+Сч] = ПланыВидовХарактеристик.ВидыСубконто.НаправленияДеятельности Тогда
								НоваяСтрока.НаправлениеДеятельности = СтрокаДетальная["СубконтоДт"+Сч];
							КонецЕсли;
						КонецЦикла;
						НоваяСтрока.Сумма = СуммаСписания;
					КонецЕсли;
				
					// Учтем в таблице остатков и оборотов 105.
					Если СтрокаДетальная.СчетДтКод3 = "105" Тогда
						
						Отбор = Новый Структура("Счет, КПС, Номенклатура",
							СтрокаНоменклатуры.СчетДт, СтрокаНоменклатуры.КПСДт, СтрокаНоменклатуры.СубконтоДт1);
						НайденныеСтроки = ТаблицаОстатковИОборотов105.НайтиСтроки(Отбор);
						Если НайденныеСтроки.Количество() = 0 Тогда
							НоваяСтрока = ТаблицаОстатковИОборотов105.Добавить();
							НоваяСтрока.Счет         = СтрокаДетальная.СчетДт;
							НоваяСтрока.КПС          = СтрокаДетальная.КПСДт;
							НоваяСтрока.Номенклатура = СтрокаДетальная.СубконтоДт1;
							НоваяСтрока.Количество   = КоличествоСписания;
							НоваяСтрока.Сумма        = СуммаСписанияСтарая + СуммаСписания;
						Иначе	
							НайденныеСтроки[0].Количество = НайденныеСтроки[0].Количество + КоличествоСписания;
							НайденныеСтроки[0].Сумма      = НайденныеСтроки[0].Сумма + СуммаСписания;
						КонецЕсли;
						
					КонецЕсли;
				
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаКорректировок.Свернуть("ОПЗ_ОХЗ, Счет, КПС, НоменклатурнаяГруппа, ВидЗатрат, КЭКЗатрат, КлючЗатрат, Подразделение, НаправлениеДеятельности", "Сумма");
	ТаблицаКорректировок.Сортировать("ОПЗ_ОХЗ, Счет, КПС, НоменклатурнаяГруппа, ВидЗатрат, КЭКЗатрат, Подразделение, НаправлениеДеятельности");
	
	Возврат ТаблицаКорректировок;
	
КонецФункции

Функция СформироватьДеревоПроводокХХХ_105(СтрокаСписания)

	ТипыСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ТаблицаПроводокХХХ_105 = Новый ТаблицаЗначений;
	ТаблицаПроводокХХХ_105.Колонки.Добавить("СчетДт",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаПроводокХХХ_105.Колонки.Добавить("СчетДтКод3",      Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
	ТаблицаПроводокХХХ_105.Колонки.Добавить("КПСДт",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаПроводокХХХ_105.Колонки.Добавить("КЭКДт",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаПроводокХХХ_105.Колонки.Добавить("СубконтоДт1",     ТипыСубконто);
	ТаблицаПроводокХХХ_105.Колонки.Добавить("СубконтоДт2",     ТипыСубконто);
	ТаблицаПроводокХХХ_105.Колонки.Добавить("СубконтоДт3",     ТипыСубконто);
	ТаблицаПроводокХХХ_105.Колонки.Добавить("ПодразделениеДт", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаПроводокХХХ_105.Колонки.Добавить("СчетКт",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаПроводокХХХ_105.Колонки.Добавить("КПСКт",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаПроводокХХХ_105.Колонки.Добавить("КЭККт",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаПроводокХХХ_105.Колонки.Добавить("СубконтоКт1",     Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПроводокХХХ_105.Колонки.Добавить("ПодразделениеКт", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаПроводокХХХ_105.Колонки.Добавить("Количество",      Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,3)));
	ТаблицаПроводокХХХ_105.Колонки.Добавить("Сумма",           Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(18,8)));
	ТаблицаПроводокХХХ_105.Колонки.Добавить("КлючЗатрат",      Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(12)));
	
	Для каждого СтрокаОткудаКуда из СтрокаСписания.Строки Цикл
		Для каждого СтрокаПодразделения из СтрокаОткудаКуда.Строки Цикл
			Для каждого СтрокаДетальная из СтрокаПодразделения.Строки Цикл
				НоваяСтрока = ТаблицаПроводокХХХ_105.Добавить();
				НоваяСтрока.СчетДт          = СтрокаДетальная.КорСчет;
				НоваяСтрока.КПСДт           = СтрокаДетальная.КорКПС;
				НоваяСтрока.КЭКДт           = СтрокаДетальная.КорКЭК;
				НоваяСтрока.СубконтоДт1     = СтрокаДетальная.КорСубконто1;
				НоваяСтрока.СубконтоДт2     = СтрокаДетальная.КорСубконто2;
				НоваяСтрока.СубконтоДт3     = СтрокаДетальная.КорСубконто3;
				НоваяСтрока.ПодразделениеДт = СтрокаДетальная.КорПодразделение;
				
				НоваяСтрока.СчетКт          = СтрокаДетальная.Счет;
				НоваяСтрока.КПСКт           = СтрокаДетальная.КПС;
				НоваяСтрока.КЭККт           = СтрокаДетальная.КЭК;
				НоваяСтрока.СубконтоКт1     = СтрокаДетальная.Номенклатура;
				НоваяСтрока.ПодразделениеКт = СтрокаДетальная.Подразделение;
				
				НоваяСтрока.Количество      = СтрокаДетальная.КоличествоОборотКт;
				НоваяСтрока.Сумма           = СтрокаДетальная.СуммаОборотКт;
				
				НоваяСтрока.КлючЗатрат      = СтрокаДетальная.КлючЗатрат;
				НоваяСтрока.СчетДтКод3      = СтрокаДетальная.СчетКорКод3;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаПроводокХХХ_105", ТаблицаПроводокХХХ_105);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОбороты105.СчетДт,
	|	ТаблицаОбороты105.СчетДтКод3,
	|	ТаблицаОбороты105.КПСДт,
	|	ТаблицаОбороты105.КЭКДт,
	|	ТаблицаОбороты105.СубконтоДт1,
	|	ТаблицаОбороты105.СубконтоДт2,
	|	ТаблицаОбороты105.СубконтоДт3,
	|	ТаблицаОбороты105.ПодразделениеДт,
	|	ТаблицаОбороты105.СчетКт,
	|	ТаблицаОбороты105.КПСКт,
	|	ТаблицаОбороты105.КЭККт,
	|	ТаблицаОбороты105.СубконтоКт1,
	|	ТаблицаОбороты105.ПодразделениеКт,
	|	ТаблицаОбороты105.КлючЗатрат,
	|	ТаблицаОбороты105.Количество,
	|	ТаблицаОбороты105.Сумма
	|ПОМЕСТИТЬ ТабПроводок
	|ИЗ
	|	&ТаблицаПроводокХХХ_105 КАК ТаблицаОбороты105
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабПроводок.СчетДт,
	|	ТабПроводок.СчетДтКод3,
	|	ТабПроводок.КПСДт,
	|	ТабПроводок.КЭКДт,
	|	ТабПроводок.ПодразделениеДт,
	|	ТабПроводок.СубконтоДт1,
	|	ТабПроводок.СубконтоДт2,
	|	ТабПроводок.СубконтоДт3,
	|	ТабПроводок.СчетКт КАК СчетКт,
	|	ТабПроводок.КПСКт КАК КПСКт,
	|	ТабПроводок.КЭККт,
	|	ТабПроводок.ПодразделениеКт,
	|	ТабПроводок.СубконтоКт1 КАК СубконтоКт1,
	|	ВЫРАЗИТЬ(ТабПроводок.КлючЗатрат КАК СТРОКА(12)) КАК КлючЗатрат,
	|	СУММА(ТабПроводок.Количество) КАК Количество,
	|	СУММА(ТабПроводок.Сумма) КАК Сумма
	|ИЗ
	|	ТабПроводок КАК ТабПроводок
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабПроводок.СчетДт,
	|	ТабПроводок.СчетДтКод3,
	|	ТабПроводок.КПСДт,
	|	ТабПроводок.КЭКДт,
	|	ТабПроводок.ПодразделениеДт,
	|	ТабПроводок.СубконтоДт1,
	|	ТабПроводок.СубконтоДт2,
	|	ТабПроводок.СубконтоДт3,
	|	ТабПроводок.СчетКт,
	|	ТабПроводок.КПСКт,
	|	ТабПроводок.КЭККт,
	|	ТабПроводок.ПодразделениеКт,
	|	ТабПроводок.СубконтоКт1,
	|	ВЫРАЗИТЬ(ТабПроводок.КлючЗатрат КАК СТРОКА(12))
	|ИТОГИ
	|	СУММА(Количество),
	|	СУММА(Сумма)
	|ПО
	|	СчетКт,
	|	КПСКт,
	|	СубконтоКт1";
	Возврат Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецФункции

Функция ПолучитьТаблицуОстатковИОборотов105(ТаблицаКорректировок105_109ПР, СтрокаНачальныеОстатки)
	
	// Подготовим таблицу остатков 105
	ТаблицаОстатков105 = Новый ТаблицаЗначений;
	ТаблицаОстатков105.Колонки.Добавить("Счет",			Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаОстатков105.Колонки.Добавить("КПС",			Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаОстатков105.Колонки.Добавить("Номенклатура",	Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаОстатков105.Колонки.Добавить("Сумма",		Новый ОписаниеТипов("Число"));
	ТаблицаОстатков105.Колонки.Добавить("Количество",	Новый ОписаниеТипов("Число"));
	
	Если СтрокаНачальныеОстатки <> Неопределено Тогда
		СтрокаСчета105 = СтрокаНачальныеОстатки.Строки.Найти("105", "НаименованиеСчета", Ложь);
		Если СтрокаСчета105 <> Неопределено Тогда
			Для Каждого СтрокаДетальная Из СтрокаСчета105.Строки Цикл
				НоваяСтрока = ТаблицаОстатков105.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДетальная);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// Подготовим таблицу оборотов Дт 105
	ТаблицаОборотовДт105 = ТаблицаКорректировок105_109ПР.Скопировать();
	ТаблицаОборотовДт105.Свернуть("СчетДт, КПСДт, НоменклатураДт", "Количество, Сумма");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТабОстатков", ТаблицаОстатков105);
	Запрос.УстановитьПараметр("ТабОборотов", ТаблицаОборотовДт105);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОстатков.Счет,
	|	ТаблицаОстатков.КПС,
	|	ТаблицаОстатков.Номенклатура,
	|	ТаблицаОстатков.Сумма,
	|	ТаблицаОстатков.Количество
	|ПОМЕСТИТЬ ТабОстатков
	|ИЗ
	|	&ТабОстатков КАК ТаблицаОстатков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОборотов.СчетДт КАК Счет,
	|	ТаблицаОборотов.КПСДт КАК КПС,
	|	ТаблицаОборотов.НоменклатураДт КАК Номенклатура,
	|	ТаблицаОборотов.Сумма,
	|	ТаблицаОборотов.Количество
	|ПОМЕСТИТЬ ТабОборотов
	|ИЗ
	|	&ТабОборотов КАК ТаблицаОборотов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабОборотов.Счет,
	|	ТабОборотов.КПС,
	|	ТабОборотов.Номенклатура,
	|	СУММА(ТабОборотов.Сумма + ЕСТЬNULL(ТабОстатков.Сумма, 0)) КАК Сумма,
	|	СУММА(ТабОборотов.Количество + ЕСТЬNULL(ТабОстатков.Количество, 0)) КАК Количество
	|ИЗ
	|	ТабОборотов КАК ТабОборотов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабОстатков КАК ТабОстатков
	|		ПО ТабОборотов.Счет = ТабОстатков.Счет
	|			И ТабОборотов.КПС = ТабОстатков.КПС
	|			И ТабОборотов.Номенклатура = ТабОстатков.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабОборотов.Счет,
	|	ТабОборотов.КПС,
	|	ТабОборотов.Номенклатура";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Корректировка списания общих затрат с Кт 109
//
Функция СформироватьКорректирующиеДвиженияХХХ_109(ТаблицаДвижений, ТаблицаСписание109_105, СтрокаОбороты109Косвенные, ТаблицаСписанияРаспределяемыхРасходовНаЕНВД, ВидУчета, ПараметрыУчетаЗатрат)
	
	ОписаниеТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ТаблицаКорректировокСебестоимость = Новый ТаблицаЗначений;
	Колонки = ТаблицаКорректировокСебестоимость.Колонки;
	Колонки.Добавить("СчетДт",                    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Колонки.Добавить("КЭКДт",                     Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Колонки.Добавить("КПСДт",                     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Колонки.Добавить("НоменклатурнаяГруппаДт",    Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Колонки.Добавить("ВидЗатратДт",               Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	Колонки.Добавить("КлючЗатратДт",              Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(12)));
	Колонки.Добавить("ПодразделениеДт",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Колонки.Добавить("НаправлениеДеятельностиДт", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	Колонки.Добавить("СчетКт",                    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Колонки.Добавить("КЭККт",                     Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Колонки.Добавить("КПСКт",                     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Колонки.Добавить("ВидЗатратКт",               Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	Колонки.Добавить("КлючЗатратКт",              Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(12)));
	Колонки.Добавить("ПодразделениеКт",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Колонки.Добавить("НаправлениеДеятельностиКт", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	Колонки.Добавить("Сумма",                     Новый ОписаниеТипов("Число"));
	Колонки.Добавить("Альфа",                     Новый ОписаниеТипов("Число"));
	
	ТаблицаКорректировокПрочее = Новый ТаблицаЗначений;
	Колонки = ТаблицаКорректировокПрочее.Колонки;
	Колонки.Добавить("СчетДт",                    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Колонки.Добавить("КЭКДт",                     Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Колонки.Добавить("КПСДт",                     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Колонки.Добавить("СубконтоКор1",              ОписаниеТиповСубконто);
	Колонки.Добавить("СубконтоКор2",              ОписаниеТиповСубконто);
	Колонки.Добавить("СубконтоКор3",              ОписаниеТиповСубконто);
	Колонки.Добавить("ПодразделениеДт",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Колонки.Добавить("СчетКт",                    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Колонки.Добавить("КЭККт",                     Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Колонки.Добавить("КПСКт",                     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Колонки.Добавить("ВидЗатратКт",               Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	Колонки.Добавить("КлючЗатратКт",              Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(12)));
	Колонки.Добавить("ПодразделениеКт",           Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Колонки.Добавить("НаправлениеДеятельностиКт", Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	Колонки.Добавить("Сумма",                     Новый ОписаниеТипов("Число"));
	
	Если СтрокаОбороты109Косвенные = Неопределено Тогда
		Возврат Новый Структура("ТаблицаКорректировокСебестоимость, ТаблицаКорректировокПрочее",
								ТаблицаКорректировокСебестоимость, ТаблицаКорректировокПрочее);
	КонецЕсли;
	
	СтрокаСписание = СтрокаОбороты109Косвенные.Строки.Найти("Списание", "Направление", Ложь);
	Если СтрокаСписание = Неопределено Тогда
		Возврат Новый Структура("ТаблицаКорректировокСебестоимость, ТаблицаКорректировокПрочее",
								ТаблицаКорректировокСебестоимость, ТаблицаКорректировокПрочее);
	КонецЕсли;
	
	ТабСписание109_105 = ТаблицаСписание109_105.Скопировать();
	ТабСписание109_105.Свернуть("ОПЗ_ОХЗ, Счет, КПС, ВидЗатрат, КЭКЗатрат, КлючЗатрат, Подразделение, НаправлениеДеятельности", "Сумма");
	ТабСписание109_105.Сортировать("ОПЗ_ОХЗ, Счет, КПС, ВидЗатрат, КЭКЗатрат, КлючЗатрат, Подразделение, НаправлениеДеятельности");
	
	Параметры = Новый Структура("ТаблицаДвижений, ПараметрыУчетаЗатрат, ИФО, КФО");
	Параметры.Вставить("ТаблицаДвижений",              ТаблицаДвижений);
	Параметры.Вставить("ПараметрыУчетаЗатрат",         ПараметрыУчетаЗатрат);
	Параметры.Вставить("ВидУчета",                     ВидУчета);
	Параметры.Вставить("ИФО",                          СтрокаОбороты109Косвенные.ИФО);
	Параметры.Вставить("КФО",                          СтрокаОбороты109Косвенные.КФО);
	Параметры.Вставить("ТабСписание109_105",           ТабСписание109_105);
	Параметры.Вставить("ТаблицаСписанияРаспределяемыхРасходовНаЕНВД", ТаблицаСписанияРаспределяемыхРасходовНаЕНВД);
	
	
	МассивТиповКЗ = Новый Массив;
	МассивТиповКЗ.Добавить("ОПЗ");
	МассивТиповКЗ.Добавить("ОХЗ");
	
	Для каждого ТипКЗ из МассивТиповКЗ Цикл
		
		СтрокаОПЗ_ОХЗ = СтрокаСписание.Строки.Найти(ТипКЗ, "ОПЗ_ОХЗ", Ложь);
		Если СтрокаОПЗ_ОХЗ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПЗ = СтрокаОПЗ_ОХЗ.Строки.Найти("ПЗ", "ОткудаКуда", Ложь);
		Если СтрокаПЗ <> Неопределено Тогда
			
			СкорректироватьРаспределениеОбщихЗатратНаСебестоимость(Параметры,
				ТипКЗ, ТаблицаКорректировокСебестоимость, СтрокаПЗ);
			
		КонецЕсли;
		
		СкорректироватьПрочееСписаниеОбщихЗатрат(Параметры,
			ТипКЗ, ТаблицаКорректировокПрочее, СтрокаОПЗ_ОХЗ);
		
	КонецЦикла;

	Возврат Новый Структура("ТаблицаКорректировокСебестоимость, ТаблицаКорректировокПрочее",
							ТаблицаКорректировокСебестоимость, ТаблицаКорректировокПрочее);
	
КонецФункции

Процедура СкорректироватьРаспределениеОбщихЗатратНаСебестоимость(Параметры, ТипКЗ, ТаблицаКорректировокСебестоимость, СтрокаПЗ)
	
	ТаблицаДвижений      = Параметры.ТаблицаДвижений;
	ТабСписание109_105   = Параметры.ТабСписание109_105;
	ПараметрыУчетаЗатрат = Параметры.ПараметрыУчетаЗатрат;
	ИФО                  = Параметры.ИФО;
	КФО                  = Параметры.КФО;
	
	Для Каждого СтрокаВидЗатрат Из СтрокаПЗ.Строки Цикл
		Для Каждого СтрокаПодразделение Из СтрокаВидЗатрат.Строки Цикл
			Для Каждого СтрокаНаправлениеДеятельности Из СтрокаПодразделение.Строки Цикл
				Для Каждого СтрокаДетальная Из СтрокаНаправлениеДеятельности.Строки Цикл
					НоваяСтрока = ТаблицаКорректировокСебестоимость.Добавить();
					НоваяСтрока.СчетДт                    = СтрокаДетальная.КорСчет;
					НоваяСтрока.КЭКДт                     = СтрокаДетальная.КорКЭК;
					НоваяСтрока.КПСДт                     = СтрокаДетальная.КорКПС;
					НоваяСтрока.НоменклатурнаяГруппаДт    = СтрокаДетальная.КорСубконто1;
					НоваяСтрока.ВидЗатратДт               = СтрокаДетальная.КорСубконто2;
					НоваяСтрока.КлючЗатратДт              = СтрокаДетальная.КлючЗатратКор;
					НоваяСтрока.НаправлениеДеятельностиДт = СтрокаДетальная.КорСубконто3;
					НоваяСтрока.ПодразделениеДт           = СтрокаДетальная.КорПодразделение;
					НоваяСтрока.СчетКт                    = СтрокаДетальная.Счет;
					НоваяСтрока.КЭККт                     = СтрокаДетальная.КЭК;
					НоваяСтрока.КПСКт                     = СтрокаДетальная.КПС;
					НоваяСтрока.ВидЗатратКт               = СтрокаДетальная.ВидЗатрат;
					НоваяСтрока.КлючЗатратКт              = СтрокаДетальная.КлючЗатрат;
					НоваяСтрока.НаправлениеДеятельностиКт = СтрокаДетальная.НаправлениеДеятельности;
					НоваяСтрока.ПодразделениеКт           = СтрокаДетальная.Подразделение;
					НоваяСтрока.Сумма                     = СтрокаДетальная.СуммаОборотКт;
					НоваяСтрока.Альфа                     = СтрокаДетальная["Альфа" + ТипКЗ];
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	НайденныеСтрокиСписание109 = ТабСписание109_105.НайтиСтроки(Новый Структура("ОПЗ_ОХЗ", ТипКЗ));
	Для Каждого СтрокаСписание109 Из НайденныеСтрокиСписание109 Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючЗатратКт",              СтрокаСписание109.КлючЗатрат);
		Отбор.Вставить("ПодразделениеКт",           СтрокаСписание109.Подразделение);
		Отбор.Вставить("НаправлениеДеятельностиКт", СтрокаСписание109.НаправлениеДеятельности);
		Отбор.Вставить("СчетКт",                    СтрокаСписание109.Счет);
		Отбор.Вставить("КПСКт",                     СтрокаСписание109.КПС);
		НайденныеСтрокиКорректировок = ТаблицаКорректировокСебестоимость.НайтиСтроки(Отбор);
		
		МассивКоэффициентов = Новый Массив;
		Для Каждого СтрокаКорректировки Из НайденныеСтрокиКорректировок Цикл
			МассивКоэффициентов.Добавить(СтрокаКорректировки["Альфа"]);
		КонецЦикла;
		
		МассивСуммСписания = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаСписание109.Сумма, МассивКоэффициентов);
		Если МассивСуммСписания = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Индекс = 0 По МассивСуммСписания.Количество() - 1 Цикл
			
			СтрокаКорректировки = НайденныеСтрокиКорректировок[Индекс];
			СуммаСписания       = МассивСуммСписания[Индекс];
			
			// Формируем проводки по корректировке распределения общих расходов.
			Если СуммаСписания <> 0 Тогда
				
				Проводка = ТаблицаДвижений.Добавить();
				Проводка.ИФО = ИФО;
				Проводка.КФО = КФО;
				
				Проводка.СчетДт      = СтрокаКорректировки.СчетДт;
				Проводка.КПСДт       = СтрокаКорректировки.КПСКт;
				Проводка.КЭКДт       = СтрокаКорректировки.КЭКДт;
				Проводка.СубконтоДт1 = СтрокаКорректировки.НоменклатурнаяГруппаДт;
				Проводка.СубконтоДт2 = СтрокаКорректировки.ВидЗатратКт;
				Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
					Проводка.СубконтоДт3 = СтрокаКорректировки.НаправлениеДеятельностиДт;
				КонецЕсли;
				Если ПараметрыУчетаЗатрат.ЕстьПодразделениеСебестоимость Тогда
					Проводка.ПодразделениеДт = СтрокаКорректировки.ПодразделениеДт;
				КонецЕсли;
				
				Проводка.СчетКт      = СтрокаКорректировки.СчетКт;
				Проводка.КПСКт       = СтрокаКорректировки.КПСКт;
				Проводка.КЭККт       = СтрокаКорректировки.КЭККт;
				Проводка.СубконтоКт1 = СтрокаКорректировки.ВидЗатратКт;
				Если (ТипКЗ = "ОПЗ" И ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы)
				 ИЛИ (ТипКЗ = "ОХЗ" И ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы) Тогда
					Проводка.СубконтоКт2 = СтрокаКорректировки.НаправлениеДеятельностиКт;
				КонецЕсли;
				Если (ТипКЗ = "ОПЗ" И ПараметрыУчетаЗатрат.ЕстьПодразделениеНакладныеРасходы)
				 ИЛИ (ТипКЗ = "ОХЗ" И ПараметрыУчетаЗатрат.ЕстьПодразделениеОбщехозяйственныеРасходы) Тогда
					Проводка.ПодразделениеКт = СтрокаКорректировки.ПодразделениеКт;
				КонецЕсли;
				
				Проводка.Сумма          = СуммаСписания;
				Проводка.Содержание     = "Корректировка распределения общих расходов";
				Проводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
				
				Если Параметры.ВидУчета = "НУ" Тогда
					
					// Запомним сумму корректировки.
					СтруктураПоиска = Новый Структура("ИФО, КФО, СчетКт, СубконтоКт1, СубконтоКт2",
						ИФО, КФО, Проводка.СчетДт, Проводка.СубконтоДт1, Проводка.СубконтоДт2);
					Если ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
						СтруктураПоиска.Вставить("СубконтоКт3", Проводка.СубконтоДт3);
					КонецЕсли;
					МассивНайденныхСтрок = Параметры.ТаблицаСписанияРаспределяемыхРасходовНаЕНВД.НайтиСтроки(СтруктураПоиска);
					Если МассивНайденныхСтрок.Количество() > 0 Тогда
						МассивНайденныхСтрок[0].СуммаКорректировки = СуммаСписания;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			СтрокаСписание109.Сумма = СтрокаСписание109.Сумма - СуммаСписания;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СкорректироватьПрочееСписаниеОбщихЗатрат(Параметры, ТипКЗ, ТаблицаКорректировокПрочее, СтрокаОПЗ_ОХЗ)
	
	ТаблицаДвижений      = Параметры.ТаблицаДвижений;
	ТабСписание109_105   = Параметры.ТабСписание109_105;
	ПараметрыУчетаЗатрат = Параметры.ПараметрыУчетаЗатрат;
	ИФО                  = Параметры.ИФО;
	КФО                  = Параметры.КФО;
	
	Для Каждого СтрокаОткудаКуда Из СтрокаОПЗ_ОХЗ.Строки Цикл
		
		Если СтрокаОткудаКуда.ОткудаКуда = "ПЗ" Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаВидЗатрат Из СтрокаОткудаКуда.Строки Цикл
			Для Каждого СтрокаПодразделение Из СтрокаВидЗатрат.Строки Цикл
				Для Каждого СтрокаНаправлениеДеятельности Из СтрокаПодразделение.Строки Цикл
					Для Каждого СтрокаДетальная Из СтрокаНаправлениеДеятельности.Строки Цикл
						НоваяСтрока = ТаблицаКорректировокПрочее.Добавить();
						НоваяСтрока.СчетДт                    = СтрокаДетальная.КорСчет;
						НоваяСтрока.КЭКДт                     = СтрокаДетальная.КорКЭК;
						НоваяСтрока.КПСДт                     = СтрокаДетальная.КорКПС;
						НоваяСтрока.СубконтоКор1              = СтрокаДетальная.КорСубконто1;
						НоваяСтрока.СубконтоКор2              = СтрокаДетальная.КорСубконто2;
						НоваяСтрока.СубконтоКор3              = СтрокаДетальная.КорСубконто3;
						НоваяСтрока.ПодразделениеДт           = СтрокаДетальная.КорПодразделение;
						НоваяСтрока.СчетКт                    = СтрокаДетальная.Счет;
						НоваяСтрока.КЭККт                     = СтрокаДетальная.КЭК;
						НоваяСтрока.КПСКт                     = СтрокаДетальная.КПС;
						НоваяСтрока.ВидЗатратКт               = СтрокаДетальная.ВидЗатрат;
						НоваяСтрока.КлючЗатратКт              = СтрокаДетальная.КлючЗатрат;
						НоваяСтрока.НаправлениеДеятельностиКт = СтрокаДетальная.НаправлениеДеятельности;
						НоваяСтрока.ПодразделениеКт           = СтрокаДетальная.Подразделение;
						НоваяСтрока.Сумма                     = СтрокаДетальная.СуммаОборотКт;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	НайденныеСтрокиСписание109 = ТабСписание109_105.НайтиСтроки(Новый Структура("ОПЗ_ОХЗ", ТипКЗ));
	Для Каждого СтрокаСписание109 Из НайденныеСтрокиСписание109 Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючЗатратКт",              СтрокаСписание109.КлючЗатрат);
		Отбор.Вставить("ПодразделениеКт",           СтрокаСписание109.Подразделение);
		Отбор.Вставить("НаправлениеДеятельностиКт", СтрокаСписание109.НаправлениеДеятельности);
		Отбор.Вставить("СчетКт",                    СтрокаСписание109.Счет);
		Отбор.Вставить("КПСКт",                     СтрокаСписание109.КПС);
		НайденныеСтрокиКорректировок = ТаблицаКорректировокПрочее.НайтиСтроки(Отбор);
		
		МассивКоэффициентов = Новый Массив;
		Для Каждого СтрокаКорректировки Из НайденныеСтрокиКорректировок Цикл
			МассивКоэффициентов.Добавить(СтрокаКорректировки["Сумма"]);
		КонецЦикла;
		
		МассивСуммСписания = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаСписание109.Сумма, МассивКоэффициентов);
		Если МассивСуммСписания = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Индекс = 0 По МассивСуммСписания.Количество() - 1 Цикл
			
			СтрокаКорректировки = НайденныеСтрокиКорректировок[Индекс];
			СуммаСписания       = МассивСуммСписания[Индекс];
			
			// Формируем проводки по корректировке распределения общих затрат.
			Если СуммаСписания <> 0 Тогда
				
				Проводка = ТаблицаДвижений.Добавить();
				Проводка.ИФО = ИФО;
				Проводка.КФО = КФО;
				
				СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаКорректировки.СчетДт);
				
				Проводка.СчетДт = СтрокаКорректировки.СчетДт;
				Проводка.КПСДт  = СтрокаКорректировки.КПСКт;
				Проводка.КЭКДт  = СтрокаКорректировки.КЭКДт;
				Для к = 1 по СвойстваСчетаДт.КоличествоСубконто Цикл
					Проводка["СубконтоДт" + к] = СтрокаКорректировки["СубконтоКор" + к];
				КонецЦикла;
				Если СвойстваСчетаДт.УчетПоПодразделениям Тогда
					Проводка.ПодразделениеДт = СтрокаКорректировки.ПодразделениеДт;
				КонецЕсли;
				
				Проводка.СчетКт = СтрокаКорректировки.СчетКт;
				Проводка.КПСКт  = СтрокаКорректировки.КПСКт;
				Проводка.КЭККт  = СтрокаКорректировки.КЭККт;
				Проводка.СубконтоКт1 = СтрокаКорректировки.ВидЗатратКт;
				Если (ТипКЗ = "ОПЗ" И ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы)
				 ИЛИ (ТипКЗ = "ОХЗ" И ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы) Тогда
					Проводка.СубконтоКт2 = СтрокаКорректировки.НаправлениеДеятельностиКт;
				КонецЕсли;
				Если (ТипКЗ = "ОПЗ" И ПараметрыУчетаЗатрат.ЕстьПодразделениеНакладныеРасходы)
				 ИЛИ (ТипКЗ = "ОХЗ" И ПараметрыУчетаЗатрат.ЕстьПодразделениеОбщехозяйственныеРасходы) Тогда
					Проводка.ПодразделениеКт = СтрокаКорректировки.ПодразделениеКт;
				КонецЕсли;
				
				Проводка.Сумма          = СуммаСписания;
				Проводка.Содержание     = "Корректировка распределения общих затрат";
				Проводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
				
			КонецЕсли;
			
			СтрокаСписание109.Сумма = СтрокаСписание109.Сумма - СуммаСписания;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Корректировка распределения общих затрат Н25.01, Н26.01 на Н20.01.
//
Функция СформироватьКорректирующиеДвиженияН90_Н2001(ТаблицаДвижений, ТаблицаСписанияРаспределяемыхРасходовНаЕНВД, ДокументОбъект)
	
	Для Каждого СтрокаКорректировки Из ТаблицаСписанияРаспределяемыхРасходовНаЕНВД Цикл
		
		Если СтрокаКорректировки.СуммаКорректировки = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// 1. Перевод затрат из ресурса Сумма в ресурс СуммаЕНВД.
		НоваяСтрока = ТаблицаДвижений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКорректировки, "ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
		
		НоваяСтрока.Сумма     = СтрокаКорректировки.СуммаКорректировки * ДокументОбъект.ДоляЕНВД;
		НоваяСтрока.СуммаЕНВД = -СтрокаКорректировки.СуммаКорректировки * ДокументОбъект.ДоляЕНВД;
		
		НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
		НоваяСтрока.Содержание     = НСтр("ru = 'Распределение расходов на виды деятельности с особым порядком налогообложения (ЕНВД)'");
		
		// 2. Списание сумм ЕНВД на счета расходов по обычным видам деятельности.
		НоваяСтрока = ТаблицаДвижений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКорректировки, "ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
		
		НоваяСтрока.СуммаЕНВД = СтрокаКорректировки.СуммаКорректировки * ДокументОбъект.ДоляЕНВД;
		
		СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
		
		НоваяСтрока.СчетДт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н90.04");
		
		Для НомерСубконто = 1 По 3 Цикл
			// Если есть совпадающие субконто, например, "Направления деятельности", установим их.
			НоваяСтрока["СубконтоДт"+НомерСубконто] = БухгалтерскиеОперации.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, НомерСубконто,
				СвойстваСчетаКт.ВидСубконто1, СтрокаКорректировки.СубконтоКт1,
				СвойстваСчетаКт.ВидСубконто2, СтрокаКорректировки.СубконтоКт2,
				СвойстваСчетаКт.ВидСубконто3, СтрокаКорректировки.СубконтоКт3);
		КонецЦикла;
		
		НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
		НоваяСтрока.Содержание     = НСтр("ru = 'Списание прямых расходов по деятельности с особым порядком налогообложения (ЕНВД)'");
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Корректировка списания косвенных затрат с Кт Н20.02, Н25.02, Н26.02
//
Процедура СформироватьКорректирующиеДвиженияХХХ_Н2х02(ТаблицаДвижений, ТаблицаСписание109_105, ИФО, КФО)
	
	Запрос = Новый Запрос;
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ВиртуальнаяТаблицаПроводок", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаПроводок.ИФО,
	|	ТаблицаПроводок.КФО,
	|	ТаблицаПроводок.СчетДт,
	|	ТаблицаПроводок.ПодразделениеДт,
	|	ТаблицаПроводок.КПСДт,
	|	ТаблицаПроводок.КЭКДт,
	|	ТаблицаПроводок.СубконтоДт1,
	|	ТаблицаПроводок.СубконтоДт2,
	|	ТаблицаПроводок.СубконтоДт3,
	|	ТаблицаПроводок.СчетКт,
	|	ТаблицаПроводок.ПодразделениеКт,
	|	ТаблицаПроводок.КПСКт,
	|	ТаблицаПроводок.КЭККт,
	|	ТаблицаПроводок.СубконтоКт1,
	|	ТаблицаПроводок.СубконтоКт2,
	|	ТаблицаПроводок.СубконтоКт3,
	|	ТаблицаПроводок.Сумма
	|ПОМЕСТИТЬ ТаблицаПроводок
	|ИЗ
	|	&ТаблицаДвиженияДокумента КАК ТаблицаПроводок";
	Запрос.УстановитьПараметр("ТаблицаДвиженияДокумента", ТаблицаДвижений);
	
	НомераТаблиц.Вставить("ТаблицаСписаниеКосвенныхРасходов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ТаблицаПроводок.ИФО,
	|	ТаблицаПроводок.КФО,
	|	ТаблицаПроводок.СчетДт,
	|	ТаблицаПроводок.СубконтоДт1,
	|	ТаблицаПроводок.СубконтоДт2,
	|	ТаблицаПроводок.СубконтоДт3,
	|	ТаблицаПроводок.СчетКт,
	|	ТаблицаПроводок.СубконтоКт1,
	|	ТаблицаПроводок.СубконтоКт2,
	|	ТаблицаПроводок.СубконтоКт3,
	|	ТаблицаПроводок.СубконтоКт1 КАК НоменклатурнаяГруппа,
	|	ТаблицаПроводок.СубконтоКт2 КАК ВидЗатрат,
	|	ТаблицаПроводок.Сумма
	|ИЗ
	|	ТаблицаПроводок КАК ТаблицаПроводок
	|ГДЕ
	|	ТаблицаПроводок.ИФО = &ИФО
	|	И ТаблицаПроводок.КФО = &КФО
	|	И ТаблицаПроводок.СчетКт = &СчетКосвенныеРасходыПроизводстваНУ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаПроводок.ИФО,
	|	ТаблицаПроводок.КФО,
	|	ТаблицаПроводок.СчетДт,
	|	ТаблицаПроводок.СубконтоДт1,
	|	ТаблицаПроводок.СубконтоДт2,
	|	ТаблицаПроводок.СубконтоДт3,
	|	ТаблицаПроводок.СчетКт,
	|	ТаблицаПроводок.СубконтоКт1,
	|	ТаблицаПроводок.СубконтоКт2,
	|	ТаблицаПроводок.СубконтоКт3,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	|	ТаблицаПроводок.СубконтоКт1,
	|	ТаблицаПроводок.Сумма
	|ИЗ
	|	ТаблицаПроводок КАК ТаблицаПроводок
	|ГДЕ
	|	ТаблицаПроводок.ИФО = &ИФО
	|	И ТаблицаПроводок.КФО = &КФО
	|	И ТаблицаПроводок.СчетКт В (&СчетКосвенныеНакладныеРасходыНУ, &СчетКосвенныеОбщехозяйственныеРасходыНУ)";
	Запрос.УстановитьПараметр("СчетКосвенныеРасходыПроизводстваНУ",     БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н20.02"));
	Запрос.УстановитьПараметр("СчетКосвенныеНакладныеРасходыНУ",        БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н25.02"));
	Запрос.УстановитьПараметр("СчетКосвенныеОбщехозяйственныеРасходыНУ",БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н26.02"));
	
	Запрос.УстановитьПараметр("ИФО", ИФО);
	Запрос.УстановитьПараметр("КФО", КФО);
	
	Результат = Запрос.ВыполнитьПакет();
	ТаблицаСписаниеКосвенныхРасходов = Результат[НомераТаблиц.ТаблицаСписаниеКосвенныхРасходов].Выгрузить();
	
	СтрокиСписанияНаКосвенныеРасходы  = ТаблицаСписание109_105.НайтиСтроки(Новый Структура("ОПЗ_ОХЗ", "КосвенныеРасходыПроизводства"));
	СтрокиСписанияНаКосвенныеРасходы2 = ТаблицаСписание109_105.НайтиСтроки(Новый Структура("ОПЗ_ОХЗ", "КосвенныеОбщиеРасходы"));
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СтрокиСписанияНаКосвенныеРасходы, СтрокиСписанияНаКосвенныеРасходы2);
	
	Для Каждого СтрокаСписания Из СтрокиСписанияНаКосвенныеРасходы Цикл
		
		Отбор = Новый Структура("СчетКт, НоменклатурнаяГруппа, ВидЗатрат",
			СтрокаСписания.Счет, СтрокаСписания.НоменклатурнаяГруппа, СтрокаСписания.ВидЗатрат);
		НайденныеСтроки = ТаблицаСписаниеКосвенныхРасходов.НайтиСтроки(Отбор);
		
		МассивКоэффициентов = Новый Массив;
		Для Каждого СтрокаКорректировки Из НайденныеСтроки Цикл
			МассивКоэффициентов.Добавить(СтрокаКорректировки.Сумма);
		КонецЦикла;
		
		МассивСуммСписания = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаСписания.Сумма, МассивКоэффициентов);
		Если МассивСуммСписания = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Индекс = 0 По МассивСуммСписания.Количество() - 1 Цикл
			
			СтрокаКорректировки = НайденныеСтроки[Индекс];
			СуммаСписания       = МассивСуммСписания[Индекс];
			
			// Формируем проводки по корректировке списания косвенных расходов.
			Если СуммаСписания <> 0 Тогда
			
				Проводка = ТаблицаДвижений.Добавить();
				Проводка.ИФО = ИФО;
				Проводка.КФО = КФО;
				
				СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаКорректировки.СчетДт);
				СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаКорректировки.СчетКт);
				
				Проводка.СчетДт = СтрокаКорректировки.СчетДт;
				Для к = 1 по СвойстваСчетаДт.КоличествоСубконто Цикл
					Проводка["СубконтоДт" + к] = СтрокаКорректировки["СубконтоДт" + к];
				КонецЦикла;
				
				Проводка.СчетКт = СтрокаКорректировки.СчетКт;
				Для к = 1 по СвойстваСчетаКт.КоличествоСубконто Цикл
					Проводка["СубконтоКт" + к] = СтрокаКорректировки["СубконтоКт" + к];
				КонецЦикла;
				
				Проводка.Сумма          = СуммаСписания;
				Проводка.Содержание     = "Корректировка списания косвенных расходов";
				Проводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
				
