// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
    	
КонецПроцедуры

Процедура СформироватьПроводкиЗакрытиеПроизводственныхСчетов(ДокументОбъект, ТаблицаДвижений, ВидУчета = "БУ") Экспорт

	Если ТипЗнч(ДокументОбъект) <> Тип("ДокументОбъект.ЗакрытиеПроизводственныхСчетов") Тогда
		Возврат; // неверный тип документа
	КонецЕсли;
	
	// Общие параметры учета затрат.
	ПараметрыУчетаЗатрат = Документы.РаспределениеОбщихЗатрат.ПараметрыУчетаЗатрат(
		ДокументОбъект.Дата, ДокументОбъект.Организация, ДокументОбъект.ИФО, ДокументОбъект.КФО, ВидУчета);
	
	Если ВидУчета = "НУ" Тогда
		
		// Расчет долей списания косвенных расходов, в т.ч. нормируемых.
		ДолиСписанияНормируемыхРасходов = НалоговыйУчет.РассчитатьДолиСписанияКосвенныхРасходов(
			ДокументОбъект.Дата, ДокументОбъект.Организация, ДокументОбъект);
		
		// Списание косвенных расходов со счетов Н20.02, Н25.02, Н26.02 и Н44.
		СписатьКосвенныеРасходы(ТаблицаДвижений, ДокументОбъект, ДолиСписанияНормируемыхРасходов, ПараметрыУчетаЗатрат);
		
	КонецЕсли;
	
	// Распределение общих расходов со счетов 109.71, 109.81 на счет 109.61,
	// в налоговом учете - прямых расходов со счетов Н25.01, Н26.01 на счет Н20.01.
	РаспределитьОбщиеЗатраты(ТаблицаДвижений, ПараметрыУчетаЗатрат, ВидУчета);
	
	// Списание прямых расходов со счета Н20.01, не учитываемых для целей налогообложения,
	// а также относящихся к видам деятельности с особым порядком налогообложения (ЕНВД).
	ТаблицаСписанияРаспределяемыхРасходовНаЕНВД = Новый ТаблицаЗначений;
	Если ВидУчета = "НУ" Тогда
		
		ТаблицаСписанияРаспределяемыхРасходовНаЕНВД =
			СписатьНеучитываемыеРасходыИЕНВД(ТаблицаДвижений, ДокументОбъект, ПараметрыУчетаЗатрат);
		
	КонецЕсли;
	
	// Расчет себестоимости производства и корректировка оборотов.
	ДанныеДляУравнений = СобратьДанныеДляУравнений(ТаблицаДвижений, ПараметрыУчетаЗатрат, ДокументОбъект, ВидУчета);
	
	ДанныеДляУравнений.ДеревоДляРасчетаТау.Колонки.Добавить("Тау", Новый ОписаниеТипов("Число"));
	
	ДанныеДляУравнений.ДеревоОбъектовРасчета.Колонки.Добавить("АльфаОПЗ", Новый ОписаниеТипов("Число"));
	ДанныеДляУравнений.ДеревоОбъектовРасчета.Колонки.Добавить("АльфаОХЗ", Новый ОписаниеТипов("Число"));
	
	ДанныеДляУравнений.ДеревоОбороты109Косвенные.Колонки.Добавить("АльфаОПЗ", Новый ОписаниеТипов("Число"));
	ДанныеДляУравнений.ДеревоОбороты109Косвенные.Колонки.Добавить("АльфаОХЗ", Новый ОписаниеТипов("Число"));
	
	Для Каждого СтрокаОбъектовИФО Из ДанныеДляУравнений.ДеревоОбъектовРасчета.Строки Цикл
		Для Каждого СтрокаОбъектов Из СтрокаОбъектовИФО.Строки Цикл
			
			ИФО = СтрокаОбъектовИФО.ИФО;
			КФО = СтрокаОбъектов.КФО;
			
			СтрокаОбороты109ПР        = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоОбороты109ПР,		ИФО, КФО);
			СтрокаОбороты109Косвенные = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоОбороты109Косвенные,	ИФО, КФО);
			СтрокаОбороты105          = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоОбороты105, 			ИФО, КФО);
			СтрокаНачальныеОстатки    = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоНачальныеОстатки, 	ИФО, КФО);
			СтрокаКонечныеОстатки     = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоКонечныеОстатки, 	ИФО, КФО);
			СтрокаДляРасчетаТэтта     = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоДляРасчетаТэтта, 	ИФО, КФО);
			СтрокаДляРасчетаТау       = СтрокаДереваПоКФОиИФО(ДанныеДляУравнений.ДеревоДляРасчетаТау, 		ИФО, КФО);
			
			Если СтрокаОбороты109ПР = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			// Расчет коэффициентов распределения.
			РассчитатьКоэффициентыТау(
				СтрокаДляРасчетаТау, ДанныеДляУравнений.ДеревоДляРасчетаТауДоп);
			ТаблицаКоэффициентовТэтта = РассчитатьКоэффициентыТэтта(
				СтрокаДляРасчетаТау, СтрокаДляРасчетаТэтта);
			
			РассчитатьКоэффициентыАльфа(
				СтрокаОбъектов, СтрокаОбороты109Косвенные, ПараметрыУчетаЗатрат);
			
			ТаблицаКоэффициентовГамма = РассчитатьКоэффициентыГамма(
				СтрокаОбороты105, СтрокаНачальныеОстатки, СтрокаОбъектов,
				ДанныеДляУравнений.ДеревоОбороты105, ПараметрыУчетаЗатрат);
			
			// Расчет матрицы корректируемых оборотов.
			ПараметрыФормированияСистемыУравнений = Новый Структура;
			ПараметрыФормированияСистемыУравнений.Вставить("ДокументОбъект",               ДокументОбъект);
			ПараметрыФормированияСистемыУравнений.Вставить("ВидУчета",                     ВидУчета);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаОбъектов",               СтрокаОбъектов);
			ПараметрыФормированияСистемыУравнений.Вставить("ТаблицаКоэффициентовГамма",    ТаблицаКоэффициентовГамма);
			ПараметрыФормированияСистемыУравнений.Вставить("ТаблицаКоэффициентовТэтта",    ТаблицаКоэффициентовТэтта);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаОбороты109ПР",           СтрокаОбороты109ПР);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаОбороты109Косвенные",    СтрокаОбороты109Косвенные);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаНачальныеОстатки",       СтрокаНачальныеОстатки);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаКонечныеОстатки",        СтрокаКонечныеОстатки);
			ПараметрыФормированияСистемыУравнений.Вставить("ТаблицаВыпущеннойПродукции",   ДанныеДляУравнений.ТаблицаВыпущеннойПродукции);
			ПараметрыФормированияСистемыУравнений.Вставить("МассивВлияющихНомГрупп",       ДанныеДляУравнений.МассивВлияющихНомГрупп);
			ПараметрыФормированияСистемыУравнений.Вставить("ПараметрыУчетаЗатрат",         ПараметрыУчетаЗатрат);
			ПараметрыФормированияСистемыУравнений.Вставить("НачИндексДинамическихКолонок", 0);
			
			МатрицаОбъектов = СформироватьМатрицуСистемыУравнений(ПараметрыФормированияСистемыУравнений);
			РешитьСистемуЛинейныхУравнений(МатрицаОбъектов, ПараметрыФормированияСистемыУравнений);
			РасчитатьФактическиеОбороты(МатрицаОбъектов, СтрокаКонечныеОстатки, ВидУчета);
			
			// Формирование корректирующих движений.
			ТаблицаКорректировок105_109ПР = СформироватьКорректирующиеДвижения105_109ПР(ТаблицаДвижений,
				МатрицаОбъектов, СтрокаОбороты109ПР, ТаблицаКоэффициентовТэтта, ПараметрыУчетаЗатрат);
			
			ТаблицаСписание109_105 = СформироватьКорректирующиеДвиженияХХХ_105(ТаблицаДвижений,
				ТаблицаКорректировок105_109ПР, СтрокаОбороты105, СтрокаНачальныеОстатки, ПараметрыУчетаЗатрат);
			
			ТаблицыКорректировокХХХ_109 = СформироватьКорректирующиеДвиженияХХХ_109(ТаблицаДвижений,
				ТаблицаСписание109_105, СтрокаОбороты109Косвенные, ТаблицаСписанияРаспределяемыхРасходовНаЕНВД, ВидУчета, ПараметрыУчетаЗатрат);
			
			Если ВидУчета = "НУ" Тогда
				
				// Корректировка распределения общих прямых расходов НУ.
				СформироватьКорректирующиеДвиженияН90_Н2001(ТаблицаДвижений, ТаблицаСписанияРаспределяемыхРасходовНаЕНВД, ДокументОбъект);
				
				// Корректировка списания косвенных расходов НУ.
				СформироватьКорректирующиеДвиженияХХХ_Н2х02(ТаблицаДвижений, ТаблицаСписание109_105, ИФО, КФО);
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Проверяет корректность остатков затрат
//
Функция ОстаткиЗатратКорректны(ОстатокЗатрат, ТекстОшибки="")
	
	Если ОстатокЗатрат.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения Тогда
		
		Если ОстатокЗатрат.ВидРасходовНУ = Перечисления.ВидыРасходовНУ.НеУчитываемыеВЦеляхНалогообложения
		   И (ОстатокЗатрат.Сумма <> 0 ИЛИ ОстатокЗатрат.СуммаЕНВД <> 0) Тогда
			
			ТекстОшибки = ТекстОшибки + НСтр("ru='Некорректные остатки по счету %1 и виду затрат %2 (не учитываемые в целях налогообложения).'");
			Если ОстатокЗатрат.Сумма <> 0 Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru='
				|Остаток расходов по деятельности с основной системой налогообложения: %3; Ожидается: 0.00'");
			КонецЕсли;
			Если ОстатокЗатрат.СуммаЕНВД <> 0 Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru='
				|Остаток расходов по деятельности с особым порядком налогообложения (ЕНВД): %4; Ожидается: 0.00'");
			КонецЕсли;
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОстатокЗатрат.СчетКт,
				ОстатокЗатрат.ВидЗатрат,
				ОбщегоНазначенияБГУ.ФорматСумм(ОстатокЗатрат.Сумма),
				ОбщегоНазначенияБГУ.ФорматСумм(ОстатокЗатрат.СуммаЕНВД));
				
		КонецЕсли;
		
	ИначеЕсли ОстатокЗатрат.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения Тогда
		
		Если ОстатокЗатрат.Сумма <> 0 ИЛИ ОстатокЗатрат.СуммаНеУчитываетсяНУ <> 0 Тогда
			
			ТекстОшибки = ТекстОшибки + НСтр("ru='Некорректные остатки по счету %1 и виду затрат %2 (особый порядок налогообложения).'");
			Если ОстатокЗатрат.Сумма <> 0 Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru='
				|Остаток расходов по деятельности с основной системой налогообложения: %3; Ожидается: 0.00'");
			КонецЕсли;
			Если ОстатокЗатрат.СуммаНеУчитываетсяНУ <> 0 Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru='
				|Остаток расходов, не учитываемых для целей налогообложения прибыли: %4; Ожидается: 0.00'");
			КонецЕсли;
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОстатокЗатрат.СчетКт,
				ОстатокЗатрат.ВидЗатрат,
				ОбщегоНазначенияБГУ.ФорматСумм(ОстатокЗатрат.Сумма),
				ОбщегоНазначенияБГУ.ФорматСумм(ОстатокЗатрат.СуммаНеУчитываетсяНУ));
			
		КонецЕсли;
		
	ИначеЕсли ОстатокЗатрат.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты Тогда
		
		Если ОстатокЗатрат.СуммаЕНВД <> 0 ИЛИ ОстатокЗатрат.СуммаНеУчитываетсяНУ <> 0 Тогда
			
			ТекстОшибки = ТекстОшибки + НСтр("ru='Некорректные остатки по счету %1 и виду затрат %2 (распределяемые затраты).'");
			Если ОстатокЗатрат.СуммаЕНВД <> 0 Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru='
				|Остаток расходов по деятельности с особым порядком налогообложения (ЕНВД): %3; Ожидается: 0.00'");
			КонецЕсли;
			Если ОстатокЗатрат.СуммаНеУчитываетсяНУ <> 0 Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru='
				|Остаток расходов, не учитываемых для целей налогообложения прибыли: %4; Ожидается: 0.00'");
			КонецЕсли;
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОстатокЗатрат.СчетКт,
				ОстатокЗатрат.ВидЗатрат,
				ОбщегоНазначенияБГУ.ФорматСумм(ОстатокЗатрат.СуммаЕНВД),
				ОбщегоНазначенияБГУ.ФорматСумм(ОстатокЗатрат.СуммаНеУчитываетсяНУ));
			
		КонецЕсли;
		
	Иначе
		
		ТекстОшибки = ТекстОшибки + НСтр("ru='Для вида затрат %1 не установлен вид деятельности для целей налогового учета по налогу на прибыль.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ОстатокЗатрат.ВидЗатрат);
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Списывает косвенные расходы НУ
//
Процедура СписатьКосвенныеРасходы(ТаблицаДвижений, ДокументОбъект, ДолиСписанияНормируемыхРасходов, ПараметрыУчетаЗатрат)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Организация",   ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаОстатков",  Новый Граница(КонецМесяца(ДокументОбъект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетаРасходов", БухгалтерскийУчет.СписокСчетов("Н20.02,Н25.02,Н26.02,Н44"));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.КФО КАК КФО,
	|	ВложенныйЗапрос.ИФО КАК ИФО,
	|	ВложенныйЗапрос.Счет КАК СчетКт,
	|	ВложенныйЗапрос.Субконто1 КАК СубконтоКт1,
	|	ВложенныйЗапрос.Субконто2 КАК СубконтоКт2,
	|	ВложенныйЗапрос.Субконто3 КАК СубконтоКт3,
	|	ВложенныйЗапрос.ВидЗатрат КАК ВидЗатрат,
	|	ВложенныйЗапрос.ВидЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат КАК ВидДеятельностиНУ,
	|	ВложенныйЗапрос.ВидЗатрат.ВидРасходовНУ КАК ВидРасходовНУ,
	|	ВложенныйЗапрос.СуммаОстаток КАК Сумма,
	|	ВложенныйЗапрос.СуммаЕНВДОстатокДт КАК СуммаЕНВД,
	|	ВложенныйЗапрос.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУ
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕПСБУОстатки.Счет КАК Счет,
	|		ЕПСБУОстатки.КФО КАК КФО,
	|		ЕПСБУОстатки.ИФО КАК ИФО,
	|		ЕПСБУОстатки.Субконто1 КАК Субконто1,
	|		ЕПСБУОстатки.Субконто2 КАК Субконто2,
	|		ЕПСБУОстатки.Субконто3 КАК Субконто3,
	|		ВЫБОР
	|			КОГДА ЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ВидыЗатрат
	|				ТОГДА ЕПСБУОстатки.Субконто1
	|			КОГДА ЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ВидыЗатрат
	|				ТОГДА ЕПСБУОстатки.Субконто2
	|			КОГДА ЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.ВидыЗатрат
	|				ТОГДА ЕПСБУОстатки.Субконто3
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка)
	|		КОНЕЦ КАК ВидЗатрат,
	|		ЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстаток,
	|		ЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СуммаЕНВДОстатокДт,
	|		ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУОстатокДт
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|				&ДатаОстатков,
	|				Счет В (&СчетаРасходов),
	|				,
	|				Организация = &Организация
	|					И &УсловиеИФО
	|					И &УсловиеКФО) КАК ЕПСБУОстатки) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	КФО,
	|	ИФО,
	|	СчетКт,
	|	ВидЗатрат";
	
	Если ЗначениеЗаполнено(ДокументОбъект.КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", ДокументОбъект.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА" );
	КонецЕсли;
	
	Если ПараметрыУчетаЗатрат.ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;		
	
	КосвенныеРасходы = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаКосвенных Из КосвенныеРасходы Цикл
		
		// Проверяем корректность остатков затрат
		ТекстОшибки = "";
		Отказ = НЕ ОстаткиЗатратКорректны(СтрокаКосвенных, ТекстОшибки);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , "Объект");
		КонецЕсли;
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		// Формируем таблицу списания затрат
		Если СтрокаКосвенных.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения Тогда
			
			Если СтрокаКосвенных.Сумма <> 0 Тогда
				
				// Списание сумм расходов на счета расходов по обычным видам деятельности.
				НоваяСтрока = ТаблицаДвижений.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКосвенных, "ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
				
				Если СтрокаКосвенных.ВидРасходовНУ = Перечисления.ВидыРасходовНУ.ТранспортныеРасходы Тогда
					Коэффициент = ДокументОбъект.ДоляТранспортныхРасходов;
				ИначеЕсли ДолиСписанияНормируемыхРасходов[СтрокаКосвенных.ВидЗатрат] <> Неопределено
					    И ДолиСписанияНормируемыхРасходов[СтрокаКосвенных.ВидЗатрат] <> 0 Тогда
					Коэффициент = ДолиСписанияНормируемыхРасходов[СтрокаКосвенных.ВидЗатрат];
				Иначе
					Коэффициент = 1;
				КонецЕсли;
				НоваяСтрока.Сумма = СтрокаКосвенных.Сумма * Коэффициент;
				
				СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
				
				НоваяСтрока.СчетДт = ?(СтрокаКосвенных.ВидРасходовНУ = Перечисления.ВидыРасходовНУ.ТранспортныеРасходы,
					БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н90.05"),
					БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н90.06"));
				
				Для НомерСубконто = 1 По 3 Цикл
					// Если есть совпадающие субконто, например, "Направления деятельности", установим их.
					НоваяСтрока["СубконтоДт"+НомерСубконто] = БухгалтерскиеОперации.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, НомерСубконто,
						СвойстваСчетаКт.ВидСубконто1, СтрокаКосвенных.СубконтоКт1,
						СвойстваСчетаКт.ВидСубконто2, СтрокаКосвенных.СубконтоКт2,
						СвойстваСчетаКт.ВидСубконто3, СтрокаКосвенных.СубконтоКт3);
				КонецЦикла;
				
				НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
				НоваяСтрока.Содержание     = НСтр("ru = 'Списание косвенных расходов на производство'");
				
			КонецЕсли;
			
			Если СтрокаКосвенных.СуммаНеУчитываетсяНУ <> 0 ИЛИ СтрокаКосвенных.СуммаЕНВД <> 0 Тогда
				
				// Списание сумм не учитываемых расходов.
				НоваяСтрока = ТаблицаДвижений.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКосвенных, "ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
				
				НоваяСтрока.СуммаНеУчитываетсяНУ = СтрокаКосвенных.СуммаНеУчитываетсяНУ;
				НоваяСтрока.СуммаЕНВД            = СтрокаКосвенных.СуммаЕНВД;
				
				СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
				
				НоваяСтрока.СчетДт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н90.06");
				
				Для НомерСубконто = 1 По 3 Цикл
					// Если есть совпадающие субконто, например, "Направления деятельности", установим их.
					НоваяСтрока["СубконтоДт"+НомерСубконто] = БухгалтерскиеОперации.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, НомерСубконто,
						СвойстваСчетаКт.ВидСубконто1, СтрокаКосвенных.СубконтоКт1,
						СвойстваСчетаКт.ВидСубконто2, СтрокаКосвенных.СубконтоКт2,
						СвойстваСчетаКт.ВидСубконто3, СтрокаКосвенных.СубконтоКт3);
				КонецЦикла;
				
				НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
				НоваяСтрока.Содержание     = НСтр("ru = 'Списание косвенных расходов на производство'");
				
			КонецЕсли;
			
		ИначеЕсли СтрокаКосвенных.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения Тогда
			
			Если СтрокаКосвенных.СуммаЕНВД <> 0 Тогда
				
				// Списание сумм расходов по ЕНВД на счета расходов по обычным видам деятельности.
				НоваяСтрока = ТаблицаДвижений.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКосвенных, "ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
				
				НоваяСтрока.СуммаЕНВД = СтрокаКосвенных.СуммаЕНВД;
				
				СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
				
				НоваяСтрока.СчетДт = ?(СтрокаКосвенных.ВидРасходовНУ = Перечисления.ВидыРасходовНУ.ТранспортныеРасходы,
					БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н90.05"),
					БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н90.06"));
				
				Для НомерСубконто = 1 По 3 Цикл
					// Если есть совпадающие субконто, например, "Направления деятельности", установим их.
					НоваяСтрока["СубконтоДт"+НомерСубконто] = БухгалтерскиеОперации.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, НомерСубконто,
						СвойстваСчетаКт.ВидСубконто1, СтрокаКосвенных.СубконтоКт1,
						СвойстваСчетаКт.ВидСубконто2, СтрокаКосвенных.СубконтоКт2,
						СвойстваСчетаКт.ВидСубконто3, СтрокаКосвенных.СубконтоКт3);
				КонецЦикла;
				
				НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
				НоваяСтрока.Содержание     = НСтр("ru = 'Списание косвенных расходов на производство'");
				
			КонецЕсли;
			
		ИначеЕсли СтрокаКосвенных.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты Тогда
			
			Если СтрокаКосвенных.Сумма <> 0 Тогда
				
				// 1. В части, относящейся к деятельности с основной системой налогообложения.
				Если (1 - ДокументОбъект.ДоляЕНВД) <> 0 Тогда
					
					НоваяСтрока = ТаблицаДвижений.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКосвенных, "ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
					
					НоваяСтрока.Сумма = СтрокаКосвенных.Сумма * (1 - ДокументОбъект.ДоляЕНВД);
					
					СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
					
					НоваяСтрока.СчетДт = ?(СтрокаКосвенных.ВидРасходовНУ = Перечисления.ВидыРасходовНУ.ТранспортныеРасходы,
						БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н90.05"),
						БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н90.06"));
					
					Для НомерСубконто = 1 По 3 Цикл
						// Если есть совпадающие субконто, например, "Направления деятельности", установим их.
						НоваяСтрока["СубконтоДт"+НомерСубконто] = БухгалтерскиеОперации.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, НомерСубконто,
							СвойстваСчетаКт.ВидСубконто1, СтрокаКосвенных.СубконтоКт1,
							СвойстваСчетаКт.ВидСубконто2, СтрокаКосвенных.СубконтоКт2,
							СвойстваСчетаКт.ВидСубконто3, СтрокаКосвенных.СубконтоКт3);
					КонецЦикла;
					
					НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
					НоваяСтрока.Содержание     = НСтр("ru = 'Списание косвенных расходов на производство'");
					
				КонецЕсли;
				
				
				// 2. В части, относящейся к деятельности с особым порядком налогообложения.
				Если ДокументОбъект.ДоляЕНВД <> 0 Тогда
					
					// 2.1 Перевод затрат из ресурса Сумма в ресурс СуммаЕНВД.
					НоваяСтрока = ТаблицаДвижений.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКосвенных, "ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
					
					НоваяСтрока.Сумма     = СтрокаКосвенных.Сумма * ДокументОбъект.ДоляЕНВД;
					НоваяСтрока.СуммаЕНВД = -СтрокаКосвенных.Сумма * ДокументОбъект.ДоляЕНВД;
					
					НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
					НоваяСтрока.Содержание     = НСтр("ru = 'Распределение расходов на виды деятельности с особым порядком налогообложения (ЕНВД)'");
					
					// 2.2 Списание сумм ЕНВД на счета расходов по обычным видам деятельности.
					НоваяСтрока = ТаблицаДвижений.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКосвенных, "ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
					
					НоваяСтрока.СуммаЕНВД = СтрокаКосвенных.Сумма * ДокументОбъект.ДоляЕНВД;
					
					СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
					
					НоваяСтрока.СчетДт = ?(СтрокаКосвенных.ВидРасходовНУ = Перечисления.ВидыРасходовНУ.ТранспортныеРасходы,
						БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н90.05"),
						БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н90.06"));
					
					Для НомерСубконто = 1 По 3 Цикл
						// Если есть совпадающие субконто, например, "Направления деятельности", установим их.
						НоваяСтрока["СубконтоДт"+НомерСубконто] = БухгалтерскиеОперации.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, НомерСубконто,
							СвойстваСчетаКт.ВидСубконто1, СтрокаКосвенных.СубконтоКт1,
							СвойстваСчетаКт.ВидСубконто2, СтрокаКосвенных.СубконтоКт2,
							СвойстваСчетаКт.ВидСубконто3, СтрокаКосвенных.СубконтоКт3);
					КонецЦикла;
					
					НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
					НоваяСтрока.Содержание     = НСтр("ru = 'Списание косвенных расходов на производство'");
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Списывает расходы НУ, не учитываемые при налогообложении, а также относящиеся к ЕНВД
//
Функция СписатьНеучитываемыеРасходыИЕНВД(ТаблицаДвижений, ДокументОбъект, ПараметрыУчетаЗатрат)
	
	Запрос = Новый Запрос;
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ВиртуальнаяТаблицаПроводок", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаПроводок.ИФО,
	|	ТаблицаПроводок.КФО,
	|	ТаблицаПроводок.СчетДт,
	|	ТаблицаПроводок.ПодразделениеДт,
	|	ТаблицаПроводок.КПСДт,
	|	ТаблицаПроводок.КЭКДт,
	|	ТаблицаПроводок.СубконтоДт1,
	|	ТаблицаПроводок.СубконтоДт2,
	|	ТаблицаПроводок.СубконтоДт3,
	|	ТаблицаПроводок.СчетКт,
	|	ТаблицаПроводок.ПодразделениеКт,
	|	ТаблицаПроводок.КПСКт,
	|	ТаблицаПроводок.КЭККт,
	|	ТаблицаПроводок.СубконтоКт1,
	|	ТаблицаПроводок.СубконтоКт2,
	|	ТаблицаПроводок.СубконтоКт3,
	|	ТаблицаПроводок.Сумма,
	|	ТаблицаПроводок.СуммаЕНВД,
	|	ТаблицаПроводок.СуммаНеУчитываетсяНУ
	|ПОМЕСТИТЬ ТаблицаПроводок
	|ИЗ
	|	&ТаблицаДвиженияДокумента КАК ТаблицаПроводок";
	Запрос.УстановитьПараметр("ТаблицаДвиженияДокумента", ТаблицаДвижений);
	
	НомераТаблиц.Вставить("ТаблицаПрямыеРасходыВТаблицеДвижений", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ТаблицаПроводок.ИФО КАК ИФО,
	|	ТаблицаПроводок.КФО КАК КФО,
	|	ТаблицаПроводок.СчетДт КАК СчетКт,
	|	ТаблицаПроводок.СубконтоДт1 КАК СубконтоКт1,
	|	ТаблицаПроводок.СубконтоДт2 КАК СубконтоКт2,
	|	ТаблицаПроводок.СубконтоДт3 КАК СубконтоКт3,
	|	ТаблицаПроводок.СубконтоДт1 КАК Номенклатура,
	|	ТаблицаПроводок.СубконтоДт2 КАК ВидЗатрат,
	|	ТаблицаПроводок.СубконтоДт2.ВидДеятельностиДляНалоговогоУчетаЗатрат КАК ВидДеятельностиНУ,
	|	ТаблицаПроводок.СубконтоДт2.ВидРасходовНУ КАК ВидРасходовНУ,
	|	ТаблицаПроводок.Сумма КАК Сумма,
	|	ТаблицаПроводок.СуммаЕНВД КАК СуммаЕНВД,
	|	ТаблицаПроводок.СуммаНеУчитываетсяНУ КАК СуммаНеУчитываетсяНУ
	|ИЗ
	|	ТаблицаПроводок КАК ТаблицаПроводок
	|ГДЕ
	|	ТаблицаПроводок.СчетДт = &СчетПрямыеРасходыПроизводстваНУ";
	Запрос.УстановитьПараметр("СчетПрямыеРасходыПроизводстваНУ", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н20.01"));
	
	НомераТаблиц.Вставить("ОстаткиПрямыхРасходов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.ИФО КАК ИФО,
	|	ВложенныйЗапрос.КФО КАК КФО,
	|	ВложенныйЗапрос.Счет КАК СчетКт,
	|	ВложенныйЗапрос.Субконто1 КАК СубконтоКт1,
	|	ВложенныйЗапрос.Субконто2 КАК СубконтоКт2,
	|	ВложенныйЗапрос.Субконто3 КАК СубконтоКт3,
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	ВложенныйЗапрос.ВидЗатрат КАК ВидЗатрат,
	|	ВложенныйЗапрос.ВидЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат КАК ВидДеятельностиНУ,
	|	ВложенныйЗапрос.ВидЗатрат.ВидРасходовНУ КАК ВидРасходовНУ,
	|	ВложенныйЗапрос.СуммаОстаток КАК Сумма,
	|	ВложенныйЗапрос.СуммаЕНВДОстатокДт КАК СуммаЕНВД,
	|	ВложенныйЗапрос.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУ
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕПСБУОстатки.Счет КАК Счет,
	|		ЕПСБУОстатки.КФО КАК КФО,
	|		ЕПСБУОстатки.ИФО КАК ИФО,
	|		ЕПСБУОстатки.Субконто1 КАК Субконто1,
	|		ЕПСБУОстатки.Субконто2 КАК Субконто2,
	|		ЕПСБУОстатки.Субконто3 КАК Субконто3,
	|		ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|		ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
	|		ЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстаток,
	|		ЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СуммаЕНВДОстатокДт,
	|		ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУОстатокДт
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|				&ДатаОстатков,
	|				Счет В (&СчетаРасходов),
	|				,
	|				Организация = &Организация
	|					И &УсловиеИФО
	|					И &УсловиеКФО) КАК ЕПСБУОстатки) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	КФО,
	|	ИФО,
	|	СчетКт,
	|	ВидЗатрат";
	
	Запрос.УстановитьПараметр("Организация",   ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаОстатков",  Новый Граница(КонецМесяца(ДокументОбъект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетаРасходов", БухгалтерскийУчет.СписокСчетов("Н20.01"));
	
	Если ЗначениеЗаполнено(ДокументОбъект.КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", ДокументОбъект.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА");
	КонецЕсли;		
	
	Если ПараметрыУчетаЗатрат.ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаПрямыеРасходыВТаблицеДвижений = Результат[НомераТаблиц.ТаблицаПрямыеРасходыВТаблицеДвижений].Выгрузить();
	ПрямыеРасходыПроизводства            = Результат[НомераТаблиц.ОстаткиПрямыхРасходов].Выгрузить();
	
	ПрямыеРасходыПроизводства = Запрос.Выполнить().Выгрузить();
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаПрямыеРасходыВТаблицеДвижений, ПрямыеРасходыПроизводства);
	ПрямыеРасходыПроизводства.Свернуть(
		"ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3,Номенклатура,ВидЗатрат,ВидДеятельностиНУ,ВидРасходовНУ",
		"Сумма,СуммаЕНВД,СуммаНеУчитываетсяНУ");
	ПрямыеРасходыПроизводства.Сортировать("КФО,ИФО,СчетКт,ВидЗатрат");
	
	ТаблицаСписанияРаспределяемыхРасходовНаЕНВД = ПрямыеРасходыПроизводства.СкопироватьКолонки();
	ТаблицаСписанияРаспределяемыхРасходовНаЕНВД.Колонки.Добавить("СуммаКорректировки", Новый ОписаниеТипов("Число"));
	
	Для Каждого СтрокаПрямых Из ПрямыеРасходыПроизводства Цикл
		
		Если СтрокаПрямых.СуммаНеУчитываетсяНУ = 0 И СтрокаПрямых.СуммаЕНВД = 0
		   И СтрокаПрямых.Сумма <> 0
		   И СтрокаПрямых.ВидДеятельностиНУ <> Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты
		Тогда
			Продолжить; // Пропускаем расходы, которые не имеют отношения к ЕНВД и не учитываемым.
		КонецЕсли;
		
		// Проверяем корректность остатков затрат
		ТекстОшибки = "";
		Отказ = НЕ ОстаткиЗатратКорректны(СтрокаПрямых, ТекстОшибки);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект, , "Объект");
		КонецЕсли;
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		// Формируем таблицу списания затрат
		Если СтрокаПрямых.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения Тогда
			
			Если СтрокаПрямых.Сумма <> 0 Тогда
				// Эти расходы не списываем. Они будут участвовать в расчете себестоимости производства.
			КонецЕсли;
			
			Если СтрокаПрямых.СуммаНеУчитываетсяНУ <> 0 ИЛИ СтрокаПрямых.СуммаЕНВД <> 0 Тогда
				
				// Списание сумм не учитываемых расходов.
				НоваяСтрока = ТаблицаДвижений.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПрямых, "ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
				
				НоваяСтрока.СуммаНеУчитываетсяНУ = СтрокаПрямых.СуммаНеУчитываетсяНУ;
				НоваяСтрока.СуммаЕНВД            = СтрокаПрямых.СуммаЕНВД;
				
				СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
				
				НоваяСтрока.СчетДт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н90.04");
				
				Для НомерСубконто = 1 По 3 Цикл
					// Если есть совпадающие субконто, например, "Направления деятельности", установим их.
					НоваяСтрока["СубконтоДт"+НомерСубконто] = БухгалтерскиеОперации.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, НомерСубконто,
						СвойстваСчетаКт.ВидСубконто1, СтрокаПрямых.СубконтоКт1,
						СвойстваСчетаКт.ВидСубконто2, СтрокаПрямых.СубконтоКт2,
						СвойстваСчетаКт.ВидСубконто3, СтрокаПрямых.СубконтоКт3);
				КонецЦикла;
				
				НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
				НоваяСтрока.Содержание     = НСтр("ru = 'Списание прямых расходов, не учитываемых в целях налогообложения'");
				
			КонецЕсли;
			
		ИначеЕсли СтрокаПрямых.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения Тогда
			
			Если СтрокаПрямых.СуммаЕНВД <> 0 Тогда
				
				// Списание сумм расходов по ЕНВД на счета расходов по обычным видам деятельности.
				НоваяСтрока = ТаблицаДвижений.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПрямых, "ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
				
				НоваяСтрока.СуммаЕНВД = СтрокаПрямых.СуммаЕНВД;
				
				СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
				
				НоваяСтрока.СчетДт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н90.04");
				
				Для НомерСубконто = 1 По 3 Цикл
					// Если есть совпадающие субконто, например, "Направления деятельности", установим их.
					НоваяСтрока["СубконтоДт"+НомерСубконто] = БухгалтерскиеОперации.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, НомерСубконто,
						СвойстваСчетаКт.ВидСубконто1, СтрокаПрямых.СубконтоКт1,
						СвойстваСчетаКт.ВидСубконто2, СтрокаПрямых.СубконтоКт2,
						СвойстваСчетаКт.ВидСубконто3, СтрокаПрямых.СубконтоКт3);
				КонецЦикла;
				
				НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
				НоваяСтрока.Содержание     = НСтр("ru = 'Списание прямых расходов по деятельности с особым порядком налогообложения (ЕНВД)'");
				
			КонецЕсли;
			
		ИначеЕсли СтрокаПрямых.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты Тогда
			
			Если СтрокаПрямых.Сумма <> 0 Тогда
				
				// 1. В части, относящейся к деятельности с основной системой налогообложения.
				Если (1 - ДокументОбъект.ДоляЕНВД) <> 0 Тогда
					// Эти расходы не списываем. Они будут участвовать в расчете себестоимости производства.
				КонецЕсли;
				
				
				// 2. В части, относящейся к деятельности с особым порядком налогообложения.
				Если ДокументОбъект.ДоляЕНВД <> 0 Тогда
					
					// 2.1 Перевод затрат из ресурса Сумма в ресурс СуммаЕНВД.
					НоваяСтрока = ТаблицаДвижений.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПрямых, "ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
					
					НоваяСтрока.Сумма     = СтрокаПрямых.Сумма * ДокументОбъект.ДоляЕНВД;
					НоваяСтрока.СуммаЕНВД = -СтрокаПрямых.Сумма * ДокументОбъект.ДоляЕНВД;
					
					НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
					НоваяСтрока.Содержание     = НСтр("ru = 'Распределение расходов на виды деятельности с особым порядком налогообложения (ЕНВД)'");
					
					// 2.2 Списание сумм ЕНВД на счета расходов по обычным видам деятельности.
					НоваяСтрока = ТаблицаДвижений.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПрямых, "ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
					
					НоваяСтрока.СуммаЕНВД = СтрокаПрямых.Сумма * ДокументОбъект.ДоляЕНВД;
					
					СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
					
					НоваяСтрока.СчетДт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н90.04");
					
					Для НомерСубконто = 1 По 3 Цикл
						// Если есть совпадающие субконто, например, "Направления деятельности", установим их.
						НоваяСтрока["СубконтоДт"+НомерСубконто] = БухгалтерскиеОперации.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, НомерСубконто,
							СвойстваСчетаКт.ВидСубконто1, СтрокаПрямых.СубконтоКт1,
							СвойстваСчетаКт.ВидСубконто2, СтрокаПрямых.СубконтоКт2,
							СвойстваСчетаКт.ВидСубконто3, СтрокаПрямых.СубконтоКт3);
					КонецЦикла;
					
					НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
					НоваяСтрока.Содержание     = НСтр("ru = 'Списание прямых расходов по деятельности с особым порядком налогообложения (ЕНВД)'");
					
					// 2.3 Запомним в таблице корректировок.
					// Добавим строку с параметрами списания распределяемых расходов с Н20.01 на ЕНВД.
					// После расчета стоимости продукции и последующей корректировки эти обороты, возможно, придется скорректировать.
					СтрокаТаблицы = ТаблицаСписанияРаспределяемыхРасходовНаЕНВД.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаПрямых, , "Сумма");
					СтрокаТаблицы.Сумма = СтрокаПрямых.Сумма * ДокументОбъект.ДоляЕНВД;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	//ТаблицаСписанияРаспределяемыхРасходовНаЕНВД.Свернуть("ИФО, КФО, СчетКт, Номенклатура, ВидЗатрат", "Сумма, СуммаКорректировки");
	ТаблицаСписанияРаспределяемыхРасходовНаЕНВД.Свернуть("ИФО, КФО, СчетКт, СубконтоКт1, СубконтоКт2, СубконтоКт3", "Сумма, СуммаКорректировки");
	
	Возврат ТаблицаСписанияРаспределяемыхРасходовНаЕНВД;
	
КонецФункции

// Распределение общих затрат на производство
//
Процедура РаспределитьОбщиеЗатраты(ТаблицаДвижений, ПараметрыУчетаЗатрат, ВидУчета = "БУ")
	
	ТаблицаРаспределенияЗатрат = Документы.РаспределениеОбщихЗатрат.РаспределитьОбщиеЗатраты(ПараметрыУчетаЗатрат, ВидУчета);
	
	Для Каждого СтрокаЗатрат Из ТаблицаРаспределенияЗатрат Цикл
	
		НоваяСтрока = ТаблицаДвижений.Добавить();
		НоваяСтрока.ИФО = СтрокаЗатрат.ИФО;
		НоваяСтрока.КФО = СтрокаЗатрат.КФО;
		
		НоваяСтрока.СчетДт          = СтрокаЗатрат.СчетПЗ;
		НоваяСтрока.КПСДт           = СтрокаЗатрат.КПССчетПЗ;
		НоваяСтрока.КЭКДт           = СтрокаЗатрат.КЭКСчетОЗ;
		НоваяСтрока.СубконтоДт1     = СтрокаЗатрат.Номенклатура;
		НоваяСтрока.СубконтоДт2     = СтрокаЗатрат.ВидЗатратОЗ;
		НоваяСтрока.СубконтоДт3     = СтрокаЗатрат.НаправлениеДеятельностиПЗ;
		НоваяСтрока.ПодразделениеДт = СтрокаЗатрат.ПодразделениеПЗ;
		
		НоваяСтрока.СчетКт          = СтрокаЗатрат.СчетОЗ;
		НоваяСтрока.КПСКт           = СтрокаЗатрат.КПССчетОЗ;
		НоваяСтрока.КЭККт           = СтрокаЗатрат.КЭКСчетОЗ;
		НоваяСтрока.СубконтоКт1     = СтрокаЗатрат.ВидЗатратОЗ;
		НоваяСтрока.СубконтоКт2     = СтрокаЗатрат.НаправлениеДеятельностиОЗ;
		НоваяСтрока.ПодразделениеКт = СтрокаЗатрат.ПодразделениеОЗ;
		
		НоваяСтрока.Сумма                = СтрокаЗатрат.Сумма;
		НоваяСтрока.СуммаЕНВД            = СтрокаЗатрат.СуммаЕНВД;
		НоваяСтрока.СуммаНеУчитываетсяНУ = СтрокаЗатрат.СуммаНеУчитываетсяНУ;
		НоваяСтрока.ЖурналОпераций       = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
		НоваяСтрока.Содержание           = НСтр("ru = 'Списание общих расходов на производство'");
	
	КонецЦикла;
	
КонецПроцедуры

// Данные для уравнений
//
Функция СобратьДанныеДляУравнений(ТаблицаДвиженияДокумента, ПараметрыУчетаЗатрат, ДокументОбъект, ВидУчета = "БУ")
	
	Запрос = Новый Запрос;
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ВиртуальнаяТаблицаПроводок", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаПроводок.ИФО,
	|	ТаблицаПроводок.КФО,
	|	ТаблицаПроводок.СчетДт,
	|	ТаблицаПроводок.ПодразделениеДт,
	|	ТаблицаПроводок.КПСДт,
	|	ТаблицаПроводок.КЭКДт,
	|	ТаблицаПроводок.СубконтоДт1,
	|	ТаблицаПроводок.СубконтоДт2,
	|	ТаблицаПроводок.СубконтоДт3,
	|	ТаблицаПроводок.СчетКт,
	|	ТаблицаПроводок.ПодразделениеКт,
	|	ТаблицаПроводок.КПСКт,
	|	ТаблицаПроводок.КЭККт,
	|	ТаблицаПроводок.СубконтоКт1,
	|	ТаблицаПроводок.СубконтоКт2,
	|	ТаблицаПроводок.СубконтоКт3,
	|	ТаблицаПроводок.Сумма,
	|	ТаблицаПроводок.СуммаНеУчитываетсяНУ,
	|	ТаблицаПроводок.СуммаЕНВД
	|ПОМЕСТИТЬ ТаблицаПроводок
	|ИЗ
	|	&ТаблицаДвиженияДокумента КАК ТаблицаПроводок";
	Запрос.УстановитьПараметр("ТаблицаДвиженияДокумента", ТаблицаДвиженияДокумента);
	
	НомераТаблиц.Вставить("ВиртуальнаяТаблицаСчетов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	""105"" КАК ОткудаКуда,
	|	ИСТИНА КАК Счет105,
	|	ЕПСБУ.УчетПоПодразделениям КАК ЕстьПодразделение,
	|	ЛОЖЬ КАК ЕстьНаправлениеДеятельности
	|ПОМЕСТИТЬ ТаблицаСчетов
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	НЕ ЕПСБУ.ЭлементГруппа
	|	И ЕПСБУ.Ссылка В(&СчетаУчетаМЗ)
	|	И ИСТИНА В
	|			(ВЫБРАТЬ
	|				ИСТИНА КАК ЕстьСубконтоНоменклатура
	|			ИЗ
	|				ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|			ГДЕ
	|				ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
	|				И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	""Прочее"",
	|	ЛОЖЬ,
	|	&ЕстьПодразделениеСебестоимость,
	|	&ЕстьНаправлениеДеятельностиСебестоимость
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка = &СчетСебестоимость
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	""ОПЗ"",
	|	ЛОЖЬ,
	|	&ЕстьПодразделениеНакладныеРасходы,
	|	&ЕстьНаправлениеДеятельностиНакладныеРасходы
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка = &СчетНакладныеРасходы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	""ОХЗ"",
	|	ЛОЖЬ,
	|	&ЕстьПодразделениеОбщехозяйственныеРасходы,
	|	&ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка = &СчетОбщехозяйственныеРасходы
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	Счет105";
	Если ВидУчета = "БУ" Тогда
		Запрос.УстановитьПараметр("СчетаУчетаМЗ", БухгалтерскийУчет.СписокСчетов("105.00"));
	Иначе // НУ
		Запрос.УстановитьПараметр("СчетаУчетаМЗ", БухгалтерскийУчет.СписокСчетов("Н10,Н41.01,Н43"));
	КонецЕсли;
	
	НомераТаблиц.Вставить("ВиртуальнаяТаблицаВсеОборотыПервая", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВиртуальнаяТаблицаВсеОбороты", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("УничтожитьВсеОборотыПервая", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ЖурналПроводок.ИФО КАК ИФО,
	|	ЖурналПроводок.КФО,
	|	ЖурналПроводок.СчетДт КАК СчетДт,
	|	ЖурналПроводок.КПСДт,
	|	ЖурналПроводок.КЭКДт,
	|	ЖурналПроводок.ВидСубконтоДт1,
	|	ЖурналПроводок.СубконтоДт1,
	|	ЖурналПроводок.ВидСубконтоДт2,
	|	ЖурналПроводок.СубконтоДт2,
	|	ЖурналПроводок.ВидСубконтоДт3,
	|	ЖурналПроводок.СубконтоДт3,
	|	ЖурналПроводок.ПодразделениеДт КАК ПодразделениеДт,
	|	ЖурналПроводок.СчетКт КАК СчетКт,
	|	ЖурналПроводок.КПСКт,
	|	ЖурналПроводок.КЭККт,
	|	ЖурналПроводок.ВидСубконтоКт1,
	|	ЖурналПроводок.СубконтоКт1,
	|	ЖурналПроводок.ВидСубконтоКт2,
	|	ЖурналПроводок.СубконтоКт2,
	|	ЖурналПроводок.ВидСубконтоКт3,
	|	ЖурналПроводок.СубконтоКт3,
	|	ЖурналПроводок.ПодразделениеКт КАК ПодразделениеКт,
	|	ЖурналПроводок.Сумма,
	|	ЖурналПроводок.КоличествоДт,
	|	ЖурналПроводок.КоличествоКт,
	|	ЖурналПроводок.Регистратор
	|ПОМЕСТИТЬ ВсеОборотыПервая
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И Регистратор <> &ДокументСсылка
	|				И (СчетДт В
	|						(ВЫБРАТЬ
	|							ТаблицаСчетов.Ссылка
	|						ИЗ
	|							ТаблицаСчетов КАК ТаблицаСчетов)
	|					ИЛИ СчетКт В
	|						(ВЫБРАТЬ
	|							ТаблицаСчетов.Ссылка
	|						ИЗ
	|							ТаблицаСчетов КАК ТаблицаСчетов)),
	|			,
	|			) КАК ЖурналПроводок
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЖурналПроводок.ИФО,
	|	ЖурналПроводок.КФО,
	|	ЖурналПроводок.СчетДт,
	|	ЖурналПроводок.КПСДт,
	|	ЖурналПроводок.КЭКДт,
	|	ЕПСБУВидыСубконтоДт1.ВидСубконто,
	|	ЖурналПроводок.СубконтоДт1,
	|	ЕПСБУВидыСубконтоДт2.ВидСубконто,
	|	ЖурналПроводок.СубконтоДт2,
	|	ЕПСБУВидыСубконтоДт3.ВидСубконто,
	|	ЖурналПроводок.СубконтоДт3,
	|	ЖурналПроводок.ПодразделениеДт,
	|	ЖурналПроводок.СчетКт,
	|	ЖурналПроводок.КПСКт,
	|	ЖурналПроводок.КЭККт,
	|	ЕПСБУВидыСубконтоКт1.ВидСубконто,
	|	ЖурналПроводок.СубконтоКт1,
	|	ЕПСБУВидыСубконтоКт2.ВидСубконто,
	|	ЖурналПроводок.СубконтоКт2,
	|	ЕПСБУВидыСубконтоКт3.ВидСубконто,
	|	ЖурналПроводок.СубконтоКт3,
	|	ЖурналПроводок.ПодразделениеКт,
	|	ЖурналПроводок.Сумма,
	|	0,
	|	0,
	|	NULL
	|ИЗ
	|	ТаблицаПроводок КАК ЖурналПроводок
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоДт1
	|		ПО ЖурналПроводок.СчетДт = ЕПСБУВидыСубконтоДт1.Ссылка
	|			И (ЕПСБУВидыСубконтоДт1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоДт2
	|		ПО ЖурналПроводок.СчетДт = ЕПСБУВидыСубконтоДт2.Ссылка
	|			И (ЕПСБУВидыСубконтоДт2.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоДт3
	|		ПО ЖурналПроводок.СчетДт = ЕПСБУВидыСубконтоДт3.Ссылка
	|			И (ЕПСБУВидыСубконтоДт3.НомерСтроки = 3)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоКт1
	|		ПО ЖурналПроводок.СчетКт = ЕПСБУВидыСубконтоКт1.Ссылка
	|			И (ЕПСБУВидыСубконтоКт1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоКт2
	|		ПО ЖурналПроводок.СчетКт = ЕПСБУВидыСубконтоКт2.Ссылка
	|			И (ЕПСБУВидыСубконтоКт2.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоКт3
	|		ПО ЖурналПроводок.СчетКт = ЕПСБУВидыСубконтоКт3.Ссылка
	|			И (ЕПСБУВидыСубконтоКт3.НомерСтроки = 3)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетДт,
	|	СчетКт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеОборотыПервая.ИФО КАК ИФО,
	|	ВсеОборотыПервая.КФО КАК КФО,
	|	ВсеОборотыПервая.СчетДт КАК СчетДт,
	|	ВсеОборотыПервая.КПСДт КАК КПСДт,
	|	ВсеОборотыПервая.КЭКДт КАК КЭКДт,
	|	ВсеОборотыПервая.ВидСубконтоДт1,
	|	ВсеОборотыПервая.СубконтоДт1,
