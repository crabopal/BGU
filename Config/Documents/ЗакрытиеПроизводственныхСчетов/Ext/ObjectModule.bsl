	Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Возврат Дерево;
КонецФункции	

Процедура СписатьКорректировкуПрочее_КЗ(СтруктураПараметров)
	
	СтрокаДетальная	= СтруктураПараметров.СтрокаДетальная;
	СуммаСписания	= СтруктураПараметров.СуммаСписания;
	ТекИФО			= СтруктураПараметров.ИФО;
	ТекКФО			= СтруктураПараметров.КФО;
	ВидКЗ			= СтруктураПараметров.ТипКЗ;
	
	Проводка = ТаблицаДвиженияДокумента.Добавить();
	Проводка.ИФО			= ТекИФО;
	Проводка.КФО			= ТекКФО;
	
	// Параметры дебета проводки
	Проводка.СчетДт			= СтрокаДетальная.СчетДт;
	Проводка.КПСДт			= СтрокаДетальная.КПСКт;
	Проводка.КЭКДт			= СтрокаДетальная.КЭКДт;
	Для к = 1 по Проводка.СчетДт.ВидыСубконто.Количество() Цикл
		Проводка["СубконтоДт" + к] = СтрокаДетальная["СубконтоКор" + к];
	КонецЦикла;	
	
	// Параметры кредита проводки
	Проводка.СчетКт			= СтрокаДетальная.СчетКт;
	Проводка.КПСКт			= СтрокаДетальная.КПСКт;
	Проводка.КЭККт			= СтрокаДетальная.КЭККт;
	Проводка.СубконтоКт1	= СтрокаДетальная.ВидЗатратКт;
	Если ВидКЗ = "ОПЗ" И ЕстьНД10970 ИЛИ ВидКЗ = "ОХЗ" И ЕстьНД10980 Тогда
		Проводка.СубконтоКт2 = СтрокаДетальная.НаправлениеДеятельностиКт;
	КонецЕсли;	
	
	// Общие числовые параметры проводки
	Проводка.Сумма			= СуммаСписания;
	Проводка.Содержание		= "Корректировка распределения косвенных затрат";
	Проводка.ЖурналОпераций	= БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
	
КонецПроцедуры	

Функция СформироватьДеревоПЗ_КЗ(ТаблицаПЗ_КЗ, СтрокаПЗ)
	
	ТипКЗ = СтрокаПЗ.ОПЗ_ОХЗ;
	Для каждого СтрокаВидЗатрат из СтрокаПЗ.Строки Цикл
		Для каждого СтрокаПодразделение из СтрокаВидЗатрат.Строки Цикл
			Для каждого СтрокаНаправлениеДеятельности из СтрокаПодразделение.Строки Цикл
				Для каждого СтрокаДетальная из СтрокаНаправлениеДеятельности.Строки Цикл
					НоваяСтрока = ТаблицаПЗ_КЗ.Добавить();
					НоваяСтрока.СчетДт						= СтрокаДетальная.КорСчет;
					НоваяСтрока.КЭКДт						= СтрокаДетальная.КорКЭК;
					НоваяСтрока.КПСДт						= СтрокаДетальная.КорКПС;
					НоваяСтрока.НоменклатурнаяГруппаДт		= СтрокаДетальная.КорСубконто1;
					НоваяСтрока.ВидЗатратДт					= СтрокаДетальная.КорСубконто2;
					НоваяСтрока.КлючЗатратДт				= СтрокаДетальная.КлючЗатратКор;
					НоваяСтрока.НаправлениеДеятельностиДт	= СтрокаДетальная.КорСубконто3;
					НоваяСтрока.СчетКт						= СтрокаДетальная.Счет;
					НоваяСтрока.КЭККт						= СтрокаДетальная.КЭК;
					НоваяСтрока.КПСКт						= СтрокаДетальная.КПС;
					НоваяСтрока.ВидЗатратКт					= СтрокаДетальная.ВидЗатрат;
					НоваяСтрока.КлючЗатратКт				= СтрокаДетальная.КлючЗатрат;
					НоваяСтрока.ПодразделениеКт				= СтрокаДетальная.Подразделение;
					НоваяСтрока.НаправлениеДеятельностиКт	= СтрокаДетальная.НаправлениеДеятельности;
					НоваяСтрока.Сумма						= СтрокаДетальная.СуммаОборотКт;
					НоваяСтрока.Альфа						= СтрокаДетальная["Альфа" + ТипКЗ];
				КонецЦикла;	
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;	
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаПЗ_КЗ.СчетДт,
	               |	ТаблицаПЗ_КЗ.КЭКДт,
	               |	ТаблицаПЗ_КЗ.КПСДт,
	               |	ТаблицаПЗ_КЗ.НоменклатурнаяГруппаДт,
	               |	ТаблицаПЗ_КЗ.ВидЗатратДт,
	               |	ВЫРАЗИТЬ(ТаблицаПЗ_КЗ.КлючЗатратДт КАК СТРОКА(12)) КАК КлючЗатратДт,
	               |	ТаблицаПЗ_КЗ.НаправлениеДеятельностиДт,
	               |	ТаблицаПЗ_КЗ.СчетКт,
	               |	ТаблицаПЗ_КЗ.КЭККт,
	               |	ТаблицаПЗ_КЗ.КПСКт,
	               |	ТаблицаПЗ_КЗ.ВидЗатратКт,
	               |	ВЫРАЗИТЬ(ТаблицаПЗ_КЗ.КлючЗатратКт КАК СТРОКА(12)) КАК КлючЗатратКт,
	               |	ТаблицаПЗ_КЗ.ПодразделениеКт,
	               |	ТаблицаПЗ_КЗ.НаправлениеДеятельностиКт,
	               |	ТаблицаПЗ_КЗ.Альфа,
	               |	ТаблицаПЗ_КЗ.Сумма
	               |ПОМЕСТИТЬ ТабПЗ_КЗ
	               |ИЗ
	               |	&ТаблицаПЗ_КЗ КАК ТаблицаПЗ_КЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТабПЗ_КЗ.СчетДт,
	               |	ТабПЗ_КЗ.НоменклатурнаяГруппаДт КАК НоменклатурнаяГруппаДт,
	               |	ТабПЗ_КЗ.СчетКт КАК СчетКт,
	               |	ТабПЗ_КЗ.КПСКт КАК КПСКт,
	               |	ТабПЗ_КЗ.ВидЗатратКт КАК ВидЗатратКт,
	               |	ВЫРАЗИТЬ(ТабПЗ_КЗ.КлючЗатратКт КАК СТРОКА(12)) КАК КлючЗатратКт,
	               |	ТабПЗ_КЗ.НаправлениеДеятельностиКт КАК НаправлениеДеятельностиКт,
	               |	ТабПЗ_КЗ.НаправлениеДеятельностиДт КАК НаправлениеДеятельностиДт,
	               |	СУММА(ТабПЗ_КЗ.Альфа) КАК Альфа,
	               |	СУММА(ТабПЗ_КЗ.Сумма) КАК Сумма,
	               |	ТабПЗ_КЗ.КЭККт,
	               |	ТабПЗ_КЗ.КЭКДт,
	               |	ТабПЗ_КЗ.ПодразделениеКт КАК ПодразделениеКт
	               |ИЗ
	               |	ТабПЗ_КЗ КАК ТабПЗ_КЗ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТабПЗ_КЗ.СчетДт,
	               |	ТабПЗ_КЗ.НоменклатурнаяГруппаДт,
	               |	ТабПЗ_КЗ.СчетКт,
	               |	ТабПЗ_КЗ.КПСКт,
	               |	ТабПЗ_КЗ.ВидЗатратКт,
	               |	ВЫРАЗИТЬ(ТабПЗ_КЗ.КлючЗатратКт КАК СТРОКА(12)),
	               |	ТабПЗ_КЗ.НаправлениеДеятельностиКт,
	               |	ТабПЗ_КЗ.НаправлениеДеятельностиДт,
	               |	ТабПЗ_КЗ.КЭККт,
	               |	ТабПЗ_КЗ.КЭКДт,
	               |	ТабПЗ_КЗ.ПодразделениеКт
	               |ИТОГИ
	               |	СУММА(Альфа),
	               |	СУММА(Сумма)
	               |ПО
	               |	КлючЗатратКт,
	               |	ПодразделениеКт,
	               |	НаправлениеДеятельностиКт,
	               |	СчетКт,
	               |	КПСКт";
				   
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("ТаблицаПЗ_КЗ", ТаблицаПЗ_КЗ);
	
	Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Возврат Дерево;
	
КонецФункции

Процедура СписатьКорректировкуКЗ(СтруктураПараметров)
	
	СтрокаДетальная	= СтруктураПараметров.СтрокаДетальная;
	СуммаСписания	= СтруктураПараметров.СуммаСписания;
	ТекИФО			= СтруктураПараметров.ИФО;
	ТекКФО			= СтруктураПараметров.КФО;
	ВидКЗ			= СтруктураПараметров.ТипКЗ;
	
	Проводка = ТаблицаДвиженияДокумента.Добавить();
	Проводка.КФО			= ТекКФО;
	Проводка.ИФО			= ТекИФО;
	
	Проводка.СчетДт			= СтрокаДетальная.СчетДт;
	Проводка.КПСДт			= СтрокаДетальная.КПСКт; // вопрос почему КПСКт
	Проводка.КЭКДт			= СтрокаДетальная.КЭКДт;
	Проводка.СубконтоДт1	= СтрокаДетальная.НоменклатурнаяГруппаДт;
	Проводка.СубконтоДт2	= СтрокаДетальная.ВидЗатратКт;
	Если ЕстьНД10960 Тогда
		Проводка.СубконтоДт3 = СтрокаДетальная.НаправлениеДеятельностиДт;
	КонецЕсли;	
	
	// Параметры кредита проводки
	Проводка.СчетКт			= СтрокаДетальная.СчетКт;
	Проводка.КПСКт			= СтрокаДетальная.КПСКт;
	Проводка.КЭККт			= СтрокаДетальная.КЭККт;
	Проводка.СубконтоКт1	= СтрокаДетальная.ВидЗатратКт;
	Если (ВидКЗ = "ОПЗ" И ЕстьНД10970) ИЛИ (ВидКЗ = "ОХЗ" И ЕстьНД10980) Тогда
		Проводка.СубконтоКт2 = СтрокаДетальная.НаправлениеДеятельностиКт;
	КонецЕсли;	
	
	// Общие числовые параметры проводки
	Проводка.Сумма      	= СуммаСписания;
	Проводка.Содержание 	= "Корректировка распределения косвенных затрат";
	Проводка.ЖурналОпераций	= БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
	
КонецПроцедуры	

