								НоваяСтрока.Счет         = СтрокаДетальная.СчетДт;
								НоваяСтрока.КПС          = СтрокаДетальная.КПСДт;
								НоваяСтрока.Номенклатура = СтрокаДетальная.НоменклатураДт;
								НоваяСтрока.Количество   = СтрокаДетальная.Количество;
								НоваяСтрока.Сумма        = СтрокаДетальная.Сумма;
							КонецЦикла;	
						КонецЦикла;	
					КонецЦикла;	
				КонецЦикла;	
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;	
	
	ТаблицаПроводок.Свернуть("Счет, КПС, Номенклатура", "Количество, Сумма");
	
	Возврат ТаблицаПроводок;
КонецФункции	

Процедура СформироватьКорректирующиеДвиженияХХХ_105(ТаблицаОборотовДт105, СтрокаОбороты105, СтрокаНачальныеОстатки, ТаблицаКорректировокКЗ)

	СтрокаСписания = СтрокаОбороты105.Строки.Найти("Списание", "Направление", Ложь);
	Если СтрокаСписания = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ТекКФО = СтрокаОбороты105.КФО;
	ТекИФО = СтрокаОбороты105.ИФО;
	
	ДеревоПроводокХХХ_105 = СформироватьДеревоПроводокХХХ_105(СтрокаСписания);
	ДобавитьОстатки105(ТаблицаОборотовДт105, СтрокаНачальныеОстатки);
	
	Для каждого СтрокаСчета из ДеревоПроводокХХХ_105.Строки Цикл
		Для каждого СтрокаКПС из СтрокаСчета.Строки Цикл
			Для каждого СтрокаНоменклатуры из СтрокаКПС.Строки Цикл
				
				ВсегоКоличество = СтрокаНоменклатуры.Количество;
				Если ВсегоКоличество = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				СтруктураПоиска = Новый Структура("Счет, КПС, Номенклатура", СтрокаНоменклатуры.СчетКт, СтрокаНоменклатуры.КПСКт, СтрокаНоменклатуры.СубконтоКт1);
				МассивСтрок = ТаблицаОборотовДт105.НайтиСтроки(СтруктураПоиска);
				Если МассивСтрок.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;	
				КоличествоНаВходе = МассивСтрок[0].Количество;
				СуммаНаВходе      = МассивСтрок[0].Сумма;
				ЦенаЕдиницы = ?(КоличествоНаВходе = 0, 0, СуммаНаВходе / КоличествоНаВходе);
				
				ВсегоКоличествоСписано = 0;
				ВсегоСуммаСписано      = 0;
				Для каждого СтрокаДетальная из СтрокаНоменклатуры.Строки Цикл
					КоличествоСписания     = СтрокаДетальная.Количество;
					СуммаСписанияСтарая    = СтрокаДетальная.Сумма;
					ВсегоКоличествоСписано = ВсегоКоличествоСписано + КоличествоСписания;
					Если ВсегоКоличествоСписано >= КоличествоНаВходе Тогда
						ТекСуммаСписания = СуммаНаВходе - ВсегоСуммаСписано - СуммаСписанияСтарая;
					Иначе
						ТекСуммаСписания  = Окр(КоличествоСписания * ЦенаЕдиницы, 2) - СуммаСписанияСтарая;
						ВсегоСуммаСписано = ВсегоСуммаСписано + Окр(КоличествоСписания * ЦенаЕдиницы, 2);
					КонецЕсли;	
					СписатьСоСчета105(СтрокаДетальная, ТекСуммаСписания, ТекКФО, ТекИФО, ТаблицаКорректировокКЗ);
				
					Если СтрокаДетальная.СчетДтКод3 <> "105" Тогда
						Продолжить;	
					КонецЕсли;
					
					СтруктураПоиска1 = Новый Структура("Счет, КПС, Номенклатура", СтрокаНоменклатуры.СчетДт, СтрокаНоменклатуры.КПСДт, СтрокаНоменклатуры.СубконтоДт1);
					МассивСтрок1 = ТаблицаОборотовДт105.НайтиСтроки(СтруктураПоиска1);
					Если МассивСтрок1.Количество() = 0 Тогда
						НоваяСтрока = ТаблицаОборотовДт105.Добавить();
						НоваяСтрока.Счет         = СтрокаДетальная.СчетДт;
						НоваяСтрока.КПС          = СтрокаДетальная.КПСДт;
						НоваяСтрока.Номенклатура = СтрокаДетальная.СубконтоДт1;
						НоваяСтрока.Количество   = КоличествоСписания;
						НоваяСтрока.Сумма        = СуммаСписанияСтарая + ТекСуммаСписания;
					Иначе	
						МассивСтрок1[0].Количество = МассивСтрок1[0].Количество + КоличествоСписания;
						МассивСтрок1[0].Сумма      = МассивСтрок1[0].Сумма + ТекСуммаСписания;
					КонецЕсли;	
				
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура СписатьСоСчета105(СтрокаДетальная, ТекСуммаСписания, ТекКФО, ТекИФО, ТаблицаКорректировокКЗ)
	
	Проводка = ТаблицаДвиженияДокумента.Добавить();
	Проводка.ИФО				= ТекИФО;
	Проводка.КФО				= ТекКФО;
	
	Проводка.СчетДт				= СтрокаДетальная.СчетДт;
	Проводка.КПСДт				= СтрокаДетальная.КПСДт;
	Проводка.КЭКДт				= СтрокаДетальная.КЭКДт;
	Для Индекс = 1 По СтрокаДетальная.КоличествоСубконто Цикл
		Проводка["СубконтоДт" + Индекс]	= СтрокаДетальная["СубконтоДт" + Индекс];	
	КонецЦикла; 
	Проводка.ПодразделениеДт	= СтрокаДетальная.ПодразделениеДт;
	
	Проводка.СчетКт				= СтрокаДетальная.СчетКт;
	Проводка.КПСКт				= СтрокаДетальная.КПСКт;
	Проводка.КЭККт				= СтрокаДетальная.КЭККт;
	Проводка.СубконтоКт1		= СтрокаДетальная.СубконтоКт1;
	Проводка.ПодразделениеКт	= СтрокаДетальная.ПодразделениеКт;
	
	Проводка.Сумма				= ТекСуммаСписания;
	Проводка.Содержание			= НСтр("ru = 'Корректировка списания материалов по фактической стоимости'");
	Проводка.ЖурналОпераций		= БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
	
	ЕстьКорректировкаКЗ = Ложь;
	Если Проводка.СчетДт = Счет10970 Тогда
		ТекОПЗ_ОХЗ = "ОПЗ";
		ЕстьКорректировкаКЗ = Истина;
	ИначеЕсли Проводка.СчетДт = Счет10980 Тогда
		ТекОПЗ_ОХЗ = "ОХЗ";
		ЕстьКорректировкаКЗ = Истина;
	КонецЕсли;	
	Если ЕстьКорректировкаКЗ = Истина Тогда
		НоваяСтрока = ТаблицаКорректировокКЗ.Добавить();
		НоваяСтрока.ОПЗ_ОХЗ                 = ТекОПЗ_ОХЗ;
		НоваяСтрока.Счет                    = Проводка.СчетДт;
		НоваяСтрока.КПС                     = Проводка.КПСДт;
		НоваяСтрока.ВидЗатрат               = СтрокаДетальная.СубконтоДт1;
		НоваяСтрока.КЭКЗатрат             	= СтрокаДетальная.КЭКДт;
		НоваяСтрока.КлючЗатрат              = СтрокаДетальная.КлючЗатрат;
		НоваяСтрока.Подразделение			= СтрокаДетальная.ПодразделениеДт;
		НоваяСтрока.НаправлениеДеятельности = СтрокаДетальная.СубконтоДт2;
		НоваяСтрока.Сумма                   = ТекСуммаСписания;
	КонецЕсли;
	ТаблицаКорректировокКЗ.Свернуть("ОПЗ_ОХЗ, Счет, КПС, ВидЗатрат, КЭКЗатрат, КлючЗатрат, Подразделение, НаправлениеДеятельности", "Сумма");
	
КонецПроцедуры

