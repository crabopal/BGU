		КонецЕсли;	
		СуммаКЗ_ПЗ = 0;
		Для каждого ТекСтрока из МассивСтрокНД Цикл
			СуммаКЗ_ПЗ = СуммаКЗ_ПЗ + ТекСтрока.Сумма;
		КонецЦикла;	
		
		СуммаАльф  = 0;
		МаксИндекс = МассивСтрокНД.ВГраница();
		Для к = 0 по МаксИндекс Цикл
			Если (к = МаксИндекс) И (СуммаКЗ_ПЗ = СуммаЗатратВсего) Тогда
				ТекАльфа = 1 - СуммаАльф;
			Иначе
				ТекАльфа = МассивСтрокНД[к].Сумма / СуммаЗатратВсего;
			КонецЕсли;	
			СуммаАльф = СуммаАльф + ТекАльфа;
			СтруктураПоиска = Новый Структура("НаправлениеДеятельности, НоменклатурнаяГруппа, КлючЗатрат", 
											  МассивСтрокНД[к].НаправлениеДеятельностиПЗ, 
											  МассивСтрокНД[к].НоменклатурнаяГруппа, 
											  МассивСтрокНД[к].КлючЗатрат);
			МассивСтрок = СтрокаОбъектовКФО.Строки.НайтиСтроки(СтруктураПоиска);
			Для каждого ТекЭлемент из МассивСтрок Цикл
				ТекЭлемент[ИмяКолонки] = ТекАльфа;
			КонецЦикла;
			СтруктураПоиска = Новый Структура("КорСубконто3, КорСубконто1, КлючЗатрат", 
												  МассивСтрокНД[к].НаправлениеДеятельностиПЗ, 
												  МассивСтрокНД[к].НоменклатурнаяГруппа, 
												  МассивСтрокНД[к].КлючЗатрат);
			Если ЕстьНД Тогда
				СтруктураПоиска.Вставить("НаправлениеДеятельности", МассивСтрокНД[к].НаправлениеДеятельности);
