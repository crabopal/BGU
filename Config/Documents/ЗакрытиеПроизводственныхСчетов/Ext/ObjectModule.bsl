Процедура СкорректироватьПрочее_КЗ(СтруктураДанных)
	
	ТипКЗ							= СтруктураДанных.ТипКЗ;
	СтрокаОПЗ_ОХЗ					= СтруктураДанных.СтрокаОПЗ_ОХЗ;
	СтрокаОПЗ_ОХЗ_Коррректировка	= СтруктураДанных.СтрокаОПЗ_ОХЗ_Коррректировка;
	ТекИФО							= СтруктураДанных.ТекИФО;
	ТекКФО							= СтруктураДанных.ТекКФО;
	ТаблицаПрочее_КЗ				= СтруктураДанных.ТаблицаПрочее_КЗ;
	
	ДеревоПрочее_КЗ = СформироватьДеревоПрочее_КЗ(ТаблицаПрочее_КЗ, СтрокаОПЗ_ОХЗ);
	
	// Если распределение по текущему типу КЗ было, то сумму корректировки будем распределять
	// по каждому виду затрат в рамках каждого направления деятельности пропорционально.
	Для каждого СтрокаВидаЗатрат_Корректировка из СтрокаОПЗ_ОХЗ_Коррректировка.Строки Цикл
		СтрокаВидЗатрат = ДеревоПрочее_КЗ.Строки.Найти(СтрокаВидаЗатрат_Корректировка.КлючЗатрат, "КлючЗатратКт", Ложь);
		Если СтрокаВидЗатрат = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		Для каждого СтрокаПодразделение_Корректировка из СтрокаВидаЗатрат_Корректировка.Строки Цикл
			СтрокаПодразделение = СтрокаВидЗатрат.Строки.Найти(СтрокаПодразделение_Корректировка.Подразделение, "ПодразделениеКт", Ложь);
			Если СтрокаПодразделение = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
			
			Для каждого СтрокаНаправлениеДеятельности_Корректировка из СтрокаПодразделение_Корректировка.Строки Цикл
				СтрокаНаправлениеДеятельности = СтрокаПодразделение.Строки.Найти(СтрокаНаправлениеДеятельности_Корректировка.НаправлениеДеятельности, "НаправлениеДеятельностиКт", Ложь);
				Если СтрокаНаправлениеДеятельности = Неопределено Тогда
					Продолжить;
				КонецЕсли;	
				
				Для каждого СтрокаСчет_Корректировка из СтрокаНаправлениеДеятельности_Корректировка.Строки Цикл
					СтрокаСчета = СтрокаНаправлениеДеятельности.Строки.Найти(СтрокаСчет_Корректировка.Счет, "СчетКт", Ложь);
					Если СтрокаСчета = Неопределено Тогда
						Продолжить;
					КонецЕсли;	
					
					Для каждого СтрокаДетальная_Корректировка из СтрокаСчет_Корректировка.Строки Цикл
						СтрокаКПС = СтрокаСчета.Строки.Найти(СтрокаДетальная_Корректировка.КПС, "КПСКт", Ложь);
						Если СтрокаКПС = Неопределено Тогда
							Продолжить;
						КонецЕсли;	
						
						СуммаКорректировки = СтрокаДетальная_Корректировка.Сумма;
						МаксИндекс = СтрокаКПС.Строки.Количество() - 1;
						СуммаВего = СтрокаКПС.Сумма;
						СписаноВсего = 0;
						Для каждого СтрокаДетальная из СтрокаКПС.Строки Цикл
							Если СтрокаКПС.Строки.Индекс(СтрокаДетальная) = МаксИндекс Тогда
								СуммаСписания = СуммаКорректировки - СписаноВсего;
							Иначе	
								СуммаСписания = Окр(СуммаКорректировки * СтрокаДетальная.Сумма / СуммаВего, 2);
								СписаноВсего = СписаноВсего + СуммаСписания;
							КонецЕсли;	
							Если СуммаСписания <> 0 Тогда
								СтруктураПараметров1 = Новый Структура("СтрокаДетальная, СуммаСписания, ИФО, КФО, ТипКЗ",
																		СтрокаДетальная, СуммаСписания, ТекИФО, ТекКФО, ТипКЗ);
								СписатьКорректировкуПрочее_КЗ(СтруктураПараметров1);
							КонецЕсли;	
						КонецЦикла;	
					КонецЦикла;	
				КонецЦикла;	
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;	
КонецПроцедуры	

Процедура СкорректироватьПЗ_КЗ(СтруктураДанных)
	
	ТипКЗ							= СтруктураДанных.ТипКЗ;
	ТаблицаПЗ_КЗ					= СтруктураДанных.ТаблицаПЗ_КЗ;
	СтрокаПЗ						= СтруктураДанных.СтрокаПЗ;
	СтрокаОПЗ_ОХЗ_Коррректировка	= СтруктураДанных.СтрокаОПЗ_ОХЗ_Коррректировка;
	ТекИФО							= СтруктураДанных.ТекИФО;
	ТекКФО							= СтруктураДанных.ТекКФО;
	
	ДеревоПЗ_КЗ = СформироватьДеревоПЗ_КЗ(ТаблицаПЗ_КЗ, СтрокаПЗ);
	
	// Если распределение по текущему типу КЗ было, то сумму корректировки будем распределять
	// по каждому виду затрат в рамках каждого направления деятельности в соответствии с коэффициентами альфа.
	Для каждого СтрокаВидаЗатрат_Корректировка из СтрокаОПЗ_ОХЗ_Коррректировка.Строки Цикл
		СтрокаВидЗатрат = ДеревоПЗ_КЗ.Строки.Найти(СтрокаВидаЗатрат_Корректировка.КлючЗатрат, "КлючЗатратКт", Ложь);
		Если СтрокаВидЗатрат = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		Для каждого СтрокаПодразделение_Корректировка из СтрокаВидаЗатрат_Корректировка.Строки Цикл
			СтрокаПодразделение = СтрокаВидЗатрат.Строки.Найти(СтрокаПодразделение_Корректировка.Подразделение, "ПодразделениеКт", Ложь);
			Если СтрокаПодразделение = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
		
			Для каждого СтрокаНаправлениеДеятельности_Корректировка из СтрокаПодразделение_Корректировка.Строки Цикл
				СтрокаНаправлениеДеятельности = СтрокаПодразделение.Строки.Найти(СтрокаНаправлениеДеятельности_Корректировка.НаправлениеДеятельности, "НаправлениеДеятельностиКт", Ложь);
				Если СтрокаНаправлениеДеятельности = Неопределено Тогда
					Продолжить;
				КонецЕсли;	
				
				Для каждого СтрокаСчет_Корректировка из СтрокаНаправлениеДеятельности_Корректировка.Строки Цикл
					СтрокаСчета = СтрокаНаправлениеДеятельности.Строки.Найти(СтрокаСчет_Корректировка.Счет, "СчетКт", Ложь);
					Если СтрокаСчета = Неопределено Тогда
						Продолжить;
					КонецЕсли;	
					
					Для каждого СтрокаДетальная_Корректировка из СтрокаСчет_Корректировка.Строки Цикл
						СтрокаКПС = СтрокаСчета.Строки.Найти(СтрокаДетальная_Корректировка.КПС, "КПСКт", Ложь);
						Если СтрокаКПС = Неопределено Тогда
							Продолжить;
						КонецЕсли;	
						
						// Проверим всю ли сумму корректировки будем списывать, или останется еще на прочее списание
						ЕстьСписаниеПрочее = Ложь;
						СтруктураПоиска = Новый Структура("НаправлениеДеятельности, Счет, КлючЗатрат, КПС", 
														СтрокаКПС.НаправлениеДеятельностиКт, СтрокаКПС.СчетКт, СтрокаКПС.КлючЗатратКт, СтрокаКПС.КПСКт);
						Для каждого Строка1 из СтрокаПЗ.Родитель.Строки Цикл
							Если Строка1.ОткудаКуда = "ПЗ" Тогда
								Продолжить;
							КонецЕсли;	
							
							Если Строка1.Строки.НайтиСтроки(СтруктураПоиска, Истина).Количество() <> 0 Тогда
								ЕстьСписаниеПрочее = Истина;
								Прервать;
							КонецЕсли;	
						КонецЦикла;	
						
						СуммаКорректировки = СтрокаДетальная_Корректировка.Сумма;
						МаксИндекс = СтрокаКПС.Строки.Количество() - 1;
						СписаноВсего = 0;
						Для каждого СтрокаДетальная из СтрокаКПС.Строки Цикл
							Если СтрокаКПС.Строки.Индекс(СтрокаДетальная) = МаксИндекс И НЕ ЕстьСписаниеПрочее Тогда
								СуммаСписания = СуммаКорректировки - СписаноВсего;
							Иначе	
								СуммаСписания = Окр(СуммаКорректировки * СтрокаДетальная["Альфа"], 2);
								СписаноВсего = СписаноВсего + СуммаСписания;
							КонецЕсли;	
							
							Если СуммаСписания <> 0 Тогда
								СтруктураПараметров1 = Новый Структура("СтрокаДетальная, СуммаСписания, ИФО, КФО, ТипКЗ",
																		СтрокаДетальная, СуммаСписания, ТекИФО, ТекКФО, ТипКЗ);
								СписатьКорректировкуКЗ(СтруктураПараметров1);
							КонецЕсли;	
						КонецЦикла;	
						
						СтрокаДетальная_Корректировка.Сумма = СтрокаДетальная_Корректировка.Сумма - СписаноВсего;
					КонецЦикла;	
				КонецЦикла;	
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;	
КонецПроцедуры	

Функция СформироватьДеревоПрочее_КЗ(ТаблицаПрочее_КЗ, СтрокаОПЗ_ОХЗ)
	Для каждого СтрокаОткудаКуда из СтрокаОПЗ_ОХЗ.Строки Цикл
		Если СтрокаОткудаКуда.ОткудаКуда = "ПЗ" Тогда
			Продолжить;
		КонецЕсли;	
		
		Для каждого СтрокаВидЗатрат из СтрокаОткудаКуда.Строки Цикл
			Для каждого СтрокаПодразделение из СтрокаВидЗатрат.Строки Цикл
				Для каждого СтрокаНаправлениеДеятельности из СтрокаПодразделение.Строки Цикл
					Для каждого СтрокаДетальная из СтрокаНаправлениеДеятельности.Строки Цикл
						НоваяСтрока = ТаблицаПрочее_КЗ.Добавить();
						НоваяСтрока.СчетДт						= СтрокаДетальная.КорСчет;
						НоваяСтрока.КЭКДт						= СтрокаДетальная.КорКЭК;
						НоваяСтрока.КПСДт						= СтрокаДетальная.КорКПС;
						НоваяСтрока.СубконтоКор1				= СтрокаДетальная.КорСубконто1;
						НоваяСтрока.СубконтоКор2				= СтрокаДетальная.КорСубконто2;
						НоваяСтрока.СубконтоКор3				= СтрокаДетальная.КорСубконто3;
						НоваяСтрока.СчетКт						= СтрокаДетальная.Счет;
						НоваяСтрока.КЭККт						= СтрокаДетальная.КЭК;
						НоваяСтрока.КПСКт						= СтрокаДетальная.КПС;
						НоваяСтрока.ВидЗатратКт					= СтрокаДетальная.ВидЗатрат;
						НоваяСтрока.КлючЗатратКт				= СтрокаДетальная.КлючЗатрат;
						НоваяСтрока.ПодразделениеКт				= СтрокаДетальная.Подразделение;
						НоваяСтрока.НаправлениеДеятельностиКт	= СтрокаДетальная.НаправлениеДеятельности;
						НоваяСтрока.Сумма						= СтрокаДетальная.СуммаОборотКт;
					КонецЦикла;	
				КонецЦикла;	
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;	
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаПрочее_КЗ.СчетДт,
	               |	ТаблицаПрочее_КЗ.КЭКДт,
	               |	ТаблицаПрочее_КЗ.КПСДт,
	               |	ТаблицаПрочее_КЗ.СубконтоКор1,
	               |	ТаблицаПрочее_КЗ.СубконтоКор2,
	               |	ТаблицаПрочее_КЗ.СубконтоКор3,
	               |	ТаблицаПрочее_КЗ.СчетКт,
	               |	ТаблицаПрочее_КЗ.КЭККт,
	               |	ТаблицаПрочее_КЗ.КПСКт,
	               |	ТаблицаПрочее_КЗ.ВидЗатратКт,
	               |	ТаблицаПрочее_КЗ.ПодразделениеКт,
	               |	ТаблицаПрочее_КЗ.НаправлениеДеятельностиКт,
	               |	ВЫРАЗИТЬ(ТаблицаПрочее_КЗ.КлючЗатратКт КАК СТРОКА(12)) КАК КлючЗатратКт,
	               |	ТаблицаПрочее_КЗ.Сумма
	               |ПОМЕСТИТЬ ТабПрочее_КЗ
	               |ИЗ
	               |	&ТаблицаПрочее_КЗ КАК ТаблицаПрочее_КЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТабПрочее_КЗ.СчетКт КАК СчетКт,
	               |	ТабПрочее_КЗ.КПСКт КАК КПСКт,
	               |	ТабПрочее_КЗ.ВидЗатратКт КАК ВидЗатратКт,
	               |	ТабПрочее_КЗ.НаправлениеДеятельностиКт КАК НаправлениеДеятельностиКт,
	               |	ТабПрочее_КЗ.КлючЗатратКт КАК КлючЗатратКт,
	               |	ТабПрочее_КЗ.СчетДт,
	               |	ТабПрочее_КЗ.СубконтоКор1,
	               |	ТабПрочее_КЗ.СубконтоКор2,
	               |	ТабПрочее_КЗ.СубконтоКор3,
	               |	СУММА(ТабПрочее_КЗ.Сумма) КАК Сумма,
	               |	ТабПрочее_КЗ.КЭККт,
	               |	ТабПрочее_КЗ.КЭКДт,
	               |	ТабПрочее_КЗ.ПодразделениеКт КАК ПодразделениеКт
	               |ИЗ
	               |	ТабПрочее_КЗ КАК ТабПрочее_КЗ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТабПрочее_КЗ.СчетКт,
