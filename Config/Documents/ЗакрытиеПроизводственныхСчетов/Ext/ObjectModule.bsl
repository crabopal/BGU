		КонецЕсли;	
		СуммаЗатратВсего = 0;
		Для каждого ТекСтрока из МассивСтрокНД1 Цикл
			СуммаЗатратВсего = СуммаЗатратВсего + ТекСтрока.Сумма;
		КонецЦикла;	
		Если СуммаЗатратВсего = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		// Расчитаем сумму списания КЗ только на прямые затраты
		МассивСтрокНД = ТаблицаДоп.НайтиСтроки(СтруктураПоиска);
		Если МассивСтрокНД.Количество() = 0 Тогда
