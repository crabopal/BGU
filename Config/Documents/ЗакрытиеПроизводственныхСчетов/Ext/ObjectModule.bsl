						НоваяСтрока1.Сумма                   = СтрокаДетальные.СуммаОборотКт;
						
					КонецЦикла;	
				КонецЦикла;	
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;	
	ТаблицаДоп1.Свернуть("НаправлениеДеятельности, НоменклатурнаяГруппа, КлючЗатрат", "Сумма");
	
	Для каждого СтрокаВидЗатрат из СтрокаОткудаКудаПЗ.Строки Цикл
		Для каждого СтрокаПодразделение из СтрокаВидЗатрат.Строки Цикл
			Для каждого СтрокаНаправлениеДеятельности из СтрокаПодразделение.Строки Цикл
				Для каждого СтрокаДетальные из СтрокаНаправлениеДеятельности.Строки Цикл
					
					НоваяСтрока = ТаблицаДоп.Добавить();
