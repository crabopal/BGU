Процедура СформироватьКорректирующиеДвиженияСписанияС_109КЗ(СтруктураПараметров)

	ДеревоКорректировокКЗ		= СтруктураПараметров.ДеревоКорректировокКЗ;
	СтрокаОбороты109Косвенные	= СтруктураПараметров.СтрокаОбороты109Косвенные; 
	ТекКФО						= СтруктураПараметров.КФО;
	ТекИФО						= СтруктураПараметров.ИФО;
	
	Если СтрокаОбороты109Косвенные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	СтрокаСписание = СтрокаОбороты109Косвенные.Строки.Найти("Списание", "Направление", Ложь);
	Если СтрокаСписание = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	МассивТиповКЗ = Новый Массив;
	МассивТиповКЗ.Добавить("ОПЗ");
	МассивТиповКЗ.Добавить("ОХЗ");
	
	ТаблицаПЗ_КЗ     = СформироватьСтруктуруТаблицыПЗ_КЗ();
	ТаблицаПрочее_КЗ = СформироватьСтруктуруТаблицыПрочее_КЗ();
	
	Для каждого ТипКЗ из МассивТиповКЗ Цикл
		СтрокаОПЗ_ОХЗ_Коррректировка = ДеревоКорректировокКЗ.Строки.Найти(ТипКЗ, "ОПЗ_ОХЗ", Ложь);
		Если СтрокаОПЗ_ОХЗ_Коррректировка = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		СтрокаОПЗ_ОХЗ = СтрокаСписание.Строки.Найти(ТипКЗ, "ОПЗ_ОХЗ", Ложь);
		Если СтрокаОПЗ_ОХЗ = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		СтрокаПЗ = СтрокаОПЗ_ОХЗ.Строки.Найти("ПЗ", "ОткудаКуда", Ложь);
		Если СтрокаПЗ = Неопределено Тогда
			СтруктураДанных = Новый Структура("ТипКЗ, ТаблицаПрочее_КЗ, СтрокаОПЗ_ОХЗ, СтрокаОПЗ_ОХЗ_Коррректировка, ТекИФО, ТекКФО",
											ТипКЗ, ТаблицаПрочее_КЗ, СтрокаОПЗ_ОХЗ, СтрокаОПЗ_ОХЗ_Коррректировка, ТекИФО, ТекКФО);
			СкорректироватьПрочее_КЗ(СтруктураДанных);
		Иначе	
			СтруктураДанных = Новый Структура("ТипКЗ, ТаблицаПЗ_КЗ, СтрокаПЗ, СтрокаОПЗ_ОХЗ_Коррректировка, ТекИФО, ТекКФО",
											ТипКЗ, ТаблицаПЗ_КЗ, СтрокаПЗ, СтрокаОПЗ_ОХЗ_Коррректировка, ТекИФО, ТекКФО);
			СкорректироватьПЗ_КЗ(СтруктураДанных);
			
			СтруктураДанных = Новый Структура("ТипКЗ, ТаблицаПрочее_КЗ, СтрокаОПЗ_ОХЗ, СтрокаОПЗ_ОХЗ_Коррректировка, ТекИФО, ТекКФО",
											ТипКЗ, ТаблицаПрочее_КЗ, СтрокаОПЗ_ОХЗ, СтрокаОПЗ_ОХЗ_Коррректировка, ТекИФО, ТекКФО);
			СкорректироватьПрочее_КЗ(СтруктураДанных);
		КонецЕсли;	
	КонецЦикла;	

КонецПроцедуры 

Функция СформироватьСтруктуруТаблицыПЗ_КЗ()
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("СчетДт",						Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Таблица.Колонки.Добавить("КЭКДт",						Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Таблица.Колонки.Добавить("КПСДт", 						Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Таблица.Колонки.Добавить("НоменклатурнаяГруппаДт",		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("ВидЗатратДт", 				Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	Таблица.Колонки.Добавить("КлючЗатратДт", 				Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(12)));
	Таблица.Колонки.Добавить("ПодразделениеДт",				Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Таблица.Колонки.Добавить("НаправлениеДеятельностиДт",	Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
