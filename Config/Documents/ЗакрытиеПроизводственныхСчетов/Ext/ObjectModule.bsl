			МассивСтрок     = СтрокаКЗ.Строки.НайтиСтроки(СтруктураПоиска, Истина);
			Для каждого ТекЭлемент из МассивСтрок Цикл
				ТекЭлемент[ИмяКолонки] = ТекАльфа;
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;
	ТаблицаДоп.Очистить();

КонецПроцедуры

Функция ВернутьСтруктуруАльф(СтрокаОбъектов, ТекНоменклатурнаяГруппа, ТекКлючЗатрат, НаправлениеДеятельности)
	Структура = Новый Структура("АльфаОПЗ, АльфаОХЗ", 0,0);
	СтруктураПоиска = Новый Структура("НоменклатурнаяГруппа, КлючЗатрат, НаправлениеДеятельности",
									  ТекНоменклатурнаяГруппа, 
									  ТекКлючЗатрат, 
									  НаправлениеДеятельности);
	СтрокиНоменклатурнойГруппы = СтрокаОбъектов.Строки.НайтиСтроки(СтруктураПоиска);
	Если СтрокиНоменклатурнойГруппы.Количество() = 0 Тогда
		Структура.АльфаОПЗ = 0;
		Структура.АльфаОХЗ = 0;
	Иначе
		Структура.АльфаОПЗ = СтрокиНоменклатурнойГруппы[0].АльфаОПЗ;
		Структура.АльфаОХЗ = СтрокиНоменклатурнойГруппы[0].АльфаОХЗ;
	КонецЕсли;	
	
	Возврат Структура;
КонецФункции	

Процедура СформироватьМатрицуСистемыУравнений(ПараметрыФормированияСистемыУравнений, ТаблицаОбъектов)

	СтрокаОбъектов				= ПараметрыФормированияСистемыУравнений.СтрокаОбъектов;
	ТаблицаДляРасчетаГамма		= ПараметрыФормированияСистемыУравнений.ТаблицаДляРасчетаГамма;
	СтрокаДляРасчетаТэтта		= ПараметрыФормированияСистемыУравнений.СтрокаДляРасчетаТэтта;
	СтрокаОбороты109ПР			= ПараметрыФормированияСистемыУравнений.СтрокаОбороты109ПР;
	СтрокаОбороты109Косвенные	= ПараметрыФормированияСистемыУравнений.СтрокаОбороты109Косвенные;
	СтрокаНачальныеОстатки		= ПараметрыФормированияСистемыУравнений.СтрокаНачальныеОстатки;
	СтрокаКонечныеОстатки		= ПараметрыФормированияСистемыУравнений.СтрокаКонечныеОстатки;
	ТаблицаВыпущеннойПродукции	= ПараметрыФормированияСистемыУравнений.ТаблицаВыпущеннойПродукции;
	МассивВлияющихНомГрупп		= ПараметрыФормированияСистемыУравнений.МассивВлияющихНомГрупп;
	
	Для Каждого СтрокаДетальная из СтрокаОбъектов.Строки Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаОбъектов.Добавить(), СтрокаДетальная);
	КонецЦикла;	
	
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число");
	МаксИндекс = ТаблицаОбъектов.Количество() - 1;
	Для п = 0 по МаксИндекс Цикл
		ИмяКолонки = "k" + Формат(п, "ЧН=; ЧГ=");
		ТаблицаОбъектов.Колонки.Добавить(ИмяКолонки, ОписаниеТиповЧисло);
	КонецЦикла;	
	ТаблицаОбъектов.Колонки.Добавить("q", ОписаниеТиповЧисло);
	
	ТекИндекс = -1;
	Для каждого СтрокаОбъекта из ТаблицаОбъектов Цикл
		ТекИндекс = ТекИндекс + 1;
		
		Для п = 0 по МаксИндекс Цикл
			Если п = ТекИндекс Тогда
				СтрокаОбъекта[НачальныйИндексДинамическихКолонок + п] = 1 + ВычислитьКоэффициент(ТекИндекс, п, ТаблицаДляРасчетаГамма, СтрокаДляРасчетаТэтта, ТаблицаОбъектов);		
 			Иначе
				Если МассивВлияющихНомГрупп.Найти(ТаблицаОбъектов[п].НоменклатурнаяГруппа) = Неопределено Тогда
					СтрокаОбъекта[НачальныйИндексДинамическихКолонок + п] = 0;
				Иначе	
					СтрокаОбъекта[НачальныйИндексДинамическихКолонок + п] = ВычислитьКоэффициент(ТекИндекс, п, ТаблицаДляРасчетаГамма, СтрокаДляРасчетаТэтта, ТаблицаОбъектов);
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	
		СтрокаОбъекта["q"] = ВычислитьСвободныйЧлен(ТекИндекс,
													ТаблицаДляРасчетаГамма, 
													СтрокаДляРасчетаТэтта,
													СтрокаОбороты109ПР, 
													СтрокаОбороты109Косвенные,
													СтрокаНачальныеОстатки,
													СтрокаКонечныеОстатки,
													СтрокаОбъекта,
													ТаблицаВыпущеннойПродукции);
	КонецЦикла;	

КонецПроцедуры

Функция ОпределитьКоэффициентТэтта(СтрокаНоменклатуры, СтрокаДляРасчетаТэтта)
	
	Результат = 0;
	Отбор = Новый Структура("НаправлениеДеятельности, НоменклатурнаяГруппа, Счет105, КПС105, Номенклатура, Подразделение",
							СтрокаНоменклатуры.НаправлениеДеятельностиКт,
							СтрокаНоменклатуры.НоменклатураКт,
							СтрокаНоменклатуры.СчетДт,
							СтрокаНоменклатуры.КПСДт,
							СтрокаНоменклатуры.НоменклатураДт,
							СтрокаНоменклатуры.ПодразделениеКт);
	СтрокиТэтта = СтрокаДляРасчетаТэтта.Строки.НайтиСтроки(Отбор, Истина);							
	Если СтрокиТэтта.Количество() <> 0 Тогда
		Результат = СтрокиТэтта[0].Тэтта;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции	

Процедура РешитьСистемуЛинейныхУравнений(ТаблицаОбъектов)
	МаксИндекс = ТаблицаОбъектов.Количество() - 1;
	
	ТаблицаОбъектов.Колонки.Добавить("X", Новый ОписаниеТипов("Число"));
	// Прямой ход
	Для п = 0 по МаксИндекс Цикл
		УстановитьГлавныйЭлементПоКолонке(ТаблицаОбъектов, п, МаксИндекс);
		Делитель = ТаблицаОбъектов[п][НачальныйИндексДинамическихКолонок + п];
		Для р = (п + 1) по МаксИндекс Цикл
			Если ТаблицаОбъектов[р][НачальныйИндексДинамическихКолонок + п] = 0 Тогда
				Продолжить;
			КонецЕсли;	
			
			Множитель = (- ТаблицаОбъектов[р][НачальныйИндексДинамическихКолонок + п]) / Делитель;
			Для т = п по МаксИндекс Цикл
				ТаблицаОбъектов[р][НачальныйИндексДинамическихКолонок + т] = ТаблицаОбъектов[р][НачальныйИндексДинамическихКолонок + т] 
																			+  ТаблицаОбъектов[п][НачальныйИндексДинамическихКолонок + т] * Множитель;
			КонецЦикла;	
			ТаблицаОбъектов[р]["q"] = ТаблицаОбъектов[р]["q"] +  ТаблицаОбъектов[п]["q"] * Множитель;
		КонецЦикла;	
	КонецЦикла;	
	
	// Обратный ход
	п = МаксИндекс;
	Пока п >= 0 Цикл
		Результат = ТаблицаОбъектов[п]["q"];
		Для р = (п +1) по МаксИндекс Цикл
			Если ТаблицаОбъектов[п][НачальныйИндексДинамическихКолонок + р] <> 0 Тогда
				Результат = Результат - ТаблицаОбъектов[п][НачальныйИндексДинамическихКолонок + р] * ТаблицаОбъектов[р]["X"];
			КонецЕсли;
		КонецЦикла;	
		ТаблицаОбъектов[п]["X"] = ?(ТаблицаОбъектов[п][НачальныйИндексДинамическихКолонок + п] = 0, 0,Результат / ТаблицаОбъектов[п][НачальныйИндексДинамическихКолонок + п]);
		п = п - 1;
	КонецЦикла;	
	
	Для п = 0 по МаксИндекс Цикл
		ТаблицаОбъектов[п]["X"] = Окр(ТаблицаОбъектов[п]["X"], 2);
	КонецЦикла;	
КонецПроцедуры	

Процедура УстановитьГлавныйЭлементПоКолонке(ТаблицаОбъектов, п, МаксИндекс)
	ТекЗначение = МодульЗначения(ТаблицаОбъектов[п][НачальныйИндексДинамическихКолонок + п]);
	Для р = (п + 1) по МаксИндекс Цикл
		Если МодульЗначения(ТаблицаОбъектов[р][НачальныйИндексДинамическихКолонок + п]) > ТекЗначение Тогда 
			//ТаблицаОбъектов.Сдвинуть(р, (р - п));
			ТаблицаОбъектов.Сдвинуть(р, (п - р));
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры	

Функция СтрокаДереваПоКФОиИФО(ТекДерево, ТекИФО, ТекКФО)
	СтрокаКФО = Неопределено;
	СтрокаИФО = ТекДерево.Строки.Найти(ТекИФО, "ИФО", Ложь);
	Если СтрокаИФО <> Неопределено Тогда
		СтрокаКФО = СтрокаИФО.Строки.Найти(ТекКФО, "КФО", Ложь);
	КонецЕсли;	
	
	Возврат СтрокаКФО;
КонецФункции	

Процедура ЗаполнитьТаблицуДО105(СтрокаОбороты105)
	
	ТаблицаДО105.Очистить();

	СтрокаПоступления105 = СтрокаОбороты105.Строки.Найти("Поступление", "Направление");
	Если СтрокаПоступления105 <> Неопределено Тогда
		Для каждого СтрокаОткудаКуда Из СтрокаПоступления105.Строки Цикл
		
			Для каждого СтрокаПодразделение Из СтрокаОткудаКуда.Строки Цикл
			
				Для каждого СтрокаДетальная Из СтрокаПодразделение.Строки Цикл
					
					Если СтрокаДетальная.КоличествоОборотДт <> 0 Тогда
						ЗаполнитьЗначенияСвойств(ТаблицаДО105.Добавить(), СтрокаДетальная);	
					КонецЕсли;
				
				КонецЦикла; 
			
			КонецЦикла; 
		
		КонецЦикла; 
	КонецЕсли;
	
	ТаблицаДО105.Свернуть("ОткудаКуда, Номенклатура, Счет, КПС", "КоличествоОборотДт");

КонецПроцедуры // ЗаполнитьТаблицуДО105()

Функция ВернутьСтруктуруКоличеств(СтрокаОбороты105_КФО, СтрокаНачальныеОстатки_КФО, ТекНоменклатура, ТекСчет, ТекКФО, ТекНоменклатурнаяГруппа, ТекКлючЗатрат, ТекНаправлениеДеятельности, ТекПодразделение)
	
	СтруктураПоиска		= Новый Структура("Номенклатура, Счет, КПС", ТекНоменклатура, ТекСчет, ТекКФО);
	СтруктураПоискаДО	= Новый Структура("Номенклатура, Счет, КПС", ТекНоменклатура, ТекСчет, ТекКФО);
	К_исх 		= 0;
	К_гп_пз 	= 0;
	К_гп_опз 	= 0;
	К_гп_охз	= 0;
	
	// Учтем в К_исх начальные остатки на счете 105
	Если СтрокаНачальныеОстатки_КФО <> Неопределено Тогда
		СтрокаСчета105 = СтрокаНачальныеОстатки_КФО.Строки.Найти("105", "НаименованиеСчета");
		Если СтрокаСчета105 <> Неопределено Тогда
			МассивСтрокНО = СтрокаСчета105.Строки.НайтиСтроки(СтруктураПоиска, Ложь);
			Для каждого ТекСтрокаНО из МассивСтрокНО Цикл
				К_исх = К_исх + ТекСтрокаНО.Количество;
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;	
	
	// Учтем в К_исх количество поступившей номенклатуры на счет 105
	СтрокаПоступления105 = СтрокаОбороты105_КФО.Строки.Найти("Поступление", "Направление");
	Если СтрокаПоступления105 <> Неопределено Тогда
		Для каждого СтрокаОткудаКуда из СтрокаПоступления105.Строки Цикл
			СтруктураПоискаДО.Вставить("ОткудаКуда", СтрокаОткудаКуда);
			МассивСтрокПост = ТаблицаДО105.НайтиСтроки(СтруктураПоискаДО);
			Если МассивСтрокПост.Количество() > 0 Тогда
				К_исх = К_исх + МассивСтрокПост[0].КоличествоОборотДт;
			КонецЕсли;
			//МассивСтрокПост = СтрокаОткудаКуда.Строки.НайтиСтроки(СтруктураПоиска, Истина);
			//Для каждого ТекСтрокаПост из МассивСтрокПост Цикл
			//	К_исх = К_исх + ТекСтрокаПост.КоличествоОборотДт;
			//КонецЦикла;	
		КонецЦикла;	
	КонецЕсли;	
	// Теперь в ключе "К_исх" находится общее количество номенклатуры Нач. остаток + Количество поступивших
	
	СтруктураПоискаПЗ = Новый Структура("ОткудаКуда, Номенклатура, Счет, КПС, КорСубконто1, КлючЗатрат", 
										"ПЗ", 
										ТекНоменклатура, 
										ТекСчет, 
										ТекКФО, 
										ТекНоменклатурнаяГруппа, 
										ТекКлючЗатрат);
	Если ЕстьНД10960 Тогда
		СтруктураПоискаПЗ.Вставить("КорСубконто3", ТекНаправлениеДеятельности);
	КонецЕсли;
	
	СтруктураПоискаОПЗ = Новый Структура("ОткудаКуда, Номенклатура, Счет, КПС, КлючЗатрат", 
										"ОПЗ", 
										ТекНоменклатура, 
										ТекСчет, 
										ТекКФО, 
										ТекКлючЗатрат);
	Если ЕстьНД10970 Тогда
		СтруктураПоискаОПЗ.Вставить("КорСубконто2", ТекНаправлениеДеятельности);
	КонецЕсли;
	
	СтруктураПоискаОХЗ = Новый Структура("ОткудаКуда, Номенклатура, Счет, КПС, КлючЗатрат", 
										"ОХЗ", 
										ТекНоменклатура, 
										ТекСчет, 
										ТекКФО, 
										ТекКлючЗатрат);
	Если ЕстьНД10980 Тогда
		СтруктураПоискаОХЗ.Вставить("КорСубконто3", ТекНаправлениеДеятельности);
	КонецЕсли;
	
	СтрокаСписания105 = СтрокаОбороты105_КФО.Строки.Найти("Списание", "Направление");
	Для каждого СтрокаОткудаКуда из СтрокаСписания105.Строки Цикл
		
		СтрокаПодразделение = СтрокаОткудаКуда.Строки.Найти(ТекПодразделение, "КорПодразделение");
		Если СтрокаПодразделение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрокСписПЗ = СтрокаПодразделение.Строки.НайтиСтроки(СтруктураПоискаПЗ, Ложь);
		Для каждого ТекСтрокаСписПЗ из МассивСтрокСписПЗ Цикл
			К_гп_пз = К_гп_пз + ТекСтрокаСписПЗ.КоличествоОборотКт;
		КонецЦикла;	
		
		МассивСтрокСписОПЗ = СтрокаПодразделение.Строки.НайтиСтроки(СтруктураПоискаОПЗ, Ложь);
		Для каждого ТекСтрокаСписОПЗ из МассивСтрокСписОПЗ Цикл
			К_гп_опз = К_гп_опз + ТекСтрокаСписОПЗ.КоличествоОборотКт;
		КонецЦикла;	
		
		МассивСтрокСписОХЗ = СтрокаПодразделение.Строки.НайтиСтроки(СтруктураПоискаОХЗ, Ложь);
		Для каждого ТекСтрокаСписОХЗ из МассивСтрокСписОХЗ Цикл
			К_гп_охз = К_гп_охз + ТекСтрокаСписОХЗ.КоличествоОборотКт;
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат Новый Структура("К_гп_пз, К_гп_опз, К_гп_охз, К_исх", К_гп_пз, К_гп_опз, К_гп_охз, К_исх);

КонецФункции

Функция ВычислитьКоэффициент(ТекИндекс, п, ТаблицаДляРасчетаГамма, СтрокаДляРасчетаТэтта, ТаблицаОбъектов)
	
	Результат = 0;
	Если СтрокаДляРасчетаТэтта = Неопределено Тогда
		Возврат 0;
	КонецЕсли;	
	
	ТекПодразделение	= ТаблицаОбъектов[п].Подразделение;
	СтрокаПодразделение = СтрокаДляРасчетаТэтта.Строки.Найти(ТекПодразделение, "Подразделение", Ложь);
	Если СтрокаПодразделение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;	
	
	ТекНаправлениеДеятельности	= ТаблицаОбъектов[п].НаправлениеДеятельности;
	СтрокаНапрДеят  			= СтрокаПодразделение.Строки.Найти(ТекНаправлениеДеятельности, "НаправлениеДеятельности", Ложь);
	Если СтрокаНапрДеят = Неопределено Тогда
		Возврат 0;
	КонецЕсли;	
	
	ИмяКолонки = "k" + Формат(ТекИндекс, "ЧГ=");
	ТекНоменклатурнаяГруппа		= ТаблицаОбъектов[п].НоменклатурнаяГруппа;
	СтрокаНомГруппы = СтрокаНапрДеят.Строки.Найти(ТекНоменклатурнаяГруппа, "НоменклатурнаяГруппа", Ложь);
	Если СтрокаНомГруппы <> Неопределено Тогда
		Для каждого СтрокаГамма из ТаблицаДляРасчетаГамма Цикл
			ТекНоменклатура = СтрокаГамма.Номенклатура;
			ТекСчет         = СтрокаГамма.Счет;
			ТекКПС          = СтрокаГамма.КПС;
			ТекГамма        = СтрокаГамма[ИмяКолонки];
			
			СтрокаСчета = СтрокаНомГруппы.Строки.Найти(ТекСчет, "Счет105", Ложь);
			Если СтрокаСчета <> Неопределено Тогда
				СтрокаКПС = СтрокаСчета.Строки.Найти(ТекКПС, "КПС105", Ложь);
				Если СтрокаКПС <> Неопределено Тогда
					СтрокаНоменклатуры = СтрокаКПС.Строки.Найти(ТекНоменклатура, "Номенклатура", Ложь);
					Если СтрокаНоменклатуры <> Неопределено Тогда 
						Результат = Результат + ТекГамма * СтрокаНоменклатуры.Тэтта;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	
	Возврат (- Результат);
КонецФункции	

Функция ВычислитьСвободныйЧлен( ТекИндекс,
								ТаблицаДляРасчетаГамма, 
								СтрокаДляРасчетаТэтта, 
								СтрокаОбороты109ПР, 
								СтрокаОбороты109Косвенные, 
								СтрокаНачальныеОстатки, 
								СтрокаКонечныеОстатки, 
								СтрокаОбъекта, 
								ТаблицаВыпущеннойПродукции)

	ТекНоменклатурнаяГруппа		= СтрокаОбъекта.НоменклатурнаяГруппа;
	ТекКлючЗатрат				= СтрокаОбъекта.КлючЗатрат;
	ТекНаправлениеДеятельности	= СтрокаОбъекта.НаправлениеДеятельности;
	ТекПодразделение			= СтрокаОбъекта.Подразделение;
	ТекАльфаОПЗ					= СтрокаОбъекта.АльфаОПЗ;
	ТекАльфаОХЗ					= СтрокаОбъекта.АльфаОХЗ;
	
	Опз = 0;
	Если СтрокаОбороты109ПР <> Неопределено Тогда
		СтрокаПоступления = СтрокаОбороты109ПР.Строки.Найти("Поступление", "Направление", Ложь);
		Если СтрокаПоступления <> Неопределено Тогда
			Опз = Опз + ПосчитатьПрямыеЗатраты(СтрокаПоступления, "Прочее", ТекНоменклатурнаяГруппа, ТекКлючЗатрат, ТекНаправлениеДеятельности, ТекПодразделение);
			Опз = Опз + ПосчитатьПрямыеЗатраты(СтрокаПоступления, "105", 	ТекНоменклатурнаяГруппа, ТекКлючЗатрат, ТекНаправлениеДеятельности, ТекПодразделение, ТаблицаВыпущеннойПродукции);
		КонецЕсли;	
	КонецЕсли;	
	
	Оопз = РасчитатьКосвенныеНекорректируемыеОбороты(СтрокаОбороты109Косвенные, "ОПЗ", ТекКлючЗатрат, ТекНаправлениеДеятельности, ТекПодразделение, ТаблицаВыпущеннойПродукции);
	Оохз = РасчитатьКосвенныеНекорректируемыеОбороты(СтрокаОбороты109Косвенные, "ОХЗ", ТекКлючЗатрат, ТекНаправлениеДеятельности, ТекПодразделение, ТаблицаВыпущеннойПродукции);
	
	СтрокаНачОстатков105   = Неопределено;
	СтрокаНачОстатков109 = Неопределено;
	НОонп = 0;
	Если СтрокаНачальныеОстатки <> Неопределено Тогда
		СтрокаНачОстатков105	= СтрокаНачальныеОстатки.Строки.Найти("105", "НаименованиеСчета");
		СтрокаНачОстатков109	= СтрокаНачальныеОстатки.Строки.Найти("109", "НаименованиеСчета");
		
		Если СтрокаНачОстатков109 <> Неопределено Тогда
			СтруктураПоискаОстатков109 = Новый Структура("Номенклатура, КлючЗатрат, НаправлениеДеятельности", ТекНоменклатурнаяГруппа, ТекКлючЗатрат, ТекНаправлениеДеятельности);
			МассивСтрокНачОстатков109  = СтрокаНачОстатков109.Строки.НайтиСтроки(СтруктураПоискаОстатков109, Истина);
			Для каждого СтрокаНачОст109 из МассивСтрокНачОстатков109 Цикл
				НОонп = НОонп + СтрокаНачОст109.Сумма;
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;	
	
	ИмяКолонки = "k" + Формат(ТекИндекс, "ЧГ=");
	НОогп = 0;
	КОонп = 0;
	Для каждого СтрокаГамма из ТаблицаДляРасчетаГамма Цикл
		ТекНоменклатура = СтрокаГамма.Номенклатура;
		ТекСчет         = СтрокаГамма.Счет;
		ТекКПС          = СтрокаГамма.КПС;
		
		НО = 0;
		Если СтрокаНачОстатков105 <> Неопределено Тогда
			СтруктураПоискаОстатков105 = Новый Структура("Номенклатура, Счет, КПС", ТекНоменклатура, ТекСчет, ТекКПС);
			МассивСтрокНачОстатков105 = СтрокаНачОстатков105.Строки.НайтиСтроки(СтруктураПоискаОстатков105, Истина);
			Для каждого ТекЭлементНО из МассивСтрокНачОстатков105 Цикл
				НО = НО + ТекЭлементНО.Сумма;
			КонецЦикла;;	
		КонецЕсли;	
		НОогп = НОогп + СтрокаГамма[ИмяКолонки] * НО;
		
		КО = 0;
		Если СтрокаКонечныеОстатки <> Неопределено Тогда
			СтрокаПодразделение = СтрокаКонечныеОстатки.Строки.Найти(ТекПодразделение, "Подразделение", Ложь);
			Если СтрокаПодразделение <> Неопределено Тогда 
				
			СтрокаПодразделения_Тэтта = СтрокаДляРасчетаТэтта.Строки.Найти(ТекПодразделение, "Подразделение", Ложь);
			Если СтрокаПодразделения_Тэтта <> Неопределено Тогда
				
			СтрокаНапрДеят = СтрокаПодразделение.Строки.Найти(ТекНаправлениеДеятельности, "НаправлениеДеятельности", Ложь);
			Если СтрокаНапрДеят <> Неопределено Тогда
				
				СтрокаНаправленияД_Тэтта = СтрокаПодразделения_Тэтта.Строки.Найти(ТекНаправлениеДеятельности, "НаправлениеДеятельности", Ложь);
				Если СтрокаНаправленияД_Тэтта <> Неопределено Тогда
					Для каждого СтрокаНомГруппы из СтрокаНапрДеят.Строки Цикл
						СтрокаНомГруппа_Тэтта = СтрокаНаправленияД_Тэтта.Строки.Найти(СтрокаНомГруппы.НоменклатурнаяГруппа, "НоменклатурнаяГруппа", Ложь);
						
						Если СтрокаНомГруппа_Тэтта <> Неопределено Тогда
							Отбор = Новый Структура("Счет105, КПС105, Номенклатура", ТекСчет, ТекКПС, ТекНоменклатура);
							МассивСтрокТэтта = СтрокаНомГруппа_Тэтта.Строки.НайтиСтроки(Отбор, Истина);
							Если МассивСтрокТэтта.Количество() > 0 Тогда
								КО = КО + СтрокаНомГруппы.Сумма * МассивСтрокТэтта[0].Тэтта;
							КонецЕсли;	
						КонецЕсли;
						//
						//
						//Если СтрокаНомГруппа_Тэтта <> Неопределено Тогда
						//	СтрокаСчета_Тэтта = СтрокаНомГруппа_Тэтта.Строки.Найти(ТекСчет, "Счет105", Ложь);
						//	Если СтрокаСчета_Тэтта <> Неопределено Тогда
						//		СтрокаКПС_Тэтта = СтрокаСчета_Тэтта.Строки.Найти(ТекКПС, "КПС105", Ложь);
						//		Если СтрокаКПС_Тэтта <> Неопределено Тогда
						//			СтруктураПоиска1 = Новый Структура("Номенклатура", ТекНоменклатура);
						//			МассивСтрокТэтта = СтрокаКПС_Тэтта.Строки.НайтиСтроки(СтруктураПоиска1, Ложь);
						//			Если МассивСтрокТэтта.Количество() > 0 Тогда
						//				КО = КО + СтрокаНомГруппы.Сумма * МассивСтрокТэтта[0].Тэтта;
						//			КонецЕсли;	
						//		КонецЕсли;	
						//	КонецЕсли;	
						//КонецЕсли;	
						
					КонецЦикла;	
				КонецЕсли;	
			КонецЕсли;			
			КонецЕсли;			
			КонецЕсли;	
		КонецЕсли;	
		КОонп = КОонп + СтрокаГамма[ИмяКолонки] * КО;
	КонецЦикла;	
				
	Результат = Опз + НОонп + ТекАльфаОПЗ * Оопз + ТекАльфаОХЗ * Оохз + НОогп - КОонп;
	
	Возврат Результат;
	
КонецФункции	

Функция ПосчитатьПрямыеЗатраты(ИсходнаяСтрока, ТипЗатрат, ТекНоменклатурнаяГруппа, ТекКлючЗатрат, ТекНаправлениеДеятельности, ТекПодразделение, ТаблицаВыпущеннойПродукции = Неопределено)
	Результат = 0;
	Отбор = Новый Структура("ОткудаКуда, НоменклатурнаяГруппа, КлючЗатрат, Подразделение, НаправлениеДеятельности",
							ТипЗатрат,
							ТекНоменклатурнаяГруппа,
							ТекКлючЗатрат,
							ТекПодразделение,
							ТекНаправлениеДеятельности);
	ДетальныеСтроки = ИсходнаяСтрока.Строки.НайтиСтроки(Отбор, Истина);
	Для каждого СтрокаДетальная из ДетальныеСтроки Цикл
		Если СтрокаДетальная.Строки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗатрат = "105" Тогда
			Если ТаблицаВыпущеннойПродукции.Найти(СтрокаДетальная.КорСубконто1, "Номенклатура") <> Неопределено Тогда
				Продолжить;
			КонецЕсли;	
			Результат = Результат + СтрокаДетальная.СуммаОборотДт;
		Иначе	
			Результат = Результат + СтрокаДетальная.СуммаОборотДт;
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции	

Функция РасчитатьКосвенныеНекорректируемыеОбороты(СтрокаОбороты109Косвенные, ВидКЗ, ТекКлючЗатрат, ТекНаправлениеДеятельности, ТекПодразделение, ТаблицаВыпущеннойПродукции)
