Процедура РасчитатьФактическиеОбороты(ТаблицаОбъектов, СтрокаКонечныеОстатки)

	Если СтрокаКонечныеОстатки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура("КлючЗатрат, НаправлениеДеятельности, НоменклатурнаяГруппа");
	Для каждого СтрокаОбъекта из ТаблицаОбъектов Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаОбъекта);
		МассивСтрок = СтрокаКонечныеОстатки.Строки.НайтиСтроки(СтруктураПоиска, Истина);
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		СтрокаОбъекта.X = СтрокаОбъекта.X - МассивСтрок[0].Сумма;
	КонецЦикла;	
	
КонецПроцедуры

Процедура СформироватьКорректирующиеДвижения105_109ПР(ТаблицаОбъектов, СтрокаОбороты109ПР, СтрокаДляРасчетаТэтта, ДеревоПроводок)
	
	СтрокаСписания105_109ПР = СтрокаОбороты109ПР.Строки.Найти("Списание", "Направление", Ложь);
	Если СтрокаСписания105_109ПР = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	СтрокаОткудаКуда105 = СтрокаСписания105_109ПР.Строки.Найти("105", "ОткудаКуда", Ложь);
	Если СтрокаОткудаКуда105 = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ТаблицаПроводок = СформироватьСтруктуруТаблицыПроводок105_109ПР();
	
	ТекИФО = СтрокаОбороты109ПР.ИФО;
	ТекКФО = СтрокаОбороты109ПР.КФО;
	
	Для каждого СтрокаНоменклатурнойГруппы из СтрокаОткудаКуда105.Строки Цикл
		Для каждого СтрокаВидЗатрат из СтрокаНоменклатурнойГруппы.Строки Цикл
			Для каждого СтрокаПодразделения из СтрокаВидЗатрат.Строки Цикл
				Для каждого СтрокаНаправлениеДеятельности из СтрокаПодразделения.Строки Цикл
					Для каждого СтрокаДетальная из СтрокаНаправлениеДеятельности.Строки Цикл
						
						СторнироватьСтароеДвижение105_109ПР(СтрокаДетальная, ТекКФО, ТекИФО);
						
						НоваяСтрока = ТаблицаПроводок.Добавить();
						НоваяСтрока.СчетДт						= СтрокаДетальная.КорСчет;
						НоваяСтрока.КПСДт						= СтрокаДетальная.КорКПС;
						НоваяСтрока.КЭКДт						= СтрокаДетальная.КорКЭК;
						НоваяСтрока.НоменклатураДт				= СтрокаДетальная.КорСубконто1;
						НоваяСтрока.ПодразделениеДт				= СтрокаДетальная.КорПодразделение;
						НоваяСтрока.СчетКт						= СтрокаДетальная.Счет;
						НоваяСтрока.КПСКт						= СтрокаДетальная.КПС;
						НоваяСтрока.КЭККт						= СтрокаДетальная.КЭК;
						НоваяСтрока.НоменклатураКт				= СтрокаДетальная.НоменклатурнаяГруппа;
						НоваяСтрока.НаправлениеДеятельностиКт	= СтрокаДетальная.НаправлениеДеятельности;
						НоваяСтрока.ПодразделениеКт				= СтрокаДетальная.Подразделение;
						НоваяСтрока.Количество					= СтрокаДетальная.КоличествоКорОборотКт;
						
					КонецЦикла;	
				КонецЦикла;	
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;	
	
	ДеревоПроводок = СформироватьДеревоПроводок105_109ПР(ТаблицаПроводок);

	Для каждого СтрокаНоменклатурнаяГруппа из ДеревоПроводок.Строки Цикл
		Для Каждого СтрокаПодразделение Из СтрокаНоменклатурнаяГруппа.Строки Цикл
			Для каждого СтрокаНаправлениеДеятельности из СтрокаПодразделение.Строки Цикл
				СтруктураПоиска = Новый Структура("НоменклатурнаяГруппа, НаправлениеДеятельности",
												  СтрокаНаправлениеДеятельности.НоменклатураКт, 
												  СтрокаНаправлениеДеятельности.НаправлениеДеятельностиКт);
				МассивСтрокРешений = ТаблицаОбъектов.НайтиСтроки(СтруктураПоиска);
				Если МассивСтрокРешений.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;	
				
				Для каждого СтрокаВидаЗатрат из МассивСтрокРешений Цикл
					СуммаОборотов105_109ПР	= СтрокаВидаЗатрат.X;
					СуммаСписанная			= 0;
					
					МаксИндексСчета = СтрокаНаправлениеДеятельности.Строки.Количество() - 1;
					ТекИндексСчета	= -1;
					Для каждого СтрокаСчета из СтрокаНаправлениеДеятельности.Строки Цикл
						ТекИндексСчета = ТекИндексСчета + 1;
						МаксИндексКПС 	= СтрокаСчета.Строки.Количество() - 1;
						ТекИндексКПС	= -1;
						Для каждого СтрокаКПС из СтрокаСчета.Строки Цикл
							ТекИндексКПС = ТекИндексКПС + 1;
						
							МаксИндексНоменклатуры 	= СтрокаКПС.Строки.Количество() - 1;
							ТекИндексНоменклатуры	= -1;
							Для каждого СтрокаНоменклатуры из СтрокаКПС.Строки Цикл
								ТекИндексНоменклатуры = ТекИндексНоменклатуры + 1;
								Если (ТекИндексНоменклатуры = МаксИндексНоменклатуры)
									И (ТекИндексКПС = МаксИндексКПС)
									И (ТекИндексСчета = МаксИндексСчета) Тогда
									
									СуммаОборотовПоНоменклатуре = СуммаОборотов105_109ПР - СуммаСписанная;
								Иначе	
									Тэтта = ОпределитьКоэффициентТэтта(СтрокаНоменклатуры, СтрокаДляРасчетаТэтта);
									СуммаОборотовПоНоменклатуре = Окр(СуммаОборотов105_109ПР * Тэтта, 2);
									СуммаСписанная = СуммаСписанная + СуммаОборотовПоНоменклатуре;
								КонецЕсли;	
								
								СформироватьОборотПоВидуЗатрат(СтрокаНоменклатуры, СтрокаВидаЗатрат.ВидЗатрат, СтрокаВидаЗатрат.КЭК, СуммаОборотовПоНоменклатуре, ТекКФО, ТекИФО);
							КонецЦикла;	
						
						КонецЦикла;	
					КонецЦикла;	
				КонецЦикла;	
				
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;	
	
КонецПроцедуры

Процедура СформироватьОборотПоВидуЗатрат(СтрокаНоменклатуры, ТекВидЗатрат, КЭКЗатрат, СуммаОборотовПоНоменклатуре, ТекКФО, ТекИФО)
	
	ВсегоКоличество = СтрокаНоменклатуры.Строки.Итог("Количество");
	Если ВсегоКоличество = 0 Тогда
		Возврат;
	КонецЕсли;	

	МаксИндекс	= СтрокаНоменклатуры.Строки.Количество() - 1;
	ТекИндекс	= -1;
	ВсегоРаспределили = 0;
	Для каждого СтрокаДетальная из СтрокаНоменклатуры.Строки Цикл
		ТекИндекс = ТекИндекс + 1;
		Если ТекИндекс = МаксИндекс ТОгда
			СуммаОборота = СуммаОборотовПоНоменклатуре - ВсегоРаспределили;
		Иначе	
			СуммаОборота = СтрокаДетальная.Количество * СуммаОборотовПоНоменклатуре / ВсегоКоличество;
			ВсегоРаспределили = ВсегоРаспределили + СуммаОборота;
		КонецЕсли;	

		СтрокаДетальная.Сумма = СтрокаДетальная.Сумма + СуммаОборота;
		
		Если СуммаОборота = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		Проводка = ТаблицаДвиженияДокумента.Добавить();
		Проводка.ИФО 				= ТекИФО;
		Проводка.КФО 				= ТекКФО;
		Проводка.СчетДт 			= СтрокаДетальная.СчетДт;
		Проводка.КПСДт 				= СтрокаДетальная.КПСДт;
		Проводка.КЭКДт 				= СтрокаДетальная.КЭКДт;
		Проводка.СубконтоДт1 		= СтрокаДетальная.НоменклатураДт;
		Проводка.ПодразделениеДт	= СтрокаДетальная.ПодразделениеДт;
		Проводка.СчетКт 			= СтрокаДетальная.СчетКт;
		Проводка.КПСКт 				= СтрокаДетальная.КПСКт;
		Проводка.КЭККт 				= КЭКЗатрат;
		Проводка.СубконтоКт1 		= СтрокаДетальная.НоменклатураКт;
		Проводка.СубконтоКт2 		= ТекВидЗатрат;
		Если ЕстьНД10960 Тогда
			Проводка.СубконтоКт3 = СтрокаДетальная.НаправлениеДеятельностиКт;
		КонецЕсли;
		Проводка.ПодразделениеКт	= СтрокаДетальная.ПодразделениеКт;
		Проводка.Сумма 				= СуммаОборота;
		Проводка.Содержание 		= НСтр("ru = 'Оборот по фактической стоимости'");
		Проводка.ЖурналОпераций 	= БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СторнироватьСтароеДвижение105_109ПР(ТекСтрока, ТекКФО, ТекИФО)
	
	Проводка            = ТаблицаДвиженияДокумента.Добавить();
	Проводка.КФО        = ТекКФО;
	Проводка.ИФО     	= ТекИФО;
	
	// Параметры дебета проводки
	Проводка.СчетДт         	= ТекСтрока.КорСчет;
	Проводка.КПСДт          	= ТекСтрока.КорКПС;
	Проводка.КЭКДт	        	= ТекСтрока.КорКЭК;
	Проводка.СубконтоДт1		= ТекСтрока.КорСубконто1;
	Проводка.ПодразделениеДт	= ТекСтрока.КорПодразделение;
	
	// Параметры кредита проводки
	Проводка.СчетКт				= ТекСтрока.Счет;
	Проводка.КПСКт				= ТекСтрока.КПС;
	Проводка.КЭККт				= ТекСтрока.КЭК;
	Проводка.СубконтоКт1		= ТекСтрока.НоменклатурнаяГруппа;
	Проводка.СубконтоКт2		= ТекСтрока.ВидЗатрат;
	Если ЕстьНД10960 Тогда
		Проводка.СубконтоКт3 = ТекСтрока.НаправлениеДеятельности;
	КонецЕсли;
	Проводка.ПодразделениеКт	= ТекСтрока.Подразделение;
	
