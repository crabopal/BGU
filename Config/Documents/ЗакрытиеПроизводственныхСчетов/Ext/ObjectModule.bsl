#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// Переменные модуля

// признак, что у счета есть субконто "Направления деятельности"
Перем ЕстьНД10960;
Перем ЕстьНД10970;
Перем ЕстьНД10980;

Перем Счет10960;
Перем Счет10970;
Перем Счет10980;

// признак, что по счету ведется учет по подразделениям
Перем ЕстьПодразделение10960;
Перем ЕстьПодразделение10970;
Перем ЕстьПодразделение10980;

Перем ТаблицаДопРасчетаАльфа; // дополнительная таблица для расчета коэффициентов альфа
Перем ТаблицаДО105; // дополнительная таблица для расчета количества прихода на счет 105
Перем ТаблицаДвиженияДокумента; // временная таблица для заполнения табличной части
Перем ПараметрыРаспределенияЗатрат; // структура общих параметров
Перем НачальныйИндексДинамическихКолонок; // начальный индекс динамических колонок в таблице объектов

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура ЗаполнитьДокумент(СтарыйАлгоритм = Ложь) Экспорт
	
	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	Если ДвиженияДокумента.Количество() > 0 Тогда
		ДвиженияДокумента.Очистить();
	КонецЕсли;
	
	ТаблицаДвиженияДокумента = ДвиженияДокумента.ВыгрузитьКолонки();
	
	ПлательщикНалогаНаПрибыль = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Организация, Дата);
	
	// Бухгалтерский учет
	Если ЭтотОбъект.ОтражатьВБухгалтерскомУчете
	 ИЛИ НЕ ПлательщикНалогаНаПрибыль Тогда
		
		Если НЕ СтарыйАлгоритм Тогда
			
			Документы.ЗакрытиеПроизводственныхСчетов.СформироватьПроводкиЗакрытиеПроизводственныхСчетов(
				ЭтотОбъект, ТаблицаДвиженияДокумента, "БУ");
		
		Иначе
			
			ПараметрыУчетаЗатрат = Документы.РаспределениеОбщихЗатрат.ПараметрыУчетаЗатрат(Дата, Организация, ИФО, КФО);
			Счет10960 = ПараметрыУчетаЗатрат.СчетСебестоимость;
			Счет10970 = ПараметрыУчетаЗатрат.СчетНакладныеРасходы;
			Счет10980 = ПараметрыУчетаЗатрат.СчетОбщехозяйственныеРасходы;
			ЕстьНД10960 = ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиСебестоимость;
			ЕстьНД10970 = ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы;
			ЕстьНД10980 = ПараметрыУчетаЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы;
			ЕстьПодразделение10960 = ПараметрыУчетаЗатрат.ЕстьПодразделениеСебестоимость;
			ЕстьПодразделение10970 = ПараметрыУчетаЗатрат.ЕстьПодразделениеНакладныеРасходы;
			ЕстьПодразделение10980 = ПараметрыУчетаЗатрат.ЕстьПодразделениеОбщехозяйственныеРасходы;
			
			СформироватьПроводкиЗакрытиеПроизводственныхСчетовБУ(ТаблицаДвиженияДокумента, ПараметрыУчетаЗатрат);
		
		КонецЕсли;
		
	КонецЕсли;
	
	// Налоговый учет
	Если ЭтотОбъект.ОтражатьВНалоговомУчете
	   И ( ЗначениеЗаполнено(КФО) И НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, Дата, КФО)
			ИЛИ ПлательщикНалогаНаПрибыль ) Тогда
		
		Документы.ЗакрытиеПроизводственныхСчетов.СформироватьПроводкиЗакрытиеПроизводственныхСчетов(
			ЭтотОбъект, ТаблицаДвиженияДокумента, "НУ");
		
	КонецЕсли;
	
	ДвиженияДокумента.Загрузить(ТаблицаДвиженияДокумента);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ 

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ЗАКРЫТИЕ ПРОИЗВОДСТВЕННЫХ СЧЕТОВ - УСТАРЕВШИЕ ФУНКЦИИ, ОСТАВЛЕННЫЕ ДЛЯ СОВМЕСТИМОСТИ
//

Процедура СформироватьПроводкиЗакрытиеПроизводственныхСчетовБУ(ТаблицаДвиженияДокумента, ПараметрыРаспределенияЗатрат)

	ИнициализироватьТаблицуДопРасчетаАльфа();
	
	ЕстьНД10960 = ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость;
	ЕстьНД10970 = ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы;
	ЕстьНД10980 = ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы;
	
	ЕстьПодразделение10960 = ПараметрыРаспределенияЗатрат.ЕстьПодразделениеСебестоимость;
	ЕстьПодразделение10970 = ПараметрыРаспределенияЗатрат.ЕстьПодразделениеНакладныеРасходы;
	ЕстьПодразделение10980 = ПараметрыРаспределенияЗатрат.ЕстьПодразделениеОбщехозяйственныеРасходы;
	
	РаспределитьКосвенныеЗатраты(ТаблицаДвиженияДокумента, ПараметрыРаспределенияЗатрат);
	
	МассивДанных = СобратьДанныеДляУравнений(ПараметрыРаспределенияЗатрат, ТаблицаДвиженияДокумента);
	
	ДеревоОбороты109ПР        	= МассивДанных[12].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоОбороты109Косвенные 	= МассивДанных[13].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоОбороты105            = МассивДанных[14].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоНачальныеОстатки      = МассивДанных[15].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоКонечныеОстатки       = МассивДанных[16].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДеревоОбъектовРасчета       = МассивДанных[17].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоДляРасчетаТэтта       = МассивДанных[18].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоДляРасчетаТау         = МассивДанных[19].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоДляРасчетаТауДоп      = МассивДанных[20].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТаблицаВыпущеннойПродукции  = МассивДанных[21].Выгрузить(ОбходРезультатаЗапроса.Прямой);
	
	МассивВлияющихНомГрупп      = МассивДанных[22].Выгрузить(ОбходРезультатаЗапроса.Прямой)
													.ВыгрузитьКолонку("НоменклатурнаяГруппа");
	
	ИнициализироватьТаблицуДО105(ДеревоОбороты105);
	ДеревоДляРасчетаТэтта.Колонки.Добавить("Тэтта",	Новый ОписаниеТипов("Число"));
	ДеревоДляРасчетаТэтта.Колонки.Добавить("Тау",	Новый ОписаниеТипов("Число"));
	
	ДеревоДляРасчетаТау.Колонки.Добавить("Тау", Новый ОписаниеТипов("Число"));
	
	ДеревоОбъектовРасчета.Колонки.Добавить("АльфаОПЗ", Новый ОписаниеТипов("Число"));
	ДеревоОбъектовРасчета.Колонки.Добавить("АльфаОХЗ", Новый ОписаниеТипов("Число"));
	
	ДеревоОбороты109Косвенные.Колонки.Добавить("АльфаОПЗ", Новый ОписаниеТипов("Число"));
	ДеревоОбороты109Косвенные.Колонки.Добавить("АльфаОХЗ", Новый ОписаниеТипов("Число"));
	
	Для каждого СтрокаОбъектовИФО из ДеревоОбъектовРасчета.Строки Цикл
		ТекИФО = СтрокаОбъектовИФО.ИФО;
		Для каждого СтрокаОбъектов из СтрокаОбъектовИФО.Строки Цикл
			ТекКФО = СтрокаОбъектов.КФО;
			
			СтрокаОбороты109ПР = СтрокаДереваПоКФОиИФО(ДеревоОбороты109ПР, ТекИФО, ТекКФО);
			Если СтрокаОбороты109ПР = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаОбороты109Косвенные	= СтрокаДереваПоКФОиИФО(ДеревоОбороты109Косвенные,	ТекИФО, ТекКФО);
			СтрокаОбороты105            = СтрокаДереваПоКФОиИФО(ДеревоОбороты105, 			ТекИФО, ТекКФО);
			СтрокаНачальныеОстатки      = СтрокаДереваПоКФОиИФО(ДеревоНачальныеОстатки, 	ТекИФО, ТекКФО);
			СтрокаКонечныеОстатки       = СтрокаДереваПоКФОиИФО(ДеревоКонечныеОстатки, 		ТекИФО, ТекКФО);
			СтрокаДляРасчетаТэтта       = СтрокаДереваПоКФОиИФО(ДеревоДляРасчетаТэтта, 		ТекИФО, ТекКФО);
			СтрокаДляРасчетаТау         = СтрокаДереваПоКФОиИФО(ДеревоДляРасчетаТау, 		ТекИФО, ТекКФО);
			
			РассчитатьКоэффициентыТэтта(СтрокаДляРасчетаТау, СтрокаДляРасчетаТэтта, ДеревоДляРасчетаТауДоп);
			РассчитатьКоэффициентыАльфа(СтрокаОбъектов, СтрокаОбороты109Косвенные);
			
			СтрокаСвертки = "";
			ТаблицаДляРасчетаГамма = НоваяТаблицаДляРасчетаГамма(СтрокаОбъектов, СтрокаСвертки);
			РассчитатьКоэффициентыГамма(СтрокаОбороты105,
										СтрокаНачальныеОстатки,
										СтрокаОбъектов,
										ТаблицаДляРасчетаГамма,
										СтрокаСвертки);
			
			ТаблицаОбъектов = НоваяТаблицаОбъектов();
			ПараметрыФормированияСистемыУравнений = Новый Структура;
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаОбъектов",			СтрокаОбъектов);
			ПараметрыФормированияСистемыУравнений.Вставить("ТаблицаДляРасчетаГамма",	ТаблицаДляРасчетаГамма);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаДляРасчетаТэтта",		СтрокаДляРасчетаТэтта);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаОбороты109ПР",		СтрокаОбороты109ПР);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаОбороты109Косвенные",	СтрокаОбороты109Косвенные);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаНачальныеОстатки",	СтрокаНачальныеОстатки);
			ПараметрыФормированияСистемыУравнений.Вставить("СтрокаКонечныеОстатки",		СтрокаКонечныеОстатки);
			ПараметрыФормированияСистемыУравнений.Вставить("ТаблицаВыпущеннойПродукции",ТаблицаВыпущеннойПродукции);
			ПараметрыФормированияСистемыУравнений.Вставить("МассивВлияющихНомГрупп",	МассивВлияющихНомГрупп);
			СформироватьМатрицуСистемыУравнений(ПараметрыФормированияСистемыУравнений, ТаблицаОбъектов);
			
			РешитьСистемуЛинейныхУравнений(ТаблицаОбъектов);
			РасчитатьФактическиеОбороты(ТаблицаОбъектов, СтрокаКонечныеОстатки);
			
			ДеревоПроводок = Неопределено;
			СформироватьКорректирующиеДвижения105_109ПР(ТаблицаОбъектов,
														СтрокаОбороты109ПР,
														СтрокаДляРасчетаТэтта, 
														ДеревоПроводок);
			Если ДеревоПроводок = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТаблицаКорректировокКЗ = НоваяТаблицаКорректировокКЗ();
			ТаблицаОборотовДт105 = ПеревестиДеревоПроводокВТаблицу(ДеревоПроводок);
			СформироватьКорректирующиеДвиженияХХХ_105(ТаблицаОборотовДт105,
													  СтрокаОбороты105, 
													  СтрокаНачальныеОстатки, 
													  ТаблицаКорректировокКЗ);
			
			ДеревоКорректировокКЗ = ПеревестиТаблицуКорректировокКЗвДерево(ТаблицаКорректировокКЗ);
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("ДеревоКорректировокКЗ",		ДеревоКорректировокКЗ);
			СтруктураПараметров.Вставить("СтрокаОбороты109Косвенные",	СтрокаОбороты109Косвенные);
			СтруктураПараметров.Вставить("КФО",							ТекКФО);
			СтруктураПараметров.Вставить("ИФО",							ТекИФО);
			СформироватьКорректирующиеДвиженияСписанияС_109КЗ(СтруктураПараметров);
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура РаспределитьКосвенныеЗатраты(ТаблицаДвиженияДокумента, ПараметрыРаспределенияЗатрат)
	
	ТаблицаРаспределенияЗатрат = Документы.РаспределениеОбщихЗатрат.РаспределитьОбщиеЗатраты(ПараметрыРаспределенияЗатрат);
	
	Для каждого СтрокаЗатрат Из ТаблицаРаспределенияЗатрат Цикл
	
		НоваяСтрока = ТаблицаДвиженияДокумента.Добавить();
		НоваяСтрока.ИФО				= СтрокаЗатрат.ИФО;
		НоваяСтрока.КФО				= СтрокаЗатрат.КФО;
		НоваяСтрока.СчетДт			= СтрокаЗатрат.СчетПЗ;
		НоваяСтрока.КПСДт			= СтрокаЗатрат.КПССчетПЗ;
		НоваяСтрока.КЭКДт			= СтрокаЗатрат.КЭКСчетОЗ;
		НоваяСтрока.СубконтоДт1		= СтрокаЗатрат.Номенклатура;
		НоваяСтрока.СубконтоДт2		= СтрокаЗатрат.ВидЗатратОЗ;
		НоваяСтрока.СубконтоДт3		= СтрокаЗатрат.НаправлениеДеятельностиПЗ;
		НоваяСтрока.ПодразделениеДт	= СтрокаЗатрат.ПодразделениеПЗ;
		НоваяСтрока.СчетКт			= СтрокаЗатрат.СчетОЗ;
		НоваяСтрока.КПСКт			= СтрокаЗатрат.КПССчетОЗ;
		НоваяСтрока.КЭККт			= СтрокаЗатрат.КЭКСчетОЗ;
		НоваяСтрока.СубконтоКт1		= СтрокаЗатрат.ВидЗатратОЗ;
		НоваяСтрока.СубконтоКт2		= СтрокаЗатрат.НаправлениеДеятельностиОЗ;
		//НоваяСтрока.СубконтоКт3		= СтрокаЗатрат.;
		НоваяСтрока.ПодразделениеКт	= СтрокаЗатрат.ПодразделениеОЗ;
		НоваяСтрока.Сумма			= СтрокаЗатрат.Сумма;
		НоваяСтрока.ЖурналОпераций	= БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
		НоваяСтрока.Содержание 		= НСтр("ru = 'Списание косвенных затрат на производство'");
	
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьТаблицуДО105(ДеревоОбороты105)
	ТаблицаДО105 = Новый ТаблицаЗначений;
	Для каждого ТекКолонка Из ДеревоОбороты105.Колонки Цикл
	
		ТаблицаДО105.Колонки.Добавить(ТекКолонка.Имя, ТекКолонка.ТипЗначения);	
	
	КонецЦикла; 
КонецПроцедуры

Функция НоваяТаблицаДляРасчетаГамма(СтрокаОбъектовКФО, СтрокаСвертки)
	
    СтрокаСвертки = "";
	ТаблицаДляРасчетаГамма = Новый ТаблицаЗначений;
	ТаблицаДляРасчетаГамма.Колонки.Добавить("КорПодразделение",	Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаДляРасчетаГамма.Колонки.Добавить("Номенклатура",		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаДляРасчетаГамма.Колонки.Добавить("Счет", 			Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДляРасчетаГамма.Колонки.Добавить("КПС", 				Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	МаксИндекс 		= СтрокаОбъектовКФО.Строки.Количество() - 1;
	ТекущийИндекс	= -1;
	Для каждого СтрокаДетальная из СтрокаОбъектовКФО.Строки Цикл
		ТекущийИндекс = ТекущийИндекс + 1;
		ИмяКолонки = "k" + Формат(ТекущийИндекс, "ЧГ=");
		ТаблицаДляРасчетаГамма.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Число"));
		СтрокаСвертки = СтрокаСвертки + ИмяКолонки + ?(ТекущийИндекс = МаксИндекс, "", ",");
	КонецЦикла;
	Возврат ТаблицаДляРасчетаГамма;

КонецФункции // ТаблицаДляРасчетаГамма()

