	Запрос.УстановитьПараметр("НачалоПериода", 				НачалоМесяца(Дата));
	Запрос.УстановитьПараметр("КонецПериода", 				КонецМесяца(Дата));
	Запрос.УстановитьПараметр("Организация", 				Организация);
	Запрос.УстановитьПараметр("ТекущийДокумент",			Ссылка);
	Запрос.УстановитьПараметр("ТипЦеныПродукции", 			Константы.ТипЦеныПлановойСебестоимостиПродукции.Получить()); 
	Запрос.УстановитьПараметр("Счет10960", 					ПараметрыРаспределенияЗатрат.СчетСебестоимость);
	Запрос.УстановитьПараметр("Счет10970", 					ПараметрыРаспределенияЗатрат.СчетНакладныеРасходы);
	Запрос.УстановитьПараметр("Счет10980", 					ПараметрыРаспределенияЗатрат.СчетОбщехозяйственныеРасходы);
	Запрос.УстановитьПараметр("ЕстьНД10960", 				ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость);
	Запрос.УстановитьПараметр("Счет105",	 				БухгалтерскийУчет.СписокСчетов("105.00"));
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Если ЗначениеЗаполнено(ИФО) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
			Запрос.УстановитьПараметр("ИФО", ИФО);
		Иначе 
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
		КонецЕсли;
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЖурналПроводок.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	Если ЗначениеЗаполнено(КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", КФО);
	Иначе 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА");
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		ПолеПодразделениеДт = "ВЫБОР
		|		КОГДА ВсеОборотыПервая.СчетДт.УчетПоПодразделениям
		|			ТОГДА ЕСТЬNULL(ВсеОборотыПервая.ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ";	
		ПолеПодразделениеКт = "ВЫБОР
		|		КОГДА ВсеОборотыПервая.СчетКт.УчетПоПодразделениям
		|			ТОГДА ЕСТЬNULL(ВсеОборотыПервая.ПодразделениеКт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ";
		ПолеПодразделениеОстатки = "ВЫБОР
		|		КОГДА ТаблицаСчетов.УчетПоПодразделениям
		|			ТОГДА ЕСТЬNULL(ВсеОстаткиПервая.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ";
		ПолеПодразделениеНЗП = "ЕСТЬNULL(НезавершенноеПроизводствоОстатки.Ссылка.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))";
	Иначе
		ПолеПодразделениеДт 		= "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)";
		ПолеПодразделениеКт 		= "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)";
		ПолеПодразделениеОстатки	= "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)";
		ПолеПодразделениеНЗП		= "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВсеОборотыПервая.ПодразделениеДт", 						ПолеПодразделениеДт);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВсеОборотыПервая.ПодразделениеКт", 						ПолеПодразделениеКт);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВсеОстаткиПервая.Подразделение", 							ПолеПодразделениеОстатки);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "НезавершенноеПроизводствоОстатки.Ссылка.Подразделение",	ПолеПодразделениеНЗП);
	
	Возврат Запрос.ВыполнитьПакет();
	
КонецФункции	

// Тэтта - Коэффициент распределения стоимости производства в рамках подразделения, направления деятельности,
// внутри номенклатурной группы, на субсчете 105 на единицу продукции.
//
Процедура РассчитатьКоэффициентыТэтта(СтрокаДляРасчетаТау, СтрокаДляРасчетаТэтта, ДеревоДляРасчетаТауДоп)
	Если СтрокаДляРасчетаТау = Неопределено Тогда
		Возврат;
	КонецЕсли;	

	РассчитатьКоэффициентыТау(СтрокаДляРасчетаТау, ДеревоДляРасчетаТауДоп);
	
	Для каждого СтрокаПодразделения Из СтрокаДляРасчетаТэтта.Строки Цикл
		Для каждого СтрокаНаправленияДеятельности Из СтрокаПодразделения.Строки Цикл
			Для каждого СтрокаНоменклатурнойГруппы Из СтрокаНаправленияДеятельности.Строки Цикл
				ОбщийЗнаменатель = 0;
				
				Для каждого СтрокаСчета Из СтрокаНоменклатурнойГруппы.Строки Цикл
					Для каждого СтрокаКПС Из СтрокаСчета.Строки Цикл
						Для каждого СтрокаНоменклатуры из СтрокаКПС.Строки Цикл
							СтруктураПоиска = Новый Структура("НоменклатурнаяГруппа, Номенклатура", 
															  СтрокаНоменклатурнойГруппы.НоменклатурнаяГруппа, 
															  СтрокаНоменклатуры.Номенклатура);
							МассивСтрок = СтрокаДляРасчетаТау.Строки.НайтиСтроки(СтруктураПоиска, Истина);						
							СтрокаНоменклатуры.Тау = МассивСтрок[0].Тау;
							ОбщийЗнаменатель = ОбщийЗнаменатель + СтрокаНоменклатуры.Количество * МассивСтрок[0].Тау;
						КонецЦикла;	
					КонецЦикла;	
				КонецЦикла;	
				
				СуммарныйИндекс = 0;
				МаксИндексНГ 	= СтрокаНоменклатурнойГруппы.Строки.Количество() - 1;
				ТекущийИндексНГ = -1;
				Для каждого СтрокаСчета из СтрокаНоменклатурнойГруппы.Строки Цикл
					
					ТекущийИндексНГ 	= ТекущийИндексНГ + 1;
					МаксИндексСчета 	= СтрокаСчета.Строки.Количество() - 1;
					ТекущийИндексСчета	= -1;
					Для каждого СтрокаКПС из СтрокаСчета.Строки Цикл
						
						ТекущийИндексСчета 	= ТекущийИндексСчета + 1;
						МаксИндексКПС 		= СтрокаКПС.Строки.Количество() - 1;
						ТекущийИндексКПС	= -1;
						Для каждого СтрокаНоменклатуры из СтрокаКПС.Строки Цикл
							
							ТекущийИндексКПС = ТекущийИндексКПС + 1;
							Если (ТекущийИндексНГ = МаксИндексНГ)
								И (ТекущийИндексСчета = МаксИндексСчета)
								И (ТекущийИндексКПС = МаксИндексКПС) Тогда
								
								СтрокаНоменклатуры.Тэтта = 1 - СуммарныйИндекс;
							Иначе
								СтрокаНоменклатуры.Тэтта = СтрокаНоменклатуры.Тау * СтрокаНоменклатуры.Количество / ОбщийЗнаменатель;
								СуммарныйИндекс = СуммарныйИндекс + СтрокаНоменклатуры.Тэтта;
							КонецЕсли;
							
						КонецЦикла;	
						
					КонецЦикла;	
					
				КонецЦикла;	
				
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;	
	
КонецПроцедуры

// Тау - Коэффициент распределения стоимости производства внутри номенклатурной группы на единицу продукции.
//
Процедура РассчитатьКоэффициентыТау(СтрокаДляРасчетаТау, ДеревоДляРасчетаТауДоп)
	
	ТипНоменклатурнаяГруппа 		= Перечисления.ТипыНоменклатуры.НоменклатурнаяГруппа;
	ПоПлановойСтоимостиПродукции	= Перечисления.МетодыРаспределенияСтоимостиПроизводства.ПоПлановойСтоимостиПродукции;
	
	Для каждого СтрокаНоменклатурнойГруппы Из СтрокаДляРасчетаТау.Строки Цикл
		МаксИндексПродукции 	= СтрокаНоменклатурнойГруппы.Строки.Количество() - 1;
		ТекущийИндексПродукции	= -1;
		СуммарнаяТау = 0;
		Если СтрокаНоменклатурнойГруппы.ТипНоменклатуры = ТипНоменклатурнаяГруппа Тогда
			СтруктураПоиска = Новый Структура("МетодРаспределения, НоменклатурнаяГруппа", 
											  СтрокаНоменклатурнойГруппы.МетодРаспределенияСтоимостиПроизводства, 
											  СтрокаНоменклатурнойГруппы.НоменклатурнаяГруппа);
			МассивСтрок = ДеревоДляРасчетаТауДоп.Строки.НайтиСтроки(СтруктураПоиска, Истина);						
			
			Если МассивСтрок.Количество() <> 0 Тогда
				Если СтрокаНоменклатурнойГруппы.МетодРаспределенияСтоимостиПроизводства = ПоПлановойСтоимостиПродукции Тогда
					ИмяПоказателя       = "ПлановаяСтоимость";
					СуммарныйПоказатель = МассивСтрок[0].ПлановаяСтоимость;
				Иначе
					ИмяПоказателя		= "Коэффициент";
					СуммарныйПоказатель = МассивСтрок[0].Коэффициент;
				КонецЕсли;	
			Иначе	
				СтруктураПоиска = Новый Структура("МетодРаспределения, НоменклатурнаяГруппа", 
												  Перечисления.МетодыРаспределенияСтоимостиПроизводства.ПустаяСсылка(), 
												  СтрокаНоменклатурнойГруппы.НоменклатурнаяГруппа);
				МассивСтрок = ДеревоДляРасчетаТауДоп.Строки.НайтиСтроки(СтруктураПоиска, Истина);						
				ИмяПоказателя       = "ПлановаяСтоимость";
				СуммарныйПоказатель = МассивСтрок[0].ПлановаяСтоимость;
			КонецЕсли;
			Для Каждого СтрокаНоменклатуры из СтрокаНоменклатурнойГруппы.Строки Цикл	
				ТекущийИндексПродукции = ТекущийИндексПродукции + 1;
				Если СуммарныйПоказатель <> 0 Тогда
					СтрокаНоменклатурыДоп  = МассивСтрок[0].Строки.Найти(СтрокаНоменклатуры.Номенклатура, "Номенклатура", Ложь);
					ТекТау = СтрокаНоменклатурыДоп[ИмяПоказателя] / СуммарныйПоказатель;
					
					Если ТекущийИндексПродукции = МаксИндексПродукции Тогда
						СтрокаНоменклатуры.Тау = 1 - СуммарнаяТау;
					Иначе	
						СтрокаНоменклатуры.Тау = ТекТау;
						СуммарнаяТау = СуммарнаяТау + СтрокаНоменклатуры.Тау;
					КонецЕсли;	
				Иначе
					ТекТау = 1 / (МаксИндексПродукции + 1);
					Если ТекущийИндексПродукции = МаксИндексПродукции Тогда
						СтрокаНоменклатуры.Тау = 1 - СуммарнаяТау;
					Иначе	
						СтрокаНоменклатуры.Тау = ТекТау;
						СуммарнаяТау = СуммарнаяТау + СтрокаНоменклатуры.Тау;
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;
		Иначе
			Для Каждого СтрокаНоменклатуры Из СтрокаНоменклатурнойГруппы.Строки Цикл
				СтрокаНоменклатуры.Тау = 1;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Альфа - коэффициент распределения косвенных затрат
//
Процедура РассчитатьКоэффициентыАльфа(СтрокаОбъектов, СтрокаОбороты109Косвенные)

	Если СтрокаОбороты109Косвенные = Неопределено Тогда
		ЗанулитьАльфаКолонки(СтрокаОбъектов, Истина, Истина);
		Возврат;
	КонецЕсли;	
	
	СтрокаСписания = СтрокаОбороты109Косвенные.Строки.Найти("Списание", "Направление", Ложь);
	
	Если СтрокаСписания = Неопределено Тогда
		ЗанулитьАльфаКолонки(СтрокаОбъектов, Истина, Истина);
	Иначе	
		ЗаполнитьАльфаКолонки(СтрокаОбъектов, СтрокаСписания, "АльфаОПЗ");
		ЗаполнитьАльфаКолонки(СтрокаОбъектов, СтрокаСписания, "АльфаОХЗ");
	КонецЕсли;	
	
КонецПроцедуры

// Гамма - доля по количеству продукции, списанной на себестоимость
//
Процедура РассчитатьКоэффициентыГамма(СтрокаОбороты105, СтрокаНачальныеОстатки, СтрокаОбъектов, ТаблицаДляРасчетаГамма, СтрокаСвертки)
	
	Если СтрокаОбороты105 = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	СтрокаСписания105 = СтрокаОбороты105.Строки.Найти("Списание", "Направление");
	Если СтрокаСписания105 = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаОткудаКуда из СтрокаСписания105.Строки Цикл
		Для Каждого СтрокаПодразделение из СтрокаОткудаКуда.Строки Цикл
			Для Каждого СтрокаДетальная из СтрокаПодразделение.Строки Цикл
				ЗаполнитьЗначенияСвойств(ТаблицаДляРасчетаГамма.Добавить(), СтрокаДетальная, "КорПодразделение, Номенклатура, Счет, КПС");
			КонецЦикла;	
		КонецЦикла;
	КонецЦикла;	
	
	ЗаполнитьТаблицуДО105(СтрокаОбороты105);
	
	ТаблицаДляРасчетаГамма.Свернуть("КорПодразделение, Номенклатура, Счет, КПС", СтрокаСвертки);
	Для каждого ТекСтрока из ТаблицаДляРасчетаГамма Цикл
		ТекНоменклатура 	= ТекСтрока.Номенклатура;
		ТекСчет         	= ТекСтрока.Счет;
		ТекКПС          	= ТекСтрока.КПС;
		ТекИндексОбъекта	= -1;
		
		Для каждого СтрокаОбъекта из СтрокаОбъектов.Строки Цикл
			ТекНоменклатурнаяГруппа    = СтрокаОбъекта.НоменклатурнаяГруппа;
			ТекКлючЗатрат              = СтрокаОбъекта.КлючЗатрат;
			ТекНаправлениеДеятельности = СтрокаОбъекта.НаправлениеДеятельности;
			ТекПодразделение		   = СтрокаОбъекта.Подразделение;
			ТекИндексОбъекта           = ТекИндексОбъекта + 1;
			
			СтруктураКоличеств = ВернутьСтруктуруКоличеств(СтрокаОбороты105,
														   СтрокаНачальныеОстатки, 
														   ТекНоменклатура, 
														   ТекСчет, 
														   ТекКПС, 
														   ТекНоменклатурнаяГруппа, 
														   ТекКлючЗатрат, 
														   ТекНаправлениеДеятельности,
														   ТекПодразделение);
			
			Если СтруктураКоличеств.К_исх = 0 Тогда
				ТекСтрока["k" + Формат(ТекИндексОбъекта, "ЧГ=")] = 0;	
			Иначе
				СтруктураАльф = ВернутьСтруктуруАльф(СтрокаОбъектов, ТекНоменклатурнаяГруппа, ТекКлючЗатрат, ТекНаправлениеДеятельности);
				ТекСтрока["k" + Формат(ТекИндексОбъекта, "ЧГ=")] = (СтруктураКоличеств.К_гп_пз 
																	+ СтруктураКоличеств.К_гп_опз * СтруктураАльф.АльфаОПЗ 
																	+ СтруктураКоличеств.К_гп_охз * СтруктураАльф.АльфаОХЗ) / СтруктураКоличеств.К_исх;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ЗанулитьАльфаКолонки(ТекСтрока, АльфаОПЗ = Ложь, АльфаОХЗ = Ложь)
	Для каждого СтрокаДетальная из ТекСтрока.Строки Цикл
		Если АльфаОПЗ Тогда
			СтрокаДетальная.АльфаОПЗ = 0;
		КонецЕсли;	
		Если АльфаОХЗ Тогда
			СтрокаДетальная.АльфаОХЗ = 0;
		КонецЕсли;	
	КонецЦикла;;	
КонецПроцедуры	

