#Область ОбработчикиСобытийЭлементовТаблицыФормыОстаткиКЭКПроизводства

&НаКлиенте
Процедура ОстаткиКЭКПроизводстваНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура("ДополнительныйОтбор, ТекущаяСтрока",
									  Новый Структура("Счет, ДК",
													   Объект.СчетПроизводства,
													   "КТ"),
									  Элементы.Остатки.ТекущиеДанные.КЭКПроизводства);
													   
	ОткрытьФорму("Справочник.КОСГУ.ФормаВыбора", ПараметрыФормы, Элемент);	
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьОстатки(Команда)
	
	Если Не МожноАвтоматическиЗаполнитьОстатки() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Остатки.Количество() > 0 Тогда
		
		ТекстВопроса = НСтр("ru = 'Таблица документа будет заполнена по остаткам.
			|Продолжить?'");
		ОбработкаОповещения = Новый ОписаниеОповещения("ПродолжитьЗаполнениеТаблицыОстатки", ЭтотОбъект);
		
		ПоказатьВопрос(ОбработкаОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОстаткиНаСервере();
	
КонецПроцедуры

