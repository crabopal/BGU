#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьДанныеФормы()

	ЗаполнитьРеквизитыФормы();
	УстановитьВидимостьНаправленияДеятельности(ЭтотОбъект);
	УстановитьОбязательностьПодразделения(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыФормы()

	ПризнакиУчета = Документы.НезавершенноеПроизводство.ПризнакиУчетаСчетаПроизводства(Объект.СчетПроизводства);
	
	ЕстьНаправлениеДеятельности = ПризнакиУчета.ЕстьНаправлениеДеятельности;
	УчетПоПодразделениям        = ПризнакиУчета.УчетПоПодразделениям;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьНаправленияДеятельности(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НаправлениеДеятельности",
		"Видимость", Форма.ЕстьНаправлениеДеятельности);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОбязательностьПодразделения(Форма)

	ЗаполнятьОбязательно = Форма.УчетПоПодразделениям;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Подразделение",
		"АвтоотметкаНезаполненного", ЗаполнятьОбязательно);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Подразделение",
		"ОтметкаНезаполненного", ЗаполнятьОбязательно И Не ЗначениеЗаполнено(Форма.Объект.Подразделение));

КонецПроцедуры

&НаКлиенте
Функция МожноАвтоматическиЗаполнитьОстатки()

	ВсеПоляЗаполнены = Истина;
	
	ПроверитьЗаполнениеПоля("СчетПроизводства", НСтр("ru = 'Счет производства'"), ВсеПоляЗаполнены);
	ПроверитьЗаполнениеПоля("КФО", НСтр("ru = 'КФО'"), ВсеПоляЗаполнены);
	
	Если ЭтотОбъект.ЕстьНаправлениеДеятельности Тогда
		ПроверитьЗаполнениеПоля("НаправлениеДеятельности", НСтр("ru = 'Направление деятельности'"), ВсеПоляЗаполнены);
	КонецЕсли;
	
	Если ЭтотОбъект.УчетПоПодразделениям Тогда
		ПроверитьЗаполнениеПоля("Подразделение", НСтр("ru = 'Подразделение'"), ВсеПоляЗаполнены);
	КонецЕсли;
	
	Возврат ВсеПоляЗаполнены;

КонецФункции

&НаКлиенте
Процедура ПроверитьЗаполнениеПоля(Поле, ПредставлениеПоля, ПолеЗаполнено)

	Если Не ЗначениеЗаполнено(Объект[Поле]) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,ПредставлениеПоля),,,"Объект." + Поле);
		ПолеЗаполнено = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗаполнениеТаблицыОстатки(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьОстаткиНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура
	|ПОМЕСТИТЬ ВыпущеннаяПродукция
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &ОкончаниеПериода, Период, Счет В (&СчетаПроизводства), , &УсловиеВиртуальнойТаблицы, КорСчет В (&СчетаМЗ), ) КАК ЖурналПроводокЕПСБУОбороты
	|ГДЕ
	|	ЖурналПроводокЕПСБУОбороты.СуммаОборотКт > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
	|	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭКПроизводства
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ОкончаниеПериода,
	|			Счет В (&СчетаПроизводства),
	|			,
	|			&УсловиеВиртуальнойТаблицы
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						ВыпущеннаяПродукция.Номенклатура КАК Номенклатура
	|					ИЗ
	|						ВыпущеннаяПродукция КАК ВыпущеннаяПродукция)
	|				И Субконто2 <> ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка)
	|				И КЭК <> ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК ЖурналПроводокЕПСБУОстатки
	|ГДЕ
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт <> 0";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("ОкончаниеПериода", Новый Граница(КонецМесяца(Объект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетаПроизводства", БухгалтерскийУчет.СписокСчетов("109.60", Объект.Дата,,Объект.Организация));
	Запрос.УстановитьПараметр("СчетаМЗ", БухгалтерскийУчет.СписокСчетов("105.00", Объект.Дата,,Объект.Организация));
	
	МассивУсловий = Новый Массив;
	МассивУсловий.Добавить("Организация = &Организация");
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	МассивУсловий.Добавить("КФО = &КФО");
	Запрос.УстановитьПараметр("КФО", Объект.КФО);
	
	Если ЭтотОбъект.ЕстьНаправлениеДеятельности Тогда
		МассивУсловий.Добавить("Субконто3 = &НаправлениеДеятельности");
		Запрос.УстановитьПараметр("НаправлениеДеятельности", Объект.НаправлениеДеятельности);
	КонецЕсли;
	
	Если ЭтотОбъект.УчетПоПодразделениям Тогда
		МассивУсловий.Добавить("Подразделение = &Подразделение");
		Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	КонецЕсли;
	
	УсловиеВиртуальнойТаблицы = СтрСоединить(МассивУсловий, " И ");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВиртуальнойТаблицы", УсловиеВиртуальнойТаблицы);
	
	Объект.Остатки.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

