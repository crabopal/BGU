#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти
	
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если НФАПереданыЭлектроннымАктом Тогда
		ИтоговаяБалансоваяСтоимостьПоАкту = 0;
		ИтоговаяСуммаКапВложенийПоАкту = 0;
		Для Каждого ТекСтрока Из СведенияОПринятыхОбъектахНФА Цикл
			Если ЗначениеЗаполнено(ТекСтрока.КодСтроки) Тогда
				ТекСтрока.КодСтрокиЧислом = Число(ТекСтрока.КодСтроки);
			Иначе
				ТекСтрока.КодСтрокиЧислом = ТекСтрока.НомерСтроки;
			КонецЕсли;
			ИтоговаяБалансоваяСтоимостьПоАкту = ИтоговаяБалансоваяСтоимостьПоАкту + ТекСтрока.БалансоваяСтоимость;
			ИтоговаяСуммаКапВложенийПоАкту = ИтоговаяСуммаКапВложенийПоАкту + ТекСтрока.СуммаФактКапВложений;
		КонецЦикла;
		Если ИтоговаяСуммаКапВложенийПоАкту > 0 Тогда
			СуммаДокумента = ИтоговаяСуммаКапВложенийПоАкту;
		КонецЕсли;	
		Если ИтоговаяБалансоваяСтоимостьПоАкту > 0 Тогда
			СуммаДокумента = ИтоговаяБалансоваяСтоимостьПоАкту;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Перем Основание;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда	
		
		СтандартнаяОбработка = Ложь;
		ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда	

		СтандартнаяОбработка = Ложь;
		ЗаполнитьПоЭлектронномуАктуОПриемеПередачеОбъектовНФАВходящему(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ДанныеЗаполнения.Свойство("Основание", Основание);
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
			СтандартнаяОбработка = Ложь;
			ЗаполнитьПоЭлектронномуАктуОПриемеПередачеОбъектовНФАВходящему(ДанныеЗаполнения.Основание);
		КонецЕсли;
	
	КонецЕсли;	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения, СписокНоменклатуры = Неопределено)
	Организация = ДанныеЗаполнения.Организация;

	ДатаПодписания = Дата(1,1,1);
	Если ДанныеЗаполнения.ЗагруженИзЕИС Тогда
		ДатаПодписания = ЭлектронныеДокументыБГУ.ДатаПоследнейЭлектроннойПодписиЭД(ДанныеЗаполнения);
		Если ЗначениеЗаполнено(ДатаПодписания) Тогда
			Дата = ДатаПодписания;
		КонецЕсли;	
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаПодписания) Тогда
		Дата = ЭлектронныеДокументыБГУ.ДатаВходящегоИзвещенияЭДП(ДанныеЗаполнения);
	КонецЕсли;	

	Контрагент = ДанныеЗаполнения.Контрагент;
	Договор = ДанныеЗаполнения.Договор;
	ВалютаДокумента = ДанныеЗаполнения.ВалютаДокумента;
	ДокументОснование = ДанныеЗаполнения;
	
	ДокументыОтражения = ЭлектронныеДокументыБГУВызовСервера.ДокументыОтраженияДляЭДП(ДанныеЗаполнения);
	СуммаОтраженияВучете = ДокументыОтражения.Итог("Сумма");
	СуммаДокумента = ДанныеЗаполнения.СуммаДокумента - СуммаОтраженияВучете;
	
КонецПроцедуры

Процедура ЗаполнитьПоЭлектронномуАктуОПриемеПередачеОбъектовНФАВходящему(ДанныеЗаполнения, СписокНоменклатуры = Неопределено)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
		Если ДанныеЗаполнения.ТипЭлектронногоАкта = ЭлектронныеДокументыБГУ.ТипАктаОтветногоПринимающейСтороны() Тогда
			ОписаниеОшибки = НСтр("ru='Для ответного акта нельзя ввести документ данного типа.'");

			ВызватьИсключение ОписаниеОшибки;
		КонецЕсли;	
	КонецЕсли;
	
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	НФАПереданыЭлектроннымАктом = Истина;
	Организация = ДанныеЗаполнения.Организация;
	Контрагент = ДанныеЗаполнения.Контрагент;
	Договор = ДанныеЗаполнения.Договор;
	ВалютаДокумента = ВалютаРегУчета;
	ДокументОснование = ДанныеЗаполнения;
	СуммаДокумента = ДанныеЗаполнения.СуммаДокумента;
	
	ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
	НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;
	
	НоменклатураЗаполненаПоДаннымПолучателя = ЭлектронныеДокументыБГУ.ИспользоватьНоменклатуруПолучателяВОтветномАктеОПриемеПередачеНФА(Организация);

	СведенияОПринятыхОбъектахНФА.Очистить();
	
	//Заполняем по данным отправителя НФА
	СчСтрок = 0;
	Для Каждого ТекСтрока Из ДанныеЗаполнения.ПереданныеНФА Цикл
		СчСтрок = СчСтрок + 1;
		НоваяСтрока = СведенияОПринятыхОбъектахНФА.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.НФА = "";
		НоваяСтрока.КодСтроки = Формат(СчСтрок, "ЧЦ=3; ЧВН=");
		НоваяСтрока.КодСтрокиЧислом = СчСтрок;
		НоваяСтрока.НФАУОтправителя = ТекСтрока.НФА;
		НоваяСтрока.НаименованиеНФАУОтправителя = ТекСтрока.НаименованиеНФА;
		НоваяСтрока.КоличествоУОтправителя = ТекСтрока.Количество;
	КонецЦикла;	
КонецПроцедуры

#КонецОбласти 

#КонецЕсли