#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

Функция ДанныеДляПечати0510448_МЗ(МассивОбъектов) Экспорт

	ТекстыЗапросов = ТекстыЗапросовДляПечати0510448();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
		
	Запрос.Текст =
	ТекстыЗапросов.Шапка
	+ ОбщегоНазначения.РазделительПакетаЗапросов()
	+ ТекстыЗапросов.Материалы
	+ ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	Файлы.ВладелецФайла КАК Ссылка,
	|	Файлы.Ссылка КАК Файл,
	|	Файлы.Наименование КАК ИмяФайла,
	|	Файлы.Описание КАК Описание
	|ИЗ
	|	Справочник.Файлы КАК Файлы
	|ГДЕ
	|	Файлы.ВладелецФайла В(&МассивОбъектов)
	|	И НЕ Файлы.Служебный
	|	И НЕ Файлы.ПометкаУдаления"
	+ ОбщегоНазначения.РазделительПакетаЗапросов()
	+ ТекстыЗапросов.ФизическиеЛица
	+ ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ФизическиеЛица.Документ КАК Документ,
	|	ФизическиеЛица.Сотрудник КАК Сотрудник,
	|	ФизическиеЛица.Период КАК Период,
	|	ФизическиеЛица.ФизическоеЛицо КАК ФизическоеЛицо,
	|	МАКСИМУМ(ДанныеСотрудников.Период) КАК ДатаДолжности,
	|	МАКСИМУМ(ФИОФизическихЛиц.Период) КАК ДатаФИО
	|ПОМЕСТИТЬ ДатыПолученияДанных
	|ИЗ
	|	ФизическиеЛица КАК ФизическиеЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников КАК ДанныеСотрудников
	|		ПО ФизическиеЛица.Сотрудник = ДанныеСотрудников.Сотрудник
	|			И ФизическиеЛица.Период >= ДанныеСотрудников.Период
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО ФизическиеЛица.ФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|			И ФизическиеЛица.Период >= ФИОФизическихЛиц.Период
	|
	|СГРУППИРОВАТЬ ПО
	|	ФизическиеЛица.Документ,
	|	ФизическиеЛица.Сотрудник,
	|	ФизическиеЛица.Период,
	|	ФизическиеЛица.ФизическоеЛицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДатыПолученияДанных.Документ КАК Документ,
	|	ДатыПолученияДанных.Сотрудник КАК Сотрудник,
	|	ДанныеСотрудников.Должность КАК Должность,
	|	ФИОФизическихЛиц.Фамилия КАК Фамилия,
	|	ФИОФизическихЛиц.Имя КАК Имя,
	|	ФИОФизическихЛиц.Отчество КАК Отчество
	|ПОМЕСТИТЬ ПолныеДанныеСотрудников
	|ИЗ
	|	ДатыПолученияДанных КАК ДатыПолученияДанных
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников КАК ДанныеСотрудников
	|		ПО ДатыПолученияДанных.Сотрудник = ДанныеСотрудников.Сотрудник
	|			И ДатыПолученияДанных.ДатаДолжности = ДанныеСотрудников.Период
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО ДатыПолученияДанных.ФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|			И ДатыПолученияДанных.ДатаФИО = ФИОФизическихЛиц.Период"
	+ ОбщегоНазначения.РазделительПакетаЗапросов()
	+ ТекстыЗапросов.Председатели
	+ ОбщегоНазначения.РазделительПакетаЗапросов()
	+ ТекстыЗапросов.СоставКомиссии
	+ ОбщегоНазначения.РазделительПакетаЗапросов()
	+ ТекстыЗапросов.ДополнительныеРеквизиты
	+ ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПриложенныеФайлыДляЭДОБГУ.ВидСведений КАК ВидСведений,
	|	ПриложенныеФайлыДляЭДОБГУ.НаименованиеДокументаФайла КАК Описание,
	|	ПриложенныеФайлыДляЭДОБГУ.ПрисоединенныйФайл КАК Файл,
	|	ПриложенныеФайлыДляЭДОБГУ.ДокументЭД КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ПриложенныеФайлыДляЭДОБГУ.ПрисоединенныйФайл) КАК ИмяФайла,
	|	ПриложенныеФайлыДляЭДОБГУ.НаименованиеДокументаФайла КАК НаименованиеДокументаФайла
	|ИЗ
	|	РегистрСведений.ПриложенныеФайлыДляЭДОБГУ КАК ПриложенныеФайлыДляЭДОБГУ
	|ГДЕ
	|	ПриложенныеФайлыДляЭДОБГУ.ДокументЭД В(&МассивОбъектов)";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ДанныеДляПечати = Новый Структура;
	ДанныеДляПечати.Вставить("ВыборкаДокументов" , Результат[0].Выбрать());
	ДанныеДляПечати.Вставить("ВыборкаНФА" , Результат[1].Выбрать());
	ДанныеДляПечати.Вставить("ВыборкаФайлы" , Результат[2].Выбрать());
	ДанныеДляПечати.Вставить("СоставКомиссий" , Результат[7].Выгрузить());
	ДанныеДляПечати.Вставить("ДополнительныеРеквизиты", Результат[8].Выгрузить());
	ДанныеДляПечати.Вставить("ВыборкаФайлыАктаЭДО"	, Результат[9].Выбрать());
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Процедура ДобавитьДанныеДляПечати0510448(ДанныеДокументов, МассивОбъектов, ПоСебестоимости) Экспорт

	ДанныеДляПечати = ДанныеДляПечати0510448_МЗ(МассивОбъектов);
	
	ВыборкаДокументов  = ДанныеДляПечати.ВыборкаДокументов;
	ВыборкаНФА          = ДанныеДляПечати.ВыборкаНФА;
	ВыборкаФайлы       = ДанныеДляПечати.ВыборкаФайлы;
	ВыборкаФайлыАктаЭДО = ДанныеДляПечати.ВыборкаФайлыАктаЭДО;
	СоставКомиссий     = ДанныеДляПечати.СоставКомиссий;
	ВыборкаДрагМеталлы = Неопределено;
	ВыборкаХарактеристики = ДанныеДляПечати.ДополнительныеРеквизиты;
	ВыборкаХарактеристики.Индексы.Добавить("Ссылка");

	ОтборДрагметаллы = Новый Структура("Ссылка, Номенклатура");
	ОтборХарактеристики = Новый Структура("Ссылка");
	
	ДанныеДокументов = УправлениеПечатьюБГУ.ТаблицаШапкиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		АналитическиеГруппыДокумента = Новый Массив;
		
		СтрокаДокумента = ДанныеДокументов.Добавить();
		СтрокаДокумента.ИндивидуальныеХарактеристики = УправлениеПечатьюБГУ.ТаблицаИндивидуальныеХарактеристикиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.ПередаваемыеОбъекты = УправлениеПечатьюБГУ.ТаблицаСведенияОПередаваемыхОбъектахНФААктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.ПринятыеОбъектыНФА = УправлениеПечатьюБГУ.ТаблицаСведенияОПринятыхОбъектахНФААктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.ПринятыеОбъектыНФА.Колонки.Добавить("GUIDНоменклатурыУОтправителя", Новый ОписаниеТипов("Строка"));
		
		СтрокаДокумента.СведенияОбОграничениях = УправлениеПечатьюБГУ.ТаблицаСведенияОбОграниченияхАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.СоставКомиссии = УправлениеПечатьюБГУ.ТаблицаКомиссияДляПечатиПриказ61н();
		СтрокаДокумента.Файлы = УправлениеПечатьюБГУ.ТаблицаФайлыДляПечатиПриказ61н();
		СтрокаДокумента.ФайлыАктаЭДО = ЭлектронныеДокументыБГУ.ТаблицаФайлыДляПечатиПриказ61н();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ВыборкаДокументов);
		
		// Данные руководителя
		РуководительЕстьВЗапросе = Ложь;
		Если ВыборкаДокументов.Владелец().Колонки.Найти("Руководитель") <> Неопределено
			И ЗначениеЗаполнено(ВыборкаДокументов.Руководитель) Тогда
			РуководительЕстьВЗапросе = Истина;
		КонецЕсли;
		
		Если Не РуководительЕстьВЗапросе Тогда
			СтрокаДокумента.Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
				Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ВыборкаДокументов.Организация,
				ВыборкаДокументов.Дата).ОтветственноеЛицоСсылка;
		КонецЕсли;	
		
		// Шапка
		
		СтрокаДокумента.НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер);
		СтрокаДокумента.ДатаАкта = ВыборкаДокументов.Дата;
		
		// Раздел 4
		
		СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		
		ВыборкаНФА.Сбросить();
		
		Пока ВыборкаНФА.НайтиСледующий(СтруктураПоиска) Цикл
			СтрокаПередача = СтрокаДокумента.ПринятыеОбъектыНФА.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПередача, ВыборкаНФА);
			СтрокаПередача.СуммаВложений = ВыборкаНФА.СуммаФактКапВложений;
			СтрокаПередача.НормаАмортизации = ВыборкаНФА.СуммаНормыАмортизации;
			СтрокаПередача.МетодАмортизации = ВыборкаНФА.МетодНачисленияАмортизации;
			СтрокаПередача.ДатаОкончанияАмортизации = ВыборкаНФА.ДатаОкончанияНачисленияАмортизации;
		КонецЦикла;
		
		// Приложения

		Пока ВыборкаФайлыАктаЭДО.НайтиСледующий(СтруктураПоиска) Цикл
			ЗаполнитьЗначенияСвойств(СтрокаДокумента.ФайлыАктаЭДО.Добавить(), ВыборкаФайлыАктаЭДО);
		КонецЦикла;
		
		Пока ВыборкаФайлы.НайтиСледующий(СтруктураПоиска) Цикл
			ЗаполнитьЗначенияСвойств(СтрокаДокумента.Файлы.Добавить(), ВыборкаФайлы);
		КонецЦикла;
		
		// Комиссия
		
		Отбор = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		СтрокиКомиссииДокумента = СоставКомиссий.НайтиСтроки(Отбор);
		Для Каждого СтрокаКомиссии Из СтрокиКомиссииДокумента Цикл
			СтрокаКомиссииДокумента = СтрокаДокумента.СоставКомиссии.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаКомиссииДокумента, СтрокаКомиссии);
			ФИО = Новый Структура("Фамилия, Имя, Отчество",
					СтрокаКомиссии.Фамилия,
					СтрокаКомиссии.Имя,
					СтрокаКомиссии.Отчество);
			
			СтрокаКомиссииДокумента.ФИО = КорреспондентыКлиентСервер.ФИО(
				ФИО, Истина);
			СтрокаКомиссииДокумента.ОсобыеОтметки = ЭлектронныеДокументыБГУ.ФИОПоСтруктуре(ФИО);		
		КонецЦикла;		
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПрочееОтражениеЭлектронногоДокументаВУчете";
	КомандаПечати.Идентификатор		= "ОтветныйАктПриемаПередачи0510448";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Ответный Акт о приеме-передаче НФА'"), "0510448", "61н", "100н");
	КомандаПечати.Порядок			= 1;
	УправлениеПечатью.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, "НФАПереданыЭлектроннымАктом",
		Истина, ВидСравнения.Равно);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ОтветныйАктПриемаПередачи0510448") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ОтветныйАктПриемаПередачи0510448", "Ответный Акт о приеме-передаче НФА (ф.0510448)",
			ЭлектронныеДокументыБГУ.НапечататьОтветный0510448ДляМЗДляПрочегоОтраженияВУчете(МассивОбъектов, ОбъектыПечати, Ложь));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Если ТипЗнч(ДокументСсылка.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
	
		ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
		
		НаименованиеЭД = "УПД";
		НомерЭД = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка.Ссылка, ДокументСсылка.Номер);
		Если ЗначениеЗаполнено(ДокументСсылка.ДокументОснование) Тогда
			СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка.ДокументОснование, "ВидПервичногоДокумента, НомерПервичногоДокумента, ДатаПервичногоДокумента");
			НаименованиеЭД = СтруктураДанных.ВидПервичногоДокумента;
