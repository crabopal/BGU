
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОтборОрганизация = Параметры.Организация;
	ОтборКонтрагент = Параметры.Контрагент;
	НоменклатураОтправителя = Параметры.НоменклатураОтправителя;

	ЗагрузитьПереданыйСписокНФАПолученных(Параметры.АдресДанныхНФАПолученныхВХранилище);
	ЗагрузитьПереданыйСписокНФАУчтенных(Параметры.АдресДанныхНФАУчтенныхВХранилище);
	
	ТаблицаНФА.Загрузить(НФАУчтенные.Выгрузить());
	Для Каждого ТекСтрока Из НФАПолученные Цикл
		НоваяСтрока = ТаблицаНФА.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.Сумма = (-1) * ТекСтрока.Сумма;
		НоваяСтрока.Количество = (-1) * ТекСтрока.Количество;
	КонецЦикла;
	ИтоговаяТаблицаНФА = ТаблицаНФА.Выгрузить();
	ИтоговаяТаблицаНФА.Свернуть("НФА, СчетУчета, КПС, КФО", "Сумма, Количество");
	
	НоменклатураПолучателя = НоменклатураПолучателя(ОтборОрганизация, НоменклатураОтправителя);
	
	Для Каждого ТекСтрока Из ИтоговаяТаблицаНФА Цикл
		ПроверятьНоменклатуру = Ложь;
		Если ЗначениеЗаполнено(НоменклатураПолучателя) Тогда
			ПроверятьНоменклатуру = Истина;
		КонецЕсли;	
		
		ПроверкаПройдена = Ложь;
		Если ПроверятьНоменклатуру Тогда
			Если ТекСтрока.НФА = НоменклатураПолучателя Тогда
				ПроверкаПройдена = Истина;
			КонецЕсли;	
		Иначе	
			ПроверкаПройдена = Истина;
		КонецЕсли;
			
		Если ПроверкаПройдена Тогда
			УчитыватьВОстатках = Истина;
			Если ТекСтрока.Количество <= 0 Тогда
				УчитыватьВОстатках = Ложь;
			КонецЕсли;
			Если ТекСтрока.Сумма <= 0 Тогда
				УчитыватьВОстатках = Ложь;
			КонецЕсли;

			Если УчитыватьВОстатках Тогда
				НоваяСтрока = ТаблицаНФАОстаток.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура ТаблицаНФАОстатокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОповеститьОВыбореСтроки(СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНФАОстатокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	ОповеститьОВыбореСтроки(СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьПереданыйСписокНФАПолученных(АдресДанныхВХранилище)
	Если ЗначениеЗаполнено(АдресДанныхВХранилище) Тогда
		СписокНФА = ПолучитьИзВременногоХранилища(АдресДанныхВХранилище);
		Если ЗначениеЗаполнено(СписокНФА) Тогда
			НФАПолученные.Загрузить(СписокНФА);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры 

&НаСервере
Процедура ЗагрузитьПереданыйСписокНФАУчтенных(АдресДанныхВХранилище)
	Если ЗначениеЗаполнено(АдресДанныхВХранилище) Тогда
		СписокНФА = ПолучитьИзВременногоХранилища(АдресДанныхВХранилище);
		Если ЗначениеЗаполнено(СписокНФА) Тогда
			НФАУчтенные.Загрузить(СписокНФА);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция НоменклатураПолучателя(Организация, НоменклатураОтправителя)
	Возврат ЭлектронныеДокументыБГУ.НоменклатураПолучателяАкта0510448(Организация, НоменклатураОтправителя);
КонецФункции

&НаКлиенте
Процедура ОповеститьОВыбореСтроки(СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Для каждого Строка Из Элементы.ТаблицаНФАОстаток.ВыделенныеСтроки Цикл
		ДанныеВыбраннойСтроки = Новый Структура;
		ДанныеВыбраннойСтроки.Вставить("НФА", Элементы.ТаблицаНФАОстаток.ДанныеСтроки(Строка).НФА);
		ДанныеВыбраннойСтроки.Вставить("Количество", Элементы.ТаблицаНФАОстаток.ДанныеСтроки(Строка).Количество);
		ДанныеВыбраннойСтроки.Вставить("Сумма", Элементы.ТаблицаНФАОстаток.ДанныеСтроки(Строка).Сумма);
		ДанныеВыбраннойСтроки.Вставить("СчетУчета", Элементы.ТаблицаНФАОстаток.ДанныеСтроки(Строка).СчетУчета);
		ДанныеВыбраннойСтроки.Вставить("КПС", Элементы.ТаблицаНФАОстаток.ДанныеСтроки(Строка).КПС);
		ДанныеВыбраннойСтроки.Вставить("КФО", Элементы.ТаблицаНФАОстаток.ДанныеСтроки(Строка).КФО);
		
		ОповеститьОВыборе(ДанныеВыбраннойСтроки);
	КонецЦикла; 
КонецПроцедуры

#КонецОбласти
