			НовыеЗначения = ЗаполнитьДанныеНФАДляАкта(ВыбранноеЗначение, ТекСтрока.НФАУОтправителя, 
				ТекСтрока.НаименованиеНФАУОтправителя);
			ТекСтрока.НаименованиеНФА = НовыеЗначения.НаименованиеНФА;
			ТекСтрока.ЕдИзмКод = НовыеЗначения.ЕдИзмКод;
			ТекСтрока.ЕдИзмНаим = НовыеЗначения.ЕдИзмНаим;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокФайловВходящегоАктаПриемаПередачи()

	УправлениеНФА.ЗаполнитьСписокФайловВходящегоАктаПриемаПередачи(Объект, ФайлыПриложенийВходящегоЭлектронногоАктаПриемаПередачи);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНФАПолучателя()
	ТаблицаНФА = Объект.СведенияОПринятыхОбъектахНФА.Выгрузить(, "НФА, Количество, БалансоваяСтоимость, СчетУчета, КПС, КФО");
	ТаблицаНФА.Свернуть("НФА, СчетУчета, КПС, КФО", "Количество, БалансоваяСтоимость");
	ТаблицаНФАПолучателя.Очистить();
	Для Каждого ТекСтрока Из ТаблицаНФА Цикл
		Если ЗначениеЗаполнено(ТекСтрока.НФА) Тогда
			НоваяСтрока = ТаблицаНФАПолучателя.Добавить();
			НоваяСтрока.НФА = ТекСтрока.НФА;
			НоваяСтрока.СчетУчета = ТекСтрока.СчетУчета;
			НоваяСтрока.КПС = ТекСтрока.КПС;
			НоваяСтрока.КФО = ТекСтрока.КФО;
			НоваяСтрока.Количество = ТекСтрока.Количество;
			НоваяСтрока.Сумма = ТекСтрока.БалансоваяСтоимость;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыСведенияОПринятыхОбъектахНФА(ТекущаяСтрока)

	ТекущаяСтрока.ЗаголовокНФАУОтправителя = НСтр("ru = 'Номенклатура у отправителя:'");
	ТекущаяСтрока.ЗаголовокНФАУПолучателя = НСтр("ru = 'Номенклатура у получателя:'");
	ТекущаяСтрока.ЗаголовокСчетУчета = НСтр("ru = 'Счет учета:'");
	ТекущаяСтрока.ЗаголовокКФО = НСтр("ru = 'КФО:'");
	ТекущаяСтрока.ЗаголовокКПС = НСтр("ru = 'КПС:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыСведенияОПринятыхОбъектахНФА(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.СведенияОПринятыхОбъектахНФА Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыСведенияОПринятыхОбъектахНФА(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

