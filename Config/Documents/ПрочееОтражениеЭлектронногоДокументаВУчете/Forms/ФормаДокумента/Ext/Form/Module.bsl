&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоОтражениеЭДП = Истина;
	ЭтоОтражениеВходящегоАкта = Ложь;
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
		ЭтоОтражениеЭДП = Истина;
	КонецЕсли;	

	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
		ЭтоОтражениеЭДП = Ложь;
		ЭтоОтражениеВходящегоАкта = Истина;
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ГруппаОтражениеВУчетеЭДП", "Видимость", ЭтоОтражениеЭДП);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ГруппаОтражениеВУчетеВходящегоАкта", "Видимость", ЭтоОтражениеВходящегоАкта);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ГруппаСумма", "Видимость", НЕ ЭтоОтражениеВходящегоАкта);
	
КонецПроцедуры

