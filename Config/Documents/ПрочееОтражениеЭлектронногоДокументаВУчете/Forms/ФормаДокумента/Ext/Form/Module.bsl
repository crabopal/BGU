&НаКлиенте
Процедура ПодборДокументов(Команда)
	
	ПараметрыДляВыбора = Новый Структура;
	ПараметрыДляВыбора.Вставить("ЗакрыватьПриВыборе", 	Истина);
	ПараметрыДляВыбора.Вставить("Организация",        	Объект.Организация);
	ПараметрыДляВыбора.Вставить("ЗаДату",             	Объект.Дата);
	ПараметрыДляВыбора.Вставить("ЗаказчикПоКонтракту",	Объект.Контрагент);
	ПараметрыДляВыбора.Вставить("Поставщик",			Объект.Поставщик);
	ПараметрыДляВыбора.Вставить("ДоговорСПоставщиком",	Объект.ДоговорСПоставщиком);
	ПараметрыДляВыбора.Вставить("Подразделение",		Объект.Подразделение);
	ПараметрыДляВыбора.Вставить("КодВидаПодбора",     	1);
	
	ОткрытьФорму("Документ.ПрочееОтражениеЭлектронногоДокументаВУчете.Форма.ФормаПодбораДокументов", ПараметрыДляВыбора, Элементы.ДокументыОтраженияВУчетеДляАктаОПриемеПередаче);
КонецПроцедуры

&НаКлиенте
Процедура ПодборНоменклатурыАкта(Команда)
	
	Если Объект.ДокументыОтраженияВУчетеДляАктаОПриемеПередаче.Количество() = 0 Тогда
		ТекстОшибки = НСтр("ru='Необходимо заполнить список документов отражения в учете на закладке ""Документы поступления НФА"".'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		
		Возврат;
	КонецЕсли;
	
	Если Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные <> Неопределено Тогда
		
		ЗаполнитьТаблицуНФАПолучателя();
		АдресДанныхНФАПолученныхВХранилище = ПоместитьТаблицуНФАПолученныхВХранилище();
		АдресДанныхНФАУчтенныхВХранилище = ПоместитьТаблицуНФАУчтенныхВХранилище();
		
		ПараметрыДляВыбора = Новый Структура;
		ПараметрыДляВыбора.Вставить("ЗакрыватьПриВыборе", 		Истина);
		ПараметрыДляВыбора.Вставить("Организация",        		Объект.Организация);
		ПараметрыДляВыбора.Вставить("НоменклатураОтправителя",	Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.НФАУОтправителя);
		ПараметрыДляВыбора.Вставить("ЗаДату",             		Объект.Дата);
		ПараметрыДляВыбора.Вставить("Контрагент",          		Объект.Контрагент);
		
		ПараметрыДляВыбора.Вставить("АдресДанныхНФАПолученныхВХранилище",	АдресДанныхНФАПолученныхВХранилище);
		ПараметрыДляВыбора.Вставить("АдресДанныхНФАУчтенныхВХранилище",		АдресДанныхНФАУчтенныхВХранилище);
		
		ОткрытьФорму("Документ.ПрочееОтражениеЭлектронногоДокументаВУчете.Форма.ФормаПодбораНоменклатурыИзДокументаУчета", ПараметрыДляВыбора, Элементы.СведенияОПринятыхОбъектахНФА);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПоместитьТаблицуНФАПолученныхВХранилище()
	
	Результат =  ПоместитьВоВременноеХранилище(ТаблицаНФАПолучателя.Выгрузить(), ЭтотОбъект.УникальныйИдентификатор);
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПоместитьТаблицуНФАУчтенныхВХранилище()
	
	ТаблицаДокументовУчета = Объект.ДокументыОтраженияВУчетеДляАктаОПриемеПередаче.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоступлениеМЗМатериалы.Номенклатура КАК НФА,
	               |	ПоступлениеМЗМатериалы.Количество КАК Количество,
	               |	ПоступлениеМЗМатериалы.Всего КАК Сумма,
	               |	ПоступлениеМЗМатериалы.СчетУчета КАК СчетУчета,
	               |	ПоступлениеМЗМатериалы.КПС КАК КПС,
	               |	ПоступлениеМЗМатериалы.КФО КАК КФО
	               |ИЗ
	               |	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	               |ГДЕ
	               |	ПоступлениеМЗМатериалы.Ссылка В(&ДокументыУчета)";
	Запрос.УстановитьПараметр("ДокументыУчета", ТаблицаДокументовУчета.ВыгрузитьКолонку("ДокументОтражения"));
	НоменклатураИзПоступленияНФА = Запрос.Выполнить().Выгрузить();
	
	Возврат ПоместитьВоВременноеХранилище(НоменклатураИзПоступленияНФА);

КонецФункции

