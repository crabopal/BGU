		Результат.Вставить("ЕдИзмНаим", СтруктураДанныхЕдИзм.Наименование);
	Иначе
		Реквизиты = "НаименованиеПолное, ЕдиницаИзмерения";
		СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыбранноеНФА, Реквизиты);
		РеквизитыЕдИзм = "Код, Наименование";
		СтруктураДанныхЕдИзм = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанных.ЕдиницаИзмерения, РеквизитыЕдИзм);
		
		Результат.Вставить("НаименованиеНФА", СтруктураДанных.НаименованиеПолное);
		Результат.Вставить("ЕдИзмКод", СтруктураДанныхЕдИзм.Код);
		Результат.Вставить("ЕдИзмНаим", СтруктураДанныхЕдИзм.Наименование);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

