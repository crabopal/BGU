#Область ОбработчикиСобытийЭлементовТаблицыСведенияОПринятыхОбъектахНФАНоменклатура

&НаКлиенте
Процедура СведенияОПринятыхОбъектахНФАНоменклатураПриИзменении(Элемент)
	Если Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные <> Неопределено Тогда
		ВыбранноеЗначение = Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.НФА;
		Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
			НовыеЗначения = ЗаполнитьДанныеНФАДляАкта(ВыбранноеЗначение, Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.НФАУОтправителя, 
				Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.НаименованиеНФАУОтправителя);
			Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.НаименованиеНФА = НовыеЗначения.НаименованиеНФА;
			Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.ЕдИзмКод = НовыеЗначения.ЕдИзмКод;
			Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.ЕдИзмНаим = НовыеЗначения.ЕдИзмНаим;
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СведенияОПринятыхОбъектахНФАНоменклатураОчистка(Элемент, СтандартнаяОбработка)
	ВыбранноеЗначение = Неопределено;
	НовыеЗначения = ЗаполнитьДанныеНФАДляАкта(ВыбранноеЗначение, Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.НФАУОтправителя, 
		Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.НаименованиеНФАУОтправителя);
	Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.НаименованиеНФА = НовыеЗначения.НаименованиеНФА;
	Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.ЕдИзмКод = НовыеЗначения.ЕдИзмКод;
	Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.ЕдИзмНаим = НовыеЗначения.ЕдИзмНаим;
КонецПроцедуры

&НаКлиенте
Процедура СведенияОПринятыхОбъектахНФАОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные <> Неопределено Тогда
		НовыеЗначения = ЗаполнитьДанныеНФАДляАкта(ВыбранноеЗначение.НФА, 
			Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.НФАУОтправителя, 
			Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.НаименованиеНФАУОтправителя);
				
		Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.НФА = ВыбранноеЗначение.НФА;
		Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.НаименованиеНФА = НовыеЗначения.НаименованиеНФА;
		Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.ЕдИзмКод = НовыеЗначения.ЕдИзмКод;
		Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.ЕдИзмНаим = НовыеЗначения.ЕдИзмНаим;
		
		Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.Количество = ВыбранноеЗначение.Количество;
		Если ЭтоКапВложения Тогда
			Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.СуммаФактКапВложений = ВыбранноеЗначение.Сумма;
		Иначе	
			Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.БалансоваяСтоимость = ВыбранноеЗначение.Сумма;
		КонецЕсли;
		Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.СчетУчета = ВыбранноеЗначение.СчетУчета;
		Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.КПС = ВыбранноеЗначение.КПС;
		Элементы.СведенияОПринятыхОбъектахНФА.ТекущиеДанные.КФО = ВыбранноеЗначение.КФО;
	КонецЕсли;
	ЗаполнитьЕдиницыИзмеренияИтогов();	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФайлыПриложенийВходящегоЭлектронногоАктаПриемаПередачи

&НаКлиенте
Процедура ФайлыПриложенийВходящегоЭлектронногоАктаПриемаПередачиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "ФайлыПриложенийВходящегоЭлектронногоАктаПриемаПередачиИмяФайла" Тогда
		УправлениеНФАКлиент.ОткрытьЭлектронныйДокументПриложенияИзФайла(
			ВыбраннаяСтрока, 
			ФайлыПриложенийВходящегоЭлектронногоАктаПриемаПередачи, 
			УникальныйИдентификатор);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДокументыОтраженияВУчете

&НаКлиенте
Процедура ДокументыОтраженияВУчетеДляАктаОПриемеПередачеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ДокументОтражения", ВыбранноеЗначение);
		НайденныеСтроки = Объект.ДокументыОтраженияВУчетеДляАктаОПриемеПередаче.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Объект.ДокументыОтраженияВУчетеДляАктаОПриемеПередаче.Добавить().ДокументОтражения = ВыбранноеЗначение;
			
			ЗаполнитьДанныеПоДокументуУчета(ВыбранноеЗначение);
		
			РассчитатьИтогиПоДокументамУчета();
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыОтраженияВУчетеДляАктаОПриемеПередачеДокументОтраженияПриИзменении(Элемент)
	Если Элементы.ДокументыОтраженияВУчете.ТекущиеДанные <> Неопределено Тогда
		ВыбранноеЗначение = Элементы.ДокументыОтраженияВУчете.ТекущиеДанные.ДокументОтражения;
		Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
			ЗаполнитьДанныеПоДокументуУчета(ВыбранноеЗначение);
			РассчитатьИтогиПоДокументамУчета();
		КонецЕсли;
