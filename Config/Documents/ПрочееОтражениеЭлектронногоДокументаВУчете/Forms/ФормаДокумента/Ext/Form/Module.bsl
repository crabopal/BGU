Функция ЭтоПоступлениеКапВложений()
	Результат = Ложь;
	
	Если Объект.ДокументыОтраженияВУчетеДляАктаОПриемеПередаче.Количество() > 0 Тогда
		ДокументУчета = Объект.ДокументыОтраженияВУчетеДляАктаОПриемеПередаче[0].ДокументОтражения;
		Если ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
			СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументУчета,
				"СчетУчета");
			
			Если СокрЛП(СтруктураДанных.СчетУчета) = "106.00" Тогда
				Результат = Истина;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

