&НаСервере
Процедура ДокументОснованиеПриИзмененииНаСервере()
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда	
		
		УстановитьРеквизитыИзЭДП();
		
	ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда	

		ДанныеЗаполнения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ДокументОснование,
			"Организация, Контрагент, Договор, СуммаДокумента, ВидПервичногоДокумента, ДатаПервичногоДокумента, НомерПервичногоДокумента");
		
		Объект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
		Объект.НФАПереданыЭлектроннымАктом = Истина; 
		Объект.Организация = ДанныеЗаполнения.Организация;
		Объект.Контрагент = ДанныеЗаполнения.Контрагент;
		Объект.Договор = ДанныеЗаполнения.Договор;
		Объект.СуммаДокумента = ДанныеЗаполнения.СуммаДокумента;
		Объект.НоменклатураЗаполненаПоДаннымПолучателя = ЭлектронныеДокументыБГУ.ИспользоватьНоменклатуруПолучателяВОтветномАктеОПриемеПередачеНФА(ДанныеЗаполнения.Организация);

		
		Объект.ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
		Объект.ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
		Объект.НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;

		Объект.СведенияОПринятыхОбъектахНФА.Очистить();
		
		//Заполняем по данным отправителя НФА
		СчСтрок = 0;
		Для Каждого ТекСтрока Из Объект.ДокументОснование.ПереданныеНФА Цикл
			СчСтрок = СчСтрок + 1;
			НоваяСтрока = Объект.СведенияОПринятыхОбъектахНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.КодСтроки = Формат(СчСтрок, "ЧЦ=3; ЧВН=");
			НоваяСтрока.НФА = "";
			НоваяСтрока.НФАУОтправителя = ТекСтрока.НФА;
			НоваяСтрока.НаименованиеНФАУОтправителя = ТекСтрока.НаименованиеНФА;
			НоваяСтрока.КоличествоУОтправителя = ТекСтрока.Количество;
		КонецЦикла;
		
		ОбновитьТекстЗаголовковВсехСтрокТаблицыСведенияОПринятыхОбъектахНФА(ЭтотОбъект);
		
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура РассчитатьИтогиПоДокументамУчета() 
	Запрос = Новый Запрос;
	
	ЗапросТекст = "ВЫБРАТЬ
	              |	ПоступлениеМЗМатериалы.Количество КАК Количество,
	              |	ПоступлениеМЗМатериалы.Всего КАК Всего
	              |ИЗ
	              |	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	              |ГДЕ
	              |	ПоступлениеМЗМатериалы.Ссылка В(&ДокументыУчета)
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ РАЗЛИЧНЫЕ
	              |	ПоступлениеМЗМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	              |ИЗ
	              |	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	              |ГДЕ
	              |	ПоступлениеМЗМатериалы.Ссылка В(&ДокументыУчета)";
	
	Запрос.Текст = ЗапросТекст;

	ДокументыУчета = Объект.ДокументыОтраженияВУчетеДляАктаОПриемеПередаче.Выгрузить();
	Запрос.УстановитьПараметр("ДокументыУчета", ДокументыУчета.ВыгрузитьКолонку("ДокументОтражения"));
	
	РезультатыЗапросов = Запрос.ВыполнитьПакет();	
	
	ВсеНФАДокументовУчета = РезультатыЗапросов[0].Выгрузить();
	ВсеЕдИзмНФАДокументовУчета = РезультатыЗапросов[1].Выгрузить();

	СуммаИтоговПоДокументам = ВсеНФАДокументовУчета.Итог("Всего");
	КоличествоИтоговПоДокументам = ВсеНФАДокументовУчета.Итог("Количество");
	ЕдиницыИзмеренияИтоговПоДокументам = НСтр("ru='ед.'");
	Если ВсеЕдИзмНФАДокументовУчета.Количество() = 1 Тогда
		ОбщаяЕдИзм = ВсеЕдИзмНФАДокументовУчета[0].ЕдиницаИзмерения;
		Если ЗначениеЗаполнено(ОбщаяЕдИзм) Тогда
			ЕдиницыИзмеренияИтоговПоДокументам = СокрЛП(ОбщаяЕдИзм);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоДокументуУчета(ДокументУчета)
	Если ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументУчета,
			"Контрагент, Договор, ЦМО, Подразделение, СчетУчета");
		Объект.ЦМО = СтруктураДанных.ЦМО;
		Объект.Подразделение = СтруктураДанных.Подразделение;
		Объект.Поставщик = СтруктураДанных.Контрагент;
		Объект.ДоговорСПоставщиком = СтруктураДанных.Договор;
		
		ЭтоКапВложения = Ложь;
		Если СокрЛП(СтруктураДанных.СчетУчета) = "106.00" Тогда
			ЭтоКапВложения = Истина;
		КонецЕсли;	
		
		ДанныеУчетаМЗ = ДанныеУчетаМЗ(ДокументУчета);
		ДанныеУчетаМЗ.Свернуть("СчетУчета, КПС, КФО");
		
		Для Каждого ТекСтрока Из Объект.СведенияОПринятыхОбъектахНФА Цикл
			ТекСтрока.АналитическаяГруппа = НСтр("ru='30'");
			Если ЭтоКапВложения Тогда
				ТекСтрока.ВидИмущества = НСтр("ru='вложения в нефинансовые активы'");
			Иначе	
				ТекСтрока.ВидИмущества = НСтр("ru='иное движимое'");
			КонецЕсли;
			
			Если ДанныеУчетаМЗ.Количество() > 0 Тогда
				ТекСтрока.СчетУчета = ДанныеУчетаМЗ[0].СчетУчета;
				Если НЕ ЗначениеЗаполнено(ТекСтрока.СчетУчета) Тогда
					ТекСтрока.СчетУчета = СтруктураДанных.СчетУчета;
				КонецЕсли;	
				ТекСтрока.КПС = ДанныеУчетаМЗ[0].КПС;
				ТекСтрока.КФО = ДанныеУчетаМЗ[0].КФО;
			КонецЕсли;
			
			Если ЭтоКапВложения Тогда
				ТекСтрока.СуммаФактКапВложений = ТекСтрока.БалансоваяСтоимость;
				ТекСтрока.БалансоваяСтоимость = 0;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	ЗаполнитьДанныеПоВсемДокументамУчета();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоВсемДокументамУчета()
	СписокНоменклатурыОтправителя = Объект.СведенияОПринятыхОбъектахНФА.Выгрузить();
	МассивНоменклатурыОтправителя = СписокНоменклатурыОтправителя.ВыгрузитьКолонку("НФАУОтправителя");
	ВсяНоменклатураПолучателя = ВсяНоменклатураПолучателяАкта0510448(Объект.Организация, МассивНоменклатурыОтправителя);

	ВсеДанныеИзДокументовУчета = ВсеДанныеИзДокументовУчета();
	
	Для Каждого ТекСтрока Из объект.СведенияОПринятыхОбъектахНФА Цикл
		Если Объект.НоменклатураЗаполненаПоДаннымПолучателя Тогда
			Если НЕ ЗначениеЗаполнено(ТекСтрока.НФА) Тогда
				ПараметрыОтбораНФА = Новый Структура;
				ПараметрыОтбораНФА.Вставить("Номенклатура", ТекСтрока.НФАУОтправителя);
				
				НайденныеСтроки = ВсяНоменклатураПолучателя.НайтиСтроки(ПараметрыОтбораНФА);
				Если НайденныеСтроки.Количество() = 1 Тогда
					СоответствующаяНоменклатураПолучателя = НайденныеСтроки[0].СоответствующаяНоменклатура;
					
					ПараметрыОтбораНФАИзДокументов = Новый Структура;
					ПараметрыОтбораНФАИзДокументов.Вставить("Номенклатура", СоответствующаяНоменклатураПолучателя);
					
					НайденныеСтрокиИзДокументовУчета = ВсеДанныеИзДокументовУчета.НайтиСтроки(ПараметрыОтбораНФАИзДокументов);
					Если НайденныеСтрокиИзДокументовУчета.Количество() = 1 Тогда
						Номенклатура = НайденныеСтрокиИзДокументовУчета[0].Номенклатура;
						Количество = НайденныеСтрокиИзДокументовУчета[0].Количество;
						Всего = НайденныеСтрокиИзДокументовУчета[0].Всего;
						СчетУчета = НайденныеСтрокиИзДокументовУчета[0].СчетУчета;
						КПС = НайденныеСтрокиИзДокументовУчета[0].КПС;
						КФО = НайденныеСтрокиИзДокументовУчета[0].КФО;
						ЕдиницаИзмерения = НайденныеСтрокиИзДокументовУчета[0].ЕдиницаИзмерения;
						
						ТекСтрока.НФА = Номенклатура;
						ТекСтрока.Количество = Количество;
						Если ЭтоКапВложения Тогда
							ТекСтрока.СуммаФактКапВложений = Всего;
						Иначе
							ТекСтрока.БалансоваяСтоимость = Всего;
						КонецЕсли;
						
						Реквизиты = "НаименованиеПолное, ЕдиницаИзмерения";
						СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, Реквизиты);
						
						ТекСтрока.НаименованиеНФА = СтруктураДанных.НаименованиеПолное;
						
						ЕдИзмКод = "";
						ЕдИзмНаим = "";
						Если НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
							ЕдиницаИзмерения = СтруктураДанных.ЕдиницаИзмерения;
							Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
								РеквизитыЕдИзм = "Код, Наименование";
								СтруктураДанныхЕдИзм = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанных.ЕдиницаИзмерения, РеквизитыЕдИзм);
								ЕдИзмКод = СокрЛП(СтруктураДанныхЕдИзм.Код);
								ЕдИзмНаим = СокрЛП(СтруктураДанныхЕдИзм.Наименование);
							КонецЕсли;	
						КонецЕсли;	
						
						ТекСтрока.СчетУчета = СчетУчета;
						ТекСтрока.КПС = КПС;
						ТекСтрока.КФО = КФО;
						ТекСтрока.ЕдИзмКод = ЕдИзмКод;
						ТекСтрока.ЕдИзмНаим = ЕдИзмНаим;
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция ВсеДанныеИзДокументовУчета()
	ДокументыОтраженияТЗ = Объект.ДокументыОтраженияВУчетеДляАктаОПриемеПередаче.Выгрузить();
	ДокументыОтражения = ДокументыОтраженияТЗ.ВыгрузитьКолонку("ДокументОтражения");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоступлениеМЗМатериалы.Номенклатура КАК Номенклатура,
	               |	ПоступлениеМЗМатериалы.Количество КАК Количество,
	               |	ПоступлениеМЗМатериалы.СчетУчета КАК СчетУчета,
	               |	ПоступлениеМЗМатериалы.КПС КАК КПС,
	               |	ПоступлениеМЗМатериалы.КФО КАК КФО,
	               |	ПоступлениеМЗМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ПоступлениеМЗМатериалы.Всего КАК Всего
	               |ИЗ
	               |	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	               |ГДЕ
	               |	ПоступлениеМЗМатериалы.Ссылка В(&ДокументыУчета)";
	Запрос.УстановитьПараметр("ДокументыУчета", ДокументыОтражения);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции	

&НаСервере
Функция ВсяНоменклатураПолучателяАкта0510448(Организация, НоменклатураОтправителя) Экспорт
	УстановитьПривилегированныйРежим(Истина);

	Результат = Справочники.Номенклатура.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СопоставлениеНоменклатурыБГУ.Номенклатура КАК Номенклатура,
	|	СопоставлениеНоменклатурыБГУ.СоответствующаяНоменклатура КАК СоответствующаяНоменклатура
	|ИЗ
	|	РегистрСведений.СопоставлениеНоменклатурыБГУ КАК СопоставлениеНоменклатурыБГУ
	|ГДЕ
	|	СопоставлениеНоменклатурыБГУ.Организация = &Организация
	|	И СопоставлениеНоменклатурыБГУ.Номенклатура В(&Номенклатура)
	|	И СопоставлениеНоменклатурыБГУ.КодВидаСопоставления = &КодВидаСопоставления";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураОтправителя);
	Запрос.УстановитьПараметр("КодВидаСопоставления", 1);
    Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

