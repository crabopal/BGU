Процедура ЗаполнитьЕдиницыИзмеренияИтогов()
	ЕдиницыИзмеренияИтогов = НСтр("ru='ед.'");
	
	ЕдинаяЕдИзм = Истина;
	ТекЕдИзм = "";
	ТекКодЕдИзм = "";
	Для Каждого ТекСтрока Из Объект.СведенияОПринятыхОбъектахНФА Цикл
		Если НЕ ЗначениеЗаполнено(ТекКодЕдИзм) Тогда
			ТекКодЕдИзм = ТекСтрока.ЕдИзмКод;
			ТекЕдИзм = ТекСтрока.ЕдИзмНаим;
		Иначе
			Если НЕ СокрЛП(ТекКодЕдИзм) = СокрЛП(ТекСтрока.ЕдИзмКод) Тогда
				ЕдинаяЕдИзм = Ложь;
				Прервать;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	Если ЕдинаяЕдИзм Тогда
		ЕдиницыИзмеренияИтогов = ТекЕдИзм;
	КонецЕсли;	
КонецПроцедуры

