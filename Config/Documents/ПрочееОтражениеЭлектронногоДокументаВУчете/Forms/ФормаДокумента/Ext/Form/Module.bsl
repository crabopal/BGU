Процедура УстановитьРеквизитыИзЭДП() 
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ДокументОснование,
			"Организация, Контрагент, Договор, ВалютаДокумента, СуммаДокумента");
		ЗаполнитьЗначенияСвойств(Объект, СтруктураДанных);
		Объект.Дата = ЭлектронныеДокументыБГУ.ДатаВходящегоИзвещенияЭДП(Объект.ДокументОснование);
		
		ДокументыОтражения = ЭлектронныеДокументыБГУВызовСервера.ДокументыОтраженияДляЭДП(Объект.ДокументОснование);
		СуммаОтраженияВучете = ДокументыОтражения.Итог("Сумма");
		Объект.СуммаДокумента = СтруктураДанных.СуммаДокумента - СуммаОтраженияВучете;
	Иначе
		Объект.Контрагент = "";
		Объект.Договор = "";
		Объект.ВалютаДокумента = "";
		Объект.СуммаДокумента = 0;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтветственныеЛица()
	ДатаДокумента = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ОбщегоНазначения.ТекущаяДатаПользователя());
	НовыйРуководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"),
		Объект.Организация, ДатаДокумента, Объект.Подразделение);
	
	Если ЗначениеЗаполнено(НовыйРуководитель.ОтветственноеЛицоСсылка) 
			И Объект.Руководитель <> НовыйРуководитель.ОтветственноеЛицоСсылка Тогда
		Объект.Руководитель = НовыйРуководитель.ОтветственноеЛицоСсылка;
	КонецЕсли;

	Объект.ОтветственныйИсполнитель = ЗаполнениеРеквизитовОбъектов.ПолучитьОтветственногоИсполнителя(
		Объект.Ответственный, Объект.Организация, "Документ.ПрочееОтражениеЭлектронногоДокументаВУчете");
	
КонецПроцедуры
	
