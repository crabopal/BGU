Процедура Подбор(Команда)
	
	Если Команда.Имя = "ПодборНоменклатуры" Тогда
		
		Если ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(СформироватьСтруктуруПроверяемыхРеквизитов(), Объект, Истина) Тогда
			Возврат;
		КонецЕсли;
		
		УправлениеМатериальнымиЗапасамиКлиент.ОткрытьПодборМатериалов(ЭтаФорма, Объект,, ДополнитьСтруктуруПодбора());
		
	Иначе		
		
		Отбор = Новый Структура;
		Отбор.Вставить("Организация", Объект.Организация);
		Отбор.Вставить("ЭтоГруппа", Ложь);
		
		ПараметрыФормы = Новый Структура("Отбор,ЗакрыватьПриВыборе, МножественныйВыбор", Отбор, Ложь, Истина);
		ОткрытьФорму("Справочник.ОсновныеСредства.ФормаВыбора", ПараметрыФормы, Элементы.Товары);
		
	КонецЕсли;
	
