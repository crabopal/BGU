									+ ВыборкаСтрок.КЭККт;
			КонецЕсли;
			
			СтруктураОбластьМакетаСтрока = Новый Структура("пСчетДебета,пСчетКредита",ПредставлениеСчетДт,ПредставлениеСчетКт);			
			
			СрокЭксплуатации = УправлениеОсновнымиСредствами.ФактическийСрокЭксплуатации(
				ВыборкаСтрок.ОсновноеСредство, ВыборкаСтрок.ИнвентарныйНомер, Выборка.Организация, Выборка.пДата);
			пСрокЭксплуатации = УправлениеОсновнымиСредствами.МесяцВГод(СрокЭксплуатации);
			
			СтруктураОбластьМакетаСтрока.Вставить("пСрокЭксплуатации", пСрокЭксплуатации);
			
			ОбластьМакетаСтрока.Параметры.Заполнить(СтруктураОбластьМакетаСтрока);
			
			ТабличныйДокумент.Вывести(ОбластьМакетаСтрока);
			
			пКоличествоИтого = пКоличествоИтого + ВыборкаСтрок.пКоличество;
			пСуммаИтого		 = пСуммаИтого		+ ВыборкаСтрок.пСумма;
		КонецЦикла;
		СтруктураОбластьМакетаИтого = Новый Структура("пКоличествоИтого,пСуммаИтого",пКоличествоИтого,пСуммаИтого);
		ОбластьМакетаИтого.Параметры.Заполнить(СтруктураОбластьМакетаИтого);

		ТабличныйДокумент.Вывести(ОбластьМакетаИтого);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		СтруктураОбластьМакетаСтр2Начало = Новый Структура;
		Если пКоличествоИтого = Цел(пКоличествоИтого) Тогда
			СтруктураОбластьМакетаСтр2Начало.Вставить("пКоличествоИтогоПрописью",ЧислоПрописью(пКоличествоИтого,,"штука,штуки,штук,ж,,,,,0"));
		Иначе
			СтруктураОбластьМакетаСтр2Начало.Вставить("пКоличествоИтогоПрописью","");
		КонецЕсли;
		Если пСуммаИтого <> 0 Тогда
			СтруктураОбластьМакетаСтр2Начало.Вставить("пСуммаИтогоПрописью",ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(пСуммаИтого, 
																		Константы.ВалютаРегламентированногоУчета.Получить()));
		Иначе																		
			СтруктураОбластьМакетаСтр2Начало.Вставить("пСуммаИтогоПрописью", "");
		КонецЕсли;
		СтруктураОбластьМакетаСтр2Начало.Вставить("ЗаключениеКомиссии", Выборка.ЗаключениеКомиссии);
		ОбластьМакетаСтр2Начало.Параметры.Заполнить(СтруктураОбластьМакетаСтр2Начало);
		
		ТабличныйДокумент.Вывести(ОбластьМакетаСтр2Начало);
		
		// комиссия
		ТабличныйДокумент.Вывести(ОбластьКомиссия);
		
		ТабличныйДокумент.Вывести(ОбластьМакетаСтр2Шапка);
		
		ПодвалСтраницы2 = Новый Массив;
		ПодвалСтраницы2.Добавить(ОбластьМакетаСтр2Строка);
		ПодвалСтраницы2.Добавить(ОбластьМакетаСтр2Строка);
		ПодвалСтраницы2.Добавить(ОбластьМакетаСтр2Подвал);
		ПодвалСтраницы2.Добавить(ОбластьКомиссия);
		ПодвалСтраницы2.Добавить(ОбластьМакетаПодвал);
		
		Пока ТабличныйДокумент.ПроверитьВывод(ПодвалСтраницы2) Цикл
			ТабличныйДокумент.Вывести(ОбластьМакетаСтр2Строка);	
		КонецЦикла;
		
		ТабличныйДокумент.Вывести(ОбластьМакетаСтр2Строка);
		ТабличныйДокумент.Вывести(ОбластьМакетаСтр2Подвал);
		
		// комиссия
		ТабличныйДокумент.Вывести(ОбластьКомиссия);
		ТабличныйДокумент.Вывести(ОбластьМакетаПодвал);

		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#КонецЕсли
