// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("ОсновноеСредство");
	ИменаРеквизитов.Добавить("ИнвентарныйНомер");
	ИменаРеквизитов.Добавить("КПС");
	ИменаРеквизитов.Добавить("СчетУчета");
	ИменаРеквизитов.Добавить("Количество");
	ИменаРеквизитов.Добавить("Цена");
	ИменаРеквизитов.Добавить("СуммаАмортизации");
	ИменаРеквизитов.Добавить("Сумма");
	Результат.Вставить("ОсновныеСредства", ИменаРеквизитов);
	Возврат Результат;
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, 
	"ВидОперации, ПринятьНаХранение, Резервировать");
	
	Если РеквизитыДокумента.Резервировать Тогда
		Возврат;
	КонецЕсли;	
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", УправлениеОсновнымиСредствами.НаименованиеПечатнойФормы("0504143"));
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ТаблицаОсновныеСредства", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Ссылка КАК Ссылка,
	|	ТаблицаОсновныеСредства.Ссылка.Номер КАК Номер,
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК Дата,
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК ДатаСписанияСБухУчета,
	|	ТаблицаОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.Ссылка.Подразделение КАК Подразделение,
	|	ТаблицаОсновныеСредства.Ссылка.ЦМО КАК ЦМО,
	|	ТаблицаОсновныеСредства.Ссылка.ЦМОПолучатель КАК ЦМОПолучатель,
	|	ТаблицаОсновныеСредства.Ссылка.Контрагент КАК Контрагент,
	|	&ИмяДокумента КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.Ссылка.Номер КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК ДатаДокумента,
	|	ТаблицаОсновныеСредства.Ссылка.ВидОперации КАК ВидОперации,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.Количество КАК Количество,
	|	ТаблицаОсновныеСредства.Сумма КАК Сумма,
	|	ТаблицаОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|		ИЛИ НЕ ТаблицаОсновныеСредства.ОсновноеСредство.ГрупповойУчет
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПообъектныйУчет,
	|	ТаблицаОсновныеСредства.Ссылка.ПринятьНаХранение КАК ПринятьНаХранение,
	|	"""" КАК ПричинаСписания
	|ПОМЕСТИТЬ ТаблицаОсновныеСредства
	|ИЗ
	|	Документ.АктСписанияМягкогоИХозИнвентаряОС.ОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.Ссылка = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер";
	
	НомераТаблиц.Вставить("СобытияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаОсновныеСредства.Дата КАК Период,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание) КАК Событие,
	|	ТаблицаОсновныеСредства.Дата КАК ДатаСобытия,
	|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС)
	|	И НЕ ТаблицаОсновныеСредства.ПринятьНаХранение
	|	И ТаблицаОсновныеСредства.ПообъектныйУчет";
	
	// Движения по регистрам СтоимостьОбъектовОС и АмортизацияОбъектовОС.
	// Амортизация линейным способом не начисляется.
	ПараметрыСписания = УправлениеОсновнымиСредствами.ПараметрыСписанияОСПоРегистрамНакопления(РеквизитыДокумента.ВидОперации);
	ПараметрыСписания.НачислитьАмортизациюПриСписании = Ложь;
	Если РеквизитыДокумента.ПринятьНаХранение Тогда
		ПараметрыСписания.ВидРаспоряженияУКонтрагента	= Перечисления.ВидыРаспоряженияОС.НаХранении;
		ПараметрыСписания.ПоступлениеКонтрагенту		= Истина;
	КонецЕсли;
	УправлениеОсновнымиСредствами.ДобавитьТаблицыСписанияОСПоРегистрамНакопления(Запрос, НомераТаблиц,
		ДокументСсылка, ПараметрыСписания);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктСписанияМягкогоИХозИнвентаряОС";
	КомандаПечати.Идентификатор		= "АктСписанияОС0504143_103н";
	КомандаПечати.Представление		= НСтр("ru = 'Акт о списании мягкого и хоз. инвентаря (ф. 0504143) (52, ред. 103н)'");
	КомандаПечати.Порядок			= 1;
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктСписанияМягкогоИХозИнвентаряОС";
	КомандаПечати.Идентификатор		= "АктСписанияОС0504143_52н";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Акт о списании мягкого и хоз. инвентаря (ф. 0504143) (52н)'");
	КомандаПечати.Порядок			= 101;
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктСписанияМягкогоИХозИнвентаряОС";
	КомандаПечати.Идентификатор		= "АктСписанияОС0504143";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Акт о списании мягкого и хоз. инвентаря (ф. 0504143) (173н)'");
	КомандаПечати.Порядок			= 102;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Проверяем, нужно ли для макета формировать табличный документ.
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСписанияОС0504143_103н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"АктСписанияОС0504143_103н",
		"Списание материалов",
		ПечатьАктСписанияМягкогоИнвентаря(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияМягкогоИнвентаря0504143_103н"));
	КонецЕсли;
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСписанияОС0504143_52н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"АктСписанияОС0504143_52н",
		"Списание материалов",
		ПечатьАктСписанияМягкогоИнвентаря(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияМягкогоИнвентаря504143_52н"));
	КонецЕсли;

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСписанияОС0504143") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"АктСписанияОС0504143",
			"Списание материалов",
			ПечатьАктСписанияМягкогоИнвентаря(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияМягкогоИнвентаря0504143"));
	КонецЕсли;

КонецПроцедуры

Функция ПечатьАктСписанияМягкогоИнвентаря(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "АктСписанияМягкогоИнвентаря_0504143";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет." + ИмяМакета);
	
	ОбластьМакетаЗаголовок  			= Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакетаШапка      			= Макет.ПолучитьОбласть("Шапка");
	ОбластьМакетаСтрока     			= Макет.ПолучитьОбласть("Строка");
	ОбластьМакетаИтого      			= Макет.ПолучитьОбласть("Итого");
	ОбластьМакетаСтр2Начало 			= Макет.ПолучитьОбласть("Стр2Начало");
	ОбластьМакетаСтр2Заголовок			= Макет.ПолучитьОбласть("Стр2Заголовок");
	ОбластьМакетаСтр2ЗаключениеКомиссии	= Макет.ПолучитьОбласть("Стр2ЗаключениеКомиссии");
	ОбластьМакетаСтр2ПустоеЗаключение	= Макет.ПолучитьОбласть("Стр2ПустоеЗаключение");
	ОбластьМакетаКомиссия   			= Макет.ПолучитьОбласть("Комиссия");
	ОбластьМакетаСтр2       			= Макет.ПолучитьОбласть("Стр2");
	ОбластьМакетаСтр2Шапка  			= Макет.ПолучитьОбласть("Стр2Шапка");
	ОбластьМакетаСтр2Строка				= Макет.ПолучитьОбласть("Стр2Строка");
	ОбластьМакетаСтр2Подвал 			= Макет.ПолучитьОбласть("Стр2Подвал");
	ОбластьМакетаПодвал     			= Макет.ПолучитьОбласть("Подвал");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ФИОФизЛиц.Дата,
	|	ФИОФизическихЛиц.Фамилия,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество,
	|	ФИОФизЛиц.ЦМО,
	|	ФИОФизЛиц.АктСписанияСсылка
	|ПОМЕСТИТЬ ФИОФизЛиц
	|ИЗ
	|	(ВЫБРАТЬ
	|		ФизЛицаДокументов.Дата КАК Дата,
	|		ФизЛицаДокументов.ФизЛицоСсылка КАК ФизЛицоСсылка,
	|		МАКСИМУМ(ФИОФизическихЛиц.Период) КАК МаксимумПериод,
	|		ФизЛицаДокументов.ЦМО КАК ЦМО,
	|		ФизЛицаДокументов.АктСписанияСсылка КАК АктСписанияСсылка
	|	ИЗ
	|		(ВЫБРАТЬ
	|			АктСписанияМягкогоИХозИнвентаряОС.Дата КАК Дата,
	|			ФизическиеЛица.Ссылка КАК ФизЛицоСсылка,
	|			АктСписанияМягкогоИХозИнвентаряОС.ЦМО КАК ЦМО,
	|			АктСписанияМягкогоИХозИнвентаряОС.Ссылка КАК АктСписанияСсылка
	|		ИЗ
	|			Документ.АктСписанияМягкогоИХозИнвентаряОС КАК АктСписанияМягкогоИХозИнвентаряОС
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|						ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|							ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
	|							ПО Контрагенты.ЮридическоеФизическоеЛицо = ФизическиеЛица.Ссылка
	|						ПО Сотрудники.Контрагент = Контрагенты.Ссылка
	|					ПО СправочникЦМО.Сотрудник = Сотрудники.Ссылка
	|				ПО АктСписанияМягкогоИХозИнвентаряОС.ЦМО = СправочникЦМО.Ссылка
	|		ГДЕ
	|			АктСписанияМягкогоИХозИнвентаряОС.Ссылка В(&МассивОбъектов)) КАК ФизЛицаДокументов
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|			ПО ФизЛицаДокументов.ФизЛицоСсылка = ФИОФизическихЛиц.ФизическоеЛицо
	|				И (ФИОФизическихЛиц.Период <= ФизЛицаДокументов.Дата)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ФизЛицаДокументов.Дата,
	|		ФизЛицаДокументов.ФизЛицоСсылка,
	|		ФизЛицаДокументов.ЦМО,
	|		ФизЛицаДокументов.АктСписанияСсылка) КАК ФИОФизЛиц
