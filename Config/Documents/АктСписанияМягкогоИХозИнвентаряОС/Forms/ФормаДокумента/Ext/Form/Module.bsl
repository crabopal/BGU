Процедура Подключаемый_ДекорацияСостояниеОригиналаНажатие()
    // СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
    УчетОригиналовПервичныхДокументовКлиент.ОткрытьМенюВыбораСостояния(ЭтотОбъект,Элементы.ДекорацияСостояниеОригинала);
    //Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Отображение обязательности колонки КПС
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваКПС.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ВидОперации", ВидСравненияКомпоновкиДанных.Равно,
		Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"УчетПоКПС21", ВидСравненияКомпоновкиДанных.Равно, Ложь);		
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста"				, ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного"	, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст"					, "<не используется>");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр"			, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	ЕстьПрослеживаемыеТовары = ПрослеживаемостьБГУ.ЕстьПрослеживаемыеТовары(Объект.ОсновныеСредства);
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	УстановитьДопустимыеКодыОперацийПрослеживаемости(ЭтотОбъект);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТВоВсехСтроках(ЭтотОбъект, "ОсновныеСредства");
	
	УчетПоПодразделениям101 = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("101.00").УчетПоПодразделениям;
	ПризнакиУчета21 = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("21");
	УчетПоПодразделениям21	= ПризнакиУчета21.УчетПоПодразделениям;
	УчетПоКПС21	= ПризнакиУчета21.УчетПоКПС;
	
	УстановитьДинамическиеДанныеТаблицыОсновныеСредства();
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтаФорма, Объект);
	УстановитьОбязательностьЭлементовФормы(ЭтаФорма, Объект);
	РезервированиеНФАКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)

	Элементы = Форма.Элементы;
	
	ДоступностьСвязанныхЭлементов = ЗначениеЗаполнено(Объект.Организация);
	Элементы.ЦМО.Доступность			= ДоступностьСвязанныхЭлементов;
	Элементы.Подразделение.Доступность	= ДоступностьСвязанныхЭлементов;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОбязательностьЭлементовФормы(Форма, Объект)

	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет") Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("21");
	Иначе
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("101.00");
	КонецЕсли;
	
	ПодразделениеОбязательно = Форма.КэшПараметров.ИспользоватьУчетПоПодразделениям
		И СвойстваСчета.УчетПоПодразделениям;
	
	Если ПодразделениеОбязательно Тогда
		Форма.Элементы.Подразделение.АвтоОтметкаНезаполненного	= Истина;
		Форма.Элементы.Подразделение.ОтметкаНезаполненного		= НЕ ЗначениеЗаполнено(Объект.Подразделение);
	Иначе
		Форма.Элементы.Подразделение.АвтоОтметкаНезаполненного	= Ложь;
		Форма.Элементы.Подразделение.ОтметкаНезаполненного		= Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьДинамическиеДанныеТаблицыОсновныеСредства()
	
	МассивОбъектовОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	ДанныеОбъектовОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОбъектовОС, "ГрупповойУчет,ВидНФА");
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		
		ДанныеОбъектаОС = ДанныеОбъектовОС[СтрокаТаблицы.ОсновноеСредство];
		Если ДанныеОбъектаОС <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеОбъектаОС);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммы(СообщатьОбОшибках = Истина)

	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(
		СтруктураПроверяемыхРеквизитов(), Объект, СообщатьОбОшибках);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если Объект.Проведен Тогда
		ТекстСообщения = НСтр("ru = 'Расчет доступен только в непроведенном документе'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	РассчитатьСуммыНаСервере();

КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыНаСервере()
	
	ТаблицаОС = УправлениеОсновнымиСредствами.ПустаяТаблицаОС_ДляРасчетаУчетныхДанных();
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		НоваяСтрока = ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
	КонецЦикла;	
	
	ТабОстатков = УправлениеОсновнымиСредствами.ТаблицаУчетныхДанных(ПараметрыПолученияУчетныхДанных(ТаблицаОС));
	
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		ЗаполнитьСтрокуТЧ(СтрокаТЧ, ТабОстатков);
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("КФО");
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		СтруктураРеквизитов.Вставить("ИФО");
	КонецЕсли;
	Если Элементы.ЦМО.ОтметкаНезаполненного Тогда
		СтруктураРеквизитов.Вставить("ЦМО", "МОЛ/Место хранения");
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям
		И Элементы.Подразделение.ОтметкаНезаполненного Тогда
		СтруктураРеквизитов.Вставить("Подразделение");
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
		
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("КФО"			, Объект.КФО);	
	ПараметрыПодбора.Отбор.Вставить("ЦМО"			, Объект.ЦМО);
	ПараметрыПодбора.Отбор.Вставить("Подразделение"	, Объект.Подразделение);
	ПараметрыПодбора.Отбор.Вставить("ТипНФА"		, ПредопределенноеЗначение("Перечисление.ТипыНФА.Инвентарь"));
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС") Тогда
		ПараметрыПодбора.Вставить("ВидРаспоряжения", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе"));
		ПараметрыПодбора.Вставить("НужнаАмортизация", Истина);
		ПараметрыПодбора.Отбор.Вставить("Счет", "101.00");
	Иначе
		ПараметрыПодбора.Вставить("ВидРаспоряжения", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ОперативныйУчет"));
	КонецЕсли;
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	ПараметрыПодбора.Вставить("ДокументСРезервированиемОС", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОсновныхСредствНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()

	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);

КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(Знач ВыбранноеЗначение)
	
	ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(
		Объект.ОсновныеСредства, ВыбранноеЗначение);
	
	УстановитьДинамическиеДанныеТаблицыОсновныеСредства();
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьУстановитьКоличествоОСВСтроке(СтрокаТаблицы);
	КонецЦикла;
	
	//РассчитатьСуммыНаСервере();
	Если ВедетсяУчетПрослеживаемыхТоваров Тогда
		ПроверяемыеОС = Новый Массив;
		Для каждого Строка Из ДобавленныеСтроки Цикл
			ПроверяемыеОС.Добавить(Строка.ОсновноеСредство);
		КонецЦикла; 
		ПрослеживаемыеОсновныеСредства = ПрослеживаемостьБГУ.ПрослеживаемыеОсновныеСредства(Объект, ПроверяемыеОС);
		СтраныОС = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ПроверяемыеОС, "СтранаПроисхождения");
		Для каждого Строка Из ДобавленныеСтроки Цикл
			СостояниеПрослеживаемости = ПрослеживаемыеОсновныеСредства.Получить(Строка.ОсновноеСредство);
			Если СостояниеПрослеживаемости <> Неопределено Тогда
				Строка.ПрослеживаемыйТовар = СостояниеПрослеживаемости;
				ЕстьПрослеживаемыеТовары = ЕстьПрослеживаемыеТовары ИЛИ СостояниеПрослеживаемости;
			КонецЕсли;
			СтранаОС = СтраныОС.Получить(Строка.ОсновноеСредство);
			Если СтранаОС <> Неопределено Тогда
				Строка.СтранаПроисхождения = СтранаОС;
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;
	Если ЕстьПрослеживаемыеТовары Тогда
		УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементовХранение()
	
	Элементы.ЦМОПолучатель.Видимость	= Объект.ПринятьНаХранение;
	Элементы.Контрагент.Видимость		= Объект.ПринятьНаХранение;
	
КонецПроцедуры
// Прослеживаемые ОС

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_Прослеживаемость(Форма)

	Элементы = Форма.Элементы;
	
	ВидимостьОсновныхЭлементов = Форма.ВедетсяУчетПрослеживаемыхТоваров И Форма.ЕстьПрослеживаемыеТовары;
	ИменаЭлементовПрослеживаемости = Новый Массив;
	ИменаЭлементовПрослеживаемости.Добавить("ОсновныеСредстваСтранаПроисхождения");
	ИменаЭлементовПрослеживаемости.Добавить("ОсновныеСредстваПрослеживаемыйТовар");
	ИменаЭлементовПрослеживаемости.Добавить("ОсновныеСредстваРНПТ");
	ИменаЭлементовПрослеживаемости.Добавить("КодОперацииПрослеживаемости");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовПрослеживаемости,
		"Видимость", ВидимостьОсновныхЭлементов);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиРНПТ(Знач ИдентификаторСтроки)
	ПрослеживаемостьБГУ.УдалитьСтрокиРНПТ(Объект, ИдентификаторСтроки);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораРНПТННаКлиенте(ВыбранноеЗначение)
	
	СтрокаТабличнойЧасти = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
			СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		ОбработкаВыбораРНПТННаСервере(СтрокаТабличнойЧасти.ИдентификаторСтроки, ВыбранноеЗначение, СтрокаТабличнойЧасти.ПолучитьИдентификатор());
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораРНПТННаСервере(Знач ИдентификаторСтроки, Знач ВыбранноеЗначение, Знач ИдентификаторСтрокиВнутр)
	
	СтрокаТабличнойЧасти = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтрокиВнутр);
	ПрослеживаемостьФормыБГУ.ОбработкаВыбораРНПТН(ЭтотОбъект, ИдентификаторСтроки, ВыбранноеЗначение);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТ(ЭтаФорма, СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьРНПТВХранилище(Адрес, ДополнительныеПараметры) Экспорт
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ПоместитьРНПТВХранилищеНаСервере(Адрес, ДополнительныеПараметры.ИдентификаторСтроки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПоместитьРНПТВХранилищеНаСервере(Адрес, ИдентификаторСтроки)

	ТаблицаРНПТ = Объект.СведенияПрослеживаемости.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	ПоместитьВоВременноеХранилище(ТаблицаРНПТ, Адрес);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДопустимыеКодыОперацийПрослеживаемости(Форма)

	Если НЕ Форма.ВедетсяУчетПрослеживаемыхТоваров Тогда
		Возврат;
	КонецЕсли;

	ВидыОперацийПрослеживаемости = ПрослеживаемостьБГУКлиентСервер.ВидыОперацийПрослеживаемости();
	ВидыОперацийПрослеживаемости.Списание = Истина;
	ВидыОперацийПрослеживаемости.Утилизация = Истина;
	ДанныеВыбора = ПрослеживаемостьБГУКлиентСервер.КодыОперацийПрослеживаемости(ВидыОперацийПрослеживаемости);
	Форма.Элементы.КодОперацииПрослеживаемости.СписокВыбора.ЗагрузитьЗначения(ДанныеВыбора);

КонецПроцедуры

// СтандартныеПодсистемы.Свойства 
&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
    УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
    УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
