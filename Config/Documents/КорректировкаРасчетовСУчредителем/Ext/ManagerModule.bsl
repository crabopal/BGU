#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата, Организация, КорректировкаОборотами");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", ДанныеДокумента.Организация);
	Запрос.УстановитьПараметр("ДатаДокумента", ДанныеДокумента.Дата);
	Запрос.УстановитьПараметр("ДатаДляОстатков", Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
	
	ТаблицыЗапроса = Новый Массив;
	Если ДанныеДокумента.КорректировкаОборотами Тогда
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);

		ТаблицыЗапроса.Добавить("ОстаткиПоРегистру");
		ТаблицыЗапроса.Добавить("ДанныеДокумента");
		ТаблицыЗапроса.Добавить("ОборотыРасчетовСУчредителями");

		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОборотыРасчетовСУчредителямиОстатки.Организация КАК Организация,
		|	ОборотыРасчетовСУчредителямиОстатки.ИФО КАК ИФО,
		|	ОборотыРасчетовСУчредителямиОстатки.КФО КАК КФО,
		|	ОборотыРасчетовСУчредителямиОстатки.Подразделение КАК Подразделение,
		|	ОборотыРасчетовСУчредителямиОстатки.СтоимостьУвеличениеОстаток КАК СтоимостьУвеличение,
		|	ОборотыРасчетовСУчредителямиОстатки.СтоимостьУменьшениеОстаток КАК СтоимостьУменьшение,
		|	ОборотыРасчетовСУчредителямиОстатки.АмортизацияУвеличениеОстаток КАК АмортизацияУвеличение,
		|	ОборотыРасчетовСУчредителямиОстатки.АмортизацияУменьшениеОстаток КАК АмортизацияУменьшение
		|ПОМЕСТИТЬ ОстаткиПоРегистру
		|ИЗ
		|	РегистрНакопления.ОборотыРасчетовСУчредителями.Остатки(&ДатаДляОстатков, Организация = &Организация) КАК ОборотыРасчетовСУчредителямиОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КорректировкаРасчетовСУчредителемОстатки.Ссылка.Организация КАК Организация,
		|	КорректировкаРасчетовСУчредителемОстатки.ИФО КАК ИФО,
		|	КорректировкаРасчетовСУчредителемОстатки.КФО КАК КФО,
		|	КорректировкаРасчетовСУчредителемОстатки.Подразделение КАК Подразделение,
		|	СУММА(КорректировкаРасчетовСУчредителемОстатки.СтоимостьПринятогоОЦИ) КАК СтоимостьПринятогоОЦИ,
		|	СУММА(КорректировкаРасчетовСУчредителемОстатки.СтоимостьВыбывшегоОЦИ) КАК СтоимостьВыбывшегоОЦИ,
		|	СУММА(КорректировкаРасчетовСУчредителемОстатки.АмортизацияПринятогоОЦИ) КАК АмортизацияПринятогоОЦИ,
		|	СУММА(КорректировкаРасчетовСУчредителемОстатки.АмортизацияВыбывшегоОЦИ) КАК АмортизацияВыбывшегоОЦИ
		|ПОМЕСТИТЬ ДанныеДокумента
		|ИЗ
		|	Документ.КорректировкаРасчетовСУчредителем.Остатки КАК КорректировкаРасчетовСУчредителемОстатки
		|ГДЕ
		|	КорректировкаРасчетовСУчредителемОстатки.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	КорректировкаРасчетовСУчредителемОстатки.Ссылка.Организация,
		|	КорректировкаРасчетовСУчредителемОстатки.ИФО,
		|	КорректировкаРасчетовСУчредителемОстатки.КФО,
		|	КорректировкаРасчетовСУчредителемОстатки.Подразделение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&ДатаДокумента КАК Период,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
		|	ОстаткиПоРегистру.Организация КАК Организация,
		|	ОстаткиПоРегистру.ИФО КАК ИФО,
		|	ОстаткиПоРегистру.КФО КАК КФО,
		|	ОстаткиПоРегистру.Подразделение КАК Подразделение,
		|	СУММА(ВЫБОР
		|			КОГДА ДанныеДокумента.СтоимостьПринятогоОЦИ <= ОстаткиПоРегистру.СтоимостьУвеличение
		|				ТОГДА ДанныеДокумента.СтоимостьПринятогоОЦИ
		|			ИНАЧЕ ОстаткиПоРегистру.СтоимостьУвеличение
		|		КОНЕЦ) КАК СтоимостьУвеличение,
		|	СУММА(ВЫБОР
		|			КОГДА ДанныеДокумента.СтоимостьВыбывшегоОЦИ <= ОстаткиПоРегистру.СтоимостьУменьшение
		|				ТОГДА ДанныеДокумента.СтоимостьВыбывшегоОЦИ
		|			ИНАЧЕ ОстаткиПоРегистру.СтоимостьУменьшение
		|		КОНЕЦ) КАК СтоимостьУменьшение,
		|	СУММА(ВЫБОР
		|			КОГДА ДанныеДокумента.АмортизацияПринятогоОЦИ <= ОстаткиПоРегистру.АмортизацияУвеличение
		|				ТОГДА ДанныеДокумента.АмортизацияПринятогоОЦИ
		|			ИНАЧЕ ОстаткиПоРегистру.АмортизацияУвеличение
		|		КОНЕЦ) КАК АмортизацияУвеличение,
		|	СУММА(ВЫБОР
		|			КОГДА ДанныеДокумента.АмортизацияВыбывшегоОЦИ <= ОстаткиПоРегистру.АмортизацияУменьшение
		|				ТОГДА ДанныеДокумента.АмортизацияВыбывшегоОЦИ
		|			ИНАЧЕ ОстаткиПоРегистру.АмортизацияУменьшение
		|		КОНЕЦ) КАК АмортизацияУменьшение
		|ИЗ
		|	ОстаткиПоРегистру КАК ОстаткиПоРегистру
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеДокумента КАК ДанныеДокумента
		|		ПО ОстаткиПоРегистру.Организация = ДанныеДокумента.Организация
		|			И ОстаткиПоРегистру.ИФО = ДанныеДокумента.ИФО
		|			И ОстаткиПоРегистру.КФО = ДанныеДокумента.КФО
		|			И ОстаткиПоРегистру.Подразделение = ДанныеДокумента.Подразделение
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиПоРегистру.Организация,
		|	ОстаткиПоРегистру.ИФО,
		|	ОстаткиПоРегистру.КФО,
		|	ОстаткиПоРегистру.Подразделение
		|
		|ИМЕЮЩИЕ
		|	(СУММА(ВЫБОР
		|				КОГДА ДанныеДокумента.СтоимостьПринятогоОЦИ <= ОстаткиПоРегистру.СтоимостьУвеличение
		|					ТОГДА ДанныеДокумента.СтоимостьПринятогоОЦИ
		|				ИНАЧЕ ОстаткиПоРегистру.СтоимостьУвеличение
		|			КОНЕЦ) <> 0
		|		ИЛИ СУММА(ВЫБОР
		|				КОГДА ДанныеДокумента.СтоимостьВыбывшегоОЦИ <= ОстаткиПоРегистру.СтоимостьУменьшение
		|					ТОГДА ДанныеДокумента.СтоимостьВыбывшегоОЦИ
		|				ИНАЧЕ ОстаткиПоРегистру.СтоимостьУменьшение
		|			КОНЕЦ) <> 0
		|		ИЛИ СУММА(ВЫБОР
		|				КОГДА ДанныеДокумента.АмортизацияПринятогоОЦИ <= ОстаткиПоРегистру.АмортизацияУвеличение
		|					ТОГДА ДанныеДокумента.АмортизацияПринятогоОЦИ
		|				ИНАЧЕ ОстаткиПоРегистру.АмортизацияУвеличение
		|			КОНЕЦ) <> 0
		|		ИЛИ СУММА(ВЫБОР
		|				КОГДА ДанныеДокумента.АмортизацияВыбывшегоОЦИ <= ОстаткиПоРегистру.АмортизацияУменьшение
		|					ТОГДА ДанныеДокумента.АмортизацияВыбывшегоОЦИ
		|				ИНАЧЕ ОстаткиПоРегистру.АмортизацияУменьшение
		|			КОНЕЦ) <> 0)";

	Иначе	
		ТаблицыЗапроса.Добавить("ОборотыРасчетовСУчредителями");
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДатаДокумента КАК Период,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
		|	ОборотыРасчетовСУчредителямиОстатки.Организация КАК Организация,
		|	ОборотыРасчетовСУчредителямиОстатки.ИФО КАК ИФО,
		|	ОборотыРасчетовСУчредителямиОстатки.КФО КАК КФО,
		|	ОборотыРасчетовСУчредителямиОстатки.Подразделение КАК Подразделение,
		|	ОборотыРасчетовСУчредителямиОстатки.СтоимостьУвеличениеОстаток КАК СтоимостьУвеличение,
		|	ОборотыРасчетовСУчредителямиОстатки.СтоимостьУменьшениеОстаток КАК СтоимостьУменьшение,
		|	ОборотыРасчетовСУчредителямиОстатки.АмортизацияУвеличениеОстаток КАК АмортизацияУвеличение,
		|	ОборотыРасчетовСУчредителямиОстатки.АмортизацияУменьшениеОстаток КАК АмортизацияУменьшение
		|ИЗ
		|	РегистрНакопления.ОборотыРасчетовСУчредителями.Остатки(&ДатаДляОстатков, Организация = &Организация) КАК ОборотыРасчетовСУчредителямиОстатки";
	КонецЕсли;	

	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
