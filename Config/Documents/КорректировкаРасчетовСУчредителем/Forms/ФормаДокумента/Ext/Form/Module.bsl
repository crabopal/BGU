&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитов(Форма)
	Объект = Форма.Объект;
	
	//Форма.Элементы.ОстаткиГруппаСуммаОстатка.Видимость = НЕ Объект.КорректировкаОборотами;
	Форма.Элементы.ОстаткиГруппаСуммаОЦИ.Видимость     = НЕ Объект.КорректировкаОборотами;
	Форма.Элементы.ОстаткиГруппаСумма.Видимость        = НЕ Объект.КорректировкаОборотами;

	Форма.Элементы.ОборотыГруппаПринятие.Видимость = Объект.КорректировкаОборотами;
	Форма.Элементы.ОборотыГруппаВыбытие.Видимость  = Объект.КорректировкаОборотами;

	Форма.Элементы.ГруппаИтогов.Видимость = НЕ Объект.КорректировкаОборотами;
	Форма.Элементы.ГруппаИтогиОборотов.Видимость = Объект.КорректировкаОборотами;
	
	Форма.Элементы.ОстаткиПодразделениеСчетаДоходов.Видимость = Форма.ВидимостьПодразделенияСчетДоходов;
	Форма.Элементы.ОстаткиПодразделениеСчетаУчредителя.Видимость = Форма.ВидимостьПодразделенияСчетУчредителя;
КонецПроцедуры	

&НаСервере
Процедура ОпределитьПараметрыСчета(Счет, Префикс)
	
	МаксКоличествоСубконто = БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто();
	КоличествоСубконто = Счет.ВидыСубконто.Количество();
	
	Для Индекс = 1 По МаксКоличествоСубконто Цикл
		Элемент = Элементы.Найти("ОстаткиСубконто" + Префикс + Индекс);
		Если Элемент <> Неопределено Тогда
			Элемент.Видимость = (Индекс <= КоличествоСубконто);
		КонецЕсли;
	КонецЦикла;
	
	Если Объект.КорректировкаОборотами И Префикс = "Учредителя" Тогда
		УчетОСПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям();
		ФлВидимости = Счет.УчетПоПодразделениям ИЛИ УчетОСПоПодразделениям;
	Иначе	
		ФлВидимости = Счет.УчетПоПодразделениям;
	КонецЕсли;	
	ЭтотОбъект["ВидимостьПодразделенияСчет" + Префикс] = ФлВидимости;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДатуИзмененияТипаУчреждения(Организация, Период)
	
	Возврат РегистрыСведений.УчетнаяПолитикаОрганизаций.ПолучитьДатуИзмененияТипаУчреждения(Организация, Период);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПриИзмененииОрганизацииСервер(Организация, Период)
	
	Результат = ПолучитьДатуИзмененияТипаУчреждения(Организация, Период);
	
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация,"Распорядитель");
	Результат.Вставить("Контрагент", Контрагент);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуСервер()
	Если Объект.КорректировкаОборотами Тогда
		ЗаполнитьТаблицуПоОборотамСервер();
	Иначе
		ЗаполнитьТаблицуПоОстаткамСервер();
	КонецЕсли;	
КонецПроцедуры

#Область ЗаполнениеДокументаПоОстаткам

&НаСервере
Процедура ЗаполнитьТаблицуПоОстаткамСервер()
	
	ТекстОбъединенияТаблиц = "
		|
		| ОБЪЕДИНИТЬ ВСЕ
		|
		|";
	РазделительПакетаЗапросов = ОбщегоНазначения.РазделительПакетаЗапросов();
	
	ЧастиЗапроса = Новый Массив;
	
	// Получаем текст запроса
	
	ЧастиЗапроса.Добавить(
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.ИФО КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЕСТЬNULL(ЕПСБУОстатки.СуммаОстаток, 0) КАК Сумма,
	|	0 КАК СуммаАмортизации
	|ПОМЕСТИТЬ ВТ_Баланс
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счет4),
	|			,
	|			Организация = &Организация
	|				И КФО В (&КФО4)) КАК ЕПСБУОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСБУОстатки.ИФО,
	|	ЕПСБУОстатки.КФО,
	|	ЕПСБУОстатки.Подразделение,
	|	0,
	|	ЕСТЬNULL(-ЕПСБУОстатки.СуммаОстаток, 0)
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетАм4),
	|			,
	|			Организация = &Организация
	|				И КФО В (&КФО4)) КАК ЕПСБУОстатки");
	
	Если Объект.ТекущийТПС = Перечисления.ТипыПлановСчетов.ДляБюджетных Тогда
		
		ЧастиЗапроса.Добавить(ТекстОбъединенияТаблиц);
		ЧастиЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ЕПСБУОстатки.ИФО КАК ИФО,
		|	ЕПСБУОстатки.КФО КАК КФО,
		|	ЕПСБУОстатки.Подразделение,
		|	ЕСТЬNULL(ЕПСБУОстатки.СуммаОстаток, 0) КАК Сумма,
		|	0 КАК СуммаАмортизации
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			Счет В (&Счет2),
		|			,
		|			Организация = &Организация
		|				И КФО В (&КФО2)) КАК ЕПСБУОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕПСБУОстатки.ИФО,
		|	ЕПСБУОстатки.КФО,
		|	ЕПСБУОстатки.Подразделение,
		|	0,
		|	ЕСТЬNULL(-ЕПСБУОстатки.СуммаОстаток, 0)
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			Счет В (&СчетАм2),
		|			,
		|			Организация = &Организация
		|				И КФО В (&КФО2)) КАК ЕПСБУОстатки");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаИзмененияТипаУчреждения) Тогда
		
		ЧастиЗапроса.Вставить(0,
		"ВЫБРАТЬ
		|	СобытияОССрезПоследних.ОсновноеСредство
		|ПОМЕСТИТЬ ВТ_Изменения
		|ИЗ
		|	РегистрСведений.СобытияОС.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
		|ГДЕ
		|	СобытияОССрезПоследних.ДатаСобытия < &ДатаИзменения");
		
		ЧастиЗапроса.Вставить(1, РазделительПакетаЗапросов);
		
		ЧастиЗапроса.Добавить(ТекстОбъединенияТаблиц);
		ЧастиЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ЕПСБУОстатки.ИФО КАК ИФО,
		|	ЕПСБУОстатки.КФО КАК КФО,
		|	ЕПСБУОстатки.Подразделение,
		|	ЕСТЬNULL(ЕПСБУОстатки.СуммаОстаток, 0) КАК Сумма,
		|	0 КАК СуммаАмортизации
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			Счет В (&СчетИзменения),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|			Организация = &Организация
		|				И КФО В (&КФОИзменения)
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						ВТ.ОсновноеСредство
		|					ИЗ
		|						ВТ_Изменения КАК ВТ)) КАК ЕПСБУОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕПСБУОстатки.ИФО,
		|	ЕПСБУОстатки.КФО,
		|	ЕПСБУОстатки.Подразделение,
		|	0,
		|	ЕСТЬNULL(-ЕПСБУОстатки.СуммаОстаток, 0)
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			Счет В (&СчетАмИзменения),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|			Организация = &Организация
		|				И КФО В (&КФОИзменения)
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						ВТ.ОсновноеСредство
		|					ИЗ
		|						ВТ_Изменения КАК ВТ)) КАК ЕПСБУОстатки");
		
	КонецЕсли;
	
	ЧастиЗапроса.Добавить(РазделительПакетаЗапросов);
	ЧастиЗапроса.Добавить(
	"ВЫБРАТЬ
	|	ЕПСБУОстаткиУчр.ИФО КАК ИФО,
	|	ЕПСБУОстаткиУчр.КФО КАК КФО,
	|	ЕПСБУОстаткиУчр.КПС КАК КПС,
	|	ЕПСБУОстаткиУчр.Подразделение КАК Подразделение,
	|	ЕПСБУОстаткиУчр.Субконто2 КАК СубконтоУчредителя2,
	|	ЕПСБУОстаткиУчр.Субконто3 КАК СубконтоУчредителя3,
	|	ЕСТЬNULL(-ЕПСБУОстаткиУчр.СуммаОстаток, 0) КАК СуммаОстатка
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет = &СчетУчредителя,
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &Учредитель
	|				И КФО В (&КФО)) КАК ЕПСБУОстаткиУчр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Баланс.ИФО,
	|	ВТ_Баланс.КФО,
	|	ВТ_Баланс.Подразделение КАК Подразделение,
	|	СУММА(ВТ_Баланс.Сумма) КАК СуммаОЦИ,
	|	СУММА(ВТ_Баланс.СуммаАмортизации) КАК СуммаАмортизацииОЦИ
	|ИЗ
	|	ВТ_Баланс КАК ВТ_Баланс
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Баланс.ИФО,
	|	ВТ_Баланс.КФО,
	|	ВТ_Баланс.Подразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОстаткиОЦИ.ИФО КАК ИФО,
	|	ЕПСБУОстаткиОЦИ.КФО КАК КФО,
	|	ЕПСБУОстаткиОЦИ.Подразделение КАК Подразделение,
	|	ЕСТЬNULL(-ЕПСБУОстаткиОЦИ.СуммаОстаток, 0) КАК СуммаОстаткаАмортизации
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет = &СчетОЦИ,
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &Учредитель
	|				И КФО В (&КФО)) КАК ЕПСБУОстаткиОЦИ");
	
	// Определяем параметры учета, и подменяем поля если учет не ведется
	
	ТекстЗапроса = СтрСоединить(ЧастиЗапроса, "");
	
	УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Если Не УчетПоИФО Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЕПСБУОстатки.ИФО"		, "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЕПСБУОстаткиУчр.ИФО"	, "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЕПСБУОстаткиОЦИ.ИФО"	, "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	
	УчетПоПодр210 = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("210.06").УчетПоПодразделениям;
	УчетПоПодр101 = УчетПоПодр210 И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("101.00").УчетПоПодразделениям;
	УчетПоПодрОЦИ = УчетПоПодр210 И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("ОЦИ").УчетПоПодразделениям;
	
	Если Не УчетПоПодр210 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЕПСБУОстаткиУчр.Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	Если Не УчетПоПодр101 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЕПСБУОстатки.Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	Если Не УчетПоПодрОЦИ Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЕПСБУОстаткиОЦИ.Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	// Параметры запроса
	
	Период = Новый Граница(КонецДня(Объект.Дата),ВидГраницы.Включая);
	СчетИзменения	= ?(Объект.ТекущийТПС = Перечисления.ТипыПлановСчетов.ДляБюджетных, "", "101.10,") + "101.20,102.20";
	СчетАмИзменения	= ?(Объект.ТекущийТПС = Перечисления.ТипыПлановСчетов.ДляБюджетных, "", "104.10,") + "104.20,104.29";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период"			, Период);
	Запрос.УстановитьПараметр("ДатаИзменения"	, Объект.ДатаИзмененияТипаУчреждения);
	Запрос.УстановитьПараметр("Организация"		, Объект.Организация);
	Запрос.УстановитьПараметр("Учредитель"		, Объект.Контрагент);
	Запрос.УстановитьПараметр("СчетУчредителя"	, Объект.СчетУчредителя);
	Запрос.УстановитьПараметр("СчетОЦИ"			, Объект.СчетАмортизацииОЦИ);
	Запрос.УстановитьПараметр("Счет2"			, БухгалтерскийУчетПовтИсп.СписокСчетов("101.10,103.11"));
	Запрос.УстановитьПараметр("Счет4"			, БухгалтерскийУчетПовтИсп.СписокСчетов("101.10,101.20,102.20,103.11"));
	Запрос.УстановитьПараметр("СчетИзменения"	, БухгалтерскийУчетПовтИсп.СписокСчетов(СчетИзменения));
	Запрос.УстановитьПараметр("СчетАм2"			, БухгалтерскийУчетПовтИсп.СписокСчетов("104.10"));
	Запрос.УстановитьПараметр("СчетАм4"			, БухгалтерскийУчетПовтИсп.СписокСчетов("104.10,104.20,104.29"));
	Запрос.УстановитьПараметр("СчетАмИзменения"	, БухгалтерскийУчетПовтИсп.СписокСчетов(СчетАмИзменения));
	Запрос.УстановитьПараметр("КФО"				, ПолучитьМассивКФО("2,4,7"));
	Запрос.УстановитьПараметр("КФО2"			, ПолучитьМассивКФО("2"));
	Запрос.УстановитьПараметр("КФО4"			, ПолучитьМассивКФО("4"));
	Запрос.УстановитьПараметр("КФОИзменения"	, ПолучитьМассивКФО("2,7"));
	
	// Получаем результат
	
	Результат = Запрос.ВыполнитьПакет();
	КоличествоПакетов = Результат.Количество();
	
	Остатки		= Результат[КоличествоПакетов - 3].Выгрузить();
	Баланс		= Результат[КоличествоПакетов - 2].Выгрузить();
	Амортизация	= Результат[КоличествоПакетов - 1].Выгрузить();
	
	ТипКолонки = Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(18, 2));
	Остатки.Колонки.Добавить("Сумма"							, ТипКолонки);
	Остатки.Колонки.Добавить("СуммаОЦИ"							, ТипКолонки);
	Остатки.Колонки.Добавить("СуммаОстаткаАмортизации"			, ТипКолонки);
	Остатки.Колонки.Добавить("СуммаАмортизацииОЦИ"				, ТипКолонки);
	Остатки.Колонки.Добавить("СуммаКорректировкиАмортизации"	, ТипКолонки);
	Остатки.Колонки.Добавить("ПодразделениеСчетаДоходов");
	
	РаспределитьБаланс(Баланс, Остатки, УчетПоПодр101);
	РаспределитьАмортизацию(Амортизация, Остатки, УчетПоПодрОЦИ);
	
	Для Каждого ТекущаяСтрока Из Остатки Цикл
		РассчитатьСуммуКорректировкиСтроки(ТекущаяСтрока);
		ТекущаяСтрока.ПодразделениеСчетаДоходов = ТекущаяСтрока.Подразделение;
	КонецЦикла;
	
	Остатки.Сортировать("ИФО,КФО,Подразделение,КПС");
	
	Объект.Остатки.Загрузить(Остатки);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивКФО(КФО)
	
	ЗначенияКодов = Новый Соответствие;
	ЗначенияКодов.Вставить("1", Перечисления.КВД.Бюджет);
	ЗначенияКодов.Вставить("2", Перечисления.КВД.Внебюджет);
	ЗначенияКодов.Вставить("3", Перечисления.КВД.ВременноеРаспоряжение);
	ЗначенияКодов.Вставить("4", Перечисления.КВД.СубсидииНаГосзадание);
	ЗначенияКодов.Вставить("5", Перечисления.КВД.СубсидииНаИныеЦели);
	ЗначенияКодов.Вставить("6", Перечисления.КВД.БюджетныеИнвестиции);
	ЗначенияКодов.Вставить("7", Перечисления.КВД.СредстваОМС);
	
	МассивКодов = СтрРазделить(КФО, ",", Ложь);
	
	Результат = Новый Массив;
	Для Каждого Код Из МассивКодов Цикл
		Значение = ЗначенияКодов[СокрЛП(Код)];
		Если ЗначениеЗаполнено(Значение) Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура РаспределитьБаланс(Таблица, Остатки, НужноПодразделение)
	
	Отбор = Новый Структура("ИФО,КФО" + ?(НужноПодразделение, ",Подразделение", ""));
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаТаблицы);
		СтрокиТаблицы = Остатки.НайтиСтроки(Отбор);
		
		КолвоСтрок = СтрокиТаблицы.Количество();
		
		Если КолвоСтрок = 0 Тогда
			НоваяСтрока = Остатки.Добавить();
			НоваяСтрока.СуммаОстатка = 0;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		ИначеЕсли КолвоСтрок = 1 Тогда
			СтрокиТаблицы[0].СуммаОЦИ			 = СтрокаТаблицы.СуммаОЦИ;
			СтрокиТаблицы[0].СуммаАмортизацииОЦИ = СтрокаТаблицы.СуммаАмортизацииОЦИ;
		Иначе
			РаспределитьСуммуПоСтрокам(СтрокаТаблицы.СуммаОЦИ, СтрокиТаблицы, "СуммаОстатка", "СуммаОЦИ");
			СтрокиТаблицы[0].СуммаАмортизацииОЦИ = СтрокаТаблицы.СуммаАмортизацииОЦИ;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РаспределитьАмортизацию(Таблица, Остатки, НужноПодразделение)
	
	Отбор = Новый Структура("ИФО,КФО" + ?(НужноПодразделение, ",Подразделение", ""));
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаТаблицы);
		СтрокиТаблицы = Остатки.НайтиСтроки(Отбор);
		
		КолвоСтрок = СтрокиТаблицы.Количество();
		
		Если КолвоСтрок = 0 Тогда
			НоваяСтрока = Остатки.Добавить();
			НоваяСтрока.СуммаОстатка = 0;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		ИначеЕсли КолвоСтрок = 1 Тогда
			СтрокиТаблицы[0].СуммаОстаткаАмортизации = СтрокаТаблицы.СуммаОстаткаАмортизации;
		Иначе
			РаспределитьСуммуПоСтрокам(СтрокаТаблицы.СуммаОстаткаАмортизации, СтрокиТаблицы, "СуммаАмортизацииОЦИ", "СуммаОстаткаАмортизации");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РаспределитьСуммуПоСтрокам(Сумма, Строки, Источник, Приемник);
	
	Дельта = Сумма;
	
	Для Каждого СтрокаТаблицы Из Строки Цикл
		СтрокаТаблицы[Приемник] = СтрокаТаблицы[Источник];
		Дельта = Дельта - СтрокаТаблицы[Источник];
	КонецЦикла;
	
	Строки[0][Приемник] = Строки[0][Приемник] + Дельта;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммуКорректировкиСтроки(ТекущаяСтрока)
	
	ТекущаяСтрока.Сумма                         = ТекущаяСтрока.СуммаОЦИ - ТекущаяСтрока.СуммаОстатка;
	ТекущаяСтрока.СуммаКорректировкиАмортизации = ТекущаяСтрока.СуммаАмортизацииОЦИ - ТекущаяСтрока.СуммаОстаткаАмортизации;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДокументаПоОборотам

&НаСервере
Процедура ЗаполнитьТаблицуПоОборотамСервер()   
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЕПСБУОстаткиУчр.ИФО КАК ИФО,
	|	ЕПСБУОстаткиУчр.КФО КАК КФО,
	|	ЕПСБУОстаткиУчр.КПС КАК КПС,
	|	ЕСТЬNULL(ЕПСБУОстаткиУчр.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	ЕПСБУОстаткиУчр.Субконто2 КАК СубконтоУчредителя2,
	|	ЕПСБУОстаткиУчр.Субконто3 КАК СубконтоУчредителя3,
	|	ЕСТЬNULL(-ЕПСБУОстаткиУчр.СуммаОстаток, 0) КАК СуммаОстатка
	|ПОМЕСТИТЬ Остатки21006
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет = &СчетУчредителя,
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &Учредитель
	|				И КФО В (&КФО)) КАК ЕПСБУОстаткиУчр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОстаткиОЦИ.ИФО КАК ИФО,
	|	ЕПСБУОстаткиОЦИ.КФО КАК КФО,
	|	ЕСТЬNULL(ЕПСБУОстаткиОЦИ.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	СУММА(ЕСТЬNULL(-ЕПСБУОстаткиОЦИ.СуммаОстаток, 0)) КАК СуммаОстаткаАмортизации
	|ПОМЕСТИТЬ ОстаткиОЦИ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет = &СчетОЦИ,
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &Учредитель
	|				И КФО В (&КФО)) КАК ЕПСБУОстаткиОЦИ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОстаткиОЦИ.ИФО,
	|	ЕПСБУОстаткиОЦИ.КФО,
	|	ЕСТЬNULL(ЕПСБУОстаткиОЦИ.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетыСУчредителямиОстатки.ИФО КАК ИФО,
	|	РасчетыСУчредителямиОстатки.КФО КАК КФО,
	|	РасчетыСУчредителямиОстатки.Подразделение КАК Подразделение,
	|	СУММА(РасчетыСУчредителямиОстатки.СтоимостьУвеличениеОстаток) КАК СтоимостьПринятогоОЦИ,
	|	СУММА(РасчетыСУчредителямиОстатки.СтоимостьУменьшениеОстаток) КАК СтоимостьВыбывшегоОЦИ,
	|	СУММА(РасчетыСУчредителямиОстатки.АмортизацияУвеличениеОстаток) КАК АмортизацияПринятогоОЦИ,
	|	СУММА(РасчетыСУчредителямиОстатки.АмортизацияУменьшениеОстаток) КАК АмортизацияВыбывшегоОЦИ
	|ИЗ
	|	РегистрНакопления.ОборотыРасчетовСУчредителями.Остатки(&Период, Организация = &Организация) КАК РасчетыСУчредителямиОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	РасчетыСУчредителямиОстатки.ИФО,
	|	РасчетыСУчредителямиОстатки.КФО,
	|	РасчетыСУчредителямиОстатки.Подразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки21006.ИФО КАК ИФО,
	|	Остатки21006.КФО КАК КФО,
	|	Остатки21006.КПС КАК КПС,
	|	Остатки21006.Подразделение КАК Подразделение,
	|	Остатки21006.СубконтоУчредителя2 КАК СубконтоУчредителя2,
	|	Остатки21006.СубконтоУчредителя3 КАК СубконтоУчредителя3,
	|	Остатки21006.СуммаОстатка КАК СуммаОстатка,
	|	ОстаткиОЦИ.СуммаОстаткаАмортизации КАК СуммаОстаткаАмортизации
	|ПОМЕСТИТЬ Остатки21006_ОЦИ1
	|ИЗ
	|	Остатки21006 КАК Остатки21006
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиОЦИ КАК ОстаткиОЦИ
	|		ПО Остатки21006.ИФО = ОстаткиОЦИ.ИФО
	|			И Остатки21006.КФО = ОстаткиОЦИ.КФО
	|			И Остатки21006.Подразделение = ОстаткиОЦИ.Подразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки21006_ОЦИ1.ИФО КАК ИФО,
	|	Остатки21006_ОЦИ1.КФО КАК КФО,
	|	Остатки21006_ОЦИ1.КПС КАК КПС,
	|	Остатки21006_ОЦИ1.Подразделение КАК Подразделение,
	|	Остатки21006_ОЦИ1.СубконтоУчредителя2 КАК СубконтоУчредителя2,
	|	Остатки21006_ОЦИ1.СубконтоУчредителя3 КАК СубконтоУчредителя3,
	|	Остатки21006_ОЦИ1.СуммаОстатка КАК СуммаОстатка,
	|	Остатки21006_ОЦИ1.СуммаОстаткаАмортизации КАК СуммаОстаткаАмортизации
	|ИЗ
	|	Остатки21006_ОЦИ1 КАК Остатки21006_ОЦИ1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Остатки21006.ИФО,
	|	Остатки21006.КФО,
	|	Остатки21006.КПС,
	|	Остатки21006.Подразделение,
	|	Остатки21006.СубконтоУчредителя2,
	|	Остатки21006.СубконтоУчредителя3,
	|	Остатки21006.СуммаОстатка,
	|	0
	|ИЗ
	|	Остатки21006 КАК Остатки21006
	|ГДЕ
	|	НЕ (Остатки21006.ИФО, Остатки21006.КФО, Остатки21006.Подразделение) В
	|				(ВЫБРАТЬ
	|					Таб.ИФО,
	|					Таб.КФО,
	|					Таб.Подразделение
	|				ИЗ
	|					Остатки21006_ОЦИ1 КАК Таб)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиОЦИ.ИФО,
	|	ОстаткиОЦИ.КФО,
	|	ЗНАЧЕНИЕ(Справочник.КБК.ПустаяСсылка),
	|	ОстаткиОЦИ.Подразделение,
	|	NULL,
	|	NULL,
	|	0,
	|	ОстаткиОЦИ.СуммаОстаткаАмортизации
	|ИЗ
	|	ОстаткиОЦИ КАК ОстаткиОЦИ
	|ГДЕ
	|	НЕ (ОстаткиОЦИ.ИФО, ОстаткиОЦИ.КФО, ОстаткиОЦИ.Подразделение) В
	|				(ВЫБРАТЬ
	|					Таб.ИФО,
	|					Таб.КФО,
	|					Таб.Подразделение
	|				ИЗ
	|					Остатки21006_ОЦИ1 КАК Таб)";

	Запрос = Новый Запрос(ТекстЗапроса);
	Период = Новый Граница(КонецДня(Объект.Дата),ВидГраницы.Включая);
	Запрос.УстановитьПараметр("Период"         , Период);
	Запрос.УстановитьПараметр("Организация"    , Объект.Организация);
	Запрос.УстановитьПараметр("Учредитель"     , Объект.Контрагент);
	Запрос.УстановитьПараметр("СчетУчредителя" , Объект.СчетУчредителя);
	Запрос.УстановитьПараметр("СчетОЦИ"        , Объект.СчетАмортизацииОЦИ);
	Запрос.УстановитьПараметр("КФО"            , ПолучитьМассивКФО("2,4,7")); 
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОборотыНФА = Результат[2].Выгрузить();     
	Остатки21006_ОЦИ = Результат[4].Выгрузить();
	
	ТипЧисло18_2 = Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(18, 2));
	Остатки21006_ОЦИ.Колонки.Добавить("СтоимостьПринятогоОЦИ", ТипЧисло18_2);
	Остатки21006_ОЦИ.Колонки.Добавить("СтоимостьВыбывшегоОЦИ", ТипЧисло18_2);
	Остатки21006_ОЦИ.Колонки.Добавить("АмортизацияПринятогоОЦИ", ТипЧисло18_2);
	Остатки21006_ОЦИ.Колонки.Добавить("АмортизацияВыбывшегоОЦИ", ТипЧисло18_2);
	Остатки21006_ОЦИ.Колонки.Добавить("ПодразделениеСчетаДоходов");
	
	ОборотыНФА.Колонки.Добавить("Отработано", Новый ОписаниеТипов("Булево"));

	Отбор = Новый Структура("ИФО, КФО, Подразделение");
	
	Для каждого СтрокаОстатки21006_ОЦИ из Остатки21006_ОЦИ Цикл
		СтрокаОстатки21006_ОЦИ.ПодразделениеСчетаДоходов = СтрокаОстатки21006_ОЦИ.Подразделение;
		
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаОстатки21006_ОЦИ);
		
		СтрокиОборотыНФА = ОборотыНФА.НайтиСтроки(Отбор);
		// Здесь может быть не больше одной строки
		Если СтрокиОборотыНФА.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаОстатки21006_ОЦИ, СтрокиОборотыНФА[0], 
				"СтоимостьПринятогоОЦИ, СтоимостьВыбывшегоОЦИ, АмортизацияПринятогоОЦИ, АмортизацияВыбывшегоОЦИ");
			
			СтрокиОборотыНФА[0].Отработано = Истина;
		КонецЕсли;	                         
	КонецЦикла;	

	Для каждого СтрокаОборотыНФА из ОборотыНФА Цикл
		Если СтрокаОборотыНФА.Отработано Тогда
			Продолжить;
		КонецЕсли;	   
		
		СтрокаОстатки21006_ОЦИ = Остатки21006_ОЦИ.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОстатки21006_ОЦИ, СтрокаОборотыНФА);
		СтрокаОборотыНФА.Отработано = Истина;
	КонецЦикла;	

	Объект.Остатки.Загрузить(Остатки21006_ОЦИ);
КонецПроцедуры
	
#КонецОбласти

