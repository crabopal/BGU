&НаКлиенте
Процедура ЗаполнитьТаблицу(Команда)
	
	// Чтобы не учитывались проводки этого документа, документ должен быть не проведен
	Если Объект.Проведен Тогда
		Сообщить("Заполнение таблицы возможно только в непроведенном документе.");
		Возврат;
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.ТекущийТПС) Тогда
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", "Тип плана счетов");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Объект.ТекущийТПС",, ЕстьОшибки);
	ИначеЕсли Объект.ТекущийТПС = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляКазенных") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Документ не предназначен для казенных учреждений'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", "Организация");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Объект.Организация",, ЕстьОшибки);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", "Учредитель");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Объект.Контрагент",, ЕстьОшибки);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.СчетУчредителя) Тогда
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", "Расчеты с учредителем");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Объект.СчетУчредителя",, ЕстьОшибки);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.СчетАмортизацииОЦИ) Тогда
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", "Амортизация особо ценного имущества");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Объект.СчетАмортизацииОЦИ",, ЕстьОшибки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаИзмененияТипаУчреждения) И Объект.ДатаИзмененияТипаУчреждения > Объект.Дата Тогда
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность", "Дата изменения",,,
			"Дата изменения должна быть меньше даты документа");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Объект.ДатаИзмененияТипаУчреждения",, ЕстьОшибки);
	КонецЕсли;
	
	Если ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Остатки.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьТаблицуПослеЗакрытияВопроса", ЭтотОбъект);
		ТекстВопроса = НСтр("ru='Табличная часть будет очищена.
								|Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
	Иначе
		Модифицированность = Истина;
		ЗаполнитьТаблицуСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Модифицированность = Истина;
		ЗаполнитьТаблицуСервер();
	КонецЕсли;
	
КонецПроцедуры

