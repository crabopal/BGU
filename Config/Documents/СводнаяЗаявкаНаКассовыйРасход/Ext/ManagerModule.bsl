#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс	

//  Возвращает сведения о записи в регистре сведенеий "СостояниеПлатежноРасчетныхДокументов"
//    Входящие параметры: Ссылка - тип ссылка на документ "Уведомление об уточнении операции клиента"
//    Исходящие параметры: 
Функция ПолучитьСостояниеДокумента(Ссылка) экспорт
	
	СтруктураРеквизитов = Новый Структура;
	
	ПоляВыборки = "";
	
	//  Струкутра реквизитов динамическая, т.к. со временем может понадобится новый ресурс в регистр
	//  что-бы его не забыть будем каждый раз перебирать ресурсы регистра
	Для каждого Ресурс из Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Ресурсы цикл
		СтруктураРеквизитов.Вставить(Ресурс.Имя);
		ПоляВыборки = ПоляВыборки + "
		|	Состояние." + Ресурс.Имя + " КАК " + Ресурс.Имя + ", "
	КонецЦикла;	
	
	//  Добавка ввиде реквизита "ПервичныйОбразИРеквизиты"
	СтруктураРеквизитов.Вставить("ПервичныйОбразИРеквизиты");		
	ПоляВыборки = ПоляВыборки + "
	|	Состояние.ПервичныйОбразИРеквизиты КАК ПервичныйОбразИРеквизиты ";
	
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.СводнаяЗаявкаНаКассовыйРасход") тогда
		Возврат СтруктураРеквизитов;
	КонецЕсли;	
		
	ТекстЗапроса = "ВЫБРАТЬ " + ПоляВыборки + "
					|ИЗ	
					|	РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК Состояние
					|ГДЕ 
					|	Состояние.ПлатежноРасчетныйДокумент = &Ссылка";
						
	Запрос = Новый Запрос(ТекстЗапроса);				
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
		
	Для каждого КлючЗначение из СтруктураРеквизитов Цикл
		ТекРеквизит = КлючЗначение.Ключ;
		СтруктураРеквизитов[ТекРеквизит] = Выборка[ТекРеквизит];
	КонецЦикла;	
		
	Возврат СтруктураРеквизитов;
	
КонецФункции	

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции 

// Возвращает массив структур, содержащих значения реквизитов документа для выгрузки
//
// Параметры:
// МассивОбъектов               - Массив объектов данного вида
// ИспользоватьДопКл            - Признак применения доп. классификации и указании ее значений в структурах реквизитов документов
// ИспользоватьКодМероприятия   - Признак применения кодов мероприятий
// ИспользоватьКЭК              - Признак использования КЭК
// ИспользоватьАналитическийКод - Признак использования аналитического кода
// ИспользоватьКФО              - Признак применения КФО и указания значений КФО в структурах реквизитов документа
// ИспользоватьКОСГУПолучателя  - Признак использования КОСГУПолучателя
Функция ЗначенияРеквизитовДокумента(МассивОбъектов, ИспользоватьДопКл = Ложь, ИспользоватьКодМероприятия = Ложь, ИспользоватьКЭК = Ложь, ИспользоватьАналитическийКод = Ложь, ИспользоватьКФО = Ложь, ИспользоватьКОСГУПолучателя = Ложь) Экспорт  
	
	Возврат ПлатежноРасчетныеДокументы.ЗначенияРеквизитовСводнаяЗаявкаНаКассовыйРасход(МассивОбъектов, ИспользоватьДопКл, ИспользоватьКодМероприятия, ИспользоватьКЭК, ИспользоватьАналитическийКод, ИспользоватьКФО, ИспользоватьКОСГУПолучателя);
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.СводнаяЗаявкаНаКассовыйРасход";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0531860_21н";
	КомандаПечати.Представление		= НСтр("ru = 'Сводная заявка на кассовый расход'");
	КомандаПечати.Порядок			= 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.СводнаяЗаявкаНаКассовыйРасход";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0531860";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Сводная заявка на кассовый расход (в ред 16н)'");
	КомандаПечати.Порядок			= 100;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Проверяем, нужно ли для макета СводнаяЗаявкаНаКассовыйРасход формировать табличный документ.
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531860") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_Форма0531860",
			"Сводная заявка на кассовый расход (в ред 16н)",
			ПечатьЗаявкиНаРасход(МассивОбъектов, ОбъектыПечати, ""));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531860_21н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_Форма0531860_21н",
			"Сводная заявка на кассовый расход",
			ПечатьЗаявкиНаРасход(МассивОбъектов, ОбъектыПечати, "_21н"));
	КонецЕсли;

КонецПроцедуры

// Функция формирует табличный документ Заявка на кассовый расход (ф.0531801)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция ПечатьЗаявкиНаРасход(МассивОбъектов, ОбъектыПечати, Постфикс)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы 					= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб 						= Истина; 
    ТабДокумент.ВерхнийКолонтитул.Выводить 			= Истина;
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница = 2; 
	ТабДокумент.НижнийКолонтитул.Выводить 			= Истина;
	ТабДокумент.ПолеСверху 							= 10;
	ТабДокумент.ПолеСнизу 							= 12;
    ТабДокумент.РазмерКолонтитулаСверху 			= 10;
	ТабДокумент.РазмерКолонтитулаСнизу 				= 12;
    ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_СводнаяЗаявкаНаКассовыйРасход_СводнаяЗаявкаНаКассовыйРасход";
	
	Макет           = УправлениеПечатью.МакетПечатнойФормы("Документ.СводнаяЗаявкаНаКассовыйРасход.ПФ_MXL_Форма0531860" + Постфикс);
	ДанныеДляПечати = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовСводнаяЗаявкаНаКассовыйРасход(МассивОбъектов);
	
	ОбластьЗаголовок 			= Макет.ПолучитьОбласть("Заголовок");
	ОбластьРаздел_1				= Макет.ПолучитьОбласть("Раздел_1");
	ОбластьРаздел_2_Заголовок	= Макет.ПолучитьОбласть("Раздел_2_Заголовок");
	ОбластьРаздел_2_Шапка		= Макет.ПолучитьОбласть("Раздел_2_Шапка");
	ОбластьРаздел_2_Строка		= Макет.ПолучитьОбласть("Раздел_2_Строка");
	ОбластьПодвал				= Макет.ПолучитьОбласть("Подвал");
	ОбластьРазделитель			= Макет.ПолучитьОбласть("Разделитель");
    ОбластьОтметкаФК			= Макет.ПолучитьОбласть("ОтметкаФК");
    ОбластьШапкаРаздела			= Макет.ПолучитьОбласть("ШапкаРаздела");
	
	ПервыйДокумент = Истина;
	
	Для Каждого Док Из ДанныеДляПечати Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;

		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ОбластьЗаголовок.Параметры.Заполнить(Док);
		ТабДокумент.Вывести(ОбластьЗаголовок);

		ОбластьРаздел_1.Параметры.Заполнить(Док);
        ТабДокумент.Вывести(ОбластьРаздел_1);

		
		ОбластьШапкаРаздела.Параметры.Заполнить(Док);
        ОбластьПодвал.Параметры.Заполнить(Док);

		// Табличная часть
				
		ТабДокумент.Вывести(ОбластьРаздел_2_Заголовок);
		ТабДокумент.Вывести(ОбластьРаздел_2_Шапка);

		Для Каждого СтрДок Из Док.РасшифровкаПлатежа Цикл
			
			 ОбластьРаздел_2_Строка.Параметры.Заполнить(СтрДок);
			 
			 ВыводимыеОбласти = Новый Массив();
			 ВыводимыеОбласти.Добавить(ОбластьРаздел_2_Строка);
			 ВыводимыеОбласти.Добавить(ОбластьПодвал);
			 ВыводимыеОбласти.Добавить(ОбластьРазделитель);

			 Попытка 
				 Если НЕ ТабДокумент.ПроверитьВывод(ВыводимыеОбласти) Тогда
					 ТабДокумент.Вывести(ОбластьРазделитель);
					 ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					 ТабДокумент.Вывести(ОбластьШапкаРаздела);	
					 ТабДокумент.Вывести(ОбластьРаздел_2_Шапка);	
				 КонецЕсли;
				 ТабДокумент.Вывести(ОбластьРаздел_2_Строка);
			 Исключение
				 //Сообщить("В системе не установлено ни одного принтера.");
			 КонецПопытки;
			
		КонецЦикла;	
		
		ТабДокумент.Вывести(ОбластьРазделитель);
        ТабДокумент.Вывести(ОбластьПодвал);
        //ТабДокумент.Вывести(ОбластьОтметкаФК);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, Док.Ссылка);
		
	КонецЦикла;	
	
	Возврат ТабДокумент;
	
КонецФункции

#КонецОбласти

#КонецЕсли
