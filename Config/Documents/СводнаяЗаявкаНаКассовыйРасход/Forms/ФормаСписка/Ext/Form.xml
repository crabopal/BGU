	СводнаяЗаявкаНаКассовыйРасход.Организация,
	СводнаяЗаявкаНаКассовыйРасход.ИФО,
	СводнаяЗаявкаНаКассовыйРасход.ЛицевойСчет,
	СводнаяЗаявкаНаКассовыйРасход.СуммаДокумента,
	СводнаяЗаявкаНаКассовыйРасход.Комментарий,
	СводнаяЗаявкаНаКассовыйРасход.ВидПлатежа,
	СводнаяЗаявкаНаКассовыйРасход.ОчередностьПлатежа,
	СводнаяЗаявкаНаКассовыйРасход.НазначениеПлатежа,
	СводнаяЗаявкаНаКассовыйРасход.СтатусСоставителя,
	СводнаяЗаявкаНаКассовыйРасход.КодБКНалога,
	СводнаяЗаявкаНаКассовыйРасход.ПредельнаяДатаИсполнения,
	СводнаяЗаявкаНаКассовыйРасход.ПерваяПодпись,
	СводнаяЗаявкаНаКассовыйРасход.ВтораяПодпись,
	СводнаяЗаявкаНаКассовыйРасход.ОрганКазначейства,
	СводнаяЗаявкаНаКассовыйРасход.ПерваяПодписьПечататьДолжность,
	СводнаяЗаявкаНаКассовыйРасход.ВтораяПодписьПечататьДолжность,
	СводнаяЗаявкаНаКассовыйРасход.ПерваяПодписьДолжность,
	СводнаяЗаявкаНаКассовыйРасход.ВтораяПодписьДолжность,
	СводнаяЗаявкаНаКассовыйРасход.Подразделение,
	СводнаяЗаявкаНаКассовыйРасход.РеквизитыЛицевогоСчета,
	СводнаяЗаявкаНаКассовыйРасход.ИДИсточника,
	СводнаяЗаявкаНаКассовыйРасход.Ответственный,
	СводнаяЗаявкаНаКассовыйРасход.РасшифровкаПлатежа.(
		Ссылка,
		НомерСтроки,
		СтрокаНазначениеПлатежа,
		Сумма
	),
	СводнаяЗаявкаНаКассовыйРасход.МоментВремени,
	СводнаяЗаявкаНаКассовыйРасход.ВидНалогаИлиПлатежа,
	ОперацииДокументов.Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	СостоянияЭД.ПредставлениеСостояния КАК СостояниеЭДО
ИЗ
	Документ.СводнаяЗаявкаНаКассовыйРасход КАК СводнаяЗаявкаНаКассовыйРасход
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияЭД
		ПО (СостоянияЭД.СсылкаНаОбъект = СводнаяЗаявкаНаКассовыйРасход.Ссылка)}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		ПО СводнаяЗаявкаНаКассовыйРасход.Ссылка = ОперацииДокументов.Документ}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО СводнаяЗаявкаНаКассовыйРасход.Ссылка = НаличиеФайлов.ОбъектСФайлами}</QueryText>
				<MainTable>Document.СводнаяЗаявкаНаКассовыйРасход</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
