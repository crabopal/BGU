&НаКлиенте
Процедура РасшифровкаПлатежаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "РасшифровкаПлатежаРеквизитыНалоговогоПлатежа" Тогда
		ОткрытьФормуНастройкиНалоговыхРеквизитов(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	ИначеЕсли Поле.Имя = "РасшифровкаПлатежаРеквизитыПолучателяПлатежа" Тогда
		ОткрытьФормуНастройкиРеквизитовПолучателя(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПриАктивизацииЯчейки(Элемент)
	
	Если Элементы.РасшифровкаПлатежа.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНоваяСтрока Тогда
		
		ТекущаяКолонкаТаблицы = Элементы.РасшифровкаПлатежа.ТекущийЭлемент;
		ВыбраннаяСтрока = Элементы.РасшифровкаПлатежа.ТекущаяСтрока;
		
		Если ТекущаяКолонкаТаблицы.Имя = "РасшифровкаПлатежаРеквизитыНалоговогоПлатежа" Тогда
			
			ОткрытьФормуНастройкиНалоговыхРеквизитов(ВыбраннаяСтрока);
			
		ИначеЕсли ТекущаяКолонкаТаблицы.Имя = "РасшифровкаПлатежаРеквизитыПолучателяПлатежа" Тогда
			
			ОткрытьФормуНастройкиРеквизитовПолучателя(ВыбраннаяСтрока);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока Тогда
		Возврат
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СуммаДокумента) Тогда
		Элемент.ТекущиеДанные.Сумма = Объект.СуммаДокумента - (Объект.РасшифровкаПлатежа.Итог("Сумма") - Элемент.ТекущиеДанные.Сумма);
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.РеквизитыНалоговогоПлатежа) Тогда
		Элемент.ТекущиеДанные.РеквизитыНалоговогоПлатежа = "<...>";
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.РеквизитыПолучателяПлатежа) Тогда
		Элемент.ТекущиеДанные.РеквизитыПолучателяПлатежа = "<...>";
	КонецЕсли;	
	
	Элемент.ТекущиеДанные.ИННПлательщика = ИННПлательщика;
	
	Элемент.ТекущиеДанные.КПППлательщика = КПППлательщика;

	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаСуммаПриИзменении(Элемент)
	
	СтрокаТаблицы = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	РазницаИтогаТЧ = Объект.РасшифровкаПлатежа.Итог("Сумма") - Объект.СуммаДокумента;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	РазницаИтогаТЧ = Объект.РасшифровкаПлатежа.Итог("Сумма") - Объект.СуммаДокумента;
	
	ЭтоНоваяСтрока = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПослеУдаления(Элемент)
	
	РазницаИтогаТЧ = Объект.РасшифровкаПлатежа.Итог("Сумма") - Объект.СуммаДокумента;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаНалогСборПлатежПриИзменении(Элемент)
	
	ДанныеСтроки = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, РасшифровкаПлатежаНалогСборПлатежПриИзмененииНаСервере(ДанныеСтроки.НалогСборПлатеж));
	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьНезаполненныеНалоговыеРеквизиты(ДанныеСтроки, "КодОКАТО,ПоказательОснования,ПоказательПериода,ПоказательНомера,ПоказательДаты,ПоказательТипа", ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем, Объект.Дата);
	
	ЗначенияРеквизитов = Новый Структура("КодОКАТО, ПоказательОснования, ПоказательПериода, ПоказательНомера, ПоказательДаты, ПоказательТипа");
	ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, ДанныеСтроки);
	
	
	ДанныеСтроки.РеквизитыНалоговогоПлатежа = БухгалтерскийУчетКлиентСервер.ПредставлениеНалоговыхРеквизитов(ЗначенияРеквизитов);
	
	ПриИзмененииРеквизитовПолучателяНаКлиенте();
 
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаРеквизитыНалоговогоПлатежаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуНастройкиНалоговыхРеквизитов(Элементы.РасшифровкаПлатежа.ТекущаяСтрока);
	 
КонецПроцедуры

