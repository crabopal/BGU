&НаКлиенте
Процедура УстановленнаяДлинаНазначенияПлатежаКлиент()
		
	ДлинаПоля = СтрДлина(СокрП(Объект.НазначениеПлатежа));
	
	УстановленнаяДлинаНазначенияПлатежа = " " +  Формат(ДлинаПоля, "ЧЦ=3; ЧН=0; ЧГ=0")+ " симв., макс. " + Формат(УстановленнаяМаксимальнаяДлинаНазначенияПлатежа, "ЧЦ=3; ЧН=0; ЧГ=0") + " симв."
	+ ?(ДлинаПоля > УстановленнаяМаксимальнаяДлинаНазначенияПлатежа, ", превышение " + Формат(ДлинаПоля - УстановленнаяМаксимальнаяДлинаНазначенияПлатежа, "ЧЦ=3; ЧГ=0") + " симв.", "");

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНазначениеПлатежаНаКлиенте(Шаблон, ДопПараметры) Экспорт
	
	Если Шаблон <> Неопределено Тогда
		НазначениеПлатежа(Шаблон.Значение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьРеквизитовОрганизации()

	ДоступностьРеквизитов = ЗначениеЗаполнено(Объект.Организация);
	Элементы.ЛицевойСчет.Доступность = ДоступностьРеквизитов;
	Элементы.Подразделение.Доступность = ДоступностьРеквизитов;
	Элементы.ПерваяПодпись.Доступность = ДоступностьРеквизитов;
	Элементы.ВтораяПодпись.Доступность = ДоступностьРеквизитов;

КонецПроцедуры // УстановитьДоступностьРеквизитовОрганизации()

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию();
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
	
		ИННКПП = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Организация, "ИНН, КПП");
		ИННПлательщика = ИННКПП.ИНН;
		КПППлательщика = ИННКПП.КПП;
		
	Иначе
		
		ИННПлательщика = "";
		КПППлательщика = "";
		
	КонецЕсли;	
	
	Для Каждого Стр Из Объект.РасшифровкаПлатежа Цикл
		
		Если НЕ Стр.ИННПлательщика = ИННПлательщика Тогда
			Стр.ИННПлательщика = ИННПлательщика;
		КонецЕсли;
		
		Если НЕ Стр.КПППлательщика = КПППлательщика Тогда
			Стр.КПППлательщика = КПППлательщика;
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры	
	
&НаСервере
Процедура ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию()
	
	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.СводнаяЗаявкаНаКассовыйРасход", Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
	
	Объект.ЛицевойСчет 				= Умолчания.ЛицевойСчет;
	Объект.РеквизитыЛицевогоСчета 	= Умолчания.РеквизитыЛицевогоСчета;
	Объект.ОрганКазначейства		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
	ПриИзмененииЛицевогоСчета();
	
КонецПроцедуры	

&НаСервере
Процедура ПолучитьЛицевойСчетОрганКазначейства()
	
	Объект.ЛицевойСчет 				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "Владелец");
	Объект.ОрганКазначейства		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
   	ПриИзмененииЛицевогоСчета();

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииЛицевогоСчета()
	
	Перем ДопустимыеИсточникиСредств;

   	СвойстваЛицевогоСчета 		= ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет, Объект.Дата); 
	
	Если ЗначениеЗаполнено(Объект.ЛицевойСчет) тогда
		Объект.ПерваяПодпись				 	= СвойстваЛицевогоСчета.ПерваяПодпись;
		Объект.ВтораяПодпись 					= СвойстваЛицевогоСчета.ВтораяПодпись;
		Объект.ВтораяПодписьПечататьДолжность 	= СвойстваЛицевогоСчета.ВтораяПодписьПечататьДолжность;
		Объект.ПерваяПодписьПечататьДолжность 	= СвойстваЛицевогоСчета.ПерваяПодписьПечататьДолжность;
		Объект.ПерваяПодписьДолжность         	= СвойстваЛицевогоСчета.ПерваяПодписьДолжность;
		Объект.ВтораяПодписьДолжность		  	= СвойстваЛицевогоСчета.ВтораяПодписьДолжность;
		
		Если СвойстваЛицевогоСчета.Свойство("НеЗаполнятьПредельнуюДатуИсполнения") И НЕ СвойстваЛицевогоСчета.НеЗаполнятьПредельнуюДатуИсполнения Тогда
			Объект.ПредельнаяДатаИсполнения = КонецДня(?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса())) + СвойстваЛицевогоСчета.ПредельныйСрокИсполненияЗаявок;
		КонецЕсли;	
		
		
	Иначе
		Объект.ВтораяПодписьПечататьДолжность 	= Ложь;
		Объект.ПерваяПодписьПечататьДолжность 	= Ложь;
		Объект.ПерваяПодписьДолжность         	= "";
		Объект.ВтораяПодписьДолжность		  	= "";
		Объект.ОрганКазначейства				= "";
	КонецЕсли;	
	
	Элементы.ИсточникСредств.СписокВыбора.ЗагрузитьЗначения(ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет));
	
	ПлатежноРасчетныеДокументы.ЗаполнитьДопустимыеКФОиИсточникиСредств(Объект.ЛицевойСчет,СписокДопустимыхКФО,СписокИсточниковСредствПоКФО);
	
	Если СписокДопустимыхКФО.НайтиПоЗначению(Объект.КФО) = Неопределено Тогда
		Объект.КФО = "";
		Если СписокДопустимыхКФО.Количество() > 0 Тогда
			Объект.КФО = СписокДопустимыхКФО[0].Значение;
		КонецЕсли;
	КонецЕсли;
	
	ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет,Объект.КФО);
	Если ДопустимыеИсточникиСредств.Найти(Объект.ИсточникСредств) = Неопределено Тогда
		Объект.ИсточникСредств = "";
		Если ДопустимыеИсточникиСредств.Количество() > 0 Тогда
			Объект.ИсточникСредств = ДопустимыеИсточникиСредств[0];
		КонецЕсли;
	КонецЕсли; 
	
	УстановленнаяМаксимальнаяДлинаНазначенияПлатежа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЛицевойСчет, "МаксДлинаНазначенияПлатежа");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УстановитьДолжность(Знач Подпись, ПодписьПечататьДолжность, Дата)
	
	Возврат ПлатежноРасчетныеДокументыПовтИсп.ПолучитьДолжностьСотрудника(Подпись, ПодписьПечататьДолжность, Дата);
	
КонецФункции

&НаСервере
Процедура НалогСборПриИзмененииНаСервере()
	
	НалоговыеНастройки = БухгалтерскийУчет.ПолучитьНастройкиВидаНалоговогоПлатежа(Объект.ВидНалогаИлиПлатежа, Объект.Дата, Объект.Организация);
	
	ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем = НалоговыеНастройки.ЗаполнятьНезаполненныеНулем;
	ТаможенныйПлатеж = НалоговыеНастройки.ТаможенныйПлатеж;
	
	Объект.КодБКНалога = НалоговыеНастройки.КодБКНалога;
	Объект.СтатусСоставителя = НалоговыеНастройки.СтатусСоставителя;
	Объект.ОчередностьПлатежа  = НалоговыеНастройки.ОчередностьПлатежа;
	
	РеквизитыПлатежа = Новый Структура("СтатусСоставителя", Объект.СтатусСоставителя);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, БухгалтерскийУчетКлиентСервер.ПолучитьЗначенияНалоговыхРеквизитов(Новый Структура("СтатусСоставителя", Объект.СтатусСоставителя)));
	
КонецПроцедуры		

&НаСервере
Функция РасшифровкаПлатежаНалогСборПлатежПриИзмененииНаСервере(ДанныеСтрокиНалогСборПлатеж)
	
	 	
	НастройкаНалоговыхРеквизитов = БухгалтерскийУчет.ПолучитьНастройкиНалоговогоПлатежа(ДанныеСтрокиНалогСборПлатеж);
	
	//ПоказательОснования, ПоказательТипа, ИННПлательщика, КПППлательщика, Контрагент, СчетКонтрагента
	ЗаполнитьЗначенияСвойств(НастройкаНалоговыхРеквизитов, БухгалтерскийУчетКлиентСервер.НалоговыеРеквизитыПлатежногоДокумента(НастройкаНалоговыхРеквизитов)); 

	// КодОКТМО, КодОКАТО 
	НастройкаНалоговыхРеквизитов.КодОКАТО = БухгалтерскийУчетКлиентСервер.ОКАТООКТМОПоДате(Объект.Дата, НастройкаНалоговыхРеквизитов.КодОКАТО, НастройкаНалоговыхРеквизитов.КодОКТМО); 
	
	НастройкаНалоговыхРеквизитов.Вставить("СтрокаНазначениеПлатежа", НастройкаНалоговыхРеквизитов.ТекстНазначенияПлатежа);
	
	// ПоказательПериода, КодТаможенногоОргана
	ЗначенияРеквизитов = Новый Структура("ПоказательПериода, ПолеВводаГодПериода, ПолеВводаНомерПериода, ПолеВводаДатаПериода"); 
	ЗначенияРеквизитов.Вставить("ПолеВводаКодТаможенногоОргана", НастройкаНалоговыхРеквизитов.КодТаможенногоОргана);
    БухгалтерскийУчетКлиентСервер.ОпределитьРеквизитыНалоговогоПериода(НастройкаНалоговыхРеквизитов.ПоказательПериода, ТаможенныйПлатеж, Объект.Дата, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(НастройкаНалоговыхРеквизитов, ЗначенияРеквизитов);
	
	Возврат НастройкаНалоговыхРеквизитов;

КонецФункции

&НаКлиенте
Процедура ОткрытьФормуНастройкиНалоговыхРеквизитов(ВыбраннаяСтрокаТаблицы)

	Если ВыбраннаяСтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.РасшифровкаПлатежа.НайтиПоИдентификатору(ВыбраннаяСтрокаТаблицы);
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыПлатежа = Новый Структура("ВидНалогаИлиПлатежа, СтатусСоставителя, КодБКНалога, НалогСборПлатеж,
		|КодОКАТО, ПоказательОснования, ПоказательПериода, ПоказательНомера, ПоказательДаты, ПоказательТипа, Дата");
	ЗаполнитьЗначенияСвойств(РеквизитыПлатежа, Объект);
	ЗаполнитьЗначенияСвойств(РеквизитыПлатежа, ДанныеСтроки); 
	
	РеквизитыПлатежа.Вставить("ТаможенныйПлатеж", ТаможенныйПлатеж);
	РеквизитыПлатежа.Вставить("ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем", ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем);

	НедоступныеРеквизиты = Новый Массив;
	НедоступныеРеквизиты.Добавить("НалогСборПлатеж");
	НедоступныеРеквизиты.Добавить("СтатусСоставителя");
	НедоступныеРеквизиты.Добавить("КодБКНалога");
	
	ПараметрыОткрытия = Новый Структура("РеквизитыПлатежа, НедоступныеРеквизиты", РеквизитыПлатежа, НедоступныеРеквизиты);
	
	ОткрытьФорму("ОбщаяФорма.ВводРеквизитовНалоговогоПлатежа", ПараметрыОткрытия, ЭтаФорма);

КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаВыбораНалоговыхРеквизитовНаКлиенте(НалоговыеРеквизиты)
	
	ДанныеСтроки = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, НалоговыеРеквизиты);
	
	ЗначенияРеквизитов = Новый Структура("КодОКАТО, ПоказательОснования, ПоказательПериода, ПоказательНомера, ПоказательДаты, ПоказательТипа");
	ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, ДанныеСтроки);
	
	ДанныеСтроки.РеквизитыНалоговогоПлатежа = БухгалтерскийУчетКлиентСервер.ПредставлениеНалоговыхРеквизитов(ЗначенияРеквизитов);
    	
	Модифицированность = Истина;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПриИзмененииРеквизитовПолучателяНаКлиенте();
	
	ДанныеСтроки = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	РеквизитыПолучателя = РасшифровкаПлатежаПолучательПриИзмененииНаСервере(ДанныеСтроки.Контрагент, ДанныеСтроки.СчетКонтрагента);
	
	РеквизитыПолучателя.Вставить("РеквизитыПолучателяПлатежа", КорреспондентыКлиентСервер.ПлатежныеРеквизитыКорреспондентаСтрокой(РеквизитыПолучателя));
	
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, РеквизитыПолучателя);
	
КонецПроцедуры	

&НаСервере
Функция РасшифровкаПлатежаПолучательПриИзмененииНаСервере(ДанныеСтрокиКонтрагент, ДанныеСтрокиСчетКонтрагента)
	
	РеквизитыПолучателя = Новый Структура("КонтрагентИНН, КонтрагентКПП, КонтрагентНаименование, КонтрагентБанковскийСчет, КонтрагентНаименованиеБанка, КонтрагентБИКБанка, КонтрагентКорСчетБанка",
	"ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	                                                                                                                                    
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ДанныеСтрокиСчетКонтрагента, ДанныеСтрокиСчетКонтрагента, РеквизитыПолучателя, , Ложь);

	Возврат РеквизитыПолучателя;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуНастройкиРеквизитовПолучателя(ВыбраннаяСтрокаТаблицы)
	
	Если ВыбраннаяСтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Объект.РасшифровкаПлатежа.НайтиПоИдентификатору(ВыбраннаяСтрокаТаблицы);
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	
	ПлатежныеРеквизиты = Новый Структура;
	ПлатежныеРеквизиты.Вставить("БанковскийСчет", 	ДанныеСтроки.КонтрагентБанковскийСчет);
	ПлатежныеРеквизиты.Вставить("БИКБанка", 		ДанныеСтроки.КонтрагентБИКБанка);
	ПлатежныеРеквизиты.Вставить("ИНН", 				ДанныеСтроки.КонтрагентИНН);
	ПлатежныеРеквизиты.Вставить("КорСчетБанка", 	ДанныеСтроки.КонтрагентКорСчетБанка);
	ПлатежныеРеквизиты.Вставить("КПП", 				ДанныеСтроки.КонтрагентКПП);
	ПлатежныеРеквизиты.Вставить("НаименованиеБанка",ДанныеСтроки.КонтрагентНаименованиеБанка);
	ПлатежныеРеквизиты.Вставить("Наименование", 	ДанныеСтроки.КонтрагентНаименование);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗаголовокФормы", 	"Реквизиты получателя платежа"); 
	ПараметрыФормы.Вставить("КлючДанных", "Получатель");
	ПараметрыФормы.Вставить("ПлатежныеРеквизиты", 	ПлатежныеРеквизиты); 

			
	ОткрытьФорму("ОбщаяФорма.РедактированиеПлатежныхРеквизитов", ПараметрыФормы, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораРеквизитовПолучателяНаКлиенте(РеквизитыПолучателя)
	
	ДанныеСтроки = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	
	ДанныеСтроки.КонтрагентБанковскийСчет 		= РеквизитыПолучателя.БанковскийСчет;
	ДанныеСтроки.КонтрагентБИКБанка				= РеквизитыПолучателя.БИКБанка;
	ДанныеСтроки.КонтрагентИНН					= РеквизитыПолучателя.ИНН;
	ДанныеСтроки.КонтрагентКорСчетБанка			= РеквизитыПолучателя.КорСчетБанка;
	ДанныеСтроки.КонтрагентКПП					= РеквизитыПолучателя.КПП;
	ДанныеСтроки.КонтрагентНаименованиеБанка	= РеквизитыПолучателя.НаименованиеБанка;
	ДанныеСтроки.КонтрагентНаименование			= РеквизитыПолучателя.Наименование;

	ДанныеСтроки.РеквизитыПолучателяПлатежа 	= КорреспондентыКлиентСервер.ПлатежныеРеквизитыКорреспондентаСтрокой(ДанныеСтроки);
		
	Модифицированность = Истина;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТекстовыеКолонкиРасшифровки()
	
	ЗначенияРеквизитов = Новый Структура("КодОКАТО, ПоказательОснования, ПоказательПериода, ПоказательНомера, ПоказательДаты, ПоказательТипа");
	РеквизитыПолучателя = Новый Структура("КонтрагентИНН, КонтрагентКПП, КонтрагентНаименование, КонтрагентБанковскийСчет, КонтрагентНаименованиеБанка, КонтрагентБИКБанка, КонтрагентКорСчетБанка");
	
	Для Каждого СтрокаРасшифровки Из Объект.РасшифровкаПлатежа Цикл
		
		//Налоговые реквизиты
	    ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, СтрокаРасшифровки);
		СтрокаРасшифровки.РеквизитыНалоговогоПлатежа = БухгалтерскийУчетКлиентСервер.ПредставлениеНалоговыхРеквизитов(ЗначенияРеквизитов);
		
		//Реквизиты получателя
		ЗаполнитьЗначенияСвойств(РеквизитыПолучателя, СтрокаРасшифровки);
		СтрокаРасшифровки.РеквизитыПолучателяПлатежа = КорреспондентыКлиентСервер.ПлатежныеРеквизитыКорреспондентаСтрокой(РеквизитыПолучателя);
		
	КонецЦикла;	

	
КонецПроцедуры	
 
&НаКлиенте
Процедура ИзменитьСтатусДокумента()
	
	ПлатежноРасчетныеДокументыКлиент.ОткрытьФормуИзмененияСтатусаДокумента(ЭтаФорма);
	
КонецПроцедуры	

&НаСервере
Функция СписокШаблонов()
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	
	СписокШаблонов = Справочники.ШаблоныЗаполненияПП.ПолучитьСписокШаблонов(ДокОбъект);
	
	Возврат СписокШаблонов;
	
КонецФункции

&НаСервере
Процедура НазначениеПлатежа(ВыбранныйШаблон)
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	Шаблон = ВыбранныйШаблон.ПолучитьОбъект();
	Объект.НазначениеПлатежа = Шаблон.СформироватьНазначениеПлатежа(ДокОбъект);
	
КонецПроцедуры

