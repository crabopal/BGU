&НаКлиенте
Процедура НалогСборПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ВидНалогаИлиПлатежа) Тогда
		
		НалогСборПриИзмененииНаСервере(); 
		
	Иначе
		
		ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем = Ложь;
		ТаможенныйПлатеж = Ложь;
		Объект.СтатусСоставителя = "";
		ПолеВводаСтатусСоставителя = "";
		Объект.КодБКНалога = "";
		
	КонецЕсли;
	
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	
КонецПроцедуры

&НаКлиенте
Процедура НалогСборОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Объект.РасшифровкаПлатежа.Количество() > 0 И НЕ ВыбранноеЗначение = Объект.ВидНалогаИлиПлатежа Тогда
		
		СтандартнаяОбработка = Ложь;
		
		НовыйНалог = ВыбранноеЗначение;
		ОписаниеОповещения = Новый ОписаниеОповещения("НалогСборИзменениеЗавершение", ЭтотОбъект, НовыйНалог);

		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Будет выполнена очистка таблицы раздела 2. Продолжить?'"), 
		РежимДиалогаВопрос.ДаНет, 10, КодВозвратаДиалога.Нет, ,КодВозвратаДиалога.Нет);

	КонецЕсли;
	
КонецПроцедуры

