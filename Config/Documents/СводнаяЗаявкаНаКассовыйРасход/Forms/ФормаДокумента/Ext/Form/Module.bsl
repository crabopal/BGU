&НаКлиенте
Процедура ИсточникСредствНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ИсточникиСредствПоКФО = СписокИсточниковСредствПоКФО.НайтиСтроки(Новый Структура("КФО",Объект.КФО));
	Если ИсточникиСредствПоКФО.Количество() > 0 Тогда
		Элементы.ИсточникСредств.СписокВыбора.ЗагрузитьЗначения(ИсточникиСредствПоКФО[0].СписокИсточников.ВыгрузитьЗначения());
	Иначе
		Элементы.ИсточникСредств.СписокВыбора.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	ИсточникиСредствПоКФО = СписокИсточниковСредствПоКФО.НайтиСтроки(Новый Структура("КФО",Объект.КФО));
	
	Если ИсточникиСредствПоКФО.Количество() > 0 Тогда
		СписокИСпоКФО = ИсточникиСредствПоКФО[0].СписокИсточников;
		Если СписокИСпоКФО.НайтиПоЗначению(Объект.ИсточникСредств) = Неопределено Тогда
			Объект.ИсточникСредств = "";
			Если СписокИСпоКФО.Количество() > 0 Тогда
				Объект.ИсточникСредств = СписокИСпоКФО[0].Значение;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Объект.ИсточникСредств = "";
	КонецЕсли;
	
КонецПроцедуры

