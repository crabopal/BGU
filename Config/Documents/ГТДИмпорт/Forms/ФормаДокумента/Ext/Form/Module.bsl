	КонецЕсли;
	
	ЭлементВладелец = Неопределено;
	ДопПараметры.Свойство("Элемент", ЭлементВладелец);
	
	ОткрытьФорму("Справочник.Организации.ФормаВыбора", , ?(ЭлементВладелец <> Неопределено, ЭлементВладелец, ЭтаФорма));
