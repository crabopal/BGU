&НаКлиенте
Процедура ДобавитьИзПоступленияМатериалов(Команда)
	
	ТекущиеДанные = Элементы.Разделы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		НомерРаздела = Объект.Разделы.Количество();
	Иначе
		НомерРаздела = Объект.Разделы.Индекс(Элементы.Разделы.ТекущиеДанные) + 1;
	КонецЕсли;
	
	ПараметрыФормы = новый Структура;
	ПараметрыФормы.Вставить("Отбор", новый Структура("Организация",Объект.Организация));

	ОткрытьФорму("Документ.ПоступлениеМЗ.Форма.ФормаВыбора",
		ПараметрыФормы, ЭтаФорма,
		,,,
		Новый ОписаниеОповещения("ДобавитьИзПоступленияМатериаловЗавершение",
			ЭтотОбъект,
			Новый Структура("НомерРаздела", НомерРаздела)),
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзПоступленияМатериаловЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	НомерРаздела = ДополнительныеПараметры.НомерРаздела;
	
	ДокументПоступления = Результат;
	
	Если ДокументПоступления <> Неопределено Тогда
		ЗаполнитьПоПоступлению(ДокументПоступления, НомерРаздела, "Материалы");
	КонецЕсли;

КонецПроцедуры

