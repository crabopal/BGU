&НаСервере
Процедура ЗаполнитьПоПоступлению(ДокументПоступления, НомерРаздела, ВидНФА) Экспорт
	
	Если НомерРаздела = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДокументаПоставки = ДанныеДокументаПоставки(ДокументПоступления, ВидНФА);
	
	КурсВалютыПоставки = КурсИКратностьДокумента(ДокументПоступления);
	
	ТаблицаПоступления = ДанныеДокументаПоставки.ТаблицаПоступления.Выбрать();
	Пока ТаблицаПоступления.Следующий() Цикл
		НоваяСтрока = Объект[ВидНФА].Добавить();
		НоваяСтрока.НомерРаздела   = НомерРаздела;
		НоваяСтрока.ДокументПартии = ДокументПоступления;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТаблицаПоступления);
		НоваяСтрока.ФактурнаяСтоимость = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
			ТаблицаПоступления.Сумма,
			Новый Структура("Валюта, Курс, Кратность",
				ДанныеДокументаПоставки.ВалютаДокумента,
				КурсВалютыПоставки.Курс,
				КурсВалютыПоставки.Кратность),
			Новый Структура("Валюта, Курс, Кратность",
				Объект.ВалютаТаможеннойСтоимости,
				Объект.КурсВалютыТаможеннойСтоимости,
				Объект.КратностьВалютыТаможеннойСтоимости));
				
		НоваяСтрока.СчетНДС = Счет21012ПоУмолчанию;
	КонецЦикла;
	
	// Рассчитаем новую таможенную стоимость по разделу
	СтрокаРаздела = Объект.Разделы.Получить(НомерРаздела - 1);
	СтрокаРаздела.ТаможеннаяСтоимость 	= 0;
	СтрокаРаздела.СуммаПошлины 			= 0;
	СтрокаРаздела.СуммаНДС 				= 0;
	
	НФАРаздела = Объект.Материалы.НайтиСтроки(Новый Структура("НомерРаздела", НомерРаздела));
	Для Каждого СтрокаТаблицы Из НФАРаздела Цикл
		СтрокаРаздела.ТаможеннаяСтоимость = СтрокаРаздела.ТаможеннаяСтоимость + СтрокаТаблицы.ФактурнаяСтоимость;
	КонецЦикла;
	
	НФАРаздела = Объект.ОсновныеСредства.НайтиСтроки(Новый Структура("НомерРаздела", НомерРаздела));
	Для Каждого СтрокаТаблицы Из НФАРаздела Цикл
		СтрокаРаздела.ТаможеннаяСтоимость = СтрокаРаздела.ТаможеннаяСтоимость + СтрокаТаблицы.ФактурнаяСтоимость;
	КонецЦикла;
	
	ПриИзмененииСтоимостиСтавкиПошлины(НомерРаздела);

КонецПроцедуры

&НаСервереБезКонтекста
Функция КурсИКратностьДокумента(Документ)

	Результат = Новый Структура("Курс, Кратность", 1, 1);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОперацииДокументов.Курс КАК Курс,
	|	ОперацииДокументов.Кратность КАК Кратность
	|ИЗ
	|	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|ГДЕ
	|	ОперацииДокументов.Документ = &Документ";
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Курс      = ?(ЗначениеЗаполнено(Выборка.Курс),      Выборка.Курс,      1);
		Результат.Кратность = ?(ЗначениеЗаполнено(Выборка.Кратность), Выборка.Кратность, 1);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ДанныеДокументаПоставки(Документ, ИмяТаблицы)

	ЧитаемыеДанные = Новый Структура;
	ЧитаемыеДанные.Вставить("ВалютаДокумента");
	Если ИмяТаблицы = "ОсновныеСредства" Тогда
		
		ЧитаемыеДанные.Вставить("ТаблицаПоступления",
			"КапВложения.(
			|		ВнеоборотныйАктив КАК НФА,
			|		Количество КАК Количество,
			|		Сумма КАК Сумма
			|	)");
	Иначе
		ЧитаемыеДанные.Вставить("ТаблицаПоступления",
			"Материалы.(
			|		Номенклатура КАК НФА,
			|		Количество КАК Количество,
			|		Сумма КАК Сумма,
			|		ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|		Номенклатура.СтранаПроисхождения КАК СтранаПроисхождения
			|	)");
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, ЧитаемыеДанные);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьАвансыНаСервере()
	
	Отказ = Ложь;
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ПоВсемКПС", Истина);
	
	Если ЭтаФорма.Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		ПараметрыЗаполнения.Вставить("ПериодОстатков",
			Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая) );
	Иначе
		ПараметрыЗаполнения.Вставить("ПериодОстатков",
			Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая) );
	КонецЕсли;
	
	ДокументОбъект.ЗаполнитьПоОстаткамАвансов(ПараметрыЗаполнения, Отказ);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	Если НЕ Отказ Тогда
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПриИзмененииНоменклатурыСервер(ДанныеСтроки)
	
	ДанныеСтроки.СтранаПроисхождения = ДанныеСтроки.НФА.СтранаПроисхождения;
	ДанныеСтроки.СтавкаНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтроки.НФА, "СтавкаНДС");
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьНомераРазделов(НомерУдаленногоРаздела)

	Для каждого СтрокаНФА Из Объект.Материалы Цикл
		Если СтрокаНФА.НомерРаздела > НомерУдаленногоРаздела Тогда
			СтрокаНФА.НомерРаздела = СтрокаНФА.НомерРаздела - 1;
		КонецЕсли;
	КонецЦикла;

	Для каждого СтрокаНФА Из Объект.ОсновныеСредства Цикл
		Если СтрокаНФА.НомерРаздела > НомерУдаленногоРаздела Тогда
			СтрокаНФА.НомерРаздела = СтрокаНФА.НомерРаздела - 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьИтогиРаздела(НомерРаздела)

	Если НомерРаздела = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеРаздела = Объект.Разделы.Получить(НомерРаздела - 1);
	СтараяТаможеннаяСтоимость = ДанныеРаздела.ТаможеннаяСтоимость;

	ДанныеРаздела.СуммаПошлины = 0;
	ДанныеРаздела.СуммаНДС     = 0;
	ДанныеРаздела.ТаможеннаяСтоимость = 0;

	НФАРаздела = Объект.Материалы.НайтиСтроки(Новый Структура("НомерРаздела", НомерРаздела));
	Для Каждого СтрокаТаблицы Из НФАРаздела Цикл
		ДанныеРаздела.СуммаПошлины        = ДанныеРаздела.СуммаПошлины        + СтрокаТаблицы.СуммаПошлины;
		ДанныеРаздела.СуммаНДС            = ДанныеРаздела.СуммаНДС            + СтрокаТаблицы.СуммаНДС;
		ДанныеРаздела.ТаможеннаяСтоимость = ДанныеРаздела.ТаможеннаяСтоимость + СтрокаТаблицы.ФактурнаяСтоимость;
	КонецЦикла;
	
	НФАРаздела = Объект.ОсновныеСредства.НайтиСтроки(Новый Структура("НомерРаздела", НомерРаздела));
	Для Каждого СтрокаТаблицы Из НФАРаздела Цикл
		ДанныеРаздела.СуммаПошлины        = ДанныеРаздела.СуммаПошлины        + СтрокаТаблицы.СуммаПошлины;
		ДанныеРаздела.СуммаНДС            = ДанныеРаздела.СуммаНДС            + СтрокаТаблицы.СуммаНДС;
		ДанныеРаздела.ТаможеннаяСтоимость = ДанныеРаздела.ТаможеннаяСтоимость + СтрокаТаблицы.ФактурнаяСтоимость;
	КонецЦикла;

	Если СтараяТаможеннаяСтоимость <> ДанныеРаздела.ТаможеннаяСтоимость Тогда
		ПриИзмененииСтоимостиСтавкиПошлины(НомерРаздела);
	Иначе
		Документы.ГТДИмпорт.РассчитатьИтоговыеСуммы(Объект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьНФАРаздела(НомерРаздела)

	МассивСтрок = Объект.Материалы.НайтиСтроки(Новый Структура("НомерРаздела", НомерРаздела));
	Для Каждого СтрокаРаздела Из МассивСтрок Цикл
		Объект.Материалы.Удалить(СтрокаРаздела);
	КонецЦикла;
	
	МассивСтрок = Объект.ОсновныеСредства.НайтиСтроки(Новый Структура("НомерРаздела", НомерРаздела));
	Для Каждого СтрокаРаздела Из МассивСтрок Цикл
		Объект.ОсновныеСредства.Удалить(СтрокаРаздела);
	КонецЦикла;

	Если Объект.Разделы.Количество() > НомерРаздела Тогда
		ПересчитатьНомераРазделов(НомерРаздела);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура РаспределитьНДСИПошлинуПоРазделуСервер(НомерРаздела)

	// Проверим, есть ли что распределять.
	СтрокаРаздела = Объект.Разделы.Получить(НомерРаздела - 1);
	ТаможеннаяСтоимость = СтрокаРаздела.ТаможеннаяСтоимость;
	СуммаПошлины        = СтрокаРаздела.СуммаПошлины;
	СуммаНДС            = СтрокаРаздела.СуммаНДС;

	МассивСтрок = Новый Массив;
	МассивСтрокМатериалы = Объект.Материалы.НайтиСтроки(Новый Структура("НомерРаздела", НомерРаздела));
	Для каждого ЭлементМассива Из МассивСтрокМатериалы Цикл
		МассивСтрок.Добавить(ЭлементМассива);
	КонецЦикла;
	МассивСтрокОС = Объект.ОсновныеСредства.НайтиСтроки(Новый Структура("НомерРаздела", НомерРаздела));
	Для каждого ЭлементМассива Из МассивСтрокОС Цикл
		МассивСтрок.Добавить(ЭлементМассива);
	КонецЦикла;
	
	БазисРаспределения = Новый Массив();

	ВсегоСтоимость = 0;
	Для каждого ЭлементМассива Из МассивСтрок Цикл
		ВсегоСтоимость = ВсегоСтоимость + ЭлементМассива.ФактурнаяСтоимость;
		БазисРаспределения.Добавить(ЭлементМассива.ФактурнаяСтоимость);
	КонецЦикла;

	Всего        = ВсегоСтоимость;
	ВсегоПошлина = СуммаПошлины;
	ВсегоНДС     = СуммаНДС;

	Если ВсегоСтоимость = 0 Тогда

		Если МассивСтрок.Количество() > 0 Тогда
			ТекстСообщения = НСтр("ru='Общая сумма фактурной стоимости раздела %1 нулевая!
				|Распределение невозможно.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомерРаздела);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Товары", "Объект");
		КонецЕсли;

		Возврат;

	КонецЕсли;

	Если не СуммаПошлины = 0 Тогда
		МассивРезультатаРаспределения_Пошлина = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СуммаПошлины, БазисРаспределения);
	КонецЕсли;
	Если не СуммаНДС = 0 Тогда
		МассивРезультатаРаспределения_НДС = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СуммаНДС, БазисРаспределения);
	КонецЕсли;

	Для ИндексСтроки = 0 по МассивСтрок.Количество()-1 Цикл
		Если не СуммаПошлины = 0 Тогда
			МассивСтрок[ИндексСтроки].СуммаПошлины = МассивРезультатаРаспределения_Пошлина[ИндексСтроки];
		Иначе
			МассивСтрок[ИндексСтроки].СуммаПошлины = 0;
		КонецЕсли;
		Если не СуммаНДС = 0 Тогда
			МассивСтрок[ИндексСтроки].СуммаНДС = МассивРезультатаРаспределения_НДС[ИндексСтроки];
		Иначе
			МассивСтрок[ИндексСтроки].СуммаНДС = 0;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьСуммуПошлиныГТД(Знач ДанныеСтроки, Знач ДанныеОбъекта, Знач ВалютаРеглУчета)

	Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.ВалютаДокумента) Тогда
		ТаможеннаяСтоимостьВал = ДанныеСтроки.ТаможеннаяСтоимость;
	ИначеЕсли ДанныеСтроки.ПошлинаВВалюте Тогда
		Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.ВалютаТаможеннойСтоимости) Тогда
			ТаможеннаяСтоимостьВал = ДанныеСтроки.ТаможеннаяСтоимость;
		Иначе
			ТаможеннаяСтоимостьВал = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
					ДанныеСтроки.ТаможеннаяСтоимость,
					Новый Структура("Валюта, Курс, Кратность", 
						ДанныеОбъекта.ВалютаТаможеннойСтоимости, 
						ДанныеОбъекта.КурсВалютыТаможеннойСтоимости, 
						ДанныеОбъекта.КратностьВалютыТаможеннойСтоимости),
					Новый Структура("Валюта, Курс, Кратность", 
						ДанныеОбъекта.ВалютаДокумента, 
						ДанныеОбъекта.Курс, 
						ДанныеОбъекта.Кратность));
		КонецЕсли;
	Иначе
		
		Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.ВалютаТаможеннойСтоимости) Тогда
			ТаможеннаяСтоимостьВал = ДанныеСтроки.ТаможеннаяСтоимость;
			
		Иначе
			ТаможеннаяСтоимостьВал = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
					ДанныеСтроки.ТаможеннаяСтоимость,
					Новый Структура("Валюта, Курс, Кратность", 
						ДанныеОбъекта.ВалютаТаможеннойСтоимости, 
						ДанныеОбъекта.КурсВалютыТаможеннойСтоимости, 
						ДанныеОбъекта.КратностьВалютыТаможеннойСтоимости),
					Новый Структура("Валюта, Курс, Кратность", 
						ДанныеОбъекта.ВалютаРегламентированногоУчета,1,1));
		КонецЕсли;
		
	КонецЕсли;

	Возврат ТаможеннаяСтоимостьВал * ДанныеСтроки.СтавкаПошлины / 100;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьСуммуНДС(Сумма, СуммаВключаетНДС, СтавкаНДС) Экспорт

	Если СуммаВключаетНДС Тогда
		СуммаБезНДС = 100 * Сумма / (100 + СтавкаНДС);
		СуммаНДС = Сумма - СуммаБезНДС;
	Иначе
		СуммаБезНДС = Сумма;
	КонецЕсли;

	Если НЕ СуммаВключаетНДС Тогда
		СуммаНДС = СуммаБезНДС * СтавкаНДС / 100;
	КонецЕсли;
	
	Возврат СуммаНДС;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьСуммуНДСГТД(Знач ДанныеСтроки, Знач ДанныеОбъекта, Знач ВалютаРеглУчета)

	Если ДанныеСтроки.НДСВВалюте Тогда  // Надо все пересчитать в валюту расчетов с таможней.

		Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.ВалютаТаможеннойСтоимости) Тогда
			ТаможеннаяСтоимостьВал = ДанныеСтроки.ТаможеннаяСтоимость;
		Иначе
			ТаможеннаяСтоимостьВал = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
					ДанныеСтроки.ТаможеннаяСтоимость,
					Новый Структура("Валюта, Курс, Кратность", 
						ДанныеОбъекта.ВалютаТаможеннойСтоимости, 
						ДанныеОбъекта.КурсВалютыТаможеннойСтоимости, 
						ДанныеОбъекта.КратностьВалютыТаможеннойСтоимости),
					Новый Структура("Валюта, Курс, Кратность", 
						ДанныеОбъекта.ВалютаДокумента, 
						ДанныеОбъекта.Курс, 
						ДанныеОбъекта.Кратность));			
		КонецЕсли;

		Если ДанныеСтроки.ПошлинаВВалюте Тогда
			СуммаПошлиныВал = ДанныеСтроки.СуммаПошлины;
		Иначе
			Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.ВалютаТаможеннойСтоимости) Тогда
				СуммаПошлиныВал = ДанныеОбъекта.СуммаПошлины;
			Иначе
				СуммаПошлиныВал = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
						ДанныеСтроки.СуммаПошлины,
						Новый Структура("Валюта, Курс, Кратность", 
							ДанныеОбъекта.ВалютаРегламентированногоУчета,1,1),
						Новый Структура("Валюта, Курс, Кратность", 
							ДанныеОбъекта.ВалютаДокумента, 
							ДанныеОбъекта.Курс, 
							ДанныеОбъекта.Кратность));
			КонецЕсли;
		КонецЕсли;

		БазаНДС = ТаможеннаяСтоимостьВал + СуммаПошлиныВал;

	Иначе // Надо все пересчитать в валюту регл. учета.
		
		Если ЗначениеЗаполнено(ДанныеОбъекта.ВалютаТаможеннойСтоимости) Тогда
			
			ТаможеннаяСтоимостьВал = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
					ДанныеСтроки.ТаможеннаяСтоимость,
					Новый Структура("Валюта, Курс, Кратность", 
						ДанныеОбъекта.ВалютаТаможеннойСтоимости, 
						ДанныеОбъекта.КурсВалютыТаможеннойСтоимости, 
						ДанныеОбъекта.КратностьВалютыТаможеннойСтоимости),
					Новый Структура("Валюта, Курс, Кратность", 
						ВалютаРеглУчета,1,1));
		Иначе
			ТаможеннаяСтоимостьВал = ДанныеСтроки.ТаможеннаяСтоимость;
		КонецЕсли;
		
		Если ДанныеСтроки.ПошлинаВВалюте Тогда

			Если НЕ ЗначениеЗаполнено(ДанныеОбъекта.ВалютаДокумента) Тогда
				СуммаПошлиныВал = ДанныеСтроки.СуммаПошлины;
			Иначе
				СуммаПошлиныВал = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
							ДанныеСтроки.СуммаПошлины,
							Новый Структура("Валюта, Курс, Кратность", 
								ДанныеОбъекта.ВалютаДокумента, 
								ДанныеОбъекта.Курс, 
								ДанныеОбъекта.Кратность),
							Новый Структура("Валюта, Курс, Кратность", 
								ВалютаРеглУчета,1,1));
				
			КонецЕсли;

		Иначе
			СуммаПошлиныВал = ДанныеСтроки.СуммаПошлины;
		КонецЕсли;

		БазаНДС = ТаможеннаяСтоимостьВал + СуммаПошлиныВал;

	КонецЕсли;

	Возврат РассчитатьСуммуНДС(БазаНДС, Ложь, УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(ДанныеСтроки.СтавкаНДС));

КонецФункции

&НаКлиенте
Процедура ВопросПересчитатьСуммуНДСЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПриИзмененииСуммыПошлиныСтавкиНДС(Элементы.Разделы.ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПересчитатьСуммуПошлиныНДСЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПриИзмененииСтоимостиСтавкиПошлины(Объект.Разделы.Индекс(Элементы.Разделы.ТекущиеДанные) + 1);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСтоимостиСтавкиПошлины(НомерРаздела, РассчитатьИтоговыеСуммы = Истина)

	СтрокаРаздела = Объект.Разделы.Получить(НомерРаздела - 1);

	ДанныеОбъекта = Новый Структура("ВалютаДокумента,Курс,Кратность,ВалютаТаможеннойСтоимости,КурсВалютыТаможеннойСтоимости,КратностьВалютыТаможеннойСтоимости");
	ЗаполнитьЗначенияСвойств(ДанныеОбъекта, Объект);
	ДанныеОбъекта.Вставить("Ссылка", Объект.Ссылка);
	ДанныеОбъекта.Вставить("ВалютаРегламентированногоУчета", ВалютаРегламентированногоУчета);

	ДанныеСтроки = Новый Структура("ТаможеннаяСтоимость, ПошлинаВВалюте, СтавкаПошлины, СуммаПошлины, НДСВВалюте, СтавкаНДС, СуммаНДС, НомерСтроки");
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаРаздела);

	СтрокаРаздела.СуммаПошлины = РассчитатьСуммуПошлиныГТД(ДанныеСтроки, ДанныеОбъекта, ВалютаРегламентированногоУчета);
	ДанныеСтроки.СуммаПошлины  = СтрокаРаздела.СуммаПошлины;
	СтрокаРаздела.СуммаНДС     = РассчитатьСуммуНДСГТД(ДанныеСтроки, ДанныеОбъекта, ВалютаРегламентированногоУчета);

	РаспределитьНДСИПошлинуПоРазделуСервер(НомерРаздела);
	
	Если РассчитатьИтоговыеСуммы тогда
		Документы.ГТДИмпорт.РассчитатьИтоговыеСуммы(Объект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСуммыПошлиныСтавкиНДС(СтрокаРаздела)

	ДанныеОбъекта = Новый Структура("ВалютаДокумента,Курс,Кратность,ВалютаТаможеннойСтоимости,КурсВалютыТаможеннойСтоимости,КратностьВалютыТаможеннойСтоимости");
	ЗаполнитьЗначенияСвойств(ДанныеОбъекта, Объект);
	ДанныеОбъекта.Вставить("Ссылка", Объект.Ссылка);
	ДанныеОбъекта.Вставить("ВалютаРегламентированногоУчета", ВалютаРегламентированногоУчета);

	ДанныеСтроки = Новый Структура("ТаможеннаяСтоимость, ПошлинаВВалюте, СтавкаПошлины, СуммаПошлины, НДСВВалюте, СтавкаНДС, СуммаНДС, НомерСтроки");
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаРаздела);

	СтрокаРаздела.СуммаНДС = РассчитатьСуммуНДСГТД(ДанныеСтроки, ДанныеОбъекта, ВалютаРегламентированногоУчета);

	РаспределитьНДСИПошлинуПоРазделуСервер(Объект.Разделы.Индекс(СтрокаРаздела) + 1);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКурс(Знач ВалютаДокумента, Дата)
	
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, Дата);
	
КонецФункции

&НаСервере
Процедура КэшироватьСчета30300()
	
	Счет30304 = БухгалтерскийУчет.СчетПоКоду("303.04", Объект.Дата);
	
	Счет30305 = БухгалтерскийУчет.СчетПоКоду("303.05", Объект.Дата);
	
КонецПроцедуры

&НаСервере
Процедура КэшироватьСвойстваСчетаРасчетов()
	
	СвойстваСчетаРасчетов = Новый ФиксированнаяСтруктура(БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Объект.СчетРасчетов));
	
КонецПроцедуры	
	
&НаСервере
Процедура ОбработатьИзменениеФлажкаИмпортИзСтраныТС()
	
	Если Объект.ИмпортИзСтраныТС Тогда
		Объект.РасчетыПоСчету30305 = Ложь;
		
		УстановитьВсеВалютыРубли();
		
		Если СброситьВалютныеФлажкиВТаблице() Тогда
			ПересчитатьВсеСуммыВТаблицахСервер();
		КонецЕсли;
		
	Иначе
		Объект.РасчетыПоСчету30305 = Истина;
	КонецЕсли;
	
	ОчиститьНеиспользуемыеРеквизиты(Истина, Истина);
	
	НастроитьФормуСервер_ИмпортИзСтраныТС();
	
	ОбработатьИзменениеФлажкаРасчетыПоСчету30305();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВсеВалютыРубли()
	
	Объект.ВалютаТаможеннойСтоимости = ВалютаРегламентированногоУчета;
	Объект.КурсВалютыТаможеннойСтоимости 		= 1;
	Объект.КратностьВалютыТаможеннойСтоимости	= 1;
	
	Объект.ВалютаДокумента = ВалютаРегламентированногоУчета;
	Объект.Курс 		= 1;
	Объект.Кратность	= 1;
	
КонецПроцедуры
	
&НаСервере
Функция СброситьВалютныеФлажкиВТаблице()
	
	БылиСброшеныФлажки = Ложь;
	
	Для Каждого СтрокаТаблицы Из Объект.Разделы Цикл
		
		Если СтрокаТаблицы.ПошлинаВВалюте Тогда
			СтрокаТаблицы.ПошлинаВВалюте = Ложь;
			
			БылиСброшеныФлажки = Истина;
		КонецЕсли;
		
		Если СтрокаТаблицы.НДСВВалюте Тогда
			СтрокаТаблицы.НДСВВалюте = Ложь;
			
			БылиСброшеныФлажки = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат БылиСброшеныФлажки;
	
КонецФункции

&НаСервере
Процедура ОчиститьНеиспользуемыеРеквизиты(ИзмененФлажокИмпортИзСтраныТС, ИзмененФлажокРасчетыПоСчету30305)
	
	НеиспользуемыеРеквизиты = Документы.ГТДИмпорт.ПолучитьНеиспользуемыеРеквизиты(
		?(ИзмененФлажокИмпортИзСтраныТС,	Объект.ИмпортИзСтраныТС,	Неопределено),
		?(ИзмененФлажокРасчетыПоСчету30305,	Объект.РасчетыПоСчету30305,	Неопределено));
		
	ОчищающаяСтруктураШапка = Новый Структура(СтрСоединить(НеиспользуемыеРеквизиты.Шапка,","));
	
	// Валюты не очищаем как исключение
	
	Если ОчищающаяСтруктураШапка.Свойство("ВалютаТаможеннойСтоимости") Тогда
		ОчищающаяСтруктураШапка.Удалить("ВалютаТаможеннойСтоимости");
	КонецЕсли;
	
	Если ОчищающаяСтруктураШапка.Свойство("ВалютаДокумента") Тогда
		ОчищающаяСтруктураШапка.Удалить("ВалютаДокумента");
	КонецЕсли;
	
	ОчищающаяСтруктураТабличнаяЧастьРазделы = Новый Структура(СтрСоединить(НеиспользуемыеРеквизиты.ТабличнаяЧастьРазделы,","));
	
	ОчищающаяСтруктураТабличнаяЧастьМЗОС = Новый Структура(СтрСоединить(НеиспользуемыеРеквизиты.ТабличнаяЧастьМЗОС,","));
	
	ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктураШапка);
	
	Для Каждого СтрокаТаблицы Из Объект.Разделы Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктураТабличнаяЧастьРазделы);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из Объект.Материалы Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктураТабличнаяЧастьМЗОС);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктураТабличнаяЧастьМЗОС);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ИмпортИзСтраныТС()
	
	Доступность1 = НЕ Объект.ИмпортИзСтраныТС;
	
	Элементы.СпособЗачетаАванса.ТолькоПросмотр			= НЕ Доступность1;
	Элементы.РасчетыПоСчету30305.ТолькоПросмотр			= НЕ Доступность1;
	Элементы.ВалютаДокумента.ТолькоПросмотр				= НЕ Доступность1;
	Элементы.КурсВалютыДокумента.ТолькоПросмотр			= НЕ Доступность1;
	Элементы.КратностьВалютыДокумента.ТолькоПросмотр	= НЕ Доступность1;
	Элементы.ТаможенныйСбор.ТолькоПросмотр				= НЕ Доступность1;
	Элементы.ТаможенныйСборВал.ТолькоПросмотр			= НЕ Доступность1;
	Элементы.ТаможенныйШтраф.ТолькоПросмотр				= НЕ Доступность1;
	Элементы.ТаможенныйШтрафВал.ТолькоПросмотр			= НЕ Доступность1;
	
	Элементы.НомерГТД.Заголовок = ?(Объект.ИмпортИзСтраныТС, "Номер заявления о ввозе", "Номер ГТД");
	
	Элементы.Контрагент.Заголовок = ?(Объект.ИмпортИзСтраныТС, "Продавец", "Таможня");
	
	НастроитьФормуСервер_РасчетыПоСчету30305();
	
КонецПроцедуры
	
&НаСервере
Процедура НастроитьФормуСервер_РасчетыПоСчету30305()
	
	Доступность2 = НЕ Объект.ИмпортИзСтраныТС И НЕ Объект.РасчетыПоСчету30305;
	
	Элементы.СчетРасчетов.Доступность 		= Доступность2;
	Элементы.СпособЗачетаАванса.Доступность	= Доступность2;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеФлажкаРасчетыПоСчету30305()
	
	КэшироватьСчета30300();
	
	Если Объект.РасчетыПоСчету30305 Тогда
		ОбновлениеПолей = Новый Структура("СчетРасчетов", Счет30305);
		
	Иначе
		ОбновлениеПолей = Новый Структура("
			|СчетРасчетов,
			|Субконто1,
			|Субконто2,
			|Субконто3");
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, ОбновлениеПолей);
	
	Объект.СчетРасчетовНДС = ПолучитьСчетНачисленияНДС(ЭтаФорма);
	
	КэшироватьСвойстваСчетаРасчетов();
	
	УстановитьЗаголовкиИДоступностьСубконто(ЭтаФорма);
	
	НастроитьФормуСервер_РасчетыПоСчету30305();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСчетНачисленияНДС(Форма)
	
	Если Форма.Объект.ИмпортИзСтраныТС Тогда
		Возврат Форма.Счет30304;
		
	ИначеЕсли Форма.Объект.РасчетыПоСчету30305 Тогда
		Возврат Форма.Счет30305;
		
	ИначеЕсли ЗначениеЗаполнено(Форма.Объект.СчетРасчетов) Тогда
		Возврат Форма.Объект.СчетРасчетов;
		
	Иначе
		Возврат "302.00";
	КонецЕсли;
	
КонецФункции


&НаСервере
Процедура УстановитьУсловноеОформление()
	
	НеиспользуемыеРеквизитыИмпортИзСтраныТС = Документы.ГТДИмпорт.ПолучитьНеиспользуемыеРеквизиты(Истина);
	
	//---
	// Установлен флажок ИмпортИзСтраныТС - недоступные поля
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Установлен флажок ИмпортИзСтраныТС - недоступные поля'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ИмпортИзСтраныТС");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "-");

	// Оформляемые поля
	Для Каждого ИмяПоля Из НеиспользуемыеРеквизитыИмпортИзСтраныТС.ТабличнаяЧастьРазделы Цикл
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Разделы" + ИмяПоля);
	КонецЦикла;
		
	Для Каждого ИмяПоля Из НеиспользуемыеРеквизитыИмпортИзСтраныТС.ТабличнаяЧастьМЗОС Цикл
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Материалы" + ИмяПоля);
		
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ОсновныеСредства" + ИмяПоля);
	КонецЦикла;
	
	
	//---
	// Отключены флажки установки валютной суммы таможенных платежей и НДС
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Отключены флажоки установки валютной суммы таможенных платежей и НДС'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ВалютаДокумента");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Условие.ПравоеЗначение = Новый СписокЗначений();
	Условие.ПравоеЗначение.Добавить(Справочники.Валюты.ПустаяСсылка());
	Условие.ПравоеЗначение.Добавить(ВалютаРегламентированногоУчета);

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "RUB");

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("РазделыПошлинаВВалюте");
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("РазделыНДСВВалюте");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИДоступностьСубконто(Форма)
	
	Перем МассивПолей;
	
	Объект = Форма.Объект;
	
	Если Объект.РасчетыПоСчету30305 Тогда
		Счет = Объект.СчетРасчетов;
	Иначе
		Счет = ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
	КонецЕсли;
	
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "Субконто1", "Субконто1", Истина, "Субконто1",
		Форма.СвойстваСчетаРасчетов.ВидСубконто1Обязательный,
		Истина, Истина);
	
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "Субконто2", "Субконто2", Истина, "Субконто2",
		Форма.СвойстваСчетаРасчетов.ВидСубконто2Обязательный,
		Истина, Истина);
	
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "Субконто3", "Субконто3", Истина, "Субконто3",
		Форма.СвойстваСчетаРасчетов.ВидСубконто3Обязательный,
		Истина, Истина);
	
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Счет, Форма, Объект, МассивПолей);
	
КонецПроцедуры

&НаСервере
Процедура СчетРасчетовПриИзмененииСервер()
	
	Если Объект.СчетРасчетов = Счет30305 Тогда
		Объект.РасчетыПоСчету30305 = Истина;
		
		ОбработатьИзменениеФлажкаРасчетыПоСчету30305();
	Иначе
		УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект);
	КонецЕсли;
	
	Объект.СчетРасчетовНДС = ПолучитьСчетНачисленияНДС(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьВсеСуммыВТаблицахСервер()
	
	Для НомерРаздела = 1 По Объект.Разделы.Количество() Цикл
		ПриИзмененииСтоимостиСтавкиПошлины(НомерРаздела, Ложь);
	КонецЦикла;
	
	Документы.ГТДИмпорт.РассчитатьИтоговыеСуммы(Объект);
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьАвтоРасчетСтоимостьПоСчетуФактуре()
	
	АвтоРасчетСтоимостьПоСчетуФактуре = НЕ ЗначениеЗаполнено(Объект.СтоимостьПоСчетуФактуре);
	
	Если АвтоРасчетСтоимостьПоСчетуФактуре Тогда
		УстановитьАвтоЗначениеСтоимостьПоСчетуФактуре(ЭтаФорма);
	Иначе
		СтоимостьПоСчетуФактуре = Объект.СтоимостьПоСчетуФактуре;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьАвтоРасчетСтоимостьПоСчетуФактуре(ТекущийОбъект)
	
	Если АвтоРасчетСтоимостьПоСчетуФактуре Тогда
		НовоеЗначение = 0;
	Иначе
		НовоеЗначение = СтоимостьПоСчетуФактуре;
	КонецЕсли;
	
	ТекущийОбъект.СтоимостьПоСчетуФактуре = НовоеЗначение;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьАвтоЗначениеСтоимостьПоСчетуФактуре(Форма)
	
	Форма.СтоимостьПоСчетуФактуре = ПолучитьАвтоРасчетСтоимостьПоСчетуФактуре(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьАвтоРасчетСтоимостьПоСчетуФактуре(Форма)
	
	// Расчет совпадает с расчетом из книги покупок
	
	Возврат Форма.Объект.ТаможеннаяСтоимость + Форма.Объект.СуммаПошлиныВВалютеТаможеннойСтоимости;
	
КонецФункции
	
&НаКлиенте
Процедура НастроитьФормуКлиент_АвтоРасчетСтоимостьПоСчетуФактуре()
	
	Элементы.СтоимостьПоСчетуФактуре.ТолькоПросмотр = АвтоРасчетСтоимостьПоСчетуФактуре;
	
КонецПроцедуры

//---
// Документы остатков НДС
//---

&НаСервере
Процедура ДокументыОстатковНДС_НастроитьФормуСервер()
	
	УчетНДС.ДокументыОстатковНДС_НастроитьФормуСервер(ЭтаФорма);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ДокументыОстатковНДС_НажатиеКнопкиПоказать(ДекорацияФормы) Экспорт
	
