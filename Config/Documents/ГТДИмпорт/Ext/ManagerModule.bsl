Функция ПолучитьНеиспользуемыеРеквизиты(ИмпортИзСтраныТС = Неопределено, РасчетыПоСчету30305 = Неопределено) Экспорт
	
	Шапка = Новый Массив();
	
	ТабличнаяЧастьРазделы = Новый Массив();
	
	ТабличнаяЧастьМЗОС = Новый Массив();
	
	Если ИмпортИзСтраныТС = Истина Тогда
		//Шапка.Добавить("Контрагент");
		//Шапка.Добавить("Договор");
		Шапка.Добавить("СчетРасчетов");
		Шапка.Добавить("СпособЗачетаАванса");
		//Шапка.Добавить("Субконто1");
		//Шапка.Добавить("Субконто2");
		//Шапка.Добавить("Субконто3");
		//Шапка.Добавить("СпособЗачетаАванса");
		Шапка.Добавить("РасчетыПоСчету30305");
		Шапка.Добавить("ВалютаДокумента");
		Шапка.Добавить("КурсВалютыДокумента");
		Шапка.Добавить("КратностьВалютыДокумента");
		Шапка.Добавить("ТаможенныйСбор");
		Шапка.Добавить("ТаможенныйСборВал");
		Шапка.Добавить("ТаможенныйШтраф");
		Шапка.Добавить("ТаможенныйШтрафВал");
		
		ТабличнаяЧастьРазделы.Добавить("СтавкаПошлины");
		ТабличнаяЧастьРазделы.Добавить("СуммаПошлины");
		ТабличнаяЧастьРазделы.Добавить("ПошлинаВВалюте");
		
		ТабличнаяЧастьМЗОС.Добавить("СуммаПошлины");
	КонецЕсли;
	
	Если РасчетыПоСчету30305 = Истина Тогда
		//Шапка.Добавить("Контрагент");
		//Шапка.Добавить("Договор");
		Шапка.Добавить("СчетРасчетов");
		Шапка.Добавить("СпособЗачетаАванса");
	КонецЕсли;
	
	Если РасчетыПоСчету30305 = Ложь Тогда
		Шапка.Добавить("Субконто1");
		Шапка.Добавить("Субконто2");
		Шапка.Добавить("Субконто3");
	КонецЕсли;
	
	НеиспользуемыеРеквизиты = Новый Структура();
	НеиспользуемыеРеквизиты.Вставить("Шапка",					Шапка);
	НеиспользуемыеРеквизиты.Вставить("ТабличнаяЧастьРазделы",	ТабличнаяЧастьРазделы);
	НеиспользуемыеРеквизиты.Вставить("ТабличнаяЧастьМЗОС",		ТабличнаяЧастьМЗОС);
	
	Возврат НеиспользуемыеРеквизиты;
	
КонецФункции

Процедура РассчитатьИтоговыеСуммы(ДокументОбъект) Экспорт
	
	ВалютаРубль = Константы.ВалютаРегламентированногоУчета.Получить();
	
	// Параметры валюты таможенной стоимости
	ВалютаТС	= ?(ЗначениеЗаполнено(ДокументОбъект.ВалютаТаможеннойСтоимости), ДокументОбъект.ВалютаТаможеннойСтоимости, ВалютаРубль);
	КурсТС		= ?(ЗначениеЗаполнено(ДокументОбъект.ВалютаТаможеннойСтоимости), ДокументОбъект.КурсВалютыТаможеннойСтоимости, 1);
	КратностьТС	= ?(ЗначениеЗаполнено(ДокументОбъект.ВалютаТаможеннойСтоимости), ДокументОбъект.КратностьВалютыТаможеннойСтоимости, 1);
	
	// Параметры валюты пошлины
	ВалютаП		= ?(ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента), ДокументОбъект.ВалютаДокумента, ВалютаРубль);
	КурсП		= ?(ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента), ДокументОбъект.Курс, 1);
	КратностьП	= ?(ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента), ДокументОбъект.Кратность, 1);
	
	// Параметры валюты НДС
	ВалютаНДС		= ВалютаП;
	КурсНДС			= КурсП;
	КратностьНДС	= КратностьП;
	
	ИтогоПошлинаВалютная	= 0;
	ИтогоПошлинаРублевая	= 0;
	ИтогоНДСВалютная		= 0;
	ИтогоНДСРублевая		= 0;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.Разделы Цикл
		Если СтрокаТаблицы["ПошлинаВВалюте"] Тогда
			ИтогоПошлинаВалютная = ИтогоПошлинаВалютная + СтрокаТаблицы["СуммаПошлины"];
		Иначе
			ИтогоПошлинаРублевая = ИтогоПошлинаРублевая + СтрокаТаблицы["СуммаПошлины"];
		КонецЕсли;
		
		Если СтрокаТаблицы["НДСВВалюте"] Тогда
			ИтогоНДСВалютная = ИтогоНДСВалютная + СтрокаТаблицы["СуммаНДС"];
		Иначе
			ИтогоНДСРублевая = ИтогоНДСРублевая + СтрокаТаблицы["СуммаНДС"];
		КонецЕсли;
	КонецЦикла;
	
	// Устанавливаем реквизиты документа
	ЗначенияЗаполнения = Новый Структура();
	
	ЗначенияЗаполнения.Вставить("СуммаПошлиныВВалютеТаможеннойСтоимости",
		Окр(
			// Рублевую сумму пересчитываем по обычному курсу
			?(КурсТС = 0, 0, ИтогоПошлинаРублевая * КратностьТС / КурсТС)
			
			// Валютную сумму пересчитываем по кросс-курсу
			+ ?(КратностьП = 0 ИЛИ КурсТС = 0, 0, (ИтогоПошлинаВалютная * КурсП / КратностьП) * (КратностьТС / КурсТС)),
			2));
		
	ЗначенияЗаполнения.Вставить("СуммаНДСВВалютеТаможеннойСтоимости",
		Окр(
			// Рублевую сумму пересчитываем по обычному курсу
			(ИтогоНДСРублевая * КратностьТС / КурсТС)
			
			// Валютную сумму пересчитываем по кросс-курсу
			+ ?(КратностьНДС = 0 ИЛИ КурсТС = 0, 0, (ИтогоНДСВалютная * КурсНДС / КратностьНДС) * (КратностьТС / КурсТС)),
			2));
		
	ЗначенияЗаполнения.Вставить("СуммаНДСРублевая",
		Окр(
			ИтогоНДСРублевая
			+ ?(КратностьНДС = 0, 0, ИтогоНДСВалютная * КурсНДС / КратностьНДС),
			2));
		
	ЗначенияЗаполнения.Вставить("ТаможеннаяСтоимость", ДокументОбъект.Разделы.Итог("ТаможеннаяСтоимость"));
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияЗаполнения);
	
КонецПроцедуры
	
