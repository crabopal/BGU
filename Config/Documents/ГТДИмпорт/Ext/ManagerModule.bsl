// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу движений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - Таблица значений. Таблица проводок, которые будут сформированы
//  ДокументОбъект - Документ объект. Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура. Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - Таблица значений. Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка. Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
//
// Возвращает флаг ошибки. Если Истина - все ОК, иначе - Ложь
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт
	
	ЕстьСчетКапвложений = ОбслуживаниеКарточекКапвложений.ЭтоСчетКапвложений(ДополнительныеРеквизиты.СчетУчетаОС);
	Для каждого СтрокаТЧ из ДокументОбъект.ОсновныеСредства Цикл
		Если НЕ ЕстьСчетКапвложений ИЛИ НЕ СтрокаТЧ.ОтразитьВКарточкеКапвложений Тогда
			Продолжить;
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаТЧ.КарточкаКапвложений) Тогда	
			ТекстОшибки = СтрШаблон(НСтр("ru = 'В строке %1 таблицы ""Основные средства"" на закладке
			|""Разделы декларации"" включен флажок ""Отражать в карточке капвложений"", но 
			|не заполнена Карточка капвложений'"), СтрокаТЧ.НомерСтроки);
			Возврат Ложь;
		ИначеЕсли ТабДвижений.Найти(СтрокаТЧ.КарточкаКапвложений, "КарточкаКапвложений") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	

		НоваяСтрока = ТабДвижений.Добавить();
		НоваяСтрока.Организация         = ДокументОбъект.Организация;
		НоваяСтрока.КарточкаКапвложений = СтрокаТЧ.КарточкаКапвложений;
		НоваяСтрока.Период              = ДокументОбъект.Дата;
	КонецЦикла;	
	
	Возврат Истина;
КонецФункции	

#КонецОбласти

#Область ПроведениеДокумента

Процедура СформироватьДвиженияПоРегистрам(ДокументОбъект, Отказ) Экспорт
	
	Перем ДатаНачала, ДатаКонца;
	
	РегистрыНеочищаемые = Новый Массив;
	РегистрыНеочищаемые.Добавить(Тип("РегистрБухгалтерииНаборЗаписей.ЖурналПроводокЕПСБУ"));
	РегистрыНеочищаемые.Добавить(Тип("РегистрСведенийНаборЗаписей.ОперацииКапвложений"));
	
	Движения = ДокументОбъект.Движения;
	Для каждого РегистрДвижения из Движения цикл
		Если РегистрыНеочищаемые.Найти(ТипЗнч(РегистрДвижения)) = Неопределено  тогда
			РегистрДвижения.Очистить();
			РегистрДвижения.Записать();
		КонецЕсли;	
	КонецЦикла;
	
	СтруктураШапкиДокумента = ОбщегоНазначенияБГУ.СформироватьСтруктуруШапкиДокументаПоСсылке(ДокументОбъект.Ссылка);
	
	// Значения реквизитов типовой операции
	ТиповаяОперацияСсылка		= БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(ДокументОбъект.Ссылка);
	ПустаяСтруктураРеквизитов	= Справочники.ТиповыеОперации.ПустаяСтруктураДопРеквизитовОперации(ТиповаяОперацияСсылка);
	РеквизитыТиповойОперации	= БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументОбъект.Ссылка, ПустаяСтруктураРеквизитов);
	
	СтруктураШапкиДокумента.Вставить("КПССчетРасчетов", РеквизитыТиповойОперации["КПСОперации"]);
	
	ДанныеДляДвижения = СформироватьДанныеТабличныхЧастей(ДокументОбъект.Ссылка);
	Если ДанныеДляДвижения.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не заполнена табличная часть документа. Документ не проведен!'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ПодготовкаТаблицыКПроведению(СтруктураШапкиДокумента, ДанныеДляДвижения);
	
	// Сформируем движения по регистрам
	Отказ = НЕ СформироватьДвижения(Движения, СтруктураШапкиДокумента, ДанныеДляДвижения);
	
	Если не Отказ тогда
		Для каждого РегистрДвижения из Движения цикл
			Если ТипЗнч(РегистрДвижения) <> Тип("РегистрБухгалтерииНаборЗаписей.ЖурналПроводокЕПСБУ") тогда
				РегистрДвижения.Записать();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция СформироватьДанныеТабличныхЧастей(Ссылка)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПРЕДСТАВЛЕНИЕ(ГТДИмпортМатериалы.НФА) КАК ПредставлениеНФА,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Материалы) КАК ВидЦенности,
	|	ГТДИмпортМатериалы.НФА КАК НФА,
	|	ГТДИмпортМатериалы.Количество КАК Количество,
	|	ГТДИмпортМатериалы.ФактурнаяСтоимость КАК ФактурнаяСтоимость,
	|	ГТДИмпортМатериалы.СуммаПошлины КАК СуммаПошлины,
	|	ГТДИмпортМатериалы.СуммаНДС КАК СуммаНДС,
	|	ГТДИмпортМатериалы.ДокументПартии КАК ДокументПартии,
	|	ГТДИмпортМатериалы.СчетНДС КАК СчетНДС,
	|	ГТДИмпортРазделы.СтавкаНДС КАК СтавкаНДС,
	|	ГТДИмпортРазделы.ПошлинаВВалюте КАК ПошлинаВВалюте,
	|	ГТДИмпортРазделы.НДСВВалюте КАК НДСВВалюте
	|ИЗ
	|	Документ.ГТДИмпорт.Материалы КАК ГТДИмпортМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ГТДИмпорт.Разделы КАК ГТДИмпортРазделы
	|		ПО ГТДИмпортМатериалы.НомерРаздела = ГТДИмпортРазделы.НомерСтроки
	|ГДЕ
	|	ГТДИмпортМатериалы.Ссылка = &Ссылка
	|	И ГТДИмпортРазделы.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(ГТДИмпортОсновныеСредства.НФА),
	|	ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.ОС),
	|	ГТДИмпортОсновныеСредства.НФА,
	|	ГТДИмпортОсновныеСредства.Количество,
	|	ГТДИмпортОсновныеСредства.ФактурнаяСтоимость,
	|	ГТДИмпортОсновныеСредства.СуммаПошлины,
	|	ГТДИмпортОсновныеСредства.СуммаНДС,
	|	ГТДИмпортОсновныеСредства.ДокументПартии,
	|	ГТДИмпортОсновныеСредства.СчетНДС,
	|	ГТДИмпортРазделы.СтавкаНДС,
	|	ГТДИмпортРазделы.ПошлинаВВалюте,
	|	ГТДИмпортРазделы.НДСВВалюте
	|ИЗ
	|	Документ.ГТДИмпорт.ОсновныеСредства КАК ГТДИмпортОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ГТДИмпорт.Разделы КАК ГТДИмпортРазделы
	|		ПО ГТДИмпортОсновныеСредства.НомерРаздела = ГТДИмпортРазделы.НомерСтроки
	|ГДЕ
	|	ГТДИмпортОсновныеСредства.Ссылка = &Ссылка
	|	И ГТДИмпортРазделы.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Процедура ПодготовкаТаблицыКПроведению(СтруктураШапкиДокумента, ТаблицаДокумента)
	
	// Распределим таможенный сбор по строкам таблицы
	ТаблицаДокумента.Колонки.Добавить("ТаможенныйСбор", Новый ОписаниеТипов("Число"));
	ТаблицаДокумента.Колонки.Добавить("ТаможенныйСборВал", Новый ОписаниеТипов("Число"));
	
	ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СтруктураШапкиДокумента.ТаможенныйСбор,
		ТаблицаДокумента, "ТаможенныйСбор", "ФактурнаяСтоимость");
	ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СтруктураШапкиДокумента.ТаможенныйСборВал,
		ТаблицаДокумента, "ТаможенныйСборВал", "ФактурнаяСтоимость");
	
КонецПроцедуры	

Функция СформироватьДвижения(Движения, СтруктураШапкиДокумента, ТаблицаДокумента)
	
	ВходящийНДС = Движения.ВходящийНДС;
	ВходящийНДСКРаспределению = Движения.ВходящийНДСКРаспределению;
	
	Для Каждого ТекСтрока из ТаблицаДокумента Цикл
		Если ТекСтрока.СуммаНДС <> 0 Тогда
			Если СтруктураШапкиДокумента.УчитыватьНДС Тогда
				РегистрНДС = ?(БухгалтерскийУчетКлиентСервер.СчетВИерархии(ТекСтрока.СчетНДС, "210.Р1")
						ИЛИ БухгалтерскийУчетКлиентСервер.СчетВИерархии(ТекСтрока.СчетНДС, "210.Р2"),
					ВходящийНДС,
					ВходящийНДСКРаспределению);
				СформироватьДвиженияПоРН_НДС(ТекСтрока, СтруктураШапкиДокумента, РегистрНДС);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Процедура СформироватьДвиженияПоРН_НДС(ТекСтрока, СтруктураШапкиДокумента, РегДвиженийНДС)
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если ЗначениеЗаполнено(СтруктураШапкиДокумента.ВалютаДокумента) Тогда
		ФактурнаяСтоимостьРуб = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
					ТекСтрока.ФактурнаяСтоимость,
					Новый Структура("Валюта, Курс, Кратность", 
						СтруктураШапкиДокумента.ВалютаДокумента, 
						РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтруктураШапкиДокумента.ВалютаДокумента,СтруктураШапкиДокумента.Дата).Курс, 
						РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтруктураШапкиДокумента.ВалютаДокумента,СтруктураШапкиДокумента.Дата).Кратность),
					Новый Структура("Валюта, Курс, Кратность", 
						ВалютаРегламентированногоУчета,1,1));
	Иначе
		ФактурнаяСтоимостьРуб = ТекСтрока.ФактурнаяСтоимость;
	КонецЕсли;
	
	Если ТекСтрока.ПошлинаВВалюте И ЗначениеЗаполнено(СтруктураШапкиДокумента.ВалютаДокумента) Тогда
		СуммаПошлиныРуб = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
					ТекСтрока.СуммаПошлины,
					Новый Структура("Валюта, Курс, Кратность", 
						СтруктураШапкиДокумента.ВалютаДокумента, 
						РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтруктураШапкиДокумента.ВалютаДокумента,СтруктураШапкиДокумента.Дата).Курс, 
						РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтруктураШапкиДокумента.ВалютаДокумента,СтруктураШапкиДокумента.Дата).Кратность),
					Новый Структура("Валюта, Курс, Кратность", 
						ВалютаРегламентированногоУчета,1,1));						
	Иначе
		СуммаПошлиныРуб = ТекСтрока.СуммаПошлины;
	КонецЕсли;
	
	Если ТекСтрока.НДСВВалюте И ЗначениеЗаполнено(СтруктураШапкиДокумента.ВалютаДокумента) Тогда
		СуммаНДСРуб = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
					ТекСтрока.СуммаНДС,
					Новый Структура("Валюта, Курс, Кратность", 
						СтруктураШапкиДокумента.ВалютаДокумента, 
						РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтруктураШапкиДокумента.ВалютаДокумента,СтруктураШапкиДокумента.Дата).Курс, 
						РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтруктураШапкиДокумента.ВалютаДокумента,СтруктураШапкиДокумента.Дата).Кратность),
					Новый Структура("Валюта, Курс, Кратность", 
						ВалютаРегламентированногоУчета,1,1));								
	Иначе
		СуммаНДСРуб = ТекСтрока.СуммаНДС;
	КонецЕсли;
	
	ТекДвижение = РегДвиженийНДС.Добавить();
	ТекДвижение.Период                = СтруктураШапкиДокумента.Дата;
	ЗаполнитьЗначенияСвойств(ТекДвижение, СтруктураШапкиДокумента); // Учреждение, КВД
	ЗаполнитьЗначенияСвойств(ТекДвижение, ТекСтрока); // ВидЦенности, СтавкаНДС
	ТекДвижение.СчетФактура            = СтруктураШапкиДокумента.Ссылка;
	ТекДвижение.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ТаможенныеПлатежи;
	ТекДвижение.СчетРасчетов           = СтруктураШапкиДокумента.СчетРасчетовНДС;
	ТекДвижение.КПССчетРасчетов = СтруктураШапкиДокумента.КПССчетРасчетов;
	
	ТекДвижение.СчетКредита            = ТекСтрока.СчетНДС;
	ТекДвижение.ОбъектНалогообложения  = ТекСтрока["ДокументПартии"];
	
	ТекДвижение.СуммаБезНДС = ФактурнаяСтоимостьРуб + СуммаПошлиныРуб;
	ТекДвижение.СуммаНДС    = СуммаНДСРуб;
	
КонецПроцедуры

#КонецОбласти

