	АктуальныеДанные.ВидСравнения = ВидСравнения.Больше;
	АктуальныеДанные.Значение = Дата("20221231");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НакладнаяНаОтпускИКМатериалы.Ссылка
	|ИЗ
	|	Документ.НакладнаяНаОтпускИК.Материалы КАК НакладнаяНаОтпускИКМатериалы
	|ГДЕ
	|	НакладнаяНаОтпускИКМатериалы.СчетУчета = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	ИЛИ НакладнаяНаОтпускИКМатериалы.КПС = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	НакладнаяНаОтпускИК.Ссылка
	|ИЗ
	|	Документ.НакладнаяНаОтпускИК КАК НакладнаяНаОтпускИК
	|ГДЕ
	|	НакладнаяНаОтпускИК.СчетУчета = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|";
	
	ДокументыКОбработке = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Счетчик = 0;
