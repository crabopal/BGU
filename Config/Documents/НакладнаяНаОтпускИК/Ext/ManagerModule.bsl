	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НакладнаяНаОтпускИК.Материалы КАК НакладнаяНаОтпускИКМатериалы
	|		ПО НакладнаяНаОтпускИК.Ссылка = НакладнаяНаОтпускИКМатериалы.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ БалансовыеДвиженияДокументов КАК БалансовыеДвиженияДокументов
	|		ПО НакладнаяНаОтпускИКМатериалы.Ссылка = БалансовыеДвиженияДокументов.Ссылка
	|		И НакладнаяНаОтпускИКМатериалы.НомерСтроки = БалансовыеДвиженияДокументов.НомерСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗабалансовыеДвиженияДокументов КАК ЗабалансовыеДвиженияДокументов
	|		ПО НакладнаяНаОтпускИКМатериалы.Ссылка = ЗабалансовыеДвиженияДокументов.Ссылка
	|		И НакладнаяНаОтпускИКМатериалы.НомерСтроки = ЗабалансовыеДвиженияДокументов.НомерСтроки
	|ГДЕ
	|	НакладнаяНаОтпускИК.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер,
	|	НомерСтроки
	|ИТОГИ
	|ПО
	|	Ссылка";
	
	Возврат УправлениеПечатьюБГУ.Напечатать0504205(Запрос, ОбъектыПечати, ИмяМакета);
	
КонецФункции

Функция ПечатьНакладной0315007(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_НакладнаяМ15";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_Накладная0315007");
	
	ОбластьМакетаШапка  = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакетаСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьМакетаИтого  = Макет.ПолучитьОбласть("Итого");
	ОбластьМакетаПодвал = Макет.ПолучитьОбласть("Подвал");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("Счет10850", БухгалтерскийУчет.СписокСчетов("108.50"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Номенклатура,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт КАК Количество,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК Сумма
	|ПОМЕСТИТЬ Проводки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В (&МассивОбъектов)
	|				И СчетКт В (&Счет10850),
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Номер КАК пНомер,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Ссылка КАК Ссылка,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Дата КАК пДата,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Организация КАК Организация,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Организация.НаименованиеПолное КАК пНаименованиеОрганизации,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Организация.КодОКПО КАК пКодОКПО,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Подразделение КАК Подразделение,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Подразделение.Представление КАК пПодразделениеОтправитель,
	|	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК Сотрудники,
	|	НакладнаяНаОтпускИКМатериалы.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА НакладнаяНаОтпускИКМатериалы.Номенклатура.НаименованиеПолное = """"
	|			ТОГДА НакладнаяНаОтпускИКМатериалы.Номенклатура.Наименование
	|		ИНАЧЕ НакладнаяНаОтпускИКМатериалы.Номенклатура.НаименованиеПолное
	|	КОНЕЦ КАК пНоменклатура,
	|	НакладнаяНаОтпускИКМатериалы.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	НакладнаяНаОтпускИКМатериалы.Номенклатура.НаименованиеПолное КАК НоменклатураНаименованиеПолное,
	|	НакладнаяНаОтпускИКМатериалы.Номенклатура.Код КАК пКодАналитики,
	|	НакладнаяНаОтпускИКМатериалы.Номенклатура.НоменклатурныйНомер КАК пНоменклатурныйНомер,
	|	НакладнаяНаОтпускИКМатериалы.Количество КАК пКоличество,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Контрагент.Представление КАК пКонтрагент,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Договор.Представление КАК пДоговор,
	|	НакладнаяНаОтпускИКМатериалы.Номенклатура.ЕдиницаИзмерения.Код КАК пКодЕдиницы,
	|	НакладнаяНаОтпускИКМатериалы.Номенклатура.ЕдиницаИзмерения.Наименование КАК пЕдиница,
	|	ЕСТЬNULL(Проводки.Сумма / НакладнаяНаОтпускИКМатериалы.Количество, 0) КАК пЦена,
	|	ЕСТЬNULL(Проводки.Сумма, 0) КАК пСуммаБезНДС,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК пСтавкаНДС,
	|	0 КАК пСуммаНДС,
	|	ЕСТЬNULL(Проводки.Сумма, 0) КАК пВсего,
	|	ЕСТЬNULL(НакладнаяНаОтпускИКМатериалы.Ссылка.КФО, """") КАК КФО,
	|	ЕСТЬNULL(НакладнаяНаОтпускИКМатериалы.КПС.Представление, """") КАК КПС
	|ИЗ
	|	Документ.НакладнаяНаОтпускИК.Материалы КАК НакладнаяНаОтпускИКМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Проводки КАК Проводки
	|		ПО НакладнаяНаОтпускИКМатериалы.Ссылка = Проводки.Регистратор
	|			И НакладнаяНаОтпускИКМатериалы.Номенклатура = Проводки.Номенклатура
	|			И НакладнаяНаОтпускИКМатериалы.Количество = Проводки.Количество
	|ГДЕ
	|	НакладнаяНаОтпускИКМатериалы.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	пДата,
	|	пНомер,
	|	НакладнаяНаОтпускИКМатериалы.НомерСтроки
	|ИТОГИ ПО
	|	Ссылка";
	
	ПервыйДокумент = Истина;
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаШапка.Следующий() Цикл
	
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	
		ОбластьМакетаШапка.Параметры.Заполнить(ВыборкаШапка);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьМакетаШапка,"пНомер",ВыборкаШапка.пНомер,ВыборкаШапка.Ссылка,Неопределено, Истина);
		ТабличныйДокумент.Вывести(ОбластьМакетаШапка);
		
		КоличествоИтого = 0;
		СуммаБезНДСИтого = 0;
		СуммаНДСИтого = 0;
		ВсегоИтого = 0;
		
		ВыборкаСтроки = ВыборкаШапка.Выбрать();
		Пока ВыборкаСтроки.Следующий() Цикл
		
			ОбластьМакетаСтрока.Параметры.Заполнить(ВыборкаСтроки);
			пКорСчет = ""+ВыборкаШапка.КФО;
			пКорСчет = пКорСчет + ?(ПустаяСтрока(пКорСчет), "", ".") + БухгалтерскиеОперацииПовтИсп.СчетУчетаСсылкаИзНоменклатуры(ВыборкаСтроки.Номенклатура);
			ОбластьМакетаСтрока.Параметры.Заполнить(Новый Структура("пСчетКредита", пКорСчет));
			
			ТабличныйДокумент.Вывести(ОбластьМакетаСтрока);
			
			КоличествоИтого		= КоличествоИтого 	+ ВыборкаСтроки.пКоличество;
			СуммаБезНДСИтого	= СуммаБезНДСИтого	+ ВыборкаСтроки.пСуммаБезНДС;
			СуммаНДСИтого		= СуммаНДСИтого		+ ВыборкаСтроки.пСуммаНДС;
			ВсегоИтого			= ВсегоИтого		+ ВыборкаСтроки.пВсего;
			
		
		КонецЦикла; 
	    СтруктураОбластьМакетаИтого = Новый Структура("пКоличествоИтого,пСуммаБезНДСИтого,пСуммаНДСИтого,пВсегоИтого");
		СтруктураОбластьМакетаИтого.пКоличествоИтого	= КоличествоИтого;
		СтруктураОбластьМакетаИтого.пСуммаБезНДСИтого	= СуммаБезНДСИтого;
		СтруктураОбластьМакетаИтого.пСуммаНДСИтого		= СуммаНДСИтого;
		СтруктураОбластьМакетаИтого.пВсегоИтого		= ВсегоИтого;
		ОбластьМакетаИтого.Параметры.Заполнить(СтруктураОбластьМакетаИтого);
		ТабличныйДокумент.Вывести(ОбластьМакетаИтого);
		
		
		СтруктураОбластьМакетаПодвал = Новый Структура("пКоличествоНаименованийПрописью,пВсегоИтогоПрописью,пСуммаНалогов,пДолжностьРуководитель,пФИОРуководитель,пФИОБухгалтер");
		СтруктураОбластьМакетаПодвал.пКоличествоНаименованийПрописью = ЧислоПрописью(ВыборкаСтроки.Количество(),,"наименование,наименования,наименований,с,,,,,0");
		
		СтруктураОбластьМакетаПодвал.пВсегоИтогоПрописью = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ВсегоИтого,Константы.ВалютаРегламентированногоУчета.Получить());
		СтруктураОбластьМакетаПодвал.пСуммаНалогов = "в том числе сумма НДС: " 
														+ ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СуммаНДСИтого,Константы.ВалютаРегламентированногоУчета.Получить());
		Руководитель = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ВыборкаШапка.Организация, 
																					Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
																					ВыборкаШапка.пДата);
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", 
											Руководитель.ОтветственноеЛицоСсылка,
											ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
		СтруктураОбластьМакетаПодвал.пДолжностьРуководитель = ДанныеСотрудника.Должность;
		СтруктураОбластьМакетаПодвал.пФИОРуководитель = КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																										ДанныеСотрудника.Фамилия,
																										ДанныеСотрудника.Имя,
																										ДанныеСотрудника.Отчество));
		ГлБухгалтер	 = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ВыборкаШапка.Организация, 
																					Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер,
																					ВыборкаШапка.пДата);
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", 
											ГлБухгалтер.ОтветственноеЛицоСсылка,
											ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
		СтруктураОбластьМакетаПодвал.пФИОБухгалтер	  = КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																										ДанныеСотрудника.Фамилия,
																										ДанныеСотрудника.Имя,
																										ДанныеСотрудника.Отчество));
																										
		ОбластьМакетаПодвал.Параметры.Заполнить(СтруктураОбластьМакетаПодвал);																								
		ТабличныйДокумент.Вывести(ОбластьМакетаПодвал);
	
	
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
	
	
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ТекстЗапросаШапкиДляПечатиНакладной0510458()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НакладнаяНаОтпускИК.Ссылка,
	|	НакладнаяНаОтпускИК.Номер КАК Номер,
	|	НакладнаяНаОтпускИК.Дата КАК Дата,
	|	НакладнаяНаОтпускИК.Организация,
	|	НакладнаяНаОтпускИК.ИФО,
	|	НакладнаяНаОтпускИК.Подразделение.Наименование КАК НаименованиеОтправитель,
	|	НакладнаяНаОтпускИК.ЦМО.Сотрудник КАК СотрудникОтправитель,
	|	ВЫБОР
	|		КОГДА НакладнаяНаОтпускИК.Контрагент.НаименованиеСокращенное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА НакладнаяНаОтпускИК.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ НакладнаяНаОтпускИК.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	|						ТОГДА НакладнаяНаОтпускИК.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|					ИНАЧЕ ПРЕДСТАВЛЕНИЕ(НакладнаяНаОтпускИК.Контрагент)
	|				КОНЕЦ
	|		ИНАЧЕ НакладнаяНаОтпускИК.Контрагент.НаименованиеСокращенное
	|	КОНЕЦ КАК НаименованиеПолучатель,
	|	ВЫБОР
	|		КОГДА НакладнаяНаОтпускИК.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА ВЫРАЗИТЬ(НакладнаяНаОтпускИК.Контрагент.ЮридическоеФизическоеЛицо КАК Справочник.ЮридическиеЛица).КодОКПО
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ОКПОПолучатель,
	|	ВЫБОР
	|		КОГДА НакладнаяНаОтпускИК.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА ВЫРАЗИТЬ(НакладнаяНаОтпускИК.Контрагент.ЮридическоеФизическоеЛицо КАК Справочник.ЮридическиеЛица).КодПоРПБС
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КодРПБСПолучателя,
	|	НакладнаяНаОтпускИК.Контрагент.ИНН КАК ИННПолучатель,
	|	НакладнаяНаОтпускИК.Контрагент.КПП КАК КПППолучатель,
	|	ВЫБОР
	|		КОГДА ИсторияКППКонтрагент.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьИзменениеКПППолучатель,
	|	ВЫБОР
	|		КОГДА НакладнаяНаОтпускИК.Перевозчик.НаименованиеСокращенное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА НакладнаяНаОтпускИК.Перевозчик.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ НакладнаяНаОтпускИК.Перевозчик.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
