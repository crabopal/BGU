Функция ПечатьНакладной0504205(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	ПроверятьСуммыРезервов = РезервированиеНФА.ИспользуетсяРезервированиеСумм();
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("Счет10850", БухгалтерскийУчет.СписокСчетов("108.50"));
	Запрос.УстановитьПараметр("ПроверятьСуммыРезервов", ПроверятьСуммыРезервов);
	Запрос.УстановитьПараметр("БалансовыеДвиженияДокументов",
		УправлениеМатериальнымиЗапасами.ДвиженияДокументов(МассивОбъектов));
	Запрос.УстановитьПараметр("ЗабалансовыеДвиженияДокументов",
		УправлениеМатериальнымиЗапасамиПечать.ДвиженияДокументовПриПередачеВПользованиеКонтрагентуЗабаланс(МассивОбъектов));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БалансовыеДвиженияДокументов.Ссылка,
	|	БалансовыеДвиженияДокументов.НомерСтроки,
	|	БалансовыеДвиженияДокументов.Номенклатура,
	|	БалансовыеДвиженияДокументов.ДополнительнаяАналитика,
