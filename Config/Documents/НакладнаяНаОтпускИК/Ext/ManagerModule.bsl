#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Текст запроса таблицы для расчета движений.
// 
// Возвращаемое значение:
//  Строка -  Текст запроса таблицы для расчета движений
Функция ТекстЗапросаТаблицыДляРасчетаДвижений() Экспорт
	Возврат
	"ВЫБРАТЬ
	|	НакладнаяНаОтпускИКМатериалы.Ссылка КАК Ссылка,
	|	НакладнаяНаОтпускИКМатериалы.НомерСтроки КАК НомерСтроки,
	|	НакладнаяНаОтпускИКМатериалы.Номенклатура КАК Номенклатура,
	|	НакладнаяНаОтпускИКМатериалы.Количество КАК Количество,
	|	НакладнаяНаОтпускИКМатериалы.КПС КАК КПС,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.КФО КАК КФО,
	|	НакладнаяНаОтпускИКМатериалы.СчетУчета КАК СчетУчета,
	|	ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) КАК КЭК,
	|	НЕОПРЕДЕЛЕНО КАК ДополнительнаяАналитикаСчета,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Дата КАК Дата,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Организация КАК Организация,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.ИФО КАК ИФО
	|ИЗ
	|	Документ.НакладнаяНаОтпускИК.Материалы КАК НакладнаяНаОтпускИКМатериалы
	|ГДЕ
	|	НакладнаяНаОтпускИКМатериалы.Ссылка В(&МассивОбъектов)";
КонецФункции

// Добавить данные для печати0510448.
// 
// Параметры:
//  ДанныеДляПечати - см. УправлениеПечатьюБГУ.ТаблицаШапкиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448
//  МассивОбъектов - Массив из ДокументСсылка.НакладнаяНаОтпускИК
//  МЗПоСебестоимости - Булево
Процедура ДобавитьДанныеДляПечати0510448(ДанныеДляПечати, МассивОбъектов, МЗПоСебестоимости) Экспорт
	УправлениеМатериальнымиЗапасами.ДобавитьДанныеДляПечати0510448(ДанныеДляПечати, МассивОбъектов,
		ТекстыЗапросовДляПечати0510448(), МЗПоСебестоимости);
КонецПроцедуры

// Добавить данные для печати накладной0510458.
// 
// Параметры:
//  ДанныеДляПечати - см. УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиНакладной0510458
//  МассивОбъектов - Массив из ДокументСсылка.НакладнаяНаОтпускИК
Процедура ДобавитьДанныеДляПечатиНакладной0510458(ДанныеДляПечати, МассивОбъектов) Экспорт
	
	ДанныеОрганизацийПечати = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	ДанныеГруппНФА = УправлениеПечатьюБГУ.ГруппыОбъектовНФА();
	
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ТекстЗапросаШапкиДляПечатиНакладной0510458());
	ЧастиЗапроса.Добавить(ТекстЗапросаТаблицыМатериалыДляПечатиНакладной0510458());
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов()); 
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ДатаСчетов106БезПартии = '20210101';
	Запрос.УстановитьПараметр("Счета106хП", БухгалтерскийУчет.СписокСчетов("106.2П,106.3П", ДатаСчетов106БезПартии));
	Запрос.УстановитьПараметр("ЕдИзмШт", Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796"));
	Запрос.УстановитьПараметр("Счет10856", БухгалтерскийУчет.СчетПоКоду("108.56"));
	СчетаПередачи = Новый Массив;
	Счет25 = БухгалтерскийУчет.СчетПоКоду("25");
	Если ЗначениеЗаполнено(Счет25) Тогда
		СчетаПередачи.Добавить(Счет25);
	КонецЕсли;
	Счет26 = БухгалтерскийУчет.СчетПоКоду("26");
	Если ЗначениеЗаполнено(Счет26) Тогда
		СчетаПередачи.Добавить(Счет26);
	КонецЕсли;
	Запрос.УстановитьПараметр("СчетаПередачи", СчетаПередачи);
	СчетаМЗ = Новый Массив;
	Счет10856 = БухгалтерскийУчет.СчетПоКоду("108.56");
	Если ЗначениеЗаполнено(Счет10856) Тогда
		СчетаМЗ.Добавить(Счет10856);
	КонецЕсли;
	Счет10857 = БухгалтерскийУчет.СчетПоКоду("108.57");
	Если ЗначениеЗаполнено(Счет10857) Тогда
		СчетаМЗ.Добавить(Счет10857);
	КонецЕсли;
	Запрос.УстановитьПараметр("СчетаМЗ", СчетаМЗ);
	Запрос.УстановитьПараметр("СчетУчета", БухгалтерскийУчет.СчетПоКоду("108.56"));
	Запрос.УстановитьПараметр("ВалютаРубль", Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("Передача25", Перечисления.ВидыПередачиИК.ПередачаПоДоговоруАренды);
	Запрос.УстановитьПараметр("Передача26", Перечисления.ВидыПередачиИК.ПередачаПоДоговоруБезвмозмездногоПользования);

	ДвиженияДокументов = УправлениеМатериальнымиЗапасами.ДвиженияДокументов(МассивОбъектов);
	ДвиженияДокументов.Индексы.Добавить("Ссылка, НомерСтроки");
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаШапка = РезультатЗапроса[0].Выбрать();
	ТабличныеЧасти = РезультатЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДвиженияДокументовЗаб = УправлениеМатериальнымиЗапасамиПечать.ДвиженияДокументовПриПередачеВПользованиеКонтрагентуЗабаланс(МассивОбъектов);
	ДвиженияДокументовЗаб.Индексы.Добавить("Ссылка, НомерСтрокиДокумента");
	
	ПроверятьСуммыРезервов = РезервированиеНФА.ИспользуетсяРезервированиеСумм();
	
	Пока ВыборкаШапка.Следующий() Цикл
		СтрокаШапки = ДанныеДляПечати.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаШапки, ВыборкаШапка);
		СтрокаШапки.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка, ВыборкаШапка.Номер);
		
		ДанныеОрганизации = ДанныеОрганизацийПечати.Получить(ВыборкаШапка.Ссылка);
		СтрокаШапки.НаименованиеОрганизации = ДанныеОрганизации.НаименованиеОрганизации;
		СтрокаШапки.НаименованиеОбособленногоПодразделения = ДанныеОрганизации.НаименованиеОбособленногоПодразделения;
		СтрокаШапки.Учредитель = ДанныеОрганизации.Учредитель;
		СтрокаШапки.БюджетНаименование = ДанныеОрганизации.БюджетНаименование;
		СтрокаШапки.КодРПБС = ДанныеОрганизации.КодРПБС;
		СтрокаШапки.КодРПБСПодр = ДанныеОрганизации.КодРПБСОбособленногоПодразделения;
		СтрокаШапки.ГлаваБК = ДанныеОрганизации.ГлаваБК;
		СтрокаШапки.ОКТМО = ДанныеОрганизации.ОКТМО;
		СтрокаШапки.ИННОрганизации = ДанныеОрганизации.ИНН;
		СтрокаШапки.КППОрганизации = ДанныеОрганизации.КПП;
		СтрокаШапки.НаименованиеСтруктурногоПодразделения = ДанныеОрганизации.СтруктурноеПодразделение;
		
		СотрудникиДокумента = Новый Массив;
		Если ЗначениеЗаполнено(ВыборкаШапка.УполномоченноеЛицо) Тогда
			СотрудникиДокумента.Добавить(ВыборкаШапка.УполномоченноеЛицо);
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаШапка.СотрудникОтправитель) Тогда
			СотрудникиДокумента.Добавить(ВыборкаШапка.СотрудникОтправитель);
		КонецЕсли;
		ДанныеСотрудников = Справочники.Сотрудники.ДанныеСотрудников(СотрудникиДокумента,
			"Фамилия, Имя, Отчество, Должность, НаименованиеПолное, Код", ВыборкаШапка.Дата);
		
		Если ЗначениеЗаполнено(ВыборкаШапка.УполномоченноеЛицо) Тогда
			ДанныеСотрудника = ДанныеСотрудников.Получить(ВыборкаШапка.УполномоченноеЛицо);
			СтрокаШапки.УполномоченноеЛицоДолжность = ДанныеСотрудника.Должность;
			СтрокаШапки.УполномоченноеЛицоФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
			СтрокаШапки.УполномоченноеЛицоДатаПодписи = ВыборкаШапка.Дата;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаШапка.СотрудникОтправитель) Тогда
			ДанныеСотрудника = ДанныеСотрудников.Получить(ВыборкаШапка.СотрудникОтправитель);
			СтрокаШапки.ЦМООтправитель = ДанныеСотрудника.НаименованиеПолное;
			СтрокаШапки.ОтпустилДолжность = ДанныеСотрудника.Должность;
			СтрокаШапки.ОтпустилФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
			СтрокаШапки.ОтпустилДатаПодписи = ВыборкаШапка.Дата;
			СтрокаШапки.УчетныйНомерОтправитель = ДанныеСотрудника.Код;
		КонецЕсли;
		
		СтрокаШапки.ОтветственныйДолжность = ДанныеОрганизации.ОтветственныйДолжность;
		СтрокаШапки.ОтветственныйФИО = КорреспондентыКлиентСервер.ФИО(ДанныеОрганизации.ОтветственныйФИО, Истина);
		СтрокаШапки.ОтветственныйТелефон = ДанныеОрганизации.ОтветственныйТелефон;
		СтрокаШапки.ОтветственныйЭлПочта = ДанныеОрганизации.ОтветственныйЭлПочта;
		
		Если ЗначениеЗаполнено(СтрокаШапки.ПолучилФИО) И СтрНайти(СтрокаШапки.ПолучилФИО, ".") = 0 Тогда
			СтрокаШапки.ПолучилФИО = КорреспондентыКлиентСервер.ФИО(СтрокаШапки.ПолучилФИО);
		КонецЕсли;
		
		ВычислятьСуммуИзДвижений = ВыборкаШапка.ВидПередачи <> Перечисления.ВидыПередачиИК.Реализация;
		ВычислятьСуммуИзДвиженийЗабаланс =
			(ВыборкаШапка.ВидПередачи = Перечисления.ВидыПередачиИК.ПередачаПоДоговоруБезвмозмездногоПользования
				Или ВыборкаШапка.ВидПередачи = Перечисления.ВидыПередачиИК.ПередачаПоДоговоруАренды)
			И ((ПроверятьСуммыРезервов И НЕ ВыборкаШапка.Резервировать)
				Или Не ПроверятьСуммыРезервов);
		
		СтрокиНФАПоГруппам = Новый Соответствие;
		ИспользуемыеГруппы = Новый ТаблицаЗначений;
		ИспользуемыеГруппы.Колонки.Добавить("Группа", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ИспользуемыеГруппы.Колонки.Добавить("ПорядокСчета", Новый ОписаниеТипов("Строка"));
		
		СтрокаШапки.Всего = 0;
		
		ТабличныеЧасти.Сбросить();
		Если ТабличныеЧасти.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Тогда
			СтрокиДокумента = ТабличныеЧасти.Выбрать();
		Иначе
			СтрокиДокумента = Неопределено;
		КонецЕсли;
		ДанныеТабличныхЧастейДокумента = Новый Массив;
		Пока СтрокиДокумента <> Неопределено И СтрокиДокумента.Следующий() Цикл
			
			ТекущаяГруппаНФА = ДанныеГруппНФА.Получить(СтрокиДокумента.СчетУчета);
			Если ТекущаяГруппаНФА <> Неопределено Тогда
				ГрупповойСчет = ТекущаяГруппаНФА.Группа;
			Иначе
				ГрупповойСчет = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
			КонецЕсли;
			
			ГруппировочнаяСтрока = СтрокиНФАПоГруппам.Получить(ГрупповойСчет);
			Если ГруппировочнаяСтрока = Неопределено Тогда
				ЗаголовокТабличнойЧасти = УправлениеПечатьюБГУ.ЗаголовокТабличнойЧастиДляПечатиНакладной0510458();
				СтрокаИспользуемыхГрупп = ИспользуемыеГруппы.Добавить();
				СтрокаИспользуемыхГрупп.Группа = ГрупповойСчет;
				Если ТекущаяГруппаНФА <> Неопределено Тогда
					Если СтрДлина(ТекущаяГруппаНФА.Код) > 4 Тогда
						ЗаголовокТабличнойЧасти.КодГруппыНФА = Сред(ТекущаяГруппаНФА.Код, 5);
					Иначе
						ЗаголовокТабличнойЧасти.КодГруппыНФА = ТекущаяГруппаНФА.Код;
					КонецЕсли;
					ЗаголовокТабличнойЧасти.ГруппаНФА    = ТекущаяГруппаНФА.Наименование;
					СтрокаИспользуемыхГрупп.ПорядокСчета = ТекущаяГруппаНФА.Порядок;
				КонецЕсли;
				СоставТабличнойЧасти = ЗаголовокТабличнойЧасти.Состав;
				СтрокиНФАПоГруппам.Вставить(ГрупповойСчет, ЗаголовокТабличнойЧасти);
			Иначе
				СоставТабличнойЧасти = ГруппировочнаяСтрока.Состав;
			КонецЕсли;
	
			НоваяСтрокаСостава = СоставТабличнойЧасти.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСостава, СтрокиДокумента);
			НоваяСтрокаСостава.КодСтроки = СтрокиДокумента.НомерСтроки;
			Если ВычислятьСуммуИзДвижений Тогда
				Если ВычислятьСуммуИзДвиженийЗабаланс Тогда
					ОтборСтрокиДокумента = Новый Структура("Ссылка, НомерСтрокиДокумента",
						ВыборкаШапка.Ссылка, СтрокиДокумента.НомерСтроки);
					СтрокиДвижений = ДвиженияДокументовЗаб.НайтиСтроки(ОтборСтрокиДокумента);
					КолонкаСумма = "СуммаОстаток";
					КолонкаКоличество = "КоличествоОстаток";
				Иначе
					ОтборСтрокиДокумента = Новый Структура("Ссылка, НомерСтроки",
						ВыборкаШапка.Ссылка, СтрокиДокумента.НомерСтроки);
					СтрокиДвижений = ДвиженияДокументов.НайтиСтроки(ОтборСтрокиДокумента);
					КолонкаСумма = "Сумма";
					КолонкаКоличество = "Количество";
				КонецЕсли;
				Если СтрокиДвижений.Количество() > 0 Тогда
					СтрокаСебестоимости = СтрокиДвижений[0];
					НоваяСтрокаСостава.Сумма = СтрокаСебестоимости[КолонкаСумма];
					Если Не ВычислятьСуммуИзДвиженийЗабаланс Тогда
						НоваяСтрокаСостава.Цена = СтрокаСебестоимости.Цена;
					ИначеЕсли СтрокаСебестоимости[КолонкаКоличество] <> 0 Тогда
						НоваяСтрокаСостава.Цена = СтрокаСебестоимости[КолонкаСумма] / СтрокаСебестоимости[КолонкаКоличество];
					КонецЕсли;
				Иначе
					Если НоваяСтрокаСостава.Цена = 0 И НоваяСтрокаСостава.Количество <> 0 Тогда
						НоваяСтрокаСостава.Цена = НоваяСтрокаСостава.Сумма / НоваяСтрокаСостава.Количество;
					КонецЕсли;
				КонецЕсли;

				НоваяСтрокаСостава.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
				НоваяСтрокаСостава.СуммаНДС = 0;
				НоваяСтрокаСостава.Всего = НоваяСтрокаСостава.Сумма;
			КонецЕсли;
			СтрокаШапки.Всего = СтрокаШапки.Всего + НоваяСтрокаСостава.Всего;
		КонецЦикла;
		
		ДанныеТабличныхЧастейДокумента = Новый Массив;
		ИспользуемыеГруппы.Сортировать("ПорядокСчета");
		Для Каждого ИспользуемаяГруппа Из ИспользуемыеГруппы Цикл
			СтрокиГруппы = СтрокиНФАПоГруппам.Получить(ИспользуемаяГруппа.Группа);
			ДанныеТабличныхЧастейДокумента.Добавить(СтрокиГруппы);
		КонецЦикла;
		СтрокаШапки.СоставДокумента = ДанныеТабличныхЧастейДокумента;
		
	КонецЦикла;
	
КонецПроцедуры

// Подготовить таблицу списание материальных запасов по документу.
// 
// Параметры:
//  Документ - ДокументОбъект.НакладнаяНаОтпускИК -  Документ
//  Параметры - Структура, Неопределено -  Параметры:
// * ПоВсемКФО - Булево - 
// * НеПересчитыватьСумму - Булево - 
// * СуммаСписания - Число - 
// * СуммаСписанияНУ - Число - 
// 
// Возвращаемое значение:
//  см. УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу 
Функция ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(Документ, Параметры) Экспорт
	
	ИФО = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ИФО", Документ.ИФО);
	ИФО = ?(ЗначениеЗаполнено(ИФО), ИФО, Документ.ИФО);
	КФО = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "КФО", Документ.КФО);
	КФО = ?(ЗначениеЗаполнено(КФО), КФО, Документ.КФО);
	ЦМО = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ЦМО", Документ.ЦМО);
	ЦМО = ?(ЗначениеЗаполнено(ЦМО), ЦМО, Документ.ЦМО);
	Подразделение = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Подразделение", Документ.Подразделение);
	Подразделение = ?(ЗначениеЗаполнено(Подразделение), Подразделение, Документ.Подразделение);
	
	ЦМОПолучатель = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ЦМОПолучатель",
		Справочники.ЦМО.ПустаяСсылка());
	ПодразделениеПолучатель = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ПодразделениеПолучатель",
		Справочники.Подразделения.ПустаяСсылка());

	Параметры.Вставить("НеПроверятьЗаполнение", Истина);
	ВестиАналитическийУчет = Справочники.Организации.ПолучитьУчетнуюПолитику(Документ.Организация, Документ.Дата)
		.ВедениеАналитическогоУчетаИмуществаКазны;

	ОбщиеПараметрыЦМОПодразделение = Новый Соответствие;

	Результат = УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу();
	Результат.Колонки.Добавить("УчетПоПодразделениям", Новый ОписаниеТипов("Булево"), , );
	Результат.Колонки.Добавить("РазрешитьНеУказыватьПодразделение", Новый ОписаниеТипов("Булево"), , );
	ОбщиеПараметры = Новый Структура;
	ОбщиеПараметры.Вставить("ИмяСписка", "Материалы");
	ОбщиеПараметры.Вставить("СинонимСписка", "Материалы");
	ОбщиеПараметры.Вставить("ИФО", ИФО);
	ОбщиеПараметры.Вставить("КФО", КФО);
	Если Документ.ВидПередачи = Перечисления.ВидыПередачиИК.ПередачаПоДоговоруАренды
			Или Документ.ВидПередачи = Перечисления.ВидыПередачиИК.ПередачаПоДоговоруБезвмозмездногоПользования Тогда
		Если Не ЗначениеЗаполнено(ЦМОПолучатель) Тогда
			ЦМОПолучатель = Документ.ЦМОПриПередаче;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ПодразделениеПолучатель) Тогда
			ПодразделениеПолучатель = Документ.ПодразделениеПриПередаче;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЦМОПолучатель) Тогда
		ЦМОПолучатель = ЦМО;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПодразделениеПолучатель) Тогда
		ПодразделениеПолучатель = Подразделение;
	КонецЕсли;
	ОбщиеПараметры.Вставить("ДопИзмерениеВидСубконто", ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	ОбщиеПараметры.Вставить("НеПересчитыватьСумму", Не ВестиАналитическийУчет);
	
	Для Каждого СтрокаНоменклатуры Из Документ.Материалы Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНоменклатуры);
		НоваяСтрока.СуммаСписания = СтрокаНоменклатуры.Сумма;
		НоваяСтрока.ДопАналитика = СтрокаНоменклатуры.ДополнительнаяАналитикаСчета;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОбщиеПараметры);
		ОбщиеПараметрыУчетаИК = ОбщиеПараметрыЦМОПодразделение.Получить(СтрокаНоменклатуры.СчетУчета);
		Если ОбщиеПараметрыУчетаИК = Неопределено Тогда
			ПараметрыУчетаИК = УправлениеМатериальнымиЗапасами.ПараметрыУчетаИКпоЦМОиПодразделениям(
				СтрокаНоменклатуры.СчетУчета, Документ.Организация, Документ.Дата);
			ОбщиеПараметрыУчетаИК = Новый Структура;	
			Если ПараметрыУчетаИК.УчетПоЦМО Тогда
				ОбщиеПараметрыУчетаИК.Вставить("ДопИзмерение",           ЦМО);
				ОбщиеПараметрыУчетаИК.Вставить("ДопИзмерениеПолучатель", ЦМОПолучатель);
			КонецЕсли;
			Если ПараметрыУчетаИК.УчетПоПодразделениям Тогда
				ОбщиеПараметрыУчетаИК.Вставить("Подразделение",           Подразделение);
				ОбщиеПараметрыУчетаИК.Вставить("ПодразделениеПолучатель", ПодразделениеПолучатель);
			КонецЕсли;
			ОбщиеПараметрыЦМОПодразделение.Вставить(СтрокаНоменклатуры.СчетУчета, ОбщиеПараметрыУчетаИК);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОбщиеПараметрыУчетаИК);
	КонецЦикла;

	Возврат Результат;	
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Параметры заполнения КЭК в табличных частях документа:
//  - Имена табличных частей, содержащих КЭК.
//  - сторона проводки - Дт или Кт.
// 
// Возвращаемое значение:
//  Структура:
//   * ДтКт - Строка - "Дт" или "Кт"
//   * Включать105 - Булево - счета 105 не учитываются, при заполнении
//   * Включать108 - Булево - счета 108 учитываются
//   * ИменаТабличныхЧастей - Массив из Строка - Имена табличных частей содержащих КЭК
Функция ПараметрыЗаполненияКЭК() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ДтКт", "Кт");
	Результат.Вставить("Включать105", Ложь);
	Результат.Вставить("Включать108", Истина);
	ИменаТабличныхЧастей = Новый Массив;
	ИменаТабличныхЧастей.Добавить("Материалы");
	Результат.Вставить("ИменаТабличныхЧастей", ИменаТабличныхЧастей);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", НСтр("ru = 'Накладная на отпуск материалов на сторону'"));
	Запрос.УстановитьПараметр("НомерДокумента",
		ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка.Ссылка, ДокументСсылка.Номер));
	
	НомераТаблиц = Новый Структура;
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц);
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
	УчетНДСРаздельный.ДобавитьДвиженияНеоблагаемыеНДСОперации(ТаблицыДляДвижений, ДокументСсылка);
	БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц)

	НомераТаблиц.Вставить("НаличиеДрагМатериаловВОбъектахНФА", НомераТаблиц.Количество());
	
	Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.Ссылка.Дата КАК Период,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.Ссылка КАК Регистратор,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.ОбъектНФА КАК ОбъектНФА,
	 |	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	 |	&ИмяДокумента КАК Основание,
	 |	&НомерДокумента КАК НомерОснования,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации
	 |ИЗ
	 |	Документ.НакладнаяНаОтпускИК.ДрагоценныеМатериалы КАК НакладнаяНаОтпускИКДрагоценныеМатериалы
	 |ГДЕ
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.Ссылка = &Ссылка
	 |	И НакладнаяНаОтпускИКДрагоценныеМатериалы.МассаДМ > 0
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	НомерСтроки";
	 
	НомераТаблиц.Вставить("НаличиеДрагМатериаловВЛомеИОтходах", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	 "ВЫБРАТЬ
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.Ссылка.Дата КАК Период,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.Ссылка КАК Регистратор,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.ОбъектНФА КАК ОбъектНФА,
	 |	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
	 |	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ЛомДМ) КАК ВидОбъекта,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.ЧистаяМасса КАК ЧистаяМасса,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.ЛигатурнаяМасса КАК ЛигатурнаяМасса,
	 |	&ИмяДокумента КАК Основание,
	 |	&НомерДокумента КАК НомерОснования,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации,
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.ИсточникОбразования КАК ИсточникОбразования
	 |ИЗ
	 |	Документ.НакладнаяНаОтпускИК.ДрагоценныеМатериалы КАК НакладнаяНаОтпускИКДрагоценныеМатериалы
	 |ГДЕ
	 |	НакладнаяНаОтпускИКДрагоценныеМатериалы.Ссылка = &Ссылка
	 |	И НакладнаяНаОтпускИКДрагоценныеМатериалы.МассаДМ = 0
	 |	И НакладнаяНаОтпускИКДрагоценныеМатериалы.ЛигатурнаяМасса + НакладнаяНаОтпускИКДрагоценныеМатериалы.ЧистаяМасса > 0
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	НомерСтроки";
	 
КонецПроцедуры	

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.НакладнаяНаОтпускМ15";
	КомандаПечати.Идентификатор		= "АктПриемаПередачи0510448ПоСебестоимости";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о приеме-передаче НФА'"), "0510448", "61н", "100н");
	КомандаПечати.Порядок			= 1;
	ДопустимыеВидыПередачи = Новый Массив;
	ДопустимыеВидыПередачи.Добавить(Перечисления.ВидыПередачиИК.ПередачаНаСторону);
	ДопустимыеВидыПередачи.Добавить(Перечисления.ВидыПередачиИК.ПередачаПоДоговоруАренды);
	ДопустимыеВидыПередачи.Добавить(Перечисления.ВидыПередачиИК.ПередачаПоДоговоруБезвмозмездногоПользования);
	УправлениеПечатью.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, "ВидПередачи",
		ДопустимыеВидыПередачи, ВидСравнения.ВСписке);
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОСодержанииДрагМатериалов", 5);

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.НакладнаяНаОтпускИК";
	КомандаПечати.Идентификатор		= "Накладная0504205_103н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Накладная на отпуск материалов на сторону'"), "0504205", "52н", "103н", Истина);
	КомандаПечати.Порядок			= 100;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.НакладнаяНаОтпускИК";
	КомандаПечати.Идентификатор		= "Накладная0504205_52н";
