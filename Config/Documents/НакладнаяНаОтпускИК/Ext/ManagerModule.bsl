// Формирует печатные формы объектов
//
// Параметры:
//   МассивОбъектов  - Массив из ДокументСсылка    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - см. УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм
//   ОбъектыПечати    - СписокЗначений из ДокументСсылка   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "Накладная0510458_157н");
	Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = УправлениеПечатьюБГУ.НапечататьНакладнуюНаОтпускМЗ0510458(МассивОбъектов, ОбъектыПечати);
		ПечатнаяФорма.СинонимМакета = УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Накладная на отпуск материальных ценностей на сторону'"), "0510458", "61н", "157н");
	КонецЕсли;

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Накладная0315007") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная0315007",
			"Накладная на отпуск материалов на сторону",
			ПечатьНакладной0315007(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504205_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная0504205_103н",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Накладная на отпуск материалов на сторону'"), "0504205", "52н", "103н"),
			ПечатьНакладной0504205(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Накладная0504205_103н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504205_52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная0504205_52н",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Накладная на отпуск материалов на сторону'"), "0504205", "52н"),
			ПечатьНакладной0504205(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Накладная0504205"));
		
	КонецЕсли;
	
КонецПроцедуры

// Текст запроса таблицы для расчета движений при передаче в пользование контрагенту забаланс.
// 
// Возвращаемое значение:
//  Строка
Функция ТекстЗапросаТаблицыДляРасчетаДвиженийПриПередачеВПользованиеКонтрагентуЗабаланс() Экспорт
	Возврат
	"ВЫБРАТЬ
	|	НакладнаяНаОтпускИКМатериалы.НомерСтроки,
	|	НакладнаяНаОтпускИКМатериалы.Номенклатура,
	|	НакладнаяНаОтпускИКМатериалы.Количество,
	|	НакладнаяНаОтпускИКМатериалы.Сумма,
	|	НакладнаяНаОтпускИКМатериалы.СчетУчета,
	|	НакладнаяНаОтпускИКМатериалы.КПС,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка КАК Ссылка,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Дата КАК Дата,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.КФО КАК КФО,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.ИФО КАК ИФО,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Организация КАК Организация,
	|	СоответствиеСчетов.СчетПередачи КАК ЗабалансовыйСчетУчета,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СоответствиеСчетов.УчетПоКПС, ЛОЖЬ)
	|			ТОГДА НакладнаяНаОтпускИКМатериалы.КПС
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|	КОНЕЦ КАК ЗабалансовыйКПС,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СоответствиеСчетов.УчетПоКЭК, ЛОЖЬ)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|	КОНЕЦ КАК ЗабалансовыйКЭК,
	|	НакладнаяНаОтпускИКМатериалы.Ссылка.Контрагент КАК ЗабалансовыйДополнительнаяАналитикаСчета
	|ИЗ
	|	Документ.НакладнаяНаОтпускИК.Материалы КАК НакладнаяНаОтпускИКМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ СоответствиеСчетов КАК СоответствиеСчетов
	|		ПО (НакладнаяНаОтпускИКМатериалы.Ссылка.ВидПередачи = СоответствиеСчетов.ВидПередачи)
	|		И НакладнаяНаОтпускИКМатериалы.СчетУчета = СоответствиеСчетов.СчетУчета
	|ГДЕ
	|	(НакладнаяНаОтпускИКМатериалы.Ссылка.ВидПередачи = ЗНАЧЕНИЕ(Перечисление.ВидыПередачиИК.ПередачаПоДоговоруБезвмозмездногоПользования)
	|	ИЛИ НакладнаяНаОтпускИКМатериалы.Ссылка.ВидПередачи = ЗНАЧЕНИЕ(Перечисление.ВидыПередачиИК.ПередачаПоДоговоруАренды))
	|	И (НЕ &ПроверятьСуммыРезервов ИЛИ НЕ НакладнаяНаОтпускИКМатериалы.Ссылка.Резервировать)
	|	И НакладнаяНаОтпускИКМатериалы.Ссылка В (&МассивОбъектов)
	|ИТОГИ
	|ПО
	|	Ссылка";
КонецФункции

// Параметры распределения забалансовых движений.
// 
// Возвращаемое значение:
//  см. УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти_Параметры 
Функция ПараметрыРаспределенияЗабалансовыхДвижений() Экспорт
	ПараметрыРаспределенияДвиженийЗаб = УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти_Параметры();
	ПараметрыРаспределенияДвиженийЗаб.ИмяКолонкиКЭК           = "";
	ПараметрыРаспределенияДвиженийЗаб.ИмяКолонкиНоменклатура  = "Номенклатура";
	ПараметрыРаспределенияДвиженийЗаб.ИменаСуммируемыхКолонок = "Количество,Сумма,КоличествоОстаток,СуммаОстаток";
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("НоменклатураСсылка", "Номенклатура");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("СчетУчета", "ЗабалансовыйСчетУчета");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("КПССсылка",          "ЗабалансовыйКПС");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("Количество",         "Количество");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("ДопСубконто",        "ЗабалансовыйДополнительнаяАналитикаСчета");

	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("НоменклатураСсылка", "Номенклатура");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("СчетУчета",          "ЗабалансовыйСчетУчета");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("КПССсылка",          "ЗабалансовыйКПС");
	Возврат ПараметрыРаспределенияДвиженийЗаб
КонецФункции

