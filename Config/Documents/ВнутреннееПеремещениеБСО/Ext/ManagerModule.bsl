#Область ПрограммныйИнтерфейс

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры:
//  ДокументСсылка  - ДокументСсылка.ВнутреннееПеремещениеБСО - ссылка на текущий документ
//  СтруктураДополнительныеСвойства  - Структура - Структура данных для подсистемы печати:
//   * ТаблицыДляДвижений - Структура
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	СчетУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "СчетУчета");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
										И БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчета).УчетПоПодразделениям;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ВнутреннееПеремещениеБСО.Ссылка.Организация КАК Организация,
	|	ВнутреннееПеремещениеБСО.Ссылка.ИФО КАК ИФО,
	|	ВнутреннееПеремещениеБСО.Ссылка.КФО КАК КФО,
	|	ВнутреннееПеремещениеБСО.Ссылка.ЦМООтправитель КАК ЦМО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА ВнутреннееПеремещениеБСО.Ссылка.ПодразделениеОтправитель
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ВнутреннееПеремещениеБСО.БСО КАК БСО,
	|	ВнутреннееПеремещениеБСО.СерияБСО КАК СерияБСО,
	|	ВнутреннееПеремещениеБСО.НомерНачальный КАК НомерНачальный,
	|	ВнутреннееПеремещениеБСО.НомерКонечный КАК НомерКонечный,
	|	ВнутреннееПеремещениеБСО.Количество КАК Количество,
	|	ВнутреннееПеремещениеБСО.Ссылка.Дата КАК Период,
	|	ВнутреннееПеремещениеБСО.НомерСтроки КАК НомерСтрокиДокумента,
	|	ВнутреннееПеремещениеБСО.Ссылка.СчетУчета КАК СчетУчета
	|ИЗ
	|	Документ.ВнутреннееПеремещениеБСО.СоставБСО КАК ВнутреннееПеремещениеБСО
	|ГДЕ
	|	ВнутреннееПеремещениеБСО.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	ВнутреннееПеремещениеБСО.Ссылка.Организация,
	|	ВнутреннееПеремещениеБСО.Ссылка.ИФО,
	|	ВнутреннееПеремещениеБСО.Ссылка.КФОДебета,
	|	ВнутреннееПеремещениеБСО.Ссылка.ЦМОПолучатель,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА ВнутреннееПеремещениеБСО.Ссылка.ПодразделениеПолучатель
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВнутреннееПеремещениеБСО.БСО,
	|	ВнутреннееПеремещениеБСО.СерияБСО,
	|	ВнутреннееПеремещениеБСО.НомерНачальный,
	|	ВнутреннееПеремещениеБСО.НомерКонечный,
	|	ВнутреннееПеремещениеБСО.Количество,
	|	ВнутреннееПеремещениеБСО.Ссылка.Дата,
	|	ВнутреннееПеремещениеБСО.НомерСтроки,
	|	ВнутреннееПеремещениеБСО.Ссылка.СчетДебета
	|ИЗ
	|	Документ.ВнутреннееПеремещениеБСО.СоставБСО КАК ВнутреннееПеремещениеБСО
	|ГДЕ
	|	ВнутреннееПеремещениеБСО.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтрокиДокумента,
	|	ВидДвижения";	
	
	Запрос.УстановитьПараметр("Ссылка", 							ДокументСсылка);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	
	ДвиженияБСО = Запрос.Выполнить().Выгрузить();
	ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументСсылка);
	Если ЗначениеЗаполнено(ДатаПроведения) Тогда
		ДвиженияБСО.ЗаполнитьЗначения(ДатаПроведения, "Период");
	КонецЕсли;
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("ДвиженияБСО",  ДвиженияБСО);
		
КонецПроцедуры // ИнициализироватьДанныеДокумента()

#Область ПроцедурыИФункцииПечати

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВнутреннееПеремещениеБСО";
	КомандаПечати.Идентификатор		= "Накладная0504204_103н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Требование - накладная'"), "0504204", "52н", "103н", Истина);
	КомандаПечати.Порядок			= 1;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВнутреннееПеремещениеБСО";
	КомандаПечати.Идентификатор		= "Накладная0504204_52н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Требование - накладная'"), "0504204", "52н", , Истина);
	КомандаПечати.Порядок			= 2;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);

	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "ТребованиеНакладная0510451_100н", 3);
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандыПечати[КомандыПечати.Количество() - 1]);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВнутреннееПеремещениеБСО";
	КомандаПечати.Идентификатор		= "Накладная0510450";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Накладная на внутреннее перемещение НФА'"), "0510450", "61н");
	КомандаПечати.Порядок			= 4;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВнутреннееПеремещениеБСО";
	КомандаПечати.Идентификатор		= "ТребованиеНакладнаяМ11";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Требование-накладная (М-11)'");
	КомандаПечати.Порядок			= 99;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры:
//   МассивОбъектов  - Массив из ЛюбаяСсылка    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - ТаблицаЗначений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений из ЛюбаяСсылка   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ТребованиеНакладнаяМ11") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ТребованиеНакладнаяМ11","Требование-накладная (М-11)",ПечатьМ11(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504204_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Накладная0504204_103н",
			"Требование-накладная (ф. 0504204) (ред. 103н)",
			ПечатьНакладной0504204(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ТребованиеНакладная0504204_103н"));
		
	КонецЕсли;
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504204_52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Накладная0504204_52н",
			"Требование-накладная (ф. 0504204) (ред. 52н)",
			ПечатьНакладной0504204(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ТребованиеНакладная0504204"));
		
	КонецЕсли;

	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "Накладная0510450");
	Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = УправлениеПечатьюБГУ.Напечатать0510450(МассивОбъектов, ОбъектыПечати, "МЗ");
		ПечатнаяФорма.СинонимМакета = УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Накладная на внутреннее перемещение НФА'"), "0510450", "61н");
	КонецЕсли;
	
КонецПроцедуры // Печать()

#КонецОбласти

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

