#Область ОбработчикиСобытийЭлементовТаблицыФормыСоставПодробно

&НаКлиенте
Процедура СоставПодробноПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ОтборДляРасшифровкиПлатежа(Элемент.ТекущиеДанные.ИдентификаторСтроки);
		ИдентификаторТекущейСтроки = Элемент.ТекущиеДанные.ИдентификаторСтроки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноПередУдалением(Элемент, Отказ)
	УдалитьСтрокиРасшифровкиПлатежа(Элемент.ВыделенныеСтроки);
	РассчитатьРазницуШапкиИИтогаТЧ(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Копирование Тогда
		// скопируем также классификацию
		ТекущаяКлассификация.Очистить();
		СтрокиДляКопирования = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки",ИдентификаторТекущейСтроки));
		Для Каждого Строка Из СтрокиДляКопирования Цикл
			ЗаполнитьЗначенияСвойств(ТекущаяКлассификация.Добавить(),Строка);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		ИдентификаторТекущейСтроки = Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки;
		
		Если Копирование Тогда
			Для Каждого Строка Из ТекущаяКлассификация Цикл
				НоваяСтрокаРасшифровки = Объект.РасшифровкаПлатежа.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаРасшифровки,Строка);
				НоваяСтрокаРасшифровки.ИдентификаторСтроки = Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки;
			КонецЦикла;
			РассчитатьРазницуШапкиИИтогаТЧ(ЭтотОбъект);
		КонецЕсли;
		
		ОтборДляРасшифровкиПлатежа(Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноСотрудникПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СоставПодробно.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Контрагент) 
		И ЗначениеЗаполнено(ТекущиеДанные.Сотрудник) Тогда
		ТекущиеДанные.Контрагент = ПолучитьКонтрагентаСотрудника(ТекущиеДанные.Сотрудник);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Контрагент) Тогда
		Элементы.СоставПодробно.ЗакончитьРедактированиеСтроки(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноСотрудникОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь;
		Элементы.СоставПодробно.ТекущиеДанные.Сотрудник = ВыбранноеЗначение.Ссылка;
		Элементы.СоставПодробно.ТекущиеДанные.Контрагент = ВыбранноеЗначение.Контрагент;
	Иначе
		Элементы.СоставПодробно.ТекущиеДанные.Контрагент = "";
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	РасчетСуммыВыплачено();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРасшифровкаПлатежаПодробно

&НаКлиенте
Процедура РасшифровкаПлатежаПодробноПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Элементы.СоставПодробно.ТекущиеДанные = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не выбран сотрудник!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, , "СоставПодробно", "Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПодробноПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.СоставПодробно.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		Если Копирование Тогда
			РассчитатьИтогСтрокиПоИдентификатору(ТекущиеДанные.ИдентификаторСтроки,"СоставПодробно");
			РассчитатьРазницуШапкиИИтогаТЧ(ЭтотОбъект);
		ИначеЕсли НоваяСтрока Тогда
			Элементы.РасшифровкаПлатежаПодробно.ТекущиеДанные.ИдентификаторСтроки = ТекущиеДанные.ИдентификаторСтроки;
			Элементы.РасшифровкаПлатежаПодробно.ТекущиеДанные.Контрагент = ТекущиеДанные.Контрагент;
			Элементы.РасшифровкаПлатежаПодробно.ТекущиеДанные.ОснованиеПринятияОбязательства = ТекущиеДанные.ОснованиеПринятияОбязательства;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПодробноПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НЕ ОтменаРедактирования Тогда
		
		ТекущиеДанные = Элементы.РасшифровкаПлатежаПодробно.ТекущиеДанные;
		
		Если ТекущиеДанные <> Неопределено Тогда
			РассчитатьИтогСтрокиПоИдентификатору(ТекущиеДанные.ИдентификаторСтроки,"СоставПодробно");
		КонецЕсли;
		
		РассчитатьРазницуШапкиИИтогаТЧ(ЭтотОбъект);
		
		СтрокаСостава = Объект.Состав.НайтиСтроки(Новый Структура("ИдентификаторСтроки",
		Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки));
		ПриПолученииДанныхСтрокиСостава(Объект, СтрокаСостава[0]);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПодробноПослеУдаления(Элемент)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежаПодробно.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Элементы.СоставПодробно.ТекущиеДанные.Сумма = 0;
	Иначе
		РассчитатьИтогСтрокиПоИдентификатору(ТекущиеДанные.ИдентификаторСтроки,"СоставПодробно");
	КонецЕсли;
	
	СтрокаСостава = Объект.Состав.НайтиСтроки(Новый Структура("ИдентификаторСтроки",
												Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки));
	ПриПолученииДанныхСтрокиСостава(Объект, СтрокаСостава[0]);
	
	РассчитатьРазницуШапкиИИтогаТЧ(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПодробноКПСПриИзменении(Элемент)
	ТекущиеДанные = Элементы.РасшифровкаПлатежаПодробно.ТекущиеДанные;
	БухгалтерскийУчетКлиент.ПроверитьОчиститьКЭК(ТекущиеДанные.КПС, ТекущиеДанные.КЭК); 	
КонецПроцедуры

