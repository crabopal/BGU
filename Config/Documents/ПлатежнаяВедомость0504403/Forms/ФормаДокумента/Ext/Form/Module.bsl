&НаКлиенте
Процедура ЗаполнитьРКОЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если ЗаполнитьРКОПоОснованию(ДополнительныеПараметры) Тогда
			ОповеститьОбИзменении(Объект.Ссылка);
			ПоказатьЗначение(, ДополнительныеПараметры);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРКОПоОснованию(ДокументРКО)
	
	ДокументОбъект = ДокументРКО.ПолучитьОбъект();
	
	Попытка
		ДокументОбъект.Заблокировать();
	Исключение
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru='Расходный кассовый ордер занят. Необходимо завершить редактирование.'"));
		Возврат Ложь;
	КонецПопытки;
	
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("ПроверятьОснование", Ложь);
	
	Если ПроверитьЗаполнение() И Записать() Тогда
		
		ДокументОбъект.Заполнить(Объект.Ссылка);
		ДокументОбъект.Записать();
		ДокументОбъект.Разблокировать();
		
		Возврат Истина;
		
	Иначе
		ДокументОбъект.Разблокировать();
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура РасчетСуммыВыплачено()
	Результат = 0;
	Для каждого ТекСтр из Объект.Состав Цикл
		Если ТекСтр.Выплачено Тогда
			Результат = Результат + ТекСтр.Сумма;
		КонецЕсли;
	КонецЦикла;
	Объект.СуммаВыплачено = Результат;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьРазницуШапкиИИтогаТЧ(Форма)
	
	Объект = Форма.Объект;
	Форма.ИтогПоТЧ = Объект.РасшифровкаПлатежа.Итог("Сумма") - Объект.СуммаДокумента;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтветственныхЛиц(Организация, Подразделение, Дата, Руководитель, ГлБухгалтер, Кассир)

	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Руководитель", Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	ГлБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Главный бухгалтер", Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	Кассир = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Кассир", Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;

КонецПроцедуры // УстановитьОтветственныхЛиц()

&НаСервере
Процедура УстановитьПлатежноРасчетныйДокумент()
	СписокОснований = Новый СписокЗначений;
	СписокОснований.Добавить("РасходныйКассовыйОрдер", "Расходный кассовый ордер");
	РасчетноПлатежныйДокумент = ПлатежноРасчетныеДокументы.ВведенныйНаОснованииРасчетноПлатежныйДокумент(Объект.Ссылка, СписокОснований);
	ВключенВОтчетКассира = БухгалтерскийУчет.КассовыйОрдерВключенВОтчетКассира(РасчетноПлатежныйДокумент, ОтчетКассира);
	ОбновитьНадписьПлатежныйДокумент(НадписьРасчетноПлатежныйДокумент, РасчетноПлатежныйДокумент, ОтчетКассира, Элементы);
	УстановитьДоступностьИзменения();
КонецПроцедуры	

&НаСервере
Процедура УстановитьДоступностьИзменения()

	ЭтотОбъект.ТолькоПросмотр = ЭтотОбъект.ТолькоПросмотр ИЛИ ВключенВОтчетКассира; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКонтрагентаСотрудника(Знач СотрудникСсылка)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СотрудникСсылка, "Контрагент");
	
КонецФункции

&НаКлиенте
Процедура УдалитьСтрокиРасшифровкиПлатежа(ВыделенныеСтроки)
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		Строка = Объект.Состав.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		Если Строка <> Неопределено Тогда
			
			ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
			МассивКУдалению = Объект.РасшифровкаПлатежа.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
				Объект.РасшифровкаПлатежа.Удалить(СтрокаКУдалению);
			КонецЦикла;
			
		КонецЕсли
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьКлассификациюСтроки(ДанныеСтроки)
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	
	ПараметрыОткрытия.Вставить("Организация",			Объект.Организация);
	ПараметрыОткрытия.Вставить("ИФО",					Объект.ИФО);
	ПараметрыОткрытия.Вставить("Дата",					Объект.Дата);
	
	ПараметрыОткрытия.Вставить("ИдентификаторСтроки",	ДанныеСтроки.ИдентификаторСтроки);
	ПараметрыОткрытия.Вставить("Сотрудник", 			ДанныеСтроки.Сотрудник);
	ПараметрыОткрытия.Вставить("Контрагент", 			ДанныеСтроки.Контрагент);
	ПараметрыОткрытия.Вставить("АдресВХранилищеВедомостиПоСтроке", АдресВХранилищеВедомостиПоСтроке(ДанныеСтроки.ИдентификаторСтроки));
	
	ПараметрыОткрытия.Вставить("ТолькоПросмотр",		ТолькоПросмотр);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", ЭтотОбъект);
	
	Оповещение = Новый ОписаниеОповещения("РедактированиеСтрокиВыплатыЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.ПлатежнаяВедомость.Форма.РедактированиеСтрокиВыплаты", ПараметрыОткрытия, ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеСтрокиВыплатыЗавершение(РезультатыРедактирования, ДополнительныеПараметры) Экспорт
	
	Если РезультатыРедактирования <> Неопределено И РезультатыРедактирования.Модифицированность Тогда
		
		РедактированиеСтрокиВыплатыЗавершениеНаСервере(РезультатыРедактирования);
		
		РассчитатьИтогСтрокиПоИдентификатору(РезультатыРедактирования.ИдентификаторСтроки,"Состав");
		РассчитатьРазницуШапкиИИтогаТЧ(ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РедактированиеСтрокиВыплатыЗавершениеНаСервере(РезультатыРедактирования)
	
	ИдентификаторСтроки = РезультатыРедактирования.ИдентификаторСтроки;
	
	СтрокиСостава = Объект.Состав.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Если СтрокиСостава.Количество() <> 0 Тогда
		СтрокаСостава = СтрокиСостава[0];
	Иначе
		Возврат;
	КонецЕсли;
	
	РасшифровкаСтроки = ПолучитьИзВременногоХранилища(РезультатыРедактирования.АдресВХранилищеВедомостиПоСтроке);
	
	УдаляемыеСтроки = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		Объект.РасшифровкаПлатежа.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
	ПоляСостава = Новый Массив;
	Для Каждого РеквизитСостава Из Объект.Ссылка.Метаданные().ТабличныеЧасти.Состав.Реквизиты  Цикл
		Если РасшифровкаСтроки.Колонки.Найти(РеквизитСостава.Имя) = Неопределено Тогда
			РасшифровкаСтроки.Колонки.Добавить(РеквизитСостава.Имя, РеквизитСостава.Тип);
		КонецЕсли;
		Если РеквизитСостава.Имя = "Сумма" Тогда
			Продолжить;
		КонецЕсли;
		ПоляСостава.Добавить(РеквизитСостава.Имя);
	КонецЦикла;
	СписокСвойств = СтрСоединить(ПоляСостава, ", ");
	
	Для Каждого СтрокаЗарплаты Из РасшифровкаСтроки Цикл
		ЗаполнитьЗначенияСвойств(СтрокаЗарплаты, СтрокаСостава, СписокСвойств)
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(РасшифровкаСтроки, Объект.РасшифровкаПлатежа);
	
	ПриПолученииДанныхСтрокиСостава(Объект,СтрокаСостава);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриПолученииДанныхСтрокиСостава(Объект, СтрокаСостава)
	
	СтрокиКлассификацииСотрудника = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаСостава.ИдентификаторСтроки));
	
	РасшифровкаКлассификации = "";
	
	Для Каждого СтрокаКлассификацииСотрудника Из СтрокиКлассификацииСотрудника Цикл
		
		Если РасшифровкаКлассификации <> "" Тогда
			РасшифровкаКлассификации = РасшифровкаКлассификации + Символы.ПС;
		КонецЕсли;
		
		РасшифровкаКлассификации = РасшифровкаКлассификации + "(";
		РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.КПС;
		РасшифровкаКлассификации = РасшифровкаКлассификации + "; ";
		РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.КЭК;
		РасшифровкаКлассификации = РасшифровкаКлассификации + "; ";
		РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.КФО;
		
		Если ЗначениеЗаполнено(СтрокаКлассификацииСотрудника.КодЦели) Тогда
			РасшифровкаКлассификации = РасшифровкаКлассификации + "; ";
			РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.КодЦели;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаКлассификацииСотрудника.КодМероприятия) Тогда
			РасшифровкаКлассификации = РасшифровкаКлассификации + "; ";
			РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.КодМероприятия;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаКлассификацииСотрудника.ДопКлассификация) Тогда
			РасшифровкаКлассификации = РасшифровкаКлассификации + "; ";
			РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.ДопКлассификация;
		КонецЕсли;
		
		РасшифровкаКлассификации = РасшифровкаКлассификации + ") ";
		РасшифровкаКлассификации = РасшифровкаКлассификации + Формат(СтрокаКлассификацииСотрудника.Сумма,"ЧДЦ=2; ЧН=");
		
		РасшифровкаКлассификации = РасшифровкаКлассификации + " ";
		
	КонецЦикла;
	
	СтрокаСостава.Классификация = РасшифровкаКлассификации;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДляРасшифровкиПлатежа(ИдентификаторСтроки)
	
	ОтборСтрок = Элементы.РасшифровкаПлатежаПодробно.ОтборСтрок;
	
	Если ОтборСтрок = Неопределено
		ИЛИ НЕ (ОтборСтрок.Свойство("ИдентификаторСтроки")
				И ОтборСтрок.ИдентификаторСтроки = ИдентификаторСтроки) Тогда
		
		Элементы.РасшифровкаПлатежаПодробно.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ИдентификаторСтроки",ИдентификаторСтроки));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИтогСтрокиПоИдентификатору(ИдентификаторСтроки, ИмяТаблицыФормы)
	
	ИтогПоРасшифровке = 0;
	
	ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	МассивСтрокДляСуммирования = Объект.РасшифровкаПлатежа.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого СтрокаСуммирования Из МассивСтрокДляСуммирования Цикл
		ИтогПоРасшифровке = ИтогПоРасшифровке + СтрокаСуммирования.Сумма;
	КонецЦикла;
	
	Элементы[ИмяТаблицыФормы].ТекущиеДанные.Сумма = ИтогПоРасшифровке;
	
КонецПроцедуры

&НаСервере
Функция АдресВХранилищеВедомостиПоСтроке(ИдентификаторСтроки) Экспорт
	Возврат ПоместитьВоВременноеХранилище(Объект.РасшифровкаПлатежа.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки)), УникальныйИдентификатор);
КонецФункции

&НаСервереБезКонтекста
Процедура ОбновитьТекстКлассификацииВсехСтрокТаблицыСостав(ПереданныйОбъект, Валюта = Неопределено)
	Если Валюта = Неопределено Тогда
		Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	Для Каждого СтрокаСостава Из ПереданныйОбъект.Состав Цикл
		ПриПолученииДанныхСтрокиСостава(ПереданныйОбъект,СтрокаСостава);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюТабличныхЧастей(Элементы, Пометка)
	
	Элементы.СоставРедактированиеВДиалоге.Пометка = Пометка;
	Элементы.СоставПодробноРедактированиеВДиалоге.Пометка = Пометка;
	
	Если Пометка Тогда
		Элементы.СтраницыТЧ.ТекущаяСтраница = Элементы.СтраницаСостав;
	Иначе
		Элементы.СтраницыТЧ.ТекущаяСтраница = Элементы.СтраницаПодробно;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСотрудникКонтрагент(ЭлементыФормы, ПоСотрудникам)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставПодробноСотрудник", "Видимость", ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставСотрудник", "Видимость", ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставПодробноКонтрагент", "Видимость", НЕ ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставКонтрагент", "Видимость", НЕ ПоСотрудникам);
	
КонецПроцедуры

#Область ОбработчикиСобытийПроцессыОбработкиДокументов

