#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьНадписьПлатежныйДокумент(Надпись, Документ, ОтчетКассира, Элементы)
	
	Если ЗначениеЗаполнено(Документ) Тогда
		ДанныеКассовойКниги = ?(ЗначениеЗаполнено(ОтчетКассира),
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru=' (%1)'"), ОтчетКассира),
		"");
		ЗаголовокТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Приложение к документу %1%2'"), Документ, ДанныеКассовойКниги);
		Надпись = ЗаголовокТекст;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "Перезаполнить", "Видимость", НЕ ЗначениеЗаполнено(ОтчетКассира));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "НадписьПлатежныйДокумент", "МаксимальнаяШирина", 0);
	Иначе
		Надпись = НСтр("ru='<Создать расходный кассовый ордер...>'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "Перезаполнить", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "НадписьПлатежныйДокумент", "МаксимальнаяШирина", 25);
	КонецЕсли;
	
КонецПроцедуры

