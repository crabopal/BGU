&НаКлиенте
Процедура СоставПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		Элементы.Состав.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		ИдентификаторТекущейСтроки = Элементы.Состав.ТекущиеДанные.ИдентификаторСтроки;
		
		Если Копирование Тогда
			Для Каждого Строка Из ТекущаяКлассификация Цикл
				НоваяСтрокаРасшифровки = Объект.РасшифровкаПлатежа.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаРасшифровки,Строка);
				НоваяСтрокаРасшифровки.ИдентификаторСтроки = Элементы.Состав.ТекущиеДанные.ИдентификаторСтроки;
			КонецЦикла;
			РассчитатьРазницуШапкиИИтогаТЧ(ЭтотОбъект);
		КонецЕсли;
		
		ПриПолученииДанныхСтрокиСостава(Объект, Элементы.Состав.ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если НЕ ОтменаРедактирования Тогда
		
		ДанныеСтроки = Элемент.ТекущиеДанные;
		ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", ДанныеСтроки.ИдентификаторСтроки);
		МассивКИзменению = Объект.РасшифровкаПлатежа.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКИзменению Из МассивКИзменению Цикл
			СтрокаКИзменению.Контрагент = ДанныеСтроки.Контрагент;
		КонецЦикла;
		
	ИначеЕсли НоваяСтрока Тогда
		
		УдалитьСтрокиРасшифровкиПлатежа(Элемент.ВыделенныеСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставСотрудникПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Контрагент) 
		И ЗначениеЗаполнено(ТекущиеДанные.Сотрудник) Тогда
		ТекущиеДанные.Контрагент = ПолучитьКонтрагентаСотрудника(ТекущиеДанные.Сотрудник);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Контрагент) Тогда
		Элементы.Состав.ЗакончитьРедактированиеСтроки(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставСотрудникОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь;
		Элементы.Состав.ТекущиеДанные.Сотрудник = ВыбранноеЗначение.Ссылка;
		Элементы.Состав.ТекущиеДанные.Контрагент = ВыбранноеЗначение.Контрагент;
	Иначе
		Элементы.Состав.ТекущиеДанные.Контрагент = "";
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура СоставПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	РасчетСуммыВыплачено();
