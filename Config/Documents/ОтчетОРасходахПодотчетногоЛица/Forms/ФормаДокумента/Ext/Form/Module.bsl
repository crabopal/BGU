&НаКлиенте
Процедура ТоварыРаботыУслугиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ТоварыРаботыУслугиОтражениеВУчете" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ИзменитьВыделенные = Ложь;
		ИзменитьВсе = Ложь;
		
		Если НЕ Элемент.ТекущиеДанные.ПоДокументу Тогда
			ОткрытьФормуНастройкиОтраженияВУчете(Элемент.ТекущиеДанные);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.СуммаФакт = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиЦенаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.СуммаФакт = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиСуммаФактПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Количество = 0 Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
	
	ТекущиеДанные.Цена = ТекущиеДанные.СуммаФакт / ТекущиеДанные.Количество;
	
КонецПроцедуры

