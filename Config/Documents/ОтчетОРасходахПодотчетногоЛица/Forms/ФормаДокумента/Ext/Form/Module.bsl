	|		ИНАЧЕ ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт
	|	КОНЕЦ");
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Контрагент", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Сотрудник, "Контрагент"));
	Запрос.УстановитьПараметр("ВалютаРуб", ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета());
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Запрос.УстановитьПараметр("РасчетыСПодотчетнымиЛицами", БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("208.00"));
	Запрос.УстановитьПараметр("СчетаДС", БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("201.00,210.03,304.00,000"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Строки = Объект.Получено.НайтиСтроки(Новый Структура("ДокументАванса", Выборка.Регистратор));
		
		Если Строки.Количество() > 0 Тогда
			
			ЗаполнитьЗначенияСвойств(Строки[0], Выборка);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Строка Из Объект.ДенежныеОбязательства Цикл
		Строка.Отклонение = Строка.СуммаПоОтчету - Строка.СуммаПоОснованию;
		Строка.ОтклонениеБО = Строка.СуммаПоОтчету - Строка.СуммаБОПоОснованию;
	КонецЦикла;
	
	ОбновитьТекстыЗаголовковВСтрокахТаблицРасходов();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстыЗаголовковВСтрокахТаблицРасходов()
	
	Для Каждого ТекущаяСтрока Из Объект.Суточные Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыСуточные(ТекущаяСтрока);
		ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыРасходов(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, Объект.Подразделение, ТекущаяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.Проезд Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыПроезд(ТекущаяСтрока);
		ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыРасходов(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, Объект.Подразделение, ТекущаяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.Проживание Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыПроживание(ТекущаяСтрока);
		ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыРасходов(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, Объект.Подразделение, ТекущаяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.ПрочиеРасходы Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыПрочиеРасходы(ТекущаяСтрока);
		ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыРасходов(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, Объект.Подразделение, ТекущаяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.ТоварыРаботыУслуги Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыТоварыРаботыУслуги(ТекущаяСтрока);
		ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыРасходов(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, Объект.Подразделение, ТекущаяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.ДенежныеОбязательства Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыДенежныеОбязательства(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыСуточные(СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокДеньВыезда 		= НСтр("ru = 'выезд:'");
	СтрокаТаблицы.ЗаголовокДеньПриезда 		= НСтр("ru = 'приезд:'");
	СтрокаТаблицы.ЗаголовокКоличествоДней 	= НСтр("ru = 'дней:'");
	
	ЗаполнитьТекстЗаголовковСумм(СтрокаТаблицы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыПроезд(СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокДатаОтправления = НСтр("ru = 'отправление:'");
	СтрокаТаблицы.ЗаголовокДатаПрибытия = НСтр("ru = 'прибытие:'");
	СтрокаТаблицы.ЗаголовокДатаПересеченияГраницы = НСтр("ru = 'пересеч. границы:'");
	
	ЗаполнитьТекстЗаголовковСумм(СтрокаТаблицы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыПроживание(СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокДатаЗаезда 		= НСтр("ru = 'заезд:'");
	СтрокаТаблицы.ЗаголовокДатаВыезда 		= НСтр("ru = 'выезд:'");
	СтрокаТаблицы.ЗаголовокКоличествоДней 	= НСтр("ru = 'дней:'");
	
	ЗаполнитьТекстЗаголовковСумм(СтрокаТаблицы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыПрочиеРасходы(СтрокаТаблицы)
	
	ЗаполнитьТекстЗаголовковСумм(СтрокаТаблицы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыТоварыРаботыУслуги(СтрокаТаблицы)
	
	ЗаполнитьТекстЗаголовковСумм(СтрокаТаблицы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыРасходов(УчетнаяПолитика, Подразделение, СтрокаТаблицы)
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "ПоДокументу") Тогда
		Если СтрокаТаблицы.ПоДокументу Тогда
			СтрокаТаблицы.ОтражениеВУчете = "По приходному документу";
			СтрокаТаблицы.УточнитьКЭК340 = ТипЗнч(СтрокаТаблицы.ПриходныйДокумент) = Тип("ДокументСсылка.ПриходныйОрдерФондовый");
			Возврат;
		Иначе
			СтрокаТаблицы.УточнитьКЭК340 = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ПоляФормы = Новый Структура("КПС, КЭК, Подразделение, Счет, Субконто1, Субконто2, Субконто3",
		"КПСДт", "КЭКДт", "ПодразделениеДт", "СчетДебета", "СубконтоДебета1", "СубконтоДебета2", "СубконтоДебета3");
	
	ОтражатьВНалоговомУчете = УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаТаблицы.КФО);
	
	ЕстьКЭК = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "КЭКДт");
	
	ЕстьНДС = Ложь;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "ПредъявленСФ")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "СуммаНДС") Тогда
		ЕстьНДС = СтрокаТаблицы.ПредъявленСФ И СтрокаТаблицы.СуммаНДС > 0;
	КонецЕсли;
	
	ПараметрыОбъекта = Новый Структура;
	ПараметрыОбъекта.Вставить("ОтражатьВНалоговомУчете", ОтражатьВНалоговомУчете);
	ПараметрыОбъекта.Вставить("ОтражатьВУСНДоходыМинусРасходы", Ложь);
	ПараметрыОбъекта.Вставить("ЕстьНДС", ЕстьНДС);
	ПараметрыОбъекта.Вставить("ЕстьКПС",
		НЕ СтрокаТаблицы.КПС = СтрокаТаблицы.КПСДт И ЗначениеЗаполнено(СтрокаТаблицы.КПСДт));
	ПараметрыОбъекта.Вставить("ЕстьКЭК",
		ЕстьКЭК И НЕ СтрокаТаблицы.КЭК = СтрокаТаблицы.КЭКДт И ЗначениеЗаполнено(СтрокаТаблицы.КЭКДт));
	ПараметрыОбъекта.Вставить("ЕстьПодразделение",
		НЕ Подразделение = СтрокаТаблицы.ПодразделениеДт И ЗначениеЗаполнено(СтрокаТаблицы.ПодразделениеДт));
	Если СтрокаТаблицы.Свойство("ОтразитьВКарточкеКапвложений") Тогда
		ПараметрыОбъекта.Вставить("ОтразитьВКарточкеКапвложений", СтрокаТаблицы.ОтразитьВКарточкеКапвложений);
		ПараметрыОбъекта.Вставить("КарточкаКапвложений", СтрокаТаблицы.КарточкаКапвложений);
	КонецЕсли;
	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, ПараметрыОбъекта, ПоляФормы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьТекстЗаголовковСумм(ТекущаяСтрока)
	
	ТекущаяСтрока.ЗаголовокСуммаПлан 	= НСтр("ru = 'плановые:'");
	ТекущаяСтрока.ЗаголовокСуммаФакт 	= НСтр("ru = 'фактические:'");
	ТекущаяСтрока.ЗаголовокСуммаПринято = НСтр("ru = 'принятые:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитов(Форма)
	
	УстановитьВидимостьРеквизитовПоОснованию(Форма);
	
	УстановитьВидимостьРеквизитовЗаГраницы(Форма);
	
	УстановитьВидимостьРеквизитовСпособВыдачиДС(Форма);
	
	УстановитьВидимостьСтрокиКурсыВалют(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитовПоОснованию(Форма)
	
	Элементы = Форма.Элементы;
	
	ЭтоКомандировка = Форма.ЭтоКомандировка;
	ЭтоЗакупка = Форма.ЭтоЗакупка;
	ЭтоЗакупкаЧерезПодотчетноеЛицо = Форма.ЭтоЗакупкаЧерезПодотчетноеЛицо;
	ЭтоКрайнийСевер = Форма.ЭтоКрайнийСевер;
	ОснованиеЗаполнено = ЗначениеЗаполнено(Форма.Объект.ДокументОснование);
	
	РеквизитыПоКомандировке = Новый Массив;
	РеквизитыПоКомандировке.Добавить("ОсобыйСтатус");
	РеквизитыПоКомандировке.Добавить("ТерриторияКомандирования");
	РеквизитыПоКомандировке.Добавить("ОтчетОВыполненнойРаботе");
	РеквизитыПоКомандировке.Добавить("СодержаниеЗадания");
	РеквизитыПоКомандировке.Добавить("РезультатВыполненнойРаботы");
	РеквизитыПоКомандировке.Добавить("Суточные");
	РеквизитыПоКомандировке.Добавить("Проезд");
	РеквизитыПоКомандировке.Добавить("Проживание");
	РеквизитыПоКомандировке.Добавить("ПрочиеРасходы");
	РеквизитыПоКомандировке.Добавить("НадписьСпособВыдачиДенежныхСредств");
	РеквизитыПоКомандировке.Добавить("РазбитьПоВалютам");
	РеквизитыПоКомандировке.Добавить("НадписьКурсыВалют");
	РеквизитыПоКомандировке.Добавить("СпособВыдачиДенежныхСредств");
	//РеквизитыПоКомандировке.Добавить("ДенежныеОбязательстваЗаголовокДО");
	//РеквизитыПоКомандировке.Добавить("ДенежныеОбязательстваЗаголовокБО");
	//РеквизитыПоКомандировке.Добавить("ДенежныеОбязательстваСуммаБОПоОснованию");
	//РеквизитыПоКомандировке.Добавить("ДенежныеОбязательстваЗаголовокДО1");
	//РеквизитыПоКомандировке.Добавить("ДенежныеОбязательстваЗаголовокБО1");
	//РеквизитыПоКомандировке.Добавить("ДенежныеОбязательстваОтклонениеБО");
	
	Для Каждого Реквизит Из РеквизитыПоКомандировке Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, Реквизит, "Видимость", ЭтоКомандировка);
	КонецЦикла;
	
	РеквизитыПоЗакупке = Новый Массив;
	РеквизитыПоЗакупке.Добавить("ТоварыРаботыУслуги");
	
	Для Каждого Реквизит Из РеквизитыПоЗакупке Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, Реквизит, "Видимость", ЭтоЗакупка ИЛИ ЭтоЗакупкаЧерезПодотчетноеЛицо);
	КонецЦикла;
	
	РеквизитыПоЗакупкеЧерезПодотчетноеЛицо = Новый Массив;
	РеквизитыПоЗакупкеЧерезПодотчетноеЛицо.Добавить("ТоварыРаботыУслугиОКПД");
	РеквизитыПоЗакупкеЧерезПодотчетноеЛицо.Добавить("ТоварыРаботыУслугиНаименованиеПлан");
	РеквизитыПоЗакупкеЧерезПодотчетноеЛицо.Добавить("ТоварыРаботыУслугиПоДокументу");
	РеквизитыПоЗакупкеЧерезПодотчетноеЛицо.Добавить("ТоварыРаботыУслугиПриходныйДокумент");
	
	Для Каждого Реквизит Из РеквизитыПоЗакупкеЧерезПодотчетноеЛицо Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, Реквизит, "Видимость", ЭтоЗакупкаЧерезПодотчетноеЛицо);
	КонецЦикла;
	
	РеквизитыПоКрайнемуСеверу = Новый Массив;
	РеквизитыПоКрайнемуСеверу.Добавить("Проезд");
	РеквизитыПоКрайнемуСеверу.Добавить("ПрочиеРасходы");
	РеквизитыПоКрайнемуСеверу.Добавить("СпособВыдачиДенежныхСредств");
	//РеквизитыПоКрайнемуСеверу.Добавить("ДенежныеОбязательстваЗаголовокДО");
	//РеквизитыПоКрайнемуСеверу.Добавить("ДенежныеОбязательстваЗаголовокБО");
	//РеквизитыПоКрайнемуСеверу.Добавить("ДенежныеОбязательстваСуммаБОПоОснованию");
	//РеквизитыПоКрайнемуСеверу.Добавить("ДенежныеОбязательстваЗаголовокДО1");
	//РеквизитыПоКрайнемуСеверу.Добавить("ДенежныеОбязательстваЗаголовокБО1");
	//РеквизитыПоКрайнемуСеверу.Добавить("ДенежныеОбязательстваОтклонениеБО");
	
	Для Каждого Реквизит Из РеквизитыПоКрайнемуСеверу Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, Реквизит, "Видимость", ЭтоКрайнийСевер ИЛИ ЭтоКомандировка);
	КонецЦикла;
	
	РеквизитыИзОснования = Новый Массив;
	РеквизитыИзОснования.Добавить("ТоварыРаботыУслугиНаименованиеПлан");
	
	Для Каждого Реквизит Из РеквизитыИзОснования Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, Реквизит, "Видимость", ЭтоЗакупкаЧерезПодотчетноеЛицо И ОснованиеЗаполнено);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСтрокиКурсыВалют(Форма)
	
	ЭтоКомандировка = Форма.ЭтоКомандировка;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НадписьКурсыВалют", "Видимость",
		Форма.Объект.КурсыВалют.Количество() > 0 И ЭтоКомандировка);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитовЗаГраницы(Форма)
	
	Элементы = Форма.Элементы;
	
	ЭтоКомандировка = Форма.ЭтоКомандировка;
	
	КомандировкаЗаГраницу = Форма.Объект.КомандировкаЗаГраницу;
	
	РеквизитыДляКомандировкиПоРФ = Новый Массив;
	РеквизитыДляКомандировкиПоРФ.Добавить("СуточныеТерритория");
	
	Для Каждого Реквизит Из РеквизитыДляКомандировкиПоРФ Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, Реквизит, "Видимость",
			НЕ КомандировкаЗаГраницу И ЭтоКомандировка);
	КонецЦикла;
	
	РеквизитыДляКомандировкиЗаГраницу = Новый Массив;
	РеквизитыДляКомандировкиЗаГраницу.Добавить("ПолученоВалюта");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("ОтчетОВыполненнойРаботеСтрана");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("НадписьКурсыВалют");
	
	РеквизитыДляКомандировкиЗаГраницу.Добавить("СуточныеВалюта");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("СуточныеСтрана");
	
	РеквизитыДляКомандировкиЗаГраницу.Добавить("ПроездЗаголовокДатаПересеченияГраницы");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("ПроездДатаПересеченияГраницы");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("ПроездВалюта");
	
	РеквизитыДляКомандировкиЗаГраницу.Добавить("ПроживаниеВалюта");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("ПроживаниеСтрана");
	
	РеквизитыДляКомандировкиЗаГраницу.Добавить("ПрочиеРасходыВалюта");
	
	Для Каждого Реквизит Из РеквизитыДляКомандировкиЗаГраницу Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, Реквизит, "Видимость",
			ЭтоКомандировка И КомандировкаЗаГраницу);
	КонецЦикла;
	
	Форма.ЗаголовокКолонкиСтранаДопУсловие = НСтр("ru = 'Доп. условие'") + ?(КомандировкаЗаГраницу, НСтр("ru = ', страна'"), "");
	Форма.ЗаголовокКолонкиУсловиеПроживания = НСтр("ru = 'Условие проживания'") + ?(КомандировкаЗаГраницу, НСтр("ru = ', страна'"), "");
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаИтоги", "Видимость",
		НЕ ЭтоКомандировка ИЛИ НЕ КомандировкаЗаГраницу);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитовСпособВыдачиДС(Форма)
	
	Элементы = Форма.Элементы;
	
	ЭтоКомандировка = Форма.ЭтоКомандировка;
	ЭтоКрайнийСевер = Форма.ЭтоКрайнийСевер;
	
	МассивСпособовВыдачи = Новый Массив;
	МассивВалют = Новый Массив;
	
	Для Каждого Строка Из Форма.Объект.СпособыВыдачи Цикл
		Если МассивСпособовВыдачи.Найти(Строка.СпособВыдачи) = Неопределено Тогда
			МассивСпособовВыдачи.Добавить(Строка.СпособВыдачи);
		КонецЕсли;
		Если МассивВалют.Найти(Строка.Валюта) = Неопределено Тогда
			МассивВалют.Добавить(Строка.Валюта);
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СпособВыдачиДенежныхСредств", "Видимость",
		МассивСпособовВыдачи.Количество() < 2 И (ЭтоКомандировка ИЛИ ЭтоКрайнийСевер));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РазбитьПоВалютам", "Видимость",
		МассивСпособовВыдачи.Количество() < 2 И МассивВалют.Количество() > 1 И ЭтоКомандировка);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьСпособВыдачиДенежныхСредств", "Видимость",
		МассивСпособовВыдачи.Количество() > 1 И МассивВалют.Количество() > 1 И ЭтоКомандировка);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПодсказкуРазницаДО(Форма)
	
	СуммаДОПоОтчетуРассчитанная = 0;
	СуммаДОПоОтчетуЗаполненная = 0;
	
	Для Каждого Строка Из Форма.ДенежныеОбязательстваПоОтчету Цикл
		СуммаДОПоОтчетуРассчитанная = СуммаДОПоОтчетуРассчитанная + Строка.Сумма;
	КонецЦикла;
	
	Для Каждого Строка Из Форма.Объект.ДенежныеОбязательства Цикл
		СуммаДОПоОтчетуЗаполненная = СуммаДОПоОтчетуЗаполненная + Строка.СуммаПоОтчету;
	КонецЦикла;
	
	Форма.РазницаРасчетныхИЗаполненныхДО = СуммаДОПоОтчетуЗаполненная - СуммаДОПоОтчетуРассчитанная;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "РазницаРасчетныхИЗаполненныхДО", "Видимость",
		Форма.РазницаРасчетныхИЗаполненныхДО <> 0);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуДенежныеОбязательстваНаСервере()
	
	ЗаполнитьРазделЛСИОснованиеПринятияОбязательствПоОснованию();
	
	ОбновитьТаблицуДенежныеОбязательстваПоОснованию();
	
	ОбновитьТаблицуДенежныеОбязательства();
	
	ОбновитьПодсказкуРазницаДО(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуДенежныеОбязательства(ТолькоРасчет = Ложь)
	
	ОстаткиАвансов = Авансы.Выгрузить();
	
	Счета208 = БухгалтерскиеОперации.СчетПоКоду("208.00", Объект.Дата);
	Счет50211 = БухгалтерскиеОперации.СчетПоКоду("502.11", Объект.Дата);
	Счет50212 = БухгалтерскиеОперации.СчетПоКоду("502.12", Объект.Дата);
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ТаблицаИзрасходовано = Объект.Суточные.Выгрузить();
	ТаблицаИзрасходовано.Очистить();
	
	ТаблицаИзрасходовано.Колонки.Добавить("РасчетыВВалюте", Новый ОписаниеТипов("Булево"));
	ТаблицаИзрасходовано.Колонки.Добавить("РублевыйЭквивалент", ОписаниеТипаСуммы);
	ТаблицаИзрасходовано.Колонки.Добавить("СуммаРасчетов", ОписаниеТипаСуммы);
	ТаблицаИзрасходовано.Колонки.Добавить("СчетКредита", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	
	ТипыПриходныхДокументов = Новый Массив;
	ТипыПриходныхДокументов.Добавить(Тип("ДокументСсылка.ПоступлениеМЗ"));
	ТипыПриходныхДокументов.Добавить(Тип("ДокументСсылка.ПоступлениеОС"));
	ТипыПриходныхДокументов.Добавить(Тип("ДокументСсылка.ПриходныйОрдерФондовый"));   
	ТипыПриходныхДокументов.Добавить(Тип("ДокументСсылка.ПоступлениеУслугРабот")); 
	
	ТаблицаПриходныеДокументы = Новый ТаблицаЗначений;
	ТаблицаПриходныеДокументы.Колонки.Добавить("ПриходныйДокумент", Новый ОписаниеТипов(ТипыПриходныхДокументов));
	ТаблицаПриходныеДокументы.Колонки.Добавить("КЭК", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));  
		
	ПриходныеДокументы = Новый Массив;  
	ДокументыУслуги    = Новый Массив;
	
	Для Каждого СтрокаТЧ Из Объект.ТоварыРаботыУслуги Цикл
		Если НЕ СтрокаТЧ.ПоДокументу
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаТЧ.ПриходныйДокумент)
			ИЛИ (СтрокаТЧ.СпособОбеспечения <> ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу")
			И СтрокаТЧ.СпособОбеспечения <> ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.ВозмещениеПоФакту")) Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТаблицаПриходныеДокументы.Добавить(), СтрокаТЧ);
		ПриходныеДокументы.Добавить(СтрокаТЧ.ПриходныйДокумент);
		Если ТипЗнч(СтрокаТЧ.ПриходныйДокумент) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда  
			ДокументыУслуги.Добавить(СтрокаТЧ.ПриходныйДокумент);
		КонецЕсли;	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"
		|ВЫБРАТЬ
		|	ТаблицаПриходныеДокументы.ПриходныйДокумент КАК ПриходныйДокумент,
		|	ТаблицаПриходныеДокументы.КЭК КАК КЭК
		|ПОМЕСТИТЬ ТаблицаПриходныеДокументы
		|ИЗ
		|	&ТаблицаПриходныеДокументы КАК ТаблицаПриходныеДокументы
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ПриходныйДокумент,
		|	КЭК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
		|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт) КАК КЭК
		|ПОМЕСТИТЬ ПриходныеДокументыСЕдинственнымКЭК
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
		|			,
		|			,
		|			СчетКт В (&Счет208)
		|				И СчетДт В (&СчетаМатериалы)
		|				И Регистратор В (&ПриходныеДокументы),
		|			,
		|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
		|
		|СГРУППИРОВАТЬ ПО
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт) = 1
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Регистратор
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
		|	МАКСИМУМ(УслугиИРаботы.КЭК) КАК КЭК
		|ПОМЕСТИТЬ ПриходныеДокументыУслуги
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
		|			,
		|			,
		|			СчетКт В (&Счет208)
		|				И СчетДт В (&СчетаМатериалы)
		|				И Регистратор В (&ДокументыУслуги),
		|			,
		|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто  
		|   ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеУслугРабот.УслугиИРаботы КАК УслугиИРаботы 
		|   ПО УслугиИРаботы.Ссылка = ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор
		|
		|СГРУППИРОВАТЬ ПО
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ УслугиИРаботы.КЭК) = 1
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Регистратор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт КАК ПодразделениеДт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетКт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт КАК КПСКт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК СчетДт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт КАК КЭКДт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаКт КАК ВалютаКт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК Сумма,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаКт КАК ВалютнаяСуммаКт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор
		|	ПОМЕСТИТЬ ДанныеРБ
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
		|				,
		|				,
		|				СчетКт В (&Счет208)
		|					И СубконтоКт1 = &Контрагент
		|					И Регистратор В (&ПриходныеДокументы),
		|				,
		|				) КАК ЖурналПроводокЕПСБУДвиженияССубконто
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Регистратор
		|		
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт КАК Подразделение,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетКредита,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт КАК КПС,
		|	ВЫБОР  
		|		КОГДА НЕ ПриходныеДокументыУслуги.КЭК ЕСТЬ NULL
		|			ТОГДА ПриходныеДокументыУслуги.КЭК
		|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт В (&СчетаМатериалы)
		|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт 
		|		КОГДА НЕ ПриходныеДокументыСЕдинственнымКЭК.КЭК ЕСТЬ NULL
		|			ТОГДА ПриходныеДокументыСЕдинственнымКЭК.КЭК
		|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт = &Счет20834
		|				И ТаблицаПриходныеДокументы.КЭК <> ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
		|			ТОГДА ТаблицаПриходныеДокументы.КЭК
		|		ИНАЧЕ СоответствияАналитическихСчетовКЭК.КЭК
		|	КОНЕЦ КАК КЭК,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаКт, &ВалютаРегламентированногоУчета) КАК Валюта,
		|	НЕ(ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаКт ЕСТЬ NULL
		|			ИЛИ ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаКт = &ВалютаРегламентированногоУчета) КАК РасчетыВВалюте,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК РублевыйЭквивалент,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаКт ЕСТЬ NULL
		|				ИЛИ ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаКт = &ВалютаРегламентированногоУчета
		|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.Сумма
		|		ИНАЧЕ ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаКт
		|	КОНЕЦ КАК СуммаРасчетов
		|ИЗ
		|	ТаблицаПриходныеДокументы КАК ТаблицаПриходныеДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеРБ КАК ЖурналПроводокЕПСБУДвиженияССубконто
		|		ПО ТаблицаПриходныеДокументы.ПриходныйДокумент = ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияАналитическихСчетовКЭК КАК СоответствияАналитическихСчетовКЭК
		|		ПО (ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт = СоответствияАналитическихСчетовКЭК.Счет)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПриходныеДокументыУслуги КАК ПриходныеДокументыУслуги
		|		ПО ТаблицаПриходныеДокументы.ПриходныйДокумент = ПриходныеДокументыУслуги.Регистратор
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПриходныеДокументыСЕдинственнымКЭК КАК ПриходныеДокументыСЕдинственнымКЭК
		|		ПО ТаблицаПриходныеДокументы.ПриходныйДокумент = ПриходныеДокументыСЕдинственнымКЭК.Регистратор
		|";
	
	Запрос.УстановитьПараметр("Счет208",                        БухгалтерскийУчет.СписокСчетов("208.00", Объект.Дата, , Объект.Организация));
	Запрос.УстановитьПараметр("Счет20834",                      БухгалтерскийУчет.СчетПоКоду("208.34", Объект.Дата, Объект.Организация));
	Запрос.УстановитьПараметр("СчетаМатериалы",                 БухгалтерскийУчет.СписокСчетов("105.00, 106.2П, 106.3П", Объект.Дата, , Объект.Организация));
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	Запрос.УстановитьПараметр("Контрагент",                     ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Сотрудник, "Контрагент"));
	Запрос.УстановитьПараметр("ПриходныеДокументы",             ПриходныеДокументы);   
	Запрос.УстановитьПараметр("ДокументыУслуги",                ДокументыУслуги);
	Запрос.УстановитьПараметр("ТаблицаПриходныеДокументы",      ТаблицаПриходныеДокументы);        
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаИзрасходовано.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("Суточные");
	МассивТЧ.Добавить("Проезд");
	МассивТЧ.Добавить("Проживание");
	МассивТЧ.Добавить("ПрочиеРасходы");
	МассивТЧ.Добавить("ТоварыРаботыУслуги");
	
	Для Каждого ТЧ Из МассивТЧ Цикл
		Для Каждого СтрокаТЧ Из Объект[ТЧ] Цикл
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТЧ, "СпособОбеспечения")
				И СтрокаТЧ.СпособОбеспечения <> ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу")
				И СтрокаТЧ.СпособОбеспечения <> ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.ВозмещениеПоФакту") Тогда
				Продолжить;
			КонецЕсли;
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТЧ, "ПоДокументу")
				И СтрокаТЧ.ПоДокументу Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ТаблицаИзрасходовано.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			НоваяСтрока.СчетКредита = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
				НоваяСтрока.КЭК, Счета208, , Объект.Дата, Объект.Организация, Объект.ИФО);
			Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
				И (БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКредита).УчетПоПодразделениям
					ИЛИ БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет50211).УчетПоПодразделениям
					ИЛИ БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет50212).УчетПоПодразделениям) Тогда
				Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Подразделение) Тогда
					НоваяСтрока.Подразделение = Объект.Подразделение;
				КонецЕсли;
			Иначе
				НоваяСтрока.Подразделение = ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка");
			КонецЕсли;
			НоваяСтрока.СуммаРасчетов = НоваяСтрока.СуммаПринято;
			Если НоваяСтрока.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета()
				ИЛИ Не ЗначениеЗаполнено(НоваяСтрока.Валюта) Тогда
				НоваяСтрока.РасчетыВВалюте = Ложь;
				НоваяСтрока.РублевыйЭквивалент = НоваяСтрока.СуммаПринято;
			Иначе
				НоваяСтрока.РасчетыВВалюте = Истина;
				НоваяСтрока.РублевыйЭквивалент = Документы.ОтчетОРасходахПодотчетногоЛица.СуммаВРублевомЭквиваленте(
					НоваяСтрока.СуммаПринято, НоваяСтрока.Валюта, Объект.КурсыВалют);
			КонецЕсли;
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТЧ, "СуммаНДС")
				И НЕ Объект.СуммаВключаетНДС Тогда
				НоваяСтрока.СуммаРасчетов = НоваяСтрока.СуммаРасчетов + СтрокаТЧ.СуммаНДС;
				НоваяСтрока.РублевыйЭквивалент = НоваяСтрока.РублевыйЭквивалент + СтрокаТЧ.СуммаНДС;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаИзрасходовано.Колонки.Добавить("СуммаРубПоКурсуАванса", ОписаниеТипаСуммы);
	
	ТаблицаРасчетов = ТаблицаИзрасходовано.Скопировать();
	ТаблицаРасчетов.Очистить();
	
	Для Каждого СтрокаДокумента Из ТаблицаИзрасходовано Цикл
		
		НераспределенныйОстаток = СтрокаДокумента.СуммаРасчетов;
		
		Если ОстаткиАвансов.Количество() > 0 Тогда
			
			Отбор = Новый Структура;
			Отбор.Вставить("КФО", СтрокаДокумента.КФО);
			Отбор.Вставить("Счет", СтрокаДокумента.СчетКредита);
			Отбор.Вставить("КПС", СтрокаДокумента.КПС);
			
			СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаДокумента.СчетКредита);
			Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") И СвойстваСчетаРасчетов.Валютный Тогда
				Отбор.Вставить("Валюта", СтрокаДокумента.Валюта);
			ИначеЕсли СтрокаДокумента.РасчетыВВалюте Тогда
				Отбор.Вставить("Валюта", СтрокаДокумента.Валюта);
			КонецЕсли;
			
			Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
				Отбор.Вставить("Подразделение", СтрокаДокумента.Подразделение);
			КонецЕсли;
			
			НайденныеОстаткиАвансов = ОстаткиАвансов.НайтиСтроки(Отбор);
			
			ДобавитьСтрокиЗачтенныхАвансов(
				ТаблицаРасчетов,
				НераспределенныйОстаток,
				НайденныеОстаткиАвансов,
				СтрокаДокумента);
			
		КонецЕсли;
		
		// Сумму расчетов, оставшуюся после зачета всех авансов, добавляем отдельной строкой.
		ДобавитьСтрокуЗадолженности(
			ТаблицаРасчетов,
			НераспределенныйОстаток,
			СтрокаДокумента);
		
	КонецЦикла;
	
	КолонкиГруппировки = "КФО, КПС, КЭК, КодЦели, КодМероприятия, ДопКлассификация";
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И (БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет50211).УчетПоПодразделениям
			ИЛИ БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет50212).УчетПоПодразделениям)Тогда
		КолонкиГруппировки = КолонкиГруппировки + ", Подразделение";
	КонецЕсли;
	КолонкиСуммирования = "СуммаРубПоКурсуАванса";
	ТаблицаРасчетов.Свернуть(КолонкиГруппировки, КолонкиСуммирования);
	
	ТекущаяТаблица = Объект.ДенежныеОбязательства.Выгрузить();
	
	НоваяТаблица = ТекущаяТаблица.Скопировать();
	НоваяТаблица.Очистить();
	
	Для Каждого СтрокаТЧ Из ДенежныеОбязательстваПоОснованию Цикл
		НоваяСтрока = НоваяТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		НоваяСтрока.СуммаПоОснованию = СтрокаТЧ.Сумма;
		НоваяСтрока.СуммаБОПоОснованию = СтрокаТЧ.СуммаБО;
	КонецЦикла;
	
	ДенежныеОбязательстваПоОтчету.Очистить();
	
	Для Каждого СтрокаТЧ Из ТаблицаРасчетов Цикл
		НоваяСтрока = НоваяТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		НоваяСтрока.СуммаПоОтчету = СтрокаТЧ.СуммаРубПоКурсуАванса;
		
		НоваяСтрокаДО = ДенежныеОбязательстваПоОтчету.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаДО, СтрокаТЧ);
		НоваяСтрокаДО.Сумма = СтрокаТЧ.СуммаРубПоКурсуАванса;
	КонецЦикла;
	
	НоваяТаблица.Свернуть(КолонкиГруппировки,
		"СуммаПоОснованию, СуммаБОПоОснованию, СуммаПоОтчету");
	
	Если ТолькоРасчет Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ДенежныеОбязательства.Очистить();
	
	Для Каждого Строка Из НоваяТаблица Цикл
		НоваяСтрока = Объект.ДенежныеОбязательства.Добавить();
		Отбор = Новый Структура(КолонкиГруппировки);
		ЗаполнитьЗначенияСвойств(Отбор, Строка);
		ИмеющиесяСтроки = ТекущаяТаблица.НайтиСтроки(Отбор);
		Если ИмеющиесяСтроки.Количество() = 1 Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ИмеющиесяСтроки[0]);
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.ФинансовыйГод = Год(Объект.Дата);
		КонецЕсли;
		НоваяСтрока.СуммаПоОснованию = Строка.СуммаПоОснованию;
		НоваяСтрока.СуммаБОПоОснованию = Строка.СуммаБОПоОснованию;
		НоваяСтрока.СуммаПоОтчету = Строка.СуммаПоОтчету;
		НоваяСтрока.Отклонение = НоваяСтрока.СуммаПоОтчету - НоваяСтрока.СуммаПоОснованию;
		НоваяСтрока.ОтклонениеБО = НоваяСтрока.СуммаПоОтчету - НоваяСтрока.СуммаБОПоОснованию;
		
		ОбновитьТекстЗаголовковВСтрокеТаблицыДенежныеОбязательства(НоваяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицыСпособыВыдачиИКурсыВалют()
	
	// Если появилась (исчезла) новая валюта, необходимо ее добавить (удалить) в ТЧ "Способы выдачи" и "Курсы валют"
	МассивВалют = Новый Массив;
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("Суточные");
	МассивТЧ.Добавить("Проезд");
	МассивТЧ.Добавить("Проживание");
	МассивТЧ.Добавить("ПрочиеРасходы");
	
	Для Каждого ТЧ Из МассивТЧ Цикл
		Для Каждого СтрокаТЧ Из Объект[ТЧ] Цикл
			Валюта = ?(ЗначениеЗаполнено(СтрокаТЧ.Валюта), СтрокаТЧ.Валюта, ОбщегоНазначенияБГУВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета());
			МассивВалют.Добавить(Валюта);
		КонецЦикла
	КонецЦикла;
	
	МассивВалют = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивВалют);
	
	Для Каждого Валюта Из МассивВалют Цикл
		
		ВалютаНайдена = Ложь;
		Для Каждого СтрокаСпособВыдачи Из Объект.СпособыВыдачи Цикл
			Если СтрокаСпособВыдачи.Валюта = Валюта Тогда
				ВалютаНайдена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ВалютаНайдена Тогда
			Строка = Объект.СпособыВыдачи.Добавить();
			Строка.Валюта = Валюта;
			Строка.СпособВыдачи = СпособВыдачиДенежныхСредств;
		КонецЕсли;
		
		// В таблицу "Курсы валют" не нужно добавлять валюту рег. учета
		Если Валюта = ОбщегоНазначенияБГУВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета() Тогда
			Продолжить;
		КонецЕсли;
		
		ВалютаНайдена = Ложь;
		Для Каждого СтрокаКурсыВалют Из Объект.КурсыВалют Цикл
			Если СтрокаКурсыВалют.Валюта = Валюта Тогда
				ВалютаНайдена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ВалютаНайдена Тогда
			Строка = Объект.КурсыВалют.Добавить();
			Строка.Валюта = Валюта;
			КурсКратность = ПолучитьКурс(Строка.Валюта, Объект.ДатаУтверждения);
			Строка.Курс = КурсКратность.Курс;
			Строка.Кратность = КурсКратность.Кратность;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Строка Из Объект.СпособыВыдачи Цикл
		Если МассивВалют.Найти(Строка.Валюта) = Неопределено Тогда
			Объект.СпособыВыдачи.Удалить(Объект.СпособыВыдачи.Индекс(Строка));
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из Объект.КурсыВалют Цикл
		Если МассивВалют.Найти(Строка.Валюта) = Неопределено Тогда
			Объект.КурсыВалют.Удалить(Объект.КурсыВалют.Индекс(Строка));
		КонецЕсли;
	КонецЦикла;
	
	УстановитьВидимостьРеквизитовСпособВыдачиДС(ЭтотОбъект);
	УстановитьПредставлениеСтрокиСпособВыдачиДС(ЭтотОбъект);
	
	УстановитьВидимостьСтрокиКурсыВалют(ЭтотОбъект);
	УстановитьПредставлениеСтрокиКурсыВалют(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораСпособовВыдачиПоВалютам()
	
	СпособыВыдачи = Новый Массив;
	Для Каждого Строка Из Объект.СпособыВыдачи Цикл
		СпособыВыдачи.Добавить(Новый Структура("Валюта, СпособВыдачи", Строка.Валюта, Строка.СпособВыдачи));
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СпособыВыдачи", СпособыВыдачи);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияВыбораСпособовВыдачиПоВалютам", ЭтотОбъект);
	
	ОткрытьФорму("Документ.РешениеОКомандировании.Форма.СпособыВыдачиПоВалютам", ПараметрыФормы, ЭтотОбъект,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВыбораСпособовВыдачиПоВалютам(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ ТипЗнч(Результат) = Тип("КодВозвратаДиалога") Тогда
		Возврат;
	КонецЕсли;
	
	Объект.СпособыВыдачи.Очистить();
	Для Каждого Строка Из Результат Цикл
		ЗаполнитьЗначенияСвойств(Объект.СпособыВыдачи.Добавить(), Строка);
	КонецЦикла;
	
	Если Объект.СпособыВыдачи.Количество() > 0 Тогда
		СпособВыдачиДенежныхСредств = Объект.СпособыВыдачи[0].СпособВыдачи;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	УстановитьВидимостьРеквизитовСпособВыдачиДС(ЭтотОбъект);
	
	УстановитьПредставлениеСтрокиСпособВыдачиДС(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиСпособВыдачиДС(Форма)
	
	Объект = Форма.Объект;
	
	ТекстСтроки = "";
	Для Каждого Строка Из Объект.СпособыВыдачи Цикл
		ТекстСтроки = ТекстСтроки + "; " + Строка(Строка.Валюта) + ": " + Строка(Строка.СпособВыдачи);
	КонецЦикла;
	ТекстСтроки = СтроковыеФункцииКлиентСервер.УдалитьПовторяющиесяСимволы(ТекстСтроки, ";", "Слева");
	
	Форма.НадписьСпособВыдачиДенежныхСредств = СокрЛП(ТекстСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуКурсовВалют()
	
	КурсыВалют = Новый Массив;
	Для Каждого Строка Из Объект.КурсыВалют Цикл
		Если Строка.Валюта = ОбщегоНазначенияБГУВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета() Тогда
			Продолжить;
		КонецЕсли;
		КурсыВалют.Добавить(Новый Структура("Валюта, Курс, Кратность", Строка.Валюта, Строка.Курс, Строка.Кратность));
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КурсыВалют", КурсыВалют);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияФормыКурсовВалют", ЭтотОбъект);
	
	ОткрытьФорму("Документ.РешениеОКомандировании.Форма.КурсыВалют", ПараметрыФормы, ЭтотОбъект,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыКурсовВалют(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ ТипЗнч(Результат) = Тип("КодВозвратаДиалога") Тогда
		Возврат;
	КонецЕсли;
	
	Объект.КурсыВалют.Очистить();
	Для Каждого Строка Из Результат Цикл
		ЗаполнитьЗначенияСвойств(Объект.КурсыВалют.Добавить(), Строка);
	КонецЦикла;
	
	Модифицированность = Истина;
	
	УстановитьВидимостьСтрокиКурсыВалют(ЭтотОбъект);
	
	УстановитьПредставлениеСтрокиКурсыВалют(ЭтотОбъект);
	
	ОбновитьТаблицуДенежныеОбязательства();
	
	ОбновитьПодсказкуРазницаДО(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиКурсыВалют(Форма)
	
	Объект = Форма.Объект;
	
	ТекстСтроки = "";
	Для Каждого Строка Из Объект.КурсыВалют Цикл
		ТекстСтроки = ТекстСтроки + "; " + Строка(Строка.Валюта)
			+ " (курс: " + Строка(Строка.Курс)
			+ ", кратность: " + Строка(Строка.Кратность) + ")";
	КонецЦикла;
	ТекстСтроки = СтроковыеФункцииКлиентСервер.УдалитьПовторяющиесяСимволы(ТекстСтроки, ";", "Слева");
	
	Форма.НадписьКурсыВалют = СокрЛП(ТекстСтроки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКурс(Знач Валюта, Дата)
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, Дата);
КонецФункции

&НаСервере
Процедура ДобавитьСтрокиЗачтенныхАвансов(ТаблицаРасчетов, НераспределеннаяСумма, ОстаткиАвансов, СтрокаДокумента)

	Знак = 1;
	
	Для Каждого СтрокаОстатка Из ОстаткиАвансов Цикл
		
		Если НераспределеннаяСумма <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		ЗачитываемыйАванс = Мин(НераспределеннаяСумма, Знак * СтрокаОстатка.СуммаРасчетов);
		Если ЗачитываемыйАванс <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРасчетов = ТаблицаРасчетов.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаДокумента);
		
		Если НераспределеннаяСумма > 0 И ЗачитываемыйАванс > 0 Тогда
			
			СтрокаРасчетов.СуммаРасчетов = ЗачитываемыйАванс;
			
			КоэффициентКурсаАванса = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
				?(СтрокаОстатка.СуммаРасчетов = 0, 0, СтрокаОстатка.РублевыйЭквивалент / СтрокаОстатка.СуммаРасчетов));
			
			КоэффициентРуб = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
				?(СтрокаДокумента.СуммаРасчетов = 0, 0, СтрокаДокумента.РублевыйЭквивалент / СтрокаДокумента.СуммаРасчетов));
			
			СтрокаРасчетов.СуммаРубПоКурсуАванса = Окр(ЗачитываемыйАванс * КоэффициентКурсаАванса, 2);
			СтрокаРасчетов.РублевыйЭквивалент = Окр(ЗачитываемыйАванс * КоэффициентРуб, 2);
			
			НераспределеннаяСумма = НераспределеннаяСумма - ЗачитываемыйАванс;
			
			СтрокаОстатка.СуммаРасчетов = СтрокаОстатка.СуммаРасчетов - Знак * СтрокаРасчетов.СуммаРасчетов;
			СтрокаОстатка.РублевыйЭквивалент = СтрокаОстатка.РублевыйЭквивалент - Знак * СтрокаРасчетов.СуммаРубПоКурсуАванса;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуЗадолженности(ТаблицаРасчетов, НераспределеннаяСумма, СтрокаДокумента)
	
	Если НераспределеннаяСумма <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРасчетов = ТаблицаРасчетов.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаДокумента);
	
	Если НераспределеннаяСумма > 0 Тогда
		
		СтрокаРасчетов.СуммаРасчетов = НераспределеннаяСумма;
		
		КоэффициентРуб = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаДокумента.СуммаРасчетов = 0, 0, СтрокаДокумента.РублевыйЭквивалент / СтрокаДокумента.СуммаРасчетов));
		
		СтрокаРасчетов.РублевыйЭквивалент = Окр(НераспределеннаяСумма * КоэффициентРуб, 2);
		СтрокаРасчетов.СуммаРубПоКурсуАванса = СтрокаРасчетов.РублевыйЭквивалент;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуАвансов()
	
	Авансы.Очистить();
	
	ДокументыАванса = Объект.Получено.Выгрузить().ВыгрузитьКолонку("ДокументАванса");
	
	Если ДокументыАванса.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДокументыАванса", Объект.Получено.Выгрузить().ВыгрузитьКолонку("ДокументАванса"));
	Запрос.УстановитьПараметр("Контрагент", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Сотрудник, "Контрагент"));
	Запрос.УстановитьПараметр("ВалютаРегУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	Запрос.УстановитьПараметр("Счет208", БухгалтерскийУчет.СписокСчетов("208.00"));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт КАК Подразделение,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК Счет,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт.Код КАК КодСчета,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт.ДатаОкончанияДействия КАК ДатаОкончанияДействияСчета,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПС,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт ЕСТЬ NULL
	|				ИЛИ ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА &ВалютаРегУчета
	|		ИНАЧЕ ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт
	|	КОНЕЦ КАК Валюта,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт ЕСТЬ NULL
	|				ИЛИ ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|				ИЛИ ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт = &ВалютаРегУчета
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.Сумма
	|		ИНАЧЕ ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаДт
	|	КОНЕЦ КАК СуммаРасчетов,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК РублевыйЭквивалент
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			СчетДт В (&Счет208)
	|				И Регистратор В (&ДокументыАванса)
	|				И СубконтоДт1 = &Контрагент,
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто";
	
	ДатаДокумента = ?(ЗначениеЗаполнено(Объект.ДатаУтверждения), Объект.ДатаУтверждения,
					?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаАванс = Авансы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаАванс, Выборка);
		Если ЗначениеЗаполнено(Выборка.ДатаОкончанияДействияСчета)
			И Выборка.ДатаОкончанияДействияСчета < ДатаДокумента Тогда
			СтрокаАванс.Счет = БухгалтерскийУчет.СчетПоКоду(Выборка.КодСчета, ДатаДокумента, Объект.Организация);
		КонецЕсли;
	КонецЦикла;
	
	РегистрыСведений.СоответствиеКПСПриПереносеОстатков.ЗаменитьКПСвТаблицахСУчетомПереносаОстатковПоКПС(
		ДатаДокумента, Авансы);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуДенежныеОбязательстваПоОснованию()
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РешениеОКомандировании") Тогда
		ДенежныеОбязательстваПоОснованию.Загрузить(
			Документы.РешениеОКомандировании.ТаблицаОбязательствПоСвязаннымРешениям(Объект.ДокументОснование));
	ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъема") Тогда
		ДенежныеОбязательстваПоОснованию.Загрузить(
			Документы.ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТаблицаДенежныхОбязательствПоЗаявке(Объект.ДокументОснование));
	ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо") Тогда
		ДенежныеОбязательстваПоОснованию.Загрузить(
			Документы.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо.ТаблицаДенежныхОбязательствПоЗаявке(Объект.ДокументОснование));
	ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РешениеОКомпенсацииРасходовДляКрайнегоСевера") Тогда
		ДенежныеОбязательстваПоОснованию.Загрузить(
			Документы.РешениеОКомпенсацииРасходовДляКрайнегоСевера.ТаблицаОбязательствПоРешениюОКомпенсации(Объект.ДокументОснование));
	КонецЕсли;
	
	ДатаДокумента = ?(ЗначениеЗаполнено(Объект.ДатаУтверждения), Объект.ДатаУтверждения,
					?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса()));
	РегистрыСведений.СоответствиеКПСПриПереносеОстатков.ЗаменитьКПСвТаблицахСУчетомПереносаОстатковПоКПС(
		ДатаДокумента, ДенежныеОбязательстваПоОснованию);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРазделЛСИОснованиеПринятияОбязательствПоОснованию()
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РешениеОКомандировании")
		ИЛИ ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РешениеОКомпенсацииРасходовДляКрайнегоСевера")
		ИЛИ ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо") Тогда
		
		РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Объект.ДокументОснование, "РазделЛицевогоСчета, ОснованиеПринятияОбязательства");
		Объект.РазделЛицевогоСчета = РеквизитыОснования.РазделЛицевогоСчета;
		Объект.ОснованиеПринятияОбязательства = РеквизитыОснования.ОснованиеПринятияОбязательства;
		
	ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъема") Тогда
		
		РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Объект.ДокументОснование, "РазделЛицевогоСчета, Договор");
		Объект.РазделЛицевогоСчета = РеквизитыОснования.РазделЛицевогоСчета;
		Объект.ОснованиеПринятияОбязательства = РеквизитыОснования.Договор;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуОснованиюНаСервере()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Заполнить(Объект.ДокументОснование);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ПодготовитьФормуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииФлагаПроверкиДокументов(ТекущаяСтрока)
	
	Если ТекущаяСтрока.ДокументПроверен Тогда
		ТекущаяСтрока.СуммаПринято = ТекущаяСтрока.СуммаФакт;
	Иначе
		ТекущаяСтрока.СуммаПринято = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьДлительностьПроживания(Данные)
	
	Если Данные = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(Данные.ДатаЗаезда)
		ИЛИ НЕ ЗначениеЗаполнено(Данные.ДатаВыезда)
		ИЛИ Данные.ДатаЗаезда > Данные.ДатаВыезда Тогда
		Данные.КоличествоДней = 0;
	ИначеЕсли Данные.ДатаЗаезда = Данные.ДатаВыезда Тогда
		Данные.КоличествоДней = 1;
	Иначе
		Данные.КоличествоДней = (Данные.ДатаВыезда - Данные.ДатаЗаезда)/86400;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	УстановитьОтветственныхЛиц(Объект.Руководитель, Объект.РуководительФинЭкономПодразделения,
		Объект.Организация, Объект.Дата, Объект.Подразделение);
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтветственныхЛиц(Руководитель, РуководительФЭП, Организация, Дата, Подразделение)
	
	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Руководитель", Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	
	РуководительФЭП = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Руководитель ПФС", Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ДанныеСтроки)
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ЕстьКЭКДт = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеСтроки, "КЭКДт");
	
	ПараметрыФормы = Новый Структура("Дата, Организация, Подразделение, ИФО, КФО, КПС, КЭК, Количество");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.КПС = ?(ЗначениеЗаполнено(ДанныеСтроки.КПСДт), ДанныеСтроки.КПСДт, ДанныеСтроки.КПС);
	ПараметрыФормы.КЭК = ?(ЕстьКЭКДт И ЗначениеЗаполнено(ДанныеСтроки.КЭКДт), ДанныеСтроки.КЭКДт, ДанныеСтроки.КЭК);
	ПараметрыФормы.Подразделение = ?(ЗначениеЗаполнено(ДанныеСтроки.ПодразделениеДт), ДанныеСтроки.ПодразделениеДт, Объект.Подразделение);
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	// КФО, КПС и КЭК изменять не нужно
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО", 		Истина);
	ПараметрыФормы.Вставить("ТолькоПросмотрКПС", 		Ложь);
	ПараметрыФормы.Вставить("ТолькоПросмотрКЭК", 		Ложь);
	ПараметрыФормы.Вставить("ВидимостьКПС", 			Истина);
	ПараметрыФормы.Вставить("ВидимостьКЭК", 			ЕстьКЭКДт);
	ПараметрыФормы.Вставить("ВидимостьПодразделение", 	Истина);
	ПараметрыФормы.Вставить("ВидимостьКоличество", 		ТекущийЭлемент.Имя = "Проезд");
	
	// Бухгалтерский учет
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.СчетДебета);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.СубконтоДебета1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.СубконтоДебета2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.СубконтоДебета3);
	
	// для автозаполнения субконто
	Если ДанныеСтроки.Свойство("Номенклатура") И НЕ ЗначениеЗаполнено(ДанныеСтроки.СубконтоДебета1) И ЗначениеЗаполнено(ДанныеСтроки["Номенклатура"]) Тогда
		Если (ТипЗнч(ДанныеСтроки["Номенклатура"]) = Тип("СправочникСсылка.Номенклатура")
			ИЛИ ТипЗнч(ДанныеСтроки["Номенклатура"]) = Тип("СправочникСсылка.ОсновныеСредства")) Тогда
			ПараметрыФормы.Субконто1 = ДанныеСтроки["Номенклатура"];
		ИначеЕсли ТипЗнч(ДанныеСтроки["Номенклатура"]) = Тип("СправочникСсылка.ДенежныеДокументы") Тогда
			ПараметрыФормы.Субконто1 = ВидДенежногоДокумента(ДанныеСтроки["Номенклатура"]);
			ПараметрыФормы.Субконто2 = ДанныеСтроки["Номенклатура"];
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", 			НСтр("ru = 'Настройка отражения расходов в учете'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет", 			НСтр("ru = 'Счет дебета'"));
	ПараметрыФормы.Вставить("ЗаголовокПодразделение", 	НСтр("ru = 'Подразделение дебета'"));
	
	ПараметрыФормы.Вставить("ПараметрыСчета",
		ПараметрыСчетаДебета(Объект.Дата, Объект.Организация, Объект.ИФО, ДанныеСтроки.КЭК));
	
	// НДС
	ЕстьНДС = Ложь;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеСтроки, "ПредъявленСФ")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеСтроки, "СуммаНДС") Тогда
		ЕстьНДС = ДанныеСтроки.ПредъявленСФ И ДанныеСтроки.СуммаНДС > 0;
	КонецЕсли;
	
	Если ЕстьНДС Тогда
		НДСКРаспределению = ДанныеСтроки.НДСКРаспределению;
		СчетУчетаНДС = ДанныеСтроки.СчетУчетаНДС;
	Иначе
		НДСКРаспределению = Ложь;
		СчетУчетаНДС = Неопределено;
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ЕстьНДС", ЕстьНДС);
	ПараметрыФормы.Вставить("НДСКРаспределению", НДСКРаспределению);
	ПараметрыФормы.Вставить("СчетУчетаНДС", СчетУчетаНДС);

	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеСтроки, "Валюта") Тогда
		ПараметрыФормы.Вставить("Валюта", ?(ЗначениеЗаполнено(ДанныеСтроки.Валюта), ДанныеСтроки.Валюта,
			ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета) );
	Иначе
		ПараметрыФормы.Вставить("Валюта", ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	КонецЕсли;
	
	// Налоговый учет
	ПараметрыФормы.Вставить("СчетНУ",      ДанныеСтроки.СчетНУ);
	ПараметрыФормы.Вставить("СубконтоНУ1", ДанныеСтроки.СубконтоНУ1);
	ПараметрыФормы.Вставить("СубконтоНУ2", ДанныеСтроки.СубконтоНУ2);
	ПараметрыФормы.Вставить("СубконтоНУ3", ДанныеСтроки.СубконтоНУ3);
	
	ПараметрыСчетаНУ = Новый Структура("ОграниченияСписокСчетов",
		БухгалтерскийУчетКлиентСервер.СписокСчетов("Н08,Н10,Н15,Н20,Н25,Н26,Н41,Н43,Н44,Н91.02,Н97,НПВ", Объект.Дата,, Объект.Организация));
	ПараметрыФормы.Вставить("ПараметрыСчетаНУ", ПараметрыСчетаНУ);
	
	// УСН
	ПараметрыФормы.Вставить("ОтражениеВУСН", ДанныеСтроки.ОтражениеВУСН);
	
	Если ДанныеСтроки.Свойство("ОтразитьВКарточкеКапвложений") Тогда
		// Карточка капвложений
		ПараметрыФормы.Вставить("ОтразитьВКарточкеКапвложений", ДанныеСтроки.ОтразитьВКарточкеКапвложений);
		ПараметрыФормы.Вставить("КарточкаКапвложений", ДанныеСтроки.КарточкаКапвложений);
	Иначе	
		ПараметрыФормы.Вставить("ОтразитьВКарточкеКапвложений", Ложь);
		ПараметрыФормы.Вставить("КарточкаКапвложений", Неопределено);
	КонецЕсли;	
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыСчетаДебета(Дата, Организация, ИФО, КЭК)
	
	ПараметрыСчета = Новый Структура("ОграниченияСписокСчетов",
		БухгалтерскийУчет.СписокСчетов("105.00,106.00,109.00,110.00,206.00,302.00,303.05,304.03,401.20,401.50", Дата,, Организация));
	
	Если ЗначениеЗаполнено(КЭК) Тогда
		Счета208 = БухгалтерскийУчет.СчетПоКоду("208.00", Дата, Организация);
		СчетКредита = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
			КЭК, Счета208, , Дата, Организация, ИФО);
		ПараметрыСчета.Вставить("КорреспонденцияКт", СчетКредита);
	КонецЕсли;
	
	Возврат ПараметрыСчета;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаВыбораОтраженияВУчетеНаКлиенте(СтруктураОтражениеВУчете)
	
	Если ИзменитьВыделенные Тогда
		Для Каждого ТекущаяСтрока Из Элементы[ТекущийЭлемент.Имя].ВыделенныеСтроки Цикл
			ТекущиеДанные = Объект[ТекущийЭлемент.Имя].НайтиПоИдентификатору(ТекущаяСтрока);
			ЗаполнитьАналитикуОтраженияВУчетеВТекущихДанных(ТекущиеДанные, СтруктураОтражениеВУчете);
		КонецЦикла;
	ИначеЕсли ИзменитьВсе Тогда
		Для Каждого ТекущиеДанные Из Объект[ТекущийЭлемент.Имя] Цикл
			ЗаполнитьАналитикуОтраженияВУчетеВТекущихДанных(ТекущиеДанные, СтруктураОтражениеВУчете);
		КонецЦикла;
	Иначе
		ТекущиеДанные = Элементы[ТекущийЭлемент.Имя].ТекущиеДанные;
		ЗаполнитьАналитикуОтраженияВУчетеВТекущихДанных(ТекущиеДанные, СтруктураОтражениеВУчете);
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАналитикуОтраженияВУчетеВТекущихДанных(ТекущиеДанные, СтруктураОтражениеВУчете)
	
	Если ТекущиеДанные.Свойство("ПоДокументу") И ТекущиеДанные.ПоДокументу Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьКЭКДт = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "КЭКДт");
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "Количество")
		И ТекущийЭлемент.Имя <> "Проезд" Тогда
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураОтражениеВУчете,, "КПС, КЭК, Подразделение, Количество");
	Иначе
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураОтражениеВУчете,, "КПС, КЭК, Подразделение");
	КонецЕсли;
	
	Если НЕ ТекущиеДанные.КПС = СтруктураОтражениеВУчете.КПС Тогда
		ТекущиеДанные.КПСДт = СтруктураОтражениеВУчете.КПС;
	Иначе
		ТекущиеДанные.КПСДт = "";
	КонецЕсли;
	
	Если ЕстьКЭКДт Тогда
		Если НЕ ТекущиеДанные.КЭК = СтруктураОтражениеВУчете.КЭК Тогда
			ТекущиеДанные.КЭКДт = СтруктураОтражениеВУчете.КЭК;
		Иначе
			ТекущиеДанные.КЭКДт = "";
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Объект.Подразделение = СтруктураОтражениеВУчете.Подразделение Тогда
		ТекущиеДанные.ПодразделениеДт = СтруктураОтражениеВУчете.Подразделение;
	Иначе
		ТекущиеДанные.ПодразделениеДт = "";
	КонецЕсли;
	
	ТекущиеДанные.СчетДебета      = СтруктураОтражениеВУчете.Счет;
	ТекущиеДанные.СубконтоДебета1 = СтруктураОтражениеВУчете.Субконто1;
	ТекущиеДанные.СубконтоДебета2 = СтруктураОтражениеВУчете.Субконто2;
	ТекущиеДанные.СубконтоДебета3 = СтруктураОтражениеВУчете.Субконто3;
	
	ТекущиеДанные.СчетНУ          = СтруктураОтражениеВУчете.СчетНУ;
	ТекущиеДанные.СубконтоНУ1     = СтруктураОтражениеВУчете.СубконтоНУ1;
	ТекущиеДанные.СубконтоНУ2     = СтруктураОтражениеВУчете.СубконтоНУ2;
	ТекущиеДанные.СубконтоНУ3     = СтруктураОтражениеВУчете.СубконтоНУ3;
	
	//ТекущиеДанные.ОтражениеВУСН   = СтруктураОтражениеВУчете.ОтражениеВУСН;
	
	ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыРасходов(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, Объект.Подразделение, ТекущиеДанные);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокФормВыбораДокументовОснований()
	
	ФормыВыбора = Новый СписокЗначений;
	
	Для Каждого Тип Из Объект.Ссылка.Метаданные().Реквизиты.ДокументОснование.Тип.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		ФормыВыбора.Добавить("Документ."+ОбъектМетаданных.Имя+".ФормаВыбора", ОбъектМетаданных.Синоним);
	КонецЦикла;
	
	ФормыВыбора.СортироватьПоПредставлению();
	
	ФормыВыбораДокументовОснований = ФормыВыбора;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьРеквизитов(Форма)
	
	ОснованиеЗаполнено = ЗначениеЗаполнено(Форма.Объект.ДокументОснование);
	
	РеквизитыИзДокументаОснования = Новый Массив;
	РеквизитыИзДокументаОснования.Добавить("Сотрудник");
	РеквизитыИзДокументаОснования.Добавить("Должность");
	РеквизитыИзДокументаОснования.Добавить("Подразделение");
	РеквизитыИзДокументаОснования.Добавить("ОсобыйСтатус");
	РеквизитыИзДокументаОснования.Добавить("Организация");
	РеквизитыИзДокументаОснования.Добавить("ИФО");
	РеквизитыИзДокументаОснования.Добавить("ТерриторияКомандирования");
	РеквизитыИзДокументаОснования.Добавить("СодержаниеЗадания");
	РеквизитыИзДокументаОснования.Добавить("ОснованиеПринятияОбязательства");
	РеквизитыИзДокументаОснования.Добавить("РазделЛицевогоСчета");
	
	Для Каждого Реквизит Из РеквизитыИзДокументаОснования Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Форма.Элементы, Реквизит, "ТолькоПросмотр", ОснованиеЗаполнено);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииКФОВСтрокеТаблицыРасходов(ТекущиеДанные)
	
	ОтражатьВНалоговомУчете = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(ТекущиеДанные.КФО);
	
	Если НЕ ОтражатьВНалоговомУчете Тогда
		ТекущиеДанные.СчетНУ      = Неопределено;
		ТекущиеДанные.СубконтоНУ1 = Неопределено;
		ТекущиеДанные.СубконтоНУ2 = Неопределено;
		ТекущиеДанные.СубконтоНУ3 = Неопределено;
	КонецЕсли;
	
	ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыРасходов(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, Объект.Подразделение, ТекущиеДанные);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСоответствиеКПСПриПереносеОстатков()
	
	СоответствиеКПСПриПереносеОстатков.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РешениеОКомандированииФинансовоеОбеспечение.КПС КАК КПС
	|ПОМЕСТИТЬ ВТ_КПС
	|ИЗ
	|	Документ.РешениеОКомандировании.ФинансовоеОбеспечение КАК РешениеОКомандированииФинансовоеОбеспечение
	|ГДЕ
	|	РешениеОКомандированииФинансовоеОбеспечение.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РешениеОКомпенсацииРасходовДляКрайнегоСевераФинансовоеОбеспечение.КПС
	|ИЗ
	|	Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера.ФинансовоеОбеспечение КАК РешениеОКомпенсацииРасходовДляКрайнегоСевераФинансовоеОбеспечение
	|ГДЕ
	|	РешениеОКомпенсацииРасходовДляКрайнегоСевераФинансовоеОбеспечение.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъемаТоварыРаботыУслуги.КПС
	|ИЗ
	|	Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги КАК ЗаявкаОбоснованиеЗакупкиМалогоОбъемаТоварыРаботыУслуги
	|ГДЕ
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъемаТоварыРаботыУслуги.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъемаТоварыРаботыУслуги.КПС
	|ИЗ
	|	Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо.ТоварыРаботыУслуги КАК ЗаявкаОбоснованиеЗакупкиМалогоОбъемаТоварыРаботыУслуги
	|ГДЕ
	|	ЗаявкаОбоснованиеЗакупкиМалогоОбъемаТоварыРаботыУслуги.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоответствиеКПСПриПереносеОстатков.СтарыйКПС КАК СтарыйКПС,
	|	СоответствиеКПСПриПереносеОстатков.НовыйКПС КАК НовыйКПС,
	|	СоответствиеКПСПриПереносеОстатков.ДатаЗамены КАК ДатаЗамены
	|ИЗ
	|	РегистрСведений.СоответствиеКПСПриПереносеОстатков КАК СоответствиеКПСПриПереносеОстатков
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КПС КАК ВТ_КПС
	|		ПО СоответствиеКПСПриПереносеОстатков.СтарыйКПС = ВТ_КПС.КПС
	|ГДЕ
	|	СоответствиеКПСПриПереносеОстатков.ДатаЗамены <= &ТекущаяДата";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ДокументОснование);
	
	ДатаДокумента = ?(ЗначениеЗаполнено(Объект.ДатаУтверждения), Объект.ДатаУтверждения,
					?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса()));
	
	Запрос.УстановитьПараметр("ТекущаяДата", ДатаДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СоответствиеКПСПриПереносеОстатков.Добавить(), Выборка);
	КонецЦикла;
	
КонецФункции

&НаСервере
Процедура ОбновитьКПССУчетомПереноса()
	
	ТабличныеЧастиСКПС = Новый Массив;
	ТабличныеЧастиСКПС.Добавить(Объект["Суточные"]);
	ТабличныеЧастиСКПС.Добавить(Объект["Проезд"]);
	ТабличныеЧастиСКПС.Добавить(Объект["Проживание"]);
	ТабличныеЧастиСКПС.Добавить(Объект["ПрочиеРасходы"]);
	ТабличныеЧастиСКПС.Добавить(Объект["ТоварыРаботыУслуги"]);
	ТабличныеЧастиСКПС.Добавить(Объект["ДенежныеОбязательства"]);
	ТабличныеЧастиСКПС.Добавить(Авансы);
	ТабличныеЧастиСКПС.Добавить(ДенежныеОбязательстваПоОснованию);
	
	Для Каждого ТабличнаяЧасть Из ТабличныеЧастиСКПС Цикл
		Для Каждого Строка Из ТабличнаяЧасть Цикл
			Для Каждого СоответствиеКПС Из СоответствиеКПСПриПереносеОстатков Цикл
				Если Строка.КПС = СоответствиеКПС.СтарыйКПС
					И Объект.ДатаУтверждения >= СоответствиеКПС.ДатаЗамены Тогда
					Строка.КПС = СоответствиеКПС.НовыйКПС;
				ИначеЕсли Строка.КПС = СоответствиеКПС.НовыйКПС
					И Объект.ДатаУтверждения < СоответствиеКПС.ДатаЗамены Тогда
					Строка.КПС = СоответствиеКПС.СтарыйКПС;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

