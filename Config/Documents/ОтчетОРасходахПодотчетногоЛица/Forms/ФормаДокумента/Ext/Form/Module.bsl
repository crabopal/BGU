&НаКлиенте
Процедура УстановитьЗначенияНДСПоУмолчанию(СтрокаТаблицы)
	
	СтрокаТаблицы.СчетУчетаНДС = СчетУчетаНДС(СтрокаТаблицы.НДСКРаспределению, Объект.Дата, Объект.Организация);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СчетУчетаНДС(НДСКРаспределению, Дата, Организация)
	
	СчетСтрока = ?(НДСКРаспределению, "210.Н2", "210.Р2");
	
	Возврат БухгалтерскийУчет.СчетПоКоду(СчетСтрока, Дата, Организация);
	
КонецФункции

&НаКлиенте
Процедура УстановитьНомерДатуСФВТекущейСтроке(Элемент)
	
	ИмяТаблицы = ПолучитьИмяТаблицыФормы(Элемент);
	
	ТекДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ПрочитатьНомерДатуСФ(ТекДанные.СчетФактура));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьНомерДатуСФ(СчетФактура)
	
	Результат = Новый Структура();
	
	Если ЗначениеЗаполнено(СчетФактура) Тогда
		// Документ СчетФактураПолученный
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "НомерПервичногоДокумента,ДатаПервичногоДокумента");
		
		Результат.Вставить("НомерСФ", ЗначенияРеквизитов.НомерПервичногоДокумента);
		Результат.Вставить("ДатаСФ", ЗначенияРеквизитов.ДатаПервичногоДокумента);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


&НаКлиенте
Процедура РассчитатьНДСВСтроке(Элемент)
	
	ИмяТаблицы = ПолучитьИмяТаблицыФормы(Элемент);
	
	ТекДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура("Сумма, СтавкаНДС");
	СтруктураПараметров.СтавкаНДС = ТекДанные.СтавкаНДС;
	СтруктураПараметров.Сумма = ТекДанные.СуммаПринято;
	
	ИмяРеквизитаСуммаВключаетНДС = ПолучитьИмяРеквизитаСуммаВключаетНДС(ЭтаФорма, ИмяТаблицы);
	
	ТекДанные.СуммаНДС = УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтруктураПараметров, Объект[ИмяРеквизитаСуммаВключаетНДС]);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВыбораСуммаВключаетНДС(Результат, ДополнительныеПараметры) Экспорт
	
	ОбновитьТаблицуДенежныеОбязательства();
	
	ОбновитьПодсказкуРазницаДО(ЭтотОбъект);
	
	ОбновитьИтоги(ЭтотОбъект);
	
	УстановитьЗаголовокКомандыСуммаВключаетНДС(ЭтотОбъект, ДополнительныеПараметры);
	
	ПодтвердитьИПересчитатьСуммыНалогаВТабличнойЧасти(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокКомандыСуммаВключаетНДС(Форма, ДополнительныеПараметры = Неопределено)
	
	ИменаРеквизитов = Новый Массив();
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ИменаРеквизитов.Добавить("СуммаВключаетНДС");
		ИменаРеквизитов.Добавить("СуммаВключаетНДСПроезд");
		ИменаРеквизитов.Добавить("СуммаВключаетНДСПроживание");
		ИменаРеквизитов.Добавить("СуммаВключаетНДСПрочиеРасходы");
	Иначе
		ИменаРеквизитов.Добавить(ДополнительныеПараметры.ИмяРеквизитаСуммаВключаетНДС);
	КонецЕсли;
	
	Для Каждого ИмяРеквизитаСуммаВключаетНДС Из ИменаРеквизитов Цикл
		ПараметрыПредставления = Новый Структура("СуммаВключаетНДС, ПоказыватьНДС", Форма.Объект[ИмяРеквизитаСуммаВключаетНДС], Истина);
		
		ИмяТЧ = ПолучитьИмяТабличнойЧастиСуммаВключаетНДС(Форма, ИмяРеквизитаСуммаВключаетНДС);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, ИмяТЧ + ИмяРеквизитаСуммаВключаетНДС, "Заголовок",
			БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(ПараметрыПредставления));
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеПредъявленСФ(Элемент)
	
	ИмяТаблицы = ПолучитьИмяТаблицыФормы(Элемент);
	
	ТекДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.БланкСтрогойОтчетности = ТекДанные.ПредъявленСФ;
	
	Если Не ТекДанные.ПредъявленСФ Тогда
		ТекДанные.ДатаСФ      = '00010101';
		ТекДанные.НомерСФ     = "";
		ТекДанные.СчетФактура = Неопределено;
		
		Если ИмяТаблицы = "Проезд" Или ИмяТаблицы = "Проживание" Или ИмяТаблицы = "ПрочиеРасходы" Тогда
			ТекДанные.Контрагент = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаВключаетНДСПриНажатии(Команда)
	
	ИмяРеквизитаОбъекта = Команда.Имя;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяРеквизитаСуммаВключаетНДС", ИмяРеквизитаОбъекта);
	ДополнительныеПараметры.Вставить("ИмяТабличнойЧасти", ПолучитьИмяТабличнойЧастиСуммаВключаетНДС(ЭтаФорма, ИмяРеквизитаОбъекта));
	
	ИменаРеквизитов = Новый Структура();
	ИменаРеквизитов.Вставить("СуммаВключаетНДС", ИмяРеквизитаОбъекта);
	
	БухгалтерскийУчетКлиент.ПоказатьФормуВыбораТипаЦеныВалютыНДС(ЭтотОбъект, Ложь,
		Новый ОписаниеОповещения("ПослеЗакрытияВыбораСуммаВключаетНДС", ЭтотОбъект, ДополнительныеПараметры),
		ИменаРеквизитов);
		
КонецПроцедуры


&НаКлиенте
Процедура ПодтвердитьИПересчитатьСуммыНалогаВТабличнойЧасти(ДополнительныеПараметры)
	
	ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ПодтвердитьИПересчитатьСуммыНалогаВТабличнойЧасти_Выбор", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещенияВыбор, НСтр("ru='Пересчитать суммы налога в табличной части?'"), РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да,, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИПересчитатьСуммыНалогаВТабличнойЧасти_Выбор(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьСуммыНалогаВТабличнойЧасти(ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммыНалогаВТабличнойЧасти(ДополнительныеПараметры)
	
	ИмяРеквизитаСуммаВключаетНДС	= ДополнительныеПараметры.ИмяРеквизитаСуммаВключаетНДС;
	ИмяТабличнойЧасти				= ДополнительныеПараметры.ИмяТабличнойЧасти;
	
	СтруктураПараметров = Новый Структура("Сумма, СтавкаНДС");
	
	СуммаВключаетНДС = Объект[ИмяРеквизитаСуммаВключаетНДС];
	
	Для Каждого СтрокаТаблицы Из Объект[ИмяТабличнойЧасти] Цикл
		СтруктураПараметров.СтавкаНДС = СтрокаТаблицы.СтавкаНДС;
		СтруктураПараметров.Сумма = СтрокаТаблицы.СуммаПринято;
		
		СтрокаТаблицы.СуммаНДС = УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтруктураПараметров, СуммаВключаетНДС);
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ПроверитьИСоздатьСчетаФактуры(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекстСообщения = НСтр("ru='Этот документ еще не записан.
			|Создание и обновление счетов-фактур предусмотрено только для сохраненного документа.'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяТабличнойЧасти", ПолучитьИмяТабличнойЧастиПоИмениКоманды(Команда));
	
	ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("СоздатьСчетаФактуры_Выбор", ЭтотОбъект, ДополнительныеПараметры);
	
	ТекстСообщения = НСтр("ru='Будут созданы документы Счет-фактура полученный
		|для тех строк табличной части, в которых не указан документ счета-фактуры.
		|Будут обновлены счета-фактуры, указанные в строках табличной части.
		|
		|Продолжить и создать и обновить документы счетов-фактур?'");
	
	ПоказатьВопрос(ОписаниеОповещенияВыбор, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да,, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИмяТабличнойЧастиПоИмениКоманды(Команда)
	
	ИмяКоманды = Команда.Имя;
	
	Если ИмяКоманды = "СоздатьСчетаФактуры" Или ИмяКоманды = "УдалитьСчетаФактуры" Тогда
		Возврат "ТоварыРаботыУслуги";
		
	ИначеЕсли ИмяКоманды = "СоздатьСчетаФактурыПроезд" Или ИмяКоманды = "УдалитьСчетаФактурыПроезд" Тогда
		Возврат "Проезд";
		
	ИначеЕсли ИмяКоманды = "СоздатьСчетаФактурыПроживание" Или ИмяКоманды = "УдалитьСчетаФактурыПроживание" Тогда
		Возврат "Проживание";
		
	ИначеЕсли ИмяКоманды = "СоздатьСчетаФактурыПрочиеРасходы" Или ИмяКоманды = "УдалитьСчетаФактурыПрочиеРасходы" Тогда
		Возврат "ПрочиеРасходы";
	КонецЕсли;
	
	Возврат "";
КонецФункции

&НаКлиенте
Процедура СоздатьСчетаФактуры_Выбор(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьСчетаФактурыКлиент(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСчетаФактурыКлиент(ДополнительныеПараметры)
	
	Статистика = СоздатьСчетаФактурыСервер(ДополнительныеПараметры);
	
	Если Статистика = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ТекстСообщения = СтрШаблон(НСтр("ru='Успешно создано новых документов: %1
		|Успешно обновлено существующих документов: %2'"),
		Статистика.Создано.Количество(),
		Статистика.Обновлено.Количество());
	
	ПоказатьПредупреждение(, ТекстСообщения, 20);
	
КонецПроцедуры

&НаСервере
Функция СоздатьСчетаФактурыСервер(ДополнительныеПараметры)
	
	ИмяТабличнойЧасти = ДополнительныеПараметры.ИмяТабличнойЧасти;
	
	Отказ = Ложь;
	
	Документы.ОтчетОРасходахПодотчетногоЛица.ПроверитьЗаполненностьКолонокНДС(Объект, Отказ, Ложь, ИмяТабличнойЧасти);
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Статистика = Документы.ОтчетОРасходахПодотчетногоЛица.СформироватьПодчиненныеСчетаФактуры(Объект, ИмяТабличнойЧасти);
	
	Возврат Статистика;
	
КонецФункции


&НаКлиенте
Процедура ПодтвердитьИУдалитьСчетаФактуры()
	
	МассивДокументов = ПолучитьНеиспользуемыеСчетаФактуры();
	
	КоличествоДокументов = МассивДокументов.Количество();
	
	Если КоличествоДокументов = 0 Тогда
		ТекстСообщения = НСтр("ru='Не обнаружены неиспользуемые документы счетов-фактур'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = СтрШаблон(НСтр("ru='Обнаружено неиспользуемых документов счетов-фактур: %1
		|
		|Это счета-фактуры, созданные ранее на основании данного документа, но не указанные в строках табличной части.
		|
		|Продолжить и удалить неиспользуемые документы счетов-фактур?'"),
		КоличествоДокументов);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("МассивДокументов", МассивДокументов);
	
	ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("УдалитьСчетаФактуры_Выбор", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещенияВыбор, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да,, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНеиспользуемыеСчетаФактуры()
	
	Возврат Документы.ОтчетОРасходахПодотчетногоЛица.ПолучитьНеиспользуемыеСчетаФактуры(Объект);
	
КонецФункции

&НаКлиенте
Процедура УдалитьСчетаФактуры_Выбор(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьСчетаФактурыКлиент(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСчетаФактурыКлиент(ДополнительныеПараметры)
	
	МассивДокументов = ДополнительныеПараметры.МассивДокументов;
	
	УдалитьСчетаФактурыСервер(МассивДокументов);
	
	ТекстСообщения = СтрШаблон(НСтр("ru='Успешно помечено на удаление документов: %1'"),
		МассивДокументов.Количество());
	
	ПоказатьПредупреждение(, ТекстСообщения, 20);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьСчетаФактурыСервер(МассивДокументов)
	
	Документы.ОтчетОРасходахПодотчетногоЛица.УдалитьСчетаФактуры(МассивДокументов);
	
КонецПроцедуры

#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыДенежныеОбязательства(СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокДО = НСтр("ru = 'ДО:'");
	СтрокаТаблицы.ЗаголовокБО = НСтр("ru = 'БО:'");
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивомНаСервере(Знач Параметры) Экспорт
	ОбменСАрхивом.ВыполнитьПодключаемуюКоманду(ЭтотОбъект, Параметры);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти
