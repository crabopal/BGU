&НаСервереБезКонтекста
Функция СвойстваНоменклатуры(Номенклатура)
	
	Результат = Новый Структура;
	Результат.Вставить("ОКПД");
	Результат.Вставить("ЕдиницаИзмерения");
	
	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		Результат.ОКПД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ОКП");
		Результат.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		Результат.ОКПД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ОКП");
		Результат.ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ЕдиницаИзмерения");
	ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ДенежныеДокументы") Тогда
		Результат.ОКПД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "Владелец.ОКП");
		Результат.ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ЕдиницаИзмерения");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

