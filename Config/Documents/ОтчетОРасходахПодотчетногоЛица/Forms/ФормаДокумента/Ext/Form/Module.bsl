Процедура ОбновитьИтоги(Форма)
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("Суточные");
	МассивТЧ.Добавить("Проезд");
	МассивТЧ.Добавить("Проживание");
	МассивТЧ.Добавить("ПрочиеРасходы");
	МассивТЧ.Добавить("ТоварыРаботыУслуги");
	
	ИтогоФакт = 0;
	ИтогоПринято = 0;
	
	Для Каждого ТЧ Из МассивТЧ Цикл
		Для Каждого СтрокаТЧ Из Форма.Объект[ТЧ] Цикл
			ИтогоФакт = ИтогоФакт + СтрокаТЧ.СуммаФакт;
			ИтогоПринято = ИтогоПринято + СтрокаТЧ.СуммаПринято;
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТЧ, "СуммаНДС")
				И НЕ Форма.Объект.СуммаВключаетНДС Тогда
				ИтогоПринято = ИтогоПринято + СтрокаТЧ.СуммаНДС;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Форма.ИтогоФакт = ИтогоФакт;
	Форма.ИтогоПринято = ИтогоПринято;
	
КонецПроцедуры

