&НаКлиенте
Асинх Процедура ВыбратьДокументОснование()
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Ответ = Ждать ВопросАсинх(
			НСтр("ru = 'После выбора другого основания реквизиты и табличные части документа будут перезаполнены. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет,
			60);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ВыбранныйЭлемент = Ждать ФормыВыбораДокументовОснований.ВыбратьЭлементАсинх(НСтр("ru='Выбор типа данных'"));
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.ДокументОснование);
	
	Если ЗначениеЗаполнено(Объект.Сотрудник) Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("Сотрудник", Объект.Сотрудник);
		Отбор.Вставить("ПодотчетноеЛицо", Объект.Сотрудник);
		ПараметрыФормы.Вставить("Отбор", Отбор);
	КонецЕсли;
	
	ОткрытьФорму(ВыбранныйЭлемент.Значение, ПараметрыФормы, , , , ,
		Новый ОписаниеОповещения("ПослеВыбораДокументаОснования", ЭтотОбъект, ВыбранныйЭлемент.Значение));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораДокументаОснования(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(РезультатЗакрытия) Тогда
		Объект.ДокументОснование = РезультатЗакрытия;
	Иначе
		Объект.ДокументОснование = ПредопределенноеЗначение(
			"Документ." + СтрРазделить(ДополнительныеПараметры, ".")[1] + ".ПустаяСсылка");
	КонецЕсли;
	
	ЗаполнитьПоДокументуОснованиюНаСервере();
	
	Модифицированность = Истина;
	
КонецПроцедуры

