Процедура СуточныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "СуточныеОтражениеВУчете" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ИзменитьВыделенные = Ложь;
		ИзменитьВсе = Ложь;
		
		ОткрытьФормуНастройкиОтраженияВУчете(Элемент.ТекущиеДанные);
		
	КонецЕсли;
	
