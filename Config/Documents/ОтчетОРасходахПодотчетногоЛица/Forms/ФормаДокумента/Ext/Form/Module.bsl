&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЭтоКомандировка = ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РешениеОКомандировании");
	ЭтоЗакупка = ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъема");
	ЭтоЗакупкаЧерезПодотчетноеЛицо = ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо");
	ЭтоКрайнийСевер = ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РешениеОКомпенсацииРасходовДляКрайнегоСевера");
	
	ОбновитьТаблицуАвансов();
	
	ОбновитьТаблицуДенежныеОбязательстваПоОснованию();
	
	ОбновитьТаблицуДенежныеОбязательства(Истина);
	
	ОбновитьПодсказкуРазницаДО(ЭтотОбъект);
	
	ОбновитьИтоги(ЭтотОбъект);
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
	УстановитьВидимостьРеквизитов(ЭтотОбъект);
	
	УстановитьДоступностьРеквизитов(ЭтотОбъект);
	
	УстановитьОграниченияТипа(ЭтотОбъект);
	
	УстановитьПредставлениеСтрокиСпособВыдачиДС(ЭтотОбъект);
	
	УстановитьПредставлениеСтрокиКурсыВалют(ЭтотОбъект);
	
	ЗаполнитьСписокФормВыбораДокументовОснований();
	
	ТерриторияКомандированияРФ = НЕ Объект.КомандировкаЗаГраницу;
	
	Если Объект.СпособыВыдачи.Количество() > 0 Тогда
		СпособВыдачиДенежныхСредств = Объект.СпособыВыдачи[0].СпособВыдачи;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ДатаДокументаОснования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "Дата");
	КонецЕсли;
	
	СоответствиеСуммаВключаетНДС = Новый ФиксированноеСоответствие(Документы.ОтчетОРасходахПодотчетногоЛица.ПолучитьСоответствиеСуммаВключаетНДС());
	
	УстановитьЗаголовокКомандыСуммаВключаетНДС(ЭтаФорма);
	
КонецПроцедуры

