#Область ФормированиеСчетовФактур

Процедура ПроверитьЗаполнениеКолонокСФ(ДокументОбъект, Отказ, ПроверитьКолонкуСчетФактура, ИмяТЧ, ПредставлениеТЧ)
	
	ШаблонПрефикс = ИмяТЧ + "[%1].%2";
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТЧ] Цикл
		
		Если Не СтрокаТаблицы.ПредъявленСФ Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаСФ) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Дата счета-фактуры'"),
			СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
			
			Поле = СтрШаблон(ШаблонПрефикс,
			Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ="),
			"ДатаСФ");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если ПустаяСтрока(СтрокаТаблицы.НомерСФ) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Номер счета-фактуры'"),
			СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
			
			Поле = СтрШаблон(ШаблонПрефикс,
			Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ="),
			"НомерСФ");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если ПустаяСтрока(СтрокаТаблицы.Контрагент) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Контрагент'"),
			СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
			
			Поле = СтрШаблон(ШаблонПрефикс,
			Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ="),
			"Контрагент");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если ПроверитьКолонкуСчетФактура И Не ЗначениеЗаполнено(СтрокаТаблицы.СчетФактура) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Счет-фактура'"),
			СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
			
			Поле = СтрШаблон(ШаблонПрефикс,
			Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ="),
			"СчетФактура");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СчетУчетаНДС) И СтрокаТаблицы.СуммаНДС > 0 Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Счет учета НДС'"),
			СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
			
			Поле = СтрШаблон(ШаблонПрефикс,
			Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ="),
			"СчетУчетаНДС");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.КФО) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'КФО'"),
			СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
			
			Поле = СтрШаблон(ШаблонПрефикс,
			Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ="),
			"КФО");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.КПС) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'КПС'"),
			СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
			
			Поле = СтрШаблон(ШаблонПрефикс,
			Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ="),
			"КПС");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, Поле, "Объект", Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИменаПолейПоискаСФвТабличнойЧасти()
	
	Возврат "Контрагент, НомерСФ, ДатаСФ, БланкСтрогойОтчетности";
	
КонецФункции

// Возвращает таблицу подчиненных счетов-фактур для данного ОтчетОРасходахПодотчетногоЛица
//
// Параметры
//   ДокументОбъект - ДокументОбъект.ОтчетОРасходахПодотчетногоЛица - ОтчетОРасходахПодотчетногоЛица,
//                    для которого нужно сформировать счета-фактуры.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица подчиненных счетов-фактур.
//
Функция ПолучитьТаблицуПодчиненныхСчетовФактур(ДокументОбъект)
	
	Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДокументОснование", ДокументОбъект.Ссылка);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СчетФактураПолученный.Ссылка КАК Ссылка,
		|	СчетФактураПолученный.Ссылка.НомерПервичногоДокумента КАК НомерСФ,
		|	СчетФактураПолученный.Ссылка.ДатаПервичногоДокумента КАК ДатаСФ,
		|	СчетФактураПолученный.Ссылка.Контрагент КАК Контрагент,
		|	СчетФактураПолученный.Ссылка.БланкСтрогойОтчетности КАК БланкСтрогойОтчетности,
		|	СчетФактураПолученный.Ссылка.Проведен,
		|	СчетФактураПолученный.Ссылка.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Документ.СчетФактураПолученный.ДокументыОснования КАК СчетФактураПолученный
		|ГДЕ
		|	СчетФактураПолученный.ДокументОснование = &ДокументОснование
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетФактураПолученный.Ссылка.Дата,
		|	ПометкаУдаления УБЫВ,
		|	Ссылка";
		ТаблицаСФ = Запрос.Выполнить().Выгрузить();
		
	Иначе // пустая таблица с аналогичными колонками
		
		ТаблицаСФ = Новый ТаблицаЗначений();
		ТаблицаСФ.Колонки.Добавить("Ссылка",          Новый ОписаниеТипов("ДокументСсылка.СчетФактураПолученный"));
		ТаблицаСФ.Колонки.Добавить("НомерСФ",         Новый ОписаниеТипов("Строка"));
		ТаблицаСФ.Колонки.Добавить("ДатаСФ",          Новый ОписаниеТипов("Дата"));
		ТаблицаСФ.Колонки.Добавить("Контрагент",      Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		ТаблицаСФ.Колонки.Добавить("БланкСтрогойОтчетности",Новый ОписаниеТипов("Булево"));
		ТаблицаСФ.Колонки.Добавить("Проведен",        Новый ОписаниеТипов("Булево"));
		ТаблицаСФ.Колонки.Добавить("ПометкаУдаления", Новый ОписаниеТипов("Булево"));
		
	КонецЕсли;
	
	ТаблицаСФ.Колонки.Добавить("Использован", Новый ОписаниеТипов("Булево"));
	Возврат ТаблицаСФ;
	
КонецФункции

Функция ДанныеСчетовФактурПоДокументу(ДокументОбъект, ИмяТабличнойЧасти)
	
	Счета208 = БухгалтерскиеОперации.СчетПоКоду("208.00", ДокументОбъект.Дата);
	
	Поиск = Новый Структура("НомерСтроки", -1);
	
	ИменаКолонок = "Контрагент,НомерСФ,ДатаСФ,СчетФактура,БланкСтрогойОтчетности,КФО,КПС,КЭК,СуммаПринято,СтавкаНДС,СуммаНДС,НДСКРаспределению,СчетУчетаНДС";
	
	Если ИмяТабличнойЧасти <> "Проживание" Тогда
		ИменаКолонок = ИменаКолонок + ",Количество";
	КонецЕсли;
	
	ДанныеСчетовФактур = ДокументОбъект.ТоварыРаботыУслуги.Выгрузить(Поиск, ИменаКолонок);
	
	Если ИмяТабличнойЧасти = "Проживание" Тогда
		ДанныеСчетовФактур.Колонки.Добавить("Количество", ОбщегоНазначения.ОписаниеТипаЧисло(15,3,ДопустимыйЗнак.Неотрицательный));
	КонецЕсли;
	
	ДанныеСчетовФактур.Колонки.Добавить("СчетКредита", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ДанныеСчетовФактур.Колонки.Добавить("ВидЦенности", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыЦенностейНДС"));
	ДанныеСчетовФактур.Колонки.Добавить("НФА",         Новый ОписаниеТипов("СправочникСсылка.Номенклатура,СправочникСсылка.ОсновныеСредства,Строка"));
	ДанныеСчетовФактур.Колонки.Добавить("Всего",       ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 2));
	ДанныеСчетовФактур.Колонки.Добавить("ЕдиницаИзмерения",	Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ДанныеСчетовФактур.Колонки.Найти("СуммаПринято").Имя	= "Сумма";
	ДанныеСчетовФактур.Колонки.Найти("КПС").Имя				= "КПСВычетКт";
	ДанныеСчетовФактур.Колонки.Найти("СчетУчетаНДС").Имя	= "СчетВычетКт";
	
	ЕдиницаИзмеренияШт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	
	ИмяРеквизитаСуммаВключаетНДС = ПолучитьИмяРеквизитаСуммаВключаетНДС(ИмяТабличнойЧасти);
	
	Для Каждого СтрокаТабличнойЧасти Из ДокументОбъект[ИмяТабличнойЧасти] Цикл
		
		Если Не СтрокаТабличнойЧасти.ПредъявленСФ Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДанныеСчетовФактур.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТабличнойЧасти);
		
		Если ИмяТабличнойЧасти = "Проживание" Тогда
			НоваяСтрока.Количество = 1;
		КонецЕсли;
		
		// ВидЦенности
		НоваяСтрока.ВидЦенности = ВидЦенностиПоСчетуДебета(СтрокаТабличнойЧасти.СчетДебета);
		
		// НФА
		СвойстваСчетаДебета  = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТабличнойЧасти.СчетДебета);
		АналитикаСчетаДебета = Новый Соответствие;
		АналитикаСчетаДебета.Вставить(СвойстваСчетаДебета.ВидСубконто1, СтрокаТабличнойЧасти.СубконтоДебета1);
		АналитикаСчетаДебета.Вставить(СвойстваСчетаДебета.ВидСубконто2, СтрокаТабличнойЧасти.СубконтоДебета2);
		АналитикаСчетаДебета.Вставить(СвойстваСчетаДебета.ВидСубконто3, СтрокаТабличнойЧасти.СубконтоДебета3);
		
		НФА = Неопределено;
		ЕдиницаИзмерения = ЕдиницаИзмеренияШт; // шт.
		
		Если НоваяСтрока.ВидЦенности = Перечисления.ВидыЦенностейНДС.Материалы Тогда
			
			НФА = АналитикаСчетаДебета.Получить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
			ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НФА, "ЕдиницаИзмерения");
			
		ИначеЕсли НоваяСтрока.ВидЦенности = Перечисления.ВидыЦенностейНДС.ОС Тогда
			
			НФА = АналитикаСчетаДебета.Получить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
			
		КонецЕсли;
		
		Если НФА = Неопределено Тогда
			Если ИмяТабличнойЧасти <> "ТоварыРаботыУслуги" Тогда
				НФА = СтрокаТабличнойЧасти.НаименованиеРасхода;
			ИначеЕсли ТипЗнч(СтрокаТабличнойЧасти.Номенклатура) = Тип("СправочникСсылка.Номенклатура")
				Или ТипЗнч(СтрокаТабличнойЧасти.Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
				НФА = СтрокаТабличнойЧасти.Номенклатура;
			Иначе
				НФА = Строка(СтрокаТабличнойЧасти.Номенклатура);
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.НФА = НФА;
		
		НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
		
		Если ДокументОбъект[ИмяРеквизитаСуммаВключаетНДС] Тогда
			НоваяСтрока.Сумма = СтрокаТабличнойЧасти.СуммаПринято - СтрокаТабличнойЧасти.СуммаНДС;
		Иначе
			НоваяСтрока.Сумма = СтрокаТабличнойЧасти.СуммаПринято;
		КонецЕсли;
		
		НоваяСтрока.Всего = НоваяСтрока.Сумма + НоваяСтрока.СуммаНДС;
		
		НоваяСтрока.СчетВычетКт = СтрокаТабличнойЧасти.СчетУчетаНДС;
		НоваяСтрока.КПСВычетКт = СтрокаТабличнойЧасти.КПС;
		
		НоваяСтрока.СчетКредита = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(СтрокаТабличнойЧасти.КЭК, Счета208, , ДокументОбъект.Дата);
	КонецЦикла;
	
	Возврат ДанныеСчетовФактур;
	
КонецФункции

Функция ПолучитьИмяРеквизитаСуммаВключаетНДС(ИмяТабличнойЧасти)
	
	СоответствиеСуммаВключаетНДС = ПолучитьСоответствиеСуммаВключаетНДС();
	
	Для Каждого Элемент Из СоответствиеСуммаВключаетНДС Цикл
		Если Элемент.Значение = ИмяТабличнойЧасти Тогда
			Возврат Элемент.Ключ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ВидЦенностиПоСчетуДебета(Счет)
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат Перечисления.ВидыЦенностейНДС.Прочее;
	КонецЕсли;
	
	Если ТипЗнч(Счет) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		КодСчета = Лев(Счет.Код,3);
		Если КодСчета = "105" Тогда
			Возврат Перечисления.ВидыЦенностейНДС.Материалы;
		ИначеЕсли КодСчета = "106" Тогда
			Возврат Перечисления.ВидыЦенностейНДС.ОС;
		ИначеЕсли КодСчета = "206" Тогда
			Возврат Перечисления.ВидыЦенностейНДС.Аванс;
		ИначеЕсли КодСчета = "109" ИЛИ КодСчета = "401" Тогда
			Возврат Перечисления.ВидыЦенностейНДС.Услуги;
		Иначе
			Возврат Перечисления.ВидыЦенностейНДС.Прочее;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Перечисления.ВидыЦенностейНДС.Прочее;
	
КонецФункции

Функция НайтиСтрокуСчетаФактуры(ТаблицаСФ, СтрокаДокумента)
	
	СтруктураПоиска = Новый Структура(ПолучитьИменаПолейПоискаСФвТабличнойЧасти());
	
	ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаДокумента);
	
	Если ЗначениеЗаполнено(СтрокаДокумента.СчетФактура) Тогда
		СтруктураПоиска.Вставить("Ссылка", СтрокаДокумента.СчетФактура);
		
		НайденныеСтроки = ТаблицаСФ.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			Возврат НайденныеСтроки[0];
		КонецЕсли;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура(ПолучитьИменаПолейПоискаСФвТабличнойЧасти());
	
	ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаДокумента);
	
	НайденныеСтроки = ТаблицаСФ.НайтиСтроки(СтруктураПоиска);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат НайденныеСтроки[0];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЗаполнитьСчетФактуруПоОтчетуОРасходахПодотчетногоЛица(ДокументСФ, ДокументОбъект, ДокументСсылка, СтрокаТаблицы, ТаблицаНФА)
	
	// Шапка
	ЗаполнитьЗначенияСвойств(ДокументСФ, ДокументОбъект, "Дата,Организация,Подразделение,ИФО,СуммаВключаетНДС");
	
	ДокументСФ.Контрагент               = СтрокаТаблицы.Контрагент;
	ДокументСФ.НомерПервичногоДокумента = СтрокаТаблицы.НомерСФ;
	ДокументСФ.ДатаПервичногоДокумента  = СтрокаТаблицы.ДатаСФ;
	
	ДокументСФ.БланкСтрогойОтчетности   = СтрокаТаблицы.БланкСтрогойОтчетности;
	ДокументСФ.КодСпособаВыставления    = 1;
	Если НЕ ЗначениеЗаполнено(ДокументСФ.ДатаПервичногоДокумента) ИЛИ ДокументСФ.ДатаПервичногоДокумента >= '20150101' Тогда
		ДокументСФ.КодВидаОперации        = "23";
		ДокументСФ.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Покупка;
	Иначе
		Если ДокументСФ.ВидЦенности = Перечисления.ВидыЦенностейНДС.Аванс Тогда
			ДокументСФ.КодВидаОперации        = "02";
			ДокументСФ.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансВыданный;
		Иначе
			ДокументСФ.КодВидаОперации        = "01";
			ДокументСФ.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Покупка;
		КонецЕсли;
	КонецЕсли;
	ДокументСФ.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	ДокументСФ.Комментарий     = "Создан автоматически на основании Отчета о расходах подотчетного лица.";
	
	// Табличная часть "Состав НФА"
	ДокументСФ.СоставНФА.Очистить();
	
	Поиск = Новый Структура("Контрагент, НомерСФ, ДатаСФ, БланкСтрогойОтчетности");
	ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
	
	МассивСтрокНФА = ТаблицаНФА.НайтиСтроки(Поиск);
	Для Каждого СтрокаНФА Из МассивСтрокНФА Цикл
		
		НоваяСтрока = ДокументСФ.СоставНФА.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаНФА);
		НоваяСтрока.Счет30304         = ПланыСчетов.ЕПСБУ.НайтиПоКоду("303.04");
		НоваяСтрока.ДокументОснование = ДокументСсылка;
		НоваяСтрока.НДСКВычету        = Истина;
		НоваяСтрока.СчетРасчетов      = СтрокаНФА.СчетКредита;
		
	КонецЦикла;
	
	Если ДокументСФ.ЭтоНовый() Тогда
		ДокументСФ.Записать(); // запишем, чтобы можно было использовать Ссылку
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура УстановитьСФТиповуюОперациюПоУмолчанию(ДокументОбъектСФ)
	
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(ДокументОбъектСФ));
	
	ТиповаяОперация = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(ИдентификаторДокумента);
	
	Если ЗначениеЗаполнено(ТиповаяОперация) Тогда
		ДополнительныеРеквизиты = БухгалтерскиеОперацииСервер.РеквизитыТиповойОперацииПоУмолчанию(ИдентификаторДокумента,ТиповаяОперация,ДокументОбъектСФ.Организация);
		
		БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(ДокументОбъектСФ, ТиповаяОперация, ДополнительныеРеквизиты);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОтчетОРасходахПодотчетногоЛица.Ссылка КАК Ссылка,
	|	ОтчетОРасходахПодотчетногоЛица.ДокументОснование КАК ДокументОснование,
	|	СУММА(ОтчетОРасходахПодотчетногоЛицаДенежныеОбязательства.СуммаБОПоОснованию) КАК СуммаБОПоОснованию
	|ПОМЕСТИТЬ ОтчетыНаОснованииРешенийОКомпенсацииРасходовИЗаявок
	|ИЗ
	|	Документ.ОтчетОРасходахПодотчетногоЛица.ДенежныеОбязательства КАК ОтчетОРасходахПодотчетногоЛицаДенежныеОбязательства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетОРасходахПодотчетногоЛица КАК ОтчетОРасходахПодотчетногоЛица
	|		ПО ОтчетОРасходахПодотчетногоЛицаДенежныеОбязательства.Ссылка = ОтчетОРасходахПодотчетногоЛица.Ссылка
	|ГДЕ
	|	(ОтчетОРасходахПодотчетногоЛица.ДокументОснование ССЫЛКА Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъема
	|			ИЛИ ОтчетОРасходахПодотчетногоЛица.ДокументОснование ССЫЛКА Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо
	|			ИЛИ ОтчетОРасходахПодотчетногоЛица.ДокументОснование ССЫЛКА Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОтчетОРасходахПодотчетногоЛица.Ссылка,
	|	ОтчетОРасходахПодотчетногоЛица.ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУ.Регистратор КАК Ссылка,
	|	СУММА(ЖурналПроводокЕПСБУ.Сумма) КАК СуммаБО
	|ПОМЕСТИТЬ РешенияСБО
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.СчетКт В(&СчетаБО)
	|	И (ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъема
	|			ИЛИ ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо
	|			ИЛИ ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУ.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОтчетыНаОснованииРешенийОКомпенсацииРасходовИЗаявок.Ссылка КАК Ссылка,
	|	СУММА(ОтчетыНаОснованииРешенийОКомпенсацииРасходовИЗаявок.СуммаБОПоОснованию) КАК СуммаБОПоОснованию,
	|	СУММА(РешенияСБО.СуммаБО) КАК СуммаБОПоРешению
	|ИЗ
	|	ОтчетыНаОснованииРешенийОКомпенсацииРасходовИЗаявок КАК ОтчетыНаОснованииРешенийОКомпенсацииРасходовИЗаявок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РешенияСБО КАК РешенияСБО
	|		ПО ОтчетыНаОснованииРешенийОКомпенсацииРасходовИЗаявок.ДокументОснование = РешенияСБО.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ОтчетыНаОснованииРешенийОКомпенсацииРасходовИЗаявок.Ссылка
	|
	|ИМЕЮЩИЕ
	|	СУММА(ОтчетыНаОснованииРешенийОКомпенсацииРасходовИЗаявок.СуммаБОПоОснованию) <> СУММА(РешенияСБО.СуммаБО)";
	
	Запрос.УстановитьПараметр("СчетаБО", БухгалтерскийУчет.СписокСчетов("502.11, 502.21"));
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.ОтчетОРасходахПодотчетногоЛица";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			// Объект не удается заблокировать - попробуем обработать его на следующей итерации.
			// Отдельно обрабатывать ошибку не требуется, т.к. в худшем случае обработчик зациклится
			// и прервется автоматически.
			ЗафиксироватьТранзакцию();
			Продолжить;
		КонецПопытки;
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Выборка.Ссылка) Тогда
			// Вероятно был удален раньше, чем обработчик дошел до него
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъема") Тогда
			ОбязательстваПоОснованию = Документы.ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТаблицаДенежныхОбязательствПоЗаявке(Объект.ДокументОснование);
		ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо") Тогда
			ОбязательстваПоОснованию = Документы.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо.ТаблицаДенежныхОбязательствПоЗаявке(Объект.ДокументОснование);
		ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РешениеОКомпенсацииРасходовДляКрайнегоСевера") Тогда
			ОбязательстваПоОснованию = Документы.РешениеОКомпенсацииРасходовДляКрайнегоСевера.ТаблицаОбязательствПоРешениюОКомпенсации(Объект.ДокументОснование);
		Иначе
			ОбязательстваПоОснованию = Новый Массив;
		КонецЕсли;
		
		Для Каждого СтрокаОснование Из ОбязательстваПоОснованию Цикл
			Отбор = Новый Структура("КФО, КПС, КЭК, КодЦели, КодМероприятия, ДопКлассификация");
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаОснование);
			ИмеющиесяСтроки = Объект.ДенежныеОбязательства.НайтиСтроки(Отбор);
			Если ИмеющиесяСтроки.Количество() > 0 Тогда
				ИмеющаясяСтрока = ИмеющиесяСтроки[0];
				Если ИмеющаясяСтрока.СуммаБОПоОснованию <> СтрокаОснование.СуммаБО Тогда
					ИмеющаясяСтрока.СуммаБОПоОснованию = СтрокаОснование.СуммаБО;
				КонецЕсли;
			Иначе
				НоваяСтрока = Объект.ДенежныеОбязательства.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОснование);
				НоваяСтрока.СуммаБОПоОснованию = СтрокаОснование.СуммаБО;
				НоваяСтрока.ФинансовыйГод = Год(Объект.Дата);
			КонецЕсли;
		КонецЦикла;
		
		Если Не Объект.Модифицированность() Тогда
			
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
			
		КонецЕсли;
		
		Попытка
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Документы.ОтчетОРасходахПодотчетногоЛица,
			Выборка.Ссылка,
			ТекстСообщения);
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
