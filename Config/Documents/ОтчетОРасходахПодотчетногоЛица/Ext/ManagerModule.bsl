#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"ПрисоединитьДополнительныеТаблицы
	|ЭтотСписок КАК ЭтотСписок
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|	ПО ЭтотСписок.Сотрудник.Контрагент.ЮридическоеФизическоеЛицо = Пользователи.ФизическоеЛицо
	|
	|;
	|РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)
	|	И ЗначениеРазрешено(Пользователи.Ссылка, NULL КАК ИСТИНА)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// СтандартныеПодсистемы.ВерсионированиеОбъектов
// Определяет настройки объекта для подсистемы ВерсионированиеОбъектов.
//
// Параметры:
// Настройки - Структура - настройки подсистемы.
Процедура ПриОпределенииНастроекВерсионированияОбъектов(Настройки) Экспорт
КонецПроцедуры
// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ОтчетОРасходахПодотчетногоЛица";
	КомандаПечати.Идентификатор = "ПФ_MXL_ОтчетОрасходахПодотчетногоЛица0504520";
	КомандаПечати.Представление = НСтр("ru = 'Отчет о расходах подотчетного лица'");
	КомандаПечати.Порядок = 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ОтчетОРасходахПодотчетногоЛица";
	КомандаПечати.Идентификатор = "ПриходныйОрдер0504207_103н";
	КомандаПечати.Представление = НСтр("ru = 'Приходный ордер (ф.0504207) (ред. 103н)'");
	КомандаПечати.Порядок = 2;
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - Массив - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати - СписокЗначений - значение - ссылка на объект;
//                                            представление - имя области, в которой был выведен объект (выходной параметр);
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ОтчетОрасходахПодотчетногоЛица0504520") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПФ_MXL_ОтчетОрасходахПодотчетногоЛица0504520",
		"Отчет о расходах подотчетного лица",
		ПечатьОтчетаОРасходахПодотчетногоЛица(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПриходныйОрдер0504207_103н",
		"Приходный ордер (ф. 0504207)",
		ПечатьПриходногоОрдера0504207(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПриходныйОрдер0504207_103н"));
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ФормированиеСчетовФактур

// Проверяет заполненность колонок ДатаСФ, НомерСФ, Контрагент, СчетФактура (опционально)
Процедура ПроверитьЗаполненностьКолонокНДС(ДокументОбъект, Отказ, ПроверитьКолонкуСчетФактура = Истина, ИмяТабличнойЧасти = "") Экспорт
	
	МетаданныеТЧ = Метаданные.Документы.ОтчетОРасходахПодотчетногоЛица.ТабличныеЧасти;
	
	ИменаТЧ = Новый Массив();
	
	Если ИмяТабличнойЧасти <> "" Тогда
		ИменаТЧ.Добавить(ИмяТабличнойЧасти);
	Иначе
		ИменаТЧ.Добавить("Проезд");
		ИменаТЧ.Добавить("Проживание");
		ИменаТЧ.Добавить("ПрочиеРасходы");
		ИменаТЧ.Добавить("ТоварыРаботыУслуги");
	КонецЕсли;
	
	Для Каждого ИмяТЧ Из ИменаТЧ Цикл
		ПроверитьЗаполнениеКолонокСФ(ДокументОбъект, Отказ, ПроверитьКолонкуСчетФактура, ИмяТЧ, МетаданныеТЧ[ИмяТЧ].Синоним);
	КонецЦикла;
	
КонецПроцедуры

// Формирует и обновляет подчиненные счета-фактуры полученные для строк ОтчетОРасходахПодотчетногоЛица
//
// Параметры
//   ДокументОбъект - ДокументОбъект.ОтчетОРасходахПодотчетногоЛица - ОтчетОРасходахПодотчетногоЛица, для которого нужно сформировать счета-фактуры.
//
// Возвращаемое значение:
//   Структура - ссылки на использованные счета-фактуры, с ключами
//		* Создано	- Массив - ссылки на новые созданные документы
//		* Обновлено	- Массив - ссылки на подобранные уже существующие документы, которые были обновлены (перезаполнены)
//
Функция СформироватьПодчиненныеСчетаФактуры(ДокументОбъект, ИмяТабличнойЧасти) Экспорт
	
	Статистика = Новый Структура();
	Статистика.Вставить("Создано", Новый Массив());
	Статистика.Вставить("Обновлено", Новый Массив());
	
	ДокументСсылка = ДокументОбъект.Ссылка;
	
	ТаблицаСФ = ПолучитьТаблицуПодчиненныхСчетовФактур(ДокументОбъект);
	
	ТаблицаНФА = ДанныеСчетовФактурПоДокументу(ДокументОбъект, ИмяТабличнойЧасти);
	
	ТаблицаДокумента = ТаблицаНФА.Скопировать();
	ТаблицаДокумента.Свернуть(ПолучитьИменаПолейПоискаСФвТабличнойЧасти() + ", СчетФактура", "Сумма, СуммаНДС");
	
	
	НачатьТранзакцию();
	
	Попытка
		Для Каждого СтрокаТаблицы Из ТаблицаДокумента Цикл
			
			// Поиск существующего документа счет-фактура полученный
			СтрокаСФ = НайтиСтрокуСчетаФактуры(ТаблицаСФ, СтрокаТаблицы);
			
			Если СтрокаСФ = Неопределено Тогда
				ИспользованСуществующийДокумент = Ложь;
				
				ДокументСФ = Документы.СчетФактураПолученный.СоздатьДокумент();
				ДокументСФ.ДокументыОснования.Добавить().ДокументОснование = ДокументСсылка;
				
				ЗаполнитьСчетФактуруПоОтчетуОРасходахПодотчетногоЛица(ДокументСФ,
				ДокументОбъект, ДокументСсылка, СтрокаТаблицы, ТаблицаНФА);
				
				// Зафиксируем новый счет-фактуру в таблице
				СтрокаСФ = ТаблицаСФ.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаСФ, СтрокаТаблицы);
				ЗаполнитьЗначенияСвойств(СтрокаСФ, ДокументСФ);
				СтрокаСФ.Использован = Истина;
				
				ИмяСвойства = "Создано";
			Иначе
				ИспользованСуществующийДокумент = Истина;
				
				ДокументСФСсылка = СтрокаСФ.Ссылка;
				
				Блокировка = Новый БлокировкаДанных;
				ЭлементБлокировки = Блокировка.Добавить("Документ.СчетФактураПолученный");
				ЭлементБлокировки.УстановитьЗначение("Ссылка", ДокументСФСсылка);
				Блокировка.Заблокировать();
				
				ЗаблокироватьДанныеДляРедактирования(ДокументСФСсылка);
				
				ДокументСФ = ДокументСФСсылка.ПолучитьОбъект();
				Если ДокументСФ.ДокументыОснования.Найти(ДокументСсылка, "ДокументОснование") = Неопределено Тогда
					ДокументСФ.ДокументыОснования.Добавить().ДокументОснование = ДокументСсылка;
				КонецЕсли;
				
				ЗаполнитьСчетФактуруПоОтчетуОРасходахПодотчетногоЛица(ДокументСФ,
				ДокументОбъект, ДокументСсылка, СтрокаТаблицы, ТаблицаНФА);
				
				СтрокаСФ.Использован = Истина;
				
				ИмяСвойства = "Обновлено";
			КонецЕсли;
			
			УстановитьСФТиповуюОперациюПоУмолчанию(ДокументСФ);
			
			Если ДокументСФ.Проведен Тогда
				ДокументСФ.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ДокументСФ.Записать();
			КонецЕсли;
			
			Если ИспользованСуществующийДокумент Тогда
				РазблокироватьДанныеДляРедактирования(ДокументСФСсылка);
			КонецЕсли;
			
			Статистика[ИмяСвойства].Добавить(ДокументСФ.Ссылка);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
	КонецПопытки;
	
	// Запишем ссылки на созданные счета-фактуры в строки документа
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТабличнойЧасти] Цикл
		
		Если Не СтрокаТаблицы.ПредъявленСФ Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаСФ = НайтиСтрокуСчетаФактуры(ТаблицаСФ, СтрокаТаблицы);
		
		Если СтрокаСФ <> Неопределено Тогда
			Если Не СтрокаТаблицы.СчетФактура = СтрокаСФ.Ссылка Тогда
				СтрокаТаблицы.СчетФактура = СтрокаСФ.Ссылка;
			КонецЕсли;
		Иначе
			СтрокаТаблицы.СчетФактура = Документы.СчетФактураПолученный.ПустаяСсылка();
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Статистика;
	
КонецФункции

// Помечает на удаление указанные счета-фактуры
Процедура УдалитьСчетаФактуры(МассивДокументов) Экспорт
	
	НачатьТранзакцию();
	
	Попытка
		Для Каждого Ссылка Из МассивДокументов Цикл
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Документ.СчетФактураПолученный");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
			Блокировка.Заблокировать();
			
			ЗаблокироватьДанныеДляРедактирования(Ссылка);
			
			ДокументСФ = Ссылка.ПолучитьОбъект();
			
			ДокументСФ.УстановитьПометкуУдаления(Истина);
			
			РазблокироватьДанныеДляРедактирования(Ссылка);
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Возвращает массив ссылок на документы Счет-фактура полученный,
// которые созданы на основании ОтчетОРасходахПодотчетногоЛица, но более не указаны в табличной части документа.
Функция ПолучитьНеиспользуемыеСчетаФактуры(ДокументОбъект) Экспорт
	
	ПодчиненныеСчетаФактуры = ПолучитьТаблицуПодчиненныхСчетовФактур(ДокументОбъект);
	
	Поиск = Новый Структура();
	
	ИменаТЧ = Новый Массив();
	ИменаТЧ.Добавить("Проезд");
	ИменаТЧ.Добавить("Проживание");
	ИменаТЧ.Добавить("ПрочиеРасходы");
	ИменаТЧ.Добавить("ТоварыРаботыУслуги");
	
	Для Каждого СтрокаТаблицы Из ПодчиненныеСчетаФактуры Цикл
		Поиск.Вставить("СчетФактура", СтрокаТаблицы.Ссылка);
		
		Для Каждого ИмяТЧ Из ИменаТЧ Цикл
			МассивСтрок = ДокументОбъект[ИмяТЧ].НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() > 0 Тогда
				СтрокаТаблицы.Использован = Истина;
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Поиск = Новый Структура();
	Поиск.Вставить("Использован", Ложь);
	Поиск.Вставить("ПометкаУдаления", Ложь);
	
	ВремТаблица = ПодчиненныеСчетаФактуры.Скопировать(Поиск, "Ссылка");
	ВремТаблица.Свернуть("Ссылка");
	
	Возврат ВремТаблица.ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПолучитьСоответствиеСуммаВключаетНДС() Экспорт
	
	СоответствиеРеквизитТабличнаяЧасть = Новый Соответствие();
	
	СоответствиеРеквизитТабличнаяЧасть.Вставить("СуммаВключаетНДС",					"ТоварыРаботыУслуги");
	СоответствиеРеквизитТабличнаяЧасть.Вставить("СуммаВключаетНДСПроезд",			"Проезд");
	СоответствиеРеквизитТабличнаяЧасть.Вставить("СуммаВключаетНДСПроживание",		"Проживание");
	СоответствиеРеквизитТабличнаяЧасть.Вставить("СуммаВключаетНДСПрочиеРасходы",	"ПрочиеРасходы");
	
	Возврат СоответствиеРеквизитТабличнаяЧасть;
	
КонецФункции

#КонецОбласти

// Формирует таблицу двдижений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - Таблица значений. Таблица проводок, которые будут сформированы
//  ДокументОбъект - Документ объект. Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура. Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - Таблица значений. Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка. Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
//
// Возвращает флаг ошибки. Если Истина - все ОК, иначе - Ложь
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт
	
	ТекОрганизация = ДокументОбъект.Организация;
	ТекДата        = ДокументОбъект.Дата;
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("Суточные");
	МассивТЧ.Добавить("Проезд");
	МассивТЧ.Добавить("Проживание");
	МассивТЧ.Добавить("ПрочиеРасходы");
	МассивТЧ.Добавить("ТоварыРаботыУслуги");
	Для каждого ТЧ из МассивТЧ Цикл
		Для каждого СтрокаТЧ из ДокументОбъект[ТЧ] Цикл
			Если НЕ СтрокаТЧ.ОтразитьВКарточкеКапвложений ИЛИ НЕ ЗначениеЗаполнено(СтрокаТЧ.КарточкаКапвложений) Тогда
				Продолжить;
			ИначеЕсли ТабДвижений.Найти(СтрокаТЧ.КарточкаКапвложений, "КарточкаКапвложений") <> Неопределено Тогда
				Продолжить;
			КонецЕсли;	
			
			НоваяСтрока = ТабДвижений.Добавить();
			НоваяСтрока.Организация         = ТекОрганизация;
			НоваяСтрока.КарточкаКапвложений = СтрокаТЧ.КарточкаКапвложений;
			НоваяСтрока.Период              = ТекДата;
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат Истина;
КонецФункции	

Функция СуммаВРублевомЭквиваленте(Сумма, Валюта, КурсыВалют) Экспорт
	
	Если Не ЗначениеЗаполнено(Валюта)
		ИЛИ Валюта = ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета() Тогда
		Возврат Сумма;
	КонецЕсли;
	
	Для Каждого СтрокаСКурсом Из КурсыВалют Цикл
		Если СтрокаСКурсом.Валюта = Валюта Тогда
			Возврат Сумма * СтрокаСКурсом.Курс / ?(СтрокаСКурсом.Кратность = 0, 1, СтрокаСКурсом.Кратность);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Сумма;
	
КонецФункции

Функция ДанныеСотрудника(Сотрудник, Дата = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Дата) Тогда  
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;	
	
	ТребуемыеДанные = Новый Структура;
	ТребуемыеДанные.Вставить("СсылкаНаОбъект", Сотрудник);
	ТребуемыеДанные.Вставить("Период", Дата);
	ТребуемыеДанные.Вставить("Подразделение");
	ТребуемыеДанные.Вставить("Должность");
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ТребуемыеДанные, Истина);
	
	Возврат ТребуемыеДанные;
	
КонецФункции


