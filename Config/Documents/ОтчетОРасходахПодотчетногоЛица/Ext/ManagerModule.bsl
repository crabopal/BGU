#Область СлужебныеПроцедурыИФункции   

Процедура ДобавитьСтрокиЗачтенныхАвансов(ТаблицаРасчетов, НераспределеннаяСумма, НераспределеннаяСуммаПоОтчету, ОстаткиАвансов, СтрокаДокумента)
	
	Для Каждого СтрокаОстатка Из ОстаткиАвансов Цикл
		
		Если НераспределеннаяСумма <= 0 И НераспределеннаяСуммаПоОтчету <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		ЗачитываемыйАванс = Мин(НераспределеннаяСумма, СтрокаОстатка.СуммаРасчетов);
		ЗачитываемыйАвансПоОтчету = Мин(НераспределеннаяСуммаПоОтчету, СтрокаОстатка.СуммаРасчетовПоОтчету);
		Если ЗачитываемыйАванс <= 0 И ЗачитываемыйАвансПоОтчету <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРасчетов = ТаблицаРасчетов.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаДокумента);
		
		СтрокаРасчетов.СуммаРасчетов = 0;
		СтрокаРасчетов.СуммаРасчетовПоОтчету = 0;
		
		Если НераспределеннаяСумма > 0 И ЗачитываемыйАванс > 0 Тогда
			
			СтрокаРасчетов.СуммаРасчетов = ЗачитываемыйАванс;
			
			КоэффициентКурсаАванса = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаОстатка.СуммаРасчетов = 0, 0, СтрокаОстатка.РублевыйЭквивалент / СтрокаОстатка.СуммаРасчетов));
			
			КоэффициентРуб = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаДокумента.СуммаРасчетов = 0, 0, СтрокаДокумента.РублевыйЭквивалент / СтрокаДокумента.СуммаРасчетов));
			
			СтрокаРасчетов.СуммаРубПоКурсуАванса = Окр(ЗачитываемыйАванс * КоэффициентКурсаАванса, 2);
			СтрокаРасчетов.РублевыйЭквивалент = Окр(ЗачитываемыйАванс * КоэффициентРуб, 2);
			
			НераспределеннаяСумма = НераспределеннаяСумма - ЗачитываемыйАванс;
			
			СтрокаОстатка.СуммаРасчетов = СтрокаОстатка.СуммаРасчетов - СтрокаРасчетов.СуммаРасчетов;
			СтрокаОстатка.РублевыйЭквивалент = СтрокаОстатка.РублевыйЭквивалент - СтрокаРасчетов.СуммаРубПоКурсуАванса;
			
		КонецЕсли;
		
		Если НераспределеннаяСуммаПоОтчету > 0 И ЗачитываемыйАвансПоОтчету > 0 Тогда
			
			СтрокаРасчетов.СуммаРасчетовПоОтчету = ЗачитываемыйАвансПоОтчету;
			
			КоэффициентКурсаАванса = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаОстатка.СуммаРасчетовПоОтчету = 0, 0, СтрокаОстатка.РублевыйЭквивалентПоОтчету / СтрокаОстатка.СуммаРасчетовПоОтчету));
			
			КоэффициентРуб = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаДокумента.СуммаРасчетовПоОтчету = 0, 0, СтрокаДокумента.РублевыйЭквивалентПоОтчету / СтрокаДокумента.СуммаРасчетовПоОтчету));
			
			СтрокаРасчетов.СуммаРубПоКурсуАвансаПоОтчету = Окр(ЗачитываемыйАвансПоОтчету * КоэффициентКурсаАванса, 2);
			СтрокаРасчетов.РублевыйЭквивалентПоОтчету = Окр(ЗачитываемыйАвансПоОтчету * КоэффициентРуб, 2);
			
			НераспределеннаяСуммаПоОтчету = НераспределеннаяСуммаПоОтчету - ЗачитываемыйАвансПоОтчету;
			
			СтрокаОстатка.СуммаРасчетовПоОтчету = СтрокаОстатка.СуммаРасчетовПоОтчету - СтрокаРасчетов.СуммаРасчетовПоОтчету;
			СтрокаОстатка.РублевыйЭквивалентПоОтчету = СтрокаОстатка.РублевыйЭквивалентПоОтчету - СтрокаРасчетов.СуммаРубПоКурсуАвансаПоОтчету;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСтрокуЗадолженности(ТаблицаРасчетов, НераспределеннаяСумма, НераспределеннаяСуммаПоОтчету, СтрокаДокумента)
	
	СтрокаРасчетов = ТаблицаРасчетов.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаДокумента);
	
	СтрокаРасчетов.СуммаРасчетов = 0;
	
	Если НераспределеннаяСумма > 0 Тогда
		
		СтрокаРасчетов.СуммаРасчетов = НераспределеннаяСумма;
		
		КоэффициентРуб = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
		?(СтрокаДокумента.СуммаРасчетов = 0, 0, СтрокаДокумента.РублевыйЭквивалент / СтрокаДокумента.СуммаРасчетов));
		
		СтрокаРасчетов.РублевыйЭквивалент    = Окр(НераспределеннаяСумма * КоэффициентРуб, 2);
		СтрокаРасчетов.СуммаРубПоКурсуАванса = СтрокаРасчетов.РублевыйЭквивалент;
		
	КонецЕсли;
	
	Если НераспределеннаяСуммаПоОтчету > 0 Тогда
		
		СтрокаРасчетов.СуммаРасчетовПоОтчету = НераспределеннаяСуммаПоОтчету;
		
		КоэффициентРуб = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
		?(СтрокаДокумента.СуммаРасчетовПоОтчету = 0, 0, СтрокаДокумента.РублевыйЭквивалентПоОтчету / СтрокаДокумента.СуммаРасчетовПоОтчету));
		
		СтрокаРасчетов.РублевыйЭквивалентПоОтчету    = Окр(НераспределеннаяСуммаПоОтчету * КоэффициентРуб, 2);
		СтрокаРасчетов.СуммаРубПоКурсуАвансаПоОтчету = СтрокаРасчетов.РублевыйЭквивалентПоОтчету;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтрокуИзрасходовано(ТаблицаИзрасходовано, ВыборкаРасходы, СтруктураДанных, Счета208, КурсыВалют)
	
	НоваяСтрока = ТаблицаИзрасходовано.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаРасходы);
	НоваяСтрока.СчетКредита = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(НоваяСтрока.КОСГУ, Счета208, , СтруктураДанных.Дата);
	НоваяСтрока.СуммаРасчетов = НоваяСтрока.СуммаПринято;
	НоваяСтрока.СуммаРасчетовПоОтчету = НоваяСтрока.СуммаФакт;
	Если НоваяСтрока.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета()
		ИЛИ Не ЗначениеЗаполнено(НоваяСтрока.Валюта) Тогда
		НоваяСтрока.РасчетыВВалюте = Ложь;
		НоваяСтрока.РублевыйЭквивалент = НоваяСтрока.СуммаПринято;
		НоваяСтрока.РублевыйЭквивалентПоОтчету = НоваяСтрока.СуммаФакт;
	Иначе
		НоваяСтрока.РасчетыВВалюте = Истина;
		НоваяСтрока.РублевыйЭквивалент = СуммаВРублевомЭквиваленте(
		НоваяСтрока.СуммаПринято, НоваяСтрока.Валюта, КурсыВалют);
		НоваяСтрока.РублевыйЭквивалентПоОтчету = СуммаВРублевомЭквиваленте(
		НоваяСтрока.СуммаФакт, НоваяСтрока.Валюта, КурсыВалют);
		НоваяСтрока.СуммаФактВВалюте = НоваяСтрока.СуммаФакт;
		НоваяСтрока.СуммаПринятоВВалюте = НоваяСтрока.СуммаПринято;
	КонецЕсли;
	
КонецПроцедуры

