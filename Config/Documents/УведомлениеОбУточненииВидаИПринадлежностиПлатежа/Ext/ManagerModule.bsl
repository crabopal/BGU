		ОписаниеОшибки = НСтр("ru='Для ввода на основании необходимо заполнить расшифровку платежа.'");
	КонецЕсли;
	
	Возврат Объект.РеквизитыПлатежногоДокумента.Количество() - 1;
	
КонецФункции

Функция ЗаполнитьНаОснованииУведомленияОбУточнении(Основание, Объект, ОписаниеОшибки) 
	
	УдалениеСтрокСоответвуюшихОснованию(Основание, Объект);	
	
	ЗаполнитьШапкуДокумента(Основание, Объект, ",ПерваяПодпись,ПерваяПодписьПечататьДолжность,ПерваяПодписьДолжность,ВтораяПодпись,ВтораяПодписьДолжность");
		
	Объект.ЗапросНаВыяснениеПринадлежностиПлатежа 	= "";
	Объект.НомерЗапроса 							= Основание.НомерЗапроса;
	Объект.ДатаЗапроса 								= Основание.ДатаЗапроса;
	Объект.НаименованиеПлательщика 					= Основание.НаименованиеПлательщика;
	Объект.ИННПлательщика 							= Основание.ИННПлательщика;
	Объект.КПППлательщика 							= Основание.КПППлательщика;
	Объект.ПаспортныеДанныеПлательщика				= Основание.ПаспортныеДанныеПлательщика;
	Объект.НомерБанковскогоСчетаПлательщика 		= Основание.НомерБанковскогоСчетаПлательщика;
	
	Для Каждого СтрДок Из Основание.ИзмененныеРеквизиты Цикл
		
		НоваяСтрока = Объект.РеквизитыПлатежногоДокумента.Добавить();
		НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор; 
		
		НоваяСтрока.НаименованиеПлатежногоДокумента = "Уведомление об уточнении вида и принадлежности платежа";
		НоваяСтрока.НомерПлатежногоДокумента		= ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Основание,Основание.Номер);
		НоваяСтрока.ДатаПлатежногоДокумента			= Основание.Дата;
		НоваяСтрока.ИННПолучателя			 		= СтрДок.ИННПолучателя;
		НоваяСтрока.КПППолучателя			 		= СтрДок.КПППолучателя;
		
		КодБК = "";
		Если СтрДок.КПС.ДатаНачалаДействия < Дата(2016, 1, 1) Тогда
			КодБК = СтрДок.КПС.Код + СтрДок.КОСГУ.Код;
		Иначе
			Если Основание.ЛицевойСчет.НеВыводитьКодГлавы Тогда
				КодБК =	"000" + СтрДок.КПС.Код;
			ИначеЕсли Основание.ИФО.ИспользоватьРеквизитыИФО Тогда
				КодБК = ?(ЗначениеЗаполнено(Основание.ИФО.КодГлавыБК), Основание.ИФО.КодГлавыБК.Код, "000") + СтрДок.КПС.Код;
			Иначе
				КодБК = ?(ЗначениеЗаполнено(Основание.ЛицевойСчет.Владелец.КодПоППП), Основание.ЛицевойСчет.Владелец.КодПоППП.Код, "000") + СтрДок.КПС.Код;
			КонецЕсли;
		КонецЕсли;	
		
		НоваяСтрока.КодБК			 				= КодБК;

		НоваяСтрока.КодЦели			 				= СокрЛП(СтрДок.КодЦели) + Лев(СтрДок.НаправлениеРасходованияВР, 2);
		НоваяСтрока.ОКАТО			 				= СтрДок.ОКАТО;
		НоваяСтрока.Сумма			 				= СтрДок.Сумма;
		НоваяСтрока.НазначениеПлатежа			 	= СтрДок.НазначениеПлатежа;
		НоваяСтрока.ВидБК 							= СтрДок.КПС.ВидПоказателя;
		НоваяСтрока.КодПлатежногоДокумента			= "UF";
		НоваяСтрока.GUIDФК 							= Документы.УведомлениеОбУточненииВидаИПринадлежностиПлатежа.ПолучитьСостояниеДокумента(Основание).GUIDКО;
		НоваяСтрока.НаименованиеПолучателя 			= СтрДок.НаименованиеПолучателя;
		НоваяСтрока.Примечание		                = "";
		НоваяСтрока.ЗаявкаНаКассовыйРасход          = Основание;
		НоваяСтрока.ЛицевойСчетПолучателя           = СтрДок.ЛицевойСчетПолучателя;

	КонецЦикла;
	
	Если Основание.ИзмененныеРеквизиты.Количество() = 0 Тогда
		
		ОписаниеОшибки = НСтр("ru='Отсутствуют данные в таблице ""Измененные реквизиты"" документа-основания.'");
		
	КонецЕсли;
	
	Возврат Объект.РеквизитыПлатежногоДокумента.Количество() - 1;
	
КонецФункции

Функция ЗаполнитьНаОснованииЗапросаНаВыяснение(Основание, Объект, ОписаниеОшибки) 
	
	Объект.РеквизитыПлатежногоДокумента.Очистить();
	Объект.ИзмененныеРеквизиты.Очистить();
	
	Объект.ЗапросНаВыяснениеПринадлежностиПлатежа 	= Основание;
	Объект.НомерЗапроса 							= Основание.НомерЗапроса;
	Объект.ДатаЗапроса 								= Основание.ДатаЗапроса;
	Объект.НаименованиеПлательщика 					= Основание.НаименованиеПлательщика;
	Объект.ИННПлательщика 							= Основание.ИННПлательщика;
	Объект.КПППлательщика 							= Основание.КПППлательщика;
	Объект.НомерБанковскогоСчетаПлательщика         = Основание.НомерБанковскогоСчетаПлательщика;
	Объект.ПаспортныеДанныеПлательщика				= Основание.ПаспортныеДанныеПлательщика;
	Объект.Организация                              = Основание.Организация;
	
	Для Каждого СтрДок Из Основание.ПлатежныеДокументы Цикл
		НоваяСтрока = Объект.РеквизитыПлатежногоДокумента.Добавить();
		НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор; 
		
		НоваяСтрока.НаименованиеПлатежногоДокумента = СтрДок.Наименование;
		НоваяСтрока.НомерПлатежногоДокумента		= СтрДок.Номер;
		НоваяСтрока.ДатаПлатежногоДокумента			= СтрДок.Дата;
		НоваяСтрока.ИННПолучателя			 		= СтрДок.ИННПолучателя;
		НоваяСтрока.КПППолучателя			 		= СтрДок.КПППолучателя;
		НоваяСтрока.КодБК			 				= СтрДок.КБК;
		НоваяСтрока.КодЦели			 				= СтрДок.КодЦели;
		НоваяСтрока.ОКАТО			 				= СтрДок.ОКАТО;
		НоваяСтрока.Сумма			 				= СтрДок.Сумма;
		НоваяСтрока.НазначениеПлатежа			 	= СтрДок.НазначениеПлатежа;
		НоваяСтрока.ВидБК 							= Перечисления.ВидыКБК.КДБ;
		
		Если СокрЛП(НРег(НоваяСтрока.НаименованиеПлатежногоДокумента)) = "поручение о перечислении на счет" Тогда
			НоваяСтрока.КодПлатежногоДокумента	    = "PL";
		Иначе	
            НоваяСтрока.КодПлатежногоДокумента		= "PP";
		КонецЕсли;	
		
		ДанныеХранилищаЗначения = СтрДок.ПервичныйОбразИРеквизитыОФК.Получить();
		Если НЕ ТипЗнч(ДанныеХранилищаЗначения) = Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;	
		Если ДанныеХранилищаЗначения.Свойство("ОФКGUID") Тогда
			НоваяСтрока.GUIDФК = ДанныеХранилищаЗначения.ОФКGUID;
		КонецЕсли;	
		Если ДанныеХранилищаЗначения.Свойство("ТекстПолучателя") Тогда			 
			НоваяСтрока.НаименованиеПолучателя = ДанныеХранилищаЗначения.ТекстПолучателя;
		КонецЕсли;
		Если ДанныеХранилищаЗначения.Свойство("НомерСчетаПлательщика") Тогда			 
			НомерБанковскогоСчетаПлательщика = ДанныеХранилищаЗначения.НомерСчетаПлательщика;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Объект.РеквизитыПлатежногоДокумента.Количество() = 0 Тогда		
		ОписаниеОшибки = НСтр("ru='Для ввода на основании необходимо заполнить список платежных документов.'");
	КонецЕсли;
	
	Возврат Объект.РеквизитыПлатежногоДокумента.Количество() - 1;	
	
КонецФункции

Функция ЗаполнитьНаОснованииПлатежноеПоручение(Основание, Объект, ОписаниеОшибки)
	
	УдалениеСтрокСоответвуюшихОснованию(Основание, Объект);	
	
	ЗаполнитьШапкуДокумента(Основание, Объект);

	Объект.ЗапросНаВыяснениеПринадлежностиПлатежа 	= "";
	Объект.НомерЗапроса 							= "";
	Объект.ДатаЗапроса 								= "";
	
	Объект.Контрагент                               = Основание.Контрагент;
	Объект.СчетКонтрагента                          = Основание.СчетКонтрагента;
	Объект.НаименованиеПлательщика                  = Основание.КонтрагентНаименование;
	Объект.НомерБанковскогоСчетаПлательщика         = Основание.КонтрагентБанковскийСчет;
	
	Объект.ИННПлательщика                           = Основание.КонтрагентИНН;
	Объект.КПППлательщика                           = Основание.КонтрагентКПП;
	
	Для Каждого СтрДок Из Основание.РасшифровкаПлатежа Цикл
		НоваяСтрока = Объект.РеквизитыПлатежногоДокумента.Добавить();
		НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор; 
		
		НоваяСтрока.НаименованиеПлатежногоДокумента = "Платежное поручение";
		НоваяСтрока.НомерПлатежногоДокумента		= ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Основание,Основание.Номер);
		НоваяСтрока.ДатаПлатежногоДокумента			= Основание.Дата;
		НоваяСтрока.ИННПолучателя			 		= Основание.КонтрагентИНН;
		НоваяСтрока.КПППолучателя			 		= Основание.КонтрагентКПП;
		
		КодБК = "";
		Если СтрДок.КБКНазначениеПлатежа.ДатаНачалаДействия < Дата(2016, 1, 1) Тогда
			КодБК = СтрДок.КБКНазначениеПлатежа.Код + СтрДок.КОСГУНазначениеПлатежа.Код;
		Иначе
			Если Основание.ЛицевойСчет.НеВыводитьКодГлавы Тогда
				КодБК =	"000" + СтрДок.КБКНазначениеПлатежа.Код;
			ИначеЕсли Основание.ИФО.ИспользоватьРеквизитыИФО Тогда
				КодБК = ?(ЗначениеЗаполнено(Основание.ИФО.КодГлавыБК), Основание.ИФО.КодГлавыБК.Код, "000") + СтрДок.КБКНазначениеПлатежа.Код;
			Иначе
				КодБК = ?(ЗначениеЗаполнено(Основание.ЛицевойСчет.Владелец.КодПоППП), Основание.ЛицевойСчет.Владелец.КодПоППП.Код, "000") + СтрДок.КБКНазначениеПлатежа.Код;
			КонецЕсли;
		КонецЕсли;	
		
		НоваяСтрока.КодБК			 				= КодБК;

		НоваяСтрока.КодЦели			 				= СтрДок.КодЦели;
		НоваяСтрока.Сумма			 				= СтрДок.Сумма;
		НоваяСтрока.НазначениеПлатежа			 	= Основание.НазначениеПлатежа;
		НоваяСтрока.GUIDФК 							= Документы.ПлатежноеПоручение.ПолучитьСостояниеДокумента(Основание).GUIDКО;
		НоваяСтрока.НаименованиеПолучателя 			= Основание.КонтрагентНаименование;
		НоваяСтрока.Примечание		                = "(" + СокрЛП(НоваяСтрока.НомерПлатежногоДокумента) + ")";
		НоваяСтрока.ЗаявкаНаКассовыйРасход          = Основание;
		НоваяСтрока.КодПлатежногоДокумента			= "PP";

	КонецЦикла;
	
	Если Объект.РеквизитыПлатежногоДокумента.Количество() = 0 Тогда		
		ОписаниеОшибки = НСтр("ru='Для ввода на основании необходимо заполнить расшифровку платежа.'");
	КонецЕсли;
	
	Возврат Объект.РеквизитыПлатежногоДокумента.Количество() - 1;
	
КонецФункции

Функция ЗаполнитьНаОснованииКассовоеВыбытие(Основание, Объект, ОписаниеОшибки)
	
	УдалениеСтрокСоответвуюшихОснованию(Основание, Объект);	
	
	ЗаполнитьШапкуДокумента(Основание, Объект);
	
	СвойстваЛС = Справочники.ЛицевыеСчета.ПолучитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет);
	ЗаполнитьЗначенияСвойств(Объект, СвойстваЛС);
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	РеквизитыЛицевыхСчетов.Ссылка КАК Ссылка,
	|	РеквизитыЛицевыхСчетов.КассовыйОрган КАК КассовыйОрган
	|ИЗ
	|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
	|ГДЕ
	|	РеквизитыЛицевыхСчетов.Владелец = &Владелец");
	Запрос.УстановитьПараметр("Владелец", Объект.ЛицевойСчет);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.РеквизитыЛицевогоСчета = Выборка.Ссылка;
		Объект.ОрганКазначейства = Выборка.КассовыйОрган;
	КонецЕсли;	
	
	Объект.ЗапросНаВыяснениеПринадлежностиПлатежа 	= "";
	Объект.НомерЗапроса 							= "";
	Объект.ДатаЗапроса 								= "";
	
	Объект.НаименованиеПлательщика	 				= "";
	Объект.ИННПлательщика 							= "";
	Объект.КПППлательщика 							= "";
	Объект.ПаспортныеДанныеПлательщика				= "";
	Объект.НомерБанковскогоСчетаПлательщика 		= "";
		
	РеквизитыРегистрации = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Основание);
	ПервичныйОбраз       = Неопределено;
	
	Если РеквизитыРегистрации.Количество() > 0
		
		И РеквизитыРегистрации.Свойство("ПервичныйОбразИРеквизиты")
		И РеквизитыРегистрации.ПервичныйОбразИРеквизиты <> Неопределено Тогда
		ПервичныйОбраз = РеквизитыРегистрации.ПервичныйОбразИРеквизиты.Получить();   
		
		Если ТипЗнч(ПервичныйОбраз) = Тип("Массив") И ПервичныйОбраз.Количество() > 0 Тогда
			 ПервичныйОбраз = ПервичныйОбраз[0];
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого СтрДок Из Основание.РасшифровкаПлатежа Цикл
		НоваяСтрока = Объект.РеквизитыПлатежногоДокумента.Добавить();
		НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор; 
		
		НоваяСтрока.НаименованиеПлатежногоДокумента = Основание.ВидПервичногоДокумента;
		НоваяСтрока.НомерПлатежногоДокумента		= Основание.НомерПервичногоДокумента;
		НоваяСтрока.ДатаПлатежногоДокумента			= Основание.ДатаПервичногоДокумента;
		НоваяСтрока.ИННПолучателя			 		= Основание.ПолучательПлатежа.ИНН;
		НоваяСтрока.КПППолучателя			 		= Основание.ПолучательПлатежа.КПП;
		
		КодБК = "";
		Если СтрДок.КБКНазначениеПлатежа.ДатаНачалаДействия < Дата(2016, 1, 1) Тогда
			КодБК = СтрДок.КБКНазначениеПлатежа.Код + СтрДок.КОСГУНазначениеПлатежа.Код;
		Иначе
			Если Основание.ЛицевойСчет.НеВыводитьКодГлавы Тогда
				КодБК =	"000" + СтрДок.КБКНазначениеПлатежа.Код;
			ИначеЕсли Основание.ИФО.ИспользоватьРеквизитыИФО Тогда
				КодБК = ?(ЗначениеЗаполнено(Основание.ИФО.КодГлавыБК), Основание.ИФО.КодГлавыБК.Код, "000") + СтрДок.КБКНазначениеПлатежа.Код;
			Иначе
				КодБК = ?(ЗначениеЗаполнено(Основание.ЛицевойСчет.Владелец.КодПоППП), Основание.ЛицевойСчет.Владелец.КодПоППП.Код, "000") + СтрДок.КБКНазначениеПлатежа.Код;
			КонецЕсли;
		КонецЕсли;	
		
		НоваяСтрока.КодБК			 				= КодБК;
		НоваяСтрока.ВидБК							= СтрДок.КБКНазначениеПлатежа.ВидПоказателя;
		НоваяСтрока.КодЦели			 				= СокрЛП(СтрДок.КодЦели) + Лев(СтрДок.НаправлениеРасходованияВР, 2);
		НоваяСтрока.Сумма			 				= СтрДок.Сумма;
		НоваяСтрока.НазначениеПлатежа			 	= Основание.НазначениеПлатежа;
		НоваяСтрока.GUIDФК 							= РеквизитыРегистрации.GUIDКО;
		Если ТипЗнч(ПервичныйОбраз) = Тип("Структура") И ПервичныйОбраз.Свойство("ТекстПолучателя") Тогда
			НоваяСтрока.НаименованиеПолучателя 		= ПервичныйОбраз.ТекстПолучателя;
		КонецЕсли;
		НоваяСтрока.Примечание		                = "(" + СокрЛП(НоваяСтрока.НомерПлатежногоДокумента) + ")";
		НоваяСтрока.ЗаявкаНаКассовыйРасход          = Основание;
		НоваяСтрока.КодПлатежногоДокумента			= "PP";

	КонецЦикла;
	
	Если Объект.РеквизитыПлатежногоДокумента.Количество() = 0 Тогда		
		ОписаниеОшибки = НСтр("ru='Для ввода на основании необходимо заполнить расшифровку платежа.'");
	КонецЕсли;
	
	Возврат Объект.РеквизитыПлатежногоДокумента.Количество() - 1;
	
КонецФункции

Функция ЗаполнитьНаОснованииКассовоеПоступление(Основание, Объект, ОписаниеОшибки)
	
	УдалениеСтрокСоответвуюшихОснованию(Основание, Объект);	
	
	ЗаполнитьШапкуДокумента(Основание, Объект);
	
	СвойстваЛС = Справочники.ЛицевыеСчета.ПолучитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет);
	ЗаполнитьЗначенияСвойств(Объект, СвойстваЛС);
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	РеквизитыЛицевыхСчетов.Ссылка КАК Ссылка,
	|	РеквизитыЛицевыхСчетов.КассовыйОрган КАК КассовыйОрган
	|ИЗ
	|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
	|ГДЕ
	|	РеквизитыЛицевыхСчетов.Владелец = &Владелец");
	Запрос.УстановитьПараметр("Владелец", Объект.ЛицевойСчет);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.РеквизитыЛицевогоСчета = Выборка.Ссылка;
		Объект.ОрганКазначейства = Выборка.КассовыйОрган;
	КонецЕсли;	
	
	Объект.ЗапросНаВыяснениеПринадлежностиПлатежа 	= "";
	Объект.НомерЗапроса 							= "";
	Объект.ДатаЗапроса 								= "";
	
	Объект.НаименованиеПлательщика	 				= "";
	Объект.ИННПлательщика 							= "";
	Объект.КПППлательщика 							= "";
	Объект.ПаспортныеДанныеПлательщика				= "";
	Объект.НомерБанковскогоСчетаПлательщика 		= "";
		
	РеквизитыРегистрации = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Основание);
	ПервичныйОбраз       = Неопределено; 
	
	Если РеквизитыРегистрации.Количество() > 0 
		
		И РеквизитыРегистрации.Свойство("ПервичныйОбразИРеквизиты")
		И РеквизитыРегистрации.ПервичныйОбразИРеквизиты <> Неопределено Тогда
		ПервичныйОбраз = РеквизитыРегистрации.ПервичныйОбразИРеквизиты.Получить(); 
		
		Если ТипЗнч(ПервичныйОбраз) = Тип("Массив") И ПервичныйОбраз.Количество() > 0 Тогда
			 ПервичныйОбраз = ПервичныйОбраз[0];
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого СтрДок Из Основание.РасшифровкаПлатежа Цикл
		НоваяСтрока = Объект.РеквизитыПлатежногоДокумента.Добавить();
		НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор; 
		
		НоваяСтрока.НаименованиеПлатежногоДокумента = Основание.ВидПервичногоДокумента;
		НоваяСтрока.НомерПлатежногоДокумента		= Основание.НомерПервичногоДокумента;
		НоваяСтрока.ДатаПлатежногоДокумента			= Основание.ДатаПервичногоДокумента;
		НоваяСтрока.ИННПолучателя			 		= Основание.Организация.ИНН;
		НоваяСтрока.КПППолучателя			 		= Основание.Организация.КПП;
		НоваяСтрока.ОКАТО       			 		= Основание.Организация.КодОКТМО;
		
		КодБК = "";
		Если СтрДок.КБКНазначениеПлатежа.ДатаНачалаДействия < Дата(2016, 1, 1) Тогда
			КодБК = СтрДок.КБКНазначениеПлатежа.Код + СтрДок.КОСГУНазначениеПлатежа.Код;
		Иначе
			Если Основание.ЛицевойСчет.НеВыводитьКодГлавы Тогда
				КодБК =	"000" + СтрДок.КБКНазначениеПлатежа.Код;
			ИначеЕсли Основание.ИФО.ИспользоватьРеквизитыИФО Тогда
				КодБК = ?(ЗначениеЗаполнено(Основание.ИФО.КодГлавыБК), Основание.ИФО.КодГлавыБК.Код, "000") + СтрДок.КБКНазначениеПлатежа.Код;
			Иначе
				КодБК = ?(ЗначениеЗаполнено(Основание.ЛицевойСчет.Владелец.КодПоППП), Основание.ЛицевойСчет.Владелец.КодПоППП.Код, "000") + СтрДок.КБКНазначениеПлатежа.Код;
			КонецЕсли;
		КонецЕсли;	
		
		НоваяСтрока.КодБК			 				= КодБК;
		НоваяСтрока.ВидБК							= СтрДок.КБКНазначениеПлатежа.ВидПоказателя;
		НоваяСтрока.КодЦели			 				= СтрДок.КодЦели;
		НоваяСтрока.Сумма			 				= СтрДок.Сумма;
		НоваяСтрока.НазначениеПлатежа			 	= Основание.НазначениеПлатежа;
		НоваяСтрока.GUIDФК 							= РеквизитыРегистрации.GUIDКО;
		
		Если ТипЗнч(ПервичныйОбраз) = Тип("Структура") И ПервичныйОбраз.Свойство("ТекстПолучателя") Тогда
			НоваяСтрока.НаименованиеПолучателя 		= ПервичныйОбраз.ТекстПолучателя;
		КонецЕсли;
		
		НоваяСтрока.Примечание		                = "(" + СокрЛП(НоваяСтрока.НомерПлатежногоДокумента) + ")";
		НоваяСтрока.ЗаявкаНаКассовыйРасход          = Основание;
		НоваяСтрока.КодПлатежногоДокумента			= "PP";

	КонецЦикла;
	
	Если Объект.РеквизитыПлатежногоДокумента.Количество() = 0 Тогда		
		ОписаниеОшибки = НСтр("ru='Для ввода на основании необходимо заполнить расшифровку платежа.'");
	КонецЕсли;
	
	Возврат Объект.РеквизитыПлатежногоДокумента.Количество() - 1;
	
КонецФункции

Функция ЗаполнитьНаОснованииЗаявкиНаВозврат(Основание, Объект, ОписаниеОшибки) 
	
	УдалениеСтрокСоответвуюшихОснованию(Основание, Объект);	
	
	ЗаполнитьШапкуДокумента(Основание, Объект, ",ПерваяПодпись,ПерваяПодписьПечататьДолжность,ПерваяПодписьДолжность,ВтораяПодпись,ВтораяПодписьДолжность");

	
	Объект.ЗапросНаВыяснениеПринадлежностиПлатежа 	= "";
	Объект.НомерЗапроса 							= "";
	Объект.ДатаЗапроса 								= "";
	
	НоваяСтрока = Объект.РеквизитыПлатежногоДокумента.Добавить();
	НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор; 
	
	НоваяСтрока.НаименованиеПлатежногоДокумента = "Заявка на возврат";
	НоваяСтрока.НомерПлатежногоДокумента		= ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Основание,Основание.Номер);
	НоваяСтрока.ДатаПлатежногоДокумента			= Основание.Дата;
	НоваяСтрока.ИННПолучателя			 		= Основание.КонтрагентИНН;
	НоваяСтрока.КПППолучателя			 		= Основание.КонтрагентКПП;
	
	КодБК = "";
	Если Основание.КБКНазначениеПлатежа.ДатаНачалаДействия < Дата(2016, 1, 1) Тогда
		КодБК = Основание.КБКНазначениеПлатежа.Код + Основание.КОСГУНазначениеПлатежа.Код;
	Иначе
		Если Основание.ЛицевойСчет.НеВыводитьКодГлавы Тогда
			КодБК =	"000" + Основание.КБКНазначениеПлатежа.Код;
		ИначеЕсли Основание.ИФО.ИспользоватьРеквизитыИФО Тогда
			КодБК = ?(ЗначениеЗаполнено(Основание.ИФО.КодГлавыБК), Основание.ИФО.КодГлавыБК.Код, "000") + Основание.КБКНазначениеПлатежа.Код;
		Иначе
			КодБК = ?(ЗначениеЗаполнено(Основание.ЛицевойСчет.Владелец.КодПоППП), Основание.ЛицевойСчет.Владелец.КодПоППП.Код, "000") + Основание.КБКНазначениеПлатежа.Код;
		КонецЕсли;
	КонецЕсли;	
	
	НоваяСтрока.КодБК			 				= КодБК;

	НоваяСтрока.КодЦели			 				= СокрЛП(Основание.КодЦели) + Лев(Основание.НаправлениеРасходованияВР, 2);
	НоваяСтрока.Сумма			 				= Основание.СуммаДокумента;
	НоваяСтрока.НазначениеПлатежа			 	= Основание.НазначениеПлатежа;
	НоваяСтрока.GUIDФК 							= Документы.ЗаявкаНаВозврат.ПолучитьСостояниеДокумента(Основание).GUIDКО;
	НоваяСтрока.НаименованиеПолучателя 			= Основание.КонтрагентНаименование;
	НоваяСтрока.Примечание		                = "(" + СокрЛП(НоваяСтрока.НомерПлатежногоДокумента) + ")";
	НоваяСтрока.ЗаявкаНаКассовыйРасход          = Основание;
	НоваяСтрока.КодПлатежногоДокумента			= "ZV";

	Возврат Объект.РеквизитыПлатежногоДокумента.Количество() - 1;
	
КонецФункции

Функция ЗаполнитьНаОснованииРасшифровкиВнесенныхЧерезБанкоматСредств(Основание, Объект, ОписаниеОшибки)
	
	УдалениеСтрокСоответвуюшихОснованию(Основание, Объект);	
	
	ЗаполнитьШапкуДокумента(Основание, Объект, ",ПерваяПодпись,ПерваяПодписьПечататьДолжность,ПерваяПодписьДолжность,ВтораяПодпись,ВтораяПодписьДолжность");
	
	Объект.ЗапросНаВыяснениеПринадлежностиПлатежа 	= "";
	Объект.НомерЗапроса 							= "";
	Объект.ДатаЗапроса 								= "";
	Объект.НаименованиеПлательщика 					= "";
	Объект.ИННПлательщика 							= "";
	Объект.КПППлательщика 							= "";
	Объект.ПаспортныеДанныеПлательщика				= "";
	Объект.НомерБанковскогоСчетаПлательщика 		= "";
	
	Для Каждого СтрДок Из Основание.Расшифровка Цикл  
		
		НоваяСтрока = Объект.РеквизитыПлатежногоДокумента.Добавить();
		НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор; 
		
		НоваяСтрока.НаименованиеПлатежногоДокумента = "Расшифровка внесенных через банкомат средств";
		НоваяСтрока.НомерПлатежногоДокумента		= ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Основание,Основание.Номер);
		НоваяСтрока.ДатаПлатежногоДокумента			= Основание.Дата;
		НоваяСтрока.ИННПолучателя			 		= ?(ЗначениеЗаполнено(Основание.Договор.Контрагент), Основание.Договор.Контрагент.ИНН, "");
		НоваяСтрока.КПППолучателя			 		= ?(ЗначениеЗаполнено(Основание.Договор.Контрагент), Основание.Договор.Контрагент.КПП, "");
		
		КодБК = "";      
		
		Если Основание.ЛицевойСчет.НеВыводитьКодГлавы Тогда
			КодБК =	"000" + СтрДок.КПС.Код;
		ИначеЕсли Основание.ИФО.ИспользоватьРеквизитыИФО Тогда
			КодБК = ?(ЗначениеЗаполнено(Основание.ИФО.КодГлавыБК), Основание.ИФО.КодГлавыБК.Код, "000") + СтрДок.КПС.Код;
		Иначе
			КодБК = ?(ЗначениеЗаполнено(Основание.ЛицевойСчет.Владелец.КодПоППП), Основание.ЛицевойСчет.Владелец.КодПоППП.Код, "000") + СтрДок.КПС.Код;
		КонецЕсли;
			
		
		НоваяСтрока.КодБК			 				= КодБК;
		
		НоваяСтрока.КодЦели			 				= СокрЛП(СтрДок.КодЦели);
		НоваяСтрока.ОКАТО			 				= СтрДок.ОКТМО;
		НоваяСтрока.Сумма			 				= СтрДок.Сумма;
		НоваяСтрока.НазначениеПлатежа			 	= "";
		НоваяСтрока.ВидБК 							= СтрДок.КПС.ВидПоказателя;
		НоваяСтрока.КодПлатежногоДокумента			= "RN";
		НоваяСтрока.GUIDФК 							= Документы.РасшифровкаВнесенныхЧерезБанкоматСредств.ПолучитьСостояниеДокумента(Основание).GUIDКО;
		НоваяСтрока.НаименованиеПолучателя 			= ?(ЗначениеЗаполнено(Основание.Договор.Контрагент), Основание.Договор.Контрагент.Наименование, "");
		НоваяСтрока.Примечание		                = "(" + СокрЛП(НоваяСтрока.НомерПлатежногоДокумента) + ")" + СтрДок.Примечание;
		НоваяСтрока.ЗаявкаНаКассовыйРасход          = Основание;
		НоваяСтрока.ЛицевойСчетПолучателя           = "";

	КонецЦикла;
	
	Если Объект.РеквизитыПлатежногоДокумента.Количество() = 0 Тогда		
		ОписаниеОшибки = НСтр("ru='Для ввода на основании необходимо заполнить расшифровку платежа.'");
	КонецЕсли;
	
	Возврат Объект.РеквизитыПлатежногоДокумента.Количество() - 1;

КонецФункции	

