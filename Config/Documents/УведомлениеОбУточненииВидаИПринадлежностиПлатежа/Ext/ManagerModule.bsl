	НоваяСтрока.НазначениеПлатежа			 	= Основание.НазначениеПлатежа;
	НоваяСтрока.ВидБК 							= Основание.КБКНазначениеПлатежа.ВидПоказателя;
	НоваяСтрока.КодПлатежногоДокумента			= "ZR";
