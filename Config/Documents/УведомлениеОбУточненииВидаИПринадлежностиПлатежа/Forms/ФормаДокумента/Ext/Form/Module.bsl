&НаСервере
Процедура ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию()
	
	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.УведомлениеОбУточненииВидаИПринадлежностиПлатежа", Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
	
	Объект.ЛицевойСчет 				= Умолчания.ЛицевойСчет;
	Объект.РеквизитыЛицевогоСчета 	= Умолчания.РеквизитыЛицевогоСчета;
	Объект.ОрганКазначейства		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
	ПриИзмененииЛицевогоСчета();
	
КонецПроцедуры	

&НаКлиенте
ПРоцедура ПриИзмененииЗапросНаВыяснениеПринадлежностиПлатежа()
	
	Объект.НомерЗапроса = "";
 	Объект.ДатаЗапроса  = "";
    Объект.РеквизитыПлатежногоДокумента.Очистить();
 	Объект.ИзмененныеРеквизиты.Очистить();
	
	Если не ЗначениеЗаполнено(Объект.ЗапросНаВыяснениеПринадлежностиПлатежа) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.РеквизитыПлатежногоДокумента.ТекущаяСтрока = ЗаполнитьНаОсновании(Объект.ЗапросНаВыяснениеПринадлежностиПлатежа);
	УстановитьВидимостьРеквизитов();
	
КонецПРоцедуры	

&НаСервере
Процедура ПолучитьЛицевойСчетОрганКазначейства()
	
	Объект.ЛицевойСчет 				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "Владелец");
	Объект.ОрганКазначейства		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
   	ПриИзмененииЛицевогоСчета();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьРеквизитов()
	
	Элементы.РеквизитыПлатежногоДокументаВыборДокумента.Доступность = НЕ ЗначениеЗаполнено(Объект.ЗапросНаВыяснениеПринадлежностиПлатежа); 
	//Элементы.ЗаявкаНаНаличные.Доступность = НЕ ЗначениеЗаполнено(Объект.ЗапросНаВыяснениеПринадлежностиПлатежа); 
	//Элементы.ЗаявкаНаКассовыйРасходСокращенная.Доступность = НЕ ЗначениеЗаполнено(Объект.ЗапросНаВыяснениеПринадлежностиПлатежа); 
	// Элементы.УведомлениеОбУточненииВидаИПринадлежностиПлатежа.Доступность = НЕ ЗначениеЗаполнено(Объект.ЗапросНаВыяснениеПринадлежностиПлатежа); 

КонецПроцедуры	

&НаСервере
Функция ЗаполнитьНаОсновании(Основание)
	Возврат Документы.УведомлениеОбУточненииВидаИПринадлежностиПлатежа.ЗаполнитьНаОсновании(Основание, Объект);
КонецФункции

&НаКлиенте
Процедура ОтборДляИзмененныеРеквизиты(КлючСтроки)
	
	Если Элементы.ИзмененныеРеквизиты.ОтборСтрок = Неопределено ИЛИ НЕ (Элементы.ИзмененныеРеквизиты.ОтборСтрок.Свойство("КлючСтроки") И Элементы.ИзмененныеРеквизиты.ОтборСтрок.КлючСтроки = КлючСтроки) Тогда
		
		Элементы.ИзмененныеРеквизиты.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки",КлючСтроки));
		
	КонецЕсли;
	
КонецПРоцедуры	

&НаСервере
Процедура ПриИзмененииЛицевогоСчета()
	
	Перем ДопустимыеИсточникиСредств;
	
	СвойстваЛицевогоСчета 		= ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет, Объект.Дата); 	
	ДопустимыеИсточникиСредств 	= ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет);

	Если ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		Объект.ПерваяПодпись 					= СвойстваЛицевогоСчета.ПерваяПодпись;
		Объект.ВтораяПодпись 					= СвойстваЛицевогоСчета.ВтораяПодпись;
		Объект.ПерваяПодписьПечататьДолжность 	= СвойстваЛицевогоСчета.ПерваяПодписьПечататьДолжность;
		Объект.ПерваяПодписьДолжность         	= СвойстваЛицевогоСчета.ПерваяПодписьДолжность;
		Объект.ВтораяПодписьДолжность		  	= СвойстваЛицевогоСчета.ВтораяПодписьДолжность;
	Иначе
		Объект.ПерваяПодписьПечататьДолжность 	= Ложь;
		Объект.ПерваяПодписьДолжность         	= "";
		Объект.ВтораяПодписьДолжность		  	= "";
		Объект.ОрганКазначейства				= "";
	КонецЕсли;	
	
	Элементы.ИсточникСредств.СписокВыбора.ЗагрузитьЗначения(ДопустимыеИсточникиСредств);
	
КонецПроцедуры

&НаСервере
Функция ПриИзмененииСчетКонтрагента()
	
	ПлатежныеРеквизиты = Новый Структура("Код","СчетНомер");
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(Объект.СчетКонтрагента, Объект.СчетКонтрагента, ПлатежныеРеквизиты);
	
	Объект.НомерБанковскогоСчетаПлательщика = ПлатежныеРеквизиты.Код
	
КонецФункции

&НаСервереБезКонтекста
Функция УстановитьДолжность(Знач Подпись, ПодписьПечататьДолжность, ДатаСведений)
	Возврат ПлатежноРасчетныеДокументыПовтИсп.ПолучитьДолжностьСотрудника(Подпись, ПодписьПечататьДолжность, ДатаСведений);
КонецФункции

&НаСервереБезКонтекста
Функция ПолучиьтДанныеКонтрагента(Знач Контрагент, Дата)
	СтруктураРеквизитов = Новый Структура();
	ПлатежноРасчетныеДокументы.ПолучитьДанныеЗаполнитьСтруктуру(Контрагент, Дата, СтруктураРеквизитов);
	Возврат СтруктураРеквизитов;	
КонецФункции
	
&НаСервере
Процедура ПриИзмененииКонтрагента()
	
	Объект.НаименованиеПлательщика 			= "";
	Объект.ПаспортныеДанныеПлательщика 		= "";
    Объект.ИННПлательщика 					= "";
    Объект.КПППлательщика 					= "";
	Объект.НомерБанковскогоСчетаПлательщика	= "";	
	
	Если не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		
		Объект.НомерБанковскогоСчетаПлательщика = "";

		Возврат;
	КонецЕсли;
	
	СтруктураРеквизитов = ПолучиьтДанныеКонтрагента(Объект.Контрагент, Объект.Дата);

	Объект.НаименованиеПлательщика 		= СтруктураРеквизитов.НаименованиеПолное;    		
	Объект.ПаспортныеДанныеПлательщика	= СтруктураРеквизитов.УдостоверениеЛичности;
	Объект.ИННПлательщика				= СтруктураРеквизитов.ИНН;      	
	Объект.КПППлательщика				= СтруктураРеквизитов.КПП;

	Объект.СчетКонтрагента = Справочники.БанковскиеИКазначейскиеСчета.ПолучитьСчетПоУмолчанию(Объект.Контрагент, "Документ.УведомлениеОбУточненииВидаИПринадлежностиПлатежа");

	ПриИзмененииСчетКонтрагента();
			
КонецПроцедуры

