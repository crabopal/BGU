#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НастроитьСоставРегистров(Команда)

	АдресСпискаРегистров = ПодготовитьСписокРегистровДляЕгоНастройки();
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("АдресСпискаРегистров", АдресСпискаРегистров);
	
	ОткрытьФорму("Документ.КорректировкаРегистров.Форма.ФормаНастройки", СтруктураПараметров, ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьАктивностьПроводок(Команда)

	Если Объект.ПометкаУдаления Тогда
		ПоказатьПредупреждение(Неопределено, НСтр(
		"ru = 'Документ помечен на удаление, 
        |поэтому переключить активность проводок нельзя.
        |Снимите пометку удаления.'"));
		Возврат;
	КонецЕсли;
	
	ПереключитьАктивностьПроводокСервер();

КонецПроцедуры

&НаСервере
Процедура ПереключитьАктивностьПроводокСервер()

	ТекущаяАктивность = Ложь;
	ТекущаяСтраница = СтрЗаменить(Элементы.ПанельРегистров.ТекущаяСтраница.Имя,"Группа","");
	Если Объект.Движения[ТекущаяСтраница].Количество() > 0 Тогда
		ТекущаяАктивность = Объект.Движения[ТекущаяСтраница][0].Активность;
	КонецЕсли;
	
	СтрокиРег = Регистры.НайтиСтроки(Новый Структура("Имя",ТекущаяСтраница));
	Если СтрокиРег.Количество()>0 Тогда
		Если СтрокиРег[0].ТипРегистра = "РегистрСведений" Тогда
			НаборЗаписейРС = ДанныеФормыВЗначение(Объект.Движения[ТекущаяСтраница],Тип("РегистрСведенийНаборЗаписей."+ТекущаяСтраница));
			НаборЗаписейРС.УстановитьАктивность(НЕ ТекущаяАктивность);
			ЗначениеВДанныеФормы(НаборЗаписейРС,Объект.Движения[ТекущаяСтраница]);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Для каждого СтрокаДвижения Из Объект.Движения[ТекущаяСтраница] Цикл
		СтрокаДвижения.Активность = (НЕ ТекущаяАктивность);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура КнопкаЗаполнить(Команда)

	Если Объект.СпособЗаполнения <> СпособЗаполненияСторно Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьДвижения() Тогда
		ТекстВопроса = НСтр("ru = 'Существующие проводки и движения регистров будут очищены.
			|Продолжить?'");
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		СформироватьДвиженияСторноСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СформироватьДвиженияСторноСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПроводкиНУ(Команда)
	
	НомераПроводокНУ = ПолучитьНомераПроводокНУ();
	
	Если НомераПроводокНУ.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьПроводкиНУЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Существующие проводки налогового учета будут очищены. Заполнить?'"),
			РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьПроводкиНУНаСервере(НомераПроводокНУ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьПроводкиНУЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПроводкиНУНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроводкиНУНаСервере(НомераПроводокНУ = Неопределено)
	
	Если НомераПроводокНУ = Неопределено Тогда
		НомераПроводокНУ = ПолучитьНомераПроводокНУ();
	КонецЕсли;
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	НаборДвижений = ДокументОбъект.Движения.ЖурналПроводокЕПСБУ;
	
	// Удаляем существующие проводки НУ.
	КоличествоПроводокНУ = НомераПроводокНУ.Количество();
	Для Сч=1 По КоличествоПроводокНУ Цикл
		НомерПроводкиНУ = НомераПроводокНУ.Получить(КоличествоПроводокНУ - Сч);
		НаборДвижений.Удалить(НомерПроводкиНУ - 1);
	КонецЦикла;
	
	// Сформируем таблицу проводок БУ.
	// В новых проводках могут быть не заполнены Организация и Период.
	ТаблицаПроводок = НаборДвижений.Выгрузить();
	ТаблицаПроводок.ЗаполнитьЗначения(ДокументОбъект.Организация, "Организация");
	ТаблицаПроводок.ЗаполнитьЗначения(ДокументОбъект.Дата, "Период");
	
	// Сформируем таблицу проводок НУ по таблице проводок БУ.
	ТаблицаПроводокНУ = НалоговыйУчет.СформироватьПроводкиНУпоБУ(ДокументОбъект, ТаблицаПроводок);
	
	// Загрузим проводки БУ и НУ в табличную часть операции.
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаПроводокНУ, ТаблицаПроводок);
	НаборДвижений.Загрузить(ТаблицаПроводок);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

