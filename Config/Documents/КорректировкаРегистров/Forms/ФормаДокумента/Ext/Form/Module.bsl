&НаКлиенте
Процедура ДвиженияЖурналПроводокПериодПриИзменении(Элемент)
	ТекДанные = Элементы.ДвиженияЖурналПроводок.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекДанные.ВидМежотчетногоПериода) Тогда
		Если КонецГода(ТекДанные.Период) = КонецДня(ТекДанные.Период) Тогда
			ТекДанные.Период = КонецДня(ТекДанные.Период);
		Иначе
			ТекДанные.ВидМежотчетногоПериода = ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ПустаяСсылка");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияЖурналПроводокВидМежотчетногоПериодаПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДвиженияЖурналПроводок.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекДанные.ВидМежотчетногоПериода) Тогда
		Если ЗначениеЗаполнено(ТекДанные.Период) Тогда
			ТекДанные.Период = КонецГода(ТекДанные.Период);
		ИначеЕсли ЗначениеЗаполнено(Объект.Дата) Тогда
			ТекДанные.Период = КонецГода(Объект.Дата);
		Иначе
			ТекДанные.Период = КонецГода(ПолучитьРабочуюДату());
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
	
