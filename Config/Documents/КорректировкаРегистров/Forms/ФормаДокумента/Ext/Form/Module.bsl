&НаКлиенте
Процедура ДвиженияЖурналПроводокСчетДтПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДвиженияЖурналПроводок.ТекущиеДанные;
	ТекущиеДанные.ЖурналОпераций = БухгалтерскиеОперацииВызовСервера.НомерЖурнала(ТекущиеДанные.СчетДт, ТекущиеДанные.СчетКт);
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияЖурналПроводокСчетДтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДвиженияЖурналПроводок.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			ТекущиеДанные.СчетДт, 
																			ТекущиеДанные.КПСДт, 
																			ТекущиеДанные.КФО), 
															Объект.Организация,
															ТекущиеДанные.ИФО,
															,
															ТекущиеДанные.КФО,
															,
															Объект.Дата,
															Новый Структура("КорреспонденцияКт", ТекущиеДанные.СчетКт));
	
КонецПроцедуры

