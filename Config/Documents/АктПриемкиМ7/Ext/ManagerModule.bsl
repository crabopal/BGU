	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);				   
					   
	Выборка = Запрос.Выполнить().Выбрать();
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.АктПриемкиМ7.ПФ_MXL_АктПриемкиМ7");
