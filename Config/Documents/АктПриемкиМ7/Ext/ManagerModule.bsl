	Пока Выборка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
			
		// вывод первой страницы документа
		
		ПараметрыЗаголовка = Новый Структура();
		
		ОбластьМакетаЗаголовок.Параметры.Заполнить(Выборка);
		
		ПараметрыЗаголовка = Новый Структура("НаименованиеГрузоотправитель, АдресГрузоотправитель, НаименованиеКонтрагент,"
			+ "АдресКонтрагент, НаименованиеСтраховаяКомпания, АдресСтраховаяКомпания, АдресОрганизация");
		ПараметрыЗаголовка.АдресГрузоотправитель = ПочтовыйАдресКонтрагента(
			Выборка.ГрузоотправительЮридическоеФизическоеЛицо, Выборка.ГрузоотправительВидКонтрагента);
		ПараметрыЗаголовка.АдресКонтрагент = ЮридическийАдресКонтрагента(
			Выборка.КонтрагентЮридическоеФизическоеЛицо, Выборка.КонтрагентВидКонтрагента);
		ПараметрыЗаголовка.АдресСтраховаяКомпания = ЮридическийАдресКонтрагента(
			Выборка.СтраховаяКомпанияЮридическоеФизическоеЛицо, Выборка.СтраховаяКомпанияВидКонтрагента);
		ПараметрыЗаголовка.НаименованиеГрузоотправитель = НаименованиеКонтрагента(Выборка.ГрузоотправительНаименованиеСокращенное,
			Выборка.ГрузоотправительНаименованиеПолное, Выборка.ГрузоотправительВидКонтрагента);
		ПараметрыЗаголовка.НаименованиеКонтрагент = НаименованиеКонтрагента(Выборка.КонтрагентНаименованиеСокращенное,
			Выборка.КонтрагентНаименованиеПолное, Выборка.КонтрагентВидКонтрагента);
		ПараметрыЗаголовка.НаименованиеСтраховаяКомпания = НаименованиеКонтрагента(Выборка.СтраховаяКомпанияНаименованиеСокращенное,
			Выборка.СтраховаяКомпанияНаименованиеПолное, Выборка.СтраховаяКомпанияВидКонтрагента);
		ПараметрыЗаголовка.АдресОрганизация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Выборка.Организация, Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации);
		ОбластьМакетаЗаголовок.Параметры.Заполнить(ПараметрыЗаголовка);
		
		ОтветственныеЛица = Справочники.Организации.ПолучитьОтветственныхЛицОрганизации(Выборка.Организация, Выборка.Дата);
		СтрРуководитель = ОтветственныеЛица.Найти(Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, "ИсполняемаяФункцияСсылка");
		
		СтруктураЗаголовок = Новый Структура("ФИОРуководитель, ДолжностьРуководитель, Номер, ДатаЗаголовка, НомерДатаСопроводительногоДокумента");
		Если СтрРуководитель <> Неопределено Тогда
			СтруктураЗаголовок.ФИОРуководитель       = Справочники.Сотрудники.ФамилияИО(СтрРуководитель.ОтветственноеЛицоСсылка, Истина, Выборка.Дата);
			СтруктураЗаголовок.ДолжностьРуководитель = СтрРуководитель.ДолжностьПредставление;
		КонецЕсли;
		СтруктураЗаголовок.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Выборка.Ссылка, Выборка.Номер);
		СтруктураЗаголовок.ДатаЗаголовка = Формат(Выборка.Дата, "ДЛФ=DD");
		СтруктураЗаголовок.НомерДатаСопроводительногоДокумента = СтрШаблон(НСтр("ru = '%1 от %2 №%3'"),
			СокрЛП(Выборка.ВидСопроводительногоТД),
			Формат(Выборка.ДатаСопроводительногоТД, "ДЛФ=DD"),
			СокрЛП(Выборка.НомерСопроводительногоТД));
		
		ОбластьМакетаЗаголовок.Параметры.Заполнить(СтруктураЗаголовок);
		
		ТабДокумент.Вывести(ОбластьМакетаЗаголовок);
		ТабДокумент.Вывести(ОбластьМакетаШапка1);
		
		ВыборкаСоставКонтейнеров = Выборка.СоставКонтейнеров.Выбрать();
		
		Пока ВыборкаСоставКонтейнеров.Следующий() Цикл
			ОбластьМакетаСтрока1.Параметры.Заполнить(ВыборкаСоставКонтейнеров);
			ТабДокумент.Вывести(ОбластьМакетаСтрока1);
		КонецЦикла;	
		
		Области = Новый Массив;
		Области.Добавить(ОбластьМакетаСтрока1Пустая);
		Области.Добавить(ОбластьМакетаСтрока1Пустая);
		
		Попытка
			Пока ТабДокумент.ПроверитьВывод(Области) Цикл
				ТабДокумент.Вывести(ОбластьМакетаСтрока1Пустая);
			КонецЦикла;
		Исключение
		КонецПопытки;
		
		// вывод второй страницы документа
	
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				
		ТабДокумент.Вывести(ОбластьМакетаТаблица1);
				
		Если ПустаяСтрока(Выборка.УсловияХранения)
			И ПустаяСтрока(Выборка.СостояниеТары)
			И ПустаяСтрока(Выборка.ДругиеДанные) Тогда
			ОбластьМакетаСтраница2.Параметры.Заполнить(Выборка);
			ТабДокумент.Вывести(ОбластьМакетаСтраница2);
		Иначе
			Если ПустаяСтрока(Выборка.УсловияХранения) Тогда
				ТабДокумент.Вывести(ОбластьМакетаСтраница2_1);
			Иначе
				ОбластьМакетаСтраница2_1_2.Параметры.Заполнить(Выборка);
				ТабДокумент.Вывести(ОбластьМакетаСтраница2_1_1);
				ТабДокумент.Вывести(ОбластьМакетаСтраница2_1_2);
				ТабДокумент.Вывести(ОбластьМакетаСтраница2_1_3);
			КонецЕсли;
			
			Если ПустаяСтрока(Выборка.СостояниеТары) Тогда
				ТабДокумент.Вывести(ОбластьМакетаСтраница2_2);
			Иначе
				ОбластьМакетаСтраница2_2_2.Параметры.Заполнить(Выборка);
				ТабДокумент.Вывести(ОбластьМакетаСтраница2_2_1);
				ТабДокумент.Вывести(ОбластьМакетаСтраница2_2_2);
				ТабДокумент.Вывести(ОбластьМакетаСтраница2_1_3);
			КонецЕсли;
			
			ОбластьМакетаСтраница2_3.Параметры.Заполнить(Выборка);
			ТабДокумент.Вывести(ОбластьМакетаСтраница2_3);
			
			Если ПустаяСтрока(Выборка.ДругиеДанные) Тогда
				ТабДокумент.Вывести(ОбластьМакетаСтраница2_4);
			Иначе
				ОбластьМакетаСтраница2_4_2.Параметры.Заполнить(Выборка);
				ТабДокумент.Вывести(ОбластьМакетаСтраница2_4_1);
				ТабДокумент.Вывести(ОбластьМакетаСтраница2_4_2);
				ТабДокумент.Вывести(ОбластьМакетаСтраница2_1_3);	
			КонецЕсли;
		КонецЕсли;
		
		// вывод третьей страницы документа
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ОбластьМакетаТаблица2.Параметры.Заполнить(Выборка);
		ТабДокумент.Вывести(ОбластьМакетаТаблица2);
		ТабДокумент.Вывести(ОбластьМакетаШапка2);
		
		Итоги9 = ИтогиТаблицы9();
		
		ВывестиСоставТаблицыМЦ(Выборка.Материалы.Выбрать(), ТабДокумент, ОбластиДляСтроки, Итоги9);
		ВывестиСоставТаблицыМЦ(Выборка.ОсновныеСредства.Выбрать(), ТабДокумент, ОбластиДляСтроки, Итоги9);
		
		ВывестиПустыеСтрокиДоКонцаСтраницыИСтрокуИтога(ТабДокумент, ОбластиДляСтроки);
		
		// вывод четвертой страницы документа
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ПереченьДокументов = Новый Массив;
		ВыборкаСоставПриложения = Выборка.СоставПриложения.Выбрать();
		Пока ВыборкаСоставПриложения.Следующий() Цикл
			ПереченьДокументов.Добавить(СтрШаблон(НСтр("ru = '%1 от %2 №%3'"),
				ВыборкаСоставПриложения.ВидПриложения,
				Формат(ВыборкаСоставПриложения.ДатаДокумента, "ДЛФ=D"),
				ВыборкаСоставПриложения.НомерДокумента));
		КонецЦикла;
		
		ОбластьМакетаСтраница4.Параметры.Заполнить(Выборка);
		ОбластьМакетаСтраница4.Параметры.Заполнить(Новый Структура("ПереченьДокументов", СтрСоединить(ПереченьДокументов, НСтр("ru = ', '"))));
		ТабДокумент.Вывести(ОбластьМакетаСтраница4);
		
		ВыборкаКомиссии = Выборка.СоставКомиссии.Выгрузить();
		
		Отбор = Новый Структура("Председатель", Истина);
		СтрПредседатель = ВыборкаКомиссии.НайтиСтроки(Отбор);
		СтатусЧленаКомиссии = НСтр("ru = 'Председатель комиссии'");
		Если СтрПредседатель.Количество() > 0 Тогда
			ВывестиЧленаКомиссии(ТабДокумент, ОбластьМакетаКомиссия, СтрПредседатель[0], СтатусЧленаКомиссии);
		Иначе
			ВывестиЧленаКомиссии(ТабДокумент, ОбластьМакетаКомиссия, Неопределено, СтатусЧленаКомиссии);
		КонецЕсли;
				
		Отбор = Новый Структура("Председатель", Ложь);
		СтрокиКомиссия = ВыборкаКомиссии.НайтиСтроки(Отбор);
		СтатусЧленаКомиссии =  НСтр("ru = 'Члены комиссии'");
		Для Каждого ВыборкаКомиссии Из СтрокиКомиссия Цикл
			ВывестиЧленаКомиссии(ТабДокумент, ОбластьМакетаКомиссия, ВыборкаКомиссии, СтатусЧленаКомиссии);
			СтатусЧленаКомиссии = "";
		КонецЦикла;
		
		Для Счетчик = СтрокиКомиссия.Количество() По 2 Цикл
		
			ВывестиЧленаКомиссии(ТабДокумент, ОбластьМакетаКомиссия, Неопределено, СтатусЧленаКомиссии);
			СтатусЧленаКомиссии = "";
		
		КонецЦикла; 
		
		ОбластьМакетаСтраница41.Параметры.Заполнить(Выборка);
		Если ЗначениеЗаполнено(Выборка.МОЛ) Тогда
			ОбластьМакетаСтраница41.Параметры.Заполнить(Новый Структура("ФИОМОЛ", Корреспонденты.ФИОПоОбъекту(Выборка.МОЛ, Истина)));
		КонецЕсли;	
		ПараметрыОбластиОтветственного = Новый Структура("ДолжностьОтвИсполнитель, ФИООтвИсполнитель, ТелефонОтвИсполнитель, ЭлАдресОтвИсполнитель");
		Если ЗначениеЗаполнено(Выборка.Ответственный) Тогда
			ДанныеОтветственного = УправлениеПечатьюБГУ.СведенияИсполнителяПоОтветственному(Выборка.Ответственный,
				Выборка.Организация, 
				Выборка.Дата,
				Истина);
			ПараметрыОбластиОтветственного.ДолжностьОтвИсполнитель = ДанныеОтветственного.ДолжностьНаименование;
			ПараметрыОбластиОтветственного.ФИООтвИсполнитель       = ДанныеОтветственного.ФИО;
			ПараметрыОбластиОтветственного.ТелефонОтвИсполнитель   = ДанныеОтветственного.НомерТелефона;
			ПараметрыОбластиОтветственного.ЭлАдресОтвИсполнитель   = ДанныеОтветственного.ЭлектроннаяПочта;
		КонецЕсли;
		ОбластьМакетаСтраница41.Параметры.Заполнить(ПараметрыОбластиОтветственного);
		ТабДокумент.Вывести(ОбластьМакетаСтраница41);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ЮридическийАдресКонтрагента(Контрагент, ВидКонтрагента)

	Если ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда 
		
		Возврат УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Контрагент, Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты);
		
	Иначе
		
		Возврат УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Контрагент, Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица);
		
	КонецЕсли;

КонецФункции

Функция ПочтовыйАдресКонтрагента(Контрагент, ВидКонтрагента)

	Если ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда 
		
		Возврат УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Контрагент, Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты);
		
	Иначе
		
		Возврат УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Контрагент, Справочники.ВидыКонтактнойИнформации.АдресДляИнформированияФизическиеЛица);
		
	КонецЕсли;

КонецФункции

Функция НаименованиеКонтрагента(Краткое, Полное, ВидКонтрагента)

	Если ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		
		Возврат Краткое;
		
	КонецЕсли;
	
	Возврат ?(ЗначениеЗаполнено(Полное), Полное, Краткое);

КонецФункции

Процедура ДобавитьВИтоги(Итоги9, СтрокаСоставаМЦ)

	Итоги9.ИтогоКоличествоПоДокументам = Итоги9.ИтогоКоличествоПоДокументам + СтрокаСоставаМЦ.КоличествоПоДокументам;
	Итоги9.ИтогоСуммаПоДокументам      = Итоги9.ИтогоСуммаПоДокументам      + СтрокаСоставаМЦ.СуммаПоДокументам;
	Итоги9.ИтогоКоличество             = Итоги9.ИтогоКоличество             + СтрокаСоставаМЦ.Количество;
	Итоги9.ИтогоСумма                  = Итоги9.ИтогоСумма                  + СтрокаСоставаМЦ.Сумма;
	Итоги9.ИтогоКоличествоИзлишки      = Итоги9.ИтогоКоличествоИзлишки      + СтрокаСоставаМЦ.КоличествоИзлишки;
	Итоги9.ИтогоСуммаИзлишки           = Итоги9.ИтогоСуммаИзлишки           + СтрокаСоставаМЦ.СуммаИзлишки;
	Итоги9.ИтогоКоличествоБой          = Итоги9.ИтогоКоличествоБой          + СтрокаСоставаМЦ.КоличествоБой;
	Итоги9.ИтогоСуммаБой               = Итоги9.ИтогоСуммаБой               + СтрокаСоставаМЦ.СуммаБой;
	Итоги9.ИтогоКоличествоНедостачи    = Итоги9.ИтогоКоличествоНедостачи    + СтрокаСоставаМЦ.КоличествоНедостачи;
	Итоги9.ИтогоСуммаНедостачи         = Итоги9.ИтогоСуммаНедостачи         + СтрокаСоставаМЦ.СуммаНедостачи;

КонецПроцедуры

Процедура ВывестиСоставТаблицыМЦ(ВыборкаСоставМЦ, ТабДокумент, Области, Итоги9)

	ОбластьМакетаСтрока2    = Области.ОбластьМакетаСтрока2;
	ОбластьМакетаИтог9      = Области.ОбластьМакетаИтог9;
	ОбластьМакетаЗаголовок3 = Области.ОбластьМакетаЗаголовок3;
	ОбластьМакетаШапка9     = Области.ОбластьМакетаШапка9;
	
	Пока ВыборкаСоставМЦ.Следующий() Цикл
		
		ОбластьМакетаСтрока2.Параметры.Заполнить(ВыборкаСоставМЦ);
		
		ДобавитьВИтоги(Итоги9, ВыборкаСоставМЦ);
		
		ОбластьМакетаИтог9.Параметры.Заполнить(Итоги9);
		
		ОбластиДляПроверки = Новый Массив;
		ОбластиДляПроверки.Добавить(ОбластьМакетаСтрока2);
		ОбластиДляПроверки.Добавить(ОбластьМакетаИтог9);
		
		Если НЕ ТабДокумент.ПроверитьВывод(ОбластиДляПроверки) Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			ТабДокумент.Вывести(ОбластьМакетаЗаголовок3);
			ТабДокумент.Вывести(ОбластьМакетаШапка9);
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьМакетаСтрока2);
		
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиПустыеСтрокиДоКонцаСтраницыИСтрокуИтога(ТабДокумент, Области)

	ОбластиДляПроверки = Новый Массив;
	ОбластиДляПроверки.Добавить(Области.ОбластьМакетаСтрока2Пустая);
	ОбластиДляПроверки.Добавить(Области.ОбластьМакетаИтог9);
	
	Пока ТабДокумент.ПроверитьВывод(ОбластиДляПроверки) Цикл
		ТабДокумент.Вывести(Области.ОбластьМакетаСтрока2Пустая);
	КонецЦикла;
	
	ТабДокумент.Вывести(Области.ОбластьМакетаИтог9);

КонецПроцедуры
 
Процедура ВывестиЧленаКомиссии(ТабДокумент, Область, ДанныеЧленаКомиссии, СтатусЧленаКомиссии)

	ПараметрыСтроки = Новый Структура("СтатусЧленаКомиссии, ДолжностьЧленаКомиссии, ФИОЧленаКомиссии",
		СтатусЧленаКомиссии);
	Если ДанныеЧленаКомиссии <> Неопределено Тогда
		СтруктураФИО = Новый Структура("Фамилия, Имя, Отчество",
			ДанныеЧленаКомиссии.ФамилияЧленаКомиссии,
			ДанныеЧленаКомиссии.ИмяЧленаКомиссии,
			ДанныеЧленаКомиссии.ОтчествоЧленаКомиссии);
		ПараметрыСтроки.ФИОЧленаКомиссии       = КорреспондентыКлиентСервер.ФИО(СтруктураФИО, Истина);
		ПараметрыСтроки.ДолжностьЧленаКомиссии = ДанныеЧленаКомиссии.ДолжностьЧленаКомиссии;
	КонецЕсли;
	Область.Параметры.Заполнить(ПараметрыСтроки);
	ТабДокумент.Вывести(Область);

КонецПроцедуры

Функция ИтогиТаблицы9()

	Итоги9 = Новый Структура("ИтогоКоличествоПоДокументам, ИтогоСуммаПоДокументам, ИтогоКоличество, ИтогоСумма,"
		+ "ИтогоКоличествоИзлишки, ИтогоСуммаИзлишки, ИтогоКоличествоБой, ИтогоСуммаБой, ИтогоКоличествоНедостачи, ИтогоСуммаНедостачи");
	Для каждого ЗаписьСтруктуры Из Итоги9 Цикл
	
		Итоги9[ЗаписьСтруктуры.Ключ] = 0;
	
	КонецЦикла;
	
	Возврат Итоги9;

КонецФункции

