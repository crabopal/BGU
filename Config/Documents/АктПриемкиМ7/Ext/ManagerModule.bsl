			ОбластьМакетаСтраница2.Параметры.Заполнить(Выборка);
			ТабДокумент2.Вывести(ОбластьМакетаСтраница2);
		Иначе
			Если ПустаяСтрока(Выборка.УсловияХранения) Тогда
				ТабДокумент2.Вывести(ОбластьМакетаСтраница2_1);
			Иначе
				ОбластьМакетаСтраница2_1_2.Параметры.Заполнить(Выборка);
				ТабДокумент2.Вывести(ОбластьМакетаСтраница2_1_1);
				ТабДокумент2.Вывести(ОбластьМакетаСтраница2_1_2);
				ТабДокумент2.Вывести(ОбластьМакетаСтраница2_1_3);	
