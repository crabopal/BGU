КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", "Акт о приемке материалов");
	Запрос.УстановитьПараметр("НомерДокумента", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка.Ссылка,ДокументСсылка.Номер));
	
	НомераТаблиц = Новый Структура;
	
	ИнициализироватьЗапросыПоОстаткамТоваров(Запрос, НомераТаблиц);
	
	#Область УчетДрагМатериалов
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц);
	#КонецОбласти
	
	ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц)

	НомераТаблиц.Вставить("НаличиеДрагМатериаловВОбъектахНФА", НомераТаблиц.Количество()+1);
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	 "ВЫБРАТЬ
	 |	АктПриемкиМ7ДрагоценныеМатериалы.Ссылка.Дата КАК Период,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.Ссылка КАК Регистратор,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.Ссылка.Организация,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.ОбъектНФА,
	 |	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.ВидДрагМатериала,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	 |	&ИмяДокумента КАК Основание,
	 |	&НомерДокумента КАК НомерОснования,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.ЕдИзм,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации
	 |ИЗ
	 |	Документ.АктПриемкиМ7.ДрагоценныеМатериалы КАК АктПриемкиМ7ДрагоценныеМатериалы
	 |ГДЕ
	 |	АктПриемкиМ7ДрагоценныеМатериалы.Ссылка = &Ссылка
	 |	И АктПриемкиМ7ДрагоценныеМатериалы.МассаДМ > 0
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	НомерСтроки";
	 
	НомераТаблиц.Вставить("НаличиеДрагМатериаловВЛомеИОтходах", НомераТаблиц.Количество()+1);
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	 "ВЫБРАТЬ
	 |	АктПриемкиМ7ДрагоценныеМатериалы.Ссылка.Дата КАК Период,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.Ссылка КАК Регистратор,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.Ссылка.Организация,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.ОбъектНФА,
	 |	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ЛомДМ) КАК ВидОбъекта,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.ВидДрагМатериала,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.ЧистаяМасса,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.ЛигатурнаяМасса,
	 |	&ИмяДокумента КАК Основание,
	 |	&НомерДокумента КАК НомерОснования,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.ЕдИзм,
	 |	АктПриемкиМ7ДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации
	 |ИЗ
	 |	Документ.АктПриемкиМ7.ДрагоценныеМатериалы КАК АктПриемкиМ7ДрагоценныеМатериалы
	 |ГДЕ
	 |	АктПриемкиМ7ДрагоценныеМатериалы.Ссылка = &Ссылка
	 |	И АктПриемкиМ7ДрагоценныеМатериалы.ЛигатурнаяМасса + АктПриемкиМ7ДрагоценныеМатериалы.ЧистаяМасса > 0
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	НомерСтроки";
	 
КонецПроцедуры	

Процедура ИнициализироватьЗапросыПоОстаткамТоваров(Запрос, НомераТаблиц)

	НомераТаблиц.Вставить("ТоварыВТорговыхТочках", НомераТаблиц.Количество()+1);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Дата КАК Период,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка КАК Регистратор,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Организация КАК Организация,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.ЦМО КАК ЦМО,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ИзмененияОстатковТоваровВТорговойТочкеТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ ДвиженияТоваров
	|ИЗ
	|	Документ.АктПриемкиМ7.Материалы КАК ИзмененияОстатковТоваровВТорговойТочкеТовары
	|ГДЕ
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка = &Ссылка
	|	И ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.ПоступлениеТоваровНаСкладТорговойТочки = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Номенклатура,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.ЦМО,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Организация,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ДвиженияТоваров.Период КАК Период,
	|	ДвиженияТоваров.Регистратор КАК Регистратор,
	|	ДвиженияТоваров.Организация КАК Организация,
	|	ДвиженияТоваров.ЦМО КАК ЦМО,
	|	ДвиженияТоваров.Номенклатура КАК Номенклатура,
	|	ДвиженияТоваров.Количество КАК Количество
	|ИЗ
	|	ДвиженияТоваров КАК ДвиженияТоваров";
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("ОтражениеЭДВУчете", НомераТаблиц.Количество()+1);
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ОтражениеЭДВУчете.Ссылка КАК Регистратор,
	|	ОтражениеЭДВУчете.Дата КАК Период,
	|	ОтражениеЭДВУчете.Организация КАК Организация,
	|	ОтражениеЭДВУчете.ДокументОснование КАК ДокументЭД,
	|	ОтражениеЭДВУчете.Ссылка КАК ДокументОтраженияВУчете,
	|	ОтражениеЭДВУчете.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.АктПриемкиМ7 КАК ОтражениеЭДВУчете
	|ГДЕ
	|	ОтражениеЭДВУчете.Ссылка = &Ссылка
	|	И ОтражениеЭДВУчете.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	|	И(НЕ ОтражениеЭДВУчете.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка))";
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктПриемкиМ7";
	КомандаПечати.Идентификатор		= "АктПриемки0504220_103н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о приемке материалов'"), "0504220", "52н", "103н");
	КомандаПечати.Порядок			= 1;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктПриемкиМ7";
	КомандаПечати.Идентификатор		= "АктПриемки0504220_52н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о приемке материалов'"), "0504220", "52н");
	КомандаПечати.Порядок			= 2;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктПриемкиМ7";
	КомандаПечати.Идентификатор		= "АктПриемкиМ7";
	КомандаПечати.Представление		= НСтр("ru = 'Акт о приемке материалов (М-7)'");
	КомандаПечати.Порядок			= 99;

	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОСодержанииДрагМатериалов", 5);
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктПриемкиМ7") Тогда
		//ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;
		ПерваяТаблица 		= Неопределено;
		ВтораяТаблица 		= Неопределено;
		ТретьяТаблица 		= Неопределено;
		ЧетвертаяТаблица	= Неопределено;
		ПечатьАктаПриемкиМ7(МассивОбъектов, ОбъектыПечати, ПерваяТаблица, ВтораяТаблица, ТретьяТаблица, ЧетвертаяТаблица);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,	"АктПриемкиМ7","Акт приемки М-7",ПерваяТаблица);
		//УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,	"АктПриемкиМ7_2","Акт приемки М-7 (стр. 2)",ВтораяТаблица);
		//УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,	"АктПриемкиМ7_3","Акт приемки М-7 (стр. 3)",ТретьяТаблица);
		//УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,	"АктПриемкиМ7_4","Акт приемки М-7 (стр. 4)",ЧетвертаяТаблица);
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктПриемки0504220_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"АктПриемки0504220_103н",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о приемке материалов'"), "0504220", "52н", "103н"),
			ПечатьАктаПриемки0504220(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктПриемки0504220_103н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктПриемки0504220_52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"АктПриемки0504220_52н",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о приемке материалов'"), "0504220", "52н"),
			ПечатьАктаПриемки0504220(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктПриемки0504220"));
		
	КонецЕсли;

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"СправкаОСодержанииДрагМатериалов") Тогда
	
		ТабличныйДокумент = УчетДрагМатериалов.ПечатьСправкиОСодержанииДрагМатериалов(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"СправкаОСодержанииДрагМатериалов","Справка о содержании драг. материалов", ТабличныйДокумент);
			
	КонецЕсли;
	
КонецПроцедуры // Печать

Функция ПечатьАктаПриемки0504220(МассивОбъектов, ОбъектыПечати, ИмяМакета)	
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ИмяПараметровПечати = "ПараметрыПечати__АктПриемки0504220";  
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	АктПриемкиМ7.Ссылка КАК Ссылка,
	               |	АктПриемкиМ7.Номер КАК Номер,
	               |	АктПриемкиМ7.Дата КАК Дата,
	               |	АктПриемкиМ7.Организация КАК Организация,
	               |	ВЫБОР
	               |		КОГДА АктПриемкиМ7.Организация.НаименованиеПолное = """"
	               |			ТОГДА АктПриемкиМ7.Организация.Наименование
	               |		ИНАЧЕ АктПриемкиМ7.Организация.НаименованиеПолное
	               |	КОНЕЦ КАК НаименованиеОрганизация,
	               |	АктПриемкиМ7.Организация.КодОКПО КАК КодОКПО,
	               |	ЕСТЬNULL(АктПриемкиМ7.Организация.ИНН, """") КАК ИНН,
	               |	ВЫБОР
	               |		КОГДА АктПриемкиМ7.Подразделение.НаименованиеПолное = """"
