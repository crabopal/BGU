#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
	
// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти
	
#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоступлениеМЗ.Организация КАК Организация,
		|	ПоступлениеМЗ.ИФО КАК ИФО,
		|	ПоступлениеМЗ.Подразделение КАК Подразделение,
		|	ПоступлениеМЗ.Контрагент КАК Контрагент,
		|	ПоступлениеМЗ.Договор КАК Договор,
		|	ПоступлениеМЗ.Грузоотправитель КАК Грузоотправитель,
		|	ПоступлениеМЗ.Грузополучатель КАК Грузополучатель,
		|	ПоступлениеМЗ.ЦМО КАК ЦМО,
		|	ПоступлениеМЗ.ВидПервичногоДокумента КАК ВидПриложения,
		|	ПоступлениеМЗ.ДатаПервичногоДокумента КАК ДатаДокумента,
		|	ПоступлениеМЗ.НомерПервичногоДокумента КАК НомерДокумента,
		|	&ДанныеЗаполнения КАК ДокументОснование
		|ИЗ
		|	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
		|ГДЕ
		|	ПоступлениеМЗ.Ссылка = &ДанныеЗаполнения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПоступлениеМЗМатериалы.Номенклатура КАК Номенклатура,
		|	ПоступлениеМЗМатериалы.Количество КАК Количество,
		|	ПоступлениеМЗМатериалы.Всего КАК Сумма,
		|	ВЫБОР
		|		КОГДА ПоступлениеМЗМатериалы.Количество <> 0
		|			ТОГДА ПоступлениеМЗМатериалы.Всего / ПоступлениеМЗМатериалы.Количество
		|		ИНАЧЕ ПоступлениеМЗМатериалы.Всего
		|	КОНЕЦ КАК Цена,
		|	0 КАК КоличествоПоДокументам,
		|	0 КАК СуммаПоДокументам,
		|	ВЫБОР
		|		КОГДА ПоступлениеМЗМатериалы.Количество <> 0
		|			ТОГДА ПоступлениеМЗМатериалы.Всего / ПоступлениеМЗМатериалы.Количество
		|		ИНАЧЕ ПоступлениеМЗМатериалы.Всего
		|	КОНЕЦ КАК ЦенаПоДокументам,
		|	ПоступлениеМЗМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ПоступлениеМЗМатериалы.КПС КАК КПС,
		|	ПоступлениеМЗМатериалы.КФО КАК КФО,
		|	ПоступлениеМЗМатериалы.СчетУчета КАК СчетУчета
		|ИЗ
		|	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
		|ГДЕ
		|	ПоступлениеМЗМатериалы.Ссылка = &ДанныеЗаполнения";
		
		Запрос.УстановитьПараметр("ДанныеЗаполнения", ДанныеЗаполнения);
		Выборка = Запрос.ВыполнитьПакет();
		ТабШапка        = Выборка[0].Выбрать();
		ТабНоменклатура = Выборка[1].Выгрузить();
		
		ТабШапка.Следующий();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ТабШапка);
		СоставПриложения.Очистить();
		Если ЗначениеЗаполнено(ТабШапка.ВидПриложения)
			ИЛИ ЗначениеЗаполнено(ТабШапка.ДатаДокумента)
			ИЛИ ЗначениеЗаполнено(ТабШапка.НомерДокумента) Тогда
			ЗаполнитьЗначенияСвойств(СоставПриложения.Добавить(), ТабШапка);
		КонецЕсли;
		
		Материалы.Загрузить(ТабНоменклатура);
		ОсновныеСредства.Очистить();
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
		АктПриемкиСсылка = ЭлектронныеДокументыБГУ.НайтиАктПриемкиПоДокументу(ДанныеЗаполнения);
		Если ЗначениеЗаполнено(АктПриемкиСсылка) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для документа уже введен %1.'"), АктПриемкиСсылка);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "ДокументОснование", "Объект");
		КонецЕсли;	

		Если ЭлектронныеДокументыБГУ.КонтролироватьСоответствиеНаименованияТРУДляДокументовУчетаНаОснованииЭДП(ДанныеЗаполнения.Организация) Тогда
			РазличающаясяНоменклатураКонтрагентаИОрганизации = ЭлектронныеДокументыБГУ.РазличающаясяНоменклатураКонтрагентаИОрганизации(ДанныеЗаполнения);
			Если РазличающаясяНоменклатураКонтрагентаИОрганизации.Количество() > 0 Тогда
				ТекстСообщения = ЭлектронныеДокументыБГУ.ТекстСообщенияОРазличающейсяНоменклатуре(ДанныеЗаполнения, РазличающаясяНоменклатураКонтрагентаИОрганизации);
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
		КонецЕсли;	
		
		ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения);	
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		ЭтотОбъект.ДокументОснование = ДанныеЗаполнения;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = Материалы.Итог("Сумма") + ОсновныеСредства.Итог("Сумма");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	МассивНепроверяемыхРеквизитов = Новый Массив();
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Материалы.КПС");
		МассивНепроверяемыхРеквизитов.Добавить("Материалы.СчетУчета");
		МассивНепроверяемыхРеквизитов.Добавить("Материалы.КФО");
	КонецЕсли;	
	
	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(ЭтотОбъект);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет", Ложь);
	ПараметрыОбработки.Вставить("ДтКт",          "Дт");
	
	Для каждого Строка Из Материалы Цикл
		
		Если Не ЗначениеЗаполнено(Строка.КЭК) Тогда
			ПараметрыОбработки.Номенклатура = Строка.Номенклатура;
			ПараметрыОбработки.Счет         = Строка.СчетУчета;
			
			УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)

	ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА");
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА");
	ОбъектыДМ.Свернуть("ОбъектНФА");
	
	ТаблицаВсехОбъектов = Материалы.Выгрузить(,"Номенклатура");
	
	ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
	ТаблицаОбъектовНФА.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		ОбъектНФА = ТекСтрока.ОбъектНФА;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Номенклатура", ОбъектНФА);
		НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);   

		Если НайденныеСтроки.Количество() = 0 Тогда
			ПараметрыОтбораОбъекта = Новый Структура;
			ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
			СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
			Если СтрокиСпискаДМ.Количество()=1 Тогда
				ТекстСтрокиДМ = "В строке ";
			Иначе
				ТекстСтрокиДМ = "В строках ";
			КонецЕсли;
			Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
				ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
			КонецЦикла;	
			
			ТекстОшибки = НСтр("ru='"+Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2)+" списка ""Содержание драг. материалов"" указана информация по номенклатуре, которой нет в списке ""Материальные запасы"": %1'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ОбъектНФА);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	Для каждого ТекСтрока Из ОбъектыДМ Цикл
		//контроль лом/не лом
		Если (ТекСтрока.МассаДМ > 0)И(ТекСтрока.ЛигатурнаяМасса > 0 ИЛИ ТекСтрока.ЧистаяМасса>0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" следует указать массу в реквизите ""Масса драг. материалов"" или в реквизитах ""Лигатурная масса лома"" и ""Чистая масса в ломе"": ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
		
		//заполнение количества драг. камней
		Если НЕ (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" значение в реквизите ""Количество (шт)"" указывается только для драгоценных камней: ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры	

Процедура ЗаполнитьПоЭлектронномуДокументуПоставщика(ДокументОснование)
	
	ЭтотОбъект.Организация = ДокументОснование.Организация;
	ЭтотОбъект.Дата = ЭлектронныеДокументыБГУ.ДатаВходящегоИзвещенияЭДП(ДокументОснование);
	ЭтотОбъект.ДокументОснование = ДокументОснование.Ссылка;
	ЭтотОбъект.Контрагент = ДокументОснование.Контрагент;
	ЭтотОбъект.Договор = ДокументОснование.Договор;
	Если (ДокументОснование.ТипФорматаЭД = 4) ИЛИ (ДокументОснование.ТипФорматаЭД = 5) Тогда
		ЭтотОбъект.Грузоотправитель = ДокументОснование.Контрагент;
	Иначе
		Если ЗначениеЗаполнено(ДокументОснование.Отправитель) Тогда
			ЭтотОбъект.Грузоотправитель = ДокументОснование.Отправитель;
		Иначе
			ЭтотОбъект.Грузоотправитель = ДокументОснование.Контрагент;
		КонецЕсли;
	КонецЕсли;
	
	Для каждого ТекСтрока Из ДокументОснование.СписокНоменклатуры Цикл
		Если ТипЗнч(ТекСтрока.Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			НоваяСтрока = ЭтотОбъект.ОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.ОсновноеСредство = ТекСтрока.Номенклатура;
			НоваяСтрока.КоличествоПоДокументам = ТекСтрока.Количество;
			НоваяСтрока.ЦенаПоДокументам = ТекСтрока.Цена;
			НоваяСтрока.СуммаПоДокументам = ТекСтрока.Всего;
			НоваяСтрока.Сумма = ТекСтрока.Всего;
		Иначе
			НоваяСтрока = ЭтотОбъект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.КоличествоПоДокументам = ТекСтрока.Количество;
			НоваяСтрока.ЦенаПоДокументам = ТекСтрока.Цена;
			НоваяСтрока.СуммаПоДокументам = ТекСтрока.Всего;
			НоваяСтрока.Сумма = ТекСтрока.Всего;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

#КонецОбласти


#КонецЕсли
