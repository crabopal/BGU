		ТекущиеДанные = Объект.Материалы.НайтиПоИдентификатору(ТекСтр);
		ТекущиеДанные.КПС = ВыбранноеЗначение;
	
	КонецЦикла;

КонецПроцедуры // УстановитьКПСВыделеннымСтрокам()

