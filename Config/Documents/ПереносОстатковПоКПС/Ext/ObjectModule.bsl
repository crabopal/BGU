#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКопировании(ОбъектКопирования)
	ЭтотОбъект.Переводы.Очистить();
	ЭтотОбъект.ПереводАмортизации.Очистить();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ЭтотОбъект.СуммаДокумента = ЭтотОбъект.Переводы.Итог("Сумма")
		+ ЭтотОбъект.Переводы.Итог("СуммаДт")+ ЭтотОбъект.Переводы.Итог("СуммаКт");
	ЭтотОбъект.СчетаПереноса = СтрСоединить(ЭтотОбъект.Счета.Выгрузить().ВыгрузитьКолонку("Счет"), "; ");
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Удалим старые движения
	ОбщегоНазначенияБГУ.УдалитьДвиженияДокумента(ЭтотОбъект.Движения);
	
	СтруктураШапкиДокумента = Новый Структура( "Дата,Организация,ИФО,КФО,КФОНовый,ВидПереносаДанных,"
		+ "ВидОперацииПриИзмененииТипа,Подразделение,ОтборПоПодразделению,ВариантПереноса,"
		+ "ВидМежотчетногоПериода,АвтоматическиОтразитьВГрафикахИсполненияДоговоров");
	ЗаполнитьЗначенияСвойств(СтруктураШапкиДокумента, ЭтотОбъект);

	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(
		Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	ДополнительныеСвойства.Вставить("СтруктураШапкиДокумента",СтруктураШапкиДокумента);
	
	// Инициализация данных документа
	Документы.ПереносОстатковПоКПС.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ИсходящийНДС");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ВходящийНДС");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ВходящийНДСКРаспределению");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ДвиженияБСО");
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров") И АвтоматическиОтразитьВГрафикахИсполненияДоговоров Тогда
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ОплатаОтПокупателейДебиторов");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ОплатаПоставщикамКредиторам");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ИсполнениеДоговоровСПокупателями");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ИсполнениеОбязательствПоставщиками");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ВидПереносаДанных = 1 Тогда
		//Изменение типа учреждения
		Если Счета.Количество() = 1 Тогда
			ЕстьУчетПоКПС = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счета[0].Счет).УчетПоКПС;
			Если НЕ ЕстьУчетПоКПС Тогда
				ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Переводы.НовыйКПС"));
				ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("СоответствиеКПС.СтарыйКПС"));
				ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("СоответствиеКПС.НовыйКПС"));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецЕсли
