Процедура ЗаполнитьГрафикиИсполненияДоговоровПоДаннымУчета(ДокументОбъект) Экспорт
	
	Отказ = Ложь;
	
	ДокументОбъект.ГрафикПлатежей.Очистить();
	ДокументОбъект.ГрафикИсполнения.Очистить();
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров")
		ИЛИ Не ДокументОбъект.АвтоматическиОтразитьВГрафикахИсполненияДоговоров Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	
	// Сформируем и заполним уникальные идентификаторы строк.
	Для Каждого СтрокаПереводы Из ДокументОбъект.Переводы Цикл
		СтрокаПереводы.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Запрос.УстановитьПараметр("КФО", ДокументОбъект.КФО);
