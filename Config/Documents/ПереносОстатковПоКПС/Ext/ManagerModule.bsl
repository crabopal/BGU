	|	ТабЧастьПереводы.Договор.ВидДоговора КАК ВидДоговора,
	|	ЕСТЬNULL(ТабЧастьПереводы.Договор.ВестиГрафикПлатежей, ЛОЖЬ) КАК ВестиГрафикПлатежей,
	|	ЕСТЬNULL(ТабЧастьПереводы.Договор.ВестиПланГрафикИсполнения, ЛОЖЬ) КАК ВестиПланГрафикИсполнения,
	|	ТабЧастьПереводы.Валюта КАК Валюта
	|ИЗ
	|	ТабЧастьПереводы КАК ТабЧастьПереводы
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ПереносОстатковПоСчетамРасчетов = Результат[НомераТаблиц.ПереносОстатковПоСчетамРасчетов].Выгрузить();
	Если ПереносОстатковПоСчетамРасчетов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками = ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками");
	ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями = ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями");
	
	ПереносГрафикПлатежейПокупателиДебиторы = ПереносОстатковПоСчетамРасчетов.СкопироватьКолонки();
	ПереносГрафикПлатежейПокупателиДебиторы.Колонки.Добавить("ВидРасчетов", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыРасчетовПоЗаймам"));
	
	ПереносГрафикПлатежейПоставщикиКредиторы = ПереносОстатковПоСчетамРасчетов.СкопироватьКолонки();
	ПереносГрафикПлатежейПоставщикиКредиторы.Колонки.Добавить("ВидРасчетов", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыРасчетовПоЗаймам"));
	
	ПереносГрафикИсполненияПокупателиДебиторы = ПереносОстатковПоСчетамРасчетов.СкопироватьКолонки();
	ПереносГрафикИсполненияПоставщикиКредиторы = ПереносОстатковПоСчетамРасчетов.СкопироватьКолонки();
	
	АналитикаУжеОбработана = Новый ТаблицаЗначений;
	АналитикаУжеОбработана.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	АналитикаУжеОбработана.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	АналитикаУжеОбработана.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	АналитикаУжеОбработана.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	АналитикаУжеОбработана.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	АналитикаУжеОбработана.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	АналитикаУжеОбработана.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	АналитикаУжеОбработана.Колонки.Добавить("ВидРасчетов",   Новый ОписаниеТипов("ПеречислениеСсылка.ВидыРасчетовПоЗаймам"));
	
	Для Каждого СтрокаДокумента Из ПереносОстатковПоСчетамРасчетов Цикл
		
		// Определим строку табличной части "Переводы".
		СтрокаПереводы = ДокументОбъект.Переводы.Получить(СтрокаДокумента.НомерСтроки - 1);
		Если СтрокаПереводы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетРасчетов, "206.00") Тогда
			СтрокаДокумента.СчетРасчетов = КонтрольИсполненияДоговоров.СчетРасчетовПоСчетуАвансовВыданных(СтрокаДокумента.СчетРасчетов, ДокументОбъект.Дата, ДокументОбъект.Организация);
		КонецЕсли;
		
		Если ТипЗнч(СтрокаДокумента.Субконто3) = Тип("ПеречислениеСсылка.ВидыРасчетовПоЗаймам")
			И ЗначениеЗаполнено(СтрокаДокумента.Субконто3) Тогда
			ВидРасчетов = СтрокаДокумента.Субконто3;
		Иначе // По умолчанию заполняем по виду расчетов "Основной долг". Другие виды расчетов можно выбрать в форме документа.
			ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
		КонецЕсли;
		
		СтрокаПереводы.ВидРасчетов = ВидРасчетов;
		
		Если ГрафикиПоАналитикеПеренесены(СтрокаДокумента, ВидРасчетов, АналитикаУжеОбработана, ДокументОбъект) Тогда
			Продолжить;
		КонецЕсли;
		
		Если БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетРасчетов, "205.00,209.00") Тогда
			
			Если СтрокаДокумента.ВестиГрафикПлатежей Тогда
				НоваяСтрока = ПереносГрафикПлатежейПокупателиДебиторы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
				НоваяСтрока.ВидРасчетов = ВидРасчетов;
			КонецЕсли;
			
			Если СтрокаДокумента.ВестиПланГрафикИсполнения И ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг Тогда
				НоваяСтрока = ПереносГрафикИсполненияПокупателиДебиторы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
			КонецЕсли;
			
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетРасчетов, "302.00") Тогда
			
			Если СтрокаДокумента.ВестиГрафикПлатежей Тогда
				НоваяСтрока = ПереносГрафикПлатежейПоставщикиКредиторы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
				НоваяСтрока.ВидРасчетов = ВидРасчетов;
			КонецЕсли;
			
			Если СтрокаДокумента.ВестиПланГрафикИсполнения И ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг Тогда
				НоваяСтрока = ПереносГрафикИсполненияПоставщикиКредиторы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
			КонецЕсли;
			
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетРасчетов, "207.00") Тогда
			
			Если СтрокаДокумента.ВестиГрафикПлатежей Тогда
				НоваяСтрока = ПереносГрафикПлатежейПокупателиДебиторы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
				НоваяСтрока.ВидРасчетов = ВидРасчетов;
			КонецЕсли;
			
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетРасчетов, "301.00") Тогда
			
			Если СтрокаДокумента.ВестиГрафикПлатежей Тогда
				НоваяСтрока = ПереносГрафикПлатежейПоставщикиКредиторы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
				НоваяСтрока.ВидРасчетов = ВидРасчетов;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	
	НеисполненныеПлатежиОтПокупателейДебиторов = КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(
		ПереносГрафикПлатежейПокупателиДебиторы, ДокументОбъект.Организация);
		
	НеисполненныеПлатежиПоставщикамКредиторам = КонтрольИсполненияДоговоров.НеисполненныеПлатежиПоставщикамКредиторам(
		ПереносГрафикПлатежейПоставщикиКредиторы, ДокументОбъект.Организация);
	
	НеисполненныеДоговораСПокупателями = КонтрольИсполненияДоговоров.НеисполненныеДоговораСПокупателями(
		ПереносГрафикИсполненияПокупателиДебиторы, ДокументОбъект.Организация);
	
	НеисполненныеОбязательстваПоставщиков = КонтрольИсполненияДоговоров.НеисполненныеОбязательстваПоставщиков(
		ПереносГрафикИсполненияПоставщикиКредиторы, ДокументОбъект.Организация);
	
	// График платежей, дебиторы.
	Для Каждого СтрокаДокумента Из ПереносГрафикПлатежейПокупателиДебиторы Цикл
		
		Отбор = Новый Структура("ИФО,КФО,КПС,СчетРасчетов,Контрагент,Договор,Валюта,ВидРасчетов");
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаДокумента);
		
		НеисполненныеПлатежи = НеисполненныеПлатежиОтПокупателейДебиторов.НайтиСтроки(Отбор);
		Для Каждого СтрокаПлатеж Из НеисполненныеПлатежи Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаПлатеж.ОплатитьДо) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.ГрафикПлатежей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлатеж);
			НоваяСтрока.СуммаВВалюте = СтрокаПлатеж.Сумма;
			
			НоваяСтрока.ИдентификаторСтроки = СтрокаДокумента.ИдентификаторСтроки;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// График платежей, кредиторы.
	Для Каждого СтрокаДокумента Из ПереносГрафикПлатежейПоставщикиКредиторы Цикл
		
		Отбор = Новый Структура("ИФО,КФО,КПС,СчетРасчетов,Контрагент,Договор,Валюта,ВидРасчетов");
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаДокумента);
		
		НеисполненныеПлатежи = НеисполненныеПлатежиПоставщикамКредиторам.НайтиСтроки(Отбор);
		Для Каждого СтрокаПлатеж Из НеисполненныеПлатежи Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаПлатеж.ОплатитьДо) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.ГрафикПлатежей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлатеж);
			НоваяСтрока.СуммаВВалюте = СтрокаПлатеж.Сумма;
			
			НоваяСтрока.ИдентификаторСтроки = СтрокаДокумента.ИдентификаторСтроки;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// График исполнения, дебиторы.
	Для Каждого СтрокаДокумента Из ПереносГрафикИсполненияПокупателиДебиторы Цикл
		
		Отбор = Новый Структура("ИФО,КФО,КПС,СчетРасчетов,Контрагент,Договор,Валюта");
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаДокумента);
		
		ОстаткиИсполнение = НеисполненныеДоговораСПокупателями.НайтиСтроки(Отбор);
		Для Каждого СтрокаИсполнение Из ОстаткиИсполнение Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаИсполнение.ИсполнитьДо) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.ГрафикИсполнения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсполнение);
			НоваяСтрока.СуммаВВалюте = СтрокаИсполнение.Сумма;
			
			НоваяСтрока.ИдентификаторСтроки = СтрокаДокумента.ИдентификаторСтроки;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// График исполнения, кредиторы.
	Для Каждого СтрокаДокумента Из ПереносГрафикИсполненияПоставщикиКредиторы Цикл
		
		Отбор = Новый Структура("ИФО,КФО,КПС,СчетРасчетов,Контрагент,Договор,Валюта");
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаДокумента);
		
		ОстаткиИсполнение = НеисполненныеОбязательстваПоставщиков.НайтиСтроки(Отбор);
		Для Каждого СтрокаИсполнение Из ОстаткиИсполнение Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаИсполнение.ИсполнитьДо) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.ГрафикИсполнения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсполнение);
			НоваяСтрока.СуммаВВалюте = СтрокаИсполнение.Сумма;
			
			НоваяСтрока.ИдентификаторСтроки = СтрокаДокумента.ИдентификаторСтроки;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ГрафикиПоАналитикеПеренесены(Аналитика, ВидРасчетов, АналитикаУжеОбработана, ДокументОбъект)
	
	СписокСвойств = "ИФО,КФО,КПС,СчетРасчетов,Контрагент,Договор,Валюта";
	Отбор = Новый Структура(СписокСвойств);
	ЗаполнитьЗначенияСвойств(Отбор, Аналитика, СписокСвойств);
	Отбор.Вставить("ВидРасчетов", ВидРасчетов);
	
	НайденныеСтроки = АналитикаУжеОбработана.НайтиСтроки(Отбор);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат Истина;
	Иначе
		// Запомним обработанную аналитику.
		НоваяСтрока = АналитикаУжеОбработана.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Отбор, СписокСвойств);
		НоваяСтрока.ВидРасчетов = ВидРасчетов;
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПереносОстатковПоКПС.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПереносОстатковПоКПС КАК ПереносОстатковПоКПС
	|ГДЕ
	|	НЕ ПереносОстатковПоКПС.ВидМежотчетногоПериода = ЗНАЧЕНИЕ(Перечисление.ВидыМежотчетногоПериода.ПустаяСсылка)
	|	И ПереносОстатковПоКПС.ФинансовыйГод = &ПустаяДата";	 
	
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.ПереносОстатковПоКПС";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			ПредставлениеОбъекта = Строка(Выборка.Ссылка);
			
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект(); 
			Если НЕ Объект = Неопределено Тогда 
				Объект.Заблокировать(); 
				Объект.ФинансовыйГод = Объект.Дата;
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.ПереносОстатковПоКПС,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
