					Движение.КФО                     = ВыборкаДетальныеЗаписи.КФОНовый;
					Движение.ВидЦенности             = ВыборкаДетальныеЗаписи.ВидЦенности;
					Движение.ОбъектНалогообложения   = ВыборкаДетальныеЗаписи.ОбъектНалогообложения;
					Движение.ПричинаНалогообложения  = ВыборкаДетальныеЗаписи.ПричинаНалогообложения;
					Движение.СтавкаНДС               = ВыборкаДетальныеЗаписи.СтавкаНДС;
					
					Движение.СуммаБезНДС             = ВыборкаДетальныеЗаписи.СуммаБезНДС;
					Движение.СуммаНДС                = ВыборкаДетальныеЗаписи.СуммаНДС;
					
					Движение.СуммаБезНДСВалютная     = ВыборкаДетальныеЗаписи.СуммаБезНДСВалютная;
					Движение.СуммаНДСВалютная        = ВыборкаДетальныеЗаписи.СуммаНДСВалютная;
					
					Движение.СчетКредита             = ВыборкаДетальныеЗаписи.СчетКредита;
					Движение.СчетРасчетов            = ВыборкаДетальныеЗаписи.СчетРасчетов;
					Движение.СчетФактура             = ВыборкаДетальныеЗаписи.СчетФактура;
					Движение.ДокументКорректировки   = ВыборкаДетальныеЗаписи.ДокументКорректировки;
					Движение.МестоРегистрации   	 = ВыборкаДетальныеЗаписи.МестоРегистрации;
					Движение.Сторно			         = ВыборкаДетальныеЗаписи.Сторно;
				КонецЕсли;
				
			КонецЦикла;
			
			ВыборкаДетальныеЗаписи = Результаты[5].Выбрать(); // ИсходящийНДС
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СчетФактура) Тогда
					// Движение в "-" со старым КФО и КПС
					Движение                         = ТаблицаИсходящийНДС.Добавить();
					Движение.ВидДвижения             = ВидДвиженияНакопления.Расход;
					Движение.Период                  = ВыборкаДетальныеЗаписи.Дата;
					
					Движение.Организация             = ВыборкаДетальныеЗаписи.Организация;
					Движение.СчетФактура             = ВыборкаДетальныеЗаписи.СчетФактура;
					Движение.ПричинаНалогообложения  = ВыборкаДетальныеЗаписи.ПричинаНалогообложения;
					Движение.КФО                     = ВыборкаДетальныеЗаписи.КФО;
					Движение.ОбъектНалогообложения   = ВыборкаДетальныеЗаписи.ОбъектНалогообложения;
					Движение.СчетРасчетов            = ВыборкаДетальныеЗаписи.СчетРасчетов;
					Движение.КПССчетРасчетов         = ВыборкаДетальныеЗаписи.КПССчетРасчетов;
					
					Движение.СчетДебета              = ВыборкаДетальныеЗаписи.СчетДебета;
										
					Движение.СтавкаНДС               = ВыборкаДетальныеЗаписи.СтавкаНДС;
					Движение.КОСГУСчетДебета         = ВыборкаДетальныеЗаписи.КОСГУСчетДебета;
					
					Движение.ДокументКорректировки   = ВыборкаДетальныеЗаписи.ДокументКорректировки;
					Движение.МестоРегистрации   	 = ВыборкаДетальныеЗаписи.МестоРегистрации;
					Движение.Сторно			         = ВыборкаДетальныеЗаписи.Сторно;
					
					Движение.СуммаБезНДС             = ВыборкаДетальныеЗаписи.СуммаБезНДС;
					Движение.СуммаНДС                = ВыборкаДетальныеЗаписи.СуммаНДС;
					
					Движение.СуммаБезНДСВалютная     = ВыборкаДетальныеЗаписи.СуммаБезНДСВалютная;
					Движение.СуммаНДСВалютная        = ВыборкаДетальныеЗаписи.СуммаНДСВалютная;
					
					
					// Движение в "+" с новым КФО и КПС
					
					Движение                         = ТаблицаИсходящийНДС.Добавить();
					Движение.ВидДвижения             = ВидДвиженияНакопления.Приход;
					
					Движение.Организация             = ВыборкаДетальныеЗаписи.Организация;
					Движение.СчетФактура             = ВыборкаДетальныеЗаписи.СчетФактура;
					Движение.ПричинаНалогообложения  = ВыборкаДетальныеЗаписи.ПричинаНалогообложения;
					Движение.КФО                     = ВыборкаДетальныеЗаписи.КФОНовый;
					Движение.ОбъектНалогообложения   = ВыборкаДетальныеЗаписи.ОбъектНалогообложения;
					Движение.СчетРасчетов            = ВыборкаДетальныеЗаписи.СчетРасчетов;
					Движение.КПССчетРасчетов         = ВыборкаДетальныеЗаписи.НовыйКПС;
					
					Движение.СчетДебета              = ВыборкаДетальныеЗаписи.СчетДебета;
					
					Движение.СтавкаНДС               = ВыборкаДетальныеЗаписи.СтавкаНДС;
					Движение.КОСГУСчетДебета         = ВыборкаДетальныеЗаписи.КОСГУСчетДебета;
					
					Движение.ДокументКорректировки   = ВыборкаДетальныеЗаписи.ДокументКорректировки;
					Движение.МестоРегистрации   	 = ВыборкаДетальныеЗаписи.МестоРегистрации;
					Движение.Сторно			         = ВыборкаДетальныеЗаписи.Сторно;
					
					Движение.СуммаБезНДС             = ВыборкаДетальныеЗаписи.СуммаБезНДС;
					Движение.СуммаНДС                = ВыборкаДетальныеЗаписи.СуммаНДС;
					
					Движение.СуммаБезНДСВалютная     = ВыборкаДетальныеЗаписи.СуммаБезНДСВалютная;
					Движение.СуммаНДСВалютная        = ВыборкаДетальныеЗаписи.СуммаНДСВалютная;
					
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Если ДокументСсылка.ВидОперацииПриИзмененииТипа = 3 Тогда
			Запрос = Новый Запрос();
			Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
			Запрос.УстановитьПараметр("Организация", Шапка.Организация);
			Запрос.УстановитьПараметр("ДатаНачала", ДатаДокумента-1);
			Запрос.УстановитьПараметр("КФО", Шапка.КФО);
			Запрос.УстановитьПараметр("ИФО", Шапка.ИФО);
			Запрос.УстановитьПараметр("ОтборПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
			Запрос.УстановитьПараметр("ДатаОстатков", Новый Граница(ДатаДокумента,ВидГраницы.Включая));
			Запрос.УстановитьПараметр("ОтборПоПодразделению",
				ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И Шапка.ОтборПоПодразделению);
			Запрос.УстановитьПараметр("Подразделение", Шапка.Подразделение);
			Запрос.УстановитьПараметр("СчетБСО", БухгалтерскийУчет.СписокСчетов("03"));
			Запрос.Текст =	
			"ВЫБРАТЬ
			|	ПереносОстатковПоКПСПереводы.Счет,
			|	ПереносОстатковПоКПСПереводы.Субконто1 КАК Субконто1,
			|	ПереносОстатковПоКПСПереводы.Субконто2 КАК Субконто2,
			|	СУММА(ПереносОстатковПоКПСПереводы.Сумма) КАК Сумма,
			|	СУММА(ВЫБОР
			|			КОГДА ЕПСБУ.Количественный
			|				ТОГДА ПереносОстатковПоКПСПереводы.Количество
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК Количество,
			|	ВЫБОР
			|		КОГДА ИспользоватьУчетПоПодразделениям.Значение
			|				И ЕПСБУ.УчетПоПодразделениям
			|			ТОГДА ПереносОстатковПоКПСПереводы.Подразделение
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
			|	КОНЕЦ КАК Подразделение,
			|	ВЫБОР
			|		КОГДА ИспользоватьВалютныйУчет.Значение
			|				И ЕПСБУ.Валютный
			|			ТОГДА ПереносОстатковПоКПСПереводы.Валюта
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			|	КОНЕЦ КАК Валюта,
			|	ПереносОстатковПоКПСПереводы.НовыйКПС
			|ИЗ
			|	Документ.ПереносОстатковПоКПС.Переводы КАК ПереносОстатковПоКПСПереводы
			|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
			|		ПО ПереносОстатковПоКПСПереводы.Счет = ЕПСБУ.Ссылка,
			|	Константа.ИспользоватьВалютныйУчет КАК ИспользоватьВалютныйУчет,
			|	Константа.ИспользоватьУчетПоПодразделениям КАК ИспользоватьУчетПоПодразделениям
			|ГДЕ
			|	ПереносОстатковПоКПСПереводы.Ссылка = &Ссылка
			|	И ПереносОстатковПоКПСПереводы.Счет В (&СчетБСО)
			|
			|СГРУППИРОВАТЬ ПО
			|	ПереносОстатковПоКПСПереводы.Счет,
			|	ВЫБОР
			|		КОГДА ИспользоватьВалютныйУчет.Значение
			|				И ЕПСБУ.Валютный
			|			ТОГДА ПереносОстатковПоКПСПереводы.Валюта
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА ИспользоватьУчетПоПодразделениям.Значение
			|				И ЕПСБУ.УчетПоПодразделениям
			|			ТОГДА ПереносОстатковПоКПСПереводы.Подразделение
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
			|	КОНЕЦ,
			|	ПереносОстатковПоКПСПереводы.Субконто1,
			|	ПереносОстатковПоКПСПереводы.Субконто2,
			|	ПереносОстатковПоКПСПереводы.НовыйКПС";
			
			Результат = Запрос.Выполнить();
			ТабДок = Результат.Выгрузить();
			
			ТабДок.Сортировать("Субконто2");
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Организация", Шапка.Организация);
			СтруктураПараметров.Вставить("КФО", Шапка.КФО);			
			СтруктураПараметров.Вставить("ИФО", Шапка.ИФО);
			СтруктураПараметров.Вставить("КФОНовый", Шапка.КФОНовый);
			СтруктураПараметров.Вставить("Дата", ДатаДокумента);
			
			ТекЦМО = Справочники.ЦМО.ПустаяСсылка();
			ТекСчетУчета = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
			ТекПодразделение = Справочники.Подразделения.ПустаяСсылка();
			ПерваяСтрока = Истина;
			МассивБСО   = Новый Массив;
			
			УчитыватьПодразделение = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
										И БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(
											БухгалтерскийУчет.СчетПоКоду("03.1", ДатаДокумента, Шапка.Организация))
											.УчетПоПодразделениям;
			
			Для Каждого ТекСтрока Из ТабДок Цикл
				Если ((ТекСтрока.Субконто2 <> ТекЦМО) 
					ИЛИ (ТекСтрока.Подразделение <> ТекПодразделение И УчитыватьПодразделение)
					ИЛИ (ТекСчетУчета <> ТекСтрока.Счет)) 
					И НЕ ПерваяСтрока Тогда
					
					СтруктураПараметров.Вставить("Подразделение", ТекПодразделение);
					СтруктураПараметров.Вставить("ЦМО", ТекЦМО);
					СтруктураПараметров.Вставить("СчетУчета", ТекСчетУчета);
					
					ДеревоОстатков = УправлениеМатериальнымиЗапасами.СформироватьДеревоОстатковБСО(ДатаДокумента+1, СтруктураПараметров,МассивБСО);
					СформируемДвижения(ДеревоОстатков,СтруктураПараметров,ТаблицаБСО,УчитыватьПодразделение);
					МассивБСО   = Новый Массив;
				КонецЕсли;
				ТекЦМО = ТекСтрока.Субконто2;
				ТекПодразделение = ТекСтрока.Подразделение;
				ТекСчетУчета = ТекСтрока.Счет;
				ПерваяСтрока    = Ложь;
				МассивБСО.Добавить(ТекСтрока.Субконто1);
			КонецЦикла;
			Если МассивБСО.Количество()>0 Тогда
				СтруктураПараметров.Вставить("ЦМО", ТекЦМО);
				СтруктураПараметров.Вставить("Подразделение", ТекПодразделение);
				СтруктураПараметров.Вставить("СчетУчета", ТекСчетУчета);
				ДеревоОстатков = УправлениеМатериальнымиЗапасами.СформироватьДеревоОстатковБСО(ДатаДокумента+1, СтруктураПараметров,МассивБСО);
				СформируемДвижения(ДеревоОстатков,СтруктураПараметров,ТаблицаБСО,УчитыватьПодразделение);
			КонецЕсли;
			
			
		КонецЕсли;
	КонецЕсли;
	
	ТаблицыДляДвижений.Вставить("ДвиженияБСО",		ТаблицаБСО);
	ТаблицыДляДвижений.Вставить("ИсходящийНДС",		ТаблицаИсходящийНДС);
	ТаблицыДляДвижений.Вставить("ВходящийНДСКРаспределению",	ТаблицаВходящийКРаспределению);
	ТаблицыДляДвижений.Вставить("ВходящийНДС",		ТаблицаВходящий);
	
	ДобавитьДвиженияКонтрольИсполненияДоговоров(ТаблицыДляДвижений, ДокументСсылка, Шапка);
	
КонецПроцедуры

Процедура СформируемДвижения(ДеревоОстатков, СтруктураШапкиДокумента, ТаблицаБСО, УчитыватьПодразделение)
	
	Организация     = СтруктураШапкиДокумента.Организация;
	ТекИФО	        = СтруктураШапкиДокумента.ИФО;
	ТекКФО          = СтруктураШапкиДокумента.КФО;
	ТекДата         = СтруктураШапкиДокумента.Дата;
	НовыйКФО        = СтруктураШапкиДокумента.КФОНовый;
	ТекЦМО          = СтруктураШапкиДокумента.ЦМО;
	ТекПодразделение = СтруктураШапкиДокумента.Подразделение;
	СчетУчета		= СтруктураШапкиДокумента.СчетУчета;
	
	Для Каждого СтрокаВидаБСО Из ДеревоОстатков.Строки Цикл
		ТекДлинаНомера = СтрокаВидаБСО.ДлинаНомера;
		
		ЕстьСтрокаВидаБСО = Ложь;
		Для Каждого СтрокаСерииБСО Из СтрокаВидаБСО.Строки Цикл
			ТаблицаОстатковНомеров = СтрокаСерииБСО.ОстаткиНомеров;
			
			Для Каждого СтрокаНомеровБСО Из ТаблицаОстатковНомеров Цикл
				ТекНомерНачальный = СтрокаНомеровБСО.НомерНачальный;
				ТекНомерКонечный  = СтрокаНомеровБСО.НомерКонечный;
				Если ТекНомерНачальный = 0 И ТекНомерКонечный = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Движение                    = ТаблицаБСО.Добавить();
				Движение.ВидДвижения        = ВидДвиженияНакопления.Расход;
				Движение.Период             = ТекДата;
				Движение.Организация        = Организация;
				Движение.КФО                = ТекКФО;
				Движение.ИФО	            = ТекИФО;
				Движение.ЦМО                = ТекЦМО;
				Движение.СчетУчета			= СчетУчета;
				Если УчитыватьПодразделение Тогда 
					Движение.Подразделение  = ТекПодразделение;
				КонецЕсли;
				Движение.БСО                = СтрокаВидаБСО.БСО;
				Движение.СерияБСО           = СтрокаСерииБСО.СерияБСО;
				Движение.Количество         = СтрокаНомеровБСО.Количество;
				Движение.НомерНачальный     = СтрокаНомеровБСО.НомерНачальный;
				Движение.НомерКонечный      = СтрокаНомеровБСО.НомерКонечный;
					
				Движение                    = ТаблицаБСО.Добавить();
				Движение.ВидДвижения        = ВидДвиженияНакопления.Приход;
				Движение.Период             = ТекДата;
				Движение.Организация        = Организация;
				Движение.КФО                = НовыйКФО;
				Движение.ИФО             	= ТекИФО;
				Движение.ЦМО                = ТекЦМО;
				Движение.СчетУчета			= СчетУчета;
				Если УчитыватьПодразделение Тогда 
					Движение.Подразделение  = ТекПодразделение;
				КонецЕсли;
				Движение.БСО                = СтрокаВидаБСО.БСО;
				Движение.СерияБСО           = СтрокаСерииБСО.СерияБСО;
				Движение.Количество         = СтрокаНомеровБСО.Количество;
				Движение.НомерНачальный     = СтрокаНомеровБСО.НомерНачальный;
				Движение.НомерКонечный      = СтрокаНомеровБСО.НомерКонечный;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция СоздатьТаблицуРН(Входящий = Ложь)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ВидДвижения");
	Таблица.Колонки.Добавить("Период");
	
