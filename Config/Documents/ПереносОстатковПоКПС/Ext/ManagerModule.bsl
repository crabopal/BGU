#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Шапка = СтруктураДополнительныеСвойства.СтруктураШапкиДокумента;
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	ТаблицаИсходящийНДС = СоздатьТаблицуРН();
	ТаблицаВходящийКРаспределению = СоздатьТаблицуРН(Истина);
	ТаблицаВходящий = СоздатьТаблицуРН(Истина);
	
	ТаблицаБСО = Новый ТаблицаЗначений;
	ТаблицаБСО.Колонки.Добавить("ВидДвижения");
	ТаблицаБСО.Колонки.Добавить("Период");
	
	ТаблицаБСО.Колонки.Добавить("Организация");
	ТаблицаБСО.Колонки.Добавить("ЦМО");
	ТаблицаБСО.Колонки.Добавить("ИФО");
	ТаблицаБСО.Колонки.Добавить("КФО");
	ТаблицаБСО.Колонки.Добавить("СчетУчета");
	ТаблицаБСО.Колонки.Добавить("Подразделение");
	ТаблицаБСО.Колонки.Добавить("БСО");
	ТаблицаБСО.Колонки.Добавить("СерияБСО");
	ТаблицаБСО.Колонки.Добавить("Количество");
	ТаблицаБСО.Колонки.Добавить("НомерНачальный");
	ТаблицаБСО.Колонки.Добавить("НомерКонечный");
	
	ДатаДокумента = Шапка.Дата;
	
	Если ДокументСсылка.ВидПереносаДанных = 0 Тогда
		
		//Перенос остатков по КПС
		ЗапросРегистр = Новый Запрос;
		
		ЗапросРегистр.УстановитьПараметр("Ссылка"		, ДокументСсылка);
		ЗапросРегистр.УстановитьПараметр("Организация"	, Шапка.Организация);
		ЗапросРегистр.УстановитьПараметр("ДатаНачала"	, ДатаДокумента-1);
		ЗапросРегистр.УстановитьПараметр("КФО"			, Шапка.КФО);
		ЗапросРегистр.УстановитьПараметр("ИФО"			, Шапка.ИФО);
		ЗапросРегистр.УстановитьПараметр("ОтборПоИФО"	, ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
		ЗапросРегистр.УстановитьПараметр("ДатаОстатков"	, Новый Граница(ДатаДокумента,ВидГраницы.Включая));
		
		ЗапросРегистр.УстановитьПараметр("ДатаОстатковРБ", БухгалтерскийУчет.КонецПериодаСУточнением(ДатаДокумента, Шапка.ВидМежотчетногоПериода)); 
		
		ЗапросРегистр.УстановитьПараметр("ОтборПоПодразделению",
			ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ДокументСсылка.ОтборПоПодразделению);
		ЗапросРегистр.УстановитьПараметр("Подразделение", Шапка.Подразделение);
		
		ЗапросРегистр.Текст =
		"ВЫБРАТЬ
		|	ПереносОстатковПоКПСПереводы.Счет,
		|	ВЫБОР
		|		КОГДА ПереносОстатковПоКПСПереводы.Субконто1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ПереносОстатковПоКПСПереводы.Субконто1
		|	КОНЕЦ КАК Субконто1,
		|	ВЫБОР
		|		КОГДА ПереносОстатковПоКПСПереводы.Субконто2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ПереносОстатковПоКПСПереводы.Субконто2
		|	КОНЕЦ КАК Субконто2,
		|	ВЫБОР
		|		КОГДА ПереносОстатковПоКПСПереводы.Субконто3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ПереносОстатковПоКПСПереводы.Субконто3
		|	КОНЕЦ КАК Субконто3,
		|	ПереносОстатковПоКПСПереводы.СтарыйКПС,
		|	СУММА(ПереносОстатковПоКПСПереводы.Сумма) КАК Сумма,
		|	СУММА(ВЫБОР
		|			КОГДА ИспользоватьВалютныйУчет.Значение
		|					И ЕПСБУ.Валютный
		|				ТОГДА ПереносОстатковПоКПСПереводы.ВалютнаяСумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ВалютнаяСумма,
		|	СУММА(ВЫБОР
		|			КОГДА ЕПСБУ.Количественный
		|				ТОГДА ПереносОстатковПоКПСПереводы.Количество
		|			ИНАЧЕ 0
