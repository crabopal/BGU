#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПроцедурыИФункцииПечати

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПереносОстатковПоКПС";
	КомандаПечати.Идентификатор		= "ПротоколИзменений";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость переноса остатков'");
	КомандаПечати.Порядок			= 1;
	КомандаПечати.ПроверкаПроведенияПередПечатью 	= Истина;
	КомандаПечати.СписокФорм		= "ФормаСписка,ФормаВыбора,ПереносКПС";
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПротоколИзменений") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПротоколИзменений","Ведомость переноса остатков",
			ПечатьВедомости(МассивОбъектов, ОбъектыПечати, ПараметрыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)

	ВидПереносаДанных = Неопределено;

	Если Параметры.Свойство("Ключ") Тогда
		ВидПереносаДанных = Параметры["Ключ"]["ВидПереносаДанных"];
		
	ИначеЕсли Параметры.Свойство("ЗначенияЗаполнения") Тогда
		Параметры["ЗначенияЗаполнения"].Свойство("ВидПереносаДанных", ВидПереносаДанных);
		
	ИначеЕсли Параметры.Свойство("ЗначениеКопирования") Тогда
		ВидПереносаДанных = Параметры["ЗначениеКопирования"]["ВидПереносаДанных"];
		
	КонецЕсли;

	Если ВидПереносаДанных<>Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		
		СоответствиеФорм = ПолучитьСоответствиеВидовПереносаПоФормам();
		ВыбраннаяФорма = СоответствиеФорм[ВидПереносаДанных];
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПечатьДокумента

Функция ПечатьВедомости(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ПереносОстатковПоКПС";

	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПереносОстатковПоКПС.ПротоколИзменений");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(ПереносОстатковПоКПСПереводы.Субконто1),
	|	ПРЕДСТАВЛЕНИЕ(ПереносОстатковПоКПСПереводы.Субконто2),
	|	ПРЕДСТАВЛЕНИЕ(ПереносОстатковПоКПСПереводы.Субконто3),
	|	ПереносОстатковПоКПСПереводы.Сумма,
	|	ПереносОстатковПоКПСПереводы.Валюта.Представление,
	|	ПереносОстатковПоКПСПереводы.ВалютнаяСумма,
	|	ПереносОстатковПоКПСПереводы.Количество,
	|	ПереносОстатковПоКПСПереводы.СтарыйКПС.Представление,
	|	ПереносОстатковПоКПСПереводы.НовыйКПС.Представление,
	|	ПереносОстатковПоКПСПереводы.Ссылка КАК Ссылка,
	|	ПереносОстатковПоКПСПереводы.Ссылка.ИФО,
	|	ПереносОстатковПоКПСПереводы.Ссылка.КФО,
	|	ПереносОстатковПоКПСПереводы.Ссылка.Организация,
	|	ПереносОстатковПоКПСПереводы.Ссылка.Дата,
	|	ПереносОстатковПоКПСПереводы.Счет КАК Счет,
	|	ПереносОстатковПоКПСПереводы.Подразделение
	|ИЗ
	|	Документ.ПереносОстатковПоКПС.Переводы КАК ПереносОстатковПоКПСПереводы
	|ГДЕ
	|	ПереносОстатковПоКПСПереводы.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	Счет,
	|	ПереносОстатковПоКПСПереводы.СтарыйКПС,
	|	ПереносОстатковПоКПСПереводы.НовыйКПС,
	|	ПереносОстатковПоКПСПереводы.Субконто1,
	|	ПереносОстатковПоКПСПереводы.Субконто2,
	|	ПереносОстатковПоКПСПереводы.Субконто3,
	|	ПереносОстатковПоКПСПереводы.Валюта
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПереносОстатковПоКПССчета.Счет,
	|	ПереносОстатковПоКПССчета.Счет.Код,
	|	ПереносОстатковПоКПССчета.Счет.Валютный КАК Валютный,
	|	ПереносОстатковПоКПССчета.Счет.Количественный КАК Количественный,
	|	ПереносОстатковПоКПССчета.Ссылка КАК Ссылка,
	|	ПереносОстатковПоКПССчета.Счет.УчетПоПодразделениям
	|		И ИспользоватьУчетПоПодразделениям.Значение КАК ПоПодразделениям
	|ИЗ
	|	Документ.ПереносОстатковПоКПС.Счета КАК ПереносОстатковПоКПССчета,
	|	Константа.ИспользоватьУчетПоПодразделениям КАК ИспользоватьУчетПоПодразделениям
	|ГДЕ
	|	ПереносОстатковПоКПССчета.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка");
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Результаты = Запрос.ВыполнитьПакет();

	ВыборкаШапка = Результаты[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТаблицаСчетов = Результаты[1].Выгрузить();
	УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		обШапка 					= Макет.ПолучитьОбласть("Шапка");
		обЗаголовокТаблицыЛевый 	= Макет.ПолучитьОбласть("ЗаголовокТаблицыЛевый");
		обЗаголовокТаблицыПравый 	= Макет.ПолучитьОбласть("ЗаголовокТаблицыПравый");
		обЗаголовокТаблицыСтарыйКПС = Макет.ПолучитьОбласть("ЗаголовокТаблицыСтарыйКПС");
		обИтого 					= Макет.ПолучитьОбласть("Итого");
		
		СтруктураПараметровШапки = Новый Структура("Организация,КФО,ИФО,Заголовок");
		СтруктураПараметровШапки.Заголовок 	= Нстр("ru='Ведомость переноса остатков по бюджетной классификации от " +
		Формат(ВыборкаШапка.Дата, "ДФ=dd.MM.yyyy")+"'");
		СтруктураПараметровШапки.Организация = Строка(ВыборкаШапка.Организация);
		СтруктураПараметровШапки.ИФО 		= Строка(ВыборкаШапка.ИФО);
		СтруктураПараметровШапки.КФО		= Строка(ВыборкаШапка.КФО);
		
		обШапка.Параметры.Заполнить(СтруктураПараметровШапки);
		
		ТабличныйДокумент.Вывести(обШапка);
		
		Если УчетПоИФО Тогда
			ОбИФО 					= Макет.ПолучитьОбласть("ИФО");
			ОбИФО.Параметры.Заполнить(СтруктураПараметровШапки);
			ТабличныйДокумент.Вывести(ОбИФО);
		КонецЕсли;
		
		ЧислоКолонокВалютный = 0;
		СтрокиВал = ТаблицаСчетов.НайтиСтроки(Новый Структура("Ссылка,Валютный",ВыборкаШапка.Ссылка,Истина));
		Если СтрокиВал.Количество() > 0 Тогда
			ЧислоКолонокВалютный = 2;
			обЗаголовокТаблицыВалютный = Макет.ПолучитьОбласть("ЗаголовокТаблицыВалютный");
		КонецЕсли;
		
		ЧислоКолонокКоличественный = 0;
		СтрокиКол = ТаблицаСчетов.НайтиСтроки(Новый Структура("Ссылка,Количественный",ВыборкаШапка.Ссылка,Истина));
		Если СтрокиКол.Количество() > 0 Тогда
			ЧислоКолонокКоличественный = 1;
			обЗаголовокТаблицыКоличественный = Макет.ПолучитьОбласть("ЗаголовокТаблицыКоличественный");
		КонецЕсли;
		
		ЧислоКолонокПоПодразделениям = 0;
		СтрокиПодр = ТаблицаСчетов.НайтиСтроки(Новый Структура("Ссылка,ПоПодразделениям",ВыборкаШапка.Ссылка,Истина));
		Если СтрокиПодр.Количество() > 0 Тогда
			ЧислоКолонокПоПодразделениям = 1;
			обЗаголовокТаблицыПодразделение = Макет.ПолучитьОбласть("ЗаголовокТаблицыПодразделение");
		КонецЕсли;

		
		ТабличныйДокумент.Вывести(обЗаголовокТаблицыЛевый);
	
		Если ЧислоКолонокВалютный>0 Тогда
			ТабличныйДокумент.Присоединить(обЗаголовокТаблицыВалютный);
		КонецЕсли;
	
		Если ЧислоКолонокКоличественный>0 Тогда
			СтруктураПараметровобЗаголовокТаблицыКоличественный = Новый Структура("НомерКолонкиКоличество",6 + ЧислоКолонокВалютный);
			обЗаголовокТаблицыКоличественный.Параметры.Заполнить(СтруктураПараметровобЗаголовокТаблицыКоличественный);
			ТабличныйДокумент.Присоединить(обЗаголовокТаблицыКоличественный);
		КонецЕсли;
		
		Если ЧислоКолонокПоПодразделениям>0 Тогда
			СтруктураПараметровобЗаголовокТаблицыПодразделение = Новый Структура("НомерКолонкиПодразделение",6 + ЧислоКолонокВалютный + ЧислоКолонокКоличественный);
			обЗаголовокТаблицыПодразделение.Параметры.Заполнить(СтруктураПараметровобЗаголовокТаблицыПодразделение);
			ТабличныйДокумент.Присоединить(обЗаголовокТаблицыПодразделение);
		КонецЕсли;
		
		СтруктураПараметровобЗаголовокТаблицыСтарыйКПС = Новый Структура("НомерКолонкиСтарыйКПС",6 + ЧислоКолонокВалютный + ЧислоКолонокКоличественный + ЧислоКолонокПоПодразделениям);
		обЗаголовокТаблицыСтарыйКПС.Параметры.Заполнить(СтруктураПараметровобЗаголовокТаблицыСтарыйКПС);
		ТабличныйДокумент.Присоединить(обЗаголовокТаблицыСтарыйКПС);
		
		СтруктураПараметровобЗаголовокТаблицыПравый = Новый Структура("НомерКолонкиНовыйКПС",6 + ЧислоКолонокВалютный + ЧислоКолонокКоличественный + ЧислоКолонокПоПодразделениям +1);
		обЗаголовокТаблицыПравый.Параметры.Заполнить(СтруктураПараметровобЗаголовокТаблицыПравый);

		ТабличныйДокумент.Присоединить(обЗаголовокТаблицыПравый);
		
		СуммаИтого = 0;
		ВыборкаДетальная = ВыборкаШапка.Выбрать();
		Пока ВыборкаДетальная.Следующий() Цикл
			
			СтруктураПараметровСтроки = Новый Структура("Субконто1,Субконто2,Субконто3,Счет,Сумма,ВалютнаяСумма,"
				+ "Валюта,Количество,СтарыйКПС,НовыйКПС,Подразделение");
			СтруктураПараметровСтроки.Счет                          = ВыборкаДетальная.Счет;
			СтруктураПараметровСтроки.Субконто1 					= ВыборкаДетальная.Субконто1Представление;
			СтруктураПараметровСтроки.Субконто2 					= ВыборкаДетальная.Субконто2Представление;
			СтруктураПараметровСтроки.Субконто3 					= ВыборкаДетальная.Субконто3Представление;
			СтруктураПараметровСтроки.Сумма 						= ВыборкаДетальная.Сумма;
			
			обСтрокаЛевый 											= Макет.ПолучитьОбласть("СтрокаЛевый");
			обСтрокаЛевый.Параметры.Заполнить(СтруктураПараметровСтроки);
			
			ТабличныйДокумент.Вывести(обСтрокаЛевый);
			
			Если ЧислоКолонокВалютный>0 Тогда
				обСтрокаВалютный = Макет.ПолучитьОбласть("СтрокаВалютный");
				
				СтруктураПараметровСтроки.Валюта 					= ВыборкаДетальная.ВалютаПредставление;
				СтруктураПараметровСтроки.ВалютнаяСумма 			= ВыборкаДетальная.ВалютнаяСумма;
				обСтрокаВалютный.Параметры.Заполнить(СтруктураПараметровСтроки);
				
				ТабличныйДокумент.Присоединить(обСтрокаВалютный);
			КонецЕсли;
			
			Если ЧислоКолонокКоличественный>0 Тогда
				обСтрокаКоличественный = Макет.ПолучитьОбласть("СтрокаКоличественный");
				
				СтруктураПараметровСтроки.Количество 		= ВыборкаДетальная.Количество;
				обСтрокаКоличественный.Параметры.Заполнить(СтруктураПараметровСтроки);
				
				ТабличныйДокумент.Присоединить(обСтрокаКоличественный);
			КонецЕсли;
			
			Если ЧислоКолонокПоПодразделениям>0 Тогда
				обСтрокаПодразделение = Макет.ПолучитьОбласть("СтрокаПодразделение");
				
				СтруктураПараметровСтроки.Подразделение 		= ВыборкаДетальная.Подразделение;
				обСтрокаПодразделение.Параметры.Заполнить(СтруктураПараметровСтроки);
				
				ТабличныйДокумент.Присоединить(обСтрокаПодразделение);
			КонецЕсли;
			
			обСтарыйКПС = Макет.ПолучитьОбласть("СтрокаСтарыйКПС");
			СтруктураПараметровСтроки.СтарыйКПС = ВыборкаДетальная.СтарыйКПСПредставление;
			обСтарыйКПС.Параметры.Заполнить(СтруктураПараметровСтроки);
			
			ТабличныйДокумент.Присоединить(обСтарыйКПС);
			
			обСтрокаПравый 					    = Макет.ПолучитьОбласть("СтрокаПравый");
			
			СтруктураПараметровСтроки.НовыйКПС  = ВыборкаДетальная.НовыйКПСПредставление;
			
			обСтрокаПравый.Параметры.Заполнить(СтруктураПараметровСтроки);
			ТабличныйДокумент.Присоединить(обСтрокаПравый);
			
			СуммаИтого = СуммаИтого + ВыборкаДетальная.Сумма;
			
		КонецЦикла;
		СтруктураИтого = Новый Структура("ИтогоСумма",СуммаИтого);
		обИтого.Параметры.Заполнить(СтруктураИтого);
		ТабличныйДокумент.Вывести(обИтого);	
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
		
	Возврат ТабличныйДокумент;
		
КонецФункции

Функция ПолучитьСоответствиеВидовПереносаПоФормам()

	СоответствиеРазделыУчета = Новый Соответствие;
	СоответствиеРазделыУчета.Вставить(0,	"ПереносКПС");
	СоответствиеРазделыУчета.Вставить(1,	"ПереносКФОКПС");

	Возврат СоответствиеРазделыУчета;

КонецФункции

