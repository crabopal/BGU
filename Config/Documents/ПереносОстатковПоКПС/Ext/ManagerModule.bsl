		|				И Организация = &Организация) КАК ВходящийНДСКРаспределениюОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СоединенныеТаблицы КАК СоединенныеТаблицы
		|		ПО ВходящийНДСКРаспределениюОстатки.СчетРасчетов = СоединенныеТаблицы.Счет
		|			И ВходящийНДСКРаспределениюОстатки.КПССчетРасчетов = СоединенныеТаблицы.СтарыйКПС
		|			И ВходящийНДСКРаспределениюОстатки.СчетФактура.Контрагент = СоединенныеТаблицы.Субконто1
		|			И ВходящийНДСКРаспределениюОстатки.СчетФактура.Договор = СоединенныеТаблицы.Субконто2
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетФактура,
		|	ПричинаНалогообложения,
		|	КФО,
		|	ОбъектНалогообложения,
		|	СчетРасчетов,
		|	КПССчетРасчетов,
		|	СтавкаНДС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВходящийНДСОстатки.Организация,
		|	ВходящийНДСОстатки.СчетФактура КАК СчетФактура,
		|	ВходящийНДСОстатки.ПричинаНалогообложения КАК ПричинаНалогообложения,
		|	ВходящийНДСОстатки.КФО КАК КФО,
		|	ВходящийНДСОстатки.ОбъектНалогообложения КАК ОбъектНалогообложения,
		|	ВходящийНДСОстатки.СчетРасчетов КАК СчетРасчетов,
		|	ВходящийНДСОстатки.КПССчетРасчетов КАК КПССчетРасчетов,
		|	ВходящийНДСОстатки.СтавкаНДС КАК СтавкаНДС,
		|	ВходящийНДСОстатки.ДокументКорректировки,
		|	ВходящийНДСОстатки.МестоРегистрации,
		|	ВходящийНДСОстатки.Сторно,
		|	ВходящийНДСОстатки.СуммаБезНДСОстаток,
		|	ВходящийНДСОстатки.СуммаНДСОстаток,
		|	ВходящийНДСОстатки.СуммаБезНДСВалютнаяОстаток,
		|	ВходящийНДСОстатки.СуммаНДСВалютнаяОстаток,
		|	СоединенныеТаблицы.НовыйКПС,
		|	ЕстьNULL(СоединенныеТаблицы.Сумма, 0) КАК Сумма,
		|	ЕстьNULL(СоединенныеТаблицы.СуммаОст, 0) КАК СуммаОст,
		|	ЕстьNULL(СоединенныеТаблицы.ВалютнаяСумма, 0) КАК ВалютнаяСумма,
		|	ЕстьNULL(СоединенныеТаблицы.СуммаОстВалютный, 0) КАК СуммаОстВалютный,
		|	СоединенныеТаблицы.Субконто1 КАК Контрагент,
		|	СоединенныеТаблицы.Субконто2 КАК СФ,
		|	ВходящийНДСОстатки.ВидЦенности,
		|	ВходящийНДСОстатки.СчетКредита
		|ИЗ
		|	РегистрНакопления.ВходящийНДС.Остатки(
		|			&ДатаОстатков,
		|			СчетРасчетов В
		|					(ВЫБРАТЬ
		|						ДанныеДок.Счет
		|					ИЗ
		|						ДанныеДок КАК ДанныеДок)
		|				И КПССчетРасчетов В
		|					(ВЫБРАТЬ
		|						ДанныеДок.СтарыйКПС
		|					ИЗ
		|						ДанныеДок КАК ДанныеДок)
		|				И КФО = &КФО
		|				И Организация = &Организация) КАК ВходящийНДСОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СоединенныеТаблицы КАК СоединенныеТаблицы
		|		ПО ВходящийНДСОстатки.СчетРасчетов = СоединенныеТаблицы.Счет
		|			И ВходящийНДСОстатки.КПССчетРасчетов = СоединенныеТаблицы.СтарыйКПС
		|			И ВходящийНДСОстатки.СчетФактура.Контрагент = СоединенныеТаблицы.Субконто1
		|			И ВходящийНДСОстатки.СчетФактура.Договор = СоединенныеТаблицы.Субконто2
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетФактура,
		|	ПричинаНалогообложения,
		|	КФО,
		|	ОбъектНалогообложения,
		|	СчетРасчетов,
		|	КПССчетРасчетов,
		|	СтавкаНДС";
		                                        //7 - исходящий
												//8 - входящий к распределению
												//9 - входящий
		Результаты = ЗапросРегистр.ВыполнитьПакет();
		
		ВыборкаРегистр = Результаты[7].Выбрать();
		
		// Движение по регистру накопления остатков
		
		ТекКонтрагентРН                 = Неопределено;
		ТекДоговорРН                    = Неопределено;
		ТекСчетФактураРН                = Неопределено;
		ТекПричинаНалогообложенияРН     = Неопределено;
		ТекСтавкаНДСРН                  = Неопределено;
		ТекСчетДебетаРН                 = Неопределено;
		ТекКОСГУСчетДебетаРН            = Неопределено;
		ДокументКорректировкиРН         = Неопределено;
		МестоРегистрацииРН        		= Неопределено;
		СторноРН        				= Неопределено;
		ТекОбъектНалогообложенияРН      = Неопределено;
		
		ТекСчетРасчетовРН        		= Неопределено;
		ТекКПССчетРасчетовРН      		= Неопределено;
		
		Пока ВыборкаРегистр.Следующий() Цикл
			
			Если ((ТекКонтрагентРН 				<> ВыборкаРегистр.Контрагент) Или
				(ТекДоговорРН 					<> ВыборкаРегистр.Договор) Или
				(ТекСчетФактураРН 				<> ВыборкаРегистр.СчетФактура) Или
				(ТекПричинаНалогообложенияРН 	<> ВыборкаРегистр.ПричинаНалогообложения) Или
				(ТекСтавкаНДСРН 				<> ВыборкаРегистр.СтавкаНДС) Или
				(ТекСчетДебетаРН 				<> ВыборкаРегистр.СчетДебета) Или
				(ТекКОСГУСчетДебетаРН 			<> ВыборкаРегистр.КОСГУСчетДебета) Или
				(ДокументКорректировкиРН 		<> ВыборкаРегистр.ДокументКорректировки) Или
				(МестоРегистрацииРН 			<> ВыборкаРегистр.МестоРегистрации) Или
				(СторноРН 						<> ВыборкаРегистр.Сторно) Или
				(ТекОбъектНалогообложенияРН 	<> ВыборкаРегистр.ОбъектНалогообложения) ИЛИ
				(ТекСчетРасчетовРН 				<> ВыборкаРегистр.СчетРасчетов) ИЛИ
				(ТекКПССчетРасчетовРН 			<> ВыборкаРегистр.КПССчетРасчетов)) Тогда	
				
				ТекКонтрагентРН             = ВыборкаРегистр.Контрагент;
				ТекДоговорРН                = ВыборкаРегистр.Договор;
				ТекСчетФактураРН            = ВыборкаРегистр.СчетФактура;
				ТекПричинаНалогообложенияРН = ВыборкаРегистр.ПричинаНалогообложения;
				ТекСтавкаНДСРН              = ВыборкаРегистр.СтавкаНДС;
				ТекСчетДебетаРН             = ВыборкаРегистр.СчетДебета;
				ТекКОСГУСчетДебетаРН        = ВыборкаРегистр.КОСГУСчетДебета;
				ДокументКорректировкиРН     = ВыборкаРегистр.ДокументКорректировки;
				МестоРегистрацииРН    		= ВыборкаРегистр.МестоРегистрации;
				СторноРН    				= ВыборкаРегистр.Сторно;
				ТекОбъектНалогообложенияРН  = ВыборкаРегистр.ОбъектНалогообложения; 
				
				ТекСчетРасчетовРН 			= ВыборкаРегистр.СчетРасчетов;
				ТекКПССчетРасчетовРН 		= ВыборкаРегистр.КПССчетРасчетов;
				
				ТекСчетОстаток              = ВыборкаРегистр.СуммаОст;
				ТекСчетОстатокВалютный		= ВыборкаРегистр.СуммаОстВалютный;
				
				ТекРНОстатокБезНДС          = ВыборкаРегистр.СуммаБезНДСОстаток;
				ТекРНОстатокСНДС            = ВыборкаРегистр.СуммаНДСОстаток;
				
				ТекРНОстатокБезНДСВалютный	= ВыборкаРегистр.СуммаБезНДСВалютнаяОстаток;
				ТекРНОстатокСНДСВалютный	= ВыборкаРегистр.СуммаНДСВалютнаяОстаток;
				
			КонецЕсли;
			
			// Сумма движения
			
			ТекСчетОстаток 			= ТекСчетОстаток - ВыборкаРегистр.Сумма;
			ТекСчетОстатокВалютный 	= ТекСчетОстатокВалютный - ВыборкаРегистр.ВалютнаяСумма;
			ЗаписатьДвижения = Истина;
			
			Если (ТекСчетОстаток <> 0) Тогда
				
				КоэффициентПропорциональности = ПоМодулю(ВыборкаРегистр.Сумма / ВыборкаРегистр.СуммаОст);
				
				СуммаДвиженияБезНДС = Окр(ВыборкаРегистр.СуммаБезНДСОстаток * КоэффициентПропорциональности, 2);
				СуммаДвиженияСНДС   = Окр(ВыборкаРегистр.СуммаНДСОстаток * КоэффициентПропорциональности, 2);
				
				Если ((СуммаДвиженияБезНДС = 0) Или (СуммаДвиженияСНДС = 0)) Тогда
					
					// Полученная сумма так мала, что ею можно пренебречь
					ЗаписатьДвижения = Ложь; 
				
				КонецЕсли;
			Иначе
				СуммаДвиженияБезНДС = ТекРНОстатокБезНДС; 
				СуммаДвиженияСНДС   = ТекРНОстатокСНДС;
			КонецЕсли;
			
			Если (ТекСчетОстатокВалютный <> 0) Тогда
				
				КоэффициентПропорциональности = ПоМодулю(ВыборкаРегистр.ВалютнаяСумма / ВыборкаРегистр.СуммаОстВалютный);
				
				СуммаДвиженияБезНДСВалютный = Окр(ВыборкаРегистр.СуммаБезНДСВалютнаяОстаток * КоэффициентПропорциональности, 2);
				СуммаДвиженияСНДСВалютный   = Окр(ВыборкаРегистр.СуммаНДСВалютнаяОстаток * КоэффициентПропорциональности, 2);
				
				Если ((СуммаДвиженияБезНДСВалютный = 0) Или (СуммаДвиженияСНДСВалютный = 0)) Тогда
					
					// Полученная сумма так мала, что ею можно пренебречь
					ЗаписатьДвижения = ЗаписатьДвижения ИЛИ Ложь;
					
				КонецЕсли;
			Иначе
				СуммаДвиженияБезНДСВалютный = ТекРНОстатокБезНДСВалютный; 
				СуммаДвиженияСНДСВалютный   = ТекРНОстатокСНДСВалютный;
			КонецЕсли;
			
			Если НЕ ЗаписатьДвижения Тогда
				Продолжить;
			КонецЕсли;
			
			
			ТекРНОстатокБезНДС  = ТекРНОстатокБезНДС - СуммаДвиженияБезНДС;
			ТекРНОстатокСНДС    = ТекРНОстатокСНДС - СуммаДвиженияСНДС;
			
			ТекРНОстатокБезНДСВалютный	= ТекРНОстатокБезНДСВалютный - СуммаДвиженияБезНДСВалютный;
			ТекРНОстатокСНДСВалютный	= ТекРНОстатокСНДСВалютный - СуммаДвиженияСНДСВалютный;
			
			
			// Движение в "-" со старым КБК
			
			Движение = ТаблицаИсходящийНДС.Добавить();
			
			Движение.ВидДвижения                = ВидДвиженияНакопления.Расход;
			Движение.Период                     = ДатаДокумента;
			Движение.КПССчетРасчетов            = ВыборкаРегистр.КПССчетРасчетов;
			
			Движение.СуммаБезНДС                = СуммаДвиженияБезНДС;
			Движение.СуммаНДС                   = СуммаДвиженияСНДС;
			
			Движение.СуммаБезНДСВалютная 		= СуммаДвиженияБезНДСВалютный;
			Движение.СуммаНДСВалютная 			= СуммаДвиженияСНДСВалютный;
			
			Движение.Организация                = ВыборкаРегистр.Организация;
			Движение.СчетФактура                = ВыборкаРегистр.СчетФактура;
			Движение.ПричинаНалогообложения     = ВыборкаРегистр.ПричинаНалогообложения;
			Движение.КФО                        = ВыборкаРегистр.КФО;
			Движение.СтавкаНДС                  = ВыборкаРегистр.СтавкаНДС;
			Движение.СчетДебета                 = ВыборкаРегистр.СчетДебета;
			Движение.КОСГУСчетДебета            = ВыборкаРегистр.КОСГУСчетДебета;
			Движение.ОбъектНалогообложения      = ВыборкаРегистр.ОбъектНалогообложения;
			Движение.СчетРасчетов               = ВыборкаРегистр.СчетРасчетов;
			Движение.МестоРегистрации			= ВыборкаРегистр.МестоРегистрации;
			Движение.Сторно						= ВыборкаРегистр.Сторно;
			
			// Движение в "+" с новым КПС
			
			Движение = ТаблицаИсходящийНДС.Добавить();
			
			Движение.ВидДвижения                = ВидДвиженияНакопления.Приход;
			Движение.Период                     = ДатаДокумента;
			Движение.КПССчетРасчетов            = ВыборкаРегистр.НовыйКПС;
			
			Движение.СуммаБезНДС                = СуммаДвиженияБезНДС;
			Движение.СуммаНДС                   = СуммаДвиженияСНДС;
			
			Движение.СуммаБезНДСВалютная 		= СуммаДвиженияБезНДСВалютный;
			Движение.СуммаНДСВалютная 			= СуммаДвиженияСНДСВалютный;
			
			Движение.Организация                = ВыборкаРегистр.Организация;
			Движение.СчетФактура                = ВыборкаРегистр.СчетФактура;
			Движение.ПричинаНалогообложения     = ВыборкаРегистр.ПричинаНалогообложения;
			Движение.КФО                        = ВыборкаРегистр.КФО;
			Движение.СтавкаНДС                  = ВыборкаРегистр.СтавкаНДС;
			Движение.СчетДебета                 = ВыборкаРегистр.СчетДебета;
			Движение.КОСГУСчетДебета            = ВыборкаРегистр.КОСГУСчетДебета;
			Движение.ОбъектНалогообложения      = ВыборкаРегистр.ОбъектНалогообложения;
			Движение.СчетРасчетов               = ВыборкаРегистр.СчетРасчетов;
			Движение.МестоРегистрации			= ВыборкаРегистр.МестоРегистрации;
			Движение.Сторно						= ВыборкаРегистр.Сторно;
			
		КонецЦикла;
		
		ВыборкаРегистр = Результаты[8].Выбрать();   //входящий к распределению
		
		// Движение по регистру накопления остатков
		
		ТекКонтрагентРН                 = Неопределено;
		ТекВидЦенностиРН                = Неопределено;
		ТекСчетФактураРН                = Неопределено;
		ТекПричинаНалогообложенияРН     = Неопределено;
		ТекСтавкаНДСРН                  = Неопределено;
		ДокументКорректировкиРН         = Неопределено;
		МестоРегистрацииРН        		= Неопределено;
		СторноРН        				= Неопределено;
		ТекОбъектНалогообложенияРН      = Неопределено;
		СчетКредитаРН                   = Неопределено;
		
		ТекСчетРасчетовРН        		= Неопределено;
		ТекКПССчетРасчетовРН      		= Неопределено;
		
		Пока ВыборкаРегистр.Следующий() Цикл
			
			Если ((ТекКонтрагентРН 				<> ВыборкаРегистр.Контрагент) Или
				(ТекВидЦенностиРН 				<> ВыборкаРегистр.ВидЦенности) Или
				(СчетКредитаРН 					<> ВыборкаРегистр.СчетКредита) Или
				(ТекСчетФактураРН 				<> ВыборкаРегистр.СчетФактура) Или
				(ТекПричинаНалогообложенияРН 	<> ВыборкаРегистр.ПричинаНалогообложения) Или
				(ТекСтавкаНДСРН 				<> ВыборкаРегистр.СтавкаНДС) Или
				(ДокументКорректировкиРН 		<> ВыборкаРегистр.ДокументКорректировки) Или
				(МестоРегистрацииРН 			<> ВыборкаРегистр.МестоРегистрации) Или
				(СторноРН 						<> ВыборкаРегистр.Сторно) Или
				(ТекОбъектНалогообложенияРН 	<> ВыборкаРегистр.ОбъектНалогообложения) Или
				(ТекСчетРасчетовРН 				<> ВыборкаРегистр.СчетРасчетов) Или
				(ТекКПССчетРасчетовРН 			<> ВыборкаРегистр.КПССчетРасчетов)) Тогда
				
				ТекКонтрагентРН             = ВыборкаРегистр.Контрагент;
				ТекВидЦенностиРН            = ВыборкаРегистр.ВидЦенности;
				СчетКредитаРН	            = ВыборкаРегистр.СчетКредита;
				ТекСчетФактураРН            = ВыборкаРегистр.СчетФактура;
				ТекПричинаНалогообложенияРН = ВыборкаРегистр.ПричинаНалогообложения;
				ТекСтавкаНДСРН              = ВыборкаРегистр.СтавкаНДС;
				ДокументКорректировкиРН     = ВыборкаРегистр.ДокументКорректировки;
				МестоРегистрацииРН    		= ВыборкаРегистр.МестоРегистрации;
				СторноРН    				= ВыборкаРегистр.Сторно;
				ТекОбъектНалогообложенияРН  = ВыборкаРегистр.ОбъектНалогообложения; 
				
				ТекСчетРасчетовРН 			= ВыборкаРегистр.СчетРасчетов;
