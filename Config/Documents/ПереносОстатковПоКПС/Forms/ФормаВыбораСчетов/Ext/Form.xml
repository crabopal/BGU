			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ЕПСБУ.Код КАК Код,
	ЕПСБУ.Наименование,
	ВЫБОР
		КОГДА ЕПСБУ.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
			ТОГДА "А"
		ИНАЧЕ ВЫБОР
				КОГДА ЕПСБУ.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
					ТОГДА "П"
				ИНАЧЕ "АП"
			КОНЕЦ
	КОНЕЦ КАК Вид,
	ЕПСБУ.Забалансовый КАК Забалансовый,
	ЕПСБУ.Валютный,
	ЕПСБУ.Количественный,
	ЕПСБУ.Родитель,
