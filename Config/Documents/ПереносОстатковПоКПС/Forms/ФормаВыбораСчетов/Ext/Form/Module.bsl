
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для Каждого ТекСчет Из Параметры.Счета Цикл
		
		НовСтр = ВыбранныеСчета.Добавить();
		НовСтр.Счет = ТекСчет;
		
	КонецЦикла;
	
	АдресХранилища = Параметры.АдресХранилища;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если НЕ ПеренестиВДокумент И ДобавленыСчета Тогда
		
		Отказ = Истина;
		
		ТекстВопроса = НСтр("ru = 'Выбранные счета не перенесены в документ.
			|
			|Перенести?'");
			
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, 10, КодВозвратаДиалога.Отмена,, КодВозвратаДиалога.Отмена);	
	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(ОтветНаВопрос, ДополнительныеПараметры) Экспорт 
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокумент = Истина;
		Закрыть();
	ИначеЕсли ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
		ДобавленыСчета = Ложь;
		Закрыть();
	КонецЕсли;	

КонецПроцедуры


&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	ПеренестиСчетаВДокумент();
	
КонецПроцедуры
 
#КонецОбласти
 
#Область ОбработчикиСобытийЭлементовТаблицыФормыПланСчетовЕПСБУ 

&НаКлиенте
Процедура ПланСчетовЕПСБУВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОбработатьВыборНаКлиенте(Элемент);
КонецПроцедуры


&НаКлиенте
Процедура ПланСчетовЕПСБУВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОбработатьВыборНаКлиенте(Элемент);
КонецПроцедуры

#КонецОбласти
 
#Область ОбработчикиСобытийЭлементовТаблицыФормыВыбранныеСчета

&НаКлиенте
Процедура ВыбранныеСчетаПослеУдаления(Элемент)
	ДобавленыСчета = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеСчетаСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеСчетаСчетОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ПеренестиВДокумент = Истина;
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбработатьВыборНаКлиенте(Элемент)
	ВыделенныеСтроки = Новый СписокЗначений;
	ВыделенныеСтроки.ЗагрузитьЗначения(Элемент.ВыделенныеСтроки);
	МассивСтрок = Новый Массив;
	ДобавлятьСразу = ВыделенныеСтроки.Количество() = 1;
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		Элемент.ТекущаяСтрока = ВыделеннаяСтрока.Значение;
        Если Элемент.ТекущиеДанные <> Неопределено Тогда
        	МассивСтрок.Добавить(Элемент.ТекущиеДанные.Ссылка);
		КонецЕсли;
	КонецЦикла;
	ОбработатьВыборНаСервере(МассивСтрок);
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборНаСервере(МассивСчетов)
	
	Для Каждого ЭлМас Из МассивСчетов Цикл
		Если ВыбранныеСчета.НайтиСтроки(Новый Структура("Счет",ЭлМас)).Количество() = 0 Тогда
			ДобавленыСчета = Истина;
			НовСтр = ВыбранныеСчета.Добавить();
			НовСтр.Счет = ЭлМас;
		КонецЕсли;		
	КонецЦикла;
	ВыбранныеСчета.Сортировать("Счет");
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиСчетаВДокумент()
	
	Если ПеренестиВДокумент Тогда
		
		АдресВХранилище = ПоместитьСчетаВХранилище();
		
		Структура = Новый Структура("АдресПодобранныхСчетовВХранилище", АдресВХранилище);
		
		ПеренестиВДокумент = Истина;
		
		ОповеститьОВыборе(Структура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьСчетаВХранилище()

	АдресПодобранныхСчетовВХранилище = ПоместитьВоВременноеХранилище(ВыбранныеСчета.Выгрузить(), АдресХранилища);

	Возврат АдресПодобранныхСчетовВХранилище;

КонецФункции

#КонецОбласти