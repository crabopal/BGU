
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, СтруктураРезультата());
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры,
		"Ссылка,НомерСтроки,Организация,Дата,Контрагент,Договор,СчетРасчетов,ИФО,КФО,КПС,Валюта");
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Параметры.ТолькоПросмотр Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидДоговора,ВестиГрафикПлатежей");
	ИспользоватьДетализациюПоКОСГУ = КонтрольИсполненияДоговоров.ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам(РеквизитыДоговора.ВидДоговора);
	ИспользоватьДополнительнуюАналитику = КонтрольИсполненияДоговоров.ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей(РеквизитыДоговора.ВидДоговора);
	
	Если Не РеквизитыДоговора.ВестиГрафикПлатежей Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Параметры.Свойство("ГрафикПлатежей") И ЭтоАдресВременногоХранилища(Параметры.ГрафикПлатежей) Тогда
		ТаблицаГрафикПлатежей = ПолучитьИзВременногоХранилища(Параметры.ГрафикПлатежей);
		ГрафикПлатежей.Загрузить(ТаблицаГрафикПлатежей);
	КонецЕсли;
	
	ИтогСуммаВВалюте = ГрафикПлатежей.Итог("СуммаВВалюте");
	
	ЭлементыКЭК = Новый Массив;
	ЭлементыКЭК.Добавить("ГрафикПлатежейКЭК");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыКЭК, "Видимость", ИспользоватьДетализациюПоКОСГУ);
	
	ЭлементыДопАналитика = Новый Массив;
	ЭлементыДопАналитика.Добавить("ГрафикПлатежейДопКлассификация");
	ЭлементыДопАналитика.Добавить("ГрафикПлатежейКодМероприятия");
	ЭлементыДопАналитика.Добавить("ГрафикПлатежейКодЦели");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыДопАналитика, "Видимость", ИспользоватьДополнительнуюАналитику);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность И НЕ ПеренестиВДокумент Тогда
		
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");
		Оповещение = Новый ОписаниеОповещения("ВопросЗавершитьРедактирование", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
		Отказ = Истина;
		
	Иначе
		
		Если ПеренестиВДокумент И НЕ Отказ Тогда
			Отказ = НЕ ПроверитьЗаполнениеНаКлиенте();
		КонецЕсли;
		
		Если Отказ Тогда
			ПеренестиВДокумент = Ложь;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВопросЗавершитьРедактирование(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокумент = Истина;
		Закрыть();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		ПеренестиВДокумент = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если ПеренестиВДокумент Тогда
		
		СтруктураРезультат = Новый Структура(СтруктураРезультата());
		ЗаполнитьЗначенияСвойств(СтруктураРезультат, ЭтаФорма);
		
		СтруктураРезультат.Вставить("ВидРасчетов", ВидРасчетов);
		СтруктураРезультат.Вставить("ГрафикПлатежей", ПоместитьГрафикПлатежейВХранилище());
		
		ОповеститьОВыборе(СтруктураРезультат);
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидРасчетовПриИзменении(Элемент)
	
	ЗаполнитьГрафикПлатежейНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ГрафикПлатежей

&НаКлиенте
Процедура ГрафикПлатежейПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ГрафикПлатежей.Сортировать("ОплатитьДо");
	
	ИтогСуммаВВалюте = ГрафикПлатежей.Итог("СуммаВВалюте");
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикПлатежейПослеУдаления(Элемент)
	
	ИтогСуммаВВалюте = ГрафикПлатежей.Итог("СуммаВВалюте");
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикПлатежейСуммаВВалютеПриИзменении(Элемент)
	
	ИтогСуммаВВалюте = ГрафикПлатежей.Итог("СуммаВВалюте");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоОстаткам(Команда)
	
	ЗаполнитьГрафикПлатежейНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ПеренестиВДокумент = Истина;
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьГрафикПлатежейНаСервере()
	
	ГрафикПлатежей.Очистить();
	
	ПереносОстатковНаНовыеКПС = Новый ТаблицаЗначений;
	// Идентификация строки.
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	// Аналитика расчетов.
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("ВидРасчетов",   Новый ОписаниеТипов("ПеречислениеСсылка.ВидыРасчетовПоЗаймам"));
	
	НоваяСтрока = ПереносОстатковНаНовыеКПС.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтотОбъект,
		"НомерСтроки,Контрагент,Договор,ИФО,КФО,КПС,СчетРасчетов,ВидРасчетов,Валюта");
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка", Ссылка);
	Реквизиты.Вставить("Организация", Организация);
	Реквизиты.Вставить("Дата", Дата);
	
	Отказ = Ложь;
	
	Если БухгалтерскийУчет.СчетВИерархии(СчетРасчетов, "205.00,207.00,209.00") Тогда // Покупатели, дебиторы.
		
		НеисполненныеПлатежиОтПокупателейДебиторов = КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(
			ПереносОстатковНаНовыеКПС, Организация);
		
		Для Каждого СтрокаПлатеж Из НеисполненныеПлатежиОтПокупателейДебиторов Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаПлатеж.ОплатитьДо) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ГрафикПлатежей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлатеж, "ОплатитьДо");
			Если ИспользоватьДетализациюПоКОСГУ Тогда
				НоваяСтрока.КЭК = СтрокаПлатеж.КЭК;
			КонецЕсли;
			Если ИспользоватьДополнительнуюАналитику Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлатеж, "ДопКлассификация,КодМероприятия,КодЦели");
			КонецЕсли;
			НоваяСтрока.СуммаВВалюте = СтрокаПлатеж.Сумма;
			
		КонецЦикла;
		
	Иначе
		
		НеисполненныеПлатежиПоставщикамКредиторам = КонтрольИсполненияДоговоров.НеисполненныеПлатежиПоставщикамКредиторам(
			ПереносОстатковНаНовыеКПС, Организация);
		
		Для Каждого СтрокаПлатеж Из НеисполненныеПлатежиПоставщикамКредиторам Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаПлатеж.ОплатитьДо) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ГрафикПлатежей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлатеж, "ОплатитьДо");
			Если ИспользоватьДетализациюПоКОСГУ Тогда
				НоваяСтрока.КЭК = СтрокаПлатеж.КЭК;
			КонецЕсли;
			Если ИспользоватьДополнительнуюАналитику Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлатеж, "ДопКлассификация,КодМероприятия,КодЦели");
			КонецЕсли;
			НоваяСтрока.СуммаВВалюте = СтрокаПлатеж.Сумма;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ИтогСуммаВВалюте = ГрафикПлатежей.Итог("СуммаВВалюте");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СтруктураРезультата()
	
	Возврат "ИдентификаторСтроки,ВидРасчетов";
	
КонецФункции

&НаКлиенте
Функция ПроверитьЗаполнениеНаКлиенте()
	
	Отказ = Ложь;
	
	Возврат Не Отказ;
	
КонецФункции

&НаСервере
Функция ПоместитьГрафикПлатежейВХранилище()
	
	Возврат ПоместитьВоВременноеХранилище(ГрафикПлатежей.Выгрузить(), УникальныйИдентификатор);
	
КонецФункции

#КонецОбласти

