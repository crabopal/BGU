
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, СтруктураРезультата());
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры,
		"Ссылка,НомерСтроки,Организация,Дата,Контрагент,Договор,СчетРасчетов,ИФО,КФО,КПС,Валюта");
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Параметры.ТолькоПросмотр Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидДоговора,ВестиПланГрафикИсполнения");
	ИспользоватьДетализациюПоКОСГУ = КонтрольИсполненияДоговоров.ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам(РеквизитыДоговора.ВидДоговора);
	
	Если Не РеквизитыДоговора.ВестиПланГрафикИсполнения Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Параметры.Свойство("ГрафикИсполнения") И ЭтоАдресВременногоХранилища(Параметры.ГрафикИсполнения) Тогда
		ТаблицаГрафикИсполнения = ПолучитьИзВременногоХранилища(Параметры.ГрафикИсполнения);
		ГрафикИсполнения.Загрузить(ТаблицаГрафикИсполнения);
	КонецЕсли;
	
	ИтогСуммаВВалюте = ГрафикИсполнения.Итог("СуммаВВалюте");
	
	ЭтоДоходы = БухгалтерскийУчет.СчетВИерархии(СчетРасчетов, "205.00,209.00");
	Если ЭтоДоходы Тогда
		Заголовок = НСтр("ru = 'План-график реализации'");
	Иначе
		Заголовок = НСтр("ru = 'План-график закупок'");
	КонецЕсли;
	
	ЭлементыКЭК = Новый Массив;
	ЭлементыКЭК.Добавить("ГрафикИсполненияКЭК");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыКЭК, "Видимость", ИспользоватьДетализациюПоКОСГУ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность И НЕ ПеренестиВДокумент Тогда
		
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");
		Оповещение = Новый ОписаниеОповещения("ВопросЗавершитьРедактирование", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
		Отказ = Истина;
		
	Иначе
		
		Если ПеренестиВДокумент И НЕ Отказ Тогда
			Отказ = НЕ ПроверитьЗаполнениеНаКлиенте();
		КонецЕсли;
		
		Если Отказ Тогда
			ПеренестиВДокумент = Ложь;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВопросЗавершитьРедактирование(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокумент = Истина;
		Закрыть();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		ПеренестиВДокумент = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если ПеренестиВДокумент Тогда
		
		СтруктураРезультат = Новый Структура(СтруктураРезультата());
		ЗаполнитьЗначенияСвойств(СтруктураРезультат, ЭтаФорма);
		
		СтруктураРезультат.Вставить("ГрафикИсполнения", ПоместитьГрафикИсполненияВХранилище());
		
		ОповеститьОВыборе(СтруктураРезультат);
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ГрафикИсполнения

&НаКлиенте
Процедура ГрафикИсполненияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ГрафикИсполнения.Сортировать("ОплатитьДо");
	
	ИтогСуммаВВалюте = ГрафикИсполнения.Итог("СуммаВВалюте");
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикИсполненияПослеУдаления(Элемент)
	
	ИтогСуммаВВалюте = ГрафикИсполнения.Итог("СуммаВВалюте");
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикИсполненияСуммаВВалютеПриИзменении(Элемент)
	
	ИтогСуммаВВалюте = ГрафикИсполнения.Итог("СуммаВВалюте");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоОстаткам(Команда)
	
	ЗаполнитьГрафикИсполненияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ПеренестиВДокумент = Истина;
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьГрафикИсполненияНаСервере()
	
	ГрафикИсполнения.Очистить();
	
	ПереносОстатковНаНовыеКПС = Новый ТаблицаЗначений;
	// Идентификация строки.
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	// Аналитика расчетов.
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПереносОстатковНаНовыеКПС.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	НоваяСтрока = ПереносОстатковНаНовыеКПС.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтотОбъект,
		"НомерСтроки,Контрагент,Договор,ИФО,КФО,КПС,СчетРасчетов,Валюта");
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка", Ссылка);
	Реквизиты.Вставить("Организация", Организация);
	Реквизиты.Вставить("Дата", Дата);
	
	Отказ = Ложь;
	
	Если ЭтоДоходы Тогда // Покупатели, дебиторы.
		
		НеисполненныеДоговораСПокупателями = КонтрольИсполненияДоговоров.НеисполненныеДоговораСПокупателями(
			ПереносОстатковНаНовыеКПС, Организация);
		
		Для Каждого СтрокаИсполнение Из НеисполненныеДоговораСПокупателями Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаИсполнение.ИсполнитьДо) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ГрафикИсполнения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсполнение, "ИсполнитьДо");
			Если ИспользоватьДетализациюПоКОСГУ Тогда
				НоваяСтрока.КЭК = СтрокаИсполнение.КЭК;
			КонецЕсли;
			НоваяСтрока.СуммаВВалюте = СтрокаИсполнение.Сумма;
			
		КонецЦикла;
		
	Иначе // Поставщики, кредиторы.
		
		НеисполненныеОбязательстваПоставщиков = КонтрольИсполненияДоговоров.НеисполненныеОбязательстваПоставщиков(
			ПереносОстатковНаНовыеКПС, Организация);
		
		Для Каждого СтрокаИсполнение Из НеисполненныеОбязательстваПоставщиков Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаИсполнение.ИсполнитьДо) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ГрафикИсполнения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсполнение, "ИсполнитьДо");
			Если ИспользоватьДетализациюПоКОСГУ Тогда
				НоваяСтрока.КЭК = СтрокаИсполнение.КЭК;
			КонецЕсли;
			НоваяСтрока.СуммаВВалюте = СтрокаИсполнение.Сумма;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ИтогСуммаВВалюте = ГрафикИсполнения.Итог("СуммаВВалюте");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СтруктураРезультата()
	
	Возврат "ИдентификаторСтроки";
	
КонецФункции

&НаКлиенте
Функция ПроверитьЗаполнениеНаКлиенте()
	
	Отказ = Ложь;
	
	Возврат Не Отказ;
	
КонецФункции

&НаСервере
Функция ПоместитьГрафикИсполненияВХранилище()
	
	Возврат ПоместитьВоВременноеХранилище(ГрафикИсполнения.Выгрузить(), УникальныйИдентификатор);
	
КонецФункции

#КонецОбласти

