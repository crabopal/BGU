	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Ref</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументПереносОстатковПоКПС.Ссылка,
	ДокументПереносОстатковПоКПС.ВерсияДанных,
	ДокументПереносОстатковПоКПС.ПометкаУдаления,
	ДокументПереносОстатковПоКПС.Номер,
	ДокументПереносОстатковПоКПС.Дата,
	ДокументПереносОстатковПоКПС.Проведен,
	ДокументПереносОстатковПоКПС.Организация,
	ДокументПереносОстатковПоКПС.ИФО,
	ДокументПереносОстатковПоКПС.Подразделение,
	ДокументПереносОстатковПоКПС.КФО,
	ДокументПереносОстатковПоКПС.Комментарий,
	ДокументПереносОстатковПоКПС.ЧерезТретийСчет,
	ДокументПереносОстатковПоКПС.ПромежуточныйСчет,
	ДокументПереносОстатковПоКПС.ПромежуточныйКЭК,
	ДокументПереносОстатковПоКПС.ПромежуточныйКПС,
	ДокументПереносОстатковПоКПС.ВариантПереноса,
	ДокументПереносОстатковПоКПС.ОтборПоПодразделению,
	ДокументПереносОстатковПоКПС.СуммаДокумента,
	ДокументПереносОстатковПоКПС.СчетаПереноса,
	ДокументПереносОстатковПоКПС.МоментВремени,
	ВЫБОР
		КОГДА ДокументПереносОстатковПоКПС.ВариантПереноса = 0
				ИЛИ ДокументПереносОстатковПоКПС.ВариантПереноса = 2
			ТОГДА ПереносОстатковПоКПССоответствиеКПС.СтарыйКПС
		ИНАЧЕ "&lt;Список КПС&gt;"
	КОНЕЦ КАК СтарыйКПС,
	ВЫБОР
		КОГДА ДокументПереносОстатковПоКПС.ВариантПереноса = 0
				ИЛИ ДокументПереносОстатковПоКПС.ВариантПереноса = 1
			ТОГДА ПереносОстатковПоКПССоответствиеКПС.НовыйКПС
		ИНАЧЕ "&lt;Список КПС&gt;"
	КОНЕЦ КАК НовыйКПС,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
ДокументПереносОстатковПоКПС.Ответственный
ИЗ
	Документ.ПереносОстатковПоКПС КАК ДокументПереносОстатковПоКПС
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПереносОстатковПоКПС.СоответствиеКПС КАК ПереносОстатковПоКПССоответствиеКПС
		ПО (ПереносОстатковПоКПССоответствиеКПС.Ссылка = ДокументПереносОстатковПоКПС.Ссылка
				И ПереносОстатковПоКПССоответствиеКПС.НомерСтроки = 1)
