#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроводкиИТУ(Команда)
	
	ТекущиеДанные = Элементы.СписокПереносКФОКПС.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ДокументОснование", ТекущиеДанные.Ссылка);
	ОткрытьФорму("Обработка.ФормированиеБухгалтерскихПроводок.Форма.Форма", ПараметрыФормы);
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	
	Если ТипЗнч(ЭтотОбъект.ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
		ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, ЭтотОбъект.ТекущийЭлемент);
	КонецЕсли;	


КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, ЭтотОбъект.ТекущийЭлемент, Результат);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ПереносОстатковПоКПС" Тогда
		ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы["Список"]);
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ПереносОстатковПриИзмененииТипаУчреждения" Тогда
		ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы["СписокПереносКФОКПС"]);
	КонецЕсли;

КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуБГУ(Команда)
	
	Если Лев(Команда.Имя, 44) = "ВнутреннийЭДО_ПросмотретьЭлектронныйДокумент" Тогда
		ИмяТабЧасти = Сред(Команда.Имя, 45);
	ИначеЕсли Лев(Команда.Имя, 41) = "ВнутреннийЭДО_СоздатьЭлектронныеДокументы" Тогда
		ИмяТабЧасти = Сред(Команда.Имя, 42);
	ИначеЕсли Лев(Команда.Имя, 46) = "ВнутреннийЭДО_АннулироватьЭлектронныеДокументы" Тогда
		ИмяТабЧасти = Сред(Команда.Имя, 47);
	ИначеЕсли Лев(Команда.Имя, 50) = "ВнутреннийЭДО_ОткрытьЭлектронныеДокументыНаПодпись" Тогда
		ИмяТабЧасти = Сред(Команда.Имя, 51);
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяТабЧасти) Тогда
		ИмяТабЧасти = "Список";
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Элементы[ИмяТабЧасти]);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОтборОрганизацияПриИзмененииНаСервере()
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокПереносКФОКПС.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	
	Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
	Элементы.СписокПереносКФОКПСОрганизация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
КонецПроцедуры

#КонецОбласти
