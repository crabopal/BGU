&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьКоличества(Форма)
	ЭлементКоличество = "ПереводыКоличество"; 
	Если Форма.Элементы.СтраницыДанныхПереноса.ТекущаяСтраница = Форма.Элементы.СтраницаНоменклатура Тогда
		ЭлементКоличество = "ТаблицаНоменклатурыКоличество"; 
	ИначеЕсли Форма.Элементы.СтраницыДанныхПереноса.ТекущаяСтраница = Форма.Элементы.СтраницаОсновныеСредства Тогда
		ЭлементКоличество = "ТаблицаОсновныеСредстваКоличество"; 
	КонецЕсли;	           

	Количественный = Истина;
	СчетПереноса = Форма.СчетПереноса;
	Если ЗначениеЗаполнено(СчетПереноса) Тогда
		Количественный = ЗначениеРеквизитаОбъекта(СчетПереноса, "Количественный");
	КонецЕсли;	

	Форма.Элементы[ЭлементКоличество].Видимость = Количественный;
КонецПроцедуры	

&НаСервере
Процедура УстановитьВидимостьРеквизитовПоВидуОперации()
	
	Элементы.СлужебныеСчета.Видимость = Истина;
	Элементы.ПереводыВалютнаяСумма.Видимость = Истина;
	Элементы.ПереводыСумма.Видимость = Истина;
	Элементы.ПереводыКоличество.Видимость = Истина;
	
	Элементы.СтраницыДанныхПереноса.ТекущаяСтраница = Элементы.СтраницаОбщая;
	
	Если Объект.ВидОперацииПриИзмененииТипа = 0 Тогда
		
		Элементы.СтраницыДанныхПереноса.ТекущаяСтраница = Элементы.СтраницаНоменклатура;
		
		Элементы.СтраницыПараметровСчетов.ТекущаяСтраница = Элементы.СтраницаМЗ;
		
		Элементы.ПереводыВалютнаяСумма.Видимость = Ложь;
		Элементы.ПереводыСумма.Видимость = Ложь;
		Элементы.ПереводыКоличество.Видимость = Ложь;
		
		ОграниченияСписокСчетов = Новый Массив;
		ОграниченияСписокСчетов.Добавить("105.21"); //ОЦДИ
		ОграниченияСписокСчетов.Добавить("105.22");
		ОграниченияСписокСчетов.Добавить("105.23");
		ОграниченияСписокСчетов.Добавить("105.24");
