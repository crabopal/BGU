&НаСервере
Процедура УстановитьДинамическиеДанныеВТабличнойЧасти()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУ.Валютный,
		|	ЕПСБУ.Количественный,
		|	ЕПСБУВидыСубконто.ВидСубконто,
		|	ЕПСБУВидыСубконто.НомерСтроки,
		|	ЕПСБУВидыСубконто.ТолькоОбороты,
		|	ЕПСБУ.Ссылка,
		|	ЕПСБУВидыСубконто.ВидСубконто.Наименование КАК Наименование,
		|	ЕПСБУ.УчетПоПодразделениям
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ПО (ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка)
		|ГДЕ
		|	ЕПСБУ.Ссылка В(&ВыбранныеСчета)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТаб.Ссылка КАК Счет,
		|	ВремТаб.УчетПоПодразделениям,
		|	ВремТаб.Валютный КАК СчетВалютный,
		|	ВремТаб.Количественный КАК СчетКоличественный,
		|	НЕ ЕСТЬNULL(С1.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто1,
		|	НЕ ЕСТЬNULL(С2.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто2,
		|	НЕ ЕСТЬNULL(С3.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто3
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С1
		|		ПО (ВремТаб.Ссылка = С1.Ссылка
		|				И С1.НомерСтроки = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С2
		|		ПО (ВремТаб.Ссылка = С2.Ссылка
		|				И С2.НомерСтроки = 2)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С3
		|		ПО (ВремТаб.Ссылка = С3.Ссылка
		|				И С3.НомерСтроки = 3)";

	Запрос.УстановитьПараметр("ВыбранныеСчета", Объект.Переводы.Выгрузить().ВыгрузитьКолонку("Счет"));
	ДанныеСчетов = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрТЧ Из Объект.Переводы Цикл
		
		ТекОбъект = ДанныеСчетов.НайтиСтроки(Новый Структура("Счет", СтрТЧ.Счет));
		Если ТекОбъект.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрТЧ, ТекОбъект[0],
				"УчетПоПодразделениям,ИспользоватьСубконто1,ИспользоватьСубконто2,ИспользоватьСубконто3,"
				+ "СчетВалютный,СчетКоличественный");
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧНаСервере()
	
	Объект.Переводы.Очистить();
	Объект.ПереводАмортизации.Очистить();
	ТаблицаНоменклатуры.Очистить();
	ТаблицаОсновныеСредства.Очистить();
	
	ЗаполнитьСоответствиеКПСПоВариантуПереноса(Объект);
	ЗаполнитьСоответсвиеКПСДляВыбора();
	
	БлокВыбрать = "";
	БлокОтбор = "";
	БлокОтборПоСчету = "Счет В (&ВыбранныеСчета)";
	БлокГруппировка = "";
	ВыбранныеСчета = Объект.Счета.Выгрузить().ВыгрузитьКолонку("Счет");
	БлокГДЕ = "";
	Если ВыбранныеСчета.Количество() = 1 Тогда
		БлокОтборПоСчету = "Счет = &ВыбранныеСчета";
		ВыбранныеСчета = ВыбранныеСчета[0];
	КонецЕсли;
	
	Если УчетПоИФО Тогда
		БлокОтбор = БлокОтбор + " ИФО = &ИФО ";
	КонецЕсли;
	
	Если УчетПоПодразделениям Тогда
		ТекстПоляПодразделение = "	ВЫБОР КОГДА ВремТабСчетов.УчетПоПодразделениям ТОГДА ЕстьNull(ЕПСБУОстатки.Подразделение,Значение(Справочник.Подразделения.ПустаяСсылка)) ИНАЧЕ Значение(Справочник.Подразделения.ПустаяСсылка) КОНЕЦ ";
		Если Объект.ОтборПоПодразделению Тогда
			БлокГДЕ = ТекстПоляПодразделение +"=&Подразделение";
		КонецЕсли;
		БлокГруппировка = БлокГруппировка+ ТекстПоляПодразделение +", ";
		БлокВыбрать = БлокВыбрать + ТекстПоляПодразделение + " КАК ПОДРАЗДЕЛЕНИЕ,
		|";
	КонецЕсли;
	
	Если ВалютныйУчет Тогда
		БлокГруппировка = БлокГруппировка+ " ВЫБОР КОГДА ВремТабСчетов.Валютный ТОГДА ЕПСБУОстатки.Валюта ИНАЧЕ Значение(Справочник.Валюты.ПустаяСсылка) КОНЕЦ, ";
		БлокВыбрать = БлокВыбрать + "	ВЫБОР КОГДА ВремТабСчетов.Валютный ТОГДА ЕПСБУОстатки.Валюта ИНАЧЕ Значение(Справочник.Валюты.ПустаяСсылка) КОНЕЦ КАК Валюта, ";
		Если Объект.ВидОперацииПриИзмененииТипа = 3
			ИЛИ Объект.ВидОперацииПриИзмененииТипа = 2 Тогда
			БлокВыбрать	= БлокВыбрать + " СУММА(ВЫБОР КОГДА ВремТабСчетов.Валютный ТОГДА ЕСТЬNULL(ЕПСБУОстатки.ВалютнаяСуммаОстатокДт, 0) ИНАЧЕ 0 КОНЕЦ) КАК ВалютнаяСуммаДт,
			                         |	СУММА(ВЫБОР КОГДА ВремТабСчетов.Валютный ТОГДА ЕСТЬNULL(ЕПСБУОстатки.ВалютнаяСуммаОстатокКт, 0) ИНАЧЕ 0 КОНЕЦ) КАК ВалютнаяСуммаКт,";	
		Иначе
			БлокВыбрать	= БлокВыбрать +"	СУММА(ВЫБОР КОГДА ВремТабСчетов.Валютный ТОГДА ЕСТЬNULL(ЕПСБУОстатки.ВалютнаяСуммаОстаток, 0) ИНАЧЕ 0 КОНЕЦ) КАК ВалютнаяСумма,
			|	";
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(БлокОтбор) Тогда
		БлокОтбор = " Истина ";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(БлокГДЕ) Тогда
		БлокГДЕ = " Истина ";
	КонецЕсли;
	Запрос = Новый Запрос;
	Если Объект.ВидОперацииПриИзмененииТипа = 0 Тогда
		//МЗ
		Если ЕстьКПС Тогда
			
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	СоответствиеКПС.НомерСтроки,
			|	СоответствиеКПС.СтарыйКПС,
			|	СоответствиеКПС.НовыйКПС
			|ПОМЕСТИТЬ СоответствиеКПС
			|ИЗ
			|	&СоответствиеКПС КАК СоответствиеКПС
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СоответствиеКПС.СтарыйКПС,
			|	СоответствиеКПС.НовыйКПС
			|ПОМЕСТИТЬ СоответствиеКПС_Сгруппированные
			|ИЗ
			|	(ВЫБРАТЬ
			|		МИНИМУМ(СоответствиеКПС.НомерСтроки) КАК НомерСтроки,
			|		СоответствиеКПС.СтарыйКПС КАК СтарыйКПС
