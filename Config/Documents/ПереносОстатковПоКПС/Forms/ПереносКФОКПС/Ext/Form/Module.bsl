&НаКлиенте
Процедура ВариантПереносаПриИзменении(Элемент)
	
	Если Объект.ВариантПереноса = 0 Тогда
		Объект.Распределять = Ложь;
		Объект.ОкруглятьКоличество = Ложь;
		Элементы.Распределять.Доступность = Ложь;
		Элементы.ОкруглятьКоличество.Доступность = Ложь;
		Элементы.ГруппаВариантыПереноса.ТекущаяСтраница = Элементы.ГруппаОдинКОдному;
	ИначеЕсли Объект.ВариантПереноса = 1 Тогда
		Объект.Распределять = Ложь;
		Объект.ОкруглятьКоличество = Ложь;
		Элементы.Распределять.Доступность = Ложь;
		Элементы.ОкруглятьКоличество.Доступность = Ложь;
		Элементы.ГруппаВариантыПереноса.ТекущаяСтраница = Элементы.ГруппаМногоКОдному;
	ИначеЕсли Объект.ВариантПереноса = 2 Тогда
		Элементы.Распределять.Доступность = Истина;
		Элементы.ОкруглятьКоличество.Доступность = Истина;
		Элементы.ГруппаВариантыПереноса.ТекущаяСтраница = Элементы.ГруппаОдинКоМногим;
	ИначеЕсли Объект.ВариантПереноса = 3 Тогда
		Элементы.Распределять.Доступность = Истина;
		Элементы.ГруппаВариантыПереноса.ТекущаяСтраница = Элементы.ГруппаМногоКоМногим;
	КонецЕсли;
	ЗаполнитьЭлементыФормыКПС();
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	ПриИзмененииКФО(Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКФО(Очищать)
	
	Если ТПС_Старый = ТПС_Новый И Объект.КФО = Объект.КФОНовый Тогда
		Элементы.СлужебныеСчета.Видимость = Ложь;
	Иначе
		УстановитьВидимостьРеквизитовПоВидуОперации();
		ВидимостьПолейВкладкиСлужебныеСчета();
	КонецЕсли;
	Если Очищать Тогда
		Объект.Переводы.Очистить();
		Объект.ПереводАмортизации.Очистить();
		ТаблицаНоменклатуры.Очистить();
		ТаблицаОсновныеСредства.Очистить();
	КонецЕсли;
КонецПроцедуры

