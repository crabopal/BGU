&НаКлиенте
Процедура УстановитьВидИмуществаЗавершение(Значение, ДополнительныеПараметры) Экспорт
	
	ТекТаблица = ДополнительныеПараметры.ТекТаблица;
	ТекТаблицаФормы = ДополнительныеПараметры.ТекТаблицаФормы;
	НовыйВидИмущества = ?(Значение = Неопределено, ДополнительныеПараметры.НовыйВидИмущества, Значение);
	
	
	Если НЕ (Значение <> Неопределено) Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтрок = ТекТаблицаФормы.ВыделенныеСтроки;
	Для Каждого ЭлМас Из МассивСтрок Цикл
		ТекСтр = ТекТаблица.НайтиПоИдентификатору(ЭлМас);
		Если ТекСтр <> Неопределено Тогда
			ТекСтр.ВидИмущества = НовыйВидИмущества;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОчиситьТабличныеЧасти()
	Объект.Переводы.Очистить();
	Объект.ПереводАмортизации.Очистить();
	ТаблицаНоменклатуры.Очистить();
	ТаблицаОсновныеСредства.Очистить();
КонецПроцедуры

&НаСервере
Функция ДобавитьСтрокуПереносаОС(Знач ОсновноеСредство)
	
	Запрос = Новый Запрос;
	Если Объект.Ссылка.Пустая() Тогда
		ПериодЗапроса = Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая);
	Иначе
		ПериодЗапроса = Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("101.00").УчетПоПодразделениям;
	
	Запрос.УстановитьПараметр("ПериодЗапроса"			, ПериодЗапроса);
	Запрос.УстановитьПараметр("Организация"				, Объект.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"		, ОсновноеСредство);
	Запрос.УстановитьПараметр("КФО"						, Объект.КФО);
	Запрос.УстановитьПараметр("КПС"						, СтарыйКПС);
	Запрос.УстановитьПараметр("УчетПоПодразделениям"	, ИспользоватьУчетПоПодразделениям);
	Запрос.УстановитьПараметр("НовыйКПС"				, НовыйКПС);
	Запрос.УстановитьПараметр("СчетУчетаВДокументе"		, СчетПереноса);
	Запрос.УстановитьПараметр("Счет104"					, БухгалтерскийУчет.СписокСчетов("104.00"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УчетныеДанныеОбъектаОССрезПоследних.Организация КАК Организация,
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидИмущества КАК ВидИмущества,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета,
	|	СоответствиеСчетовОС.СчетАмортизации КАК СчетАмортизации
	|ПОМЕСТИТЬ УчетныеДанные
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&ПериодЗапроса,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И СчетУчета В ИЕРАРХИИ (&СчетУчетаВДокументе)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
	|		ПО УчетныеДанныеОбъектаОССрезПоследних.СчетУчета = СоответствиеСчетовОС.СчетОС
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	ОсновноеСредство,
	|	СчетУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК СтарыйКПС,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Субконто3,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт) КАК СуммаДт,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт) КАК СуммаКт,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт) КАК КоличествоДт,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокКт) КАК КоличествоКт,
	|	УчетныеДанные.ВидИмущества КАК ВидИмущества,
	|	ЖурналПроводокЕПСБУОстатки.Счет.Вид КАК ВидСчета,
	|	&НовыйКПС КАК НовыйКПС,
	|	&УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	ИСТИНА КАК ИспользоватьСубконто1,
	|	ИСТИНА КАК ИспользоватьСубконто2,
	|	ЛОЖЬ КАК ИспользоватьСубконто3,
	|	ЖурналПроводокЕПСБУОстатки.Счет.Количественный КАК СчетКоличественный,
	|	ЖурналПроводокЕПСБУОстатки.Счет.Валютный КАК СчетВалютный,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ПериодЗапроса,
	|			Счет В
	|				(ВЫБРАТЬ
	|					УчетныеДанные.СчетУчета
	|				ИЗ
	|					УчетныеДанные КАК УчетныеДанные),
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &ОсновноеСредство
	|				И КФО = &КФО
	|				И КПС = &КПС) КАК ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеДанные КАК УчетныеДанные
	|		ПО ЖурналПроводокЕПСБУОстатки.Организация = УчетныеДанные.Организация
	|			И ЖурналПроводокЕПСБУОстатки.Субконто1 = УчетныеДанные.ОсновноеСредство
	|			И ЖурналПроводокЕПСБУОстатки.Счет = УчетныеДанные.СчетУчета
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУОстатки.Организация,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3,
	|	УчетныеДанные.ВидИмущества,
	|	ЖурналПроводокЕПСБУОстатки.Счет.Вид,
	|	ЖурналПроводокЕПСБУОстатки.Счет.Количественный,
	|	ЖурналПроводокЕПСБУОстатки.Счет.Валютный,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетАмортизации,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК СтарыйКПС,
	|	УчетныеДанные.ВидИмущества КАК ВидИмущества,
	|	&НовыйКПС КАК НовыйКПС,
	|	УчетныеДанные.СчетУчета КАК Счет,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт) КАК СуммаАмортизации,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			,
	|			Счет В (&Счет104),
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &ОсновноеСредство
	|				И КФО = &КФО
	|				И КПС = &КПС) КАК ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеДанные КАК УчетныеДанные
	|		ПО ЖурналПроводокЕПСБУОстатки.Организация = УчетныеДанные.Организация
	|			И ЖурналПроводокЕПСБУОстатки.Субконто1 = УчетныеДанные.ОсновноеСредство
	|			И ЖурналПроводокЕПСБУОстатки.Счет = УчетныеДанные.СчетАмортизации
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	УчетныеДанные.ВидИмущества,
	|	УчетныеДанные.СчетУчета,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ОстаткиОС = РезультатЗапроса[1].Выбрать();
	ОстаткиАморт = РезультатЗапроса[2].Выбрать();
	
	Результат = Ложь;
	
	Если ОстаткиОС.Количество() > 0 Тогда
		Результат = Истина;
		Пока ОстаткиОС.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Объект.Переводы.Добавить(), ОстаткиОС);
		КонецЦикла;
		Пока ОстаткиАморт.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Объект.ПереводАмортизации.Добавить(), ОстаткиАморт);
		КонецЦикла;
	КонецЕсли;
	
	ЗаполнениеИнтерфейснойТаблицыОС("Субконто1");
	
	Возврат Результат;
	
КонецФункции

