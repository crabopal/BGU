&НаКлиенте
Процедура ТаблицаОсновныеСредстваОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Объект.Переводы.НайтиСтроки(Новый Структура("Субконто1", ВыбранноеЗначение)).Количество() > 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Объект не добавлен'"),,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 уже выбран в документе'"),
				Строка(ВыбранноеЗначение)),
			БиблиотекаКартинок.Внимание48);
		Возврат;
	КонецЕсли;
	
	Если ДобавитьСтрокуПереносаОС(ВыбранноеЗначение) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Объект добавлен'"),,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 добавлен в документ'"),
				Строка(ВыбранноеЗначение)),
			БиблиотекаКартинок.Информация);
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Объект не добавлен'"),,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'По %1 нет остатков'"),
				Строка(ВыбранноеЗначение)),
			БиблиотекаКартинок.Внимание48);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОсновныеСредстваПередУдалением(Элемент, Отказ)
	
	МассивСтрокКУдалению = Новый Массив;
	
	Для Каждого ВыделеннаяСтрока Из Элемент.ВыделенныеСтроки Цикл
		
		ТекДанные = Элемент.ДанныеСтроки(ВыделеннаяСтрока);
		
		Если ТекДанные = Неопределено Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		МассивСтрокКУдалению.Добавить(ТекДанные);
		
	КонецЦикла;	
	
	Для Каждого ТекущиеДанные Из МассивСтрокКУдалению Цикл
		
		// требуется удалить данные из связанных таблиц
		СтрокиТабПереводы = Объект.Переводы.НайтиСтроки(Новый Структура("Субконто1", ТекущиеДанные.ОсновноеСредство));
		Для каждого ТекСтрока Из СтрокиТабПереводы Цикл
			Объект.Переводы.Удалить(ТекСтрока);
		КонецЦикла;
		
		СтрокиТабАмортизации = Объект.ПереводАмортизации.НайтиСтроки(Новый Структура("ОсновноеСредство", ТекущиеДанные.ОсновноеСредство));
		Для каждого ТекСтрока Из СтрокиТабАмортизации Цикл
			Объект.ПереводАмортизации.Удалить(ТекСтрока);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

