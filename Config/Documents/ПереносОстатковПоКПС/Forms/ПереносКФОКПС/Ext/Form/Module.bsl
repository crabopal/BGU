&НаКлиенте
Процедура Заполнить(Команда)
	
	ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(СчетПереноса) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Не заполнен счет переноса. Заполнение таблицы невозможно.'"));
		Возврат;
	КонецЕсли;
	
	Если Объект.Проведен Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Заполнение таблицы возможно только в непроведенном документе.'"));
		Возврат;
	КонецЕсли;
	Отказ = Ложь;
	
	Если ЕстьКПС Тогда
		Если НЕ ЗначениеЗаполнено(СтарыйКПС) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр("ru='Не заполнен старый КПС. Заполнение таблицы невозможно.'"));
			Возврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.КФО) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр("ru='Не заполнен старый КФО. Заполнение таблицы невозможно.'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() ИЛИ Модифицированность Тогда
		
		ТекстВопроса = НСтр("ru = 'Для выполнения данной операции необходимо записать документ.
			|Записать?'");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьЗавершение1", ЭтотОбъект,
				Новый Структура("ТекстВопроса", ТекстВопроса)),
			ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьФрагмент();
	
КонецПроцедуры

