	НовыйВидИмущества = Неопределено;
	ПоказатьВводЗначения(Новый ОписаниеОповещения("УстановитьВидИмуществаЗавершение", ЭтотОбъект,
		Новый Структура("ТекТаблица, ТекТаблицаФормы, НовыйВидИмущества",
		ТекТаблица, ТекТаблицаФормы, НовыйВидИмущества)),
		НовыйВидИмущества,Нстр("ru='Выберите вид имущества'"),Тип("ПеречислениеСсылка.ВидыИмущества"));
		
