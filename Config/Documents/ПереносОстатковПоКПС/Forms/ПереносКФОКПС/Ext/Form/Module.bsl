		Элементы.НадписьПроведение.Заголовок = (Нстр("ru = 'Чтобы изменить документ необходимо отменить проведение и повторно открыть документ.'"));
		Элементы.ГруппаПредупреждение.Видимость = Истина;
		ТолькоПросмотр = Истина;
	КонецЕсли;

КонецПроцедуры // УстановитьТолькоПросмотр()

