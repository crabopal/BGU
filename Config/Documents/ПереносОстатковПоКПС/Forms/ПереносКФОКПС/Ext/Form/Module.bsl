			|		ПО (ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка)
			|ГДЕ
			|	ЕПСБУ.Ссылка В(&ВыбранныеСчета)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ВремТаб.Ссылка КАК Счет,
			|	ВремТаб.УчетПоПодразделениям КАК УчетПоПодразделениям,
			|	ВремТаб.Валютный КАК Валютный,
			|	ВремТаб.Количественный КАК Количественный,
			|	НЕ ЕСТЬNULL(С1.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто1,
			|	НЕ ЕСТЬNULL(С2.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто2,
			|	НЕ ЕСТЬNULL(С3.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто3
			|ПОМЕСТИТЬ ВремТабСчетов
			|ИЗ
			|	ВремТаб КАК ВремТаб
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С1
			|		ПО ВремТаб.Ссылка = С1.Ссылка
			|			И (С1.НомерСтроки = 1)
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С2
			|		ПО ВремТаб.Ссылка = С2.Ссылка
			|			И (С2.НомерСтроки = 2)
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С3
			|		ПО ВремТаб.Ссылка = С3.Ссылка
			|			И (С3.НомерСтроки = 3)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЕПСБУОстатки.Организация КАК Организация,
			|	ЕПСБУОстатки.КФО КАК КФО,
			|	ЕПСБУОстатки.КПС КАК СтарыйКПС,
			|	ЕПСБУОстатки.Счет КАК Счет,
			|	ЕПСБУОстатки.КЭК КАК КЭК,
			|	ЕПСБУОстатки.Субконто1 КАК Субконто1,
			|	ЕПСБУОстатки.Субконто2 КАК Субконто2,
			|	ЕПСБУОстатки.Субконто3 КАК Субконто3,
			|	&БлокВыбрать,
			|	СУММА(ЕСТЬNULL(ЕПСБУОстатки.СуммаОстатокДт, 0)) КАК СуммаДт,
			|	СУММА(ЕСТЬNULL(ЕПСБУОстатки.СуммаОстатокКт, 0)) КАК СуммаКт,
			|	СУММА(ЕСТЬNULL(ЕПСБУОстатки.КоличествоОстатокДт, 0)) КАК КоличествоДт,
			|	СУММА(ЕСТЬNULL(ЕПСБУОстатки.КоличествоОстатокКт, 0)) КАК КоличествоКт,
			|	ЕПСБУОстатки.Счет.Вид КАК ВидСчета,
			|	ВремТабСчетов.УчетПоПодразделениям КАК УчетПоПодразделениям,
			|	ВремТабСчетов.ИспользоватьСубконто1 КАК ИспользоватьСубконто1,
			|	ВремТабСчетов.ИспользоватьСубконто2 КАК ИспользоватьСубконто2,
			|	ВремТабСчетов.ИспользоватьСубконто3 КАК ИспользоватьСубконто3,
			|	ВремТабСчетов.Количественный КАК СчетКоличественный,
			|	ВремТабСчетов.Валютный КАК СчетВалютный
			|ПОМЕСТИТЬ КонечнаяТаблица
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Дата,
			|			&БлокОтборПоСчету,
			|			,
			|			Организация = &Организация
			|				И КФО = &КФО
			|				И &БлокОтборОбщий) КАК ЕПСБУОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТабСчетов КАК ВремТабСчетов
			|		ПО ЕПСБУОстатки.Счет = ВремТабСчетов.Счет
			|ГДЕ
			|	&БлокГДЕ
			|
			|СГРУППИРОВАТЬ ПО
			|	ЕПСБУОстатки.Организация,
			|	ЕПСБУОстатки.КФО,
			|	ЕПСБУОстатки.КПС,
			|	ЕПСБУОстатки.Счет,
			|	ЕПСБУОстатки.КЭК,
			|	ЕПСБУОстатки.Субконто1,
			|	ЕПСБУОстатки.Субконто2,
			|	ЕПСБУОстатки.Субконто3,
			|	ЕПСБУОстатки.Счет.Вид,
			|	&БлокГруппировка,
			|	ВремТабСчетов.УчетПоПодразделениям,
			|	ВремТабСчетов.ИспользоватьСубконто1,
			|	ВремТабСчетов.ИспользоватьСубконто2,
			|	ВремТабСчетов.ИспользоватьСубконто3,
			|	ВремТабСчетов.Количественный,
			|	ВремТабСчетов.Валютный
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КонечнаяТаблица.Организация КАК Организация,
			|	КонечнаяТаблица.КФО КАК КФО,
			|	КонечнаяТаблица.СтарыйКПС КАК СтарыйКПС,
			|	КонечнаяТаблица.Счет КАК Счет,
			|	КонечнаяТаблица.КЭК КАК КЭК,
			|	КонечнаяТаблица.Субконто1 КАК Субконто1,
			|	КонечнаяТаблица.Субконто2 КАК Субконто2,
			|	КонечнаяТаблица.Субконто3 КАК Субконто3,
			|	ВЫБОР
			|		КОГДА КонечнаяТаблица.Счет В (&Счет21)
			|			ТОГДА ЕСТЬNULL(УчетныеДанныеОбъектаОССрезПоследних.ВидИмущества, ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ПустаяСсылка))
			|		ИНАЧЕ """"
			|	КОНЕЦ КАК ВидИмущества,
			|	&ПоляВалютногоУчета КАК ПоляВалютногоУчета,
			|	&ПолеПодразделения КАК ПолеПодразделения,
			|	КонечнаяТаблица.СуммаДт КАК СуммаДт,
			|	КонечнаяТаблица.СуммаКт КАК СуммаКт,
			|	КонечнаяТаблица.КоличествоДт КАК КоличествоДт,
			|	КонечнаяТаблица.КоличествоКт КАК КоличествоКт,
			|	КонечнаяТаблица.ВидСчета КАК ВидСчета,
			|	КонечнаяТаблица.УчетПоПодразделениям КАК УчетПоПодразделениям,
			|	КонечнаяТаблица.ИспользоватьСубконто1 КАК ИспользоватьСубконто1,
			|	КонечнаяТаблица.ИспользоватьСубконто2 КАК ИспользоватьСубконто2,
			|	КонечнаяТаблица.ИспользоватьСубконто3 КАК ИспользоватьСубконто3,
			|	КонечнаяТаблица.СчетКоличественный КАК СчетКоличественный,
			|	КонечнаяТаблица.СчетВалютный КАК СчетВалютный
			|ИЗ
			|	КонечнаяТаблица КАК КонечнаяТаблица
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
			|				&ДатаРС,
			|				Организация = &Организация
			|					И ОсновноеСредство В
			|						(ВЫБРАТЬ
			|							КонечнаяТаблица.Субконто1
			|						ИЗ
			|							КонечнаяТаблица КАК КонечнаяТаблица)
			|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.НаБалансе)) КАК УчетныеДанныеОбъектаОССрезПоследних
			|		ПО КонечнаяТаблица.Субконто1 = УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство
			|
			|УПОРЯДОЧИТЬ ПО
			|	КонечнаяТаблица.Счет,
			|	КонечнаяТаблица.Субконто1,
			|	КонечнаяТаблица.Субконто2,
			|	КонечнаяТаблица.Субконто3";
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПоляВалютногоУчета КАК ПоляВалютногоУчета,",
				?(ВалютныйУчет, "КонечнаяТаблица.Валюта, КонечнаяТаблица.ВалютнаяСуммаДт, КонечнаяТаблица.ВалютнаяСуммаКт,",""));
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПодразделения КАК ПолеПодразделения,",
				?(УчетПоПодразделениям, "КонечнаяТаблица.Подразделение,",""));
			
		КонецЕсли;
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&БлокВыбрать,",БлокВыбрать);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&БлокОтборПоСчету",БлокОтборПоСчету);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&БлокОтборОбщий",БлокОтбор);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&БлокГруппировка,",БлокГруппировка);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&БлокГДЕ",БлокГДЕ);
	
	// Исправлено 22.06
	//ГраницаПериода = БухгалтерскийУчет.КонецПериодаСУточнением(Объект.Дата, Объект.ВидМежотчетногоПериода); 
	ГраницаПериода = Новый Граница(КонецДня(Объект.Дата) + 1, ВидГраницы.Исключая);
	
	Запрос.УстановитьПараметр("СоответствиеКПС"	, Объект.СоответствиеКПС.Выгрузить());
	Запрос.УстановитьПараметр("ДатаРС"			, Объект.Дата);
	Запрос.УстановитьПараметр("Дата"			, ГраницаПериода);
	Запрос.УстановитьПараметр("Организация"		, Объект.Организация);
	Запрос.УстановитьПараметр("КФО"				, Объект.КФО);
	Запрос.УстановитьПараметр("КПС"				, Объект.СоответствиеКПС.Выгрузить().ВыгрузитьКолонку("СтарыйКПС"));
	Запрос.УстановитьПараметр("ВыбранныеСчета"	, ВыбранныеСчета);
	Запрос.УстановитьПараметр("ИФО"				, Объект.ИФО);
	Запрос.УстановитьПараметр("Подразделение"	, Объект.Подразделение);
	Запрос.УстановитьПараметр("Счет21"			, БухгалтерскийУчет.СписокСчетов("21"));
	Запрос.УстановитьПараметр("ВидИмущества"	, ВидИмуществаТекущий);
	Запрос.УстановитьПараметр("Счет104"			, БухгалтерскийУчет.СписокСчетов("104.00"));
	
	Запрос.Текст = ТекстЗапроса;
	
	Если Объект.ВидОперацииПриИзмененииТипа<>1 Тогда
		Результат = Запрос.Выполнить().Выбрать();
		Пока Результат.Следующий() Цикл
			СтрокаТЧ =  Объект.Переводы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ,Результат);
		КонецЦикла;
	Иначе
		Результаты = Запрос.ВыполнитьПакет();
		ПолеОС = "Субконто1";
		Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетПереноса)["ВидСубконто1"] = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
			ПолеОС = "Субконто1";
		ИначеЕсли БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетПереноса)["ВидСубконто2"] = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
			ПолеОС = "Субконто2";
		ИначеЕсли БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетПереноса)["ВидСубконто3"] = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
			ПолеОС = "Субконто3";
		КонецЕсли;
		
		ТекОС = Неопределено;
		ТекПодразделение = Неопределено;
		Результат = Результаты[6].Выбрать();// выбор данных для ТЧ переводы
		Пока Результат.Следующий() Цикл
			СтрокаТЧ =  Объект.Переводы.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаТЧ,Результат);
			
		КонецЦикла;
		
		РезультатАмортизации = Результаты[7].Выбрать();
		Пока РезультатАмортизации.Следующий() Цикл
			СтрокаТЧ =  Объект.ПереводАмортизации.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ,РезультатАмортизации);
		КонецЦикла;
	КонецЕсли;
	
	Если Объект.ВидОперацииПриИзмененииТипа = 0 Тогда
		//Это МЗ
		ЗаполнениеИнтерфейснойТаблицыМЗ();
	ИначеЕсли Объект.ВидОперацииПриИзмененииТипа = 1 Тогда
		//Это ОС
		ЗаполнениеИнтерфейснойТаблицыОС(ПолеОС);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеИнтерфейснойТаблицыМЗ()
	
	ТаблицаНоменклатуры.Очистить();
	СтруктураПоиска = Новый Структура;
	Для Каждого СтрТЧ Из Объект.Переводы Цикл
		СтруктураПоиска.Вставить("Номенклатура",СтрТЧ.Субконто1);
		СтруктураПоиска.Вставить("СтарыйКПС",СтрТЧ.СтарыйКПС);
		СтруктураПоиска.Вставить("НовыйКПС",СтрТЧ.НовыйКПС);
		
		Строки = ТаблицаНоменклатуры.НайтиСтроки(СтруктураПоиска);
		
		Если Строки.Количество()>0 Тогда
			ТекСтр = Строки[0];
		Иначе
			ТекСтр = ТаблицаНоменклатуры.Добавить();
			ЗаполнитьЗначенияСвойств(ТекСтр,СтруктураПоиска);
			ТекСтр.ВидИмущества = СтрТЧ.ВидИмущества;
		КонецЕсли;
		ТекСтр.Сумма = ТекСтр.Сумма + СтрТЧ.СуммаДт;
		ТекСтр.Количество = ТекСтр.Количество + СтрТЧ.КоличествоДт;
	КонецЦикла;	
	РассчитатьИтогиТаблицыНоменклатуры();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуОС()
	ПолеОС = "Субконто1";
	Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетПереноса)["ВидСубконто1"]
		= ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
		ПолеОС = "Субконто1";
	ИначеЕсли БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетПереноса)["ВидСубконто2"]
		= ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
		ПолеОС = "Субконто2";
	ИначеЕсли БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетПереноса)["ВидСубконто3"]
		= ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
		ПолеОС = "Субконто3";
	КонецЕсли;
	ЗаполнениеИнтерфейснойТаблицыОС(ПолеОС);
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеИнтерфейснойТаблицыОС(ПолеОС)
	
	ТаблицаОсновныеСредства.Очистить();
	СтруктураПоиска = Новый Структура;
	Для Каждого СтрТЧ Из Объект.Переводы Цикл
		СтруктураПоиска.Вставить("ОсновноеСредство",СтрТЧ[ПолеОС]);
		
		Строки = ТаблицаОсновныеСредства.НайтиСтроки(СтруктураПоиска);
		
		Если Строки.Количество()>0 Тогда
			ТекСтр = Строки[0];
		Иначе
			ТекСтр = ТаблицаОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(ТекСтр,СтруктураПоиска);
			ТекСтр.ВидИмущества = СтрТЧ.ВидИмущества;
		КонецЕсли;
		ТекСтр.Сумма = ТекСтр.Сумма + СтрТЧ.СуммаДт;
		ТекСтр.Количество = ТекСтр.Количество + СтрТЧ.КоличествоДт;
	КонецЦикла;
	Для Каждого СтрТЧ Из Объект.ПереводАмортизации Цикл
		СтруктураПоиска.Вставить("ОсновноеСредство",СтрТЧ.ОсновноеСредство);
		Строки = ТаблицаОсновныеСредства.НайтиСтроки(СтруктураПоиска);
		
		Если Строки.Количество()>0 Тогда
			ТекСтр = Строки[0];
		Иначе
			ТекСтр = ТаблицаОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(ТекСтр,СтруктураПоиска);
		КонецЕсли;
		СчетСтрокой = Строка(СтрТЧ.СчетАмортизации);
		Если Найти(ТекСтр.СчетАмортизации,СчетСтрокой)=0 Тогда
			ТекСтр.СчетАмортизации = ТекСтр.СчетАмортизации 
				+ ?(СтрДлина(ТекСтр.СчетАмортизации)=0,"",", ")+СчетСтрокой;
		КонецЕсли;
		ТекСтр.СуммаАмортизации = ТекСтр.СуммаАмортизации + СтрТЧ.СуммаАмортизации;
	КонецЦикла;
	
	РассчитатьИтогиТаблицыОС();
КонецПроцедуры

&НаСервере
Процедура НастройкаВидимостиСубконто()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУ.Валютный,
		|	ЕПСБУВидыСубконто.ВидСубконто,
		|	ЕПСБУВидыСубконто.НомерСтроки,
		|	ЕПСБУВидыСубконто.ТолькоОбороты,
		|	ЕПСБУ.Ссылка,
		|	ЕПСБУВидыСубконто.ВидСубконто.Наименование КАК Наименование
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ПО (ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка)
		|ГДЕ
		|	ЕПСБУ.Ссылка В(&ВыбранныеСчета)";

	Запрос.УстановитьПараметр("ВыбранныеСчета", Объект.Счета.Выгрузить().ВыгрузитьКолонку("Счет"));

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	ВидимостьВалют = Ложь;
	ВидимостьСубконто = Новый Массив(3);
	ВидимостьСубконто[0] = Ложь;
	ВидимостьСубконто[1] = Ложь;
	ВидимостьСубконто[2] = Ложь;
	
	НаименованиеСубконто = Новый Массив(3);
	НаименованиеСубконто[0] = "";
	НаименованиеСубконто[1] = "";
	НаименованиеСубконто[2] = "";
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ВидимостьВалют = ВидимостьВалют ИЛИ ВыборкаДетальныеЗаписи.Валютный;
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.НомерСтроки) Тогда
			ВидимостьСубконто[ВыборкаДетальныеЗаписи.НомерСтроки-1] =
				ВидимостьСубконто[ВыборкаДетальныеЗаписи.НомерСтроки-1] ИЛИ НЕ ВыборкаДетальныеЗаписи.ТолькоОбороты;
			Если НЕ ВыборкаДетальныеЗаписи.ТолькоОбороты Тогда
				ТекНаименование = НаименованиеСубконто[ВыборкаДетальныеЗаписи.НомерСтроки-1];
				НаименованиеСубконто[ВыборкаДетальныеЗаписи.НомерСтроки-1] =
					?(ЗначениеЗаполнено(ТекНаименование) И ТекНаименование <> ВыборкаДетальныеЗаписи.Наименование,
						"Субконто"+ВыборкаДетальныеЗаписи.НомерСтроки,
						ВыборкаДетальныеЗаписи.Наименование);
			КонецЕсли;
		КонецЕсли; 
	КонецЦикла;
	
	Элементы.ПереводыВалюта.Видимость = ВидимостьВалют;
	Элементы.ПереводыВалютнаяСумма.Видимость = ВидимостьВалют;
    Элементы.ПереводыВалютнаяСуммаДт.Видимость = ВидимостьВалют;
	Элементы.ПереводыВалютнаяСуммаКт.Видимость = ВидимостьВалют;
	
	Для Инд = 1 По 3 Цикл	
		Элементы["ПереводыСубконто"+Инд].Видимость = ВидимостьСубконто[Инд-1];
		Элементы["ПереводыСубконто"+Инд].Заголовок = ?(ЗначениеЗаполнено(НаименованиеСубконто[Инд-1]),
			НаименованиеСубконто[Инд-1],"Субконто"+Инд);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСоответствиеКПСПоВариантуПереноса(ОбъектДляЗаполнения)
	Если ОбъектДляЗаполнения.ВариантПереноса = 0 Тогда
		ОбъектДляЗаполнения.СоответствиеКПС.Очистить();
		НовСтр = ОбъектДляЗаполнения.СоответствиеКПС.Добавить();
		НовСтр.СтарыйКПС = СтарыйКПС;
		НовСтр.НовыйКПС = НовыйКПС;
	ИначеЕсли ОбъектДляЗаполнения.ВариантПереноса = 1 Тогда
		Для Каждого СтрТЧ Из Объект.СоответствиеКПС Цикл
			СтрТЧ.НовыйКПС = НовыйКПС;
		КонецЦикла;
	ИначеЕсли ОбъектДляЗаполнения.ВариантПереноса = 2 Тогда
		Для Каждого СтрТЧ Из Объект.СоответствиеКПС Цикл
			СтрТЧ.СтарыйКПС = СтарыйКПС;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЭлементыФормыКПС()
	Если Объект.СоответствиеКПС.Количество()>0 Тогда
		Если Объект.ВариантПереноса = 0
			ИЛИ Объект.ВариантПереноса = 1 Тогда
			НовыйКПС = Объект.СоответствиеКПС[0].НовыйКПС;
		КонецЕсли;
		Если Объект.ВариантПереноса = 0
			ИЛИ Объект.ВариантПереноса = 2 Тогда
			СтарыйКПС = Объект.СоответствиеКПС[0].СтарыйКПС;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьСоответсвиеКПСДляВыбора()
	СоответсвиеКПСДляВыбора = Новый Соответствие;
	Для Каждого СтрТч Из Объект.СоответствиеКПС Цикл
		Если Не ЗначениеЗаполнено(СтрТч.СтарыйКПС) Тогда 
			Продолжить;
		КонецЕсли;
		
		ВыбранныйМассив = СоответсвиеКПСДляВыбора.Получить(СтрТч.СтарыйКПС);
		Если ВыбранныйМассив = Неопределено Тогда
			ВыбранныйМассив = Новый Массив;
			ВыбранныйМассив.Добавить(СтрТч.НовыйКПС);
		Иначе
			Если ВыбранныйМассив.Найти(СтрТч.НовыйКПС) = Неопределено Тогда
				ВыбранныйМассив.Добавить(СтрТч.НовыйКПС);
			КонецЕсли;
		КонецЕсли;
		СоответсвиеКПСДляВыбора.Вставить(СтрТч.СтарыйКПС,ВыбранныйМассив);
	КонецЦикла;
	ФиксСоответсвиеКПСДляВыбора = Новый ФиксированноеСоответствие(СоответсвиеКПСДляВыбора);
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСчета()
	
	Объект.Счета.Очистить();
	Объект.Переводы.Очистить();
	Объект.ПереводАмортизации.Очистить();
	
	ТаблицаНоменклатуры.Очистить();
	ТаблицаОсновныеСредства.Очистить();
	
	Если ЗначениеЗаполнено(СчетПереноса) Тогда
		НовСчет = Объект.Счета.Добавить();
		НовСчет.Счет = СчетПереноса;
	КонецЕсли;
	
	ЕстьКПС = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетПереноса).УчетПоКПС;
	Если НЕ ЕстьКПС Тогда
		Объект.Распределять = Ложь;
		Объект.ОкруглятьКоличество = Ложь;
		Объект.СоответствиеКПС.Очистить();
		НовыйКПС = Неопределено;
		СтарыйКПС = Неопределено;
	КонецЕсли;
	
	Элементы.СтарыйКПС1.Доступность = ЕстьКПС;
	Элементы.НовыйКПС1.Доступность = ЕстьКПС;
	Элементы.СтарыйКПС1.АвтоОтметкаНезаполненного = ЕстьКПС;
	Элементы.НовыйКПС1.АвтоОтметкаНезаполненного = ЕстьКПС;
	
	Элементы.ПереводыВидИмущества.Видимость = Ложь;
	
	ЭтоЗабаланс = Объект.ВидОперацииПриИзмененииТипа = 3
		И БухгалтерскийУчет.СчетВИерархии(СчетПереноса, "21");
	ЭтоМЗ = Объект.ВидОперацииПриИзмененииТипа = 0;
	ЭтоОС = Объект.ВидОперацииПриИзмененииТипа = 1;
	
	Если (ЭтоЗабаланс) ИЛИ ЭтоМЗ ИЛИ ЭтоОС Тогда
		Элементы.ПереводыВидИмущества.Видимость = Истина;
	Иначе
		Элементы.ПереводыВидИмущества.Видимость = Ложь;
	КонецЕсли;
	Элементы.ПереводыУстановитьВидИмущества.Видимость = Элементы.ПереводыВидИмущества.Видимость;
	
	ВидИмуществаТекущий = Перечисления.ВидыИмущества.ПустаяСсылка();
	Если ЗначениеЗаполнено(СчетПереноса) Тогда
		ВидИмуществаТекущий = УправлениеОсновнымиСредствамиПовтИсп.ВидИмуществаПоСчетуУчета(СчетПереноса);
	КонецЕсли;
	
	ВидимостьПолейВкладкиСлужебныеСчета();
	
	УстановитьВидимостьКоличества(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВидаОперации()
	
	Объект.Счета.Очистить();
	Объект.Переводы.Очистить();
	Объект.ПереводАмортизации.Очистить();
	ТаблицаНоменклатуры.Очистить();
	ТаблицаОсновныеСредства.Очистить();
	
	УстановитьВидимостьРеквизитовПоВидуОперации();
	
	ВидимостьПолейВкладкиСлужебныеСчета();
	ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьСтруктуруРПС()
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		СтруктураРПС_Старая = БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(
			Объект.Организация,?(УчетПоИФО,Объект.ИФО,Неопределено),Объект.Дата);
		ТПС_Старый = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураРПС_Старая,"ТипПланаСчетов");
		
		СтруктураРПС_Новая = БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(
			Объект.Организация,?(УчетПоИФО,Объект.ИФО,Неопределено),КонецМесяца(Объект.Дата)+1);
		ТПС_Новый = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураРПС_Новая,"ТипПланаСчетов");
	Иначе
		СтруктураРПС_Старая = Справочники.СтруктурыРПС.ПустаяСсылка();
		ТПС_Старый = Перечисления.ТипыПлановСчетов.ПустаяСсылка();
		СтруктураРПС_Новая          = Справочники.СтруктурыРПС.ПустаяСсылка();
		ТПС_Новый                   = Перечисления.ТипыПлановСчетов.ПустаяСсылка();
	КонецЕсли;
	
	Если СтруктураРПС_Старая = СтруктураРПС_Новая Тогда
		Элементы.ИнформационнаяНадпись.Видимость = Истина;
		Элементы.ИнформационнаяНадпись.Заголовок = Нстр("ru='Структура рабочего плана счетов не изменилась'");
	Иначе
		Элементы.ИнформационнаяНадпись.Видимость = Ложь;
		Элементы.ИнформационнаяНадпись.Заголовок = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТПС_Старый) Тогда
		Элементы.СтруктураРПС.Заголовок = НСтр("ru='Старый тип плана счетов """ + СокрП(ТПС_Старый)+"""'");
	Иначе
		Элементы.СтруктураРПС.Заголовок = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТПС_Новый) Тогда
		Элементы.СтруктураРПСНовая.Заголовок = НСтр("ru='Новый тип плана счетов """ + СокрП(ТПС_Новый)+"""'");
	Иначе
		Элементы.СтруктураРПСНовая.Заголовок = "";
	КонецЕсли;
	
	Если ТПС_Старый = ТПС_Новый И Объект.КФО = Объект.КФОНовый Тогда
		Элементы.СлужебныеСчета.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииОрганизации()
	
	Объект.Переводы.Очистить();
	Объект.ПереводАмортизации.Очистить();
	ТаблицаНоменклатуры.Очистить();
	ТаблицаОсновныеСредства.Очистить();
	ПолучитьСтруктуруРПС();
	ВидимостьПолейВкладкиСлужебныеСчета();
	
КонецПроцедуры

&НаСервере
Процедура ВидимостьПолейВкладкиСлужебныеСчета()
	
	Если ТПС_Старый = ТПС_Новый И Объект.КФО = Объект.КФОНовый Тогда
		Возврат;	
	КонецЕсли;
	
	Если Объект.ВидОперацииПриИзмененииТипа = 0 Тогда
		//МЗ
		ЕстьРасчеты = Ложь;
		Если Объект.КФОНовый = Перечисления.КВД.Бюджет ИЛИ Объект.КФО = Перечисления.КВД.Бюджет Тогда
			Элементы.ФормироватьРасчетыСУчредителем.Видимость = Истина;
			ЕстьРасчеты = Истина;
		Иначе
			Элементы.ФормироватьРасчетыСУчредителем.Видимость = Ложь;
		КонецЕсли;
		
		Элементы.ГруппаРасчСУчр.Видимость = Ложь;
		Элементы.ГруппаРасчСУчрНовый.Видимость = Ложь;
		
		Если ЕстьРасчеты Тогда
			Если (ТПС_Новый <> Перечисления.ТипыПлановСчетов.ДляКазенных)
				И (Объект.КФОНовый = Перечисления.КВД.БюджетныеИнвестиции
					ИЛИ Объект.КФОНовый = Перечисления.КВД.СубсидииНаГосзадание
					ИЛИ Объект.КФОНовый = Перечисления.КВД.СубсидииНаИныеЦели) Тогда
				
				Элементы.ГруппаРасчСУчрНовый.Видимость = Истина;
		
			КонецЕсли;
			Если ТПС_Старый <> Перечисления.ТипыПлановСчетов.ДляКазенных
				И (Объект.КФО = Перечисления.КВД.БюджетныеИнвестиции
					ИЛИ Объект.КФО = Перечисления.КВД.СубсидииНаГосзадание 
					ИЛИ Объект.КФО = Перечисления.КВД.СубсидииНаИныеЦели) Тогда
				
				Элементы.ГруппаРасчСУчр.Видимость = Истина;
				
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Объект.ВидОперацииПриИзмененииТипа = 1 Тогда
		//ОС
		ВидимостьКФО2Новый = Ложь;
		ВидимостьКФО2Старый = Ложь;
		Если (Объект.КФОНовый = Перечисления.КВД.Внебюджет  И Объект.КФО =  Перечисления.КВД.Внебюджет) Тогда
			Если (ТПС_Старый = Перечисления.ТипыПлановСчетов.ДляКазенных)  Тогда
				ВидимостьКФО2Новый = Истина;
			КонецЕсли;
			Если (ТПС_Новый = Перечисления.ТипыПлановСчетов.ДляКазенных)  Тогда
				ВидимостьКФО2Старый = Истина;
			КонецЕсли;
		Конецесли;
		ЕстьРасчеты = Ложь;
		Если ЗначениеЗаполнено(СчетПереноса) Тогда
			Если БухгалтерскийУчет.СчетВИерархии(СчетПереноса, "106.00,107.00") Тогда
				ЕстьРасчеты = Ложь;
			Иначе
				ЕстьРасчеты = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ЕстьРасчеты Тогда
			Элементы.ГруппаРасчСУчрНовый_ОС.Видимость = Ложь;
			Если ТПС_Новый <> Перечисления.ТипыПлановСчетов.ДляКазенных Тогда
				Элементы.РасчетыСУчредителемПо2_Новый.Видимость = ВидимостьКФО2Новый;
				Если (Объект.КФОНовый = Перечисления.КВД.БюджетныеИнвестиции
					ИЛИ Объект.КФОНовый = Перечисления.КВД.СубсидииНаГосзадание
					ИЛИ Объект.КФОНовый = Перечисления.КВД.СубсидииНаИныеЦели)
					ИЛИ Объект.РасчетыСУчредителемПо2_Новый Тогда
					Элементы.ГруппаРасчСУчрНовый_ОС.Видимость = Истина;
					Элементы.ДополнительныйКПСНовыйОС.АвтоОтметкаНезаполненного  = Ложь;
					Элементы.ДополнительныйСчетНовыйОС.АвтоОтметкаНезаполненного = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			Элементы.ГруппаРасчСУчр_ОС.Видимость = Ложь;
			
			Если ТПС_Старый <> Перечисления.ТипыПлановСчетов.ДляКазенных  Тогда
				Элементы.РасчетыСУчредителемПо2_Старый.Видимость = ВидимостьКФО2Старый;
				Если (Объект.КФО = Перечисления.КВД.БюджетныеИнвестиции
					ИЛИ Объект.КФО = Перечисления.КВД.СубсидииНаГосзадание
					ИЛИ Объект.КФО = Перечисления.КВД.СубсидииНаИныеЦели)
					ИЛИ Объект.РасчетыСУчредителемПо2_Старый Тогда
					Элементы.ГруппаРасчСУчр_ОС.Видимость = Истина;
					Элементы.ДополнительныйКПСОС.АвтоОтметкаНезаполненного  = Ложь;
					Элементы.ДополнительныйСчетОС.АвтоОтметкаНезаполненного = Ложь;
				КонецЕсли;
			КонецЕсли;
			Элементы.ТаблицаОсновныеСредстваКоличество.АвтоОтметкаНезаполненного   = Истина;
		Иначе
			Элементы.РасчетыСУчредителемПо2_Новый.Видимость                 = Ложь;
			Элементы.РасчетыСУчредителемПо2_Старый.Видимость                = Ложь;
			Элементы.ГруппаРасчСУчрНовый_ОС.Видимость                       = Ложь;
			Элементы.ГруппаРасчСУчр_ОС.Видимость                     		= Ложь;
			Элементы.ТаблицаОсновныеСредстваКоличество.АвтоОтметкаНезаполненного = Ложь;
		КонецЕсли;

		
	ИначеЕсли Объект.ВидОперацииПриИзмененииТипа = 2 Тогда
		//Расчеты
		
		Видимость30305Старый = Ложь;
		Видимость30305Новый  = Ложь;
		Если ЗначениеЗаполнено(СчетПереноса) Тогда
			Если БухгалтерскийУчет.СчетВИерархии(СчетПереноса, "205.00,209.00,303.00") Тогда
				Если ТПС_Старый = Перечисления.ТипыПлановСчетов.ДляКазенных Тогда
					Если (ТПС_Новый <> ТПС_Старый) И (Объект.КФО = Перечисления.КВД.Бюджет) Тогда
						Видимость30305Новый = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Элементы.ГруппаРасчСУчрНовый_Расчеты.Видимость = Видимость30305Новый;
		
	КонецЕсли;
КонецПроцедуры

