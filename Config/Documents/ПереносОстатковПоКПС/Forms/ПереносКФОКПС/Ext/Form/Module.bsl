&НаСервере
Процедура ПереносДанныхИнтерфейснойТаблицыВДокумент(ТекОбъект)
	МассивКУдалению = Новый Массив;
	
	СтруктураПоиска = Новый Структура;
	
	Если Объект.ВидОперацииПриИзмененииТипа = 0 Тогда
		Для Каждого СтрТЧ Из ТекОбъект.Переводы Цикл
			СтруктураПоиска.Вставить("Номенклатура",СтрТЧ.Субконто1);
			СтруктураПоиска.Вставить("СтарыйКПС",СтрТЧ.СтарыйКПС);
			
			Строки = ТаблицаНоменклатуры.НайтиСтроки(СтруктураПоиска);
			
			Если Строки.Количество()>0 Тогда
				ТекСтр = Строки[0];
			Иначе
				МассивКУдалению.Добавить(СтрТЧ);
				Продолжить;
			КонецЕсли;
			СтрТЧ.НовыйКПС = ТекСтр.НовыйКПС;
			СтрТЧ.ВидИмущества = ТекСтр.ВидИмущества;
		КонецЦикла;	
	ИначеЕсли Объект.ВидОперацииПриИзмененииТипа = 1 Тогда
		ПолеОС = "Субконто1";
		Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетПереноса)["ВидСубконто1"]
			= ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
			ПолеОС = "Субконто1";
		ИначеЕсли БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетПереноса)["ВидСубконто2"]
			= ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
			ПолеОС = "Субконто2";
		ИначеЕсли БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетПереноса)["ВидСубконто3"]
			= ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
			ПолеОС = "Субконто3";
		КонецЕсли;
		Для Каждого СтрТЧ Из ТекОбъект.Переводы Цикл
			СтруктураПоиска.Вставить("ОсновноеСредство",СтрТЧ[ПолеОС]);
			
			Строки = ТаблицаОсновныеСредства.НайтиСтроки(СтруктураПоиска);
			
			Если Строки.Количество()>0 Тогда
				ТекСтр = Строки[0];
			Иначе
				МассивКУдалению.Добавить(СтрТЧ);
				Продолжить;
			КонецЕсли;
			СтрТЧ.ВидИмущества = ТекСтр.ВидИмущества;
		КонецЦикла;
		МассивКУдалениюАмортизация = Новый Массив;
		Для Каждого СтрТЧ Из ТекОбъект.ПереводАмортизации Цикл
			СтруктураПоиска.Вставить("ОсновноеСредство",СтрТЧ.ОсновноеСредство);
			Строки = ТаблицаОсновныеСредства.НайтиСтроки(СтруктураПоиска);
			Если Строки.Количество()>0 Тогда
				ТекСтр = Строки[0];
			Иначе
				МассивКУдалениюАмортизация.Добавить(СтрТЧ);
				Продолжить;
			КонецЕсли;
			СтрТЧ.ВидИмущества = ТекСтр.ВидИмущества;
		КонецЦикла;
		Для Каждого ЭлМас Из МассивКУдалениюАмортизация Цикл
			ТекОбъект.ПереводАмортизации.Удалить(ЭлМас);	
		КонецЦикла;
	КонецЕсли;
	Для Каждого ЭлМас Из МассивКУдалению Цикл
		ТекОбъект.Переводы.Удалить(ЭлМас);	
	КонецЦикла;
	
КонецПроцедуры

