&НаКлиенте
Процедура Заполнить(Команда)
	
	ОчиститьСообщения();
	
	Если Объект.Проведен Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Заполнение таблицы возможно только в непроведенном документе.'"));
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ПроверитьПоВариантуПереноса(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьНовыйОбъектВФорме(Новый ОписаниеОповещения("ЗаполнитьТЧНаКлиенте", ЭтотОбъект));
	
