			ПараметрыФормы.Вставить("Контрагент", ДанныеСтроки["Субконто" + НомерСубконто]);
		ИначеЕсли ТипЗнч(ДанныеСтроки["Субконто" + НомерСубконто]) = Тип("СправочникСсылка.Договоры") Тогда
			ПараметрыФормы.Вставить("Договор", ДанныеСтроки["Субконто" + НомерСубконто]);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы.Вставить("НомерСтроки", ДанныеСтроки.НомерСтроки);
	ПараметрыФормы.Вставить("ИдентификаторСтроки", ДанныеСтроки.ИдентификаторСтроки);
	ПараметрыФормы.Вставить("СчетРасчетов", ДанныеСтроки.Счет);
