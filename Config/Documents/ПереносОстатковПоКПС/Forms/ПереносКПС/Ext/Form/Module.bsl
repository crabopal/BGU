	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	Отбор = Новый Структура("ИдентификаторСтроки", ДанныеСтроки.ИдентификаторСтроки);
	ГрафикИсполнения = Объект.ГрафикИсполнения.Выгрузить(Отбор);
	ПараметрыФормы.Вставить("ГрафикИсполнения", ПоместитьВоВременноеХранилище(ГрафикИсполнения));
	
