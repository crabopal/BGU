#Область ЗаполнениеТаблицыПереводы

&НаКлиенте
Процедура ЗаписатьНовыйОбъектВФорме(Знач Оповещение)
	
	Если Объект.Ссылка.Пустая() ИЛИ Модифицированность Тогда
		
		ТекстВопроса = НСтр("ru = 'Для выполнения данной операции необходимо записать документ. Записать?'");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаписатьНовыйОбъектВФормеЗавершение", ЭтотОбъект, Новый Структура("Оповещение", Оповещение)), ТекстВопроса,РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ВыполнитьОбработкуОповещения(Оповещение, Истина);
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНовыйОбъектВФормеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Оповещение = ДополнительныеПараметры.Оповещение;
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		
		ДокументЗаписан = Ложь;
		
	Иначе
		
		ДокументЗаписан = Записать();
		
		
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(Оповещение, ДокументЗаписан);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТЧНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
    
    Если НЕ Результат Тогда
        Возврат;
    КонецЕсли;
    
    Модифицированность = Истина;
    
    Если Объект.Переводы.Количество() > 0 Тогда
        
        ТекстВопроса = НСтр("ru='Перед заполнением табличная часть будет очищена. Заполнить?'");
        
        ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьТЧНаКлиентеЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,);
        
        Возврат;
        
    КонецЕсли;
    
    ЗаполнитьТЧНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТЧНаКлиентеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
        Возврат;
	КонецЕсли; 
	
    Объект.Переводы.Очистить();
    
    ЗаполнитьТЧНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧНаСервере()
	
	ЗаполнитьСоответствиеКПСПоВариантуПереноса(Объект);
	ЗаполнитьСоответсвиеКПСДляВыбора();
	
	БлокВыбрать = "";
	БлокОтбор = "";
	БлокОтборПоСчету = "Счет В (&ВыбранныеСчета)";
	БлокГруппировка = "";
	ВыбранныеСчета = Объект.Счета.Выгрузить().ВыгрузитьКолонку("Счет");
	БлокГДЕ = "";
	Если ВыбранныеСчета.Количество() = 1 Тогда
		БлокОтборПоСчету = "Счет = &ВыбранныеСчета";
		ВыбранныеСчета = ВыбранныеСчета[0];
	КонецЕсли;
	
	Если УчетПоИФО Тогда
		БлокГруппировка = БлокГруппировка + " ЕПСБУОстатки.ИФО, ";
		БлокОтбор = БлокОтбор + " ИФО = &ИФО ";
	КонецЕсли;
	
	Если УчетПоПодразделениям Тогда
		ТекстПоляПодразделение = "	ВЫБОР КОГДА ВремТабСчетов.УчетПоПодразделениям ТОГДА ЕстьNull(ЕПСБУОстатки.Подразделение,Значение(Справочник.Подразделения.ПустаяСсылка)) ИНАЧЕ Значение(Справочник.Подразделения.ПустаяСсылка) КОНЕЦ ";
		Если Объект.ОтборПоПодразделению Тогда
			БлокГДЕ = ТекстПоляПодразделение +"=&Подразделение";
		КонецЕсли;
		БлокГруппировка = БлокГруппировка+ ТекстПоляПодразделение +", ";
		БлокВыбрать = БлокВыбрать + ТекстПоляПодразделение + " КАК ПОДРАЗДЕЛЕНИЕ,
		|";
	КонецЕсли;
	
	Если ВалютныйУчет Тогда
		БлокГруппировка = БлокГруппировка+ " ВЫБОР КОГДА ВремТабСчетов.Валютный ТОГДА ЕПСБУОстатки.Валюта ИНАЧЕ Значение(Справочник.Валюты.ПустаяСсылка) КОНЕЦ, ";
		БлокВыбрать = БлокВыбрать + "	ВЫБОР КОГДА ВремТабСчетов.Валютный ТОГДА ЕПСБУОстатки.Валюта ИНАЧЕ Значение(Справочник.Валюты.ПустаяСсылка) КОНЕЦ КАК Валюта,
		|	СУММА(ВЫБОР КОГДА ВремТабСчетов.Валютный ТОГДА ЕСТЬNULL(ЕПСБУОстатки.ВалютнаяСуммаОстаток, 0) ИНАЧЕ 0 КОНЕЦ) КАК ВалютнаяСумма,
		|	";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(БлокОтбор) Тогда
		БлокОтбор = " Истина ";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(БлокГДЕ) Тогда
		БлокГДЕ = " Истина ";
	КонецЕсли;
	
	Если Объект.Распределять Тогда
		Запрос = Новый Запрос;
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	СоответствиеКПС.СтарыйКПС,
		|	СоответствиеКПС.НовыйКПС,
		|	СоответствиеКПС.ПроцентРаспределения
		|ПОМЕСТИТЬ СоответствиеКПС
		|ИЗ
		|	&СоответствиеКПС КАК СоответствиеКПС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СоответствиеКПС.СтарыйКПС,
		|	СоответствиеКПС.НовыйКПС,
		|	СУММА(СоответствиеКПС.ПроцентРаспределения) КАК ПроцентРаспределения
		|ПОМЕСТИТЬ СоответствиеКПС_Сгруппированные
		|ИЗ
		|	СоответствиеКПС КАК СоответствиеКПС
		|
		|СГРУППИРОВАТЬ ПО
		|	СоответствиеКПС.СтарыйКПС,
		|	СоответствиеКПС.НовыйКПС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУ.Валютный,
		|	ЕПСБУ.Количественный,
		|	ЕПСБУВидыСубконто.ВидСубконто,
		|	ЕПСБУВидыСубконто.НомерСтроки,
		|	ЕПСБУВидыСубконто.ТолькоОбороты,
		|	ЕПСБУ.Ссылка,
		|	ЕПСБУВидыСубконто.ВидСубконто.Наименование КАК Наименование,
		|	ЕПСБУ.УчетПоПодразделениям
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ПО (ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка)
		|ГДЕ
		|	ЕПСБУ.Ссылка В(&ВыбранныеСчета)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВремТаб.Ссылка КАК Счет,
		|	ВремТаб.УчетПоПодразделениям,
		|	ВремТаб.Валютный,
		|	ВремТаб.Количественный,
		|	НЕ ЕСТЬNULL(С1.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто1,
		|	НЕ ЕСТЬNULL(С2.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто2,
		|	НЕ ЕСТЬNULL(С3.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто3
		|ПОМЕСТИТЬ ВремТабСчетов
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С1
		|		ПО ВремТаб.Ссылка = С1.Ссылка
		|			И (С1.НомерСтроки = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С2
		|		ПО ВремТаб.Ссылка = С2.Ссылка
		|			И (С2.НомерСтроки = 2)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С3
		|		ПО ВремТаб.Ссылка = С3.Ссылка
		|			И (С3.НомерСтроки = 3)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУОстатки.Организация,
		|	ЕПСБУОстатки.КФО,
		|	ЕПСБУОстатки.КПС КАК СтарыйКПС,
		|	ЕПСБУОстатки.Счет КАК Счет,
		|	ЕПСБУОстатки.КЭК КАК КЭК,
		|	ЕПСБУОстатки.Субконто1 КАК Субконто1,
		|	ЕПСБУОстатки.Субконто2 КАК Субконто2,
		|	ЕПСБУОстатки.Субконто3 КАК Субконто3,
		|	&БлокВыбрать,
		|	СУММА(ЕСТЬNULL(ЕПСБУОстатки.СуммаОстаток, 0)) КАК Сумма,
		|	СУММА(ЕСТЬNULL(ЕПСБУОстатки.КоличествоОстаток, 0)) КАК Количество,
		|	ЕПСБУОстатки.Счет.Вид КАК ВидСчета,
		|	СоответствиеКПС.ПроцентРаспределения,
		|	СоответствиеКПС.НовыйКПС,
		|	ВремТабСчетов.УчетПоПодразделениям,
		|	ВремТабСчетов.ИспользоватьСубконто1,
		|	ВремТабСчетов.ИспользоватьСубконто2,
		|	ВремТабСчетов.ИспользоватьСубконто3,
		|	ВремТабСчетов.Количественный КАК СчетКоличественный,
		|	ВремТабСчетов.Валютный КАК СчетВалютный
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Дата,
		|			&БлокОтборПоСчету,
		|			,
		|			Организация = &Организация
		|				И КФО = &КФО
		|				И КПС В
		|					(ВЫБРАТЬ
		|						СоответствиеКПС.СтарыйКПС
		|					ИЗ
		|						СоответствиеКПС_Сгруппированные КАК СоответствиеКПС)
		|				И &БлокОтборОбщий) КАК ЕПСБУОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ СоответствиеКПС_Сгруппированные КАК СоответствиеКПС
		|		ПО ЕПСБУОстатки.КПС = СоответствиеКПС.СтарыйКПС
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТабСчетов КАК ВремТабСчетов
		|		ПО ЕПСБУОстатки.Счет = ВремТабСчетов.Счет
		|ГДЕ
		|	&БлокГДЕ
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕПСБУОстатки.Организация,
		|	ЕПСБУОстатки.КФО,
		|	ЕПСБУОстатки.КПС,
		|	ЕПСБУОстатки.Счет,
		|	ЕПСБУОстатки.КЭК,
		|	ЕПСБУОстатки.Субконто1,
		|	ЕПСБУОстатки.Субконто2,
		|	ЕПСБУОстатки.Субконто3,
		//не пользоваться конструктором запросов, иначе блок группировки удаляется из группируемых полей
		|	"+"&БлокГруппировка"+",
		//
		|	СоответствиеКПС.ПроцентРаспределения,
		|	СоответствиеКПС.НовыйКПС,
		|	ЕПСБУОстатки.Счет.Вид,
		|	ВремТабСчетов.УчетПоПодразделениям,
		|	ВремТабСчетов.ИспользоватьСубконто1,
		|	ВремТабСчетов.ИспользоватьСубконто2,
		|	ВремТабСчетов.ИспользоватьСубконто3,
		|	ВремТабСчетов.Количественный,
		|	ВремТабСчетов.Валютный
		|
		|УПОРЯДОЧИТЬ ПО
		|	Счет,
		|	Субконто1,
		|	Субконто2,
		|	Субконто3";
	
	Иначе
		Запрос = Новый Запрос;
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	СоответствиеКПС.НомерСтроки,
		|	СоответствиеКПС.СтарыйКПС,
		|	СоответствиеКПС.НовыйКПС
		|ПОМЕСТИТЬ СоответствиеКПС
		|ИЗ
		|	&СоответствиеКПС КАК СоответствиеКПС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СоответствиеКПС.СтарыйКПС,
		|	СоответствиеКПС.НовыйКПС
		|ПОМЕСТИТЬ СоответствиеКПС_Сгруппированные
		|ИЗ
		|	(ВЫБРАТЬ
		|		МИНИМУМ(СоответствиеКПС.НомерСтроки) КАК НомерСтроки,
		|		СоответствиеКПС.СтарыйКПС КАК СтарыйКПС
		|	ИЗ
		|		СоответствиеКПС КАК СоответствиеКПС
		|	
		|	СГРУППИРОВАТЬ ПО
		|		СоответствиеКПС.СтарыйКПС) КАК НомерСтрокиКПС
		|		ЛЕВОЕ СОЕДИНЕНИЕ СоответствиеКПС КАК СоответствиеКПС
		|		ПО НомерСтрокиКПС.НомерСтроки = СоответствиеКПС.НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУ.Валютный,
		|	ЕПСБУ.Количественный,
		|	ЕПСБУВидыСубконто.ВидСубконто,
		|	ЕПСБУВидыСубконто.НомерСтроки,
		|	ЕПСБУВидыСубконто.ТолькоОбороты,
		|	ЕПСБУ.Ссылка,
		|	ЕПСБУВидыСубконто.ВидСубконто.Наименование КАК Наименование,
		|	ЕПСБУ.УчетПоПодразделениям
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ПО (ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка)
		|ГДЕ
		|	ЕПСБУ.Ссылка В(&ВыбранныеСчета)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВремТаб.Ссылка КАК Счет,
		|	ВремТаб.УчетПоПодразделениям,
		|	ВремТаб.Валютный,
		|	ВремТаб.Количественный,
		|	НЕ ЕСТЬNULL(С1.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто1,
		|	НЕ ЕСТЬNULL(С2.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто2,
		|	НЕ ЕСТЬNULL(С3.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто3
		|ПОМЕСТИТЬ ВремТабСчетов
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С1
		|		ПО ВремТаб.Ссылка = С1.Ссылка
		|			И (С1.НомерСтроки = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С2
		|		ПО ВремТаб.Ссылка = С2.Ссылка
		|			И (С2.НомерСтроки = 2)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С3
		|		ПО ВремТаб.Ссылка = С3.Ссылка
		|			И (С3.НомерСтроки = 3)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУОстатки.Организация,
		|	ЕПСБУОстатки.КФО,
		|	ЕПСБУОстатки.КПС КАК СтарыйКПС,
		|	ЕПСБУОстатки.Счет КАК Счет,
		|	ЕПСБУОстатки.КЭК КАК КЭК,
		|	ЕПСБУОстатки.Субконто1 КАК Субконто1,
		|	ЕПСБУОстатки.Субконто2 КАК Субконто2,
		|	ЕПСБУОстатки.Субконто3 КАК Субконто3,
		|	&БлокВыбрать,
		|	СУММА(ЕСТЬNULL(ЕПСБУОстатки.СуммаОстаток, 0)) КАК Сумма,
		|	СУММА(ЕСТЬNULL(ЕПСБУОстатки.КоличествоОстаток, 0)) КАК Количество,
		|	ЕПСБУОстатки.Счет.Вид КАК ВидСчета,
		|	СоответствиеКПС.НовыйКПС,
		|	ВремТабСчетов.УчетПоПодразделениям,
		|	ВремТабСчетов.ИспользоватьСубконто1,
		|	ВремТабСчетов.ИспользоватьСубконто2,
		|	ВремТабСчетов.ИспользоватьСубконто3,
		|	ВремТабСчетов.Количественный КАК СчетКоличественный,
		|	ВремТабСчетов.Валютный КАК СчетВалютный
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Дата,
		|			&БлокОтборПоСчету,
		|			,
		|			Организация = &Организация
		|				И КФО = &КФО
		|				И КПС В
		|					(ВЫБРАТЬ
		|						СоответствиеКПС.СтарыйКПС
		|					ИЗ
		|						СоответствиеКПС_Сгруппированные КАК СоответствиеКПС)
		|				И &БлокОтборОбщий) КАК ЕПСБУОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ СоответствиеКПС_Сгруппированные КАК СоответствиеКПС
		|		ПО ЕПСБУОстатки.КПС = СоответствиеКПС.СтарыйКПС
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТабСчетов КАК ВремТабСчетов
		|		ПО ЕПСБУОстатки.Счет = ВремТабСчетов.Счет
		|ГДЕ
		|	&БлокГДЕ
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕПСБУОстатки.Организация,
		|	ЕПСБУОстатки.КФО,
		|	ЕПСБУОстатки.КПС,
		|	ЕПСБУОстатки.Счет,
		|	ЕПСБУОстатки.КЭК,
		|	ЕПСБУОстатки.Субконто1,
		|	ЕПСБУОстатки.Субконто2,
		|	ЕПСБУОстатки.Субконто3,
		//не пользоваться конструктором запросов, иначе блок группировки удаляется из группируемых полей
		|	"+"&БлокГруппировка"+",
		//
		|	СоответствиеКПС.НовыйКПС,
		|	ЕПСБУОстатки.Счет.Вид,
		|	ВремТабСчетов.УчетПоПодразделениям,
		|	ВремТабСчетов.ИспользоватьСубконто1,
		|	ВремТабСчетов.ИспользоватьСубконто2,
		|	ВремТабСчетов.ИспользоватьСубконто3,
		|	ВремТабСчетов.Количественный,
		|	ВремТабСчетов.Валютный
		|
		|УПОРЯДОЧИТЬ ПО
		|	Счет,
		|	Субконто1,
		|	Субконто2,
		|	Субконто3";
	
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&БлокВыбрать,",БлокВыбрать);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&БлокОтборПоСчету",БлокОтборПоСчету);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&БлокОтборОбщий",БлокОтбор);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&БлокГруппировка,",БлокГруппировка);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&БлокГДЕ",БлокГДЕ);
	
	Если ОтразитьВМежотчетномПериоде Тогда
		ГраницаПериода = БухгалтерскийУчет.КонецПериодаСУточнением(Объект.ФинансовыйГод, Объект.ВидМежотчетногоПериода);	
	Иначе	
		ГраницаПериода = БухгалтерскийУчет.КонецПериодаСУточнением(Объект.Дата, Объект.ВидМежотчетногоПериода); 
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СоответствиеКПС",	Объект.СоответствиеКПС.Выгрузить());
	Запрос.УстановитьПараметр("Дата",            	ГраницаПериода);
	Запрос.УстановитьПараметр("Организация",      	Объект.Организация);
	Запрос.УстановитьПараметр("КФО",             	Объект.КФО);
	Запрос.УстановитьПараметр("КПС",             	Объект.СоответствиеКПС.Выгрузить().ВыгрузитьКолонку("СтарыйКПС"));
	Запрос.УстановитьПараметр("ВыбранныеСчета",     ВыбранныеСчета);
	Запрос.УстановитьПараметр("ИФО",          		Объект.ИФО);
	Запрос.УстановитьПараметр("Подразделение", 		Объект.Подразделение);
	
	Запрос.Текст    = ТекстЗапроса;
		
	//Если Объект.ВариантПереноса <2 Тогда
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		СтрокаТЧ =  Объект.Переводы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ,Результат);
		Если Результат.ВидСчета = ВидСчета.Пассивный Тогда
			СтрокаТЧ.Количество    = - СтрокаТЧ.Количество;
			СтрокаТЧ.Сумма         = - СтрокаТЧ.Сумма;
			СтрокаТЧ.ВалютнаяСумма = - СтрокаТЧ.ВалютнаяСумма;
		КонецЕсли;
	КонецЦикла;
	Если Объект.ВариантПереноса>1 И Объект.Распределять Тогда
		//Распределение
		ВремТЧ = Объект.Переводы.Выгрузить();
		ВремТЧ.Свернуть("Счет,СтарыйКПС,Субконто1,Субконто2,Субконто3,Валюта,Подразделение,КЭК");
		СтруктураПоиска = Новый Структура("Счет,СтарыйКПС,Субконто1,Субконто2,Субконто3,Валюта,Подразделение,КЭК");
		Для Каждого СтрТЧ Из ВремТЧ Цикл
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрТЧ);
			СтрокиРаспределения = Объект.Переводы.НайтиСтроки(СтруктураПоиска);
			
			СуммаДляРаспределения = СтрокиРаспределения[0].Сумма;
			КоличествоДляРаспределения = СтрокиРаспределения[0].Количество;
			ВалСуммаДляРаспределения = СтрокиРаспределения[0].ВалютнаяСумма;
			
			СуммаРаспределенная = 0;
			КоличествоРаспределенное = 0;
			ВалСуммаРаспределенная = 0;
			
			КолСтр = СтрокиРаспределения.Количество();
			
			ДополняемаяСтрока = Неопределено;
			МассивУдаления = Новый Массив;
			Для Каждого ТекСтр Из СтрокиРаспределения Цикл
				ТекПроцент = ?(НЕ ЗначениеЗаполнено(ТекСтр.ПроцентРаспределения) И КолСтр = 1,100,ТекСтр.ПроцентРаспределения);
				Если ЗначениеЗаполнено(ТекСтр.Количество) И ТекПроцент<>100 И Объект.ОкруглятьКоличество Тогда
					ТекПроцент = Окр(ТекСтр.Количество*ТекПроцент/100)*100/ТекСтр.Количество;
				КонецЕсли;
				
				ТекСтр.Сумма = ТекСтр.Сумма*ТекПроцент/100;
				СуммаРаспределенная = СуммаРаспределенная + ТекСтр.Сумма;
				
				ТекСтр.Количество = ТекСтр.Количество*ТекПроцент/100;
				Если Объект.ОкруглятьКоличество Тогда
					ТекСтр.Количество = Окр(ТекСтр.Количество);	
				КонецЕсли;
				КоличествоРаспределенное = КоличествоРаспределенное + ТекСтр.Количество;
				
				ТекСтр.ВалютнаяСумма = ТекСтр.ВалютнаяСумма*ТекПроцент/100;
				ВалСуммаРаспределенная = ВалСуммаРаспределенная + ТекСтр.ВалютнаяСумма;
				
				Если ТекПроцент = 0 Тогда
					МассивУдаления.Добавить(ТекСтр);
				КонецЕсли;
				
				Если ДополняемаяСтрока = Неопределено И ТекПроцент<>0 Тогда
					ДополняемаяСтрока = ТекСтр;
				КонецЕсли;
			КонецЦикла;
			
			Если (СуммаРаспределенная <> СуммаДляРаспределения 
				ИЛИ КоличествоРаспределенное <> КоличествоДляРаспределения
				ИЛИ ВалСуммаРаспределенная <> ВалСуммаДляРаспределения) 
				И ДополняемаяСтрока <> Неопределено Тогда
				
				СтароеКолВо = ДополняемаяСтрока.Количество;
				НовоеКолВо = ДополняемаяСтрока.Количество + (КоличествоДляРаспределения-КоличествоРаспределенное);
				
				ДополняемаяСтрока.Количество = ДополняемаяСтрока.Количество + (КоличествоДляРаспределения-КоличествоРаспределенное);
				
				Если СтароеКолВо<>0 И НовоеКолВо = 0 Тогда
					СуммаРаспределенная = СуммаДляРаспределения - ДополняемаяСтрока.Сумма;
					ВалСуммаРаспределенная = ВалСуммаРаспределенная - ДополняемаяСтрока.ВалютнаяСумма;
					
					ДополняемаяСтрока.Сумма = 0;
					ДополняемаяСтрока.ВалютнаяСумма = 0;
					МассивУдаления.Добавить(ДополняемаяСтрока);
					
					Если СуммаРаспределенная <> СуммаДляРаспределения 
						ИЛИ ВалСуммаРаспределенная <> ВалСуммаДляРаспределения Тогда
						//////////////////////////////
						//Если количество стало 0, то сумму и валютную сумму надо распределить снова
						Для Каждого ТекСтр Из СтрокиРаспределения Цикл
							Если ТекСтр.Сумма<>0 И ТекСтр.Количество<>0 Тогда
								ТекСтр.Сумма = ТекСтр.Сумма + (СуммаДляРаспределения-СуммаРаспределенная);
								ТекСтр.ВалютнаяСумма = ТекСтр.ВалютнаяСумма + (ВалСуммаДляРаспределения - ВалСуммаРаспределенная);
								Прервать;
							КонецЕсли;	
						КонецЦикла;
					КонецЕсли;
				Иначе
					ДополняемаяСтрока.Сумма = ДополняемаяСтрока.Сумма + (СуммаДляРаспределения-СуммаРаспределенная);	
					ДополняемаяСтрока.ВалютнаяСумма = ДополняемаяСтрока.ВалютнаяСумма + (ВалСуммаДляРаспределения - ВалСуммаРаспределенная);
				КонецЕсли;
			КонецЕсли;
			Для Каждого ЭлМас Из МассивУдаления Цикл
				Объект.Переводы.Удалить(ЭлМас);
			КонецЦикла;
		КонецЦикла;		
	КонецЕсли;
	
	Документы.ПереносОстатковПоКПС.ЗаполнитьГрафикиИсполненияДоговоровПоДаннымУчета(Объект);
	ПереводыЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОбработкаВыбораЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		Возврат;
        
    КонецЕсли;
         
    ОбработкаВыбораСчетовСервер(ДополнительныеПараметры.ВыбранноеЗначение);	
        
    Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ПроверитьПоВариантуПереноса(Отказ)
 	Если Объект.ВариантПереноса = 0 Тогда
		Если НЕ ЗначениеЗаполнено(СтарыйКПС) Тогда
			ТекстСообщения = НСтр("ru='Не заполнен старый КПС'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"СтарыйКПС",,Отказ);	
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НовыйКПС) Тогда
			ТекстСообщения = НСтр("ru='Не заполнен новый КПС'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"НовыйКПС",,Отказ);	
		КонецЕсли;
	ИначеЕсли Объект.ВариантПереноса = 1 Тогда
		Если НЕ ЗначениеЗаполнено(НовыйКПС) Тогда
			ТекстСообщения = НСтр("ru='Не заполнен новый КПС'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"НовыйКПС",,Отказ);	
		КонецЕсли;
	ИначеЕсли Объект.ВариантПереноса = 2 Тогда
		//один старый - список новых
		Если НЕ ЗначениеЗаполнено(СтарыйКПС) Тогда
			ТекстСообщения = НСтр("ru='Не заполнен старый КПС'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"СтарыйКПС",,Отказ);	
		КонецЕсли;
		Если Объект.Распределять Тогда
			//проверить, что всего 100% распределено
			Если Объект.СоответствиеКПС.Итог("ПроцентРаспределения") <>100 И Объект.СоответствиеКПС.Количество()>1 Тогда
				ТекстСообщения = НСтр("ru='Не корректно заполнен процент распределения. Всего должно быть 100%'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);	
			КонецЕсли;   
		КонецЕсли;
	ИначеЕсли Объект.ВариантПереноса = 3 И Объект.Распределять Тогда
		//список старых - список новых
		//проверить, есть ли одинаковые старые КПС с различными новыми КПС, 
		//для них проверить процент распределения
        
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ПереносОстатковПоКПССоответствиеКПС",Объект.СоответствиеКПС.Выгрузить());
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПереносОстатковПоКПССоответствиеКПС.СтарыйКПС,
			|	ПереносОстатковПоКПССоответствиеКПС.НовыйКПС,
			|	ПереносОстатковПоКПССоответствиеКПС.ПроцентРаспределения КАК ПроцентРаспределения
			|ПОМЕСТИТЬ ВремТаб
			|ИЗ
			|	&ПереносОстатковПоКПССоответствиеКПС КАК ПереносОстатковПоКПССоответствиеКПС
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВремТаб.СтарыйКПС,
			|	ВремТаб.НовыйКПС,
			|	СУММА(ВремТаб.ПроцентРаспределения) КАК ПроцентРаспределения
			|ПОМЕСТИТЬ СгруппированныеДанные
			|ИЗ
			|	ВремТаб КАК ВремТаб
			|
			|СГРУППИРОВАТЬ ПО
			|	ВремТаб.СтарыйКПС,
			|	ВремТаб.НовыйКПС
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СгруппированныеДанные.СтарыйКПС,
			|	СУММА(СгруппированныеДанные.ПроцентРаспределения) КАК ПроцентРаспределения,
			|	КОЛИЧЕСТВО(СгруппированныеДанные.СтарыйКПС) КАК СтарыйКПСКоличество,
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СгруппированныеДанные.НовыйКПС) КАК НовыйКПСКоличество
			|ИЗ
			|	СгруппированныеДанные КАК СгруппированныеДанные
			|
			|СГРУППИРОВАТЬ ПО
			|	СгруппированныеДанные.СтарыйКПС
			|
			|ИМЕЮЩИЕ
			|	КОЛИЧЕСТВО(СгруппированныеДанные.СтарыйКПС) > 1 И
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СгруппированныеДанные.НовыйКПС) > 1 И
			|	СУММА(СгруппированныеДанные.ПроцентРаспределения) <> 100";

		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ТекстСообщения = НСтр("ru='Для КПС %1 не корректно заполнен процент распределения. Всего должно быть 100, установлено %2'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ВыборкаДетальныеЗаписи.СтарыйКПС,ВыборкаДетальныеЗаписи.ПроцентРаспределения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		КонецЦикла;

	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьДинамическиеДанныеВТабличнойЧасти()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУ.Валютный,
		|	ЕПСБУ.Количественный,
		|	ЕПСБУВидыСубконто.ВидСубконто,
		|	ЕПСБУВидыСубконто.НомерСтроки,
		|	ЕПСБУВидыСубконто.ТолькоОбороты,
		|	ЕПСБУ.Ссылка,
		|	ЕПСБУВидыСубконто.ВидСубконто.Наименование КАК Наименование,
		|	ЕПСБУ.УчетПоПодразделениям
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ПО (ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка)
		|ГДЕ
		|	ЕПСБУ.Ссылка В(&ВыбранныеСчета)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТаб.Ссылка КАК Счет,
		|	ВремТаб.УчетПоПодразделениям,
		|	ВремТаб.Валютный КАК СчетВалютный,
		|	ВремТаб.Количественный КАК СчетКоличественный,
		|	НЕ ЕСТЬNULL(С1.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто1,
		|	НЕ ЕСТЬNULL(С2.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто2,
		|	НЕ ЕСТЬNULL(С3.ТолькоОбороты, ИСТИНА) КАК ИспользоватьСубконто3
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С1
		|		ПО (ВремТаб.Ссылка = С1.Ссылка
		|				И С1.НомерСтроки = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С2
		|		ПО (ВремТаб.Ссылка = С2.Ссылка
		|				И С2.НомерСтроки = 2)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК С3
		|		ПО (ВремТаб.Ссылка = С3.Ссылка
		|				И С3.НомерСтроки = 3)";

	Запрос.УстановитьПараметр("ВыбранныеСчета", Объект.Переводы.Выгрузить().ВыгрузитьКолонку("Счет"));		
    ДанныеСчетов = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрТЧ Из Объект.Переводы Цикл
		
		ТекОбъект = ДанныеСчетов.НайтиСтроки(Новый Структура("Счет", СтрТЧ.Счет));
		Если ТекОбъект.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрТЧ, ТекОбъект[0], "УчетПоПодразделениям,ИспользоватьСубконто1,ИспользоватьСубконто2,ИспользоватьСубконто3,СчетВалютный,СчетКоличественный");
		КонецЕсли;
	
	КонецЦикла; 	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыВыбранныхСчетов()
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Счета", Объект.Счета.Выгрузить().ВыгрузитьКолонку("Счет"));
	ПараметрыФормы.Вставить("АдресХранилища", ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));  
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораСчетовСервер(Знач ВыбранноеЗначение)
	
	//УстановитьДинамическиеДанныеВТабличнойЧасти();
	Объект.Переводы.Очистить();
	
	ТабСчетов = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобранныхСчетовВХранилище);
	
	Объект.Счета.Загрузить(ТабСчетов);
	Объект.Счета.Сортировать("Счет");
	
	СчетаПереноса = СтрСоединить(Объект.Счета.Выгрузить().ВыгрузитьКолонку("Счет"), "; ");
	
	Если Не ЗначениеЗаполнено(СчетаПереноса) Тогда
		СчетаПереноса = "Нажмите для выбора счетов";
	КонецЕсли;
	
	НастройкаВидимостиСубконто();
	
КонецПроцедуры

&НаСервере
Процедура НастройкаВидимостиСубконто()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУ.Валютный,
		|	ЕПСБУВидыСубконто.ВидСубконто,
		|	ЕПСБУВидыСубконто.НомерСтроки,
		|	ЕПСБУВидыСубконто.ТолькоОбороты,
		|	ЕПСБУ.Ссылка,
		|	ЕПСБУВидыСубконто.ВидСубконто.Наименование КАК Наименование
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ПО (ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка)
		|ГДЕ
		|	ЕПСБУ.Ссылка В(&ВыбранныеСчета)";

	Запрос.УстановитьПараметр("ВыбранныеСчета", Объект.Счета.Выгрузить().ВыгрузитьКолонку("Счет"));

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	ВидимостьВалют = Ложь;
	ВидимостьСубконто = Новый Массив(3);
	ВидимостьСубконто[0] = Ложь;
	ВидимостьСубконто[1] = Ложь;
	ВидимостьСубконто[2] = Ложь;
	
	НаименованиеСубконто = Новый Массив(3);
	НаименованиеСубконто[0] = "";
	НаименованиеСубконто[1] = "";
	НаименованиеСубконто[2] = "";
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ВидимостьВалют = ВидимостьВалют ИЛИ ВыборкаДетальныеЗаписи.Валютный;
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.НомерСтроки) Тогда
			ВидимостьСубконто[ВыборкаДетальныеЗаписи.НомерСтроки-1] = ВидимостьСубконто[ВыборкаДетальныеЗаписи.НомерСтроки-1] ИЛИ НЕ ВыборкаДетальныеЗаписи.ТолькоОбороты;
			Если НЕ ВыборкаДетальныеЗаписи.ТолькоОбороты Тогда
				ТекНаименование = НаименованиеСубконто[ВыборкаДетальныеЗаписи.НомерСтроки-1];
				НаименованиеСубконто[ВыборкаДетальныеЗаписи.НомерСтроки-1] = ?(ЗначениеЗаполнено(ТекНаименование) И ТекНаименование <> ВыборкаДетальныеЗаписи.Наименование,"Субконто"+ВыборкаДетальныеЗаписи.НомерСтроки,ВыборкаДетальныеЗаписи.Наименование);
			КонецЕсли;
		КонецЕсли; 
	КонецЦикла;
	
	Элементы.ПереводыВалюта.Видимость = ВидимостьВалют;
	Элементы.ПереводыВалютнаяСумма.Видимость = ВидимостьВалют;

	Для Инд = 1 По 3 Цикл	
		Элементы["ПереводыСубконто"+Инд].Видимость = ВидимостьСубконто[Инд-1];
		Элементы["ПереводыСубконто"+Инд].Заголовок = ?(ЗначениеЗаполнено(НаименованиеСубконто[Инд-1]),НаименованиеСубконто[Инд-1],"Субконто"+Инд);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантПереносаПриИзменении(Элемент)
	
	Если Объект.ВариантПереноса = 0 Тогда
		Объект.Распределять = Ложь;
		Объект.ОкруглятьКоличество = Ложь;
		Элементы.Распределять.Доступность = Ложь;
		Элементы.ОкруглятьКоличество.Доступность = Ложь;
		Элементы.ГруппаВариантыПереноса.ТекущаяСтраница = Элементы.ГруппаОдинКОдному;			
	ИначеЕсли Объект.ВариантПереноса = 1 Тогда
		Объект.Распределять = Ложь;
		Объект.ОкруглятьКоличество = Ложь;
		Элементы.Распределять.Доступность = Ложь;
		Элементы.ОкруглятьКоличество.Доступность = Ложь;
		Элементы.ГруппаВариантыПереноса.ТекущаяСтраница = Элементы.ГруппаМногоКОдному;			
	ИначеЕсли Объект.ВариантПереноса = 2 Тогда
		Элементы.ОкруглятьКоличество.Доступность = Истина;
		Элементы.Распределять.Доступность = Истина;
		Элементы.ГруппаВариантыПереноса.ТекущаяСтраница = Элементы.ГруппаОдинКоМногим;	
	ИначеЕсли Объект.ВариантПереноса = 3 Тогда
		Элементы.ОкруглятьКоличество.Доступность = Истина;
		Элементы.Распределять.Доступность = Истина;
		Элементы.ГруппаВариантыПереноса.ТекущаяСтраница = Элементы.ГруппаМногоКоМногим;	
	КонецЕсли;
	ЗаполнитьЭлементыФормыКПС();	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСоответствиеКПСПоВариантуПереноса(ОбъектДляЗаполнения)
	Если ОбъектДляЗаполнения.ВариантПереноса = 0 Тогда
		ОбъектДляЗаполнения.СоответствиеКПС.Очистить();
		НовСтр = ОбъектДляЗаполнения.СоответствиеКПС.Добавить();
		НовСтр.СтарыйКПС = СтарыйКПС;
		НовСтр.НовыйКПС = НовыйКПС;
	ИначеЕсли ОбъектДляЗаполнения.ВариантПереноса = 1 Тогда
		Для Каждого СтрТЧ Из ОбъектДляЗаполнения.СоответствиеКПС Цикл
			СтрТЧ.НовыйКПС = НовыйКПС;
		КонецЦикла;
	ИначеЕсли ОбъектДляЗаполнения.ВариантПереноса = 2 Тогда
		Для Каждого СтрТЧ Из ОбъектДляЗаполнения.СоответствиеКПС Цикл
			СтрТЧ.СтарыйКПС = СтарыйКПС;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЭлементыФормыКПС()
	Если Объект.СоответствиеКПС.Количество()>0 Тогда
		Если Объект.ВариантПереноса = 0
			ИЛИ Объект.ВариантПереноса = 1 Тогда
			НовыйКПС = Объект.СоответствиеКПС[0].НовыйКПС;
		КонецЕсли;
		Если Объект.ВариантПереноса = 0
			ИЛИ Объект.ВариантПереноса = 2 Тогда
			СтарыйКПС = Объект.СоответствиеКПС[0].СтарыйКПС;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоПодразделениюПриИзменении(Элемент)
	Элементы.Подразделение.Доступность = Объект.ОтборПоПодразделению;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСоответсвиеКПСДляВыбора()
	СоответсвиеКПСДляВыбора = Новый Соответствие;
	Для Каждого СтрТч Из Объект.СоответствиеКПС Цикл
		Если Не ЗначениеЗаполнено(СтрТч.СтарыйКПС) Тогда 
			Продолжить;
		КонецЕсли;
		
		ВыбранныйМассив = СоответсвиеКПСДляВыбора.Получить(СтрТч.СтарыйКПС);
		Если ВыбранныйМассив = Неопределено Тогда
			ВыбранныйМассив = Новый Массив;
			ВыбранныйМассив.Добавить(СтрТч.НовыйКПС);
		Иначе
			Если ВыбранныйМассив.Найти(СтрТч.НовыйКПС) = Неопределено Тогда
				ВыбранныйМассив.Добавить(СтрТч.НовыйКПС);
			КонецЕсли;
		КонецЕсли;
		СоответсвиеКПСДляВыбора.Вставить(СтрТч.СтарыйКПС,ВыбранныйМассив);
	КонецЦикла;
	ФиксСоответсвиеКПСДляВыбора = Новый ФиксированноеСоответствие(СоответсвиеКПСДляВыбора);
КонецПроцедуры

&НаСервере
Процедура УстановитьТолькоПросмотр()

	Если Объект.Проведен Тогда
		ОбщегоНазначения.СообщитьПользователю(Нстр("ru = 'Чтобы изменить документ необходимо отменить проведение и повторно открыть документ'"));
		ТолькоПросмотр = Истина;
	КонецЕсли;

КонецПроцедуры // УстановитьТолькоПросмотр()

&НаСервереБезКонтекста
Процедура ЗаполнитьНовыйКПС(СтарыйКПС, НовыйКПС, Дата)
	
	СтарыеКПС = Новый Соответствие;
	СтарыеКПС.Вставить(СтарыйКПС);
	
	СоответствиеКПС = РегистрыСведений.СоответствиеКПСПриПереносеОстатков.СоответствиеКПС(СтарыеКПС, Дата);
	
	Если СоответствиеКПС[СтарыйКПС] <> Неопределено Тогда
		НовыйКПС = СоответствиеКПС[СтарыйКПС];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуГрафикаПлатежей(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ПараметрыФормы = ПараметрыФормыГрафикПлатежей(ВыбранноеЗначение);
	Если Не ПараметрыФормы.ВедетсяГрафикПоДоговору Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Документ.ПереносОстатковПоКПС.Форма.ФормаГрафикПлатежей", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуГрафикаИсполнения(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ПараметрыФормы = ПараметрыФормыГрафикИсполнения(ВыбранноеЗначение);
	Если Не ПараметрыФормы.ВедетсяГрафикПоДоговору Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Документ.ПереносОстатковПоКПС.Форма.ФормаГрафикИсполнения", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаСервере
Функция ПараметрыФормыГрафикПлатежей(ВыбранноеЗначение)
	
	ДанныеСтроки = Объект.Переводы.НайтиПоИдентификатору(ВыбранноеЗначение);
	
	ПараметрыФормы = Новый Структура("Дата, Организация, Ссылка, ИФО, КФО");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	
	Для НомерСубконто = 1 По 3 Цикл
		Если ТипЗнч(ДанныеСтроки["Субконто" + НомерСубконто]) = Тип("СправочникСсылка.Контрагенты") Тогда
			ПараметрыФормы.Вставить("Контрагент", ДанныеСтроки["Субконто" + НомерСубконто]);
		ИначеЕсли ТипЗнч(ДанныеСтроки["Субконто" + НомерСубконто]) = Тип("СправочникСсылка.Договоры") Тогда
			ПараметрыФормы.Вставить("Договор", ДанныеСтроки["Субконто" + НомерСубконто]);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы.Вставить("НомерСтроки", ДанныеСтроки.НомерСтроки);
	ПараметрыФормы.Вставить("ИдентификаторСтроки", ДанныеСтроки.ИдентификаторСтроки);
	ПараметрыФормы.Вставить("СчетРасчетов", ДанныеСтроки.Счет);
	ПараметрыФормы.Вставить("ВидРасчетов", ДанныеСтроки.ВидРасчетов);
	ПараметрыФормы.Вставить("КПС", ДанныеСтроки.СтарыйКПС);
	ПараметрыФормы.Вставить("Валюта", ?(ЗначениеЗаполнено(ДанныеСтроки.Валюта), ДанныеСтроки.Валюта, БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета()));
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	Отбор = Новый Структура("ИдентификаторСтроки", ДанныеСтроки.ИдентификаторСтроки);
	ГрафикПлатежей = Объект.ГрафикПлатежей.Выгрузить(Отбор);
	ПараметрыФормы.Вставить("ГрафикПлатежей", ПоместитьВоВременноеХранилище(ГрафикПлатежей));
	
	ПараметрыФормы.Вставить("ВедетсяГрафикПоДоговору",
		ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров
		И ПараметрыФормы.Свойство("Договор")
		И ЗначениеЗаполнено(ПараметрыФормы.Договор)
		И БухгалтерскийУчет.СчетВИерархии(ДанныеСтроки.Счет, КонтрольИсполненияДоговоровКлиентСервер.СчетаРасчетовСВедениемГрафиковПоДоговорам()) );
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаСервере
Функция ПараметрыФормыГрафикИсполнения(ВыбранноеЗначение)
	
	ДанныеСтроки = Объект.Переводы.НайтиПоИдентификатору(ВыбранноеЗначение);
	
	ПараметрыФормы = Новый Структура("Дата, Организация, Ссылка, ИФО, КФО");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	
