&НаСервере
Процедура ПереводыЗаполнитьДобавленныеКолонки()
	
	ВалютаРеглУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	ВидыДоговоровСПокупателямиДебиторами = КонтрольИсполненияДоговоровКлиентСервер.ВидыДоговоровСПокупателямиДебиторами();
	ВидыДоговоровСПоставщикамиКредиторами = КонтрольИсполненияДоговоровКлиентСервер.ВидыДоговоровСПоставщикамиКредиторами();
	
	Для Каждого СтрокаТаблицы Из Объект.Переводы Цикл
		
		ДоговорВСтроке = Справочники.Договоры.ПустаяСсылка();
		Если ТипЗнч(СтрокаТаблицы.Субконто1) = Тип("СправочникСсылка.Договоры") Тогда
			ДоговорВСтроке = СтрокаТаблицы.Субконто1;
		ИначеЕсли ТипЗнч(СтрокаТаблицы.Субконто2) = Тип("СправочникСсылка.Договоры") Тогда
			ДоговорВСтроке = СтрокаТаблицы.Субконто2;
		ИначеЕсли ТипЗнч(СтрокаТаблицы.Субконто3) = Тип("СправочникСсылка.Договоры") Тогда
			ДоговорВСтроке = СтрокаТаблицы.Субконто3;
		КонецЕсли;
		
		Если ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров
			И БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.Счет, КонтрольИсполненияДоговоровКлиентСервер.СчетаРасчетовСВедениемГрафиковПоДоговорам())
			И ЗначениеЗаполнено(ДоговорВСтроке) Тогда
			РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорВСтроке, "ВидДоговора,ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
			СтрокаТаблицы.ВидДоговора = РеквизитыДоговора.ВидДоговора;
			СтрокаТаблицы.ВестиГрафикПлатежей = РеквизитыДоговора.ВестиГрафикПлатежей;
			СтрокаТаблицы.ВестиПланГрафикИсполнения = РеквизитыДоговора.ВестиПланГрафикИсполнения;
		Иначе
			СтрокаТаблицы.ВидДоговора = Неопределено;
			СтрокаТаблицы.ВестиГрафикПлатежей = Ложь;
			СтрокаТаблицы.ВестиПланГрафикИсполнения = Ложь;
		КонецЕсли;
		
		ПереводыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПереводыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы)
	
	Объект = Форма.Объект;
	
	ГрафикПлатежейИтог = 0;
	ГрафикИсполненияИтог = 0;
	Отбор = Новый Структура("ИдентификаторСтроки", СтрокаТаблицы.ИдентификаторСтроки);
	НайденныеСтроки = Объект.ГрафикПлатежей.НайтиСтроки(Отбор);
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		ГрафикПлатежейИтог = ГрафикПлатежейИтог + НайденнаяСтрока.СуммаВВалюте;
	КонецЦикла;
	НайденныеСтроки = Объект.ГрафикИсполнения.НайтиСтроки(Отбор);
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		ГрафикИсполненияИтог = ГрафикИсполненияИтог + НайденнаяСтрока.СуммаВВалюте;
	КонецЦикла;
	
	СтрокаТаблицы.ГрафикПлатежей = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1, на сумму %2'"),
		?(ЗначениеЗаполнено(СтрокаТаблицы.ВидРасчетов), СтрокаТаблицы.ВидРасчетов, "<...>"),
		Формат(ГрафикПлатежейИтог, "ЧЦ=15;ЧДЦ=2;ЧН=0"));
	СтрокаТаблицы.ГрафикПлатежейЗаполнен = ЗначениеЗаполнено(СтрокаТаблицы.ВидРасчетов) И (ГрафикПлатежейИтог <> 0);
	
	СтрокаТаблицы.ГрафикИсполнения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'на сумму %1'"),
		Формат(ГрафикИсполненияИтог, "ЧЦ=15;ЧДЦ=2;ЧН=0"));
	СтрокаТаблицы.ГрафикИсполненияЗаполнен = (ГрафикИсполненияИтог <> 0);
	
КонецПроцедуры

#КонецОбласти

