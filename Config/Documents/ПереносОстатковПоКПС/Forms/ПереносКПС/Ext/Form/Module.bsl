&НаКлиенте
Процедура ПереводыНовыйКПСНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	Элементы.ПереводыНовыйКПС.СписокВыбора.Очистить();
	ТекДанные = Элементы.Переводы.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда
		МассивВыбора = ФиксСоответсвиеКПСДляВыбора.Получить(ТекДанные.СтарыйКПС);
		Если МассивВыбора<>Неопределено Тогда
			Элементы.ПереводыНовыйКПС.СписокВыбора.ЗагрузитьЗначения(МассивВыбора);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

