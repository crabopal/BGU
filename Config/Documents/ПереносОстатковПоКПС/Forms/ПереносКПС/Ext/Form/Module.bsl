		И ПараметрыФормы.Свойство("Договор")
		И ЗначениеЗаполнено(ПараметрыФормы.Договор)
		И БухгалтерскийУчет.СчетВИерархии(ДанныеСтроки.Счет, КонтрольИсполненияДоговоровКлиентСервер.СчетаРасчетовСВедениемГрафиковПоДоговорам()) );
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораГрафикаПлатежейНаСервере(ТекущаяСтрока, ПараметрыГрафикаПлатежей)
	
	ДанныеСтроки = Объект.Переводы.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, ПараметрыГрафикаПлатежей, "ВидРасчетов");
	
	// Удаляем строки по идентификатору из табличной части.
	ОтборПоИдентификаторуСтроки = Новый Структура("ИдентификаторСтроки", ДанныеСтроки.ИдентификаторСтроки);
	НайденныеСтроки = Объект.ГрафикПлатежей.НайтиСтроки(ОтборПоИдентификаторуСтроки);
	Для Каждого СтрокаГрафика Из НайденныеСтроки Цикл
		Объект.ГрафикПлатежей.Удалить(Объект.ГрафикПлатежей.Индекс(СтрокаГрафика));
	КонецЦикла;
	
	// Добавляем новые строки графика платежей.
	НовыйГрафикПлатежей = ПолучитьИзВременногоХранилища(ПараметрыГрафикаПлатежей.ГрафикПлатежей);
	Для Каждого СтрокаГрафика Из НовыйГрафикПлатежей Цикл
		НоваяСтрока = Объект.ГрафикПлатежей.Добавить();
		НоваяСтрока.ИдентификаторСтроки = ДанныеСтроки.ИдентификаторСтроки;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика,
			"СуммаВВалюте,ОплатитьДо,ДопКлассификация,КодМероприятия,КодЦели");
	КонецЦикла;
	
	ПереводыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ДанныеСтроки);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораГрафикаИсполненияНаСервере(ТекущаяСтрока, ПараметрыГрафикаИсполнения)
	
	ДанныеСтроки = Объект.Переводы.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Удаляем строки по идентификатору из табличной части.
	ОтборПоИдентификаторуСтроки = Новый Структура("ИдентификаторСтроки", ДанныеСтроки.ИдентификаторСтроки);
	НайденныеСтроки = Объект.ГрафикИсполнения.НайтиСтроки(ОтборПоИдентификаторуСтроки);
	Для Каждого СтрокаГрафика Из НайденныеСтроки Цикл
		Объект.ГрафикИсполнения.Удалить(Объект.ГрафикИсполнения.Индекс(СтрокаГрафика));
	КонецЦикла;
	
	// Добавляем новые строки плана-графика закупок, реализации.
	НовыйГрафикИсполнения = ПолучитьИзВременногоХранилища(ПараметрыГрафикаИсполнения.ГрафикИсполнения);
	Для Каждого СтрокаГрафика Из НовыйГрафикИсполнения Цикл
		НоваяСтрока = Объект.ГрафикИсполнения.Добавить();
		НоваяСтрока.ИдентификаторСтроки = ДанныеСтроки.ИдентификаторСтроки;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика,
			"СуммаВВалюте,ИсполнитьДо");
	КонецЦикла;
	
	ПереводыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ДанныеСтроки);
	
	Модифицированность = Истина;
	
КонецПроцедуры


