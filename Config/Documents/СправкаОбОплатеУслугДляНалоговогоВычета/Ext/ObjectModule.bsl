#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий 

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив();
	
	// Нижеперечисленные реквизиты будут проверяться по видам услуг.
	Если ВидСправки = Перечисления.ВидыСправокДляНалоговогоВычета.ОбразовательныеУслуги Тогда
		ПроверяемыеРеквизиты.Добавить("ОбразованиеСуммаРасходов");
	ИначеЕсли ВидСправки = Перечисления.ВидыСправокДляНалоговогоВычета.МедицинскиеУслуги Тогда
		Если МедицинаСуммаРасходов1 = 0 И МедицинаСуммаРасходов2 = 0 Тогда
			ПроверяемыеРеквизиты.Добавить("МедицинаСуммаРасходов1");
			ПроверяемыеРеквизиты.Добавить("МедицинаСуммаРасходов2");
		КонецЕсли;
	ИначеЕсли ВидСправки = Перечисления.ВидыСправокДляНалоговогоВычета.ФизкультурноОздоровительныеУслуги Тогда
		ПроверяемыеРеквизиты.Добавить("ФизкультураСуммаРасходов");
	КонецЕсли;
	
	// Нижеперечисленные реквизиты будут проверяться для разных плательщика и получателя услуг.
	Если НЕ НалогоплательщикИПолучательУслугиОдноЛицо Тогда
		ПроверяемыеРеквизиты.Добавить("Получатель");
		ПроверяемыеРеквизиты.Добавить("ПолучательФамилия");
		ПроверяемыеРеквизиты.Добавить("ПолучательИмя");
		ПроверяемыеРеквизиты.Добавить("ПолучательДатаРождения");
	КонецЕсли;
	
	// Согласно требованиям приказов ФНС, в поле «ИНН» указывается ИНН физического лица (при наличии).
	// При заполнении поля «ИНН» поля «Код вида документа», «Серия и номер», «Дата выдачи» 
	// раздела «Сведения о документе, удостоверяющем личность» не заполняются.
	Если НЕ ЗначениеЗаполнено(НалогоплательщикИНН) Тогда
		ПроверяемыеРеквизиты.Добавить("НалогоплательщикДокументВид");
		ПроверяемыеРеквизиты.Добавить("НалогоплательщикДокументНомер");
		ПроверяемыеРеквизиты.Добавить("НалогоплательщикДокументДата");
	КонецЕсли;
	
	Если НЕ НалогоплательщикИПолучательУслугиОдноЛицо И
		НЕ ЗначениеЗаполнено(ПолучательИНН) Тогда
		ПроверяемыеРеквизиты.Добавить("ПолучательДокументВид");
		ПроверяемыеРеквизиты.Добавить("ПолучательДокументНомер");
		ПроверяемыеРеквизиты.Добавить("ПолучательДокументДата");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.СправкаОбОплатеУслугДляНалоговогоВычета.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	//
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// При проведении выполняется проверка, выдавалась ли справка налогоплательщику и получателю услуги в выбранном периоде.
	// Проверка выполняется по регистру ВыданныеСправкиОбОплатеУслуг, в случае наличия справки документ не проводится.
	ПроверкаРанееВыданныхСправок(Отказ);
	
	// При проведении выполняется проверка и установка номера сведений по набору реквизитов Организация, НалоговыйОрган, ОтчетныйГод.
	// Если номер сведений не задан, то устанавливается новый номер, по данным регистра НумерацияСправокОбОплатеУслуг + 1.
	// Если номер сведений задан, то проверяется, не повтояет ли он такой же номер в проведенном документе. 
	// Если проведенный документ с таким номером сведений уже существует, проведение не выполняется.
	ПроверкаНомераСведенийВДокументах(Отказ);
	
	// Движения по регистрам накопления
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ВыданныеСправкиОбОплатеУслуг");
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	НомерСведений = 0;
	НомерКорректировки = 0;
	
	ОбразованиеСуммаРасходов = 0;
	МедицинаСуммаРасходов1 = 0;
	МедицинаСуммаРасходов2 = 0;
	ФизкультураСуммаРасходов = 0;
	Основание = Неопределено;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ПроверитьИспользованиеВАктуальныхЖурналах(Отказ);
	КонецЕсли;
	
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Если НомерСведений = 0 Тогда
			ПредыдущийНомерСведений = ПолучитьПредыдущийНомерСведений();
			НомерСведений = ПредыдущийНомерСведений + 1;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(УИДСправкиВЖурнале) Тогда 
		УИДСправкиВЖурнале = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	АктуализироватьУведомлениеОСпецрежимахНалогообложения(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СправкаОбОплатеУслугДляНалоговогоВычета") Тогда

		СтандартнаяОбработка = Ложь;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СправкаОбОплатеУслугДляНалоговогоВычета.Организация КАК Организация,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.НалоговыйОрган КАК НалоговыйОрган,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.ОтчетныйГод КАК ОтчетныйГод,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.ВидСправки КАК ВидСправки,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.НомерСведений КАК НомерСведений,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.НомерКорректировки КАК НомерКорректировки,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.Налогоплательщик КАК Налогоплательщик,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикФамилия КАК НалогоплательщикФамилия,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИмя КАК НалогоплательщикИмя,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикОтчество КАК НалогоплательщикОтчество,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИНН КАК НалогоплательщикИНН,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДатаРождения КАК НалогоплательщикДатаРождения,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДокументВид КАК НалогоплательщикДокументВид,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДокументНомер КАК НалогоплательщикДокументНомер,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикДокументДата КАК НалогоплательщикДокументДата,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.НалогоплательщикИПолучательУслугиОдноЛицо КАК
			|		НалогоплательщикИПолучательУслугиОдноЛицо,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.Получатель КАК Получатель,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательФамилия КАК ПолучательФамилия,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательИмя КАК ПолучательИмя,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательОтчество КАК ПолучательОтчество,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательИНН КАК ПолучательИНН,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДатаРождения КАК ПолучательДатаРождения,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДокументВид КАК ПолучательДокументВид,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДокументНомер КАК ПолучательДокументНомер,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.ПолучательДокументДата КАК ПолучательДокументДата,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.ОбразованиеОчнаяФорма КАК ОбразованиеОчнаяФорма,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.ОбразованиеСуммаРасходов КАК ОбразованиеСуммаРасходов,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.МедицинаСуммаРасходов1 КАК МедицинаСуммаРасходов1,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.МедицинаСуммаРасходов2 КАК МедицинаСуммаРасходов2,
			|	СправкаОбОплатеУслугДляНалоговогоВычета.ФизкультураСуммаРасходов КАК ФизкультураСуммаРасходов
			|ИЗ
			|	Документ.СправкаОбОплатеУслугДляНалоговогоВычета КАК СправкаОбОплатеУслугДляНалоговогоВычета
			|ГДЕ
			|	СправкаОбОплатеУслугДляНалоговогоВычета.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка, , "НомерСведений, НомерКорректировки");
		Если Выборка.НомерКорректировки = 999 Тогда
			// Документ создается на основании аннулированной справки, ему должен быть присвоен новый номер.
			НомерКорректировки = 0;
		Иначе
			НомерСведений = Выборка.НомерСведений;
			НомерКорректировки = Выборка.НомерКорректировки + 1;
		КонецЕсли;
		
		Основание = ДанныеЗаполнения;
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОбязательныеПоля(Отказ) Экспорт
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не указана организация.'"), ЭтотОбъект, "Организация", "Объект", Отказ);
		Возврат;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьДанныеДокумента(Отказ, НеблокирующиеПроверки = Истина) Экспорт
	ДополнительныеСвойства.Вставить("НеблокирующиеПроверки", НеблокирующиеПроверки);
	
	Если Не ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Ошибки = Неопределено;
	ДополнительныеСвойства.Свойство("Ошибки", Ошибки);
КонецПроцедуры

Процедура ПроверкаНомераСведенийВДокументах(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СправкаОбОплатеУслугДляНалоговогоВычета.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СправкаОбОплатеУслугДляНалоговогоВычета КАК СправкаОбОплатеУслугДляНалоговогоВычета
		|ГДЕ
		|	СправкаОбОплатеУслугДляНалоговогоВычета.Проведен = &Проведен
		|	И СправкаОбОплатеУслугДляНалоговогоВычета.Организация = &Организация
		|	И СправкаОбОплатеУслугДляНалоговогоВычета.НалоговыйОрган = &НалоговыйОрган
		|	И СправкаОбОплатеУслугДляНалоговогоВычета.ОтчетныйГод = &ОтчетныйГод
		|	И СправкаОбОплатеУслугДляНалоговогоВычета.НомерСведений = &НомерСведений
		|	И СправкаОбОплатеУслугДляНалоговогоВычета.НомерКорректировки = &НомерКорректировки
		|	И СправкаОбОплатеУслугДляНалоговогоВычета.Ссылка <> &ТекущийДокумент";
	
	Запрос.УстановитьПараметр("НалоговыйОрган",			НалоговыйОрган);
	Запрос.УстановитьПараметр("НомерСведений",			НомерСведений);
	Запрос.УстановитьПараметр("НомерКорректировки",		НомерКорректировки);
	Запрос.УстановитьПараметр("Организация",			Организация);
	Запрос.УстановитьПараметр("ОтчетныйГод",			ОтчетныйГод);
	Запрос.УстановитьПараметр("ТекущийДокумент",		Ссылка);
	Запрос.УстановитьПараметр("Проведен",				Истина);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
	
		Отказ = Истина;
		ТекстОшибки = НСтр("ru='Заданный в документе номер сведений %1 уже используется в документе %2. 
					|Необходимо установить другой номер сведений или очистить поле для автоматического заполнения.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, НомерСведений, ВыборкаДетальныеЗаписи.Ссылка);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "НомерСведений", "Объект");
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверкаРанееВыданныхСправок(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ВыданныеСправкиОбОплатеУслугОбороты.Регистратор КАК Регистратор,
		|	ВыданныеСправкиОбОплатеУслугОбороты.Регистратор.НомерСведений КАК НомерСведений,
		|	ВыданныеСправкиОбОплатеУслугОбороты.Регистратор.НомерКорректировки КАК НомерКорректировки,
		|	ВыданныеСправкиОбОплатеУслугОбороты.СуммаОборот КАК Сумма
		|ИЗ
		|	РегистрНакопления.ВыданныеСправкиОбОплатеУслуг.Обороты(
		|			,
		|			,
		|			Регистратор,
		|			Организация = &Организация
		|				И ВидСправки = &ВидСправки
		|				И ОтчетныйГод = &ОтчетныйГод
		|				И Налогоплательщик = &Налогоплательщик
		|				И Получатель = &Получатель) КАК ВыданныеСправкиОбОплатеУслугОбороты
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСведений УБЫВ,
		|	НомерКорректировки УБЫВ";
	
	Запрос.УстановитьПараметр("Организация",			Организация);
	Запрос.УстановитьПараметр("Налогоплательщик",		Налогоплательщик);
	Запрос.УстановитьПараметр("Получатель",				Получатель);
	Запрос.УстановитьПараметр("ВидСправки",				ВидСправки);
	Запрос.УстановитьПараметр("ОтчетныйГод",			ОтчетныйГод);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.Регистратор = Ссылка Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.НомерСведений <> НомерСведений И ВыборкаДетальныеЗаписи.НомерКорректировки <> 999 Тогда
			// Для аннулирующей справки оставляем возможность ввода справки с новым номером.
			// Если старая справка была аннулирована, а затем создана новая, то ей должен быть присвоен новый номер.
			// В случае, когда старая справка не была аннулирована (корректировка не 999), проводить документ не допустимо.
			Отказ = Истина;
			ТекстОшибки = НСтр("ru='Для выбранного налогоплательщика и получателя услуги в отчетном периоде ранее выдана справка по текущему виду услуги:
						|%1, на сумму: %2.
						|Для изменения данных необходимо ввести корректирующую справку на основании ранее выданной.'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ВыборкаДетальныеЗаписи.Регистратор, ВыборкаДетальныеЗаписи.Сумма);
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Налогоплательщик", "Объект");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПредыдущийНомерСведений()
	
	ПредыдущийНомерСведений = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СправкаОбОплатеУслугДляНалоговогоВычета.НомерСведений КАК НомерСведений
		|ИЗ
		|	Документ.СправкаОбОплатеУслугДляНалоговогоВычета КАК СправкаОбОплатеУслугДляНалоговогоВычета
		|ГДЕ
		|	СправкаОбОплатеУслугДляНалоговогоВычета.Организация = &Организация
		|	И СправкаОбОплатеУслугДляНалоговогоВычета.НалоговыйОрган = &НалоговыйОрган
		|	И СправкаОбОплатеУслугДляНалоговогоВычета.ОтчетныйГод = &ОтчетныйГод
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСведений УБЫВ";
	
	Запрос.УстановитьПараметр("НалоговыйОрган", НалоговыйОрган);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОтчетныйГод", ОтчетныйГод);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ПредыдущийНомерСведений = ВыборкаДетальныеЗаписи.НомерСведений;
	КонецЕсли;
	
	Возврат ПредыдущийНомерСведений;
	
КонецФункции

Процедура АктуализироватьУведомлениеОСпецрежимахНалогообложения(ТекущийОбъект)
	
	Если Не ТребуетсяАктуализация(ТекущийОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ГоловнаяОрганизация         = РегламентированнаяОтчетность.ГоловнаяОрганизация(ТекущийОбъект.Организация);
	РегистрацияВНалоговомОргане = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГоловнаяОрганизация, "РегистрацияВНалоговомОргане");
	
	Если Не ЗначениеЗаполнено(ТекущийОбъект.Ссылка) Тогда
		СсылкаОбъекта = Документы.СправкаОбОплатеУслугДляНалоговогоВычета.ПолучитьСсылку();
		ТекущийОбъект.УстановитьСсылкуНового(СсылкаОбъекта);
	Иначе
		СсылкаОбъекта = ТекущийОбъект.Ссылка;
	КонецЕсли;
	
	// Титульный
	ДанныеУведомленияТитульный = Новый Структура;
	ДанныеУведомленияТитульный.Вставить("ОтчГод", Формат(ТекущийОбъект.ОтчетныйГод, "ДФ=yyyy"));
	
	СтрокаСведений = "ИННЮЛ,НаимЮЛПол,КППЮЛ,ТелОрганизации,ФамилияРук,ИмяРук,ОтчествоРук";
	СведенияОбОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(
		ГоловнаяОрганизация,
		ТекущийОбъект.Дата,
		СтрокаСведений);
	ДанныеУведомленияТитульный.Вставить("ИНН",     СведенияОбОрганизации.ИННЮЛ);
	ДанныеУведомленияТитульный.Вставить("НаимОрг", СведенияОбОрганизации.НаимЮЛПол);
	ДанныеУведомленияТитульный.Вставить("КПП",     СведенияОбОрганизации.КППЮЛ);
	ДанныеУведомленияТитульный.Вставить("Тлф",     СведенияОбОрганизации.ТелОрганизации);

	ДанныеУведомленияТитульный.Вставить("ДАТА_ПОДПИСИ",     ТекущийОбъект.Дата);
	ДанныеУведомленияТитульный.Вставить("РегистрацияВИФНС", РегистрацияВНалоговомОргане);
	
	Реквизиты = РегистрацияВНОСервер.ДанныеРегистрации(РегистрацияВНалоговомОргане);
	ДанныеУведомленияТитульный.Вставить("КодНО", Реквизиты.Код);
	ДанныеУведомленияТитульный.Вставить("КПП",   Реквизиты.КПП);
	
	ПодписантФамилия  = "";
	ПодписантИмя      = "";
	ПодписантОтчество = "";
	Если ЗначениеЗаполнено(Реквизиты.Представитель) Тогда
		СведенияОПредставителе = РегламентированнаяОтчетностьВызовСервера.ПолучитьПоКодамСведенияОПредставителе(
			ТекущийОбъект.Организация,
			ДанныеУведомленияТитульный["КодНО"], 
			ДанныеУведомленияТитульный["КПП"]);
		Если ЗначениеЗаполнено(СведенияОПредставителе.НаименованиеОрганизацииПредставителя) Тогда
			ПодписантСтр = СведенияОПредставителе.ФИОПредставителя;
			ФИО = РегламентированнаяОтчетность.РазложитьФИО(ПодписантСтр);
			ПодписантФамилия = СокрЛП(ФИО.Фамилия);
			ПодписантИмя = СокрЛП(ФИО.Имя);
			ПодписантОтчество = СокрЛП(ФИО.Отчество);
		Иначе
			ДанныеПредставителя = РегламентированнаяОтчетностьПереопределяемый.ПолучитьСведенияОФизЛице(
				Реквизиты.Представитель,
				,
				ТекущийОбъект.Дата);
			ПодписантФамилия  = СокрЛП(ДанныеПредставителя.Фамилия);
			ПодписантИмя      = СокрЛП(ДанныеПредставителя.Имя);
			ПодписантОтчество = СокрЛП(ДанныеПредставителя.Отчество);
			ПодписантСтр = СокрЛП(ПодписантФамилия + " " + ПодписантИмя + " " + ПодписантОтчество);
		КонецЕсли;
		ДанныеУведомленияТитульный.Вставить("ФИО_РУКОВОДИТЕЛЯ_ПРЕДСТАВИТЕЛЯ", ПодписантСтр);
		ДанныеУведомленияТитульный.Вставить("НаимОргПред",                    СведенияОПредставителе.НаименованиеОрганизацииПредставителя);
		ДанныеУведомленияТитульный.Вставить("ПРИЗНАК_НП_ПОДВАЛ",              "2");
		ДанныеУведомленияТитульный.Вставить("НаимДок",                        Реквизиты.ДокументПредставителя);
	Иначе

		ПодписантФамилия  = СведенияОбОрганизации.ФамилияРук;
		ПодписантИмя      = СведенияОбОрганизации.ИмяРук;
		ПодписантОтчество = СведенияОбОрганизации.ОтчествоРук;

		ПодписантСтр = СокрЛП(ПодписантФамилия + " " + ПодписантИмя + " " + ПодписантОтчество);
		ДанныеУведомленияТитульный.Вставить("ФИО_РУКОВОДИТЕЛЯ_ПРЕДСТАВИТЕЛЯ", ПодписантСтр);
		ДанныеУведомленияТитульный.Вставить("ПРИЗНАК_НП_ПОДВАЛ",              "1");
		ДанныеУведомленияТитульный.Вставить("НаимДок",                        "");
	КонецЕсли;
	
	ПараметрыЗаявления = Новый Структура;
	ПараметрыЗаявления.Вставить("Организация",                 ГоловнаяОрганизация);
	ПараметрыЗаявления.Вставить("РегистрацияВИФНС",            РегистрацияВНалоговомОргане);
	ПараметрыЗаявления.Вставить("Титульная",                   ДанныеУведомленияТитульный);
	ПараметрыЗаявления.Вставить("ПодписантФамилия",            ПодписантФамилия);
	ПараметрыЗаявления.Вставить("ПодписантИмя",                ПодписантИмя);
	ПараметрыЗаявления.Вставить("ПодписантОтчество",           ПодписантОтчество);
	ПараметрыЗаявления.Вставить("ДокументОснование",           СсылкаОбъекта);
	ПараметрыЗаявления.Вставить("ДатаОснования",               Дата);
	ПараметрыЗаявления.Вставить("КомментарийОснования",        Комментарий);
	ПараметрыЗаявления.Вставить("РазрешитьВыгружатьСОшибками", ТекущийОбъект.РазрешитьВыгружатьСОшибками);
	
	// Данные справки (общие для разных видов справок).
	СведенияОбУслуге = Новый Структура;
	СведенияОбУслуге.Вставить("НомерСвед",		Формат(ТекущийОбъект.НомерСведений, "ЧГ="));
	СведенияОбУслуге.Вставить("НомКорр",		ТекущийОбъект.НомерКорректировки);
	
	СведенияОбУслуге.Вставить("ИННФЛ",			ТекущийОбъект.НалогоплательщикИНН);
	СведенияОбУслуге.Вставить("ДатаРожд",		Формат(ТекущийОбъект.НалогоплательщикДатаРождения, "ДФ=dd.MM.yyyy"));

	СведенияОбУслуге.Вставить("Фамилия",		ТекущийОбъект.НалогоплательщикФамилия);
	СведенияОбУслуге.Вставить("Имя",			ТекущийОбъект.НалогоплательщикИмя);
	СведенияОбУслуге.Вставить("Отчество",		ТекущийОбъект.НалогоплательщикОтчество);

	СведенияОбУслуге.Вставить("КодВидДок",		ТекущийОбъект.НалогоплательщикДокументВид);
	СведенияОбУслуге.Вставить("СерНомДок",		ТекущийОбъект.НалогоплательщикДокументНомер);
	СведенияОбУслуге.Вставить("ДатаДок",		Формат(ТекущийОбъект.НалогоплательщикДокументДата, "ДФ=dd.MM.yyyy"));

	Если НЕ ТекущийОбъект.НалогоплательщикИПолучательУслугиОдноЛицо Тогда
		СведенияОбУслуге.Вставить("ИННФЛПолучатель",	ТекущийОбъект.ПолучательИНН);
		СведенияОбУслуге.Вставить("ДатаРождПолучатель",	Формат(ТекущийОбъект.ПолучательДатаРождения, "ДФ=dd.MM.yyyy"));

		СведенияОбУслуге.Вставить("ФамилияПолучатель",	ТекущийОбъект.ПолучательФамилия);
		СведенияОбУслуге.Вставить("ИмяПолучатель",		ТекущийОбъект.ПолучательИмя);
		СведенияОбУслуге.Вставить("ОтчествоПолучатель",	ТекущийОбъект.ПолучательОтчество);

		СведенияОбУслуге.Вставить("КодВидДокПолучатель",ТекущийОбъект.ПолучательДокументВид);
		СведенияОбУслуге.Вставить("СерНомДокПолучатель",ТекущийОбъект.ПолучательДокументНомер);
		СведенияОбУслуге.Вставить("ДатаДокПолучатель",	Формат(ТекущийОбъект.ПолучательДокументДата, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	Если ТекущийОбъект.ВидСправки = Перечисления.ВидыСправокДляНалоговогоВычета.ОбразовательныеУслуги Тогда
		
		СведенияОбУслуге.Вставить("ПрОбуч",		Формат(ТекущийОбъект.НалогоплательщикИПолучательУслугиОдноЛицо, "БЛ=0; БИ=1"));
		СведенияОбУслуге.Вставить("ПрФормОбуч",	Формат(ТекущийОбъект.ОбразованиеОчнаяФорма, "БЛ=0; БИ=1"));
		СведенияОбУслуге.Вставить("СуммаРасх",	ТекущийОбъект.ОбразованиеСуммаРасходов);
		
		ПараметрыЗаявления.Вставить("СведенияОбУслуге", СведенияОбУслуге);
		
	ИначеЕсли ТекущийОбъект.ВидСправки = Перечисления.ВидыСправокДляНалоговогоВычета.МедицинскиеУслуги Тогда
		
		СведенияОбУслуге.Вставить("ПрПациент",	Формат(ТекущийОбъект.НалогоплательщикИПолучательУслугиОдноЛицо, "БЛ=0; БИ=1"));
		СведенияОбУслуге.Вставить("СуммаКод1",	ТекущийОбъект.МедицинаСуммаРасходов1);
		СведенияОбУслуге.Вставить("СуммаКод2",	ТекущийОбъект.МедицинаСуммаРасходов2);
		
		ПараметрыЗаявления.Вставить("СведенияОбУслуге", СведенияОбУслуге);
		
	ИначеЕсли ТекущийОбъект.ВидСправки = Перечисления.ВидыСправокДляНалоговогоВычета.ФизкультурноОздоровительныеУслуги Тогда
			
		СведенияОбУслуге.Вставить("ПрКлиент",	Формат(ТекущийОбъект.НалогоплательщикИПолучательУслугиОдноЛицо, "БЛ=0; БИ=1"));
		СведенияОбУслуге.Вставить("СуммаРасх",	ТекущийОбъект.ФизкультураСуммаРасходов);
		
		ПараметрыЗаявления.Вставить("СведенияОбУслуге", СведенияОбУслуге);
		
	КонецЕсли;
	
КонецПроцедуры

