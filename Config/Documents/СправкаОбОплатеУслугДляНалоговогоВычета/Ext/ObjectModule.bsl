Процедура ПроверитьИспользованиеВАктуальныхЖурналах(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЖурналСправокОбОплатеУслугСправки.Ссылка КАК ЖурналСправокСсылка
		|ИЗ
		|	Документ.ЖурналСправокОбОплатеУслуг.Справки КАК ЖурналСправокОбОплатеУслугСправки
		|ГДЕ
		|	ЖурналСправокОбОплатеУслугСправки.СправкаОбОплатеУслуг = &СправкаОбОплатеУслуг
		|	И ЖурналСправокОбОплатеУслугСправки.Ссылка.Организация = &Организация
		|	И ЖурналСправокОбОплатеУслугСправки.Ссылка.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("Организация",			Организация);
	Запрос.УстановитьПараметр("СправкаОбОплатеУслуг",	Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Отказ = Истина;
		ТекстОшибки = НСтр("ru='Документ уже используется в проведенном документе %1. 
					|Для отмены проведения справки предварительно должно быть отменено проведение журнала справок.'");
