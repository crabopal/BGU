&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Основание");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Основание", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРеквизитыНалогоплательщика()
	
	Объект.НалогоплательщикФамилия = Неопределено;
	Объект.НалогоплательщикИмя = Неопределено;
	Объект.НалогоплательщикОтчество = Неопределено;
	Объект.НалогоплательщикИНН = Неопределено;
	Объект.НалогоплательщикДатаРождения = Неопределено;
	Объект.НалогоплательщикДокументВид = Неопределено;
	Объект.НалогоплательщикДокументНомер = Неопределено;
	Объект.НалогоплательщикДокументДата = Неопределено;
	
КонецПроцедуры

