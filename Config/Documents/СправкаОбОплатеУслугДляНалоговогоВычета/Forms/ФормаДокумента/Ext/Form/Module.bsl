&НаСервере
Функция ВыборкаСДаннымиУведомления()
	Запрос = Новый Запрос(СправкаОбОплатеУслугВызовСервера.ТекстЗапросаСвязиСправкиИУведомления());
	Запрос.УстановитьПараметр("СправкаОбОплатеУслуг", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка, Неопределено);
КонецФункции

&НаСервере
Процедура ПроверитьНаСервере(Отказ = Ложь, ЕстьКритичныеОшибки = Ложь, ТаблицаОшибок, НеблокирующиеПроверки = Истина)
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ПроверитьОбязательныеПоля(ЕстьКритичныеОшибки);
	Если ЕстьКритичныеОшибки Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект.ПроверитьДанныеДокумента(Отказ, НеблокирующиеПроверки);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = ВыборкаСДаннымиУведомления();
	Если ТипЗнч(Выборка) = Тип("ВыборкаИзРезультатаЗапроса") Тогда 
		УведомлениеОбъект = Выборка.Уведомление.ПолучитьОбъект();
		ТаблицаОшибок = Отчеты[УведомлениеОбъект.ИмяОтчета].ПроверитьСправкуСВыводомВТаблицу(УведомлениеОбъект, Выборка.УИД);
		Отказ = ТаблицаОшибок.Количество() > 0;
	ИначеЕсли Выборка = Неопределено Тогда
		ТаблицаОшибок = Новый СписокЗначений;
		ТаблицаОшибок.Добавить(Документы.УведомлениеОСпецрежимахНалогообложения.ПолучитьПустуюСтруктуруНавигацииПоОшибкам(
			"Не найден проведенный журнал справок содержащий данную справку", "Титульная", ""));
		Отказ = Истина;
	Иначе
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПоказатьСДвухмернымШтрихкодомPDF417() Экспорт
	ОчиститьСообщения();
	ДополнительныеПараметры = Новый Структура();
	
	Если Не Объект.Проведен Или Модифицированность Тогда 
		ТекстВопроса = НСтр("ru = 'Для выполнения команды необходимо предварительно провести документ.
			|Выполнить проведение документа и продолжить?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
		Если Ждать ВопросАсинх(ТекстВопроса, Кнопки) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
		Если Не Объект.Проведен Или Модифицированность Тогда
			Если Не Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда 
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Отказ               = Ложь;
	ЕстьКритичныеОшибки = Ложь;
	ТаблицаОшибок       = Новый СписокЗначений;
	
	ПроверитьНаСервере(Отказ, ЕстьКритичныеОшибки, ТаблицаОшибок);
	ДополнительныеПараметры.Вставить("ТаблицаОшибок", ТаблицаОшибок);
	
	Если ЕстьКритичныеОшибки Тогда 
		ТекстПредупреждения = НСтр("ru = 'Не заполнены обязательные поля.'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Если Не Отказ И ТаблицаОшибок.Количество() = 0 Тогда
		РегламентированнаяОтчетностьКлиент.ВывестиМашиночитаемуюФормуУведомленияОСпецрежимах(ЭтотОбъект);
	Иначе
		ОткрытьФорму("Документ.УведомлениеОСпецрежимахНалогообложения.Форма.НавигацияПоОшибкам",
			Новый Структура("ТаблицаОшибок", ТаблицаОшибок),
			ЭтотОбъект,
			Истина);
	КонецЕсли
КонецПроцедуры

&НаСервере
Функция СформироватьВыгрузкуИПолучитьДанные() Экспорт
	Выборка = ВыборкаСДаннымиУведомления();
	Если ТипЗнч(Выборка) <> Тип("ВыборкаИзРезультатаЗапроса") Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Отбор = Новый Структура("ИмяОтчета, ИмяФормы, ВидУведомления");
	ЗаполнитьЗначенияСвойств(Отбор, Выборка);
	ИнформацияОШаблоне = УведомлениеОСпецрежимахНалогообложения.ИнформацияПоМЧБШаблонуСправки(Отбор);
	Если ИнформацияОШаблоне = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Выгрузка = Отчеты[Выборка.ИмяОтчета].ЭлектронноеПредставлениеСправки(Выборка.Уведомление, Выборка.УИД);
	Если Выгрузка = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;
	Выгрузка = Выгрузка[0];
	СтруктураВыгрузки = Новый Структура("ТестВыгрузки,КодировкаВыгрузки", 
			Выгрузка.ТестВыгрузки, Выгрузка.КодировкаВыгрузки);
	СтруктураВыгрузки.Вставить("Данные", УведомлениеОСпецрежимахНалогообложения.ПолучитьМакетДвоичныхДанных(Выборка.ИмяОтчета, ИнформацияОШаблоне.ИмяМакета));
	СтруктураВыгрузки.Вставить("ИмяФайла", ИнформацияОШаблоне.ИмяФайла);
	Возврат СтруктураВыгрузки;
КонецФункции

&НаСервере
Функция СформироватьСправкуXMLНаСервере() Экспорт
	Выборка = ВыборкаСДаннымиУведомления();
	Если ТипЗнч(Выборка) = Тип("ВыборкаИзРезультатаЗапроса") Тогда 
		Возврат Отчеты[Выборка.ИмяОтчета].ЭлектронноеПредставлениеСправки(Выборка.Уведомление, Выборка.УИД);
	КонецЕсли;
КонецФункции

