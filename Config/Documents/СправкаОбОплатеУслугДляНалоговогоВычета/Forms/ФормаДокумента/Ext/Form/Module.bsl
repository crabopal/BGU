	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидДокументаФизическихЛиц, "КодФНС");
	
КонецФункции

&НаКлиенте
Процедура ОчиститьЗначенияСумм()
	
	Объект.ОбразованиеСуммаРасходов = 0;
	Объект.МедицинаСуммаРасходов1 = 0;
	Объект.ФизкультураСуммаРасходов = 0;
	Объект.НалогоплательщикСумма = 0;
	Объект.ПолучательСумма = 0;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДаннымУчетаНаСервере()
	
	Объект.ОбразованиеСуммаРасходов = 0;
	Объект.МедицинаСуммаРасходов1 = 0;
	Объект.ФизкультураСуммаРасходов = 0;
	Объект.НалогоплательщикСумма = 0;
	Объект.ПолучательСумма = 0;
	
	// Заполнение данных о расчетах выполняется по счету 205.00, с учетом отбора по налогоплательщику и договорам.
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ЖурналПроводокЕПСБУОбороты.СуммаОборотКт - ЖурналПроводокЕПСБУОбороты.СуммаОборотДт КАК СуммаПоступлений
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Счет = &СчетРасчетов,
	|			,
	|			Организация = &Организация
	|				И Субконто1 В (&СписокКонтрагенты)
	|				И &УсловиеДоговор,
	|			КорСчет В ИЕРАРХИИ (&КорСчетаРасчетов),
	|			) КАК ЖурналПроводокЕПСБУОбороты";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(Объект.ОтчетныйГод));
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецГода(Объект.ОтчетныйГод), ВидГраницы.Включая));
	
	Запрос.УстановитьПараметр("СчетРасчетов", СчетРасчетов(Объект.Дата, Объект.Организация));
	Запрос.УстановитьПараметр("КорСчетаРасчетов", КорСчетаРасчетов(Объект.Дата, Объект.Организация));
	
	СписокКонтрагенты = Новый Массив;
	СписокКонтрагенты.Добавить(Объект.Налогоплательщик);
	Если НЕ Объект.НалогоплательщикИПолучательУслугиОдноЛицо Тогда
		СписокКонтрагенты.Добавить(Объект.Получатель);
	КонецЕсли;
	Запрос.УстановитьПараметр("СписокКонтрагенты", СписокКонтрагенты);
	
	Если Объект.Отбор.Количество() > 0 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДоговор", "Субконто2 В (&УсловиеДоговор)");
		Запрос.УстановитьПараметр("УсловиеДоговор", Объект.Отбор.Выгрузить(,"Договор"));
	Иначе
		Запрос.УстановитьПараметр("УсловиеДоговор", Истина);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если Объект.ВидСправки = Перечисления.ВидыСправокДляНалоговогоВычета.ОбразовательныеУслуги Тогда
			Объект.ОбразованиеСуммаРасходов = Объект.ОбразованиеСуммаРасходов + ВыборкаДетальныеЗаписи.СуммаПоступлений;
		ИначеЕсли Объект.ВидСправки = Перечисления.ВидыСправокДляНалоговогоВычета.МедицинскиеУслуги Тогда
			Объект.МедицинаСуммаРасходов1 = Объект.МедицинаСуммаРасходов1 + ВыборкаДетальныеЗаписи.СуммаПоступлений;
		ИначеЕсли Объект.ВидСправки = Перечисления.ВидыСправокДляНалоговогоВычета.ФизкультурноОздоровительныеУслуги Тогда
			Объект.ФизкультураСуммаРасходов = Объект.ФизкультураСуммаРасходов + ВыборкаДетальныеЗаписи.СуммаПоступлений;
		КонецЕсли;
		
		Если НЕ Объект.НалогоплательщикИПолучательУслугиОдноЛицо И ВыборкаДетальныеЗаписи.Контрагент = Объект.Получатель Тогда
			Объект.ПолучательСумма = Объект.ПолучательСумма + ВыборкаДетальныеЗаписи.СуммаПоступлений;
		Иначе
			Объект.НалогоплательщикСумма = Объект.НалогоплательщикСумма + ВыборкаДетальныеЗаписи.СуммаПоступлений;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ТаблицаОтбораВХранилище(АдресХранилища = "")
	
	Если ПустаяСтрока(АдресХранилища) Тогда
		Результат = ПоместитьВоВременноеХранилище(Объект.Отбор.Выгрузить(), УникальныйИдентификатор);
	Иначе
		ТаблицаОтбора = ПолучитьИзВременногоХранилища(АдресХранилища); 
		Объект.Отбор.Загрузить(ТаблицаОтбора);
		ОтборОбновитьТекстГиперссылки();
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОткрытьОтчетОборотыСчета()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	
	ПараметрыФормы.Вставить("РежимРасшифровки", Истина);
	ПараметрыФормы.Вставить("ВидРасшифровки", 2);
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	
	ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
	
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("Организация",   Объект.Организация);
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("НачалоПериода", НачалоГода(Объект.ОтчетныйГод));
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("КонецПериода",  КонецГода(Объект.ОтчетныйГод));
	
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПоСубсчетам", Истина);
	
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПоказательБУ",              Истина);
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПоказательНеУчитываетсяНУ", Ложь);
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПоказательЕНВД",            Ложь);
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПоказательНДС",             Ложь);
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПоказательВалютнаяСумма",   Ложь);
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ПоказательКоличество",      Ложь);
	
	// Группировки.
	ГруппировкиОтчета = Новый Массив;
	
	// Группировка Контрагент.
	ОписаниеГруппировки = Новый Структура;
	ОписаниеГруппировки.Вставить("Использование",  Истина);
	ОписаниеГруппировки.Вставить("Поле",           "Субконто1");
	ОписаниеГруппировки.Вставить("Представление",  "Контрагенты");
	ОписаниеГруппировки.Вставить("ТипГруппировки", 0);
	ГруппировкиОтчета.Добавить(ОписаниеГруппировки);
	
	// Группировка Договор.
	ОписаниеГруппировки = Новый Структура;
	ОписаниеГруппировки.Вставить("Использование",  Истина);
	ОписаниеГруппировки.Вставить("Поле",           "Субконто2");
	ОписаниеГруппировки.Вставить("Представление",  "Договоры");
	ОписаниеГруппировки.Вставить("ТипГруппировки", 0);
	ГруппировкиОтчета.Добавить(ОписаниеГруппировки);
	
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("Группировка", ГруппировкиОтчета);
	
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("Счет", СчетРасчетов(Объект.Дата, Объект.Организация));
	
	// Отбор.
	Отбор = ПользовательскиеНастройки.Элементы.Добавить(Тип("ОтборКомпоновкиДанных"));
	Отбор.ИдентификаторПользовательскойНастройки = "Отбор";
	
	СписокКорСчетов = новый СписокЗначений;
	СписокКорСчетов.ЗагрузитьЗначения(КорСчетаРасчетов(Объект.Дата, Объект.Организация));
	СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Отбор, "КорСчет",
		СписокКорСчетов, ВидСравненияКомпоновкиДанных.ВСписке, Истина);
	
	СписокКонтрагенты = Новый СписокЗначений;
	СписокКонтрагенты.Добавить(Объект.Налогоплательщик);
	Если НЕ Объект.НалогоплательщикИПолучательУслугиОдноЛицо Тогда
		СписокКонтрагенты.Добавить(Объект.Получатель);
	КонецЕсли;
	СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Отбор, "Субконто1",
		СписокКонтрагенты, ВидСравненияКомпоновкиДанных.ВСписке, Истина);
	
	Если Объект.Отбор.Количество() > 0 Тогда
		СписокДоговоры = Новый СписокЗначений;
		Для Каждого СтрокаОтбора Из Объект.Отбор Цикл
			СписокДоговоры.Добавить(СтрокаОтбора.Договор);
		КонецЦикла;
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Отбор, "Субконто2",
			СписокДоговоры, ВидСравненияКомпоновкиДанных.ВСписке, Истина);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ПользовательскиеНастройки", ПользовательскиеНастройки);
	
	ОткрытьФорму("Отчет.ОборотыСчета.Форма", ПараметрыФормы, ЭтотОбъект, Новый УникальныйИдентификатор);
	
КонецФункции

&НаСервереБезКонтекста
Функция СчетРасчетов(Дата, Организация)
	
	Возврат БухгалтерскийУчет.СчетПоКоду("205.31", Дата, Организация);
	
КонецФункции

&НаСервереБезКонтекста
Функция КорСчетаРасчетов(Дата, Организация)
	
	КодыКорСчетов = Новый Структура;
	КодыКорСчетов.Вставить("СчетКазначейство",	"201.11");
	КодыКорСчетов.Вставить("СчетБанкРубли",		"201.21");
	КодыКорСчетов.Вставить("СчетЭквайрингРубли","201.23");
	КодыКорСчетов.Вставить("СчетБанкВалюта",	"201.27");
	КодыКорСчетов.Вставить("СчетКасса",			"201.34");
	КодыКорСчетов.Вставить("СчетКомиссии",		"210.05");
	КодыКорСчетов.Вставить("СчетФинорган",		"210.02");
	
	КорСчета = Новый Массив;
	Для Каждого КорСчетИзСписка Из КодыКорСчетов Цикл
		КорСчета.Добавить(БухгалтерскийУчет.СчетПоКоду(КорСчетИзСписка.Значение, Дата, Организация));
	КонецЦикла;
	
	Возврат КорСчета;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаВыбораПлательщикаИПолучателя(Налогоплательщик, Получатель)
	
	Если ЗначениеЗаполнено(Получатель) И Получатель = Налогоплательщик Тогда
		
		Объект.НалогоплательщикИПолучательУслугиОдноЛицо = Истина;
		ОчиститьРеквизитыПолучателяУслуги();
		УстановитьВидимостьРеквизитовПолучательУслуги();
		
		ПоказатьПредупреждение(,НСтр("ru = 'Выбран тот же получатель услуги, что и налогоплательщик. 
								|В этом случае заполнение получателя услуги не требуется.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьФизлицаПоСправочникуДети(СправочникДетиСсылка)
	
	НалогоплательщикЗаполнен = Ложь;
	
	Если ЗначениеЗаполнено(СправочникДетиСсылка) Тогда
		ДанныеРебенка = РодительскаяПлата.ДанныеРебенка(СправочникДетиСсылка, Объект.Организация, Объект.Дата);
		Объект.Отбор.Очистить();
		ОтборОбновитьТекстГиперссылки();
		
		Если ЗначениеЗаполнено(ДанныеРебенка.Плательщик) Тогда
			Объект.Налогоплательщик = ДанныеРебенка.Плательщик.Плательщик;
			Объект.НалогоплательщикИПолучательУслугиОдноЛицо = Ложь;
			ЗаполнитьПараметрыФизЛица(Объект.Налогоплательщик, "Налогоплательщик");
			
			Объект.Получатель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СправочникДетиСсылка, "Контрагент");
			ЗаполнитьПараметрыФизЛица(Объект.Получатель, "Получатель");
			
			НалогоплательщикЗаполнен = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НалогоплательщикЗаполнен;
	
КонецФункции

&НаСервере
Функция ЗаполнитьФизлицаПоСправочникуСтуденты(СправочникСтудентыСсылка)
	
	ПлательщикиПоУчащемуся = Новый Массив;
	
	Если ЗначениеЗаполнено(СправочникСтудентыСсылка) Тогда
		
		ДанныеПлательщиков = РаботаСоСтудентами.СписокПлательщиковФизлицПоСтуденту(СправочникСтудентыСсылка,Объект.Дата);
		Объект.Отбор.Очистить();
		ОтборОбновитьТекстГиперссылки();
		
		Если ДанныеПлательщиков.Количество() = 0 Тогда
			// Для учащегося нет плательщиков - физлиц, указывается единственный плательщик, сам учащийся.
			Объект.Налогоплательщик = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СправочникСтудентыСсылка, "Контрагент");
			Объект.НалогоплательщикИПолучательУслугиОдноЛицо = Истина;
			ЗаполнитьПараметрыФизЛица(Объект.Налогоплательщик, "Налогоплательщик");
			
		Иначе
			КонтрагентСтудента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СправочникСтудентыСсылка, "Контрагент");
			Если ДанныеПлательщиков.Количество() = 1 Тогда
				Если ДанныеПлательщиков[0].Контрагент = КонтрагентСтудента Тогда
					// Единственный плательщик - сам учащийся.
					Объект.Налогоплательщик = КонтрагентСтудента;
					Объект.НалогоплательщикИПолучательУслугиОдноЛицо = Истина;
					ЗаполнитьПараметрыФизЛица(Объект.Налогоплательщик, "Налогоплательщик");
					
				Иначе
					// Единственный плательщик - другое физическое лицо.
					Объект.Налогоплательщик = ДанныеПлательщиков[0].Контрагент;
					Объект.НалогоплательщикИПолучательУслугиОдноЛицо = Ложь;
					ЗаполнитьПараметрыФизЛица(Объект.Налогоплательщик, "Налогоплательщик");
					
					Объект.Получатель = КонтрагентСтудента;
					ЗаполнитьПараметрыФизЛица(Объект.Получатель, "Получатель");
					
				КонецЕсли;
			Иначе
				Объект.Получатель = КонтрагентСтудента;
				ЗаполнитьПараметрыФизЛица(Объект.Получатель, "Получатель");
				
				Объект.Налогоплательщик = Неопределено;
				Объект.НалогоплательщикИПолучательУслугиОдноЛицо = Ложь;
				
				Для Каждого СтрокаПлательщик Из ДанныеПлательщиков Цикл
					ПлательщикиПоУчащемуся.Добавить(СтрокаПлательщик.Контрагент);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПлательщикиПоУчащемуся;
	
КонецФункции

&НаКлиенте
Асинх Процедура ВыбратьПлательщикаПоУчащемусяИзСписка(ПлательщикиПоУчащемуся)
	
	ПлательщикиСписок = Новый СписокЗначений;
	ПлательщикиСписок.ЗагрузитьЗначения(ПлательщикиПоУчащемуся);
	
	ВыбранныйЭлемент = Ждать ПлательщикиСписок.ВыбратьЭлементАсинх(
		СтрШаблон(НСтр("ru='Выбор плательщика по учащемуся %1'"), Объект.Получатель));
		
	Если ВыбранныйЭлемент <> Неопределено Тогда
		Объект.Налогоплательщик = ВыбранныйЭлемент.Значение;
		ЗаполнитьПараметрыФизЛица(Объект.Налогоплательщик, "Налогоплательщик");
		ОбработкаВыбораПлательщикаИПолучателя(Объект.Налогоплательщик, Объект.Получатель);
	КонецЕсли;
	
КонецПроцедуры

