
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если ЗначениеЗаполнено(Параметры.ВидСправки) Тогда
			Объект.ВидСправки = Параметры.ВидСправки;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.ОтчетныйГод) Тогда
			Объект.ОтчетныйГод = НачалоГода(ТекущаяДатаСеанса());
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Объект.ВидСправки) Тогда
			Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтудентов") ИЛИ ПолучитьФункциональнуюОпцию("ИспользоватьУчетРодительскойПлаты") Тогда
				Объект.ВидСправки = Перечисления.ВидыСправокДляНалоговогоВычета.ОбразовательныеУслуги;
			Иначе
				Объект.ВидСправки = Перечисления.ВидыСправокДляНалоговогоВычета.МедицинскиеУслуги;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			Объект.НалоговыйОрган = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "РегистрацияВНалоговомОргане");
		КонецЕсли;
		
		Объект.УИДСправкиВЖурнале = Новый УникальныйИдентификатор;
		
		ПодготовитьФормуНаСервере();
		
	КонецЕсли;
	
	Если Объект.НомерКорректировки = 999 Тогда
		Аннулирующая = Истина;
	КонецЕсли;
	
	Элементы.ВидСправки.Доступность = НЕ ЗначениеЗаполнено(Объект.Основание);
	
	Элементы.ФормаРазрешитьВыгружатьСОшибками.Пометка = Объект.РазрешитьВыгружатьСОшибками;
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	УстановитьВидимостьЭлементовПоВидуСправки();
	УстановитьВидимостьРеквизитовПолучательУслуги();
	
	ОтборОбновитьТекстГиперссылки();
	
	Если Объект.Проведен Тогда
		ЭтотОбъект.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.НастройкаОтбораПоДоговорам" Тогда
		
		ТаблицаОтбораВХранилище(ВыбранноеЗначение);
		Модифицированность = Истина;
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Дети") Тогда
		НалогоплательщикЗаполнен = ЗаполнитьФизлицаПоСправочникуДети(ВыбранноеЗначение);
		Если НЕ НалогоплательщикЗаполнен Тогда
			ТекстСообщения = НСтр("ru='Плательщик по выбранному элементу справочника ""Дети"" не найден. 
				|Необходимо заполнить реквизиты физических лиц вручную.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				Объект.Ссылка,
				"Объект.Налогоплательщик");
				
			ОчиститьРеквизитыПолучателяУслуги();
		КонецЕсли;
		
		УстановитьВидимостьРеквизитовПолучательУслуги();
		ОчиститьЗначенияСумм();
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Студенты") Тогда
		ПлательщикиПоУчащемуся = ЗаполнитьФизлицаПоСправочникуСтуденты(ВыбранноеЗначение);
		
		Если ПлательщикиПоУчащемуся.Количество() > 0 Тогда
			
			ОчиститьРеквизитыНалогоплательщика();
			ВыбратьПлательщикаПоУчащемусяИзСписка(ПлательщикиПоУчащемуся);
		КонецЕсли;
		
		УстановитьВидимостьРеквизитовПолучательУслуги();
		ОчиститьЗначенияСумм();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если Объект.Проведен Тогда
		ЭтотОбъект.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтчетныйГодПриИзменении(Элемент)
	
	Объект.ОтчетныйГод = НачалоГода(Объект.ОтчетныйГод);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетныйГодРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Направление = 1 Тогда
		Объект.ОтчетныйГод = ДобавитьМесяц(Объект.ОтчетныйГод, 12);
	Иначе
		Объект.ОтчетныйГод = ДобавитьМесяц(Объект.ОтчетныйГод, -12);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОрганизацияПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.НалоговыйОрган = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "РегистрацияВНалоговомОргане");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСправкиПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементовПоВидуСправки();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементовПоВидуСправки()
	
	Если Объект.ВидСправки = ПредопределенноеЗначение("Перечисление.ВидыСправокДляНалоговогоВычета.ОбразовательныеУслуги") Тогда
		Элементы.СтраницыДанныеПоВыбранномуВидуСправки.ТекущаяСтраница = Элементы.СтраницаОбразовательныеУслуги;
		Элементы.ГруппаЗаполнитьДанныеФизлиц.Видимость = Истина;
	ИначеЕсли  Объект.ВидСправки = ПредопределенноеЗначение("Перечисление.ВидыСправокДляНалоговогоВычета.МедицинскиеУслуги") Тогда
		Элементы.СтраницыДанныеПоВыбранномуВидуСправки.ТекущаяСтраница = Элементы.СтраницаМедицинскиеУслуги;
		Элементы.ГруппаЗаполнитьДанныеФизлиц.Видимость = Ложь;
	Иначе
		Элементы.СтраницыДанныеПоВыбранномуВидуСправки.ТекущаяСтраница = Элементы.СтраницаФизкультурноОздоровительныеУслуги;
		Элементы.ГруппаЗаполнитьДанныеФизлиц.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НалогоплательщикНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОтборСписка = Новый Структура;
	ОтборСписка.Вставить("ВидКонтрагента", ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо"));
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", ОтборСписка);
	ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.Налогоплательщик);
	ОткрытьФорму("Справочник.Контрагенты.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура НалогоплательщикПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Налогоплательщик) Тогда
		ЗаполнитьПараметрыФизЛица(Объект.Налогоплательщик, Элемент.Имя);
	Иначе
		ОчиститьРеквизитыНалогоплательщика();
	КонецЕсли;
	
	Объект.Отбор.Очистить();
	ОчиститьЗначенияСумм();
	ОтборОбновитьТекстГиперссылки();
	
КонецПроцедуры

&НаКлиенте
Процедура НалогоплательщикОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	
	ОбработкаВыбораПлательщикаИПолучателя(ВыбранноеЗначение, Объект.Получатель);
	
КонецПроцедуры

&НаКлиенте
Процедура НалогоплательщикИПолучательУслугиОдноЛицоПриИзменении(Элемент)
	
	Если Объект.НалогоплательщикИПолучательУслугиОдноЛицо Тогда
		Если ЗначениеЗаполнено(Объект.Получатель) И НЕ ЗначениеЗаполнено(Объект.Налогоплательщик) Тогда
			Объект.Налогоплательщик = Объект.Получатель;
			ЗаполнитьПараметрыФизЛица(Объект.Налогоплательщик, "Налогоплательщик");
		Иначе
			Объект.Получатель = Объект.Налогоплательщик;
		КонецЕсли;
	Иначе
		Объект.Получатель = Неопределено;
	КонецЕсли;
	
	ОчиститьРеквизитыПолучателяУслуги();
	УстановитьВидимостьРеквизитовПолучательУслуги();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучательНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОтборСписка = Новый Структура;
	ОтборСписка.Вставить("ВидКонтрагента", ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо"));
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", ОтборСписка);
	ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.Получатель);
	ОткрытьФорму("Справочник.Контрагенты.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучательПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Получатель) Тогда
		ЗаполнитьПараметрыФизЛица(Объект.Получатель, Элемент.Имя);
	Иначе
		ОчиститьРеквизитыПолучателяУслуги();
	КонецЕсли;
	
	ОчиститьЗначенияСумм();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучательОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	
	ОбработкаВыбораПлательщикаИПолучателя(Объект.Налогоплательщик, ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура НалогоплательщикДокументВидНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ОткрытьФорму("Справочник.ВидыДокументовФизическихЛиц.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура НалогоплательщикДокументВидОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КодДокумента = "";
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		КодДокумента = ПолучитьКодВидаДокумента(ВыбранноеЗначение);
	КонецЕсли;
	
	Объект.НалогоплательщикДокументВид = КодДокумента;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучательДокументВидНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ОткрытьФорму("Справочник.ВидыДокументовФизическихЛиц.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучательДокументВидОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КодДокумента = "";
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		КодДокумента = ПолучитьКодВидаДокумента(ВыбранноеЗначение);
	КонецЕсли;
	
	Объект.ПолучательДокументВид = КодДокумента;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерКорректировкиПриИзменении(Элемент)
	
	Если Объект.НомерКорректировки = 999 Тогда
		Аннулирующая = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АннулирующаяПриИзменении(Элемент)
	
	Если Аннулирующая = Истина Тогда
		ИсходныйНомерКорректировки = Объект.НомерКорректировки;
		Объект.НомерКорректировки = 999;
	Иначе
		Объект.НомерКорректировки = ИсходныйНомерКорректировки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Отбор

&НаКлиенте
Процедура НадписьОтборНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОтбора = Новый Структура();
	ПараметрыОтбора.Вставить("Организация", Объект.Организация);
	ПараметрыОтбора.Вставить("Дата", КонецГода(Объект.ОтчетныйГод));
	
	// Для случаев оплаты за услуги дошкольного учреждения, 
	// используется договор по контрагенту справочника "Дети".
	// Этот контрагент указывается в качестве "Получателя" услуги, 
	// для получения списка договоров, следует передать его в форму.
	
	ОтборКонтрагенты = Новый Массив;
	ОтборКонтрагенты.Добавить(Объект.Налогоплательщик);
	Если ЗначениеЗаполнено(Объект.Получатель) Тогда
		ОтборКонтрагенты.Добавить(Объект.Получатель);
	КонецЕсли;
	ПараметрыОтбора.Вставить("Контрагент", ОтборКонтрагенты);
	
	ПараметрыОтбора.Вставить("ИФО", Неопределено);
	ПараметрыОтбора.Вставить("КФО", Неопределено);
	
	ПараметрыФормы = Новый Структура("ПараметрыОтбора, Отбор, ТолькоПросмотр",
		ПараметрыОтбора, ТаблицаОтбораВХранилище(), ТолькоПросмотр);
	ОткрытьФорму("ОбщаяФорма.НастройкаОтбораПоДоговорам", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОтборОбновитьТекстГиперссылки()
	
	Если Объект.Отбор.Количество() = 0 Тогда
		ТекстГиперссылки = НСтр("ru = '<Без отбора>'");
	Иначе
		ТекстГиперссылки = "";
		Для Каждого СтрокаОтбора Из Объект.Отбор Цикл
			ТекстГиперссылки = ТекстГиперссылки + ?(ТекстГиперссылки = "", "", "; ") + СтрокаОтбора.Договор;
		КонецЦикла;
	КонецЕсли;
	
	НадписьОтбор = ТекстГиперссылки;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ВыгрузитьСправку(Команда)
	ОчиститьСообщения();
	Если Не Объект.Проведен Или Модифицированность Тогда 
		ТекстВопроса = НСтр("ru = 'Для выполнения команды необходимо предварительно провести документ.
			|Выполнить проведение документа и продолжить?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		Если Ждать ВопросАсинх(ТекстВопроса, Кнопки) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		Если Не Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда 
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ВыгружаемыеДанные = СформироватьСправкуXMLНаСервере();
	Если ВыгружаемыеДанные <> Неопределено Тогда 
		РегламентированнаяОтчетностьКлиент.ВыгрузитьФайлы(ВыгружаемыеДанные);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПроверитьВыгрузку(Команда)
	Если Модифицированность Тогда 
		ТекстВопроса = НСтр("ru = 'Для выполнения команды необходимо предварительно сохранить документ.
			|Выполнить сохранение документа и продолжить?'");
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		Если КодВозвратаДиалога.Да <> Ждать ВопросАсинх(ТекстВопроса, Кнопки) Тогда 
			Возврат;
		КонецЕсли;
		Если Не Записать() Тогда 
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОчиститьСообщения();
	Отказ               = Ложь;
	ЕстьКритичныеОшибки = Ложь;
	ТаблицаОшибок       = Новый СписокЗначений;
	
	ПроверитьНаСервере(Отказ, ЕстьКритичныеОшибки, ТаблицаОшибок, Ложь);
	
	Если ЕстьКритичныеОшибки Тогда 
		ТекстПредупреждения = НСтр("ru = 'Не заполнены обязательные поля.'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Если Не Отказ И ТаблицаОшибок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибок не обнаружено");
	Иначе
		ОткрытьФорму("Документ.УведомлениеОСпецрежимахНалогообложения.Форма.НавигацияПоОшибкам",
			Новый Структура("ТаблицаОшибок", ТаблицаОшибок),
			ЭтотОбъект,
			Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РазрешитьВыгружатьСОшибками(Команда)
	Объект.РазрешитьВыгружатьСОшибками = Не Объект.РазрешитьВыгружатьСОшибками;
	Элементы.ФормаРазрешитьВыгружатьСОшибками.Пометка = Объект.РазрешитьВыгружатьСОшибками;
	Модифицированность = Истина;
КонецПроцедуры

