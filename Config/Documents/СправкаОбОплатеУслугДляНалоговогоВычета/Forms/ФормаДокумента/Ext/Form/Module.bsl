Процедура ОчиститьРеквизитыПолучателяУслуги()
	
	Объект.ПолучательФамилия = Неопределено;
	Объект.ПолучательИмя = Неопределено;
	Объект.ПолучательОтчество = Неопределено;
	Объект.ПолучательИНН = Неопределено;
	Объект.ПолучательДатаРождения = Неопределено;
	Объект.ПолучательДокументВид = Неопределено;
	Объект.ПолучательДокументНомер = Неопределено;
	Объект.ПолучательДокументДата = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Функция НеобходимыеРеквизитыЗаполнены()
	
	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект["ОтчетныйГод"]) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""Отчетный год"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.ОтчетныйГод");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект["Организация"]) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""Организация"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.Организация");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект["ВидСправки"]) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""Вид справки"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.ВидСправки");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьРеквизитовПолучательУслуги()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтраницаПолучательУслуги", "Видимость", НЕ Объект.НалогоплательщикИПолучательУслугиОдноЛицо);
	
	ЗаполненыСуммыРасшифровки = (Объект.НалогоплательщикСумма <> 0 ИЛИ Объект.ПолучательСумма <> 0);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НадписьИтогоОплачено", "Видимость", ЗаполненыСуммыРасшифровки);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НалогоплательщикСумма", "Видимость", ЗаполненыСуммыРасшифровки);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПолучательСумма", "Видимость", ЗаполненыСуммыРасшифровки И НЕ Объект.НалогоплательщикИПолучательУслугиОдноЛицо);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"КнопкаРасшифровать", "Видимость", ЗаполненыСуммыРасшифровки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыФизЛица(Контрагент, ИмяЭлемента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДокументыФизическихЛиц.Физлицо КАК Физлицо,
		|	ДокументыФизическихЛиц.ВидДокумента.КодФНС КАК ВидДокументаКодФНС,
		|	ДокументыФизическихЛиц.Серия КАК Серия,
		|	ДокументыФизическихЛиц.Номер КАК Номер,
		|	ДокументыФизическихЛиц.ДатаВыдачи КАК ДатаВыдачи
		|ПОМЕСТИТЬ ВТДокументыФизическихЛиц
		|ИЗ
		|	РегистрСведений.ДокументыФизическихЛиц КАК ДокументыФизическихЛиц
		|ГДЕ
		|	ДокументыФизическихЛиц.Период <= &ДатаСведений
		|	И ДокументыФизическихЛиц.Физлицо = &Физлицо
		|	И ДокументыФизическихЛиц.ЯвляетсяДокументомУдостоверяющимЛичность
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДокументыФизическихЛиц.Период УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФизическиеЛица.Ссылка КАК ФизическоеЛицо,
		|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Фамилия, """") КАК Фамилия,
		|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Имя, """") КАК Имя,
		|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Отчество, """") КАК Отчество,
		|	ФизическиеЛица.ИНН КАК ИНН,
		|	ФизическиеЛица.ДатаРождения КАК ДатаРождения,
		|	ЕСТЬNULL(ВТДокументыФизическихЛиц.ВидДокументаКодФНС, """") КАК ДокументКодФНС,
		|	ЕСТЬNULL(ВТДокументыФизическихЛиц.Серия, """") КАК ДокументСерия,
		|	ЕСТЬNULL(ВТДокументыФизическихЛиц.Номер, """") КАК ДокументНомер,
		|	ЕСТЬNULL(ВТДокументыФизическихЛиц.ДатаВыдачи, ДАТАВРЕМЯ(1, 1, 1)) КАК ДокументДатаВыдачи
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц.СрезПоследних(&ДатаСведений, ФизическоеЛицо = &ФизЛицо) КАК ФИОФизическихЛицСрезПоследних
		|		ПО (ФИОФизическихЛицСрезПоследних.ФизическоеЛицо = ФизическиеЛица.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДокументыФизическихЛиц КАК ВТДокументыФизическихЛиц
		|		ПО ФизическиеЛица.Ссылка = ВТДокументыФизическихЛиц.Физлицо
		|ГДЕ
		|	ФизическиеЛица.Ссылка = &ФизЛицо";
	
	Запрос.УстановитьПараметр("Физлицо", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент,
		"ЮридическоеФизическоеЛицо"));
	Запрос.УстановитьПараметр("ДатаСведений", Объект.Дата);

	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();

	Объект[ИмяЭлемента + "Фамилия"]	= ВыборкаДетальныеЗаписи.Фамилия;
	Объект[ИмяЭлемента + "Имя"]	= ВыборкаДетальныеЗаписи.Имя;
	Объект[ИмяЭлемента + "Отчество"] = ВыборкаДетальныеЗаписи.Отчество;
	Объект[ИмяЭлемента + "ИНН"]	= ВыборкаДетальныеЗаписи.ИНН;
	Объект[ИмяЭлемента + "ДатаРождения"] = ВыборкаДетальныеЗаписи.ДатаРождения;
	Объект[ИмяЭлемента + "ДокументВид"] = ВыборкаДетальныеЗаписи.ДокументКодФНС;
	Объект[ИмяЭлемента + "ДокументДата"] = ВыборкаДетальныеЗаписи.ДокументДатаВыдачи;
	ДокументНомерИСерия = СокрЛП(СтрШаблон(НСтр("ru = '%1 %2'"),
		ВыборкаДетальныеЗаписи.ДокументСерия,
		ВыборкаДетальныеЗаписи.ДокументНомер));
	Объект[ИмяЭлемента + "ДокументНомер"] = ДокументНомерИСерия;

КонецПроцедуры

&НаСервере
