
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если Параметры.Свойство("ИдентификаторОбъекта") Тогда
		Если Параметры.ИдентификаторОбъекта = "УИН" Тогда
			Элементы.УникальныйИдентификаторНачисления.Видимость = Истина;
		ИначеЕсли Параметры.ИдентификаторОбъекта = "УИП" Тогда
			Элементы.ЕдиныйИдентификаторПлательщика.Видимость = Истина;
		ИначеЕсли Параметры.ИдентификаторОбъекта = "УИЗ" Тогда
			Элементы.УникальныйИдентификаторЗаявки.Видимость = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "Список");
	
КонецПроцедуры

