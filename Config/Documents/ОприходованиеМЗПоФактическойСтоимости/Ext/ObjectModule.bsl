#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("Основание") Тогда
			Если ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
				ТипЗаполнения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "ТипЗаполнения", "по среднему");
				ЗаполнитьНаОснованииДокумента(ДанныеЗаполнения.Основание, ТипЗаполнения, СтандартнаяОбработка);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = Материалы.Итог("Сумма");
	
	ОчиститьНеиспользуемыеДополнительныеСубконто();
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ЗаполнениеРеквизитовОбъектов.ЗаполнитьДатуПриКопировании(ЭтотОбъект, ОбъектКопирования);
	ДатаНовогоДокумента = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	
	ОбязательноЗаполнитьКЭК = УправлениеМатериальнымиЗапасамиКлиентСервер.ИзменилосьПрименениеДетальногоКЭК340и440(
		ОбъектКопирования.Дата,
		ОбъектКопирования.Организация,
		ДатаНовогоДокумента,
		Организация);
	
	УправлениеМатериальнымиЗапасами.УстановитьНовоеЗначениеКЭКВТабличныхЧастях(ЭтотОбъект, ДатаНовогоДокумента,
		ОбязательноЗаполнитьКЭК);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьНаОснованииДокумента(ДокументОснование, ТипЗаполнения, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТребуемыеРеквизиты = Новый Структура("Организация, ИФО, Подразделение");
	ТребуемыеРеквизиты.Вставить("ЦМООтправитель", "ЦМО");
	ДанныеОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ТребуемыеРеквизиты);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеОснования);
	Дата      = ОбщегоНазначения.ТекущаяДатаПользователя();
	ПартияМПЗ = ДокументОснование;
	
	ПараметрыРасчета = УправлениеМатериальнымиЗапасами.ДополнительныеПараметрыРасчетаОприходованияМПЗПоПартии(ЭтотОбъект);
	ПараметрыРасчета.БезУчетаОстатков = ТипЗаполнения = "по документу"; 
	ТаблицаОстатков = УправлениеМатериальнымиЗапасами.РассчитатьОприходованиеМПЗПоПартии(ПараметрыРасчета);
	
	Материалы.Очистить();
	
	Для Каждого СтрокаОстатков Из ТаблицаОстатков Цикл
		
		НоваяСтрока = Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОстатков);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчиститьНеиспользуемыеДополнительныеСубконто()
	
	НастройкиСчетов = Новый Соответствие;
	
	Для Каждого Строка Из Материалы Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.ДополнительнаяАналитикаСчета) Тогда
			Продолжить;
		КонецЕсли;
		
		Очищать = НастройкиСчетов.Получить(Строка.СчетУчета);
		Если Очищать = Неопределено Тогда
			Очищать = ОчищатьДопСубконтоСчета(Строка.СчетУчета);
			НастройкиСчетов.Вставить(Строка.СчетУчета, Очищать);
		КонецЕсли;
		
		Если Очищать Тогда
			Строка.ДополнительнаяАналитикаСчета = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОчищатьДопСубконтоСчета(СчетУчета)
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчета);
	Для Счетчик = 1 По БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто() Цикл
		
		Если Не ЗначениеЗаполнено(СвойстваСчета["ВидСубконто" + Счетчик]) Тогда
			Прервать;
		КонецЕсли;
		
		ЕстьНестандартноеСубконто = СвойстваСчета["ВидСубконто" + Счетчик] <> ПланыВидовХарактеристик.ВидыСубконто.Номенклатура
			И СвойстваСчета["ВидСубконто" + Счетчик] <> ПланыВидовХарактеристик.ВидыСубконто.ЦМО
			И СвойстваСчета["ВидСубконто" + Счетчик] <> ПланыВидовХарактеристик.ВидыСубконто.Партии;
		
		Если ЕстьНестандартноеСубконто Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	Возврат Истина;
КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли