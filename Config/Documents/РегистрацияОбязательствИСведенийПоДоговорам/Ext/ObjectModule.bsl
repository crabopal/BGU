#Область ПрограммныйИнтерфейс

// Процедура очищает неиспользуемые реквизиты.
//
// Параметры:
//	ДокументОбъект - ДокументОбъект - Текущий документ
//	МассивВсехРеквизитов - Массив - Массив всех реквизитов документа, которые необходимо очищать
//	МассивРеквизитовОперации - Массив - Массив реквизитов документа, которые относятся к хозяйственной операции документа
//
Процедура ОчиститьНеиспользуемыеРеквизиты(ДокументОбъект, Знач МассивВсехРеквизитов, Знач МассивРеквизитовОперации) Экспорт
	
	Перем Номер;
	
	// Удалим из массива реквизиты, относящиеся к хозяйственной операции.
	Для Каждого ЭлементМассива Из МассивРеквизитовОперации Цикл
		Номер = МассивВсехРеквизитов.Найти(ЭлементМассива);
		Если Номер <> Неопределено Тогда
			МассивВсехРеквизитов.Удалить(Номер);
		КонецЕсли;
	КонецЦикла;
	
	СтруктураТабличныхЧастей = Новый Структура;
	
	Для Каждого ЭлементМассива Из МассивВсехРеквизитов Цикл
		
		Позиция = Найти(ЭлементМассива, ".");
		
		// Реквизит табличной части.
		Если Позиция <> 0 Тогда
			ИмяТабличнойЧасти = Лев(ЭлементМассива, Позиция - 1);
			РеквизитыТабличнойЧасти = Неопределено;
			Если Не СтруктураТабличныхЧастей.Свойство(ИмяТабличнойЧасти, РеквизитыТабличнойЧасти) Тогда
				СтруктураТабличныхЧастей.Вставить(ИмяТабличнойЧасти, Новый Массив);
				РеквизитыТабличнойЧасти = СтруктураТабличныхЧастей[ИмяТабличнойЧасти];
			КонецЕсли;
			РеквизитыТабличнойЧасти.Добавить(Сред(ЭлементМассива, Позиция + 1));
			
		// Реквизит шапки.	
		Иначе
			Если ЗначениеЗаполнено(ДокументОбъект[СокрЛП(ЭлементМассива)]) Тогда
				ДокументОбъект[СокрЛП(ЭлементМассива)] = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Очистим необходимые реквизиты табличной части.
	Если СтруктураТабличныхЧастей.Количество() > 0 Тогда
		Для Каждого ТабличнаяЧасть ИЗ СтруктураТабличныхЧастей Цикл
			Для Каждого СтрокаТаблицы Из ДокументОбъект[ТабличнаяЧасть.Ключ] Цикл
				Для Каждого ЭлементМассива Из ТабличнаяЧасть.Значение Цикл
					Если ЗначениеЗаполнено(СтрокаТаблицы[СокрЛП(ЭлементМассива)]) Тогда
						СтрокаТаблицы[СокрЛП(ЭлементМассива)] = Неопределено;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры // ОчиститьНеиспользуемыеРеквизиты()

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКопировании(ОбъектКопирования)
	
	ИДИсточника		= Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	НомерИсточника	= "";
	
	Основание = Неопределено;
	ВидОбязательства = Неопределено;
	Договор = Неопределено;
	
	Для каждого СтрокаТЧ Из РасшифровкаОбязательстваБюджет Цикл
		СтрокаТЧ.ЗапретИзменения = Ложь;
	КонецЦикла; 
	
	Для каждого СтрокаТЧ Из РасшифровкаОбязательстваВнебюджет Цикл
		СтрокаТЧ.ЗапретИзменения = Ложь;
	КонецЦикла; 
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидДоговора,УчетПредметаДоговора");
	ВидДоговора = РеквизитыДоговора.ВидДоговора;
	УчетПредмета = РеквизитыДоговора.УчетПредметаДоговора;
	ВедетсяУчетОбязательств = УчетРасчетовКлиентСервер.ВедетсяУчетОбязательств(ВидДоговора);
	
	Если ЗначениеЗаполнено(ОкончаниеДействия) И (НачалоДействия > ОкончаниеДействия) Тогда
		ТекстОшибки = НСтр("ru='Дата окончания не может быть меньше даты начала!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Объект.ОкончаниеДействия",, Отказ);
	КонецЕсли; 
	
	СписокКФО = Новый СписокЗначений;
	СписокКФО.ЗагрузитьЗначения(БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(Организация, ИФО, Дата)); 
	ЭтоБюджетополучатель = НЕ СписокКФО.НайтиПоЗначению(ПредопределенноеЗначение("Перечисление.КВД.Бюджет")) = Неопределено;
	
	СтруктураРеквизитовЛС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛицевойСчет, "ТипЛицевогоСчета");
	Если СтруктураРеквизитовЛС.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский 
	 ИЛИ НЕ ЭтоБюджетополучатель
	 ИЛИ НЕ ВедетсяУчетОбязательств Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ОрганКазначейства");
		МассивНепроверяемыхРеквизитов.Добавить("СчетКонтрагента");	
	КонецЕсли; 
	
	ПроверитьДублиСтрок(Отказ);
	
	Если ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательство Тогда
		
		МассивНепроверяемыхРеквизитов.Добавить("СчетКонтрагента");	
		МассивНепроверяемыхРеквизитов.Добавить("ТипСведений");	
		
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.Номенклатура");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.ЕдиницаИзмерения");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.ОКП");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.Количество");	
		
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.Номенклатура");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.ЕдиницаИзмерения");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.ОКП");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.Количество");	
		
		ПроверитьЗаполнениеТабЧастейЗаявкиНаИзменение(Отказ, Ложь);
		
	ИначеЕсли ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательство 
		ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения Тогда
		
		МассивНепроверяемыхРеквизитов.Добавить("СчетКонтрагента");	
		МассивНепроверяемыхРеквизитов.Добавить("ТипСведений");	
		
		Если НЕ УчетПредмета Тогда
			
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.Номенклатура");	
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.ЕдиницаИзмерения");	
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.ОКП");	
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.Количество");
			
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.Номенклатура");	
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.ЕдиницаИзмерения");	
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.ОКП");	
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.Количество");	
			
		КонецЕсли;   
		
		ПроверитьЗаполнениеТабЧастейЗаявкиНаИзменение(Отказ, Ложь);

	ИначеЕсли ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательства
		   ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаПеререгистрациюОбязательства Тогда
		
		ПроверитьЗаполнениеТабЧастейЗаявкиНаИзменение(Отказ, Ложь);
		
		МассивНепроверяемыхРеквизитов.Добавить("СчетКонтрагента");	
		МассивНепроверяемыхРеквизитов.Добавить("ТипСведений");	
		
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.Сумма");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.СуммаВВалюте");
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.Номенклатура");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.ЕдиницаИзмерения");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.ОКП");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.Количество");	
		
		
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.Сумма");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.СуммаВВалюте");
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.Номенклатура");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.ЕдиницаИзмерения");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.ОКП");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.Количество");	
		
	КонецЕсли;	
		
	Если ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательстваУчетПредмета
	      ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаПеререгистрациюОбязательстваУчетПредмета 
		  ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ОтказОтДоговораКонкурсныеПроцедуры 
		  ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоКонкурсныеПроцедуры
		  ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения
		  ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация Тогда
		  
		ПроверитьЗаполнениеТабЧастейЗаявкиНаИзменение(Отказ, УчетПредмета);			
		
		Если ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаПеререгистрациюОбязательстваУчетПредмета
			ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ОтказОтДоговораКонкурсныеПроцедуры 
			ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация Тогда
			МассивНепроверяемыхРеквизитов.Добавить("ТипСведений");	
		КонецЕсли;
		
		Если НЕ УчетПредмета Тогда
			
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.Номенклатура");	
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.ЕдиницаИзмерения");	
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.ОКП");	
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.Количество");
			
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.Номенклатура");	
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.ЕдиницаИзмерения");	
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.ОКП");	
			МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.Количество");	
			
		КонецЕсли;
		
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.Сумма");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.СуммаВВалюте");
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.Количество");
		
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.Сумма");	
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.СуммаВВалюте");
		МассивНепроверяемыхРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.Количество");		
		
	КонецЕсли; 
	
	Если Не КонтрольИсполненияДоговоров.ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам(ВидДоговора) Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ГрафикПлатежей.КЭК");
		МассивНепроверяемыхРеквизитов.Добавить("ГрафикИсполнения.КЭК");
	КонецЕсли;
	Если Не КонтрольИсполненияДоговоров.ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей(ВидДоговора) Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ГрафикПлатежей.ДопКлассификация");
		МассивНепроверяемыхРеквизитов.Добавить("ГрафикПлатежей.КодМероприятия");
		МассивНепроверяемыхРеквизитов.Добавить("ГрафикПлатежей.КодЦели");
	КонецЕсли;
	
	Если Не ВедетсяУчетОбязательств Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ВидОбязательства");
		МассивНепроверяемыхРеквизитов.Добавить("ИФО");
		МассивНепроверяемыхРеквизитов.Добавить("ТипСведений");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда
		
		ВалютаДокумента 		= ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета();
		СтруктураКурсаВалюты 	= РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, ТекущаяДата()); 
		Курс 					= СтруктураКурсаВалюты.Курс;
		Кратность 				= СтруктураКурсаВалюты.Кратность;
		
	КонецЕсли; 
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Договор") Тогда
		
		ПроверитьДопустимостьЗаполненияПоДоговору(ДанныеЗаполнения.Договор);
		
		Если ДанныеЗаполнения.Свойство("ДокументОснование") Тогда
			ЗаполнитьПоДоговору(ДанныеЗаполнения.Договор, Ложь, ДанныеЗаполнения.ДокументОснование);
		Иначе
			ЗаполнитьПоДоговору(ДанныеЗаполнения.Договор, Ложь);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Договоры") Тогда
		
		ПроверитьДопустимостьЗаполненияПоДоговору(ДанныеЗаполнения);
		ЗаполнитьПоДоговору(ДанныеЗаполнения, Ложь);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда 
		
		СтруктураДляЗаполнения = ПолучитьСтруктуруДляЗаполненияПоДокументу(ДанныеЗаполнения);
		ПроверитьДопустимостьЗаполненияПоДокументу(СтруктураДляЗаполнения);  
		ЗаполнитьПоДоговору(СтруктураДляЗаполнения.Договор,, ДанныеЗаполнения);
		Основание = ДанныеЗаполнения;
		
		Если ДанныеЗаполнения.РезультативностьИспользованияСубсидии.Количество() > 0 Тогда
			РезультативностьИспользованияСубсидии.Загрузить(ДанныеЗаполнения.РезультативностьИспользованияСубсидии.Выгрузить());
		КонецЕсли;
		
		Если ДанныеЗаполнения.ПримечаниеБюджет.Количество() > 0 Тогда
			ПримечаниеБюджет.Загрузить(ДанныеЗаполнения.ПримечаниеБюджет.Выгрузить());
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СтруктураРеквизитовДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор,
		"ВидДоговора, ЗаключаетсяПоРезультатамКонкурсныхПроцедур, РезультатЗавершенияКонкурсныхПроцедур");
	ДополнительныеСвойства.Вставить("СтруктураРеквизитовДоговора", СтруктураРеквизитовДоговора);
	
	ПроверитьВозможностьЗаписиДокумента(Отказ, РежимЗаписи, РежимПроведения);

	// Очистим реквизиты документа не используемые для вида обязательства
	МассивВсехРеквизитов = Новый Массив;
	МассивРеквизитовОперации = Новый Массив;
	
	Если СтруктураРеквизитовДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство 
		ИЛИ (СтруктураРеквизитовДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком 
		И СтруктураРеквизитовДоговора.ЗаключаетсяПоРезультатамКонкурсныхПроцедур 
		И НЕ СтруктураРеквизитовДоговора.РезультатЗавершенияКонкурсныхПроцедур = 1) Тогда
		
			МассивВсехРеквизитов.Добавить("Контрагент");	
				
	КонецЕсли;
	
	Документы.РегистрацияОбязательствИСведенийПоДоговорам.ПолучитьМассивыРеквизитов(ВидОбязательства, МассивВсехРеквизитов, МассивРеквизитовОперации, СтруктураРеквизитовДоговора.ВидДоговора);
	ОчиститьНеиспользуемыеРеквизиты(ЭтотОбъект, МассивВсехРеквизитов, МассивРеквизитовОперации);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.ЭтоНовый И НЕ Основание.Пустая() И ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента") Тогда
		
		ТиповаяОперация = БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(Основание);
		ДопРеквизиты = БухгалтерскиеОперацииСервер.ЗаполнитьДополнительныеРеквизиты(Основание, ТиповаяОперация);
		
		ПараметрыЗаписиТиповойОперации = БухгалтерскиеОперацииСервер.ЗаписатьТиповуюОперациюИДопРеквизиты_Параметры();
		ПараметрыЗаписиТиповойОперации.Документ					= Ссылка;
		ПараметрыЗаписиТиповойОперации.Операция					= ТиповаяОперация;
		ПараметрыЗаписиТиповойОперации.Организация				= Организация;
		ПараметрыЗаписиТиповойОперации.Дата						= Дата;
		ПараметрыЗаписиТиповойОперации.ДополнительныеРеквизиты	= ДопРеквизиты;
		БухгалтерскиеОперацииСервер.ЗаписатьТиповуюОперациюИДопРеквизиты(ПараметрыЗаписиТиповойОперации, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	Документы.РегистрацияОбязательствИСведенийПоДоговорам.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	ПроведениеСервер.ОтразитьДвиженияПоРегистрам(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоДоговору(Договор, ЗаполнятьДанныеТабЧастей = Истина, ОснованиеЗаполнения = Неопределено)
	Перем Запрос, ТекстЗапроса;
	Перем Результат;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	Договоры.Организация КАК Организация,
	|	Договоры.Контрагент КАК Контрагент,
	|	Договоры.СчетКонтрагента КАК СчетКонтрагента,
	|	Договоры.Договор,
	|	ВЫБОР
	|		КОГДА Договоры.УчетПредметаДоговора
	|			ТОГДА ВЫБОР
	|					КОГДА Договоры.ВидДоговора <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ИноеОбязательство)
	|							И ЕСТЬNULL(СрокиСуммы.Регистратор, 0) <> 0
	|						ТОГДА ВЫБОР
	|								КОГДА (СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательство)
	|                                    ИЛИ СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения)
	|                                    ИЛИ СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация))
	|										И Договоры.РезультатЗавершенияКонкурсныхПроцедур = 1
	|									ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринятоеОбязательствоКонкурсныеПроцедуры)
	|								КОГДА (СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательство)
	|                                    ИЛИ СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения)
	|                                    ИЛИ СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация))
	|										И Договоры.РезультатЗавершенияКонкурсныхПроцедур = 2
	|									ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ОтказОтДоговораКонкурсныеПроцедуры)
	| //Изменение принимаемого
	|								КОГДА (СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательство)
	|                                    ИЛИ СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения)
	|                                    ИЛИ СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация))
	|										И НЕ Договоры.ПризнакЗавершенияКонкурсныхПроцедур
	|									ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения)
	| //Изменение принимаемого
	|								ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательстваУчетПредмета)
	|							КОНЕЦ
	|					ИНАЧЕ ВЫБОР
	|							КОГДА Договоры.ЗаключаетсяПоРезультатамКонкурсныхПроцедур
	|									И Договоры.РезультатЗавершенияКонкурсныхПроцедур = 1
	|								ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринятоеОбязательствоКонкурсныеПроцедуры)
	|							КОГДА Договоры.ЗаключаетсяПоРезультатамКонкурсныхПроцедур
	|									И (Договоры.РезультатЗавершенияКонкурсныхПроцедур = 0
	|										ИЛИ Договоры.РезультатЗавершенияКонкурсныхПроцедур = 2)
	|								ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательство)
	|							ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринятоеОбязательствоУчетПредмета)
	|						КОНЕЦ
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЕСТЬNULL(СрокиСуммы.Регистратор, 0) <> 0
	|					ТОГДА ВЫБОР
	|								КОГДА (СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательство)
	|                                    ИЛИ СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения)
	|                                    ИЛИ СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация))
	|										И Договоры.РезультатЗавершенияКонкурсныхПроцедур = 1
	|									ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринятоеОбязательствоКонкурсныеПроцедуры)
	|								КОГДА (СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательство)
	|                                    ИЛИ СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения)
	|                                    ИЛИ СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация))
	|										И Договоры.РезультатЗавершенияКонкурсныхПроцедур = 2
	|									ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ОтказОтДоговораКонкурсныеПроцедуры)
	| //Изменение принимаемого
	|								КОГДА (СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательство)
	|                                    ИЛИ СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения)
	|                                    ИЛИ СрокиСуммы.ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация))
	|										И НЕ Договоры.ПризнакЗавершенияКонкурсныхПроцедур
	|									ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения)
	| //Изменение принимаемого
	|								ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательства)
	|							КОНЕЦ
	|		ИНАЧЕ ВЫБОР 
	|				КОГДА Договоры.ЗаключаетсяПоРезультатамКонкурсныхПроцедур
	|					И (Договоры.РезультатЗавершенияКонкурсныхПроцедур = 0
	|					ИЛИ Договоры.РезультатЗавершенияКонкурсныхПроцедур = 2)
	|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринимаемоеОбязательство)
	|				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринятоеОбязательство)	
	|			  КОНЕЦ
	|		КОНЕЦ
	|	КОНЕЦ КАК ВидОбязательства,
	|	СрокиСуммы.НачалоДействия,
	|	СрокиСуммы.НачалоДействия КАК НачалоДействияДоИзменений,
	|	СрокиСуммы.ОкончаниеДействия,
	|	СрокиСуммы.ОкончаниеДействия КАК ОкончаниеДействияДоИзменений,
	|	СрокиСуммы.ВалютаРасчетов КАК ВалютаДокумента,
	|	СрокиСуммы.АвансПроцентом,
	|	СрокиСуммы.СуммаАванса,
	|	СрокиСуммы.Сумма,
	|	СрокиСуммы.СуммаВВалюте,
	|	СрокиСуммы.КурсРасчетов КАК Курс,
	|	СрокиСуммы.КратностьРасчетов КАК Кратность,
	|	ЕСТЬNULL(СрокиСуммы.ЛицевойСчет, Договоры.ОтдельныйСчетДляРасчетовПоГОЗ) КАК ЛицевойСчет,
	|	СрокиСуммы.ОрганКазначейства КАК ОрганКазначейства,
	|	СрокиСуммы.ИФО КАК ИФО,
	|	ВЫБОР
	|		КОГДА Договоры.ВидДоговора <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ИноеОбязательство)
	|			ТОГДА СрокиСуммы.Регистратор
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Основание,
	|	Договоры.УчетПредметаДоговора,
	|	СрокиСуммы.СрокИсполнения,
	|	СрокиСуммы.СрокИсполнения КАК СрокИсполненияДоИзменений,
	|	Договоры.ВидДоговора,
	|	ВЫБОР
	|		КОГДА СрокиСуммы.Регистратор ССЫЛКА Документ.РегистрацияОбязательствИСведенийПоДоговорам
	|			ТОГДА СрокиСуммы.Регистратор.РеквизитыЛицевогоСчета
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.РеквизитыЛицевыхСчетов.ПустаяСсылка)
	|	КОНЕЦ КАК РеквизитыЛицевогоСчета,
	|	ВЫБОР
	|		КОГДА СрокиСуммы.Регистратор ССЫЛКА Документ.РегистрацияОбязательствИСведенийПоДоговорам
	|			ТОГДА ЕстьNULL(СрокиСуммы.Регистратор.НомерИзменения, -1) + 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК НомерИзменения
	|ИЗ
	|	(ВЫБРАТЬ
	|		Договоры.Ссылка КАК Договор,
	|		Договоры.Организация КАК Организация,
	|		Договоры.Контрагент КАК Контрагент,
	|		Договоры.СчетКонтрагента КАК СчетКонтрагента,
	|		Договоры.ВидДоговора КАК ВидДоговора,
	|		Договоры.УчетПредметаДоговора КАК УчетПредметаДоговора,
	|		Договоры.ЗаключаетсяПоРезультатамКонкурсныхПроцедур КАК ЗаключаетсяПоРезультатамКонкурсныхПроцедур,
	|		Договоры.РезультатЗавершенияКонкурсныхПроцедур КАК РезультатЗавершенияКонкурсныхПроцедур,
	|		Договоры.ПризнакЗавершенияКонкурсныхПроцедур КАК ПризнакЗавершенияКонкурсныхПроцедур,
	|		Договоры.ОтдельныйСчетДляРасчетовПоГОЗ КАК ОтдельныйСчетДляРасчетовПоГОЗ
	|	ИЗ
	|		Справочник.Договоры КАК Договоры
	|	ГДЕ
	|		Договоры.Ссылка = &Договор) КАК Договоры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(
	|				&Период,
	|				Обязательство = &Договор
	|					И &УсловиеРегистратор) КАК СрокиСуммы
	|		ПО Договоры.Договор = СрокиСуммы.Обязательство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПФОСрезПоследних.КлючАналитики.КФО КАК КФО,
	|	ПФОСрезПоследних.КлючАналитики.КПС КАК КПС,
	|	ПФОСрезПоследних.КлючАналитики.КЭК КАК КЭК,
	|	ПФОСрезПоследних.КлючАналитики.ОбъектФАИП КАК ОбъектФАИП,
	|	ПФОСрезПоследних.КлючАналитики.Подразделение КАК Подразделение,
	|	ПФОСрезПоследних.КлючАналитики.Номенклатура КАК Номенклатура,
	|	ПФОСрезПоследних.КлючАналитики.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ПФОСрезПоследних.КлючАналитики.ПериодПлана КАК ПериодПлана,
	|	ПФОСрезПоследних.КлючАналитики.РазделЛицевогоСчета КАК РазделЛицевогоСчета,
	|	ПФОСрезПоследних.КлючАналитики.КодЦели КАК КодЦели,
	|	ПФОСрезПоследних.КлючАналитики.КодМероприятия КАК КодМероприятия,
	|	ПФОСрезПоследних.КлючАналитики.ДопКлассификация КАК ДопКлассификация,
	|	ПФОСрезПоследних.Количество,
	|	ПФОСрезПоследних.Сумма,
	|	ПФОСрезПоследних.СуммаВВалюте,
	|	ПФОСрезПоследних.СуммаВВалютеБезусловная,
	|	ПФОСрезПоследних.СуммаИсполнено,
	|	ПФОСрезПоследних.СуммаИсполненоБезусловно,
	|	ИСТИНА КАК ЗапретИзменения,
	|	ПФОСрезПоследних.ОКП КАК ОКП
	|ИЗ
	|	РегистрСведений.ПланФинансированияОбязательств.СрезПоследних(
	|			&Период,
	|			Обязательство = &Договор
	|				И &УсловиеРегистратор) КАК ПФОСрезПоследних
	|ГДЕ
	|	(ПФОСрезПоследних.Количество <> 0
	|			ИЛИ ПФОСрезПоследних.Сумма <> 0
	|			ИЛИ ПФОСрезПоследних.СуммаВВалюте <> 0
	|			ИЛИ ПФОСрезПоследних.СуммаВВалютеБезусловная <> 0
	|			ИЛИ ПФОСрезПоследних.СуммаИсполнено <> 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПФОСрезПоследних.КлючАналитики.ОбъектФАИП,
	|	ПФОСрезПоследних.КлючАналитики.ПериодПлана.ДатаНачала,
	|	КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДоговорыКонтрагенты.Контрагент,
	|	ДоговорыКонтрагенты.СчетКонтрагента
	|ИЗ
	|	Справочник.Договоры.Контрагенты КАК ДоговорыКонтрагенты
	|ГДЕ
	|	ДоговорыКонтрагенты.Ссылка = &Договор";
	   
	Запрос.УстановитьПараметр("Период", ?(ЭтоНовый(), ТекущаяДата(), Дата));
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Если ТипЗнч(ОснованиеЗаполнения) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеРегистратор", "Регистратор = &Регистратор");
		Запрос.УстановитьПараметр("Регистратор", ОснованиеЗаполнения);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеРегистратор", "Регистратор <> &Регистратор");
		Запрос.УстановитьПараметр("Регистратор", Ссылка);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.ВыполнитьПакет();
	Контрагенты.Очистить();
	
	// Заполним данные шапки
	СтруктураШапки = Результат[0].Выбрать();
	СтруктураШапки.Следующий();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, СтруктураШапки);
	
	СписокКонтрагентов = Результат[2].Выбрать();
	Пока СписокКонтрагентов.Следующий() Цикл
		НовКонтрагент = Контрагенты.Добавить();
		ЗаполнитьЗначенияСвойств(НовКонтрагент, СписокКонтрагентов);
	КонецЦикла;
	
	// Заполним данные в ТЧ
	ВедетсяУчетОбязательств = УчетРасчетовКлиентСервер.ВедетсяУчетОбязательств(СтруктураШапки.ВидДоговора);
	Если ВедетсяУчетОбязательств
	 И  (ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательства 
	 ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательстваУчетПредмета 
	 ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоКонкурсныеПроцедуры 
	 ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ОтказОтДоговораКонкурсныеПроцедуры 
	 ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения) Тогда
	 
	    РасшифровкаОбязательстваБюджет.Очистить();
		РасшифровкаОбязательстваВнебюджет.Очистить();
	 
	 	БюджетВнебюджетПоКФО = РаботаСОбязательствамиПовтИсп.ПолучитьБюджетВнебюджетПоКФО();	
		ВыборкаДанных = Результат[1].Выбрать();
		
		Пока ВыборкаДанных.Следующий() Цикл
			
			ИмяТЧ = БюджетВнебюджетПоКФО[ВыборкаДанных.КФО];
			
			Если НЕ ПустаяСтрока(ИмяТЧ) Тогда
				
				ИмяТЧ = "РасшифровкаОбязательства" + ИмяТЧ;
				НоваяСтрока = ЭтотОбъект[ИмяТЧ].Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДанных);
				
				Если ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ОтказОтДоговораКонкурсныеПроцедуры Тогда
					// сторно всех показателей
					НоваяСтрока.Количество 				= 0;
					НоваяСтрока.Сумма 					= 0;
					НоваяСтрока.СуммаВВалюте  			= 0;     
					НоваяСтрока.СуммаВВалютеБезусловная = 0;
				КонецЕсли;
			КонецЕсли;                                                                                  
		КонецЦикла; 
	КонецЕсли; 
	
	КонтрольИсполненияДоговоров.ЗаполнитьГрафикиИсполненияПоДоговору(ЭтотОбъект, Договор, ОснованиеЗаполнения);
	
	Если ВалютаДокумента.Пустая() Тогда
		ВалютаДокумента = ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	КонецЕсли; 
	СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, ?(ЭтоНовый(), ТекущаяДата(), Дата));
	Курс = СтруктураКурса.Курс;
	Кратность = СтруктураКурса.Кратность;
	
КонецПроцедуры

Процедура ПроверитьДопустимостьЗаполненияПоДоговору(Договор)
	
	Если НЕ Договор.Пустая() Тогда
		
		Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидДоговора, Наименование, ПометкаУдаления, Родитель, ЗаключаетсяПоРезультатамКонкурсныхПроцедур, РезультатЗавершенияКонкурсныхПроцедур");
		
		Если Результат.ПометкаУдаления Тогда
			
			ТекстОшибки = НСтр("ru='Договор %Договор% помечен на удаление. Ввод на основании невозможен.'");
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Договор%", Результат.Наименование);
			
			ВызватьИсключение ТекстОшибки;
			
		ИначеЕсли Результат.Родитель <> Справочники.Договоры.ПустаяСсылка() Тогда
			
			ТекстОшибки = НСтр("ru='Договор %Договор% является дочерним элементом (входит в группу). Принятие обязательств по элементам группы не допускается.'");
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Договор%", Результат.Наименование);
			
			ВызватьИсключение ТекстОшибки;
			
		ИначеЕсли Результат.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком И Результат.ЗаключаетсяПоРезультатамКонкурсныхПроцедур Тогда
			
			СтруктураДанных = РаботаСОбязательствами.ПолучитьПервичныйДействующийДокумент(Договор);
			
			Если ЗначениеЗаполнено(СтруктураДанных.ДействующийДокумент) Тогда
				
				Если Результат.РезультатЗавершенияКонкурсныхПроцедур = 0 Тогда
					//Это принимаемое обязательство, может быть только один документ до завершения конкурсных процедур и определения поставщика
					ТекстОшибки = НСтр("ru='По договору %Договор% уже оформлено принимаемое обязательство. До завершения конкурсных процедур и определения поставщика принятие обязательств не допускается.'");
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Договор%", Результат.Наименование);
					
					//ВызватьИсключение ТекстОшибки;
					
				ИначеЕсли Результат.РезультатЗавершенияКонкурсныхПроцедур = 2 И СтруктураДанных.ДействующийДокумент.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ОтказОтДоговораКонкурсныеПроцедуры Тогда	
					
					ТекстОшибки = НСтр("ru='Договор %Договор% не был заключен по результатам конкурсных процедур, и по нему уже отражено уменьшение обязательств. Принятие обязательств по такому договору не допускается.'");
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Договор%", Результат.Наименование);
			
					ВызватьИсключение ТекстОшибки;

				КонецЕсли;		
				
			КонецЕсли; 
					
		КонецЕсли; 	
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПроверитьДопустимостьЗаполненияПоДокументу(СтруктураДляЗаполнения)
	
	Если СтруктураДляЗаполнения.ПометкаУдаления Тогда
		
		ТекстОшибки = НСтр("ru='Документ %Документ% помечен на удаление. Ввод на основании невозможен.'");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", СтруктураДляЗаполнения.Представление);
		
		ВызватьИсключение ТекстОшибки;
		
	ИначеЕсли НЕ СтруктураДляЗаполнения.Проведен Тогда
		ТекстОшибки = НСтр("ru='Документ %Документ% не проведен. Ввод на основании невозможен.'");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", СтруктураДляЗаполнения.Представление);
		ВызватьИсключение ТекстОшибки;
				
	Иначе
		
		// Ввод разрешен только для действующего документа
		СтруктураДействующего = РаботаСОбязательствами.ПолучитьПервичныйДействующийДокумент(СтруктураДляЗаполнения.Договор, СтруктураДляЗаполнения.Ссылка);
		Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДляЗаполнения.Договор, "ВидДоговора, Наименование, ПометкаУдаления, Родитель, ЗаключаетсяПоРезультатамКонкурсныхПроцедур, РезультатЗавершенияКонкурсныхПроцедур");
	
		Если СтруктураДляЗаполнения.Ссылка <> СтруктураДействующего.ДействующийДокумент Тогда
			
			ТекстОшибки = НСтр("ru='Недействующая редакция документа  %Документ%. Ввод на основании невозможен.'");
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", СтруктураДляЗаполнения.Представление);
			
			ВызватьИсключение ТекстОшибки;	
			
		ИначеЕсли СтруктураДействующего.ДействующийДокумент.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ОтказОтДоговораКонкурсныеПроцедуры Тогда
			
			ТекстОшибки = НСтр("ru='Договор %Договор% не был заключен по результатам конкурсных процедур, и по нему уже отражено уменьшение обязательств. Принятие обязательств по такому договору не допускается.'");
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Договор%", Результат.Наименование);
			
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

Функция ПолучитьСтруктуруДляЗаполненияПоДокументу(ДанныеЗаполнения)
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	РОС.Договор,
	               |	РОС.ВидОбязательства,
	               |	РОС.ПометкаУдаления,
	               |	РОС.Представление,
	               |	РОС.Проведен,
	               |	РОС.Основание.ВидОбязательства КАК ОснованиеВидОбязательства,
	               |	РОС.Ссылка,
	               |	РОС.ЛицевойСчет,
	               |	РОС.РеквизитыЛицевогоСчета
	               |ИЗ
	               |	Документ.РегистрацияОбязательствИСведенийПоДоговорам КАК РОС
	               |ГДЕ
	               |	РОС.Ссылка = &Ссылка";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	ВыборкаШапки = Запрос.Выполнить().Выбрать();
	ВыборкаШапки.Следующий();
	
	Возврат ВыборкаШапки;
	
КонецФункции

Процедура ВыполнитьПроверкуЗаявкиНаИзменение(СтруктураКорректировки, Отказ)
	
	// В этом случае проверяется только корректность аналитики - не изменяемая аналитика должна совпадать с аналитикой до изменения
	// Документ может быть создан после перегистрации - проверяются строки с годом перода не меньшим, чем год даты документа 
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	Бюджет.ОбъектФАИП,
	|	Бюджет.Подразделение,
	|	Бюджет.КФО,
	|	Бюджет.КПС,
	|	Бюджет.КЭК,
	|	Бюджет.Номенклатура,
	|	Бюджет.ЕдиницаИзмерения,
	|	Бюджет.ПериодПлана,
	|	Бюджет.РазделЛицевогоСчета,
	|	Бюджет.КодЦели,
	|	Бюджет.КодМероприятия,
	|	Бюджет.ДопКлассификация,
	|	Бюджет.ОКП,
	|	Бюджет.ЗапретИзменения
	|ПОМЕСТИТЬ ДокументБюджет
	|ИЗ
	|	&ТаблицаДокументаБюджет КАК Бюджет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Внебюджет.ОбъектФАИП,
	|	Внебюджет.Подразделение,
	|	Внебюджет.КФО,
	|	Внебюджет.КПС,
	|	Внебюджет.КЭК,
	|	Внебюджет.Номенклатура,
	|	Внебюджет.ЕдиницаИзмерения,
	|	Внебюджет.ПериодПлана,
	|	Внебюджет.РазделЛицевогоСчета,
	|	Внебюджет.КодЦели,
	|	Внебюджет.КодМероприятия,
	|	Внебюджет.ДопКлассификация,
	|	Внебюджет.ОКП,
	|	Внебюджет.ЗапретИзменения
	|ПОМЕСТИТЬ ДокументВнебюджет
	|ИЗ
	|	&ТаблицаДокументаВнебюджет КАК Внебюджет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументБюджет.ОбъектФАИП,
	|	ДокументБюджет.Подразделение,
	|	ДокументБюджет.КФО,
	|	ДокументБюджет.КПС,
	|	ДокументБюджет.КЭК,
	|	ДокументБюджет.Номенклатура,
	|	ДокументБюджет.ЕдиницаИзмерения,
	|	ДокументБюджет.ПериодПлана,
	|	ДокументБюджет.РазделЛицевогоСчета,
	|	ДокументБюджет.КодЦели,
	|	ДокументБюджет.КодМероприятия,
	|	ДокументБюджет.ДопКлассификация,
	|	ДокументБюджет.ОКП,
	|	ДокументБюджет.ЗапретИзменения
	|ПОМЕСТИТЬ ДанныеДокумента
	|ИЗ
	|	ДокументБюджет КАК ДокументБюджет
	|ГДЕ
	|	ДокументБюджет.ЗапретИзменения
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДокументВнебюджет.ОбъектФАИП,
	|	ДокументВнебюджет.Подразделение,
	|	ДокументВнебюджет.КФО,
	|	ДокументВнебюджет.КПС,
	|	ДокументВнебюджет.КЭК,
	|	ДокументВнебюджет.Номенклатура,
	|	ДокументВнебюджет.ЕдиницаИзмерения,
	|	ДокументВнебюджет.ПериодПлана,
	|	ДокументВнебюджет.РазделЛицевогоСчета,
	|	ДокументВнебюджет.КодЦели,
	|	ДокументВнебюджет.КодМероприятия,
	|	ДокументВнебюджет.ДопКлассификация,
	|	ДокументВнебюджет.ОКП,
	|	ДокументВнебюджет.ЗапретИзменения
	|ИЗ
	|	ДокументВнебюджет КАК ДокументВнебюджет
	|ГДЕ
	|	ДокументВнебюджет.ЗапретИзменения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПФОСрезПоследних.КлючАналитики.ОбъектФАИП КАК ОбъектФАИП,
	|	ПФОСрезПоследних.КлючАналитики.Подразделение КАК Подразделение,
	|	ПФОСрезПоследних.КлючАналитики.КФО КАК КФО,
	|	ПФОСрезПоследних.КлючАналитики.КПС КАК КПС,
