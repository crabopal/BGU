	Запрос.УстановитьПараметр("ТаблицаДокументаВнебюджет", РасшифровкаОбязательстваВнебюджет.Выгрузить());
	Запрос.УстановитьПараметр("ТаблицаДокументаБюджет", РасшифровкаОбязательстваБюджет.Выгрузить());
	Запрос.УстановитьПараметр("Обязательство", Договор); 
	Запрос.УстановитьПараметр("КОСГУ340", Справочники.КОСГУ.НайтиПоКоду("340"));
	
	Если ДополнительныеСвойства.СтруктураРеквизитовДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство Тогда
		
		// По такому обязательству не регистрируем 706-ую форму 
		ТекстОшибки = НСтр("ru='Для договора с видом ""Иное основание обязательства"" операция не поддерживается!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,,, Отказ );					
			
	Иначе 
		
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Регистратор", Ссылка);
		Запрос.УстановитьПараметр("ДатаПерегистрации", Дата);
		ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();
		
		// ПакетРезультатовЗапроса[0] - ДокументБюджет
		// ПакетРезультатовЗапроса[1] - ДокументВнебюджет
		// ПакетРезультатовЗапроса[2] - ДанныеДокумента
		// ПакетРезультатовЗапроса[3] - ДанныеОснования
		ВыборкаАналитики = ПакетРезультатовЗапроса[4].Выбрать();
		// ПакетРезультатовЗапроса[5] - ДокументБюджетССуммами
		// ПакетРезультатовЗапроса[6] - ДокументВнебюджетССуммами
		// ПакетРезультатовЗапроса[7] - ДанныеОснованияССуммами
		ВыборкаССуммами = ПакетРезультатовЗапроса[8].Выбрать();
		
		Если ВыборкаАналитики.Следующий() Тогда
			
			ТекстОшибки = НСтр("ru='Данные по документу не актуальны, необходимо создать документ по договору заново!'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,,, Отказ );					
			
		КонецЕсли; 
		
		Пока ВыборкаССуммами.Следующий() Цикл
			
			Если ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаПеререгистрациюОбязательства Тогда
				
				СтрокаАналитики = "КФО, КЭК, Раздел лицевого счета";
				
			Иначе
				
				СтрокаАналитики = "КФО, КЭК, Номенклатура, ОКП, Единица измерения, Раздел лицевого счета";				
				
			КонецЕсли; 
			СтрокаАналитики = СтрокаАналитики + ?(ЗначениеЗаполнено(ВыборкаССуммами.ОбъектФАИП), ", Объект ФАИП", "");
			СтрокаАналитики = СтрокаАналитики + ?(ЗначениеЗаполнено(ВыборкаССуммами.Подразделение), ", Подразделение", "");
			СтрокаАналитики = СтрокаАналитики + ?(ЗначениеЗаполнено(ВыборкаССуммами.КодЦели), ", Код цели", ""); 
			СтрокаАналитики = СтрокаАналитики + ?(ЗначениеЗаполнено(ВыборкаССуммами.КодМероприятия), ", Код мероприятия", ""); 
			СтрокаАналитики = СтрокаАналитики + ?(ЗначениеЗаполнено(ВыборкаССуммами.ДопКлассификация), ", Доп. классификация", ""); 
				   
			ТекстОшибки = НСтр("ru='За период " + Формат(ВыборкаССуммами.ДатаОкончания, "ДФ=yyyy") + "г. не совпадает сумма по аналитике " + СтрокаАналитики + "'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,,, Отказ );
			
		КонецЦикла; 
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьВозможностьЗаписиДокумента(Отказ, РежимЗаписи, РежимПроведения)
	
	Если РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Возврат;		
	КонецЕсли; 
	
	УровеньДоговора = Договор.Уровень();
	Если УровеньДоговора <> 0 Тогда
		
		ТекстСообщения = НСтр("ru = 'Оформление принятия обязательств по договору - не допускается. (Элемент входит в группу обязательств)'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект,,, Отказ);
				
	КонецЕсли; 
	
	СтруктураКорректировки = РаботаСОбязательствами.ПолучитьПервичныйДействующийДокумент(Договор, Основание);
	Если ЗначениеЗаполнено(СтруктураКорректировки.ПервичныйДокумент) И СтруктураКорректировки.ДействующийДокумент <> Ссылка Тогда
		
		Если СтруктураКорректировки.ДействующийДокументДата >= Дата Тогда
			
			ТекстОшибки = НСтр("ru='По договору " + Договор + " существует действующий документ с более поздней датой. Изменение невозможно!'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,,, Отказ);
			
		ИначеЕсли НЕ Основание.Пустая() И НЕ  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "Проведен") Тогда
			
			ТекстОшибки = НСтр("ru='По договору " + Договор + " для документа " + ЭтотОбъект + " не проведен документ-основание. Изменение невозможно!'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Основание",, Отказ);
		
		КонецЕсли;	
		
	ИначеЕсли СтруктураКорректировки.ДействующийДокумент = Ссылка Тогда
		// Может измениться дата действующего документа
		
		Если НЕ Основание.Пустая() Тогда
			// Если нет основания - мы первые
			// Иначе надо посмотреть на дату основания - принимаем аксиомой, что это предыдущий документ-основание
			
			Если Дата <=  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "Дата") Тогда
				ТекстОшибки = НСтр("ru='По договору " + Договор + " существует документ с более поздней датой. Изменение невозможно!'");
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,,, Отказ);						
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли;
	
	// Проверка корректности заполнения таб. частей, может возникнуть коллизия с документами которые действуют
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
		
		Если (ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательства 
		  ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательстваУчетПредмета) Тогда
			
