	|		СУММА(Внебюджет.СуммаВВалютеБезусловная),
	|		0,
	|		0,
	|		Внебюджет.Номенклатура,
	|		Внебюджет.ЕдиницаИзмерения,
	|		Внебюджет.ОКП,
	|		Внебюджет.ОбъектФАИП,
	|		Внебюджет.Подразделение,
	|		Внебюджет.Ссылка.Дата
	|	ИЗ
	|		Документ.РегистрацияОбязательствИСведенийПоДоговорам.РасшифровкаОбязательстваВнебюджет КАК Внебюджет
	|	ГДЕ
	|		Внебюджет.Ссылка = &Ссылка
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Внебюджет.Ссылка.Договор,
	|		Внебюджет.Ссылка.ИФО,
	|		Внебюджет.ПериодПлана,
	|		Внебюджет.КФО,
	|		Внебюджет.КПС,
	|		Внебюджет.КЭК,
	|		Внебюджет.РазделЛицевогоСчета,
	|		Внебюджет.КодЦели,
	|		Внебюджет.КодМероприятия,
	|		Внебюджет.ДопКлассификация,
	|		Внебюджет.Номенклатура,
	|		Внебюджет.ЕдиницаИзмерения,
	|		Внебюджет.ОКП,
	|		Внебюджет.ОбъектФАИП,
	|		Внебюджет.Подразделение,
	|		Внебюджет.Ссылка.Дата) КАК Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПФО КАК АналитикаПФО
	|		ПО Данные.КФО = АналитикаПФО.КФО
	|			И Данные.КПС = АналитикаПФО.КПС
	|			И Данные.КЭК = АналитикаПФО.КЭК
	|			И Данные.РазделЛицевогоСчета = АналитикаПФО.РазделЛицевогоСчета
	|			И Данные.ПериодПлана = АналитикаПФО.ПериодПлана
	|			И Данные.КодЦели = АналитикаПФО.КодЦели
	|			И Данные.КодМероприятия = АналитикаПФО.КодМероприятия
	|			И Данные.ДопКлассификация = АналитикаПФО.ДопКлассификация
	|			И Данные.Номенклатура = АналитикаПФО.Номенклатура
	|			И Данные.ОбъектФАИП = АналитикаПФО.ОбъектФАИП
	|			И Данные.Подразделение = АналитикаПФО.Подразделение
	|			И Данные.ЕдиницаИзмерения = АналитикаПФО.ЕдиницаИзмерения";
	
	ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.Договор,
		"ВидДоговора,ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
	
	Если ИспользоватьКонтрольИсполненияДоговоров И РеквизитыДоговора.ВестиГрафикПлатежей Тогда
		
		Если РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда
			
			ТаблицыЗапроса.Добавить("ОплатаПоставщикамКредиторам");
			Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
			"ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
			|	ВЫБОР
			|		КОГДА ГрафикПлатежей.ОплатитьДо = &ПустаяДата
			|			ТОГДА ГрафикПлатежей.Ссылка.Дата
			|		ИНАЧЕ ГрафикПлатежей.ОплатитьДо
			|	КОНЕЦ КАК Период,
			|	ГрафикПлатежей.ВидРасчетов КАК ВидРасчетов,
			|	ГрафикПлатежей.КФО КАК КФО,
			|	ГрафикПлатежей.КПС КАК КПС,
			|	ГрафикПлатежей.КЭК КАК КЭК,
			|	ГрафикПлатежей.СчетРасчетов КАК СчетРасчетов,
			|	ГрафикПлатежей.ДопКлассификация КАК ДопКлассификация,
			|	ГрафикПлатежей.КодМероприятия КАК КодМероприятия,
			|	ГрафикПлатежей.КодЦели КАК КодЦели,
			|	ГрафикПлатежей.Ссылка.Организация КАК Организация,
			|	ГрафикПлатежей.Ссылка.ИФО КАК ИФО,
			|	ГрафикПлатежей.Ссылка.Контрагент КАК Контрагент,
			|	ГрафикПлатежей.Ссылка.Договор КАК Договор,
			|	ГрафикПлатежей.Ссылка.ВалютаДокумента КАК Валюта,
			|	ГрафикПлатежей.ОплатитьДо КАК ОплатитьДо,
			|	ГрафикПлатежей.СуммаВВалюте КАК Сумма
			|ИЗ
			|	Документ.РегистрацияОбязательствИСведенийПоДоговорам.ГрафикПлатежей КАК ГрафикПлатежей
			|ГДЕ
			|	ГрафикПлатежей.Ссылка = &Ссылка
			|	И ГрафикПлатежей.СуммаВВалюте <> 0";
			
		ИначеЕсли РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит Тогда
			
			
			ТаблицыЗапроса.Добавить("ОплатаОтПокупателейДебиторов");
			Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
			"ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
			|	ВЫБОР
			|		КОГДА ГрафикПлатежей.ОплатитьДо = &ПустаяДата
			|			ТОГДА ГрафикПлатежей.Ссылка.Дата
			|		ИНАЧЕ ГрафикПлатежей.ОплатитьДо
			|	КОНЕЦ КАК Период,
			|	ГрафикПлатежей.ВидРасчетов КАК ВидРасчетов,
			|	ГрафикПлатежей.КФО КАК КФО,
			|	ГрафикПлатежей.КПС КАК КПС,
			|	ГрафикПлатежей.КЭК КАК КЭК,
			|	ГрафикПлатежей.СчетРасчетов КАК СчетРасчетов,
			|	ГрафикПлатежей.ДопКлассификация КАК ДопКлассификация,
			|	ГрафикПлатежей.КодМероприятия КАК КодМероприятия,
			|	ГрафикПлатежей.КодЦели КАК КодЦели,
			|	ГрафикПлатежей.Ссылка.Организация КАК Организация,
			|	ГрафикПлатежей.Ссылка.ИФО КАК ИФО,
			|	ГрафикПлатежей.Ссылка.Контрагент КАК Контрагент,
			|	ГрафикПлатежей.Ссылка.Договор КАК Договор,
			|	ГрафикПлатежей.Ссылка.ВалютаДокумента КАК Валюта,
			|	ГрафикПлатежей.ОплатитьДо КАК ОплатитьДо,
			|	ГрафикПлатежей.СуммаВВалюте КАК Сумма
			|ИЗ
			|	Документ.РегистрацияОбязательствИСведенийПоДоговорам.ГрафикПлатежей КАК ГрафикПлатежей
			|ГДЕ
			|	ГрафикПлатежей.Ссылка = &Ссылка
			|	И ГрафикПлатежей.СуммаВВалюте <> 0";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИспользоватьКонтрольИсполненияДоговоров И РеквизитыДоговора.ВестиПланГрафикИсполнения Тогда
		
		Если РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда
			
			ТаблицыЗапроса.Добавить("ИсполнениеОбязательствПоставщиками");
			Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
			"ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
			|	ВЫБОР
			|		КОГДА ГрафикИсполнения.ИсполнитьДо = &ПустаяДата
			|			ТОГДА ГрафикИсполнения.Ссылка.Дата
			|		ИНАЧЕ ГрафикИсполнения.ИсполнитьДо
			|	КОНЕЦ КАК Период,
			|	ГрафикИсполнения.КФО КАК КФО,
			|	ГрафикИсполнения.КПС КАК КПС,
			|	ГрафикИсполнения.КЭК КАК КЭК,
			|	ГрафикИсполнения.СчетРасчетов КАК СчетРасчетов,
			|	ГрафикИсполнения.Ссылка.Организация КАК Организация,
			|	ГрафикИсполнения.Ссылка.ИФО КАК ИФО,
			|	ГрафикИсполнения.Ссылка.Контрагент КАК Контрагент,
			|	ГрафикИсполнения.Ссылка.Договор КАК Договор,
			|	ГрафикИсполнения.Ссылка.ВалютаДокумента КАК Валюта,
			|	ГрафикИсполнения.ИсполнитьДо КАК ИсполнитьДо,
			|	ГрафикИсполнения.СуммаВВалюте КАК Сумма
			|ИЗ
			|	Документ.РегистрацияОбязательствИСведенийПоДоговорам.ГрафикИсполнения КАК ГрафикИсполнения
			|ГДЕ
			|	ГрафикИсполнения.Ссылка = &Ссылка
			|	И ГрафикИсполнения.СуммаВВалюте <> 0";
			
		ИначеЕсли РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта Тогда
			
			ТаблицыЗапроса.Добавить("ИсполнениеДоговоровСПокупателями");
			Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
			"ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
			|	ВЫБОР
			|		КОГДА ГрафикИсполнения.ИсполнитьДо = &ПустаяДата
			|			ТОГДА ГрафикИсполнения.Ссылка.Дата
			|		ИНАЧЕ ГрафикИсполнения.ИсполнитьДо
			|	КОНЕЦ КАК Период,
			|	ГрафикИсполнения.КФО КАК КФО,
			|	ГрафикИсполнения.КПС КАК КПС,
			|	ГрафикИсполнения.КЭК КАК КЭК,
			|	ГрафикИсполнения.СчетРасчетов КАК СчетРасчетов,
			|	ГрафикИсполнения.Ссылка.Организация КАК Организация,
			|	ГрафикИсполнения.Ссылка.ИФО КАК ИФО,
			|	ГрафикИсполнения.Ссылка.Контрагент КАК Контрагент,
			|	ГрафикИсполнения.Ссылка.Договор КАК Договор,
			|	ГрафикИсполнения.Ссылка.ВалютаДокумента КАК Валюта,
			|	ГрафикИсполнения.ИсполнитьДо КАК ИсполнитьДо,
			|	ГрафикИсполнения.СуммаВВалюте КАК Сумма
			|ИЗ
			|	Документ.РегистрацияОбязательствИСведенийПоДоговорам.ГрафикИсполнения КАК ГрафикИсполнения
			|ГДЕ
			|	ГрафикИсполнения.Ссылка = &Ссылка
			|	И ГрафикИсполнения.СуммаВВалюте <> 0";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
	Для каждого СтрокаПФО Из ТаблицыДляДвижений.ПланФинансированияОбязательств Цикл
		
		Если СтрокаПФО.КлючАналитики = Неопределено Тогда
			
			СтрокаПФО.КлючАналитики = Справочники.КлючАналитикиПФО.СоздатьКлючАналитики(СтрокаПФО);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если РеквизитыДокумента.ИсправлениеОшибокПрошлыхЛет Тогда
		КонтрольИсполненияДоговоров.УстановитьПризнакИсправлениеОшибокПрошлыхЛетВДвиженияхПоРегистру(ТаблицыДляДвижений, "ОплатаОтПокупателейДебиторов");
		КонтрольИсполненияДоговоров.УстановитьПризнакИсправлениеОшибокПрошлыхЛетВДвиженияхПоРегистру(ТаблицыДляДвижений, "ОплатаПоставщикамКредиторам");
		КонтрольИсполненияДоговоров.УстановитьПризнакИсправлениеОшибокПрошлыхЛетВДвиженияхПоРегистру(ТаблицыДляДвижений, "ИсполнениеДоговоровСПокупателями");
		КонтрольИсполненияДоговоров.УстановитьПризнакИсправлениеОшибокПрошлыхЛетВДвиженияхПоРегистру(ТаблицыДляДвижений, "ИсполнениеОбязательствПоставщиками");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Функция возвращает таблицу реквизитов, зависимых от вида обязательства документа.
//
Функция ПолучитьМассивыРеквизитов(ВидОбязательства, МассивВсехРеквизитов, МассивРеквизитовОперации, ВидДоговора) Экспорт
	
	МассивВсехРеквизитов = Новый Массив;
	МассивВсехРеквизитов.Добавить("ТипСведений");
		
	//ТЧ Бюджет
	МассивВсехРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.Номенклатура");
	МассивВсехРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.ЕдиницаИзмерения");
	МассивВсехРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.ОКП");
	МассивВсехРеквизитов.Добавить("РасшифровкаОбязательстваБюджет.Количество");
	
	//ТЧ Внебюджет
	МассивВсехРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.Номенклатура");
	МассивВсехРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.ЕдиницаИзмерения");
	МассивВсехРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.ОКП");
	МассивВсехРеквизитов.Добавить("РасшифровкаОбязательстваВнебюджет.Количество");
	
	МассивРеквизитовОперации = Новый Массив;
	
	Если ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоУчетПредмета 
	 ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоКонкурсныеПроцедуры	
	 ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательстваУчетПредмета 
	 ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаПеререгистрациюОбязательстваУчетПредмета Тогда
	 
	 	МассивРеквизитовОперации.Добавить("СрокИсполнения");
		МассивРеквизитовОперации.Добавить("ТипСведений");
		МассивРеквизитовОперации.Добавить("СчетКонтрагента");
		
		//ТЧ Бюджет
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваБюджет.Номенклатура");
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваБюджет.ЕдиницаИзмерения");
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваБюджет.ОКП");
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваБюджет.Количество");
		
		//ТЧ Внебюджет
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваВнебюджет.Номенклатура");
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваВнебюджет.ЕдиницаИзмерения");
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваВнебюджет.ОКП");
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваВнебюджет.Количество");
		
	ИначеЕсли ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательство 
		ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ОтказОтДоговораКонкурсныеПроцедуры
		ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения
		ИЛИ ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация Тогда
		
		//ТЧ Бюджет
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваБюджет.Номенклатура");
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваБюджет.ЕдиницаИзмерения");
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваБюджет.ОКП");
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваБюджет.Количество");
		
		//ТЧ Внебюджет
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваВнебюджет.Номенклатура");
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваВнебюджет.ЕдиницаИзмерения");
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваВнебюджет.ОКП");
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваВнебюджет.Количество");
    		
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда
		
		//ТЧ Бюджет
		МассивРеквизитовОперации.Добавить("РасшифровкаОбязательстваБюджет.Номенклатура");
		
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг Тогда
		
		МассивРеквизитовОперации.Добавить("СрокИсполнения");

	КонецЕсли; 
	
КонецФункции

#Область ЗаполнениеДокумента

Процедура ИзменитьСуммыНаПроцент(ДокументОбъект, ВидГрафика) Экспорт
	
	КоэффициентПересчета   = Окр(ДокументОбъект[ВидГрафика + "ПроцентИндексации"] / 100, 4);
	НачалоПериодаПересчета = ДокументОбъект[ВидГрафика + "НачалоПериодаПересчета"];
	КонецПериодаПересчета  = ДокументОбъект[ВидГрафика + "КонецПериодаПересчета"];
	
	// Пересчитываем суммы по графику платежей, графику исполнения за периоды, которые еще не завершились,
	// либо в соответствии с отбором по периоду.
	Для Каждого СтрокаГрафика Из ДокументОбъект[ВидГрафика] Цикл
		
		Если ВидГрафика = "ГрафикПлатежей" Тогда
			ДатаИсполненияВнеПериодаПересчета = ДатаИсполненияВнеПериодаПересчета(СтрокаГрафика.ОплатитьДо,
				НачалоПериодаПересчета, КонецПериодаПересчета, ДокументОбъект.Дата);
		Иначе
			ДатаИсполненияВнеПериодаПересчета = ДатаИсполненияВнеПериодаПересчета(СтрокаГрафика.ИсполнитьДо,
				НачалоПериодаПересчета, КонецПериодаПересчета, ДокументОбъект.Дата);
		КонецЕсли;
		Если ДатаИсполненияВнеПериодаПересчета Тогда
			СтрокаГрафика.СуммаВВалюте = 0;
			Продолжить;
		КонецЕсли;
		
		СтрокаГрафика.СуммаВВалюте = // Сумма "до изменения", скорректированная на коэффициент пересчета.
			СтрокаГрафика.СуммаВВалютеДоИзменений * КоэффициентПересчета;
			
		СтрокаГрафика.СуммаВВалютеПослеИзменений =
			СтрокаГрафика.СуммаВВалютеДоИзменений + СтрокаГрафика.СуммаВВалюте;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РаспределитьСуммуПоПериодам(ДокументОбъект, ВидГрафика) Экспорт
	
	СуммаРаспределенная    = ДокументОбъект[ВидГрафика + "СуммаРаспределенная"];
	НачалоПериодаПересчета = ДокументОбъект[ВидГрафика + "НачалоПериодаПересчета"];
	КонецПериодаПересчета  = ДокументОбъект[ВидГрафика + "КонецПериодаПересчета"];
	
	// Опредеяем базу распределения по периодам.
	НовыйГрафик = ДокументОбъект[ВидГрафика].Выгрузить(,"НомерСтроки,СуммаВВалютеДоИзменений,СуммаВВалюте,"
		+ ?(ВидГрафика = "ГрафикПлатежей", "ОплатитьДо", "ИсполнитьДо"));
	НовыйГрафик.Колонки.Добавить("БазаРаспределения");
	Для Каждого СтрокаГрафика Из НовыйГрафик Цикл
		
		Если ВидГрафика = "ГрафикПлатежей" Тогда
			ДатаИсполненияВнеПериодаПересчета = ДатаИсполненияВнеПериодаПересчета(СтрокаГрафика.ОплатитьДо,
				НачалоПериодаПересчета, КонецПериодаПересчета, ДокументОбъект.Дата);
		Иначе
			ДатаИсполненияВнеПериодаПересчета = ДатаИсполненияВнеПериодаПересчета(СтрокаГрафика.ИсполнитьДо,
				НачалоПериодаПересчета, КонецПериодаПересчета, ДокументОбъект.Дата);
		КонецЕсли;
		
		СтрокаГрафика.БазаРаспределения = ?(ДатаИсполненияВнеПериодаПересчета, 0, СтрокаГрафика.СуммаВВалютеДоИзменений);
		
	КонецЦикла;
	
	// Распределяем сумму по периодам.
	ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СуммаРаспределенная,
		НовыйГрафик, "СуммаВВалюте", "БазаРаспределения");
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ВидГрафика] Цикл
		
		СтрокаГрафика = НовыйГрафик.Найти(СтрокаТаблицы.НомерСтроки, "НомерСтроки");
		СтрокаТаблицы.СуммаВВалюте = ?(СтрокаГрафика <> Неопределено, СтрокаГрафика.СуммаВВалюте, 0);
		
		СтрокаТаблицы.СуммаВВалютеПослеИзменений =
			СтрокаТаблицы.СуммаВВалютеДоИзменений + СтрокаТаблицы.СуммаВВалюте;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДатаИсполненияВнеПериодаПересчета(ДатаИсполнения, НачалоПериодаПересчета, КонецПериодаПересчета, ДатаДокумента)
	
	Если Не ЗначениеЗаполнено(НачалоПериодаПересчета)
		И НЕ ЗначениеЗаполнено(КонецПериодаПересчета) Тогда // За незавершенные периоды графика.
		Если ДатаИсполнения < ДатаДокумента Тогда
			Возврат Истина; // Вне периода пересчета.
		КонецЕсли;
	Иначе // За указанный период.
		Если (ЗначениеЗаполнено(НачалоПериодаПересчета) И ДатаИсполнения < НачалоПериодаПересчета)
			ИЛИ (ЗначениеЗаполнено(КонецПериодаПересчета) И ДатаИсполнения > КонецПериодаПересчета) Тогда
			Возврат Истина; // Вне периода пересчета.
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#КонецОбласти
	
#Область УстаревшиеПроцедурыИФункции

// Устарела 
// Функция получает данные для формирования печатной формы "Сведения о государственном контракте"
//
// Параметры:
// 		ПараметрыПечати - Структура
// 		МассивОбъектов - Массив - Массив ссылок на документы, по которым необходимо получить данные
//
// Возвращаемое значение:
