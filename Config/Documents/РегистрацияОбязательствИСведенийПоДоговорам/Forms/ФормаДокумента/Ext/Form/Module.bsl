		Объект.НачалоДействия = Период.ДатаНачала;
		Объект.ОкончаниеДействия = Период.ДатаОкончания;
	КонецЕсли;
	
КонецПроцедуры

// КонтрольИсполненияДоговоров
&НаКлиенте
Процедура КонструкторГрафиковИсполненияПоДоговору(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("Дата", Объект.Дата);
	ПараметрыФормы.Вставить("ИФО", Объект.ИФО);
	ПараметрыФормы.Вставить("Договор", Объект.Договор);
	ПараметрыФормы.Вставить("Валюта", Объект.ВалютаДокумента);
	ПараметрыФормы.Вставить("НачалоПериода", Объект.НачалоДействия);
	ПараметрыФормы.Вставить("КонецПериода", Объект.ОкончаниеДействия);
	ПараметрыФормы.Вставить("ДопустимыеСчета", ЭтотОбъект.КэшПараметров.Локальные.ДопустимыеСчетаПоВидуДоговора);
	ПараметрыФормы.Вставить("ВидДокумента", "РегистрацияОбязательствИСведенийПоДоговорам");
	
	Если Объект.ГрафикПлатежей.Количество() > 0
		И Объект.ГрафикИсполнения.Количество() > 0 Тогда
		// КФО и КПС берем из первой строки, если совпадают.
		Если Объект.ГрафикПлатежей[0].КФО = Объект.ГрафикИсполнения[0].КФО Тогда
			ПараметрыФормы.Вставить("КФО", Объект.ГрафикПлатежей[0].КФО);
		КонецЕсли;
		Если Объект.ГрафикПлатежей[0].КПС = Объект.ГрафикИсполнения[0].КПС Тогда
			ПараметрыФормы.Вставить("КПС", Объект.ГрафикПлатежей[0].КПС);
		КонецЕсли;
		Если Объект.ГрафикПлатежей[0].КЭК = Объект.ГрафикИсполнения[0].КЭК Тогда
			ПараметрыФормы.Вставить("КЭК", Объект.ГрафикПлатежей[0].КЭК);
		КонецЕсли;
		Если Объект.ГрафикПлатежей[0].СчетРасчетов = Объект.ГрафикИсполнения[0].СчетРасчетов Тогда
			ПараметрыФормы.Вставить("СчетРасчетов", Объект.ГрафикПлатежей[0].СчетРасчетов);
		КонецЕсли;
	КонецЕсли;
	
	ГрафикПлатежейИтог = Объект.ГрафикПлатежей.Итог("СуммаВВалюте");
	ГрафикИсполненияИтог = Объект.ГрафикИсполнения.Итог("СуммаВВалюте");
	Если ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей И ЭтотОбъект.КэшПараметров.Локальные.ВестиПланГрафикИсполнения Тогда
		СуммаПоДоговору = ?(ГрафикПлатежейИтог = ГрафикИсполненияИтог, ГрафикПлатежейИтог, 0);
	ИначеЕсли ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей Тогда
		СуммаПоДоговору = ГрафикПлатежейИтог;
	ИначеЕсли ЭтотОбъект.КэшПараметров.Локальные.ВестиПланГрафикИсполнения Тогда
		СуммаПоДоговору = ГрафикИсполненияИтог;
	КонецЕсли;
	ПараметрыФормы.Вставить("СуммаПоДоговору", СуммаПоДоговору);
	
	ОткрытьФорму("Документ.РегистрацияГрафиковИсполненияДоговоров.Форма.КонструкторГрафиковИсполненияДоговоров",
		ПараметрыФормы, ЭтотОбъект, ЭтотОбъект.УникальныйИдентификатор);
	
КонецПроцедуры

