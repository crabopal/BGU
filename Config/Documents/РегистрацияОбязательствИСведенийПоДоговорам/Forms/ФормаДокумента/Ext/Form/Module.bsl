	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("КодТекущейСтроки", Элемент.ТекстРедактирования);
	ОткрытьФорму("Справочник.ОбщероссийскийКлассификаторПродукции.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРасшифровкаОбязательстваВнебюджет

&НаКлиенте
Процедура РасшифровкаОбязательстваВнебюджетВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)  
	Если Элемент.ДанныеСтроки(ВыбраннаяСтрока).ЗапретИзменения И Поле.Имя = "РасшифровкаОбязательстваВнебюджетНоменклатура" Тогда 
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, Элемент.ДанныеСтроки(ВыбраннаяСтрока).Номенклатура);  
	КонецЕсли;	
КонецПроцедуры

