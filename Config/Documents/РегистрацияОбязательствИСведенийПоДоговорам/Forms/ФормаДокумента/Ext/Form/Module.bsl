&НаСервере
Процедура УстановитьСпискиВыбораКФО()
	
	Элементы.РасшифровкаОбязательстваБюджетКФО.СписокВыбора.ЗагрузитьЗначения(СвойстваЛицевогоСчета.КФОпоЛСБюджет);
	Элементы.РасшифровкаОбязательстваБюджетКФО.СписокВыбора.СортироватьПоЗначению();
	
	Если ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		Элементы.РасшифровкаОбязательстваВнебюджетКФО.СписокВыбора.ЗагрузитьЗначения(СвойстваЛицевогоСчета.КФОпоЛСВнебюджет);	
	Иначе	
		Элементы.РасшифровкаОбязательстваВнебюджетКФО.СписокВыбора.ЗагрузитьЗначения(ДопустимыекКФООрганизации.ВыгрузитьЗначения());
	КонецЕсли;	
	Элементы.РасшифровкаОбязательстваВнебюджетКФО.СписокВыбора.СортироватьПоЗначению();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОперациюИДопРеквизитыПоОснованию()
	
	Если НЕ Объект.Основание.Пустая() Тогда
		ТиповаяОперацияДокумента = БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(Объект.Основание);
		ДопРеквизиты = БухгалтерскиеОперацииСервер.ЗаполнитьДополнительныеРеквизиты(Объект.Основание, ТиповаяОперацияДокумента);
		
		Если ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента") Тогда
			Если НЕ Объект.Ссылка.Пустая() Тогда
				
				Отказ = Ложь;
				ПараметрыЗаписиТиповойОперации = БухгалтерскиеОперацииСервер.ЗаписатьТиповуюОперациюИДопРеквизиты_Параметры();
				ПараметрыЗаписиТиповойОперации.Документ					= Объект.Ссылка;
				ПараметрыЗаписиТиповойОперации.Операция					= ТиповаяОперацияДокумента;
				ПараметрыЗаписиТиповойОперации.Организация				= Объект.Организация;
				ПараметрыЗаписиТиповойОперации.Дата						= Объект.Дата;
				ПараметрыЗаписиТиповойОперации.ДополнительныеРеквизиты	= ДопРеквизиты;
				
				БухгалтерскиеОперацииСервер.ЗаписатьТиповуюОперациюИДопРеквизиты(ПараметрыЗаписиТиповойОперации, Отказ);
			КонецЕсли;
		Иначе
			
			БухгалтерскиеОперацииСервер.ПриИзмененииТиповойОперации(ЭтаФорма.Элементы.ТиповыеОперации_ТиповаяОперацияДокумента);
			ИменаРевизитов = БухгалтерскиеОперацииСервер.ПолучитьИменаРеквизитовФормы(ЭтаФорма,,Истина);
			
			Для каждого ДопРеквизит Из ДопРеквизиты Цикл
				Если ДопРеквизит.Ключ <> "Курс"
					И ДопРеквизит.Ключ <> "Кратность"
					И ИменаРевизитов.Найти(ВРег(ДопРеквизит.Ключ)) <> Неопределено Тогда
					ЭтаФорма[ДопРеквизит.Ключ] = ДопРеквизит.Значение;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

