#КонецОбласти

&НаСервере
Процедура ОбработкаДобавленияДанныхКонтрактаИзЕИСНаСервере(ДанныеИзКонтрактаЕИС)
	
	Если ЭтоБюджетополучатель Тогда
		Объект.РасшифровкаОбязательстваБюджет.Очистить();	
	Иначе
		Объект.РасшифровкаОбязательстваВнебюджет.Очистить();	
	КонецЕсли;	
	
	ДанныеКонтрактаИзЕИС = ПолучитьИзВременногоХранилища(ДанныеИзКонтрактаЕИС.АдресЗаполнениеДанныхИзЕИСВХранилище);
	ДанныеОбъектовЗакупки = ДанныеКонтрактаИзЕИС.ОбъектыЗакупки;
	ОбщиеДанныеДляЗаполнения = ДанныеКонтрактаИзЕИС.ОбщиеРеквизиты;
	
	Для Каждого ТекСтрока Из ДанныеОбъектовЗакупки Цикл
		ДанныеДляЗаполненияСтроки = Новый Структура;
		ДанныеДляЗаполненияСтроки.Вставить("ДопКлассификация", ОбщиеДанныеДляЗаполнения.ДопКлассификация);
		ДанныеДляЗаполненияСтроки.Вставить("КодМероприятия", ОбщиеДанныеДляЗаполнения.КодМероприятия);
		ДанныеДляЗаполненияСтроки.Вставить("КодЦели", ОбщиеДанныеДляЗаполнения.КодЦели);
		ДанныеДляЗаполненияСтроки.Вставить("КПС", ОбщиеДанныеДляЗаполнения.КПС);
		ДанныеДляЗаполненияСтроки.Вставить("КФО", ОбщиеДанныеДляЗаполнения.КФО);
		ДанныеДляЗаполненияСтроки.Вставить("КЭК", ОбщиеДанныеДляЗаполнения.КЭК);
		ДанныеДляЗаполненияСтроки.Вставить("ОбъектФАИП", ОбщиеДанныеДляЗаполнения.ОбъектФАИП);
		ДанныеДляЗаполненияСтроки.Вставить("ПериодПлана", ОбщиеДанныеДляЗаполнения.ПериодПлана);
		ДанныеДляЗаполненияСтроки.Вставить("РазделЛицевогоСчета", ОбщиеДанныеДляЗаполнения.РазделЛицевогоСчета);
		ДанныеДляЗаполненияСтроки.Вставить("Подразделение", ОбщиеДанныеДляЗаполнения.Подразделение);

		ДанныеДляЗаполненияСтроки.Вставить("ЕдиницаИзмерения", ТекСтрока.ЕдиницаИзмерения);
		ДанныеДляЗаполненияСтроки.Вставить("Количество", ТекСтрока.Количество);
		ДанныеДляЗаполненияСтроки.Вставить("Номенклатура", ТекСтрока.Номенклатура);
		ДанныеДляЗаполненияСтроки.Вставить("ОКП", ТекСтрока.ОКП);
		ДанныеДляЗаполненияСтроки.Вставить("Сумма", ТекСтрока.Сумма);
		
		Если ЭтоБюджетополучатель Тогда
			НоваяСтрока = Объект.РасшифровкаОбязательстваБюджет.Добавить();
		Иначе
			НоваяСтрока = Объект.РасшифровкаОбязательстваВнебюджет.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеДляЗаполненияСтроки); 
	КонецЦикла;	
	
КонецПроцедуры	

