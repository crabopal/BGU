&НаКлиенте
Процедура ОбновитьИтоги(ПересчитатьСуммы = Истина)
	
	Если СуммаПоДоговоруЗаполняетсяАвтоматически И ПересчитатьСуммы Тогда
		РассчитатьСуммуАвтоматически();
	КонецЕсли;	

	ИтогоБюджетВнебюджет 		= Объект.РасшифровкаОбязательстваБюджет.Итог("Сумма") + Объект.РасшифровкаОбязательстваВнебюджет.Итог("Сумма");
	ИтогоБюджетВнебюджетВалюта 	= Объект.РасшифровкаОбязательстваБюджет.Итог("СуммаВВалюте") + Объект.РасшифровкаОбязательстваВнебюджет.Итог("СуммаВВалюте");
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммы()
	
	Если Не УчетРасчетовКлиентСервер.ВедетсяУчетОбязательств(ЭтотОбъект.КэшПараметров.Локальные.ВидДоговора) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Пересчитать суммы из валюты в валюту?'");
	СписокКнопок = Новый СписокЗначений;
	СписокКнопок.Добавить(1, "Пересчитать из " + Строка(Объект.ВалютаДокумента) + " в " + Строка(ВалютаРегламентированногоУчета));
	СписокКнопок.Добавить(2, "Пересчитать из " + Строка(ВалютаРегламентированногоУчета) + " в " + Строка(Объект.ВалютаДокумента));
	СписокКнопок.Добавить(3, "Не пересчитывать суммы");
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ПересчитатьСуммыВопрос", ЭтотОбъект), ТекстВопроса, СписокКнопок,, 1); 
	
КонецПроцедуры	

&НаКлиенте
Процедура ПересчитатьСуммыВопрос(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ = 1 Тогда
		
		ИмяКолонкиНачальной = "СуммаВВалюте";
		ВалютаНачальная 	= Объект.ВалютаДокумента;
		ВалютаКонечная 		= ВалютаРегламентированногоУчета;
		
	ИначеЕсли Ответ = 2 Тогда
		
		ИмяКолонкиНачальной = "Сумма";
		ВалютаНачальная = ВалютаРегламентированногоУчета;
		ВалютаКонечная = Объект.ВалютаДокумента;
		
	КонецЕсли;
	
	Если Ответ <> 3 Тогда
		
		Для Каждого СтрокаТЧ Из Объект.РасшифровкаОбязательстваБюджет Цикл
			ПересчитатьСтрокуПоВалюте(СтрокаТЧ, ИмяКолонкиНачальной, ВалютаНачальная, ВалютаКонечная, Ложь);
		КонецЦикла; 
		
		Для Каждого СтрокаТЧ Из Объект.РасшифровкаОбязательстваВнебюджет Цикл
			ПересчитатьСтрокуПоВалюте(СтрокаТЧ, ИмяКолонкиНачальной, ВалютаНачальная, ВалютаКонечная, Ложь);
		КонецЦикла; 
				
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокуПоВалюте(ТекущаяСтрока, ИмяКолонкиНачальной, ВалютаНачальная, ВалютаКонечная, ЗадаватьВопрос = Истина)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("ТекущаяСтрока", 			ТекущаяСтрока);
	ПараметрыРасчета.Вставить("ИмяКолонкиНачальной", 	ИмяКолонкиНачальной);
	ПараметрыРасчета.Вставить("ВалютаНачальная", 		ВалютаНачальная);
	ПараметрыРасчета.Вставить("ВалютаКонечная", 		ВалютаКонечная);
	
	
	Если ЗадаватьВопрос И ВалютаНачальная <> ВалютаКонечная Тогда
		
		ТекстВопроса = НСтр("ru = 'Пересчитать сумму в валюте " + Строка(ВалютаКонечная) + "?'");
		
		ОписаниеОповещенияПересчет = Новый ОписаниеОповещения("ПересчитатьСтрокуПоВалютеВопрос", ЭтотОбъект, ПараметрыРасчета); 

		ПоказатьВопрос(ОписаниеОповещенияПересчет, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 10, КодВозвратаДиалога.Да, "Изменение суммы обязательства", КодВозвратаДиалога.Да);
		
	Иначе
		
		ПересчитатьСтрокуПоВалютеДействие(ПараметрыРасчета);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокуПоВалютеВопрос(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
	     ПересчитатьСтрокуПоВалютеДействие(ДопПараметры);
		 
	КонецЕсли;	 
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокуПоВалютеДействие(ПараметрыРасчета)
	
	ТекущаяСтрока		= ПараметрыРасчета.ТекущаяСтрока;
	ИмяКолонкиНачальной	= ПараметрыРасчета.ИмяКолонкиНачальной;
	ВалютаНачальная		= ПараметрыРасчета.ВалютаНачальная;
	ВалютаКонечная		= ПараметрыРасчета.ВалютаКонечная;
		
	КурсНачальный 		= ?(ВалютаНачальная = ВалютаРегламентированногоУчета, КурсВалютыРегламентированногоУчета, Объект.Курс);
	КурсКонечный 		= ?(ВалютаКонечная = ВалютаРегламентированногоУчета, КурсВалютыРегламентированногоУчета, Объект.Курс);
	
	КратностьНачальная 	= ?(ВалютаНачальная = ВалютаРегламентированногоУчета, КратностьВалютыРегламентированногоУчета, Объект.Кратность);
	КратностьКонечная 	= ?(ВалютаКонечная = ВалютаРегламентированногоУчета, КратностьВалютыРегламентированногоУчета, Объект.Кратность);
	
	ИмяКолонкиКонечной 	= ?(ИмяКолонкиНачальной = "Сумма", "СуммаВВалюте", "Сумма");

	ТекущаяСтрока[ИмяКолонкиКонечной] = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
		ТекущаяСтрока[ИмяКолонкиНачальной], 
		Новый Структура("Валюта, Курс, Кратность", ВалютаНачальная, КурсНачальный, КратностьНачальная),
		Новый Структура("Валюта, Курс, Кратность", ВалютаКонечная, КурсКонечный, КратностьКонечная));
		
	Если ТекущаяСтрока.Свойство(ИмяКолонкиКонечной + "Изменения") Тогда	
		ТекущаяСтрока[ИмяКолонкиКонечной + "Изменения"] = ТекущаяСтрока[ИмяКолонкиКонечной] - ТекущаяСтрока[ИмяКолонкиКонечной + "ДоИзменений"];	
	КонецЕсли;

КонецПроцедуры

