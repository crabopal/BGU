&НаСервере
Процедура УстановитьВидимостьВалютныхРеквизитов()
	
	ВидимостьВалютныхРеквизитов =
		НЕ (Объект.ВалютаДокумента = ВалютаРегламентированногоУчета)
		И УчетРасчетовКлиентСервер.ВедетсяУчетОбязательств(ЭтотОбъект.КэшПараметров.Локальные.ВидДоговора);
	
	РеглВалютаТекстом = "Сумма в " + Строка(ВалютаРегламентированногоУчета);
	ВалютаТекстом = "Сумма в " + Строка(Объект.ВалютаДокумента);
	
	ВалютныеРеквизиты = Новый Массив;
	ВалютныеРеквизиты.Добавить("Курс");
	ВалютныеРеквизиты.Добавить("Кратность");
	ВалютныеРеквизиты.Добавить("ОбновитьКурсВалюты");
	ВалютныеРеквизиты.Добавить("ОплатаВРублях");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ВалютныеРеквизиты, "Видимость", ВидимостьВалютныхРеквизитов);
	
	// Элементы в табличных частях
	Элементы.РасшифровкаОбязательстваБюджетСуммаВВалюте.Видимость 				= ВидимостьВалютныхРеквизитов;
	Элементы.РасшифровкаОбязательстваБюджетСуммаВВалютеДоИзменений.Видимость 	= (ВидимостьВалютныхРеквизитов И ЭтоДокументКорректировка);
	Элементы.РасшифровкаОбязательстваБюджетСуммаВВалютеИзменения.Видимость 		= (ВидимостьВалютныхРеквизитов И ЭтоДокументКорректировка);
	Элементы.РасшифровкаОбязательстваВнебюджетСуммаВВалюте.Видимость 			= ВидимостьВалютныхРеквизитов;
	Элементы.РасшифровкаОбязательстваВнебюджетСуммаВВалютеДоИзменений.Видимость = (ВидимостьВалютныхРеквизитов И ЭтоДокументКорректировка);
	Элементы.РасшифровкаОбязательстваВнебюджетСуммаВВалютеИзменения.Видимость 	= (ВидимостьВалютныхРеквизитов И ЭтоДокументКорректировка);
	
 	Если ВидимостьВалютныхРеквизитов Тогда
		
		Элементы.РасшифровкаОбязательстваБюджетСуммаДоИзменений.Заголовок 		= РеглВалютаТекстом; 
		Элементы.РасшифровкаОбязательстваБюджетСуммаИзменения.Заголовок 		= РеглВалютаТекстом;
		Элементы.РасшифровкаОбязательстваБюджетСумма.Заголовок 					= РеглВалютаТекстом;
		
		Элементы.РасшифровкаОбязательстваВнебюджетСуммаДоИзменений.Заголовок 	= РеглВалютаТекстом; 
		Элементы.РасшифровкаОбязательстваВнебюджетСуммаИзменения.Заголовок 		= РеглВалютаТекстом;
		Элементы.РасшифровкаОбязательстваВнебюджетСумма.Заголовок 				= РеглВалютаТекстом;
		
		Элементы.РасшифровкаОбязательстваБюджетСуммаВВалютеДоИзменений.Заголовок 	= ВалютаТекстом;
		Элементы.РасшифровкаОбязательстваБюджетСуммаВВалютеИзменения.Заголовок 		= ВалютаТекстом;
		Элементы.РасшифровкаОбязательстваБюджетСуммаВВалюте.Заголовок 				= ВалютаТекстом;
		
	Иначе
		
		Элементы.РасшифровкаОбязательстваБюджетСумма.Заголовок = "Сумма";
		
	КонецЕсли; 
	
	// Итоговые значения
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаИтогиВал", "Видимость", ВидимостьВалютныхРеквизитов);
	
	Если ВидимостьВалютныхРеквизитов Тогда
		Элементы.ИтогоБюджет.Заголовок 					= "Бюджетные средства, " + РеглВалютаТекстом;
		Элементы.ИтогоБюджетВнебюджет.Заголовок 		= "Итого, " + РеглВалютаТекстом;
		Элементы.ИтогоВнебюджет.Заголовок 				= "Внебюджетные средства, " + РеглВалютаТекстом;
		Элементы.ИтогоБюджетВалюта.Заголовок 			= "Бюджетные средства, " + ВалютаТекстом;
		Элементы.ИтогоБюджетВнебюджетВалюта.Заголовок 	= "Итого, " + ВалютаТекстом;
		Элементы.ИтогоВнебюджетВалюта.Заголовок 		= "Внебюджетные средства, " + ВалютаТекстом;
	Иначе
		Элементы.ИтогоБюджет.Заголовок 					= "Бюджетные средства";
		Элементы.ИтогоБюджетВнебюджет.Заголовок 		= "Итого";
		Элементы.ИтогоВнебюджет.Заголовок 				= "Внебюджетные средства";
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПоВидуОперации()
	
	МассивЭлементов = Новый Массив();
	МассивЭлементов.Добавить("РасшифровкаОбязательстваБюджет");
	МассивЭлементов.Добавить("РасшифровкаОбязательстваВнебюджет");
	МассивЭлементов.Добавить("ПримечаниеБюджет");
	МассивЭлементов.Добавить("РезультативностьИспользованияСубсидии");
	МассивЭлементов.Добавить("Контрагенты");
	МассивЭлементов.Добавить("ГруппаИсполнениеСуммыИСроки");
	МассивЭлементов.Добавить("ГруппаСтраницаДополнительно");
	МассивЭлементов.Добавить("ГруппаБухгалтерскаяОперация");
	МассивЭлементов.Добавить("ГруппаИтоги");
	МассивЭлементов.Добавить("ИнформационныеСсылки");
	МассивЭлементов.Добавить("ВидОбязательства");
	МассивЭлементов.Добавить("СчетКонтрагента");
	МассивЭлементов.Добавить("КазначейскоеСопровождение");
	МассивЭлементов.Добавить("ЛицевойСчет");
	МассивЭлементов.Добавить("ОрганКазначейства");
	МассивЭлементов.Добавить("ОрганКазначействаУФК");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Видимость",
		ЭтотОбъект.КэшПараметров.Локальные.ВедетсяУчетОбязательств);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИФО", "АвтоОтметкаНезаполненного",
		ЭтотОбъект.КэшПараметров.Локальные.ВедетсяУчетОбязательств);
	
	ЕстьСведенияДоИзменений =
			ЗначениеЗаполнено(Объект.НачалоДействияДоИзменений)
		ИЛИ ЗначениеЗаполнено(Объект.ОкончаниеДействияДоИзменений)
		ИЛИ ЗначениеЗаполнено(Объект.СрокИсполненияДоИзменений);
	ЭлементыДоИзменений = Новый Массив;
	ЭлементыДоИзменений.Добавить("НачалоДействияДоИзменений");
	ЭлементыДоИзменений.Добавить("ОкончаниеДействияДоИзменений");
	ЭлементыДоИзменений.Добавить("СрокИсполненияДоИзменений");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыДоИзменений, "Видимость", ЕстьСведенияДоИзменений);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаСтраницы", "ОтображениеСтраниц",
		?(ЭтотОбъект.КэшПараметров.Локальные.ВедетсяУчетОбязательств
		ИЛИ ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей
		ИЛИ ЭтотОбъект.КэшПараметров.Локальные.ВестиПланГрафикИсполнения,
			ОтображениеСтраницФормы.ЗакладкиСверху, ОтображениеСтраницФормы.Нет) );
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОсновноеПослеИзменений", "Заголовок",
		?(ЕстьСведенияДоИзменений, НСтр("ru = 'После изменений'"), НСтр("ru = 'Сроки договора (обязательства)'")) );
	
	ЭлементыЗаполнитьГрафик = Новый Массив;
	ЭлементыЗаполнитьГрафик.Добавить("ГрафикПлатежейЗаполнитьПоОбязательствам");
	ЭлементыЗаполнитьГрафик.Добавить("ГрафикИсполненияЗаполнитьПоОбязательствам");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыЗаполнитьГрафик, "Видимость",
		ЭтотОбъект.КэшПараметров.Локальные.ВедетсяУчетОбязательств); // Заполнение по ланным о принятых обязательствах.
	
	ЭлементыЗаполнитьГрафик = Новый Массив;
	ЭлементыЗаполнитьГрафик.Добавить("ГрафикПлатежейЗаполнитьОстаткиПоДоговору");
	ЭлементыЗаполнитьГрафик.Добавить("ГрафикИсполненияЗаполнитьОстаткиПоДоговору");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыЗаполнитьГрафик, "Видимость",
		ЭтоДокументКорректировка); // Заполнение неисполненными остатками по договору.
	
	////////////////////////////////////////////////////////////////////////////////
	// Обязательство с учетом предмета
	ВидимостьОбязательствоУчетПредмета = (Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоУчетПредмета
	                                  ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательство
									  ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоКонкурсныеПроцедуры
	                                  ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательстваУчетПредмета
									  ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаПеререгистрациюОбязательстваУчетПредмета
									  ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ОтказОтДоговораКонкурсныеПроцедуры
									  ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения
									  ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация);
	
	// Для загрузки из ЕИС
	Если ВидимостьОбязательствоУчетПредмета И ЗначениеЗаполнено(Объект.Договор) Тогда
		Если НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "УчетПредметаДоговора") Тогда
			ВидимостьОбязательствоУчетПредмета = Ложь;
		КонецЕсли;
	КонецЕсли;
	
  	МассивЭлементов = Новый Массив();
  	МассивЭлементов.Добавить("ПримечаниеКРазделу5");
  	МассивЭлементов.Добавить("РасшифровкаОбязательстваБюджетГруппаЕдОКП");
  	МассивЭлементов.Добавить("РасшифровкаОбязательстваБюджетКоличество");
  	МассивЭлементов.Добавить("РасшифровкаОбязательстваВнебюджетГруппаНоменклатураАналитика");
  	МассивЭлементов.Добавить("РасшифровкаОбязательстваВнебюджетКоличество");
  	МассивЭлементов.Добавить("ТипСведений");
	
	Если НЕ ЭтоСоглашениеОСубсидии Тогда
	 	МассивЭлементов.Добавить("РасшифровкаОбязательстваБюджетГруппаНоменклатураАналитика");
	Иначе
		Элементы.РасшифровкаОбязательстваБюджетГруппаНоменклатураАналитика.Видимость = Истина;
		Элементы.ГруппаРуководитель.Видимость = Истина;
	КонецЕсли;
	
	Если ЭтоПредоставленныйЗаем ИЛИ ЭтоПолученныйКредит ИЛИ ЭтоВыпускЦенныхБумаг Тогда
		МассивЭлементов.Добавить("ГруппаИсполнениеСрокАванс");
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Видимость", ВидимостьОбязательствоУчетПредмета);
	
	Если Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаПеререгистрациюОбязательстваУчетПредмета 
		ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательство
		ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация Тогда
		Элементы.ТипСведений.Видимость = Ложь;
	ИначеЕсли Не ЭтотОбъект.КэшПараметров.Локальные.ВедетсяУчетОбязательств Тогда
		Элементы.ТипСведений.Видимость = Ложь;
	КонецЕсли; 
	
	////////////////////////////////////////////////////////////////////////////////
	// Перерегистрация обязательства
	
	МассивЭлементов = Новый Массив();
	МассивЭлементов.Добавить("Дата");
	МассивЭлементов.Добавить("Организация");
	МассивЭлементов.Добавить("Контрагент");
	МассивЭлементов.Добавить("Договор");
	МассивЭлементов.Добавить("ЛицевойСчет");
	МассивЭлементов.Добавить("СчетКонтрагента");
	МассивЭлементов.Добавить("ИФО");
	МассивЭлементов.Добавить("АвансПроцентом");
	МассивЭлементов.Добавить("СуммаАванса");
	МассивЭлементов.Добавить("СрокИсполнения");
	МассивЭлементов.Добавить("СчетКонтрагента");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "ТолькоПросмотр", ЭтоПеререгистрация);
	
	////////////////////////////////////////////////////////////////////////////////
	// Изменения по документу
	ВидимостьРеквизитовИзменения = НЕ (Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательство
	                               ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоУчетПредмета
								   ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательство);
	
	// Бюджет
	Элементы.РасшифровкаОбязательстваБюджетСуммыКоличествоДоИзменений.ОтображатьВШапке 	= ВидимостьРеквизитовИзменения;
	Элементы.РасшифровкаОбязательстваБюджетКоличествоДоИзменений.Видимость 				= ЭтоДокументКорректировка И ВидимостьОбязательствоУчетПредмета;
	Элементы.РасшифровкаОбязательстваБюджетСуммаДоИзменений.Видимость 					= ВидимостьРеквизитовИзменения; 
	Элементы.РасшифровкаОбязательстваБюджетСуммаВВалютеБезусловнаяДоИзменений.Видимость = ВидимостьРеквизитовИзменения;
	
	Элементы.РасшифровкаОбязательстваБюджетСуммыКоличествоИзменения.ОтображатьВШапке 	= ВидимостьРеквизитовИзменения;
	Элементы.РасшифровкаОбязательстваБюджетКоличествоИзменения.Видимость 				= ЭтоДокументКорректировка И ВидимостьОбязательствоУчетПредмета;
	Элементы.РасшифровкаОбязательстваБюджетСуммаИзменения.Видимость 					= ВидимостьРеквизитовИзменения;
	Элементы.РасшифровкаОбязательстваБюджетСуммаВВалютеБезусловнаяИзменения.Видимость 	= ВидимостьРеквизитовИзменения;
	
	Элементы.РасшифровкаОбязательстваБюджетСуммыКоличествоВсего.ОтображатьВШапке 		= ВидимостьРеквизитовИзменения;
	
	Элементы.РасшифровкаОбязательстваБюджетКоличество.ШрифтЗаголовка 					= Новый Шрифт(,, ЭтоДокументКорректировка);
	Элементы.РасшифровкаОбязательстваБюджетСумма.ШрифтЗаголовка 						= Новый Шрифт(,, ВидимостьРеквизитовИзменения);
	Элементы.РасшифровкаОбязательстваБюджетСуммаВВалюте.ШрифтЗаголовка 					= Новый Шрифт(,, ВидимостьРеквизитовИзменения);
	Элементы.РасшифровкаОбязательстваБюджетСуммаВВалютеБезусловная.ШрифтЗаголовка 		= Новый Шрифт(,, ВидимостьРеквизитовИзменения);
	
	// Внебюджет	
	Элементы.РасшифровкаОбязательстваВнебюджетСуммыКоличествоДоИзменений.ОтображатьВШапке 	= ВидимостьРеквизитовИзменения;
	Элементы.РасшифровкаОбязательстваВнебюджетКоличествоДоИзменений.Видимость 				= ЭтоДокументКорректировка И ВидимостьОбязательствоУчетПредмета;
	Элементы.РасшифровкаОбязательстваВнебюджетСуммаДоИзменений.Видимость 					= ВидимостьРеквизитовИзменения; 
	Элементы.РасшифровкаОбязательстваВнебюджетСуммаВВалютеБезусловнаяДоИзменений.Видимость 	= ВидимостьРеквизитовИзменения; 
	
	Элементы.РасшифровкаОбязательстваВнебюджетСуммыКоличествоИзменения.ОтображатьВШапке 	= ВидимостьРеквизитовИзменения;
	Элементы.РасшифровкаОбязательстваВнебюджетКоличествоИзменения.Видимость 				= ЭтоДокументКорректировка И ВидимостьОбязательствоУчетПредмета;
	Элементы.РасшифровкаОбязательстваВнебюджетСуммаИзменения.Видимость 						= ВидимостьРеквизитовИзменения;
	Элементы.РасшифровкаОбязательстваВнебюджетСуммаВВалютеБезусловнаяИзменения.Видимость 	= ВидимостьРеквизитовИзменения;
	
	Элементы.РасшифровкаОбязательстваВнебюджетСуммыКоличествоВсего.ОтображатьВШапке 		= ВидимостьРеквизитовИзменения;
	
	Элементы.РасшифровкаОбязательстваВнебюджетКоличество.ШрифтЗаголовка 					= Новый Шрифт(,, ЭтоДокументКорректировка);
	Элементы.РасшифровкаОбязательстваВнебюджетСумма.ШрифтЗаголовка 							= Новый Шрифт(,, ВидимостьРеквизитовИзменения);
	Элементы.РасшифровкаОбязательстваВнебюджетСуммаВВалюте.ШрифтЗаголовка 					= Новый Шрифт(,, ВидимостьРеквизитовИзменения);
	Элементы.РасшифровкаОбязательстваВнебюджетСуммаВВалютеБезусловная.ШрифтЗаголовка 		= Новый Шрифт(,, ВидимостьРеквизитовИзменения);
	
	ЭлементыИзменений = Новый Массив;
	ЭлементыИзменений.Добавить("НомерИзменения");
	ЭлементыИзменений.Добавить("КодПричиныИзменения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыИзменений, "Видимость",
		ЭтотОбъект.КэшПараметров.Локальные.ВедетсяУчетОбязательств И ВидимостьРеквизитовИзменения);
	
	////////////////////////////////////////////////////////////////////////////////
	// Особые виды обязательств
	
	Элементы.ГруппаСтраницаРасшифровкаОбязательстваПД.Видимость = НЕ ЭтоСоглашениеОСубсидии;
	Элементы.ГруппаРезультативностьСубсидии.Видимость 			= ЭтоСоглашениеОСубсидии;
	Элементы.ОтветственныйИсполнитель.Видимость 				= Истина;
	Элементы.ПроцентПоЗайму.Видимость 							= ЭтоПредоставленныйЗаем;
	
	Если Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ОтказОтДоговораКонкурсныеПроцедуры Тогда
		//никаких корректировок не вносится, все данные сторнируются
		Элементы.РасшифровкаОбязательстваБюджет.ТолькоПросмотр = Истина;
		Элементы.РасшифровкаОбязательстваВнебюджет.ТолькоПросмотр = Истина;
	КонецЕсли;
		
	////////////////////////////////////////////////////////////////////////////////
	// Ограничения типа
	
	МассивТипов = Новый Массив;
	
	Если ВидимостьОбязательствоУчетПредмета Тогда 
		МассивТипов.Добавить(Тип("СправочникСсылка.Номенклатура"));	
		МассивТипов.Добавить(Тип("СправочникСсылка.ОсновныеСредства"));	
		МассивТипов.Добавить(Тип("СправочникСсылка.ДенежныеДокументы"));
	ИначеЕсли ЭтоСоглашениеОСубсидии Тогда
		МассивТипов.Добавить(Тип("СправочникСсылка.ЦелиПредоставленныхСубсидий"));
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РасшифровкаОбязательстваБюджетНоменклатура", "ОграничениеТипа", Новый ОписаниеТипов(МассивТипов));

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПоКорректировке()
	
	Элементы.ГруппаОснованиеИзменений.Видимость = ЭтотОбъект.КэшПараметров.Локальные.ВедетсяУчетОбязательств
	И  (Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательства 
	ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательстваУчетПредмета
	ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВалютаДокумента", "ТолькоПросмотр", ЭтоДокументКорректировка);
	
	Если НЕ Объект.Договор.Пустая() Тогда
		
		ТолькоПросмотр = (НЕ ЭтоДействующийДокумент И Объект.Проведен);
	
		Элементы.ГруппаРедакцияДокумента.Видимость 				= Истина;
		Элементы.ГруппаДействующийДокумент.Видимость 			= (ЭтоДействующийДокумент И Объект.Проведен); // Создаем новый документ и других документов нет еще
		Элементы.ОснованиеДляДействующейРедакции.Видимость 		= НЕ Объект.Основание.Пустая();
		Элементы.ГруппаПереходаКДействующемуДокументу.Видимость = (НЕ ЭтоДействующийДокумент И НЕ Объект.Ссылка.Пустая());
		Элементы.ДейстующийДокумент.Видимость 					= НЕ ДействующийДокумент.Пустая();
			
	Иначе
		
		Элементы.ГруппаРедакцияДокумента.Видимость = Ложь;	
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПоТипуОрганизации()
	
	Элементы.ГруппаСтраницаРасшифровкаОбязательстваБюджет.Видимость = (ЭтоБюджетополучатель ИЛИ Объект.РасшифровкаОбязательстваБюджет.Количество() > 0); 
	Элементы.ГруппаСтраницаПримечаниеБюджет.Видимость = (ЭтоБюджетополучатель ИЛИ Объект.РасшифровкаОбязательстваБюджет.Количество() > 0); 
	
	Элементы.ГруппаСтраницаРасшифровкаОбязательстваПД.Видимость = (НЕ ЭтоБюджетополучатель ИЛИ Объект.РасшифровкаОбязательстваВнебюджет.Количество() > 0);
	
	Элементы.РасшифровкаОбязательстваБюджетПодразделение.Видимость = УчетПоПодразделениям;
	Элементы.РасшифровкаОбязательстваВнебюджетПодразделение.Видимость = УчетПоПодразделениям;
	
	УстановитьВидимостьОрганаКазначейства();
 
КонецПроцедуры	

&НаСервере
Процедура УстановитьВидимостьПоСведениямИзЕИС(Договор)
	ВидимостьСведенийЕИС = Ложь;
 	ВидимостьРеквизитовИзменения = НЕ (Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательство
	                               ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоУчетПредмета
								   ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательство);
	Если ЗначениеЗаполнено(Договор) Тогда
		Если ЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеЗаказчикаВЕИС() Тогда
			ГосударственныйКонтрактЕИС = ЭлектронноеАктированиеЕИС.НайтиГосударственныйКонтрактПоВладельцу(Договор);
			Если ЗначениеЗаполнено(ГосударственныйКонтрактЕИС) И НЕ ВидимостьРеквизитовИзменения Тогда
				ВидимостьСведенийЕИС = Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ЗагружатьИзЕИССведенияОбОбязательствахИРСКП") Тогда
		ВидимостьСведенийЕИС = Ложь;
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтаФорма.Элементы,
		"РасшифровкаОбязательстваБюджетЗаполнитьПоГосКонтрактуИзЕИС", "Видимость", ВидимостьСведенийЕИС);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтаФорма.Элементы,
		"РасшифровкаОбязательстваВнебюджетЗаполнитьПоГосКонтрактуИзЕИС", "Видимость", ВидимостьСведенийЕИС);
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьАвторасчетСуммыДоговора(Форма)
	
	Форма.Элементы.СуммаВВалюте.ТолькоПросмотр = Форма.СуммаПоДоговоруЗаполняетсяАвтоматически;
	Форма.Элементы.Сумма.ТолькоПросмотр = Форма.СуммаПоДоговоруЗаполняетсяАвтоматически;
	Форма.Элементы.РассчитатьСумму.Видимость = НЕ Форма.СуммаПоДоговоруЗаполняетсяАвтоматически;
	
КонецПроцедуры	
	
&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// Недоступные колонки в строках с флагом ЗапретИзменения.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикПлатежейОплатитьДо");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикПлатежейВидРасчетов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикПлатежейИФО");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикПлатежейКФО");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикПлатежейКПС");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикПлатежейКЭК");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикПлатежейСчетРасчетов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикПлатежейДопКлассификация");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикПлатежейКодМероприятия");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикПлатежейКодЦели");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ГрафикПлатежей.ЗапретИзменения", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикИсполненияИсполнитьДо");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикИсполненияИФО");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикИсполненияКФО");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикИсполненияКПС");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикИсполненияКЭК");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ГрафикИсполненияСчетРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ГрафикИсполнения.ЗапретИзменения", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВалютныеРеквизиты()
	
	СтруктураКурсаВалюты 	= РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.ВалютаДокумента, Объект.Дата); 
	Объект.Курс 			= СтруктураКурсаВалюты.Курс;
	Объект.Кратность 		= СтруктураКурсаВалюты.Кратность;
	
КонецПроцедуры

&НаСервере
Процедура ВалютаВзаиморасчетовПриИзмененииСервер()
	
	УстановитьВалютныеРеквизиты();
	УстановитьВидимостьВалютныхРеквизитов();
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииСервер()
	
	Если Объект.Организация.Пустая() Тогда
		Объект.Руководитель = Неопределено;
	Иначе
		Объект.Руководитель = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(Объект.Организация, Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, Объект.Дата).ОтветственноеЛицоСсылка; 
	КонецЕсли;
	
	ДопустимыекКФООрганизации = ПолучитьДопустимыеКФООрганизации(Объект.Организация, Объект.ИФО, Объект.Дата);
	
	ЭтоБюджетополучатель = НЕ ДопустимыекКФООрганизации.НайтиПоЗначению(ПредопределенноеЗначение("Перечисление.КВД.Бюджет")) = Неопределено;
	
	Если ЭтоБюджетополучатель Тогда
		ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию();
	КонецЕсли;
	
	ПроверитьКФОВнебюджет();
	
	УстановитьВидимостьРеквизитов();
	
	УстановитьПараметрыФормы();
	
КонецПроцедуры

 &НаСервере
Процедура ИФОПриИзмененииСервер()
	
	ДопустимыекКФООрганизации = ПолучитьДопустимыеКФООрганизации(Объект.Организация, Объект.ИФО, Объект.Дата);
		
	ЭтоБюджетополучатель = НЕ ДопустимыекКФООрганизации.НайтиПоЗначению(ПредопределенноеЗначение("Перечисление.КВД.Бюджет")) = Неопределено;
	
	ПроверитьКФОВнебюджет();
	
	УстановитьВидимостьРеквизитов();
	
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииСервер()
	
	Объект.ВидОбязательства = Неопределено;
	Объект.Основание = Неопределено;
	
	Для каждого СтрокаТЧ Из Объект.РасшифровкаОбязательстваБюджет Цикл
		СтрокаТЧ.ЗапретИзменения = Ложь;
	КонецЦикла;
	Для каждого СтрокаТЧ Из Объект.РасшифровкаОбязательстваВнебюджет Цикл
		СтрокаТЧ.ЗапретИзменения = Ложь;
	КонецЦикла;
	Для каждого СтрокаТЧ Из Объект.ГрафикПлатежей Цикл
		СтрокаТЧ.ЗапретИзменения = Ложь;
	КонецЦикла;
	Для каждого СтрокаТЧ Из Объект.ГрафикИсполнения Цикл
		СтрокаТЧ.ЗапретИзменения = Ложь;
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(Объект.СчетКонтрагента) Тогда
		Объект.СчетКонтрагента =  Справочники.БанковскиеИКазначейскиеСчета.ПолучитьСчетПоУмолчанию(Объект.Контрагент, "Документ.РегистрацияОбязательствИСведенийПоДоговорам");
	КонецЕсли;
	
	ОпределитьПараметрыРедакцииДокумента();
	УстановитьВидимостьРеквизитов();
	УстановитьПараметрыФормы();
	
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииСервер()
	
	Объект.ВидОбязательства = Неопределено;
	
	Для каждого СтрокаТЧ Из Объект.РасшифровкаОбязательстваБюджет Цикл
		СтрокаТЧ.ЗапретИзменения = Ложь;
	КонецЦикла;
	Для каждого СтрокаТЧ Из Объект.РасшифровкаОбязательстваВнебюджет Цикл
		СтрокаТЧ.ЗапретИзменения = Ложь;
	КонецЦикла;
	Для каждого СтрокаТЧ Из Объект.ГрафикПлатежей Цикл
		СтрокаТЧ.ЗапретИзменения = Ложь;
	КонецЦикла;
	Для каждого СтрокаТЧ Из Объект.ГрафикИсполнения Цикл
		СтрокаТЧ.ЗапретИзменения = Ложь;
	КонецЦикла;
	
	ДокОбъект 			= РеквизитФормыВЗначение("Объект");
	Объект.Договор 		= Справочники.Договоры.ПустаяСсылка(); // Очистим, т.к. ниже может произойти исключение	
	ДокОбъект.Заполнить(ДокОбъект.Договор);
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
	ЗаполнитьОперациюИДопРеквизитыПоОснованию();
	
	ПриИзмененииЛицевогоСчетаСервер();
	
	СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "Долгосрочный,ВидДоговора");
	
	ЭтоДолгосрочныйДоговор		= СтруктураРеквизитов.Долгосрочный;
	ЭтоИноеОбязательство		= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство);
	ЭтоСоглашениеОСубсидии		= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии);
	ЭтоСОтправителемТрансферта	= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта);
	ЭтоПредоставленныйЗаем		= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит);
	ЭтоПолученныйКредит 		= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит);
	ЭтоСПокупателем				= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	ЭтоСПоставщиком				= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	
	УстановитьВидимостьПоСведениямИзЕИС(Объект.Договор);
	ОпределитьПараметрыРедакцииДокумента();
	УстановитьВидимостьРеквизитов();
	УстановитьПараметрыФормы();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииЛицевогоСчетаСервер()
	
	Если НЕ ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		
		Объект.ОрганКазначейства 	= Неопределено;
		Объект.ОрганКазначействаУФК = Неопределено;
		
		Элементы.ОрганКазначейства.СписокВыбора.Очистить();
		Элементы.ОрганКазначействаУФК.СписокВыбора.Очистить();
		
	КонецЕсли;
	
	СвойстваЛицевогоСчета = ПолучитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет, Объект.Дата);
	
	Элементы.ОрганКазначейства.СписокВыбора.ЗагрузитьЗначения(СвойстваЛицевогоСчета.КазначействаЛС);
	Элементы.ОрганКазначействаУФК.СписокВыбора.ЗагрузитьЗначения(СвойстваЛицевогоСчета.КазначействаЛС);
	
	УстановитьСпискиВыбораКФО();
	
	УстановитьВидимостьОрганаКазначейства();
	
	Для каждого СтрокаТЧ Из Объект.РасшифровкаОбязательстваБюджет Цикл
		
		Если ЗначениеЗаполнено(СтрокаТЧ.КФО) И СвойстваЛицевогоСчета.КФОпоЛСБюджет.Найти(СтрокаТЧ.КФО) = Неопределено И НЕ СтрокаТЧ.ЗапретИзменения Тогда
			СтрокаТЧ.КФО = Неопределено;
			СтрокаТЧ.РазделЛицевогоСчета = Неопределено;
		КонецЕсли;
		
		Если НЕ СтрокаТЧ.ЗапретИзменения И НЕ ЗначениеЗаполнено(СтрокаТЧ.КФО) И СвойстваЛицевогоСчета.КФОпоЛСБюджет.Количество() > 0 Тогда
			СтрокаТЧ.КФО = СвойстваЛицевогоСчета.КФОпоЛСБюджет[0];
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТЧ.КФО) И НЕ СтрокаТЧ.ЗапретИзменения Тогда 
			МассивДопустимыеРазделыЛС = СвойстваЛицевогоСчета.РазделыЛСпоКФО[СтрокаТЧ.КФО];
			Если МассивДопустимыеРазделыЛС.Найти(СтрокаТЧ.РазделЛицевогоСчета) = Неопределено Тогда
				Если МассивДопустимыеРазделыЛС.Количество() > 0 Тогда
					СтрокаТЧ.РазделЛицевогоСчета = МассивДопустимыеРазделыЛС[0];
				Иначе
					СтрокаТЧ.РазделЛицевогоСчета = Неопределено;
				КонецЕсли; 
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	ПроверитьКФОВнебюджет();
	
	УстановитьВидимостьВалютныхРеквизитов();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьКФОВнебюджет()
	
	Если ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		МассивКФО = СвойстваЛицевогоСчета.КФОпоЛСВнебюджет;
	Иначе
		МассивКФО = ДопустимыекКФООрганизации.ВыгрузитьЗначения();
	КонецЕсли;	
	
	Для каждого СтрокаТЧ Из Объект.РасшифровкаОбязательстваВнебюджет Цикл
		
		Если МассивКФО.Найти(СтрокаТЧ.КФО) = Неопределено И НЕ СтрокаТЧ.ЗапретИзменения Тогда
			СтрокаТЧ.КФО = Неопределено;
			СтрокаТЧ.РазделЛицевогоСчета = Неопределено;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТЧ.КФО) И НЕ СтрокаТЧ.ЗапретИзменения Тогда 
			Если ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
				МассивДопустимыеРазделыЛС = СвойстваЛицевогоСчета.РазделыЛСпоКФО[СтрокаТЧ.КФО];
				Если МассивДопустимыеРазделыЛС.Найти(СтрокаТЧ.РазделЛицевогоСчета) = Неопределено Тогда
					Если МассивДопустимыеРазделыЛС.Количество() > 0 Тогда
						СтрокаТЧ.РазделЛицевогоСчета = МассивДопустимыеРазделыЛС[0];			
					Иначе
						СтрокаТЧ.РазделЛицевогоСчета = Неопределено;
					КонецЕсли; 		
				КонецЕсли;
			Иначе
				СтрокаТЧ.РазделЛицевогоСчета = Неопределено;
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеДоИзменений()
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	ДанныеДоИзменений.КлючАналитики.ОбъектФАИП КАК ОбъектФАИП,
	|	ДанныеДоИзменений.КлючАналитики.Подразделение КАК Подразделение,
	|	ДанныеДоИзменений.КлючАналитики.КФО КАК КФО,
	|	ДанныеДоИзменений.КлючАналитики.КПС КАК КПС,
	|	ДанныеДоИзменений.КлючАналитики.КЭК КАК КЭК,
	|	ДанныеДоИзменений.КлючАналитики.Номенклатура КАК Номенклатура,
	|	ДанныеДоИзменений.КлючАналитики.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДоИзменений.КлючАналитики.ПериодПлана КАК ПериодПлана,
	|	ДанныеДоИзменений.КлючАналитики.РазделЛицевогоСчета КАК РазделЛицевогоСчета,
	|	ДанныеДоИзменений.КлючАналитики.КодЦели КАК КодЦели,
	|	ДанныеДоИзменений.КлючАналитики.КодМероприятия КАК КодМероприятия,
	|	ДанныеДоИзменений.КлючАналитики.ДопКлассификация КАК ДопКлассификация,
	|	ДанныеДоИзменений.ОКП КАК ОКП,
	|	ДанныеДоИзменений.Количество КАК Количество,
	|	ДанныеДоИзменений.Сумма КАК Сумма,
	|	ДанныеДоИзменений.СуммаВВалюте КАК СуммаВВалюте,
	|	ДанныеДоИзменений.СуммаВВалютеБезусловная
	|ИЗ
	|	РегистрСведений.ПланФинансированияОбязательств.СрезПоследних(
	|			&Период,
	|			Регистратор <> &Регистратор
	|				И Обязательство = &Договор) КАК ДанныеДоИзменений";
				   
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	Запрос.УстановитьПараметр("Регистратор", Объект.Ссылка);
	Запрос.УстановитьПараметр("Договор", Объект.Договор);
	
	ТаблицаДоИзменений = Запрос.Выполнить().Выгрузить();
	
	СтруктураПоиска = Новый Структура("ОбъектФАИП, Подразделение, КФО, КПС, КЭК, Номенклатура, ОКП, ЕдиницаИзмерения, ПериодПлана, РазделЛицевогоСчета, КодЦели, КодМероприятия, ДопКлассификация"); 
	
	Для каждого СтрокаТЧ Из Объект.РасшифровкаОбязательстваБюджет Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТЧ);		
		МассивСтрок = ТаблицаДоИзменений.НайтиСтроки(СтруктураПоиска);
		
		Если МассивСтрок.Количество() > 0 Тогда
			
			НайденнаяСтрока = МассивСтрок[0];
			СтрокаТЧ.КоличествоДоИзменений 				= НайденнаяСтрока.Количество;
			СтрокаТЧ.СуммаДоИзменений 					= НайденнаяСтрока.Сумма;
			СтрокаТЧ.СуммаВВалютеДоИзменений 			= НайденнаяСтрока.СуммаВВалюте;
			СтрокаТЧ.СуммаВВалютеБезусловнаяДоИзменений = НайденнаяСтрока.СуммаВВалютеБезусловная;
			
		КонецЕсли; 
		
		СтрокаТЧ.КоличествоИзменения 				= СтрокаТЧ.Количество 	- СтрокаТЧ.КоличествоДоИзменений;
		СтрокаТЧ.СуммаИзменения 					= СтрокаТЧ.Сумма 		- СтрокаТЧ.СуммаДоИзменений;
		СтрокаТЧ.СуммаВВалютеИзменения 				= СтрокаТЧ.СуммаВВалюте - СтрокаТЧ.СуммаВВалютеДоИзменений;
		СтрокаТЧ.СуммаВВалютеБезусловнаяИзменения 	= СтрокаТЧ.СуммаВВалютеБезусловная - СтрокаТЧ.СуммаВВалютеБезусловнаяДоИзменений;

	КонецЦикла; 
	
	Для каждого СтрокаТЧ Из Объект.РасшифровкаОбязательстваВнебюджет Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТЧ);		
		МассивСтрок = ТаблицаДоИзменений.НайтиСтроки(СтруктураПоиска);
		
		Если МассивСтрок.Количество() > 0 Тогда
			
			НайденнаяСтрока = МассивСтрок[0];
			СтрокаТЧ.КоличествоДоИзменений 				= НайденнаяСтрока.Количество;
			СтрокаТЧ.СуммаДоИзменений 					= НайденнаяСтрока.Сумма;
			СтрокаТЧ.СуммаВВалютеДоИзменений 			= НайденнаяСтрока.СуммаВВалюте;
			СтрокаТЧ.СуммаВВалютеБезусловнаяДоИзменений = НайденнаяСтрока.СуммаВВалютеБезусловная;
			
		КонецЕсли; 
		
		СтрокаТЧ.КоличествоИзменения 				= СтрокаТЧ.Количество - СтрокаТЧ.КоличествоДоИзменений;
		СтрокаТЧ.СуммаИзменения 					= СтрокаТЧ.Сумма - СтрокаТЧ.СуммаДоИзменений;
		СтрокаТЧ.СуммаВВалютеИзменения 				= СтрокаТЧ.СуммаВВалюте - СтрокаТЧ.СуммаВВалютеДоИзменений;
		СтрокаТЧ.СуммаВВалютеБезусловнаяИзменения 	= СтрокаТЧ.СуммаВВалютеБезусловная - СтрокаТЧ.СуммаВВалютеБезусловнаяДоИзменений;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьПараметрыРедакцииДокумента()
	
	СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор,
		"Долгосрочный, ВидДоговора, ВестиГрафикПлатежей, ВестиПланГрафикИсполнения");
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВидДоговора", СтруктураРеквизитов.ВидДоговора);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ИспользоватьКонтрольИсполненияДоговоров", ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров"));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиГрафикПлатежей", СтруктураРеквизитов.ВестиГрафикПлатежей);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиПланГрафикИсполнения", СтруктураРеквизитов.ВестиПланГрафикИсполнения);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВедетсяУчетОбязательств",
		УчетРасчетовКлиентСервер.ВедетсяУчетОбязательств(СтруктураРеквизитов.ВидДоговора));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ДопустимыеСчетаПоВидуДоговора",
		УчетРасчетовКлиентСервер.ДопустимыеСчетаРасчетовПоВидуДоговора(СтруктураРеквизитов.ВидДоговора));
	
	ДоступнаАвтокорректировкаГрафикаПлатежей = Ложь;
	ЕстьСуммыДоИзмененийВГрафикеПлатежей = Ложь;
	Для Каждого СтрокаГрафика Из Объект.ГрафикПлатежей Цикл
		Если СтрокаГрафика.СуммаВВалютеДоИзменений <> 0 Тогда
			ЕстьСуммыДоИзмененийВГрафикеПлатежей = Истина;
			ДоступнаАвтокорректировкаГрафикаПлатежей = ДоступнаАвтокорректировкаГрафикаПлатежей ИЛИ (СтрокаГрафика.СуммаВВалютеДоИзменений < 0);
		КонецЕсли;
	КонецЦикла;
	ДоступнаАвтокорректировкаГрафикаИсполнения = Ложь;
	ЕстьСуммыДоИзмененийВГрафикеИсполнения = Ложь;
	Для Каждого СтрокаГрафика Из Объект.ГрафикИсполнения Цикл
		Если СтрокаГрафика.СуммаВВалютеДоИзменений <> 0 Тогда
			ЕстьСуммыДоИзмененийВГрафикеИсполнения = Истина;
			ДоступнаАвтокорректировкаГрафикаИсполнения = ДоступнаАвтокорректировкаГрафикаИсполнения ИЛИ (СтрокаГрафика.СуммаВВалютеДоИзменений < 0);
		КонецЕсли;
	КонецЦикла;
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ЕстьСуммыДоИзмененийВГрафикеПлатежей",       ЕстьСуммыДоИзмененийВГрафикеПлатежей);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ЕстьСуммыДоИзмененийВГрафикеИсполнения",     ЕстьСуммыДоИзмененийВГрафикеИсполнения);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ДоступнаАвтокорректировкаГрафикаПлатежей",   ДоступнаАвтокорректировкаГрафикаПлатежей);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ДоступнаАвтокорректировкаГрафикаИсполнения", ДоступнаАвтокорректировкаГрафикаИсполнения);
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда		
		ЭтоДолгосрочныйДоговор		= СтруктураРеквизитов.Долгосрочный;
		ЭтоИноеОбязательство		= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство);
		ЭтоСоглашениеОСубсидии		= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии);
		ЭтоСОтправителемТрансферта	= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта);
		ЭтоПредоставленныйЗаем		= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит);
		ЭтоПолученныйКредит			= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит);
		ЭтоСПокупателем				= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
		ЭтоСПоставщиком				= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
		ЭтоВыпускЦенныхБумаг		= (СтруктураРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг);
	Иначе
		Возврат;
	КонецЕсли; 
	
	ЭтоПеререгистрация = Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаПеререгистрациюОбязательства
	                  ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаПеререгистрациюОбязательстваУчетПредмета
					  ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация;
					  
	СтруктураКорректировки 		= ПолучитьСтруктуруКорректировки(Объект.Договор, ?(Объект.Основание.Пустая(), Объект.Ссылка, Объект.Основание));
	ДействующийДокумент 		= ?(СтруктураКорректировки.ДействующийДокумент = Неопределено, Объект.Ссылка, СтруктураКорректировки.ДействующийДокумент);
	ЭтоДействующийДокумент 		= (ДействующийДокумент = Объект.Ссылка);
	ЭтоДокументКорректировка 	= (СтруктураКорректировки.ПервичныйДокумент <> Объект.Ссылка И ЗначениеЗаполнено(СтруктураКорректировки.ПервичныйДокумент));
	
	Если Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоУчетПредмета 
		ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоКонкурсныеПроцедуры Тогда 
		                                                                                                                                  
		ТипПервичные = Элементы.ТипСведений.СписокВыбора.НайтиПоЗначению(Перечисления.ТипыСведенийДоговоров.ПервичныеСведения);
		
		Если ТипПервичные = Неопределено Тогда
			Элементы.ТипСведений.СписокВыбора.Вставить(0, Перечисления.ТипыСведенийДоговоров.ПервичныеСведения, "Первичные сведения");
		КонецЕсли;
		
		ТипИзменение = Элементы.ТипСведений.СписокВыбора.НайтиПоЗначению(Перечисления.ТипыСведенийДоговоров.ИзменениеСведений);
		Если ТипИзменение <> Неопределено Тогда
			Элементы.ТипСведений.СписокВыбора.Удалить(ТипИзменение);
		КонецЕсли;
		
		ТипИсправление = Элементы.ТипСведений.СписокВыбора.НайтиПоЗначению(Перечисления.ТипыСведенийДоговоров.ИсправлениеСведений);
		Если ТипИсправление <> Неопределено Тогда
			Элементы.ТипСведений.СписокВыбора.Удалить(ТипИсправление);
		КонецЕсли;
		
		Объект.ТипСведений = Перечисления.ТипыСведенийДоговоров.ПервичныеСведения;
		
		Если Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоКонкурсныеПроцедуры Тогда
			
			ЗаполнитьДанныеДоИзменений();
			
		КонецЕсли;	
		
	ИначеЕсли Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательстваУчетПредмета
		ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения Тогда 
		
		ТипПервичные = Элементы.ТипСведений.СписокВыбора.НайтиПоЗначению(Перечисления.ТипыСведенийДоговоров.ПервичныеСведения);
		Если ТипПервичные <> Неопределено Тогда
			Элементы.ТипСведений.СписокВыбора.Удалить(ТипПервичные);
		КонецЕсли; 
		Объект.ТипСведений = Перечисления.ТипыСведенийДоговоров.ИзменениеСведений;
		
		ЗаполнитьДанныеДоИзменений();
		
	ИначеЕсли  НЕ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательство Тогда
		
		ЗаполнитьДанныеДоИзменений();
		
	КонецЕсли; 
	
	Если НЕ Параметры.Ключ.Пустая() Тогда
		
		МенеджерЗаписи = РегистрыСведений.СведенияОбОбязательствахЗагруженные.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ДокументРегистрации = Объект.Ссылка;
		МенеджерЗаписи.Организация = Объект.Организация;
		МенеджерЗаписи.Прочитать();
		
		Если МенеджерЗаписи.Выбран() Тогда
			ЗначениеВРеквизитФормы(МенеджерЗаписи, "СведенияОбОбязательствахЗагруженные");
			ИнформацияОЗагрузкеДанных = НСтр("ru = 'Документ сформирован по данным, загруженным из ЕИС в сфере закупок'");
			Элементы.ИнформацияОЗагрузкеДанных.Видимость = Истина;
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВыбранныйПериод(ЗначениеПериода, ОбъектПривязки, СтандартнаяОбработка = Истина)
	
	СтруктураРеквизитов = ПолучитьДанныеПериода(ЗначениеПериода);
	
	Если Год(СтруктураРеквизитов.ДатаОкончания) = Год(Объект.Дата) И СтруктураРеквизитов.Периодичность <> ПредопределенноеЗначение("Перечисление.Периодичность.Месяц") Тогда
		
		ТекстСообщения = НСтр("ru = 'Для первого года обязательства необходимо указать период с точностью до месяца!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, ОбъектПривязки);
		СтандартнаяОбработка = Ложь;
		
	ИначеЕсли Год(СтруктураРеквизитов.ДатаОкончания) <> Год(Объект.Дата) И Не ЭтоДолгосрочныйДоговор Тогда 
		
		ТекстСообщения = НСтр("ru = 'Для данного обязательства допустимо выбирать период в рамках года документа!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, ОбъектПривязки);
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;  		
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеПериода(ПериодПлана)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПериодПлана, "ДатаНачала, ДатаОкончания, Периодичность");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруКорректировки(Договор, Основание)
	
	Возврат РаботаСОбязательствами.ПолучитьПервичныйДействующийДокумент(Договор, Основание);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСвойстваЛицевогоСчета(ЛицевойСчет, Период)
	
	СвойстваСчета = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(ЛицевойСчет, Период);
	
	ПлатежноРасчетныеДокументы.ДополнитьСвойстваЛицевогоСчета(ЛицевойСчет, СвойстваСчета);
			
	Возврат СвойстваСчета;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЛицевойСчетОрганКазначейства(РеквизитыЛС)
	
	Возврат ПлатежноРасчетныеДокументыПовтИсп.ПолучитьЛицевойСчетОрганКазначейства(РеквизитыЛС);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДопустимыеКФООрганизации(Организация, ИФО, НаДату)
	
	СписокКФО = Новый СписокЗначений;
	
	СписокКФО.ЗагрузитьЗначения(БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(Организация, ИФО, НаДату)); 
	
	Возврат СписокКФО;	
	
КонецФункции	

&НаСервере
Процедура ОбработатьВыборСчетаСервер(ВыбранноеЗначение, СтандартнаяОбработка)
    	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.РеквизитыЛицевыхСчетов") Тогда
		
		СтандартнаяОбработка = Ложь;
		Объект.РеквизитыЛицевогоСчета 	= ВыбранноеЗначение;
		СтруктураЛицевогоСчета 			= ПолучитьЛицевойСчетОрганКазначейства(ВыбранноеЗначение);
		Объект.ЛицевойСчет 				= СтруктураЛицевогоСчета.Лицевойсчет;
		Объект.ОрганКазначейства 		= СтруктураЛицевогоСчета.Казначейство;
			
	КонецЕсли; 
	
	ПриИзмененииЛицевогоСчетаСервер();
	
КонецПроцедуры	

