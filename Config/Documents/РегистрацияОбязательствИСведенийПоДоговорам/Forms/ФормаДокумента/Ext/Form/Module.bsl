		КонецЕсли;
	Иначе
		Объект.ГрафикИсполненияПроцентИндексации = 0;
		ГрафикИсполненияПересчитатьСуммыПриИзмененииПроцентаИндексации();
	КонецЕсли;
	
	УстановитьВидимостьЭлементовПересчетаГрафиков(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикИсполненияПроцентИндексацииПриИзменении(Элемент)
	
	ГрафикИсполненияИзменитьСуммыНаПроцент = ЗначениеЗаполнено(Объект.ГрафикИсполненияПроцентИндексации);
	
	ГрафикИсполненияПересчитатьСуммыПриИзмененииПроцентаИндексации();
	
	УстановитьВидимостьЭлементовПересчетаГрафиков(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикИсполненияРаспределитьСуммуПоПериодамПриИзменении(Элемент)
	
	Если ГрафикИсполненияРаспределитьСуммуПоПериодам Тогда
		Если ГрафикИсполненияИзменитьСуммыНаПроцент Тогда
			ГрафикИсполненияИзменитьСуммыНаПроцент = Ложь;
			Объект.ГрафикИсполненияПроцентИндексации = 0;
			ГрафикИсполненияПересчитатьСуммыПриИзмененииПроцентаИндексации();
		КонецЕсли;
	Иначе
		Объект.ГрафикИсполненияСуммаРаспределенная = 0;
		ГрафикИсполненияПересчитатьСуммыПриИзмененииСуммыРаспределенная();
	КонецЕсли;
	
	УстановитьВидимостьЭлементовПересчетаГрафиков(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикИсполненияСуммаРаспределеннаяПриИзменении(Элемент)
	
	ГрафикИсполненияРаспределитьСуммуПоПериодам = ЗначениеЗаполнено(Объект.ГрафикИсполненияСуммаРаспределенная);
	
	ГрафикИсполненияПересчитатьСуммыПриИзмененииСуммыРаспределенная();
	
	УстановитьВидимостьЭлементовПересчетаГрафиков(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикИсполненияОтборПоПериодуПриИзменении(Элемент)
	
	Если ГрафикИсполненияВидОтбораПоПериоду = 0 Тогда // За незавершенные периоды.
		Объект.ГрафикИсполненияНачалоПериодаПересчета = Неопределено;
		Объект.ГрафикИсполненияКонецПериодаПересчета = Неопределено;
	КонецЕсли;
	
	Если ГрафикИсполненияИзменитьСуммыНаПроцент Тогда
		ГрафикИсполненияПересчитатьСуммыПриИзмененииПроцентаИндексации();
	КонецЕсли;
	Если ГрафикИсполненияРаспределитьСуммуПоПериодам Тогда
		ГрафикИсполненияПересчитатьСуммыПриИзмененииСуммыРаспределенная();
	КонецЕсли;
	
	УстановитьВидимостьЭлементовПересчетаГрафиков(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикИсполненияНачалоПериодаПересчетаПриИзменении(Элемент)
	
	Если ГрафикИсполненияИзменитьСуммыНаПроцент Тогда
		ГрафикИсполненияПересчитатьСуммыПриИзмененииПроцентаИндексации();
	КонецЕсли;
	Если ГрафикИсполненияРаспределитьСуммуПоПериодам Тогда
		ГрафикИсполненияПересчитатьСуммыПриИзмененииСуммыРаспределенная();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикИсполненияКонецПериодаПересчетаПриИзменении(Элемент)
	
	Если ГрафикИсполненияИзменитьСуммыНаПроцент Тогда
		ГрафикИсполненияПересчитатьСуммыПриИзмененииПроцентаИндексации();
	КонецЕсли;
	Если ГрафикИсполненияРаспределитьСуммуПоПериодам Тогда
		ГрафикИсполненияПересчитатьСуммыПриИзмененииСуммыРаспределенная();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикИсполненияУстановитьОтборПоПериоду(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период.ДатаНачала = Объект.ГрафикИсполненияНачалоПериодаПересчета;
	Диалог.Период.ДатаОкончания = Объект.ГрафикИсполненияКонецПериодаПересчета;
	Диалог.Показать(Новый ОписаниеОповещения("ГрафикИсполненияУстановитьОтборПоПериодуЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикИсполненияУстановитьОтборПоПериодуЗавершение(Период, ДополнительныеПараметры) Экспорт
	
	Если Период <> Неопределено Тогда
		
		Объект.ГрафикИсполненияНачалоПериодаПересчета = Период.ДатаНачала;
		Объект.ГрафикИсполненияКонецПериодаПересчета  = Период.ДатаОкончания;
		
		Модифицированность = Истина;
		
		Если ГрафикИсполненияИзменитьСуммыНаПроцент Тогда
			ГрафикИсполненияПересчитатьСуммыПриИзмененииПроцентаИндексации();
		КонецЕсли;
		Если ГрафикИсполненияРаспределитьСуммуПоПериодам Тогда
			ГрафикИсполненияПересчитатьСуммыПриИзмененииСуммыРаспределенная();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

