&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВалютаРегламентированногоУчета 			= Константы.ВалютаРегламентированногоУчета.Получить();
	СтруктураКурса 							= РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаРегламентированногоУчета, Объект.Дата);
	КурсВалютыРегламентированногоУчета 		= СтруктураКурса.Курс;
	КратностьВалютыРегламентированногоУчета = СтруктураКурса.Кратность;	
	
	Если Объект.Сумма = Объект.РасшифровкаОбязательстваБюджет.Итог("Сумма") + Объект.РасшифровкаОбязательстваВнебюджет.Итог("Сумма")
		И Объект.СуммаВВалюте = Объект.РасшифровкаОбязательстваБюджет.Итог("СуммаВВалюте") + Объект.РасшифровкаОбязательстваВнебюджет.Итог("СуммаВВалюте")
		Тогда
		СуммаПоДоговоруЗаполняетсяАвтоматически = Истина;
	Иначе
		СуммаПоДоговоруЗаполняетсяАвтоматически = Ложь;
	КонецЕсли;
	
	// Пересчет (увеличение, уменьшение) графиков по договору.
	ГрафикПлатежейИзменитьСуммыНаПроцент = ЗначениеЗаполнено(Объект.ГрафикПлатежейПроцентИндексации);
	ГрафикПлатежейРаспределитьСуммуПоПериодам = ЗначениеЗаполнено(Объект.ГрафикПлатежейСуммаРаспределенная);
	ГрафикПлатежейВидОтбораПоПериоду = ЗначениеЗаполнено(Объект.ГрафикПлатежейНачалоПериодаПересчета) ИЛИ ЗначениеЗаполнено(Объект.ГрафикПлатежейКонецПериодаПересчета);
	ГрафикИсполненияИзменитьСуммыНаПроцент = ЗначениеЗаполнено(Объект.ГрафикИсполненияПроцентИндексации);
	ГрафикИсполненияРаспределитьСуммуПоПериодам = ЗначениеЗаполнено(Объект.ГрафикИсполненияСуммаРаспределенная);
	ГрафикИсполненияВидОтбораПоПериоду = ЗначениеЗаполнено(Объект.ГрафикИсполненияНачалоПериодаПересчета) ИЛИ ЗначениеЗаполнено(Объект.ГрафикИсполненияКонецПериодаПересчета);
	
	ОпределитьПараметрыРедакцииДокумента();
	
	СвойстваЛицевогоСчета = ПолучитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет, Объект.Дата);
	Элементы.ОрганКазначейства.СписокВыбора.ЗагрузитьЗначения(СвойстваЛицевогоСчета.КазначействаЛС);
	Элементы.ОрганКазначействаУФК.СписокВыбора.ЗагрузитьЗначения(СвойстваЛицевогоСчета.КазначействаЛС);
	
	ДопустимыекКФООрганизации = ПолучитьДопустимыеКФООрганизации(Объект.Организация, Объект.ИФО, Объект.Дата);
	ЭтоБюджетополучатель = НЕ ДопустимыекКФООрганизации.НайтиПоЗначению(ПредопределенноеЗначение("Перечисление.КВД.Бюджет")) = Неопределено;	
	УчетПоПодразделениям = БухгалтерскийУчет.ВедетсяУчетПоПодразделениям(БухгалтерскийУчет.СписокСчетов("501.00, 502.00, 506.00", Объект.Дата));
	
	УстановитьВидимостьРеквизитов();
	УстановитьПараметрыФормы(); 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоТаблицеБюджетныхСредствНаСервере()
	
	ТаблицаБюджет = Объект.РасшифровкаОбязательстваБюджет.Выгрузить(, "ОбъектФАИП,РазделЛицевогоСчета,КПС,КодЦели,СуммаВВалюте,
	|СуммаВВалютеБезусловная,СуммаИсполнено,СуммаИсполненоБезусловно,СуммаНеИсполнено,СуммаНеИсполненоБезусловно");
	
	ТаблицаБюджет.Свернуть("ОбъектФАИП,РазделЛицевогоСчета,КПС,КодЦели", "СуммаВВалюте,СуммаВВалютеБезусловная,СуммаИсполнено,СуммаИсполненоБезусловно,СуммаНеИсполнено,СуммаНеИсполненоБезусловно");
	
	ТаблицаПримечание = Объект.ПримечаниеБюджет;
	
	Для Каждого Стр Из ТаблицаБюджет Цикл 
		
		ПараметрыОтбора = Новый Структура("ОбъектФАИП,РазделЛицевогоСчета,КПС,КодЦели,Условное",
		Стр.ОбъектФАИП, Стр.РазделЛицевогоСчета, Стр.КПС, Стр.КодЦели, Истина);
		
		Если Стр.СуммаВВалюте - Стр.СуммаВВалютеБезусловная <> 0
			ИЛИ Стр.СуммаИсполнено - Стр.СуммаИсполненоБезусловно <> 0
			ИЛИ Стр.СуммаНеИсполнено - Стр.СуммаНеИсполненоБезусловно <> 0 Тогда
			// Условное  
			ПараметрыОтбора.Условное = Истина;
			Если ТаблицаПримечание.НайтиСтроки(ПараметрыОтбора).Количество() = 0 Тогда 
				НовСтрПрим = ТаблицаПримечание.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрПрим, ПараметрыОтбора);
			КонецЕсли;	
		КонецЕсли;   
		
		Если Стр.СуммаВВалютеБезусловная <> 0
			ИЛИ Стр.СуммаИсполненоБезусловно <> 0
			ИЛИ Стр.СуммаНеИсполненоБезусловно <> 0 Тогда
			ПараметрыОтбора.Условное = Ложь;
			Если ТаблицаПримечание.НайтиСтроки(ПараметрыОтбора).Количество() = 0 Тогда 
				НовСтрПрим = ТаблицаПримечание.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрПрим, ПараметрыОтбора);
			КонецЕсли;	
		КонецЕсли;   	
	КонецЦикла;	
	
	МассивКУдалению = Новый Массив;
	Для Каждого Стр Из Объект.ПримечаниеБюджет Цикл 
		ПараметрыОтбора = Новый Структура("ОбъектФАИП,РазделЛицевогоСчета,КПС,КодЦели",
		Стр.ОбъектФАИП, Стр.РазделЛицевогоСчета, Стр.КПС, Стр.КодЦели);
	    Если ТаблицаБюджет.НайтиСтроки(ПараметрыОтбора).Количество() = 0 Тогда 
        	МассивКУдалению.Добавить(Стр);	
		КонецЕсли;
	КонецЦикла;	 
	Для Каждого Стр Из МассивКУдалению Цикл
		ТаблицаПримечание.Удалить(Стр);
	КонецЦикла;	
	
	ТаблицаПримечание.Сортировать("ОбъектФАИП,РазделЛицевогоСчета,КПС,КодЦели,Условное");
	
КонецПроцедуры	

&НаКлиенте
Процедура РассчитатьСуммуАвтоматически()
	
	Объект.Сумма 		= Объект.РасшифровкаОбязательстваБюджет.Итог("Сумма") + Объект.РасшифровкаОбязательстваВнебюджет.Итог("Сумма");
	Объект.СуммаВВалюте = Объект.РасшифровкаОбязательстваБюджет.Итог("СуммаВВалюте") + Объект.РасшифровкаОбязательстваВнебюджет.Итог("СуммаВВалюте");
	
	Если Объект.СуммаАванса > Объект.Сумма Тогда
		Объект.СуммаАванса = Объект.Сумма;
	КонецЕсли;
	
	НовыйПроцент = ?(Объект.Сумма = 0, 0, Объект.СуммаАванса/Объект.Сумма*100);               
	Если Объект.АвансПроцентом > НовыйПроцент Тогда
		Объект.АвансПроцентом = НовыйПроцент;
	КонецЕсли;
	
КонецПроцедуры

// КонтрольИсполненияДоговоров
&НаСервере
Процедура СформироватьГрафикиПоДоговоруНаСервере(ПараметрыГрафиков)
	
	// График платежей.
	Если ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей Тогда
		Документы.РегистрацияГрафиковИсполненияДоговоров.ЗаполнитьГрафикПлатежейПоПараметрам(Объект,
			ПараметрыГрафиков, ЭтотОбъект.КэшПараметров.Локальные.ДопустимыеСчетаПоВидуДоговора);
	КонецЕсли;
	
	// График исполнения.
	Если ЭтотОбъект.КэшПараметров.Локальные.ВестиПланГрафикИсполнения Тогда
		Документы.РегистрацияГрафиковИсполненияДоговоров.ЗаполнитьГрафикИсполненияПоПараметрам(Объект,
			ПараметрыГрафиков, ЭтотОбъект.КэшПараметров.Локальные.ДопустимыеСчетаПоВидуДоговора);
	КонецЕсли;
	
	// Автоматическое заполнение срока исполнения.
	Если Не ЗначениеЗаполнено(Объект.СрокИсполнения) Тогда
		Объект.СрокИсполнения = МаксимальныйСрокИсполненияПоГрафикам(Объект.ГрафикПлатежей, Объект.ГрафикИсполнения, ЭтотОбъект.КэшПараметров.Локальные);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГрафикПлатежейПоДоговоруНаСервере()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	КонтрольИсполненияДоговоров.ЗаполнитьГрафикиИсполненияПоДоговору(ДокументОбъект, ДокументОбъект.Договор, Неопределено, "ГрафикПлатежей");
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ОпределитьПараметрыРедакцииДокумента();
	УстановитьВидимостьРеквизитов();
	УстановитьПараметрыФормы();
	
КонецПроцедуры

Процедура ЗаполнитьГрафикИсполненияПоДоговоруНаСервере()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	КонтрольИсполненияДоговоров.ЗаполнитьГрафикиИсполненияПоДоговору(ДокументОбъект, ДокументОбъект.Договор, Неопределено, "ПланГрафикИсполнения");
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ОпределитьПараметрыРедакцииДокумента();
	УстановитьВидимостьРеквизитов();
	УстановитьПараметрыФормы();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГрафикПлатежейНаСервере()
	
	ЗаполнитьСуммуИзмененияОбязательств = ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеПлатежей;
	СуффиксИмениПоказателя = ?(ЗаполнитьСуммуИзмененияОбязательств, "Изменения", "");
	
	ОчиститьИзмененияГрафика(Объект.ГрафикПлатежей, ЗаполнитьСуммуИзмененияОбязательств);
	
	ПериодыПлана = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПериодыПлана,
		Объект.РасшифровкаОбязательстваБюджет.Выгрузить(,"ПериодПлана").ВыгрузитьКолонку("ПериодПлана"), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПериодыПлана,
		Объект.РасшифровкаОбязательстваВнебюджет.Выгрузить(,"ПериодПлана").ВыгрузитьКолонку("ПериодПлана"), Истина);
	РеквизитыПериодов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ПериодыПлана, "ДатаНачала,ДатаОкончания");
	
	// Временная таблица с суммами изменений графика платежей.
	ГрафикПлатежейИзменения = Объект.ГрафикПлатежей.Выгрузить(, "КФО,КПС,КЭК,КодЦели,КодМероприятия,ДопКлассификация,СчетРасчетов,ВидРасчетов,ОплатитьДо");
	ГрафикПлатежейИзменения.Колонки.Добавить("СуммаВВалюте", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 2));
	ГрафикПлатежейИзменения.Очистить();
	
	ТабЧастиОбязательств = Новый Массив;
	ТабЧастиОбязательств.Добавить("РасшифровкаОбязательстваБюджет");
	ТабЧастиОбязательств.Добавить("РасшифровкаОбязательстваВнебюджет");
	
	Для Каждого ТабЧасть Из ТабЧастиОбязательств Цикл
	
		Для Каждого СтрокаОбязательств Из Объект[ТабЧасть] Цикл
			
			СуммаВВалютеБезусловная = СтрокаОбязательств["СуммаВВалютеБезусловная" + СуффиксИмениПоказателя];
			СуммаВВалюте = СтрокаОбязательств["СуммаВВалюте" + СуффиксИмениПоказателя];
			
			Если СуммаВВалютеБезусловная <> 0 Тогда // Аванс.
				
				НоваяСтрока = ГрафикПлатежейИзменения.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОбязательств,
					"КФО,КПС,КЭК,КодЦели,КодМероприятия,ДопКлассификация");
				
				НоваяСтрока.СуммаВВалюте = СуммаВВалютеБезусловная;
				
				НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
					НоваяСтрока.КЭК, "302.00",, Объект.Дата, Объект.Организация, Объект.ИФО);
				
				// Дата оплаты по умолчанию - конец выбранного периода.
				НоваяСтрока.ОплатитьДо  = РеквизитыПериодов[СтрокаОбязательств.ПериодПлана].ДатаНачала;
				НоваяСтрока.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
				
			КонецЕсли;
			
			Если СуммаВВалюте - СуммаВВалютеБезусловная <> 0 Тогда // Оплата.
				
				НоваяСтрока = ГрафикПлатежейИзменения.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОбязательств,
					"КФО,КПС,КЭК,КодЦели,КодМероприятия,ДопКлассификация");
				
				НоваяСтрока.СуммаВВалюте = СуммаВВалюте - СуммаВВалютеБезусловная;
				
				НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
					НоваяСтрока.КЭК, "302.00",, Объект.Дата, Объект.Организация, Объект.ИФО);
				
				// Дата оплаты по умолчанию - конец выбранного периода.
				НоваяСтрока.ОплатитьДо  = РеквизитыПериодов[СтрокаОбязательств.ПериодПлана].ДатаОкончания;
				НоваяСтрока.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ИспользоватьДетализациюПоКОСГУ = КонтрольИсполненияДоговоров.ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам(
		ЭтотОбъект.КэшПараметров.Локальные.ВидДоговора);
	ИспользоватьДополнительнуюАналитику = КонтрольИсполненияДоговоров.ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей(
		ЭтотОбъект.КэшПараметров.Локальные.ВидДоговора);
	
	Для Каждого СтрокаГрафика Из ГрафикПлатежейИзменения Цикл
		
		НайденнаяСтрока = Неопределено;
		Если ЗаполнитьСуммуИзмененияОбязательств Тогда // Возможно, в документе уже есть строка с такой аналитикой.
			Отбор = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаГрафика);
			Отбор.Удалить("СуммаВВалюте");
			Если Не ИспользоватьДетализациюПоКОСГУ Тогда
				Отбор.Удалить("КЭК");
			КонецЕсли;
			Если Не ИспользоватьДополнительнуюАналитику Тогда
				Отбор.Удалить("ДопКлассификация");
				Отбор.Удалить("КодМероприятия");
				Отбор.Удалить("КодЦели");
			КонецЕсли;
			НайденныеСтроки = Объект.ГрафикПлатежей.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденнаяСтрока = НайденныеСтроки[0];
			КонецЕсли;
		КонецЕсли;
		
		Если НайденнаяСтрока = Неопределено Тогда // Добавляем новую строку.
			НоваяСтрока = Объект.ГрафикПлатежей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика);
			НоваяСтрока.СуммаВВалютеПослеИзменений =
				НоваяСтрока.СуммаВВалютеДоИзменений + НоваяСтрока.СуммаВВалюте;
		Иначе // Пересчитываем существующую строку.
			НайденнаяСтрока.СуммаВВалюте = НайденнаяСтрока.СуммаВВалюте + СтрокаГрафика.СуммаВВалюте;
			НайденнаяСтрока.СуммаВВалютеПослеИзменений =
				НайденнаяСтрока.СуммаВВалютеДоИзменений + НайденнаяСтрока.СуммаВВалюте;
		КонецЕсли;
		
	КонецЦикла;
	
	Объект.ГрафикПлатежей.Сортировать("ОплатитьДо,СуммаВВалютеДоИзменений УБЫВ,ВидРасчетов,СчетРасчетов");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГрафикИсполненияНаСервере()
	
	ЗаполнитьСуммуИзмененияОбязательств = ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеИсполнения;
	СуффиксИмениПоказателя = ?(ЗаполнитьСуммуИзмененияОбязательств, "Изменения", "");
	
	ОчиститьИзмененияГрафика(Объект.ГрафикИсполнения, ЗаполнитьСуммуИзмененияОбязательств);
	
	ПериодыПлана = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПериодыПлана,
		Объект.РасшифровкаОбязательстваБюджет.Выгрузить(,"ПериодПлана").ВыгрузитьКолонку("ПериодПлана"), Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПериодыПлана,
		Объект.РасшифровкаОбязательстваВнебюджет.Выгрузить(,"ПериодПлана").ВыгрузитьКолонку("ПериодПлана"), Истина);
	РеквизитыПериодов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ПериодыПлана, "ДатаНачала,ДатаОкончания");
	
	// Временная таблица с суммами изменений плана-графика закупок, реализации.
	ГрафикИсполненияИзменения = Объект.ГрафикИсполнения.Выгрузить(, "КФО,КПС,КЭК,СчетРасчетов,ИсполнитьДо");
	ГрафикИсполненияИзменения.Колонки.Добавить("СуммаВВалюте", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 2));
	ГрафикИсполненияИзменения.Очистить();
	
	ТабЧастиОбязательств = Новый Массив;
	ТабЧастиОбязательств.Добавить("РасшифровкаОбязательстваБюджет");
	ТабЧастиОбязательств.Добавить("РасшифровкаОбязательстваВнебюджет");
	
	Для Каждого ТабЧасть Из ТабЧастиОбязательств Цикл
	
		Для Каждого СтрокаОбязательств Из Объект[ТабЧасть] Цикл
			
			СуммаВВалюте = СтрокаОбязательств["СуммаВВалюте" + СуффиксИмениПоказателя];
			
			Если СуммаВВалюте <> 0 Тогда
				
				НоваяСтрока = ГрафикИсполненияИзменения.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОбязательств,
					"КФО,КПС,КЭК");
				
				НоваяСтрока.СуммаВВалюте = СуммаВВалюте;
				
				НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
					НоваяСтрока.КЭК, "302.00",, Объект.Дата, Объект.Организация, Объект.ИФО);
				
				// Дата исполнения по умолчанию - конец выбранного периода.
				НоваяСтрока.ИсполнитьДо = РеквизитыПериодов[СтрокаОбязательств.ПериодПлана].ДатаОкончания;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ИспользоватьДетализациюПоКОСГУ = КонтрольИсполненияДоговоров.ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам(
		ЭтотОбъект.КэшПараметров.Локальные.ВидДоговора);
	
	Для Каждого СтрокаГрафика Из ГрафикИсполненияИзменения Цикл
		
		НайденнаяСтрока = Неопределено;
		Если ЗаполнитьСуммуИзмененияОбязательств Тогда // Возможно, в документе уже есть строка с такой аналитикой.
			Отбор = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаГрафика);
			Отбор.Удалить("СуммаВВалюте");
			Если Не ИспользоватьДетализациюПоКОСГУ Тогда
				Отбор.Удалить("КЭК");
			КонецЕсли;
			НайденныеСтроки = Объект.ГрафикИсполнения.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденнаяСтрока = НайденныеСтроки[0];
			КонецЕсли;
		КонецЕсли;
		
		Если НайденнаяСтрока = Неопределено Тогда // Добавляем новую строку.
			НоваяСтрока = Объект.ГрафикИсполнения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика);
			НоваяСтрока.СуммаВВалютеПослеИзменений =
				НоваяСтрока.СуммаВВалютеДоИзменений + НоваяСтрока.СуммаВВалюте;
		Иначе // Пересчитываем существующую строку.
			НайденнаяСтрока.СуммаВВалюте = НайденнаяСтрока.СуммаВВалюте + СтрокаГрафика.СуммаВВалюте;
			НайденнаяСтрока.СуммаВВалютеПослеИзменений =
				НайденнаяСтрока.СуммаВВалютеДоИзменений + НайденнаяСтрока.СуммаВВалюте;
		КонецЕсли;
		
	КонецЦикла;
	
	Объект.ГрафикИсполнения.Сортировать("ИсполнитьДо,СуммаВВалютеДоИзменений УБЫВ,СчетРасчетов");
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьИзмененияВГрафике(ИмяТаблицы)
	
	Для Каждого СтрокаГрафика Из Объект[ИмяТаблицы] Цикл
		Если СтрокаГрафика.СуммаВВалюте <> 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ОчиститьИзмененияГрафика(ТабличнаяЧастьГрафик, ТолькоСуммыИзменений)
	
	Если ТолькоСуммыИзменений Тогда // Очищаем суммы изменений.
		
		СтрокиКУдалению = Новый Массив;
		Для Каждого СтрокаГрафика Из ТабличнаяЧастьГрафик Цикл
			Если СтрокаГрафика.ЗапретИзменения Тогда
				СтрокаГрафика.СуммаВВалюте = 0;
				СтрокаГрафика.СуммаВВалютеПослеИзменений =
					СтрокаГрафика.СуммаВВалютеДоИзменений + СтрокаГрафика.СуммаВВалюте;
			Иначе
				СтрокиКУдалению.Добавить(СтрокаГрафика);
			КонецЕсли;
		КонецЦикла;
		Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			ТабличнаяЧастьГрафик.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
	Иначе // Очищаем весь график.
		ТабличнаяЧастьГрафик.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СкорректироватьГрафикАвтоматическиНаСервере(ИмяТаблицы)
	
	ОчиститьИзмененияГрафика(Объект[ИмяТаблицы], Истина);
	
	КонтрольИсполненияДоговоров.СкорректироватьГрафикАвтоматически(Объект, ИмяТаблицы, ЭтотОбъект.КэшПараметров.Локальные.ВидДоговора);
	
	ИтогоИзменениеСуммаВВалюте = Объект[ИмяТаблицы].Итог("СуммаВВалюте");
	Если ИтогоИзменениеСуммаВВалюте <> 0 Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось распределить сумму %1 по датам %2 автоматически!'"),
			ОбщегоНазначенияБГУ.ФорматСумм(ИтогоИзменениеСуммаВВалюте),
			?(ИмяТаблицы = "ГрафикПлатежей", НСтр("ru = 'оплаты'"), НСтр("ru = 'исполнения'")));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект");
		ОчиститьИзмененияГрафика(Объект[ИмяТаблицы], Истина);
	КонецЕсли;
	
	УстановитьВидимостьГрафиковИсполнения();
	
КонецПроцедуры

&НаСервере
Процедура ГрафикПлатежейПересчитатьСуммыПриИзмененииПроцентаИндексации()
	
	Документы.РегистрацияОбязательствИСведенийПоДоговорам.ИзменитьСуммыНаПроцент(Объект, "ГрафикПлатежей");
	
КонецПроцедуры

&НаСервере
Процедура ГрафикПлатежейПересчитатьСуммыПриИзмененииСуммыРаспределенная()
	
	Документы.РегистрацияОбязательствИСведенийПоДоговорам.РаспределитьСуммуПоПериодам(Объект, "ГрафикПлатежей");
	
КонецПроцедуры

&НаСервере
Процедура ГрафикИсполненияПересчитатьСуммыПриИзмененииПроцентаИндексации()
	
	Документы.РегистрацияОбязательствИСведенийПоДоговорам.ИзменитьСуммыНаПроцент(Объект, "ГрафикИсполнения");
	
КонецПроцедуры

&НаСервере
Процедура ГрафикИсполненияПересчитатьСуммыПриИзмененииСуммыРаспределенная()
	
	Документы.РегистрацияОбязательствИСведенийПоДоговорам.РаспределитьСуммуПоПериодам(Объект, "ГрафикИсполнения");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьГрафиковИсполнения()
	
	Если ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров И ЗначениеЗаполнено(Объект.Договор) Тогда
		ВестиГрафикПлатежей = ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей;
		ВестиПланГрафикИсполнения  = ЭтотОбъект.КэшПараметров.Локальные.ВестиПланГрафикИсполнения;
		ВидДоговора = ЭтотОбъект.КэшПараметров.Локальные.ВидДоговора;
	Иначе
		ВестиГрафикПлатежей = Ложь;
		ВестиПланГрафикИсполнения  = Ложь;
		ВидДоговора = Неопределено;
	КонецЕсли;
	
	ЭтоПринимаемоеОбязательство = (Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательство)
		ИЛИ (Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения)
		ИЛИ (Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация)
		ИЛИ (Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ОтказОтДоговораКонкурсныеПроцедуры);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаГрафикПлатежей", "Видимость",
		ВестиГрафикПлатежей И НЕ ЭтоПринимаемоеОбязательство ИЛИ Объект.ГрафикПлатежей.Количество() > 0);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаГрафикЗакупок", "Видимость",
		ВестиПланГрафикИсполнения И НЕ ЭтоПринимаемоеОбязательство ИЛИ Объект.ГрафикИсполнения.Количество() > 0);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикПлатежейСкорректироватьГрафикПлатежейАвтоматически", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ДоступнаАвтокорректировкаГрафикаПлатежей);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикИсполненияСкорректироватьГрафикИсполненияАвтоматически", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ДоступнаАвтокорректировкаГрафикаИсполнения);
	
	Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"СтраницаГрафикЗакупок", "Заголовок", НСтр("ru = 'План-график реализации'"));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДоговорВестиПланГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график реализации'"));
		Элементы.ГрафикИсполнения.РасширеннаяПодсказка.Заголовок =
			НСтр("ru = 'Введите актуальный план-график реализации. Если полный график реализации на данный момент неизвестен, можно ввести данные об известных очередных отгрузках, либо ввести сводные данные об ожидаемых отгрузках (по месяцам, кварталам и т.п.). План-график реализации можно уточнять в течение срока действия договора. Проценты, пени, штрафы планируются только в графике платежей.'");
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"СтраницаГрафикЗакупок", "Заголовок", НСтр("ru = 'План-график закупок'"));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДоговорВестиПланГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график закупок'"));
		Элементы.ГрафикИсполнения.РасширеннаяПодсказка.Заголовок =
			НСтр("ru = 'Введите актуальный план-график закупок. Если полный график закупок на данный момент неизвестен, можно ввести данные об известных очередных поставках, либо ввести сводные данные об ожидаемых закупках (по месяцам, кварталам и т.п.). График закупок можно уточнять в течение срока действия договора. Проценты, пени, штрафы планируются только в графике платежей.'");
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"СтраницаГрафикЗакупок", "Заголовок", НСтр("ru = 'План-график исполнения'"));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДоговорВестиПланГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график исполнения'"));
		Элементы.ГрафикИсполнения.РасширеннаяПодсказка.Заголовок =
			НСтр("ru = 'Введите актуальный график исполнения договора (реализации, закупок). График исполнения можно уточнять в течение срока действия договора. Проценты, пени, штрафы планируются только в графике платежей.'");
	КонецЕсли;
	
	ВидимостьКонструктораГрафиков = (ВестиГрафикПлатежей ИЛИ ВестиПланГрафикИсполнения)
		И НЕ ЭтоПринимаемоеОбязательство
		И НЕ ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеПлатежей
		И НЕ ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеИсполнения;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КонструкторГрафиковИсполненияДоговоров", "Видимость", ВидимостьКонструктораГрафиков);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КонструкторГрафиковИсполненияДоговоров", "Доступность", ВидимостьКонструктораГрафиков И Не ТолькоПросмотр);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаполнитьСрокИсполненияПоГрафикам", "Видимость",
		(ВестиГрафикПлатежей ИЛИ ВестиПланГрафикИсполнения) И НЕ ЭтоПринимаемоеОбязательство);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДоговорВестиГрафикПлатежей", "Видимость",
		ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДоговорВестиПланГрафикИсполнения", "Видимость",
		ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии);
	
	ЭлементыДоПослеИзменений = Новый Массив;
	ЭлементыДоПослеИзменений.Добавить("ГрафикПлатежейСуммаВВалютеДоИзменений");
	ЭлементыДоПослеИзменений.Добавить("ГрафикПлатежейСуммаВВалютеПослеИзменений");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыДоПослеИзменений, "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеПлатежей);
	
	ЭлементыДоПослеИзменений = Новый Массив;
	ЭлементыДоПослеИзменений.Добавить("ГрафикИсполненияСуммаВВалютеДоИзменений");
	ЭлементыДоПослеИзменений.Добавить("ГрафикИсполненияСуммаВВалютеПослеИзменений");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыДоПослеИзменений, "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеИсполнения);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикПлатежейСуммаВВалюте", "Заголовок",
			?(ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеПлатежей, НСтр("ru = 'Изменение'"), НСтр("ru = 'Сумма'")));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикИсполненияСуммаВВалюте", "Заголовок",
			?(ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеИсполнения, НСтр("ru = 'Изменение'"), НСтр("ru = 'Сумма'")));
	
	ИспользоватьДетализациюПоКОСГУВГрафиках = КонтрольИсполненияДоговоров.ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам(ВидДоговора);
	ЭлементыДопАналитика = Новый Массив;
	ЭлементыДопАналитика.Добавить("ГрафикПлатежейКЭК");
	ЭлементыДопАналитика.Добавить("ГрафикИсполненияКЭК");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыДопАналитика, "Видимость", ИспользоватьДетализациюПоКОСГУВГрафиках);
	
	ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей = КонтрольИсполненияДоговоров.ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей(ВидДоговора);
	ЭлементыДопАналитика = Новый Массив;
	ЭлементыДопАналитика.Добавить("ГрафикПлатежейДопКлассификация");
	ЭлементыДопАналитика.Добавить("ГрафикПлатежейКодМероприятия");
	ЭлементыДопАналитика.Добавить("ГрафикПлатежейКодЦели");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыДопАналитика, "Видимость", ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей);
	
	УстановитьВидимостьЭлементовПересчетаГрафиков(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовПересчетаГрафиков(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	// Механизм пересчета графиков доступен только в документах корреткировки графиков по договору.
	// Для первичного создания графиков применяется "Конструктор графиков".
	Если Форма.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров И ЗначениеЗаполнено(Объект.Договор) Тогда
		ВестиГрафикПлатежей = Форма.КэшПараметров.Локальные.ВестиГрафикПлатежей;
		ВестиПланГрафикИсполнения  = Форма.КэшПараметров.Локальные.ВестиПланГрафикИсполнения;
	Иначе
		ВестиГрафикПлатежей = Ложь;
		ВестиПланГрафикИсполнения  = Ложь;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПересчетГрафикПлатежей", "Видимость",
		ВестиГрафикПлатежей И Форма.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеПлатежей);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПересчетГрафикИсполнения", "Видимость",
		ВестиПланГрафикИсполнения И Форма.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеИсполнения);
	
	// График платежей.
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикПлатежейПроцентИндексации", "Доступность", Форма.ГрафикПлатежейИзменитьСуммыНаПроцент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикПлатежейСуммаРаспределенная", "Доступность", Форма.ГрафикПлатежейРаспределитьСуммуПоПериодам);
	
	ЭлементыОтборПоПериоду = Новый Массив;
	ЭлементыОтборПоПериоду.Добавить("ГрафикПлатежейНачалоПериодаПересчета");
	ЭлементыОтборПоПериоду.Добавить("ГрафикПлатежейКонецПериодаПересчета");
	ЭлементыОтборПоПериоду.Добавить("ГрафикПлатежейУстановитьОтборПоПериоду");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыОтборПоПериоду, "Доступность", Форма.ГрафикПлатежейВидОтбораПоПериоду <> 0);
	
	// План-график реализации, закупок, исполнения.
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикИсполненияПроцентИндексации", "Доступность", Форма.ГрафикИсполненияИзменитьСуммыНаПроцент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикИсполненияСуммаРаспределенная", "Доступность", Форма.ГрафикИсполненияРаспределитьСуммуПоПериодам);
	
	ЭлементыОтборПоПериоду = Новый Массив;
	ЭлементыОтборПоПериоду.Добавить("ГрафикИсполненияНачалоПериодаПересчета");
	ЭлементыОтборПоПериоду.Добавить("ГрафикИсполненияКонецПериодаПересчета");
	ЭлементыОтборПоПериоду.Добавить("ГрафикИсполненияУстановитьОтборПоПериоду");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыОтборПоПериоду, "Доступность", Форма.ГрафикИсполненияВидОтбораПоПериоду <> 0);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция МаксимальныйСрокИсполненияПоГрафикам(ГрафикПлатежей, ГрафикИсполнения, Параметры)
	
	МаксСрокИсполнения = Дата(1,1,1);
	Если Параметры.ВестиГрафикПлатежей Тогда
		Для Каждого СтрокаГрафика Из ГрафикПлатежей Цикл
			Если СтрокаГрафика.ОплатитьДо > МаксСрокИсполнения Тогда
				МаксСрокИсполнения = СтрокаГрафика.ОплатитьДо;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Параметры.ВестиПланГрафикИсполнения Тогда
		Для Каждого СтрокаГрафика Из ГрафикИсполнения Цикл
			Если СтрокаГрафика.ИсполнитьДо > МаксСрокИсполнения Тогда
				МаксСрокИсполнения = СтрокаГрафика.ИсполнитьДо;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат МаксСрокИсполнения;
	
КонецФункции
// Конец КонтрольИсполненияДоговоров

