&НаКлиенте
Процедура ЗаполнитьПоГосКонтрактуИзЕИС(Команда)
	ПараметрыФормы = Новый Структура("Организация, ЛицевойСчет, Контрагент, Договор, ВалютаДокумента,
		|ЭтоБюджетополучатель, ЕстьПодразделение, ДатаДокумента, ИФО");

	ПараметрыФормы.Организация = Объект.Организация;
	ПараметрыФормы.ИФО = Объект.ИФО;
	ПараметрыФормы.ДатаДокумента = Объект.Дата;
	ПараметрыФормы.ЛицевойСчет = Объект.ЛицевойСчет;
	ПараметрыФормы.Контрагент = Объект.Контрагент;
	ПараметрыФормы.Договор = Объект.Договор;
	ПараметрыФормы.ВалютаДокумента = Объект.ВалютаДокумента;
	ПараметрыФормы.ЭтоБюджетополучатель = ЭтоБюджетополучатель;
	Если ЭтоБюджетополучатель Тогда
		ЕстьПодразделение = Элементы.РасшифровкаОбязательстваБюджетПодразделение.Видимость;
	Иначе
		ЕстьПодразделение = Элементы.РасшифровкаОбязательстваВнебюджетПодразделение.Видимость;
	КонецЕсли;	
	
	ПараметрыФормы.ЕстьПодразделение = ЕстьПодразделение;
	
	ОткрытьФорму("ОбщаяФорма.ФормаОбъектыЗакупкиПоГосКонтрактуИзЕИС", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодДействия(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период.ДатаНачала = Объект.НачалоДействия;
	Диалог.Период.ДатаОкончания = Объект.ОкончаниеДействия;
	Диалог.Показать(Новый ОписаниеОповещения("УстановитьПериодДействияЗавершение", ЭтотОбъект));
	
КонецПроцедуры

