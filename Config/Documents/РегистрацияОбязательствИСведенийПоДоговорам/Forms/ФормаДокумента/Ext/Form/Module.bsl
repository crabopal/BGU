	Если Копирование Тогда
		ТекущаяСтрока = Элементы.РасшифровкаОбязательстваБюджет.ТекущиеДанные;
		
		ТекущаяСтрока.ЗапретИзменения = Ложь;
		
		ТекущаяСтрока.КоличествоДоИзменений = 0;
		ТекущаяСтрока.СуммаДоИзменений = 0;
		ТекущаяСтрока.СуммаВВалютеДоИзменений = 0;
		
		ТекущаяСтрока.КоличествоИзменения = ТекущаяСтрока.Количество;
		ТекущаяСтрока.СуммаИзменения = ТекущаяСтрока.Сумма;
		ТекущаяСтрока.СуммаВВалютеИзменения = ТекущаяСтрока.СуммаВВалюте;
		
		ОбновитьИтоги();
	КонецЕсли; 
	
