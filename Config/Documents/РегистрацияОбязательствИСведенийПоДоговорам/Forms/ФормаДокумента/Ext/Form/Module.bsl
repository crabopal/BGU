Процедура ЗаполнитьГрафикПлатежейПоДоговору(Команда)
	
	ТекстВопроса = "";
	Если ЕстьИзмененияВГрафике("ГрафикПлатежей") Тогда
		Если ЭтотОбъект.КэшПараметров.Локальные.ЕстьСуммыДоИзмененийВГрафикеПлатежей Тогда
			ТекстВопроса = НСтр("ru = 'Изменения графика платежей будут очищены. Продолжить?'");
		Иначе
			ТекстВопроса = НСтр("ru = 'Данные на закладке ""График платежей"" будут очищены. Продолжить?'");
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьГрафикПлатежейПоДоговоруЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьГрафикПлатежейПоДоговоруНаСервере();
	КонецЕсли;
	
