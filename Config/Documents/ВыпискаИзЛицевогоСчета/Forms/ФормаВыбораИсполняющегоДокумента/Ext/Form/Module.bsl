
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МассивВыбранныхДокументов = Параметры.ВыбранныеДокументы.Выгрузить(, "ИсполняющийДокумент").ВыгрузитьКолонку("ИсполняющийДокумент");
	
	ИндексТекущего = МассивВыбранныхДокументов.Найти(Параметры.ТекущийДокумент);
	Если НЕ ИндексТекущего = Неопределено Тогда
		МассивВыбранныхДокументов.Удалить(ИндексТекущего);
	Конецесли;	
	
	ПериодС 	= Параметры.ДатаНачала;
	ПериодПо 	= Параметры.ДатаОкончания;
	
	Список.Параметры.УстановитьЗначениеПараметра("ДатаНачала",			НачалоДня(ПериодС));
	Список.Параметры.УстановитьЗначениеПараметра("ДатаОкончания",		КонецДня(ПериодПо));
	Список.Параметры.УстановитьЗначениеПараметра("ВыбранныеДокументы", 	МассивВыбранныхДокументов);
	Список.Параметры.УстановитьЗначениеПараметра("ЛицевойСчет",			Параметры.ЛицевойСчет);
	Список.Параметры.УстановитьЗначениеПараметра("Организация",			Параметры.Организация);
	Список.Параметры.УстановитьЗначениеПараметра("ТекущийДокумент",     Параметры.ТекущийДокумент);
	
	Заголовок = "Выбор документов в выписку за " + Формат(Параметры.ДатаОкончания,"ДЛФ=DD") + " по л/с " + Параметры.ЛицевойСчет;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущиеДанные.ДоступенВыбор Тогда
		ОповеститьОВыборе(Элемент.ТекущиеДанные.Ссылка);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Нельзя выбрать документ со статусом ""%1""'"),Элемент.ТекущиеДанные.СтатусИсполнения));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущиеДанные.ДоступенВыбор Тогда
		ОповеститьОВыборе(Элемент.ТекущиеДанные.Ссылка);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Нельзя выбрать документ со статусом ""%1""'"),Элемент.ТекущиеДанные.СтатусИсполнения));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодСПриИзменении(Элемент)
	ИзменитьПериодНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИзменитьПериодНаСервере()
	
	Список.Параметры.УстановитьЗначениеПараметра("ДатаНачала", 	НачалоДня(ПериодС));

КонецПроцедуры

#КонецОбласти
