&НаКлиенте
Процедура УстановитьОперацию(Команда)
	
	ПараметрыФормы = Новый Структура;
	
	ПолученныйСписок = ПолучитьСписокДокументов();
	
	Если ПолученныйСписок.Количество() = 0 Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не указаны документы, для которых необходимо заполнить бух. операцию.'"));
		
		Возврат;
		
	КонецЕсли;
	
	ПараметрыФормы.Вставить("СписокДокументов",ПолученныйСписок);
	ПараметрыФормы.Вставить("ВыпискаСсылка", Объект.Ссылка);
	
	ОткрытьФорму("ОбщаяФорма.ФормаЗаполненияРеквизитовТиповыхОпераций", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

