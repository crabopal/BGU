&НаСервере
Функция ПолучитьСписокДокументов()
	
	СписокЗначений = Новый СписокЗначений;
	
	Для Каждого ДокументДв Из Объект.ДокументыДвижений Цикл
		
		Если ЗначениеЗаполнено(ДокументДв.ИсполняющийДокумент) Тогда
			
			СписокЗначений.Добавить(ДокументДв.ИсполняющийДокумент);
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат СписокЗначений;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста 
Процедура УстановитьСписокВыбораПоказателей(ТипПС, ЭлементПоказатель)
	
	ЭлементПоказатель.СписокВыбора.Очистить();
	
	ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ОстатокСредствНаСчете"));
	
	Если ТипПС = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляКазенных") Тогда
		
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.АссигнованияНаТекущийФинансовыйГод"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.АссигнованияНаПервыйГодПлановогоПериода"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.АссигнованияНаВторойГодПлановогоПериода"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ЛБОНаТекущийФинансовыйГод"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ЛБОНаПервыйГодПлановогоПериода"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ЛБОНаВторойГодПлановогоПериода"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ПОФНаТекущийФинансовыйГодБезСвязанныхКредитов"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ПОФНаТекущийФинансовыйГодЗаСчетСвязанныхКредитов")); 
		
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ПОФНаТекущийФинансовыйГод"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ПОФНаТекущийФинансовыйГод_ОтложеннаяДата"));
        ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ПоставленныеНаУчетДО_ТекущийФинансовыйГод"));
		
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.БюджетныеОбязательстваНаТекущийФинансовыйГод"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.БюджетныеОбязательстваНаПервыйГодПлановогоПериода"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.БюджетныеОбязательстваНаВторойГодПлановогоПериода"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.КассовыеПоступленияСНачалаГода"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.КассовыеВыбытияСНачалаГода"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ИсточникДополнительногоБюджетногоФинансирования"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ИсточникДополнительногоБюджетногоФинансирования_поступления"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ИсточникДополнительногоБюджетногоФинансирования_возвраты"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ВозвратыСНачалаГода"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.ЗачетыСНачалаГода"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.НеисполненныеВозвратыСНачалаГода"));
		ЭлементПоказатель.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ПоказателиНаЛицевыхСчетах.НеисполненныйЗачетыСНачалаГода"));
		
	КонецЕсли;	
	
	ЭлементПоказатель.ОбновитьТекстРедактирования();
	
КонецПроцедуры	

&НаСервереБезКонтекста 
Функция ТипПланаСчетов(НаДату, Организация, ИФО)
	
	Возврат БухгалтерскийУчетПовтИсп.ТекущийТипПланаСчетов(Организация, ИФО, НаДату);	
	
КонецФункции

&НаСервере
Процедура ПолучитьЛицевойСчетПоУмолчанию()
	
	Объект.ЛицевойСчет = Справочники.ЛицевыеСчета.ПолучитьЛицевойСчетПоУмолчанию(Объект.Организация, "Документ.ВыпискаИзЛицевогоСчета", Объект.ДатаВыписки);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыПоЛицевомуСчету()
	
	ДоступныеОФК = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьКазначействаЛицевогоСчета(Объект.ЛицевойСчет);
	Элементы.КассовыйОрган.СписокВыбора.ЗагрузитьЗначения(ДоступныеОФК);
	
	ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет);
	Элементы.ОстаткиИсточникСредств.СписокВыбора.ЗагрузитьЗначения(ДопустимыеИсточникиСредств);
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ТекущийТипПС = ТипПланаСчетов(Объект.ДатаВыписки, Объект.Организация, Неопределено);
	
	УстановитьСписокВыбораПоказателей(ТекущийТипПС, Элементы.ОстаткиПоказатель);
	
	Если НЕ ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		
		ПолучитьЛицевойСчетПоУмолчанию();
		
		УстановитьПараметрыПоЛицевомуСчету();
		
		Объект.КассовыйОрган = "";
		
		Если Элементы.КассовыйОрган.СписокВыбора.Количество() > 0 Тогда
			
			Объект.КассовыйОрган = Элементы.КассовыйОрган.СписокВыбора[0].Значение;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьДобавленныеКолонки();
	
	ОбработатьТЧОстатки();
	
КонецПроцедуры

&НаСервере
Процедура ДатаВыпискиПриИзмененииНаСервере()
	
	ТекущийТипПС = ТипПланаСчетов(Объект.ДатаВыписки, Объект.Организация, Неопределено);
	
	УстановитьСписокВыбораПоказателей(ТекущийТипПС, Элементы.ОстаткиПоказатель);
	
	ОбработатьТЧОстатки();
	
КонецПроцедуры	

&НаСервере
Процедура ЛицевойСчетПриИзмененииНаСервере()
	
	УстановитьПараметрыПоЛицевомуСчету();
	
	Объект.КассовыйОрган = "";
	
	Если Элементы.КассовыйОрган.СписокВыбора.Количество() > 0 Тогда
		
		Объект.КассовыйОрган = Элементы.КассовыйОрган.СписокВыбора[0].Значение;
		
	КонецЕсли;
	
	ОбработатьТЧОстатки();
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьТЧОстатки()
	
	Для Каждого Стр Из Объект.Остатки Цикл
		
		Если Элементы.ОстаткиИсточникСредств.СписокВыбора.НайтиПоЗначению(Стр.ИсточникСредств) = Неопределено Тогда
			Стр.ИсточникСредств = "";
			Если Элементы.ОстаткиИсточникСредств.СписокВыбора.Количество() > 0 Тогда
				Стр.ИсточникСредств = Элементы.ОстаткиИсточникСредств.СписокВыбора[0].Значение;
			КонецЕсли;	
		КонецЕсли;
		
		Если Элементы.ОстаткиПоказатель.СписокВыбора.НайтиПоЗначению(Стр.Показатель) = Неопределено Тогда
			Стр.Показатель = "";
			Если Элементы.ОстаткиПоказатель.СписокВыбора.Количество() > 0 Тогда
				Стр.Показатель = Элементы.ОстаткиПоказатель.СписокВыбора[0].Значение;
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДобавленныеКолонки()
	
	Для Каждого Стр Из Объект.ДокументыДвижений Цикл
		
		ЗаполнитьДобавленныеКолонкиВСтроке(Стр);
		
	КонецЦикла;
	
	ИтогоПоступлений = Объект.ДокументыДвижений.Итог("ПоступленияДенежныхСредств");
	
	ИтогоВыплат = Объект.ДокументыДвижений.Итог("ВыплатыДенежныхСредств");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДобавленныеКолонкиВСтроке(Строка)
	
	Если ЗначениеЗаполнено(Строка.ИсполняющийДокумент) Тогда
		
		ДанныеСтр = Новый Структура("ИсполняющийДокумент, ВыплатыДенежныхСредств, ПоступленияДенежныхСредств, Валюта", Строка.ИсполняющийДокумент);
		
		ЗаполнитьПоступилоВыбыло(ДанныеСтр);
		
		Строка.ВыплатыДенежныхСредств = ДанныеСтр.ВыплатыДенежныхСредств;
		Строка.ПоступленияДенежныхСредств = ДанныеСтр.ПоступленияДенежныхСредств;
		Строка.Валюта = ДанныеСтр.Валюта;
		
	Иначе
		
		Строка.ВыплатыДенежныхСредств = 0;
		Строка.ПоступленияДенежныхСредств = 0;
		Строка.Валюта = ОбщегоНазначенияБГУВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьПоступилоВыбыло(Стр)
	
	ДокументыВыбытияДС = Новый Структура;
	ДокументыВыбытияДС.Вставить("ЗаявкаНаВозврат", 						        "СуммаДокументаВВалюте");
	ДокументыВыбытияДС.Вставить("ЗаявкаНаКассовыйРасход", 				        "СуммаДокументаВВалюте");
	ДокументыВыбытияДС.Вставить("ЗаявкаНаКассовыйРасходСокращенная",	        "СуммаДокумента");
	ДокументыВыбытияДС.Вставить("СводнаяЗаявкаНаКассовыйРасход",    	        "СуммаДокумента");
	ДокументыВыбытияДС.Вставить("ЗаявкаНаНаличные", 					        "СуммаДокумента");
	ДокументыВыбытияДС.Вставить("ЗаявкаНаНаличныеБанковскаяКарта", 		        "СуммаДокумента");
	ДокументыВыбытияДС.Вставить("КассовоеВыбытие", 						        "СуммаДокументаВВалюте");
	ДокументыВыбытияДС.Вставить("ПлатежноеПоручение", 					        "СуммаДокумента");    
	ДокументыВыбытияДС.Вставить("РаспоряжениеОПеречисленииНаКартыМир",	        "СуммаДокумента");
	
	ДокументыПоступленияДС = Новый Структура;
	ДокументыПоступленияДС.Вставить("КассовоеПоступление",				        "СуммаДокументаВВалюте");
	ДокументыПоступленияДС.Вставить("РасшифровкаВнесенныхЧерезБанкоматСредств",	"СуммаДокумента");
	
	ИмяПоказателя = "";
	
	ИмяДокумента = Стр.ИсполняющийДокумент.Метаданные().Имя;
	
	Если ДокументыВыбытияДС.Свойство(ИмяДокумента, ИмяПоказателя) Тогда
		
		Стр.ВыплатыДенежныхСредств = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.ИсполняющийДокумент, ИмяПоказателя);
		
	ИначеЕсли ДокументыПоступленияДС.Свойство(ИмяДокумента, ИмяПоказателя) Тогда
		
		Стр.ПоступленияДенежныхСредств = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.ИсполняющийДокумент, ИмяПоказателя);
		
	КонецЕсли;  
	
	Если ИмяДокумента = "ЗаявкаНаСдачуПолучениеНаличных" Тогда  
		
		Если Стр.ИсполняющийДокумент.СдачаПолучение = 1 Тогда
			Стр.ПоступленияДенежныхСредств = Стр.ИсполняющийДокумент.СуммаДокумента;
		Иначе
			Стр.ВыплатыДенежныхСредств     = Стр.ИсполняющийДокумент.СуммаДокумента;
		КонецЕсли;	
		
	КонецЕсли;	
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Стр.ИсполняющийДокумент, "ВалютаДокумента") Тогда
		Стр.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.ИсполняющийДокумент, "ВалютаДокумента");
	Иначе
		Стр.Валюта = ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДокументыДвиженийСформироватьПроводкиНаСервере()
	
	МассивДокументов = Объект.ДокументыДвижений.Выгрузить().ВыгрузитьКолонку("ИсполняющийДокумент");
	
	Для Каждого Док Из МассивДокументов Цикл
		
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док, "Проведен") Тогда
			
			НовТабПроводок = Обработки.ФормированиеБухгалтерскихПроводок.СформироватьТаблицуПроводок(Док);
			
			Если НовТабПроводок = Неопределено Тогда
				ТекстСообщения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Не сформированы Бухгалтерские провдки по документу %1'"), Док);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,);
				Продолжить;
			КонецЕсли;
			
			Попытка
				НачатьТранзакцию();
				
				БухЗаписиДокумента = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
				БухЗаписиДокумента.Отбор.Регистратор.Установить(Док);
				БухЗаписиДокумента.БлокироватьДляИзменения = Истина;
				БухЗаписиДокумента.Записывать = Истина;
				БухЗаписиДокумента.Загрузить(НовТабПроводок);
				БухЗаписиДокумента.Записать(Истина);
				
				ЗафиксироватьТранзакцию();
				ТекстСообщения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Сформированы бухгалтерские провдки по документу %1'"), Док);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,);
				
			Исключение
				ОтменитьТранзакцию();
				
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ТекстСообщения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Документ %1 не проведен.
				|%2'"), Док, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,);
			КонецПопытки;
			
		Иначе
			
			ТекстСообщения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Документ %1 не проведен.
			|Запрещена запись проводок не проведенного документа.'"), Док);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,);
			
		КонецЕсли;
		
	КонецЦикла;	  
	
КонецПроцедуры	

