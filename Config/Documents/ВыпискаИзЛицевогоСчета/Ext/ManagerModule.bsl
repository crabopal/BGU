Функция ИзменениеСтатусаИсполняющихДокументов(ТаблицаДокументовИКурсов, Статус, ДатаОплаты = "") Экспорт
	
	Отказ = Ложь;
	
	МассивДокументов = ТаблицаДокументовИКурсов.ВыгрузитьКолонку("ИсполняющийДокумент");
	
	Если МассивДокументов.Количество() = 0 Тогда
		Возврат Отказ;
	КонецЕсли;
	
	ДопустимыеТипыДокументов = Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Измерения.ПлатежноРасчетныйДокумент.Тип;
	
	МассивТиповДокументов = Новый Массив;
	Для Каждого Документ Из МассивДокументов Цикл
		Если НЕ ДопустимыеТипыДокументов.СодержитТип(ТипЗнч(Документ)) Тогда
			Продолжить;
		КонецЕсли;
		ТипДокумента = Документ.Метаданные().ПолноеИмя();
		Если МассивТиповДокументов.Найти(ТипДокумента) = Неопределено Тогда
			МассивТиповДокументов.Добавить(ТипДокумента);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивТиповДокументов.Количество() = 0 Тогда
		Возврат Отказ;
	КонецЕсли;
	
	ПолеДатаДокумента = "ВЫБОР";
	Для Каждого ТипДокумента Из МассивТиповДокументов Цикл
		ПолеДатаДокумента = ПолеДатаДокумента + "
		|		КОГДА СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент ССЫЛКА "+ТипДокумента+"
		|		ТОГДА ВЫРАЗИТЬ(СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент КАК "+ТипДокумента+").Дата"
	КонецЦикла;
	ПолеДатаДокумента = ПолеДатаДокумента + "
	|	ИНАЧЕ ДАТАВРЕМЯ(1,1,1) КОНЕЦ КАК ДатаПлатежноРасчетногоДокумента";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент,
	|	СостояниеПлатежноРасчетныхДокументов.НомерЗаявки,
	|	СостояниеПлатежноРасчетныхДокументов.ДатаРегистрации,
	|	СостояниеПлатежноРасчетныхДокументов.GUIDКО,
	|	СостояниеПлатежноРасчетныхДокументов.ОтветственныйИсполнительДолжность,
	|	СостояниеПлатежноРасчетныхДокументов.ОтветственныйИсполнительФИО,
	|	СостояниеПлатежноРасчетныхДокументов.ОтветственныйИсполнительТелефон,
	|	СостояниеПлатежноРасчетныхДокументов.НомерОбязательства,
	|	СостояниеПлатежноРасчетныхДокументов.НомерПодтверждающегоДокумента,
	|	СостояниеПлатежноРасчетныхДокументов.ДатаПодтверждающегоДокумента,
	|	СостояниеПлатежноРасчетныхДокументов.ДатаПроведения,
	|	СостояниеПлатежноРасчетныхДокументов.Статус,
	|	СостояниеПлатежноРасчетныхДокументов.ПервичныйОбразИРеквизиты,
	|	СостояниеПлатежноРасчетныхДокументов.Курс,
	|	"+ПолеДатаДокумента+"
	|ИЗ
	|	РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
	|ГДЕ
	|	СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент.Ссылка В(&МассивДокументов)
	|	И НЕ СостояниеПлатежноРасчетныхДокументов.Статус = &Статус";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Запрос.УстановитьПараметр("Статус", Статус);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	РеквизитыРегистрации = Новый Структура;
	
	Для каждого Строка из Результат цикл
		
		РеквизитыРегистрации.Очистить();
		
		Для каждого Колонка из Результат.Колонки цикл
			РеквизитыРегистрации.Вставить(Колонка.Имя, Строка[Колонка.Имя]);
		КонецЦикла;
		
		РеквизитыРегистрации.Вставить("ДатаПроведения", ДатаОплаты);
		РеквизитыРегистрации.Вставить("Статус", Статус);
		РеквизитыРегистрации.Вставить("Курс",
			ТаблицаДокументовИКурсов.Найти(Строка.ПлатежноРасчетныйДокумент, "ИсполняющийДокумент").Курс);
		
		// Если дата документа совпадает с датой выписки, то необходимо, чтобы время проведения совпадало с временем документа (не раньше).
		Если Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Исполнен")
			И НачалоДня(ДатаОплаты) = НачалоДня(Строка.ДатаПлатежноРасчетногоДокумента) Тогда
			РеквизитыРегистрации.Вставить("ДатаПроведения", Строка.ДатаПлатежноРасчетногоДокумента);
		КонецЕсли;
		
		Отказ = НЕ ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(РеквизитыРегистрации);
		
		Если Отказ тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Отказ;
	
КонецФункции

Процедура УстановитьСтатусВыписки(Ссылка, Статус) Экспорт
	
	СостояниеВыписки = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Ссылка);
	Запись = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьМенеджерЗаписи();
	Запись.ПлатежноРасчетныйДокумент 	= Ссылка;
	Для каждого Ресурс из Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Ресурсы цикл
		Попытка
			Запись[Ресурс.Имя]	= СостояниеВыписки[Ресурс.Имя];
		Исключение
		КонецПопытки;	
	КонецЦикла;
	Запись.ПервичныйОбразИРеквизиты = СостояниеВыписки.ПервичныйОбразИРеквизиты;
	Запись.Статус = Статус;
	Запись.Записать();
	
КонецПРоцедуры	

