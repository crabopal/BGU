#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
	
// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
	//Отказ = Документы.ВыпискаИзЛицевогоСчета.ИзменениеСтатусаИсполняющихДокументов(ДокументыДвижений.ВыгрузитьКолонку("ИсполняющийДокумент"), Перечисления.СтатусыИсполненияДокумента.НаИсполнении);
	ДокументыИКурсы = ДокументыДвижений.Выгрузить();
	Отказ = Документы.ВыпискаИзЛицевогоСчета.ИзменениеСтатусаИсполняющихДокументов(ДокументыИКурсы, Перечисления.СтатусыИсполненияДокумента.НаИсполнении);
	
	Если Не Отказ тогда
		Документы.ВыпискаИзЛицевогоСчета.УстановитьСтатусВыписки(ЭтотОбъект.Ссылка, Перечисления.СтатусыИсполненияДокумента.НаИсполнении);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	//ТЗ = ДокументыДвижений.Выгрузить();   //исключаем дубли	
	//ТЗ.Свернуть("ИсполняющийДокумент");	
	//ДокументыДвижений.Загрузить(ТЗ);
	
	ДокументыДвижений.Свернуть("ИсполняющийДокумент, Курс"); //исключаем дубли
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ЭтотОбъект.Организация				= "";
	ЭтотОбъект.ЛицевойСчет				= "";
	ЭтотОбъект.КассовыйОрган			= "";
	ЭтотОбъект.ДатаВыписки				= "";
	ЭтотОбъект.ДатаПредыдущейВыписки	= "";
	ЭтотОбъект.Остатки.Очистить();
	ЭтотОбъект.ДокументыДвижений.Очистить();
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ОстаткиНаЛицевыхСчетах.Записывать = Истина;
	Движения.ОстаткиНаЛицевыхСчетах.Очистить();
	
	// регистр ОстаткиНаЛицевыхСчетах
	Для Каждого ТекСтрокаОстатки Из Остатки Цикл
		Движение = Движения.ОстаткиНаЛицевыхСчетах.Добавить();
		Движение.Период 			= КонецДня(ДатаВыписки);
		Движение.ЛицевойСчет 		= ЛицевойСчет;
		Движение.ИсточникСредств 	= ТекСтрокаОстатки.ИсточникСредств;
		Движение.Показатель 		= ТекСтрокаОстатки.Показатель;
		Движение.НаНачалоДня 		= ТекСтрокаОстатки.ОстатокНаНачалоДня;
		Движение.НаКонецДня 		= ТекСтрокаОстатки.ОстатокНаКонецДня;
	КонецЦикла;
	
	//Отказ = Документы.ВыпискаИзЛицевогоСчета.ИзменениеСтатусаИсполняющихДокументов(ДокументыДвижений.ВыгрузитьКолонку("ИсполняющийДокумент"), Перечисления.СтатусыИсполненияДокумента.Исполнен, ДатаВыписки);
	Отказ = Документы.ВыпискаИзЛицевогоСчета.ИзменениеСтатусаИсполняющихДокументов(ДокументыДвижений.Выгрузить(), Перечисления.СтатусыИсполненияДокумента.Исполнен, ДатаВыписки);
	
	Если Не Отказ тогда
		Документы.ВыпискаИзЛицевогоСчета.УстановитьСтатусВыписки(ЭтотОбъект.Ссылка, Перечисления.СтатусыИсполненияДокумента.Исполнен); 
	КонецЕсли;
	
	Если НЕ Отказ И НЕ ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента") И ФормироватьБухПроводкиДокументов Тогда
		Отказ = СформироватьПроводкиИсполняющихДокументов();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьПроводкиИсполняющихДокументов()
	
	Если НЕ ПравоДоступа("Изменение", Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Нет прав на запись проводок в регистр бухгалтерии ""Журнал проводок (ЕПСБУ)"".
		|Бухгалтерские записи не сформированы.'"));
		Возврат Ложь;	
	КонецЕсли;
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	ОперацииДокументов.Операция,
	|	ОперацииДокументов.Дата,
	|	ОперацииДокументов.Организация,
	|	ОперацииДокументов.Документ
	|ИЗ
	|	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|ГДЕ
	|	ОперацииДокументов.Документ В(&Документы)");
	
	Запрос.УстановитьПараметр("Документы", ЭтотОбъект.ДокументыДвижений.Выгрузить().ВыгрузитьКолонку("ИсполняющийДокумент"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Для Каждого СтрТч Из ЭтотОбъект.ДокументыДвижений Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрТЧ.ИсполняющийДокумент) Тогда
			Продолжить;
		КонецЕсли;
		
		ПредставлениеДокумента = Строка(СтрТЧ.ИсполняющийДокумент);
		
		Выборка.Сбросить();
		Если Выборка.НайтиСледующий(Новый Структура("Документ", СтрТЧ.ИсполняющийДокумент)) Тогда
			Операция = Выборка.Операция;
		Иначе
			Операция = Справочники.ТиповыеОперации.ПустаяСсылка();
			ОбщегоНазначения.СообщитьПользователю(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Для документа ""%1"" не установлена типовая операция. Проводки не сформированы. '"), ПредставлениеДокумента));
			Продолжить;
		КонецЕсли;
		
		ДопРеквизиты = БухгалтерскиеОперацииСервер.ЗаполнитьДополнительныеРеквизиты(СтрТч.ИсполняющийДокумент, Операция);
		
		ДокументОбъект = СтрТЧ.ИсполняющийДокумент.ПолучитьОбъект();
		БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(ДокументОбъект ,Операция, ДопРеквизиты, Истина);
		
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); 
			Если СтрНайти(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), ПредставлениеДокумента) = 0 Тогда
				ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Не удалось провести ""%1""!'"), ПредставлениеДокумента));
			КонецЕсли;
			ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	        Возврат Истина;
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#КонецЕсли