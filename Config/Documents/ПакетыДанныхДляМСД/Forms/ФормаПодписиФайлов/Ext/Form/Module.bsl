
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Пакет = Параметры.Пакет;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПакетыДанныхДляМСДПрисоединенныеФайлы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПакетыДанныхДляМСДПрисоединенныеФайлы КАК ПакетыДанныхДляМСДПрисоединенныеФайлы
	|ГДЕ
	|	ПакетыДанныхДляМСДПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайлов
	|	И НЕ ПакетыДанныхДляМСДПрисоединенныеФайлы.ПометкаУдаления
	|	И ПОДСТРОКА(ПакетыДанныхДляМСДПрисоединенныеФайлы.Наименование, 1, 8) <> ""Протокол""
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПакетыДанныхДляМСДПрисоединенныеФайлы.ДатаСоздания УБЫВ";
	
	Запрос.УстановитьПараметр("ВладелецФайлов", Пакет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		МодульРаботаСФайламиКлиентСервер = ОбщегоНазначения.ОбщийМодуль("РаботаСФайламиКлиентСервер");
		ПараметрыДанныхФайла = МодульРаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
		ПараметрыДанныхФайла.ПолучатьСсылкуНаДвоичныеДанные = Истина;
		
		МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
		СведенияОФайле = МодульРаботаСФайлами.ДанныеФайла(Выборка.Ссылка, ПараметрыДанныхФайла);
		
		Если СведенияОФайле = Неопределено Тогда
			ТекстСообщения = НСтр(
				"ru = 'По ссылке на присоединенный файл в документе ""Пакет данных для МСД"" отсутствует сам файл в томе на сервере.
				|Обработка прервана.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(СведенияОФайле.СсылкаНаДвоичныеДанныеФайла);
		
		МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
		КаталогФайлов = МодульОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ПолучитьИмяВременногоФайла()).Путь + Новый УникальныйИдентификатор() + ПолучитьРазделительПути();
		СоздатьКаталог(КаталогФайлов);

		Поток = ДвоичныеДанные.ОткрытьПотокДляЧтения();
		ЧтениеZip = Новый ЧтениеZipФайла(Поток);
		ЧтениеZip.ИзвлечьВсе(КаталогФайлов);
				
		ТаблицаФайловКОбработке = Новый ТаблицаЗначений;
		ТаблицаФайловКОбработке.Колонки.Добавить("ИмяИдентификатор");
		ТаблицаФайловКОбработке.Колонки.Добавить("ИмяБезРасширения");
		ТаблицаФайловКОбработке.Колонки.Добавить("Имя"); 
		ТаблицаФайловКОбработке.Колонки.Добавить("Расширение");
		ТаблицаФайловКОбработке.Колонки.Добавить("ДДФайла");
		
		Для Каждого ЭлементZipАрхива Из ЧтениеZip.Элементы Цикл
			СтрокаТаблицы = ТаблицаФайловКОбработке.Добавить();
            ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЭлементZipАрхива);
					
			IsXML = (ЭлементZipАрхива.Расширение = "xml");
			Если IsXML Тогда 
				СтрокаТаблицы.ИмяИдентификатор = ЭлементZipАрхива.ИмяБезРасширения;
			Иначе 
				МассивИмя = СтрРазделить(ЭлементZipАрхива.Имя, "_");
				МассивИмя.Удалить(МассивИмя.Количество() - 1);	
				ИмяИдентификатор = СтрСоединить(МассивИмя, "_");
                СтрокаТаблицы.ИмяИдентификатор = ИмяИдентификатор;				
			КонецЕсли;	
			СтрокаТаблицы.ДДФайла = Новый ДвоичныеДанные(КаталогФайлов + ЭлементZipАрхива.Имя);	
		КонецЦикла;
				
		ЧтениеZip.Закрыть();
		Поток.Закрыть();
		УдалитьФайлы(КаталогФайлов);
		
		МодульЭлектроннаяПодпись = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодпись");
		ТаблицаФайловКОбработке.Сортировать("Имя");
		ФайлыКПодписанию = ТаблицаФайловКОбработке.НайтиСтроки(Новый Структура("Расширение", "xml"));
		ЭлементыДерева = ДеревоФайлы.ПолучитьЭлементы(); 
		Для каждого СтрокаФайлКПодписанию Из ФайлыКПодписанию Цикл
			СтрокаТаблицы = ЭлементыДерева.Добавить();
			СтрокаТаблицы.ИмяФайла = СтрокаФайлКПодписанию.Имя;
			СтрокаТаблицы.ДДФайла = ПоместитьВоВременноеХранилище(СтрокаФайлКПодписанию.ДДФайла, УникальныйИдентификатор);
			СтрокаТаблицы.ОткрытьФайл = "Открыть файл"; 
			СтрокаТаблицы.Расширение = СтрокаФайлКПодписанию.Расширение;
			КоличествоПодписей = 0;
			ПодписиКФайлу = ТаблицаФайловКОбработке.НайтиСтроки(Новый Структура("ИмяИдентификатор", СтрокаФайлКПодписанию.ИмяИдентификатор));
			СтрокаТаблицы.Подписан = ПодписиКФайлу.Количество() > 1;
			ЭлементыСтрокаТаблицы = СтрокаТаблицы.ПолучитьЭлементы(); 
			Для каждого СтрокаПодпись Из ПодписиКФайлу Цикл
				Если НЕ СтрокаПодпись.Расширение = "xml" Тогда
					СтрокаТаблицыПодпись = ЭлементыСтрокаТаблицы.Добавить();
					СтрокаТаблицыПодпись.ИмяФайла = СтрокаПодпись.Имя; 
					СтрокаТаблицыПодпись.Расширение = СтрокаПодпись.Расширение;
					СтрокаТаблицыПодпись.КоличествоПодписей = 1;
					КоличествоПодписей = КоличествоПодписей + 1; 
					СвойстваПодписи = МодульЭлектроннаяПодпись.СвойстваПодписи(СтрокаПодпись.ДДФайла);
					СтрокаТаблицыПодпись.ДДФайла = ПоместитьВоВременноеХранилище(СтрокаПодпись.ДДФайла, УникальныйИдентификатор); 
					СсылкаНаСертификат = МодульЭлектроннаяПодпись.СсылкаНаСертификат(СвойстваПодписи.Сертификат);
					Если СсылкаНаСертификат = Неопределено Тогда
						СтрокаТаблицыПодпись.Сертификат = СвойстваПодписи.КомуВыданСертификат;
					Иначе
						СтрокаТаблицыПодпись.Сертификат = СсылкаНаСертификат;
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;	
			СтрокаТаблицы.КоличествоПодписей = КоличествоПодписей;
		КонецЦикла;			
	Иначе		
		ТекстСообщения = НСтр(
			"ru = 'В документе ""Пакет данных для МСД"" отсутствует актуальный файл выгрузки. Обработка прервана.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);   
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоФайлы

&НаКлиенте
Асинх Процедура ДеревоФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ДеревоФайлыСертификат" Тогда
		СтандартнаяОбработка = Ложь;
		Сертификат = ДеревоФайлы.НайтиПоИдентификатору(ВыбраннаяСтрока).Сертификат;
		Если ТипЗнч(Сертификат) = Тип("СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования") Тогда
			ОткрытьФорму("Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования.ФормаОбъекта", Новый Структура("Ключ", Сертификат));
		КонецЕсли;
	ИначеЕсли Поле.Имя = "ДеревоФайлыОткрытьФайл" Тогда
		СтандартнаяОбработка = Ложь;
		СтрокаТаблицы = ДеревоФайлы.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если ЗначениеЗаполнено(СтрокаТаблицы.ОткрытьФайл) Тогда
						
			#Если ВебКлиент Тогда
			Результат = Ждать ПодключитьРасширениеРаботыСФайламиАсинх();
			Если Не Результат Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Необходимо установить расширение работы с файлами 1С:Предприятие 8.'"));
				ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Установить расширение можно в разделе Мои настройки (Главное - Мои настройки).'"));
				Возврат;
			КонецЕсли;		
			#КонецЕсли
			
			Если ЭтоАдресВременногоХранилища(СтрокаТаблицы.ДДФайла) Тогда
				ДДФайла = ПолучитьИзВременногоХранилища(СтрокаТаблицы.ДДФайла);	
			КонецЕсли;

			КаталогВременныхФайлов = Ждать КаталогВременныхФайловАсинх();
			ИмяВременногоФайла = СтрШаблон("%1%2.xml", КаталогВременныхФайлов, Строка(Новый УникальныйИдентификатор));
			
			Результат = Ждать ДДФайла.ЗаписатьАсинх(ИмяВременногоФайла);
			Результат = Ждать ЗапуститьПриложениеАсинх(ИмяВременногоФайла); 		
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти
