#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	МодульПодключаемыеКоманды = ОбщегоНазначения.ОбщийМодуль("ПодключаемыеКоманды");
	ПараметрыРазмещения = МодульПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.КомандыФормы;
	МодульПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	История.Параметры.УстановитьЗначениеПараметра("Пакет", Неопределено);
	ИнициализироватьЛегендуСостояний(); 
	
	ЗаполнитьПараметрыМесяц(); 
	УстановитьОтборыФормы();
				
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ФормаСроковПредоставления = ПолучитьФорму("РегистрСведений.СведенияОСрокахПредоставленияДанныхМСД.Форма.ФормаСроков");
	Если НЕ ФормаСроковПредоставления.Открыта() Тогда
		ПолучитьУведомлениеПользователя();
		ПодключитьОбработчикОжидания("ПолучитьУведомлениеПользователя", 60);  
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы 

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)  
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	История.Параметры.УстановитьЗначениеПараметра("Пакет", ТекущиеДанные.Ссылка);
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
	МодульПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Элементы.Список);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПродолжитьВыполнениеКомандыНаСервере(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	ВыполнитьКомандуНаСервере(ПараметрыВыполнения);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьКомандуНаСервере(ПараметрыВыполнения)
	МодульПодключаемыеКоманды = ОбщегоНазначения.ОбщийМодуль("ПодключаемыеКоманды");
	МодульПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, Элементы.Список);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	МодульПодключаемыеКомандыКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиентСервер");
	МодульПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.Список);
КонецПроцедуры

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура ОткрытьФайлыПакета(Команда)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено Тогда
		ОткрытьФорму("Документ.ПакетыДанныхДляМСД.Форма.ФормаПодписиФайлов", Новый Структура("Пакет", ТекущиеДанные.Ссылка), ЭтотОбъект);	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

&НаСервере
Процедура ИнициализироватьЛегендуСостояний()
	
	КартинкаСформирован = 0;
	КартинкаОтправлен = 1;
	КартинкаВОчереди = 2;	
	КартинкаЗагружен = 3;
	КартинкаНеПринят = 5; 
	КартинкаОжидание = 6; 
	КартинкаНетДанных = 7;

КонецПроцедуры	

&НаСервере
Функция ПолучитьУведомлениеПользователяНаСервере()
	Возврат МодульСбораДанных.УведомлениеПользователя();
КонецФункции  

&НаКлиенте
Процедура ОткрытиеОповещения(ДополнительныеПараметры) Экспорт
 	ОткрытьФорму("РегистрСведений.СведенияОСрокахПредоставленияДанныхМСД.Форма.ФормаСроков");
КонецПроцедуры 

&НаКлиенте
Процедура ПолучитьУведомлениеПользователя()
	
	МассивРезультат = ПолучитьУведомлениеПользователяНаСервере(); 
	
	Для каждого СтрокаМассива Из МассивРезультат Цикл
		ВыводитьОповещение = Истина;
		Если НЕ ХранилищеСравненияОповещений.НайтиПоЗначению(СтрокаМассива.ИдентификаторСтроки) = Неопределено Тогда
			ВыводитьОповещение = Ложь;	
		КонецЕсли;	
		
		Если ВыводитьОповещение = Истина Тогда
			Описание = Новый ОписаниеОповещения("ОткрытиеОповещения", ЭтотОбъект);	
			ПоказатьОповещениеПользователя(СтрШаблон(НСтр("ru='Отчетный период: %1'"), СтрокаМассива.ПериодДанных),
									      Описание,
			                              СтрокаМассива.Результат,
									      БиблиотекаКартинок.Оповещения,
									      СтатусОповещенияПользователя.Важное,
								          СтрокаМассива.ПериодДанных);
			ХранилищеСравненияОповещений.Добавить(СтрокаМассива.ИдентификаторСтроки);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьПараметрыМесяц()
	
	Список.Параметры.УстановитьЗначениеПараметра("Январь", НСтр("ru='Январь'", ОбщегоНазначения.КодОсновногоЯзыка())); 
	Список.Параметры.УстановитьЗначениеПараметра("Февраль", НСтр("ru='Февраль'", ОбщегоНазначения.КодОсновногоЯзыка()));
	Список.Параметры.УстановитьЗначениеПараметра("Март", НСтр("ru='Март'", ОбщегоНазначения.КодОсновногоЯзыка()));
	Список.Параметры.УстановитьЗначениеПараметра("Апрель", НСтр("ru='Апрель'", ОбщегоНазначения.КодОсновногоЯзыка()));
	Список.Параметры.УстановитьЗначениеПараметра("Май", НСтр("ru='Май'", ОбщегоНазначения.КодОсновногоЯзыка()));
	Список.Параметры.УстановитьЗначениеПараметра("Июнь", НСтр("ru='Июнь'", ОбщегоНазначения.КодОсновногоЯзыка()));
	Список.Параметры.УстановитьЗначениеПараметра("Июль", НСтр("ru='Июль'", ОбщегоНазначения.КодОсновногоЯзыка()));
	Список.Параметры.УстановитьЗначениеПараметра("Август", НСтр("ru='Август'", ОбщегоНазначения.КодОсновногоЯзыка()));
	Список.Параметры.УстановитьЗначениеПараметра("Сентябрь", НСтр("ru='Сентябрь'", ОбщегоНазначения.КодОсновногоЯзыка()));
	Список.Параметры.УстановитьЗначениеПараметра("Октябрь", НСтр("ru='Октябрь'", ОбщегоНазначения.КодОсновногоЯзыка()));
	Список.Параметры.УстановитьЗначениеПараметра("Ноябрь", НСтр("ru='Ноябрь'", ОбщегоНазначения.КодОсновногоЯзыка()));
	Список.Параметры.УстановитьЗначениеПараметра("Декабрь", НСтр("ru='Декабрь'", ОбщегоНазначения.КодОсновногоЯзыка()));
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьОтборыФормы()

	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Список.Отбор, "ПометкаУдаления",
	ВидСравненияКомпоновкиДанных.Равно, Ложь, "СкрыватьПометкуУдаленияПоУмолчанию", Ложь,
	РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);

	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Список.Отбор, "Организация",
	ВидСравненияКомпоновкиДанных.Равно, ОтборОрганизация, "ОтборОрганизация", Ложь,
	РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);  
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Список.Отбор, "Статус",
	ВидСравненияКомпоновкиДанных.Равно, ОтборСтатус, "ОтборСтатус", Ложь,
	РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный); 
	
	ГруппаЭлементовОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Список.Отбор, "ГруппаЭлементовОтбора", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
 
	НачалоПериода = ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаЭлементовОтбора, "НачалоПериода",
	ВидСравненияКомпоновкиДанных.Равно, Дата(1,1,1), "ОтборНачалоПериода", Ложь,
	РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный); 
	
	ОкончаниеПериода = ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаЭлементовОтбора, "ОкончаниеПериода",
	ВидСравненияКомпоновкиДанных.Равно, Дата(1,1,1), "ОтборОкончаниеПериода", Ложь,
	РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный); 
	
	ВидПередаваемыхДанных = ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаЭлементовОтбора, "ВидПередаваемыхДанных",
	ВидСравненияКомпоновкиДанных.Равно, Ложь, "ОтборВидПередаваемыхДанных", Ложь,
	РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		
КонецПроцедуры 

&НаКлиенте
Процедура ПоказыватьПомеченные(Команда)	
	Элементы.ФормаПоказыватьПомеченные.Пометка = Не Элементы.ФормаПоказыватьПомеченные.Пометка;
	ОбщегоНазначенияКлиентСервер.ИзменитьЭлементыОтбора(Список.Отбор, "ПометкаУдаления",
		"СкрыватьПометкуУдаленияПоУмолчанию", Ложь, ВидСравненияКомпоновкиДанных.Равно,
		Не Элементы.ФормаПоказыватьПомеченные.Пометка, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.ИзменитьЭлементыОтбора(Список.Отбор, "Организация",
		"ОтборОрганизация", ОтборОрганизация, ВидСравненияКомпоновкиДанных.Равно,
		ЗначениеЗаполнено(ОтборОрганизация), РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
КонецПроцедуры

&НаСервере
Процедура ОтборПериодПриИзмененииНаСервере()
	ЗначенияРеквизитовОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтборПериод, "ДатаНачала, ДатаОкончания, Периодичность"); 
	
	ОбщегоНазначенияКлиентСервер.ИзменитьЭлементыОтбора(Список.Отбор, "НачалоПериода",
		"ОтборНачалоПериода", НачалоДня(?(ЗначениеЗаполнено(ЗначенияРеквизитовОбъекта.ДатаНачала), ЗначенияРеквизитовОбъекта.ДатаНачала, Дата(1,1,1))), ВидСравненияКомпоновкиДанных.Равно,
		ЗначениеЗаполнено(ЗначенияРеквизитовОбъекта.ДатаНачала), РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		
	ОбщегоНазначенияКлиентСервер.ИзменитьЭлементыОтбора(Список.Отбор, "ОкончаниеПериода",
		"ОтборОкончаниеПериода", КонецДня(?(ЗначениеЗаполнено(ЗначенияРеквизитовОбъекта.ДатаОкончания), ЗначенияРеквизитовОбъекта.ДатаОкончания, Дата(1,1,1))), ВидСравненияКомпоновкиДанных.Равно,
		ЗначениеЗаполнено(ЗначенияРеквизитовОбъекта.ДатаОкончания), РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		
	ОбщегоНазначенияКлиентСервер.ИзменитьЭлементыОтбора(Список.Отбор, "ВидПередаваемыхДанных",
		"ОтборВидПередаваемыхДанных", (ЗначенияРеквизитовОбъекта.Периодичность = Перечисления.ПериодичностьМСД.Месяц) , ВидСравненияКомпоновкиДанных.Равно,
		ЗначениеЗаполнено(ЗначенияРеквизитовОбъекта.Периодичность), РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
КонецПроцедуры

&НаКлиенте
Процедура ОтборПериодПриИзменении(Элемент)
	ОтборПериодПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОтборСтатусПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.ИзменитьЭлементыОтбора(Список.Отбор, "Статус",
		"ОтборСтатус", ОтборСтатус, ВидСравненияКомпоновкиДанных.Равно,
		ЗначениеЗаполнено(ОтборСтатус), РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
КонецПроцедуры

#КонецОбласти

