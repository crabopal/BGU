КонецПроцедуры

&НаКлиенте
Процедура ОснованиеДляДействующейРедакцииНажатие(Элемент, СтандартнаяОбработка)
	ПоказатьЗначение(Неопределено, Основание);
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПоКорректировке(ДокументСформирован)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПакетыДанныхМСД.Пакет КАК Пакет,
		|	МАКСИМУМ(ПакетыДанныхДляМСД.Дата) КАК Период

		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПакетыДанныхДляМСД КАК ПакетыДанныхДляМСД
		|		ПО ПакетыДанныхМСД.Пакет = ПакетыДанныхДляМСД.Ссылка
		|ГДЕ
		|	ПакетыДанныхДляМСД.ВидПередаваемыхДанных = &ВидПередаваемыхДанных
		|	И НАЧАЛОПЕРИОДА(ПакетыДанныхДляМСД.НачалоПериода, ДЕНЬ) = &НачалоПериода
		|	И КОНЕЦПЕРИОДА(ПакетыДанныхДляМСД.ОкончаниеПериода, ДЕНЬ) = &ОкончаниеПериода
		|	И ПакетыДанныхДляМСД.Организация = &Организация
		|	И ПакетыДанныхМСД.Статус = &СтатусСформирован
		|	И НЕ ПакетыДанныхДляМСД.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	ПакетыДанныхМСД.Пакет
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("ВидПередаваемыхДанных", Объект.ВидПередаваемыхДанных);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Объект.НачалоПериода));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(Объект.ОкончаниеПериода));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("СтатусСформирован", Перечисления.СтатусыПакетовМСД.Сформирован);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Элементы.ГруппаРедакцияДокумента.Видимость = Ложь; 
		Элементы.ФормаГруппаСервис.Доступность = Ложь;
		Элементы.ФормаПодписатьПакет.Доступность = Ложь; 
		Элементы.ФормаГруппаУстановитьСтатус.Доступность = Ложь; 
	Иначе		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();		
		
		ЭтоДействующийДокумент = (Объект.Ссылка = ВыборкаДетальныеЗаписи[0].Пакет);
		Если ЭтоДействующийДокумент Тогда
			Если ВыборкаДетальныеЗаписи.Количество() > 1 Тогда
				Основание = ВыборкаДетальныеЗаписи[1].Пакет;	
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
				ДействующийДокумент = ВыборкаДетальныеЗаписи[0].Пакет;
			КонецЕсли;
		КонецЕсли;
		Элементы.ФормаГруппаСервис.Доступность = ЭтоДействующийДокумент;
		Элементы.ФормаПодписатьПакет.Доступность = ЭтоДействующийДокумент; 
		ФормированиеДоступно = (ЭтоДействующийДокумент ИЛИ (НЕ ЭтоДействующийДокумент И НЕ ДокументСформирован)) И ФормированиеДоступно(); 
		Элементы.ФормаСформироватьВыгрузку.Доступность = ФормированиеДоступно;
		Элементы.ГруппаРедакцияДокумента.Видимость = Истина;
		Элементы.ГруппаДействующийДокумент.Видимость 			= ЭтоДействующийДокумент; 
		Элементы.ОснованиеДляДействующейРедакции.Видимость 		= ЭтоДействующийДокумент;
		Если Основание.Пустая() Тогда
			Элементы.ОснованиеДляДействующейРедакции.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		Иначе
			Элементы.ОснованиеДляДействующейРедакции.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
		КонецЕсли;	
		Элементы.ГруппаПереходаКДействующемуДокументу.Видимость = (НЕ ЭтоДействующийДокумент И НЕ Объект.Ссылка.Пустая());
		Элементы.ДействующийДокумент.Видимость 					= НЕ ДействующийДокумент.Пустая(); 
		Элементы.ФормаГруппаУстановитьСтатус.Доступность = ЭтоДействующийДокумент;
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Функция ФормированиеДоступно()
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК Отправлен
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|ГДЕ
		|	ПакетыДанныхМСД.Пакет = &Пакет
		|	И НЕ ПакетыДанныхМСД.Статус В (&СтатусыФормирование)";
	
	Запрос.УстановитьПараметр("Пакет", Объект.Ссылка);
	МассивСтатусыФормирование = Новый Массив;
	МассивСтатусыФормирование.Добавить(Перечисления.СтатусыПакетовМСД.Сформирован); 
	МассивСтатусыФормирование.Добавить(Перечисления.СтатусыПакетовМСД.Формирование);
	МассивСтатусыФормирование.Добавить(Перечисления.СтатусыПакетовМСД.НаПодписании1Подписью);
	МассивСтатусыФормирование.Добавить(Перечисления.СтатусыПакетовМСД.НаПодписании2Подписью);
	МассивСтатусыФормирование.Добавить(Перечисления.СтатусыПакетовМСД.Подписан1Подписью);
	МассивСтатусыФормирование.Добавить(Перечисления.СтатусыПакетовМСД.Подписан2Подписью);
	Запрос.УстановитьПараметр("СтатусыФормирование", МассивСтатусыФормирование);

	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Пустой() И НЕ Объект.ПометкаУдаления;

КонецФункции    	

&НаСервереБезКонтекста
Функция ПолучитьТабличныйДокументИзХранилища(ПараметрыПроцедуры, УникальныйИдентификатор) 
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);  
	
	МодульДлительныеОперации = ОбщегоНазначения.ОбщийМодуль("ДлительныеОперации");
	ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "ПолучитьТабличныйДокументИзХранилищаФоновое";
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ДополнительныйРезультат = Ложь;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.АдресРезультата = АдресРезультата;
	
	РезультатФоновогоЗадания = МодульДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, "Документы.ПакетыДанныхДляМСД.ПолучитьТабличныйДокументИзХранилища", ПараметрыПроцедуры, АдресРезультата);
	
	Возврат РезультатФоновогоЗадания;

КонецФункции	

&НаКлиенте
Асинх Процедура ПолучитьТабличныйДокументИзХранилищаЗавершение(Результат, ДопПараметры) Экспорт 
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда		
		ЭтотОбъект["ТабДок" + ДопПараметры.ИмяДокумента] = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда		
		ПоказатьПредупреждение(, Результат.ПодробноеПредставлениеОшибки);		
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ЗапуститьФоновоеЗаданиеПолученияТабДокумента(ПараметрыПроцедуры) 
	
	РезультатЗадания = ПолучитьТабличныйДокументИзХранилища(ПараметрыПроцедуры, УникальныйИдентификатор);
	
	МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
	
	ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ПолучитьТабличныйДокументИзХранилищаЗавершение", ЭтотОбъект, ПараметрыПроцедуры);
	
	МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьФоновоеЗаданиеФормированияТабДокументов(ПараметрыПроцедуры) 
	
	РезультатЗадания = СформироватьТабличныеДокументы(ПараметрыПроцедуры, УникальныйИдентификатор);
	
	МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
	
	ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("СформироватьТабличныеДокументыЗавершение", ЭтотОбъект, ПараметрыПроцедуры);
	
	МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Асинх Процедура СформироватьТабличныеДокументыЗавершение(Результат, ДопПараметры) Экспорт 
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		Прочитать();
		
		Оповещение = Новый ОписаниеОповещения("ПоказатьВопросСверкаЗавершение", ЭтотОбъект);
		ТекстВопроса = НСтр("ru='Формирование пакета данных для МСД завершено. 
		|Выполнить сверку данных сформированного пакета с учетными данными БГУ?'");
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да, НСтр("ru='Да'"));
		СписокКнопок.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='Нет'"));
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, СписокКнопок);
			
	ИначеЕсли Результат.Статус = "Ошибка" Тогда		
		ПоказатьПредупреждение(, Результат.ПодробноеПредставлениеОшибки);		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьТабличныеДокументы(ПараметрыПроцедуры, УникальныйИдентификатор) 
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);  
	
	МодульДлительныеОперации = ОбщегоНазначения.ОбщийМодуль("ДлительныеОперации");
	ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "СформироватьТабличныеДокументыМСД";
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ДополнительныйРезультат = Ложь;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.АдресРезультата = АдресРезультата;
	
	РезультатФоновогоЗадания = МодульДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, "Документы.ПакетыДанныхДляМСД.СформироватьТабличныеДокументы", ПараметрыПроцедуры, АдресРезультата);
	
	Возврат РезультатФоновогоЗадания;

КонецФункции		

&НаКлиенте
Процедура ОбновитьДинамическиеСписки()  	
	Элементы.СтатусыПереданныхПакетов.Обновить();
	Элементы.СведенияОПротоколах.Обновить();
	Элементы.ИсторияОбмена.Обновить();
КонецПроцедуры  

&НаСервере
Функция ПолучитьОтчетныеПериоды()
	
	ОтчетныйПериодСписок.Очистить();
	УсловиеОперативныеДанные = ?(НЕ Объект.ВидПередаваемыхДанных, "НЕ", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПериодыМСД.Ссылка КАК ПериодМСД
	|ИЗ
	|	РегистрСведений.СведенияОСрокахПредоставленияДанныхМСД КАК СведенияОСрокахПредоставленияДанныхМСД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПериодыМСД КАК ПериодыМСД
	|		ПО СведенияОСрокахПредоставленияДанныхМСД.ПериодДанных = ПериодыМСД.Ссылка
	|ГДЕ
	|	ГОД(ПериодыМСД.ДатаНачала) = &Год
	|	И СведенияОСрокахПредоставленияДанныхМСД.Организация = &Организация
	|	И " + УсловиеОперативныеДанные + " ПериодыМСД.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.Месяц)";
	
	Запрос.УстановитьПараметр("Год", Год(Объект.Год));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		УстановитьВидимостьСрок(Ложь);
	Иначе
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ОтчетныйПериодСписок.Добавить(ВыборкаДетальныеЗаписи.ПериодМСД);		
		КонецЦикла;
		УстановитьВидимостьСрок(Истина);
	КонецЕсли;	
		
КонецФункции 

&НаКлиенте
Процедура ГодПриИзменении(Элемент)
	ОчиститьЗависимыеПоляПериода();
	ПолучитьОтчетныеПериоды();
КонецПроцедуры 

&НаКлиенте
Процедура ОчиститьЗависимыеПоляПериода()
	ОтчетныйПериод = "Не выбран";  
	СрокПредоставления = Неопределено;
	Объект.НачалоПериода = Неопределено; 
	Объект.ОкончаниеПериода = Неопределено;
	Объект.ВерсияТаксономии = Неопределено;
	Объект.ДатаУтвержденияТаксономии = Неопределено;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДанныеФайла()
	
	ДанныеФайла = Новый Структура;
	ДанныеФайла.Вставить("Пакет", Объект.Ссылка);
	ДанныеФайла.Вставить("Организация", Объект.Организация);
	ДанныеФайла.Вставить("ИмяПакета", ИмяПакета);
	ДанныеФайла.Вставить("ВидПередаваемыхДанных", Объект.ВидПередаваемыхДанных); 
	ДанныеФайла.Вставить("ИдентификаторПакета", ИдентификаторПакета);
	ДанныеФайла.Вставить("ПериодСтрокой", ОтчетныйПериод);
	ДанныеФайла.Вставить("СпособПередачи", Объект.СпособПередачи);
	ДанныеФайла.Вставить("ПолноеИмяФайла", ИмяФайлаВыгрузки);
	Возврат ДанныеФайла;
	
КонецФункции	

&НаСервере
Процедура УстановитьСтатусНаСервере(Пакет, Статус)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(ПакетыДанныхМСДСрезПоследних.Период) КАК Период,
		|	ПакетыДанныхМСДСрезПоследних.Пакет КАК Пакет
		|ПОМЕСТИТЬ ВТПакетыСрез
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД.СрезПоследних(, Пакет = &Пакет) КАК ПакетыДанныхМСДСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	ПакетыДанныхМСДСрезПоследних.Пакет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПакетыДанныхМСД.Организация КАК Организация,
		|	ПакетыДанныхМСД.Пакет КАК Пакет,
		|	ПакетыДанныхМСД.ИдентификаторПакета КАК ИдентификаторПакета,
		|	ПакетыДанныхМСД.ДатаФормирования КАК ДатаФормирования,
		|	ПакетыДанныхМСД.ИмяПакета КАК ИмяПакета,
		|	ПакетыДанныхМСД.ВидПередаваемыхДанных КАК ВидПередаваемыхДанных,
		|	ПакетыДанныхМСД.ПериодСтрокой КАК ПериодСтрокой,
		|	ПакетыДанныхМСД.КонтрольнаяСумма КАК КонтрольнаяСумма,
		|	ПакетыДанныхМСД.СпособПередачи КАК СпособПередачи,
		|	ПакетыДанныхМСД.ПолноеИмяФайла КАК ПолноеИмяФайла,
		|	ПакетыДанныхМСД.ИдентификаторСообщения КАК ИдентификаторСообщения
		|ИЗ
		|	ВТПакетыСрез КАК ВТПакетыСрез
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|		ПО ВТПакетыСрез.Период = ПакетыДанныхМСД.Период
		|			И ВТПакетыСрез.Пакет = ПакетыДанныхМСД.Пакет";
	
	Запрос.УстановитьПараметр("Пакет", Пакет);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Запись = РегистрыСведений.ПакетыДанныхМСД.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, ВыборкаДетальныеЗаписи);
		Запись.Период 					= УниверсальноеВремя(ТекущаяДатаСеанса());
		Запись.Статус 					= Перечисления.СтатусыПакетовМСД[Статус];
		Запись.ДатаСтатуса 				= УниверсальноеВремя(ТекущаяДатаСеанса());
		Запись.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатус(Команда)
	УстановитьСтатусНаСервере(Объект.Ссылка, СтрЗаменить(Команда.Имя, "УстановитьСтатус", ""));
	УстановитьВидимость();
	Элементы.СтатусыПереданныхПакетов.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ПроизвестиСверкуБГУ(Команда)	
	НаименованиеЗадания = НСтр("ru = 'Сопоставление файлов для вывода протокола сверки.'");
	ЗапуститьСверкуСДаннымиУчета("ПроизвестиСверкуБГУ_Завершено", НаименованиеЗадания);	
КонецПроцедуры

&НаСервере
Функция ВыполнитьФоновоеЗаданиеНаСервере(АдресФайлаНаСервере, ПараметрыВыполнения, НаименованиеЗадания, УникальныйИдентификатор)
			
	ФайлНайден = ЗаполнитьДанныеФайлаВПараметрахВыполнения(ПараметрыВыполнения);
	
	Если НЕ ФайлНайден Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	ФайлКорректный = ПроверитьИмяФайла(ПараметрыВыполнения);
	
	Если Не ФайлКорректный Тогда
		Возврат Неопределено;
	КонецЕсли;
			
	ТекстСообщения = НСтр("ru = 'Запуск фонового задания сверки учетных данных с пакетом данных в БГУ.'");
						
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ИмяМетода", "ПроизвестиСверкуБГУ");
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыВыполнения);
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Ложь);
	ПараметрыЗадания.Вставить("ИмяОбработки", "СверкаУчетныхДанныхМСД_БезАналитик");
	
	МодульДлительныеОперации = ОбщегоНазначения.ОбщийМодуль("ДлительныеОперации");
	ПараметрыВыполненияФоновойОперации = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполненияФоновойОперации.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	
	ЗаписьСобытияВЖурналРегистрации(ТекстСообщения);
	
	РезультатФоновогоЗадания = МодульДлительныеОперации.ВыполнитьВФоне("ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки", ПараметрыЗадания,
		ПараметрыВыполненияФоновойОперации);
		
	Возврат РезультатФоновогоЗадания;
	
КонецФункции 

&НаСервере
Функция ЗаполнитьДанныеФайлаВПараметрахВыполнения(ПараметрыВыполнения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПакетыДанныхДляМСДПрисоединенныеФайлы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПакетыДанныхДляМСДПрисоединенныеФайлы КАК ПакетыДанныхДляМСДПрисоединенныеФайлы
	|ГДЕ
	|	ПакетыДанныхДляМСДПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайлов
	|	И НЕ ПакетыДанныхДляМСДПрисоединенныеФайлы.ПометкаУдаления
	|	И ПОДСТРОКА(ПакетыДанныхДляМСДПрисоединенныеФайлы.Наименование, 1, 8) <> ""Протокол""
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПакетыДанныхДляМСДПрисоединенныеФайлы.ДатаСоздания УБЫВ";
	
	Запрос.УстановитьПараметр("ВладелецФайлов", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		МодульРаботаСФайламиКлиентСервер = ОбщегоНазначения.ОбщийМодуль("РаботаСФайламиКлиентСервер");
		ПараметрыДанныхФайла = МодульРаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
		ПараметрыДанныхФайла.ПолучатьСсылкуНаДвоичныеДанные = Истина;
		
		МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
		СведенияОФайле = МодульРаботаСФайлами.ДанныеФайла(Выборка.Ссылка, ПараметрыДанныхФайла);
		
		Если СведенияОФайле = Неопределено Тогда
			ТекстСообщения = НСтр(
				"ru = 'По ссылке на присоединенный файл в документе ""Пакет данных для МСД"" отсутствует сам файл в томе на сервере.
				|Обработка прервана.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(СведенияОФайле.СсылкаНаДвоичныеДанныеФайла);
		
		ПараметрыВыполнения.Вставить("ИмяАрхива", СведенияОФайле.ИмяФайла);
		ПараметрыВыполнения.Вставить("ДДАрхива", Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(7)));
		
		УдалитьИзВременногоХранилища(СведенияОФайле.СсылкаНаДвоичныеДанныеФайла);
		Возврат Истина;
		
	Иначе
		
		ТекстСообщения = НСтр(
			"ru = 'В документе ""Пакет данных для МСД"" отсутствует актуальный файл для сверки. Обработка прервана.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
		
	КонецЕсли;
		
КонецФункции 

&НаКлиенте
Процедура ПроизвестиСверкуБГУ_Завершено(Результат, ДополнительныеПараметры) Экспорт
	
	ТекстСообщения = НСтр("ru = 'Окончание задания сверки учетных данных с пакетом данных БГУ.'");
	ЗаписьСобытияВЖурналРегистрации(ТекстСообщения);
	
	Если Результат = Неопределено Тогда
		Возврат;
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
	ИначеЕсли Результат.Статус = "Выполнено" Тогда
		
		ПроизвестиСверкуБГУНаСервере_ВыполнитьЗавершающиеПроцедуры();
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПроизвестиСверкуБГУНаСервере_ВыполнитьЗавершающиеПроцедуры()
	
	Если Не ЭтоАдресВременногоХранилища(АдресРезультатаПротокола) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураРезультат = ПолучитьИзВременногоХранилища(АдресРезультатаПротокола);
	
	ТабличныйДокумент = СтруктураРезультат.ТабличныйДокумент;
	АдресРасшифровкиПротоколаСверки = СтруктураРезультат.ДанныеРасшифровки;
	АдресТаблицаРезультат = СтруктураРезультат.ТаблицаРезультатВХранилище;
	
	СтруктураОткрытияФормыПросмотра = Новый Структура;
	СтруктураОткрытияФормыПросмотра.Вставить("АдресДокумента", ПоместитьВоВременноеХранилище(ТабличныйДокумент,
		УникальныйИдентификатор));
	СтруктураОткрытияФормыПросмотра.Вставить("Расшифровывать", Ложь);
	СтруктураОткрытияФормыПросмотра.Вставить("Заголовок", НСтр("ru = 'Протокол сверки данных учета БГУ и файла выгрузки'"));
	
	ИмяОткрытияФормы = "Обработка.СверкаУчетныхДанныхМСД_БезАналитик.Форма.ПросмотрТабличногоДокумента";
	ОткрытьФорму(ИмяОткрытияФормы, СтруктураОткрытияФормыПросмотра, ЭтотОбъект, Новый УникальныйИдентификатор);
		
КонецПроцедуры  

&НаСервере
Функция ПроверитьИмяФайла(ПараметрыВыполнения)
		
	ЧастиИмени = СтрРазделить(ПараметрыВыполнения.ИмяАрхива, "_");
	Если ЧастиИмени.Количество() <> 6 Тогда
		
		Шаблон = НСтр("ru = 'Имя файла %1 не соответствует формату. Обработка прервана.'");
		ТекстСообщения = СтрШаблон(Шаблон, ПараметрыВыполнения.ИмяАрхива);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Возврат Ложь;
		
	КонецЕсли;
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыВыполнения.ТекущаяОрганизация,
		"НаименованиеСокращенное, КодПоРПБС");
	
	Если РеквизитыОрганизации.КодПоРПБС <> ЧастиИмени[1] Тогда
		
		ТекстСообщения = НСтр("ru = 'Код РПБС в имени файла не соответствует коду в базе БГУ. Обработка прервана.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ПараметрыВыполнения.Вставить("Организация", РеквизитыОрганизации.КодПоРПБС);
	ПараметрыВыполнения.Вставить("НаименованиеОрганизации", РеквизитыОрганизации.НаименованиеСокращенное);
			   
	ОтчетныйПериодСсылка = ПолучитьСсылкуНаПериод(ЧастиИмени);
	ПараметрыВыполнения.Период = ОтчетныйПериодСсылка;
	
	Возврат Истина;
	
КонецФункции  

&НаСервереБезКонтекста
Процедура ЗаписьСобытияВЖурналРегистрации(ТекстСообщения)
	
	ЗаписьЖурналаРегистрации("ДополнительныеОтчетыОбработки.СверкаУчетныхДанныхМСД", УровеньЖурналаРегистрации.Информация, , ,
		ТекстСообщения);
	
КонецПроцедуры 
	
&НаКлиенте
Процедура ПоказатьВопросСверкаЗавершение(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПроизвестиСверкуБГУ(Неопределено);
	КонецЕсли;	
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьСсылкуНаПериод(ЧастиИмени)
	
	ПризнакВидаДанных = ЧастиИмени[2];
	ПериодДанных = ЧастиИмени[3];
	ПризнакЭП = ЧастиИмени[4];
	
	ВидПередаваемыхДанных = (ПризнакВидаДанных = "1") Или (ПризнакВидаДанных = "3");
	
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	ВидПериода = ?(ВидПередаваемыхДанных, 
	МодульОбщегоНазначенияКлиентСервер.МассивЗначений(ПредопределенноеЗначение("Перечисление.ПериодичностьМСД.Месяц")),
	МодульОбщегоНазначенияКлиентСервер.МассивЗначений(ПредопределенноеЗначение("Перечисление.ПериодичностьМСД.Декада"), ПредопределенноеЗначение("Перечисление.ПериодичностьМСД.ПроизвольныйПериод")));	
	
	Если СтрДлина(ПериодДанных) = 6 Тогда
		// Отчетные данные. Указывается год и месяц, например 202403
		ГодМесяц = ПериодДанных;
		
		НачалоПериодаСтрока = ГодМесяц + "01";
		
		НачалоПериода	= Дата(НачалоПериодаСтрока);
		КонецПериода	= КонецМесяца(НачалоПериода);
		
	ИначеЕсли СтрДлина(ПериодДанных) = 17 Тогда
		// Отчетные данные. Указывается год и месяц и день начала и год и месяц и день окончания, например 20240801-20240804
		ЧастиДатыОперативные = СтрРазделить(ПериодДанных, "-");
		
		НачалоПериода = Дата(ЧастиДатыОперативные[0]);
		КонецПериода = Дата(ЧастиДатыОперативные[1]);
		
		Если КонецПериода >= Дата(2026,1,1) Тогда
			ВидПериода = Неопределено;
		КонецЕсли;
		
	ИначеЕсли СтрДлина(ПериодДанных) = 13 Тогда
		// Корректировка (перезагрузка) данных за прошлые периоды. Указывается год и месяц начала и год и месяц окончания, например 202407-202410
		ЧастиДатыОтчетные = СтрРазделить(ПериодДанных, "-");
		
		НомерПакетаВПачке = Число(Лев(ЧастиИмени[5], 2));
		
		Если ЧастиДатыОтчетные.Количество() < 2 Тогда
			ВызватьИсключение "Имя файла не соответствует формату.";
		Иначе
			ГодМесяцНачало = ЧастиДатыОтчетные[0];
			ГодМесяцОкончание = ЧастиДатыОтчетные[1];
			
			ДатаГодМесяцНачало = Дата(ГодМесяцНачало+"01");
			
			НачалоПериода = ДобавитьМесяц(ДатаГодМесяцНачало, НомерПакетаВПачке-1);
			КонецПериода = КонецМесяца(НачалоПериода);
		КонецЕсли;
	
	КонецЕсли;
	
	ПериодСсылка = Неопределено;
	
	Если ЗначениеЗаполнено(НачалоПериода) И ЗначениеЗаполнено(КонецПериода) Тогда
		МодульОбщегоНазначенияМСД = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияМСД");
		ПериодСсылка = МодульОбщегоНазначенияМСД.НайтиОтчетныйПериод(ВидПериода, НачалоПериода, КонецПериода);
	КонецЕсли;
	
	Возврат ПериодСсылка;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьМассивФайловИПроверитьПодписание(Организация, Ссылка)
	
	МодульСтроковыеФункцииКлиентСервер = ОбщегоНазначения.ОбщийМодуль("СтроковыеФункцииКлиентСервер");
	МассивФайлов = ИнтеграцииЕСМВСМЭВ.ПолучитьМассивФайловПакета(Организация, Ссылка);
	Для каждого СтрокаФайл Из МассивФайлов Цикл
		СуффиксПодписи = 0;
		ЕстьПодпись = Ложь; 

		ДДХранилище = ПолучитьДвоичныеДанныеФайла(СтрокаФайл.ДанныеВыборки.Ссылка);				
		ЗначениеХранилища = ПолучитьИзВременногоХранилища(ДДХранилище);
	
		МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
		КаталогФайлов = МодульОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ПолучитьИмяВременногоФайла()).Путь + Новый УникальныйИдентификатор() + ПолучитьРазделительПути();
		СоздатьКаталог(КаталогФайлов);
		
		Если ТипЗнч(ЗначениеХранилища) = Тип("ДвоичныеДанные") Тогда 
			
			ДДАрхива = ЗначениеХранилища;
			
			Поток = ДДАрхива.ОткрытьПотокДляЧтения();
			ЧтениеZip = Новый ЧтениеZipФайла(Поток);
			ЧтениеZip.ИзвлечьВсе(КаталогФайлов); 
			
			Для Каждого  ЭлементZipАрхива Из ЧтениеZip.Элементы Цикл
				ЕстьПодпись =  (ЭлементZipАрхива.Расширение = "p7s");
				Если ЕстьПодпись Тогда
					СуффиксЗначение = Прав(ЭлементZipАрхива.ИмяБезРасширения, 1);
					Если СтрНайти(ЭлементZipАрхива.ИмяБезРасширения, "Header") И МодульСтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СуффиксЗначение) Тогда				 
						Если Число(СуффиксЗначение) > СуффиксПодписи Тогда
							СуффиксПодписи = Число(СуффиксЗначение);	
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;
				
			ЧтениеZip.Закрыть();
			Поток.Закрыть();
		КонецЕсли;
		
		СтрокаФайл.ДанныеВыборки.Вставить("СуффиксПодписи", СуффиксПодписи);
		
		УдалитьИзВременногоХранилища(ДДХранилище);
		УдалитьФайлы(КаталогФайлов);

	КонецЦикла;
	Возврат МассивФайлов;
КонецФункции	

&НаСервере
Процедура ПроверитьПодписиПакета(НаборДанных, ПроверкаПройдена, КоличествоПодписей)
	
	ПодписанРанее = Ложь;  
	ТаблицаПодписи = Новый ТаблицаЗначений;
	ТаблицаПодписи.Колонки.Добавить("ИмяФайла", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	ТаблицаПодписи.Колонки.Добавить("Отпечаток", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	
	СоответствиеПодписываемыхФайлов = Новый Соответствие;
	МодульЭлектроннаяПодпись = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодпись");
	
	Для Каждого ЭлДанных Из НаборДанных Цикл
		ЕстьПодпись = СтрНайти(ЭлДанных.Представление, "_p7s");
		Если ЕстьПодпись Тогда
			ПодписанРанее = Истина;
			СтрокаПодпись = ТаблицаПодписи.Добавить();
			МассивИмя = СтрРазделить(ЭлДанных.Представление, "_");
			Если МассивИмя.Количество() < 3 Тогда
				ИмяФайла = СтрЗаменить(ЭлДанных.Представление, "_p7s", "");
			Иначе	
				Для Итерация = 1 По 2 Цикл
					МассивИмя.Удалить(МассивИмя.Количество() - 1);	
				КонецЦикла;	
				ИмяФайла = СтрСоединить(МассивИмя, "_");
			КонецЕсли;
			СтрокаПодпись.ИмяФайла = ИмяФайла;
			
			Если ЭтоАдресВременногоХранилища(ЭлДанных.Данные) Тогда
				ДДПодпись = ПолучитьИзВременногоХранилища(ЭлДанных.Данные);
			Иначе
				ДДПодпись = ЭлДанных.Данные;
			КонецЕсли;

			СвойстваПодписи = МодульЭлектроннаяПодпись.СвойстваПодписи(ДДПодпись);
			СтрокаПодпись.Отпечаток = СвойстваПодписи.Отпечаток;
		Иначе
			ОтпечатокТекущий = "";
			Если ЭлДанных.Свойство("СвойстваПодписи") Тогда
				ОтпечатокТекущий = ЭлДанных.СвойстваПодписи.Отпечаток;
				Если НЕ ЗначениеЗаполнено(ОтпечатокТекущий) Тогда
					ОтпечатокТекущий = МодульЭлектроннаяПодпись.СвойстваПодписи(ЭлДанных.СвойстваПодписи.Подпись).Отпечаток;	
				КонецЕсли;	
			КонецЕсли;	
			СоответствиеПодписываемыхФайлов.Вставить(ЭлДанных.Представление, ОтпечатокТекущий);
		КонецЕсли;	
	КонецЦикла; 
	
	ТаблицаПодписи.Сортировать("Отпечаток");
	ИдентификаторПодписи = "";
	МассивПодписей = Новый Массив;
	ИмяФайлаШаблон = "";
	Если ПодписанРанее Тогда
		ПерваяИтерация = Истина;
		Для каждого СтрокаФайл Из СоответствиеПодписываемыхФайлов Цикл
			СтрокиПоИмениФайла = ТаблицаПодписи.НайтиСтроки(Новый Структура("ИмяФайла", СтрЗаменить(СтрокаФайл.Ключ, ".xml", "")));
			Если ПерваяИтерация Тогда
				КоличествоПодписей = СтрокиПоИмениФайла.Количество(); 
				ИмяФайлаШаблон = СтрокаФайл.Ключ;
				Для каждого СтрокаПодписи Из СтрокиПоИмениФайла Цикл
					ИдентификаторПодписи = ИдентификаторПодписи + СтрокаПодписи.Отпечаток;
					МассивПодписей.Добавить(СтрокаПодписи.Отпечаток);
				КонецЦикла;	
				ПерваяИтерация = Ложь;
				Продолжить;
			КонецЕсли;
			Если НЕ СтрокиПоИмениФайла.Количество() = КоличествоПодписей Тогда
				ТекстСообщения = СтрШаблон(НСтр("ru='Пакет не может быть подписан. Количество ЭП проверяемого файла %1 отличается от количества ЭП файла %2.'", ОбщегоНазначения.КодОсновногоЯзыка()), СтрокиПоИмениФайла.ИмяФайла, ИмяФайлаШаблон);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				ПроверкаПройдена = Ложь;
				Прервать;
			Иначе
			    ИдентификаторПодписиТекущий = "";
				Для каждого СтрокаПодписи Из СтрокиПоИмениФайла Цикл
					ИдентификаторПодписиТекущий = ИдентификаторПодписиТекущий + СтрокаПодписи.Отпечаток;
				КонецЦикла; 
				
				Если НЕ ИдентификаторПодписи = ИдентификаторПодписиТекущий Тогда
					ТекстСообщения = СтрШаблон(НСтр("ru='Пакет не может быть подписан. Отпечатки ЭП проверяемого файла %1 отличаются от отпечатков ЭП файла %2.'", ОбщегоНазначения.КодОсновногоЯзыка()), СтрокаФайл.Ключ, ИмяФайлаШаблон);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					ПроверкаПройдена = Ложь;
					Прервать;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура ОбработатьОшибкуФормирования(ДопПараметры)
	
	ДопПараметры.ДанныеФайла.Вставить("Статус", Перечисления.СтатусыПакетовМСД.ОшибкаОбработки);
	СформироватьЗаписьВРегистр("", ДопПараметры.ДанныеФайла)
			
КонецПроцедуры

&НаСервере
Функция ПроверитьКоличествоПрисоединенныхФайлов()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПакетыДанныхДляМСДПрисоединенныеФайлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПакетыДанныхДляМСДПрисоединенныеФайлы КАК ПакетыДанныхДляМСДПрисоединенныеФайлы
		|ГДЕ
		|	ПакетыДанныхДляМСДПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
		|	И НЕ ПакетыДанныхДляМСДПрисоединенныеФайлы.ПометкаУдаления
		|	И ПакетыДанныхДляМСДПрисоединенныеФайлы.Расширение = ""zip""";
	
	Запрос.УстановитьПараметр("ВладелецФайла", Объект.Ссылка);
	
	ФайлыПакета = Запрос.Выполнить().Выгрузить();
	Возврат ФайлыПакета.Количество() > 1;  
	
КонецФункции	

Функция ПолучитьФайлыПакетаСУчетомПомеченных(Организация, Пакет, ПолучитьРезультатЗапроса)
	
	УсловияПакета = ЗначениеЗаполнено(Пакет);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	СтрШаблон("ВЫБРАТЬ
	|	ПакетыДанныхМСД.Пакет КАК Пакет,
	|	МАКСИМУМ(ПакетыДанныхМСД.ДатаФормирования) КАК ДатаФормирования
	|ПОМЕСТИТЬ ВТ_ПакетыФормирование
	|ИЗ
	|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД,
	|	Константа.ПодписыватьОперативныеДанныеДляМСД КАК ПодписыватьОперативныеДанныеДляМСД,
	|	Константа.ПодписыватьОтчетныеДанныеДляМСД КАК ПодписыватьОтчетныеДанныеДляМСД
	|ГДЕ
	|	ПакетыДанныхМСД.Организация = &Организация
	|   %1
	|
