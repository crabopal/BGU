&НаКлиенте
Процедура ПолучитьОтветПротокол(Команда)
	Если ИнтеграцииЕСМВСМЭВВызовСервера.ОтправлятьФайлыНаКлиенте() Тогда
		ИнтеграцииЕСМВСМЭВКлиент.ПолучитьОтветыИзОчередиЕСМВ(Объект.Организация, "СтатусПакета", ЭтаФорма);
	Иначе
		ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьОтветыИзОчередиЕСМВ(Объект.Организация, "СтатусПакета");
		ОбновитьДинамическиеСписки();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаличиеПереданныхОтчетныхДанных()

	Если Объект.ВидПередаваемыхДанных Тогда
		Элементы.ФормаСформироватьВыгрузку.Доступность = Истина;
		Элементы.ФормаГруппаСервис.Доступность = Истина; 
		Элементы.ФормаПодписатьПакет.Доступность = Истина; 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПакетыДанныхДляМСД.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ОтчетныеДанные
		|ИЗ
		|	Документ.ПакетыДанныхДляМСД КАК ПакетыДанныхДляМСД
		|ГДЕ
		|	&ОкончаниеПериода МЕЖДУ ПакетыДанныхДляМСД.НачалоПериода И ПакетыДанныхДляМСД.ОкончаниеПериода
		|	И НЕ ПакетыДанныхДляМСД.ПометкаУдаления
		|	И ПакетыДанныхДляМСД.ВидПередаваемыхДанных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПакетыДанныхМСД.ИдентификаторПакета КАК ИдентификаторПакета
		|ИЗ
		|	ВТ_ОтчетныеДанные КАК ВТ_ОтчетныеДанные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|		ПО ВТ_ОтчетныеДанные.Ссылка = ПакетыДанныхМСД.Пакет
		|ГДЕ
		|	НЕ ПакетыДанныхМСД.Статус В (&СтатусСформирован)";
	
	Запрос.УстановитьПараметр("ОкончаниеПериода", Объект.ОкончаниеПериода);
	СтатусСформированМассив = Новый Массив;
	СтатусСформированМассив.Добавить(Перечисления.СтатусыПакетовМСД.Сформирован);
	СтатусСформированМассив.Добавить(Перечисления.СтатусыПакетовМСД.Формирование);
	СтатусСформированМассив.Добавить(Перечисления.СтатусыПакетовМСД.НаПодписании1Подписью);
	СтатусСформированМассив.Добавить(Перечисления.СтатусыПакетовМСД.НаПодписании2Подписью); 
	СтатусСформированМассив.Добавить(Перечисления.СтатусыПакетовМСД.Подписан1Подписью);
	СтатусСформированМассив.Добавить(Перечисления.СтатусыПакетовМСД.Подписан2Подписью);

	Запрос.УстановитьПараметр("СтатусСформирован", СтатусСформированМассив);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Элементы.ФормаСформироватьВыгрузку.Доступность = Ложь;
		Элементы.ФормаГруппаСервис.Доступность = Ложь;
		Элементы.ФормаПодписатьПакет.Доступность = Ложь; 
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Сведения за отчетный период уже переданы в МСД ПУиО ГИИС ЭБ, сформировать и отправить оперативные сведения за тот же период невозможно.'"));
	КонецЕсли;
	
КонецПроцедуры

