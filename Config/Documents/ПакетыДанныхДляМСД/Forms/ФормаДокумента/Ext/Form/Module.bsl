	Запрос.УстановитьПараметр("Пакет", Пакет);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат ?(ПолучитьРезультатЗапроса, РезультатЗапроса, РезультатЗапроса.Выбрать());

КонецФункции

&НаСервере
Функция ПолучитьМассивФайловСУчетомПомеченных(Организация, Пакет)
	
	МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
	МассивФайлов = Новый Массив;
	РезультатЗапроса = ПолучитьФайлыПакетаСУчетомПомеченных(Организация, Пакет, Истина);
	
	ШаблонДанныеВыборки = Новый Структура;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		ШаблонДанныеВыборки.Вставить(Колонка.Имя);
	КонецЦикла;
	
	ВыборкаФайлы = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаФайлы.Следующий() Цикл 
		УстановитьПривилегированныйРежим(Истина);	
		ФайлОбъект = ВыборкаФайлы.Ссылка.ПолучитьОбъект();
		ФайлОбъект.Заблокировать();
		ФайлОбъект.УстановитьПометкуУдаления(Ложь);
		ФайлОбъект.Записать();
		УстановитьПривилегированныйРежим(Ложь);
		
		ДанныеВыборки = ОбщегоНазначения.СкопироватьРекурсивно(ШаблонДанныеВыборки);
		СтруктураФайла = Новый Структура;
		ФайлВыгрузки = Документы.ПакетыДанныхДляМСД.ПрисоединенныйФайлВыгрузки(ВыборкаФайлы.Пакет, ВыборкаФайлы.ИмяПакета);
		Если НЕ ФайлВыгрузки = Неопределено Тогда
			
			ДД = МодульРаботаСФайлами.ДвоичныеДанныеФайла(ФайлВыгрузки); 
			
			Хеш = Новый ХешированиеДанных(ХешФункция.SHA1);
			Хеш.Добавить(ДД); 
			КонтрольнаяСумма = НРег(СтрЗаменить(Хеш.ХешСумма, " ", ""));
			
			Если НЕ КонтрольнаяСумма = ВыборкаФайлы.КонтрольнаяСумма Тогда 
				Продолжить;	
			КонецЕсли;	
			
			СтруктураФайла.Вставить("ИмяПакета", ВыборкаФайлы.ИмяПакета);
			СтруктураФайла.Вставить("ИдентификаторДокумента", ВыборкаФайлы.ИдентификаторПакета);
			СтруктураФайла.Вставить("ПолноеИмяФайла", ВыборкаФайлы.ПолноеИмяФайла);
			СтруктураФайла.Вставить("ДанныеФайлаBase64", ПолучитьВложениеМТОМВФорматеBase64(ДД));
			ЗаполнитьЗначенияСвойств(ДанныеВыборки, ВыборкаФайлы);
			СтруктураФайла.Вставить("ДанныеВыборки", ДанныеВыборки);
			МассивФайлов.Добавить(СтруктураФайла);
			
		КонецЕсли;	
	КонецЦикла;
	Возврат МассивФайлов;

КонецФункции 

&НаСервере
Функция ПолучитьВложениеМТОМВФорматеBase64(ДД)
	
	СтрокаBase64 = Base64Строка(ДД);
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ПС, "");
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ВК, "");
	
	Возврат СтрокаBase64;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФайлыПакета(Команда)
	ОткрытьФорму("Документ.ПакетыДанныхДляМСД.Форма.ФормаПодписиФайлов", Новый Структура("Пакет", Объект.Ссылка), ЭтотОбъект);	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)	
	ОчиститьЗависимыеПоляПериода();
	ПолучитьОтчетныеПериоды();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСведенияОбОшибках(АдресТаблицаРезультат)
	ТаблицаРезультат = ПолучитьИзВременногоХранилища(АдресТаблицаРезультат); 
	Возврат ТаблицаРезультат.Итог("Ошибка") > 0;	
КонецФункции

&НаКлиенте
Процедура ВыполнитьСверкуПередПодписаниемЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ТекстСообщения = НСтр("ru = 'Окончание задания сверки учетных данных с пакетом данных БГУ.'");
	ЗаписьСобытияВЖурналРегистрации(ТекстСообщения);
	
	Если Результат = Неопределено Тогда
		Возврат;
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
	ИначеЕсли Результат.Статус = "Выполнено" Тогда
		
		ТекстОшибки = НСтр("ru='Не удалось выполнить сверку пакета с данными учета, отправка невозможна.'");
		Если Не ЭтоАдресВременногоХранилища(АдресРезультатаПротокола) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		СтруктураРезультат = ПолучитьИзВременногоХранилища(АдресРезультатаПротокола);
		
		АдресТаблицаРезультат = СтруктураРезультат.ТаблицаРезультатВХранилище;
		Если Не ЭтоАдресВременногоХранилища(АдресТаблицаРезультат) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		ЕстьОшибки = ПолучитьСведенияОбОшибках(АдресТаблицаРезультат);
		Если ЕстьОшибки Тогда
			СтруктураОткрытияФормыПросмотра = Новый Структура;
			СтруктураОткрытияФормыПросмотра.Вставить("АдресДокумента", ПоместитьВоВременноеХранилище(СтруктураРезультат.ТабличныйДокумент,
			УникальныйИдентификатор));
			СтруктураОткрытияФормыПросмотра.Вставить("Расшифровывать", Ложь);			
			СтруктураОткрытияФормыПросмотра.Вставить("Заголовок", НСтр("ru = 'Протокол сверки данных учета БГУ и файла выгрузки'"));
			ИмяОткрытияФормы = "Обработка.СверкаУчетныхДанныхМСД_БезАналитик.Форма.ПросмотрТабличногоДокумента";
			ОткрытьФорму(ИмяОткрытияФормы, СтруктураОткрытияФормыПросмотра, ЭтотОбъект, Новый УникальныйИдентификатор);
			ТекстСообщения =  НСтр("ru='В данных пакета выгрузки найдены отклонения от данных учета. 
			|Необходимо исправить выявленные отклонения и переформировать пакет с данными.'");
			ПоказатьПредупреждение(,ТекстСообщения);
		Иначе
			МассивФайлы = ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьМассивфайловПакета(Объект.Организация, Объект.Ссылка); 
			Если НЕ МассивФайлы.Количество() Тогда
				МассивФайлы = ПолучитьМассивФайловСУчетомПомеченных(Объект.Организация, Объект.Ссылка);
				Если НЕ МассивФайлы.Количество() Тогда 
					ТекстСообщения = НСтр("ru='В присоединенных файлах не найдены архивы к подписанию.'");
					ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);	
				КонецЕсли;	
			КонецЕсли;	
			Для каждого СтрокаФайл Из МассивФайлы Цикл	
				ИмяПакета = ПреобразоватьИмяФайлаВыгрузки(СтрокаФайл.ИмяПакета);
				Если НЕ ЗначениеЗаполнено(ИмяПакета) Тогда
					Возврат;	
				КонецЕсли;	
				ИмяФайлаВыгрузки =  СтрШаблон("%1.zip", ИмяПакета); 
				ДДХранилище = ПолучитьДвоичныеДанныеФайла(СтрокаФайл.ДанныеВыборки.Ссылка);		
				СтрокаФайл.ДанныеВыборки.Вставить("ИмяПакета", ИмяПакета);
				СтрокаФайл.ДанныеВыборки.Вставить("ПолноеИмяФайла", ИмяФайлаВыгрузки);
				ПодписатьВыгрузкуКлиент(ДДХранилище, СтрокаФайл);		
			КонецЦикла;			
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗапуститьСверкуСДаннымиУчета(ИмяПроцедурыЗавершения, НаименованиеЗадания)
	
	АдресРасшифровкиПротоколаСверки = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	АдресРезультатаПротокола = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	АдресТаблицаРезультат = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("АдресРасшифровкиПротоколаСверки", АдресРасшифровкиПротоколаСверки);
	ПараметрыВыполнения.Вставить("АдресРезультатаПротокола", АдресРезультатаПротокола);
	ПараметрыВыполнения.Вставить("АдресТаблицаРезультат", АдресТаблицаРезультат);
	ПараметрыВыполнения.Вставить("Период", Неопределено);
	ПараметрыВыполнения.Вставить("ОбработкаВКонфигурации", Истина);
	ПараметрыВыполнения.Вставить("СРасшифровкой", Истина);
	ПараметрыВыполнения.Вставить("СпособСравнения", Ложь);
	ПараметрыВыполнения.Вставить("СальдоССубконто", Истина);
	ПараметрыВыполнения.Вставить("ТекущаяОрганизация", Объект.Организация);
						
	АдресФайлаОбработки = "";
	
	РезультатФоновогоЗадания = ВыполнитьФоновоеЗаданиеНаСервере(АдресФайлаОбработки, ПараметрыВыполнения,
		НаименованиеЗадания, УникальныйИдентификатор);
	
	Оповещение = Новый ОписаниеОповещения(ИмяПроцедурыЗавершения, ЭтотОбъект, ПараметрыВыполнения);
	
	МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");

	ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.Интервал = 1;
	ПараметрыОжидания.ТекстСообщения = НаименованиеЗадания;
	
	МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатФоновогоЗадания, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры	

&НаКлиенте
Процедура ВыполнитьСверкуПередСохранениемЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекстСообщения = НСтр("ru = 'Окончание задания сверки учетных данных с пакетом данных БГУ.'");
	ЗаписьСобытияВЖурналРегистрации(ТекстСообщения);
	
	Если Результат = Неопределено Тогда
		Возврат;
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
	ИначеЕсли Результат.Статус = "Выполнено" Тогда
		
		ТекстОшибки = НСтр("ru='Не удалось выполнить сверку пакета с данными учета, сохранение невозможно.'");
		Если Не ЭтоАдресВременногоХранилища(АдресРезультатаПротокола) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		СтруктураРезультат = ПолучитьИзВременногоХранилища(АдресРезультатаПротокола);
		
		АдресТаблицаРезультат = СтруктураРезультат.ТаблицаРезультатВХранилище;
		Если Не ЭтоАдресВременногоХранилища(АдресТаблицаРезультат) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		ЕстьОшибки = ПолучитьСведенияОбОшибках(АдресТаблицаРезультат);
		Если ЕстьОшибки Тогда
			СтруктураОткрытияФормыПросмотра = Новый Структура;
			СтруктураОткрытияФормыПросмотра.Вставить("АдресДокумента", ПоместитьВоВременноеХранилище(СтруктураРезультат.ТабличныйДокумент,
			УникальныйИдентификатор));
			СтруктураОткрытияФормыПросмотра.Вставить("Расшифровывать", Ложь);
			СтруктураОткрытияФормыПросмотра.Вставить("Заголовок", НСтр("ru = 'Протокол сверки данных учета БГУ и файла выгрузки'"));
			
			ИмяОткрытияФормы = "Обработка.СверкаУчетныхДанныхМСД.Форма.ПросмотрТабличногоДокумента";
			ОткрытьФорму(ИмяОткрытияФормы, СтруктураОткрытияФормыПросмотра, ЭтотОбъект);
			ТекстСообщения =  НСтр("ru='В данных пакета выгрузки найдены отклонения от данных учета. 
			|Необходимо исправить выявленные отклонения и переформировать пакет с данными.'");
			ПоказатьПредупреждение(,ТекстСообщения);
		Иначе
			ЗапуститьСохранениеПакета();				
		КонецЕсли;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьСохранениеПакета()
	
	МассивДД = СохранитьПакетНаСервере();
	
	Если МассивДД.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Нет файлов доступных для сохранения.'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
		Возврат;
	КонецЕсли;	
	
	#Если ВебКлиент Тогда
		
		Для каждого СтрокаМассив Из МассивДД Цикл
			ИмяФайла = СтрокаМассив.ИмяПакета;
			ДД = ПолучитьИзВременногоХранилища(СтрокаМассив.ДДХранилище);
			Диалог = Новый ПараметрыДиалогаПолученияФайлов;
			НачатьПолучениеФайлаССервера(ДД, ИмяФайла, Диалог);
		КонецЦикла;
		
	#Иначе
		
		Режим = РежимДиалогаВыбораФайла.ВыборКаталога; 
		ДиалогОткрытия = Новый ДиалогВыбораФайла(Режим);    
		ДиалогОткрытия.Каталог = ""; 
		ДиалогОткрытия.МножественныйВыбор = Ложь; 
		ДиалогОткрытия.Заголовок = "Выберите каталог"; 
		
		Если ДиалогОткрытия.Выбрать() Тогда 
			ПутьККаталогу = ДиалогОткрытия.Каталог;
			
			Для каждого СтрокаМассив Из МассивДД Цикл
				ИмяФайла = СтрокаМассив.ИмяПакета;
				ДД = ПолучитьИзВременногоХранилища(СтрокаМассив.ДДХранилище);
				ПолноеИмяФайла = ПутьККаталогу + "\" + ИмяФайла; 
				ДД.Записать(ПолноеИмяФайла);                               
				ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru='Файл сохранен: %1'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()), ПолноеИмяФайла));
			КонецЦикла;
			
		КонецЕсли;  
		
	#КонецЕсли 	
			
КонецПроцедуры	

&НаКлиенте
Процедура СохранитьТабДокПакета(ИмяФайла, ИмяТабДок)
	
	#Если ВебКлиент Тогда
		
		ЭтотОбъект[ИмяТабДок].НачатьЗапись(,ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
		
	#Иначе
		
		Режим = РежимДиалогаВыбораФайла.ВыборКаталога; 
		ДиалогОткрытия = Новый ДиалогВыбораФайла(Режим);    
		ДиалогОткрытия.Каталог = ""; 
		ДиалогОткрытия.МножественныйВыбор = Ложь; 
		ДиалогОткрытия.Заголовок = "Выберите каталог"; 
		
		Если ДиалогОткрытия.Выбрать() Тогда 
			ПутьККаталогу = ДиалогОткрытия.Каталог;			
			ПолноеИмяФайла = ПутьККаталогу + "\" + ИмяФайла; 
			ЭтотОбъект[ИмяТабДок].Записать(ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLSX);                               
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru='Файл сохранен: %1'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()), ПолноеИмяФайла));			
		КонецЕсли;  
		
	#КонецЕсли 
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНадписьСтатусаПодписания()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(ПакетыДанныхМСД.ДатаФормирования) КАК ДатаФормирования,
		|	ПакетыДанныхМСД.Пакет КАК Пакет
		|ПОМЕСТИТЬ ВТ_ПоследнийПакет
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|ГДЕ
		|	ПакетыДанныхМСД.Пакет = &Пакет
		|
		|СГРУППИРОВАТЬ ПО
		|	ПакетыДанныхМСД.Пакет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПакетыДанныхМСД.ДополнительныеДанные КАК ДополнительныеДанные
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПоследнийПакет КАК ВТ_ПоследнийПакет
		|		ПО ПакетыДанныхМСД.Пакет = ВТ_ПоследнийПакет.Пакет
		|			И ПакетыДанныхМСД.ДатаФормирования = ВТ_ПоследнийПакет.ДатаФормирования
		|ГДЕ
		|	ПакетыДанныхМСД.Статус В(&СтатусПодписан)
		|	И ПакетыДанныхМСД.Период > ПакетыДанныхМСД.ДатаФормирования
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПакетыДанныхМСД.Период";
	
	Запрос.УстановитьПараметр("Пакет", Объект.Ссылка);
	СтатусПодписан = Новый Массив;
	СтатусПодписан.Добавить(Перечисления.СтатусыПакетовМСД.Подписан1Подписью);
	СтатусПодписан.Добавить(Перечисления.СтатусыПакетовМСД.Подписан2Подписью);
	Запрос.УстановитьПараметр("СтатусПодписан", СтатусПодписан);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Элементы.ДекорацияПодписан.Заголовок = НСтр("ru='Не подписан'", ОбщегоНазначения.КодОсновногоЯзыка());
		Элементы.ГруппаПодписанГоризонтальная1.Видимость = Ложь;
		Элементы.ГруппаПодписанГоризонтальная2.Видимость = Ложь;
	Иначе
		

		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ПодписьПоПорядку = 0;
		ПодписьВсего = ?(Объект.ВидПередаваемыхДанных, 2, 1);
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ПодписьПоПорядку = ПодписьПоПорядку + 1;
			Элементы["ГруппаПодписанГоризонтальная" + ПодписьПоПорядку].Видимость = Истина;
			Элементы["ДекорацияПодписан" + ПодписьПоПорядку].Заголовок = ВыборкаДетальныеЗаписи.ДополнительныеДанные;
			Если ПодписьПоПорядку = ПодписьВсего Тогда
				Прервать;	
			КонецЕсли;	
		КонецЦикла;
		Элементы.ДекорацияПодписан.Заголовок = СтрШаблон(НСтр("ru='Электронные подписи: %1/%2'", ОбщегоНазначения.КодОсновногоЯзыка()), ПодписьПоПорядку, ПодписьВсего);

	КонецЕсли;

КонецПроцедуры	

&НаКлиенте
Процедура ПоказатьВопросПередПодписаниемЗавершение(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Или Результат = Неопределено Тогда
		Возврат;
	Иначе
		Если Результат = КодВозвратаДиалога.Да Тогда
			НаименованиеЗадания = НСтр("ru = 'Выполняется сверка данных пакета с данными учета перед подписанием.'");
			ЗапуститьСверкуСДаннымиУчета("ВыполнитьСверкуПередПодписаниемЗавершение", НаименованиеЗадания);
		Иначе
			МассивФайлы = ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьМассивфайловПакета(Объект.Организация, Объект.Ссылка); 
			Если НЕ МассивФайлы.Количество() Тогда
				МассивФайлы = ПолучитьМассивФайловСУчетомПомеченных(Объект.Организация, Объект.Ссылка);
				Если НЕ МассивФайлы.Количество() Тогда 
					ТекстСообщения = НСтр("ru='В присоединенных файлах не найдены архивы к подписанию.'");
					ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);	
				КонецЕсли;	
			КонецЕсли;	
			Для каждого СтрокаФайл Из МассивФайлы Цикл	
				ИмяПакета = ПреобразоватьИмяФайлаВыгрузки(СтрокаФайл.ИмяПакета);
				Если НЕ ЗначениеЗаполнено(ИмяПакета) Тогда
					Возврат;	
				КонецЕсли;	
				ИмяФайлаВыгрузки =  СтрШаблон("%1.zip", ИмяПакета); 
				ДДХранилище = ПолучитьДвоичныеДанныеФайла(СтрокаФайл.ДанныеВыборки.Ссылка);		
				СтрокаФайл.ДанныеВыборки.Вставить("ИмяПакета", ИмяПакета);
				СтрокаФайл.ДанныеВыборки.Вставить("ПолноеИмяФайла", ИмяФайлаВыгрузки);
				ПодписатьВыгрузкуКлиент(ДДХранилище, СтрокаФайл);		
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли; 
	
КонецПроцедуры 

#КонецОбласти