Функция СпособПередачиДанныхФайл()
	Возврат Константы.ОсновнойСпособПередачиДанныхВМСД.Получить() = Перечисления.СпособыПередачиДанныхВМСД.Файл;
КонецФункции	

&НаКлиенте
Процедура СохранитьПакет(Команда)
	МассивФайлов = ПолучитьМассивФайловИПроверитьПодписание(Объект.Организация, Объект.Ссылка);
	СохранениеДоступно = Истина;
	Если МассивФайлов.Количество() Тогда
		Для каждого СтрокаФайл Из МассивФайлов Цикл		
			Если НЕ СтрокаФайл.ДанныеВыборки.УсловиеПодписания И НЕ СтрокаФайл.ДанныеВыборки.Подписан Тогда
					СохранениеДоступно = Ложь;
					НаименованиеЗадания = НСтр("ru = 'Выполняется сверка данных пакета с данными учета перед сохранением пакета.'");
					ЗапуститьСверкуСДаннымиУчета("ВыполнитьСверкуПередСохранениемЗавершение", НаименованиеЗадания);	 
			ИначеЕсли  СтрокаФайл.ДанныеВыборки.НовыйПорядок Тогда
				Если СтрокаФайл.ДанныеВыборки.ВидПередаваемыхДанных Тогда
					Если СтрокаФайл.ДанныеВыборки.ПодписыватьОтчетныеДанныеДляМСД И СтрокаФайл.ДанныеВыборки.СуффиксПодписи < 2 Тогда
						СохранениеДоступно = Ложь;
						НаименованиеЗадания = НСтр("ru = 'Выполняется сверка данных пакета с данными учета перед сохранением пакета.'");
						ЗапуститьСверкуСДаннымиУчета("ВыполнитьСверкуПередСохранениемЗавершение", НаименованиеЗадания);
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла; 
	Иначе
		ТекстСообщения = НСтр("ru='Нет файлов доступных для сохранения.'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);  
		Возврат;
	КонецЕсли;
	Если СохранениеДоступно Тогда
		ЗапуститьСохранениеПакета();	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция СохранитьПакетНаСервере()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ПакетыДанныхМСДСрезПоследних.ИмяПакета КАК ИмяПакета,
	|	ПакетыДанныхМСДСрезПоследних.Пакет КАК Пакет,
	|	МАКСИМУМ(ПакетыДанныхМСДСрезПоследних.ДатаФормирования) КАК ДатаФормирования
	|ПОМЕСТИТЬ ВТ_ПакетыСрез
	|ИЗ
	|	РегистрСведений.ПакетыДанныхМСД.СрезПоследних(, Пакет = &Пакет) КАК ПакетыДанныхМСДСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	ПакетыДанныхМСДСрезПоследних.Пакет,
	|	ПакетыДанныхМСДСрезПоследних.ИмяПакета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПакетыДанныхМСДСрезПоследних.Пакет КАК Пакет,
	|	ПакетыДанныхМСДСрезПоследних.ИмяПакета КАК ИмяПакета
	|ИЗ
	|	РегистрСведений.ПакетыДанныхМСД.СрезПоследних(
	|			,
	|			(Пакет, ИмяПакета, ДатаФормирования) В
	|				(ВЫБРАТЬ
	|					ВТ_ПакетыСрез.Пакет КАК Пакет,
	|					ВТ_ПакетыСрез.ИмяПакета КАК ИмяПакета,
	|					ВТ_ПакетыСрез.ДатаФормирования КАК ДатаФормирования
	|				ИЗ
	|					ВТ_ПакетыСрез КАК ВТ_ПакетыСрез)) КАК ПакетыДанныхМСДСрезПоследних
	|ГДЕ
	|	ПакетыДанныхМСДСрезПоследних.Пакет = &Пакет
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаФормирования");
	
	Запрос.УстановитьПараметр("Пакет", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
	МассивДД = Новый Массив;
	Пока Выборка.Следующий() Цикл
		
		ФайлВыгрузки = Документы.ПакетыДанныхДляМСД.ПрисоединенныйФайлВыгрузки(Выборка.Пакет, Выборка.ИмяПакета);
		Если НЕ ФайлВыгрузки = Неопределено Тогда
			ДД = МодульРаботаСФайлами.ДвоичныеДанныеФайла(ФайлВыгрузки);
			СтруктураПакета = Новый Структура("ИмяПакета, ДДХранилище", Выборка.ИмяПакета + ".zip", ПоместитьВоВременноеХранилище(ДД));
			МассивДД.Добавить(СтруктураПакета); 
			Возврат МассивДД;
		КонецЕсли;
		
	КонецЦикла; 
	Возврат МассивДД;
КонецФункции

&НаКлиенте
Процедура ПечатьПротоколаЗагрузки(Команда)
	
	ПериодФормат = Неопределено;
	ТабличныйДокумент = ПечатьНаСервере(ПериодФормат);
	
	Если ТабличныйДокумент <> Неопределено Тогда		
		Если ТипЗнч(ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
			МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");
			КоллекцияПечатныхФорм = МодульУправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("ПротоколЗагрузки");
			ПечатнаяФорма = МодульУправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, "ПротоколЗагрузки");
			ПечатнаяФорма.СинонимМакета = ПериодФормат + ": Протокол загрузки данных";
			ПечатнаяФорма.ТабличныйДокумент = ТабличныйДокумент;
			МодульУправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм);
			
		Иначе
			ФормаПротокола = ПолучитьФорму("Документ.ПакетыДанныхДляМСД.Форма.ФормаПротоколаЗагрузки");
			ФормаПротокола.Заголовок = ПериодФормат;
			Для каждого ЭлементМассива ИЗ ТабличныйДокумент Цикл
				ФормаПротокола["ТабличныйДокумент" + ЭлементМассива.ИмяМакета] = ЭлементМассива.ТабличныйДокумент;
			КонецЦикла;
			ФормаПротокола.Открыть(); 
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПечатьНаСервере(ПериодФормат)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПакетыДанныхДляМСДПрисоединенныеФайлы.Ссылка КАК Ссылка,
	|	ПакетыДанныхДляМСДПрисоединенныеФайлы.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ПакетыДанныхДляМСДПрисоединенныеФайлы КАК ПакетыДанныхДляМСДПрисоединенныеФайлы
	|ГДЕ
	|	ПакетыДанныхДляМСДПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
	|	И ПакетыДанныхДляМСДПрисоединенныеФайлы.Наименование ПОДОБНО ""Протокол_%""
	|	И НЕ ПакетыДанныхДляМСДПрисоединенныеФайлы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПакетыДанныхДляМСДПрисоединенныеФайлы.Наименование";
	
	Запрос.УстановитьПараметр("ВладелецФайла", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();		
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью"); 
	
	Н = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Н = Н + 1;	
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, "НачалоПериода");
		ПериодФормат = Формат(РеквизитыДокумента.НачалоПериода, "ДФ='ММММ yyyy'");
		
		ТабличныйДокумент = Документы.ПакетыДанныхДляМСД.СформироватьТабличныйДокументПротоколСтраницы(ВыборкаДетальныеЗаписи.Ссылка, Объект.Ссылка, ПериодФормат);
		
		Возврат ТабличныйДокумент;
		
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура ПечатьПротоколаПроверки(Команда)
	
	МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");
	ДДХранилище = ПолучитьАдресХранилищаТД();
	ТабличныйДокумент = ПолучитьИзВременногоХранилища(ДДХранилище);
	КоллекцияПечатныхФорм = МодульУправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("ПротоколВыгрузки");
	ПечатнаяФорма = МодульУправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, "ПротоколВыгрузки");
	ПечатнаяФорма.СинонимМакета = "Протокол формирования пакета для выгрузки в МСД ПУиО ГИИС ЭБ";
	ПечатнаяФорма.ТабличныйДокумент = ТабличныйДокумент;
	МодульУправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм);
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьАдресХранилищаТД()
	
	МассивОбъектов = Новый Массив; 
	МассивОбъектов.Добавить(Объект.Ссылка); 
	ТабличныйДокумент = Документы.ПакетыДанныхДляМСД.ПечатьПротокола(МассивОбъектов, Новый Структура, Новый СписокЗначений);
	Возврат ПоместитьВоВременноеХранилище(ТабличныйДокумент); 
	
КонецФункции	

&НаКлиенте
Асинх Процедура ПодписатьДанные_РасшифровкаПодписываемогоФайла(Значение, ДД) Экспорт
	
	#Если ВебКлиент Тогда
		Результат = Ждать ПодключитьРасширениеРаботыСФайламиАсинх();
		Если Не Результат Тогда
			Сообщить("Необходимо установить расширение работы с файлами 1С:Предприятие 8.");
			Сообщить("Установить расширение можно в разделе Мои настройки (Главное - Мои настройки).");
			Возврат;
		КонецЕсли;		
	#КонецЕсли
	
	КаталогВременныхФайлов = Ждать КаталогВременныхФайловАсинх();
	ИмяВременногоФайла = СтрШаблон("%1%2.xml", КаталогВременныхФайлов, Строка(Новый УникальныйИдентификатор));
	Если ЭтоАдресВременногоХранилища(ДД) Тогда
		ДД = ПолучитьИзВременногоХранилища(ДД);	
	КонецЕсли;
	Результат = Ждать ДД.ЗаписатьАсинх(ИмяВременногоФайла);
	Результат = Ждать ЗапуститьПриложениеАсинх(ИмяВременногоФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьПакет(Команда)		
	Если ПакетПодписанПервойПодписью(Объект.Ссылка) Тогда
		Оповещение = Новый ОписаниеОповещения("ПоказатьВопросПередПодписаниемЗавершение", ЭтотОбъект);
		ТекстВопроса = НСтр("ru='Выполнить сверку данных пакета выгрузки в МСД с данными учета перед подписанием?'");
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да, НСтр("ru='Да, выполнить сверку'"));
		СписокКнопок.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='Нет, продолжить подписание'"));
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru='Отмена'"));
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, СписокКнопок);	
	Иначе
		НаименованиеЗадания = НСтр("ru = 'Выполняется сверка данных пакета с данными учета перед подписанием.'");
		ЗапуститьСверкуСДаннымиУчета("ВыполнитьСверкуПередПодписаниемЗавершение", НаименованиеЗадания);
	КонецЕсли;	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьФайлыМассива(МассивФайлы)
	
	Для каждого СтрокаФайл Из МассивФайлы Цикл
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных();
			ЭлементБлокировки = Блокировка.Добавить(СтрокаФайл.Ссылка.Метаданные().ПолноеИмя());
			ЭлементБлокировки.УстановитьЗначение("Ссылка", СтрокаФайл.Ссылка);
			Блокировка.Заблокировать();
			
			ФайлОбъект = СтрокаФайл.Ссылка.ПолучитьОбъект();
			ФайлОбъект.Заблокировать();
			ФайлОбъект.УстановитьПометкуУдаления(Истина);
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение; 
		КонецПопытки
	КонецЦикла;	
	
КонецПроцедуры

&Наклиенте
Функция ПреобразоватьИмяФайлаВыгрузки(ИмяПакета)
	ЧастиИмени = СтрРазделить(ИмяПакета, "_");	
	ЧастиИмени[4] = "1";
	Возврат СтрСоединить(ЧастиИмени, "_");
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьДвоичныеДанныеФайла(ФайлСсылка)
	МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
	ДД = МодульРаботаСФайлами.ДвоичныеДанныеФайла(ФайлСсылка);
