	"СрокиПредоставления", Объект.Организация, Год(Объект.Год)));
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПротоколЗагрузки(Команда)  
	
	Если МодульСбораДанныхВызовСервера.ИспользуютсяИнтеграцииЭБ() Тогда
		Текст = ПолучитьПротоколЗагрузкиНаСервере();
		Элементы.ГруппаСформированныеДанные.ТекущаяСтраница = Элементы.ГруппаСведенияОбмена; 
		Элементы.ГруппаОбмен.ТекущаяСтраница = Элементы.ГруппаСведенияОПротоколах;
		ПоказатьПредупреждение(,Текст);
	Иначе		
		МассивФайлов = ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьМассивфайловПакета(Объект.Организация, Объект.Ссылка);
		Если ИнтеграцииЕСМВСМЭВВызовСервера.ОтправлятьЗапросыНаКлиенте() Тогда
			ИнтеграцииЕСМВСМЭВКлиент.ОтправитьЗапросНаСверку(Объект.Организация, "СтатусПакета", ЭтаФорма, Новый Структура("МассивФайлов", МассивФайлов));
		Иначе
			
			ПараметрыПроцедуры = Новый Структура;
			ПараметрыПроцедуры.Вставить("Организация", Объект.Организация);
			ПараметрыПроцедуры.Вставить("ТипЗапроса", "СтатусПакета");
			ПараметрыПроцедуры.Вставить("ДополнительныеПараметры", Новый Структура("МассивФайлов", МассивФайлов));
			
			РезультатЗадания = ОтправитьЗапросФоновоеНаСервере(ПараметрыПроцедуры);
			
			МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
			
			ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
			ПараметрыОжидания.ВыводитьСообщения = Истина;
			ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЕСМВФоновоеЗавершение", ЭтотОбъект);
			
			МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания); 
			
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

