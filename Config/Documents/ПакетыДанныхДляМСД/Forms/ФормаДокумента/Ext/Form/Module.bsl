#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	МодульПодключаемыеКоманды = ОбщегоНазначения.ОбщийМодуль("ПодключаемыеКоманды");
	МодульПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Модифицированность = Истина;
		
		Объект.ВидПередаваемыхДанных = Истина;
		Объект.Год = НачалоГода(ТекущаяДатаСеанса()); 
		Объект.Организация = ПараметрыСеанса.ТекущаяОрганизация;
		
		ОтчетныйПериод = "Не выбран";
		ПолучитьОтчетныеПериоды();
		
	Иначе
		УстановитьВидимостьТаксономии(Не ПустаяСтрока(Объект.ВерсияТаксономии));
		ОбновитьНадписьПериода();
		ОбновитьНадписьСтатусаПодписания();
	КонецЕсли;
	
	НомерТекущегоФайла = 1;
	ВсегоФайлов		   = 1;
		
	ОбновитьСрокПредоставления();
	
	УстановитьВидимость();
	ИмяФайлаВыгрузки();
	ТекущийСтатус = МодульСбораДанныхВызовСервера.ПолучитьТекущийСтатусПакета(Объект.Ссылка); 
	СтатусыПереданныхПакетов.Параметры.УстановитьЗначениеПараметра("Пакет", Объект.Ссылка);
	СведенияОПротоколах.Параметры.УстановитьЗначениеПараметра("Пакет", Объект.Ссылка);
	ИсторияОбмена.Параметры.УстановитьЗначениеПараметра("Пакет", Объект.Ссылка);
	
	СведенияОПротоколах.Параметры.УстановитьЗначениеПараметра("ТекстЗапросОтправлен", НСтр("ru='Запрос отправлен'")); 
	СведенияОПротоколах.Параметры.УстановитьЗначениеПараметра("ТекстЗапросВПути", НСтр("ru='Запрос в пути'"));
	СведенияОПротоколах.Параметры.УстановитьЗначениеПараметра("ТекстЗапросВОчереди", НСтр("ru='Запрос в очереди'"));
	СведенияОПротоколах.Параметры.УстановитьЗначениеПараметра("ТекстПротоколЗагружен", НСтр("ru='Протокол загружен'"));
	СведенияОПротоколах.Параметры.УстановитьЗначениеПараметра("ТекстПротоколОшибкаЗагрузки", НСтр("ru='Ошибка загрузки'"));

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	МодульПодключаемыеКомандыКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ПодключаемыеКомандыКлиентСервер");
	МодульПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
		
	// СтандартныеПодсистемы.ПодключаемыеКоманды 
	МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
	МодульПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	СтатусыПереданныхПакетов.Параметры.УстановитьЗначениеПараметра("Пакет", Объект.Ссылка);
	Элементы.СтатусыПереданныхПакетов.Обновить();
	УстановитьВидимость();	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
	МодульПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ВыборСтандартногоПериодаМесяц" Или ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ВыборСтандартногоПериода" Тогда
		Объект.НачалоПериода 	= ВыбранноеЗначение.НачалоПериода;
		Объект.ОкончаниеПериода	= ВыбранноеЗначение.КонецПериода;
		ОбновитьНадписьПериода();  
		ПриИзмененииНастроекВыгрузки();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоказатьВопросЗавершение(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Или Результат = Неопределено Тогда
		Возврат;
	Иначе
		Если Результат = КодВозвратаДиалога.Да Тогда
			ПараметрыОткрытияФормы = Новый Структура();
			ПараметрыОткрытияФормы.Вставить("ТипФормы","Таксономия");
			ПараметрыОткрытияФормы.Вставить("Организация"); 
			ПараметрыОткрытияФормы.Вставить("НачалоПериода"); 
			ПараметрыОткрытияФормы.Вставить("ОкончаниеПериода"); 
			ПараметрыОткрытияФормы.Вставить("ВидПередаваемыхДанных");
			ЗаполнитьЗначенияСвойств(ПараметрыОткрытияФормы, Объект);
			ОткрытьФорму("Обработка.ЗагрузкаТаксономии.Форма.Форма", ПараметрыОткрытияФормы);
		Иначе
			НомерТекущегоФайла = 1;
			ОчиститьПрисоединенныеФайлы();
			ВыполнитьВыгрузку();
		КонецЕсли;	
	КонецЕсли; 
	
КонецПроцедуры 

&НаКлиенте
Процедура ВидПередаваемыхДанныхПриИзменении(Элемент)
	
	ОчиститьЗависимыеПоляПериода();
	ПолучитьОтчетныеПериоды();
	
	УстановитьВидимость();
	ПриИзмененииНастроекВыгрузки();
	ОбновитьСрокПредоставления();
	ПроверитьНаличиеПереданныхОтчетныхДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетныйПериодНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
			
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОтображатьСписком", Истина);
	ПараметрыФормы.Вставить("Ссылки", ОтчетныйПериодСписок);
	
	ОткрытьФорму("Справочник.ПериодыМСД.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,, 
	Новый ОписаниеОповещения("ВыборПериодаЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры   

#КонецОбласти

#Область ОбработчикиКомандФормы

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
	МодульПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	МодульПодключаемыеКоманды = ОбщегоНазначения.ОбщийМодуль("ПодключаемыеКоманды");
	МодульПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	МодульПодключаемыеКомандыКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиентСервер");
	МодульПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура СформироватьВыгрузку(Команда)
	
	Если Модифицированность Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		ПоказатьПредупреждение(, НСтр("ru='Перед выгрузкой необходимо записать документ'"));
		Возврат;
	КонецЕсли;  	
	
	Если МодульСбораДанныхВызовСервера.ИспользуютсяИнтеграцииЭБ() Тогда
        НомерТекущегоФайла = 1;
		ОчиститьПрисоединенныеФайлы();
		ВыполнитьВыгрузку();
	Иначе
		Оповещение = Новый ОписаниеОповещения("ПоказатьВопросЗавершение", ЭтотОбъект);
		ТекстВопроса = НСтр("ru='Рекомендуется актуализировать таксономию перед формированием выгрузки, актуализировать?'");
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да, НСтр("ru='Актуализировать таксономию'"));
		СписокКнопок.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='Продолжить формирование без актуализации'"));
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru='Отмена'"));
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, СписокКнопок); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПакетов(Команда)
	ОткрытьФорму("РегистрСведений.ПакетыДанныхМСД.ФормаСписка", , ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьФайлы(Команда) 
	
	МассивФайлов = ПолучитьМассивФайловИПроверитьПодписание(Объект.Организация, Объект.Ссылка);
	Если МассивФайлов.Количество() Тогда
		Для каждого СтрокаФайл Из МассивФайлов Цикл		
			Если НЕ СтрокаФайл.ДанныеВыборки.УсловиеПодписания И НЕ СтрокаФайл.ДанныеВыборки.Подписан Тогда				
				
				Оповещение = Новый ОписаниеОповещения("ПоказатьВопросПодписьЗавершение", ЭтотОбъект, Новый Структура("МассивФайлов", МассивФайлов));
				ТекстЗаголовок = НСтр("ru='Требуется подписание данных'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
				ТекстВопроса = НСтр("ru='Пакет требует подписания данных, согласно установленным настройкам. 
				|Попробуйте отправить пакет снова после подписания. 
				|Подписать пакет сейчас?'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
				СписокКнопок = Новый СписокЗначений;
				СписокКнопок.Добавить(КодВозвратаДиалога.Да, НСтр("ru='Подписать'"));
				СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru='Отмена'"));
				
				ПоказатьВопрос(Оповещение, ТекстВопроса, СписокКнопок,,,ТекстЗаголовок);
				Возврат;  
			ИначеЕсли  СтрокаФайл.ДанныеВыборки.НовыйПорядок Тогда
				Если СтрокаФайл.ДанныеВыборки.ВидПередаваемыхДанных Тогда
					Если СтрокаФайл.ДанныеВыборки.ПодписыватьОтчетныеДанныеДляМСД И СтрокаФайл.ДанныеВыборки.СуффиксПодписи < 2 Тогда
						ТекстЗаголовок = НСтр("ru='Требуется подписание данных'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
						ТекстВопроса = НСтр("ru='Пакет с отчетными данными должен быть подтвержден как минимум двумя подписями. 
						|Попробуйте отправить пакет снова после подписания.'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
						ПоказатьПредупреждение(,ТекстВопроса,,ТекстЗаголовок); 
						Возврат;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла; 
	Иначе
		ТекстСообщения = НСтр("ru='Отправка не выполнена: в присоединенных файлах не найден пакет для отправки.'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если МодульСбораДанныхВызовСервера.ИспользуютсяИнтеграцииЭБ() Тогда 
		ОтправитьФайлыНаСервере(МассивФайлов);  
		Элементы.СтатусыПереданныхПакетов.Обновить();
		Элементы.ИсторияОбмена.Обновить(); 
		УстановитьВидимость();
	Иначе
		
		ОтменитьВыгрузку = Ложь;	
		МодульСбораДанныхВызовСервера.КонтрольОтправкиПакета(Объект.Ссылка, Неопределено, ОтменитьВыгрузку);
		
		Если ОтменитьВыгрузку Тогда
			Возврат;
		КонецЕсли;
		
		Если ИнтеграцииЕСМВСМЭВВызовСервера.ОтправлятьФайлыНаКлиенте() Тогда
			ИнтеграцииЕСМВСМЭВКлиент.ОтправитьФайлыПакета(Объект.Организация, МассивФайлов, ЭтаФорма);
		Иначе
			
			ПараметрыПроцедуры = Новый Структура;
			ПараметрыПроцедуры.Вставить("Организация", Объект.Организация);
			ПараметрыПроцедуры.Вставить("МассивФайлов", МассивФайлов); 
			
			РезультатЗадания = ОтправитьФайлыПакетаФоновоеНаСервере(ПараметрыПроцедуры);
			
			МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
			
			ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
			ПараметрыОжидания.ВыводитьСообщения = Истина;
			ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ОтправитьФайлыПакетаФоновоеЗавершение", ЭтотОбъект);
			
			МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
			
		КонецЕсли;	
	КонецЕсли;	
			
КонецПроцедуры 	 

&НаСервере
Функция ОтправитьФайлыПакетаФоновоеНаСервере(ПараметрыПроцедуры)
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);  
	
	МодульДлительныеОперации = ОбщегоНазначения.ОбщийМодуль("ДлительныеОперации");
	ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "ОтправитьФайлыПакетаФоновое";
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ДополнительныйРезультат = Ложь;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.АдресРезультата = АдресРезультата;
	
	РезультатФоновогоЗадания = МодульДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, "ИнтеграцииЕСМВСМЭВ.ОтправитьФайлыПакетаФоновое", ПараметрыПроцедуры, АдресРезультата);
	
	Возврат РезультатФоновогоЗадания;
	
КонецФункции 

&НаКлиенте
Асинх Процедура ОтправитьФайлыПакетаФоновоеЗавершение(Результат, ДопПараметры) Экспорт 
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ТекущийСтатус = МодульСбораДанныхВызовСервера.ПолучитьТекущийСтатусПакета(Объект.Ссылка);
		ОбновитьДинамическиеСписки();
		УстановитьВидимость();
	ИначеЕсли Результат.Статус = "Ошибка" Тогда		
		ПоказатьПредупреждение(, Результат.ПодробноеПредставлениеОшибки);		
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПоказатьВопросПодписьЗавершение(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Или Результат = Неопределено Тогда
		Возврат;
	Иначе
		Если Результат = КодВозвратаДиалога.Да Тогда
			ПодписатьПакет(Неопределено);
		Иначе
			ОтменитьВыгрузку = Ложь;	
			МодульСбораДанныхВызовСервера.КонтрольОтправкиПакета(Объект.Ссылка, Неопределено, ОтменитьВыгрузку);
			
			Если ОтменитьВыгрузку Тогда
				Возврат;
			КонецЕсли;

			Если ИнтеграцииЕСМВСМЭВВызовСервера.ОтправлятьФайлыНаКлиенте() Тогда
				ИнтеграцииЕСМВСМЭВКлиент.ОтправитьФайлыПакета(Объект.Организация, ПараметрыОповещения.МассивФайлов, ЭтаФорма);
			Иначе
				
				ПараметрыПроцедуры = Новый Структура;
				ПараметрыПроцедуры.Вставить("Организация", Объект.Организация);
				ПараметрыПроцедуры.Вставить("МассивФайлов", ПараметрыОповещения.МассивФайлов); 
				
				РезультатЗадания = ОтправитьФайлыПакетаФоновоеНаСервере(ПараметрыПроцедуры);
				
				МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
				
				ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
				ПараметрыОжидания.ВыводитьСообщения = Истина;
				ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ОтправитьФайлыПакетаФоновоеЗавершение", ЭтотОбъект);
				
				МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
				
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьАктуальностьВерсииТаксономии(Команда)
	ПараметрыОткрытияФормы = Новый Структура();
	ПараметрыОткрытияФормы.Вставить("ТипФормы","Таксономия");
	ПараметрыОткрытияФормы.Вставить("Организация"); 
	ПараметрыОткрытияФормы.Вставить("НачалоПериода"); 
	ПараметрыОткрытияФормы.Вставить("ОкончаниеПериода"); 
	ПараметрыОткрытияФормы.Вставить("ВидПередаваемыхДанных");
	ЗаполнитьЗначенияСвойств(ПараметрыОткрытияФормы, Объект);
	ОткрытьФорму("Обработка.ЗагрузкаТаксономии.Форма.Форма", ПараметрыОткрытияФормы);		
КонецПроцедуры

