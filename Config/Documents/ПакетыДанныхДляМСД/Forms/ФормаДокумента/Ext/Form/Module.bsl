&НаСервере
Функция ОтправитьЗапросФоновоеНаСервере(ПараметрыПроцедуры)
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);  
	
	МодульДлительныеОперации = ОбщегоНазначения.ОбщийМодуль("ДлительныеОперации");
	ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "ОтправитьЗапросФоновое";
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ДополнительныйРезультат = Ложь;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.АдресРезультата = АдресРезультата;
	
	РезультатФоновогоЗадания = МодульДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, "ИнтеграцииЕСМВСМЭВ.ОтправитьЗапросНаСверкуФоновое", ПараметрыПроцедуры, АдресРезультата);
	
	Возврат РезультатФоновогоЗадания;
	
КонецФункции

&НаКлиенте
Асинх Процедура ЕСМВФоновоеЗавершение(Результат, ДопПараметры) Экспорт 
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда 
		Элементы.СведенияОПротоколах.Обновить();
		Элементы.ГруппаСформированныеДанные.ТекущаяСтраница = Элементы.ГруппаСведенияОбмена; 
		Элементы.ГруппаОбмен.ТекущаяСтраница = Элементы.ГруппаСведенияОПротоколах;
	ИначеЕсли Результат.Статус = "Ошибка" Тогда		
		ПоказатьПредупреждение(, Результат.ПодробноеПредставлениеОшибки);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииНастроекВыгрузки()
	
	Модифицированность = Истина;
	
	ИмяФайлаВыгрузки();
	
КонецПроцедуры 

&НаКлиенте
Процедура ВыполнитьВыгрузку()
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;               
	
	ИмяФайлаВыгрузки();
		
	ИдентификаторПакета = НовыйИдентификаторПакетаСервер();
	
	ДанныеФайла = ПолучитьДанныеФайла();
	ДанныеФайла.Вставить("Статус", ПредопределенноеЗначение("Перечисление.СтатусыПакетовМСД.Формирование"));
		
	РезультатЗадания = СформироватьВыгрузкуНаСервереВФоне(ДанныеФайла);
	
	МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
	
	ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("СформироватьВыгрузкуЗавершение", ЭтотОбъект);
	
	МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);     
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НовыйИдентификаторПакетаСервер()
	Возврат Новый УникальныйИдентификатор;
КонецФункции

&НаСервере
Функция СформироватьВыгрузкуНаСервереВФоне(ДанныеФайла)
	
	пНачало = ТекущаяДатаСеанса();
	ДанныеФайла.Вставить("ТекущаяДатаСеанса", УниверсальноеВремя(пНачало));
	СформироватьЗаписьВРегистр("", ДанныеФайла);
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ВидПередаваемыхДанных", Объект.ВидПередаваемыхДанных);
	ПараметрыПроцедуры.Вставить("НачалоПериода", Объект.НачалоПериода);    
	ПараметрыПроцедуры.Вставить("ОкончаниеПериода", Объект.ОкончаниеПериода);	 
	ПараметрыПроцедуры.Вставить("АдресРезультата", АдресРезультата); 
	ПараметрыПроцедуры.Вставить("ДокументСсылка", Объект.Ссылка);         
	ПараметрыПроцедуры.Вставить("ВерсияТаксономии", Объект.ВерсияТаксономии);
	ПараметрыПроцедуры.Вставить("Организация", Объект.Организация);
	МодульДлительныеОперации = ОбщегоНазначения.ОбщийМодуль("ДлительныеОперации");
	ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "ВыгрузкаДанныхДляМСД";
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ДополнительныйРезультат = Ложь;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.АдресРезультата = АдресРезультата;
	
	РезультатФоновогоЗадания = МодульДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, "Документы.ПакетыДанныхДляМСД.ВыполнитьВыгрузку", ПараметрыПроцедуры, АдресРезультата);
	
	Возврат РезультатФоновогоЗадания;
	
КонецФункции

&НаСервере
Процедура ЗаписатьПрисоединенныйФайлСПодписью(Знач АдресРезультата, ДанныеФайла)
	
	МодульПользователи = ОбщегоНазначения.ОбщийМодуль("Пользователи");
	
	ДД = ПолучитьИзВременногоХранилища(АдресРезультата);
	МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
	ПараметрыФайла = МодульРаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.Автор = МодульПользователи.АвторизованныйПользователь();
	
	ПараметрыФайла.ВладелецФайлов = Объект.Ссылка;
	ПараметрыФайла.ИмяБезРасширения = ИмяПакета;		
	ПараметрыФайла.РасширениеБезТочки = "zip";
	
	текОбъект = РеквизитФормыВЗначение("Объект");
	текОбъект.ПометкаУдаления = Истина;
	ДанныеФайла.ДанныеВыборки.Удалить("Статус");
	
	УстановитьПривилегированныйРежим(Истина); 
	ИмяСобытия = НСтр("ru='ПодписаниеПакетаМСД'"); 
	МодульЖурналРегистрации = ОбщегоНазначения.ОбщийМодуль("ЖурналРегистрации");
	МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,,НСтр("ru='Добавление архива в присоединенные файлы - начало'")); 
	МодульРаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресРезультата); 
	МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,,НСтр("ru='Добавление архива в присоединенные файлы - конец'")); 
	
	ДобавлениеФайлаВыполненоУспешно = ПроверитьКоличествоПрисоединенныхФайлов();
	Если ДобавлениеФайлаВыполненоУспешно Тогда
		МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,,НСтр("ru='Запись статуса в регистр пакетов - начало'")); 
		
		ТекущийСтатус = ПолучитьТекущийСтатусПодписания(Объект.Ссылка);
		Если ТекущийСтатус = Перечисления.СтатусыПакетовМСД.НаПодписании2Подписью 
			ИЛИ ТекущийСтатус = Перечисления.СтатусыПакетовМСД.Подписан1Подписью 
				ИЛИ ТекущийСтатус = Перечисления.СтатусыПакетовМСД.Подписан2Подписью Тогда
			СтатусПодписания = Перечисления.СтатусыПакетовМСД.Подписан2Подписью;
		Иначе
			СтатусПодписания = Перечисления.СтатусыПакетовМСД.Подписан1Подписью;
		КонецЕсли;

		ДанныеФайла.ДанныеВыборки.Вставить("Статус", СтатусПодписания);

		СформироватьЗаписьВРегистр(АдресРезультата, ДанныеФайла.ДанныеВыборки);
		ДанныеФайла.ДанныеВыборки.Удалить("КомуВыданСертификат");
		Если ДанныеФайла.ДанныеВыборки.Свойство("ТекущаяДатаСеансаУстановленная") Тогда  
			НужнаПодпись = ?(Объект.ВидПередаваемыхДанных И Объект.ОкончаниеПериода > Дата(2026,1,1), Константы.ПодписыватьОтчетныеДанныеДляМСД.Получить(), Ложь);		
			Если НужнаПодпись И СтатусПодписания = Перечисления.СтатусыПакетовМСД.Подписан1Подписью Тогда
				ДанныеФайла.ДанныеВыборки.Вставить("ТекущаяДатаСеанса", ДанныеФайла.ДанныеВыборки.ТекущаяДатаСеансаУстановленная + 1); 
				ДанныеФайла.ДанныеВыборки.Вставить("Статус", Перечисления.СтатусыПакетовМСД.НаПодписании2Подписью);
				СформироватьЗаписьВРегистр(АдресРезультата, ДанныеФайла.ДанныеВыборки)
			КонецЕсли;	
		КонецЕсли;
		МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,,НСтр("ru='Запись статуса в регистр пакетов - конец'")); 
		
		Если ЗначениеЗаполнено(ДанныеФайла.ДанныеВыборки.Ссылка) Тогда
			МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,,НСтр("ru='Установка пометки удаления - начало'")); 
			МассивФайлы = Новый Массив;
			МассивФайлы.Добавить(ДанныеФайла.ДанныеВыборки.Ссылка);
			УдалитьФайлыМассива(МассивФайлы);
			МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,,НСтр("ru='Установка пометки удаления - конец'"));
		КонецЕсли;
   Иначе
		ВызватьИсключение НСтр("ru='При подписании возникла ошибка.'");	
   КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры 

&НаСервереБезКонтекста
Процедура ЗаменитьВРезультатеХЗнаZIP(Знач АдресРезультата, Ссылка, ИмяПакета)
	
	МодульПользователи = ОбщегоНазначения.ОбщийМодуль("Пользователи");
	
	РазделительПути = ПолучитьРазделительПути();
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	Файл = Новый Файл(ИмяВременногоФайла);
	Каталог = СтрЗаменить(ИмяВременногоФайла, Файл.Имя, "") + XMLСтрока(Новый УникальныйИдентификатор) + РазделительПути;
	
	СоздатьКаталог(Каталог);
	
	МассивФайлов = ПолучитьИзВременногоХранилища(АдресРезультата).Получить();
	Если Не ТипЗнч(МассивФайлов) = Тип("Массив") Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='... что-то пошло не так. В результате нет файлов...'"));
		Возврат;
	КонецЕсли;
	
	Для Каждого ДанныеФайла Из МассивФайлов Цикл
		Для Каждого ЭлементСтруктуры Из ДанныеФайла Цикл
			ДД = ДанныеФайла[ЭлементСтруктуры.Ключ];
			ДД.Записать(Каталог + ЭлементСтруктуры.Ключ + ".xml");
		КонецЦикла;
	КонецЦикла;
	
	ЗИПФайл = Новый ЗаписьZipФайла();
	ЗИПФайл.Добавить(Каталог + "*.xml");
	ДДАрхива = ЗИПФайл.ПолучитьДвоичныеДанные();
	
	МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
	ПараметрыФайла = МодульРаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.Автор = МодульПользователи.АвторизованныйПользователь();
	ПараметрыФайла.ВладелецФайлов = Ссылка;
	ПараметрыФайла.ИмяБезРасширения = ИмяПакета;
	
	ПоместитьВоВременноеХранилище(ДДАрхива, АдресРезультата);
	ПараметрыФайла.РасширениеБезТочки = "zip";
	
	МодульРаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресРезультата);
	
	УдалитьФайлы(Каталог);
	
КонецПроцедуры 

&НаКлиенте
Асинх Процедура СформироватьВыгрузкуЗавершение(Результат, ДопПараметры) Экспорт 
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
				
		ТабДокДанныеДляПересчетаОстатковЗаполнен = Ложь;
		ТабДокДанныеМОЗаполнен = Ложь;
		ТабДокДанныеОстатковИОборотовЗаполнен = Ложь;	
		
		УстановитьДатуОкончания(пОкончание);
		
		ДанныеФайла = ПолучитьДанныеФайла();
		ДанныеФайла.Вставить("ДатаФормирования", пОкончание);
		ДанныеФайла.Вставить("ПолучитьУниверсальноеВремяФормирования", Истина);
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ДанныеФайла", ДанныеФайла);
		
		СформироватьВыгрузкуЗавершениеНаСервере(Результат.АдресРезультата, ДопПараметры);                		
		ТекущийСтатус = МодульСбораДанныхВызовСервера.ПолучитьТекущийСтатусПакета(Объект.Ссылка); 
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru='Выгрузка выполнена. Сформирован файл %1%2Время выполнения:%2- начало в     %3%2- окончание в %4'"), 
		ИмяФайлаВыгрузки, Символы.ПС, Формат(пНачало, "ДЛФ=T"), Формат(пОкончание, "ДЛФ=T")));			
		
		Если НомерТекущегоФайла < ВсегоФайлов Тогда
			НомерТекущегоФайла = НомерТекущегоФайла + 1; 
			ВыполнитьВыгрузку();
		ИначеЕсли НомерТекущегоФайла = ВсегоФайлов Тогда
			НомерТекущегоФайла = 1; 
		КонецЕсли;
		УстановитьВидимость();
		
		ПараметрыПроцедуры = Новый Структура;
		ПараметрыПроцедуры.Вставить("ДокументСсылка", Объект.Ссылка);
		ПараметрыПроцедуры.Вставить("ИмяПакета", ИмяПакета);
        Элементы.СтатусыПереданныхПакетов.Обновить();
		
		ЗапуститьФоновоеЗаданиеФормированияТабДокументов(ПараметрыПроцедуры);
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		
		ДанныеФайла = ПолучитьДанныеФайла();
		ДанныеФайла.Вставить("ОписаниеОшибки", Результат.ПодробноеПредставлениеОшибки);
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ДанныеФайла", ДанныеФайла);

		ОбработатьОшибкуФормирования(ДопПараметры);
		Элементы.СтатусыПереданныхПакетов.Обновить();
		Если Результат.Сообщения.Количество() Тогда
			ПоказатьПредупреждение(, Результат.Сообщения[0].Текст); 
			ОчиститьСообщения();
		Иначе
			ПоказатьПредупреждение(, Результат.ПодробноеПредставлениеОшибки);	
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры   

&НаСервереБезКонтекста
Процедура УстановитьДатуОкончания(пОкончание)
	пОкончание = ТекущаяДатаСеанса();	
КонецПроцедуры	
	
&НаСервере
Функция СохранитьДанныеНаСервереИПередатьМассивДДДляПодписания(Знач АдресФайла)
	
	ЗначениеХранилища = ПолучитьИзВременногоХранилища(АдресФайла);
	
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	КаталогФайлов = МодульОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ПолучитьИмяВременногоФайла()).Путь + Новый УникальныйИдентификатор() + ПолучитьРазделительПути();
	СоздатьКаталог(КаталогФайлов);
	МассивФайлов = Новый Массив;

	Если ТипЗнч(ЗначениеХранилища) = Тип("ДвоичныеДанные") Тогда 
		
		СтруктураМассивФайлов = Новый Структура;
		ДДАрхива = ЗначениеХранилища;
		
		Поток = ДДАрхива.ОткрытьПотокДляЧтения();
		ЧтениеZip = Новый ЧтениеZipФайла(Поток);
		ЧтениеZip.ИзвлечьВсе(КаталогФайлов);
		
		Для Каждого ЭлементZipАрхива Из ЧтениеZip.Элементы Цикл 
			IsXML = (ЭлементZipАрхива.Расширение = "xml");
			СтруктураМассивФайлов.Вставить(?(IsXML, ЭлементZipАрхива.ИмяБезРасширения, 
			ЭлементZipАрхива.ИмяБезРасширения + "_" + ЭлементZipАрхива.Расширение), 
			ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(КаталогФайлов + ЭлементZipАрхива.Имя), УникальныйИдентификатор));
		КонецЦикла;
		
		МассивФайлов.Добавить(СтруктураМассивФайлов);
		
		ЧтениеZip.Закрыть();
		Поток.Закрыть();
				
	КонецЕсли;
	
	УдалитьИзВременногоХранилища(АдресФайла);
	УдалитьФайлы(КаталогФайлов);
	
	Возврат Новый Структура("МассивФайлов", МассивФайлов);
	
КонецФункции

&НаКлиенте
Процедура ПодписатьВыгрузкуКлиент(АдресФайла, ДополнительныеПараметры)
	
	ПараметрыДанных = СохранитьДанныеНаСервереИПередатьМассивДДДляПодписания(АдресФайла);
	МассивФайлов = ПараметрыДанных.МассивФайлов;
	ДополнительныеПараметры.Вставить("Каталог"); // для обратной совместимости
	
	ИнтерфейсПодписанияХэш = "";
	ИспользоватьПодписаниеХэш = МодульСбораДанныхВызовСервера.ИспользоватьПодписаниеХэш(ИнтерфейсПодписанияХэш);
	
	НаборДанныхПодписи = Новый Массив;
	
	Если ИспользоватьПодписаниеХэш Тогда
		СсылкиНаФайл = Новый СписокЗначений;
		Для Каждого СтруктураФайла Из МассивФайлов Цикл			
			Для Каждого КлючИЗначение Из СтруктураФайла Цикл
				Если СтрНайти(КлючИЗначение.Ключ, "_p7s") Тогда
					НаборДанныхПодписи.Добавить(Новый Структура("Владелец,Данные,ИмяФайла,СвойстваПодписи", Объект.Ссылка, СтруктураФайла[КлючИЗначение.Ключ], КлючИЗначение.Ключ, ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор)));				
				Иначе
					СсылкиНаФайл.Добавить(Новый Структура("Владелец,Данные,ИмяФайла,СвойстваПодписи", Объект.Ссылка, СтруктураФайла[КлючИЗначение.Ключ], КлючИЗначение.Ключ, ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор)));	
				КонецЕсли;	
			КонецЦикла;			
		КонецЦикла;
		
		МассивФайлов = Неопределено;
		
		ПараметрыФормы = Новый Структура("СсылкиДляПодписи", СсылкиНаФайл);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПодписатьХэшЗавершение", ЭтотОбъект, Новый Структура("ДанныеФайла, НаборДанныхПодписи", ДополнительныеПараметры, НаборДанныхПодписи));
		ФормаПодписи = ОткрытьФорму(ИнтерфейсПодписанияХэш, ПараметрыФормы , ЭтаФорма, , ВариантОткрытияОкна.ОтдельноеОкно,, ОписаниеОповещения);
		ФормаПодписи.ПодготовитьФайлыДляПодписания();
		
	Иначе
		НаборДанных = Новый Массив;
		
		Для Каждого ДанныеФайла Из МассивФайлов Цикл
			Для Каждого ЭлементСтруктуры Из ДанныеФайла Цикл 
				Оповещение = Новый ОписаниеОповещения("ПодписатьДанные_РасшифровкаПодписываемогоФайла", ЭтаФорма, ДанныеФайла[ЭлементСтруктуры.Ключ]);
				Если СтрНайти(ЭлементСтруктуры.Ключ, "_p7s") Тогда
					НаборДанныхПодписи.Добавить(Новый Структура("Данные,Представление", ДанныеФайла[ЭлементСтруктуры.Ключ], Новый Структура("Значение,Представление", Оповещение, ЭлементСтруктуры.Ключ)));				
				Иначе
					НаборДанных.Добавить(Новый Структура("Данные,Представление", ДанныеФайла[ЭлементСтруктуры.Ключ], Новый Структура("Значение,Представление", Оповещение, ЭлементСтруктуры.Ключ + ".xml")));
				КонецЕсли;	
			КонецЦикла;					
		КонецЦикла;
		
		ОписаниеДанных = Новый Структура;
		ОписаниеДанных.Вставить("ПоказатьКомментарий", Истина);
		ОписаниеДанных.Вставить("Операция",            НСтр("ru = 'Подписание файлов'"));
		ОписаниеДанных.Вставить("ЗаголовокДанных",     НСтр("ru = 'Файлы'"));
		ОписаниеДанных.Вставить("НаборДанных", НаборДанных);
		ОписаниеДанных.Вставить("ВыполнятьНаСервере", Ложь);
		ОписаниеДанных.Вставить("ПредставлениеНабора", СтрШаблон("Файлы (%1)", Формат(НаборДанных.Количество(), "ЧГ=0")));
		
		МодульЭлектроннаяПодписьКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЭлектроннаяПодписьКлиент");
		ПараметрыПодписания = МодульЭлектроннаяПодписьКлиент.НовыйТипПодписи();
		ПараметрыПодписания.ВыборДоверенности = Истина;
		МодульЭлектроннаяПодписьКлиент.Подписать(ОписаниеДанных, УникальныйИдентификатор, Новый ОписаниеОповещения("ПодписатьВыгрузкуКлиентЗавершение", 
												ЭтаФорма, Новый Структура("ДанныеФайла, НаборДанныхПодписи", ДополнительныеПараметры, НаборДанныхПодписи)), ПараметрыПодписания);
		
	КонецЕсли;
											
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьХэшЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Состояние("Сохранение подписанных данных, пожалуйста подождите");
	
	Оповещение = Новый ОписаниеОповещения("ПодготовитьПодписанныеДанныеХэшКУпаковке", ЭтотОбъект, ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(Оповещение, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьПодписанныеДанныеХэшКУпаковке(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("СписокЗначений") Тогда
		
		ОписаниеДанных = Новый Структура("Отказ,Успех,НаборДанных", Ложь, Истина, Новый Массив);
		Для Каждого ЭлементСписка Из Результат Цикл
			ОписаниеДанных.НаборДанных.Добавить(Новый Структура("Представление,Данные,СвойстваПодписи", Новый Структура("Представление", ЭлементСписка.Значение.ИмяФайла), ПолучитьИзВременногоХранилища(ЭлементСписка.Значение.Данные), ПолучитьИзВременногоХранилища(ЭлементСписка.Значение.СвойстваПодписи)));
		КонецЦикла;
		
		ПодписатьВыгрузкуКлиентЗавершение(ОписаниеДанных, ДополнительныеПараметры);
		
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Подписание отменено");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПодписатьВыгрузкуКлиентЗавершение(ОписаниеДанных, ДополнительныеПараметры) Экспорт
	
	Если ОписаниеДанных.Отказ Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Подписание отменено.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ОписаниеДанных.Успех Или Не ОписаниеДанных.Свойство("НаборДанных") Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='При подписании возникла ошибка.'"));
		Возврат;
	КонецЕсли;
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	// Очистка данных для расшифровки файлов в контексте
	Для Каждого СтрокаНабора Из ОписаниеДанных.НаборДанных Цикл
		СтрокаНабора.Представление = СтрокаНабора.Представление.Представление;
	КонецЦикла; 
	
	Для каждого СтрокаПодписи Из ДополнительныеПараметры.НаборДанныхПодписи Цикл 
		Если СтрокаПодписи.Свойство("Представление") Тогда
			СтрокаПодписи.Представление = СтрокаПодписи.Представление.Представление;
		Иначе 
			СтрокаПодписи.Вставить("Представление", СтрокаПодписи.ИмяФайла);
			СтрокаПодписи.Удалить("СвойстваПодписи");
		КонецЕсли;
		ОписаниеДанных.НаборДанных.Добавить(СтрокаПодписи);	
	КонецЦикла;	
	
	КомуВыданСертификат = "";
	ПакетПодписан = Истина;
	ДД = УпаковатьДанныеИОткрепленнуюПодписьВАрхив("", ОписаниеДанных, ПакетПодписан, КомуВыданСертификат);
	ДополнительныеПараметры.ДанныеФайла.ДанныеВыборки.Вставить("КомуВыданСертификат", КомуВыданСертификат);
	ДополнительныеПараметры.ДанныеФайла.ДанныеВыборки.Вставить("ПакетПодписан", ПакетПодписан);
	
	Если ПакетПодписан Тогда
		ПоместитьВоВременноеХранилище(ДД, АдресРезультата);	
		ЗаписатьПрисоединенныйФайлСПодписью(АдресРезультата, ДополнительныеПараметры.ДанныеФайла);
	КонецЕсли;

	ОповеститьОбИзменении(ДополнительныеПараметры.ДанныеФайла.ДанныеВыборки.Ссылка);
	Элементы.СтатусыПереданныхПакетов.Обновить();
	ТекущийСтатус = МодульСбораДанныхВызовСервера.ПолучитьТекущийСтатусПакета(Объект.Ссылка);
	Если ПакетПодписанВторойПодписью(Объект.Ссылка) Тогда
		Элементы.ФормаПодписатьПакет.Доступность = Ложь;	
	КонецЕсли;
	ОбновитьНадписьСтатусаПодписания();
	Состояние("Завершено");
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПакетПодписанВторойПодписью(Пакет)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПакетыДанныхМСД.Пакет КАК Пакет,
		|	МАКСИМУМ(ПакетыДанныхМСД.ДатаФормирования) КАК ДатаФормирования
		|ПОМЕСТИТЬ ВТ_ДатаФормирования
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|ГДЕ
		|	ПакетыДанныхМСД.Пакет = &Пакет
		|
		|СГРУППИРОВАТЬ ПО
		|	ПакетыДанныхМСД.Пакет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПакетыДанныхМСД.Пакет КАК Пакет
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДатаФормирования КАК ВТ_ДатаФормирования
		|		ПО ПакетыДанныхМСД.Пакет = ВТ_ДатаФормирования.Пакет
		|ГДЕ
		|	ПакетыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.Подписан2Подписью)
		|	И ПакетыДанныхМСД.Период >= ВТ_ДатаФормирования.ДатаФормирования";
	
	Запрос.УстановитьПараметр("Пакет", Пакет);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПакетПодписанПервойПодписью(Пакет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПакетыДанныхМСД.Пакет КАК Пакет,
		|	МАКСИМУМ(ПакетыДанныхМСД.ДатаФормирования) КАК ДатаФормирования
		|ПОМЕСТИТЬ ВТ_ДатаФормирования
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|ГДЕ
		|	ПакетыДанныхМСД.Пакет = &Пакет
		|
		|СГРУППИРОВАТЬ ПО
		|	ПакетыДанныхМСД.Пакет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПакетыДанныхМСД.Пакет КАК Пакет
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДатаФормирования КАК ВТ_ДатаФормирования
		|		ПО ПакетыДанныхМСД.Пакет = ВТ_ДатаФормирования.Пакет
		|ГДЕ
		|	ПакетыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.Подписан1Подписью)
		|	И ПакетыДанныхМСД.Период >= ВТ_ДатаФормирования.ДатаФормирования";
	
	Запрос.УстановитьПараметр("Пакет", Пакет);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекущийСтатусПодписания(Пакет)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПакетыДанныхМСД.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|ГДЕ
		|	ПакетыДанныхМСД.Пакет = &Пакет
		|	И ПакетыДанныхМСД.Статус В(&МассивПодписан)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПакетыДанныхМСД.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Пакет", Пакет);
	МассивПодписан = Новый Массив;
	МассивПодписан.Добавить(Перечисления.СтатусыПакетовМСД.НаПодписании1Подписью);
	МассивПодписан.Добавить(Перечисления.СтатусыПакетовМСД.НаПодписании2Подписью);
	МассивПодписан.Добавить(Перечисления.СтатусыПакетовМСД.Подписан1Подписью);
	МассивПодписан.Добавить(Перечисления.СтатусыПакетовМСД.Подписан2Подписью); 
	МассивПодписан.Добавить(Перечисления.СтатусыПакетовМСД.Сформирован);
	Запрос.УстановитьПараметр("МассивПодписан", МассивПодписан);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Статус;	
	КонецЦикла;	
    Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция УпаковатьДанныеИОткрепленнуюПодписьВАрхив(Знач КаталогСДаннымиНаСервере, Знач ОписаниеДанных, ПакетПодписан, КомуВыданСертификат)
	
	ИмяСобытия = НСтр("ru='ПодписаниеПакетаМСД'");
	МодульЖурналРегистрации = ОбщегоНазначения.ОбщийМодуль("ЖурналРегистрации");
	МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,,НСтр("ru='Упаковка файлов пакета в архив - начало'")); 
	
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	КаталогФайлов = МодульОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ПолучитьИмяВременногоФайла()).Путь + Новый УникальныйИдентификатор() + ПолучитьРазделительПути();
	СоздатьКаталог(КаталогФайлов);
	
	ЗаписьZipФайла = Новый ЗаписьZipФайла();
	СуффиксПодписи = 0;
	ПроверитьПодписиПакета(ОписаниеДанных.НаборДанных, ПакетПодписан, СуффиксПодписи); 
	
	Для Каждого ЭлДанных Из ОписаниеДанных.НаборДанных Цикл
		ЕстьПодпись = СтрНайти(ЭлДанных.Представление, "_p7s");	
		ИмяФайла = ?(ЕстьПодпись, СтрЗаменить(ЭлДанных.Представление, "_p7s", "") + ".p7s", СтрЗаменить(ЭлДанных.Представление, ".xml", "") + ".xml");
		ИмяВременногоФайлаДанных = КаталогФайлов + ИмяФайла;
		Если ЭтоАдресВременногоХранилища(ЭлДанных.Данные) Тогда
			ПолучитьИзВременногоХранилища(ЭлДанных.Данные).Записать(ИмяВременногоФайлаДанных);
		Иначе
			ЭлДанных.Данные.Записать(ИмяВременногоФайлаДанных);
		КонецЕсли;
		
		ЗаписьZipФайла.Добавить(ИмяВременногоФайлаДанных);
		
		Если ПакетПодписан Тогда	
			ИмяВременногоФайлаПодписи = КаталогФайлов + СтрЗаменить(ЭлДанных.Представление, ".xml", "") + "_" + (СуффиксПодписи + 1) + ".p7s";
			Если ЭлДанных.Свойство("СвойстваПодписи") Тогда
				КомуВыданСертификат = ЭлДанных.СвойстваПодписи.КомуВыданСертификат; 
				ЭлДанных.СвойстваПодписи.Подпись.Записать(ИмяВременногоФайлаПодписи);
				ЗаписьZipФайла.Добавить(ИмяВременногоФайлаПодписи);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДДАрхива = ЗаписьZipФайла.ПолучитьДвоичныеДанные();	

	УдалитьФайлы(КаталогФайлов);
	МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,,НСтр("ru='Упаковка файлов пакета в архив - конец'")); 
	
	Возврат ДДАрхива;
	
КонецФункции

&НаСервере
Процедура ИмяФайлаВыгрузки()
	
	Коды = МодульСбораДанныхПовтИсп.КодыПоРПБС(Объект.Организация);
	ИмяФайлаВыгрузки =  СтрШаблон("%1_%2_%3_%4_%5_%6.zip", Коды.КодГлавы,
	Коды.КодПоРПБС,
	?(Не Объект.ВидПередаваемыхДанных, "0", "1"),
	ПериодВИмениФайла(),
	"0",
	Формат(НомерТекущегоФайла, "ЧЦ=2; ЧВН=") + "-" + Формат(ВсегоФайлов, "ЧЦ=2; ЧВН="));
	ИмяПотока();
	
КонецПроцедуры

&НаСервере
Процедура ИмяПотока()
	
	Коды = МодульСбораДанныхПовтИсп.КодыПоРПБС(Объект.Организация);
	ИмяПакета =  СтрШаблон("%1_%2_%3_%4_%5_%6", Коды.КодГлавы, 
	Коды.КодПоРПБС, 
	?(Не Объект.ВидПередаваемыхДанных, "0", "1"), 
	ПериодВИмениФайла(),
	"0",
	Формат(НомерТекущегоФайла, "ЧЦ=2; ЧВН=") + "-" + Формат(ВсегоФайлов, "ЧЦ=2; ЧВН="));
	
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура СформироватьВыгрузкуЗавершениеНаСервере(АдресРезультата, ДопПараметры)
	
	ЗаменитьВРезультатеХЗнаZIP(АдресРезультата, ДопПараметры.ДанныеФайла.Пакет, ДопПараметры.ДанныеФайла.ИмяПакета);
	СформироватьЗаписьВРегистр(АдресРезультата, ДопПараметры.ДанныеФайла);
	Если ДопПараметры.ДанныеФайла.Свойство("ТекущаяДатаСеансаУстановленная") Тогда  
		НужнаПодпись = ?(ДопПараметры.ДанныеФайла.ВидПередаваемыхДанных, Константы.ПодписыватьОтчетныеДанныеДляМСД.Получить(), Константы.ПодписыватьОперативныеДанныеДляМСД.Получить());		
		Если НужнаПодпись Тогда
			ДопПараметры.ДанныеФайла.Вставить("ТекущаяДатаСеанса", ДопПараметры.ДанныеФайла.ТекущаяДатаСеансаУстановленная + 1); 
			ДопПараметры.ДанныеФайла.Вставить("Статус", Перечисления.СтатусыПакетовМСД.НаПодписании1Подписью);
			СформироватьЗаписьВРегистр(АдресРезультата, ДопПараметры.ДанныеФайла)
		КонецЕсли;	
	КонецЕсли;	
			
КонецПроцедуры
	
&НаСервере
Процедура УстановитьВидимость()
	
	ДокументСформирован = ЗначениеЗаполнено(Объект.Ссылка);
	
	Если ДокументСформирован Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПакетыДанныхМСД.ИдентификаторПакета КАК ИдентификаторПакета
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|ГДЕ
		|	ПакетыДанныхМСД.Пакет = &Пакет
		|	И ПакетыДанныхМСД.Статус = &Статус";
		
		Запрос.УстановитьПараметр("Пакет", Объект.Ссылка);
		Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыПакетовМСД.Сформирован);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			ДокументСформирован = Ложь;	
		КонецЕсли;
		
	КонецЕСли;	
	
	Элементы.ГруппаШапка.Доступность = НЕ ДокументСформирован;
	Элементы.ГруппаНастройки.Доступность = НЕ ДокументСформирован;	
	
	Если СпособПередачиДанныхФайл() Тогда
		Элементы.ФормаОтправитьФайлы.Видимость = Ложь;
		Элементы.ФормаПолучитьОтветыИзОчереди.Видимость = Ложь;
		Элементы.ФормаСохранитьПакет.Видимость = Истина;
		Элементы.ФормаПолучитьПротоколЗагрузки.Видимость = Ложь;
		Элементы.ФормаПечатьПротокола.Видимость = Ложь;
	КонецЕсли;
	
	СпособПередачиЕСМВ = (Константы.ОсновнойСпособПередачиДанныхВМСД.Получить() = Перечисления.СпособыПередачиДанныхВМСД.ВнешнийПОИБ);
	Элементы.ФормаПолучитьОтветыИзОчереди.Видимость = СпособПередачиЕСМВ; 
	Элементы.ФормаПолучитьОтветПротокол.Видимость = СпособПередачиЕСМВ;
	
	Элементы.ФормаПодписатьПакет.Доступность = ?(Объект.ВидПередаваемыхДанных, 
	Константы.ПодписыватьОтчетныеДанныеДляМСД.Получить(), 
	Константы.ПодписыватьОперативныеДанныеДляМСД.Получить());
	
	УстановитьВидимостьПоКорректировке(ДокументСформирован);
	Если ПакетПодписанВторойПодписью(Объект.Ссылка) Тогда
		Элементы.ФормаПодписатьПакет.Доступность = Ложь;	
	КонецЕсли;
		
КонецПроцедуры
  
&НаСервере
Процедура ОбновитьНадписьПериода(УстановитьПериод = Ложь)
	
	Если Объект.ВидПередаваемыхДанных Тогда		
		Если УстановитьПериод Тогда
			Объект.ОкончаниеПериода = КонецМесяца(Объект.НачалоПериода);
		КонецЕсли;	
		ОтчетныйПериод = Формат(Объект.НачалоПериода, НСтр("ru='ДФ=''MMMM yyyy'''"));
	Иначе
		Если УстановитьПериод Тогда
			Объект.ОкончаниеПериода = Объект.НачалоПериода + 10 * 24 * 60 * 60 - 1; //декада 
		КонецЕсли;
		ОтчетныйПериод = СтрШаблон(НСтр("ru='с %1 по %2'"), Формат(Объект.НачалоПериода, "ДЛФ=ДД"), Формат(Объект.ОкончаниеПериода, "ДЛФ=ДД"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборПериодаЗавершение(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ДанныеПериода = ПолучитьДанныеПериода(Результат);
	
	Объект.НачалоПериода = ДанныеПериода.ДатаНачала;
	Объект.ОкончаниеПериода = ДанныеПериода.ДатаОкончания;
		
	ОбновитьНадписьПериода();
	ПриИзмененииНастроекВыгрузки();
	ОбновитьСрокПредоставления(); 
	ОбновитьВерсиюТаксономии();
	ПроверитьНаличиеПереданныхОтчетныхДанных();
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьДанныеПериода(Знач Результат)
	
	ДанныеПериода = Новый Структура;
	ДанныеПериода.Вставить("ДатаНачала", Результат.ДатаНачала);
	ДанныеПериода.Вставить("ДатаОкончания", Результат.ДатаОкончания);
	Возврат ДанныеПериода;
	
КонецФункции

&НаСервере
Функция ПериодВИмениФайла()
	
	Если Объект.ВидПередаваемыхДанных Тогда
		Возврат Формат(Объект.ОкончаниеПериода, НСтр("ru='ДФ=''yyyyMM'''"));		
	Иначе
		Возврат СтрШаблон(НСтр("ru='%1-%2'"), Формат(Объект.НачалоПериода, НСтр("ru='ДФ=''yyyyMMdd'''")), Формат(Объект.ОкончаниеПериода, НСтр("ru='ДФ=''yyyyMMdd'''")));
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура СформироватьЗаписьВРегистр(Знач Адрес, ДанныеФайла)
	
	Если ДанныеФайла.Свойство("ТекущаяДатаСеанса") Тогда
		ТекущаяДатаСеанса = ДанныеФайла.ТекущаяДатаСеанса;
	Иначе	
		ТекущаяДатаСеанса = УниверсальноеВремя(ТекущаяДатаСеанса());
		ДанныеФайла.Вставить("ТекущаяДатаСеансаУстановленная", ТекущаяДатаСеанса);
	КонецЕсли;	
	Запись = РегистрыСведений.ПакетыДанныхМСД.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Запись, ДанныеФайла);
	Запись.Период = ТекущаяДатаСеанса;
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ДД = ПолучитьИзВременногоХранилища(Адрес);
		Хеш = Новый ХешированиеДанных(ХешФункция.SHA1);
		Хеш.Добавить(ДД); 
		Запись.КонтрольнаяСумма = НРег(СтрЗаменить(Хеш.ХешСумма, " ", ""));
	КонецЕсли;	
	Если НЕ ДанныеФайла.Свойство("Статус") Тогда	
		Запись.Статус = Перечисления.СтатусыПакетовМСД.Сформирован;
	КонецЕсли;	
	Запись.ИдентификаторСообщения = Неопределено;
	Запись.ДатаСтатуса = ТекущаяДатаСеанса;
	Если ДанныеФайла.Свойство("ПолучитьУниверсальноеВремяФормирования") И ДанныеФайла.ПолучитьУниверсальноеВремяФормирования Тогда
		Запись.ДатаФормирования = УниверсальноеВремя(Запись.ДатаФормирования);
	КонецЕсли;
	Если ДанныеФайла.Свойство("КомуВыданСертификат") Тогда
		Запись.ДополнительныеДанные = ДанныеФайла.КомуВыданСертификат;	
	КонецЕсли;	
	Запись.Записать(Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтправитьФайлыНаСервере(МассивФайлов)
	
	МодульИнтеграцииЭБ = ОбщегоНазначения.ОбщийМодуль("ИнтеграцииЭБ");
	МодульИнтеграцииЭБ.ОтправитьФайлыПакета(МассивФайлов);	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСрокПредоставления()
	
	УсловиеОперативныеДанные = ?(НЕ Объект.ВидПередаваемыхДанных, "НЕ", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СведенияОСрокахПредоставленияДанныхМСД.Срок КАК Срок
	|ИЗ
	|	РегистрСведений.СведенияОСрокахПредоставленияДанныхМСД КАК СведенияОСрокахПредоставленияДанныхМСД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПериодыМСД КАК ПериодыМСД
	|		ПО СведенияОСрокахПредоставленияДанныхМСД.ПериодДанных = ПериодыМСД.Ссылка
	|ГДЕ
	|	ПериодыМСД.ДатаНачала = &ДатаНачала
	|	И ПериодыМСД.ДатаОкончания = &ДатаОкончания 
	|	И СведенияОСрокахПредоставленияДанныхМСД.Организация = &Организация
	|	И " + УсловиеОперативныеДанные + " ПериодыМСД.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.Месяц)";
	
	Запрос.УстановитьПараметр("ДатаНачала", Объект.НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания", НачалоДня(Объект.ОкончаниеПериода));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СрокПредоставления = ВыборкаДетальныеЗаписи.Срок;
		УстановитьВидимостьСрок(Истина);
	Иначе
		СрокПредоставления = Неопределено;
	КонецЕсли;	
	
КонецПроцедуры 

&НаСервере
Процедура ОбновитьВерсиюТаксономии()
    ДанныеВерсии = ТекущаяВерсияТаксономииФорма(Объект.ОкончаниеПериода, Объект.Организация);
	Если Не ДанныеВерсии = Неопределено Тогда
		Объект.ВерсияТаксономии = ДанныеВерсии.Версия;
		Элементы.ВерсияТаксономии.Ширина = СтрДлина(ДанныеВерсии.Версия);
		Объект.ДатаУтвержденияТаксономии = ДанныеВерсии.ДатаУтверждения;
	КонецЕсли;
	УстановитьВидимостьТаксономии(Не ДанныеВерсии = Неопределено);  
	Модифицированность = Истина;	
КонецПроцедуры

&НаСервере
Функция ТекущаяВерсияТаксономииФорма(Дата = Неопределено, Организация) Экспорт
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СтатусыВерсийЕФСрезПоследних.Версия КАК Версия,
	                      |	СтатусыВерсийЕФСрезПоследних.ДатаУтверждения КАК ДатаУтверждения,
	                      |	СтатусыВерсийЕФСрезПоследних.Период КАК Период
	                      |ИЗ
	                      |	РегистрСведений.СтатусыВерсийЕФ.СрезПоследних(
	                      |			&Дата,
	                      |			Организация = &Организация
	                      |				И Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВерсийЕФ.Утвержден)
	                      |				И &Дата <= ВЫБОР
	                      |					КОГДА ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	                      |						ТОГДА ДАТАВРЕМЯ(3999, 12, 31, 23, 59, 59)
	                      |					ИНАЧЕ ДатаОкончания
	                      |				КОНЕЦ) КАК СтатусыВерсийЕФСрезПоследних
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	СтатусыВерсийЕФСрезПоследних.Период УБЫВ
	                      |ИТОГИ ПО
	                      |	Период");    
	
	Запрос.УстановитьПараметр("Дата", Дата); 
	Запрос.УстановитьПараметр("Организация", Организация); 
	КодПоРПБС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "КодПоРПБС");

	ВыборкаПериод = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Если ВыборкаПериод.Следующий() Тогда
		
		Выборка = ВыборкаПериод.Выбрать();
		ТаблицаВерсии = Новый ТаблицаЗначений;
		ТаблицаВерсии.Колонки.Добавить("Версия");
		ТаблицаВерсии.Колонки.Добавить("ДатаУтверждения"); 
		ТаблицаВерсии.Колонки.Добавить("Период");
		ТаблицаВерсии.Колонки.Добавить("Вес"); 
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаВерсии.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);			
			МассивВерсия = СтрРазделить(НоваяСтрока.Версия, ".");
			КоличествоВерсия = МассивВерсия.Количество();
			Если КоличествоВерсия Тогда
				Если КоличествоВерсия = 5 Тогда
					Если МассивВерсия[3] = СокрЛП(КодПоРПБС) Тогда
						НоваяСтрока.Вес = 3;	
					Иначе
						НоваяСтрока.Вес = 2;
					КонецЕсли;	
				Иначе
					НоваяСтрока.Вес = 1;	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
		
		ТаблицаВерсии.Сортировать("Вес УБЫВ");
		
		Для каждого СтрокаТаблицы Из ТаблицаВерсии Цикл
			Возврат Новый Структура("Версия, ДатаУтверждения, Период", СтрокаТаблицы.Версия, СтрокаТаблицы.ДатаУтверждения, СтрокаТаблицы.Период);	
		КонецЦикла;	
	КонецЕсли;
	
КонецФункции
	
&НаСервере
