	ВидыСубконто26 = Новый Массив;
	ВидыСубконто26.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	ВидыСубконто26.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто26.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	Запрос.УстановитьПараметр("ВидыСубконто26", ВидыСубконто26);

	МодульБухгалтерскийУчет = ОбщегоНазначения.ОбщийМодуль("БухгалтерскийУчет");
	СчетаДляСубконто = МодульБухгалтерскийУчет.СписокСчетов(СтрРазделить("205.00,208.00,209.00,303.00,26", ","));
	Запрос.УстановитьПараметр("СчетаДляСубконто", СчетаДляСубконто);  
	
	СчетаДляСубконто26 = МодульБухгалтерскийУчет.СписокСчетов(СтрРазделить("26", ","));
	Запрос.УстановитьПараметр("СчетаДляСубконто26", СчетаДляСубконто26);
	
	ПараметрыВыполнения.Вставить("СчетаДляСубконто", СчетаДляСубконто);
	
	СоответствиеТиповЗначений = Новый Соответствие;
	СоответствиеТиповЗначений.Вставить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты, "Справочник.Контрагенты");
	СоответствиеТиповЗначений.Вставить(ПланыВидовХарактеристик.ВидыСубконто.Договоры, "Справочник.Договоры");
	СоответствиеТиповЗначений.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ВидыНалоговИПлатежей, "Справочник.ВидыНалоговИПлатежей");
	СоответствиеТиповЗначений.Вставить(ПланыВидовХарактеристик.ВидыСубконто.НалогиИПлатежиОрганизации, "Справочник.НалогиИПлатежиОрганизации");
	СоответствиеТиповЗначений.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ВидыЦелевыхСредств, "Справочник.ВидыЦелевыхСредств");
	СоответствиеТиповЗначений.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ВидыРасчетовСПЛ, "Перечисление.ВидыРасчетовСПЛ");
	СоответствиеТиповЗначений.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства, "Справочник.ОсновныеСредства");
	СоответствиеТиповЗначений.Вставить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура, "Справочник.Номенклатура");
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДетальнаяТаблица = РезультатЗапроса[РезультатЗапроса.Количество()-2].Выгрузить(); 
	ГруппировкаТаблица = РезультатЗапроса[РезультатЗапроса.Количество()-1].Выгрузить(); 
	
	СубконтоНаСчетах = Новый Массив;
	
	Идентификатор = 1;
	Для каждого Группировка Из ГруппировкаТаблица Цикл
		СтруктураСубконтоНаСчетах = ПолучитьШаблонСтруктурыСубконтоНаСчетах(); 
		СтруктураСубконтоНаСчетах.Идентификатор = Идентификатор;
		ТипЗначенияСубконто = Новый Массив;
		МассивСубконто = Новый Массив;
		ДобавитьСубконтоВМассивы(Группировка.Субконто1, МассивСубконто, ТипЗначенияСубконто, СоответствиеТиповЗначений);
		ДобавитьСубконтоВМассивы(Группировка.Субконто2, МассивСубконто, ТипЗначенияСубконто, СоответствиеТиповЗначений);
		ДобавитьСубконтоВМассивы(Группировка.Субконто3, МассивСубконто, ТипЗначенияСубконто, СоответствиеТиповЗначений);
		СтруктураСубконтоНаСчетах.ТипЗначенияСубконто = ТипЗначенияСубконто;
		СтруктураСубконтоНаСчетах.МассивСубконто = МассивСубконто;
		Отбор = Новый Структура;
		Для каждого Колонка Из ГруппировкаТаблица.Колонки Цикл
			Отбор.Вставить(Колонка.Имя, Группировка[Колонка.Имя]);	
		КонецЦикла;
		СчетаСтроки = ДетальнаяТаблица.НайтиСтроки(Отбор);
		МассивСчетов = Новый Массив;
		Для каждого СчетСтрока Из СчетаСтроки Цикл
			МассивСчетов.Добавить(СчетСтрока.Ссылка);		
		КонецЦикла;
        СтруктураСубконтоНаСчетах.МассивСчетов = МассивСчетов;
		СубконтоНаСчетах.Добавить(СтруктураСубконтоНаСчетах);
		Идентификатор = Идентификатор + 1;
	КонецЦикла;
	Возврат СубконтоНаСчетах;
	
КонецФункции

Функция ПолучитьШаблонСтруктурыСубконтоНаСчетах()	
	
	СтруктураСубконтоНаСчетах = Новый Структура;
	СтруктураСубконтоНаСчетах.Вставить("Идентификатор");
	СтруктураСубконтоНаСчетах.Вставить("ТипЗначенияСубконто");
	СтруктураСубконтоНаСчетах.Вставить("МассивСубконто");
	СтруктураСубконтоНаСчетах.Вставить("МассивСчетов");
	Возврат СтруктураСубконтоНаСчетах; 
	
КонецФункции

Процедура ДобавитьСубконтоВМассивы(Субконто, МассивСубконто, ТипЗначенияСубконто, СоответствиеТиповЗначений)
	
	Если ЗначениеЗаполнено(Субконто) Тогда
		МассивСубконто.Добавить(Субконто);
		ТипЗначенияСубконто.Добавить(СоответствиеТиповЗначений.Получить(Субконто));
	КонецЕсли;
	
КонецПроцедуры	

Функция ВыполнитьПроверкуГруппировкиСчетов(ПараметрыВыполнения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕПСБУ.Код КАК Код
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |ГДЕ
	               |	&ДатаНачала МЕЖДУ ЕПСБУ.ДатаНачалаДействия И ВЫБОР
	               |			КОГДА ЕПСБУ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	               |				ТОГДА ДАТАВРЕМЯ(2999, 12, 31, 23, 59, 59)
	               |			ИНАЧЕ ДОБАВИТЬКДАТЕ(ЕПСБУ.ДатаОкончанияДействия, ГОД, 1)
	               |		КОНЕЦ
	               |	И ЕПСБУ.Код В(&СписокКодовПроверка)
	               |	И ЕПСБУ.ЭлементГруппа"; 
	Запрос.УстановитьПараметр("ДатаНачала", ПараметрыВыполнения.НачалоПериода); 
	СписокКодовПроверка = Новый Массив;
	СписокКодовПроверка.Добавить("401.10");
	СписокКодовПроверка.Добавить("401.20");
	СписокКодовПроверка.Добавить("401.40");
	Запрос.УстановитьПараметр("СписокКодовПроверка", СписокКодовПроверка);
	
	ВыборкаСчетов = Запрос.Выполнить().Выбрать();  
	НекорректныеГруппыСчетов = Новый Массив;
	Пока ВыборкаСчетов.Следующий() Цикл
		НекорректныеГруппыСчетов.Добавить(ВыборкаСчетов.Код);		
	КонецЦикла;	 
	Возврат НекорректныеГруппыСчетов;
	
КонецФункции
	
Функция ПолучитьТекстПолеВыбораПоСубконто(СтрокаСубконто, Суффикс)
	
	ТекстПолеВыбора = "";
	ИтерацияСубконто = 1;
		Для каждого Субкотно Из СтрокаСубконто.ТипЗначенияСубконто Цикл  
			ТекстПолеВыбора = ТекстПолеВыбора + "
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУДвиженияССубконто.Субконто" + Суффикс + "1) = ТИП(" + Субкотно + ")
			|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.Субконто" + Суффикс + "1
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУДвиженияССубконто.Субконто" + Суффикс + "2) = ТИП(" + Субкотно + ")
			|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.Субконто" + Суффикс + "2
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУДвиженияССубконто.Субконто" + Суффикс + "3) = ТИП(" + Субкотно + ")
			|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.Субконто" + Суффикс + "3
			|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка)
			|	КОНЕЦ,";
			ИтерацияСубконто = ИтерацияСубконто + 1;
		КонецЦикла;	
		
		Если ИтерацияСубконто <= 3 Тогда
			Для ИтерацияСубконто = ИтерацияСубконто По 3 Цикл
				ТекстПолеВыбора = ТекстПолеВыбора + "
				|	ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка),";
			КонецЦикла;	
		КонецЕсли;
		Возврат ТекстПолеВыбора;
	
КонецФункции

Функция ПолучитьGUIDГрафикаИсполнения(Выборка, СоответсвиеКодВидаСчета)
	
	МассивСчет = СтрРазделить(Выборка.СчетРасчетов, ".", Истина);		
	КодАналитическогоСубсчета = ?(МассивСчет.Количество() > 1, МассивСчет[1], "");
	КодВидаСчета = СоответсвиеКодВидаСчета[МассивСчет[0]];
	Возврат СтрЗаменить(XMLСтрока(Выборка.GUID), "-", "") + Выборка.КФО + КодВидаСчета + КодАналитическогоСубсчета;	
	
КонецФункции	

