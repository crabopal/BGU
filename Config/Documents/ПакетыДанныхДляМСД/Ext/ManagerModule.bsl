	КонецЕсли;
	
	СпецАналитикиНаборомВМенеджерВТ(МенеджерВТ, "OBJ_FIN_VL");      	
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ОбъектыФинансовыхВложений.Ссылка КАК Ссылка,
