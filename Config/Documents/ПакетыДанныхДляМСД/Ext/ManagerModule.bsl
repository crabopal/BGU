		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;	
		                
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, Объект_OS_V_PUTI);
	КонецЦикла;
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТАналитики_OS_V_PUTI; УНИЧТОЖИТЬ ВТАналитикиОС_В_ПУТИ_; УНИЧТОЖИТЬ ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет; УНИЧТОЖИТЬ ВТРасчетАмортизацииОС; 
