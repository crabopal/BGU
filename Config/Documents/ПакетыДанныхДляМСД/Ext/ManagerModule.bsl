	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПереносПоказателейПоСанкционированию.Ссылка,
	|	ПереносПоказателейПоСанкционированию.Дата
	|ИЗ
	|	Документ.ПереносПоказателейПоСанкционированию КАК ПереносПоказателейПоСанкционированию
	|ГДЕ
	|	ПереносПоказателейПоСанкционированию.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания",
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокументыМежотчетногоПериода.Документ КАК Документ,
	|	ДокументыМежотчетногоПериода.ДатаПроведения КАК ДатаПервичногоОтраженияВУчетеОперацииМО
	|ПОМЕСТИТЬ ВТ_МОРегистраторы
	|ИЗ
	|	РегистрСведений.ДатыПроведенияДокументов КАК ДокументыМежотчетногоПериода
	|ГДЕ
	|	ДокументыМежотчетногоПериода.ДатаПроведения МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОперацияБух.Ссылка,
	|	ОперацияБух.Дата
	|ИЗ
	|	Документ.ОперацияБух КАК ОперацияБух
	|ГДЕ
	|	ОперацияБух.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ ОперацияБух.ВидМежотчетногоПериода = ЗНАЧЕНИЕ(Перечисление.ВидыМежотчетногоПериода.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПереносОстатковПоКПС.Ссылка,
	|	ПереносОстатковПоКПС.Дата
	|ИЗ
	|	Документ.ПереносОстатковПоКПС КАК ПереносОстатковПоКПС
	|ГДЕ
	|	ПереносОстатковПоКПС.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ ПереносОстатковПоКПС.ВидМежотчетногоПериода = ЗНАЧЕНИЕ(Перечисление.ВидыМежотчетногоПериода.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КорректировкаРегистров.Ссылка,
	|	КорректировкаРегистров.Дата
	|ИЗ
	|	Документ.КорректировкаРегистров КАК КорректировкаРегистров
	|ГДЕ
	|	КорректировкаРегистров.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ КорректировкаРегистров.ВидМежотчетногоПериода = ЗНАЧЕНИЕ(Перечисление.ВидыМежотчетногоПериода.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗакрытиеСчетовСанкционирования.Ссылка,
	|	ЗакрытиеСчетовСанкционирования.Дата
	|ИЗ
	|	Документ.ЗакрытиеСчетовСанкционирования КАК ЗакрытиеСчетовСанкционирования
	|ГДЕ
	|	ЗакрытиеСчетовСанкционирования.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ ЗакрытиеСчетовСанкционирования.ВидМежотчетногоПериода = ЗНАЧЕНИЕ(Перечисление.ВидыМежотчетногоПериода.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПереносПоказателейПоСанкционированию.Ссылка,
	|	ПереносПоказателейПоСанкционированию.Дата
	|ИЗ
	|	Документ.ПереносПоказателейПоСанкционированию КАК ПереносПоказателейПоСанкционированию
	|ГДЕ
	|	ПереносПоказателейПоСанкционированию.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания") + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЖурналПроводокЕПСБУОбороты.СчетДт КАК Счет
	|ПОМЕСТИТЬ ВТОборотыСчет
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(&ДатаНачала, &ДатаОкончания, Запись, , , , , ) КАК ЖурналПроводокЕПСБУОбороты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЖурналПроводокЕПСБУОбороты.СчетКт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(&ДатаНачала, &ДатаОкончания, Запись, , , , , ) КАК ЖурналПроводокЕПСБУОбороты
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(, , Активность И Регистратор В (ВЫБРАТЬ ВТ_МОРегистраторы.Документ ИЗ ВТ_МОРегистраторы), , ) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(, , Активность И Регистратор В (ВЫБРАТЬ ВТ_МОРегистраторы.Документ ИЗ ВТ_МОРегистраторы), , ) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
	|		И НЕ ЕПСБУВидыСубконто1.НомерСтроки ЕСТЬ NULL КАК ЕстьДоговоры,
	|	НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
	|		И НЕ ЕПСБУВидыСубконто2.НомерСтроки ЕСТЬ NULL КАК ЕстьЦМО,
	|	НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
	|		И НЕ ЕПСБУВидыСубконто3.НомерСтроки ЕСТЬ NULL КАК ЕстьКонтрагенты
	|ИЗ
	|	ВТОборотыСчет КАК ВТОборотыСчет
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ВТОборотыСчет.Счет = ЕПСБУВидыСубконто.Ссылка
	|			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовхарактеристик.ВидыСубконто.ОсновныеСредства))
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто1
	|		ПО ВТОборотыСчет.Счет = ЕПСБУВидыСубконто1.Ссылка
	|			И (ЕПСБУВидыСубконто1.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовхарактеристик.ВидыСубконто.Договоры))
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто2
	|		ПО ВТОборотыСчет.Счет = ЕПСБУВидыСубконто2.Ссылка
	|			И (ЕПСБУВидыСубконто2.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовхарактеристик.ВидыСубконто.ЦМО))
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто3
	|		ПО ВТОборотыСчет.Счет = ЕПСБУВидыСубконто3.Ссылка
	|			И (ЕПСБУВидыСубконто3.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовхарактеристик.ВидыСубконто.Контрагенты))
	|ГДЕ
	|	(НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
	|				И НЕ ЕПСБУВидыСубконто1.НомерСтроки ЕСТЬ NULL
	|			ИЛИ НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
	|				И НЕ ЕПСБУВидыСубконто2.НомерСтроки ЕСТЬ NULL
	|			ИЛИ НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
	|				И НЕ ЕПСБУВидыСубконто3.НомерСтроки ЕСТЬ NULL)
	|	И НЕ(НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
	|				И НЕ ЕПСБУВидыСубконто1.НомерСтроки ЕСТЬ NULL
	|				И НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
	|				И НЕ ЕПСБУВидыСубконто2.НомерСтроки ЕСТЬ NULL
	|				И НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
	|				И НЕ ЕПСБУВидыСубконто3.НомерСтроки ЕСТЬ NULL)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОборотыСчет";
	
	Запрос.УстановитьПараметр("ДатаНачала", ПараметрыВыполнения.НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ПараметрыВыполнения.ОкончаниеПериода));
	
	ВыборкаРазрез = Запрос.Выполнить().Выбрать();
	
	МассивСрезСубконто = Новый Массив;
	
	Пока ВыборкаРазрез.Следующий() Цикл 
		СтрокаМассив = Новый Структура("ЕстьЦМО, ЕстьДоговоры, ЕстьКонтрагенты");
		ЗаполнитьЗначенияСвойств(СтрокаМассив, ВыборкаРазрез);
		МассивСрезСубконто.Добавить(СтрокаМассив);
		ШаблонВТ = Переносы_ПолучитьШаблонВТСтоимостьОбъектовОС(СтрокаМассив.ЕстьЦМО, СтрокаМассив.ЕстьДоговоры, СтрокаМассив.ЕстьКонтрагенты);
		ИмяВТ = "Есть" + ?(СтрокаМассив.ЕстьЦМО, "ЦМО", "") + ?(СтрокаМассив.ЕстьДоговоры, "Дог", "") + ?(СтрокаМассив.ЕстьКонтрагенты, "Кон", "");
		ШаблонВТ = СтрЗаменить(ШаблонВТ, "%ИмяВТСтоимостьОС", ИмяВТ);
		Если ПерваяИтерация Тогда
			ТекстЗапроса = ШаблонВТ + "
			|;
			|";
			ПерваяИтерация = Ложь;
		Иначе
			ТекстЗапроса = ТекстЗапроса + "
			|////////////////////////////////////////////////////////////////////////////////
			|" + ШаблонВТ + "
			|;
			|";		
		КонецЕсли;	
	КонецЦикла;
	ПараметрыВыполнения.Вставить("МассивСрезСубконто", МассивСрезСубконто);
	Возврат ТекстЗапроса;
	
КонецФункции 

Функция Переносы_ПолучитьШаблонВТСтоимостьОбъектовОС(ЕстьЦМО, ЕстьДоговоры, ЕстьКонтрагенты) 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСОбороты.Период КАК Период,
	|	СтоимостьОбъектовОСОбороты.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОбороты.ИнвентарныйНомер КАК ИнвентарныйНомер," + ?(ЕстьЦМО, "
	|	СтоимостьОбъектовОСОбороты.ЦМО КАК ЦМО,", "") + ?(ЕстьДоговоры, "
	|	СтоимостьОбъектовОСОбороты.Договор КАК Договор,", "") + "
	|	СУММА(СтоимостьОбъектовОСОбороты.СтоимостьОборот) КАК СтоимостьОборот,
	|	СУММА(СтоимостьОбъектовОСОбороты.КоличествоОборот) КАК КоличествоОборот," + ?(ЕстьКонтрагенты, "
	|	СтоимостьОбъектовОСОбороты.Контрагент КАК Контрагент,", "") + "
	|	СтоимостьОбъектовОСОбороты.Амортизация КАК Амортизация,
	|	СтоимостьОбъектовОСОбороты.Обесценение КАК Обесценение,
	|	СтоимостьОбъектовОСОбороты.Счет КАК Счет
	|ПОМЕСТИТЬ ДвиженияРН_%ИмяВТСтоимостьОС
	|ИЗ
	|	ДвиженияРН_ЕстьЦМОДогКон КАК СтоимостьОбъектовОСОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОбъектовОСОбороты.Обесценение," + ?(ЕстьЦМО, "
	|	СтоимостьОбъектовОСОбороты.ЦМО,", "") + ?(ЕстьДоговоры, "
	|	СтоимостьОбъектовОСОбороты.Договор,", "") + ?(ЕстьКонтрагенты, "
	|	СтоимостьОбъектовОСОбороты.Контрагент,", "") + "
	|	СтоимостьОбъектовОСОбороты.Счет,
	|	СтоимостьОбъектовОСОбороты.Амортизация,
	|	СтоимостьОбъектовОСОбороты.Период,
	|	СтоимостьОбъектовОСОбороты.ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОбороты.ОсновноеСредство";
	  
	Возврат ТекстЗапроса;
	
КонецФункции

Функция Переносы_ПолучитьТекстЗапросаДвиженияБУДоков(ПараметрыВыполнения)
	
	ПерваяИтерация = Истина;	
	Для каждого СтрокаМассив Из ПараметрыВыполнения.МассивСрезСубконто Цикл
		
		ШаблонВТ = Переносы_ПолучитьШаблонДвиженияБУДоков(СтрокаМассив.ЕстьЦМО, СтрокаМассив.ЕстьДоговоры, СтрокаМассив.ЕстьКонтрагенты);
		ИмяВТ = "Есть" + ?(СтрокаМассив.ЕстьЦМО, "ЦМО", "") + ?(СтрокаМассив.ЕстьДоговоры, "Дог", "") + ?(СтрокаМассив.ЕстьКонтрагенты, "Кон", "");
		ШаблонВТ = СтрЗаменить(ШаблонВТ, "%ИмяВТСтоимостьОС", ИмяВТ);
		Если ПерваяИтерация Тогда
			ТекстЗапроса = ШаблонВТ + "
			|;
			|";
			ПерваяИтерация = Ложь;
		Иначе
			ТекстЗапроса = ТекстЗапроса + "
			|////////////////////////////////////////////////////////////////////////////////
			|" + ШаблонВТ + "
			|;
			|";		
		КонецЕсли;
		
	КонецЦикла;

	Возврат ТекстЗапроса;	
	
КонецФункции

Функция Переносы_ПолучитьШаблонДвиженияБУДоков(ЕстьЦМО, ЕстьДоговоры, ЕстьКонтрагенты)
	
	ТекстЗапроса = " 	
	|ВЫБРАТЬ
	|	ДвиженияБУДоков.Период КАК Период, 
	|	ДвиженияБУДоков.Регистратор КАК Регистратор,
	|	ДвиженияБУДоков.ОсновноеСредство КАК ОсновноеСредство,
	|	ЕСТЬNULL(ДвиженияРН.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК ИнвентарныйНомер," + ?(ЕстьЦМО, "
	|	ЕСТЬNULL(ДвиженияРН.ЦМО, ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)) КАК ЦМО,", "") + ?(ЕстьДоговоры, "
	|	ЕСТЬNULL(ДвиженияРН.Договор, ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)) КАК Договор,", "") + "
	|	СУММА(ЕСТЬNULL(ДвиженияРН.СтоимостьОборот, 0)) КАК СтоимостьОборот,
	|	СУММА(ЕСТЬNULL(ДвиженияРН.КоличествоОборот, 0)) КАК КоличествоОборот,
	|	ЛОЖЬ КАК Забаланс," + ?(ЕстьКонтрагенты, "
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,", "") + "
	|	ДвиженияБУДоков.Амортизация КАК Амортизация,
	|	ДвиженияБУДоков.Обесценение КАК Обесценение,
	|	ДвиженияБУДоков.ЭтоРасход КАК ЭтоРасход,
	|	ДвиженияРН.Счет КАК Счет,
	|	ЕСТЬNULL(ОсновныеСредства.ГрупповойУчет, ЛОЖЬ) КАК ГрупповойУчет
	|ПОМЕСТИТЬ ДвиженияБУДоковОбработанная_%ИмяВТСтоимостьОС
	|ИЗ
	|	ДвиженияБУДоковСвернутая КАК ДвиженияБУДоков
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДвиженияРН_%ИмяВТСтоимостьОС КАК ДвиженияРН
	|		ПО ДвиженияБУДоков.ОсновноеСредство = ДвиженияРН.ОсновноеСредство
	|			И ДвиженияБУДоков.Амортизация = ДвиженияРН.Амортизация 
	|			И ДвиженияБУДоков.Обесценение = ДвиженияРН.Обесценение
	|			И ДвиженияБУДоков.Период >= ДвиженияРН.Период
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ПО ДвиженияБУДоков.ОсновноеСредство = ОсновныеСредства.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ДвиженияБУДоков.Период,
	|	ДвиженияБУДоков.Регистратор,
	|	ДвиженияБУДоков.ОсновноеСредство,
	|	ЕСТЬNULL(ДвиженияРН.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))," + ?(ЕстьЦМО, "
	|	ЕСТЬNULL(ДвиженияРН.ЦМО, ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)),", "") + ?(ЕстьДоговоры, "
	|	ЕСТЬNULL(ДвиженияРН.Договор, ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)),", "") + ?(ЕстьКонтрагенты, "
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),", "") + "
	|	ДвиженияБУДоков.Амортизация,
	|	ДвиженияБУДоков.Обесценение,
	|	ДвиженияБУДоков.ЭтоРасход,
	|	ДвиженияРН.Счет,
	|	ЕСТЬNULL(ОсновныеСредства.ГрупповойУчет, ЛОЖЬ)
	|
	|ИМЕЮЩИЕ
	|	(СУММА(ДвиженияРН.КоличествоОборот) <> 0
	|		ИЛИ СУММА(ДвиженияРН.СтоимостьОборот) <> 0)";
		  
	Возврат ТекстЗапроса;

КонецФункции	

