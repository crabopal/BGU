	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ДвиженияБУДоковОбработанная_ЕстьЦМОДогКон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ДвиженияБУДоковОбработанная_НетЦМОДогКон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ДвиженияБУДоковОбработанная_АмортОбесц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОборотыОС_ПоИнвентарным_ЕстьЦМОДогКон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОборотыОС_ПоИнвентарным_НетЦМОДогКон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОборотыОС_ПоИнвентарным_АмортОбесц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////"; 
	
	Для каждого СтрокаМассив ИЗ ПараметрыВыполнения.МассивСрезСубконто Цикл 
		ИмяВТ = "Есть" + ?(СтрокаМассив.ЕстьЦМО, "ЦМО", "") + ?(СтрокаМассив.ЕстьДоговоры, "Дог", "") + ?(СтрокаМассив.ЕстьКонтрагенты, "Кон", "");
		ТекстЗапроса = ТекстЗапроса + "
		|УНИЧТОЖИТЬ  ДвиженияРН_" + ИмяВТ + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ  ДвиженияБУДоковОбработанная_" + ИмяВТ + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ  ВТОборотыОС_ПоИнвентарным_" + ИмяВТ + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////";		
	КонецЦикла;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьТекстЗапросаОбороты(ПараметрыВыполнения)
	
	СубконтоНаСчетах = ПараметрыВыполнения.СубконтоНаСчетах;
	ТекстЗапроса = ""; 

	Для каждого СтрокаСубконто Из СубконтоНаСчетах Цикл	

		ТекстПолеВыбораДт = ПолучитьТекстПолеВыбораПоСубконто(СтрокаСубконто, "Дт");
		ТекстПолеВыбораКт = ПолучитьТекстПолеВыбораПоСубконто(СтрокаСубконто, "Кт");
				
		УсловиеСчетаОборотыДт = "";
		УсловиеСчетаОборотыКт = "";
		
		Для каждого СтрокаСубконтоВложенный Из СубконтоНаСчетах Цикл 
			ТекстПолеВыбораВложенныйКт = ПолучитьТекстПолеВыбораПоСубконто(СтрокаСубконтоВложенный, "Кт");
			ТекстЗапроса = ТекстЗапроса + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУДвиженияССубконто.Период,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.Организация,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт," + 
			ТекстПолеВыбораДт + 
			ТекстПолеВыбораВложенныйКт + "
			|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоДт,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаКт,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаДт,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаКт,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.ПолучитьИнвНомер КАК ПолучитьИнвНомер,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.МежотчетныйПериод КАК МежотчетныйПериод,
			|	ЖурналПроводокЕПСБУДвиженияССубконто.ЗаключениеСчетов КАК ЗаключениеСчетов

			|ИЗ
			|	ВТ_ЖурналПроводокЕПСБУДвиженияССубконто_Предварительно КАК ЖурналПроводокЕПСБУДвиженияССубконто
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОрганизацииФедеральногоБюджета КАК ВТОрганизацииФедеральногоБюджета
			|		ПО ЖурналПроводокЕПСБУДвиженияССубконто.Организация = ВТОрганизацииФедеральногоБюджета.Организация
			|ГДЕ
			|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт В (&Счета_" + СтрокаСубконто.Идентификатор + ")
			|	И ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В (&Счета_" + СтрокаСубконтоВложенный.Идентификатор + ")";	
			
			УсловиеСчетаОборотыДт = УсловиеСчетаОборотыДт + ?(УсловиеСчетаОборотыДт = "", "", " И ") + "НЕ ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт В (&Счета_" + СтрокаСубконтоВложенный.Идентификатор + ")";	
			УсловиеСчетаОборотыКт = УсловиеСчетаОборотыКт + ?(УсловиеСчетаОборотыКт = "", "", " И ") + "НЕ ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В (&Счета_" + СтрокаСубконтоВложенный.Идентификатор + ")";
		КонецЦикла;
		
		ТекстЗапроса = ТекстЗапроса + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Период,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Организация,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
