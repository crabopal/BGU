	|			ТОГДА ""2""
	|		ИНАЧЕ ""3""
	|	КОНЕЦ КАК VID_CENN_BUM,
	|	ВЫБОР
	|		КОГДА ОбъектыФинансовыхВложений.ФормаУчастияВКапитале = ЗНАЧЕНИЕ(Перечисление.ФормыУчастияВКапитале.Акции)
	|			ТОГДА ""1""
	|		КОГДА ОбъектыФинансовыхВложений.ФормаУчастияВКапитале = ЗНАЧЕНИЕ(Перечисление.ФормыУчастияВКапитале.Вклады)
	|			ТОГДА ""2""
	|		ИНАЧЕ ""3""
	|	КОНЕЦ КАК FORMA_UCH_CAP,
	|	ВЫБОР
	|		КОГДА ОбъектыФинансовыхВложений.Документарные
	|			ТОГДА ""1""
	|		ИНАЧЕ ""0""
	|	КОНЕЦ КАК DOKUMENTAR,
	|	ОбъектыФинансовыхВложений.РНФИ КАК NUM_REESTR,
	|	ОбъектыФинансовыхВложений.РегистрационныйНомер КАК REG_NOM,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ОбъектыФинансовыхВложений.Контрагент) КАК GUIDКонтрагент,
	|	ОбъектыФинансовыхВложений.Контрагент КАК Контрагент
	|ИЗ
	|	ВТАналитики_OBJ_FIN_VL КАК ВТАналитики
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыФинансовыхВложений КАК ОбъектыФинансовыхВложений
	|		ПО ВТАналитики.Аналитика = ОбъектыФинансовыхВложений.Ссылка");       
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	НН = ПараметрыВыполнения.НаборИсторияПроверкиАналитик.Количество();
	МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("OBJ_FIN_VL", ПараметрыВыполнения);
	
	Выборка 				= Запрос.Выполнить().Выбрать();
	СтруктураРеквизитов = СтруктураРеквизитовАналитики("OBJ_FIN_VL", ПараметрыВыполнения);
	Пока Выборка.Следующий() Цикл  
		ОбъектOBJ_FIN_VL = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "OBJ_FIN_VL")); 
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, Выборка); 
		СтруктураРеквизитов.GUID = XMLСтрока(Выборка.GUID);    
		
		пЗаполнитьЗначенияСвойств(ОбъектOBJ_FIN_VL, СтруктураРеквизитов);
		Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
			ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, "OBJ_FIN_VL", Строка(Выборка.NAME), НН, МассивОбязательныхРеквизитов);
		КонецЕсли;		
		
		ОбъектOBJ_FIN_VL.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");  
		ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("OBJ_FIN_VL_" + ОбъектOBJ_FIN_VL.GUID, ОбъектOBJ_FIN_VL.ID);
		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;	
		Если СтруктураРеквизитов.Свойство("KONTRAGENT") Тогда
			ИД_Контрагента = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("KONTRAGENT_" + XMLСтрока(Выборка.GUIDКонтрагент));
			ОбъектOBJ_FIN_VL.KONTRAGENT = ?(ЗначениеЗаполнено(ИД_Контрагента), ИД_Контрагента, "");
		КонецЕсли;
		                
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектOBJ_FIN_VL);
	КонецЦикла;    
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТАналитики_OBJ_FIN_VL"); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры  

Процедура GRAF_ISP(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения)
	
	ЗаписьXML = ОбщийОбъект;
	
	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.GRAF_ISP(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	ПолучитьАналитикиГрафикИсполнения(МенеджерВТ, ПараметрыВыполнения.ОкончаниеПериода); 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВТАналитики.Договор КАК Договор,
	|	Договоры.ВестиГрафикПлатежей КАК ВестиГрафикПлатежей,
	|	Договоры.ВестиПланГрафикИсполнения КАК ВестиПланГрафикИсполнения,
	|	ВТАналитики.Контрагент КАК Контрагент,
	|	ВТАналитики.СчетРасчетов КАК СчетРасчетов,
	|	ВТАналитики.КФО КАК КФО, 
	|	ВТАналитики.КПС КАК КПС,
	|	ВТАналитики.СуммаОстаток КАК СуммаОстаток
	|ПОМЕСТИТЬ ВТАналитики_GRAF_ISP_Предварительно
	|ИЗ
	|	ВТАналитики_GRAF_ISP КАК ВТАналитики
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
	|		ПО ВТАналитики.Договор = Договоры.Ссылка
	|		И ВТАналитики.Контрагент = Договоры.Контрагент
	|
	|ГДЕ
	|	ВТАналитики.СуммаОстаток <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТАналитики.Договор КАК Договор,
	|	ВТАналитики.ВестиГрафикПлатежей КАК ВестиГрафикПлатежей,
	|	ВТАналитики.ВестиПланГрафикИсполнения КАК ВестиПланГрафикИсполнения,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТАналитики.Договор) КАК GUID,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТАналитики.Контрагент) КАК GUIDКонтрагент,
	|	ВТАналитики.Контрагент КАК Контрагент,
	|	ВТАналитики.СчетРасчетов КАК СчетРасчетов,
	|	ВТАналитики.КФО КАК КФО,
	|	СУММА(ВЫБОР
	|		КОГДА ВТАналитики.СуммаОстаток > 0
	|			ТОГДА ВТАналитики.СуммаОстаток
	|		ИНАЧЕ -ВТАналитики.СуммаОстаток
	|	КОНЕЦ) КАК СуммаОстаток
	|ИЗ
	|	ВТАналитики_GRAF_ISP_Предварительно КАК ВТАналитики
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТАналитики.Договор,
	|	ВТАналитики.ВестиГрафикПлатежей,
	|	ВТАналитики.ВестиПланГрафикИсполнения, 
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТАналитики.Договор),
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТАналитики.Контрагент),
	|	ВТАналитики.Контрагент, 
	|	ВТАналитики.СчетРасчетов,
	|	ВТАналитики.КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТАналитики.Договор КАК Договор,
	|	ВТАналитики.ВестиГрафикПлатежей КАК ВестиГрафикПлатежей,
	|	ВТАналитики.ВестиПланГрафикИсполнения КАК ВестиПланГрафикИсполнения,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТАналитики.Договор) КАК GUID,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТАналитики.Контрагент) КАК GUIDКонтрагент,
	|	ВТАналитики.Контрагент КАК Контрагент,
	|	ВТАналитики.СчетРасчетов КАК СчетРасчетов,
	|	ВТАналитики.КФО КАК КФО,
	|	ВТАналитики.КПС КАК КПС,
	|	СУММА(ВЫБОР
	|		КОГДА ВТАналитики.СуммаОстаток > 0
	|			ТОГДА ВТАналитики.СуммаОстаток
	|		ИНАЧЕ -ВТАналитики.СуммаОстаток
	|	КОНЕЦ) КАК СуммаОстаток
	|ИЗ
	|	ВТАналитики_GRAF_ISP_Предварительно КАК ВТАналитики
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТАналитики.Договор,
	|	ВТАналитики.ВестиГрафикПлатежей,
	|	ВТАналитики.ВестиПланГрафикИсполнения, 
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТАналитики.Договор),
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТАналитики.Контрагент),
	|	ВТАналитики.Контрагент, 
	|	ВТАналитики.СчетРасчетов,
	|	ВТАналитики.КФО,
	|	ВТАналитики.КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТАналитики_GRAF_ISP
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТАналитики_GRAF_ISP_Предварительно");
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Результат = Запрос.ВыполнитьПакет();
	ТаблицаОтбор = Результат[Результат.Количество()-4].Выгрузить(); 
	ТаблицаОтборКПС = Результат[Результат.Количество()-3].Выгрузить();
	Результат = Неопределено;
	
	ЗаписьСобытияВЖурналРегистрации(СтрШаблон(НСтр("ru = 'Получение данных для формирования графика исполнения обязательств (%1 строк договоров). Начало'"), Строка(ТаблицаОтбор.Количество())));
	
	ЗапросГрафика = Новый Запрос("ВЫБРАТЬ
	                             |	Таблица.Договор КАК Договор, 
	                             |	Таблица.Контрагент КАК Контрагент,
	                             |	Таблица.ВидРасчетов КАК ВидРасчетов,
								 |	Таблица.ВидЗадолженности КАК ВидЗадолженности,
	                             |	Таблица.СчетРасчетов КАК СчетРасчетов,
	                             |	Таблица.КПС КАК КПС,
	                             |	Таблица.КФО КАК КФО,
	                             |	Таблица.СрокИсполнения КАК СрокИсполнения,
	                             |	Таблица.Остаток КАК Остаток
	                             |ПОМЕСТИТЬ ВТ
	                             |ИЗ
	                             |	&Таблица КАК Таблица
	                             |;
	                             |
	                             |////////////////////////////////////////////////////////////////////////////////
	                             |ВЫБРАТЬ
	                             |	ВТ.Договор КАК Договор,
	                             |	ВТ.Контрагент КАК Контрагент,
	                             |	ВТ.ВидРасчетов КАК ВидРасчетов,
								 |	ВТ.ВидЗадолженности КАК ВидЗадолженности,
	                             |	ВТ.СчетРасчетов КАК СчетРасчетов,
	                             |	ЕСТЬNULL(КлассификационныеПризнакиСчетов.Код,"""") КАК КПС,
	                             |	ВТ.КПС КАК КПССсылка,
	                             |	ВТ.КФО КАК КФО,
	                             |	ВТ.Остаток КАК Сумма,
	                             |	ВТ.СрокИсполнения КАК Дата
	                             |ИЗ
	                             |	ВТ КАК ВТ
	                             |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификационныеПризнакиСчетов КАК КлассификационныеПризнакиСчетов
	                             |		ПО ВТ.КПС = КлассификационныеПризнакиСчетов.Ссылка
	            	             |ГДЕ
	                             |	ВТ.Остаток <> 0
								 |
								 |УПОРЯДОЧИТЬ ПО
	                             |	Дата");
	
	МодульКонтрольИсполненияДоговоров = ОбщегоНазначения.ОбщийМодуль("КонтрольИсполненияДоговоров");
	
	СтандартнаяОбработка = Истина;
	Таблица = Неопределено; 

	МодульСбораДанныхПереопределяемый.КонтрольИсполненияДоговоровГрафик(Таблица, ТаблицаОтбор, ПараметрыВыполнения, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		Таблица = МодульКонтрольИсполненияДоговоров.АнализЗадолженности(ПараметрыВыполнения.Организация,
		ПараметрыВыполнения.ОкончаниеПериода,
		ТаблицаОтбор);
	КонецЕсли;
	
	ЗапросГрафика.УстановитьПараметр("Таблица", Таблица);
	ТаблицаГрафика = ЗапросГрафика.Выполнить().Выгрузить();
	ТаблицаГрафика.Индексы.Добавить("Договор"); 
	Таблица = Неопределено;

	
	ТаблицаИдентификаторовGRAF_ISP = Новый ТаблицаЗначений;
	
	ТаблицаИдентификаторовGRAF_ISP.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаИдентификаторовGRAF_ISP.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.Договоры")); 
	ТаблицаИдентификаторовGRAF_ISP.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД")); 
	ТаблицаИдентификаторовGRAF_ISP.Колонки.Добавить("УИ_GRAF_ISP", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ТаблицаИдентификаторовGRAF_ISP.Индексы.Добавить("УИ_GRAF_ISP");

	СписокДоговоров = ТаблицаОтбор.ВыгрузитьКолонку("Договор");

	Если ПолучитьФункциональнуюОпцию("СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств") Тогда
		МодульУчетРасчетов = ОбщегоНазначения.ОбщийМодуль("УчетРасчетов");
	    СвойстваДоговоров = МодульУчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам(СписокДоговоров, ПараметрыВыполнения.ОкончаниеПериода);
	Иначе // Дата исполнения указывается в справочнике "Договоры" в реквизите "Окончание" (закладка "Свойства").
		МодульИнвентаризацияСервер = ОбщегоНазначения.ОбщийМодуль("ИнвентаризацияСервер");
		СвойстваДоговоров = МодульИнвентаризацияСервер.ПолучитьДатыОкончанияДоговоров(СписокДоговоров);
	КонецЕсли;
	
	СоответсвиеКодВидаСчета = ПолучитьСоответсвиеКодВидаСчета();
	
	МодульБухгалтерскийУчет = ОбщегоНазначения.ОбщийМодуль("БухгалтерскийУчет");
	ЗаписьСобытияВЖурналРегистрации(СтрШаблон(НСтр("ru = 'Получение данных для формирования графика исполнения обязательств (%1 записей для %2 договоров). Конец'"), Строка(ТаблицаГрафика.Количество()), Строка(ТаблицаОтбор.Количество())));
	СтруктураРеквизитовГрафика = СтруктураРеквизитовАналитики("GRAF_ISP", ПараметрыВыполнения);
	Если СтруктураРеквизитовГрафика.Свойство("GRAFIK_ISP_DETAIL") Тогда
		СтруктураРеквизитов = СтруктураРеквизитовАналитики("GRAFIK_ISP_DETAIL", ПараметрыВыполнения);
		Для каждого Выборка Из ТаблицаОтбор Цикл 
			ОтборДетали = Новый Структура;
			ОтборДетали.Вставить("Договор", Выборка.Договор);
			ОтборДетали.Вставить("Контрагент", Выборка.Контрагент);
			
			МассивСчет = СтрРазделить(Выборка.СчетРасчетов, ".", Истина);			
			КодАналитическогоСубсчета = ?(МассивСчет.Количество() > 1, МассивСчет[1], "");
			Если МассивСчет[0] = "206" Тогда
				СчетРасчетов = "302" + ?(МассивСчет.Количество() > 1, "." + КодАналитическогоСубсчета, "");
				СчетРасчетовСсылка = МодульБухгалтерскийУчет.СчетПоКоду(СчетРасчетов, ПараметрыВыполнения.ОкончаниеПериода); 
				ОтборДетали.Вставить("СчетРасчетов", СчетРасчетовСсылка);
				ОтборДетали.Вставить("ВидЗадолженности", Перечисления.ВидыЗадолженности.Дебиторская);
			ИначеЕсли МассивСчет[0] = "302" Тогда
				ОтборДетали.Вставить("СчетРасчетов", Выборка.СчетРасчетов);
				ОтборДетали.Вставить("ВидЗадолженности", Перечисления.ВидыЗадолженности.Кредиторская);
			Иначе
				ОтборДетали.Вставить("СчетРасчетов", Выборка.СчетРасчетов);
			КонецЕсли;

			ОтборДетали.Вставить("КФО", Выборка.КФО);
			
			ОбъектGRAFIK = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "GRAFIK_ISP_DETAIL"));			
			GUID_GRAFIK = ПолучитьGUIDГрафикаИсполнения(Выборка, СоответсвиеКодВидаСчета);
			СтрокиGUID_GRAFIK = ТаблицаИдентификаторовGRAF_ISP.НайтиСтроки(Новый Структура("УИ_GRAF_ISP", GUID_GRAFIK)); 
			Если НЕ СтрокиGUID_GRAFIK.Количество() Тогда
				НовСтрокаGUID_GRAFIK = ТаблицаИдентификаторовGRAF_ISP.Добавить();
				НовСтрокаGUID_GRAFIK.Счет = Выборка.СчетРасчетов;
				НовСтрокаGUID_GRAFIK.Договор = Выборка.Договор;
				НовСтрокаGUID_GRAFIK.КФО = Выборка.КФО;
				НовСтрокаGUID_GRAFIK.УИ_GRAF_ISP = GUID_GRAFIK;	
			КонецЕсли; 
		
			ОбъектGRAFIK.OWNER = GUID_GRAFIK;
			ОбъектGRAFIK.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");
			ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("GRAFIK_ISP_DETAIL_" + ОбъектGRAFIK.OWNER, ОбъектGRAFIK.ID);
			ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
			п_НН = 1;
			
			ТаблицаГрафики = Новый ТаблицаЗначений;
			ТаблицаГрафики.Колонки.Добавить("ROWNUM"); 
			ТаблицаГрафики.Колонки.Добавить("DATE");
            ТаблицаГрафики.Колонки.Добавить("SUMMA");
			ТаблицаГрафики.Колонки.Добавить("KPS");
            ТаблицаГрафики.Колонки.Добавить("KOD_VID_RASCH_Z_KR");
			
			п_Детали = ТаблицаГрафика.НайтиСтроки(ОтборДетали);
			Если Не п_Детали.Количество() = 0  Тогда
				СуммаОстатокПоУчету = Выборка.СуммаОстаток;
				СуммаОстатокПоГрафику = 0;
				Для Каждого ВыборкаГрафикаДетали Из п_Детали Цикл
					СуммаОстатокПоГрафику = СуммаОстатокПоГрафику + ВыборкаГрафикаДетали.Сумма;	
				КонецЦикла;
				РазницаОстатки = СуммаОстатокПоУчету - СуммаОстатокПоГрафику;
							
				Для Каждого ВыборкаГрафикаДетали Из п_Детали Цикл 
					
					Сумма = ВыборкаГрафикаДетали.Сумма;
					Если РазницаОстатки < 0 Тогда
						КОтражению = Мин(СуммаОстатокПоУчету, ВыборкаГрафикаДетали.Сумма);
						Сумма	   = КОтражению;		
						СуммаОстатокПоУчету = СуммаОстатокПоУчету - КОтражению;	
					КонецЕсли;
					
					СрокИсполнения = ?(ТипЗнч(ВыборкаГрафикаДетали.Дата) = Тип("Дата"), ВыборкаГрафикаДетали.Дата, Дата(1,1,1));
					Если Не ЗначениеЗаполнено(СрокИсполнения) Тогда
						СрокИсполнения = ПолучитьСрокИсполнения(СвойстваДоговоров, Выборка, ПараметрыВыполнения);
						СтрокиДатаНеопределена = ТаблицаГрафики.НайтиСтроки(Новый Структура("DATE", СрокИсполнения));
						Если Не СтрокиДатаНеопределена.Количество() = 0 Тогда
							новСтрока = СтрокиДатаНеопределена[0];
							новСтрока.SUMMA = новСтрока.SUMMA + Сумма;
							Если СуммаОстатокПоУчету = 0 Тогда
								Прервать;
							Иначе
								Продолжить;
							КонецЕсли;
						КонецЕсли;	
					КонецЕсли;
					
					новСтрока =  ТаблицаГрафики.Добавить();
					новСтрока.ROWNUM 	= п_НН; 
					новСтрока.DATE 		= СрокИсполнения;
					новСтрока.SUMMA		= Сумма;
					новСтрока.KPS		= ВыборкаГрафикаДетали.КПС;
					новСтрока.KOD_VID_RASCH_Z_KR = f_VID_RACH_ZAIM_KR(Неопределено, Новый Структура("Субконто1, Субконто2, Субконто3", ВыборкаГрафикаДетали.ВидРасчетов), "");
					Если СуммаОстатокПоУчету = 0 Тогда
						Прервать;
					КонецЕсли;	
					п_НН = п_НН + 1;
					
				КонецЦикла;
				Если РазницаОстатки > 0 Тогда
					СрокИсполнения = ПолучитьСрокИсполнения(СвойстваДоговоров, Выборка, ПараметрыВыполнения);			
					СтрокиДатаНеопределена = ТаблицаГрафики.НайтиСтроки(Новый Структура("DATE", СрокИсполнения));
					Если СтрокиДатаНеопределена.Количество() = 0 Тогда  
						новСтрока =   ТаблицаГрафики.Добавить();
						новСтрока.ROWNUM 	= п_НН; 
						новСтрока.DATE 		= СрокИсполнения;
						новСтрока.SUMMA		= РазницаОстатки;
						новСтрока.KPS		= ВыборкаГрафикаДетали.КПС;
						новСтрока.KOD_VID_RASCH_Z_KR = "1";
					Иначе	
						новСтрока = СтрокиДатаНеопределена[0];
						новСтрока.SUMMA = новСтрока.SUMMA + РазницаОстатки;
					КонецЕсли;								
				КонецЕсли;  
			Иначе
				ОкончаниеДоговора = ПолучитьСрокИсполнения(СвойстваДоговоров, Выборка, ПараметрыВыполнения);

				ОтборДетали = Новый Структура;
				ОтборДетали.Вставить("Договор", Выборка.Договор);
				ОтборДетали.Вставить("Контрагент", Выборка.Контрагент);
				ОтборДетали.Вставить("СчетРасчетов", Выборка.СчетРасчетов);
				ОтборДетали.Вставить("КФО", Выборка.КФО);
				
				п_Детали = ТаблицаОтборКПС.НайтиСтроки(ОтборДетали);
										
				Для Каждого ВыборкаГрафикаДетали Из п_Детали Цикл 			
					новСтрока =  ТаблицаГрафики.Добавить();
					новСтрока.ROWNUM 	= 1; 
					новСтрока.DATE 		= ОкончаниеДоговора;
					новСтрока.SUMMA		= ВыборкаГрафикаДетали.СуммаОстаток;
					новСтрока.KPS		= Строка(ВыборкаГрафикаДетали.КПС);
					новСтрока.KOD_VID_RASCH_Z_KR = "1";						
				КонецЦикла;	
			КонецЕсли; 
			
			Для каждого СтрокаТаблицаГрафик Из ТаблицаГрафики Цикл
				новСтрока = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "GRAFIK_ISP_DETAIL").Свойства.Получить("ROW").Тип);
				ЗаполнитьЗначенияСвойств(новСтрока, СтрокаТаблицаГрафик);
				ОбъектGRAFIK.ROW.Добавить(новСтрока);
			КонецЦикла;	
			ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектGRAFIK);
		КонецЦикла;
		
	КонецЕсли;
		
	Для каждого Выборка Из ТаблицаОтбор Цикл
		GUID_GRAFIK = ПолучитьGUIDГрафикаИсполнения(Выборка, СоответсвиеКодВидаСчета);			
		ИД_Графика = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("GRAFIK_ISP_DETAIL_" + GUID_GRAFIK);
		Если ЗначениеЗаполнено(ИД_Графика) Тогда
			ОбъектGRAF_ISP = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "GRAF_ISP"));
			ОбъектGRAF_ISP.GUID = GUID_GRAFIK; 
			ОбъектGRAF_ISP.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");
			ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("GRAF_ISP_" + ОбъектGRAF_ISP.GUID, ОбъектGRAF_ISP.ID);
			ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
			
			Если СтруктураРеквизитовГрафика.Свойство("KONTRAGENT") Тогда
				ИД_Контрагента = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("KONTRAGENT_" + XMLСтрока(Выборка.GUIDКонтрагент));
				ОбъектGRAF_ISP.KONTRAGENT = ?(ЗначениеЗаполнено(ИД_Контрагента), ИД_Контрагента, "");
			КонецЕсли;
			
			Если СтруктураРеквизитовГрафика.Свойство("GRAFIK_ISP_DETAIL") Тогда
				ИД_Графика = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("GRAFIK_ISP_DETAIL_" + ОбъектGRAF_ISP.GUID);
				ОбъектGRAF_ISP.GRAFIK_ISP_DETAIL = ?(ЗначениеЗаполнено(ИД_Графика), ИД_Графика, "");
			КонецЕсли;
			
			ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектGRAF_ISP);
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	| ТаблицаИдентификаторовGRAF_ISP.Счет, 
	| ТаблицаИдентификаторовGRAF_ISP.Договор, 
	| ТаблицаИдентификаторовGRAF_ISP.КФО,
	| ТаблицаИдентификаторовGRAF_ISP.УИ_GRAF_ISP
	|ПОМЕСТИТЬ ВТ_ТаблицаИдентификаторовGRAF_ISP 
	|ИЗ 
	| &ТаблицаИдентификаторовGRAF_ISP КАК ТаблицаИдентификаторовGRAF_ISP");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ТаблицаИдентификаторовGRAF_ISP", ТаблицаИдентификаторовGRAF_ISP);
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура VID_PLAT_BUDJ(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения)
	
	ЗаписьXML = ОбщийОбъект;
	
	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.VID_PLAT_BUDJ(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	СпецАналитикуВМенеджерВТ(МенеджерВТ, МодульОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПланыВидовХарактеристик.ВидыСубконто.ВидыНалоговИПлатежей), "VID_PLAT_BUDJ",,ПараметрыВыполнения);      
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВидыНалоговИПлатежей.Ссылка КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВидыНалоговИПлатежей.Ссылка) КАК GUID,
	|	ВидыНалоговИПлатежей.Наименование КАК NAME,
	|	ВидыНалоговИПлатежей.КодГлавыБК КАК GLAVA,
	|	ВидыНалоговИПлатежей.Классификатор КАК KBK,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ВидыНалоговИПлатежей.ВидКлассификатора) КАК VID_KBK,
	|	ВидыНалоговИПлатежей.СчетУчета КАК KOD_SCHET_EPSBU
	|ИЗ
	|	ВТАналитики_VID_PLAT_BUDJ КАК ВТАналитики
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНалоговИПлатежей КАК ВидыНалоговИПлатежей
	|		ПО ВТАналитики.Аналитика = ВидыНалоговИПлатежей.Ссылка");       
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	НН = ПараметрыВыполнения.НаборИсторияПроверкиАналитик.Количество();
	МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("VID_PLAT_BUDJ", ПараметрыВыполнения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	СтруктураРеквизитов = СтруктураРеквизитовАналитики("VID_PLAT_BUDJ", ПараметрыВыполнения);
	Пока Выборка.Следующий() Цикл  
		Объект_VID_PLAT_BUDJ = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "VID_PLAT_BUDJ")); 
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, Выборка);
		СтруктураРеквизитов.NAME = Лев(СтруктураРеквизитов.NAME, 80);
		СтруктураРеквизитов.GUID = XMLСтрока(Выборка.GUID);                                    
		
		пЗаполнитьЗначенияСвойств(Объект_VID_PLAT_BUDJ, СтруктураРеквизитов);
		Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
			ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, "VID_PLAT_BUDJ", Строка(Выборка.NAME), НН, МассивОбязательныхРеквизитов);
		КонецЕсли;
		
		Объект_VID_PLAT_BUDJ.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");  
		ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("VID_PLAT_BUDJ_" + Объект_VID_PLAT_BUDJ.GUID, Объект_VID_PLAT_BUDJ.ID);
		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;		
               
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, Объект_VID_PLAT_BUDJ);
	КонецЦикла;    
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТАналитики_VID_PLAT_BUDJ"); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
