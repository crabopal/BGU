	|УНИЧТОЖИТЬ ВТСведенияКадастровогоУчета; УНИЧТОЖИТЬ ВТ_СобытияОССрез; УНИЧТОЖИТЬ ВТ_СобытияОС; УНИЧТОЖИТЬ ВТ_ИнвНомера"); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры  

Процедура OS_NMA_NPA_ARENDA(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения)
	
	ЗаписьXML = ОбщийОбъект;
	
	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.OS_NMA_NPA_ARENDA(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	СпецАналитикуВМенеджерВТ(МенеджерВТ, МодульОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства), "OS_NMA_NPA_ARENDA",,ПараметрыВыполнения);      
	
	#Область ТекстЗапроса
	
	Запрос = Новый Запрос(	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(ИнвентарныеНомераОС.ОС, ВТАналитики_OS_NMA_NPA_ARENDA.Аналитика) КАК Аналитика,
	|	ВТАналитики_OS_NMA_NPA_ARENDA.Аналитика КАК GUID		
	|ПОМЕСТИТЬ ВТАналитикиОС_НМА_НПА_Аренда_
	|ИЗ
	|	ВТАналитики_OS_NMA_NPA_ARENDA КАК ВТАналитики_OS_NMA_NPA_ARENDA
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|		ПО ВТАналитики_OS_NMA_NPA_ARENDA.Аналитика = ИнвентарныеНомераОС.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Аналитика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации
	|ПОМЕСТИТЬ ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет
