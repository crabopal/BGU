	|	ВТ_ОборотыСАналитиками.TypeKBK_Dt,
	|	ВТ_ОборотыСАналитиками.TypeKBK_Kt,
	|	ВТ_ОборотыСАналитиками.KOSGU_Dt,
	|	ВТ_ОборотыСАналитиками.KOSGU_Kt,
	|	ВТ_ОборотыСАналитиками.Val_Dt,
	|	ВТ_ОборотыСАналитиками.Val_Kt,
	|	ВТ_ОборотыСАналитиками.СубСчетДт, 
	|	ВТ_ОборотыСАналитиками.СубСчетКт,
	|	ВТ_ОборотыСАналитиками.АналитикаДт1,
	|	ВТ_ОборотыСАналитиками.АналитикаДт2,
	|	ВТ_ОборотыСАналитиками.АналитикаДт3,
	|	ВТ_ОборотыСАналитиками.АналитикаДт4,
	|	ВТ_ОборотыСАналитиками.АналитикаДт5,
	|	ВТ_ОборотыСАналитиками.АналитикаДт6,
	|	ВТ_ОборотыСАналитиками.АналитикаКт1,
	|	ВТ_ОборотыСАналитиками.АналитикаКт2,
	|	ВТ_ОборотыСАналитиками.АналитикаКт3,
	|	ВТ_ОборотыСАналитиками.АналитикаКт4,
	|	ВТ_ОборотыСАналитиками.АналитикаКт5,
	|	ВТ_ОборотыСАналитиками.АналитикаКт6,
	|	%ГруппировкаВТОборотыСАналитиками
	|	ДЕНЬ(ВТ_ОборотыСАналитиками.Date)
	|ИТОГИ ПО
	|	День";
	#КонецОбласти
	
	ПоляЗначенияАналитикВТОбороты = "";
	СоединенияЗначенияАналитик = "";
	ПоляЗначенияАналитикВТОборотыСАналитиками = "";
	ГруппировкаВТОборотыСАналитиками = "";
	
	ЗапросАналитики = Новый Запрос;
	ЗапросАналитики.МенеджерВременныхТаблиц = МенеджерВТ;
	ЗапросАналитики.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ВидыСубконтоАналитик.ИмяАналитики КАК ИмяАналитики
	|ИЗ
	|	ВТ_ВидыСубконтоАналитик КАК ВТ_ВидыСубконтоАналитик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ВидыСубконтоАналитик";
	
	ВыборкаИменаАналитик = ЗапросАналитики.Выполнить().Выбрать(); 
	
	ШаблонСоединение = 
	"
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗначенияАналитик КАК ВТ_ЗначенияАналитик_%1_%2
	|		ПО (ВТ_ЗначенияАналитик_%1_%2.ИмяАналитики = ""%1"")
	|			И ВТ_ЗначенияАналитик_%1_%2.УИ_Субконто = ВТОбороты.%1_%2";
	
	Пока ВыборкаИменаАналитик.Следующий() Цикл
		Для НомерИтерации = 1 По 2 Цикл
			Если НомерИтерации = 1 Тогда
				Суффикс = "Дт";
			Иначе
				Суффикс = "Кт";
			КонецЕсли;
		ПоляЗначенияАналитикВТОбороты = ПоляЗначенияАналитикВТОбороты + 
		СтрШаблон("ВЫБОР КОГДА ВТ_ЗначенияАналитик_%1_%2.ИмяАналитики = ВТОбороты.Аналитика%2%3 " +
		"ИЛИ ВТ_ЗначенияАналитик_%1_%2.ИмяАналитики = ВТОбороты.Аналитика%2%4 " + 
		"ИЛИ ВТ_ЗначенияАналитик_%1_%2.ИмяАналитики = ВТОбороты.Аналитика%2%5 " + 
		"ИЛИ ВТ_ЗначенияАналитик_%1_%2.ИмяАналитики = ВТОбороты.Аналитика%2%6 " + 
		"ИЛИ ВТ_ЗначенияАналитик_%1_%2.ИмяАналитики = ВТОбороты.Аналитика%2%7 " + 
		"ИЛИ ВТ_ЗначенияАналитик_%1_%2.ИмяАналитики = ВТОбороты.Аналитика%2%8 " + 
		"ТОГДА ЕСТЬNULL(ВТ_ЗначенияАналитик_%1_%2.НомерПП, """") ИНАЧЕ """" КОНЕЦ КАК Значение_%1_%2,", 
		ВыборкаИменаАналитик.ИмяАналитики, Суффикс, "1", "2", "3", "4", "5", "6");
		Если Не ВыборкаИменаАналитик.ИмяАналитики = "GRAF_ISP" Тогда
			СоединенияЗначенияАналитик = СоединенияЗначенияАналитик + СтрШаблон(ШаблонСоединение, ВыборкаИменаАналитик.ИмяАналитики, Суффикс);
		КонецЕсли;	
		ПоляЗначенияАналитикВТОборотыСАналитиками = ПоляЗначенияАналитикВТОборотыСАналитиками + СтрШаблон("
		|	ВТ_ОборотыСАналитиками.Значение_%1_%2 КАК Значение_%1_%2,", ВыборкаИменаАналитик.ИмяАналитики, Суффикс); 
		ГруппировкаВТОборотыСАналитиками = ГруппировкаВТОборотыСАналитиками + СтрШаблон("
		|	ВТ_ОборотыСАналитиками.Значение_%1_%2,", ВыборкаИменаАналитик.ИмяАналитики, Суффикс);
		КонецЦикла;
	КонецЦикла;		 
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ПоляЗначенияАналитикВТОбороты_", ПоляЗначенияАналитикВТОбороты);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%СоединенияЗначенияАналитик", СоединенияЗначенияАналитик);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ПоляЗначенияАналитикВТОборотыСАналитиками_", ПоляЗначенияАналитикВТОборотыСАналитиками);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ГруппировкаВТОборотыСАналитиками", ГруппировкаВТОборотыСАналитиками);
	
	Запрос = Новый Запрос(ТекстЗапроса); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПоДням = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДеньНачалоПериода = День(ПараметрыВыполнения.НачалоПериода);
	КоличествоДней = День(ПараметрыВыполнения.ОкончаниеПериода) - ДеньНачалоПериода + 1; 
	
	ВыгружатьМО = Не (КонецДня(ПараметрыВыполнения.ОкончаниеПериода) = Дата(2025,12,31,23,59,59)); 
	Если ПараметрыВыполнения.ИспользоватьСхемуВыгрузки2026 И ВыгружатьМО Тогда		

		ЗаписьXMLMO = Новый ЗаписьXML(); 
		ЗаписьXMLMO.ОткрытьФайл(Каталог + "MO.xml");
		ЗаписатьШапкуНачалаЭлемента(ЗаписьXMLMO, ПараметрыВыполнения.ПространствоИменПакет);
		
	КонецЕсли;
	
	Для _День = 1 По КоличествоДней Цикл
		
		ЗаписьСобытияВЖурналРегистрации(СтрШаблон(НСтр("ru = 'Выгрузка оборотов за %1 день - начало'"), Строка(ДеньНачалоПериода)));
		
		ЗаписьXML = Новый ЗаписьXML(); 
		ЗаписьXML.ОткрытьФайл(Каталог + СтрШаблон("Data_Transactions_%1.xml", Строка(ДеньНачалоПериода)));
		ЗаписатьШапкуНачалаЭлемента(ЗаписьXML, ПараметрыВыполнения.ПространствоИменПакет); 
		ЗаписьXML.ЗаписатьНачалоЭлемента("DataTransactions");

		ВыборкаПоДням.Сбросить();
		
		Если ВыборкаПоДням.НайтиСледующий(Новый Структура("День", ДеньНачалоПериода)) Тогда    
			
			Выборка = ВыборкаПоДням.Выбрать();  
			
			Пока Выборка.Следующий() Цикл  				
				
				ОбъектDataTransactionsDay = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "DataTransactionsDay")); 					
				ЗаполнитьЗначенияСвойств(ОбъектDataTransactionsDay, Выборка,, "TypeKBK_Dt,TypeKBK_Kt,Kol_Dt,Kol_Kt");      
				Если ЗначениеЗаполнено(Выборка.TypeKBK_Dt) Тогда
					ОбъектDataTransactionsDay.TypeKBK_Dt = Выборка.TypeKBK_Dt;
				КонецЕсли;
				Если ЗначениеЗаполнено(Выборка.TypeKBK_Kt) Тогда
					ОбъектDataTransactionsDay.TypeKBK_Kt = Выборка.TypeKBK_Kt;
				КонецЕсли;  
				
				ОбъектDataTransactionsDay.Kol_Dt = Выборка.Kol_Dt; 
				ОбъектDataTransactionsDay.Kol_Kt = Выборка.Kol_Kt;
				
				Для НомерИтерации = 1 По 2 Цикл 
					Если НомерИтерации = 1 Тогда
						Суффикс = "Дт";
						Суффикс2 = "Dt";
					Иначе
						Суффикс = "Кт";
						Суффикс2 = "Kt";
					КонецЕсли;	
					Если ЗначениеЗаполнено(Выборка["Аналитика" + Суффикс + "1"]) Тогда
						Analytics_1 = "";
						Если Выборка["Аналитика" + Суффикс + "1"] = "TOVAR_ROZN" Тогда
							Если Выборка["СубСчет" + Суффикс] = "105.2В" ИЛИ Выборка["СубСчет" + Суффикс] = "105.3В" Тогда
								Analytics_1 = "0";
							Иначе
								Analytics_1 = "1";
							КонецЕсли;	
						Иначе 
							Если НЕ РезультатЗапроса.Колонки.Найти("Значение_" + Выборка["Аналитика" + Суффикс + "1"] + "_" + Суффикс) = Неопределено Тогда
								Analytics_1 = Выборка["Значение_" + Выборка["Аналитика" + Суффикс + "1"] + "_" + Суффикс] ;
							КонецЕсли;
						КонецЕсли;
						ОбъектDataTransactionsDay["Analytics_" + Суффикс2 + "1"] = Analytics_1;
					Иначе
						ОбъектDataTransactionsDay["Analytics_" + Суффикс2 + "1"] = "";
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Выборка["Аналитика" + Суффикс + "2"]) Тогда
						Analytics_2 = "";
						Если Выборка["Аналитика" + Суффикс + "2"] = "VID_RASCH_PROCH_KR" Тогда
							Analytics_2 = "2";	
						Иначе
							Если НЕ РезультатЗапроса.Колонки.Найти("Значение_" + Выборка["Аналитика" + Суффикс + "2"] + "_" + Суффикс) = Неопределено Тогда
								Analytics_2 = Выборка["Значение_" + Выборка["Аналитика" + Суффикс + "2"] + "_" + Суффикс]; 
							КонецЕсли;
						КонецЕсли; 
						ОбъектDataTransactionsDay["Analytics_" + Суффикс2 + "2"] = Analytics_2; 
					Иначе
						ОбъектDataTransactionsDay["Analytics_" + Суффикс2 + "2"] = ""; 
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Выборка["Аналитика" + Суффикс + "3"]) Тогда
						Analytics_3 = "";
						Если Выборка["Аналитика" + Суффикс + "3"] = "VID_UCHETA" Тогда
							Если Выборка["СубСчет" + Суффикс] = "07.1" Тогда
								Analytics_3 = "1";
							Иначе
								Analytics_3 = "2";
							КонецЕсли;	
						Иначе
							Если НЕ РезультатЗапроса.Колонки.Найти("Значение_" + Выборка["Аналитика" + Суффикс + "3"] + "_" + Суффикс) = Неопределено Тогда
								Analytics_3 = Выборка["Значение_" + Выборка["Аналитика" + Суффикс + "3"] + "_" + Суффикс];
							КонецЕсли;
						КонецЕсли;
						ОбъектDataTransactionsDay["Analytics_" + Суффикс2 + "3"] = Analytics_3;
					Иначе
						ОбъектDataTransactionsDay["Analytics_" + Суффикс2 + "3"] = "";
					КонецЕсли;
					
					Если НЕ РезультатЗапроса.Колонки.Найти("Значение_" + Выборка["Аналитика" + Суффикс + "4"] + "_" + Суффикс) = Неопределено Тогда
						ОбъектDataTransactionsDay["Analytics_" + Суффикс2 + "4"] = Выборка["Значение_" + Выборка["Аналитика" + Суффикс + "4"] + "_" + Суффикс]; 
					Иначе
						ОбъектDataTransactionsDay["Analytics_" + Суффикс2 + "4"] = "";
					КонецЕсли;
					Если НЕ РезультатЗапроса.Колонки.Найти("Значение_" + Выборка["Аналитика" + Суффикс + "5"] + "_" + Суффикс) = Неопределено Тогда
						ОбъектDataTransactionsDay["Analytics_" + Суффикс2 + "5"] = Выборка["Значение_" + Выборка["Аналитика" + Суффикс + "5"] + "_" + Суффикс];
					Иначе
						ОбъектDataTransactionsDay["Analytics_" + Суффикс2 + "5"] = "";
					КонецЕсли;
					Если НЕ РезультатЗапроса.Колонки.Найти("Значение_" + Выборка["Аналитика" + Суффикс + "6"] + "_" + Суффикс) = Неопределено Тогда
						ОбъектDataTransactionsDay["Analytics_" + Суффикс2 + "6"] = Выборка["Значение_" + Выборка["Аналитика" + Суффикс + "6"] + "_" + Суффикс];
					Иначе
						ОбъектDataTransactionsDay["Analytics_" + Суффикс2 + "6"] = "";
					КонецЕсли;				
				КонецЦикла;
				
				
				Если Выборка.МежотчетныйПериод Тогда 
					Если ПараметрыВыполнения.ИспользоватьСхемуВыгрузки2026 И ВыгружатьМО Тогда
						ОбъектDataTransactionsMO = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "DataTransactionsMO"));
						ИсключаемыеСвойства = ?(ЗначениеЗаполнено(Выборка.TypeKBK_Dt), "", "TypeKBK_Dt,");
						ИсключаемыеСвойства = ИсключаемыеСвойства + ?(ИсключаемыеСвойства = "", "", ",") + ?(ЗначениеЗаполнено(Выборка.TypeKBK_Kt), "", "TypeKBK_Kt");
						
						ЗаполнитьЗначенияСвойств(ОбъектDataTransactionsMO, ОбъектDataTransactionsDay,,ИсключаемыеСвойства);
						ОбъектDataTransactionsMO.DateRegistration = ОбъектDataTransactionsDay.Date;
						ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXMLMO, ОбъектDataTransactionsMO);
					КонецЕсли;
				Иначе
					ОбъектDataTransactionsDay.Проверить();	
					ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектDataTransactionsDay);
				КонецЕсли;
				
			КонецЦикла;  
			
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Body
		ЗаписьXML.ЗаписатьКонецЭлемента(); // DataTransactions	

		ЗаписьXML.Закрыть();

		ЗаписьСобытияВЖурналРегистрации(СтрШаблон(НСтр("ru = 'Выгрузка оборотов за %1 - окончание'"), Строка(ДеньНачалоПериода)));
		ДеньНачалоПериода = ДеньНачалоПериода + 1;
		
	КонецЦикла; 
	
	Если ПараметрыВыполнения.ИспользоватьСхемуВыгрузки2026 И ВыгружатьМО Тогда
		ЗаписьXMLMO.ЗаписатьКонецЭлемента(); // Body
		ЗаписьXMLMO.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОстатки(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, Перезагружаемые = Ложь)
	
	ЗаписьXML = ОбщийОбъект;
	
	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.ЗаполнитьОстатки(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, Перезагружаемые, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВТ = ?(Перезагружаемые, "ВТОстаткиПерезагружаемые", "ВТОстатки");
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	СУММА(1) КАК КоличествоЗаписей
	|ИЗ
	|	" + ИмяВТ + " КАК ВТОстатки");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	КоличествоЗаписей = ?(ЗначениеЗаполнено(Выборка.КоличествоЗаписей), Выборка.КоличествоЗаписей, 0);
	#Область ТекстЗапроса	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ВТ_ЗначенияАналитикОрганизации.НомерПП, """") КАК ORGANIZATION,
	|	ВТОстатки.ДатаОкончания КАК Date,
	|	ЕСТЬNULL(ВТОстатки.СчетКод, """") КАК Account,
	|	ВТОстатки.Счет КАК Счет,
	|	ЕСТЬNULL(ВТОстатки.КФО, """") КАК KFO,
	|	ЕСТЬNULL(ВТОстатки.КПС, """") КАК KBK,
	|	ЕСТЬNULL(ВТОстатки.КЭК, """") КАК KOSGU,
	|	ВТОстатки.СубСчет КАК СубСчет,
	|	%ПоляЗначенияАналитикВТОстатки_
	|	(ЕСТЬNULL(ВТОстатки.СуммаОстатокДт, 0)) КАК СуммаОстатокДт,
	|	(ЕСТЬNULL(ВТОстатки.СуммаОстатокКт, 0)) КАК СуммаОстатокКт,
	|	(ЕСТЬNULL(ВТОстатки.КоличествоОстатокДт, 0)) КАК КоличествоОстатокДт,
	|	(ЕСТЬNULL(ВТОстатки.КоличествоОстатокКт, 0)) КАК КоличествоОстатокКт,
	|	ЕСТЬNULL(ВТОстатки.Валюта, """") КАК Валюта,
	|	(ЕСТЬNULL(ВТОстатки.ВалютнаяСуммаОстатокДт, 0)) КАК ВалютнаяСуммаОстатокДт,
	|	(ЕСТЬNULL(ВТОстатки.ВалютнаяСуммаОстатокКт, 0)) КАК ВалютнаяСуммаОстатокКт,
	|	ЕСТЬNULL(ВТОстатки.ОбязательноВОстатках1, ЛОЖЬ) КАК ОбязательноВОстатках1,
	|	ЕСТЬNULL(ВТОстатки.ОбязательноВОстатках2, ЛОЖЬ) КАК ОбязательноВОстатках2,
	|	ЕСТЬNULL(ВТОстатки.ОбязательноВОстатках3, ЛОЖЬ) КАК ОбязательноВОстатках3,
	|	ЕСТЬNULL(ВТОстатки.ОбязательноВОстатках4, ЛОЖЬ) КАК ОбязательноВОстатках4,
	|	ЕСТЬNULL(ВТОстатки.ОбязательноВОстатках5, ЛОЖЬ) КАК ОбязательноВОстатках5,
	|	ЕСТЬNULL(ВТОстатки.ОбязательноВОстатках6, ЛОЖЬ) КАК ОбязательноВОстатках6,
	|	ЕСТЬNULL(ВТОстатки.ТипКБК, """") КАК ТипКБК,
	|	ВТОстатки.ВидСчета КАК ВидСчета,
	|	ЕСТЬNULL(ВТОстатки.Аналитика1, """") КАК Аналитика1,
	|	ЕСТЬNULL(ВТОстатки.Аналитика2, """") КАК Аналитика2,
	|	ЕСТЬNULL(ВТОстатки.Аналитика3, """") КАК Аналитика3,
	|	ЕСТЬNULL(ВТОстатки.Аналитика4, """") КАК Аналитика4,
	|	ЕСТЬNULL(ВТОстатки.Аналитика5, """") КАК Аналитика5,
	|	ЕСТЬNULL(ВТОстатки.Аналитика6, """") КАК Аналитика6,
	|	ВТОстатки.Субконто11 КАК Субконто11,
	|	ВТОстатки.Субконто21 КАК Субконто21,
	|	ВТОстатки.Субконто31 КАК Субконто31
	|ПОМЕСТИТЬ ВТОстаткиПередВыгрузкой
	|ИЗ
	|	" + ИмяВТ + " КАК ВТОстатки
	|		%СоединенияЗначенияАналитик
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗначенияАналитик КАК ВТ_ЗначенияАналитикОрганизации
	|		ПО (ВТ_ЗначенияАналитикОрганизации.ИмяАналитики = ""ORGANIZATION"")
	|			И ВТОстатки.УИ_Организации = ВТ_ЗначенияАналитикОрганизации.УИ_Субконто 
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТаблицаИдентификаторовGRAF_ISP КАК ВТ_ТаблицаИдентификаторовGRAF_ISP
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗначенияАналитик КАК ВТ_ЗначенияАналитик_GRAF_ISP
	|				ПО (ВТ_ЗначенияАналитик_GRAF_ISP.ИмяАналитики = ""GRAF_ISP"")
	|				И ВТ_ЗначенияАналитик_GRAF_ISP.УИ_Субконто_GRAF = ВТ_ТаблицаИдентификаторовGRAF_ISP.УИ_GRAF_ISP
	|		ПО ВТОстатки.ПолучитьGRAF_ISP
	|			И ВТОстатки.Счет = ВТ_ТаблицаИдентификаторовGRAF_ISP.Счет
	|			И ВТОстатки.Договор = ВТ_ТаблицаИдентификаторовGRAF_ISP.Договор
	|			И ВТОстатки.КФОСсылка = ВТ_ТаблицаИдентификаторовGRAF_ISP.КФО
	|ГДЕ %УсловиеБольшихДанных И %Счет_УсловиеБольшихДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОстаткиПередВыгрузкой.ORGANIZATION КАК ORGANIZATION,
	|	ВТОстаткиПередВыгрузкой.Date КАК Date,
	|	ВТОстаткиПередВыгрузкой.Account КАК Account,
	|	ВТОстаткиПередВыгрузкой.KFO КАК KFO,
	|	ВТОстаткиПередВыгрузкой.KBK КАК KBK,
	|	ВТОстаткиПередВыгрузкой.KOSGU КАК KOSGU,
	|	ВТОстаткиПередВыгрузкой.СубСчет КАК СубСчет,
	|	ВТОстаткиПередВыгрузкой.Аналитика1 КАК Аналитика1,
	|	ВТОстаткиПередВыгрузкой.Аналитика2 КАК Аналитика2,
	|	ВТОстаткиПередВыгрузкой.Аналитика3 КАК Аналитика3,
	|	ВТОстаткиПередВыгрузкой.Аналитика4 КАК Аналитика4,
	|	ВТОстаткиПередВыгрузкой.Аналитика5 КАК Аналитика5,
	|	ВТОстаткиПередВыгрузкой.Аналитика6 КАК Аналитика6,
	|	%ПоляЗначенияАналитикВТОстаткиПередВыгрузкой_
	|	СУММА(ВТОстаткиПередВыгрузкой.СуммаОстатокДт) КАК Summa_Dt,
	|	СУММА(ВТОстаткиПередВыгрузкой.СуммаОстатокКт) КАК Summa_Kt,
	|	СУММА(ВТОстаткиПередВыгрузкой.КоличествоОстатокДт) КАК Kol_Dt,
	|	СУММА(ВТОстаткиПередВыгрузкой.КоличествоОстатокКт) КАК Kol_Kt,
	|	ВТОстаткиПередВыгрузкой.Валюта КАК Val,
	|	СУММА(ВТОстаткиПередВыгрузкой.ВалютнаяСуммаОстатокДт) КАК ValSumma_Dt,
	|	СУММА(ВТОстаткиПередВыгрузкой.ВалютнаяСуммаОстатокКт) КАК ValSumma_Kt,
	|	ВТОстаткиПередВыгрузкой.ТипКБК КАК TypeKBK,
	|	ВТОстаткиПередВыгрузкой.ВидСчета КАК ВидСчета
	|ИЗ
	|	ВТОстаткиПередВыгрузкой КАК ВТОстаткиПередВыгрузкой
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТОстаткиПередВыгрузкой.ORGANIZATION,
	|	ВТОстаткиПередВыгрузкой.Date,
	|	ВТОстаткиПередВыгрузкой.Account,
	|	ВТОстаткиПередВыгрузкой.KFO,
	|	ВТОстаткиПередВыгрузкой.KBK,
	|	ВТОстаткиПередВыгрузкой.KOSGU, 
	|	ВТОстаткиПередВыгрузкой.СубСчет,
	|	ВТОстаткиПередВыгрузкой.Аналитика1,
	|	ВТОстаткиПередВыгрузкой.Аналитика2,
	|	ВТОстаткиПередВыгрузкой.Аналитика3,
	|	ВТОстаткиПередВыгрузкой.Аналитика4,
	|	ВТОстаткиПередВыгрузкой.Аналитика5,
	|	ВТОстаткиПередВыгрузкой.Аналитика6,
	|	%ГруппировкаВТОстаткиПередВыгрузкой
	|	ВТОстаткиПередВыгрузкой.Валюта,
	|	ВТОстаткиПередВыгрузкой.ТипКБК,
	|	ВТОстаткиПередВыгрузкой.ВидСчета
	|	
	|ИМЕЮЩИЕ
	|	(СУММА(ВТОстаткиПередВыгрузкой.СуммаОстатокДт) <> 0
	|		ИЛИ СУММА(ВТОстаткиПередВыгрузкой.СуммаОстатокКт) <> 0
	|		ИЛИ СУММА(ВТОстаткиПередВыгрузкой.КоличествоОстатокДт) <> 0
	|		ИЛИ СУММА(ВТОстаткиПередВыгрузкой.КоличествоОстатокКт) <> 0
	|		ИЛИ СУММА(ВТОстаткиПередВыгрузкой.ВалютнаяСуммаОстатокДт) <> 0
	|		ИЛИ СУММА(ВТОстаткиПередВыгрузкой.ВалютнаяСуммаОстатокКт) <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	| УНИЧТОЖИТЬ ВТОстаткиПередВыгрузкой";		
	
	#КонецОбласти		            
		
	МассивАналитик = Новый Массив;
	Если ПараметрыВыполнения.ПакетныйРежимВыгрузки Тогда
						
		ЗапросСчетов = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		                            |	НастройкиВыгрузкиАналитикМСД.Счет КАК Счет,
		                            |	ПОДСТРОКА(НастройкиВыгрузкиАналитикМСД.Счет, 1, 3) КАК ГруппаСчетов,
		                            |	НастройкиВыгрузкиАналитикМСД.Аналитика1 КАК Аналитика1,
		                            |	НастройкиВыгрузкиАналитикМСД.Аналитика2 КАК Аналитика2,
		                            |	НастройкиВыгрузкиАналитикМСД.Аналитика3 КАК Аналитика3,
		                            |	НастройкиВыгрузкиАналитикМСД.Аналитика4 КАК Аналитика4,
		                            |	НастройкиВыгрузкиАналитикМСД.Аналитика5 КАК Аналитика5,
		                            |	НастройкиВыгрузкиАналитикМСД.Аналитика6 КАК Аналитика6
		                            |ИЗ
		                            |	РегистрСведений.НастройкиВыгрузкиАналитикМСД КАК НастройкиВыгрузкиАналитикМСД
		                            |ГДЕ
		                            |	НастройкиВыгрузкиАналитикМСД.Версия = &Версия
		                            |	И НастройкиВыгрузкиАналитикМСД.Организация = &Организация
		                            |ИТОГИ ПО
		                            |	ГруппаСчетов");
		ЗапросСчетов.УстановитьПараметр("Версия", ПараметрыВыполнения.ВерсияТаксономии);		
		ЗапросСчетов.УстановитьПараметр("Организация", ПараметрыВыполнения.Организация);	
		ВыборкаСчетов = ЗапросСчетов.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСчетов.Следующий() Цикл
			МассивСчетов = Новый Массив; 
			МассивАналитик = Новый Массив;
			ТекстЗапросаПоШаблону = ТекстЗапроса;
			ВыборкаСчетовДетальные = ВыборкаСчетов.Выбрать();
			Пока ВыборкаСчетовДетальные.Следующий() Цикл
				МассивСчетов.Добавить(ВыборкаСчетовДетальные.Счет); 
				Если ЗначениеЗаполнено(ВыборкаСчетовДетальные.Аналитика1) Тогда
					МассивАналитик.Добавить(ВыборкаСчетовДетальные.Аналитика1);
				КонецЕсли;
				Если ЗначениеЗаполнено(ВыборкаСчетовДетальные.Аналитика2) Тогда
					МассивАналитик.Добавить(ВыборкаСчетовДетальные.Аналитика2);
				КонецЕсли;
				Если ЗначениеЗаполнено(ВыборкаСчетовДетальные.Аналитика3) Тогда
					МассивАналитик.Добавить(ВыборкаСчетовДетальные.Аналитика3);
				КонецЕсли;
				Если ЗначениеЗаполнено(ВыборкаСчетовДетальные.Аналитика4) Тогда
					МассивАналитик.Добавить(ВыборкаСчетовДетальные.Аналитика4);
				КонецЕсли;
				Если ЗначениеЗаполнено(ВыборкаСчетовДетальные.Аналитика5) Тогда
					МассивАналитик.Добавить(ВыборкаСчетовДетальные.Аналитика5);
				КонецЕсли;
				Если ЗначениеЗаполнено(ВыборкаСчетовДетальные.Аналитика6) Тогда
					МассивАналитик.Добавить(ВыборкаСчетовДетальные.Аналитика6);
				КонецЕсли;
			КонецЦикла;
			 					
			ЗаполнитьТекстЗапросаСоединениемСАналитиками(МенеджерВТ, ТекстЗапросаПоШаблону, МассивАналитик);
			
			Запрос = Новый Запрос(СтрЗаменить(ТекстЗапросаПоШаблону, "%УсловиеБольшихДанных", "ВТОстатки.СчетКод В (&Счет)"));
			Запрос.МенеджерВременныхТаблиц = МенеджерВТ; 
			Запрос.УстановитьПараметр("Счет", МассивСчетов);

			ЗапросКолЗаписей = Новый Запрос("ВЫБРАТЬ
			                                |	СУММА(1) КАК КоличествоЗаписей,
			                                |	МИНИМУМ(ВТОстатки.НомерСтроки) КАК Минимум,
			                                |	МАКСИМУМ(ВТОстатки.НомерСтроки) КАК Максимум
			                                |ИЗ
			                                |	" + ИмяВТ + " КАК ВТОстатки
			                                |ГДЕ
			                                |	ВТОстатки.СчетКод В(&Счет)");
			ЗапросКолЗаписей.УстановитьПараметр("Счет", МассивСчетов);
			ЗапросКолЗаписей.МенеджерВременныхТаблиц = МенеджерВТ;
			Выборка = ЗапросКолЗаписей.Выполнить().Выбрать();
			Выборка.Следующий();
			КоличествоЗаписей = ?(ЗначениеЗаполнено(Выборка.КоличествоЗаписей), Выборка.КоличествоЗаписей, 0);
			Если КоличествоЗаписей = 0 Тогда
				Продолжить;
			КонецЕсли;	
			НомерСтрокиТекущий = Выборка.Минимум - 1;
			НомерСтрокиТекущий = 0;
			ДиапазонПакет = 200000;
			НомерСтрокиПакет = ДиапазонПакет;
			Итерация = 1;
			Если КоличествоЗаписей > НомерСтрокиПакет Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "%Счет_УсловиеБольшихДанных", "ВТОстатки.НомерСтроки > &НомерСтрокиТекущий И ВТОстатки.НомерСтроки <= &НомерСтрокиПакет");
				ПотребуетсяИтераций = (Выборка.Максимум - Выборка.Минимум) / НомерСтрокиПакет + 1;
				Пока Итерация < ПотребуетсяИтераций Цикл
					Запрос.УстановитьПараметр("НомерСтрокиТекущий", НомерСтрокиТекущий);
					Запрос.УстановитьПараметр("НомерСтрокиПакет", НомерСтрокиПакет);
	                ЗаписьСобытияВЖурналРегистрации(НСтр(СтрШаблон("ru = 'Запрос остатков - выполнение запроса по счету %1 - диапазон записей: %2 - %3'", ВыборкаСчетов.ГруппаСчетов, НомерСтрокиТекущий, НомерСтрокиПакет)));
				    ТаблицаДанных = Запрос.Выполнить().Выгрузить(); 
					ЗаполнитьXDTOПоТаблице_Остатки(ТаблицаДанных, ЗаписьXML, ПараметрыВыполнения);
					НомерСтрокиТекущий = НомерСтрокиТекущий + ДиапазонПакет; 
					НомерСтрокиПакет = НомерСтрокиПакет + ДиапазонПакет;
                    Итерация = Итерация + 1;
				КонецЦикла;	
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "%Счет_УсловиеБольшихДанных", "ИСТИНА"); 
				ЗаписьСобытияВЖурналРегистрации(НСтр(СтрШаблон("ru = 'Запрос остатков - выполнение запроса по счету %1 - количество записей: %2'", ВыборкаСчетов.ГруппаСчетов, КоличествоЗаписей)));
				ТаблицаДанных = Запрос.Выполнить().Выгрузить(); 
				ЗаполнитьXDTOПоТаблице_Остатки(ТаблицаДанных, ЗаписьXML, ПараметрыВыполнения);
			КонецЕсли;	
				
		КонецЦикла; 		
	Иначе
		
		ЗаполнитьТекстЗапросаСоединениемСАналитиками(МенеджерВТ, ТекстЗапроса, МассивАналитик);
	
		Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "%УсловиеБольшихДанных", "ИСТИНА"));
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%Счет_УсловиеБольшихДанных", "ИСТИНА"); 
		ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Запрос остатков - выполнение запроса'"));
		Запрос.МенеджерВременныхТаблиц = МенеджерВТ; 			
		ТаблицаДанных = Запрос.Выполнить().Выгрузить(); 
		ЗаполнитьXDTOПоТаблице_Остатки(ТаблицаДанных, ЗаписьXML, ПараметрыВыполнения);
	КонецЕсли;	
	
	Запрос = Новый Запрос("
	|////////////////////////////////////////////////////////////////////////////////
	| УНИЧТОЖИТЬ " + ИмяВТ);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

#Область ЗаполнениеАналитик

Процедура ORGANIZATION(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения)
	
	ЗаписьXML = ОбщийОбъект;

	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.ORGANIZATION(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(?(ПараметрыВыполнения.ПакетныйРежимВыгрузки, 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТОстатки.Организация КАК Аналитика
	|ПОМЕСТИТЬ ВТАналитики 
	|ИЗ
	|	ВТОстаткиБезСубконто4 КАК ВТОстатки
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТОбороты.Организация
	|ИЗ
	|	ВТОборотыБезСубконто4 КАК ВТОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////", 
	"") + "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Организации.Ссылка КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Организации.Ссылка) КАК GUID,
	|	ВЫБОР
	|		КОГДА ОрганизацииКодСВР.КодПоРПБС = """"
	|			ТОГДА ""        ""
	|		ИНАЧЕ ВЫРАЗИТЬ(ОрганизацииКодСВР.КодПоРПБС КАК СТРОКА(8))
	|	КОНЕЦ КАК KOD_SVR,
	|	ВЫРАЗИТЬ(Бюджеты.Код КАК СТРОКА(8)) КАК OKTMO_BUDJ,
	|	ВЫРАЗИТЬ(Организации.НаименованиеПолное КАК СТРОКА(300)) КАК NAME,
	|	Организации.ИНН КАК INN,
	|	Организации.КПП КАК KPP,
	|	ВЫБОР
	|		КОГДА Организации.УчетПереданныхПолномочий
	|			ТОГДА ""1""
	|		ИНАЧЕ ""0""
	|	КОНЕЦ КАК PER_POLN,
	|	ЕСТЬNULL(Организации.КодПоППП.Код, """") КАК GLAVA,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(УчетнаяПолитикаОрганизацийСрезПоследних.ПолномочияГРБС, ЛОЖЬ)
	|			ТОГДА ""1""
	|		ИНАЧЕ ""0""
	|	КОНЕЦ КАК GRBS,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(УчетнаяПолитикаОрганизацийСрезПоследних.ПолномочияРБС, ЛОЖЬ)
	|			ТОГДА ""1""
	|		ИНАЧЕ ""0""
	|	КОНЕЦ КАК RBS,
	|	ВЫБОР
	|		КОГДА Организации.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА ""0""
	|		ИНАЧЕ ""1""
	|	КОНЕЦ КАК FILIAL,
	|	ВЫБОР
	|		КОГДА СтруктурыРПС.ТипПланаСчетов = ЗНАЧЕНИЕ(Перечисление.ТипыПлановСчетов.ДляАвтономных)
	|			ТОГДА ""3""
	|		КОГДА СтруктурыРПС.ТипПланаСчетов = ЗНАЧЕНИЕ(Перечисление.ТипыПлановСчетов.ДляБюджетных)
	|			ТОГДА ""2""
	|		КОГДА СтруктурыРПС.ТипПланаСчетов = ЗНАЧЕНИЕ(Перечисление.ТипыПлановСчетов.ДляКазенных)
	|			ТОГДА ""1""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК VID_PLAN_SCHET
	|ИЗ
	|	ВТАналитики КАК ВТАналитики
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних КАК УчетнаяПолитикаОрганизацийСрезПоследних
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтруктурыРПС КАК СтруктурыРПС
	|				ПО УчетнаяПолитикаОрганизацийСрезПоследних.СтруктураРПС = СтруктурыРПС.Ссылка
	|			ПО Организации.Ссылка = УчетнаяПолитикаОрганизацийСрезПоследних.Организация
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Бюджеты КАК Бюджеты
	|			ПО Организации.Бюджет = Бюджеты.Ссылка
	|		ПО ВТАналитики.Аналитика = Организации.Ссылка,
	|	Справочник.Организации КАК ОрганизацииКодСВР
	|ГДЕ
	|	ОрганизацииКодСВР.Ссылка = &Организация" + 
	?(ПараметрыВыполнения.ПакетныйРежимВыгрузки, "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТАналитики
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОстаткиБезСубконто4
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОборотыБезСубконто4", "")); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Организация", ПараметрыВыполнения.Организация);
	СтруктураРеквизитов = СтруктураРеквизитовАналитики("ORGANIZATION", ПараметрыВыполнения);
	НН = ПараметрыВыполнения.НаборИсторияПроверкиАналитик.Количество();
	МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("ORGANIZATION", ПараметрыВыполнения);		
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл  
		ОбъектORGANIZATION = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "ORGANIZATION")); 
		
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, Выборка);
		Если СтруктураРеквизитов.Свойство("GUID") Тогда
			СтруктураРеквизитов.GUID = XMLСтрока(Выборка.GUID); 
		КонецЕсли;     
		
		пЗаполнитьЗначенияСвойств(ОбъектORGANIZATION, СтруктураРеквизитов); 
		Если ПараметрыВыполнения.ВыполнятьПроверку Тогда 
			ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, "ORGANIZATION", Выборка.Name, НН, МассивОбязательныхРеквизитов);
		КонецЕсли;
		
		ОбъектORGANIZATION.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ = 0");
		ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("ORGANIZATION_" + ОбъектORGANIZATION.GUID, ОбъектORGANIZATION.ID);
		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
		
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектORGANIZATION);
	КонецЦикла;
	
КонецПроцедуры     

Процедура ADRES(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения)
	
	ЗаписьXML = ОбщийОбъект;
	
	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.ADRES(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаАдресов = НоваяТаблицаАдресов();
	СтрокаКолонок = "";
	ЭтоПервый = Истина;
	Для Каждого тКолонка Из ТаблицаАдресов.Колонки Цикл
		Если ЭтоПервый Тогда
			ЭтоПервый = Ложь;
		Иначе
			СтрокаКолонок = СтрокаКолонок + ",";
		КонецЕсли;
		СтрокаКолонок = СтрокаКолонок + тКолонка.Имя;
	КонецЦикла;  
	
	МассивСубконто = Новый Массив;
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	
	МассивАналитик = СтрРазделить("MESTO_ADDR_NFA,MOL_SOTRUDNIK,KONTRAGENT", ",", Ложь);
	СпецАналитикуВМенеджерВТ(МенеджерВТ, МассивСубконто, "ADRES", МассивАналитик, ПараметрыВыполнения);
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(МестаХраненияКонтактнаяИнформация.Представление КАК СТРОКА(500)) КАК Представление,
	|	ВЫРАЗИТЬ(МестаХраненияКонтактнаяИнформация.ЗначенияПолей КАК СТРОКА(1024)) КАК ЗначенияПолей,
	|	МестаХраненияКонтактнаяИнформация.Страна КАК Страна 
	|ПОМЕСТИТЬ ВТАдресы						  
	|ИЗ
	|	ВТАналитики_ADRES КАК ВТАналитики
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК ЦМО
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.МестаХранения.КонтактнаяИнформация КАК МестаХраненияКонтактнаяИнформация
	|			ПО ЦМО.МестоХранения = МестаХраненияКонтактнаяИнформация.Ссылка
	|		ПО ВТАналитики.Аналитика = ЦМО.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ФизическиеЛицаКонтактнаяИнформация.Представление КАК СТРОКА(500)),
	|	ВЫРАЗИТЬ(ФизическиеЛицаКонтактнаяИнформация.ЗначенияПолей КАК СТРОКА(1024)),
	|	ФизическиеЛицаКонтактнаяИнформация.Страна
	|ИЗ
	|	ВТАналитики_ADRES КАК ВТАналитики
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК ЦМО
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	|					ПО Контрагенты.ЮридическоеФизическоеЛицо = ФизическиеЛицаКонтактнаяИнформация.Ссылка
	|						И (ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица))
	|				ПО Сотрудники.Контрагент = Контрагенты.Ссылка
	|			ПО ЦМО.Сотрудник = Сотрудники.Ссылка
	|		ПО ВТАналитики.Аналитика = ЦМО.Ссылка
	|
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ФизическиеЛицаКонтактнаяИнформация.Представление КАК СТРОКА(500)),
	|	ВЫРАЗИТЬ(ФизическиеЛицаКонтактнаяИнформация.ЗначенияПолей КАК СТРОКА(1024)),
	|	ФизическиеЛицаКонтактнаяИнформация.Страна
	|ИЗ
	|	ВТАналитики_ADRES КАК ВТАналитики
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	|		ПО Контрагенты.ЮридическоеФизическоеЛицо = ФизическиеЛицаКонтактнаяИнформация.Ссылка
	|			И (ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица))  
	|	ПО ВТАналитики.Аналитика = Контрагенты.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ЮридическиеЛицаКонтактнаяИнформация.Представление КАК СТРОКА(500)),
	|	ВЫРАЗИТЬ(ЮридическиеЛицаКонтактнаяИнформация.ЗначенияПолей КАК СТРОКА(1024)),
	|	ЮридическиеЛицаКонтактнаяИнформация.Страна
	|ИЗ
	|	ВТАналитики_ADRES КАК ВТАналитики,
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица.КонтактнаяИнформация КАК ЮридическиеЛицаКонтактнаяИнформация
	|		ПО Контрагенты.ЮридическоеФизическоеЛицо = ЮридическиеЛицаКонтактнаяИнформация.Ссылка
	|			И (ЮридическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты))
	|	ПО ВТАналитики.Аналитика = Контрагенты.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТАдресы.Представление КАК Представление,
	|	ВТАдресы.ЗначенияПолей КАК ЗначенияПолей,
	|	ВТАдресы.Страна КАК Страна
	|ИЗ
	|	ВТАдресы КАК ВТАдресы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТАдресы.Представление,
	|	ВТАдресы.Страна,
	|	ВТАдресы.ЗначенияПолей");
	
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	ЗаполнитьСтрокиАдреса(ТаблицаАдресов, Выгрузка, СтрокаКолонок);
	
	
	КолонкиМуниципал = "NAS_PUNKT_MUN, REGION, RAION, MUN_RAION_OKRUG, POSELENIE, GOROD, NAS_PUNKT, TERRITORIYA, ХЭШ_NAS_PUNKT_MUN";
	КолонкиАдм		 = "NAS_PUNKT_ADM, REGION, RAION, GOROD, NAS_PUNKT, TERRITORIYA, ХЭШ_NAS_PUNKT_ADM";
	
	ТаблицаАдресов.Свернуть(СтрокаКолонок);
	СтрокиКУдалению = ТаблицаАдресов.НайтиСтроки(Новый Структура("REGION", ""));
	удКоличество = СтрокиКУдалению.Количество();
	Для НН = 1 По удКоличество Цикл
		удСтрока = СтрокиКУдалению[удКоличество - НН];
		ТаблицаАдресов.Удалить(удСтрока);
	КонецЦикла;
	
	ТаблицаМуниципал = ТаблицаАдресов.Скопировать(Новый Структура("ADM_MUN_DELENIE", "1"), КолонкиМуниципал);
	ТаблицаМуниципал.Свернуть(КолонкиМуниципал);
	ТаблицаМуниципал.Индексы.Добавить("ХЭШ_NAS_PUNKT_MUN");
	ТаблицаМуниципалХеш = ТаблицаМуниципал.Скопировать(,"ХЭШ_NAS_PUNKT_MUN");
	ТаблицаМуниципалХеш.Свернуть("ХЭШ_NAS_PUNKT_MUN");
	новТаблицаМуниципал = ТаблицаМуниципал.СкопироватьКолонки();
	Для Каждого текХеш Из ТаблицаМуниципалХеш Цикл
		Строка = ТаблицаМуниципал.Найти(текХеш.ХЭШ_NAS_PUNKT_MUN, "ХЭШ_NAS_PUNKT_MUN");
		ЗаполнитьЗначенияСвойств(новТаблицаМуниципал.Добавить(), Строка);
	КонецЦикла;
	
	ТаблицаАдм = ТаблицаАдресов.Скопировать(Новый Структура("ADM_MUN_DELENIE", "2"), КолонкиАдм); 
	ТаблицаАдм.Свернуть(КолонкиАдм);
	ТаблицаАдм.Индексы.Добавить("ХЭШ_NAS_PUNKT_ADM");
	ТаблицаАдмХеш = ТаблицаАдм.Скопировать(,"ХЭШ_NAS_PUNKT_ADM");
	ТаблицаАдмХеш.Свернуть("ХЭШ_NAS_PUNKT_ADM");
	новТаблицаАдм = ТаблицаАдм.СкопироватьКолонки();
	Для Каждого текХеш Из ТаблицаАдмХеш Цикл
		Строка = ТаблицаАдм.Найти(текХеш.ХЭШ_NAS_PUNKT_ADM, "ХЭШ_NAS_PUNKT_ADM");
		ЗаполнитьЗначенияСвойств(новТаблицаАдм.Добавить(), Строка);
	КонецЦикла;
	
	НН = ПараметрыВыполнения.НаборИсторияПроверкиАналитик.Количество();
	МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("NAS_PUNKT_MUN", ПараметрыВыполнения);
	
	СтруктураРеквизитов = СтруктураРеквизитовАналитики("NAS_PUNKT_MUN", ПараметрыВыполнения);
	Для Каждого текМуниципал Из ТаблицаМуниципал Цикл                   
		
		ОбъектNAS_PUNKT_MUN = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "NAS_PUNKT_MUN"));  
		
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, текМуниципал);
		пЗаполнитьЗначенияСвойств(ОбъектNAS_PUNKT_MUN, СтруктураРеквизитов);
		п_Представление = "";
		ЗаполнитьСтрокуИзСтруктуры(п_Представление, СтруктураРеквизитов, ", ");
		Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
			ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, "NAS_PUNKT_MUN", п_Представление, НН, МассивОбязательныхРеквизитов);
		КонецЕсли;
		
		ОбъектNAS_PUNKT_MUN.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");
		СтрокиАдреса = ТаблицаАдресов.НайтиСтроки(Новый Структура("ADM_MUN_DELENIE, ХЭШ_NAS_PUNKT_MUN", "1", текМуниципал.ХЭШ_NAS_PUNKT_MUN));
		Для Каждого текСтрокаАдреса Из СтрокиАдреса Цикл
			текСтрокаАдреса.NAS_PUNKT_MUN = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0")
		КонецЦикла;
		
		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1; 
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектNAS_PUNKT_MUN);
	КонецЦикла;
	
	МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("NAS_PUNKT_ADM", ПараметрыВыполнения);
	СтруктураРеквизитов = СтруктураРеквизитовАналитики("NAS_PUNKT_ADM", ПараметрыВыполнения);
	Для Каждого текАдм Из ТаблицаАдм Цикл
		ОбъектNAS_PUNKT_ADM = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "NAS_PUNKT_ADM"));
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, текАдм);
		пЗаполнитьЗначенияСвойств(ОбъектNAS_PUNKT_ADM, СтруктураРеквизитов);
		п_Представление = "";
		ЗаполнитьСтрокуИзСтруктуры(п_Представление, СтруктураРеквизитов, ", ");
		Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
			ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, "NAS_PUNKT_ADM", п_Представление, НН, МассивОбязательныхРеквизитов);
		КонецЕсли;
		
		ОбъектNAS_PUNKT_ADM.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");
		СтрокиАдреса = ТаблицаАдресов.НайтиСтроки(Новый Структура("ADM_MUN_DELENIE, ХЭШ_NAS_PUNKT_ADM", "2", текАдм.ХЭШ_NAS_PUNKT_ADM));
		Для Каждого текСтрокаАдреса Из СтрокиАдреса Цикл
			текСтрокаАдреса.NAS_PUNKT_ADM = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0")
		КонецЦикла;
		
		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;   
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектNAS_PUNKT_ADM);
	КонецЦикла;
	
	МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("ADRES", ПараметрыВыполнения);
	СтруктураРеквизитов = СтруктураРеквизитовАналитики("ADRES", ПараметрыВыполнения);		
	Для Каждого текАдрес Из ТаблицаАдресов Цикл
		ОбъектADRES = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "ADRES")); 
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, текАдрес);         
		пЗаполнитьЗначенияСвойств(ОбъектADRES, СтруктураРеквизитов);           
		
		п_Представление = "";
		ЗаполнитьСтрокуИзСтруктуры(п_Представление, СтруктураРеквизитов, ", ");		
		Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
			ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, "ADRES", п_Представление, НН, МассивОбязательныхРеквизитов);
		КонецЕсли;
		
		ОбъектADRES.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");  
		ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("ADRES_" + текАдрес.ХЭШ, ОбъектADRES.ID);
		
		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектADRES); 
	КонецЦикла;
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТАдресы; УНИЧТОЖИТЬ ВТАналитики_ADRES"); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура OS(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения)
	
	ЗаписьXML = ОбщийОбъект;
	
	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.OS(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	СпецАналитикуВМенеджерВТ(МенеджерВТ, МодульОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства), "OS",, ПараметрыВыполнения);      
	
	#Область ТекстЗапроса
	
	Запрос = Новый Запрос(		
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
