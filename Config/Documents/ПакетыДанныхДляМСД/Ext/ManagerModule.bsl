		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;	
		                
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, Объект_OS_NMA_NPA_KAZNA);
