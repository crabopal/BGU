	|	ВТОстатки%ИмяОстатки_С_ОС.Валюта КАК Валюта, 
	|	ВТОстатки%ИмяОстатки_С_ОС.СуммаОстаток КАК СуммаОстаток,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОсновныеСредства.ГрупповойУчет, ЛОЖЬ)
	|			ТОГДА ВЫБОР
	|					КОГДА ВТОстатки%ИмяОстатки_С_ОС.СуммаОстатокДт = 0
	|							И ВТОстатки%ИмяОстатки_С_ОС.КоличествоОстатокДт = 0
	|						ТОГДА 0
	|					ИНАЧЕ " + Остатки_ПолучитьПолеВыбораВТСтоимостьОбъектовОС("СтоимостьОстаток", "СуммаОстатокДт", ДополнительныеПараметры.ПараметрыВыполнения) + "
	|				КОНЕЦ
	|		ИНАЧЕ ВТОстатки%ИмяОстатки_С_ОС.СуммаОстатокДт
	|	КОНЕЦ КАК СуммаОстатокДт,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОсновныеСредства.ГрупповойУчет, ЛОЖЬ)
	|			ТОГДА ВЫБОР
	|					КОГДА  ВТОстатки%ИмяОстатки_С_ОС.СуммаОстатокКт = 0
	|							И ВТОстатки%ИмяОстатки_С_ОС.КоличествоОстатокКт = 0
	|						ТОГДА 0
	|					ИНАЧЕ " + Остатки_ПолучитьПолеВыбораВТСтоимостьОбъектовОС("СтоимостьОстаток", "СуммаОстатокКт", ДополнительныеПараметры.ПараметрыВыполнения) + "
	|				КОНЕЦ
	|		ИНАЧЕ ВТОстатки%ИмяОстатки_С_ОС.СуммаОстатокКт
	|	КОНЕЦ КАК СуммаОстатокКт,
	|	ВТОстатки%ИмяОстатки_С_ОС.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстатокДт,
	|	ВТОстатки%ИмяОстатки_С_ОС.ВалютнаяСуммаОстатокКт КАК ВалютнаяСуммаОстатокКт,
	|	ВЫБОР КОГДА ЕПСБУ.Количественный ТОГДА ВЫБОР
	|		КОГДА ЕСТЬNULL(ОсновныеСредства.ГрупповойУчет, ЛОЖЬ)
	|			ТОГДА ВЫБОР
	|					КОГДА ВТОстатки%ИмяОстатки_С_ОС.СуммаОстатокДт = 0
	|							И ВТОстатки%ИмяОстатки_С_ОС.КоличествоОстатокДт = 0
	|						ТОГДА 0
	|					ИНАЧЕ " + Остатки_ПолучитьПолеВыбораВТСтоимостьОбъектовОС("КоличествоОстаток", "КоличествоОстатокДт", ДополнительныеПараметры.ПараметрыВыполнения) + "
	|				КОНЕЦ
	|		ИНАЧЕ ВТОстатки%ИмяОстатки_С_ОС.КоличествоОстатокДт
	|	КОНЕЦ ИНАЧЕ 0 КОНЕЦ КАК КоличествоОстатокДт,
	|	ВЫБОР КОГДА ЕПСБУ.Количественный ТОГДА ВЫБОР
	|		КОГДА ЕСТЬNULL(ОсновныеСредства.ГрупповойУчет, ЛОЖЬ)
	|			ТОГДА ВЫБОР
	|					КОГДА ВТОстатки%ИмяОстатки_С_ОС.СуммаОстатокКт = 0
	|							И ВТОстатки%ИмяОстатки_С_ОС.КоличествоОстатокКт = 0
	|						ТОГДА 0
	|					ИНАЧЕ " + Остатки_ПолучитьПолеВыбораВТСтоимостьОбъектовОС("КоличествоОстаток", "КоличествоОстатокКт", ДополнительныеПараметры.ПараметрыВыполнения) + "
	|				КОНЕЦ
	|		ИНАЧЕ ВТОстатки%ИмяОстатки_С_ОС.КоличествоОстатокКт
	|	КОНЕЦ ИНАЧЕ 0 КОНЕЦ КАК КоличествоОстатокКт,
	|	ВТОстатки%ИмяОстатки_С_ОС.КФО КАК КФО
	|ПОМЕСТИТЬ ВТОстатки%ИмяОстаткиОбработанная
	|ИЗ
	|	ВТОстатки%ИмяОстатки_С_ОС КАК ВТОстатки%ИмяОстатки_С_ОС
	|		" + Остатки_ПолучитьСоединенияВТСтоимостьОбъектовОС(ДополнительныеПараметры.ПараметрыВыполнения) + " 
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ПО ВТОстатки%ИмяОстатки_С_ОС.ОС = ОсновныеСредства.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ВТОстатки%ИмяОстатки_С_ОС.Счет = ЕПСБУ.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТОстатки%ИмяОстатки_Без_ОС.Счет,
	|	ВТОстатки%ИмяОстатки_Без_ОС.Субконто1,
	|	ВТОстатки%ИмяОстатки_Без_ОС.Субконто2,
	|	ВТОстатки%ИмяОстатки_Без_ОС.Субконто3,
	|	ВТОстатки%ИмяОстатки_Без_ОС.Организация,
	|	ВТОстатки%ИмяОстатки_Без_ОС.КПС,
	|	ВТОстатки%ИмяОстатки_Без_ОС.КЭК,
	|	ВТОстатки%ИмяОстатки_Без_ОС.ИФО,
	|	ВТОстатки%ИмяОстатки_Без_ОС.Валюта,
	|	ВТОстатки%ИмяОстатки_Без_ОС.СуммаОстаток,
	|	ВТОстатки%ИмяОстатки_Без_ОС.СуммаОстатокДт,
	|	ВТОстатки%ИмяОстатки_Без_ОС.СуммаОстатокКт,
	|	ВТОстатки%ИмяОстатки_Без_ОС.ВалютнаяСуммаОстатокДт,
	|	ВТОстатки%ИмяОстатки_Без_ОС.ВалютнаяСуммаОстатокКт,
	|	ВЫБОР КОГДА ЕПСБУ.Количественный ТОГДА ВТОстатки%ИмяОстатки_Без_ОС.КоличествоОстатокДт ИНАЧЕ 0 КОНЕЦ,
	|	ВЫБОР КОГДА ЕПСБУ.Количественный ТОГДА ВТОстатки%ИмяОстатки_Без_ОС.КоличествоОстатокКт ИНАЧЕ 0 КОНЕЦ,
	|	ВТОстатки%ИмяОстатки_Без_ОС.КФО
	|ИЗ
	|	ВТОстатки%ИмяОстатки_Без_ОС КАК ВТОстатки%ИмяОстатки_Без_ОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ВТОстатки%ИмяОстатки_Без_ОС.Счет = ЕПСБУ.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОстатки%ИмяОстатки_С_ОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОстатки%ИмяОстатки_Без_ОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////" + 
	?(ДополнительныеПараметры.ПараметрыВыполнения.ИспользуетсяУчетФинВложений, "
	|ВЫБРАТЬ
	|	ЦенныеБумагиОстатки.Организация КАК Организация,
	|	ЦенныеБумагиОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ЦенныеБумагиОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТЦенныеБумагиОстатки%ИмяОстатки
	|ИЗ
	|	РегистрНакопления.ЦенныеБумаги.Остатки(%ПараметрДатаОстатки, ) КАК ЦенныеБумагиОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////", "");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяОстатки", ИмяОстатки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ПараметрДатаОстаткиГраница", ПараметрДатаОстаткиГраница);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ПараметрДатаОстатки", ПараметрДатаОстатки);
	
	Возврат ТекстЗапроса;
	
КонецФункции 

Функция ПолучитьТекстЗапросаОстаткиПредварительно(ИмяОстатки, ПараметрДатаОстатки, ПараметрыВыполнения, ПерваяТаблицаОбъединения = Ложь, ИмяОстаткиПредварительно = "")
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ВТОстатки%ИмяОстаткиОбработанная.Организация" 				    + ?(ПерваяТаблицаОбъединения, " КАК Организация", "") + ",
	|	%ПараметрДатаОстатки" 											+ ?(ПерваяТаблицаОбъединения, " КАК ДатаОкончания", "") + ",
	|	ЕПСБУ.Ссылка" 													+ ?(ПерваяТаблицаОбъединения, " КАК Счет", "") + ",
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ВТОстатки%ИмяОстаткиОбработанная.КФО)" 		+ ?(ПерваяТаблицаОбъединения, " КАК КФО", "") + ",
	|	ВТОстатки%ИмяОстаткиОбработанная.КФО" 							+ ?(ПерваяТаблицаОбъединения, " КАК КФОСсылка", "") + ",
	|	ЕСТЬNULL(КлассификационныеПризнакиСчетов.Код, """")" 			+ ?(ПерваяТаблицаОбъединения, " КАК КПС", "") + ",
	|	ЕСТЬNULL(КлассификационныеПризнакиСчетов.Ссылка, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка))" + ?(ПерваяТаблицаОбъединения, " КАК КПССсылка", "") + ",
	|	ВТОстатки%ИмяОстаткиОбработанная.КЭК" 							+ ?(ПерваяТаблицаОбъединения, " КАК КЭК", "") + ",
	|	ВТОстатки%ИмяОстаткиОбработанная.Субконто1" 					+ ?(ПерваяТаблицаОбъединения, " КАК Субконто1", "") + ",
	|	ВТОстатки%ИмяОстаткиОбработанная.Субконто2" 					+ ?(ПерваяТаблицаОбъединения, " КАК Субконто2", "") + ",
	|	ВТОстатки%ИмяОстаткиОбработанная.Субконто3" 					+ ?(ПерваяТаблицаОбъединения, " КАК Субконто3", "") + ",
	|	СУММА(ВТОстатки%ИмяОстаткиОбработанная.СуммаОстаток)" 			+ ?(ПерваяТаблицаОбъединения, " КАК СуммаОстаток", "") + ",
	|	СУММА(ВТОстатки%ИмяОстаткиОбработанная.СуммаОстатокДт)" 		+ ?(ПерваяТаблицаОбъединения, " КАК СуммаОстатокДт", "") + ",
	|	СУММА(ВТОстатки%ИмяОстаткиОбработанная.СуммаОстатокКт)" 		+ ?(ПерваяТаблицаОбъединения, " КАК СуммаОстатокКт", "") + ",
	|	СУММА(ВЫБОР
	|			КОГДА ВТТаблицаСвязейАналитик_Общ.Счет = ""31""" + ?(ПараметрыВыполнения.ИспользуетсяУчетФинВложений, "
	|				ТОГДА ЕСТЬNULL(ВТЦенныеБумагиОстатки%ИмяОстатки.КоличествоОстаток, ВТОстатки%ИмяОстаткиОбработанная.КоличествоОстатокДт)", "
	|				ТОГДА ВТОстатки%ИмяОстаткиОбработанная.КоличествоОстатокДт") + "
	|			ИНАЧЕ ВТОстатки%ИмяОстаткиОбработанная.КоличествоОстатокДт
	|		КОНЕЦ)" 													+ ?(ПерваяТаблицаОбъединения, " КАК КоличествоОстатокДт", "") + ",
	|	СУММА(ВТОстатки%ИмяОстаткиОбработанная.КоличествоОстатокКт)" 	+ ?(ПерваяТаблицаОбъединения, " КАК КоличествоОстатокКт", "") + ",
	|	ЕСТЬNULL(Валюты.Код, """")" 									+ ?(ПерваяТаблицаОбъединения, " КАК Валюта", "") + ",
	|	СУММА(ВТОстатки%ИмяОстаткиОбработанная.ВалютнаяСуммаОстатокДт)" + ?(ПерваяТаблицаОбъединения, " КАК ВалютнаяСуммаОстатокДт", "") + ",
	|	СУММА(ВТОстатки%ИмяОстаткиОбработанная.ВалютнаяСуммаОстатокКт)" + ?(ПерваяТаблицаОбъединения, " КАК ВалютнаяСуммаОстатокКт", "") + ",
	|	ВТТаблицаСвязейАналитик_Общ.Счет" 								+ ?(ПерваяТаблицаОбъединения, " КАК СчетКод", "") + ",
	|	ВЫБОР
	|		КОГДА ВТТаблицаСвязейАналитик_Общ.ВОстатках1
	|			ТОГДА ВТТаблицаСвязейАналитик_Общ.Аналитика1
	|		ИНАЧЕ """"
	|	КОНЕЦ" 															+ ?(ПерваяТаблицаОбъединения, " КАК Аналитика1", "") + ",
	|	ВЫБОР
	|		КОГДА ВТТаблицаСвязейАналитик_Общ.ВОстатках2
	|			ТОГДА ВТТаблицаСвязейАналитик_Общ.Аналитика2
	|		ИНАЧЕ """"
	|	КОНЕЦ" 															+ ?(ПерваяТаблицаОбъединения, " КАК Аналитика2", "") + ",
	|	ВЫБОР
	|		КОГДА ВТТаблицаСвязейАналитик_Общ.ВОстатках3
	|			ТОГДА ВТТаблицаСвязейАналитик_Общ.Аналитика3
	|		ИНАЧЕ """"
	|	КОНЕЦ" 															+ ?(ПерваяТаблицаОбъединения, " КАК Аналитика3", "") + ",
	|	ВЫБОР
	|		КОГДА ВТТаблицаСвязейАналитик_Общ.ВОстатках4
	|			ТОГДА ВТТаблицаСвязейАналитик_Общ.Аналитика4
	|		ИНАЧЕ """"
	|	КОНЕЦ" 															+ ?(ПерваяТаблицаОбъединения, " КАК Аналитика4", "") + ",
	|	ВЫБОР
	|		КОГДА ВТТаблицаСвязейАналитик_Общ.ВОстатках5
	|			ТОГДА ВТТаблицаСвязейАналитик_Общ.Аналитика5
	|		ИНАЧЕ """"
	|	КОНЕЦ" 															+ ?(ПерваяТаблицаОбъединения, " КАК Аналитика5", "") + ",
	|	ВЫБОР
	|		КОГДА ВТТаблицаСвязейАналитик_Общ.ВОстатках6
	|			ТОГДА ВТТаблицаСвязейАналитик_Общ.Аналитика6
	|		ИНАЧЕ """"
	|	КОНЕЦ" 															+ ?(ПерваяТаблицаОбъединения, " КАК Аналитика6", "") + ",
	|	ВТТаблицаСвязейАналитик_Общ.ОбязательноВОстатках1" 				+ ?(ПерваяТаблицаОбъединения, " КАК ОбязательноВОстатках1", "") + ",
	|	ВТТаблицаСвязейАналитик_Общ.ОбязательноВОстатках2" 				+ ?(ПерваяТаблицаОбъединения, " КАК ОбязательноВОстатках2", "") + ",
	|	ВТТаблицаСвязейАналитик_Общ.ОбязательноВОстатках3" 				+ ?(ПерваяТаблицаОбъединения, " КАК ОбязательноВОстатках3", "") + ",
	|	ВТТаблицаСвязейАналитик_Общ.ОбязательноВОстатках4" 				+ ?(ПерваяТаблицаОбъединения, " КАК ОбязательноВОстатках4", "") + ",
	|	ВТТаблицаСвязейАналитик_Общ.ОбязательноВОстатках5" 				+ ?(ПерваяТаблицаОбъединения, " КАК ОбязательноВОстатках5", "") + ",
	|	ВТТаблицаСвязейАналитик_Общ.ОбязательноВОстатках6" 				+ ?(ПерваяТаблицаОбъединения, " КАК ОбязательноВОстатках6", "") + ",
	|	ВТОстатки%ИмяОстаткиОбработанная.Счет" 							+ ?(ПерваяТаблицаОбъединения, " КАК СубСчет", "") + ",
	|	" + ПолучитьТекстЗапросаТипКБК("КлассификационныеПризнакиСчетов") + 
	"" 															        + ?(ПерваяТаблицаОбъединения, " КАК ТипКБК", "") + ",
	|	ЕПСБУ.Вид" 														+ ?(ПерваяТаблицаОбъединения, " КАК ВидСчета", "") + ",
	|	ЕПСБУ.Код" 														+ ?(ПерваяТаблицаОбъединения, " КАК СубСчетКод", "") + " 
	|" 																	+ ?(ПерваяТаблицаОбъединения, "ПОМЕСТИТЬ %ИмяОстаткиПредварительно", "") + " 
	|ИЗ
	|	ВТОстатки%ИмяОстаткиОбработанная КАК ВТОстатки%ИмяОстаткиОбработанная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПланСчетов КАК ЕПСБУ
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТТаблицаСвязейАналитик КАК ВТТаблицаСвязейАналитик_Общ
	|			ПО (ЕПСБУ.Код = ВТТаблицаСвязейАналитик_Общ.Счет
	|					ИЛИ ЕПСБУ.КодРодитель = ВТТаблицаСвязейАналитик_Общ.Счет
	|					ИЛИ ЕПСБУ.КодРодтельРодитель = ВТТаблицаСвязейАналитик_Общ.Счет)
	|		ПО ВТОстатки%ИмяОстаткиОбработанная.Счет = ЕПСБУ.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОрганизацииФедеральногоБюджета КАК ВТОрганизацииФедеральногоБюджета
	|		ПО ВТОстатки%ИмяОстаткиОбработанная.Организация = ВТОрганизацииФедеральногоБюджета.Организация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификационныеПризнакиСчетов КАК КлассификационныеПризнакиСчетов
	|		ПО ВТОстатки%ИмяОстаткиОбработанная.КПС = КлассификационныеПризнакиСчетов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ВТОстатки%ИмяОстаткиОбработанная.Валюта = Валюты.Ссылка" + ?(ПараметрыВыполнения.ИспользуетсяУчетФинВложений, "
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦенныеБумагиОстатки%ИмяОстатки КАК ВТЦенныеБумагиОстатки%ИмяОстатки
	|		ПО ВТОстатки%ИмяОстаткиОбработанная.Организация = ВТЦенныеБумагиОстатки%ИмяОстатки.Организация
	|			И (ВЫБОР
	|				КОГДА ВТОстатки%ИмяОстаткиОбработанная.Субконто2 ССЫЛКА Справочник.ОбъектыФинансовыхВложений
	|					ТОГДА ВТОстатки%ИмяОстаткиОбработанная.Субконто2 = ВТЦенныеБумагиОстатки%ИмяОстатки.ЦеннаяБумага
	|			КОНЕЦ)", "") + "
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТОстатки%ИмяОстаткиОбработанная.Организация,
	|	ЕПСБУ.Ссылка,
