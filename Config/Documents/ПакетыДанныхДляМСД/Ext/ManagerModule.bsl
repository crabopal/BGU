		КонецЕсли;
		
		Объект_OS_V_PUTI.GUID = XMLСтрока(Выборка.GUID);                                    
		Объект_OS_V_PUTI.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");  
