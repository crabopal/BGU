			ОбъектOBREMENENIE.OWNER =  XMLСтрока(ВыборкаОбременений.GUID);     
			ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("NMA_OBREMENENIE" + ОбъектOBREMENENIE.OWNER, ОбъектOBREMENENIE.ID); 
			ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
			
			ВыборкаОбремененийВыборка = ВыборкаОбременений.Выбрать();  
			п_НН = 1;
			Пока ВыборкаОбремененийВыборка.Следующий() Цикл
				новСтрока = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "OBREMENENIE").Свойства.Получить("ROW").Тип);
				ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, ВыборкаОбремененийВыборка);
				пЗаполнитьЗначенияСвойств(новСтрока, СтруктураРеквизитов);
				Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
					ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, "NMA_OBREMENENIE", Строка(ВыборкаОбремененийВыборка.Наименование), НН, МассивОбязательныхРеквизитов);
				КонецЕсли;
				
				новСтрока.ROWNUM = п_НН;
				п_НН = п_НН + 1;    
				Если СтруктураРеквизитов.Свойство("KONTRAGENT") Тогда
					ИД_Контрагента = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("KONTRAGENT_" + XMLСтрока(ВыборкаОбремененийВыборка.GUIDКонтрагент));
					новСтрока.KONTRAGENT = ?(ЗначениеЗаполнено(ИД_Контрагента), ИД_Контрагента, "");
				КонецЕсли;
				ОбъектOBREMENENIE.ROW.Добавить(новСтрока);
			КонецЦикла;                  
			ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектOBREMENENIE);
		КонецЦикла;
		
	КонецЕсли;
	
	МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("NMA", ПараметрыВыполнения);		
	
	Пока Выборка.Следующий() Цикл  
		ОбъектNMA = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "NMA")); 
		
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитовNMA, Выборка);		
		СтруктураРеквизитовNMA.GUID = XMLСтрока(Выборка.GUID);                                    
		пЗаполнитьЗначенияСвойств(ОбъектNMA, СтруктураРеквизитовNMA);
		Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
			ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитовNMA, "NMA", Строка(Выборка.NAME), НН, МассивОбязательныхРеквизитов);
		КонецЕсли;
		
		ОбъектNMA.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");  
		ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("NMA_" + ОбъектNMA.GUID, ОбъектNMA.ID);
		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
		
		Если СтруктураРеквизитовNMA.Свойство("NMA_PRAVOOBLADANIE") Тогда
			ИД_Правообладания = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("NMA_PRAVOOBLADANIE_" + ОбъектNMA.GUID);		
			ОбъектNMA.NMA_PRAVOOBLADANIE = ?(ЗначениеЗаполнено(ИД_Правообладания), ИД_Правообладания, "");
		КонецЕсли;		
		Если СтруктураРеквизитовNMA.Свойство("NMA_OBREMENENIE") Тогда
			ИД_Обременений = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("NMA_OBREMENENIE_" + ОбъектNMA.GUID);	
			ОбъектNMA.NMA_OBREMENENIE = ?(ЗначениеЗаполнено(ИД_Обременений), ИД_Обременений, "");
		КонецЕсли;		
		                
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектNMA);
	КонецЦикла;
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТАналитики_NMA; УНИЧТОЖИТЬ ВТАналитикиNMA_; УНИЧТОЖИТЬ ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет; УНИЧТОЖИТЬ ВТРасчетАмортизацииОС; 
	|УНИЧТОЖИТЬ ВТСведенияКадастровогоУчета; УНИЧТОЖИТЬ ВТ_СобытияОССрез; УНИЧТОЖИТЬ ВТ_СобытияОС; УНИЧТОЖИТЬ ВТ_ИнвНомера"); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();			
	
КонецПроцедуры      

Процедура NPA(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения)
	
	ЗаписьXML = ОбщийОбъект;
	
	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.NPA(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	СпецАналитикуВМенеджерВТ(МенеджерВТ, МодульОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства), "NPA",,ПараметрыВыполнения);		
	
	#Область ТекстЗапроса
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(ИнвентарныеНомераОС.ОС, ВТАналитики_NPA.Аналитика) КАК Аналитика,
	|	ВТАналитики_NPA.Аналитика КАК GUID
	|ПОМЕСТИТЬ ВТАналитикиNPA_
	|ИЗ
	|	ВТАналитики_NPA КАК ВТАналитики_NPA
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|		ПО ВТАналитики_NPA.Аналитика = ИнвентарныеНомераОС.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Аналитика,
	|	GUID
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации
	|ПОМЕСТИТЬ ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	|			,
	|			Активность
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						Т.Аналитика
	|					ИЗ
	|						ВТАналитикиNPA_ КАК Т)) КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасчетАмортизацииОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	РасчетАмортизацииОССрезПоследних.СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|ПОМЕСТИТЬ ВТРасчетАмортизацииОС
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	|			,
	|			Активность
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						Т.Аналитика
	|					ИЗ
	|						ВТАналитикиNPA_ КАК Т)) КАК РасчетАмортизацииОССрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СведенияКадастровогоУчетаСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомер КАК КадастровыйНомер,
	|	СведенияКадастровогоУчетаСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь
	|ПОМЕСТИТЬ ВТСведенияКадастровогоУчета
	|ИЗ
	|	РегистрСведений.СведенияКадастровогоУчета.СрезПоследних(
	|			,
	|			ОсновноеСредство В
	|				(ВЫБРАТЬ
	|					Т.Аналитика
	|				ИЗ
	|					ВТАналитикиNPA_ КАК Т)) КАК СведенияКадастровогоУчетаСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОС.Событие КАК Событие,
	|	МАКСИМУМ(СобытияОС.Период) КАК Период,
	|	СобытияОС.Активность КАК Активность
	|ПОМЕСТИТЬ ВТ_СобытияОССрез
	|ИЗ
	|	РегистрСведений.СобытияОС КАК СобытияОС
	|
	|СГРУППИРОВАТЬ ПО
	|	СобытияОС.Событие,
	|	СобытияОС.ОсновноеСредство,
	|	СобытияОС.Активность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СобытияОС.ДатаСобытия КАК ДатаСобытия,
	|	СобытияОС.ИнвНомер КАК ИнвНомер
	|ПОМЕСТИТЬ ВТ_СобытияОС
	|ИЗ
	|	ВТ_СобытияОССрез КАК ВТ_СобытияОССрез
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС КАК СобытияОС
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТАналитикиNPA_ КАК ВТАналитикиNPA_
	|			ПО СобытияОС.ОсновноеСредство = ВТАналитикиNPA_.Аналитика
	|				И (СобытияОС.Активность)
	|		ПО ВТ_СобытияОССрез.ОсновноеСредство = СобытияОС.ОсновноеСредство
	|			И ВТ_СобытияОССрез.Событие = СобытияОС.Событие
	|			И ВТ_СобытияОССрез.Период = СобытияОС.Период
	|			И ВТ_СобытияОССрез.Активность = СобытияОС.Активность
	|ГДЕ
	|	СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)
	|	И СобытияОС.Активность
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИнвНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВТАналитикиNPA_.GUID КАК GUID,
	|	ИнвентарныеНомераОС.Ссылка КАК Ссылка,
	|	ИнвентарныеНомераОС.Код КАК INV_NOMER,
	|	ИнвентарныеНомераОС.ОС КАК ОС,
	|	ВЫРАЗИТЬ(ИнвентарныеНомераОС.ЗаводскойНомер КАК СТРОКА(40)) КАК NUM_ZAVOD,
	|	ИнвентарныеНомераОС.РеестровыйНомер КАК NUM_REESTR,
	|	ИнвентарныеНомераОС.ИнойНомер КАК NUM_INOY,
	|	ИнвентарныеНомераОС.ДатаВыпуска КАК DATA_VYP,
	|	ЕСТЬNULL(ВТ_СобытияОС.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1)) КАК DATA_EKSP
	|ПОМЕСТИТЬ ВТ_ИнвНомера
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТАналитикиNPA_ КАК ВТАналитикиNPA_
	|		ПО ИнвентарныеНомераОС.Ссылка = ВТАналитикиNPA_.GUID
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СобытияОС КАК ВТ_СобытияОС
	|		ПО ИнвентарныеНомераОС.Ссылка = ВТ_СобытияОС.ИнвНомер
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОС,
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТАналитикиNPA_.GUID КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТАналитикиNPA_.GUID) КАК GUID,
	|	ОсновныеСредстваПравообладания.ВидПрава КАК VID_PRAVA,
	|	ОсновныеСредстваПравообладания.ДатаДокумента КАК DATE,
	|	ОсновныеСредстваПравообладания.НомерДокумента КАК NOMER
	|ИЗ
	|	ВТАналитикиNPA_ КАК ВТАналитикиNPA_
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства.Правообладания КАК ОсновныеСредстваПравообладания
	|		ПО ВТАналитикиNPA_.Аналитика = ОсновныеСредстваПравообладания.Ссылка
	|ИТОГИ ПО
	|	GUID
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ИнвНомера.GUID КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТ_ИнвНомера.GUID) КАК GUID,
	|	ВТ_ИнвНомера.INV_NOMER КАК Наименование,
	|	ИнвентарныеНомераОСОбременения.НаименованиеЧасти КАК NAME_IT,
	|	ИнвентарныеНомераОСОбременения.РазмерЧасти КАК RAZMER_IT,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Код, ""000"") КАК ED_IZM,
	|	ИнвентарныеНомераОСОбременения.ВидОбременения КАК VID_OBREM,
	|	ИнвентарныеНомераОСОбременения.ДатаНачала КАК DATE_NACH,
	|	ИнвентарныеНомераОСОбременения.ДатаОкончания КАК DATE_OKONCH,
	|	ИнвентарныеНомераОСОбременения.ДокументРегистрацииДата КАК DOC_REG_DATE,
	|	ИнвентарныеНомераОСОбременения.ДокументРегистрацииНомер КАК DOC_REG_NUM,
	|	ИнвентарныеНомераОСОбременения.ДокументОбремененияВид КАК DOC_OBR_VID,
	|	ИнвентарныеНомераОСОбременения.ДокументОбремененияДата КАК DOC_OBR_DATE,
	|	ИнвентарныеНомераОСОбременения.ДокументОбремененияНомер КАК DOC_OBR_NUM,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ИнвентарныеНомераОСОбременения.Контрагент) КАК GUIDКонтрагент,
	|	ИнвентарныеНомераОСОбременения.Контрагент КАК Контрагент
	|ИЗ
	|	ВТ_ИнвНомера КАК ВТ_ИнвНомера
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС.Обременения КАК ИнвентарныеНомераОСОбременения
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|			ПО ИнвентарныеНомераОСОбременения.ЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка
	|		ПО ВТ_ИнвНомера.Ссылка = ИнвентарныеНомераОСОбременения.Ссылка
	|ИТОГИ ПО
	|	GUID
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВТАналитикиNPA_.GUID КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТАналитикиNPA_.GUID) КАК GUID,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА ОсновныеСредства.НаименованиеПолное = """"
	|				ТОГДА ОсновныеСредства.Наименование
	|			ИНАЧЕ ОсновныеСредства.НаименованиеПолное
	|		КОНЕЦ КАК СТРОКА(300)) КАК NAME,
	|	ЕСТЬNULL(ВТРасчетАмортизацииОС.СрокПолезногоИспользования, 0) КАК SROK,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ПерваяГруппа)
	|			ТОГДА ""01""
	|		КОГДА ОсновныеСредства.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ВтораяГруппа)
	|			ТОГДА ""02""
	|		КОГДА ОсновныеСредства.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ТретьяГруппа)
	|			ТОГДА ""03""
	|		КОГДА ОсновныеСредства.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ЧетвертаяГруппа)
	|			ТОГДА ""04""
	|		КОГДА ОсновныеСредства.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ПятаяГруппа)
	|			ТОГДА ""05""
	|		КОГДА ОсновныеСредства.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ШестаяГруппа)
	|			ТОГДА ""06""
	|		КОГДА ОсновныеСредства.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.СедьмаяГруппа)
	|			ТОГДА ""07""
	|		КОГДА ОсновныеСредства.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ВосьмаяГруппа)
	|			ТОГДА ""08""
	|		КОГДА ОсновныеСредства.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ДевятаяГруппа)
	|			ТОГДА ""09""
	|		КОГДА ОсновныеСредства.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ДесятаяГруппа)
	|			ТОГДА ""10""
	|		ИНАЧЕ ""00""
	|	КОНЕЦ КАК AMORT_GR,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ОсновныеСредства.КодОКОФ) КАК OKOF,
	|	ВЫБОР
	|		КОГДА ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет.СпособНачисленияАмортизации ЕСТЬ NULL
	|			ТОГДА """"
	|		КОГДА ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию)
	|			ТОГДА ""01""
	|		КОГДА ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)
	|			ТОГДА ""02""
	|		КОГДА ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка)
	|			ТОГДА ""03""
	|		КОГДА ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции)
	|			ТОГДА ""04""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК SPOSOB_AMORT,
	|	ЕСТЬNULL(ВТСведенияКадастровогоУчета.КадастровыйНомер, """") КАК NUM_KADASTR,
	|	ЕСТЬNULL(ВТСведенияКадастровогоУчета.ОбщаяПлощадь, 0) КАК SQUARE,
	|	ЕСТЬNULL(ВТ_ИнвНомера.INV_NOMER, """") КАК INV_NOMER,
	|	ЕСТЬNULL(ВТ_ИнвНомера.NUM_ZAVOD, """") КАК NUM_ZAVOD,
	|	ЕСТЬNULL(ВТ_ИнвНомера.NUM_REESTR, """") КАК NUM_REESTR,
	|	ЕСТЬNULL(ВТ_ИнвНомера.NUM_INOY, """") КАК NUM_INOY,
	|	ЕСТЬNULL(ВТ_ИнвНомера.DATA_VYP, ДАТАВРЕМЯ(1, 1, 1)) КАК DATA_VYP,
	|	ЕСТЬNULL(ВТ_ИнвНомера.DATA_EKSP, ДАТАВРЕМЯ(1, 1, 1)) КАК DATA_EKSP
	|ИЗ
	|	ВТАналитикиNPA_ КАК ВТАналитикиNPA_
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК ОсновныеСредства
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТРасчетАмортизацииОС КАК ВТРасчетАмортизацииОС
	|			ПО ОсновныеСредства.Ссылка = ВТРасчетАмортизацииОС.ОсновноеСредство
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет КАК ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет
	|			ПО ОсновныеСредства.Ссылка = ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет.ОсновноеСредство
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТСведенияКадастровогоУчета КАК ВТСведенияКадастровогоУчета
	|			ПО ОсновныеСредства.Ссылка = ВТСведенияКадастровогоУчета.ОсновноеСредство
	|		ПО ВТАналитикиNPA_.Аналитика = ОсновныеСредства.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИнвНомера КАК ВТ_ИнвНомера
	|		ПО ВТАналитикиNPA_.GUID = ВТ_ИнвНомера.Ссылка");
	
	#КонецОбласти	
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Пакет = Запрос.ВыполнитьПакет();
	
	Выборка 				= Пакет[Пакет.Количество() - 1].Выбрать();
	ВыборкаПравообладателей = Пакет[Пакет.Количество() - 3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаОбременений 		= Пакет[Пакет.Количество() - 2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	СтруктураРеквизитовNPA = СтруктураРеквизитовАналитики("NPA", ПараметрыВыполнения);
	НН = ПараметрыВыполнения.НаборИсторияПроверкиАналитик.Количество(); 
	
	Если СтруктураРеквизитовNPA.Свойство("NPA_PRAVOOBLADANIE") Тогда
		МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("NPA_PRAVOOBLADANIE", ПараметрыВыполнения);		
		
		СтруктураРеквизитов = СтруктураРеквизитовАналитики("NPA_PRAVOOBLADANIE", ПараметрыВыполнения);
		
		Пока ВыборкаПравообладателей.Следующий() Цикл     
			ОбъектPRAVOOBLADANIE = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "NPA_PRAVOOBLADANIE"));       
			ОбъектPRAVOOBLADANIE.ID =  Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");     
			ОбъектPRAVOOBLADANIE.OWNER =  XMLСтрока(ВыборкаПравообладателей.GUID);     
			ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("NPA_PRAVOOBLADANIE_" + ОбъектPRAVOOBLADANIE.OWNER, ОбъектPRAVOOBLADANIE.ID); 
			ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
			
			ВыборкаПравообладателейВыборка = ВыборкаПравообладателей.Выбрать();
			п_НН = 1; 
			Пока ВыборкаПравообладателейВыборка.Следующий() Цикл 
				новСтрока = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "PRAVOOBLADANIE").Свойства.Получить("ROW").Тип);
				ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, ВыборкаПравообладателейВыборка);
				пЗаполнитьЗначенияСвойств(новСтрока, СтруктураРеквизитов);
				Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
					ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, "NPA_PRAVOOBLADANIE", Строка(ВыборкаПравообладателейВыборка.Ссылка), НН, МассивОбязательныхРеквизитов);
				КонецЕсли;
				
				новСтрока.ROWNUM = п_НН;
				п_НН = п_НН + 1;
				
				ОбъектPRAVOOBLADANIE.ROW.Добавить(новСтрока);
			КонецЦикла;
			                
			ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектPRAVOOBLADANIE);
		КонецЦикла;
		
	КонецЕсли;
	
	Если СтруктураРеквизитовNPA.Свойство("NPA_OBREMENENIE") Тогда
		МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("NPA_OBREMENENIE", ПараметрыВыполнения);		
		
		СтруктураРеквизитов = СтруктураРеквизитовАналитики("NPA_OBREMENENIE", ПараметрыВыполнения);
		Пока ВыборкаОбременений.Следующий() Цикл
			
			ОбъектOBREMENENIE = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "NPA_OBREMENENIE"));       
			ОбъектOBREMENENIE.ID =  Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");     
			ОбъектOBREMENENIE.OWNER =  XMLСтрока(ВыборкаОбременений.GUID);     
			ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("NPA_OBREMENENIE_" + ОбъектOBREMENENIE.OWNER, ОбъектOBREMENENIE.ID); 
			ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
			
			ВыборкаОбремененийВыборка = ВыборкаОбременений.Выбрать();  
			п_НН = 1;
			Пока ВыборкаОбремененийВыборка.Следующий() Цикл
				новСтрока = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "NPA_OBREMENENIE").Свойства.Получить("ROW").Тип);
				ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, ВыборкаОбремененийВыборка);
				пЗаполнитьЗначенияСвойств(новСтрока, СтруктураРеквизитов);
				Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
					ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, "NPA_OBREMENENIE", Строка(ВыборкаОбремененийВыборка.Наименование), НН, МассивОбязательныхРеквизитов);
				КонецЕсли;
				
				новСтрока.ROWNUM = п_НН;
				п_НН = п_НН + 1;    
				Если СтруктураРеквизитов.Свойство("KONTRAGENT") Тогда
					ИД_Контрагента = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("KONTRAGENT_" + XMLСтрока(ВыборкаОбремененийВыборка.GUIDКонтрагент));
					новСтрока.KONTRAGENT = ?(ЗначениеЗаполнено(ИД_Контрагента), ИД_Контрагента, "");
				КонецЕсли;
				
				ОбъектOBREMENENIE.ROW.Добавить(новСтрока);
			КонецЦикла;   
			
			ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектOBREMENENIE);
		КонецЦикла;
		
	КонецЕсли;
	
	МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("NPA", ПараметрыВыполнения);		
	
	Пока Выборка.Следующий() Цикл  
		ОбъектNPA = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "NPA")); 
		
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитовNPA, Выборка);				
		СтруктураРеквизитовNPA.GUID = XMLСтрока(Выборка.GUID);                                    
		
		
		пЗаполнитьЗначенияСвойств(ОбъектNPA, СтруктураРеквизитовNPA);
		Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
			ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитовNPA, "NPA", Строка(Выборка.NAME), НН, МассивОбязательныхРеквизитов);
		КонецЕсли;
		
		ОбъектNPA.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");  
		ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("NPA_" + ОбъектNPA.GUID, ОбъектNPA.ID);
		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
		
		Если СтруктураРеквизитовNPA.Свойство("NPA_PRAVOOBLADANIE") Тогда
			ИД_Правообладания = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("NPA_PRAVOOBLADANIE_" + ОбъектNPA.GUID);		
			ОбъектNPA.NPA_PRAVOOBLADANIE = ?(ЗначениеЗаполнено(ИД_Правообладания), ИД_Правообладания, "");
		КонецЕсли;		
		Если СтруктураРеквизитовNPA.Свойство("NPA_OBREMENENIE") Тогда
			ИД_Обременений = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("NPA_OBREMENENIE_" + ОбъектNPA.GUID);	
			ОбъектNPA.NPA_OBREMENENIE = ?(ЗначениеЗаполнено(ИД_Обременений), ИД_Обременений, "");
		КонецЕсли;		
		                
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектNPA);
	КонецЦикла;   
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТАналитики_NPA; УНИЧТОЖИТЬ ВТАналитикиNPA_; УНИЧТОЖИТЬ ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет; УНИЧТОЖИТЬ ВТРасчетАмортизацииОС; 
	|УНИЧТОЖИТЬ ВТСведенияКадастровогоУчета; УНИЧТОЖИТЬ ВТ_СобытияОССрез; УНИЧТОЖИТЬ ВТ_СобытияОС; УНИЧТОЖИТЬ ВТ_ИнвНомера"); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();		
	
КонецПроцедуры  

Процедура MZ_BIO(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения)
	
	ЗаписьXML = ОбщийОбъект;
	
	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.MZ_BIO(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	СпецАналитикиНаборомВМенеджерВТ(МенеджерВТ, "MZ_BIO");      
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Номенклатура.Ссылка) КАК GUID,
	|	Номенклатура.Наименование КАК NAME,
	|	ВЫБОР
	|		КОГДА Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Медикаменты)
	|			ТОГДА ""1""
	|		КОГДА Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПродуктыПитания)
	|			ТОГДА ""2""
	|		КОГДА Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ГСМ)
	|			ТОГДА ""3""
	|		КОГДА Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Стройматериалы)
	|			ТОГДА ""4""
	|		КОГДА Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МягкийИнвентарь)
	|			ТОГДА ""5""
	|		КОГДА Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПрочиеМЗ)
	|			ТОГДА ""6""
	|		КОГДА Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Продукция)
	|			ТОГДА ""7""
	|		КОГДА Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.БСО)
	|			ТОГДА ""8""
	|		КОГДА Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.БиологическиеАктивы)
	|			ТОГДА ""9""
	|		ИНАЧЕ ""6""
	|	КОНЕЦ КАК VID_MZ_BIO,
	|	Номенклатура.Сведения КАК SORT_VOZR_GR,
	|	ВЫБОР
	|		КОГДА Номенклатура.ВключитьВСоставВнеоборотныхАктивов
	|			ТОГДА ""1""
	|		ИНАЧЕ ""0""
	|	КОНЕЦ КАК VNEOBR_AKTIV,
	|	ЕстьNull(КлассификаторЕдиницИзмерения.Код, ""000"") КАК ED_IZM,
	|	Номенклатура.ОКП КАК KOD_OKPD2
	|ИЗ
	|	ВТАналитики_MZ_BIO КАК ВТАналитики_MZ_BIO
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|			ПО Номенклатура.ЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка
	|		ПО ВТАналитики_MZ_BIO.Аналитика = Номенклатура.Ссылка");       
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Выборка 				= Запрос.Выполнить().Выбрать();
	
	СтруктураРеквизитов = СтруктураРеквизитовАналитики("MZ_BIO", ПараметрыВыполнения);
	НН = ПараметрыВыполнения.НаборИсторияПроверкиАналитик.Количество();
	МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("MZ_BIO", ПараметрыВыполнения);
	
	Пока Выборка.Следующий() Цикл  
		ОбъектВMZ_BIO = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "MZ_BIO")); 
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, Выборка);                                  
		СтруктураРеквизитов.GUID = XMLСтрока(Выборка.GUID);
		
		пЗаполнитьЗначенияСвойств(ОбъектВMZ_BIO, СтруктураРеквизитов);
		Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
			ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, "MZ_BIO", Строка(Выборка.NAME), НН, МассивОбязательныхРеквизитов);
		КонецЕсли;
		
		
		ОбъектВMZ_BIO.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");  
		ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("MZ_BIO_" + ОбъектВMZ_BIO.GUID, ОбъектВMZ_BIO.ID);
		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1; 
		                 
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектВMZ_BIO);
	КонецЦикла;
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТАналитики_MZ_BIO"); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры  

