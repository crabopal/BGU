Процедура ЗагрузитьОстаткиПересчет(ПутьКФайлу, ОбъектДокумент, КэшИдентификаторов)
	
	ПространствоИмен = Неопределено;
	Файл = ОткрытьФайлПакета(ПутьКФайлу, "DataBalanceRecord", ПространствоИмен);
	
	Тип = ФабрикаXDTO.Тип(ПространствоИмен, "DataBalanceRecord");
	Набор = ПолучитьТЗДанныеОстатков();
	
	Пока Файл.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
		ЗаписьXDTO = ФабрикаXDTO.ПрочитатьXML(Файл, Тип);
		Запись = Набор.Добавить();
		Запись.Организация  = КэшИдентификаторов[ЗаписьXDTO.ORGANIZATION];
		Запись.Счет			= ЗаписьXDTO.Account;
		Запись.Период		= ЗаписьXDTO.Date;
		Запись.КПС			= ЗаписьXDTO.KBK;
		Запись.КФО			= ЗаписьXDTO.KFO;
		Запись.КЭК			= ЗаписьXDTO.KOSGU;		
		Запись.СуммаДт		= ЗаписьXDTO.Summa_Dt;
		Запись.СуммаКт		= ЗаписьXDTO.Summa_Kt;		
	КонецЦикла;
	
	Набор.Свернуть("Организация, Счет, Период, КПС, КФО, КЭК", "СуммаДт, СуммаКт");
	
	ТабДокПересчетОстатков = Новый ТабличныйДокумент; 
	МакетПересчетОстатков = ПолучитьМакет("ПФ_MXL_ДанныеДляПересчетаОстатков");
	
	ЗаполнитьТабДокПересчетОстатков(Набор, МакетПересчетОстатков, ТабДокПересчетОстатков);
	
	ОбъектДокумент.ДанныеДляПересчетаОстатков = Новый ХранилищеЗначения(ТабДокПересчетОстатков, Новый СжатиеДанных(9));		
	
КонецПроцедуры

Процедура ЗагрузитьДанныеОстатковИОборотов(ФайлыДанных, ОбъектДокумент, КэшИдентификаторов)
	
	ПутьКФайлуОстатки = Неопределено;
	Если ФайлыДанных.Свойство("Data_Balance", ПутьКФайлуОстатки) Тогда
		
		ПространствоИмен = Неопределено;
		Файл = ОткрытьФайлПакета(ПутьКФайлуОстатки, "DataBalanceRecord", ПространствоИмен);
		
		Тип = ФабрикаXDTO.Тип(ПространствоИмен, "DataBalanceRecord");
		НаборОстатки = ПолучитьТЗДанныеОстатков();
		НаборОбороты = НаборОстатки.Скопировать();
		
		Пока Файл.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
			ЗаписьXDTO = ФабрикаXDTO.ПрочитатьXML(Файл, Тип);
			Запись = НаборОстатки.Добавить();
			Запись.Организация  = КэшИдентификаторов[ЗаписьXDTO.ORGANIZATION];
			Запись.Счет			= ЗаписьXDTO.Account;
			Запись.Период		= ЗаписьXDTO.Date;
			Запись.КПС			= ЗаписьXDTO.KBK;
			Запись.КФО			= ЗаписьXDTO.KFO;
			Запись.КЭК			= ЗаписьXDTO.KOSGU;		
			Запись.СуммаДт		= ЗаписьXDTO.Summa_Dt;
			Запись.СуммаКт		= ЗаписьXDTO.Summa_Kt;	
		КонецЦикла;
		
		НаборОстатки.Свернуть("Организация, Счет, Период, КПС, КФО, КЭК", "СуммаДт, СуммаКт");
		НаборОстатки.Сортировать("Организация, Счет, КПС, КФО, КЭК");
		
		Суффиксы = Новый Структура;
		Суффиксы.Вставить("Дт", "_Dt");
		Суффиксы.Вставить("Кт", "_Kt");
		
		ПространствоИмен = Неопределено;
		
		Для Каждого Элемент Из ФайлыДанных Цикл
			Если НЕ СтрНачинаетсяС(ВРег(Элемент.Ключ), ВРег("Data_Transactions")) Тогда
				Продолжить;
			КонецЕсли;
			
			Файл = ОткрытьФайлПакета(Элемент.Значение, "DataTransactions", ПространствоИмен);
			
			Тип = ФабрикаXDTO.Тип(ПространствоИмен, "DataTransactions");
			
			Попытка
				Обороты = ФабрикаXDTO.ПрочитатьXML(Файл, Тип);
			Исключение
				Текст = ОписаниеОшибки();
				Продолжить;
			КонецПопытки;
			
			Для Каждого ЗаписьXDTO Из Обороты.DataTransactionsDay Цикл
				
				Для Каждого ЭлементСуффикс Из Суффиксы Цикл
					Суффикс = ЭлементСуффикс.Ключ;
					СуффиксXDTO	= ЭлементСуффикс.Значение;
					Запись = НаборОбороты.Добавить();
					Запись.Организация  	= КэшИдентификаторов[ЗаписьXDTO.ORGANIZATION];
					Запись["Сумма"+Суффикс]	= ЗаписьXDTO.Summa;
					Запись.КФО				= ЗаписьXDTO.KFO;
					Запись.Счет				= ЗаписьXDTO["Account" + СуффиксXDTO];
					Запись.КПС				= ЗаписьXDTO["KBK" + СуффиксXDTO];    				
					Запись.КЭК				= ЗаписьXDTO["KOSGU" + СуффиксXDTO];
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
		НаборОбороты.Свернуть("Организация, Счет, Период, КПС, КФО, КЭК", "СуммаДт, СуммаКт");
		НаборОбороты.Сортировать("Организация, Счет, КПС, КФО, КЭК");
		
		ТабДокОстаткиИОбороты = Новый ТабличныйДокумент; 
		МакетОстаткиИОбороты = ПолучитьМакет("ПФ_MXL_ДанныеОстатковИОборотов");
		
		ЗаполнитьТабДокОстаткиИОбороты(НаборОстатки, НаборОбороты, МакетОстаткиИОбороты, ТабДокОстаткиИОбороты, ОбъектДокумент);
		
		ОбъектДокумент.ДанныеОстатковИОборотов = Новый ХранилищеЗначения(ТабДокОстаткиИОбороты, Новый СжатиеДанных(9));	
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьДанныеМО(ПутьКФайлу, ОбъектДокумент, КэшИдентификаторов)
	
	ПространствоИмен = Неопределено;
	Файл = ОткрытьФайлПакета(ПутьКФайлу, "DataTransactionsMO", ПространствоИмен);
	
	Тип = ФабрикаXDTO.Тип(ПространствоИмен, "DataTransactionsMO");
	Набор = ПолучитьТЗДанныеМО();
	
	Пока Файл.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
		ЗаписьXDTO = ФабрикаXDTO.ПрочитатьXML(Файл, Тип);
		Запись = Набор.Добавить();
		Запись.Организация  = КэшИдентификаторов[ЗаписьXDTO.ORGANIZATION];
		Запись.СчетДт		= ЗаписьXDTO.Account_Dt; 
		Запись.СчетКт		= ЗаписьXDTO.Account_Kt;
		Запись.Период		= ЗаписьXDTO.DateRegistration;
		Запись.КПСДт		= ЗаписьXDTO.KBK_Dt;
		Запись.КПСКт		= ЗаписьXDTO.KBK_Kt;
		Запись.КФО			= ЗаписьXDTO.KFO;
		Запись.КЭКДт		= ЗаписьXDTO.KOSGU_Dt;	
		Запись.КЭККт		= ЗаписьXDTO.KOSGU_Kt;	
		Запись.Сумма		= ЗаписьXDTO.Summa;		
	КонецЦикла;
	
	Набор.Свернуть("Организация, СчетДт, СчетКт, Период, КПСДт, КПСКт, КФО, КЭКДт, КЭККт", "Сумма");
	Набор.Сортировать("Организация, Период");
	
	ТабДокМО = Новый ТабличныйДокумент; 
	
	МакетМО = ПолучитьМакет("ПФ_MXL_ДанныеМО");
	ОбластьШапка = МакетМО.ПолучитьОбласть("Шапка"); 
	ОбластьСтрокаПериод = МакетМО.ПолучитьОбласть("СтрокаПериод"); 
	ОбластьСтрокаОрганизация = МакетМО.ПолучитьОбласть("СтрокаОрганизация");
	ТабДокМО.Вывести(ОбластьШапка);
	
	ОрганизацияТекущая = Неопределено;
	ЕстьДанные = Ложь;
	Для каждого СтрокаМО Из Набор Цикл 
		ЕстьДанные = Истина;
		Если НЕ ОрганизацияТекущая = СтрокаМО.Организация Тогда
			Если НЕ ОрганизацияТекущая = Неопределено Тогда
				ТабДокМО.ЗакончитьГруппуСтрок();	
			КонецЕсли;	
			ОрганизацияТекущая = СтрокаМО.Организация;
			ОбластьСтрокаОрганизация.Параметры.Организация = ОрганизацияТекущая;
			ТабДокМО.Вывести(ОбластьСтрокаОрганизация);
			ТабДокМО.НачатьГруппуСтрок("Организация");
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаПериод.Параметры, СтрокаМО,,"Период");
		ОбластьСтрокаПериод.Параметры.Период = Формат(СтрокаМО.Период, "ДЛФ=Д");
		ТабДокМО.Вывести(ОбластьСтрокаПериод);
	КонецЦикла;
	Если ЕстьДанные Тогда 
		ТабДокМО.ЗакончитьГруппуСтрок();
	КонецЕсли;	
	ОбъектДокумент.ДанныеМО = Новый ХранилищеЗначения(ТабДокМО, Новый СжатиеДанных(9));	
	
КонецПроцедуры

Процедура ЗагрузитьАналитики(ФайлАналитик, КэшИдентификаторов)
	
	ПространствоИмен = Неопределено;
	
	Файл = ОткрытьФайлПакета(ФайлАналитик, "AnalyticsData", ПространствоИмен);
	Файл.Прочитать();
	
	ИмяТипа = Неопределено;
	
	Пока Файл.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
		Если Файл.Имя = "ORGANIZATION" Тогда				
			ИмяТипа = Файл.Имя;
			Тип = ФабрикаXDTO.Тип(ПространствоИмен, ИмяТипа);
			
			ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(Файл, Тип);
			
			GUID = Новый УникальныйИдентификатор(ОбъектXDTO.GUID);
			НайденнаяСсылка = Справочники.Организации.ПолучитьСсылку(GUID);
			КэшИдентификаторов.Вставить(ОбъектXDTO.ID, НайденнаяСсылка.Наименование);
		Иначе
			Прервать;		
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Остатки_ТекстЗапроса

Функция Остатки_ПолучитьТекстЗапросаСтоимостьОбъектовОС(ИмяОстатки, ПараметрыВыполнения)

	ТекстЗапроса = "";
	ПерваяИтерация = Истина; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
		|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Субконто1,
		|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Субконто2,
		|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Субконто3,
		|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
		|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
		|	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
		|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
		|	ЖурналПроводокЕПСБУОстатки.Валюта КАК Валюта,
		|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
		|	ЖурналПроводокЕПСБУОстатки.ЖурналОпераций КАК ЖурналОпераций,
		|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО
		|ПОМЕСТИТЬ ВТОстаткиСчет
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ПараметрДатаОстатки, , , ) КАК ЖурналПроводокЕПСБУОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
		|		И НЕ ЕПСБУВидыСубконто1.НомерСтроки ЕСТЬ NULL КАК ЕстьДоговоры,
		|	НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
		|		И НЕ ЕПСБУВидыСубконто2.НомерСтроки ЕСТЬ NULL КАК ЕстьЦМО,
		|	НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
		|		И НЕ ЕПСБУВидыСубконто3.НомерСтроки ЕСТЬ NULL КАК ЕстьКонтрагенты
		|ИЗ
		|	ВТОстаткиСчет КАК ВТОстаткиСчет
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ПО ВТОстаткиСчет.Счет = ЕПСБУВидыСубконто.Ссылка
		|			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовхарактеристик.ВидыСубконто.ОсновныеСредства))
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто1
		|		ПО ВТОстаткиСчет.Счет = ЕПСБУВидыСубконто1.Ссылка
		|			И (ЕПСБУВидыСубконто1.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовхарактеристик.ВидыСубконто.Договоры))
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто2
		|		ПО ВТОстаткиСчет.Счет = ЕПСБУВидыСубконто2.Ссылка
		|			И (ЕПСБУВидыСубконто2.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовхарактеристик.ВидыСубконто.ЦМО))
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто3
		|		ПО ВТОстаткиСчет.Счет = ЕПСБУВидыСубконто3.Ссылка
		|			И (ЕПСБУВидыСубконто3.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовхарактеристик.ВидыСубконто.Контрагенты))
		|ГДЕ
		|	(НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
		|				И НЕ ЕПСБУВидыСубконто1.НомерСтроки ЕСТЬ NULL
		|			ИЛИ НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
		|				И НЕ ЕПСБУВидыСубконто2.НомерСтроки ЕСТЬ NULL
		|			ИЛИ НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
		|				И НЕ ЕПСБУВидыСубконто3.НомерСтроки ЕСТЬ NULL)
		|			И НЕ(НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
		|					И НЕ ЕПСБУВидыСубконто1.НомерСтроки ЕСТЬ NULL
		|					И НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
		|					И НЕ ЕПСБУВидыСубконто2.НомерСтроки ЕСТЬ NULL
		|					И НЕ ЕПСБУВидыСубконто.НомерСтроки ЕСТЬ NULL
		|					И НЕ ЕПСБУВидыСубконто3.НомерСтроки ЕСТЬ NULL)";
	
	Запрос.УстановитьПараметр("ПараметрДатаОстатки", ?(ИмяОстатки = "Начало", ПараметрыВыполнения.НачалоПериода, 
	Новый Граница(КонецДня(ПараметрыВыполнения.ОкончаниеПериода), ВидГраницы.Включая)));
	
	ВыборкаРазрез = Запрос.Выполнить().Выбрать();
		
	МассивСрезСубконто = Новый Массив;

	Пока ВыборкаРазрез.Следующий() Цикл 
		СтрокаМассив = Новый Структура("ЕстьЦМО, ЕстьДоговоры, ЕстьКонтрагенты");
		ЗаполнитьЗначенияСвойств(СтрокаМассив, ВыборкаРазрез);
		МассивСрезСубконто.Добавить(СтрокаМассив);
		ШаблонВТ = Остатки_ПолучитьШаблонВТСтоимостьОбъектовОС(СтрокаМассив.ЕстьЦМО, СтрокаМассив.ЕстьДоговоры, СтрокаМассив.ЕстьКонтрагенты);
		ИмяВТ = "Есть" + ?(СтрокаМассив.ЕстьЦМО, "ЦМО", "") + ?(СтрокаМассив.ЕстьДоговоры, "Дог", "") + ?(СтрокаМассив.ЕстьКонтрагенты, "Кон", "");
		ШаблонВТ = СтрЗаменить(ШаблонВТ, "%ИмяВТСтоимостьОС", ИмяВТ);
		Если ПерваяИтерация Тогда
			ТекстЗапроса = ШаблонВТ + "
			|;
			|";
			ПерваяИтерация = Ложь;
		Иначе
			ТекстЗапроса = ТекстЗапроса + "
			|////////////////////////////////////////////////////////////////////////////////
			|" + ШаблонВТ + "
			|;
			|";		
		КонецЕсли;	
	КонецЦикла;
	ПараметрыВыполнения.Вставить("МассивСрезСубконто_" + ИмяОстатки, МассивСрезСубконто);
	Возврат ТекстЗапроса;
	
КонецФункции 

Функция Остатки_ПолучитьШаблонВТСтоимостьОбъектовОС(ЕстьЦМО, ЕстьДоговоры, ЕстьКонтрагенты) 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер," + ?(ЕстьЦМО, "
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,", "") + ?(ЕстьДоговоры, "
	|	СтоимостьОбъектовОСОстатки.Договор КАК Договор,", "") + "
	|	СУММА(СтоимостьОбъектовОСОстатки.СтоимостьОстаток) КАК СтоимостьОстаток,
	|	СУММА(СтоимостьОбъектовОСОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	|	СтоимостьОбъектовОСОстатки.Забаланс КАК Забаланс," + ?(ЕстьКонтрагенты, "
	|	СтоимостьОбъектовОСОстатки.Контрагент КАК Контрагент,", "") + "
	|	СтоимостьОбъектовОСОстатки.Амортизация КАК Амортизация,
	|	СтоимостьОбъектовОСОстатки.Обесценение КАК Обесценение,
	|	СтоимостьОбъектовОСОстатки.Счет КАК Счет,
	|	СтоимостьОбъектовОСОстатки.ГрупповойУчет КАК ГрупповойУчет
	|ПОМЕСТИТЬ ВТОстаткиОС_%ИмяОстатки_%ИмяВТСтоимостьОС
	|ИЗ
	|	ВТОстаткиОС_%ИмяОстатки_ЕстьЦМОДогКон КАК СтоимостьОбъектовОСОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОбъектовОСОстатки.Обесценение," + ?(ЕстьЦМО, "
	|	СтоимостьОбъектовОСОстатки.ЦМО,", "") + ?(ЕстьДоговоры, "
	|	СтоимостьОбъектовОСОстатки.Договор,", "") + ?(ЕстьКонтрагенты, "
	|	СтоимостьОбъектовОСОстатки.Контрагент,", "") + "
	|	СтоимостьОбъектовОСОстатки.Счет,
	|	СтоимостьОбъектовОСОстатки.ГрупповойУчет,
	|	СтоимостьОбъектовОСОстатки.Забаланс,
	|	СтоимостьОбъектовОСОстатки.Амортизация,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство";	
		  
	Возврат ТекстЗапроса;
	
КонецФункции	

Функция Остатки_ПолучитьПолеВыбораВТСтоимостьОбъектовОС(ОсновноеПоле, ВспомогательноеПоле, ПараметрыВыполнения)

	ИмяОстатки = ПараметрыВыполнения.ИмяОстатки;
	ТекстПоляВыбора = "ВЫБОР
	|					КОГДА ВТОстатки%ИмяОстатки_С_ОС.Амортизация ИЛИ ВТОстатки%ИмяОстатки_С_ОС.Обесценение ТОГДА" + 
	?(ОсновноеПоле = "ИнвентарныйНомер", "
	|						ВЫБОР КОГДА ВТОстаткиОС_%ИмяОстатки_АмортОбесц.%ОсновноеПоле ЕСТЬ NULL 
	|							ИЛИ ВТОстаткиОС_%ИмяОстатки_АмортОбесц.%ОсновноеПоле = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) ТОГДА
	|								ВТОстатки%ИмяОстатки_С_ОС.%ВспомогательноеПоле
	|						ИНАЧЕ ВТОстаткиОС_%ИмяОстатки_АмортОбесц.%ОсновноеПоле КОНЕЦ", "
	|						ЕСТЬNULL(ВТОстаткиОС_%ИмяОстатки_АмортОбесц.%ОсновноеПоле, ВТОстатки%ИмяОстатки_С_ОС.%ВспомогательноеПоле)") + "
	|					КОГДА НЕ ВТОстатки%ИмяОстатки_С_ОС.ЕстьЦМО И НЕ ВТОстатки%ИмяОстатки_С_ОС.ЕстьДоговоры И НЕ ВТОстатки%ИмяОстатки_С_ОС.ЕстьКонтрагенты ТОГДА" + 
	?(ОсновноеПоле = "ИнвентарныйНомер", "
	|						ВЫБОР КОГДА ВТОстаткиОС_%ИмяОстатки_НетЦМОДогКон.%ОсновноеПоле ЕСТЬ NULL 
	|							ИЛИ ВТОстаткиОС_%ИмяОстатки_НетЦМОДогКон.%ОсновноеПоле = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) ТОГДА
	|								ВТОстатки%ИмяОстатки_С_ОС.%ВспомогательноеПоле
	|						ИНАЧЕ ВТОстаткиОС_%ИмяОстатки_НетЦМОДогКон.%ОсновноеПоле КОНЕЦ", "
	|						ЕСТЬNULL(ВТОстаткиОС_%ИмяОстатки_НетЦМОДогКон.%ОсновноеПоле, ВТОстатки%ИмяОстатки_С_ОС.%ВспомогательноеПоле)");
	Для каждого СтрокаМассива Из ПараметрыВыполнения["МассивСрезСубконто_" + ИмяОстатки] Цикл
		ИмяВТ = "Есть" + ?(СтрокаМассива.ЕстьЦМО, "ЦМО", "") + ?(СтрокаМассива.ЕстьДоговоры, "Дог", "") + ?(СтрокаМассива.ЕстьКонтрагенты, "Кон", ""); 
		ТекстПоляВыбора = ТекстПоляВыбора + "
		|					КОГДА " + ?(СтрокаМассива.ЕстьЦМО, "", "НЕ ") + "ВТОстатки%ИмяОстатки_С_ОС.ЕстьЦМО И " + ?(СтрокаМассива.ЕстьДоговоры, "", "НЕ ") + "ВТОстатки%ИмяОстатки_С_ОС.ЕстьДоговоры И " + ?(СтрокаМассива.ЕстьКонтрагенты, "", "НЕ ") + "ВТОстатки%ИмяОстатки_С_ОС.ЕстьКонтрагенты ТОГДА" + 
		?(ОсновноеПоле = "ИнвентарныйНомер", "
		|						ВЫБОР КОГДА ВТОстаткиОС_%ИмяОстатки_" + ИмяВТ + ".%ОсновноеПоле ЕСТЬ NULL 
		|							ИЛИ ВТОстаткиОС_%ИмяОстатки_" + ИмяВТ + ".%ОсновноеПоле = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) ТОГДА
		|								ВТОстатки%ИмяОстатки_С_ОС.%ВспомогательноеПоле
		|						ИНАЧЕ ВТОстаткиОС_%ИмяОстатки_" + ИмяВТ + ".%ОсновноеПоле КОНЕЦ", "
		|						ЕСТЬNULL(ВТОстаткиОС_%ИмяОстатки_" + ИмяВТ + ".%ОсновноеПоле, ВТОстатки%ИмяОстатки_С_ОС.%ВспомогательноеПоле)");
	КонецЦикла;		
	ТекстПоляВыбора = ТекстПоляВыбора + "
	|					КОНЕЦ";
	ТекстПоляВыбора = СтрЗаменить(ТекстПоляВыбора, "%ОсновноеПоле", ОсновноеПоле);
	ТекстПоляВыбора = СтрЗаменить(ТекстПоляВыбора, "%ВспомогательноеПоле", ВспомогательноеПоле);
	Возврат ТекстПоляВыбора;
	
КонецФункции  

Функция Остатки_ПолучитьСоединенияВТСтоимостьОбъектовОС(ПараметрыВыполнения)
	
	ИмяОстатки = ПараметрыВыполнения.ИмяОстатки;
	БазовыеУсловияСоединения = "(НЕ ВТОстатки%ИмяОстатки_С_ОС.Счет В ИЕРАРХИИ (&СчетаИсключенияОС))
	|			И ВТОстатки%ИмяОстатки_С_ОС.Счет.Забалансовый = ВТОстаткиОС_%ИмяОстатки_%ИмяВТ.Забаланс
	|			И ВТОстатки%ИмяОстатки_С_ОС.Амортизация = ВТОстаткиОС_%ИмяОстатки_%ИмяВТ.Амортизация
	|			И ВТОстатки%ИмяОстатки_С_ОС.Обесценение = ВТОстаткиОС_%ИмяОстатки_%ИмяВТ.Обесценение
	|			И ВТОстатки%ИмяОстатки_С_ОС.ОС = ВТОстаткиОС_%ИмяОстатки_%ИмяВТ.ОсновноеСредство
	|			И ВТОстатки%ИмяОстатки_С_ОС.КодВерхнегоУровня = ВТОстаткиОС_%ИмяОстатки_%ИмяВТ.Счет";
	
	ТекстСоединения = "ЛЕВОЕ СОЕДИНЕНИЕ ВТОстаткиОС_%ИмяОстатки_АмортОбесц КАК ВТОстаткиОС_%ИмяОстатки_АмортОбесц
	|		ПО " + СтрЗаменить(БазовыеУсловияСоединения, "%ИмяВТ", "АмортОбесц") + "
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстаткиОС_%ИмяОстатки_НетЦМОДогКон КАК ВТОстаткиОС_%ИмяОстатки_НетЦМОДогКон
	|		ПО " + СтрЗаменить(БазовыеУсловияСоединения, "%ИмяВТ", "НетЦМОДогКон") + "
	|			И (НЕ ВТОстатки%ИмяОстатки_С_ОС.ЕстьЦМО И НЕ ВТОстатки%ИмяОстатки_С_ОС.ЕстьДоговоры И НЕ ВТОстатки%ИмяОстатки_С_ОС.ЕстьКонтрагенты)";
	Для каждого СтрокаМассива Из ПараметрыВыполнения["МассивСрезСубконто_" + ИмяОстатки] Цикл
		ИмяВТ = "Есть" + ?(СтрокаМассива.ЕстьЦМО, "ЦМО", "") + ?(СтрокаМассива.ЕстьДоговоры, "Дог", "") + ?(СтрокаМассива.ЕстьКонтрагенты, "Кон", ""); 
		ТекстСоединения = ТекстСоединения + "
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстаткиОС_%ИмяОстатки_" + ИмяВТ + " КАК ВТОстаткиОС_%ИмяОстатки_" + ИмяВТ + "
		|		ПО " + СтрЗаменить(БазовыеУсловияСоединения, "%ИмяВТ", ИмяВТ) + "
		|			И (" 
		+ ?(СтрокаМассива.ЕстьЦМО, "ВТОстатки%ИмяОстатки_С_ОС.ЦМО = ВТОстаткиОС_%ИмяОстатки_" + ИмяВТ + ".ЦМО И ", "НЕ ") + "ВТОстатки%ИмяОстатки_С_ОС.ЕстьЦМО И " 
		+ ?(СтрокаМассива.ЕстьДоговоры, "ВТОстатки%ИмяОстатки_С_ОС.Договор = ВТОстаткиОС_%ИмяОстатки_" + ИмяВТ + ".Договор И ", "НЕ ") + "ВТОстатки%ИмяОстатки_С_ОС.ЕстьДоговоры И " 
		+ ?(СтрокаМассива.ЕстьКонтрагенты, "ВТОстатки%ИмяОстатки_С_ОС.Контрагент = ВТОстаткиОС_%ИмяОстатки_" + ИмяВТ + ".Контрагент И ", "НЕ ") + "ВТОстатки%ИмяОстатки_С_ОС.ЕстьКонтрагенты)"; 
	КонецЦикла;		
	Возврат ТекстСоединения;
	
КонецФункции

Функция Остатки_УничтожитьТаблицыСтоимостьОС(ПараметрыВыполнения) 
	
	ТекстЗапроса = "
	|УНИЧТОЖИТЬ ВТОстаткиОС_Начало_ЕстьЦМОДогКон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОстаткиОС_Начало_НетЦМОДогКон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОстаткиОС_Начало_АмортОбесц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОстаткиОС_Конец_ЕстьЦМОДогКон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОстаткиОС_Конец_НетЦМОДогКон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОстаткиОС_Конец_АмортОбесц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////"; 
	
	Для Итерация = 1 По 2 Цикл
		ИмяОстатки = ?(Итерация = 1, "Начало", "Конец");
		Для каждого СтрокаМассив ИЗ ПараметрыВыполнения["МассивСрезСубконто_" + ИмяОстатки] Цикл 
			ИмяВТ = "Есть" + ?(СтрокаМассив.ЕстьЦМО, "ЦМО", "") + ?(СтрокаМассив.ЕстьДоговоры, "Дог", "") + ?(СтрокаМассив.ЕстьКонтрагенты, "Кон", "");
			ТекстЗапроса = ТекстЗапроса + "
			|УНИЧТОЖИТЬ  ВТОстаткиОС_" + ИмяОстатки + "_" + ИмяВТ + "
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////";		
		КонецЦикла;

	КонецЦикла;

	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьТекстЗапросаОстатки(ИмяОстатки, ПараметрДатаОстаткиГраница, ПараметрДатаОстатки, ДополнительныеПараметры)
	
	ДополнительныеПараметры.ПараметрыВыполнения.Вставить("ИмяОстатки", ИмяОстатки);
	
	УсловиеСчета = "";
	Для каждого СтрокаСубконто Из ДополнительныеПараметры.ПараметрыВыполнения.СубконтоНаСчетах Цикл
		УсловиеСчета = УсловиеСчета + ?(УсловиеСчета = "", "", " И ") + "НЕ Счет В (&Счета_" + СтрокаСубконто.Идентификатор + ")";	
	КонецЦикла;	
	
	ТекстЗапроса =   	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КФО, Значение(Перечисление.КВД.ПустаяСсылка)) КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто1, ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка)) КАК Субконто1,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто2, ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка)) КАК Субконто2,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто3, ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка)) КАК Субконто3,
	|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, Значение(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.ИФО, Значение(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Валюта, Значение(Справочник.Валюты.ПустаяСсылка)) КАК Валюта
	|ПОМЕСТИТЬ ВТОстатки%ИмяОстатки_БезКЭК
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(%ПараметрДатаОстаткиГраница, " + УсловиеСчета + ", , ) КАК ЖурналПроводокЕПСБУОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОрганизацииФедеральногоБюджета КАК ВТОрганизацииФедеральногоБюджета
	|		ПО ЖурналПроводокЕПСБУОстатки.Организация = ВТОрганизацииФедеральногоБюджета.Организация 
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПланСчетов КАК ВТПланСчетов
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = ВТПланСчетов.Ссылка" +
	?(ДополнительныеПараметры.ПерезагружаемыеПериоды, "
	|ГДЕ
	|	ВТПланСчетов.Код В (&СчетаПерезагружаемыеПериоды)", "") + 
	ПолучитьТекстЗапросаОстаткиБезКЭК(ДополнительныеПараметры) + "
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет,
	|	Субконто1,
	|	Субконто2,
	|	Субконто3,
	|	Организация,
	|	КПС,
	|	ИФО,
	|	Валюта,
	|	КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КФО, ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)) КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто1, ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка)) КАК Субконто1,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто2, ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка)) КАК Субконто2,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто3, ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка)) КАК Субконто3,
	|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК Валюта, 
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК СуммаОстаток,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт КАК СуммаОстатокКт,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокКт КАК ВалютнаяСуммаОстатокКт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокКт КАК КоличествоОстатокКт
	|ПОМЕСТИТЬ ВТОстатки%ИмяОстатки_СКЭК
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(%ПараметрДатаОстаткиГраница, " + УсловиеСчета + ", , ) КАК ЖурналПроводокЕПСБУОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОрганизацииФедеральногоБюджета КАК ВТОрганизацииФедеральногоБюджета
	|		ПО ЖурналПроводокЕПСБУОстатки.Организация = ВТОрганизацииФедеральногоБюджета.Организация 
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПланСчетов КАК ВТПланСчетов
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = ВТПланСчетов.Ссылка" +
	?(ДополнительныеПараметры.ПерезагружаемыеПериоды, "
