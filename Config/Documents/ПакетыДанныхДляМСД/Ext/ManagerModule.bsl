Функция ПолучитьСрокИсполнения(СвойстваДоговоров, Выборка, ПараметрыВыполнения)
	
	СрокИсполнения = Дата(2999,12,31);						
	Если НЕ Выборка.ВестиГрафикПлатежей И НЕ Выборка.ВестиПланГрафикИсполнения Тогда
		Если ПараметрыВыполнения.ИспользуютсяИнтеграцииЭБ Тогда
    		МодульСбораДанныхПереопределяемый.ПолучитьДатуОкончанияДоговора(СвойстваДоговоров, Выборка.Договор, Выборка.СчетРасчетов, СрокИсполнения);
		Иначе
			МодульСбораДанных.ПолучитьДатуОкончанияДоговора(СвойстваДоговоров, Выборка.Договор, Выборка.СчетРасчетов, СрокИсполнения);
		КонецЕсли;	
	КонецЕсли;
	Возврат СрокИсполнения;
	
КонецФункции	
	
#Область ФормированиеТабличныхДокументов

Функция ОткрытьФайлПакета(ПутьКФайлу, Знач ИмяТега, ПространствоИмен)
	
	ИмяТега = ВРег(ИмяТега);
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ПутьКФайлу);
	
	ПространствоИмен = Чтение.ЗначениеАтрибута("xmlns");
	
	Пока НЕ (Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И ВРег(Чтение.Имя) = ИмяТега) Цикл
		Если НЕ Чтение.Прочитать() Тогда
			Прервать;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ПространствоИмен) Тогда
			ПространствоИмен = Чтение.ЗначениеАтрибута("xmlns");
		КонецЕсли;
	КонецЦикла;
	
	Если ПространствоИмен = Неопределено Тогда
		Файл = Новый Файл(ПутьКФайлу);
		ВызватьИсключение СтрШаблон("В файле %1 не найден атрибут ""xmlns""", Файл.Имя);
	КонецЕсли;
	
	Возврат Чтение;
	
КонецФункции

Функция РаспаковатьФайлАрхива(ИмяФайлаАрхива, ИмяФайлаДляСообщения)
	
	Файл = Новый Файл(ИмяФайлаАрхива);
	Если НЕ Файл.Существует() Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Файл %1 не существует", ИмяФайлаДляСообщения));
		Возврат Неопределено;
	КонецЕсли;
	
	РазделительПути = ПолучитьРазделительПути();
	
	ИмяБезРасширения = Файл.ИмяБезРасширения;
	
	ВременныйКаталог = КаталогВременныхФайлов() + ИмяБезРасширения + РазделительПути;
	
	Чтение = Новый ЧтениеZipФайла(ИмяФайлаАрхива);
	Чтение.ИзвлечьВсе(ВременныйКаталог);
	
	Файлы = Новый Структура;
	ФайлыЭП = Новый Структура;
	
	ЕстьДанные = Ложь;
	НайденныеФайлыДанных = НайтиФайлы(ВременныйКаталог, "*.xml");
	Если НайденныеФайлыДанных.Количество() Тогда
		ЕстьДанные = Истина;
		
		Для Каждого Файл Из НайденныеФайлыДанных Цикл
			Файлы.Вставить(Файл.ИмяБезРасширения, Файл.ПолноеИмя);
		КонецЦикла;
		
		НайденныеФайлыЭП = НайтиФайлы(ВременныйКаталог, "*.p7s");
		Для Каждого Файл Из НайденныеФайлыЭП Цикл
			ФайлыЭП.Вставить(Файл.ИмяБезРасширения, Файл.ПолноеИмя);
		КонецЦикла;
		
	Иначе
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Архив %1 не содержит xml файлов с данными", ИмяФайлаДляСообщения));
	КонецЕсли;
	
	Если ЕстьДанные Тогда
		Возврат Новый Структура("Файлы,ФайлыЭП,ВременныйКаталог", Файлы, ФайлыЭП, ВременныйКаталог);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТЗДанныеОстатков()
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Организация", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150)));
	ТЗ.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата")); 
	ТЗ.Колонки.Добавить("Счет", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(6)));
	ТЗ.Колонки.Добавить("КПС", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(17)));
	ТЗ.Колонки.Добавить("КФО", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(1)));
	ТЗ.Колонки.Добавить("КЭК", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(3))); 
	ТЗ.Колонки.Добавить("СуммаДт", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(18,2)));
	ТЗ.Колонки.Добавить("СуммаКт", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(18,2)));
	Возврат ТЗ;
	
КонецФункции

