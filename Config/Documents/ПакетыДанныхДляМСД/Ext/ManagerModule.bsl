Функция ПолучитьВТ_ЕПСБУВидыСубконто(ПараметрыВыполнения)
	
	ТаблицаВидыСубконто = Новый ТаблицаЗначений;
	ТаблицаВидыСубконто.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаВидыСубконто.Колонки.Добавить("ВидСубконто", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ТаблицаВидыСубконто.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	Для каждого СтрокаСубконто Из ПараметрыВыполнения.СубконтоНаСчетах Цикл
		Для каждого СтрокаСчет Из СтрокаСубконто.МассивСчетов Цикл
			НомерСтрокиСубконто = 1;
			Для каждого СтрокаСубконтоМассив Из СтрокаСубконто.МассивСубконто Цикл
				НоваяСтрока = ТаблицаВидыСубконто.Добавить();
				НоваяСтрока.Ссылка = СтрокаСчет;
				НоваяСтрока.НомерСтроки = НомерСтрокиСубконто; 
				НоваяСтрока.ВидСубконто = СтрокаСубконтоМассив; 
				НомерСтрокиСубконто = НомерСтрокиСубконто + 1;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ПараметрыВыполнения.Вставить("ВидыСубконтоТаблица", ТаблицаВидыСубконто);
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ВидыСубконтоТаблица.Ссылка КАК Ссылка,
	|	ВидыСубконтоТаблица.НомерСтроки КАК НомерСтроки,
	|	ВидыСубконтоТаблица.ВидСубконто КАК ВидСубконто
	|ПОМЕСТИТЬ ВТ_ВидыСубконтоТаблица
	|ИЗ
	|	&ВидыСубконтоТаблица КАК ВидыСубконтоТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУВидыСубконто.Ссылка КАК Ссылка,
	|	ЕПСБУВидыСубконто.НомерСтроки КАК НомерСтроки,
	|	ЕПСБУВидыСубконто.ВидСубконто КАК ВидСубконто
	|ПОМЕСТИТЬ ВТ_ЕПСБУВидыСубконто
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	НЕ ЕПСБУВидыСубконто.Ссылка В (&СчетаДляСубконто)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ВидыСубконтоТаблица.Ссылка,
	|	ВТ_ВидыСубконтоТаблица.НомерСтроки,
	|	ВТ_ВидыСубконтоТаблица.ВидСубконто
	|ИЗ
	|	ВТ_ВидыСубконтоТаблица КАК ВТ_ВидыСубконтоТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ВидыСубконтоТаблица
	|;";
	
	Возврат ТекстЗапроса;
	
КонецФункции	

Функция ПолучитьСубконтоНаСчетах(ПараметрыВыполнения)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУВидыСубконто.Ссылка КАК Ссылка,
		|	ЕПСБУВидыСубконто.ВидСубконто КАК Субконто1,
		|	NULL КАК Субконто2,
		|	NULL КАК Субконто3,
		|	ЕПСБУВидыСубконто.ВидСубконто КАК ВидСубконто
		|ПОМЕСТИТЬ ВТСубконтоПоСчетам
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
