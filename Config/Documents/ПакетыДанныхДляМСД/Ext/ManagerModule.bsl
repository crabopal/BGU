Функция ПолучитьМассивСчетовПерезагружаемые(ПараметрыВыполнения) 
	
	ЗапросСчетов = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиВыгрузкиАналитикМСД.Счет КАК Счет
	|ИЗ
	|	РегистрСведений.НастройкиВыгрузкиАналитикМСД КАК НастройкиВыгрузкиАналитикМСД
	|ГДЕ
	|	НастройкиВыгрузкиАналитикМСД.Версия = &Версия
	|	И НастройкиВыгрузкиАналитикМСД.Организация = &Организация
	|	И (НастройкиВыгрузкиАналитикМСД.ВОстатках1
	|				И НЕ НастройкиВыгрузкиАналитикМСД.ВОборотах1
	|			ИЛИ НастройкиВыгрузкиАналитикМСД.ВОстатках2
	|				И НЕ НастройкиВыгрузкиАналитикМСД.ВОборотах2
	|			ИЛИ НастройкиВыгрузкиАналитикМСД.ВОстатках3
	|				И НЕ НастройкиВыгрузкиАналитикМСД.ВОборотах3
	|			ИЛИ НастройкиВыгрузкиАналитикМСД.ВОстатках4
	|				И НЕ НастройкиВыгрузкиАналитикМСД.ВОборотах4
	|			ИЛИ НастройкиВыгрузкиАналитикМСД.ВОстатках5
	|				И НЕ НастройкиВыгрузкиАналитикМСД.ВОборотах5
	|			ИЛИ НастройкиВыгрузкиАналитикМСД.ВОстатках6
	|				И НЕ НастройкиВыгрузкиАналитикМСД.ВОборотах6)");
	ЗапросСчетов.УстановитьПараметр("Версия", ПараметрыВыполнения.ВерсияТаксономии);		
	ЗапросСчетов.УстановитьПараметр("Организация", ПараметрыВыполнения.Организация);	
	ВыборкаСчетов = ЗапросСчетов.Выполнить().Выгрузить();
	МассивСчетовПерезагружаемые = ОбщегоНазначения.ВыгрузитьКолонку(ВыборкаСчетов, "Счет", Истина);
	Возврат МассивСчетовПерезагружаемые;
	
КонецФункции

Функция ПолучитьТекстЗапросаТипКБК(ИмяТаблицы)
	
	ТекстЗапроса = "ВЫБОР
	|		КОГДА %1.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КДБ)
	|			ТОГДА ""1""
	|		КОГДА %1.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КРБ)
	|			ТОГДА ""2""
	|		КОГДА %1.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КИФ)
	|			ТОГДА ""3""
	|		КОГДА %1.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.гКБК)
	|			ТОГДА ""4""
	|		КОГДА %1.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.АУИБУ)
	|			ТОГДА ВЫБОР
	|				КОГДА %1.УточнениеПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КДБ)
	|					ТОГДА ""6""
	|				КОГДА %1.УточнениеПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КРБ)
	|					ТОГДА ""7""
	|				КОГДА %1.УточнениеПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КИФ)
	|					ТОГДА ""8""
	|				КОГДА %1.УточнениеПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.гКБК)
	|					ТОГДА ""9""
	|				ИНАЧЕ """"
	|			КОНЕЦ
	|		ИНАЧЕ """"
	|	КОНЕЦ";
	Возврат СтрШаблон(ТекстЗапроса, ИмяТаблицы);
	
КонецФункции	

Функция ПолучитьСтруктуруПерезагружаемыйПериод()
	
	СтруктураПериод = Новый Структура;
	СтруктураПериод.Вставить("ИмяВТ");
	СтруктураПериод.Вставить("ИмяПараметрДата");
	СтруктураПериод.Вставить("ОкончаниеПериода"); 
	СтруктураПериод.Вставить("ЭтоГраница");
	Возврат СтруктураПериод;
	
КонецФункции	

Функция ПолучитьТекстЗапросаАналитик(ПараметрыВыполнения)
	
	ЕстьПерезагружаемыеПериоды = Булево(ПараметрыВыполнения.ПерезагружаемыеПериоды.Количество());	
	
	Если ПараметрыВыполнения.ПакетныйРежимВыгрузки Тогда
		ШаблонУсловия = 	
		"ГДЕ
		|	%ИмяТаблицы.ВидСубконто%СуффиксВС В (&МассивВидовСубконто)
		|	И (%ИмяТаблицы.Аналитика%Суффикс1 В (&АналитикиСтрокой)
		|			ИЛИ %ИмяТаблицы.Аналитика%Суффикс2 В (&АналитикиСтрокой)
		|			ИЛИ %ИмяТаблицы.Аналитика%Суффикс3 В (&АналитикиСтрокой)
		|			ИЛИ %ИмяТаблицы.Аналитика%Суффикс4 В (&АналитикиСтрокой)
		|			ИЛИ %ИмяТаблицы.Аналитика%Суффикс5 В (&АналитикиСтрокой)
		|			ИЛИ %ИмяТаблицы.Аналитика%Суффикс6 В (&АналитикиСтрокой))";
	КонецЕсли;
	
	ТекстЗапроса = "";
	ИмяТаблицы = "ВТОбороты";
	ПолучитьПервый = Истина;
	
	Для ИтерацияСуффикс = 1 По 2 Цикл
		Суффикс = ?(ИтерацияСуффикс = 1, "Дт", "Кт");
		Для Итерация = 1 По 4 Цикл
			
			ШаблонИтерация = ПолучитьШаблонТекстаЗапросаАналитик(ПолучитьПервый);
			ПолучитьПервый = Ложь;
			ТекстЗапросаИтерация = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(ШаблонИтерация, "%СуффиксС", Суффикс + Итерация), "%СуффиксВС", Суффикс + Итерация), "%Суффикс", Суффикс), "%ИмяТаблицы", ИмяТаблицы);
			ТекстЗапроса = ТекстЗапроса + ТекстЗапросаИтерация  
			+ СтрЗаменить(СтрЗаменить(СтрЗаменить(ШаблонУсловия, "%СуффиксВС", Суффикс + Итерация), "%Суффикс", Суффикс), "%ИмяТаблицы", ИмяТаблицы) + "
			|
			|ОБЪЕДИНИТЬ ВСЕ";	
			
		КонецЦикла;
	КонецЦикла; 
	
	Для ИтерацияОстатки = 1 По 2 Цикл
		Если ИтерацияОстатки = 1 Тогда
			ИмяТаблицы = "ВТОстатки";	  
		Иначе
			Если ЕстьПерезагружаемыеПериоды Тогда
				ИмяТаблицы = "ВТОстаткиПерезагружаемые";
			Иначе 
				Прервать;	
			КонецЕсли;		  
		КонецЕсли;  
		
		Для Итерация = 1 По 4 Цикл
			
			ШаблонИтерация = ПолучитьШаблонТекстаЗапросаАналитик();
			ТекстЗапросаИтерация = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(ШаблонИтерация, "%СуффиксС", Строка(Итерация) + "1"), "%СуффиксВС", Строка(Итерация)), "%Суффикс", ""), "%ИмяТаблицы", ИмяТаблицы);
			ТекстЗапроса = ТекстЗапроса + ТекстЗапросаИтерация  
			+ СтрЗаменить(СтрЗаменить(СтрЗаменить(ШаблонУсловия, "%СуффиксВС", Строка(Итерация)), "%Суффикс", ""), "%ИмяТаблицы", ИмяТаблицы) 
			+ ?(?(ЕстьПерезагружаемыеПериоды, ИмяТаблицы = "ВТОстаткиПерезагружаемые", ИмяТаблицы = "ВТОстатки") И Итерация = 4, "
			|
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////","
			|
			|ОБЪЕДИНИТЬ ВСЕ");
			
		КонецЦикла; 
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТАналитикаОбщий.Аналитика КАК Аналитика,
	|	ВТАналитикаОбщий.ВидСубконто КАК ВидСубконто,
	|	ВТАналитикаОбщий.Аналитика1 КАК Аналитика1,
	|	ВТАналитикаОбщий.Аналитика2 КАК Аналитика2,
	|	ВТАналитикаОбщий.Аналитика3 КАК Аналитика3,
	|	ВТАналитикаОбщий.Аналитика4 КАК Аналитика4,
	|	ВТАналитикаОбщий.Аналитика5 КАК Аналитика5,
	|	ВТАналитикаОбщий.Аналитика6 КАК Аналитика6
	|ПОМЕСТИТЬ ВТАналитики
	|ИЗ
	|	ВТАналитикаРазвернутая КАК ВТАналитикаОбщий" + ?(ПараметрыВыполнения.ПакетныйРежимВыгрузки, "", "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТОстатки.Организация КАК Аналитика,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка) КАК ВидСубконто,
	|	"""" КАК Аналитика1,
	|	"""" КАК Аналитика2,
	|	"""" КАК Аналитика3,
	|	"""" КАК Аналитика4,
	|	"""" КАК Аналитика5,
	|	"""" КАК Аналитика6
	|ИЗ
	|	ВТОстаткиБезСубконто4 КАК ВТОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТОбороты.Организация,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка),
	|	"""" КАК Аналитика1,
	|	"""" КАК Аналитика2,
	|	"""" КАК Аналитика3,
	|	"""" КАК Аналитика4,
	|	"""" КАК Аналитика5,
	|	"""" КАК Аналитика6
	|ИЗ
	|	ВТОборотыБезСубконто4 КАК ВТОбороты") + " 
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТАналитикаРазвернутая
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьШаблонТекстаЗапросаАналитик(Первый = Ложь)
	
	ШаблонТекстЗапроса = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	%ИмяТаблицы.Субконто%СуффиксС" 		+ ?(Первый, " КАК Аналитика", "") + ",
	|	%ИмяТаблицы.ВидСубконто%СуффиксВС" 	+ ?(Первый, " КАК ВидСубконто", "") + ",
	|	%ИмяТаблицы.Аналитика%Суффикс1" 	+ ?(Первый, " КАК Аналитика1", "") + ",
	|	%ИмяТаблицы.Аналитика%Суффикс2" 	+ ?(Первый, " КАК Аналитика2", "") + ",
	|	%ИмяТаблицы.Аналитика%Суффикс3" 	+ ?(Первый, " КАК Аналитика3", "") + ",
	|	%ИмяТаблицы.Аналитика%Суффикс4" 	+ ?(Первый, " КАК Аналитика4", "") + ",
	|	%ИмяТаблицы.Аналитика%Суффикс5" 	+ ?(Первый, " КАК Аналитика5", "") + ",
	|	%ИмяТаблицы.Аналитика%Суффикс6" 	+ ?(Первый, " КАК Аналитика6", "") 
	+ ?(Первый, "
	|ПОМЕСТИТЬ ВТАналитикаРазвернутая", "") + "
	|ИЗ
	|	%ИмяТаблицы КАК %ИмяТаблицы
	|";
	Возврат ШаблонТекстЗапроса;
	
КонецФункции	

Функция ИспользоватьСхемуВыгрузки2026(Дата) 
	Возврат КонецДня(Дата) >= Дата(2025,12,31,23,59,59);	
КонецФункции

Функция ЗаполнитьОбластьПересчетОстатков(ОбластьСтрока, Выборка, ИмяПоля = "", ПерваяИтерация = Ложь)
	
	Если ПерваяИтерация Тогда
		ОбластьСтрока.Параметры[ИмяПоля] = Выборка[ИмяПоля];	
	Иначе
		ОбластьСтрока.Параметры[ИмяПоля + "СальдоНаКонецДт"]  = Выборка.СуммаДт;
		ОбластьСтрока.Параметры[ИмяПоля + "СальдоНаКонецКт"]  = Выборка.СуммаКт;
	КонецЕсли;
	
КонецФункции   

Процедура ЗаполнитьXDTOПоТаблице_Остатки(ТаблицаДанных, ЗаписьXML, ПараметрыВыполнения)
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Запрос остатков - выполнено, начало записи в файл'"));
	
	ВсегоЗаписей = ТаблицаДанных.Количество();
	Если ВсегоЗаписей > 0 Тогда
		Для Сч = 1 По ВсегоЗаписей Цикл
			Выборка = ТаблицаДанных[0];	
			ОбъектDataBalance = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "DataBalanceRecord"));
			ОбъектDataBalance.ORGANIZATION = Выборка.ORGANIZATION;
			ОбъектDataBalance.Date = Выборка.Date;
			ОбъектDataBalance.Account = Выборка.Account;
			ОбъектDataBalance.KFO = Выборка.KFO;
			ОбъектDataBalance.KBK = Выборка.KBK;     
			Если ЗначениеЗаполнено(Выборка.TypeKBK) Тогда
				ОбъектDataBalance.TypeKBK = Выборка.TypeKBK;
			КонецЕсли;		
			ОбъектDataBalance.KOSGU = Выборка.KOSGU; 
			
			Если ЗначениеЗаполнено(Выборка.Аналитика1) Тогда
				Analytics_1 = "";
				Если Выборка.Аналитика1 = "TOVAR_ROZN" Тогда
					Если Выборка.СубСчет = "105.2В" ИЛИ Выборка.СубСчет = "105.3В" Тогда
						Analytics_1 = "0";
					Иначе
						Analytics_1 = "1";
					КонецЕсли;	
				Иначе 
					Если НЕ ТаблицаДанных.Колонки.Найти("Значение_" + Выборка.Аналитика1) = Неопределено Тогда
						Analytics_1 = Выборка["Значение_" + Выборка.Аналитика1];
					КонецЕсли;
				КонецЕсли;
				ОбъектDataBalance.Analytics_1 = Analytics_1;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.Аналитика2) Тогда
				Analytics_2 = "";
				Если Выборка.Аналитика2 = "VID_RASCH_PROCH_KR" Тогда
					Analytics_2 = "2";	
				Иначе
					Если НЕ ТаблицаДанных.Колонки.Найти("Значение_" + Выборка.Аналитика2) = Неопределено Тогда
						Analytics_2 = Выборка["Значение_" + Выборка.Аналитика2]; 
					КонецЕсли;
				КонецЕсли; 
				ОбъектDataBalance.Analytics_2 = Analytics_2;  
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.Аналитика3) Тогда
				Analytics_3 = "";
				Если Выборка.Аналитика3 = "VID_UCHETA" Тогда
					Если Выборка.СубСчет = "07.1" Тогда
						Analytics_3 = "1";
					Иначе
						Analytics_3 = "2";
					КонецЕсли;	
				Иначе
					Если НЕ ТаблицаДанных.Колонки.Найти("Значение_" + Выборка.Аналитика3) = Неопределено Тогда
						Analytics_3 = Выборка["Значение_" + Выборка.Аналитика3];
					КонецЕсли;
				КонецЕсли;
				ОбъектDataBalance.Analytics_3 = Analytics_3; 
			КонецЕсли;
			
			Если НЕ ТаблицаДанных.Колонки.Найти("Значение_" + Выборка.Аналитика4) = Неопределено Тогда
				ОбъектDataBalance.Analytics_4 = Выборка["Значение_" + Выборка.Аналитика4]; 
			КонецЕсли;
			Если НЕ ТаблицаДанных.Колонки.Найти("Значение_" + Выборка.Аналитика5) = Неопределено Тогда
				ОбъектDataBalance.Analytics_5 = Выборка["Значение_" + Выборка.Аналитика5]; 
			КонецЕсли;
			Если НЕ ТаблицаДанных.Колонки.Найти("Значение_" + Выборка.Аналитика6) = Неопределено Тогда
				ОбъектDataBalance.Analytics_6 = Выборка["Значение_" + Выборка.Аналитика6];
			КонецЕсли;
			ОбъектDataBalance.Summa_Dt = Выборка.Summa_Dt;
			ОбъектDataBalance.Summa_Kt = Выборка.Summa_Kt;
			ОбъектDataBalance.Kol_Dt = ОбработатьКоличествоXDTO(Выборка.Kol_Dt); 
			ОбъектDataBalance.Kol_Kt = ОбработатьКоличествоXDTO(Выборка.Kol_Kt);
			ОбъектDataBalance.Val = Выборка.Val;
			ОбъектDataBalance.ValSumma_Dt = Выборка.ValSumma_Dt;
			ОбъектDataBalance.ValSumma_Kt = Выборка.ValSumma_Kt; 
			
			ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектDataBalance); 
			ТаблицаДанных.Удалить(Выборка);
		КонецЦикла;	
	КонецЕсли;
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Запрос остатков - данные записаны'"));
	
КонецПроцедуры		

Функция ОбработатьКоличествоXDTO(КоличествоЗначение) 
	
	МассивКоличество = СтрРазделить(Формат(КоличествоЗначение, "ЧГ="), ",");
	Количество = "";
	ПерваяИтерация = Истина;
	Для каждого ЭлементКоличество Из МассивКоличество Цикл
		Количество = Количество + ?(ПерваяИтерация, Лев(ЭлементКоличество, 15), "," + Лев(ЭлементКоличество, 3));
		ПерваяИтерация = Ложь;
	КонецЦикла;	
	Если ЗначениеЗаполнено(Количество) Тогда
		КоличествоИтог = Число(Количество);  
	Иначе
		КоличествоИтог = КоличествоЗначение;
	КонецЕсли;	
	Возврат КоличествоИтог; 
				
КонецФункции	

Процедура ЗаписатьШапкуНачалаЭлемента(ЗаписьXML, ПространствоИменПакет)
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();		
	ЗаписьXML.ЗаписатьНачалоЭлемента("Body");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("", ПространствоИменПакет);
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xs", "http://www.w3.org/2001/XMLSchema");
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");		

КонецПроцедуры	

Процедура ЗаполнитьТабДокПересчетОстатков(Набор, МакетПересчетОстатков, ТабДокПересчетОстатков)
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВТОстатки.Организация КАК Организация,
	|	ВТОстатки.Период КАК Период,
	|	ВТОстатки.Счет КАК Счет,
	|	ВТОстатки.КПС КАК КПС,
	|	ВТОстатки.КФО КАК КФО,
	|	ВТОстатки.КЭК КАК КЭК,
	|	ВТОстатки.СуммаДт КАК СуммаДт,
	|	ВТОстатки.СуммаКт КАК СуммаКт
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&Набор КАК ВТОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	Счет,
	|	КПС,
	|	КФО");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Набор", Набор);
	Запрос.Выполнить();
	
	ТекстЗапросаГруппировка =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ.Период КАК Период
	|ИЗ
	|	ВТ КАК ВТ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	ЗапросГруппировка = Новый Запрос(ТекстЗапросаГруппировка);
	ЗапросГруппировка.МенеджерВременныхТаблиц = МенеджерВТ;
	РезультатЗапросаГруппировка = ЗапросГруппировка.Выполнить();
	ВыборкаДата = РезультатЗапросаГруппировка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ОбластьШапка = МакетПересчетОстатков.ПолучитьОбласть("Шапка|КолонкаШапка");
	ТабДокПересчетОстатков.Присоединить(ОбластьШапка);
	
	ПорядокДат = Новый Массив;
	
	Пока ВыборкаДата.Следующий() Цикл 				
		ОбластьШапка = МакетПересчетОстатков.ПолучитьОбласть("Шапка|КолонкаСальдо"); 
		ОбластьШапка.Параметры.ДатаСальдо = Формат(ВыборкаДата.Период, "ДЛФ=Д");
		ТабДокПересчетОстатков.Присоединить(ОбластьШапка);
		ПорядокДат.Добавить(ВыборкаДата.Период);
	КонецЦикла; 
	
	ТекстЗапросаОрганизация =
	"ВЫБРАТЬ
	|	ВТ.Организация КАК Организация,
	|	ВТ.Период КАК Период,
	|	ВТ.СуммаДт КАК СуммаДт,
	|	ВТ.СуммаКт КАК СуммаКт
	|ИЗ
	|	ВТ КАК ВТ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация,
	|	Период
	|ИТОГИ
	|	СУММА(СуммаДт),
	|	СУММА(СуммаКт)
	|ПО
	|	Организация,
	|	Период";
	
	ЗапросГруппировка = Новый Запрос(ТекстЗапросаОрганизация);
	ЗапросГруппировка.МенеджерВременныхТаблиц = МенеджерВТ;
	РезультатЗапросаГруппировка = ЗапросГруппировка.Выполнить();
	
	ВыборкаОрганизация = РезультатЗапросаГруппировка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОрганизация.Следующий() Цикл 			
		ЗаполнитьСтрокуОбласти(ВыборкаОрганизация, "Организация", ТабДокПересчетОстатков, МакетПересчетОстатков, ПорядокДат);
		
		ТекстЗапросаСчет =
		"ВЫБРАТЬ
		|	ВТ.Счет КАК Счет,
		|	ВТ.Период КАК Период,
		|	ВТ.СуммаДт КАК СуммаДт,
		|	ВТ.СуммаКт КАК СуммаКт
		|ИЗ
		|	ВТ КАК ВТ
		|ГДЕ
		|	ВТ.Организация = &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	Счет,
		|	Период
		|ИТОГИ
		|	СУММА(СуммаДт),
		|	СУММА(СуммаКт)
		|ПО
		|	Счет,
		|	Период"; 
		
		ЗапросСчет = Новый Запрос(ТекстЗапросаСчет);
		ЗапросСчет.МенеджерВременныхТаблиц = МенеджерВТ;
		ЗапросСчет.УстановитьПараметр("Организация", ВыборкаОрганизация.Организация); 
		РезультатЗапросаСчет = ЗапросСчет.Выполнить();
		
		ВыборкаСчет = РезультатЗапросаСчет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСчет.Следующий() Цикл 
			ЗаполнитьСтрокуОбласти(ВыборкаСчет, "Счет", ТабДокПересчетОстатков, МакетПересчетОстатков, ПорядокДат);				
			ТекстЗапросаКПС =
			"ВЫБРАТЬ
			|	ВТ.КПС КАК КПС,
			|	ВТ.Период КАК Период,
			|	ВТ.СуммаДт КАК СуммаДт,
			|	ВТ.СуммаКт КАК СуммаКт
			|ИЗ
			|	ВТ КАК ВТ
			|ГДЕ
			|	ВТ.Организация = &Организация
			|	И ВТ.Счет = &Счет
			|
			|УПОРЯДОЧИТЬ ПО
			|	КПС,
			|	Период
			|ИТОГИ
			|	СУММА(СуммаДт),
			|	СУММА(СуммаКт)
			|ПО
			|	КПС,
			|	Период"; 
			
			ЗапросКПС = Новый Запрос(ТекстЗапросаКПС);
			ЗапросКПС.МенеджерВременныхТаблиц = МенеджерВТ;
			ЗапросКПС.УстановитьПараметр("Организация", ВыборкаОрганизация.Организация); 
			ЗапросКПС.УстановитьПараметр("Счет", ВыборкаСчет.Счет); 
			РезультатЗапросаКПС = ЗапросКПС.Выполнить();
			
			ВыборкаКПС = РезультатЗапросаКПС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаКПС.Следующий() Цикл 
				ЗаполнитьСтрокуОбласти(ВыборкаКПС, "КПС", ТабДокПересчетОстатков, МакетПересчетОстатков, ПорядокДат);	
				
				ТекстЗапросаКФО =
				"ВЫБРАТЬ
				|	ВТ.КФО КАК КФО,
				|	ВТ.Период КАК Период,
				|	ВТ.СуммаДт КАК СуммаДт,
				|	ВТ.СуммаКт КАК СуммаКт
				|ИЗ
				|	ВТ КАК ВТ
				|ГДЕ
				|	ВТ.Организация = &Организация
				|	И ВТ.Счет = &Счет 
				|	И ВТ.КПС = &КПС
				|
				|УПОРЯДОЧИТЬ ПО
				|	КФО,
				|	Период
				|ИТОГИ
				|	СУММА(СуммаДт),
				|	СУММА(СуммаКт)
				|ПО
				|	КФО,
				|	Период"; 
				
				ЗапросКФО = Новый Запрос(ТекстЗапросаКФО);
				ЗапросКФО.МенеджерВременныхТаблиц = МенеджерВТ;
				ЗапросКФО.УстановитьПараметр("Организация", ВыборкаОрганизация.Организация); 
				ЗапросКФО.УстановитьПараметр("Счет", ВыборкаСчет.Счет);
				ЗапросКФО.УстановитьПараметр("КПС", ВыборкаКПС.КПС);
				РезультатЗапросаКФО = ЗапросКФО.Выполнить();
				
				ВыборкаКФО = РезультатЗапросаКФО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаКФО.Следующий() Цикл 
					ЗаполнитьСтрокуОбласти(ВыборкаКФО, "КФО", ТабДокПересчетОстатков, МакетПересчетОстатков, ПорядокДат);
					
					ТекстЗапросаКЭК =
					"ВЫБРАТЬ
					|	ВТ.КЭК КАК КЭК,
					|	ВТ.Период КАК Период,
					|	ВТ.СуммаДт КАК СуммаДт,
					|	ВТ.СуммаКт КАК СуммаКт
					|ИЗ
					|	ВТ КАК ВТ
					|ГДЕ
					|	ВТ.Организация = &Организация
					|	И ВТ.Счет = &Счет 
					|	И ВТ.КПС = &КПС
					|	И ВТ.КФО = &КФО
					|
					|УПОРЯДОЧИТЬ ПО
					|	КЭК,
					|	Период
					|ИТОГИ
					|	СУММА(СуммаДт),
					|	СУММА(СуммаКт)
					|ПО
					|	КЭК,
					|	Период"; 
					
					ЗапросКЭК = Новый Запрос(ТекстЗапросаКЭК);
					ЗапросКЭК.МенеджерВременныхТаблиц = МенеджерВТ;
					ЗапросКЭК.УстановитьПараметр("Организация", ВыборкаОрганизация.Организация); 
					ЗапросКЭК.УстановитьПараметр("Счет", ВыборкаСчет.Счет);
					ЗапросКЭК.УстановитьПараметр("КПС", ВыборкаКПС.КПС); 
					ЗапросКЭК.УстановитьПараметр("КФО", ВыборкаКФО.КФО);
					
					РезультатЗапросаКЭК = ЗапросКЭК.Выполнить();
					
					ВыборкаКЭК = РезультатЗапросаКЭК.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаКЭК.Следующий() Цикл 
						ЗаполнитьСтрокуОбласти(ВыборкаКЭК, "КЭК", ТабДокПересчетОстатков, МакетПересчетОстатков, ПорядокДат);
					КонецЦикла;	
					
					ТабДокПересчетОстатков.ЗакончитьГруппуСтрок(); 
				КонецЦикла; //ВыборкаКФО	
				ТабДокПересчетОстатков.ЗакончитьГруппуСтрок(); 	
			КонецЦикла; //ВыборкаКПС
			ТабДокПересчетОстатков.ЗакончитьГруппуСтрок(); 
		КонецЦикла; //ВыборкаСчет
		ТабДокПересчетОстатков.ЗакончитьГруппуСтрок();	
	КонецЦикла; //ВыборкаОрганизация
	
КонецПроцедуры	

Процедура ЗаполнитьТабДокОстаткиИОбороты(НаборОстатки, НаборОбороты, МакетОстаткиИОбороты, ТабДокОстаткиИОбороты, ОбъектДокумент)
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ЕПСБУ.Код КАК Код,
	                      |	ЕПСБУ.Забалансовый КАК Забалансовый
	                      |ПОМЕСТИТЬ ВТЕПСБУ
	                      |ИЗ
	                      |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТОстатки.Организация КАК Организация,
	                      |	ВТОстатки.Период КАК Период,
	                      |	ВТОстатки.Счет КАК Счет,
	                      |	ВТОстатки.КПС КАК КПС,
	                      |	ВТОстатки.КФО КАК КФО,
	                      |	ВТОстатки.КЭК КАК КЭК,
	                      |	ВТОстатки.СуммаДт КАК СуммаДт,
	                      |	ВТОстатки.СуммаКт КАК СуммаКт
	                      |ПОМЕСТИТЬ ВТОстатки
	                      |ИЗ
	                      |	&НаборОстатки КАК ВТОстатки
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТОбороты.Организация КАК Организация,
	                      |	ВТОбороты.Период КАК Период,
	                      |	ВТОбороты.Счет КАК Счет,
	                      |	ВТОбороты.КПС КАК КПС,
	                      |	ВТОбороты.КФО КАК КФО,
	                      |	ВТОбороты.КЭК КАК КЭК,
	                      |	ВТОбороты.СуммаДт КАК СуммаДт,
	                      |	ВТОбороты.СуммаКт КАК СуммаКт
	                      |ПОМЕСТИТЬ ВТОбороты
	                      |ИЗ
	                      |	&НаборОбороты КАК ВТОбороты
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВТОстатки.Организация КАК Организация,
	                      |	ВТОстатки.Счет КАК Счет,
	                      |	ВТОстатки.КПС КАК КПС,
	                      |	ВТОстатки.КФО КАК КФО,
	                      |	ВТОстатки.КЭК КАК КЭК,
	                      |	ВТОстатки.СуммаДт КАК СальдоНаНачалоДт,
	                      |	ВТОстатки.СуммаКт КАК СальдоНаНачалоКт,
	                      |	NULL КАК СальдоНаКонецДт,
	                      |	NULL КАК СальдоНаКонецКт,
	                      |	NULL КАК ОборотДт,
	                      |	NULL КАК ОборотКт,
	                      |	ВТЕПСБУ.Забалансовый КАК Забалансовый
	                      |ИЗ
	                      |	ВТОстатки КАК ВТОстатки
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ВТЕПСБУ КАК ВТЕПСБУ
	                      |		ПО ВТОстатки.Счет = ВТЕПСБУ.Код
	                      |ГДЕ
	                      |	ВТОстатки.Период = &НачалоПериода
	                      |	И НЕ ВТОстатки.Счет = """"
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ВТОстатки.Организация,
	                      |	ВТОстатки.Счет,
	                      |	ВТОстатки.КПС,
	                      |	ВТОстатки.КФО,
	                      |	ВТОстатки.КЭК,
	                      |	NULL,
	                      |	NULL,
	                      |	ВТОстатки.СуммаДт,
	                      |	ВТОстатки.СуммаКт,
	                      |	NULL,
	                      |	NULL,
	                      |	ВТЕПСБУ.Забалансовый
	                      |ИЗ
	                      |	ВТОстатки КАК ВТОстатки
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ВТЕПСБУ КАК ВТЕПСБУ
	                      |		ПО ВТОстатки.Счет = ВТЕПСБУ.Код
	                      |ГДЕ
	                      |	ВТОстатки.Период = &КонецПериода
	                      |	И НЕ ВТОстатки.Счет = """"
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ВТОбороты.Организация,
	                      |	ВТОбороты.Счет,
	                      |	ВТОбороты.КПС,
	                      |	ВТОбороты.КФО,
	                      |	ВТОбороты.КЭК,
	                      |	NULL,
	                      |	NULL,
	                      |	NULL,
	                      |	NULL,
	                      |	ВТОбороты.СуммаДт,
	                      |	ВТОбороты.СуммаКт,
	                      |	ВТЕПСБУ.Забалансовый
	                      |ИЗ
	                      |	ВТОбороты КАК ВТОбороты
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ ВТЕПСБУ КАК ВТЕПСБУ
	                      |		ПО ВТОбороты.Счет = ВТЕПСБУ.Код
	                      |ГДЕ
	                      |	НЕ ВТОбороты.Счет = """"
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Организация,
	                      |	Забалансовый,
	                      |	Счет,
	                      |	КПС,
	                      |	КФО,
	                      |	КЭК
	                      |ИТОГИ
	                      |	СУММА(СальдоНаНачалоДт),
	                      |	СУММА(СальдоНаНачалоКт),
	                      |	СУММА(СальдоНаКонецДт),
	                      |	СУММА(СальдоНаКонецКт),
	                      |	СУММА(ОборотДт),
	                      |	СУММА(ОборотКт)
	                      |ПО
	                      |	Организация,
	                      |	Забалансовый,
	                      |	Счет,
	                      |	КПС,
	                      |	КФО,
	                      |	КЭК");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("НаборОстатки", НаборОстатки);
	Запрос.УстановитьПараметр("НаборОбороты", НаборОбороты);  
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ОбъектДокумент.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", НачалоДня(ОбъектДокумент.ОкончаниеПериода));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ОбластьШапка = МакетОстаткиИОбороты.ПолучитьОбласть("Шапка");  
	ОбластьСтрокаОрганизация = МакетОстаткиИОбороты.ПолучитьОбласть("СтрокаОрганизация");
	ОбластьСтрокаЗабаланс = МакетОстаткиИОбороты.ПолучитьОбласть("СтрокаЗабаланс");
	ОбластьСтрокаСчет = МакетОстаткиИОбороты.ПолучитьОбласть("СтрокаСчет");
	ОбластьСтрокаКПС = МакетОстаткиИОбороты.ПолучитьОбласть("СтрокаКПС");
	ОбластьСтрокаКФО = МакетОстаткиИОбороты.ПолучитьОбласть("СтрокаКФО");
	ОбластьСтрокаКЭК = МакетОстаткиИОбороты.ПолучитьОбласть("СтрокаКЭК");
	ТабДокОстаткиИОбороты.Вывести(ОбластьШапка);  
	
	ВыборкаОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОрганизация.Следующий() Цикл 
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаОрганизация.Параметры, ВыборкаОрганизация);	
		ТабДокОстаткиИОбороты.Вывести(ОбластьСтрокаОрганизация);
		ТабДокОстаткиИОбороты.НачатьГруппуСтрок("Организация");
		
		ВыборкаЗабалансовый = ВыборкаОрганизация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаЗабалансовый.Следующий() Цикл 
			
			ЗаполнитьЗначенияСвойств(ОбластьСтрокаЗабаланс.Параметры, ВыборкаЗабалансовый);
			Если ВыборкаЗабалансовый.Забалансовый = Истина Тогда
				ОбластьСтрокаЗабаланс.Параметры.Забалансовый = "Забалансовые счета";	
			Иначе
				ОбластьСтрокаЗабаланс.Параметры.Забалансовый = "Балансовые счета";
			КонецЕсли;	
			ТабДокОстаткиИОбороты.Вывести(ОбластьСтрокаЗабаланс);
			ТабДокОстаткиИОбороты.НачатьГруппуСтрок("Забаланс");
		
			ВыборкаСчет = ВыборкаЗабалансовый.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаСчет.Следующий() Цикл	
				ЗаполнитьЗначенияСвойств(ОбластьСтрокаСчет.Параметры, ВыборкаСчет);	
				ТабДокОстаткиИОбороты.Вывести(ОбластьСтрокаСчет);
				ТабДокОстаткиИОбороты.НачатьГруппуСтрок("Счет");
				
				ВыборкаКПС = ВыборкаСчет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаКПС.Следующий() Цикл 
					ЗаполнитьЗначенияСвойств(ОбластьСтрокаКПС.Параметры, ВыборкаКПС);	
					ТабДокОстаткиИОбороты.Вывести(ОбластьСтрокаКПС);
					ТабДокОстаткиИОбороты.НачатьГруппуСтрок("КПС");
					
					ВыборкаКФО = ВыборкаКПС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаКФО.Следующий() Цикл 
						ЗаполнитьЗначенияСвойств(ОбластьСтрокаКФО.Параметры, ВыборкаКФО);	
						ТабДокОстаткиИОбороты.Вывести(ОбластьСтрокаКФО);
						ТабДокОстаткиИОбороты.НачатьГруппуСтрок("КФО");
						
						ВыборкаКЭК = ВыборкаКФО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						Пока ВыборкаКЭК.Следующий() Цикл 
							ЗаполнитьЗначенияСвойств(ОбластьСтрокаКЭК.Параметры, ВыборкаКЭК);	
							ТабДокОстаткиИОбороты.Вывести(ОбластьСтрокаКЭК);
						КонецЦикла;	
						ТабДокОстаткиИОбороты.ЗакончитьГруппуСтрок();
					КонецЦикла;				
					ТабДокОстаткиИОбороты.ЗакончитьГруппуСтрок();
				КонецЦикла;				
				ТабДокОстаткиИОбороты.ЗакончитьГруппуСтрок();
			КонецЦикла;
			ТабДокОстаткиИОбороты.ЗакончитьГруппуСтрок();
		КонецЦикла;	
		ТабДокОстаткиИОбороты.ЗакончитьГруппуСтрок();
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуОбласти(ВыборкаГруппировка, ИмяПоля, ТабДокПересчетОстатков, МакетПересчетОстатков, ПорядокДат)
	
	Итерация = 0;
	ВыборкаДата = ВыборкаГруппировка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДата.Следующий() Цикл 				
		Если Итерация = 0 Тогда
			ОбластьИмяПоля = МакетПересчетОстатков.ПолучитьОбласть("Строка" + ИмяПоля + "|КолонкаШапка");
			ЗаполнитьОбластьПересчетОстатков(ОбластьИмяПоля, ВыборкаДата, ИмяПоля, Истина);
			ТабДокПересчетОстатков.Вывести(ОбластьИмяПоля);
			Если НЕ ИмяПоля = "КЭК" Тогда
				ТабДокПересчетОстатков.НачатьГруппуСтрок(ИмяПоля); 
			КонецЕсли;	
		КонецЕсли;
		
		ОбластьИмяПоля = МакетПересчетОстатков.ПолучитьОбласть("Строка" + ИмяПоля + "|КолонкаСальдо");				
		Пока НЕ ПорядокДат[Итерация] = ВыборкаДата.Период Цикл
			ТабДокПересчетОстатков.Присоединить(ОбластьИмяПоля);
			Итерация = Итерация + 1;
		КонецЦикла;	
		ЗаполнитьОбластьПересчетОстатков(ОбластьИмяПоля, ВыборкаДата, ИмяПоля);
		ТабДокПересчетОстатков.Присоединить(ОбластьИмяПоля);						
		Итерация = Итерация + 1;
	КонецЦикла;
	
КонецПроцедуры	

Функция ПроверитьДатыЗакрытияГода(ПараметрыВыполнения) 
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Организация
	|ПОМЕСТИТЬ ВТОрганизацииФедеральногоБюджета
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Бюджеты КАК Бюджеты
	|		ПО Организации.Бюджет = Бюджеты.Ссылка
	|ГДЕ
	|	Бюджеты.Код = ""00000001""
	|	И Организации.Ссылка = &Организация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Организации.Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Бюджеты КАК Бюджеты
	|		ПО Организации.Бюджет = Бюджеты.Ссылка
	|ГДЕ
	|	Бюджеты.Код = ""00000001""
	|	И Организации.УчетПереданныхПолномочий
	|	И Организации.ПолучательПолномочий = &Организация
	|	И НЕ Организации.Ссылка = &Организация
	|	И НЕ Организации.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗакрытиеСчетовСанкционирования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗакрытиеСчетовСанкционирования КАК ЗакрытиеСчетовСанкционирования
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОрганизацииФедеральногоБюджета КАК ВТОрганизацииФедеральногоБюджета
	|		ПО ЗакрытиеСчетовСанкционирования.Организация = ВТОрганизацииФедеральногоБюджета.Организация
	|ГДЕ
	|	ЗакрытиеСчетовСанкционирования.Проведен
	|	И ГОД(ЗакрытиеСчетовСанкционирования.ФинансовыйГод) = &ТекущийГод
	|	И ГОД(ЗакрытиеСчетовСанкционирования.Дата) = &ТекущийГод
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗакрытиеСчетовСанкционирования.Ссылка
	|ИЗ
	|	Документ.ЗакрытиеСчетовСанкционирования КАК ЗакрытиеСчетовСанкционирования
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОрганизацииФедеральногоБюджета КАК ВТОрганизацииФедеральногоБюджета
	|		ПО ЗакрытиеСчетовСанкционирования.Организация = ВТОрганизацииФедеральногоБюджета.Организация
	|ГДЕ
	|	ЗакрытиеСчетовСанкционирования.Проведен
	|	И ГОД(ЗакрытиеСчетовСанкционирования.ФинансовыйГод) = &ТекущийГод
	|	И ГОД(ЗакрытиеСчетовСанкционирования.Дата) = ГОД(&ДатаОкончания)
	|	И КОНЕЦПЕРИОДА(ЗакрытиеСчетовСанкционирования.Дата, ДЕНЬ) > КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)";
	
	Запрос.УстановитьПараметр("Организация", ПараметрыВыполнения.Организация);
	ОкончаниеПериода = ПараметрыВыполнения.ОкончаниеПериода;
	Запрос.УстановитьПараметр("ДатаОкончания", ОкончаниеПериода);
	Если КонецДня(ОкончаниеПериода) = КонецГода(ОкончаниеПериода) Тогда
		Запрос.УстановитьПараметр("ТекущийГод", Год(ОкончаниеПериода));
	Иначе
		Запрос.УстановитьПараметр("ТекущийГод", Год(ОкончаниеПериода)-1);	
	КонецЕсли;	
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();	
	МассивСсылок = Новый Массив;	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивСсылок.Добавить(ВыборкаДетальныеЗаписи.Ссылка);								
	КонецЦикла;
	Возврат МассивСсылок;
	
КонецФункции	

Функция ПериодПроверкиЗакрытияСчетов(ПараметрыВыполнения) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПериодыМСД.Ссылка КАК Ссылка,
		|	ПериодыМСД.ДатаНачала КАК ДатаНачала,
		|	ПериодыМСД.ДатаОкончания КАК ДатаОкончания,
		|	ПериодыМСД.Периодичность КАК Периодичность
		|ПОМЕСТИТЬ ВТ_Декабрь
		|ИЗ
		|	Справочник.ПериодыМСД КАК ПериодыМСД
		|ГДЕ
		|	ПериодыМСД.Периодичность = &ПериодичностьОтчетный
		|	И НЕ ПериодыМСД.ПометкаУдаления
		|	И ПериодыМСД.ДатаНачала = &ДатаНачалаДекабрь
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПериодыМСД.Ссылка КАК Ссылка,
		|	ПериодыМСД.ДатаНачала КАК ДатаНачала,
		|	ПериодыМСД.ДатаОкончания КАК ДатаОкончания,
		|	ПериодыМСД.Периодичность КАК Периодичность
		|ПОМЕСТИТЬ ВТ_Январь
		|ИЗ
		|	Справочник.ПериодыМСД КАК ПериодыМСД
		|ГДЕ
		|	ПериодыМСД.Периодичность = &ПериодичностьОтчетный
		|	И НЕ ПериодыМСД.ПометкаУдаления
		|	И ПериодыМСД.ДатаНачала = &ДатаНачалаЯнварь
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПериодыМСД.Ссылка КАК Ссылка,
		|	ПериодыМСД.ДатаНачала КАК ДатаНачала,
		|	ПериодыМСД.ДатаОкончания КАК ДатаОкончания,
		|	ПериодыМСД.Периодичность КАК Периодичность
		|ПОМЕСТИТЬ ВТ_ПерваяДекада
		|ИЗ
		|	Справочник.ПериодыМСД КАК ПериодыМСД
		|ГДЕ
		|	ПериодыМСД.Периодичность = &ПериодичностьПроизвольный
		|	И НЕ ПериодыМСД.ПометкаУдаления
		|	И ПериодыМСД.ДатаНачала = &ДатаНачалаЯнварь
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Декабрь.Ссылка КАК Ссылка,
		|	ВТ_Декабрь.ДатаНачала КАК ДатаНачала,
		|	ВТ_Декабрь.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	ВТ_Декабрь КАК ВТ_Декабрь
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ВТ_Декабрь.ДатаНачала, ДЕНЬ) = &ДатаНачала
		|	И КОНЕЦПЕРИОДА(ВТ_Декабрь.ДатаОкончания, ДЕНЬ) = &ДатаОкончания
		|	И &ВидПередаваемыхДанных В (ВТ_Декабрь.Периодичность = &ПериодичностьОтчетный)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_Январь.Ссылка,
		|	ВТ_Январь.ДатаНачала,
		|	ВТ_Январь.ДатаОкончания
		|ИЗ
		|	ВТ_Январь КАК ВТ_Январь
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ВТ_Январь.ДатаНачала, ДЕНЬ) = &ДатаНачала
		|	И КОНЕЦПЕРИОДА(ВТ_Январь.ДатаОкончания, ДЕНЬ) = &ДатаОкончания
		|	И &ВидПередаваемыхДанных В (ВТ_Январь.Периодичность = &ПериодичностьОтчетный)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ПерваяДекада.Ссылка,
		|	ВТ_ПерваяДекада.ДатаНачала,
		|	ВТ_ПерваяДекада.ДатаОкончания
		|ИЗ
		|	ВТ_ПерваяДекада КАК ВТ_ПерваяДекада
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ВТ_ПерваяДекада.ДатаНачала, ДЕНЬ) = &ДатаНачала
		|	И КОНЕЦПЕРИОДА(ВТ_ПерваяДекада.ДатаОкончания, ДЕНЬ) = &ДатаОкончания
		|	И НЕ &ВидПередаваемыхДанных В (ВТ_ПерваяДекада.Периодичность = &ПериодичностьПроизвольный)";
	
	Запрос.УстановитьПараметр("ДатаНачалаДекабрь", Дата(Год(ПараметрыВыполнения.НачалоПериода), 12, 01));
	Запрос.УстановитьПараметр("ДатаНачалаЯнварь", Дата(Год(ПараметрыВыполнения.НачалоПериода), 01, 01));
	Запрос.УстановитьПараметр("ПериодичностьПроизвольный", Перечисления.ПериодичностьМСД.ПроизвольныйПериод);
	Запрос.УстановитьПараметр("ПериодичностьОтчетный", Перечисления.ПериодичностьМСД.Месяц); 
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ПараметрыВыполнения.НачалоПериода));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ПараметрыВыполнения.ОкончаниеПериода));
	Запрос.УстановитьПараметр("ВидПередаваемыхДанных", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыВыполнения.ДокументСсылка, "ВидПередаваемыхДанных"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();	
	
КонецФункции	

Процедура ЗаполнитьТекстЗапросаСоединениемСАналитиками(МенеджерВТ, ТекстЗапроса, МассивАналитик)
	
	ПоляЗначенияАналитикВТОстатки = "";
	СоединенияЗначенияАналитик = "";
	ПоляЗначенияАналитикВТОстаткиПередВыгрузкой = "";
	ГруппировкаВТОстаткиПередВыгрузкой = "";
	ПоляЗначенияАналитикВТОстаткиПередВыгрузкой_СвернутыеОстатки = "";
	
	ШаблонСоединение = 
	"
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗначенияАналитик КАК ВТ_ЗначенияАналитик_%1
	|		ПО (ВТ_ЗначенияАналитик_%1.ИмяАналитики = ""%1"")
	|			И ВТ_ЗначенияАналитик_%1.УИ_Субконто = ВТОстатки.%1";

	ЕстьАналитики = МассивАналитик.Количество();
	
	ЗапросАналитики = Новый Запрос;
	ЗапросАналитики.МенеджерВременныхТаблиц = МенеджерВТ;
	ЗапросАналитики.Текст = 
	
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ВидыСубконтоАналитик.ИмяАналитики КАК ИмяАналитики
	|ИЗ
	|	ВТ_ВидыСубконтоАналитик КАК ВТ_ВидыСубконтоАналитик" + ?(ЕстьАналитики, "
	|ГДЕ
	|	ВТ_ВидыСубконтоАналитик.ИмяАналитики В(&МассивАналитик)", "");
	
	Если ЕстьАналитики Тогда
		ЗапросАналитики.УстановитьПараметр("МассивАналитик", МассивАналитик);
	КонецЕсли;
	
	ВыборкаИменаАналитик = ЗапросАналитики.Выполнить().Выбрать(); 
	
	Пока ВыборкаИменаАналитик.Следующий() Цикл 	
		ПоляЗначенияАналитикВТОстатки = ПоляЗначенияАналитикВТОстатки + СтрШаблон("
		|	ВЫБОР КОГДА ВТ_ЗначенияАналитик_%1.ИмяАналитики = ВТОстатки.Аналитика1 " +
		"ИЛИ ВТ_ЗначенияАналитик_%1.ИмяАналитики = ВТОстатки.Аналитика2 " + 
		"ИЛИ ВТ_ЗначенияАналитик_%1.ИмяАналитики = ВТОстатки.Аналитика3 " + 
		"ИЛИ ВТ_ЗначенияАналитик_%1.ИмяАналитики = ВТОстатки.Аналитика4 " + 
		"ИЛИ ВТ_ЗначенияАналитик_%1.ИмяАналитики = ВТОстатки.Аналитика5 " + 
		"ИЛИ ВТ_ЗначенияАналитик_%1.ИмяАналитики = ВТОстатки.Аналитика6 " + 
		"ТОГДА ЕСТЬNULL(ВТ_ЗначенияАналитик_%1.НомерПП, """") ИНАЧЕ """" КОНЕЦ КАК Значение_%1,", ВыборкаИменаАналитик.ИмяАналитики); 
		Если Не ВыборкаИменаАналитик.ИмяАналитики = "GRAF_ISP" Тогда
			СоединенияЗначенияАналитик = СоединенияЗначенияАналитик + СтрШаблон(ШаблонСоединение, ВыборкаИменаАналитик.ИмяАналитики); 
		КонецЕсли;
		ПоляЗначенияАналитикВТОстаткиПередВыгрузкой = ПоляЗначенияАналитикВТОстаткиПередВыгрузкой + СтрШаблон("
		|	ВТОстаткиПередВыгрузкой.Значение_%1 КАК Значение_%1,", ВыборкаИменаАналитик.ИмяАналитики);
		ГруппировкаВТОстаткиПередВыгрузкой = ГруппировкаВТОстаткиПередВыгрузкой + СтрШаблон("
		|	ВТОстаткиПередВыгрузкой.Значение_%1,", ВыборкаИменаАналитик.ИмяАналитики); 
		ПоляЗначенияАналитикВТОстаткиПередВыгрузкой_СвернутыеОстатки = ПоляЗначенияАналитикВТОстаткиПередВыгрузкой_СвернутыеОстатки + СтрШаблон("
		|	ВТОстаткиПередВыгрузкой_СвернутыеОстатки.Значение_%1 КАК Значение_%1,", ВыборкаИменаАналитик.ИмяАналитики);	
	КонецЦикла;	 
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ПоляЗначенияАналитикВТОстатки_", ПоляЗначенияАналитикВТОстатки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%СоединенияЗначенияАналитик", СоединенияЗначенияАналитик);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ПоляЗначенияАналитикВТОстаткиПередВыгрузкой_", ПоляЗначенияАналитикВТОстаткиПередВыгрузкой);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ГруппировкаВТОстаткиПередВыгрузкой", ГруппировкаВТОстаткиПередВыгрузкой);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ПоляЗначенияАналитикВТОстаткиПередВыгрузкойСвернутыеОстатки_", ПоляЗначенияАналитикВТОстаткиПередВыгрузкой_СвернутыеОстатки);

КонецПроцедуры

Процедура ПолучитьАналитикиГрафикИсполнения(МенеджерВТ, ОкончаниеПериода)

	Запрос = Новый Запрос;	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ВТОстатки.Счет КАК Счет,
	               |	ВТОстатки.КФОСсылка КАК КФО,
	               |	ВТОстатки.КПССсылка КАК КПС,
	               |	ВТОстатки.Субконто11 КАК Субконто1,
	               |	ВТОстатки.Субконто21 КАК Субконто2,
	               |	ВТОстатки.Субконто31 КАК Субконто3,
	               |	ВТОстатки.СуммаОстаток КАК СуммаОстаток
	               |ПОМЕСТИТЬ ВТАналитикиДоговор
	               |ИЗ
	               |	ВТОстатки КАК ВТОстатки
	               |ГДЕ
	               |	(ВТОстатки.Аналитика1 = &Аналитика
	               |			ИЛИ ВТОстатки.Аналитика2 = &Аналитика
	               |			ИЛИ ВТОстатки.Аналитика3 = &Аналитика
	               |			ИЛИ ВТОстатки.Аналитика4 = &Аналитика
	               |			ИЛИ ВТОстатки.Аналитика5 = &Аналитика
