#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает ссылку на присоединенный файл
// 
// Параметры:
//  ДокументСсылка - ДокументСсылка.ПакетыДанныхДляМСД, владелец присоединенного файла.
//	ИмяПакета	   - Строка, наименование элемента справочника ПакетыДанныхДляМСДПрисоединенныеФайлы.
// Возвращаемое значение:
// 	СправочникСсылка.ПакетыДанныхДляМСДПрисоединенныеФайлы.
//
Функция ПрисоединенныйФайлВыгрузки(ДокументСсылка, ИмяПакета) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ПакетыДанныхДляМСДПрисоединенныеФайлы.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.ПакетыДанныхДляМСДПрисоединенныеФайлы КАК ПакетыДанныхДляМСДПрисоединенныеФайлы
	                      |ГДЕ
	                      |	ПакетыДанныхДляМСДПрисоединенныеФайлы.ВладелецФайла = &ДокументСсылка
	                      |	И ПакетыДанныхДляМСДПрисоединенныеФайлы.Наименование = &ИмяПакета
	                      |	И НЕ ПакетыДанныхДляМСДПрисоединенныеФайлы.ПометкаУдаления
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ПакетыДанныхДляМСДПрисоединенныеФайлы.ДатаСоздания УБЫВ");
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка); 
	Запрос.УстановитьПараметр("ИмяПакета", ИмяПакета);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;           
	
	Возврат Неопределено;
	
КонецФункции

// Выполняет выгрузку данных
// Параметры:
//  СтруктураПараметров - Структура:
// 		* ВидПередаваемыхДанных 	- Булево - Истина - отчетные данные, Ложь - оперативны данные;
//		* НачалоПериода				- Дата - начало выгружаемого периода;
//		* ОкончаниеПериода			- Дата - окончание выгружаемого периода;
// 		* АдресРезультата			- Строка - адрес во временном хранилище, куда помещается результат выгрузки;
// 		* ДокументСсылка			- ДокументСсылка.ПакетыДанныхДляМСД - ссылка документа "Пакет передаваемых данных";
// 		* ВерсияТаксономии			- Строка - версия таксономии, по которой выполняется выгрузка.
// 	АдресРезультата					- Строка - адрес во временном хранилище, куда помещается результат выгрузки.
//
Процедура ВыполнитьВыгрузку(СтруктураПараметров,  АдресРезультата) Экспорт
	
	ПараметрыВыполнения = Новый Структура;
	
	ПараметрыВыполнения.Вставить("текФабрикаXDTO");
	ПараметрыВыполнения.Вставить("СоответствиеАналитик");
	ПараметрыВыполнения.Вставить("ДатаНачалаВыгрузки");
	ПараметрыВыполнения.Вставить("НачалоПериода");
	ПараметрыВыполнения.Вставить("ОкончаниеПериода");
	ПараметрыВыполнения.Вставить("СоответствиеПорядковыхНомеров");
	ПараметрыВыполнения.Вставить("ПорядковыйНомер");
	ПараметрыВыполнения.Вставить("ДокументСсылка");
	ПараметрыВыполнения.Вставить("ВерсияТаксономии");
	ПараметрыВыполнения.Вставить("ТаблицаРеквизитовАналитик");
	ПараметрыВыполнения.Вставить("Организация");
	ПараметрыВыполнения.Вставить("ВыполнятьПроверку");
	ПараметрыВыполнения.Вставить("НаборИсторияПроверкиАналитик");
	ПараметрыВыполнения.Вставить("МассивСчетовПерезагружаемые");
	ПараметрыВыполнения.Вставить("ПерезагружаемыеПериоды");
	ПараметрыВыполнения.Вставить("Каталог");
	ПараметрыВыполнения.Вставить("ПакетныйРежимВыгрузки");
	ПараметрыВыполнения.Вставить("ПространствоИменПакет");
	ПараметрыВыполнения.Вставить("ИспользоватьСхемуВыгрузки2026"); 
	
	ПараметрыВыполнения.ДатаНачалаВыгрузки = ТекущаяДатаСеанса();
	ПараметрыВыполнения.НачалоПериода = СтруктураПараметров.НачалоПериода;
	ПараметрыВыполнения.ОкончаниеПериода = СтруктураПараметров.ОкончаниеПериода;
	ПараметрыВыполнения.ДокументСсылка = СтруктураПараметров.ДокументСсылка;
	ПараметрыВыполнения.ВерсияТаксономии = СтруктураПараметров.ВерсияТаксономии;
	ПараметрыВыполнения.Организация = СтруктураПараметров.Организация;
	ПараметрыВыполнения.ВыполнятьПроверку = МодульСбораДанныхПовтИсп.ВыполнятьПроверкуПриВыгрузке(); 	
	
	НаборИсторияПроверкиАналитик = РегистрыСведений.ИсторияПроверкиАналитикМСД.СоздатьНаборЗаписей();
	НаборИсторияПроверкиАналитик.Отбор.Документ.Установить(СтруктураПараметров.ДокументСсылка);
	НаборИсторияПроверкиАналитик.Очистить();
	
	ПараметрыВыполнения.НаборИсторияПроверкиАналитик = НаборИсторияПроверкиАналитик;
	ПараметрыВыполнения.МассивСчетовПерезагружаемые = ПолучитьМассивСчетовПерезагружаемые(ПараметрыВыполнения);
	ПараметрыВыполнения.ПерезагружаемыеПериоды = Новый Массив;
	ПараметрыВыполнения.ПакетныйРежимВыгрузки = Константы.ПакетныйРежимВыгрузкиОстатковМСД.Получить(); 
	ПараметрыВыполнения.ИспользоватьСхемуВыгрузки2026 = ИспользоватьСхемуВыгрузки2026(ПараметрыВыполнения.ОкончаниеПериода);
	
	Если ПараметрыВыполнения.ИспользоватьСхемуВыгрузки2026 Тогда
		ПараметрыВыполнения.ПространствоИменПакет = "MSD_DATA_FHD_1_0_2";
	Иначе
		ПараметрыВыполнения.ПространствоИменПакет = МодульСбораДанных.ПространствоИмен();	
	КонецЕсли;	
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'ФОРМИРОВАНИЕ ВЫГРУЗКИ - НАЧАЛО'"));
	
	ИмяФайлаСхемы = ПолучитьИмяВременногоФайла("XSD");  
	
	
	НаборСхем = ФабрикаXDTO.ЭкспортСхемыXML(ПараметрыВыполнения.ПространствоИменПакет);
	СхемаXML = НаборСхем.Получить(0);
	СхемаXML.ОбновитьЭлементDOM();
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайлаСхемы);
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(СхемаXML.ДокументDOM, ЗаписьXML);
	ЗаписьXML.Закрыть();
	
	ПараметрыВыполнения.текФабрикаXDTO = СоздатьФабрикуXDTO(ИмяФайлаСхемы);
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ПараметрыВыполнения.СоответствиеПорядковыхНомеров = Новый Соответствие;
	ПараметрыВыполнения.ПорядковыйНомер = 1;
	
	Если Не ПараметрыВыполнения.Свойство("ВерсияТаксономии") Тогда
		ПараметрыВыполнения.Вставить("ВерсияТаксономии", "");	
	КонецЕсли;
	Если ПустаяСтрока(ПараметрыВыполнения.ВерсияТаксономии) Тогда 
		МодульОбщегоНазначенияМСД = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияМСД");
		ДанныеВерсии = МодульОбщегоНазначенияМСД.ТекущаяВерсияТаксономии(ПараметрыВыполнения.ОкончаниеПериода, ПараметрыВыполнения.Организация);
		Если ДанныеВерсии = Неопределено Тогда
			ВызватьИсключение ("Отсутствует утвержденная таксономия на конец периода");
		КонецЕсли;
		ПараметрыВыполнения.ВерсияТаксономии = ДанныеВерсии.Версия;
	КонецЕсли;
	
	ВыгружатьМО = (КонецДня(ПараметрыВыполнения.ОкончаниеПериода) >= Дата(2025,12,31,23,59,59)); 
	Если ПараметрыВыполнения.ИспользоватьСхемуВыгрузки2026 И ВыгружатьМО Тогда
		Если ПериодПроверкиЗакрытияСчетов(ПараметрыВыполнения) Тогда			
			МассивСсылокЗакрытие = ПроверитьДатыЗакрытияГода(ПараметрыВыполнения);
			Если МассивСсылокЗакрытие.Количество() Тогда
				ОписаниеОшибки = НСтр("ru='Не удалось выполнить выгрузку пакета.
				|Обнаружены документы закрытия счетов санкционирования, в которых дата относится к закрываемому году или дата не входит в выгружаемый период.
				|Для корректной выгрузки дата в таких документах должна приходиться на следующий год и входить в выгружаемый период.
				|Исправьте дату указанных документов и повторите попытку.%1'", ОбщегоНазначения.КодОсновногоЯзыка());
				МассивСсылокВСтроку = "";
				Для каждого СтрокаСсылка Из МассивСсылокЗакрытие Цикл
					МассивСсылокВСтроку = МассивСсылокВСтроку + "
					|" + СтрокаСсылка;
				КонецЦикла;
				ТекстИсключения = СтрШаблон(ОписаниеОшибки, МассивСсылокВСтроку);
				ОбщегоНазначения.СообщитьПользователю(ТекстИсключения);
				ВызватьИсключение ТекстИсключения;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Сбор данных в менеджер временных таблиц - начало'"));
	
	СформироватьДанныеДляВыгрузки(МенеджерВТ, ПараметрыВыполнения);
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Сбор данных в менеджер временных таблиц - Окончание'"));
	
	Каталог = ПолучитьИмяВременногоФайла() + ПолучитьРазделительПути() + XMLСтрока(Новый УникальныйИдентификатор) + ПолучитьРазделительПути();
	СоздатьКаталог(Каталог); 
	ПараметрыВыполнения.Каталог = Каталог;
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование Header.xml - начало'"));
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(Каталог + "Header.xml");
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ОбъектBody 		= ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "Body"));
	
	ОбъектHeader 	= ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "Body").Свойства.Получить("Header").Тип);
	ОбъектHeader.VersionTFF 			= ПараметрыВыполнения.ВерсияТаксономии;
	Если ПараметрыВыполнения.ИспользоватьСхемуВыгрузки2026 Тогда
		ОбъектHeader.VersionScheme 			= "1.0.2"; 	
	Иначе	
		ОбъектHeader.VersionScheme 			= "1.0.1"; 
	КонецЕсли;	
	
	ОбъектHeader.DueDateOf 				= ТекущаяДатаСеанса();
	ОбъектHeader.StartPeriodOfBalance 	= СтруктураПараметров.НачалоПериода;
	ОбъектHeader.EndPeriodOfBalance 	= СтруктураПараметров.ОкончаниеПериода;
	ОбъектHeader.OperationalData 		= Не СтруктураПараметров.ВидПередаваемыхДанных;
	
	ДанныеОПрограмме = МодульСбораДанныхПовтИсп.ДанныеОПрограмме();
	
	ОбъектHeader.SourceName		 		= ДанныеОПрограмме.Имя;
	ОбъектHeader.SourceVersion	 		= ДанныеОПрограмме.Версия;
	ОбъектHeader.Vendor					= ДанныеОПрограмме.Поставщик;
	
	ОбъектBody.Header					= ОбъектHeader;
	ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектBody);
	ЗаписьXML.Закрыть();
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование Header.xml - окончание'"));
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование AnalyticsData.xml - начало'"));	
	
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.ОткрытьФайл(Каталог + "AnalyticsData.xml");
	ЗаписатьШапкуНачалаЭлемента(ЗаписьXML, ПараметрыВыполнения.ПространствоИменПакет);
	ЗаписьXML.ЗаписатьНачалоЭлемента("AnalyticsData");
	
	ЗаполнитьАналитики(ЗаписьXML, МенеджерВТ, ПараметрыВыполнения);
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Body
	ЗаписьXML.ЗаписатьКонецЭлемента(); // AnalyticsData
	ЗаписьXML.Закрыть();  
		
	ДанныеАналитикВ_МенеджерВТ(ПараметрыВыполнения.СоответствиеПорядковыхНомеров, МенеджерВТ);
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТИменаАналитик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТУчетныеНомераОбязательств
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТХарактеристикиОбязательств
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТАналитики_OS_NMA_NPA_ARENDA
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_АналитикиСвязи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТТаблицаНомеровАналитик");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование AnalyticsData.xml - окончание'"));
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование остатков - начало'"));
	
	ЗаписьXML = Новый ЗаписьXML(); 
	ЗаписьXML.ОткрытьФайл(Каталог + "Data_Balance.xml");	
	ЗаписатьШапкуНачалаЭлемента(ЗаписьXML, ПараметрыВыполнения.ПространствоИменПакет);
	ЗаписьXML.ЗаписатьНачалоЭлемента("DataBalance");
	
	ЗаполнитьОстатки(ЗаписьXML, МенеджерВТ, ПараметрыВыполнения);
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Body
	ЗаписьXML.ЗаписатьКонецЭлемента(); // DataBalance
	ЗаписьXML.Закрыть();   
	
	Если ПараметрыВыполнения.ИспользоватьСхемуВыгрузки2026 Тогда
		ЗаписьXML = Новый ЗаписьXML(); 
		ЗаписьXML.ОткрытьФайл(Каталог + "DataBalanceReloadPeriods.xml");		
		ЗаписатьШапкуНачалаЭлемента(ЗаписьXML, ПараметрыВыполнения.ПространствоИменПакет);		
		ЗаписьXML.ЗаписатьНачалоЭлемента("DataBalanceRP");
		
		Если ПараметрыВыполнения.ПерезагружаемыеПериоды.Количество() Тогда
			ЗаполнитьОстатки(ЗаписьXML, МенеджерВТ, ПараметрыВыполнения, Истина);
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Body
		ЗаписьXML.ЗаписатьКонецЭлемента(); // DataBalanceRP
		ЗаписьXML.Закрыть(); 
	КонецЕсли;
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование остатков - окончание'"));
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование оборотов - начало'"));
	ЗаполнитьОбороты(Каталог, МенеджерВТ, ПараметрыВыполнения);
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование оборотов - окончание'"));
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Создание архивного файла - начало'"));
	
	РезультатМассив = Новый Массив;
	
	ФайлыВозврата = НайтиФайлы(Каталог, "*.xml");
	Для Каждого ФайлВозврата Из ФайлыВозврата Цикл
		РезультатМассив.Добавить(Новый Структура(ФайлВозврата.ИмяБезРасширения, Новый ДвоичныеДанные(ФайлВозврата.ПолноеИмя)));
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(Новый ХранилищеЗначения(РезультатМассив), АдресРезультата);
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Создание архивного файла - окончание'"));
	
	УдалитьФайлы(Каталог);
	
	ПараметрыВыполнения.НаборИсторияПроверкиАналитик.Записать(Истина);
	ПараметрыВыполнения.текФабрикаXDTO = Неопределено;
	ПозицияРазделителя = СтрНайти(ИмяФайлаСхемы, ПолучитьРазделительПути(), НаправлениеПоиска.СКонца);
	УдалитьФайлы(ИмяФайлаСхемы);
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'ФОРМИРОВАНИЕ ВЫГРУЗКИ - ОКОНЧАНИЕ'"));
	
КонецПроцедуры

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	
КонецПроцедуры

Функция ПолучитьТабличныйДокументИзХранилища(СтруктураПараметров,  АдресРезультата) Экспорт
	
	ДокументСсылка = СтруктураПараметров.ДокументСсылка; 
	ИмяДокумента = СтруктураПараметров.ИмяДокумента;
	
	ТабДок = ДокументСсылка[ИмяДокумента].Получить();
	Если ТабДок = Неопределено Тогда
		ТабДок = Новый ТабличныйДокумент;
		Макет = ПолучитьМакет("ПФ_MXL_" + ИмяДокумента);
		Область = Макет.ПолучитьОбласть("СтрокаДанныеОтсутствуют");
		ТабДок.Вывести(Область);
	КонецЕсли;
	ПоместитьВоВременноеХранилище(ТабДок, АдресРезультата); 
	
КонецФункции

Функция СформироватьТабличныеДокументы(СтруктураПараметров,  АдресРезультата) Экспорт
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование печатных форм - начало'"));
	
	ДокументСсылка = СтруктураПараметров.ДокументСсылка;
	ИмяПакета = СтруктураПараметров.ИмяПакета;
	
	МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
	
	ФайлВыгрузки = ПрисоединенныйФайлВыгрузки(ДокументСсылка, ИмяПакета);
	ДанныеФайла = Неопределено;
	Если НЕ ФайлВыгрузки = Неопределено Тогда
		ДанныеФайла = МодульРаботаСФайлами.ДвоичныеДанныеФайла(ФайлВыгрузки);
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("zip");
	Если НЕ ДанныеФайла = Неопределено Тогда
		ДанныеФайла.Записать(ИмяФайла);
	КонецЕсли;
	
	ФайлыДанных = РаспаковатьФайлАрхива(ИмяФайла, ИмяПакета);	
	УдалитьФайлы(ИмяФайла);
	
	ПутьКФайлу = Неопределено;
	
	КэшИдентификаторов = Новый Соответствие;
	Если ФайлыДанных.Файлы.Свойство("AnalyticsData", ПутьКФайлу) Тогда
		ЗагрузитьАналитики(ПутьКФайлу, КэшИдентификаторов);
	КонецЕсли;
	
	ОбъектДокумент = ДокументСсылка.ПолучитьОбъект();	
	
	Если ФайлыДанных.Файлы.Свойство("DataBalanceReloadPeriods", ПутьКФайлу) Тогда
		ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование ПФ_MXL_ДанныеДляПересчетаОстатков - начало'"));
		ЗагрузитьОстаткиПересчет(ПутьКФайлу, ОбъектДокумент, КэшИдентификаторов);
		ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование ПФ_MXL_ДанныеДляПересчетаОстатков - конец'"));
	КонецЕсли;
	
	Если ФайлыДанных.Файлы.Свойство("MO", ПутьКФайлу) Тогда
		ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование ПФ_MXL_ДанныеМО - начало'"));
		ЗагрузитьДанныеМО(ПутьКФайлу, ОбъектДокумент, КэшИдентификаторов);
		ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование ПФ_MXL_ДанныеМО - конец'"));
	КонецЕсли;
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование ПФ_MXL_ДанныеОстатковИОборотов - начало'"));
	ЗагрузитьДанныеОстатковИОборотов(ФайлыДанных.Файлы, ОбъектДокумент, КэшИдентификаторов);
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование ПФ_MXL_ДанныеОстатковИОборотов - конец'"));
	
	ОбъектДокумент.Записать();
	
	ЗаписьСобытияВЖурналРегистрации(НСтр("ru = 'Формирование печатных форм - окончание'"));
	
КонецФункции 

