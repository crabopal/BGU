	|	ВТТаблицаСвязейАналитик_Общ.ОбязательноВОстатках5,
	|	ВТТаблицаСвязейАналитик_Общ.ОбязательноВОстатках6,
	|	ВТОстатки%ИмяОстаткиОбработанная.Счет,
	|	ЕСТЬNULL(КлассификационныеПризнакиСчетов.Код, """"),
	|	ЕСТЬNULL(КлассификационныеПризнакиСчетов.Ссылка, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)),
	|	ВЫБОР
	|		КОГДА ВТТаблицаСвязейАналитик_Общ.ВОстатках1
	|			ТОГДА ВТТаблицаСвязейАналитик_Общ.Аналитика1
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ВТТаблицаСвязейАналитик_Общ.ВОстатках2
	|			ТОГДА ВТТаблицаСвязейАналитик_Общ.Аналитика2
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ВТТаблицаСвязейАналитик_Общ.ВОстатках3
	|			ТОГДА ВТТаблицаСвязейАналитик_Общ.Аналитика3
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ВТТаблицаСвязейАналитик_Общ.ВОстатках4
	|			ТОГДА ВТТаблицаСвязейАналитик_Общ.Аналитика4
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ВТТаблицаСвязейАналитик_Общ.ВОстатках5
	|			ТОГДА ВТТаблицаСвязейАналитик_Общ.Аналитика5
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ВТТаблицаСвязейАналитик_Общ.ВОстатках6
	|			ТОГДА ВТТаблицаСвязейАналитик_Общ.Аналитика6
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	ЕПСБУ.Вид,
	|	ВТТаблицаСвязейАналитик_Общ.ОбязательноВОстатках1,
	|	ЕСТЬNULL(Валюты.Код, """"),
	|	ВТТаблицаСвязейАналитик_Общ.Счет,
	|	ВТОстатки%ИмяОстаткиОбработанная.КЭК,
	|	ЕПСБУ.Код,
	|	" + ПолучитьТекстЗапросаТипКБК("КлассификационныеПризнакиСчетов") + ",
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ВТОстатки%ИмяОстаткиОбработанная.КФО),
	|	ВТОстатки%ИмяОстаткиОбработанная.КФО"; 
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса ,"%ИмяОстаткиПредварительно" , ИмяОстаткиПредварительно);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса ,"%ИмяОстатки" , ИмяОстатки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ПараметрДатаОстатки", ПараметрДатаОстатки);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция УничтожитьТаблицыПредварительно(ИмяОстатки) 
	
	ТекстЗапроса =
	"УНИЧТОЖИТЬ ВТОстатки%ИмяОстатки_Предварительно
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОстатки%ИмяОстаткиОбработанная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса ,"%ИмяОстатки" , ИмяОстатки);
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьТекстЗапросаОстаткиОкончательно(ИмяОстаткиПредварительно, ИмяОстаткиБезСубконто4, ИмяОстатки)
	
	ИспользуетсяБГУСпец = Ложь;
	МодульСбораДанныхПереопределяемый.ОпределитьИспользованиеБГУСпец(ИспользуетсяБГУСпец);
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ВТОстаткиПредварительно.Организация КАК Организация,
	|	ВТОстаткиПредварительно.ДатаОкончания КАК ДатаОкончания,
	|	ВТОстаткиПредварительно.Счет КАК Счет,
	|	ВТОстаткиПредварительно.КФО КАК КФО,
	|	ВТОстаткиПредварительно.КФОСсылка КАК КФОСсылка,
	|	ВТОстаткиПредварительно.КПС КАК КПС,
	|	ВТОстаткиПредварительно.КПССсылка КАК КПССсылка,
	|	ВТОстаткиПредварительно.КЭК КАК КЭК,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТОстаткиПредварительно.Субконто1) КАК Субконто1,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТОстаткиПредварительно.Субконто2) КАК Субконто2,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТОстаткиПредварительно.Субконто3) КАК Субконто3,
	|	ВТОстаткиПредварительно.СуммаОстаток КАК СуммаОстаток,
	|	ВЫБОР
	|		КОГДА ВТОстаткиПредварительно.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|			ТОГДА ВТОстаткиПредварительно.СуммаОстатокДт - ВТОстаткиПредварительно.СуммаОстатокКт
	|		КОГДА ВТОстаткиПредварительно.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА 0
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ВТОстаткиПредварительно.СуммаОстатокДт - ВТОстаткиПредварительно.СуммаОстатокКт > 0
	|					ТОГДА ВТОстаткиПредварительно.СуммаОстатокДт - ВТОстаткиПредварительно.СуммаОстатокКт
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ КАК СуммаОстатокДт,
	|	ВЫБОР
	|		КОГДА ВТОстаткиПредварительно.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|			ТОГДА 0
	|		КОГДА ВТОстаткиПредварительно.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА ВТОстаткиПредварительно.СуммаОстатокКт - ВТОстаткиПредварительно.СуммаОстатокДт
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ВТОстаткиПредварительно.СуммаОстатокКт - ВТОстаткиПредварительно.СуммаОстатокДт > 0
	|					ТОГДА ВТОстаткиПредварительно.СуммаОстатокКт - ВТОстаткиПредварительно.СуммаОстатокДт
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ КАК СуммаОстатокКт,
	|	ВЫБОР
	|		КОГДА ВТОстаткиПредварительно.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|			ТОГДА ВТОстаткиПредварительно.КоличествоОстатокДт - ВТОстаткиПредварительно.КоличествоОстатокКт
	|		КОГДА ВТОстаткиПредварительно.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА 0
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ВТОстаткиПредварительно.КоличествоОстатокДт - ВТОстаткиПредварительно.КоличествоОстатокКт > 0
	|					ТОГДА ВТОстаткиПредварительно.КоличествоОстатокДт - ВТОстаткиПредварительно.КоличествоОстатокКт
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ КАК КоличествоОстатокДт,
	|	ВЫБОР
	|		КОГДА ВТОстаткиПредварительно.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|			ТОГДА 0
	|		КОГДА ВТОстаткиПредварительно.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА ВТОстаткиПредварительно.КоличествоОстатокКт - ВТОстаткиПредварительно.КоличествоОстатокДт
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ВТОстаткиПредварительно.КоличествоОстатокКт - ВТОстаткиПредварительно.КоличествоОстатокДт > 0
	|					ТОГДА ВТОстаткиПредварительно.КоличествоОстатокКт - ВТОстаткиПредварительно.КоличествоОстатокДт
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ КАК КоличествоОстатокКт,
	|	ВТОстаткиПредварительно.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА ВТОстаткиПредварительно.ВидСчета = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|			ТОГДА ВТОстаткиПредварительно.ВалютнаяСуммаОстатокДт - ВТОстаткиПредварительно.ВалютнаяСуммаОстатокКт
