Процедура SCHET(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения)
	
	ЗаписьXML = ОбщийОбъект;
	
	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.SCHET(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	МассивСубконто = Новый Массив;
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЛицевыеСчета);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.РазделыЛицевыхСчетов);
	
	СпецАналитикуВМенеджерВТ(МенеджерВТ, МассивСубконто, "SCHET",,ПараметрыВыполнения); 
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЛицевыеСчета.Ссылка КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЛицевыеСчета.Ссылка) КАК GUID,
	|	ЛицевыеСчета.Наименование КАК Наименование,
	|	ВЫБОР
	|		КОГДА ЛицевыеСчета.ТипЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ТипыЛицевыхСчетов.Казначейский)
	|			ТОГДА ""1""
	|		ИНАЧЕ ""2""
	|	КОНЕЦ КАК VID_SCHET,
	|	ВЫРАЗИТЬ(ЛицевыеСчета.Код КАК СТРОКА(11)) КАК NUM_LIC_SCHET,
	|	ВЫРАЗИТЬ(ЛицевыеСчета.Код КАК СТРОКА(20)) КАК NUM_BANK_SCHET,
	|	ЕСТЬNULL(РеквизитыЛицевыхСчетов.БанкДляРасчетов.Код, Банки.Код) КАК BIK
	|ИЗ
	|	ВТАналитики_SCHET КАК ВТАналитики
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеИКазначейскиеСчета КАК БанковскиеИКазначейскиеСчета
	|					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
	|					ПО БанковскиеИКазначейскиеСчета.КассовыйОрган = Банки.Ссылка
	|				ПО РеквизитыЛицевыхСчетов.СчетКазначейства = БанковскиеИКазначейскиеСчета.Ссылка
	|			ПО ЛицевыеСчета.Ссылка = РеквизитыЛицевыхСчетов.Владелец
	|		ПО ВТАналитики.Аналитика = ЛицевыеСчета.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РазделыЛицевыхСчетов.Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(РазделыЛицевыхСчетов.Ссылка),
	|	РазделыЛицевыхСчетов.Наименование,
	|	ВЫБОР
	|		КОГДА ЛицевыеСчета.ТипЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ТипыЛицевыхСчетов.Казначейский)
	|			ТОГДА ""1""
	|		ИНАЧЕ ""2""
	|	КОНЕЦ,
	|	ВЫРАЗИТЬ(ЛицевыеСчета.Код КАК СТРОКА(11)),
	|	ВЫРАЗИТЬ(ЛицевыеСчета.Код КАК СТРОКА(20)),
	|	ЕСТЬNULL(РеквизитыЛицевыхСчетов.БанкДляРасчетов.Код, Банки.Код)
	|ИЗ
	|	ВТАналитики_SCHET КАК ВТАналитики
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РазделыЛицевыхСчетов КАК РазделыЛицевыхСчетов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
	|					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеИКазначейскиеСчета КАК БанковскиеИКазначейскиеСчета
	|						ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
	|						ПО БанковскиеИКазначейскиеСчета.КассовыйОрган = Банки.Ссылка
	|					ПО РеквизитыЛицевыхСчетов.СчетКазначейства = БанковскиеИКазначейскиеСчета.Ссылка
	|				ПО ЛицевыеСчета.Ссылка = РеквизитыЛицевыхСчетов.Владелец
	|			ПО РазделыЛицевыхСчетов.Владелец = ЛицевыеСчета.Ссылка
	|		ПО ВТАналитики.Аналитика = РазделыЛицевыхСчетов.Ссылка");       
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Выборка 				= Запрос.Выполнить().Выбрать();
	
	СтруктураРеквизитов = СтруктураРеквизитовАналитики("SCHET", ПараметрыВыполнения);
	НН = ПараметрыВыполнения.НаборИсторияПроверкиАналитик.Количество();
	МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("SCHET", ПараметрыВыполнения); 
	
	Пока Выборка.Следующий() Цикл  
		
		ОбъектSCHET = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "SCHET")); 
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, Выборка);         
		СтруктураРеквизитов.GUID = XMLСтрока(Выборка.GUID);                                    
		
		пЗаполнитьЗначенияСвойств(ОбъектSCHET, СтруктураРеквизитов);
		Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
			ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, "SCHET", Строка(Выборка.Наименование), НН, МассивОбязательныхРеквизитов);
		КонецЕсли;                                      	
		
		ОбъектSCHET.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");  
		ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("SCHET_" + ОбъектSCHET.GUID, ОбъектSCHET.ID);
		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;	
		               
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектSCHET);
	КонецЦикла;
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТАналитики_SCHET"); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры  

Процедура VID_DEN_DOC(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения)
	
	ЗаписьXML = ОбщийОбъект;
	
	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.VID_DEN_DOC(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	СпецАналитикуВМенеджерВТ(МенеджерВТ, МодульОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПланыВидовХарактеристик.ВидыСубконто.ВидыДенежныхДокументов), "VID_DEN_DOC",,ПараметрыВыполнения);      
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВидыДенежныхДокументов.Ссылка КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВидыДенежныхДокументов.Ссылка) КАК GUID,
	|	ВидыДенежныхДокументов.Наименование КАК NAME
	|ИЗ
	|	ВТАналитики_VID_DEN_DOC КАК ВТАналитики
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыДенежныхДокументов КАК ВидыДенежныхДокументов
	|		ПО ВТАналитики.Аналитика = ВидыДенежныхДокументов.Ссылка");       
	
