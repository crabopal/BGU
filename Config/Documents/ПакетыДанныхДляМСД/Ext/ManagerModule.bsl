#Область Адрес

Процедура ЗаполнитьСтрокиАдреса(ТаблицаАдресов, Выгрузка, СтрокаКолонок)
	
	МодульОбщегоНазначенияКлиентСервер 					= ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	МодульУправлениеКонтактнойИнформациейКлиентСервер	= ОбщегоНазначения.ОбщийМодуль("УправлениеКонтактнойИнформациейКлиентСервер");
	МодульУправлениеКонтактнойИнформацией 				= ОбщегоНазначения.ОбщийМодуль("УправлениеКонтактнойИнформацией");
	МодульУправлениеКонтактнойИнформациейСлужебный		= ОбщегоНазначения.ОбщийМодуль("УправлениеКонтактнойИнформациейСлужебный");
	МодульРаботаСАдресами								= ОбщегоНазначения.ОбщийМодуль("РаботаСАдресами");
	
	Для Каждого текСтрока Из Выгрузка Цикл
		АдресСтрокой = текСтрока.ЗначенияПолей;
		Попытка
			Если НЕ МодульУправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВJSON(АдресСтрокой) Тогда
				АдресСтрокой = МодульУправлениеКонтактнойИнформацией.КонтактнаяИнформацияВJSON(АдресСтрокой, Перечисления.ТипыКонтактнойИнформации.Адрес);
				текСтрока.ЗначенияПолей = АдресСтрокой;
			КонецЕсли;                                 
			АдресИзJSON = МодульУправлениеКонтактнойИнформациейСлужебный.JSONВКонтактнуюИнформациюПоПолям(АдресСтрокой, Перечисления.ТипыКонтактнойИнформации.Адрес);
		Исключение
			ВызватьИсключение(СтрШаблон(НСтр("ru = 'Ошибка преобразования данных адреса:%1%2%1Представление: %3'"), Символы.ПС, АдресСтрокой, текСтрока.Представление) + Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
	МассивПолейЗначений = Выгрузка.ВыгрузитьКолонку("ЗначенияПолей");
	
	МассивРезультат = МодульРаботаСАдресами.СведенияОбАдресах(МассивПолейЗначений, Новый Структура("БезПредставлений", Истина)); 	
	
	
	
	
	Для НН = 0 По Выгрузка.Количество() - 1 Цикл
		Выборка = Выгрузка[НН];
		СтруктураАдреса = МассивРезультат[НН];
		новСтрока = ТаблицаАдресов.Добавить();
		
		п_Страна = СтруктураАдреса.Страна;
		
		новСтрока.STRANA			= ?(ПустаяСтрока(п_Страна), ?(ПустаяСтрока(Выборка.Страна), "РОССИЯ", Выборка.Страна), п_Страна);
		новСтрока.OKTMO 			= "";
		новСтрока.INDEX 			= Лев(?(ПустаяСтрока(СтруктураАдреса.Индекс), "000000", СтруктураАдреса.Индекс), 6);
		новСтрока.ADM_MUN_DELENIE 	= ?(СтруктураАдреса.ТипАдреса = "Административно-территориальный", "2", "1");
		новСтрока.ULICA_VID 		= СтруктураАдреса.УлицаСокращение + ?(ЗначениеЗаполнено(СтруктураАдреса.УлицаСокращение),".", "");
		новСтрока.ULICA 			= СтруктураАдреса.Улица;         
		
		новСтрока.DOM_VID 		= СтруктураАдреса.Здание.ТипЗдания;                                                         		
		новСтрока.DOM 			= СтруктураАдреса.Здание.Номер;                                                             
		
		Если Не СтруктураАдреса.Корпуса.Количество() = 0 Тогда  		
			
			ЭтоПервый 		= Истина;
			СтроениеВид 	= "";  
			Строение 		= "";
			Для Каждого текКорпус Из СтруктураАдреса.Корпуса Цикл
				Если ЭтоПервый Тогда
					СтроениеВид 	= текКорпус.ТипКорпуса; 
					Строение 		= текКорпус.Номер; 
					ЭтоПервый = Ложь;				
				Иначе                                  
					Строение 		= Строение + ", " + текКорпус.ТипКорпуса + " " +текКорпус.Номер; 
				КонецЕсли;
				Если СтрДлина(Строение) > 50 Тогда
					Прервать;	
				КонецЕсли;
			КонецЦикла;
			
			новСтрока.STROENIE_VID  = СтроениеВид;
			новСтрока.STROENIE		= ?(СтрДлина(Строение) > 50, Лев(Строение, 50), Строение); 
			
		КонецЕсли;
		
		Если Не СтруктураАдреса.Помещения.Количество() = 0 Тогда
			
			ЭтоПервый = Истина;
			ОфисВид 	= "";  
			Офис 		= "";
			
			Для Каждого текКорпус Из СтруктураАдреса.Помещения Цикл        
				Если ЭтоПервый Тогда
					ОфисВид 	= текКорпус.ТипПомещения; 
					Офис 		= текКорпус.Номер; 
					ЭтоПервый = Ложь;				
				Иначе                                  
					Офис 		= Офис + ", " + текКорпус.ТипПомещения + " " +текКорпус.Номер; 
				КонецЕсли;
				Если СтрДлина(Офис) > 50 Тогда
					Прервать;	
				КонецЕсли;
			КонецЦикла;			
			
			новСтрока.OFIS_VID  = ОфисВид;
			новСтрока.OFIS		 = ?(СтрДлина(Офис) > 50, Лев(Офис, 50), Офис);       
			
		КонецЕсли;
		
		
		ХешДеления = "";	
		
		
		новСтрока.REGION 		= СтруктураАдреса.РегионТипКраткий + ?(ЗначениеЗаполнено(СтруктураАдреса.РегионТипКраткий),". ", "")
		+ СтруктураАдреса.Регион;
		новСтрока.RAION 		= СтруктураАдреса.РайонТипКраткий + ?(ЗначениеЗаполнено(СтруктураАдреса.РайонТипКраткий),". ", "")
		+ СтруктураАдреса.Район;
		новСтрока.GOROD 		= СтруктураАдреса.ГородТипКраткий + ?(ЗначениеЗаполнено(СтруктураАдреса.ГородТипКраткий),". ", "")
		+ СтруктураАдреса.Город;
		новСтрока.NAS_PUNKT 	= СтруктураАдреса.НаселенныйПунктТипКраткий + ?(ЗначениеЗаполнено(СтруктураАдреса.НаселенныйПунктТипКраткий),". ", "")
		+ СтруктураАдреса.НаселенныйПункт;
		новСтрока.TERRITORIYA	= СтруктураАдреса.ТерриторияТипКраткий + ?(ЗначениеЗаполнено(СтруктураАдреса.ТерриторияТипКраткий),". ", "")
		+ СтруктураАдреса.Территория;
		
		ХешДеления = новСтрока.REGION + новСтрока.RAION + новСтрока.GOROD + новСтрока.NAS_PUNKT + новСтрока.TERRITORIYA;
		
		Если новСтрока.ADM_MUN_DELENIE = "1" Тогда
			
			новСтрока.MUN_RAION_OKRUG 	= СтруктураАдреса.МуниципальныйРайонТипКраткий + ?(ЗначениеЗаполнено(СтруктураАдреса.МуниципальныйРайонТипКраткий),". ", "")
			+ СтруктураАдреса.МуниципальныйРайон;													                     
			новСтрока.POSELENIE		= СтруктураАдреса.ПоселениеТипКраткий + ?(ЗначениеЗаполнено(СтруктураАдреса.ПоселениеТипКраткий),". ", "")
			+ СтруктураАдреса.Поселение;														
			ХешДеления = ХешДеления + новСтрока.MUN_RAION_OKRUG + новСтрока.POSELENIE;												
			
			новСтрока.ХЭШ_NAS_PUNKT_MUN = РассчитатьХешСтроки(ХешДеления);
		Иначе                                                            
			новСтрока.ХЭШ_NAS_PUNKT_ADM = РассчитатьХешСтроки(ХешДеления);		
		КонецЕсли; 
		новСтрока.ХЭШ = РассчитатьХешСтроки(Выборка.ЗначенияПолей + Выборка.Представление);		
	КонецЦикла;
	
	
КонецПроцедуры


#КонецОбласти

#Область ОпределениеЗначенияАналитики

Функция f_VID_RACH_ZAIM_KR(Аналитика, Выборка, ДтКт)
	
	ИмяПеречисления = "ВидыРасчетовПоЗаймам";
	Для НН = 1 По 3 Цикл
		Суффикс = ДтКт + Строка(НН);
		Если ТипЗнч(Выборка["Субконто" + Суффикс]) = Тип("ПеречислениеСсылка." + ИмяПеречисления) И ЗначениеЗаполнено(Выборка["Субконто" + Суффикс]) Тогда
			ВидРасчетовПоЗаймам = Выборка["Субконто" + Суффикс];
			Если ВидРасчетовПоЗаймам = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг Тогда			
				Возврат "1";
			ИначеЕсли ВидРасчетовПоЗаймам = Перечисления.ВидыРасчетовПоЗаймам.Проценты Тогда			
				Возврат "2";
			ИначеЕсли ВидРасчетовПоЗаймам = Перечисления.ВидыРасчетовПоЗаймам.Штрафы Тогда			
				Возврат "3";
			ИначеЕсли ВидРасчетовПоЗаймам = Перечисления.ВидыРасчетовПоЗаймам.ПениНаОсновнойДолг Тогда			
				Возврат "4";
			ИначеЕсли ВидРасчетовПоЗаймам = Перечисления.ВидыРасчетовПоЗаймам.ПениНаПроценты Тогда			
				Возврат "5";
			ИначеЕсли ВидРасчетовПоЗаймам = Перечисления.ВидыРасчетовПоЗаймам.СтоимостьРазмещенияЦБ Тогда			
				Возврат "6";
			ИначеЕсли ВидРасчетовПоЗаймам = Перечисления.ВидыРасчетовПоЗаймам.ОтклонениеОтНоминала Тогда			
				Возврат "7";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "1";
	
КонецФункции

Функция МассивОбязательныхРеквизитовАналитики(Аналитика, ПараметрыВыполнения)
	
	Результат = Новый Массив;
	МассивСтрок = ПараметрыВыполнения.ТаблицаРеквизитовАналитик.НайтиСтроки(Новый Структура("Аналитика, Используется, Обязательный", Аналитика, Истина, Истина));
	Для Каждого Строка Из МассивСтрок Цикл 
		
		Результат.Добавить(Строка.Реквизит);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции  

Процедура ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, Аналитика, ПредставлениеСсылки, НН, МассивОбязательныхРеквизитов)   
	
	Для Каждого текРеквизит Из МассивОбязательныхРеквизитов Цикл
		Если текРеквизит = "Владелец" Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтруктураРеквизитов[текРеквизит]) Тогда 
			НН = НН + 1;
			новЗапись = ПараметрыВыполнения.НаборИсторияПроверкиАналитик.Добавить();
			новЗапись.Документ 			= ПараметрыВыполнения.ДокументСсылка;
			новЗапись.ВерсияФормата 	= ПараметрыВыполнения.ВерсияТаксономии;
			новЗапись.НомерЗаписи 		= НН; 
			новЗапись.ТипЗаписи 		= Перечисления.ТипыЗаписейМСД.РеквизитыАналитик;  
			новЗапись.ИмяАналитики 		= Аналитика;
			новЗапись.ДатаПроверки 		= ТекущаяДатаСеанса();
			новЗапись.Ошибка 			= Истина;
			новЗапись.ТекстСообщения 	= СтрШаблон(НСтр("ru = 'В аналитике %1 (%2) не заполнен реквизит %3'"), Аналитика, ПредставлениеСсылки, текРеквизит);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписьСобытияВЖурналРегистрации(ТекстСообщения, Уровень = Неопределено)
	
	Если Уровень = Неопределено Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'ВыгрузкаПакетаДляМСД'", ОбщегоНазначения.КодОсновногоЯзыка()), Уровень,,, ТекстСообщения, РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
	
КонецПроцедуры

Функция РассчитатьХешСтроки(Строка)
	
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA1);
	Хеш.Добавить(Строка);
	
	Возврат НРег(СтрЗаменить(Хеш.ХешСумма, " ", ""));	
	
КонецФункции

Функция РеквизитыАналитик(Версия) 
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиРеквизитовАналитикМСД.Аналитика КАК Аналитика,
	|	НастройкиРеквизитовАналитикМСД.Реквизит КАК Реквизит,
	|	НастройкиРеквизитовАналитикМСД.Используется КАК Используется,
	|	НастройкиРеквизитовАналитикМСД.Обязательный КАК Обязательный
	|ИЗ
	|	РегистрСведений.НастройкиРеквизитовАналитикМСД КАК НастройкиРеквизитовАналитикМСД
	|ГДЕ
	|	НастройкиРеквизитовАналитикМСД.Версия = &Версия"); 
	Запрос.УстановитьПараметр("Версия", Версия);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
	
КонецФункции

Функция НоваяТаблицаАдресов()
	
	Результат = Новый ТаблицаЗначений;   
	Результат.Колонки.Добавить("ID", 				Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("STRANA", 			Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	Результат.Колонки.Добавить("INDEX", 			Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(6)));
	Результат.Колонки.Добавить("OKTMO", 			Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(8)));
	Результат.Колонки.Добавить("ADM_MUN_DELENIE", 	Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(1)));
	Результат.Колонки.Добавить("NAS_PUNKT_ADM", 	Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("NAS_PUNKT_MUN", 	Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("REGION", 			Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("RAION", 			Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("MUN_RAION_OKRUG", 	Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("POSELENIE", 		Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("GOROD", 			Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("NAS_PUNKT", 		Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("TERRITORIYA", 		Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("ULICA_VID", 		Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(20)));
	Результат.Колонки.Добавить("ULICA", 			Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(250)));
	Результат.Колонки.Добавить("DOM_VID", 			Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("DOM", 				Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("STROENIE_VID", 		Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("STROENIE", 			Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("OFIS_VID", 			Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("OFIS", 				Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("PREDSTAVLENIE", 	Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(500)));
	Результат.Колонки.Добавить("ХЭШ_NAS_PUNKT_ADM", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(40)));
	Результат.Колонки.Добавить("ХЭШ_NAS_PUNKT_MUN", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(40)));
	Результат.Колонки.Добавить("ХЭШ", 				Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	
	Возврат Результат;
	
	
КонецФункции

Функция СтруктураРеквизитовАналитики(Аналитика, ПараметрыВыполнения)
	
	Результат = Новый Структура;
	МассивСтрок = ПараметрыВыполнения.ТаблицаРеквизитовАналитик.НайтиСтроки(Новый Структура("Аналитика, Используется", Аналитика, Истина));
	Для Каждого Строка Из МассивСтрок Цикл 
		
		Результат.Вставить(Строка.Реквизит);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура пЗаполнитьЗначенияСвойств(Приемник, Источник)
	
	Для Каждого Элемент Из Источник Цикл
		Если ЗначениеЗаполнено(Элемент.Значение) Или Элемент.Ключ = "NAS_PUNKT_ADM" Или Элемент.Ключ = "NAS_PUNKT_MUN" Или Элемент.Ключ = "ED_IZM" Или Элемент.Ключ = "UCH_NOMER"
			Или Элемент.Ключ = "GLAVA" Или Элемент.Ключ = "KBK"	
			Тогда                  
			Попытка
				Если ТипЗнч(Элемент.Значение) = Тип("Строка") Тогда 
					Приемник[Элемент.Ключ] = СокрЛП(Элемент.Значение);
				Иначе
					Приемник[Элемент.Ключ] = Элемент.Значение;
				КонецЕсли;
			Исключение  
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ЗаписьСобытияВЖурналРегистрации(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке), УровеньЖурналаРегистрации.Ошибка);				
			КонецПопытки;                       
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуИзСтруктуры(СтрокаРезультат, Структура, Разделитель = "")
	
	Для Каждого Элемент Из Структура Цикл
		СтрокаРезультат = СтрокаРезультат + Строка(Элемент.Значение) + Разделитель;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДанныеАналитикВ_МенеджерВТ(СоответствиеПорядковыхНомеров, МенеджерВТ)
	
	ТаблицаАналитик = Новый ТаблицаЗначений;
	
	ТаблицаАналитик.Колонки.Добавить("УИ_Субконто", Новый ОписаниеТипов("УникальныйИдентификатор")); 
	ТаблицаАналитик.Колонки.Добавить("УИ_Субконто_GRAF", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ТаблицаАналитик.Колонки.Добавить("ИмяАналитики", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150)));
	ТаблицаАналитик.Колонки.Добавить("НомерПП", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(150)));
	
	Для Каждого текЭлемент Из СоответствиеПорядковыхНомеров Цикл          
		Если Не Сред(текЭлемент.Ключ, СтрДлина(текЭлемент.Ключ) - 36, 1) = "_" Тогда
			Продолжить;
		КонецЕсли;
		ГУИД = Прав(текЭлемент.Ключ, 36);
		ИмяАналитики = Лев(текЭлемент.Ключ, СтрДлина(текЭлемент.Ключ) - 37);
		новСтрока = ТаблицаАналитик.Добавить();
		Если НЕ Найти(ГУИД, "-") = 0 Тогда 
			новСтрока.УИ_Субконто = Новый УникальныйИдентификатор(ГУИД);
		Иначе
			новСтрока.УИ_Субконто_GRAF = ГУИД;
			ГУИДБезТире = Лев(ГУИД, 32);
			ГУИДСТире = Лев(ГУИДБезТире, 8) + "-" + Сред(ГУИДБезТире, 9, 4) + "-" 
			+ Сред(ГУИДБезТире, 13, 4) + "-" + Сред(ГУИДБезТире, 17, 4) + "-" 
			+ Прав(ГУИДБезТире, 12);
			новСтрока.УИ_Субконто = Новый УникальныйИдентификатор(ГУИДСТире);
		КонецЕсли;	
		новСтрока.ИмяАналитики = ИмяАналитики;
		новСтрока.НомерПП = текЭлемент.Значение;
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВТТаблица.УИ_Субконто КАК УИ_Субконто,
	|	ВТТаблица.УИ_Субконто_GRAF КАК УИ_Субконто_GRAF,
	|	ВТТаблица.ИмяАналитики КАК ИмяАналитики,
	|	ВТТаблица.НомерПП КАК НомерПП
	|ПОМЕСТИТЬ ВТТаблицаНомеровАналитик
	|ИЗ
	|	&Таблица КАК ВТТаблица
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИмяАналитики
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТТаблицаНомеровАналитик.УИ_Субконто КАК УИ_Субконто,
	|	ВТТаблицаНомеровАналитик.УИ_Субконто_GRAF КАК УИ_Субконто_GRAF,
	|	ВТТаблицаНомеровАналитик.ИмяАналитики КАК ИмяАналитики,
	|	ВТТаблицаНомеровАналитик.НомерПП КАК НомерПП
	|ПОМЕСТИТЬ ВТ_ЗначенияАналитик
	|ИЗ
	|	ВТИменаАналитик КАК ВТИменаАналитик
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТТаблицаНомеровАналитик КАК ВТТаблицаНомеровАналитик
	|		ПО (ВТТаблицаНомеровАналитик.ИмяАналитики = ВТИменаАналитик.ИмяАналитики)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВидыСубконтоАналитик КАК ВТ_ВидыСубконтоАналитик
	|		ПО (ВТТаблицаНомеровАналитик.ИмяАналитики = ВТ_ВидыСубконтоАналитик.ИмяАналитики)	
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВидыРасчетовСПрочимиДебиторамиКредиторами.Ссылка),
	|	"""",
	|	""VID_FORM_RASH"",
	|	ПРЕДСТАВЛЕНИЕ(ВидыРасчетовСПрочимиДебиторамиКредиторами.Ссылка)
	|ИЗ
	|	Перечисление.ВидыРасчетовСПрочимиДебиторамиКредиторами КАК ВидыРасчетовСПрочимиДебиторамиКредиторами
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИмяАналитики,
	|	УИ_Субконто
	|"); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Таблица", ТаблицаАналитик);
	Запрос.Выполнить();			
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииКомандПечати

Функция ПечатьПротокола(МассивОбъектов, ПараметрыПечати = Неопределено, ОбъектыПечати = Неопределено) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.КлючПараметровПечати = "ПараметрыПечати_ПротоколВыгрузки";
	
	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	Макет = МодульУправлениеПечатью.МакетПечатнойФормы("Документ.ПакетыДанныхДляМСД.ПФ_MXL_ПротоколВыгрузки");
	
	ОбластьШапка 			=  Макет.ПолучитьОбласть("Шапка");
	ОбластьШапкаОстатки 	=  Макет.ПолучитьОбласть("ШапкаОстатки");
	ОбластьСтрокаОстатки 	=  Макет.ПолучитьОбласть("СтрокаОстатки");
	ОбластьШапкаОбороты 	=  Макет.ПолучитьОбласть("ШапкаОбороты");
	ОбластьСтрокаОбороты 	=  Макет.ПолучитьОбласть("СтрокаОбороты");
	ОбластьШапкаАналитики 	=  Макет.ПолучитьОбласть("ШапкаАналитики");
	ОбластьСтрокаАналитики 	=  Макет.ПолучитьОбласть("СтрокаАналитики");
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ПакетыДанныхДляМСД.Ссылка КАК Ссылка,
	|	ПакетыДанныхДляМСД.ВерсияТаксономии КАК ВерсияТаксономии,
	|	ПакетыДанныхДляМСД.ДатаУтвержденияТаксономии КАК ДатаУтвержденияТаксономии,
	|	ИсторияПроверкиАналитикМСД.ТипЗаписи КАК ТипЗаписи,
	|	ИсторияПроверкиАналитикМСД.КодСчета КАК КодСчета,
	|	ИсторияПроверкиАналитикМСД.ИмяАналитики КАК ИмяАналитики,
	|	ИсторияПроверкиАналитикМСД.ТекстСообщения КАК ОписаниеОшибки,
	|	ИсторияПроверкиАналитикМСД.ДатаПроверки КАК ДатаПроверки
	|ИЗ
	|	РегистрСведений.ИсторияПроверкиАналитикМСД КАК ИсторияПроверкиАналитикМСД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПакетыДанныхДляМСД КАК ПакетыДанныхДляМСД
	|		ПО ИсторияПроверкиАналитикМСД.Документ = ПакетыДанныхДляМСД.Ссылка
	|			И
	|			ПакетыДанныхДляМСД.Ссылка В(&МассивОбъектов)
	|ИТОГИ
	|	МАКСИМУМ(ВерсияТаксономии),
	|	МАКСИМУМ(ДатаУтвержденияТаксономии)
	|ПО
	|	Ссылка,
	|	ТипЗаписи"); 
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Для каждого СсылкаДокумент Из МассивОбъектов Цикл
			
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			ОбластьШапка.Параметры.Документ = Строка(СсылкаДокумент); 
			
			СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумент, "ВерсияТаксономии, ДатаУтвержденияТаксономии");
			ОбластьШапка.Параметры.ВерсияФормата = СтрШаблон("%1 от %2", СтруктураРеквизитов.ВерсияТаксономии, Строка(СтруктураРеквизитов.ДатаУтвержденияТаксономии));
			ТабличныйДокумент.Вывести(ОбластьШапка);
			
			МодульУправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, СсылкаДокумент);
			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЦикла; 
		
	Иначе	
		ВыборкаОбщий = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Отбор = Новый Структура("ТипЗаписи"); 
		
		Пока ВыборкаОбщий.Следующий() Цикл
			
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;			
			ОбластьШапка.Параметры.Документ = Строка(ВыборкаОбщий.Ссылка);
			ОбластьШапка.Параметры.ВерсияФормата = СтрШаблон("%1 от %2", ВыборкаОбщий.ВерсияТаксономии, Строка(ВыборкаОбщий.ДатаУтвержденияТаксономии));
			ТабличныйДокумент.Вывести(ОбластьШапка);
			ВыборкаТипов = ВыборкаОбщий.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			/// аналитики		
			ВыборкаТипов.Сбросить();
			Отбор.ТипЗаписи = Перечисления.ТипыЗаписейМСД.РеквизитыАналитик;
			Если ВыборкаТипов.НайтиСледующий(Отбор) Тогда
				Выборка = ВыборкаТипов.Выбрать();      
				ОбластьШапкаАналитики.Параметры.Количество = Выборка.Количество();
				ТабличныйДокумент.Вывести(ОбластьШапкаАналитики);  
				ТабличныйДокумент.НачатьГруппуСтрок();
				Пока Выборка.Следующий() Цикл
					ОбластьСтрокаАналитики.Параметры.Заполнить(Выборка);
					ТабличныйДокумент.Вывести(ОбластьСтрокаАналитики);
				КонецЦикла;
				Выборка = Неопределено;
				ТабличныйДокумент.ЗакончитьГруппуСтрок();
				
			КонецЕсли;
			/// остатки		
			ВыборкаТипов.Сбросить();
			Отбор.ТипЗаписи = Перечисления.ТипыЗаписейМСД.НачальныйОстаток;
			Если ВыборкаТипов.НайтиСледующий(Отбор) Тогда   
				Выборка = ВыборкаТипов.Выбрать();
				ОбластьШапкаОстатки.Параметры.Период = "начало";
				ОбластьШапкаОстатки.Параметры.Количество = Выборка.Количество();			
				ТабличныйДокумент.Вывести(ОбластьШапкаОстатки); 
				ТабличныйДокумент.НачатьГруппуСтрок();
				
				Пока Выборка.Следующий() Цикл
					ОбластьСтрокаОстатки.Параметры.Заполнить(Выборка);
					ТабличныйДокумент.Вывести(ОбластьСтрокаОстатки);
				КонецЦикла;            
				Выборка = Неопределено;   
				ТабличныйДокумент.ЗакончитьГруппуСтрок();
				
			КонецЕсли;	
			ВыборкаТипов.Сбросить();
			Отбор.ТипЗаписи = Перечисления.ТипыЗаписейМСД.КонечныйОстаток;
			Если ВыборкаТипов.НайтиСледующий(Отбор) Тогда   
				Выборка = ВыборкаТипов.Выбрать();
				ОбластьШапкаОстатки.Параметры.Период = "конец";   
				ОбластьШапкаОстатки.Параметры.Количество = Выборка.Количество();			
				
				ТабличныйДокумент.Вывести(ОбластьШапкаОстатки);
				ТабличныйДокумент.НачатьГруппуСтрок();
				
				Пока Выборка.Следующий() Цикл
					ОбластьСтрокаОстатки.Параметры.Заполнить(Выборка);
					ТабличныйДокумент.Вывести(ОбластьСтрокаОстатки);
				КонецЦикла; 
				Выборка = Неопределено; 
				ТабличныйДокумент.ЗакончитьГруппуСтрок();
				
			КонецЕсли;			
			/// обороты
			ВыборкаТипов.Сбросить();
			Отбор.ТипЗаписи = Перечисления.ТипыЗаписейМСД.Обороты;
			Если ВыборкаТипов.НайтиСледующий(Отбор) Тогда   
				Выборка = ВыборкаТипов.Выбрать();   
				ОбластьШапкаОбороты.Параметры.Количество = Выборка.Количество();			
				ТабличныйДокумент.Вывести(ОбластьШапкаОбороты); 
				ТабличныйДокумент.НачатьГруппуСтрок();
				
				Пока Выборка.Следующий() Цикл
					ОбластьСтрокаОбороты.Параметры.Заполнить(Выборка);
					ТабличныйДокумент.Вывести(ОбластьСтрокаОбороты);
				КонецЦикла;            
				Выборка = Неопределено;
				ТабличныйДокумент.ЗакончитьГруппуСтрок();
				
			КонецЕсли;	
			
			МодульУправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаОбщий.Ссылка);
			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция СформироватьТабличныйДокументПротоколСтраницы(Файл, Документ, ПериодФормат) Экспорт
	
	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
	ДанныеФайла = МодульРаботаСФайлами.ДвоичныеДанныеФайла(Файл, Ложь);
	Если ДанныеФайла <> Неопределено Тогда
		ДанныеФайла.Записать(ИмяФайла);
	КонецЕсли;    
	
	Попытка 
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(ИмяФайла); 
		ОбъектBody = ФабрикаXDTO.ПрочитатьXML(Чтение, ФабрикаXDTO.Тип("MSD_DATA_FHD/VerificationProtocol_1_0_1", "Body"));
	Исключение
		Чтение.Закрыть();
		Попытка  			
			Чтение = Новый ЧтениеXML;
			Чтение.ОткрытьФайл(ИмяФайла);
			ОбъектBody = ФабрикаXDTO.ПрочитатьXML(Чтение, ФабрикаXDTO.Тип("MSD_DATA_FHD/VerificationProtocol", "Body"));	
		Исключение
			Чтение.Закрыть();
			УдалитьФайлы(ИмяФайла);
			ЗаписьЖурналаРегистрации("МСД.ФормированиеПротоколаЗагрузкиПакета", УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки());
			Возврат Неопределено; 	
		КонецПопытки;
	КонецПопытки; 
	
	Чтение.Закрыть();
	УдалитьФайлы(ИмяФайла);
	
	МакетОшибки = ПолучитьМакет("ПФ_MXL_ПротоколЗагрузки_Ошибки");
	МакетПредупреждения = ПолучитьМакет("ПФ_MXL_ПротоколЗагрузки_Предупреждения");
	МакетТранспортнаяИнформация = ПолучитьМакет("ПФ_MXL_ПротоколЗагрузки_ТранспортнаяИнформация");
	
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
	
	ТабличныйДокументОшибки = Новый ТабличныйДокумент; 
	ТабличныйДокументПредупреждения = Новый ТабличныйДокумент;
	ТабличныйДокументТранспортнаяИнформация = Новый ТабличныйДокумент;
	
	ОбластьЗаголовокОшибки = МакетОшибки.ПолучитьОбласть("ЗаголовокОтчета");
	ОбластьЗаголовокПредупреждения = МакетПредупреждения.ПолучитьОбласть("ЗаголовокОтчета");
	ОбластьЗаголовокТранспортнаяИнформация = МакетТранспортнаяИнформация.ПолучитьОбласть("ЗаголовокОтчета");
	
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		ОбластьЗаголовокОшибки.Параметры.Документ = "Документ не сформирован";
		ОбластьЗаголовокПредупреждения.Параметры.Документ = "Документ не сформирован";
		ОбластьЗаголовокТранспортнаяИнформация.Параметры.Документ = "Документ не сформирован";
	Иначе
		ОбластьЗаголовокОшибки.Параметры.Документ = Документ;
		ОбластьЗаголовокПредупреждения.Параметры.Документ = Документ;
		ОбластьЗаголовокТранспортнаяИнформация.Параметры.Документ = Документ; 
		
	КонецЕсли;
	
	ТабличныйДокументОшибки.Вывести(ОбластьЗаголовокОшибки);
	ТабличныйДокументПредупреждения.Вывести(ОбластьЗаголовокПредупреждения);
	ТабличныйДокументТранспортнаяИнформация.Вывести(ОбластьЗаголовокТранспортнаяИнформация);
	
	#Область ИсторияОбработкиПакета
	
	ОбластьЗаголовокИстория = МакетТранспортнаяИнформация.ПолучитьОбласть("ЗаголовокИсторияПакета");
	ТабличныйДокументТранспортнаяИнформация.Вывести(ОбластьЗаголовокИстория);
	
	Если ЕстьСвойствоXDTO(ОбъектBody, "Partition1") Тогда
		
		ТабличныйДокументТранспортнаяИнформация.НачатьГруппуСтрок("История обработки пакетов данных");
		
		ОбластьИД = МакетТранспортнаяИнформация.ПолучитьОбласть("СтрокаИдентификаторПакета");
		
		ОбластьСтрока = МакетТранспортнаяИнформация.ПолучитьОбласть("СтрокаИсторияПакета");
		
		Partition1 = ПроверитьСформироватьСписокXDTO(ОбъектBody.Partition1);
		
		Для каждого текСтрока Из Partition1 Цикл 		 
			
			СведенияОПакете = СтрШаблон(
			"Идентификатор пакета: %1
			|Имя файла: %2",
			текСтрока.GUID,
			текСтрока.FileName);
			
			ДлинаИмени = СтрДлина(текСтрока.FileName);
			
			ЧастиНомера = СтрРазделить(Сред(текСтрока.FileName, ДлинаИмени-8, 5), "-");
			МодульСтроковыеФункцииКлиентСервер = ОбщегоНазначения.ОбщийМодуль("СтроковыеФункцииКлиентСервер");
			
			Если ЧастиНомера.Количество() = 2
				И МодульСтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ЧастиНомера[0])
				И МодульСтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ЧастиНомера[1]) Тогда
				ВсегоФайлов = Число(ЧастиНомера[1]);
				Если ВсегоФайлов > 1 Тогда
					СведенияОПакете = СведенияОПакете + Символы.ПС +
					СтрШаблон("Файл %1 из %2", Число(ЧастиНомера[0]), Число(ЧастиНомера[1]));
				КонецЕсли;
			КонецЕсли;
			
			ОбластьИД.Параметры.УникальныйИдентификатор = СведенияОПакете;
			ТабличныйДокументТранспортнаяИнформация.Вывести(ОбластьИД); 			
			
			ТабличныйДокументТранспортнаяИнформация.НачатьГруппуСтрок("Пакет " + текСтрока.GUID);
			
			Для Каждого текСтрокаDetail Из текСтрока.Details Цикл					
				ОбластьСтрока.Параметры.Дата = текСтрокаDetail.Date;
				ОбластьСтрока.Параметры.Статус = текСтрокаDetail.Status;
				Если  ЕстьСвойствоXDTO(текСтрокаDetail, "StatusMessage") Тогда
					ОбластьСтрока.Параметры.ТекстСообщения = текСтрокаDetail.StatusMessage;
				КонецЕсли;
				ТабличныйДокументТранспортнаяИнформация.Вывести(ОбластьСтрока);
			КонецЦикла;
			ТабличныйДокументТранспортнаяИнформация.Область(ТабличныйДокументТранспортнаяИнформация.ВысотаТаблицы, 1, ТабличныйДокументТранспортнаяИнформация.ВысотаТаблицы, 5).ГраницаСнизу = Линия;
			
			ТабличныйДокументТранспортнаяИнформация.ЗакончитьГруппуСтрок();
			
		КонецЦикла;
		
		ТабличныйДокументТранспортнаяИнформация.ЗакончитьГруппуСтрок();			
		
	КонецЕсли; 
	
	#КонецОбласти
	
	#Область ПроверкаЭлектроннойПодписи
	
	ОбластьЗаголовокЭП = МакетТранспортнаяИнформация.ПолучитьОбласть("ЗаголовокЭП");
	ТабличныйДокументТранспортнаяИнформация.Вывести(ОбластьЗаголовокЭП);
	
	Если ЕстьСвойствоXDTO(ОбъектBody, "Partition2") Тогда
		
		ТабличныйДокументТранспортнаяИнформация.НачатьГруппуСтрок("Проверки электронной подписи"); 
		
		ОбластьСтрока = МакетТранспортнаяИнформация.ПолучитьОбласть("СтрокаЭП");
		ОбластьИД = МакетТранспортнаяИнформация.ПолучитьОбласть("СтрокаИдентификаторПакета");
		
		Partition2 = ПроверитьСформироватьСписокXDTO(ОбъектBody.Partition2);
		
		Для Каждого текСтрока Из Partition2 Цикл 
			
			ОбластьИД.Параметры.УникальныйИдентификатор = текСтрока.GUID;
			ТабличныйДокументТранспортнаяИнформация.Вывести(ОбластьИД);
			
			ТабличныйДокументТранспортнаяИнформация.Область(ТабличныйДокументТранспортнаяИнформация.ВысотаТаблицы, 1, ТабличныйДокументТранспортнаяИнформация.ВысотаТаблицы, 5).ГраницаСнизу = Линия;
			
			ТабличныйДокументТранспортнаяИнформация.НачатьГруппуСтрок("Проверка электронной подписи пакета");
			
			Для Каждого текСтрокаDetails Из текСтрока.Details Цикл
				ОбластьСтрока.Параметры.ДатаПроверки = Формат(текСтрокаDetails.DateInspection, "ДФ=дд.ММ.гггг");
				ОбластьСтрока.Параметры.ИмяФайла = текСтрокаDetails.FileName;
				ОбластьСтрока.Параметры.ИмяФайлаПодписи = текСтрокаDetails.SigFileName;
				ОбластьСтрока.Параметры.ФайлПодписан = текСтрокаDetails.FileSigned; 
				ОбластьСтрока.Параметры.ПодписьДействительна = текСтрокаDetails.SigValid;
				ОбластьСтрока.Параметры.ТекстСообщения = текСтрокаDetails.ErrorDescription;
				ТабличныйДокументТранспортнаяИнформация.Вывести(ОбластьСтрока);
			КонецЦикла;
			ТабличныйДокументТранспортнаяИнформация.ЗакончитьГруппуСтрок(); 		
			
		КонецЦикла;
		
		ТабличныйДокументТранспортнаяИнформация.ЗакончитьГруппуСтрок();			
		
	КонецЕсли;
	
	#КонецОбласти 
	
	#Область Таксономия
	
	Если ЕстьСвойствоXDTO(ОбъектBody, "Partition3") Тогда 		
		
		ОбластьЗаголовокАналитик = МакетОшибки.ПолучитьОбласть("ЗаголовокПроверкаАналитик");
		ТабличныйДокументОшибки.Вывести(ОбластьЗаголовокАналитик);
		
		Partition3 = ПроверитьСформироватьСписокXDTO(ОбъектBody.Partition3);
		
		Для каждого текСтрока Из Partition3 Цикл
			
			Если ЕстьСвойствоXDTO(текСтрока, "BlockingErr") Тогда
				ЗаполнитьОбластьТаксономии(МакетОшибки, ТабличныйДокументОшибки, текСтрока.BlockingErr, "Ошибка");
			КонецЕсли;
			
			ОбластьЗаголовокАналитик = МакетПредупреждения.ПолучитьОбласть("ЗаголовокПроверкаАналитик");
			ТабличныйДокументПредупреждения.Вывести(ОбластьЗаголовокАналитик);
			
			Если ЕстьСвойствоXDTO(текСтрока, "Notifications") Тогда
				ЗаполнитьОбластьТаксономии(МакетПредупреждения, ТабличныйДокументПредупреждения, текСтрока.Notifications, "Предупреждение");
			КонецЕсли; 	
			
		КонецЦикла;
		
	КонецЕсли;				
	
	#КонецОбласти
	
	#Область ПроверкаКонтрольныхСоотношений
	
	Если ЕстьСвойствоXDTO(ОбъектBody, "Partition5") Тогда
		
		//БлокирующиеКС
		ОбластьЗаголовокАналитик = МакетОшибки.ПолучитьОбласть("ЗаголовокПроверкаКС");
		ОбластьЗаголовокАналитик.Параметры.Заголовок = "Проверка блокирующих контрольных соотношений";
		ТабличныйДокументОшибки.Вывести(ОбластьЗаголовокАналитик);
		
		ТабличныйДокументОшибки.НачатьГруппуСтрок("Проверка блокирующих контрольных соотношений");
		
		ЗаполнитьОбластьКС(МакетОшибки, ОбъектBody, ТабличныйДокументОшибки, "Ошибка");
		
		ТабличныйДокументОшибки.ЗакончитьГруппуСтрок();	
		
		//ПредупреждающиеКС
		ОбластьЗаголовокАналитик = МакетПредупреждения.ПолучитьОбласть("ЗаголовокПроверкаКС");
		ОбластьЗаголовокАналитик.Параметры.Заголовок = "Проверка предупреждающих контрольных соотношений";
		ТабличныйДокументПредупреждения.Вывести(ОбластьЗаголовокАналитик);
		
		ТабличныйДокументПредупреждения.НачатьГруппуСтрок("Проверка предупреждающих контрольных соотношений");
		
		ЗаполнитьОбластьКС(МакетПредупреждения, ОбъектBody, ТабличныйДокументПредупреждения, "Предупреждение");
		
		ТабличныйДокументПредупреждения.ЗакончитьГруппуСтрок();
		
	КонецЕсли;
	
	#КонецОбласти 
	
	#Область ПроверкаНСИ
	
	Если ЕстьСвойствоXDTO(ОбъектBody, "Partition4") Тогда
		
		ОбластьЗаголовокНСИ = МакетОшибки.ПолучитьОбласть("ЗаголовокНСИБезЗМ");
		ТабличныйДокументОшибки.Вывести(ОбластьЗаголовокНСИ);
		
		Partition4 = ПроверитьСформироватьСписокXDTO(ОбъектBody.Partition4);
		
		Для каждого текСтрока Из Partition4 Цикл
			
			Если ЕстьСвойствоXDTO(текСтрока, "NoRequestMechanism") Тогда
				ЗаполнитьОбластьНСИ(МакетОшибки, ТабличныйДокументОшибки, текСтрока.NoRequestMechanism);		
			КонецЕсли;
			
			ОбластьЗаголовокНСИ = МакетОшибки.ПолучитьОбласть("ЗаголовокНСИСЗМ");
			ТабличныйДокументОшибки.Вывести(ОбластьЗаголовокНСИ);
			
			Если ЕстьСвойствоXDTO(текСтрока, "RequestMechanism") Тогда
				ЗаполнитьОбластьНСИ(МакетОшибки, ТабличныйДокументОшибки, текСтрока.RequestMechanism);		
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЕсли;
	
	#КонецОбласти 
	
	ТабличныйДокументМассив = Новый Массив;
	ТабличныйДокументМассив.Добавить(Новый Структура("ТабличныйДокумент, ИмяМакета, СинонимМакета", ТабличныйДокументОшибки, "Ошибки", "Ошибки")); 
	ТабличныйДокументМассив.Добавить(Новый Структура("ТабличныйДокумент, ИмяМакета, СинонимМакета", ТабличныйДокументПредупреждения, "Предупреждения", "Предупреждения"));
	ТабличныйДокументМассив.Добавить(Новый Структура("ТабличныйДокумент, ИмяМакета, СинонимМакета", ТабличныйДокументТранспортнаяИнформация, "ТранспортнаяИнформация", "Транспортная информация"));
	Возврат ТабличныйДокументМассив;
	
КонецФункции

Процедура ЗаполнитьОбластьКС(Макет, ОбъектBody, ТабличныйДокумент, Результат)
	
	МассивКодКС = Новый Массив; 
	СообщенияПоКодуКС = Новый Соответствие;
	
	Для Каждого текСтрока Из ОбъектBody.Partition5 Цикл
		Условие = ?(Результат = "Ошибка", текСтрока.isBlockingErr, НЕ текСтрока.isBlockingErr);
		Если Условие Тогда 
			МассивКодКС.Добавить(текСтрока.Code);			
			Сообщения = Новый Массив;			
			Для Каждого СтрокаMessage Из текСтрока.Message Цикл
				Если ЗначениеЗаполнено(СтрокаMessage.DetailErrorDescription) Тогда
					Сообщения.Добавить(СтрокаMessage.DetailErrorDescription);
				КонецЕсли; 
			КонецЦикла;				
			Если Сообщения.Количество() Тогда
				СообщенияПоКодуКС.Вставить(текСтрока.Code, Сообщения);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
	
	Если НЕ МассивКодКС.Количество() Тогда
		Возврат;	
	КонецЕсли;	
	
	ДанныеДляПечатиКС = Справочники.КонтрольныеСоотношенияМСД.ПолучитьДанныеДляПечати(Неопределено, Неопределено, МассивКодКС);	 
	
	ТабличныйДокумент.НачатьГруппуСтрок();
	
	ДополнительныеПараметры = Справочники.КонтрольныеСоотношенияМСД.ПолучитьДополнительныеПараметрыПроверки();
	ДополнительныеПараметры.Результат = Результат; 
	ДополнительныеПараметры.СообщенияПоКодуКС = СообщенияПоКодуКС;
	
	Если ДанныеДляПечатиКС.Строки.Количество() Тогда
		Для Каждого ДанныеВидКС Из ДанныеДляПечатиКС.Строки Цикл			
			ЭтоФЛК = (ДанныеВидКС.ВидКонтрольногоСоотношения = "ФЛК");			
			ОбластьСтрока = ?(ЭтоФЛК, Макет.ПолучитьОбласть("СтрокаФЛК"), Макет.ПолучитьОбласть("СтрокаДок")); 
			ДополнительныеПараметры.ЭтоФЛК = ЭтоФЛК;
			Справочники.КонтрольныеСоотношенияМСД.ВывестиДанныеВТабличныйДокумент(ДанныеВидКС, ОбластьСтрока, Макет, ТабличныйДокумент, ДополнительныеПараметры);				
		КонецЦикла; 
	Иначе
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
		
		ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаКС");
		ОбластьТекстСообщения = Макет.ПолучитьОбласть("ТекстСообщенияКС");
		
		Для Каждого текСтрока Из ОбъектBody.Partition5 Цикл
			Условие = ?(Результат = "Ошибка", текСтрока.isBlockingErr, НЕ текСтрока.isBlockingErr);
			Если Условие Тогда
				ОбластьСтрока.Параметры.Наименование = текСтрока.Name;
				Если ЗначениеЗаполнено(текСтрока.Description) Тогда
					ОбластьСтрока.Параметры.Наименование = СтрШаблон("%1: %2", текСтрока.Name, текСтрока.Description);
				КонецЕсли;
				ОбластьСтрока.Параметры.Код = текСтрока.Code;
				ОбластьСтрока.Параметры.Результат = Результат; 
				ТабличныйДокумент.Вывести(ОбластьСтрока); 
				
				ТабличныйДокумент.НачатьГруппуСтрок(текСтрока.Name);				
				Для Каждого СтрокаMessage Из текСтрока.Message Цикл
					ОбластьТекстСообщения.Параметры.ТекстСообщения = СтрокаMessage.DetailErrorDescription; 
					ТабличныйДокумент.Вывести(ОбластьТекстСообщения);
				КонецЦикла;	
				ТабличныйДокумент.ЗакончитьГруппуСтрок();	
			КонецЕсли;
			ТабличныйДокумент.Область(ТабличныйДокумент.ВысотаТаблицы, 1, ТабличныйДокумент.ВысотаТаблицы, 5).ГраницаСнизу = Линия;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры	

Функция ЕстьСвойствоXDTO(ОбъектXDTO, ИмяСвойства)
	
	Возврат ОбъектXDTO.Свойства().Получить(ИмяСвойства) <> Неопределено;
	
КонецФункции 

#КонецОбласти

Функция ПроверитьСформироватьСписокXDTO(СписокXDTO)
	
	Результат = Новый Массив;
	Если ТипЗнч(СписокXDTO) = Тип("СписокXDTO") Тогда
		Результат = СписокXDTO;
	Иначе
		Результат.Добавить(СписокXDTO);		 
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьОбластьНСИ(Макет, ТабличныйДокумент, СписокXDTO)
	
	ТабличныйДокумент.НачатьГруппуСтрок("Проверка нормативно-справочной информации");
	
	ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаНСИ");
	ОбластьТекстСообщения = Макет.ПолучитьОбласть("ТекстСообщенияНСИ");
	
	
	Для каждого текНСИ ИЗ СписокXDTO Цикл 
		
		ПредыдущееЗначение = "";	
		
		Для каждого текСтрока ИЗ текНСИ.NSI Цикл
			Если НЕ ПредыдущееЗначение = текСтрока.ClassifierName Тогда
				ПредыдущееЗначение = текСтрока.ClassifierName;
				ОбластьСтрока.Параметры.ИдентификаторОбъектаНСИ = текСтрока.ClassifierName;
				ОбластьСтрока.Параметры.Результат = "Ошибка";
				ТабличныйДокумент.Вывести(ОбластьСтрока);
			КонецЕсли;	
			ОбластьТекстСообщения.Параметры.Значение = текСтрока.Value; 
			ОбластьТекстСообщения.Параметры.ТекстСообщения = текСтрока.DetailErrorDescription;						
			ТабличныйДокумент.Вывести(ОбластьТекстСообщения);					
		КонецЦикла;
		
	КонецЦикла;
	
	ТабличныйДокумент.ЗакончитьГруппуСтрок();
	
КонецПроцедуры	

Процедура ЗаполнитьОбластьТаксономии(Макет, ТабличныйДокумент, СписокXDTO, Результат)
	
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
	
	ТабличныйДокумент.НачатьГруппуСтрок("Проверка аналитик");
	
	ОбластьТипЗаписи		= Макет.ПолучитьОбласть("СтрокаТипЗаписи");
	ОбластьСтрока			= Макет.ПолучитьОбласть("СтрокаАналитика");
	ОбластьСтрокаСообщение	= Макет.ПолучитьОбласть("СтрокаСообщениеАналитика");	
	
	Для каждого СтрокаPart3 ИЗ СписокXDTO Цикл
		
		ОбластьТипЗаписи.Параметры.ТипЗаписи = СтрокаPart3.DataType;
		ТабличныйДокумент.Вывести(ОбластьТипЗаписи);
		
		ТабличныйДокумент.НачатьГруппуСтрок("Проверка аналитик - " + СтрокаPart3.DataType);
		
		Account = ПроверитьСформироватьСписокXDTO(СтрокаPart3.Account);
		
		Для каждого СтрокаAccount ИЗ Account Цикл
			
			НомерСтроки = ТабличныйДокумент.ВысотаТаблицы;
			
			RecordAnalytics = ПроверитьСформироватьСписокXDTO(СтрокаAccount.RecordAnalytics);
			
			Для каждого СтрокаRecordAnalytics ИЗ  RecordAnalytics Цикл
				
				ОбластьСтрока.Параметры.КодСчета = СтрокаAccount.AccountCode; 
				ОбластьСтрока.Параметры.Результат = Результат;
				ОбластьСтрока.Параметры.ИмяАналитики = СтрШаблон("Проверка на заполнение обязательной аналитики ""%1""", СтрокаRecordAnalytics.AnalyticName);
				ТабличныйДокумент.Вывести(ОбластьСтрока);
				
				Message = ПроверитьСформироватьСписокXDTO(СтрокаRecordAnalytics.Message);
				
				Если Message.Количество() > 0 Тогда
					
					ТабличныйДокумент.НачатьГруппуСтрок();
					
					Для каждого СтрокаMessage ИЗ Message Цикл
						
						ОбластьСтрокаСообщение.Параметры.ТекстСообщения = СтрокаMessage.DetailErrorDescription;
						ТабличныйДокумент.Вывести(ОбластьСтрокаСообщение);  
						
					КонецЦикла;
					
					ТабличныйДокумент.ЗакончитьГруппуСтрок();
					
				КонецЕсли;
				
			КонецЦикла;
			
			ТабличныйДокумент.Область(НомерСтроки+1, 1, ТабличныйДокумент.ВысотаТаблицы, 1).Объединить();
			ТабличныйДокумент.Область(ТабличныйДокумент.ВысотаТаблицы, 1, ТабличныйДокумент.ВысотаТаблицы, 5).ГраницаСнизу = Линия;
			
		КонецЦикла;
		
		ТабличныйДокумент.ЗакончитьГруппуСтрок();
		
	КонецЦикла;
	
	ТабличныйДокумент.ЗакончитьГруппуСтрок();
	
КонецПроцедуры	  

