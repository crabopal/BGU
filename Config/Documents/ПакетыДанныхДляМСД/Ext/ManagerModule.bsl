Функция Обороты_ПолучитьСоединенияВТСтоимостьОбъектовОС(Суффикс, ПараметрыВыполнения)
	
	БазовыеУсловияСоединения = "(НЕ ВТОбороты_Общие_Предварительно.Счет%Суффикс В ИЕРАРХИИ (&СчетаИсключенияОС))
	|			И ВТОбороты_Общие_Предварительно.Амортизация%Суффикс = ВТОборотыОС_ПоИнвентарным_%ИмяВТ%Суффикс.Амортизация
	|			И ВТОбороты_Общие_Предварительно.Обесценение%Суффикс = ВТОборотыОС_ПоИнвентарным_%ИмяВТ%Суффикс.Обесценение
	|			И ВТОбороты_Общие_Предварительно.Период = ВТОборотыОС_ПоИнвентарным_%ИмяВТ%Суффикс.Период
	|			И (ВТОбороты_Общие_Предварительно.Регистратор = ВТОборотыОС_ПоИнвентарным_%ИмяВТ%Суффикс.Регистратор
	|			ИЛИ ВТОборотыОС_ПоИнвентарным_%ИмяВТ%Суффикс.Регистратор ССЫЛКА Документ.КорректировкаРегистров)
	|			И ВТОбороты_Общие_Предварительно.Счет%Суффикс.Забалансовый = ВТОборотыОС_ПоИнвентарным_%ИмяВТ%Суффикс.Забаланс
	|			И (" + ?(Суффикс = "Кт", "", "НЕ") + " ВТОборотыОС_ПоИнвентарным_%ИмяВТ%Суффикс.ЭтоРасход)
	|			И ВТОбороты_Общие_Предварительно.КодВерхнегоУровня%Суффикс = ВТОборотыОС_ПоИнвентарным_%ИмяВТ%Суффикс.Счет
	|			И ВТОбороты_Общие_Предварительно.ОС_%Суффикс = ВТОборотыОС_ПоИнвентарным_%ИмяВТ%Суффикс.ОсновноеСредство";  
	
	БазовыеУсловияСоединенияДвиженияБУДоков = СтрЗаменить(БазовыеУсловияСоединения, "ВТОборотыОС_ПоИнвентарным_", "ДвиженияБУДоковОбработанная_");
	БазовыеУсловияСоединенияДвиженияБУДоков = БазовыеУсловияСоединенияДвиженияБУДоков + "
	|			И ВТОбороты_Общие_Предварительно.ПолучитьИнвНомер";
	
	ТекстСоединения = "ЛЕВОЕ СОЕДИНЕНИЕ ВТОборотыОС_ПоИнвентарным_АмортОбесц КАК ВТОборотыОС_ПоИнвентарным_АмортОбесц%Суффикс
	|		ПО " + ?(Суффикс = "Кт", СтрЗаменить(СтрЗаменить(БазовыеУсловияСоединения, "%ИмяВТ", "АмортОбесц"), "( ВТОборотыОС_ПоИнвентарным_АмортОбесц%Суффикс.ЭтоРасход)","
	|			ВЫБОР КОГДА ВТОбороты_Общие_Предварительно.АмортизацияКт И ВТОбороты_Общие_Предварительно.Сумма < 0 
	|				ТОГДА (НЕ ВТОборотыОС_ПоИнвентарным_АмортОбесцКт.ЭтоРасход)
	|				КОГДА ВТОборотыОС_ПоИнвентарным_АмортОбесцКт.Регистратор ССЫЛКА Документ.КорректировкаРегистров 
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ (ВТОборотыОС_ПоИнвентарным_АмортОбесцКт.ЭтоРасход)
	|			КОНЕЦ"), СтрЗаменить(БазовыеУсловияСоединения, "%ИмяВТ", "АмортОбесц")) + " 
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОборотыОС_ПоИнвентарным_НетЦМОДогКон КАК ВТОборотыОС_ПоИнвентарным_НетЦМОДогКон%Суффикс
	|		ПО " + СтрЗаменить(БазовыеУсловияСоединения, "%ИмяВТ", "НетЦМОДогКон") + "
	|			И (НЕ ВТОбороты_Общие_Предварительно.ЕстьЦМО_%Суффикс И НЕ ВТОбороты_Общие_Предварительно.ЕстьДоговоры_%Суффикс И НЕ ВТОбороты_Общие_Предварительно.ЕстьКонтрагенты_%Суффикс)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДвиженияБУДоковОбработанная_АмортОбесц КАК ДвиженияБУДоковОбработанная_АмортОбесц%Суффикс
	|		ПО " + СтрЗаменить(БазовыеУсловияСоединенияДвиженияБУДоков, "%ИмяВТ", "АмортОбесц") + "
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДвиженияБУДоковОбработанная_НетЦМОДогКон КАК ДвиженияБУДоковОбработанная_НетЦМОДогКон%Суффикс
	|		ПО " + СтрЗаменить(БазовыеУсловияСоединенияДвиженияБУДоков, "%ИмяВТ", "НетЦМОДогКон") + "
	|			И (НЕ ВТОбороты_Общие_Предварительно.ЕстьЦМО_%Суффикс И НЕ ВТОбороты_Общие_Предварительно.ЕстьДоговоры_%Суффикс И НЕ ВТОбороты_Общие_Предварительно.ЕстьКонтрагенты_%Суффикс)";

	Для каждого СтрокаМассива Из ПараметрыВыполнения.МассивСрезСубконто Цикл
		ИмяВТ = "Есть" + ?(СтрокаМассива.ЕстьЦМО, "ЦМО", "") + ?(СтрокаМассива.ЕстьДоговоры, "Дог", "") + ?(СтрокаМассива.ЕстьКонтрагенты, "Кон", ""); 
		ТекстСоединения = ТекстСоединения + "
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОборотыОС_ПоИнвентарным_" + ИмяВТ + " КАК ВТОборотыОС_ПоИнвентарным_" + ИмяВТ + Суффикс + "
		|		ПО " + СтрЗаменить(БазовыеУсловияСоединения, "%ИмяВТ", ИмяВТ) + "
		|			И (" 
		+ ?(СтрокаМассива.ЕстьЦМО, "ВТОбороты_Общие_Предварительно.ЦМО_%Суффикс = ВТОборотыОС_ПоИнвентарным_" + ИмяВТ + Суффикс + ".ЦМО И ", "НЕ ") + "ВТОбороты_Общие_Предварительно.ЕстьЦМО_%Суффикс И " 
		+ ?(СтрокаМассива.ЕстьДоговоры, "ВТОбороты_Общие_Предварительно.Договоры_%Суффикс = ВТОборотыОС_ПоИнвентарным_" + ИмяВТ + Суффикс + ".Договор И ", "НЕ ") + "ВТОбороты_Общие_Предварительно.ЕстьДоговоры_%Суффикс И " 
		+ ?(СтрокаМассива.ЕстьКонтрагенты, "ВТОбороты_Общие_Предварительно.Контрагенты_%Суффикс = ВТОборотыОС_ПоИнвентарным_" + ИмяВТ + Суффикс + ".Контрагент И ", "НЕ ") + "ВТОбороты_Общие_Предварительно.ЕстьКонтрагенты_%Суффикс)";
		
		ТекстСоединения = ТекстСоединения + "
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДвиженияБУДоковОбработанная_" + ИмяВТ + " КАК ДвиженияБУДоковОбработанная_" + ИмяВТ + Суффикс + "
		|		ПО " + СтрЗаменить(БазовыеУсловияСоединенияДвиженияБУДоков, "%ИмяВТ", ИмяВТ) + "
		|			И (" 
		+ ?(СтрокаМассива.ЕстьЦМО, "ВТОбороты_Общие_Предварительно.ЦМО_%Суффикс = ДвиженияБУДоковОбработанная_" + ИмяВТ + Суффикс + ".ЦМО И ", "НЕ ") + "ВТОбороты_Общие_Предварительно.ЕстьЦМО_%Суффикс И " 
		+ ?(СтрокаМассива.ЕстьДоговоры, "ВТОбороты_Общие_Предварительно.Договоры_%Суффикс = ДвиженияБУДоковОбработанная_" + ИмяВТ + Суффикс + ".Договор И ", "НЕ ") + "ВТОбороты_Общие_Предварительно.ЕстьДоговоры_%Суффикс И " 
		+ ?(СтрокаМассива.ЕстьКонтрагенты, "ВТОбороты_Общие_Предварительно.Контрагенты_%Суффикс = ДвиженияБУДоковОбработанная_" + ИмяВТ + Суффикс + ".Контрагент И ", "НЕ ") + "ВТОбороты_Общие_Предварительно.ЕстьКонтрагенты_%Суффикс)";
	КонецЦикла;	
	ТекстСоединения = СтрЗаменить(ТекстСоединения, "%Суффикс", Суффикс);
	Возврат ТекстСоединения;
	
КонецФункции

Функция Обороты_ПолучитьПолеВыбораВТСтоимостьОбъектовОС(Суффикс, ОсновноеПоле, ВспомогательноеПоле, ПараметрыВыполнения, Минус = Ложь)
		
	ТекстПоляВыбора = "ВЫБОР
	|					КОГДА ВТОбороты_Общие_Предварительно.Амортизация%Суффикс ИЛИ ВТОбороты_Общие_Предварительно.Обесценение%Суффикс ТОГДА" + 
	?(ОсновноеПоле = "ИнвентарныйНомер", "
	|						ВЫБОР КОГДА ВТОборотыОС_ПоИнвентарным_АмортОбесц%Суффикс.%ОсновноеПоле ЕСТЬ NULL 
	|							ИЛИ ВТОборотыОС_ПоИнвентарным_АмортОбесц%Суффикс.%ОсновноеПоле = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) ТОГДА
	|								ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле
	|						ИНАЧЕ ВТОборотыОС_ПоИнвентарным_АмортОбесц%Суффикс.%ОсновноеПоле КОНЕЦ", 
	?(ОсновноеПоле = "СтоимостьОборот" И Суффикс = "Кт", "
	|						ВЫБОР КОГДА ЕСТЬNULL(" + ?(Минус, "-", "") + "ВТОборотыОС_ПоИнвентарным_АмортОбесц%Суффикс.%ОсновноеПоле, ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле) < 0 
	|							И ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле < 0
	|						ТОГДА
	|							ВЫБОР КОГДА -ЕСТЬNULL(" + ?(Минус, "-", "") + "ВТОборотыОС_ПоИнвентарным_АмортОбесц%Суффикс.%ОсновноеПоле, ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле) <= -ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле
	|								ТОГДА ЕСТЬNULL(" + ?(Минус, "-", "") + "ВТОборотыОС_ПоИнвентарным_АмортОбесц%Суффикс.%ОсновноеПоле, ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле)
	|							ИНАЧЕ ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле 
	|							КОНЕЦ
	|						ИНАЧЕ 
	|							ВЫБОР КОГДА ЕСТЬNULL(" + ?(Минус, "-", "") + "ВТОборотыОС_ПоИнвентарным_АмортОбесц%Суффикс.%ОсновноеПоле, ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле) <= ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле
	|								ТОГДА ЕСТЬNULL(" + ?(Минус, "-", "") + "ВТОборотыОС_ПоИнвентарным_АмортОбесц%Суффикс.%ОсновноеПоле, ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле)
	|							ИНАЧЕ ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле
	|							КОНЕЦ
	|						КОНЕЦ", "
	|						ЕСТЬNULL(" + ?(Минус, "-", "") + "ВТОборотыОС_ПоИнвентарным_АмортОбесц%Суффикс.%ОсновноеПоле, ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле)")) + "	 
	|					КОГДА НЕ ВТОбороты_Общие_Предварительно.ЕстьЦМО_%Суффикс И НЕ ВТОбороты_Общие_Предварительно.ЕстьДоговоры_%Суффикс И НЕ ВТОбороты_Общие_Предварительно.ЕстьКонтрагенты_%Суффикс ТОГДА" + 
	?(ОсновноеПоле = "ИнвентарныйНомер", "
	|						ВЫБОР КОГДА ВТОборотыОС_ПоИнвентарным_НетЦМОДогКон%Суффикс.%ОсновноеПоле ЕСТЬ NULL 
	|							ИЛИ ВТОборотыОС_ПоИнвентарным_НетЦМОДогКон%Суффикс.%ОсновноеПоле = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) ТОГДА
	|								ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле
	|						ИНАЧЕ ВТОборотыОС_ПоИнвентарным_НетЦМОДогКон%Суффикс.%ОсновноеПоле КОНЕЦ", "
	|						ЕСТЬNULL(" + ?(Минус, "-", "") + "ВТОборотыОС_ПоИнвентарным_НетЦМОДогКон%Суффикс.%ОсновноеПоле, ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле)");
	
	Для каждого СтрокаМассива Из ПараметрыВыполнения.МассивСрезСубконто Цикл
		ИмяВТ = "Есть" + ?(СтрокаМассива.ЕстьЦМО, "ЦМО", "") + ?(СтрокаМассива.ЕстьДоговоры, "Дог", "") + ?(СтрокаМассива.ЕстьКонтрагенты, "Кон", ""); 
		ТекстПоляВыбора = ТекстПоляВыбора + "
		|					КОГДА " + ?(СтрокаМассива.ЕстьЦМО, "", "НЕ ") + "ВТОбороты_Общие_Предварительно.ЕстьЦМО_%Суффикс И " + ?(СтрокаМассива.ЕстьДоговоры, "", "НЕ ") + "ВТОбороты_Общие_Предварительно.ЕстьДоговоры_%Суффикс И " + ?(СтрокаМассива.ЕстьКонтрагенты, "", "НЕ ") + "ВТОбороты_Общие_Предварительно.ЕстьКонтрагенты_%Суффикс ТОГДА" + 
		?(ОсновноеПоле = "ИнвентарныйНомер", "
		|						ВЫБОР КОГДА ВТОборотыОС_ПоИнвентарным_" + ИмяВТ + Суффикс + ".%ОсновноеПоле ЕСТЬ NULL 
		|							ИЛИ ВТОборотыОС_ПоИнвентарным_" + ИмяВТ + Суффикс + ".%ОсновноеПоле = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) ТОГДА
		|								ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле
		|						ИНАЧЕ ВТОборотыОС_ПоИнвентарным_" + ИмяВТ + Суффикс + ".%ОсновноеПоле КОНЕЦ", "
		|						ЕСТЬNULL(" + ?(Минус, "-", "") + "ВТОборотыОС_ПоИнвентарным_" + ИмяВТ + Суффикс + ".%ОсновноеПоле, ВТОбороты_Общие_Предварительно.%ВспомогательноеПоле)");		
	КонецЦикла;		
	ТекстПоляВыбора = ТекстПоляВыбора + "
	|					КОНЕЦ";
	ТекстПоляВыбора = СтрЗаменить(ТекстПоляВыбора, "%ОсновноеПоле", ОсновноеПоле);
	ТекстПоляВыбора = СтрЗаменить(ТекстПоляВыбора, "%ВспомогательноеПоле", ВспомогательноеПоле);
	ТекстПоляВыбора = СтрЗаменить(ТекстПоляВыбора, "%Суффикс", Суффикс);
	
	ТекстПоляВыбораДвиженияБУДоков = СтрЗаменить(СтрЗаменить(ТекстПоляВыбора, "ВТОборотыОС_ПоИнвентарным_", "ДвиженияБУДоковОбработанная_"), "-", "");
	
	ТекстПоляРезультат = "ВЫБОР
	|					КОГДА ВТОбороты_Общие_Предварительно.ПолучитьИнвНомер ТОГДА
	|						" + ТекстПоляВыбораДвиженияБУДоков + " 
	|					ИНАЧЕ " + ТекстПоляВыбора + " КОНЕЦ";
		
	Возврат ТекстПоляРезультат;
	
КонецФункции

Функция Обороты_УничтожитьТаблицыСтоимостьОС(ПараметрыВыполнения) 
	
	ТекстЗапроса = "
	|УНИЧТОЖИТЬ Регистраторы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ДвиженияРН_ЕстьЦМОДогКон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ДвиженияРН_НетЦМОДогКон
