	|	ВТОстаткиБезСубконто4.Субконто11 КАК Субконто11,
	|	ВТОстаткиБезСубконто4.Субконто21 КАК Субконто21,
	|	ВТОстаткиБезСубконто4.Субконто31 КАК Субконто31,
	|	ЕСТЬNULL(ЕСТЬNULL(Договоры.Контрагент, ОбъектыФинансовыхВложений.Контрагент), ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Субконто41,
	| 	ВТОстаткиБезСубконто4.ДоговорСоединение КАК Договор,
	| 	ДоговорыСоединение.Контрагент = ЕСТЬNULL(ЕСТЬNULL(Договоры.Контрагент, ОбъектыФинансовыхВложений.Контрагент), ВТОстаткиБезСубконто4.КонтрагентСоединение) КАК ПолучитьGRAF_ISP,
	|	ВТОстаткиБезСубконто4.УИ_Организации КАК УИ_Организации,
	|	ВТОстаткиБезСубконто4.ВидСубконто1 КАК ВидСубконто1,
	|	ВТОстаткиБезСубконто4.ВидСубконто2 КАК ВидСубконто2,
	|	ВТОстаткиБезСубконто4.ВидСубконто3 КАК ВидСубконто3,
	|	ВТОстаткиБезСубконто4.ВидСубконто4 КАК ВидСубконто4,
	|	ВТОстаткиБезСубконто4.НомерСтроки
	|ПОМЕСТИТЬ %ИмяОстатки
	|ИЗ
	|	%ИмяОстаткиБезСубконто4_НомерСтроки КАК ВТОстаткиБезСубконто4
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
	|		ПО (ВТОстаткиБезСубконто4.ТребуетсяСубконто4)
	|			И ВТОстаткиБезСубконто4.Договор = Договоры.Ссылка
	| 		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК ДоговорыСоединение
	| 		ПО ВТОстаткиБезСубконто4.ДоговорСоединение = ДоговорыСоединение.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыФинансовыхВложений КАК ОбъектыФинансовыхВложений
	|		ПО (ВТОстаткиБезСубконто4.ТребуетсяСубконто4)
	|			И ВТОстаткиБезСубконто4.ОбъектыФВ = ОбъектыФинансовыхВложений.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Аналитика1,
	|	Аналитика2,
	|	Аналитика3,
	|	Аналитика4,
	|	Аналитика5,
	|	Аналитика6,
	|	ВидСубконто1,
	|	Субконто1,
	|	ВидСубконто2,
	|	Субконто2,
	|	ВидСубконто3,
	|	Субконто3,
	|	ВидСубконто4,
	|	Субконто4,
	|	УИ_Организации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	| УНИЧТОЖИТЬ %ИмяОстаткиБезСубконто4_НомерСтроки		
	|;
	|////////////////////////////////////////////////////////////////////////////////"; 
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса ,"%ИмяОстаткиПредварительно" , ИмяОстаткиПредварительно); 
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса ,"%ИмяОстаткиБезСубконто4" , ИмяОстаткиБезСубконто4);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса ,"%ИмяОстатки" , ИмяОстатки);
	
	Возврат ТекстЗапроса;

КонецФункции	

Функция ПолучитьТекстЗапросаПерезагружаемыеПериоды(ПараметрыВыполнения)
	
	ТекстЗапроса = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(ПакетыДанныхДляМСД.НачалоПериода, ДЕНЬ) КАК НачалоПериода,
	|	КОНЕЦПЕРИОДА(ПакетыДанныхДляМСД.ОкончаниеПериода, ДЕНЬ) КАК ОкончаниеПериода,
	|	ПакетыДанныхДляМСД.ВидПередаваемыхДанных КАК ВидПередаваемыхДанных,
	|	МАКСИМУМ(ПакетыДанныхМСД.ДатаФормирования) КАК ДатаФормирования
	|ПОМЕСТИТЬ ВТ_ОтправленныеПакеты
	|ИЗ
	|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПакетыДанныхДляМСД КАК ПакетыДанныхДляМСД
	|		ПО ПакетыДанныхМСД.Пакет = ПакетыДанныхДляМСД.Ссылка
	|ГДЕ
	|	НЕ ПакетыДанныхМСД.Статус В (&СтатусСформирован)
	|	И ПакетыДанныхДляМСД.ОкончаниеПериода > &ОкончаниеПериода
	|	И НЕ ПакетыДанныхДляМСД.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ПакетыДанныхДляМСД.НачалоПериода, ДЕНЬ),
	|	КОНЕЦПЕРИОДА(ПакетыДанныхДляМСД.ОкончаниеПериода, ДЕНЬ),
	|	ПакетыДанныхДляМСД.ВидПередаваемыхДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ОтправленныеПакеты.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ПакетыДанныхМСД.Пакет КАК Пакет,
	|	МАКСИМУМ(ПакетыДанныхМСД.Период) КАК Период,
	|	ВТ_ОтправленныеПакеты.ВидПередаваемыхДанных КАК ВидПередаваемыхДанных
	|ПОМЕСТИТЬ ВТ_СтатусПакетаСрез
	|ИЗ
	|	ВТ_ОтправленныеПакеты КАК ВТ_ОтправленныеПакеты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПакетыДанныхДляМСД КАК ПакетыДанныхДляМСД
	|			ПО ПакетыДанныхМСД.Пакет = ПакетыДанныхДляМСД.Ссылка
	|		ПО (ВТ_ОтправленныеПакеты.НачалоПериода = НАЧАЛОПЕРИОДА(ПакетыДанныхДляМСД.НачалоПериода, ДЕНЬ))
	|			И (ВТ_ОтправленныеПакеты.ОкончаниеПериода = КОНЕЦПЕРИОДА(ПакетыДанныхДляМСД.ОкончаниеПериода, ДЕНЬ))
	|			И (ВТ_ОтправленныеПакеты.ВидПередаваемыхДанных = ПакетыДанныхДляМСД.ВидПередаваемыхДанных)
	|			И ВТ_ОтправленныеПакеты.ДатаФормирования = ПакетыДанныхМСД.ДатаФормирования
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОтправленныеПакеты.ОкончаниеПериода,
	|	ПакетыДанныхМСД.Пакет,
	|	ВТ_ОтправленныеПакеты.ВидПередаваемыхДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВТ_СтатусПакетаСрез.ОкончаниеПериода КАК ОкончаниеПериода,
	|	МЕСЯЦ(ВТ_СтатусПакетаСрез.ОкончаниеПериода) КАК Месяц,
	|	ВТ_СтатусПакетаСрез.ВидПередаваемыхДанных КАК ВидПередаваемыхДанных
	|ПОМЕСТИТЬ ВТ_ОкончаниеПериода
	|ИЗ
	|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СтатусПакетаСрез КАК ВТ_СтатусПакетаСрез
	|		ПО (ВТ_СтатусПакетаСрез.Пакет = ПакетыДанныхМСД.Пакет)
	|			И (ВТ_СтатусПакетаСрез.Период = ПакетыДанныхМСД.Период)
	|ГДЕ
	|	ПакетыДанныхМСД.Статус В(&СтатусПринят)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОкончаниеПериода.Месяц КАК Месяц,
	|	МАКСИМУМ(ВТ_ОкончаниеПериода.ОкончаниеПериода) КАК ОкончаниеПериода,
	|	МАКСИМУМ(ВТ_ОкончаниеПериода.ВидПередаваемыхДанных) КАК ВидПередаваемыхДанных
	|ПОМЕСТИТЬ ВТ_ОкончаниеПериодаГруппировка
	|ИЗ
	|	ВТ_ОкончаниеПериода КАК ВТ_ОкончаниеПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОкончаниеПериода.Месяц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОкончаниеПериодаГруппировка.Месяц КАК Месяц,
	|	ВТ_ОкончаниеПериода.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ВТ_ОкончаниеПериода.ВидПередаваемыхДанных КАК ВидПередаваемыхДанных
	|ИЗ
	|	ВТ_ОкончаниеПериодаГруппировка КАК ВТ_ОкончаниеПериодаГруппировка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОкончаниеПериода КАК ВТ_ОкончаниеПериода
	|		ПО ВТ_ОкончаниеПериодаГруппировка.ВидПередаваемыхДанных = ВТ_ОкончаниеПериода.ВидПередаваемыхДанных
	|			И (ВЫБОР
	|				КОГДА ВТ_ОкончаниеПериодаГруппировка.ВидПередаваемыхДанных
	|					ТОГДА ВТ_ОкончаниеПериодаГруппировка.ОкончаниеПериода = ВТ_ОкончаниеПериода.ОкончаниеПериода
	|				ИНАЧЕ ВТ_ОкончаниеПериодаГруппировка.Месяц = ВТ_ОкончаниеПериода.Месяц
	|			КОНЕЦ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Месяц,
	|	ОкончаниеПериода";
	
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ПараметрыВыполнения.ОкончаниеПериода));
	
	МассивСтатусПринят = Новый Массив;
	МассивСтатусПринят.Добавить(Перечисления.СтатусыПакетовМСД.Принят);
	МассивСтатусПринят.Добавить(Перечисления.СтатусыПакетовМСД.ПринятСПредупреждениями);
	МассивСтатусПринят.Добавить(Перечисления.СтатусыПакетовМСД.ПринятДанныеОтсутствуют);
	
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	
	Запрос.УстановитьПараметр("СтатусПринят", МассивСтатусПринят);
	Запрос.УстановитьПараметр("СтатусСформирован", МодульОбщегоНазначенияКлиентСервер.МассивЗначений(Перечисления.СтатусыПакетовМСД.Сформирован, Перечисления.СтатусыПакетовМСД.Формирование));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ТекстЗапроса;	
	КонецЕсли;	
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(); 
	
	ДополнительныеПараметрыОстатки = Новый Структура;
	ДополнительныеПараметрыОстатки.Вставить("ПерезагружаемыеПериоды", Истина);
	ДополнительныеПараметрыОстатки.Вставить("ПараметрыВыполнения", ПараметрыВыполнения);
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ФорматДатыСтрока = Формат(ВыборкаДетальныеЗаписи.ОкончаниеПериода, "ДФ=ггггММдд");
		ИмяВТ = "ВТ_" + ФорматДатыСтрока;
		ИмяПараметрДата = "ПараметрДата_" + ФорматДатыСтрока;
		
		ПостфиксПараметра = "";
		Если КонецДня(ВыборкаДетальныеЗаписи.ОкончаниеПериода) = КонецГода(ВыборкаДетальныеЗаписи.ОкончаниеПериода) Тогда
			ПостфиксПараметра = "Граница";
			ПерезагружаемыйПериод = ПолучитьСтруктуруПерезагружаемыйПериод();
			ПерезагружаемыйПериод.ИмяВТ = ИмяВТ;
			ПерезагружаемыйПериод.ИмяПараметрДата = ИмяПараметрДата + ПостфиксПараметра;
			ПерезагружаемыйПериод.ОкончаниеПериода = Новый Граница(Новый МоментВремениСУточнениемПериода(КонецДня(ВыборкаДетальныеЗаписи.ОкончаниеПериода), 1), ВидГраницы.Включая);
			ПерезагружаемыйПериод.ЭтоГраница = Истина;
			ПараметрыВыполнения.ПерезагружаемыеПериоды.Добавить(ПерезагружаемыйПериод); 
		КонецЕсли;	
		
		ТекстЗапроса = ТекстЗапроса + "
		|" + ПолучитьТекстЗапросаОстатки(ИмяВТ, "&" + ИмяПараметрДата + ?(ПостфиксПараметра = "", "ГраницаВключая", ПостфиксПараметра), "&" + ИмяПараметрДата + "ГраницаВключая", ДополнительныеПараметрыОстатки);		
				
		ПерезагружаемыйПериод = ПолучитьСтруктуруПерезагружаемыйПериод();
		ПерезагружаемыйПериод.ИмяВТ = ИмяВТ;
		ПерезагружаемыйПериод.ИмяПараметрДата = ИмяПараметрДата;
		ПерезагружаемыйПериод.ОкончаниеПериода = ВыборкаДетальныеЗаписи.ОкончаниеПериода;
		ПерезагружаемыйПериод.ЭтоГраница = Ложь;
		ПараметрыВыполнения.ПерезагружаемыеПериоды.Добавить(ПерезагружаемыйПериод); 
		
		ПерезагружаемыйПериод = ПолучитьСтруктуруПерезагружаемыйПериод();
		ПерезагружаемыйПериод.ИмяВТ = ИмяВТ;
		ПерезагружаемыйПериод.ИмяПараметрДата = ИмяПараметрДата + "ГраницаВключая";
		ПерезагружаемыйПериод.ОкончаниеПериода = Новый Граница(ВыборкаДетальныеЗаписи.ОкончаниеПериода, ВидГраницы.Включая);
		ПерезагружаемыйПериод.ЭтоГраница = Истина;
		ПараметрыВыполнения.ПерезагружаемыеПериоды.Добавить(ПерезагружаемыйПериод);
	КонецЦикла; 
	
	ПерваяТаблица = Истина;
	Для каждого СтрокаПериод Из ПараметрыВыполнения.ПерезагружаемыеПериоды Цикл 
		Если СтрокаПериод.ЭтоГраница Тогда
			Продолжить;	
		КонецЕсли;
		Если ПерваяТаблица Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|" + ПолучитьТекстЗапросаОстаткиПредварительно(СтрокаПериод.ИмяВТ, "&" + СтрокаПериод.ИмяПараметрДата, ПараметрыВыполнения, Истина, "ВТОстаткиПерезагружаемыеПредварительно");
			ПерваяТаблица = Ложь;
		Иначе
			ТекстЗапроса = ТекстЗапроса + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|" + ПолучитьТекстЗапросаОстаткиПредварительно(СтрокаПериод.ИмяВТ, "&" + СтрокаПериод.ИмяПараметрДата, ПараметрыВыполнения);
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + "
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетКод,
	|	СубСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////";
	
	Для каждого СтрокаПериод Из ПараметрыВыполнения.ПерезагружаемыеПериоды Цикл
		Если СтрокаПериод.ЭтоГраница Тогда
			Продолжить;	
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + "
		|" + УничтожитьТаблицыПредварительно(СтрокаПериод.ИмяВТ); 
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + "
	|" + ПолучитьТекстЗапросаОстаткиОкончательно("ВТОстаткиПерезагружаемыеПредварительно", "ВТОстаткиПерезагружаемыеБезСубконто4", "ВТОстаткиПерезагружаемые");
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьТекстЗапросаОстаткиБезКЭК(ДополнительныеПараметры)
	
	СубконтоНаСчетах = ДополнительныеПараметры.ПараметрыВыполнения.СубконтоНаСчетах;
	ТекстЗапроса = "";
	Для каждого СтрокаСубконто Из СубконтоНаСчетах Цикл		
		ТекстПолеВыбора = "";
		
		ИтерацияСубконто = 1;
		Для каждого Субкотно Из СтрокаСубконто.ТипЗначенияСубконто Цикл  
			ТекстПолеВыбора = ТекстПолеВыбора + "
			|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто" + ИтерацияСубконто + ", ЗНАЧЕНИЕ(" + Субкотно + ".ПустаяСсылка)),";
			ИтерацияСубконто = ИтерацияСубконто + 1;
		КонецЦикла;	
		
		Если ИтерацияСубконто <= 3 Тогда
			Для ИтерацияСубконто = ИтерацияСубконто По 3 Цикл
				ТекстПолеВыбора = ТекстПолеВыбора + "
				|	ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка),";
			КонецЦикла;	
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КФО, ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)),
		|	ЖурналПроводокЕПСБУОстатки.Счет," + 
		ТекстПолеВыбора + "
		|	ЖурналПроводокЕПСБУОстатки.Организация,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)),
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)),
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(%ПараметрДатаОстаткиГраница, Счет В (&Счета_" + СтрокаСубконто.Идентификатор + "), &МассивСубконто_" + СтрокаСубконто.Идентификатор + ", ) КАК ЖурналПроводокЕПСБУОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОрганизацииФедеральногоБюджета КАК ВТОрганизацииФедеральногоБюджета
		|		ПО ЖурналПроводокЕПСБУОстатки.Организация = ВТОрганизацииФедеральногоБюджета.Организация
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПланСчетов КАК ВТПланСчетов
		|		ПО ЖурналПроводокЕПСБУОстатки.Счет = ВТПланСчетов.Ссылка" +
		?(ДополнительныеПараметры.ПерезагружаемыеПериоды, "
		|ГДЕ
		|	ВТПланСчетов.Код В (&СчетаПерезагружаемыеПериоды)", "");
	КонецЦикла;	
	Возврат ТекстЗапроса; 
	
КонецФункции

Функция ПолучитьТекстЗапросаОстаткиСКЭК(ДополнительныеПараметры)
	
	СубконтоНаСчетах = ДополнительныеПараметры.ПараметрыВыполнения.СубконтоНаСчетах;
	ТекстЗапроса = "";
	Для каждого СтрокаСубконто Из СубконтоНаСчетах Цикл		
		ТекстПолеВыбора = "";
		
		ИтерацияСубконто = 1;
		Для каждого Субкотно Из СтрокаСубконто.ТипЗначенияСубконто Цикл  
			ТекстПолеВыбора = ТекстПолеВыбора + "
			|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто" + ИтерацияСубконто + ", ЗНАЧЕНИЕ(" + Субкотно + ".ПустаяСсылка)),";
			ИтерацияСубконто = ИтерацияСубконто + 1;
		КонецЦикла;	
		
		Если ИтерацияСубконто <= 3 Тогда
			Для ИтерацияСубконто = ИтерацияСубконто По 3 Цикл
				ТекстПолеВыбора = ТекстПолеВыбора + "
				|	ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка),";
			КонецЦикла;	
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КФО, ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)),
		|	ЖурналПроводокЕПСБУОстатки.Счет," + 
		ТекстПолеВыбора + "
		|	ЖурналПроводокЕПСБУОстатки.Организация,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)),
		|	ЖурналПроводокЕПСБУОстатки.КЭК,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)),
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)),
		|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток,
		|	ЖурналПроводокЕПСБУОстатки.СуммаРазвернутыйОстатокДт,
		|	ЖурналПроводокЕПСБУОстатки.СуммаРазвернутыйОстатокКт,
		|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаРазвернутыйОстатокДт,
		|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаРазвернутыйОстатокКт,
		|	ЖурналПроводокЕПСБУОстатки.КоличествоРазвернутыйОстатокДт,
		|	ЖурналПроводокЕПСБУОстатки.КоличествоРазвернутыйОстатокКт
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(%ПараметрДатаОстаткиГраница, Счет В (&Счета_" + СтрокаСубконто.Идентификатор + "), &МассивСубконто_" + СтрокаСубконто.Идентификатор + ", ) КАК ЖурналПроводокЕПСБУОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОрганизацииФедеральногоБюджета КАК ВТОрганизацииФедеральногоБюджета
		|		ПО ЖурналПроводокЕПСБУОстатки.Организация = ВТОрганизацииФедеральногоБюджета.Организация
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПланСчетов КАК ВТПланСчетов
		|		ПО ЖурналПроводокЕПСБУОстатки.Счет = ВТПланСчетов.Ссылка" +
		?(ДополнительныеПараметры.ПерезагружаемыеПериоды, "
		|ГДЕ
		|	ВТПланСчетов.Код В (&СчетаПерезагружаемыеПериоды)", "");		
	КонецЦикла;	
	Возврат ТекстЗапроса; 
	
КонецФункции

#КонецОбласти

#Область Переносы_ТекстЗапроса

Функция Переносы_ПолучитьТекстЗапросаСтоимостьОбъектовОС(ПараметрыВыполнения, МенеджерВТ)

	ТекстЗапроса = "";
