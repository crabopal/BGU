				новСтрока.ROWNUM = п_НН;
				ИД_ОС = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("OS_NMA_NPA_ARENDA_" + XMLСтрока(ВыборкаОС.GUIDОС));
				ДанныеСтроки.OS = ?(ЗначениеЗаполнено(ИД_ОС), ИД_ОС, "");
				ИД_КОНТРАГЕНТ = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("KONTRAGENT_" + XMLСтрока(ВыборкаОС.GUIDКонтрагент));
				ДанныеСтроки.KONTRAGENT = ?(ЗначениеЗаполнено(ИД_КОНТРАГЕНТ), ИД_КОНТРАГЕНТ, "");
				ЗаполнитьЗначенияСвойств(новСтрока, ДанныеСтроки);
				СоответствиеСтрокаОС.Вставить(ОбъектGRAFIK_OS.OWNER + "_" + XMLСтрока(ВыборкаОС.GUIDОС), п_НН);
				п_НН = п_НН + 1;
				ОбъектGRAFIK_OS.ROW.Добавить(новСтрока);   
			КонецЦикла;
			ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектGRAFIK_OS);
		КонецЦикла;
	КонецЕсли;
	
	Если СтруктураРеквизитовГрафика.Свойство("GRAFIK_AMORT_DETAIL") Тогда
		СтруктураРеквизитов = СтруктураРеквизитовАналитики("GRAFIK_AMORT_DETAIL", ПараметрыВыполнения);
		Пока ВыборкаГрафика.Следующий() Цикл  
			
			ОбъектGRAFIK = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "GRAFIK_AMORT_DETAIL"));   
			ОбъектGRAFIK.OWNER = XMLСтрока(ВыборкаГрафика.GUID);
			ОбъектGRAFIK.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");  
			ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("GRAFIK_AMORT_DETAIL_" + ОбъектGRAFIK.OWNER, ОбъектGRAFIK.ID);
			ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
			п_НН = 1;  
			ВыборкаГрафикаДетали = ВыборкаГрафика.Выбрать();
			Пока ВыборкаГрафикаДетали.Следующий() Цикл 
				новСтрока = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "GRAFIK_AMORT_DETAIL").Свойства.Получить("ROW").Тип);
				ЗаполнитьЗначенияСвойств(новСтрока, ВыборкаГрафикаДетали);
				новСтрока.ROWNUM = п_НН;
				п_НН = п_НН + 1;
				Если Не СоответствиеСтрокаОС = Неопределено Тогда
					СтрокаОС = СоответствиеСтрокаОС.Получить(ОбъектGRAFIK.OWNER + "_" + XMLСтрока(ВыборкаГрафикаДетали.GUIDОсновноеСредство));
					Если ЗначениеЗаполнено(СтрокаОС) Тогда
						новСтрока.OS_ROWNUM = Формат(СтрокаОС, "ЧГ=0");
					КонецЕсли;
				КонецЕсли;
				ОбъектGRAFIK.ROW.Добавить(новСтрока);   
			КонецЦикла;
			ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектGRAFIK);              			
		КонецЦикла;
	КонецЕсли;
	
	Выборка.Сбросить();
	
	Пока Выборка.Следующий() Цикл
		
		ОбъектGRAF_AMORT = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "GRAF_AMORT")); 
