	|		ИНАЧЕ """"
	|	КОНЕЦ КАК SPOSOB_AMORT,
	|	ЕСТЬNULL(ВТСведенияКадастровогоУчета.КадастровыйНомер, """") КАК NUM_KADASTR,
	|	ЕСТЬNULL(ВТСведенияКадастровогоУчета.ОбщаяПлощадь, 0) КАК SQUARE,
	|	ЕСТЬNULL(ВТ_ИнвНомера.INV_NOMER, """") КАК INV_NOMER,
	|	ЕСТЬNULL(ВТ_ИнвНомера.NUM_ZAVOD, """") КАК NUM_ZAVOD,
	|	ЕСТЬNULL(ВТ_ИнвНомера.NUM_REESTR, """") КАК NUM_REESTR,
	|	ЕСТЬNULL(ВТ_ИнвНомера.NUM_INOY, """") КАК NUM_INOY,
	|	ЕСТЬNULL(ВТ_ИнвНомера.DATA_VYP, ДАТАВРЕМЯ(1, 1, 1)) КАК DATA_VYP,
	|	ЕСТЬNULL(ВТ_ИнвНомера.DATA_EKSP, ДАТАВРЕМЯ(1, 1, 1)) КАК DATA_EKSP
	|ИЗ
	|	ВТАналитикиOS_ КАК ВТАналитикиOS_
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК ОсновныеСредства
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТРасчетАмортизацииОС КАК ВТРасчетАмортизацииОС
	|			ПО ОсновныеСредства.Ссылка = ВТРасчетАмортизацииОС.ОсновноеСредство
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет КАК ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет
	|			ПО ОсновныеСредства.Ссылка = ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет.ОсновноеСредство
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТСведенияКадастровогоУчета КАК ВТСведенияКадастровогоУчета
	|			ПО ОсновныеСредства.Ссылка = ВТСведенияКадастровогоУчета.ОсновноеСредство
	|		ПО ВТАналитикиOS_.Аналитика = ОсновныеСредства.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИнвНомера КАК ВТ_ИнвНомера
	|		ПО ВТАналитикиOS_.GUID = ВТ_ИнвНомера.Ссылка
	|");
	
	#КонецОбласти	
	
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Пакет = Запрос.ВыполнитьПакет();
	
	Выборка 				= Пакет[Пакет.Количество() - 1].Выбрать();
	ВыборкаПравообладателей = Пакет[Пакет.Количество() - 3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаОбременений 		= Пакет[Пакет.Количество() - 2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СтруктураРеквизитовОС = СтруктураРеквизитовАналитики("OS", ПараметрыВыполнения);
	НН = ПараметрыВыполнения.НаборИсторияПроверкиАналитик.Количество(); 
	
	Если СтруктураРеквизитовОС.Свойство("OS_PRAVOOBLADANIE") Тогда
		
		СтруктураРеквизитов = СтруктураРеквизитовАналитики("OS_PRAVOOBLADANIE", ПараметрыВыполнения);
		МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("OS_PRAVOOBLADANIE", ПараметрыВыполнения);		
		
		Пока ВыборкаПравообладателей.Следующий() Цикл     
			ОбъектPRAVOOBLADANIE = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "OS_PRAVOOBLADANIE"));       
			ОбъектPRAVOOBLADANIE.ID =  Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");     
			ОбъектPRAVOOBLADANIE.OWNER =  XMLСтрока(ВыборкаПравообладателей.GUID);     
			ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("OS_PRAVOOBLADANIE_" + ОбъектPRAVOOBLADANIE.OWNER, ОбъектPRAVOOBLADANIE.ID); 
			ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
			
			ВыборкаПравообладателейВыборка = ВыборкаПравообладателей.Выбрать();
			п_НН = 1;
			Пока ВыборкаПравообладателейВыборка.Следующий() Цикл 
				новСтрока =  ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "PRAVOOBLADANIE").Свойства.Получить("ROW").Тип);
				ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, ВыборкаПравообладателейВыборка);
				пЗаполнитьЗначенияСвойств(новСтрока, СтруктураРеквизитов);
				Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
					ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, "OS_PRAVOOBLADANIE", Строка(ВыборкаПравообладателейВыборка.Ссылка), НН, МассивОбязательныхРеквизитов);
				КонецЕсли;
				
				новСтрока.ROWNUM = п_НН;
				п_НН = п_НН + 1;
				
				ОбъектPRAVOOBLADANIE.ROW.Добавить(новСтрока);
			КонецЦикла;
			               
			ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектPRAVOOBLADANIE);	
		КонецЦикла;
		
	КонецЕсли;
	
	Если СтруктураРеквизитовОС.Свойство("OS_OBREMENENIE") Тогда
		МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("OS_OBREMENENIE", ПараметрыВыполнения);		
		СтруктураРеквизитов = СтруктураРеквизитовАналитики("OS_OBREMENENIE", ПараметрыВыполнения);
		Пока ВыборкаОбременений.Следующий() Цикл
			
			ОбъектOBREMENENIE = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "OS_OBREMENENIE"));       
			ОбъектOBREMENENIE.ID =  Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");     
			ОбъектOBREMENENIE.OWNER =  XMLСтрока(ВыборкаОбременений.GUID);     
			ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("OS_OBREMENENIE_" + ОбъектOBREMENENIE.OWNER, ОбъектOBREMENENIE.ID); 
			ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
			
			ВыборкаОбремененийВыборка = ВыборкаОбременений.Выбрать();  
			п_НН = 1;			
			Пока ВыборкаОбремененийВыборка.Следующий() Цикл
				новСтрока = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "OBREMENENIE").Свойства.Получить("ROW").Тип);
				ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, ВыборкаОбремененийВыборка);  
				
				Если СтруктураРеквизитов.Свойство("KONTRAGENT") Тогда
					ИД_Контрагента = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("KONTRAGENT_" + XMLСтрока(ВыборкаОбремененийВыборка.GUIDКонтрагент));
					СтруктураРеквизитов.KONTRAGENT = ?(ЗначениеЗаполнено(ИД_Контрагента), ИД_Контрагента, "");
				КонецЕсли;
				
				пЗаполнитьЗначенияСвойств(новСтрока, СтруктураРеквизитов); 
				Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
					ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, "OS_OBREMENENIE", Строка(ВыборкаОбремененийВыборка.Наименование), НН, МассивОбязательныхРеквизитов);
				КонецЕсли;
				новСтрока.ROWNUM = п_НН;
				п_НН = п_НН + 1;       
				ОбъектOBREMENENIE.ROW.Добавить(новСтрока);
			КонецЦикла;
			ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектOBREMENENIE);
		КонецЦикла;
		
	КонецЕсли;
	
	МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("OS", ПараметрыВыполнения);	
	
	Пока Выборка.Следующий() Цикл  
		ОбъектOS = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "OS")); 
		
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитовОС, Выборка);	
		СтруктураРеквизитовОС.GUID = XMLСтрока(Выборка.GUID);
		пЗаполнитьЗначенияСвойств(ОбъектOS, СтруктураРеквизитовОС);
		Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
			ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитовОС, "OS", Строка(Выборка.NAME), НН, МассивОбязательныхРеквизитов);
		КонецЕсли;
		
		ОбъектOS.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");  
		ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("OS_" + ОбъектOS.GUID, ОбъектOS.ID);
		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
		
		Если СтруктураРеквизитовОС.Свойство("OS_PRAVOOBLADANIE") Тогда
			ИД_Правообладания = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("OS_PRAVOOBLADANIE_" + ОбъектOS.GUID);		
			ОбъектOS.OS_PRAVOOBLADANIE = ?(ЗначениеЗаполнено(ИД_Правообладания), ИД_Правообладания, "");
		КонецЕсли;		
		Если СтруктураРеквизитовОС.Свойство("OS_OBREMENENIE") Тогда
			ИД_Обременений = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("OS_OBREMENENIE_" + ОбъектOS.GUID);	
			ОбъектOS.OS_OBREMENENIE = ?(ЗначениеЗаполнено(ИД_Обременений), ИД_Обременений, "");
		КонецЕсли;		
		             
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектOS);
	КонецЦикла;
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТАналитики_OS; УНИЧТОЖИТЬ ВТАналитикиOS_; УНИЧТОЖИТЬ ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет; УНИЧТОЖИТЬ ВТРасчетАмортизацииОС; 
	|УНИЧТОЖИТЬ ВТСведенияКадастровогоУчета; УНИЧТОЖИТЬ ВТ_СобытияОССрез; УНИЧТОЖИТЬ ВТ_СобытияОС; УНИЧТОЖИТЬ ВТ_ИнвНомера"); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры      

Процедура KONTRAGENT(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения)
	
	ЗаписьXML = ОбщийОбъект;
	
	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.KONTRAGENT(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	МассивСубконто = Новый Массив;
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.НалогиИПлатежиОрганизации);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОбъектыФинансовыхВложений);  
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.КорреспондентыПоВнутреннимРасчетам);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	МассивАналитик = СтрРазделить("KONTRAGENT,ADM_BUDJ,OSN_RASCH,MOL_SOTRUDNIK,NMA,NPA,OS,OBJ_FIN_VL", ",");
	СпецАналитикуВМенеджерВТ(МенеджерВТ, МассивСубконто, "Контрагента", МассивАналитик, ПараметрыВыполнения);
	
	#Область ТекстЗапроса
	
	Запрос = Новый Запрос(	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.Наименование КАК Наименование,
	|	Контрагенты.Код КАК ID_KONTRAGENTA,
	|	ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА ""1""
	|		ИНАЧЕ ""2""
	|	КОНЕЦ КАК VID_KONTRAGENTA,
	|	Контрагенты.ЮридическоеФизическоеЛицо КАК ЮридическоеФизическоеЛицо,
	|	Контрагенты.ТипКонтрагента КАК ТипКонтрагента
	|ПОМЕСТИТЬ ВТКонтрагентыПредварительно
	|ИЗ
	|	ВТАналитики_Контрагента КАК ВТАналитики_Контрагента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ВТАналитики_Контрагента.Аналитика = Контрагенты.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Контрагенты.Ссылка,
	|	Контрагенты.Наименование,
	|	Контрагенты.Код,
	|	ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА ""1""
	|		ИНАЧЕ ""2""
	|	КОНЕЦ,
	|	Контрагенты.ЮридическоеФизическоеЛицо,
	|	Контрагенты.ТипКонтрагента
	|ИЗ
	|	ВТАналитики_Контрагента КАК ВТАналитики_Контрагента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НалогиИПлатежиОрганизации КАК НалогиИПлатежиОрганизации
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|			ПО НалогиИПлатежиОрганизации.Контрагент = Контрагенты.Ссылка
	|		ПО ВТАналитики_Контрагента.Аналитика = НалогиИПлатежиОрганизации.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КонтрагентыСправочник.Ссылка,
	|	КонтрагентыСправочник.Наименование,
	|	КонтрагентыСправочник.Код,
	|	ВЫБОР
	|		КОГДА КонтрагентыСправочник.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА ""1""
	|		ИНАЧЕ ""2""
	|	КОНЕЦ,
	|	КонтрагентыСправочник.ЮридическоеФизическоеЛицо,
	|	КонтрагентыСправочник.ТипКонтрагента
	|ИЗ
	|	ВТАналитики_Контрагента КАК ВТАналитики_Контрагента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КонтрагентыСправочник
	|			ПО Договоры.Контрагент = КонтрагентыСправочник.Ссылка
	|		ПО ВТАналитики_Контрагента.Аналитика = Договоры.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КонтрагентыСправочник.Ссылка,
	|	КонтрагентыСправочник.Наименование,
	|	КонтрагентыСправочник.Код,
	|	ВЫБОР
	|		КОГДА КонтрагентыСправочник.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА ""1""
	|		ИНАЧЕ ""2""
	|	КОНЕЦ,
	|	КонтрагентыСправочник.ЮридическоеФизическоеЛицо,
	|	КонтрагентыСправочник.ТипКонтрагента
	|ИЗ
	|	ВТАналитики_Контрагента КАК ВТАналитики_Контрагента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры.Контрагенты КАК ДоговорыКонтрагенты
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КонтрагентыСправочник
	|			ПО ДоговорыКонтрагенты.Контрагент = КонтрагентыСправочник.Ссылка
	|		ПО ВТАналитики_Контрагента.Аналитика = ДоговорыКонтрагенты.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КонтрагентыСправочник.Ссылка,
	|	КонтрагентыСправочник.Наименование,
	|	КонтрагентыСправочник.Код,
	|	ВЫБОР
