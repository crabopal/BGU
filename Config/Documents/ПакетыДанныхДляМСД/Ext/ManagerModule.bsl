			ИД_GRAF_AMORT_OS = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("GRAF_AMORT_OS" + ОбъектGRAF_AMORT.GUID);
			ОбъектGRAF_AMORT.GRAF_AMORT_OS = ?(ЗначениеЗаполнено(ИД_GRAF_AMORT_OS), ИД_GRAF_AMORT_OS, "");
		КонецЕсли;
		
		Если СтруктураРеквизитовГрафика.Свойство("GRAFIK_AMORT_DETAIL") Тогда
			ИД_Графика = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("GRAFIK_AMORT_DETAIL_" + XMLСтрока(Выборка.GUID));
			ОбъектGRAF_AMORT.GRAFIK_AMORT_DETAIL = ?(ЗначениеЗаполнено(ИД_Графика), ИД_Графика, "");
		КонецЕсли;
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектGRAF_AMORT);                  		
	КонецЦикла;
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТАналитики_GRAF_AMORT; УНИЧТОЖИТЬ ВТ_GRAF_AMORT_"); 
