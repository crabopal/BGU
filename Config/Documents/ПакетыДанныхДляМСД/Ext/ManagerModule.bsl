			новЗапись.ВерсияФормата 	= ПараметрыВыполнения.ВерсияТаксономии;
			новЗапись.НомерЗаписи 		= НН; 
			новЗапись.ТипЗаписи 		= Перечисления.ТипыЗаписейМСД.РеквизитыАналитик;  
			новЗапись.ИмяАналитики 		= "KONTRAGENT";
			новЗапись.ДатаПроверки 		= ТекущаяДатаСеанса();
			новЗапись.Ошибка 			= Истина;
			новЗапись.ТекстСообщения 	= СтрШаблон(НСтр("ru='В аналитике %1 (%2) не заполнен реквизит %3'"), "KONTRAGENT", Строка(Выборка.GUID), "ЮридическоеФизическоеЛицо");
		КонецЕсли;
		
		ОбъектKONTRAGENT = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "KONTRAGENT")); 
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, Выборка);   
		СтруктураРеквизитов.GUID = XMLСтрока(Выборка.GUID);   
		
		пЗаполнитьЗначенияСвойств(ОбъектKONTRAGENT, СтруктураРеквизитов);
		Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
			ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитов, "KONTRAGENT", Строка(Выборка.Наименование), НН, МассивОбязательныхРеквизитов);
		КонецЕсли;
		
		
		ОбъектKONTRAGENT.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");  
		ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("KONTRAGENT_" + ОбъектKONTRAGENT.GUID, ОбъектKONTRAGENT.ID);
		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
		
		Если СтруктураРеквизитов.Свойство("VID_KONTRAGENTA") И СтруктураРеквизитов.Свойство("UR_LICO") И Выборка.VID_KONTRAGENTA = "1" Тогда 
			ИД_ЮрЛица = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("UR_LICO_" + XMLСтрока(Выборка.GUIDЮридическоеФизическоеЛицо));
			ОбъектKONTRAGENT.UR_LICO = ?(ЗначениеЗаполнено(ИД_ЮрЛица), ИД_ЮрЛица, "");
		ИначеЕсли СтруктураРеквизитов.Свойство("VID_KONTRAGENTA") И СтруктураРеквизитов.Свойство("FIZ_LICO") И Выборка.VID_KONTRAGENTA = "2" Тогда                                                                       
			ИД_ФизЛица = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("FIZ_LICO_" + XMLСтрока(Выборка.GUIDЮридическоеФизическоеЛицо));
			ОбъектKONTRAGENT.FIZ_LICO = ?(ЗначениеЗаполнено(ИД_ФизЛица), ИД_ФизЛица, "");
		КонецЕсли;
		
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектKONTRAGENT);		
	КонецЦикла;
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТКонтрагентыПредварительно; УНИЧТОЖИТЬ ВТАналитики_Контрагента; УНИЧТОЖИТЬ ВТЮрЛица; УНИЧТОЖИТЬ ВТФизЛица"); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура OSN_RASCH(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения)
	
	ЗаписьXML = ОбщийОбъект;
	
	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.OSN_RASCH(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	МассивСубконто = Новый Массив;
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ПринятыеОбязательства);
	
	СпецАналитикуВМенеджерВТ(МенеджерВТ, МассивСубконто, "OSN_RASCH",,ПараметрыВыполнения);
	
	#Область ТекстЗапроса	
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетныеНомераОбязательств.Обязательство КАК Обязательство,
	|	УчетныеНомераОбязательств.УчетныйНомерОбязательства КАК УчетныйНомерОбязательства
	|ПОМЕСТИТЬ ВТУчетныеНомераОбязательств
	|ИЗ
	|	РегистрСведений.УчетныеНомераОбязательств КАК УчетныеНомераОбязательств
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Обязательство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ХарактеристикиОбязательствСрезПоследних.Договор КАК Договор,
	|	ХарактеристикиОбязательствСрезПоследних.ЗначениеХарактеристики КАК ЗначениеХарактеристики
	|ПОМЕСТИТЬ ВТХарактеристикиОбязательств
	|ИЗ
	|	РегистрСведений.ХарактеристикиОбязательств.СрезПоследних(
	|			&Дата,
	|			Договор В (ВЫБРАТЬ Т.Аналитика ИЗ ВТАналитики_OSN_RASCH КАК Т)
	|			И ВидХарактеристики = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыХарактеристикОбязательства.ИКЗ)) КАК ХарактеристикиОбязательствСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Договоры.Ссылка КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Договоры.Ссылка) КАК GUID,
	|	Договоры.Наименование КАК NAME,
	|	Договоры.ВидОбязательства КАК VID_OSN,
	|	Договоры.НомерДоговора КАК NOMER_OSN,
	|	Договоры.ДатаДоговора КАК DATE_OSN,
	|	ВЫРАЗИТЬ(Договоры.УИН КАК СТРОКА(36)) КАК UIN,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(ВТУчетныеНомераОбязательств.УчетныйНомерОбязательства, """") КАК СТРОКА(20)) КАК NOMER_BO,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Договоры.Контрагент) КАК GUIDКонтрагент,
	|	Договоры.Контрагент КАК Контрагент,
	|	ЕСТЬNULL(ВТХарактеристикиОбязательств.ЗначениеХарактеристики, """") КАК IKZ
	|ИЗ
	|	ВТАналитики_OSN_RASCH КАК ВТАналитики_OSN_RASCH
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТУчетныеНомераОбязательств КАК ВТУчетныеНомераОбязательств
	|			ПО (Договоры.Ссылка = ВТУчетныеНомераОбязательств.Обязательство)
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТХарактеристикиОбязательств КАК ВТХарактеристикиОбязательств
	|			ПО (Договоры.Ссылка = ВТХарактеристикиОбязательств.Договор)
	|		ПО (ВТАналитики_OSN_RASCH.Аналитика = Договоры.Ссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДоговорыКонтрагенты.Ссылка КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ДоговорыКонтрагенты.Ссылка) КАК GUID,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ДоговорыКонтрагенты.Контрагент) КАК GUIDКонтрагент,
	|	ДоговорыКонтрагенты.Контрагент КАК Контрагент
	|ИЗ
	|	ВТАналитики_OSN_RASCH КАК ВТАналитики_OSN_RASCH
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры.Контрагенты КАК ДоговорыКонтрагенты
	|		ПО ВТАналитики_OSN_RASCH.Аналитика = ДоговорыКонтрагенты.Ссылка
	|ИТОГИ ПО
	|	GUID");
	
	#КонецОбласти	
	
	Запрос.УстановитьПараметр("Дата", ПараметрыВыполнения.ОкончаниеПериода);	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;  
	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[Пакет.Количество() - 2].Выбрать();
	ВыборкаСпискаКонтрагентов = Пакет[Пакет.Количество() - 1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СтруктураРеквизитовДоговор = СтруктураРеквизитовАналитики("OSN_RASCH", ПараметрыВыполнения);
	
	Если СтруктураРеквизитовДоговор.Свойство("SPIS_KONTRAGENT") Тогда
		Пока ВыборкаСпискаКонтрагентов.Следующий() Цикл
			ВыборкаСпискаДетально = ВыборкаСпискаКонтрагентов.Выбрать();  
			
			Если ВыборкаСпискаДетально.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ОбъектГУИДКонтрагента = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "SPIS_KONTRAGENT"));   	
			ОбъектГУИДКонтрагента.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");  
			ОбъектГУИДКонтрагента.OWNER = XMLСтрока(ВыборкаСпискаКонтрагентов.GUID);  
			ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("SPIS_KONTRAGENT_" + ОбъектГУИДКонтрагента.OWNER, ОбъектГУИДКонтрагента.ID);
			ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;       
			
			п_НН = 1; 
			Пока ВыборкаСпискаДетально.Следующий() Цикл   				
				новСтрока = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "SPIS_KONTRAGENT").Свойства.Получить("ROW").Тип);
				новСтрока.ROWNUM = п_НН;
				п_НН = п_НН + 1;
				ИД_Контрагента = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("KONTRAGENT_" + XMLСтрока(ВыборкаСпискаДетально.GUIDКонтрагент));				
				новСтрока.KONTRAGENT = ?(ЗначениеЗаполнено(ИД_Контрагента), ИД_Контрагента, "");
				ОбъектГУИДКонтрагента.ROW.Добавить(новСтрока);
			КонецЦикла;          			
			
			ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектГУИДКонтрагента);			
		КонецЦикла;	
	КонецЕсли;
	НН = ПараметрыВыполнения.НаборИсторияПроверкиАналитик.Количество();
	МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("OSN_RASCH", ПараметрыВыполнения);		
	
	Пока Выборка.Следующий() Цикл  
		ОбъектOSN_RASCH = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "OSN_RASCH")); 
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитовДоговор, Выборка);    
		СтруктураРеквизитовДоговор.GUID = XMLСтрока(Выборка.GUID); 
		
		пЗаполнитьЗначенияСвойств(ОбъектOSN_RASCH, СтруктураРеквизитовДоговор);
		Если ПараметрыВыполнения.ВыполнятьПроверку Тогда
			ПроверитьОбязательностьРеквизитов(ПараметрыВыполнения, СтруктураРеквизитовДоговор, "OSN_RASCH", Строка(Выборка.NAME), НН, МассивОбязательныхРеквизитов);
		КонецЕсли;
		
		ОбъектOSN_RASCH.ID = Формат(ПараметрыВыполнения.ПорядковыйНомер, "ЧГ=0");  
		ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Вставить("OSN_RASCH_" + ОбъектOSN_RASCH.GUID, ОбъектOSN_RASCH.ID);
		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;               
		Если СтруктураРеквизитовДоговор.Свойство("KONTRAGENT") Тогда
			ИД_Контрагента = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("KONTRAGENT_" + XMLСтрока(Выборка.GUIDКонтрагент));		
			ОбъектOSN_RASCH.KONTRAGENT = ?(ЗначениеЗаполнено(ИД_Контрагента), ИД_Контрагента, ""); 
		КонецЕсли;
		
		Если СтруктураРеквизитовДоговор.Свойство("SPIS_KONTRAGENT") Тогда
			ИД_СпискаКонтрагентов = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("SPIS_KONTRAGENT_" + ОбъектOSN_RASCH.GUID);		
			ОбъектOSN_RASCH.SPIS_KONTRAGENT = ?(ЗначениеЗаполнено(ИД_СпискаКонтрагентов), ИД_СпискаКонтрагентов, ""); 
		КонецЕсли;
		 
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектOSN_RASCH);
	КонецЦикла;
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТАналитики_OSN_RASCH"); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура NMA(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения)
	
	ЗаписьXML = ОбщийОбъект;
	
	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.NMA(ОбщийОбъект, МенеджерВТ, ПараметрыВыполнения, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	СпецАналитикуВМенеджерВТ(МенеджерВТ, МодульОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства), "NMA",,ПараметрыВыполнения);		
	
	#Область ТекстЗапроса
	
	Запрос = Новый Запрос(		
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(ИнвентарныеНомераОС.ОС, ВТАналитики_NMA.Аналитика) КАК Аналитика,
	|	ВТАналитики_NMA.Аналитика КАК GUID
	|ПОМЕСТИТЬ ВТАналитикиNMA_
	|ИЗ
	|	ВТАналитики_NMA КАК ВТАналитики_NMA
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|		ПО ВТАналитики_NMA.Аналитика = ИнвентарныеНомераОС.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Аналитика,
	|	GUID
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации
	|ПОМЕСТИТЬ ВТ_ПараметрыАмортизацииОСБухгалтерскийУчет
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	|			,
	|			Активность
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						Т.Аналитика
	|					ИЗ
	|						ВТАналитикиNMA_ КАК Т)) КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасчетАмортизацииОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	РасчетАмортизацииОССрезПоследних.СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|ПОМЕСТИТЬ ВТРасчетАмортизацииОС
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	|			,
	|			Активность
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						Т.Аналитика
	|					ИЗ
	|						ВТАналитикиNMA_ КАК Т)) КАК РасчетАмортизацииОССрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СведенияКадастровогоУчетаСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомер КАК КадастровыйНомер,
	|	СведенияКадастровогоУчетаСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь
