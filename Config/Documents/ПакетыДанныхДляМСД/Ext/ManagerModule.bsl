		ТекстПоляАналитикиОборотыКт = СтрЗаменить(ТекстПоляАналитикиОборотыКт, "%Суффикс", "Кт");	
	
		МассивВидовСубконто = Новый Массив;
		ВыборкаВидыСубконто = ВыборкаИмяАналитики.Выбрать();
		Пока ВыборкаВидыСубконто.Следующий() Цикл
			МассивВидовСубконто.Добавить(ВыборкаВидыСубконто.ВидСубконто);		
		КонецЦикла;
		Запрос.УстановитьПараметр("ВидыСубконто_" + ВыборкаИмяАналитики.ИмяАналитики, МассивВидовСубконто);
	КонецЦикла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ПоляРазвернутыеАналитикиОстатки", ТекстПоляАналитикиОстатки); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ПоляРазвернутыеАналитикиОбороты", ТекстПоляАналитикиОборотыДт + ТекстПоляАналитикиОборотыКт); 
	
	#КонецОбласти
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура СпецАналитикуВМенеджерВТ(МенеджерВТ, МассивВидовСубконто, Аналитика, АналитикиСтрокой = Неопределено, ПараметрыВыполнения)
	
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	Если АналитикиСтрокой = Неопределено Тогда
		АналитикиСтрокой = МодульОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Аналитика);
	КонецЕсли;
	Запрос = Новый Запрос;
	Если ПараметрыВыполнения.ПакетныйРежимВыгрузки Тогда
		ТекстЗапроса = 		ПолучитьТекстЗапросаАналитик(ПараметрыВыполнения) + "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТАналитики.Аналитика КАК Аналитика
		|ПОМЕСТИТЬ ВТАналитики_%1
		|ИЗ
		|	ВТАналитики КАК ВТАналитики
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Аналитика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТАналитики";
	Иначе	
		ТекстЗапроса = 		"
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТАналитики.Аналитика КАК Аналитика
		|ПОМЕСТИТЬ ВТАналитики_%1
		|ИЗ
		|	ВТАналитики КАК ВТАналитики
		|ГДЕ
		|	ВТАналитики.ВидСубконто В (&МассивВидовСубконто)
		|	И (ВТАналитики.Аналитика1 В (&АналитикиСтрокой)
		|			ИЛИ ВТАналитики.Аналитика2 В (&АналитикиСтрокой)
		|			ИЛИ ВТАналитики.Аналитика3 В (&АналитикиСтрокой)
		|			ИЛИ ВТАналитики.Аналитика4 В (&АналитикиСтрокой)
		|			ИЛИ ВТАналитики.Аналитика5 В (&АналитикиСтрокой)
		|			ИЛИ ВТАналитики.Аналитика6 В (&АналитикиСтрокой))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Аналитика";
	КонецЕсли;
	Запрос.Текст = СтрШаблон(ТекстЗапроса, Аналитика);
	Запрос.УстановитьПараметр("АналитикиСтрокой", АналитикиСтрокой);
	Запрос.УстановитьПараметр("МассивВидовСубконто", МассивВидовСубконто);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ; 
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура СпецАналитикиНаборомВМенеджерВТ(МенеджерВТ, Аналитика)
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса = СтрШаблон("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТОбороты.СубконтоДт1 КАК Субконто1,
	|	ВТОбороты.СубконтоДт2 КАК Субконто2,
	|	ВТОбороты.СубконтоДт3 КАК Субконто3
	|ПОМЕСТИТЬ ВТАналитики_
	|ИЗ
	|	ВТОбороты КАК ВТОбороты
	|ГДЕ
	|	(ВТОбороты.АналитикаДт1 = &Аналитика
	|			ИЛИ ВТОбороты.АналитикаДт2 = &Аналитика
	|			ИЛИ ВТОбороты.АналитикаДт3 = &Аналитика
	|			ИЛИ ВТОбороты.АналитикаДт4 = &Аналитика
	|			ИЛИ ВТОбороты.АналитикаДт5 = &Аналитика
	|			ИЛИ ВТОбороты.АналитикаДт6 = &Аналитика)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТОбороты.СубконтоКт1,
	|	ВТОбороты.СубконтоКт2,
	|	ВТОбороты.СубконтоКт3
	|ИЗ
	|	ВТОбороты КАК ВТОбороты
	|ГДЕ
	|	(ВТОбороты.АналитикаКт1 = &Аналитика
	|			ИЛИ ВТОбороты.АналитикаКт2 = &Аналитика
	|			ИЛИ ВТОбороты.АналитикаКт3 = &Аналитика
	|			ИЛИ ВТОбороты.АналитикаКт4 = &Аналитика
	|			ИЛИ ВТОбороты.АналитикаКт5 = &Аналитика
	|			ИЛИ ВТОбороты.АналитикаКт6 = &Аналитика)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТОстатки.Субконто11,
	|	ВТОстатки.Субконто21,
	|	ВТОстатки.Субконто31
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|ГДЕ
	|	(ВТОстатки.Аналитика1 = &Аналитика
	|			ИЛИ ВТОстатки.Аналитика2 = &Аналитика
	|			ИЛИ ВТОстатки.Аналитика3 = &Аналитика
	|			ИЛИ ВТОстатки.Аналитика4 = &Аналитика
	|			ИЛИ ВТОстатки.Аналитика5 = &Аналитика
	|			ИЛИ ВТОстатки.Аналитика6 = &Аналитика)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Субконто1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТАналитики_.Субконто1 КАК Аналитика
	|ПОМЕСТИТЬ ВТАналитики_%1
	|ИЗ
	|	ВТАналитики_ КАК ВТАналитики_
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТАналитики_.Субконто2
	|ИЗ
	|	ВТАналитики_ КАК ВТАналитики_
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТАналитики_.Субконто3
	|ИЗ
	|	ВТАналитики_ КАК ВТАналитики_", Аналитика);
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Аналитика", Аналитика);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ; 
	
	Запрос.Выполнить();
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ВТАналитики_"); 
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
