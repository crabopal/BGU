Процедура СформироватьДанныеДляВыгрузки(МенеджерВТ, ПараметрыВыполнения)
	
	СтандартнаяОбработка = Истина;
	МодульСбораДанныхПереопределяемый.СформироватьДанныеДляВыгрузки(МенеджерВТ, ПараметрыВыполнения, СтандартнаяОбработка);
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	НекорректныеГруппыСчетов = ВыполнитьПроверкуГруппировкиСчетов(ПараметрыВыполнения);
	Если НекорректныеГруппыСчетов.Количество() Тогда
		ТекстИсключения = СтрШаблон(НСтр("ru='Обнаружено несоответствие в иерархии счетов ЕПСБУ. 
		|Следующие счета не могут быть группами:
		|%1.'"), СтрСоединить(НекорректныеГруппыСчетов, "; "));
		ОбщегоНазначения.СообщитьПользователю(ТекстИсключения);
		ВызватьИсключение ТекстИсключения;		
	КонецЕсли;
	
	ДанныеВерсии = ПараметрыВыполнения.ВерсияТаксономии;
	Если ДанныеВерсии = Неопределено Тогда
		ВызватьИсключение (НСтр("ru='Отсутствует утвержденная таксономия на начало периода'"));
	КонецЕсли;  
	
	ИспользуютсяИнтеграцииЭБ = Ложь;
	МодульСбораДанныхПереопределяемый.ОпределитьВозможностьИспользованияИнтеграцийЭБ(ИспользуютсяИнтеграцииЭБ); 
	ПараметрыВыполнения.Вставить("ИспользуютсяИнтеграцииЭБ", ИспользуютсяИнтеграцииЭБ);
	ИспользуетсяУчетФинВложений = Константы.ИспользоватьУчетФинансовыхВложений.Получить();
	ПараметрыВыполнения.Вставить("ИспользуетсяУчетФинВложений", ИспользуетсяУчетФинВложений);
	ИспользуетсяБГУСпец = Ложь;
	МодульСбораДанныхПереопределяемый.ОпределитьИспользованиеБГУСпец(ИспользуетсяБГУСпец);
	ПараметрыВыполнения.Вставить("ИспользуетсяБГУСпец", ИспользуетсяБГУСпец);
	
	ПараметрыВыполнения.ТаблицаРеквизитовАналитик = РеквизитыАналитик(ДанныеВерсии);
	ПараметрыВыполнения.ТаблицаРеквизитовАналитик.Индексы.Добавить("Аналитика");
	ПараметрыВыполнения.ТаблицаРеквизитовАналитик.Индексы.Добавить("Используется");
	ПараметрыВыполнения.ТаблицаРеквизитовАналитик.Индексы.Добавить("Обязательный");
	
	МакетОписания = ПолучитьМакет("РаспределениеСчетовПоКЭК");
	ОбластьМакета = МакетОписания.Область(1, 1, МакетОписания.ВысотаТаблицы, МакетОписания.ШиринаТаблицы);
	Построитель = Новый ПостроительЗапроса;
	ИсточникДанных = Новый ОписаниеИсточникаДанных(ОбластьМакета);
	Построитель.ИсточникДанных = ИсточникДанных;
	Построитель.Выполнить();
	ТаблицаСчетовПоКЭК = Построитель.Результат.Выгрузить();
	
	МодульСбораДанныхПереопределяемый.ТаблицаСчетовПоКЭК(ТаблицаСчетовПоКЭК);
	ТаблицаКЭК = ТаблицаСчетовПоКЭК.Скопировать(,"ПоКЭК");
	
	МассивКодовПоКЭК = Новый Массив;
	Для Каждого Строка Из ТаблицаКЭК Цикл
		Если Не ПустаяСтрока(Строка.ПоКЭК) Тогда
			МассивКодовПоКЭК.Добавить(Строка.ПоКЭК);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКЭК000 = ТаблицаСчетовПоКЭК.Скопировать(,"КЭК000");
	МассивКодовКЭК000 = Новый Массив;
	Для Каждого Строка Из ТаблицаКЭК000 Цикл
		Если Не ПустаяСтрока(Строка.КЭК000) Тогда
			МассивКодовКЭК000.Добавить(Строка.КЭК000);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКЭК00Х = ТаблицаСчетовПоКЭК.Скопировать(,"КЭК00Х");
	МассивКодовКЭК00Х = Новый Массив;
	Для Каждого Строка Из ТаблицаКЭК00Х Цикл
		Если Не ПустаяСтрока(Строка.КЭК00Х) Тогда
			МассивКодовКЭК00Х.Добавить(Строка.КЭК00Х);
		КонецЕсли;
	КонецЦикла;
	
	МодульБухгалтерскийУчет = ОбщегоНазначения.ОбщийМодуль("БухгалтерскийУчет");
	
	ОборотныеСчета	= МодульБухгалтерскийУчет.СписокСчетов(МассивКодовКЭК000);
	СчетаКИСЕ		= МодульБухгалтерскийУчет.СписокСчетов(МассивКодовКЭК00Х);
	
	СчетаПоКЭК		= МодульБухгалтерскийУчет.СписокСчетов(МассивКодовПоКЭК);
	
	СчетаСанкционирования = МодульБухгалтерскийУчет.СписокСчетов(СтрРазделить("501.00,502.00,503.00,504.00,506.00,507.00,508.00", ","));
	
	СчетаИсключенияОС		= МодульБухгалтерскийУчет.СписокСчетов(СтрРазделить("106.00,09", ","));
	МодульСбораДанныхПереопределяемый.СчетаИсключенияОС(СчетаИсключенияОС); 
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПерезагружаемыеПериоды", Ложь);
	ПараметрыВыполнения.Вставить("СубконтоНаСчетах", ПолучитьСубконтоНаСчетах(ПараметрыВыполнения));
	ДополнительныеПараметры.Вставить("ПараметрыВыполнения", ПараметрыВыполнения);	
	
	УсловиеСчетаОборотыДт = "";
	УсловиеСчетаОборотыКт = "";
	Для каждого СтрокаСубконто Из ПараметрыВыполнения.СубконтоНаСчетах Цикл
		УсловиеСчетаОборотыДт = УсловиеСчетаОборотыДт + ?(УсловиеСчетаОборотыДт = "", "", " И ") + "НЕ ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт В (&Счета_" + СтрокаСубконто.Идентификатор + ")";	
		УсловиеСчетаОборотыКт = УсловиеСчетаОборотыКт + ?(УсловиеСчетаОборотыКт = "", "", " И ") + "НЕ ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В (&Счета_" + СтрокаСубконто.Идентификатор + ")";
	КонецЦикла;	
	
	#Область ЗапросДанныхВыгрузки
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиВыгрузкиАналитикМСД.Организация КАК Организация,
	|	НастройкиВыгрузкиАналитикМСД.Счет КАК Счет,
	|	НастройкиВыгрузкиАналитикМСД.Аналитика1 КАК Аналитика1,
	|	НастройкиВыгрузкиАналитикМСД.Аналитика2 КАК Аналитика2,
	|	НастройкиВыгрузкиАналитикМСД.Аналитика3 КАК Аналитика3,
	|	НастройкиВыгрузкиАналитикМСД.Аналитика4 КАК Аналитика4,
	|	НастройкиВыгрузкиАналитикМСД.Аналитика5 КАК Аналитика5,
	|	НастройкиВыгрузкиАналитикМСД.Аналитика6 КАК Аналитика6,
	|	НЕ НастройкиВыгрузкиАналитикМСД.ОбязательноВОстатках1
	|		И НЕ НастройкиВыгрузкиАналитикМСД.Аналитика1 = """"
	|		И НастройкиВыгрузкиАналитикМСД.ВОстатках1 КАК ОбязательноВОстатках1,
	|	НЕ НастройкиВыгрузкиАналитикМСД.ОбязательноВОстатках2
	|		И НЕ НастройкиВыгрузкиАналитикМСД.Аналитика2 = """"
	|		И НастройкиВыгрузкиАналитикМСД.ВОстатках2 КАК ОбязательноВОстатках2,
	|	НЕ НастройкиВыгрузкиАналитикМСД.ОбязательноВОстатках3
	|		И НЕ НастройкиВыгрузкиАналитикМСД.Аналитика3 = """"
