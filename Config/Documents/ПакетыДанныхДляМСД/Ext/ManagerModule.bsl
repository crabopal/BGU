		ПараметрыВыполнения.ПорядковыйНомер = ПараметрыВыполнения.ПорядковыйНомер + 1;
		Если СтруктураРеквизитов.Свойство("ADRES") Тогда
			АдресСтрокой = ПолучитьАдресСтрокой(ЮрЛица.ЗначенияПолей);
			ИДАдреса = ПараметрыВыполнения.СоответствиеПорядковыхНомеров.Получить("ADRES_" + РассчитатьХешСтроки(АдресСтрокой + ЮрЛица.Представление));		
			ОбъектUR_LICO.ADRES = ?(ЗначениеЗаполнено(ИДАдреса), ИДАдреса, "");
		КонецЕсли;
		
		ПараметрыВыполнения.текФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектUR_LICO);
	КонецЦикла;
	
	СтруктураРеквизитов = СтруктураРеквизитовАналитики("FIZ_LICO", ПараметрыВыполнения);
	МассивОбязательныхРеквизитов = МассивОбязательныхРеквизитовАналитики("FIZ_LICO", ПараметрыВыполнения);		
	
	Пока ФизЛица.Следующий() Цикл  
		
		ОбъектFIZ_LICO = ПараметрыВыполнения.текФабрикаXDTO.Создать(ПараметрыВыполнения.текФабрикаXDTO.Тип(ПараметрыВыполнения.ПространствоИменПакет, "FIZ_LICO"));  
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, ФизЛица);	
		СтруктураРеквизитов.GUID = XMLСтрока(ФизЛица.GUID);                                    		
		пЗаполнитьЗначенияСвойств(ОбъектFIZ_LICO, СтруктураРеквизитов);
