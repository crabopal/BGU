#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьПереданныеЗначения();
	
	НастроитьФорму();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаАвансов

&НаКлиенте
Процедура ТаблицаАвансовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ТаблицаАвансовСчетФактура" Тогда
		ДокументСсылка = Элементы.ТаблицаАвансов.ТекущиеДанные.СчетФактураВыданный;
		Если ЗначениеЗаполнено(ДокументСсылка) Тогда
			СтандартнаяОбработка = Ложь;
			ПоказатьЗначение(Неопределено, ДокументСсылка);
		КонецЕсли;
		
	ИначеЕсли Параметры.ИзФормыОбъекта Тогда
		СоздатьСчетаФактурыВыданныеКлиент();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьСчетаФактурыВыданные(Команда)
	
	СоздатьСчетаФактурыВыданныеКлиент();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьПереданныеЗначения()
	
	ЗначениеПараметра = Параметры["ТаблицаАвансов"];
	
	Если ЭтоАдресВременногоХранилища(ЗначениеПараметра) Тогда 
		ТаблицаАвансов.Загрузить(ПолучитьИзВременногоХранилища(ЗначениеПараметра));
	Иначе
		ТаблицаАвансов.Загрузить(ЗначениеПараметра);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	Заголовок = СтрШаблон(НСтр("ru='Ввод на основании документа : %1'"), Параметры.ОснованиеСсылка);
	
	Элементы.ТаблицаАвансовСоздавать.Видимость = Не Параметры.ИзФормыОбъекта;
	
	Если Параметры.ИзФормыОбъекта Тогда
		Элементы.ФормаСоздатьСчетаФактурыВыданные.Заголовок = НСтр("ru='Выбрать'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСчетаФактурыВыданныеКлиент()
	
	Если Параметры.ИзФормыОбъекта Тогда
		// Запоминаем параметры одного выбранного документа.
		
		ОснованиеСтруктура = ПолучитьОснованиеСтруктуру(Элементы.ТаблицаАвансов.ТекущиеДанные);
		
		Закрыть(ОснованиеСтруктура);
	Иначе
		// Создаем новые документы счетов-фактур для отмеченных строк.
		Для Каждого СтрокаАванса Из ТаблицаАвансов Цикл
			Если Не СтрокаАванса.Создавать Тогда
				Продолжить;
			КонецЕсли;
			
			ОснованиеСтруктура = ПолучитьОснованиеСтруктуру(СтрокаАванса);
			
			СчетФактураСсылка = СтрокаАванса.СчетФактураВыданный;
			
			ПараметрыФормы = Новый Структура();
			
			Если ЗначениеЗаполнено(СчетФактураСсылка) тогда
				ПараметрыФормы.Вставить("Ключ", СчетФактураСсылка);
			Иначе
				ПараметрыФормы.Вставить("Основание", ОснованиеСтруктура);
			КонецЕсли;
			
			ОткрытьФорму("Документ.СчетФактураВыданный.ФормаОбъекта", ПараметрыФормы, , Новый УникальныйИдентификатор);
		КонецЦикла;
		
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьОснованиеСтруктуру(СтрокаТаблицы)
	
	ДополнительныйОтбор = Новый Структура();
	ДополнительныйОтбор.Вставить("КФО",				СтрокаТаблицы.КФО);
	ДополнительныйОтбор.Вставить("Контрагент",		СтрокаТаблицы.Контрагент);
	ДополнительныйОтбор.Вставить("Договор",			СтрокаТаблицы.Договор);
	ДополнительныйОтбор.Вставить("СуммаДокумента",	СтрокаТаблицы.АвансовыйПлатеж);
	ДополнительныйОтбор.Вставить("Подразделение",	СтрокаТаблицы.Подразделение);
	
	ОснованиеСтруктура = Новый Структура();
	ОснованиеСтруктура.Вставить("ОснованиеСсылка",		Параметры.ОснованиеСсылка);
	ОснованиеСтруктура.Вставить("ВводНаОсновании",		Истина);
	ОснованиеСтруктура.Вставить("ДополнительныйОтбор",	ДополнительныйОтбор);
	
	Возврат ОснованиеСтруктура;
	
КонецФункции

#КонецОбласти
