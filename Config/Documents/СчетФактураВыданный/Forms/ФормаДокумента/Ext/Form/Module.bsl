КонецПроцедуры

&НаКлиенте
Процедура СоставНФАСчетНачислениеДтПриИзменении(Элемент)
	
	//---
	// Механизм автоустановки субконто (клиентская часть)
	//---
	СтруктураДляПередачиНаСервер = УчетНДСКлиент.АвтоустановкаСубконто_ПолучитьТекущуюСтроку(ЭтаФорма, Элемент)["СтруктураДляПередачиНаСервер"];
	АвтоустановкаСубконто_ПриИзмененииСчета_Сервер(Элемент.Имя, СтруктураДляПередачиНаСервер);
	
	ТекДанные = Элементы["СоставНФА"].ТекущиеДанные;
	
	Если СледуетСкопироватьАналитикуВСчетНачислениеКт(ТекДанные) Тогда
		// Копируем содержательные поля:
		ТекДанные["СчетВычетКт"]		= ТекДанные["СчетНачислениеДт"];
		ТекДанные["КПСВычетКт"]			= ТекДанные["КПСНачислениеДт"];
		
	ИначеЕсли СледуетСкопироватьАналитикуВСчетРасчетов(ТекДанные) Тогда
		ТекДанные["СчетРасчетов"]		= ТекДанные["СчетНачислениеДт"];
		ТекДанные["КПССчетРасчетов"]	= ТекДанные["КПСНачислениеДт"];
		
	КонецЕсли;
	
КонецПроцедуры
