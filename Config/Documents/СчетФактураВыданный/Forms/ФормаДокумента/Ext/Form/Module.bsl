	Объект["РегистрацияВПредыдущемПериоде"] = (МестоРегистрации = 2);
	
	Если Объект["РегистрацияВПредыдущемПериоде"] Тогда
		Объект["ДатаРегистрацииВПредыдущемПериоде"] = УчетНДСВызовСервера.ДатаРегистрацииСФвПредыдущемПериоде(
		Объект.Организация, Объект.Дата);
	КонецЕсли;	
	
	НастроитьФормуКлиент_РегистрацияВДопЛистеПриИзменении();
	
