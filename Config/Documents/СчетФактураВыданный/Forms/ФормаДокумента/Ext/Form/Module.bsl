&НаСервере
Процедура ИнициализироватьФормуСервер()
	
	ИнициализироватьНастройкиЭлементовКолонок();
	
	ВыставленНеВыставлен	= ?(Объект["Выставлен"], 1, 0);
	МестоРегистрации = 0;
	Если Объект["РегистрацияВДопЛисте"] Тогда
		МестоРегистрации = 1;
	ИначеЕсли Объект["РегистрацияВПредыдущемПериоде"] Тогда
		МестоРегистрации = 2;
	КонецЕсли;	
	//МестоРегистрации		= ?(Объект["РегистрацияВДопЛисте"], 1, 0);
	ЕдИзмШт					= Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	ВидДоговора 			= Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	
	УчетНДСКлиентСервер.ЗаполнитьСписокКодовВидовОпераций(
		Элементы["КодВидаОперации"].СписокВыбора,
		"ВыставленныеСчетаФактуры",
		Объект["Дата"]);
		
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ВремСоответствие = Новый Соответствие();
	СписокДокументовОснования.Очистить();
	ТипыОснования = ДокументОбъект.Метаданные().Реквизиты.ДокументОснование.Тип.Типы();
	Для Каждого ТипОснования Из ТипыОснования Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипОснования);
		СписокДокументовОснования.Добавить(ОбъектМетаданных.Имя, ОбъектМетаданных.Представление());
		
		ВремСоответствие.Вставить(ОбъектМетаданных.Представление(), ОбъектМетаданных.Имя);
	КонецЦикла;
	СписокДокументовОснования.СортироватьПоПредставлению();
	СоответствиеПредставленияВидовДокументов = Новый ФиксированноеСоответствие(ВремСоответствие);
	
	
	АвтоустановкаКПС = Истина;
	Элементы["ФормаАвтоустановкаКПС"].Пометка = АвтоустановкаКПС;
	
	//---
	// Механизм автоустановки субконто
	//---
	АвтоустановкаСубконто_Инициализация_Сервер();
	
	ОбновитьНомерДляПечатиСервер();
	
	НастроитьФормуСервер_ПоДокументуОснованию();
	
	НастроитьФормуСервер_ПоПрименяемойИнструкции(Ложь);
	
	//---
	// Совместимость с БГУ1
	//---
	УчетНДС.ЗаполнитьСписокВыбораЭлементаПричинаНалогообложения(
		Элементы["ПричинаНалогообложения"],
		Истина, // ЭтоСчетФактураВыданный
		Объект["ПричинаНалогообложения"],// ТекущееЗначение
		КэшНДС_СовместимостьБГУ1_НекорректнаяПричинаНалогообложения// ВозвратНекорректноеЗначение
	);
	
	//---
	// Документы остатков НДС
	//---
