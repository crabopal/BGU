&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокСтраницаСчетаФактурыОтКомиссионера(Форма)
	
	НаименованияЭлементовСтранницы = Новый Структура;
	НаименованияЭлементовСтранницы.Вставить("ЗаголовокСтранницы", НСтр("ru = 'Счета-фактуры от продавцов комиссионера (агента)'"));
	НаименованияЭлементовСтранницы.Вставить("ЗаголовокРеквизитаПродавцов", НСтр("ru = 'Продавцы комиссионера (агента)'"));
	НаименованияЭлементовСтранницы.Вставить("ЗаголовокРеквизитаГрузоотправителя", НСтр("ru = 'Грузоотправитель'"));
	
	Возврат НаименованияЭлементовСтранницы;
	
КонецФункции

//---
// Механизм автоустановки субконто
//---

&НаСервере
Процедура АвтоустановкаСубконто_Инициализация_Сервер() Экспорт
	
	МассивСтруктурНастроек = УчетНДС.АвтоустановкаСубконто_ПолучитьМассивСтруктурНастроек_СчетФактураВыданный();
	
	УчетНДС.АвтоустановкаСубконто_Инициализация(ЭтаФорма, МассивСтруктурНастроек);
	
	СубконтоСФПолученные_ОбновитьУсловноеОформление();
	
КонецПроцедуры

// Вызывается механизмом при начале выбора субкнто в редактируемой таблице.
&НаКлиенте
Процедура Переопределяемый_АвтоустановкаСубконто_СубконтоНачалоВыбора_Клиент(СтруктураВыбораСубконто) Экспорт
	
	ТекущиеДанные = Элементы["СоставНФА"].ТекущиеДанные;
	
	// Здесь можно модифицировать структуру СтруктураВыбораСубконто
	СтруктураВыбораСубконто.Вставить("Организация",	Объект["Организация"]);
	СтруктураВыбораСубконто.Вставить("КПС",			ТекущиеДанные["КПСНачислениеДт"]);
	СтруктураВыбораСубконто.Вставить("КФО",			Объект["КФО"]);
	
КонецПроцедуры

// Вызывается механизмом перед обработкой редактируемой таблицы.
&НаСервере
Процедура Переопределяемый_АвтоустановкаСубконто_ПередАвтоустановкойСубконто_Сервер(ТаблицаПланАвтоустановки) Экспорт
	
	// Добавляем установку субконто СФПолученные:
	ЗначениеАвтоустановкиСФПолученные = УчетНДС.СубконтоСФПолученные_ОпределитьЗначениеДляАвтоустановки(Объект);
	Для Каждого СтрокаТаблицы Из ТаблицаПланАвтоустановки Цикл
		СтрокаТаблицы["СтруктураВходныхПараметров"]["ЗначенияАвтоустановки"].Вставить(
			ПланыВидовХарактеристик.ВидыСубконто.СФПолученные,
			ЗначениеАвтоустановкиСФПолученные);
	КонецЦикла;
	
	СубконтоСФПолученные_ОбновитьУсловноеОформление(ЗначениеАвтоустановкиСФПолученные);
	
КонецПроцедуры

