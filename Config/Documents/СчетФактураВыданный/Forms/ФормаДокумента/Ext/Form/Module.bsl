&НаКлиенте
Процедура СоставНФАВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	// МаркировкаПродукции
	Если Поле.Имя = "СоставНФАМаркируемыеУпаковки" Тогда
		ЭлектронныеДокументыБГУКлиент.МаркируемыеУпаковкиВыбор(ЭтаФорма, СтандартнаяОбработка, "СоставНФА");
	КонецЕсли;
	// Конец МаркировкаПродукции
	
КонецПроцедуры

&НаКлиенте
Процедура СоставНФАНФАПриИзменении(Элемент)
	
	ТекДанные = Элементы["СоставНФА"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекЗначение = ТекДанные["НФА"];
	
	Если ЗначениеЗаполнено(ТекЗначение) Тогда
		
		ТекДанные.ПрослеживаемыйТовар = Ложь;
		
		ЭтоОС			= (ТипЗнч(ТекЗначение) = Тип("СправочникСсылка.ОсновныеСредства"));
		ЭтоНоменклатура	= (ТипЗнч(ТекЗначение) = Тип("СправочникСсылка.Номенклатура"));
		
		Если НЕ ЗначениеЗаполнено(ТекДанные["Количество"]) Тогда
			ТекДанные["Количество"] = 1;
		КонецЕсли;
		
		Если ЭтоОС Тогда
			ЗаполнитьДанныеПоОСВСтрокеСервер(ТекДанные.ПолучитьИдентификатор());
		ИначеЕсли ЭтоНоменклатура Тогда
			// Эти поля для номенклатуры заполняем в любом случае:
			СвойстваНоменклатуры = УправлениеМатериальнымиЗапасамиВызовСервера.ПолучитьСвойстваНоменклатуры(ТекЗначение, Объект.Дата, Объект["ПричинаНалогообложения"]);
			ЗаполнитьЗначенияСвойств(ТекДанные, СвойстваНоменклатуры, "СтавкаНДС, ЕдиницаИзмерения");
			ТекДанные.ПрослеживаемыйТовар = ?(ВедетсяУчетПрослеживаемыхТоваров, СвойстваНоменклатуры.ПрослеживаемыйТовар, Ложь);
			ТекДанные.КодВидаТовара = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СвойстваНоменклатуры, "КодВидаТовара", "");
			
		КонецЕсли;
		//---
		// Механизм автоустановки субконто (клиентская часть)
		//---
		Подключаемый_АвтоустановкаСубконто_ПриИзмененииЗначенияАвтоустановкиВТаблице_Клиент(Элемент);
		
		// МаркировкаПродукции
		ЭлектронныеДокументыБГУКлиент.УстановитьПризнакМаркируемыйТовар(ТекДанные, "НФА");
		// Конец МаркировкаПродукции
	КонецЕсли;
	
КонецПроцедуры

