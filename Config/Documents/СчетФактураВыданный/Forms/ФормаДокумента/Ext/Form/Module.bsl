&НаСервере
Процедура СубконтоСФПолученные_ОбновитьУсловноеОформление(ЗначениеАвтоустановкиСФПолученные = Неопределено)
	
	СубконтоСФПолученные_ЗначениеАвтоустановки = ЗначениеАвтоустановкиСФПолученные;
	Если СубконтоСФПолученные_ЗначениеАвтоустановки = Неопределено Тогда
		СубконтоСФПолученные_ЗначениеАвтоустановки = УчетНДС.СубконтоСФПолученные_ОпределитьЗначениеДляАвтоустановки(Объект);
	КонецЕсли;
	
	СубконтоСФПолученные_ЗначениеАвтоустановкиРавно_ЭтотСФ = НЕ (СубконтоСФПолученные_ЗначениеАвтоустановки = Объект["ДокументОснование"]);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКолонкуКПС30304()
	
	// Заполняем колонку КПС30304
	Если АвтоустановкаКПС Тогда
		ОписаниеТаблицы = Новый Структура();
		ОписаниеТаблицы.Вставить("ИмяКолонкиСчет",		"Счет30304");
		ОписаниеТаблицы.Вставить("ИмяКолонкиКПС",		"КПС30304");
		ПараметрыЗаполнения = Новый Структура();
		ПараметрыЗаполнения.Вставить("Организация",					Объект["Организация"]);
		ПараметрыЗаполнения.Вставить("Дата",						Объект["Дата"]);
		ПараметрыЗаполнения.Вставить("КФО",							Объект["КФО"]);
		ПараметрыЗаполнения.Вставить("ИФО",							Объект["ИФО"]);
		ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКПС",			Истина);
		ПараметрыЗаполнения.Вставить("ЗаполнитьТолькоПустыеПоля",	Ложь);
		ПараметрыЗаполнения.Вставить("ВидыПоказателяКПС",			ПрименяемаяИнструкция_СтруктураСвойств["ВидыПоказателяКПС30304"]);
		УчетНДС.ЗаполнитьТаблицуПоРабочемуПлануСчетов(Объект["СоставНФА"], ОписаниеТаблицы, ПараметрыЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СледуетСкопироватьАналитикуВСчетНачислениеКт(ТекущиеДанные)
	
	СледуетСкопировать = (ЗначениеЗаполнено(ТекущиеДанные["СчетНачислениеДт"]) И
		ПрименяемаяИнструкция_СтруктураСвойств["СчетНачислениеДт"] = ПрименяемаяИнструкция_СтруктураСвойств["СчетВычетКт"]);
		
	Возврат СледуетСкопировать;
	
КонецФункции

&НаКлиенте
Функция СледуетСкопироватьАналитикуВСчетРасчетов(ТекущиеДанные)
	
	СледуетСкопировать = (ЗначениеЗаполнено(ТекущиеДанные["СчетНачислениеДт"])
		И ПрименяемаяИнструкция_СтруктураСвойств["НалоговыйАгент"]
		И ПрименяемаяИнструкция_СтруктураСвойств["СчетРасчетовИспользуется"]);
		
	Возврат СледуетСкопировать;
	
КонецФункции

