Процедура НастроитьФормуСервер_ПоДокументуОснованию()
	
	ТипОснования = ТипЗнч(Объект["ДокументОснование"]);
	
	ВидимостьКолонкиСодержание = (	ТипОснования = Тип("ДокументСсылка.АктОбОказанииУслуг")
								ИЛИ ТипОснования = Тип("ДокументСсылка.НачислениеАмортизацииПравПользованияОС")
								ИЛИ ТипОснования = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов"));
	
	Элементы["СоставНФАСодержаниеУслуги"].Видимость = ВидимостьКолонкиСодержание;
	
КонецПроцедуры

&НаСервере
Процедура ПричинаНалогообложенияПриИзмененииСервер()
	
	НастроитьФормуСервер_ПоПрименяемойИнструкции(Истина);
	
	ЗаполнитьКолонкуКПС30304();
	
	ЭтоРеализацияШкурЛома = УчетНДС.ЭтоРеализацияШкурЛома(Объект.ПричинаНалогообложения);
	
	Если ЭтоРеализацияШкурЛома Тогда
		
		УчетНДСКлиентСервер.ОчиститьСтавкуНДСВТаблице(Объект.СоставНФА);
		
	КонецЕсли;
	
	Если ЭтоАванс Тогда
		Объект.ДокументыОбОтгрузке.Очистить();
		УстановитьНадписьДокументыОбОтгрузке();
	КонецЕсли;
	
	УстановитьВидимостьНадписиДокументыОбОтгрузке();
	
	Если Не УчетНДСКлиентСервер.ДоступноУказаниеСчетовФактурНаАванс(Объект.ПричинаНалогообложения) Тогда
		Объект.СчетаФактурыНаАванс.Очистить();
	КонецЕсли;
	УстановитьНадписьСчетаФактурыНаАванс();
	УстановитьВидимостьНадписиСчетаФактурыНаАванс();
	
КонецПроцедуры

// ПрименяемаяИнструкция=f(ПричинаНалогообложения,КФО,Дата)
&НаСервере
Процедура НастроитьФормуСервер_ПоПрименяемойИнструкции(ЗаполнитьКолонкиСчетовЗначениямиПоУмолчанию, ИдентификаторИнструкции = Неопределено)
	
	Перем	УстановитьСчетНачислениеДт,
			УстановитьСчетВычетКт;
	
	// Текущее (или до изменения) значение применяемой инструкции
	Если ЗаполнитьКолонкиСчетовЗначениямиПоУмолчанию = Истина Тогда
		Попытка
			СохраненнаяИнструкцияСтруктура	= ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ПрименяемаяИнструкция_СтруктураСвойств);
			ПрежнийСчетНачислениеДт			= СохраненнаяИнструкцияСтруктура["СчетНачислениеДт"];
			ПрежнийСчетНачислениеДтЗадан	= Истина;
			ПрежнийСчетВычетКт				= СохраненнаяИнструкцияСтруктура["СчетВычетКт"];
			ПрежнийСчетВычетКтЗадан			= Истина;
		Исключение
			СохраненнаяИнструкцияСтруктура	= Неопределено;
			ПрежнийСчетНачислениеДт			= Неопределено;
			ПрежнийСчетНачислениеДтЗадан	= Ложь;
			ПрежнийСчетВычетКт				= Неопределено;
			ПрежнийСчетВычетКтЗадан			= Ложь;
		КонецПопытки;
	КонецЕсли;
	
	// Новое значение применяемой инструкции
	ОбъектСтруктура = Новый Структура("Организация,ПричинаНалогообложения,КФО,Дата,ИФО");
	ЗаполнитьЗначенияСвойств(ОбъектСтруктура, Объект);
	Если ИдентификаторИнструкции = Неопределено Тогда
		// Определяем применяемую инструкцию из данных документа
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ОбъектСтруктура);
	Иначе
		// Применяемая инструкция указана явно
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ОбъектСтруктура, , ИдентификаторИнструкции);
	КонецЕсли;
	ЭтаФорма["ПрименяемаяИнструкция_СтруктураСвойств"] = Новый ФиксированнаяСтруктура(ПрименяемаяИнструкцияСтруктура);
	Начисление					= ПрименяемаяИнструкцияСтруктура["Начисление"];
	НачислениеВБудущем			= ПрименяемаяИнструкцияСтруктура["НачислениеВБудущем"];
	Вычет						= ПрименяемаяИнструкцияСтруктура["Вычет"];
	ВычетВБудущем				= ПрименяемаяИнструкцияСтруктура["ВычетВБудущем"];
	РаспределениеВозможно		= ПрименяемаяИнструкцияСтруктура["РаспределениеВозможно"];
	НалоговыйАгент				= ПрименяемаяИнструкцияСтруктура["НалоговыйАгент"];
	СчетРасчетовИспользуется	= ПрименяемаяИнструкцияСтруктура["СчетРасчетовИспользуется"];
	КодВидаТовараИспользуется	= ПрименяемаяИнструкцияСтруктура["КодВидаТовараИспользуется"];
	КомиссионнаяЗакупкаКомиссионер = ПрименяемаяИнструкцияСтруктура["КомиссионнаяЗакупкаКомиссионер"];
	
	// Настраиваем элементы формы
	Элементы["СоставНФАСчетНачислениеДт"].Видимость			= Начисление;
	Элементы["СоставНФАСубконто1НачислениеДт"].Видимость	= Начисление;
	Элементы["СоставНФАСубконто2НачислениеДт"].Видимость	= Начисление;
	Элементы["СоставНФАСубконто3НачислениеДт"].Видимость	= Начисление;
	Элементы["СоставНФАКПСНачислениеДт"].Видимость			= Начисление;
	Элементы["СоставНФАКЭКНачислениеДт"].Видимость			= Начисление;
	
	Элементы["СоставНФАНДСКВычету"].Видимость				= Вычет;
	Элементы["СоставНФАНДСКРаспределению"].Видимость		= Вычет И РаспределениеВозможно;
	Элементы["СоставНФАСчетВычетКт"].Видимость				= Вычет;
	Элементы["СоставНФАКПСВычетКт"].Видимость				= Вычет;
	// Реквизиты удалены
	//Элементы["СоставНФАСубконто1ВычетКт"].Видимость			= Вычет;
	//Элементы["СоставНФАСубконто2ВычетКт"].Видимость			= Вычет;
	//Элементы["СоставНФАСубконто3ВычетКт"].Видимость			= Вычет;
	
	Элементы["СоставНФАСчет30304"].Видимость				= Начисление ИЛИ Вычет;
	Элементы["СоставНФАКПС30304"].Видимость					= Начисление ИЛИ Вычет;
	
	Элементы["СоставНФАСчетРасчетов"].Видимость				= СчетРасчетовИспользуется;
	Элементы["СоставНФАКПССчетРасчетов"].Видимость			= СчетРасчетовИспользуется;
	
	Элементы["СоставНФАКодВидаТовара"].Видимость			= КодВидаТовараИспользуется;
	
	ЗаголовокКоманды = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Применяемая инструкция (%1)'"),
		ПрименяемаяИнструкцияСтруктура["Идентификатор"]);
	Элементы["ФормаПрименяемаяИнструкция"].Заголовок = ЗаголовокКоманды;
	
	УчетНДС.НастроитьФорму_ВидимостьКолонок(ЭтаФорма);
	
	// Параметры выбора счета СчетНачислениеДт
	НовыеПараметры = Новый Массив();
	Если Начисление Тогда
		Если ТипЗнч(ПрименяемаяИнструкцияСтруктура["СчетНачислениеДт"]) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
			ВремМассив = Новый Массив();
			ВремМассив.Добавить(ПрименяемаяИнструкцияСтруктура["СчетНачислениеДт"]);
		Иначе
			ВремМассив = ПрименяемаяИнструкцияСтруктура["СчетНачислениеДт"];
		КонецЕсли;
		НовыйПараметр = Новый ПараметрВыбора("ОграниченияСписокСчетов", ВремМассив);
		НовыеПараметры.Добавить(НовыйПараметр);
		
		НовыйПараметр = Новый ПараметрВыбора("Отбор.ЗапретитьИспользоватьВПроводках", Ложь);
		НовыеПараметры.Добавить(НовыйПараметр);
		
		НовыйПараметр = Новый ПараметрВыбора("Отбор.ЭлементГруппа", Ложь);
		НовыеПараметры.Добавить(НовыйПараметр);
	Иначе
		Счет = Неопределено;
	КонецЕсли;
	Элементы["СоставНФАСчетНачислениеДт"].ПараметрыВыбора = Новый ФиксированныйМассив(НовыеПараметры);
	
	// Параметры выбора счета СчетВычетКт
	НовыеПараметры = Новый Массив();
	Если Вычет Тогда
		Если ТипЗнч(ПрименяемаяИнструкцияСтруктура["СчетВычетКт"]) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
			ВремМассив = Новый Массив();
			ВремМассив.Добавить(ПрименяемаяИнструкцияСтруктура["СчетВычетКт"]);
		Иначе
			ВремМассив = ПрименяемаяИнструкцияСтруктура["СчетВычетКт"];
		КонецЕсли;
		НовыйПараметр = Новый ПараметрВыбора("ОграниченияСписокСчетов", ВремМассив);
		НовыеПараметры.Добавить(НовыйПараметр);
		
		НовыйПараметр = Новый ПараметрВыбора("Отбор.ЗапретитьИспользоватьВПроводках", Ложь);
		НовыеПараметры.Добавить(НовыйПараметр);
		
		НовыйПараметр = Новый ПараметрВыбора("Отбор.ЭлементГруппа", Ложь);
		НовыеПараметры.Добавить(НовыйПараметр);
	Иначе
		Счет = Неопределено;
	КонецЕсли;
	Элементы["СоставНФАСчетВычетКт"].ПараметрыВыбора = Новый ФиксированныйМассив(НовыеПараметры);
	
	
	//---
	// Механизм автоустановки субконто
	//---
	МассивОбслуживаемыхИдентификаторов = Новый Массив();
	Если Начисление Тогда
		МассивОбслуживаемыхИдентификаторов.Добавить(1);
	КонецЕсли;
	// Реквизиты удалены
	//Если Вычет Тогда
	//	МассивОбслуживаемыхИдентификаторов.Добавить(2);
	//КонецЕсли;
	УчетНДС.АвтоустановкаСубконто_УстановитьОбслуживаемыеИдентификаторы(ЭтаФорма, МассивОбслуживаемыхИдентификаторов);
	
	// Очищаем и инициализируем по возможности счета СчетНачислениеДт, СчетВычетКт
	Если ЗаполнитьКолонкиСчетовЗначениямиПоУмолчанию = Истина Тогда
		СчетНачислениеДт	= ПрименяемаяИнструкцияСтруктура["СчетНачислениеДт"];
		СчетВычетКт			= ПрименяемаяИнструкцияСтруктура["СчетВычетКт"];
		
		УстановитьСчетНачислениеДт	= НЕ (ПрежнийСчетНачислениеДт = СчетНачислениеДт);
		УстановитьСчетВычетКт		= НЕ (ПрежнийСчетВычетКт = СчетВычетКт);
		
		Если УстановитьСчетНачислениеДт ИЛИ УстановитьСчетВычетКт Тогда
			ЗаполняющаяСтруктура = Новый Структура();
			ЗаполняющаяСтруктура.Вставить("Счет30304", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("303.04"));
			
			Если УстановитьСчетНачислениеДт Тогда
				Если НЕ ЗначениеЗаполнено(СчетНачислениеДт) ИЛИ НЕ ПрименяемаяИнструкцияСтруктура["СчетНачислениеДтЕдинственный"] Тогда
					СчетНачислениеДт = Неопределено;
				КонецЕсли;
				ЗаполняющаяСтруктура.Вставить("СчетНачислениеДт",		СчетНачислениеДт);
				ЗаполняющаяСтруктура.Вставить("КПСНачислениеДт",		Неопределено);
				ЗаполняющаяСтруктура.Вставить("КЭКНачислениеДт",		Неопределено);
				ЗаполняющаяСтруктура.Вставить("Субконто1НачислениеДт",	Неопределено);
				ЗаполняющаяСтруктура.Вставить("Субконто2НачислениеДт",	Неопределено);
				ЗаполняющаяСтруктура.Вставить("Субконто3НачислениеДт",	Неопределено);
				ЗаполняющаяСтруктура.Вставить("СчетРасчетов",			Неопределено);
				ЗаполняющаяСтруктура.Вставить("КПССчетРасчетов",		Неопределено);
			КонецЕсли;
			
			Если УстановитьСчетВычетКт Тогда
				ЗаполняющаяСтруктура.Вставить("КПСВычетКт",			Неопределено);
				// Реквизиты удалены
				//ЗаполняющаяСтруктура.Вставить("Субконто1ВычетКт",	Неопределено);
				//ЗаполняющаяСтруктура.Вставить("Субконто2ВычетКт",	Неопределено);
				//ЗаполняющаяСтруктура.Вставить("Субконто3ВычетКт",	Неопределено);
			КонецЕсли;
			
			Для Каждого СтрокаТЧ Из Объект["СоставНФА"] Цикл
				Если УстановитьСчетВычетКт Тогда
					ЗаполняющаяСтруктура.Вставить("СчетВычетКт",
						?(СтрокаТЧ["НДСКРаспределению"],
							ПрименяемаяИнструкцияСтруктура["СчетВычетКтКРаспределениюПоУмолчанию"],
							ПрименяемаяИнструкцияСтруктура["СчетВычетКтБезРаспределенияПоУмолчанию"]));
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, ЗаполняющаяСтруктура);
			КонецЦикла;
			
			//---
			// Механизм автоустановки субконто
			//---
			УчетНДС.АвтоустановкаСубконто_ВыполнитьАвтоустановкуЗначений(ЭтаФорма, "СоставНФА");
			
			// При изменении КФО,Дата мог измениться применяемый рабочий счет.
			// Поэтому пробуем установить КПС.
			Если УстановитьСчетНачислениеДт Тогда
				ЗаполнитьКолонкуКЭК = Истина;
				КЭКНачислениеДт = ПрименяемаяИнструкцияСтруктура.КЭКНачислениеДт;
				Если ЗначениеЗаполнено(КЭКНачислениеДт) Тогда
					ЗаполнитьКолонкуКЭК = Ложь;
					
					Для Каждого СтрокаТЧ Из Объект["СоставНФА"] Цикл
						СтрокаТЧ.КЭКНачислениеДт = КЭКНачислениеДт;
					КонецЦикла;
				КонецЕсли;
				
				ОписаниеТаблицы = Новый Структура();
				ОписаниеТаблицы.Вставить("ИмяКолонкиСчет",		"СчетНачислениеДт");
				ОписаниеТаблицы.Вставить("ИмяКолонкиКЭК",		"КЭКНачислениеДт");
				ПараметрыЗаполнения = Новый Структура();
				ПараметрыЗаполнения.Вставить("Организация",					Объект["Организация"]);
				ПараметрыЗаполнения.Вставить("Дата",						Объект["Дата"]);
				ПараметрыЗаполнения.Вставить("КФО",							Объект["КФО"]);
				ПараметрыЗаполнения.Вставить("ИФО",							Объект["ИФО"]);
				ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКЭК",			ЗаполнитьКолонкуКЭК);
				ПараметрыЗаполнения.Вставить("СторонаПроводки",				"Дт");
				ПараметрыЗаполнения.Вставить("ЗаполнитьТолькоПустыеПоля",	Истина);
				Если АвтоустановкаКПС Тогда
					ОписаниеТаблицы.Вставить("ИмяКолонкиКПС",		"КПСНачислениеДт");
					ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКПС",					Истина);
				КонецЕсли;
				
				УчетНДС.ЗаполнитьТаблицуПоРабочемуПлануСчетов(Объект["СоставНФА"], ОписаниеТаблицы, ПараметрыЗаполнения);
				
				// Начисление (КЭК и КПС)
				ПараметрыЗаполнения = Новый Структура();
				ПараметрыЗаполнения.Вставить("Организация",		Объект["Организация"]);
				ПараметрыЗаполнения.Вставить("Дата",			Объект["Дата"]);
				ПараметрыЗаполнения.Вставить("ИмяКолонкиСчет",	"СчетНачислениеДт");
				ПараметрыЗаполнения.Вставить("ИмяКолонкиКПС",	"КПСНачислениеДт");
				ПараметрыЗаполнения.Вставить("ИмяКолонкиКЭК",	"КЭКНачислениеДт");
				
				УчетНДС.ЗаполнитьКЭК189иКПС(Объект["СоставНФА"], ПараметрыЗаполнения);
			КонецЕсли;
				
			Если УстановитьСчетВычетКт И АвтоустановкаКПС Тогда
				ОписаниеТаблицы = Новый Структура();
				ОписаниеТаблицы.Вставить("ИмяКолонкиСчет",		"СчетВычетКт");
				ОписаниеТаблицы.Вставить("ИмяКолонкиКПС",		"КПСВычетКт");
				ПараметрыЗаполнения = Новый Структура();
				ПараметрыЗаполнения.Вставить("Организация",							Объект["Организация"]);
				ПараметрыЗаполнения.Вставить("Дата",								Объект["Дата"]);
				ПараметрыЗаполнения.Вставить("КФО",									Объект["КФО"]);
				ПараметрыЗаполнения.Вставить("ИФО",									Объект["ИФО"]);
				ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКПС",					Истина);
				ПараметрыЗаполнения.Вставить("ЗаполнитьТолькоПустыеПоля",			Истина);
				УчетНДС.ЗаполнитьТаблицуПоРабочемуПлануСчетов(Объект["СоставНФА"], ОписаниеТаблицы, ПараметрыЗаполнения);
			КонецЕсли;
			
			Если АвтоустановкаКПС Тогда
				ОписаниеТаблицы = Новый Структура();
				ОписаниеТаблицы.Вставить("ИмяКолонкиСчет",		"Счет30304");
				ОписаниеТаблицы.Вставить("ИмяКолонкиКПС",		"КПС30304");
				ПараметрыЗаполнения = Новый Структура();
				ПараметрыЗаполнения.Вставить("Организация",							Объект["Организация"]);
				ПараметрыЗаполнения.Вставить("Дата",								Объект["Дата"]);
				ПараметрыЗаполнения.Вставить("КФО",									Объект["КФО"]);
				ПараметрыЗаполнения.Вставить("ИФО",									Объект["ИФО"]);
				ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКПС",					Истина);
				ПараметрыЗаполнения.Вставить("ЗаполнитьТолькоПустыеПоля",			Истина);
				ПараметрыЗаполнения.Вставить("ВидыПоказателяКПС",					ПрименяемаяИнструкцияСтруктура["ВидыПоказателяКПС30304"]);
				УчетНДС.ЗаполнитьТаблицуПоРабочемуПлануСчетов(Объект["СоставНФА"], ОписаниеТаблицы, ПараметрыЗаполнения);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если КомиссионнаяЗакупкаКомиссионер Тогда
		
		ЗаголовкиСтранницыСчетаФактурыОтКомиссионера = ЗаголовокСтраницаСчетаФактурыОтКомиссионера(ЭтотОбъект);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтотОбъект.Элементы, "ГруппаСчетаФактурыОтКомиссионера",
			"Заголовок", ЗаголовкиСтранницыСчетаФактурыОтКомиссионера.ЗаголовокСтранницы);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтотОбъект.Элементы, "ПокупателиПокупательСФ",
			"Заголовок", ЗаголовкиСтранницыСчетаФактурыОтКомиссионера.ЗаголовокРеквизитаПродавцов);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтотОбъект.Элементы, "ПокупателиГрузополучатель",
			"Заголовок", ЗаголовкиСтранницыСчетаФактурыОтКомиссионера.ЗаголовокРеквизитаГрузоотправителя);
		
	КонецЕсли;
	
	ОграничитьСписокВыбораСтавкиНДС();
	
	ЭтоНалоговыйАгент = НалоговыйАгент;
	
КонецПроцедуры

&НаСервере
Процедура ОграничитьСписокВыбораСтавкиНДС()
	
	ОграничитьСписокВыбора = Ложь;
	
	СписокЗначений = Новый Массив();
	
	Если Объект.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Реализация0 Тогда
		ОграничитьСписокВыбора = Истина;
		СписокЗначений.Добавить(Перечисления.СтавкиНДС.НДС0);
	КонецЕсли;
	
	ЭлементФормы = Элементы.СоставНФАСтавкаНДС;
	
	ЭлементФормы.РежимВыбораИзСписка = ОграничитьСписокВыбора;
	
	Если ОграничитьСписокВыбора Тогда
		ЭлементФормы.СписокВыбора.ЗагрузитьЗначения(СписокЗначений);
	Иначе
		ЭлементФормы.СписокВыбора.Очистить();
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ОчиститьСтавкиНДСВнеСпискаВыбора()
	
	ЭлементФормы = Элементы.СоставНФАСтавкаНДС;
	
	Если Не ЭлементФормы.РежимВыбораИзСписка Тогда
		Возврат;
	КонецЕсли;
	
	СписокВыбора = ЭлементФормы.СписокВыбора;
	
	Если СписокВыбора.Количество() = 0 Тогда
		Возврат;
		
	ИначеЕсли СписокВыбора.Количество() = 1 Тогда
		НоваяСтавка = СписокВыбора.Получить(0).Значение;
		
	Иначе
		НоваяСтавка = Неопределено;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.СоставНФА Цикл
		СтавкаНДС = СтрокаТаблицы.СтавкаНДС;
		
		Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СписокВыбора.НайтиПоЗначению(СтавкаНДС) = Неопределено Тогда
			СтрокаТаблицы.СтавкаНДС = НоваяСтавка;
			
			РассчитатьСуммыВСтрокеТаблицы(СтрокаТаблицы, ЭлементФормы.Имя);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

&НаКлиенте
Процедура НастроитьФормуКлиент()
	
	// Обоновляем флажки формы:
	ДокументыОснованияЗаголовок = ?(ЗначениеЗаполнено(Объект["ДокументОснование"]), "1", "");
	
	// Настраиваем элементы формы:
	НастроитьФормуКлиент_РегистрацияВДопЛистеПриИзменении();
	
КонецПроцедуры	

&НаКлиенте
Процедура НастроитьФормуКлиент_ВыставленПриИзменении()
	
	НовДоступность = Объект["Выставлен"];
	
	Элементы["ГруппаДатаВидВыставления"].Доступность = НовДоступность;
	
КонецПРоцедуры	

&НаКлиенте
Процедура НастроитьФормуКлиент_РегистрацияВДопЛистеПриИзменении()
	
	НовДоступность = Объект["РегистрацияВДопЛисте"];
	
	Элементы["КорректируемыйПериод"].Доступность = НовДоступность;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВзаимосвязанныеПоляСчетВычетКт(ИзмененныйЭлемент)
	
	ТекДанные = Элементы["СоставНФА"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИзмененныйЭлемент.Имя = "СоставНФАНДСКРаспределению" Тогда
		// Изменили флажок "К распределению".
		// Будем настраивать поле счета.
		СчетВычетКт = ТекДанные["СчетВычетКт"];
		УстановитьСчет = НЕ ЗначениеЗаполнено(СчетВычетКт)
			ИЛИ СчетВычетКт = ПрименяемаяИнструкция_СтруктураСвойств["СчетВычетКтКРаспределениюПоУмолчанию"]
			ИЛИ СчетВычетКт = ПрименяемаяИнструкция_СтруктураСвойств["СчетВычетКтБезРаспределенияПоУмолчанию"];
		Если УстановитьСчет Тогда
			ТекДанные["СчетВычетКт"] = ?(ТекДанные["НДСКРаспределению"],
				ПрименяемаяИнструкция_СтруктураСвойств["СчетВычетКтКРаспределениюПоУмолчанию"],
				ПрименяемаяИнструкция_СтруктураСвойств["СчетВычетКтБезРаспределенияПоУмолчанию"]);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьНомерДляПечатиСервер()
	
	НомерСФ = УчетНДС.ОпределитьПоОбъектуНомерСФДляВыводаВРегистрыУчета(Объект);
	
	НомерДляПечати = НомерСФ["Номер"];
	
	НовВидимость = НЕ (НомерДляПечати = Объект.Номер);
	
	Элементы["НомерДляПечати"].Видимость = НовВидимость;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокАвансовПоДокументу(Основание)
	АдресТаблицыАвансов = "";
	ТаблицаАвансов = Документы.СчетФактураВыданный.СписокАвансовПоДокументу(Основание);	
	Если ТаблицаАвансов.Количество() > 1 тогда
		АдресТаблицыАвансов = ПоместитьВоВременноеХранилище(ТаблицаАвансов); 
	КонецЕсли;	
	Возврат АдресТаблицыАвансов;	
КонецФункции

&НаСервере
Процедура ЗаполнитьНаОснованииСервер(ПараметрыЗаполнения)
	
	Перем ОписаниеОшибки, НоваяТиповаяОперация, ДополнительныйОтбор;
	
	ИмяПоля = ПараметрыЗаполнения.ИмяПоля;
	
	Если ПараметрыЗаполнения.РезультатФормыУточнения <> Неопределено Тогда
		ДополнительныйОтбор	= ПараметрыЗаполнения.РезультатФормыУточнения.ДополнительныйОтбор;
	КонецЕсли;
	
	ДанныеЗаполнения = Новый Структура();
	ДанныеЗаполнения.Вставить("ОснованиеСсылка",	Объект.ДокументОснование);
	ДанныеЗаполнения.Вставить("СчетНаОплату",		Объект.СчетНаОплату);
	ДанныеЗаполнения.Вставить("ИмяПоля",			ИмяПоля);
	ДанныеЗаполнения.Вставить("ДополнительныйОтбор",ДополнительныйОтбор);
	
	Если Документы.СчетФактураВыданный.ЗаполнитьНаОсновании(ДанныеЗаполнения, Объект, ОписаниеОшибки, НоваяТиповаяОперация) Тогда
		ЗаполнитьТиповуюОперациюВФормеДокумента(ЭтаФорма, НоваяТиповаяОперация);
		
		//---
		// Механизм автоустановки субконто
		//---
		УчетНДС.АвтоустановкаСубконто_ЗаполнитьСлужебныеКолонкиРедактируемыхТаблиц(ЭтаФорма);
		
		Объект.ДокументыОбОтгрузке.Очистить();
		УстановитьНадписьДокументыОбОтгрузке();
		УстановитьВидимостьНадписиДокументыОбОтгрузке();
		
		УстановитьНадписьСчетаФактурыНаАванс();
		УстановитьВидимостьНадписиСчетаФактурыНаАванс();
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
	КонецЕсли;	
	
	НастроитьФормуСервер_ПоДокументуОснованию();
	
	НастроитьФормуСервер_ПоПрименяемойИнструкции(Ложь);
	
	// Прослеживаемость
	НастроитьФормуПрослеживаемостьСервер();
	// Конец Прослеживаемость
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПРоцедуры	

&НаСервере
Процедура ЗаполнитьТиповуюОперациюВФормеДокумента(ФормаДокумента, НоваяТиповаяОперация)
	Перем	ТиповаяОперацияСсылка,
			ЗначенияРеквизитов;
			
	Если ТипЗнч(НоваяТиповаяОперация) = Тип("Структура") Тогда
		
		Если НЕ Константы.ФормированиеПроводокОбособленноОтДокумента.Получить() Тогда
			
			// Обновляем состав реквизитов типовой операции на форме документа:
			Если НоваяТиповаяОперация.Свойство("Ссылка", ТиповаяОперацияСсылка) Тогда
				Если ЗначениеЗаполнено(ТиповаяОперацияСсылка) Тогда
					Попытка
						ФормаДокумента["ТиповаяОперация"] = ТиповаяОперацияСсылка;
						БухгалтерскиеОперацииСервер.ПриИзмененииТиповойОперации(ФормаДокумента.Элементы["БухгалтерскаяОперация"]);//ТиповыеОперации_ТиповаяОперация"]);
					Исключение
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
			
			// Задаем значения реквизитов типовой операции:
			ЗаполнитьЗначенияСвойств(ФормаДокумента, НоваяТиповаяОперация["ЗначенияРеквизитов"]);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДокумент()
	
	Объект.ДокументОснование = Неопределено;
	
	Объект.СоставНФА.Очистить();
	
КонецПРоцедуры	

&НаКлиенте
Процедура РассчитатьСуммыВСтроке(Элемент)
	
	ТекДанные = Элементы.СоставНФА.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьСуммыВСтрокеТаблицы(ТекДанные, Элемент.Имя);
	
КонецПроцедуры	

&НаКлиенте
Процедура РассчитатьСуммыВСтрокеТаблицы(СтрокаТаблицы, ИмяЭлемента)
	
	Перем ИмяИзмененногоПоля;
	
	// Колонки, не относящиеся к НДС:
	Если	ИмяЭлемента = "СоставНФАКоличество"
		ИЛИ	ИмяЭлемента = "СоставНФАЦена" Тогда
		СтрокаТаблицы["Сумма"] = СтрокаТаблицы["Количество"] * СтрокаТаблицы["Цена"];
		ИмяИзмененногоПоля = "Сумма";
		
	// Колонки, относящиеся к НДС:
	ИначеЕсли ИмяЭлемента = "СоставНФАСумма" Тогда
		ИмяИзмененногоПоля = "Сумма";
		
	ИначеЕсли ИмяЭлемента = "СоставНФАСуммаНДС" Тогда
		ИмяИзмененногоПоля = "СуммаНДС";
		
	ИначеЕсли	ИмяЭлемента = "СоставНФАВсего"
		ИЛИ		ИмяЭлемента = "СоставНФАВсегоАванс"	Тогда
		ИмяИзмененногоПоля = "Всего";
		
	ИначеЕсли ИмяЭлемента = "СоставНФАСтавкаНДС" Тогда
		ИмяИзмененногоПоля = "СтавкаНДС";
		
	КонецЕсли;
	
	СтруктураИменПолей = Новый Структура();
	СтруктураИменПолей.Вставить("Сумма",			"Сумма");
	СтруктураИменПолей.Вставить("СуммаНДС",			"СуммаНДС");
	СтруктураИменПолей.Вставить("Всего",			"Всего");
	СтруктураИменПолей.Вставить("СтавкаНДС",		"СтавкаНДС");
	УчетНДСКлиентСервер.РассчитатьСуммы(СтрокаТаблицы, ИмяИзмененногоПоля, СтруктураИменПолей, ЭтоАванс, ЭтоНалоговыйАгент);
	
КонецПроцедуры	
	
&НаКлиенте
Процедура УточнитьАналитикуЗаполнения(ИмяПоля)
	
	ДокументОснование = Объект.ДокументОснование;
	
	Если ВозможенВводНесколькихДокументовНаОснованииОдного(ДокументОснование) Тогда
		АдресТаблицыАвансов = СписокАвансовПоДокументу(ДокументОснование);
		Если ЗначениеЗаполнено(АдресТаблицыАвансов) Тогда
			// Обнаружено несколько авансов, необходимо выбрать один из них
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ОснованиеСсылка",	ДокументОснование);
			ПараметрыФормы.Вставить("ТаблицаАвансов",	АдресТаблицыАвансов);
			ПараметрыФормы.Вставить("ИзФормыОбъекта",	Истина);
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ИмяПоля", ИмяПоля);
			
			Оповещение = Новый ОписаниеОповещения("УточнитьАналитикуЗаполнения_Завершение", ЭтотОбъект, ДополнительныеПараметры);
			ОткрытьФорму("Документ.СчетФактураВыданный.Форма.ФормаВводаНаОсновании", ПараметрыФормы,,,,,Оповещение);
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПодтвердитьИЗаполнитьНаОсновании(ИмяПоля);
	
КонецПроцедуры

&НаКлиенте
Функция ВозможенВводНесколькихДокументовНаОснованииОдного(Основание)
	
	Возврат (СписокТиповДокументовНесколькоНаОснованииОдного.НайтиПоЗначению(ТипЗнч(Основание)) <> Неопределено);
	
КонецФункции

&НаКлиенте
Процедура УточнитьАналитикуЗаполнения_Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		ПодтвердитьИЗаполнитьНаОсновании(ДополнительныеПараметры["ИмяПоля"], Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИЗаполнитьНаОсновании(ИмяПоля, Результат = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru='Заполнить редактируемый счет-фактуру на основании указанного документа?'");
	ТекстЗаголовка = НСтр("ru='Счет-фактура выданный'");
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяПоля", ИмяПоля);
	ДополнительныеПараметры.Вставить("РезультатФормыУточнения", Результат);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПодтвердитьИЗаполнитьНаОсновании_Выбор", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет, ТекстЗаголовка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИЗаполнитьНаОсновании_Выбор(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьНаОснованииСервер(ДополнительныеПараметры);
	Иначе
		//---
		// Механизм автоустановки субконто
		//---
		Подключаемый_АвтоустановкаСубконто_ПриИзмененииЗначенияАвтоустановки_Клиент(Элементы["ДокументОснование"]);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ДобавитьУсловноеОформление_СовместимостьБГУ1(УсловноеОформление);
	
	ДобавитьУсловноеОформление_НедоступностьКнопкиЗаполнитьНаОсновании(УсловноеОформление);
	
	ДобавитьУсловноеОформление_НедоступностьСчетаВычета(УсловноеОформление);
	
	УчетНДС.ДобавитьУсловноеОформлениеОтметкиНезаполненнойКолонкиПриНаличииСуммыНалога(ЭтаФорма, "СчетНачислениеДт");
	УчетНДС.ДобавитьУсловноеОформлениеОтметкиНезаполненнойКолонкиПриНаличииСуммыНалога(ЭтаФорма, "КПСНачислениеДт");
	УчетНДС.ДобавитьУсловноеОформлениеОтметкиНезаполненнойКолонкиПриНаличииСуммыНалога(ЭтаФорма, "КЭКНачислениеДт");
	
	УчетНДС.ДобавитьУсловноеОформлениеОтметкиНезаполненнойКолонкиПриНаличииСуммыНалога(ЭтаФорма, "СчетВычетКт", Истина);
	УчетНДС.ДобавитьУсловноеОформлениеОтметкиНезаполненнойКолонкиПриНаличииСуммыНалога(ЭтаФорма, "КПСВычетКт", Истина);
	
	УчетНДС.ДобавитьУсловноеОформлениеОтметкиНезаполненнойКолонкиПриНаличииСуммыНалога(ЭтаФорма, "Счет30304");
	УчетНДС.ДобавитьУсловноеОформлениеОтметкиНезаполненнойКолонкиПриНаличииСуммыНалога(ЭтаФорма, "КПС30304");
	
	// Вывод значения автоустановки для субконто1-3 вида СФПолученные (если пустое)
	// (аналогично заполнению таких полей в модуле документа перед записью)
	СубконтоСФПолученные_ДобавитьУсловноеОформление(1, "СчетНачислениеДт",	"Субконто1НачислениеДт",	"СоставНФАСубконто1НачислениеДт");
	СубконтоСФПолученные_ДобавитьУсловноеОформление(2, "СчетНачислениеДт",	"Субконто2НачислениеДт",	"СоставНФАСубконто2НачислениеДт");
	СубконтоСФПолученные_ДобавитьУсловноеОформление(3, "СчетНачислениеДт",	"Субконто3НачислениеДт",	"СоставНФАСубконто3НачислениеДт");
	
	ДобавитьУсловноеОформление_КомиссионнаяТорговля(УсловноеОформление);
	
	ДобавитьУсловноеОформление_НедоступностьКолонкиСчетРасчетовПриРеализации(УсловноеОформление);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_СовместимостьБГУ1(УсловноеОформление)
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Совместимость с БГУ1 - Отметка Причины налогообложения, несоответствующей виду счета-фактуры'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПричинаНалогообложения");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Новый ПолеКомпоновкиДанных("КэшНДС_СовместимостьБГУ1_НекорректнаяПричинаНалогообложения");
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ПричинаНалогообложения");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_НедоступностьКнопкиЗаполнитьНаОсновании(УсловноеОформление)
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Кнопка ""Заполнить на основании"" - цвет недоступной при пустом документе-основании'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ДокументОснование");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Условие.ПравоеЗначение = Неопределено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветРамки);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ЗаполнитьНаОсновании");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_НедоступностьСчетаВычета(УсловноеОформление)
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Снятый флажок ""Вычет"" - недоступные поля группы СчетВычетКт'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
