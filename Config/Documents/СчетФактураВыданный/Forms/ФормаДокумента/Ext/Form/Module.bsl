	ПараметрыПриИзменении.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПриИзменении.ГруппаСостояниеЭДО    = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриИзмененииКлючевыхРеквизитовЭДО(ПараметрыПриИзменении);
	
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтогиКомиссия(Форма)
	
	СуммаНДСПоКомиссии = 0;
	ВсегоПоКомиссии = 0;
	
	Для Каждого СтрокаТЧ Из Форма.Объект.СоставНФА Цикл
		Если СтрокаТЧ.КомиссионнаяТорговля Тогда
			СуммаНДСПоКомиссии = СуммаНДСПоКомиссии + СтрокаТЧ.СуммаНДС;
			ВсегоПоКомиссии = ВсегоПоКомиссии + СтрокаТЧ.Всего;
		КонецЕсли;
	КонецЦикла;
	
	Форма.Объект.СуммаНДСДокументаКомиссия = СуммаНДСПоКомиссии;
	Форма.Объект.СуммаДокументаКомиссия = ВсегоПоКомиссии;
	
	Если Форма.Объект.ПричинаНалогообложения = ПредопределенноеЗначение("Перечисление.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаПокупку") Тогда
		Форма.Объект.СуммаДокументаКомиссия = Форма.Объект.СуммаДокумента;
		Форма.Объект.СуммаНДСДокументаКомиссия = Форма.Объект.СуммаНДС;
	КонецЕсли;
	
КонецПроцедуры

