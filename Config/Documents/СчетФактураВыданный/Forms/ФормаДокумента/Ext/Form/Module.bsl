&НаКлиенте
Процедура ДокументОснованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения_Закрытие = Новый ОписаниеОповещения("ДокументОснованиеНачалоВыбора_Выбор", ЭтотОбъект);
	ТекущийЭлементСписка = СписокДокументовОснования.НайтиПоЗначению(СоответствиеПредставленияВидовДокументов.Получить(Строка(ТипЗнч(Объект["ДокументОснование"]))));
	
	ЭтаФорма.ПоказатьВыборИзСписка(ОписаниеОповещения_Закрытие, СписокДокументовОснования, Элемент, ТекущийЭлементСписка);
	
КонецПроцедуры
&НаКлиенте
Процедура ДокументОснованиеНачалоВыбора_Выбор(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НазваниеДокумента = ВыбранныйЭлемент.Значение;
	
	Отбор = Новый Структура("Организация", Объект.Организация);
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Отбор.Вставить("Контрагент", Объект.Контрагент);
	КонецЕсли;	
	Если НЕ НазваниеДокумента = "КассовоеПоступление" И ЗначениеЗаполнено(Объект.Договор) Тогда
		Отбор.Вставить("Договор", Объект.Договор);
	КонецЕсли;	
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	ОткрытьФорму("Документ." + НазваниеДокумента + ".ФормаВыбора", ПараметрыФормы, Элементы["ДокументОснование"]);
	
КонецПроцедуры
