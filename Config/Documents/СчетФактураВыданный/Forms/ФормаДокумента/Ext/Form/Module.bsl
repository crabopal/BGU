Процедура ЗаполнитьДанныеПоОСВСтрокеСервер(ИдентификаторСтроки)
	
	ТекДанные = Объект.СоставНФА.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если НЕ ЗначениеЗаполнено(ТекДанные["ЕдиницаИзмерения"]) Тогда
		ТекДанные["ЕдиницаИзмерения"] = ЕдИзмШт;
	КонецЕсли;
	
	ТекДанные.ПрослеживаемыйТовар = ?(ВедетсяУчетПрослеживаемыхТоваров, ПрослеживаемостьБГУ.ПрослеживаемоеОсновноеСредство(ТекДанные.НФА, Объект), Ложь);
