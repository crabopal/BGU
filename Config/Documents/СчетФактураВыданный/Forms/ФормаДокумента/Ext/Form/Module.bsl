&НаКлиенте
Процедура СоставНФАСчет30304НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекДанные = Элементы["СоставНФА"].ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент,
															СтандартнаяОбработка,
															Новый Структура("Счет, КПС, КФО",
																			ТекДанные["Счет30304"],
																			ТекДанные["КПС30304"],
																			Объект["КФО"]),
															Объект["Организация"],
															Объект["ИФО"],
															ПрименяемаяИнструкция_СтруктураСвойств["Счет30304"],
															Объект["КФО"],
															ПрименяемаяИнструкция_СтруктураСвойств["ВидыПоказателяКПС30304"],
															Объект["Дата"]);
КонецПроцедуры
