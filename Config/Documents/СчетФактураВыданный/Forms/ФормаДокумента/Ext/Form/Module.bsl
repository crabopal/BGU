&НаКлиенте
Процедура ПрименяемаяИнструкция(Команда)
	
	СписокИнструкций		= УчетНДСКлиентСерверПовтИсп.ИнструкцииУчета_ПолучитьСписокИдентификаторов();
	ТекущийЭлементСписка	= СписокИнструкций.НайтиПоЗначению(ПрименяемаяИнструкция_СтруктураСвойств["Идентификатор"]);
	
	ОписаниеОповещения_Закрытие = Новый ОписаниеОповещения("ПрименяемаяИнструкция_Выбор", ЭтотОбъект);
	ЗаголовокСписка = НСтр("ru='Выберите применяемую инструкцию НДС'");
	СписокИнструкций.ПоказатьВыборЭлемента(ОписаниеОповещения_Закрытие, ЗаголовокСписка, ТекущийЭлементСписка);
	
КонецПроцедуры
&НаКлиенте
Процедура ПрименяемаяИнструкция_Выбор(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если НЕ ВыбранныйЭлемент = Неопределено Тогда
		НовоеЗначение = ВыбранныйЭлемент.Значение;
		
		ЗначениеИзменилось = НЕ (НовоеЗначение = ПрименяемаяИнструкция_СтруктураСвойств["Идентификатор"]);
		Если ЗначениеИзменилось Тогда
			НастроитьФормуСервер_ПоПрименяемойИнструкции(Истина, НовоеЗначение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

