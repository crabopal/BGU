	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Данные табличной части ДокументыОбОтгрузке
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка					КАК Ссылка,
	|	НомераСтрок				КАК НомераСтрок,
	|	НаименованиеДокумента	КАК НаименованиеДокумента,
	|	НомерДокумента			КАК НомерДокумента,
	|	ДатаДокумента			КАК ДатаДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОбОтгрузке
	|ГДЕ
	|	Ссылка В(&СсылкиНаДокументы)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [6]. Данные табличной части Покупатели
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ТЧ.ПокупательСФ = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА
	|			""""
	|		КОГДА НЕ ТЧ.ПокупательСФ.НаименованиеСокращенное = """" ТОГДА
	|			// Если задано наименование для печати - используем его
	|			ТЧ.ПокупательСФ.НаименованиеСокращенное
	|			
	|		КОГДА ТЧ.ПокупательСФ.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			И НЕ ТЧ.ПокупательСФ.ЮридическоеФизическоеЛицо.НаименованиеПолное = """" ТОГДА
	|			// Для юридических лиц есть реквизит НаименованиеПолное
	|			ВЫРАЗИТЬ(ТЧ.ПокупательСФ.ЮридическоеФизическоеЛицо.НаименованиеПолное КАК СТРОКА(1000))
	|			
	|		ИНАЧЕ
	|			ТЧ.ПокупательСФ.Наименование
	|	КОНЕЦ																		КАК ПокупательСФПредставление,
	|	ЕСТЬNULL(ТЧ.ПокупательСФ, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))	КАК ПокупательСФ,
	|	ЕСТЬNULL(ТЧ.ПокупательСФ.ЮридическоеФизическоеЛицо.ИНН, """")					КАК ПокупательИНН,
	|	ВЫБОР
	|		КОГДА ТЧ.Грузополучатель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ТЧ.Грузополучатель
	|		ИНАЧЕ ЕСТЬNULL(ТЧ.ПокупательСФ,ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|	КОНЕЦ																		КАК Грузополучатель,
	|	ВЫБОР
	|		КОГДА ТЧ.Грузополучатель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ТЧ.Грузополучатель.Представление
	|		ИНАЧЕ ЕСТЬNULL(ТЧ.ПокупательСФ.Представление,"""")
	|	КОНЕЦ																		КАК ГрузополучательПредставление,
	|	ЕСТЬNULL(ТЧ.НомерСФ,"""")														КАК НомерСФ,
	|	ЕСТЬNULL(ТЧ.ДатаСФ, ДАТАВРЕМЯ(1,1,1))										КАК ДатаСФ,
	|	ТЧ.Ссылка																	КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.СчетаФактурыОтКомиссионера	КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка В(&СсылкиНаДокументы)
	|УПОРЯДОЧИТЬ ПО
	|	ТЧ.НомерСтроки,
	|	ТЧ.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [7]. Данные табличной части СчетаФактурыНаАванс
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка				КАК Ссылка,
	|	НомерСтроки			КАК НомерСтроки,
	|	СчетФактура			КАК СчетФактура,
	|	Номер				КАК Номер,
	|	Дата				КАК Дата,
	|	НомерИсправления	КАК НомерИсправления,
	|	ДатаИсправления		КАК ДатаИсправления
	|ИЗ
	|	Документ.СчетФактураВыданный.СчетаФактурыНаАванс
	|ГДЕ
	|	Ссылка В(&СсылкиНаДокументы)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
	
	МассивРезультатов = ЗапросПечать.ВыполнитьПакет();
	
	Результат = Новый Структура();
	
	// [0]. Данные табличной части СоставНФА
	ОбщаяТаблицаСоставНФА = МассивРезультатов[0].Выгрузить();
	ОбщаяТаблицаСоставНФА.Индексы.Добавить("Ссылка");
	Результат.Вставить("ОбщаяТаблицаСоставНФА", ОбщаяТаблицаСоставНФА);
	
	// [1]. Данные табличной части РасчетноПлатежныеДокументы
	Результат.Вставить("ВыборкаДокПлатежноРасчетныеДокументы",	МассивРезультатов[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	// [3]. Список объектов для дальнейшего группового получения контактной информации (адресов)
	Результат.Вставить("СписокОбъектовДляОпределенияАдресов",	МассивРезультатов[3].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	// [4]. Данные шапки документа
	Результат.Вставить("ВыборкаШапка",							МассивРезультатов[4].Выбрать());
	
	// [5]. Данные табличной части ДокументыОбОтгрузке
	Результат.Вставить("ОбщаяТаблицаДокументыОбОтгрузке",		МассивРезультатов[5].Выгрузить());
	
	// [6]. Данные табличной части Покупатели
	Результат.Вставить("ВыборкаПокупатели",						МассивРезультатов[6].Выгрузить());
	
	// [7]. Данные табличной части СчетаФактурыНаАванс
	Результат.Вставить("ОбщаяТаблицаСчетаФактурыНаАванс",		МассивРезультатов[7].Выгрузить());
	
	// Прослеживаемость
	Если ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
		Результат.Вставить("ПоказателиПрослеживаемости", ПолучитьПоказателиПрослеживаемости(МассивОбъектов));
	КонецЕсли;
	// Конец Прослеживаемость
	
	Результат.Вставить("ПризнакиСчетовФактур", УчетНДС.ПолучитьПризнакиСчетовФактур(МассивОбъектов));
	
	Возврат Результат;
	
КонецФункции

#Область ЗаполнениеНаОсновании

Функция ПолучитьДанныеДляЗаполненияНаОсновании_АктОбОказанииУслуг(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_ТиповаяОперация = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка, "Операция,КФО");
	
	Если НЕ ЗначениеЗаполнено(Основание_ТиповаяОперация.КФО) Тогда
		Основание_ТиповаяОперация.Вставить("КФО", Перечисления.КВД.ПустаяСсылка());
	КонецЕсли;
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",			ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("КФО",		Основание_ТиповаяОперация["КФО"]);
	ЗапросЗаполнение.УстановитьПараметр("ЕдИзмШт",	Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796")); // шт.
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0].	Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка							КАК ДокументОснование,
	|	АктОбОказанииУслуг.Дата,
	|	АктОбОказанииУслуг.Организация,
	|	АктОбОказанииУслуг.ИФО,
	|	АктОбОказанииУслуг.Подразделение,
	|	АктОбОказанииУслуг.Контрагент,
	|	АктОбОказанииУслуг.Договор,
	|	АктОбОказанииУслуг.ВалютаДокумента,
	|	АктОбОказанииУслуг.РеализацияПоСтавке0,
	|	""01""												КАК КодВидаОперации,
	|	&КФО												КАК КФО,
	|	ВЫБОР
	|		КОГДА АктОбОказанииУслуг.РеализацияПоСтавке0 ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация0)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)
	|	КОНЕЦ												КАК ПричинаНалогообложения
	|ИЗ
	|	Документ.АктОбОказанииУслуг	КАК АктОбОказанииУслуг
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1].	Данные для табличной части ""СоставНФА""
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура		КАК НФА,
	|	ВЫБОР
	|		КОГДА ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка) ТОГДА
	|			ЕдиницаИзмерения
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(Номенклатура	КАК Справочник.Номенклатура).ЕдиницаИзмерения
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			&ЕдИзмШт
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|	КОНЕЦ				КАК ЕдиницаИзмерения,
	|	СодержаниеУслуги,
	|	Количество,
	|	СтавкаНДС,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			Сумма - СуммаНДС
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ				КАК Сумма,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС И НЕ Сумма = 0 ТОГДА
	|			Цена - СуммаНДС * (Цена/Сумма)
	|		ИНАЧЕ
	|			Цена
	|	КОНЕЦ				КАК Цена,
	|	СуммаНДС,
	|	Всего,
	|	КомиссионнаяТорговля,
	|	ИДСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.АктОбОказанииУслуг.УслугиОказанные	КАК УслугиОказанные
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка		= РезультатыЗаполнения[0].Выгрузить();
	ТаблицаСоставНФА	= РезультатыЗаполнения[1].Выгрузить();
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	// Код вида операции
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	// Ответственные лица
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
	Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
	Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
	
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
	
	ТабличныеЧасти	= Новый Структура("СоставНФА", ТаблицаСоставНФА);
	
	// Искомые данные:
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_КассовоеПоступление(ОснованиеСсылка, Объект, ДополнительныеПараметры, СчетФактураСсылка, ВозвратДанные)
	
	Перем	КФО,
			Контрагент,
			Договор;
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_ТиповаяОперация = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка, "Курс,Кратность");
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ИспользоватьОтборКФО		= ДополнительныеПараметры.Свойство("КФО",			КФО);
		ИспользоватьОтборКонтрагент	= ДополнительныеПараметры.Свойство("Контрагент",	Контрагент);
		ИспользоватьОтборДоговор	= ДополнительныеПараметры.Свойство("Договор",		Договор);
	Иначе
		ИспользоватьОтборКФО		= Ложь;
		ИспользоватьОтборКонтрагент	= Ложь;
		ИспользоватьОтборДоговор	= Ложь;
	КонецЕсли;
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос;
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",		ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("СчетаАванса",					УчетНДС.ПолучитьТаблицуСчетовАвансовПолученных()["МассивСчетов"]);
	ЗапросЗаполнение.УстановитьПараметр("КФО",							КФО);
	ЗапросЗаполнение.УстановитьПараметр("Контрагент",					Контрагент);
	ЗапросЗаполнение.УстановитьПараметр("Договор",						Договор);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборКФО",			ИспользоватьОтборКФО);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборКонтрагент",	ИспользоватьОтборКонтрагент);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьОтборДоговор",		ИспользоватьОтборДоговор);
	ЗапросЗаполнение.УстановитьПараметр("ПредставлениеПозицииАванса",	УчетНДСКлиентСервер.ПолучитьПредставлениеПозицииАванса());
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Все реквизиты шапки документа-основания
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка,
	|	Номер,
	|	Дата,
	|	Организация,
	|	ИФО,
	|	Подразделение,
	|	ВалютаДокумента,
	|	Курс,
	|	Кратность,
	|	НомерПервичногоДокумента,
	|	ДатаПервичногоДокумента
	|ПОМЕСТИТЬ
	|	ШапкаДокументаОснования
	|ИЗ
	|	Документ.КассовоеПоступление
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Авансы полученные из движений документа-основания
	|//
	|ВЫБРАТЬ
	|	Регистратор											КАК Регистратор,
	|	КФО													КАК КФО,
	|	ВЫРАЗИТЬ(СубконтоКт1	КАК Справочник.Контрагенты)	КАК Контрагент,
	|	ВЫРАЗИТЬ(СубконтоКт2	КАК Справочник.Договоры)	КАК Договор,
	|	СчетКт												КАК СчетКт,
	|	КПСКт												КАК КПСКт,
	|	ВЫБОР
	|		КОГДА ВалютаКт = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ИЛИ ВалютаКт ЕСТЬ NULL 
	|			ИЛИ ВалютаКт = НЕОПРЕДЕЛЕНО ТОГДА
	|			Сумма
	|		ИНАЧЕ
	|			ВалютнаяСуммаКт
	|	КОНЕЦ												КАК Сумма
	|ПОМЕСТИТЬ
	|	ДвиженияДокументаОснования
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		Регистратор = &ДокументОснованиеСсылка
	|		И СчетКт В (&СчетаАванса)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборКФО И КФО = &КФО ТОГДА
	|				ИСТИНА
	|			КОГДА &ИспользоватьОтборКФО ТОГДА
	|				ЛОЖЬ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборКонтрагент И (ВЫРАЗИТЬ(СубконтоКт1	КАК Справочник.Контрагенты)) = &Контрагент ТОГДА
	|				ИСТИНА
	|			КОГДА &ИспользоватьОтборКонтрагент ТОГДА
	|				ЛОЖЬ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборДоговор И (ВЫРАЗИТЬ(СубконтоКт2	КАК Справочник.Договоры)) = &Договор ТОГДА
	|				ИСТИНА
	|			КОГДА &ИспользоватьОтборДоговор ТОГДА
	|				ЛОЖЬ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)
	|ИНДЕКСИРОВАТЬ ПО
	|	КФО,
	|	Контрагент,
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ШапкаДокументаОснования.Ссылка										КАК ДокументОснование,
	|	ШапкаДокументаОснования.Дата										КАК Дата,
	|	ШапкаДокументаОснования.Организация									КАК Организация,
	|	ШапкаДокументаОснования.ИФО											КАК ИФО,
	|	ШапкаДокументаОснования.Подразделение								КАК Подразделение,
	|	ШапкаДокументаОснования.ВалютаДокумента								КАК ВалютаДокумента,
	|	ШапкаДокументаОснования.Курс										КАК Курс,
	|	ШапкаДокументаОснования.Кратность									КАК Кратность,
	|	""02""																КАК КодВидаОперации,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный)	КАК ПричинаНалогообложения,
	|	МАКСИМУМ(ДвиженияДокументаОснования.КФО)							КАК КФО,
	|	МАКСИМУМ(ДвиженияДокументаОснования.Контрагент)						КАК Контрагент,
	|	МАКСИМУМ(ДвиженияДокументаОснования.Договор)						КАК Договор
	|ИЗ
	|	ШапкаДокументаОснования
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ДвиженияДокументаОснования
	|		ПО	ИСТИНА
	|СГРУППИРОВАТЬ ПО
	|	ШапкаДокументаОснования.Ссылка,
	|	ШапкаДокументаОснования.Дата,
	|	ШапкаДокументаОснования.Организация,
	|	ШапкаДокументаОснования.ИФО,
	|	ШапкаДокументаОснования.Подразделение,
	|	ШапкаДокументаОснования.ВалютаДокумента,
	|	ШапкаДокументаОснования.Курс,
	|	ШапкаДокументаОснования.Кратность,
	|	""02"",
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Данные для табличной части СоставНФА
	|//
	|ВЫБРАТЬ
	|	&ПредставлениеПозицииАванса					КАК НФА,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18_118)	КАК СтавкаНДС,
	|	Сумма										КАК Всего,
	|	Сумма - Сумма * 18 / 118					КАК Сумма,
	|	Сумма * 18 / 118							КАК СуммаНДС,
	|	СчетКт										КАК СчетРасчетов,
	|	КПСКт										КАК КПССчетРасчетов
	|ИЗ
	|	ДвиженияДокументаОснования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Данные для табличной части Платежно-расчетные документы
	|//		(единственная строка)
	|ВЫБРАТЬ
	|	НомерПервичногоДокумента	КАК НомерДокумента,
	|	ДатаПервичногоДокумента		КАК ДатаДокумента
	|ИЗ
	|	ШапкаДокументаОснования
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	// [2]. Данные для реквизитов шапки
	ТаблицаШапка = РезультатыЗаполнения[2].Выгрузить();
	
	// [3]. Данные для табличной части ""СоставНФА""
	ТаблицаСоставНФА = РезультатыЗаполнения[3].Выгрузить();
	
	// [4]. Данные для табличной части ""Платежно-расчетные документы""
	ТаблицаПлатежноРасчетныеДокументы = РезультатыЗаполнения[4].Выгрузить();
	
	Если ТаблицаСоставНФА.Количество() = 0 Тогда
		Результат = Ложь;
		
		ОписаниеОшибки = НСтр("ru='Заполнение документа ""Счет-фактура выданный"" на основании документа ""Кассовое поступление"" отменено.
		|В кассовом поступлении не обнаружены авансы по договору от контрагента.'");
		
		// Искомые данные:
		ВозвратДанные.Вставить("ОписаниеОшибки", ОписаниеОшибки);
	Иначе
		Результат = Истина;
		
		Если ТаблицаШапка.Количество() > 0 Тогда
			Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
		Иначе
			Шапка = Новый Структура();
		КонецЕсли;
		Шапка.Вставить("Ссылка", Объект["Ссылка"]);
		
		// Реквизиты документа оплаты (только для аванса)
		Если ТаблицаПлатежноРасчетныеДокументы.Количество() > 0 Тогда
			ПерваяСтрокаТаблицы = ТаблицаПлатежноРасчетныеДокументы[0];
			
			Шапка.Вставить("НомерДокументаОплаты",	ПерваяСтрокаТаблицы["НомерДокумента"]);
			Шапка.Вставить("ДатаДокументаОплаты",	ПерваяСтрокаТаблицы["ДатаДокумента"]);
		КонецЕсли;
		
		// Код вида операции
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
		КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
		Шапка.Вставить("КодВидаОперации", КодВидаОперации);
		
		// Ответственные лица
		ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
		Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
		Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
		
		ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
		
		ТабличныеЧасти	= Новый Структура();
		ТабличныеЧасти.Вставить("СоставНФА",					ТаблицаСоставНФА);
		ТабличныеЧасти.Вставить("ПлатежноРасчетныеДокументы",	ТаблицаПлатежноРасчетныеДокументы);
		
		// Типовая операция для заполняемого документа:
		ТиповаяОперацияСсылка = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(
			ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.СчетФактураВыданный")));
		ТиповаяОперацияЗначенияРеквизитов = Новый Структура("Курс, Кратность");
		ЗаполнитьЗначенияСвойств(ТиповаяОперацияЗначенияРеквизитов, Шапка);
		
		ТиповаяОперация	= Новый Структура();
		ТиповаяОперация.Вставить("Ссылка",				ТиповаяОперацияСсылка);
		ТиповаяОперация.Вставить("ЗначенияРеквизитов",	ТиповаяОперацияЗначенияРеквизитов);
		
		// Искомые данные:
		ВозвратДанные.Вставить("Шапка",				Шапка);
		ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
		ВозвратДанные.Вставить("ТиповаяОперация",	ТиповаяОперация);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_КассовоеПоступление_АП(Знач ОснованиеСсылка, Знач ДанныеЗаполнения, Знач СчетФактураСсылка, Данные)
	
	ЗапросЗаполненияШапки = Новый Запрос();
	ЗапросЗаполненияШапки.УстановитьПараметр("ДокументОснованиеСсылка", ОснованиеСсылка);
	ЗапросЗаполненияШапки.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка													КАК ДокументОснование,
	|	Дата													КАК Дата,
	|	Организация												КАК Организация,
	|	ИФО														КАК ИФО,
	|	ВалютаДокумента											КАК ВалютаДокумента,
	|	Курс													КАК Курс,
	|	Кратность												КАК Кратность,
	|	НомерПервичногоДокумента								КАК НомерПервичногоДокумента,
	|	ДатаПервичногоДокумента									КАК ДатаПервичногоДокумента,
	|	СтавкаНДС												КАК СтавкаНДС,
	|	""02""													КАК КодВидаОперации,
	|	ВЫРАЗИТЬ(ДокументОснование КАК Документ.СчетНаОплату)	КАК СчетНаОплату
	|ИЗ
	|	Документ.КассовоеПоступление
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка";
	
	Данные = ПолучитьДанныеДляСчетаФактурыНаАванс(ОснованиеСсылка, ДанныеЗаполнения, СчетФактураСсылка, ЗапросЗаполненияШапки);
	
	Возврат Не ЗначениеЗаполнено(Данные.ОписаниеОшибки);
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_НакладнаяНаОтпускМ15(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	Перем ОписаниеОшибки;
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	Если НЕ УчетНДС.ДопустимВводСФНаОснованииРеализации(ОснованиеСсылка, ОписаниеОшибки) Тогда
		ВозвратДанные["ОписаниеОшибки"] = ОписаниеОшибки;
		
		Возврат Ложь;
	КонецЕсли;
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_ТиповаяОперацияСсылка		= БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(ОснованиеСсылка);
	Основание_ПустаяСтруктураРеквизитов	= Справочники.ТиповыеОперации.ПустаяСтруктураДопРеквизитовОперации(Основание_ТиповаяОперацияСсылка);
	Основание_РеквизитыТиповойОперации	= БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка, Основание_ПустаяСтруктураРеквизитов);
	
	// Каноническая типовая операция документа-основания:
	Основание_ТиповаяОперация = Новый Структура("
		|КПС40100,
		|КЭК40100,
		|Субконто1_40100,
		|Субконто2_40100,
		|Субконто3_40100,Курс,Кратность");
	СинонимыРеквизитов = Новый Структура();
	СинонимыРеквизитов.Вставить("КПС40100",			"КДБ");
	СинонимыРеквизитов.Вставить("КЭК40100",			"КЭКПередачи");
	СинонимыРеквизитов.Вставить("Субконто1_40100",	"Субконто1,СубконтоДт1");
	СинонимыРеквизитов.Вставить("Субконто2_40100",	"Субконто2,СубконтоДт2");
	СинонимыРеквизитов.Вставить("Субконто3_40100",	"Субконто3,СубконтоДт3");
	УчетНДС.ЗаполнитьЗначенияСвойствТиповойОперации(Основание_ТиповаяОперация, Основание_РеквизитыТиповойОперации, СинонимыРеквизитов);
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОснованиеСсылка, "Дата, Организация");
	СчетУчета = БухгалтерскийУчет.СчетПоКоду("02.33", РеквизитыДокумента.Дата, РеквизитыДокумента.Организация);	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка", ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("ЕдИзмШт", Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	ЗапросЗаполнение.УстановитьПараметр("СчетКомиссионныйТовар", СчетУчета);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка							КАК ДокументОснование,
	|	Дата												КАК Дата,
	|	Организация											КАК Организация,
	|	ИФО													КАК ИФО,
	|	Подразделение										КАК Подразделение,
	|	Контрагент											КАК Контрагент,
	|	Договор												КАК Договор,
	|	ВалютаДокумента										КАК ВалютаДокумента,
	|	КФО													КАК КФО,
	|	РеализацияПоСтавке0									КАК РеализацияПоСтавке0,
	|	ВЫБОР
	|		КОГДА Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.РеализацияЛомаШкур) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.РеализацияЛом)
	|		КОГДА РеализацияПоСтавке0 ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация0)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)
	|	КОНЕЦ												КАК ПричинаНалогообложения
	|ИЗ
	|	Документ.НакладнаяНаОтпускМ15	КАК НакладнаяНаОтпускМ15
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура		КАК НФА,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(Номенклатура	КАК Справочник.Номенклатура).ЕдиницаИзмерения
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			&ЕдИзмШт
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|	КОНЕЦ				КАК ЕдиницаИзмерения,
	|	Количество,
	|	СтавкаНДС,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			Сумма - СуммаНДС
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ				КАК Сумма,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС И НЕ Сумма = 0 ТОГДА
	|			Цена - СуммаНДС * (Цена/Сумма)
	|		ИНАЧЕ
	|			Цена
	|	КОНЕЦ				КАК Цена,
	|	СуммаНДС,
	|	Всего,
	|	ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВЫБОР
	|		КОГДА Материалы.СчетУчета = &СчетКомиссионныйТовар ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ 
	|			ЛОЖЬ
	|	КОНЕЦ				КАК КомиссионнаяТорговля,
	|	СведенияОбъемноСортовогоУчетаМаркированныхТоваров КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров
	|ИЗ
	|	Документ.НакладнаяНаОтпускМ15.Материалы	КАК Материалы
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Данные для табличной части КодыУпаковокМаркируемойПродукции
	|//
	|ВЫБРАТЬ
	|	КодыУпаковокМаркируемойПродукции.НомерУпаковки КАК НомерУпаковки,
	|	КодыУпаковокМаркируемойПродукции.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	КодыУпаковокМаркируемойПродукции.ТипУпаковки КАК ТипУпаковки
	|ИЗ
	|	Документ.НакладнаяНаОтпускМ15.КодыУпаковокМаркируемойПродукции КАК КодыУпаковокМаркируемойПродукции
	|ГДЕ
	|	КодыУпаковокМаркируемойПродукции.Ссылка = &ДокументОснованиеСсылка
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка			= РезультатыЗаполнения[0].Выгрузить();
	ТаблицаСоставНФА		= РезультатыЗаполнения[1].Выгрузить();
	ТаблицаКодыМаркировки	= РезультатыЗаполнения[2].Выгрузить();
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	// Код вида операции
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	// Ответственные лица
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
	Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
	Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
	
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
	
	ТабличныеЧасти	= Новый Структура("СоставНФА", ТаблицаСоставНФА);

	ТабличныеЧасти.Вставить("КодыУпаковокМаркируемойПродукции", ТаблицаКодыМаркировки);
	
	ТиповаяОперацияСсылка = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(
		ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.СчетФактураВыданный")));
	
	ТиповаяОперация	= Новый Структура();
	ТиповаяОперация.Вставить("Ссылка",				ТиповаяОперацияСсылка);
	ТиповаяОперация.Вставить("ЗначенияРеквизитов",	Основание_ТиповаяОперация);
	
	// Искомые данные:
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	ВозвратДанные.Вставить("ТиповаяОперация",	ТиповаяОперация);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_НакладнаяНаОтпускИК(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_ТиповаяОперацияСсылка		= БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(ОснованиеСсылка);
	Основание_РеквизитыТиповойОперации	= Справочники.ТиповыеОперации.ПустаяСтруктураДопРеквизитовОперации(Основание_ТиповаяОперацияСсылка);
	Основание_РеквизитыТиповойОперации	= БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка, Основание_РеквизитыТиповойОперации);
	
	// Каноническая типовая операция документа-основания:
	Основание_ТиповаяОперация = Новый Структура("
		|КПС40100,
		|КЭК40100,
		|Субконто1_40100,
		|Субконто2_40100,
		|Субконто3_40100,Курс,Кратность");
	СинонимыРеквизитов = Новый Структура();
	СинонимыРеквизитов.Вставить("КПС40100",			"КДБ");
	СинонимыРеквизитов.Вставить("КЭК40100",			"КЭКПередачи");
	СинонимыРеквизитов.Вставить("Субконто1_40100",	"Субконто1,СубконтоДт1");
	СинонимыРеквизитов.Вставить("Субконто2_40100",	"Субконто2,СубконтоДт2");
	СинонимыРеквизитов.Вставить("Субконто3_40100",	"Субконто3,СубконтоДт3");
	УчетНДС.ЗаполнитьЗначенияСвойствТиповойОперации(Основание_ТиповаяОперация, Основание_РеквизитыТиповойОперации, СинонимыРеквизитов);
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",			ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("ЕдИзмШт",	Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796")); // шт.
	ЗапросЗаполнение.УстановитьПараметр("ВалютаРегУчета", Константы.ВалютаРегламентированногоУчета.Получить()); // руб.
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка									КАК ДокументОснование,
	|	НакладнаяНаОтпускИК.Дата,
	|	НакладнаяНаОтпускИК.Организация,
	|	НакладнаяНаОтпускИК.ИФО,
	|	НакладнаяНаОтпускИК.Подразделение,
	|	НакладнаяНаОтпускИК.Контрагент,
	|	НакладнаяНаОтпускИК.Договор,
	|	&ВалютаРегУчета 											КАК ВалютаДокумента,
	|	""01""														КАК КодВидаОперации,
	|	НакладнаяНаОтпускИК.КФО										КАК КФО,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)	КАК ПричинаНалогообложения
	|ИЗ
	|	Документ.НакладнаяНаОтпускИК	КАК НакладнаяНаОтпускИК
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура		КАК НФА,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(Номенклатура	КАК Справочник.Номенклатура).ЕдиницаИзмерения
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			&ЕдИзмШт
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|	КОНЕЦ				КАК ЕдиницаИзмерения,
	|	Количество,
	|	СтавкаНДС,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			СуммаРеализации - СуммаНДС
	|		ИНАЧЕ
	|			СуммаРеализации
	|	КОНЕЦ				КАК Сумма,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС И НЕ Сумма = 0 ТОГДА
	|			ЦенаРеализации - СуммаНДС * (ЦенаРеализации/СуммаРеализации)
	|		ИНАЧЕ
	|			ЦенаРеализации
	|	КОНЕЦ				КАК Цена,
	|	СуммаНДС,
	|	Всего
	|ИЗ
	|	Документ.НакладнаяНаОтпускИК.Материалы	КАК Материалы
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка		= РезультатыЗаполнения[0].Выгрузить();
	ТаблицаСоставНФА	= РезультатыЗаполнения[1].Выгрузить();
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	// Код вида операции
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	// Ответственные лица
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
	Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
	Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
	
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
	
	ТабличныеЧасти	= Новый Структура("СоставНФА", ТаблицаСоставНФА);
	
	ТиповаяОперацияСсылка = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(
		ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.СчетФактураВыданный")));
	
	ТиповаяОперация	= Новый Структура();
	ТиповаяОперация.Вставить("Ссылка",				ТиповаяОперацияСсылка);
	ТиповаяОперация.Вставить("ЗначенияРеквизитов",	Основание_ТиповаяОперация);
	
	// Искомые данные:
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	ВозвратДанные.Вставить("ТиповаяОперация",	ТиповаяОперация);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_НакладнаяНаРеализациюТорг12(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	Перем ОписаниеОшибки;
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	Если НЕ УчетНДС.ДопустимВводСФНаОснованииРеализации(ОснованиеСсылка, ОписаниеОшибки) Тогда
		ВозвратДанные["ОписаниеОшибки"] = ОписаниеОшибки;
		
		Возврат Ложь;
	КонецЕсли;
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_ТиповаяОперация = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка, "КДБ,Субконто1,Субконто2,Субконто3,Курс,Кратность");
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОснованиеСсылка, "Дата, Организация");
	СчетУчета = БухгалтерскийУчет.СчетПоКоду("02.33", РеквизитыДокумента.Дата, РеквизитыДокумента.Организация);	
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка", ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("ЕдИзмШт", Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	ЗапросЗаполнение.УстановитьПараметр("СчетКомиссионныйТовар", СчетУчета);
	
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка							КАК ДокументОснование,
	|	Дата												КАК Дата,
	|	Организация											КАК Организация,
	|	ИФО													КАК ИФО,
	|	Подразделение										КАК Подразделение,
	|	Контрагент											КАК Контрагент,
	|	Договор												КАК Договор,
	|	ВалютаДокумента										КАК ВалютаДокумента,
	|	КФО													КАК КФО,
	|	РеализацияПоСтавке0									КАК РеализацияПоСтавке0,
	|	ВЫБОР
	|		КОГДА Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.РеализацияЛомаШкур) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.РеализацияЛом)
	|		КОГДА РеализацияПоСтавке0 ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация0)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)
	|	КОНЕЦ												КАК ПричинаНалогообложения,
	|	Грузоотправитель									КАК Грузоотправитель,
	|	Грузополучатель										КАК Грузополучатель,
	|	СведенияОВыбытииМаркированныхТоваров				КАК СведенияОВыбытииМаркированныхТоваров
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12	КАК НакладнаяНаРеализациюТорг12
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура									КАК НФА,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(Номенклатура	КАК Справочник.Номенклатура).ЕдиницаИзмерения
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			&ЕдИзмШт
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|	КОНЕЦ											КАК ЕдиницаИзмерения,
	|	Количество										КАК Количество,
	|	СтавкаНДС										КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			Сумма - СуммаНДС
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ											КАК Сумма,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС И НЕ Сумма = 0 ТОГДА
	|			Цена - СуммаНДС * (Цена/Сумма)
	|		ИНАЧЕ
	|			Цена
	|	КОНЕЦ											КАК Цена,
	|	СуммаНДС										КАК СуммаНДС,
	|	Всего											КАК Всего,
	|	ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВЫБОР
	|		КОГДА СчетУчета = &СчетКомиссионныйТовар ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ 
	|			ЛОЖЬ
	|	КОНЕЦ				КАК КомиссионнаяТорговля,
	|	СведенияОбъемноСортовогоУчетаМаркированныхТоваров КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12.Номенклатура	КАК Номенклатура
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Номенклатура									КАК НФА,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения
	|		КОГДА ТИПЗНАЧЕНИЯ(Номенклатура) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			&ЕдИзмШт
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|	КОНЕЦ											КАК ЕдиницаИзмерения,
	|	Количество										КАК Количество,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)			КАК СтавкаНДС,
	|	Сумма											КАК Сумма,
	|	ВЫБОР
	|		КОГДА Количество <> 0 ТОГДА
	|			Сумма / Количество
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ											КАК Цена,
	|	0												КАК СуммаНДС,
	|	Сумма											КАК Всего,
	|	"""" КАК ИдентификаторСтроки,
	|	Ложь,
	|	"""" КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12.ВозвратнаяТара КАК ВозвратнаяТара
	|ГДЕ
	|	ВозвратнаяТара.Ссылка = &ДокументОснованиеСсылка	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Данные для табличной части КодыУпаковокМаркируемойПродукции
	|//
	|ВЫБРАТЬ
	|	КодыУпаковокМаркируемойПродукции.НомерУпаковки КАК НомерУпаковки,
	|	КодыУпаковокМаркируемойПродукции.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	КодыУпаковокМаркируемойПродукции.ТипУпаковки КАК ТипУпаковки
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12.КодыУпаковокМаркируемойПродукции КАК КодыУпаковокМаркируемойПродукции
	|ГДЕ
	|	КодыУпаковокМаркируемойПродукции.Ссылка = &ДокументОснованиеСсылка
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка		= РезультатыЗаполнения[0].Выгрузить();
	ТаблицаСоставНФА	= РезультатыЗаполнения[1].Выгрузить();
	ТаблицаКодыМаркировки	= РезультатыЗаполнения[2].Выгрузить();
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	// Код вида операции
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	// Ответственные лица
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
	Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
	Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
	
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
	
	ТабличныеЧасти	= Новый Структура("СоставНФА", ТаблицаСоставНФА);
	ЗначенияРеквизитов = Новый Структура();
	ЗначенияРеквизитов.Вставить("КПС40100",		Основание_ТиповаяОперация["КДБ"]);
	ЗначенияРеквизитов.Вставить("Субконто1_40100",	Основание_ТиповаяОперация["Субконто1"]);
	ЗначенияРеквизитов.Вставить("Субконто2_40100",	Основание_ТиповаяОперация["Субконто2"]);
	ЗначенияРеквизитов.Вставить("Субконто3_40100",	Основание_ТиповаяОперация["Субконто3"]);
	ЗначенияРеквизитов.Вставить("Курс",				Основание_ТиповаяОперация["Курс"]);
	ЗначенияРеквизитов.Вставить("Кратность",		Основание_ТиповаяОперация["Кратность"]);
	
	ТабличныеЧасти.Вставить("КодыУпаковокМаркируемойПродукции", ТаблицаКодыМаркировки);
	
	ТиповаяОперацияСсылка = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(
		ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.СчетФактураВыданный")));
	
	ТиповаяОперация	= Новый Структура();
	ТиповаяОперация.Вставить("Ссылка",				ТиповаяОперацияСсылка);
	ТиповаяОперация.Вставить("ЗначенияРеквизитов",	ЗначенияРеквизитов);
	
	// Искомые данные:
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	ВозвратДанные.Вставить("ТиповаяОперация",	ТиповаяОперация);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_НачислениеДоходов(ОснованиеСсылка, Объект, СчетФактураСсылка, ВозвратДанные)
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_ТиповаяОперация = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка,
		"КФО,КПС,КОСГУ,Курс,Кратность");
	
	Если НЕ ЗначениеЗаполнено(Основание_ТиповаяОперация.КФО) Тогда
		Основание_ТиповаяОперация.Вставить("КФО", Перечисления.КВД.ПустаяСсылка());
	КонецЕсли;
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("Контрагент",				Объект["Контрагент"]);
	ЗапросЗаполнение.УстановитьПараметр("Договор",					Объект["Договор"]);
	ЗапросЗаполнение.УстановитьПараметр("КФО",						Основание_ТиповаяОперация["КФО"]);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	&ДокументОснованиеСсылка									КАК ДокументОснование,
	|	Начисления.Ссылка.Дата										КАК Дата,
	|	Начисления.Ссылка.Организация								КАК Организация,
	|	Начисления.Ссылка.ИФО										КАК ИФО,
	|	Начисления.Ссылка.Подразделение								КАК Подразделение,
	|	Контрагент													КАК Контрагент,
	|	ДоговорКонтрагента											КАК Договор,
	|	Начисления.Ссылка.ВалютаДокумента							КАК ВалютаДокумента,
	|	""01""														КАК КодВидаОперации,
	|	&КФО														КАК КФО,
	|	ЛОЖЬ														КАК РеализацияПоСтавке0,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)	КАК ПричинаНалогообложения
	|ИЗ
	|	Документ.НачислениеДоходов.Начисления	КАК Начисления
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|	И	Контрагент = &Контрагент
	|	И	ДоговорКонтрагента = &Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Начисления.Ссылка.Номенклатура					КАК НФА,
	|	Начисления.Ссылка.Номенклатура.ЕдиницаИзмерения	КАК ЕдиницаИзмерения,
	|	Количество										КАК Количество,
	|	Начисления.Ссылка.СтавкаНДС						КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА Начисления.Ссылка.СуммаВключаетНДС ТОГДА
	|			Сумма - СуммаНДС
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ											КАК Сумма,
	|	СуммаНДС										КАК СуммаНДС,
	|	Всего											КАК Всего
	|ИЗ
	|	Документ.НачислениеДоходов.Начисления	КАК Начисления
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|	И	Контрагент = &Контрагент
	|	И	ДоговорКонтрагента = &Договор
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка		= РезультатыЗаполнения[0].Выгрузить();
	ТаблицаСоставНФА	= РезультатыЗаполнения[1].Выгрузить();
	
	// Возможно (из-за договора или контрагента)
	// не следует вводить на основании и заполнять этот документ:
	Если ТаблицаШапка.Количество() = 0 Тогда
		Результат = Ложь;
		
		ОписаниеОшибки = НСтр("ru='Заполнение документа ""Счет-фактура выданный"" на основании документа ""Начисление доходов"" отменено.
		|В документе-основании ""Начисление доходов"" отсутствуют данные
		|для Контрагента и Договора, указанных в счете-фактуре.'");
		
		// Искомые данные:
		ВозвратДанные.Вставить("ОписаниеОшибки", ОписаниеОшибки);
		
	Иначе
		Результат = Истина;
		
		Если ТаблицаШапка.Количество() > 0 Тогда
			Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
		Иначе
			Шапка = Новый Структура();
		КонецЕсли;
		
		// Код вида операции
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
		КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
		Шапка.Вставить("КодВидаОперации", КодВидаОперации);
		
		// Ответственные лица
		ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
		Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
		Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
		
		ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
		
		ТабличныеЧасти	= Новый Структура("СоставНФА", ТаблицаСоставНФА);
		
		// Типовая операция для заполняемого документа:
		ТиповаяОперацияСсылка = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(
			ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.СчетФактураВыданный")));
		ТиповаяОперацияЗначенияРеквизитов = Новый Структура();
		ТиповаяОперацияЗначенияРеквизитов.Вставить("КПС40100",	Основание_ТиповаяОперация["КПС"]);
		ТиповаяОперацияЗначенияРеквизитов.Вставить("КЭК40100",	Основание_ТиповаяОперация["КОСГУ"]);
		ТиповаяОперацияЗначенияРеквизитов.Вставить("Курс",		Основание_ТиповаяОперация["Курс"]);
		ТиповаяОперацияЗначенияРеквизитов.Вставить("Кратность",	Основание_ТиповаяОперация["Кратность"]);
		
		ТиповаяОперация	= Новый Структура();
		ТиповаяОперация.Вставить("Ссылка",				ТиповаяОперацияСсылка);
		ТиповаяОперация.Вставить("ЗначенияРеквизитов",	ТиповаяОперацияЗначенияРеквизитов);
		
		// Искомые данные:
		ВозвратДанные.Вставить("Шапка",				Шапка);
		ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
		ВозвратДанные.Вставить("ТиповаяОперация",	ТиповаяОперация);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ОперацияБух(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	// Возвращаемое значение
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	СчетаАвансов = УчетНДС.ПолучитьТаблицуСчетовАвансовПолученных();
	МассивСчетов = СчетаАвансов["МассивСчетов"];
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",		ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("МассивСчетов",					МассивСчетов);
	ЗапросЗаполнение.УстановитьПараметр("ПредставлениеПозицииАванса",	УчетНДСКлиентСервер.ПолучитьПредставлениеПозицииАванса());
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Движения документа-основания по счетам полученного аванса
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор	КАК Регистратор,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт			КАК Счет,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО			КАК КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт			КАК КПС,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.Контрагенты)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ												КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2) = ТИП(Справочник.Договоры) ТОГДА
	|			ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.Договоры)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ												КАК Договор,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.Сумма)	КАК Сумма,
	|	ЕСТЬNULL(МАКСИМУМ(ПодразделениеДт), ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))	КАК ПодразделениеДт,
	|	ЕСТЬNULL(МАКСИМУМ(ПодразделениеКт), ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))	КАК ПодразделениеКт
	|ПОМЕСТИТЬ
	|	Движения
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		Регистратор = &ДокументОснованиеСсылка
	|		И	Активность
	|		И	СчетКт В (&МассивСчетов)
	|	)	КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.Контрагенты)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2) = ТИП(Справочник.Договоры) ТОГДА
	|			ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.Договоры)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОперацияБух.Ссылка 													КАК ДокументОснование,
	|	ОперацияБух.Дата													КАК Дата,
	|	ОперацияБух.Организация												КАК Организация,
	|	ВЫБОР
	|		КОГДА НЕ Движения.ПодразделениеДт = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) ТОГДА
	|			Движения.ПодразделениеДт
	|		ИНАЧЕ
	|			Движения.ПодразделениеКт
	|	КОНЕЦ																КАК Подразделение,
	|	ОперацияБух.ИФО 													КАК ИФО,
	|	Движения.КФО														КАК КФО,
	|	Движения.Контрагент													КАК Контрагент,
	|	Движения.Договор													КАК Договор,
	|	""02"" 																КАК КодВидаОперации,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный)	КАК	ПричинаНалогообложения
	|ИЗ
	|	Документ.ОперацияБух	КАК ОперацияБух
	|	ЛЕВОЕ СОЕДИНЕНИЕ	Движения
	|		ПО	ОперацияБух.Ссылка = Движения.Регистратор
	|ГДЕ
	|	ОперацияБух.Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Данные для единственной строки табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ПредставлениеПозицииАванса											КАК НФА,
	|	ИСТИНА																КАК НДСКВычету,
	|	Движения.Счет														КАК СчетРасчетов,
	|	Движения.КПС														КАК КПССчетРасчетов,
	|	Движения.Сумма
	|		- ВЫРАЗИТЬ(Движения.Сумма * 18 / 118 КАК ЧИСЛО(15,2))			КАК Сумма,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18) 								КАК СтавкаНДС,
	|	ВЫРАЗИТЬ(Движения.Сумма * 18 / 118 КАК ЧИСЛО(15,2))					КАК СуммаНДС,
	|	Движения.Сумма 														КАК Всего
	|ИЗ
	|	Движения
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка		= РезультатыЗаполнения[1].Выгрузить();
	ТаблицаСоставНФА	= РезультатыЗаполнения[2].Выгрузить();
	
	// В полученной табличной части должна быть лишь одна строка.
	// Если строк несколько (или 0), то считаем это ошибкой.
	// Несколько строк может быть, если:
	//	- в операции несколько счетов аванса;
	//	- в операции несколько договоров по кредиту авансового счета.
	КоличествоСтрок = ТаблицаСоставНФА.Количество();
	Если КоличествоСтрок = 0 Тогда
		// Искомые данные:
		ОписаниеОшибки = НСтр("ru='Документ Операция (бухгалтерская) не содержит авансовый счет'");
		ВозвратДанные.Вставить("ОписаниеОшибки", ОписаниеОшибки);
		Результат = Ложь;
		
	ИначеЕсли КоличествоСтрок = 1 Тогда
		Если ТаблицаШапка.Количество() > 0 Тогда
			Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
		Иначе
			Шапка = Новый Структура();
		КонецЕсли;
		
		// Код вида операции
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
		КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
		Шапка.Вставить("КодВидаОперации", КодВидаОперации);
		
		// Ответственные лица
		ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
		Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
		Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
		
		ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
		
		ТабличныеЧасти	= Новый Структура("СоставНФА", ТаблицаСоставНФА);
		
		// Искомые данные:
		ВозвратДанные.Вставить("Шапка",				Шапка);
		ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
		Результат = Истина;
		
	Иначе
		// Количество строк > 1
		ОписаниеОшибки = НСтр("ru='Документ Операция (бухгалтерская) содержит несколько авансовых счетов или несколько договоров'");
		ВозвратДанные.Вставить("ОписаниеОшибки", ОписаниеОшибки);
		Результат = Ложь;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ОперацияБух_АП(Знач ОснованиеСсылка, Знач ДанныеЗаполнения, Знач СчетФактураСсылка, Данные)
	
	ЗапросЗаполненияШапки = Новый Запрос();
	ЗапросЗаполненияШапки.УстановитьПараметр("ДокументОснованиеСсылка", ОснованиеСсылка);
	ЗапросЗаполненияШапки.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка 		КАК ДокументОснование,
	|	Дата		КАК Дата,
	|	Организация	КАК Организация,
	|	ИФО 		КАК ИФО,
	|	""02"" 		КАК КодВидаОперации,
	|	ГлБухгалтер	КАК ГлавныйБухгалтер
	|ИЗ
	|	Документ.ОперацияБух
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка";
	
	Данные = ПолучитьДанныеДляСчетаФактурыНаАванс(ОснованиеСсылка, ДанныеЗаполнения, СчетФактураСсылка, ЗапросЗаполненияШапки);
	
	Возврат Не ЗначениеЗаполнено(Данные.ОписаниеОшибки);
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ОтчетКомитентуОПродажах(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_ТиповаяОперация = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка, "Операция,КФО");
	
	Если НЕ ЗначениеЗаполнено(Основание_ТиповаяОперация.КФО) Тогда
		Основание_ТиповаяОперация.Вставить("КФО", Перечисления.КВД.ПустаяСсылка());
	КонецЕсли;
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
