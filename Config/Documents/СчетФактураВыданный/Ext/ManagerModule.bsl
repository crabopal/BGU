Функция ПолучитьДанныеДляЗаполненияНаОсновании_ПередачаОбъектаОС(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_ТиповаяОперация = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка, "КЭК401,НачислятьНДС,Курс,Кратность");
	
	Если Основание_ТиповаяОперация["НачислятьНДС"] = Ложь Тогда
		// Искомые данные:
		ОписаниеОшибки = НСтр("ru='Документ ""Передача объекта ОС"" не требует начисления НДС'");
		ВозвратДанные.Вставить("ОписаниеОшибки", ОписаниеОшибки);
		
		// Выходим:
		Возврат Ложь;
	КонецЕсли;
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("ЕдИзмШт",	Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796")); // шт.
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка									КАК ДокументОснование,
	|	ПередачаОбъектаОС.Дата,
	|	ПередачаОбъектаОС.Организация,
	|	ПередачаОбъектаОС.ИФО,
	|	ПередачаОбъектаОС.Подразделение,
	|	ПередачаОбъектаОС.Контрагент,
	|	ПередачаОбъектаОС.Договор,
	|	ПередачаОбъектаОС.ВалютаДокумента,
	|	""01""														КАК КодВидаОперации,
	|	ПередачаОбъектаОС.КФО										КАК КФО,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)	КАК ПричинаНалогообложения
	|ИЗ
	|	Документ.ПередачаОбъектаОС	КАК ПередачаОбъектаОС
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПередачаОбъектаОС.ОсновноеСредство	КАК НФА,
	|	&ЕдИзмШт							КАК ЕдиницаИзмерения,
	|	1									КАК Количество,
	|	ВЫБОР
	|		КОГДА ПередачаОбъектаОС.СуммаВключаетНДС ТОГДА
	|			ПередачаОбъектаОС.ЦенаПродажи - ПередачаОбъектаОС.СуммаНДС
	|		ИНАЧЕ
	|			ПередачаОбъектаОС.ЦенаПродажи
	|	КОНЕЦ								КАК Сумма,
	|	ВЫБОР
	|		КОГДА ПередачаОбъектаОС.СуммаВключаетНДС ТОГДА
	|			ПередачаОбъектаОС.ЦенаПродажи - ПередачаОбъектаОС.СуммаНДС
	|		ИНАЧЕ
	|			ПередачаОбъектаОС.ЦенаПродажи
	|	КОНЕЦ								КАК Цена,
	|	ПередачаОбъектаОС.СтавкаНДС			КАК СтавкаНДС,
	|	ПередачаОбъектаОС.СуммаНДС			КАК СуммаНДС,
	|	ПередачаОбъектаОС.Всего				КАК Всего
	|ИЗ
	|	Документ.ПередачаОбъектаОС	КАК ПередачаОбъектаОС
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка		= РезультатыЗаполнения[0].Выгрузить();
	ТаблицаСоставНФА	= РезультатыЗаполнения[1].Выгрузить();
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	// Код вида операции
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	// Ответственные лица
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
	Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
	Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
	
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
	
	ТабличныеЧасти	= Новый Структура("СоставНФА", ТаблицаСоставНФА);
	ЗначенияРеквизитов = Новый Структура();
	ЗначенияРеквизитов.Вставить("КЭК40100",		Основание_ТиповаяОперация["КЭК401"]);
	ЗначенияРеквизитов.Вставить("Курс",			Основание_ТиповаяОперация["Курс"]);
	ЗначенияРеквизитов.Вставить("Кратность",	Основание_ТиповаяОперация["Кратность"]);
	
	ТиповаяОперацияСсылка = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(
		ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.СчетФактураВыданный")));
	
	ТиповаяОперация	= Новый Структура();
	ТиповаяОперация.Вставить("Ссылка",				ТиповаяОперацияСсылка);
	ТиповаяОперация.Вставить("ЗначенияРеквизитов",	ЗначенияРеквизитов);
	
	// Искомые данные:
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	ВозвратДанные.Вставить("ТиповаяОперация",	ТиповаяОперация);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ПередачаОбъектовОС(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	ВидыОперацийУказываетсяНДС = Новый Массив();
	ВидыОперацийУказываетсяНДС.Добавить(Перечисления.ВидыОперацийПередачиОС.РеализацияСобственныхОС);
	ВидыОперацийУказываетсяНДС.Добавить(Перечисления.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет);
	ВидыОперацийУказываетсяНДС.Добавить(Перечисления.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106);
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("ЕдИзмШт",					Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796")); // шт.
	ЗапросЗаполнение.УстановитьПараметр("ВидыОперацийУказываетсяНДС",ВидыОперацийУказываетсяНДС);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка									КАК ДокументОснование,
	|	Дата														КАК Дата,
	|	Организация													КАК Организация,
	|	ИФО															КАК ИФО,
	|	Подразделение												КАК Подразделение,
	|	Контрагент													КАК Контрагент,
	|	Договор														КАК Договор,
	|	ВалютаДокумента												КАК ВалютаДокумента,
	|	""01""														КАК КодВидаОперации,
	|	КФО															КАК КФО,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)	КАК ПричинаНалогообложения,
	|	ВидОперации													КАК Основание_ВидОперации,
	|	СуммаВключаетНДС											КАК Основание_СуммаВключаетНДС
	|ИЗ
	|	Документ.ПередачаОбъектовОС	КАК ПередачаОбъектовОС
	|ГДЕ
	|	ПередачаОбъектовОС.Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Подготовка данных для табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновноеСредство							КАК НФА,
	|	&ЕдИзмШт									КАК ЕдиницаИзмерения,
	|	Количество									КАК Количество,
	|	СтавкаНДС									КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА Ссылка.ВидОперации В(&ВидыОперацийУказываетсяНДС) И Ссылка.СуммаВключаетНДС ТОГДА
	|			СуммаПродажи - СуммаНДС
	|		КОГДА Ссылка.ВидОперации В(&ВидыОперацийУказываетсяНДС) И НЕ Ссылка.СуммаВключаетНДС ТОГДА
	|			СуммаПродажи
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ										КАК Сумма,
	|	ВЫБОР
	|		КОГДА Ссылка.ВидОперации В(&ВидыОперацийУказываетсяНДС) ТОГДА
	|			СуммаНДС
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ 										КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА Ссылка.ВидОперации В(&ВидыОперацийУказываетсяНДС) ТОГДА
	|			Всего
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ										КАК Всего
	|ИЗ
