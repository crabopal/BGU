	|	КОНЕЦ						КАК Сумма,
	|	ВЫБОР
	|		КОГДА Ссылка.ВидОперации В(&ВидыОперацийУказываетсяНДС) ТОГДА
	|			СуммаНДС
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ               		КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА Ссылка.ВидОперации В(&ВидыОперацийУказываетсяНДС) ТОГДА
	|			Всего
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ						КАК Всего
	|ИЗ
	|	Документ.ПередачаОбъектовИК.ОсновныеСредства	КАК ПередачаОбъектовИКОсновныеСредства
	|ГДЕ
	|	ПередачаОбъектовИКОсновныеСредства.Ссылка = &ДокументОснованиеСсылка";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка		= РезультатыЗаполнения[0].Выгрузить();
	ТаблицаСоставНФА	= РезультатыЗаполнения[1].Выгрузить();
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_ТиповаяОперация = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка, "Курс,Кратность");
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	Если Шапка.Основание_ВидОперации <> Перечисления.ВидыОперацийИК.Реализация Тогда
		// Безвозмездная передача. Применяется ставка по умолчанию.
		ЗаполнитьСуммыПоСтавке(ТаблицаСоставНФА, Шапка.Дата, Шапка.Основание_СуммаВключаетНДС);
	КонецЕсли;
	
	ЗаполнитьЦену(ТаблицаСоставНФА);
	
	// Ответственные лица
	Шапка.Вставить("Руководитель",
		ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
			Шапка["Организация"],
			Шапка["Дата"],
			Шапка["Подразделение"])["ОтветственноеЛицоСсылка"]);
	Шапка.Вставить("ГлавныйБухгалтер",
		ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер,
			Шапка["Организация"],
			Шапка["Дата"],
			Шапка["Подразделение"])["ОтветственноеЛицоСсылка"]);
	
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
	ТабличныеЧасти	= Новый Структура("СоставНФА", ТаблицаСоставНФА);
	ЗначенияРеквизитов = Новый Структура();
	//ЗначенияРеквизитов.Вставить("КЭК40100",		Основание_ТиповаяОперация["КЭК401"]);
	ЗначенияРеквизитов.Вставить("Курс",			Основание_ТиповаяОперация["Курс"]);
	ЗначенияРеквизитов.Вставить("Кратность",	Основание_ТиповаяОперация["Кратность"]);

	ТиповаяОперацияСсылка = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(
		ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.СчетФактураВыданный")));
	
	ТиповаяОперация	= Новый Структура();
	ТиповаяОперация.Вставить("Ссылка",				ТиповаяОперацияСсылка);
	ТиповаяОперация.Вставить("ЗначенияРеквизитов",	ЗначенияРеквизитов);
	
	// Искомые данные:
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	ВозвратДанные.Вставить("ТиповаяОперация",	ТиповаяОперация);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ПоступлениеНаСчет(Знач ОснованиеСсылка, Знач ДанныеЗаполнения, Знач СчетФактураСсылка, Данные)
	
	ЗапросЗаполненияШапки = Новый Запрос();
	ЗапросЗаполненияШапки.УстановитьПараметр("ДокументОснованиеСсылка", ОснованиеСсылка);
	ЗапросЗаполненияШапки.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка													КАК ДокументОснование,
	|	Дата													КАК Дата,
	|	Организация												КАК Организация,
	|	ИФО														КАК ИФО,
	|	ВалютаДокумента											КАК ВалютаДокумента,
	|	Курс													КАК Курс,
	|	Кратность												КАК Кратность,
	|	СтавкаНДС												КАК СтавкаНДС,
	|	""02""													КАК КодВидаОперации,
	|	ВЫРАЗИТЬ(ДокументОснование КАК Документ.СчетНаОплату)	КАК СчетНаОплату
	|ИЗ
	|	Документ.ПоступлениеНаСчет
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка";
	
	Данные = ПолучитьДанныеДляСчетаФактурыНаАванс(ОснованиеСсылка, ДанныеЗаполнения, СчетФактураСсылка, ЗапросЗаполненияШапки);
	
	Возврат Не ЗначениеЗаполнено(Данные.ОписаниеОшибки);
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ПоступлениеОСИК(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	// Возвращаемое значение
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("ЕдИзм",					Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для заполнения шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка												КАК ДокументОснование,
	|	Дата																	КАК Дата,
	|	Организация																КАК Организация,
	|	ИФО																		КАК ИФО,
	|	Подразделение															КАК Подразделение,
	|	Контрагент																КАК Контрагент,
	|	Договор																	КАК Договор,
	|	ВалютаДокумента															КАК ВалютаДокумента,
	|	""06""																	КАК КодВидаОперации,
	|	ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)										КАК КФО,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент)	КАК ПричинаНалогообложения,
	|	
	|	// Служебные колонки
	|	Договор.ТипДоговораНДС													КАК ТипДоговораНДС,
	|	(Договор.ТипДоговораНДС <>
	|		ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.АгентскийДоговор))		КАК ЭтоНедопустимыйТипДоговораНДС
	|ИЗ
	|	Документ.ПоступлениеОСИК
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для заполнения таблицы СоставНФА
	|//
	|ВЫБРАТЬ
	|	ВнеоборотныйАктив	КАК НФА,
	|	&ЕдИзм				КАК ЕдиницаИзмерения,
	|	Количество			КАК Количество,
	|	Всего				КАК Всего
	|ИЗ
	|	Документ.ПоступлениеОСИК.КапВложения
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	// [0]. Данные для заполнения шапки
	ТаблицаШапка = РезультатыЗаполнения[0].Выгрузить();
	Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	
	// [1]. Данные для заполнения таблицы СоставНФА
	ТаблицаСоставНФА = РезультатыЗаполнения[1].Выгрузить();
	
	// Возможно (из-за типа договора в документе-основании)
	// не следует вводить на основании и заполнять этот документ:
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
		ЭтоНедопустимыйТипДоговораНДС = Шапка["ЭтоНедопустимыйТипДоговораНДС"];
	Иначе
		Шапка = Новый Структура();
		ЭтоНедопустимыйТипДоговораНДС = Ложь;
	КонецЕсли;
	
	Если ЭтоНедопустимыйТипДоговораНДС Тогда
		ТипДоговораНДС = Шапка["ТипДоговораНДС"];
		
		ТипДоговораНДСПредставление = ?(ЗначениеЗаполнено(ТипДоговораНДС),
			"""" + Строка(ТипДоговораНДС) + """",
			НСтр("ru='<не указан>'"));
			
		Текст = НСтр("ru='Заполнение документа ""Счет-фактура выданный"" на основании документа ""Поступление ОС, НМА, НПА (Имущество казны)"" отменено.
		|В документе-основании ""Поступление ОС, НМА, НПА (Имущество казны)"" указан договор, у которого тип для целей НДС %1.
		|
		|На основании такого документа ""Поступление ОС, НМА, НПА (Имущество казны)"" не предусмотрен ввод счета-фактуры налогового агента.'");
		
		ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ТипДоговораНДСПредставление);
		
		ВозвратДанные.Вставить("ОписаниеОшибки", ОписаниеОшибки);
		
		Возврат Ложь;
	КонецЕсли;
	
	ЗаполнитьСуммыПоСтавке(ТаблицаСоставНФА, Шапка.Дата, Истина, Истина); // Устанавливаем расчетную ставку.
	
	ЗаполнитьЦену(ТаблицаСоставНФА);
	
	// Код вида операции
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	// Ответственные лица
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
	Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
	Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
	
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
	
	ТабличныеЧасти	= Новый Структура("СоставНФА", ТаблицаСоставНФА);
	
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ПоступлениеУслугРабот(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	// Возвращаемое значение
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Значения реквизитов типовой операции документа-основания
	Основание_ТиповаяОперация = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка,
		"КФО,СчетУчетаНДСКРаспределению,СчетУчетаНДС,Курс,Кратность");
	
	Если НЕ ЗначениеЗаполнено(Основание_ТиповаяОперация.КФО) Тогда
		Основание_ТиповаяОперация.Вставить("КФО", Перечисления.КВД.ПустаяСсылка());
	КонецЕсли;
	
	КФО = Основание_ТиповаяОперация["КФО"];
	
	Если НЕ ЗначениеЗаполнено(КФО) Тогда
		ЗапросКФО = Новый Запрос();
		ЗапросКФО.УстановитьПараметр("ДокументОснованиеСсылка", ОснованиеСсылка);
		ЗапросКФО.Текст = "
		|ВЫБРАТЬ
		|	ЕСТЬNULL(МАКСИМУМ(КФО), ЗНАЧЕНИЕ(Перечисление.КВД.Внебюджет))	КАК КФО
		|ИЗ
		|	Документ.ПоступлениеУслугРабот.УслугиИРаботы
		|ГДЕ
		|	Ссылка = &ДокументОснованиеСсылка";
		
		Выборка = ЗапросКФО.Выполнить().Выбрать();
		Выборка.Следующий();
		
		КФО = Выборка["КФО"];
	КонецЕсли;
	
	// Получаем данные
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",		ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("КФО",							КФО);
	ЗапросЗаполнение.УстановитьПараметр("СчетВычетКРаспределению",		Основание_ТиповаяОперация["СчетУчетаНДСКРаспределению"]);
	ЗапросЗаполнение.УстановитьПараметр("СчетВычетБезРаспределения",	Основание_ТиповаяОперация["СчетУчетаНДС"]);
	ЗапросЗаполнение.УстановитьПараметр("Счет30200",					БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("302.00"));
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для заполнения шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка								КАК ДокументОснование,
	|	ПоступлениеУслугРабот.Дата								КАК Дата,
	|	ПоступлениеУслугРабот.Организация						КАК Организация,
	|	ПоступлениеУслугРабот.ИФО								КАК ИФО,
	|	&КФО													КАК КФО,
	|	ПоступлениеУслугРабот.Подразделение						КАК Подразделение,
	|	ПоступлениеУслугРабот.Контрагент						КАК Контрагент,
	|	ПоступлениеУслугРабот.Договор							КАК Договор,
	|	ПоступлениеУслугРабот.ВалютаДокумента					КАК ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.АгентскийДоговор) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент)
	|		КОГДА Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.АгентскийДоговорНерезидент) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.ПокупкаУНерезидентаНалоговыйАгент)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.ПустаяСсылка)
	|	КОНЕЦ													КАК ПричинаНалогообложения,
	|	""06""													КАК КодВидаОперации,
	|	
	|	// Служебные колонки:
	|	Договор.ТипДоговораНДС									КАК ТипДоговораНДС,
	|	ВЫБОР
	|		КОГДА	Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.ПустаяСсылка)
	|			ИЛИ	Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.Обычный) ТОГДА		
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ													КАК ЭтоНедопустимыйТипДоговораНДС
	|ИЗ
	|	Документ.ПоступлениеУслугРабот КАК ПоступлениеУслугРабот
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Данные табличной части документа-основания.
	|//		(Данные для заполнения таблицы СоставНФА)
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура				КАК Номенклатура,
	|	ЕдиницаИзмерения			КАК ЕдиницаИзмерения,
	|	Количество					КАК Количество,
	|	ВЫБОР
	|		КОГДА Ссылка.ПринятьНДСКВычетуУказываетсяВСтроках ТОГДА
	|			ПринятьНДСКВычету
	|		ИНАЧЕ
	|			Ссылка.ПринятьНДСКВычету
	|	КОНЕЦ						КАК НДСКВычету,
	|	НДСКРаспределению			КАК НДСКРаспределению,
	|	КПС							КАК КПС,
	|	КЭК							КАК КЭК,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			Сумма - СуммаНДС
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ						КАК СуммаБезНДС,
	|	СтавкаНДС					КАК СтавкаНДС,
	|	СуммаНДС					КАК СуммаНДС,
	|	Всего						КАК Всего
	|ПОМЕСТИТЬ
	|	УслугиИРаботы
	|ИЗ
	|	Документ.ПоступлениеУслугРабот.УслугиИРаботы КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &ДокументОснованиеСсылка
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. (Подготовка) Определяем по одному счету для каждого используемого КЭК.
	|//		(Данные для заполнения таблицы ""Состав НФА"")
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоответствияАналитическихСчетовКЭК.КЭК				КАК КЭК,
	|	МИНИМУМ(СоответствияАналитическихСчетовКЭК.Счет)	КАК Счет
	|ПОМЕСТИТЬ
	|	СоответствиеКЭКСчет
	|ИЗ
	|	РегистрСведений.СоответствияАналитическихСчетовКЭК	КАК СоответствияАналитическихСчетовКЭК
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	УслугиИРаботы
	|		ПО	СоответствияАналитическихСчетовКЭК.КЭК = УслугиИРаботы.КЭК
	|ГДЕ
	|	Счет В ИЕРАРХИИ(&Счет30200)
	|СГРУППИРОВАТЬ ПО
	|	СоответствияАналитическихСчетовКЭК.КЭК
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Данные для заполнения таблицы СоставНФА
	|//
	|ВЫБРАТЬ
	|	УслугиИРаботы.Номенклатура			КАК НФА,
	|	УслугиИРаботы.ЕдиницаИзмерения		КАК ЕдиницаИзмерения,
	|	СоответствиеКЭКСчет.Счет			КАК СчетНачислениеДт,
	|	УслугиИРаботы.КПС					КАК КПСНачислениеДт,
	|	УслугиИРаботы.НДСКВычету			КАК НДСКВычету,
	|	УслугиИРаботы.НДСКРаспределению		КАК НДСКРаспределению,
	|	ВЫБОР
	|		КОГДА УслугиИРаботы.НДСКРаспределению ТОГДА
	|			&СчетВычетКРаспределению
	|		ИНАЧЕ
	|			&СчетВычетБезРаспределения
	|	КОНЕЦ								КАК СчетВычетКт,
	|	УслугиИРаботы.КПС					КАК КПСВычетКт,
	|	СоответствиеКЭКСчет.Счет			КАК СчетРасчетов,
	|	УслугиИРаботы.КПС					КАК КПССчетРасчетов,
	|	УслугиИРаботы.Количество			КАК Количество,
	|	ВЫБОР
	|		КОГДА УслугиИРаботы.Количество = 0 ТОГДА
	|			УслугиИРаботы.СуммаБезНДС
	|		ИНАЧЕ
	|			УслугиИРаботы.СуммаБезНДС / УслугиИРаботы.Количество
	|	КОНЕЦ								КАК Цена,
	|	УслугиИРаботы.СуммаБезНДС			КАК Сумма,
	|	УслугиИРаботы.СтавкаНДС				КАК СтавкаНДС,
	|	УслугиИРаботы.СуммаНДС				КАК СуммаНДС,
	|	УслугиИРаботы.Всего					КАК Всего
	|ИЗ
	|	УслугиИРаботы
	|	ЛЕВОЕ СОЕДИНЕНИЕ	СоответствиеКЭКСчет
	|		ПО	УслугиИРаботы.КЭК = СоответствиеКЭКСчет.КЭК
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка		= РезультатыЗаполнения[0].Выгрузить();
	ТаблицаСоставНФА	= РезультатыЗаполнения[3].Выгрузить();
	
	// Возможно (из-за типа договора в документе-основании)
	// не следует вводить на основании и заполнять этот документ:
	Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
		ЭтоНедопустимыйТипДоговораНДС = Шапка["ЭтоНедопустимыйТипДоговораНДС"];
	Иначе
		Шапка = Новый Структура();
		ЭтоНедопустимыйТипДоговораНДС = Ложь;
	КонецЕсли;
	
	Если ЭтоНедопустимыйТипДоговораНДС Тогда
		ТипДоговораНДС = Шапка["ТипДоговораНДС"];
		ТипДоговораНДСПредставление = ?(ЗначениеЗаполнено(ТипДоговораНДС),
			"""" + Строка(ТипДоговораНДС) + """",
			НСтр("ru='<не указан>'"));
		Текст = НСтр("ru='Заполнение документа ""Счет-фактура выданный"" на основании документа ""Поступление услуг, работ"" отменено.
		|В документе-основании ""Поступление услуг, работ"" указан договор, у которого тип для целей НДС %1.
		|
		|На основании такого документа ""Поступление услуг, работ"" следует заполнять иной документ: ""Счет-фактура полученный"".'");
		ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ТипДоговораНДСПредставление);
		
		// Искомые данные:
		ВозвратДанные.Вставить("ОписаниеОшибки", ОписаниеОшибки);
		Результат = Ложь;
		
	Иначе
		// Код вида операции
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
		КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
		Шапка.Вставить("КодВидаОперации", КодВидаОперации);
		
		// Ответственные лица
		ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
		Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
		Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
		
		ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
		
		ТабличныеЧасти	= Новый Структура("СоставНФА", ТаблицаСоставНФА);
		
		// Искомые данные:
		ВозвратДанные.Вставить("Шапка",				Шапка);
		ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ПриходныйКассовыйОрдер(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",		ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("ПредставлениеПозицииАванса",	УчетНДСКлиентСервер.ПолучитьПредставлениеПозицииАванса());
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Счета полученного аванса верхнего уровня
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка
	|ПОМЕСТИТЬ
	|	СчетаАвансаВерхнегоУровня
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Код ПОДОБНО ""205.%А""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Все счета полученного аванса
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка
	|ПОМЕСТИТЬ
	|	СчетаАванса
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В ИЕРАРХИИ (ВЫБРАТЬ Ссылка ИЗ СчетаАвансаВерхнегоУровня)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. (Подготовка) Все реквизиты документа-основания
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПриходныйКассовыйОрдер.Номер			КАК Номер,
	|	ПриходныйКассовыйОрдер.Дата				КАК Дата,
	|	ПриходныйКассовыйОрдер.Организация		КАК Организация,
	|	ПриходныйКассовыйОрдер.ИФО				КАК ИФО,
	|	ПриходныйКассовыйОрдер.Подразделение	КАК Подразделение,
	|	ПриходныйКассовыйОрдер.Контрагент		КАК Контрагент,
	|	ПриходныйКассовыйОрдер.Договор			КАК Договор,
	|	ПриходныйКассовыйОрдер.СуммаДокумента	КАК СуммаДокумента,
	|	ПриходныйКассовыйОрдер.СуммаНДС			КАК СуммаНДС,
	|	ПриходныйКассовыйОрдер.СтавкаНДС		КАК СтавкаНДС,
	|	ПриходныйКассовыйОрдер.ГлБухгалтер		КАК ГлБухгалтер,
	|	МИНИМУМ(ТЧРасшифровкаПлатежа.КФО)		КАК КФО
	|ПОМЕСТИТЬ
	|	ВсеРеквизитыДокументаОснования
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер	КАК ПриходныйКассовыйОрдер
	|	ЛЕВОЕ СОЕДИНЕНИЕ	Документ.ПриходныйКассовыйОрдер.РасшифровкаПлатежа	КАК ТЧРасшифровкаПлатежа
	|		ПО	ПриходныйКассовыйОрдер.Ссылка = ТЧРасшифровкаПлатежа.Ссылка
	|ГДЕ
	|	ПриходныйКассовыйОрдер.Ссылка = &ДокументОснованиеСсылка
	|	И	ПриходныйКассовыйОрдер.КорСчет В (ВЫБРАТЬ Ссылка ИЗ СчетаАванса)
	|	И	ПриходныйКассовыйОрдер.Оплачено = ИСТИНА
	|СГРУППИРОВАТЬ ПО
	|	ПриходныйКассовыйОрдер.Номер,
	|	ПриходныйКассовыйОрдер.Дата,
	|	ПриходныйКассовыйОрдер.Организация,
	|	ПриходныйКассовыйОрдер.ИФО,
	|	ПриходныйКассовыйОрдер.Подразделение,
	|	ПриходныйКассовыйОрдер.Контрагент,
	|	ПриходныйКассовыйОрдер.Договор,
	|	ПриходныйКассовыйОрдер.СуммаДокумента,
	|	ПриходныйКассовыйОрдер.СуммаНДС,
	|	ПриходныйКассовыйОрдер.СтавкаНДС,
	|	ПриходныйКассовыйОрдер.ГлБухгалтер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка											КАК ДокументОснование,
	|	ПриходныйКассовыйОрдер.Дата											КАК Дата,
	|	ПриходныйКассовыйОрдер.Организация									КАК Организация,
	|	ПриходныйКассовыйОрдер.ИФО											КАК ИФО,
	|	ПриходныйКассовыйОрдер.КФО											КАК КФО,
	|	ПриходныйКассовыйОрдер.Подразделение								КАК Подразделение,
	|	ПриходныйКассовыйОрдер.Контрагент									КАК Контрагент,
	|	ПриходныйКассовыйОрдер.Договор										КАК Договор,
	|	""02"" 																КАК КодВидаОперации,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный)	КАК	ПричинаНалогообложения,
	|	ПриходныйКассовыйОрдер.ГлБухгалтер									КАК ГлавныйБухгалтер
	|ИЗ
	|	ВсеРеквизитыДокументаОснования	КАК ПриходныйКассовыйОрдер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Данные для единственной строки табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ПредставлениеПозицииАванса			КАК НФА,
	|	СуммаДокумента - СуммаНДС			КАК Сумма,
	|	СтавкаНДС							КАК СтавкаНДС,
	|	СуммаНДС							КАК СуммаНДС,
	|	СуммаДокумента						КАК Всего
	|ИЗ
	|	ВсеРеквизитыДокументаОснования	КАК ПриходныйКассовыйОрдер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Данные для единственной строки табличной части ПлатежноРасчетныеДокументы
	|//
	|ВЫБРАТЬ
	|	Номер	КАК НомерДокумента,
	|	Дата	КАК ДатаДокумента
	|ИЗ
	|	ВсеРеквизитыДокументаОснования	КАК ПриходныйКассовыйОрдер
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка						= РезультатыЗаполнения[3].Выгрузить();
	ТаблицаСоставНФА					= РезультатыЗаполнения[4].Выгрузить();
	ТаблицаПлатежноРасчетныеДокументы	= РезультатыЗаполнения[5].Выгрузить();
	
	// В полученной табличной части должна быть лишь одна строка.
	// Если строк нет, то считаем это ошибкой.
	КоличествоСтрок = ТаблицаСоставНФА.Количество();
	Если КоличествоСтрок = 1 Тогда
		Если ТаблицаШапка.Количество() > 0 Тогда
			Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
		Иначе
			Шапка = Новый Структура();
		КонецЕсли;
		
		// Реквизиты документа оплаты (только для аванса)
		Если ТаблицаПлатежноРасчетныеДокументы.Количество() > 0 Тогда
			ПерваяСтрокаТаблицы = ТаблицаПлатежноРасчетныеДокументы[0];
			
			Шапка.Вставить("НомерДокументаОплаты",	ПерваяСтрокаТаблицы["НомерДокумента"]);
			Шапка.Вставить("ДатаДокументаОплаты",	ПерваяСтрокаТаблицы["ДатаДокумента"]);
		КонецЕсли;
		
		// Код вида операции
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
		КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
		Шапка.Вставить("КодВидаОперации", КодВидаОперации);
		
		// Ответственные лица
		ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
		Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
		Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
		
		ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
		
		ТабличныеЧасти	= Новый Структура("СоставНФА, ПлатежноРасчетныеДокументы",
			ТаблицаСоставНФА,
			ТаблицаПлатежноРасчетныеДокументы);
		
		// Искомые данные:
		ВозвратДанные.Вставить("Шапка",				Шапка);
		ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
		Результат = Истина;
		
	Иначе
		// Искомые данные:
		ОписаниеОшибки = НСтр("ru='Приходный кассовый ордер не содержит авансовый счет'");
		ВозвратДанные.Вставить("ОписаниеОшибки", ОписаниеОшибки);
		Результат = Ложь;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ПриходныйКассовыйОрдер_АП(Знач ОснованиеСсылка, Знач ДанныеЗаполнения, Знач СчетФактураСсылка, Данные)
	
	ЗапросЗаполненияШапки = Новый Запрос();
	ЗапросЗаполненияШапки.УстановитьПараметр("ДокументОснованиеСсылка", ОснованиеСсылка);
	ЗапросЗаполненияШапки.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка													КАК ДокументОснование,
	|	Дата													КАК Дата,
	|	Организация												КАК Организация,
	|	ИФО														КАК ИФО,
	|	ВалютаДокумента											КАК ВалютаДокумента,
	|	Курс													КАК Курс,
	|	Кратность												КАК Кратность,
	|	СтавкаНДС												КАК СтавкаНДС,
	|	""02""													КАК КодВидаОперации,
	|	ГлБухгалтер												КАК ГлавныйБухгалтер,
	|	ВЫРАЗИТЬ(ДокументОснование КАК Документ.СчетНаОплату)	КАК СчетНаОплату
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка";
	
	Данные = ПолучитьДанныеДляСчетаФактурыНаАванс(ОснованиеСсылка, ДанныеЗаполнения, СчетФактураСсылка, ЗапросЗаполненияШапки);
	
	Возврат Не ЗначениеЗаполнено(Данные.ОписаниеОшибки);
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_РегистрацияВнутреннегоПотребления(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("ЕдИзмШт",	Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796")); // шт.
	ЗапросЗаполнение.УстановитьПараметр("ВалютаРУ",	Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка													КАК ДокументОснование,
	|	РегистрацияВнутреннегоПотребления.Дата										КАК Дата,
	|	РегистрацияВнутреннегоПотребления.Организация								КАК Организация,
	|	РегистрацияВнутреннегоПотребления.Подразделение								КАК Подразделение,
	|	РегистрацияВнутреннегоПотребления.ИФО										КАК ИФО,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)								КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)									КАК Договор,
	|	&ВалютаРУ																	КАК ВалютаДокумента,
	|	""01""																		КАК КодВидаОперации,
	|	РегистрацияВнутреннегоПотребления.КФО										КАК КФО,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.СМРХозяйственнымСпособом)	КАК ПричинаНалогообложения
	|ИЗ
	|	Документ.РегистрацияВнутреннегоПотребления	КАК РегистрацияВнутреннегоПотребления
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбъектСтроительства		КАК НФА,
	|	&ЕдИзмШт				КАК ЕдиницаИзмерения,
	|	1						КАК Количество,
	|	Сумма					КАК Цена,
	|	Сумма					КАК Сумма,
	|	СтавкаНДС				КАК СтавкаНДС,
	|	СуммаНДС				КАК СуммаНДС,
	|	Сумма + СуммаНДС		КАК Всего,
	|	КПС						КАК КПСНачислениеДт,
	|	КПС						КАК КПСВычетКт
	|ИЗ
	|	Документ.РегистрацияВнутреннегоПотребления.СМРХозспособом	КАК СМРХозспособом
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка		= РезультатыЗаполнения[0].Выгрузить();
	ТаблицаСоставНФА	= РезультатыЗаполнения[1].Выгрузить();
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	// Код вида операции
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	// Ответственные лица
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
	Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
	Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
	
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
	
	ТабличныеЧасти	= Новый Структура("СоставНФА", ТаблицаСоставНФА);
	
	// Искомые данные:
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	//ВозвратДанные.Вставить("ТиповаяОперация",	ТиповаяОперация);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_СдачаЭтапаРабот(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	// Возвращаемое значение:
