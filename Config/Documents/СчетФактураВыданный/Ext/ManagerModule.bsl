КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ЭквайринговаяОперация(ОснованиеСсылка, Объект, СчетФактураСсылка, ВозвратДанные)
	
	// Данные для заполнения
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	СчетаАвансов = УчетНДС.ПолучитьТаблицуСчетовАвансовПолученных();
	МассивСчетов = СчетаАвансов["МассивСчетов"];
	
	// Получаем данные
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",		ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("СчетаАвансовПолученных",		МассивСчетов);
	ЗапросЗаполнение.УстановитьПараметр("ПредставлениеПозицииАванса",	УчетНДСКлиентСервер.ПолучитьПредставлениеПозицииАванса());
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Единственная проводка документа-основания по получению аванса
	|//		(одновременно проверяется наличие аванса в эквайринговой операции)
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СчетКт	КАК СчетРасчетов,
	|	КПСКт	КАК КПССчетРасчетов
	|ПОМЕСТИТЬ
	|	ПроводкаДокументаОснования
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		Регистратор = &ДокументОснованиеСсылка
	|		И	СчетКт В (&СчетаАвансовПолученных)
	|	)	КАК ЕПСБУДвиженияССубконто
	|;	
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Реквизиты документа-основания
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номер						КАК Номер,
	|	Дата						КАК Дата,
	|	Организация					КАК Организация,
	|	Подразделение				КАК Подразделение,
	|	ИФО							КАК ИФО,
	|	КФО							КАК КФО,
	|	Контрагент					КАК Контрагент,
	|	Договор						КАК Договор,
	|	НомерПервичногоДокумента	КАК НомерПервичногоДокумента,
	|	ДатаПервичногоДокумента		КАК ДатаПервичногоДокумента,
	|	СуммаДокумента				КАК СуммаДокумента,
	|	СуммаНДС					КАК СуммаНДС,
	|	СтавкаНДС					КАК СтавкаНДС
	|ПОМЕСТИТЬ
	|	РеквизитыДокументаОснования
	|ИЗ
	|	Документ.ЭквайринговаяОперация	КАК ЭквайринговаяОперация
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка											КАК ДокументОснование,
	|	Дата																КАК Дата,
	|	Организация															КАК Организация,
	|	ИФО																	КАК ИФО,
	|	КФО																	КАК КФО,
	|	Подразделение														КАК Подразделение,
	|	Контрагент															КАК Контрагент,
	|	Договор																КАК Договор,
	|	""02"" 																КАК КодВидаОперации,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный)	КАК	ПричинаНалогообложения
	|ИЗ
	|	РеквизитыДокументаОснования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Данные для единственной строки табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ПредставлениеПозицииАванса					КАК НФА,
	|	РеквизитыДокументаОснования.СуммаДокумента
	|		- РеквизитыДокументаОснования.СуммаНДС	КАК Сумма,
	|	РеквизитыДокументаОснования.СтавкаНДС		КАК СтавкаНДС,
	|	РеквизитыДокументаОснования.СуммаНДС		КАК СуммаНДС,
	|	РеквизитыДокументаОснования.СуммаДокумента	КАК Всего,
	|	ПроводкаДокументаОснования.СчетРасчетов		КАК СчетРасчетов,
	|	ПроводкаДокументаОснования.КПССчетРасчетов	КАК КПССчетРасчетов
	|ИЗ
	|	ПроводкаДокументаОснования
	|	ЛЕВОЕ СОЕДИНЕНИЕ	РеквизитыДокументаОснования
	|		ПО	ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Данные для единственной строки табличной части ПлатежноРасчетныеДокументы
	|//
	|ВЫБРАТЬ
	|	НомерПервичногоДокумента	КАК НомерДокумента,
	|	ДатаПервичногоДокумента		КАК ДатаДокумента
	|ИЗ
	|	РеквизитыДокументаОснования
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	// [2]. Данные для реквизитов шапки
	ТаблицаШапка = РезультатыЗаполнения[2].Выгрузить();
	
	// [3]. Данные для единственной строки табличной части СоставНФА
	ТаблицаСоставНФА = РезультатыЗаполнения[3].Выгрузить();
	
	// [4]. Данные для единственной строки табличной части ПлатежноРасчетныеДокументы
	ТаблицаПлатежноРасчетныеДокументы = РезультатыЗаполнения[4].Выгрузить();
	
	// Допустим ввод на основании, только если поступил аванс
	ЭтоАванс = (ТаблицаСоставНФА.Количество() > 0);
	Если НЕ ЭтоАванс Тогда
		ОписаниеОшибки = НСтр("ru='Отменено заполнение документа ""Счет-фактура выданный""
			|на основании документа ""Эквайринговая операция""
			|
			|Не обнаружен признак авансового платежа'");
		
		ВозвратДанные.Вставить("ОписаниеОшибки", ОписаниеОшибки);
		
		Возврат Ложь;
	КонецЕсли;
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	Шапка.Вставить("Ссылка", Объект["Ссылка"]);
	
	// Реквизиты документа оплаты (только для аванса)
	Если ТаблицаПлатежноРасчетныеДокументы.Количество() > 0 Тогда
		ПерваяСтрокаТаблицы = ТаблицаПлатежноРасчетныеДокументы[0];
		
		Шапка.Вставить("НомерДокументаОплаты",	ПерваяСтрокаТаблицы["НомерДокумента"]);
		Шапка.Вставить("ДатаДокументаОплаты",	ПерваяСтрокаТаблицы["ДатаДокумента"]);
	КонецЕсли;
	
	// Код вида операции
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	// Ответственные лица
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
	Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
	Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
	
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
	
	ТабличныеЧасти	= Новый Структура();
	ТабличныеЧасти.Вставить("СоставНФА",					ТаблицаСоставНФА);
	ТабличныеЧасти.Вставить("ПлатежноРасчетныеДокументы",	ТаблицаПлатежноРасчетныеДокументы);
	
	// Данные для заполнения
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ЭквайринговаяОперация_АП(Знач ОснованиеСсылка, Знач ДанныеЗаполнения, Знач СчетФактураСсылка, Данные)
	
	ЗапросЗаполненияШапки = Новый Запрос();
	ЗапросЗаполненияШапки.УстановитьПараметр("ДокументОснованиеСсылка", ОснованиеСсылка);
	ЗапросЗаполненияШапки.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка													КАК ДокументОснование,
	|	Дата													КАК Дата,
	|	Организация												КАК Организация,
	|	ИФО														КАК ИФО,
	|	СтавкаНДС												КАК СтавкаНДС,
	|	ВЫРАЗИТЬ(ДокументОснование КАК Документ.СчетНаОплату)	КАК СчетНаОплату
	|ИЗ
	|	Документ.ЭквайринговаяОперация	КАК ЭквайринговаяОперация
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка";
	
	Данные = ПолучитьДанныеДляСчетаФактурыНаАванс(ОснованиеСсылка, ДанныеЗаполнения, СчетФактураСсылка, ЗапросЗаполненияШапки);
	
	Возврат Не ЗначениеЗаполнено(Данные.ОписаниеОшибки);
	
КонецФункции

Функция ПолучитьДанныеДляСчетаФактурыНаАванс(ОснованиеСсылка, ДанныеЗаполнения, СчетФактураСсылка, ЗапросЗаполненияШапки)
	
	Перем ТаблицаПлатежноРасчетныеДокументы;
	
	НовыеДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	ПоляОтбораИзШапкиСФ = НовыйПоляОтбораИзШапкиСФ(ДанныеЗаполнения);
	
	ТаблицаАвансов = ПолучитьТаблицуАвансовПолученных(ОснованиеСсылка, ПоляОтбораИзШапкиСФ, ТаблицаПлатежноРасчетныеДокументы);
	
	Если ТаблицаАвансов.Количество() = 0 Тогда
		НовыеДанные.ОписаниеОшибки = СтрШаблон(НСтр("ru='Заполнение документа ""%1"" на основании документа ""%2"" отменено.
			|Не обнаружены проводки получения аванса по кредиту счета АП.'"),
			СчетФактураСсылка.Метаданные().Синоним,
			ОснованиеСсылка.Метаданные().Синоним);
		
		Возврат НовыеДанные;
	КонецЕсли;
	
	ТаблицаШапка = ЗапросЗаполненияШапки.Выполнить().Выгрузить();
	
	Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	
	ЗаполнитьПричинуНалогообложенияДляАвансаПолученного(Шапка, ТаблицаАвансов);
	
	ТаблицаСоставНФА = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(
		Метаданные.Документы.СчетФактураВыданный.ТабличныеЧасти.СоставНФА);
	
	СтавкаНДС = Неопределено;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "СтавкаНДС") Тогда
		СтавкаНДС = Шапка.СтавкаНДС;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		СтавкаНДС = УчетНДС.ПолучитьСтавкуНДСДляАвансаПоУмолчанию(Шапка.Организация, Шапка.Дата);
	КонецЕсли;
	
	ЗаполнитьТабличнуюЧастьСоставНФАДляАвансаПолученного(Шапка, ТаблицаСоставНФА, ТаблицаАвансов,
		ОснованиеСсылка, СчетФактураСсылка, СтавкаНДС, ДанныеЗаполнения);
	
	// Код вида операции
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	// Ответственные лица
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "Руководитель")
		И ЗначениеЗаполнено(Шапка.Руководитель) Тогда
		Руководитель = Шапка.Руководитель;
	Иначе
		Руководитель = ОтветственныеЛица.Руководитель;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "ГлавныйБухгалтер")
		И ЗначениеЗаполнено(Шапка.ГлавныйБухгалтер) Тогда
		ГлавныйБухгалтер = Шапка.ГлавныйБухгалтер;
	Иначе
		ГлавныйБухгалтер = ОтветственныеЛица.ГлавныйБухгалтер;
	КонецЕсли;
	
	Шапка.Вставить("Руководитель", Руководитель);
	Шапка.Вставить("ГлавныйБухгалтер", ГлавныйБухгалтер);
	
	// Типовая операция для заполняемого документа
	ТиповаяОперацияСсылка = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(
		ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.СчетФактураВыданный")));
	ТиповаяОперацияЗначенияРеквизитов = Новый Структура("Курс, Кратность");
	ЗаполнитьЗначенияСвойств(ТиповаяОперацияЗначенияРеквизитов, Шапка);
	
	ТиповаяОперация	= Новый Структура();
	ТиповаяОперация.Вставить("Ссылка",				ТиповаяОперацияСсылка);
	ТиповаяОперация.Вставить("ЗначенияРеквизитов",	ТиповаяОперацияЗначенияРеквизитов);
	
	ТабличныеЧасти	= Новый Структура();
	ТабличныеЧасти.Вставить("СоставНФА",					ТаблицаСоставНФА);
	ТабличныеЧасти.Вставить("ПлатежноРасчетныеДокументы",	ТаблицаПлатежноРасчетныеДокументы);
	
	НовыеДанные.Шапка = Шапка;
	НовыеДанные.ТабличныеЧасти = ТабличныеЧасти;
	НовыеДанные.ТиповаяОперация = ТиповаяОперация;
	
	Возврат НовыеДанные;
	
КонецФункции

//?
Функция ПолучитьДанныеДляЗаполненияНаОсновании_ПередачаГруппОбъектовОС(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_ТиповаяОперация = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка, "КЭК401,НачислятьНДС,Курс,Кратность");
	
	Если Основание_ТиповаяОперация["НачислятьНДС"] = Ложь Тогда
		// Искомые данные:
		ОписаниеОшибки = НСтр("ru='Документ ""Передача групп объектов ОС"" не требует начисления НДС'");
		ВозвратДанные.Вставить("ОписаниеОшибки", ОписаниеОшибки);
		
		// Выходим:
		Возврат Ложь;
	КонецЕсли;
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("ЕдИзмШт",	Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796")); // шт.
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка									КАК ДокументОснование,
	|	ПередачаГруппОбъектовОС.Дата,
	|	ПередачаГруппОбъектовОС.Организация,
	|	ПередачаГруппОбъектовОС.ИФО,
	|	ПередачаГруппОбъектовОС.Подразделение,
	|	ПередачаГруппОбъектовОС.Контрагент,
	|	ПередачаГруппОбъектовОС.Договор,
	|	ПередачаГруппОбъектовОС.ВалютаДокумента,
	|	""01""														КАК КодВидаОперации,
	|	КФО															КАК КФО,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)	КАК ПричинаНалогообложения
	|ИЗ
	|	Документ.ПередачаГруппОбъектовОС	КАК ПередачаГруппОбъектовОС
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновноеСредство	КАК НФА,
	|	&ЕдИзмШт			КАК ЕдиницаИзмерения,
	|	Количество,
	|	СтавкаНДС,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			ЦенаПродажи - СуммаНДС
	|		ИНАЧЕ
	|			ЦенаПродажи
	|	КОНЕЦ				КАК Сумма,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС И НЕ Сумма = 0 ТОГДА
	|			Цена - СуммаНДС * (Цена/Сумма)
	|		ИНАЧЕ
	|			Цена
	|	КОНЕЦ				КАК Цена,
	|	СуммаНДС,
	|	Всего
	|ИЗ
	|	Документ.ПередачаГруппОбъектовОС.ОсновныеСредства	КАК ОсновныеСредства
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;";

	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка		= РезультатыЗаполнения[0].Выгрузить();
	ТаблицаСоставНФА	= РезультатыЗаполнения[1].Выгрузить();
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	// Код вида операции
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	// Ответственные лица
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
	Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
	Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
	
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
	
	ТабличныеЧасти	= Новый Структура("СоставНФА", ТаблицаСоставНФА);
	ЗначенияРеквизитов = Новый Структура();
	ЗначенияРеквизитов.Вставить("КЭК40100",		Основание_ТиповаяОперация["КЭК401"]);
	ЗначенияРеквизитов.Вставить("Курс",			Основание_ТиповаяОперация["Курс"]);
	ЗначенияРеквизитов.Вставить("Кратность",	Основание_ТиповаяОперация["Кратность"]);

	ТиповаяОперацияСсылка = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(
		ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.СчетФактураВыданный")));
	
	ТиповаяОперация	= Новый Структура();
	ТиповаяОперация.Вставить("Ссылка",				ТиповаяОперацияСсылка);
	ТиповаяОперация.Вставить("ЗначенияРеквизитов",	ЗначенияРеквизитов);
	
	// Искомые данные:
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	ВозвратДанные.Вставить("ТиповаяОперация",	ТиповаяОперация);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьТаблицуАвансовПолученных(Знач ДокументОснования, Знач ПоляОтбораИзШапкиСФ, ТаблицаПлатежныхДокументов)
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаДляВводаНаОсновании();
	
	СпискиОтбора = ПолучитьСпискиОтбора(ПоляОтбораИзШапкиСФ, ПараметрыПоиска);
	
	ТаблицаАвансов = ПрочитатьПроводкиАвансовПолученных(ДокументОснования, СпискиОтбора, ПараметрыПоиска, ТаблицаПлатежныхДокументов);
	
	Возврат ТаблицаАвансов;
	
КонецФункции

Функция ПрочитатьПроводкиАвансовПолученных(Знач СписокДокументовОснований, Знач СпискиОтбора, Знач ПараметрыПоиска, ТаблицаПлатежныхДокументов = Неопределено)
	
	НаДату = Неопределено;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокДокументовОснований",			СписокДокументовОснований);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросПоиск.УстановитьПараметр("СчетАП",							БухгалтерскийУчетКлиентСервер.СчетПоКоду("АП", НаДату));
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоКФО",			СпискиОтбора.ИспользоватьОтборПоКФО);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоДоговору",		СпискиОтбора.ИспользоватьОтборПоДоговору);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоКонтрагенту",	СпискиОтбора.ИспользоватьОтборПоКонтрагенту);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	СпискиОтбора.ИспользоватьОтборПоПодразделению);
	ЗапросПоиск.УстановитьПараметр("СписокКФО",							СпискиОтбора.СписокКФО);
	ЗапросПоиск.УстановитьПараметр("СписокДоговоров",					СпискиОтбора.СписокДоговоров);
	ЗапросПоиск.УстановитьПараметр("СписокКонтрагентов",				СпискиОтбора.СписокКонтрагентов);
	ЗапросПоиск.УстановитьПараметр("СписокПодразделений",				СпискиОтбора.СписокПодразделений);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Проводки документов-оснований
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Регистратор														КАК ДокументОснование,
	|	Период															КАК Период,
	|	КФО																КАК КФО,
	|	ВЫРАЗИТЬ(СубконтоКт1 КАК Справочник.Контрагенты)				КАК Контрагент,
	|	ВЫРАЗИТЬ(СубконтоКт2 КАК Справочник.Договоры)					КАК Договор,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			ЕСТЬNULL(ПодразделениеКт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ															КАК Подразделение,
	|	КЭККт															КАК КЭК,
	|	КПСКт															КАК КПС,
	|	ВЫБОР
	|		КОГДА ВалютаКт = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ИЛИ ВалютаКт ЕСТЬ NULL 
	|			ИЛИ ВалютаКт = НЕОПРЕДЕЛЕНО ТОГДА
	|			Сумма
	|		ИНАЧЕ
	|			ВалютнаяСуммаКт
	|	КОНЕЦ															КАК Сумма,
	|	НомерПервичногоДокумента										КАК НомерПервичногоДокумента,
	|	ДатаПервичногоДокумента											КАК ДатаПервичногоДокумента
	|ПОМЕСТИТЬ
	|	ПроводкиОснований
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		Регистратор В(&СписокДокументовОснований)
	|		И СчетКт В (&СчетАП)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО В(&СписокКФО)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКонтрагенту ТОГДА
	|				ВЫРАЗИТЬ(СубконтоКт1 КАК Справочник.Контрагенты) В(&СписокКонтрагентов)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоДоговору ТОГДА
	|				ВЫРАЗИТЬ(СубконтоКт2 КАК Справочник.Договоры) В(&СписокДоговоров)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоПодразделению ТОГДА
	|				ЕСТЬNULL(ПодразделениеКт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) В(&СписокПодразделений)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Авансы полученные из проводок документов-оснований
	|//
	|ВЫБРАТЬ
	|	ДокументОснование	КАК ДокументОснование,
	|	Период				КАК Период,
	|	КФО					КАК КФО,
	|	Контрагент			КАК Контрагент,
	|	Договор				КАК Договор,
	|	Подразделение		КАК Подразделение,
	|	КЭК					КАК КЭК,
	|	КПС					КАК КПС,
	|	СУММА(Сумма)		КАК Сумма
	|ИЗ
	|	ПроводкиОснований
	|СГРУППИРОВАТЬ ПО
	|	ДокументОснование,
	|	Период,
	|	КФО,
	|	Контрагент,
	|	Договор,
	|	Подразделение,
	|	КЭК,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Реквизиты платежных документов
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НомерПервичногоДокумента	КАК НомерДокумента,
	|	ДатаПервичногоДокумента		КАК ДатаДокумента
	|ИЗ
	|	ПроводкиОснований";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	// [1]. Авансы полученные из проводок документов-оснований
	ТаблицаАвансов = РезультатыЗапроса[1].Выгрузить();
	
	// [2]. Реквизиты платежных документов
	ТаблицаПлатежныхДокументов = РезультатыЗапроса[2].Выгрузить();
	
	Возврат ТаблицаАвансов;
	
КонецФункции

Функция ПолучитьСпискиОтбора(ПоляОтбораИзШапкиСФ, ПараметрыПоиска)
	
	СпискиОтбора = Новый Структура();
	
	СпискиОтбора.Вставить("ИспользоватьОтборПоКФО",				Ложь);
	СпискиОтбора.Вставить("ИспользоватьОтборПоДоговору",		Ложь);
	СпискиОтбора.Вставить("ИспользоватьОтборПоКонтрагенту",		Ложь);
	СпискиОтбора.Вставить("ИспользоватьОтборПоПодразделению",	Ложь);
	
	СпискиОтбора.Вставить("СписокКФО",				Новый Массив());
	СпискиОтбора.Вставить("СписокДоговоров",		Новый Массив());
	СпискиОтбора.Вставить("СписокКонтрагентов",		Новый Массив());
	СпискиОтбора.Вставить("СписокПодразделений",	Новый Массив());
	
	Если ТипЗнч(ПоляОтбораИзШапкиСФ) = Тип("Структура") Тогда
		Если ЗначениеЗаполнено(ПоляОтбораИзШапкиСФ.КФО) Тогда
			СпискиОтбора.СписокКФО.Добавить(ПоляОтбораИзШапкиСФ.КФО);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПоляОтбораИзШапкиСФ.Договор) Тогда
			СпискиОтбора.СписокДоговоров.Добавить(ПоляОтбораИзШапкиСФ.Договор);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПоляОтбораИзШапкиСФ.Контрагент) Тогда
			СпискиОтбора.СписокКонтрагентов.Добавить(ПоляОтбораИзШапкиСФ.Контрагент);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПоляОтбораИзШапкиСФ.Подразделение) Тогда
			СпискиОтбора.СписокПодразделений.Добавить(ПоляОтбораИзШапкиСФ.Подразделение);
		КонецЕсли;
		
		СпискиОтбора.ИспользоватьОтборПоКФО				= СпискиОтбора.СписокКФО.Количество() > 0;
		СпискиОтбора.ИспользоватьОтборПоДоговору		= СпискиОтбора.СписокДоговоров.Количество() > 0;
		СпискиОтбора.ИспользоватьОтборПоКонтрагенту		= СпискиОтбора.СписокКонтрагентов.Количество() > 0;
		СпискиОтбора.ИспользоватьОтборПоПодразделению	= ПараметрыПоиска.ИспользоватьУчетПоПодразделениям
			И СпискиОтбора.СписокПодразделений.Количество() > 0;
	КонецЕсли;
	
	Возврат СпискиОтбора;
	
КонецФункции

Процедура ЗаполнитьСуммыПоСтавке(ТаблицаСоставНФА, НаДату, БазаВКолонкеВсего, УстановитьРасчетнуюСтавку = Ложь)
	
	ОбычнаяСтавка = УчетНДСКлиентСервер.ПолучитьОсновнуюСтавку(НаДату);
	
	РасчетнаяСтавка = УчетНДСКлиентСервер.ПолучитьРасчетнуюСтавку(ОбычнаяСтавка);
	
	МножительОбычнойСтавки = УчетНДСКлиентСервер.ПолучитьМножительСтавки(ОбычнаяСтавка);
	
	МножительРасчетнойСтавки = УчетНДСКлиентСервер.ПолучитьМножительСтавки(РасчетнаяСтавка);
	
	СоздатьКолонкуПриОтсутствии(ТаблицаСоставНФА, "Сумма");
	СоздатьКолонкуПриОтсутствии(ТаблицаСоставНФА, "СтавкаНДС");
	СоздатьКолонкуПриОтсутствии(ТаблицаСоставНФА, "СуммаНДС");
	СоздатьКолонкуПриОтсутствии(ТаблицаСоставНФА, "Всего");
	
	Для Каждого СтрокаТаблицы Из ТаблицаСоставНФА Цикл
		Если УстановитьРасчетнуюСтавку Тогда
			СтрокаТаблицы.СтавкаНДС = РасчетнаяСтавка;
		Иначе
			СтрокаТаблицы.СтавкаНДС = ОбычнаяСтавка;
		КонецЕсли;
		
		Если БазаВКолонкеВсего Тогда
			СтрокаТаблицы.СуммаНДС = СтрокаТаблицы.Всего * МножительРасчетнойСтавки;
			СтрокаТаблицы.Сумма = СтрокаТаблицы.Всего - СтрокаТаблицы.СуммаНДС;
		Иначе
			СтрокаТаблицы.СуммаНДС = СтрокаТаблицы.Сумма * МножительОбычнойСтавки;
			СтрокаТаблицы.Всего = СтрокаТаблицы.Сумма + СтрокаТаблицы.СуммаНДС;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьЦену(ТаблицаСоставНФА)
	
	СоздатьКолонкуПриОтсутствии(ТаблицаСоставНФА, "Цена");
	
	Для Каждого СтрокаТаблицы Из ТаблицаСоставНФА Цикл
		СтрокаТаблицы.Цена = ?(СтрокаТаблицы.Количество = 0, 0, СтрокаТаблицы.Сумма / СтрокаТаблицы.Количество);
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьКолонкуПриОтсутствии(ТаблицаСоставНФА, ИмяКолонки)
	
	Если ТаблицаСоставНФА.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаСоставНФА.Колонки.Добавить(ИмяКолонки,
		Метаданные.Документы.СчетФактураВыданный.ТабличныеЧасти.СоставНФА.Реквизиты[ИмяКолонки].Тип);
	
КонецПроцедуры


Процедура ЗаполнитьПричинуНалогообложенияДляАвансаПолученного(Шапка, ТаблицаАвансов)
	
	ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученный;
	
	Договор = ТаблицаАвансов[0].Договор;
	
	Если ЗначениеЗаполнено(Договор) Тогда
		ТипДоговораНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ТипДоговораНДС");
		
		Если ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.РеализацияЛомаШкур Тогда
			ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйЛом;
		КонецЕсли;
	КонецЕсли;
	
	Шапка.Вставить("ПричинаНалогообложения", ПричинаНалогообложения);
	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧастьСоставНФАДляАвансаПолученного(Шапка, ТаблицаСоставНФА, ТаблицаАвансов, ДокументОснования, СчетФактураСсылка, СтавкаНДСИзПлатежногоДокумента = Неопределено, ДанныеЗаполнения)
	
	Счет30304 = ПланыСчетов.ЕПСБУ.НайтиПоКоду("303.04");
	
	ПредставлениеПозицииАванса = УчетНДСКлиентСервер.ПолучитьПредставлениеПозицииАванса();
	
	ИменаЗаполняемыхПолейОтбораИзШапкиСФ = ПолучитьИменаЗаполняемыхПолейОтбораИзШапкиСФ();
	
	МассивИмен = СтрРазделить(ИменаЗаполняемыхПолейОтбораИзШапкиСФ, ", ", Ложь);

	Для Каждого ИмяПоля Из МассивИмен Цикл
		Шапка.Вставить(ИмяПоля, Неопределено);
	КонецЦикла;
	
	Для Каждого СтрокаАванса Из ТаблицаАвансов Цикл
		ЗаполнитьЗначенияСвойств(Шапка, СтрокаАванса, ИменаЗаполняемыхПолейОтбораИзШапкиСФ);
		
		НоваяСтрока = ТаблицаСоставНФА.Добавить();
		
		НоваяСтрока.НФА				= ПредставлениеПозицииАванса;
		НоваяСтрока.Всего			= СтрокаАванса.Сумма;
		НоваяСтрока.КПССчетРасчетов	= СтрокаАванса.КПС;
		НоваяСтрока.КПСВычетКт		= СтрокаАванса.КПС;
		НоваяСтрока.КПСНачислениеДт	= СтрокаАванса.КПС;
		НоваяСтрока.НДСКВычету		= Истина;
		
		НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
			СтрокаАванса.КЭК, "205.00",, СтрокаАванса.Период, Шапка.Организация, Шапка.ИФО);
	КонецЦикла;
	
	УчетНДСКлиентСервер.ПрименитьСтавкуДляАванса(ТаблицаСоставНФА, Шапка.Дата, СтавкаНДСИзПлатежногоДокумента);
	
	// Удаляем колонки для их автоматического заполнения далее.
	УдаляемыеКолонки = Новый Массив();
	УдаляемыеКолонки.Добавить("СчетНачислениеДт");
	УдаляемыеКолонки.Добавить("КЭКНачислениеДт");
	УдаляемыеКолонки.Добавить("Субконто1НачислениеДт");
	УдаляемыеКолонки.Добавить("Субконто2НачислениеДт");
	УдаляемыеКолонки.Добавить("Субконто3НачислениеДт");
	УдаляемыеКолонки.Добавить("СчетВычетКт");
	УдаляемыеКолонки.Добавить("Счет30304");
	УдаляемыеКолонки.Добавить("КПС30304");
	
	Для Каждого ИмяКолонки Из УдаляемыеКолонки Цикл
		ТаблицаСоставНФА.Колонки.Удалить(ИмяКолонки);
	КонецЦикла;
	
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);	
	
	Если ПрименитьСчетНаОплатуИзШапкиСФ(ДанныеЗаполнения) Тогда
		СчетНаОплату = ДанныеЗаполнения.СчетНаОплату;
		
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "СчетНаОплату") Тогда
		СчетНаОплату = Шапка.СчетНаОплату;
		
	Иначе
		СчетНаОплату = Документы.СчетНаОплату.ПустаяСсылка();
	КонецЕсли;
	
	Шапка.Вставить("СчетНаОплату", СчетНаОплату);
	
	Если ЗначениеЗаполнено(СчетНаОплату) Тогда
		ЗаполнитьПозицииИзСчетаНаОплату(ТаблицаСоставНФА, СчетНаОплату);
	Иначе
		ЗаполнитьПозицииИзНаименованияДоговора(ТаблицаСоставНФА, Шапка);
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьПоТипуДокументаОснования(Основание, Объект, ДанныеЗаполнения, ДополнительныйОтбор, ОписаниеОшибки, ВозвратТиповаяОперация = Неопределено, СчетФактураСсылка)
	
	Перем НовыеДанные;
	
	ИскатьАвансыПолученныеНаСчетах205хА = Ложь;
	
	ТипДанныхЗаполнения	= ТипЗнч(Основание);
	ЗаполнениеВыполнено	= Истина;

	Если ТипДанныхЗаполнения = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		ПолучитьДанныеДляЗаполненияНаОсновании_АктОбОказанииУслуг(Основание, СчетФактураСсылка, НовыеДанные);
		ЗаполнитьЗначенияСвойств(Объект, НовыеДанные["Шапка"]);
		Объект["СоставНФА"].Загрузить(НовыеДанные["ТабличныеЧасти"]["СоставНФА"]);
		ВозвратТиповаяОперация = НовыеДанные["ТиповаяОперация"];
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.КассовоеПоступление") тогда
		ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_КассовоеПоступление_АП(Основание, ДанныеЗаполнения, СчетФактураСсылка, НовыеДанные);
		
		Если НЕ ЗаполнениеВыполнено И ИскатьАвансыПолученныеНаСчетах205хА Тогда
			ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_КассовоеПоступление(Основание, Объект, ДополнительныйОтбор, СчетФактураСсылка, НовыеДанные);
		КонецЕсли;
		
		Если ЗаполнениеВыполнено Тогда
			ЗаполнитьЗначенияСвойств(Объект, НовыеДанные["Шапка"]);
			Объект["СоставНФА"].Загрузить(НовыеДанные["ТабличныеЧасти"]["СоставНФА"]);
			Объект["ПлатежноРасчетныеДокументы"].Загрузить(НовыеДанные["ТабличныеЧасти"]["ПлатежноРасчетныеДокументы"]);
			ВозвратТиповаяОперация = НовыеДанные["ТиповаяОперация"];
		Иначе
			ОписаниеОшибки = НовыеДанные["ОписаниеОшибки"];
		КонецЕсли;
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_НакладнаяНаОтпускМ15(Основание, СчетФактураСсылка, НовыеДанные);
		
		Если ЗаполнениеВыполнено Тогда
			ЗаполнитьЗначенияСвойств(Объект, НовыеДанные["Шапка"]);
			Объект["СоставНФА"].Загрузить(НовыеДанные["ТабличныеЧасти"]["СоставНФА"]);
			Объект["КодыУпаковокМаркируемойПродукции"].Загрузить(НовыеДанные["ТабличныеЧасти"]["КодыУпаковокМаркируемойПродукции"]);
			ВозвратТиповаяОперация = НовыеДанные["ТиповаяОперация"];
		Иначе
			ОписаниеОшибки = НовыеДанные["ОписаниеОшибки"];
		КонецЕсли;
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.НакладнаяНаОтпускИК") Тогда
		ПолучитьДанныеДляЗаполненияНаОсновании_НакладнаяНаОтпускИК(Основание, СчетФактураСсылка, НовыеДанные);
		ЗаполнитьЗначенияСвойств(Объект, НовыеДанные["Шапка"]);
		Объект["СоставНФА"].Загрузить(НовыеДанные["ТабличныеЧасти"]["СоставНФА"]);
		ВозвратТиповаяОперация = НовыеДанные["ТиповаяОперация"];
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_НакладнаяНаРеализациюТорг12(Основание, СчетФактураСсылка, НовыеДанные);
		
		Если ЗаполнениеВыполнено Тогда
			ЗаполнитьЗначенияСвойств(Объект, НовыеДанные["Шапка"]);
			Объект["СоставНФА"].Загрузить(НовыеДанные["ТабличныеЧасти"]["СоставНФА"]);
			Объект["КодыУпаковокМаркируемойПродукции"].Загрузить(НовыеДанные["ТабличныеЧасти"]["КодыУпаковокМаркируемойПродукции"]);
			ВозвратТиповаяОперация = НовыеДанные["ТиповаяОперация"];
		Иначе
			ОписаниеОшибки = НовыеДанные["ОписаниеОшибки"];
		КонецЕсли;
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.НачислениеДоходов") Тогда
		ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_НачислениеДоходов(Основание, Объект, СчетФактураСсылка, НовыеДанные);
		Если ЗаполнениеВыполнено Тогда
			ЗаполнитьЗначенияСвойств(Объект, НовыеДанные["Шапка"]);
			Объект["СоставНФА"].Загрузить(НовыеДанные["ТабличныеЧасти"]["СоставНФА"]);
			ВозвратТиповаяОперация = НовыеДанные["ТиповаяОперация"];
		Иначе
			ОписаниеОшибки = НовыеДанные["ОписаниеОшибки"];
		КонецЕсли;
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ОперацияБух") Тогда
		ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_ОперацияБух_АП(Основание, ДанныеЗаполнения, СчетФактураСсылка, НовыеДанные);
		
		Если НЕ ЗаполнениеВыполнено И ИскатьАвансыПолученныеНаСчетах205хА Тогда
			ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_ОперацияБух(Основание, СчетФактураСсылка, НовыеДанные);
		КонецЕсли;
		
		Если ЗаполнениеВыполнено Тогда
			ЗаполнитьЗначенияСвойств(Объект, НовыеДанные["Шапка"]);
