#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ЕстьОшибкиЗаполнения(ДокументОбъект, ПрименяемаяИнструкцияСтруктура = Неопределено) Экспорт
	
	Перем РезультатПроверки;
	
	//---
	// Документы остатков НДС
	//---
	Если УчетНДС.ДокументыОстатковНДС_СообщитьЕслиИспользуетсяДляВводаОстатков(ДокументОбъект) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ПрименяемаяИнструкцияСтруктура = Неопределено Тогда
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ДокументОбъект);
	КонецЕсли;
	
	ПеревыставленныйПоЗакупкеКомиссия = ДокументОбъект.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаПокупку;
	
	// Проверяем заполненность реквизитов
	ПроверяемыеРеквизиты = Новый Массив();
	ПроверяемыеРеквизиты.Добавить("Организация");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ПроверяемыеРеквизиты.Добавить("ИФО");
	КонецЕсли;
	ПроверяемыеРеквизиты.Добавить("ПричинаНалогообложения");
	ПроверяемыеРеквизиты.Добавить("ПлатежноРасчетныеДокументы.ДатаДокумента");
	ПроверяемыеРеквизиты.Добавить("ПлатежноРасчетныеДокументы.НомерДокумента");
	ПроверяемыеРеквизиты.Добавить("КФО");
	ПроверяемыеРеквизиты.Добавить("СоставНФА.НФА");
	
	ПроверяемыеСубконтоСоставНФА			= Новый Массив();
	ПроверяемыеРеквизитыУсловияСоставНФА	= Новый Структура();
	ПроверяемыеСубконтоУсловияСоставНФА		= Новый Структура();
	ПараметрыДляПроверкиУсловий				= Новый Структура();
	
	// Проверяется заполненность только при заполненной сумме налога
	Если ПрименяемаяИнструкцияСтруктура["Начисление"] И НЕ 	ПеревыставленныйПоЗакупкеКомиссия ИЛИ ПрименяемаяИнструкцияСтруктура["Вычет"] Тогда
		ПроверяемыеРеквизиты.Добавить("СоставНФА.Счет30304");
		ПроверяемыеРеквизиты.Добавить("СоставНФА.КПС30304");
		ПроверяемыеРеквизитыУсловияСоставНФА.Вставить("Счет30304",	"СуммаНДС <> 0 И НЕ КомиссионнаяТорговля");
		ПроверяемыеРеквизитыУсловияСоставНФА.Вставить("КПС30304",	"СуммаНДС <> 0 И НЕ КомиссионнаяТорговля");
	КонецЕсли;
	
	// Проверяется заполненность только при заполненной сумме налога
	Если ПрименяемаяИнструкцияСтруктура["Начисление"] И НЕ 	ПеревыставленныйПоЗакупкеКомиссия Тогда
		ПроверяемыеРеквизиты.Добавить("СоставНФА.СчетНачислениеДт");
		ПроверяемыеРеквизиты.Добавить("СоставНФА.КПСНачислениеДт");
		ПроверяемыеРеквизиты.Добавить("СоставНФА.КЭКНачислениеДт");
		ПроверяемыеРеквизитыУсловияСоставНФА.Вставить("СчетНачислениеДт",	"СуммаНДС <> 0 И НЕ КомиссионнаяТорговля");
		ПроверяемыеРеквизитыУсловияСоставНФА.Вставить("КПСНачислениеДт",	"СуммаНДС <> 0 И НЕ КомиссионнаяТорговля");
		ПроверяемыеРеквизитыУсловияСоставНФА.Вставить("КЭКНачислениеДт",	"СуммаНДС <> 0 И НЕ КомиссионнаяТорговля");
		КолонкиСубконто = Новый Соответствие();
		КолонкиСубконто.Вставить("Счет",		"СчетНачислениеДт");
		КолонкиСубконто.Вставить("Субконто1",	"Субконто1НачислениеДт");
		КолонкиСубконто.Вставить("Субконто2",	"Субконто2НачислениеДт");
		КолонкиСубконто.Вставить("Субконто3",	"Субконто3НачислениеДт");
		ПроверяемыеСубконтоСоставНФА.Добавить(КолонкиСубконто);
		
		ПроверяемыеСубконтоУсловияСоставНФА.Вставить("СчетНачислениеДт",
			"СуммаНДС <> 0 И ВидыСубконто_ВидСубконто_СчетНачислениеДт <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СФПолученные)");
	КонецЕсли;
	
	// Проверяется заполненность только при заполненной сумме налога
	Если ПрименяемаяИнструкцияСтруктура["Вычет"] Тогда
		ПроверяемыеРеквизиты.Добавить("СоставНФА.СчетВычетКт");
		ПроверяемыеРеквизиты.Добавить("СоставНФА.КПСВычетКт");
		
		ПроверяемыеРеквизитыУсловияСоставНФА.Вставить("СчетВычетКт",	"НДСКВычету И СуммаНДС <> 0");
		ПроверяемыеРеквизитыУсловияСоставНФА.Вставить("КПСВычетКт",		"НДСКВычету И СуммаНДС <> 0");
	КонецЕсли;
	
	Если ПрименяемаяИнструкцияСтруктура["СчетРасчетовИспользуется"] Тогда
		ПроверяемыеРеквизиты.Добавить("СоставНФА.СчетРасчетов");
		ПроверяемыеРеквизиты.Добавить("СоставНФА.КПССчетРасчетов");
		
		ПроверяемыеРеквизитыУсловияСоставНФА.Вставить("КПССчетРасчетов",	"ЗначениеЗаполнено(СчетРасчетов)");
	КонецЕсли;
	
	Если ПрименяемаяИнструкцияСтруктура["КомиссионнаяРеализация"] Тогда
		ПроверяемыеРеквизиты.Добавить("Комитент");
	КонецЕсли;
	
	ПроверяемыеСубконто = Новый Структура();
	ПроверяемыеСубконто.Вставить("СоставНФА", ПроверяемыеСубконтоСоставНФА);
	
	ПроверяемыеРеквизитыУсловия = Новый Структура();
	ПроверяемыеРеквизитыУсловия.Вставить("СоставНФА", ПроверяемыеРеквизитыУсловияСоставНФА);
	
	ПроверяемыеСубконтоУсловия	= Новый Структура();
	ПроверяемыеСубконтоУсловия.Вставить("СоставНФА", ПроверяемыеСубконтоУсловияСоставНФА);
	
	ПараметрыПроверки = Новый Структура("
		|ПроверяемыеРеквизиты,
		|ПроверяемыеСубконто,
		|ПроверяемыеРеквизитыУсловия,
		|ПроверяемыеСубконтоУсловия,
		|ВыводитьСообщения",
		ПроверяемыеРеквизиты,
		ПроверяемыеСубконто,
		ПроверяемыеРеквизитыУсловия,
		ПроверяемыеСубконтоУсловия,
		Истина);
	
	РеквизитыЗаполнены = ОбщегоНазначенияБГУ.УказанныеРеквизитыЗаполнены(
		ДокументОбъект,
		ПараметрыПроверки,
		РезультатПроверки);
	
	ЕстьОшибкиЗаполнения = НЕ РеквизитыЗаполнены;
	
	ПроверитьЗаполнениеТабличнойЧастиСчетаФактурыОтКомиссионера(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	Перем ПрименяемаяИнструкцияСтруктура, ДокументОснованиеДата;
	
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("ВходящийНДС",						ПолучитьПустуюТаблицуРегистра(ДокументОбъект.Движения.ВходящийНДС));
	ТаблицыДляДвижений.Вставить("ВходящийНДСКРаспределению",		ПолучитьПустуюТаблицуРегистра(ДокументОбъект.Движения.ВходящийНДСКРаспределению));
	ТаблицыДляДвижений.Вставить("КнигаПокупок",						ПолучитьПустуюТаблицуРегистра(ДокументОбъект.Движения.КнигаПокупок));
	ТаблицыДляДвижений.Вставить("ДополнительныеЛистыКнигиПокупок",	ПолучитьПустуюТаблицуРегистра(ДокументОбъект.Движения.ДополнительныеЛистыКнигиПокупок));
	ТаблицыДляДвижений.Вставить("КнигаПродаж",						ПолучитьПустуюТаблицуРегистра(ДокументОбъект.Движения.КнигаПродаж));
	ТаблицыДляДвижений.Вставить("ДополнительныеЛистыКнигиПродаж",	ПолучитьПустуюТаблицуРегистра(ДокументОбъект.Движения.ДополнительныеЛистыКнигиПродаж));
	ТаблицыДляДвижений.Вставить("ИсходящийНДС",						ПолучитьПустуюТаблицуРегистра(ДокументОбъект.Движения.ИсходящийНДС));
	ТаблицыДляДвижений.Вставить("ЖурналУчетаСчетовФактур",			ПолучитьПустуюТаблицуРегистра(ДокументОбъект.Движения.ЖурналУчетаСчетовФактур));
	
	ШапкаДокумента = ДокументОбъект;
	
	Если ЗначениеЗаполнено(ШапкаДокумента.ДокументОснование) Тогда
		ДокументОснованиеДата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШапкаДокумента.ДокументОснование, "Дата");
	КонецЕсли;
	
	Если Не ДополнительныеСвойства.Свойство("ПрименяемаяИнструкцияСтруктура", ПрименяемаяИнструкцияСтруктура) Тогда
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ДокументОбъект);
	КонецЕсли;
	
	ЗаполнитьВалютныеСуммы = УчетНДС.СледуетЗаполнитьВалютныеСуммы();
	
	РегистрироватьВычетПриНулевойСуммеНалога = УчетНДСКлиентСервер.РегистрироватьВычетПриНулевойСуммеНалога();
	
	Период = УчетНДСВызовСервера.ДатаФормированияДвиженияВРегистреНДС(ДокументСсылка);
	
	ТиповаяОперация = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументСсылка, "Курс,Кратность");
	
	Курс		= ТиповаяОперация.Курс;
	Кратность	= ТиповаяОперация.Кратность;
	
	Если Не ЗначениеЗаполнено(Курс) Тогда
		Курс = 1;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Кратность) Тогда
		Кратность = 1;
	КонецЕсли;
	
	ТЗСоставНФА = ДокументОбъект.СоставНФА.Выгрузить();
	
	УчетНДС.ЗаполнитьВидЦенности(ТЗСоставНФА, ШапкаДокумента.ПричинаНалогообложения);
	
	Для Каждого СтрокаТаблицы Из ТЗСоставНФА Цикл
		
		Если ШапкаДокумента.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаПокупку Тогда
			Прервать;
		КонецЕсли;
		
		Если СтрокаТаблицы.КомиссионнаяТорговля Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаБезНДСРублевая	= Окр(СтрокаТаблицы.Сумма * Курс / Кратность, 2);
		СуммаНДСРублевая	= Окр(СтрокаТаблицы.СуммаНДС * Курс / Кратность, 2);
		
		СуммаБезНДСВалютная	= ?(ЗаполнитьВалютныеСуммы, СтрокаТаблицы.Сумма, 0);
		СуммаНДСВалютная	= ?(ЗаполнитьВалютныеСуммы, СтрокаТаблицы.СуммаНДС, 0);
		
		Если ПрименяемаяИнструкцияСтруктура["Вычет"] И СтрокаТаблицы.НДСКВычету И Не (СтрокаТаблицы.СуммаНДС = 0 И Не РегистрироватьВычетПриНулевойСуммеНалога) Тогда
			ВычетСразу = ПрименяемаяИнструкцияСтруктура["ВычетСразу"]
				И ?(ПрименяемаяИнструкцияСтруктура["РаспределениеВозможно"], Не СтрокаТаблицы.НДСКРаспределению, Истина);
			
			ВычетВБудущемКРаспределению = ПрименяемаяИнструкцияСтруктура["РаспределениеВозможно"] И СтрокаТаблицы.НДСКРаспределению;
			
			ВычетВБудущемБезРаспределения = Не ВычетСразу И Не ВычетВБудущемКРаспределению;
			
			ВычетВБудущем = ВычетВБудущемКРаспределению Или ВычетВБудущемБезРаспределения;
			
			Если ВычетВБудущем Тогда
				Если ВычетВБудущемБезРаспределения Тогда
					//
					// Движения по регистру ВходящийНДС
					//
					НоваяСтрока = ТаблицыДляДвижений.ВходящийНДС.Добавить();
					
				ИначеЕсли ВычетВБудущемКРаспределению Тогда
					//
					// Движения по регистру ВходящийНДСКРаспределению
					//
					НоваяСтрока = ТаблицыДляДвижений.ВходящийНДСКРаспределению.Добавить();
				КонецЕсли;
				
				НоваяСтрока.ВидДвижения				= ВидДвиженияНакопления.Приход;
				НоваяСтрока.Период					= Период;

				НоваяСтрока.Организация				= ШапкаДокумента.Организация;
				НоваяСтрока.СчетФактура				= ДокументСсылка;
				НоваяСтрока.ПричинаНалогообложения	= ШапкаДокумента.ПричинаНалогообложения;
				НоваяСтрока.ВидЦенности				= СтрокаТаблицы.ВидЦенности;
				НоваяСтрока.КФО						= ШапкаДокумента.КФО;
				НоваяСтрока.СчетРасчетов			= СтрокаТаблицы.СчетРасчетов;
				НоваяСтрока.КПССчетРасчетов			= ?(ПрименяемаяИнструкцияСтруктура["СчетРасчетовИспользуется"],	СтрокаТаблицы.КПССчетРасчетов, СтрокаТаблицы.КПСВычетКт);
				НоваяСтрока.СчетКредита				= СтрокаТаблицы.СчетВычетКт;
				НоваяСтрока.ОбъектНалогообложения	= ШапкаДокумента.ДокументОснование;
				НоваяСтрока.СтавкаНДС				= СтрокаТаблицы.СтавкаНДС;
				
				НоваяСтрока.СуммаБезНДС				= СуммаБезНДСРублевая;
				НоваяСтрока.СуммаНДС				= СуммаНДСРублевая;
				НоваяСтрока.СуммаБезНДСВалютная		= СуммаБезНДСВалютная;
				НоваяСтрока.СуммаНДСВалютная		= СуммаНДСВалютная;
			КонецЕсли;
			
			Если ВычетСразу Тогда
				Если ШапкаДокумента.РегистрацияВДопЛисте Тогда
					//
					// Движения по регистру ДополнительныеЛистыКнигиПокупок
					//
					НоваяСтрока = ТаблицыДляДвижений.ДополнительныеЛистыКнигиПокупок.Добавить();
					
				Иначе
					//
					// Движения по регистру КнигаПокупок
					//
					НоваяСтрока = ТаблицыДляДвижений.КнигаПокупок.Добавить();
				КонецЕсли;
				
				НоваяСтрока.Период					= Период;
				НоваяСтрока.Организация				= ШапкаДокумента.Организация;
				НоваяСтрока.КФО						= ШапкаДокумента.КФО;
				НоваяСтрока.СчетФактура				= ДокументСсылка;
				НоваяСтрока.ПричинаНалогообложения	= ШапкаДокумента.ПричинаНалогообложения;
				НоваяСтрока.СтавкаНДС				= СтрокаТаблицы.СтавкаНДС;
				НоваяСтрока.ДатаОплаты				= ШапкаДокумента.ДатаДокументаОплаты;
				НоваяСтрока.ДатаСобытия				= ДокументОснованиеДата;
				НоваяСтрока.ВидЦенности				= СтрокаТаблицы.ВидЦенности;
				НоваяСтрока.КодВидаОперации			= ШапкаДокумента.КодВидаОперации;
				Если ШапкаДокумента.РегистрацияВДопЛисте Тогда
					НоваяСтрока.КорректируемыйПериод	= ШапкаДокумента.КорректируемыйПериод;
				КонецЕсли;
				
				НоваяСтрока.СуммаБезНДС				= СуммаБезНДСРублевая;
				НоваяСтрока.СуммаНДС				= СуммаНДСРублевая;
				НоваяСтрока.СуммаБезНДСВалютная		= СуммаБезНДСВалютная;
				НоваяСтрока.СуммаНДСВалютная		= СуммаНДСВалютная;
			КонецЕсли;
		КонецЕсли;
		
		НачислениеВБудущем = ПрименяемаяИнструкцияСтруктура["НачислениеВБудущем"]
			Или ПрименяемаяИнструкцияСтруктура["Начисление"] И СтрокаТаблицы.СтавкаНДС = Перечисления.СтавкиНДС.НДС0;
		
		НачислениеСразу = ПрименяемаяИнструкцияСтруктура["Начисление"] И Не НачислениеВБудущем;
		
		Если НачислениеВБудущем Тогда
			//
			// Движения по регистру ИсходящийНДС
			//
			НоваяСтрока = ТаблицыДляДвижений.ИсходящийНДС.Добавить();
			
			НоваяСтрока.ВидДвижения				= ВидДвиженияНакопления.Приход;
			НоваяСтрока.Период					= Период;
			
			НоваяСтрока.Организация				= ШапкаДокумента.Организация;
			НоваяСтрока.СчетФактура				= ДокументСсылка;
			НоваяСтрока.ПричинаНалогообложения	= ШапкаДокумента.ПричинаНалогообложения;
			НоваяСтрока.КФО						= ШапкаДокумента.КФО;
			НоваяСтрока.ОбъектНалогообложения	= ?(ЗначениеЗаполнено(ШапкаДокумента.ДокументОснование), ШапкаДокумента.ДокументОснование, ДокументСсылка);
			НоваяСтрока.СчетРасчетов			= СтрокаТаблицы.СчетРасчетов;
			НоваяСтрока.КПССчетРасчетов			= ?(ПрименяемаяИнструкцияСтруктура["СчетРасчетовИспользуется"],	СтрокаТаблицы.КПССчетРасчетов, СтрокаТаблицы.КПСНачислениеДт);
			НоваяСтрока.СчетДебета				=  СтрокаТаблицы.СчетНачислениеДт;
			НоваяСтрока.КОСГУСчетДебета			=  СтрокаТаблицы.КЭКНачислениеДт;
			НоваяСтрока.СтавкаНДС				=  СтрокаТаблицы.СтавкаНДС;
			
			НоваяСтрока.СуммаБезНДС				= СуммаБезНДСРублевая;
			НоваяСтрока.СуммаНДС				= СуммаНДСРублевая;
			НоваяСтрока.СуммаБезНДСВалютная		= СуммаБезНДСВалютная;
			НоваяСтрока.СуммаНДСВалютная		= СуммаНДСВалютная;
		КонецЕсли;
		
		Если НачислениеСразу Или ПрименяемаяИнструкцияСтруктура["ШкурыЛом"] Тогда
			Если ШапкаДокумента.РегистрацияВДопЛисте Тогда
				//
				// Движения по регистру ДополнительныеЛистыКнигиПродаж
				//
				НоваяСтрока = ТаблицыДляДвижений.ДополнительныеЛистыКнигиПродаж.Добавить();
				
			Иначе
				//
				// Движения по регистру КнигаПродаж
				//
				НоваяСтрока = ТаблицыДляДвижений.КнигаПродаж.Добавить();
			КонецЕсли;
			
			НоваяСтрока.Период					= Период;
			НоваяСтрока.Организация				= ШапкаДокумента.Организация;
			НоваяСтрока.КФО						= ШапкаДокумента.КФО;
			НоваяСтрока.СчетФактура				= ДокументСсылка;
			НоваяСтрока.ПричинаНалогообложения	= ШапкаДокумента.ПричинаНалогообложения;
			НоваяСтрока.СтавкаНДС				= СтрокаТаблицы.СтавкаНДС;
			НоваяСтрока.ДатаОплаты				= ШапкаДокумента.ДатаДокументаОплаты;
			НоваяСтрока.КодВидаОперации			= ШапкаДокумента.КодВидаОперации;
			Если ШапкаДокумента.РегистрацияВДопЛисте Тогда
				НоваяСтрока.КорректируемыйПериод	= ШапкаДокумента.КорректируемыйПериод;
			КонецЕсли;
			
			НоваяСтрока.СуммаБезНДС				= СуммаБезНДСРублевая;
			НоваяСтрока.СуммаНДС				= СуммаНДСРублевая;
			НоваяСтрока.СуммаБезНДСВалютная		= СуммаБезНДСВалютная;
			НоваяСтрока.СуммаНДСВалютная		= СуммаНДСВалютная;
		КонецЕсли;

	КонецЦикла;
	
	КолонкиСуммирования = "СуммаБезНДС,СуммаНДС,СуммаБезНДСВалютная,СуммаНДСВалютная";
	
	ТаблицыДляДвижений.ВходящийНДС.Свернуть("Период,Организация,СчетФактура,ПричинаНалогообложения,ВидЦенности,КФО,СчетРасчетов,КПССчетРасчетов,"
		+ "СчетКредита,ОбъектНалогообложения,СтавкаНДС,ДокументКорректировки,МестоРегистрации,Сторно", КолонкиСуммирования);

	ТаблицыДляДвижений.ВходящийНДСКРаспределению.Свернуть("Период,Организация,СчетФактура,ПричинаНалогообложения,ВидЦенности,КФО,СчетРасчетов,КПССчетРасчетов,"
		+ "СчетКредита,ОбъектНалогообложения,СтавкаНДС,ДокументКорректировки,МестоРегистрации,Сторно", КолонкиСуммирования);

	ТаблицыДляДвижений.КнигаПокупок.Свернуть("Период,Организация,КФО,СчетФактура,ПричинаНалогообложения,СтавкаНДС,ДатаОплаты,"
		+ "ДатаСобытия,ВидЦенности,КодВидаОперации,Событие", КолонкиСуммирования);

	ТаблицыДляДвижений.ДополнительныеЛистыКнигиПокупок.Свернуть("Период,Организация,КорректируемыйПериод,КФО,СчетФактура,ПричинаНалогообложения,СтавкаНДС,ДатаОплаты,"
		+ "ДатаСобытия,ВидЦенности,КодВидаОперации,Событие", КолонкиСуммирования);

	ТаблицыДляДвижений.КнигаПродаж.Свернуть("Период,Организация,КФО,СчетФактура,ПричинаНалогообложения,СтавкаНДС,ДатаОплаты,КодВидаОперации", КолонкиСуммирования);

	ТаблицыДляДвижений.ДополнительныеЛистыКнигиПродаж.Свернуть("Период,Организация,КорректируемыйПериод,КФО,СчетФактура,ПричинаНалогообложения,СтавкаНДС,ДатаОплаты,КодВидаОперации", КолонкиСуммирования);

	ТаблицыДляДвижений.ИсходящийНДС.Свернуть("Период,Организация,СчетФактура,ПричинаНалогообложения,КФО,ОбъектНалогообложения,СчетРасчетов,КПССчетРасчетов,"
		"СчетДебета,СтавкаНДС,КОСГУСчетДебета,ДокументКорректировки,МестоРегистрации,Сторно", КолонкиСуммирования);
	
	УчетНДС.ЗарегестрироватьСчетФактуру(ДокументСсылка, ТаблицыДляДвижений);
	
КонецПроцедуры

Процедура УстановитьОтветственныхЛиц(ДокументОбъект) Экспорт
	
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(ДокументОбъект);
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ОтветственныеЛица);
	
КонецПроцедуры

// Если уже установлена какая-то операция по умолчанию для всех пользователей, то ничего не меняем.
Процедура УстановитьТиповуюОперациюПоУмолчанию_2_0_17() Экспорт
	
	НоваяТиповаяОперацияПоУмолчанию = Справочники.ТиповыеОперации.СчетФактураВыданный_Основная;
	ИдентификаторДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяТиповаяОперацияПоУмолчанию, "ИдентификаторДокумента");
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		// Выходим:
		Возврат;
	КонецЕсли;
	
	// Сведения для вывода в журнал регистрации:
	ИмяСобытия			= НСтр("ru='Данные. Изменение'");
	КомментарийОК 		= НСтр("ru='Установлена типовая операция по умолчанию всем пользователям документа Счет-фактура выданный'");
	КомментарийОшибка	= НСтр("ru='Ошибка при установке типовой операции по умолчанию всем пользователям документа Счет-фактура выданный: '");
	
	Попытка
		// Настраиваем запрос:
		ЗапросПоиск = Новый Запрос();
		ЗапросПоиск.УстановитьПараметр("ИдентификаторДокумента",	ИдентификаторДокумента);
		ЗапросПоиск.УстановитьПараметр("ПустойПользователь",		Справочники.Пользователи.ПустаяСсылка());
		ЗапросПоиск.УстановитьПараметр("ПустаяТиповаяОперация",		Справочники.ТиповыеОперации.ПустаяСсылка());
		ЗапросПоиск.Текст = "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Истина
		|ИЗ
		|	РегистрСведений.ТиповыеОперацииПоУмолчанию
		|ГДЕ
		|	Пользователь = &ПустойПользователь
		|	И	ИдентификаторДокумента = &ИдентификаторДокумента
		|	И	НЕ ТиповаяОперация = &ПустаяТиповаяОперация
		|;";
		
		// Выполняем запрос:
		Если ЗапросПоиск.Выполнить().Пустой() Тогда
			БухгалтерскиеОперацииВызовСервера.УстановитьОперациюПоУмолчанию(НоваяТиповаяОперацияПоУмолчанию, Истина); // ДляВсехПользователей
			
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,								// имя события
				УровеньЖурналаРегистрации.Информация,	// уровень
				,										// объект метаданных
				,										// данные
				КомментарийОК);							// комментарий
		КонецЕсли;
		
	Исключение
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,							// имя события
			УровеньЖурналаРегистрации.Ошибка,	// уровень
			,									// объект метаданных
			,									// данные
			КомментарийОшибка + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	// комментарий
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

#Область ЗаполнениеНаОсновании

Функция НовыйОснованиеСтруктура(ОснованиеСсылка) Экспорт
	
	ОснованиеСтруктура = Новый Структура();
	
	ОснованиеСтруктура.Вставить("ОснованиеСсылка",	ОснованиеСсылка);
	ОснованиеСтруктура.Вставить("ВводНаОсновании",	Истина);
	
	Возврат ОснованиеСтруктура;
	
КонецФункции

Функция ЗаполнитьНаОсновании(ДанныеЗаполнения, Объект, ОписаниеОшибки = "", ВозвратТиповаяОперация = Неопределено) Экспорт
	
	Перем ОснованиеСсылка, ДополнительныйОтбор, НайденыйДокумент;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ДанныеЗаполнения.Свойство("ОснованиеСсылка",		ОснованиеСсылка);
		ДанныеЗаполнения.Свойство("ДополнительныйОтбор",	ДополнительныйОтбор);
	Иначе
		ОснованиеСсылка = ДанныеЗаполнения;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ОснованиеСсылка) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен документ основания'");
		Возврат Ложь;
	КонецЕсли;	
	
	Если ОбнаруженСчетФактура(ДанныеЗаполнения, ОснованиеСсылка, Объект.Ссылка, НайденыйДокумент) Тогда
		ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='На основании документа счет-фактура уже сформирован (%1)'"),
			Строка(НайденыйДокумент));
		Возврат Ложь;
	КонецЕсли;
	
	// Определим ссылку на этот заполняемый счет-фактуру
	// Нужно для автоустановки субконто вида СФПолученные в табличной части
	Если Объект.Ссылка.Пустая() Тогда
		СчетФактураСсылка = Документы.СчетФактураВыданный.ПолучитьСсылку();
		
		Если ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") Тогда
			ДокументОбъект = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.СчетФактураВыданный"));
		Иначе
			ДокументОбъект = Объект;
		КонецЕсли;
		ДокументОбъект.УстановитьСсылкуНового(СчетФактураСсылка);
		
	Иначе
		СчетФактураСсылка = Объект.Ссылка;
	КонецЕсли;
	
	Если НЕ ЗаполнитьПоТипуДокументаОснования(ОснованиеСсылка, Объект, ДанныеЗаполнения, ДополнительныйОтбор, ОписаниеОшибки, ВозвратТиповаяОперация, СчетФактураСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЭтоРеализацияШкурЛома = УчетНДС.ЭтоРеализацияШкурЛома(Объект.ПричинаНалогообложения);
	
	Если ЭтоРеализацияШкурЛома Тогда
		УчетНДСКлиентСервер.ОчиститьСтавкуНДСВТаблице(Объект.СоставНФА);
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(Объект.ВалютаДокумента) тогда
		Объект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	Объект.ИдентификаторГосКонтракта = УчетНДС.ПолучитьИдентификаторГосконтракта(Объект.Договор);
	
	Если Объект.СоставНФА.Количество() = 0 тогда
		ОписаниеОшибки = НСтр("ru='Ввод счета-фактуры на основании отменен.
			|Табличная часть пустая, не содержит строк.
			|Оформление таких счетов-фактур не предусмотрено.'");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

Функция СписокАвансовПоДокументу(Знач ДокументОснования) Экспорт
	
	НаДату = Неопределено;
	
	СчетАП = БухгалтерскийУчетКлиентСервер.СчетПоКоду("АП", НаДату);
	
	СтруктураСчетовАванса = УчетНДС.ПолучитьТаблицуСчетовАвансовПолученных();
	
	МассивСчетов = СтруктураСчетовАванса["МассивСчетов"];
	
	МассивСчетов.Добавить(СчетАП);
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	ЗапросАвансы = Новый Запрос();
	ЗапросАвансы.УстановитьПараметр("СчетаАвансаПолученного",			МассивСчетов);
	ЗапросАвансы.УстановитьПараметр("ДокументОснованиеСсылка",			ДокументОснования);
	ЗапросАвансы.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	ЗапросАвансы.УстановитьПараметр("ВыбиратьПомеченныеНаУдаление",		ОбнаруживатьПомеченныеНаУдалениеСчетаФактурыПриВводеНаОсновании());
	ЗапросАвансы.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Движения документа-основания по счетам авансов полученных
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Регистратор											КАК Основание,
	|	КФО													КАК КФО,
	|	ВЫРАЗИТЬ(СубконтоКт1 КАК Справочник.Контрагенты)	КАК Контрагент,
	|	ВЫРАЗИТЬ(СубконтоКт2 КАК Справочник.Договоры)		КАК Договор,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			ЕСТЬNULL(ПодразделениеКт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ												КАК Подразделение,
	|	СУММА(Сумма)										КАК АвансовыйПлатеж
	|ПОМЕСТИТЬ
	|	АвансовыеПоступления
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		Регистратор = &ДокументОснованиеСсылка
	|		И	СчетКт В(&СчетаАвансаПолученного),
	|		,
	|	)
	|СГРУППИРОВАТЬ ПО
	|	Регистратор,
	|	КФО,
	|	ВЫРАЗИТЬ(СубконтоКт1 КАК Справочник.Контрагенты),
	|	ВЫРАЗИТЬ(СубконтоКт2 КАК Справочник.Договоры),
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			ЕСТЬNULL(ПодразделениеКт,
	|				ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Список планируемых к созданию счетов-фактур и уже существующих
	|//
	|ВЫБРАТЬ
	|	АвансовыеПоступления.Основание				КАК Основание,
	|	АвансовыеПоступления.КФО					КАК КФО,
	|	АвансовыеПоступления.Контрагент				КАК Контрагент,
	|	АвансовыеПоступления.Договор				КАК Договор,
	|	АвансовыеПоступления.Подразделение			КАК Подразделение,
	|	АвансовыеПоступления.АвансовыйПлатеж		КАК АвансовыйПлатеж,
	|	МАКСИМУМ(СчетФактураВыданный.Ссылка)		КАК СчетФактураВыданный
	|ИЗ
	|	АвансовыеПоступления	КАК АвансовыеПоступления
	|	ЛЕВОЕ СОЕДИНЕНИЕ	Документ.СчетФактураВыданный	КАК СчетФактураВыданный
	|		ПО	АвансовыеПоступления.Основание			= СчетФактураВыданный.ДокументОснование
	|		И	АвансовыеПоступления.КФО				= СчетФактураВыданный.КФО
	|		И	АвансовыеПоступления.Контрагент			= СчетФактураВыданный.Контрагент
	|		И	АвансовыеПоступления.Договор			= СчетФактураВыданный.Договор
	|		И	АвансовыеПоступления.Подразделение		= ВЫБОР
	|														КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|															ЕСТЬNULL(СчетФактураВыданный.Подразделение,
	|																ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|														ИНАЧЕ
	|															ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|													КОНЕЦ
	|		И	АвансовыеПоступления.АвансовыйПлатеж	= СчетФактураВыданный.СуммаДокумента
	|		И	ВЫБОР
	|			КОГДА &ВыбиратьПомеченныеНаУдаление ТОГДА
	|				ИСТИНА
	|			ИНАЧЕ
	|				НЕ СчетФактураВыданный.ПометкаУдаления
	|		КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	АвансовыеПоступления.Основание,
	|	АвансовыеПоступления.КФО,
	|	АвансовыеПоступления.Контрагент,
	|	АвансовыеПоступления.Договор,
	|	АвансовыеПоступления.АвансовыйПлатеж,
	|	АвансовыеПоступления.Подразделение";
	
	Возврат ЗапросАвансы.Выполнить().Выгрузить();
	
КонецФункции

// Заполняет колонки счетов и аналитики для Начисления, Вычета, Счета расчетов, Счета 303.04
//
// Параметры
//	ШапкаДокумента								- Структура или ДокументОбъект	- используется для определения
//													применяемой инструкции учета, а также для определения
//													КПС из рабочего плана счетов;
//
//	ТаблицаСоставНФА							- Таблица значений или Табличная часть	- заполняемая таблица;
//
//	СчетФактураСсылка							- Ссылка	- используется механизмом автоустановки субконто;
//
//	ОпределятьНеобходимостьЗаполненияКолонок	- Булево	- определяет, будут ли колонки заполняться в этой процедуре,
//													и какие именно из них, если будут.
//
//													Если = Истина, то перед заполнением колонки будет проверяться
//													необходимость заполнения каждой колонки.
//													  - При обнаружении такой колонки в переданной таблице СоставНФА
//														считается, что пересчет не требуется.
//														Значения в колонке должны быть оставлены нетронутыми,
//														раз их заполнили до вызова этой процедуры.
//													  - Если колонка не обнаружена, то она должна быть расчитана в этой процедуре.
//
//													Если = Ложь, то никакие условия больше не проверяются,
//													все колонки рассчитываются в этой процедуре.
//
//													Значение по умолчанию: Ложь
//
Процедура ЗаполнитьКолонкиСчетов(ШапкаДокумента, ТаблицаСоставНФА, СчетФактураСсылка, ОпределятьНеобходимостьЗаполненияКолонок = Ложь) Экспорт
	
	// По умолчанию заполняем все колонки по максимуму, если есть техническая возможность.
	//
	// Если в переданной таблице СоставНФА уже есть какие-либо из рассчитываемых колонок,
	// то значения в этих колонках не пересчитываются.
	// Считается, что если такие значения заполнили до вызова этой процедуры,
	// то они и должны остаться.
	
	СледуетЗаполнить = Новый Структура();
	СледуетЗаполнить.Вставить("СчетНачислениеДт",		Истина);
	СледуетЗаполнить.Вставить("КПСНачислениеДт",		Истина);
	СледуетЗаполнить.Вставить("КЭКНачислениеДт",		Истина);
	СледуетЗаполнить.Вставить("СубконтоНачислениеДт",	Истина);
	СледуетЗаполнить.Вставить("НДСКВычету",				Истина);
	СледуетЗаполнить.Вставить("СчетВычетКт",			Истина);
	СледуетЗаполнить.Вставить("КПСВычетКт",				Истина);
	СледуетЗаполнить.Вставить("СчетРасчетов",			Истина);
	СледуетЗаполнить.Вставить("КПССчетРасчетов",		Истина);
	СледуетЗаполнить.Вставить("Счет30304",				Истина);
	СледуетЗаполнить.Вставить("КПС30304",				Истина);
	
	Счет30304					= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("303.04");
	Счет40100					= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("401.00");
	ИспользоватьВалютныйУчет	= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРУ					= Константы.ВалютаРегламентированногоУчета.Получить();
	
	// Обрабатываемые колонки счетов и аналитики
	ТипКолонкиСубконто	= Новый ОписаниеТипов(Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	ТипКолонкиСчет		= Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
	ТипКолонкиКПС		= Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов");
	ТипКолонкиКЭК		= Новый ОписаниеТипов("СправочникСсылка.КОСГУ");
	ТипКолонкиБулево	= Новый ОписаниеТипов("Булево");
	КолонкиСчетов = Новый Структура();
	КолонкиСчетов.Вставить("СчетНачислениеДт",		ТипКолонкиСчет);
	КолонкиСчетов.Вставить("КПСНачислениеДт",		ТипКолонкиКПС);
	КолонкиСчетов.Вставить("КЭКНачислениеДт",		ТипКолонкиКЭК);
	КолонкиСчетов.Вставить("Субконто1НачислениеДт",	ТипКолонкиСубконто);
	КолонкиСчетов.Вставить("Субконто2НачислениеДт",	ТипКолонкиСубконто);
	КолонкиСчетов.Вставить("Субконто3НачислениеДт",	ТипКолонкиСубконто);
	КолонкиСчетов.Вставить("НДСКВычету",			ТипКолонкиБулево);
	КолонкиСчетов.Вставить("НДСКРаспределению",		ТипКолонкиБулево);
	КолонкиСчетов.Вставить("СчетВычетКт",			ТипКолонкиСчет);
	КолонкиСчетов.Вставить("КПСВычетКт",			ТипКолонкиКПС);
	КолонкиСчетов.Вставить("СчетРасчетов",			ТипКолонкиСчет);
	КолонкиСчетов.Вставить("КПССчетРасчетов",		ТипКолонкиКПС);
	КолонкиСчетов.Вставить("Счет30304",				ТипКолонкиСчет);
	КолонкиСчетов.Вставить("КПС30304",				ТипКолонкиКПС);
	
	// Создаем при необходимости колонки счетов и аналитики
	// Определяем необходимость расчета отдельных колонок
	Для Каждого ОписаниеКолонки Из КолонкиСчетов Цикл
		ИмяКолонки = ОписаниеКолонки.Ключ;
		
		КолонкаПрисутствует = НЕ (ТаблицаСоставНФА.Колонки.Найти(ИмяКолонки) = Неопределено);
		
		Если КолонкаПрисутствует Тогда
			Если ОпределятьНеобходимостьЗаполненияКолонок Тогда
				Если ИмяКолонки = "Субконто1НачислениеДт"
					ИЛИ ИмяКолонки = "Субконто2НачислениеДт"
					ИЛИ ИмяКолонки = "Субконто3НачислениеДт" Тогда
					// Один общий признак для нескольких колонок
					СледуетЗаполнить.Вставить("СубконтоНачислениеДт", Ложь);
				Иначе
					// Персональный признак для отдельной колонки
					СледуетЗаполнить.Вставить(ИмяКолонки, Ложь);
				КонецЕсли;
			КонецЕсли;
		Иначе
			// Колонка отсутствует
			// Добавляем новую колонку
			ТаблицаСоставНФА.Колонки.Добавить(ИмяКолонки, ОписаниеКолонки.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ШапкаДокумента);
	
	ИспользуетсяНачисление		= ПрименяемаяИнструкцияСтруктура["Начисление"];
	ИспользуетсяВычет			= ПрименяемаяИнструкцияСтруктура["Вычет"];
	ИспользуетсяСчетРасчетов	= ПрименяемаяИнструкцияСтруктура["СчетРасчетовИспользуется"];
	
	ЗаполнитьСчетНачислениеДтИзИнструкции	= ИспользуетсяНачисление И ПрименяемаяИнструкцияСтруктура["СчетНачислениеДтЕдинственный"];
	ЗаполнитьСчетНачислениеДтИзПроводок		= ИспользуетсяНачисление И НЕ ПрименяемаяИнструкцияСтруктура["СчетНачислениеДтЕдинственный"];
	
	Если СледуетЗаполнить["КЭКНачислениеДт"] Тогда
		КЭКНачислениеДт = ПрименяемаяИнструкцияСтруктура.КЭКНачислениеДт;
		
		Если ЗначениеЗаполнено(КЭКНачислениеДт) Тогда
			ТаблицаСоставНФА.ЗаполнитьЗначения(КЭКНачислениеДт, "КЭКНачислениеДт");
			
			СледуетЗаполнить["КЭКНачислениеДт"] = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	//
	// Начисление
	//
	Если ИспользуетсяНачисление Тогда
		
		// Заполняем счет
		Если СледуетЗаполнить["СчетНачислениеДт"] Тогда
			
			Если ЗаполнитьСчетНачислениеДтИзИнструкции Тогда
				ТаблицаСоставНФА.ЗаполнитьЗначения(ПрименяемаяИнструкцияСтруктура["СчетНачислениеДт"], "СчетНачислениеДт");
				
			ИначеЕсли ЗаполнитьСчетНачислениеДтИзПроводок Тогда
				// Полный счет и аналитику берем из проводок документа-основания
				
				// Поэтому дальнейший пересчет КПС, КЭК и аналитики не требуется
				СледуетЗаполнить.Вставить("СубконтоНачислениеДт",	Ложь);
				СледуетЗаполнить.Вставить("КПСНачислениеДт",		Ложь);
				СледуетЗаполнить.Вставить("КЭКНачислениеДт",		Ложь);
				
				СторонаПроводки = "Кт";
				ДокументОснование = ШапкаДокумента["ДокументОснование"];
				Если ЗначениеЗаполнено(ДокументОснование) Тогда
					Попытка
						ВалютаДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ВалютаДокумента");
					Исключение
						ВалютаДокумента = Неопределено;
					КонецПопытки;
					Если НЕ ЗначениеЗаполнено(ВалютаДокумента) Тогда
						ВалютаДокумента = ВалютаРУ;
					КонецЕсли;
				Иначе
					ВалютаДокумента = ВалютаРУ;
				КонецЕсли;
				
				ТаблицаПроводокДокументаОснования = УчетНДС.ПолучитьТаблицуПроводок(
					ДокументОснование,
					ПрименяемаяИнструкцияСтруктура["СчетНачислениеДт"],
					СторонаПроводки);
				
				// Переименовываем колонки для дальнейшего сравнения таблиц
				ИмяСравниваемойКолонки = "СравниваемаяКолонкаСуммы";
				
				ИмяКолонкиСоставНФА = "Всего"; //Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда ИмяКолонкиСоставНФА = "СуммаНДС";
				ТаблицаСоставНФА.Колонки.Найти(ИмяКолонкиСоставНФА).Имя = ИмяСравниваемойКолонки;
				
				Если ВалютаДокумента = ВалютаРУ Тогда
					ИмяКолонкиПроводокСумма = "Сумма";
				Иначе
					ИмяКолонкиПроводокСумма = "ВалютнаяСумма";
				КонецЕсли;
				ТаблицаПроводокДокументаОснования.Колонки.Найти(ИмяКолонкиПроводокСумма).Имя = ИмяСравниваемойКолонки;
				
				// Расширенная таблица со счетом и аналитикой
				ИменаКолонокСвязи		= "";
				ИменаКолонокПоказателей	= ИмяСравниваемойКолонки;
				
				УсловиеСписания = "ПредопределенноеУсловие№3/" + ИмяСравниваемойКолонки;
				// "СтрокаТаблицы1." + ИмяСравниваемойКолонки + " = СтрокаТаблицы2." + ИмяСравниваемойКолонки
				
				РезультатыСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
					ТаблицаСоставНФА,
					ТаблицаПроводокДокументаОснования,
					ИменаКолонокСвязи,
					ИменаКолонокПоказателей,
					"СписанияВОбеихТаблицахПолностьюТаблица1ИПервыеСтрокиТаблицы2",
					УсловиеСписания);
				ТаблицаРасширенная = РезультатыСравнения["СписанияВОбеихТаблицахПолностьюТаблица1ИПервыеСтрокиТаблицы2"];
				
				// Обратное переименование колонок
				ТаблицаСоставНФА.Колонки.Найти(ИмяСравниваемойКолонки).Имя = ИмяКолонкиСоставНФА;
				
				// Копируем в исходную таблицу
				Для Каждого СтрокаТаблицы Из ТаблицаРасширенная Цикл
					Если СтрокаТаблицы["Счет" + СторонаПроводки + "КОСГУОборотный"] = Истина Тогда
						СтрокаТаблицы["КЭК" + СторонаПроводки] = Неопределено;
					КонецЕсли;
				КонецЦикла;
				СоответствиеИменКолонок = Новый Структура();
				СоответствиеИменКолонок.Вставить("СчетНачислениеДт",		"Счет" + СторонаПроводки);
				СоответствиеИменКолонок.Вставить("КПСНачислениеДт",			"КПС" + СторонаПроводки);
				СоответствиеИменКолонок.Вставить("КЭКНачислениеДт",			"КЭК" + СторонаПроводки);
				СоответствиеИменКолонок.Вставить("Субконто1НачислениеДт",	"Субконто" + СторонаПроводки + "1");
				СоответствиеИменКолонок.Вставить("Субконто2НачислениеДт",	"Субконто" + СторонаПроводки + "2");
				СоответствиеИменКолонок.Вставить("Субконто3НачислениеДт",	"Субконто" + СторонаПроводки + "3");
				УчетНДС.СкопироватьКолонкиТаблицы(ТаблицаСоставНФА, ТаблицаРасширенная, СоответствиеИменКолонок,, Истина);
			КонецЕсли;
		КонецЕсли;
		
		// Заполняем КПС и КЭК
		Если СледуетЗаполнить["КПСНачислениеДт"] ИЛИ СледуетЗаполнить["КЭКНачислениеДт"] Тогда
			ОписаниеТаблицы = Новый Структура();
			ОписаниеТаблицы.Вставить("ИмяКолонкиСчет",					"СчетНачислениеДт");
			
			ПараметрыЗаполнения = Новый Структура();
			ПараметрыЗаполнения.Вставить("Организация",					ШапкаДокумента["Организация"]);
			ПараметрыЗаполнения.Вставить("Дата",						ШапкаДокумента["Дата"]);
			ПараметрыЗаполнения.Вставить("КФО",							ШапкаДокумента["КФО"]);
			ПараметрыЗаполнения.Вставить("ИФО",							ШапкаДокумента["ИФО"]);
			ПараметрыЗаполнения.Вставить("СторонаПроводки",				"Дт");
			ПараметрыЗаполнения.Вставить("ЗаполнитьТолькоПустыеПоля",	Истина);
			
			Если СледуетЗаполнить["КПСНачислениеДт"] Тогда
				ОписаниеТаблицы.Вставить("ИмяКолонкиКПС",				"КПСНачислениеДт");
				ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКПС",		Истина);
			КонецЕсли;
			
			Если СледуетЗаполнить["КЭКНачислениеДт"] Тогда
				ОписаниеТаблицы.Вставить("ИмяКолонкиКЭК",				"КЭКНачислениеДт");
				ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКЭК",		Истина);
				
				ПараметрыЗаполнения.Вставить("Контрагент",				ШапкаДокумента["Контрагент"]);
			КонецЕсли;
			
			УчетНДС.ЗаполнитьТаблицуПоРабочемуПлануСчетов(ТаблицаСоставНФА, ОписаниеТаблицы, ПараметрыЗаполнения);
		КонецЕсли;
		
		// Заполняем аналитику
		Если СледуетЗаполнить["СубконтоНачислениеДт"] Тогда
			//---
			// Механизм автоустановки субконто
			//---
			МассивОбслуживаемыхИдентификаторов = Новый Массив();
			МассивОбслуживаемыхИдентификаторов.Добавить(1);
			
			ДокументСтруктура = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ШапкаДокумента);
			ДокументСтруктура.Вставить("СоставНФА", ТаблицаСоставНФА);
			ТаблицаПараметровАвтоустановки = УчетНДС.АвтоустановкаСубконто_ПолучитьТаблицуПараметрыАвтоустановки_СчетФактураВыданный_ВызовНеИзФормы(
				ДокументСтруктура,
				МассивОбслуживаемыхИдентификаторов,
				Истина,
				СчетФактураСсылка);
			УчетНДС.АвтоустановкаСубконто_ВыполнитьАвтоустановкуЗначений_ВызовНеИзФормы(ДокументСтруктура, ТаблицаПараметровАвтоустановки, Истина);
		КонецЕсли;
		
		// Начисление (КЭК и КПС)
		ПараметрыЗаполнения = Новый Структура();
		ПараметрыЗаполнения.Вставить("Организация",		ШапкаДокумента["Организация"]);
		ПараметрыЗаполнения.Вставить("Дата",			ШапкаДокумента["Дата"]);
		ПараметрыЗаполнения.Вставить("ИмяКолонкиСчет",	"СчетНачислениеДт");
		ПараметрыЗаполнения.Вставить("ИмяКолонкиКПС",	"КПСНачислениеДт");
		ПараметрыЗаполнения.Вставить("ИмяКолонкиКЭК",	"КЭКНачислениеДт");
		
		УчетНДС.ЗаполнитьКЭК189иКПС(ТаблицаСоставНФА, ПараметрыЗаполнения);
	КонецЕсли;
	
	//
	// Вычет
	//
	Если ИспользуетсяВычет Тогда
		
		Если СледуетЗаполнить["НДСКВычету"] Тогда
			ТаблицаСоставНФА.ЗаполнитьЗначения(Истина, "НДСКВычету");
		КонецЕсли;
		
		// Заполняем счет
		Если СледуетЗаполнить["СчетВычетКт"] Тогда
			// Заполняем из применяемой инструкции
			
			НДСКРаспределению	= Истина;
			СчетВычетКт			= ПрименяемаяИнструкцияСтруктура["СчетВычетКтКРаспределениюПоУмолчанию"];
			Поиск = Новый Структура("НДСКРаспределению", НДСКРаспределению);
			МассивСтрок = ТаблицаСоставНФА.НайтиСтроки(Поиск);
			Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
				СтрокаТаблицы["СчетВычетКт"] = СчетВычетКт;
			КонецЦикла;
			
			НДСКРаспределению	= Ложь;
			СчетВычетКт			= ПрименяемаяИнструкцияСтруктура["СчетВычетКтБезРаспределенияПоУмолчанию"];
			Поиск = Новый Структура("НДСКРаспределению", НДСКРаспределению);
			МассивСтрок = ТаблицаСоставНФА.НайтиСтроки(Поиск);
			Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
				СтрокаТаблицы["СчетВычетКт"] = СчетВычетКт;
			КонецЦикла;
		КонецЕсли;
		
		// Заполняем КПС
		Если СледуетЗаполнить["КПСВычетКт"] Тогда
			ОписаниеТаблицы = Новый Структура();
			ОписаниеТаблицы.Вставить("ИмяКолонкиСчет",					"СчетВычетКт");
			ОписаниеТаблицы.Вставить("ИмяКолонкиКПС",					"КПСВычетКт");
			
			ПараметрыЗаполнения = Новый Структура();
			ПараметрыЗаполнения.Вставить("Организация",					ШапкаДокумента["Организация"]);
			ПараметрыЗаполнения.Вставить("Дата",						ШапкаДокумента["Дата"]);
			ПараметрыЗаполнения.Вставить("КФО",							ШапкаДокумента["КФО"]);
			ПараметрыЗаполнения.Вставить("ИФО",							ШапкаДокумента["ИФО"]);
			ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКПС",			Истина);
			ПараметрыЗаполнения.Вставить("ЗаполнитьТолькоПустыеПоля",	Истина);
			
			УчетНДС.ЗаполнитьТаблицуПоРабочемуПлануСчетов(ТаблицаСоставНФА, ОписаниеТаблицы, ПараметрыЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
	//
	// Счет расчетов
	//
	Если ИспользуетсяСчетРасчетов Тогда
		Если СледуетЗаполнить["СчетРасчетов"] Тогда
			АналитикаСчетаРасчетов = ПолучитьАналитикуСчетаРасчетов(ШапкаДокумента, ПрименяемаяИнструкцияСтруктура.НалоговыйАгент);
			
			Для Каждого СтрокаТаблицы Из ТаблицаСоставНФА Цикл
				СтрокаТаблицы.СчетРасчетов		= АналитикаСчетаРасчетов.Счет;
				СтрокаТаблицы.КПССчетРасчетов	= АналитикаСчетаРасчетов.КПС;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	//
	// Счет 303.04
	//
	Если СледуетЗаполнить["Счет30304"] Тогда
		ТаблицаСоставНФА.ЗаполнитьЗначения(Счет30304, "Счет30304");
	КонецЕсли;
	
	Если СледуетЗаполнить["КПС30304"] Тогда
		ОписаниеТаблицы = Новый Структура();
		ОписаниеТаблицы.Вставить("ИмяКолонкиСчет",					"Счет30304");
		ОписаниеТаблицы.Вставить("ИмяКолонкиКПС",					"КПС30304");
		
		ПараметрыЗаполнения = Новый Структура();
		ПараметрыЗаполнения.Вставить("Организация",					ШапкаДокумента["Организация"]);
		ПараметрыЗаполнения.Вставить("Дата",						ШапкаДокумента["Дата"]);
		ПараметрыЗаполнения.Вставить("КФО",							ШапкаДокумента["КФО"]);
		ПараметрыЗаполнения.Вставить("ИФО",							ШапкаДокумента["ИФО"]);
		ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКПС",			Истина);
		ПараметрыЗаполнения.Вставить("ЗаполнитьТолькоПустыеПоля",	Истина);
		ПараметрыЗаполнения.Вставить("ВидыПоказателяКПС",			ПрименяемаяИнструкцияСтруктура["ВидыПоказателяКПС30304"]);
		
		УчетНДС.ЗаполнитьТаблицуПоРабочемуПлануСчетов(ТаблицаСоставНФА, ОписаниеТаблицы, ПараметрыЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьОтборОстаткиВходящийНДСАвансыПолученные(Объект) Экспорт
	
	Отбор = УчетНДС.НовыйОтборОстаткиВходящийНДСАвансыПолученные();
	
	Отбор.НаДату		= Объект.Дата;
	Отбор.Организация	= Объект.Организация;
	
	Отбор.СписокКФО.Добавить(Объект.КФО);
	Отбор.СписокКонтрагентов.Добавить(Объект.Контрагент);
	Отбор.СписокДоговоров.Добавить(Объект.Договор);
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Отбор.СписокДокументовЗачетаАванса.Добавить(Объект.ДокументОснование);
	КонецЕсли;
	
	Возврат Отбор;
	
КонецФункции

