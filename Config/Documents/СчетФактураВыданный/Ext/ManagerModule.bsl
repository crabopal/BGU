Функция ВозможенВводНесколькихДокументовНаОснованииОдного(Основание)
	
	СписокТипов = ПолучитьСписокТиповДокументовНесколькоНаОснованииОдного();
	
	Возврат (СписокТипов.Найти(ТипЗнч(Основание)) <> Неопределено);
	
КонецФункции

Функция ПолучитьПараметрыПоискаДляВводаНаОсновании()
	
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	Возврат ПараметрыПоиска;
	
КонецФункции

Функция НовыйПоляОтбораИзШапкиСФ(ДанныеЗаполнения)
	
	Если Не ДанныеЗаполнения.Свойство("ДополнительныйОтбор") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ДанныеЗаполнения.ДополнительныйОтбор = Неопределено И Не ДанныеЗаполнения.Свойство("СчетНаОплату") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПоляОтбораИзШапкиСФ = Новый Структура(ПолучитьИменаПолейОтбораИзШапкиСФ());
	
	Если ДанныеЗаполнения.ДополнительныйОтбор <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПоляОтбораИзШапкиСФ, ДанныеЗаполнения.ДополнительныйОтбор);
	КонецЕсли;
	
	Если ДанныеЗаполнения.Свойство("СчетНаОплату") Тогда
		ЗаполнитьЗначенияСвойств(ПоляОтбораИзШапкиСФ, ДанныеЗаполнения, "СчетНаОплату");
	КонецЕсли;
	
	Возврат ПоляОтбораИзШапкиСФ;
	
КонецФункции

Функция ПрименитьСчетНаОплатуИзШапкиСФ(ДанныеЗаполнения)
	
	Возврат ДанныеЗаполнения.Свойство("СчетНаОплату") И ДанныеЗаполнения.Свойство("ИмяПоля") И ДанныеЗаполнения.ИмяПоля = "СчетНаОплату";
	
КонецФункции

#КонецОбласти

#Область ПозицииИзСчетаНаОплату

Функция РаспределитьСуммуАвансаПоПозициямСчетаНаОплату(ТаблицаСоставНФА, СчетНаОплатуСсылка)
	
	СуммаАванса = ТаблицаСоставНФА.Итог("Всего");
	
	СведенияСчетаНаОплату = ПолучитьСведенияСчетаНаОплату(СчетНаОплатуСсылка);
	
	СписокПозиций			= СведенияСчетаНаОплату["СписокПозиций"];
	НалоговаяБазаПоСтавкам	= СведенияСчетаНаОплату["НалоговаяБазаПоСтавкам"];
	
	Если НалоговаяБазаПоСтавкам.Количество() = 0
		ИЛИ СведенияСчетаНаОплату["ИтогоНалоговаяБаза"] <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РазбитьСуммуПоСтавкам(СуммаАванса, НалоговаяБазаПоСтавкам);
	
	СписокПозиций.Колонки.Добавить("СуммаНДС",	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(18,2)));
	СписокПозиций.Колонки.Добавить("Сумма",		Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(18,2)));
	
	// Цикл по ставкам
	Для Каждого Элемент Из НалоговаяБазаПоСтавкам Цикл
		ОбычнаяСтавка = Элемент.Ключ;
		
		СведенияСтавки = Элемент.Значение;
		
		СуммаСчетаПоСтавке = СведенияСтавки["Сумма"];
		
		СуммаАвансаПоСтавке = СведенияСтавки["СуммаАванса"];
		
		НеобходимоРассчитатьВсего = (СуммаСчетаПоСтавке <> СуммаАвансаПоСтавке);
		
		РасчетнаяСтавка = УчетНДСКлиентСервер.ПолучитьРасчетнуюСтавку(ОбычнаяСтавка);
		
		МножительСтавки = УчетНДСКлиентСервер.ПолучитьМножительСтавки(РасчетнаяСтавка);
		
		НДСсАвансаПоСтавке = Окр(СуммаАвансаПоСтавке * МножительСтавки, 2);
		
		СвойстваТаблицы = Новый Структура();
		СвойстваТаблицы.Вставить("ИтогВсего",	СуммаСчетаПоСтавке);
		СвойстваТаблицы.Вставить("НомераСтрок",	СведенияСтавки);
		
		РаспределяемыеСуммы = Новый Структура();
		РаспределяемыеСуммы.Вставить("Всего",	СуммаАвансаПоСтавке);
		РаспределяемыеСуммы.Вставить("НДС",		НДСсАвансаПоСтавке);
		
		ПараметрыРасчета = Новый Структура();
		ПараметрыРасчета.Вставить("НеобходимоРассчитатьВсего",	НеобходимоРассчитатьВсего);
		ПараметрыРасчета.Вставить("РасчетнаяСтавка",			РасчетнаяСтавка);
		
		РаспределитьСуммы(СписокПозиций, СвойстваТаблицы, РаспределяемыеСуммы, ПараметрыРасчета);
	КонецЦикла;
	
	СписокПозиций.Колонки.Удалить("НомерГруппы");
	СписокПозиций.Колонки.Удалить("НомерСтроки");
	
	Возврат СписокПозиций;
	
КонецФункции

Процедура РаспределитьСуммуНалогаПоПлатежам(ТаблицаСоставНФА, СуммаАвансаПоПозициям)
	
	СтрокаПозиции = СуммаАвансаПоПозициям[0];
	
	ВремМассив = Новый Массив();
	
	НомерСтроки = 0;
	НомерСтрокиМаксимумСуммы = 0;
	
	Для Каждого СтрокаТаблицы Из ТаблицаСоставНФА Цикл
		НомерСтроки = НомерСтроки + 1;
		
		ВремМассив.Добавить(НомерСтроки);
		
		УстановитьНомерСтрокиМаксимумСуммы(ТаблицаСоставНФА, НомерСтроки, НомерСтрокиМаксимумСуммы);
	КонецЦикла;
	
	НомераСтрок = Новый Структура();
	НомераСтрок.Вставить("НомераСтрок", ВремМассив);
	НомераСтрок.Вставить("НомерСтрокиМаксимумСуммы", НомерСтрокиМаксимумСуммы);
	
	СвойстваТаблицы = Новый Структура();
	СвойстваТаблицы.Вставить("НомераСтрок",	НомераСтрок);
	
	РаспределяемыеСуммы = Новый Структура();
	РаспределяемыеСуммы.Вставить("Всего",	СтрокаПозиции.Всего);
	РаспределяемыеСуммы.Вставить("НДС",		СтрокаПозиции.СуммаНДС);
	
	ПараметрыРасчета = Новый Структура();
	ПараметрыРасчета.Вставить("НеобходимоРассчитатьВсего",	Ложь);
	ПараметрыРасчета.Вставить("РасчетнаяСтавка",			СтрокаПозиции.СтавкаНДС);
	
	РаспределитьСуммы(ТаблицаСоставНФА, СвойстваТаблицы, РаспределяемыеСуммы, ПараметрыРасчета);
	
КонецПроцедуры

Процедура РаспределитьСуммы(Таблица, СвойстваТаблицы, РаспределяемыеСуммы, ПараметрыРасчета)
	
	Итоги = Новый Структура();
	Итоги.Вставить("Всего", 0);
	Итоги.Вставить("СуммаНДС", 0);
	
	// Расчет для всех строк, кроме строки с максимальной суммой
	// Рассчитываем по пропорции
	Для Каждого НомерСтроки Из СвойстваТаблицы.НомераСтрок["НомераСтрок"] Цикл
		Если НомерСтроки = СвойстваТаблицы.НомераСтрок["НомерСтрокиМаксимумСуммы"] Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы = Таблица[НомерСтроки - 1];
		
		СтрокаТаблицы.СтавкаНДС = ПараметрыРасчета.РасчетнаяСтавка;
		
		Если ПараметрыРасчета.НеобходимоРассчитатьВсего Тогда
			// Рассчитываем как долю
			ДоляПозиции = СтрокаТаблицы.Всего / СвойстваТаблицы.ИтогВсего;
			
			СтрокаТаблицы.Всего = Окр(РаспределяемыеСуммы.Всего * ДоляПозиции, 2);
		КонецЕсли;
		
		// Рассчитываем по ставке
		МножительСтавки = УчетНДСКлиентСервер.ПолучитьМножительСтавки(СтрокаТаблицы.СтавкаНДС);
		
		СуммаНДС = Окр(СтрокаТаблицы.Всего * МножительСтавки, 2);
		
		СтрокаТаблицы.СуммаНДС = СуммаНДС;
		
		СтрокаТаблицы.Сумма = СтрокаТаблицы.Всего - СтрокаТаблицы.СуммаНДС;
		
		Итоги.Всего = Итоги.Всего + СтрокаТаблицы.Всего;
		Итоги.СуммаНДС = Итоги.СуммаНДС + СуммаНДС;
	КонецЦикла;
	
	// Особый расчет для одной строки с максимальной суммой
	// Рассчитываем как оставшуюся часть
	Всего = РаспределяемыеСуммы.Всего - Итоги.Всего;
	
	СуммаНДС = РаспределяемыеСуммы.НДС - Итоги.СуммаНДС;
	
	СтрокаТаблицы = Таблица[СвойстваТаблицы.НомераСтрок["НомерСтрокиМаксимумСуммы"] - 1];
	
	СтрокаТаблицы.СтавкаНДС	= ПараметрыРасчета.РасчетнаяСтавка;
	СтрокаТаблицы.Всего		= Всего;
	СтрокаТаблицы.СуммаНДС	= СуммаНДС;
	СтрокаТаблицы.Сумма		= СтрокаТаблицы.Всего - СтрокаТаблицы.СуммаНДС;

КонецПроцедуры

Процедура ЗаполнитьАналитикуПозиций(ТаблицаСоставНФА, СуммаАвансаПоПозициям)
	
	Перем	ЗадающаяТаблица,
			ОбщаяАналитикаУчета,
			СоставАналитикиУчета;
	
	КоличествоАналитикПлатежа = ТаблицаСоставНФА.Количество();
	
	КоличествоПозицийСчетаНаОплату = СуммаАвансаПоПозициям.Количество();
	
	ОбходПоПлатежам = (КоличествоПозицийСчетаНаОплату = 1);
	
	Если ОбходПоПлатежам Тогда
		ЗадающаяТаблица = ТаблицаСоставНФА;
	Иначе
		ЗадающаяТаблица = СуммаАвансаПоПозициям;
		ОбщаяАналитикаУчета = ПолучитьОбщуюАналитикуУчета(ТаблицаСоставНФА);
	КонецЕсли;
	
	НоваяТаблица = Новый ТаблицаЗначений();
	Реквизиты = Метаданные.Документы.СчетФактураВыданный.ТабличныеЧасти.СоставНФА.Реквизиты;
	Для Каждого Реквизит Из Реквизиты Цикл
		НоваяТаблица.Колонки.Добавить(Реквизит.Имя, Новый ОписаниеТипов(Реквизит.Тип.Типы()));
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ЗадающаяТаблица Цикл
		НоваяСтрока = НоваяТаблица.Добавить();
		
		Если ОбходПоПлатежам Тогда
			// Платеж
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
			// Счет на оплату
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СуммаАвансаПоПозициям[0], "НФА");
		Иначе
			// Платеж
			Если КоличествоАналитикПлатежа = 1 Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТаблицаСоставНФА[0]);
			Иначе
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ОбщаяАналитикаУчета);
			КонецЕсли;
			
			// Счет на оплату
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаСоставНФА = НоваяТаблица;
	
КонецПроцедуры

Функция ПолучитьСоставАналитикиУчета()
	
	// Повторяет некоторые колонки документа Счет-фактура выданный
	
	Возврат "
		|НДСКВычету,
		|НДСКРаспределению,
		|Счет30304,
		|КПС30304,
		|СчетНачислениеДт,
		|Субконто1НачислениеДт,
		|Субконто2НачислениеДт,
		|Субконто3НачислениеДт,
		|КЭКНачислениеДт,
		|СчетВычетКт,
		|СчетРасчетов,
		|КПССчетРасчетов";
	
КонецФункции

Функция ПолучитьОбщуюАналитикуУчета(ТаблицаСоставНФА)
	
	Перем СчетРасчетов, КПССчетРасчетов;
	
	Если ТаблицаСоставНФА.Количество() = 1 Тогда
		СтрокаТаблицы = ТаблицаСоставНФА[0];
		
		СчетРасчетов = СтрокаТаблицы.СчетРасчетов;
		КПССчетРасчетов = СтрокаТаблицы.КПССчетРасчетов;
	Иначе
		ВремТЗ1 = ТаблицаСоставНФА.Скопировать();
		ВремТЗ2 = ТаблицаСоставНФА.Скопировать();
		
		ВремТЗ1.Свернуть("СчетРасчетов");
		Если ВремТЗ1.Количество() = 1 Тогда
			СчетРасчетов = ВремТЗ1[0].СчетРасчетов;
		КонецЕсли;
		
		ВремТЗ2.Свернуть("КПССчетРасчетов");
		Если ВремТЗ2.Количество() = 1 Тогда
			КПССчетРасчетов = ВремТЗ2[0].КПССчетРасчетов;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаТаблицы = ТаблицаСоставНФА[0];
	
	Результат = Новый Структура(ПолучитьСоставАналитикиУчета());
	
	ЗаполнитьЗначенияСвойств(Результат, СтрокаТаблицы);
	
	Результат.Вставить("СчетРасчетов",		СчетРасчетов);
	Результат.Вставить("КПССчетРасчетов",	КПССчетРасчетов);
	Результат.Вставить("КПСВычетКт",		КПССчетРасчетов);
	Результат.Вставить("КПСНачислениеДт",	КПССчетРасчетов);
	
	Возврат Результат;
	
КонецФункции

Процедура РазбитьСуммуПоСтавкам(Сумма, НалоговаяБазаПоСтавкам)
	
	Если НалоговаяБазаПоСтавкам.Количество() > 1 Тогда
		Коэффициенты = Новый Массив();
		
		Для Каждого Элемент Из НалоговаяБазаПоСтавкам Цикл
			СуммаПоСтавке = Элемент.Значение["Сумма"];
			Коэффициенты.Добавить(СуммаПоСтавке);
		КонецЦикла;
		
		СуммаПоСтавкам = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(Сумма, Коэффициенты, 2);
	Иначе
		СуммаПоСтавкам = Новый Массив();
		СуммаПоСтавкам.Добавить(Сумма);
	КонецЕсли;
	
	Индекс = 0;
	
	Для Каждого Элемент Из НалоговаяБазаПоСтавкам Цикл
		СуммаПоСтавке = СуммаПоСтавкам[Индекс];
		
		Элемент.Значение.Вставить("СуммаАванса", СуммаПоСтавке);
		
		Индекс = Индекс + 1;
	КонецЦикла;
		
КонецПроцедуры

Функция ПолучитьСведенияСчетаНаОплату(ДокументСсылка)
	
	СписокПозиций = ПолучитьСписокПозицийСчетаНаОплату(ДокументСсылка);
	
	НалоговаяБазаПоСтавкам = ПолучитьНалоговуюБазуПоСтавкам(СписокПозиций);
	
	ИтогоНалоговаяБаза = 0;
	
	Для Каждого Элемент Из НалоговаяБазаПоСтавкам Цикл
		Сумма = Элемент.Значение["Сумма"];
		
		ИтогоНалоговаяБаза = ИтогоНалоговаяБаза + Сумма;
	КонецЦикла;
	
	Сведения = Новый Структура();
	Сведения.Вставить("СписокПозиций",			СписокПозиций);
	Сведения.Вставить("ИтогоНалоговаяБаза",		ИтогоНалоговаяБаза);
	Сведения.Вставить("НалоговаяБазаПоСтавкам",	НалоговаяБазаПоСтавкам);
	
	Возврат Сведения;
	
КонецФункции

Функция ПолучитьНалоговуюБазуПоСтавкам(СписокПозиций)
	
	НалоговаяБаза = Новый Соответствие();
	
	Для НомерСтроки = 1 По СписокПозиций.Количество() Цикл
		СтрокаТаблицы = СписокПозиций[НомерСтроки - 1];
		
		СтавкаНДС = СтрокаТаблицы.СтавкаНДС;
		
		Если Не ЗначениеЗаполнено(СтавкаНДС)
			Или СтавкаНДС = Перечисления.СтавкиНДС.БезНДС
			Или СтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОбычнаяСтавка = УчетНДСКлиентСервер.ПолучитьОбычнуюСтавку(СтавкаНДС);
		
		СведенияСтавки = НалоговаяБаза.Получить(ОбычнаяСтавка);
		
		Если СведенияСтавки = Неопределено Тогда
			СведенияСтавки = Новый Структура();
			СведенияСтавки.Вставить("Сумма",					0);
			СведенияСтавки.Вставить("НомераСтрок",				Новый Массив());
			СведенияСтавки.Вставить("НомерСтрокиМаксимумСуммы",	0);
		КонецЕсли;
		
		Сумма = СтрокаТаблицы.Всего;
		
		СведенияСтавки.Сумма = СведенияСтавки.Сумма + Сумма;
		
		СведенияСтавки.НомераСтрок.Добавить(НомерСтроки);
		
		УстановитьНомерСтрокиМаксимумСуммы(СписокПозиций, НомерСтроки, СведенияСтавки.НомерСтрокиМаксимумСуммы);
		
		НалоговаяБаза.Вставить(ОбычнаяСтавка, СведенияСтавки);
	КонецЦикла;
	
	Возврат НалоговаяБаза;
	
КонецФункции

Функция ПолучитьСписокПозицийСчетаНаОплату(ДокументСсылка)
	
	ИсключаемыеСтавки = Новый Массив();
	ИсключаемыеСтавки.Добавить(Перечисления.СтавкиНДС.ПустаяСсылка());
	ИсключаемыеСтавки.Добавить(Перечисления.СтавкиНДС.БезНДС);
	ИсключаемыеСтавки.Добавить(Перечисления.СтавкиНДС.НДС0);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументСсылка",	ДокументСсылка);
	ЗапросПоиск.УстановитьПараметр("ИсключаемыеСтавки",	ИсключаемыеСтавки);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Список позиций документа Счет на оплату
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	1				КАК НомерГруппы,
	|	НомерСтроки		КАК НомерСтроки,
	|	Номенклатура	КАК НФА,
	|	СтавкаНДС		КАК СтавкаНДС,
	|	Всего			КАК Всего
	|ИЗ
	|	Документ.СчетНаОплату.Услуги
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|	И НЕ СтавкаНДС В(&ИсключаемыеСтавки)
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	2				КАК НомерГруппы,
	|	НомерСтроки		КАК НомерСтроки,
	|	Номенклатура	КАК НФА,
	|	СтавкаНДС		КАК СтавкаНДС,
	|	Всего			КАК Всего
	|ИЗ
	|	Документ.СчетНаОплату.Материалы
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|	И НЕ СтавкаНДС В(&ИсключаемыеСтавки)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	3				КАК НомерГруппы,
	|	НомерСтроки		КАК НомерСтроки,
	|	ОС				КАК НФА,
	|	СтавкаНДС		КАК СтавкаНДС,
	|	Всего			КАК Всего
	|ИЗ
	|	Документ.СчетНаОплату.ОсновныеСредства
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|	И НЕ СтавкаНДС В(&ИсключаемыеСтавки)
	|УПОРЯДОЧИТЬ ПО
	|	НомерГруппы,
	|	НомерСтроки";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Процедура УстановитьНомерСтрокиМаксимумСуммы(Таблица, НомерСтроки, НомерСтрокиМаксимумСуммы)
	
	Если НЕ ЗначениеЗаполнено(НомерСтрокиМаксимумСуммы) Тогда
		НомерСтрокиМаксимумСуммы = НомерСтроки;
		
	ИначеЕсли Таблица[НомерСтроки - 1].Всего >= Таблица[НомерСтрокиМаксимумСуммы - 1].Всего Тогда
		НомерСтрокиМаксимумСуммы = НомерСтроки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПозицииИзНаименованияДоговора(ТаблицаСоставНФА, Шапка);
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "Организация")
		Или Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "Договор") Тогда
		Возврат;
	КонецЕсли;
	
	Организация	= Шапка.Организация;
	Договор		= Шапка.Договор;
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "Дата") Тогда
		ДатаУчетнойПолитики = Шапка.Дата;
	Иначе
		ДатаУчетнойПолитики = ТекущаяДатаСеанса();
	КонецЕсли;
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, ДатаУчетнойПолитики);
	
	ИспользоватьНаименованиеДоговора = УчетнаяПолитика.НДСИспользоватьНаименованиеДоговора;
	
	Если Не ИспользоватьНаименованиеДоговора Тогда
		Возврат;
	КонецЕсли;
	
	КраткоеСодержание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "КраткоеСодержание");
	
	Если Не ЗначениеЗаполнено(КраткоеСодержание) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаСоставНФА.ЗаполнитьЗначения(КраткоеСодержание, "НФА");
	
КонецПроцедуры

#КонецОбласти

#Область ПодготовкаДанныхЭДО

Функция ПодготовитьДанныеДляЭД(ДокументСсылка, ЭтоУПД) Экспорт
	
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ВалютаДокумента) Тогда
		КурсВзаиморасчетов = 1;
		КратностьВзаиморасчетов = 1;
	Иначе
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокументСсылка.ВалютаДокумента, ДокументСсылка.Дата);
		КурсВзаиморасчетов = КурсКратность.Курс;
		КратностьВзаиморасчетов = КурсКратность.Кратность;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);	
	Запрос.УстановитьПараметр("КурсВзаиморасчетов", КурсВзаиморасчетов);
	Запрос.УстановитьПараметр("РегламентированнаяВалюта", ВалютаРегУчета);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СчетФактура.Ссылка КАК Ссылка,
	               |	СчетФактура.Номер КАК Номер,
	               |	СчетФактура.Дата КАК Дата,
	               |	СчетФактура.ВидЦенности КАК ВидЦенности,
	               |	СчетФактура.Организация КАК Организация,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоПодразделениям
	               |			ТОГДА СчетФактура.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ КАК Подразделение,
	               |	СчетФактура.Контрагент КАК Контрагент,
	               |	СчетФактура.ДокументОснование КАК ДокументОснование,
	               |	СчетФактура.ДокументОснование КАК ДокументРеализации,
	               |	ВЫБОР
	               |		КОГДА СчетФактура.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ВЫРАЗИТЬ(СчетФактура.ВалютаДокумента КАК Справочник.Валюты).Код
	               |		ИНАЧЕ ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).Код
	               |	КОНЕЦ КАК ВалютаКод,
	               |	ВЫБОР
	               |		КОГДА СчетФактура.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ВЫРАЗИТЬ(СчетФактура.ВалютаДокумента КАК Справочник.Валюты).НаименованиеПолное
	               |		ИНАЧЕ ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).НаименованиеПолное
	               |	КОНЕЦ КАК ВалютаНаименованиеПолное,
	               |	&КурсВзаиморасчетов КАК ВалютаКурс,
	               |	СчетФактура.ПричинаНалогообложения КАК ПричинаНалогообложения,
	               |	СчетФактура.Грузоотправитель КАК Грузоотправитель,
	               |	СчетФактура.Грузополучатель КАК Грузополучатель,
	               |	СчетФактура.Договор КАК Договор,
	               |	СчетФактура.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
	               |	СчетФактура.КодыВидовТоваров КАК КодыВидовТоваров,
	               |	СчетФактура.ДокументОснованиеЭДО КАК ДокументОснованиеЭДО,
	               |	СчетФактура.СведенияОВыбытииМаркированныхТоваров КАК СведенияОВыбытииМаркированныхТоваров
	               |ИЗ
	               |	Документ.СчетФактураВыданный КАК СчетФактура
	               |ГДЕ
	               |	СчетФактура.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СоставНФА.НомерСтроки КАК НомерСтроки,
	               |	СоставНФА.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	СоставНФА.НФА КАК НФА,
	               |	ЕСТЬNULL(ВЫРАЗИТЬ(СоставНФА.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Код, """") КАК ЕдиницаИзмеренияКод,
	               |	ЕСТЬNULL(ВЫРАЗИТЬ(СоставНФА.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	               |	СоставНФА.Количество КАК Количество,
	               |	СоставНФА.Цена КАК Цена,
	               |	СоставНФА.СтавкаНДС КАК СтавкаНДС,
	               |	СоставНФА.СуммаНДС КАК СуммаНДС,
	               |	СоставНФА.СуммаАкциза КАК СуммаАкциза,
	               |	СоставНФА.Всего КАК Всего,
	               |	СоставНФА.КодВидаТовара КАК КодВидаТовара,
	               |	СоставНФА.СодержаниеУслуги КАК СодержаниеУслуги,
	               |	СоставНФА.СведенияОбъемноСортовогоУчетаМаркированныхТоваров КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров
	               |ИЗ
	               |	Документ.СчетФактураВыданный.СоставНФА КАК СоставНФА
	               |ГДЕ
	               |	СоставНФА.Ссылка = &Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СоставПРД.НомерСтроки КАК НомерСтроки,
	               |	СоставПРД.ДатаДокумента КАК ДатаДокумента,
	               |	СоставПРД.НомерДокумента КАК НомерДокумента
	               |ИЗ
	               |	Документ.СчетФактураВыданный.ПлатежноРасчетныеДокументы КАК СоставПРД
	               |ГДЕ
	               |	СоставПРД.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СчетФактураКодыУпаковокМаркируемойПродукции.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	СчетФактураКодыУпаковокМаркируемойПродукции.НомерУпаковки КАК НомерУпаковки,
	               |	СчетФактураКодыУпаковокМаркируемойПродукции.ТипУпаковки КАК ТипУпаковки
	               |ИЗ
	               |	Документ.СчетФактураВыданный.КодыУпаковокМаркируемойПродукции КАК СчетФактураКодыУпаковокМаркируемойПродукции
	               |ГДЕ
	               |	СчетФактураКодыУпаковокМаркируемойПродукции.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДокументыОбОтгрузке.НомерСтроки КАК НомерСтроки,
	               |	ДокументыОбОтгрузке.НомераСтрок КАК НомераСтрок,
	               |	ДокументыОбОтгрузке.НаименованиеДокумента КАК НаименованиеДокумента,
	               |	ДокументыОбОтгрузке.НомерДокумента КАК НомерДокумента,
	               |	ДокументыОбОтгрузке.ДатаДокумента КАК ДатаДокумента
	               |ИЗ
	               |	Документ.СчетФактураВыданный.ДокументыОбОтгрузке КАК ДокументыОбОтгрузке
	               |ГДЕ
	               |	ДокументыОбОтгрузке.Ссылка = &Ссылка
				   |;
				   |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СчетаФактурыНаАванс.НомерСтроки КАК НомерСтроки,
	               |	СчетаФактурыНаАванс.СчетФактура КАК СчетФактура,
	               |	СчетаФактурыНаАванс.Дата КАК Дата,
	               |	СчетаФактурыНаАванс.Номер КАК Номер,
	               |	СчетаФактурыНаАванс.ДатаИсправления КАК ДатаИсправления,
	               |	СчетаФактурыНаАванс.НомерИсправления КАК НомерИсправления
	               |ИЗ
	               |	Документ.СчетФактураВыданный.СчетаФактурыНаАванс КАК СчетаФактурыНаАванс
	               |ГДЕ
	               |	СчетаФактурыНаАванс.Ссылка = &Ссылка";
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТаблицаШапка = МассивРезультатов[0].Выгрузить();
	
	Структура = Новый Структура();
	Структура.Вставить("Шапка",							ТаблицаШапка);
	Структура.Вставить("ТабЧастьНФА",					МассивРезультатов[1].Выгрузить());
	Структура.Вставить("ТабЧастьПРД",					МассивРезультатов[2].Выгрузить());
	Структура.Вставить("ТабЧастьМаркировкаТоваров",		МассивРезультатов[3].Выгрузить());
	Структура.Вставить("ТабЧастьДокументыОбОтгрузке",	МассивРезультатов[4].Выгрузить());
	Структура.Вставить("ТабЧастьСчетаФактурыНаАванс",	МассивРезультатов[5].Выгрузить());
	
	СтороныСделки = УчетНДС.ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(ДокументСсылка);
	Структура.Вставить("СтороныСделки", СтороныСделки);
	
	НомерДокумента = УчетНДС.ОпределитьПоОбъектуНомерСФДляВыводаВРегистрыУчета(ТаблицаШапка[0]);
	Структура.Вставить("НомерДокумента", НомерДокумента);
	
	// Прослеживаемость
	Если ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
		ДобавитьПоказателиПрослеживаемости(ДокументСсылка, Структура.ТабЧастьНФА);
	КонецЕсли;
	// Конец Прослеживаемость
	
	ДобавитьСведенияДокументыОбОтгрузкеЭДО(Структура, ЭтоУПД);
	
	Возврат Структура;
	
КонецФункции

Функция ПредварительныйКонтрольДанныхДляЭД(ДокументСсылка) Экспорт
	Результат = Истина;
	
	ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		ДокументСсылка.Организация, ВидКИАдрес);
		
	Если НЕ ЗначениеЗаполнено(АдресОрганизации) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес организации.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Контрагент) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен контрагент.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	Иначе
		Контрагент = ДокументСсылка.Контрагент;
		
		Если ЗначениеЗаполнено(Контрагент.ЮридическоеФизическоеЛицо) Тогда
			Если ТипЗнч(Контрагент.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
			Иначе
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
			КонецЕсли;
			АдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Контрагент.ЮридическоеФизическоеЛицо, ВидКИАдрес);
			
			Если НЕ ЗначениеЗаполнено(АдресКонтрагента) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес контрагента.'");
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;	
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнено юридическое/физическое лицо контрагента.'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Договор) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен договор.'");
		Сообщить(ОписаниеОшибки);
		Результат = Ложь;
	Иначе
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка.Договор, "ВидОбязательства, ДатаДоговора, НомерДоговора, УИН");	
	
		Если НЕ ЗначениеЗаполнено(РеквизитыДоговора.ВидОбязательства) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнен вид обязательства в договоре.'");
			Сообщить(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
		Если (РеквизитыДоговора.ДатаДоговора) = Дата(1,1,1) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнена дата договора.'");
			Сообщить(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(РеквизитыДоговора.НомерДоговора) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнен номер договора.'");
			Сообщить(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
		Если ЭлектронноеАктированиеБГУ.ТребуетсяЗаполнитьУИНДляОбменаСЕИС(ДокументСсылка.Организация, ДокументСсылка.Договор, ДокументСсылка.ДокументОснование) Тогда
			Если НЕ ЗначениеЗаполнено(РеквизитыДоговора.УИН) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнен УИН для договора.'");
				Сообщить(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ПричинаНалогообложения) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнена причина налогообложения.'");
		Сообщить(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	ЭтоАванс = УчетНДСПовтИсп.Аванс(ДокументСсылка.ПричинаНалогообложения);
	
	Если НЕ ЭтоАванс Тогда
		Для Каждого ТекСтрока Из ДокументСсылка.СоставНФА Цикл
			Если НЕ ЗначениеЗаполнено(ТекСтрока.ЕдиницаИзмерения) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнена единица измерения в строке %1 таблицы на закладке ""Товары, работы, услуги"".'");
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЭлектронныеДокументыБГУ.ПроверитьЗаполнениеДанныхМаркировкиВТаблицеМатериалов(ДокументСсылка, "СоставНФА", "Товары, работы, услуги", "НФА", Результат);
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

#Область ДокументыОбОтгрузке

Функция ПолучитьНаименованиеДокументаОбОтгрузке(ДокументСсылка)
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктОбОказанииУслуг")
		Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НачислениеРодительскойПлаты")
		Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НачислениеЗаУслугиОбразования")
		Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НачислениеАмортизацииПравПользованияОС")
		Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НачислениеСтудентамЗаПрочиеУслуги")
		Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов") Тогда
		Возврат НСтр("ru='Акт об оказании услуг'");
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		Возврат НСтр("ru='Товарная накладная'");
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		Возврат НСтр("ru='Накладная на отпуск материальных ценностей на сторону'");
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СдачаЭтапаРабот") Тогда
		Возврат НСтр("ru='Акт сдачи-приемки работ (этапа работ)'");

	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаЗдания") Тогда
		Возврат НСтр("ru='Акт о приеме-передаче здания (сооружения)'");
	КонецЕсли;
	
	Возврат ПолучитьНаименованиеДокументаОбОтгрузкеПоУмолчаниюДляСчетаФактуры();
	
КонецФункции

Функция ПолучитьНаименованиеДокументаОбОтгрузкеПоУмолчаниюДляСчетаФактуры()
	
	Возврат НСтр("ru='Реализация (акт, накладная)'");
	
КонецФункции

Функция ПолучитьНаименованиеДокументаОбОтгрузкеПоУмолчаниюДляУПД()
	
	Возврат НСтр("ru='Универсальный передаточный документ'");
	
КонецФункции

Функция ДобавитьСведенияДокументыОбОтгрузкеЭДО(ДанныеЭДО, ЭтоУПД)
	
	Шапка						= ДанныеЭДО.Шапка[0];
	ТаблицаСоставНФА			= ДанныеЭДО.ТабЧастьНФА;
	ТаблицаДокументыОбОтгрузке	= ДанныеЭДО.ТабЧастьДокументыОбОтгрузке;
	СтруктураНомераСчетаФактуры	= ДанныеЭДО.НомерДокумента;
	
	Таблица = ПолучитьПрименяемуюТаблицуДокументыОбОтгрузке(Шапка, ТаблицаСоставНФА, ТаблицаДокументыОбОтгрузке, СтруктураНомераСчетаФактуры, ЭтоУПД);
	
	Строка5а = УчетНДС.ПолучитьПредставлениеСтроки5а(Таблица, Шапка.Дата);
	
	ДокументыОбОтгрузке = Новый Структура();
	ДокументыОбОтгрузке.Вставить("Таблица", Таблица);
	ДокументыОбОтгрузке.Вставить("Строка5а", Строка5а);
	
	ДанныеЭДО.Вставить("ДокументыОбОтгрузке", ДокументыОбОтгрузке);
	
КонецФункции

Функция ПолучитьАвтоТаблицуДокументыОбОтгрузкеДляНесколькихОснований(ТаблицаСоставНФА)
	
	// В каждой строке переданной таблицы указан Документ-основание в отдельной колонке.
	
	ДокументыОснования = Новый ТаблицаЗначений();
	ДокументыОснования.Колонки.Добавить("Ссылка");
	ДокументыОснования.Колонки.Добавить("Наименование",	Новый ОписаниеТипов("Строка"));
	ДокументыОснования.Колонки.Добавить("Номер",		Новый ОписаниеТипов("Строка"));
	ДокументыОснования.Колонки.Добавить("Дата",			ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ДокументыОснования.Колонки.Добавить("НомераСтрок",	Новый ОписаниеТипов("Массив"));
	
	Поиск = Новый Структура("Ссылка");
	
	Для Каждого СтрокаТаблицы Из ТаблицаСоставНФА Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДокументОснование) Тогда
			Продолжить;
		КонецЕсли;
		
		Поиск.Ссылка = СтрокаТаблицы.ДокументОснование;
		
		МассивСтрок = ДокументыОснования.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			ДокументОснование = СтрокаТаблицы.ДокументОснование;
			
			СтруктураРеквизитов = Новый Структура();
			
			ПредставлениеДокумента = УчетУСН.РеквизитыПервичногоДокумента(ДокументОснование, Истина, СтруктураРеквизитов);
			
			СтрокаДокументаОснования = ДокументыОснования.Добавить();
			СтрокаДокументаОснования.Ссылка			= ДокументОснование;
			СтрокаДокументаОснования.Наименование	= ПолучитьНаименованиеДокументаОбОтгрузке(ДокументОснование);
			СтрокаДокументаОснования.Номер			= СтруктураРеквизитов.Номер;
			СтрокаДокументаОснования.Дата			= СтруктураРеквизитов.Дата;
			СтрокаДокументаОснования.НомераСтрок	= Новый Массив();
		Иначе
			СтрокаДокументаОснования = МассивСтрок[0];
		КонецЕсли;
		
		СтрокаДокументаОснования.НомераСтрок.Добавить(СтрокаТаблицы.НомерСтроки);
	КонецЦикла;
	
	Таблица = УчетНДС.НовыйТаблицаДокументыОбОтгрузке();
	
	Для Каждого СтрокаТаблицыДокументаОснования Из ДокументыОснования Цикл
		ДиапазоныНомеровСтрок = УчетНДС.ВыделитьДиапазоныЧисловыхЗначений(СтрокаТаблицыДокументаОснования.НомераСтрок);
		
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.НаименованиеДокумента	= СтрокаТаблицыДокументаОснования.Наименование;
		НоваяСтрока.НомерДокумента			= СтрокаТаблицыДокументаОснования.Номер;
		НоваяСтрока.ДатаДокумента			= СтрокаТаблицыДокументаОснования.Дата;
		НоваяСтрока.НомераСтрок				= ДиапазоныНомеровСтрок;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Действия обработчика обновления:
	// 1) Замена причины налогообложения для операций реализации шкур, лома
	// 2) Установка признака ВводНачальныхОстатков и отмена проведения документов остатков НДС
	
	Запрос = Новый Запрос();
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный
	|ГДЕ
	|	(КодВидаОперации = ""33"" ИЛИ КодВидаОперации = ""34"")
	|	И
	|	(ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный)
	|		ИЛИ ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация))
	|;";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	//---
	// Документы остатков НДС
	//---
	УчетНДС.ДокументыОстатковНДС_ДобавитьВСписокДокументыДляОбработчикаОбновленияВводНачальныхОстатков(Данные, "СчетФактураВыданный");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Действия обработчика обновления:
	// 1) Замена причины налогообложения для операций реализации шкур, лома
	// 2) Установка признака ВводНачальныхОстатков и отмена проведения документов остатков НДС
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.СчетФактураВыданный";
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта, МенеджерВременныхТаблиц, ДополнительныеПараметры);
	
	Если Не Результат.ЕстьДанныеДляОбработки Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	Если Не Результат.ЕстьЗаписиВоВременнойТаблице Тогда
		Параметры.ОбработкаЗавершена = Ложь;
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 500
	|	Ссылка,
	|	КодВидаОперации
	|ИЗ
	|	Документ.СчетФактураВыданный
	|ГДЕ
	|	Ссылка В(ВЫБРАТЬ Ссылка ИЗ ВТДляОбработки)
	|;";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	//---
	// Документы остатков НДС
	//---
	СписокДокументыОстатковНДС = УчетНДС.ДокументыОстатковНДС_СписокДокументовДляОбработчикаОбновленияВводНачальныхОстатков("СчетФактураВыданный");
	
	Пока Выборка.Следующий() Цикл
		
		ВыполнитьДействие1 = Ложь;
		УстановитьПризнакВводОстатков = Ложь;
		
		Попытка
			
			Если Выборка.КодВидаОперации = "33" Тогда
				
				ВыполнитьДействие1 = Истина;
				
				ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйЛом;
				
			ИначеЕсли Выборка.КодВидаОперации = "34" Тогда
				
				ВыполнитьДействие1 = Истина;
				
				ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.РеализацияЛом;
				
			КонецЕсли;
			
			УстановитьПризнакВводОстатков = (СписокДокументыОстатковНДС.Найти(Выборка.Ссылка) <> Неопределено);
			
			Если НЕ ВыполнитьДействие1 И НЕ УстановитьПризнакВводОстатков Тогда
				Продолжить;
			КонецЕсли;
			
			НачатьТранзакцию();
			
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			Если ВыполнитьДействие1 Тогда
				//
				// Заменяем реквизиты документа
				//
				ДокОбъект.ПричинаНалогообложения = ПричинаНалогообложения;
				
				УчетНДСКлиентСервер.ОчиститьСтавкуНДСВТаблице(ДокОбъект.СоставНФА);
				
				НовыеЗначения = Новый Структура();
				НовыеЗначения.Вставить("ПричинаНалогообложения",	ПричинаНалогообложения);
				НовыеЗначения.Вставить("СуммаНДС",					0);
				НовыеЗначения.Вставить("СуммаДокумента",			ДокОбъект.СоставНФА.Итог("Сумма"));
				
				ЗаполнитьЗначенияСвойств(ДокОбъект, НовыеЗначения);
				
				//
				// Заменяем поля движений
				//
				НовыеЗначения = Новый Структура();
				НовыеЗначения.Вставить("ПричинаНалогообложения",	ПричинаНалогообложения);
				НовыеЗначения.Вставить("СтавкаНДС",					Перечисления.СтавкиНДС.ПустаяСсылка());
				НовыеЗначения.Вставить("СуммаНДС",					0);
				НовыеЗначения.Вставить("СуммаНДСВалютная",			0);
				
				НаборЗаписейКнигаПродаж = РегистрыНакопления.КнигаПродаж.СоздатьНаборЗаписей();
				НаборЗаписейКнигаПродаж.Отбор.Регистратор.Установить(Выборка.Ссылка);
				НаборЗаписейКнигаПродаж.Прочитать();
				
				Для Каждого Запись Из НаборЗаписейКнигаПродаж Цикл
					ЗаполнитьЗначенияСвойств(Запись, НовыеЗначения);
				КонецЦикла;
				
				НаборЗаписейДопЛистыКнигиПродаж = РегистрыНакопления.ДополнительныеЛистыКнигиПродаж.СоздатьНаборЗаписей();
				НаборЗаписейДопЛистыКнигиПродаж.Отбор.Регистратор.Установить(Выборка.Ссылка);
				НаборЗаписейДопЛистыКнигиПродаж.Прочитать();
				
				Для Каждого Запись Из НаборЗаписейДопЛистыКнигиПродаж Цикл
					ЗаполнитьЗначенияСвойств(Запись, НовыеЗначения);
				КонецЦикла;
			КонецЕсли;
			
			Если УстановитьПризнакВводОстатков Тогда
				
				ДокОбъект.ВводНачальныхОстатков = Истина;
				
			КонецЕсли;
			
			//
			// Записываем документ
			//
			
			Если УстановитьПризнакВводОстатков Тогда
				
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект,,,РежимЗаписиДокумента.ОтменаПроведения);
				
			ИначеЕсли ВыполнитьДействие1 Тогда
				
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект);
				
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписейКнигаПродаж);
				
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписейДопЛистыКнигиПродаж);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
