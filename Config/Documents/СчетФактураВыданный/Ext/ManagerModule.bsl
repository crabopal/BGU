	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка									КАК ДокументОснование,
	|	СдачаЭтапаРабот.Дата,
	|	СдачаЭтапаРабот.Организация,
	|	СдачаЭтапаРабот.ИФО,
	|	СдачаЭтапаРабот.Подразделение,
	|	СдачаЭтапаРабот.Контрагент,
	|	СдачаЭтапаРабот.Договор,
	|	СдачаЭтапаРабот.ВалютаДокумента,
	|	""01""														КАК КодВидаОперации,
	|	СдачаЭтапаРабот.КФО											КАК КФО,
	|	СдачаЭтапаРабот.РеализацияПоСтавке0							КАК РеализацияПоСтавке0,
	|	ВЫБОР
