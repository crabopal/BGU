	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетФактураПолученный.Контрагент КАК ПокупательСФ,
	|	СчетФактураПолученный.НомерПервичногоДокумента КАК НомерСФ,
	|	СчетФактураПолученный.ДатаПервичногоДокумента КАК ДатаСФ,
	|	СчетФактураПолученный.СуммаДокумента КАК СтоимостьТоваров,
	|	СчетФактураПолученный.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
	|ГДЕ
	|	СчетФактураПолученный.Ссылка = &ДокументОснованиеСсылка";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка = РезультатыЗаполнения[0].Выгрузить();
	ТаблицаСоставНФА = РезультатыЗаполнения[1].Выгрузить();
	ТаблицаПлатежноРасчетныеДокументы = РезультатыЗаполнения[2].Выгрузить();
	ТаблицаПлатежноСчетаФактурыОтКомиссионера = РезультатыЗаполнения[3].Выгрузить();
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	// Код вида операции
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
	
	// Ответственные лица
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
	Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
	Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
	
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСоставНФА, СчетФактураСсылка, Истина);
	
	ТабличныеЧасти	= Новый Структура;
	ТабличныеЧасти.Вставить("СоставНФА", ТаблицаСоставНФА);
	ТабличныеЧасти.Вставить("ПлатежноРасчетныеДокументы", ТаблицаПлатежноРасчетныеДокументы);
	ТабличныеЧасти.Вставить("СчетаФактурыОтКомиссионера", ТаблицаПлатежноСчетаФактурыОтКомиссионера);
	
	// Искомые данные:
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата()
	
	Возврат Новый Структура("
		|Шапка,
		|ТабличныеЧасти,
		|ТиповаяОперация,
		|ОписаниеОшибки");
	
КонецФункции

Функция ПолучитьОтветственныхЛиц(Шапка)
	
	ОтветственныеЛица = Новый Структура();
	ОтветственныеЛица.Вставить("Руководитель");
	ОтветственныеЛица.Вставить("ГлавныйБухгалтер");
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "Организация")
		Или Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "Дата")
		Или Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "Подразделение") Тогда
		Возврат ОтветственныеЛица;
	КонецЕсли;
	
	ЛицоРуководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Руководитель",
		Шапка.Организация,
		Шапка.Дата,
		Шапка.Подразделение);
		
	ЛицоГлавныйБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Главный бухгалтер",
		Шапка.Организация,
		Шапка.Дата,
		Шапка.Подразделение);
		
	ОтветственныеЛица.Руководитель		= ЛицоРуководитель.ОтветственноеЛицоСсылка;
	ОтветственныеЛица.ГлавныйБухгалтер	= ЛицоГлавныйБухгалтер.ОтветственноеЛицоСсылка;
	
	Возврат ОтветственныеЛица;
	
КонецФункции

Функция НовыйОтборТаблицыПроводок()
	
	Отбор = Новый Структура("Дата,КФО,Контрагент,Договор,Подразделение");
	
	Возврат Отбор;
	
КонецФункции

Функция НовыйДополнительныеПараметрыТаблицыПроводок()
	
	ДополнительныеПараметры = Новый Структура();
	
	ДополнительныеПараметры.Вставить("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ДополнительныеПараметры.Вставить("ИспользоватьВалютныйУчет",			ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

Функция ПолучитьАналитикуСчетаРасчетов(ШапкаДокумента, НалоговыйАгент)
	
	ДокументОснованиеСсылка = ШапкаДокумента["ДокументОснование"];
	
	Отбор = НовыйОтборТаблицыПроводок();
	
	ЗаполнитьЗначенияСвойств(Отбор, ШапкаДокумента);
	
	ДополнительныеПараметры = НовыйДополнительныеПараметрыТаблицыПроводок();
	
	АналитикаСчетаРасчетов = Новый Структура("Счет,КПС");
	
	Если НалоговыйАгент Тогда
		АналитикаСчетаРасчетов = ПрочитатьАналитикуСчетаРасчетовПокупкаНалоговогоАгента(ДокументОснованиеСсылка, Отбор, ДополнительныеПараметры);
	КонецЕсли;
	
	Возврат АналитикаСчетаРасчетов;
	
КонецФункции

Функция ПрочитатьАналитикуСчетаРасчетовПокупкаНалоговогоАгента(ДокументОснованиеСсылка, Отбор, ДополнительныеПараметры)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументОснованиеСсылка",		ДокументОснованиеСсылка);
	ЗапросПоиск.УстановитьПараметр("Счет30200",						БухгалтерскийУчетКлиентСервер.СчетПоКоду("302.00", Отбор.Дата));
	ЗапросПоиск.УстановитьПараметр("КФО",							Отбор.КФО);
	ЗапросПоиск.УстановитьПараметр("Контрагент",					Отбор.Контрагент);
	ЗапросПоиск.УстановитьПараметр("Договор",						Отбор.Договор);
	ЗапросПоиск.УстановитьПараметр("Подразделение",					Отбор.Подразделение);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборКФО",			ЗначениеЗаполнено(Отбор.КФО));
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборКонтрагент",	ЗначениеЗаполнено(Отбор.Контрагент));
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборДоговор",		ЗначениеЗаполнено(Отбор.Договор));
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПодразделение",ЗначениеЗаполнено(Отбор.Подразделение) И ДополнительныеПараметры.ИспользоватьУчетПоПодразделениям);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СчетКт	КАК Счет,
	|	КПСКт	КАК КПС
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		Регистратор = &ДокументОснованиеСсылка
	|		И СчетДт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|		И СчетКт В ИЕРАРХИИ(&Счет30200)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборКФО ТОГДА
	|				КФО = &КФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборКонтрагент ТОГДА
	|				ВЫБОР
	|					КОГДА СубконтоКт1 ССЫЛКА Справочник.Контрагенты ТОГДА
	|						ВЫРАЗИТЬ(СубконтоКт1 КАК Справочник.Контрагенты) = &Контрагент
	|					КОГДА СубконтоКт2 ССЫЛКА Справочник.Контрагенты ТОГДА
	|						ВЫРАЗИТЬ(СубконтоКт2 КАК Справочник.Контрагенты) = &Контрагент
	|					КОГДА СубконтоКт3 ССЫЛКА Справочник.Контрагенты ТОГДА
	|						ВЫРАЗИТЬ(СубконтоКт3 КАК Справочник.Контрагенты) = &Контрагент
	|					ИНАЧЕ
	|						ЛОЖЬ
	|				КОНЕЦ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборДоговор ТОГДА
	|				ВЫБОР
	|					КОГДА СубконтоКт1 ССЫЛКА Справочник.Договоры ТОГДА
	|						ВЫРАЗИТЬ(СубконтоКт1 КАК Справочник.Договоры) = &Договор
	|					КОГДА СубконтоКт2 ССЫЛКА Справочник.Договоры ТОГДА
	|						ВЫРАЗИТЬ(СубконтоКт2 КАК Справочник.Договоры) = &Договор
	|					КОГДА СубконтоКт3 ССЫЛКА Справочник.Договоры ТОГДА
	|						ВЫРАЗИТЬ(СубконтоКт3 КАК Справочник.Договоры) = &Договор
	|					ИНАЧЕ
	|						ЛОЖЬ
	|				КОНЕЦ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПодразделение ТОГДА
	|				ЕСТЬNULL(ПодразделениеКт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) = &Подразделение
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)";
	
	ТаблицаСчета = ЗапросПоиск.Выполнить().Выгрузить();
	
	Если ТаблицаСчета.Количество() = 0 Тогда
		ТаблицаСчета.Добавить();
	КонецЕсли;
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаСчета[0]);
	
КонецФункции

Процедура ЗаполнитьСчетаФактурыНаАванс(Объект)
	
	Отбор = ПолучитьОтборОстаткиВходящийНДСАвансыПолученные(Объект);
	
	ТаблицаДокументов = УчетНДС.ПолучитьТаблицуДокументовСчетовФактурНаАванс(Отбор);
	
	Объект.СчетаФактурыНаАванс.Загрузить(ТаблицаДокументов);
	
КонецПроцедуры

#КонецОбласти

