// Составляет применяемую таблицу документов об отгрузке для документа счета-фактуры выданного.
// Применяемая таблица игнорирует фактически хранящиеся документы об отгрузке для УПД и аванса.
// Может отличаться от авто-таблицы документов об отгрузке, см.функцию ПолучитьАвтоТаблицуДокументыОбОтгрузке.
//
// Параметры:
//	Шапка				- Структура			- шапка документа счета-фактуры.
//	ТаблицаСоставНФА	- ТаблицаЗначений	- табличная часть СоставНФА.
//											Может содержать колонку ДокументОснование.
//	ТаблицаДокументыОбОтгрузке	- ТаблицаЗначений	- табличная часть ДокументыОбОтгрузке.
//	СтруктураНомераСчетаФактуры	- Структура	- номер счета-фактуры с учетом префикса обособленного подразделения.
//	ЭтоУПД						- Булево	- признак заполнения УПД (если Истина). Ложь означает заполнение счета-фактуры.
//
// Возвращаемое значение:
//	ТаблицаЗначений	- таблица документов об отгрузке, состав колонок см. функцию УчетНДС.НовыйТаблицаДокументыОбОтгрузке()
Функция ПолучитьПрименяемуюТаблицуДокументыОбОтгрузке(Шапка, ТаблицаСоставНФА, ТаблицаДокументыОбОтгрузке, СтруктураНомераСчетаФактуры, ЭтоУПД) Экспорт
	
	Таблица = УчетНДС.НовыйТаблицаДокументыОбОтгрузке();
	
	Если УчетНДСПовтИсп.Аванс(Шапка.ПричинаНалогообложения) Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Если ЭтоУПД Тогда
		ПолныйДиапазонНомеровСтрок = УчетНДС.ФорматироватьДиапазонЧисловыхЗначений(1, ТаблицаСоставНФА.Количество());
		
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.НомераСтрок				= ПолныйДиапазонНомеровСтрок;
		НоваяСтрока.НаименованиеДокумента	= ПолучитьНаименованиеДокументаОбОтгрузкеПоУмолчаниюДляУПД();
		НоваяСтрока.НомерДокумента			= СтруктураНомераСчетаФактуры.Номер;
		НоваяСтрока.ДатаДокумента			= НачалоДня(Шапка.Дата);
		
		Возврат Таблица;
	КонецЕсли;
	
	Если ТаблицаДокументыОбОтгрузке.Количество() > 0 Тогда
		Для Каждого СтрокаТаблицы Из ТаблицаДокументыОбОтгрузке Цикл
			НоваяСтрока = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		КонецЦикла;
	Иначе
		Таблица = ПолучитьАвтоТаблицуДокументыОбОтгрузке(ТаблицаСоставНФА, Шапка.ДокументРеализации);
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

// Составляет авто-таблицу документов об отгрузке для документа счета-фактуры выданного.
// Авто-таблица составляется по документам-основаниям счета-фактуры.
// Может отличаться от применяемой таблицы документов об отгрузке, см.функцию ПолучитьПрименяемуюТаблицуДокументыОбОтгрузке.
//
// Параметры:
//	ТаблицаСоставНФА	- ТаблицаЗначений	- табличная часть СоставНФА.
//											Обязательный параметр.
//											Может содержать колонку ДокументОснование.
//	ДокументОснование	- ДокументСсылка	- документ-основание счета-фактуры.
//											Необязательный параметр, если в таблице СоставНФА есть колонка ДокументОснование.
//											Если указан, то применяется для всех строк табличной части СоставНФА.
// Возвращаемое значение:
//	ТаблицаЗначений	- таблица документов об отгрузке, состав колонок см. функцию УчетНДС.НовыйТаблицаДокументыОбОтгрузке()
Функция ПолучитьАвтоТаблицуДокументыОбОтгрузке(ТаблицаСоставНФА, ДокументОснование) Экспорт
	
	Таблица = УчетНДС.НовыйТаблицаДокументыОбОтгрузке();
	
	Если ТаблицаСоставНФА.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаСоставНФА) = Тип("ДанныеФормыКоллекция") Тогда
		ВремТаблица = ТаблицаСоставНФА.Выгрузить(Новый Массив());
		
		ЕстьКолонкаДокументОснование = (ВремТаблица.Колонки.Найти("ДокументОснование") <> Неопределено);
	Иначе
		ЕстьКолонкаДокументОснование = (ТаблицаСоставНФА.Колонки.Найти("ДокументОснование") <> Неопределено);
	КонецЕсли;
	
	Если Не ЕстьКолонкаДокументОснование И Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		// Применяется один документ-основание для всей таблицы.
		
		ПолныйДиапазонНомеровСтрок = УчетНДС.ФорматироватьДиапазонЧисловыхЗначений(1, ТаблицаСоставНФА.Количество());
		
		СтруктураРеквизитов = Новый Структура();
		
		ПредставлениеДокумента = УчетУСН.РеквизитыПервичногоДокумента(ДокументОснование, Истина, СтруктураРеквизитов);
		
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.НомераСтрок				= ПолныйДиапазонНомеровСтрок;
		НоваяСтрока.НаименованиеДокумента	= ПолучитьНаименованиеДокументаОбОтгрузке(ДокументОснование);
		НоваяСтрока.НомерДокумента			= СтруктураРеквизитов.Номер;
		НоваяСтрока.ДатаДокумента			= СтруктураРеквизитов.Дата;
		
		Возврат Таблица;
	КонецЕсли;
	
	Возврат ПолучитьАвтоТаблицуДокументыОбОтгрузкеДляНесколькихОснований(ТаблицаСоставНФА);
	
КонецФункции

#КонецОбласти

#Область ПозицииИзСчетаНаОплату

Функция ПолучитьКоличествоОблагаемыхПозицийСчетовНаОплату(МассивСсылок) Экспорт
	
	ИсключаемыеСтавки = Новый Массив();
	ИсключаемыеСтавки.Добавить(Перечисления.СтавкиНДС.ПустаяСсылка());
	ИсключаемыеСтавки.Добавить(Перечисления.СтавкиНДС.БезНДС);
	ИсключаемыеСтавки.Добавить(Перечисления.СтавкиНДС.НДС0);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок",		МассивСсылок);
	ЗапросПоиск.УстановитьПараметр("ИсключаемыеСтавки",	ИсключаемыеСтавки);
	ЗапросПоиск.Текст = 
	"////////////////////////////////////////////////////////////////////////////////
	|// [0]. Количество облагаемых позиций для списка документов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка			КАК Ссылка,
	|	КОЛИЧЕСТВО(*)	КАК КоличествоПозиций
	|ИЗ
	|	(ВЫБРАТЬ
	|		Ссылка	КАК Ссылка
	|	ИЗ
	|		Документ.СчетНаОплату.Материалы
	|	ГДЕ
	|		Ссылка В(&МассивСсылок)
	|		И НЕ СтавкаНДС В(&ИсключаемыеСтавки)
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Ссылка	КАК Ссылка
	|	ИЗ
	|		Документ.СчетНаОплату.Услуги
	|	ГДЕ
	|		Ссылка В(&МассивСсылок)
	|		И НЕ СтавкаНДС В(&ИсключаемыеСтавки)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Ссылка	КАК Ссылка
	|	ИЗ
	|		Документ.СчетНаОплату.ОсновныеСредства
	|	ГДЕ
	|		Ссылка В(&МассивСсылок)
	|		И НЕ СтавкаНДС В(&ИсключаемыеСтавки)
	|	)	КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	Ссылка";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаполнитьПозицииИзСчетаНаОплату(ТаблицаСоставНФА, СчетНаОплатуСсылка) Экспорт
	
	Если ТаблицаСоставНФА.Количество() = 0 ИЛИ НЕ ЗначениеЗаполнено(СчетНаОплатуСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	СуммаАвансаПоПозициям = РаспределитьСуммуАвансаПоПозициямСчетаНаОплату(ТаблицаСоставНФА, СчетНаОплатуСсылка);
	
	Если СуммаАвансаПоПозициям = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоАналитикПлатежа = ТаблицаСоставНФА.Количество();
	
	КоличествоПозицийСчетаНаОплату = СуммаАвансаПоПозициям.Количество();
	
	Если КоличествоПозицийСчетаНаОплату = 1 Тогда
		Если КоличествоАналитикПлатежа = 1 Тогда
			// Для ускорения работы задаем здесь вручную
			ЗаполнитьЗначенияСвойств(ТаблицаСоставНФА[0], СуммаАвансаПоПозициям[0], "СтавкаНДС,СуммаНДС,Сумма");
		Иначе
			РаспределитьСуммуНалогаПоПлатежам(ТаблицаСоставНФА, СуммаАвансаПоПозициям);
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьАналитикуПозиций(ТаблицаСоставНФА, СуммаАвансаПоПозициям);
	
КонецПроцедуры

#КонецОбласти

#Область Прослеживаемость

Процедура ДобавитьПоказателиПрослеживаемости(ДокументСсылка, ТаблицаНФА) Экспорт
	
	ПоказателиПрослеживаемости = ПолучитьПоказателиПрослеживаемости(ДокументСсылка);
	
	ТаблицаНФА.Колонки.Добавить("СведенияОПрослеживаемости", Новый ОписаниеТипов("ТаблицаЗначений"));
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаТаблицыНФА Из ТаблицаНФА Цикл
		СтрокаТаблицыНФА.СведенияОПрослеживаемости = УчетНДС.ПолучитьПустуюТаблицуСведенияОПрослеживаемостиУПД();
		
		Поиск.Вставить("Ссылка", ДокументСсылка);
		Поиск.Вставить("НомерСтроки", СтрокаТаблицыНФА.НомерСтроки);
		
		МассивСтрок = ПоказателиПрослеживаемости.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаТаблицыПрослеживаемости Из МассивСтрок Цикл
			НоваяСтрока = СтрокаТаблицыНФА.СведенияОПрослеживаемости.Добавить();
			
			НоваяСтрока["НомерСтроки"]					= СтрокаТаблицыНФА.СведенияОПрослеживаемости.Количество();
			НоваяСтрока["НомерТовара"]					= СокрЛП(СтрокаТаблицыПрослеживаемости.ПредставлениеГТД);
			НоваяСтрока["ЕдиницаИзмеренияКод"]			= СтрокаТаблицыПрослеживаемости.ЕдиницаИзмеренияПрослежКод;
			НоваяСтрока["ЕдиницаИзмеренияНаименование"]	= СтрокаТаблицыПрослеживаемости.ЕдиницаИзмеренияПрослеж;
			НоваяСтрока["КоличествоУчетное"]			= СтрокаТаблицыПрослеживаемости.КоличествоУчетное;
			НоваяСтрока["Количество"]					= СтрокаТаблицыПрослеживаемости.КоличествоПрослеж;
			НоваяСтрока["СтоимостьБезНДС"]				= СтрокаТаблицыПрослеживаемости.СтоимПрослеж;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПоказателиПрослеживаемости(Знач МассивСсылок) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивСсылок);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Документы реализации
	|//
	|ВЫБРАТЬ
	|	Ссылка				КАК Ссылка,
	|	ДокументОснование	КАК ДокументРеализации
	|ПОМЕСТИТЬ
	|	ДокументыРеализации
	|ИЗ
	|	Документ.СчетФактураВыданный
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Ссылка					КАК Ссылка,
	|	ДокументКорректировки	КАК ДокументРеализации
	|ИЗ
	|	Документ.ИсправительныйСчетФактураВыданный
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|	И ТИПЗНАЧЕНИЯ(Ссылка.ИсправляемыйДокумент) = ТИП(Документ.СчетФактураВыданный)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Показатели прослеживаемости
	|//
	|ВЫБРАТЬ
	|	Ссылка								КАК Ссылка,
	|	Номенклатура						КАК Номенклатура,
	|	РНПТ								КАК РНПТ,
	|	ЕдиницаИзмерения					КАК ЕдиницаИзмерения,
	|	СУММА(КоличествоУчетное)			КАК КоличествоУчетное,
	|	СУММА(КоличествоПрослеживаемости)	КАК КоличествоПрослеживаемости,
	|	СУММА(СуммаБезНДС)					КАК СуммаБезНДС
	|ПОМЕСТИТЬ
	|	Показатели
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДокументыРеализации.Ссылка						КАК Ссылка,
	|		ПрослеживаемыеТовары.Номенклатура				КАК Номенклатура,
	|		ПрослеживаемыеТовары.РНПТ						КАК РНПТ,
	|		ПрослеживаемыеТовары.Количество					КАК КоличествоУчетное,
	|		ПрослеживаемыеТовары.КоличествоПрослеживаемости	КАК КоличествоПрослеживаемости,
	|		ПрослеживаемыеТовары.СуммаБезНДС				КАК СуммаБезНДС,
	|		ВЫБОР
	|			КОГДА ПрослеживаемыеТовары.Комплектующее <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) ТОГДА
	|				ЕСТЬNULL(ПрослеживаемыеТовары.Комплектующее.КодТНВЭД.ЕдиницаИзмерения,
	|					ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка))
	|			ИНАЧЕ
	|				ЕСТЬNULL(ПрослеживаемыеТовары.Номенклатура.КодТНВЭД.ЕдиницаИзмерения,
	|					ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка))
	|		КОНЕЦ											КАК ЕдиницаИзмерения
	|	ИЗ
	|		РегистрНакопления.ПрослеживаемыеТовары КАК ПрослеживаемыеТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументыРеализации
	|			ПО	ПрослеживаемыеТовары.Регистратор = ДокументыРеализации.ДокументРеализации
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ДокументыРеализации.Ссылка					КАК Ссылка,
	|		ПрослеживаемыеОС.ОсновноеСредство			КАК Номенклатура,
	|		ПрослеживаемыеОС.РНПТ						КАК РНПТ,
	|		ПрослеживаемыеОС.Количество					КАК КоличествоУчетное,
	|		ПрослеживаемыеОС.КоличествоПрослеживаемости	КАК КоличествоПрослеживаемости,
	|		ПрослеживаемыеОС.СуммаБезНДС				КАК СуммаБезНДС,
	|		ВЫБОР
	|			КОГДА ПрослеживаемыеОС.Комплектующее ССЫЛКА Справочник.ОсновныеСредства
	|				И ПрослеживаемыеОС.Комплектующее <> ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка) ТОГДА
	|				ЕСТЬNULL(ВЫРАЗИТЬ(ПрослеживаемыеОС.Комплектующее КАК Справочник.ОсновныеСредства).КодТНВЭД.ЕдиницаИзмерения,
	|					ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка))
	|			КОГДА ПрослеживаемыеОС.Комплектующее ССЫЛКА Справочник.Номенклатура
	|				И ПрослеживаемыеОС.Комплектующее <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) ТОГДА
	|				ЕСТЬNULL(ВЫРАЗИТЬ(ПрослеживаемыеОС.Комплектующее КАК Справочник.Номенклатура).КодТНВЭД.ЕдиницаИзмерения,
	|					ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка))
	|			ИНАЧЕ
	|				ЕСТЬNULL(ПрослеживаемыеОС.ОсновноеСредство.КодТНВЭД.ЕдиницаИзмерения,
	|					ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка))
	|		КОНЕЦ										КАК ЕдиницаИзмерения
	|	ИЗ
	|		РегистрНакопления.ПрослеживаемыеОС КАК ПрослеживаемыеОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументыРеализации
	|			ПО	ПрослеживаемыеОС.Регистратор = ДокументыРеализации.ДокументРеализации) КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	Ссылка,
	|	Номенклатура,
	|	РНПТ,
	|	ЕдиницаИзмерения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Искомые показатели прослеживаемости
	|//
	|ВЫБРАТЬ
	|	СоставНФА.Ссылка												КАК Ссылка,
	|	СоставНФА.НомерСтроки											КАК НомерСтроки,
	|	
	|	// Ссылки
	|	Показатели.РНПТ													КАК РНПТ,
	|	Показатели.ЕдиницаИзмерения										КАК ЕдиницаПрослеживаемости,
	|	
	|	// Представления для печати
	|	Показатели.РНПТ.Код												КАК ПредставлениеГТД,
	|	Показатели.ЕдиницаИзмерения.Код									КАК ЕдиницаИзмеренияПрослежКод,
	|	Показатели.ЕдиницаИзмерения.Наименование						КАК ЕдиницаИзмеренияПрослеж,
	|	Показатели.КоличествоУчетное									КАК КоличествоУчетное,
	|	Показатели.КоличествоПрослеживаемости							КАК КоличествоПрослеж,
	|	ВЫБОР
	|		КОГДА Показатели.СуммаБезНДС <> 0 ТОГДА
	|			Показатели.СуммаБезНДС
	|		КОГДА СоставНФА.Количество <> 0 ТОГДА
	|			ВЫРАЗИТЬ((СоставНФА.Сумма / СоставНФА.Количество) * Показатели.КоличествоПрослеживаемости КАК ЧИСЛО(18,2))
	|		ИНАЧЕ
	|			ВЫРАЗИТЬ(СоставНФА.Цена * Показатели.КоличествоПрослеживаемости КАК ЧИСЛО(18,2))
	|	КОНЕЦ															КАК СтоимПрослеж
	|ИЗ
	|	Документ.СчетФактураВыданный.СоставНФА КАК СоставНФА
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Показатели
	|		ПО	СоставНФА.Ссылка	= Показатели.Ссылка
	|		И	СоставНФА.НФА		= Показатели.Номенклатура
	|ГДЕ
	|	СоставНФА.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СоставНФА.Ссылка												КАК Ссылка,
	|	СоставНФА.НомерСтроки											КАК НомерСтроки,
	|	
	|	// Ссылки
	|	Показатели.РНПТ													КАК РНПТ,
	|	Показатели.ЕдиницаИзмерения										КАК ЕдиницаПрослеживаемости,
	|	
	|	// Представления для печати
	|	Показатели.РНПТ.Код												КАК ПредставлениеГТД,
	|	Показатели.ЕдиницаИзмерения.Код									КАК ЕдиницаИзмеренияПрослежКод,
	|	Показатели.ЕдиницаИзмерения.Наименование						КАК ЕдиницаИзмеренияПрослеж,
	|	Показатели.КоличествоУчетное									КАК КоличествоУчетное,
	|	Показатели.КоличествоПрослеживаемости							КАК КоличествоПрослеж,
	|	ВЫБОР
	|		КОГДА Показатели.СуммаБезНДС <> 0 ТОГДА
	|			Показатели.СуммаБезНДС
	|		КОГДА СоставНФА.Количество <> 0 ТОГДА
	|			ВЫРАЗИТЬ((СоставНФА.Сумма / СоставНФА.Количество) * Показатели.КоличествоПрослеживаемости КАК ЧИСЛО(18,2))
	|		ИНАЧЕ
	|			ВЫРАЗИТЬ(СоставНФА.Цена * Показатели.КоличествоПрослеживаемости КАК ЧИСЛО(18,2))
	|	КОНЕЦ															КАК СтоимПрослеж
	|ИЗ
	|	Документ.ИсправительныйСчетФактураВыданный.СоставНФА КАК СоставНФА
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Показатели
	|		ПО	СоставНФА.Ссылка	= Показатели.Ссылка
	|		И	СоставНФА.НФА		= Показатели.Номенклатура
	|ГДЕ
	|	СоставНФА.Ссылка В(&МассивСсылок)
	|	И ТИПЗНАЧЕНИЯ(Ссылка.ИсправляемыйДокумент) = ТИП(Документ.СчетФактураВыданный)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СоставНФА.Ссылка,
	|	СоставНФА.НомерСтроки";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

