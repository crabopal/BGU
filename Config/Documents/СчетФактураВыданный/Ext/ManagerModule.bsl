Функция ПолучитьДанныеДляЗаполненияНаОсновании_СчетФактураПолученный(ОснованиеСсылка, СчетФактураСсылка, ВозвратДанные)
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	ПричинаНалогообложенияОснования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОснованиеСсылка, "ПричинаНалогообложения");
	
	Если НЕ ПричинаНалогообложенияОснования = Перечисления.ПричиныНалогообложенияНДС.АвансВыданныйКомиссионером Тогда
		// Искомые данные:
		ОписаниеОшибки = НСтр("ru='Документ создается только для счет-фактуры на аванс комиссионера'");
		ВозвратДанные.Вставить("ОписаниеОшибки", ОписаниеОшибки);
		// Выходим:
		Возврат Ложь;
	КонецЕсли;
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка", ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("КФО", Перечисления.КВД.Внебюджет);
