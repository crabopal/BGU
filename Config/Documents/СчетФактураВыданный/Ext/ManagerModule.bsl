#Область ОбработчикиСобытий

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Перем Основание;
	
	ЭтоВводНаОсновании = (ВидФормы = "ФормаОбъекта" И Параметры.Свойство("Основание", Основание));
	
	Если Не ЭтоВводНаОсновании Тогда
		Возврат;
	КонецЕсли;
	
	Если ВозможенВводНесколькихДокументовНаОснованииОдного(Основание) Тогда
		ТаблицаАвансов = СписокАвансовПоДокументу(Основание);
			
		Если ТаблицаАвансов.Количество() > 1 Тогда
			// Переопределяем стандартное поведение
			// для отметки нескольких документов, вводимых на основании:
			СтандартнаяОбработка = Ложь;
			ВыбраннаяФорма = "ФормаВводаНаОсновании";
			
			Параметры.Вставить("ОснованиеСсылка",	Основание);
			Параметры.Вставить("ТаблицаАвансов",	ТаблицаАвансов);
			Параметры.Вставить("ИзФормыОбъекта",	Ложь);
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Основание) <> Тип("Структура") Тогда
		// Переопределяем стандартное поведение только ради
		// превращения стандартного параметра Основание
		// из ссылки в структуру (с возможностью дальнейшего дозаполнения):
		СтандартнаяОбработка = Ложь;
		ВыбраннаяФорма = "ФормаДокумента";
		
		Параметры.Вставить("Основание", НовыйОснованиеСтруктура(Основание));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПустуюТаблицуРегистра(ДвиженияРегистра)
	
	ПустаяТаблица = ДвиженияРегистра.Выгрузить();
	ПустаяТаблица.Очистить();
	ПустаяТаблица.Колонки.Удалить(ПустаяТаблица.Колонки.Найти("Активность"));
	
	Возврат ПустаяТаблица;
	
КонецФункции

Функция ОбнаруживатьПомеченныеНаУдалениеСчетаФактурыПриВводеНаОсновании()
	
	Возврат Ложь;
	
КонецФункции

Функция ОбнаруженСчетФактура(Знач ДанныеЗаполнения, Знач ОснованиеСсылка, Знач ОбъектСсылка, НайденыйДокумент)
	
	ПоляПоискаСФ = Новый Соответствие();
	
	Если Не ОбнаруживатьПомеченныеНаУдалениеСчетаФактурыПриВводеНаОсновании() Тогда
		ПоляПоискаСФ.Вставить("ПометкаУдаления", Ложь);
	КонецЕсли;
	
	Если ТипЗнч(ОснованиеСсылка) = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
		ВидОперацииДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОснованиеСсылка, "ВидОперации");
		Если ВидОперацииДокумента = Перечисления.ВидыОперацийОтчетКомитенту.ОтчетОЗакупках Тогда
			ПоляПоискаСФ.Вставить("ПричинаНалогообложения", Перечисления.ПричиныНалогообложенияНДС.Реализация);
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("ДополнительныйОтбор") Тогда
		ДополнительныйОтбор = ДанныеЗаполнения.ДополнительныйОтбор;
		
		Если ТипЗнч(ДополнительныйОтбор) = Тип("Структура") Тогда
			ПоляПоискаСФ.Вставить("Контрагент");
			ПоляПоискаСФ.Вставить("Договор");
			ПоляПоискаСФ.Вставить("СуммаДокумента");
			
			ЗаполнитьЗначенияСвойств(ПоляПоискаСФ, ДополнительныйОтбор);
		КонецЕсли;
	КонецЕсли;	
	
	Если ПоляПоискаСФ.Количество() > 0 Тогда
		ОтборДляПоискаСФ = Новый Структура();
		ОтборДляПоискаСФ.Вставить("СчетФактураВыданный", ПоляПоискаСФ);
	Иначе
		ОтборДляПоискаСФ = Неопределено;
	КонецЕсли;
	
	НайденыйДокумент = УчетНДС.НайтиПодчиненныйСчетФактуру(ОснованиеСсылка, "СчетФактураВыданный", ОтборДляПоискаСФ);
	
	Возврат (НайденыйДокумент <> Неопределено И НайденыйДокумент <> ОбъектСсылка);
	
КонецФункции

Процедура ПроверитьЗаполнениеТабличнойЧастиСчетаФактурыОтКомиссионера(ДокументОбъект, ЕстьОшибкиЗаполнения)
	
	Если НЕ ДокументОбъект.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомитентаНаРеализацию Тогда
		Возврат;
	КонецЕсли;
		
	Если ДокументОбъект.СчетаФактурыОтКомиссионера.Количество() = 0 Тогда
		
		ЕстьОшибкиЗаполнения = Истина;
		
		ТекстСообщения = НСтр("ru='Не заполнена табличная часть ""Счета фактуры от комиссионера (агента)""'");
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, "Объект.СчетаФактурыОтКомиссионера");
		
	КонецЕсли;
	
КонецПроцедуры

