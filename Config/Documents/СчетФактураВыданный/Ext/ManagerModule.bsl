	|ИЗ
	|	ОбщаяТаблицаДанных КАК ОбщаяТаблицаДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Данные для табличной части СоставНФА
	|//
	|ВЫБРАТЬ
	|	ОбщаяТаблицаДанных.НФА КАК НФА,
	|	ОбщаяТаблицаДанных.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ОбщаяТаблицаДанных.СодержаниеУслуги КАК СодержаниеУслуги,
	|	ОбщаяТаблицаДанных.Количество КАК Количество,
	|	ОбщаяТаблицаДанных.СуммаНДС КАК СуммаНДС,
	|	ОбщаяТаблицаДанных.Всего КАК Всего,
	|	ОбщаяТаблицаДанных.СтавкаНДС КАК СтавкаНДС,
	|	ОбщаяТаблицаДанных.Сумма КАК Сумма,
	|	ОбщаяТаблицаДанных.Цена КАК Цена
	|ИЗ
	|	ОбщаяТаблицаДанных КАК ОбщаяТаблицаДанных";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка	= РезультатыЗаполнения[1].Выгрузить();
	ТаблицаСоставНФА	= РезультатыЗаполнения[2].Выгрузить();
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	// Код вида операции
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	// Ответственные лица
	ОтветственныеЛица = ПолучитьОтветственныхЛиц(Шапка);
	Шапка.Вставить("Руководитель", ОтветственныеЛица.Руководитель);
	Шапка.Вставить("ГлавныйБухгалтер", ОтветственныеЛица.ГлавныйБухгалтер);
	
