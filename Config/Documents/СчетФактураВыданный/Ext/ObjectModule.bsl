#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения) И ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") Тогда
		// Переопределяем стандартное поведение только ради
		// превращения стандартного параметра Основание
		// из ссылки в структуру (с возможностью дальнейшего дозаполнения):
		ДанныеЗаполнения = Документы.СчетФактураВыданный.НовыйОснованиеСтруктура(ДанныеЗаполнения);
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьНаОсновании = ДанныеЗаполнения.Свойство("ОснованиеСсылка");
	Иначе
		ЗаполнитьНаОсновании = ЗначениеЗаполнено(ДанныеЗаполнения);
	КонецЕсли;
	
	Если ЗаполнитьНаОсновании Тогда
		
		ОписаниеОшибки = Неопределено;
		ЗаполненнаяТиповаяОперация = Неопределено;
		
		Если НЕ Документы.СчетФактураВыданный.ЗаполнитьНаОсновании(ДанныеЗаполнения, ЭтотОбъект, ОписаниеОшибки, ЗаполненнаяТиповаяОперация) Тогда
			ВызватьИсключение ОписаниеОшибки;
		КонецЕсли;
		
		// Добавляем заполненную типовую операция в параметры формы
		Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
			ДанныеЗаполнения.Вставить("ЗаполненнаяТиповаяОперация", ЗаполненнаяТиповаяОперация);
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект["ВалютаДокумента"]) Тогда
		ЭтотОбъект["ВалютаДокумента"] = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.СчетФактураВыданный.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

	// Запись движений
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ВходящийНДС");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ВходящийНДСКРаспределению");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ИсходящийНДС");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "КнигаПокупок");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ДополнительныеЛистыКнигиПокупок");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "КнигаПродаж");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ДополнительныеЛистыКнигиПродаж");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ЖурналУчетаСчетовФактур");
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Перем ПрименяемаяИнструкцияСтруктура;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СчетФактураКомиссионераНаАванс = ПричинаНалогообложения 
		= Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаАванс;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("ПрименяемаяИнструкцияСтруктура", ПрименяемаяИнструкцияСтруктура) Тогда
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ЭтотОбъект);
	КонецЕсли;
	
	ОчиститьНеиспользуемыеРеквизиты(ПрименяемаяИнструкцияСтруктура);
	
	СуммаДокумента	= СоставНФА.Итог("Всего");
	СуммаНДС 		= СоставНФА.Итог("СуммаНДС");
	
	Если СчетФактураКомиссионераНаАванс Тогда
		СуммаДокументаКомиссия = СоставНФА.Итог("Всего");
		СуммаНДСДокументаКомиссия = СоставНФА.Итог("СуммаНДС");
	КонецЕсли;
	
	УчетНДС.ЗаполнитьРеквизитКодыВидовТоваров(ЭтотОбъект);
	
	КопияСоставНФА = СоставНФА.Выгрузить(, "НФА");
	УчетНДС.ЗаполнитьВидЦенности(КопияСоставНФА, ПричинаНалогообложения);
	ВидЦенности = УчетНДС.ПолучитьОбщийВидЦенности(КопияСоставНФА);
	
	//---
	// СубконтоСФПолученные
	//---
	// Заполняем в таблице "СоставНФА" пустые субконто вида "СФПолученные"
	// (аналогично условному оформлению таких полей на форме документа)
	Если Ссылка.Пустая() Тогда
		СчетФактураСсылка = Документы.СчетФактураВыданный.ПолучитьСсылку();
		ЭтотОбъект.УстановитьСсылкуНового(СчетФактураСсылка);
	Иначе
		СчетФактураСсылка = Ссылка;
	КонецЕсли;
	МассивОбслуживаемыхИдентификаторов = Новый Массив();
	Если ПрименяемаяИнструкцияСтруктура["Начисление"] Тогда
		МассивОбслуживаемыхИдентификаторов.Добавить(1);
	КонецЕсли;
	ТаблицаПараметрыАвтоустановки = УчетНДС.АвтоустановкаСубконто_ПолучитьТаблицуПараметрыАвтоустановки_СчетФактураВыданный_ВызовНеИзФормы(
		ЭтотОбъект,
		МассивОбслуживаемыхИдентификаторов,
		Ложь,
		СчетФактураСсылка);
	УчетНДС.АвтоустановкаСубконто_ВыполнитьАвтоустановкуЗначений_ВызовНеИзФормы(
		ЭтотОбъект,
		ТаблицаПараметрыАвтоустановки,
		Истина);	// ВыполнитьАвтоустановкуТолькоПустыхЗначений
	
	УчетНДСВызовСервера.УстановитьДатуДвиженийВРегистреНДС(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Очистить();
	
	ЕстьОшибкиЗаполнения = Документы.СчетФактураВыданный.ЕстьОшибкиЗаполнения(ЭтотОбъект);
		
	Если ЕстьОшибкиЗаполнения Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОчиститьНеиспользуемыеРеквизиты(ПрименяемаяИнструкцияСтруктура)
	
	ОчищающаяСтруктура = Новый Структура();
	
	Если Не ПрименяемаяИнструкцияСтруктура["Начисление"] Тогда
		ОчищающаяСтруктура.Вставить("СчетНачислениеДт");
		ОчищающаяСтруктура.Вставить("КПСНачислениеДт");
		ОчищающаяСтруктура.Вставить("КЭКНачислениеДт");
		ОчищающаяСтруктура.Вставить("Субконто1НачислениеДт");
		ОчищающаяСтруктура.Вставить("Субконто2НачислениеДт");
		ОчищающаяСтруктура.Вставить("Субконто3НачислениеДт");
	КонецЕсли;
	
	Если Не ПрименяемаяИнструкцияСтруктура["Вычет"] Тогда
		ОчищающаяСтруктура.Вставить("СчетВычетКт");
		ОчищающаяСтруктура.Вставить("КПСВычетКт");
		ОчищающаяСтруктура.Вставить("НДСКВычету", Ложь);
	КонецЕсли;
	
	Если Не ПрименяемаяИнструкцияСтруктура["РаспределениеВозможно"] Тогда
		ОчищающаяСтруктура.Вставить("НДСКРаспределению", Ложь);
	КонецЕсли;
	
	Если Не ПрименяемаяИнструкцияСтруктура["КодВидаТовараИспользуется"] Тогда
		ОчищающаяСтруктура.Вставить("КодВидаТовара", "");
	КонецЕсли;
	
	Если Не ПрименяемаяИнструкцияСтруктура["СчетРасчетовИспользуется"] Тогда
		ОчищающаяСтруктура.Вставить("СчетРасчетов");
		ОчищающаяСтруктура.Вставить("КПССчетРасчетов");
	КонецЕсли;
	
	Если ОчищающаяСтруктура.Количество() > 0 Тогда
		Для Каждого СтрокаТЧ Из СоставНФА Цикл
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, ОчищающаяСтруктура);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
