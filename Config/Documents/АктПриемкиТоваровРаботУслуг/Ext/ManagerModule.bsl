// Возвращает контактную информацию из соответствия, ранее полученного процедурой ЗаполнитьКИКонтрагентовВСоответствие.
// 
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты
//  ПрочитанныеКИ - Соответствие из КлючИЗначение:
//   * Ключ - СправочникСсылка.Контрагенты
//   * Значение - Соответствие Из КлючИЗначение:
//   	** Ключ - СправочникСсылка.ВидыКонтактнойИнформации
//   	** Значение - СтрокаТаблицыЗначений:
//   		*** Представление - Строка
//  ВидыКИ - Массив из СправочникСсылка.ВидыКонтактнойИнформации
// 
// Возвращаемое значение:
//  Строка, Неопределено -
Функция ПолучитьПредставлениеКИИзСоответствия(Контрагент, ПрочитанныеКИ, ВидыКИ)
	КИКонтрагента = ПрочитанныеКИ.Получить(Контрагент);
	Если КИКонтрагента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого ВидКИ Из ВидыКИ Цикл
		ЗначениеКИ = КИКонтрагента.Получить(ВидКИ);
		Если ЗначениеКИ <> Неопределено Тогда
			Возврат ЗначениеКИ.Представление;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

// Добавляет заданные виды контактной информации контрагентов в соответствие для последующего использования 
// при печати Акта приемки ТРУ 0510452..
// 
// Параметры:
//  Контрагенты - Массив из СправочникСсылка.Контрагенты
//  ВидыКИКонтрагентов - Массив из СправочникСсылка.ВидыКонтактнойИнформации
//  ПрочитанныеКИ - Соответствие из КлючИЗначение:
//   * Ключ - СправочникСсылка.Контрагенты
//   * Значение - Соответствие Из КлючИЗначение:
//   	** Ключ - СправочникСсылка.ВидыКонтактнойИнформации
//   	** Значение - СтрокаТаблицыЗначений
Процедура ДобавитьКИВСоответствие(Контрагенты, ВидыКИКонтрагентов, ПрочитанныеКИ)
	КонтактнаяИнформацияЮридическихЛиц = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(
		Контрагенты,
		,
		ВидыКИКонтрагентов);
	Для Каждого СтрокаКИ Из КонтактнаяИнформацияЮридическихЛиц Цикл
		КИКонтрагента = ПрочитанныеКИ.Получить(СтрокаКИ.Объект);
		Если КИКонтрагента = Неопределено Тогда
			КИКонтрагента = Новый Соответствие;
			ПрочитанныеКИ.Вставить(СтрокаКИ.Объект, КИКонтрагента);
		КонецЕсли;
		КИКонтрагента.Вставить(СтрокаКИ.Вид, СтрокаКИ);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет контактную информацию контрагентов в соответствие для последующего использования 
// при печати Акта приемки ТРУ 0510452.
// 
// Параметры:
//  КИКонтрагентов - Соответствие из КлючИЗначение:
//   * Ключ - СправочникСсылка.Контрагенты
//   * Значение - Соответствие Из КлючИЗначение:
//   	** Ключ - СправочникСсылка.ВидыКонтактнойИнформации
//   	** Значение - СтрокаТаблицыЗначений
//  КонтрагентыДокументов - ТаблицаЗначений:
//   * ЮридическоеЛицо - Булево
//   * Контрагент - СправочникСсылка.Контрагенты
//  ВидыКИКонтрагентов - Массив из СправочникСсылка.ВидыКонтактнойИнформации
Процедура ЗаполнитьКИКонтрагентовВСоответствие(КИКонтрагентов, КонтрагентыДокументов, ВидыКИКонтрагентов)
	// Контактная информация контрагентов
	ЮридическиеЛицаДокументов = КонтрагентыДокументов
		.Скопировать(Новый Структура("ЮридическоеЛицо", Истина), "Контрагент")
		.ВыгрузитьКолонку("Контрагент");
	ВидыКИКонтрагентов = Новый Массив;
	ВидыКИКонтрагентов.Добавить(Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты); 
	ВидыКИКонтрагентов.Добавить(Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты); 
	ДобавитьКИВСоответствие(ЮридическиеЛицаДокументов, ВидыКИКонтрагентов, КИКонтрагентов);

	// Контактная информация физических лиц
	ФизическиеЛицаКонтрагентов = КонтрагентыДокументов
		.Скопировать(Новый Структура("ЮридическоеЛицо", Ложь), "Контрагент")
		.ВыгрузитьКолонку("Контрагент");
	ВидыКИФизическихЛиц = Новый Массив;
	ВидыКИФизическихЛиц.Добавить(Справочники.ВидыКонтактнойИнформации.АдресМестаПроживанияФизическиеЛица);
	ВидыКИФизическихЛиц.Добавить(Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица);
	ДобавитьКИВСоответствие(ФизическиеЛицаКонтрагентов, ВидыКИФизическихЛиц, КИКонтрагентов);
	
	// Объединить виды КИ юр. лиц и физ. лиц для упрощения дальнейшего получения в коде
	Для Каждого ВидКИФизЛиц Из ВидыКИФизическихЛиц Цикл
		ВидыКИКонтрагентов.Добавить(ВидКИФизЛиц);
	КонецЦикла;
	
КонецПроцедуры

// Массив редакций приказа 61н влияющие на печатную форму Акта приемки ТРУ в порядке выхода.
// Более старшие редакции имеют больший индекс.
// 
// Возвращаемое значение:
//  Массив из Строка - 
//
Функция РедакцииПечатнойФормы()
	Редакции = Новый Массив;
	Редакции.Добавить("100н");
	Редакции.Добавить("174н");
	Возврат Редакции;
КонецФункции

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АктПриемкиТоваровРаботУслуг.Ссылка
	|ИЗ
	|	Документ.АктПриемкиТоваровРаботУслуг КАК АктПриемкиТоваровРаботУслуг
	|ГДЕ
	|	АктПриемкиТоваровРаботУслуг.ВидПоставки = ЗНАЧЕНИЕ(Перечисление.ВидыПоставкиТоваровРаботУслуг.ПустаяСсылка)";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.АктПриемкиТоваровРаботУслуг";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			ПредставлениеОбъекта = Строка(Выборка.Ссылка);
			
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект(); // ДокументОбъект.АктПриемкиТоваровРаботУслуг
			ОбъектИзменен = Ложь;
			Если Объект <> Неопределено Тогда 
				Объект.Заблокировать();
				
				Объект.СуммаДокумента = 0;
				Для Каждого Строка ИЗ Объект.ТоварыРаботыУслуги Цикл
					Если Строка.Количество = Строка.КоличествоПринято Или Строка.Количество = 0 Тогда
						Строка.СуммаПринято = Строка.Всего;
					Иначе
						Строка.СуммаПринято = Строка.КоличествоПринято * Строка.Всего / Строка.Количество;
					КонецЕсли;
					Объект.СуммаДокумента = Объект.СуммаДокумента + Строка.СуммаПринято;
				КонецЦикла;
				
				Объект.ВидПоставки = Перечисления.ВидыПоставкиТоваровРаботУслуг.ПрочаяПоставка;
				Объект.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
				ОбъектИзменен = Истина;
			КонецЕсли;
				
			Если ОбъектИзменен Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.АктПриемкиТоваровРаботУслуг,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
