#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииОграниченияДоступа
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - см. УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктПриемкиТоваровРаботУслуг";
	КомандаПечати.Идентификатор		= "АктПриемкиТоваровРаботУслуг0510452_174н";
	КомандаПечати.Представление		= ПредставлениеКомандыПечати("174н");
	КомандаПечати.Порядок			= 1;

	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктПриемкиТоваровРаботУслуг";
	КомандаПечати.Идентификатор		= "АктПриемкиТоваровРаботУслуг0510452_100н";
	КомандаПечати.Представление		= ПредставлениеКомандыПечати("100н");
	КомандаПечати.Порядок			= 100;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры:
//   МассивОбъектов  - Массив из ДокументСсылка    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - ТаблицаЗначений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений из ДокументСсылка   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктПриемкиТоваровРаботУслуг0510452_100н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"АктПриемкиТоваровРаботУслуг0510452_100н",
			ПредставлениеКомандыПечати("100н"),
			УправлениеПечатьюБГУ.НапечататьАктПриемкиТоваровРаботУслуг0510452(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктПриемкиТоваровРаботУслуг0510452_174н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"АктПриемкиТоваровРаботУслуг0510452_174н",
			ПредставлениеКомандыПечати("174н"),
			УправлениеПечатьюБГУ.НапечататьАктПриемкиТоваровРаботУслуг0510452(МассивОбъектов, ОбъектыПечати, "174н"));
		
	КонецЕсли;
	
КонецПроцедуры

// Данные для печати акта приемки товаров работ услуг 0510452.
// 
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.АктПриемкиТоваровРаботУслуг
// 
// Возвращаемое значение:
//  см. ТаблицаШапкиДляПечати
Функция ДанныеДляПечатиАктаПриемкиТоваровРаботУслуг0510452(МассивОбъектов, РедакцияФормы) Экспорт
	ДанныеОрганизацийПечати = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	
	ЗапросыПакета = Новый Структура;
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ТекстЗапросаШапкиДляПечати(ЗапросыПакета, "Запрос1"));
	ЧастиЗапроса.Добавить(ТекстЗапросаДокументыПоставкиДляПечати(ЗапросыПакета, "Запрос2"));
	ЧастиЗапроса.Добавить(ТекстЗапросаТранспортировкаИПриемкаДляПечати(ЗапросыПакета, "Запрос3"));
	ЧастиЗапроса.Добавить(ТекстЗапросаСведенияОбУпаковкеДляПечати(ЗапросыПакета, "Запрос4"));
	ЧастиЗапроса.Добавить(ТекстЗапросаТоварыРаботыУслугиДляПечати(ЗапросыПакета, "Запрос5"));
	ЧастиЗапроса.Добавить(ТекстЗапросаФайлыДляПечати(ЗапросыПакета, "Запрос6"));
	ЧастиЗапроса.Добавить(ТекстЗапросаСоставКомиссииДляПечати(ЗапросыПакета, "Запрос7"));
	ЧастиЗапроса.Добавить(ТекстЗапросаСоставУпаковокДляПечати(ЗапросыПакета, "Запрос8"));
	ЧастиЗапроса.Добавить(ТекстЗапросаСведенияПрослеживаемостиДляПечати(ЗапросыПакета, "Запрос9"));
	ЧастиЗапроса.Добавить(ТекстЗапросаСведенияПрослеживаемостиФактическиеДляПечати(ЗапросыПакета, "Запрос10"));
	ЧастиЗапроса.Добавить(ТекстЗапросаПлатежныеДокументыДляПечати(ЗапросыПакета, "Запрос11"));
	ЧастиЗапроса.Добавить(ТекстЗапросаСМРДляПечати(ЗапросыПакета, "Запрос12"));
	ЧастиЗапроса.Добавить(ТекстЗапросаСтоимостьСМРДляПечати(ЗапросыПакета, "Запрос13"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	КонтрагентыДокументов = РезультатЗапроса[ЗапросыПакета.Запрос1 - 1].Выгрузить();
	ВыборкаШапка = РезультатЗапроса[ЗапросыПакета.Запрос1].Выбрать();
	ВыборкаДокументыПоставки = РезультатЗапроса[ЗапросыПакета.Запрос2].Выбрать();
	ВыборкаТранспортировкаИПриемка = РезультатЗапроса[ЗапросыПакета.Запрос3].Выбрать();
	ВыборкаСведенияОбУпаковке = РезультатЗапроса[ЗапросыПакета.Запрос4].Выбрать();
	ВсеТоварыРаботыУслуги = РезультатЗапроса[ЗапросыПакета.Запрос5].Выбрать();
	ВыборкаФайлы = РезультатЗапроса[ЗапросыПакета.Запрос6].Выбрать();
	ВыборкаКомиссии = РезультатЗапроса[ЗапросыПакета.Запрос7].Выбрать();
	ТоварыВУпаковках = РезультатЗапроса[ЗапросыПакета.Запрос8].Выгрузить();
	ТоварыВУпаковках.Индексы.Добавить("ИдентификаторСтрокиУпаковки, Ссылка");
	СведенияПрослеживаемости = РезультатЗапроса[ЗапросыПакета.Запрос9].Выгрузить();
	СведенияПрослеживаемости.Индексы.Добавить("ИдентификаторСтроки, Ссылка");
	СведенияПрослеживаемостиФактические = РезультатЗапроса[ЗапросыПакета.Запрос10].Выгрузить();
	СведенияПрослеживаемостиФактические.Индексы.Добавить("ИдентификаторСтроки, Ссылка");
	ВыборкаПлатежныеДокументы = РезультатЗапроса[ЗапросыПакета.Запрос11].Выбрать();
	ВыборкаСМР = РезультатЗапроса[ЗапросыПакета.Запрос12].Выбрать();
	ВыборкаСтоимостьСМР = РезультатЗапроса[ЗапросыПакета.Запрос13].Выбрать();

	// Заполнить контактную информацию
	КИКонтрагентов = Новый Соответствие;
	ВидыКИКонтрагентов = Неопределено; // Массив из СправочникСсылка.ВидыКонтактнойИнформации
	ЗаполнитьКИКонтрагентовВСоответствие(КИКонтрагентов, КонтрагентыДокументов, ВидыКИКонтрагентов);
	
	СтрокиПлатежныхДокументовСИсполнением = Новый Соответствие;
	Отбор = Новый Структура("Ссылка");
	Результат = ТаблицаШапкиДляПечати();
	Пока ВыборкаШапка.Следующий() Цикл
		
		ДанныеОрганизации = ДанныеОрганизацийПечати.Получить(ВыборкаШапка.Ссылка);
		
		СтрокаШапки = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаШапки, ВыборкаШапка);
		
		СтрокаШапки.ДокументыПоставки = ТаблицаДокументыПоставкиДляПечати();
		СтрокаШапки.ПлатежныеДокументы = ТаблицаПлатежныеДокументыДляПечати();
		СтрокаШапки.Расхождения = ТаблицаРасхожденияДляПечати();
		СтрокаШапки.СведенияОбУпаковке = ТаблицаСведенияОбУпаковкеДляПечати();
		СтрокаШапки.СМР = ТаблицаСМРДляПечати();
		СтрокаШапки.СоставКомиссии = ТаблицаСоставКомиссииДляПечати();
		СтрокаШапки.СтоимостьСМР = ТаблицаСтоимостьСМРДляПечати();
		СтрокаШапки.ТоварыРаботыУслуги = ТаблицаТоварыРаботыУслугиДляПечати();
		СтрокаШапки.ТранспортировкаИПриемка = ТаблицаТранспортировкаИПриемкаДляПечати();
		СтрокаШапки.Файлы = ТаблицаФайлыДляПечати();
		
		СтрокаШапки.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка, ВыборкаШапка.Номер);
		СтрокаШапки.ЛицевойСчет = СокрЛП(ВыборкаШапка.ЛицевойСчет);
		СтрокаШапки.РазделЛицевогоСчета = СокрЛП(ВыборкаШапка.РазделЛицевогоСчета);
		Если ЗначениеЗаполнено(ВыборкаШапка.Заказчик) Тогда
			Если ЗначениеЗаполнено(ВыборкаШапка.ЗаказчикНаименованиеПолное) Тогда
				СтрокаШапки.НаименованиеЗаказчика = ВыборкаШапка.ЗаказчикНаименованиеПолное;
			Иначе
				СтрокаШапки.НаименованиеЗаказчика = ВыборкаШапка.ЗаказчикНаименование;
			КонецЕсли;
			СтрокаШапки.ОГРНЗаказчика = ВыборкаШапка.ЗаказчикОГРН;
			СтрокаШапки.ИННЗаказчика = ВыборкаШапка.ЗаказчикИНН;
			СтрокаШапки.КППЗаказчика = ВыборкаШапка.ЗаказчикКПП;
			СтрокаШапки.АдресЗаказчика = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
				ВыборкаШапка.Заказчик,
				Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты);
		Иначе
			СтрокаШапки.НаименованиеЗаказчика = ДанныеОрганизации.НаименованиеОрганизации;
			СтрокаШапки.ОГРНЗаказчика = ВыборкаШапка.ОрганизацияОГРН;
			СтрокаШапки.ИННЗаказчика = ВыборкаШапка.ОрганизацияИНН;
			СтрокаШапки.КППЗаказчика = ВыборкаШапка.ОрганизацияКПП;
			СтрокаШапки.АдресЗаказчика = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
				ВыборкаШапка.Организация,
				Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаШапка.ДоговорВидОбязательства) Тогда
			СтрокаШапки.НаименованиеДоговора = ВыборкаШапка.ДоговорВидОбязательства;
		КонецЕсли;
		
		СтрокаШапки.Поставщик = ВыборкаШапка.Контрагент;
		СтрокаШапки.ПолноеНаименованиеПоставщика = ВыборкаШапка.КонтрагентНаименованиеПолное;
		СтрокаШапки.КраткоеНаименованиеПоставщика = ВыборкаШапка.КонтрагентНаименование;
		СтрокаШапки.ОГРНПоставщика = ВыборкаШапка.КонтрагентОГРН;
		СтрокаШапки.ИННПоставщика = ВыборкаШапка.КонтрагентИНН;
		СтрокаШапки.КПППоставщика = ВыборкаШапка.КонтрагентКПП;
		СтрокаШапки.ЛицевойСчетПоставщика = СокрЛП(ВыборкаШапка.ЛицевойСчетПоставщика);
		СтрокаШапки.РазделЛицевогоСчетаПоставщика = СокрЛП(ВыборкаШапка.РазделЛицевогоСчетаПоставщика);
		АдресПоставщика = ПолучитьПредставлениеКИИзСоответствия(ВыборкаШапка.Контрагент,
			КИКонтрагентов, ВидыКИКонтрагентов);
		Если АдресПоставщика <> Неопределено Тогда
			СтрокаШапки.АдресПоставщика = АдресПоставщика;
		КонецЕсли;
		
		СтрокаШапки.ЛицевойСчетГрузоотправителя = СокрЛП(ВыборкаШапка.ЛицевойСчетГрузоотправителя);
		СтрокаШапки.РазделЛицевогоСчетаГрузоотправителя = СокрЛП(ВыборкаШапка.РазделЛицевогоСчетаГрузоотправителя);
		Если ЗначениеЗаполнено(ВыборкаШапка.Грузоотправитель) Тогда
			СтрокаШапки.Грузоотправитель = ВыборкаШапка.Грузоотправитель;
			СтрокаШапки.ПолноеНаименованиеГрузоотправителя = ВыборкаШапка.ГрузоотправительНаименованиеПолное;
			СтрокаШапки.КраткоеНаименованиеГрузоотправителя = ВыборкаШапка.ГрузоотправительНаименование;
			СтрокаШапки.ОГРНГрузоотправителя = ВыборкаШапка.ГрузоотправительОГРН;
			СтрокаШапки.ИННГрузоотправителя = ВыборкаШапка.ГрузоотправительИНН;
			СтрокаШапки.КППГрузоотправителя = ВыборкаШапка.ГрузоотправительКПП;
			АдресГрузоотправителя = ПолучитьПредставлениеКИИзСоответствия(ВыборкаШапка.Грузоотправитель,
				КИКонтрагентов, ВидыКИКонтрагентов);
			Если АдресГрузоотправителя <> Неопределено Тогда
				СтрокаШапки.АдресГрузоотправителя = АдресГрузоотправителя;
			КонецЕсли;
		КонецЕсли;

		СтрокаШапки.Страхователь = ВыборкаШапка.Страхователь;
		СтрокаШапки.ПолноеНаименованиеСтрахователя = ВыборкаШапка.СтраховательНаименованиеПолное;
		СтрокаШапки.КраткоеНаименованиеСтрахователя = ВыборкаШапка.СтраховательНаименование;
		СтрокаШапки.ОГРНСтрахователя = ВыборкаШапка.СтраховательОГРН;
		СтрокаШапки.ИННСтрахователя = ВыборкаШапка.СтраховательИНН;
		СтрокаШапки.КППСтрахователя = ВыборкаШапка.СтраховательКПП;
		СтрокаШапки.ЛицевойСчетСтрахователя = СокрЛП(ВыборкаШапка.ЛицевойСчетСтрахователя);
		СтрокаШапки.РазделЛицевогоСчетаСтрахователя = СокрЛП(ВыборкаШапка.РазделЛицевогоСчетаСтрахователя);
		АдресСтрахователя = ПолучитьПредставлениеКИИзСоответствия(ВыборкаШапка.Страхователь,
			КИКонтрагентов, ВидыКИКонтрагентов);
		Если АдресСтрахователя <> Неопределено Тогда
			СтрокаШапки.АдресСтрахователя = АдресСтрахователя;
		КонецЕсли;
		
		Если СравнитьРедакцииПоДатеВыхода(РедакцияФормы, "174н") >= 0 Тогда
			// Очистить краткое наименование ИП
			Если ВыборкаШапка.КонтрагентЭтоФизЛицо Тогда
				СтрокаШапки.КраткоеНаименованиеПоставщика = "";
			КонецЕсли;
			Если ВыборкаШапка.ГрузоотправительЭтоФизЛицо Тогда
				СтрокаШапки.КраткоеНаименованиеГрузоотправителя = "";
			КонецЕсли;
			Если ВыборкаШапка.СтраховательЭтоФизЛицо Тогда
				СтрокаШапки.КраткоеНаименованиеСтрахователя = "";
			КонецЕсли;
		КонецЕсли;
		
		СтрокаШапки.ПредставительЗаказчикаФИО = ДанныеПредставителяДляАктаПриемкиТРУ(ВыборкаШапка,
			"ПредставительЗаказчика");
		СтрокаШапки.ПредставительСтроительныйКонтрольФИО = ДанныеПредставителяДляАктаПриемкиТРУ(ВыборкаШапка,
			"ПредставительСтроительныйКонтроль");
		СтрокаШапки.ПредставительПоставщикаФИО = ДанныеПредставителяДляАктаПриемкиТРУ(ВыборкаШапка,
			"ПредставительПоставщика");
		СтрокаШапки.РуководительЗаказчикаФИО = ДанныеПредставителяДляАктаПриемкиТРУ(ВыборкаШапка,
			"РуководительЗаказчика");
		
		ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(ВыборкаШапка.ЦМОСотрудник,
			"Фамилия, Имя, Отчество, Должность", ВыборкаШапка.Дата);
		СтрокаШапки.ТоварыПринятыДолжность = ДанныеСотрудника.Должность;
		СтрокаШапки.ТоварыПринятыФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		
		ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(ВыборкаШапка.Руководитель,
			"Фамилия, Имя, Отчество, Должность", ВыборкаШапка.Дата);
		СтрокаШапки.УполномоченноеЛицоФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		СтрокаШапки.УполномоченноеЛицоДолжность = ДанныеСотрудника.Должность;
		
		СтрокаШапки.ОтветственныйДолжность = ДанныеОрганизации.ОтветственныйДолжность;
		СтрокаШапки.ОтветственныйФИО = КорреспондентыКлиентСервер.ФИО(ДанныеОрганизации.ОтветственныйФИО, Истина);
		СтрокаШапки.ОтветственныйТелефон = ДанныеОрганизации.ОтветственныйТелефон;
		СтрокаШапки.ОтветственныйЭлектроннаяПочта = ДанныеОрганизации.ОтветственныйЭлПочта;
		
		СтрокаШапки.НаименованиеОрганизации = ДанныеОрганизации.НаименованиеОрганизации;
		СтрокаШапки.НаименованиеОбособленногоПодразделения = ДанныеОрганизации.НаименованиеОбособленногоПодразделения;
		СтрокаШапки.Учредитель = ДанныеОрганизации.Учредитель;
		СтрокаШапки.БюджетНаименование = ДанныеОрганизации.БюджетНаименование;
		СтрокаШапки.КодРПБС = ДанныеОрганизации.КодРПБС;
		СтрокаШапки.КодРПБСПодр = ДанныеОрганизации.КодРПБСОбособленногоПодразделения;
		СтрокаШапки.ГлаваБК = ДанныеОрганизации.ГлаваБК;
		СтрокаШапки.ОКТМО = ДанныеОрганизации.ОКТМО;
		СтрокаШапки.АдресГрузополучателя = ДанныеОрганизации.ЮридическийАдресОрганизации;
		СтрокаШапки.НаименованиеСтруктурногоПодразделения = ДанныеОрганизации.СтруктурноеПодразделение;

		ЗаполнитьЗначенияСвойств(Отбор, ВыборкаШапка);

		ВыборкаДокументыПоставки.Сбросить();
		Пока ВыборкаДокументыПоставки.НайтиСледующий(Отбор) Цикл
			СтрокаДокументаПоставки = СтрокаШапки.ДокументыПоставки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДокументаПоставки, ВыборкаДокументыПоставки);
			Если ТипЗнч(СтрокаДокументаПоставки.ДокументСсылка) = Тип("ДокументСсылка.ПриходныйОрдерФондовый") Тогда
				СтрокаДокументаПоставки.НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
					СтрокаДокументаПоставки.Ссылка, СтрокаДокументаПоставки.НомерДокумента);
				СтрокаДокументаПоставки.НаименованиеДокумента = НСтр("ru = 'Приходный кассовый ордер'");
			КонецЕсли;
		КонецЦикла;
		
		ВыборкаТранспортировкаИПриемка.Сбросить();
		Пока ВыборкаТранспортировкаИПриемка.НайтиСледующий(Отбор) Цикл
			ЗаполнитьЗначенияСвойств(СтрокаШапки.ТранспортировкаИПриемка.Добавить(), ВыборкаТранспортировкаИПриемка);
		КонецЦикла;

		ОтборСтрокУпаковки = Новый Структура("ИдентификаторСтрокиУпаковки, Ссылка");
		ОтборСтрокУпаковки.Ссылка = Отбор.Ссылка;
		ВыборкаСведенияОбУпаковке.Сбросить();
		Пока ВыборкаСведенияОбУпаковке.НайтиСледующий(Отбор) Цикл
			СтрокаУпаковки = СтрокаШапки.СведенияОбУпаковке.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаУпаковки, ВыборкаСведенияОбУпаковке);
			ОтборСтрокУпаковки.ИдентификаторСтрокиУпаковки = СтрокаУпаковки.ИдентификаторСтроки;
			СоставУпаковки = ТоварыВУпаковках.НайтиСтроки(ОтборСтрокУпаковки);
			Для Каждого СтрокаСоставаУпаковки Из СоставУпаковки Цикл
				СтрокаУпаковки.СоставУпаковки.Добавить(СтрокаСоставаУпаковки.Номенклатура);
			КонецЦикла;
		КонецЦикла;

		ОтборРНПТ = Новый Структура("ИдентификаторСтроки, Ссылка");
		ОтборРНПТ.Ссылка = Отбор.Ссылка;
		ВсеТоварыРаботыУслуги.Сбросить();
		Пока ВсеТоварыРаботыУслуги.НайтиСледующий(Отбор) Цикл
			
			СтрокаТоварыРаботыУслуги = СтрокаШапки.ТоварыРаботыУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТоварыРаботыУслуги, ВсеТоварыРаботыУслуги);
			
			ОтборРНПТ.ИдентификаторСтроки = ВсеТоварыРаботыУслуги.ИдентификаторСтроки;
			РНПТ = СведенияПрослеживаемости.НайтиСтроки(ОтборРНПТ);
			РНПТПоДокументам = Новый Соответствие;
			Для Каждого СтрокаПрослеживаемости Из РНПТ Цикл
				СтрокаТоварыРаботыУслуги.СведенияПрослеживаемости.Добавить(СтрокаПрослеживаемости.РНПТ);
				РНПТПоДокументам.Вставить(СтрокаПрослеживаемости.РНПТ, Истина);
			КонецЦикла;
			
			Если ВсеТоварыРаботыУслуги.ЕстьРасхождения Тогда
				СтрокаРасхождения = СтрокаШапки.Расхождения.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРасхождения, ВсеТоварыРаботыУслуги);
				Если ЗначениеЗаполнено(ВсеТоварыРаботыУслуги.Содержание) Тогда
					СтрокаРасхождения.НаименованиеТовара = ВсеТоварыРаботыУслуги.Содержание;
				КонецЕсли;
				РНПТ = СведенияПрослеживаемостиФактические.НайтиСтроки(ОтборРНПТ);
				Для Каждого СтрокаПрослеживаемости Из РНПТ Цикл
					Если РНПТПоДокументам.Получить(СтрокаПрослеживаемости.РНПТ) = Неопределено Тогда
						СтрокаРасхождения.СведенияПрослеживаемости.Добавить(СтрокаПрослеживаемости.РНПТ);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;

		ВыборкаФайлы.Сбросить();
		Пока ВыборкаФайлы.НайтиСледующий(Отбор) Цикл
			ЗаполнитьЗначенияСвойств(СтрокаШапки.Файлы.Добавить(), ВыборкаФайлы);
		КонецЦикла;

		ФИО = Новый Структура;
		ФИО.Вставить("Фамилия", "");
		ФИО.Вставить("Имя", "");
		ФИО.Вставить("Отчество", "");
		ВыборкаКомиссии.Сбросить();
		Пока ВыборкаКомиссии.НайтиСледующий(Отбор) Цикл
			ЧленКомиссии = СтрокаШапки.СоставКомиссии.Добавить();
			ЧленКомиссии.Ссылка = ВыборкаКомиссии.Ссылка;
			ЧленКомиссии.НаименованиеДолжности = ВыборкаКомиссии.Должность;
			ФИО.Фамилия = ВыборкаКомиссии.Фамилия;
			ФИО.Имя = ВыборкаКомиссии.Имя;
			ФИО.Отчество = ВыборкаКомиссии.Отчество;
			ЧленКомиссии.ФИО = КорреспондентыКлиентСервер.ФИО(ФИО, Истина);
			ЧленКомиссии.Председатель = ВыборкаКомиссии.Председатель;
		КонецЦикла;
		
		ВыборкаПлатежныеДокументы.Сбросить();
		Пока ВыборкаПлатежныеДокументы.НайтиСледующий(Отбор) Цикл
			НоваяСтрокаПД = СтрокаШапки.ПлатежныеДокументы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаПД, ВыборкаПлатежныеДокументы);
			НоваяСтрокаПД.ДокументСсылка = ВыборкаПлатежныеДокументы.ПлатежныйДокумент;
			Если ВыборкаПлатежныеДокументы.НаименованиеПД = Null Тогда
				НоваяСтрокаПД.НаименованиеПД = ВыборкаПлатежныеДокументы.ПлатежныйДокумент.Метаданные().Синоним;
				НоваяСтрокаПД.НомерПД = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
					ВыборкаПлатежныеДокументы.ПлатежныйДокумент, НоваяСтрокаПД.НомерПД);
				СтрокиПлатежныхДокументовСИсполнением.Вставить(НоваяСтрокаПД, ВыборкаПлатежныеДокументы.ПлатежныйДокумент);
			КонецЕсли;
			
		КонецЦикла;
		
		ВыборкаСМР.Сбросить();
		Пока ВыборкаСМР.НайтиСледующий(Отбор) Цикл
			ЗаполнитьЗначенияСвойств(СтрокаШапки.СМР.Добавить(), ВыборкаСМР);
		КонецЦикла;
		
		ВыборкаСтоимостьСМР.Сбросить();
		Пока ВыборкаСтоимостьСМР.НайтиСледующий(Отбор) Цикл
			ЗаполнитьЗначенияСвойств(СтрокаШапки.СтоимостьСМР.Добавить(), ВыборкаСтоимостьСМР);
		КонецЦикла;
		
	КонецЦикла;
	
	Если СтрокиПлатежныхДокументовСИсполнением.Количество() > 0 Тогда
		// Если из запроса не вернулось наименование платежного документа, то его нужно получить из данных исполнения.
		// Вместе с наименованием может быть заполнена дата и номер фактического документа исполнения.
		ЗаполнитьДанныеПлатежныхДокументовПоФактическомуИсполнению(СтрокиПлатежныхДокументовСИсполнением);
	КонецЕсли;

	Возврат Результат;
КонецФункции

Процедура ЗаполнитьДанныеПлатежныхДокументовПоФактическомуИсполнению(СтрокиПлатежныхДокументовСИсполнением)
	ПлатежныеДокументы = Новый Массив;
	Для Каждого СтрокаДокумента Из СтрокиПлатежныхДокументовСИсполнением Цикл
		ПлатежныеДокументы.Добавить(СтрокаДокумента.Значение);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	ДанныеИсполнения = ПолучитьДанныеИсполненияПлатежныхДокументов(ПлатежныеДокументы);
	УстановитьПривилегированныйРежим(Ложь);
	Для Каждого СтрокаДокумента Из СтрокиПлатежныхДокументовСИсполнением Цикл
		ИсполнениеДокумента = ДанныеИсполнения.Получить(СтрокаДокумента.Значение);
		Если ИсполнениеДокумента <> Неопределено Тогда
			ОбрабатываемаяСтрока = СтрокаДокумента.Ключ;
			Если ЗначениеЗаполнено(ИсполнениеДокумента.НаименованиеПД) Тогда
				ОбрабатываемаяСтрока.НаименованиеПД = ИсполнениеДокумента.НаименованиеПД;
			КонецЕсли;
			Если ЗначениеЗаполнено(ИсполнениеДокумента.НомерПД) Тогда
				ОбрабатываемаяСтрока.НомерПД = ИсполнениеДокумента.НомерПД;
				ОбрабатываемаяСтрока.ДатаПД = ИсполнениеДокумента.ДатаПД;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьДанныеИсполненияПлатежныхДокументов(ПлатежныеДокументы)
	ДанныеИсполнения = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент КАК Ссылка,
	|	СостояниеПлатежноРасчетныхДокументов.НомерПодтверждающегоДокумента КАК НомерПД,
	|	СостояниеПлатежноРасчетныхДокументов.ДатаПодтверждающегоДокумента КАК ДатаПД,
	|	СостояниеПлатежноРасчетныхДокументов.ВидПодтверждающегоДокумента КАК НаименованиеПД
	|ИЗ
	|	РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
	|ГДЕ
	|	СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент В(&ПлатежныеДокументы)
	|	И СостояниеПлатежноРасчетныхДокументов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДокумента.Исполнен)";
	Запрос.УстановитьПараметр("ПлатежныеДокументы", ПлатежныеДокументы);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеИсполнения.Вставить(Выборка.Ссылка,
			Новый Структура("НомерПД, ДатаПД, НаименованиеПД",
				Выборка.НомерПД,
				Выборка.ДатаПД,
				Выборка.НаименованиеПД));
	КонецЦикла;
	Возврат ДанныеИсполнения;
КонецФункции

// Сравнивает 2 редакции по дате выхода.
// Возвращает -1 если ПроверяемаяРедакция вышла раньше ЭталоннойРедакции.
// Возвращает 1 если ПроверяемаяРедакция вышла позже ЭталоннойРедакции.
// Возвращает 0 если ПроверяемаяРедакция равна ЭталоннойРедакции.
// Если ПроверяемаяРедакция или ЭталоннаяРедакция не найдены, возвращает 1.
//
// Параметры:
//  ПроверяемаяРедакция	 - Строка
//  ЭталоннаяРедакция	 - Строка
// 
// Возвращаемое значение:
// Число
//
Функция СравнитьРедакцииПоДатеВыхода(ПроверяемаяРедакция, ЭталоннаяРедакция) Экспорт
	
	Если ПроверяемаяРедакция = ЭталоннаяРедакция Тогда
		Возврат 0;
	КонецЕсли;
	
	НомерПроверяемойРедакции = -1;
	НомерЭталоннойРедакции = -1;
	
	ВсеРедакции = РедакцииПечатнойФормы();
	Для Индекс = 0 По ВсеРедакции.ВГраница() Цикл
		Редакция = ВсеРедакции[Индекс];
		Если ПроверяемаяРедакция = Редакция Тогда
			НомерПроверяемойРедакции = Индекс;
		КонецЕсли;
		Если ЭталоннаяРедакция = Редакция Тогда
			НомерЭталоннойРедакции = Индекс;
		КонецЕсли;
	КонецЦикла;
	
	Если НомерПроверяемойРедакции > НомерЭталоннойРедакции Или НомерПроверяемойРедакции < 0 Тогда
		Возврат 1;
	Иначе
		Возврат -1;
	КонецЕсли;
КонецФункции

#КонецОбласти

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

// Возвращает массив непроведенных документов поставки из табличной части ДокументыПоступления.
//
// Параметры:
//  ДокументыПоступления - ТаблицаЗначений - табличная часть документов поступления
//
// Возвращаемое значение:
//  Массив - массив ссылок на документы, которые нужно провести
//
Функция НайтиНепроведенныеДокументыПоставки(ДокументыПоступления) Экспорт
	
	Возврат ПолучитьДокументыПоступленияПоУсловиям(ДокументыПоступления, Новый Структура("Проведен", Ложь));
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ПолучитьДокументыПоступленияПоУсловиям(ДокументыПоступления, Знач ДополнительныйОтбор = Неопределено) Экспорт
	
	Если ДокументыПоступления.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ДокументыПоТипам = ОбщегоНазначенияБГУ.ДокументыПоТипам(ДокументыПоступления.ВыгрузитьКолонку("ДокументОснование"));
	
	Если ДокументыПоТипам.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ТекстШаблонаЗапроса =
	"ВЫБРАТЬ
	|	Документ.Ссылка КАК Ссылка
	|ИЗ
	|	&ИмяТаблицы КАК Документ
	|ГДЕ
	|	Документ.Ссылка В (&Ссылки)";
	ЕстьДополнительныйОтбор = ТипЗнч(ДополнительныйОтбор) = Тип("Структура") И ЗначениеЗаполнено(ДополнительныйОтбор);
	Если ЕстьДополнительныйОтбор Тогда
		ТекстШаблонаЗапроса = ТекстШаблонаЗапроса + "
		|	И &ДополнительныйОтбор";
	КонецЕсли;
	
	ТекстыЗапросов = Новый Массив;
	Запрос = Новый Запрос;
	ИндексПараметра = 0;
	
	Для Каждого КлючИЗначение Из ДокументыПоТипам Цикл
		МетаданныеДокумента = Метаданные.НайтиПоТипу(КлючИЗначение.Ключ);
		ТекстЧасти = СтрЗаменить(ТекстШаблонаЗапроса, "&ИмяТаблицы", МетаданныеДокумента.ПолноеИмя());
		ИмяПараметраСсылки = "Ссылки_" + Строка(ИндексПараметра);
		ТекстЧасти = СтрЗаменить(ТекстЧасти, "&Ссылки", "&" + ИмяПараметраСсылки);
		Запрос.УстановитьПараметр(ИмяПараметраСсылки, КлючИЗначение.Значение);
		Если ЕстьДополнительныйОтбор Тогда
			ТекстОтбора = Новый Массив;
			Для Каждого ЭлементОтбора Из ДополнительныйОтбор Цикл
				Если ЭлементОтбора.Ключ = "Проведен"
						Или ОбщегоНазначения.ЕстьРеквизитОбъекта(ЭлементОтбора.Ключ, МетаданныеДокумента) Тогда
					ИмяПараметра = "Параметр_" + ЭлементОтбора.Ключ + "_" + ИндексПараметра;
					ТекстОтбора.Добавить("Документ." + ЭлементОтбора.Ключ + " = &" + ИмяПараметра);
					Запрос.УстановитьПараметр(ИмяПараметра, ЭлементОтбора.Значение);
				КонецЕсли;
			КонецЦикла;
			Если ТекстОтбора.Количество() = 0 Тогда
				ТекстДополнительныйОтбор = "ИСТИНА";
			Иначе
				ТекстДополнительныйОтбор = СтрСоединить(ТекстОтбора, " И ");
			КонецЕсли;
			ТекстЧасти = СтрЗаменить(ТекстЧасти, "&ДополнительныйОтбор", ТекстДополнительныйОтбор);
		КонецЕсли;
		ТекстыЗапросов.Добавить(ТекстЧасти);
		ИндексПараметра = ИндексПараметра + 1;
	КонецЦикла;
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.ТекстОбъединитьВсе());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Новый Массив;
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Параметры настройки группового изменения реквизитов.
// 
// Параметры:
//  Параметры - Структура:
//   * Организация - СправочникСсылка.Организации
//   * Дата - Дата
//   * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//   * Ссылка - ДокументСсылка 
//   * ДополнительныеСвойства - Произвольный
// 
// Возвращаемое значение:
//  Структура - Параметры настройки группового изменения реквизитов:
//   * ОписаниеРеквизитов - ТаблицаЗначений
Функция ПараметрыНастройкиГрупповогоИзмененияРеквизитов(Параметры) Экспорт

	МетаданныеДокумента = Метаданные.Документы.АктПриемкиТоваровРаботУслуг;
	МетаданныеТЧ = МетаданныеДокумента.ТабличныеЧасти.ТоварыРаботыУслуги;

	ИзменяемыеРеквизиты = Новый ТаблицаЗначений;
	ИзменяемыеРеквизиты.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	ИзменяемыеРеквизиты.Колонки.Добавить("Заголовок", Новый ОписаниеТипов("Строка"));
	ИзменяемыеРеквизиты.Колонки.Добавить("Тип", Новый ОписаниеТипов("ОписаниеТипов"));
	ИзменяемыеРеквизиты.Колонки.Добавить("ИмяФормыВыбора", Новый ОписаниеТипов("Строка"));
	ИзменяемыеРеквизиты.Колонки.Добавить("ПараметрыВыбора", Новый ОписаниеТипов("ФиксированныйМассив"));
	ИзменяемыеРеквизиты.Колонки.Добавить("СвязиПараметровВыбора", Новый ОписаниеТипов("ФиксированныйМассив"));
	
	Реквизит = ИзменяемыеРеквизиты.Добавить();
	Реквизит.Имя = "СчетРасчетов";
	МетаданныеРеквизита = МетаданныеТЧ.Реквизиты[Реквизит.Имя];
	Реквизит.Заголовок = МетаданныеРеквизита.Синоним;
	Реквизит.Тип = МетаданныеРеквизита.Тип;
	Реквизит.ИмяФормыВыбора = "ПланСчетов.ЕПСБУ.ФормаВыбора";
	Реквизит.ПараметрыВыбора = МетаданныеРеквизита.ПараметрыВыбора;
	Реквизит.СвязиПараметровВыбора = МетаданныеРеквизита.СвязиПараметровВыбора;
	
	Реквизит = ИзменяемыеРеквизиты.Добавить();
	Реквизит.Имя = "КФО";
	МетаданныеРеквизита = МетаданныеТЧ.Реквизиты[Реквизит.Имя];
	Реквизит.Заголовок = МетаданныеРеквизита.Синоним;
	Реквизит.Тип = МетаданныеРеквизита.Тип;
	Реквизит.ПараметрыВыбора = МетаданныеРеквизита.ПараметрыВыбора;
	Реквизит.СвязиПараметровВыбора = МетаданныеРеквизита.СвязиПараметровВыбора;
	
	Реквизит = ИзменяемыеРеквизиты.Добавить();
	Реквизит.Имя = "КПС";
	МетаданныеРеквизита = МетаданныеТЧ.Реквизиты[Реквизит.Имя];
	Реквизит.Заголовок = МетаданныеРеквизита.Синоним;
	Реквизит.Тип = МетаданныеРеквизита.Тип;
	Реквизит.ИмяФормыВыбора = "Справочник.КлассификационныеПризнакиСчетов.ФормаВыбора";
	Реквизит.ПараметрыВыбора = МетаданныеРеквизита.ПараметрыВыбора;
	Реквизит.СвязиПараметровВыбора = МетаданныеРеквизита.СвязиПараметровВыбора;
	
	Реквизит = ИзменяемыеРеквизиты.Добавить();
	Реквизит.Имя = "КЭК";
	МетаданныеРеквизита = МетаданныеТЧ.Реквизиты[Реквизит.Имя];
	Реквизит.Заголовок = МетаданныеРеквизита.Синоним;
	Реквизит.Тип = МетаданныеРеквизита.Тип;
	Реквизит.ИмяФормыВыбора = "Справочник.КОСГУ.ФормаВыбора";
	Реквизит.ПараметрыВыбора = МетаданныеРеквизита.ПараметрыВыбора;
	Реквизит.СвязиПараметровВыбора = МетаданныеРеквизита.СвязиПараметровВыбора;
	
	Результат = Новый Структура;
	Результат.Вставить("ОписаниеРеквизитов", ИзменяемыеРеквизиты);

	Возврат Результат;	
КонецФункции

// Заполнить зачет авансов.
// 
// Параметры:
//  Документ - ДокументОбъект.АктПриемкиТоваровРаботУслуг -
//         - см. Документ.АктПриемкиТоваровРаботУслуг.Форма.ФормаДокумента.Объект
Процедура ЗаполнитьЗачетАвансов(Документ) Экспорт
	ПараметрыЗаполнения = БухгалтерскийУчет.ПараметрыЗаполненияТаблицыДокументаЗачетАвансов(Документ);
	
	Если Документ.Ссылка.Пустая() Тогда
		ПериодОстатков = Новый Граница(КонецДня(Документ.Дата), ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(Документ.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	ПараметрыЗаполнения.ПериодОстатков = ПериодОстатков;
	ПараметрыЗаполнения.ПоВсемКПС = Истина;
	ПараметрыЗаполнения.ПоВсемКФО = Истина;
	
	ДокументОбъект = ПолучитьДокументОбъект(Документ);
	Отказ = Ложь;
	ТаблицаДокумента = УчетРасчетов.ПодготовитьТаблицуРасчетовПоДокументу(
		ДокументОбъект, ПараметрыЗаполнения, Отказ);
	
	ТаблицаРасчетов = УчетРасчетов.ТаблицаРасчетовСЗачетомАвансов(
		ТаблицаДокумента, , ПараметрыЗаполнения, Отказ);
	
	Если НЕ Отказ Тогда
		
		Документ.ЗачетАвансов.Очистить();
		
		АвансыКЗачету = ТаблицаРасчетов.НайтиСтроки(
			Новый Структура("ЭтоЗачетАванса", Истина));
		
		Для Каждого АвансКЗачету Из АвансыКЗачету Цикл
			
			Если АвансКЗачету.ВидДопСубконтоАвансов <> ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов
					И ЗначениеЗаполнено(АвансКЗачету.ВидДопСубконтоАвансов) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Документ.ЗачетАвансов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, АвансКЗачету);
			
			НоваяСтрока.ДокументАванса = АвансКЗачету.ДопСубконтоАвансов;
			НоваяСтрока.КЭК            = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчетуСУчетомПоступленияМЗ(АвансКЗачету.СчетАвансов);
			НоваяСтрока.СуммаЗачета    = АвансКЗачету.СуммаРасчетов;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполнить денежные обязательства.
// 
// Параметры:
//  Документ - ДокументОбъект.АктПриемкиТоваровРаботУслуг -
//         - см. Документ.АктПриемкиТоваровРаботУслуг.Форма.ФормаДокумента.Объект
Процедура ЗаполнитьДенежныеОбязательства(Документ) Экспорт

	// Проверить заполнение необходимых реквизитов
	Отказ = Ложь;
	Для Каждого Строка Из Документ.ТоварыРаботыУслуги Цикл
		Если Не ЗначениеЗаполнено(Строка.СчетРасчетов) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru = 'Счет расчетов'"), Строка.НомерСтроки, НСтр("ru = 'Расчеты'")); 
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Документ.Ссылка,
				"Объект.ТоварыРаботыУслуги[" + Формат(Строка.НомерСтроки - 1, "ЧН=0; ЧГ=0") + "].СчетРасчетов", ,
				Отказ);	
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка.КФО) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru = 'КФО'"), Строка.НомерСтроки, НСтр("ru = 'Расчеты'")); 
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Документ.Ссылка,
				"Объект.ТоварыРаботыУслуги[" + Формат(Строка.НомерСтроки - 1, "ЧН=0; ЧГ=0") + "].КФО", ,
				Отказ);	
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка.КПС) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru = 'КПС'"), Строка.НомерСтроки, НСтр("ru = 'Расчеты'")); 
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Документ.Ссылка,
				"Объект.ТоварыРаботыУслуги[" + Формат(Строка.НомерСтроки - 1, "ЧН=0; ЧГ=0") + "].КПС", ,
				Отказ);	
		КонецЕсли;
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ДокументОбъект = ПолучитьДокументОбъект(Документ);
	
	Если ДокументОбъект.Ссылка.Пустая() Тогда
		ПериодОстатков = Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	ТаблицаОбязательств = УчетРасчетов.ДенежныеОбязательстваПоПоступлениюТРУ(ДокументОбъект, ПериодОстатков);
	
	Документ.ДенежныеОбязательства.Загрузить(ТаблицаОбязательств);
	
КонецПроцедуры

// Заполнить товары работы услуги.
// 
// Параметры:
//  Документ - ДокументОбъект.АктПриемкиТоваровРаботУслуг -
//         - см. Документ.АктПриемкиТоваровРаботУслуг.Форма.ФормаДокумента.Объект
Процедура ЗаполнитьТоварыРаботыУслуги(Документ) Экспорт

	ДокументОбъект = ПолучитьДокументОбъект(Документ);
	
	Документ.СуммаДенежногоОбязательства = 0;
	Документ.ТоварыРаботыУслуги.Очистить();
	Документ.СведенияПрослеживаемости.Очистить();
	Документ.СведенияПрослеживаемостиФактические.Очистить();
	Документ.СоставУпаковок.Очистить();

	МатериалыВременная = ДокументОбъект.ТоварыРаботыУслуги.ВыгрузитьКолонки();
	МатериалыВременная.Колонки.Добавить("КЭККод", Новый ОписаниеТипов("Строка"));
	МатериалыВременная.Колонки.Добавить("НоменклатураНаименование", Новый ОписаниеТипов("Строка"));
	МатериалыВременная.Колонки.Добавить("ЭтоУслуга", Новый ОписаниеТипов("Булево"));

	ДокументыПоступления = ДокументОбъект.ДокументыПоступления.Выгрузить().ВыгрузитьКолонку("ДокументОснование");
	ДобавитьТоварыРаботыУслугиИзПоступленийНФА(МатериалыВременная, Документ, ДокументыПоступления);
	
	Счета30214 = БухгалтерскийУчет.СписокСчетов("302.14");
	КЭК214 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("214");
	Счета30226 = БухгалтерскийУчет.СписокСчетов("302.26");
	КЭК226 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("226");
	Счета30297 = БухгалтерскийУчет.СписокСчетов("302.97");
	КЭК297 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("297");
	МатериалыВременная.Сортировать("КЭККод, НоменклатураНаименование");
	Документ.ТоварыРаботыУслуги.Загрузить(МатериалыВременная);
	Для Каждого НоваяСтрока Из Документ.ТоварыРаботыУслуги Цикл
		НоваяСтрока.КоличествоПринято = НоваяСтрока.Количество;
		Если НоваяСтрока.Количество <> 0 Тогда
			НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.Количество;
		КонецЕсли;
		НоваяСтрока.СуммаПринято = НоваяСтрока.Всего;
		Если Счета30214.Найти(НоваяСтрока.СчетРасчетов) <> Неопределено Тогда
			НоваяСтрока.КЭК = КЭК214;
		ИначеЕсли Счета30226.Найти(НоваяСтрока.СчетРасчетов) <> Неопределено Тогда
			НоваяСтрока.КЭК = КЭК226;
		ИначеЕсли Счета30297.Найти(НоваяСтрока.СчетРасчетов) <> Неопределено Тогда
			НоваяСтрока.КЭК = КЭК297;
		ИначеЕсли Не ЗначениеЗаполнено(НоваяСтрока.СчетРасчетов) Тогда
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьАналитическийСчетПоКЭК(
				НоваяСтрока.КЭК, "302.00", , Документ.Дата, Документ.Организация, Документ.ИФО);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Подготовить таблицу расчетов по документу.
// 
// Параметры:
//  Документ - ДокументОбъект.АктПриемкиТоваровРаботУслуг
//  Параметры - Неопределено - Параметры
//  Отказ - Булево
// 
// Возвращаемое значение:
//  см. УчетРасчетов.ПустаяТаблицаРасчетовПоДокументу
Функция ПодготовитьТаблицуРасчетовПоДокументу(Документ, Параметры, Отказ) Экспорт
	ТаблицаРасчетов = УчетРасчетов.ПустаяТаблицаРасчетовПоДокументу();
	
	Для Каждого СтрокаТовара Из Документ.ТоварыРаботыУслуги Цикл
		
		СтрокаРасчетов = ТаблицаРасчетов.Добавить();
		СтрокаРасчетов.ЭтоПоступление = Истина;
		СтрокаРасчетов.ИФО = Документ.ИФО;
		СтрокаРасчетов.КФО = СтрокаТовара.КФО;
		СтрокаРасчетов.КПС = СтрокаТовара.КПС;
		СтрокаРасчетов.Подразделение = Документ.Подразделение;
		СтрокаРасчетов.КЭК = СтрокаТовара.КЭК;
		СтрокаРасчетов.СчетРасчетов = СтрокаТовара.СчетРасчетов;
		СтрокаРасчетов.Контрагент = Документ.Контрагент;
		СтрокаРасчетов.Договор = Документ.Договор;
		СтрокаРасчетов.Валюта = Документ.ВалютаДокумента;
		СтрокаРасчетов.СуммаРасчетов = СтрокаТовара.СуммаПринято;
		
	КонецЦикла;
	
	ТаблицаРасчетов.Свернуть("ЭтоПоступление, ИФО, КФО, КПС, Подразделение, КЭК, СчетРасчетов, Контрагент,
		|Договор, Валюта",
		"СуммаНДС, СуммаРасчетов");
	
	Возврат ТаблицаРасчетов;
КонецФункции

// Установить заказчика равным Организации.
// 
// Параметры:
//  Документ - ДокументОбъект.АктПриемкиТоваровРаботУслуг -
//         - см. Документ.АктПриемкиТоваровРаботУслуг.Форма.ФормаДокумента.Объект
Процедура УстановитьЗаказчикаПоУмолчанию(Документ) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ.Организация) Тогда
		Возврат;
	КонецЕсли;
	
	Документ.Заказчик = КонтрагентПоОрганизации(Документ.Организация);
	
КонецПроцедуры

// Пустая таблица корректировки отложенных обязательств.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Пустая таблица корректировки отложенных обязательств:
// * КФО - ПеречислениеСсылка.КВД - 
// * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов - 
// * КЭК - СправочникСсылка.КОСГУ - 
// * Сумма - Число - 
Функция ПустаяТаблицаКорректировкиОтложенныхОбязательств() Экспорт
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	Таблица.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Таблица.Колонки.Добавить("КЭК", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Таблица.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	
	Возврат Таблица;
КонецФункции

// Таблица корректировки отложенных обязательств.
// 
// Параметры:
//  Параметры - Структура
//  Отказ - Булево
// 
// Возвращаемое значение:
//  см. ПустаяТаблицаКорректировкиОтложенныхОбязательств
Функция ТаблицаКорректировкиОтложенныхОбязательств(Параметры, Отказ) Экспорт
	ТаблицаКорректировки = ПустаяТаблицаКорректировкиОтложенныхОбязательств();

	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДокументОбъект = КонтекстПроведения.ДокументОбъект;
	
	Резерв = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Резерв");
	ТипБулево = Новый ОписаниеТипов("Булево");
	ЧастичнаяПриемка = ТипБулево.ПривестиЗначение(
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ЧастичнаяПриемка"));
	РазделЛицевогоСчета = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "РазделЛицевогоСчета");
	СчетРезерва = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "СчетРезерва");
	
	ОтложенныеОбязательства = ОтложенныеОбязательстваПоРезерву(ДокументОбъект, Резерв, РазделЛицевогоСчета,
		ЧастичнаяПриемка, СчетРезерва);
	Для Каждого Строка Из ОтложенныеОбязательства Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаКорректировки.Добавить(), Строка);
	КонецЦикла;
	
	Возврат ТаблицаКорректировки;
КонецФункции

// Пустая таблица корректировки резервов.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Пустая таблица корректировки резервов:
// * Счет - ПланСчетовСсылка.ЕПСБУ
// * Подразделение - СправочникСсылка.Подразделения
// * КФО - ПеречислениеСсылка.КВД - 
// * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов - 
// * КЭК - СправочникСсылка.КОСГУ - 
// * Сумма - Число - 
Функция ПустаяТаблицаКорректировкиРезервов() Экспорт
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Таблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Таблица.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	Таблица.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Таблица.Колонки.Добавить("КЭК", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Таблица.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	
	Возврат Таблица;
КонецФункции

// Таблица корректировки резервов.
// 
// Параметры:
//  Параметры - Структура
//  Отказ - Булево
// 
// Возвращаемое значение:
//  см. ПустаяТаблицаКорректировкиРезервов
Функция ТаблицаКорректировкиРезервов(Параметры, Отказ) Экспорт
	ТаблицаКорректировки = ПустаяТаблицаКорректировкиРезервов();

	ТипБулево = Новый ОписаниеТипов("Булево");
	ЧастичнаяПриемка = ТипБулево.ПривестиЗначение(
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ЧастичнаяПриемка"));
	Резерв = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Резерв");
	СчетРезерва = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "СчетРезерва");
	КПСРезерва = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "КПСРезерва");
	Если ЧастичнаяПриемка Или Не ЗначениеЗаполнено(Резерв) Или Не ЗначениеЗаполнено(СчетРезерва) Тогда
		Возврат ТаблицаКорректировки;
	КонецЕсли;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДокументОбъект = КонтекстПроведения.ДокументОбъект; // ДокументОбъект.АктПриемкиТоваровРаботУслуг
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетРезерва).УчетПоПодразделениям;
	Подразделение = ДокументОбъект.Подразделение;
	
	ОстаткиРезервов = ОстаткиРезервов(ДокументОбъект, Резерв, СчетРезерва, КПСРезерва, УчетПоПодразделениям);
	Для Каждого Строка Из ОстаткиРезервов Цикл
		СтрокаКорректировки = ТаблицаКорректировки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаКорректировки, Строка);
		Если УчетПоПодразделениям Тогда
			СтрокаКорректировки.Подразделение = Подразделение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаКорректировки;
КонецФункции

Функция НайтиПоДокументуПоступления(ДокументПоступления, УчитыватьНезарегистрированныеДокументы = Ложь) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	АктПриемкиТоваровРаботУслугДокументыПоступления.Ссылка КАК АктПриемкиТРУ,
	|	ИСТИНА Как Добавлен
	|ИЗ
	|	Документ.АктПриемкиТоваровРаботУслуг.ДокументыПоступления КАК АктПриемкиТоваровРаботУслугДокументыПоступления
	|ГДЕ
	|	АктПриемкиТоваровРаботУслугДокументыПоступления.ДокументОснование = &ДокументПоступления";
	Если УчитыватьНезарегистрированныеДокументы Тогда
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.ТекстОбъединитьВсе() +
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ.АктПриемкиТРУ КАК АктПриемкиТРУ,
		|	ЛОЖЬ
		|ИЗ
		|	РегистрСведений.НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ КАК
		|		НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ
		|ГДЕ
		|	НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ.ПоступлениеНФА = &ДокументПоступления";
	КонецЕсли;
	Запрос.УстановитьПараметр("ДокументПоступления", ДокументПоступления);
	
	Результат = Новый Структура("АктПриемкиТРУ, Добавлен", ПустаяСсылка(), Ложь);
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ДанныеАктаПриемкиДляВводаПоступленияНФА(АктПриемкиТРУ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	УслугиИРаботы1.Номенклатура КАК Номенклатура,
	|	ПОДСТРОКА(УслугиИРаботы1.Содержание, 1, 1000) КАК Содержание
	|ПОМЕСТИТЬ ВТ_УжеПринятые
	|ИЗ
	|	Документ.ПоступлениеУслугРабот.УслугиИРаботы КАК УслугиИРаботы1
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктПриемкиТоваровРаботУслуг.ДокументыПоступления КАК ДокументыПоступления
	|		ПО ДокументыПоступления.ДокументОснование = УслугиИРаботы1.Ссылка
	|ГДЕ
	|	ДокументыПоступления.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	УслугиИРаботы2.Номенклатура КАК Номенклатура,
	|	ПОДСТРОКА(УслугиИРаботы2.Содержание, 1, 1000) КАК Содержание
	|ИЗ
	|	Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.УслугиИРаботы КАК УслугиИРаботы2
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктПриемкиТоваровРаботУслуг.ДокументыПоступления КАК ДокументыПоступления
	|		ПО ДокументыПоступления.ДокументОснование = УслугиИРаботы2.Ссылка
	|ГДЕ
	|	ДокументыПоступления.Ссылка = &Ссылка
	|	
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	УслугиИРаботы1.Номенклатура КАК Номенклатура,
	|	ПОДСТРОКА(УслугиИРаботы1.Содержание, 1, 1000) КАК Содержание
	|ИЗ
	|	Документ.ПоступлениеУслугРабот.УслугиИРаботы КАК УслугиИРаботы1
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ КАК ДокументыВОбработке
	|	ПО УслугиИРаботы1.Ссылка = ДокументыВОбработке.ПоступлениеНФА
	|ГДЕ
	|	ДокументыВОбработке.АктПриемкиТРУ = &Ссылка
	|	
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	УслугиИРаботы2.Номенклатура КАК Номенклатура,
	|	ПОДСТРОКА(УслугиИРаботы2.Содержание, 1, 1000) КАК Содержание
	|ИЗ
	|	Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.УслугиИРаботы КАК УслугиИРаботы2
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ КАК ДокументыВОбработке
	|	ПО УслугиИРаботы2.Ссылка = ДокументыВОбработке.ПоступлениеНФА
	|ГДЕ
	|	ДокументыВОбработке.АктПриемкиТРУ = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Содержание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АктПриемкиТоваровРаботУслуг.Дата КАК Дата,
	|	АктПриемкиТоваровРаботУслуг.Организация КАК Организация,
	|	АктПриемкиТоваровРаботУслуг.ИФО КАК ИФО,
	|	АктПриемкиТоваровРаботУслуг.Подразделение КАК Подразделение,
	|	АктПриемкиТоваровРаботУслуг.Контрагент КАК Контрагент,
	|	АктПриемкиТоваровРаботУслуг.Договор КАК Договор,
	|	АктПриемкиТоваровРаботУслуг.ВалютаДокумента КАК ВалютаДокумента
	|ИЗ
	|	Документ.АктПриемкиТоваровРаботУслуг КАК АктПриемкиТоваровРаботУслуг
	|ГДЕ
	|	АктПриемкиТоваровРаботУслуг.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыРаботыУслуги.Номенклатура КАК Номенклатура,
	|	ТоварыРаботыУслуги.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ТоварыРаботыУслуги.Количество КАК Количество,
	|	ТоварыРаботыУслуги.Цена КАК Цена,
	|	ТоварыРаботыУслуги.Сумма КАК Сумма,
	|	ТоварыРаботыУслуги.СтавкаНДС КАК СтавкаНДС,
	|	ТоварыРаботыУслуги.СуммаНДС КАК СуммаНДС,
	|	ТоварыРаботыУслуги.Всего КАК Всего,
	|	ТоварыРаботыУслуги.КоличествоПринято КАК КоличествоПринято,
	|	ТоварыРаботыУслуги.СуммаПринято КАК СуммаПринято,
	|	ТоварыРаботыУслуги.КФО КАК КФО,
	|	ТоварыРаботыУслуги.КПС КАК КПС,
	|	ТоварыРаботыУслуги.КЭК КАК КЭК,
	|	ТоварыРаботыУслуги.СчетРасчетов КАК СчетРасчетов,
	|	ТоварыРаботыУслуги.Содержание КАК Содержание,
	|	ТоварыРаботыУслуги.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Документ.АктПриемкиТоваровРаботУслуг.ТоварыРаботыУслуги КАК ТоварыРаботыУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УжеПринятые КАК ВТ_УжеПринятые
	|		ПО ТоварыРаботыУслуги.Номенклатура = ВТ_УжеПринятые.Номенклатура
	|		И ПОДСТРОКА(ТоварыРаботыУслуги.Содержание, 1, 1000) = ВТ_УжеПринятые.Содержание
	|ГДЕ
	|	ТоварыРаботыУслуги.Ссылка = &Ссылка
	|	И ТоварыРаботыУслуги.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатуры)
	|	И ВТ_УжеПринятые.Номенклатура ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыРаботыУслуги.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", АктПриемкиТРУ);
	Запрос.УстановитьПараметр("ТипыНоменклатуры", Перечисления.ТипыНоменклатуры.Услуга);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Результат = Новый Структура;
	Результат.Вставить("Шапка", РезультатЗапроса[1].Выгрузить()[0]);
	Результат.Вставить("ТоварыРаботыУслуги", РезультатЗапроса[2].Выгрузить());
	
	Возврат Результат;	
КонецФункции

#КонецОбласти

