Функция ДанныеПредставителяДляАктаПриемкиТРУ(ВыборкаШапка, ИмяРеквизита)
	
	Если ВыборкаШапка[ИмяРеквизита + "Фамилия"] <> Null Тогда
		ФИО = Новый Структура;
		ФИО.Вставить("Фамилия", ВыборкаШапка[ИмяРеквизита + "Фамилия"]);
		ФИО.Вставить("Имя", ВыборкаШапка[ИмяРеквизита + "Имя"]);
		ФИО.Вставить("Отчество", ВыборкаШапка[ИмяРеквизита + "Отчество"]);
		Возврат КорреспондентыКлиентСервер.ФИО(ФИО, Истина);
	КонецЕсли;
	
	ЗначениеРеквизита = ВыборкаШапка[ИмяРеквизита + "ФИО"]; 
	Если СтрНайти(ЗначениеРеквизита, ".") = 0 Тогда
		Возврат КорреспондентыКлиентСервер.ФИО(ЗначениеРеквизита, Истина);
	КонецЕсли;
	
	Возврат ЗначениеРеквизита;
КонецФункции

