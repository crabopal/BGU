Функция ОтложенныеОбязательстваПоРезерву(ДокументОбъект, Резерв, РазделЛицевогоСчета, ЧастичнаяПриемка, СчетРезерва)
	
	Запрос = Новый Запрос;
	ПринимаемыеНФА = ПринимаемыеНФАДокумента(ДокументОбъект);
	Запрос.УстановитьПараметр("ПринимаемыеНФА", ПринимаемыеНФА);
	Запрос.УстановитьПараметр("Договор", ДокументОбъект.Договор);
	Запрос.УстановитьПараметр("Резерв", Резерв);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Если ЗначениеЗаполнено(СчетРезерва) Тогда
		Счет40160 = СчетРезерва;
	Иначе
		Счет40160 = БухгалтерскийУчет.СчетПоКоду("401.60", ДокументОбъект.Дата, ДокументОбъект.Организация);
	КонецЕсли;
	Запрос.УстановитьПараметр("СчетРезерва", Счет40160);
	Счет50299 = БухгалтерскийУчет.СчетПоКоду("502.99", ДокументОбъект.Дата, ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("СчетОтложенныхОбязательств", Счет50299);
	Если ДокументОбъект.Ссылка.Пустая() Тогда
		Дата = ?(ЗначениеЗаполнено(ДокументОбъект.Дата), ДокументОбъект.Дата, ОбщегоНазначения.ТекущаяДатаПользователя());
		Период = Новый Граница(КонецДня(Дата), ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", Период);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	КонецЕсли;
	Запрос.УстановитьПараметр("Подразделение", ДокументОбъект.Подразделение);
	
	УчетПоПодразделениям502 = Ложь;
	УчетПоПодразделениям40160 = Ложь;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		УчетПоПодразделениям502 = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет50299).УчетПоПодразделениям;
		УчетПоПодразделениям40160 = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет40160).УчетПоПодразделениям;
	КонецЕсли;
	Запрос.УстановитьПараметр("РазделЛицевогоСчета", РазделЛицевогоСчета);
	Запрос.УстановитьПараметр("КЭК340", БухгалтерскийУчетПовтИсп.КЭКПоКоду("340"));
	Если ЧастичнаяПриемка Тогда
		Запрос.Текст = ТекстЗапросаОтложенныеОбязательстваЧастичныйРасчет(УчетПоПодразделениям40160, УчетПоПодразделениям502);
	Иначе
		Запрос.Текст = ТекстЗапросаОтложенныеОбязательстваОкончательныйРасчет(УчетПоПодразделениям40160, УчетПоПодразделениям502);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ТекстЗапросаОстаткиРезервов(УчетПоПодразделениям, ИспользуетсяКПСРезерва)
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ПринимаемыеНФА.КФО,
	|	ПринимаемыеНФА.КПС,
	|	ПринимаемыеНФА.КЭК,
	|	ПринимаемыеНФА.Сумма
	|ПОМЕСТИТЬ ПринимаемыеНФА
	|ИЗ
	|	&ПринимаемыеНФА КАК ПринимаемыеНФА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.КПС,
	|	Т.КЭК,
	|	Т.КФО,
	|	СУММА(Т.Сумма) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЖурналПроводокЕПСБУОстатки.КПС,
	|		ЖурналПроводокЕПСБУОстатки.КЭК,
	|		ЖурналПроводокЕПСБУОстатки.КФО,
	|		ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт КАК Сумма
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет = &СчетРезерва,, Организация = &Организация
	|		И &УсловиеИФО
	|		И &УсловиеПодразделение
	|		И &УсловиеКПС
	|		И Субконто1 = &Резерв
	|		И Субконто2 = &Договор) КАК ЖурналПроводокЕПСБУОстатки
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		&ПолеКПСДокумента,
	|		ПринимаемыеНФА.КЭК,
	|		ПринимаемыеНФА.КФО,
	|		-ПринимаемыеНФА.Сумма
	|	ИЗ
	|		ПринимаемыеНФА КАК ПринимаемыеНФА) КАК Т
	|СГРУППИРОВАТЬ ПО
	|	Т.КПС,
	|	Т.КЭК,
	|	Т.КФО
	|ИМЕЮЩИЕ
	|	СУММА(Т.Сумма) > 0";
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеИФО", "ИФО=&ИФО");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	Если УчетПоПодразделениям Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПодразделение", "Подразделение=&Подразделение");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПодразделение", "ИСТИНА");
	КонецЕсли;
	Если ИспользуетсяКПСРезерва Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеКПС", "КПС=&КПСРезерва");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКПСДокумента", "&КПСРезерва");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеКПС", "ИСТИНА");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКПСДокумента", "ПринимаемыеНФА.КПС");
	КонецЕсли;
		
	Возврат ТекстЗапроса;
КонецФункции

Функция ОстаткиРезервов(ДокументОбъект, Резерв, СчетРезерва, КПСРезерва, УчетПоПодразделениям)
	Запрос = Новый Запрос;
	ПринимаемыеНФА = ПринимаемыеНФАДокумента(ДокументОбъект);
	Запрос.УстановитьПараметр("ПринимаемыеНФА", ПринимаемыеНФА);
	Запрос.УстановитьПараметр("Договор", ДокументОбъект.Договор);
	Запрос.УстановитьПараметр("Резерв", Резерв);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("СчетРезерва", СчетРезерва);
	Если ДокументОбъект.Ссылка.Пустая() Тогда
		Дата = ?(ЗначениеЗаполнено(ДокументОбъект.Дата), ДокументОбъект.Дата, ОбщегоНазначения.ТекущаяДатаПользователя());
		Период = Новый Граница(КонецДня(Дата), ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", Период);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	КонецЕсли;
	
	Если УчетПоПодразделениям Тогда
		Запрос.УстановитьПараметр("Подразделение", ДокументОбъект.Подразделение);
	КонецЕсли;
	ИспользуетсяКПСРезерва = ЗначениеЗаполнено(КПСРезерва);
	Если ИспользуетсяКПСРезерва Тогда
		Запрос.УстановитьПараметр("КПСРезерва", КПСРезерва);
	КонецЕсли;
	Запрос.Текст = ТекстЗапросаОстаткиРезервов(УчетПоПодразделениям, ИспользуетсяКПСРезерва);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПринимаемыеНФАДокумента(ДокументОбъект)
	ПринимаемыеНФА = Новый ТаблицаЗначений;
	ПринимаемыеНФА.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПринимаемыеНФА.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПринимаемыеНФА.Колонки.Добавить("КЭК", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПринимаемыеНФА.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Для Каждого СтрокаДокумента Из ДокументОбъект.ТоварыРаботыУслуги Цикл
		Если СтрокаДокумента.СуммаПринято <> 0 Тогда
			НоваяСтрока = ПринимаемыеНФА.Добавить();
			НоваяСтрока.КФО = СтрокаДокумента.КФО;
			НоваяСтрока.КПС = СтрокаДокумента.КПС;
			НоваяСтрока.КЭК = СтрокаДокумента.КЭК;
			НоваяСтрока.Сумма = СтрокаДокумента.СуммаПринято;
		КонецЕсли;
	КонецЦикла;
	Возврат ПринимаемыеНФА;
КонецФункции

// Получить документ объект.
// 
// Параметры:
//  Документ - ДокументОбъект.АктПриемкиТоваровРаботУслуг -
//         - см. Документ.АктПриемкиТоваровРаботУслуг.Форма.ФормаДокумента.Объект
// 
// Возвращаемое значение:
//  ДокументОбъект.АктПриемкиТоваровРаботУслуг - Получить документ объект
Функция ПолучитьДокументОбъект(Документ)
	Если ТипЗнч(Документ) <> Тип("ДокументОбъект.АктПриемкиТоваровРаботУслуг") Тогда
		//@skip-check using-form-data-to-value
		ДокументОбъект = ДанныеФормыВЗначение(Документ, Тип("ДокументОбъект.АктПриемкиТоваровРаботУслуг")); // ДокументОбъект.АктПриемкиТоваровРаботУслуг
	Иначе
		ДокументОбъект = Документ;
	КонецЕсли;
	Возврат ДокументОбъект;
КонецФункции

// Параметры открытия формы СМР.
// 
// Возвращаемое значение:
//  Структура - Параметры открытия формы СМР:
// * Организация - СправочникСсылка.Организации - 
// * Дата - Дата - 
// * Номер - Строка - 
// * КодОбъектаСтройки - Строка - 
// * ОбъектСМР - Строка - 
// * СтройкаСМР - Строка - 
// * НачалоПериодаСМР - Дата - 
// * ОкончаниеПериодаСМР - Дата - 
// * КонтрагентСтроительныйКонтроль - СправочникСсылка.Контрагенты
// * ПредставительСтроительныйКонтрольФИО - Строка
// * ПредставительСтроительныйКонтрольДолжность - Строка
// * СтроительноМонтажныеРаботы - ТаблицаЗначений - :
// 	** НомерПоСмете - Строка - 
// 	** ЕдиницаИзмерения - СправочникСсылка.КлассификаторЕдиницИзмерения - 
// 	** Количество - Число - 
// 	** Наименование - Строка - 
// 	** НомерРасценки - Строка - 
// 	** Сумма - Число - 
// 	** Цена - Число - 
// * СтоимостьСтроительноМонтажныхРабот - ТаблицаЗначений - :
// 	** Наименование - Строка - 
// 	** Код - Строка - 
// 	** СтавкаНДС - ПеречислениеСсылка.СтавкиНДС - 
// 	** Сумма - Число - 
// 	** СуммаСНачалаГода - Число - 
// 	** СуммаСНачалаРабот - Число - 
// 	** СуммаНДС - Число - 
// 	** СуммаНДССНачалаГода - Число - 
// 	** СуммаНДССНачалаРабот - Число - 
// 	** Всего - Число - 
// 	** ВсегоСНачалаГода - Число - 
// 	** ВсегоСНачалаРабот - Число - 
Функция ПараметрыОткрытияФормыСМР() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Результат.Вставить("Дата", '00010101');
	Результат.Вставить("Номер", "");
	Результат.Вставить("КодОбъектаСтройки", "");
	Результат.Вставить("ОбъектСМР", "");
	Результат.Вставить("СтройкаСМР", "");
	Результат.Вставить("НачалоПериодаСМР", '00010101');
	Результат.Вставить("ОкончаниеПериодаСМР", '00010101');
	Результат.Вставить("КонтрагентСтроительныйКонтроль", Справочники.Контрагенты.ПустаяСсылка());
	Результат.Вставить("ПредставительСтроительныйКонтрольФИО", "");
	Результат.Вставить("ПредставительСтроительныйКонтрольДолжность", "");
	
	СМР = Новый ТаблицаЗначений;
	СМР.Колонки.Добавить("НомерПоСмете", Новый ОписаниеТипов("Строка"));
	СМР.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	СМР.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	СМР.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	СМР.Колонки.Добавить("НомерРасценки", Новый ОписаниеТипов("Строка"));
	СМР.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	СМР.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	Результат.Вставить("СтроительноМонтажныеРаботы", СМР);
	
	СтоимостьСМР = Новый ТаблицаЗначений;
	СтоимостьСМР.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	СтоимостьСМР.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка"));
	СтоимостьСМР.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	СтоимостьСМР.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	СтоимостьСМР.Колонки.Добавить("СуммаСНачалаГода", Новый ОписаниеТипов("Число"));
	СтоимостьСМР.Колонки.Добавить("СуммаСНачалаРабот", Новый ОписаниеТипов("Число"));
	СтоимостьСМР.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число"));
	СтоимостьСМР.Колонки.Добавить("СуммаНДССНачалаГода", Новый ОписаниеТипов("Число"));
	СтоимостьСМР.Колонки.Добавить("СуммаНДССНачалаРабот", Новый ОписаниеТипов("Число"));
	СтоимостьСМР.Колонки.Добавить("Всего", Новый ОписаниеТипов("Число"));
	СтоимостьСМР.Колонки.Добавить("ВсегоСНачалаГода", Новый ОписаниеТипов("Число"));
	СтоимостьСМР.Колонки.Добавить("ВсегоСНачалаРабот", Новый ОписаниеТипов("Число"));
	Результат.Вставить("СтоимостьСтроительноМонтажныхРабот", СтоимостьСМР);
	
	Возврат Результат;
КонецФункции

Процедура ДобавитьТоварыРаботыУслугиИзПоступленийНФА(МатериалыВременная, Документ, ДокументыПоступления)

	ЗапросыНоменклатура = Новый Массив;
	ЗапросыРНПТ = Новый Массив;
	Запрос = Новый Запрос;
	ДокументыПоТипам = ОбщегоНазначенияБГУ.ДокументыПоТипам(ДокументыПоступления);
	ИндексЗапроса = 1;
	Для Каждого ТипДокумента Из ДокументыПоТипам Цикл
		ТекстЗапроса = "";
		ТекстЗапросаРНПТ = "";
		Если ТипДокумента.Ключ = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
			ТекстЗапроса = ЗапросТоварыИУслугиПоступлениеМЗ();
			ТекстЗапросаРНПТ = ЗапросРНПТПоступлениеМЗ();
		ИначеЕсли ТипДокумента.Ключ = Тип("ДокументСсылка.ПоступлениеИК") Тогда
			ТекстЗапроса = ЗапросТоварыИУслугиПоступлениеМЗИК();
		ИначеЕсли ТипДокумента.Ключ = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
			ТекстЗапроса = ЗапросТоварыИУслугиПоступлениеУслугРабот();
			Запрос.УстановитьПараметр("ТипыУслуг", Перечисления.ТипыНоменклатуры.ПолучитьТипыУслугРабот());
		ИначеЕсли ТипДокумента.Ключ = Тип("ДокументСсылка.ПоступлениеУслугРаботПоСчетамУчетаЗатрат") Тогда
			ТекстЗапроса = ЗапросТоварыИУслугиПоступлениеУслугРаботПоСчетамУчетаЗатрат();
			Запрос.УстановитьПараметр("ТипыУслуг", Перечисления.ТипыНоменклатуры.ПолучитьТипыУслугРабот());
		ИначеЕсли ТипДокумента.Ключ = Тип("ДокументСсылка.ПоступлениеОС") Тогда
			ТекстЗапроса = ЗапросТоварыИУслугиПоступлениеОС();
			ТекстЗапросаРНПТ = ЗапросРНПТПоступлениеОС();
		ИначеЕсли ТипДокумента.Ключ = Тип("ДокументСсылка.ПоступлениеОСИК") Тогда
			ТекстЗапроса = ЗапросТоварыИУслугиПоступлениеОСИК();
		ИначеЕсли ТипДокумента.Ключ = Тип("ДокументСсылка.ПриходныйОрдерФондовый") Тогда
			ТекстЗапроса = ЗапросТоварыИУслугиПриходныйОрдерФондовый();
		КонецЕсли;
		Если ТекстЗапроса <> "" Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
					"&ДокументыПоступления",
					"&ДокументыПоступления" + ИндексЗапроса);
			ЗапросыНоменклатура.Добавить(ТекстЗапроса);
			Запрос.УстановитьПараметр("ДокументыПоступления" + ИндексЗапроса, ТипДокумента.Значение);
			Если ТекстЗапросаРНПТ <> "" Тогда
				ТекстЗапросаРНПТ = СтрЗаменить(ТекстЗапросаРНПТ,
						"&ДокументыПоступления",
						"&ДокументыПоступления" + ИндексЗапроса);
				ЗапросыРНПТ.Добавить(ТекстЗапросаРНПТ);
			КонецЕсли;
			ИндексЗапроса = ИндексЗапроса + 1;
		КонецЕсли;
	КонецЦикла;
	
	Счет20135 = БухгалтерскийУчет.СчетПоКоду("201.35", Документ.Дата, Документ.Организация);
	Запрос.УстановитьПараметр("Счет20135", Счет20135);
	Счет40160 = БухгалтерскийУчет.СчетПоКоду("401.60", Документ.Дата, Документ.Организация);
	Запрос.УстановитьПараметр("Счет40160", Счет40160);
	Счета1066х = БухгалтерскийУчет.СписокСчетов("106.60");
	Запрос.УстановитьПараметр("Счета1066х", Счета1066х);
	Счет30226 = БухгалтерскийУчет.СчетПоКоду("302.26", Документ.Дата, Документ.Организация);
	Запрос.УстановитьПараметр("Счет30226", Счет30226);
	Запрос.УстановитьПараметр("КЭК226", БухгалтерскийУчетПовтИсп.КЭКПоКоду("226"));
	Запрос.УстановитьПараметр("КЭК226Код", "226");

	Для Каждого ЗапросРНПТ Из ЗапросыРНПТ Цикл
		ЗапросыНоменклатура.Добавить(ЗапросРНПТ);
	КонецЦикла;
	
	Если ЗапросыНоменклатура.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = СтрСоединить(ЗапросыНоменклатура, ОбщегоНазначения.РазделительПакетаЗапросов());
	Запрос.УстановитьПараметр("ЕдИзмШтуки", Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796"));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Для ИндексЗапроса = 0 По РезультатЗапроса.ВГраница() - ЗапросыРНПТ.Количество() Цикл
		Выборка = РезультатЗапроса[ИндексЗапроса].Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(МатериалыВременная.Добавить(), Выборка);
		КонецЦикла;
	КонецЦикла;

	Для ИндексЗапроса = РезультатЗапроса.ВГраница() - ЗапросыРНПТ.Количество() + 1 По РезультатЗапроса.ВГраница() Цикл
		Выборка = РезультатЗапроса[ИндексЗапроса].Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Документ.СведенияПрослеживаемости.Добавить(), Выборка);
			ЗаполнитьЗначенияСвойств(Документ.СведенияПрослеживаемостиФактические.Добавить(), Выборка);
		КонецЦикла;
	КонецЦикла;
	
	БухгалтерскийУчет.ЗаменитьДетальныйКЭК340_440(МатериалыВременная,
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("КЭК"),
		Документ.Дата,
		Документ.Организация);
	
КонецПроцедуры

// Контрагент по организации.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
// 
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты
Функция КонтрагентПоОрганизации(Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.ИНН,
	|	Организации.РегистрацияВНалоговомОргане.КПП КАК КПП
	|ПОМЕСТИТЬ ИННКППОрганизации
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИННКППОрганизации КАК ИННКППОрганизации
	|		ПО Контрагенты.ИНН = ИННКППОрганизации.ИНН
	|		И Контрагенты.КПП = ИННКППОрганизации.КПП
	|ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|	
	|УПОРЯДОЧИТЬ ПО
	|	Контрагенты.Код";
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

