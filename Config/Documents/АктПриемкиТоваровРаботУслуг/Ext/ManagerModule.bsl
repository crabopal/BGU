Функция ТекстЗапросаСоставКомиссииДляПечати(ЗапросыПакета, ИмяЗапроса)
	ЗапросыПакета.Вставить("Вт" + ЗапросыПакета.Количество(), ЗапросыПакета.Количество());
	ЗапросыПакета.Вставить("Вт" + ЗапросыПакета.Количество(), ЗапросыПакета.Количество());
	ЗапросыПакета.Вставить("Вт" + ЗапросыПакета.Количество(), ЗапросыПакета.Количество());
	ЗапросыПакета.Вставить("Вт" + ЗапросыПакета.Количество(), ЗапросыПакета.Количество());
	ЗапросыПакета.Вставить(ИмяЗапроса, ЗапросыПакета.Количество());
	Возврат
	"ВЫБРАТЬ
	|	АктПриемкиТоваровРаботУслугСоставКомиссии.Ссылка КАК Ссылка,
	|	АктПриемкиТоваровРаботУслугСоставКомиссии.Сотрудник КАК Сотрудник,
	|	АктПриемкиТоваровРаботУслугСоставКомиссии.Ссылка.Дата КАК Дата,
	|	АктПриемкиТоваровРаботУслугСоставКомиссии.Сотрудник.Контрагент.ЮридическоеФизическоеЛицо КАК ФизическоеЛицо,
	|	АктПриемкиТоваровРаботУслугСоставКомиссии.Ссылка.Организация КАК Организация,
	|	АктПриемкиТоваровРаботУслугСоставКомиссии.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ СоставКомиссии
	|ИЗ
	|	Документ.АктПриемкиТоваровРаботУслуг.СоставКомиссии КАК АктПриемкиТоваровРаботУслугСоставКомиссии
	|ГДЕ
	|	АктПриемкиТоваровРаботУслугСоставКомиссии.Ссылка В(&МассивОбъектов)
	|	И Не АктПриемкиТоваровРаботУслугСоставКомиссии.Отсутствует
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.ФизическоеЛицо КАК ФизическоеЛицо,
	|	Т.ДатаФИО КАК ДатаФИО,
	|	ФИОФизическихЛиц.Фамилия КАК Фамилия,
	|	ФИОФизическихЛиц.Имя КАК Имя,
	|	ФИОФизическихЛиц.Отчество КАК Отчество
	|ПОМЕСТИТЬ АктуальныеФИО
	|ИЗ
	|	(ВЫБРАТЬ
	|		СоставКомиссии.Ссылка КАК Ссылка,
	|		СоставКомиссии.ФизическоеЛицо КАК ФизическоеЛицо,
	|		МАКСИМУМ(ФИОФизическихЛиц.Период) КАК ДатаФИО
	|	ИЗ
	|		СоставКомиссии КАК СоставКомиссии
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|			ПО СоставКомиссии.ФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|			И СоставКомиссии.Дата >= ФИОФизическихЛиц.Период
	|	СГРУППИРОВАТЬ ПО
	|		СоставКомиссии.Ссылка,
	|		СоставКомиссии.ФизическоеЛицо) КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО Т.ФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|		И Т.ДатаФИО = ФИОФизическихЛиц.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Сотрудник КАК Сотрудник,
	|	ДанныеСотрудников.Должность КАК Должность
	|ПОМЕСТИТЬ АктуальныеДолжности
	|ИЗ
	|	(ВЫБРАТЬ
	|		СоставКомиссии.Ссылка КАК Ссылка,
	|		МАКСИМУМ(ДанныеСотрудников.Период) КАК ДатаДолжности,
	|		ДанныеСотрудников.Сотрудник КАК Сотрудник,
	|		ДанныеСотрудников.Организация КАК Организация
	|	ИЗ
	|		СоставКомиссии КАК СоставКомиссии
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников КАК ДанныеСотрудников
	|			ПО СоставКомиссии.Сотрудник = ДанныеСотрудников.Сотрудник
	|			И СоставКомиссии.Организация = ДанныеСотрудников.Организация
	|			И СоставКомиссии.Дата >= ДанныеСотрудников.Период
	|	СГРУППИРОВАТЬ ПО
	|		СоставКомиссии.Ссылка,
	|		ДанныеСотрудников.Сотрудник,
	|		ДанныеСотрудников.Организация) КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников КАК ДанныеСотрудников
	|		ПО Т.Сотрудник = ДанныеСотрудников.Сотрудник
	|		И Т.Организация = ДанныеСотрудников.Организация
	|		И Т.ДатаДолжности = ДанныеСотрудников.Период
	|;
	|
