#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	УдалитьДолжностиОтветственныхЛицКонтрагентов();
	
	Если ВидПоставки = Перечисления.ВидыПоставкиТоваровРаботУслуг.НеотфактурованнаяПоставка Тогда
		СуммаДенежногоОбязательства = ДенежныеОбязательства.Итог("Сумма");
	КонецЕсли;
	СуммаДокумента = ТоварыРаботыУслуги.Итог("СуммаПринято");
	Если СпособЗачетаАванса <> Перечисления.СпособыЗачетаАвансов.ПоДокументу Тогда
		ЗачетАвансов.Очистить();
	КонецЕсли;
	Если ВидПоставки <> Перечисления.ВидыПоставкиТоваровРаботУслуг.НеотфактурованнаяПоставка Тогда
		ЗачетАвансов.Очистить();
		ДенежныеОбязательства.Очистить();
	КонецЕсли;
	Если Не РешениеОСозданииКомиссииНеПринято Тогда
		ПричинаОтсутствияКомиссии = "";
	КонецЕсли;
	
	ПрослеживаемостьБГУ.УдалитьНеиспользуемыеСтрокиСведенийПрослеживаемости(ЭтотОбъект, "ТоварыРаботыУслуги", Истина);
	
	ПроводитьДокументыПоступления = (ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДополнительныеСвойства,
			"ПроводитьДокументыПоступленияПриПроведенииАктаПриемкиТРУ") = Истина);
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И Не ПроводитьДокументыПоступления Тогда
		Если Не РегистрыСведений.НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ.ВсеДокументыПоставкиДобавленыВАкт(
				Ссылка, ДокументыПоступления.ВыгрузитьКолонку("ДокументОснование")) Тогда
			ВызватьИсключение(НСтр("ru = 'В документ добавлены не все документы поступления НФА,
				|введенные на основании этого ""Акта приемки товаров, работ, услуг"".
				|Откройте документ и заполните таблицу ""Документ поступления"".'"));
		КонецЕсли;
	ИначеЕсли ПометкаУдаления И ЕстьПроведенныеДокументыПоступления() Тогда
		ВызватьИсключение(НСтр("ru = 'В документ добавлены уже проведенные документы поступления НФА.
			|Перед установкой пометки удаления необходимо отменить проведение документов поступления НФА.'"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
КонецПроцедуры

// Обработка заполнения.
// 
// Параметры:
//  ДанныеЗаполнения - ДокументСсылка.ПоступлениеМЗ
//                   - ДокументСсылка.ПоступлениеОС
//                   - ДокументСсылка.ПоступлениеУслугРабот
//                   - ДокументСсылка.ПоступлениеНФАпоЦС
//  ТекстЗаполнения - Строка, Неопределено - Текст заполнения
//  СтандартнаяОбработка - Булево - Стандартная обработка
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ДанныеЗаполнения))
		И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ДанныеЗаполнения)) Тогда
		ЗаполнитьПоДокументуОснованию(ДанныеЗаполнения);
	Иначе
		ЗаполнениеРеквизитовОбъектов.ЗаполнитьРеквизитыОбъектовПоУмолчаниюОбработкаЗаполнения(ЭтотОбъект,
			ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
		Если Не ЗначениеЗаполнено(Дата) Тогда
			Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
		КонецЕсли;
		ЗаполнитьРуководителя();
		Документы.АктПриемкиТоваровРаботУслуг.УстановитьЗаказчикаПоУмолчанию(ЭтотОбъект);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроводитьДокументыПоступления = (ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		ДополнительныеСвойства,
		"ПроводитьДокументыПоступленияПриПроведенииАктаПриемкиТРУ") = Истина);
	
	Если ПроводитьДокументыПоступления Тогда
		ПровестиДокументыПоступления();
	КонецЕсли;
	
	Для Каждого СтрокаДокументаПоступления Из ДокументыПоступления Цикл
		РегистрыСведений.НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ.УдалитьЗапись(
			СтрокаДокументаПоступления.ДокументОснование);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполнить по документу основанию.
// 
// Параметры:
//  Документ - ДокументСсылка.ПоступлениеМЗ
//           - ДокументСсылка.ПоступлениеОС
//           - ДокументСсылка.ПоступлениеУслугРабот
//           - ДокументСсылка.ПоступлениеНФАпоЦС
Процедура ЗаполнитьПоДокументуОснованию(Документ)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,
		ЗаполнениеРеквизитовОбъектов.ПолучитьЗначенияРеквизитовЗаполнения(Метаданные().ПолноеИмя()));
	
	РеквизитыОснования = Новый Массив; // Массив из Строка
	РеквизитыОснования.Добавить("ИФО");
	РеквизитыОснования.Добавить("Организация");
	РеквизитыОснования.Добавить("Контрагент");
	РеквизитыОснования.Добавить("Договор");
	РеквизитыОснования.Добавить("Подразделение");
	МетаданныеОснования = Документ.Метаданные();
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ВалютаДокумента", МетаданныеОснования) Тогда
		РеквизитыОснования.Добавить("ВалютаДокумента");
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ЦМО", МетаданныеОснования) Тогда
		РеквизитыОснования.Добавить("ЦМО");
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ЗаказчикПоКонтракту", МетаданныеОснования) Тогда
		РеквизитыОснования.Добавить("ЗаказчикПоКонтракту");
	КонецЕсли;
	ДанныеОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, РеквизитыОснования);
	ИФО = ДанныеОснования.ИФО;
	Организация = ДанныеОснования.Организация;
	Контрагент = ДанныеОснования.Контрагент;
	Договор = ДанныеОснования.Договор;
	Подразделение = ДанныеОснования.Подразделение;
	Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	ДанныеОснования.Свойство("ЦМО", ЦМО);
	Если ДанныеОснования.Свойство("ЗаказчикПоКонтракту") И ЗначениеЗаполнено(ДанныеОснования.ЗаказчикПоКонтракту) Тогда
		Заказчик = ДанныеОснования.ЗаказчикПоКонтракту;
	Иначе
		Документы.АктПриемкиТоваровРаботУслуг.УстановитьЗаказчикаПоУмолчанию(ЭтотОбъект);
	КонецЕсли;
	Если ТипЗнч(Документ) <> Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
		Грузоотправитель = Контрагент;
	КонецЕсли;
	ВалютаОснования = Справочники.Валюты.ПустаяСсылка();
	Если ДанныеОснования.Свойство("ВалютаДокумента", ВалютаОснования) Тогда
		ВалютаДокумента = ВалютаОснования;
	Иначе
		ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;	
	Если ЭтоНеотфактурированнаяПоставка(Документ) Тогда
		ВидПоставки = Перечисления.ВидыПоставкиТоваровРаботУслуг.НеотфактурованнаяПоставка;
	Иначе
		ВидПоставки = Перечисления.ВидыПоставкиТоваровРаботУслуг.ПрочаяПоставка;
	КонецЕсли;
	ЗаполнитьРуководителя();
	
	ДокументыПоступления.Очистить();
	ДокументыПоступления.Добавить().ДокументОснование = Документ;
	
	Документы.АктПриемкиТоваровРаботУслуг.ЗаполнитьТоварыРаботыУслуги(ЭтотОбъект);
	Если ВидПоставки = Перечисления.ВидыПоставкиТоваровРаботУслуг.НеотфактурованнаяПоставка Тогда
		Если СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.ПоДокументу Тогда
			Документы.АктПриемкиТоваровРаботУслуг.ЗаполнитьЗачетАвансов(ЭтотОбъект);
		КонецЕсли;
		Документы.АктПриемкиТоваровРаботУслуг.ЗаполнитьДенежныеОбязательства(ЭтотОбъект);
	Иначе
		СуммаДенежногоОбязательства = ТоварыРаботыУслуги.Итог("Всего");
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоНеотфактурированнаяПоставка(Документ)
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ПоступлениеУслугРаботПоСчетамУчетаЗатрат") Тогда
		ВидПоступления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "ВидПоступления");
		Возврат ВидПоступления = Перечисления.ВидыОперацийПоступлениеУслуг.ПоступлениеУслугРезерв;
	Иначе 
		Возврат ЕстьПроводкаПоСчету40160(Документ);
	КонецЕсли;
КонецФункции

Функция ЕстьПроводкаПоСчету40160(Документ)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.Регистратор = &Регистратор
	|	И ЖурналПроводокЕПСБУ.СчетКт В ИЕРАРХИИ (&СчетКт)";
	Запрос.УстановитьПараметр("Регистратор", Документ);
	Запрос.УстановитьПараметр("СчетКт", БухгалтерскийУчет.СчетПоКоду("401.60", Дата, Организация));
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Процедура ЗаполнитьРуководителя()
	
	ОбщегоНазначенияБГУ.ПроверитьИОчиститьРеквизитыПоОрганизации(ЭтотОбъект, "Руководитель");

	Если Не ЗначениеЗаполнено(Руководитель) Тогда
		ЗаполнениеРеквизитовОбъектов.ЗаполнитьПодписанта(ЭтотОбъект, "Руководитель", "Руководитель", Подразделение);
	КонецЕсли;

КонецПроцедуры

Процедура УдалитьДолжностиОтветственныхЛицКонтрагентов()
	ОбрабатываемыеПоля = УправлениеНФАКлиентСервер.ИменаРеквизитовОтветственныхЛицКонтрагентовАктПриемкиТРУ();
	
	ТипОтветственныеЛица = Тип("СправочникСсылка.ОтветственныеЛицаКонтрагентов");
	Для Каждого КлючИЗначение Из ОбрабатываемыеПоля Цикл
		Если ТипЗнч(ЭтотОбъект[КлючИЗначение.Ключ]) = ТипОтветственныеЛица Тогда
			ЭтотОбъект[КлючИЗначение.Значение] = "";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура УстановитьБлокировкуДокументовПоступления()
	ДокументыПоТипам = ОбщегоНазначенияБГУ.ДокументыПоТипам(ДокументыПоступления.ВыгрузитьКолонку("ДокументОснование"));
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Для Каждого СтрокаТипа Из ДокументыПоТипам Цикл
			ПолноеИмяОбъектаМетаданных = Метаданные.НайтиПоТипу(СтрокаТипа.Ключ).ПолноеИмя();
			Для Каждого БлокируемыйДокумент Из СтрокаТипа.Значение Цикл
				ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъектаМетаданных);
				ЭлементБлокировки.УстановитьЗначение("Ссылка", БлокируемыйДокумент);
			КонецЦикла;
		КонецЦикла;
		Блокировка.Заблокировать();
	Исключение
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура ПровестиДокументыПоступления()
	
	Попытка
		УстановитьБлокировкуДокументовПоступления();
	
		ДокументыКПроведению = Документы.АктПриемкиТоваровРаботУслуг.НайтиНепроведенныеДокументыПоставки(ДокументыПоступления.Выгрузить());
		
		Если ДокументыКПроведению.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;

		Для Каждого СсылкаДокумента Из ДокументыКПроведению Цикл
			ДокументПоступления = СсылкаДокумента.ПолучитьОбъект(); // ДокументОбъект
			Если ДокументПоступления = Неопределено Тогда
				// Битая ссылка
				ВызватьИсключение(НСтр("ru = 'Выбран отсутствующий документ поступления'"),
					КатегорияОшибки.ОшибкаХранимыхДанных);
			КонецЕсли;
			ДокументПоступления.Заблокировать();
			ДокументПоступления.Записать(РежимЗаписиДокумента.Проведение);
		КонецЦикла;
	
	Исключение
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'При проведении документов поступления ""Акта приемки товаров, работ, услуг"" произошла ошибка:
			|%1'"), ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Данные. Изменение'", ОбщегоНазначения.КодОсновногоЯзыка()),			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция ЕстьПроведенныеДокументыПоступления()
	Попытка
		УстановитьБлокировкуДокументовПоступления();
	
		ПроведенныеДокументы = Документы.АктПриемкиТоваровРаботУслуг.ПолучитьДокументыПоступленияПоУсловиям(
			ДокументыПоступления.Выгрузить(),
			Новый Структура("Проведен, ПервичныйДокумент", Истина, ПервичныеДокументыБГУ.ПервичныйДокументАктПриемкиТРУ()));
		Возврат ПроведенныеДокументы.Количество() > 0;	
	Исключение
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'При установке пометки удаления ""Акта приемки товаров, работ, услуг"" произошла ошибка:
			|%1'"), ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Данные. Изменение'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		ВызватьИсключение;
	КонецПопытки
КонецФункции

#КонецОбласти

#КонецЕсли