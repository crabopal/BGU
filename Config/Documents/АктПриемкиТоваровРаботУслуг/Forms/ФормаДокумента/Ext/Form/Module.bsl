&НаКлиенте
Процедура ФИОКонтактногоЛицаНачалоВыбора(Элемент, СтандартнаяОбработка)
	ПараметрыДляВыбора = УправлениеНФАКлиент.ПараметрыВыбораФИОКонтактногоЛицаАктПриемкиТРУ(ЭтотОбъект);
	ПараметрыДляВыбора.ДопустимыеТипы = ДопустимыеТипыЭлементаФормы(Элемент);
	ПараметрыДляВыбора.РеквизитКонтрагент = УправлениеНФАКлиентСервер.ИмяЭлементаВладелецОтветственногоЛица(
		Элемент.Имя);
	Если ПараметрыДляВыбора.РеквизитКонтрагент <> "" Тогда
		ПараметрыДляВыбора.Контрагент = Объект[ПараметрыДляВыбора.РеквизитКонтрагент];
	КонецЕсли;
	ПараметрыДляВыбора.ИзменениеСвязиПараметровВыбора =
		Новый ОписаниеОповещения("ИзменитьСвязиПараметровВыбораОтветственногоЛица",
			ЭтотОбъект, Новый Структура("ИмяЭлемента", Элемент.Имя));
	УправлениеНФАКлиент.НачатьВыборФИОКонтактногоЛицаАктПриемкиТРУ(Элемент, ПараметрыДляВыбора, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Функция ДопустимыеТипыЭлементаФормы(Элемент)
	ТипыДанных = Новый СписокЗначений;
	Если Элемент = Элементы.ПредставительЗаказчикаФИО
			Или Элемент = Элементы.РуководительЗаказчикаФИО Тогда
		ТипыДанных.Добавить(Тип("Строка"), НСтр("ru = 'Ввести вручную'"));
		Если Не ЗначениеЗаполнено(Объект.Заказчик) Или Объект.Заказчик = КонтрагентПоОрганизации Тогда
			ТипыДанных.Добавить(Тип("СправочникСсылка.Сотрудники"), НСтр("ru = 'Выбрать сотрудника'"));
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.Заказчик) Тогда
			ТипыДанных.Добавить(Тип("СправочникСсылка.ОтветственныеЛицаКонтрагентов"),
				НСтр("ru = 'Выбрать ответственное лицо'"));
		КонецЕсли;
	ИначеЕсли Элемент = Элементы.ПредставительПоставщикаФИО Тогда
		ТипыДанных.Добавить(Тип("Строка"), НСтр("ru = 'Ввести вручную'"));
		ТипыДанных.Добавить(Тип("СправочникСсылка.ОтветственныеЛицаКонтрагентов"),
			НСтр("ru = 'Выбрать ответственное лицо'"));
	КонецЕсли;
	Возврат ТипыДанных;
КонецФункции

&НаКлиенте
Процедура ОбработкаВыбораСотрудника(ВыбранноеЗначение, ФИО, Должность, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Сотрудники")
			И ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеСотрудника = ДанныеСотрудника(ВыбранноеЗначение, Объект.Дата);
		ФИО = ДанныеСотрудника.НаименованиеПолное;
		Если ЗначениеЗаполнено(ДанныеСотрудника.Должность) Тогда
			Должность = ДанныеСотрудника.Должность;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыВыбораОтветственногоЛица(Элемент)
	ПараметрыДляФормыВыбора = УправлениеНФАКлиент.ПараметрыУстановкиСвойстваПараметрыВыбораОтветственногоЛица();
	ПараметрыДляФормыВыбора.ЗначениеРеквизита = Объект[Элемент.Имя];
	ПараметрыДляФормыВыбора.РеквизитКонтрагент = УправлениеНФАКлиентСервер.ИмяЭлементаВладелецОтветственногоЛица(
		Элемент.Имя);
	ПараметрыДляФормыВыбора.РодительскийРеквизит = "Объект";
	ПараметрыДляФормыВыбора.Организация = "Организация";
	ПараметрыДляФормыВыбора.ИзменениеСвязиПараметровВыбора =
		Новый ОписаниеОповещения("ИзменитьСвязиПараметровВыбораОтветственногоЛица",
			ЭтотОбъект, Новый Структура("ИмяЭлемента", Элемент.Имя));
	УправлениеНФАКлиент.УстановитьПараметрыВыбораВСвойстваЭлементаОтветственногоЛица(Элемент, ПараметрыДляФормыВыбора);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДолжностьОтветственногоЛица(ИмяРеквизитаФИО)
	ОтветственноеЛицо = Объект[ИмяРеквизитаФИО];
	Если ЗначениеЗаполнено(ОтветственноеЛицо)
			И ТипЗнч(ОтветственноеЛицо) = Тип("СправочникСсылка.ОтветственныеЛицаКонтрагентов") Тогда
		ИмяРеквизитаДолжность = ИмяРеквизитаДолжность(ИмяРеквизитаФИО);
		Если ЗначениеЗаполнено(ИмяРеквизитаДолжность) Тогда
			Объект[ИмяРеквизитаДолжность] = ДолжностьОтветственногоЛица(ОтветственноеЛицо);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДолжностьОтветственногоЛица(ОтветственноеЛицо)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтветственноеЛицо, "Должность");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяРеквизитаДолжность(ИмяРеквизитаФИО)
	Если СтрЗаканчиваетсяНа(ИмяРеквизитаФИО, "ФИО") Тогда
		Возврат Лев(ИмяРеквизитаФИО, СтрДлина(ИмяРеквизитаФИО) - 3) + "Должность";
	КонецЕсли;
	Возврат "";
КонецФункции

&НаСервере
Процедура ЗаполнитьДолжностиОтветственныхЛиц()
	ИменаРеквизитов = УправлениеНФАКлиентСервер.ИменаРеквизитовОтветственныхЛицКонтрагентовАктПриемкиТРУ();
	СсылкиОтветственныхЛиц = Новый Массив; // Массив из СправочникСсылка.ОтветственныеЛицаКонтрагентов
	ТипОтветственныеЛица = Тип("СправочникСсылка.ОтветственныеЛицаКонтрагентов");
	Для Каждого КлючИЗначение Из ИменаРеквизитов Цикл
		ПроверяемоеЗначение = Объект[КлючИЗначение.Ключ]; 
		Если ЗначениеЗаполнено(ПроверяемоеЗначение) И ТипЗнч(ПроверяемоеЗначение) = ТипОтветственныеЛица Тогда
			СсылкиОтветственныхЛиц.Добавить(ПроверяемоеЗначение);
		КонецЕсли;
	КонецЦикла;
	Если СсылкиОтветственныхЛиц.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОтветственныхЛиц = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(СсылкиОтветственныхЛиц, "Должность");
	Для Каждого КлючИЗначение Из ИменаРеквизитов Цикл
		ПрочитанноеЗначение = ДанныеОтветственныхЛиц.Получить(Объект[КлючИЗначение.Ключ]); 
		Если ПрочитанноеЗначение <> Неопределено Тогда
			Объект[КлючИЗначение.Значение] = ПрочитанноеЗначение.Должность;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеВыбораПоляВводаДолжность(Текст, ДанныеВыбора, СтандартнаяОбработка)
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ПараметрыВыбораДолжности = Новый Структура;
	ПараметрыВыбораДолжности.Вставить("СтрокаПоиска", Текст);
	ПараметрыВыбораДолжности.Вставить("СпособПоискаСтроки", СпособПоискаСтрокиПриВводеПоСтроке.ЛюбаяЧасть);
	ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.Должности"), ПараметрыВыбораДолжности);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеВыбораПоляВводаСотрудника(Текст, ДанныеВыбора, СтандартнаяОбработка)
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	ПараметрыВыбораСотрудника = Новый Структура;
	ПараметрыВыбораСотрудника.Вставить("Отбор", Новый Структура);
	ПараметрыВыбораСотрудника.Вставить("СтрокаПоиска", Текст);
	ПараметрыВыбораСотрудника.Отбор.Вставить("Владелец", Объект.Организация);
	ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.Сотрудники"), ПараметрыВыбораСотрудника);
	Если ДанныеВыбора.Количество() <> 0 Тогда
		СтандартнаяОбработка = Ложь;
	Иначе
		ДанныеВыбора = Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеСотрудника(Знач Сотрудник, Знач Дата)
	Возврат Справочники.Сотрудники.ДанныеСотрудника(Сотрудник, "Должность, НаименованиеПолное", Дата);
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеНоменклатуры(Знач Номенклатура)
	Результат = Новый Структура;
	Результат.Вставить("ЕдиницаИзмерения", Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
	Результат.Вставить("ЭтоУслуга", Ложь);
	Результат.Вставить("КодТовара", Справочники.ОбщероссийскийКлассификаторПродукции.ПустаяСсылка());
	
	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		ИменаРеквизитов = Новый Структура("КодТовара, ТипНоменклатуры, ЕдиницаИзмерения", "ОКП");
		ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, ИменаРеквизитов);
	ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ДенежныеДокументы") Тогда
		ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "ЕдиницаИзмерения");
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Результат, ДанныеНоменклатуры);
	Если ДанныеНоменклатуры.Свойство("ТипНоменклатуры") Тогда
		Результат.ЭтоУслуга = Перечисления.ТипыНоменклатуры.ПолучитьТипыУслугРабот().Найти(
			ДанныеНоменклатуры.ТипНоменклатуры) <> Неопределено;
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ЗаполнитьДополнительныеРеквизитыСтрок()
	ЗаполнитьЗаголовкиСтрок();
	ЗаполнитьПредставленияРНПТ();
	ЗаполнитьДополнительныеРеквизитыНоменклатурыВоВсехСтроках();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеРеквизитыНоменклатурыВоВсехСтроках()
	ВсяНоменклатура = Новый Массив; // Массив из СправочникСсылка.Номенклатура
	Для Каждого Строка Из Объект.ТоварыРаботыУслуги Цикл
		Если ТипЗнч(Строка.Номенклатура) = Тип("СправочникСсылка.Номенклатура")
				И ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			ВсяНоменклатура.Добавить(Строка.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	ВсеУслуги = Новый Соответствие;
	Если ВсяНоменклатура.Количество() = 0 Тогда
		РеквизитыНоменклатуры = Новый Соответствие;
	Иначе
		Для Каждого Значение Из Перечисления.ТипыНоменклатуры.ПолучитьТипыУслугРабот() Цикл 
			ВсеУслуги.Вставить(Значение, Истина);
		КонецЦикла;
		РеквизитыНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ВсяНоменклатура, "ТипНоменклатуры");
	КонецЕсли;
	ТипБулево = Новый ОписаниеТипов("Булево");
	Для Каждого Строка Из Объект.ТоварыРаботыУслуги Цикл
		Строка.ЭтоУслуга =
			ТипБулево.ПривестиЗначение(ВсеУслуги.Получить(РеквизитыНоменклатуры.Получить(Строка.Номенклатура)));
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПослеРедактированияСМР(Результат, ДополнительныеПараметры) Экспорт
	Если Не ЭтоАдресВременногоХранилища(Результат) Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьДанныеСМР(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСМР(АдресВременногоХранилища)
	Данные = ПолучитьИзВременногоХранилища(АдресВременногоХранилища); // см. Документы.АктПриемкиТоваровРаботУслуг.ПараметрыОткрытияФормыСМР
	Модифицированность = Истина;
	ЗаполнитьЗначенияСвойств(Объект, Данные,
		"СтройкаСМР,
		|КодОбъектаСтройки,
		|ОбъектСМР,
		|НачалоПериодаСМР,
		|ОкончаниеПериодаСМР,
		|КонтрагентСтроительныйКонтроль,
		|ПредставительСтроительныйКонтрольФИО,
		|ПредставительСтроительныйКонтрольДолжность");

	Объект.СтроительноМонтажныеРаботы.Очистить();
	Для Каждого СтрокаСМР Из Данные.СтроительноМонтажныеРаботы Цикл
		ЗаполнитьЗначенияСвойств(Объект.СтроительноМонтажныеРаботы.Добавить(), СтрокаСМР);
	КонецЦикла;
	
	Объект.СтоимостьСтроительноМонтажныхРабот.Очистить();
	Для Каждого СтрокаСтоимостиСМР Из Данные.СтоимостьСтроительноМонтажныхРабот Цикл
		ЗаполнитьЗначенияСвойств(Объект.СтоимостьСтроительноМонтажныхРабот.Добавить(), СтрокаСтоимостиСМР);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СохранитьДанныеСМР()
	Данные = Документы.АктПриемкиТоваровРаботУслуг.ПараметрыОткрытияФормыСМР();
	ЗаполнитьЗначенияСвойств(Данные, Объект,
		"СтройкаСМР,
		|КодОбъектаСтройки,
		|ОбъектСМР,
		|НачалоПериодаСМР,
		|ОкончаниеПериодаСМР,
		|Организация,
		|Дата,
		|Номер,
		|КонтрагентСтроительныйКонтроль,
		|ПредставительСтроительныйКонтрольФИО,
		|ПредставительСтроительныйКонтрольДолжность");
	Для Каждого СтрокаСМР Из Объект.СтроительноМонтажныеРаботы Цикл
		ЗаполнитьЗначенияСвойств(Данные.СтроительноМонтажныеРаботы.Добавить(), СтрокаСМР);
	КонецЦикла;
	
	Для Каждого СтрокаСтоимостиСМР Из Объект.СтоимостьСтроительноМонтажныхРабот Цикл
		ЗаполнитьЗначенияСвойств(Данные.СтоимостьСтроительноМонтажныхРабот.Добавить(), СтрокаСтоимостиСМР);
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор,
		"ВестиГрафикПлатежей,ВестиПланГрафикИсполнения"); 
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиГрафикПлатежей",
		?(РеквизитыДоговора.ВестиГрафикПлатежей = Истина, Истина, Ложь));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиПланГрафикИсполнения",
		?(РеквизитыДоговора.ВестиПланГрафикИсполнения = Истина, Истина, Ложь));
	
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьВидимостьЭлементов(ЭтотОбъект,
		ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров,
		ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей);
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьДоступностьОплатитьДо(ЭтотОбъект,
		Объект.ЗапланироватьОплату);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПодборДокументовПоступления(ЗакрыватьПриВыборе = Истина)
	
	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,НСтр("ru = 'Организация'")),,,
			"Объект.Организация", Отказ);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Договор) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,НСтр("ru = 'Договор'")),,,
			"Объект.Договор", Отказ);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ВидПоставки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,НСтр("ru = 'Вид поставки'")),,,
			"Объект.ВидПоставки", Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ОбработчикОкончанияПодбора = Новый ОписаниеОповещения("ПриОкончанииПодбора", ЭтотОбъект);
	
	ЕстьДобавленыйДокумент = Ложь;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("Договор", Объект.Договор);
	ПараметрыФормы.Вставить("ВидПоставки", Объект.ВидПоставки);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", ЗакрыватьПриВыборе);
	ОткрытьФорму("Документ.АктПриемкиТоваровРаботУслуг.Форма.ФормаВыбораДокументовПоставки",
		ПараметрыФормы,
		ЭтотОбъект,
		,
		,
		,
		ОбработчикОкончанияПодбора,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаОбИзмененииВидаПоставки(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ВидПоставки = ВыбранныйВидПоставки;
	Модифицированность = Истина;
	ВидПоставкиПриИзмененииНаКлиенте();
КонецПроцедуры

&НаСервере
Процедура ВидПоставкиПриИзмененииНаСервере()
	Объект.ДокументыПоступления.Очистить();
	Объект.ТоварыРаботыУслуги.Очистить();
	Объект.ТранспортировкаИПриемка.Очистить();
	Объект.СведенияОбУпаковке.Очистить();
	Объект.СоставУпаковок.Очистить();
	Объект.СведенияПрослеживаемости.Очистить();
	Объект.СведенияПрослеживаемостиФактические.Очистить();
	Объект.ЗачетАвансов.Очистить();
	Объект.ДенежныеОбязательства.Очистить();
	
	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	ОбщегоНазначенияБГУ.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект, Объект);
КонецПроцедуры

&НаКлиенте
Процедура ВидПоставкиПриИзмененииНаКлиенте()
	ВидПоставкиПриИзмененииНаСервере();
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	БухгалтерскиеОперацииКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПриОкончанииПодбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЕстьДобавленыйДокумент Тогда
		ЕстьДобавленыйДокумент = Ложь;
		ОбработчикПослеОтвета = Новый ОписаниеОповещения("ПослеОтветаОЗаполненииДокумента", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Были добавлены документы поступления.
			|Заполнить документ по выбранным документам поступления (введенные расхождения будут очищены)?'");
		ПоказатьВопрос(ОбработчикПослеОтвета, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораДокументовПоступления(ВыбранноеЗначение)
	НовыеДокументы = Новый Массив;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		Для Каждого ПереданныйДокумент Из ВыбранноеЗначение Цикл
			Если ТипЗнч(ПереданныйДокумент) = Тип("Структура") Тогда
				НовыеДокументы.Добавить(ПереданныйДокумент.Ссылка);
			Иначе
				НовыеДокументы.Добавить(ПереданныйДокумент);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
			НовыеДокументы.Добавить(ВыбранноеЗначение.Ссылка);
		Иначе
			НовыеДокументы.Добавить(ВыбранноеЗначение);
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрокаДокумента Из Объект.ДокументыПоступления Цикл
		ИндексНайденного = НовыеДокументы.Найти(СтрокаДокумента.ДокументОснование);
		Если ИндексНайденного <> Неопределено Тогда
			НовыеДокументы.Удалить(ИндексНайденного);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ДобавляемыйДокумент Из НовыеДокументы Цикл
		НоваяСтрока = Объект.ДокументыПоступления.Добавить();
		Если ТипЗнч(ДобавляемыйДокумент) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДобавляемыйДокумент);
			НоваяСтрока.ДокументОснование = ДобавляемыйДокумент.Ссылка;
		Иначе
			НоваяСтрока.ДокументОснование = ДобавляемыйДокумент;
		КонецЕсли;
		ЕстьДобавленыйДокумент = Истина;
	КонецЦикла;
	
	Если ВводДоступен() Тогда
		ПриОкончанииПодбора(, );
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект = Форма.Объект;
	
	НеотфактурованнаяПоставка = (Объект.ВидПоставки
		= ПредопределенноеЗначение("Перечисление.ВидыПоставкиТоваровРаботУслуг.НеотфактурованнаяПоставка"));
	
	ИменаЭлементовНеотфактурованнаяПоставка = Новый Массив;
	ИменаЭлементовНеотфактурованнаяПоставка.Добавить("ДенежныеОбязательстваИтогСумма");
	ИменаЭлементовНеотфактурованнаяПоставка.Добавить("Расчеты");
	ИменаЭлементовНеотфактурованнаяПоставка.Добавить("ЗачетАвансовЗаполнитьАвансы");
	ИменаЭлементовНеотфактурованнаяПоставка.Добавить("СпособЗачетаАванса");
	ИменаЭлементовНеотфактурованнаяПоставка.Добавить("ДенежныеОбязательства");
	ИменаЭлементовНеотфактурованнаяПоставка.Добавить("ДенежныеОбязательстваЗаполнитьДО");
	
	ИменаЭлементовПрочаяПоставка = Новый Массив;
	ИменаЭлементовПрочаяПоставка.Добавить("СуммаДенежногоОбязательства");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ИменаЭлементовНеотфактурованнаяПоставка,
		"Видимость",
		НеотфактурованнаяПоставка);
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ИменаЭлементовПрочаяПоставка,
		"Видимость",
		Не НеотфактурованнаяПоставка);
	
	ВидимостьЗачетАвансов = НеотфактурованнаяПоставка
		И Объект.СпособЗачетаАванса = ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.ПоДокументу");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЗачетАвансов",
		"Видимость", ВидимостьЗачетАвансов);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Комиссия",
		"Видимость", Не Объект.РешениеОСозданииКомиссииНеПринято);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СоставКомиссии",
		"Видимость", Не Объект.РешениеОСозданииКомиссииНеПринято);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ПричинаОтсутствияКомиссии",
		"Видимость", Объект.РешениеОСозданииКомиссииНеПринято);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияПредупреждениеОНеобходимостиОбновленияДокумента",
		"Видимость",
		Форма.ЕстьНеДобавленныеДокументыПоставки);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвойстваЭлементовОтветственныхЛицКонтрагентов(Форма)
	УправлениеНФАКлиентСервер.УстановитьСвойстваЭлементовОтветственныхЛицКонтрагентовАктПриемкиТРУ(Форма, Форма.Объект);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьАвансыНаСервере()
	Документы.АктПриемкиТоваровРаботУслуг.ЗаполнитьЗачетАвансов(Объект);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДОНаСервере()
	Документы.АктПриемкиТоваровРаботУслуг.ЗаполнитьДенежныеОбязательства(Объект);
КонецПроцедуры

&НаСервере
Процедура РНПТОчисткаНаСервере(ИдентификаторСтрокиОбъекта, ПолеРНПТ, СведенияПрослеживаемости)
	ТекущиеДанные = Объект.ТоварыРаботыУслуги.НайтиПоИдентификатору(ИдентификаторСтрокиОбъекта);
	Если Не ТекущиеДанные.ПрослеживаемыйТовар Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиСРНПТ = Объект[СведенияПрослеживаемости].НайтиСтроки(
		Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки));
	
	Для Каждого СтрокаСРНПТ Из СтрокиСРНПТ Цикл
		Объект[СведенияПрослеживаемости].Удалить(СтрокаСРНПТ);
	КонецЦикла;
	
	ТекущиеДанные[ПолеРНПТ] = "";
	ПроверитьИУстановитьЗначениеЕстьРасхождения(ТекущиеДанные, Объект);
КонецПроцедуры

&НаКлиенте
Процедура РНПТВыбор(ИмяТабличнойЧасти, Поле, РНПТ, СведенияПрослеживаемости, СтандартнаяОбработка)
	ТекущиеДанные = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	Если СтрЗаканчиваетсяНа(Поле.Имя, "РНПТ") Тогда
		Если ТекущиеДанные.ПрослеживаемыйТовар Тогда
			ОткрытьПодборРНПТ(ИмяТабличнойЧасти, СведенияПрослеживаемости, РНПТ);
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	ИначеЕсли СтрЗаканчиваетсяНа(Поле.Имя, "ПрослеживаемыйТовар") Тогда
		Если ТекущиеДанные.ПрослеживаемыйТовар Тогда
			ПрослеживаемостьФормыБГУКлиент.ПоказатьПредупреждениеПрослеживаемыйТовар();
		Конецесли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПодборРНПТ(ИмяТаблицыПодбора, СведенияПрослеживаемости, КолонкаРНПТ)
	
	ТекущиеДанные = Элементы[ИмяТаблицыПодбора].ТекущиеДанные;
	Если Не ТекущиеДанные.ПрослеживаемыйТовар Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТаблицыДляПодбораРНПТ = ИмяТаблицыПодбора;
	
	ПараметрыПодбора = ПрослеживаемостьФормыБГУКлиент.ПараметрыОткрытияФормыПодбораРНПТ("ТоварыРаботыУслуги");
	ПараметрыПодбора.ЭтоПоступление = Истина;
	СтруктураПараметров = ПрослеживаемостьФормыБГУКлиент.ПараметрыОткрытияФормыПодбораРНПТОС();
	СтруктураПараметров.Организация = Объект.Организация;
	СтруктураПараметров.Номенклатура = ТекущиеДанные.Номенклатура;
	СтруктураПараметров.Период = Объект.Дата;
	СтруктураПараметров.ВыборПоОстаткам = НЕ ПараметрыПодбора.ЭтоПоступление;
	СтруктураПараметров.ДатаТекущегоДокумента = Объект.Дата;
	СтруктураПараметров.ТекущийДокумент = Объект.Ссылка;
	СтруктураПараметров.Количество = ТекущиеДанные.Количество;

	ИмяТаблицыПрослеживаемости = СведенияПрослеживаемости;
	ИмяТаблицыДляПодбораРНПТ = ИмяТаблицыПодбора;
	ИмяКолонкиРНПТ = КолонкаРНПТ;
	АдресТаблицыРНПТВХранилище = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	ПоместитьРНПТВХранилищеНаСервере(АдресТаблицыРНПТВХранилище,
		ТекущиеДанные.ИдентификаторСтроки,
		ИмяТаблицыПрослеживаемости);
	СтруктураПараметров.Вставить("АдресТаблицыРНПТВХранилище", АдресТаблицыРНПТВХранилище);
	СтруктураПараметров.Вставить("ЭтоПоступление", ПараметрыПодбора.ЭтоПоступление);
	
	ОткрытьФорму("Справочник.НомераГТД.Форма." + ПараметрыПодбора.ИмяФормыПодбора, СтруктураПараметров, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РасчитатьСтроку(СтрокаТЧ, ИмяРеквизита)
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", Ложь);
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	РассчитатьСуммыОтклонений(СтрокаТЧ);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьПринятоеКоличество(Строка, ИмяРеквизита, Объект)
	Если ИмяРеквизита = "КоличествоПринято"
		Или ИмяРеквизита = "Количество" Тогда
		Строка.КоличествоОтклонениеПоОбъему = Строка.Количество - Строка.КоличествоПринято;
	ИначеЕсли ИмяРеквизита = "КоличествоОтклонениеПоОбъему" Тогда
		Строка.КоличествоПринято = Строка.Количество - Строка.КоличествоОтклонениеПоОбъему;
	КонецЕсли;
	Если Строка.КоличествоОтклонениеПоОбъему > 0 Тогда
		Строка.КоличествоНедостача = Строка.КоличествоОтклонениеПоОбъему;
		Строка.КоличествоИзлишки = 0;
	ИначеЕсли Строка.КоличествоОтклонениеПоОбъему < 0 Тогда
		Строка.КоличествоНедостача = 0;
		Строка.КоличествоИзлишки = - Строка.КоличествоОтклонениеПоОбъему;
	Иначе
		Строка.КоличествоНедостача = 0;
		Строка.КоличествоИзлишки = 0;
	КонецЕсли;
	
	Если Строка.КоличествоОтклонениеПоОбъему < 0 Тогда
		Строка.КоличествоОтклонение = - Строка.КоличествоОтклонениеПоОбъему + Строка.КоличествоПринятоНеСоответствующие;
	Иначе
		Строка.КоличествоОтклонение = Строка.КоличествоОтклонениеПоОбъему + Строка.КоличествоПринятоНеСоответствующие;
	КонецЕсли;
	РассчитатьСуммыОтклонений(Строка);
	ПроверитьИУстановитьЗначениеЕстьРасхождения(Строка, Объект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммыОтклонений(Строка)
	Если Строка.Количество = 0 Тогда
		Возврат;
	КонецЕсли;
	Строка.СуммаПринято = Строка.КоличествоПринято * Строка.Всего / Строка.Количество;
	Строка.СуммаОтклонение = Строка.КоличествоОтклонение * Строка.Всего / Строка.Количество;
	Строка.СуммаБрак = Строка.КоличествоБрак * Строка.Всего / Строка.Количество;
	Строка.СуммаИзлишки = Строка.КоличествоИзлишки * Строка.Всего / Строка.Количество;
	Строка.СуммаНедостача = Строка.КоличествоНедостача * Строка.Всего / Строка.Количество;
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияКоличествоОтклонениеПоОбъему(Строка, Отказ)
	Если Строка.Количество - Строка.КоличествоПринято <> Строка.КоличествоОтклонениеПоОбъему Тогда
		РасчетноеКоличество = Строка.Количество - Строка.КоличествоПринято;
		ТекстРасчетноеКоличество = СтрШаблон(НСтр("ru = 'Расчетное количество: %1 (гр. 8) - %2 (гр. 16) = %3.'"),
			Формат(Строка.Количество, "ЧДЦ=3; ЧН=0;"),
			Формат(Строка.КоличествоПринято, "ЧДЦ=3; ЧН=0;"),
			Формат(РасчетноеКоличество, "ЧДЦ=3; ЧН=0;"));
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Колонка",
			"Корректность",
			НСтр("ru = 'Отклонение по количеству (объему)'"),
			Строка.НомерСтроки,
			НСтр("ru = 'Приемка товаров, работ, услуг'"),
			ТекстРасчетноеКоличество);
		ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТоварыРаботыУслуги",
			Строка.НомерСтроки,
			"КоличествоОтклонениеПоОбъему");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , ПутьКПолю, "Объект", Отказ);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияКоличествоОтклонение(Строка, Отказ)
	КоличествоОтклонениеПоОбъему = БухгалтерскийУчетКлиентСервер.МодульЧисла(Строка.КоличествоОтклонениеПоОбъему);
	КоличествоОтклонение = Строка.КоличествоПринятоНеСоответствующие + КоличествоОтклонениеПоОбъему;
	Если КоличествоОтклонение <> Строка.КоличествоОтклонение Тогда
		ТекстОшибкаРасхождения = СтрШаблон(НСтр("ru = 'Расчетное количество отклонений: %1 (гр. 17 разд. 4) + %2 (гр. 18 разд. 4) = %3'"),
			Формат(Строка.КоличествоПринятоНеСоответствующие, "ЧДЦ=3; ЧН=0;"),
			Формат(КоличествоОтклонениеПоОбъему, "ЧДЦ=3; ЧН=0;"),
			Формат(КоличествоОтклонение, "ЧДЦ=3; ЧН=0;"));
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Колонка",
			"Корректность",
			НСтр("ru = 'Количество отклонений'"),
			Строка.НомерСтроки,
			НСтр("ru = 'Расхождения'"),
			ТекстОшибкаРасхождения);
		ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТоварыРаботыУслуги",
			Строка.НомерСтроки,
			"КоличествоОтклонение");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , ПутьКПолю, "Объект", Отказ);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияКоличествоНесоответствующие(Строка, Отказ)
	Если Строка.КоличествоПринятоНеСоответствующие = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПричинаУказана = ЗначениеЗаполнено(Строка.КоличествоБрак)
		Или ЗначениеЗаполнено(Строка.СтранаПроисхожденияПринято)
		Или ЗначениеЗаполнено(Строка.НесоответствиеТребованиям)
		Или ЗначениеЗаполнено(Строка.ОтклонениеПрочее)
		Или ЕстьРазличияВРНПТ(Объект, Строка);
		
	Если ПричинаУказана Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибкиНеСоответствующие = НСтр("ru = 'В разделе 4 указано количество не соответствующих качеству товаров, работ, услуг, но не указаны отклонения по качеству в разделе 5'");
	ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
		"Колонка",
		"Корректность",
		НСтр("ru = 'Количество принято не соответствующие'"),
		Строка.НомерСтроки,
		НСтр("ru = 'Приемка товаров, работ, услуг'"),
		ТекстОшибкиНеСоответствующие);
	ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТоварыРаботыУслуги",
		Строка.НомерСтроки,
		"КоличествоПринятоНеСоответствующие");
	ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , ПутьКПолю, "Объект", Отказ);
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкаЗаполненияЕстьРасхождение(Строка, Отказ)
	Если Строка.ЕстьРасхождения И Строка.КоличествоПринятоНеСоответствующие = 0 И Строка.КоличествоОтклонениеПоОбъему = 0 Тогда
		ТекстОшибкиЕстьРасхождения = НСтр("ru = 'В строке указаны расхождения, но не заполнено количество отклонений и количество принятых, не соответствующих качеству'");
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Колонка",
			"Корректность",
			НСтр("ru = 'Количество принято не соответствующие'"),
			Строка.НомерСтроки,
			НСтр("ru = 'Приемка товаров, работ, услуг'"),
			ТекстОшибкиЕстьРасхождения);
		ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТоварыРаботыУслуги",
			Строка.НомерСтроки,
			"КоличествоПринятоНеСоответствующие");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , ПутьКПолю, "Объект", Отказ);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияСтранаПроисхожденияПринято(Строка, Отказ)
	Если ЗначениеЗаполнено(Строка.СтранаПроисхожденияПринято)
		И Строка.СтранаПроисхожденияПринято = Строка.СтранаПроисхождения Тогда
		
		ТекстОшибкиСтрана = НСтр("ru = 'Страна происхождения в расхождениях указывается только в случае расхождений со страной происхождения по документам.'");
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Колонка",
			"Корректность",
			НСтр("ru = 'Страна присхождения'"),
			Строка.НомерСтроки,
			НСтр("ru = 'Расхождения'"),
			ТекстОшибкиСтрана);
		ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ТоварыРаботыУслуги",
			Строка.НомерСтроки,
			"СтранаПроисхожденияПринято");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , ПутьКПолю, "Объект", Отказ);
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхЭлементов(Форма)

	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ЦМО");
	ИменаЭлементов.Добавить("Подразделение");
	ИменаЭлементов.Добавить("ОтветственныйИсполнитель");
	ИменаЭлементов.Добавить("Руководитель");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Доступность", ЗначениеЗаполнено(Форма.Объект.Организация));

КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	УстановитьРуководителя();
	УстановитьДоступностьСвязанныхЭлементов(ЭтотОбъект);
	ВидимостьЭлементовЭДО = ВидимостьЭлементовЭДО(Объект.Контрагент, Объект.Организация);
	Если Параметры.Ключ.Пустая() И ВидимостьЭлементовЭДО Тогда
		Объект.ЭтоЭлектронныйДокумент = Истина;
	КонецЕсли;
	УстановитьВидимостьЭлементовЭДО(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура УстановитьПолеКонтрагентПоОрганизации()
	КонтрагентПоОрганизации = Документы.АктПриемкиТоваровРаботУслуг.КонтрагентПоОрганизации(Объект.Организация);
КонецПроцедуры

&НаСервере
Процедура УстановитьРуководителя()

	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"), Объект.Организация,
			Объект.Дата, Объект.Подразделение);
	
		Объект.Руководитель = Руководитель.ОтветственноеЛицоСсылка;
	Иначе
		Объект.Руководитель = Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	// Правильное заполнение поля СтранаПроисхожденияПринято
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.СтранаПроисхожденияПринято",
		,
		ВидСравненияКомпоновкиДанных.Заполнено);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.СтранаПроисхожденияПринято",
		Новый ПолеКомпоновкиДанных("Объект.ТоварыРаботыУслуги.СтранаПроисхождения"),
		ВидСравненияКомпоновкиДанных.Равно);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасхожденияСтранаПроисхожденияПринято");
	
	// Содержание услуги
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.ЭтоУслуга",
		Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.Номенклатура",
		,
		ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТоварыРаботыУслугиСодержание");
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасчетыСодержание");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеЕстьРасхождения(ИдентификаторСтрокиОбъекта)
	СтрокаОбъекта = Объект.ТоварыРаботыУслуги.НайтиПоИдентификатору(ИдентификаторСтрокиОбъекта);
	Если СтрокаОбъекта.ПрослеживаемыйТовар Тогда
		УстановитьЗначениеЕстьРасхожденияНаСервере(ИдентификаторСтрокиОбъекта);
	Иначе
		ПроверитьИУстановитьЗначениеЕстьРасхождения(СтрокаОбъекта, Объект);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеЕстьРасхожденияНаСервере(ИдентификаторСтрокиОбъекта)
	СтрокаОбъекта = Объект.ТоварыРаботыУслуги.НайтиПоИдентификатору(ИдентификаторСтрокиОбъекта);
	ПроверитьИУстановитьЗначениеЕстьРасхождения(СтрокаОбъекта, Объект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьИУстановитьЗначениеЕстьРасхождения(СтрокаОбъекта, Объект)
	СтрокаОбъекта.ЕстьРасхождения = ЗначениеЗаполнено(СтрокаОбъекта.СтранаПроисхожденияПринято)
		И СтрокаОбъекта.СтранаПроисхождения <> СтрокаОбъекта.СтранаПроисхожденияПринято;
	СтрокаОбъекта.ЕстьРасхождения = СтрокаОбъекта.ЕстьРасхождения
		Или СтрокаОбъекта.КоличествоОтклонение <> 0
		Или ЗначениеЗаполнено(СтрокаОбъекта.НесоответствиеТребованиям)
		Или ЗначениеЗаполнено(СтрокаОбъекта.ОтклонениеПрочее);
	Если СтрокаОбъекта.ЕстьРасхождения Или Не СтрокаОбъекта.ПрослеживаемыйТовар Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка совпадения РНПТ вызывается только с сервера
	#Если Сервер Тогда
	СтрокаОбъекта.ЕстьРасхождения = ЕстьРазличияВРНПТ(Объект, СтрокаОбъекта);
	#КонецЕсли
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьРазличияВРНПТ(Объект, СтрокаОбъекта)
	Отбор = Новый Структура("ИдентификаторСтроки", СтрокаОбъекта.ИдентификаторСтроки);
	РНПТ = Объект.СведенияПрослеживаемости.Выгрузить(Отбор, "РНПТ, Количество");
	РНПТФактические = Объект.СведенияПрослеживаемостиФактические.Выгрузить(Отбор, "РНПТ, Количество");
	
	РНПТ.Сортировать("РНПТ");
	РНПТФактические.Сортировать("РНПТ");
	
	РезультатСравнения = ОбщегоНазначенияБГУ.ФункцияСравненияОбъектов(РНПТ, РНПТФактические);
	Возврат Не РезультатСравнения;
КонецФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ИспользоватьКонтрольИсполненияДоговоров", ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров"));
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиГрафикПлатежей", ?(РеквизитыДоговора.ВестиГрафикПлатежей = Истина, Истина, Ложь));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВестиПланГрафикИсполнения", ?(РеквизитыДоговора.ВестиПланГрафикИсполнения = Истина, Истина, Ложь));
	
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьВидимостьЭлементов(ЭтотОбъект,
		ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров,
		ЭтотОбъект.КэшПараметров.Локальные.ВестиГрафикПлатежей);
	КонтрольИсполненияДоговоровКлиентСервер.ЗапланироватьОплатуУстановитьДоступностьОплатитьДо(ЭтотОбъект, Объект.ЗапланироватьОплату);
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	ЗаполнитьПредставлениеТоваровВУпаковке();
	ЗаполнитьДополнительныеРеквизитыСтрок();
	УстановитьДоступностьСвязанныхЭлементов(ЭтотОбъект);
	УстановитьПолеКонтрагентПоОрганизации();
	УправлениеНФА.УстановитьСвязиПараметровВыбораВсехЭлементовОтветственныхЛиц(ЭтотОбъект, Объект);
	УстановитьСвойстваЭлементовОтветственныхЛицКонтрагентов(ЭтотОбъект);
	ЗаполнитьДолжностиОтветственныхЛиц();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗаголовкиСтрок()
	Для Каждого Строка Из Объект.ТоварыРаботыУслуги Цикл
		ЗаполнитьЗаголовкиВСтроке(Строка);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьЗаголовкиВСтроке(Строка)
	Строка.ЗаголовокСумма = НСтр("ru = 'сумма'");
	Строка.ЗаголовокКоличество = НСтр("ru = 'кол-во'");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставленияРНПТ()
	Для Каждого СтрокаАкта Из Объект.ТоварыРаботыУслуги Цикл
		ЗаполнитьПредставленияРНПТВСтроке(СтрокаАкта, "РНПТ", "СведенияПрослеживаемости");
		ЗаполнитьПредставленияРНПТВСтроке(СтрокаАкта, "РНПТФактические", "СведенияПрослеживаемостиФактические");
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставленияРНПТВСтроке(Строка, РНПТ, СведенияПрослеживаемости)
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТВПолеФормы(Строка[РНПТ],
		Строка.ПрослеживаемыйТовар,
		Строка.ИдентификаторСтроки,
		Объект[СведенияПрослеживаемости]);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораРНПТННаКлиенте(ВыбранноеЗначение)
	
	СтрокаТабличнойЧасти = Элементы[ИмяТаблицыДляПодбораРНПТ].ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
			СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		ОбработкаВыбораРНПТННаСервере(СтрокаТабличнойЧасти.ИдентификаторСтроки,
			ВыбранноеЗначение,
			СтрокаТабличнойЧасти.ПолучитьИдентификатор(),
			ИмяТаблицыПрослеживаемости,
			ИмяКолонкиРНПТ);
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораРНПТННаСервере(Знач ИдентификаторСтроки, Знач ВыбранноеЗначение, Знач ИдентификаторСтрокиВнутр,
	Знач ИмяТаблицыПрослеживаемости, Знач ИмяКолонкиРНПТ)
	
	СтрокаТабличнойЧасти = Объект.ТоварыРаботыУслуги.НайтиПоИдентификатору(ИдентификаторСтрокиВнутр);
	ПрослеживаемостьФормыБГУ.ОбработкаВыбораРНПТСИменемТаблицы(ЭтотОбъект,
		ИдентификаторСтроки,
		ВыбранноеЗначение,
		ИмяТаблицыПрослеживаемости);
	ЗаполнитьПредставленияРНПТВСтроке(СтрокаТабличнойЧасти, ИмяКолонкиРНПТ, ИмяТаблицыПрослеживаемости);
	ПроверитьИУстановитьЗначениеЕстьРасхождения(СтрокаТабличнойЧасти, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьРНПТВХранилищеНаСервере(Знач Адрес, Знач ИдентификаторСтроки, Знач СведенияПрослеживаемости)

	Отбор = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	ТаблицаРНПТ = Объект[СведенияПрослеживаемости].Выгрузить(Отбор);
	ПоместитьВоВременноеХранилище(ТаблицаРНПТ, Адрес);

КонецПроцедуры

&НаСервере
Процедура КомиссияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ЗаполнитьСоставКомиссии(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедактированияСоставаУпаковки()
	ТекущиеДанные = Элементы.СведенияОбУпаковке.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
	АдресСтрокиУпаковки = ПоместитьСоставУпаковкиВХранилище(ИдентификаторСтроки);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресСтрокиУпаковки", АдресСтрокиУпаковки);
	ОткрытьФорму("Документ.АктПриемкиТоваровРаботУслуг.Форма.СоставУпаковки",
		ПараметрыФормы,
		Элементы.СведенияОбУпаковке,
		УникальныйИдентификатор, , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументамПоступленияНаСервере()

	Документы.АктПриемкиТоваровРаботУслуг.ЗаполнитьТоварыРаботыУслуги(Объект);
	Если Объект.ВидПоставки = Перечисления.ВидыПоставкиТоваровРаботУслуг.НеотфактурованнаяПоставка Тогда
		Если Объект.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.ПоДокументу Тогда
			Документы.АктПриемкиТоваровРаботУслуг.ЗаполнитьЗачетАвансов(Объект);
		КонецЕсли;
		Документы.АктПриемкиТоваровРаботУслуг.ЗаполнитьДенежныеОбязательства(Объект);
	Иначе
		Объект.СуммаДенежногоОбязательства = Объект.ТоварыРаботыУслуги.Итог("Всего");
	КонецЕсли;
	
	ЗаполнитьЗаголовкиСтрок();
	ЗаполнитьПредставленияРНПТ();
	
КонецПроцедуры

&НаСервере
Функция ПоместитьСоставУпаковкиВХранилище(ИдентификаторСтроки)

	СтрокаУпаковки = Объект.СведенияОбУпаковке.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Не ЗначениеЗаполнено(СтрокаУпаковки.ИдентификаторСтроки) Тогда
		СтрокаУпаковки.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	
	СтрокиВУпаковке = Новый Соответствие;
	Для Каждого СоответствиеСтрок Из Объект.СоставУпаковок Цикл
		Если СоответствиеСтрок.ИдентификаторСтрокиУпаковки = СтрокаУпаковки.ИдентификаторСтроки Тогда
			СтрокиВУпаковке.Вставить(СоответствиеСтрок.ИдентификаторСтрокиТовара, Истина);
		КонецЕсли;
	КонецЦикла;
	
	ДанныеУпаковки = Новый Структура;
	ДанныеУпаковки.Вставить("ИдентификаторСтрокиУпаковки", СтрокаУпаковки.ИдентификаторСтроки);
	
	Для Каждого СтрокаАкта Из Объект.ТоварыРаботыУслуги Цикл
		Если ПустаяСтрока(СтрокаАкта.ИдентификаторСтроки) Тогда
			СтрокаАкта.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
		КонецЕсли;
	КонецЦикла;
	
	СоставАкта = Объект.ТоварыРаботыУслуги.Выгрузить( ,
		"Номенклатура, ЕдиницаИзмерения, СтранаПроисхождения, Количество, ИдентификаторСтроки");
	СоставАкта.Колонки.Добавить("ВходитВУпаковку", Новый ОписаниеТипов("Булево"));
	Для Каждого СтрокаСостава Из СоставАкта Цикл
		Если СтрокиВУпаковке.Получить(СтрокаСостава.ИдентификаторСтроки) = Истина Тогда
			СтрокаСостава.ВходитВУпаковку = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеУпаковки.Вставить("СоставАкта", СоставАкта);
	
	Возврат ПоместитьВоВременноеХранилище(ДанныеУпаковки, УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура ЗаполнитьСоставУпаковкиНаСервере(РезультатЗаполненияСостава)

	АдресСоставаУпаковки =
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатЗаполненияСостава, "АдресСоставаУпаковки"); // Строка
	Если ТипЗнч(АдресСоставаУпаковки) <> Тип("Строка") Или Не ЭтоАдресВременногоХранилища(АдресСоставаУпаковки) Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтрокиУпаковки = ПолучитьИзВременногоХранилища(АдресСоставаУпаковки); // Структура
	Если ТипЗнч(ДанныеСтрокиУпаковки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторСтрокиУпаковки =
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСтрокиУпаковки, "ИдентификаторСтрокиУпаковки"); // Строка
	Если Не ЗначениеЗаполнено(ИдентификаторСтрокиУпаковки) Тогда
		Возврат;
	КонецЕсли;
	
	// Удалить все товары из упаковки
	УдаляемыеСтроки = Объект.СоставУпаковок.НайтиСтроки(
		Новый Структура("ИдентификаторСтрокиУпаковки", ИдентификаторСтрокиУпаковки));
	Для Каждого СтрокаСостава Из УдаляемыеСтроки Цикл
		Объект.СоставУпаковок.Удалить(СтрокаСостава);
	КонецЦикла;
	
	// Добавить в упаковку выбранные товары
	
	СоставУпаковки = ДанныеСтрокиУпаковки.СоставУпаковки; // Соответствие из Булево
	Для Каждого СтрокаАкта Из Объект.ТоварыРаботыУслуги Цикл
		
		Если СоставУпаковки.Получить(СтрокаАкта.ИдентификаторСтроки) <> Неопределено Тогда
			СтрокаСостава = Объект.СоставУпаковок.Добавить();
			СтрокаСостава.ИдентификаторСтрокиТовара = СтрокаАкта.ИдентификаторСтроки;
			СтрокаСостава.ИдентификаторСтрокиУпаковки = ИдентификаторСтрокиУпаковки;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьПредставлениеТоваровВУпаковке();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеТоваровВУпаковке()
	
	СтрокиУпаковок = Новый Соответствие;
	Для Каждого СтрокаУпаковки Из Объект.СведенияОбУпаковке Цикл
		СтрокиУпаковок.Вставить(СтрокаУпаковки.ИдентификаторСтроки, СтрокаУпаковки);
	КонецЦикла;
	
	СтрокиТоваров = Новый Соответствие;
	Для Каждого СтрокаТовара Из Объект.ТоварыРаботыУслуги Цикл
		СтрокиТоваров.Вставить(СтрокаТовара.ИдентификаторСтроки, СтрокаТовара);
	КонецЦикла;
	
	СоставыУпаковок = Новый Соответствие;
	Для Каждого СоответствиеСтрок Из Объект.СоставУпаковок Цикл
		// Проверить, что такая упаковка есть
		Если СтрокиУпаковок.Получить(СоответствиеСтрок.ИдентификаторСтрокиУпаковки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаАкта = СтрокиТоваров.Получить(СоответствиеСтрок.ИдентификаторСтрокиТовара);
		// Проверить, что такой товар есть
		Если СтрокаАкта = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Состав = СоставыУпаковок.Получить(СоответствиеСтрок.ИдентификаторСтрокиУпаковки);
		Если Состав = Неопределено Тогда
			Состав = Новый Массив;
			СоставыУпаковок.Вставить(СоответствиеСтрок.ИдентификаторСтрокиУпаковки, Состав);
		КонецЕсли;
		Состав.Добавить(СтрокаАкта);
	КонецЦикла;
	
	Для Каждого СтрокаУпаковки Из Объект.СведенияОбУпаковке Цикл
		Состав = СоставыУпаковок.Получить(СтрокаУпаковки.ИдентификаторСтроки);
		Если Состав = Неопределено Или Состав.Количество() = 0 Тогда
			ПредставлениеТоваровВУпаковке = ПредставлениеТоваровВУпаковкеНеВыбраны();
		Иначе
			ПредставлениеТоваровВУпаковке = Строка(Состав[0].Номенклатура);
			Если Состав.Количество() = 2 Тогда
				ПредставлениеТоваровВУпаковке = ПредставлениеТоваровВУпаковке + "; " + Строка(Состав[1].Номенклатура);
			ИначеЕсли Состав.Количество() > 2 Тогда
				ПредставлениеТоваровВУпаковке = ПредставлениеТоваровВУпаковке
					+ СтрШаблон(НСтр("ru = ' и еще %1'"), Состав.Количество() - 1);
			КонецЕсли;
		КонецЕсли;
		СтрокаУпаковки.СоставУпаковки = ПредставлениеТоваровВУпаковке;
	КонецЦикла;
КонецПроцедуры

