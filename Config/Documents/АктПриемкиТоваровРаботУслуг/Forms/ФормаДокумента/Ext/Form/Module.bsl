&НаКлиенте
Процедура ВидПоставкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(Объект.ВидПоставки)
		Или ВыбранноеЗначение = Объект.ВидПоставки
		Или Объект.ДокументыПоступления.Количество() = 0 Тогда
		
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ВыбранныйВидПоставки = ВыбранноеЗначение;
	
	ТекстВопроса = НСтр("ru = 'При изменении вида поставки таблицы документа будут очищены.
		|Изменить вид поставки?'");
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Очистить таблицы и изменить вид поставки'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена);
	ОбработчикОтвета = Новый ОписаниеОповещения("ПослеОтветаОбИзмененииВидаПоставки", ЭтотОбъект);
	ПоказатьВопрос(ОбработчикОтвета, ТекстВопроса, Кнопки);
	
КонецПроцедуры

