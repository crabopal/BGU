	ПараметрыЗаполнения.Вставить("ИмяМенеджера", "Документы.АктПриемкиТоваровРаботУслуг");
	ПараметрыЗаполнения.Вставить("Организация", Объект.Организация);
	ПараметрыЗаполнения.Вставить("ИФО", Объект.ИФО);
	ПараметрыЗаполнения.Вставить("Дата", Объект.Дата);
	ОткрытьФорму("Документ.АктПриемкиТоваровРаботУслуг.Форма.ГрупповоеИзменениеРеквизитовТабличнойЧасти",
