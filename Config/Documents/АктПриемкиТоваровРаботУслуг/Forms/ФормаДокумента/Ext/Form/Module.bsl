&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДОПослеИнициализацииЭлементовБЭД(Форма, ВидимостьЭлементовЭДО)
	
	ВидимостьСостоянияЭДО = ВидимостьЭлементовЭДО;
	Если СтрНайти(Форма.Элементы.ДекорацияСостояниеЭДО.Заголовок, НСтр("ru = 'Не начат'")) > 0
		ИЛИ СтрНайти(Форма.Элементы.ДекорацияСостояниеЭДО.Заголовок, НСтр("ru = 'ЭДО: Состояние ЭДО'")) > 0 Тогда
		ВидимостьСостоянияЭДО = Ложь;
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияЭДОАкт", "Видимость", ВидимостьСостоянияЭДО);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияСостояниеЭДО", "Видимость", ВидимостьСостоянияЭДО);
	
КонецПроцедуры

