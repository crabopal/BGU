&НаСервере
Процедура ОбновитьТаблицуДокументыПоступленияНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.ПоступлениеНФА КАК ПоступлениеНФА
	|ИЗ
	|	РегистрСведений.НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ КАК Т
	|ГДЕ
	|	Т.АктПриемкиТРУ = &АктПриемкиТРУ
	|	И Т.ПоступлениеНФА НЕ В (&ПоступлениеНФА)";
	Запрос.УстановитьПараметр("АктПриемкиТРУ", Объект.Ссылка);
	Запрос.УстановитьПараметр("ПоступлениеНФА",
		Объект.ДокументыПоступления.Выгрузить().ВыгрузитьКолонку("ДокументОснование"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ДокументыПоступления.Добавить();
		НоваяСтрока.ДокументОснование = Выборка.ПоступлениеНФА;
	КонецЦикла;
	Модифицированность = Истина;
	ЕстьНеДобавленныеДокументыПоставки = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗавершенииВыбораЗначенийЗаполнения(РезультатЗаполнения, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(РезультатЗаполнения) = Тип("Структура") Тогда
		ОбрабатываемаяТЧ = Объект[ДополнительныеПараметры.ИмяТЧ];
		Для Каждого ИдентификаторСтроки Из ДополнительныеПараметры.ИдентификаторыСтрок Цикл
			ТекущиеДанные = ОбрабатываемаяТЧ.НайтиПоИдентификатору(ИдентификаторСтроки);
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, РезультатЗаполнения);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачатьУстановкуАдресаМестоСоставленияАкта()
	ВыбранныйАдрес = "";
	ВыбранныйАдресВоВнутреннемФормате = "";
	ОбрабатываемыеСтроки = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(
		Элементы.ТранспортировкаИПриемка.ВыделенныеСтроки);
	Для Каждого ИдентификаторСтроки Из ОбрабатываемыеСтроки Цикл
		ДанныеСтроки = Элементы.ТранспортировкаИПриемка.ДанныеСтроки(ИдентификаторСтроки);
		Если ЗначениеЗаполнено(ДанныеСтроки.МестоСоставленияАкта) Тогда
			ВыбранныйАдрес = ДанныеСтроки.МестоСоставленияАкта;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСтроки.МестоСоставленияАктаВоВнутреннемФормате) Тогда
			ВыбранныйАдресВоВнутреннемФормате = ДанныеСтроки.МестоСоставленияАктаВоВнутреннемФормате;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура("ОбрабатываемыеСтроки", ОбрабатываемыеСтроки);
	ОповещениеОВыбореАдреса = Новый ОписаниеОповещения("ПриОповещенииОВыбореАдреса", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыВыбораАдреса = Новый Структура;
	ПараметрыВыбораАдреса.Вставить("ОткрытаПоСценарию", Ложь);
	ПараметрыВыбораАдреса.Вставить("Заголовок", НСтр("ru = 'Место составления акта'"));
	Если ЗначениеЗаполнено(ВыбранныйАдресВоВнутреннемФормате) Тогда
		ПараметрыВыбораАдреса.Вставить("ЗначенияПолей", ВыбранныйАдресВоВнутреннемФормате);
	ИначеЕсли ЗначениеЗаполнено(ВыбранныйАдрес) Тогда
		ПараметрыВыбораАдреса.Вставить("Представление", ВыбранныйАдрес);
	КонецЕсли;
	
	ОткрытьФорму("Обработка.РасширенныйВводКонтактнойИнформации.Форма.ВводАдреса", ПараметрыВыбораАдреса, ЭтотОбъект, , , , ОповещениеОВыбореАдреса);

КонецПроцедуры

&НаКлиенте
Процедура ПриОповещенииОВыбореАдреса(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбрабатываемыеСтроки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		ДополнительныеПараметры, "ОбрабатываемыеСтроки");
	Если ОбрабатываемыеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ИдентификаторСтроки Из ОбрабатываемыеСтроки Цикл
		ТекущиеДанные = Объект.ТранспортировкаИПриемка.НайтиПоИдентификатору(ИдентификаторСтроки);	
		ТекущиеДанные.МестоСоставленияАкта = ВыбранноеЗначение.Представление;
		ТекущиеДанные.МестоСоставленияАктаВоВнутреннемФормате = ВыбранноеЗначение.Значение;
	КонецЦикла;
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСвязиПараметровВыбораОтветственногоЛица(Результат, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(Результат) = Тип("Массив")
			И ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
			И ДополнительныеПараметры.Свойство("ИмяЭлемента") Тогда
		ИзменитьСвязиПараметровВыбораОтветственногоЛицаНаСервере(ДополнительныеПараметры.ИмяЭлемента, Результат);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИзменитьСвязиПараметровВыбораОтветственногоЛицаНаСервере(Знач ИмяЭлемента, Знач НовыеСвязиПараметровВыбора)
	УправлениеНФА.УстановитьСвязиПараметровВыбораЭлементаОтветственногоЛица(Элементы[ИмяЭлемента],
		НовыеСвязиПараметровВыбора);
КонецПроцедуры

&НаКлиенте
Асинх Процедура СпроситьПроОчисткуКомиссииИОчистить()
	
	ТекстВопроса = НСтр("ru = 'Если решение о создании комиссии не принято, то нужно очистить комиссию в документе.
		|Очистить комиссию?'");
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Да, очистить комиссию'"));
	Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Не очищать комиссию'"));
	Ответ = Ждать ВопросАсинх(ТекстВопроса, Кнопки, , КодВозвратаДиалога.Нет);
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Объект.РешениеОСозданииКомиссииНеПринято = Ложь;
		Возврат;
	КонецЕсли;
	
	Объект.Комиссия = ПредопределенноеЗначение("Справочник.ПостоянноДействующиеКомиссии.ПустаяСсылка");
	Объект.СоставКомиссии.Очистить();
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);

КонецПроцедуры

