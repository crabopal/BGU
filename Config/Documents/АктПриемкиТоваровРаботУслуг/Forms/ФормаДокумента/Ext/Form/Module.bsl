
#Область ОписаниеПеременных

// Имя таблицы СведенияПрослеживаемости или СведенияПрослеживаемостиФактические
&НаКлиенте
Перем ИмяТаблицыПрослеживаемости; // Строка

// Имя колонки для обновления текста РНПТ
&НаКлиенте
Перем ИмяКолонкиРНПТ; // Строка

// Имя таблицы, по которой выполняется выбор РНПТ
&НаКлиенте
Перем ИмяТаблицыДляПодбораРНПТ; // Строка

// Признак, что в подборе документов был добавлен документ
&НаКлиенте
Перем ЕстьДобавленыйДокумент; // Булево

&НаКлиенте
Перем ВыбранныйВидПоставки; // ПеречислениеСсылка.ВидыПоставкиТоваровРаботУслуг

&НаКлиенте
Перем ПолученоПодтверждениеПроведенияПриПроведении; // Булево

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка,
		Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части

	ВидимостьЭлементовЭДО = ВидимостьЭлементовЭДО(Объект.Контрагент, Объект.Организация);
	УстановитьВидимостьЭлементовЭДО(ЭтотОбъект);

	Если Параметры.Ключ.Пустая() Тогда
		ПодготовитьФормуНаСервере();
	КонецЕсли;

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами".
	
	УстановитьВидимостьЭлементовЭДОПослеИнициализацииЭлементовБЭД(ЭтотОбъект, ВидимостьЭлементовЭДО);
	
	// Централизованная бухгалтерия
	ЗаполнениеРеквизитовОбъектов.ОпределитьПараметрыВыбораСотрудников(ЭтотОбъект, Объект.Организация);
	// Конец Централизованная бухгалтерия
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.РаботаСФайлами
	ПараметрыГиперссылки = РаботаСФайлами.ГиперссылкаФайлов();
	ПараметрыГиперссылки.Размещение = "КоманднаяПанель";
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыГиперссылки);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	// ИнтеграцияИС
	ИнтеграцияИС.ПриСозданииНаСервереВФормеДокументаОснования(ЭтотОбъект, Объект,
		ИнтеграцияИС.ПараметрыИнтеграцииВФорме("ВетИС",ИнтеграцияИС.ИмяЭлементаДляРазмещения()));
	// Конец ИнтеграцияИС
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтотОбъект, Элементы.ИнформационныеСсылки);
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом  
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаДокумента(ЭтотОбъект, Элементы.ГруппаОтветственныйКомментарий);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов 
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект,
		Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	ЕстьНеДобавленныеДокументыПоставки =
		Не РегистрыСведений.НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ.ВсеДокументыПоставкиДобавленыВАкт(
			Объект.Ссылка);
	ДокументыПоступленияПриОткрытии.ЗагрузитьЗначения(
		Объект.ДокументыПоступления.Выгрузить(, "ДокументОснование").ВыгрузитьКолонку("ДокументОснование"));
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
			И ЕстьНеДобавленныеДокументыПоставки Тогда
		Отказ = Истина;
		
		ТекстВопроса = НСтр("ru = 'В документ добавлены не все документы поставки, введенные на основании.
			|Добавить документы поставки перед проведением?'");
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаОДобавленииДокументовПоставки", ЭтотОбъект);
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да);
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Да);
		Возврат;
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
			И ПолученоПодтверждениеПроведенияПриПроведении = Неопределено
			И ПроверитьПроведениеОснований() Тогда
		Отказ = Истина;
		ТекстВопроса = НСтр("ru = 'В документе присутствуют не проведенные документы поставки.
			|Провести документы поставки одновременно с ""Актом приемки товаров, работ, услуг""?'");
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаОПроведенииДокументовПоставки", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Возврат;			
	КонецЕсли;
	
	ПроводитьДокументыПоступленияПриПроведенииАктаПриемкиТРУ =
		(ПолученоПодтверждениеПроведенияПриПроведении = Истина);
	ПолученоПодтверждениеПроведенияПриПроведении = Неопределено;
	
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаОПроведенииДокументовПоставки(Ответ, ДополнительныеПараметры) Экспорт
	ПолученоПодтверждениеПроведенияПриПроведении = (Ответ = КодВозвратаДиалога.Да);
	ПровестиПослеОбновленияФормы();	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьПроведениеОснований()
	Если Объект.ВидПоставки <> ПредопределенноеЗначение("Перечисление.ВидыПоставкиТоваровРаботУслуг.ПрочаяПоставка")
			Или Объект.ДокументыПоступления.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьНепроведенные = ЕстьНепроведенныеДокументыПоставки();
	Возврат ЕстьНепроведенные;
КонецФункции

&НаСервере
Функция ЕстьНепроведенныеДокументыПоставки()
	НепроведенныеДокументы = Документы.АктПриемкиТоваровРаботУслуг.НайтиНепроведенныеДокументыПоставки(Объект.ДокументыПоступления.Выгрузить());
	Возврат НепроведенныеДокументы.Количество() > 0;
КонецФункции

&НаКлиенте
Процедура ПослеОтветаОДобавленииДокументовПоставки(Ответ, ДополнительныеПараметры) Экспорт	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОбновитьТаблицуДокументыПоступленияНаКлиенте();
		ПодключитьОбработчикОжидания("ПровестиПослеОбновленияФормы", 0.1, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПровестиПослеОбновленияФормы()
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ПриОткрытии(ЭтотОбъект, Отказ);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства

	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ПодготовитьФормуНаСервере();

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;

	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".    
	
	УстановитьВидимостьЭлементовЭДОПослеИнициализацииЭлементовБЭД(ЭтотОбъект, ВидимостьЭлементовЭДО);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения,
		СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".
		
		ЭтотОбъект.ОбновитьОтображениеДанных();	
	КонецЕсли;
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	
	// ИнтеграцияИС
	ИнтеграцияИСКлиент.ОбработкаОповещенияВФормеДокументаОснования(
		ЭтотОбъект,
		Объект,
		ИмяСобытия,
		Параметр,
		Источник);
	// Конец ИнтеграцияИС
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов    
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаДокумента(ИмяСобытия, ЭтотОбъект, Источник);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
	Если ИмяСобытия = "Запись_ПоступлениеНФАПоАктуПриемкиТРУ"
			И Параметр = Объект.Ссылка Тогда
		Если Объект.ДокументыПоступления.НайтиСтроки(Новый Структура("ДокументОснование", Источник)).Количество() = 0 Тогда
			Если Не Модифицированность Тогда
				Попытка
					ЗаблокироватьДанныеФормыДляРедактирования();
				Исключение
					ЕстьНеДобавленныеДокументыПоставки = Истина;
					УстановитьВидимостьЭлементов(ЭтотОбъект);
				КонецПопытки;
			КонецЕсли;
			Модифицированность = Истина;
			Объект.ДокументыПоступления.Добавить().ДокументОснование = Источник;
			ПоказатьОповещениеПользователя(
				НСтр("ru = 'Добавлен новый документ поставки'"),
				ПолучитьНавигационнуюСсылку(Источник),
				Источник,
				БиблиотекаКартинок.Информация32,
				СтатусОповещенияПользователя.Информация);		КонецЕсли;		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ПроводитьДокументыПоступленияПриПроведенииАктаПриемкиТРУ",
		ПроводитьДокументыПоступленияПриПроведенииАктаПриемкиТРУ);
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);

	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтотОбъект);
		
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом  
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтаФорма, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтотОбъект);
	
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	
	НовыеЗначения = Новый Массив;
	Для Каждого СтрокаПоступления Из Объект.ДокументыПоступления Цикл
		Если ДокументыПоступленияПриОткрытии.НайтиПоЗначению(СтрокаПоступления.ДокументОснование) = Неопределено Тогда
			Оповестить("ЗаписьАктаПриемкиТРУ", СтрокаПоступления.ДокументОснование, Объект.Ссылка);
		КонецЕсли;
		НовыеЗначения.Добавить(СтрокаПоступления.ДокументОснование);
	КонецЦикла;
	ДокументыПоступленияПриОткрытии.ЗагрузитьЗначения(НовыеЗначения);
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
			И ПроводитьДокументыПоступленияПриПроведенииАктаПриемкиТРУ Тогда
		ОбработанныеТипы = Новый Массив;
		Для Каждого СтрокаПоступления Из Объект.ДокументыПоступления Цикл
			Если ОбработанныеТипы.Найти(ТипЗнч(СтрокаПоступления.ДокументОснование)) = Неопределено Тогда
				ОповеститьОбИзменении(ТипЗнч(СтрокаПоступления.ДокументОснование));
				ОбработанныеТипы.Добавить(ТипЗнч(СтрокаПоступления.ДокументОснование));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ИсточникВыбора.ИмяФормы = "Справочник.НомераГТД.Форма.ФормаПодбораРНПТ" Тогда
		ОбработкаВыбораРНПТННаКлиенте(ВыбранноеЗначение);
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Документ.АктПриемкиТоваровРаботУслуг.Форма.ФормаВыбораДокументовПоставки" Тогда
		ОбработкаВыбораДокументовПоступления(ВыбранноеЗначение);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	// Проверить правильность заполнения отклонений
	Для Каждого Строка Из Объект.ТоварыРаботыУслуги Цикл
		ОбработкаПроверкиЗаполненияКоличествоОтклонениеПоОбъему(Строка, Отказ);
		ОбработкаПроверкиЗаполненияСтранаПроисхожденияПринято(Строка, Отказ);
		ОбработкаПроверкиЗаполненияКоличествоОтклонение(Строка, Отказ);
		ОбработкаПроверкиЗаполненияКоличествоНесоответствующие(Строка, Отказ);
		ОбработкаПроверкаЗаполненияЕстьРасхождение(Строка, Отказ);
	КонецЦикла;

	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства

КонецПроцедуры

