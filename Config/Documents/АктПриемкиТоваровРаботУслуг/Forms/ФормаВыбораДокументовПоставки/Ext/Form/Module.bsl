// @strict-types
	
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Параметры.Договор)
		Или Не ЗначениеЗаполнено(Параметры.Организация)
		Или Не ЗначениеЗаполнено(Параметры.ВидПоставки) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнены обязательные параметры ""Организация"", ""Договор"", ""Вид поставки"".'");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Договор", Параметры.Договор);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Счет40160",
		БухгалтерскийУчет.СчетПоКоду("401.60"));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Организация",
		Параметры.Организация);
	
	ЭтоНеотфактурованнаяПоставка = Параметры.ВидПоставки
		= Перечисления.ВидыПоставкиТоваровРаботУслуг.НеотфактурованнаяПоставка;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
		"ЭтоНеотфактурованнаяПоставка", ЭтоНеотфактурованнаяПоставка);
	
	ТипыДокументовПоступления = Новый Массив; // Массив из Тип
	Для Каждого ТипДокумента Из Метаданные.ОпределяемыеТипы.ДокументПоступленияАктаПриемкиТРУ.Тип.Типы() Цикл
		ТипыДокументовПоступления.Добавить(ТипДокумента);
	КонецЦикла;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
		"Тип", ТипыДокументовПоступления, ВидСравненияКомпоновкиДанных.ВСписке);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	ОбработатьВыбор(СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОбработатьВыбор(СтандартнаяОбработка);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)

	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ДокументыПоТипам = ОбщегоНазначенияБГУ.ДокументыПоТипам(Строки.ПолучитьКлючи());
	РеквизитыДокументов = Новый Массив; // Массив из Соответствие
	Для Каждого ТипДокумента Из ДокументыПоТипам Цикл
		Если ТипДокумента.Значение[0].Метаданные().Реквизиты.Найти("ВидПервичногоДокумента") <> Неопределено Тогда
			РеквизитыДокументов.Добавить(ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ТипДокумента.Значение,
				"ВидПервичногоДокумента, НомерПервичногоДокумента, ДатаПервичногоДокумента"));
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ТекСтрока Из Строки Цикл
		//@skip-check property-return-type
		//@skip-check variable-value-type
		ТекущиеДанные = ТекСтрока.Значение.Данные;
		ДанныеДокумента = Неопределено;
		Для Каждого ДанныеПоТипам Из РеквизитыДокументов Цикл
			//@skip-check property-return-type
			ДанныеДокумента = ДанныеПоТипам.Получить(ТекущиеДанные.Ссылка);
			Если ДанныеДокумента <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ДанныеДокумента <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеДокумента);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбработатьВыбор(СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Результат = Новый Массив; // Массив из Структура
	Для Каждого ВыбраннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(ВыбраннаяСтрока);
		ДанныеДокумента = Новый Структура;
		ДанныеДокумента.Вставить("ВидПервичногоДокумента", ДанныеСтроки.ВидПервичногоДокумента);
		ДанныеДокумента.Вставить("НомерПервичногоДокумента", ДанныеСтроки.НомерПервичногоДокумента);
		ДанныеДокумента.Вставить("ДатаПервичногоДокумента", ДанныеСтроки.ДатаПервичногоДокумента);
		ДанныеДокумента.Вставить("Ссылка", ДанныеСтроки.Ссылка);
		Результат.Добавить(ДанныеДокумента);
	КонецЦикла;
	ОповеститьОВыборе(Результат);
	Если Не Элементы.Список.МножественныйВыбор Тогда
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти