#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	ПеренестиВДокументНаКлиенте();	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИзменитьСвязиПараметровВыбораОтветственногоЛица(Результат, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(Результат) = Тип("Массив")
			И ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
			И ДополнительныеПараметры.Свойство("ИмяЭлемента") Тогда
		ИзменитьСвязиПараметровВыбораОтветственногоЛицаНаСервере(ДополнительныеПараметры.ИмяЭлемента, Результат);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИзменитьСвязиПараметровВыбораОтветственногоЛицаНаСервере(Знач ИмяЭлемента, Знач НовыеСвязиПараметровВыбора)
	УправлениеНФА.УстановитьСвязиПараметровВыбораЭлементаОтветственногоЛица(Элементы[ИмяЭлемента],
		НовыеСвязиПараметровВыбора);
КонецПроцедуры

&НаКлиенте
Процедура ФИОКонтактногоЛицаНачалоВыбора(Элемент, СтандартнаяОбработка)
	ТипыДанных = Новый СписокЗначений;
	ТипыДанных.Добавить(Тип("Строка"), НСтр("ru = 'Ввести вручную'"));
		ТипыДанных.Добавить(Тип("СправочникСсылка.ОтветственныеЛицаКонтрагентов"),
			НСтр("ru = 'Выбрать ответственное лицо'"));

	ПараметрыДляВыбора = УправлениеНФАКлиент.ПараметрыВыбораФИОКонтактногоЛицаАктПриемкиТРУ(ЭтотОбъект);
	ПараметрыДляВыбора.ДопустимыеТипы = ТипыДанных;
	ПараметрыДляВыбора.Контрагент = КонтрагентСтроительныйКонтроль;
	ПараметрыДляВыбора.Объект = ЭтотОбъект;
	УправлениеНФАКлиент.НачатьВыборФИОКонтактногоЛицаАктПриемкиТРУ(Элемент, ПараметрыДляВыбора, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвойстваЭлементовОтветственныхЛицКонтрагентов(Форма)
	УправлениеНФАКлиентСервер.УстановитьСвойстваЭлементовОтветственныхЛицКонтрагентовАктПриемкиТРУ(Форма, Форма);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДолжностьОтветственногоЛица(Форма, ИмяРеквизитаФИО)
	ОтветственноеЛицо = Форма[ИмяРеквизитаФИО];
	Если ЗначениеЗаполнено(ОтветственноеЛицо)
			И ТипЗнч(ОтветственноеЛицо) = Тип("СправочникСсылка.ОтветственныеЛицаКонтрагентов") Тогда
		ИмяРеквизитаДолжность = ИмяРеквизитаДолжность(ИмяРеквизитаФИО);
		Если ЗначениеЗаполнено(ИмяРеквизитаДолжность) Тогда
			Форма[ИмяРеквизитаДолжность] = ДолжностьОтветственногоЛица(ОтветственноеЛицо);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Должность ответственного лица.
// 
// Параметры:
//  ОтветственноеЛицо - СправочникСсылка.ОтветственныеЛицаКонтрагентов
// 
// Возвращаемое значение:
//  Строка - Должность ответственного лица
&НаСервереБезКонтекста
Функция ДолжностьОтветственногоЛица(ОтветственноеЛицо)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтветственноеЛицо, "Должность");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяРеквизитаДолжность(ИмяРеквизитаФИО)
	Если СтрЗаканчиваетсяНа(ИмяРеквизитаФИО, "ФИО") Тогда
		Возврат Лев(ИмяРеквизитаФИО, СтрДлина(ИмяРеквизитаФИО) - 3) + "Должность";
	КонецЕсли;
	Возврат "";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовкиСтроки()
	Возврат Новый Структура("ЗаголовокСумма, ЗаголовокСуммаНДС, ЗаголовокВсего",
		НСтр("ru = 'Сумма'"),
		НСтр("ru = 'НДС'"),
		НСтр("ru = 'Всего'"));
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьЗаголовкиСтроки(Строка)
	ЗаполнитьЗначенияСвойств(Строка, ЗаголовкиСтроки());
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗаголовкиВсехСтрок()
	Заголовки = ЗаголовкиСтроки();
	Для Каждого Строка Из СтоимостьСтроительноМонтажныхРабот Цикл
		ЗаполнитьЗначенияСвойств(Строка, Заголовки);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДокументНаКлиенте()
	ПеренестиВДокумент = Истина;
	СохранитьЗаполненныеДанные();
	Закрыть(АдресРезультата);	
КонецПроцедуры

&НаКлиенте
Процедура ПриОтветеНаВопросОСохраненииДанных(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокументНаКлиенте();
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовок()
	
	Заголовок = СтрШаблон(НСтр("ru = 'Акт приемки товаров, работ, услуг %1 от %2: %3'"),
		Номер, Дата, Метаданные.Документы.АктПриемкиТоваровРаботУслуг.Формы.СтроительноМонтажныеРаботы.Синоним);
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьПереданныеДанные()
	
	Если Не ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		Возврат;
	КонецЕсли;
	
	Данные = ПолучитьИзВременногоХранилища(АдресРезультата); // см. Документы.АктПриемкиТоваровРаботУслуг.ПараметрыОткрытияФормыСМР
	ПоместитьВоВременноеХранилище(Неопределено, АдресРезультата);
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Данные,
		"Организация,
		|Дата,
		|Номер,
		|СтройкаСМР,
		|КодОбъектаСтройки,
		|ОбъектСМР,
		|НачалоПериодаСМР,
		|ОкончаниеПериодаСМР,
		|КонтрагентСтроительныйКонтроль,
		|ПредставительСтроительныйКонтрольФИО,
		|ПредставительСтроительныйКонтрольДолжность");
	
	СтроительноМонтажныеРаботы.Очистить();
	Для Каждого СтрокаСМР Из Данные.СтроительноМонтажныеРаботы Цикл
		ЗаполнитьЗначенияСвойств(СтроительноМонтажныеРаботы.Добавить(), СтрокаСМР);
	КонецЦикла;
	
	СтоимостьСтроительноМонтажныхРабот.Очистить();
	Для Каждого СтрокаСтоимостиСМР Из Данные.СтоимостьСтроительноМонтажныхРабот Цикл
		ЗаполнитьЗначенияСвойств(СтоимостьСтроительноМонтажныхРабот.Добавить(), СтрокаСтоимостиСМР);
	КонецЦикла;
	ЗаполнитьЗаголовкиВсехСтрок();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьЗаполненныеДанные()
	
	Данные = Документы.АктПриемкиТоваровРаботУслуг.ПараметрыОткрытияФормыСМР();
	ЗаполнитьЗначенияСвойств(Данные, ЭтотОбъект,
		"СтройкаСМР,
		|КодОбъектаСтройки,
		|ОбъектСМР,
		|НачалоПериодаСМР,
		|ОкончаниеПериодаСМР,
		|КонтрагентСтроительныйКонтроль,
		|ПредставительСтроительныйКонтрольФИО,
		|ПредставительСтроительныйКонтрольДолжность");
	
	Для Каждого СтрокаСМР Из СтроительноМонтажныеРаботы Цикл
		ЗаполнитьЗначенияСвойств(Данные.СтроительноМонтажныеРаботы.Добавить(), СтрокаСМР);
	КонецЦикла;
	
	Для Каждого СтрокаСтоимостиСМР Из СтоимостьСтроительноМонтажныхРабот Цикл
		ЗаполнитьЗначенияСвойств(Данные.СтоимостьСтроительноМонтажныхРабот.Добавить(), СтрокаСтоимостиСМР);
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(Данные, АдресРезультата);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммы(ПолеСумма, ПолеСуммаНДС, ПолеВсего, СтавкаНДС, Показатель)

	Если Показатель = "Сумма" Тогда
		ПолеСуммаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтавкаНДС) * ПолеСумма / 100;
		ПолеВсего = ПолеСумма + ПолеСуммаНДС;
	ИначеЕсли Показатель = "НДС" Тогда
		ПолеСумма = ПолеВсего - ПолеСуммаНДС;
	ИначеЕсли Показатель = "Всего" Тогда
		ПолеСуммаНДС = ПолеВсего * УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтавкаНДС)
			/ (100 + УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтавкаНДС));
		ПолеСумма = ПолеВсего - ПолеСуммаНДС;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти