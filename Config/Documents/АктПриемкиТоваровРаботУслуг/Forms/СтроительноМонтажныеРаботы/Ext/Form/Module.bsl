
#Область ОписаниеПеременных

&НаКлиенте
Перем ПеренестиВДокумент;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	АдресРезультата = Параметры.АдресРезультата;
	ВосстановитьПереданныеДанные();
	УстановитьЗаголовок();
	ЗаполнитьДолжностьОтветственногоЛица(ЭтотОбъект, Элементы.ПредставительСтроительныйКонтрольФИО.Имя);
	УправлениеНФА.УстановитьСвязиПараметровВыбораВсехЭлементовОтветственныхЛиц(ЭтотОбъект, ЭтотОбъект);
	УстановитьСвойстваЭлементовОтветственныхЛицКонтрагентов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	ИначеЕсли ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если Модифицированность И ПеренестиВДокумент <> Истина Тогда
		Отказ = Истина;
		ТекстВопроса = НСтр("ru = 'Внесенные изменения не перенесены в документ.
			|Перенести?'");
		ПоказатьВопрос(Новый ОписаниеОповещения("ПриОтветеНаВопросОСохраненииДанных", ЭтотОбъект),
			ТекстВопроса,
			РежимДиалогаВопрос.ДаНетОтмена);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПредставительСтроительныйКонтрольФИОПриИзменении(Элемент)
	ПараметрыДляФормыВыбора = УправлениеНФАКлиент.ПараметрыУстановкиСвойстваПараметрыВыбораОтветственногоЛица();
	ПараметрыДляФормыВыбора.ЗначениеРеквизита = ПредставительСтроительныйКонтрольФИО;
	ПараметрыДляФормыВыбора.Контрагент = КонтрагентСтроительныйКонтроль;
	ПараметрыДляФормыВыбора.Организация = Организация;
	ПараметрыДляФормыВыбора.РеквизитКонтрагент = "КонтрагентСтроительныйКонтроль";
	ПараметрыДляФормыВыбора.Организация = "Организация";
	ПараметрыДляФормыВыбора.ИзменениеСвязиПараметровВыбора =
		Новый ОписаниеОповещения("ИзменитьСвязиПараметровВыбораОтветственногоЛица",
			ЭтотОбъект, Новый Структура("ИмяЭлемента", Элемент.Имя));
	УправлениеНФАКлиент.УстановитьПараметрыВыбораВСвойстваЭлементаОтветственногоЛица(Элемент, ПараметрыДляФормыВыбора);
	ЗаполнитьДолжностьОтветственногоЛица(ЭтотОбъект, Элемент.Имя);
	УстановитьСвойстваЭлементовОтветственныхЛицКонтрагентов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПредставительСтроительныйКонтрольФИОНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ФИОКонтактногоЛицаНачалоВыбора(Элемент, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтроительноМонтажныеРаботы

&НаКлиенте
Процедура СтроительноМонтажныеРаботыКоличествоПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СтроительноМонтажныеРаботы.ТекущиеДанные;
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
КонецПроцедуры

&НаКлиенте
Процедура СтроительноМонтажныеРаботыЦенаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СтроительноМонтажныеРаботы.ТекущиеДанные;
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
КонецПроцедуры

&НаКлиенте
Процедура СтроительноМонтажныеРаботыСуммаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СтроительноМонтажныеРаботы.ТекущиеДанные;
	Если ТекущиеДанные.Количество <> 0 Тогда
		ТекущиеДанные.Цена = ТекущиеДанные.Сумма / ТекущиеДанные.Количество;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтоимостьСтроительноМонтажныхРабот

&НаКлиенте
Процедура СтоимостьСтроительноМонтажныхРаботПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ЗаполнитьЗаголовкиСтроки(Элементы.СтоимостьСтроительноМонтажныхРабот.ТекущиеДанные);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтоимостьСтроительноМонтажныхРаботСтавкаНДСПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СтоимостьСтроительноМонтажныхРабот.ТекущиеДанные;
	ПересчитатьСуммы(
		ТекущиеДанные.Сумма,
		ТекущиеДанные.СуммаНДС,
		ТекущиеДанные.Всего,
		ТекущиеДанные.СтавкаНДС,
		"Сумма");
	ПересчитатьСуммы(
		ТекущиеДанные.СуммаСНачалаРабот,
		ТекущиеДанные.СуммаНДССНачалаРабот,
		ТекущиеДанные.ВсегоСНачалаРабот,
		ТекущиеДанные.СтавкаНДС,
		"Сумма");
	ПересчитатьСуммы(
		ТекущиеДанные.СуммаСНачалаГода,
		ТекущиеДанные.СуммаНДССНачалаГода,
		ТекущиеДанные.ВсегоСНачалаГода,
		ТекущиеДанные.СтавкаНДС,
		"Сумма");
КонецПроцедуры

