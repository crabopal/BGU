
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ПустаяСтрока(Параметры.ИмяМенеджера) Тогда
		ВызватьИсключение "Форма не предназначена для непосредственного использования";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.Заголовок) Тогда
		Заголовок = Параметры.Заголовок;
	КонецЕсли;
	
	Организация = Параметры.Организация;
	Дата = Параметры.Дата;
	ИФО = Параметры.ИФО;
	Ссылка = Параметры.Ссылка;
	//@skip-check property-return-type
	ДополнительныеСвойства = Параметры.ДополнительныеСвойства; // Произвольный

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Организация);
	ПараметрыФормы.Вставить("Дата", Дата);
	ПараметрыФормы.Вставить("ИФО", ИФО);
	ПараметрыФормы.Вставить("Ссылка", Ссылка);
	ПараметрыФормы.Вставить("ДополнительныеСвойства", ДополнительныеСвойства);

	МенеджерДокумента = ОбщегоНазначения.ВычислитьВБезопасномРежиме(Параметры.ИмяМенеджера); // ДокументМенеджер.АктПриемкиТоваровРаботУслуг
	
	ПараметрыНастройки = МенеджерДокумента.ПараметрыНастройкиГрупповогоИзмененияРеквизитов(ПараметрыФормы);
	
	ОписанияРеквизитов.Загрузить(ПараметрыНастройки.ОписаниеРеквизитов);
	
	ЗаполнитьСтрокиТаблицы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаРеквизитов

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ИмяФормыВыбора) Тогда
		ПолучитьДанныеВыбораВСтроке(ТекущиеДанные, ДанныеВыбора, СтандартнаяОбработка);
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	
	//@skip-check property-return-type
	ПараметрыФормыВыбора = ПараметрыВыбораВОтбор(ТекущиеДанные); // Структура
	ОткрытьФорму(ТекущиеДанные.ИмяФормыВыбора, ПараметрыФормыВыбора, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ТекущиеДанные.ТипРеквизита.Типы().Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	ПолучитьДанныеВыбораВСтроке(ТекущиеДанные, ДанныеВыбора, СтандартнаяОбработка, Текст);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ТекущиеДанные.ТипРеквизита.Типы().Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	ПолучитьДанныеВыбораВСтроке(ТекущиеДанные, ДанныеВыбора, СтандартнаяОбработка, Текст);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ЗначениеРеквизита) Тогда
		ТекущиеДанные.ИзменятьРеквизит = Истина;
	КонецЕсли; 
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	ВозвращаемоеЗначение = Новый Структура;
	Для каждого СтрокаТаблицы Из ТаблицаРеквизитов Цикл
	
		Если СтрокаТаблицы.ИзменятьРеквизит Тогда
			ВозвращаемоеЗначение.Вставить(СтрокаТаблицы.ИмяРеквизита, СтрокаТаблицы.ЗначениеРеквизита);
		КонецЕсли;
	
	КонецЦикла;
	Закрыть(ВозвращаемоеЗначение);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПолучитьДанныеВыбораВСтроке(ТекущиеДанные, ДанныеВыбора, СтандартнаяОбработка, Текст = "")
	ПараметрыФормыВыбора = ПараметрыВыбораВОтбор(ТекущиеДанные); // Структура
	Если ЗначениеЗаполнено(Текст) Тогда
		ПараметрыФормыВыбора.Вставить("СтрокаПоиска", Текст);
	КонецЕсли;
	ПолученныеДанныеВыбора = ПолучитьДанныеВыбора(ТекущиеДанные.ТипРеквизита.Типы()[0], ПараметрыФормыВыбора);
	Если ПолученныеДанныеВыбора <> Неопределено Тогда
		ДанныеВыбора = ПолученныеДанныеВыбора;
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

// Параметры выбора в отбор.
// 
// Параметры:
//  ТекущиеДанные - ДанныеФормыЭлементКоллекции: см. Документ.АктПриемкиТоваровРаботУслуг.Форма.ГрупповоеИзменениеРеквизитовТабличнойЧасти.ОписанияРеквизитов
// 
// Возвращаемое значение:
//  Структура
&НаКлиенте
Функция ПараметрыВыбораВОтбор(ТекущиеДанные)
	Результат = Новый Структура;
	ГрупповыеКлючи = Новый Структура;
	//@skip-check property-return-type
	ЗаданныеПараметрыВыбора = ТекущиеДанные.ПараметрыВыбора; // ФиксированныйМассив, Массив из ПараметрВыбора
	Если ТипЗнч(ЗаданныеПараметрыВыбора) = Тип("ФиксированныйМассив")
			Или ТипЗнч(ЗаданныеПараметрыВыбора) = Тип("Массив") Тогда
		Для Каждого ЗаданныйПараметр Из ЗаданныеПараметрыВыбора Цикл
			ИмяПараметра = ЗаданныйПараметр.Имя;
			Получатель = ПолучательВыбранногоОтбора(ИмяПараметра, Результат, ГрупповыеКлючи); 
			Получатель.Вставить(ИмяПараметра, ЗаданныйПараметр.Значение);
		КонецЦикла;
	КонецЕсли;
	//@skip-check property-return-type
	ЗаданныеСвязиПараметровВыбора = ТекущиеДанные.СвязиПараметровВыбора; // Массив из см. ОписаниеСвязиПараметровВыбора
	Если ТипЗнч(ЗаданныеСвязиПараметровВыбора) = Тип("ФиксированныйМассив")
			Или ТипЗнч(ЗаданныеСвязиПараметровВыбора) = Тип("Массив") Тогда
		Для Каждого ЗаданнаяСвязьПараметровВыбора Из ЗаданныеСвязиПараметровВыбора Цикл
			ИмяПараметра = ЗаданнаяСвязьПараметровВыбора.Имя;
			Получатель = ПолучательВыбранногоОтбора(ИмяПараметра, Результат, ГрупповыеКлючи);
			Если ЗаданнаяСвязьПараметровВыбора.Значение = "Дата" Тогда
				Получатель.Вставить(ИмяПараметра, Дата);
			ИначеЕсли ЗаданнаяСвязьПараметровВыбора.Значение = "Организация" Тогда
				Получатель.Вставить(ИмяПараметра, Организация);
			ИначеЕсли ЗаданнаяСвязьПараметровВыбора.Значение = "ИФО" Тогда
				Получатель.Вставить(ИмяПараметра, ИФО);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого КлючИЗначение Из ГрупповыеКлючи Цикл
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Получатель выбранного отбора.
// 
// Параметры:
//  ИмяПараметра - Строка - Изменяемый параметр
//  ВсеПараметры - Структура
//  ГрупповыеКлючи - Структура
// 
// Возвращаемое значение:
//  Структура - Получатель выбранного отбора
&НаКлиенте
Функция ПолучательВыбранногоОтбора(ИмяПараметра, ВсеПараметры, ГрупповыеКлючи)
	Если СтрНайти(ИмяПараметра, ".") = 0 Тогда
		Возврат ВсеПараметры;
	КонецЕсли;
	СоставИмени = СтрРазделить(ИмяПараметра, ".");
	Ключ = Неопределено;
	Если Не ГрупповыеКлючи.Свойство(СоставИмени[0], Ключ) Тогда
		Ключ = Новый Структура;
		ГрупповыеКлючи.Вставить(СоставИмени[0], Ключ);
	КонецЕсли;
	ИмяПараметра = СоставИмени[1];
	Возврат Ключ;
КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокиТаблицы()
	
	Для Каждого СтрокаОписания Из ОписанияРеквизитов Цикл
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.ИмяРеквизита = СтрокаОписания.Имя;
		НоваяСтрока.ПредставлениеРеквизита = СтрокаОписания.Заголовок;
		НоваяСтрока.ТипРеквизита = СтрокаОписания.Тип;
		НоваяСтрока.ИмяФормыВыбора = СтрокаОписания.ИмяФормыВыбора;
		//@skip-check property-return-type
		НоваяСтрока.ПараметрыВыбора = СтрокаОписания.ПараметрыВыбора;
		//@skip-check property-return-type
		НоваяСтрока.СвязиПараметровВыбора = СвязиПараметровВыбораВМассив(СтрокаОписания.СвязиПараметровВыбора);
		// Очистить переданные связи параметров выбора, чтобы не было ошибки при переходе с сервера на клиент
		СтрокаОписания.СвязиПараметровВыбора = Неопределено;
	КонецЦикла;

КонецПроцедуры

// Связи параметров выбора в массив.
// 
// Параметры:
//  СвязиПараметровВыбора - ФиксированныйМассив из СвязьПараметраВыбора
// 
// Возвращаемое значение:
//  ФиксированныйМассив из см. ОписаниеСвязиПараметровВыбора
&НаСервере
Функция СвязиПараметровВыбораВМассив(СвязиПараметровВыбора)
	Результат = Новый Массив;
	Если ТипЗнч(СвязиПараметровВыбора) = Тип("Массив")
			Или ТипЗнч(СвязиПараметровВыбора) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Связь Из СвязиПараметровВыбора Цикл
			НовоеОписание = ОписаниеСвязиПараметровВыбора();
			НовоеОписание.Имя = Связь.Имя;
			НовоеОписание.Значение = Связь.ПутьКДанным;
			Результат.Добавить(НовоеОписание);
		КонецЦикла;				
	КонецЕсли;
	Возврат Новый ФиксированныйМассив(Результат);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеСвязиПараметровВыбора()
	Возврат Новый Структура("Имя, Значение", "", "");
КонецФункции

#КонецОбласти
