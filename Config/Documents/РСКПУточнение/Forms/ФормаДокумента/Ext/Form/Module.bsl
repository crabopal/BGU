КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыУточняемыеРеквизиты

&НаКлиенте
Процедура РеквизитыПлатежногоДокументаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока тогда
		Элементы.УточняемыеРеквизиты.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		ОтборДляИзмененныеРеквизиты(Элементы.УточняемыеРеквизиты.ТекущиеДанные.ИдентификаторСтроки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыПлатежногоДокументаПередУдалением(Элемент, Отказ)
	ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Элемент.ТекущиеДанные.ИдентификаторСтроки); 	
	МассивКУдалению = Объект.УточненныеРеквизиты.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
		Объект.УточненныеРеквизиты.Удалить(СтрокаКУдалению);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыПлатежногоДокументаПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено тогда
		ОтборДляИзмененныеРеквизиты(Элемент.ТекущиеДанные.ИдентификаторСтроки);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура УточняемыеРеквизитыСуммаВалПриИзменении(Элемент)
	СтрокаТаблицы = Элементы.УточненныеРеквизиты.ТекущиеДанные;
	СтрокаТаблицы.Сумма = СтрокаТаблицы.СуммаВал*Объект.Курс/?(Объект.Кратность=0, 1, Объект.Кратность);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыУточненныеРеквизиты

&НаКлиенте
Процедура ИзмененныеРеквизитыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока и Элементы.УточняемыеРеквизиты.ТекущиеДанные <> Неопределено тогда
		Элементы.УточненныеРеквизиты.ТекущиеДанные.ИдентификаторСтроки = Элементы.УточняемыеРеквизиты.ТекущиеДанные.ИдентификаторСтроки;		
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ИзмененныеРеквизитыКБКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.УточненныеРеквизиты.ТекущиеДанные;

	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													ТекущиеДанные.КБКНазначениеПлатежа, 
													Объект.Организация,
													Объект.ИФО,
													,
													,
													Объект.Дата);
	
КонецПроцедуры

