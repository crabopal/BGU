&НаСервере
Процедура ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию()
	
	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.РСКПУточнение", 
	Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский,,, Неопределено);
	
	Объект.ЛицевойСчет = Умолчания.ЛицевойСчет;
	
	ПриИзмененииЛицевогоСчета();
	
КонецПроцедуры	

&НаКлиенте
ПРоцедура ПриИзмененииЗапросНаВыяснениеПринадлежностиПлатежа()
	Объект.НомерЗапроса = "";
 	Объект.ДатаЗапроса  = "";
    Объект.РеквизитыПлатежногоДокумента.Очистить();
 	Объект.ИзмененныеРеквизиты.Очистить();
	
	Если не ЗначениеЗаполнено(Объект.ЗапросНаВыяснениеПринадлежностиПлатежа) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.РеквизитыПлатежногоДокумента.ТекущаяСтрока = ЗаполнитьНаОсновании(Объект.ЗапросНаВыяснениеПринадлежностиПлатежа);
	УстановитьВидимостьРеквизитов();
	
КонецПРоцедуры	

