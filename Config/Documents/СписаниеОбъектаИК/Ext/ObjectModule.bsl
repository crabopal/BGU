#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ 

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ДатаСписанияСБухУчета) Тогда
		ЭтотОбъект.ДатаСписанияСБухУчета = ЭтотОбъект.Дата;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.СписаниеОбъектаИК.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Движения по регистрам накопления
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СтоимостьОбъектовОС");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "АмортизацияОбъектовОС");
	
	// Движения по регистрам сведений
	Если Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, Дата).ВедениеАналитическогоУчетаИмуществаКазны Тогда		
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "МестонахождениеОС");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СобытияОС");
	КонецЕсли;
	
КонецПроцедуры
    
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") 
		ИЛИ НЕ БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("108.00").УчетПоПодразделениям Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Подразделение");
	КонецЕсли;
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	Если Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, Дата).ВедениеАналитическогоУчетаИмуществаКазны Тогда
		Если НЕ МожноПровестиПередачу() Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ДатаСписанияСБухУчета = '00010101';
	ИнвентарныйНомер = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	Сумма = 0;
	СуммаАмортизации = 0;
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Перем Основание;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ДанныеЗаполнения.Свойство("Основание", Основание);
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ИнвентаризацияИК") Тогда
			СтандартнаяОбработка = Ложь;
			Документы.ИнвентаризацияИК.ВводНаОсновании_ЗаполнитьДокумент(ЭтотОбъект, ДанныеЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


Функция МожноПровестиПередачу()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МестонахождениеОССрезПоследних.ОсновноеСредство,
	               |	МестонахождениеОССрезПоследних.Организация,
	               |	МестонахождениеОССрезПоследних.ИнвНомер,
	               |	МестонахождениеОССрезПоследних.Состояние
	               |ПОМЕСТИТЬ Местонахождение
	               |ИЗ
	               |	РегистрСведений.МестонахождениеОС.СрезПоследних(
	               |			&Период,
	               |			Организация = &Организация
	               |				И ОсновноеСредство = &ОсновноеСредство
	               |				И ИнвНомер = &ИнвНомер
	               |				И Регистратор <> &Ссылка) КАК МестонахождениеОССрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.ДатаСобытия,
	               |	ВложенныйЗапрос1.ДатаСобытия КАК ДатаСобытия1
	               |ПОМЕСТИТЬ ПередачаВАренду
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		МАКСИМУМ(СобытияОС.ДатаСобытия) КАК ДатаСобытия
	               |	ИЗ
	               |		РегистрСведений.СобытияОС КАК СобытияОС
	               |	ГДЕ
	               |		СобытияОС.Период < &Период
	               |		И СобытияОС.ОсновноеСредство = &ОсновноеСредство
	               |		И СобытияОС.Организация = &Организация
	               |		И СобытияОС.ИнвНомер = &ИнвНомер
	               |		И СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.СдачаВАренду)
	               |		И СобытияОС.Регистратор <> &Ссылка) КАК ВложенныйЗапрос
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			МАКСИМУМ(СобытияОС.ДатаСобытия) КАК ДатаСобытия
	               |		ИЗ
	               |			РегистрСведений.СобытияОС КАК СобытияОС
	               |		ГДЕ
	               |			СобытияОС.Период <= &Период
	               |			И СобытияОС.ОсновноеСредство = &ОсновноеСредство
	               |			И СобытияОС.Организация = &Организация
	               |			И СобытияОС.ИнвНомер = &ИнвНомер
	               |			И СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВозвратИзАренды)) КАК ВложенныйЗапрос1
	               |		ПО ВложенныйЗапрос.ДатаСобытия < ВложенныйЗапрос1.ДатаСобытия
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.ДатаСобытия,
	               |	ВложенныйЗапрос1.ДатаСобытия КАК ДатаСобытия1
	               |ПОМЕСТИТЬ ПередачаВБезвозмездноеПользование
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		МАКСИМУМ(СобытияОС.ДатаСобытия) КАК ДатаСобытия
	               |	ИЗ
	               |		РегистрСведений.СобытияОС КАК СобытияОС
	               |	ГДЕ
	               |		СобытияОС.Период < &Период
	               |		И СобытияОС.ОсновноеСредство = &ОсновноеСредство
	               |		И СобытияОС.Организация = &Организация
	               |		И СобытияОС.ИнвНомер = &ИнвНомер
	               |		И СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПередачаВБезвозмездноеПользование)
	               |		И СобытияОС.Регистратор <> &Ссылка) КАК ВложенныйЗапрос
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			МАКСИМУМ(СобытияОС.ДатаСобытия) КАК ДатаСобытия
	               |		ИЗ
	               |			РегистрСведений.СобытияОС КАК СобытияОС
	               |		ГДЕ
	               |			СобытияОС.Период <= &Период
	               |			И СобытияОС.ОсновноеСредство = &ОсновноеСредство
	               |			И СобытияОС.Организация = &Организация
	               |			И СобытияОС.ИнвНомер = &ИнвНомер
	               |			И СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВозвратИзБезвозмездногоПользования)) КАК ВложенныйЗапрос1
	               |		ПО ВложенныйЗапрос.ДатаСобытия < ВложенныйЗапрос1.ДатаСобытия
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Местонахождение.Состояние,
	               |	ПередачаВАренду.ДатаСобытия КАК ПереданоВАренду,
	               |	ПередачаВБезвозмездноеПользование.ДатаСобытия КАК ПереданоБезвозмездно
	               |ИЗ
	               |	Местонахождение КАК Местонахождение
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПередачаВАренду КАК ПередачаВАренду
	               |		ПО (ПередачаВАренду.ДатаСобытия ЕСТЬ НЕ NULL )
	               |			И (ПередачаВАренду.ДатаСобытия1 ЕСТЬ NULL )
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПередачаВБезвозмездноеПользование КАК ПередачаВБезвозмездноеПользование
	               |		ПО (ПередачаВБезвозмездноеПользование.ДатаСобытия ЕСТЬ НЕ NULL )
	               |			И (ПередачаВБезвозмездноеПользование.ДатаСобытия1 ЕСТЬ NULL )";
	Запрос.УстановитьПараметр("Период", ?(ДатаСписанияСБухУчета='00010101',?(Ссылка.Пустая(), КонецДня(Дата),Дата),ДатаСписанияСБухУчета));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвНомер", ИнвентарныйНомер);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Результат = Запрос.Выполнить();
		
	Если Результат.Пустой() Тогда
		ТекстСообщения = НСтр("ru='[ОС], инв. №[ИнвНомер] не принято к учету'");
		
		ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
															ТекстСообщения, Новый Структура("ОС, ИнвНомер",
																							ОсновноеСредство,
																							ИнвентарныйНомер)));
		Возврат Ложь;
	КонецЕсли;
	
		
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Если Выборка.Состояние = Перечисления.СостоянияОС.СнятоСУчета Тогда
		ТекстСообщения = НСтр("ru='[ОС], инв. №[ИнвНомер] уже снято с учета'");
		ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
															ТекстСообщения, Новый Структура("ОС, ИнвНомер",
																							ОсновноеСредство,
																							ИнвентарныйНомер)));
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.ПереданоВАренду) Тогда
		ТекстСообщения = НСтр("ru='[ОС], инв. №[ИнвНомер] передано в аренду [ДатаПередачи]'");
		ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
															ТекстСообщения, Новый Структура("ОС, ИнвНомер, ДатаПередачи",
																							ОсновноеСредство,
																							ИнвентарныйНомер,
																							Формат(Выборка.ПереданоВАренду,"ДЛФ=D"))));
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.ПереданоБезвозмездно) Тогда
		ТекстСообщения = НСтр("ru='[ОС], инв. №[ИнвНомер] передано в безвозмездное пользование [ДатаПередачи]'");
		ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
															ТекстСообщения, Новый Структура("ОС, ИнвНомер, ДатаПередачи",
																							ОсновноеСредство,
																							ИнвентарныйНомер,
																							Формат(Выборка.ПереданоБезвозмездно,"ДЛФ=D"))));
		Возврат Ложь;
	КонецЕсли;

	
	Возврат Истина;
КонецФункции

#КонецЕсли
