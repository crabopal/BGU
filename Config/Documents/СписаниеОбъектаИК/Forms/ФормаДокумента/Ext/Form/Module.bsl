&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)

	Элементы = Форма.Элементы;
	
	ДоступностьРеквизитов = ЗначениеЗаполнено(Объект.Организация);
	Элементы.Подразделение.Доступность						= ДоступностьРеквизитов;
	Элементы.ОсновноеСредство.Доступность					= ДоступностьРеквизитов;
	Элементы.КПС.Доступность								= ДоступностьРеквизитов;
	Элементы.КФО.Доступность								= ДоступностьРеквизитов;
	Элементы.ВыбратьКомиссию.Доступность					= ДоступностьРеквизитов;
	Элементы.ВыбратьПредседателяКомиссии.Доступность		= ДоступностьРеквизитов;
	Элементы.СоставКомиссииПодобратьСотрудников.Доступность	= ДоступностьРеквизитов;
	
КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()
 
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОсновногоСредства(Форма, Объект)

	Элементы = Форма.Элементы;
	ВестиАналитическийИИнвентарныйУчет = Форма.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны;
	
	ДоступностьРеквизитов = ЗначениеЗаполнено(Объект.ОсновноеСредство);
	Элементы.ИнвентарныйНомер.Доступность 				= ДоступностьРеквизитов И ВестиАналитическийИИнвентарныйУчет;
	Элементы.КомандаРассчитатьСтоимостьОС.Доступность 	= ДоступностьРеквизитов;
    УстановитьТолькоЧтениеСуммыИАмортизации(Форма);
КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОсновногоСредства()

&НаКлиенте
Процедура ОбнулитьСуммы()

	Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
		Объект.Сумма 			= 0;
		Объект.СуммаАмортизации	= 0;
	КонецЕсли;

КонецПроцедуры // ОбнулитьСуммы()

&НаКлиенте
Процедура РассчитатьСуммы(СообщатьОбОшибках = Ложь)

	Если НеВсеРеквизитыДляЗаполненияЗаполнены(СообщатьОбОшибках) Тогда
		Возврат;
	КонецЕсли;
	РассчитатьБалансовуюСтоимостьИАмортизацию(НЕ ЗначениеЗаполнено(Объект.ИнвентарныйНомер));
КонецПроцедуры // РассчитатьСуммы()

&НаКлиенте
Процедура ПриИзмененииОсновногоСредства(ЗаполнятьРеквизитыОС, ПолучатьИнвНомер, РассчитыватьСтоимость, СообщатьОбОшибках)

	Если ПолучатьИнвНомер И ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
		ПолучатьИнвНомер = НЕ НеВсеРеквизитыДляИнвНомераЗаполнены(СообщатьОбОшибках);
	КонецЕсли;
	Если РассчитыватьСтоимость Тогда
		РассчитыватьСтоимость = НЕ НеВсеРеквизитыДляЗаполненияЗаполнены(СообщатьОбОшибках);
	КонецЕсли;
	
	Если ЗаполнятьРеквизитыОС ИЛИ ПолучатьИнвНомер ИЛИ РассчитыватьСтоимость Тогда
		ОбработатьИзменениеОсновногоСредстваНаСервере(ЗаполнятьРеквизитыОС, ПолучатьИнвНомер, РассчитыватьСтоимость);
	КонецЕсли;

КонецПроцедуры // ПриИзмененииОсновногоСредства()

&НаСервере
Процедура ОбработатьИзменениеОсновногоСредстваНаСервере(ЗаполнятьРеквизитыОС, ПолучатьИнвНомер, РассчитыватьСтоимость)

	Если ЗаполнятьРеквизитыОС Тогда
		ПрочитатьРеквизитыОС(Объект.Организация,Объект.ОсновноеСредство, ГрупповойУчет, ОС_СчетУчета,Объект.Дата);
	КонецЕсли;
	
	Если ПолучатьИнвНомер И ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
		
		ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, Объект.ДатаСписанияСБухУчета);
		ЗаполнитьЗначенияСвойств(ПараметрыПолученияОстатков, Объект, "ОсновноеСредство, Организация");
		
		Объект.ИнвентарныйНомер = УправлениеОсновнымиСредствами.ПолучитьДанныеИнвентарногоНомераОС(ПараметрыПолученияОстатков).ИнвентарныйНомер;
		
	КонецЕсли;
	
	Если РассчитыватьСтоимость Тогда
		РассчитатьБалансовуюСтоимостьИАмортизацию(ПолучатьИнвНомер);
	КонецЕсли;

КонецПроцедуры // ОбработатьИзменениеОсновногоСредстваНаСервере()

&НаСервере
Процедура РассчитатьБалансовуюСтоимостьИАмортизацию(УстанавливатьИнвентарныйНомер = Истина)
	
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, Объект.ДатаСписанияСБухУчета);
	ПараметрыПолученияОстатков.ПолучатьАмортизацию = Истина;
	ПараметрыПолученияОстатков.УстанавливатьИнвентарныйНомер = УстанавливатьИнвентарныйНомер;
	ПараметрыПолученияОстатков.УстанавливатьКПС = Истина;
	
	ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстатки(ПараметрыПолученияОстатков); 
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ОсновноеСредство",	"ОсновноеСредство");
	ПараметрыЗаполнения.Вставить("ИнвентарныйНомер",	"ИнвентарныйНомер");
	ПараметрыЗаполнения.Вставить("Сумма",				"Сумма");
	ПараметрыЗаполнения.Вставить("КПС",					"КПС");
	ПараметрыЗаполнения.Вставить("СуммаАмортизации",	"СуммаАмортизации");
	ПараметрыЗаполнения.Вставить("ИсходноеКоличество",	1);
	
	ПараметрыЗаполнения.Вставить("УстанавливатьИнвентарныйНомер", УстанавливатьИнвентарныйНомер);
	ПараметрыЗаполнения.Вставить("УстанавливатьКПС",	Истина);
		
	УправлениеОсновнымиСредствами.ЗаполнитьОбъектИзТаблицыОстатков(ТаблицаОстатков, Объект, ПараметрыЗаполнения);
	
КонецПроцедуры // РассчитатьБалансовуюСтоимостьИАмортизацию()

&НаКлиенте
Функция НеВсеРеквизитыДляЗаполненияЗаполнены(СообщатьОбОшибках = Истина)

	Отказ = Ложь;
	Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") И НЕ ЗначениеЗаполнено(Объект.ИФО) Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = НСтр("ru='Не заполнен обязательный реквизит ИФО'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ИФО",,Отказ);
		Иначе
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;
	КонецЕсли;
	Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("108.00").УчетПоПодразделениям
		И НЕ ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = НСтр("ru='Не заполнен обязательный реквизит Подразделение'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.Подразделение",,Отказ);
		Иначе
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КФО) Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = НСтр("ru='Не заполнен обязательный реквизит КФО'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.КФО",,Отказ);
		Иначе
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ОсновноеСредство) Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = НСтр("ru='Не заполнен обязательный реквизит Объект'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ОсновноеСредство",,Отказ);
		Иначе
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;
	КонецЕсли;
		
	Возврат Отказ;	

КонецФункции // НеВсеРеквизитыДляЗаполненияЗаполнены()

&НаКлиенте
Функция НеВсеРеквизитыДляИнвНомераЗаполнены(СообщатьОбОшибках = Истина)

	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Объект.ОсновноеСредство) Тогда
		Если СообщатьОбОшибках Тогда
			ТекстСообщения = НСтр("ru='Не заполнен обязательный реквизит Объект'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ОсновноеСредство",,Отказ);
		Иначе
			Отказ = Истина;
			Возврат Отказ;
		КонецЕсли;
	КонецЕсли;
    Возврат Отказ;
	
КонецФункции // НеВсеРеквизитыДляИнвНомераЗаполнены()

&НаСервереБезКонтекста
Процедура ПрочитатьРеквизитыОС(Организация, ОсновноеСредство, ГрупповойУчет, СчетУчета, НаДату)
	
	ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ОсновноеСредство, НаДату);
	ГрупповойУчет   = ДанныеОбъектаОС.ГрупповойУчет;
	СчетУчета       = ДанныеОбъектаОС.СчетУчета;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКПСиКФО()

	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		
		ДопустимыеКФО = БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(
			Объект.Организация, Объект.ИФО, ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ДатаПоследнегоИзменения);
		
		Если ДопустимыеКФО.Найти(ПредопределенноеЗначение("Перечисление.КВД.Бюджет"))<>Неопределено Тогда
			Объект.КФО = ПредопределенноеЗначение("Перечисление.КВД.Бюджет");
		Иначе
			Объект.КФО = ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка");
		КонецЕсли;
	Иначе
		Объект.КФО = ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка");
	КонецЕсли;

КонецПроцедуры // УстановитьКПСиКФО()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТолькоЧтениеСуммыИАмортизации(Форма)

	Элементы = Форма.Элементы;
	ВестиАналитическийИИнвентарныйУчет = Форма.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны;
	
	Элементы.Сумма.РедактированиеТекста				= НЕ ВестиАналитическийИИнвентарныйУчет;
	Элементы.СуммаАмортизации.РедактированиеТекста	= НЕ ВестиАналитическийИИнвентарныйУчет;

КонецПроцедуры // УстановитьТолькоЧтениеСуммыИАмортизации()

