#Область ПрограммныйИнтерфейс

Процедура ИнициализироватьФормуДокумента(ФормаДокумента) Экспорт
	
	ФормаДокумента.ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ФормаДокумента.ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	
	ФормаДокумента.НадписьИтогоВРублях = НСтр("ru='Итого в рублях:'");
	
	ФормаДокумента.ЦветТекстаФильтрУстановлен = ЦветаСтиля.ГиперссылкаЦвет;
	ФормаДокумента.ЦветТекстаФильтрНеУстановлен = ЦветаСтиля.ТекстИнформационнойНадписи;
	
	ФормаДокумента.СписокСчетовИсключенийСтрокой = ПолучитьСписокСчетовИсключенийСтрокой();
	
	ОграничитьВыборСчета_Раздел1СальдоКонечноеПоСчетам(ФормаДокумента);
	ОграничитьВыборСчета_СписокСчетов(ФормаДокумента);
	
	ИнициализироватьИменаПолейПоказываемыхВДиалоге(ФормаДокумента);
	
	УстановитьУсловноеОформление(ФормаДокумента);
	
КонецПроцедуры

Процедура ПроверитьЗаполнение(ДокументОбъект, Отказ) Экспорт
	
	ПараметрыПроверкиЗаполнения = НовыйПараметрыПроверкиЗаполнения();
	
	ПроверитьКорректностьГраницПериодаСверки(ДокументОбъект, Отказ);
	
	ПроверитьПризнакиКонтрагента(ДокументОбъект, Отказ);
	
	ПроверитьРаздел1СальдоНачальноеБезСчетов(ДокументОбъект, ПараметрыПроверкиЗаполнения, Отказ);
	
	ПроверитьСовместноеЗаполнениеТаблицРаздела1(ДокументОбъект, ПараметрыПроверкиЗаполнения);
	
КонецПроцедуры

Функция ПрочитатьРеквизитыКонтрагента(КонтрагентСсылка, НаДату) Экспорт
	
	РеквизитыКонтрагента = НовыйРеквизитыКонтрагента();
	
	Если Не ЗначениеЗаполнено(КонтрагентСсылка) Тогда
		Возврат РеквизитыКонтрагента;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("КонтрагентСсылка",	КонтрагентСсылка);
	ЗапросПоиск.УстановитьПараметр("НаДату",			НаДату);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. История КПП
	|//
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(&НаДату КАК ДАТА)					КАК	НаДату,
	|	МИНИМУМ(КППИстория.ДатаОкончанияДействия)	КАК ДатаОкончанияДействия
	|ПОМЕСТИТЬ
	|	ДатыОкончанияДействияКПП
	|ИЗ
	|	Справочник.Контрагенты.КППИстория КАК КППИстория
	|ГДЕ
	|	КППИстория.Ссылка = &КонтрагентСсылка
	|	И &НаДату < ДОБАВИТЬКДАТЕ(КППИстория.ДатаОкончанияДействия, ДЕНЬ, 1)
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(&НаДату КАК ДАТА)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Реквизиты контрагента
	|//
	|ВЫБРАТЬ
	|	СправочникКонтрагенты.ИНН						КАК ИНН,
	|	ВЫБОР
	|		КОГДА &НаДату = ДАТАВРЕМЯ(1,1,1) ТОГДА
	|			СправочникКонтрагенты.КПП
	|		ИНАЧЕ
	|			ЕСТЬNULL(ТаблицаКППИстория.КПП, СправочникКонтрагенты.КПП)
	|	КОНЕЦ											КАК КПП,
	|	ЕСТЬNULL(СправочникЮридическиеЛица.ОГРН, """")	КАК ОГРН
	|ИЗ
	|	Справочник.Контрагенты КАК СправочникКонтрагенты
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК СправочникЮридическиеЛица
	|		ПО СправочникКонтрагенты.ЮридическоеФизическоеЛицо = СправочникЮридическиеЛица.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ ДатыОкончанияДействияКПП
	|		ПО &НаДату = ДатыОкончанияДействияКПП.НаДату
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КППИстория КАК ТаблицаКППИстория
	|		ПО СправочникКонтрагенты.Ссылка = ТаблицаКППИстория.Ссылка
	|		И ДатыОкончанияДействияКПП.ДатаОкончанияДействия = ТаблицаКППИстория.ДатаОкончанияДействия
	|ГДЕ
	|	СправочникКонтрагенты.Ссылка = &КонтрагентСсылка";
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыКонтрагента, Выборка);
	КонецЕсли;
	
	Возврат РеквизитыКонтрагента;
	
КонецФункции

Процедура ЗаполнитьСписокСчетовПоУмолчанию(ДокументОбъект) Экспорт
	
	ДокументОбъект.СписокСчетов.Очистить();
	
	СписокСчетов = ПолучитьСписокСчетовЗаполнения(ДокументОбъект.ДатаНачала, ДокументОбъект.Организация);
	
	Для Каждого Счет Из СписокСчетов Цикл
		НоваяСтрока = ДокументОбъект.СписокСчетов.Добавить();
		НоваяСтрока.Счет = Счет;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРассчитываемыеТабличныеЧастиПередЗаписью(ДокументОбъект) Экспорт
	
	ЗаполнитьРассчитываемыеТабличныеЧастиРаздела1(ДокументОбъект);
	
	ЗаполнитьРассчитываемыеТабличныеЧастиРаздела2(ДокументОбъект);
	
КонецПроцедуры

Функция ПолучитьСписокСчетовЗаполненияСтрокой() Экспорт
	
	Возврат "205.00, 206.00, 207.00, 209.00, 210.05, 302.00, 304.01";
	
КонецФункции

Функция ПолучитьСписокСчетовИсключенийСтрокой() Экспорт
	
	Возврат "205.11, 205.14, 205.51, 205.52, 205.53, 205.54"
		+ ", 206.10, 206.40, 206.50, 206.80"
		+ ", 209.81, 209.82"
		+ ", 302.11, 302.40, 302.50, 302.80";
	
КонецФункции

#Область ЗаполнениеРаздела1

Процедура ПроверитьПередЗаполнениемРаздела1(Знач ДокументОбъект, Отказ) Экспорт
	
	Отказ = Ложь;
	
	ИнвентаризацияСервер.ПроверитьЗаполненностьРеквизитовШапки(ДокументОбъект,
		"ДатаНачала,ДатаОкончания,Организация,Контрагент", Отказ);
	
	ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "СписокСчетов", Отказ);
	
	ПроверитьКорректностьГраницПериодаСверки(ДокументОбъект, Отказ);
	
	ПроверитьСписокСчетов(ДокументОбъект, Отказ);
	
	ПроверитьСписокДоговоров(ДокументОбъект, Отказ);
	
	ПроверитьПризнакиКонтрагента(ДокументОбъект, Отказ);
	
КонецПроцедуры

Функция ПолучитьДанныеДляРаздела1(ПараметрыПроцедуры) Экспорт
	
	Возврат ПрочитатьСведенияБухУчета(ПараметрыПроцедуры);
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеРаздела2

Процедура ЗаполнитьРаздел2ПоДаннымРаздела1(ДокументОбъект) Экспорт
	
	ЗаполнитьРаздел2ОперацииПоДаннымРаздела1(ДокументОбъект);
	
	ЗаполнитьРаздел2СальдоПоДаннымРаздела1(ДокументОбъект, "Раздел2СальдоНачальное",
		"Раздел1СальдоНачальноеБезСчетов");
	
	ЗаполнитьРаздел2СальдоПоДаннымРаздела1(ДокументОбъект, "Раздел2СальдоКонечное",
		"Раздел1СальдоКонечноеПоСчетам");
	
	ЗаполнитьРассчитываемыеТабличныеЧастиРаздела2(ДокументОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Параллельный отложенный обработчик обновления.
	// Заполняет новую табличную часть Раздел1СписокДоговоров.
	
	Запрос = Новый Запрос();
	Запрос.Текст = ПолучитьТекстЗапросаЗарегистрироватьДанныеДляОбработкиЗаполнениеРаздел1СписокДоговоров();
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Параллельный отложенный обработчик обновления.
	// Заполняет новую табличную часть Раздел1СписокДоговоров.
	
	Параметры.ОбработкаЗавершена = Ложь;
	МетаданныеДокумента = Метаданные.Документы.АктСверкиРасчетов;
	ПолноеИмяОбъекта = МетаданныеДокумента.ПолноеИмя();
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта, МенеджерВременныхТаблиц, ДополнительныеПараметры);
	
	Если Не Результат.ЕстьДанныеДляОбработки Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	Если Не Результат.ЕстьЗаписиВоВременнойТаблице Тогда
		Параметры.ОбработкаЗавершена = Ложь;
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ПолучитьТекстЗапросаЗаполнениеРаздел1СписокДоговоров();
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КоличествоПервых", "500");
	
	ВыборкаДокумент = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПроблемныхОбъектов = 0;
	ОбъектовОбработано = 0;
	ПлохиеДанные = Новый Соответствие;
	
	Пока ВыборкаДокумент.Следующий() Цикл
		НачатьТранзакцию();
		
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ВыборкаДокумент.Ссылка);
			Блокировка.Заблокировать();
			
			ДокументОбъект = ВыборкаДокумент.Ссылка.ПолучитьОбъект();
			
			// Если объект ранее был удален или обработан другими сеансами, пропускаем его.
			Если ДокументОбъект = Неопределено
				Или ДокументОбъект.Раздел1СписокДоговоров.Количество() > 0 Тогда

				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ВыборкаДокумент.Ссылка);
				ЗафиксироватьТранзакцию();
				ОбъектовОбработано = ОбъектовОбработано + 1;
				Продолжить;
			КонецЕсли;
			
			ДокументОбъект.Раздел1СписокДоговоров.Очистить();
			
			Выборка = ВыборкаДокумент.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				НоваяСтрока = ДокументОбъект.Раздел1СписокДоговоров.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			КонецЦикла;
			
			Если ДокументОбъект.Модифицированность() Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ВыборкаДокумент.Ссылка);
			КонецЕсли;

			ОбъектовОбработано = ОбъектовОбработано + 1;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось обработать некоторые акты сверки расчетов (пропущены): %1'"), 
			ПроблемныхОбъектов);
		ВызватьИсключение ТекстСообщения;
	Иначе
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Информация, МетаданныеДокумента,, 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Обработана очередная порция актов сверки расчетов: %1'"),
			ОбъектовОбработано));
	КонецЕсли;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

