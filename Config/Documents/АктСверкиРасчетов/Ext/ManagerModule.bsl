Функция НовыйРеквизитыКонтрагента()
	
	РеквизитыКонтрагента = Новый Структура();
	РеквизитыКонтрагента.Вставить("ИНН", "");
	РеквизитыКонтрагента.Вставить("КПП", "");
	РеквизитыКонтрагента.Вставить("ОГРН", "");
	
	Возврат РеквизитыКонтрагента;
	
КонецФункции

#Область ОбщиеНастройки

Функция ПолучитьСписокСчетовЗаполнения(НаДату = Неопределено, Организация = Неопределено)
	
	Возврат БухгалтерскийУчет.СписокСчетов(ПолучитьСписокСчетовЗаполненияСтрокой(), НаДату, Истина, Организация);
	
КонецФункции

Функция ПолучитьСписокСчетовИсключений(НаДату = Неопределено, Организация = Неопределено)
	
	Возврат БухгалтерскийУчет.СписокСчетов(ПолучитьСписокСчетовИсключенийСтрокой());
	
КонецФункции

Функция ПолучитьИмяПоляСумма(ВидРасчетов, Валютная, Сторона, ВидСальдо = "")
	
	Возврат СтрШаблон("Сумма%1%2%3%4", ВидРасчетов, Валютная, Сторона, ВидСальдо);
	
КонецФункции

