	ЗначенияПараметров.Вставить("ЭлектроннаяПочта",	СтрокаШапки.ИсполнительКонтрагентаЭлектронныйАдрес);
	ЗначенияПараметров.Вставить("Заголовок",		НСтр("ru='Ответственный исполнитель'"));
	
	Область = ОбластиМакета.ПодписьСТелефоном;
	
	Область.Параметры.Заполнить(ЗначенияПараметров);
	
	ТабДокумент.Вывести(Область);
	
КонецПроцедуры

#КонецОбласти

#Область Общее

// Сальдо всего начальное.

Процедура ВывестиВсегоСальдоНачальное(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерРаздела)
	
	Если НомерРаздела = 1 Тогда
		ИмяВыборки = "Раздел1ВсегоСальдоНачальноеБезСчетов";
		
		ОбластьПерваяСтрока		= ОбластиМакета.Раздел1ВсегоСальдоНачальноеПерваяСтрока;
		ОбластьОчереднаяСтрока	= ОбластиМакета.Раздел1ВсегоСальдоНачальноеОчереднаяСтрока;
		ОбластьПодвал			= ОбластиМакета.Раздел1ВсегоСальдоНачальноеПодвал;
		
	ИначеЕсли НомерРаздела = 2 Тогда
		ИмяВыборки = "Раздел2ВсегоСальдоНачальное";
		
		ОбластьПерваяСтрока		= ОбластиМакета.Раздел2ВсегоСальдоНачальноеПерваяСтрока;
		ОбластьОчереднаяСтрока	= ОбластиМакета.Раздел2ВсегоСальдоНачальноеОчереднаяСтрока;
		ОбластьПодвал			= ОбластиМакета.Раздел2ВсегоСальдоНачальноеПодвал;
	КонецЕсли;
	
	ОбщаяВыборкаТЧ = Данные.Выборки[ИмяВыборки];
	
	Выборка = ПолучитьВыборкуПоТекущемуДокументу(СтрокаШапки, ОбщаяВыборкаТЧ);
	
	Если Выборка.Количество() = 0 Тогда
		ВывестиПустоеВсегоСальдоНачальноеБезСчетов(ТабДокумент, Данные, ОбластьПерваяСтрока, ОбластьПодвал);
		
		Возврат;
	КонецЕсли;
	
	МассивОбластей = Новый Массив();
	МассивОбластей.Добавить(Неопределено);
	МассивОбластей.Добавить(ОбластьПодвал);
	
	Счетчик = 0;
	
	ПередНачаломВыводаТаблицы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
	
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		
		Область = ?(Счетчик = 1,
			ОбластьПерваяСтрока,
			ОбластьОчереднаяСтрока);
		
		Область.Параметры.Заполнить(Выборка);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка,
			Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, "КодВалюты");
		
		МассивОбластей[0] = Область;
		
		Если Не ТабДокумент.ПроверитьВывод(МассивОбластей) Тогда
			ПередРазрывомСтраницы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
			
			Если Данные.ДополнительныеПараметры.ОбъединятьГрафу1ПоВысоте Тогда
				Область = ОбластьПерваяСтрока;
				
				Область.Параметры.Заполнить(Выборка);
				
				ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка,
					Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, "КодВалюты");
			КонецЕсли;
			
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабДокумент.Вывести(Область)
	КонецЦикла;
	
	ПослеВыводаТаблицы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
	
	ТабДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры

Процедура ВывестиПустоеВсегоСальдоНачальноеБезСчетов(ТабДокумент, Данные, ОбластьПерваяСтрока, ОбластьПодвал)
	
	ОбластьПерваяСтрока.Параметры.Заполнить(Данные.ДополнительныеПараметры.СтруктураЗаполненияБезСчетов);
	
	МассивОбластей = Новый Массив();
	МассивОбластей.Добавить(ОбластьПерваяСтрока);
	МассивОбластей.Добавить(ОбластьПодвал);
	
	Если Не ТабДокумент.ПроверитьВывод(МассивОбластей) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьПерваяСтрока);
	ТабДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры

// Список договоров.

Процедура ВывестиСписокДоговоров(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерРаздела)
	
	Если НомерРаздела = 1 Тогда
		ИмяВыборки = "Раздел1СписокДоговоров";
		
	ИначеЕсли НомерРаздела = 2 Тогда
		ИмяВыборки = "Раздел2СписокДоговоров";
	КонецЕсли;
	
	ВыборкаСведенияДоговора = ПолучитьВыборкуПоТекущемуДокументу(СтрокаШапки, Данные.Выборки[ИмяВыборки]);
	
	Пока ВыборкаСведенияДоговора.Следующий() Цикл
		ВывестиДоговор(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора, НомерРаздела);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиДоговор(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора, НомерРаздела)
	
	ВывестиЗаголовокДоговора(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора);
	
	ВывестиСальдоНачальноеПоДоговору(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора, НомерРаздела);
	
	ВывестиОперацииПоДоговору(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора, НомерРаздела);
	
	ВывестиОборотыПоДоговору(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора, НомерРаздела);
	
	ВывестиСальдоКонечноеПоДоговору(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора, НомерРаздела);
	
КонецПроцедуры

Процедура ВывестиЗаголовокДоговора(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора)
	
	ОбластьЗаголовок = ОбластиМакета.ЗаголовокДоговора;
	
	ОбластьЗаголовок.Параметры.Заполнить(ВыборкаСведенияДоговора);
	
	Если Не ТабДокумент.ПроверитьВывод(ОбластьЗаголовок) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьЗаголовок, ВыборкаСведенияДоговора,
		Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, "ЗаголовокДоговора");
	
	ТабДокумент.Вывести(ОбластьЗаголовок);
	
КонецПроцедуры

Процедура ВывестиСальдоНачальноеПоДоговору(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора, НомерРаздела)
	
	Если НомерРаздела = 1 Тогда
		ИмяВыборки = "Раздел1СальдоНачальноеБезСчетов";
		
	ИначеЕсли НомерРаздела = 2 Тогда
		ИмяВыборки = "Раздел2СальдоНачальное";
	КонецЕсли;
	
	Выборка = ПолучитьВыборкуПоТекущемуДокументуИДоговору(СтрокаШапки,
		Данные.Выборки[ИмяВыборки],
		ВыборкаСведенияДоговора);
	
	КоличествоСтрок = Выборка.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		ВывестиПустоеСальдоНачальноеПоДоговоруБезСчетов(ТабДокумент, Данные, ОбластиМакета);
		
		Возврат;
	КонецЕсли;
	
	ОбластьПодвала = ОбластиМакета.СальдоНачальноеПодвал;
	
	Счетчик = 0;
	
	ПередНачаломВыводаТаблицы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
	
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		
		Область = ?(Счетчик = 1,
			ОбластиМакета.СальдоНачальноеПерваяСтрока,
			ОбластиМакета.СальдоНачальноеОчереднаяСтрока);
		
		Область.Параметры.Заполнить(Выборка);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка,
			Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, "КодВалюты");
		
		Если Счетчик = КоличествоСтрок Тогда
			МассивОбластей = Новый Массив();
			МассивОбластей.Добавить(Область);
			МассивОбластей.Добавить(ОбластьПодвала);
		Иначе
			МассивОбластей = Область;
		КонецЕсли;
		
		Если Не ТабДокумент.ПроверитьВывод(МассивОбластей) Тогда
			ПередРазрывомСтраницы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
			
			Если Данные.ДополнительныеПараметры.ОбъединятьГрафу1ПоВысоте Тогда
				Область = ОбластиМакета.СальдоНачальноеПерваяСтрока;
				
				Область.Параметры.Заполнить(Выборка);
				
				ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка,
					Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, "КодВалюты");
			КонецЕсли;
			
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
	ПослеВыводаТаблицы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
	
	ТабДокумент.Вывести(ОбластьПодвала);
	
КонецПроцедуры

Процедура ВывестиСальдоКонечноеПоДоговору(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора, НомерРаздела)
	
	ВывестиСальдоКонечноеПоДоговоруБезСчетов(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора, НомерРаздела);
	
	Если НомерРаздела = 1 Тогда
		ВывестиСальдоКонечноеПоДоговоруПоСчетам(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиСальдоКонечноеПоДоговоруБезСчетов(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора, НомерРаздела)
	
	Если НомерРаздела = 1 Тогда
		ИмяВыборки = "Раздел1СальдоКонечноеБезСчетов";
		
	ИначеЕсли НомерРаздела = 2 Тогда
		ИмяВыборки = "Раздел2СальдоКонечное";
	КонецЕсли;
	
	Выборка = ПолучитьВыборкуПоТекущемуДокументуИДоговору(СтрокаШапки,
		Данные.Выборки[ИмяВыборки],
		ВыборкаСведенияДоговора);
	
	ОбластьПодвал = ОбластиМакета.СальдоКонечноеПодвал;
	
	Если Выборка.Количество() = 0 Тогда
		ВывестиПустоеСальдоКонечноеПоДоговоруБезСчетов(ТабДокумент, Данные, ОбластиМакета);
		
		Если НомерРаздела = 2 Тогда
			ТабДокумент.Вывести(ОбластьПодвал);
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Счетчик = 0;
	
	ПередНачаломВыводаТаблицы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
	
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		
		Область = ?(Счетчик = 1,
			ОбластиМакета.СальдоКонечноеПерваяСтрока,
			ОбластиМакета.СальдоКонечноеОчереднаяСтрока);
		
		Область.Параметры.Заполнить(Выборка);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка,
			Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, "КодВалюты");
		
		Если Не ТабДокумент.ПроверитьВывод(Область) Тогда
			ПередРазрывомСтраницы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
			
			Если Данные.ДополнительныеПараметры.ОбъединятьГрафу1ПоВысоте Тогда
				Область = ОбластиМакета.СальдоКонечноеПерваяСтрока;
				
				Область.Параметры.Заполнить(Выборка);
				
				ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка,
					Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, "КодВалюты");
			КонецЕсли;
			
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
	ПослеВыводаТаблицы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
	
	Если НомерРаздела = 2 Тогда
		ТабДокумент.Вывести(ОбластьПодвал);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиСальдоКонечноеПоДоговоруПоСчетам(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора)
	
	ОбластьЗаголовок = ОбластиМакета.СальдоКонечноеПоСчетамЗаголовок;
	
	Если Не ТабДокумент.ПроверитьВывод(ОбластьЗаголовок) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьЗаголовок);
	
	Выборка = ПолучитьВыборкуПоТекущемуДокументуИДоговору(СтрокаШапки,
		Данные.Выборки.Раздел1СальдоКонечноеПоСчетам,
		ВыборкаСведенияДоговора);
	
	КоличествоСтрок = Выборка.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		ВывестиПустоеСальдоКонечноеПоДоговоруПоСчетам(ТабДокумент, Данные, ОбластиМакета);
		
		Возврат;
	КонецЕсли;
	
	Область = ОбластиМакета.СальдоКонечноеПоСчетамСтрока;
	
	ОбластьПодвала = ОбластиМакета.СальдоКонечноеПодвал;
	
	Счетчик = 0;
	
	ЗначенияПараметров = Новый Структура();
	
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		
		ЗначенияПараметров.Вставить("НомерСчета", ИнвентаризацияКлиентСервер.ПолучитьПолныйНомерСчета(
			Выборка.КПС, Выборка.КФО, Выборка.Счет, Выборка.КЭК,, Выборка.СчетУчетПоКПС, Выборка.СчетУчетПоКЭК));
		
		Область.Параметры.Заполнить(Выборка);
		Область.Параметры.Заполнить(ЗначенияПараметров);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка,
			Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, "НомерСчетаКодВалюты");
		
		Если Счетчик = КоличествоСтрок Тогда
			МассивОбластей = Новый Массив();
			МассивОбластей.Добавить(Область);
			МассивОбластей.Добавить(ОбластьПодвала);
		Иначе
			МассивОбластей = Область;
		КонецЕсли;
		
		Если Не ТабДокумент.ПроверитьВывод(МассивОбластей) Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
	ТабДокумент.Вывести(ОбластьПодвала);
	
КонецПроцедуры

Процедура ВывестиПустоеСальдоНачальноеПоДоговоруБезСчетов(ТабДокумент, Данные, ОбластиМакета)
	
	Область = ОбластиМакета.СальдоНачальноеПерваяСтрока;
	
	Область.Параметры.Заполнить(Данные.ДополнительныеПараметры.СтруктураЗаполненияБезСчетов);
	
	Если Не ТабДокумент.ПроверитьВывод(Область) Тогда
