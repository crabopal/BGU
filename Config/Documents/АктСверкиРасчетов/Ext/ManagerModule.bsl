	ОбластиМакета.Вставить("ПодписьСТелефоном",									Макет.ПолучитьОбласть("ПодписьСТелефоном"));
	ОбластиМакета.Вставить("ДатаПодписи",										Макет.ПолучитьОбласть("ДатаПодписи"));
	
	// Раздел 2
	ОбластиМакета.Вставить("Раздел2Заголовок",									Макет.ПолучитьОбласть("Раздел2Заголовок"));
	ОбластиМакета.Вставить("Раздел2ВсегоСальдоНачальноеПерваяСтрока",			Макет.ПолучитьОбласть("Раздел2ВсегоСальдоНачальноеПерваяСтрока"));
