	Условие.ПравоеЗначение = ДополнительныеПараметры.ВалютаРУ;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='в рублях'"));
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + "НадписьСуммаРуб");
	
	//---
	// Надпись для рублевых сумм рублей.
	//---
	ЭлементУО = ФормаДокумента.УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(НСтр("ru='Надпись для рублевых сумм рублей (%1)'"), ИмяТЧ);
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = 1;
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрШаблон("Объект.%1.Валюта", ИмяТЧ));
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = ДополнительныеПараметры.ВалютаРУ;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "");
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + "НадписьСуммаРуб");
	
