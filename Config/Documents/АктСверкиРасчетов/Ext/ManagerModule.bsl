Процедура ДобавитьУсловноеОформление_СкрытьВалютныеСуммыДляРублей(ФормаДокумента, ИмяТЧ, ДополнительныеПараметры)
	
	ИменаВидовРасчетов = ПолучитьИменаВидовРасчетов();
	ИменаСторон = ПолучитьИменаСторон();
	
	ПредставлениеШаблон = НСтр("ru='Валютные суммы доступны только при указании иностранной валюты (%1)'");
	
	ЭлементУО = ФормаДокумента.УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблон, ИмяТЧ);
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрШаблон("Объект.%1.Валюта", ИмяТЧ));
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = ДополнительныеПараметры.ВалютаРУ;
	
	Для Каждого Сторона Из ИменаСторон Цикл
		Для Каждого ВидРасчетов Из ИменаВидовРасчетов Цикл
			ИмяПоляВал = ПолучитьИмяПоляСумма(ВидРасчетов, "Вал", Сторона);
			
			// Условия
			Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрШаблон("Объект.%1.%2", ИмяТЧ, ИмяПоляВал));
			Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
			
			// Оформляемые поля (валютная сумма)
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоляВал);
		КонецЦикла;
		
		// Условия (всего)
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрШаблон("Объект.%1.%2", ИмяТЧ, ПолучитьИмяПоляСумма("Всего", "Вал", Сторона)));
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		// Оформляемые поля (всего)
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ПолучитьИмяПоляСумма("Всего", "Вал", Сторона));
	КонецЦикла;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Оформляемые поля (надпись сумм)
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + "НадписьСуммаВал");
	
КонецПроцедуры

