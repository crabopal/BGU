	СтруктураЗаполненияБезСчетов.Вставить("СуммаПенейРубКредит", 0);
	
	СтруктураЗаполненияПоСчетам = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураЗаполненияБезСчетов);
	СтруктураЗаполненияПоСчетам.Вставить("НомерСчета", НСтр("ru='—'"));
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("СтруктураЗаполненияБезСчетов", СтруктураЗаполненияБезСчетов);
	ДополнительныеПараметры.Вставить("СтруктураЗаполненияПоСчетам", СтруктураЗаполненияПоСчетам);
	ДополнительныеПараметры.Вставить("ПрочеркиПустыхПолей", ПолучитьНастройкиПрочерковПустыхПолей());
	
	ДополнительныеПараметры.Вставить("ОбъединятьГрафу1ПоВысоте", Истина);
	ДополнительныеПараметры.Вставить("КоличествоСтрокПриНачалеВывода", 0);
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

Функция ПолучитьНастройкиПрочерковПустыхПолей()
	
	Разделитель = ", ";
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("ЗаголовокДоговора", СтрРазделить("НаименованиеДоговора,НомерДоговора,ДатаДоговора,ИдентификаторГосконтракта,ПредметДоговора", Разделитель));
	ИменаПолей.Вставить("КодВалюты", СтрРазделить("КодВалюты", Разделитель));
	ИменаПолей.Вставить("НомерСчетаКодВалюты", СтрРазделить("НомерСчета,КодВалюты", Разделитель));
	ИменаПолей.Вставить("ОперацииПоДоговору", СтрРазделить("СодержаниеОперации,КодВалюты,НаименованиеДокумента,НомерДокумента,ДатаДокумента", Разделитель));
	
	Возврат ИнвентаризацияСервер.ПолучитьНастройкиПрочерковПустыхПолей(ИменаПолей);
	
КонецФункции

