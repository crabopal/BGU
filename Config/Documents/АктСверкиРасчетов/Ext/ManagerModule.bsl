Функция ПолучитьПараметрыПоискаСведенийБухУчета(ПараметрыПроцедуры)
	
	ИспользоватьУчетПоИФО				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьВалютныйУчет			= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ИспользоватьУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	НастройкиОтбораСчетовИКФО = ИнвентаризацияСервер.ПолучитьНастройкиОтбораСчетовИКФО(ПараметрыПроцедуры.СписокСчетов, ПараметрыПроцедуры.ДатаОкончания);
	
	ДатыПоиска = ПолучитьДатыПоискаСведенийБухУчета(ПараметрыПроцедуры);
	
	СписокДоговоровДляОтбора = ПолучитьСписокДоговоровДляОтбора(ПараметрыПроцедуры.СписокДоговоров);
	
	ИспользоватьОтборПоДоговорам = (СписокДоговоровДляОтбора.Количество() > 0);
	
	ВидыСубконтоКонтрагентДоговорВидыРасчетов = Новый Массив();
	ВидыСубконтоКонтрагентДоговорВидыРасчетов.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	ВидыСубконтоКонтрагентДоговорВидыРасчетов.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	ВидыСубконтоКонтрагентДоговорВидыРасчетов.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыРасчетовПоЗаймам);
	
	ИсключаемыеТипыРегистратора = Новый Массив();
	ИсключаемыеТипыРегистратора.Добавить(Тип("ДокументСсылка.ЗакрытиеГода"));
	ИсключаемыеТипыРегистратора.Добавить(Тип("ДокументСсылка.ЗакрытиеГодаТехнологическое"));
	ИсключаемыеТипыРегистратора.Добавить(Тип("ДокументСсылка.ЗакрытиеГодаТехнологическоеГрупповое"));
	ИсключаемыеТипыРегистратора.Добавить(Тип("ДокументСсылка.ПереносОстатковПоКПС"));
	ИсключаемыеТипыРегистратора.Добавить(Тип("ДокументСсылка.ПереносОстатков64нРасчеты"));
	ИсключаемыеТипыРегистратора.Добавить(Тип("ДокументСсылка.ВводНачальныхОстатков"));
	
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("ДатаНачала",							ДатыПоиска.ДатаНачала);
	ПараметрыПоиска.Вставить("ДатаОкончания",						ДатыПоиска.ДатаОкончания);
	ПараметрыПоиска.Вставить("ДатаНачальныхОстатков",				ДатыПоиска.ДатаНачальныхОстатков);
	ПараметрыПоиска.Вставить("ДатаКонечныхОстатков",				ДатыПоиска.ДатаКонечныхОстатков);
	ПараметрыПоиска.Вставить("Организация",							ПараметрыПроцедуры.Организация);
	ПараметрыПоиска.Вставить("Контрагент",							ПараметрыПроцедуры.Контрагент);
	ПараметрыПоиска.Вставить("КонтрагентКИЕ",						ПолучитьКонтрагентКИЕ(ПараметрыПроцедуры.Контрагент));
	ПараметрыПоиска.Вставить("СписокДоговоров",						СписокДоговоровДляОтбора);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоДоговорам",		ИспользоватьОтборПоДоговорам);
	ПараметрыПоиска.Вставить("ИспользоватьВалютныйУчет",			ИспользоватьВалютныйУчет);
	ПараметрыПоиска.Вставить("ВалютаРУ",							Константы.ВалютаРегламентированногоУчета.Получить());
	ПараметрыПоиска.Вставить("ИФО",									ПараметрыПроцедуры.ИФО);
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоИФО",				ИспользоватьУчетПоИФО);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоИФО",				ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ПараметрыПроцедуры.ИФО));
	ПараметрыПоиска.Вставить("Подразделение",						ПараметрыПроцедуры.Подразделение);
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоПодразделению",	ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(ПараметрыПроцедуры.Подразделение));
	ПараметрыПоиска.Вставить("КЭК000",								БухгалтерскийУчетПовтИсп.КЭК0());
	ПараметрыПоиска.Вставить("СчетаРасчетовКИСЕ",					БухгалтерскийУчет.СписокСчетов(ПланыСчетов.ЕПСБУ.КодыСчетовРасчетовКИСЕ()));
	ПараметрыПоиска.Вставить("ИсключаемыеТипыРегистратора",			ИсключаемыеТипыРегистратора);
	
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоКФО",				НастройкиОтбораСчетовИКФО.ИспользоватьОтборПоКФО);
	ПараметрыПоиска.Вставить("СписокКФО",							НастройкиОтбораСчетовИКФО.СписокКФО);
	ПараметрыПоиска.Вставить("СписокСчетов",						НастройкиОтбораСчетовИКФО.СписокСчетов);
	ПараметрыПоиска.Вставить("ТаблицаИсключаемыхСчетов",			НастройкиОтбораСчетовИКФО.ДетальнаяТаблицаИсключаемыеСчета);
	
	ПараметрыПоиска.Вставить("СписокСчетовИсключений", ПолучитьСписокСчетовИсключений(ПараметрыПроцедуры.ДатаОкончания, ПараметрыПроцедуры.Организация));
	
	ПараметрыПоиска.Вставить("СписокСчетовКонтрагентДоговорВидыРасчетов",
		ПолучитьСписокСчетовСУказаннымиВидамиСубконто(
			НастройкиОтбораСчетовИКФО.СписокСчетов, ВидыСубконтоКонтрагентДоговорВидыРасчетов));
	ПараметрыПоиска.Вставить("ВидыСубконтоКонтрагентДоговорВидыРасчетов",	ВидыСубконтоКонтрагентДоговорВидыРасчетов);
	ПараметрыПоиска.Вставить("СписокВидовРасчетовДляКолонкиОД",				ПолучитьСписокВидовРасчетовДляКолонкиОД());
	ПараметрыПоиска.Вставить("СписокВидовРасчетовДляКолонкиПроцентов",		ПолучитьСписокВидовРасчетовДляКолонкиПроцентов());
	ПараметрыПоиска.Вставить("СписокВидовРасчетовДляКолонкиШтрафов",		ПолучитьСписокВидовРасчетовДляКолонкиШтрафов());
	ПараметрыПоиска.Вставить("СписокВидовРасчетовДляКолонкиПеней",			ПолучитьСписокВидовРасчетовДляКолонкиПеней());
	
	ПараметрыПоиска.Вставить("ПустаяВалюта",		Справочники.Валюты.ПустаяСсылка());
	ПараметрыПоиска.Вставить("ПустоеИФО",			Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	ПараметрыПоиска.Вставить("ПустойДоговор",		Справочники.Договоры.ПустаяСсылка());
	ПараметрыПоиска.Вставить("ПустоеПодразделение",	Справочники.Подразделения.ПустаяСсылка());
	
	Возврат ПараметрыПоиска;
	
КонецФункции

Функция ПолучитьСписокДоговоровДляОтбора(СписокДоговоров)
	
	Если СписокДоговоров.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("СписокДоговоров", СписокДоговоров);
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Договоры
	|ГДЕ
	|	Ссылка В ИЕРАРХИИ(&СписокДоговоров)";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПрочитатьСведенияБухУчета(ПараметрыПроцедуры)
	
	Перем ОбщийСписокДоговоров;
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаСведенийБухУчета(ПараметрыПроцедуры);
	
	Операции = ПрочитатьОперации(ПараметрыПоиска);
	
	Остатки = ПрочитатьОстатки(ПараметрыПоиска);
	
	КолонкиСуммирования = ПолучитьКолонкиСуммовыхПоказателейБезВсего();
	
	Обороты = РассчитатьОбороты(Операции, КолонкиСуммирования);
	
	ДобавитьКонечныеОстаткиБезСчетов(Остатки, КолонкиСуммирования);
	
	ОстаткиВсего = РассчитатьОстаткиВсего(Остатки, КолонкиСуммирования);
	
	ЗаполнитьКолонкиВсего(Операции);
	ЗаполнитьКолонкиВсего(Обороты);
	ЗаполнитьКолонкиВсего(Остатки.НачальныеОстаткиБезСчетов);
	ЗаполнитьКолонкиВсего(Остатки.КонечныеОстаткиБезСчетов);
	ЗаполнитьКолонкиВсего(Остатки.КонечныеОстаткиПоСчетам);
	ЗаполнитьКолонкиВсего(ОстаткиВсего.НачальныеОстаткиБезСчетов);
	ЗаполнитьКолонкиВсего(ОстаткиВсего.КонечныеОстаткиБезСчетов);
	ЗаполнитьКолонкиВсего(ОстаткиВсего.КонечныеОстаткиПоСчетам);
	
	ТаблицаСписокДоговоров = ПолучитьТаблицуСписокДоговоровПриЗаполненииПоДаннымБухУчета(Обороты, Остатки);
	
	Сведения = Новый Структура();
	Сведения.Вставить("Операции",				Операции);
	Сведения.Вставить("Обороты",				Обороты);
	Сведения.Вставить("Остатки",				Остатки);
	Сведения.Вставить("ОстаткиВсего",			ОстаткиВсего);
	Сведения.Вставить("ТаблицаСписокДоговоров",	ТаблицаСписокДоговоров);
	
	Возврат Сведения;
	
КонецФункции

