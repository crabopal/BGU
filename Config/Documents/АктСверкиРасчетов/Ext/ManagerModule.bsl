	КонецЕсли;
	
	ТабДокумент.Вывести(Область);
	
КонецПроцедуры

Процедура ВывестиПустоеСальдоКонечноеПоДоговоруБезСчетов(ТабДокумент, Данные, ОбластиМакета)
	
	Область = ОбластиМакета.СальдоКонечноеПерваяСтрока;
	
	Область.Параметры.Заполнить(Данные.ДополнительныеПараметры.СтруктураЗаполненияБезСчетов);
	
	Если Не ТабДокумент.ПроверитьВывод(Область) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(Область);
	
КонецПроцедуры

Процедура ВывестиПустоеСальдоКонечноеПоДоговоруПоСчетам(ТабДокумент, Данные, ОбластиМакета)
	
	Область = ОбластиМакета.СальдоКонечноеПоСчетамСтрока;
	
	Область.Параметры.Заполнить(Данные.ДополнительныеПараметры.СтруктураЗаполненияПоСчетам);
	
	ОбластьПодвала = ОбластиМакета.СальдоКонечноеПодвал;
	
	МассивОбластей = Новый Массив();
	МассивОбластей.Добавить(Область);
	МассивОбластей.Добавить(ОбластьПодвала);
	
	Если Не ТабДокумент.ПроверитьВывод(МассивОбластей) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(Область);
	ТабДокумент.Вывести(ОбластьПодвала);
	
КонецПроцедуры

// Операции.

Процедура ВывестиОперацииПоДоговору(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора, НомерРаздела)
	
	ОбластьЗаголовок = ОбластиМакета.ОперацииЗаголовок;
	
	Если Не ТабДокумент.ПроверитьВывод(ОбластьЗаголовок) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьЗаголовок);
	
	Если НомерРаздела = 1 Тогда
		ИмяВыборки = "Раздел1Операции";
		
	ИначеЕсли НомерРаздела = 2 Тогда
		ИмяВыборки = "Раздел2Операции";
	КонецЕсли;
	
	Выборка = ПолучитьВыборкуПоТекущемуДокументуИДоговору(СтрокаШапки,
		Данные.Выборки[ИмяВыборки],
		ВыборкаСведенияДоговора);
	
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Область = ОбластиМакета.ОперацииСтрока;
	
	Счетчик = 0;
	
	ЗначенияПараметров = Новый Структура();
	
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		
		Область.Параметры.Заполнить(Выборка);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка,
			Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, "ОперацииПоДоговору");
		
		Если Не ТабДокумент.ПроверитьВывод(Область) Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
КонецПроцедуры

// Обороты.

Процедура ВывестиОборотыПоДоговору(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ВыборкаСведенияДоговора, НомерРаздела)
	
	Если НомерРаздела = 1 Тогда
		ИмяВыборки = "Раздел1ОборотыБезСчетов";
		
	ИначеЕсли НомерРаздела = 2 Тогда
		ИмяВыборки = "Раздел2Обороты";
	КонецЕсли;
	
	Выборка = ПолучитьВыборкуПоТекущемуДокументуИДоговору(СтрокаШапки,
		Данные.Выборки[ИмяВыборки],
		ВыборкаСведенияДоговора);
	
	КоличествоСтрок = Выборка.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		ВывестиПустыеОборотыПоДоговору(ТабДокумент, Данные, ОбластиМакета);
		
		Возврат;
	КонецЕсли;
	
	ОбластьПодвала = ОбластиМакета.ОборотыПодвал;
	
	Счетчик = 0;
	
	ПередНачаломВыводаТаблицы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
	
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		
		Область = ?(Счетчик = 1,
			ОбластиМакета.ОборотыПерваяСтрока,
			ОбластиМакета.ОборотыОчереднаяСтрока);
		
		Область.Параметры.Заполнить(Выборка);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка,
			Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, "КодВалюты");
		
		Если Счетчик = КоличествоСтрок Тогда
			МассивОбластей = Новый Массив();
			МассивОбластей.Добавить(Область);
			МассивОбластей.Добавить(ОбластьПодвала);
		Иначе
			МассивОбластей = Область;
		КонецЕсли;
		
		Если Не ТабДокумент.ПроверитьВывод(МассивОбластей) Тогда
			ПередРазрывомСтраницы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
			
			Если Данные.ДополнительныеПараметры.ОбъединятьГрафу1ПоВысоте Тогда
				Область = ОбластиМакета.ОборотыПерваяСтрока;
				
				Область.Параметры.Заполнить(Выборка);
				
				ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка,
					Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, "КодВалюты");
			КонецЕсли;
			
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
	ПослеВыводаТаблицы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
	
	ТабДокумент.Вывести(ОбластьПодвала);
	
КонецПроцедуры

Процедура ВывестиПустыеОборотыПоДоговору(ТабДокумент, Данные, ОбластиМакета)
	
	ОбластьПодвала = ОбластиМакета.ОборотыПодвал;
	
	Область = ОбластиМакета.ОборотыПерваяСтрока;
	
	Область.Параметры.Заполнить(Данные.ДополнительныеПараметры.СтруктураЗаполненияБезСчетов);
	
	МассивОбластей = Новый Массив();
	МассивОбластей.Добавить(Область);
	МассивОбластей.Добавить(ОбластьПодвала);
	
	Если Не ТабДокумент.ПроверитьВывод(МассивОбластей) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(Область);
	ТабДокумент.Вывести(ОбластьПодвала);
	
КонецПроцедуры

// Сальдо всего конечное.

Процедура ВывестиВсегоСальдоКонечное(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерРаздела)
	
	ВывестиВсегоСальдоКонечноеБезСчетов(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерРаздела);
	
	Если НомерРаздела = 1 Тогда
		ВывестиВсегоСальдоКонечноеПоСчетам(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиВсегоСальдоКонечноеБезСчетов(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерРаздела)
	
	Перем ОбластьПодвал;
	
	Если НомерРаздела = 1 Тогда
		ИмяВыборки = "Раздел1ВсегоСальдоКонечноеБезСчетов";
		
		ОбластьПерваяСтрока		= ОбластиМакета.Раздел1ВсегоСальдоКонечноеБезСчетовПерваяСтрока;
		ОбластьОчереднаяСтрока	= ОбластиМакета.Раздел1ВсегоСальдоКонечноеБезСчетовОчереднаяСтрока;
		
	ИначеЕсли НомерРаздела = 2 Тогда
		ИмяВыборки = "Раздел2ВсегоСальдоКонечное";
		
		ОбластьПерваяСтрока		= ОбластиМакета.Раздел2ВсегоСальдоКонечноеБезСчетовПерваяСтрока;
		ОбластьОчереднаяСтрока	= ОбластиМакета.Раздел2ВсегоСальдоКонечноеБезСчетовОчереднаяСтрока;
		ОбластьПодвал			= ОбластиМакета.Раздел2ВсегоСальдоКонечноеПодвал;
	КонецЕсли;
	
	ОбщаяВыборкаТЧ = Данные.Выборки[ИмяВыборки];
	
	Выборка = ПолучитьВыборкуПоТекущемуДокументу(СтрокаШапки, ОбщаяВыборкаТЧ);
	
	Если Выборка.Количество() = 0 Тогда
		ВывестиПустоеВсегоСальдоКонечноеБезСчетов(ТабДокумент, Данные, ОбластьПерваяСтрока);
		
		Если НомерРаздела = 2 Тогда
			ТабДокумент.Вывести(ОбластьПодвал);
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	МассивОбластей = Новый Массив();
	МассивОбластей.Добавить(Неопределено);
	
	Если НомерРаздела = 2 Тогда
		МассивОбластей.Добавить(ОбластьПодвал);
	КонецЕсли;
	
	Счетчик = 0;
	
	ПередНачаломВыводаТаблицы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
	
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		
		Область = ?(Счетчик = 1,
			ОбластьПерваяСтрока,
			ОбластьОчереднаяСтрока);
		
		Область.Параметры.Заполнить(Выборка);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка,
			Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, "КодВалюты");
		
		МассивОбластей[0] = Область;
		
		Если Не ТабДокумент.ПроверитьВывод(МассивОбластей) Тогда
			ПередРазрывомСтраницы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
			
			Если Данные.ДополнительныеПараметры.ОбъединятьГрафу1ПоВысоте Тогда
				Область = ОбластьПерваяСтрока;
				
				Область.Параметры.Заполнить(Выборка);
				
				ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка,
					Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, "КодВалюты");
			КонецЕсли;
			
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабДокумент.Вывести(Область)
	КонецЦикла;
	
	ПослеВыводаТаблицы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные);
	
	Если НомерРаздела = 2 Тогда
		ТабДокумент.Вывести(ОбластьПодвал);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиВсегоСальдоКонечноеПоСчетам(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета)
	
	ОбластьЗаголовок = ОбластиМакета.Раздел1ВсегоСальдоКонечноеПоСчетамЗаголовок;
	
	Если Не ТабДокумент.ПроверитьВывод(ОбластьЗаголовок) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьЗаголовок);
	
	Выборка = ПолучитьВыборкуПоТекущемуДокументу(СтрокаШапки, Данные.Выборки.Раздел1ВсегоСальдоКонечноеПоСчетам);
	
	Если Выборка.Количество() = 0 Тогда
		ВывестиПустоеВсегоСальдоКонечноеПоСчетам(ТабДокумент, Данные, ОбластиМакета);
		
		Возврат;
	КонецЕсли;
	
	Область = ОбластиМакета.Раздел1ВсегоСальдоКонечноеПоСчетамСтрока;
	
	ОбластьПодвала = ОбластиМакета.Раздел1ВсегоСальдоКонечноеПодвал;
	
	Счетчик = 0;
	
	КоличествоСтрок = Выборка.Количество();
	
	ЗначенияПараметров = Новый Структура();
	
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		
		ЗначенияПараметров.Вставить("НомерСчета", ИнвентаризацияКлиентСервер.ПолучитьПолныйНомерСчета(
			Выборка.КПС, Выборка.КФО, Выборка.Счет, Выборка.КЭК,, Выборка.СчетУчетПоКПС, Выборка.СчетУчетПоКЭК));
		
		Область.Параметры.Заполнить(Выборка);
		Область.Параметры.Заполнить(ЗначенияПараметров);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка,
			Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей, "НомерСчетаКодВалюты");
		
		Если Счетчик = КоличествоСтрок Тогда
			МассивОбластей = Новый Массив();
			МассивОбластей.Добавить(Область);
			МассивОбластей.Добавить(ОбластьПодвала);
		Иначе
			МассивОбластей = Область;
		КонецЕсли;
		
		Если Не ТабДокумент.ПроверитьВывод(МассивОбластей) Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
	ТабДокумент.Вывести(ОбластьПодвала);
	
КонецПроцедуры

Процедура ВывестиПустоеВсегоСальдоКонечноеБезСчетов(ТабДокумент, Данные, ОбластьПерваяСтрока)
	
	ОбластьПерваяСтрока.Параметры.Заполнить(Данные.ДополнительныеПараметры.СтруктураЗаполненияБезСчетов);
	
	Если Не ТабДокумент.ПроверитьВывод(ОбластьПерваяСтрока) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьПерваяСтрока);
	
КонецПроцедуры

Процедура ВывестиПустоеВсегоСальдоКонечноеПоСчетам(ТабДокумент, Данные, ОбластиМакета)
	
	Область = ОбластиМакета.Раздел1ВсегоСальдоКонечноеПоСчетамСтрока;
	
	Область.Параметры.Заполнить(Данные.ДополнительныеПараметры.СтруктураЗаполненияПоСчетам);
	
	ОбластьПодвала = ОбластиМакета.Раздел1ВсегоСальдоКонечноеПодвал;
	
	МассивОбластей = Новый Массив();
	МассивОбластей.Добавить(Область);
	МассивОбластей.Добавить(ОбластьПодвала);
	
	Если Не ТабДокумент.ПроверитьВывод(МассивОбластей) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(Область);
	ТабДокумент.Вывести(ОбластьПодвала);
	
КонецПроцедуры

#КонецОбласти

#Область ОбъединениеГрафы1ПоВысоте

Процедура ПередНачаломВыводаТаблицы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные)
	
	Если Данные.ДополнительныеПараметры.ОбъединятьГрафу1ПоВысоте Тогда
		Данные.ДополнительныеПараметры.КоличествоСтрокПриНачалеВывода = ТабДокумент.ВысотаТаблицы;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередРазрывомСтраницы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные)
	
	Если Данные.ДополнительныеПараметры.ОбъединятьГрафу1ПоВысоте Тогда
		ОбъединитьГрафу1ПоВысоте(ТабДокумент, Данные);
		
		Данные.ДополнительныеПараметры.КоличествоСтрокПриНачалеВывода = ТабДокумент.ВысотаТаблицы;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеВыводаТаблицы_ОбъединятьГрафу1ПоВысоте(ТабДокумент, Данные)
	
	Если Данные.ДополнительныеПараметры.ОбъединятьГрафу1ПоВысоте Тогда
		ОбъединитьГрафу1ПоВысоте(ТабДокумент, Данные);
		
		Данные.ДополнительныеПараметры.КоличествоСтрокПриНачалеВывода = 0;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбъединитьГрафу1ПоВысоте(ТабДокумент, Данные)
	
	НомерГрафы = 1;
	
	НомерСтрокиНач = Данные.ДополнительныеПараметры.КоличествоСтрокПриНачалеВывода + 1;
	НомерСтрокиКон = ТабДокумент.ВысотаТаблицы;
	
	Если НомерСтрокиКон <= НомерСтрокиНач Тогда
		Возврат;
	КонецЕсли;
	
	ТабДокумент.Область(НомерСтрокиНач, НомерГрафы, НомерСтрокиКон, НомерГрафы).Объединить();
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Функция ПолучитьТекстЗапросаЗарегистрироватьДанныеДляОбработкиЗаполнениеРаздел1СписокДоговоров()
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Потенциально необходимые к обработке документы (заполненные)
	|//
	|ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ПОМЕСТИТЬ
	|	КандидатыНаОбработку
	|ИЗ
	|	Документ.АктСверкиРасчетов.Раздел1ОборотыБезСчетов
	|ГДЕ
	|	НомерСтроки = 1
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Документ.АктСверкиРасчетов.Раздел1СальдоНачальноеБезСчетов
	|ГДЕ
	|	НомерСтроки = 1
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
