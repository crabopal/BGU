Процедура ОграничитьВыборСчета_Раздел1СальдоКонечноеПоСчетам(ФормаДокумента)
	
	ПараметрыВыбора = Новый Массив();
	
	НовыйПараметр = Новый ПараметрВыбора("ОграниченияСчета", ПолучитьСписокСчетовЗаполненияСтрокой());
	ПараметрыВыбора.Добавить(НовыйПараметр);
	
