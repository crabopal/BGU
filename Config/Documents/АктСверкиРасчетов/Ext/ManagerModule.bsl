Функция ПолучитьСписокСчетовСУказаннымиВидамиСубконто(СписокСчетов, ВидыСубконто)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокСчетов", СписокСчетов);
	ЗапросПоиск.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	ЗапросПоиск.УстановитьПараметр("КоличествоСубконто", ВидыСубконто.Количество());
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка			КАК Ссылка,
	|	КОЛИЧЕСТВО(*)	КАК КоличествоСубконто
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	Ссылка В(&СписокСчетов)
	|	И ВидСубконто В(&ВидыСубконто)
	|СГРУППИРОВАТЬ ПО
	|	Ссылка
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) = &КоличествоСубконто";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПолучитьДатыПоискаСведенийБухУчета(ПараметрыПроцедуры)
	
	ДатыПоиска = Новый Структура();
	
	// Поиск операций.
	ДатыПоиска.Вставить("ДатаНачала", НачалоДня(ПараметрыПроцедуры.ДатаНачала));
	ДатыПоиска.Вставить("ДатаОкончания", КонецДня(ПараметрыПроцедуры.ДатаОкончания));
	
	// Для остатков.
	ДатыПоиска.Вставить("ДатаНачальныхОстатков", НачалоДня(ПараметрыПроцедуры.ДатаНачала));
	ДатыПоиска.Вставить("ДатаКонечныхОстатков", Новый Граница(КонецДня(ПараметрыПроцедуры.ДатаОкончания), ВидГраницы.Включая));
	
	Возврат ДатыПоиска;
	
КонецФункции

Функция ПолучитьКонтрагентКИЕ(Контрагент)
	
	КонтрагентКИЕ = "0";
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ЗапросПоиск = Новый Запрос();
		ЗапросПоиск.УстановитьПараметр("Контрагент", Контрагент);
		ЗапросПоиск.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СправочникТипыКонтрагентов.Код, ""0"") КАК КонтрагентКИЕ
		|ИЗ
		|	Справочник.Контрагенты КАК СправочникКонтрагенты
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТипыКонтрагентов КАК СправочникТипыКонтрагентов
		|		ПО СправочникКонтрагенты.ТипКонтрагента = СправочникТипыКонтрагентов.Ссылка
		|ГДЕ
		|	СправочникКонтрагенты.Ссылка = &Контрагент";
		
		Выборка = ЗапросПоиск.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			КонтрагентКИЕ = Выборка.КонтрагентКИЕ;
		КонецЕсли;
	КонецЕсли;
	
	Возврат КонтрагентКИЕ;
	
КонецФункции

Процедура ЗаполнитьРассчитываемыеТабличныеЧастиРаздела1(ДокументОбъект)
	
	ТаблицаРаздел1СальдоКонечноеПоСчетам = ДокументОбъект.Раздел1СальдоКонечноеПоСчетам.Выгрузить();
	
	ЗаполнитьРаздел1ОборотыБезСчетов(ДокументОбъект);
	
	ЗаполнитьРаздел1СальдоКонечноеБезСчетов(ДокументОбъект, ТаблицаРаздел1СальдоКонечноеПоСчетам);
	
	ЗаполнитьРаздел1ВсегоСальдо(ДокументОбъект, ТаблицаРаздел1СальдоКонечноеПоСчетам);
	
	ЗаполнитьРаздел1СписокДоговоров(ДокументОбъект); // Обязательно вызов последним по счету.
	
КонецПроцедуры

Процедура ЗаполнитьРаздел1ОборотыБезСчетов(ДокументОбъект)
	
	КолонкиГруппировок = "Договор,Валюта,ИФО,Подразделение";
	
	КолонкиСуммирования = ПолучитьКолонкиСуммовыхПоказателейСВсего();
	
	НужныеКолонки = КолонкиГруппировок + "," + КолонкиСуммирования;
	
	Операции = ДокументОбъект.Раздел1Операции.Выгрузить(, НужныеКолонки);
	
	Обороты = РассчитатьОбороты(Операции, КолонкиСуммирования);
	
	ДокументОбъект.Раздел1ОборотыБезСчетов.Загрузить(Обороты);
	
КонецПроцедуры

Процедура ЗаполнитьРаздел1СальдоКонечноеБезСчетов(ДокументОбъект, ТаблицаРаздел1СальдоКонечноеПоСчетам)
	
	КолонкиСуммирования = ПолучитьКолонкиСуммовыхПоказателейСВсего();
	
	КонечныеОстаткиБезСчетов = РассчитатьКонечныеОстаткиБезСчетов(ТаблицаРаздел1СальдоКонечноеПоСчетам, КолонкиСуммирования);

	ДокументОбъект.Раздел1СальдоКонечноеБезСчетов.Загрузить(КонечныеОстаткиБезСчетов);
	
КонецПроцедуры

Процедура ЗаполнитьРаздел1ВсегоСальдо(ДокументОбъект, ТаблицаРаздел1СальдоКонечноеПоСчетам)
	
	КолонкиСуммирования = ПолучитьКолонкиСуммовыхПоказателейСВсего();
	
	Остатки = Новый Структура();
	Остатки.Вставить("НачальныеОстаткиБезСчетов", ДокументОбъект.Раздел1СальдоНачальноеБезСчетов.Выгрузить());
	Остатки.Вставить("КонечныеОстаткиБезСчетов", ДокументОбъект.Раздел1СальдоКонечноеБезСчетов.Выгрузить());
	Остатки.Вставить("КонечныеОстаткиПоСчетам", ТаблицаРаздел1СальдоКонечноеПоСчетам);
	
	ОстаткиВсего = РассчитатьОстаткиВсего(Остатки, КолонкиСуммирования);
	
	ДокументОбъект.Раздел1ВсегоСальдоНачальноеБезСчетов.Загрузить(ОстаткиВсего.НачальныеОстаткиБезСчетов);
	ДокументОбъект.Раздел1ВсегоСальдоКонечноеБезСчетов.Загрузить(ОстаткиВсего.КонечныеОстаткиБезСчетов);
	ДокументОбъект.Раздел1ВсегоСальдоКонечноеПоСчетам.Загрузить(ОстаткиВсего.КонечныеОстаткиПоСчетам);
	
КонецПроцедуры

Процедура ЗаполнитьРаздел1СписокДоговоров(ДокументОбъект)
	
	// Должно вызываться уже после обновления табличных частей оборотов и сальдо конечного,
	// потому что здесь используются сведения из этих табличных частей.
	
	ТаблицаСписокДоговоров = ПолучитьТаблицуСписокДоговоров(ДокументОбъект, 1);
	
	ДокументОбъект.Раздел1СписокДоговоров.Загрузить(ТаблицаСписокДоговоров);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРаздела2

Процедура ЗаполнитьРаздел2ОперацииПоДаннымРаздела1(ДокументОбъект)
	
	Раздел2Операции = ДокументОбъект.Раздел2Операции;
	Раздел2Операции.Очистить();
	
	ИменаПолей = "Договор,Валюта,СодержаниеОперации,ДокументУчета,НаименованиеДокумента,НомерДокумента,ДатаДокумента";

	Для Каждого СтрокаРаздела1 Из ДокументОбъект.Раздел1Операции Цикл
		НоваяСтрока = Раздел2Операции.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаздела1, ИменаПолей);
		
		ЗаполнитьСуммыСтрокиРаздела2ПоДаннымРаздела1(НоваяСтрока, СтрокаРаздела1);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРаздел2СальдоПоДаннымРаздела1(ДокументОбъект, ИмяТЧПриемникСальдо, ИмяТЧИсточникСальдо)
	
	СальдоРаздела2 = ДокументОбъект[ИмяТЧПриемникСальдо];
	СальдоРаздела2.Очистить();
	
	КолонкиГруппировок = "Договор,Валюта";
	
	КолонкиСуммирования = ПолучитьКолонкиСуммовыхПоказателейСВсего();
	
	НужныеКолонки = КолонкиГруппировок + "," + КолонкиСуммирования;
	
	СальдоРаздела1 = ДокументОбъект[ИмяТЧИсточникСальдо].Выгрузить(, НужныеКолонки);
	СальдоРаздела1.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	СальдоРаздела1.Сортировать(КолонкиГруппировок);
	
	Для Каждого СтрокаРаздела1 Из СальдоРаздела1 Цикл
		НоваяСтрока = СальдоРаздела2.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаздела1, КолонкиГруппировок);
		
		ЗаполнитьСуммыСтрокиРаздела2ПоДаннымРаздела1(НоваяСтрока, СтрокаРаздела1);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСуммыСтрокиРаздела2ПоДаннымРаздела1(СтрокаРаздела2, СтрокаРаздела1)
	
	СтрокаРаздела2.СуммаВсегоВалДебет		= СтрокаРаздела1.СуммаВсегоВалКредит;
	СтрокаРаздела2.СуммаВсегоРубДебет		= СтрокаРаздела1.СуммаВсегоРубКредит;
	СтрокаРаздела2.СуммаОДВалДебет			= СтрокаРаздела1.СуммаОДВалКредит;
	СтрокаРаздела2.СуммаОДРубДебет			= СтрокаРаздела1.СуммаОДРубКредит;
	СтрокаРаздела2.СуммаПроцентовВалДебет	= СтрокаРаздела1.СуммаПроцентовВалКредит;
	СтрокаРаздела2.СуммаПроцентовРубДебет	= СтрокаРаздела1.СуммаПроцентовРубКредит;
	СтрокаРаздела2.СуммаШтрафовВалДебет		= СтрокаРаздела1.СуммаШтрафовВалКредит;
	СтрокаРаздела2.СуммаШтрафовРубДебет		= СтрокаРаздела1.СуммаШтрафовРубКредит;
	СтрокаРаздела2.СуммаПенейВалДебет		= СтрокаРаздела1.СуммаПенейВалКредит;
	СтрокаРаздела2.СуммаПенейРубДебет		= СтрокаРаздела1.СуммаПенейРубКредит;
	
	СтрокаРаздела2.СуммаВсегоВалКредит		= СтрокаРаздела1.СуммаВсегоВалДебет;
	СтрокаРаздела2.СуммаВсегоРубКредит		= СтрокаРаздела1.СуммаВсегоРубДебет;
	СтрокаРаздела2.СуммаОДВалКредит			= СтрокаРаздела1.СуммаОДВалДебет;
	СтрокаРаздела2.СуммаОДРубКредит			= СтрокаРаздела1.СуммаОДРубДебет;
	СтрокаРаздела2.СуммаПроцентовВалКредит	= СтрокаРаздела1.СуммаПроцентовВалДебет;
	СтрокаРаздела2.СуммаПроцентовРубКредит	= СтрокаРаздела1.СуммаПроцентовРубДебет;
	СтрокаРаздела2.СуммаШтрафовВалКредит	= СтрокаРаздела1.СуммаШтрафовВалДебет;
	СтрокаРаздела2.СуммаШтрафовРубКредит	= СтрокаРаздела1.СуммаШтрафовРубДебет;
	СтрокаРаздела2.СуммаПенейВалКредит		= СтрокаРаздела1.СуммаПенейВалДебет;
	СтрокаРаздела2.СуммаПенейРубКредит		= СтрокаРаздела1.СуммаПенейРубДебет;
	
КонецПроцедуры

Процедура ЗаполнитьРассчитываемыеТабличныеЧастиРаздела2(ДокументОбъект)
	
	ЗаполнитьРаздел2Обороты(ДокументОбъект);
	
	ЗаполнитьРаздел2ВсегоСальдо(ДокументОбъект);
	
	ЗаполнитьРаздел2СписокДоговоров(ДокументОбъект);
	
КонецПроцедуры

Процедура ЗаполнитьРаздел2Обороты(ДокументОбъект)
	
	КолонкиГруппировок = "Договор,Валюта";
	
	КолонкиСуммирования = ПолучитьКолонкиСуммовыхПоказателейСВсего();
	
	НужныеКолонки = КолонкиГруппировок + "," + КолонкиСуммирования;
	
	Операции = ДокументОбъект.Раздел2Операции.Выгрузить(, НужныеКолонки);
	
	Обороты = РассчитатьОбороты(Операции, КолонкиСуммирования, КолонкиГруппировок);
	
	ДокументОбъект.Раздел2Обороты.Загрузить(Обороты);
	
КонецПроцедуры

Процедура ЗаполнитьРаздел2ВсегоСальдо(ДокументОбъект)
	
	КолонкиГруппировок = "Валюта";
	
	КолонкиСуммирования = ПолучитьКолонкиСуммовыхПоказателейСВсего();
	
	НужныеКолонки = КолонкиГруппировок + "," + КолонкиСуммирования;
	
	СальдоВсего = ДокументОбъект.Раздел2СальдоНачальное.Выгрузить(, НужныеКолонки);
	СальдоВсего.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	СальдоВсего.Сортировать(КолонкиГруппировок);
	
	ДокументОбъект.Раздел2ВсегоСальдоНачальное.Загрузить(СальдоВсего);
	
	СальдоВсего = ДокументОбъект.Раздел2СальдоКонечное.Выгрузить(, НужныеКолонки);
	СальдоВсего.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	СальдоВсего.Сортировать(КолонкиГруппировок);
	
	ДокументОбъект.Раздел2ВсегоСальдоКонечное.Загрузить(СальдоВсего);
	
КонецПроцедуры

Процедура ЗаполнитьРаздел2СписокДоговоров(ДокументОбъект)
	
	// Должно вызываться уже после обновления табличной части оборотов,
	// потому что здесь используются сведения из этой табличной части.
	
	ТаблицаСписокДоговоров = ПолучитьТаблицуСписокДоговоров(ДокументОбъект, 2);
	
	ДокументОбъект.Раздел2СписокДоговоров.Загрузить(ТаблицаСписокДоговоров);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеСписковДоговоров

Функция НовыйТаблицаСписокДоговоров()
	
	ТипСумма = ОбщегоНазначения.ОписаниеТипаЧисло(18, 2, ДопустимыйЗнак.Любой);
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Договор",						Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	Таблица.Колонки.Добавить("ВидОбязательства",			ОбщегоНазначения.ОписаниеТипаСтрока(255));
	Таблица.Колонки.Добавить("НомерДоговора",				ОбщегоНазначения.ОписаниеТипаСтрока(255));
	Таблица.Колонки.Добавить("ДатаДоговора",				ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	Таблица.Колонки.Добавить("ИдентификаторГосконтракта",	ОбщегоНазначения.ОписаниеТипаСтрока(25));
	Таблица.Колонки.Добавить("КраткоеСодержание",			Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("СальдоНачальноеДебет",		ТипСумма);
	Таблица.Колонки.Добавить("СальдоНачальноеКредит",		ТипСумма);
	Таблица.Колонки.Добавить("ОборотыДебет",				ТипСумма);
	Таблица.Колонки.Добавить("ОборотыКредит",				ТипСумма);
	Таблица.Колонки.Добавить("СальдоКонечноеДебет",			ТипСумма);
	Таблица.Колонки.Добавить("СальдоКонечноеКредит",		ТипСумма);
	
	// Служебные для расчета упорядочивания.
	Таблица.Колонки.Добавить("ИндексСтроки",				ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный));
	Таблица.Колонки.Добавить("ЭтоНовый",					Новый ОписаниеТипов("Булево"));
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьТаблицуСписокДоговоров(ДокументОбъект, НомерРаздела)
	
	ТаблицаСписокДоговоров = НовыйТаблицаСписокДоговоров();
	
	ЗаполнитьСуммыДебетаИКредита(ТаблицаСписокДоговоров, ДокументОбъект, НомерРаздела);
	
	ПрименитьРучнойПорядокСтрок(ТаблицаСписокДоговоров, ДокументОбъект, НомерРаздела);
	
	ЗаполнитьСвойстваНовыхДоговоров(ТаблицаСписокДоговоров, ДокументОбъект, НомерРаздела);
	
	Возврат ТаблицаСписокДоговоров;
	
КонецФункции

Процедура ЗаполнитьСуммыДебетаИКредита(ТаблицаСписокДоговоров, ДокументОбъект, НомерРаздела)
	
	КолонкиСуммовыхПоказателейВсего = "СуммаВсегоРубДебет,СуммаВсегоРубКредит";
	
	ВыгружаемыеКолонки = "Договор," + КолонкиСуммовыхПоказателейВсего;
	
	ИменаТЧ = Новый Массив();
	
	Если НомерРаздела = 1 Тогда
		ИмяТЧСальдоНачальное= "Раздел1СальдоНачальноеБезСчетов";
		ИмяТЧОбороты		= "Раздел1ОборотыБезСчетов";
		ИмяТЧСальдоКонечное	= "Раздел1СальдоКонечноеБезСчетов";
		
	ИначеЕсли НомерРаздела = 2 Тогда
		ИмяТЧСальдоНачальное= "Раздел2СальдоНачальное";
		ИмяТЧОбороты		= "Раздел2Обороты";
		ИмяТЧСальдоКонечное	= "Раздел2СальдоКонечное";
	КонецЕсли;
	
	ТаблицаПоказателей = ПолучитьТаблицуЗначений(ДокументОбъект, ИмяТЧСальдоНачальное, ВыгружаемыеКолонки);
	ТаблицаПоказателей.Свернуть("Договор", КолонкиСуммовыхПоказателейВсего);
	ДобавитьСтрокиДебетаИКредита(ТаблицаСписокДоговоров, ТаблицаПоказателей, "СальдоНачальноеДебет", "СальдоНачальноеКредит");
	
	ТаблицаПоказателей = ПолучитьТаблицуЗначений(ДокументОбъект, ИмяТЧОбороты, ВыгружаемыеКолонки);
	ТаблицаПоказателей.Свернуть("Договор", КолонкиСуммовыхПоказателейВсего);
	ДобавитьСтрокиДебетаИКредита(ТаблицаСписокДоговоров, ТаблицаПоказателей, "ОборотыДебет", "ОборотыКредит");
	
	ТаблицаПоказателей = ПолучитьТаблицуЗначений(ДокументОбъект, ИмяТЧСальдоКонечное, ВыгружаемыеКолонки);
	ТаблицаПоказателей.Свернуть("Договор", КолонкиСуммовыхПоказателейВсего);
	ДобавитьСтрокиДебетаИКредита(ТаблицаСписокДоговоров, ТаблицаПоказателей, "СальдоКонечноеДебет", "СальдоКонечноеКредит");
	
	КолонкиСуммирования = "СальдоНачальноеДебет,СальдоНачальноеКредит"
		+ ",ОборотыДебет,ОборотыКредит"
		+ ",СальдоКонечноеДебет,СальдоКонечноеКредит";
	
	КолонкиГруппировки = ПолучитьИменаВсехОстальныхКолонокТаблицы(ТаблицаСписокДоговоров, КолонкиСуммирования);
	
	ТаблицаСписокДоговоров.Свернуть(КолонкиГруппировки, КолонкиСуммирования);
	
	ТаблицаСписокДоговоров.Сортировать("Договор");
	
КонецПроцедуры

Функция ПолучитьТаблицуЗначений(ДокументОбъект, ИмяТаблицы, ВыгружаемыеКолонки)
	
	ТаблицаОбъекта = ДокументОбъект[ИмяТаблицы];
	
	Если ТипЗнч(ТаблицаОбъекта) = Тип("ТаблицаЗначений") Тогда
		Таблица = ТаблицаОбъекта.Скопировать(, ВыгружаемыеКолонки);
	Иначе
		Таблица = ТаблицаОбъекта.Выгрузить(, ВыгружаемыеКолонки);
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьИменаВсехОстальныхКолонокТаблицы(Таблица, ИменаИсключаемыхКолонок)
	
	МассивИсключаемых = СтрРазделить(ИменаИсключаемыхКолонок, ", ", Ложь);
	
	ИменаКолонок = Новый Массив();
	
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ИмяКолонки = Колонка.Имя;
		
		Если МассивИсключаемых.Найти(ИмяКолонки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИменаКолонок.Добавить(ИмяКолонки);
	КонецЦикла;
	
	Возврат СтрСоединить(ИменаКолонок, ",");
	
КонецФункции

Процедура ДобавитьСтрокиДебетаИКредита(ТаблицаСумм, ТаблицаПоказателей, ИмяКолонкиСуммаДебет, ИмяКолонкиСуммаКредит)
	
	Для Каждого СтрокаТаблицы Из ТаблицаПоказателей Цикл
		НоваяСтрока = ТаблицаСумм.Добавить();
		
		НоваяСтрока.Договор = СтрокаТаблицы.Договор;
		НоваяСтрока[ИмяКолонкиСуммаДебет] = СтрокаТаблицы.СуммаВсегоРубДебет;
		НоваяСтрока[ИмяКолонкиСуммаКредит] = СтрокаТаблицы.СуммаВсегоРубКредит;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрименитьРучнойПорядокСтрок(ТаблицаСписокДоговоров, ДокументОбъект, НомерРаздела)
	
	// Ранее заполнили документ, в нем было несколько договоров,
	// печатная форма была упорядочена по наименованию договоров на дату ПЕЧАТИ.
	//
	// Позже установили новый релиз, обработчик обновления заполнил табличную часть СписокДоговоров
	// с упорядочиванием по наименованию договоров на дату ОБНОВЛЕНИЯ.
	//
	// Если в период времени от печати документа до установки нового релиза было изменено наименование договора,
	// то возможно заполнение табличной части СписокДоговоров в несколько ином порядке, по сравнению
	// с прежней печатной формой. В этом случае автоматически повлиять на порядок строк табличной части никак нельзя.
	//
	// Если же заполнение списка договоров происходит не из обработчика обновлениия, а при обычной записи документа,
	// то табличная часть СписокДоговоров может быть уже заполнена. Например, заполнена ранее обработчиком обновления,
	// или во время предыдущей записи документа. Порядок строк мог быть настроен вручную и необходимо его сохранить
	// при повторной записи документа. В противном случае при каждой записи документа список договоров будет автоматически
	// сортироваться по наименованию, и будут теряться сортировки пользователя.
	
	Если НомерРаздела = 1 Тогда
		ИмяТЧ = "Раздел1СписокДоговоров";
		
	ИначеЕсли НомерРаздела = 2 Тогда
		ИмяТЧ = "Раздел2СписокДоговоров";
	КонецЕсли;
	
	ТЧСписокДоговоров = ДокументОбъект[ИмяТЧ];
	
	ТекущийПорядокДоговоров = ТЧСписокДоговоров.Выгрузить(, "Договор").ВыгрузитьКолонку("Договор");
	
	ИндексНовойСтроки = ТаблицаСписокДоговоров.Количество();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСписокДоговоров Цикл
		ИндексСтроки = ТекущийПорядокДоговоров.Найти(СтрокаТаблицы.Договор);
		
		Если ИндексСтроки = Неопределено Тогда
			ИндексСтроки = ИндексНовойСтроки;
			
			ИндексНовойСтроки = ИндексНовойСтроки + 1;
			
			СтрокаТаблицы.ЭтоНовый = Истина;
		КонецЕсли;
		
		СтрокаТаблицы.ИндексСтроки = ИндексСтроки;
	КонецЦикла;
	
	ТаблицаСписокДоговоров.Сортировать("ИндексСтроки");
	
КонецПроцедуры

Процедура ЗаполнитьСвойстваНовыхДоговоров(ТаблицаСписокДоговоров, ДокументОбъект, НомерРаздела)
	
	// Для новых договоров (ранее отсутствовали в табличной части) считываются актуальные значения реквизитов.
	// Для прежних договоров (уже присутствовали в табличной части) реквизиты не обновляются.
	
	Если НомерРаздела = 1 Тогда
		ИмяТЧ = "Раздел1СписокДоговоров";
		
	ИначеЕсли НомерРаздела = 2 Тогда
		ИмяТЧ = "Раздел2СписокДоговоров";
	КонецЕсли;
	
	ТЧСписокДоговоров = ДокументОбъект[ИмяТЧ];
	
	Поиск = Новый Структура("ЭтоНовый", Истина);
	
	СписокДоговоров = ТаблицаСписокДоговоров.Скопировать(Поиск, "Договор").ВыгрузитьКолонку("Договор");
	
	СведенияДоговоров = ПрочитатьСведенияДоговоров(СписокДоговоров);
	СведенияДоговоров.Индексы.Добавить("Ссылка");
	
	ПоискСведенийДоговора = Новый Структура("Ссылка");
	
	ИменаСвойств = "ВидОбязательства,НомерДоговора,ДатаДоговора,КраткоеСодержание,ИдентификаторГосконтракта";
	
	Для Каждого СтрокаТаблицы Из ТаблицаСписокДоговоров Цикл
		Если СтрокаТаблицы.ЭтоНовый Тогда
			Договор = СтрокаТаблицы.Договор;
			
			Если Не ЗначениеЗаполнено(Договор) Тогда
				Продолжить;
			КонецЕсли;
			
			ПоискСведенийДоговора.Ссылка = Договор;
			
			МассивСтрок = СведенияДоговоров.НайтиСтроки(ПоискСведенийДоговора);
			
			Если МассивСтрок.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, МассивСтрок[0], ИменаСвойств);
			КонецЕсли;
		Иначе
			СтрокаТЧ = ТЧСписокДоговоров[СтрокаТаблицы.ИндексСтроки];
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаТЧ, ИменаСвойств);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПрочитатьСведенияДоговоров(СписокДоговоров)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокДоговоров", СписокДоговоров);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Ссылка											КАК Ссылка,
	|	ВидОбязательства								КАК ВидОбязательства,
	|	ДатаДоговора									КАК ДатаДоговора,
	|	НомерДоговора									КАК НомерДоговора,
	|	КраткоеСодержание								КАК КраткоеСодержание,
	|	ЕСТЬNULL(ГосударственныйКонтрактПоГОЗ.Код, """")	КАК ИдентификаторГосконтракта
	|ИЗ
	|	Справочник.Договоры
	|ГДЕ
	|	Ссылка В (&СписокДоговоров)";
	
	УстановитьПривилегированныйРежим(Истина);
	СведенияДоговоров = Запроспоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СведенияДоговоров;
	
КонецФункции

Функция ПолучитьТаблицуСписокДоговоровПриЗаполненииПоДаннымБухУчета(Обороты, Остатки)
	
	СтруктураОбъект = Новый Структура();
	СтруктураОбъект.Вставить("Раздел1СальдоНачальноеБезСчетов",	Остатки.НачальныеОстаткиБезСчетов);
	СтруктураОбъект.Вставить("Раздел1ОборотыБезСчетов",			Обороты);
	СтруктураОбъект.Вставить("Раздел1СальдоКонечноеБезСчетов",	Остатки.КонечныеОстаткиБезСчетов);
	
	ТаблицаСписокДоговоров = НовыйТаблицаСписокДоговоров();
	
	ЗаполнитьСуммыДебетаИКредита(ТаблицаСписокДоговоров, СтруктураОбъект, 1);
	
	ЗаполнитьСвойстваВсехДоговоров(ТаблицаСписокДоговоров);
	
	Возврат ТаблицаСписокДоговоров;
	
КонецФункции

Процедура ЗаполнитьСвойстваВсехДоговоров(ТаблицаСписокДоговоров)
	
	СписокДоговоров = ТаблицаСписокДоговоров.ВыгрузитьКолонку("Договор");
	
	СведенияДоговоров = ПрочитатьСведенияДоговоров(СписокДоговоров);
	СведенияДоговоров.Индексы.Добавить("Ссылка");
	
	ПоискСведенийДоговора = Новый Структура("Ссылка");
	
	ИменаСвойств = "ВидОбязательства,НомерДоговора,ДатаДоговора,КраткоеСодержание,ИдентификаторГосконтракта";
	
	Для Каждого СтрокаТаблицы Из ТаблицаСписокДоговоров Цикл
		Договор = СтрокаТаблицы.Договор;
		
		Если Не ЗначениеЗаполнено(Договор) Тогда
			Продолжить;
		КонецЕсли;
		
		ПоискСведенийДоговора.Ссылка = Договор;
		
		МассивСтрок = СведенияДоговоров.НайтиСтроки(ПоискСведенийДоговора);
		
		Если МассивСтрок.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, МассивСтрок[0], ИменаСвойств);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Печать

Функция НовыйТабличныйДокумент()
	
	КлючПараметровПечати = "ПечатьФормы0510477";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПечатьФормы0510477(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	ОбщийТабДокумент = НовыйТабличныйДокумент();
	
	ТиповыеПараметры = Новый Структура();
	ТиповыеПараметры.Вставить("МассивОбъектов",			МассивОбъектов);
	ТиповыеПараметры.Вставить("ПараметрыПечати",		ПараметрыПечати);
	ТиповыеПараметры.Вставить("КоллекцияПечатныхФорм",	КоллекцияПечатныхФорм);
	ТиповыеПараметры.Вставить("ОбъектыПечати",			ОбъектыПечати);
	ТиповыеПараметры.Вставить("ПараметрыВывода",		ПараметрыВывода);
	
	Данные = ПолучитьДанныеДляПечати0510477(МассивОбъектов);
	
	ОбластиМакета = ПолучитьОбластиМакета0510477();
	
	ПервыйДокумент = Истина;
	
	ВыборкаШапка = Данные.Выборки.Шапки;
	
	Пока ВыборкаШапка.Следующий() Цикл
		Если МассивОбъектов.Найти(ВыборкаШапка.Ссылка) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТабДокумент = СформироватьПечатнуюФорму0510477(Данные, ВыборкаШапка, ОбластиМакета, ТиповыеПараметры);
		
		Если Не ПервыйДокумент Тогда
			ОбщийТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НомерСтрокиНачало = ОбщийТабДокумент.ВысотаТаблицы + 1;
		
		ОбщийТабДокумент.Вывести(ТабДокумент);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ОбщийТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.Ссылка);
			
		ПервыйДокумент = Ложь;
	КонецЦикла;
	
	// Колонтитулы
	ОбщийТабДокумент.ВерхнийКолонтитул.Выводить				= Истина;
	ОбщийТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница	= 2;
	ОбщийТабДокумент.ВерхнийКолонтитул.ТекстСправа			= НСтр("ru='Форма 0510477 с.[&НомерСтраницы]'");
	
	Возврат ОбщийТабДокумент;
	
КонецФункции

Функция ПолучитьОбластиМакета0510477()
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.АктСверкиРасчетов.ПФ_MXL_Ф0510477");
	
	ОбластиМакета = Новый Структура();
	
	ОбластиМакета.Вставить("Заголовок",										Макет.ПолучитьОбласть("Заголовок"));

	ОбластиМакета.Вставить("Раздел1Заголовок",								Макет.ПолучитьОбласть("Раздел1Заголовок"));
	
	// Начальное сальдо всего
	ОбластиМакета.Вставить("Раздел1ВсегоСальдоНачальноеПерваяСтрока",		Макет.ПолучитьОбласть("Раздел1ВсегоСальдоНачальноеПерваяСтрока"));
	ОбластиМакета.Вставить("Раздел1ВсегоСальдоНачальноеОчереднаяСтрока",	Макет.ПолучитьОбласть("Раздел1ВсегоСальдоНачальноеОчереднаяСтрока"));
	ОбластиМакета.Вставить("Раздел1ВсегоСальдоНачальноеПодвал",				Макет.ПолучитьОбласть("Раздел1ВсегоСальдоНачальноеПодвал"));
	
	ОбластиМакета.Вставить("ШапкаТаблицы",									Макет.ПолучитьОбласть("ШапкаТаблицы"));
	ОбластиМакета.Вставить("ЗаголовокДоговора",								Макет.ПолучитьОбласть("ЗаголовокДоговора"));
	
	// Начальное сальдо по договору
	ОбластиМакета.Вставить("СальдоНачальноеПерваяСтрока",					Макет.ПолучитьОбласть("СальдоНачальноеПерваяСтрока"));
	ОбластиМакета.Вставить("СальдоНачальноеОчереднаяСтрока",				Макет.ПолучитьОбласть("СальдоНачальноеОчереднаяСтрока"));
	ОбластиМакета.Вставить("СальдоНачальноеПодвал",							Макет.ПолучитьОбласть("СальдоНачальноеПодвал"));
	
	// Операции
	ОбластиМакета.Вставить("ОперацииЗаголовок",								Макет.ПолучитьОбласть("ОперацииЗаголовок"));
	ОбластиМакета.Вставить("ОперацииСтрока",								Макет.ПолучитьОбласть("ОперацииСтрока"));
	
	// Обороты по договору
	ОбластиМакета.Вставить("ОборотыПерваяСтрока",							Макет.ПолучитьОбласть("ОборотыПерваяСтрока"));
	ОбластиМакета.Вставить("ОборотыОчереднаяСтрока",						Макет.ПолучитьОбласть("ОборотыОчереднаяСтрока"));
	ОбластиМакета.Вставить("ОборотыПодвал",									Макет.ПолучитьОбласть("ОборотыПодвал"));
	
	// Конечное сальдо по договору
	ОбластиМакета.Вставить("СальдоКонечноеПерваяСтрока",					Макет.ПолучитьОбласть("СальдоКонечноеПерваяСтрока"));
	ОбластиМакета.Вставить("СальдоКонечноеОчереднаяСтрока",					Макет.ПолучитьОбласть("СальдоКонечноеОчереднаяСтрока"));
	
	ОбластиМакета.Вставить("СальдоКонечноеПоСчетамЗаголовок",				Макет.ПолучитьОбласть("СальдоКонечноеПоСчетамЗаголовок"));
	ОбластиМакета.Вставить("СальдоКонечноеПоСчетамСтрока",					Макет.ПолучитьОбласть("СальдоКонечноеПоСчетамСтрока"));
	ОбластиМакета.Вставить("СальдоКонечноеПодвал",							Макет.ПолучитьОбласть("СальдоКонечноеПодвал"));
	
	// Конечное сальдо всего
	ОбластиМакета.Вставить("Раздел1ВсегоСальдоКонечноеБезСчетовПерваяСтрока",	Макет.ПолучитьОбласть("Раздел1ВсегоСальдоКонечноеБезСчетовПерваяСтрока"));
	ОбластиМакета.Вставить("Раздел1ВсегоСальдоКонечноеБезСчетовОчереднаяСтрока",Макет.ПолучитьОбласть("Раздел1ВсегоСальдоКонечноеБезСчетовОчереднаяСтрока"));
	ОбластиМакета.Вставить("Раздел1ВсегоСальдоКонечноеПоСчетамЗаголовок",		Макет.ПолучитьОбласть("Раздел1ВсегоСальдоКонечноеПоСчетамЗаголовок"));
	ОбластиМакета.Вставить("Раздел1ВсегоСальдоКонечноеПоСчетамСтрока",			Макет.ПолучитьОбласть("Раздел1ВсегоСальдоКонечноеПоСчетамСтрока"));
	ОбластиМакета.Вставить("Раздел1ВсегоСальдоКонечноеПодвал",					Макет.ПолучитьОбласть("Раздел1ВсегоСальдоКонечноеПодвал"));
	
	ОбластиМакета.Вставить("Раздел1ЗаголовокПодписей",							Макет.ПолучитьОбласть("Раздел1ЗаголовокПодписей"));
	ОбластиМакета.Вставить("Раздел2ЗаголовокПодписей",							Макет.ПолучитьОбласть("Раздел2ЗаголовокПодписей"));
