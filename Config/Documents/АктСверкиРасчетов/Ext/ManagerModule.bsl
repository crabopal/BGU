Функция ПолучитьВыборкуПоТекущемуДокументу(СтрокаШапки, ОбщаяВыборкаТабличнойЧасти)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборкаТабличнойЧасти.Сбросить();
	ОбщаяВыборкаТабличнойЧасти.НайтиСледующий(ПоискТекущегоДокумента);
	
	Возврат ОбщаяВыборкаТабличнойЧасти.Выбрать();
	
КонецФункции

Функция ПолучитьВыборкуПоТекущемуДокументуИДоговору(СтрокаШапки, ОбщаяВыборкаТабличнойЧасти, ВыборкаСведенияДоговора)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборкаТабличнойЧасти.Сбросить();
	ОбщаяВыборкаТабличнойЧасти.НайтиСледующий(ПоискТекущегоДокумента);
	
	ПоискТекущегоДоговора = Новый Структура("Договор", ВыборкаСведенияДоговора.Договор);
	
	Выборка = ОбщаяВыборкаТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Выборка.НайтиСледующий(ПоискТекущегоДоговора);
	
	Возврат Выборка.Выбрать();
	
КонецФункции

Функция СформироватьПечатнуюФорму0510477(Данные, СтрокаШапки, ОбластиМакета, ТиповыеПараметры)
	
	ТабДокумент = НовыйТабличныйДокумент();
	
	ВывестиТитул(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	ВывестиРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ВывестиРаздел2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиТитул(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета)
	
	ЗначенияПараметров = Новый Структура();
	
	УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, СтрокаШапки.Ссылка, Данные.СведенияУчреждений);
	
	Область = ОбластиМакета.Заголовок;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	
	ТабДокумент.Вывести(Область);
	
КонецПроцедуры

#Область Раздел1

Процедура ВывестиРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета)
	
	ТабДокумент.Вывести(ОбластиМакета.Раздел1Заголовок);
	
	ТабДокумент.Вывести(ОбластиМакета.ШапкаТаблицы);
	
	ВывестиВсегоСальдоНачальное(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, 1);
	
	ВывестиСписокДоговоров(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, 1);
	
	ВывестиВсегоСальдоКонечное(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, 1);
	
	ВывестиПодписиРаздела1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
КонецПроцедуры

Процедура ВывестиПодписиРаздела1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета)
	
	ТабДокументПодписей = НовыйТабличныйДокумент();
	
	ТабДокументПодписей.Вывести(ОбластиМакета.Раздел1ЗаголовокПодписей);
	
	ВывестиПодписьРуководителяРаздела1(ТабДокументПодписей, Данные, СтрокаШапки, ОбластиМакета);
	
	ВывестиПодписьГлавбухаРаздела1(ТабДокументПодписей, Данные, СтрокаШапки, ОбластиМакета);
	
	ВывестиПодписьОтветственногоИсполнителяРаздела1(ТабДокументПодписей, Данные, СтрокаШапки, ОбластиМакета);
	
	ТабДокументПодписей.Вывести(ОбластиМакета.ДатаПодписи);
	
	Если Не ТабДокумент.ПроверитьВывод(ТабДокументПодписей) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(ТабДокументПодписей);
	
КонецПроцедуры

Процедура ВывестиПодписьРуководителяРаздела1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета)
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(
		СтрокаШапки.Руководитель, СтрокаШапки.Дата);
		
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Руководитель (уполномоченное им лицо)'"));
	
	Область = ОбластиМакета.ПодписьБезТелефона;
	
	Область.Параметры.Заполнить(ЗначенияПараметров);
	
	ТабДокумент.Вывести(Область);
	
КонецПроцедуры

