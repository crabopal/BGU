Функция НовыйПараметрыПроверкиЗаполнения()
	
	ПараметрыПроверкиЗаполнения = Новый Структура();
	ПараметрыПроверкиЗаполнения.Вставить("ИспользоватьВалютныйУчет",			ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	ПараметрыПроверкиЗаполнения.Вставить("ИспользоватьУчетПоИФО",				ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ПараметрыПроверкиЗаполнения.Вставить("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	Возврат ПараметрыПроверкиЗаполнения;
	
КонецФункции

Процедура ПроверитьКорректностьГраницПериодаСверки(ДокументОбъект, Отказ)
	
	ДатаНачала		= ДокументОбъект.ДатаНачала;
	ДатаОкончания	= ДокументОбъект.ДатаОкончания;
	
	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания)
		Или ДатаНачала <= ДатаОкончания Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьПользователю(
		НСтр("ru='Период сверки указан некорректно.
			|Дата начала периода сверки должна быть меньше или равна дате окончания периода сверки.'"),
		ДокументОбъект.Ссылка, "ДатаНачала", "Объект", Отказ);
	
КонецПроцедуры

Процедура ПроверитьСписокСчетов(ДокументОбъект, Отказ)
	
	СписокСчетовИсключений = ПолучитьСписокСчетовИсключений(ДокументОбъект.Дата, ДокументОбъект.Организация);
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.СписокСчетов Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Счет) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru='Счет'"), СтрокаТаблицы.НомерСтроки, НСтр("ru='Счета'")),
				ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СписокСчетов", СтрокаТаблицы.НомерСтроки, "Счет"),
				"Объект", Отказ);
		КонецЕсли;
		
		Если СписокСчетовИсключений.Найти(СтрокаТаблицы.Счет) <> Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					НСтр("ru='Счет'"), СтрокаТаблицы.НомерСтроки, НСтр("ru='Счета'"),
					НСтр("ru='Указанный счет входит в список исключений из заполнения акта сверки.'")),
				ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СписокСчетов", СтрокаТаблицы.НомерСтроки, "Счет"),
				"Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьСписокДоговоров(ДокументОбъект, Отказ)
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.СписокДоговоров Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Договор) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru='Договор'"), СтрокаТаблицы.НомерСтроки, НСтр("ru='Договоры'")),
				ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СписокДоговоров", СтрокаТаблицы.НомерСтроки, "Договор"),
				"Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаДублиСтрок = ОбщегоНазначенияБГУ.НайтиДублиСтрок(ДокументОбъект.СписокДоговоров, "Договор");
	
	Если ТаблицаДублиСтрок.Количество() > 0 Тогда
		Отказ = Истина;
		
		ПараметрыВывода = ОбщегоНазначенияБГУ.ПараметрыВыводаСообщенийОДубляхСтрок();
		ПараметрыВывода.ШаблонСтроки = НСтр("ru='Обнаружены дубли договоров (строки [НомераСтрок])'");
		ПараметрыВывода.ТаблицаИмя = "СписокДоговоров";
		ПараметрыВывода.ИмяПоляДляВыводаСообщений = "Договор";
		ПараметрыВывода.ОбъектСсылка = ДокументОбъект.Ссылка;
		
		ОбщегоНазначенияБГУ.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПризнакиКонтрагента(ДокументОбъект, Отказ)
	
	// Сейчас эта проверка не блокирующая. Отказ не устанавливаем.
	
	ПризнакиКонтрагента = ПрочитатьПризнакиКонтрагента(ДокументОбъект.Контрагент);
	
	ТекстСообщения = ТекстСообщенияПоПризнакамКонтрагента(ПризнакиКонтрагента);
	
	Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru='Справочно: %1'"), ТекстСообщения),
		ДокументОбъект.Ссылка, "Контрагент", "Объект");
	
КонецПроцедуры

Функция ПрочитатьПризнакиКонтрагента(Контрагент)
	
	ПризнакиКонтрагента = Новый Структура();
	ПризнакиКонтрагента.Вставить("ТипКонтрагента", "");
	ПризнакиКонтрагента.Вставить("ЭтоСотрудник", Ложь);
	ПризнакиКонтрагента.Вставить("ЭтоФизЛицо", Ложь);
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат ПризнакиКонтрагента;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Контрагент", Контрагент);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникКонтрагенты.Ссылка							КАК Контрагент,
	|	ЕСТЬNULL(СправочникТипыКонтрагентов.Код, """")			КАК ТипКонтрагента,
	|	МАКСИМУМ(НЕ СправочникСотрудники.Ссылка ЕСТЬ NULL)		КАК ЭтоСотрудник,
	|	МАКСИМУМ(НЕ СправочникФизическиеЛица.Ссылка ЕСТЬ NULL)	КАК ЭтоФизЛицо
	|ИЗ
	|	Справочник.Контрагенты КАК СправочникКонтрагенты
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК СправочникСотрудники
	|		ПО СправочникКонтрагенты.Ссылка = СправочникСотрудники.Контрагент
	|		И НЕ СправочникСотрудники.ПометкаУдаления
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК СправочникФизическиеЛица
	|		ПО СправочникКонтрагенты.ЮридическоеФизическоеЛицо = СправочникФизическиеЛица.Ссылка
	|		И НЕ СправочникФизическиеЛица.ПометкаУдаления
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТипыКонтрагентов КАК СправочникТипыКонтрагентов
	|		ПО СправочникКонтрагенты.ТипКонтрагента = СправочникТипыКонтрагентов.Ссылка
	|		И НЕ СправочникТипыКонтрагентов.ПометкаУдаления
	|ГДЕ
	|	СправочникКонтрагенты.Ссылка = &Контрагент
	|СГРУППИРОВАТЬ ПО
	|	СправочникКонтрагенты.Ссылка,
	|	ЕСТЬNULL(СправочникТипыКонтрагентов.Код, """")";
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ПризнакиКонтрагента, Выборка);
	КонецЕсли;
	
	Возврат ПризнакиКонтрагента;
	
КонецФункции

Функция ТекстСообщенияПоПризнакамКонтрагента(ПризнакиКонтрагента)
	
	ОбщийТекст = НСтр("ru='Убедитесь, что составление акта сверки в отношении таких контрагентов предусмотрено законодательством.'");
	
	Если ПризнакиКонтрагента.ЭтоСотрудник Тогда
		Возврат СтрШаблон(НСтр("ru='Указанный контрагент является сотрудником учреждения.
			|%1'"), ОбщийТекст);
	КонецЕсли;
	
	Если ПризнакиКонтрагента.ТипКонтрагента = "7" Тогда
		Возврат СтрШаблон(НСтр("ru='Указанный контрагент является физическим лицом.
			|%1'"), ОбщийТекст);
	КонецЕсли;
	
	Если ПризнакиКонтрагента.ТипКонтрагента = "8" Или ПризнакиКонтрагента.ТипКонтрагента = "9" Тогда
		Возврат СтрШаблон(НСтр("ru='Указанный контрагент является нерезидентом.
			|%1'"), ОбщийТекст);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ПроверитьРаздел1СальдоНачальноеБезСчетов(ДокументОбъект, ПараметрыПроверкиЗаполнения, Отказ)
	
	ИмяТЧ = "Раздел1СальдоНачальноеБезСчетов";
	
	ИменаКолонок = Новый Массив();
	ИменаКолонок.Добавить("Договор");
	
	Если ПараметрыПроверкиЗаполнения.ИспользоватьУчетПоИФО Тогда
		ИменаКолонок.Добавить("ИФО");
	КонецЕсли;
	
	Если ПараметрыПроверкиЗаполнения.ИспользоватьУчетПоПодразделениям Тогда
		ИменаКолонок.Добавить("Подразделение");
	КонецЕсли;
	
	Если ПараметрыПроверкиЗаполнения.ИспользоватьВалютныйУчет Тогда
		ИменаКолонок.Добавить("Валюта");
	КонецЕсли;
	
	ТаблицаДублиСтрок = ОбщегоНазначенияБГУ.НайтиДублиСтрок(ДокументОбъект[ИмяТЧ], ИменаКолонок, Истина);
	
	Если ТаблицаДублиСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	ПредставлениеТЧ = Метаданные.Документы.АктСверкиРасчетов.ТабличныеЧасти[ИмяТЧ].Синоним;
	
	ПараметрыВывода = ОбщегоНазначенияБГУ.ПараметрыВыводаСообщенийОДубляхСтрок();
	ПараметрыВывода.ТаблицаИмя					= ИмяТЧ;
	ПараметрыВывода.ТаблицаПредставление		= ПредставлениеТЧ;
	ПараметрыВывода.ОбъектСсылка				= ДокументОбъект.Ссылка;
	ПараметрыВывода.ШаблонСтроки				= НСтр("ru='Обнаружены дубли договоров (Таблица ""[ТаблицаПредставление]"", строки [НомераСтрок])'");
	ПараметрыВывода.ИмяПоляДляВыводаСообщений	= "Договор";
	
	ОбщегоНазначенияБГУ.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	
КонецПроцедуры

#Область СовместноеЗаполнениеТаблицРаздела1

// Расчет.

Процедура ПроверитьСовместноеЗаполнениеТаблицРаздела1(ДокументОбъект, ПараметрыПроверкиЗаполнения, Отказ = Неопределено)
	
	ПараметрыРасчета = ПолучитьПараметрыРасчетаНарушений(ДокументОбъект, ПараметрыПроверкиЗаполнения);
	
	ТаблицаНарушений = РассчитатьТаблицуНарушений(ПараметрыРасчета);
	
	Если ТаблицаНарушений.Количество() > 0 Тогда
		СообщитьОНаличииНарушений(ДокументОбъект, ТаблицаНарушений, ПараметрыРасчета, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПараметрыРасчетаНарушений(ДокументОбъект, ПараметрыПроверкиЗаполнения)
	
	КолонкиСвязи = "Договор,Валюта";
	
	Если ПараметрыПроверкиЗаполнения.ИспользоватьУчетПоИФО Тогда
		КолонкиСвязи = КолонкиСвязи + ",ИФО";
	КонецЕсли;
	
	Если ПараметрыПроверкиЗаполнения.ИспользоватьУчетПоПодразделениям Тогда
		КолонкиСвязи = КолонкиСвязи + ",Подразделение";
	КонецЕсли;
	
	КолонкиПоиска = КолонкиСвязи + ",СтрокаОбработана";
	
	КолонкиСумм = ПолучитьКолонкиСуммовыхПоказателейБезВсего();
	
	ОбщийСписокСуммовыхКолонокБезВсего = СтрРазделить(КолонкиСумм, ", ", Ложь);
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ТаблицаОборотов = ДокументОбъект.Раздел1Операции.Выгрузить(, КолонкиСвязи + "," + КолонкиСумм);
	ТаблицаОборотов.Свернуть(КолонкиСвязи, КолонкиСумм);
	РассчитатьСвернутыеПоказателиВТаблице(ТаблицаОборотов, ВалютаРУ);
	УдалитьПолностьюНулевыеСтроки(ТаблицаОборотов);
	ДобавитьКолонкуСтрокаОбработана(ТаблицаОборотов);
	ТаблицаОборотов.Индексы.Добавить(КолонкиПоиска);
	
	ТаблицаСальдоНачальное = ДокументОбъект.Раздел1СальдоНачальноеБезСчетов.Выгрузить(, КолонкиСвязи + "," + КолонкиСумм);
	ТаблицаСальдоНачальное.Свернуть(КолонкиСвязи, КолонкиСумм);
	РассчитатьСвернутыеПоказателиВТаблице(ТаблицаСальдоНачальное, ВалютаРУ);
	ДобавитьКолонкуСтрокаОбработана(ТаблицаСальдоНачальное);
	ТаблицаСальдоНачальное.Индексы.Добавить(КолонкиПоиска);
	
	ТаблицаСальдоКонечное = ДокументОбъект.Раздел1СальдоКонечноеПоСчетам.Выгрузить(, КолонкиСвязи + "," + КолонкиСумм);
	ТаблицаСальдоКонечное.Свернуть(КолонкиСвязи, КолонкиСумм);
	РассчитатьСвернутыеПоказателиВТаблице(ТаблицаСальдоКонечное, ВалютаРУ);
	ДобавитьКолонкуСтрокаОбработана(ТаблицаСальдоКонечное);
	ТаблицаСальдоКонечное.Индексы.Добавить(КолонкиПоиска);
	
	// Только рублевые поля для ускорения работы.
	КолонкиСвернутыхПолейРуб = СтрРазделить(ПолучитьКолонкиСвернутыхСуммовыхПоказателейРуб(), ", ", Ложь);
	
	// И валютные, и рублевые поля.
	КолонкиСвернутыхПолейВал = СтрРазделить(ПолучитьКолонкиСвернутыхСуммовыхПоказателейВал()
		+ "," + ПолучитьКолонкиСвернутыхСуммовыхПоказателейРуб(), ", ", Ложь);
	
	ПолностьюНулеваяСтрока = ПолучитьПолностьюНулевуюСтроку(КолонкиСвернутыхПолейВал);
	
	ПараметрыРасчета = Новый Структура();
	ПараметрыРасчета.Вставить("ТаблицаОборотов", ТаблицаОборотов);
	ПараметрыРасчета.Вставить("ТаблицаСальдоНачальное", ТаблицаСальдоНачальное);
	ПараметрыРасчета.Вставить("ТаблицаСальдоКонечное", ТаблицаСальдоКонечное);
	ПараметрыРасчета.Вставить("КолонкиСвязи", КолонкиСвязи);
	ПараметрыРасчета.Вставить("КолонкиПоиска", КолонкиПоиска);
	ПараметрыРасчета.Вставить("ВалютаРУ", ВалютаРУ);
	ПараметрыРасчета.Вставить("КолонкиСвернутыхПолейРуб", КолонкиСвернутыхПолейРуб);
	ПараметрыРасчета.Вставить("КолонкиСвернутыхПолейВал", КолонкиСвернутыхПолейВал);
	ПараметрыРасчета.Вставить("ПолностьюНулеваяСтрока", ПолностьюНулеваяСтрока);
	
	Возврат ПараметрыРасчета;
	
КонецФункции

Функция НовыйТаблицаНарушений()
	
	ТаблицаНарушений = Новый ТаблицаЗначений();
	ТаблицаНарушений.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаНарушений.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаНарушений.Колонки.Добавить("ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаНарушений.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	ТаблицаНарушений.Колонки.Добавить("ЕстьВТаблицеОборотов", Новый ОписаниеТипов("Булево"));
	ТаблицаНарушений.Колонки.Добавить("ЕстьВТаблицеСальдоНачальное", Новый ОписаниеТипов("Булево"));
	ТаблицаНарушений.Колонки.Добавить("ЕстьВТаблицеСальдоКонечное", Новый ОписаниеТипов("Булево"));
	
	ТаблицаНарушений.Колонки.Добавить("ИменаПолейНарушений", Новый ОписаниеТипов("Массив"));
	
	ТипСумма = ОбщегоНазначения.ОписаниеТипаЧисло(18, 2, ДопустимыйЗнак.Любой);
	
	ИменаКолонок = СтрРазделить(ПолучитьКолонкиСуммовыхПоказателейТаблицыНарушений(), ", ", Ложь);
	
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		ТаблицаНарушений.Колонки.Добавить(ИмяКолонки, ТипСумма);
	КонецЦикла;
	
	Возврат ТаблицаНарушений;
	
КонецФункции

Функция РассчитатьТаблицуНарушений(ПараметрыРасчета);
	
	ТаблицаНарушений = НовыйТаблицаНарушений();
	
	ДобавитьНарушенияПриОбходеТаблицы(ТаблицаНарушений, "ТаблицаОборотов", ПараметрыРасчета);
	ДобавитьНарушенияПриОбходеТаблицы(ТаблицаНарушений, "ТаблицаСальдоНачальное", ПараметрыРасчета);
	ДобавитьНарушенияПриОбходеТаблицы(ТаблицаНарушений, "ТаблицаСальдоКонечное", ПараметрыРасчета);
	
	Возврат ТаблицаНарушений;
	
КонецФункции

// Параметры:
//	ПараметрыРасчета - Структура - см. функцию ПолучитьПараметрыРасчетаНарушений().
//	ИмяТаблицыОбхода - Строка - имя таблицы в переданной структуре ПараметрыРасчета.
//					Одно из значений "ТаблицаОборотов", "ТаблицаСальдоНачальное", "ТаблицаСальдоКонечное".
Процедура ДобавитьНарушенияПриОбходеТаблицы(ТаблицаНарушений, ИмяТаблицыОбхода, ПараметрыРасчета)
	
	ВалютаРУ					= ПараметрыРасчета.ВалютаРУ;
	КолонкиСвернутыхПолейРуб	= ПараметрыРасчета.КолонкиСвернутыхПолейРуб;
	КолонкиСвернутыхПолейВал	= ПараметрыРасчета.КолонкиСвернутыхПолейВал;
	ПолностьюНулеваяСтрока		= ПараметрыРасчета.ПолностьюНулеваяСтрока;
	
	Поиск = Новый Структура(ПараметрыРасчета.КолонкиПоиска);
	
	ТаблицыПоиска = Новый Массив();
	
	Если ИмяТаблицыОбхода = "ТаблицаОборотов" Тогда
		ТаблицыПоиска.Добавить("ТаблицаСальдоНачальное");
		ТаблицыПоиска.Добавить("ТаблицаСальдоКонечное");
			
	ИначеЕсли ИмяТаблицыОбхода = "ТаблицаСальдоНачальное" Тогда
		ТаблицыПоиска.Добавить("ТаблицаОборотов");
		ТаблицыПоиска.Добавить("ТаблицаСальдоКонечное");
		
	ИначеЕсли ИмяТаблицыОбхода = "ТаблицаСальдоКонечное" Тогда
		ТаблицыПоиска.Добавить("ТаблицаОборотов");
		ТаблицыПоиска.Добавить("ТаблицаСальдоНачальное");
	КонецЕсли;
	
	СтруктураКолонок = Неопределено;
	
	ЕстьВТаблицеОборотов = Ложь;
	ЕстьВТаблицеСальдоНачальное = Ложь;
	ЕстьВТаблицеСальдоКонечное = Ложь;
	
	ТаблицаОбхода = ПараметрыРасчета[ИмяТаблицыОбхода];
	
	ПоискТаблицыОбхода = Новый Структура("СтрокаОбработана", Ложь);
	
	МассивСтрокТаблицыОбхода = ТаблицаОбхода.НайтиСтроки(ПоискТаблицыОбхода);
	
	Для Каждого СтрокаТаблицыОбхода Из МассивСтрокТаблицыОбхода Цикл
		СтрокаТаблицыОбхода.СтрокаОбработана = Истина;
		
		Если ИмяТаблицыОбхода = "ТаблицаОборотов" Тогда
			СтрокаОборотов = СтрокаТаблицыОбхода;
			ЕстьВТаблицеОборотов = Истина;
			
		ИначеЕсли ИмяТаблицыОбхода = "ТаблицаСальдоНачальное" Тогда
			СтрокаСальдоНачальное = СтрокаТаблицыОбхода;
			ЕстьВТаблицеСальдоНачальное = Истина;
			
		ИначеЕсли ИмяТаблицыОбхода = "ТаблицаСальдоКонечное" Тогда
			СтрокаСальдоКонечное = СтрокаТаблицыОбхода;
			ЕстьВТаблицеСальдоКонечное = Истина;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицыОбхода);
		Поиск.СтрокаОбработана = Ложь;
		
		Для Каждого ИмяТаблицы Из ТаблицыПоиска Цикл
			МассивСтрок = ПараметрыРасчета[ИмяТаблицы].НайтиСтроки(Поиск);
			
			ЕстьВТаблице = (МассивСтрок.Количество() > 0);
			
			Если ЕстьВТаблице Тогда
				СтрокаТаблицы = МассивСтрок[0];
				СтрокаТаблицы.СтрокаОбработана = Истина;
			Иначе
				СтрокаТаблицы = ПолностьюНулеваяСтрока;
			КонецЕсли;
			
			Если ИмяТаблицы = "ТаблицаОборотов" Тогда
				СтрокаОборотов = СтрокаТаблицы;
				ЕстьВТаблицеОборотов = ЕстьВТаблице;
				
			ИначеЕсли ИмяТаблицы = "ТаблицаСальдоНачальное" Тогда
				СтрокаСальдоНачальное = СтрокаТаблицы;
				ЕстьВТаблицеСальдоНачальное = ЕстьВТаблице;
				
			ИначеЕсли ИмяТаблицы = "ТаблицаСальдоКонечное" Тогда
				СтрокаСальдоКонечное = СтрокаТаблицы;
				ЕстьВТаблицеСальдоКонечное = ЕстьВТаблице;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаТаблицыОбхода.Валюта = ВалютаРУ Тогда
			КолонкиСвернутыхПолейСумм = КолонкиСвернутыхПолейРуб;
		Иначе
			КолонкиСвернутыхПолейСумм = КолонкиСвернутыхПолейВал;
		КонецЕсли;
		
		СтруктураКолонок = ОпределитьКолонкиНарушающиеРавенство(СтрокаОборотов, СтрокаСальдоНачальное, СтрокаСальдоКонечное, КолонкиСвернутыхПолейСумм);
		
		Если СтруктураКолонок.Количество() > 0 Тогда
			НоваяСтрока = ТаблицаНарушений.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Поиск);
			
			НоваяСтрока.ЕстьВТаблицеОборотов = ЕстьВТаблицеОборотов;
			НоваяСтрока.ЕстьВТаблицеСальдоНачальное = ЕстьВТаблицеСальдоНачальное;
			НоваяСтрока.ЕстьВТаблицеСальдоКонечное = ЕстьВТаблицеСальдоКонечное;
			
			ИменаПолейНарушений = Новый Массив();
			
			Для Каждого Элемент Из СтруктураКолонок Цикл
				ИмяПоляНарушения = Элемент.Ключ;
				ОписаниеНарушения = Элемент.Значение;
				
				ИменаПолейНарушений.Добавить(ИмяПоляНарушения);
				
				НоваяСтрока[ИмяПоляНарушения + "ОжидаемоеЗначение"] = ОписаниеНарушения.ОжидаемоеЗначение;
				НоваяСтрока[ИмяПоляНарушения + "ФактическоеЗначение"] = ОписаниеНарушения.ФактическоеЗначение;
			КонецЦикла;
			
			НоваяСтрока.ИменаПолейНарушений = ИменаПолейНарушений;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура РассчитатьСвернутыеПоказателиВТаблице(Таблица, ВалютаРУ)
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		РассчитатьСвернутыеПоказателиВСтрокеТаблицы(СтрокаТаблицы, "СуммаОДРубДебет",			"СуммаОДРубКредит");
		РассчитатьСвернутыеПоказателиВСтрокеТаблицы(СтрокаТаблицы, "СуммаПроцентовРубДебет",	"СуммаПроцентовРубКредит");
		РассчитатьСвернутыеПоказателиВСтрокеТаблицы(СтрокаТаблицы, "СуммаШтрафовРубДебет",		"СуммаШтрафовРубКредит");
		РассчитатьСвернутыеПоказателиВСтрокеТаблицы(СтрокаТаблицы, "СуммаПенейРубДебет",		"СуммаПенейРубКредит");
		
		Если СтрокаТаблицы.Валюта <> ВалютаРУ Тогда
			РассчитатьСвернутыеПоказателиВСтрокеТаблицы(СтрокаТаблицы, "СуммаОДВалДебет",			"СуммаОДВалКредит");
			РассчитатьСвернутыеПоказателиВСтрокеТаблицы(СтрокаТаблицы, "СуммаПроцентовВалДебет",	"СуммаПроцентовВалКредит");
			РассчитатьСвернутыеПоказателиВСтрокеТаблицы(СтрокаТаблицы, "СуммаШтрафовВалДебет",		"СуммаШтрафовВалКредит");
			РассчитатьСвернутыеПоказателиВСтрокеТаблицы(СтрокаТаблицы, "СуммаПенейВалДебет",		"СуммаПенейВалКредит");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура РассчитатьСвернутыеПоказателиВСтрокеТаблицы(СтрокаТаблицы, ИмяПоляСуммаДебет, ИмяПоляСуммаКредит)
	
	// Результат расчета записывается в колонку Дебета, далее эта колонка считается значением свернутого показателя.
	
	СтрокаТаблицы[ИмяПоляСуммаДебет] = СтрокаТаблицы[ИмяПоляСуммаДебет] - СтрокаТаблицы[ИмяПоляСуммаКредит];
	
КонецПроцедуры

Процедура ДобавитьКолонкуСтрокаОбработана(Таблица)
	
	Таблица.Колонки.Добавить("СтрокаОбработана", Новый ОписаниеТипов("Булево"));
	
КонецПроцедуры

Функция ПолучитьПолностьюНулевуюСтроку(СписокКолонок)
	
	СтруктураСтроки = Новый Структура();
	
	Для Каждого ИмяПоля Из СписокКолонок Цикл
		СтруктураСтроки.Вставить(ИмяПоля, 0);
	КонецЦикла;
	
	Возврат СтруктураСтроки;
	
КонецФункции

Функция ОпределитьКолонкиНарушающиеРавенство(СтрокаОборота, СтрокаСальдоНачальное, СтрокаСальдоКонечное, КолонкиСвернутыхПолейСумм)
	
	СтруктураКолонок = Новый Структура();
	
	Для Каждого ИмяКолонки Из КолонкиСвернутыхПолейСумм Цикл
		ОжидаемоеЗначение = СтрокаСальдоНачальное[ИмяКолонки] + СтрокаОборота[ИмяКолонки];
		ФактическоеЗначение = СтрокаСальдоКонечное[ИмяКолонки];
		
		Если ОжидаемоеЗначение <> ФактическоеЗначение Тогда
			СтруктураКолонок.Вставить(
				ПолучитьИмяПоляНарушения(ИмяКолонки),
				НовыйОписаниеНарушенияКолонки(ОжидаемоеЗначение,ФактическоеЗначение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураКолонок;
	
КонецФункции

Функция НовыйОписаниеНарушенияКолонки(ОжидаемоеЗначение,ФактическоеЗначение)
	
	Возврат Новый Структура("ОжидаемоеЗначение,ФактическоеЗначение",
		ОжидаемоеЗначение, ФактическоеЗначение);
	
КонецФункции

// Вывод сообщений.

Процедура СообщитьОНаличииНарушений(ДокументОбъект, ТаблицаНарушений, ПараметрыРасчета, Отказ, МаксимальноеКоличествоСообщений = 20)
	
	Перем ПолеДляВыводаСообщения, СтрокаТаблицыДляВыводаСообщения;
	Перем ПредставлениеОжидаемогоЗначения, ПредставлениеФактическогоЗначения, ПредставлениеРазницы;
	Перем ДобавленоВручную;
	
	СообщениеИнформационное = (Отказ = Неопределено);
	
	ТекстСправочно = ?(СообщениеИнформационное, НСтр("ru='Справочно: '"), "");
	
	Отказ = Истина;
	
	СчетчикСообщений = 0;
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТаблицыНарушений Из ТаблицаНарушений Цикл
		НомерСтроки = НомерСтроки + 1;
		
		ЭтоВалютаРУ = (СтрокаТаблицыНарушений.Валюта = ПараметрыРасчета.ВалютаРУ);
		
		Для Каждого ИмяПоляНарушения Из СтрокаТаблицыНарушений.ИменаПолейНарушений Цикл
			СчетчикСообщений = СчетчикСообщений + 1;
			
			Если СчетчикСообщений > МаксимальноеКоличествоСообщений Тогда
				ОсталосьСтрокТаблицы = ТаблицаНарушений.Количество() - НомерСтроки;
				
				Если ОсталосьСтрокТаблицы = 0 Тогда
					Индекс = СтрокаТаблицыНарушений.ИменаПолейНарушений.Найти(ИмяПоляНарушения);
					КоличествоОшибокОсталосьЕще = СтрокаТаблицыНарушений.ИменаПолейНарушений.ВГраница() - Индекс + 1;
					
					ТекстШаблон = НСтр("ru='еще %1'");
				Иначе
					КоличествоОшибокОсталосьЕще = ОсталосьСтрокТаблицы;
					ТекстШаблон = НСтр("ru='еще как минимум %1'");
				КонецЕсли;
				
				ТекстОшибокОсталосьЕще = СтрШаблон(ТекстШаблон, КоличествоОшибокОсталосьЕще);
				
				ТекстСообщения = СтрШаблон(
					НСтр("ru='%1Обнаружено больше ошибок расчета свернутого сальдо Конечного (%2), чем сообщено. Установлено ограничение на количество выводимых сообщений (%3) о таких ошибках.'"),
					ТекстСправочно,
					ТекстОшибокОсталосьЕще,
					МаксимальноеКоличествоСообщений);
					
				// Выводим это сообщение к тому же полю, что и ранее выведенное сообщение.
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, ПолеДляВыводаСообщения, "Объект");
					
				Возврат;
			КонецЕсли;
			
			ТекстБольшеМеньше = ПолучитьТекстБольшеМеньше(СтрокаТаблицыНарушений, ИмяПоляНарушения);
			
			ИмяТЧДляВыводаСообщения = ОпределитьТабличнуюЧастьДляВыводаСообщенияОНарушении(
				ДокументОбъект, СтрокаТаблицыНарушений, ПараметрыРасчета, СтрокаТаблицыДляВыводаСообщения, ДобавленоВручную);
			
			ТекстПричины = ?(ДобавленоВручную, "", НСтр("ru='
				|Некоторые проводки за период не включены в табличную часть ""Операции"", но влияют на конечное сальдо.'"));

			ИмяПоляСообщения = ПолучитьИмяПоляДляВыводаСообщенияОНарушении(СтрокаТаблицыНарушений, СтрокаТаблицыДляВыводаСообщения, ИмяПоляНарушения);
			
			ПредставлениеПоляСообщения = ПолучитьПредставлениеПоляДляВыводаСообщенияОНарушении(ИмяПоляНарушения, ЭтоВалютаРУ);
			
			ОпределитьПредставленияВыводимыхЗначений(СтрокаТаблицыНарушений, ИмяПоляНарушения,
				ПредставлениеОжидаемогоЗначения, ПредставлениеФактическогоЗначения, ПредставлениеРазницы);
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='%1Для показателя ""%2"" сальдо Конечное по договору (%3) %4 чем расчетное (%5) на величину %6.
					|Расчетное значение сальдо Конечного по договору определяется для показателей без разреза по счетам по формуле сальдо Начальное плюс Обороты.%7'"),
				ТекстСправочно,
				ПредставлениеПоляСообщения,
				ПредставлениеФактическогоЗначения,
				ТекстБольшеМеньше,
				ПредставлениеОжидаемогоЗначения,
				ПредставлениеРазницы,
				ТекстПричины);
				
			Если СтрокаТаблицыДляВыводаСообщения = Неопределено Тогда
				ПолеДляВыводаСообщения = ИмяТЧДляВыводаСообщения;
			Иначе
				ПолеДляВыводаСообщения = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
					ИмяТЧДляВыводаСообщения, СтрокаТаблицыДляВыводаСообщения.НомерСтроки, ИмяПоляСообщения);
			КонецЕсли;
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, ПолеДляВыводаСообщения, "Объект");
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТекстБольшеМеньше(СтрокаТаблицыНарушений, ИмяПоляНарушения)
	
	ОжидаемоеЗначение = СтрокаТаблицыНарушений[ИмяПоляНарушения + "ОжидаемоеЗначение"];
	ФактическоеЗначение = СтрокаТаблицыНарушений[ИмяПоляНарушения + "ФактическоеЗначение"];
	
	ЗначенияОдинаковогоЗнака =
		(ОжидаемоеЗначение >= 0 И ФактическоеЗначение >= 0
		Или ОжидаемоеЗначение <= 0 И ФактическоеЗначение <= 0);
	
	Если ЗначенияОдинаковогоЗнака Тогда
		АбсолютноеОжидаемоеЗначение = Макс(ОжидаемоеЗначение, -ОжидаемоеЗначение);
		АбсолютноеФактическоеЗначение = Макс(ФактическоеЗначение, -ФактическоеЗначение);
		
		Возврат ?(АбсолютноеФактическоеЗначение > АбсолютноеОжидаемоеЗначение, НСтр("ru='больше'"), НСтр("ru='меньше'"));
	Иначе
		Возврат ?(ФактическоеЗначение > ОжидаемоеЗначение, НСтр("ru='больше'"), НСтр("ru='меньше'"));
	КонецЕсли;
	
КонецФункции

Функция ПолучитьИмяПоляДляВыводаСообщенияОНарушении(СтрокаТаблицыНарушений, СтрокаТаблицыДляВыводаСообщения, ИмяПоляНарушения)
	
	ИмяПоляДебет = ИмяПоляНарушения + "Дебет";
	ИмяПоляКредит = ИмяПоляНарушения + "Кредит";
	
	ЗначениеДебет = СтрокаТаблицыДляВыводаСообщения[ИмяПоляДебет];
	ЗначениеКредит = СтрокаТаблицыДляВыводаСообщения[ИмяПоляКредит];
	
	ФактическоеЗначение = СтрокаТаблицыНарушений[ИмяПоляНарушения + "ФактическоеЗначение"];
	
	Если ЗначениеДебет <> 0 И ЗначениеКредит <> 0 Тогда
		Возврат ?(ФактическоеЗначение >= 0, ИмяПоляДебет, ИмяПоляКредит);
		
	ИначеЕсли ЗначениеДебет <> 0 Тогда
		Возврат ИмяПоляДебет;
		
	Иначе
		Возврат ИмяПоляКредит;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьПредставлениеПоляДляВыводаСообщенияОНарушении(ИмяПоляНарушения, ЭтоВалютаРУ)
	
	Если ЭтоВалютаРУ Тогда
		Если ИмяПоляНарушения = "СуммаОДРуб" Тогда
			Возврат "Основной долг";
			
		ИначеЕсли ИмяПоляНарушения = "СуммаПроцентовРуб" Тогда
			Возврат "Проценты";
			
		ИначеЕсли ИмяПоляНарушения = "СуммаШтрафовРуб" Тогда
			Возврат "Штрафы";
			
		ИначеЕсли ИмяПоляНарушения = "СуммаПенейРуб" Тогда
			Возврат "Пени";
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяПоляНарушения = "СуммаОДРуб" Тогда
		Возврат "Основной долг, в рублях";
		
	ИначеЕсли ИмяПоляНарушения = "СуммаПроцентовРуб" Тогда
		Возврат "Проценты, в рублях";
		
	ИначеЕсли ИмяПоляНарушения = "СуммаШтрафовРуб" Тогда
		Возврат "Штрафы, в рублях";
		
	ИначеЕсли ИмяПоляНарушения = "СуммаПенейРуб" Тогда
		Возврат "Пени, в рублях";
	КонецЕсли;
	
	Если ИмяПоляНарушения = "СуммаОДВал" Тогда
		Возврат "Основной долг, в валюте";
		
	ИначеЕсли ИмяПоляНарушения = "СуммаПроцентовВал" Тогда
		Возврат "Проценты, в валюте";
		
	ИначеЕсли ИмяПоляНарушения = "СуммаШтрафовВал" Тогда
		Возврат "Штрафы, в валюте";
		
	ИначеЕсли ИмяПоляНарушения = "СуммаПенейВал" Тогда
		Возврат "Пени, в валюте";
	КонецЕсли;
	
КонецФункции

Процедура ОпределитьПредставленияВыводимыхЗначений(СтрокаТаблицыНарушений, ИмяПоляНарушения,
		ПредставлениеОжидаемогоЗначения, ПредставлениеФактическогоЗначения, ПредставлениеРазницы)
		
	ТекстШаблонБезСтороны = "%1";
	ТекстШаблонДебетовое = НСтр("ru='дебетовое %1'");
	ТекстШаблонКредитовое = НСтр("ru='кредитовое %1'");
	
	ФорматнаяСтрока = "ЧН=0,00; ЧДЦ=2";
	
	ОжидаемоеЗначение = СтрокаТаблицыНарушений[ИмяПоляНарушения + "ОжидаемоеЗначение"];
	
	ФактическоеЗначение = СтрокаТаблицыНарушений[ИмяПоляНарушения + "ФактическоеЗначение"];
	
	Разница = ОжидаемоеЗначение - ФактическоеЗначение;
	
	ЗначенияОдинаковогоЗнака =
		(ОжидаемоеЗначение >= 0 И ФактическоеЗначение >= 0
		Или ОжидаемоеЗначение <= 0 И ФактическоеЗначение <= 0);
	
	Если ЗначенияОдинаковогоЗнака Тогда
		ТекстШаблонОжидаемоеЗначение = ТекстШаблонБезСтороны;
		ТекстШаблонФактическоеЗначение = ?(ФактическоеЗначение >= 0, ТекстШаблонДебетовое, ТекстШаблонКредитовое);
	Иначе
		ТекстШаблонОжидаемоеЗначение = ?(ОжидаемоеЗначение >= 0, ТекстШаблонДебетовое, ТекстШаблонКредитовое);
		ТекстШаблонФактическоеЗначение = ?(ФактическоеЗначение >= 0, ТекстШаблонДебетовое, ТекстШаблонКредитовое);
	КонецЕсли;
	
	АбсолютноеОжидаемоеЗначение = Макс(ОжидаемоеЗначение, -ОжидаемоеЗначение);
	АбсолютноеФактическоеЗначение = Макс(ФактическоеЗначение, -ФактическоеЗначение);
	АбсолютнаяРазница = Макс(Разница, -Разница);
	
	ПредставлениеОжидаемогоЗначения		= СтрШаблон(ТекстШаблонОжидаемоеЗначение, Формат(АбсолютноеОжидаемоеЗначение, ФорматнаяСтрока));
	ПредставлениеФактическогоЗначения	= СтрШаблон(ТекстШаблонФактическоеЗначение, Формат(АбсолютноеФактическоеЗначение, ФорматнаяСтрока));
	
	ПредставлениеРазницы = Формат(АбсолютнаяРазница, ФорматнаяСтрока);
	
КонецПроцедуры

Функция ОпределитьТабличнуюЧастьДляВыводаСообщенияОНарушении(Знач ДокументОбъект, Знач СтрокаТаблицыНарушений, Знач ПараметрыРасчета, СтрокаТаблицы, ДобавленоВручную)
	
	// Если где-то есть строка, добавленная вручную, то вероятно нарушение вызвано этим фактом.
	// Поэтому выводим сообщение о нарушении в такой табличной части.
	// Если добавленных вручную строк нет нигде, выводим в табличной части, имеющей строку по договору,
	// чтобы можно было спозиционировать сообщение на конкретной строке табличной части.
	
	// Сначала пробуем найти добавленные вручную строки в табличных частях, допускающих добавление строк.
	ДобавленоВручную = Истина;
	ИменаТЧ = Новый Массив();
	ИменаТЧ.Добавить("Раздел1СальдоКонечноеПоСчетам");
	ИменаТЧ.Добавить("Раздел1СальдоНачальноеБезСчетов");
	ИменаТЧ.Добавить("Раздел1Операции");
	
	ПоискДобавленоВручную = Новый Структура(ПараметрыРасчета.КолонкиСвязи);
	
	ЗаполнитьЗначенияСвойств(ПоискДобавленоВручную, СтрокаТаблицыНарушений);
	
	ПоискДобавленоВручную.Вставить("ДобавленоВручную", Истина);
	
	Для Каждого ИмяТЧ Из ИменаТЧ Цикл
		Если ИмяТЧ = "Раздел1Операции" И Не СтрокаТаблицыНарушений.ЕстьВТаблицеОборотов
			Или ИмяТЧ = "Раздел1СальдоНачальноеБезСчетов" И Не СтрокаТаблицыНарушений.ЕстьВТаблицеСальдоНачальное
			Или ИмяТЧ = "Раздел1СальдоКонечноеПоСчетам" И Не СтрокаТаблицыНарушений.ЕстьВТаблицеСальдоКонечное Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрок = ДокументОбъект[ИмяТЧ].НайтиСтроки(ПоискДобавленоВручную);
		
		Если МассивСтрок.Количество() > 0 Тогда
			СтрокаТаблицы = МассивСтрок[0];
			
			Возврат ИмяТЧ;
		КонецЕсли;
	КонецЦикла;
	
	// Теперь определяем табличную часть без учета наличия добавленных строк.
	ДобавленоВручную = Ложь;
	ИменаТЧ = Новый Массив();
	ИменаТЧ.Добавить("Раздел1СальдоКонечноеБезСчетов");
	ИменаТЧ.Добавить("Раздел1СальдоНачальноеБезСчетов");
	ИменаТЧ.Добавить("Раздел1Операции");
	
	Поиск = Новый Структура(ПараметрыРасчета.КолонкиСвязи);
	
	ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицыНарушений);
	
	МассивСтрок = ДокументОбъект.Раздел1СальдоКонечноеПоСчетам.НайтиСтроки(Поиск);
	
	Для Каждого ИмяТЧ Из ИменаТЧ Цикл
		Если ИмяТЧ = "Раздел1Операции" И Не СтрокаТаблицыНарушений.ЕстьВТаблицеОборотов
			Или ИмяТЧ = "Раздел1СальдоНачальноеБезСчетов" И Не СтрокаТаблицыНарушений.ЕстьВТаблицеСальдоНачальное
			Или ИмяТЧ = "Раздел1СальдоКонечноеБезСчетов" И Не СтрокаТаблицыНарушений.ЕстьВТаблицеСальдоКонечное Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрок = ДокументОбъект[ИмяТЧ].НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			СтрокаТаблицы = МассивСтрок[0];
			
			Возврат ИмяТЧ;
		КонецЕсли;
	КонецЦикла;
	
	СтрокаТаблицы = Неопределено;
	
	Возврат "Раздел1СальдоКонечноеБезСчетов";
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область УсловноеОформление

Процедура УстановитьУсловноеОформление(ФормаДокумента)
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВалютаРУ", ФормаДокумента.ВалютаРУ);
	
	ДобавитьУсловноеОформление_Отбор(ФормаДокумента, ДополнительныеПараметры);
	
	ДобавитьУсловноеОформление_Раздел1(ФормаДокумента, ДополнительныеПараметры);
	
	ДобавитьУсловноеОформление_Раздел2(ФормаДокумента, ДополнительныеПараметры);
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_Раздел1(ФормаДокумента, ДополнительныеПараметры)
	
	ДобавитьУсловноеОформление_НадписиИВалютныеСуммыРаздела1(ФормаДокумента, ДополнительныеПараметры);
	
	ДобавитьУсловноеОформление_УстановленФильтрСтрокРаздела1(ФормаДокумента, ДополнительныеПараметры);
	
	ДобавитьУсловноеОформление_НедоступныАвтоматическиДобавленныеСтроки(ФормаДокумента, "Раздел1Операции", ДополнительныеПараметры);
	ДобавитьУсловноеОформление_НедоступныАвтоматическиДобавленныеСтроки(ФормаДокумента, "Раздел1СальдоНачальноеБезСчетов", ДополнительныеПараметры);
	ДобавитьУсловноеОформление_НедоступныАвтоматическиДобавленныеСтроки(ФормаДокумента, "Раздел1СальдоКонечноеПоСчетам", ДополнительныеПараметры);
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_НадписиИВалютныеСуммыРаздела1(ФормаДокумента, ДополнительныеПараметры)
	
	ИменаТЧ = Новый Массив();
	ИменаТЧ.Добавить("Раздел1Операции");
	ИменаТЧ.Добавить("Раздел1СальдоНачальноеБезСчетов");
	ИменаТЧ.Добавить("Раздел1СальдоКонечноеБезСчетов");
	ИменаТЧ.Добавить("Раздел1ОборотыБезСчетов");
	ИменаТЧ.Добавить("Раздел1СальдоКонечноеПоСчетам");
	ИменаТЧ.Добавить("Раздел1ВсегоСальдоНачальноеБезСчетов");
	ИменаТЧ.Добавить("Раздел1ВсегоСальдоКонечноеБезСчетов");
	ИменаТЧ.Добавить("Раздел1ВсегоСальдоКонечноеПоСчетам");
	
	Для Каждого ИмяТЧ Из ИменаТЧ Цикл
		ДобавитьУсловноеОформление_НадписиСумм(ФормаДокумента, ИмяТЧ, ДополнительныеПараметры);
		
		ДобавитьУсловноеОформление_СкрытьВалютныеСуммыДляРублей(ФормаДокумента, ИмяТЧ, ДополнительныеПараметры);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_УстановленФильтрСтрокРаздела1(ФормаДокумента, ДополнительныеПараметры)
	
	// Возможен фильтр по договору.
	ИменаТЧ = Новый Массив();
	ИменаТЧ.Добавить("Раздел1СписокДоговоров");
	ИменаТЧ.Добавить("Раздел1Операции");
