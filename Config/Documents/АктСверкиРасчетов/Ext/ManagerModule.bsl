	ЗапросПоиск.УстановитьПараметр("ИспользоватьВалютныйУчет",			ПараметрыПоиска.ИспользоватьВалютныйУчет);
	ЗапросПоиск.УстановитьПараметр("ВалютаРУ",							ПараметрыПоиска.ВалютаРУ);
	
	ЗапросПоиск.УстановитьПараметр("СписокСчетовКонтрагентДоговорВидыРасчетов",	ПараметрыПоиска.СписокСчетовКонтрагентДоговорВидыРасчетов);
	ЗапросПоиск.УстановитьПараметр("ВидыСубконтоКонтрагентДоговорВидыРасчетов",	ПараметрыПоиска.ВидыСубконтоКонтрагентДоговорВидыРасчетов);
	ЗапросПоиск.УстановитьПараметр("СписокВидовРасчетовДляКолонкиОД",			ПараметрыПоиска.СписокВидовРасчетовДляКолонкиОД);
	ЗапросПоиск.УстановитьПараметр("СписокВидовРасчетовДляКолонкиПроцентов",	ПараметрыПоиска.СписокВидовРасчетовДляКолонкиПроцентов);
	ЗапросПоиск.УстановитьПараметр("СписокВидовРасчетовДляКолонкиШтрафов",		ПараметрыПоиска.СписокВидовРасчетовДляКолонкиШтрафов);
	ЗапросПоиск.УстановитьПараметр("СписокВидовРасчетовДляКолонкиПеней",		ПараметрыПоиска.СписокВидовРасчетовДляКолонкиПеней);
	
	ЗапросПоиск.УстановитьПараметр("ПустоеИФО",				ПараметрыПоиска.ПустоеИФО);
	ЗапросПоиск.УстановитьПараметр("ПустоеПодразделение",	ПараметрыПоиска.ПустоеПодразделение);
	ЗапросПоиск.УстановитьПараметр("ПустойДоговор",			ПараметрыПоиска.ПустойДоговор);
	ЗапросПоиск.УстановитьПараметр("ПустаяВалюта",			ПараметрыПоиска.ПустаяВалюта);
	ЗапросПоиск.УстановитьПараметр("КЭК000",				ПараметрыПоиска.КЭК000);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаОстатки();
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	// [1]. Начальные остатки по данным бух.учета без разреза по счетам.
	НачальныеОстаткиБезСчетов = РезультатЗапроса[1].Выгрузить();
	
	// [2]. Конечные остатки по данным бух.учета в разрезе счетов.
	КонечныеОстаткиПоСчетам = РезультатЗапроса[2].Выгрузить();
	
	ДатаКонечныхОстатков = ПараметрыПоиска.ДатаКонечныхОстатков.Значение;
	
	Если ДатаКонечныхОстатков >= Дата(2020,12,31) Тогда
		ИнвентаризацияСервер.ЗаполнитьКЭКОстатков(
			КонечныеОстаткиПоСчетам,
			ПараметрыПоиска.СчетаРасчетовКИСЕ,
			ПараметрыПоиска.КонтрагентКИЕ);
	КонецЕсли;
	
	УдалитьПолностьюНулевыеСтроки(КонечныеОстаткиПоСчетам);
	
	Остатки = Новый Структура();
	Остатки.Вставить("НачальныеОстаткиБезСчетов", НачальныеОстаткиБезСчетов);
	Остатки.Вставить("КонечныеОстаткиПоСчетам", КонечныеОстаткиПоСчетам);
	
	Возврат Остатки;
	
КонецФункции

Процедура УдалитьПолностьюНулевыеСтроки(Таблица)
	
	МассивИмен = СтрРазделить(ПолучитьКолонкиСуммовыхПоказателейБезВсего(), ", ", Ложь);
	
	Поиск = Новый Структура();
	
	Для Каждого ИмяПоля Из МассивИмен Цикл
		Поиск.Вставить(ИмяПоля, 0);
	КонецЦикла;
	
	МассивСтрок = Таблица.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Таблица.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьКонечныеОстаткиБезСчетов(Остатки, КолонкиСуммирования)
	
	КонечныеОстаткиБезСчетов = РассчитатьКонечныеОстаткиБезСчетов(Остатки.КонечныеОстаткиПоСчетам, КолонкиСуммирования);
	
	Остатки.Вставить("КонечныеОстаткиБезСчетов", КонечныеОстаткиБезСчетов);
	
КонецПроцедуры

Функция РассчитатьКонечныеОстаткиБезСчетов(КонечныеОстаткиПоСчетам, КолонкиСуммирования)
	
	КонечныеОстаткиБезСчетов = КонечныеОстаткиПоСчетам.Скопировать();
	
	КонечныеОстаткиБезСчетов.Свернуть("Договор,Валюта,ИФО,Подразделение", КолонкиСуммирования);
	
	Возврат КонечныеОстаткиБезСчетов;
	
КонецФункции

Функция РассчитатьОстаткиВсего(Остатки, КолонкиСуммирования)
	
	КолонкиГруппировок = "Валюта,ИФО,Подразделение";
	НачальныеОстаткиБезСчетов = Остатки.НачальныеОстаткиБезСчетов.Скопировать();
	НачальныеОстаткиБезСчетов.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	НачальныеОстаткиБезСчетов.Сортировать(КолонкиГруппировок);
	
	КолонкиГруппировок = "Валюта,ИФО,Подразделение";
	КонечныеОстаткиБезСчетов = Остатки.КонечныеОстаткиБезСчетов.Скопировать();
	КонечныеОстаткиБезСчетов.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	КонечныеОстаткиБезСчетов.Сортировать(КолонкиГруппировок);
	
	КолонкиГруппировок = "Валюта,ИФО,Подразделение,КФО,Счет,КПС,КЭК";
	КонечныеОстаткиПоСчетам = Остатки.КонечныеОстаткиПоСчетам.Скопировать();
	КонечныеОстаткиПоСчетам.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	КонечныеОстаткиПоСчетам.Сортировать(КолонкиГруппировок);
	
	ОстаткиВсего = Новый Структура();
	ОстаткиВсего.Вставить("НачальныеОстаткиБезСчетов", НачальныеОстаткиБезСчетов);
	ОстаткиВсего.Вставить("КонечныеОстаткиБезСчетов", КонечныеОстаткиБезСчетов);
	ОстаткиВсего.Вставить("КонечныеОстаткиПоСчетам", КонечныеОстаткиПоСчетам);
	
	Возврат ОстаткиВсего;
	
КонецФункции

Функция РассчитатьОбороты(Операции, КолонкиСуммирования, КолонкиГруппировок = "Договор,Валюта,ИФО,Подразделение")
	
	НужныеКолонки = КолонкиГруппировок + "," + КолонкиСуммирования;
	
	Обороты = Операции.Скопировать(, НужныеКолонки);
	
	Обороты.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	
	Возврат Обороты;
	
КонецФункции

Процедура ЗаполнитьКолонкиВсего(Таблица)
	
	ИменаКолонок = Новый Массив();
	ИменаКолонок.Добавить("СуммаВсегоВалДебет");
	ИменаКолонок.Добавить("СуммаВсегоРубДебет");
	ИменаКолонок.Добавить("СуммаВсегоВалКредит");
	ИменаКолонок.Добавить("СуммаВсегоРубКредит");
	
	ТипСумма = ОбщегоНазначения.ОписаниеТипаЧисло(18, 2, ДопустимыйЗнак.Любой);
	
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		Таблица.Колонки.Добавить(ИмяКолонки, ТипСумма);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаТаблицы.СуммаВсегоВалДебет =
			СтрокаТаблицы.СуммаОДВалДебет
			+ СтрокаТаблицы.СуммаПроцентовВалДебет
			+ СтрокаТаблицы.СуммаШтрафовВалДебет
			+ СтрокаТаблицы.СуммаПенейВалДебет;
			
		СтрокаТаблицы.СуммаВсегоРубДебет =
			СтрокаТаблицы.СуммаОДРубДебет
			+ СтрокаТаблицы.СуммаПроцентовРубДебет
			+ СтрокаТаблицы.СуммаШтрафовРубДебет
			+ СтрокаТаблицы.СуммаПенейРубДебет;
			
		СтрокаТаблицы.СуммаВсегоВалКредит =
			СтрокаТаблицы.СуммаОДВалКредит
			+ СтрокаТаблицы.СуммаПроцентовВалКредит
			+ СтрокаТаблицы.СуммаШтрафовВалКредит
			+ СтрокаТаблицы.СуммаПенейВалКредит;
			
		СтрокаТаблицы.СуммаВсегоРубКредит =
			СтрокаТаблицы.СуммаОДРубКредит
			+ СтрокаТаблицы.СуммаПроцентовРубКредит
			+ СтрокаТаблицы.СуммаШтрафовРубКредит
			+ СтрокаТаблицы.СуммаПенейРубКредит;
	КонецЦикла;
	
КонецПроцедуры

