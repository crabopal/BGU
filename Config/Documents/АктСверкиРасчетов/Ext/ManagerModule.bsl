Функция ПолучитьДанныеДляПечати0510477(МассивОбъектов)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивОбъектов);
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаПечать0510477();
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	Данные = Новый Структура();
	Данные.Вставить("Выборки", Новый Структура());
	
	Данные.Выборки.Вставить("Шапки",								РезультатыЗапроса[0].Выбрать());
	Данные.Выборки.Вставить("Раздел1СписокДоговоров",				РезультатыЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел1Операции",						РезультатыЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел1СальдоНачальноеБезСчетов",		РезультатыЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел1СальдоКонечноеБезСчетов",		РезультатыЗапроса[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел1ОборотыБезСчетов",				РезультатыЗапроса[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел1СальдоКонечноеПоСчетам",		РезультатыЗапроса[6].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел1ВсегоСальдоНачальноеБезСчетов",	РезультатыЗапроса[7].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел1ВсегоСальдоКонечноеБезСчетов",	РезультатыЗапроса[8].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел1ВсегоСальдоКонечноеПоСчетам",	РезультатыЗапроса[9].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	Данные.Выборки.Вставить("Раздел2СписокДоговоров",				РезультатыЗапроса[10].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел2Операции",						РезультатыЗапроса[11].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел2СальдоНачальное",				РезультатыЗапроса[12].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел2СальдоКонечное",				РезультатыЗапроса[13].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел2Обороты",						РезультатыЗапроса[14].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел2ВсегоСальдоНачальное",			РезультатыЗапроса[15].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел2ВсегоСальдоКонечное",			РезультатыЗапроса[16].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	Данные.Вставить("ДополнительныеПараметры", ПолучитьДополнительныеПараметрыПечати());
	
	Данные.Вставить("СведенияУчреждений", УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов));
	
	Возврат Данные;
	
КонецФункции

