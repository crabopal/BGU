&НаКлиенте
Процедура ПоказатьТекстовуюСтроку(ИмяТЧ, ИмяПоля, Подсказка, ТекДанные, СохранитьИзменения)
	
	ИдСтроки = ТекДанные.ПолучитьИдентификатор();
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяТЧ",				ИмяТЧ);
	ДополнительныеПараметры.Вставить("ИдСтроки",			ИдСтроки);
	ДополнительныеПараметры.Вставить("ИмяПоля",				ИмяПоля);
	ДополнительныеПараметры.Вставить("СохранитьИзменения",	СохранитьИзменения);
	
	ТекущееЗначение = ?(СохранитьИзменения,
		Элементы[ИмяТЧ + ИмяПоля].ТекстРедактирования, // Поле редактируется, ТекстРедактирования заполнен.
		ТекДанные[ИмяПоля]); // Поле не редактируется (только просмотр).
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаТекстовойСтроки", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВводСтроки(Оповещение, ТекущееЗначение, Подсказка,, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаТекстовойСтроки(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	Если Не ДополнительныеПараметры.СохранитьИзменения Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Объект[ДополнительныеПараметры.ИмяТЧ].НайтиПоИдентификатору(ДополнительныеПараметры.ИдСтроки);
	
	ТекДанные[ДополнительныеПараметры.ИмяПоля] = ВыбранноеЗначение;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСообщениеОНедоступностиТабличнойЧасти(ИмяТЧ)
	
	ШаблонСообщения = НСтр("ru='Эта табличная часть рассчитывается автоматически при заполнении по данным учета и при записи документа.
		|%1
		|
		|Ручное редактирование табличной части не предусмотрено.'");
	
	ШаблонОдноОснование = НСтр("ru='Расчет выполняется на основании табличной части ""%1"".'");
	ШаблонНесколькоОснований = НСтр("ru='Расчет выполняется на основании табличных частей %1.'");
	
	// Раздел 1.
	Если ИмяТЧ = "Раздел1СписокДоговоров" Тогда
		Шаблон = ШаблонНесколькоОснований;
		Текст = НСтр("ru='""Сальдо начальное (по договорам)"", ""Обороты"", ""Сальдо конечное (по договорам)""'");
		
	ИначеЕсли ИмяТЧ = "Раздел1ОборотыБезСчетов" Тогда
		Шаблон = ШаблонОдноОснование;
		Текст = НСтр("ru='Операции'");
		
	ИначеЕсли ИмяТЧ = "Раздел1СальдоКонечноеБезСчетов" Тогда
		Шаблон = ШаблонОдноОснование;
		Текст = НСтр("ru='Сальдо конечное по счетам'");
		
	ИначеЕсли ИмяТЧ = "Раздел1ВсегоСальдоНачальноеБезСчетов" Тогда
		Шаблон = ШаблонОдноОснование;
		Текст = НСтр("ru='Сальдо начальное (по договорам)'");
		
	ИначеЕсли ИмяТЧ = "Раздел1ВсегоСальдоКонечноеБезСчетов" Тогда
		Шаблон = ШаблонОдноОснование;
		Текст = НСтр("ru='Сальдо конечное (по договорам)'");
		
	ИначеЕсли ИмяТЧ = "Раздел1ВсегоСальдоКонечноеПоСчетам" Тогда
		Шаблон = ШаблонОдноОснование;
		Текст = НСтр("ru='Сальдо конечное по счетам (и по договорам)'");
		
	// Раздел 2.
	ИначеЕсли ИмяТЧ = "Раздел2СписокДоговоров" Тогда
		Шаблон = ШаблонНесколькоОснований;
		Текст = НСтр("ru='""Сальдо начальное (по договорам)"", ""Обороты"", ""Сальдо конечное (по договорам)""'");
		
	ИначеЕсли ИмяТЧ = "Раздел2Обороты" Тогда
		Шаблон = ШаблонОдноОснование;
		Текст = НСтр("ru='Операции'");
		
	ИначеЕсли ИмяТЧ = "Раздел2ВсегоСальдоНачальное" Тогда
		Шаблон = ШаблонОдноОснование;
		Текст = НСтр("ru='Сальдо начальное (по договорам)'");
		
	ИначеЕсли ИмяТЧ = "Раздел2ВсегоСальдоКонечное" Тогда
		Шаблон = ШаблонОдноОснование;
		Текст = НСтр("ru='Сальдо конечное (по договорам)'");
	Иначе
		Возврат;
	КонецЕсли;
	
	ВставляемыйТекст = СтрШаблон(Шаблон, Текст);
	
	ПоказатьПредупреждение(, СтрШаблон(ШаблонСообщения, ВставляемыйТекст));
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВалютныеСуммыДляВалютыRUB(ТекДанные)
	
	Если ТекДанные.Валюта <> ВалютаРУ Тогда
		Возврат;
	КонецЕсли;
	
	ОчищающаяСтруктура = Новый Структура("
		// Дебет
		|СуммаВсегоВалДебет,
		|СуммаОДВалДебет,
		|СуммаПроцентовВалДебет,
		|СуммаШтрафовВалДебет,
		|СуммаПенейВалДебет,
		// Кредит
		|СуммаВсегоВалКредит,
		|СуммаОДВалКредит,
		|СуммаПроцентовВалКредит,
		|СуммаШтрафовВалКредит,
		|СуммаПенейВалКредит");
		
	ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииСервер()
	
	РеквизитыКонтрагента = Документы.АктСверкиРасчетов.ПрочитатьРеквизитыКонтрагента(Объект.Контрагент, Объект.Дата);
	
	Объект.ИННКонтрагента	= РеквизитыКонтрагента.ИНН;
	Объект.КППКонтрагента	= РеквизитыКонтрагента.КПП;
	Объект.ОГРНКонтрагента	= РеквизитыКонтрагента.ОГРН;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьПоляВсегоВСтрокеТаблицы(СтрокаТаблицы, ПостфиксИмен)
	
	СтрокаТаблицы["СуммаВсего" + ПостфиксИмен] =
		СтрокаТаблицы["СуммаОД" + ПостфиксИмен]
		+ СтрокаТаблицы["СуммаПроцентов" + ПостфиксИмен]
		+ СтрокаТаблицы["СуммаШтрафов" + ПостфиксИмен]	
		+ СтрокаТаблицы["СуммаПеней" + ПостфиксИмен];
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьПоляВсегоСальдоКонечноеПоСчетамВСтрокеТаблицы(СтрокаТаблицы, ПостфиксИмен)
	
	РассчитатьПоляВсегоВСтрокеТаблицы(СтрокаТаблицы, ПостфиксИмен);
	
	ОчиститьПротивоположнуюСторонуОстатков(СтрокаТаблицы, ПостфиксИмен);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПротивоположнуюСторонуОстатков(СтрокаТаблицы, ПостфиксИмен)
	
	Вал = Лев(ПостфиксИмен, 3);
	Сторона = СтрЗаменить(ПостфиксИмен, Вал, "");
	
	СторонаКор = ?(Сторона = "Дебет", "Кредит", "Дебет");
	
	ПостфиксыВал = Новый Массив();
	ПостфиксыВал.Добавить("Вал");
	ПостфиксыВал.Добавить("Руб");
	
	Для Каждого ПостфиксВал Из ПостфиксыВал Цикл
		ПостфиксИменКор = ПостфиксВал + СторонаКор;
		
		СтрокаТаблицы["СуммаВсего" + ПостфиксИменКор]		= 0;
		СтрокаТаблицы["СуммаОД" + ПостфиксИменКор]			= 0;
		СтрокаТаблицы["СуммаПроцентов" + ПостфиксИменКор]	= 0;
		СтрокаТаблицы["СуммаШтрафов" + ПостфиксИменКор]		= 0;
		СтрокаТаблицы["СуммаПеней" + ПостфиксИменКор]		= 0;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ФильтрСтрок

&НаКлиенте
Процедура ОткрытьФормуФильтраСтрокРаздела1()
	
	ПараметрыФормы = Новый Структура("
		|ИспользоватьВалютныйУчет,
		|ФильтрПоВалютеКандидат,
		|ФильтрПоВалютеУстановленный,
		|ФильтрПоДоговоруКандидат,
		|ФильтрПоДоговоруУстановленный");
	
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ЭтотОбъект);
	
	ОткрытьФорму("Документ.АктСверкиРасчетов.Форма.ФормаФильтра", ПараметрыФормы, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКандидатыФильтровПоДоговоруИПоВалюте(Элемент)
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.Договор) Тогда
		ФильтрПоДоговоруКандидат = ТекДанные.Договор;
	КонецЕсли;
	
	Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(ТекДанные.Валюта) Тогда
		ФильтрПоВалютеКандидат = ТекДанные.Валюта;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКандидатФильтраПоДоговору(Элемент)
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.Договор) Тогда
		ФильтрПоДоговоруКандидат = ТекДанные.Договор;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКандидатФильтраПоВалюте(Элемент)
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(ТекДанные.Валюта) Тогда
		ФильтрПоВалютеКандидат = ТекДанные.Валюта;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокФильтраСтрокРаздела1()
	
	Элемент = Элементы.КнопкаОткрытьФормуФильтров;
	
	Если ЗначениеЗаполнено(ФильтрПоДоговоруУстановленный)
		Или ИспользоватьВалютныйУчет И ЗначениеЗаполнено(ФильтрПоВалютеУстановленный) Тогда
		
		ЗаголовокФильтраСтрок = НСтр("ru='установлен'");
		
		Элемент.ЦветТекста = ЦветТекстаФильтрУстановлен;
	Иначе
		ЗаголовокФильтраСтрок = "";
		
		Элемент.ЦветТекста = ЦветТекстаФильтрНеУстановлен;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьФильтры()
	
	ПрименитьФильтрПоДоговоруИВалюте();
	
	ПрименитьФильтрТолькоПоДоговору();
	
	ПрименитьФильтрТолькоПоВалюте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьФильтрПоДоговоруИВалюте()
	
	// Возможен фильтр по договору и валюте.
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("Раздел1Операции");
	ИменаЭлементов.Добавить("Раздел1ОборотыБезСчетов");
	ИменаЭлементов.Добавить("Раздел1СальдоНачальноеБезСчетов");
	ИменаЭлементов.Добавить("Раздел1СальдоКонечноеБезСчетов");
	ИменаЭлементов.Добавить("Раздел1СальдоКонечноеПоСчетам");
	
	ИменаЭлементов.Добавить("Раздел2Операции");
	ИменаЭлементов.Добавить("Раздел2СальдоНачальное");
	ИменаЭлементов.Добавить("Раздел2СальдоКонечное");
	ИменаЭлементов.Добавить("Раздел2Обороты");
	
	НовыйОтборСтрок = Новый Структура();
	
	Если ЗначениеЗаполнено(ФильтрПоДоговоруУстановленный) Тогда
		НовыйОтборСтрок.Вставить("Договор", ФильтрПоДоговоруУстановленный);
	КонецЕсли;
	
	Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(ФильтрПоВалютеУстановленный) Тогда
		НовыйОтборСтрок.Вставить("Валюта", ФильтрПоВалютеУстановленный);
	КонецЕсли;
	
	Если НовыйОтборСтрок.Количество() > 0 Тогда
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура(НовыйОтборСтрок);
	Иначе
		НовыйОтборСтрок = Неопределено;
	КонецЕсли;
	
	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		Элементы[ИмяЭлемента].ОтборСтрок = НовыйОтборСтрок;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьФильтрТолькоПоДоговору()
	
	// Возможен фильтр по договору и валюте.
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("Раздел1СписокДоговоров");
	ИменаЭлементов.Добавить("Раздел2СписокДоговоров");
	
	НовыйОтборСтрок = Новый Структура();
	
	Если ЗначениеЗаполнено(ФильтрПоДоговоруУстановленный) Тогда
		НовыйОтборСтрок.Вставить("Договор", ФильтрПоДоговоруУстановленный);
	КонецЕсли;
	
	Если НовыйОтборСтрок.Количество() > 0 Тогда
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура(НовыйОтборСтрок);
	Иначе
		НовыйОтборСтрок = Неопределено;
	КонецЕсли;
	
	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		Элементы[ИмяЭлемента].ОтборСтрок = НовыйОтборСтрок;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьФильтрТолькоПоВалюте()
	
	// Возможен фильтр только по валюте.
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("Раздел1ВсегоСальдоНачальноеБезСчетов");
	ИменаЭлементов.Добавить("Раздел1ВсегоСальдоКонечноеБезСчетов");
	ИменаЭлементов.Добавить("Раздел1ВсегоСальдоКонечноеПоСчетам");
	
	ИменаЭлементов.Добавить("Раздел2ВсегоСальдоНачальное");
	ИменаЭлементов.Добавить("Раздел2ВсегоСальдоКонечное");
	
	НовыйОтборСтрок = Новый Структура();
	
	Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(ФильтрПоВалютеУстановленный) Тогда
		НовыйОтборСтрок.Вставить("Валюта", ФильтрПоВалютеУстановленный);
	КонецЕсли;
	
	Если НовыйОтборСтрок.Количество() > 0 Тогда
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура(НовыйОтборСтрок);
	Иначе
		НовыйОтборСтрок = Неопределено;
	КонецЕсли;
	
	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		Элементы[ИмяЭлемента].ОтборСтрок = НовыйОтборСтрок;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьФильтрСтрок()
	
	ФильтрПоВалютеУстановленный = Неопределено;
	ФильтрПоДоговоруУстановленный = Неопределено;
	
	ПрименитьФильтры();
	
	УстановитьЗаголовокФильтраСтрокРаздела1();
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеСпискаСчетов

&НаКлиенте
Процедура ПодтвердитьИЗаполнитьСписокСчетов()
	
	Если Объект.СписокСчетов.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru='Продолжить и заполнить список счетов значениями по умолчанию?'");
		
		Оповещение = Новый ОписаниеОповещения("ПодтвердитьИЗаполнитьСписокСчетовЗавершение", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСписокСчетовКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИЗаполнитьСписокСчетовЗавершение(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьСписокСчетовКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокСчетовКлиент()
	
	ЗаполнитьСписокСчетовСервер();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокСчетовСервер()
	
	Документы.АктСверкиРасчетов.ЗаполнитьСписокСчетовПоУмолчанию(Объект);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРаздела1

&НаКлиенте
Функция ЗаполненРаздел1()
	
	Возврат Объект.Раздел1Операции.Количество() > 0
		Или Объект.Раздел1СальдоНачальноеБезСчетов.Количество() > 0
		Или Объект.Раздел1СальдоКонечноеПоСчетам.Количество() > 0;
	
КонецФункции

&НаКлиенте
Процедура ПодтвердитьИЗаполнитьРаздел1()
	
	Если ЗаполненРаздел1() Тогда
		ТекстВопроса = НСтр("ru='Перед заполнением раздела 1 по данным бух. учета табличные части раздела 1 документа будут очищены.
			|
			|Продолжить и заполнить раздел 1 по данным бух. учета?'");
		
		Оповещение = Новый ОписаниеОповещения("ПодтвердитьИЗаполнитьРаздел1Завершение", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
	КонецЕсли;
	
	ПроверитьИЗаполнитьРаздел1();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИЗаполнитьРаздел1Завершение(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьИЗаполнитьРаздел1();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1()
	
	Отказ = Ложь;
	
	ПроверитьПередЗаполнениемРаздела1Сервер(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел1Клиент();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПередЗаполнениемРаздела1Сервер(Отказ)
	
	Документы.АктСверкиРасчетов.ПроверитьПередЗаполнениемРаздела1(Объект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел1Клиент()
	
	РезультатЗадания = ЗаполнитьРаздел1Сервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗаполнитьРаздел1ЗавершениеКлиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРаздел1Сервер()
	
	ПараметрыФункции = Новый Структура("Дата,ДатаНачала,ДатаОкончания,Организация,Контрагент,Подразделение,ИФО");
	
	ЗаполнитьЗначенияСвойств(ПараметрыФункции, Объект);
	
	ТаблицаСписокДоговоров = Объект.СписокДоговоров.Выгрузить();
	
	ПараметрыФункции.Вставить("СписокДоговоров", ТаблицаСписокДоговоров.ВыгрузитьКолонку("Договор"));
	ПараметрыФункции.Вставить("СписокСчетов", Объект.СписокСчетов.Выгрузить());
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение раздела 1 акта сверки расчетов (ф. 0510477)'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Документы.АктСверкиРасчетов.ПолучитьДанныеДляРаздела1",
		ПараметрыФункции)
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьРаздел1ЗавершениеКлиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус <> "Выполнено" Тогда
		ПоказатьПредупреждение(, НСтр("ru='При заполнении акта сверки возникла ошибка'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел1ЗавершениеСервер(Результат.АдресРезультата);
	
	УстановитьВсеЗаголовки();
	
	ОчиститьФильтрСтрок();
	
	Если Не ЗаполненРаздел1() Тогда
		ТекстСообщения = НСтр("ru='Данные учета, соответствующие условиям поиска, отсутствуют'");
		ПоказатьПредупреждение(, ТекстСообщения, 10);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаздел1ЗавершениеСервер(АдресРезультата)
	
	Данные = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Объект.Раздел1Операции.Загрузить(Данные.Операции);
	Объект.Раздел1ОборотыБезСчетов.Загрузить(Данные.Обороты);
	
	Объект.Раздел1СальдоНачальноеБезСчетов.Загрузить(Данные.Остатки.НачальныеОстаткиБезСчетов);
	Объект.Раздел1СальдоКонечноеБезСчетов.Загрузить(Данные.Остатки.КонечныеОстаткиБезСчетов);
	Объект.Раздел1СальдоКонечноеПоСчетам.Загрузить(Данные.Остатки.КонечныеОстаткиПоСчетам);
	
	Объект.Раздел1ВсегоСальдоНачальноеБезСчетов.Загрузить(Данные.ОстаткиВсего.НачальныеОстаткиБезСчетов);
	Объект.Раздел1ВсегоСальдоКонечноеБезСчетов.Загрузить(Данные.ОстаткиВсего.КонечныеОстаткиБезСчетов);
	Объект.Раздел1ВсегоСальдоКонечноеПоСчетам.Загрузить(Данные.ОстаткиВсего.КонечныеОстаткиПоСчетам);
	
	Объект.Раздел1СписокДоговоров.Загрузить(Данные.ТаблицаСписокДоговоров);
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРаздела2

&НаКлиенте
Функция ЗаполненРаздел2()
	
	Возврат Объект.Раздел2Операции.Количество() > 0
		Или Объект.Раздел2СальдоНачальное.Количество() > 0
		Или Объект.Раздел2СальдоКонечное.Количество() > 0
	
КонецФункции

&НаКлиенте
Процедура ПодтвердитьИЗаполнитьРаздел2ПоДаннымРаздела1()
	
	Если ЗаполненРаздел2() Тогда
		ТекстВопроса = НСтр("ru='Перед заполнением раздела 2 по данным раздела 1 табличные части раздела 2 документа будут очищены.
			|
			|Продолжить и заполнить раздел 2?'");
		
		Оповещение = Новый ОписаниеОповещения("ПодтвердитьИЗаполнитьРаздел2ПоДаннымРаздела1Завершение", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел2ПоДаннымРаздела1Клиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИЗаполнитьРаздел2ПоДаннымРаздела1Завершение(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьРаздел2ПоДаннымРаздела1Клиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел2ПоДаннымРаздела1Клиент()
	
	ЗаполнитьРаздел2ПоДаннымРаздела1Сервер();
	
	УстановитьВсеЗаголовкиРаздела2();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРаздел2ПоДаннымРаздела1Сервер()
	
	Документы.АктСверкиРасчетов.ЗаполнитьРаздел2ПоДаннымРаздела1(Объект);
	
КонецФункции

