#Область ОбработчикиСобытий

&НаКлиенте
Процедура ПоказатьЗначениеВыбранногоПоля(Элемент, Поле, СтандартнаяОбработка)
	
	ИмяТЧ = Элемент.Имя;
	
	ИмяПоля = СтрЗаменить(Поле.Имя, ИмяТЧ, "");
	
	НомерРаздела = Число(Лев(СтрЗаменить(ИмяТЧ, "Раздел", ""), 1));
	
	Если ИменаПолейПоказываемыхВДиалоге.НайтиПоЗначению(ИмяПоля) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекДанные, "ДобавленоВручную") Тогда
		Если ТекДанные.ДобавленоВручную Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ЗначениеПоля = ТекДанные[ИмяПоля];
	
	Если Не ЗначениеЗаполнено(ЗначениеПоля) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если ИмяПоля = "СодержаниеОперации" Тогда
		ПоказатьСодержаниеОперации(НомерРаздела, Ложь);
		Возврат;
	
	ИначеЕсли ИмяПоля = "НаименованиеДокумента" Тогда
		ПоказатьНаименованиеДокумента(НомерРаздела, Ложь);
		Возврат;
		
	ИначеЕсли ИмяПоля = "КраткоеСодержание" Тогда
		ПоказатьКраткоеСодержание(НомерРаздела, Ложь);
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, ЗначениеПоля);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСодержаниеОперации(НомерРаздела, СохранитьИзменения)
	
	Если НомерРаздела = 1 Тогда
		ИмяТЧ = "Раздел1Операции";
		
	ИначеЕсли НомерРаздела = 2 Тогда
		ИмяТЧ = "Раздел2Операции";
	КонецЕсли;
	
	ТекДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	ПоказатьТекстовуюСтроку(ИмяТЧ, "СодержаниеОперации", НСтр("ru='Содержание операции'"),
		ТекДанные, СохранитьИзменения);
	
КонецПроцедуры

