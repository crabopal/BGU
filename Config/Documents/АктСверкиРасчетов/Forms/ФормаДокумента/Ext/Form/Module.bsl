Процедура Раздел1СписокДоговоровПриАктивизацииСтроки(Элемент)
	
	// ФильтрСтрок
	УстановитьКандидатФильтраПоДоговору(Элемент);
	// Конец ФильтрСтрок
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел1СписокДоговоровПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел1СписокДоговоровПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел1СписокДоговоровКраткоеСодержаниеОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПоказатьКраткоеСодержание(1, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Раздел1Операции

&НаКлиенте
Процедура Раздел1ОперацииПриИзменении(Элемент)
	
	УстановитьЗаголовокРаздела1();
	
	// ФильтрСтрок
	УстановитьКандидатыФильтровПоДоговоруИПоВалюте(Элемент);
	// Конец ФильтрСтрок
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел1ОперацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ПоказатьЗначениеВыбранногоПоля(Элемент, Поле, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел1ОперацииПриАктивизацииСтроки(Элемент)
	
	// ФильтрСтрок
	УстановитьКандидатыФильтровПоДоговоруИПоВалюте(Элемент);
	// Конец ФильтрСтрок
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел1ОперацииПередУдалением(Элемент, Отказ)
	
	ПодтвердитьИУдалитьВыделенныеСтроки(Элемент, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел1ОперацииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекДанные = Элемент.ТекущиеДанные;
		
		ТекДанные.ДобавленоВручную = Истина;
		
		Если Не Копирование Тогда
			ТекДанные.Валюта = ВалютаРУ;
			
			Если ЗначениеЗаполнено(ФильтрПоДоговоруУстановленный) Тогда
				ТекДанные.Договор = ФильтрПоДоговоруУстановленный;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ФильтрПоВалютеУстановленный) Тогда
				ТекДанные.Договор = ФильтрПоВалютеУстановленный;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура Раздел1ОперацииСодержаниеОперацииОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПоказатьСодержаниеОперации(1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел1ОперацииНаименованиеДокументаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПоказатьНаименованиеДокумента(2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел1ОперацииВалютаПриИзменении(Элемент)
	
	ОчиститьВалютныеСуммыДляВалютыRUB(Элементы.Раздел1Операции.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел1ОперацииСуммаОДВалДебетПриИзменении(Элемент)
	
