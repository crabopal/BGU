	ТекстСообщения = СтрШаблон(
		НСтр("ru='В соответствии с пунктом 64.178 Приложения № 5 к приказу Минфина России от 15.04.2021 № 61н исключаются счета:
			|%1'"),
		СписокСчетовИсключенийСтрокой);
	
	ПоказатьПредупреждение(, ТекстСообщения);
	
