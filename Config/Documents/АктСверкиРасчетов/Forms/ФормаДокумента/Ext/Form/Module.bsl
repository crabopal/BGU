#Область УдалениеАвтоматическиДобавленныхСтрок

&НаКлиенте
Функция МаксимальноеКоличествоСтрокОбрабатываемыхНаКлиенте()
	
	Возврат 100;
	
КонецФункции

&НаКлиенте
Процедура ПодтвердитьИУдалитьВыделенныеСтроки(Элемент, Отказ)
	
	Если ВыделенаАвтоматическиДобавленнаяСтрока(Элемент) Тогда
		Отказ = Истина;
		
		ИмяТЧ = Элемент.Имя;
		
		ВыделеныВсеСтроки = (Элемент.ВыделенныеСтроки.Количество() = Объект[ИмяТЧ].Количество());
		
		Если ВыделеныВсеСтроки Тогда
			ВыделенныеСтроки = Неопределено;
		Иначе
			ВыделенныеСтроки = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(Элемент.ВыделенныеСтроки);
		КонецЕсли;
		
		ТекстВопроса = НСтр("ru='Среди выделенных строк есть автоматически добавленная строка.
			|Удаление автоматически добавленных строк не рекомендуется.
			|
			|Продолжить и удалить выделенные строки?'");
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ИмяТЧ", ИмяТЧ);
		ДополнительныеПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
		
		Оповещение = Новый ОписаниеОповещения("ПодтвердитьИУдалитьВыделенныеСтрокиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИУдалитьВыделенныеСтрокиЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		УдалитьВыделенныеСтроки(
			ДополнительныеПараметры.ИмяТЧ,
			ДополнительныеПараметры.ВыделенныеСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ВыделенаАвтоматическиДобавленнаяСтрока(Элемент)
	
	ИмяТЧ = Элемент.Имя;
	
	ВыделенныеСтроки = Элемент.ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() < МаксимальноеКоличествоСтрокОбрабатываемыхНаКлиенте() Тогда
		Возврат ВыделенаАвтоматическиДобавленнаяСтрокаКлиент(ИмяТЧ, ВыделенныеСтроки);
	Иначе
		Возврат ВыделенаАвтоматическиДобавленнаяСтрокаСервер(ИмяТЧ, ВыделенныеСтроки);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ВыделенаАвтоматическиДобавленнаяСтрокаКлиент(ИмяТЧ, ВыделенныеСтроки)
	
	ТЧ = Объект[ИмяТЧ];
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = ТЧ.НайтиПоИдентификатору(ИдСтроки);
		
		Если Не СтрокаТаблицы.ДобавленоВручную Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ВыделенаАвтоматическиДобавленнаяСтрокаСервер(ИмяТЧ, ВыделенныеСтроки)
	
	ТЧ = Объект[ИмяТЧ];
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = ТЧ.НайтиПоИдентификатору(ИдСтроки);
		
		Если Не СтрокаТаблицы.ДобавленоВручную Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура УдалитьВыделенныеСтроки(ИмяТЧ, ВыделенныеСтроки)
	
	Если ВыделенныеСтроки = Неопределено Тогда
		// Выделенные все строки.
		Объект[ИмяТЧ].Очистить();
		
		Возврат;
	КонецЕсли;
	
	Если ВыделенныеСтроки.Количество() <= МаксимальноеКоличествоСтрокОбрабатываемыхНаКлиенте() Тогда
		УдалитьВыделенныеСтрокиКлиент(ИмяТЧ, ВыделенныеСтроки);
	Иначе
		УдалитьВыделенныеСтрокиСервер(ИмяТЧ, ВыделенныеСтроки);
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВыделенныеСтрокиКлиент(ИмяТЧ, ВыделенныеСтроки)
	
	ТЧ = Объект[ИмяТЧ];
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = ТЧ.НайтиПоИдентификатору(ИдСтроки);
		
		ТЧ.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьВыделенныеСтрокиСервер(ИмяТЧ, ВыделенныеСтроки)
	
	ТЧ = Объект[ИмяТЧ];
	
