#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьПереданныеСведения();
	
	НастроитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОписаниеФильтра = НовыйОписаниеФильтра("ПоДоговору");
	УстановитьНадписьОчиститьФильтр(ОписаниеФильтра);
	УстановитьНадписьСостояниеФильтра(ОписаниеФильтра);
	
	Если ИспользоватьВалютныйУчет Тогда
		ОписаниеФильтра = НовыйОписаниеФильтра("ПоВалюте");
		УстановитьНадписьОчиститьФильтр(ОписаниеФильтра);
		УстановитьНадписьСостояниеФильтра(ОписаниеФильтра);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НадписьОчиститьФильтрПоДоговоруНажатие(Элемент, СтандартнаяОбработка)
	
	ПриНажатииНадписиОчиститьФильтр("ПоДоговору", СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьСостояниеФильтраПоДоговоруНажатие(Элемент, СтандартнаяОбработка)
	
	ПриНажатииНадписиСостоянияФильтра("ПоДоговору", СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьОчиститьФильтрПоВалютеНажатие(Элемент, СтандартнаяОбработка)
	
	ПриНажатииНадписиОчиститьФильтр("ПоВалюте", СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьСостояниеФильтраПоВалютеНажатие(Элемент, СтандартнаяОбработка)
	
	ПриНажатииНадписиСостоянияФильтра("ПоВалюте", СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьПереданныеСведения()
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры,	"ФильтрПоДоговоруУстановленный,ФильтрПоДоговоруКандидат,ИспользоватьВалютныйУчет");
	
	Если ИспользоватьВалютныйУчет Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры,	"ФильтрПоВалютеУстановленный,ФильтрПоВалютеКандидат");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	ЦветТекстаФильтрУстановлен = ЦветаСтиля.ГиперссылкаЦвет;
	ЦветТекстаФильтрНеУстановлен = ЦветаСтиля.ТекстИнформационнойНадписи;
	
	Если Не ИспользоватьВалютныйУчет Тогда
		ИменаЭлементов = Новый Массив();
		ИменаЭлементов.Добавить("НадписьСостояниеФильтраПоВалюте");
		ИменаЭлементов.Добавить("НадписьОчиститьФильтрПоВалюте");
		
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
			"Видимость", Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция НовыйОписаниеФильтра(ОбозначениеФильтра)
	
	ОписаниеФильтра = Новый Структура();
	ОписаниеФильтра.Вставить("Обозначение",						ОбозначениеФильтра);
	ОписаниеФильтра.Вставить("ИмяРеквизитаФильтрУстановленный",	СтрШаблон("Фильтр%1Установленный", ОбозначениеФильтра));
	ОписаниеФильтра.Вставить("ИмяРеквизитаФильтрКандидат",		СтрШаблон("Фильтр%1Кандидат", ОбозначениеФильтра));
	ОписаниеФильтра.Вставить("ИмяНадписиОчиститьФильтр",		СтрШаблон("НадписьОчиститьФильтр%1", ОбозначениеФильтра));
	ОписаниеФильтра.Вставить("ИмяНадписиСостояниеФильтра",		СтрШаблон("НадписьСостояниеФильтра%1", ОбозначениеФильтра));
	
	Возврат ОписаниеФильтра;
	
КонецФункции

&НаКлиенте
Процедура ПриНажатииНадписиСостоянияФильтра(ОбозначениеФильтра, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеФильтра = НовыйОписаниеФильтра(ОбозначениеФильтра);
	
	ФильтрУстановленный	= ЭтотОбъект[ОписаниеФильтра.ИмяРеквизитаФильтрУстановленный];
	ФильтрКандидат		= ЭтотОбъект[ОписаниеФильтра.ИмяРеквизитаФильтрКандидат];
	
	Если ЗначениеЗаполнено(ФильтрУстановленный) Тогда
		ПоказатьЗначение(, ФильтрУстановленный);
		
	ИначеЕсли ЗначениеЗаполнено(ФильтрКандидат) Тогда
		ЭтотОбъект[ОписаниеФильтра.ИмяРеквизитаФильтрУстановленный] = ФильтрКандидат;
		
		ОбработатьИзменениеУстановленногоФильтра(ОписаниеФильтра);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНадписиОчиститьФильтр(ОбозначениеФильтра, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеФильтра = НовыйОписаниеФильтра(ОбозначениеФильтра);
	
	ФильтрУстановленный = ЭтотОбъект[ОписаниеФильтра.ИмяРеквизитаФильтрУстановленный];
	
	Если Не ЗначениеЗаполнено(ФильтрУстановленный) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект[ОписаниеФильтра.ИмяРеквизитаФильтрУстановленный] = Неопределено;
	
	ОбработатьИзменениеУстановленногоФильтра(ОписаниеФильтра);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеУстановленногоФильтра(ОписаниеФильтра)
	
	УстановитьНадписьОчиститьФильтр(ОписаниеФильтра);
	УстановитьНадписьСостояниеФильтра(ОписаниеФильтра);
	
	ПрименитьФильтры();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНадписьОчиститьФильтр(ОписаниеФильтра)
	
	ФильтрУстановленный = ЭтотОбъект[ОписаниеФильтра.ИмяРеквизитаФильтрУстановленный];
	
	Если ЗначениеЗаполнено(ФильтрУстановленный) Тогда
		НадписьОчиститьФильтр = НСтр("ru='[х]'");
	Иначе
		НадписьОчиститьФильтр = "";
	КонецЕсли;
	
	ЭтотОбъект[ОписаниеФильтра.ИмяНадписиОчиститьФильтр] = НадписьОчиститьФильтр;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНадписьСостояниеФильтра(ОписаниеФильтра)
	
	ФильтрУстановленный	= ЭтотОбъект[ОписаниеФильтра.ИмяРеквизитаФильтрУстановленный];
	ФильтрКандидат		= ЭтотОбъект[ОписаниеФильтра.ИмяРеквизитаФильтрКандидат];
	
	Если ЗначениеЗаполнено(ФильтрУстановленный) Тогда
		НадписьСостояниеФильтра = Новый ФорматированнаяСтрока(
			Новый ФорматированнаяСтрока(Строка(ФильтрУстановленный), , ЦветТекстаФильтрУстановлен));
	Иначе
		Если ЗначениеЗаполнено(ФильтрКандидат) Тогда
			ТекстУстановить = СтрШаблон(
				НСтр("ru='Установить ""%1""'"),
				Строка(ФильтрКандидат));
			
			НадписьСостояниеФильтра = Новый ФорматированнаяСтрока(
				Новый ФорматированнаяСтрока(НСтр("ru='не установлен. '"), , ЦветТекстаФильтрНеУстановлен),
				Новый ФорматированнаяСтрока(ТекстУстановить, , ЦветТекстаФильтрУстановлен));
		Иначе
			НадписьСостояниеФильтра = Новый ФорматированнаяСтрока(
				Новый ФорматированнаяСтрока(НСтр("ru='не установлен'"), , ЦветТекстаФильтрНеУстановлен));
		КонецЕсли;
	КонецЕсли;
	
	ЭтотОбъект[ОписаниеФильтра.ИмяНадписиСостояниеФильтра] = НадписьСостояниеФильтра;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьФильтры()
	
	Параметр = Новый Структура();
	Параметр.Вставить("ФильтрПоДоговоруУстановленный",	ФильтрПоДоговоруУстановленный);
	Параметр.Вставить("ФильтрПоВалютеУстановленный",	ФильтрПоВалютеУстановленный);
	
	Оповестить("ИзмененФильтр", Параметр, ЭтотОбъект); 
	
КонецПроцедуры

#КонецОбласти
