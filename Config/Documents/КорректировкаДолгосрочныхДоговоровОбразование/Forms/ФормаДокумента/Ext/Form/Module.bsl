&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("НастройкиСчетовУчетаДБП",
		УчетДоходовРасходов.НастройкиСчетовУчетаДБП());
	
	// Отбор строк на странице "Общий порядок оплаты".
	Элементы.ПорядокОплаты.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки",
		Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	ИтогСуммаОплатыПоОбщемуГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект,
		Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	
	// Увеличение (уменьшение) стоимости образовательных услуг.
	ИзменитьСуммыНаПроцент = ЗначениеЗаполнено(Объект.ПроцентИндексации);
	РаспределитьСуммуПоПериодам = ЗначениеЗаполнено(Объект.СуммаРаспределенная);
	ВидОтбораПоПериодуОбучения = ЗначениеЗаполнено(Объект.НачалоПериодаОбучения) ИЛИ ЗначениеЗаполнено(Объект.КонецПериодаОбучения);
	
	Элементы.ПорядокУчетаДоходовСпособПризнанияДоходов.ПараметрыВыбора =
		Перечисления.СпособыПризнанияРасходов.ПараметрыВыбораСпособаПризнанияДоходов(Перечисления.ВидыОперацийНачисленияДБП.ДолгосрочныйДоговорОбразование);
	
	ДоходыБудущихПериодовЗаполнитьДобавленныеКолонки();
	ПорядокОплатыЗаполнитьДобавленныеКолонки();
	ПорядокУчетаДоходовЗаполнитьДобавленныеКолонки();
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьВидимостьЭлементовОсобыйПорядокОплаты(ЭтотОбъект);
	
	БухгалтерскийУчетКлиентСервер.УстановитьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект, "Видимость");
	
	УстановитьДоступностьПодразделения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭлементыПорядокУчетаДоходов = Новый Массив;
	ЭлементыПорядокУчетаДоходов.Добавить("ПорядокУчетаДоходов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыПорядокУчетаДоходов, "Доступность", Объект.ИзменитьПорядокУчетаДоходов);
	
	// Увеличение (уменьшение) стоимости образовательных услуг.
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПроцентИндексации", "Доступность", Форма.ИзменитьСуммыНаПроцент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СуммаРаспределенная", "Доступность", Форма.РаспределитьСуммуПоПериодам);
	
	ЭлементыОтборПоПериодуОбучения = Новый Массив;
	ЭлементыОтборПоПериодуОбучения.Добавить("НачалоПериодаОбучения");
	ЭлементыОтборПоПериодуОбучения.Добавить("КонецПериодаОбучения");
	ЭлементыОтборПоПериодуОбучения.Добавить("УстановитьОтборПоПериодуОбучения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыОтборПоПериодуОбучения, "Доступность", Форма.ВидОтбораПоПериодуОбучения <> 0);
	
	// Графики оплаты.
	КомандыЗагрузитьПорядокОплаты = Новый Массив;
	КомандыЗагрузитьПорядокОплаты.Добавить("ПорядокОплатыЗагрузитьИзШаблона");
	КомандыЗагрузитьПорядокОплаты.Добавить("ОсобыйПорядокОплатыЗагрузитьИзШаблона");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		КомандыЗагрузитьПорядокОплаты, "Доступность", НЕ Форма.ИзменитьСуммыНаПроцент И НЕ Форма.РаспределитьСуммуПоПериодам);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовОсобыйПорядокОплаты(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭлементыОсобыйПорядокОплаты = Новый Массив;
	ЭлементыОсобыйПорядокОплаты.Добавить("ОсобыйПорядокОплаты");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыОсобыйПорядокОплаты, "Доступность", Форма.НачислениеОсобыйПорядокОплаты);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Счета учета доступны для редактирования только в строках, введенных вручную.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКПС");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКФО");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСчетДБП");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКЭК");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовПодразделение");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ОстатокДБП", ВидСравненияКомпоновкиДанных.НеРавно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
	// Доходы будущих периодов в валюте.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовОстатокДБПВВалюте");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовВалюта");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовВалютаРеглУчета");
	ГруппаИЛИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЭлементУО.Отбор,, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ,
		"Объект.ДоходыБудущихПериодов.СчетДБПВалютный", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ,
		"Объект.ДоходыБудущихПериодов.Валюта", ВидСравненияКомпоновкиДанных.Равно, ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ,
		"Объект.ДоходыБудущихПериодов.Валюта", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Реквизиты порядка оплаты доступны для редактирования только в строках, введенных вручную.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПорядокОплатыОплатитьДо");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПорядокОплатыВалюта");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПорядокОплатыНачалоПериода");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПорядокОплатыКонецПериода");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсобыйПорядокОплатыОплатитьДо");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсобыйПорядокОплатыВалюта");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсобыйПорядокОплатыНачалоПериода");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсобыйПорядокОплатыКонецПериода");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПорядокОплаты.СуммаВВалютеДоИзменений", ВидСравненияКомпоновкиДанных.НеРавно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
	// Параметры списания ДБП.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПорядокУчетаДоходовДатаНачалаСписания");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПорядокУчетаДоходовДатаОкончанияСписания");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПорядокУчетаДоходов.СпособПризнанияДоходов",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.СпособыПризнанияРасходов.ПоГрафику);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Статья прочих доходов (НУ).
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПорядокУчетаДоходовСтатьяПрочихДоходовНУ");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПорядокУчетаДоходов.СчетДоходовНУ",
			ВидСравненияКомпоновкиДанных.НеРавно, БухгалтерскийУчет.СчетПоКоду("Н91.01", Объект.Дата));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	БухгалтерскийУчет.УстановитьУсловноеОформлениеПолейАналитикиСчета(
		УсловноеОформление, ДоходыБудущихПериодовПоляАналитикиСчетаДБП());
	БухгалтерскийУчет.УстановитьУсловноеОформлениеПолейАналитикиСчета(
		УсловноеОформление, ПорядокУчетаДоходовПоляАналитикиСчетаДоходов());
	УчетРасчетов.УстановитьУсловноеОформлениеСчетаИДопСубконтоРасчетов(
		УсловноеОформление, "ДоходыБудущихПериодов");
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияОсобыйПорядокУстановитьОтборВТаблице()
	
	ТекущиеДанные = Элементы.НачисленияОсобыйПорядок.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки",
			Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Иначе
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки",
			ТекущиеДанные.ИдентификаторСтроки);
	КонецЕсли;
	
	ТекущийОтборСтрок = Элементы.ОсобыйПорядокОплаты.ОтборСтрок;
	Если ТекущийОтборСтрок = Неопределено
	 ИЛИ ТекущийОтборСтрок.ИдентификаторСтроки <> НовыйОтборСтрок.ИдентификаторСтроки Тогда
		Элементы.ОсобыйПорядокОплаты.ОтборСтрок = НовыйОтборСтрок;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьИтоговуюСуммуОплатыПоГрафику(Форма, ИдентификаторСтроки)
	
	Объект = Форма.Объект;
	
	ОтборСтрок = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	ОбщийГрафикОплаты = Объект.ПорядокОплаты.НайтиСтроки(ОтборСтрок);
	
	ИтогСуммаОплатыПоГрафику = 0;
	Для Каждого СтрокаГрафика Из ОбщийГрафикОплаты Цикл
		ИтогСуммаОплатыПоГрафику = ИтогСуммаОплатыПоГрафику + СтрокаГрафика.СуммаВВалюте;
	КонецЦикла;
	
	Возврат ИтогСуммаОплатыПоГрафику;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаВопросаПередЗаполнением(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	ИначеЕсли Результат = "Перезаполнить" Тогда
		Объект.ДоходыБудущихПериодов.Очистить();
	КонецЕсли;
	
	ИмяМакета = ДопПараметры.ИмяМакета;
	
	ВызватьОкноОтбора(ИмяМакета);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОтбору(Результат, ДопПараметры) Экспорт
	
	Адреса = ДопПараметры.Адреса;
	ИмяМакета = ДопПараметры.ИмяМакета;
	
	Если Результат <> Неопределено Тогда
		
		Адреса.НастройкиКомпоновкиДанных = Результат;
		ЗаполнитьУчащимисяСервер(Адреса);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВызватьОкноОтбора(ИмяМакета)
	
	Адреса = РаботаСоСтудентамиВызовСервера.ПолучитьАдресаСКДПодбора(ИмяМакета, УникальныйИдентификатор);
	
	ПараметрыФормы = РаботаСоСтудентамиКлиент.ПараметрыФормыУпрощеннойНастройкиСхемыКомпоновкиДанных(Адреса, УникальныйИдентификатор);
	ПараметрыФормы.Заголовок = СтрШаблон(НСтр("ru = 'Настройка параметров отбора учащихся (значения на %1)'"), Формат(Объект.Дата, "ДЛФ=DD"));
	
	ДопПараметры = Новый Структура("Адреса, ИмяМакета", Адреса, ИмяМакета);
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоОтбору", ЭтотОбъект, ДопПараметры);
	ОткрытьФорму("ОбщаяФорма.УпрощеннаяНастройкаСхемыКомпоновкиДанных", ПараметрыФормы, ЭтаФорма, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУчащимисяСервер(Адреса)
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	ДанныеУчащихся = РаботаСоСтудентами.ПолучитьДанныеПодбораУчащихся(Адреса,
		Объект.Организация, Объект.Подразделение, Объект.Дата);
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ЗаполнитьСуммыДоходов", Истина);
	ПараметрыЗаполнения.Вставить("ЗаполнитьПорядокУчетаДоходов", Истина);
	Документы.КорректировкаДолгосрочныхДоговоровОбразование.ЗаполнитьПоОстаткам(Объект, ДанныеУчащихся,
		ПараметрыЗаполнения.ЗаполнитьСуммыДоходов, ПараметрыЗаполнения.ЗаполнитьПорядокУчетаДоходов);
	
	ДоходыБудущихПериодовЗаполнитьДобавленныеКолонки();
	ПорядокОплатыЗаполнитьДобавленныеКолонки();
	ПорядокУчетаДоходовЗаполнитьДобавленныеКолонки();
	
	УстановитьПредупреждение();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредупреждение()
	
	Если Объект.ДоходыБудущихПериодов.Количество() > 0 Тогда
		
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.Подразделение.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;
		
	Иначе
		
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		Элементы.Подразделение.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьШаблонГрафикаОплатыЗавершение(ВыбранныйГрафикОплат, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранныйГрафикОплат) Тогда
		
		ИтоговаяСуммаПоГрафику = ЗагрузитьШаблонГрафикаОплатыНаСервере(ВыбранныйГрафикОплат, ДопПараметры.ИдентификаторСтроки);
		
		Если НЕ ЗначениеЗаполнено(ДопПараметры.ИдентификаторСтроки) Тогда // Общий порядок оплаты.
			УстановитьВидимостьЭлементов(ЭтотОбъект);
			ТекстВопроса = СтрШаблон(НСтр("ru = 'Установить сумму корректировки доходов будущих периодов %1 для учащихся с общим порядком оплаты?'"),
				Формат(ИтоговаяСуммаПоГрафику, "ЧЦ=15;ЧДЦ=2"));
		Иначе // Особый порядок оплаты.
			УстановитьВидимостьЭлементовОсобыйПорядокОплаты(ЭтотОбъект);
			ТекстВопроса = СтрШаблон(НСтр("ru = 'Установить сумму корректировки доходов будущих периодов %1 для выбранного учащегося?'"),
				Формат(ИтоговаяСуммаПоГрафику, "ЧЦ=15;ЧДЦ=2"));
		КонецЕсли;
		
		ДопПараметры.Вставить("ИтоговаяСуммаПоГрафику", ИтоговаяСуммаПоГрафику);
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьСуммуПоГрафикуОплатЗавершение", ЭтотОбъект, ДопПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьШаблонГрафикаОплатыНаСервере(ВыбранныйГрафикОплат, ИдентификаторСтроки)
	
	ОсобыйПорядокОплаты = ЗначениеЗаполнено(ИдентификаторСтроки);
	
	// Обнуляем суммы в строках по выбранному идентификатору из табличной части.
	ОтборПоИдентификатору = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	СтрокиПоИдентификатору = Объект.ПорядокОплаты.НайтиСтроки(ОтборПоИдентификатору);
	Для Каждого СтрокаГрафика Из СтрокиПоИдентификатору Цикл
		СтрокаГрафика.СуммаВВалюте = 0;
		СтрокаГрафика.СуммаВВалютеПослеИзменений = СтрокаГрафика.СуммаВВалютеДоИзменений;
	КонецЦикла;
	
	// Заполняем график оплат по выбранному графику оплат.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГрафикиОплатыОбразование.Ссылка КАК Ссылка,
	|	ГрафикиОплатыОбразование.Валюта КАК Валюта,
	|	ГрафикиОплатыОбразование.РежимВводаГрафикаОплаты КАК РежимВводаГрафикаОплаты,
	|	ГрафикиОплатыОбразование.ПорядокОплаты.(
	|		НомерСтроки КАК НомерСтроки,
	|		ОплатитьДо КАК ОплатитьДо,
	|		СуммаПроцент КАК СуммаПроцент,
	|		НачалоПериода КАК НачалоПериода,
	|		КонецПериода КАК КонецПериода,
	|		Примечание КАК Примечание
	|	) КАК ПорядокОплаты
	|ИЗ
	|	Справочник.ГрафикиОплатыОбразование КАК ГрафикиОплатыОбразование
	|ГДЕ
	|	ГрафикиОплатыОбразование.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОплатитьДо,
	|	НачалоПериода,
	|	КонецПериода";
	Запрос.УстановитьПараметр("Ссылка", ВыбранныйГрафикОплат);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.РежимВводаГрафикаОплаты <> 0 Тогда
			Продолжить; // Только графики оплат в абсолютных величинах (суммы платежей) подходят.
		КонецЕсли;
		
		ВыборкаПорядокОплаты = Выборка.ПорядокОплаты.Выбрать();
		Пока ВыборкаПорядокОплаты.Следующий() Цикл
			
			Если КонецДня(Объект.Дата) < КонецДня(ВыборкаПорядокОплаты.КонецПериода) Тогда
				
				// Сумма по строкам графика с периодами обучения, которые еще не завершились, должна соответствовать остатку ДБП,
				// т.к. доходы текущего периода признаем на дату окончания периода обучения.
				ОтборСтрокПоПериодуОбучения = Новый Структура("ИдентификаторСтроки,ОплатитьДо,НачалоПериода,КонецПериода,Валюта",
					ИдентификаторСтроки,
					ВыборкаПорядокОплаты.ОплатитьДо,
					ВыборкаПорядокОплаты.НачалоПериода,
					ВыборкаПорядокОплаты.КонецПериода,
					Выборка.Валюта);
				НайденныеСтроки = Объект.ПорядокОплаты.НайтиСтроки(ОтборСтрокПоПериодуОбучения);
				Если НайденныеСтроки.Количество() = 0 Тогда
					// Строки выбранного графика оплаты нет в документе, добавляем.
					НоваяСтрока = Объект.ПорядокОплаты.Добавить();
					НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПорядокОплаты,
						"ОплатитьДо,НачалоПериода,КонецПериода,Примечание");
					НоваяСтрока.Валюта = Выборка.Валюта;
					НоваяСтрока.СуммаВВалютеДоИзменений    = 0;
					НоваяСтрока.СуммаВВалютеПослеИзменений = ВыборкаПорядокОплаты.СуммаПроцент;
					НоваяСтрока.СуммаВВалюте               = НоваяСтрока.СуммаВВалютеПослеИзменений - НоваяСтрока.СуммаВВалютеДоИзменений;
				Иначе
					// Устанавливаем сумму из выбранного графика оплаты в первой найденной строке.
					НайденныеСтроки[0].СуммаВВалютеПослеИзменений = ВыборкаПорядокОплаты.СуммаПроцент;
					НайденныеСтроки[0].СуммаВВалюте = НайденныеСтроки[0].СуммаВВалютеПослеИзменений - НайденныеСтроки[0].СуммаВВалютеДоИзменений;
				КонецЕсли;
			Иначе
				Продолжить; // Завершенные периоды обучения пропускаем.
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если ОсобыйПорядокОплаты Тогда
		ИтогСуммаОплатыПоОсобомуГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект,
			ИдентификаторСтроки);
		Возврат ИтогСуммаОплатыПоОсобомуГрафику;
	Иначе
		ИтогСуммаОплатыПоОбщемуГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект,
			Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
		Возврат ИтогСуммаОплатыПоОбщемуГрафику;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура СохранитьШаблонГрафикаОплатыЗавершение(НаименованиеГрафикаОплаты, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(НаименованиеГрафикаОплаты) Тогда
		
		СохранитьШаблонГрафикаОплатыНаСервере(НаименованиеГрафикаОплаты, ДопПараметры.ИдентификаторСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьШаблонГрафикаОплатыНаСервере(НаименованиеГрафикаОплаты, ИдентификаторСтроки)
	
	ОсобыйПорядокОплаты = ЗначениеЗаполнено(ИдентификаторСтроки);
	
	ГрафикОплатОбъект = Справочники.ГрафикиОплатыОбразование.СоздатьЭлемент();
	ГрафикОплатОбъект.Наименование = НаименованиеГрафикаОплаты;
	ГрафикОплатОбъект.РежимВводаГрафикаОплаты = 0; // В абсолютных величинах (суммы платежей).
	ГрафикОплатОбъект.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	
	// Сохраняем строки по выбранному идентификатору из табличной части.
	ОтборПоИдентификатору = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	СтрокиПоИдентификатору = Объект.ПорядокОплаты.НайтиСтроки(ОтборПоИдентификатору);
	Для Каждого СтрокаГрафика Из СтрокиПоИдентификатору Цикл
		НоваяСтрока = ГрафикОплатОбъект.ПорядокОплаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика,
			"ОплатитьДо,НачалоПериода,КонецПериода,Примечание");
		НоваяСтрока.СуммаПроцент = СтрокаГрафика.СуммаВВалютеПослеИзменений;
	КонецЦикла;
	
	Попытка
		ГрафикОплатОбъект.Записать();
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Записан новый элемент ""%1"" справочника ""Графики оплат"" в разделе ""Платное обучение - Долгосрочные договоры"".'"), НаименованиеГрафикаОплаты);
	Исключение
		ТекстСообщения = НСтр("ru='Не удалось записать новый элемент справочника ""Графики оплат (образование)"".'")
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

// Прочее.

&НаКлиенте
Процедура ЗаполнитьСуммуПоГрафикуОплатЗавершение(РезультатВопроса, ДопПараметры) Экспорт
	
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОтборПоИдентификатору = Новый Структура("ИдентификаторСтроки", ДопПараметры.ИдентификаторСтроки);
	НайденныеСтроки = Объект.ДоходыБудущихПериодов.НайтиСтроки(ОтборПоИдентификатору);
	Для Каждого СтрокаДокумента Из НайденныеСтроки Цикл
		СтрокаДокумента.Всего = ДопПараметры.ИтоговаяСуммаПоГрафику;
		ДоходыБудущихПериодовЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаДокумента);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммыПриИзмененииПроцентаИндексации()
	
	Документы.КорректировкаДолгосрочныхДоговоровОбразование.ИзменитьСуммыНаПроцент(Объект);
	
	ДоходыБудущихПериодовЗаполнитьДобавленныеКолонки();
	
	ИтогСуммаОплатыПоОбщемуГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект,
		Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	ИтогСуммаОплатыПоОсобомуГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект,
		НачислениеИдентификаторСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммыПриИзмененииСуммыРаспределенная()
	
	Документы.КорректировкаДолгосрочныхДоговоровОбразование.РаспределитьСуммуПоПериодам(Объект);
	
	ДоходыБудущихПериодовЗаполнитьДобавленныеКолонки();
	
	ИтогСуммаОплатыПоОбщемуГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект,
		Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	ИтогСуммаОплатыПоОсобомуГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект,
		НачислениеИдентификаторСтроки);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьПодразделения(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Подразделение",
		"Доступность", ЗначениеЗаполнено(Форма.Объект.Организация));

КонецПроцедуры

#Область ОбработчикиСобытийПроцессыОбработкиДокументов

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента(Команда)
	ОбщегоНазначенияБГУКлиент.ВыполнитьЗадачу(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение(Контекст, ДополнительныеПараметры) Экспорт
	ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст);
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры, Контекст);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст)
	ОбщегоНазначенияБГУ.ВыполнитьЗадачу(ЭтотОбъект, Контекст, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийНаправившегоОткрытие(Элемент, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийНаправившегоОткрытие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
КонецПроцедуры

