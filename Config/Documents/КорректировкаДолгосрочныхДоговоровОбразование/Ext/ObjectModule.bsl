#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	ДатаУчетнойПолитики = ?(ЗначениеЗаполнено(ВидМежотчетногоПериода), КонецГода(Дата) + 1, Дата);
	ПлательщикНалогаНаПрибыль = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Организация, ДатаУчетнойПолитики);
	
	НепроверяемыеРеквизиты.Добавить("ПорядокУчетаДоходов.СпособПризнанияДоходов");
	НепроверяемыеРеквизиты.Добавить("ПорядокУчетаДоходов.ДатаНачалаСписания");
	НепроверяемыеРеквизиты.Добавить("ПорядокУчетаДоходов.ДатаОкончанияСписания");
	НепроверяемыеРеквизиты.Добавить("ПорядокУчетаДоходов.СчетДоходов");
	НепроверяемыеРеквизиты.Добавить("ПорядокУчетаДоходов.СубконтоДоходов1");
	НепроверяемыеРеквизиты.Добавить("ПорядокУчетаДоходов.СубконтоДоходов2");
	НепроверяемыеРеквизиты.Добавить("ПорядокУчетаДоходов.СубконтоДоходов3");
	НепроверяемыеРеквизиты.Добавить("ПорядокУчетаДоходов.ВидДеятельностиНУ");
	НепроверяемыеРеквизиты.Добавить("ПорядокУчетаДоходов.СчетДоходовНУ");
	НепроверяемыеРеквизиты.Добавить("ПорядокУчетаДоходов.СтатьяПрочихДоходовНУ");
	
	Если ИзменитьПорядокУчетаДоходов Тогда
		
		Для Каждого СтрокаТаблицы Из ПорядокУчетаДоходов Цикл
			
			// Параметры списания доходов будущих периодов.
			Если СтрокаТаблицы.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам
			 ИЛИ СтрокаТаблицы.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаНачалаСписания) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Дата начала списания'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Порядок учета доходов'"));
					ПолеОшибки = "ПорядокУчетаДоходов[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДатаНачалаСписания";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаОкончанияСписания) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Дата окончания списания'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Порядок учета доходов'"));
					ПолеОшибки = "ПорядокУчетаДоходов[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДатаОкончанияСписания";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
				Если НЕ Отказ И СтрокаТаблицы.ДатаОкончанияСписания < СтрокаТаблицы.ДатаНачалаСписания Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
						НСтр("ru = 'Дата окончания списания'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Порядок учета доходов'"),
						НСтр("ru = 'Дата начала списания превышает дату окончания.'"));
					ПолеОшибки = "ПорядокУчетаДоходов[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДатаОкончанияСписания";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
			КонецЕсли;
			
			// Проверим счет и аналитику доходов будущих периодов.
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетДоходов) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru = 'Счет доходов'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Счет доходов'"));
				ПолеОшибки = "ПорядокУчетаДоходов[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СчетДоходов";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект", Отказ);
			Иначе
				РеквизитыСчетаДоходов = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
					"СчетДоходов", "СубконтоДоходов1", "СубконтоДоходов2", "СубконтоДоходов3");
				БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитикиВСтрокеТабЧасти(СтрокаТаблицы, РеквизитыСчетаДоходов,
					ЭтотОбъект, "ПорядокУчетаДоходов", Отказ);
			КонецЕсли;
			
			Если ПлательщикНалогаНаПрибыль Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ВидДеятельностиНУ) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Вид деятельности (НУ)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Порядок учета доходов'"));
					ПолеОшибки = "ПорядокУчетаДоходов[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ВидДеятельностиНУ";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетДоходовНУ) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Счет доходов (НУ)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Порядок учета доходов'"));
					ПолеОшибки = "ПорядокУчетаДоходов[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СчетДоходовНУ";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект", Отказ);
					Продолжить;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СтатьяПрочихДоходовНУ)
					И БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.СчетДоходовНУ, "Н91.01") Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Статья прочих доходов (НУ)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Порядок учета доходов'"));
					ПолеОшибки = "ПорядокУчетаДоходов[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СтатьяПрочихДоходовНУ";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	// Проверим соответствие сумм начислений (корректировок) и итоговой суммы по общему графику оплаты.
	ОтборСтрок = Новый Структура("ИдентификаторСтроки",
		Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	ИтогСуммаОплатыПоГрафику = ПорядокОплаты.Выгрузить(ОтборСтрок, "СуммаВВалюте").Итог("СуммаВВалюте");
	
	Отбор = Новый Структура("ОсобыйПорядокОплаты", Ложь);
	СтрокиСОбщимПорядкомОплаты = ДоходыБудущихПериодов.НайтиСтроки(Отбор);
	Для Каждого СтрокаТаблицы Из СтрокиСОбщимПорядкомОплаты Цикл
		
		Если СтрокаТаблицы.Всего <> ИтогСуммаОплатыПоГрафику Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				НСтр("ru = 'Всего'"),
				СтрокаТаблицы.НомерСтроки,
				НСтр("ru = 'Доходы будущих периодов'"),
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Сумма корректировки доходов будущих периодов %1 %3 не соответствует итоговой сумме корректировки по общему графику оплаты %2 %3.
					|Возможно, для данной строки документа необходимо установить особый порядок оплаты.'"),
						СтрокаТаблицы.Всего,
						ИтогСуммаОплатыПоГрафику,
						БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета()));
			ПолеВсего = "ДоходыБудущихПериодов[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Всего";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеВсего, "Объект", Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	// Проверим соответствие сумм начислений (корректировок) и графиков с особым графиком оплаты.
	Отбор = Новый Структура("ОсобыйПорядокОплаты", Истина);
	СтрокиСОсобымПорядкомОплаты = ДоходыБудущихПериодов.НайтиСтроки(Отбор);
	Для Каждого СтрокаТаблицы Из СтрокиСОсобымПорядкомОплаты Цикл
		
		ОтборСтрок = Новый Структура("ИдентификаторСтроки", СтрокаТаблицы.ИдентификаторСтроки);
		ИтогСуммаОплатыПоГрафику = ПорядокОплаты.Выгрузить(ОтборСтрок, "СуммаВВалюте").Итог("СуммаВВалюте");
		
		Если СтрокаТаблицы.Всего <> ИтогСуммаОплатыПоГрафику Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				НСтр("ru = 'Всего'"),
				СтрокаТаблицы.НомерСтроки,
				НСтр("ru = 'Доходы будущих периодов'"),
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Сумма корректировки доходов будущих периодов %1 %3 не соответствует итоговой сумме корректировки по особому графику оплаты %2 %3.'"),
						СтрокаТаблицы.Всего,
						ИтогСуммаОплатыПоГрафику,
						БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета()));
			ПолеВсего = "ДоходыБудущихПериодов[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Всего";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеВсего, "Объект", Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	Если ИспользоватьКонтрольИсполненияДоговоров Тогда
		
		// Проверим установку признака "Вести графики исполнения - План-график реализации" в договорах.
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПорядокУчетаДоходов.Ссылка КАК Ссылка,
		|	ПорядокУчетаДоходов.НомерСтроки КАК НомерСтроки,
		|	ПорядокУчетаДоходов.Контрагент КАК Контрагент,
		|	ПорядокУчетаДоходов.Договор КАК Договор,
		|	ПорядокУчетаДоходов.СпособПризнанияДоходов КАК СпособПризнанияДоходов
		|ИЗ
		|	Документ.КорректировкаДолгосрочныхДоговоровОбразование.ПорядокУчетаДоходов КАК ПорядокУчетаДоходов
		|ГДЕ
		|	ПорядокУчетаДоходов.Ссылка = &Ссылка
		|	И ПорядокУчетаДоходов.СпособПризнанияДоходов = ЗНАЧЕНИЕ(Перечисление.СпособыПризнанияРасходов.ПоГрафику)
		|	И НЕ ПорядокУчетаДоходов.Договор.ВестиПланГрафикИсполнения";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'По договору %2 (%1) установлен способ признания доходов ""По графику"", при этом план-график реализации по договору не ведется.
					|Необходимо установить флаг ""Вести графики исполнения - План-график реализации"" в карточке договора.'"),
					Выборка.Контрагент,
					Выборка.Договор);
			ПолеСпособПризнанияДоходов = "ПорядокУчетаДоходов[" + Формат(Выборка.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СпособПризнанияДоходов";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеСпособПризнанияДоходов, "Объект");
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = ДоходыБудущихПериодов.Итог("Всего");
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		ВалютаРеглУчета = Константы.ВалютаРегламентированногоУчета.Получить();
		Для Каждого СтрокаПорядокОплаты Из ПорядокОплаты Цикл
			СтрокаПорядокОплаты.Валюта = ВалютаРеглУчета;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли