
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	УчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям();
	
	Элементы.ОтборИФО.Видимость							= УчетПоИФО;
	Элементы.ОсновныеСредстваИФО.Видимость				= УчетПоИФО;
	Элементы.ОтборПодразделение.Видимость				= УчетПоПодразделениям;
	Элементы.ОсновныеСредстваПодразделение.Видимость	= УчетПоПодразделениям;
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Содержание = НСтр("ru = 'Перевод объектов по письму Минздрава №22-0/1045'");
	КонецЕсли;
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Элементы.БухгалтерскаяОперация);
	// Конец Типовые операции и дополнительные табличные части
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ОсновныеСредстваРедактироватьТЧ.Доступность = Не ТолькоПросмотр;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект, Элементы.БухгалтерскаяОперация);
	// Конец Типовые операции и дополнительные табличные части
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтотОбъект);
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтотОбъект);
	
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	
	Если Объект.Проведен И Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатковОперУчет.ПереносИноеДвиживое") Тогда
		ЕстьОборотыЗаТекущийГод = ЕстьОборотыОС(Объект.Ссылка);
		Если ЕстьОборотыЗаТекущийГод Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'По списываемым ОС есть обороты за текущий год. Эти обороты необходимо исправить.
			|Для просмотра документов с оборотами сформируйте печатную форму ""Обороты ОС за текущий год"".'"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	Объект.ОсновныеСредства.Очистить();
	
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьОС(Команда)
	
	Если Объект.Проведен Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Заполнение доступно в не проведенном документе'"));
	Иначе
		ЗаполнитьОССервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьТЧ(Команда)
	
	Если Элементы.ОсновныеСредстваРедактироватьТЧ.Пометка Тогда
		ИзменитьРежимРедактированияТЧ();
	Иначе
		ОписаниеОповещения = Новый ОписаниеОповещения("ВопросРедактироватьТЧЗавершение", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Рекомендуется заполнять таблицу по кнопке ""Заполнить"".
                            |Редактирование вручную следует использовать только в крайних случаях. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом(Команда)
	ОбменСАрхивомКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Объект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьОССервер()
	
	Если Объект.ВидОперации = Перечисления.ОперацииПереносОстатковОперУчет.ПереносИноеДвиживое
		Или Объект.ВидОперации = Перечисления.ОперацииПереносОстатковОперУчет.ПереносОЦИ Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
		|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
		|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
		|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет
		|ПОМЕСТИТЬ ВТ_РБ
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			Счет В (&СписокСчетов),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|			Организация = &Организация
		|				И ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства).ТипНФА <> ЗНАЧЕНИЕ(Перечисление.ТипыНФА.БиблиотечныйФонд)
		|				И ИФО = &ИФО
		|				И КФО = &КФО) КАК ЖурналПроводокЕПСБУОстатки
		|ГДЕ
		|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток <> 0
		|	И ЖурналПроводокЕПСБУОстатки.СуммаОстаток / ЖурналПроводокЕПСБУОстатки.КоличествоОстаток <= 10000
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство
		|ПОМЕСТИТЬ ВТ_Параметры
		|ИЗ
		|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
		|			&Период,
		|			&Организация = Организация
		|				И ОсновноеСредство В
		|					(ВЫБРАТЬ
		|						ВТ_РБ.ОсновноеСредство КАК ОсновноеСредство
		|					ИЗ
		|						ВТ_РБ КАК ВТ_РБ)) КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
		|ГДЕ
		|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ПорядокПогашенияСтоимости <> ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
		|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
		|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение,
		|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК Количество,
		|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК Сумма,
		|	АмортизацияОбъектовОСОстатки.СуммаАмортизацииОстаток КАК СуммаАмортизации,
		|	АмортизацияОбъектовОСОстатки.СуммаОбесцененияОстаток КАК СуммаОбесценения,
		|	ВТ_РБ.ИФО КАК ИФО,
		|	ВТ_РБ.КФО КАК КФО,
		|	ВТ_РБ.КПС КАК КПС,
		|	ВТ_РБ.Счет КАК СчетУчета
		|ИЗ
		|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И ОсновноеСредство В
		|					(ВЫБРАТЬ
		|						ВТ_Параметры.ОсновноеСредство КАК ОсновноеСредство
		|					ИЗ
		|						ВТ_Параметры КАК ВТ_Параметры)
		|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
		|				И Подразделение = &Подразделение) КАК СтоимостьОбъектовОСОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.АмортизацияОбъектовОС.Остатки(
		|				&Период,
		|				Организация = &Организация
		|					И ОсновноеСредство В
		|						(ВЫБРАТЬ
		|							ВТ_Параметры.ОсновноеСредство КАК ОсновноеСредство
		|						ИЗ
		|							ВТ_Параметры КАК ВТ_Параметры)) КАК АмортизацияОбъектовОСОстатки
		|		ПО СтоимостьОбъектовОСОстатки.ОсновноеСредство = АмортизацияОбъектовОСОстатки.ОсновноеСредство
		|			И СтоимостьОбъектовОСОстатки.ИнвентарныйНомер = АмортизацияОбъектовОСОстатки.ИнвентарныйНомер
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РБ КАК ВТ_РБ
		|		ПО СтоимостьОбъектовОСОстатки.ОсновноеСредство = ВТ_РБ.ОсновноеСредство
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтоимостьОбъектовОСОстатки.ОсновноеСредство.Наименование,
		|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер.Код";
		
		Если Объект.ВидОперации = Перечисления.ОперацииПереносОстатковОперУчет.ПереносИноеДвиживое Тогда
			КодыСчетов = "101.30";
			ДатаОстатков = Объект.Дата;
		Иначе
			КодыСчетов = "101.20";
			ДатаОстатков = Объект.Дата;
		КонецЕсли;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ОперацииПереносОстатковОперУчет.ПереносЗабаланс Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
		|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
		|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
		|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет
		|ПОМЕСТИТЬ ВТ_РБ
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			Счет В (&СписокСчетов),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|			Организация = &Организация
		|				И ИФО = &ИФО
		|				И КФО = &КФО) КАК ЖурналПроводокЕПСБУОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
		|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
		|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение,
		|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК Количество,
		|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК Сумма,
		|	ВТ_РБ.ИФО КАК ИФО,
		|	ВТ_РБ.КФО КАК КФО,
		|	ВТ_РБ.КПС КАК КПС,
		|	ВТ_РБ.Счет КАК СчетУчета
		|ИЗ
		|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И ОсновноеСредство В
		|					(ВЫБРАТЬ
		|						ВТ_РБ.ОсновноеСредство КАК ОсновноеСредство
		|					ИЗ
		|						ВТ_РБ КАК ВТ_РБ)
		|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ОперативныйУчет)
		|				И Подразделение = &Подразделение) КАК СтоимостьОбъектовОСОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РБ КАК ВТ_РБ
		|		ПО СтоимостьОбъектовОСОстатки.ОсновноеСредство = ВТ_РБ.ОсновноеСредство
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтоимостьОбъектовОСОстатки.ОсновноеСредство.Наименование,
		|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер.Код";
		
		ДатаОстатков = Объект.Дата;
		КодыСчетов = "21.20";
		
	Иначе
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период"			, Новый Граница(ДатаОстатков, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация"		, Объект.Организация);
	Запрос.УстановитьПараметр("СписокСчетов"	, БухгалтерскийУчет.СписокСчетов(КодыСчетов));
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(Объект.ОтборИФО) Тогда
		Запрос.УстановитьПараметр("ИФО", Объект.ОтборИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
	КонецЕсли;
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЖурналПроводокЕПСБУОстатки.ИФО", "Значение(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ОтборКФО) Тогда
		Запрос.УстановитьПараметр("КФО", Объект.ОтборКФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И КФО = &КФО", "");
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям() И ЗначениеЗаполнено(Объект.ОтборПодразделение) Тогда
		Запрос.УстановитьПараметр("Подразделение", Объект.ОтборПодразделение);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение = &Подразделение", "");
	КонецЕсли;
	Если Не УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям() Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СтоимостьОбъектовОСОстатки.Подразделение", "Значение(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Объект.ОсновныеСредства.Загрузить(Результат);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьОборотыОС(ДокументСсылка)
	
	СписокДок = Документы.ПереносОстатковВОперативныйУчет.ДокументыОборотов(ДокументСсылка);
	Результат = (СписокДок.Количество() > 0);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВопросРедактироватьТЧЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ИзменитьРежимРедактированияТЧ();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРежимРедактированияТЧ()
	
	НоваяПометка = Не Элементы.ОсновныеСредстваРедактироватьТЧ.Пометка;
	
	Элементы.ОсновныеСредстваРедактироватьТЧ.Пометка = НоваяПометка;
	Элементы.ОсновныеСредства.ТолькоПросмотр = Не НоваяПометка;
	
КонецПроцедуры

