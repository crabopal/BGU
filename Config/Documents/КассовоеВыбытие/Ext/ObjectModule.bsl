#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
	
// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда
		ПлатежноРасчетныеДокументы.ЗаполнитьНаОснованииВедомостиКомпенсацииРодительскойПлатыКВыплате(ЭтотОбъект,
			ДанныеЗаполнения, СтандартнаяОбработка);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВедомостьНаВыплатуВБанк") Тогда
		
		// проверим, был ли уже введен расчетно-платежный документ на основании ведомости
		РасчетноПлатежныйДокумент =
			ПлатежноРасчетныеДокументы.ВведенныйНаОснованииВедомостиВБанкРасчетноПлатежныйДокумент(ДанныеЗаполнения);
		
		Если ЗначениеЗаполнено(РасчетноПлатежныйДокумент) И Ссылка <> РасчетноПлатежныйДокумент Тогда
			
			ТекстИсключения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru='На основании ведомости уже введен расчетно-платежный документ (%1)'"),
									РасчетноПлатежныйДокумент);
			ВызватьИсключение ТекстИсключения;
			
		Иначе
			
			Если НЕ ДанныеЗаполнения.ПолучитьОбъект().ПроверитьЗаполнение() Тогда
				ВызватьИсключение "В ведомости есть ошибки заполнения (см. окно сообщений)! Ввод на основании невозможен."
			КонецЕсли;
			
			Организация				= ДанныеЗаполнения.Организация;
			ИФО						= ДанныеЗаполнения.ИФО;
			Дата					= ДанныеЗаполнения.Дата;
			СуммаДокументаВВалюте	= ДанныеЗаполнения.СуммаДокумента;
			СуммаДокумента			= ДанныеЗаполнения.СуммаДокумента;
			ДокументОснование		= ДанныеЗаполнения;
			ВалютаДокумента			= Константы.ВалютаРегламентированногоУчета.Получить();
			КурсКратность			= РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, Дата);
			Курс					= КурсКратность.Курс;
			Кратность				= КурсКратность.Кратность;
			
			РасшифровкаПлатежа.Очистить();
			
			ТаблицаДляЗаполнения = ДанныеЗаполнения.РасшифровкаПлатежа.Выгрузить();
			ТаблицаДляЗаполнения.Свернуть("КФО,КПС,КЭК,КодЦели,КодМероприятия,ДопКлассификация","Сумма");
			ТаблицаДляЗаполнения.Сортировать("КФО,КПС,КЭК");
			
			Для Каждого СтрокаОснования Из ТаблицаДляЗаполнения Цикл
				СтрРасшифровка = РасшифровкаПлатежа.Добавить();
				СтрРасшифровка.КФО						= СтрокаОснования.КФО;
				СтрРасшифровка.КБКНазначениеПлатежа		= СтрокаОснования.КПС;
				СтрРасшифровка.КОСГУНазначениеПлатежа	= СтрокаОснования.КЭК;
				СтрРасшифровка.КодЦели					= СтрокаОснования.КодЦели;
				СтрРасшифровка.КодМероприятия			= СтрокаОснования.КодМероприятия;
				СтрРасшифровка.ДопКлассификация			= СтрокаОснования.ДопКлассификация;
				СтрРасшифровка.СуммаВал					= СтрокаОснования.Сумма;
				СтрРасшифровка.Сумма					= СтрокаОснования.Сумма;
				
				ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(ЛицевойСчет,СтрРасшифровка.КФО);
				Если ДопустимыеИсточникиСредств.Количество() = 1 Тогда
					СтрРасшифровка.ИсточникСредств = ДопустимыеИсточникиСредств[0];
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявлениеНаВыдачуАванса") Тогда
		ПлатежноРасчетныеДокументы.ЗаполнитьПлатежныйДокументНаОснованииЗаявленияНаВыдачуАванса(ЭтотОбъект, ДанныеЗаполнения, СтандартнаяОбработка);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РешениеОКомандировании") Тогда
		ПлатежноРасчетныеДокументы.ЗаполнитьПлатежныйДокументНаОснованииРешенияОКомандировании(ЭтотОбъект, ДанныеЗаполнения, СтандартнаяОбработка);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РешениеОКомпенсацииРасходовДляКрайнегоСевера") Тогда
		ПлатежноРасчетныеДокументы.ЗаполнитьПлатежныйДокументНаОснованииРешенияОКомпенсации(ЭтотОбъект, ДанныеЗаполнения, СтандартнаяОбработка);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъема")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо") Тогда
		ПлатежноРасчетныеДокументы.ЗаполнитьПлатежныйДокументНаОснованииЗаявкиОбоснования(ЭтотОбъект, ДанныеЗаполнения, СтандартнаяОбработка);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявлениеНаВыдачуКазначейскогоАккредитива") Тогда
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	КазначейскоеОбеспечение.Обязательство КАК Договор,
		|	ВЫРАЗИТЬ(КазначейскоеОбеспечение.Регистратор КАК Документ.ЗаявлениеНаВыдачуКазначейскогоАккредитива).Контрагент КАК Контрагент,
		|	ВЫРАЗИТЬ(КазначейскоеОбеспечение.Регистратор КАК Документ.ЗаявлениеНаВыдачуКазначейскогоАккредитива).Контрагент КАК ПолучательПлатежа,
		|	ВЫРАЗИТЬ(КазначейскоеОбеспечение.Регистратор КАК Документ.ЗаявлениеНаВыдачуКазначейскогоАккредитива).СчетКонтрагента КАК СчетКонтрагента,
		|	ВЫРАЗИТЬ(КазначейскоеОбеспечение.Регистратор КАК Документ.ЗаявлениеНаВыдачуКазначейскогоАккредитива).КодВидаСредств КАК КодВидаСредств,
		|	КазначейскоеОбеспечение.КПС КАК КБКНазначениеПлатежа,
		|	КазначейскоеОбеспечение.Сумма КАК СуммаВал,
		|	КазначейскоеОбеспечение.Сумма КАК Сумма,
		|	КазначейскоеОбеспечение.Сумма КАК СуммаДокумента,
		|	КазначейскоеОбеспечение.Сумма КАК СуммаДокументаВВалюте,
		|	КазначейскоеОбеспечение.НомерКОО КАК НомерПервичногоДокумента,
		|	КазначейскоеОбеспечение.ДатаКОО КАК ДатаПервичногоДокумента,
		|	""Казначейское обеспечение обязательств"" КАК ВидПервичногоДокумента,
		|	ВЫРАЗИТЬ(КазначейскоеОбеспечение.Регистратор КАК Документ.ЗаявлениеНаВыдачуКазначейскогоАккредитива).Организация КАК Организация,
		|	ВЫРАЗИТЬ(КазначейскоеОбеспечение.Регистратор КАК Документ.ЗаявлениеНаВыдачуКазначейскогоАккредитива).ЛицевойСчет КАК ЛицевойСчет,
		|	ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет) КАК КФО,
		|	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.ИсточникСредств КАК ИсточникСредств
		|ИЗ
		|	РегистрСведений.КазначейскоеОбеспечение КАК КазначейскоеОбеспечение
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО КАК РазделыЛицевыхСчетовДопустимыеКФО
		|		ПО (ВЫРАЗИТЬ(КазначейскоеОбеспечение.Регистратор КАК Документ.ЗаявлениеНаВыдачуКазначейскогоАккредитива).ЛицевойСчет = РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.Владелец
		|				И РазделыЛицевыхСчетовДопустимыеКФО.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет))
		|ГДЕ
		|	(ВЫРАЗИТЬ(КазначейскоеОбеспечение.Регистратор КАК Документ.ЗаявлениеНаВыдачуКазначейскогоАккредитива)) = &Регистратор");
		
		Запрос.УстановитьПараметр("Регистратор", ДанныеЗаполнения); 
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
			
			НовСтр = РасшифровкаПлатежа.Добавить();
			
			ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
			
			ДокументОснование = ДанныеЗаполнения;
			
			Если Выборка.КодВидаСредств = "01" ИЛИ Выборка.КодВидаСредств = "03" Тогда
				КорСчет = БухгалтерскийУчет.СчетПоКоду("206.00",, Выборка.Организация);	
			Иначе	
				КорСчет = БухгалтерскийУчет.СчетПоКоду("302.00",, Выборка.Организация);
			КонецЕсли;
			
		Иначе
			
			ТекстИсключения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru='Документ (%1) не содержит данных для формирования кассового выбытия'"),
								ДанныеЗаполнения);
			ВызватьИсключение ТекстИсключения;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВнешнееРСКП") Тогда
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	КассовоеВыбытие.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КассовоеВыбытие КАК КассовоеВыбытие
		|ГДЕ
		|	КассовоеВыбытие.ДокументОснование = &ДокументОснование");
		Запрос.УстановитьПараметр("ДокументОснование", ДанныеЗаполнения);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда  
		   Если Выборка.Ссылка <> ЭтотОбъект.Ссылка Тогда	
			   ТекстИсключения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru='На основании (%1) уже введен документ (%2)'"),
									ДанныеЗаполнения,
									Выборка.Ссылка);
				ВызватьИсключение ТекстИсключения; 
			КонецЕсли;
		КонецЕсли;
		
		ОбъектОснование = ДанныеЗаполнения.ПолучитьОбъект();
		ДокументОснование = ДанныеЗаполнения;
		ПолучательПлатежа = ОбъектОснование.Контрагент;  
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ОбъектОснование,, "Номер,Дата,Ответственный,Проведен");
		РасшифровкаПлатежа.Очистить();
		Для Каждого Стр Из ОбъектОснование.РасшифровкаПлатежа Цикл
			НовСтр = РасшифровкаПлатежа.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Стр);
		КонецЦикла;	
		Если ОбъектОснование.АвансовыйПлатеж Тогда
			КорСчет = БухгалтерскийУчет.СчетПоКоду("206.00", ОбъектОснование.Дата, ОбъектОснование.Организация);
		Иначе
			КорСчет = БухгалтерскийУчет.СчетПоКоду("302.00", ОбъектОснование.Дата, ОбъектОснование.Организация);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);	
	
	НельзяПровести = НЕ (СуммаДокумента = РасшифровкаПлатежа.Итог("Сумма"));
	
	Если НельзяПровести Тогда
		
		Если СуммаДокументаВВалюте = РасшифровкаПлатежа.Итог("СуммаВал") Тогда
			ИмяПоля = "СуммаДокумента";
			НераспределеннаяСумма = Формат((СуммаДокумента - РасшифровкаПлатежа.Итог("Сумма")),"ЧДЦ=2");
		Иначе
			ИмяПоля = "СуммаДокументаВВалюте";
			НераспределеннаяСумма = Формат((СуммаДокументаВВалюте - РасшифровкаПлатежа.Итог("СуммаВал")),"ЧДЦ=2");
		КонецЕсли;	
		
		ТекстСообщения = НСтр("ru='Проведение невозможно. Сумма документа не равна сумме расшифровки платежа. Не распределена сумма: '") + НераспределеннаяСумма;
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ИмяПоля, "Объект");
		
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И НельзяПровести Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если НЕ УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(КорСчет) Тогда
		
		Для Каждого СтрокаРасшифровки Из РасшифровкаПлатежа Цикл
			СтрокаРасшифровки.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
			СтрокаРасшифровки.ДопСубконтоРасчетов = Неопределено;
		КонецЦикла;
		
	КонецЕсли;
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ДокументОснование = Неопределено;
	
	// Очистим поле "Оплатить до", т.к. данный платеж, скорее всего, уже был оплачен в документе, который копируем.
	Для Каждого СтрокаРасшифровки Из РасшифровкаПлатежа Цикл
		СтрокаРасшифровки.ОплатитьДо = Дата("00010101");
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		
		ВалютаЛицевогоСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛицевойСчет, "ВалютаСчета");
		ТипЛицевогоСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛицевойСчет, "ТипЛицевогоСчета");
		
		Если ЗначениеЗаполнено(ВалютаДокумента)
			И ЗначениеЗаполнено(ВалютаЛицевогоСчета)
			И НЕ ВалютаДокумента = ВалютаЛицевогоСчета
			И ТипЛицевогоСчета = ПредопределенноеЗначение("Перечисление.ТипыЛицевыхСчетов.Банковский")
			И БухгалтерскийУчет.СчетВИерархии(КорСчет, "206.00, 208.00, 302.00")
			И НЕ ЗначениеЗаполнено(СуммаПроданнойВалюты) Тогда
			
			ПроверяемыеРеквизиты.Добавить("СуммаПроданнойВалюты");
			ПроверяемыеРеквизиты.Добавить("КурсПроданнойВалюты");
			ПроверяемыеРеквизиты.Добавить("КратностьПроданнойВалюты");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

// Заполняет документ остатками задолженности к погашению.
//
Процедура ЗаполнитьПоОстаткамЗадолженности() Экспорт
	
	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	РасшифровкаПлатежа.Очистить();
	
	ПлатежноРасчетныеДокументы.ЗаполнитьРасшифровкуПлатежаПоОстаткамЗадолженности(
