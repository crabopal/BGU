&НаКлиенте
Процедура УстановитьДопСубконтоРасчетов(ТекДанные, ИмяИсточника)  
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекДанные[ИмяИсточника]) = ТипЗнч(ТекДанные.ДопСубконтоРасчетов)
		И НЕ ТекДанные[ИмяИсточника] = ТекДанные.ДопСубконтоРасчетов Тогда
		ТекДанные.ДопСубконтоРасчетов = ТекДанные[ИмяИсточника];
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет20800",
		БухгалтерскийУчет.СчетПоКоду("208.00", Объект.Дата, Неопределено));
	
	РасшифровкаПлатежаЗаполнитьДобавленныеКолонки();
	ЗаполнитьСвойстваЛицевогоСчета();
	УстановитьРазрешенВыборУчетнойГруппы();
	
	УстановитьВидимостьЭлементовРасчеты();
	УстановитьВидимостьЭлементовГрафикПлатежей();
	УстановитьВидимостьГруппыКонвертация();
	УстановитьВидимостьЭлементовГосударственныеКонтракты();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовРасчеты()
	
	ИспользуетсяНастройкаПогашенияЗадолженности = УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(Объект.КорСчет);
	НастройкаПогашенияЗадолженности = Новый Массив;
	НастройкаПогашенияЗадолженности.Добавить("РасшифровкаПлатежаСчетРасчетов");
	НастройкаПогашенияЗадолженности.Добавить("РасшифровкаПлатежаСпособПогашенияЗадолженности");
	НастройкаПогашенияЗадолженности.Добавить("РасшифровкаПлатежаДопСубконтоРасчетов");
	НастройкаПогашенияЗадолженности.Добавить("РасшифровкаПлатежаКомандаЗаполнитьПоОстаткамЗадолженности");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		НастройкаПогашенияЗадолженности, "Видимость", ИспользуетсяНастройкаПогашенияЗадолженности);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РасшифровкаПлатежаКомандаЗаполнитьПоОстаткамЗадолженности", "Видимость",
		ИспользуетсяНастройкаПогашенияЗадолженности
		ИЛИ БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "208.00")
		ИЛИ БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "301.00"));
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НалогСборПлатеж", "Видимость",
		БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "303.00")
		ИЛИ НЕ ЗначениеЗаполнено(Объект.КорСчет));
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииЛицевогоСчета()
	
	ДопустимыеИсточникиСредств = СписокВыбораИсточникСредств(Объект.ЛицевойСчет);
	
	Элементы.РасшифровкаПлатежаИсточникСредств.СписокВыбора.ЗагрузитьЗначения(ДопустимыеИсточникиСредств);
	
	ПлатежноРасчетныеДокументы.ЗаполнитьДопустимыеКФОиИсточникиСредств(Объект.ЛицевойСчет,СписокДопустимыхКФО,СписокИсточниковСредствПоКФО);
	
	Для Каждого Стр Из Объект.РасшифровкаПлатежа Цикл
		
		Если СписокДопустимыхКФО.НайтиПоЗначению(Стр.КФО) = Неопределено Тогда
			Стр.КФО = "";
			Если СписокДопустимыхКФО.Количество() > 0 Тогда
				Стр.КФО = СписокДопустимыхКФО[0].Значение;
			КонецЕсли;
		КонецЕсли;
		
		ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет,Стр.КФО);
		Если ДопустимыеИсточникиСредств.Найти(Стр.ИсточникСредств) = Неопределено Тогда
			Стр.ИсточникСредств = "";
			Если ДопустимыеИсточникиСредств.Количество() > 0 Тогда
				Стр.ИсточникСредств = ДопустимыеИсточникиСредств[0];
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьСвойстваЛицевогоСчета();
	
	ОбновитьКурсВалютыЛицевогоСчета(ЭтотОбъект);
	
	РассчитатьКурсовуюРазницу(ЭтотОбъект);
	
	УстановитьВидимостьГруппыКонвертация();
	
	УстановитьВидимостьЭлементовГосударственныеКонтракты();
	
	Элементы.РасшифровкаПлатежаНаправлениеРасходованияВР.Видимость = НЕ СписокДопустимыхКФО.НайтиПоЗначению(ПредопределенноеЗначение("Перечисление.КВД.ВременноеРаспоряжение")) = Неопределено;
	
КонецПРоцедуры

&НаСервере
Процедура ПолучитьЛицевойСчетПоУмолчанию()
	
	Объект.ЛицевойСчет = Справочники.ЛицевыеСчета.ПолучитьЛицевойСчетПоУмолчанию(Объект.Организация, "Документ.КассовоеВыбытие", Объект.Дата, ,Объект.ВалютаДокумента);
	
	ПриИзмененииЛицевогоСчета();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКурсВалюты()
	
	КурсКратность = ПолучитьКурс(Объект.ВалютаДокумента, Объект.Дата);
	Объект.Курс = КурсКратность.Курс;
	Объект.Кратность = КурсКратность.Кратность;
	
	ПересчитатьРублевоеПокрытие(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКурс(Знач ВалютаДокумента, Дата)
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, Дата);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьРублевоеПокрытие(Форма, Объект)
	
	Объект.СуммаДокумента = Объект.СуммаДокументаВВалюте*Объект.Курс/?(Объект.Кратность=0,1,Объект.Кратность);
	
	Для Каждого ДанныеСтроки Из Объект.РасшифровкаПлатежа Цикл
		ДанныеСтроки.Сумма = ДанныеСтроки.СуммаВал*Объект.Курс/?(Объект.Кратность=0,1,Объект.Кратность);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокВыбораИсточникСредств(Знач ЛицевойСчет)
	
	Возврат ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(ЛицевойСчет);
	
КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()

	Элементы.ЛицевойСчет.Доступность	= ЗначениеЗаполнено(Объект.Организация);
	Элементы.Подразделение.Доступность	= ЗначениеЗаполнено(Объект.Организация);

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()

&НаКлиенте
Процедура УстановитьДоступностьДоговора()

	Элементы.Договор.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);	

КонецПроцедуры // УстановитьДоступностьДоговора()
 
&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовПолучателя()

	Элементы.СчетКонтрагента.Доступность = ЗначениеЗаполнено(Объект.ПолучательПлатежа);	

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовКонтрагента()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьВалютныхРеквизитов(Форма)
	
	ВидимостьДоступность = НЕ Форма.Объект.ВалютаДокумента = Форма.КэшПараметров.ВалютаРегламентированногоУчета;
	Форма.Элементы.Курс.Доступность = ВидимостьДоступность;
	Форма.Элементы.Кратность.Доступность = ВидимостьДоступность;
	Форма.Элементы.СуммаДокумента.Доступность = ВидимостьДоступность;
	Форма.Элементы.РасшифровкаПлатежаСумма.Видимость = ВидимостьДоступность;
	
КонецПроцедуры

&НаСервере
Функция КонтрольДокументаПоОбязательствамСервер(Адрес)
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	
	БухгалтерскиеОперацииСервер.ПередЗаписью(Ложь, ТекущийОбъект, Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись), ЭтаФорма);
	
	КонтрольРасходов.Контроль(ТекущийОбъект, Ложь,, Истина, Адрес);
	
	Если ЗначениеЗаполнено(Адрес) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоОстаткамЗадолженностиНаСервере()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьПоОстаткамЗадолженности();
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	РасшифровкаПлатежаЗаполнитьДобавленныеКолонки();
	РазницаИтогаТЧ = Объект.РасшифровкаПлатежа.Итог("СуммаВал") - Объект.СуммаДокументаВВалюте;
	
КонецПроцедуры

