#Область УчетИностраннойВалюты

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьКурсВалютыЛицевогоСчета(Форма)
	
	КурсКратность = ПолучитьКурс(Форма.ВалютаЛицевогоСчета, Форма.Объект.Дата);
	Форма.Объект.КурсПроданнойВалюты = КурсКратность.Курс;
	Форма.Объект.КратностьПроданнойВалюты = КурсКратность.Кратность;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьГруппыКонвертация()
	
	Видимость = Ложь;
	
	Если ЗначениеЗаполнено(Объект.ВалютаДокумента)
		И ЗначениеЗаполнено(ВалютаЛицевогоСчета)
		И НЕ Объект.ВалютаДокумента = ВалютаЛицевогоСчета
		И ТипЛицевогоСчета = ПредопределенноеЗначение("Перечисление.ТипыЛицевыхСчетов.Банковский")
		И БухгалтерскийУчет.СчетВИерархии(Объект.КорСчет, "206.00, 208.00, 302.00") Тогда
		
		Видимость = Истина;
		
		Если Объект.ВалютаДокумента = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
			Если Объект.КратностьПроданнойВалюты = 1 Тогда
				ВалютнаяПара = "";
			Иначе
				ВалютнаяПара = "" + Объект.ВалютаДокумента + " за " + Объект.КратностьПроданнойВалюты + " " + ВалютаЛицевогоСчета;
			КонецЕсли;
		ИначеЕсли ВалютаЛицевогоСчета = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
			Если Объект.Кратность = 1 Тогда
				ВалютнаяПара = "";
			Иначе
				ВалютнаяПара = "" + ВалютаЛицевогоСчета + " за " + Объект.Кратность + " " + Объект.ВалютаДокумента;
			КонецЕсли;
		Иначе
			ВалютнаяПара = "(" + ВалютаЛицевогоСчета + " / " + Объект.ВалютаДокумента + ")";
		КонецЕсли;
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КонвертацияВалюты", "Видимость", Видимость);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьКурсовуюРазницу(Форма)
	
	Если Форма.Объект.СуммаПроданнойВалюты = 0 ИЛИ Форма.Объект.СуммаДокументаВВалюте = 0 Тогда
		Форма.ОбменныйКурс = 0;
	ИначеЕсли Форма.ВалютаЛицевогоСчета = Форма.КэшПараметров.ВалютаРегламентированногоУчета Тогда
		Форма.ОбменныйКурс = Форма.Объект.СуммаПроданнойВалюты * Форма.Объект.Кратность / Форма.Объект.СуммаДокументаВВалюте;
	Иначе
		Форма.ОбменныйКурс = Форма.Объект.СуммаДокументаВВалюте / Форма.Объект.СуммаПроданнойВалюты;
	КонецЕсли;
	
	КурсоваяРазница = Форма.Объект.СуммаДокумента
					- Форма.Объект.СуммаПроданнойВалюты * Форма.Объект.КурсПроданнойВалюты / ?(Форма.Объект.КратностьПроданнойВалюты = 0, 1, Форма.Объект.КратностьПроданнойВалюты);
	
	ЗаголовокКурсовойРазницы = ?(КурсоваяРазница < 0,
								НСтр("ru = 'Отрицательная курсовая разница:'"),
								НСтр("ru = 'Положительная курсовая разница:'"));
	Форма.КурсоваяРазница = ?(КурсоваяРазница < 0, - КурсоваяРазница, КурсоваяРазница);
	Форма.КурсоваяРазницаЗаголовок = ЗаголовокКурсовойРазницы;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвойстваЛицевогоСчета()
	
	СвойстваЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Объект.ЛицевойСчет, "ВалютаСчета, ТипЛицевогоСчета, КазначейскоеСопровождениеНаРазделах");
	
	ВалютаЛицевогоСчета = СвойстваЛицевогоСчета.ВалютаСчета;
	ТипЛицевогоСчета = СвойстваЛицевогоСчета.ТипЛицевогоСчета;
	СопровождениеНаРазделахЛС = СвойстваЛицевогоСчета.КазначейскоеСопровождениеНаРазделах;
	
КонецПроцедуры

