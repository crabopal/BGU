				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РегистрСведений.ДокументОснование КАК ДокументОснование,
	МАКСИМУМ(РегистрСведений.Дата) КАК Дата
ПОМЕСТИТЬ ВТМаксимальныеДаты
ИЗ
	РегистрСведений.ФискальныеОперации КАК РегистрСведений
ГДЕ
	(РегистрСведений.ДокументОснование ССЫЛКА Документ.КассовоеВыбытие)

СГРУППИРОВАТЬ ПО
	РегистрСведений.ДокументОснование

ИНДЕКСИРОВАТЬ ПО
	ДокументОснование,
	Дата
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТМаксимальныеДаты.ДокументОснование КАК ДокументОснование,
	РегистрСведений.НомерЧекаККМ КАК НомерЧекаККМ,
	ВТМаксимальныеДаты.Дата КАК Дата
ПОМЕСТИТЬ ЧекиФискальныеОперации
ИЗ
	ВТМаксимальныеДаты КАК ВТМаксимальныеДаты
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК РегистрСведений
		ПО ВТМаксимальныеДаты.ДокументОснование = РегистрСведений.ДокументОснование
			И ВТМаксимальныеДаты.Дата = РегистрСведений.Дата
;
ВЫБРАТЬ
	ДокументКассовоеВыбытие.Ссылка,
	ДокументКассовоеВыбытие.ВерсияДанных,
	ДокументКассовоеВыбытие.ПометкаУдаления,
	ДокументКассовоеВыбытие.Номер,
	ДокументКассовоеВыбытие.Дата,
	ДокументКассовоеВыбытие.Проведен,
	ДокументКассовоеВыбытие.Организация,
	ДокументКассовоеВыбытие.ИФО,
	ДокументКассовоеВыбытие.ЛицевойСчет,
	ДокументКассовоеВыбытие.Контрагент,
	ДокументКассовоеВыбытие.СуммаДокумента,
	ДокументКассовоеВыбытие.Договор,
	ДокументКассовоеВыбытие.ВалютаДокумента,
	ДокументКассовоеВыбытие.Курс,
	ДокументКассовоеВыбытие.Кратность,
	ДокументКассовоеВыбытие.СуммаДокументаВВалюте,
	ДокументКассовоеВыбытие.СчетКонтрагента,
	ДокументКассовоеВыбытие.Комментарий,
	ДокументКассовоеВыбытие.НазначениеПлатежа,
	ДокументКассовоеВыбытие.НомерПервичногоДокумента,
	ДокументКассовоеВыбытие.ДатаПервичногоДокумента,
	ДокументКассовоеВыбытие.ВидПервичногоДокумента,
	ДокументКассовоеВыбытие.ПолучательПлатежа,
	ДокументКассовоеВыбытие.Подразделение,
	ДокументКассовоеВыбытие.НалогСборПлатеж,
	ДокументКассовоеВыбытие.ИДИсточника,
	ВЫБОР
		КОГДА ДокументКассовоеВыбытие.НомерЧекаККМ &gt; 0
				ИЛИ ЧекиФискальныеОперации.НомерЧекаККМ &gt; 0
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробитый)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.ПустаяСсылка)
	КОНЕЦ КАК СтатусЧекаККМ,
	ВЫБОР
		КОГДА ДокументКассовоеВыбытие.НомерЧекаККМ = 0
			ТОГДА ЧекиФискальныеОперации.НомерЧекаККМ
		ИНАЧЕ ДокументКассовоеВыбытие.НомерЧекаККМ
	КОНЕЦ КАК НомерФД,
	ДокументКассовоеВыбытие.Ответственный,
	ДокументКассовоеВыбытие.РасшифровкаПлатежа.(
		Ссылка,
		НомерСтроки,
		ИсточникСредств,
		КБКНазначениеПлатежа,
		КОСГУНазначениеПлатежа,
		СуммаВал,
		Сумма,
		КодЦели,
		КодМероприятия,
		ДопКлассификация,
		Примечание
	),
	ДокументКассовоеВыбытие.МоментВремени,
	ОперацииДокументов.Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
