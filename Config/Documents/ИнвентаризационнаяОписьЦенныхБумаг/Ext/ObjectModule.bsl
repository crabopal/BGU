#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив();
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ЭтотОбъект, Отказ);

	Документы.ИнвентаризационнаяОписьЦенныхБумаг.ПроверитьЗаполнениеРаздела1(ЭтотОбъект, Отказ,
		НепроверяемыеРеквизиты);
	
	Документы.ИнвентаризационнаяОписьЦенныхБумаг.ПроверитьЗаполнениеРаздела21(ЭтотОбъект, Отказ,
		НепроверяемыеРеквизиты);
	
	Документы.ИнвентаризационнаяОписьЦенныхБумаг.ПроверитьЗаполнениеРаздела22(ЭтотОбъект, Отказ,
		НепроверяемыеРеквизиты);
	
	Документы.ИнвентаризационнаяОписьЦенныхБумаг.ПроверитьЗаполнениеРаздела3(ЭтотОбъект, Отказ,
		НепроверяемыеРеквизиты);

	Документы.ИнвентаризационнаяОписьЦенныхБумаг.ПроверитьЗаполнениеРаздела4(ЭтотОбъект, Отказ,
		НепроверяемыеРеквизиты);

	НепроверяемыеРеквизиты.Добавить("СоставКомиссииРаздел2.ПричинаОтсутствия");
	НепроверяемыеРеквизиты.Добавить("СоставКомиссииРаздел4.ПричинаОтсутствия");
	
	ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ЭтотОбъект, Отказ,
		"СоставКомиссииРаздел2", НСтр("ru='Подписание раздела 2'"));
	ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ЭтотОбъект, Отказ,
		"СоставКомиссииРаздел4", НСтр("ru='Подписание раздела 4'"));
	
	ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ЭтотОбъект, Отказ, 
		"ОтветственныйИсполнитель", "СоставКомиссииРаздел2");
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ЭтотОбъект, Отказ);
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
