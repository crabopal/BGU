Функция ПропуститьПроверкуОбъяснениеРаздел3(ИмяРеквизита, СтрокаТаблицы, ПроверкаИзФормы)
	ПропуститьПроверку = ИмяРеквизита = "Объяснение" И ((СтрокаТаблицы.КоличествоИзлишкиНеПодтверждено = 0
		И СтрокаТаблицы.КоличествоНедостачаНеПодтверждено = 0) Или ПроверкаИзФормы);
	Возврат ПропуститьПроверку;
КонецФункции

#Область ЗаполнениеРаздела1

Функция ПараметрыЗаполненияРаздел1() Экспорт
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("ВидЦенныхБумаг", Перечисления.ВидыЦенныхБумаг.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("ФормаЦенныхБумаг", Перечисления.ФормаЦенныхБумаг.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("ДатаИнвентаризации", Дата(1,1,1));
	ПараметрыЗаполнения.Вставить("КФО", Перечисления.КВД.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("Счет", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("ИФО", Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("Подразделение", Справочники.Подразделения.ПустаяСсылка());
	Возврат ПараметрыЗаполнения;
КонецФункции

// Формирует таблицу с данными раздела 1 по данным бухучета
//
// Параметры:
//  ПараметрыЗаполнения - Структура - см. ПараметрыЗаполненияРаздел1() 
//
// Возвращаемое значение:
//   ТаблицаЗначений
//
Функция ТаблицаРаздела1(ПараметрыЗаполнения) Экспорт
	
	ТаблицаРаздела1 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(
		Метаданные.Документы.ИнвентаризационнаяОписьЦенныхБумаг.ТабличныеЧасти.Раздел1);
	
	Период = НачалоДня(ПараметрыЗаполнения.ДатаИнвентаризации);
	ГраницаОстатка = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков(Период);
	ДатаСреза = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(Период);
	СчетаЗаполнения = СчетаЗаполнения(ПараметрыЗаполнения, ДатаСреза);
	Если СчетаЗаполнения.Количество() = 0 Тогда
		Возврат ТаблицаРаздела1;		
	КонецЕсли;	
	
	ДатаКурса = НачалоДня(ПараметрыЗаполнения.ДатаИнвентаризации);
	ВалютаРуб = ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	КурсыВалют = Новый Соответствие;
	КурсРубля = Новый Структура("Валюта, Курс, Кратность", ВалютаРуб, 1, 1);
	КурсыВалют.Вставить(ВалютаРуб, КурсРубля);
	СуммаПоОстатку = ПараметрыЗаполнения.ВидЦенныхБумаг = Перечисления.ВидыЦенныхБумаг.Акция;
	Счет31 = БухгалтерскийУчет.СписокСчетов("31", ДатаСреза, , ПараметрыЗаполнения.Организация);
	ОтдельныйЗапросОстатка = ПараметрыЗаполнения.ВидЦенныхБумаг = Перечисления.ВидыЦенныхБумаг.Акция
		И Не БухгалтерскийУчет.СчетВИерархии(СчетаЗаполнения[0], "31"); 

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГраницаОстатка", ГраницаОстатка);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Организация", ПараметрыЗаполнения.Организация);
	Запрос.УстановитьПараметр("СчетаЗаполнения", СчетаЗаполнения);
	Запрос.УстановитьПараметр("Счет31", Счет31);
	Запрос.УстановитьПараметр("ОтдельныйЗапросОстатка", ОтдельныйЗапросОстатка);
	Запрос.УстановитьПараметр("ВалютаРуб", ВалютаРуб);
	Запрос.УстановитьПараметр("Документарные",
		ПараметрыЗаполнения.ФормаЦенныхБумаг = Перечисления.ФормаЦенныхБумаг.Документарная);
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОбъектыФинансовыхВложений);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	
	ТекстЗапроса = ТекстЗапросаТаблицаРаздела1();
	
	Если ЗначениеЗаполнено(ПараметрыЗаполнения.КФО) Тогда
		УсловиеКФО = "КФО = &КФО";
		Запрос.УстановитьПараметр("КФО", ПараметрыЗаполнения.КФО);
	Иначе
		УсловиеКФО = "ИСТИНА";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеКФО", УсловиеКФО);
	
	ЕстьОтборПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ПараметрыЗаполнения.ИФО);
	Если ЕстьОтборПоИФО Тогда
		УсловиеИФО = "ИФО = &ИФО";
		Запрос.УстановитьПараметр("ИФО", ПараметрыЗаполнения.ИФО);
	Иначе
		УсловиеИФО = "ИСТИНА";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеИФО", УсловиеИФО);
	
	ЕстьОтборПодразделения = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И ЗначениеЗаполнено(ПараметрыЗаполнения.Подразделение);
	Если ЕстьОтборПодразделения Тогда
		УсловиеПодразделения = "ЕСТЬNULL(Подразделения.Ссылка, &Подразделение) = &Подразделение";
		Запрос.УстановитьПараметр("Подразделение", ПараметрыЗаполнения.Подразделение);
	Иначе
		УсловиеПодразделения = "ИСТИНА";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПодразделения", УсловиеПодразделения);

	Запрос.Текст = ТекстЗапроса;
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаРаздела1 = ТаблицаРаздела1.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела1, Выборка);
		
		Если Не ЗначениеЗаполнено(СтрокаРаздела1.КодЦеннойБумаги) Тогда
			СтрокаРаздела1.КодЦеннойБумаги = Выборка.РНФИ;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.Серия) И Не ЗначениеЗаполнено(Выборка.Номер) Тогда
			СтрокаРаздела1.Серия = Выборка.РегистрационныйНомер;
			СтрокаРаздела1.Номер = "";
		Иначе
			ДобавитьРазделительНомера(СтрокаРаздела1.Номер);
		КонецЕсли;
		
		КурсВалюты = КурсыВалют[Выборка.Валюта];
		Если КурсВалюты = Неопределено Тогда
			КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Выборка.Валюта, ДатаКурса);
			КурсыВалют.Вставить(Выборка.Валюта, КурсВалюты);
		КонецЕсли;
		
		СтрокаРаздела1.Курс = КурсВалюты.Курс;
		СтрокаРаздела1.Кратность = КурсВалюты.Кратность;
		
		СуммаПоНоминалу = Окр(СтрокаРаздела1.Номинал * СтрокаРаздела1.Количество, 2);
		Если СуммаПоОстатку Тогда
			СуммаБУ = ?(Выборка.Валюта = ВалютаРуб, Выборка.СуммаБУРуб, Выборка.СуммаБУВал);
			Если СуммаПоНоминалу <> СуммаБУ Тогда
				СтрокаРаздела1.Номинал = ?(СтрокаРаздела1.Количество = 0, 0, СуммаБУ / СтрокаРаздела1.Количество);
			КонецЕсли;
			СуммаПоНоминалу = СуммаБУ;
		КонецЕсли;
		
		Если Выборка.Валюта = ВалютаРуб Тогда
			СтрокаРаздела1.СуммаВал = 0;
			СтрокаРаздела1.СуммаРуб = СуммаПоНоминалу;
		Иначе
			СтрокаРаздела1.СуммаВал = СуммаПоНоминалу;
			СтрокаРаздела1.СуммаРуб = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(СтрокаРаздела1.СуммаВал,
				КурсВалюты, КурсРубля);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаРаздела1;
КонецФункции

Процедура ДобавитьРазделительНомера(Номер) Экспорт
	Разделитель = "//";
	Если Не ЗначениеЗаполнено(Номер) Или СтрНайти(Номер, Разделитель) > 0 Тогда
		Возврат;
	КонецЕсли;
	Номер = СтрШаблон("%1%2-", Номер, Разделитель);
КонецПроцедуры

Функция ТекстЗапросаТаблицаРаздела1()

	Возврат
		"ВЫБРАТЬ
		|	ОбъектыФинансовыхВложений.Ссылка КАК ЦеннаяБумага,
		|	ЕСТЬNULL(Валюты.Ссылка, &ВалютаРуб) КАК Валюта,
		|	СУММА(ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстаток, 0)) КАК СуммаБУВал,
		|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстаток) КАК СуммаБУРуб
		|ПОМЕСТИТЬ ВТБухОстаток
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ГраницаОстатка, Счет В (&СчетаЗаполнения), &ВидыСубконто,
		|		Организация = &Организация
		|	И &УсловиеИФО
		|	И &УсловиеКФО) КАК ЖурналПроводокЕПСБУОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыФинансовыхВложений КАК ОбъектыФинансовыхВложений
		|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = ОбъектыФинансовыхВложений.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
		|		ПО ЖурналПроводокЕПСБУОстатки.Валюта = Валюты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Подразделения КАК Подразделения
		|		ПО ЖурналПроводокЕПСБУОстатки.Подразделение = Подразделения.Ссылка
		|ГДЕ
		|	ОбъектыФинансовыхВложений.Документарные = &Документарные
		|	И &УсловиеПодразделения
		|СГРУППИРОВАТЬ ПО
		|	ОбъектыФинансовыхВложений.Ссылка,
		|	ЕСТЬNULL(Валюты.Ссылка, &ВалютаРуб)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОбъектыФинансовыхВложений.Ссылка КАК ЦеннаяБумага,
		|	ЕСТЬNULL(Валюты.Ссылка, &ВалютаРуб) КАК Валюта,
		|	СУММА(ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстаток, 0)) КАК СуммаБУВал,
		|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстаток) КАК СуммаБУРуб
		|ПОМЕСТИТЬ ВТБухОстаток31
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ГраницаОстатка, Счет В (&Счет31), &ВидыСубконто,
		|		Организация = &Организация
		|	И &УсловиеИФО
		|	И &УсловиеКФО) КАК ЖурналПроводокЕПСБУОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыФинансовыхВложений КАК ОбъектыФинансовыхВложений
		|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = ОбъектыФинансовыхВложений.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
		|		ПО ЖурналПроводокЕПСБУОстатки.Валюта = Валюты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Подразделения КАК Подразделения
		|		ПО ЖурналПроводокЕПСБУОстатки.Подразделение = Подразделения.Ссылка
		|ГДЕ
		|	ОбъектыФинансовыхВложений.Документарные = &Документарные
		|	И &УсловиеПодразделения
		|	И &ОтдельныйЗапросОстатка
		|СГРУППИРОВАТЬ ПО
		|	ОбъектыФинансовыхВложений.Ссылка,
		|	ЕСТЬNULL(Валюты.Ссылка, &ВалютаРуб)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЦенныеБумагиОстатки.Организация КАК Организация,
		|	ЦенныеБумагиОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦенныеБумагиОстатки.КоличествоОстаток КАК Количество
		|ПОМЕСТИТЬ ВТКоличествоЦБ
		|ИЗ
		|	РегистрНакопления.ЦенныеБумаги.Остатки(&Период, Организация = &Организация
		|	И ЦеннаяБумага В
		|		(ВЫБРАТЬ
		|			ВТБухОстаток.ЦеннаяБумага
		|		ИЗ
		|			ВТБухОстаток КАК ВТБухОстаток)) КАК ЦенныеБумагиОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОбъектыФинансовыхВложений.Ссылка КАК ЦеннаяБумага,
		|	ОбъектыФинансовыхВложений.КодЦеннойБумаги КАК КодЦеннойБумаги,
		|	ОбъектыФинансовыхВложений.РНФИ КАК РНФИ,
		|	ОбъектыФинансовыхВложений.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ОбъектыФинансовыхВложений.РегистрационныйНомер КАК РегистрационныйНомер,
		|	ОбъектыФинансовыхВложений.Серия КАК Серия,
		|	ОбъектыФинансовыхВложений.Номер КАК Номер,
		|	ОбъектыФинансовыхВложений.НоминальнаяСтоимость КАК Номинал,
		|	ВТБухОстаток.Валюта КАК Валюта,
		|	ЕСТЬNULL(ВТКоличествоЦБ.Количество, 0) КАК Количество,
		|	ВЫБОР
		|		КОГДА &ОтдельныйЗапросОстатка
		|			ТОГДА ЕСТЬNULL(ВТБухОстаток31.СуммаБУВал, 0)
		|		ИНАЧЕ ВТБухОстаток.СуммаБУВал
		|	КОНЕЦ КАК СуммаБУВал,
		|	ВЫБОР
		|		КОГДА &ОтдельныйЗапросОстатка
		|			ТОГДА ЕСТЬNULL(ВТБухОстаток31.СуммаБУРуб, 0)
		|		ИНАЧЕ ВТБухОстаток.СуммаБУРуб
		|	КОНЕЦ КАК СуммаБУРуб
		|ИЗ
		|	ВТБухОстаток КАК ВТБухОстаток
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыФинансовыхВложений КАК ОбъектыФинансовыхВложений
		|		ПО ВТБухОстаток.ЦеннаяБумага = ОбъектыФинансовыхВложений.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКоличествоЦБ КАК ВТКоличествоЦБ
		|		ПО ВТБухОстаток.ЦеннаяБумага = ВТКоличествоЦБ.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТБухОстаток31 КАК ВТБухОстаток31
		|		ПО &ОтдельныйЗапросОстатка
		|		И ВТБухОстаток.ЦеннаяБумага = ВТБухОстаток31.ЦеннаяБумага
		|		И ВТБухОстаток.Валюта = ВТБухОстаток31.Валюта
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОбъектыФинансовыхВложений.Наименование";
	
КонецФункции

#КонецОбласти

// Возвращает массив счетов заполнения с учетом установленных отборов
//
// Параметры:
//  ПараметрыЗаполнения - Структура - см. ПараметрыЗаполненияРаздел1()
//  НаДату - Дата
//
// Возвращаемое значение:
//   Массив из ПланСчетовСсылка.ЕПСБУ 
//
Функция СчетаЗаполнения(ПараметрыЗаполнения, НаДату)
	
	СчетаЗаполнения = Новый Массив;
	
	ДопустимыеСчета = Перечисления.ВидыЦенныхБумаг.ДопустимыеСчетаПоВидуЦеннойБумаги(ПараметрыЗаполнения.ВидЦенныхБумаг,
		НаДату, ПараметрыЗаполнения.Организация);
	ЗаданныеСчета = БухгалтерскийУчет.СписокСчетов(ПараметрыЗаполнения.Счет, НаДату, , ПараметрыЗаполнения.Организация);
	
	Для Каждого Элемент Из ЗаданныеСчета Цикл
		Если ДопустимыеСчета.Найти(Элемент) <> Неопределено Тогда
			СчетаЗаполнения.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СчетаЗаполнения;	
КонецФункции

#Область УсловноеОформление

Процедура УстановитьУсловноеОформления(Форма) Экспорт
	
	УсловноеОформление = Форма.УсловноеОформление;

	УстановитьУсловноеОформлениеРаздел1(УсловноеОформление);
	УстановитьУсловноеОформлениеРаздел21(УсловноеОформление);
	УстановитьУсловноеОформлениеРаздел22(УсловноеОформление);
	УстановитьУсловноеОформлениеРаздел3(УсловноеОформление);
	УстановитьУсловноеОформлениеРаздел4(УсловноеОформление);

	ИнвентаризацияСервер.ДобавитьУсловноеОформлениеСоставКомиссииПричинаОтсутствия(Форма, "СоставКомиссииРаздел2");
	ИнвентаризацияСервер.ДобавитьУсловноеОформлениеСоставКомиссииПричинаОтсутствия(Форма, "СоставКомиссииРаздел4");
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеРаздел1(УсловноеОформление)

	// отметка незаполненного
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел1Серия");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	
		"Объект.Раздел1.Номер", ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел1Номер");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	
		"Объект.Раздел1.Серия", ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеРаздел21(УсловноеОформление)

	// данные раздела 1
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел21НомерСтроки");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел21ЦеннаяБумага");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел21КодЦеннойБумаги");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел21ЕдиницаИзмерения");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	
		"Объект.Раздел21.ДанныеРаздела1", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);

	// отметка незаполненного
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел21Серия");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел21Номер");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел21Валюта");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел21Курс");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	
		"Объект.Раздел21.Количество", ВидСравненияКомпоновкиДанных.Равно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел21Серия");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	
		"Объект.Раздел21.Номер", ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел21Номер");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	
		"Объект.Раздел21.Серия", ВидСравненияКомпоновкиДанных.Заполнено);
