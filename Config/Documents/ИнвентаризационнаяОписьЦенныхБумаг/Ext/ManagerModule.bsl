Процедура ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, Постфикс)
	ВалютаРегламентированногоУчетаКод = ДополнительныеПараметры.ВалютаРегламентированногоУчетаКод;
	ЗначенияИсточника = Новый Структура("ВалютаКод" + Постфикс);
	ЗаполнитьЗначенияСвойств(ЗначенияИсточника, Выборка);
	Если ЗначенияИсточника["ВалютаКод" + Постфикс] = ВалютаРегламентированногоУчетаКод Тогда
		ЗначенияПараметров.Вставить("Курс" + Постфикс, "");
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьКодСтатусаНеСоответствует(ЗначенияПараметров, Выборка, ДополнительныеПараметры)
	ЗначенияИсточника = Новый Структура("СтатусНеСоответствуетКод");
	ЗаполнитьЗначенияСвойств(ЗначенияИсточника, Выборка);
	Если ЗначениеЗаполнено(ЗначенияИсточника.СтатусНеСоответствуетКод) Тогда
		ЗначенияПараметров.Вставить("СтатусНеСоответствуетКод",
			ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ЗначенияИсточника.СтатусНеСоответствуетКод, Истина));
	КонецЕсли;
КонецПроцедуры

Функция ДанныеДляПечати0510470(МассивОбъектов)
	
	НомераТаблиц = Новый Структура;
	ТекстЗапроса = ТекстЗапросаПечать0510470(НомераТаблиц); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = ТекстЗапроса;
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	ДанныеДляПечати = Новый Структура;
	ДанныеДляПечати.Вставить("СоставКомиссииРаздел2", 
		ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов, "СоставКомиссииРаздел2"));
	ДанныеДляПечати.Вставить("СоставКомиссииРаздел4", 
		ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов, "СоставКомиссииРаздел4"));
	ДанныеДляПечати.Вставить("СведенияУчреждений", 
		УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов));

	ДанныеДляПечати.Вставить("Выборки", Новый Структура);
	Выборки = ДанныеДляПечати.Выборки;
	Выборки.Вставить("Шапка", РезультатЗапроса[НомераТаблиц.Шапка].Выбрать());
	Выборки.Вставить("Раздел1", РезультатЗапроса[НомераТаблиц.Раздел1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Выборки.Вставить("Раздел21", 
		РезультатЗапроса[НомераТаблиц.Раздел21].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Выборки.Вставить("Раздел22",
		РезультатЗапроса[НомераТаблиц.Раздел22].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Выборки.Вставить("Раздел3",	РезультатЗапроса[НомераТаблиц.Раздел3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Выборки.Вставить("Раздел4",	РезультатЗапроса[НомераТаблиц.Раздел4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция ТекстЗапросаПечать0510470(НомераТаблиц)
	
	НомераТаблиц.Вставить("Шапка", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Раздел1", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Раздел21", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Раздел22", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Раздел3", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Раздел4", НомераТаблиц.Количество());
	
