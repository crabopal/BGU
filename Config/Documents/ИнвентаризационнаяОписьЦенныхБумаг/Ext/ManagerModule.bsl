Функция ПропуститьПроверкуНомера(ИмяРеквизита, СтрокаТаблицы, НастройкаПроверкиНомера)
	ПропуститьПроверкуНомера = Истина;
	РеквизитПроверки = НастройкаПроверкиНомера[ИмяРеквизита];
	Если РеквизитПроверки <> Неопределено Тогда
		РеквизитНомер = РеквизитПроверки.Номер;
		РеквизитКоличество = РеквизитПроверки.Количество;
		ПропуститьПроверкуНомера = СтрокаТаблицы[РеквизитКоличество] > 0 
			И Не ЗначениеЗаполнено(СтрокаТаблицы[РеквизитНомер]);
	КонецЕсли;
	Возврат ПропуститьПроверкуНомера;
