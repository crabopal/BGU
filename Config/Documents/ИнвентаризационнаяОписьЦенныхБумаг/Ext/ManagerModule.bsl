Процедура ВывестиПодписьИсполнителяРаздела1(ТабДокумент, ВыборкаШапка, ОбластиМакета)
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(
		ВыборкаШапка.ОтветственныйИсполнительБухгалтерскойСлужбы, ВыборкаШапка.Дата);

	ОбластьОтветственныйИсполнитель = ОбластиМакета.ОтветственныйИсполнительРаздела1;
	ОбластьДатаПодписи = ОбластиМакета.ДатаПодписиРаздела1;
	
	ОбластьОтветственныйИсполнитель.Параметры.Заполнить(ЗначенияПараметров);
	
	ОформляющиеОбласти = Новый Массив;
	ОформляющиеОбласти.Добавить(ОбластьОтветственныйИсполнитель);
	ОформляющиеОбласти.Добавить(ОбластьДатаПодписи);
	Если Не ТабДокумент.ПроверитьВывод(ОформляющиеОбласти) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;

	ТабДокумент.Вывести(ОбластьОтветственныйИсполнитель);
	ТабДокумент.Вывести(ОбластьДатаПодписи);
	
КонецПроцедуры

Процедура ВывестиПодписьИсполнителяРаздела3(ТабДокумент, ВыборкаШапка, ОбластиМакета)
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(
		ВыборкаШапка.ОтветственноеЛицо, ВыборкаШапка.Дата);

	ОбластьОтветственноеЛицо = ОбластиМакета.ОтветственноеЛицоРаздела3;
	ОбластьДатаПодписи = ОбластиМакета.ДатаПодписиРаздела3;
	
	ОбластьОтветственноеЛицо.Параметры.Заполнить(ЗначенияПараметров);
	
	ОформляющиеОбласти = Новый Массив;
	ОформляющиеОбласти.Добавить(ОбластьОтветственноеЛицо);
	ОформляющиеОбласти.Добавить(ОбластьДатаПодписи);
	Если Не ТабДокумент.ПроверитьВывод(ОформляющиеОбласти) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;

	ТабДокумент.Вывести(ОбластьОтветственноеЛицо);
	ТабДокумент.Вывести(ОбластьДатаПодписи);
	
КонецПроцедуры

Процедура ВывестиКомиссиюИИсполнителя(ТабДокумент, ВыборкаШапка, ОбластиМакета, СоставКомиссии)
	ПараметрыВывода = УправлениеПечатьюБГУ.ПараметрыВыводаСоставаКомиссииПриПечати();
	ПараметрыВывода.ЗаголовокПредседателя = НСтр("ru='Председатель комиссии:'");
	ПараметрыВывода.ЗаголовокПервогоРядовогоЧлена = НСтр("ru='Члены комиссии:'");
	ПараметрыВывода.ПризнакРабочейКомиссии = ЗначениеЗаполнено(ВыборкаШапка.НомерРабочейКомиссии);
	ПараметрыВывода.ВыводитьДополнительныеСведения = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьПричинуОтсутствия = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьЗамещающегоСотрудника = Истина;
	УправлениеПечатьюБГУ.ВывестиСоставКомиссииПриПечати(ТабДокумент, ВыборкаШапка.Ссылка, 
		ОбластиМакета.ЧленКомиссии, СоставКомиссии, ПараметрыВывода);
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(
		ВыборкаШапка.ОтветственныйИсполнитель, ВыборкаШапка.Дата);
	Область = ОбластиМакета.ОтветственныйИсполнитель;
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода = Неопределено,
	ДополнительныеПараметры = Неопределено) Экспорт
	
	ЗаполнитьНулиВСтрокеРаздела(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры);
	
	ЗначенияПараметров = Новый Структура;
	ЗаполнитьКурсВалютыРеглУчетаПриПечатиВСтрокеРаздела(ЗначенияПараметров, Выборка, ДополнительныеПараметры);
	ЗаполнитьКодСтатусаНеСоответствует(ЗначенияПараметров, Выборка, ДополнительныеПараметры);
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, 
		ДополнительныеПараметры.ПрочеркиПустыхПолей, ДополнительныеПараметры.КлючНабораПолей);
	
КонецПроцедуры

Процедура ЗаполнитьНулиВСтрокеРаздела(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры)
	КлючНабораПолей = ДополнительныеПараметры.КлючНабораПолей;
	ОбластиЗаполнения = Новый Массив;
	Если КлючНабораПолей = "ПоляСтрокиРаздела4_2" И Не ДополнительныеПараметры.НетОтклоненийИНеСоответствий Тогда
		ОбластьСтрокаТаблицы = ДополнительныеПараметры.ОбластиМакета.Раздел4Строка_2.ПолучитьОбласть();
		Если Выборка.КоличествоИзлишкиНеПодтверждено = 0 Тогда
			ОбластиЗаполнения.Добавить("Раздел4СтрокаИзлишки");
		КонецЕсли;
		Если Выборка.КоличествоНедостачаНеПодтверждено = 0 Тогда
			ОбластиЗаполнения.Добавить("Раздел4СтрокаНедостача");
		КонецЕсли;
		ЗаполнитьНулиВОбласти(ОбластьСтрокаТаблицы, ОбластиЗаполнения);
		ОбластьСтрокаТаблицы.Параметры.Заполнить(Выборка);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьНулиВОбласти(Знач ОбластьСтрокаТаблицы, ОбластиЗаполнения)
	Для Каждого ИмяОбласти Из ОбластиЗаполнения Цикл
		ОбластьЗаполнения = ОбластьСтрокаТаблицы.Область(ИмяОбласти);
		ОбластьЗаполнения.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Текст;
		ОбластьЗаполнения.Текст = "0";
		ОбластьЗаполнения.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьКурсВалютыРеглУчетаПриПечатиВСтрокеРаздела(ЗначенияПараметров, Выборка, ДополнительныеПараметры)
	КлючНабораПолей = ДополнительныеПараметры.КлючНабораПолей;
	Если КлючНабораПолей = "ПоляСтрокиРаздела1" Тогда
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, "");
	ИначеЕсли КлючНабораПолей = "ПоляСтрокиРаздела21_1" Тогда
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, "");
	ИначеЕсли КлючНабораПолей = "ПоляСтрокиРаздела21_2" Тогда
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, "НеСоответствует");
	ИначеЕсли КлючНабораПолей = "ПоляСтрокиРаздела22_1" Тогда
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, "НеСоответствует");
	ИначеЕсли КлючНабораПолей = "ПоляСтрокиРаздела22_2" Тогда
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, "Излишки");
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, "Недостача");
	ИначеЕсли КлючНабораПолей = "ПоляСтрокиРаздела3_1" Тогда
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, "Излишки");
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, "Недостача");
	ИначеЕсли КлючНабораПолей = "ПоляСтрокиРаздела3_2" Тогда
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, 
			"ИзлишкиПодтверждено");
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, 
			"НедостачаПодтверждено");
	ИначеЕсли КлючНабораПолей = "ПоляСтрокиРаздела3_3" Тогда
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, 
			"ИзлишкиНеПодтверждено");
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, 
			"НедостачаНеПодтверждено");
	ИначеЕсли КлючНабораПолей = "ПоляСтрокиРаздела4_1" Тогда
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, "НеСоответствует");
	ИначеЕсли КлючНабораПолей = "ПоляСтрокиРаздела4_2" Тогда
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, 
			"ИзлишкиНеПодтверждено");
		ЗаполнитьКурсВалютыРеглУчетаПриПечати(ЗначенияПараметров, Выборка, ДополнительныеПараметры, 
			"НедостачаНеПодтверждено");
	КонецЕсли;
