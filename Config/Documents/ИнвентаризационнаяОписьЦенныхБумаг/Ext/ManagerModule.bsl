	Если ЗначениеЗаполнено(КФО) Тогда
		ЧастиСчета.Добавить(КФО);
	ИначеЕсли Не СчетЗабалансовый Тогда
		ЧастиСчета.Добавить("0");
	КонецЕсли;
	ЧастиСчета.Добавить(СчетКод);
	Если Не СчетЗабалансовый Тогда
		ЧастиСчета.Добавить("000");
	КонецЕсли;
	КодСчета = СтрСоединить(ЧастиСчета, Разделитель);
	КодСчета = СтрЗаменить(КодСчета, ".", Разделитель);
	Возврат КодСчета;
КонецФункции

