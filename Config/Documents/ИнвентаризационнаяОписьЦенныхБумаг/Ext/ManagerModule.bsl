КонецПроцедуры

Процедура ПроверитьЗаполнениеРаздела4(ДокументОбъектИлиФорма, Отказ, НепроверяемыеРеквизиты,
	ПроверкаИзФормы = Ложь) Экспорт

	ИмяТабличнойЧасти = "Раздел4";
	ИмяСписка = НСтр("ru = 'Раздел 4'");

	ПроверитьЗаполнениеРаздела(ДокументОбъектИлиФорма, ИмяТабличнойЧасти, ИмяСписка, Отказ,
		НепроверяемыеРеквизиты, ПроверкаИзФормы);
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеРаздела(ДокументОбъектИлиФорма, ИмяТабличнойЧасти, ИмяСписка, Отказ,
	НепроверяемыеРеквизиты, ПроверкаИзФормы)
	
	Если ПроверкаИзФормы Тогда
		Объект = ДокументОбъектИлиФорма.Объект;
		Форма = ДокументОбъектИлиФорма;
	Иначе
		Объект = ДокументОбъектИлиФорма;
	КонецЕсли;
	
	Таблица = Объект[ИмяТабличнойЧасти];
	МетаданныеРеквизитов = Метаданные.Документы.ИнвентаризационнаяОписьЦенныхБумаг
		.ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты;
	
	ИменаРеквизитов = Новый Массив;
	СинонимыРеквизитов = Новый Структура;
	Для Каждого Реквизит Из МетаданныеРеквизитов Цикл
		Если Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку Тогда
			НепроверяемыеРеквизиты.Добавить(СтрШаблон("%1.%2", ИмяТабличнойЧасти, Реквизит.Имя));	
			ИменаРеквизитов.Добавить(Реквизит.Имя);
			СинонимыРеквизитов.Вставить(Реквизит.Имя, МетаданныеРеквизитов[Реквизит.Имя].Синоним);
		КонецЕсли;
	КонецЦикла;
	
	НастройкаПроверкиПоКоличеству = НастройкаПроверкиПоКоличеству(ИмяТабличнойЧасти);
	НастройкаПроверкиПоОтметке = НастройкаПроверкиПоОтметке(ИмяТабличнойЧасти);
	НастройкаПроверкиСерияНомер = НастройкаПроверкиСерияНомер(ИмяТабличнойЧасти);
	НастройкаПроверкиНомера = НастройкаПроверкиНомера(ИмяТабличнойЧасти);
	
	ВидСообщения = "";
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		ПроверитьТолькоЗаключениеКомиссии = ИмяТабличнойЧасти = "Раздел4" И Не Объект.ВыявленыНесоответствия
			И Не Объект.ВыявленыОтклонения;
		НеПроверятьЗаключениеКомиссии = ИмяТабличнойЧасти = "Раздел4" И ПроверкаИзФормы;
		
		Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
			
			Если ПроверитьТолькоЗаключениеКомиссии И ИмяРеквизита <> "ЗаключениеКомиссии" Тогда
				Продолжить;
			КонецЕсли;
			
			Если НеПроверятьЗаключениеКомиссии И (ИмяРеквизита = "ЗаключениеКомиссии"
				Или ИмяРеквизита = "СтатусОбъяснения") Тогда
				Продолжить;
			КонецЕсли;
			
			Если ПропуститьПроверкуКоличествоНеЗаполнено(ИмяРеквизита, СтрокаТаблицы,
				НастройкаПроверкиПоКоличеству) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ПропуститьПроверкуСерияНомер(ИмяРеквизита, СтрокаТаблицы, НастройкаПроверкиСерияНомер)
				И ПропуститьПроверкуНомера(ИмяРеквизита, СтрокаТаблицы, НастройкаПроверкиНомера) Тогда 
				Продолжить;
			КонецЕсли;
			
			Если ПропуститьПроверкуНетОтметки(ИмяРеквизита, СтрокаТаблицы, НастройкаПроверкиПоОтметке) Тогда
				Продолжить;
			КонецЕсли;

			Если ПропуститьПроверкуОбъяснениеРаздел3(ИмяРеквизита, СтрокаТаблицы, ПроверкаИзФормы) Тогда
				Продолжить;
			КонецЕсли;

			Если Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяРеквизита]) Тогда
				
				СинонимРеквизита = СинонимыРеквизитов[ИмяРеквизита];
				ВидСообщения = "Заполнение";
				
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", ВидСообщения,
					СинонимРеквизита, СтрокаТаблицы.НомерСтроки, ИмяСписка);
					
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки,
					ИмяРеквизита);
				Если ПроверкаИзФормы Тогда
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Форма.РеквизитФормыВЗначение("Объект"),
						Поле, "Объект", Отказ);
				Иначе
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект, Поле, "Объект", Отказ);
				КонецЕсли;		
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция НастройкаПроверкиПоКоличеству(ИмяТабличнойЧасти)
	НастройкаПроверкиПоКоличеству = Новый Соответствие;
	
	Если ИмяТабличнойЧасти = "Раздел21" Тогда
		
		НастройкаПроверкиПоКоличеству.Вставить("Серия", "Количество");
		НастройкаПроверкиПоКоличеству.Вставить("Номер", "Количество");
		НастройкаПроверкиПоКоличеству.Вставить("Валюта", "Количество");
		НастройкаПроверкиПоКоличеству.Вставить("Курс", "Количество");
		
	ИначеЕсли ИмяТабличнойЧасти = "Раздел22" Тогда

		НастройкаПроверкиПоКоличеству.Вставить("СерияНеСоответствует", "КоличествоНеСоответствует");
		НастройкаПроверкиПоКоличеству.Вставить("НомерНеСоответствует", "КоличествоНеСоответствует");
		НастройкаПроверкиПоКоличеству.Вставить("ВалютаНеСоответствует", "КоличествоНеСоответствует");
		НастройкаПроверкиПоКоличеству.Вставить("КурсНеСоответствует", "КоличествоНеСоответствует");
		НастройкаПроверкиПоКоличеству.Вставить("СтатусНеСоответствует", "КоличествоНеСоответствует");

		НастройкаПроверкиПоКоличеству.Вставить("СерияИзлишки", "КоличествоИзлишки");
		НастройкаПроверкиПоКоличеству.Вставить("НомерИзлишки", "КоличествоИзлишки");
		НастройкаПроверкиПоКоличеству.Вставить("ВалютаИзлишки", "КоличествоИзлишки");
		НастройкаПроверкиПоКоличеству.Вставить("КурсИзлишки", "КоличествоИзлишки");

		НастройкаПроверкиПоКоличеству.Вставить("СерияНедостача", "КоличествоНедостача");
		НастройкаПроверкиПоКоличеству.Вставить("НомерНедостача", "КоличествоНедостача");
		НастройкаПроверкиПоКоличеству.Вставить("ВалютаНедостача", "КоличествоНедостача");
		НастройкаПроверкиПоКоличеству.Вставить("КурсНедостача", "КоличествоНедостача");

	ИначеЕсли ИмяТабличнойЧасти = "Раздел3" Тогда

		НастройкаПроверкиПоКоличеству.Вставить("СерияИзлишки", "КоличествоИзлишки");
		НастройкаПроверкиПоКоличеству.Вставить("НомерИзлишки", "КоличествоИзлишки");
		НастройкаПроверкиПоКоличеству.Вставить("ВалютаИзлишки", "КоличествоИзлишки");
		НастройкаПроверкиПоКоличеству.Вставить("КурсИзлишки", "КоличествоИзлишки");

		НастройкаПроверкиПоКоличеству.Вставить("СерияНедостача", "КоличествоНедостача");
		НастройкаПроверкиПоКоличеству.Вставить("НомерНедостача", "КоличествоНедостача");
		НастройкаПроверкиПоКоличеству.Вставить("ВалютаНедостача", "КоличествоНедостача");
		НастройкаПроверкиПоКоличеству.Вставить("КурсНедостача", "КоличествоНедостача");

		НастройкаПроверкиПоКоличеству.Вставить("СерияИзлишкиПодтверждено", "КоличествоИзлишкиПодтверждено");
		НастройкаПроверкиПоКоличеству.Вставить("НомерИзлишкиПодтверждено", "КоличествоИзлишкиПодтверждено");
		НастройкаПроверкиПоКоличеству.Вставить("ВалютаИзлишкиПодтверждено", "КоличествоИзлишкиПодтверждено");
		НастройкаПроверкиПоКоличеству.Вставить("КурсИзлишкиПодтверждено", "КоличествоИзлишкиПодтверждено");

		НастройкаПроверкиПоКоличеству.Вставить("СерияНедостачаПодтверждено", "КоличествоНедостачаПодтверждено");
		НастройкаПроверкиПоКоличеству.Вставить("НомерНедостачаПодтверждено", "КоличествоНедостачаПодтверждено");
		НастройкаПроверкиПоКоличеству.Вставить("ВалютаНедостачаПодтверждено", "КоличествоНедостачаПодтверждено");
		НастройкаПроверкиПоКоличеству.Вставить("КурсНедостачаПодтверждено", "КоличествоНедостачаПодтверждено");

		НастройкаПроверкиПоКоличеству.Вставить("СерияИзлишкиНеПодтверждено", "КоличествоИзлишкиНеПодтверждено");
		НастройкаПроверкиПоКоличеству.Вставить("НомерИзлишкиНеПодтверждено", "КоличествоИзлишкиНеПодтверждено");
		НастройкаПроверкиПоКоличеству.Вставить("ВалютаИзлишкиНеПодтверждено", "КоличествоИзлишкиНеПодтверждено");
		НастройкаПроверкиПоКоличеству.Вставить("КурсИзлишкиНеПодтверждено", "КоличествоИзлишкиНеПодтверждено");

