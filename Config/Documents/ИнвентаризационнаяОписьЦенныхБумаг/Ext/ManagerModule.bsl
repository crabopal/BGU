#Область Печать

Функция СформироватьПечатнуюФорму0510470(МассивОбъектов, ОбъектыПечати)

	КлючПараметровПечати = "ПечатьФормы0510470";
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ДанныеДляПечати = ДанныеДляПечати0510470(МассивОбъектов);
	ОбластиМакета = ОбластиМакета0510470();
	
	ВыборкаШапка = ДанныеДляПечати.Выборки.Шапка;

	Пока ВыборкаШапка.Следующий() Цикл
			
		Если ТабДокумент.ВысотаТаблицы > 0 Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НомерПервойСтроки = ТабДокумент.ВысотаТаблицы + 1;
	
		ВывестиЗаголовок(ТабДокумент, ДанныеДляПечати, ВыборкаШапка, ОбластиМакета);
		ВывестиРазделы(ТабДокумент, ДанныеДляПечати, ВыборкаШапка, ОбластиМакета);
		ВывестиКомиссиюИИсполнителя(ТабДокумент, ВыборкаШапка, ОбластиМакета, ДанныеДляПечати.СоставКомиссииРаздел4);

		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерПервойСтроки, ОбъектыПечати, 
			ВыборкаШапка.Ссылка);
			
	КонецЦикла;
	
	// Колонтитулы
	ТабДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница	= 2;
	ТабДокумент.ВерхнийКолонтитул.ТекстСправа = НСтр("ru='Форма 0510470 с.[&НомерСтраницы]'");
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиЗаголовок(ТабДокумент, ДанныеДляПечати, ВыборкаШапка, ОбластиМакета)
	ЗначенияПараметров = Новый Структура;
	
	УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, ВыборкаШапка.Ссылка, 
		ДанныеДляПечати.СведенияУчреждений);
	
	НомерДокументаДляПечати = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
		ВыборкаШапка.Ссылка, 
		ВыборкаШапка.Номер);
		
	НомерРешенияОПроведенииИнвентаризации = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
		ВыборкаШапка.РешениеОПроведенииИнвентаризации,
		ВыборкаШапка.НомерРешенияОПроведенииИнвентаризации);
	
	ТребуемыеДанные = "ДолжностьНаименование,НаименованиеПолное,Код";
	ДанныеОтветственногоЛица = Справочники.Сотрудники.ДанныеСотрудника(ВыборкаШапка.ОтветственноеЛицо, 
		ТребуемыеДанные, ВыборкаШапка.Дата);
	
	КодСчета = КодСчета(ВыборкаШапка.КФО, ВыборкаШапка.СчетКод, ВыборкаШапка.СчетЗабалансовый);
	
	ЗначенияПараметров.Вставить("Дата", ВыборкаШапка.Дата);
	ЗначенияПараметров.Вставить("Номер", НомерДокументаДляПечати);
	ЗначенияПараметров.Вставить("НомерРешения", НомерРешенияОПроведенииИнвентаризации);
	ЗначенияПараметров.Вставить("ДатаРешения", ВыборкаШапка.ДатаРешенияОПроведенииИнвентаризации);
	ЗначенияПараметров.Вставить("НомерКомиссии", ИнвентаризацияКлиентСервер.ФорматироватьПолныйНомерКомиссии(
		ВыборкаШапка.НомерКомиссии, ВыборкаШапка.НомерРабочейКомиссии, Истина));
	ЗначенияПараметров.Вставить("ОтветственноеЛицоНаименованиеИДолжность", СтрШаблон("%1 %2", 
		ДанныеОтветственногоЛица.НаименованиеПолное, ДанныеОтветственногоЛица.ДолжностьНаименование));
	ЗначенияПараметров.Вставить("УчетныйНомер",	ДанныеОтветственногоЛица.Код);
	ЗначенияПараметров.Вставить("КодСчета", КодСчета);
	
	Область = ОбластиМакета.Заголовок;
	Область.Параметры.Заполнить(ВыборкаШапка);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(ВыборкаШапка.Дата, Истина));
	
	ТабДокумент.Вывести(Область);
КонецПроцедуры

Процедура ВывестиРазделы(ТабДокумент, ДанныеДляПечати, ВыборкаШапка, ОбластиМакета)
	
	ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
	
	ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Истина;
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;

	ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = 
		"Документы.ИнвентаризационнаяОписьЦенныхБумаг.ЗаполнитьОбластьСтрокаТаблицы";

	ВалютаРегламентированногоУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ВалютаРегламентированногоУчетаКод", 
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВалютаРегламентированногоУчета, "Код"));

	ПрочеркиПустыхПолей = ПолучитьНастройкиПрочерковПустыхПолей();
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ПрочеркиПустыхПолей", ПрочеркиПустыхПолей);
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("КлючНабораПолей", "");
	КлючПолейСтрокиРаздела1 = "ПоляСтрокиРаздела1";
	КлючПолейСтрокиРаздела21_1 = "ПоляСтрокиРаздела21_1";
	КлючПолейСтрокиРаздела21_2 = "ПоляСтрокиРаздела21_2";
	КлючПолейСтрокиРаздела22_1 = "ПоляСтрокиРаздела22_1";
	КлючПолейСтрокиРаздела22_2 = "ПоляСтрокиРаздела22_2";
	КлючПолейСтрокиРаздела3_1 = "ПоляСтрокиРаздела3_1";
	КлючПолейСтрокиРаздела3_2 = "ПоляСтрокиРаздела3_2";
	КлючПолейСтрокиРаздела3_3 = "ПоляСтрокиРаздела3_3";
	КлючПолейСтрокиРаздела4_1 = "ПоляСтрокиРаздела4_1";
	КлючПолейСтрокиРаздела4_2 = "ПоляСтрокиРаздела4_2";
	
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ОбластиМакета", ОбластиМакета); 
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("НетОтклоненийИНеСоответствий",
		Не ВыборкаШапка.ВыявленыНесоответствия И Не ВыборкаШапка.ВыявленыОтклонения); 

	// РАЗДЕЛ 1

	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();

	ВыборкаРазделИтоги = ДанныеДляПечати.Выборки.Раздел1;
	ВыборкаРазделИтоги.Сбросить();
	ВыборкаРазделИтоги.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка");
	
	ПараметрыВыводаТаблицы.Области.Заголовок = ОбластиМакета.Раздел1Заголовок;
	ПараметрыВыводаТаблицы.Области.ШапкаТаблицы	= ОбластиМакета.Раздел1Шапка;
	ПараметрыВыводаТаблицы.Области.СтрокаТаблицы = ОбластиМакета.Раздел1Строка;
	ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами = ОбластиМакета.Раздел1Итого;
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.КлючНабораПолей = КлючПолейСтрокиРаздела1;
	
	ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ВыборкаРазделИтоги;
	ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = ВыборкаРазделИтоги.Выбрать();
	
	ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
	
	ВывестиПодписьИсполнителяРаздела1(ТабДокумент, ВыборкаШапка, ОбластиМакета);
	
	// РАЗДЕЛ 2

	ТабДокумент.Вывести(ОбластиМакета.Раздел2Заголовок);

	// РАЗДЕЛ 2.1
	
	ВыборкаРазделИтоги = ДанныеДляПечати.Выборки.Раздел21;
	ВыборкаРазделИтоги.Сбросить();
	ВыборкаРазделИтоги.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка");

	// РАЗДЕЛ 2.1 Таблица 1
	
	ПараметрыВыводаТаблицы.Области.Заголовок = ОбластиМакета.Раздел21Заголовок;
