#Область РешениеОПроведенииИнвентаризации

&НаСервереБезКонтекста
Функция ПараметрыФормыВыборДанныхИзРешения(Знач Ссылка, Знач РешениеОПроведенииИнвентаризации,
	Знач УникальныйИдентификатор)
	
	Возврат ИнвентаризацияСервер.ПолучитьПараметрыФормыВыбораДанныхИзРешения(
		Ссылка,
		РешениеОПроведенииИнвентаризации,
		УникальныйИдентификатор);	
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьОписьПослеВыбораДанныхИзРешения(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Объект.Раздел1.Количество() > 0 Или Объект.Раздел21.Количество() > 0 Или Объект.Раздел22.Количество() > 0
		Или Объект.Раздел3.Количество() > 0 Или Объект.Раздел4.Количество() > 0 Тогда
		ЗадатьВопросОбОчисткеПриВыбореРешенияАсинх(Результат, ДополнительныеПараметры);
	Иначе
		ЗаполнитьОписьПоРешению(Результат, ДополнительныеПараметры);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗадатьВопросОбОчисткеПриВыбореРешенияАсинх(Результат, ДополнительныеПараметры)

	ТекстВопроса = НСтр("ru='Табличные части разделов 1, 2.1, 2.2, 3 и 4 будут очищены. Продолжить?'");
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да,
		ТекстЗаголовкаСообщений);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОчиститьРаздел1(ЭтотОбъект);
		ОчиститьРаздел21(ЭтотОбъект);
		ОчиститьРаздел22(ЭтотОбъект);
		ОчиститьРаздел3(ЭтотОбъект);
		ОчиститьРаздел4(ЭтотОбъект);
		ЗаполнитьОписьПоРешению(Результат, ДополнительныеПараметры);
	Иначе
		ПредупреждениеАсинх(НСтр("ru='Заполнение описи по Решению не выполнено'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОписьПоРешению(Результат, ДополнительныеПараметры)

	Модифицированность = Истина;
	Объект.РешениеОПроведенииИнвентаризации = ДополнительныеПараметры.Решение;
	
	ЗаполнитьОписьПоРешениюНаСервере(Результат);
	ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписьПоРешениюНаСервере(РезультатВыбора)
	
	ИнвентаризацияСервер.ЗаполнитьОписьПоРешениюИзФормыОписи(ЭтотОбъект, РезультатВыбора);
	ЗаполнитьВидЦеннойБумагиПоСчету();
	
	УстановитьПредставлениеНомераКомиссии();
	УстановитьПредставлениеМестаПроведения();
	УстановитьПредставлениеСчета();
	УправлениеЭлементамиВидИФормаЦенныхБумаг();
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ПриИзмененииКомиссииЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	РаботаСКомиссиями.ЗаполнитьОтветственногоИсполнителяКомиссииВДокументеОписи(ЭтотОбъект);
	
	НастроитьОтборПоПодразделению();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент()
	
	ИнвентаризацияКлиент.СообщитьОЗаполненииНаОснованииРешенияОПроведенииИнвентаризации();
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ЗаполнитьВидЦеннойБумагиПоСчету()
	
	НаДату = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(Объект.ДатаИнвентаризации);
	ДопустимыеВидыЦенныхБумаг = Перечисления.ВидыЦенныхБумаг.ВидыЦенныхБумагПоСчету(Объект.Счет, Объект.Организация,
		НаДату);
		
	Если ДопустимыеВидыЦенныхБумаг.Количество() = 1 Тогда
		Объект.ВидЦенныхБумаг = ДопустимыеВидыЦенныхБумаг[0];
	Иначе
		Если ЗначениеЗаполнено(Объект.ВидЦенныхБумаг) 
			И ДопустимыеВидыЦенныхБумаг.Найти(Объект.ВидЦенныхБумаг) = Неопределено Тогда
			Объект.ВидЦенныхБумаг = Перечисления.ВидыЦенныхБумаг.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеНомераКомиссии()

	ПредставлениеНомераКомиссии = "";

	Если ЗначениеЗаполнено(Объект.НомерКомиссии) Или ЗначениеЗаполнено(Объект.НомерРабочейКомиссии) Тогда
		ПредставлениеНомераКомиссии = ИнвентаризацияКлиентСервер.ФорматироватьПолныйНомерКомиссии(Объект.НомерКомиссии,
			Объект.НомерРабочейКомиссии);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеМестаПроведения()
	
	ИнвентаризацияКлиентСервер.УстановитьПредставлениеМестаПроведения(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеСчета()
	
	ПредставлениеСчета = "";
	
	Если ЗначениеЗаполнено(Объект.Счет) Тогда
		ПредставлениеСчета = СтрШаблон("%1.%2", ?(ЗначениеЗаполнено(Объект.КФО), Объект.КФО, "0"), Объект.Счет);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеЭлементамиВидИФормаЦенныхБумаг()
	
	Если ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ВидЦенныхБумаг.Доступность = ЗначениеЗаполнено(Объект.РешениеОПроведенииИнвентаризации);
	Элементы.ФормаЦенныхБумаг.Доступность = ЗначениеЗаполнено(Объект.РешениеОПроведенииИнвентаризации);

КонецПроцедуры

