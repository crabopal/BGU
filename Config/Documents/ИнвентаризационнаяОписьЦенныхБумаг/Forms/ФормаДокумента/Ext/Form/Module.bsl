Процедура НастроитьНедоступностьИзмененияКолонок()
	
	НедоступныеКолонки = Новый Массив();

	НедоступныеКолонки.Добавить("Раздел1НомерСтроки");
	НедоступныеКолонки.Добавить("Раздел1ЦеннаяБумага");
	НедоступныеКолонки.Добавить("Раздел1КодЦеннойБумаги");
	НедоступныеКолонки.Добавить("Раздел1ЕдиницаИзмерения");
	НедоступныеКолонки.Добавить("Раздел1Серия");
	НедоступныеКолонки.Добавить("Раздел1Номер");
	НедоступныеКолонки.Добавить("Раздел1Номинал");
	НедоступныеКолонки.Добавить("Раздел1Валюта");
	НедоступныеКолонки.Добавить("Раздел1Количество");
	НедоступныеКолонки.Добавить("Раздел1СуммаВал");
	НедоступныеКолонки.Добавить("Раздел1СуммаРуб");

	ИнвентаризацияСервер.НастроитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтотОбъект, НедоступныеКолонки);
	
	НедоступныеКолонки = Новый Массив();
	НедоступныеКолонки.Добавить("СоставКомиссииРаздел2Сотрудник");
	НедоступныеКолонки.Добавить("СоставКомиссииРаздел4Сотрудник");
	
	ИнвентаризацияСервер.НастроитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтотОбъект, НедоступныеКолонки, Ложь);
	
