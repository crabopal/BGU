	Если ТекущиеДанные.КоличествоНеСоответствует > ТекущиеДанные.Количество Тогда
		ТекущиеДанные.КоличествоНеСоответствует = ТекущиеДанные.Количество;
	КонецЕсли;
	Если ТекущиеДанные.КоличествоНеСоответствует = 0 Тогда
		ТекущиеДанные.НеСоответствует = Ложь;
		ПоляЗаполнения = ОбщиеПоляЗаполнения();
		ОчиститьПоляНеСоответствуетВСтрокеРаздела21(ТекущиеДанные, ПоляЗаполнения);
	Иначе
		РасчетСуммПоНоминалуВСтроке0510470(ТекущиеДанные, "НеСоответствует", ВалютаРегламентированногоУчета);
