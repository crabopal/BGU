	РасчетСуммПоНоминалуВСтроке0510470(ТекущиеДанные, "", ВалютаРегламентированногоУчета);
	Если ТекущиеДанные.Количество = 0 И ТекущиеДанные.ДанныеРаздела1 Тогда
		Раздел21ПриОчисткеКоличестваНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	ИначеЕсли ТекущиеДанные.КоличествоНеСоответствует > ТекущиеДанные.Количество Тогда
		ТекущиеДанные.КоличествоНеСоответствует = ТекущиеДанные.Количество;
		РасчетСуммПоНоминалуВСтроке0510470(ТекущиеДанные, "НеСоответствует", ВалютаРегламентированногоУчета);
