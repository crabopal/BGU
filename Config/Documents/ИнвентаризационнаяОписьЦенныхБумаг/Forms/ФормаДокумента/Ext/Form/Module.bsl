Процедура ЗаполнитьРаздел21(Команда)
	ЗаполнитьРаздел21Клиент(Истина);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗаполнитьРаздел22(Команда)

	Если Объект.Раздел22.Количество() > 0 Или Объект.Раздел3.Количество() > 0 Или Объект.Раздел4.Количество() > 0 Тогда

		ТекстВопроса = НСтр(
			"ru='Табличная часть раздела 2.2 будет перезаполнена по данным разделов 1 и 2.1, разделы 3 и 4 очищены. Продолжить?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;

	КонецЕсли;

	ОчиститьСообщения();
	ОчиститьРаздел22(ЭтотОбъект);
	ОчиститьРаздел3(ЭтотОбъект);
	ОчиститьРаздел4(ЭтотОбъект);

	Если Объект.Раздел21.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Раздел 2.1 не заполнен'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "Объект.Раздел21");
		Возврат;
	КонецЕсли;

	ЗаполнитьРаздел22НаСервере();
	ТекстЗаголовкаОповещения = НСтр("ru = 'Заполнить по данным разделов 1 и 2.1'");
	ТекстСообщения = НСтр("ru = 'Раздел 2.2 заполнен'");
	ПоказатьОповещениеПользователя(ТекстЗаголовкаОповещения, , ТекстСообщения, БиблиотекаКартинок.Информация32);

КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗаполнитьРаздел3(Команда)

	Если Объект.Раздел3.Количество() > 0 Или Объект.Раздел4.Количество() > 0 Тогда

		ТекстВопроса = НСтр("ru='Табличные части разделов 3 и 4 будет очищены. Продолжить?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;

		ОчиститьРаздел3(ЭтотОбъект);
		ОчиститьРаздел4(ЭтотОбъект);

	КонецЕсли;

	ОчиститьСообщения();
	ЗаполнитьРаздел3НаСервере();

	Если Объект.Раздел3.Количество() = 0 Тогда
		ПредупреждениеАсинх(НСтр("ru = 'В разделе 2.2 нет данных для заполнения раздела 3.'"));
	Иначе
		ТекстЗаголовкаОповещения = НСтр("ru = 'Заполнить по данным раздела 2.2'");
		ТекстСообщения = НСтр("ru = 'Раздел 3 заполнен'");
		ПоказатьОповещениеПользователя(ТекстЗаголовкаОповещения, , ТекстСообщения, БиблиотекаКартинок.Информация32);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗаполнитьРаздел4(Команда)

	Если Объект.Раздел4.Количество() > 0 Тогда

		ТекстВопроса = НСтр("ru='Табличная часть раздела 4 будет очищена. Продолжить?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;

		ОчиститьРаздел4(ЭтотОбъект);

	КонецЕсли;

	ОчиститьСообщения();
	ЗаполнитьРаздел4НаСервере();

	ТекстЗаголовкаОповещения = НСтр("ru = 'Заполнить по данным раздела 2.2 и раздела 3'");
	ТекстСообщения = НСтр("ru = 'Раздел 4 заполнен'");
	ПоказатьОповещениеПользователя(ТекстЗаголовкаОповещения, , ТекстСообщения, БиблиотекаКартинок.Информация32);

