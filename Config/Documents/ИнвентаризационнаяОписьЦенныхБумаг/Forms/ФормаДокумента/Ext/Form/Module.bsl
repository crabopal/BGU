#Область Раздел1

&НаСервере
Процедура ПроверитьПередЗаполнениемРаздела1Сервер(Отказ)
	
	Документы.ИнвентаризационнаяОписьЦенныхБумаг.ПроверитьПередЗаполнениемРаздела1(Объект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел1Клиент()
	
	ДлительнаяОперация = НачатьЗаполнениеРаздела1НаСервере();
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаполнитьРаздел1Завершение", ЭтотОбъект);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция НачатьЗаполнениеРаздела1НаСервере()

	ОчиститьРаздел1(ЭтотОбъект);
	ОчиститьРаздел21(ЭтотОбъект);
	ОчиститьРаздел22(ЭтотОбъект);
	ОчиститьРаздел3(ЭтотОбъект);
	ОчиститьРаздел4(ЭтотОбъект);

	ПараметрыЗаполнения = Документы.ИнвентаризационнаяОписьЦенныхБумаг.ПараметрыЗаполненияРаздел1();
	ПараметрыЗаполнения.Организация = Объект.Организация;
	ПараметрыЗаполнения.ВидЦенныхБумаг = Объект.ВидЦенныхБумаг;
	ПараметрыЗаполнения.ФормаЦенныхБумаг = Объект.ФормаЦенныхБумаг;
	ПараметрыЗаполнения.ДатаИнвентаризации = Объект.ДатаИнвентаризации;
	ПараметрыЗаполнения.КФО = Объект.КФО;
	ПараметрыЗаполнения.Счет = Объект.Счет;
	ПараметрыЗаполнения.ИФО = Объект.ИФО;
	ПараметрыЗаполнения.Подразделение = Объект.Подразделение;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр(
		"ru = 'Заполнение раздела 1 инвентаризационной описи 0510470'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;

	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"Документы.ИнвентаризационнаяОписьЦенныхБумаг.ТаблицаРаздела1", ПараметрыЗаполнения);

КонецФункции

&НаКлиенте
Процедура ЗаполнитьРаздел1Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ИнформацияОбОшибке = Результат.ИнформацияОбОшибке;
		Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке,
			НСтр("ru = 'При заполнении раздела 1 возникла ошибка:'"));
		ОбработкаОшибок.ПоказатьИнформациюОбОшибке(ИнформацияОбОшибке, Уточнение.Текст);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел1ЗавершениеНаСервере(Результат.АдресРезультата);
	
	ТекстЗаголовкаОповещения = НСтр("ru = 'Заполнить по данным учета'");
	ТекстСообщения = НСтр("ru = 'Раздел 1 заполнен'");
	ПоказатьОповещениеПользователя(ТекстЗаголовкаОповещения, ,ТекстСообщения, БиблиотекаКартинок.Информация32);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаздел1ЗавершениеНаСервере(Знач АдресРезультата)
	
	ТаблицаРаздела1 = ПолучитьИзВременногоХранилища(АдресРезультата);	
	Объект.Раздел1.Загрузить(ТаблицаРаздела1);
	УдалитьИзВременногоХранилища(АдресРезультата);
	Документы.ИнвентаризационнаяОписьЦенныхБумаг.ПроверитьЗаполнениеРаздела1(ЭтотОбъект, Ложь, Новый Массив, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел1КурсНачалоВыбораЗавершение(КурсВалюты, ДополнительныеПараметры) Экспорт
	ТекущиеДанные = Элементы.Раздел1.ТекущиеДанные;
	Если КурсВалюты = Неопределено Или КурсВалюты = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.Курс = КурсВалюты.Курс;
	ТекущиеДанные.Кратность = КурсВалюты.Кратность;
	РасчетСуммПоНоминалуВСтроке0510470(ТекущиеДанные, "", ВалютаРегламентированногоУчета);
КонецПроцедуры

#КонецОбласти

#Область Раздел21

&НаКлиенте
Асинх Процедура ЗаполнитьРаздел21Клиент(ВсеГрафы)

	Если Объект.Раздел21.Количество() > 0 Или Объект.Раздел22.Количество() > 0 Или Объект.Раздел3.Количество() > 0
		Или Объект.Раздел4.Количество() > 0 Тогда
		ТекстВопроса = НСтр(
			"ru='Табличная часть раздела 2.1 будет перезаполнена по данным раздела 1, разделы 2.2, 3 и 4 очищены. Продолжить?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ОчиститьСообщения();
	ОчиститьРаздел21(ЭтотОбъект);
	ОчиститьРаздел22(ЭтотОбъект);
	ОчиститьРаздел3(ЭтотОбъект);
	ОчиститьРаздел4(ЭтотОбъект);
	ЗаполнитьРаздел21НаСервере(ВсеГрафы);

	Модифицированность = Истина;

	ТекстЗаголовкаОповещения = НСтр("ru = 'Заполнить по данным раздела 1'");
	ТекстСообщения = НСтр("ru = 'Раздел 2.1 заполнен'");
	ПоказатьОповещениеПользователя(ТекстЗаголовкаОповещения, , ТекстСообщения, БиблиотекаКартинок.Информация32);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаздел21НаСервере(Знач ВсеГрафы)

	ТаблицаРаздела21 = ТаблицаРаздела21ПоДаннымРаздела1(ВсеГрафы);
	Объект.Раздел21.Загрузить(ТаблицаРаздела21);
	ЗаполнитьДобавленныеКолонкиРаздел21();
	
	Документы.ИнвентаризационнаяОписьЦенныхБумаг.ПроверитьЗаполнениеРаздела21(ЭтотОбъект, Ложь,	Новый Массив, Истина);
	
КонецПроцедуры

&НаСервере
Функция ТаблицаРаздела21ПоДаннымРаздела1(ВсеГрафы)
	
	ТаблицаРаздела21 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(
		Метаданные.Документы.ИнвентаризационнаяОписьЦенныхБумаг.ТабличныеЧасти.Раздел21);

	ТаблицаРаздела21.Колонки.Добавить("НомерСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(6));

	СписокСвойств = СписокСвойствДляЗаполненияРаздела21(ВсеГрафы);
	
	Для Каждого СтрокаРаздела1 Из Объект.Раздел1 Цикл
		СтрокаРаздела21 = ТаблицаРаздела21.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела21, СтрокаРаздела1, СписокСвойств);
		СтрокаРаздела21.НомерСтроки = СтрокаРаздела1.НомерСтроки;
		СтрокаРаздела21.ДанныеРаздела1 = Истина;
	КонецЦикла;
	
	Возврат ТаблицаРаздела21;
КонецФункции

&НаСервере
Функция СписокСвойствДляЗаполненияРаздела21(ВсеГрафы = Ложь)
	Возврат 
		"ЦеннаяБумага,КодЦеннойБумаги,ЕдиницаИзмерения"
			+ ?(ВсеГрафы, ",Серия,Номер,Номинал,Валюта,Курс,Кратность,Количество,СуммаВал,СуммаРуб", "");
КонецФункции

&НаКлиенте
Асинх Процедура ВопросПередНачаломДобавленияСтрокРаздела21Асинх(ТребуетЗаполнения, Копирование)
	Если ТребуетЗаполнения Тогда
		ТекстВопроса = НСтр("ru = 'Раздел 2.1 заполняется по данным раздела 1.
			|Заполнить раздел 2.1 по данным раздела 1?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("ЗаполнитьРаздел21Графы1_5", НСтр("ru = 'Заполнить графы 1-5'"));
		Кнопки.Добавить("ЗаполнитьРаздел21", НСтр("ru = 'Заполнить графы 1-13'"));
		Кнопки.Добавить("Отмена", НСтр("ru = 'Отмена'"));
		Ответ = Ждать ВопросАсинх(ТекстВопроса, Кнопки, ,"ЗаполнитьРаздел21Графы1_5", ТекстЗаголовкаСообщений);
		Если Ответ = "ЗаполнитьРаздел21Графы1_5" Тогда
			ЗаполнитьРаздел21Клиент(Ложь);
		ИначеЕсли Ответ = "ЗаполнитьРаздел21" Тогда
			ЗаполнитьРаздел21Клиент(Истина);
		Иначе
			Возврат;
		КонецЕсли;
	Иначе
		ТекстВопроса = НСтр("ru = 'Табличные части разделов 2.2, 3 и 4 будет очищены. Продолжить?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		ОчиститьРаздел22(ЭтотОбъект);		
		ОчиститьРаздел3(ЭтотОбъект);		
		ОчиститьРаздел4(ЭтотОбъект);		
		Если Копирование Тогда
			Элементы.Раздел21.СкопироватьСтроку();
		Иначе
			Элементы.Раздел21.ДобавитьСтроку();
		КонецЕсли;
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ЕстьДанныеРаздела1()
	ЕстьДанныеРаздела1 = Ложь;
	ВыделенныеСтроки = Элементы.Раздел21.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 1 Тогда
		ЕстьДанныеРаздела1 = Элементы.Раздел21.ТекущиеДанные.ДанныеРаздела1;
	Иначе
		Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
			Строка = Объект.Раздел21.НайтиПоИдентификатору(ИдентификаторСтроки);
			Если Строка.ДанныеРаздела1 Тогда
				ЕстьДанныеРаздела1 = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ЕстьДанныеРаздела1;
КонецФункции

&НаКлиенте
Асинх Процедура ВопросПередУдалениемСтрокРаздела21Асинх(ЕстьДанныеРаздела1, ТребуетОчистки)

	Если ТребуетОчистки Тогда
		ТекстВопроса = НСтр("ru = 'Табличные части разделов 2.2, 3 и 4 будет очищены. Продолжить?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		ОчиститьРаздел22(ЭтотОбъект);		
		ОчиститьРаздел3(ЭтотОбъект);		
		ОчиститьРаздел4(ЭтотОбъект);
		Модифицированность = Истина;		
	КонецЕсли;

	ВыделенныеСтроки = Элементы.Раздел21.ВыделенныеСтроки;
	ОчиститьРаздел21 = ВыделенныеСтроки.Количество() = Объект.Раздел21.Количество();

	Если ЕстьДанныеРаздела1 И Не ОчиститьРаздел21 Тогда
		ТекстВопроса = НСтр("ru = 'Не предусмотрено удаление строк, заполненных по данным раздела 1.
			|Очистить фактическое наличие в выделенных строках?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если ОчиститьРаздел21 Тогда
		ОчиститьРаздел21(ЭтотОбъект);
	Иначе
		УдалитьВыделенныеСтрокиРаздела21НаСервере(ВыделенныеСтроки);
	КонецЕсли;

	Модифицированность = Истина;		

КонецПроцедуры

&НаСервере
Процедура УдалитьВыделенныеСтрокиРаздела21НаСервере(Знач ВыделенныеСтроки)

	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		Строка = Объект.Раздел21.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если Строка.ДанныеРаздела1 Тогда
			ОчиститьДанныеСтрокиРаздела21(Строка);
		Иначе
			Объект.Раздел21.Удалить(Строка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьДанныеСтрокиРаздела21(Строка)

	ФиксированныеДанные = Новый Структура(СписокСвойствДляЗаполненияРаздела21());
	ФиксированныеДанные.Вставить("ДанныеРаздела1");
	
	Реквизиты = Метаданные.Документы.ИнвентаризационнаяОписьЦенныхБумаг.ТабличныеЧасти.Раздел21.Реквизиты;
	
	Для Каждого Реквизит Из Реквизиты Цикл
		Если ФиксированныеДанные.Свойство(Реквизит.Имя) Тогда
			Продолжить;			
		КонецЕсли;
		Строка[Реквизит.Имя] = ОбщегоНазначенияБГУКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(Строка[Реквизит.Имя]));
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВопросПередИзменениямСтрокРаздела21Асинх()

	ТекстВопроса = НСтр("ru = 'Табличные части разделов 2.2, 3 и 4 будет очищены. Продолжить?'");
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ОчиститьРаздел22(ЭтотОбъект);		
	ОчиститьРаздел3(ЭтотОбъект);		
	ОчиститьРаздел4(ЭтотОбъект);
	Элементы.Раздел21.ИзменитьСтроку();
	Если Элементы.Раздел21.ТекущийЭлемент.Имя = "Раздел21НеСоответствует" Тогда
		ТекущиеДанные = Элементы.Раздел21.ТекущиеДанные;
		ТекущиеДанные.НеСоответствует = Не ТекущиеДанные.НеСоответствует;
		ЗаполнитьПоляНеСоответствуетВСтрокеРаздела21(ТекущиеДанные);
		Элементы.Раздел21.ЗакончитьРедактированиеСтроки(Ложь);
	КонецЕсли;
		
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеСтрокиРаздела21ПриИзмененииЦеннойБумаги(Знач ПараметрыЗаполнения)

	ДанныеСтроки = НовыеДаныеСтрокиРаздела21();
	Если Не ЗначениеЗаполнено(ПараметрыЗаполнения.ЦеннаяБумага) Тогда
		Возврат ДанныеСтроки;	
	КонецЕсли;
	
	СписокРеквизитов = "КодЦеннойБумаги,РНФИ,ЕдиницаИзмерения,РегистрационныйНомер,Серия,Номер,НоминальнаяСтоимость,Валюта";
	
	РеквизитыБумаги = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыЗаполнения.ЦеннаяБумага, СписокРеквизитов);
	
	Если ЗначениеЗаполнено(РеквизитыБумаги.КодЦеннойБумаги) Тогда
		ДанныеСтроки.КодЦеннойБумаги = РеквизитыБумаги.КодЦеннойБумаги;
	Иначе
		ДанныеСтроки.КодЦеннойБумаги = РеквизитыБумаги.РНФИ;
	КонецЕсли;

	ДанныеСтроки.ЕдиницаИзмерения = РеквизитыБумаги.ЕдиницаИзмерения;
	
	Если Не ЗначениеЗаполнено(РеквизитыБумаги.Серия) И Не ЗначениеЗаполнено(РеквизитыБумаги.Номер) Тогда
		ДанныеСтроки.Серия = РеквизитыБумаги.РегистрационныйНомер;
		ДанныеСтроки.Номер = "";
	Иначе
		ДанныеСтроки.Серия = РеквизитыБумаги.Серия;
		ДанныеСтроки.Номер = РеквизитыБумаги.Номер;
		Документы.ИнвентаризационнаяОписьЦенныхБумаг.ДобавитьРазделительНомера(ДанныеСтроки.Номер);
	КонецЕсли;
		
	ДанныеСтроки.Номинал = РеквизитыБумаги.НоминальнаяСтоимость;
	
	Если ЗначениеЗаполнено(РеквизитыБумаги.Валюта) Тогда
		ДанныеСтроки.Валюта = РеквизитыБумаги.Валюта;
	Иначе
		ДанныеСтроки.Валюта = ПараметрыЗаполнения.ВалютаРегламентированногоУчета;
	КонецЕсли;
	
	Если ДанныеСтроки.Валюта <> ПараметрыЗаполнения.ВалютаРегламентированногоУчета Тогда
		КурсВалюты = КурсВалюты(ДанныеСтроки.Валюта, ПараметрыЗаполнения.ДатаИнвентаризации);
		ДанныеСтроки.Курс = КурсВалюты.Курс;
		ДанныеСтроки.Кратность = КурсВалюты.Кратность;
	КонецЕсли;
		
	Возврат ДанныеСтроки;
	
КонецФункции

&НаСервере
Процедура Раздел21ПриОчисткеКоличестваНаСервере(Идентификатор)
	ТекущиеДанные = Объект.Раздел21.НайтиПоИдентификатору(Идентификатор);
	ОчиститьДанныеСтрокиРаздела21(ТекущиеДанные);
КонецПроцедуры

&НаСервереБезКонтекста
Функция КурсВалюты(Знач Валюта, Знач ДатаКурса)
	Возврат 
		РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, НачалоДня(ДатаКурса));	
КонецФункции

&НаКлиенте
Процедура Раздел21КурсНачалоВыбораЗавершение(КурсВалюты, ДополнительныеПараметры) Экспорт
	ТекущиеДанные = Элементы.Раздел21.ТекущиеДанные;
	Если КурсВалюты = Неопределено Или КурсВалюты = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.Курс = КурсВалюты.Курс;
	ТекущиеДанные.Кратность = КурсВалюты.Кратность;
	РасчетСуммПоНоминалуВСтроке0510470(ТекущиеДанные, "", ВалютаРегламентированногоУчета);
	Если ТекущиеДанные.НеСоответствует Тогда
		ТекущиеДанные.КурсНеСоответствует = ТекущиеДанные.Курс;
		ТекущиеДанные.КратностьНеСоответствует = ТекущиеДанные.Кратность;
		РасчетСуммПоНоминалуВСтроке0510470(ТекущиеДанные, "НеСоответствует", ВалютаРегламентированногоУчета);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоляНеСоответствуетВСтрокеРаздела21(ТекущиеДанные)
	ПоляЗаполнения = ОбщиеПоляЗаполнения();
	Если ТекущиеДанные.НеСоответствует Тогда
		ЗаполнитьПоляПоИсточнику(ТекущиеДанные, ТекущиеДанные, ПоляЗаполнения, "НеСоответствует", "");
	Иначе
		ОчиститьПоляНеСоответствуетВСтрокеРаздела21(ТекущиеДанные, ПоляЗаполнения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоляНеСоответствуетВСтрокеРаздела21(ТекущиеДанные, ПоляЗаполнения)
	ПоляОчистки = Новый Массив;
	Постфикс = "НеСоответствует";
	Для Каждого ИмяПоля Из ПоляЗаполнения Цикл
		ПоляОчистки.Добавить(ИмяПоля + Постфикс);
	КонецЦикла;
	ПоляОчистки.Добавить("СтатусНеСоответствует");
	СтруктураДанных = Новый Структура(СтрСоединить(ПоляОчистки, ","));
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураДанных);
КонецПроцедуры

&НаСервереБезКонтекста
Функция НовыеДаныеСтрокиРаздела21()
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("КодЦеннойБумаги", "");
	ДанныеСтроки.Вставить("ЕдиницаИзмерения", Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
	ДанныеСтроки.Вставить("Серия", "");
	ДанныеСтроки.Вставить("Номер", "");
	ДанныеСтроки.Вставить("Номинал", 0);
	ДанныеСтроки.Вставить("Валюта", Справочники.Валюты.ПустаяСсылка());
	ДанныеСтроки.Вставить("Курс", 1);
	ДанныеСтроки.Вставить("Кратность", 1);
	Возврат ДанныеСтроки; 	
КонецФункции

#КонецОбласти

#Область Раздел22

&НаСервере
Процедура ЗаполнитьРаздел22НаСервере()
	
	ТаблицаРаздела22 = ТаблицаРаздела22();
	Объект.Раздел22.Загрузить(ТаблицаРаздела22);
	
	Документы.ИнвентаризационнаяОписьЦенныхБумаг.ПроверитьЗаполнениеРаздела22(ЭтотОбъект, Ложь,	Новый Массив, Истина);
	
КонецПроцедуры

&НаСервере
Функция ТаблицаРаздела22()
	
	ТаблицаРаздела22 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(
		Метаданные.Документы.ИнвентаризационнаяОписьЦенныхБумаг.ТабличныеЧасти.Раздел22);
	ТаблицаРаздела22.Колонки.Добавить("НомерСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(6));
		
	ТаблицаРаздела1 = Объект.Раздел1.Выгрузить();
	ТаблицаРаздела1.Индексы.Добавить("НомерСтроки");

	ТаблицаРаздела21 = Объект.Раздел21.Выгрузить();
	
	ОбщиеСвойства = "НомерСтроки,ЦеннаяБумага,КодЦеннойБумаги,ЕдиницаИзмерения";
	СвойстваНеСоответствует = "СерияНеСоответствует,НомерНеСоответствует,НоминалНеСоответствует,ВалютаНеСоответствует,"
		+ "КурсНеСоответствует,КратностьНеСоответствует,КоличествоНеСоответствует,СуммаВалНеСоответствует,"
		+ "СуммаРубНеСоответствует,СтатусНеСоответствует"; 
	
	ПоляСравнения = Новый Массив;
	ПоляСравнения.Добавить("Серия"); 
	ПоляСравнения.Добавить("Номер"); 
	ПоляСравнения.Добавить("Номинал"); 
	ПоляСравнения.Добавить("Валюта"); 
	ПоляСравнения.Добавить("Курс"); 
	ПоляСравнения.Добавить("Кратность"); 
	
	Для Каждого СтрокаФакт Из ТаблицаРаздела21 Цикл
		СтрокаРаздела22 = ТаблицаРаздела22.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела22, СтрокаФакт, ОбщиеСвойства);
		ЗаполнитьЗначенияСвойств(СтрокаРаздела22, СтрокаФакт, СвойстваНеСоответствует);
		СтрокаУчет = ТаблицаРаздела1.Найти(СтрокаФакт.НомерСтроки, "НомерСтроки");
		Отклонения = Отклонения(СтрокаУчет, СтрокаФакт, ПоляСравнения);
		Если Отклонения.Излишки > 0 Тогда
			ЗаполнитьОтклонения(СтрокаРаздела22, СтрокаФакт, ПоляСравнения, Отклонения.Излишки,"Излишки");
		КонецЕсли;
		Если Отклонения.Недостача > 0 Тогда
			ЗаполнитьОтклонения(СтрокаРаздела22, СтрокаУчет, ПоляСравнения, Отклонения.Недостача, "Недостача");
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаРаздела22;
КонецФункции

&НаСервере
Процедура ЗаполнитьОтклонения(СтрокаРаздела22, СтрокаИсточник, ПоляСравнения, Количество, Постфикс)
	
	Для Каждого ИмяПоля Из ПоляСравнения Цикл
		СтрокаРаздела22[ИмяПоля + Постфикс] = СтрокаИсточник[ИмяПоля];
	КонецЦикла;
	СтрокаРаздела22["Количество" + Постфикс] = Количество;
	
	РасчетСуммПоНоминалуВСтроке0510470(СтрокаРаздела22, Постфикс, ВалютаРегламентированногоУчета);
	
КонецПроцедуры

&НаСервере
Функция Отклонения(СтрокаУчет, СтрокаФакт, ПоляСравнения)
	
	Отклонения = Новый Структура;
	Отклонения.Вставить("Излишки", 0);
	Отклонения.Вставить("Недостача", 0);
	
	Если СтрокаУчет = Неопределено Тогда
		Отклонения.Излишки = СтрокаФакт.Количество;
		Возврат Отклонения;
	КонецЕсли;
	
	ДанныеИдентичны = Истина;
	Для Каждого ИмяПоля Из ПоляСравнения Цикл
		Если СтрокаУчет[ИмяПоля] <> СтрокаФакт[ИмяПоля] Тогда
			ДанныеИдентичны = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ДанныеИдентичны Тогда
		Отклонение = СтрокаФакт.Количество - СтрокаУчет.Количество;
		Отклонения.Излишки = ?(Отклонение > 0, Отклонение, 0);
		Отклонения.Недостача = ?(Отклонение < 0, -Отклонение, 0);
	Иначе
		// пересортица
		Отклонения.Излишки = СтрокаФакт.Количество;
		Отклонения.Недостача = СтрокаУчет.Количество;
	КонецЕсли;
	
	Возврат Отклонения;
	
КонецФункции

#КонецОбласти

#Область Раздел3

&НаСервере
Процедура ЗаполнитьРаздел3НаСервере()

	ТаблицаРаздела3 = ТаблицаРаздела3ПоДаннымРаздела22();
	Объект.Раздел3.Загрузить(ТаблицаРаздела3);
	ЗаполнитьДобавленныеКолонкиРаздел3();
	
	Документы.ИнвентаризационнаяОписьЦенныхБумаг.ПроверитьЗаполнениеРаздела3(ЭтотОбъект, Ложь, Новый Массив, Истина);
	
КонецПроцедуры

&НаСервере
Функция ТаблицаРаздела3ПоДаннымРаздела22()

	ТаблицаРаздела3 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(
		Метаданные.Документы.ИнвентаризационнаяОписьЦенныхБумаг.ТабличныеЧасти.Раздел3);

	ПоляЗаполнения = ОбщиеПоляЗаполнения();
	
	Для Каждого СтрокаРаздела22 Из Объект.Раздел22 Цикл
		Если СтрокаРаздела22.КоличествоИзлишки > 0 Или СтрокаРаздела22.КоличествоНедостача > 0 Тогда
			СтрокаРаздела3 = ТаблицаРаздела3.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРаздела3, СтрокаРаздела22);
			СтрокаРаздела3.КодСтроки = СтрокаРаздела22.НомерСтроки;
			Если СтрокаРаздела3.КоличествоИзлишки > 0 Тогда
				ЗаполнитьПоляПоИсточнику(СтрокаРаздела3, СтрокаРаздела3, ПоляЗаполнения,
					"ИзлишкиНеПодтверждено", "Излишки");
			КонецЕсли;
			Если СтрокаРаздела3.КоличествоНедостача > 0 Тогда
				ЗаполнитьПоляПоИсточнику(СтрокаРаздела3, СтрокаРаздела3, ПоляЗаполнения,
					"НедостачаНеПодтверждено", "Недостача");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаРаздела3;
КонецФункции

&НаКлиенте
Асинх Процедура ВопросПередИзменениямСтрокРаздела3Асинх()

	ТекстВопроса = НСтр("ru = 'Табличная часть раздела 4 будет очищена. Продолжить?'");
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ОчиститьРаздел4(ЭтотОбъект);
	Элементы.Раздел3.ИзменитьСтроку();
	Если Элементы.Раздел3.ТекущийЭлемент.Имя = "Раздел3Подтверждено" Тогда
		ТекущиеДанные = Элементы.Раздел3.ТекущиеДанные;
		ТекущиеДанные.Подтверждено = Не ТекущиеДанные.Подтверждено;
		ЗаполнитьПоляПодтвержденоВСтрокеРаздела3(ТекущиеДанные);
		Элементы.Раздел3.ЗакончитьРедактированиеСтроки(Ложь);
	КонецЕсли;
		
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоляПодтвержденоВСтрокеРаздела3(ТекущиеДанные)
	ПоляЗаполнения = ОбщиеПоляЗаполнения();
	Если ТекущиеДанные.Подтверждено Тогда
		ПолеЗаполнения = "Подтверждено";
		ПолеОчистки = "НеПодтверждено";
	Иначе
		ПолеЗаполнения = "НеПодтверждено";
		ПолеОчистки = "Подтверждено";
	КонецЕсли;
	ЗаполнитьПоляПоИсточнику(ТекущиеДанные, ТекущиеДанные, ПоляЗаполнения, "Излишки" + ПолеЗаполнения, "Излишки");
	ЗаполнитьПоляПоИсточнику(ТекущиеДанные, ТекущиеДанные, ПоляЗаполнения, "Недостача" + ПолеЗаполнения, "Недостача");
	ОчиститьПоляВСтрокеРаздела3(ТекущиеДанные, ПоляЗаполнения, "Излишки" + ПолеОчистки);
	ОчиститьПоляВСтрокеРаздела3(ТекущиеДанные, ПоляЗаполнения, "Недостача" + ПолеОчистки);
КонецПроцедуры

&НаКлиенте
Процедура РасчетСтрокиРаздела3ПриИзмененииКоличествоПодтверждено(ТекущиеДанные, Постфикс)
	
	Подтверждено = Постфикс + "Подтверждено";        // ИзлишкиПодтверждено, НедостачаПодверждено
	НеПодтверждено = Постфикс + "НеПодтверждено";    // ИзлишкиНеПодтверждено, НедостачаНеПодтверждено
	
	ПоляЗаполнения = ОбщиеПоляЗаполнения();
	ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПоляЗаполнения, "Количество");
	ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ПоляЗаполнения, "Номер");
	
	Если ТекущиеДанные["Количество" + Подтверждено] > 0 Тогда
		ЗаполнитьПоляПоИсточнику(ТекущиеДанные, ТекущиеДанные, ПоляЗаполнения, Подтверждено, Постфикс);
	КонецЕсли;
	
	КоличествоНеПодтверждено = ТекущиеДанные["Количество" + Постфикс] - ТекущиеДанные["Количество" + Подтверждено];
	ТребуетсяЗаполнитьПоля = КоличествоНеПодтверждено > 0 И ТекущиеДанные["Количество" + НеПодтверждено] = 0;

	Если ТребуетсяЗаполнитьПоля Тогда
		ЗаполнитьПоляПоИсточнику(ТекущиеДанные, ТекущиеДанные, ПоляЗаполнения, НеПодтверждено, Постфикс);
	КонецЕсли;
	
	ТекущиеДанные["Количество" + НеПодтверждено] = КоличествоНеПодтверждено;
	Если ТекущиеДанные["Количество" + НеПодтверждено] = 0 Тогда
		ОчиститьПоляВСтрокеРаздела3(ТекущиеДанные, ПоляЗаполнения, НеПодтверждено);
		ТекущиеДанные["Номер" + НеПодтверждено] = "";
	ИначеЕсли ТекущиеДанные["Количество" + НеПодтверждено] = ТекущиеДанные["Количество" + Постфикс] Тогда
		ТекущиеДанные["Номер" + НеПодтверждено] = ТекущиеДанные["Номер" + Постфикс];
	Иначе
		ТекущиеДанные["Номер" + НеПодтверждено] = "";
	КонецЕсли;
	
	Если ТекущиеДанные["Количество" + Подтверждено] = 0 Тогда
		ТекущиеДанные["Номер" + Подтверждено] = "";
		ОчиститьПоляВСтрокеРаздела3(ТекущиеДанные, ПоляЗаполнения, Подтверждено);
	КонецЕсли;
	
	Если ТекущиеДанные.КоличествоИзлишкиПодтверждено = 0 И ТекущиеДанные.КоличествоНедостачаПодтверждено = 0 Тогда
		ТекущиеДанные.Подтверждено = Ложь;
	КонецЕсли;
	
	РасчетСуммПоНоминалуВСтроке0510470(ТекущиеДанные, Подтверждено, ВалютаРегламентированногоУчета);
	РасчетСуммПоНоминалуВСтроке0510470(ТекущиеДанные, НеПодтверждено, ВалютаРегламентированногоУчета);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоляВСтрокеРаздела3(ТекущиеДанные, ПоляЗаполнения, Постфикс)
	ПоляОчистки = Новый Массив;
	Для Каждого ИмяПоля Из ПоляЗаполнения Цикл
		ПоляОчистки.Добавить(ИмяПоля + Постфикс);
	КонецЦикла;
	Если (Постфикс = "ИзлишкиПодтверждено" И ТекущиеДанные.КоличествоНедостачаПодтверждено = 0)
		Или (Постфикс = "НедостачаПодтверждено" И ТекущиеДанные.КоличествоИзлишкиПодтверждено = 0) Тогда
		ПоляОчистки.Добавить("НаименованиеДокумента");
		ПоляОчистки.Добавить("НомерДокумента");
		ПоляОчистки.Добавить("ДатаДокумента");
	КонецЕсли;
	СтруктураДанных = Новый Структура(СтрСоединить(ПоляОчистки, ","));
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураДанных);
КонецПроцедуры

&НаКлиенте
Асинх Процедура РедактироватьРаздел3ОбъяснениеАсинх()
	ТекущиеДанные = Элементы.Раздел3.ТекущиеДанные;
	Если ТолькоПросмотр Тогда
		Результат = Ждать ОткрытьЗначениеАсинх(ТекущиеДанные.Объяснение);
	Иначе
		ЗаблокироватьДанныеФормыДляРедактирования();
		Результат = Ждать ВвестиСтрокуАсинх(ТекущиеДанные.Объяснение,
			НСтр("ru = 'Объяснение причин расхождения'"), ,	Истина);
	КонецЕсли;
	Если Результат <> Неопределено Тогда
		ТекущиеДанные.Объяснение = Результат;
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Асинх Процедура РедактироватьРаздел3НаименованиеДокументаАсинх()
	ТекущиеДанные = Элементы.Раздел3.ТекущиеДанные;
	ДлинаНаименования = 255;
	Результат = Ждать ВвестиСтрокуАсинх(ТекущиеДанные.НаименованиеДокумента,
		НСтр("ru = 'Объяснение причин расхождения'"), ДлинаНаименования, Ложь);
	Если Результат <> Неопределено Тогда
		ТекущиеДанные.НаименованиеДокумента = Результат;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Раздел4

&НаСервере
Процедура ЗаполнитьРаздел4НаСервере()
	
	ТаблицаРаздела4 = ТаблицаРаздела4();
	Объект.Раздел4.Загрузить(ТаблицаРаздела4);
	Объект.ВыявленыНесоответствия = Объект.Раздел4.Итог("КоличествоНеСоответствует") > 0;
	Объект.ВыявленыОтклонения = Объект.Раздел4.Итог("КоличествоИзлишкиНеПодтверждено") > 0
		Или Объект.Раздел4.Итог("КоличествоНедостачаНеПодтверждено") > 0;
	
	Если Объект.Раздел4.Количество() = 0 Тогда
		СтрокаРаздела4 = Объект.Раздел4.Добавить();
		СтрокаРаздела4.ЗаключениеКомиссии = 
			ИнвентаризацияСервер.ПолучитьТекстЗаключенияКомиссииОтклоненияНеВыявлены(Объект.Ссылка);
	КонецЕсли;

	Документы.ИнвентаризационнаяОписьЦенныхБумаг.ПроверитьЗаполнениеРаздела4(ЭтотОбъект, Ложь,
		Новый Массив, Истина);
	
КонецПроцедуры

&НаСервере
Функция ТаблицаРаздела4()
	
	ТаблицаРаздела4 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(
		Метаданные.Документы.ИнвентаризационнаяОписьЦенныхБумаг.ТабличныеЧасти.Раздел4);
	
	ТаблицаРаздела4.Колонки.Добавить("ПолеСортировки1", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(1));
	ТаблицаРаздела4.Колонки.Добавить("ПолеСортировки2", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(6));
	
	Для Каждого СтрокаРаздела22 Из Объект.Раздел22 Цикл
		Если СтрокаРаздела22.КоличествоНеСоответствует = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРаздела4 = ТаблицаРаздела4.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела4, СтрокаРаздела22);
		СтрокаРаздела4.КодСтроки = СтрокаРаздела22.НомерСтроки;
		СтрокаРаздела4.СтатусОбъяснения = "0";
		СтрокаРаздела4.ПолеСортировки1 = 0;
		СтрокаРаздела4.ПолеСортировки2 = СтрокаРаздела22.НомерСтроки
	КонецЦикла;
	Для Каждого СтрокаРаздела3 Из Объект.Раздел3 Цикл
		Если СтрокаРаздела3.КоличествоИзлишкиНеПодтверждено = 0
			И СтрокаРаздела3.КоличествоНедостачаНеПодтверждено = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРаздела4 = ТаблицаРаздела4.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела4, СтрокаРаздела3);
		СтрокаРаздела4.ПолеСортировки1 = 1;
		СтрокаРаздела4.ПолеСортировки2 = СтрокаРаздела3.НомерСтроки
	КонецЦикла;
	ТаблицаРаздела4.Сортировать("КодСтроки, ПолеСортировки1, ПолеСортировки2");

	Возврат ТаблицаРаздела4;
КонецФункции

#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура РасчетСуммПоНоминалуВСтроке0510470(СтрокаРаздела, Постфикс, ВалютаРегламентированногоУчета)
	
	Если Не ЗначениеЗаполнено(СтрокаРаздела["Валюта" + Постфикс]) Тогда
		СтрокаРаздела["СуммаВал" + Постфикс] = 0;
		СтрокаРаздела["СуммаРуб" + Постфикс] = 0;
	ИначеЕсли СтрокаРаздела["Валюта" + Постфикс] = ВалютаРегламентированногоУчета Тогда
		СтрокаРаздела["СуммаВал" + Постфикс] = 0;
		СтрокаРаздела["СуммаРуб" + Постфикс] = 
			СтрокаРаздела["Количество" + Постфикс] * СтрокаРаздела["Номинал" + Постфикс];
	Иначе
		СтрокаРаздела["СуммаВал" + Постфикс] = 
			СтрокаРаздела["Количество" + Постфикс] * СтрокаРаздела["Номинал" + Постфикс];
		СтрокаРаздела["СуммаРуб" + Постфикс] = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
			СтрокаРаздела["СуммаВал" + Постфикс],
			Новый Структура("Валюта,Курс,Кратность",
													СтрокаРаздела["Валюта" + Постфикс],
													СтрокаРаздела["Курс" + Постфикс],
													СтрокаРаздела["Кратность" + Постфикс]),
			Новый Структура("Валюта,Курс,Кратность",
													ВалютаРегламентированногоУчета,
													1,
													1));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьПоляПоИсточнику(СтрокаПриемник, СтрокаИсточник, ПоляЗаполнения, ПостфиксПриемник, ПостфиксИсточник)
	Для Каждого ИмяПоля Из ПоляЗаполнения Цикл
		СтрокаПриемник[ИмяПоля + ПостфиксПриемник] = СтрокаИсточник[ИмяПоля + ПостфиксИсточник];
	КонецЦикла;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОбщиеПоляЗаполнения()
	ПоляЗаполнения = Новый Массив;
	ПоляЗаполнения.Добавить("Серия");
	ПоляЗаполнения.Добавить("Номер");
	ПоляЗаполнения.Добавить("Номинал");
	ПоляЗаполнения.Добавить("Валюта");
	ПоляЗаполнения.Добавить("Курс");
	ПоляЗаполнения.Добавить("Кратность");
	ПоляЗаполнения.Добавить("Количество");
	ПоляЗаполнения.Добавить("СуммаВал");
	ПоляЗаполнения.Добавить("СуммаРуб");
	Возврат ПоляЗаполнения;
КонецФункции

