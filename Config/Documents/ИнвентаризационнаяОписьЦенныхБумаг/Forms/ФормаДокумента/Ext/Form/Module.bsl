#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидЦенныхБумагОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением,
	СтандартнаяОбработка)

	Если (Объект.Раздел1.Количество() > 0 Или Объект.Раздел21.Количество() > 0 Или Объект.Раздел22.Количество() > 0
		Или Объект.Раздел3.Количество() > 0 Или Объект.Раздел4.Количество() > 0) 
		И ВыбранноеЗначение	<> Объект.ВидЦенныхБумаг Тогда

		СтандартнаяОбработка = Ложь;
		ВопросПриВыбореВидаЦенныхБумагАсинх(ВыбранноеЗначение);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВидЦенныхБумагНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.Счет) Тогда
		НаДату = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(Объект.ДатаИнвентаризации);
		ЗначенияПараметровВыбора = Новый Массив;
		ЗначенияПараметровВыбора.Добавить(Новый ПараметрВыбора("Счет", Объект.Счет));
		ЗначенияПараметровВыбора.Добавить(Новый ПараметрВыбора("Организация", Объект.Организация));
		ЗначенияПараметровВыбора.Добавить(Новый ПараметрВыбора("НаДату", НаДату));
		Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(ЗначенияПараметровВыбора);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаЦенныхБумагОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением,
	СтандартнаяОбработка)

	Если (Объект.Раздел1.Количество() > 0 Или Объект.Раздел21.Количество() > 0 Или Объект.Раздел22.Количество() > 0
		Или Объект.Раздел3.Количество() > 0 Или Объект.Раздел4.Количество() > 0) 
		И ВыбранноеЗначение	<> Объект.ФормаЦенныхБумаг Тогда

		СтандартнаяОбработка = Ложь;
		ВопросПриВыбореФормыЦенныхБумагАсинх(ВыбранноеЗначение);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РешениеОПроведенииИнвентаризацииОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные,
	ВыборДобавлением, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормыВыборДанных = ПараметрыФормыВыборДанныхИзРешения(Объект.Ссылка, ВыбранноеЗначение, 
		УникальныйИдентификатор);
	
	Если ПараметрыФормыВыборДанных.РешениеСодержитДанныеДляЗаполненияОписи Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Решение", ВыбранноеЗначение);
		
		ОписаниеОповещенияВыбор = 
			Новый ОписаниеОповещения("ЗаполнитьОписьПослеВыбораДанныхИзРешения", ЭтотОбъект,
			ДополнительныеПараметры);
		
		ОткрытьФорму("ОбщаяФорма.ВыборДанныхИзРешенияОПроведенииИнвентаризации", ПараметрыФормыВыборДанных,
			ЭтотОбъект, , , , ОписаниеОповещенияВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением,
	СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Объект.Организация) И ВыбранноеЗначение <> Объект.Организация Тогда
		ОчиститьРаздел1(ЭтотОбъект);
		ОчиститьРаздел21(ЭтотОбъект);
		ОчиститьРаздел22(ЭтотОбъект);
		ОчиститьРаздел3(ЭтотОбъект);
		ОчиститьРаздел4(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	ОчиститьРаздел1(ЭтотОбъект);
	ОчиститьРаздел21(ЭтотОбъект);
	ОчиститьРаздел22(ЭтотОбъект);
	ОчиститьРаздел3(ЭтотОбъект);
	ОчиститьРаздел4(ЭтотОбъект);
КонецПроцедуры

