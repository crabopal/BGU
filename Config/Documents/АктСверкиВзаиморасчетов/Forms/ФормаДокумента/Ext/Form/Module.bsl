Процедура ОрганизацияПередИзменениемКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Объект["Организация"] = ПараметрыОповещения["ВыбранноеЗначение"];
		Модифицированность = Истина;
		ОрганизацияПриИзмененииКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПриИзмененииКлиент()
	
	ОрганизацияПриИзмененииСервер();
	
	ПересчитатьИтогоОстатки(ЭтаФорма);
	
КонецПроцедуры
&НаСервере
Процедура ОрганизацияПриИзмененииСервер()
	
	Если Объект["ПоВсемОрганизациям"] Тогда
		// При учете по нескольким организациям
		// ничего не очищаем.
		ПересчитатьИтогоОстатки(ЭтаФорма);
	Иначе
		// При учете только по одной организации
		// очищаем все, связанное с ней:
		ОчиститьРеквизитыНесоответствующиеОрганизации();
	КонецЕсли;
	
	УстановитьОтветственныхЛицСервер();
	
КонецПроцедуры	
&НаСервере
Процедура ОчиститьРеквизитыНесоответствующиеОрганизации()
	
	Объект["ПоДаннымОрганизации"].Очистить();
	Объект["ПоДаннымКонтрагента"].Очистить();
	
	Если ИспользуетсяДеревоОстатков(Объект) Тогда
		ЭтаФорма["ОстаткиПоДоговорам"].ПолучитьЭлементы().Очистить();
	Иначе
		Объект["СписокОрганизаций"].Очистить();
	КонецЕсли;
	КоличествоСтрокОстатков = 0;
	
	ПересчитатьИтогоОстатки(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОбновлениеПолей(ТекущиеДанныеСтруктура, ИмяИзмененногоПоля)
	
	ОбновлениеПолей = Новый Структура();
	
	Если ИмяИзмененногоПоля = "Договор" Тогда
		
		ДоговорСсылка = ТекущиеДанныеСтруктура["Договор"];
		
		Организация = ?(ЗначениеЗаполнено(ДоговорСсылка),
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "Организация"),
			Неопределено);
			
		ОбновлениеПолей.Вставить("Организация", Организация);
		
		// Очищаем поля
		
		ОбновлениеПолей.Вставить("ДатаУчетногоДокумента");
		ОбновлениеПолей.Вставить("Документ");
		
		ОбновлениеПолей.Вставить("Дата");
		ОбновлениеПолей.Вставить("Представление");

	ИначеЕсли ИмяИзмененногоПоля = "Документ" Тогда
		
		ДокументСсылка = ТекущиеДанныеСтруктура["Документ"];
		
		// Очищаем поля
		ОбновлениеПолей.Вставить("ДатаУчетногоДокумента");
		ОбновлениеПолей.Вставить("Дата");
		ОбновлениеПолей.Вставить("Представление");
		ОбновлениеПолей.Вставить("Ответственный");
		
		Если ЗначениеЗаполнено(ДокументСсылка) Тогда
			
			РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата,Ответственный");
			
			ДатаДокумента = РеквизитыДокумента.Дата;
			
			СтрокаТабличнойЧасти = Новый Структура();
			СтрокаТабличнойЧасти.Вставить("Документ",	ТекущиеДанныеСтруктура["Документ"]);
			СтрокаТабличнойЧасти.Вставить("Договор",	ТекущиеДанныеСтруктура["Договор"]);
			СтрокаТабличнойЧасти.Вставить("Дата",		ДатаДокумента);
			
			СтруктураШапки = Документы.АктСверкиВзаиморасчетов.ПолучитьСтруктуруШапкиДляОпределенияПредставленияДокумента();
			
			ЗаполнитьЗначенияСвойств(СтруктураШапки, Объект);
			
			ПредставлениеДокумента = Документы.АктСверкиВзаиморасчетов.ПолучитьПредставлениеДокумента(СтрокаТабличнойЧасти, СтруктураШапки);
			
			ОбновлениеПолей.Вставить("ДатаУчетногоДокумента",	ДатаДокумента);
			ОбновлениеПолей.Вставить("Дата",					ПредставлениеДокумента["Дата"]);
			ОбновлениеПолей.Вставить("Представление",			ПредставлениеДокумента["Представление"]);
			ОбновлениеПолей.Вставить("Ответственный",			РеквизитыДокумента.Ответственный);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОбновлениеПолей;
	
КонецФункции

&НаСервере
Функция ПолучитьОбновлениеПолейЭДО(ТекущиеДанныеСтруктура, ИмяИзмененногоПоля)
	
	ОбновлениеПолей = Новый Структура("
		|ДатаУчетногоДокумента,
		|Документ,
		|Дата,
		|Представление,
		|НомерДокумента,
		|ДатаДокумента,
		|НаименованиеДокумента,
		|НаименованиеОперации,
		|Ответственный");
	
	Если ИмяИзмененногоПоля = "Договор" Тогда
		// При изменении договора никакие поля не заполняем.
		
	ИначеЕсли ИмяИзмененногоПоля = "Документ" Тогда
		
		Документ = ТекущиеДанныеСтруктура.Документ;
		
		ОбновлениеПолей.Документ = Документ;
		
		Если ЗначениеЗаполнено(Документ) Тогда
			
			СвойстваДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "Дата,Ответственный");
			
			ДатаУчетногоДокумента = СвойстваДокумента.Дата;
			
			СтрокаТабличнойЧасти = Новый Структура();
			СтрокаТабличнойЧасти.Вставить("Документ",	Документ);
			СтрокаТабличнойЧасти.Вставить("Договор",	ТекущиеДанныеСтруктура.Договор);
			СтрокаТабличнойЧасти.Вставить("Дата",		ДатаУчетногоДокумента);
			
			СтруктураШапки = Документы.АктСверкиВзаиморасчетов.ПолучитьСтруктуруШапкиДляОпределенияПредставленияДокумента();
			
			ЗаполнитьЗначенияСвойств(СтруктураШапки, Объект);
			
			ПредставлениеДокумента = Документы.АктСверкиВзаиморасчетов.ПолучитьПредставлениеДокумента(СтрокаТабличнойЧасти, СтруктураШапки);
			
			Дата = ПредставлениеДокумента.Дата;
			
			Если Не ЗначениеЗаполнено(Дата) Тогда
				Дата = ДатаУчетногоДокумента;
			КонецЕсли;
			
			ОбновлениеПолей.ДатаУчетногоДокумента	= ДатаУчетногоДокумента;
			ОбновлениеПолей.Дата					= Дата;
			ОбновлениеПолей.Представление			= ПредставлениеДокумента.Представление;
			ОбновлениеПолей.НомерДокумента			= ПредставлениеДокумента.Номер;
			ОбновлениеПолей.ДатаДокумента			= Дата;
			ОбновлениеПолей.НаименованиеДокумента	= Строка(ТипЗнч(Документ));
			ОбновлениеПолей.НаименованиеОперации	= Документы.АктСверкиВзаиморасчетов.ПредставлениеХозяйственнойОперации(Документ, 0, 0);
			ОбновлениеПолей.Ответственный			= СвойстваДокумента.Ответственный;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОбновлениеПолей;
	
КонецФункции

//---
// Настройка элементов формы
//---

&НаКлиентеНаСервереБезКонтекста 
Процедура НастроитьФормуКлиентСервер_ПриИзмененииСверкаСогласована(Форма)
	
	СверкаСогласована = Форма["Объект"]["СверкаСогласована"];
	
	ИменаДоступность = Новый Структура("
		|Организация,
		|Подразделение,
		|Договор,
		|Контрагент,
		|ВалютаДокумента,
		|ИФО,
		|БезУчетаИФО,
		|КФО,
		|ДатаНачала,
		|ДатаОкончания,
		|УстановитьПериод,
		|РазделятьАкты,
		|РазбитьПоДоговорам,
			|ДетализироватьПоДоговорам,
		|ПоВсемОрганизациям,
		// Кнопки командной панели
			|ОстаткиПоДоговорамДобавить,
			|ОстаткиПоДоговорамДобавитьСтрокуОрганизации,
			|ОстаткиПоДоговорамРассчитатьРасхождения,
		|СписокОрганизацийРассчитатьРасхождения,
		|ПоДаннымОрганизацииЗаполнитьПоДаннымБухУчета,
		|ПоДаннымКонтрагентаЗаполнитьПоДаннымОрганизации,
		|СписокСчетовЗаполнитьСчетамиПоУмолчанию,
		|СписокСчетовСнятьВсе,
		|СписокСчетовУстановитьВсе");
	ИменаТолькоПросмотр = Новый Структура("
		|ПоДаннымОрганизации,
		|ПоДаннымКонтрагента,
		|СписокОрганизаций,
			|ОстаткиПоДоговорам,
		|СписокСчетов,
			|ГруппаОстаткиПоДаннымОрганизации");
	
	Для Каждого Элем Из ИменаДоступность Цикл
		ИмяЭлемента = Элем.Ключ;
		Если ИмяЭлемента = "РазделятьАкты" Тогда
			НовДоступность = НЕ СверкаСогласована И Форма.Объект["ПоВсемОрганизациям"];
		Иначе
			НовДоступность = НЕ СверкаСогласована;
		КонецЕсли;
		Форма.Элементы[ИмяЭлемента].Доступность = НовДоступность;
	КонецЦикла;
	Для Каждого Элем Из ИменаТолькоПросмотр Цикл
		Форма.Элементы[Элем.Ключ].ТолькоПросмотр = СверкаСогласована;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_УчетПоВсемОрганизациям()
	
	УчетПоВсем = Объект["ПоВсемОрганизациям"];
	
	// Доступность флажка "Разделять акты":
	Элементы["РазделятьАкты"].Доступность = УчетПоВсем;
	
	// Страница "По данным организации":
	Элементы["ПоДаннымОрганизацииОрганизация"].Видимость = УчетПоВсем;
	
	// Cтраница "По данным контрагента":
	Элементы["ПоДаннымКонтрагентаОрганизация"].Видимость = УчетПоВсем;
	
	// Связи параметров выбора:
	НастроитьСвязиПараметровВыбора(Элементы["ПоДаннымОрганизацииДоговор"],	"ПоДаннымОрганизации", УчетПоВсем);
	НастроитьСвязиПараметровВыбора(Элементы["ПоДаннымОрганизацииДокумент"],	"ПоДаннымОрганизации", УчетПоВсем);
	НастроитьСвязиПараметровВыбора(Элементы["ПоДаннымКонтрагентаДоговор"],	"ПоДаннымКонтрагента", УчетПоВсем);
	НастроитьСвязиПараметровВыбора(Элементы["ПоДаннымКонтрагентаДокумент"],	"ПоДаннымКонтрагента", УчетПоВсем);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура НастроитьСвязиПараметровВыбора(Элемент, ИмяТаблЧасти, УчетПоВсем)
	
	ИмяИскомойСвязи		= "Отбор.Организация";
	ПутьКДанным_Шапка	= "Объект.Организация";
	ПутьКДанным_Таблица	= "Элементы." + ИмяТаблЧасти + ".ТекущиеДанные.Организация";
	
	// Обходим все текущие связи параметров выбора:
	ТекСвязиПараметровВыбора = Элемент.СвязиПараметровВыбора;
	ИскомаяСвязьНайдена = Ложь;
	НовМассив = Новый Массив();
	Для Каждого ПараметрВыбора Из ТекСвязиПараметровВыбора Цикл
		Если ПараметрВыбора.Имя = ИмяИскомойСвязи Тогда
			ИскомаяСвязьНайдена = Истина;
			// Обновляем:
			ПутьКДанным = ?(УчетПоВсем, ПутьКДанным_Таблица, ПутьКДанным_Шапка);
			НоваяСвязь = Новый СвязьПараметраВыбора(ПараметрВыбора.Имя, ПутьКДанным);
		Иначе
			// Добавляем как есть:
			НоваяСвязь = Новый СвязьПараметраВыбора(ПараметрВыбора.Имя, ПараметрВыбора.ПутьКДанным);
		КонецЕсли;
		НовМассив.Добавить(НоваяСвязь);
		
	КонецЦикла;
	
	// Нашли искомую настраиваемую связь?
	Если НЕ ИскомаяСвязьНайдена Тогда
		// Добавляем новую связь:
		ПутьКДанным = ?(УчетПоВсем, ПутьКДанным_Таблица, ПутьКДанным_Шапка);
		НоваяСвязь = Новый СвязьПараметраВыбора(ИмяИскомойСвязи, ПутьКДанным);
		НовМассив.Добавить(НоваяСвязь);
	КонецЕсли;
	
	// Устанавливаем новые параметры связи:
	Элемент.СвязиПараметровВыбора = Новый ФиксированныйМассив(НовМассив);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеПоля_Организация(ИмяТаблицыФормы)
	
	ТекДанные = Элементы[ИмяТаблицыФормы].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НовыеЗначения = Новый Структура("Дата, Представление");
	
	ЗаполнитьЗначенияСвойств(ТекДанные, НовыеЗначения);
	
КонецПроцедуры
&НаКлиенте
Процедура ОбработатьИзменениеПоля_Договор(ИмяТаблицыФормы)
	
	ТекДанные = Элементы[ИмяТаблицыФормы].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеСтруктура = Новый Структура("Договор");
	ЗаполнитьЗначенияСвойств(ТекущиеДанныеСтруктура, ТекДанные);
	
	НовыеЗначения = ПолучитьОбновлениеПолей(ТекущиеДанныеСтруктура, "Договор");
	
	ЗаполнитьЗначенияСвойств(ТекДанные, НовыеЗначения);
	
КонецПроцедуры
&НаКлиенте
Процедура ОбработатьИзменениеПоля_Документ(ИмяТаблицыФормы)
	
	ТекДанные = Элементы[ИмяТаблицыФормы].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеСтруктура = Новый Структура("Договор,Документ");
	ЗаполнитьЗначенияСвойств(ТекущиеДанныеСтруктура, ТекДанные);
	
	НовыеЗначения = ПолучитьОбновлениеПолей(ТекущиеДанныеСтруктура, "Документ");
	
	ЗаполнитьЗначенияСвойств(ТекДанные, НовыеЗначения);
	
КонецПроцедуры
&НаКлиенте
Процедура ОбработатьИзменениеПоля_Представление(ИмяТаблицыФормы)
	
	ТекДанные = Элементы[ИмяТаблицыФормы].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные["Представление"] = СокрЛП(ТекДанные["Представление"]);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыОстатков()
	
	ВидимостьКолонкиДоговор		= Документы.АктСверкиВзаиморасчетов.ИспользуетсяКолонкаДоговор(Объект);
	ВидимостьКолонкиОрганизация	= Документы.АктСверкиВзаиморасчетов.ИспользуетсяКолонкаОрганизация(Объект);
	
	Если Документы.АктСверкиВзаиморасчетов.ИспользуетсяТаблицаОстатков(Объект) Тогда
		ВидимостьТаблицы	= Истина;
		ВидимостьДерева		= Ложь;
		
	ИначеЕсли Документы.АктСверкиВзаиморасчетов.ИспользуетсяДеревоОстатков(Объект) Тогда
		ВидимостьТаблицы	= Ложь;
		ВидимостьДерева		= Истина;
		
	Иначе
		ВидимостьТаблицы	= Ложь;
		ВидимостьДерева		= Ложь;
	КонецЕсли;
	
	Элементы["СписокОрганизаций"].Видимость				= ВидимостьТаблицы;
	Элементы["СписокОрганизацийДоговор"].Видимость		= ВидимостьКолонкиДоговор;
	Элементы["СписокОрганизацийОрганизация"].Видимость	= ВидимостьКолонкиОрганизация;
	
	Элементы["ОстаткиПоДоговорам"].Видимость			= ВидимостьДерева;
	
	// Таблицы взаиморасчетов
	ИспользоватьСтраницы = (ВидимостьТаблицы ИЛИ ВидимостьДерева);
	Если ИспользоватьСтраницы Тогда
		ПоложениеЗаголовкаПоДаннымКонтрагента	= ПоложениеЗаголовкаЭлементаФормы.Верх;
		ЭлементРодительПоДаннымОрганизации		= Элементы["СтраницаВзаиморасчеты"];
		ВставитьПередЭлементом					= Неопределено;
	Иначе
		ПоложениеЗаголовкаПоДаннымКонтрагента	= ПоложениеЗаголовкаЭлементаФормы.Нет;
		ЭлементРодительПоДаннымОрганизации		= Элементы["ГруппаПоДаннымОрганизации"];
		ВставитьПередЭлементом					= Элементы["ИтогоПоДаннымОрганизации"]
	КонецЕсли;
	Элементы["ПоДаннымКонтрагента"].ПоложениеЗаголовка = ПоложениеЗаголовкаПоДаннымКонтрагента;
	Элементы.Переместить(Элементы["ПоДаннымОрганизации"], ЭлементРодительПоДаннымОрганизации, ВставитьПередЭлементом);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьГруппы(Развернуть)
	
	СтрокиОрганизаций = ЭтаФорма["ОстаткиПоДоговорам"].ПолучитьЭлементы();
	
	Для Каждого СтрокаОрганизации Из СтрокиОрганизаций Цикл
		ИдСтроки = СтрокаОрганизации.ПолучитьИдентификатор();
		
		Если Развернуть Тогда
			Элементы["ОстаткиПоДоговорам"].Развернуть(ИдСтроки);
		Иначе
			Элементы["ОстаткиПоДоговорам"].Свернуть(ИдСтроки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФлажки(Установить)
	
	Для Каждого СтрокаТаблицы Из Объект["СписокСчетов"] Цикл
		СтрокаТаблицы["УчаствуетВРасчетах"] = Установить;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФлажокРазделятьАкты()
	
	// Сбрасываем флажок "Разделять акты", если необходимо
	Если НЕ Объект["ПоВсемОрганизациям"] И Объект["РазделятьАкты"] Тогда
		Объект["РазделятьАкты"] = Ложь;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

//---
// Заполнение по данным учета
//---

&НаКлиенте
Функция ВходныеДанныеЗаполнены()

	// Проверим корректность входных данных для заполнения.
	
	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект["Организация"])
		И НЕ Объект["ПоВсемОрганизациям"] Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не выбрана организация'"),
			Объект.Ссылка,
			"Объект.Организация");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не выбран контрагент'"),
			Объект.Ссылка,
			"Объект.Контрагент");
	КонецЕсли;
	
	Если ИспользоватьВалютныйУчет И НЕ ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не выбрана валюта документа'"),
			Объект.Ссылка,
			"Объект.ВалютаДокумента");
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не выбрана дата начала периода сверки расчетов'"),
			Объект.Ссылка,
			"Объект.ДатаНачала");
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не выбрана дата окончания периода сверки расчетов'"),
			Объект.Ссылка,
			"Объект.ДатаОкончания");
	КонецЕсли;
		
	Если Объект.ДатаОкончания < Объект.ДатаНачала Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Дата окончания периода сверки должна быть больше даты начала'"),
			Объект.Ссылка,
			"Объект.ДатаОкончания");
	КонецЕсли;

	// Количество счетов, участвующих в расчетах, должно быть больше 0:
	ФильтрСписокСчетов = Новый Массив();
	Для Каждого СтрокаСчета Из Объект.СписокСчетов Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаСчета.Счет) ИЛИ СтрокаСчета.УчаствуетВРасчетах = Ложь Тогда
			Продолжить;
		Иначе
			ФильтрСписокСчетов.Добавить(СтрокаСчета.Счет);
		КонецЕсли; 
	КонецЦикла; 
	Если ФильтрСписокСчетов.Количество() = 0 Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не выбран ни один счет учета расчетов'"),
			Объект.Ссылка,
			"Объект.СписокСчетов");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымБухУчета()
	
	Если ВходныеДанныеЗаполнены() Тогда
		
		Если Объект["ПоДаннымОрганизации"].Количество() > 0 Тогда
			ТекстСообщения = НСтр("ru='Перед заполнением по данным учета будет очищена
				|табличная часть ""По данным организации"".
				|
				|Продолжить и заполнить по данным учета?'");
				
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьПоДаннымБухУчета_Выбор", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
		Иначе
			ЗаполнитьПоДаннымБухУчетаКлиент();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымБухУчета_Выбор(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоДаннымБухУчетаКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ЗаполнитьПоДаннымБухУчетаКлиент()
	
	РезультатЗадания = ЗаполнитьПоДаннымБухУчетаСервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияПоДаннымБухУчетаКлиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры
&НаСервере
Функция ЗаполнитьПоДаннымБухУчетаСервер()
	
	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение акта сверки'");
	
	ПараметрыПроцедуры = ПолучитьПараметрыПроцедуры();
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.АктСверкиВзаиморасчетов.ПолучитьДанныеБухУчета",
		ПараметрыПроцедуры, ПараметрыЗадания);
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияПоДаннымБухУчетаКлиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		ЗавершениеЗаполненияПоДаннымБухУчетаСервер(Результат.АдресРезультата);
		
		Если ИспользуетсяДеревоОстатков(Объект) Тогда
			ДеревоОстатковПоДоговорам_РазвернутьПервуюСтроку();
		КонецЕсли;
		
		// Если по данным учета не было добавлено ни одной строки, выведем сообщение:
		НетОборотов = (Объект.ПоДаннымОрганизации.Количество() = 0);
		НетОстатков = НЕ ЗначениеЗаполнено(Объект.ОстатокНаНачало);
		
		Если НетОборотов И НетОстатков Тогда
			ТекстСообщения = НСтр("ru='Данные учета, соответствующие условиям поиска, отсутствуют'");
			
			ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
		КонецЕсли;
		
	Иначе
		
		ПоказатьПредупреждение(, НСтр("ru='При заполнении акта сверки возникла ошибка'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияПоДаннымБухУчетаСервер(АдресРезультата)
	
	РезультатыСверки = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Объект["ПоДаннымОрганизации"].Загрузить(РезультатыСверки["Обороты"]);
	
	Объект["СписокОрганизаций"].Загрузить(РезультатыСверки["ОстаткиНаНачало"]);
	
	Документы.АктСверкиВзаиморасчетов.РассчитатьРасхождения(Объект);
	
	КоличествоСтрокОстатков = Объект["СписокОрганизаций"].Количество();
	
	Если ИспользуетсяДеревоОстатков(Объект) Тогда
		ДеревоОстатковПоДоговорам_ЗаполнитьДеревоОстатковПоДоговорамИзТаблицы();
	КонецЕсли;
	
	ПересчитатьИтогоОстатки(ЭтаФорма);
	
	ОшибкиНастроекПредставления = РезультатыСверки["ОшибкиНастроекПредставленияДокументаДлительныеДоговоры"];
	
	Если ТипЗнч(ОшибкиНастроекПредставления) = Тип("Массив") Тогда
		Для Каждого ТекстСообщения Из ОшибкиНастроекПредставления Цикл
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыПроцедуры()
	
	ПараметрыПроцедуры = Новый Структура();
	ПараметрыПроцедуры.Вставить("ШапкаДокумента",			Документы.АктСверкиВзаиморасчетов.ПолучитьСтруктуруШапкиДокумента(Объект));
	ПараметрыПроцедуры.Вставить("СписокОтмеченныхСчетов",	Документы.АктСверкиВзаиморасчетов.ПолучитьСписокОтмеченныхСчетов(Объект));
	
	Возврат ПараметрыПроцедуры;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымОрганизации()
	
	Если Объект["ПоДаннымКонтрагента"].Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru='Перед заполнением будет очищена
			|табличная часть ""По данным контрагента"".
			|
			|Продолжить и заполнить?'");
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьПоДаннымОрганизации_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьПоДаннымОрганизацииКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымОрганизации_Выбор(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоДаннымОрганизацииКлиент();
