	ОбработатьИзменениеОстатокНаНачало();
	
КонецПроцедуры

&НаКлиенте
Процедура ДетализироватьПоДоговорамПриИзменении(Элемент)
	
	Если Объект["ДетализироватьПоДоговорам"] Тогда
		// Флажок был установлен
		// Не требуется обработка строк табличной части СписокОрганизаций
		
		// Применяемые значения, действующие до текущего изменения флажка (и еще не обработанные)
		ПрименяемыеЗначенияФлажков = ПолучитьПрименяемыеЗначенияФлажков("ДетализироватьПоДоговорам");
		
		НастроитьПредставлениеОстатков("ДетализироватьПоДоговорам", ПрименяемыеЗначенияФлажков);
	Иначе
		// Флажок был сброшен
		// Может потребоваться обработка строк табличной части СписокОрганизаций
		
		ПроверитьИОчиститьКолонкуДоговор();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИОчиститьКолонкуДоговор()
	
	Если КоличествоСтрокОстатков > 0 Тогда
		ТекстСообщения = НСтр("ru='При снятии флажка ""Детализировать по договорам"" будут очищены
			|сведения о договорах в таблице ""Остатки"".
			|
			|Продолжить и снять флажок?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИОчиститьКолонкуДоговор_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 40, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		// Применяемые значения, действующие до текущего изменения флажка (и еще не обработанные)
		ПрименяемыеЗначенияФлажков = ПолучитьПрименяемыеЗначенияФлажков();
		НастроитьПредставлениеОстатков("ДетализироватьПоДоговорам", ПрименяемыеЗначенияФлажков);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИОчиститьКолонкуДоговор_Выбор(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		// Применяемые значения, действующие до текущего изменения флажка (и еще не обработанные)
		ПрименяемыеЗначенияФлажков = ПолучитьПрименяемыеЗначенияФлажков("ДетализироватьПоДоговорам");
		
		ОчиститьКолонкуДоговорСервер(ПрименяемыеЗначенияФлажков);
		
		НастроитьПредставлениеОстатков("ДетализироватьПоДоговорам", ПрименяемыеЗначенияФлажков);
	Иначе
		// Возвращаем прежнее значение реквизиту
		Объект["ДетализироватьПоДоговорам"] = Истина;
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура ОчиститьКолонкуДоговорСервер(ПрименяемыеЗначенияФлажков)
	
	Если ИспользуетсяДеревоОстатков(ПрименяемыеЗначенияФлажков) Тогда
		ДеревоОстатковПоДоговорам_ЗаполнитьТаблицуОстатковПоДоговорамИзДерева(Объект);
	КонецЕсли;
	
	ТаблицаСписокОрганизаций = Объект["СписокОрганизаций"].Выгрузить();
	Для Каждого СтрокаТаблицы Из ТаблицаСписокОрганизаций Цикл
		СтрокаТаблицы["Договор"] = Неопределено;
	КонецЦикла;
	ТаблицаСписокОрганизаций.Свернуть("Организация,Договор", "ОстатокНаНачало");
	Объект["СписокОрганизаций"].Загрузить(ТаблицаСписокОрганизаций);
	
	Если ИспользуетсяДеревоОстатков(ПрименяемыеЗначенияФлажков) Тогда
		ДеревоОстатковПоДоговорам_ЗаполнитьДеревоОстатковПоДоговорамИзТаблицы();
	КонецЕсли;
	
КонецПроцедуры

