КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьСчетамиПоУмолчанию()
	
	Если Объект["СписокСчетов"].Количество()>0 Тогда
		ТекстСообщения = НСтр("ru='Перед заполнением будет очищена
			|табличная часть ""Счета учета расчетов"".
			|
			|Продолжить и заполнить?'");
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьСчетамиПоУмолчанию_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьСчетамиПоУмолчаниюНаСервере();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьСчетамиПоУмолчанию_Выбор(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьСчетамиПоУмолчаниюНаСервере();
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьСчетамиПоУмолчаниюНаСервере()
	
	Документы.АктСверкиВзаиморасчетов.ЗаполнитьСчетамиПоУмолчанию(Объект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДаннымОрганизацииСервер()
	
	ПоДаннымКонтрагента = Объект["ПоДаннымОрганизации"].Выгрузить();
	
	ПоДаннымКонтрагента.Колонки.Дебет.Имя  = "КредитК";
	ПоДаннымКонтрагента.Колонки.Кредит.Имя = "Дебет";
	ПоДаннымКонтрагента.Колонки.КредитК.Имя= "Кредит";
	
	Объект["ПоДаннымКонтрагента"].Загрузить(ПоДаннымКонтрагента);
	
	РассчитатьРасхожденияСервер();
	
	ПересчитатьИтогоОстатки(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИУдалитьСтрокиОтличающихсяОрганизаций()
	
	ВзаиморасчетыЗаполнены = (Объект["ПоДаннымОрганизации"].Количество() > 0 ИЛИ Объект["ПоДаннымКонтрагента"].Количество() > 0);
	
	ОстаткиЗаполнены = (КоличествоСтрокОстатков > 0);
	
	Если ВзаиморасчетыЗаполнены ИЛИ ОстаткиЗаполнены Тогда
		Шаблон = НСтр("ru='При снятии флажка ""По всем организациям"" будут удалены
			|некоторые строки в табличных частях документа.
			|
			|Будут оставлены только строки по организации из шапки документа
			|%1
			|
			|Продолжить и снять флажок?'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Объект["Организация"]);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИУдалитьСтрокиОтличающихсяОрганизаций_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 40, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		НеТребуетсяУдалитьСтрокиОтличающихсяОрганизацийКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИУдалитьСтрокиОтличающихсяОрганизаций_Выбор(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		УдалитьСтрокиОтличающихсяОрганизацийКлиент();
	Иначе
		// Возвращаем прежнее значение реквизиту
		Объект["ПоВсемОрганизациям"] = Истина;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура УдалитьСтрокиОтличающихсяОрганизацийКлиент()
	
	// Действующие значения реквизитов, определяющие режим отображения и работы с остатками
	ПрименяемыеЗначенияФлажков = ПолучитьПрименяемыеЗначенияФлажков("ПоВсемОрганизациям");
	
	УдалитьСтрокиОтличающихсяОрганизацийСервер(ПрименяемыеЗначенияФлажков);
	
	ПересчитатьИтогоОстатки(ЭтаФорма);
	
	НастроитьФлажокРазделятьАкты();
	
КонецПроцедуры
&НаСервере
Процедура УдалитьСтрокиОтличающихсяОрганизацийСервер(ПрименяемыеЗначенияФлажков)
	
	Если Документы.АктСверкиВзаиморасчетов.ИспользуетсяДеревоОстатков(ПрименяемыеЗначенияФлажков) Тогда
		ДеревоОстатковПоДоговорам_ЗаполнитьТаблицуОстатковПоДоговорамИзДерева(Объект);
	КонецЕсли;
	
	Документы.АктСверкиВзаиморасчетов.УдалитьСтрокиОтличающихсяОрганизаций(Объект);
	
	Если Документы.АктСверкиВзаиморасчетов.ИспользуетсяДеревоОстатков(ПрименяемыеЗначенияФлажков) Тогда
		ДеревоОстатковПоДоговорам_ЗаполнитьДеревоОстатковПоДоговорамИзТаблицы();
	КонецЕсли;
	
	НастроитьПредставлениеОстатков("ПоВсемОрганизациям", ПрименяемыеЗначенияФлажков);
	
КонецПроцедуры
&НаКлиенте
Процедура НеТребуетсяУдалитьСтрокиОтличающихсяОрганизацийКлиент()
	
	// Действующие значения реквизитов, определяющие режим отображения и работы с остатками
	ПрименяемыеЗначенияФлажков = ПолучитьПрименяемыеЗначенияФлажков("ПоВсемОрганизациям");
	
	НеТребуетсяУдалитьСтрокиОтличающихсяОрганизацийСервер(ПрименяемыеЗначенияФлажков);
	
	ПересчитатьИтогоОстатки(ЭтаФорма);
	
	НастроитьФлажокРазделятьАкты();
	
КонецПроцедуры
&НаСервере
Процедура НеТребуетсяУдалитьСтрокиОтличающихсяОрганизацийСервер(ПрименяемыеЗначенияФлажков)
	
	НастроитьФормуСервер_УчетПоВсемОрганизациям();
	
	НастроитьПредставлениеОстатков("ПоВсемОрганизациям", ПрименяемыеЗначенияФлажков);

КонецПроцедуры

//---
// Работа с остатками
//---

&НаКлиенте
Процедура ОбработатьИзменениеОстатокНаНачало()
	
	Дельта = Объект["ОстатокНаНачало"] - ЭтаФорма["ОстатокНаНачало_ПрежнееЗначение"];
	
	Если Дельта = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗапомнитьОстатокНаНачало(ЭтаФорма);
	
	ДобавитьНовуюСтроку	= (КоличествоСтрокОстатков = 0);
	УдалитьВсеСтроки	= (КоличествоСтрокОстатков = 1 И Объект["ОстатокНаНачало"] = 0);
	
	Если ДобавитьНовуюСтроку Тогда
		Если ИспользуетсяДеревоОстатков(Объект) Тогда
			ЭтаФорма["ОстаткиПоДоговорам"].ПолучитьЭлементы().Очистить();
			
			СтрокаОрганизации = ЭтаФорма["ОстаткиПоДоговорам"].ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОрганизации, Объект, "Организация,ОстатокНаНачало");
			СтрокаОрганизации["ЭтоГруппа"] = Истина;
			
			НоваяСтрока = СтрокаОрганизации.ПолучитьЭлементы().Добавить();
			
			ДеревоОстатковПоДоговорам_РазвернутьПервуюСтроку();
		Иначе
			НоваяСтрока = Объект["СписокОрганизаций"].Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Объект, "Организация,ОстатокНаНачало");
		КоличествоСтрокОстатков = 1;
		
	ИначеЕсли УдалитьВсеСтроки Тогда
		Если ИспользуетсяДеревоОстатков(Объект) Тогда
			ЭтаФорма["ОстаткиПоДоговорам"].ПолучитьЭлементы().Очистить();
		Иначе
			Объект["СписокОрганизаций"].Очистить();
		КонецЕсли;
		КоличествоСтрокОстатков = 0;
		
	Иначе
		// Корректируем значение в самой первой строке
		Если ИспользуетсяДеревоОстатков(Объект) Тогда
			СтрокаПервойОрганизации = ЭтаФорма["ОстаткиПоДоговорам"].ПолучитьЭлементы()[0];
			СтрокаПервойОрганизации["ОстатокНаНачало"] = СтрокаПервойОрганизации["ОстатокНаНачало"] + Дельта;
			
			СтрокиДоговоров = СтрокаПервойОрганизации.ПолучитьЭлементы();
			Если СтрокиДоговоров.Количество() > 0 Тогда
				СтрокаПервогоДоговора = СтрокиДоговоров[0];
				СтрокаПервогоДоговора["ОстатокНаНачало"] = СтрокаПервогоДоговора["ОстатокНаНачало"] + Дельта;
			КонецЕсли;
		Иначе
			ПерваяСтрокаТЧ = Объект["СписокОрганизаций"][0];
			ПерваяСтрокаТЧ["ОстатокНаНачало"] = ПерваяСтрокаТЧ["ОстатокНаНачало"] + Дельта;
		КонецЕсли;
		
	КонецЕсли;
	
	ПересчитатьИтогоОстатки(ЭтаФорма);
	
	Объект["ТребуетсяРасчетСумм"] = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОпределитьКоличествоСтрокОстатков()
	
	Если ИспользуетсяДеревоОстатков(Объект) Тогда
		ДеревоОстатковПоДоговорам_ОпределитьКоличествоСтрокОстаткиПоДоговорам();
	Иначе
		КоличествоСтрокОстатков = Объект["СписокОрганизаций"].Количество();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПрименяемыеЗначенияФлажков(ИмяИзмененногоФлажка = Неопределено)
	
	ПрименяемоеЗначениеПоВсемОрганизациям			= Объект["ПоВсемОрганизациям"];
	ПрименяемоеЗначениеДетализироватьПоДоговорам	= Объект["ДетализироватьПоДоговорам"];
	
	Если ИмяИзмененногоФлажка = "ПоВсемОрганизациям" Тогда
		ПрименяемоеЗначениеПоВсемОрганизациям = НЕ ПрименяемоеЗначениеПоВсемОрганизациям;
	ИначеЕсли ИмяИзмененногоФлажка = "ДетализироватьПоДоговорам" Тогда
		ПрименяемоеЗначениеДетализироватьПоДоговорам = НЕ ПрименяемоеЗначениеДетализироватьПоДоговорам;
	КонецЕсли;
	
	ПрименяемыеЗначенияФлажков = Новый Структура();
	ПрименяемыеЗначенияФлажков.Вставить("ПоВсемОрганизациям",			ПрименяемоеЗначениеПоВсемОрганизациям);
	ПрименяемыеЗначенияФлажков.Вставить("ДетализироватьПоДоговорам",	ПрименяемоеЗначениеДетализироватьПоДоговорам);
	
	Возврат ПрименяемыеЗначенияФлажков;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИтогоОстатокНаНачало(Форма)
	
	Объект = Форма["Объект"];
	
	Если ИспользуетсяДеревоОстатков(Объект) Тогда
		Возврат ДеревоОстатковПоДоговорам_ПолучитьИтогоОстатокНаНачало(Форма);
	Иначе
		Возврат Объект["СписокОрганизаций"].Итог("ОстатокНаНачало");
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗапомнитьОстатокНаНачало(Форма)
	
	Форма["ОстатокНаНачало_ПрежнееЗначение"] = Форма["Объект"]["ОстатокНаНачало"];
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьИтогоОстатки(Форма, ПересчитатьРеквизитыОбъекта = Истина)
	
	Объект = Форма["Объект"];
	
	// Остатки на начало
	Если ПересчитатьРеквизитыОбъекта Тогда
		Объект["ОстатокНаНачало"]		= ПолучитьИтогоОстатокНаНачало(Форма);
	КонецЕсли;
	Форма["ОстатокНаНачалоКонтрагент"]	= - Объект["ОстатокНаНачало"];
	
	// Остатки на конец
	ОборотПоДаннымОрганизации			= Объект["ПоДаннымОрганизации"].Итог("Дебет") - Объект["ПоДаннымОрганизации"].Итог("Кредит");
	ОборотПоДаннымКонтрагента			= Объект["ПоДаннымКонтрагента"].Итог("Дебет") - Объект["ПоДаннымКонтрагента"].Итог("Кредит");
	Форма["ОстатокНаКонец"]				= Объект["ОстатокНаНачало"]				+ ОборотПоДаннымОрганизации;
	Форма["ОстатокНаКонецКонтрагент"]	= Форма["ОстатокНаНачалоКонтрагент"]	+ ОборотПоДаннымКонтрагента;
	
	// Расхождения
	Если ПересчитатьРеквизитыОбъекта Тогда
		Объект["Расхождение"]			= Форма["ОстатокНаКонец"] + Форма["ОстатокНаКонецКонтрагент"];
	КонецЕсли;
	Форма["РасхождениеКонтрагент"]		= - Объект["Расхождение"];
	
	ЗапомнитьОстатокНаНачало(Форма);
	
КонецПроцедуры

&НаСервере
Функция ПеренестиОстаткиПриНеобходимости(ПрименяемыеЗначенияФлажков)
	
	ПеренестиИзТаблицыВДерево	= Ложь;
	ПеренестиИзДереваВТаблицу	= Ложь;
	
	ПреждеИспользоваласьТаблица	= Документы.АктСверкиВзаиморасчетов.ИспользуетсяТаблицаОстатков(ПрименяемыеЗначенияФлажков);
	ПреждеИспользовалосьДерево	= Документы.АктСверкиВзаиморасчетов.ИспользуетсяДеревоОстатков(ПрименяемыеЗначенияФлажков);
	
	ТеперьИспользуетсяТаблица	= Документы.АктСверкиВзаиморасчетов.ИспользуетсяТаблицаОстатков(Объект);
	ТеперьИспользуетсяДерево	= Документы.АктСверкиВзаиморасчетов.ИспользуетсяДеревоОстатков(Объект);
	
	Если ПреждеИспользоваласьТаблица И ТеперьИспользуетсяДерево Тогда
		ПеренестиИзТаблицыВДерево = Истина;
	ИначеЕсли ПреждеИспользовалосьДерево И ТеперьИспользуетсяТаблица Тогда
		ПеренестиИзДереваВТаблицу = Истина;
	КонецЕсли;
	
	Если ПеренестиИзТаблицыВДерево Тогда
		РассчитатьРасхожденияСервер(Ложь);
		ДеревоОстатковПоДоговорам_ЗаполнитьДеревоОстатковПоДоговорамИзТаблицы();
		
	ИначеЕсли ПеренестиИзДереваВТаблицу Тогда
		ДеревоОстатковПоДоговорам_ЗаполнитьТаблицуОстатковПоДоговорамИзДерева(Объект);
		РассчитатьРасхожденияСервер(Ложь);
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура НастроитьПредставлениеОстатков(ИмяИзмененногоФлажка, ПрименяемыеЗначенияФлажков)
	
	ПеренестиОстаткиПриНеобходимости(ПрименяемыеЗначенияФлажков);
	
	НастроитьЭлементыОстатков();
	
	Если ИмяИзмененногоФлажка = "ПоВсемОрганизациям" Тогда
		НастроитьФормуСервер_УчетПоВсемОрганизациям();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИРассчитатьРасхождения()
	
	Если ИспользуетсяДеревоОстатков(Объект) Тогда
		ДеревоОстатковПоДоговорам_ЗапомнитьРедактируемуюСтроку();
	КонецЕсли;
	
	РассчитатьРасхожденияСервер();
	
	ОпределитьКоличествоСтрокОстатков();
	
	Если ИспользуетсяДеревоОстатков(Объект) Тогда
		ДеревоОстатковПоДоговорам_ВосстановитьАктивированнуюСтроку();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьРасхожденияСервер(ПроверитьИспользованиеДерева = Истина)
	
	Если ПроверитьИспользованиеДерева = Истина Тогда
		Если ИспользуетсяДеревоОстатков(Объект) Тогда
			ДеревоОстатковПоДоговорам_ЗаполнитьТаблицуОстатковПоДоговорамИзДерева(Объект);
		КонецЕсли;
	КонецЕсли;
	
	Документы.АктСверкиВзаиморасчетов.РассчитатьРасхождения(Объект);
	
	Если ПроверитьИспользованиеДерева = Истина Тогда
		Если ИспользуетсяДеревоОстатков(Объект) Тогда
			ДеревоОстатковПоДоговорам_ЗаполнитьДеревоОстатковПоДоговорамИзТаблицы();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//---
// Дерево остатков по договорам
//---

// Аналог Документы.АктСверкиВзаиморасчетов.ИспользуетсяДеревоОстатков()
&НаКлиентеНаСервереБезКонтекста
Функция ИспользуетсяДеревоОстатков(Объект)
	
	Возврат Объект["ПоВсемОрганизациям"] И Объект["ДетализироватьПоДоговорам"];
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДеревоОстатковПоДоговорам_ПолучитьИтогоОстатокНаНачало(Форма)
	
	Итого = 0;
	
	Для Каждого СтрокаДерева Из Форма["ОстаткиПоДоговорам"].ПолучитьЭлементы() Цикл
		Итого = Итого + СтрокаДерева["ОстатокНаНачало"];
	КонецЦикла;
	
	Возврат Итого;
	
КонецФункции

&НаСервере
Процедура ДеревоОстатковПоДоговорам_ЗаполнитьДеревоОстатковПоДоговорамИзТаблицы()
	
	ДеревоОстатки = РеквизитФормыВЗначение("ОстаткиПоДоговорам");
	
	Документы.АктСверкиВзаиморасчетов.ЗаполнитьДеревоОстатковПоДоговорамИзТаблицы(
		ДеревоОстатки,
		Объект["СписокОрганизаций"],
		КоличествоСтрокОстатков);
	
	ЗначениеВРеквизитФормы(ДеревоОстатки, "ОстаткиПоДоговорам");
	
КонецПроцедуры

&НаСервере
Процедура ДеревоОстатковПоДоговорам_ЗаполнитьТаблицуОстатковПоДоговорамИзДерева(ТекущийОбъект = Неопределено)
	
	ЗаполняемыйДокумент = ?(ТекущийОбъект = Неопределено, Объект, ТекущийОбъект);
	
	Документы.АктСверкиВзаиморасчетов.ЗаполнитьТаблицуОстатковПоДоговорамИзДерева(
		ЗаполняемыйДокумент["СписокОрганизаций"],
		ЭтаФорма["ОстаткиПоДоговорам"]);
	
КонецПроцедуры

&НаКлиенте
Функция ДеревоОстатковПоДоговорам_ПолучитьТекущуюСтроку()
	
	Если Элементы["ОстаткиПоДоговорам"].ТекущаяСтрока = Неопределено Тогда
		Результат = Неопределено;
	Иначе
		Результат = ЭтаФорма["ОстаткиПоДоговорам"].НайтиПоИдентификатору(Элементы["ОстаткиПоДоговорам"].ТекущаяСтрока);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ДеревоОстатковПоДоговорам_ТекущаяСтрокаЭтоСтрокаОрганизации(ТекущаяСтрока = Неопределено)
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = ДеревоОстатковПоДоговорам_ПолучитьТекущуюСтроку();
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Результат = Ложь;
	Иначе
		Результат = ТекущаяСтрока["ЭтоГруппа"];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ДеревоОстатковПоДоговорам_ПолучитьСтрокуОрганизации(ТекущаяСтрока = Неопределено)
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = ДеревоОстатковПоДоговорам_ПолучитьТекущуюСтроку();
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено Тогда
		СтрокаОрганизации = Неопределено;
	Иначе
		Если ТекущаяСтрока["ЭтоГруппа"] Тогда
			СтрокаОрганизации = ТекущаяСтрока;
		Иначе
			СтрокаОрганизации = ТекущаяСтрока.ПолучитьРодителя();
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтрокаОрганизации;
	
КонецФункции

&НаКлиенте
Процедура ДеревоОстатковПоДоговорам_ВыбратьОрганизациюДляСтроки(ДополнительныеПараметры = Неопределено)
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ДеревоОстатковПоДоговорам_ВыбратьОрганизациюДляСтроки_Выбор", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Справочник.Организации.ФормаВыбора",, Элементы["ОстаткиПоДоговорам"],,,, ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОстатковПоДоговорам_ВыбратьОрганизациюДляСтроки_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Перем	ДобавитьСтрокуОрганизации,
			ДобавитьСтрокуДоговора;
			
	Если ТипЗнч(РезультатВыбора) = Тип("СправочникСсылка.Организации") Тогда
		
		Если ТипЗнч(ПараметрыОповещения) = Тип("Структура") Тогда
			ПараметрыОповещения.Свойство("ДобавитьСтрокуОрганизации",	ДобавитьСтрокуОрганизации);
			ПараметрыОповещения.Свойство("ДобавитьСтрокуДоговора",		ДобавитьСтрокуДоговора);
		КонецЕсли;
		
		Если НЕ ДобавитьСтрокуОрганизации = Истина Тогда
			ДобавитьСтрокуОрганизации = Ложь;
		КонецЕсли;
		
		Если НЕ ДобавитьСтрокуДоговора = Истина Тогда
			ДобавитьСтрокуДоговора = Ложь;
		КонецЕсли;
		
		// Выбранная организация уже есть в дереве остатков?
		ОрганизацияПрисутствует = Ложь;
		СтрокиОрганизаций = ЭтаФорма["ОстаткиПоДоговорам"].ПолучитьЭлементы();
		Для Каждого СтрокаОрганизации Из СтрокиОрганизаций Цикл
			Если СтрокаОрганизации["Организация"] = РезультатВыбора Тогда
				ОрганизацияПрисутствует = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ОрганизацияПрисутствует Тогда
			Если ДобавитьСтрокуОрганизации Тогда
				// Добавляем новую строку организации
				СтрокаОрганизации = ЭтаФорма["ОстаткиПоДоговорам"].ПолучитьЭлементы().Добавить();
				СтрокаОрганизации["Организация"]	= РезультатВыбора;
				СтрокаОрганизации["ЭтоГруппа"]		= Истина;
			Иначе
				// Заменяем организацию в текущей строке
				СтрокаОрганизации = Элементы["ОстаткиПоДоговорам"].ТекущиеДанные;
				СтрокаОрганизации["Организация"]	= РезультатВыбора;
			КонецЕсли;
		КонецЕсли;
		
		// Добавляем новую строку договора
		Если ДобавитьСтрокуДоговора Тогда
			ДеревоОстатковПоДоговорам_ДобавитьСтрокуДоговора(СтрокаОрганизации);
		Иначе
			// Устанавливаем курсор на строку организации
			ИдСтроки = СтрокаОрганизации.ПолучитьИдентификатор();
			Элементы["ОстаткиПоДоговорам"].Развернуть(ИдСтроки);
			Элементы["ОстаткиПоДоговорам"].ТекущаяСтрока = ИдСтроки;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОстатковПоДоговорам_ДобавитьСтрокуДоговора(СтрокаОрганизации)
	
	СтрокиДоговоров = СтрокаОрганизации.ПолучитьЭлементы();
	СтрокаДоговора = СтрокиДоговоров.Добавить();
	СтрокаДоговора["Организация"] = СтрокаОрганизации["Организация"];
	Если СтрокиДоговоров.Количество() = 1 Тогда
		ЗаполнитьЗначенияСвойств(СтрокаДоговора, СтрокаОрганизации, "ОстатокНаНачало,ОстатокНаКонец,Расхождение");
	КонецЕсли;
	
	Модифицированность = Истина;
	Объект["ТребуетсяРасчетСумм"] = Истина;
	
	ДеревоОстатковПоДоговорам_ОпределитьКоличествоСтрокОстаткиПоДоговорам();
	
	Элементы["ОстаткиПоДоговорам"].ТекущаяСтрока = СтрокаДоговора.ПолучитьИдентификатор();
	
	ДеревоОстатковПоДоговорам_ВыбратьДоговор(СтрокаОрганизации);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОстатковПоДоговорам_ВыбратьДоговор(СтрокаОрганизации)
	
	Отбор = Новый Структура();
	Отбор.Вставить("Организация",	СтрокаОрганизации["Организация"]);
	Отбор.Вставить("Контрагент",	Объект["Контрагент"]);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Отбор",		Отбор);
	ПараметрыФормы.Вставить("РежимВыбора",	Истина);
	
	ОткрытьФорму("Справочник.Договоры.ФормаВыбора", ПараметрыФормы, Элементы["ОстаткиПоДоговорам"],,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОстатковПоДоговорам_ОпределитьКоличествоСтрокОстаткиПоДоговорам()
	
	КоличествоСтрок = 0;
	
	СтрокиОрганизаций = ЭтаФорма["ОстаткиПоДоговорам"].ПолучитьЭлементы();
	Для Каждого СтрокаОрганизации Из СтрокиОрганизаций Цикл
		КоличествоСтрок = КоличествоСтрок + СтрокаОрганизации.ПолучитьЭлементы().Количество();
	КонецЦикла;
	
	КоличествоСтрокОстатков = КоличествоСтрок;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОстатковПоДоговорам_ОбработатьИзменениеСуммы()
	
	ТекущаяСтрока = ДеревоОстатковПоДоговорам_ПолучитьТекущуюСтроку();
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Дельта = ТекущаяСтрока["ОстатокНаНачало"] - ДеревоОстатковПоДоговорам_РедактируемаяСтрока["ОстатокНаНачало"];
	
	Если ДеревоОстатковПоДоговорам_ТекущаяСтрокаЭтоСтрокаОрганизации(ТекущаяСтрока) Тогда
		// При изменении суммы в строке организации
		// корректируем сумму строки самого первого договора
		
		СтрокиДоговоров = ТекущаяСтрока.ПолучитьЭлементы();
		Если СтрокиДоговоров.Количество() > 0 Тогда
			СтрокаПервогоДоговора = СтрокиДоговоров[0];
		Иначе
			СтрокаПервогоДоговора = СтрокиДоговоров.Добавить();
			
			Элементы["ОстаткиПоДоговорам"].Развернуть(ТекущаяСтрока.ПолучитьИдентификатор());
		КонецЕсли;
		СтрокаПервогоДоговора["ОстатокНаНачало"] = СтрокиДоговоров[0]["ОстатокНаНачало"] + Дельта;
	Иначе
		// При изменении суммы в строке договора
		// корректируем сумму строки организации
		
		СтрокаОрганизации = ДеревоОстатковПоДоговорам_ПолучитьСтрокуОрганизации(ТекущаяСтрока);
		СтрокаОрганизации["ОстатокНаНачало"] = СтрокаОрганизации["ОстатокНаНачало"] + Дельта;
	КонецЕсли;
	
	ДеревоОстатковПоДоговорам_ОбновитьВсеЗначенияИтого(Дельта);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОстатковПоДоговорам_ПослеУдаленияСтроки()
	
	СтрокаОрганизации = ДеревоОстатковПоДоговорам_РедактируемаяСтрока["СтрокаОрганизации"];
	
	Дельта = - ДеревоОстатковПоДоговорам_РедактируемаяСтрока["ОстатокНаНачало"];
	СтрокаОрганизации["ОстатокНаНачало"] = СтрокаОрганизации["ОстатокНаНачало"] + Дельта;
	
	ДеревоОстатковПоДоговорам_ОбновитьВсеЗначенияИтого(Дельта);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОстатковПоДоговорам_ОбновитьВсеЗначенияИтого(Дельта)
	
	Объект["ОстатокНаНачало"] = Объект["ОстатокНаНачало"] + Дельта;
	
	ПересчитатьИтогоОстатки(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОстатковПоДоговорам_ЗапомнитьРедактируемуюСтроку()
	
	ТекущаяСтрока = ДеревоОстатковПоДоговорам_ПолучитьТекущуюСтроку();
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаОрганизации = ДеревоОстатковПоДоговорам_ПолучитьСтрокуОрганизации(ТекущаяСтрока);
	
	ДеревоОстатковПоДоговорам_РедактируемаяСтрока = Новый Структура();
	ДеревоОстатковПоДоговорам_РедактируемаяСтрока.Вставить("ОстатокНаНачало",	0);
	ДеревоОстатковПоДоговорам_РедактируемаяСтрока.Вставить("СтрокаОрганизации",	СтрокаОрганизации);
	ДеревоОстатковПоДоговорам_РедактируемаяСтрока.Вставить("Организация",		СтрокаОрганизации["Организация"]);
	ДеревоОстатковПоДоговорам_РедактируемаяСтрока.Вставить("Договор",			ТекущаяСтрока["Договор"]);
	ДеревоОстатковПоДоговорам_РедактируемаяСтрока.Вставить("ОстатокНаНачало",	ТекущаяСтрока["ОстатокНаНачало"]);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОстатковПоДоговорам_ВосстановитьАктивированнуюСтроку()
	
	Перем	СтрокаОрганизации,
			СтрокаДоговора,
			ИдСтроки;
			
	Если НЕ ТипЗнч(ДеревоОстатковПоДоговорам_РедактируемаяСтрока) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаДерева Из ЭтаФорма["ОстаткиПоДоговорам"].ПолучитьЭлементы() Цикл
		Если СтрокаДерева["Организация"] = ДеревоОстатковПоДоговорам_РедактируемаяСтрока["Организация"] Тогда
			СтрокаОрганизации = СтрокаДерева;
			ИдСтроки = СтрокаДерева.ПолучитьИдентификатор();
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ СтрокаОрганизации = Неопределено Тогда
		Для Каждого СтрокаДерева Из СтрокаОрганизации.ПолучитьЭлементы() Цикл
			Если СтрокаДерева["Договор"] = ДеревоОстатковПоДоговорам_РедактируемаяСтрока["Договор"] Тогда
				СтрокаДоговора = СтрокаДерева;
				ИдСтроки = СтрокаДерева.ПолучитьИдентификатор();
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ИдСтроки = Неопределено Тогда
		Элементы["ОстаткиПоДоговорам"].ТекущаяСтрока = ИдСтроки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОстатковПоДоговорам_РазвернутьПервуюСтроку()
	
	СтрокиОрганизаций = ЭтаФорма["ОстаткиПоДоговорам"].ПолучитьЭлементы();
	
	Если СтрокиОрганизаций.Количество() > 0 Тогда
		ИдСтроки = СтрокиОрганизаций[0].ПолучитьИдентификатор();
		Элементы["ОстаткиПоДоговорам"].Развернуть(ИдСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОстатковПоДоговорам_РазвернутьВсеСтроки()
	
	СтрокиОрганизаций = ЭтаФорма["ОстаткиПоДоговорам"].ПолучитьЭлементы();
	
	Для Каждого СтрокаОрганизации Из СтрокиОрганизаций Цикл
		ИдСтроки = СтрокаОрганизации.ПолучитьИдентификатор();
		Элементы["ОстаткиПоДоговорам"].Развернуть(ИдСтроки, Истина);
	КонецЦикла;
	
КонецПроцедуры

