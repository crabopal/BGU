&НаСервере
Процедура ИнициализацияФормы()
	
	Если ИнициализацияВыполнена Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	
	//---
	// Флажок <без ограничения>
	//---
	НастройкиМеханизма = Документы.АктСверкиВзаиморасчетов.ФлажокБезОграничения_ПолучитьНастройкиМеханизма();
	ОбщегоНазначенияБГУ.ФлажокБезОграничения_ИнициализироватьФорму(ЭтаФорма, НастройкиМеханизма);
	
	НастроитьФормуСервер_УчетПоВсемОрганизациям();
	
	НастроитьЭлементыОстатков();
	
	Если ИспользуетсяДеревоОстатков(Объект) Тогда
		ДеревоОстатковПоДоговорам_ЗаполнитьДеревоОстатковПоДоговорамИзТаблицы();
	КонецЕсли;
	
	ПересчитатьИтогоОстатки(ЭтаФорма, Ложь);
	
	НастроитьФормуКлиентСервер_ПриИзмененииСверкаСогласована(ЭтаФорма);
	
	Документы.АктСверкиВзаиморасчетов.ЗаполнитьДатыУчетныхДокументов(Объект);
	Документы.АктСверкиВзаиморасчетов.ЗаполнитьКолонкуОтветственный(Объект);
	
	Документы.АктСверкиВзаиморасчетов.ЗаполнитьСписокВыбораНаименованиеОперации(ЭтаФорма);
	
	ИнициализацияВыполнена = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализацияФормыКлиент()
	
	ТекстЗаголовкаСообщений = НСтр("ru='Акт сверки взаиморасчетов'");
	
	ЗапомнитьОстатокНаНачало(ЭтаФорма);
	
	ОпределитьКоличествоСтрокОстатков();
	
	Если ИспользуетсяДеревоОстатков(Объект) Тогда
		ДеревоОстатковПоДоговорам_РазвернутьПервуюСтроку();
	КонецЕсли;
	
