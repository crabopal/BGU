&НаКлиенте
Перем ДеревоОстатковПоДоговорам_РедактируемаяСтрока;

&НаКлиенте
Перем ТекстЗаголовкаСообщений;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если НЕ ИнициализацияВыполнена Тогда
		ИнициализацияФормы();
	КонецЕсли;
	
	// Централизованная бухгалтерия
	ЗаполнениеРеквизитовОбъектов.ОпределитьПараметрыВыбораСотрудников(ЭтаФорма, Объект.Организация);
	// Конец Централизованная бухгалтерия
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.РаботаСФайлами
	ПараметрыГиперссылки = РаботаСФайлами.ГиперссылкаФайлов();
	ПараметрыГиперссылки.Размещение = "КоманднаяПанель";
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыГиперссылки);
	// Конец СтандартныеПодсистемы.РаботаСФайлами

	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами".
	
	ЕстьАктуальныйВнутреннийДокументБЭД = ЭлектронныеДокументыБГУ.ЕстьАктуальныйВнутреннийДокумент(Объект.Ссылка);
 	Если Параметры.Ключ.Пустая() Тогда
		Если ЕстьАктуальныйВнутреннийДокументБЭД Тогда
			ТребуетсяОтдельныйДокументДляЭДО = Истина;
		Иначе	
			ВидимостьЭлементовЭДО = ЭлектронныеДокументыБГУ.ВидимостьЭлементовЭДО(Объект.Контрагент, Объект.Организация);
			Объект.ЭтоЭлектронныйДокумент = ВидимостьЭлементовЭДО;
		КонецЕсли;
		
		Если Объект.ЭтоЭлектронныйДокумент И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			ОчищающаяСтруктура = Новый Структура("
				|ОстатокНаНачалоПоДаннымКонтрагента,
				|СверкаСогласована");
			
			ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
			
			Объект.ПоДаннымКонтрагента.Очистить();
			Объект.Сверка.Очистить();
			Объект.ОстаткиПоДаннымКонтрагента.Очистить();
			
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru='Этот документ был создан путем копирования другого документа. Поэтому некоторые табличные части и реквизиты копии были очищены.'"),
				Объект.Ссылка);
		КонецЕсли;
	Иначе
		Если Объект.ПоВсемОрганизациям Тогда
			ТребуетсяОтдельныйДокументДляЭДО = Истина;		
		КонецЕсли;	
	КонецЕсли;
	
	УправлениеФормойДляЭДО(ЭтотОбъект);
	ПодготовитьФормуДляЭДОНаСервере();
	УстановитьУсловноеОформление();
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаДокумента(ЭтотОбъект, Элементы.ГруппаОтветственныйКомментарий);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов 

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ИнициализацияФормыКлиент();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ПриОткрытии(ЭтотОбъект, Отказ);
	// Конец СтандартныеПодсистемы.РаботаСФайлами

	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если НЕ ИнициализацияВыполнена Тогда
		ИнициализацияФормы();
	КонецЕсли;
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ИспользуетсяДеревоОстатков(Объект) Тогда
		ДеревоОстатковПоДоговорам_ЗапомнитьРедактируемуюСтроку();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ИспользуетсяДеревоОстатков(ТекущийОбъект) Тогда
		ДеревоОстатковПоДоговорам_ЗаполнитьТаблицуОстатковПоДоговорамИзДерева(ТекущийОбъект);
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ИспользуетсяДеревоОстатков(ТекущийОбъект) Тогда
		ДеревоОстатковПоДоговорам_ЗаполнитьДеревоОстатковПоДоговорамИзТаблицы();
	КонецЕсли;
	
	Документы.АктСверкиВзаиморасчетов.ЗаполнитьДатыУчетныхДокументов(Объект);
	Документы.АктСверкиВзаиморасчетов.ЗаполнитьКолонкуОтветственный(Объект);
	
	УстановитьЗаголовокФормы();
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	Если ИспользуетсяДеревоОстатков(Объект) Тогда
		ДеревоОстатковПоДоговорам_ВосстановитьАктивированнуюСтроку();
	КонецЕсли;
	
	ОпределитьКоличествоСтрокОстатков();

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия);
	// Конец СтандартныеПодсистемы.РаботаСФайлами

	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".

	КонецЕсли;
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов    
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаДокумента(ИмяСобытия, ЭтотОбъект, Источник);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// Проверяем дубли строк в дереве
	Если ИспользуетсяДеревоОстатков(Объект) Тогда
		ПроверяемоеДерево = РеквизитФормыВЗначение("ОстаткиПоДоговорам");
		
		УровниГруппировок = Новый Массив();
		УровниГруппировок.Добавить("Организация");
		КолонкиДетальныхСтрок = "Организация,Договор";
		ПараметрыПроверки = Новый Структура();
		ПараметрыПроверки.Вставить("УровниГруппировок",						УровниГруппировок);
		ПараметрыПроверки.Вставить("КолонкиДетальныхСтрок",					КолонкиДетальныхСтрок);
		ПараметрыПроверки.Вставить("ИмяСуществующейКолонкиНомерСтроки",		"НомерСтроки");
		РезультатПоискаДублей = Документы.АктСверкиВзаиморасчетов.НайтиДублиСтрокДерева(ПроверяемоеДерево, ПараметрыПроверки);
		
		Если РезультатПоискаДублей["Ошибка"] Тогда
			ОбщегоНазначения.СообщитьПользователю(РезультатПоискаДублей["ОписаниеОшибки"]);
		Иначе
			
			// Загружаем обновленную колонку НомерСтроки
			Если РезультатПоискаДублей["ПересчитаныНомераСтрок"] Тогда
				ЗначениеВРеквизитФормы(ПроверяемоеДерево, "ОстаткиПоДоговорам");
			КонецЕсли;
			
			ВыводитьНомераСтрок = ЗначениеЗаполнено(РезультатПоискаДублей["ИмяКолонкиНомерСтроки"]) И РезультатПоискаДублей["ОбнаруженыДубли"];
			
			Элементы["ОстаткиПоДоговорамНомерСтроки"].Видимость = ВыводитьНомераСтрок;
			
			// Обновляем условное оформление
			ОписаниеДерева = Новый Структура();
			ОписаниеДерева.Вставить("ИмяРеквизитаФормы",	"ОстаткиПоДоговорам");
			ОписаниеДерева.Вставить("ИмяЭлементаФормы",		"ОстаткиПоДоговорам");
			ПеренаправлениеВывода = Новый Структура();
			ПеренаправлениеВывода.Вставить("Организация", "Договор");
			Документы.АктСверкиВзаиморасчетов.НайтиДублиСтрокДерева_УстановитьУсловноеОформление(ЭтаФорма, РезультатПоискаДублей, ОписаниеДерева, ПеренаправлениеВывода);
			
			// Выводим сообщения
			Если РезультатПоискаДублей["ОбнаруженыДубли"] Тогда
				Отказ = Истина;
				ПараметрыВывода = Новый Структура();
				ПараметрыВывода.Вставить("ИмяРеквизитаДерево",			"ОстаткиПоДоговорам");
				ПараметрыВывода.Вставить("ПредставлениеДерева",			"Остатки");
				ПараметрыВывода.Вставить("ИмяПоляДляВыводаСообщений",	"НомерСтроки");
				Документы.АктСверкиВзаиморасчетов.НайтиДублиСтрокДерева_ВывестиСообщенияОДубляхСтрок(РезультатПоискаДублей, ПараметрыВывода);
				
				РазвернутьВсеСтроки = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	СписокСчетов = Документы.АктСверкиВзаиморасчетов.ПолучитьСписокОтмеченныхСчетов(Объект);
	
	Если СписокСчетов.Количество() = 0 Тогда
		Отказ = Истина;
		ТекстОшибки = НСтр("ru='Не задан список счетов, по которым производится сверка.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , "Объект.СписокСчетов");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
