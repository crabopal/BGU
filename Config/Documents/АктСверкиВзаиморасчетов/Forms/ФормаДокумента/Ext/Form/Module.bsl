&НаКлиенте
Процедура ОстаткиПоДоговорамПриИзменении(Элемент)
	
	Объект["ТребуетсяРасчетСумм"] = Истина;
	
	ВыводитьНомераСтрок = Ложь;
	
	ОпределитьКоличествоСтрокОстатков();
	
	ПересчитатьИтогоОстатки(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиПоДоговорамВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущийЭлементДерева = ЭтаФорма["ОстаткиПоДоговорам"].НайтиПоИдентификатору(Элементы["ОстаткиПоДоговорам"].ТекущаяСтрока);
	Если ТекущийЭлементДерева["ЭтоГруппа"] И НЕ ЗначениеЗаполнено(ТекущийЭлементДерева["Организация"]) Тогда
		// Выбираем организацию для выбранной строки
		СтандартнаяОбработка = Ложь;
		ДеревоОстатковПоДоговорам_ВыбратьОрганизациюДляСтроки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиПоДоговорамПриАктивизацииСтроки(Элемент)
	
	Если РазвернутьВсеСтроки Тогда
		ДеревоОстатковПоДоговорам_РазвернутьВсеСтроки();
		
		РазвернутьВсеСтроки = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиПоДоговорамПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Если Копирование Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаОрганизации = ДеревоОстатковПоДоговорам_ПолучитьСтрокуОрганизации();
	
	Если СтрокаОрганизации = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Объект["Организация"]) Тогда
		// Выбираем организацию для новой строки
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ДобавитьСтрокуОрганизации",	Истина);
		ДополнительныеПараметры.Вставить("ДобавитьСтрокуДоговора",		Истина);
		ДеревоОстатковПоДоговорам_ВыбратьОрганизациюДляСтроки(ДополнительныеПараметры);
	Иначе
		// Создаем новую строку договора
		ДеревоОстатковПоДоговорам_ДобавитьСтрокуДоговора(СтрокаОрганизации);
	КонецЕсли;
	
КонецПроцедуры

