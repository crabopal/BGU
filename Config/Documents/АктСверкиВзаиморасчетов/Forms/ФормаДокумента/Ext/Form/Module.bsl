	ЗаполнитьДобавленныеКолонкиТаблиц();
	ОпределитьСтатусСверки();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()
	
	Для Каждого СтрокаТаблицы Из Объект.Сверка Цикл
		ЗаполнитьДобавленныеКолонкиСтрокиТаблицыСверка(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьДобавленныеКолонкиСтрокиТаблицыСверка(СтрокаТаблицы)
	
	СтрокаТаблицы.НадписьПоДаннымКонтрагента = НСтр("ru='по данным контрагента'");
	СтрокаТаблицы.НадписьПоДаннымОрганизации = НСтр("ru='по данным организации'");
	
	СтрокаТаблицы.ЕстьРасхожденияНомерДокумента = СтрокаТаблицы.НомерДокументаПоДаннымОрганизации <> СтрокаТаблицы.НомерДокументаПоДаннымКонтрагента;
	СтрокаТаблицы.ЕстьРасхожденияДатаДокумента  = СтрокаТаблицы.ДатаДокументаПоДаннымОрганизации <> СтрокаТаблицы.ДатаДокументаПоДаннымКонтрагента;
	СтрокаТаблицы.ЕстьРасхожденияДтКт           = СтрокаТаблицы.ДебетПоДаннымОрганизации <> СтрокаТаблицы.КредитПоДаннымКонтрагента ИЛИ СтрокаТаблицы.КредитПоДаннымОрганизации <> СтрокаТаблицы.ДебетПоДаннымКонтрагента;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеДокументЭДО(ИмяТаблицыФормы)
	
	ТекДанные = Элементы[ИмяТаблицыФормы].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеСтруктура = Новый Структура("Договор,Документ");
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанныеСтруктура, ТекДанные);
	
	НовыеЗначения = ПолучитьОбновлениеПолейЭДО(ТекущиеДанныеСтруктура, "Документ");
	
	ЗаполнитьЗначенияСвойств(ТекДанные, НовыеЗначения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеДоговорЭДО(ИмяТаблицыФормы)
	
	ТекДанные = Элементы[ИмяТаблицыФормы].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеСтруктура = Новый Структура("Договор");
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанныеСтруктура, ТекДанные);
	
	НовыеЗначения = ПолучитьОбновлениеПолейЭДО(ТекущиеДанныеСтруктура, "Договор");
	
	ЗаполнитьЗначенияСвойств(ТекДанные, НовыеЗначения);
	
КонецПроцедуры

