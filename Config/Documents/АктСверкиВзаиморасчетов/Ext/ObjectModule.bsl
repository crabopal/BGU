#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Очистить();
	
	// Реквизиты шапки
	ПроверяемыеРеквизиты.Добавить("Организация");
	ПроверяемыеРеквизиты.Добавить("Контрагент");
	ПроверяемыеРеквизиты.Добавить("ВалютаДокумента");
	ПроверяемыеРеквизиты.Добавить("ДатаНачала");
	ПроверяемыеРеквизиты.Добавить("ДатаОкончания");
	
	// Табличные части
	ПроверяемыеРеквизиты.Добавить("ПоДаннымОрганизации.Дата");
	Если Не ЭтоЭлектронныйДокумент Тогда
		ПроверяемыеРеквизиты.Добавить("ПоДаннымОрганизации.Представление");
	КонецЕсли;
	
	ПроверяемыеРеквизиты.Добавить("ПоДаннымКонтрагента.Дата");
	Если Не ЭтоЭлектронныйДокумент Тогда
		ПроверяемыеРеквизиты.Добавить("ПоДаннымКонтрагента.Представление");
	КонецЕсли;
	
	Если ЭтотОбъект["ПоВсемОрганизациям"] Тогда
		ПроверяемыеРеквизиты.Добавить("ПоДаннымОрганизации.Организация");
		ПроверяемыеРеквизиты.Добавить("ПоДаннымКонтрагента.Организация");
		ПроверяемыеРеквизиты.Добавить("СписокОрганизаций.Организация");
	КонецЕсли;
	
	// Дополнительные проверки
	
	ДатаНачала = ЭтотОбъект["ДатаНачала"];
	ДатаОкончания = ЭтотОбъект["ДатаОкончания"];
	Если ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания)
		И ДатаНачала > ДатаОкончания Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru='Дата окончания периода сверки должна быть больше даты начала'"),
			ЭтотОбъект["Ссылка"],
			"Объект.ДатаОкончания");
	КонецЕсли;
		
	Если Документы.АктСверкиВзаиморасчетов.ЕстьОшибкиЗаполнения(ЭтотОбъект) Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	//
	// Гарантируем непротиворечивое состояние табличной части СписокОрганизаций
	//
	Если Документы.АктСверкиВзаиморасчетов.ИспользуетсяТаблицаОстатков(ЭтотОбъект)
		ИЛИ Документы.АктСверкиВзаиморасчетов.ИспользуетсяДеревоОстатков(ЭтотОбъект) Тогда
		// Табличная часть используется полноценно, допустимо несколько строк
		// Очищаем неиспользуемые колонки
		
		ОчищающаяСтруктура = Новый Структура();
		
		// Если колонка организации не используется, то записываем организацию из шапки
		Если НЕ Документы.АктСверкиВзаиморасчетов.ИспользуетсяКолонкаОрганизация(ЭтотОбъект) Тогда
			ОчищающаяСтруктура.Вставить("Организация", ЭтотОбъект["Организация"]);
		КонецЕсли;
		
		// Если колонка договора не используется, то очищаем договор
		Если НЕ Документы.АктСверкиВзаиморасчетов.ИспользуетсяКолонкаДоговор(ЭтотОбъект) Тогда
			ОчищающаяСтруктура.Вставить("Договор");
		КонецЕсли;
		
		Если ОчищающаяСтруктура.Количество() > 0 Тогда
			Для Каждого СтрокаТЧ Из ЭтотОбъект["СписокОрганизаций"] Цикл
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, ОчищающаяСтруктура);
			КонецЦикла;
		КонецЕсли;
		
		// Нулевой остаток на начало не храним, если используется всего 1 строка остатков
		Если ЭтотОбъект["СписокОрганизаций"].Количество() = 1
			И ЭтотОбъект["СписокОрганизаций"][0]["ОстатокНаНачало"] = 0 Тогда
			
			ЭтотОбъект["СписокОрганизаций"].Очистить();
		КонецЕсли;
		
	Иначе
		// Табличная часть используется в ограниченном режиме
		// Допустима только одна строка
		// Нулевой остаток на начало не храним
		
		Если ЭтотОбъект["СписокОрганизаций"].Количество() > 1 Тогда
			
			ИтогОстатокНаНачало = ЭтотОбъект["СписокОрганизаций"].Итог("ОстатокНаНачало");
			
			ЭтотОбъект["СписокОрганизаций"].Очистить();
			
			Если ИтогОстатокНаНачало <> 0 Тогда
				НоваяСтрока = ЭтотОбъект["СписокОрганизаций"].Добавить();
				НоваяСтрока["Организация"]		= ЭтотОбъект["Организация"];
				НоваяСтрока["ОстатокНаНачало"]	= ИтогОстатокНаНачало;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	//
	// Гарантируем непротиворечивое состояние табличных частей взаиморасчетов
	//
	// Если колонка организации не используется, то записываем организацию из шапки
	Если НЕ Документы.АктСверкиВзаиморасчетов.ИспользуетсяКолонкаОрганизация(ЭтотОбъект) Тогда
		ОчищающаяСтруктура = Новый Структура();
		ОчищающаяСтруктура.Вставить("Организация", ЭтотОбъект["Организация"]);
		
		Для Каждого СтрокаТЧ Из ЭтотОбъект["ПоДаннымОрганизации"] Цикл
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, ОчищающаяСтруктура);
		КонецЦикла;
		
		Для Каждого СтрокаТЧ Из ЭтотОбъект["ПоДаннымКонтрагента"] Цикл
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, ОчищающаяСтруктура);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	// Частично заполняем новый документ
	// (не ввод на основании, не копирование)
	Если ДанныеЗаполнения = Неопределено ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Документы.АктСверкиВзаиморасчетов.ЗаполнитьСчетамиПоУмолчанию(ЭтотОбъект);
		
		// Ответственные лица
		Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("Организация") Тогда
			ВремСтруктура = Новый Структура();
			ВремСтруктура.Вставить("Организация",	ДанныеЗаполнения["Организация"]);
			ВремСтруктура.Вставить("Дата",			ТекущаяДатаСеанса());
			ВремСтруктура.Вставить("ГлавныйБухгалтер");
			Документы.АктСверкиВзаиморасчетов.УстановитьОтветственныхЛиц(ВремСтруктура);
			
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВремСтруктура, "ГлавныйБухгалтер");
		КонецЕсли;
		
		//---
		// Флажок <без ограничения>
		//---
		НастройкиМеханизма = Документы.АктСверкиВзаиморасчетов.ФлажокБезОграничения_ПолучитьНастройкиМеханизма();
		ОбщегоНазначенияБГУКлиентСервер.ФлажокБезОграничения_ИнициализироватьВсеФлажкиБезОграничения(ЭтотОбъект, НастройкиМеханизма, ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

