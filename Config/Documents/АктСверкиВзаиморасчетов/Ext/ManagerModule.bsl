Функция СоответствиеПредставленийПоДаннымКонтрагента() Экспорт
	
	СоответствиеПредставлений = Новый Соответствие;
	СоответствиеПредставлений.Вставить(НСтр("ru='Передано'"),              НСтр("ru='Принято'"));
	СоответствиеПредставлений.Вставить(НСтр("ru='Принято'"),               НСтр("ru='Передано'"));
	СоответствиеПредставлений.Вставить(НСтр("ru='Продажа'"),               НСтр("ru='Приход'"));
	СоответствиеПредставлений.Вставить(НСтр("ru='Приход'"),                НСтр("ru='Продажа'"));
	СоответствиеПредставлений.Вставить(НСтр("ru='Корректировка продажи'"), НСтр("ru='Корректировка прихода'"));
	СоответствиеПредставлений.Вставить(НСтр("ru='Корректировка прихода'"), НСтр("ru='Корректировка продажи'"));
	СоответствиеПредставлений.Вставить(НСтр("ru='Поступление'"),           НСтр("ru='Передача'"));
	
	Возврат СоответствиеПредставлений;
	
КонецФункции

Функция СоответствиеНаименованийОпераций()
	
	СоответствиеОпераций = Новый Соответствие;
	
	СоответствиеОпераций.Вставить(НСтр("ru='Реализация'"),                    НСтр("ru='Поступление'"));
	СоответствиеОпераций.Вставить(НСтр("ru='Поступление'"),                   НСтр("ru='Реализация'"));

	СоответствиеОпераций.Вставить(НСтр("ru='Корректировка реализации'"),      НСтр("ru='Корректировка поступления'"));
	СоответствиеОпераций.Вставить(НСтр("ru='Корректировка поступления'"),     НСтр("ru='Корректировка реализации'"));
	
	СоответствиеОпераций.Вставить(НСтр("ru='Оплата поставщику'"),             НСтр("ru='Оплата от покупателя'"));
	СоответствиеОпераций.Вставить(НСтр("ru='Оплата от покупателя'"),          НСтр("ru='Оплата поставщику'"));
	
	СоответствиеОпераций.Вставить(НСтр("ru='Возврат средств от поставщика'"), НСтр("ru='Возврат средств покупателю'"));
	СоответствиеОпераций.Вставить(НСтр("ru='Возврат средств покупателю'"),    НСтр("ru='Возврат средств от поставщика'"));
	
	СоответствиеОпераций.Вставить(НСтр("ru='Поступление средств прочее'"),    НСтр("ru='Оплата прочая'"));
	СоответствиеОпераций.Вставить(НСтр("ru='Оплата прочая'"),                 НСтр("ru='Поступление средств прочее'"));
	
	СоответствиеОпераций.Вставить(НСтр("ru='Передано'"),                      НСтр("ru='Принято'"));
	СоответствиеОпераций.Вставить(НСтр("ru='Принято'"),                       НСтр("ru='Передано'"));
	
	СоответствиеОпераций.Вставить(НСтр("ru='Сторно: передано'"),              НСтр("ru='Сторно: принято'"));
	СоответствиеОпераций.Вставить(НСтр("ru='Сторно: принято'"),               НСтр("ru='Сторно: передано'"));
	
	Возврат СоответствиеОпераций;
	
КонецФункции

Функция ПолучитьПараметрыДляЗаполненияЭДО(ДокументОбъект, ЗаполнятьДанныеКонтрагента = Ложь, АдресХранилищаСОшибками = Неопределено) Экспорт
	
	Если ЭтоАдресВременногоХранилища(АдресХранилищаСОшибками) Тогда
		УдалитьИзВременногоХранилища(АдресХранилищаСОшибками);
		АдресХранилищаСОшибками = "";
	КонецЕсли;
	
	АдресХранилищаСОшибками = ПоместитьВоВременноеХранилище(Неопределено, АдресХранилищаСОшибками);
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("ШапкаДокумента",			ПолучитьСтруктуруШапкиДокумента(ДокументОбъект));
	СтруктураПараметров.Вставить("СписокОтмеченныхСчетов",	Документы.АктСверкиВзаиморасчетов.ПолучитьСписокОтмеченныхСчетов(ДокументОбъект));
	
	СтруктураПараметров.Вставить("ЗаполнятьДанныеКонтрагента",		ЗаполнятьДанныеКонтрагента);
	СтруктураПараметров.Вставить("АдресХранилищаСОшибками",			АдресХранилищаСОшибками);
	СтруктураПараметров.Вставить("СОбособленнымиПодразделениями",	Ложь);
	СтруктураПараметров.Вставить("ВыводитьСчетаФактуры",			Ложь);
	
	Возврат СтруктураПараметров;
	
КонецФункции

Функция ПолучитьПустыеИтогиПоДоговору() Экспорт
	
	Итоги = Новый Структура();
	Итоги.Вставить("СальдоНаНачалоПериодаДебет",	0);
	Итоги.Вставить("СальдоНаНачалоПериодаКредит",	0);
	Итоги.Вставить("ОборотПоДебету",				0);
	Итоги.Вставить("ОборотПоКредиту",				0);
	Итоги.Вставить("СальдоНаКонецПериодаДебет",		0);
	Итоги.Вставить("СальдоНаКонецПериодаКредит",	0);
	
	Возврат Итоги;
	
КонецФункции

Функция ЗаполнитьИтогиПоДоговоруЭДО(СтрокаПоДоговору, ТаблицаОстатков, Договор) Экспорт
	
	Итоги = ПолучитьПустыеИтогиПоДоговору();
	
	Поиск = Новый Структура("Договор", Договор);
	
	МассивСтрок = ТаблицаОстатков.НайтиСтроки(Поиск);
	
	ОстатокНаНачало = 0;
	
	Если МассивСтрок.Количество() > 0 Тогда
		СтрокаОстатков = МассивСтрок[0];
		
		ОстатокНаНачало = СтрокаОстатков.ОстатокНаНачало;
		
		Если ОстатокНаНачало > 0 Тогда
			Итоги.СальдоНаНачалоПериодаДебет = ОстатокНаНачало;
		Иначе
			Итоги.СальдоНаНачалоПериодаКредит = -ОстатокНаНачало;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицыДокумент Из СтрокаПоДоговору.СведенияПоДокументам Цикл
		Для Каждого СтрокаТаблицыОперация Из СтрокаТаблицыДокумент.СведенияПоОперациям Цикл
			Итоги.ОборотПоДебету = Итоги.ОборотПоДебету + СтрокаТаблицыОперация.СуммаДебет;
			Итоги.ОборотПоКредиту = Итоги.ОборотПоКредиту + СтрокаТаблицыОперация.СуммаКредит;
		КонецЦикла;
	КонецЦикла;
	
	Обороты = Итоги.ОборотПоДебету - Итоги.ОборотПоКредиту;
	
	ОстатокНаКонец = ОстатокНаНачало + Обороты;
	
	Если ОстатокНаКонец > 0 Тогда
		Итоги.СальдоНаКонецПериодаДебет = ОстатокНаКонец;
	Иначе
		Итоги.СальдоНаКонецПериодаКредит = -ОстатокНаКонец;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтрокаПоДоговору, Итоги);
	
КонецФункции

Процедура ПодготовитьДанныеДляЗаполненияЭДО(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ПолучитьДанныеБухУчета(ПараметрыПроцедуры, АдресРезультата);
	
КонецПроцедуры

Функция ТаблицаПоДаннымКонтрагента(ТаблицаПоДаннымОрганизации)
	
	ТаблицаПоДаннымКонтрагента = НовыйТаблицаДокументов();
	
	Для Каждого СтрокаПоДаннымОрганизации Из ТаблицаПоДаннымОрганизации Цикл
		СтрокаПоДаннымКонтрагента = ТаблицаПоДаннымКонтрагента.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПоДаннымКонтрагента, СтрокаПоДаннымОрганизации);
		СтрокаПоДаннымКонтрагента.Представление =
			ПредставлениеДокументаПоДаннымКонтрагента(СтрокаПоДаннымОрганизации.Представление);
		СтрокаПоДаннымКонтрагента.Дебет  = СтрокаПоДаннымОрганизации.Кредит;
		СтрокаПоДаннымКонтрагента.Кредит = СтрокаПоДаннымОрганизации.Дебет;
		СтрокаПоДаннымКонтрагента.Дата   = ?(ЗначениеЗаполнено(СтрокаПоДаннымОрганизации.ДатаВходящегоДокумента),
			СтрокаПоДаннымОрганизации.ДатаВходящегоДокумента,
			СтрокаПоДаннымОрганизации.Дата);
	КонецЦикла;
	
	Возврат ТаблицаПоДаннымКонтрагента;
	
КонецФункции

Функция ПредставлениеДокументаПоДаннымКонтрагента(ПредставлениеДокумента) Экспорт
	
	Представление = СокрЛП(ПредставлениеДокумента);
	Для Каждого Соответствие Из СоответствиеПредставленийПоДаннымКонтрагента() Цикл
		Если СтрНачинаетсяС(Представление, Соответствие.Ключ) Тогда
			Представление = СтрЗаменить(Представление, Соответствие.Ключ, Соответствие.Значение);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Представление;
	
КонецФункции

Функция ПредставлениеХозяйственнойОперации(ДокументУчета, Дебет, Кредит) Экспорт
	
	Результат = "";
	
	ВидДокумента = ТипЗнч(ДокументУчета);
	
	Если ВидДокумента = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		Реквизиты = "ЭтоКорректировка";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументУчета, Реквизиты);
		
		Результат = НСтр("ru='Поступление'");
		Если ЗначенияРеквизитов.ЭтоКорректировка Тогда
			Результат = НСтр("ru='Корректировка поступления'");
		КонецЕсли;	
	ИначеЕсли ВидДокумента = Тип("ДокументСсылка.ПоступлениеУслугРабот")
		ИЛИ ВидДокумента = Тип("ДокументСсылка.ПоступлениеОС")
		ИЛИ ВидДокумента = Тип("ДокументСсылка.ПоступлениеБСО")
		ИЛИ ВидДокумента = Тип("ДокументСсылка.ПоступлениеОСИК")
		ИЛИ ВидДокумента = Тип("ДокументСсылка.ПоступлениеИК")	Тогда
		
		Результат = НСтр("ru='Поступление'");
	КонецЕсли;	
		
	Если ВидДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
		ИЛИ ВидДокумента = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		Результат = НСтр("ru='Реализация'");
		
		Реквизиты = "ЭтоКорректировка";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументУчета, Реквизиты);
		Если ЗначенияРеквизитов.ЭтоКорректировка Тогда
			Результат = НСтр("ru='Корректировка реализации'");
		КонецЕсли;	
	ИначеЕсли ВидДокумента = Тип("ДокументСсылка.АктОбОказанииУслуг")
		ИЛИ ВидДокумента = Тип("ДокументСсылка.ПередачаОбъектовОС")
		ИЛИ ВидДокумента = Тип("ДокументСсылка.НачислениеДоходов")
		ИЛИ ВидДокумента = Тип("ДокументСсылка.НачислениеЗаУслугиОбразования")
		ИЛИ ВидДокумента = Тип("ДокументСсылка.НачислениеРодительскойПлаты")
		ИЛИ ВидДокумента = Тип("ДокументСсылка.НачислениеСтудентамЗаПрочиеУслуги")
		ИЛИ ВидДокумента = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов") Тогда
		Результат = НСтр("ru='Реализация'");
	КонецЕсли;
	
	Если ВидДокумента = Тип("ДокументСсылка.ИзвещениеИсходящее") Тогда
		Реквизиты = "ВходящееИзвещение";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументУчета, Реквизиты);
		Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитов.ВходящееИзвещение) И (ДокументУчета.ПередаваемыеПроводки.Количество() > 0) Тогда
			Результат = НСтр("ru='Передано'");
		КонецЕсли;	
	ИначеЕсли ВидДокумента = Тип("ДокументСсылка.ИзвещениеВходящее") Тогда
		Результат = НСтр("ru='Принято'");
	КонецЕсли;	
	
	Если ВидДокумента = Тип("ДокументСсылка.КассовоеВыбытие") Тогда
		Реквизиты = "КорСчет";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументУчета, Реквизиты);
		
		Если БухгалтерскийУчетКлиентСервер.СчетВИерархии(ЗначенияРеквизитов.КорСчет, "302.00")
			ИЛИ БухгалтерскийУчетКлиентСервер.СчетВИерархии(ЗначенияРеквизитов.КорСчет, "206.00") Тогда
			Результат = НСтр("ru='Оплата поставщику'");
		КонецЕсли;
		Если БухгалтерскийУчетКлиентСервер.СчетВИерархии(ЗначенияРеквизитов.КорСчет, "205.00")
			ИЛИ БухгалтерскийУчетКлиентСервер.СчетВИерархии(ЗначенияРеквизитов.КорСчет, "209.00") Тогда
			Результат = НСтр("ru='Возврат средств покупателю'");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Результат) Тогда
			Результат = НСтр("ru='Оплата прочая'");	
		КонецЕсли;	
	КонецЕсли;
	
	Если ВидДокумента = Тип("ДокументСсылка.КассовоеПоступление") Тогда
		Реквизиты = "КорСчет";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументУчета, Реквизиты);
	
		Если БухгалтерскийУчетКлиентСервер.СчетВИерархии(ДокументУчета.КорСчет, "302.00") Тогда
			Результат = НСтр("ru='Возврат средств от поставщика'");
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(ДокументУчета.КорСчет, "205.00")
			ИЛИ БухгалтерскийУчетКлиентСервер.СчетВИерархии(ДокументУчета.КорСчет, "209.00") Тогда
			Результат = НСтр("ru='Оплата от покупателя'");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Результат) Тогда
			Результат = НСтр("ru='Поступление средств прочее'");	
		КонецЕсли;	
	КонецЕсли;
	
	Если ВидДокумента = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход")
		Или ВидДокумента = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная") Тогда
		Реквизиты = "КорСчет";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументУчета, Реквизиты);
		
		Если БухгалтерскийУчетКлиентСервер.СчетВИерархии(ЗначенияРеквизитов.КорСчет, "302.00")
			ИЛИ БухгалтерскийУчетКлиентСервер.СчетВИерархии(ЗначенияРеквизитов.КорСчет, "206.00") Тогда
			Результат = НСтр("ru='Оплата поставщику'");
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(ЗначенияРеквизитов.КорСчет, "205.00")
			ИЛИ БухгалтерскийУчетКлиентСервер.СчетВИерархии(ЗначенияРеквизитов.КорСчет, "209.00") Тогда
			Результат = НСтр("ru='Возврат средств покупателю'");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Результат) Тогда
			Результат = НСтр("ru='Оплата прочая'");	
		КонецЕсли;
	ИначеЕсли ВидДокумента = Тип("ДокументСсылка.ЗаявкаНаВозврат") Тогда
		Результат = НСтр("ru='Оплата прочая'");
	КонецЕсли;
	
	Если ВидДокумента = Тип("ДокументСсылка.ПлатежноеПоручение") Тогда
		Результат = НСтр("ru='Оплата поставщику'");
	КонецЕсли;
	
	Если ПустаяСтрока(Результат)Тогда
		Если Дебет > 0 Тогда
			Результат = НСтр("ru='Принято'");
		ИначеЕсли Дебет < 0 Тогда
			Результат = НСтр("ru='Сторно: принято'");
		ИначеЕсли Кредит > 0 Тогда
			Результат = НСтр("ru='Передано'");
		Иначе
			Результат = НСтр("ru='Сторно: передано'");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция НовыйТаблицаДокументов()
	
	ТаблицаДокументов = Новый ТаблицаЗначений;
	ТаблицаДокументов.Колонки.Добавить("Договор",                     Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаДокументов.Колонки.Добавить("Дата",                        ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаДокументов.Колонки.Добавить("Документ",                    Документы.ТипВсеСсылки());
	ТаблицаДокументов.Колонки.Добавить("Представление",               ОбщегоНазначения.ОписаниеТипаСтрока(200));
	ТаблицаДокументов.Колонки.Добавить("Дебет",                       ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	ТаблицаДокументов.Колонки.Добавить("Кредит",                      ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	ТаблицаДокументов.Колонки.Добавить("Валюта",                      Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаДокументов.Колонки.Добавить("ВалютнаяСумма",               ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	ТаблицаДокументов.Колонки.Добавить("ДатаВходящегоДокумента",      ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаДокументов.Колонки.Добавить("ЭтоУниверсальныйДокумент",    Новый ОписаниеТипов("Булево"));
	ТаблицаДокументов.Колонки.Добавить("ЭтоКорректировочныйДокумент", Новый ОписаниеТипов("Булево"));
	ТаблицаДокументов.Колонки.Добавить("ДатаДокумента",               ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаДокументов.Колонки.Добавить("НомерДокумента",              ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТаблицаДокументов.Колонки.Добавить("НаименованиеДокумента",       ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТаблицаДокументов.Колонки.Добавить("НаименованиеОперации",        ОбщегоНазначения.ОписаниеТипаСтрока(500));
	
	Возврат ТаблицаДокументов;
	
КонецФункции

Функция ТаблицаПоДаннымКонтрагентаНаОсновеТаблицыПоДаннымОрганизации(ТаблицаПоДаннымОрганизации) Экспорт
	
	ТаблицаПоДаннымКонтрагента = ТаблицаПоДаннымОрганизации.СкопироватьКолонки();
	СоответствиеНаименованийОпераций = СоответствиеНаименованийОпераций();
	
	Для Каждого СтрокаПоДаннымОрганизации Из ТаблицаПоДаннымОрганизации Цикл
		СтрокаПоДаннымКонтрагента = ТаблицаПоДаннымКонтрагента.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПоДаннымКонтрагента, СтрокаПоДаннымОрганизации);
		СтрокаПоДаннымКонтрагента.НаименованиеОперации = СоответствиеНаименованийОпераций.Получить(
			СтрокаПоДаннымОрганизации.НаименованиеОперации);
		СтрокаПоДаннымКонтрагента.Дебет  = СтрокаПоДаннымОрганизации.Кредит;
		СтрокаПоДаннымКонтрагента.Кредит = СтрокаПоДаннымОрганизации.Дебет;
	КонецЦикла;
	
	Возврат ТаблицаПоДаннымКонтрагента;
	
КонецФункции

Процедура ЗаполнитьСписокВыбораНаименованиеОперации(ФормаДокумента) Экспорт
	
	НаименованияОпераций = СоответствиеНаименованийОпераций();
	
	Список = ФормаДокумента.Элементы.ПоДаннымОрганизацииДляЭДОНаименованиеОперации.СписокВыбора;
	
	Список.Очистить();
	
	Для Каждого Элемент Из НаименованияОпераций Цикл
		НаименованиеОперации = Элемент.Ключ;
		
		Список.Добавить(НаименованиеОперации);
	КонецЦикла;
	
КонецПроцедуры

