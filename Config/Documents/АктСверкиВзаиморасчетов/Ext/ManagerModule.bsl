#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	// Возвращаемое значение
	ЕстьОшибкиЗаполнения = Ложь;
	
	// Настраиваем запрос
	ЗапросПроверки = Новый Запрос();
	ЗапросПроверки.УстановитьПараметр("ДатаНачалаСверки",		ДокументОбъект["ДатаНачала"]);
	ЗапросПроверки.УстановитьПараметр("ДатаОкончанияСверки", 	ДокументОбъект["ДатаОкончания"]);
	ЗапросПроверки.УстановитьПараметр("ПоВсемОрганизациям",		ДокументОбъект["ПоВсемОрганизациям"]);
	ЗапросПроверки.УстановитьПараметр("Организация", 			ДокументОбъект["Организация"]);
	ЗапросПроверки.УстановитьПараметр("ТЗПоДаннымОрганизации",	ДокументОбъект["ПоДаннымОрганизации"].Выгрузить());
	ЗапросПроверки.УстановитьПараметр("ТЗПоДаннымКонтрагента",	ДокументОбъект["ПоДаннымКонтрагента"].Выгрузить());
	ЗапросПроверки.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Табличная часть ""ПоДаннымОрганизации""
	|//		(Исходные данные)
	|ВЫБРАТЬ
	|	ТЧ.НомерСтроки		КАК НомерСтроки,
	|	ТЧ.Организация		КАК Организация,
	|	ТЧ.Договор			КАК Договор,
	|	ТЧ.Дата				КАК Дата,
	|	ТЧ.Представление	КАК Представление,
	|	ТЧ.Дебет			КАК Дебет,
	|	ТЧ.Кредит			КАК Кредит
	|ПОМЕСТИТЬ
	|	ТаблЧастьПоДаннымОрганизации
	|ИЗ
	|	&ТЗПоДаннымОрганизации	КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Табличная часть ""ПоДаннымКонтрагента""
	|//		(Исходные данные)
	|ВЫБРАТЬ
	|	ТЧ.НомерСтроки		КАК НомерСтроки,
	|	ТЧ.Организация		КАК Организация,
	|	ТЧ.Договор			КАК Договор,
	|	ТЧ.Дата				КАК Дата,
	|	ТЧ.Представление	КАК Представление,
	|	ТЧ.Дебет			КАК Дебет,
	|	ТЧ.Кредит			КАК Кредит
	|ПОМЕСТИТЬ
	|	ТаблЧастьПоДаннымКонтрагента
	|ИЗ
	|	&ТЗПоДаннымКонтрагента	КАК ТЧ
	|;
	|
	|//------------------------------------------------------------------------------
	|// Проверка таблицы ""По данным организации""
	|//
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Даты, выходящие за период сверки.
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	НомерСтроки	КАК НомерСтроки
	|ИЗ
	|	ТаблЧастьПоДаннымОрганизации
	|ГДЕ
	|	ВЫБОР
	|		КОГДА	&ДатаНачалаСверки <= &ДатаОкончанияСверки
	|			И	&ДатаНачалаСверки > ДАТАВРЕМЯ(1,1,1)
	|			И	&ДатаОкончанияСверки > ДАТАВРЕМЯ(1,1,1)
	|			И	Дата > ДАТАВРЕМЯ(1,1,1)	ТОГДА
	|			// Дата сверки указана в шапке документа корректно.
	|			// Проверяем строку:
	|			(Дата < &ДатаНачалаСверки ИЛИ Дата > &ДатаОкончанияСверки)
	|		ИНАЧЕ
	|			// Дата сверки указана в шапке документа некорректно.
	|			// Не проверяем строку:
	|			ЛОЖЬ
	|	КОНЕЦ
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Незаполненные одновременно графы ""Дебет"" и ""Кредит"".
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	НомерСтроки	КАК НомерСтроки
	|ИЗ
	|	ТаблЧастьПоДаннымОрганизации
	|ГДЕ
	|	Дебет = 0 И Кредит = 0
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Организации в таблице, несоответствующие организации в шапке документа.
	|//		(Финальная таблица для вывода особщений)
	|ВЫБРАТЬ
	|	НомерСтроки	КАК НомерСтроки
	|ИЗ
	|	ТаблЧастьПоДаннымОрганизации
	|ГДЕ
	|	&ПоВсемОрганизациям = ЛОЖЬ
	|	И	НЕ Организация = &Организация
	|	И	НЕ Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|//------------------------------------------------------------------------------
	|// Проверка таблицы ""По данным контрагента""
	|//
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Даты, выходящие за период сверки.
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	НомерСтроки	КАК НомерСтроки
	|ИЗ
	|	ТаблЧастьПоДаннымКонтрагента
	|ГДЕ
	|	ВЫБОР
	|		КОГДА	&ДатаНачалаСверки <= &ДатаОкончанияСверки
	|			И	&ДатаНачалаСверки > ДАТАВРЕМЯ(1,1,1)
	|			И	&ДатаОкончанияСверки > ДАТАВРЕМЯ(1,1,1)
	|			И	Дата > ДАТАВРЕМЯ(1,1,1)	ТОГДА
	|			// Дата сверки указана в шапке документа корректно.
	|			// Проверяем строку:
	|			(Дата < &ДатаНачалаСверки ИЛИ Дата > &ДатаОкончанияСверки)
	|		ИНАЧЕ
	|			// Дата сверки указана в шапке документа некорректно.
	|			// Не проверяем строку:
	|			ЛОЖЬ
	|	КОНЕЦ
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [6]. Незаполненные одновременно графы ""Дебет"" и ""Кредит"".
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	НомерСтроки	КАК НомерСтроки
	|ИЗ
	|	ТаблЧастьПоДаннымКонтрагента
	|ГДЕ
	|	Дебет = 0 И Кредит = 0
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [7]. Организации в таблице, несоответствующие организации в шапке документа.
	|//		(Финальная таблица для вывода особщений)
	|ВЫБРАТЬ
	|	НомерСтроки	КАК НомерСтроки
	|ИЗ
	|	ТаблЧастьПоДаннымКонтрагента
	|ГДЕ
	|	&ПоВсемОрганизациям = ЛОЖЬ
	|	И	НЕ Организация = &Организация
	|	И	НЕ Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";
	
	РезультатыПроверок = ЗапросПроверки.ВыполнитьПакет();
	
	ПараметрыВывода = Новый Структура();
	ПараметрыВывода.Вставить("Ссылка", ДокументОбъект["Ссылка"]);
	
	//---
	// Таблица "По данным организации"
	//---
	
	// [2] Даты, выходящие за период сверки.
	РезультатПроверки = РезультатыПроверок[2];
	Если НЕ РезультатПроверки.Пустой() Тогда
		// Не считаем это ошибкой, препятствующей проведению документа.
		// Просто выводим сообщение.
		
		ТекстШаблон = НСтр("ru='Замечание: дата первичного документа находится вне периода проведения сверки (таблица ""По данным организации"", строка [НомерСтроки])'");
		
		ПараметрыВывода.Вставить("ИмяТаблЧастиДляВыводаСообщений",	"ПоДаннымОрганизации");
		ПараметрыВывода.Вставить("ИмяПоляДляВыводаСообщений",		"Дата");
		ПараметрыВывода.Вставить("ТекстШаблон",						ТекстШаблон);
		ВывестиСообщения(РезультатПроверки.Выбрать(), ПараметрыВывода);
	КонецЕсли;
	
	// [3] Незаполненные одновременно графы "Дебет" и "Кредит".
	РезультатПроверки = РезультатыПроверок[3];
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ТекстШаблон = НСтр("ru='Не заполнены обе графы ""Дебет"" и ""Кредит"" (таблица ""По данным организации"", строка [НомерСтроки])'");
		
		ПараметрыВывода.Вставить("ИмяТаблЧастиДляВыводаСообщений",	"ПоДаннымОрганизации");
		ПараметрыВывода.Вставить("ИмяПоляДляВыводаСообщений",		"Дебет");
		ПараметрыВывода.Вставить("ТекстШаблон",						ТекстШаблон);
		ВывестиСообщения(РезультатПроверки.Выбрать(), ПараметрыВывода);
	КонецЕсли;
	
	// [4] Организации в таблице, несоответствующие организации в шапке документа.
	РезультатПроверки = РезультатыПроверок[4];
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ТекстШаблон = НСтр("ru='Колонка ""Организация"" отличается от организации шапки документа (таблица ""По данным организации"", строки [НомераСтрок])'");
		
		НомераСтрок = РезультатПроверки.Выгрузить().ВыгрузитьКолонку("НомерСтроки");
		НомерСтроки = НомераСтрок[0];
		НомераСтрокСтрокой = СтрСоединить(НомераСтрок, ", ");
		
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("НомераСтрок", НомераСтрокСтрокой);
		
		ПараметрыВывода.Вставить("ИмяТаблЧастиДляВыводаСообщений",	"ПоДаннымОрганизации");
		ПараметрыВывода.Вставить("ИмяПоляДляВыводаСообщений",		"НомерСтроки");
		ПараметрыВывода.Вставить("ТекстШаблон",						ТекстШаблон);
		
		ПараметрыВывода.Вставить("НомерСтроки",						НомерСтроки);
		ПараметрыВывода.Вставить("ВставляемыеЗначения",				ВставляемыеЗначения);
		
		ВывестиСообщения(, ПараметрыВывода);
	КонецЕсли;
	
	//---
	// Таблица "По данным контрагента"
	//---
	
	// [5] Даты, выходящие за период сверки.
	РезультатПроверки = РезультатыПроверок[5];
	Если НЕ РезультатПроверки.Пустой() Тогда
		// Не считаем это ошибкой, препятствующей проведению документа.
		// Просто выводим сообщение.
		
		ТекстШаблон = НСтр("ru='Замечание: дата первичного документа находится вне периода проведения сверки (таблица ""По данным контрагента"", строка [НомерСтроки])'");
		
		ПараметрыВывода.Вставить("ИмяТаблЧастиДляВыводаСообщений",	"ПоДаннымКонтрагента");
		ПараметрыВывода.Вставить("ИмяПоляДляВыводаСообщений",		"Дата");
		ПараметрыВывода.Вставить("ТекстШаблон",						ТекстШаблон);
		ВывестиСообщения(РезультатПроверки.Выбрать(), ПараметрыВывода);
	КонецЕсли;
	
	// [6] Незаполненные одновременно графы "Дебет" и "Кредит".
	РезультатПроверки = РезультатыПроверок[6];
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ТекстШаблон = НСтр("ru='Не заполнены обе графы ""Дебет"" и ""Кредит"" (таблица ""По данным контрагента"", строка [НомерСтроки])'");
		
		ПараметрыВывода.Вставить("ИмяТаблЧастиДляВыводаСообщений",	"ПоДаннымКонтрагента");
		ПараметрыВывода.Вставить("ИмяПоляДляВыводаСообщений",		"Дебет");
		ПараметрыВывода.Вставить("ТекстШаблон",						ТекстШаблон);
		ВывестиСообщения(РезультатПроверки.Выбрать(), ПараметрыВывода);
	КонецЕсли;
	
	// [7] Организации в таблице, несоответствующие организации в шапке документа.
	РезультатПроверки = РезультатыПроверок[7];
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ТекстШаблон = НСтр("ru='Колонка ""Организация"" отличается от организации шапки документа (таблица ""По данным контрагента"", строки [НомераСтрок])'");
		
		НомераСтрок = РезультатПроверки.Выгрузить().ВыгрузитьКолонку("НомерСтроки");
		НомерСтроки = НомераСтрок[0];
		НомераСтрокСтрокой = СтрСоединить(НомераСтрок, ", ");
		
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("НомераСтрок", НомераСтрокСтрокой);
		
		ПараметрыВывода.Вставить("ИмяТаблЧастиДляВыводаСообщений",	"ПоДаннымКонтрагента");
		ПараметрыВывода.Вставить("ИмяПоляДляВыводаСообщений",		"НомерСтроки");
		ПараметрыВывода.Вставить("ТекстШаблон",						ТекстШаблон);
		
		ПараметрыВывода.Вставить("НомерСтроки",						НомерСтроки);
		ПараметрыВывода.Вставить("ВставляемыеЗначения",				ВставляемыеЗначения);
		
		ВывестиСообщения(, ПараметрыВывода);
	КонецЕсли;
	
	//---
	// Таблица "Остатки на начало"
	//---
	
	// Проверка дублей строк остатков
	КоллекцияИменКолонок = Новый Массив();
	Если ИспользуетсяКолонкаОрганизация(ДокументОбъект) Тогда
		КоллекцияИменКолонок.Добавить("Организация");
	КонецЕсли;
	Если ИспользуетсяКолонкаДоговор(ДокументОбъект)	Тогда
		КоллекцияИменКолонок.Добавить("Договор");
	КонецЕсли;
	ТаблицаСписокОрганизаций = ДокументОбъект["СписокОрганизаций"].Выгрузить(,"НомерСтроки,Организация,Договор");
	ТаблицаДублиСтрок = УчетНДС.НайтиДублиСтрок(ТаблицаСписокОрганизаций, КоллекцияИменКолонок);
	Если ТаблицаДублиСтрок.Количество() > 0 Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ШаблонСтроки = НСтр("ru='Обнаружены дубли строк остатков (таблица ""Остатки"", строки [НомераСтрок])'");
		
		ПараметрыВывода = Новый Структура();
		ПараметрыВывода.Вставить("ТаблицаИмя",		"СписокОрганизаций");
		ПараметрыВывода.Вставить("ОбъектСсылка",	ДокументОбъект["Ссылка"]);
		ПараметрыВывода.Вставить("ШаблонСтроки",	ШаблонСтроки);
		УчетНДС.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	КонецЕсли;
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Процедура ЗаполнитьСчетамиПоУмолчанию(ДокументОбъект) Экспорт
	
	ДокументОбъект.СписокСчетов.Очистить();
	
	СписокСчетов = ПолучитьСписокСчетовПоУмолчанию();
	
	Для Каждого Счет Из СписокСчетов Цикл
		НоваяСтрока = ДокументОбъект.СписокСчетов.Добавить();
		НоваяСтрока.Счет				= Счет;
		НоваяСтрока.УчаствуетВРасчетах	= Истина;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСписокСчетовПоУмолчанию() Экспорт
	
	БезУчетаИерархии = Истина;
	
	Возврат БухгалтерскийУчет.СписокСчетов("205.00,206.00,207.00,209.00,210.05,301.00,302.00,304.01,304.02,304.03,304.04",, БезУчетаИерархии);
	
КонецФункции

Функция ПолучитьСтруктуруШапкиДокумента(ДокументОбъект) Экспорт
	
	ШапкаДокумента = Новый Структура("
		|Дата,
		|Организация,
		|Подразделение,
		|КФО,
		|ИФО,
		|БезУчетаИФО,
		|Контрагент,
		|ВалютаДокумента,
		|ДатаНачала,
		|ДатаОкончания,
		|Договор,
		|РазбитьПоДоговорам,
		|ДетализироватьПоДоговорам,
		|ПоВсемОрганизациям,
		|ЭтоЭлектронныйДокумент,
		|СворачиватьОбороты");
		
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);
	
	Возврат ШапкаДокумента;
	
КонецФункции

Процедура ПолучитьДанныеБухУчета(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыЗаполнения = ПолучитьПараметрыЗаполнения(ПараметрыПроцедуры);
	
	РезультатыСверки = ВыполнитьСтандартнуюСверку(ПараметрыЗаполнения);
	
	Если ПараметрыПроцедуры.ШапкаДокумента.ЭтоЭлектронныйДокумент Тогда
		РезультатыСверки.Вставить("Успешно", Ложь);
		РезультатыСверки.Вставить("ЗаполнятьДанныеКонтрагента", ПараметрыПроцедуры.ЗаполнятьДанныеКонтрагента);
	КонецЕсли;
	
	СверкаПоДолгосрочнымДоговорам = ВыполнитьСверкуПоДолгосрочнымДоговорам(ПараметрыЗаполнения);
	
	// Добавляем обороты
	ТаблицаПриемник = РезультатыСверки.Обороты;
	ТаблицаИсточник = СверкаПоДолгосрочнымДоговорам.Обороты;
	Для Каждого СтрокаТаблицы Из ТаблицаИсточник Цикл
		НоваяСтрока = ТаблицаПриемник.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	ТаблицаПоДаннымОрганизации = РезультатыСверки.Обороты;
	
	СвернутьОбороты(ТаблицаПоДаннымОрганизации, ПараметрыПроцедуры);
	
	УдалитьСтрокиСНулевымиСуммами(ТаблицаПоДаннымОрганизации);
	
	// Добавляем остатки на начало
	ТаблицаПриемник = РезультатыСверки.ОстаткиНаНачало;
	ТаблицаИсточник = СверкаПоДолгосрочнымДоговорам.ОстаткиНаНачало;
	Для Каждого СтрокаТаблицы Из ТаблицаИсточник Цикл
		НоваяСтрока = ТаблицаПриемник.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	РезультатыСверки.ОстаткиНаНачало.Свернуть("Организация,Договор", "ОстатокНаНачало");
	
	Если ПараметрыПроцедуры.ШапкаДокумента.ЭтоЭлектронныйДокумент Тогда
		РезультатыСверки.Вставить("ОстатокНаНачало", РезультатыСверки.ОстаткиНаНачало.Итог("ОстатокНаНачало"));
	КонецЕсли;
	
	// Заполним представления документов в таблице оборотов
	
	ЗаполнитьПредставленияДокументов(ТаблицаПоДаннымОрганизации, ПараметрыПроцедуры, ПараметрыЗаполнения);
	
	РезультатыСверки.Вставить("ОшибкиНастроекПредставленияДокументаДлительныеДоговоры", ПараметрыПроцедуры.ОшибкиНастроекПредставленияДокументаДлительныеДоговоры);
	
	ТаблицаПоДаннымОрганизации.Сортировать("Дата Возр, Представление Возр");
	
	Если ПараметрыПроцедуры.ШапкаДокумента.ЭтоЭлектронныйДокумент Тогда
		РезультатыСверки.Вставить("ПоДаннымОрганизации", ТаблицаПоДаннымОрганизации);
		
		Если ПараметрыПроцедуры.ЗаполнятьДанныеКонтрагента Тогда
			РезультатыСверки.Вставить("ПоДаннымКонтрагента", ТаблицаПоДаннымКонтрагента(ТаблицаПоДаннымОрганизации));
		КонецЕсли;
		
		РезультатыСверки.Успешно = Истина;
		
	Иначе
		ТаблицаПоДаннымОрганизации.Колонки.Добавить("ДатаУчетногоДокумента", Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
		
		ЗаполнитьДатыУчетныхДокументов(, ТаблицаПоДаннымОрганизации);
	КонецЕсли;
	
	ЗаполнитьКолонкуОтветственныйВТаблице(ТаблицаПоДаннымОрганизации);
	
	ПоместитьВоВременноеХранилище(РезультатыСверки, АдресРезультата);
	
КонецПроцедуры

Процедура РассчитатьРасхождения(ДокументОбъект) Экспорт
	
	Если НЕ ИспользуетсяТаблицаОстатков(ДокументОбъект)
		И НЕ ИспользуетсяДеревоОстатков(ДокументОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Поиск		= Новый Структура();
	ПоискСтрока	= "";
	
	Если ИспользуетсяКолонкаОрганизация(ДокументОбъект) Тогда
		Поиск.Вставить("Организация");
		ПоискСтрока = ПоискСтрока + ?(ПустаяСтрока(ПоискСтрока), "", ",") + "Организация";
	КонецЕсли;
	
	Если ИспользуетсяКолонкаДоговор(ДокументОбъект) Тогда
		Поиск.Вставить("Договор");
		ПоискСтрока = ПоискСтрока + ?(ПустаяСтрока(ПоискСтрока), "", ",") + "Договор";
	КонецЕсли;
	
	ДобавитьСтрокиСНулевымиНачальнымиОстатками(ДокументОбъект);
	
	ТаблицаСписокОрганизаций = ДокументОбъект["СписокОрганизаций"].Выгрузить();
	ТаблицаСписокОрганизаций.Свернуть("Организация,Договор", "ОстатокНаНачало,ОстатокНаКонец,Расхождение"); // сворачиваем по обеим колонкам, независимо от того, какие используются
	
	ТаблицаПоДаннымОрганизации = ДокументОбъект["ПоДаннымОрганизации"].Выгрузить(, ПоискСтрока + ",Дебет,Кредит");
	ТаблицаПоДаннымОрганизации.Индексы.Добавить(ПоискСтрока);
	
	ТаблицаПоДаннымКонтрагента = ДокументОбъект["ПоДаннымКонтрагента"].Выгрузить(, ПоискСтрока + ",Дебет,Кредит");
	ТаблицаПоДаннымКонтрагента.Индексы.Добавить(ПоискСтрока);
	
	Для Каждого СтрокаОстатков Из ТаблицаСписокОрганизаций Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаОстатков);
		
		// По данным организации
		ИтогДебетПоДаннымОрганизации	= 0;
		ИтогКредитПоДаннымОрганизации	= 0;
		МассивСтрок = ТаблицаПоДаннымОрганизации.НайтиСтроки(Поиск);
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			ИтогДебетПоДаннымОрганизации	= ИтогДебетПоДаннымОрганизации	+ СтрокаТаблицы["Дебет"];
			ИтогКредитПоДаннымОрганизации	= ИтогКредитПоДаннымОрганизации	+ СтрокаТаблицы["Кредит"];
		КонецЦикла;
		
		// По данным контрагента
		ИтогДебетПоДаннымКонтрагента	= 0;
		ИтогКредитПоДаннымКонтрагента	= 0;
		МассивСтрок = ТаблицаПоДаннымКонтрагента.НайтиСтроки(Поиск);
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			ИтогДебетПоДаннымКонтрагента	= ИтогДебетПоДаннымКонтрагента	+ СтрокаТаблицы["Дебет"];
			ИтогКредитПоДаннымКонтрагента	= ИтогКредитПоДаннымКонтрагента	+ СтрокаТаблицы["Кредит"];
		КонецЦикла;
		
		СтрокаОстатков["ОстатокНаКонец"]	= СтрокаОстатков["ОстатокНаНачало"] + ИтогДебетПоДаннымОрганизации - ИтогКредитПоДаннымОрганизации;
		СтрокаОстатков["Расхождение"]		= (ИтогДебетПоДаннымОрганизации - ИтогКредитПоДаннымОрганизации)
			+ (ИтогДебетПоДаннымКонтрагента - ИтогКредитПоДаннымКонтрагента);
	КонецЦикла;
	
	ДокументОбъект["СписокОрганизаций"].Загрузить(ТаблицаСписокОрганизаций);
	
	ДокументОбъект["ТребуетсяРасчетСумм"] = Ложь;
	
КонецПроцедуры

Процедура УстановитьОтветственныхЛиц(ДокументОбъект) Экспорт
	
	ОтветственноеЛицоОрганизации = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Главный бухгалтер",
		ДокументОбъект["Организация"],
		ДокументОбъект["Дата"]);
		
	ДокументОбъект["ГлавныйБухгалтер"] = ОтветственноеЛицоОрганизации["ОтветственноеЛицоСсылка"];
	
КонецПроцедуры

Функция ПолучитьПредставлениеДокумента(СтрокаТабличнойЧасти, ШапкаДокумента, ДополнительныеПараметры = Неопределено) Экспорт
	
	Перем	РеквизитыПервичногоДокумента,
			Вид,
			Дата,
			Номер;
	
	ДокументСсылка = СтрокаТабличнойЧасти["Документ"];
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ЭтоДокументНачисленияПоДолгосрочномуДоговору(ДокументСсылка) Тогда
		
		Номер = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
			ДокументСсылка,
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Номер"));
		
		ПредставлениеДокумента = ПолучитьПредставлениеДокументаНачисленияПоДлительномуДоговору(
			СтрокаТабличнойЧасти,
			ШапкаДокумента,
			ДополнительныеПараметры);
		
		СтруктураПредставлениеДокумента = Новый Структура();
		СтруктураПредставлениеДокумента.Вставить("Представление",	ПредставлениеДокумента);
		СтруктураПредставлениеДокумента.Вставить("Дата",			СтрокаТабличнойЧасти["Дата"]);
		СтруктураПредставлениеДокумента.Вставить("Номер",			Номер);
			
		Возврат СтруктураПредставлениеДокумента;
	
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура") Тогда
		ДополнительныеПараметры = Новый Структура();
	КонецЕсли;
	
	ДополнительныеПараметры.Свойство("РеквизитыПервичногоДокумента", РеквизитыПервичногоДокумента);
	
	Если РеквизитыПервичногоДокумента = Неопределено Тогда
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("Контрагент",	ШапкаДокумента["Контрагент"]);
		ДополнительныеПараметры.Вставить("Договор",		СтрокаТабличнойЧасти["Договор"]);
		
		РеквизитыПервичногоДокумента = ПолучитьДанныеПервичногоДокумента(ДокументСсылка, ДополнительныеПараметры);
		
	КонецЕсли;
	
	РеквизитыПервичногоДокумента.Свойство("ВидПервичногоДокумента", Вид);
	РеквизитыПервичногоДокумента.Свойство("ДатаПервичногоДокумента", Дата);
	РеквизитыПервичногоДокумента.Свойство("НомерПервичногоДокумента", Номер);
	
	ИспользоватьПервичныйДокумент = (ЗначениеЗаполнено(Вид) ИЛИ ЗначениеЗаполнено(Дата) ИЛИ ЗначениеЗаполнено(Номер));
	
	Если ИспользоватьПервичныйДокумент Тогда
		// Используем для представления первичный документ
		
		// Для платежных документов - вид документа устанавливаем явно
		ТипыПлатежныхДокументов	= ПолучитьТипыПлатежныхДокументов();
		ЭтоПлатежныйДокумент	= (НЕ ТипыПлатежныхДокументов.Найти(ТипЗнч(ДокументСсылка)) = Неопределено);
		Если ЭтоПлатежныйДокумент Тогда
			Вид = НСтр("ru='Платежное поручение'");
		КонецЕсли;
	Иначе
		// Используем для представления сам документ
		
		СвойстваДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата,Номер");
		
		Вид		= Строка(ТипЗнч(ДокументСсылка));
		Дата	= СвойстваДокумента["Дата"];
		Номер	= РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(ДокументСсылка, СвойстваДокумента.Номер);
	КонецЕсли;
	
	// Оформляем значения
	Если ЗначениеЗаполнено(Вид) Тогда
		ВидСтрокой = СокрЛП(Вид);
	Иначе
		ВидСтрокой = НСтр("ru='<без названия>'");
	КонецЕсли;
	Если ЗначениеЗаполнено(Дата) Тогда
		ДатаСтрокой = Формат(Дата, "ДФ=""дд.ММ.гггг""");
	Иначе
		ДатаСтрокой = "-";
	КонецЕсли;
	Если ЗначениеЗаполнено(Номер) Тогда
		НомерСтрокой = СокрЛП(Номер);
	Иначе
		НомерСтрокой = "-";
	КонецЕсли;
	
	ПредставлениеШаблон = НСтр("ru='[Вид] №[Номер] от [Дата]'");
	
	ВставляемыеЗначения = Новый Структура();
	ВставляемыеЗначения.Вставить("Вид",		ВидСтрокой);
	ВставляемыеЗначения.Вставить("Дата",	ДатаСтрокой);
	ВставляемыеЗначения.Вставить("Номер",	НомерСтрокой);
	
	ПредставлениеДокумента = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ПредставлениеШаблон, ВставляемыеЗначения);
	
	ДатаПредставления = ?(ЗначениеЗаполнено(Дата), Дата, СтрокаТабличнойЧасти["Дата"]);
	
	СтруктураПредставлениеДокумента = Новый Структура();
	СтруктураПредставлениеДокумента.Вставить("Представление",	ПредставлениеДокумента);
	СтруктураПредставлениеДокумента.Вставить("Дата",			ДатаПредставления);
	СтруктураПредставлениеДокумента.Вставить("Номер",			НомерСтрокой);
	
	Возврат СтруктураПредставлениеДокумента;
	
КонецФункции

Процедура ЗаполнитьДеревоОстатковПоДоговорамИзТаблицы(ДеревоОстатков, ТаблицаОстатков, КоличествоСтрокОстатков) Экспорт
	
	СворачиватьПоДоговорам = Истина; // Должно быть Истина, иначе получаются некорректные суммы в строках организаций (кратное увеличение по количеству дублей договоров)
	
	// Сначала принудительно сортируем по организации
	ТаблицаОстатков.Сортировать("Организация");
	
	ДеревоОстатков.Строки.Очистить();
	
	КоличествоСтрокОстатков	= 0;
	СчетчикОрганизаций		= 0;
	ПрежняяОрганизация		= Неопределено;
	
	Для Каждого СтрокаТаблицы Из ТаблицаОстатков Цикл
		ТекущаяОрганизация	= СтрокаТаблицы["Организация"];
		ТекущийДоговор		= СтрокаТаблицы["Договор"];
		
		// Добавляем строку для текущей организации
		Если НЕ ПрежняяОрганизация = ТекущаяОрганизация Тогда
			СчетчикОрганизаций	= СчетчикОрганизаций + 1;
			ПрежняяОрганизация	= ТекущаяОрганизация;
			
			СтрокаОрганизации = ДеревоОстатков.Строки.Добавить();
			СтрокаОрганизации["Организация"]	= ТекущаяОрганизация;
			СтрокаОрганизации["ЭтоГруппа"]		= Истина;
		КонецЕсли;
		
		// Нужно ли добавлять новую строку для текущего договора
		Если СворачиватьПоДоговорам Тогда
			Поиск = Новый Структура("Договор", ТекущийДоговор);
			МассивСтрок = СтрокаОрганизации.Строки.НайтиСтроки(Поиск);
			Если МассивСтрок.Количество() > 0 Тогда
				ДобавитьСтрокуДоговора = Ложь;
				СтрокаДоговора = МассивСтрок[0];
			Иначе
				ДобавитьСтрокуДоговора = Истина;
			КонецЕсли;
		Иначе
			ДобавитьСтрокуДоговора = Истина;
		КонецЕсли;
		
		// Добавляем строку для текущего договора
		Если ДобавитьСтрокуДоговора Тогда
			КоличествоСтрокОстатков	= КоличествоСтрокОстатков + 1;
			
			СтрокаДоговора = СтрокаОрганизации.Строки.Добавить();
			СтрокаДоговора["Организация"]	= ТекущаяОрганизация;
			СтрокаДоговора["Договор"]		= ТекущийДоговор;
		КонецЕсли;
		
		СтрокаДоговора["ОстатокНаНачало"]	= СтрокаДоговора["ОстатокНаНачало"]	+ СтрокаТаблицы["ОстатокНаНачало"];
		СтрокаДоговора["ОстатокНаКонец"]	= СтрокаДоговора["ОстатокНаКонец"]	+ СтрокаТаблицы["ОстатокНаКонец"];
		СтрокаДоговора["Расхождение"]		= СтрокаДоговора["Расхождение"]		+ СтрокаТаблицы["Расхождение"];
		
		СтрокаОрганизации["ОстатокНаНачало"]	= СтрокаОрганизации["ОстатокНаНачало"]	+ СтрокаТаблицы["ОстатокНаНачало"];
		СтрокаОрганизации["ОстатокНаКонец"]		= СтрокаОрганизации["ОстатокНаКонец"]	+ СтрокаТаблицы["ОстатокНаКонец"];
		СтрокаОрганизации["Расхождение"]		= СтрокаОрганизации["Расхождение"]		+ СтрокаТаблицы["Расхождение"];
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуОстатковПоДоговорамИзДерева(ТаблицаОстатков, ДеревоОстатков) Экспорт
	
	СворачиватьПоДоговорам = Истина; // Должно быть Истина, иначе получаются некорректные суммы в строках организаций (кратное увеличение по количеству дублей договоров)
	
	ТаблицаОстатков.Очистить();
	
	Поиск = Новый Структура("Организация, Договор");
	
	Для Каждого СтрокаОрганизации Из ДеревоОстатков.ПолучитьЭлементы() Цикл
		СтрокиДоговоров = СтрокаОрганизации.ПолучитьЭлементы();
		
		Если СтрокиДоговоров.Количество() = 0 Тогда
			ЗаполнитьЗначенияСвойств(Поиск, СтрокаОрганизации);
			
			МассивСтрок = ТаблицаОстатков.НайтиСтроки(Поиск);
			Если МассивСтрок.Количество() > 0 Тогда
				СтрокаТаблицы = МассивСтрок[0];
				СтрокаТаблицы["ОстатокНаНачало"]	= СтрокаТаблицы["ОстатокНаНачало"]	+ СтрокаОрганизации["ОстатокНаНачало"];
				СтрокаТаблицы["ОстатокНаКонец"]		= СтрокаТаблицы["ОстатокНаКонец"]	+ СтрокаОрганизации["ОстатокНаКонец"];
				СтрокаТаблицы["Расхождение"]		= СтрокаТаблицы["Расхождение"]		+ СтрокаОрганизации["Расхождение"];
			Иначе
				СтрокаТаблицы = ТаблицаОстатков.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаОрганизации);
			КонецЕсли;
		КонецЕсли;
		
		Для Каждого СтрокаДоговора Из СтрокиДоговоров Цикл
			// Нужно ли добавлять новую строку для договора
			Если СворачиватьПоДоговорам Тогда
				Поиск["Организация"]	= СтрокаОрганизации["Организация"];
				Поиск["Договор"]		= СтрокаДоговора["Договор"];
				
				МассивСтрок = ТаблицаОстатков.НайтиСтроки(Поиск);
				Если МассивСтрок.Количество() > 0 Тогда
					ДобавитьСтрокуДоговора = Ложь;
					СтрокаТаблицы = МассивСтрок[0];
				Иначе
					ДобавитьСтрокуДоговора = Истина;
				КонецЕсли;
			Иначе
				ДобавитьСтрокуДоговора = Истина;
			КонецЕсли;
			
			// Добавляем строку для текущего договора
			Если ДобавитьСтрокуДоговора Тогда
				СтрокаТаблицы = ТаблицаОстатков.Добавить();
				СтрокаТаблицы["Договор"]		= СтрокаДоговора["Договор"];
				СтрокаТаблицы["Организация"]	= СтрокаОрганизации["Организация"];
			КонецЕсли;
			
			СтрокаТаблицы["ОстатокНаНачало"]	= СтрокаТаблицы["ОстатокНаНачало"]	+ СтрокаДоговора["ОстатокНаНачало"];
			СтрокаТаблицы["ОстатокНаКонец"]		= СтрокаТаблицы["ОстатокНаКонец"]	+ СтрокаДоговора["ОстатокНаКонец"];
			СтрокаТаблицы["Расхождение"]		= СтрокаТаблицы["Расхождение"]		+ СтрокаДоговора["Расхождение"];
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьСтрокиОтличающихсяОрганизаций(ДокументОбъект) Экспорт
	
	УдалитьСтрокиОтличающихсяОрганизацийВТабличнойЧасти(ДокументОбъект, "ПоДаннымОрганизации");
	УдалитьСтрокиОтличающихсяОрганизацийВТабличнойЧасти(ДокументОбъект, "ПоДаннымКонтрагента");
	УдалитьСтрокиОтличающихсяОрганизацийВТабличнойЧасти(ДокументОбъект, "СписокОрганизаций");
	
КонецПроцедуры

Функция ИспользуетсяТаблицаОстатков(ДокументОбъект) Экспорт
	
	Возврат (НЕ ДокументОбъект["ПоВсемОрганизациям"] И ДокументОбъект["ДетализироватьПоДоговорам"])
		ИЛИ (ДокументОбъект["ПоВсемОрганизациям"] И НЕ ДокументОбъект["ДетализироватьПоДоговорам"]);
	
КонецФункции

Функция ИспользуетсяДеревоОстатков(ДокументОбъект) Экспорт
	
	Возврат ДокументОбъект["ПоВсемОрганизациям"] И ДокументОбъект["ДетализироватьПоДоговорам"];
	
КонецФункции

Функция ИспользуетсяКолонкаОрганизация(ДокументОбъект) Экспорт
	
	Возврат ДокументОбъект["ПоВсемОрганизациям"];
	
КонецФункции

Функция ИспользуетсяКолонкаДоговор(ДокументОбъект) Экспорт
	
	Возврат ДокументОбъект["ДетализироватьПоДоговорам"];
	
КонецФункции

Функция ПолучитьСписокОтмеченныхСчетов(ДокументОбъект) Экспорт
	
	Поиск = Новый Структура("УчаствуетВРасчетах", Истина);
	
	МассивСтрок = ДокументОбъект["СписокСчетов"].НайтиСтроки(Поиск);
	
	СписокСчетов = ДокументОбъект["СписокСчетов"].Выгрузить(МассивСтрок, "Счет").ВыгрузитьКолонку("Счет");
	
	Возврат СписокСчетов;
	
КонецФункции

Процедура ЗаполнитьДатыУчетныхДокументов(ДокументОбъект = Неопределено, Таблица = Неопределено) Экспорт
	
	Если ДокументОбъект <> Неопределено И Таблица = Неопределено Тогда
		
		МассивСсылок = ДокументОбъект.ПоДаннымОрганизации.Выгрузить(, "Документ").ВыгрузитьКолонку("Документ");
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСсылок, ДокументОбъект.ПоДаннымКонтрагента.Выгрузить(, "Документ").ВыгрузитьКолонку("Документ"), Истина);
		
		ДатыУчетныхДокументов = ПолучитьДатыУчетныхДокументов(МассивСсылок);
		
		Если ДатыУчетныхДокументов = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ЗаполнитьДатыУчетныхДокументовВТаблице(ДокументОбъект.ПоДаннымОрганизации, ДатыУчетныхДокументов);
		
		ЗаполнитьДатыУчетныхДокументовВТаблице(ДокументОбъект.ПоДаннымКонтрагента, ДатыУчетныхДокументов);
	
	ИначеЕсли ДокументОбъект = Неопределено И Таблица <> Неопределено Тогда
		
		МассивСсылок = Таблица.ВыгрузитьКолонку("Документ");
		
		ДатыУчетныхДокументов = ПолучитьДатыУчетныхДокументов(МассивСсылок);
		
		Если ДатыУчетныхДокументов = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ЗаполнитьДатыУчетныхДокументовВТаблице(Таблица, ДатыУчетныхДокументов);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКолонкуОтветственный(ДокументОбъект) Экспорт
	
	ЗаполнитьКолонкуОтветственныйВТаблице(ДокументОбъект.ПоДаннымОрганизации);
	
КонецПроцедуры

