	|	СписокОрганизаций.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	СписокОрганизаций.Договор,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.ДатаДоговора, ДАТАВРЕМЯ(1, 1, 1)),
	|	ЕСТЬNULL(ДоговорыКонтрагентов.НомерДоговора, """"),
