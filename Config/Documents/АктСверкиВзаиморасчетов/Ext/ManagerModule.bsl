	|				ВЫБОР
	|					КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Договоры) ТОГДА
	|						Субконто1 В(&Договоры)
	|					КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Договоры) ТОГДА
	|						Субконто2 В(&Договоры)
	|					КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Договоры) ТОГДА
	|						Субконто3 В(&Договоры)
	|					ИНАЧЕ
	|						ЛОЖЬ
	|				КОНЕЦ
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоОрганизации ТОГДА
	|				Организация = &Организация
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоПодразделению ТОГДА
	|				Подразделение = &Подразделение
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО = &КФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоВалюте ТОГДА
	|				Валюта = &Валюта
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|	)	КАК Остатки
	|ГДЕ
	|	// Фильтр остатков по длительным договорам
	|	// По длительным договорам исключаем остатки, вне зависимости от настроек
	|	// По всем иным (прочим, не длительным) договорам ничего не исключаем
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Договоры) ТОГДА
	|			НЕ ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры) В (&ВсеДлительныеДоговоры)
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Договоры) ТОГДА
	|			НЕ ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры) В (&ВсеДлительныеДоговоры)
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Договоры) ТОГДА
	|			НЕ ВЫРАЗИТЬ(Субконто3 КАК Справочник.Договоры) В (&ВсеДлительныеДоговоры)
	|		ИНАЧЕ
	|			// Отсутствует субконто Договоры
	|			// Данный фильтр не должен отсекать такой остаток
	|			ИСТИНА
	|	КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	Организация,
	|	ВЫБОР
	|		КОГДА &ДетализироватьОстаткиПоДоговорам ТОГДА
	|			ВЫБОР
	|				КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Договоры) ТОГДА
	|					ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры)
	|				КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Договоры) ТОГДА
	|					ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры)
	|				КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Договоры) ТОГДА
	|					ВЫРАЗИТЬ(Субконто3 КАК Справочник.Договоры)
	|				ИНАЧЕ
	|					ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|			КОНЕЦ
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ
	|ИМЕЮЩИЕ
	|	НЕ СУММА(ВЫБОР
	|		КОГДА &ВыбиратьВалютныеСуммы ТОГДА
	|			ВалютнаяСуммаОстаток
	|		ИНАЧЕ
	|			СуммаОстаток
	|	КОНЕЦ) = 0";
	
	РезультатыПоиска = ЗапросПоиск.ВыполнитьПакет();
	
	// [6]. Обороты и реквизиты первичных документов
	Обороты = РезультатыПоиска[6].Выгрузить();
	
	// [7]. Остатки на начало периода
	ОстаткиНаНачало = РезультатыПоиска[7].Выгрузить();
	
	РезультатыСверки = Новый Структура();
	РезультатыСверки.Вставить("Обороты",			Обороты);
	РезультатыСверки.Вставить("ОстаткиНаНачало",	ОстаткиНаНачало);
	
	Возврат РезультатыСверки;
	
КонецФункции

Функция ВыполнитьСверкуПоДолгосрочнымДоговорам(Параметры)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДатаПерехода64н",					Параметры.ДатаПерехода64н);
	
	ЗапросПоиск.УстановитьПараметр("ДатаНачалаОбороты",					Параметры.ДатаНачалаОбороты);
	ЗапросПоиск.УстановитьПараметр("ДатаОкончанияОбороты",				Параметры.ДатаОкончанияОбороты);
	ЗапросПоиск.УстановитьПараметр("ДатаНачалаОстатки",					Параметры.ДатаНачалаОстатки);
	ЗапросПоиск.УстановитьПараметр("Организация",						Параметры.Организация);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоОрганизации",	Параметры.ИспользоватьОтборПоОрганизации);
	ЗапросПоиск.УстановитьПараметр("Подразделение",						Параметры.Подразделение);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	Параметры.ИспользоватьОтборПоПодразделению);
	ЗапросПоиск.УстановитьПараметр("ИФО",								Параметры.ИФО);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоИФО",			Параметры.ИспользоватьОтборПоИФО);
	ЗапросПоиск.УстановитьПараметр("КФО",								Параметры.КФО);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоКФО",			Параметры.ИспользоватьОтборПоКФО);
	ЗапросПоиск.УстановитьПараметр("ИсключаемыеТипыРегистратора",		Параметры.ИсключаемыеТипыРегистратора);
	ЗапросПоиск.УстановитьПараметр("ДетализироватьОстаткиПоДоговорам",	Параметры.ДетализироватьОстаткиПоДоговорам);
	ЗапросПоиск.УстановитьПараметр("ВидСубконтоДоговоры",				Параметры.ВидСубконтоДоговоры);
	
	ЗапросПоиск.УстановитьПараметр("ВсеДлительныеДоговоры",						Параметры.ДоговорыСКонтрагентом.ДлительныеДоговоры.Все);
	ЗапросПоиск.УстановитьПараметр("ДлительныеДоговорыУчреждениеПродавец",		Параметры.ДоговорыСКонтрагентом.ДлительныеДоговоры.УчреждениеЯвляетсяПродавцом.Все);
	ЗапросПоиск.УстановитьПараметр("ДлительныеДоговорыУчреждениеПокупатель",	Параметры.ДоговорыСКонтрагентом.ДлительныеДоговоры.УчреждениеЯвляетсяПокупателем.Все);
	
	ЗапросПоиск.УстановитьПараметр("Счета10440",						Параметры.НастройкиДляСверкиПоДлительнымДоговорам.Счета.Счета10440);
	ЗапросПоиск.УстановитьПараметр("Счета11140",						Параметры.НастройкиДляСверкиПоДлительнымДоговорам.Счета.Счета11140);
	ЗапросПоиск.УстановитьПараметр("Счета20500",						Параметры.НастройкиДляСверкиПоДлительнымДоговорам.Счета.Счета20500);
	ЗапросПоиск.УстановитьПараметр("Счета20500Кроме20540",				Параметры.НастройкиДляСверкиПоДлительнымДоговорам.Счета.Счета20500Кроме20540);
	ЗапросПоиск.УстановитьПараметр("Счета20900",						Параметры.СчетаСтандартнойСверки.Счета20900);
	ЗапросПоиск.УстановитьПараметр("Счета21005",						Параметры.НастройкиДляСверкиПоДлительнымДоговорам.Счета.Счета21005);
	ЗапросПоиск.УстановитьПараметр("Счета30220",						Параметры.НастройкиДляСверкиПоДлительнымДоговорам.Счета.Счета30220);
	ЗапросПоиск.УстановитьПараметр("Счета40140",						Параметры.НастройкиДляСверкиПоДлительнымДоговорам.Счета.Счета40140);
	ЗапросПоиск.УстановитьПараметр("Счета40150",						Параметры.НастройкиДляСверкиПоДлительнымДоговорам.Счета.Счета40150);
	ЗапросПоиск.УстановитьПараметр("Счета40160",						Параметры.СчетаСтандартнойСверки.Счета40160);
	ЗапросПоиск.УстановитьПараметр("АнализируемыеСчетаОбороты",			Параметры.НастройкиДляСверкиПоДлительнымДоговорам.Счета.АнализируемыеСчетаОбороты);
	ЗапросПоиск.УстановитьПараметр("АнализируемыеСчетаОстатки",			Параметры.НастройкиДляСверкиПоДлительнымДоговорам.Счета.АнализируемыеСчетаОстатки);
	ЗапросПоиск.УстановитьПараметр("УчитыватьНачисленияДлительныеДоговорыПродавец",	Параметры.НастройкиДляСверкиПоДлительнымДоговорам.УчитыватьНачисленияДлительныеДоговорыПродавец);
	ЗапросПоиск.УстановитьПараметр("УчитыватьНачисленияДлительныеДоговорыПокупатель",	Параметры.НастройкиДляСверкиПоДлительнымДоговорам.УчитыватьНачисленияДлительныеДоговорыПокупатель);
	
	ЗапросПоиск.Текст = "
	|///////////////////////////////////////////////////////////////////////////////
	|// [0]. Все обороты услуг по длительным договорам (подготовка)
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организация											КАК Организация,
	|	Период												КАК Дата,
	|	Регистратор											КАК Документ,
	|	Субконто1											КАК Договор,
	|	ВЫБОР
	|		КОГДА &УчитыватьНачисленияДлительныеДоговорыПродавец И Субконто1 В(&ДлительныеДоговорыУчреждениеПродавец) И Счет В(&Счета40140) ТОГДА
	|			СуммаОборотДт
	|		КОГДА &УчитыватьНачисленияДлительныеДоговорыПродавец И Субконто1 В(&ДлительныеДоговорыУчреждениеПродавец) И Счет В(&Счета40150) ТОГДА
	|			-СуммаОборотКт
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ												КАК Дебет,
	|	ВЫБОР
	|		КОГДА &УчитыватьНачисленияДлительныеДоговорыПокупатель И Субконто1 В(&ДлительныеДоговорыУчреждениеПокупатель) И Счет В(&Счета10440) ТОГДА
	|			СуммаОборотКт
	|		КОГДА &УчитыватьНачисленияДлительныеДоговорыПокупатель И Субконто1 В(&ДлительныеДоговорыУчреждениеПокупатель) И Счет В(&Счета40140) ТОГДА
	|			-СуммаОборотДт
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ												КАК Кредит
	|ПОМЕСТИТЬ
	|	ВсеОборотыПоДлительнымДоговорам
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|		&ДатаНачалаОбороты,						// 1
	|		&ДатаОкончанияОбороты,					// 2
	|		Регистратор,							// 3
	|		Счет В(&АнализируемыеСчетаОбороты),		// 4.Счет
	|		&ВидСубконтоДоговоры,					// 5.Субконто
	|		// 6.Условия
	|		// (одинаковые для отбора оборотов, остатков
	|		//  КРОМЕ отбора по
	|		//    валюте		- здесь нет такого отбора
	|		//    контрагенту	- здесь заменен отбором по договору
	|		//    по договору	- здесь всегда отбор)
	|		//
	|		// Отбор по договору
	|		Субконто1 В(&ВсеДлительныеДоговоры)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоОрганизации ТОГДА
	|				Организация = &Организация
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоПодразделению ТОГДА
	|				Подразделение = &Подразделение
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО = &КФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|	) КАК Обороты
	|ГДЕ
	|	НЕ ТИПЗНАЧЕНИЯ(Регистратор) В(&ИсключаемыеТипыРегистратора)
	|	// Исключаем операцию переноса кредиторской задолженности по арендной плате при переходе на СГС Аренда
	|	И НЕ (Счет В(&Счета10440) И КорСчет В(&Счета30220))
	|	// Исключаем документы, формирующие входящие остатки по договорам аренды
	|	И НЕ (ТИПЗНАЧЕНИЯ(Регистратор) = ТИП(Документ.НачислениеДоходовБудущихПериодов) И Период < &ДатаПерехода64н)
	|	И НЕ (ТИПЗНАЧЕНИЯ(Регистратор) = ТИП(Документ.СписаниеДоходовБудущихПериодов) И Период < &ДатаПерехода64н)
	|	// Корректировка или досрочное прекращение договора (обратные проводки к проводкам классификации объекта аренды)
	|	И НЕ (Счет В(&Счета40140) И КорСчет В(&Счета20500Кроме20540))
	|	И НЕ (Счет В(&Счета40140) И КорСчет В(&Счета21005))
	|	И НЕ (Счет В(&Счета40140) И КорСчет В(&Счета11140))
	|	// Корректировка или досрочное прекращение договора (сторно)
	|	И НЕ (Счет В(&Счета40150) И КорСчет В(&Счета21005))
	|	// Перенос в состав доходов будущих периодов, признаваемых в текущем году
	|	И НЕ (Счет В(&Счета40140) И КорСчет В(&Счета40140))
	|	// Внутреннее перемещение
	|	И НЕ (Счет В(&Счета10440) И КорСчет В(&Счета10440))
	|	// Задолженность по штрафам, пеням, недостачам, хищениям; уточнение/уменьшение задолженности
	|	И НЕ (Счет В(&Счета40140) И КорСчет В(&Счета20900))
	|;
	|
	|///////////////////////////////////////////////////////////////////////////////
	|// [1]. Все обороты услуг по длительным договорам
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ
	|	Организация											КАК Организация,
	|	Дата												КАК Дата,
	|	Документ											КАК Документ,
	|	Договор												КАК Договор,
	|	(Договор В(&ДлительныеДоговорыУчреждениеПродавец))		КАК ЭтоНачислениеПродавца,
	|	(Договор В(&ДлительныеДоговорыУчреждениеПокупатель))	КАК ЭтоНачислениеПокупателя,
	|	СУММА(Дебет)										КАК Дебет,
	|	СУММА(Кредит)										КАК Кредит
	|ИЗ
	|	ВсеОборотыПоДлительнымДоговорам
	|СГРУППИРОВАТЬ ПО
	|	Организация,
	|	Дата,
	|	Документ,
	|	Договор,
	|	(Договор В(&ДлительныеДоговорыУчреждениеПродавец)),
	|	(Договор В(&ДлительныеДоговорыУчреждениеПокупатель))
	|ИМЕЮЩИЕ
	|	СУММА(Дебет) <> 0
	|	ИЛИ СУММА(Кредит) <> 0
	|;		
	|
	|///////////////////////////////////////////////////////////////////////////////
	|// [2]. Остатки на начало периода по длительным договорам (подготовка)
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организация											КАК Организация,
	|	ВЫБОР
	|		КОГДА &ДетализироватьОстаткиПоДоговорам ТОГДА
	|			Субконто1
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ												КАК Договор,
	|	ВЫБОР
	|		// Исключаем остатки по всем счетам аренды, если сверка по аренде отключена
	|		КОГДА НЕ &УчитыватьНачисленияДлительныеДоговорыПродавец И Субконто1 В(&ДлительныеДоговорыУчреждениеПродавец) И Счет В(&Счета40140) ТОГДА
	|			0
	|		КОГДА НЕ &УчитыватьНачисленияДлительныеДоговорыПродавец И Субконто1 В(&ДлительныеДоговорыУчреждениеПродавец) И Счет В(&Счета40150) ТОГДА
	|			0
	|		КОГДА НЕ &УчитыватьНачисленияДлительныеДоговорыПокупатель И Субконто1 В(&ДлительныеДоговорыУчреждениеПокупатель) И Счет В(&Счета30220) ТОГДА
	|			0
	|		КОГДА НЕ &УчитыватьНачисленияДлительныеДоговорыПокупатель И Субконто1 В(&ДлительныеДоговорыУчреждениеПокупатель) И Счет В(&Счета11140) ТОГДА
	|			0
	|		КОГДА НЕ &УчитыватьНачисленияДлительныеДоговорыПокупатель И Субконто1 В(&ДлительныеДоговорыУчреждениеПокупатель) И Счет В(&Счета10440) ТОГДА
	|			0
	|		КОГДА НЕ &УчитыватьНачисленияДлительныеДоговорыПокупатель И Субконто1 В(&ДлительныеДоговорыУчреждениеПокупатель) И Счет В(&Счета40140) ТОГДА
	|			0
	|		КОГДА НЕ &УчитыватьНачисленияДлительныеДоговорыПокупатель И Субконто1 В(&ДлительныеДоговорыУчреждениеПокупатель) И Счет В(&Счета40160) ТОГДА
	|			0
	|		ИНАЧЕ
	|			СуммаОстаток
	|	КОНЕЦ												КАК ОстатокНаНачало
	|ПОМЕСТИТЬ
	|	ВсеОстаткиПоДлительнымДоговорам
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ДатаНачалаОстатки,					// 1
	|		Счет В(&АнализируемыеСчетаОстатки),	// 2.Счет
	|		&ВидСубконтоДоговоры,				// 3.Субконто
	|		// 4.Условие
	|		// (одинаковые для отбора оборотов, остатков
	|		//  КРОМЕ отбора по
	|		//    валюте		- здесь нет такого отбора
	|		//    контрагенту	- здесь заменен отбором по договору
	|		//    по договору	- здесь всегда отбор)
	|		//
	|		// Отбор по договору
	|		Субконто1 В(&ВсеДлительныеДоговоры)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоОрганизации ТОГДА
	|				Организация = &Организация
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоПодразделению ТОГДА
	|				Подразделение = &Подразделение
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО = &КФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|	)	КАК Остатки
	|;
	|
	|///////////////////////////////////////////////////////////////////////////////
	|// [3]. Остатки на начало периода по длительным договорам
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ
	|	Организация				КАК Организация,
	|	Договор					КАК Договор,
	|	СУММА(ОстатокНаНачало)	КАК ОстатокНаНачало
	|ИЗ
	|	ВсеОстаткиПоДлительнымДоговорам
	|СГРУППИРОВАТЬ ПО
	|	Организация,
	|	Договор
	|ИМЕЮЩИЕ
	|	СУММА(ОстатокНаНачало) <> 0
	|;";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	// [1]. Все обороты услуг аренды
	Обороты = РезультатыЗапроса[1].Выгрузить();
	
	// [3]. Остатки на начало периода по договорам аренды
	ОстаткиНаНачало = РезультатыЗапроса[3].Выгрузить();
	
	РезультатыСверки = Новый Структура();
	РезультатыСверки.Вставить("Обороты",			Обороты);
	РезультатыСверки.Вставить("ОстаткиНаНачало",	ОстаткиНаНачало);
	
	Возврат РезультатыСверки;
	
КонецФункции

Функция ПолучитьДатуНачалаОбороты(ДокументОбъект)
	
	Возврат ?(ЗначениеЗаполнено(ДокументОбъект["ДатаНачала"]),
		Новый Граница (НачалоДня(ДокументОбъект["ДатаНачала"]), ВидГраницы.Включая),
		Неопределено);
		
КонецФункции

Функция ПолучитьДатуНачалаОстатки(ДокументОбъект)
	
	Возврат ?(ЗначениеЗаполнено(ДокументОбъект["ДатаНачала"]),
		Новый Граница (НачалоДня(ДокументОбъект["ДатаНачала"]), ВидГраницы.Исключая),
		Неопределено);
		
КонецФункции

Функция ПолучитьДатуОкончанияОбороты(ДокументОбъект)
	Если ТипЗнч(ДокументОбъект["ДатаОкончания"]) = Тип("Граница") Тогда
		Возврат ДокументОбъект["ДатаОкончания"];
	КонецЕсли;	
	
	Возврат ?(ЗначениеЗаполнено(ДокументОбъект["ДатаОкончания"]),
		Новый Граница (КонецДня(ДокументОбъект["ДатаОкончания"]), ВидГраницы.Включая),
		Неопределено);
		
КонецФункции

Функция ПолучитьДатуОкончанияОстатки(ДокументОбъект)
	
	Возврат ПолучитьДатуОкончанияОбороты(ДокументОбъект);
		
КонецФункции

Функция ПолучитьДанныеПервичногоДокумента(ДокументСсылка, ДополнительныеПараметры = Неопределено)
	
	// Возвращаемое значение
	Результат = Новый Структура("
		|ВидПервичногоДокумента,
		|ДатаПервичногоДокумента,
		|НомерПервичногоДокумента");
		
	ТипыПлатежныхДокументов = ПолучитьТипыПлатежныхДокументов();
	
	ЭтоПлатежныйДокумент = НЕ (ТипыПлатежныхДокументов.Найти(ТипЗнч(ДокументСсылка)) = Неопределено);
	
	Если ЭтоПлатежныйДокумент Тогда
		// Для платежных документов - выбираем первичный документ из регистра СостояниеПлатежноРасчетныхДокументов
		
		ЗапросПоиск = Новый Запрос();
		ЗапросПоиск.УстановитьПараметр("ДокСсылка", ДокументСсылка);
		ЗапросПоиск.Текст = "
		|ВЫБРАТЬ
		|	""""																КАК ВидПервичногоДокумента,
		|	СостояниеПлатежноРасчетныхДокументов.ДатаПодтверждающегоДокумента	КАК ДатаПервичногоДокумента,
		|	СостояниеПлатежноРасчетныхДокументов.НомерПодтверждающегоДокумента	КАК НомерПервичногоДокумента
		|ИЗ
		|	РегистрСведений.СостояниеПлатежноРасчетныхДокументов	КАК СостояниеПлатежноРасчетныхДокументов
		|ГДЕ
		|	СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент = &ДокСсылка
		|	И	СостояниеПлатежноРасчетныхДокументов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДокумента.Исполнен)
		|;";
		
		Выборка = ЗапросПоиск.Выполнить().Выбрать();
		
		// Результат состоит максимум из 1 строки
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Результат, Выборка);
			Прервать;
		КонецЦикла;
		
	Иначе
		// Для не платежных документов - выбираем первичный документ из бух.проводок
		
		Параметры = Новый Структура("Контрагент,Договор");
		Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(Параметры, ДополнительныеПараметры);
		КонецЕсли;
		Контрагент	= Параметры["Контрагент"];
		Договор		= Параметры["Договор"];
		
		ЗапросПоиск = Новый Запрос();
		ЗапросПоиск.УстановитьПараметр("ДокСсылка", 						ДокументСсылка);
		ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоКонтрагенту",	ЗначениеЗаполнено(Контрагент));
		ЗапросПоиск.УстановитьПараметр("Контрагент",						Контрагент);
		ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоДоговору",		ЗначениеЗаполнено(Договор));
		ЗапросПоиск.УстановитьПараметр("Договор",							Договор);
		ЗапросПоиск.Текст = "
		|///////////////////////////////////////////////////////////////////////////////
		|// [0]. Сведения обо всех первичных документах из движений
		|//
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВидПервичногоДокумента		КАК ВидПервичногоДокумента,
		|	ДатаПервичногоДокумента		КАК ДатаПервичногоДокумента,
		|	НомерПервичногоДокумента	КАК НомерПервичногоДокумента
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
		|		,							// 1
		|		,							// 2
		|		Регистратор = &ДокСсылка	// 3
		|		И ВЫБОР
		|			КОГДА &ИспользоватьОтборПоКонтрагенту ТОГДА
		|				ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Контрагенты) ТОГДА
		|						Субконто1 = &Контрагент
		|					КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Контрагенты) ТОГДА
		|						Субконто2 = &Контрагент
		|					КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Контрагенты) ТОГДА
		|						Субконто3 = &Контрагент
		|					ИНАЧЕ
		|						ЛОЖЬ
		|				КОНЕЦ
		|			ИНАЧЕ
		|				ИСТИНА
		|		КОНЕЦ
		|		И ВЫБОР
		|			КОГДА &ИспользоватьОтборПоДоговору ТОГДА
		|				ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Договоры) ТОГДА
		|						Субконто1 В ИЕРАРХИИ(&Договор)
		|					КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Договоры) ТОГДА
		|						Субконто2 В ИЕРАРХИИ(&Договор)
		|					КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Договоры) ТОГДА
		|						Субконто3 В ИЕРАРХИИ(&Договор)
		|					ИНАЧЕ
		|						ЛОЖЬ
		|				КОНЕЦ
		|			ИНАЧЕ
		|				ИСТИНА
		|		КОНЕЦ,
		|		Регистратор					// 4
		|		) КАК ДвиженияССубконто
		|;";
		
		Выборка = ЗапросПоиск.Выполнить().Выбрать();
		
		// Выбираем первичный документ, только если он оказался единственным.
		// Если их несколько, то ничего не заполняем.
		Если Выборка.Количество() = 1 Тогда
			Пока Выборка.Следующий() Цикл
				ЗаполнитьЗначенияСвойств(Результат, Выборка);
				Прервать;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает массивы детальных договоров
// Именно детальные договоры, чтобы исключить в запросах конструкцию В ИЕРАРХИИ ради ускорения работы
Функция ПолучитьДоговорыСКонтрагентом(ШапкаДокумента)
	
	ИспользоватьОтборПоДоговору = ЗначениеЗаполнено(ШапкаДокумента["Договор"]);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Контрагент",					ШапкаДокумента["Контрагент"]);
	ЗапросПоиск.УстановитьПараметр("Договор",						ШапкаДокумента["Договор"]);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоДоговору",	ИспользоватьОтборПоДоговору);
	ЗапросПоиск.Текст = "
	|///////////////////////////////////////////////////////////////////////////////
	|// [0]. Все договоры с указанным контрагентом
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	Справочник.Договоры
	|ГДЕ
	|	ВЫБОР
	|		КОГДА &ИспользоватьОтборПоДоговору ТОГДА
	|			// Отбор по договору
	|			Ссылка В ИЕРАРХИИ(&Договор)
	|		ИНАЧЕ
	|			// Отбор по контрагенту
	|			Контрагент В(&Контрагент)
	|	КОНЕЦ
	|;";
	
	ВсеДоговоры = ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ПараметрыОтбора = Документы.АктСверкиВзаиморасчетов.ПолучитьПараметрыОтбораДлительныхДоговоров(
		ШапкаДокумента,
		"АктСверкиВзаиморасчетов",
		ПолучитьДатуОкончанияОбороты(ШапкаДокумента));
		
	ДлительныеДоговоры = ПолучитьДлительныеДоговорыСКонтрагентом(ПараметрыОтбора);
	
	Договоры = Новый Структура();
	Договоры.Вставить("ВсеДоговоры",		ВсеДоговоры);
	Договоры.Вставить("ДлительныеДоговоры",	ДлительныеДоговоры);
	
	Возврат Договоры;
	
КонецФункции

Функция ПолучитьСчетаСтандартнойСверки(ШапкаДокумента, СписокОтмеченныхСчетов)
	
	// Подготовка
	ВидыСубконтоКонтрагенты = Новый Массив();
	ВидыСубконтоКонтрагенты.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	ВидыСубконтоКонтрагенты.Добавить(ПланыВидовХарактеристик.ВидыСубконто.КорреспондентыПоВнутреннимРасчетам);
	
	ТребоватьНаличиеВидаСубконтоДоговоры = (ЗначениеЗаполнено(ШапкаДокумента["Договор"]));
	
	ТребоватьНаличиеУчетаПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
											И (ЗначениеЗаполнено(ШапкаДокумента["Подразделение"]));
	
	НаДату = ПолучитьДатуОкончанияОстатки(ШапкаДокумента);
	
	// Настраиваем запрос
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокСчетов",							СписокОтмеченныхСчетов);
	ЗапросПоиск.УстановитьПараметр("ВидСубконтоДоговоры",					ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	ЗапросПоиск.УстановитьПараметр("ВидыСубконтоКонтрагенты",				ВидыСубконтоКонтрагенты);
	ЗапросПоиск.УстановитьПараметр("ТребоватьНаличиеВидаСубконтоДоговоры",	ТребоватьНаличиеВидаСубконтоДоговоры);
	ЗапросПоиск.УстановитьПараметр("ТребоватьНаличиеУчетаПоПодразделениям",	ТребоватьНаличиеУчетаПоПодразделениям);
	ЗапросПоиск.Текст = "
	|///////////////////////////////////////////////////////////////////////////////
	|// [0]. Свойства каждого счета из указанного списка
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка						КАК Счет,
	|	Ссылка.Код					КАК Код,
	|	Ссылка.УчетПоПодразделениям	КАК УчетПоПодразделениям,
	|	СУММА(ВЫБОР
	|		КОГДА ВидСубконто В (&ВидыСубконтоКонтрагенты) ТОГДА
	|			1
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)						КАК КоличествоВидовСубконтоКонтрагенты,
	|	СУММА(ВЫБОР
	|		КОГДА ВидСубконто В (&ВидСубконтоДоговоры) ТОГДА
	|			1
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)						КАК КоличествоВидовСубконтоДоговоры
	|ПОМЕСТИТЬ
	|	СвойстваСчетов
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто
	|ГДЕ
	|	Ссылка В ИЕРАРХИИ (&СписокСчетов)
	|СГРУППИРОВАТЬ ПО
	|	Ссылка
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|///////////////////////////////////////////////////////////////////////////////
	|// [1]. Анализируемые счета
	|//		(Подготовка)
	|//
	|ВЫБРАТЬ
	|	Счет	КАК Счет
	|ПОМЕСТИТЬ
	|	АнализируемыеСчета
	|ИЗ
	|	СвойстваСчетов
	|ГДЕ
	|	КоличествоВидовСубконтоКонтрагенты > 0
	|	И ВЫБОР
	|		КОГДА &ТребоватьНаличиеВидаСубконтоДоговоры И КоличествоВидовСубконтоДоговоры = 0 ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ТребоватьНаличиеУчетаПоПодразделениям И НЕ УчетПоПодразделениям ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет
	|;
	|
	|///////////////////////////////////////////////////////////////////////////////
	|// [2]. Анализируемые счета
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ
	|	Счет	КАК Счет
	|ИЗ
	|	АнализируемыеСчета
	|;
	|
	|///////////////////////////////////////////////////////////////////////////////
	|// [3]. Неанализируемые (исключаемые) счета
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ
	|	Код	КАК КодСчета
	|ИЗ
	|	СвойстваСчетов
	|ГДЕ
	|	НЕ Счет В(ВЫБРАТЬ	Счет	ИЗ	АнализируемыеСчета)
	|УПОРЯДОЧИТЬ ПО
	|	КодСчета
	|;";
	
	РезультатыПоиска = ЗапросПоиск.ВыполнитьПакет();
	
	// [2]. Анализируемые счета
	АнализируемыеСчета = РезультатыПоиска[2].Выгрузить().ВыгрузитьКолонку("Счет");
	
	// [3]. Неанализируемые (исключаемые) счета
	КодыИсключаемыхСчетов = РезультатыПоиска[3].Выгрузить().ВыгрузитьКолонку("КодСчета");
	
	Результат = Новый Структура();
	Результат.Вставить("АнализируемыеСчета",				АнализируемыеСчета);
	Результат.Вставить("КодыИсключаемыхСчетов",				КодыИсключаемыхСчетов);
	Результат.Вставить("СчетаИсправленияОшибокПрошлыхЛет",	БухгалтерскийУчет.СписокСчетов("304.66,304.76,304.86,304.96"));
	Результат.Вставить("СчетаДЗ",							БухгалтерскийУчет.СписокСчетов("04"));
	Результат.Вставить("СчетаКЗ",							БухгалтерскийУчет.СписокСчетов("20"));
	Результат.Вставить("Счета40160",						БухгалтерскийУчет.СписокСчетов("401.60"));
	Результат.Вставить("Счета40130",						БухгалтерскийУчет.СписокСчетов("401.30"));
	Результат.Вставить("Счета20900",						БухгалтерскийУчет.СписокСчетов("209.00", НаДату));
	Результат.Вставить("СчетаРазвернутыхОборотов",			БухгалтерскийУчет.СписокСчетов("304.04", НаДату));
	
	Возврат Результат;
	
КонецФункции

Функция СгруппироватьСчета(ВыборкаГруппыСчетов, ТаблицаСчетаДлительныеДоговоры)
	
	Счета = Новый Структура();
	
	Пока ВыборкаГруппыСчетов.Следующий() Цикл
		
		ОбозначениеГруппы = ВыборкаГруппыСчетов["ОбозначениеГруппы"];
		
		МассивСчетов = Новый Массив();
		
		Выборка = ВыборкаГруппыСчетов.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			МассивСчетов.Добавить(Выборка["Счет"]);
		КонецЦикла;
		
		Счета.Вставить(ОбозначениеГруппы, МассивСчетов);
		
	КонецЦикла;
	
	ВремТаблица = ТаблицаСчетаДлительныеДоговоры.Скопировать(, "ОбозначениеГруппы");
	ВремТаблица.Свернуть("ОбозначениеГруппы");
	ВсеОбозначенияГрупп = ВремТаблица.ВыгрузитьКолонку("ОбозначениеГруппы");
	
	Для Каждого ОбозначениеГруппы Из ВсеОбозначенияГрупп Цикл
		Если Счета.Свойство(ОбозначениеГруппы) Тогда
			Продолжить;
		КонецЕсли;
		
		Счета.Вставить(ОбозначениеГруппы, Новый Массив());
	КонецЦикла;
	
	Возврат Счета;
	
КонецФункции

Процедура ПроверитьНаличиеСчетов(АнализируемыеСчета, СписокПроблем, ТребоватьНаличиеУчетаПоПодразделениям);
	
	ОжидаемыеОбозначенияГрупп = Новый Массив();
	ОжидаемыеОбозначенияГрупп.Добавить("Счета10440");
	ОжидаемыеОбозначенияГрупп.Добавить("Счета11140");
	ОжидаемыеОбозначенияГрупп.Добавить("Счета20500");
	ОжидаемыеОбозначенияГрупп.Добавить("Счета21005");
	ОжидаемыеОбозначенияГрупп.Добавить("Счета30220");
	ОжидаемыеОбозначенияГрупп.Добавить("Счета40140");
	ОжидаемыеОбозначенияГрупп.Добавить("Счета40150");
	
	Для Каждого ОбозначениеГруппы Из ОжидаемыеОбозначенияГрупп Цикл
		Если НЕ АнализируемыеСчета.Свойство(ОбозначениеГруппы) Тогда
			АнализируемыеСчета.Вставить(ОбозначениеГруппы, Новый Массив());
		КонецЕсли;
	КонецЦикла;
	
	НастройкиСчетовПродавцаКорректны = (
		АнализируемыеСчета["Счета20500"].Количество() > 0
		И АнализируемыеСчета["Счета40140"].Количество() > 0
		И АнализируемыеСчета["Счета40150"].Количество() > 0);
	
	НастройкиСчетовПокупателяКорректны = (
		АнализируемыеСчета["Счета10440"].Количество() > 0
		И АнализируемыеСчета["Счета11140"].Количество() > 0
		И АнализируемыеСчета["Счета30220"].Количество() > 0
		И АнализируемыеСчета["Счета40140"].Количество() > 0);
	
	Если ТребоватьНаличиеУчетаПоПодразделениям Тогда
		ТекстОжидаемыеНастройки = НСтр("ru='субконто Договоры и ведением учета по подразделениям'");
	Иначе
		ТекстОжидаемыеНастройки = НСтр("ru='субконто Договоры'");
	КонецЕсли;
	
	Если НЕ НастройкиСчетовПродавцаКорректны Тогда
		ТекстШаблон = НСтр("ru='В плане счетов отсутствуют счета с %1 в одной или нескольких группах: 205.20, 401.40, 401.50'");
		
		СписокПроблем.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстШаблон, ТекстОжидаемыеНастройки));
	КонецЕсли;
	
	Если НЕ НастройкиСчетовПокупателяКорректны Тогда
		ТекстШаблон = НСтр("ru='В плане счетов отсутствуют счета с %1 в одной или нескольких группах: 104.40, 111.40, 302.20, 401.40'");
		
		СписокПроблем.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстШаблон, ТекстОжидаемыеНастройки));
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьМассив(МассивПриемник, СтруктураИсточник, ИмяСвойства = Неопределено)
	
	Перем МассивИсточник;
	
	Если ИмяСвойства = Неопределено Тогда
		МассивИсточник = СтруктураИсточник;
	ИначеЕсли НЕ СтруктураИсточник.Свойство(ИмяСвойства, МассивИсточник) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Счет Из МассивИсточник Цикл
		МассивПриемник.Добавить(Счет);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСтрокиСНулевымиНачальнымиОстатками(ДокументОбъект)
	
	// Используется для того, чтобы в таблице остатков
	// были автоматически рассчитаны Конечные остатки и расхождения
	// для строк с нулевым Начальным остатком.
	
	Поиск = Новый Структура();
	
	Если ИспользуетсяКолонкаОрганизация(ДокументОбъект) Тогда
		Поиск.Вставить("Организация");
	КонецЕсли;
	
	Если ИспользуетсяКолонкаДоговор(ДокументОбъект) Тогда
		Поиск.Вставить("Договор");
	КонецЕсли;
	
	ПрерватьДобавлениеСтрок = (Поиск.Количество() = 0 ИЛИ ДокументОбъект["ПоДаннымОрганизации"].Количество() = 0);
	
	Если ПрерватьДобавлениеСтрок Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект["ПоДаннымОрганизации"] Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		
		ОтсутствуетСтрокаОстатка = (ДокументОбъект["СписокОрганизаций"].НайтиСтроки(Поиск).Количество() = 0);
		
		Если ОтсутствуетСтрокаОстатка Тогда
			НоваяСтрока = ДокументОбъект["СписокОрганизаций"].Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Поиск);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект["ПоДаннымКонтрагента"] Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		
		ОтсутствуетСтрокаОстатка = (ДокументОбъект["СписокОрганизаций"].НайтиСтроки(Поиск).Количество() = 0);
		
		Если ОтсутствуетСтрокаОстатка Тогда
			НоваяСтрока = ДокументОбъект["СписокОрганизаций"].Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Поиск);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьСтрокиОтличающихсяОрганизацийВТабличнойЧасти(ДокументОбъект, ИмяТабличнойЧасти)
	
	ОрганизацияИзШапки = ДокументОбъект["Организация"];
	
	ТабличнаяЧасть = ДокументОбъект[ИмяТабличнойЧасти];
	
	КоличествоСтрок = ТабличнаяЧасть.Количество();
	Для Счетчик = 1 По КоличествоСтрок Цикл
		Индекс = КоличествоСтрок - Счетчик;
		СтрокаТЧ = ТабличнаяЧасть[Индекс];
		Если НЕ СтрокаТЧ["Организация"] = ОрганизацияИзШапки Тогда
			ТабличнаяЧасть.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиСообщения(Выборка = Неопределено, ПараметрыВывода)
	
	Если НЕ ПараметрыВывода.Свойство("ВставляемыеЗначения") Тогда
		ПараметрыВывода.Вставить("ВставляемыеЗначения", Новый Структура());
	КонецЕсли;
	
	Если НЕ ПараметрыВывода["ВставляемыеЗначения"].Свойство("НомерСтроки") Тогда
		ПараметрыВывода["ВставляемыеЗначения"].Вставить("НомерСтроки");
	КонецЕсли;
	
	Если Выборка = Неопределено Тогда
		НомерСтроки = ПараметрыВывода["НомерСтроки"];
		
		ПараметрыВывода["ВставляемыеЗначения"].Вставить("НомерСтроки", НомерСтроки);
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
			ПараметрыВывода["ТекстШаблон"],
			ПараметрыВывода["ВставляемыеЗначения"]);
			
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			ПараметрыВывода["Ссылка"],
			"Объект." + ПараметрыВывода["ИмяТаблЧастиДляВыводаСообщений"] + "[" + Формат(НомерСтроки-1, "ЧГ=0")+ "]." + ПараметрыВывода["ИмяПоляДляВыводаСообщений"]);
	Иначе
		Пока Выборка.Следующий() Цикл
			НомерСтроки = Выборка["НомерСтроки"];
			
			ЗаполнитьЗначенияСвойств(ПараметрыВывода["ВставляемыеЗначения"], Выборка);
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
				ПараметрыВывода["ТекстШаблон"],
				ПараметрыВывода["ВставляемыеЗначения"]);
				
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ПараметрыВывода["Ссылка"],
				"Объект." + ПараметрыВывода["ИмяТаблЧастиДляВыводаСообщений"] + "[" + Формат(НомерСтроки-1, "ЧГ=0")+ "]." + ПараметрыВывода["ИмяПоляДляВыводаСообщений"]);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПредставленияДокументов(Таблица, ПараметрыПроцедуры, ПараметрыЗаполнения)
	
	РеквизитыПервичногоДокумента = Новый Структура("
		|ВидПервичногоДокумента,
		|ДатаПервичногоДокумента,
		|НомерПервичногоДокумента");
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("РеквизитыПервичногоДокумента",	РеквизитыПервичногоДокумента);
	ДополнительныеПараметры.Вставить("ДлительныеДоговоры",				ПараметрыЗаполнения["ДоговорыСКонтрагентом"]["ДлительныеДоговоры"]);
	
	ИнициализироватьДополнительныеПараметрыПредставлениеДокументаДлительныеДоговоры(ДополнительныеПараметры);
	
	ПараметрыПроцедуры.Вставить("ОшибкиНастроекПредставленияДокументаДлительныеДоговоры", ДополнительныеПараметры.ПредставлениеДокументаНастройкиСКД.Ошибки);
	
	СтруктураШапки = ПолучитьСтруктуруШапкиДляОпределенияПредставленияДокумента();
	
	ЗаполнитьЗначенияСвойств(СтруктураШапки, ПараметрыПроцедуры);
	
	Таблица.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	
	Если ПараметрыПроцедуры.ШапкаДокумента.ЭтоЭлектронныйДокумент Тогда
		Таблица.Колонки.Добавить("НомерДокумента", Новый ОписаниеТипов("Строка"));
		Таблица.Колонки.Добавить("ДатаДокумента", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
		Таблица.Колонки.Добавить("НаименованиеДокумента", Новый ОписаниеТипов("Строка"));
		Таблица.Колонки.Добавить("НаименованиеОперации", Новый ОписаниеТипов("Строка"));
		Таблица.Колонки.Добавить("ДатаВходящегоДокумента", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ЗаполнитьЗначенияСвойств(РеквизитыПервичногоДокумента, СтрокаТаблицы);
		
		ПредставлениеДокумента = ПолучитьПредставлениеДокумента(
			СтрокаТаблицы,
			СтруктураШапки,
			ДополнительныеПараметры);
			
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ПредставлениеДокумента, "Представление,Дата");
		
		Если ПараметрыПроцедуры.ШапкаДокумента.ЭтоЭлектронныйДокумент Тогда
			
			// Номер
			НомерДокумента = СтрокаТаблицы.НомерПервичногоДокумента;
			
			Если Не ЗначениеЗаполнено(НомерДокумента) Тогда
				НомерДокумента = ПредставлениеДокумента.Номер;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(НомерДокумента) Тогда
				НомерДокумента = НСтр("ru='б/н'");
			КонецЕсли;
			
			// Дата
			ДатаДокумента = СтрокаТаблицы.ДатаПервичногоДокумента;
			
			Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
				ДатаДокумента = ПредставлениеДокумента.Дата;
			КонецЕсли;
			
			// Наименование
			НаименованиеДокумента = Строка(СтрокаТаблицы.ВидДокумента);
			
			Если Не ЗначениеЗаполнено(НаименованиеДокумента) Тогда
				НаименованиеДокумента = Строка(ТипЗнч(СтрокаТаблицы.Документ));
			КонецЕсли;
			
			СтрокаТаблицы.НомерДокумента			= НомерДокумента;
			СтрокаТаблицы.ДатаДокумента				= ДатаДокумента;
			СтрокаТаблицы.ДатаВходящегоДокумента	= ДатаДокумента;
			СтрокаТаблицы.НаименованиеДокумента		= НаименованиеДокумента;
			
			СтрокаТаблицы.НаименованиеОперации = ПредставлениеХозяйственнойОперации(СтрокаТаблицы.Документ, СтрокаТаблицы.Дебет, СтрокаТаблицы.Кредит);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТипыПлатежныхДокументов()
	
	ТипыПлатежныхДокументов = Новый Массив();
	ТипыПлатежныхДокументов.Добавить(Тип("ДокументСсылка.ЗаявкаНаВозврат"));
	ТипыПлатежныхДокументов.Добавить(Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход"));
	ТипыПлатежныхДокументов.Добавить(Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная"));
	ТипыПлатежныхДокументов.Добавить(Тип("ДокументСсылка.ПлатежноеПоручение"));
	
	Возврат ТипыПлатежныхДокументов;
	
КонецФункции

Функция ЭтоДокументНачисленияПоДолгосрочномуДоговору(ДокументСсылка)
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	
	Возврат (ТипДокумента = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов")
			ИЛИ ТипДокумента = Тип("ДокументСсылка.НачислениеАмортизацииПравПользованияОС"));
	
КонецФункции

Процедура ЗаполнитьДатыУчетныхДокументовВТаблице(ЗаполняемаяТаблица, ДатыУчетныхДокументов)
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаТаблицы Из ЗаполняемаяТаблица Цикл
		Поиск.Вставить("Ссылка", СтрокаТаблицы.Документ);
		
		МассивСтрок = ДатыУчетныхДокументов.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			СтрокаТаблицы["ДатаУчетногоДокумента"] = МассивСтрок[0].Дата;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКолонкуОтветственныйВТаблице(Таблица)
	
	Если ТипЗнч(Таблица) = Тип("ТаблицаЗначений") Тогда
		Таблица.Колонки.Добавить("Ответственный", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
		
		МассивСсылок = Таблица.ВыгрузитьКолонку("Документ");
		
	ИначеЕсли ТипЗнч(Таблица) = Тип("ДанныеФормыКоллекция") Тогда
		МассивСсылок = Таблица.Выгрузить(, "Документ").ВыгрузитьКолонку("Документ");
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ОтветственныеДокументов = ПолучитьОтветственныхДокументов(МассивСсылок);
	
	Если ОтветственныеДокументов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Поиск = Новый Структура("Ссылка");
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Поиск.Ссылка = СтрокаТаблицы.Документ;
		
		МассивСтрок = ОтветственныеДокументов.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			СтрокаТаблицы.Ответственный = МассивСтрок[0].Ответственный;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДатыУчетныхДокументов(МассивСсылок)
	
	ТипыВидыДокументов = ПолучитьТипыВидыДокументов(МассивСсылок);
	
	Если ТипыВидыДокументов.ВидыДокументов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивСсылок);
	ЗапросПоиск.Текст = СоставитьТекстЗапросаРеквизитовПоВидамДокументов(ТипыВидыДокументов.ВидыДокументов, "Дата");
	
	УстановитьПривилегированныйРежим(Истина);
	Таблица = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Таблица.Индексы.Добавить("Ссылка");
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьОтветственныхДокументов(МассивСсылок)
	
	ТипыВидыДокументов = ПолучитьТипыВидыДокументов(МассивСсылок);
	
	Если ТипыВидыДокументов.ВидыДокументов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивСсылок);
	ЗапросПоиск.Текст = СоставитьТекстЗапросаРеквизитовПоВидамДокументов(ТипыВидыДокументов.ВидыДокументов, "Ответственный");
	
	УстановитьПривилегированныйРежим(Истина);
	Таблица = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Таблица.Индексы.Добавить("Ссылка");
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьТипыВидыДокументов(МассивСсылок)
	
	ТипыДокументов = Новый Массив();
	
	ВидыДокументов = Новый Массив();
	
	Для Каждого Ссылка Из МассивСсылок Цикл
		ТипДокумента = ТипЗнч(Ссылка);
		
		Если ЗначениеЗаполнено(Ссылка) И ТипыДокументов.Найти(ТипДокумента) = Неопределено Тогда
			ТипыДокументов.Добавить(ТипДокумента);
			
			ВидыДокументов.Добавить(Метаданные.НайтиПоТипу(ТипДокумента).Имя);
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("ТипыДокументов", ТипыДокументов);
	Результат.Вставить("ВидыДокументов", ВидыДокументов);
	
	Возврат Результат;
	
КонецФункции

Функция СоставитьТекстЗапросаРеквизитовПоВидамДокументов(ВидыДокументов, ИменаРеквизитов)
	
	ТекстыЗапросов = Новый Массив();
	
	ТекстШаблон = "
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка,
	|	%1
	|ИЗ
	|	Документ.%2
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|";
	
	// Тексты выбора реквизитов
	
	МассивИменаРеквизитов = СтрРазделить(ИменаРеквизитов, ", ", Ложь);
	
	Для Каждого ВидДокумента Из ВидыДокументов Цикл
		МетаданныеРеквизитов			= Метаданные.Документы[ВидДокумента].Реквизиты;
		МетаданныеСтандартныхРеквизитов	= Метаданные.Документы[ВидДокумента].СтандартныеРеквизиты;
		
		МассивТекстов = Новый Массив();
		
		Для Индекс = 0 По МассивИменаРеквизитов.ВГраница() Цикл
			ИмяРеквизита = МассивИменаРеквизитов[Индекс];
			
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(МетаданныеРеквизитов, ИмяРеквизита)
				Или ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(МетаданныеСтандартныхРеквизитов, ИмяРеквизита) Тогда
				ВыбираемоеЗначение = ИмяРеквизита;
			Иначе
				ВыбираемоеЗначение = "НЕОПРЕДЕЛЕНО";
			КонецЕсли;
			
			МассивТекстов.Добавить(СтрШаблон("%1	КАК %2", ВыбираемоеЗначение, ИмяРеквизита));
		КонецЦикла;
		
		ТекстВыборРеквизитов = СтрСоединить(МассивТекстов, ",
		|	");
		
		ТекстыЗапросов.Добавить(СтрШаблон(ТекстШаблон, ТекстВыборРеквизитов, ВидДокумента));
	КонецЦикла;
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, "
	|ОБЪЕДИНИТЬ ВСЕ
	|");
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ЗаполнитьПараметрыДат(ВыборкаШапка, ВыборкаТаблица, ЗначенияПараметров, ВычисляемыеПараметры, ПостфиксИмен = "")
	
	ЗначенияПараметров["ДатаПервичногоДокумента" + ПостфиксИмен] = ЗначенияПараметров["Дата" + ПостфиксИмен];
	
	ЗначенияПараметров["ДатаУчетногоДокумента" + ПостфиксИмен] = НайтиДатуУчетногоДокумента(
		ЗначенияПараметров["Документ" + ПостфиксИмен],
		ВычисляемыеПараметры);
			
	Если ВычисляемыеПараметры["ВыводитьДатуУчетногоДокумента"] Тогда
		ЗначенияПараметров["Дата" + ПостфиксИмен] = ЗначенияПараметров["ДатаУчетногоДокумента" + ПостфиксИмен];
		
	ИначеЕсли ВыборкаШапка.ЭтоЭлектронныйДокумент Тогда
		ЗначенияПараметров["Дата" + ПостфиксИмен] = ВыборкаТаблица["ДатаДокумента" + ПостфиксИмен];
		
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиДатуУчетногоДокумента(ДокументСсылка, ВычисляемыеПараметры)
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) ИЛИ ВычисляемыеПараметры["ДатыУчетныхДокументов"] = Неопределено Тогда
		Возврат '00010101';
	КонецЕсли;
	
	ВычисляемыеПараметры["Поиск"].Вставить("Ссылка", ДокументСсылка);
	
	МассивСтрок = ВычисляемыеПараметры["ДатыУчетныхДокументов"].НайтиСтроки(ВычисляемыеПараметры["Поиск"]);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Возврат МассивСтрок[0].Дата;
	КонецЕсли;
	
	Возврат '00010101';
	
КонецФункции

Процедура УдалитьСтрокиСНулевымиСуммами(ТаблицаОборотов)
	
	Поиск = Новый Структура("Дебет,Кредит", 0, 0);
	
	МассивСтрок = ТаблицаОборотов.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ТаблицаОборотов.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

Процедура СвернутьОбороты(ТаблицаОборотов, ПараметрыПроцедуры)
	
	СворачиватьОбороты = ПараметрыПроцедуры.ШапкаДокумента.СворачиватьОбороты;
	
	Для Каждого СтрокаТаблицы Из ТаблицаОборотов Цикл
		Если СтрокаТаблицы.ЭтоСчетРазвернутыхОборотов = Истина И Не СворачиватьОбороты Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.Дебет <> 0 И СтрокаТаблицы.Кредит <> 0 Тогда
			Если СтрокаТаблицы.Дебет >= СтрокаТаблицы.Кредит Тогда
				СтрокаТаблицы.Дебет = СтрокаТаблицы.Дебет - СтрокаТаблицы.Кредит;
				СтрокаТаблицы.Кредит = 0;
			Иначе
				СтрокаТаблицы.Кредит = СтрокаТаблицы.Кредит - СтрокаТаблицы.Дебет;
				СтрокаТаблицы.Дебет = 0;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Полный состав колонок см. ВыполнитьСтандартнуюСверку, подзапрос [6]. Обороты и реквизиты первичных документов
	КолонкиГруппировок = "Организация,Дата,Документ,ВидДокумента,ВидПервичногоДокумента,"
		+ "ДатаПервичногоДокумента,НомерПервичногоДокумента,Договор";
	
	КолонкиСуммирования = "Дебет,Кредит";
	
	ТаблицаОборотов.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	
КонецПроцедуры

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ПодготовитьДанныеДляЗаполненияЭДО", Истина);
	Методы.Вставить("ПолучитьДанныеБухУчета", Истина);
КонецПроцедуры

#КонецОбласти

#КонецЕсли
