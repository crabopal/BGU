#Область ЗаполнениеДокумента

Процедура ИзменитьСуммыНаПроцент(ДокументОбъект) Экспорт
	
	КоэффициентИндексации = Окр(ДокументОбъект.ПроцентИндексации / 100, 4);
	
	// Индексируем платежи по графику оплаты за периоды обучения, которые еще не завершились,
	// либо в соответствии с отбором по периоду обучения.
	СуммаКорректировкиДБП = 0;
	Для Каждого СтрокаГрафика Из ДокументОбъект.ПорядокОплаты Цикл
		
		ПараметрыПересчетаПериода = РаботаСоСтудентами.ПараметрыПересчетаПериодаОбучения(СтрокаГрафика, ДокументОбъект);
		
		СтрокаГрафика.СуммаВВалюте = // Сумма "до изменения", скорректированная на коэффициенты индексации и неполного периода.
			СтрокаГрафика.СуммаВВалютеДоИзменений * КоэффициентИндексации * ПараметрыПересчетаПериода.ДоляПериода;
			
		СтрокаГрафика.СуммаВВалютеПослеИзменений =
			СтрокаГрафика.СуммаВВалютеДоИзменений + СтрокаГрафика.СуммаВВалюте;
		
		// Увеличение (уменьшение) стоимости обучения непосредственно влияет на остатки ДБП по договору.
		СуммаКорректировкиДБП = СуммаКорректировкиДБП + СтрокаГрафика.СуммаВВалюте;
		
	КонецЦикла;
	
	// Остаток ДБП увеличиваем на сумму индексации.
	Для Каждого СтрокаДБП Из ДокументОбъект.ДоходыБудущихПериодов Цикл
		СтрокаДБП.Всего = СуммаКорректировкиДБП;
	КонецЦикла;
	
КонецПроцедуры

Процедура РаспределитьСуммуПоПериодам(ДокументОбъект) Экспорт
	
	// Опредеяем базу распределения по периодам обучения.
	ГрафикОплаты = ДокументОбъект.ПорядокОплаты.Выгрузить(,
		"НомерСтроки,НачалоПериода,КонецПериода,СуммаВВалютеДоИзменений,СуммаВВалюте");
	ГрафикОплаты.Колонки.Добавить("БазаРаспределения");
	Для Каждого СтрокаГрафика Из ГрафикОплаты Цикл
		
		ПараметрыПересчетаПериода = РаботаСоСтудентами.ПараметрыПересчетаПериодаОбучения(СтрокаГрафика, ДокументОбъект);
		
		СтрокаГрафика.БазаРаспределения = // Сумма "до изменения", скорректированная на коэффициент неполного периода.
			СтрокаГрафика.СуммаВВалютеДоИзменений * ПараметрыПересчетаПериода.ДоляПериода;
		
	КонецЦикла;
	
	// Распределяем сумму по периодам обучения.
	ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ДокументОбъект.СуммаРаспределенная,
		ГрафикОплаты, "СуммаВВалюте", "БазаРаспределения");
	
	Для Каждого СтрокаПорядокОплаты Из ДокументОбъект.ПорядокОплаты Цикл
		
		СтрокаГрафика = ГрафикОплаты.Найти(СтрокаПорядокОплаты.НомерСтроки, "НомерСтроки");
		СтрокаПорядокОплаты.СуммаВВалюте = ?(СтрокаГрафика <> Неопределено, СтрокаГрафика.СуммаВВалюте, 0);
		
		СтрокаПорядокОплаты.СуммаВВалютеПослеИзменений =
			СтрокаПорядокОплаты.СуммаВВалютеДоИзменений + СтрокаПорядокОплаты.СуммаВВалюте;
		
	КонецЦикла;
	
	// Остаток ДБП увеличиваем на сумму распределения.
	Для Каждого СтрокаДБП Из ДокументОбъект.ДоходыБудущихПериодов Цикл
		СтрокаДБП.Всего = ДокументОбъект.СуммаРаспределенная;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
