#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,Дата,ВидМежотчетногоПериода,ВидОперации,ИзменитьПорядокУчетаДоходов,СкорректироватьПорядокОплаты,СчетДоходовНУ");
	
	Если ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийКорректировкиДБП.ДосрочноеПрекрашение
		И НЕ ЗначенияРеквизитов.СкорректироватьПорядокОплаты Тогда
		Возврат;
	КонецЕсли;
	
	ДатаУчетнойПолитики = ?(ЗначениеЗаполнено(ЗначенияРеквизитов.ВидМежотчетногоПериода),
		КонецГода(ЗначенияРеквизитов.Дата) + 1, ЗначенияРеквизитов.Дата);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИзменитьПорядокУчетаДоходов", ЗначенияРеквизитов.ИзменитьПорядокУчетаДоходов);
	Запрос.УстановитьПараметр("ОтражатьВНалоговомУчете",
		НалоговыйУчет.ПлательщикНалогаНаПрибыль(ЗначенияРеквизитов.Организация, ДатаУчетнойПолитики)
		И НЕ ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование);
	Запрос.УстановитьПараметр("ЭтоПрочиеДоходы",
		БухгалтерскийУчет.СчетВИерархии(ЗначенияРеквизитов.СчетДоходовНУ, "Н91.01"));
	Запрос.УстановитьПараметр("ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ПараметрыСписанияДоходовБудущихПериодов", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Ссылка КАК Регистратор,
	|	КорректировкаДоходовБудущихПериодов.Дата КАК Период,
	|	КорректировкаДоходовБудущихПериодов.Договор КАК Договор,
	|	КорректировкаДоходовБудущихПериодов.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНачисленияДБП.ДолгосрочныйДоговорОбразование) КАК ВидОперации,
	|	КорректировкаДоходовБудущихПериодов.СпособПризнанияДоходов КАК СпособПризнанияДоходов,
	|	КорректировкаДоходовБудущихПериодов.ДатаНачалаСписания КАК ДатаНачалаСписания,
	|	КорректировкаДоходовБудущихПериодов.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
	|	КорректировкаДоходовБудущихПериодов.СчетДоходов КАК СчетДоходов,
	|	КорректировкаДоходовБудущихПериодов.СубконтоДоходов1 КАК СубконтоДоходов1,
	|	КорректировкаДоходовБудущихПериодов.СубконтоДоходов2 КАК СубконтоДоходов2,
	|	КорректировкаДоходовБудущихПериодов.СубконтоДоходов3 КАК СубконтоДоходов3,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|			ТОГДА КорректировкаДоходовБудущихПериодов.ВидДеятельностиНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ПустаяСсылка)
	|	КОНЕЦ КАК ВидДеятельностиНУ,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|			ТОГДА КорректировкаДоходовБудущихПериодов.СчетДоходовНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	КОНЕЦ КАК СчетДоходовНУ,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|				И &ЭтоПрочиеДоходы
	|			ТОГДА КорректировкаДоходовБудущихПериодов.СтатьяПрочихДоходовНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|	КОНЕЦ КАК СтатьяПрочихДоходовНУ
	|ИЗ
	|	Документ.КорректировкаДоходовБудущихПериодовОбразование КАК КорректировкаДоходовБудущихПериодов
	|ГДЕ
	|	КорректировкаДоходовБудущихПериодов.Ссылка = &Ссылка
	|	И &ИзменитьПорядокУчетаДоходов";
	
	НомераТаблиц.Вставить("ГрафикПоДоговору", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ПорядокОплаты.Ссылка.Организация КАК Организация,
	|	ПорядокОплаты.Ссылка.Студент КАК Учащийся,
	|	ПорядокОплаты.Ссылка.Контрагент КАК Контрагент,
	|	ПорядокОплаты.Ссылка.Договор КАК Договор,
	|	ПорядокОплаты.Факультет КАК Факультет,
	|	ПорядокОплаты.ОплатитьДо КАК ОплатитьДо,
	|	ПорядокОплаты.НачалоПериода КАК НачалоПериода,
	|	ПорядокОплаты.КонецПериода КАК КонецПериода,
	|	ПорядокОплаты.Примечание КАК Примечание,
	|	ПорядокОплаты.Валюта КАК Валюта,
	|	ПорядокОплаты.СуммаВВалютеПослеИзменений КАК СуммаВВалюте
	|ИЗ
	|	Документ.КорректировкаДоходовБудущихПериодовОбразование.ПорядокОплаты КАК ПорядокОплаты
	|ГДЕ
	|	ПорядокОплаты.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОплатитьДо";
	
	ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	Если ИспользоватьКонтрольИсполненияДоговоров Тогда
		
		НомераТаблиц.Вставить("ДоходыБудущихПериодов", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг) КАК ВидРасчетов,
		|	ДоходыБудущихПериодов.Ссылка.Организация КАК Организация,
		|	ДоходыБудущихПериодов.Ссылка.ИФО КАК ИФО,
		|	ДоходыБудущихПериодов.КФО КАК КФО,
		|	ДоходыБудущихПериодов.КПС КАК КПС,
		|	ДоходыБудущихПериодов.КЭК КАК КЭК,
		|	ДоходыБудущихПериодов.Подразделение КАК Факультет,
		|	ДоходыБудущихПериодов.Ссылка.Студент КАК Студент,
		|	ДоходыБудущихПериодов.Ссылка.Контрагент КАК Контрагент,
		|	ДоходыБудущихПериодов.Ссылка.Договор КАК Договор,
		|	ДоходыБудущихПериодов.СчетРасчетов КАК СчетРасчетов,
		|	ДоходыБудущихПериодов.ДопКлассификация КАК ДопКлассификация,
		|	ДоходыБудущихПериодов.КодМероприятия КАК КодМероприятия,
		|	ДоходыБудущихПериодов.КодЦели КАК КодЦели,
		|	&ВалютаРеглУчета КАК Валюта,
		|	СУММА(ДоходыБудущихПериодов.Всего) КАК СуммаВВалюте
		|ИЗ
		|	Документ.КорректировкаДоходовБудущихПериодовОбразование.ДоходыБудущихПериодов КАК ДоходыБудущихПериодов
		|ГДЕ
		|	ДоходыБудущихПериодов.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ДоходыБудущихПериодов.Ссылка.Организация,
		|	ДоходыБудущихПериодов.Ссылка.ИФО,
		|	ДоходыБудущихПериодов.КФО,
		|	ДоходыБудущихПериодов.КПС,
		|	ДоходыБудущихПериодов.КЭК,
		|	ДоходыБудущихПериодов.Подразделение,
		|	ДоходыБудущихПериодов.Ссылка.Студент,
		|	ДоходыБудущихПериодов.Ссылка.Контрагент,
		|	ДоходыБудущихПериодов.Ссылка.Договор,
		|	ДоходыБудущихПериодов.СчетРасчетов,
		|	ДоходыБудущихПериодов.ДопКлассификация,
		|	ДоходыБудущихПериодов.КодМероприятия,
		|	ДоходыБудущихПериодов.КодЦели";
		
		НомераТаблиц.Вставить("ПорядокОплаты", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ
		|	ПорядокОплаты.ОплатитьДо КАК ОплатитьДо,
		|	ПорядокОплаты.КонецПериода КАК ИсполнитьДо,
		|	ПорядокОплаты.НачалоПериода КАК НачалоПериода,
		|	ПорядокОплаты.КонецПериода КАК КонецПериода,
		|	ПорядокОплаты.Примечание КАК Примечание,
		|	ПорядокОплаты.Факультет КАК Факультет,
		|	ПорядокОплаты.Валюта КАК Валюта,
		|	ПорядокОплаты.СуммаВВалюте КАК БазаРаспределения,
		|	ПорядокОплаты.СуммаВВалюте КАК СуммаВВалюте
		|ИЗ
		|	Документ.КорректировкаДоходовБудущихПериодовОбразование.ПорядокОплаты КАК ПорядокОплаты
		|ГДЕ
		|	ПорядокОплаты.Ссылка = &Ссылка
		|	И ПорядокОплаты.СуммаВВалюте <> 0";
		
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ТаблицыДляДвижений, Результат, НомераТаблиц);
	
	// Порядок оплаты.
	ПорядокОплатыОбразование = РегистрыСведений.ПорядокОплатыОбразование.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	Для Каждого СтрокаГрафика Из ТаблицыДляДвижений.ГрафикПоДоговору Цикл
		НоваяЗапись = ПорядокОплатыОбразование.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаГрафика,
			"Организация,Учащийся,Контрагент,Договор,Факультет,
			|ОплатитьДо,НачалоПериода,КонецПериода,Валюта,СуммаВВалюте,Примечание");
	КонецЦикла;
	
	// При формировании движений по регистру ПлановыеДатыОплатыОбразование сворачиваем порядок оплаты по колонке "Оплатить до",
	// чтобы избежать дублирования записей по значениям измерений.
	ПлановыеДатыОплатыОбразование = РегистрыСведений.ПлановыеДатыОплатыОбразование.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	ПлановыеДатыОплаты = ТаблицыДляДвижений.ГрафикПоДоговору.Скопировать(,
		"Учащийся,Договор,Факультет,Валюта,ОплатитьДо,СуммаВВалюте");
	ПлановыеДатыОплаты.Свернуть("Учащийся,Договор,Факультет,Валюта,ОплатитьДо", "СуммаВВалюте");
	ПлановыеДатыОплаты.Сортировать("ОплатитьДо");
	Для Каждого ПлановаяДатаОплаты Из ПлановыеДатыОплаты Цикл
		
		ОтборПоДатеОплаты = Новый Структура("Учащийся,Договор,Факультет,Валюта,ОплатитьДо");
		ЗаполнитьЗначенияСвойств(ОтборПоДатеОплаты, ПлановаяДатаОплаты);
		НайденныеСтроки = ТаблицыДляДвижений.ГрафикПоДоговору.НайтиСтроки(ОтборПоДатеОплаты);
		
		Если НайденныеСтроки.Количество() > 1 Тогда
			
			ИтогСуммаВВалюте = 0;
			МинНачалоПериода = '00010101';
			МаксКонецПериода = '00010101';
			Для Каждого СтрокаГрафика Из НайденныеСтроки Цикл
				ИтогСуммаВВалюте = ИтогСуммаВВалюте + СтрокаГрафика.СуммаВВалюте;
				МинНачалоПериода = ?(НЕ ЗначениеЗаполнено(МинНачалоПериода), СтрокаГрафика.НачалоПериода,
					Мин(МинНачалоПериода, СтрокаГрафика.НачалоПериода) );
				МаксКонецПериода = ?(НЕ ЗначениеЗаполнено(МаксКонецПериода), СтрокаГрафика.КонецПериода,
					Макс(МаксКонецПериода, СтрокаГрафика.КонецПериода) );
			КонецЦикла;
			
			НоваяЗапись = ПлановыеДатыОплатыОбразование.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, ПлановаяДатаОплаты, "Учащийся,Договор,Факультет,Валюта");
			НоваяЗапись.ДатаОплаты    = ПлановаяДатаОплаты.ОплатитьДо;
			НоваяЗапись.Сумма         = ИтогСуммаВВалюте;
			НоваяЗапись.АвтоРасчет    = Ложь;
			НоваяЗапись.НачалоПериода = МинНачалоПериода;
			НоваяЗапись.КонецПериода  = МаксКонецПериода;
			
		ИначеЕсли НайденныеСтроки.Количество() = 1 Тогда
			
			СтрокаГрафика = НайденныеСтроки[0];
			
			НоваяЗапись = ПлановыеДатыОплатыОбразование.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, ПлановаяДатаОплаты, "Учащийся,Договор,Факультет,Валюта");
			НоваяЗапись.ДатаОплаты    = ПлановаяДатаОплаты.ОплатитьДо;
			НоваяЗапись.Сумма         = ПлановаяДатаОплаты.СуммаВВалюте;
			НоваяЗапись.АвтоРасчет    = Ложь;
			НоваяЗапись.НачалоПериода = СтрокаГрафика.НачалоПериода;
			НоваяЗапись.КонецПериода  = СтрокаГрафика.КонецПериода;
			НоваяЗапись.Примечание    = СтрокаГрафика.Примечание;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Сохраним таблицы для формирования движений, удалим временные таблицы.
	ПорядокОплатыОбразование.ЗаполнитьЗначения(Истина, "Активность");
	ПорядокОплатыОбразование.ЗаполнитьЗначения(ДокументСсылка, "Регистратор");
	ПорядокОплатыОбразование.ЗаполнитьЗначения(ЗначенияРеквизитов.Дата, "Период");
	ТаблицыДляДвижений.Вставить("ПорядокОплатыОбразование", ПорядокОплатыОбразование);
	ПлановыеДатыОплатыОбразование.ЗаполнитьЗначения(Истина, "Активность");
	ПлановыеДатыОплатыОбразование.ЗаполнитьЗначения(ДокументСсылка, "Регистратор");
	ПлановыеДатыОплатыОбразование.ЗаполнитьЗначения(ЗначенияРеквизитов.Дата, "Период");
	ТаблицыДляДвижений.Вставить("ПлановыеДатыОплатыОбразование", ПлановыеДатыОплатыОбразование);
	ТаблицыДляДвижений.Удалить("ГрафикПоДоговору");
	
	Если ИспользоватьКонтрольИсполненияДоговоров Тогда
		
		ДоходыБудущихПериодов = Результат[НомераТаблиц.ДоходыБудущихПериодов].Выгрузить();
		ПорядокОплаты = Результат[НомераТаблиц.ПорядокОплаты].Выгрузить();
		
		ОплатаОтПокупателейДебиторов = РегистрыНакопления.ОплатаОтПокупателейДебиторов.СоздатьНаборЗаписей().ВыгрузитьКолонки();
		ИсполнениеДоговоровСПокупателями = РегистрыНакопления.ИсполнениеДоговоровСПокупателями.СоздатьНаборЗаписей().ВыгрузитьКолонки();
		
		ЕстьИзмененияДБП = Ложь;
		Для Каждого СтрокаТаблицы Из ДоходыБудущихПериодов Цикл
			
			Если СтрокаТаблицы.СуммаВВалюте = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ЕстьИзмененияДБП = Истина;
			
			// Сумму расчетов в каждой строке табличной части "Доходы будущих периодов" распределяем по датам графика.
			ГрафикПоДоговору = ПорядокОплаты.Скопировать(,
				"ОплатитьДо,ИсполнитьДо,НачалоПериода,КонецПериода,Примечание,Факультет,БазаРаспределения");
			ГрафикПоДоговору.Колонки.Добавить("СуммаВВалюте");
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СтрокаТаблицы.СуммаВВалюте,
				ГрафикПоДоговору, "СуммаВВалюте", "БазаРаспределения");
			
			Для Каждого СтрокаГрафика Из ГрафикПоДоговору Цикл
				
				// График платежей.
				НоваяЗапись = ОплатаОтПокупателейДебиторов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаТаблицы);
				НоваяЗапись.Период     = СтрокаГрафика.ОплатитьДо;
				НоваяЗапись.ОплатитьДо = СтрокаГрафика.ОплатитьДо;
				НоваяЗапись.Сумма      = СтрокаГрафика.СуммаВВалюте;
				
				// План-график реализации.
				НоваяЗапись = ИсполнениеДоговоровСПокупателями.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаТаблицы);
				НоваяЗапись.Период      = СтрокаГрафика.ИсполнитьДо;
				НоваяЗапись.ИсполнитьДо = СтрокаГрафика.ИсполнитьДо;
				НоваяЗапись.Сумма       = СтрокаГрафика.СуммаВВалюте;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если НЕ ЕстьИзмененияДБП И ДоходыБудущихПериодов.Количество() > 0 Тогда
			
			// Если изменения только в порядке оплаты аналитику берем из первой строки.
			// Разная аналитика (КФО, КПС, КЭК) по одному договору обучения не поддерживается (нет необходимости).
			АналитикаДоходовБудущихПериодов = ДоходыБудущихПериодов[0];
			
			Для Каждого СтрокаГрафика Из ПорядокОплаты Цикл
				
				// График платежей.
				НоваяЗапись = ОплатаОтПокупателейДебиторов.Добавить();
				НоваяЗапись.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
				ЗаполнитьЗначенияСвойств(НоваяЗапись, АналитикаДоходовБудущихПериодов,
					"Организация,Контрагент,Договор,ИФО,КФО,КПС,КЭК,СчетРасчетов,ДопКлассификация,КодМероприятия,КодЦели");
				ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаГрафика);
				НоваяЗапись.Период     = СтрокаГрафика.ОплатитьДо;
				НоваяЗапись.ОплатитьДо = СтрокаГрафика.ОплатитьДо;
				НоваяЗапись.Сумма      = СтрокаГрафика.СуммаВВалюте;
				
				// План-график реализации.
				НоваяЗапись = ИсполнениеДоговоровСПокупателями.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗапись, АналитикаДоходовБудущихПериодов,
					"Организация,Контрагент,Договор,ИФО,КФО,КПС,КЭК,СчетРасчетов");
				ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаГрафика);
				НоваяЗапись.Период      = СтрокаГрафика.ИсполнитьДо;
				НоваяЗапись.ИсполнитьДо = СтрокаГрафика.ИсполнитьДо;
				НоваяЗапись.Сумма       = СтрокаГрафика.СуммаВВалюте;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ОплатаОтПокупателейДебиторов.ЗаполнитьЗначения(ВидДвиженияНакопления.Приход, "ВидДвижения");
		ОплатаОтПокупателейДебиторов.ЗаполнитьЗначения(Истина, "Активность");
		ОплатаОтПокупателейДебиторов.ЗаполнитьЗначения(ДокументСсылка, "Регистратор");
		ТаблицыДляДвижений.Вставить("ОплатаОтПокупателейДебиторов", ОплатаОтПокупателейДебиторов);
		
		ИсполнениеДоговоровСПокупателями.ЗаполнитьЗначения(ВидДвиженияНакопления.Приход, "ВидДвижения");
		ИсполнениеДоговоровСПокупателями.ЗаполнитьЗначения(Истина, "Активность");
		ИсполнениеДоговоровСПокупателями.ЗаполнитьЗначения(ДокументСсылка, "Регистратор");
		ТаблицыДляДвижений.Вставить("ИсполнениеДоговоровСПокупателями", ИсполнениеДоговоровСПокупателями);
		
		Если ТипЗнч(ДополнительныеСвойства.ДанныеАвтоПроведения) = Тип("Структура")
			И ТипЗнч(ДополнительныеСвойства.ДанныеАвтоПроведения.ДополнительныеРеквизиты) = Тип("Структура")
			И ДополнительныеСвойства.ДанныеАвтоПроведения.ДополнительныеРеквизиты.Свойство("ИсправлениеОшибки")
			И ДополнительныеСвойства.ДанныеАвтоПроведения.ДополнительныеРеквизиты.ИсправлениеОшибки <> Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка Тогда
			// Это исправление ошибок прошлых лет.
			КонтрольИсполненияДоговоров.УстановитьПризнакИсправлениеОшибокПрошлыхЛетВДвиженияхПоРегистру(ТаблицыДляДвижений, "ОплатаОтПокупателейДебиторов");
			КонтрольИсполненияДоговоров.УстановитьПризнакИсправлениеОшибокПрошлыхЛетВДвиженияхПоРегистру(ТаблицыДляДвижений, "ИсполнениеДоговоровСПокупателями");
		КонецЕсли;
		
		// Удалим временные таблицы.
		ТаблицыДляДвижений.Удалить("ДоходыБудущихПериодов");
		ТаблицыДляДвижений.Удалить("ПорядокОплаты");
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

