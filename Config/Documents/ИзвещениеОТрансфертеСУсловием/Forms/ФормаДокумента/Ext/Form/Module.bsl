&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьИтогГрафы_6_7_8(Форма, ИмяТаблицы, Итог6, Итог7, Итог8)
	
	Итог6 = 0;
	Итог7 = 0; 
	Итог8 = 0;  
	
	Для Каждого СтрСумма Из Форма.Объект[ИмяТаблицы] Цикл  
		Коэффициент = 1;
		Если НЕ СтрНайти(СтрСумма.НаименованиеОперации, "уменьшени") = 0 Тогда
			Коэффициент = -1;	
		КонецЕсли;
		Итог6 = Итог6 + Коэффициент*СтрСумма.СуммаОтчПер;  
		Итог7 = Итог7 + Коэффициент*СтрСумма.СуммаПредПер;  
		Итог8 = Итог8 + Коэффициент*СтрСумма.СуммаСНачГода;
	КонецЦикла;
	
КонецПроцедуры	

