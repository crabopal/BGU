&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьНаименованиеСтороныТрансферта(Форма)
	
	ЭтоОтправитель = Форма.КэшПараметров.Локальные.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии");
	
	Форма.Составитель = "<...>";
	
	Если ЭтоОтправитель И Форма.Объект.СторонаТрансферта = 1 
		ИЛИ НЕ ЭтоОтправитель И Форма.Объект.СторонаТрансферта = 2 Тогда //это исходящее извещение
		Форма.Составитель = Форма.Объект.Организация;
	Иначе
		Форма.Составитель = Форма.Объект.Контрагент;
    КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура СформироватьКодБК(КПС, КодБК)   
	Если ЗначениеЗаполнено(КПС) Тогда
		КодБК = "" + ?(ЗначениеЗаполнено(ЭтотОбъект.КэшПараметров.Локальные.Глава),
		ЭтотОбъект.КэшПараметров.Локальные.Глава, "000") + КПС; 
	Иначе
		КодБК = "";
	КонецЕсли;
КонецПроцедуры	

