&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Глава", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "КодПоППП")); 
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВидДоговора", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ВидДоговора")); 
	
	НастроитьВидимостьПоСторонеТрансферта(ЭтотОбъект);  
	УстановитьНаименованиеСтороныТрансферта(ЭтотОбъект);
	РассчитатьИтогГрафы_6_7_8(ЭтотОбъект, "ОбъемТрансферта", ИтогГр6Стр100, ИтогГр7Стр100, ИтогГр8Стр100);  
	РассчитатьИтогГрафы_6_7_8(ЭтотОбъект, "НачисленыРасчетыОтправителем", ИтогГр6Стр300, ИтогГр7Стр300, ИтогГр8Стр300);
	
	// Списки выбора для операций
	ВидыОпераций = Документы.ИзвещениеОТрансфертеСУсловием.ПолучитьМакет("КодыОпераций");
