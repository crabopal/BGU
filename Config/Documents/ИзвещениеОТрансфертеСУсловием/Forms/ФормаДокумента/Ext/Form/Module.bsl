&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект); 
	УстановитьОтветственныхЛиц(Объект.Организация, Объект.Подразделение, Объект.Дата, Объект.Руководитель);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Глава", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "КодПоППП"));
КонецПроцедуры  

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВидДоговора", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ВидДоговора")); 
	Если ЭтотОбъект.КэшПараметров.Локальные.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии") Тогда
		Объект.СторонаТрансферта = 1;
		//Определить номер БО 
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	УчетныеНомераОбязательств.УчетныйНомерОбязательства КАК УчетныйНомерОбязательства
		|ИЗ
		|	РегистрСведений.УчетныеНомераОбязательств КАК УчетныеНомераОбязательств
		|ГДЕ
		|	УчетныеНомераОбязательств.Обязательство = &Обязательство"); 
		Запрос.УстановитьПараметр("Обязательство", Объект.Договор);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Объект.КодБООтправителя = Выборка.УчетныйНомерОбязательства;
		КонецЕсли;	
	Иначе
		Объект.СторонаТрансферта = 2; 
	КонецЕсли;	
	НастроитьВидимостьПоСторонеТрансферта(ЭтотОбъект); 
	УстановитьНаименованиеСтороныТрансферта(ЭтотОбъект);
КонецПроцедуры 

