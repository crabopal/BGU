#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом 


#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ИзвещениеОТрансфертеСУсловием";
	КомандаПечати.Идентификатор		= "ИзвещениеОТрансфертеСУсловием_0510453";
	КомандаПечати.Представление		= НСтр("ru = 'Извещение о трансферте, передаваемом с условием (ф. 0510453)'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры   

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИзвещениеОТрансфертеСУсловием_0510453") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
		"ИзвещениеОТрансфертеСУсловием_0510453",
		НСтр("ru = 'Извещение о трансферте, передаваемом с условием (ф. 0510453)'"),
		ПечатьИзвещения(МассивОбъектов, ОбъектыПечати, ПараметрыПечати, "ПФ_MXL_Форма0510453"));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

#КонецОбласти

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьИзвещения(МассивОбъектов, ОбъектыПечати, ПараметрыПечати, ИмяМакета) 
	
	ОбщиеСведения = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ИзвещениеОТрансфертеСУсловием.Ссылка КАК Ссылка,
	|	ИзвещениеОТрансфертеСУсловием.Номер КАК НомерДок,
	|	ИзвещениеОТрансфертеСУсловием.Дата КАК ДатаДок,
	|	ИзвещениеОТрансфертеСУсловием.ДатаНачала КАК ДатаНач,
	|	ИзвещениеОТрансфертеСУсловием.ДатаОкончания КАК ДатаКон,
	|	ИзвещениеОТрансфертеСУсловием.СторонаТрансферта КАК СторонаКод,
	|	ИзвещениеОТрансфертеСУсловием.Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии) КАК ЭтоСПолучателем,
	|	ИзвещениеОТрансфертеСУсловием.Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СОтправителемТрансферта) КАК ЭтоСОтправителем,
	|	ИзвещениеОТрансфертеСУсловием.Организация.НаименованиеПолное КАК ОрганизацияНаименование,
	|	ИзвещениеОТрансфертеСУсловием.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное КАК КонтрагентНаименование,
	|	ИзвещениеОТрансфертеСУсловием.Контрагент.ИНН КАК КонтрагентИНН,
	|	ИзвещениеОТрансфертеСУсловием.Контрагент.КПП КАК КонтрагентКПП,
	|	ВЫБОР
	|		КОГДА ИзвещениеОТрансфертеСУсловием.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.Пустаяссылка)
	|			ТОГДА """"
	|		ИНАЧЕ ИзвещениеОТрансфертеСУсловием.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|	КОНЕЦ КАК КонтрагентОП,
	|	ВЫБОР
	|		КОГДА ИзвещениеОТрансфертеСУсловием.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.Пустаяссылка)
	|			ТОГДА ИзвещениеОТрансфертеСУсловием.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|		ИНАЧЕ ИзвещениеОТрансфертеСУсловием.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ИзвещениеОТрансфертеСУсловием.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.Пустаяссылка)
	|			ТОГДА ИзвещениеОТрансфертеСУсловием.Контрагент.ЮридическоеФизическоеЛицо.КодПоРПБС
	|		ИНАЧЕ ИзвещениеОТрансфертеСУсловием.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.КодПоРПБС
	|	КОНЕЦ КАК КонтрагентРПБС,
	|	ВЫБОР
	|		КОГДА ИзвещениеОТрансфертеСУсловием.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.Пустаяссылка)
	|			ТОГДА """"
	|		ИНАЧЕ ИзвещениеОТрансфертеСУсловием.Контрагент.ЮридическоеФизическоеЛицо.КодПоРПБС
	|	КОНЕЦ КАК КонтрагентОПРПБС,
	|	ЕСТЬNULL(ИзвещениеОТрансфертеСУсловием.Контрагент.ЮридическоеФизическоеЛицо.КодПоППП.НаименованиеПолное, """") КАК КонтрагентГРБС,
	|	ЕСТЬNULL(ИзвещениеОТрансфертеСУсловием.Контрагент.ЮридическоеФизическоеЛицо.КодПоППП.Код, """") КАК КонтрагентГлава,
	|	ЕСТЬNULL(ИзвещениеОТрансфертеСУсловием.Контрагент.ЮридическоеФизическоеЛицо.Бюджет.НаименованиеПолное, """") КАК КонтрагентБюджет,
	|	ЕСТЬNULL(ИзвещениеОТрансфертеСУсловием.Контрагент.ЮридическоеФизическоеЛицо.Бюджет.Код, """") КАК КонтрагентОКТМО,
	|	ИзвещениеОТрансфертеСУсловием.ВидДокумента КАК ВидДокументаВнутр,
	|	ВЫБОР
	|		КОГДА ИзвещениеОТрансфертеСУсловием.ВидДокумента = 0
	|			ТОГДА ""первичный""
	|		КОГДА ИзвещениеОТрансфертеСУсловием.ВидДокумента = 1
	|			ТОГДА ""корректирующий""
	|		КОГДА ИзвещениеОТрансфертеСУсловием.ВидДокумента = 2
	|			ТОГДА ""ошибка текущего периода""
	|		КОГДА ИзвещениеОТрансфертеСУсловием.ВидДокумента = 3
	|			ТОГДА ""ошибка прошлых периодов""
	|		КОГДА ИзвещениеОТрансфертеСУсловием.ВидДокумента = 4
	|			ТОГДА ""сверка расчетов""
	|	КОНЕЦ КАК ВидДокумента,
	|	ИзвещениеОТрансфертеСУсловием.ПорядковыйНомер КАК ПорядковыйНомер,
	|	ИзвещениеОТрансфертеСУсловием.Договор.НомерДоговора КАК ОснованиеНомер,
	|	ИзвещениеОТрансфертеСУсловием.Договор.ДатаДоговора КАК ОснованиеДата,
	|	ИзвещениеОТрансфертеСУсловием.КодБООтправителя КАК ОснованиеКодБО,
	|	ВЫБОР
	|		КОГДА ИзвещениеОТрансфертеСУсловием.Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии)
	|			ТОГДА ВЫБОР
	|					КОГДА НЕ ЕСТЬNULL(ИзвещениеОТрансфертеСУсловием.КПС1.Код, """") = """"
	|						ТОГДА ЕСТЬNULL(ИзвещениеОТрансфертеСУсловием.Организация.КодПоППП.Код, """") + ЕСТЬNULL(ИзвещениеОТрансфертеСУсловием.КПС1.Код, """")
	|					ИНАЧЕ """"
	|				КОНЕЦ
	|		ИНАЧЕ ИзвещениеОТрансфертеСУсловием.КодБК1
	|	КОНЕЦ КАК КодБК1,
	|	ВЫБОР
	|		КОГДА ИзвещениеОТрансфертеСУсловием.Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии)
	|			ТОГДА ВЫБОР
	|					КОГДА НЕ ЕСТЬNULL(ИзвещениеОТрансфертеСУсловием.КПС2.Код, """") = """"
	|						ТОГДА ЕСТЬNULL(ИзвещениеОТрансфертеСУсловием.Организация.КодПоППП.Код, """") + ЕСТЬNULL(ИзвещениеОТрансфертеСУсловием.КПС2.Код, """")
	|					ИНАЧЕ """"
	|				КОНЕЦ
	|		ИНАЧЕ ИзвещениеОТрансфертеСУсловием.КодБК2
	|	КОНЕЦ КАК КодБК2,
	|	ВЫБОР
	|		КОГДА ИзвещениеОТрансфертеСУсловием.Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии)
	|			ТОГДА ВЫБОР
	|					КОГДА НЕ ЕСТЬNULL(ИзвещениеОТрансфертеСУсловием.КПС3.Код, """") = """"
	|						ТОГДА ЕСТЬNULL(ИзвещениеОТрансфертеСУсловием.Организация.КодПоППП.Код, """") + ЕСТЬNULL(ИзвещениеОТрансфертеСУсловием.КПС3.Код, """")
	|					ИНАЧЕ """"
	|				КОНЕЦ
	|		ИНАЧЕ ИзвещениеОТрансфертеСУсловием.КодБК3
	|	КОНЕЦ КАК КодБК3,
	|	ИзвещениеОТрансфертеСУсловием.КОСГУ1 КАК КОСГУ1,
	|	ИзвещениеОТрансфертеСУсловием.КОСГУ2 КАК КОСГУ2,
	|	ИзвещениеОТрансфертеСУсловием.КОСГУ3 КАК КОСГУ3,
	|	ИзвещениеОТрансфертеСУсловием.Руководитель КАК Руководитель,
	|	ИзвещениеОТрансфертеСУсловием.Бухгалтер КАК Бухгалтер,
	|	ИзвещениеОТрансфертеСУсловием.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель
	|ИЗ
	|	Документ.ИзвещениеОТрансфертеСУсловием КАК ИзвещениеОТрансфертеСУсловием
	|ГДЕ
	|	ИзвещениеОТрансфертеСУсловием.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.Ссылка КАК Ссылка,
	|	ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.НаименованиеОперации КАК ОперацияИмя,
	|	ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.КодОперации КАК ОперацияКод,
	|	ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.КодЦели КАК КодЦели,
	|	ВЫБОР
	|		КОГДА ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.Ссылка.Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии)
	|			ТОГДА ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.КПСОтправителя
	|		ИНАЧЕ ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.КПСОтправителяТекст
	|	КОНЕЦ КАК КПСОтправителя,
	|	ВЫБОР
	|		КОГДА ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.Ссылка.Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СОтправителемТрансферта)
	|			ТОГДА ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.КПСПолучателя
	|		ИНАЧЕ ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.КПСПолучателяТекст
	|	КОНЕЦ КАК КПСПолучателя,
	|	ВЫБОР
	|		КОГДА ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.НаименованиеОперации ПОДОБНО ""%уменьшени%""
	|			ТОГДА -ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.СуммаОтчПер
	|		ИНАЧЕ ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.СуммаОтчПер
	|	КОНЕЦ КАК СуммаОтчПерИт,   
	|	ВЫБОР
	|		КОГДА ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.НаименованиеОперации ПОДОБНО ""%уменьшени%""
	|			ТОГДА -ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.СуммаПредПер
	|		ИНАЧЕ ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.СуммаПредПер
	|	КОНЕЦ КАК СуммаПредПерИт, 
	|	ВЫБОР
	|		КОГДА ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.НаименованиеОперации ПОДОБНО ""%уменьшени%""
	|			ТОГДА -ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.СуммаСНачГода
	|		ИНАЧЕ ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.СуммаСНачГода
	|	КОНЕЦ КАК СуммаНачГодИт, 
	|	ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.СуммаОтчПер КАК СуммаОтчПер,
	|	ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.СуммаПредПер КАК СуммаПредПер,
	|	ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.СуммаСНачГода КАК СуммаНачГод
	|ИЗ
	|	Документ.ИзвещениеОТрансфертеСУсловием.ОбъемТрансферта КАК ИзвещениеОТрансфертеСУсловиемОбъемТрансферта
	|ГДЕ
	|	ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	ИзвещениеОТрансфертеСУсловиемОбъемТрансферта.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИзвещениеОТрансфертеСУсловиемПеречисленоОтправителем.Ссылка КАК Ссылка,
	|	ИзвещениеОТрансфертеСУсловиемПеречисленоОтправителем.НаименованиеОперации КАК ОперацияИмя,
