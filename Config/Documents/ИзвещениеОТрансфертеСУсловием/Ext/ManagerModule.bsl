		+ ?(ЗначениеЗаполнено(СтруктураДанных.ПорядковыйНомер), "/" + Строка(СтруктураДанных.ПорядковыйНомер), "")); 
		
		Если ЗначениеЗаполнено(СтруктураДанных.Руководитель) Тогда
			ДанныеСотрудника = Новый Структура;
