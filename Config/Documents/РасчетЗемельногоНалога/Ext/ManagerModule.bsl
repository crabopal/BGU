#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - см. УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.РасчетЗемельногоНалога";
	КомандаПечати.Идентификатор		= "Расчет";
	КомандаПечати.Представление		= НСтр("ru = 'Расчет земельного налога'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - см. УправлениеПечатьюПереопределяемый.ПриПечати.МассивОбъектов
//  ПараметрыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыПечати
//  КоллекцияПечатныхФорм - см. УправлениеПечатьюПереопределяемый.ПриПечати.КоллекцияПечатныхФорм
//  ОбъектыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ОбъектыПечати
//  ПараметрыВывода - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыВывода
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Расчет") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Расчет",
			НСтр("ru = 'Расчет земельного налога'"),
			ПечатьРасчетаЗемельногоНалога(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.Печать

// СтандартныеПодсистемы.УправлениеДоступом

// Параметры:
//   Ограничение - см. УправлениеДоступомПереопределяемый.ПриЗаполненииОграниченияДоступа.Ограничение.
//
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьРасчетаЗемельногоНалога(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ТолькоПросмотр		= Истина;
	ТабличныйДокумент.ИмяПараметровПечати	= "ПараметрыПечати_РасчетЗУ";
	
	ОбластиМакета = ОбластиМакетаРасчетЗемельногоНалога();
	
	ОбщиеСведения = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);

	Результат = ДанныеРасчета(МассивОбъектов);
	
	ВыборкаДокументов = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Первый = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не Первый Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		Первый = Ложь;
		
		НомерСтрокиНачало  = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ЗначенияЗаполнения = Новый Структура;
		
		УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияЗаполнения, ВыборкаДокументов.Ссылка, 
			ОбщиеСведения);
		
		ЗначенияЗаполнения.Вставить("Номер",
			ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер));

		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(ВыборкаДокументов.Дата);
		ЗначенияЗаполнения.Вставить("Дата",   ВыборкаДокументов.Дата);			
		ЗначенияЗаполнения.Вставить("Дня",    СтруктураДаты.Число);
		ЗначенияЗаполнения.Вставить("Месяца", СтруктураДаты.Месяц);
		ЗначенияЗаполнения.Вставить("Года",   СтруктураДаты.Год);

		ГодовойРасчет = (КонецКвартала(ВыборкаДокументов.ОтчетныйПериод) = КонецГода(ВыборкаДокументов.ОтчетныйПериод));
		
		Если ГодовойРасчет Тогда
			
			НачалоПериода      = НачалоГода(ВыборкаДокументов.ОтчетныйПериод);
			ШаблонПериода      = НСтр("ru = 'за налоговый период %1'");
			МесяцевВладения    = НСтр("ru = 'в году/12'");
			ОбластьШапка       = ОбластиМакета.Шапка;
			ОбластьСтрокаОКТМО = ОбластиМакета.СтрокаОКТМО;
			ОбластьСтрокаКБК   = ОбластиМакета.СтрокаКБК;
			ОбластьСтрокаОС    = ОбластиМакета.СтрокаОС;
			ОбластьИтоги       = ОбластиМакета.Итоги;
		Иначе
				
			НачалоПериода      = НачалоКвартала(ВыборкаДокументов.ОтчетныйПериод);
			ШаблонПериода      = НСтр("ru = 'за отчетный период %1'");
			МесяцевВладения    = НСтр("ru = 'в квартале/3'");
			ОбластьШапка       = ОбластиМакета.ШапкаАванс;
			ОбластьСтрокаОКТМО = ОбластиМакета.СтрокаОКТМОАванс;
			ОбластьСтрокаКБК   = ОбластиМакета.СтрокаКБКАванс;
			ОбластьСтрокаОС    = ОбластиМакета.СтрокаОСАванс;
			ОбластьИтоги       = ОбластиМакета.ИтогиАванс;
		КонецЕсли;	
		
		ПредставлениеОтчетногоПериода = СтрШаблон(ШаблонПериода,
			ПредставлениеПериода(НачалоПериода, ВыборкаДокументов.ОтчетныйПериод, "ФП = Истина"));
			
		ЗначенияЗаполнения.Вставить("ПредставлениеОтчетногоПериода", ПредставлениеОтчетногоПериода);
		
		ОбластиМакета.Заголовок.Параметры.Заполнить(ЗначенияЗаполнения);		
		ТабличныйДокумент.Вывести(ОбластиМакета.Заголовок);
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("МесяцевВладения", МесяцевВладения);
		ОбластьШапка.Параметры.Заполнить(ЗначенияЗаполнения);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		ТабличныйДокумент.НачатьАвтогруппировкуСтрок();
		
		ВыборкаОКТМО = ВыборкаДокументов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОКТМО.Следующий() Цикл
			ОбластьСтрокаОКТМО.Параметры.Заполнить(ВыборкаОКТМО);
			ТабличныйДокумент.Вывести(ОбластьСтрокаОКТМО, ВыборкаОКТМО.Уровень());
			ВыборкаКБК = ВыборкаОКТМО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаКБК.Следующий() Цикл
				ОбластьСтрокаКБК.Параметры.Заполнить(ВыборкаКБК);
				ТабличныйДокумент.Вывести(ОбластьСтрокаКБК, ВыборкаКБК.Уровень());
				ВыборкаОС = ВыборкаКБК.Выбрать();
				Пока ВыборкаОС.Следующий() Цикл
					ОбластьСтрокаОС.Параметры.Заполнить(ВыборкаОС);
					ЗначенияЗаполнения = Новый Структура;
					ЗначенияЗаполнения.Вставить("ДоляВПраве",
						ПредставлениеКоэффициента(ВыборкаОС.ДоляВПравеОбщейСобственностиЧислитель,
						                          ВыборкаОС.ДоляВПравеОбщейСобственностиЗнаменатель));
					ЗначенияЗаполнения.Вставить("ТекстНалоговойЛьготы", ТекстНалоговойЛьготы(ВыборкаОС));
					ОбластьСтрокаОС.Параметры.Заполнить(ЗначенияЗаполнения);
					ТабличныйДокумент.Вывести(ОбластьСтрокаОС, ВыборкаОС.Уровень());
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
		
		ОбластьИтоги.Параметры.Заполнить(ВыборкаДокументов);
		ТабличныйДокумент.Вывести(ОбластьИтоги);
		
		СведенияПоДокументу = ОбщиеСведения[ВыборкаДокументов.Ссылка];
		
		ТребуемыеДанные          = "ДолжностьНаименование,НаименованиеПолное";
		ДанныеГлавногоБухгалтера = Справочники.Сотрудники.ДанныеСотрудника(ВыборкаДокументов.ГлавныйБухгалтер, 
			ТребуемыеДанные, ВыборкаДокументов.Дата);
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("ДолжностьГлБух",   ДанныеГлавногоБухгалтера.ДолжностьНаименование);
		ФИОГлБух = КорреспондентыКлиентСервер.ФИО(ДанныеГлавногоБухгалтера.НаименованиеПолное);
		ЗначенияЗаполнения.Вставить("ФИОГлБух",         ФИОГлБух);
		ЗначенияЗаполнения.Вставить("Должность",        СведенияПоДокументу.ОтветственныйДолжность);
		ЗначенияЗаполнения.Вставить("ФИО",              СведенияПоДокументу.ОтветственныйФамилияИнициалы);
		ЗначенияЗаполнения.Вставить("НомерТелефона",    СведенияПоДокументу.ОтветственныйТелефон);
		ЗначенияЗаполнения.Вставить("ЭлектроннаяПочта", СведенияПоДокументу.ОтветственныйЭлПочта);
		
		ОбластиМакета.Подписи.Параметры.Заполнить(ЗначенияЗаполнения);
		ТабличныйДокумент.Вывести(ОбластиМакета.Подписи);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ОбластиМакетаРасчетЗемельногоНалога()
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.РасчетЗемельногоНалога.ПФ_MXL_РасчетЗемельногоНалога");
	
	ОбластиМакета = Новый Структура;
	ОбластиМакета.Вставить("Заголовок",        Макет.ПолучитьОбласть("Заголовок"));
	ОбластиМакета.Вставить("Шапка",            Макет.ПолучитьОбласть("Шапка"));
	ОбластиМакета.Вставить("СтрокаОКТМО",      Макет.ПолучитьОбласть("СтрокаОКТМО"));
	ОбластиМакета.Вставить("СтрокаКБК",        Макет.ПолучитьОбласть("СтрокаКБК"));
	ОбластиМакета.Вставить("СтрокаОС",         Макет.ПолучитьОбласть("СтрокаОС"));
	ОбластиМакета.Вставить("Итоги",            Макет.ПолучитьОбласть("Итоги"));
	ОбластиМакета.Вставить("ШапкаАванс",       Макет.ПолучитьОбласть("ШапкаАванс"));
	ОбластиМакета.Вставить("СтрокаОКТМОАванс", Макет.ПолучитьОбласть("СтрокаОКТМОАванс"));
	ОбластиМакета.Вставить("СтрокаКБКАванс",   Макет.ПолучитьОбласть("СтрокаКБКАванс"));
	ОбластиМакета.Вставить("СтрокаОСАванс",    Макет.ПолучитьОбласть("СтрокаОСАванс"));
	ОбластиМакета.Вставить("ИтогиАванс",       Макет.ПолучитьОбласть("ИтогиАванс"));
	ОбластиМакета.Вставить("Подписи",          Макет.ПолучитьОбласть("Подписи"));
	
	Возврат ОбластиМакета;	
КонецФункции

Функция ДанныеРасчета(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЧОсновныеСредства.Ссылка КАК Ссылка,
	|	ТЧОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТЧОсновныеСредства.НалоговыйОрган.Код КАК КодНО,
	|	ТЧОсновныеСредства.КодПоОКТМО КАК КодПоОКТМО,
	|	ТЧОсновныеСредства.КБК КАК КБК,
	|	ТЧОсновныеСредства.НалоговаяБаза КАК НалоговаяБаза,
	|	ТЧОсновныеСредства.НалоговаяСтавка КАК НалоговаяСтавка,
	|	ТЧОсновныеСредства.МесяцевВладения КАК МесяцевВладения,
	|	ТЧОсновныеСредства.СуммаИсчислено КАК СуммаИсчислено,
	|	ТЧОсновныеСредства.СуммаАванса КАК СуммаАванса,
	|	ТЧОсновныеСредства.Сумма КАК Сумма,
	|	ТЧОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ТЧОсновныеСредства.ДоляВПравеОбщейСобственностиЧислитель КАК ДоляВПравеОбщейСобственностиЧислитель,
	|	ТЧОсновныеСредства.ДоляВПравеОбщейСобственностиЗнаменатель КАК ДоляВПравеОбщейСобственностиЗнаменатель,
	|	ТЧОсновныеСредства.ДоляНеОблагаемойНалогомПлощадиЧислитель КАК ДоляНеОблагаемойНалогомПлощадиЧислитель,
	|	ТЧОсновныеСредства.ДоляНеОблагаемойНалогомПлощадиЗнаменатель КАК ДоляНеОблагаемойНалогомПлощадиЗнаменатель,
	|	ТЧОсновныеСредства.НеОблагаемаяНалогомСумма КАК НеОблагаемаяНалогомСумма,
	|	ТЧОсновныеСредства.ПроцентУменьшения КАК ПроцентУменьшения,
	|	ТЧОсновныеСредства.СуммаУменьшения КАК СуммаУменьшения
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.РасчетЗемельногоНалога.ОсновныеСредства КАК ТЧОсновныеСредства
	|ГДЕ
	|	ТЧОсновныеСредства.Ссылка В (&Ссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СведенияКадастровогоУчетаСрезПоследних.Организация КАК Организация,
	|	СведенияКадастровогоУчетаСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СведенияКадастровогоУчетаСрезПоследних.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомер КАК КадастровыйНомер
	|ПОМЕСТИТЬ СКУ
	|ИЗ
	|	РегистрСведений.СведенияКадастровогоУчета.СрезПоследних(, (Организация, ОсновноеСредство, ИнвентарныйНомер) В
	|		(ВЫБРАТЬ
	|			ВТ.Организация КАК Организация,
	|			ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|			ВТ.ИнвентарныйНомер КАК ИнвентарныйНомер
	|		ИЗ
	|			ВТ КАК ВТ)) КАК СведенияКадастровогоУчетаСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Ссылка КАК Ссылка,
	|	ВТ.Ссылка.Организация КАК Организация,
	|	ВТ.Ссылка.ОтчетныйПериод КАК ОтчетныйПериод,
	|	ВТ.Ссылка.ГлавныйБухгалтер КАК ГлавныйБухгалтер,
	|	ВТ.Ссылка.Номер КАК Номер,
	|	ВТ.Ссылка.Дата КАК Дата,
	|	ВТ.КодНО КАК КодНО,
	|	ВТ.КодПоОКТМО КАК ОКТМО,
	|	ВТ.КБК КАК КБК,
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ.ОсновноеСредство.НаименованиеПолное КАК НаименованиеОС,
	|	ВТ.НалоговаяБаза КАК НалоговаяБаза,
	|	ВТ.НалоговаяСтавка КАК НалоговаяСтавка,
	|	ВТ.МесяцевВладения КАК МесяцевВладения,
	|	ВТ.СуммаИсчислено КАК СуммаИсчислено,
	|	ВТ.СуммаАванса КАК СуммаАванса,
	|	ВТ.Сумма КАК Сумма,
	|	ЕСТЬNULL(СКУ.КадастровыйНомер, """") КАК КадастровыйНомер,
	|	ВТ.ДоляВПравеОбщейСобственностиЧислитель КАК ДоляВПравеОбщейСобственностиЧислитель,
	|	ВТ.ДоляВПравеОбщейСобственностиЗнаменатель КАК ДоляВПравеОбщейСобственностиЗнаменатель,
	|	ВТ.ДоляНеОблагаемойНалогомПлощадиЧислитель КАК ДоляНеОблагаемойНалогомПлощадиЧислитель,
	|	ВТ.ДоляНеОблагаемойНалогомПлощадиЗнаменатель КАК ДоляНеОблагаемойНалогомПлощадиЗнаменатель,
	|	ВТ.НеОблагаемаяНалогомСумма КАК НеОблагаемаяНалогомСумма,
	|	ВТ.ПроцентУменьшения КАК ПроцентУменьшения,
	|	ВТ.СуммаУменьшения КАК СуммаУменьшения
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ СКУ КАК СКУ
	|		ПО ВТ.Организация = СКУ.Организация
	|		И ВТ.ОсновноеСредство = СКУ.ОсновноеСредство
	|		И ВТ.ИнвентарныйНомер = СКУ.ИнвентарныйНомер
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Ссылка,
	|	ОКТМО,
	|	КБК,
	|	ВТ.НомерСтроки
	|ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(СуммаИсчислено),
	|	СУММА(СуммаАванса)
	|ПО
	|	Ссылка,
	|	ОКТМО,
	|	КБК";
	
	Выборка = Запрос.Выполнить();
	
	Возврат Выборка;
	
КонецФункции

Функция ПредставлениеКоэффициента(Числитель, Знаменатель)
	
	Возврат	
		?(Числитель = 0 И Знаменатель = 0 , "1/1",
			СтрШаблон("%1/%2", Формат(Числитель, "ЧГ="), Формат(Знаменатель, "ЧГ=")));
		
КонецФункции

Функция ТекстНалоговойЛьготы(Параметры)
	ТекстНалоговойЛьготы = "";
	
	Льготы = Новый Массив;
	Если Параметры.ДоляНеОблагаемойНалогомПлощадиЧислитель > 0 Тогда
		ТекстЛьготы = СтрШаблон(НСтр("ru = 'Доля необлагаемой площади %1 / %2'"), 
			Параметры.ДоляНеОблагаемойНалогомПлощадиЧислитель,
			Параметры.ДоляВПравеОбщейСобственностиЗнаменатель);
		Льготы.Добавить(ТекстЛьготы);
	КонецЕсли;
	Если Параметры.НеОблагаемаяНалогомСумма > 0 Тогда
		ТекстЛьготы = СтрШаблон(НСтр("ru = 'Не облагаемая налогом сумма %1 руб.'"), Параметры.НеОблагаемаяНалогомСумма);
		Льготы.Добавить(ТекстЛьготы);
	КонецЕсли;
	Если Параметры.ПроцентУменьшения > 0 Тогда
		ТекстЛьготы = СтрШаблон(НСтр("ru = 'Уменьшение суммы налога на %1%%'"), Параметры.ПроцентУменьшения);
		Льготы.Добавить(ТекстЛьготы);
	КонецЕсли;
	Если Параметры.СуммаУменьшения > 0 Тогда
		ТекстЛьготы = СтрШаблон(НСтр("ru = 'Уменьшение суммы налога на %1 руб.'"), Параметры.СуммаУменьшения);
		Льготы.Добавить(ТекстЛьготы);
	КонецЕсли;
	
	Если Льготы.Количество() > 0 Тогда
		Разделитель = СтрШаблон(НСтр("ru = ';%1'"), Символы.ПС);
		ТекстНалоговойЛьготы = СтрСоединить(Льготы, Разделитель);
	КонецЕсли;
	
	Возврат ТекстНалоговойЛьготы;
КонецФункции

#Область ОбновлениеИнформационнойБазы

// Регистрирует данные к обновлению в плане обмена ОбновлениеИнформационнойБазы.
//
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РасчетЗемельногоНалогаОсновныеСредства.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РасчетЗемельногоНалога.ОсновныеСредства КАК РасчетЗемельногоНалогаОсновныеСредства
	|ГДЕ
	|	РасчетЗемельногоНалогаОсновныеСредства.СуммаИсчислено -
	|		РасчетЗемельногоНалогаОсновныеСредства.СуммаАванса <> РасчетЗемельногоНалогаОсновныеСредства.Сумма";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

// Обрабатывает данные, зарегистрированные в плане обмена ОбновлениеИнформационнойБазы.
//
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.РасчетЗемельногоНалога";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);

	Пока Выборка.Следующий() Цикл

		ПредставлениеСсылки = Строка(Выборка.Ссылка);

		НачатьТранзакцию();
		Попытка

			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;

			Блокировка.Заблокировать();

			Объект = Выборка.Ссылка.ПолучитьОбъект();

			Если Объект = Неопределено Тогда
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;

			ЗаполнитьДобавленныеРеквизитыТабличнойЧасти_2_0_109(Объект);

			Если Объект.Модифицированность() Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение

			ОтменитьТранзакцию();

			ОбновлениеИнформационнойБазы.ЗаписатьОшибкуВЖурналРегистрации(
				Выборка.Ссылка,
				ПредставлениеСсылки,
				ИнформацияОбОшибке());

			ВызватьИсключение;
		КонецПопытки;

	КонецЦикла;

	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта);

КонецПроцедуры

Процедура ЗаполнитьДобавленныеРеквизитыТабличнойЧасти_2_0_109(Объект)
	
	ГодовойРасчет = КонецДня(Объект.ОтчетныйПериод) = КонецГода(Объект.ОтчетныйПериод);
	Для каждого Строка Из Объект.ОсновныеСредства Цикл
		СуммаИсчислено = Строка.Сумма + ?(ГодовойРасчет, Строка.СуммаАванса, 0);
		Если Строка.СуммаИсчислено <> СуммаИсчислено Тогда
			Строка.СуммаИсчислено = СуммаИсчислено;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

