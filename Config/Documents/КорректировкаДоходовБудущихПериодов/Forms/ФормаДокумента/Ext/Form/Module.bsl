&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЗапомнитьПараметрыДоговораВКэшеФормы();
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("НастройкиСчетовУчетаДБП",
		УчетДоходовРасходов.НастройкиСчетовУчетаДБП());
	
	ДоходыБудущихПериодовЗаполнитьДобавленныеКолонки();
	
	ОбновитьРеквизитыСписаниеДБП(Истина, Истина);
	
	Элементы.СпособПризнанияДоходов.ПараметрыВыбора =
		Перечисления.СпособыПризнанияРасходов.ПараметрыВыбораСпособаПризнанияДоходов(Объект.ТипДоговораДБП);
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	
	БухгалтерскийУчетКлиентСервер.УстановитьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект, "Видимость");
	
	УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект, Объект, "СчетДоходов");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоДосрочноеПрекрашение = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийКорректировкиДБП.ДосрочноеПрекрашение"));
	ЭтоКорректировка = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийКорректировкиДБП.КорректировкаДоходовБудущихПериодов"));
	
	ЭтоПередачаВАренду = (Объект.ТипДоговораДБП = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАренду"));
	ЭтоПередачаВАрендуНаЛьготныхУсловиях = (Объект.ТипДоговораДБП = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях"));
	ЭтоПередачаВБезвозмездноеПользование = (Объект.ТипДоговораДБП = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование"));
	ЭтоПрочиеДоходыБудущихПериодов = (Объект.ТипДоговораДБП = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийНачисленияДБП.ПрочиеДоходыБудущихПериодов"));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ТипДоговораДБП", "Доступность", НЕ ЭтоДосрочноеПрекрашение);
	
	ВыборРежима = Новый Массив;
	ВыборРежима.Добавить("ЗаголовокИзменить");
	ВыборРежима.Добавить("ИзменитьСуммыДоходов");
	ВыборРежима.Добавить("ИзменитьПорядокУчетаДоходов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ВыборРежима, "Видимость", ЭтоКорректировка);
	
	// Закладка "Доходы будущих периодов".
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДоходыБудущихПериодов", "ИзменятьСоставСтрок", ЭтоКорректировка И Объект.ИзменитьСуммыДоходов);
	КорректировкаСуммДоходов = Новый Массив;
	КорректировкаСуммДоходов.Добавить("ДоходыБудущихПериодовИзменитьСуммы");
	КорректировкаСуммДоходов.Добавить("ДоходыБудущихПериодовДобавить");
	КорректировкаСуммДоходов.Добавить("ДоходыБудущихПериодовПереместитьВверх");
	КорректировкаСуммДоходов.Добавить("ДоходыБудущихПериодовПереместитьВниз");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		КорректировкаСуммДоходов, "Доступность", Объект.ИзменитьСуммыДоходов);
	
	// Для прочих ДБП отображается колонка "Изменить" с одной суммой.
	ГруппаИзменить = Новый Массив;
	ГруппаИзменить.Добавить("ДоходыБудущихПериодовКПСРасходовПоУпущеннойВыгоде");
	ГруппаИзменить.Добавить("ДоходыБудущихПериодовКФОРасходовПоУпущеннойВыгоде");
	ГруппаИзменить.Добавить("ДоходыБудущихПериодовСчетРБППоУпущеннойВыгоде");
	ГруппаИзменить.Добавить("ДоходыБудущихПериодовКЭКРасходовПоУпущеннойВыгоде");
	ГруппаИзменить.Добавить("ДоходыБудущихПериодовОстатокРасходовПоУпущеннойВыгоде");
	ГруппаИзменить.Добавить("ДоходыБудущихПериодовЗаголовокНеЗаполняется");
	ГруппаИзменить.Добавить("ДоходыБудущихПериодовЗаголовокСправедливая");
	ГруппаИзменить.Добавить("ДоходыБудущихПериодовЗаголовокУпущеннаяВыгода");
	ГруппаИзменить.Добавить("ДоходыБудущихПериодовЗаголовокПоДоговору");
	ГруппаИзменить.Добавить("ДоходыБудущихПериодовВсегоСправедливая");
	ГруппаИзменить.Добавить("ДоходыБудущихПериодовСуммаРасходовПоУпущеннойВыгоде");
	ГруппаИзменить.Добавить("ДоходыБудущихПериодовВсего");
	ГруппаИзменить.Добавить("ДоходыБудущихПериодовПослеИзмененияРасходыПоУпущеннойВыгоде");
	ГруппаИзменить.Добавить("ДоходыБудущихПериодовПослеИзмененияВсего");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ГруппаИзменить, "Видимость", НЕ ЭтоПрочиеДоходыБудущихПериодов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДоходыБудущихПериодовСумма", "Видимость", ЭтоПрочиеДоходыБудущихПериодов);
	
	ГруппаРасчеты = Новый Массив;
	ГруппаРасчеты.Добавить("ДоходыБудущихПериодовСчетРасчетов");
	ГруппаРасчеты.Добавить("ДоходыБудущихПериодовДопСубконтоРасчетов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ГруппаРасчеты, "Видимость", НЕ ЭтоПередачаВБезвозмездноеПользование И Объект.ИзменитьСуммыДоходов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДоходыБудущихПериодовСтатьяРасходовПоУпущеннойВыгоде", "Видимость",
			НЕ ЭтоПередачаВАренду И НЕ ЭтоПрочиеДоходыБудущихПериодов);
	
	// Закладка "Порядок учета доходов".
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтраницаПорядокУчетаДоходов", "Видимость", ЭтоКорректировка);
	КорректировкаПорядкаУчетаДоходов = Новый Массив;
	КорректировкаПорядкаУчетаДоходов.Добавить("ГруппаПараметрыСписания");
	КорректировкаПорядкаУчетаДоходов.Добавить("ГруппаОтражениеВДоходахТекущегоПериода");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		КорректировкаПорядкаУчетаДоходов, "Доступность", ЭтоКорректировка И Объект.ИзменитьПорядокУчетаДоходов);

	ОсобыйПорядокПризнанияДоходовТекущегоПериода =
		(Объект.СпособПризнанияДоходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ВОсобомПорядке"));
	ПризнаниеДоходовТекущегоПериодаПоГрафику =
		(Объект.СпособПризнанияДоходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоГрафику"));
	
	ВедетсяГрафикПоДоговору = Форма.КэшПараметров.Локальные.Свойство("ВедетсяГрафикПоДоговору")
		И Форма.КэшПараметров.Локальные.ВедетсяГрафикПоДоговору;
	ЕстьГрафикПоДоговору = Форма.КэшПараметров.Локальные.Свойство("ЕстьГрафикПоДоговору")
		И Форма.КэшПараметров.Локальные.ЕстьГрафикПоДоговору;
	
	СрокСписания = Новый Массив;
	СрокСписания.Добавить("ДатаНачалаСписания");
	СрокСписания.Добавить("ДатаОкончанияСписания");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		СрокСписания, "Видимость", НЕ ПризнаниеДоходовТекущегоПериодаПоГрафику ИЛИ ЭтоПередачаВАрендуНаЛьготныхУсловиях);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаГрафикПризнанияДоходов",
		"Видимость", ПризнаниеДоходовТекущегоПериодаПоГрафику И ВедетсяГрафикПоДоговору);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаГрафикПризнанияДоходовПредупреждение",
		"Видимость", ПризнаниеДоходовТекущегоПериодаПоГрафику И НЕ ВедетсяГрафикПоДоговору);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ВвестиГрафикПризнанияДоходов", "Видимость", ПризнаниеДоходовТекущегоПериодаПоГрафику И НЕ ЕстьГрафикПоДоговору);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОткрытьГрафикПризнанияДоходов", "Видимость", ПризнаниеДоходовТекущегоПериодаПоГрафику И ЕстьГрафикПоДоговору);
	
	Если ОсобыйПорядокПризнанияДоходовТекущегоПериода Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "АвтоОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "ОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "АвтоОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "ОтметкаНезаполненного", Ложь);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "АвтоОтметкаНезаполненного", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "ОтметкаНезаполненного", Не ЗначениеЗаполнено(Объект.ДатаНачалаСписания));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "АвтоОтметкаНезаполненного", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "ОтметкаНезаполненного", Не ЗначениеЗаполнено(Объект.ДатаОкончанияСписания));
	КонецЕсли;
	
	Если ПризнаниеДоходовТекущегоПериодаПоГрафику Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыСписания", "Подсказка",
			НСтр("ru = 'Доходы будущих периодов относятся на финансовый результат текущего периода согласно графику, установленному договором.'"));
	ИначеЕсли ОсобыйПорядокПризнанияДоходовТекущегоПериода Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыСписания", "Подсказка",
			НСтр("ru = 'Суммы списания доходов будущих периодов указывается вручную в регламентном документе ""Списание доходов будущих периодов"".'"));
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыСписания", "Подсказка",
			НСтр("ru = 'В течение указанного срока доходы будущих периодов относятся на финансовый результат текущего периода.'"));
	КонецЕсли;
	
	// Закладка "Бухгалтерская операция".
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"БухгалтерскаяОперация", "Видимость", Объект.ИзменитьСуммыДоходов);
	
	УстановитьВидимостьЭлементовСписаниеДБП(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовСписаниеДБП(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЕстьДокументСписаниеДБП = ЗначениеЗаполнено(Форма.СписаниеДБП);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаСписаниеДБПКнопка", "Видимость", НЕ ЕстьДокументСписаниеДБП);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаСписаниеДБПСсылка", "Видимость", ЕстьДокументСписаниеДБП);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоПередачаВБезвозмездноеПользование =
		(Объект.ТипДоговораДБП = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование"));
	
	ОтражатьВНалоговомУчете = НЕ ЭтоПередачаВБезвозмездноеПользование
		И Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль;
	ОтражатьВНалоговомУчетеУСН = НЕ ЭтоПередачаВБезвозмездноеПользование
		И (Форма.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходы
		ИЛИ Форма.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаНалоговыйУчет", "Видимость", ОтражатьВНалоговомУчете ИЛИ ОтражатьВНалоговомУчетеУСН);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаБухгалтерскийУчет", "ОтображатьЗаголовок", ОтражатьВНалоговомУчете ИЛИ ОтражатьВНалоговомУчетеУСН);
	
	ЭтоПрочиеДоходы = БухгалтерскийУчетКлиентСервер.СчетВИерархии(Объект.СчетДоходовНУ, "Н91.01");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтатьяПрочихДоходовНУ", "Видимость", ЗначениеЗаполнено(Объект.СчетДоходовНУ) И ЭтоПрочиеДоходы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИДоступностьСубконто(Форма, Объект, ИмяРеквизитаСчет)
	Перем МассивПолей;
	
	Если ИмяРеквизитаСчет = "СчетДоходов" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоДоходов1", "СубконтоДоходов1", Истина, "СубконтоДоходов1", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоДоходов2", "СубконтоДоходов2", Истина, "СубконтоДоходов2", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоДоходов3", "СубконтоДоходов3", Истина, "СубконтоДоходов3", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетДоходов, Форма, Объект, МассивПолей);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Доходы будущих периодов в валюте.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовОстатокДБПВВалюте");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовВалюта");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовВалютаРеглУчета");
	ГруппаИЛИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЭлементУО.Отбор,, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ,
		"Объект.ДоходыБудущихПериодов.СчетДБПВалютный", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ,
		"Объект.ДоходыБудущихПериодов.Валюта", ВидСравненияКомпоновкиДанных.Равно, ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ,
		"Объект.ДоходыБудущихПериодов.Валюта", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Счета учета доступны для редактирования только в строках, введенных вручную.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКПС");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКФО");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСчетДБП");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКЭК");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовПодразделение");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовНоменклатура");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКодЦели");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ОстатокДБП", ВидСравненияКомпоновкиДанных.НеРавно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКПСРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКФОРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСчетРБППоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКЭКРасходовПоУпущеннойВыгоде");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ОстатокРасходовПоУпущеннойВыгоде", ВидСравненияКомпоновкиДанных.НеРавно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
	// При передаче в аренду (обычную) доходы от предоставления прав пользования активами отсутствуют.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСуммаРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовОстатокРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовПослеИзмененияРасходыПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСтатьяРасходовПоУпущеннойВыгоде");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТипДоговораДБП",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАренду);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ОстатокРасходовПоУпущеннойВыгоде", ВидСравненияКомпоновкиДанных.Равно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Отсутствует'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКПСРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКФОРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСчетРБППоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКЭКРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовОстатокРасходовПоУпущеннойВыгоде");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТипДоговораДБП",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАренду);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ОстатокРасходовПоУпущеннойВыгоде", ВидСравненияКомпоновкиДанных.Равно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Доступность поля КодЦели в зависимости от настроек счета ДБП (401.4Х).
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКодЦели");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ЕстьКодЦели", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не используется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	БухгалтерскийУчет.УстановитьУсловноеОформлениеПолейАналитикиСчета(
		УсловноеОформление, ДоходыБудущихПериодовПоляАналитикиСчетаДБП());
	УчетРасчетов.УстановитьУсловноеОформлениеСчетаИДопСубконтоРасчетов(
		УсловноеОформление, "ДоходыБудущихПериодов");
	
КонецПроцедуры

&НаСервере
Процедура ЗапомнитьПараметрыДоговораВКэшеФормы()
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВедетсяГрафикПоДоговору", Ложь);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ЕстьГрафикПоДоговору", Ложь);
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ВестиПланГрафикИсполнения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ВестиПланГрафикИсполнения");
		ЭтотОбъект.КэшПараметров.Локальные.ВедетсяГрафикПоДоговору = 
			?(ВестиПланГрафикИсполнения = Неопределено, Ложь, ВестиПланГрафикИсполнения);
		ЭтотОбъект.КэшПараметров.Локальные.ЕстьГрафикПоДоговору = 
			КонтрольИсполненияДоговоров.ЕстьГрафикПоДоговору(Объект.Договор, "ПланГрафикИсполнения");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьДокументПараметрыВопроса()
	
	ПараметрыВопроса = Новый Структура;
	ПараметрыВопроса.Вставить("ЗадатьВопрос", Ложь);
	ПараметрыВопроса.Вставить("ТекстВопроса",
		НСтр("ru = 'Заполнить документ по остаткам на счетах бухгалтерского учета?'") );
	
	ЕстьДанныеВДокументе = (Объект.ДоходыБудущихПериодов.Количество() > 0);
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Проведение документа будет отменено, а данные будут очищены.'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	ИначеЕсли Объект.Проведен Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Проведение документа будет отменено.'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Данные документа будут очищены.'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	КонецЕсли;
	
	Возврат ПараметрыВопроса;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьДокументОбработкаОтвета(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДокументНаСервере(
			ДополнительныеПараметры.ЗаполнитьТипДоговора,
			ДополнительныеПараметры.ЗаполнитьСуммыДоходов,
			ДополнительныеПараметры.ЗаполнитьПорядокУчетаДоходов);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументНаСервере(ЗаполнитьТипДоговора = Истина, ЗаполнитьСуммыДоходов = Истина, ЗаполнитьПорядокУчетаДоходов = Истина)
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьДокумент(ЗаполнитьТипДоговора, ЗаполнитьСуммыДоходов, ЗаполнитьПорядокУчетаДоходов);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ДоходыБудущихПериодовЗаполнитьДобавленныеКолонки();
	
	ЗапомнитьПараметрыДоговораВКэшеФормы();
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммыПриИзмененииВидаОперации()
	
	Для Каждого СтрокаТаблицы Из Объект.ДоходыБудущихПериодов Цикл
		
		Если НЕ Объект.ИзменитьСуммыДоходов Тогда
			
			СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде = 0;
			СтрокаТаблицы.ВсегоСправедливая              = 0;
			
		ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийКорректировкиДБП.ДосрочноеПрекрашение")
			И Объект.ИзменитьСуммыДоходов Тогда
			
			СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде = (-1) * СтрокаТаблицы.ОстатокРасходовПоУпущеннойВыгоде;
			СтрокаТаблицы.ВсегоСправедливая              = (-1) * СтрокаТаблицы.ОстатокДБП;
			
		Иначе // КорректировкаДоходовБудущихПериодов
			
			Если Объект.ТипДоговораДБП = ПредопределенноеЗначение(
				"Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАренду") Тогда
				// Убираем упущенную выгоду, увеличиваем справедливую стоимость на остаток упущенной выгоды.
				СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде = (-1) * СтрокаТаблицы.ОстатокРасходовПоУпущеннойВыгоде;
				СтрокаТаблицы.ВсегоСправедливая              = 0;
			ИначеЕсли Объект.ТипДоговораДБП = ПредопределенноеЗначение(
				"Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование") Тогда
				// Упущенная выгода равна справедливой стоимости, увеличиваем упущенную выгоду до справедливой стоимости.
				СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде = СтрокаТаблицы.ОстатокДБП - СтрокаТаблицы.ОстатокРасходовПоУпущеннойВыгоде;
				СтрокаТаблицы.ВсегоСправедливая              = 0;
			Иначе
				// Нельзя предсказать суть изменений, ручной ввод сумм.
				СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде = 0;
				СтрокаТаблицы.ВсегоСправедливая              = 0;
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаТаблицы.Всего = СтрокаТаблицы.ВсегоСправедливая - СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде;
		
		ДоходыБудущихПериодовЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьРеквизитыСписаниеДБП(ОбновитьСсылку, ОбновитьДатыПризнанияДоходов)
	
	Если ОбновитьСсылку Тогда
		
		Если НЕ Объект.Ссылка.Пустая() Тогда
			Реквизиты = Документы.КорректировкаДоходовБудущихПериодов.РеквизитыПодчиненногоДокументаСписаниеДБП(Объект.Ссылка);
			СписаниеДБП = Реквизиты.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОбновитьДатыПризнанияДоходов Тогда
		
		ЕстьДокументСписаниеДБП = ЗначениеЗаполнено(СписаниеДБП);
		Если НЕ ЕстьДокументСписаниеДБП Тогда
			ДатаДокумента = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
			СписаниеДБПДатаНачала = НачалоМесяца(ДатаДокумента);
			СписаниеДБПДатаОкончания = КонецДня(ДатаДокумента);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьСписаниеДБПНаКлиенте()
	
	Если Объект.Ссылка.Пустая() Тогда
		Записать();
	КонецЕсли;
	
	ЗначенияЗаполнения = Новый Структура("Организация,ИФО,КФО,Контрагент,Договор,Ответственный");
	ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, Объект);
	ЗначенияЗаполнения.Вставить("ДокументОснование", Объект.Ссылка);
	ЗначенияЗаполнения.Вставить("Дата", СписаниеДБПДатаОкончания);
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ФормаНовогоДокумента = ОткрытьФорму("Документ.СписаниеДоходовБудущихПериодов.ФормаОбъекта",
		ПараметрыФормы, ЭтотОбъект, Объект.Ссылка, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

