	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтразитьВМежотчетномПериодеПриИзменении(Элемент)
	
	Если ОтразитьВМежотчетномПериоде Тогда
		Объект.Дата = КонецГода(Объект.Дата);
		БухгалтерскийУчетКлиент.УстановитьЗначениеВидаМежотчетногоПериода(ЭтотОбъект,
			ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ИзменениеВалютыБаланса"));
	Иначе
		БухгалтерскийУчетКлиент.УстановитьЗначениеВидаМежотчетногоПериода(ЭтотОбъект,
			ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ПустаяСсылка"));
	КонецЕсли;
	
	ОтразитьВМежотчетномПериодеПриИзмененииНаСервере();
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	
КонецПроцедуры

&НаСервере
Процедура ОтразитьВМежотчетномПериодеПриИзмененииНаСервере()
	
	// Может измениться дата определения параметров учетной политики.
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	ПараметрыВопроса = ЗаполнитьДокументПараметрыВопроса();
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ЗаполнитьТипДоговора", Истина);
	ПараметрыЗаполнения.Вставить("ЗаполнитьСуммыДоходов", Истина);
	ПараметрыЗаполнения.Вставить("ЗаполнитьПорядокУчетаДоходов", Истина);
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьДокументОбработкаОтвета", ЭтотОбъект, ПараметрыЗаполнения);
	ПоказатьВопрос(Оповещение, ПараметрыВопроса.ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	Если Объект.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийКорректировкиДБП.ДосрочноеПрекрашение") Тогда
		
		Если НЕ Объект.ИзменитьСуммыДоходов Тогда
			Объект.ИзменитьСуммыДоходов = Истина;
		КонецЕсли;
		
		Если Объект.ИзменитьПорядокУчетаДоходов Тогда
		
			// Не имеет смысла менять порядок учета доходов при прекращении договора.
			Объект.ИзменитьПорядокУчетаДоходов = Ложь;
			
			ПараметрыЗаполнения = Новый Структура;
			ПараметрыЗаполнения.Вставить("ЗаполнитьТипДоговора", Ложь);
			ПараметрыЗаполнения.Вставить("ЗаполнитьСуммыДоходов", Ложь);
			ПараметрыЗаполнения.Вставить("ЗаполнитьПорядокУчетаДоходов", Истина);
			ЗаполнитьДокументНаСервере(
				ПараметрыЗаполнения.ЗаполнитьТипДоговора,
				ПараметрыЗаполнения.ЗаполнитьСуммыДоходов,
				ПараметрыЗаполнения.ЗаполнитьПорядокУчетаДоходов);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПересчитатьСуммыПриИзмененииВидаОперации();
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипДоговораДБППриИзменении(Элемент)
	
	Если Объект.ИзменитьСуммыДоходов Тогда
		ПересчитатьСуммыПриИзмененииВидаОперации();
	КонецЕсли;
	
	Если Объект.ИзменитьПорядокУчетаДоходов Тогда
		ТипДоговораДБППриИзмененииНаСервере();
	КонецЕсли;
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	
КонецПроцедуры

&НаСервере
Процедура ТипДоговораДБППриИзмененииНаСервере()
	
	ЭтоПередачаВАренду =
		(Объект.ТипДоговораДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАренду);
	ЭтоПередачаВАрендуНаЛьготныхУсловиях =
		(Объект.ТипДоговораДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях);
	ЭтоПередачаВБезвозмездноеПользование =
		(Объект.ТипДоговораДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование);
	
	Если ЭтоПередачаВАренду ИЛИ ЭтоПередачаВАрендуНаЛьготныхУсловиях ИЛИ ЭтоПередачаВБезвозмездноеПользование Тогда
		
		Объект.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам;
		Объект.СчетДоходовНУ = БухгалтерскийУчет.СчетПоКоду("Н91.01", Объект.Дата);
		
	Иначе
		
		Объект.СчетДоходовНУ = БухгалтерскийУчет.СчетПоКоду("Н90.01", Объект.Дата);
		
	КонецЕсли;
	
	Элементы.СпособПризнанияДоходов.ПараметрыВыбора =
		Перечисления.СпособыПризнанияРасходов.ПараметрыВыбораСпособаПризнанияДоходов(Объект.ТипДоговораДБП);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСуммыДоходовПриИзменении(Элемент)
	
	Если НЕ Объект.ИзменитьСуммыДоходов И НЕ Объект.ИзменитьПорядокУчетаДоходов Тогда
		Объект.ИзменитьПорядокУчетаДоходов = Истина;
	КонецЕсли;
	
	ПересчитатьСуммыПриИзмененииВидаОперации();
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПорядокУчетаДоходовПриИзменении(Элемент)
	
	Если НЕ Объект.ИзменитьСуммыДоходов И НЕ Объект.ИзменитьПорядокУчетаДоходов Тогда
		Объект.ИзменитьСуммыДоходов = Истина;
	КонецЕсли;
	
	Если НЕ Объект.ИзменитьПорядокУчетаДоходов Тогда
		// Сбролили флаг "Изменить порядок учета доходов" - перезаполним порядок учета доходов.
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("ЗаполнитьТипДоговора", Ложь);
		ПараметрыЗаполнения.Вставить("ЗаполнитьСуммыДоходов", Ложь);
		ПараметрыЗаполнения.Вставить("ЗаполнитьПорядокУчетаДоходов", Истина);
		ЗаполнитьДокументНаСервере(
			ПараметрыЗаполнения.ЗаполнитьТипДоговора,
			ПараметрыЗаполнения.ЗаполнитьСуммыДоходов,
			ПараметрыЗаполнения.ЗаполнитьПорядокУчетаДоходов);
	КонецЕсли;
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СпособПризнанияДоходовПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

