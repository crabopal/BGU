&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ЗаполнитьТипДоговора", Ложь);
	ПараметрыЗаполнения.Вставить("ЗаполнитьСуммыДоходов", Истина);
	ПараметрыЗаполнения.Вставить("ЗаполнитьПорядокУчетаДоходов", Ложь);
	
	ПараметрыВопроса = ЗаполнитьДокументПараметрыВопроса();
	Если ЗначениеЗаполнено(ПараметрыВопроса.ЗадатьВопрос) Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьДокументОбработкаОтвета", ЭтотОбъект, ПараметрыЗаполнения);
		ПоказатьВопрос(Оповещение, ПараметрыВопроса.ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьДокументНаСервере(
			ПараметрыЗаполнения.ЗаполнитьТипДоговора,
			ПараметрыЗаполнения.ЗаполнитьСуммыДоходов,
			ПараметрыЗаполнения.ЗаполнитьПорядокУчетаДоходов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьСписаниеДБП(Команда)
	
	Если Объект.ПометкаУдаления Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Нельзя сформировать документ признания доходов на основании документа, помеченного на удаление.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СписаниеДБПДатаОкончания) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Дата окончания признания доходов'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "СписаниеДБПДатаОкончания");
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ТекстВопроса = НСтр("ru = 'Документ будет записан. Продолжить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросСформироватьСписаниеДБПЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		СформироватьСписаниеДБПНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСформироватьСписаниеДБПЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СформироватьСписаниеДБПНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиГрафикПризнанияДоходов(Команда)
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("ДокументОснование", Объект.Ссылка);
	ПараметрыВызова.Вставить("Организация", Объект.Организация);
	ПараметрыВызова.Вставить("ИФО", Объект.ИФО);
	ПараметрыВызова.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыВызова.Вставить("ВалютаДокумента", ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	
	КонтрольИсполненияДоговоровКлиент.ВвестиИзменитьГрафикПоДоговору(Объект.Договор, "ПланГрафикИсполнения",
		ПараметрыВызова, ЭтотОбъект, Объект.Ссылка);
	
КонецПроцедуры

