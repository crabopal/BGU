#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	// Закладка "Порядок учета доходов".
	Если НЕ ИзменитьПорядокУчетаДоходов Тогда
		НепроверяемыеРеквизиты.Добавить("СпособПризнанияДоходов");
		НепроверяемыеРеквизиты.Добавить("ДатаНачалаСписания");
		НепроверяемыеРеквизиты.Добавить("ДатаОкончанияСписания");
		НепроверяемыеРеквизиты.Добавить("ВидДеятельностиНУ");
		НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
		НепроверяемыеРеквизиты.Добавить("ВидДеятельностиУСН");
	Иначе
		
		Если СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам
		 ИЛИ СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням Тогда
			
			Если ЗначениеЗаполнено(ДатаНачалаСписания) И ЗначениеЗаполнено(ДатаОкончанияСписания)
				И (ДатаОкончанияСписания < ДатаНачалаСписания) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность",
					НСтр("ru = 'Дата окончания списания'"),,,
					НСтр("ru = 'Дата начала списания превышает дату окончания.'"));
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "ДатаОкончанияСписания", "Объект", Отказ);
			КонецЕсли;
			
		Иначе
			НепроверяемыеРеквизиты.Добавить("ДатаНачалаСписания");
			НепроверяемыеРеквизиты.Добавить("ДатаОкончанияСписания");
		КонецЕсли;
		
		РеквизитыСчетаДоходов = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
			"СчетДоходов", "СубконтоДоходов1", "СубконтоДоходов2", "СубконтоДоходов3");
		БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаДоходов,
			ЭтотОбъект, , Отказ);
		
		// Налоговый учет.
		ДатаУчетнойПолитики = ?(ЗначениеЗаполнено(ВидМежотчетногоПериода), КонецГода(Дата) + 1, Дата);
		Если ТипДоговораДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование Тогда
			НепроверяемыеРеквизиты.Добавить("ВидДеятельностиНУ");
			НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
			НепроверяемыеРеквизиты.Добавить("ВидДеятельностиУСН");
		ИначеЕсли НалоговыйУчет.ПлательщикНалогаНаПрибыль(Организация, ДатаУчетнойПолитики) Тогда
			
			ЭтоПрочиеДоходы = БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетДоходовНУ, "Н91.01");
			Если НЕ ЭтоПрочиеДоходы Тогда
				НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
			КонецЕсли;
			НепроверяемыеРеквизиты.Добавить("ВидДеятельностиУСН");
			
		ИначеЕсли УчетУСНВызовСервера.ПрименяетсяУСН(Организация, ДатаУчетнойПолитики) Тогда
			НепроверяемыеРеквизиты.Добавить("ВидДеятельностиНУ");
			НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
			
		Иначе
			НепроверяемыеРеквизиты.Добавить("ВидДеятельностиНУ");
			НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
			НепроверяемыеРеквизиты.Добавить("ВидДеятельностиУСН");
		КонецЕсли;
		
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	// Способ признания расходов "По графику" нельзя использовать при безвозмездном поступлении имущества.
	Если ИзменитьПорядокУчетаДоходов
		И ТипДоговораДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование
		И СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоГрафику Тогда
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
			НСтр("ru = 'Способ признания доходов'"), , ,
			НСтр("ru='Способ ""По графику"" нельзя использовать по договорам безвозмездного пользования.'"));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "СпособПризнанияДоходов", "Объект", Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = ДоходыБудущихПериодов.Итог("ВсегоСправедливая");
	
	Если ВидОперации = Перечисления.ВидыОперацийКорректировкиДБП.ДосрочноеПрекрашение Тогда
		ИзменитьСуммыДоходов = Истина;
		ИзменитьПорядокУчетаДоходов = Ложь;
	КонецЕсли;
	
	Если СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоГрафику
		И ТипДоговораДБП <> Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях Тогда
		ДатаНачалаСписания = Неопределено;
		ДатаОкончанияСписания = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ЗаполнитьДокумент(ЗаполнитьТипДоговора = Истина, ЗаполнитьСуммыДоходов = Истина, ЗаполнитьПорядокУчетаДоходов = Истина) Экспорт
	
	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",  Организация);
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(Дата));
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецМесяца(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Договор",      Договор);
	Запрос.УстановитьПараметр("СчетаДБП",     БухгалтерскийУчет.СписокСчетов("401.40,401.41,401.49"));
	Запрос.УстановитьПараметр("СчетаРБП",     БухгалтерскийУчет.СписокСчетов("401.50"));
	Запрос.УстановитьПараметр("ВидРБП",       Перечисления.ВидыРБП.УпущеннаяВыгодаПоДоговорамАрендыНаЛьготныхУсловиях);
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.РасходыБудущихПериодов);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	Запрос.УстановитьПараметр("ВидыСубконтоРБП", ВидыСубконто);
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	НастройкиСчетовУчетаДБП = УчетДоходовРасходов.НастройкиСчетовУчетаДБП();
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета);
	
	НомераТаблиц = Новый Структура;
	
	Если ЗаполнитьТипДоговора ИЛИ ЗаполнитьПорядокУчетаДоходов Тогда
		
		НомераТаблиц.Вставить("ПараметрыСписанияДоходовБудущихПериодов", НомераТаблиц.Количество());
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПараметрыСписанияДоходовБудущихПериодов.Организация КАК Организация,
		|	ПараметрыСписанияДоходовБудущихПериодов.Договор КАК Договор,
		|	ПараметрыСписанияДоходовБудущихПериодов.ВидОперации КАК ВидОперации,
		|	ПараметрыСписанияДоходовБудущихПериодов.СпособПризнанияДоходов КАК СпособПризнанияДоходов,
		|	ПараметрыСписанияДоходовБудущихПериодов.ДатаНачалаСписания КАК ДатаНачалаСписания,
		|	ПараметрыСписанияДоходовБудущихПериодов.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
		|	ПараметрыСписанияДоходовБудущихПериодов.СчетДоходов КАК СчетДоходов,
		|	ПараметрыСписанияДоходовБудущихПериодов.СубконтоДоходов1 КАК СубконтоДоходов1,
		|	ПараметрыСписанияДоходовБудущихПериодов.СубконтоДоходов2 КАК СубконтоДоходов2,
		|	ПараметрыСписанияДоходовБудущихПериодов.СубконтоДоходов3 КАК СубконтоДоходов3,
		|	ПараметрыСписанияДоходовБудущихПериодов.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
		|	ПараметрыСписанияДоходовБудущихПериодов.СчетДоходовНУ КАК СчетДоходовНУ,
		|	ПараметрыСписанияДоходовБудущихПериодов.СтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ
		|ИЗ
		|	РегистрСведений.ПараметрыСписанияДоходовБудущихПериодов.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И Договор = &Договор) КАК ПараметрыСписанияДоходовБудущихПериодов
		|ГДЕ
		|	НЕ ПараметрыСписанияДоходовБудущихПериодов.ВидОперации ССЫЛКА Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС";
		
	КонецЕсли;
	
	Если ЗаполнитьСуммыДоходов Тогда
		
		ДоходыБудущихПериодов.Очистить();
		ИзменитьСуммыДоходов = Истина;
		
		НомераТаблиц.Вставить("ДоходыБудущихПериодов", НомераТаблиц.Количество());
		НомераТаблиц.Вставить("РасходыПоУпущеннойВыгоде", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначения.РазделительПакетаЗапросов(), "") +
		"ВЫБРАТЬ
		|	ОстаткиДБП.Организация КАК Организация,
		|	ЕСТЬNULL(ОстаткиДБП.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
		|	ОстаткиДБП.КФО КАК КФО,
		|	ОстаткиДБП.КПС КАК КПС,
		|	ОстаткиДБП.КЭК КАК КЭК,
		|	ОстаткиДБП.Счет КАК СчетДБП,
		|	ОстаткиДБП.Подразделение КАК Подразделение,
		|	ВЫРАЗИТЬ(ОстаткиДБП.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ВЫРАЗИТЬ(ОстаткиДБП.Субконто1 КАК Справочник.Номенклатура).Наименование КАК НоменклатураПредставление,
		|	ВЫРАЗИТЬ(ОстаткиДБП.Субконто1 КАК Справочник.Номенклатура).СтавкаНДС КАК СтавкаНДС,
		|	ВЫРАЗИТЬ(ОстаткиДБП.Субконто2 КАК Справочник.Договоры) КАК Договор,
		|	ВЫРАЗИТЬ(ОстаткиДБП.Субконто2 КАК Справочник.Договоры).Наименование КАК ДоговорПредставление,
		|	ВЫРАЗИТЬ(ОстаткиДБП.Субконто2 КАК Справочник.Договоры).Контрагент.Наименование КАК КонтрагентПредставление,
		|	ВЫРАЗИТЬ(ОстаткиДБП.Субконто3 КАК Справочник.ВидыЦелевыхСредств) КАК КодЦели,
		|	ЕСТЬNULL(ОстаткиДБП.Валюта, &ВалютаРеглУчета) КАК Валюта,
		|	ОстаткиДБП.СуммаОстатокКт КАК ОстатокДБП,
		|	ОстаткиДБП.ВалютнаяСуммаОстатокКт КАК ОстатокДБПВВалюте
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&КонецПериода,
		|			Счет В (&СчетаДБП),
		|			,
		|			Организация = &Организация
		|				И &УсловиеИФО
		|				И Субконто2 = &Договор) КАК ОстаткиДБП
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетДБП,
		|	КонтрагентПредставление,
		|	ДоговорПредставление,
		|	НоменклатураПредставление
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУОстатки.Организация КАК Организация,
		|	ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
		|	ЕПСБУОстатки.Подразделение КАК Подразделение,
		|	ЕПСБУОстатки.КФО КАК КФО,
		|	ЕПСБУОстатки.Счет КАК СчетРБППоУпущеннойВыгоде,
		|	ЕПСБУОстатки.КПС КАК КПСРасходовПоУпущеннойВыгоде,
		|	ЕПСБУОстатки.КЭК КАК КЭКРасходовПоУпущеннойВыгоде,
		|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.РасходыБудущихПериодов) КАК СтатьяРасходовПоУпущеннойВыгоде,
		|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.РасходыБудущихПериодов).ВидРБП КАК ВидРБП,
		|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
		|	ЕПСБУОстатки.СуммаОстатокДт КАК ОстатокРасходовПоУпущеннойВыгоде
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&КонецПериода,
		|			Счет В (&СчетаРБП),
		|			&ВидыСубконтоРБП,
		|			Организация = &Организация
		|				И &УсловиеИФО
		|				И Субконто2 = &Договор) КАК ЕПСБУОстатки
		|ГДЕ
		|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.РасходыБудущихПериодов).ВидРБП = &ВидРБП";
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ИФО) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
			Запрос.УстановитьПараметр("ИФО", ИФО);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	Если ЗаполнитьТипДоговора ИЛИ ЗаполнитьПорядокУчетаДоходов Тогда
		
		// Заполним реквизиты шапки по параметрам списания ДБП, установленных для договора.
		ПараметрыСписанияДоходовБудущихПериодов = Результат[НомераТаблиц.ПараметрыСписанияДоходовБудущихПериодов].Выбрать();
		Если ПараметрыСписанияДоходовБудущихПериодов.Следующий() Тогда
			
			Если ЗаполнитьТипДоговора Тогда
				ТипДоговораДБП = ПараметрыСписанияДоходовБудущихПериодов.ВидОперации;
			КонецЕсли;
			
			Если ЗаполнитьПорядокУчетаДоходов Тогда
				ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыСписанияДоходовБудущихПериодов,
					"СпособПризнанияДоходов,ДатаНачалаСписания,ДатаОкончанияСписания,
					|СчетДоходов,СубконтоДоходов1,СубконтоДоходов2,СубконтоДоходов3,
					|ВидДеятельностиНУ,СчетДоходовНУ,СтатьяПрочихДоходовНУ");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗаполнитьСуммыДоходов Тогда
		
		ДатаУчетнойПолитики = ?(ЗначениеЗаполнено(ВидМежотчетногоПериода), КонецГода(Дата) + 1, Дата);
		
		ВедетсяУчетДБППоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
			И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("401.40").УчетПоПодразделениям;
		
		// Распределим остатки расходов по упущенной выгоде по аналитике ДБП.
		ТаблицаОстатковДБП = Результат[НомераТаблиц.ДоходыБудущихПериодов].Выгрузить();
		РасходыПоУпущеннойВыгоде = Результат[НомераТаблиц.РасходыПоУпущеннойВыгоде].Выгрузить();
		ТаблицаОстатковДБП.Колонки.Добавить("СчетРБППоУпущеннойВыгоде",        Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ТаблицаОстатковДБП.Колонки.Добавить("СтатьяРасходовПоУпущеннойВыгоде", Новый ОписаниеТипов("СправочникСсылка.РасходыБудущихПериодов"));
		ТаблицаОстатковДБП.Колонки.Добавить("КПСРасходовПоУпущеннойВыгоде",    Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ТаблицаОстатковДБП.Колонки.Добавить("КЭКРасходовПоУпущеннойВыгоде",    Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
		ТаблицаОстатковДБП.Колонки.Добавить("ОстатокРасходовПоУпущеннойВыгоде",
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
		Для Каждого ОстатокРБП Из РасходыПоУпущеннойВыгоде Цикл
			
			СвойстваСчетаРБП = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ОстатокРБП.СчетРБППоУпущеннойВыгоде);
			
			ОтборДБП = ?(ВедетсяУчетДБППоПодразделениям И СвойстваСчетаРБП.УчетПоПодразделениям,
				Новый Структура("ИФО,КФО,Подразделение,Договор"),
				Новый Структура("ИФО,КФО,Договор"));
			ЗаполнитьЗначенияСвойств(ОтборДБП, ОстатокРБП);
			НайденныеСтрокиДБП = ТаблицаОстатковДБП.НайтиСтроки(ОтборДБП);
			
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(ОстатокРБП.ОстатокРасходовПоУпущеннойВыгоде,
				НайденныеСтрокиДБП, "ОстатокРасходовПоУпущеннойВыгоде", "ОстатокДБП", Ложь);
			
			Для Каждого СтрокаДБП Из НайденныеСтрокиДБП Цикл
				ЗаполнитьЗначенияСвойств(СтрокаДБП, ОстатокРБП,
					"СчетРБППоУпущеннойВыгоде,СтатьяРасходовПоУпущеннойВыгоде,КПСРасходовПоУпущеннойВыгоде,КЭКРасходовПоУпущеннойВыгоде");
			КонецЦикла;
			
		КонецЦикла;
		
		// Расчет сумм доходов будущих периодов.
		Для Каждого ОстаткиДБП Из ТаблицаОстатковДБП Цикл
			
			НоваяСтрока = ДоходыБудущихПериодов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстаткиДБП);
			
			Если ИспользоватьВалютныйУчет
				И НастройкиСчетовУчетаДБП[ОстаткиДБП.СчетДБП].Валютный
				И ЗначениеЗаполнено(ОстаткиДБП.Валюта)
				И ОстаткиДБП.Валюта <> ВалютаРегламентированногоУчета Тогда
				Если ВидОперации = Перечисления.ВидыОперацийКорректировкиДБП.ДосрочноеПрекрашение Тогда
					НоваяСтрока.ВсегоСправедливая = (-1) * ОстаткиДБП.ОстатокДБПВВалюте;
				Иначе // КорректировкаДоходовБудущихПериодов
					НоваяСтрока.ВсегоСправедливая = 0;
				КонецЕсли;
				НоваяСтрока.Всего = НоваяСтрока.ВсегоСправедливая;  // Льготная аренда с признанием расходов по упущенной выгоде возможна только в рублях.
			Иначе // В рублях.
				Если ВидОперации = Перечисления.ВидыОперацийКорректировкиДБП.ДосрочноеПрекрашение Тогда
					НоваяСтрока.ВсегоСправедливая              = (-1) * ОстаткиДБП.ОстатокДБП;
					НоваяСтрока.СуммаРасходовПоУпущеннойВыгоде = (-1) * ОстаткиДБП.ОстатокРасходовПоУпущеннойВыгоде;
				Иначе // КорректировкаДоходовБудущихПериодов
					НоваяСтрока.ВсегоСправедливая              = 0;
					НоваяСтрока.СуммаРасходовПоУпущеннойВыгоде = 0;
				КонецЕсли;
				НоваяСтрока.Всего = НоваяСтрока.ВсегоСправедливая - НоваяСтрока.СуммаРасходовПоУпущеннойВыгоде;
			КонецЕсли;
			
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
				НоваяСтрока.КЭК, "205.00,209.00",, ДатаУчетнойПолитики, Организация, ИФО);
			
			ПараметрыДопСубконтоРасчетов = УчетРасчетов.ПараметрыДопСубконтоРасчетов(НоваяСтрока.СчетРасчетов);
			Если ЗначениеЗаполнено(ПараметрыДопСубконтоРасчетов.ВидСубконто)
				И ПараметрыДопСубконтоРасчетов.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ВидыЦелевыхСредств Тогда
				НоваяСтрока.ДопСубконтоРасчетов = ОстаткиДБП.КодЦели;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
