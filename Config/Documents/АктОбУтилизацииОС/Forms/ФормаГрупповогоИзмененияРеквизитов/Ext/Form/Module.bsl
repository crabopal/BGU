#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИменаСлужебныхСвойствРеквизитов.Добавить("НачальноеЗначение");
	ИменаСлужебныхСвойствРеквизитов.Добавить("Синоним");
	ИменаСлужебныхСвойствРеквизитов.Добавить("ОписаниеТипов");
	
	СвойстваРеквизитов = Параметры.СвойстваРеквизитов; 
	УправлениеНФА.ЗаполнитьСвойстваРеквизитов(СвойстваРеквизитов, Параметры.ИмяДокумента, Параметры.ИмяТЧ);
	ЗаполнитьСтрокиТаблицы(СвойстваРеквизитов);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаРеквизитов

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	СвойстваРеквизита = Неопределено;
	Если НЕ СвойстваРеквизитов.Свойство(ТекущиеДанные.ИмяРеквизита, СвойстваРеквизита) Тогда
		Возврат;
	ИначеЕсли ТипЗнч(СвойстваРеквизита) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;	

	ЕстьДопСвойства	= Ложь;
	Для каждого Свойство из СвойстваРеквизита Цикл
		Если ИменаСлужебныхСвойствРеквизитов.НайтиПоЗначению(Свойство.Ключ) = Неопределено Тогда
			ЕстьДопСвойства	= Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;	     
	
	Если НЕ ЕстьДопСвойства Тогда
		Возврат;
	КонецЕсли;	
	
	// Из исходного типа нужно удалить все простые типы, которые не могут использовать форму выбора
	ПроверяемыйТип = Новый ОписаниеТипов(СвойстваРеквизита.ОписаниеТипов, , "Дата, Строка, Число, Булево");
	ТипРеквизита = ?(ПроверяемыйТип.Типы().Количество() = 1, ПроверяемыйТип.Типы()[0], Неопределено);
	
	ПараметрыФормы = Новый Структура;
	
	Если ТипРеквизита = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		Если СвойстваРеквизита.Свойство("Счета") Тогда
			НаДату = Неопределено;
			Если НЕ СвойстваРеквизита.Свойство("Дата", НаДату) Тогда
				НаДату = ОбщегоНазначенияКлиент.ДатаСеанса();
			КонецЕсли;	

			ВИерархии = Неопределено;
			Если НЕ СвойстваРеквизита.Свойство("ВИерархии", ВИерархии) Тогда
				ВИерархии = Истина;
			КонецЕсли;	

			Если ТипЗнч(СвойстваРеквизита.Счета) = Тип("Строка") Тогда
				СпСчетов = СписокСчетов(СвойстваРеквизита.Счета, НаДату, ВИерархии); 
			Иначе	
				СпСчетов = СвойстваРеквизита.Счета; 
			КонецЕсли;	

			ПараметрыФормы.Вставить("ОграниченияСписокСчетов", СпСчетов);
			ПараметрыФормы.Вставить("ВидСравненияВСписке",     Истина);
			ПараметрыФормы.Вставить("НаДату",                  НаДату);
			ПараметрыФормы.Вставить("ТекущаяСтрока", ТекущиеДанные.ЗначениеРеквизита);
			ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Элемент);
			СтандартнаяОбработка = Ложь;
		КонецЕсли;	       
	ИначеЕсли СвойстваРеквизита.Свойство("СписокВыбора") Тогда	  
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = СвойстваРеквизита.СписокВыбора;
	Иначе // Если отбор по свойствам  
		ИмяФормы1 = Строка_ПараметрыФормыВыбора(ТипРеквизита, СвойстваРеквизита, ИменаСлужебныхСвойствРеквизитов, ПараметрыФормы);
		Если ЗначениеЗаполнено(ИмяФормы1) Тогда
			ОткрытьФорму(ИмяФормы1, ПараметрыФормы, Элемент);
			СтандартнаяОбработка = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	ТекущиеДанные.ИзменятьРеквизит = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовЗначениеРеквизитаАвтоПодбор(Элемент, Текст, ДанныеВыбора, Параметры, Ожидание, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ТаблицаРеквизитов.ТекущиеДанные;
	Если ТекущиеДанные.ИмяРеквизита = "СпособУтилизации" Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.ЗагрузитьЗначения(УправлениеНФАКлиентСервер.СпособыУтилизацииИмущества());
	ИначеЕсли ТекущиеДанные.СписокВыбора.Количество() <> 0 Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.ЗагрузитьЗначения(ТекущиеДанные.СписокВыбора.ВыгрузитьЗначения());
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ВозвращаемоеЗначение = Новый Структура;
	Для каждого СтрокаТаблицы Из ТаблицаРеквизитов Цикл
	
		Если СтрокаТаблицы.ИзменятьРеквизит Тогда
			ВозвращаемоеЗначение.Вставить(СтрокаТаблицы.ИмяРеквизита, СтрокаТаблицы.ЗначениеРеквизита);
			Если ТипЗнч(СтрокаТаблицы.ЗначениеРеквизита) = Тип("СправочникСсылка.Контрагенты") Тогда
				ВозвращаемоеЗначение.Вставить("ИдентификаторКонтрагента", ИдентификаторКонтрагента(СтрокаТаблицы.ЗначениеРеквизита));
			КонецЕсли;	
		КонецЕсли;
	
	КонецЦикла;
	ОповеститьОВыборе(ВозвращаемоеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ИдентификаторКонтрагента(Контрагент)
	Возврат БухгалтерскийУчет.ИдентификаторКонтрагента(Контрагент);
КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокиТаблицы(СвойстваРеквизитов)
	Для каждого ТекЭлемент из СвойстваРеквизитов Цикл
		НоваяСтрока                        = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.ИмяРеквизита           = ТекЭлемент.Ключ;
		НоваяСтрока.ТипРеквизита           = ТекЭлемент.Значение.ОписаниеТипов;
		НоваяСтрока.ПредставлениеРеквизита = ТекЭлемент.Значение.Синоним;
		НоваяСтрока.ЗначениеРеквизита      = ТекЭлемент.Значение.НачальноеЗначение;
		Если ТекЭлемент.Значение.Свойство("СписокВыбора") Тогда
			НоваяСтрока.СписокВыбора = ТекЭлемент.Значение.СписокВыбора.Скопировать();
		КонецЕсли;	
	КонецЦикла;	             
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокСчетов(СтрокаСчетов, НаДату, ВИерархии)
	Возврат БухгалтерскийУчет.СписокСчетов(СтрокаСчетов, НаДату, НЕ ВИерархии);
КонецФункции

&НаСервереБезКонтекста
Функция Строка_ПараметрыФормыВыбора(ТипРеквизита, СвойстваРеквизита, ИменаСлужебныхСвойствРеквизитов, ПараметрыФормы)
	ИмяФормы1 = "";       
	ОбъектМетаданных = Неопределено;
	Если ЗначениеЗаполнено(ТипРеквизита) Тогда
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипРеквизита);
	КонецЕсли;	
	Если ОбъектМетаданных <> Неопределено И Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		ИмяФормы1 = "Справочник." + ОбъектМетаданных.Имя + ".ФормаВыбора";

		Отбор = Новый Структура;
		Для каждого Свойство из СвойстваРеквизита Цикл
			Если ИменаСлужебныхСвойствРеквизитов.НайтиПоЗначению(Свойство.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;	
			ОбъектМетаданныхЗначения = Метаданные.НайтиПоТипу(ТипЗнч(Свойство.Значение));
			
			Если ОбъектМетаданныхЗначения <> Неопределено 
				И ТипЗнч(ОбъектМетаданныхЗначения) = Тип("ОбъектМетаданных")
				И ОбъектМетаданных.Владельцы.Содержит(ОбъектМетаданныхЗначения) Тогда
				Отбор.Вставить("Владелец", Свойство.Значение);
			Иначе	
				Отбор.Вставить(Свойство.Ключ, Свойство.Значение);
			КонецЕсли;	
		КонецЦикла;	 
		
		Если ЗначениеЗаполнено(Отбор) Тогда
			ПараметрыФормы.Вставить("Отбор", Отбор);
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат ИмяФормы1;
КонецФункции

#КонецОбласти

