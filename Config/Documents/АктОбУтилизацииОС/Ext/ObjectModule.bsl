#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

// Возвращает таблицу значений по данным табличной части документа для формирования режерва
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу()
Функция ТаблицаСписанияОСПоДокументу() Экспорт
	Возврат ТаблицаСписанияОС();
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	НепроверяемыеРеквизиты.Добавить("ОсновныеСредства.СтранаПроисхождения");
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	ПрослеживаемостьБГУ.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, "ОсновныеСредства");
	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ПрослеживаемостьБГУ.УдалитьНеиспользуемыеСтрокиСведенийПрослеживаемости(ЭтотОбъект, "ОсновныеСредства");
	ПрослеживаемостьБГУ.СписаниеОСПриЗаписи(ЭтотОбъект, Отказ, РежимЗаписи);
	ОбщегоНазначенияБГУ.ЗаполнитьИдентификаторыСтрок(ПолученныеМатериалы, Ложь);

	ЕстьОшибки = Ложь;
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения И НЕ ПометкаУдаления Тогда 
		ЕстьОшибки = ЕстьПроблемыСписания();
		Если ЕстьОшибки Тогда
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;		
	Если НЕ ЕстьОшибки Тогда
		УправлениеОсновнымиСредствами.ДокументПередЗаписью(ЭтотОбъект, РежимЗаписи, Отказ);
	КонецЕсли;		
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	Если НЕ Резервировать Тогда
		ПрослеживаемостьБГУ.ОбработкаПроведения(ЭтотОбъект);
	КонецЕсли;	

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ГолосованиеЗаПолученныеМатериалы = Истина;
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	ГолосованиеЗаПолученныеМатериалы = Истина;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	
	ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА, ИнвНомер");
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ИнвНомер");
	ОбъектыДМ.Свернуть("ОбъектНФА, ИнвНомер");
	
	ТаблицаВсехОбъектов = ОсновныеСредства.Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер");
	
	ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
	ТаблицаОбъектовНФА.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовНФА.Колонки.Добавить("ИнвентарныйНомер",Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	
	МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляОС();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;
	
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		ОбъектНФА = ТекСтрока.ОбъектНФА;
		ИнвНомер = ТекСтрока.ИнвНомер;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОсновноеСредство", ОбъектНФА);
		ПараметрыОтбора.Вставить("ИнвентарныйНомер", ИнвНомер);
		НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			ПараметрыОтбораОбъекта = Новый Структура;
			ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
			ПараметрыОтбораОбъекта.Вставить("ИнвНомер", ИнвНомер);
			СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
			Если СтрокиСпискаДМ.Количество()=1 Тогда
				ТекстСтрокиДМ = "В строке ";
			Иначе
				ТекстСтрокиДМ = "В строках ";
			КонецЕсли;
			Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
				ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
			КонецЦикла;
			
			ТекстОшибки = НСтр("ru='"+Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2)+" списка ""Содержание драг. материалов"" указана информация по объекту ОС, которого нет в списке ""Основные средства"": %1'")+?(ЗначениеЗаполнено(ИнвНомер),НСтр("ru=' (инв.№: %2)'"),НСтр("ru='%2'"));
			ТекстОшибки = СтрШаблон(ТекстОшибки, ОбъектНФА, ИнвНомер);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			
		КонецЕсли;
	КонецЦикла;
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		// заполнение количества драг. камней
		Если Не (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни) И (ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1""'");
			ТекстОшибки = СтрШаблон(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
	
	// контроль содержания учетных драг. материалов в списываемых НФА
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Организация КАК Организация,
	|	ДрагМатериалыДокумента.ОбъектНФА КАК ОбъектНФА,
	|	ДрагМатериалыДокумента.ИнвНомер КАК ИнвНомер,
	|	ДрагМатериалыДокумента.МассаДМ КАК МассаДМ,
	|	ДрагМатериалыДокумента.КоличествоДМ КАК КоличествоДМ
	|ПОМЕСТИТЬ ДрагМатериалыДокумента
	|ИЗ
	|	&ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Организация КАК Организация,
	|	ОбъектыДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ОбъектыДокумента.ИнвентарныйНомер КАК ИнвНомер
	|ПОМЕСТИТЬ ОбъектыДокумента
	|ИЗ
	|	&ОбъектыДокумента КАК ОбъектыДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОбъектыНФАДокумента.Организация КАК Организация,
	|	ОбъектыНФАДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ОбъектыНФАДокумента.ИнвНомер КАК ИнвНомер,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ДрагМатериалыДокумента.МассаДМ, 0) = 0
	|				И ЕСТЬNULL(ДрагМатериалыДокумента.КоличествоДМ, 0) = 0
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьДрагМатериалы
	|ПОМЕСТИТЬ ОбъектыНФАДокумента
	|ИЗ
	|	ОбъектыДокумента КАК ОбъектыНФАДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
	|		ПО ОбъектыНФАДокумента.Организация = ДрагМатериалыДокумента.Организация
	|			И ОбъектыНФАДокумента.ОсновноеСредство = ДрагМатериалыДокумента.ОбъектНФА
	|			И ОбъектыНФАДокумента.ИнвНомер = ДрагМатериалыДокумента.ИнвНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК ОбъектНФА,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер КАК ИнвНомер,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток КАК МассаДМОстаток,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток КАК КоличествоДМОстаток,
	|	ОбъектыНФАДокумента.ЕстьДрагМатериалы КАК ЕстьДрагМатериалы
	|ИЗ
	|	ОбъектыНФАДокумента КАК ОбъектыНФАДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&ДатаСведений, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
	|		ПО (НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА = ОбъектыНФАДокумента.ОсновноеСредство)
	|			И (НаличиеДрагМатериаловВОбъектахНФАОстатки.Организация = ОбъектыНФАДокумента.Организация)
	|			И (НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер = ОбъектыНФАДокумента.ИнвНомер)
	|ГДЕ
	|	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА, 0) <> 0
	|	И ОбъектыНФАДокумента.ЕстьДрагМатериалы = ЛОЖЬ";
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ИнвНомер, МассаДМ, КоличествоДМ");
	ТаблицаОбъектовНФА = ОсновныеСредства.Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер");
	
	Запрос.УстановитьПараметр("ДрагМатериалыДокумента", ОбъектыДМ);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОбъектыДокумента", ТаблицаОбъектовНФА);
	Запрос.УстановитьПараметр("ДатаСведений", Новый Граница(Дата, ВидГраницы.Включая));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстОшибки = НСтр("ru = 'Для объекта ""%1"" (Инв. № %2) из списка ""Основные средства"" в учете присутствуют остатки драгоценных материалов. Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, Выборка.ОбъектНФА, Выборка.ИнвНомер);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект");
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаСписанияОС()
	ТаблицаДока = УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу();	
	
	СчетНеАктивов = БухгалтерскийУчет.СчетПоКоду("02.3", Дата, Организация);
	МассивСчетов = Новый Массив;
	МассивСчетов.Добавить(СчетНеАктивов);
	ТабСчетов = УправлениеОсновнымиСредствами.СвойстваСчетовДляКонтроляСписанияОС(МассивСчетов);
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	Для каждого СтрокаТЧ из ОсновныеСредства Цикл
		НоваяСтрока = ТаблицаДока.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, 
			"ОсновноеСредство, ИнвентарныйНомер, КФО, Количество, Сумма, НомерСтроки");
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтотОбъект, "Организация, ЦМО");

		НоваяСтрока.ПередачаЧастейОбъектов = Ложь;
		НоваяСтрока.СчетУчета = СчетНеАктивов;
			
		СтрокаСчета = ТабСчетов.Найти(СчетНеАктивов, "Счет");
		Если СтрокаСчета.УчетПоПодразделениям И УчетПоПодразделениям Тогда
			НоваяСтрока.Подразделение = Подразделение;
		КонецЕсли;	
		Если УчетПоИФО Тогда
			НоваяСтрока.ИФО = ИФО;
		КонецЕсли;	
	КонецЦикла;
		
	Возврат ТаблицаДока;	
КонецФункции	

Функция ЕстьПроблемыСписания()
	ЕстьОшибки = Ложь;

	ТаблицаДока = ТаблицаСписанияОС();

	ЕстьОшибки = УправлениеОсновнымиСредствами.ЕстьПроблемыСписания_ОстаткиРезервыОбременения(
		ТаблицаДока, ЭтотОбъект, Ложь);
	
	Возврат ЕстьОшибки;
КонецФункции		
	
#КонецОбласти

#КонецЕсли