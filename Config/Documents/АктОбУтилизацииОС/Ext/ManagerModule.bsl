#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы.
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("ОсновноеСредство");
	ИменаРеквизитов.Добавить("ИнвентарныйНомер");
	ИменаРеквизитов.Добавить("КФО");
	ИменаРеквизитов.Добавить("Сумма");
	ИменаРеквизитов.Добавить("Количество");
	Результат.Вставить("ОсновныеСредства", ИменаРеквизитов);
	Возврат Результат;
КонецФункции

// Параметры:
//  КомандыОтчетов - см. ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов.КомандыОтчетов
//  Параметры - см. ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов.Параметры
//
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	//При выбытии ОС с прослеживаемыми товарами таблицы движений готовятся раньше
	Если СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыДокумента	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Номер, Резервировать");

	Если РеквизитыДокумента.Резервировать Тогда
		Возврат;
	КонецЕсли;
	
	НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, РеквизитыДокумента.Номер);
	
	УчетПодр = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("02").УчетПоПодразделениям;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"					, ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента"			, НСтр("ru = 'Акт об утилизации (уничтожении) материальных ценностей'"));
	Запрос.УстановитьПараметр("НомерДокумента"			, НомерДокумента);
	Запрос.УстановитьПараметр("УчетПоПодразделениям"	, УчетПодр);
	Запрос.УстановитьПараметр("Одобренные"				, ОбщегоНазначенияБГУ.ОдобренныеОбъектыГолосования(ДокументСсылка));
	
	ТаблицыЗапроса = Новый Массив;
	
	ТаблицыЗапроса.Добавить("ТЧДокумента");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении) КАК ВидРаспоряжения,
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ОсновныеСредства.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ОсновныеСредства.Ссылка.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ОсновныеСредства.Ссылка.ЦМО КАК ЦМО,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.Количество КАК Количество,
	|	ОсновныеСредства.Сумма КАК Стоимость,
	|	&ИмяДокумента КАК НазваниеДокумента,
	|	&НомерДокумента КАК НомерДокумента,
	|	ОсновныеСредства.Ссылка.Дата КАК ДатаДокумента,
	|	ОсновныеСредства.РезолюцияКомиссии КАК РезолюцияКомиссии,
	|	ОсновныеСредства.ПричинаСписания КАК ПричинаСписания
	|ПОМЕСТИТЬ ТЧДокумента
	|ИЗ
	|	Документ.АктОбУтилизацииОС.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ОсновныеСредства.Ссылка)
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И (ОсновныеСредства.Ссылка.ГолосованиеЗаПолученныеМатериалы
	|			ИЛИ ОсновныеСредства.ИдентификаторСтроки В (&Одобренные))";
	
	ТаблицыЗапроса.Добавить("СтоимостьОбъектовОСПоКонтрагентам");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ТЧДокумента.ВидДвижения,
	|	ТЧДокумента.ВидРаспоряжения,
	|	ТЧДокумента.Период КАК Период,
	|	ТЧДокумента.Организация КАК Организация,
	|	ТЧДокумента.Подразделение КАК Подразделение,
	|	ТЧДокумента.ЦМО КАК ЦМО,
	|	ТЧДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТЧДокумента.Количество КАК Количество,
	|	ТЧДокумента.Стоимость КАК Стоимость,
	|	ТЧДокумента.НазваниеДокумента КАК НазваниеДокумента,
	|	ТЧДокумента.НомерДокумента КАК НомерДокумента,
	|	ТЧДокумента.ДатаДокумента КАК ДатаДокумента,
	|	ТЧДокумента.ПричинаСписания КАК Причина
	|ИЗ
	|	ТЧДокумента КАК ТЧДокумента";
	
	ТаблицыЗапроса.Добавить("СобытияОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ТЧДокумента.Период КАК Период,
	|	ТЧДокумента.Организация КАК Организация,
	|	ТЧДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧДокумента.ИнвентарныйНомер КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание) КАК Событие,
	|	ТЧДокумента.Период КАК ДатаСобытия,
	//	|	ТЧДокумента.РезолюцияКомиссии КАК ПричинаСписания,
	|	ТЧДокумента.ПричинаСписания КАК ПричинаСписания,
	|	ТЧДокумента.НазваниеДокумента КАК НазваниеДокумента,
	|	ТЧДокумента.НомерДокумента КАК НомерДокумента,
	|	ТЧДокумента.ДатаДокумента КАК ДатаДокумента
	|ИЗ
	|	ТЧДокумента КАК ТЧДокумента";
	
	ТаблицыЗапроса.Добавить("");
	
	ТаблицыЗапроса.Добавить("НаличиеДрагМатериаловВОбъектахНФА");
	ТаблицыЗапроса.Добавить("НаличиеДрагМатериаловВЛомеИОтходах");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ДрагоценныеМатериалы.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	ДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	|	ДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации,
	|	ДрагоценныеМатериалы.Ссылка.НоменклатураЛома КАК НоменклатураЛома,
	|	ДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	|	ДрагоценныеМатериалы.ОбъектНФА КАК ОбъектНФА,
	|	ДрагоценныеМатериалы.ИнвНомер КАК ИнвНомер,
	|	ДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	|	ДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	|	ДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	|	ДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	|	ДрагоценныеМатериалы.ЛигатурнаяМассаЛома КАК ЛигатурнаяМассаЛома,
	|	ДрагоценныеМатериалы.ИсточникОбразования КАК ИсточникОбразования,
	|	&ИмяДокумента КАК ИмяДокумента,
	|	&НомерДокумента КАК НомерДокумента
	|ПОМЕСТИТЬ ВТ_ДМ
	|ИЗ
	|	Документ.АктОбУтилизацииОС.ДрагоценныеМатериалы КАК ДрагоценныеМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ДрагоценныеМатериалы.Ссылка)
	|ГДЕ
	|	ДрагоценныеМатериалы.Ссылка = &Ссылка
	|	И ДрагоценныеМатериалы.МассаДМ > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДМ.Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ВТ_ДМ.Организация КАК Организация,
	|	ВТ_ДМ.ОбъектНФА КАК ОбъектНФА,
	|	ВТ_ДМ.ИнвНомер КАК ИнвНомер,
	|	ВТ_ДМ.ВидДрагМатериала КАК ВидДрагМатериала,
	|	ВТ_ДМ.ЕдИзм КАК ЕдИзм,
	|	ВТ_ДМ.МассаДМ КАК МассаДМ,
	|	ВТ_ДМ.КоличествоДМ КАК КоличествоДМ,
	|	ВТ_ДМ.АналитикаОперации КАК АналитикаОперации,
	|	ВТ_ДМ.ИмяДокумента КАК Основание,
	|	ВТ_ДМ.НомерДокумента КАК НомерОснования,
	|	ВТ_ДМ.Период КАК ДатаОснования,
	|	ИСТИНА КАК ЭтоСписание
	|ИЗ
	|	ВТ_ДМ КАК ВТ_ДМ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_ДМ.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДМ.Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ВТ_ДМ.Организация КАК Организация,
	|	ВТ_ДМ.НоменклатураЛома КАК ОбъектНФА,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ЛомДМ) КАК ВидОбъекта,
	|	ВТ_ДМ.ИсточникОбразования КАК ИсточникОбразования,
	|	ВТ_ДМ.ВидДрагМатериала КАК ВидДрагМатериала,
	|	ВТ_ДМ.ЕдИзм КАК ЕдИзм,
	|	ВТ_ДМ.МассаДМ КАК ЧистаяМасса,
	|	ВТ_ДМ.ЛигатурнаяМассаЛома КАК ЛигатурнаяМасса,
	|	ВТ_ДМ.ИмяДокумента КАК Основание,
	|	ВТ_ДМ.НомерДокумента КАК НомерОснования,
	|	ВТ_ДМ.Период КАК ДатаОснования
	|ИЗ
	|	ВТ_ДМ КАК ВТ_ДМ
	|ГДЕ
	|	ВТ_ДМ.НоменклатураЛома <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_ДМ.НомерСтроки";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
КонецПроцедуры

#КонецОбласти

#Область ГолосованиеКомиссиии

// Заполнить результат голосования.
// 
// Параметры:
//  Форма - см. Документ.АктОбУтилизацииОС.Форма.ФормаДокумента
Процедура ЗаполнитьРезультатГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	ЗаполнитьРезультатыГолосования = Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	Если ЗаполнитьРезультатыГолосования Тогда
		РезультатГолосованияСотрудника = ОбщегоНазначенияБГУ.РезультатыГолосованияСотрудникаПоДокументу(
			Форма.Сотрудник, Объект.Ссылка, Объект.Комиссия, Объект.Организация);
		РезультатГолосованияКомиссии = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(
			Объект.Ссылка, Объект.Комиссия, Объект.Организация);
	КонецЕсли;
	
	Если Объект.ГолосованиеЗаПолученныеМатериалы Тогда
		ОбрабатываемаяТаблица = Объект.ПолученныеМатериалы;
	Иначе
		ОбрабатываемаяТаблица = Объект.ОсновныеСредства;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ОбрабатываемаяТаблица Цикл
		
		СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Неопределено;
		СтрокаТаблицы.ИтогГолосования = 0;
		СтрокаТаблицы.РезолюцияКомиссииОдобрена = Ложь;
		Если ЗаполнитьРезультатыГолосования Тогда
			
			Если РезультатГолосованияСотрудника.Количество() > 0 Тогда
				Результаты = РезультатГолосованияСотрудника.Найти(СтрокаТаблицы.ИдентификаторСтроки, "ИдентификаторСтроки");
				Если Результаты <> Неопределено Тогда
					СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Результаты.РезультатГолосования;
				КонецЕсли;
			КонецЕсли;
			
			Если РезультатГолосованияКомиссии.Количество() > 0 Тогда
				ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки",
					Объект.Ссылка, СтрокаТаблицы.ИдентификаторСтроки);
				РезультатыГолосованияПоСтроке = РезультатГолосованияКомиссии.НайтиСтроки(ОтборПоИдентификаторуСтроки);
				Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
					СтрокаТаблицы.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
					СтрокаТаблицы.РезолюцияКомиссииОдобрена = РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УправлениеЭлементамиГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ДоступностьГолосования = Не Объект.Ссылка.Пустая() И Не Объект.Проведен
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
		
	ПараметрыВидимости = УправлениеНФАКлиентСервер.ПараметрыУправленияЭлементамиГолосования();
	ПараметрыВидимости.ДоступностьГолосования = ДоступностьГолосования;
	ПараметрыВидимости.ИспользуемыеИмена = ИменаЭлементовГолосования();
	ПараметрыВидимости.Модифицированность = Форма.РешениеСотрудникаМодифицированность;
	ПараметрыВидимости.Сотрудник = Форма.Сотрудник;
	ПараметрыВидимости.УправляющийРеквизит = Объект.ГолосованиеЗаПолученныеМатериалы;
	УправлениеНФАКлиентСервер.УправлениеЭлементамиГолосования(Форма, ПараметрыВидимости);
	
КонецПроцедуры

Функция ИменаЭлементовГолосования()
	Результат = Новый Структура;
	Результат.Вставить("Сотрудник",
		НовыйСоответствие(Ложь, "Сотрудник1", Истина, "Сотрудник"));
	Результат.Вставить("ЕдиногласноЗаВоВсехСтроках",
		НовыйСоответствие(Ложь, "ОсновныеСредстваУстановитьРешениеЕдиногласноЗаВоВсехСтроках",
						Истина, "ПолученныеМатериалыУстановитьРешениеЕдиногласноЗаВоВсехСтроках"));
	Результат.Вставить("ЕдиногласноПротивВоВсехСтроках",
		НовыйСоответствие(Ложь, "ОсновныеСредстваУстановитьРешениеЕдиногласноПротивВоВсехСтроках",
						Истина, "ПолученныеМатериалыУстановитьРешениеЕдиногласноПротивВоВсехСтроках"));
	Результат.Вставить("ЗаВоВсехСтроках",
		НовыйСоответствие(Ложь, "ОсновныеСредстваУстановитьРешениеЗаВоВсехСтроках",
						Истина, "ПолученныеМатериалыУстановитьРешениеЗаВоВсехСтроках"));
	Результат.Вставить("ПротивВоВсехСтроках",
		НовыйСоответствие(Ложь, "ОсновныеСредстваУстановитьРешениеПротивВоВсехСтроках",
						Истина, "ПолученныеМатериалыУстановитьРешениеПротивВоВсехСтроках"));
	Результат.Вставить("ЗаВВыделенныхСтроках",
		НовыйСоответствие(Ложь, "ОсновныеСредстваУстановитьРешениеЗаВВыделенныхСтроках",
						Истина, "ПолученныеМатериалыУстановитьРешениеЗаВВыделенныхСтроках"));
	Результат.Вставить("ПротивВВыделенныхСтроках",
		НовыйСоответствие(Ложь, "ОсновныеСредстваУстановитьРешениеПротивВВыделенныхСтроках",
						Истина, "ПолученныеМатериалыУстановитьРешениеПротивВВыделенныхСтроках"));
	Результат.Вставить("РешениеСотрудника",
		НовыйСоответствие(Ложь, "ОсновныеСредстваРешениеСотрудникаПоРезолюции",
						Истина, "ПолученныеМатериалыРешениеСотрудникаПоРезолюции"));
	Результат.Вставить("СохранитьРезультаты",
		НовыйСоответствие(Ложь, "СохранитьРезультатыГолосования1",
						Истина, "СохранитьРезультатыГолосования"));
	Результат.Вставить("ИтогГолосования",
		НовыйСоответствие(Ложь, "ОсновныеСредстваИтогГолосования",
						Истина, "ПолученныеМатериалыИтогГолосования"));
	Результат.Вставить("РезолюцияОдобрена",
		НовыйСоответствие(Ложь, "ОсновныеСредстваРезолюцияКомиссииОдобрена",
						Истина, "ПолученныеМатериалыРезолюцияКомиссииОдобрена"));
	Результат.Вставить("НадписьФайл",
		НовыйСоответствие(Ложь, "НадписьФайл1",
						Истина, "НадписьФайл"));
	Результат.Вставить("НадписьФайлНеВыбран",
		НовыйСоответствие(Ложь, "НадписьФайлНеВыбран1",
						Истина, "НадписьФайлНеВыбран"));
	Результат.Вставить("НадписьУдалитьФайл",
		НовыйСоответствие(Ложь, "НадписьУдалитьФайл1",
						Истина, "НадписьУдалитьФайл"));
	Результат.Вставить("ФайлСотрудника",
		НовыйСоответствие(Ложь, "ФайлСотрудника1",
						Истина, "ФайлСотрудника"));
	Результат.Вставить("НадписьГолосование",
		НовыйСоответствие(Ложь, "НадписьГолосование1",
						Истина, "НадписьГолосование"));
		
	Возврат Результат;
КонецФункции

Функция НовыйСоответствие(Ключ1, Значение1, Ключ2, Значение2)
	Результат = Новый Соответствие;
	Результат.Вставить(Ключ1, Значение1);
	Результат.Вставить(Ключ2, Значение2);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктОбУтилизацииОС";
	КомандаПечати.Идентификатор		= "Акт0510435";
	КомандаПечати.Представление		= НСтр("ru = 'Акт об утилизации (ф. 0510435)'");
	КомандаПечати.Порядок			= 1;

	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктОбУтилизацииОС";
	КомандаПечати.Идентификатор		= "ПечатьИнвКарточек61н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Инвентарные карточки объектов'"),, "61н");
	КомандаПечати.Порядок			= 4;
	
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОСодержанииДрагМатериалов", 3);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Акт0510435") Тогда
		
		ТабличныйДокумент = УправлениеПечатьюБГУ.Напечатать0510435(МассивОбъектов, ОбъектыПечати,
			ДанныеДляПечати0510435(МассивОбъектов));
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Акт0510435","Акт (ф. 0510435)", ТабличныйДокумент);
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПечатьИнвКарточек61н") Тогда
		
		ДанныеДляПечати = ДанныеДляПечатиИнвКарточек(МассивОбъектов);
		ИменаФайловПечати = Новый Соответствие;
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПечатьИнвКарточек61н","Инвентарные карточки объектов",
			Справочники.ОсновныеСредства.ПечатьИнвентарнойКарточки61н(
			ДанныеДляПечати, ПараметрыПечати, ОбъектыПечати, ИменаФайловПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеДляПечатиИнвКарточек(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧОсновныеСредства.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.АктОбУтилизацииОС.ОсновныеСредства КАК ТЧОсновныеСредства
	|ГДЕ
	|	ТЧОсновныеСредства.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
КонецФункции

// Данные для печати0510435.
// 
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка
// 
// Возвращаемое значение:
//  см. УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктаОбУтилизации0510435
Функция ДанныеДляПечати0510435(МассивОбъектов)
	
	ДанныеДляПечати = УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктаОбУтилизации0510435();
	РезультатыГолосования = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(МассивОбъектов);
	ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки", Неопределено, "");
	
	ДокументыПоТипам = ОбщегоНазначенияБГУ.ДокументыПоТипам(МассивОбъектов);
	Для Каждого Документ Из ДокументыПоТипам Цикл
		МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Документ.Значение[0]);
		ЧастиЗапроса = МенеджерДокумента.ДанныеЗапросаДля0510435();

		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МассивОбъектов", Документ.Значение);
		
		Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ВыборкаШапка	= РезультатЗапроса[2].Выбрать();
		ВыборкаОС			= РезультатЗапроса[3].Выбрать();
		ВыборкаМЗ			= РезультатЗапроса[4].Выбрать();
		ВыборкаПолученныеМЗ = РезультатЗапроса[5].Выбрать();
		ВыборкаДМПолученныхМЗ = РезультатЗапроса[6].Выбрать();
		ВыборкаДМ           = РезультатЗапроса[7].Выбрать();

		СтруктураПоискаДМ = Новый Структура;
		СтруктураПоискаДМ.Вставить("Ссылка", Неопределено);
		СтруктураПоискаДМ.Вставить("ОбъектНФА", Неопределено);
		СтруктураПоискаДМ.Вставить("ИнвНомер", Справочники.ИнвентарныеНомераОС.ПустаяСсылка());

		СтруктураПоиска = Новый Структура("Ссылка", Неопределено);

		СтруктураПоискаКомиссии = Новый Структура("Ссылка, Председатель", Неопределено, Ложь);

		Пока ВыборкаШапка.Следующий() Цикл 

			СтрокаШапки = ДанныеДляПечати.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаШапки, ВыборкаШапка);
			
			СтрокаШапки.НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
				ВыборкаШапка.Ссылка, ВыборкаШапка.Номер);

			// Данные руководителя
			Если ВыборкаШапка.Владелец().Колонки.Найти("Руководитель") <> Неопределено И ЗначениеЗаполнено(ВыборкаШапка["Руководитель"]) Тогда
				ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность, Подразделение", 
					ВыборкаШапка["Руководитель"], ВыборкаШапка.ДатаАкта);
				Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина, Истина);
				ФИОРуководителя = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);                 
				ДолжностьРуководителя = Строка(ДанныеСотрудника.Должность);
			Иначе	
				Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
					Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ВыборкаШапка.Организация,
					ВыборкаШапка.ДатаАкта, ВыборкаШапка.СтруктурноеПодразделение);
				ФИОРуководителя = КорреспондентыКлиентСервер.ФИО(Руководитель, Истина, "ОтветственноеЛицо");
				ДолжностьРуководителя = Руководитель.ДолжностьПредставление;
			КонецЕсли;	
			СтрокаШапки.ДолжностьРуководителя = ДолжностьРуководителя;
			СтрокаШапки.ФИОРуководителя = ФИОРуководителя;
				
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект,Период,Фамилия,Имя,Отчество,НаименованиеПолное",
				ВыборкаШапка.Сотрудник, ВыборкаШапка.ДатаАкта);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
			СтрокаШапки.ЦМО = ДанныеСотрудника.НаименованиеПолное;
			
			СтруктураПоиска.Ссылка = ВыборкаШапка.Ссылка;
			СтруктураПоискаДМ.Ссылка = ВыборкаШапка.Ссылка;

			МероприятияПоУтилизации = УправлениеПечатьюБГУ.ТаблицаМероприятияПоУтилизацииДляПечатиАктаОбУтилизации0510435();
			СтрокаШапки.МероприятияПоУтилизации = МероприятияПоУтилизации; 

			// Инвентарные объекты
			
			ИнвентарныеОбъекты = УправлениеПечатьюБГУ.ТаблицаИнвентарныеОбъектыДляПечатиАктаОбУтилизации0510435();
			СтрокаШапки.ИнвентарныеОбъекты = ИнвентарныеОбъекты;
		
			ВыборкаОС.Сбросить();
			Пока ВыборкаОС.НайтиСледующий(СтруктураПоиска) Цикл
				
				КодСтроки = "11" + Формат(ВыборкаОС.НомерСтроки, "ЧЦ=3; ЧВН=");
				
				// Раздел 1.1
				СтрокаИнвОбъекта = ИнвентарныеОбъекты.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаИнвОбъекта, ВыборкаОС);
				СтрокаИнвОбъекта.ИнвентарныйНомерСсылка = ВыборкаОС.ИнвентарныйНомер;
				СтрокаИнвОбъекта.КодСтроки = КодСтроки;
				ДрагматериалыОбъекта = УправлениеПечатьюБГУ.ТаблицаДрагматериалыДляПечатиАктаОбУтилизации0510435();
				СтрокаИнвОбъекта.Драгматериалы = ДрагматериалыОбъекта;
				
				СтруктураПоискаДМ.ОбъектНФА = СтрокаИнвОбъекта.ОсновноеСредство;
				СтруктураПоискаДМ.ИнвНомер = СтрокаИнвОбъекта.ИнвентарныйНомерСсылка;
				
				ВыборкаДМ.Сбросить();
				Пока ВыборкаДМ.НайтиСледующий(СтруктураПоискаДМ) Цикл
					СтрокаДМОбъекта = ДрагматериалыОбъекта.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаДМОбъекта, ВыборкаДМ);
					СтрокаДМОбъекта.Драгметалл = ВыборкаДМ.ВидДрагМатериала;
					Если ВыборкаДМ.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни Тогда
						СтрокаДМОбъекта.Количество = ВыборкаДМ.КоличествоДМ;
					Иначе
						СтрокаДМОбъекта.Количество = ВыборкаДМ.МассаДМ;
					КонецЕсли;
				КонецЦикла;
				
				// Раздел 2.1
				СтрокаМероприятия = МероприятияПоУтилизации.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаМероприятия, ВыборкаОС);

				СтрокаМероприятия.КодСтроки      = КодСтроки;
				СтрокаМероприятия.Наименование   = СтрокаИнвОбъекта.НаименованиеОС;
				СтрокаМероприятия.ОбъектУчета    = СтрокаИнвОбъекта.ОсновноеСредство;
				СтрокаМероприятия.КлассОпасности = УправлениеПечатьюБГУ.ПредставлениеКлассаОпасности(ВыборкаОС.КлассОпасности);
				
			КонецЦикла;
			
			// Неинвентарные объекты
			
			НеинвентарныеОбъекы = УправлениеПечатьюБГУ.ТаблицаНеинвентарныеОбъектыДляПечатиАктаОбУтилизации0510435();
			СтрокаШапки.НеинвентарныеОбъекты = НеинвентарныеОбъекы;
			
			ВыборкаМЗ.Сбросить();
			Пока ВыборкаМЗ.НайтиСледующий(СтруктураПоиска) Цикл
				
				КодСтроки = "12" + Формат(ВыборкаМЗ.НомерСтроки, "ЧЦ=3; ЧВН=");
				
				// Раздел 1.2
				СтрокаНеинвОбъекта = НеинвентарныеОбъекы.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаНеинвОбъекта, ВыборкаМЗ);
				СтрокаНеинвОбъекта.КодСтроки = КодСтроки;
				ДрагматериалыОбъекта = УправлениеПечатьюБГУ.ТаблицаДрагматериалыДляПечатиАктаОбУтилизации0510435();
				СтрокаНеинвОбъекта.Драгматериалы = ДрагматериалыОбъекта;
				
				СтруктураПоискаДМ.ОбъектНФА = ВыборкаМЗ.Номенклатура;
				СтруктураПоискаДМ.ИнвНомер = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
				
				ВыборкаДМ.Сбросить();
				Пока ВыборкаДМ.НайтиСледующий(СтруктураПоискаДМ) Цикл
					СтрокаДМОбъекта = ДрагматериалыОбъекта.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаДМОбъекта, ВыборкаДМ);
					СтрокаДМОбъекта.Драгметалл = ВыборкаДМ.ВидДрагМатериала;
					Если ВыборкаДМ.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни Тогда
						СтрокаДМОбъекта.Количество = ВыборкаДМ.КоличествоДМ;
					Иначе
						СтрокаДМОбъекта.Количество = ВыборкаДМ.МассаДМ;
					КонецЕсли;
				КонецЦикла;
				
				// Раздел 2.1
				СтрокаМероприятия = МероприятияПоУтилизации.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаМероприятия, ВыборкаМЗ);

				СтрокаМероприятия.КодСтроки      = КодСтроки;
				СтрокаМероприятия.Наименование   = СтрокаНеинвОбъекта.НаименованиеМЗ;
				СтрокаМероприятия.ОбъектУчета    = СтрокаНеинвОбъекта.Номенклатура;
				СтрокаМероприятия.КлассОпасности = УправлениеПечатьюБГУ.ПредставлениеКлассаОпасности(ВыборкаМЗ.КлассОпасности);
				
			КонецЦикла;
			
			// Полученные МЗ
			
			ПолученныеМЗ = УправлениеПечатьюБГУ.ТаблицаПолученныеМЦДляПечатиАктаОбУтилизации0510435();
			СтрокаШапки.ПолученныеМЦ = ПолученныеМЗ;

			ОдобренныеОбъекты = ОбщегоНазначенияБГУ.ОдобренныеОбъектыГолосования(СтруктураПоиска.Ссылка);
			ВыборкаПолученныеМЗ.Сбросить();
			Пока ВыборкаПолученныеМЗ.НайтиСледующий(СтруктураПоиска) Цикл
				НоваяСтрока = ПолученныеМЗ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПолученныеМЗ);
				ОтборПоИдентификаторуСтроки.Документ = ВыборкаШапка.Ссылка;
				ОтборПоИдентификаторуСтроки.ИдентификаторСтроки = ВыборкаПолученныеМЗ.ИдентификаторСтроки;
				РезультатыГолосованияПоСтроке = РезультатыГолосования.НайтиСтроки(ОтборПоИдентификаторуСтроки);
				Если РезультатыГолосованияПоСтроке.Количество() > 0
					И РезультатыГолосованияПоСтроке[0].ГолосованиеПоСтрокеЗавершено Тогда
					НоваяСтрока.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
				КонецЕсли;
				
				НоваяСтрока.ОсобыеОтметки = УправлениеПечатьюБГУ.ОсобаяОтметкаРаздела22АктаОбУтилизации0510435(
					ВыборкаПолученныеМЗ.ИдентификаторСтроки, ОдобренныеОбъекты);				
			КонецЦикла;
			
			// Драгматериалы полученных МЗ
			ПолученныеДрагматериалы = УправлениеПечатьюБГУ.ТаблицаПолученныеДрагматериалыДляПечатиАктаОбУтилизации0510435();
			СтрокаШапки.ПолученныеДрагматериалы = ПолученныеДрагматериалы;
			
			ВыборкаДМПолученныхМЗ.Сбросить();
			Пока ВыборкаДМПолученныхМЗ.НайтиСледующий(СтруктураПоиска) Цикл
				СтрокаПолученногоДМ = ПолученныеДрагматериалы.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПолученногоДМ, ВыборкаДМПолученныхМЗ);
				Если ВыборкаДМПолученныхМЗ.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни Тогда
					СтрокаПолученногоДМ.Количество = ВыборкаДМПолученныхМЗ.КоличествоДМ;
				Иначе
					СтрокаПолученногоДМ.Количество = ВыборкаДМПолученныхМЗ.МассаДМ;
				КонецЕсли;
				
			КонецЦикла;
		
		КонецЦикла;
	КонецЦикла;
	
	Возврат ДанныеДляПечати;

КонецФункции

