#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АктОбУтилизацииОСОсновныеСредства.Ссылка
	|ИЗ
	|	Документ.АктОбУтилизацииОС.ОсновныеСредства КАК АктОбУтилизацииОСОсновныеСредства
	|ГДЕ
	|	АктОбУтилизацииОСОсновныеСредства.КлассОпасности = ЗНАЧЕНИЕ(Перечисление.КлассыОпасностиОтходов.ПустаяСсылка)";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.АктОбУтилизацииОС";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			ПредставлениеОбъекта = Строка(Выборка.Ссылка);
			
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект(); // ДокументОбъект.АктОбУтилизацииОС
			ОбъектИзменен = Ложь;
			Если Объект <> Неопределено Тогда 
				Объект.Заблокировать();
				Для Каждого Строка Из Объект.ОсновныеСредства Цикл
					Если ЗначениеЗаполнено(Строка.КлассОпасности) Тогда
						Продолжить;
					КонецЕсли;
					
					Если Строка.УдалитьКлассОпасности = 1 Тогда
						Строка.КлассОпасности = Перечисления.КлассыОпасностиОтходов.Класс1;
						ОбъектИзменен = Истина;
					ИначеЕсли Строка.УдалитьКлассОпасности = 2 Тогда
						Строка.КлассОпасности = Перечисления.КлассыОпасностиОтходов.Класс2;
						ОбъектИзменен = Истина;
					ИначеЕсли Строка.УдалитьКлассОпасности = 3 Тогда
						Строка.КлассОпасности = Перечисления.КлассыОпасностиОтходов.Класс3;
						ОбъектИзменен = Истина;
					ИначеЕсли Строка.УдалитьКлассОпасности = 4 Тогда
						Строка.КлассОпасности = Перечисления.КлассыОпасностиОтходов.Класс4;
						ОбъектИзменен = Истина;
					ИначеЕсли Строка.УдалитьКлассОпасности = 5 Тогда
						Строка.КлассОпасности = Перечисления.КлассыОпасностиОтходов.Класс5;
						ОбъектИзменен = Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
				
			Если ОбъектИзменен Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.НакладнаяНаОтпускИК,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

