#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	УправлениеМатериальнымиЗапасами.ПроверитьОчиститьКолонкуКПС(Материалы);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	ПроверитьНеобходимостьЗаполненияРеквизитовСчетовРасходовДоходов(НепроверяемыеРеквизиты);
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	УправлениеМатериальнымиЗапасами.ПроверитьЗаполнениеКолонкиКПСВТаблицеМатериалов(ЭтотОбъект, "Материалы", "Материалы", Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьНеобходимостьЗаполненияРеквизитовСчетовРасходовДоходов(НепроверяемыеРеквизиты)

	ПроверятьСчетДоходов = Ложь;
	ПроверятьСчетРасходов = Ложь;
	
	Для Каждого Строка Из Материалы Цикл
		ПроверятьСчетДоходов = ПроверятьСчетДоходов Или Строка.СуммаОбесцененияДоИзменения < Строка.СуммаОбесценения;
		ПроверятьСчетРасходов = ПроверятьСчетРасходов Или Строка.СуммаОбесценения < Строка.СуммаОбесцененияДоИзменения;
		Если ПроверятьСчетДоходов И ПроверятьСчетРасходов Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	РеквизитыДоходов = Новый Структура;
	РеквизитыДоходов.Вставить("СчетДоходов", Ложь);
	РеквизитыДоходов.Вставить("КПСДоходов", Ложь);
	РеквизитыДоходов.Вставить("КЭКДоходов", Ложь);
	РеквизитыДоходов.Вставить("ПодразделениеДоходов", Ложь);
	РеквизитыДоходов.Вставить("СубконтоДоходов1", Ложь);
	РеквизитыДоходов.Вставить("СубконтоДоходов2", Ложь);
	РеквизитыДоходов.Вставить("СубконтоДоходов3", Ложь);
	
	Если ПроверятьСчетДоходов Тогда
		РеквизитыДоходов.СчетДоходов = Истина;
		Если ЗначениеЗаполнено(СчетДоходов) Тогда
			СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетДоходов);
			Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
					И СвойстваСчета.УчетПоПодразделениям
					И Не СвойстваСчета.РазрешитьНеУказыватьПодразделение Тогда
				РеквизитыДоходов.ПодразделениеДоходов = Истина;
			КонецЕсли;
			Если СвойстваСчета.КоличествоСубконто > 0 Тогда
				РеквизитыДоходов.СубконтоДоходов1 = Истина;
			КонецЕсли;
			Если СвойстваСчета.КоличествоСубконто > 1 Тогда
				РеквизитыДоходов.СубконтоДоходов2 = Истина;
			КонецЕсли;
			Если СвойстваСчета.КоличествоСубконто > 2 Тогда
				РеквизитыДоходов.СубконтоДоходов3 = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из РеквизитыДоходов Цикл
		Если Не КлючЗначение.Значение Тогда
			НепроверяемыеРеквизиты.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	РеквизитыРасходов = Новый Структура;
	РеквизитыРасходов.Вставить("СчетРасходов", Ложь);
	РеквизитыРасходов.Вставить("КПСРасходов", Ложь);
	РеквизитыРасходов.Вставить("КЭКРасходов", Ложь);
	РеквизитыРасходов.Вставить("ПодразделениеРасходов", Ложь);
	РеквизитыРасходов.Вставить("СубконтоРасходов1", Ложь);
	РеквизитыРасходов.Вставить("СубконтоРасходов2", Ложь);
	РеквизитыРасходов.Вставить("СубконтоРасходов3", Ложь);
	
	Если ПроверятьСчетРасходов Тогда
		РеквизитыРасходов.СчетРасходов = Истина;
		Если ЗначениеЗаполнено(СчетРасходов) Тогда
			СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетРасходов);
			Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
					И СвойстваСчета.УчетПоПодразделениям
					И Не СвойстваСчета.РазрешитьНеУказыватьПодразделение Тогда
				РеквизитыРасходов.ПодразделениеРасходов = Истина;
			КонецЕсли;
			Если СвойстваСчета.КоличествоСубконто > 0 Тогда
				РеквизитыРасходов.СубконтоРасходов1 = Истина;
			КонецЕсли;
			Если СвойстваСчета.КоличествоСубконто > 1 Тогда
				РеквизитыРасходов.СубконтоРасходов2 = Истина;
			КонецЕсли;
			Если СвойстваСчета.КоличествоСубконто > 2 Тогда
				РеквизитыРасходов.СубконтоРасходов3 = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из РеквизитыРасходов Цикл
		Если Не КлючЗначение.Значение Тогда
			НепроверяемыеРеквизиты.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти	
	
#КонецЕсли