&НаСервере
Процедура ЗаполнитьДанныеСтроки(ТекущиеДанные, ИзмененнаяКолонка)
	ОстаткиБА = РассчитатьОстатки(ТекущиеДанные.Номенклатура);
	Если ИзмененнаяКолонка = "Количество" Тогда
		Отбор = Новый Структура("СчетУчета, КПС, КФО, Подразделение");
		ЗаполнитьЗначенияСвойств(Отбор, ТекущиеДанные);
		СтрокиБА = ОстаткиБА.НайтиСтроки(Отбор);
		Если СтрокиБА.Количество() > 0 Тогда
			ЗаполнитьСуммыИзСтрокиОстатков(ТекущиеДанные, СтрокиБА[0]);	
		КонецЕсли;
	ИначеЕсли ИзмененнаяКолонка = "Номенклатура" Тогда
		Если ОстаткиБА.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, ОстаткиБА[0], "СчетУчета, КПС, КФО");
			ЗаполнитьСуммыИзСтрокиОстатков(ТекущиеДанные, ОстаткиБА[0]);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвойстваЭлементовКорСчета(РасходовДоходов)
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("Подразделение" + РасходовДоходов);
	ИменаЭлементов.Добавить("Субконто" + РасходовДоходов + "1");
	ИменаЭлементов.Добавить("Субконто" + РасходовДоходов + "2");
	ИменаЭлементов.Добавить("Субконто" + РасходовДоходов + "3");
	
	ВидимостьЭлементов = Новый Массив(ИменаЭлементов.Количество());
	ОбязательностьЭлементов = Новый Массив(ИменаЭлементов.Количество());
	
	ПроверяемыйСчет = Объект["Счет" + РасходовДоходов];
	Если Не ЗначениеЗаполнено(ПроверяемыйСчет) Тогда
		ИменаЭлементов = Новый Массив;
		ИменаЭлементов.Добавить("Подразделение" + РасходовДоходов);
		ИменаЭлементов.Добавить("Субконто" + РасходовДоходов + "1");
		ИменаЭлементов.Добавить("Субконто" + РасходовДоходов + "2");
		ИменаЭлементов.Добавить("Субконто" + РасходовДоходов + "3");
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов, "Видимость", Ложь);
		Возврат;
	КонецЕсли;
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПроверяемыйСчет);
	ВидимостьЭлементов[0] = СвойстваСчета.УчетПоПодразделениям;
	ОбязательностьЭлементов[0] = СвойстваСчета.УчетПоПодразделениям И Не СвойстваСчета.РазрешитьНеУказыватьПодразделение;
	
	ИспользуемыеВидыСубконто = Новый Массив; // Массив из ПланВидовХарактеристикСсылка.ВидыСубконто
	Для Счетчик = 1 По СвойстваСчета.КоличествоСубконто Цикл
		ИспользуемыеВидыСубконто.Добавить(СвойстваСчета["ВидСубконто" + Счетчик]);
		ВидимостьЭлементов[Счетчик] = Истина;
		ОбязательностьЭлементов[Счетчик] = СвойстваСчета["ВидСубконто" + Счетчик + "Обязательный"]
	КонецЦикла;
	
	НаименованияСубконто = Новый Соответствие;
	Если ИспользуемыеВидыСубконто.Количество() > 0 Тогда
		НаименованияСубконто = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ИспользуемыеВидыСубконто, "Наименование");
	КонецЕсли;
	
	Для Индекс = 0 По ИменаЭлементов.ВГраница() Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементов[Индекс],
			"Видимость", ВидимостьЭлементов[Индекс] = Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементов[Индекс],
			"АвтоотметкаНезаполненного", ОбязательностьЭлементов[Индекс] = Истина);
		Если ВидимостьЭлементов[Индекс] = Истина И Индекс > 0 Тогда
			НаименованиеСубконто = НаименованияСубконто.Получить(СвойстваСчета["ВидСубконто" + Индекс]);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИменаЭлементов[Индекс],
				"Заголовок", НаименованиеСубконто);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

