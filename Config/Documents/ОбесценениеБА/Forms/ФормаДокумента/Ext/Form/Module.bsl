&НаСервере
Процедура ПоместитьМатериалыВХранилищеНаСервере(ПараметрыПодбора)
	
	ПараметрыПодбора.ПараметрыТчДокумента = Новый Структура("АдресТчВХранилище");
	КолонкиРеквизитов = УправлениеМатериальнымиЗапасами.КолонкиПодбораДляВыгрузкиТабличнойЧасти(ЭтотОбъект.ПолучитьРеквизиты("Объект.Материалы"));
	ТаблицаМатериалы = Объект.Материалы.Выгрузить(,КолонкиРеквизитов);
	ПараметрыПодбора.ПараметрыТчДокумента.АдресТчВХранилище = ПоместитьВоВременноеХранилище(ТаблицаМатериалы, ЭтотОбъект.УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСчетаДоходовРасходов()
	
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСчета = Объект.Дата;
	Иначе
		ДатаСчета = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.СчетДоходов) Тогда	
		Объект.СчетДоходов = БухгалтерскийУчет.СчетПоКоду("401.20", ДатаСчета, Объект.Организация);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КЭКДоходов) Тогда
		Объект.КЭКДоходов = БухгалтерскийУчетПовтИсп.КЭКПоКоду("274");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.СчетРасходов) Тогда	
		Объект.СчетРасходов = Объект.СчетДоходов;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КЭКРасходов) Тогда
		Объект.КЭКРасходов = Объект.КЭКДоходов;
	КонецЕсли;
	
КонецПроцедуры

