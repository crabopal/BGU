&НаСервере
Процедура ЗаполнитьДанныеСчетовВФорме(ДанныеСчетовВФорме = Неопределено)

	ПараметрыЗаполненияСчета = УправлениеМатериальнымиЗапасами.ПараметрыЗаполненияДанныхСчетовУчетаМЗВФорме();
	ПараметрыЗаполненияСчета.Организация = Объект.Организация;
	ПараметрыЗаполненияСчета.ДатаСчета = Объект.Дата;
	ПараметрыЗаполненияСчета.Включать113 = Истина;
	ПараметрыЗаполненияСчета.Включать106 = Ложь;
	ПараметрыЗаполненияСчета.Включать105 = Истина;
	ПараметрыЗаполненияСчета.СписокВыбора = Новый СписокЗначений;
	УправлениеМатериальнымиЗапасамиФормы.ЗаполнитьДанныеСчетовУчетаМЗВФорме(ЭтотОбъект, ПараметрыЗаполненияСчета,
		ДанныеСчетовВФорме);

	УправлениеМатериальнымиЗапасами.ЗаполнитьСчетаУчетаМЗ105(ЭтотОбъект);
	ОтключитьВидимостьКолонкиДопСубконто();
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСчетов = Объект.Дата;
	Иначе
		ДатаСчетов = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	СчетСсылка105 = БухгалтерскийУчет.СчетПоКоду("105.00", ДатаСчетов, Объект.Организация);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет105", СчетСсылка105);

	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет113",
		БухгалтерскийУчет.СчетПоКоду("113.00", ДатаСчетов, Объект.Организация));
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	ДанныеСчетовВФорме = Неопределено;
	ЗаполнитьДанныеСчетовВФорме(ДанныеСчетовВФорме);
	УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ДанныеСчетовВФорме);
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	ЗаполнитьДинамическиеКолонкиВоВсехСтроках();
	УстановитьСвойстваЭлементовКорСчета("Расходов");
	УстановитьСвойстваЭлементовКорСчета("Доходов");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ДанныеСчетовВФорме = Неопределено)
	ПараметрыЗаполненияКолонок = УправлениеМатериальнымиЗапасамиКлиентСервер.ЗаполнитьДинамическиеКолонки_Параметры(
		ЭтотОбъект, Объект);
	ПараметрыЗаполненияКолонок.Включать106 = Истина;
	ПараметрыЗаполненияКолонок.Включать113 = Истина;
	ПараметрыЗаполненияКолонок.ДанныеСчетов = ДанныеСчетовВФорме;
	УправлениеМатериальнымиЗапасамиКлиентСервер.ЗаполнитьДинамическиеКолонки(ПараметрыЗаполненияКолонок);
КонецПроцедуры

&НаСервере
Процедура ОтключитьВидимостьКолонкиДопСубконто()

	ПроверяемыеСчета = ВсеСчета113.ВыгрузитьЗначения();
	СписокСчетов = Новый СписокЗначений;
	СписокСчетов.ЗагрузитьЗначения(ПроверяемыеСчета);
	УправлениеМатериальнымиЗапасами.ОтключитьВидимостьКолонкиДопСубконто(Элементы.МатериалыДополнительнаяАналитикаСчета,
																		 ПроверяемыеСчета);

КонецПроцедуры

&НаКлиенте
Функция ДополнитьСтруктуруПодбора()
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("СчетУчета", ОбщегоНазначенияБГУКлиентСервер.СвойствоЛокальногоКэшаФормы(ЭтотОбъект, "Счет113"));
	ПараметрыПодбора.Вставить("НеИспользоватьСубконтоЦМО", Истина);
	ПараметрыПодбора.Вставить("ПоказыватьОстатки", Истина);
	ПараметрыПодбора.Вставить("ПоказыватьСчетУчета", Истина);
	ПараметрыПодбора.Вставить("ДополнитьСчетом113", Истина);
	ТипыНоменклатуры = Новый СписокЗначений;
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БиологическиеАктивы"));
	ПараметрыПодбора.Вставить("ТипыНоменклатуры",		ТипыНоменклатуры);
	ПараметрыПодбора.Вставить("ИмяТаблицы",				"Материалы");
	Возврат ПараметрыПодбора;

КонецФункции

