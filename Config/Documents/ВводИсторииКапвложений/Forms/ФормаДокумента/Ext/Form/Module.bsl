#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьОтборСтрокИстории()  
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийВводИсторииКапвложений.ВводКарточекКапвложенийПоОстаткам") Тогда
		ДанныеСтроки = Элементы.Объекты.ТекущиеДанные;
		Если ДанныеСтроки = Неопределено Тогда
			ОтборОпераций = Новый ФиксированнаяСтруктура("ОбъектВложений", Неопределено);
		Иначе	
			ОтборОпераций = Новый ФиксированнаяСтруктура("ОбъектВложений", ДанныеСтроки.ОбъектВложений);
		КонецЕсли;	
		Элементы.ИсторияОпераций.ОтборСтрок = ОтборОпераций;
	Иначе	
		ДанныеСтроки = Элементы.КарточкиКапвложений.ТекущиеДанные;
		Если ДанныеСтроки = Неопределено Тогда
			ОтборОпераций = Новый ФиксированнаяСтруктура("ОбъектВложений, КарточкаКапвложений", Неопределено, Неопределено);
		Иначе	
			ОтборОпераций = Новый ФиксированнаяСтруктура("ОбъектВложений, КарточкаКапвложений", 
				ДанныеСтроки.ОбъектВложений, ДанныеСтроки.КарточкаКапвложений);
		КонецЕсли;	
		Элементы.ИсторияОпераций.ОтборСтрок = ОтборОпераций;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрокКарточек()  
	Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийВводИсторииКапвложений.ВводКарточекКапвложенийПоОстаткам") Тогда
		ДанныеСтроки = Элементы.Объекты.ТекущиеДанные;
		Если ДанныеСтроки = Неопределено Тогда
			ОтборКарточек = Новый ФиксированнаяСтруктура("ОбъектВложений", Неопределено);
		Иначе	
			ОтборКарточек = Новый ФиксированнаяСтруктура("ОбъектВложений", ДанныеСтроки.ОбъектВложений);
		КонецЕсли;	
		Элементы.КарточкиКапвложений.ОтборСтрок = ОтборКарточек;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрок(ТаблицаИсточникИзменений = "")  
	Если ТаблицаИсточникИзменений = "Карточки" Тогда
		УстановитьОтборСтрокИстории();
	Иначе	
		УстановитьОтборСтрокКарточек();
		УстановитьОтборСтрокИстории();
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	ТекВидОперации = Форма.Объект.ВидОперации;
	ЭтоПервоеПрименение = (Форма.Объект.ВидОперации = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийВводИсторииКапвложений.ВводКарточекКапвложенийПоОстаткам"));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"КарточкиКапвложений", "Видимость", НЕ ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОбъектыСумма", "Видимость", ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОбъектыДатаНачалаВложений", "Видимость", ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ФормаЗаполнитьИсторию", "Видимость", НЕ ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ФормаЗаполнитьПоОстаткам106", "Видимость", ЭтоПервоеПрименение);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИсторияОперацийЗаполнитьКарточкиКапвложений", "Видимость", ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИсторияОперацийКарточкаКапвложений", "Видимость", ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИсторияОперацийКЭКСчетВложения", "Видимость", НЕ ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИсторияОперацийСчетКорр", "Видимость", НЕ ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИсторияОперацийКПССчетКорр", "Видимость", НЕ ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИсторияОперацийКЭКСчетКорр", "Видимость", НЕ ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИсторияОперацийСубконтоСчетКорр1", "Видимость", НЕ ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИсторияОперацийСубконтоСчетКорр2", "Видимость", НЕ ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИсторияОперацийСубконтоСчетКорр3", "Видимость", НЕ ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИсторияОперацийВидПервичногоДокумента", "Видимость", НЕ ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИсторияОперацийДатаПервичногоДокумента", "Видимость", НЕ ЭтоПервоеПрименение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИсторияОперацийНомерПервичногоДокумента", "Видимость", НЕ ЭтоПервоеПрименение);
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьФормуИзДокумента()
	ТабОбъектов = Объект.ИсторияОпераций.Выгрузить(,"ОбъектВложений, ДатаНачалаВложений, Сумма");
	ТабОбъектов.Свернуть("ОбъектВложений, ДатаНачалаВложений", "Сумма");
	Для каждого ТекОбъект Из ТабОбъектов Цикл
		НоваяСтрока = Объекты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекОбъект);
		НоваяСтрока.ОбъектВложенийПредставление = Строка(НоваяСтрока.ОбъектВложений);
	КонецЦикла;	
	
	ТабКарточек = Объект.ИсторияОпераций.Выгрузить(,"ОбъектВложений, КарточкаКапвложений");
	ТабКарточек.Свернуть("ОбъектВложений, КарточкаКапвложений");
	Для каждого ТекКарточка Из ТабКарточек Цикл
		НоваяСтрока = КарточкиКапвложений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекКарточка);
		НоваяСтрока.КарточкаКапвложенийПредставление = Строка(НоваяСтрока.КарточкаКапвложений);
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьПоОстаткамНаСервере()   
	Объект.ИсторияОпераций.Очистить();
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектВложений,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМОСчетВложения,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетВложения,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПССчетВложения,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	&СторонаСчетВложения КАК СторонаСчетВложения,
	|	&Содержание КАК Содержание,
	|	&ДатаПолученияОстатков КАК ДатаОперации,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстаток) КАК Количество,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстаток) КАК Сумма
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаПолученияОстатков, Счет В (&СчетаКапвложений), , Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУОстатки.Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.ИФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИсторияКапвложенийОбороты.ОбъектВложений КАК ОбъектВложений
	|ПОМЕСТИТЬ ОбъектыСКарточкамиПервогоПрименения
	|ИЗ
	|	РегистрНакопления.ИсторияКапвложений.Обороты(
	|			,
	|			,
	|			,
	|			ОбъектВложений В
	|					(ВЫБРАТЬ
	|						Таб.ОбъектВложений
	|					ИЗ
	|						Остатки КАК Таб)
	|				И КарточкаКапвложений.ВидКапвложений = &ВидКапвложенияПервоеПрименение) КАК ИсторияКапвложенийОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.ОбъектВложений КАК ОбъектВложений,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.КФО КАК КФО,
	|	Остатки.СчетВложения КАК СчетВложения,
	|	Остатки.КПССчетВложения КАК КПССчетВложения,
	|	Остатки.ЦМОСчетВложения КАК ЦМОСчетВложения,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.СторонаСчетВложения КАК СторонаСчетВложения,
	|	Остатки.Содержание КАК Содержание,
	|	Остатки.ДатаОперации КАК ДатаОперации,
	|	Остатки.Количество КАК Количество,
	|	Остатки.Сумма КАК Сумма
	|ИЗ
	|	Остатки КАК Остатки
	|ГДЕ
	|	НЕ Остатки.ОбъектВложений В
	|				(ВЫБРАТЬ
	|					Таб.ОбъектВложений
	|				ИЗ
	|					ОбъектыСКарточкамиПервогоПрименения КАК Таб)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СторонаСчетВложения", "Дт");
	
	ДатаПолученияОстатков = КонецДня(Объект.Дата) + 1;
	Запрос.УстановитьПараметр("Содержание", 
		СтрШаблон(НСтр("ru = 'Отражение остатка по объекту капитальных вложений на %1'"), 
		Формат(ДатаПолученияОстатков, "ДЛФ=D;")));
		
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ДатаПолученияОстатков", ДатаПолученияОстатков);
	Запрос.УстановитьПараметр("СчетаКапвложений", ОбслуживаниеКарточекКапвложений.СчетаКапвложенийДляКарточкиКапвложений());
	Запрос.УстановитьПараметр("ВидКапвложенияПервоеПрименение", ПредопределенноеЗначение("Перечисление.ВидыКапвложений.ПервоеПрименение"));
	
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ИсторияОпераций.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;	

	ЗаполнитьФормуИзДокумента();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИсториюНаСервере()
	Объект.ИсторияОпераций.Очистить();
	
	ТаблицаИстории = Документы.ВводИсторииКапвложений.ТаблицаИсторииКапвложений(Объект.Дата, Объект.Организация);
	
	Для каждого СтрокаПроводки Из ТаблицаИстории Цикл 
		НоваяСтрока = Объект.ИсторияОпераций.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПроводки);
	КонецЦикла;	

	ЗаполнитьФормуИзДокумента();
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьКарточкиКапвложенийНаСервере()
	ТабОбъектов = Объект.ИсторияОпераций.Выгрузить(, "ОбъектВложений");
	ТабОбъектов.Свернуть("ОбъектВложений");
	МассивОбъектов = ТабОбъектов.ВыгрузитьКолонку("ОбъектВложений");
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КарточкиКапвложений.Ссылка КАК КарточкаКапвложений,
	|	КарточкиКапвложений.ОбъектВложений КАК ОбъектВложений
	|ИЗ
	|	Справочник.КарточкиКапвложений КАК КарточкиКапвложений
	|ГДЕ
	|	КарточкиКапвложений.ОбъектВложений В(&МассивОбъектов)
	|	И КарточкиКапвложений.Владелец = &Организация
	|	И КарточкиКапвложений.ВидКапвложений = &ВидКапвложенийПервоеПрименение";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	ВидКапвложенийПервоеПрименение = ПредопределенноеЗначение("Перечисление.ВидыКапвложений.ПервоеПрименение");
	Запрос.УстановитьПараметр("ВидКапвложенийПервоеПрименение", ВидКапвложенийПервоеПрименение);
	ТабКарточек = Запрос.Выполнить().Выгрузить();  
	
	Для каждого ТекОбъект Из МассивОбъектов Цикл
		СтрокаКарточки = ТабКарточек.Найти(ТекОбъект, "ОбъектВложений");
		
		// Найдем дату начала формирования вложений для объекта
		ДатаНачалаВложений = Дата(1,1,1);
		Отбор = Новый Структура("ОбъектВложений", ТекОбъект);
		ПроводкиОбъекта = Объект.ИсторияОпераций.НайтиСтроки(Отбор);
		Если ПроводкиОбъекта.Количество() > 0 И ЗначениеЗаполнено(ПроводкиОбъекта[0].ДатаНачалаВложений) Тогда
			ДатаНачалаВложений = ПроводкиОбъекта[0].ДатаНачалаВложений;
		КонецЕсли;	
		
		Если СтрокаКарточки = Неопределено Тогда
			КарточкаОбъект = Справочники.КарточкиКапвложений.СоздатьЭлемент();
			КарточкаОбъект.Владелец       = Объект.Организация;
			КарточкаОбъект.ОбъектВложений = ТекОбъект;
			КарточкаОбъект.ВидКапвложений = ВидКапвложенийПервоеПрименение;
			КарточкаОбъект.Наименование   = Справочники.КарточкиКапвложений.НаименованиеИзРеквизитов(ТекОбъект, ВидКапвложенийПервоеПрименение);
			КарточкаОбъект.Комментарий    = НСтр("ru = 'Создана программно документом ""Ввод истории капвложений""'");
			КарточкаОбъект.ДатаНачалаВложений = ДатаНачалаВложений;
			КарточкаОбъект.Записать();
			
			ТекКарточка = КарточкаОбъект.Ссылка;

			НоваяСтрока = ТабКарточек.Добавить();
			НоваяСтрока.ОбъектВложений      = ТекОбъект;
			НоваяСтрока.КарточкаКапвложений = ТекКарточка;
		Иначе
			ТекКарточка = СтрокаКарточки.КарточкаКапвложений;   

			Если ЗначениеЗаполнено(ДатаНачалаВложений) Тогда
				НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
				Попытка	
					Блокировка = Новый БлокировкаДанных;
					ЭлементБлокировки = Блокировка.Добавить("Справочник.КарточкиКапвложений");
					ЭлементБлокировки.УстановитьЗначение("Ссылка", ТекКарточка);
					ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
					Блокировка.Заблокировать();

					КарточкаОбъект = ТекКарточка.ПолучитьОбъект();          
					КарточкаОбъект.ДатаНачалаВложений = ДатаНачалаВложений;
					КарточкаОбъект.Записать();

					ТекКарточка = КарточкаОбъект.Ссылка;   

					ЗафиксироватьТранзакцию();  
				Исключение   
					ОтменитьТранзакцию(); 
					ТекстОшибки = СтрШаблон(
						Нстр("ru = 'Карточку капвложений первого применения ""%1"" не удалось заблокировать'", ОбщегоНазначения.КодОсновногоЯзыка()), 
						КарточкаОбъект.Наименование);
					ЗаписьЖурналаРегистрации(ТекстОшибки, УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.ВводИсторииКапвложений);
					ВызватьИсключение;
				КонецПопытки;	
			КонецЕсли;	
		КонецЕсли;	                                            
		
		Для каждого ТекПроводка Из ПроводкиОбъекта Цикл
			ТекПроводка.КарточкаКапвложений = ТекКарточка;
		КонецЦикла;	
	КонецЦикла;	     
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьЗаголовокТаблицыИстории()
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийВводИсторииКапвложений.ВводКарточекКапвложенийПоОстаткам") Тогда
		Текст = НСтр("ru = 'История операций'");
	Иначе
		ТекДанные = Элементы.КарточкиКапвложений.ТекущиеДанные;
		Текст = НСтр("ru = 'История операций карточки'");
		Если ТекДанные <> Неопределено И ЗначениеЗаполнено(ТекДанные.КарточкаКапвложений) Тогда
			Текст = Текст + ": " + ТекДанные.КарточкаКапвложенийПредставление;
		КонецЕсли;	     
	КонецЕсли;	
	Элементы.ГруппаТЧПравая.Заголовок = Текст;
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьЗаголовокТаблицыКарточек()
	ТекДанные = Элементы.Объекты.ТекущиеДанные;
	Текст = НСтр("ru = 'Карточки объекта'");
	Если ТекДанные <> Неопределено И ЗначениеЗаполнено(ТекДанные.ОбъектВложений) Тогда
		Текст = Текст + ": " + ТекДанные.ОбъектВложенийПредставление;
	КонецЕсли;	     
	Элементы.КарточкиКапвложений.Заголовок = Текст;
КонецПроцедуры	

&НаКлиенте
Процедура УдалитьСтрокиТаблицы(Таблица, ОбъектПоиска, КолонкаПоиска)
	МаксИндекс = Таблица.Количество() - 1;
	Для к = - МаксИндекс По 0 Цикл
		Индекс = -к;
		Если Таблица[Индекс][КолонкаПоиска] <> ОбъектПоиска Тогда
			Продолжить;
		КонецЕсли;	   
		Таблица.Удалить(Индекс);
	КонецЦикла;	
КонецПроцедуры	

&НаКлиенте
Процедура УдалитьСвязанныеСтрокиТаблиц(УдаляемыйОбъект)
	ТипУдаляемогоОбъекта = ТипЗнч(УдаляемыйОбъект);
	ТипОС = Тип("СправочникСсылка.ОсновныеСредства");
	ТипКарточкаКапвложений = Тип("СправочникСсылка.КарточкиКапвложений");
	
	Если ТипУдаляемогоОбъекта = ТипОС Тогда
		УдалитьСтрокиТаблицы(КарточкиКапвложений, УдаляемыйОбъект, "ОбъектВложений");
		УдалитьСтрокиТаблицы(Объект.ИсторияОпераций, УдаляемыйОбъект, "ОбъектВложений");
	ИначеЕсли ТипУдаляемогоОбъекта = ТипКарточкаКапвложений Тогда
		УдалитьСтрокиТаблицы(Объект.ИсторияОпераций, УдаляемыйОбъект, "КарточкаКапвложений");
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура СообщитьПользователюОбОтменеПроведения()
	ОбщегоНазначенияКлиент.СообщитьПользователю(Нстр("ru = 'Для заполнения документа нужно отменить проведение.'"));
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораПолногоСчета(ТекущиеДанные, Элемент, ДанныеВыбора, СтандартнаяОбработка, ИмяПоляСчета)
	ТекущийСчет = Новый Структура("Счет, КПС, КФО");
	ТекущийСчет.Счет = ТекущиеДанные[ИмяПоляСчета];
	ТекущийСчет.КПС  = ТекущиеДанные["КПС" + ИмяПоляСчета];
	ТекущийСчет.КФО  = ТекущиеДанные["КФО"];
	
	Если ИмяПоляСчета = "СчетВложения" Тогда
		ОграниченияСчетов = ОбслуживаниеКарточекКапвложенийВызовСервера.СчетаКапвложенийДляКарточкиКапвложений();
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, СтандартнаяОбработка, ТекущийСчет,
			Объект.Организация,, ОграниченияСчетов, ТекущиеДанные.КФО,, Объект.Дата);
	Иначе
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, СтандартнаяОбработка, ТекущийСчет,
			Объект.Организация,,, ТекущиеДанные.КФО,, Объект.Дата);
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаВыбораПолногоСчета(ТекущиеДанные, ВыбранноеЗначение, СтандартнаяОбработка, ИмяПоляСчета)
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;	

	СтандартнаяОбработка = Ложь;
	Если ИмяПоляСчета = "СчетВложения" Тогда
		ТекущиеДанные.СчетВложения    = ВыбранноеЗначение.Счет;
		ТекущиеДанные.КПССчетВложения = ВыбранноеЗначение.КПС;
		ТекущиеДанные.КЭКСчетВложения = ?(ТекущиеДанные.СторонаСчетВложения = "Дт", ВыбранноеЗначение.КОСГУДт, ВыбранноеЗначение.КОСГУКт);
	Иначе
		ТекущиеДанные.СчетКорр    = ВыбранноеЗначение.Счет;
		ТекущиеДанные.КПССчетКорр = ВыбранноеЗначение.КПС;
		ТекущиеДанные.КЭКСчетКорр = ?(ТекущиеДанные.СторонаСчетВложения = "Дт", ВыбранноеЗначение.КОСГУДт, ВыбранноеЗначение.КОСГУКт);
	КонецЕсли;	
КонецПроцедуры

