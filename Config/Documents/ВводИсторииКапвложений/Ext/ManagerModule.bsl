	|	ВводИсторииКапвложенийИсторияОпераций.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	ВводИсторииКапвложенийИсторияОпераций.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	ВводИсторииКапвложенийИсторияОпераций.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	|	ВводИсторииКапвложенийИсторияОпераций.Количество КАК Количество,
	|	ВводИсторииКапвложенийИсторияОпераций.Сумма КАК Сумма
	|ИЗ
	|	Документ.ВводИсторииКапвложений.ИсторияОпераций КАК ВводИсторииКапвложенийИсторияОпераций
	|ГДЕ
	|	ВводИсторииКапвложенийИсторияОпераций.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВводИсторииКапвложенийИсторияОпераций.НомерСтроки,
	|	ВводИсторииКапвложенийИсторияОпераций.ДатаОперации
	|ИТОГИ
	|	СУММА(Сумма)
	|ПО
	|	Ссылка,
	|	ОбъектВложений,
	|	КарточкаКапвложений";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.ВыполнитьПакет();
	Шапка = Результат[0].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТЧ    = Результат[1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ТолькоПросмотр = Истина;
	
	Макет = ПолучитьМакет("ПФ_MXL_КарточкаДокументаИсторияКапвложений");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка     = Макет.ПолучитьОбласть("Шапка");
	ОбластьОбъектов  = Макет.ПолучитьОбласть("СтрокаОбъектов");
	ОбластьКарточек  = Макет.ПолучитьОбласть("СтрокаКарточек");
	ОбластьДетальная = Макет.ПолучитьОбласть("СтрокаДетальная");
	
	ВО_ПервоеПрименение = Перечисления.ВидыОперацийВводИсторииКапвложений.ВводКарточекКапвложенийПоОстаткам;
	КолонкаГруппировок = НСтр("ru = 'Объект /
		|Карточка /
		|Дата операции'");
	
	Для каждого СтрокаДокумента Из Шапка.Строки Цикл
		Если Шапка.Строки.Индекс(СтрокаДокумента) > 0 Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;	
		
		Для каждого СтрокаДетальная Из СтрокаДокумента.Строки Цикл
			ОбластьЗаголовок.Параметры.Заполнить(СтрокаДетальная);
			ТабДок.Вывести(ОбластьЗаголовок);
		КонецЦикла;	
		
		ОбластьШапка.Параметры.КолонкаГруппировок = КолонкаГруппировок;
		ТабДок.Вывести(ОбластьШапка);
		
		СтрокаТЧ = ТЧ.Строки.Найти(СтрокаДокумента.Ссылка, "Ссылка");
		Если СтрокаТЧ = Неопределено Тогда
			Продолжить;
		КонецЕсли;	   
		
		Для каждого СтрокаОбъекта Из СтрокаТЧ.Строки Цикл       
			ОбластьОбъектов.Параметры.Заполнить(СтрокаОбъекта);
			ТабДок.Вывести(ОбластьОбъектов);
			ТабДок.НачатьГруппуСтрок("ОбластьКарточек", Истина);
			
			Для каждого СтрокаКарточки Из СтрокаОбъекта.Строки Цикл
				ОбластьКарточек.Параметры.Заполнить(СтрокаКарточки);
				ТабДок.Вывести(ОбластьКарточек);
				
				ТабДок.НачатьГруппуСтрок("ОбластьДетальная", Истина);
				Для каждого СтрокаДетальная Из СтрокаКарточки.Строки Цикл
					ОбластьДетальная.Параметры.Заполнить(СтрокаДетальная);
					ТабДок.Вывести(ОбластьДетальная);
				КонецЦикла;	
				ТабДок.ЗакончитьГруппуСтрок();
			КонецЦикла;	
			ТабДок.ЗакончитьГруппуСтрок();
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат ТабДок;
КонецФункции

