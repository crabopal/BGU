#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом
// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВводИсторииКапвложений";
	КомандаПечати.Идентификатор		= "КарточкаДокумента_ВводИсторииКапвложений";
	КомандаПечати.Представление		= НСтр("ru = 'Карточка документа ""Ввод истории капвложений""'");
	КомандаПечати.Порядок			= 1;
    
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов - Массив - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати - СписокЗначений - Соответствие между объектами и именами печатных областей, куда распечатан объект
//   ИменаМакетов - Строка - Имена макетов, перечисленные через запятую
//   ПараметрыВывода - Структура - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КарточкаДокумента_ВводИсторииКапвложений") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
		"КарточкаДокумента_ВводИсторииКапвложений", 
		НСтр("ru = 'Карточка документа ""Ввод истории капвложений""'"), 
		ПечатьКарточкиИстории(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
КонецПроцедуры

// Формирует таблицы движений документа для разных регистров, по которым документ должен сформировать движения.
// Это предопределенная процедура в механизме формирования движений.
//
// Параметры:
//	ДокументСсылка - ДокументСсылка - ссылка на документ, который формирует движения
//	СтруктураДополнительныеСвойства - Структура - это свойство "ДополнительныеСвойства" ДокументаОбъекта
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос;              
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	НомераТаблиц = Новый Структура;
	
	ИнициализироватьЗапросПоДокументу(Запрос, НомераТаблиц);
	
	Результат = Запрос.ВыполнитьПакет();                                     
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
	
КонецПроцедуры                                             

// Формирует таблицу с данными карточек капвложений на дату. Таблица формируется по данным
// регистра бухгалтерии за вычетом движений, которые уже перенесены в регистр накопления "ИсторияКапвложений". 
//
// Параметры:
//	ДатаЗапроса - Дата
//	Организация - СправочникСсылка.Организации - элемент справочника "Организации" для отбора
//				- Массив Из СправочникСсылка.Организации - массив элементов справочника "Организации" для отбора
//	СИтогамиДляСтаройСвертки - Булево - для корректной работы старой обработки свертки, нужна группировка по итогам по 
//										Организациям и Активности. Для вызова из старой свертки нужно передавать значение Истина.
//
// Возвращаемое значение:
//	- Запрос - запрос с установленными параметрами по получению данных для формирования движений в регистр накопления "ИсторияКапвложений"
Функция Запрос_ТаблицаИсторииКапвложений(ДатаЗапроса, Организации = Неопределено, СИтогамиДляСтаройСвертки = Ложь) Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(ИсторияКапвложений.Период) КАК Период,
	|	ИсторияКапвложений.КарточкаКапвложений КАК КарточкаКапвложений
	|ПОМЕСТИТЬ КарточкиВРегистреИстории
	|ИЗ
	|	РегистрНакопления.ИсторияКапвложений КАК ИсторияКапвложений
	|ГДЕ
	|	ИсторияКапвложений.Период <= &Дата1
	|	И (&НетОтбораПоОрганизации
	|			ИЛИ ИсторияКапвложений.Организация В (&Организации))
	|
	|СГРУППИРОВАТЬ ПО
	|	ИсторияКапвложений.КарточкаКапвложений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОперацииКапвложений.Регистратор КАК Регистратор,
	|	ОперацииКапвложений.Период КАК Период,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ОперацииКапвложений.Регистратор) = ТИП(Документ.РегистрацияКапвложений)
	|			ТОГДА ОперацииКапвложений.ДокументКапвложений
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ДокументКапвложений,
	|	ОперацииКапвложений.КарточкаКапвложений КАК КарточкаКапвложений,
	|	ОперацииКапвложений.КарточкаКапвложений.ОбъектВложений КАК ОбъектВложений,
	|	ОперацииКапвложений.КарточкаКапвложений.Владелец КАК Организация
	|ПОМЕСТИТЬ Регистраторы1
	|ИЗ
	|	РегистрСведений.ОперацииКапвложений КАК ОперацииКапвложений
	|ГДЕ
	|	ОперацииКапвложений.Период <= &Дата1
	|	И (&НетОтбораПоОрганизации
	|			ИЛИ ОперацииКапвложений.Организация В (&Организации))
	|
	|СГРУППИРОВАТЬ ПО
	|	ОперацииКапвложений.Регистратор,
	|	ОперацииКапвложений.Период,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ОперацииКапвложений.Регистратор) = ТИП(Документ.РегистрацияКапвложений)
	|			ТОГДА ОперацииКапвложений.ДокументКапвложений
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ,
	|	ОперацииКапвложений.КарточкаКапвложений,
	|	ОперацииКапвложений.КарточкаКапвложений.ОбъектВложений,
	|	ОперацииКапвложений.КарточкаКапвложений.Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУ.Регистратор КАК ОперацияБух
	|ПОМЕСТИТЬ ОперацииБухАктивные
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.Период <= &Дата1
	|	И ЖурналПроводокЕПСБУ.Активность
	|	И ЖурналПроводокЕПСБУ.Регистратор В
	|			(ВЫБРАТЬ
	|				Регистраторы1.ДокументКапвложений КАК Регистратор
	|			ИЗ
	|				Регистраторы1 КАК Регистраторы1
	|			ГДЕ
	|				ТИПЗНАЧЕНИЯ(Регистраторы1.Регистратор) = ТИП(Документ.РегистрацияКапвложений)
	|				И ТИПЗНАЧЕНИЯ(Регистраторы1.ДокументКапвложений) = ТИП(Документ.ОперацияБух))
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУ.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Регистраторы1.Регистратор) = ТИП(Документ.РегистрацияКапвложений)
	|			ТОГДА Регистраторы1.ДокументКапвложений
	|		ИНАЧЕ Регистраторы1.Регистратор
	|	КОНЕЦ КАК Регистратор,
	|	Регистраторы1.КарточкаКапвложений КАК КарточкаКапвложений,
	|	Регистраторы1.КарточкаКапвложений.ОбъектВложений КАК ОбъектВложений,
	|	Регистраторы1.КарточкаКапвложений.Владелец КАК Организация
	|ПОМЕСТИТЬ Регистраторы
	|ИЗ
	|	Регистраторы1 КАК Регистраторы1
	|		ЛЕВОЕ СОЕДИНЕНИЕ КарточкиВРегистреИстории КАК КарточкиВРегистреИстории
	|		ПО Регистраторы1.КарточкаКапвложений = КарточкиВРегистреИстории.КарточкаКапвложений
	|			И Регистраторы1.Период <= КарточкиВРегистреИстории.Период
	|ГДЕ
	|	КарточкиВРегистреИстории.КарточкаКапвложений ЕСТЬ NULL
	|	И ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(Регистраторы1.Регистратор) = ТИП(Документ.РегистрацияКапвложений)
	|				ТОГДА ВЫБОР
	|						КОГДА ТИПЗНАЧЕНИЯ(Регистраторы1.ДокументКапвложений) = ТИП(Документ.ОперацияБух)
	|							ТОГДА Регистраторы1.ДокументКапвложений В
	|									(ВЫБРАТЬ
	|										ОперацииБухАктивные.ОперацияБух
	|									ИЗ
	|										ОперацииБухАктивные)
	|						ИНАЧЕ Регистраторы1.ДокументКапвложений.Проведен
	|					КОНЕЦ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Регистраторы1.Регистратор) = ТИП(Документ.РегистрацияКапвложений)
	|			ТОГДА Регистраторы1.ДокументКапвложений
	|		ИНАЧЕ Регистраторы1.Регистратор
	|	КОНЕЦ,
	|	Регистраторы1.КарточкаКапвложений,
	|	Регистраторы1.КарточкаКапвложений.ОбъектВложений,
	|	Регистраторы1.КарточкаКапвложений.Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Организация КАК Организация,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК ОбъектВложений,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК ЦМОСчетВложения,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт КАК Подразделение,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК СчетВложения,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПССчетВложения,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт КАК КЭКСчетВложения,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетКорр,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт КАК КПССчетКорр,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт КАК КЭКСчетКорр,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК СубконтоСчетКорр1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК СубконтоСчетКорр2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК СубконтоСчетКорр3,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Период КАК ДатаОперации,
	|	""Дт"" КАК СторонаСчетВложения,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание КАК Содержание,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоДт КАК Количество,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК Сумма,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияКт КАК ХарактеристикаДвиженияКорр
	|ПОМЕСТИТЬ ТабПроводок
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			&Дата1,
	|			СчетДт В (&СчетаКапвложений)
	|				И СубконтоДт1 В
	|					(ВЫБРАТЬ
	|						Таб.ОбъектВложений
	|					ИЗ
	|						Регистраторы КАК Таб)
	|				И Регистратор В
	|					(ВЫБРАТЬ
	|						Таб.Регистратор
	|					ИЗ
	|						Регистраторы КАК Таб)
	|				И (&НетОтбораПоОрганизации
	|					ИЛИ Организация В (&Организации)),
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Организация,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Период,
	|	""Кт"",
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ВидПервичногоДокумента,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ДатаПервичногоДокумента,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.НомерПервичногоДокумента,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт,
