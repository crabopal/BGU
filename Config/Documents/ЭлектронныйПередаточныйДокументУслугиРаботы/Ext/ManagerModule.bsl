#Область ПрограммныйИнтерфейс

#Область ПодготовкаДанныхЭДО

Функция ПодготовитьДанныеДляЭД(ДокументСсылка) Экспорт
	
	ПереченьИдентификаторовЭД = ДокументСсылка.ИдентификаторыСтрокДокументаОснования.Выгрузить(,"ИдентификаторЭД");
	
	Структура = ЭлектронныеДокументыБГУ.ДанныеПередаточногоДокумента(ДокументСсылка, ПереченьИдентификаторовЭД);
	
	Возврат Структура;
	
КонецФункции	

Функция ПредварительныйКонтрольДанныхДляЭД(ДокументСсылка, ФорматЭД = "") Экспорт
	Результат = Истина;
	
	ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		ДокументСсылка.Организация, ВидКИАдрес);
		
	Если НЕ ЗначениеЗаполнено(АдресОрганизации) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес организации.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Контрагент) Тогда
		ОписаниеОшибки = НСтр("ru='Для %1 не заполнен контрагент.'");
		ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка);
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	Иначе
		Контрагент = ДокументСсылка.Контрагент;
		
		Если ЗначениеЗаполнено(Контрагент.ЮридическоеФизическоеЛицо) Тогда
			Если ТипЗнч(Контрагент.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
			Иначе
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
			КонецЕсли;
			АдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Контрагент.ЮридическоеФизическоеЛицо, ВидКИАдрес);
			
			Если НЕ ЗначениеЗаполнено(АдресКонтрагента) Тогда
				ОписаниеОшибки = НСтр("ru='Для %1 не заполнен юридический адрес контрагента.'");
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка);
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;	
		Иначе
			ОписаниеОшибки = НСтр("ru='Для %1 не заполнено юридическое/физическое лицо контрагента.'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ПереченьИдентификаторовЭД = ДокументСсылка.ИдентификаторыСтрокДокументаОснования.Выгрузить(,"ИдентификаторЭД");
	
	Структура = ЭлектронныеДокументыБГУ.ДанныеПередаточногоДокумента(ДокументСсылка, ПереченьИдентификаторовЭД);
	УслугиОказанные = Структура.СписокНоменклатуры;
	
	Для Каждого ТекСтрока Из УслугиОказанные Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура.ЕдиницаИзмерения) Тогда
				ОписаниеОшибки = НСтр("ru='Для %1 не заполнена единица измерения в карточке номенклатуры в строке %2 таблицы на закладке ""Услуги"".'");
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка, ТекСтрока.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;
		Иначе
			ОписаниеОшибки = НСтр("ru='Для %1 не заполнена номенклатура в строке %2 таблицы на закладке ""Услуги"".'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЦикла;
	
	Если ФорматЭД = "УПД_2019" Тогда
	 	НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд = ЭлектронныеДокументыБГУ.ВидимостьДанныхЭДОПродавцаДляГосНужд(ДокументСсылка.Контрагент, ДокументСсылка.Организация);
		Если НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд Тогда
			ДанныеДляЭДПродавцаДляГосНужд = ЭлектронныеДокументыБГУ.ДанныеДляЭДПродавцаДляГосНужд(ДокументСсылка);
			Если НЕ ЗначениеЗаполнено(ДанныеДляЭДПродавцаДляГосНужд.ДатаГосКонтракта) Тогда
				ОписаниеОшибки = НСтр("ru='Для %1 не заполнена дата договора (гос.контракта) при реализации для государственных нужд. Следует заполнить реквизит ""от"" на закладке ""Обязательство"" значения реквизита документа ""Договор"".'");
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка);
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ДанныеДляЭДПродавцаДляГосНужд.НомерГосКонтракта) Тогда
				ОписаниеОшибки = НСтр("ru='Для %1 не заполнен номер договора (гос.контракта) при реализации для государственных нужд. Следует заполнить реквизит ""№"" на закладке ""Обязательство"" значения реквизита документа ""Договор"".'");
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка);
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ДанныеДляЭДПродавцаДляГосНужд.НомерЛицевогоСчетаПродавца) Тогда
				ОписаниеОшибки = НСтр("ru='Для %1 не заполнен номер лицевого счета при реализации для государственных нужд. Следует заполнить реквизит ""Реквизиты лицевого счета"" и повторно нажать кнопку ""Создать передаточные документы для ЭДО"".'");
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка);
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ДанныеДляЭДПродавцаДляГосНужд.КазначействоПродавцаКод) Тогда
				ОписаниеОшибки = НСтр("ru='Для %1 не заполнен код казначейства продавца при реализации для государственных нужд. Следует заполнить данные о казначействе реквизита ""Реквизиты лицевого счета"" и повторно нажать кнопку ""Создать передаточные документы для ЭДО"".'");
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка);
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ДанныеДляЭДПродавцаДляГосНужд.КазначействоПродавцаНаименование) Тогда
				ОписаниеОшибки = НСтр("ru='Для %1 не заполнено наименование казначейства продавца при реализации для государственных нужд. Следует заполнить данные о казначействе реквизита ""Реквизиты лицевого счета"" и повторно нажать кнопку ""Создать передаточные документы для ЭДО"".'");
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка);
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			КонецЕсли;	
		КонецЕсли;		
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

