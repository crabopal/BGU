&НаКлиенте
Процедура ЗаполнитьТекстПроСчетФактуруКлиент(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения)
	
	Перем ЗначениеСвойства;
	
	ЭтотДокументЯвляетсяОснованием = (ТипЗнч(ПараметрОбработкиОповещения) = Тип("Структура")
		И ПараметрОбработкиОповещения.Свойство("ДокументыОснования", ЗначениеСвойства)
		И ЗначениеСвойства.Найти(Объект.Ссылка) <> Неопределено);
	
	Если ЭтотДокументЯвляетсяОснованием Тогда
		ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено)
	Если (ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов"))  
		ИЛИ (ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.НачислениеЗаУслугиОбразования"))  
		ИЛИ (ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.НачислениеРодительскойПлаты"))  
		ИЛИ (ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.НачислениеСтудентамЗаПрочиеУслуги"))  
		ИЛИ (ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.НачислениеДоходов")) Тогда 
		СчетФактура = СчетФактураИзДокументаГруппыЭД();
	КонецЕсли;
	
	УчетНДС.ЗаполнитьТекстПроСчетФактуру(ЭтаФорма, ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	
КонецПРоцедуры

&НаСервере
Функция СчетФактураИзДокументаГруппыЭД()
	Результат = Документы.ЭлектронныйПередаточныйДокументУслугиРаботы.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СчетФактураВыданный.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	               |ГДЕ
	               |	СчетФактураВыданный.ДокументОснованиеЭДО = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура СчетФактураНажатие(Элемент, СтандартнаяОбработка)
	
	Если (НадписьСчетФактура = НСтр("ru = 'Ввести счет-фактуру'")) Тогда
		СтандартнаяОбработка = Ложь;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Для документа ""Списание доходов будущих периодов"" счета-фактуры вводятся с помощью специальной обработки-помощника,
		|которую можно открыть по кнопке ""Управление счетами-фактурами и печать"" в форме документа-основания.'");
		Сообщение.Сообщить();
	Иначе	
		ОбщегоНазначенияБГУКлиент.СчетФактураНажатие(СчетФактура, ЭтаФорма, СтандартнаяОбработка, "СчетФактураВыданный");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()

	ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы(ЭтотОбъект, Объект);
	
	СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора = ЭлектронныеДокументыБГУ.ЗначениеНастройкиСоздаватьПередаточныеДокументыПоКонтрагентуИДоговору(Объект.ДокументОснование);
	
	РеквизитыДокумента = Новый Структура;
	РеквизитыДокумента.Вставить("Контрагент", Объект.Контрагент);
	РеквизитыДокумента.Вставить("Договор", Объект.Договор);
	
	Если НЕ СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора И Объект.ИдентификаторыСтрокДокументаОснования.Количество()>0 Тогда
		РеквизитыДокумента.Вставить("ИдентификаторЭД", Объект.ИдентификаторыСтрокДокументаОснования[0].ИдентификаторЭД);
	КонецЕсли;	
	
	НомерЭД = ЭлектронныеДокументыБГУ.НомерПередаточногоДокументаЭД(Объект.ДокументОснование, РеквизитыДокумента, СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора);
	
	ПереченьИдентификаторовЭД = Объект.ИдентификаторыСтрокДокументаОснования.Выгрузить(,"ИдентификаторЭД");
	
	ДанныеПередаточногоДокумента = ЭлектронныеДокументыБГУ.ДанныеПередаточногоДокумента(Объект.Ссылка, ПереченьИдентификаторовЭД);
	СписокНоменклатуры.Загрузить(ДанныеПередаточногоДокумента.СписокНоменклатуры);
	ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	ИтогСуммаНДС = СписокНоменклатуры.Итог("СуммаНДС")
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДО(Форма, ВидимостьЭлементовЭДО, ВидимостьДанныхПродавца = Ложь)
	
	Объект = Форма.Объект;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаСостояниеЭДО", "Видимость", ВидимостьЭлементовЭДО);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаРеализацияДляГосНужд", "Видимость", ВидимостьЭлементовЭДО И ВидимостьДанныхПродавца);

КонецПроцедуры

