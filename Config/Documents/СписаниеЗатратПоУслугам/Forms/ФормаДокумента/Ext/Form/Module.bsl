&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ТипКПСПоУчетнойПолитике = БухгалтерскийУчетПовтИсп.ТипКПСПоУчетнойПолитике(
		Объект.Организация, Объект.ИФО, Объект.КФО, ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ДатаПоследнегоИзменения);
	ПроизвольнаяАналитикаКПС = (ТипКПСПоУчетнойПолитике = ПредопределенноеЗначение("Перечисление.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация"));
	
	ОтражатьВНалоговомУчете = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(Объект.КФО);
	
	ТекущийРежимОтображения = Объект.РежимОтображения;
	
	УстановитьПараметрыСчетовУчета();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ЗаполнитьТаблицыНаФормеПоТабличнымЧастям(ДокументОбъект);
	
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицыНаФормеПоТабличнымЧастям(ДокументОбъект)
	
	// Заполним таблицы значений на форме по табличным частям документа.
	СтруктураТаблиц = ДокументОбъект.ПолучитьСводнуюИДетальныеТаблицыЗатратПоТабЧастям(Объект.РежимОтображения);
	ЗатратыСводно.Загрузить(СтруктураТаблиц.ЗатратыСводно);
	ЗатратыДетально.Загрузить(СтруктураТаблиц.ЗатратыДетально);
	ЗатратыДетальноНУ.Загрузить(СтруктураТаблиц.ЗатратыДетальноНУ);
	
	ЗатратыСводноЗаполнитьДобавленныеКолонки();
	ЗатратыДетальноЗаполнитьДобавленныеКолонки();
	ЗатратыДетальноНУЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличныеЧастиПоТаблицамНаФорме()
	
	Объект.ЗатратыПрямые.Очистить();
	Объект.ЗатратыОбщие.Очистить();
	Объект.ЗатратыНУ.Очистить();
	
	Если НЕ ОтражатьВНалоговомУчете Тогда
		ЗатратыДетальноНУ.Очистить();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗатратыСводно",     ЗатратыСводно.Выгрузить());
	Запрос.УстановитьПараметр("ЗатратыДетально",   ЗатратыДетально.Выгрузить());
	Запрос.УстановитьПараметр("ЗатратыДетальноНУ", ЗатратыДетальноНУ.Выгрузить());
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗатратыСводно.КлючСтроки КАК КлючСтроки,
	|	ЗатратыСводно.ТипЗатрат,
	|	ЗатратыСводно.Номенклатура,
	|	ЗатратыСводно.СчетДт,
	|	ЗатратыСводно.КПСДт,
	|	ЗатратыСводно.КЭКДт,
	|	ЗатратыСводно.ПодразделениеДт,
	|	ЗатратыСводно.СубконтоДт1,
	|	ЗатратыСводно.СубконтоДт2,
	|	ЗатратыСводно.СубконтоДт3
	|ПОМЕСТИТЬ ЗатратыСводно
	|ИЗ
	|	&ЗатратыСводно КАК ЗатратыСводно
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗатратыДетально.КлючСтроки КАК КлючСтроки,
	|	ЗатратыДетально.ВидЗатрат,
	|	ЗатратыДетально.СчетКт,
	|	ЗатратыДетально.КПСКт,
	|	ЗатратыДетально.КЭККт,
	|	ЗатратыДетально.ПодразделениеКт,
	|	ЗатратыДетально.ДопСубконто,
	|	ЗатратыДетально.Сумма
	|ПОМЕСТИТЬ ЗатратыДетально
	|ИЗ
	|	&ЗатратыДетально КАК ЗатратыДетально
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗатратыДетальноНУ.КлючСтроки КАК КлючСтроки,
	|	ЗатратыДетальноНУ.ВидЗатрат,
	|	ЗатратыДетальноНУ.СчетКт,
	|	ЗатратыДетальноНУ.ПодразделениеКт,
	|	ЗатратыДетальноНУ.ДопСубконто,
	|	ЗатратыДетальноНУ.Сумма,
	|	ЗатратыДетальноНУ.СуммаЕНВД,
	|	ЗатратыДетальноНУ.СуммаНеУчитываетсяНУ
	|ПОМЕСТИТЬ ЗатратыДетальноНУ
	|ИЗ
	|	&ЗатратыДетальноНУ КАК ЗатратыДетальноНУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗатратыДетально.ВидЗатрат,
	|	ЗатратыДетально.СчетКт,
	|	ЗатратыДетально.КПСКт,
	|	ЗатратыДетально.КЭККт,
	|	ЗатратыДетально.ПодразделениеКт,
	|	ЗатратыДетально.ДопСубконто,
	|	ЗатратыДетально.Сумма,
	|	ЗатратыСводно.ТипЗатрат,
	|	ЗатратыСводно.Номенклатура,
	|	ЗатратыСводно.СчетДт,
	|	ЗатратыСводно.КПСДт,
	|	ЗатратыСводно.КЭКДт,
	|	ЗатратыСводно.ПодразделениеДт,
	|	ЗатратыСводно.СубконтоДт1,
	|	ЗатратыСводно.СубконтоДт2,
	|	ЗатратыСводно.СубконтоДт3
	|ИЗ
	|	ЗатратыДетально КАК ЗатратыДетально
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗатратыСводно КАК ЗатратыСводно
	|		ПО ЗатратыДетально.КлючСтроки = ЗатратыСводно.КлючСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗатратыДетальноНУ.ВидЗатрат,
	|	ЗатратыДетальноНУ.СчетКт,
	|	ЗатратыДетальноНУ.ПодразделениеКт,
	|	ЗатратыДетальноНУ.ДопСубконто,
	|	ЗатратыДетальноНУ.Сумма,
	|	ЗатратыДетальноНУ.СуммаЕНВД,
	|	ЗатратыДетальноНУ.СуммаНеУчитываетсяНУ,
	|	ЗатратыСводно.ТипЗатрат,
	|	ЗатратыСводно.Номенклатура,
	|	ЗатратыСводно.СчетДт,
	|	ЗатратыСводно.КПСДт,
	|	ЗатратыСводно.КЭКДт,
	|	ЗатратыСводно.ПодразделениеДт,
	|	ЗатратыСводно.СубконтоДт1,
	|	ЗатратыСводно.СубконтоДт2,
	|	ЗатратыСводно.СубконтоДт3
	|ИЗ
	|	ЗатратыДетальноНУ КАК ЗатратыДетальноНУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗатратыСводно КАК ЗатратыСводно
	|		ПО ЗатратыДетальноНУ.КлючСтроки = ЗатратыСводно.КлючСтроки";
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("ЗатратыСводно",     НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ЗатратыДетально",   НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ЗатратыДетальноНУ", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаЗатратБУ",   НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаЗатратНУ",   НомераТаблиц.Количество());
	
	Результат = Запрос.ВыполнитьПакет();
	
	// Заполняем табличные части документа
	
	ТаблицаЗатратБУ = Результат[НомераТаблиц.ТаблицаЗатратБУ].Выгрузить();
	Для Каждого СтрокаЗатрат из ТаблицаЗатратБУ Цикл
		
		Если СтрокаЗатрат.ТипЗатрат = "СебестоимостьУслуг" Тогда
			НоваяСтрока = Объект.ЗатратыПрямые.Добавить();
		Иначе
			НоваяСтрока = Объект.ЗатратыОбщие.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗатрат);
		
		// Заполним значение доп. субконто
		СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
		Если СтрокаЗатрат.ТипЗатрат = "СебестоимостьУслуг" Тогда
			Если СвойстваСчетаКт.ВидСубконто3 = ВидДопСубконто Тогда
				НоваяСтрока.СубконтоКт3 = СтрокаЗатрат.ДопСубконто;
			КонецЕсли;
		Иначе
			Если СвойстваСчетаКт.ВидСубконто2 = ВидДопСубконто Тогда
				НоваяСтрока.СубконтоКт2 = СтрокаЗатрат.ДопСубконто;
			ИначеЕсли СвойстваСчетаКт.ВидСубконто3 = ВидДопСубконто Тогда
				НоваяСтрока.СубконтоКт3 = СтрокаЗатрат.ДопСубконто;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОтражатьВНалоговомУчете Тогда
		
		ТаблицаЗатратНУ = Результат[НомераТаблиц.ТаблицаЗатратНУ].Выгрузить();
		Для Каждого СтрокаЗатрат из ТаблицаЗатратНУ Цикл
			
			НоваяСтрока = Объект.ЗатратыНУ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗатрат);
			
			// Заполним значение доп. субконто
			СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
			Если СвойстваСчетаКт.ВидСубконто2 = ВидДопСубконто Тогда
				НоваяСтрока.СубконтоКт2 = СтрокаЗатрат.ДопСубконто;
			ИначеЕсли СвойстваСчетаКт.ВидСубконто3 = ВидДопСубконто Тогда
				НоваяСтрока.СубконтоКт3 = СтрокаЗатрат.ДопСубконто;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()

	ДоступностьЭлементов = ЗначениеЗаполнено(Объект.Организация);
	Элементы.КФО.Доступность = ДоступностьЭлементов;

КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыСчетовУчета()

	ОбщиеПараметрыУчетаРасходов = Документы.СписаниеЗатратПоУслугам.ПолучитьОбщиеПараметрыУчетаРасходов();
	
	// Доступность элементов таблицы ЗатратыСводно
	Элементы.ЗатратыСводноПодразделениеДт.Видимость = ОбщиеПараметрыУчетаРасходов.ФинРезультатЕстьУчетПоПодразделениям;
	
	// Доступность элементов таблиц ЗатратыДетально и ЗатратыДетальноНУ
	ЭтаФорма.ЕстьДопСубконтоБУ = ОбщиеПараметрыУчетаРасходов.ЗатратыЕстьДопСубконтоБУ;
	Элементы.ЗатратыДетальноДопСубконто.Видимость   = ЭтаФорма.ЕстьДопСубконтоБУ;
	
	ЭтаФорма.ЕстьДопСубконтоНУ = ОбщиеПараметрыУчетаРасходов.ЗатратыЕстьДопСубконтоНУ;
	Элементы.ЗатратыДетальноНУДопСубконто.Видимость = ЭтаФорма.ЕстьДопСубконтоНУ;
	
	ЭтаФорма.ВидДопСубконто = ОбщиеПараметрыУчетаРасходов.ЗатратыВидДопСубконто;
	Элементы.ЗатратыДетальноДопСубконто.Заголовок   = "Направление деятельности";
	Элементы.ЗатратыДетальноНУДопСубконто.Заголовок = "Направление деятельности";
	Элементы.ЗатратыДетальноДопСубконто.ОграничениеТипа   = ОбщиеПараметрыУчетаРасходов.ЗатратыВидДопСубконто.ТипЗначения;
	Элементы.ЗатратыДетальноНУДопСубконто.ОграничениеТипа = ОбщиеПараметрыУчетаРасходов.ЗатратыВидДопСубконто.ТипЗначения;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма)
	
	СуммыНУ = Новый Массив;
	СуммыНУ.Добавить("ЗатратыСводноСуммаНУ");
	СуммыНУ.Добавить("ЗатратыСводноСуммаНеУчитываетсяНУ");
	СуммыНУ.Добавить("ЗатратыСводноСуммаЕНВД");
	СуммыНУ.Добавить("ЗатратыСводноЗаголовокСуммаНУ");
	СуммыНУ.Добавить("ЗатратыСводноЗаголовокСуммаНеУчитываетсяНУ");
	СуммыНУ.Добавить("ЗатратыСводноЗаголовокСуммаЕНВД");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		СуммыНУ, "Видимость", Форма.ОтражатьВНалоговомУчете);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СтраницаНалоговыйУчет", "Видимость", Форма.ОтражатьВНалоговомУчете);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекущуюСтраницуТаблицыЗатратыДетально()
	
	Если ОтражатьВНалоговомУчете Тогда
		
		Если Объект.РежимОтображения > 0 Тогда
			ТекущиеДанные = Элементы.ЗатратыСводно.ТекущиеДанные;
			ЭтоСтрокаЗатратНУ = (ТекущиеДанные <> Неопределено И ТекущиеДанные.Сумма <> 0);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ЗатратыДетальноСтраницыБУиНУ", "ТекущаяСтраница",
					?(ЭтоСтрокаЗатратНУ, Элементы.СтраницаБухгалтерскийУчет, Элементы.СтраницаНалоговыйУчет));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьДанныеВДокументе()
	
	Возврат (Объект.ЗатратыПрямые.Количество() > 0)
		ИЛИ (Объект.ЗатратыОбщие.Количество() > 0)
		ИЛИ (Объект.ЗатратыНУ.Количество() > 0);
	
КонецФункции

&НаСервере
Функция РассчитатьИтоговуюСуммуПоСтрокам(ИмяТаблицы, ИмяКолонки="Сумма")

	ОтборСтрок  = ОбщегоНазначенияБГУКлиентСервер.СтруктураИзФиксированнойСтруктуры(Элементы[ИмяТаблицы].ОтборСтрок);
	МассивСтрок = ЭтаФорма[ИмяТаблицы].НайтиСтроки(ОтборСтрок);
	
	ИтоговаяСумма = 0;
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ИтоговаяСумма = ИтоговаяСумма + СтрокаТаблицы[ИмяКолонки];
	КонецЦикла;
	
	Возврат ИтоговаяСумма;

КонецФункции


