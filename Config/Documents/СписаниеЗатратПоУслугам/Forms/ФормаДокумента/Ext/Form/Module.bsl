&НаКлиенте
Процедура УстановитьОтборДетальныхСтрок()
	
	ТекущиеДанные  = Элементы.ЗатратыСводно.ТекущиеДанные;
	СтруктураОтбор = Новый Структура("КлючСтроки", ?(ТекущиеДанные=Неопределено, "", ТекущиеДанные.КлючСтроки));
	Если НЕ ЗначениеЗаполнено(СтруктураОтбор.КлючСтроки) Тогда
		СтруктураОтбор.Вставить("КлючСтроки", "{НеПоказыватьДетальныеСтроки}");
	КонецЕсли;
	
	Элементы.ЗатратыДетально.ОтборСтрок   = Новый ФиксированнаяСтруктура(СтруктураОтбор);
	Элементы.ЗатратыДетальноНУ.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбор);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокиДетализации(ОтборСтрок)
	
	МассивСтрок = ЭтаФорма["ЗатратыДетально"].НайтиСтроки(ОтборСтрок);
	Для каждого Строка Из МассивСтрок Цикл
		ЗатратыДетально.Удалить(Строка);
	КонецЦикла; 
	
	МассивСтрокНУ = ЭтаФорма["ЗатратыДетальноНУ"].НайтиСтроки(ОтборСтрок);
	Для каждого Строка Из МассивСтрокНУ Цикл
		ЗатратыДетальноНУ.Удалить(Строка);
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗатратыСводноПоляАналитикиСчетаСписания()

	// Пути к данным полей аналитики счета, выбираемого в таблице формы.
	Возврат Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
		"ЗатратыСводно.СчетДт",
		"ЗатратыСводно.СубконтоДт1",
		"ЗатратыСводно.СубконтоДт2",
		"ЗатратыСводно.СубконтоДт3");
	// Здесь только поля, управление которыми осуществляется стандартным образом.
	// Поля КПСДт, КЭКДт, ПодразделениеДт обрабатываются особым образом,
	// т.к. для них доступны "особые" настройки "Взять из Кт".

КонецФункции

&НаСервере
Процедура ЗатратыСводноЗаполнитьДобавленныеКолонки()
	
	Для Каждого СтрокаТаблицы Из ЗатратыСводно Цикл
		
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаТаблицы, СтрокаТаблицы.СчетДт, ЗатратыСводноПоляАналитикиСчетаСписания());
		ЗатратыСводноУстановитьДоступностьПодразделенияДт(СтрокаТаблицы);
		ЗатратыСводноОбновитьТекстЗаголовковВСтрокеТаблицы(СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗатратыСводноУстановитьДоступностьПодразделенияДт(СтрокаСводно)

	СвойстваСчетаДт = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СтрокаСводно.СчетДт);
	СтрокаСводно.ПодразделениеДтДоступность = СвойстваСчетаДт.УчетПоПодразделениям;
	СтрокаСводно.ПодразделениеДтОбязательно = НЕ СвойстваСчетаДт.РазрешитьНеУказыватьПодразделение;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗатратыСводноОбновитьТекстЗаголовковВСтрокеТаблицы(СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокСуммаНУ              = НСтр("ru = 'Сумма (НУ):'");
	СтрокаТаблицы.ЗаголовокСуммаНеУчитываетсяНУ = НСтр("ru = 'Не уч. (НУ):'");
	СтрокаТаблицы.ЗаголовокСуммаЕНВД            = НСтр("ru = 'ЕНВД (НУ):'");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ЗатратыДетально

&НаКлиенте
Процедура ЗатратыДетальноПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	СводныеДанные = Элементы.ЗатратыСводно.ТекущиеДанные;
	
	Если СводныеДанные=Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗатратыДетальноПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ЗатратыДетально.ТекущиеДанные;
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтаФорма, ТекущиеДанные.СчетКт, ЗатратыДетальноПоляАналитикиСчетаЗатрат());
	
КонецПроцедуры

&НаКлиенте
Процедура ЗатратыДетальноПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	СводныеДанные = Элементы.ЗатратыСводно.ТекущиеДанные;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		Элемент.ТекущиеДанные.КлючСтроки = СводныеДанные.КлючСтроки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗатратыДетальноПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	СводныеДанные = Элементы.ЗатратыСводно.ТекущиеДанные;
	Если СводныеДанные<>Неопределено Тогда
		СводныеДанные.Сумма = РассчитатьИтоговуюСуммуПоСтрокам("ЗатратыДетально");
	КонецЕсли;
	
КонецПроцедуры

