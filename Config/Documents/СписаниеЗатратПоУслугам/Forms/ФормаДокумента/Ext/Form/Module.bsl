&НаКлиенте
Процедура ЗатратыДетальноСчетКтПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ЗатратыДетально.ТекущиеДанные;
	
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
		ТекущиеДанные, ТекущиеДанные.СчетКт, ЗатратыДетальноПоляАналитикиСчетаЗатрат());
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтаФорма, ТекущиеДанные.СчетКт, ЗатратыДетальноПоляАналитикиСчетаЗатрат());
	
	УстановитьДоступностьДопСубконто(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗатратыДетальноСчетКтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ЗатратыДетально.ТекущиеДанные;
	
	НайденныеСтроки = ЗатратыСводно.НайтиСтроки(Новый Структура("КлючСтроки", ТекущиеДанные.КлючСтроки));
	Если НайденныеСтроки.Количество()>0 Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыСчета = Новый Структура();
		Если НайденныеСтроки[0].ТипЗатрат = "СебестоимостьУслуг" Тогда
			ПараметрыСчета.Вставить("ОграниченияСписокСчетов", БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов("109.60"));
		ИначеЕсли НайденныеСтроки[0].ТипЗатрат = "НакладныеРасходы" Тогда
			ПараметрыСчета.Вставить("ОграниченияСписокСчетов", БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов("109.70"));
		ИначеЕсли НайденныеСтроки[0].ТипЗатрат = "ОбщехозяйственныеРасходы" Тогда
			ПараметрыСчета.Вставить("ОграниченияСписокСчетов", БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов("109.80"));
		ИначеЕсли НайденныеСтроки[0].ТипЗатрат = "ИздержкиОбращения" Тогда
			ПараметрыСчета.Вставить("ОграниченияСписокСчетов", БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов("109.90"));
		КонецЕсли;
		
		ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыСчета, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

