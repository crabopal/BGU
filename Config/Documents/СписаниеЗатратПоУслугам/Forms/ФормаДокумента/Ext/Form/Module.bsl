&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.КФО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'КФО'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.КФО");
		Возврат;
	КонецЕсли;
	
	ЕстьДанныеВДокументе = ЕстьДанныеВДокументе();
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено, а данные будут очищены. Заполнить?'");
	ИначеЕсли Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено. Заполнить?'");
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут очищены. Заполнить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьДокументЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьДокументНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьДокументЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДокументНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументНаСервере()

	Объект.ЗатратыПрямые.Очистить();
	Объект.ЗатратыОбщие.Очистить();
	Объект.ЗатратыНУ.Очистить();

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьДокументПоОстаткам();
	
	ЗаполнитьТаблицыНаФормеПоТабличнымЧастям(ДокументОбъект);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСчетДт(Команда)
	
	ТекущиеДанные = Элементы.ЗатратыСводно.ТекущиеДанные;
	
	Если Объект.РежимОтображения > 0 И ТекущиеДанные.Сумма = 0 Тогда
		ПоказатьПредупреждение(,НСтр("ru= 'Установка счета и субконто списания (Дт) недоступна для затрат НУ.'"));
		Возврат;
	КонецЕсли;
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	СтруктураТекущиеЗначения = Новый Структура("Организация,Дата,ИФО,КФО,ПроизвольнаяАналитикаКПС,"
		+"СчетДт, КПСДт, КЭКДт, ПодразделениеДт, СубконтоДт1, СубконтоДт2, СубконтоДт3",
		Объект.Организация, Объект.Дата, Объект.ИФО, Объект.КФО);
		
	Если ТекущиеДанные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(СтруктураТекущиеЗначения, ТекущиеДанные);
	КонецЕсли;
	СтруктураТекущиеЗначения.ПроизвольнаяАналитикаКПС = ЭтаФорма.ПроизвольнаяАналитикаКПС;
	
	Оповещение = Новый ОписаниеОповещения(
		"ЗакрытиеФормыВводаСчетаДебетаЗавершение",
		ЭтотОбъект);
	
	ПараметрыФормы = Новый Структура("ТекущиеЗначения", СтруктураТекущиеЗначения);
	Результат = ОткрытьФорму("Документ.СписаниеЗатратПоУслугам.Форма.ФормаВводаСчетаДебета",
		ПараметрыФормы, ЭтаФорма,,,, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеФормыВводаСчетаДебетаЗавершение(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		ВыделенныеСтроки = Элементы.ЗатратыСводно.ВыделенныеСтроки;
		Если ЗатратыСводно.Количество() > 1 И ВыделенныеСтроки.Количество() = 1 Тогда
			
			Оповещение = Новый ОписаниеОповещения(
				"ВопросУстановитьСчетаСписанияЗавершение",
				ЭтотОбъект, Результат);
				
			ТекстВопроса = НСтр("ru='Выделена только одна строка таблицы.
				|Установить счет и аналитику списания во всех строках таблицы?'");
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да,  НСтр("ru='Во всех строках'"));
			Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='В выделенной строке'"));
			
			ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, 15, КодВозвратаДиалога.Да, "Установить значения");
			
		Иначе
			УстановитьСчетаСписания(Результат, ВыделенныеСтроки);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросУстановитьСчетаСписанияЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда // В выделенной строке
		ВыделенныеСтроки = Элементы.ЗатратыСводно.ВыделенныеСтроки;
		УстановитьСчетаСписания(Параметры, ВыделенныеСтроки);
	Иначе // Во всех строках
		УстановитьСчетаСписания(Параметры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСчетаСписания(ВыбранныеЗначения, ВыделенныеСтроки = Неопределено)

	Для каждого СтрокаСводно Из ЗатратыСводно Цикл
	
		Если ЗначениеЗаполнено(ВыделенныеСтроки) И ВыделенныеСтроки.Количество() > 0 Тогда
			Если ВыделенныеСтроки.Найти(СтрокаСводно.ПолучитьИдентификатор()) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если Объект.РежимОтображения <> 0 И СтрокаСводно.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаСводно, ВыбранныеЗначения);
		
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаСводно, СтрокаСводно.СчетДт, ЗатратыСводноПоляАналитикиСчетаСписания());
		БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
			ЭтаФорма, СтрокаСводно.СчетДт, ЗатратыСводноПоляАналитикиСчетаСписания());
		
		ЗатратыСводноУстановитьДоступностьПодразделенияДт(СтрокаСводно);
		
		МассивСчетов40120 = БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("401.20");
		СтрокаСводно.СчетДт40120 = (МассивСчетов40120.Найти(СтрокаСводно.СчетДт) <> Неопределено);
		
	КонецЦикла;

КонецПроцедуры

