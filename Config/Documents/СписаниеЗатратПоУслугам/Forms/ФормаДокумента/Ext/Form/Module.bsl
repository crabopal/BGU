Процедура ЗатратыСводноПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.ЗатратыСводно.ТекущиеДанные;
		ЗатратыСводноОбновитьТекстЗаголовковВСтрокеТаблицы(ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗатратыСводноПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если НоваяСтрока И Не ОтменаРедактирования Тогда
		
		СтруктураОтбор = Новый Структура("КлючСтроки", ТекущиеДанные.КлючСтроки);
		
		ТекущиеДанные.КлючСтроки = Строка(Новый УникальныйИдентификатор); // сформируем новый КлючСтроки
		
		// Скопируем детальные строки БУ
		МассивСтрок = ЗатратыДетально.НайтиСтроки(СтруктураОтбор);
		Для каждого СтрокаДетально Из МассивСтрок Цикл
			НоваяСтрокаДетально = ЗатратыДетально.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДетально, СтрокаДетально,, "КлючСтроки");
			НоваяСтрокаДетально.КлючСтроки = ТекущиеДанные.КлючСтроки;
		КонецЦикла;
		
		// Скопируем детальные строки НУ
		Если ОтражатьВНалоговомУчете Тогда
			МассивСтрок = ЗатратыДетальноНУ.НайтиСтроки(СтруктураОтбор);
			Для каждого СтрокаДетально Из МассивСтрок Цикл
				НоваяСтрокаДетально = ЗатратыДетальноНУ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаДетально, СтрокаДетально,, "КлючСтроки");
				НоваяСтрокаДетально.КлючСтроки = ТекущиеДанные.КлючСтроки;
			КонецЦикла;
		КонецЕсли;
		
		УстановитьОтборДетальныхСтрок();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗатратыСводноПередУдалением(Элемент, Отказ)
	
	Для каждого ТекСтрока Из Элемент.ВыделенныеСтроки Цикл
	
		ДанныеТекСтроки = Элементы.ЗатратыСводно.ДанныеСтроки(ТекСтрока);
		УдалитьСтрокиДетализации(Новый Структура("КлючСтроки", ДанныеТекСтроки.КлючСтроки));
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗатратыСводноСчетДтПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЗатратыСводно.ТекущиеДанные;
	
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
		ТекущиеДанные, ТекущиеДанные.СчетДт, ЗатратыСводноПоляАналитикиСчетаСписания());
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтаФорма, ТекущиеДанные.СчетДт, ЗатратыСводноПоляАналитикиСчетаСписания());
	
	ЗатратыСводноУстановитьДоступностьПодразделенияДт(ТекущиеДанные);
	
	МассивСчетов40120 = БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов("401.20");
	ТекущиеДанные.СчетДт40120 = (МассивСчетов40120.Найти(ТекущиеДанные.СчетДт) <> Неопределено);
	
КонецПроцедуры

