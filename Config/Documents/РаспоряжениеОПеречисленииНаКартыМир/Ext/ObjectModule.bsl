#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	РазницаШапкиИИтогаТЧ = СуммаДокумента - РасшифровкаПлатежа.Итог("Сумма");
	
	Если РазницаШапкиИИтогаТЧ <> 0 Тогда
		ТекстСообщения = НСтр("ru='Сумма документа не равна сумме расшифровки платежа. Не распределена сумма: '") + Формат((РазницаШапкиИИтогаТЧ), "ЧДЦ=2");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "СуммаДокумента", "Объект",Отказ);
	КонецЕсли;
	
	НеПроверяемыеРеквизиты = Новый Массив;
	
	Если СотрудникКонтрагент = 0 Тогда
		НепроверяемыеРеквизиты.Добавить("Состав.Контрагент");
	Иначе
		НепроверяемыеРеквизиты.Добавить("Состав.Сотрудник");
	КонецЕсли;
	
	Если Не ОбщегоНазначенияБГУПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
		НепроверяемыеРеквизиты.Добавить("ИФО");
		НепроверяемыеРеквизиты.Добавить("Состав.ИФО");
	ИначеЕсли ЗначениеЗаполнено(ДокументОснование) Тогда
		НепроверяемыеРеквизиты.Добавить("ИФО");
	Иначе
		НепроверяемыеРеквизиты.Добавить("Состав.ИФО");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Очистка табличной части РасшифровкаПлатежа от строк, не имеющих "родителя" в ТЧ Состав
	// Синхронизация общих реквизитов табличных частей Состав и РасшифровкаПлатежа
	ПоляСостава = Новый Массив;
	Для Каждого РеквизитСостава Из ЭтотОбъект.Метаданные().ТабличныеЧасти.Состав.Реквизиты Цикл
		Если НЕ РеквизитСостава.Имя = "Сумма"
			И НЕ РеквизитСостава.Имя = "ПлатежнаяКарта" 
		//	И НЕ РеквизитСостава.Имя = "ВидВыплатНаКартуМИР"
			И НЕ РеквизитСостава.Имя = "КодВидаДохода"
			И НЕ РеквизитСостава.Имя = "Взыскано" 
			И НЕ РеквизитСостава.Имя = "Ошибка"  
			И НЕ РеквизитСостава.Имя = "ОписаниеОшибки"
			И НЕ РеквизитСостава.Имя = "Сотрудник"
			И НЕ РеквизитСостава.Имя = "НомерПлатежнойКарты"
			И НЕ РеквизитСостава.Имя = "ДатаРожденияДержателяКарты" Тогда

			ПоляСостава.Добавить(РеквизитСостава.Имя);
		КонецЕсли;
	КонецЦикла;
	СписокСвойств = СтрСоединить(ПоляСостава, ", ");
	
	ЛишниеСтроки = Новый Массив;
	Для Каждого СтрокаРасшифровки Из ЭтотОбъект.РасшифровкаПлатежа Цикл
		СтрокаСостава = ЭтотОбъект.Состав.Найти(СтрокаРасшифровки.ИдентификаторСтроки, "ИдентификаторСтроки");
		Если СтрокаСостава = Неопределено Тогда
			ЛишниеСтроки.Добавить(СтрокаРасшифровки);
		Иначе
			ЗаполнитьЗначенияСвойств(СтрокаРасшифровки, СтрокаСостава, СписокСвойств);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЛишняяСтрока Из ЛишниеСтроки Цикл
		ЭтотОбъект.РасшифровкаПлатежа.Удалить(ЛишняяСтрока);
	КонецЦикла;
	
	Получатели = Новый Массив;
	Для Каждого СтрокаСотрудник Из Состав Цикл
		Получатели.Добавить(Справочники.Контрагенты.ФамилияИО(СтрокаСотрудник.Контрагент));
	КонецЦикла;
	Получатели = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Получатели);
	КраткийСоставДокумента = СтрСоединить(Получатели, ", ");
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПлатежноРасчетныеДокументы.ПриЗаписиНаСервереУстановкаСтатуса(Отказ, ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	GUID = Строка(Новый УникальныйИдентификатор());
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеестрВедомостейНаВыплатуЗарплаты") Тогда
		ЗаполнитьПоРееструВедомостейНаВыплатуЗарплаты(ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	GUID = Строка(Новый УникальныйИдентификатор());
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Отказ = ПлатежноРасчетныеДокументы.ВыполнитьДвиженияПлатежноРасчетногоДокумента(ЭтотОбъект);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ЗаполнитьПоРееструВедомостейНаВыплатуЗарплаты(ДанныеЗаполнения)
	
	ДокументОснование = ДанныеЗаполнения.Ссылка;
    Организация = ДанныеЗаполнения.Организация;
	
	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(ДанныеЗаполнения.Организация, "Документ.РаспоряжениеОПеречисленииНаКартыМир", ДанныеЗаполнения.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
	
	Если ЗначениеЗаполнено(Умолчания.ЛицевойСчет) Тогда
		ЛицевойСчет = Умолчания.ЛицевойСчет;
		РеквизитыЛицевогоСчета = Умолчания.РеквизитыЛицевогоСчета;
		ОрганКазначейства = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыЛицевогоСчета, "КассовыйОрган");
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(ЛицевойСчет,, Новый Структура("ПерваяПодпись,ВтораяПодпись")));
	КонецЕсли;
				
	ДопустимыеКФО = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеКФО(,ЛицевойСчет);
	СписокДопустимыхКФО = Новый СписокЗначений;
	СписокДопустимыхКФО.ЗагрузитьЗначения(ДопустимыеКФО); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.Контрагент КАК Контрагент,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.Сотрудник КАК Сотрудник,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КодЦели КАК КодЦели,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.ВидВыплатНаКартуМИР КАК ВидВыплатНаКартуМИР,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КПС КАК КПС,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КФО КАК КФО,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КЭК КАК КЭК,
	               |	СУММА(РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.Сумма) КАК Сумма,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.ИФО КАК ИФО,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.Подразделение КАК Подразделение,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КодВидаДохода КАК КодВидаДохода,
	               |	1 КАК КоличествоСтрок
	               |ИЗ
	               |	Документ.РеестрВедомостейНаВыплатуЗарплаты.РасшифровкаПлатежа КАК РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа
	               |ГДЕ
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.ИдентификаторСтроки,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.Контрагент,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.Сотрудник,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КодМероприятия,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.ДопКлассификация,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КодЦели,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.ВидВыплатНаКартуМИР,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КПС,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КФО,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КЭК,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.ИФО,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.Подразделение,
	               |	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КодВидаДохода
	               |ИТОГИ
	               |	СУММА(КоличествоСтрок)
	               |ПО
	               |	ИдентификаторСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РеестрВедомостейНаВыплатуЗарплатыСостав.Ссылка КАК Ссылка,
	               |	РеестрВедомостейНаВыплатуЗарплатыСостав.НомерСтроки КАК НомерСтроки,
	               |	РеестрВедомостейНаВыплатуЗарплатыСостав.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	РеестрВедомостейНаВыплатуЗарплатыСостав.Контрагент КАК Контрагент,
	               |	РеестрВедомостейНаВыплатуЗарплатыСостав.ДатаРожденияДержателяКарты КАК ДатаРожденияДержателяКарты,
	               |	РеестрВедомостейНаВыплатуЗарплатыСостав.НомерПлатежнойКарты КАК НомерПлатежнойКарты,
	               |	РеестрВедомостейНаВыплатуЗарплатыСостав.Сумма КАК Сумма,
	               |	РеестрВедомостейНаВыплатуЗарплатыСостав.Взыскано КАК Взыскано
	               |ИЗ
	               |	Документ.РеестрВедомостейНаВыплатуЗарплаты.Состав КАК РеестрВедомостейНаВыплатуЗарплатыСостав
	               |ГДЕ
	               |	РеестрВедомостейНаВыплатуЗарплатыСостав.Ссылка = &Ссылка";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаПоСтроке = Результат[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТЗ_Состав = Результат[1].Выгрузить();
	ТЗ_Состав.Индексы.Добавить("ИдентификаторСтроки");
	
	Состав.Очистить();
	РасшифровкаПлатежа.Очистить();
	
	Пока ВыборкаПоСтроке.Следующий() Цикл
		
		НайденнаяСтрока = ТЗ_Состав.Найти(ВыборкаПоСтроке.ИдентификаторСтроки, "ИдентификаторСтроки");
		
		Если НайденнаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоСтрок = ВыборкаПоСтроке.КоличествоСтрок;
		
		Коэффициенты = Новый Массив;
		Для К = 1 По КоличествоСтрок Цикл
			Коэффициенты.Добавить(КоличествоСтрок);
		КонецЦикла;
		
		СуммаВзыскано = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(НайденнаяСтрока.Взыскано, Коэффициенты);
		
		ИндексСтроки = 0;
		
		ВыборкаДетальная = ВыборкаПоСтроке.Выбрать();
		Пока ВыборкаДетальная.Следующий() Цикл
							
			ИдентификаторСтроки = Новый УникальныйИдентификатор();
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ЛицевойСчет", ЛицевойСчет);
			ПараметрыОтбора.Вставить("КФО", ВыборкаДетальная.КФО);
			РазделЛицевогоСчета = ПолучитьРазделЛицевогоСчета(ПараметрыОтбора);
			
			// ТЗ Состав
			НоваяСтрокаСостав = Состав.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСостав, ВыборкаДетальная);
			НоваяСтрокаСостав.ИдентификаторСтроки = ИдентификаторСтроки;
			НоваяСтрокаСостав.НомерПлатежнойКарты = НайденнаяСтрока.НомерПлатежнойКарты;
			НоваяСтрокаСостав.ДатаРожденияДержателяКарты = НайденнаяСтрока.ДатаРожденияДержателяКарты;
			НоваяСтрокаСостав.РазделЛицевогоСчета = РазделЛицевогоСчета;
			НоваяСтрокаСостав.Взыскано = ?(СуммаВзыскано = Неопределено, "", СуммаВзыскано[ИндексСтроки]);
			
			Если СписокДопустимыхКФО.НайтиПоЗначению(НоваяСтрокаСостав.КФО) = Неопределено Тогда
				НоваяСтрокаСостав.КФО = Перечисления.КВД.ПустаяСсылка();
			КонецЕсли;
			
			// ТЗ Расшифровка платеж
			НоваяСтрокаРП = РасшифровкаПлатежа.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРП, ВыборкаДетальная);
			НоваяСтрокаРП.ИдентификаторСтроки = ИдентификаторСтроки;
			НоваяСтрокаРП.РазделЛицевогоСчета = РазделЛицевогоСчета;
			
			ИндексСтроки = ИндексСтроки + 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	СуммаДокумента = РасшифровкаПлатежа.Итог("Сумма");
	
КонецПроцедуры

Функция ПолучитьРазделЛицевогоСчета(ПараметрыОтбора)
	
	РазделЛицевогоСчета = Справочники.РазделыЛицевыхСчетов.ПустаяСсылка();
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка
	                      |ИЗ
	                      |	Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО КАК РазделыЛицевыхСчетовДопустимыеКФО
	                      |ГДЕ
	                      |	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.Владелец = &Владелец
	                      |	И РазделыЛицевыхСчетовДопустимыеКФО.КФО = &КФО");
	
	Запрос.УстановитьПараметр("Владелец", ПараметрыОтбора.ЛицевойСчет);
	Запрос.УстановитьПараметр("КФО", ПараметрыОтбора.КФО);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		РазделЛицевогоСчета = Результат.Ссылка;
