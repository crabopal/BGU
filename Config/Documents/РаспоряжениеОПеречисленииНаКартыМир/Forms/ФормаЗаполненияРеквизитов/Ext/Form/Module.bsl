
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем СписокРеквизитов;
	
	Параметры.Свойство("СписокРеквизитов", СписокРеквизитов);
	Параметры.Свойство("Организация", ОтборОрганизация);
	Параметры.Свойство("Дата", ОтборДата);
	Параметры.Свойство("ЛицевойСчет", ОтборЛицевойСчет);
	Параметры.Свойство("ИФО", ОтборИФО);
	
	Если ЗначениеЗаполнено(СписокРеквизитов) Тогда
		ТаблицаРеквизитов = ПолучитьИзВременногоХранилища(СписокРеквизитов);
		
		Если ТипЗнч(ТаблицаРеквизитов) = Тип("ТаблицаЗначений") Тогда
			ЗначениеВРеквизитФормы(ТаблицаРеквизитов, "ТаблицаРеквизитовИЗначений");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыТаблицаРеквизитовИЗначений

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийПриАктивизацииЯчейки(Элемент)
	Если Элемент.ТекущийЭлемент.Имя = "ТаблицаРеквизитовИЗначенийЗначениеРеквизита" Тогда
		ТекущиеДанные = Элементы.ТаблицаРеквизитовИЗначений.ТекущиеДанные;
		
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Элемент.ТекущийЭлемент.ОграничениеТипа = ТекущиеДанные.ТипЗначенияРеквизита;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр) 
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийПередНачаломИзменения(Элемент, Отказ)
	
	Если Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент.Вид = ВидПоляФормы.ПолеФлажка Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ТаблицаРеквизитовИЗначений.ТекущиеДанные;
	
	ТипРеквизита = ТекущиеДанные.ТипЗначенияРеквизита;
	ИмяРеквизита = ТекущиеДанные.НаименованиеРеквизита;
	ТекущееЗначениеРеквизита = ТекущиеДанные.ЗначениеРеквизита;
	
	Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент.ОграничениеТипа = ТипРеквизита;
	Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент.СписокВыбора.Очистить();
	Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент.РежимВыбораИзСписка = Ложь;

	Если Найти(ИмяРеквизита, "КФО") > 0 Тогда
		
		СписокЗначенийКФО = ЗаполнитьСписокВыбораКФОСервер(ТекущееЗначениеРеквизита);
		
		Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент.СписокВыбора.ЗагрузитьЗначения(СписокЗначенийКФО.ВыгрузитьЗначения());
		Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент.РежимВыбораИзСписка = Истина;
		
	ИначеЕсли Найти(ИмяРеквизита, "РазделЛицевогоСчета") > 0 Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("НаДату", ОтборДата);
		Отбор.Вставить("Организация", ОтборОрганизация);
		Отбор.Вставить("Владелец", ОтборЛицевойСчет);
		
		ПараметрыФормыВыбора = Новый Структура;
		ПараметрыФормыВыбора.Вставить("Отбор", Отбор);
		ПараметрыФормыВыбора.Вставить("ТекущаяСтрока", ТекущееЗначениеРеквизита);
		
		ОткрытьФорму("Справочник.РазделыЛицевыхСчетов.ФормаВыбора", ПараметрыФормыВыбора, Элементы.ТаблицаРеквизитовИЗначений.ТекущийЭлемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийЗначениеРеквизитаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТаблицаРеквизитовИЗначений.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.Заполнять = ЗначениеЗаполнено(ТекущиеДанные.ЗначениеРеквизита);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьРеквизиты(Команда)
	Закрыть(РезультатЗаполнения());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция РезультатЗаполнения()
	РезультатЗаполнения = Новый Структура;
	
	Для Каждого Стр Из ТаблицаРеквизитовИЗначений Цикл
		Если Стр.Заполнять Тогда
			РезультатЗаполнения.Вставить(Стр.НаименованиеРеквизита, 
										?(ЗначениеЗаполнено(Стр.ЗначениеРеквизита),
											Стр.ЗначениеРеквизита,
											Стр.ТипЗначенияРеквизита.ПривестиЗначение()));
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатЗаполнения;
КонецФункции

&НаКлиенте
Процедура ТаблицаРеквизитовИЗначенийЗначениеРеквизитаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
		ОтборИФО = ВыбранноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСписокВыбораКФОСервер(ТекущееЗначениеКФО)
	
	СписокЗначенийКФО = Новый СписокЗначений;
	
	ПараметрыВыбора = Новый Структура("Организация, ИФО, Дата, НаНачалоСледующегоГода, ЛицевойСчет",
							ОтборОрганизация, ОтборИФО, ОтборДата, Истина, ОтборЛицевойСчет);
	
	БюджетнаяКлассификацияПереопределяемый.ПриОбработкеПолученияДанныхВыбораКВД(СписокЗначенийКФО, ПараметрыВыбора, Ложь);
	
	Возврат СписокЗначенийКФО;
	
КонецФункции

#КонецОбласти