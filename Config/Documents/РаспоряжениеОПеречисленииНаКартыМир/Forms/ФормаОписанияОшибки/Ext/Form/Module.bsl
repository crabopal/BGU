
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Параметры.СведенияОбОшибках) Тогда  
		Отказ = Истина;
		ТекстСообщения = НСтр("ru='Нет указанных сведений об ошибках!'");
        ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);  
		Возврат;
	КонецЕсли;	
	
	ПередаваемыеСведения = ЗначениеИзСтрокиВнутр(Параметры.СведенияОбОшибках);
	
	Если ТипЗнч(ПередаваемыеСведения) <> Тип("ТаблицаЗначений") Тогда
		Отказ = Истина;
		ТекстСообщения = НСтр("ru='Сведения об ошибках неструктурированного типа!'");
        ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);  
		Возврат;	
	КонецЕсли; 
	
	СведенияОбОшибках.Загрузить(ПередаваемыеСведения);

КонецПроцедуры

#КонецОбласти