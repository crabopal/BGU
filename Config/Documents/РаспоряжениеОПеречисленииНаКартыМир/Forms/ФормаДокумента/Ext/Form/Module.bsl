&НаСервере
Процедура ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию()
	
	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.РаспоряжениеОПеречисленииНаКартыМир", Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
	
	Объект.ЛицевойСчет 				= Умолчания.ЛицевойСчет;
	Объект.РеквизитыЛицевогоСчета 	= Умолчания.РеквизитыЛицевогоСчета;
	Объект.ОрганКазначейства		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
	ПриИзмененииЛицевогоСчетаНаСервере();
	
КонецПроцедуры	

&НаСервере
Процедура ПриИзмененииЛицевогоСчетаНаСервере()
	
	СвойстваЛицевогоСчета = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет, Объект.Дата); 
	ПлатежноРасчетныеДокументы.ДополнитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет, СвойстваЛицевогоСчета);
   
	ЗаполнитьЗначенияСвойств(Объект, СвойстваЛицевогоСчета);
	
	ДопустимыеКФО = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеКФО(,Объект.ЛицевойСчет);
	СписокДопустимыхКФО.ЗагрузитьЗначения(ДопустимыеКФО);
	
	Для Каждого Стр Из Объект.Состав Цикл
		
		Если СписокДопустимыхКФО.НайтиПоЗначению(Стр.КФО) = Неопределено Тогда
			Стр.КФО = "";
			Если СписокДопустимыхКФО.Количество() > 0 Тогда
				Стр.КФО = СписокДопустимыхКФО[0].Значение;
			КонецЕсли;
		КонецЕсли;  
		
		Если ЗначениеЗаполнено(Стр.КФО) Тогда   
			МассивДопустимыеРазделыЛС = СвойстваЛицевогоСчета.РазделыЛСпоКФО[Стр.КФО];
			Если МассивДопустимыеРазделыЛС.Найти(Стр.РазделЛицевогоСчета) = Неопределено Тогда
				Если МассивДопустимыеРазделыЛС.Количество() > 0 Тогда
					Стр.РазделЛицевогоСчета = МассивДопустимыеРазделыЛС[0];			
				Иначе
					Стр.РазделЛицевогоСчета = Неопределено;
				КонецЕсли; 		
			КонецЕсли; 
		Иначе
			Стр.РазделЛицевогоСчета = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьЛицевойСчетОрганКазначейства()
	
	Объект.ЛицевойСчет 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "Владелец");
	Объект.ОрганКазначейства 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
	ПриИзмененииЛицевогоСчетаНаСервере();

КонецПроцедуры

