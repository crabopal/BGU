&НаКлиенте
Процедура СоставПодробноПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ОтборДляРасшифровкиПлатежа(Элемент.ТекущиеДанные.ИдентификаторСтроки);
		ИдентификаторТекущейСтроки = Элемент.ТекущиеДанные.ИдентификаторСтроки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноПередУдалением(Элемент, Отказ)
	УдалитьСтрокиРасшифровкиПлатежа(Элемент.ВыделенныеСтроки);
	РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Копирование Тогда
		// скопируем также классификацию
		ТекущаяКлассификация.Очистить();
		СтрокиДляКопирования = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки",ИдентификаторТекущейСтроки));
		Для Каждого Строка Из СтрокиДляКопирования Цикл
			ЗаполнитьЗначенияСвойств(ТекущаяКлассификация.Добавить(),Строка);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		ИдентификаторТекущейСтроки = Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки;
		Если Копирование Тогда
			Для Каждого Строка Из ТекущаяКлассификация Цикл
				НоваяСтрокаРасшифровки = Объект.РасшифровкаПлатежа.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаРасшифровки,Строка);
				НоваяСтрокаРасшифровки.ИдентификаторСтроки = Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки;
			КонецЦикла;
			РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
		КонецЕсли;
		ОтборДляРасшифровкиПлатежа(Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки);
	КонецЕсли; 
	
	Если Элемент.ТекущийЭлемент.Имя = "СоставПодробноОшибка" Тогда
		СтандартнаяОбработка = Ложь;
		Если ЗначениеЗаполнено(Элементы.СоставПодробно.ТекущиеДанные.ОписаниеОшибки) Тогда
			ПараметрыФормыОшибок = Новый Структура("СведенияОбОшибках", Элементы.СоставПодробно.ТекущиеДанные.ОписаниеОшибки);
						ОткрытьФорму("Документ.РаспоряжениеОПеречисленииНаКартыМир.Форма.ФормаОписанияОшибки", ПараметрыФормыОшибок, ЭтотОбъект,,,, Неопределено, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
		КонецЕсли; 
	КонецЕсли;  
		
КонецПроцедуры   

&НаКлиенте
Процедура СоставПодробноСотрудникПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СоставПодробно.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Контрагент) 
		И ЗначениеЗаполнено(ТекущиеДанные.Сотрудник) Тогда
		ПолучитьКонтрагентаСотрудника(ТекущиеДанные.Сотрудник, 
		ТекущиеДанные.Контрагент, 
		ТекущиеДанные.ПлатежнаяКарта, 
		ТекущиеДанные.НомерПлатежнойКарты, 
		ТекущиеДанные.ДатаРожденияДержателяКарты,
		ЭтотОбъект.КэшПараметров.Локальные.НеИзменятьКарту); 
		Элементы.СоставПодробно.ТекущиеДанные.МаскированныйНомерКарты = МаскированныйНомерКарты(Элементы.СоставПодробно.ТекущиеДанные.НомерПлатежнойКарты);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Контрагент) Тогда
		Элементы.СоставПодробно.ЗакончитьРедактированиеСтроки(Истина);
	КонецЕсли;
	
КонецПроцедуры   

&НаКлиенте
Процедура СоставПодробноКонтрагентПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СоставПодробно.ТекущиеДанные;
	ПолучитьПлатежнуюКарту(ТекущиеДанные.Контрагент, 
	ТекущиеДанные.ПлатежнаяКарта, 
	ТекущиеДанные.НомерПлатежнойКарты, 
	ТекущиеДанные.ДатаРожденияДержателяКарты,
	ЭтотОбъект.КэшПараметров.Локальные.НеИзменятьКарту);
	ТекущиеДанные.МаскированныйНомерКарты = МаскированныйНомерКарты(Элементы.СоставПодробно.ТекущиеДанные.НомерПлатежнойКарты);
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноСотрудникОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь; 
		ТекущиеДанные = Элементы.СоставПодробно.ТекущиеДанные;
		ТекущиеДанные.Сотрудник = ВыбранноеЗначение.Ссылка;
		ТекущиеДанные.Контрагент = ВыбранноеЗначение.Контрагент; 
		ПолучитьПлатежнуюКарту(ТекущиеДанные.Контрагент, 
		ТекущиеДанные.ПлатежнаяКарта, 
		ТекущиеДанные.НомерПлатежнойКарты, 
		ТекущиеДанные.ДатаРожденияДержателяКарты,
		ЭтотОбъект.КэшПараметров.Локальные.НеИзменятьКарту); 
		Элементы.СоставПодробно.ТекущиеДанные.МаскированныйНомерКарты = МаскированныйНомерКарты(Элементы.СоставПодробно.ТекущиеДанные.НомерПлатежнойКарты);
	Иначе
		Элементы.СоставПодробно.ТекущиеДанные.Контрагент = ""; 
		Элементы.СоставПодробно.ТекущиеДанные.МаскированныйНомерКарты = "";
		Элементы.СоставПодробно.ТекущиеДанные.НомерПлатежнойКарты = "";
		Элементы.СоставПодробно.ТекущиеДанные.ПлатежнаяКарта = "";
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноМаскированныйНомерКартыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	НомерПлатежнойКартыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноМаскированныйНомерКартыОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	НомерПлатежнойКартыОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка);
КонецПроцедуры 

