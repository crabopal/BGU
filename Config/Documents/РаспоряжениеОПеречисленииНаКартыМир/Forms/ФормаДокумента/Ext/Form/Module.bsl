	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		Объект.НомерОбязательства = РаботаСОбязательствами.ПолучитьУчетныйНомерОбязательства(Объект.Договор);
	Иначе
		Объект.НомерОбязательства = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьКонтрагентаСотрудника(Знач СотрудникСсылка, Контрагент, ПлатежнаяКарта, НомерПлатежнойКарты, ДатаРождения, НеИзменятьКарту)
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СотрудникСсылка, "Контрагент"); 
	ПолучитьПлатежнуюКарту(Контрагент, ПлатежнаяКарта, НомерПлатежнойКарты, ДатаРождения, НеИзменятьКарту);	
КонецПроцедуры  

&НаСервереБезКонтекста
Процедура ПолучитьПлатежнуюКарту(Знач Контрагент, ПлатежнаяКарта, НомерПлатежнойКарты, ДатаРождения, НеИзменятьКарту)
	
	Если НеИзменятьКарту Тогда
		Возврат;
	КонецЕсли;	
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Владелец", Контрагент); 
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	БанковскиеКартыКонтрагентов.Ссылка КАК Ссылка,
	|	БанковскиеКартыКонтрагентов.Владелец.ЮридическоеФизическоеЛицо.ДатаРождения КАК ДатаРождения,
	|	БанковскиеКартыКонтрагентов.ОсновнойНомерДержателяКарты КАК ОсновнойНомерДержателяКарты
	|ИЗ
	|	Справочник.БанковскиеКартыКонтрагентов КАК БанковскиеКартыКонтрагентов
	|ГДЕ
	|	БанковскиеКартыКонтрагентов.ПометкаУдаления = ЛОЖЬ
	|	И БанковскиеКартыКонтрагентов.Владелец = &Владелец
	|	И БанковскиеКартыКонтрагентов.ЭтоНациональныйПлатежныйИнструмент = ИСТИНА
	|	И БанковскиеКартыКонтрагентов.ВАрхиве = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	БанковскиеКартыКонтрагентов.ДатаИстеченияСрокаДействияКарты УБЫВ";	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПлатежнаяКарта = Выборка.Ссылка;
		ДатаРождения = Выборка.ДатаРождения;
		НомерПлатежнойКарты = ?(ЗначениеЗаполнено(Выборка.ОсновнойНомерДержателяКарты),
			Выборка.ОсновнойНомерДержателяКарты.Получить(), ""); 
	Иначе
		ПлатежнаяКарта = ПредопределенноеЗначение("Справочник.БанковскиеКартыКонтрагентов.ПустаяСсылка");
		НомерПлатежнойКарты = "";
		ДатаРождения = "";
	КонецЕсли;
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьРазницуШапкиИИтогаТЧ(Форма)
	
	Объект = Форма.Объект;
	Форма.ИтогПоТЧ = Объект.РасшифровкаПлатежа.Итог("Сумма") - Объект.СуммаДокумента;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокиРасшифровкиПлатежа(ВыделенныеСтроки)
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		Строка = Объект.Состав.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		Если Строка <> Неопределено Тогда
			
			ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
			МассивКУдалению = Объект.РасшифровкаПлатежа.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
				Объект.РасшифровкаПлатежа.Удалить(СтрокаКУдалению);
			КонецЦикла;
			
		КонецЕсли
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриПолученииДанныхСтрокиСостава(Объект, СтрокаСостава)
	
	СтрокиКлассификацииСотрудника = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаСостава.ИдентификаторСтроки));
	
	РасшифровкаКлассификации = "";
	
	Для Каждого СтрокаКлассификацииСотрудника Из СтрокиКлассификацииСотрудника Цикл
		
		Если РасшифровкаКлассификации <> "" Тогда
			РасшифровкаКлассификации = РасшифровкаКлассификации + Символы.ПС;
		КонецЕсли;
		
		РасшифровкаКлассификации = РасшифровкаКлассификации + "(";
		РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.КПС;
		РасшифровкаКлассификации = РасшифровкаКлассификации + "; ";
				
		Если ЗначениеЗаполнено(СтрокаКлассификацииСотрудника.КодЦели) Тогда
			РасшифровкаКлассификации = РасшифровкаКлассификации + "; ";
			РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.КодЦели;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаКлассификацииСотрудника.КодМероприятия) Тогда
			РасшифровкаКлассификации = РасшифровкаКлассификации + "; ";
			РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.КодМероприятия;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаКлассификацииСотрудника.ДопКлассификация) Тогда
			РасшифровкаКлассификации = РасшифровкаКлассификации + "; ";
			РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.ДопКлассификация;
		КонецЕсли;
		
		РасшифровкаКлассификации = РасшифровкаКлассификации + ") ";
		РасшифровкаКлассификации = РасшифровкаКлассификации + Формат(СтрокаКлассификацииСотрудника.Сумма,"ЧДЦ=2; ЧН=");
		
		РасшифровкаКлассификации = РасшифровкаКлассификации + " ";
			
	КонецЦикла;
	
	СтрокаСостава.Классификация = РасшифровкаКлассификации;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДляРасшифровкиПлатежа(ИдентификаторСтроки)
	
	ОтборСтрок = Элементы.РасшифровкаПлатежаПодробно.ОтборСтрок;
	
	Если ОтборСтрок = Неопределено
		ИЛИ НЕ (ОтборСтрок.Свойство("ИдентификаторСтроки")
				И ОтборСтрок.ИдентификаторСтроки = ИдентификаторСтроки) Тогда
		
		Элементы.РасшифровкаПлатежаПодробно.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ИдентификаторСтроки",ИдентификаторСтроки));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИтогСтрокиПоИдентификатору(ИдентификаторСтроки, ИмяТаблицыФормы)
	
	ИтогПоРасшифровке = 0;
	
	ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	МассивСтрокДляСуммирования = Объект.РасшифровкаПлатежа.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого СтрокаСуммирования Из МассивСтрокДляСуммирования Цикл
		ИтогПоРасшифровке = ИтогПоРасшифровке + СтрокаСуммирования.Сумма;
	КонецЦикла;
	
	Элементы[ИмяТаблицыФормы].ТекущиеДанные.Сумма = ИтогПоРасшифровке;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСотрудникКонтрагент(ЭлементыФормы, ПоСотрудникам)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставПодробноСотрудник", "Видимость", ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставПодробноКонтрагент", "Видимость", НЕ ПоСотрудникам);
		
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСтатусДокумента()
	
	ПлатежноРасчетныеДокументыКлиент.ОткрытьФормуИзмененияСтатусаДокумента(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	УчетПоИФО = ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО");
	УчетПоПодразделениям = ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоПодразделениям");
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СоставПодробноСумма",
		"ТолькоПросмотр", ЗначениеЗаполнено(Объект.ДокументОснование)); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СоставПодробноИФО",
		"Видимость", (ЗначениеЗаполнено(Объект.ДокументОснование) И УчетПоИФО));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СоставПодробноПодразделение",
		"Видимость", (ЗначениеЗаполнено(Объект.ДокументОснование) И УчетПоПодразделениям));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИФО",
		"Видимость", НЕ ЗначениеЗаполнено(Объект.ДокументОснование));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Подразделение",
		"Видимость", НЕ ЗначениеЗаполнено(Объект.ДокументОснование));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СоставПодробноПоказатьНомераКарт",
		"Видимость", БанковскиеКарты.РазрешенПросмотрПолногоНомераКарты());

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СоставПодробноНомерПлатежнойКарты",
		"КнопкаВыбора", НЕ (ЗначениеЗаполнено(Объект.ДокументОснование))); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СоставПодробноМаскированныйНомерКарты",
		"КнопкаВыбора", НЕ (ЗначениеЗаполнено(Объект.ДокументОснование)));
			
	ОбщегоНазначенияБГУКлиентСервер.ИзменитьДоступностьРедактированияСтрок(ЭтотОбъект);
	
КонецПроцедуры     

&НаСервере
Процедура УстановитьОтображениеОшибок() 
	
	ДокументБезИзвещения = ?(Объект.Состав.Количество() = 0, Истина, Ложь); 
	                    
	Для Каждого СтрокаПодробно Из Объект.Состав Цикл 
		
		Если НЕ ЗначениеЗаполнено(СтрокаПодробно.ОписаниеОшибки) И СтрокаПодробно.Ошибка = 0 Тогда
			ДокументБезИзвещения = Истина;
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;	
	
	Если ДокументБезИзвещения Тогда  
		
		 Элементы.СоставПодробноОшибка.Вид         = ВидПоляФормы.ПолеВвода;
		 Элементы.СоставПодробноОшибка.Доступность = Ложь;   
		 
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере  
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()  
	
	Для Каждого СтрокаСостава Из Объект.Состав Цикл
		СтрокаСостава.МаскированныйНомерКарты = МаскированныйНомерКарты(СтрокаСостава.НомерПлатежнойКарты); 
		ПриПолученииДанныхСтрокиСостава(Объект, СтрокаСостава);
	КонецЦикла;	
	
КонецПроцедуры	 

&НаКлиентеНаСервереБезКонтекста
Функция МаскированныйНомерКарты(НомерКартыПолный)
	ОсновнойНомерДержателяКарты = БанковскиеКартыСлужебныйКлиентСервер.СкопироватьЦифры(НомерКартыПолный);
	Возврат БанковскиеКартыСлужебныйКлиентСервер.МаскированныйНомер(ОсновнойНомерДержателяКарты); 
КонецФункции

&НаКлиенте
Процедура НомерПлатежнойКартыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь; 
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;	
	ПараметрыВыбораКарты = Новый Структура; 
	ПараметрыВыбораКарты.Вставить("РежимВыбора", Истина);
	ПараметрыВыбораКарты.Вставить("ТекущаяСтрока", Элементы.СоставПодробно.ТекущиеДанные.ПлатежнаяКарта);
	Если ЗначениеЗаполнено(Элементы.СоставПодробно.ТекущиеДанные.Контрагент) Тогда
		ПараметрыВыбораКарты.Вставить("Отбор", Новый Структура);
		ПараметрыВыбораКарты.Отбор.Вставить("Владелец", Элементы.СоставПодробно.ТекущиеДанные.Контрагент);
		ПараметрыВыбораКарты.Отбор.Вставить("ЭтоНациональныйПлатежныйИнструмент", Истина);
	КонецЕсли;	
	ОткрытьФорму("Справочник.БанковскиеКартыКонтрагентов.ФормаВыбора", ПараметрыВыбораКарты, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура НомерПлатежнойКартыОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;  
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;    
	ОбработатьВыборКартыНаСервере(Элементы.СоставПодробно.ТекущаяСтрока, ВыбранноеЗначение);
КонецПроцедуры 

&НаСервере
Процедура ОбработатьВыборКартыНаСервере(ИдентификаторСтроки, ПлатежнаяКарта)
	
	Если НЕ ЗначениеЗаполнено(ПлатежнаяКарта) Тогда
		Возврат;
	КонецЕсли;	
		
	ДанныеСтроки = Объект.Состав.НайтиПоИдентификатору(ИдентификаторСтроки);  
	ДанныеДляЗаполнения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПлатежнаяКарта, 
	         Новый Структура("МаскированныйНомерКарты,Контрагент,ДатаРожденияПолучателя, ОсновнойНомерДержателяКарты", 
			 "Код", "Владелец", "Владелец.ЮридическоеФизическоеЛицо.ДатаРождения", "ОсновнойНомерДержателяКарты"));
			 
	ДанныеДляЗаполнения.Вставить("НомерПлатежнойКарты", ?(ЗначениеЗаполнено(ДанныеДляЗаполнения.ОсновнойНомерДержателяКарты),
			ДанныеДляЗаполнения.ОсновнойНомерДержателяКарты.Получить(), "") ); 
			
	ДанныеДляЗаполнения.Вставить("ПлатежнаяКарта", ПлатежнаяКарта);  
	
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, ДанныеДляЗаполнения);
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗаполненияРеквизитов(ВоВсехСтроках = Истина)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ВоВсехСтроках", ВоВсехСтроках);
	
	Оповещение = Новый ОписаниеОповещения("ОткрытьФормуЗаполненияРеквизитовОповещение", ЭтотОбъект, ДопПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокРеквизитов", СписокРеквизитов());
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("Дата", Объект.Дата);
	ПараметрыФормы.Вставить("ЛицевойСчет", Объект.ЛицевойСчет);
	
	ОткрытьФорму("Документ.РаспоряжениеОПеречисленииНаКартыМир.Форма.ФормаЗаполненияРеквизитов", 
				ПараметрыФормы, 
				ЭтаФорма, 
				, , , 
				Оповещение, 
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗаполненияРеквизитовОповещение(Результат, ДопПараметры) Экспорт
	
	Перем ВоВсехСтроках;
	
	Если Результат = Неопределено Или ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры.Свойство("ВоВсехСтроках", ВоВсехСтроках);
	
	Если ВоВсехСтроках Тогда
		Для Каждого СтрокаСостав Из Объект.Состав Цикл
			Для Каждого КлючИЗначение Из Результат Цикл
				СтрокаСостав[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			КонецЦикла;
		КонецЦикла;
	Иначе
		ВыделенныеСтроки = Элементы.СоставПодробно.ВыделенныеСтроки;
		
		Для Каждого НомерСтроки Из ВыделенныеСтроки Цикл
			СтрокаСостав = Объект.Состав[НомерСтроки];
			Для Каждого КлючИЗначение Из Результат Цикл
				СтрокаСостав[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СписокРеквизитов()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НаименованиеРеквизита");
	Результат.Колонки.Добавить("СинонимРеквизита");
	Результат.Колонки.Добавить("Заполнять");
	Результат.Колонки.Добавить("ЗначениеРеквизита");
	Результат.Колонки.Добавить("ТипЗначенияРеквизита");
	
	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "КФО";
	Стр.СинонимРеквизита = НСтр("ru = 'КФО'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("ПеречислениеСсылка.КВД");
	
	Стр = Результат.Добавить();
	Стр.НаименованиеРеквизита = "РазделЛицевогоСчета";
	Стр.СинонимРеквизита = НСтр("ru = 'Раздел лицевого счета'");
	Стр.ТипЗначенияРеквизита = Новый ОписаниеТипов("СправочникСсылка.РазделыЛицевыхСчетов");
	
	Возврат ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификатор);
	
КонецФункции

