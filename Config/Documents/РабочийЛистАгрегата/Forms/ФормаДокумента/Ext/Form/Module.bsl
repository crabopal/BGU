КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиЗаполненияДокумента(ОсновноеСредство)
	
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект.Ссылка));
	ТаблицаНастроек = УчетГСМ.ДанныеНастроекЗаполненияДокумента(Объект.Организация, Перечисления.ВидыОбъектовРасходаГСМ.Агрегаты, ИдентификаторДокумента, ОсновноеСредство);
	
	Для Каждого ТекСтрока Из ТаблицаНастроек Цикл
		
		Объект.МОЛ = ТекСтрока.РЛАМОЛ;
		Объект.Подразделение = ТекСтрока.РЛАПодразделение;
		Объект.ЗапланированоМоторесурсов = ТекСтрока.РЛАЗапланированоМоторесурсов;
		Объект.ЕдиницаИзмеренияМоторесурсов = ТекСтрока.РЛАЕдиницаИзмеренияМоторесурсов;
		
		Объект.РуководительПодразделения = ТекСтрока.РЛАРуководительПодразделения;
		
		ОсновнойПараметрРасчета = ТекСтрока.РЛАОсновнойПараметрРасчета;
		ЕдиницаИзмеренияРаботы = ТекСтрока.ЕдиницаИзмеренияРаботы;
	КонецЦикла;	
	
КонецПроцедуры	

&НаКлиенте
Процедура РезультатыРаботыАгрегатаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ЭтоНоваяСтрока = НоваяСтрока;
	
	ТекущиеДанные = Элементы.РезультатыРаботыАгрегата.ТекущиеДанные;
	ОбновитьТекстЗаголовковВСтрокеТаблицыРезультатыРаботыАгрегата(ТекущиеДанные);
	
	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока тогда
		ТекущаяСтрока = Элементы.РезультатыРаботыАгрегата.ТекущиеДанные;
		Если Копирование Тогда
			Возврат;
		КонецЕсли;
		ТекущаяСтрока.ПоказателиРасчета = НСтр("ru='Ввести данные о работе агрегата'");
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура РезультатыРаботыАгрегатаПриАктивизацииЯчейки(Элемент)
	Если Элементы.РезультатыРаботыАгрегата.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоНоваяСтрока Тогда
		ТекущаяКолонкаТаблицы = Элементы.РезультатыРаботыАгрегата.ТекущийЭлемент;
		Если ТекущаяКолонкаТаблицы.Имя = "РезультатыРаботыАгрегатаПоказателиРасчета"
			И НЕ Элементы.РезультатыРаботыАгрегата.ТекущиеДанные.ПоказателиРасчетаЗаполнены Тогда
			ВыбраннаяСтрока = Элементы.РезультатыРаботыАгрегата.ТекущаяСтрока;
			ОткрытьФормуВводаПоказателейРасчета(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВводаПоказателейРасчета(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.РезультатыРаботыАгрегата.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("ДатаРабот, ПродолжительностьРаботы, ПродолжительностьРаботыСтр, КоличествоОбработанныхМЦ,
		|ПоказанияСчетчикаНаНачало, ПоказанияСчетчикаНаКонец, ПоказанияСчетчика, ЕдиницаИзмеренияРаботы");
		
		
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.Вставить("ИдентификаторФормулыРасчета", 0);
	Если НЕ ЗначениеЗаполнено(ПараметрыФормы.ЕдиницаИзмеренияРаботы) Тогда
		ПараметрыФормы.ЕдиницаИзмеренияРаботы = ЕдиницаИзмеренияРаботы;
	КонецЕсли;
	Если ПараметрыФормы.ПродолжительностьРаботы > 0 Тогда
		ПараметрыФормы.ИдентификаторФормулыРасчета = 1;	
	ИначеЕсли ПараметрыФормы.КоличествоОбработанныхМЦ > 0 Тогда	
		ПараметрыФормы.ИдентификаторФормулыРасчета = 2;	
	ИначеЕсли ПараметрыФормы.ПоказанияСчетчика > 0 Тогда	
		ПараметрыФормы.ИдентификаторФормулыРасчета = 3;
	Иначе
		Если ОсновнойПараметрРасчета = ПредопределенноеЗначение("Перечисление.ВидыПараметровДляНормРасходаГСМДляАгрегатов.ПродолжительностьРаботы") Тогда
			ПараметрыФормы.ИдентификаторФормулыРасчета = 1;
		ИначеЕсли ОсновнойПараметрРасчета = ПредопределенноеЗначение("Перечисление.ВидыПараметровДляНормРасходаГСМДляАгрегатов.КоличествоОбработанныхМЦ") Тогда
			ПараметрыФормы.ИдентификаторФормулыРасчета = 2;
		ИначеЕсли ОсновнойПараметрРасчета = ПредопределенноеЗначение("Перечисление.ВидыПараметровДляНормРасходаГСМДляАгрегатов.ПоказанияСчетчика") Тогда
			ПараметрыФормы.ИдентификаторФормулыРасчета = 3;
		КонецЕсли;			
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("ОбщаяФорма.ФормаВводаПоказателейРасчетаДляАгрегата", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры



&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблицыРежимов()
	
	// Колонки 
	ПоляФормы = Новый Структура("Идентификатор, Время, Количество, СчетчикНаНачало, СчетчикНаКонец, Счетчик, ЕдиницаИзмеренияРаботы",
		"ИдентификаторФормулыРасчета", "ПродолжительностьРаботы", "КоличествоОбработанныхМЦ",
		 "ПоказанияСчетчикаНаНачало", "ПоказанияСчетчикаНаКонец", "ПоказанияСчетчика", "ЕдиницаИзмеренияРаботы");
	Для Каждого СтрокаТаблицы Из Объект.РезультатыРаботыАгрегата Цикл
		ЗаполнитьДобавленныеКолонкиПоказателиРасчета(СтрокаТаблицы, ПоляФормы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДобавленныеКолонкиПоказателиРасчета(ДанныеСтроки, ПоляФормы=Неопределено) Экспорт
	ПоказателиРасчетаТекст = НСтр("ru='Ввести данные о работе агрегата'");
	ПоказателиРасчетаЗаполнены = Ложь;
	
	Идентификатор = 0;
	Если ДанныеСтроки[ПоляФормы.Время]>0 Тогда
		Идентификатор = 1;
	ИначеЕсли ДанныеСтроки[ПоляФормы.Количество]>0 Тогда         
		Идентификатор = 2;
	ИначеЕсли ДанныеСтроки[ПоляФормы.Счетчик]>0 Тогда
		Идентификатор = 3;
	КонецЕсли;	
	
	Если Идентификатор = 1 Тогда
		ПоказателиРасчетаТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Продолжительность работы: %1'"),
		УчетВремениКлиентСервер.ЧислоВСтроку(ДанныеСтроки[ПоляФормы.Время]));
		ПоказателиРасчетаЗаполнены = Истина;
	ИначеЕсли Идентификатор = 2 Тогда
		ПоказателиРасчетаТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Объем работы: %1 %2'"),
		Формат(ДанныеСтроки[ПоляФормы.Количество], "ЧЦ=17; ЧДЦ=2; ЧН=-"), Строка(ДанныеСтроки[ПоляФормы.ЕдиницаИзмеренияРаботы]));
		ПоказателиРасчетаЗаполнены = Истина;
	ИначеЕсли Идентификатор = 3 Тогда
		ПоказателиРасчетаТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Показания счетчика: %1'"),
		Формат(ДанныеСтроки[ПоляФормы.Счетчик], "ЧЦ=17; ЧН=-"));
		ПоказателиРасчетаЗаполнены = Истина;
	КонецЕсли;	
	
	ДанныеСтроки.ПоказателиРасчета          = ПоказателиРасчетаТекст;
	ДанныеСтроки.ПоказателиРасчетаЗаполнены = ПоказателиРасчетаЗаполнены;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПоказателейРасчетаНаКлиенте(СтруктураПоказателейРасчета)
	ТекущиеДанные = Элементы.РезультатыРаботыАгрегата.ТекущиеДанные;
	ТекущиеДанные.ПродолжительностьРаботы = 0;
	ТекущиеДанные.КоличествоОбработанныхМЦ = 0;
	ТекущиеДанные.ПоказанияСчетчикаНаНачало = 0;
	ТекущиеДанные.ПоказанияСчетчикаНаКонец = 0;
	ТекущиеДанные.ПоказанияСчетчика = 0;
	
	ИдентификаторФормулыРасчета = СтруктураПоказателейРасчета.ИдентификаторФормулыРасчета;
	
	Если ИдентификаторФормулыРасчета = 1 Тогда
		Если СтруктураПоказателейРасчета.ПродолжительностьРаботы = 0 Тогда
			ТекущиеДанные.ИдентификаторФормулыРасчета = 0;
		Иначе	
			ТекущиеДанные.ПродолжительностьРаботы = СтруктураПоказателейРасчета.ПродолжительностьРаботы;
			ТекущиеДанные.ПродолжительностьРаботыСтр = СтруктураПоказателейРасчета.ПродолжительностьРаботыСтр;
		КонецЕсли;
	ИначеЕсли ИдентификаторФормулыРасчета = 2 Тогда
		Если СтруктураПоказателейРасчета.КоличествоОбработанныхМЦ = 0 Тогда
			ТекущиеДанные.ИдентификаторФормулыРасчета = 0;
		Иначе	
			ТекущиеДанные.КоличествоОбработанныхМЦ = СтруктураПоказателейРасчета.КоличествоОбработанныхМЦ;
		КонецЕсли;
	ИначеЕсли ИдентификаторФормулыРасчета = 3 Тогда
		Если СтруктураПоказателейРасчета.ПоказанияСчетчика = 0 Тогда
			ТекущиеДанные.ИдентификаторФормулыРасчета = 0;
		Иначе	
			ТекущиеДанные.ПоказанияСчетчикаНаНачало = СтруктураПоказателейРасчета.ПоказанияСчетчикаНаНачало;
			ТекущиеДанные.ПоказанияСчетчикаНаКонец = СтруктураПоказателейРасчета.ПоказанияСчетчикаНаКонец;
			ТекущиеДанные.ПоказанияСчетчика = СтруктураПоказателейРасчета.ПоказанияСчетчика;
		КонецЕсли;
	КонецЕсли;
	
	ТекущиеДанные.ЕдиницаИзмеренияРаботы = СтруктураПоказателейРасчета.ЕдиницаИзмеренияРаботы;
	
	// Колонки 
	ПоляФормы = Новый Структура("Идентификатор, Время, Количество, СчетчикНаНачало, СчетчикНаКонец, Счетчик, ЕдиницаИзмеренияРаботы",
		"ИдентификаторФормулыРасчета", "ПродолжительностьРаботы", "КоличествоОбработанныхМЦ",
		 "ПоказанияСчетчикаНаНачало", "ПоказанияСчетчикаНаКонец", "ПоказанияСчетчика", "ЕдиницаИзмеренияРаботы");

	ЗаполнитьДобавленныеКолонкиПоказателиРасчета(ТекущиеДанные, ПоляФормы);
		 
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыРезультатыРаботыАгрегата(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.РезультатыРаботыАгрегата Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыРезультатыРаботыАгрегата(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыРезультатыРаботыАгрегата(ТекущаяСтрока)

	ТекущаяСтрока.НаименованиеРаботыЗаголовок = НСтр("ru = 'наименование:'");
	ТекущаяСтрока.ОператорЗаголовок = НСтр("ru = 'оператор:'");
	
	ТекущаяСтрока.ГСМПолученоЗаголовок = НСтр("ru = 'получено:'");
	ТекущаяСтрока.ГСМИзрасходованоЗаголовок = НСтр("ru = 'израсходовано:'");
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()

	ЗаполнитьДобавленныеКолонкиТаблицыРежимов();
	ОбновитьТекстЗаголовковВсехСтрокТаблицыРезультатыРаботыАгрегата(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура АгрегатПриИзмененииНаСервере()
	
	УстановитьПараметрыАгрегата();	
	ЗаполнитьНастройкиЗаполненияДокумента(Объект.Агрегат);
	ЗаполнитьСписокВыбораМОЛ();
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьДанныеВидаГСМ(ВидГСМ)
	Возврат УчетГСМ.ПолучитьДанныеВидаГСМ(ВидГСМ);
КонецФункции

&НаСервере
Функция ПолучитьДанныеНоменклатуры(Номенклатура)
	Возврат УчетГСМ.ПолучитьДанныеНоменклатуры(Номенклатура);
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокВыбораМОЛ()
	Если НЕ ЗначениеЗаполнено(Объект.Агрегат)
		ИЛИ НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Возврат;
	КонецЕсли;	
	ТаблицаМОЛ = УчетГСМ.ДанныеНастроекВодителиТС(Объект.Организация, Объект.Агрегат);
	Элементы.МОЛ.СписокВыбора.Очистить();
	Для каждого ТекСтрока Из ТаблицаМОЛ Цикл
		Элементы.МОЛ.СписокВыбора.Добавить(ТекСтрока.Водитель);
	КонецЦикла;
КонецПроцедуры	

