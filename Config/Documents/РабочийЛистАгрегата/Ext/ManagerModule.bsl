#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.РабочийЛистАгрегата";
	КомандаПечати.Идентификатор		= "ПФ_MXL_ФормаРабочегоЛистаАгрегата";
	КомандаПечати.Представление		= НСтр("ru = 'Рабочий лист агрегата'");
	КомандаПечати.Порядок			= 1;

КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ФормаРабочегоЛистаАгрегата") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_ФормаРабочегоЛистаАгрегата", "Рабочий лист агрегата", ПечатьРабочегоЛистаАгрегата(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьРабочегоЛистаАгрегата(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_РабочийЛистАгрегата";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.РабочийЛистАгрегата.ПФ_MXL_ФормаРабочегоЛистаАгрегата");
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	
	"ВЫБРАТЬ
	|	РабочийЛистАгрегата.Ссылка,
	|	РабочийЛистАгрегата.Организация,
	|	ВЫРАЗИТЬ(РабочийЛистАгрегата.Организация КАК Справочник.Организации).КодОКПО КАК КодОКПО,
	|	ВЫРАЗИТЬ(РабочийЛистАгрегата.Организация КАК Справочник.Организации).НаименованиеПолное КАК НаименованиеОрганизации,
	|	РабочийЛистАгрегата.Номер КАК НомерРабочегоЛистаАгрегата,
	|	РабочийЛистАгрегата.Дата КАК ДатаРабочегоЛистаАгрегата,
	|	РабочийЛистАгрегата.СрокДействия,
	|	РабочийЛистАгрегата.МОЛ,
	|	РабочийЛистАгрегата.Агрегат,
	|	РабочийЛистАгрегата.Подразделение,
	|	РабочийЛистАгрегата.ЗапланированоМоторесурсов,
	|	РабочийЛистАгрегата.ЕдиницаИзмеренияМоторесурсов,
	|	РабочийЛистАгрегата.НомерДвигателяАгрегата КАК НомерДвигателя,
	|	РабочийЛистАгрегата.МаркаДвигателяАгрегата КАК МаркаДвигателя,
	|	РабочийЛистАгрегата.РуководительПодразделения
	|ИЗ
	|	Документ.РабочийЛистАгрегата КАК РабочийЛистАгрегата
	|ГДЕ
	|	РабочийЛистАгрегата.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаРабочегоЛистаАгрегата,
	|	НомерРабочегоЛистаАгрегата";	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДокументов = Результат.Выбрать();

	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПФ_MXL_ФормаРабочегоЛистаАгрегата";
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, ВыборкаДокументов[Колонка.Имя]);	
		КонецЦикла;
		
		//---изменение представления данных в печатной форме----------------
		СтруктураПериодаРабот = УчетГСМ.ПолучитьПериодРаботРабочегоЛистаАгрегата(ВыборкаДокументов.Ссылка);
		Если СтруктураПериодаРабот = Неопределено Тогда 
			СтрокаПериода = "__________________ 20 ___ г.";
		Иначе
			СтрокаПериода = Нрег(ПредставлениеПериода(НачалоДня(СтруктураПериодаРабот.НачалоПериода), КонецДня(СтруктураПериодаРабот.КонецПериода), "ФП"));
		КонецЕсли;
		СтруктураДанных.Вставить("СтрокаПериода", СтрокаПериода);
		
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
															
		СтруктураДанных.Вставить("НаименованиеОрганизацииАдресТелефон", СтруктураДанных.НаименованиеОрганизации+", "+АдресОрганизации+", "+ТелефонОрганизации);
															
		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(СтруктураДанных.ДатаРабочегоЛистаАгрегата);
		СтруктураДанных.Вставить("ЧислоДаты", 	СтруктураДаты.Число);	
		СтруктураДанных.Вставить("МесяцДаты", 	СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДаты", 	СтруктураДаты.Год);
		
		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(СтруктураДанных.СрокДействия);
		СтруктураДанных.Вставить("ЧислоДатыСрока", 	СтруктураДаты.Число);	
		СтруктураДанных.Вставить("МесяцДатыСрока", 	СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДатыСрока", 	СтруктураДаты.Год);
		
		Если НЕ ЗначениеЗаполнено(СтруктураДанных.НомерДвигателя) Тогда
			СтруктураДанных.НомерДвигателя = УчетГСМ.ПолучитьНомерДвигателя(СтруктураДанных.Агрегат);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтруктураДанных.МаркаДвигателя) Тогда
			СтруктураДанных.МаркаДвигателя = УчетГСМ.ПолучитьМаркуДвигателя(СтруктураДанных.Агрегат);
		КонецЕсли;
		
		ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(СтруктураДанных.МОЛ, "Фамилия, Имя, Отчество", СтруктураДанных.ДатаРабочегоЛистаАгрегата);
		СтруктураДанных.МОЛ = ДанныеСотрудника.Фамилия + " " + ДанныеСотрудника.Имя + " " + ДанныеСотрудника.Отчество;
			
		СтруктураДанных.Вставить("МОЛ", СтруктураДанных.МОЛ);
		СтруктураДанных.Вставить("Подразделение", СтруктураДанных.Подразделение);
		СтруктураДанных.Вставить("ЗапланированоМоторесурсов", СтруктураДанных.ЗапланированоМоторесурсов);
		СтруктураДанных.Вставить("ЕдиницаИзмеренияМоторесурсов", СтруктураДанных.ЕдиницаИзмеренияМоторесурсов);
		
		//РуководительПодразделения
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", СтруктураДанных.РуководительПодразделения, СтруктураДанных.ДатаРабочегоЛистаАгрегата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("РуководительПодразделенияФамилияИнициалы", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь));
		СтруктураДанных.Вставить("ДолжностьРуководителяПодразделения", ДанныеСотрудника.Должность);
		
		//Лицевая сторона
		Область = Макет.ПолучитьОбласть("РабочийЛистАгрегатаЛицеваяСторона");
		Область.Параметры.Заполнить(СтруктураДанных);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(Область, "НомерРабочегоЛистаАгрегата", СтруктураДанных.НомерРабочегоЛистаАгрегата, СтруктураДанных.Ссылка, Неопределено, Истина);
		
		ТабличныйДокумент.Вывести(Область);
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		//Оборотная сторона
		Область = Макет.ПолучитьОбласть("РабочийЛистАгрегатаОборотнаяСторона");
		ТабличныйДокумент.Вывести(Область);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
КонецФункции	

#КонецОбласти

#КонецЕсли
