	|		ИНАЧЕ ТабОбъектов.ИнвНомер.Код
	|	КОНЕЦ КАК ИнвНомерКод
	|ПОМЕСТИТЬ ТабОбъектовСМеталлом
	|ИЗ
	|	ТабОбъектов КАК ТабОбъектов,
	|	ТабМеталлов КАК ТабМеталлов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТабОбъектовСМеталлом.ОбъектНФА КАК Объект,
	|	ТабОбъектовСМеталлом.Наименование,
	|	ТабОбъектовСМеталлом.ИнвНомер КАК ИнвНомер,
	|	ТабОбъектовСМеталлом.Код,
	|	ТабОбъектовСМеталлом.ОКЕИ,
	|	ТабОбъектовСМеталлом.НаименованиеЕдиницы,
	|	ТабОбъектовСМеталлом.Количество,
	|	ТабОбъектовСМеталлом.ДатаВыпуска,
	|	ТабОбъектовСМеталлом.ЗаводскойНомер КАК НомерЗаводской,
	|	ТабОбъектовСМеталлом.НомерПаспорта,
	|	ТабОбъектовСМеталлом.РеестровыйНомер КАК НомерРеестровый,
	|	ТабОбъектовСМеталлом.ВидМеталла КАК ВидМеталла,
	|	ТабОбъектовСМеталлом.ПорядокМеталлов КАК ПорядокМеталлов,
	|	СодержаниеМеталлов.МассаДМ,
	|	ВЫБОР
	|		КОГДА &ВыводитьФактНаличие
	|			ТОГДА СодержаниеМеталлов.МассаДМФакт
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК МассаДМФакт,
	|	ПОДСТРОКА(ТабОбъектовСМеталлом.Наименование, 1, 30) + ТабОбъектовСМеталлом.Код + ТабОбъектовСМеталлом.ИнвНомерКод КАК КлючОбъекта,
	|	ТабОбъектовСМеталлом.ИнвНомерКод
	|ИЗ
	|	ТабОбъектовСМеталлом КАК ТабОбъектовСМеталлом
	|		ЛЕВОЕ СОЕДИНЕНИЕ СодержаниеМеталлов КАК СодержаниеМеталлов
	|		ПО ТабОбъектовСМеталлом.ОбъектНФА = СодержаниеМеталлов.ОбъектНФА
	|			И ТабОбъектовСМеталлом.ИнвНомер = СодержаниеМеталлов.ИнвНомер
	|			И ТабОбъектовСМеталлом.ВидМеталла = СодержаниеМеталлов.ВидМеталла
	|
	|УПОРЯДОЧИТЬ ПО
	|	КлючОбъекта,
	|	ПорядокМеталлов,
	|	ВидМеталла";
	
	Запрос.УстановитьПараметр("МассивОбъектов", 		МассивОбъектов); 
	Запрос.УстановитьПараметр("ВыводитьФактНаличие",	ВыводитьФактНаличие);
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	МассивДанных = Запрос.ВыполнитьПакет();
	
	ТабОбъектов  = МассивДанных[7].Выгрузить();
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Таблица.Объект,
	               |	Таблица.Наименование,
	               |	Таблица.Код,
	               |	Таблица.ИнвНомер,
	               |	Таблица.ОКЕИ,
	               |	Таблица.НаименованиеЕдиницы,
	               |	Таблица.Количество,
	               |	Таблица.ДатаВыпуска КАК ГодВыпуска,
	               |	Таблица.НомерЗаводской,
	               |	Таблица.НомерПаспорта,
	               |	Таблица.НомерРеестровый,
	               |	Таблица.ПорядокМеталлов,
	               |	Таблица.ВидМеталла,
	               |	Таблица.МассаДМ,
	               |	Таблица.МассаДМФакт,
	               |	Таблица.КлючОбъекта
	               |ПОМЕСТИТЬ ТабДанных
	               |ИЗ
	               |	&ТаблицаОбъектов КАК Таблица
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Таблица.Объект КАК Объект,
	               |	Таблица.Наименование,
	               |	Таблица.Код,
	               |	Таблица.ИнвНомер КАК ИнвНомер,
	               |	Таблица.ОКЕИ,
	               |	Таблица.НаименованиеЕдиницы,
	               |	Таблица.Количество КАК Количество,
	               |	Таблица.ГодВыпуска,
	               |	Таблица.НомерЗаводской,
	               |	Таблица.НомерПаспорта,
	               |	Таблица.НомерРеестровый,
	               |	Таблица.ПорядокМеталлов,
	               |	Таблица.ВидМеталла КАК ВидМеталла,
	               |	Таблица.МассаДМ КАК КоличествоМеталла,
	               |	Таблица.МассаДМФакт КАК КоличествоМеталлаФакт,
	               |	Таблица.КлючОбъекта
	               |ИЗ
	               |	ТабДанных КАК Таблица
	               |ИТОГИ
	               |	МАКСИМУМ(Количество),
	               |	СУММА(КоличествоМеталла),
	               |	СУММА(КоличествоМеталлаФакт)
	               |ПО
	               |	КлючОбъекта,
	               |	ВидМеталла";
				   
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаОбъектов", ТабОбъектов);
	РезультатЗапроса = Запрос.Выполнить();
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ИнвентаризационнаяОписьИНВ8а_317009");
	
	ОбластьЗаголовок       = Макет.ПолучитьОбласть("Заголовок");
	ОбластьПодписиМОЛ      = Макет.ПолучитьОбласть("ПодписиМОЛ");
	ОбластьПодвалЗаголовка = Макет.ПолучитьОбласть("ПодвалЗаголовка");
	ОбластьШапкаНачало     = Макет.ПолучитьОбласть("Шапка|Начало");
	ОбластьШапкаСередина   = Макет.ПолучитьОбласть("Шапка|Середина");
	ОбластьШапкаКонцовка   = Макет.ПолучитьОбласть("Шапка|Концовка");
	ОбластьСтрокаНачало    = Макет.ПолучитьОбласть("Строка|Начало");
	ОбластьСтрокаСередина  = Макет.ПолучитьОбласть("Строка|Середина");
	ОбластьСтрокаКонцовка  = Макет.ПолучитьОбласть("Строка|Концовка");
	ОбластьСтрока          = Макет.ПолучитьОбласть("Строка");
		
	//ОбластьГруппа          = Макет.ПолучитьОбласть("Группа");
	//ОбластьИтогПоГруппе    = Макет.ПолучитьОбласть("ИтогПоГруппе");
	
	ОбластьИтогПоСтранице         = Макет.ПолучитьОбласть("ИтогПоСтранице");
	ОбластьИтогПоСтраницеНачало   = Макет.ПолучитьОбласть("ИтогПоСтранице|Начало");
	ОбластьИтогПоСтраницеСередина = Макет.ПолучитьОбласть("ИтогПоСтранице|Середина");
	ОбластьИтогПоСтраницеКонцовка = Макет.ПолучитьОбласть("ИтогПоСтранице|Концовка");
	ОбластьИтогНачало             = Макет.ПолучитьОбласть("Итог|Начало");
	ОбластьИтогСередина           = Макет.ПолучитьОбласть("Итог|Середина");
	ОбластьИтогКонцовка           = Макет.ПолучитьОбласть("Итог|Концовка");
	ОбластьИтогПроп               = Макет.ПолучитьОбласть("ИтогПроп");
	ОбластьИтогПропДМ             = Макет.ПолучитьОбласть("ИтогПропДМ");
	ОбластьПодвалНачало           = Макет.ПолучитьОбласть("ПодвалНачало");
	ОбластьКомиссия               = Макет.ПолучитьОбласть("Комиссия");
	ОбластьПодвалСередина         = Макет.ПолучитьОбласть("ПодвалСередина");
	ОбластьПодвалКонец            = Макет.ПолучитьОбласть("ПодвалКонец");
	
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	ПервыйДокумент = Истина;
	ВыборкаШапка = МассивДанных[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКомиссия = МассивДанных[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ДанныеМОЛ = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, НаименованиеПолное, Должность",
									ВыборкаШапка.ЦМО, ВыборкаШапка.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеМОЛ, Истина);
		
		ОбластьЗаголовок.Параметры.Заполнить(ВыборкаШапка);
		
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьЗаголовок,"НомерАкта",ВыборкаШапка.Номер,ВыборкаШапка.Ссылка,, Истина);

		ПараметрыЗаполнения = Новый Структура(
										"ПолноеФИОМОЛ, МолДолжность, МолНаименование",
											ДанныеМОЛ.НаименованиеПолное,
											ДанныеМОЛ.Должность,
											КорреспондентыКлиентСервер.ФИО(ДанныеМОЛ));
		ОбластьПодписиМОЛ.Параметры.Заполнить(ПараметрыЗаполнения);
		
		НомерСтроки = 1;
		
		//------вывод на печать------------																				
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		ТабличныйДокумент.Вывести(ОбластьПодписиМОЛ);
		ТабличныйДокумент.Вывести(ОбластьПодвалЗаголовка);
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		// Выведем колонки по видам металла
		Область1     = ТабличныйДокумент.Вывести(ОбластьШапкаНачало);
		ОбластьЛево  = Область1.Право + 1;
		ОбластьВерх  = Область1.Верх;
		Область2     = Область1;
		НомерКолонки = 9;
		
		МассивОбластейПодвалаСтраницы = Новый Массив;
		МассивОбластейПодвалаСтраницы.Добавить(ОбластьСтрока);
		МассивОбластейПодвалаСтраницы.Добавить(ОбластьИтогПроп);
		МассивОбластейПодвалаСтраницы.Добавить(ОбластьИтогПоСтранице);
		
		МассивВидовДМ = Новый Массив;
		
		РазмерМассиваИтогов = 0;
		ВыборкаОбъектов = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "КлючОбъекта");
		Если ВыборкаОбъектов.Следующий() Тогда
			ВыборкаВидовМеталлов = ВыборкаОбъектов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидМеталла", "ВСЕ");
			Пока ВыборкаВидовМеталлов.Следующий() Цикл
				ОбластьШапкаСередина.Параметры.ВидМеталла = ВыборкаВидовМеталлов.ВидМеталла;
				ОбластьШапкаСередина.Параметры.НомерБУ    = НомерКолонки + 1;
				ОбластьШапкаСередина.Параметры.НомерФУ    = НомерКолонки + 2;
				ВертОбласть2 = ТабличныйДокумент.Присоединить(ОбластьШапкаСередина);
				
				НомерКолонки  = НомерКолонки + 2;
				РазмерМассиваИтогов = РазмерМассиваИтогов + 1;
				
				МассивОбластейПодвалаСтраницы.Добавить(ОбластьИтогПропДМ);
				МассивВидовДМ.Добавить(ВыборкаВидовМеталлов.ВидМеталла);
			КонецЦикла;
			ОбластьПраво = ВертОбласть2.Право;
		Иначе
			ВыборкаВидовМеталлов = ВыборкаОбъектов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидМеталла", "ВСЕ");
			МассивДляПустойФормы = Новый Массив;
			МассивДляПустойФормы.Добавить(Справочники.ДрагМеталлы.Золото);
			МассивДляПустойФормы.Добавить(Справочники.ДрагМеталлы.Серебро);
			МассивДляПустойФормы.Добавить(Справочники.ДрагМеталлы.Платина);
			Для Каждого ТекЭлемент Из МассивДляПустойФормы Цикл
				ОбластьШапкаСередина.Параметры.ВидМеталла = ТекЭлемент;
				ОбластьШапкаСередина.Параметры.НомерБУ    = НомерКолонки + 1;
				ОбластьШапкаСередина.Параметры.НомерФУ    = НомерКолонки + 2;
				ВертОбласть2 = ТабличныйДокумент.Присоединить(ОбластьШапкаСередина);
				
				НомерКолонки  = НомерКолонки + 2;
				РазмерМассиваИтогов = РазмерМассиваИтогов + 1;
				
				МассивОбластейПодвалаСтраницы.Добавить(ОбластьИтогПропДМ);
				МассивВидовДМ.Добавить(ВыборкаВидовМеталлов.ВидМеталла);
			КонецЦикла;
			ОбластьПраво = ВертОбласть2.Право;
		КонецЕсли;
		ОбластьШапкаКонцовка.Параметры.НомПоследний = НомерКолонки + 1;
		ВертОбласть3 = ТабличныйДокумент.Присоединить(ОбластьШапкаКонцовка);
		ШапкаТаблицы = ТабличныйДокумент.ПолучитьОбласть(ОбластьВерх, 1, ОбластьВерх + 3, ВертОбласть3.Право);
		
		ОбластьЗаголовкаТаблицы = ТабличныйДокумент.Область(ОбластьВерх, ОбластьЛево, ОбластьВерх, ОбластьПраво);
		ОбластьЗаголовкаТаблицы.Объединить();
		ОбластьЗаголовкаТаблицы.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		ОбластьЗаголовкаТаблицы.Текст = "Масса драгметаллов в объекте, грамм";
		
		Размер = ?(РазмерМассиваИтогов = 0, 1, РазмерМассиваИтогов);
		МассивИтогов           = Новый Массив(Размер);
		МассивИтоговПоСтранице = Новый Массив(Размер);
		ЗанулитьМассив(МассивИтогов);
		ЗанулитьМассив(МассивИтоговПоСтранице);
		
		МассивИтоговФакт           = Новый Массив(Размер);
		МассивИтоговФактПоСтранице = Новый Массив(Размер);
		ЗанулитьМассив(МассивИтоговФакт);
		ЗанулитьМассив(МассивИтоговФактПоСтранице);
		
		СтруктураОбластейИтоговСтраницы = Новый Структура("ОбластьНачало, ОбластьСередина, ОбластьКонцовка, ОбластьПроп",
											ОбластьИтогПоСтраницеНачало, ОбластьИтогПоСтраницеСередина, ОбластьИтогПоСтраницеКонцовка, ОбластьИтогПроп);
		СтруктураОбластейИтогов         = Новый Структура("ОбластьНачало, ОбластьСередина, ОбластьКонцовка", ОбластьИтогНачало, ОбластьИтогСередина, ОбластьИтогКонцовка);
		ТекстИтоговПоСтранице = "Итог по странице";
		ТекстИтоговПоАкту     = "Итог по описи";
		КолОбъектовНаСтранице = 0;
		КолМЦНаСтранице = 0;
		ВсегоКолвоМЦ = 0;
			
		// Теперь выведем строки
		ВыборкаОбъектов.Сбросить();
		Пока ВыборкаОбъектов.Следующий() Цикл
			ОбластьСтрокаНачало.Параметры.НомерСтроки = НомерСтроки;
			
			Если НЕ ТабличныйДокумент.ПроверитьВывод(МассивОбластейПодвалаСтраницы) Тогда
				ВывестиИтогиПоМассиву(ТабличныйДокумент, СтруктураОбластейИтоговСтраницы, МассивИтоговПоСтранице, , МассивИтоговФактПоСтранице);
				ВывестиПодвалСтраницы(ТабличныйДокумент, ОбластьИтогПроп, ТекстИтоговПоСтранице, КолОбъектовНаСтранице, ВыводитьФактНаличие, КолМЦНаСтранице);
				ВсегоКолвоМЦ = ВсегоКолвоМЦ + КолМЦНаСтранице;
				
				нм = 0;
				Для каждого ТекВидДМ из МассивВидовДМ Цикл
					ОбластьИтогПропДМ.Параметры.ВидМеталла = ТекВидДМ;
					Если (МассивИтоговФактПоСтранице.Количество() > нм) И ВыводитьФактНаличие Тогда  
						ОбластьИтогПропДМ.Параметры.МассаФактическаяПрописью = УчетДрагМатериалов.МассаДрагМатериаловПрописью(МассивИтоговФактПоСтранице[нм]);
					КонецЕсли;
					ТабличныйДокумент.Вывести(ОбластьИтогПропДМ);
					нм = нм + 1;
				КонецЦикла;	
				// Выведем разрыв страницы
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				
				ЗанулитьМассив(МассивИтоговПоСтранице);
				ЗанулитьМассив(МассивИтоговФактПоСтранице);
				КолОбъектовНаСтранице = 0;
				КолМЦНаСтранице = 0;
				
				ТабличныйДокумент.Вывести(ШапкаТаблицы);
			КонецЕсли;
			
			КоличествоМЦ = 0;
			
			ВыборкаВидовМеталлов = ВыборкаОбъектов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидМеталла", "ВСЕ");
			ЕстьДанные = Ложь;
			Пока ВыборкаВидовМеталлов.Следующий() И НЕ ЕстьДанные Цикл
				ВыборкаДетальная = ВыборкаВидовМеталлов.Выбрать();
				Если ВыборкаДетальная.Следующий() Тогда
					ОбластьСтрокаНачало.Параметры.Заполнить(ВыборкаДетальная);
					ОбластьСтрокаНачало.Параметры.Количество = ВыборкаОбъектов.Количество;
					
					Если ТипЗнч(ВыборкаДетальная.Объект) = Тип("СправочникСсылка.Номенклатура") Тогда
						НоменклатурныйНомерМЗ = ВыборкаДетальная.Объект.НоменклатурныйНомер;
						Если ЗначениеЗаполнено(НоменклатурныйНомерМЗ) Тогда
							ОбластьСтрокаНачало.Параметры.Код = НоменклатурныйНомерМЗ;
						КонецЕсли;	
					КонецЕсли;	
					
					КоличествоМЦ = КоличествоМЦ + ВыборкаОбъектов.Количество;
					
					ТабличныйДокумент.Вывести(ОбластьСтрокаНачало);
					ЕстьДанные = Истина;
				КонецЕсли;
			КонецЦикла;
			
			к = 0;
			ВыборкаВидовМеталлов.Сбросить();
			Пока ВыборкаВидовМеталлов.Следующий() Цикл
				ОбластьСтрокаСередина.Параметры.Заполнить(ВыборкаВидовМеталлов);
				ТабличныйДокумент.Присоединить(ОбластьСтрокаСередина);

				МассивИтоговПоСтранице[к] = МассивИтоговПоСтранице[к] + ?(ТипЗнч(ВыборкаВидовМеталлов.КоличествоМеталла) = Тип("NULL"), 0, ВыборкаВидовМеталлов.КоличествоМеталла);
				МассивИтогов[к]           = МассивИтогов[к] + ?(ТипЗнч(ВыборкаВидовМеталлов.КоличествоМеталла) = Тип("NULL"), 0, ВыборкаВидовМеталлов.КоличествоМеталла);
				
				МассивИтоговФактПоСтранице[к] = МассивИтоговФактПоСтранице[к] + ?(ТипЗнч(ВыборкаВидовМеталлов.КоличествоМеталлаФакт) = Тип("NULL"), 0, ВыборкаВидовМеталлов.КоличествоМеталлаФакт);
				МассивИтоговФакт[к]           = МассивИтоговФакт[к] + ?(ТипЗнч(ВыборкаВидовМеталлов.КоличествоМеталлаФакт) = Тип("NULL"), 0, ВыборкаВидовМеталлов.КоличествоМеталлаФакт);
				
				к = к + 1;
			КонецЦикла;
			ТабличныйДокумент.Присоединить(ОбластьСтрокаКонцовка);
			КолОбъектовНаСтранице = КолОбъектовНаСтранице + 1;
			КолМЦНаСтранице = КолМЦНаСтранице + КоличествоМЦ;
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
		
		ВывестиИтогиПоМассиву(ТабличныйДокумент, СтруктураОбластейИтоговСтраницы, МассивИтоговПоСтранице, , МассивИтоговФактПоСтранице);
		ВывестиИтогиПоМассиву(ТабличныйДокумент, СтруктураОбластейИтогов, МассивИтогов, , МассивИтоговФакт);
		ВывестиПодвалСтраницы(ТабличныйДокумент, ОбластьИтогПроп, ТекстИтоговПоСтранице, КолОбъектовНаСтранице, ВыводитьФактНаличие, КолМЦНаСтранице);
		
		ВсегоКолвоМЦ = ВсегоКолвоМЦ + КолМЦНаСтранице;
		
		нм = 0;
		Для каждого ТекВидДМ из МассивВидовДМ Цикл
			ОбластьИтогПропДМ.Параметры.ВидМеталла = ТекВидДМ;
			Если (МассивИтоговФактПоСтранице.Количество() > нм) И ВыводитьФактНаличие Тогда  
				ОбластьИтогПропДМ.Параметры.МассаФактическаяПрописью = УчетДрагМатериалов.МассаДрагМатериаловПрописью(МассивИтоговФактПоСтранице[нм]);
			КонецЕсли;
			ТабличныйДокумент.Вывести(ОбластьИтогПропДМ);
			нм = нм + 1;
		КонецЦикла;	
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		ВывестиПодвалСтраницы(ТабличныйДокумент, ОбластьИтогПроп, ТекстИтоговПоАкту, ВыборкаОбъектов.Количество(), ВыводитьФактНаличие, ВсегоКолвоМЦ);
		нм = 0;
		Для каждого ТекВидДМ из МассивВидовДМ Цикл
			ОбластьИтогПропДМ.Параметры.ВидМеталла = ТекВидДМ;
			
			Если (МассивИтоговФактПоСтранице.Количество() > нм) И ВыводитьФактНаличие Тогда  
				ОбластьИтогПропДМ.Параметры.МассаФактическаяПрописью = УчетДрагМатериалов.МассаДрагМатериаловПрописью(МассивИтоговФакт[нм]);
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьИтогПропДМ);
			нм = нм + 1;
		КонецЦикла;	
		ТабличныйДокумент.Вывести(ОбластьПодвалНачало);
		
		ВыборкаКомиссия.Сбросить();
		ВыборкаКомиссия.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка));
		
		ОбластьВсяКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(	ВыборкаШапка, 
																						ВыборкаКомиссия.Выбрать(), 
																						ОбластьКомиссия, 
																						3);
		
		ТабличныйДокумент.Вывести(ОбластьВсяКомиссия);

		Если НомерСтроки > 1 Тогда
			ПервыйНомерСтр = "1";
			ПоследнийНомерСтр = Строка(НомерСтроки-1);
		Иначе
			ПервыйНомерСтр = "_______";
			ПоследнийНомерСтр = "_______";
		КонецЕсли;
		
		ОбластьПодвалСередина.Параметры.ПервыйНомер = ПервыйНомерСтр;
		ОбластьПодвалСередина.Параметры.ПоследнийНомер = ПоследнийНомерСтр;
		
		ТабличныйДокумент.Вывести(ОбластьПодвалСередина);
		ТабличныйДокумент.Вывести(ОбластьПодписиМОЛ);
		ТабличныйДокумент.Вывести(ОбластьПодвалКонец);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

Функция ПечатьФормыИНВ22(МассивОбъектов, ОбъектыПечати) 
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ИмяПараметровПечати = "ИнвентаризацияМЗ_ПечатьФормыИНВ22";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ИНВ22");

	ЗапросПечать = Новый Запрос();
	ЗапросПечать.УстановитьПараметр("ВидИнвЛомОтходы",	Перечисления.ВидыИнвентаризацииДрагМатериалов.ИнвентаризацияДрагМеталловВЛомеОтходах);
	ЗапросПечать.УстановитьПараметр("МассивСсылок",		МассивОбъектов);
	ЗапросПечать.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка КАК ДокСсылка,
	|	Док.Номер КАК Номер,
	|	Док.ДатаИнвентаризации КАК Дата,
	|	Док.Организация КАК Организация,
	|	Док.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	|	Док.Организация.КодОКПО КАК КодОКПО,
	|	Док.Подразделение.Наименование КАК НаименованиеПодразделения,
	|	Док.НомерПриказаИнвентаризации КАК НомерПриказаИнвентаризации,
	|	Док.ДатаПриказаИнвентаризации КАК ДатаПриказаИнвентаризации,
	|	ВЫБОР
	|		КОГДА Док.ВидИнвентаризации = &ВидИнвЛомОтходы
	|			ТОГДА ""Драгоценные металлы, содержащиеся в ломе и отходах""
	|		ИНАЧЕ ""Драгоценные металлы, содержащиеся в деталях, полуфабрикатах, сборочных единицах (узлах), оборудовании, приборах и других изделиях""
	|	КОНЕЦ КАК НаименованиеИмуществаОбязательств,
	|	Док.ДолжностьПредседателяКомиссии КАК ДолжностьПредседателяКомиссии,
	|	Док.ФамилияПредседателяКомиссии КАК ФамилияПредседателяКомиссии,
	|	Док.ИмяПредседателяКомиссии КАК ИмяПредседателяКомиссии,
	|	Док.ОтчествоПредседателяКомиссии КАК ОтчествоПредседателяКомиссии,
	|	Док.ДатаНачала КАК ДатаНачала,
	|	Док.ДатаОкончания КАК ДатаОкончания,
	|	Док.ПричинаИнвентаризации КАК ПричинаПроведенияИнвентаризации
	|ИЗ
	|	Документ.ИнвентаризацияДрагМеталловВНФА КАК Док
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка КАК ДокСсылка,
	|	ТЧ.ДолжностьЧленаКомиссии КАК ДолжностьЧленаКомиссии,
	|	ТЧ.ФамилияЧленаКомиссии КАК ФамилияЧленаКомиссии,
	|	ТЧ.ИмяЧленаКомиссии КАК ИмяЧленаКомиссии,
	|	ТЧ.ОтчествоЧленаКомиссии КАК ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ИнвентаризацияДрагМеталловВНФА.СоставКомиссии КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка В(&МассивСсылок)
	|ИТОГИ ПО
	|	ДокСсылка";
	
	ЗапросПечать.ВыполнитьПакет();
	
	Результаты = ЗапросПечать.ВыполнитьПакет();
	
	ВыборкаШапка		= Результаты[0].Выбрать();
	ВыборкаДокКомиссия	= Результаты[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		ОбластьШапка 	= Макет.ПолучитьОбласть("Шапка");
		ОбластьКомиссия	= Макет.ПолучитьОбласть("Комиссия");
		ОбластьПодвал 	= Макет.ПолучитьОбласть("Подвал");
		
		ПоискТекущегоДокумента = Новый Структура("ДокСсылка", ВыборкаШапка["ДокСсылка"]);
		ВыборкаДокКомиссия.Сбросить();
		ЕстьВыборкаДокКомиссия = ВыборкаДокКомиссия.НайтиСледующий(ПоискТекущегоДокумента);
		
		КоличествоСтрок = 0;
		Если НЕ ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент	= Ложь;
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		НомерСтраницы = 1;
		ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьШапка,"Номер",ВыборкаШапка.Номер,ВыборкаШапка.ДокСсылка,,Истина);
		ТабДокумент.Вывести(ОбластьШапка);
		
		ОбластьВсяКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(
			ВыборкаШапка,
			ВыборкаДокКомиссия.Выбрать(), 
			ОбластьКомиссия, 
			3);
		ТабДокумент.Вывести(ОбластьВсяКомиссия);
		
		Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
			ВыборкаШапка["Организация"],
			ВыборкаШапка["Дата"]);
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("ДолжностьРуководителя",	Руководитель["ДолжностьПредставление"]);
		ЗначенияПараметров.Вставить("ФИОРуководителя",			КорреспондентыКлиентСервер.ФИО(Руководитель["ОтветственноеЛицоФИО"]));
		ЗначенияПараметров.Вставить("ДатаНачала",		Формат(ВыборкаШапка["ДатаНачала"], "ДФ=dd.MM.yyyy"));
		ЗначенияПараметров.Вставить("ДатаОкончания",	Формат(ВыборкаШапка["ДатаОкончания"], "ДФ=dd.MM.yyyy"));
		ОбластьПодвал.Параметры.Заполнить(ВыборкаШапка);
		ОбластьПодвал.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(ОбластьПодвал);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.ДокСсылка);
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПечатьИнвОписиЛомОтходы(МассивОбъектов, ОбъектыПечати, ВыводитьФактНаличие = Ложь)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Если НЕ ПечатнаяФормаСоответствует(МассивОбъектов, Истина) Тогда
		Возврат ТабличныйДокумент;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИнвентаризацияДрагМеталловВНФА.Ссылка КАК Ссылка,
	|	ИнвентаризацияДрагМеталловВНФА.Номер КАК Номер,
	|	ИнвентаризацияДрагМеталловВНФА.ДатаИнвентаризации КАК Дата,
	|	ИнвентаризацияДрагМеталловВНФА.Организация,
	|	ИнвентаризацияДрагМеталловВНФА.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	|	ИнвентаризацияДрагМеталловВНФА.Подразделение.Наименование КАК НаименованиеПодразделения,
	|	ИнвентаризацияДрагМеталловВНФА.Организация.КодОКПО КАК КодОКПО,
	|	ВЫБОР
	|		КОГДА ИнвентаризацияДрагМеталловВНФА.ЦМО ССЫЛКА Справочник.ЦМО
	|			ТОГДА ИнвентаризацияДрагМеталловВНФА.ЦМО.Сотрудник.Контрагент.ЮридическоеФизическоеЛицо.Наименование
	|		КОГДА ИнвентаризацияДрагМеталловВНФА.ЦМО ССЫЛКА Справочник.Сотрудники
	|			ТОГДА ИнвентаризацияДрагМеталловВНФА.ЦМО.Контрагент.ЮридическоеФизическоеЛицо.Наименование
	|	КОНЕЦ КАК ПолноеФИОМОЛ,
	|	ВЫБОР
	|		КОГДА ИнвентаризацияДрагМеталловВНФА.ЦМО ССЫЛКА Справочник.ЦМО
	|			ТОГДА ИнвентаризацияДрагМеталловВНФА.ЦМО.Сотрудник
	|		КОГДА ИнвентаризацияДрагМеталловВНФА.ЦМО ССЫЛКА Справочник.Сотрудники
	|			ТОГДА ИнвентаризацияДрагМеталловВНФА.ЦМО
	|	КОНЕЦ КАК ЦМО,
	|	ИнвентаризацияДрагМеталловВНФА.НомерПриказаИнвентаризации КАК НомерПриказа,
	|	ИнвентаризацияДрагМеталловВНФА.ДатаПриказаИнвентаризации КАК ДатаПриказа,
	|	ИнвентаризацияДрагМеталловВНФА.МестоИнвентаризации,
	|	ИнвентаризацияДрагМеталловВНФА.ДатаНачала КАК ДатаНачалаИнвентаризации,
	|	ИнвентаризацияДрагМеталловВНФА.ДатаОкончания КАК ДатаОкончанияИнвентаризации,
	|	ИнвентаризацияДрагМеталловВНФА.ДолжностьПредседателяКомиссии,
	|	ИнвентаризацияДрагМеталловВНФА.ФамилияПредседателяКомиссии,
	|	ИнвентаризацияДрагМеталловВНФА.ИмяПредседателяКомиссии,
	|	ИнвентаризацияДрагМеталловВНФА.ОтчествоПредседателяКомиссии
	|ИЗ
	|	Документ.ИнвентаризацияДрагМеталловВНФА КАК ИнвентаризацияДрагМеталловВНФА
	|ГДЕ
	|	ИнвентаризацияДрагМеталловВНФА.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИнвентаризацияДрагМеталловВНФАСоставКомиссии.Ссылка КАК Ссылка,
	|	ИнвентаризацияДрагМеталловВНФАСоставКомиссии.НомерСтроки,
	|	ИнвентаризацияДрагМеталловВНФАСоставКомиссии.ДолжностьЧленаКомиссии,
