		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеМОЛ, Истина);
		
		ОбластьЗаголовок.Параметры.Заполнить(ВыборкаШапка);
		
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьЗаголовок,"НомерАкта",ВыборкаШапка.Номер,ВыборкаШапка.Ссылка,, Истина);

		ПараметрыЗаполнения = Новый Структура(
										"ПолноеФИОМОЛ, МолДолжность, МолНаименование",
											ДанныеМОЛ.НаименованиеПолное,
											ДанныеМОЛ.Должность,
											КорреспондентыКлиентСервер.ФИО(ДанныеМОЛ));
		ОбластьПодписиМОЛ.Параметры.Заполнить(ПараметрыЗаполнения);
		
		НомерСтроки = 1;
		
		//------вывод на печать------------																				
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		ТабличныйДокумент.Вывести(ОбластьПодписиМОЛ);
		ТабличныйДокумент.Вывести(ОбластьПодвалЗаголовка);
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		// Выведем колонки по видам металла
		Область1     = ТабличныйДокумент.Вывести(ОбластьШапкаНачало);
		ОбластьЛево  = Область1.Право + 1;
		ОбластьВерх  = Область1.Верх;
		Область2     = Область1;
		НомерКолонки = 7;
		
		МассивОбластейПодвалаСтраницы = Новый Массив;
		МассивОбластейПодвалаСтраницы.Добавить(ОбластьСтрока);
		МассивОбластейПодвалаСтраницы.Добавить(ОбластьИтогПроп);
		МассивОбластейПодвалаСтраницы.Добавить(ОбластьИтогПоСтранице);
		
		МассивВидовДМ = Новый Массив;
		
		РазмерМассиваИтогов = 0;
		ВыборкаОбъектов = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "КлючОбъекта");
		Если ВыборкаОбъектов.Следующий() Тогда
			ВыборкаВидовМеталлов = ВыборкаОбъектов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидМеталла", "ВСЕ");
			Пока ВыборкаВидовМеталлов.Следующий() Цикл
				ОбластьШапкаСередина.Параметры.ВидМеталла = ВыборкаВидовМеталлов.ВидМеталла;
				ОбластьШапкаСередина.Параметры.НомерБУ    = НомерКолонки + 1;
				ОбластьШапкаСередина.Параметры.НомерФУ    = НомерКолонки + 2;
				ВертОбласть2 = ТабличныйДокумент.Присоединить(ОбластьШапкаСередина);
				
				НомерКолонки  = НомерКолонки + 2;
				РазмерМассиваИтогов = РазмерМассиваИтогов + 1;
				
				МассивОбластейПодвалаСтраницы.Добавить(ОбластьИтогПропДМ);
				МассивВидовДМ.Добавить(ВыборкаВидовМеталлов.ВидМеталла);
			КонецЦикла;
			ОбластьПраво = ВертОбласть2.Право;
		Иначе
			ВыборкаВидовМеталлов = ВыборкаОбъектов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидМеталла", "ВСЕ");
			МассивДляПустойФормы = Новый Массив;
			МассивДляПустойФормы.Добавить(Справочники.ДрагМеталлы.Золото);
			МассивДляПустойФормы.Добавить(Справочники.ДрагМеталлы.Серебро);
			МассивДляПустойФормы.Добавить(Справочники.ДрагМеталлы.Платина);
			Для Каждого ТекЭлемент Из МассивДляПустойФормы Цикл
				ОбластьШапкаСередина.Параметры.ВидМеталла = ТекЭлемент;
				ОбластьШапкаСередина.Параметры.НомерБУ    = НомерКолонки + 1;
				ОбластьШапкаСередина.Параметры.НомерФУ    = НомерКолонки + 2;
				ВертОбласть2 = ТабличныйДокумент.Присоединить(ОбластьШапкаСередина);
				
				НомерКолонки  = НомерКолонки + 2;
				РазмерМассиваИтогов = РазмерМассиваИтогов + 1;
				
				МассивОбластейПодвалаСтраницы.Добавить(ОбластьИтогПропДМ);
				МассивВидовДМ.Добавить(ВыборкаВидовМеталлов.ВидМеталла);
			КонецЦикла;
			ОбластьПраво = ВертОбласть2.Право;
		КонецЕсли;
		ОбластьШапкаКонцовка.Параметры.НомПоследний = НомерКолонки + 1;
		ВертОбласть3 = ТабличныйДокумент.Присоединить(ОбластьШапкаКонцовка);
		ШапкаТаблицы = ТабличныйДокумент.ПолучитьОбласть(ОбластьВерх, 1, ОбластьВерх + 3, ВертОбласть3.Право);
		
		ОбластьЗаголовкаТаблицы = ТабличныйДокумент.Область(ОбластьВерх, ОбластьЛево, ОбластьВерх, ОбластьПраво);
		ОбластьЗаголовкаТаблицы.Объединить();
		ОбластьЗаголовкаТаблицы.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		ОбластьЗаголовкаТаблицы.Текст = "Масса драгметаллов в объекте, грамм";
		
		Размер = ?(РазмерМассиваИтогов = 0, 1, РазмерМассиваИтогов);
		МассивИтогов           = Новый Массив(Размер);
		МассивИтоговПоСтранице = Новый Массив(Размер);
		ЗанулитьМассив(МассивИтогов);
		ЗанулитьМассив(МассивИтоговПоСтранице);
		
		//Лигатурная масса
		МассивИтоговЛигатуры           = Новый Массив(Размер);
		МассивИтоговЛигатурыПоСтранице = Новый Массив(Размер);
		ЗанулитьМассив(МассивИтоговЛигатуры);
		ЗанулитьМассив(МассивИтоговЛигатурыПоСтранице);
		
		МассивИтоговФакт           = Новый Массив(Размер);
		МассивИтоговФактПоСтранице = Новый Массив(Размер);
		ЗанулитьМассив(МассивИтоговФакт);
		ЗанулитьМассив(МассивИтоговФактПоСтранице);
		
		МассивИтоговЛигатурыФакт           = Новый Массив(Размер);
		МассивИтоговЛигатурыФактПоСтранице = Новый Массив(Размер);
		ЗанулитьМассив(МассивИтоговЛигатурыФакт);
		ЗанулитьМассив(МассивИтоговЛигатурыФактПоСтранице);
		
		СтруктураОбластейИтоговСтраницы = Новый Структура("ОбластьНачало, ОбластьСередина, ОбластьКонцовка, ОбластьПроп",
											ОбластьИтогПоСтраницеНачало, ОбластьИтогПоСтраницеСередина, ОбластьИтогПоСтраницеКонцовка, ОбластьИтогПроп);
		СтруктураОбластейИтогов         = Новый Структура("ОбластьНачало, ОбластьСередина, ОбластьКонцовка", ОбластьИтогНачало, ОбластьИтогСередина, ОбластьИтогКонцовка);
		ТекстИтоговПоСтранице = "Итог по странице";
		ТекстИтоговПоАкту     = "Итог по описи";
		КолОбъектовНаСтранице = 0;
		КолМЦНаСтранице = 0;
		ВсегоКолвоМЦ = 0;
			
		// Теперь выведем строки
		ВыборкаОбъектов.Сбросить();
		Пока ВыборкаОбъектов.Следующий() Цикл
			ОбластьСтрокаНачало.Параметры.НомерСтроки = НомерСтроки;
			
			Если НЕ ТабличныйДокумент.ПроверитьВывод(МассивОбластейПодвалаСтраницы) Тогда
				ВывестиИтогиПоМассиву(ТабличныйДокумент, СтруктураОбластейИтоговСтраницы, МассивИтоговПоСтранице, МассивИтоговЛигатурыПоСтранице, МассивИтоговФактПоСтранице, МассивИтоговЛигатурыФактПоСтранице);
				ВывестиПодвалСтраницы(ТабличныйДокумент, ОбластьИтогПроп, ТекстИтоговПоСтранице, КолОбъектовНаСтранице, ВыводитьФактНаличие, КолМЦНаСтранице);
				ВсегоКолвоМЦ = ВсегоКолвоМЦ + КолМЦНаСтранице;

				нм = 0;
				Для каждого ТекВидДМ из МассивВидовДМ Цикл
					ОбластьИтогПропДМ.Параметры.ВидМеталла = ТекВидДМ;
					
					Если (МассивИтоговФактПоСтранице.Количество() > нм) И ВыводитьФактНаличие Тогда  
						ОбластьИтогПропДМ.Параметры.МассаФактическаяПрописью = УчетДрагМатериалов.МассаДрагМатериаловПрописью(МассивИтоговФактПоСтранице[нм]);
						ОбластьИтогПропДМ.Параметры.МассаЛигатурнаяФактическаяПрописью = УчетДрагМатериалов.МассаДрагМатериаловПрописью(МассивИтоговЛигатурыФактПоСтранице[нм]);
					КонецЕсли;
					
					ТабличныйДокумент.Вывести(ОбластьИтогПропДМ);
					нм = нм + 1;
				КонецЦикла;	
				// Выведем разрыв страницы
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				
				ЗанулитьМассив(МассивИтоговПоСтранице);
				ЗанулитьМассив(МассивИтоговЛигатурыПоСтранице);
				ЗанулитьМассив(МассивИтоговФактПоСтранице);
				ЗанулитьМассив(МассивИтоговЛигатурыФактПоСтранице);
				КолОбъектовНаСтранице = 0;
				КолМЦНаСтранице = 0;
				
				ТабличныйДокумент.Вывести(ШапкаТаблицы);
			КонецЕсли;
			
			КоличествоМЦ = 0;
			
			ВыборкаВидовМеталлов = ВыборкаОбъектов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидМеталла", "ВСЕ");
			ЕстьДанные = Ложь;
			Пока ВыборкаВидовМеталлов.Следующий() И НЕ ЕстьДанные Цикл
				ВыборкаДетальная = ВыборкаВидовМеталлов.Выбрать();
				Если ВыборкаДетальная.Следующий() Тогда
					ОбластьСтрокаНачало.Параметры.Заполнить(ВыборкаДетальная);
					ОбластьСтрокаНачало.Параметры.Количество = ВыборкаОбъектов.Количество;
					КоличествоМЦ = КоличествоМЦ + ВыборкаОбъектов.Количество;
					
					Если ТипЗнч(ВыборкаДетальная.Объект) = Тип("СправочникСсылка.Номенклатура") Тогда
						НоменклатурныйНомерМЗ = ВыборкаДетальная.Объект.НоменклатурныйНомер;
						Если ЗначениеЗаполнено(НоменклатурныйНомерМЗ) Тогда
							ОбластьСтрокаНачало.Параметры.Код = НоменклатурныйНомерМЗ;
						КонецЕсли;	
					КонецЕсли;	
					
					ТабличныйДокумент.Вывести(ОбластьСтрокаНачало);
					ЕстьДанные = Истина;
				КонецЕсли;
			КонецЦикла;
			
			к = 0;
			ВыборкаВидовМеталлов.Сбросить();
			Пока ВыборкаВидовМеталлов.Следующий() Цикл
				ОбластьСтрокаСередина.Параметры.Заполнить(ВыборкаВидовМеталлов);
				ТабличныйДокумент.Присоединить(ОбластьСтрокаСередина);

				МассивИтоговПоСтранице[к] = МассивИтоговПоСтранице[к] + ?(ТипЗнч(ВыборкаВидовМеталлов.КоличествоМеталла) = Тип("NULL"), 0, ВыборкаВидовМеталлов.КоличествоМеталла);
				МассивИтогов[к]           = МассивИтогов[к] + ?(ТипЗнч(ВыборкаВидовМеталлов.КоличествоМеталла) = Тип("NULL"), 0, ВыборкаВидовМеталлов.КоличествоМеталла);
				
				МассивИтоговЛигатурыПоСтранице[к] = МассивИтоговЛигатурыПоСтранице[к] + ?(ТипЗнч(ВыборкаВидовМеталлов.ЛигатурноеКоличествоМеталла) = Тип("NULL"), 0, ВыборкаВидовМеталлов.ЛигатурноеКоличествоМеталла);
				МассивИтоговЛигатуры[к]           = МассивИтоговЛигатуры[к] + ?(ТипЗнч(ВыборкаВидовМеталлов.ЛигатурноеКоличествоМеталла) = Тип("NULL"), 0, ВыборкаВидовМеталлов.ЛигатурноеКоличествоМеталла);
				
				МассивИтоговФактПоСтранице[к] = МассивИтоговФактПоСтранице[к] + ?(ТипЗнч(ВыборкаВидовМеталлов.КоличествоМеталлаФакт) = Тип("NULL"), 0, ВыборкаВидовМеталлов.КоличествоМеталлаФакт);
				МассивИтоговФакт[к]           = МассивИтоговФакт[к] + ?(ТипЗнч(ВыборкаВидовМеталлов.КоличествоМеталлаФакт) = Тип("NULL"), 0, ВыборкаВидовМеталлов.КоличествоМеталлаФакт);
				
				МассивИтоговЛигатурыФактПоСтранице[к] = МассивИтоговЛигатурыФактПоСтранице[к] + ?(ТипЗнч(ВыборкаВидовМеталлов.ЛигатурноеКоличествоМеталлаФакт) = Тип("NULL"), 0, ВыборкаВидовМеталлов.ЛигатурноеКоличествоМеталлаФакт);
				МассивИтоговЛигатурыФакт[к]           = МассивИтоговЛигатурыФакт[к] + ?(ТипЗнч(ВыборкаВидовМеталлов.ЛигатурноеКоличествоМеталлаФакт) = Тип("NULL"), 0, ВыборкаВидовМеталлов.ЛигатурноеКоличествоМеталлаФакт);
				
				к = к + 1;
			КонецЦикла;
			ТабличныйДокумент.Присоединить(ОбластьСтрокаКонцовка);
			КолОбъектовНаСтранице = КолОбъектовНаСтранице + 1;
			КолМЦНаСтранице = КолМЦНаСтранице + КоличествоМЦ;
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
		
		ВывестиИтогиПоМассиву(ТабличныйДокумент, СтруктураОбластейИтоговСтраницы, МассивИтоговПоСтранице, МассивИтоговЛигатурыПоСтранице, МассивИтоговФактПоСтранице, МассивИтоговЛигатурыФактПоСтранице);
		ВывестиИтогиПоМассиву(ТабличныйДокумент, СтруктураОбластейИтогов, МассивИтогов, МассивИтоговЛигатуры, МассивИтоговФакт, МассивИтоговЛигатурыФакт);
		ВывестиПодвалСтраницы(ТабличныйДокумент, ОбластьИтогПроп, ТекстИтоговПоСтранице, КолОбъектовНаСтранице, ВыводитьФактНаличие, КолМЦНаСтранице);
		
		ВсегоКолвоМЦ = ВсегоКолвоМЦ + КолМЦНаСтранице;
		
		нм = 0;
		Для каждого ТекВидДМ из МассивВидовДМ Цикл
			ОбластьИтогПропДМ.Параметры.ВидМеталла = ТекВидДМ;
			
			Если (МассивИтоговФактПоСтранице.Количество() > нм) И ВыводитьФактНаличие Тогда  
				ОбластьИтогПропДМ.Параметры.МассаФактическаяПрописью = УчетДрагМатериалов.МассаДрагМатериаловПрописью(МассивИтоговФактПоСтранице[нм]);
				ОбластьИтогПропДМ.Параметры.МассаЛигатурнаяФактическаяПрописью = УчетДрагМатериалов.МассаДрагМатериаловПрописью(МассивИтоговЛигатурыФактПоСтранице[нм]);
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьИтогПропДМ);
			нм = нм + 1;
		КонецЦикла;	
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		ВывестиПодвалСтраницы(ТабличныйДокумент, ОбластьИтогПроп, ТекстИтоговПоАкту, ВыборкаОбъектов.Количество(), ВыводитьФактНаличие, ВсегоКолвоМЦ);
		нм = 0;
		Для каждого ТекВидДМ из МассивВидовДМ Цикл
			ОбластьИтогПропДМ.Параметры.ВидМеталла = ТекВидДМ;
			
			Если (МассивИтоговФактПоСтранице.Количество() > нм) И ВыводитьФактНаличие Тогда  
				ОбластьИтогПропДМ.Параметры.МассаФактическаяПрописью = УчетДрагМатериалов.МассаДрагМатериаловПрописью(МассивИтоговФакт[нм]);
				ОбластьИтогПропДМ.Параметры.МассаЛигатурнаяФактическаяПрописью = УчетДрагМатериалов.МассаДрагМатериаловПрописью(МассивИтоговЛигатурыФакт[нм]);
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьИтогПропДМ);
			нм = нм + 1;
		КонецЦикла;	
		ТабличныйДокумент.Вывести(ОбластьПодвалНачало);
		
		ВыборкаКомиссия.Сбросить();
		ВыборкаКомиссия.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка));
		
		ОбластьКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(	ВыборкаШапка, 
																						ВыборкаКомиссия.Выбрать(), 
																						ОбластьКомиссия, 
																						3);
		
		ТабличныйДокумент.Вывести(ОбластьКомиссия);

		Если НомерСтроки > 1 Тогда
			ПервыйНомерСтр = "1";
			ПоследнийНомерСтр = Строка(НомерСтроки-1);
		Иначе
			ПервыйНомерСтр = "_______";
			ПоследнийНомерСтр = "_______";
		КонецЕсли;
		
		ОбластьПодвалСередина.Параметры.ПервыйНомер = ПервыйНомерСтр;
		ОбластьПодвалСередина.Параметры.ПоследнийНомер = ПоследнийНомерСтр;
		
		ТабличныйДокумент.Вывести(ОбластьПодвалСередина);
		ТабличныйДокумент.Вывести(ОбластьПодписиМОЛ);
		ТабличныйДокумент.Вывести(ОбластьПодвалКонец);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

#КонецОбласти

Процедура ВывестиИтогиПоМассиву(ТабДокумент, СтруктураОбластей, МассивИтогов, МассивИтоговЛигатуры = Неопределено, МассивИтоговФакт = Неопределено, МассивИтоговЛигатурыФакт = Неопределено)
	ОбластьНачало   = СтруктураОбластей.ОбластьНачало;
	ОбластьСередина = СтруктураОбластей.ОбластьСередина;
	ОбластьКонцовка = СтруктураОбластей.ОбластьКонцовка;
	
	ТабДокумент.Вывести(ОбластьНачало);
	РазмерМассива = МассивИтогов.Количество();
	Для к = 0 по РазмерМассива - 1 Цикл
		ОбластьСередина.Параметры.КоличествоМеталла = МассивИтогов[к];
		
		Если МассивИтоговФакт <> Неопределено Тогда
			ОбластьСередина.Параметры.КоличествоМеталлаФакт = МассивИтоговФакт[к];
		КонецЕсли;
	
		Если МассивИтоговЛигатуры <> Неопределено Тогда
			ОбластьСередина.Параметры.ЛигатурноеКоличествоМеталла = МассивИтоговЛигатуры[к];
		КонецЕсли;
		
		Если МассивИтоговЛигатурыФакт <> Неопределено Тогда
			ОбластьСередина.Параметры.ЛигатурноеКоличествоМеталлаФакт = МассивИтоговЛигатурыФакт[к];
		КонецЕсли;
		
		ТабДокумент.Присоединить(ОбластьСередина);
	КонецЦикла;	
	ТабДокумент.Присоединить(ОбластьКонцовка);
КонецПроцедуры	

Процедура ВывестиПодвалСтраницы(ТабДокумент, ОбластьПрописи, ТекТекст, КоличествоОбъектов, ВыводитьФактНаличие = Ложь, КоличествоМЦ = 0)
	ОбластьПрописи.Параметры.ИтогПрописью = ТекТекст;
	ОбластьПрописи.Параметры.КоличествоПорядковыхНомеров = ЧислоПрописью(КоличествоОбъектов,, ",,,,,,,,0");
	Если ВыводитьФактНаличие Тогда
		ОбластьПрописи.Параметры.КоличествоФактическоеПрописью = УчетДрагМатериалов.КоличествоМЦПрописью(КоличествоМЦ);
	КонецЕсли;	
	ТабДокумент.Вывести(ОбластьПрописи);
КонецПроцедуры	

Процедура ЗанулитьМассив(ТекМассив)
	РазмерМассива = ТекМассив.Количество();
	Для к = 0 По РазмерМассива - 1 Цикл
		ТекМассив[к] = 0;
	КонецЦикла;
КонецПроцедуры

Функция ПечатнаяФормаСоответствует(МассивОбъектов, ФормаЛомОтходы = Ложь)
	Результат = Истина;
	
	Для каждого ТекОбъект Из МассивОбъектов Цикл	
		Если ФормаЛомОтходы И ТекОбъект.ВидИнвентаризации <> Перечисления.ВидыИнвентаризацииДрагМатериалов.ИнвентаризацияДрагМеталловВЛомеОтходах Тогда
			ТекстОшибки = НСтр("ru='Печатная форма не соответствует указанному виду инвентаризации для документа %1!'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекОбъект);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ТекОбъект.Ссылка, , "Объект", );
			
			Результат = Ложь;
		ИначеЕсли НЕ ФормаЛомОтходы И ТекОбъект.ВидИнвентаризации = Перечисления.ВидыИнвентаризацииДрагМатериалов.ИнвентаризацияДрагМеталловВЛомеОтходах Тогда
			ТекстОшибки = НСтр("ru='Печатная форма не соответствует указанному виду инвентаризации для документа %1!'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекОбъект);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ТекОбъект.Ссылка, , "Объект", );
			
			Результат = Ложь;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

