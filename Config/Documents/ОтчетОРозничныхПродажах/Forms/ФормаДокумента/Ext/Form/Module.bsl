#Область ОбработчикиСобытийЭлементовТаблицыФормы_Продажи

&НаКлиенте
Процедура ПродажиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = ОрганизацияНеЗаполнена();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродажиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанные = Элементы.Продажи.ТекущиеДанные;
		ТекущиеДанные.Сумма = Объект.СуммаДокумента - Объект.Продажи.Итог("Сумма") + ТекущиеДанные.Сумма;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродажиСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Продажи.ТекущиеДанные;
	СтавкаНДС = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(ТекущиеДанные.СтавкаНДС);
	ТекущиеДанные.СуммаНДС = ТекущиеДанные.Сумма * СтавкаНДС / (100 + СтавкаНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродажиСтавкаНДСПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Продажи.ТекущиеДанные;
	СтавкаНДС = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(ТекущиеДанные.СтавкаНДС);
	ТекущиеДанные.СуммаНДС = ТекущиеДанные.Сумма * СтавкаНДС / (100 + СтавкаНДС);
	
КонецПроцедуры

#КонецОбласти

