&НаСервере
Процедура УстановитьВидимость()
	
	Элементы.ГруппаИсполнение.Видимость = НЕ Объект.ЭтоРасторжение;
	Элементы.ГруппаРасторжение.Видимость = Объект.ЭтоРасторжение;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументыКонтрактаСервер()
	
	Объект.Исполнение.Очистить();
	
	Выборка = РаботаСОбязательствами.ПолучитьДанныеПоставокОплатПоОбязательству(Объект.Организация, Объект.Договор);
	
	ТабЗн = Объект.Исполнение.Выгрузить();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТабЗн.Добавить();
		НоваяСтрока.ЭтоОплата 					= Выборка.ЭтоОплата;
		НоваяСтрока.Исполнение 					= НЕ Выборка.ЭтоОплата;
		НоваяСтрока.ДокументИсполнения			= Выборка.Регистратор;
		НоваяСтрока.ВидПервичногоДокумента 		= Выборка.ВидПервичногоДокумента;
		НоваяСтрока.ДатаПервичногоДокумента 	= Выборка.ДатаПервичногоДокумента;
		НоваяСтрока.НомерПервичногоДокумента 	= Выборка.НомерПервичногоДокумента;
		НоваяСтрока.Сумма 						= Выборка.СуммаВВалютеКонтракта;
		НоваяСтрока.Валюта 						= Выборка.Валюта;
		НоваяСтрока.Курс 						= Выборка.КурсВалюты;
		НоваяСтрока.СуммаВРублях 				= Выборка.СуммаВРублях;
		НоваяСтрока.Количество 					= Выборка.Количество;
	КонецЦикла;                

	
	Объект.Исполнение.Загрузить(ТабЗн);
	
	Объект.Исполнение.Сортировать("ДатаПервичногоДокумента");
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыСервер()
	
	Объект.Товары.Загрузить(РаботаСОбязательствами.НоменклатураПоставокПоДоговору(Объект.Договор));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РассчитатьСуммуОплатыРасторженияСервер(ЗНАЧ Организация, ЗНАЧ Договор)
   Результат = 0;
	
	Выборка = РаботаСОбязательствами.ПолучитьДанныеСуммыОплатПоОбязательству(Организация, Договор);
	Пока Выборка.Следующий() Цикл		
		Результат = Результат + Выборка.Кредит - Выборка.Дебет;
	КонецЦикла; 
	
	Возврат Результат;

КонецФункции // РассчитатьСуммуОплатыРасторженияСервер()

&НаСервереБезКонтекста
Функция ПолучитьТабличныйДокументРасчета(Организация, Обязательство)
	
	ТабДокумент = Новый ТабличныйДокумент;
	Макет = Документы.ИсполнениеРасторжениеДоговора.ПолучитьМакет("РасчетОплаченнойСуммы");
	ИтогоДебет = 0;
	ИтогоКредит = 0;
	
	ВыборкаОплат = РаботаСОбязательствами.ПолучитьДанныеСуммыОплатПоОбязательству(Организация, Обязательство);

	ОблВсего = Макет.ПолучитьОбласть("Всего");
	ТабДокумент.Вывести(ОблВсего);
	
	облИтого = Макет.ПолучитьОбласть("Итого");
	ТабДокумент.Вывести(облИтого);
	
	облДокумент = Макет.ПолучитьОбласть("ДокументОплаты");
	Пока ВыборкаОплат.Следующий() Цикл
		
		облДокумент.Параметры.Регистратор = ВыборкаОплат.Регистратор;
		облДокумент.Параметры.ДокументОплаты = ВыборкаОплат.ВидПервичногоДокумента + " от "  + ВыборкаОплат.ДатаПервичногоДокумента + " №" + ВыборкаОплат.НомерПервичногоДокумента;
		облДокумент.Параметры.Дебет = ВыборкаОплат.Дебет;
		облДокумент.Параметры.Кредит = ВыборкаОплат.Кредит; 
		
		ИтогоДебет = ИтогоДебет + ВыборкаОплат.Дебет;
		ИтогоКредит = ИтогоКредит + ВыборкаОплат.Кредит;
		
		ТабДокумент.Вывести(облДокумент);	
		
	КонецЦикла; 
	
	ТабДокумент.Области.ИтогоДебет.Текст = Формат(ИтогоДебет, "ЧДЦ=2; ЧРД=-; ЧН=-; ЧГ=3,0");
	ТабДокумент.Области.ИтогоКредит.Текст = Формат(ИтогоКредит, "ЧДЦ=2; ЧРД=-; ЧН=-; ЧГ=3,0");
	ТабДокумент.Области.ФактическиОплачено.Текст = Формат(ИтогоКредит - ИтогоДебет, "ЧДЦ=2; ЧРД=-; ЧН=-; ЧГ=3,0");
	
	Возврат ТабДокумент;
	
КонецФункции 

