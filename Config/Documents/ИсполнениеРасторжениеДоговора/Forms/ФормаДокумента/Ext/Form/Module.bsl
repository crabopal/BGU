&НаСервере
Процедура  ДоговорПриИзмененииСервер()
	
	Объект.Исполнение.Очистить();
	
	ПризнакИсполнения = РаботаСОбязательствами.ЗначениеХарактеристикиОбязательства(Объект.Договор, Объект.Дата, ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыХарактеристикОбязательства.СтатусИсполненияГК"));
	
	Если ПризнакИсполнения = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДоговоров.НаИсполнении") Или ПризнакИсполнения = Неопределено Тогда
		
		Объект.СтатусИсполненияДоговора = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДоговоров.Завершен");
		
	Иначе
		
		Объект.СтатусИсполненияДоговора = ПризнакИсполнения;
		
	КонецЕсли;
	
	СтатусИсполненияДоговораПриИзмененииСервер();
	
КонецПроцедуры	

&НаСервере
Процедура СтатусИсполненияДоговораПриИзмененииСервер()
	
	Если Объект.СтатусИсполненияДоговора = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДоговоров.Завершен") Тогда
		
		Объект.ЭтоРасторжение = Ложь;
		
	Иначе
		
		Объект.ЭтоРасторжение = Истина;
		
	КонецЕсли;
	
	УстановитьВидимость();
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьДоступностьДоговора()

	Элементы.Договор.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);	

