// Функция возвращает таблицу реквизитов, зависимых от исполнения/расторжения контракта
//
Функция ПолучитьМассивыРеквизитов(ЭтоРасторжение, МассивВсехРеквизитов, МассивРеквизитовОперации) Экспорт
	
	МассивВсехРеквизитов = Новый Массив;
	МассивВсехРеквизитов.Добавить("СуммаОплаты");
	МассивВсехРеквизитов.Добавить("ОснованиеРасторжения");
	МассивВсехРеквизитов.Добавить("НомерРасторжения");
	МассивВсехРеквизитов.Добавить("ДатаРасторжения");
	МассивВсехРеквизитов.Добавить("ПричинаРасторжения");
	
	//ТЧ Исполнение
	МассивВсехРеквизитов.Добавить("Исполнение.ДокументИсполнения");
	МассивВсехРеквизитов.Добавить("Исполнение.ВидПервичногоДокумента");
	МассивВсехРеквизитов.Добавить("Исполнение.ДатаПервичногоДокумента");
	МассивВсехРеквизитов.Добавить("Исполнение.НомерПервичногоДокумента");
	
	МассивРеквизитовОперации = Новый Массив;
	
	Если ЭтоРасторжение Тогда
		
		МассивРеквизитовОперации.Добавить("СуммаОплаты");
		МассивРеквизитовОперации.Добавить("ОснованиеРасторжения");
		МассивРеквизитовОперации.Добавить("НомерРасторжения");
		МассивРеквизитовОперации.Добавить("ДатаРасторжения");
		МассивРеквизитовОперации.Добавить("ПричинаРасторжения");
		
	Иначе
		
		//ТЧ Исполнение
		МассивРеквизитовОперации.Добавить("Исполнение.ДокументИсполнения");
		МассивРеквизитовОперации.Добавить("Исполнение.ВидПервичногоДокумента");
		МассивРеквизитовОперации.Добавить("Исполнение.ДатаПервичногоДокумента");
		МассивРеквизитовОперации.Добавить("Исполнение.НомерПервичногоДокумента");	
		
	КонецЕсли; 
	
КонецФункции


