#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ФайлыДляПечати(РегистрыУчета)
	
	 Запрос = Новый Запрос("ВЫБРАТЬ
	 |	РегистрУчетаПрисоединенныеФайлы.Ссылка КАК Ссылка
	 |ИЗ
	 |	Справочник.РегистрУчетаПрисоединенныеФайлы КАК РегистрУчетаПрисоединенныеФайлы
	 |ГДЕ
	 |	РегистрУчетаПрисоединенныеФайлы.ВладелецФайла В(&МассивВладельцев)");
	 
	 Запрос.УстановитьПараметр("МассивВладельцев", РегистрыУчета);
	 
	 Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции	

&НаСервере
Функция ПолучитьСвойстваПрисоединенногоФайла(ДокументРегистр)
	
	СвойстваПрисоединенногоФайла   = Документы.РегистрУчета.ПолучитьСвойстваПрисоединенногоФайлаРегистра(ДокументРегистр);
	СвойстваПрисоединенногоФайла.Вставить("РегистрУчета", ДокументРегистр);
	СвойстваПрисоединенногоФайла.Вставить("ФайлРегистраУчетаПрисоединен",
		СвойстваПрисоединенногоФайла.ПрисоединенныйФайл <> Справочники.РегистрУчетаПрисоединенныеФайлы.ПустаяСсылка());
	СвойстваПрисоединенногоФайла.Вставить("ДанныеФайла",
		РаботаСФайлами.ДанныеФайла(СвойстваПрисоединенногоФайла.ПрисоединенныйФайл, Новый УникальныйИдентификатор));
	СвойстваПрисоединенногоФайла.Вставить("ИспользоватьЭЦП", ПолучитьФункциональнуюОпцию("ИспользоватьЭлектронныеПодписи"));
	Возврат СвойстваПрисоединенногоФайла;
	
КонецФункции

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РезультатВыбора, "НачалоПериода,КонецПериода");
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "НачалоПериода", НачалоПериода,
		ВидСравненияКомпоновкиДанных.БольшеИлиРавно, , ЗначениеЗаполнено(НачалоПериода));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "КонецПериода", КонецПериода,
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, , ЗначениеЗаполнено(КонецПериода));
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКомандПечати(Результат = Неопределено, ПараметрыВыполнения = Неопределено) Экспорт
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		Элементы.ПечатьСоШтампом.Видимость =
		ТекущиеДанные.ФорматСохраненияФайла = ПредопределенноеЗначение("Перечисление.ФорматыСохраненияОтчетов.MXL")
			И ТекущиеДанные.ПодписанЭП;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьКомандПечати()
	
	УстановитьДоступностьКомандПечати();
	
