
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.Отбор);
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		
		Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
		Если Параметры.Отбор.Свойство("Организация") Тогда
			Параметры.Отбор.Удалить("Организация");
		КонецЕсли;
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", Организация,
		ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(Организация));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ВидРегистра", ВидРегистра,
		ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(ВидРегистра));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "НачалоПериода", НачалоПериода,
		ВидСравненияКомпоновкиДанных.БольшеИлиРавно, , ЗначениеЗаполнено(НачалоПериода));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "КонецПериода", КонецПериода,
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, , ЗначениеЗаполнено(КонецПериода));
		
	Если Параметры.Отбор.Свойство("НачалоПериода") Тогда
		Параметры.Отбор.Удалить("НачалоПериода");
	КонецЕсли;
	Если Параметры.Отбор.Свойство("КонецПериода") Тогда
		Параметры.Отбор.Удалить("КонецПериода");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СписокОрганизация", "Видимость", НЕ ЗначениеЗаполнено(Организация));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СписокВидРегистра", "Видимость", НЕ ЗначениеЗаполнено(ВидРегистра));
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.КомандыФормы;
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "Список");
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.КомандыФормы);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ИнтеграцияС1САрхивом  
	ПараметрыРазмещения = ОбменСАрхивом.ПараметрыРазмещенияЭлементов();
	ПараметрыРазмещения.ИмяСписка = "Список";
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

