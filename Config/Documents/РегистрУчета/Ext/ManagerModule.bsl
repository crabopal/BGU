#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.РегистрУчета";
	КомандаПечати.Идентификатор		= "РегистрУчета";
	КомандаПечати.Представление		= НСтр("ru = 'Регистр учета'");
	КомандаПечати.Порядок			= 1;
	
	УправлениеПечатью.ДобавитьУсловиеВидимостиКоманды(
		КомандаПечати, "РегистрMXL", , ВидСравненияКомпоновкиДанных.Заполнено);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "РегистрУчета") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "РегистрУчета",
			"Регистр учета",
			ПечатьРегистраMXL(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьРегистраMXL(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_РегистрMXL";
	
	ДанныеДокументов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивОбъектов, "РегистрMXL");
	
	Для Каждого ДанныеДокумента Из ДанныеДокументов Цикл
		
		Ссылка = ДанныеДокумента.Ключ;
		РегистрMXL = ДанныеДокумента.Значение;
		
		Если Не ЗначениеЗаполнено(РегистрMXL) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НачалоОбласти = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(РегистрMXL);
		
		ТабличныйДокументРегистра = УправлениеПечатью.ТабличныйДокументПоДвоичнымДанным(ДвоичныеДанные);
		
		// Документ сохраняется с таким же общим именеи области, как и при выводе на печать.
		// Поэтому имя области требуется заменить.
		ОбластиИсходногоДокумента = ТабличныйДокументРегистра.Области;
		ОбластьДокументИсходный1 = ОбластиИсходногоДокумента.Найти("Документ_1");
		Если ОбластьДокументИсходный1 <> Неопределено Тогда
			ОбластьДокументИсходный1.Имя = "ДокументИсходный_1";
			
			// Дополнительная проверка для случая нескольких документов в одном регистре учета.
			ОбластьДокументИсходный2 = ОбластиИсходногоДокумента.Найти("Документ_2");
			Если ОбластьДокументИсходный2 <> Неопределено Тогда
				ОбластьДокументИсходный2.Имя = "ДокументИсходный_2";
				
				ИменаДляЗамены = Новый Массив;
				Для Каждого ОбластьТабДок Из ОбластиИсходногоДокумента Цикл
					Если СтрНайти(ОбластьТабДок.Имя, "Документ_") <> 0 Тогда
						ИменаДляЗамены.Добавить(ОбластьТабДок.Имя);
					КонецЕсли;
				КонецЦикла;
				
				Для Каждого ИмяДляЗамены Из ИменаДляЗамены Цикл
					ОбластьДляЗамены = ОбластиИсходногоДокумента.Найти(ИмяДляЗамены);
					ОбластьДляЗамены.Имя = СтрЗаменить(ИмяДляЗамены, "Документ_", "ДокументИсходный_");
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ТабличныйДокументРегистра);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НачалоОбласти, ОбъектыПечати, Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции 

#КонецОбласти

#Область СлужебныеПроцедурыИфункции	

Функция ПолучитьОписаниеРегистра(СвойстваРегистра) Экспорт
	
	ОписаниеРегистра = "";
	
	ВидРегистраРег 		= Неопределено;
	ОрганизацияРег 		= Неопределено;
	ДополнениеИмени 	= Неопределено;
	НачалоПериодаРег 	= Неопределено;
	КонецПериодаРег 	= Неопределено;
	
	Если СвойстваРегистра.Свойство("ФорматНаименования") Тогда
		
		ОписаниеРегистра = СвойстваРегистра.ФорматНаименования;
		
		Для Каждого Параметр Из СтрРазделить(ОписаниеРегистра, " ") Цикл
			Если Лев(Параметр, 1) = "%" Тогда
				ПозицияТочки = СтрНайти(Параметр, ".");
				Если ПозицияТочки = 0 Тогда
					Замена = СвойстваРегистра[Сред(Параметр, 2)];
				Иначе
					Замена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
						СвойстваРегистра[Сред(Параметр, 2, ПозицияТочки-2)], Сред(Параметр, ПозицияТочки+1));
				КонецЕсли;
				ОписаниеРегистра = СтрЗаменить(ОписаниеРегистра, Параметр, Строка(Замена));
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли СвойстваРегистра.Свойство("ВидРегистра", ВидРегистраРег) Тогда
		ОписаниеРегистра = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СвойстваРегистра.ВидРегистра, "Наименование");
		Если СвойстваРегистра.Свойство("ДополнениеИмени", ДополнениеИмени) Тогда
			ОписаниеРегистра = ОписаниеРегистра + СвойстваРегистра.ДополнениеИмени;
		КонецЕсли;
		Если НЕ СвойстваРегистра.Свойство("НеДополнятьИмяАвтоматически") Тогда
			Если СвойстваРегистра.Свойство("НачалоПериода", НачалоПериодаРег) И СвойстваРегистра.Свойство("КонецПериода", КонецПериодаРег) Тогда
				Если ТипЗнч(НачалоПериодаРег) = Тип("СтандартнаяДатаНачала") Тогда
					НачалоПериодаРег = НачалоПериодаРег.Дата;
				КонецЕсли;
				Если ТипЗнч(КонецПериодаРег) = Тип("СтандартнаяДатаНачала") Тогда
					КонецПериодаРег = КонецПериодаРег.Дата;
				КонецЕсли;
				ОписаниеРегистра = ОписаниеРегистра + СтандартныеОтчетыКлиентСервер.ПолучитьПредставлениеПериода(НачалоПериодаРег, КонецПериодаРег);
			КонецЕсли;
			Если СвойстваРегистра.Свойство("Организация", ОрганизацияРег) Тогда
				ОписаниеРегистра = ОписаниеРегистра + " " + 
				СтандартныеОтчетыПовтИсп.ПолучитьТекстОрганизация(ОрганизацияРег,
				?(СвойстваРегистра.Свойство("ВключатьОбособленныеПодразделения"), СвойстваРегистра.ВключатьОбособленныеПодразделения, Ложь));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОписаниеРегистра;
	
КонецФункции

Функция ПолучитьФорматСохраненияРегистров() Экспорт
	
	ФорматРегистра = Константы.ФорматСохраненияРегистровУчета.Получить();
	Возврат ?(ЗначениеЗаполнено(ФорматРегистра), ФорматРегистра, Перечисления.ФорматыСохраненияОтчетов.PDF);
	
КонецФункции

Функция ПолучитьСвойстваПрисоединенногоФайлаРегистра(РегистрУчета, ПолучитьДанныеФайла = Ложь) Экспорт
	
	СвойстваФайла = Новый Структура("ПрисоединенныйФайл, ПодписанЭП, ФайлРегистраУчетаПрисоединен");
	
	СвойстваФайла.ПрисоединенныйФайл 	= Справочники.РегистрУчетаПрисоединенныеФайлы.ПустаяСсылка();
	СвойстваФайла.ПодписанЭП 			= Ложь;
	СвойстваФайла.ФайлРегистраУчетаПрисоединен = Ложь;
	
	Если НЕ ЗначениеЗаполнено(РегистрУчета) Тогда
		Возврат СвойстваФайла;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.Параметры.Вставить("РегистрУчета", РегистрУчета);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РегистрУчетаПрисоединенныеФайлы.Ссылка КАК ПрисоединенныйФайл,
	|	РегистрУчетаПрисоединенныеФайлы.ПодписанЭП КАК ПодписанЭП
	|ИЗ
	|	Справочник.РегистрУчетаПрисоединенныеФайлы КАК РегистрУчетаПрисоединенныеФайлы
	|ГДЕ
	|	(РегистрУчетаПрисоединенныеФайлы.Ссылка = &РегистрУчета
	|			ИЛИ РегистрУчетаПрисоединенныеФайлы.ВладелецФайла = &РегистрУчета)
	|	И  НЕ РегистрУчетаПрисоединенныеФайлы.Служебный";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(СвойстваФайла, Выборка);
		
		СвойстваФайла.ФайлРегистраУчетаПрисоединен = Истина;
		
		Если ПолучитьДанныеФайла Тогда
			СвойстваФайла.Вставить("ДанныеФайла",
				РаботаСФайлами.ДанныеФайла(Выборка.ПрисоединенныйФайл,
				Новый Структура("ИдентификаторФормы", Новый УникальныйИдентификатор)));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СвойстваФайла;
	
КонецФункции

Функция ПолучитьПечатнуюФормуТекущегоДокумента(ТекДокумент) Экспорт
	
	МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипЗнч(ТекДокумент));
	ИмяМетаданных = МетаданныеДокумента.Имя;
	
	МассивОбъектов = Новый Массив();
	МассивОбъектов.Добавить(ТекДокумент);
	ПараметрыПечати = Новый Структура(); 
	ДопустимыеТипыОбъектовПечати = Неопределено;
	
	Если ИмяМетаданных = "РегистрУчета" Тогда
		ИмяМенеджераПечати = "Документ.РегистрУчета";
		ИменаМакетов = "РегистрУчета";
	Иначе
		Сообщить("Документ не является документами типа ""РегистрУчета""!");
		Возврат Неопределено;
	КонецЕсли;
	
	ПечатныеФормы = УправлениеПечатью.СформироватьПечатныеФормы(ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати, ДопустимыеТипыОбъектовПечати);
	
	Возврат ПечатныеФормы.КоллекцияПечатныхФорм[0].ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#КонецЕсли