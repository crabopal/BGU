&НаКлиенте
Перем СобытиеИзменениеФлага;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВнутреннийЭДОПереопределяемый.ПриСозданииФормыСпискаВнутреннихЭлектронныхДокументов(ЭтотОбъект);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Состояние",
		,,, Ложь, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	ОграничитьСписокДокументов = НЕ Пользователи.РолиДоступны(
		"ДобавлениеИзменениеВнутреннихЭлектронныхДокументов,ЧтениеВнутреннихЭлектронныхДокументов",
		ТекущийПользователь);
		
	Если Параметры.ПоказыватьТолькоПодписанныеЭДПодписанта Тогда
		ПоказыватьТолькоПодписанныеЭД = Истина; 
		Заголовок = "Архив подписанных внутренних электронных документов";
	КонецЕсли;	
		
	Если ОграничитьСписокДокументов Тогда
		Заголовок = Заголовок + " " + НСтр("ru = '(по пользователю)'");
		
		ОтборПодписантИспользовать = Истина;
		ОтборПодписант = ТекущийПользователь;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтборПодписантИспользовать", "ТолькоПросмотр", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтборПодписант", "ТолькоПросмотр", Истина);
		
	Иначе
		
		ОтборПодписантИспользовать = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
			"ОтборПодписантИспользовать_АрхивВнутреннихДокументов", "", Ложь);
		ОтборПодписант = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
			"ОтборПодписант_АрхивВнутреннихДокументов", "");
		
	КонецЕсли;
	
	ПриИзмененииОтбораПоПодписанту();
	
	СтарыйКомпоновщикНастроекКД.ЗагрузитьПользовательскиеНастройки(Список.КомпоновщикНастроек.ПользовательскиеНастройки);
	
	ЗаполнитьСписокВыбораТиповУчетныхДокументов();
	
	ОтборТипУчетногоДокументаИспользовать = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"ОтборТипУчетногоДокументаИспользовать_АрхивВнутреннихДокументов", "", Ложь);
	ОтборТипУчетногоДокумента = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"ОтборТипУчетногоДокумента_АрхивВнутреннихДокументов", "");
	
	ПриИзмененииОтбораПоТипуУчетногоДокумента();
	
	УстановитьВидимостьЭлементовНаСервере();
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ВыбранныеДокументы", ВыбранныеДокументы);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборТипУчетногоДокументаИспользоватьПриИзменении(Элемент)
	
	ПриИзмененииОтбораПоТипуУчетногоДокумента();
	
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить(
		"ОтборТипУчетногоДокументаИспользовать_АрхивВнутреннихДокументов", "", ОтборТипУчетногоДокументаИспользовать);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборТипУчетногоДокументаПриИзменении(Элемент)
	
	ОтборТипУчетногоДокументаИспользовать = ЗначениеЗаполнено(ОтборТипУчетногоДокумента);
	
	ПриИзмененииОтбораПоТипуУчетногоДокумента();
	
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить(
		"ОтборТипУчетногоДокументаИспользовать_АрхивВнутреннихДокументов", "", ОтборТипУчетногоДокументаИспользовать);
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить(
		"ОтборТипУчетногоДокумента_АрхивВнутреннихДокументов", "", ОтборТипУчетногоДокумента);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПодписантИспользоватьПриИзменении(Элемент)
	
	ПриИзмененииОтбораПоПодписанту();
	
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить(
		"ОтборПодписантИспользовать_АрхивВнутреннихДокументов", "", ОтборПодписантИспользовать);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПодписантПриИзменении(Элемент)
	
	ОтборПодписантИспользовать = ЗначениеЗаполнено(ОтборПодписант);
	
	ПриИзмененииОтбораПоПодписанту();
	
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить(
		"ОтборПодписантИспользовать_АрхивВнутреннихДокументов", "", ОтборПодписантИспользовать);
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить(
		"ОтборПодписант_АрхивВнутреннихДокументов", "", ОтборПодписант);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.Флаг Тогда
		
		СобытиеИзменениеФлага = Истина;
		
		Для Каждого ДокументСсылка Из Элементы.Список.ВыделенныеСтроки Цикл
			ИзменитьПометкуДокумента(ДокументСсылка, НЕ ТекущиеДанные.Флаг);
		КонецЦикла;
		
		ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
		
	Иначе
		
		ВнутреннийЭДОКлиент.ОткрытьЭлектронныйДокумент(ТекущиеДанные.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	Если СобытиеИзменениеФлага = Истина Тогда
		СобытиеИзменениеФлага = Ложь;
		Возврат;
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("Подключаемый_ОбновитьПользовательскиеНастройкиКД");
	ПодключитьОбработчикОжидания("Подключаемый_ОбновитьПользовательскиеНастройкиКД", 0.1, Истина);
	
КонецПроцедуры

&НаСервере
Процедура СписокПриСохраненииПользовательскихНастроекНаСервере(Элемент, Настройки)
	
	ОбновитьПользовательскиеНастройкиКДНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьФлажкиДокументов(Команда)
	
	СобытиеИзменениеФлага = Истина;
	
	ЭлектронныеДокументы = ЭлектронныеДокументыСписка();
	ВыбранныеДокументы.ЗагрузитьЗначения(ЭлектронныеДокументы);
	ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажкиДокументов(Команда)
	
	СобытиеИзменениеФлага = Истина;
	
	ВыбранныеДокументы.Очистить();
	ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиВыделенным(Команда)
	
	Для Каждого ДокументСсылка Из Элементы.Список.ВыделенныеСтроки Цикл
		СобытиеИзменениеФлага = Истина;
		ИзменитьПометкуДокумента(ДокументСсылка, Истина);
	КонецЦикла;
	
	ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьДокументов(Команда)
	
	Если ВыбранныеДокументы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать хотя бы один документ.'"));
		Возврат;
	КонецЕсли;
	
	ПечатныеФормы = СформироватьПечатныеФормы();
	Если ПечатныеФормы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не сформировано печатных форм для данного состава'"));
		Возврат;
	КонецЕсли;
	
	Идентификаторы = Новый Массив;
	Для Каждого ПечатнаяФорма Из ПечатныеФормы Цикл
		Идентификаторы.Добавить(ПечатнаяФорма.ИмяМакета);
	КонецЦикла;
	
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм(Идентификаторы);
	
	Для Каждого ПечатнаяФорма Из ПечатныеФормы Цикл
		ОписаниеПечатнойФормы = УправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, ПечатнаяФорма.ИмяМакета);
		ОписаниеПечатнойФормы.ТабличныйДокумент = ПечатнаяФорма.ТабличныйДокумент;
		ОписаниеПечатнойФормы.СинонимМакета = ПечатнаяФорма.СинонимМакета;
	КонецЦикла;
	
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьРеестра(Команда)
	
	Если ВыбранныеДокументы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать хотя бы один документ.'"));
		Возврат;
	КонецЕсли;
	
	ПечатнаяФорма = СформироватьРеестрЭлектронныхДокументов();
	
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм(ПечатнаяФорма.ИмяМакета);
	
	ОписаниеПечатнойФормы = УправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, ПечатнаяФорма.ИмяМакета);
	ОписаниеПечатнойФормы.ТабличныйДокумент = ПечатнаяФорма.ТабличныйДокумент;
	ОписаниеПечатнойФормы.СинонимМакета = ПечатнаяФорма.СинонимМакета;
	
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм);
	
КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)
	
	Если ВыбранныеДокументы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать хотя бы один документ.'"));
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуВыгрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура Сравнить(Команда)
	
	Если ВыбранныеДокументы.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать хотя бы один документ.'"));
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуСравнения();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьФормулярыВФорматеPDF(Команда)

	ОткрытьФорму("Документ.ВнутреннийЭлектронныйДокумент.Форма.ФормированиеФормуляровPDF",,ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПодписатьФормулярыВФорматеPDF(Команда)

	ОткрытьФорму("Документ.ВнутреннийЭлектронныйДокумент.Форма.ПодписаниеФормуляровPDF",,ЭтотОбъект);
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИзменитьПометкуДокумента(Документ, НоваяПометка)
	
	НайденныйИндекс = ВыбранныеДокументы.НайтиПоЗначению(Документ);
	Если НайденныйИндекс = Неопределено И НоваяПометка = Истина Тогда
		ВыбранныеДокументы.Добавить(Документ);
	ИначеЕсли НайденныйИндекс <> Неопределено И НоваяПометка = Ложь Тогда
		ВыбранныеДокументы.Удалить(НайденныйИндекс);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьОтображениеВыбранныхДокументов(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.Список, "ВыбранныеДокументы", Форма.ВыбранныеДокументы);
	
	ШаблонЗаголовка = НСтр("ru = 'Выбрано: %1'");
	Форма.Элементы.ДекорацияВыбранныеДокументы.Заголовок = СтрШаблон(ШаблонЗаголовка, Форма.ВыбранныеДокументы.Количество());
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьПользовательскиеНастройкиКД()
	
	ОбновитьПользовательскиеНастройкиКД();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПользовательскиеНастройкиКД()
	
	Если ИзменилисьПользовательскиеНастройки(ЭтотОбъект) Тогда
		СтарыйКомпоновщикНастроекКД.ЗагрузитьПользовательскиеНастройки(Список.КомпоновщикНастроек.ПользовательскиеНастройки);
		Если АктуализироватьВыбранныеДокументы() Тогда
			ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПользовательскиеНастройкиКДНаСервере()
	
	Если ИзменилисьПользовательскиеНастройки(ЭтотОбъект) Тогда
		СтарыйКомпоновщикНастроекКД.ЗагрузитьПользовательскиеНастройки(Список.КомпоновщикНастроек.ПользовательскиеНастройки);
		Если АктуализироватьВыбранныеДокументы() Тогда
			ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция АктуализироватьВыбранныеДокументы()
	
	ВыбранныеДокументы = ВыбранныеДокументы;
	
	Если ВыбранныеДокументы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОписаниеОтбора = Новый Структура;
	ОписаниеОтбора.Вставить("ЛевоеЗначение", Новый ПолеКомпоновкиДанных("Ссылка"));
	ОписаниеОтбора.Вставить("ВидСравнения", ВидСравненияКомпоновкиДанных.ВСписке);
	ОписаниеОтбора.Вставить("ПравоеЗначение", ВыбранныеДокументы.ВыгрузитьЗначения());
	Отборы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОписаниеОтбора);
	
	АктуальныеВыбранныеДокументы = ЭлектронныеДокументыСписка(Отборы);
	
	Если ВыбранныеДокументы.Количество() <> АктуальныеВыбранныеДокументы.Количество() Тогда
		ВыбранныеДокументы.ЗагрузитьЗначения(АктуальныеВыбранныеДокументы);
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ЭлектронныеДокументыСписка(Знач Отборы = Неопределено)
	
	СписокДанных = Элементы["Список"];
	
	Настройки = СписокДанных.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	ВыбранныеПоля = Настройки.Структура[0].Выбор.Элементы;
	ВыбранныеПоля.Очистить();
	
	ВыбранноеПоле = ВыбранныеПоля.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("Ссылка");
	
	Если Отборы <> Неопределено Тогда
		Для Каждого ОписаниеОтбора Из Отборы Цикл
			НовыйОтбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовыйОтбор, ОписаниеОтбора);
		КонецЦикла;
	КонецЕсли;
	
	Схема = СписокДанных.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	ТипГенератораМакета = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки,,, ТипГенератораМакета);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Возврат Результат.ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИзменилисьПользовательскиеНастройки(Форма)
	
	НастройкиИзменены = Ложь;
	
	НовыеПользовательскиеНастройкиЭлементы = Форма.Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;
	СтарыеПользовательскиеНастройкиЭлементы = Форма.СтарыйКомпоновщикНастроекКД.ПользовательскиеНастройки.Элементы;
	
	Если НовыеПользовательскиеНастройкиЭлементы.Количество() <> СтарыеПользовательскиеНастройкиЭлементы.Количество() Тогда
		НастройкиИзменены = Истина;
	КонецЕсли;
	
	Если Не НастройкиИзменены Тогда
		Для Каждого НоваяНастройка Из НовыеПользовательскиеНастройкиЭлементы Цикл
			СтараяНастройка = СтарыеПользовательскиеНастройкиЭлементы.Найти(НоваяНастройка.ИдентификаторПользовательскойНастройки);
			Если СтараяНастройка = Неопределено Тогда
				НастройкиИзменены = Истина;
				Прервать;
			ИначеЕсли ТипЗнч(СтараяНастройка) = Тип("ЭлементОтбораКомпоновкиДанных")
				И (СтараяНастройка.Использование <> НоваяНастройка.Использование
					ИЛИ СтараяНастройка.ВидСравнения <> НоваяНастройка.ВидСравнения
					ИЛИ СтараяНастройка.ПравоеЗначение <> НоваяНастройка.ПравоеЗначение) Тогда
				НастройкиИзменены = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Не НастройкиИзменены Тогда
		Для Каждого СтараяНастройка Из СтарыеПользовательскиеНастройкиЭлементы Цикл
			НоваяНастройка = НовыеПользовательскиеНастройкиЭлементы.Найти(СтараяНастройка.ИдентификаторПользовательскойНастройки);
			Если НоваяНастройка = Неопределено Тогда
				НастройкиИзменены = Истина;
				Прервать;
			ИначеЕсли ТипЗнч(СтараяНастройка) = Тип("ЭлементОтбораКомпоновкиДанных")
				И (СтараяНастройка.Использование <> НоваяНастройка.Использование
					ИЛИ СтараяНастройка.ВидСравнения <> НоваяНастройка.ВидСравнения
					ИЛИ СтараяНастройка.ПравоеЗначение <> НоваяНастройка.ПравоеЗначение) Тогда
				НастройкиИзменены = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат НастройкиИзменены;
	
КонецФункции

&НаСервере
Функция СформироватьПечатныеФормы()
	
	Возврат ВнутреннийЭДО.СформироватьПечатныеФормыЭлектронныхДокументов(ВыбранныеДокументы.ВыгрузитьЗначения());
	
КонецФункции

&НаСервере
Функция СформироватьРеестрЭлектронныхДокументов()
	
	Возврат ВнутреннийЭДО.СформироватьРеестрЭлектронныхДокументов(ВыбранныеДокументы.ВыгрузитьЗначения());
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуВыгрузки()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДокументыДляВыгрузки", ВыбранныеДокументы.ВыгрузитьЗначения());
	
	ОткрытьФорму("Документ.ВнутреннийЭлектронныйДокумент.Форма.ВыгрузкаДанных", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуСравнения()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДокументыДляСравнения", ВыбранныеДокументы.ВыгрузитьЗначения());
	
	ОткрытьФорму("Документ.ВнутреннийЭлектронныйДокумент.Форма.СравнениеДанных", 
		ПараметрыФормы, 
		ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораТиповУчетныхДокументов()
	
	Элементы.ОтборТипУчетногоДокумента.СписокВыбора.ЗагрузитьЗначения(
		Метаданные.ОпределяемыеТипы.ОснованиеВнутреннегоЭлектронногоДокумента.Тип.Типы());
	Элементы.ОтборТипУчетногоДокумента.СписокВыбора.СортироватьПоЗначению();
	
	Если Элементы.ОтборТипУчетногоДокумента.СписокВыбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПервыйТип = Элементы.ОтборТипУчетногоДокумента.СписокВыбора[0].Значение;
	
	Пока Истина Цикл
		ТипУчетногоДокумента = Элементы.ОтборТипУчетногоДокумента.СписокВыбора[0];
		Если Лев(ТипУчетногоДокумента.Значение, 9) <> "(устарел)" Тогда
			Прервать;
		КонецЕсли;
		Элементы.ОтборТипУчетногоДокумента.СписокВыбора.Сдвинуть(
			0, Элементы.ОтборТипУчетногоДокумента.СписокВыбора.Количество()-1);
		Если Элементы.ОтборТипУчетногоДокумента.СписокВыбора[0].Значение = ПервыйТип Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииОтбораПоТипуУчетногоДокумента()
	
	Если ОтборТипУчетногоДокументаИспользовать И НЕ ЗначениеЗаполнено(ОтборТипУчетногоДокумента) Тогда
		ОтборТипУчетногоДокумента = Тип("Неопределено");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ТипУчетногоДокумента",
		ОтборТипУчетногоДокумента,,, ОтборТипУчетногоДокументаИспользовать,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииОтбораПоПодписанту()
	
	Если ПоказыватьТолькоПодписанныеЭД Тогда
		ТекстУсловияЗапроса = "
				|ГДЕ
				|	ДокументВнутреннийЭлектронныйДокумент.Ссылка В
				|		(ВЫБРАТЬ
				|			Состав.ЭлектронныйДокумент
				|		ИЗ РегистрСведений.СоставМаршрутаЭлектронногоДокумента КАК Состав
				|		ГДЕ Состав.Группа = """" И Состав.Подписант = &Подписант
				|		И Состав.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументовВнутреннегоЭДО.Завершен))";
    Иначе
		ТекстУсловияЗапроса = "
				|ГДЕ
				|	ДокументВнутреннийЭлектронныйДокумент.Ссылка В
				|		(ВЫБРАТЬ
				|			Состав.ЭлектронныйДокумент
				|		ИЗ РегистрСведений.СоставМаршрутаЭлектронногоДокумента КАК Состав
				|		ГДЕ Состав.Группа = """" И Состав.Подписант = &Подписант)";
		
	КонецЕсли; 
	
	ДополнительноеУсловиеЗапроса = ТекстУсловияЗапроса;
	ПозицияУсловия = СтрНайти(Список.ТекстЗапроса, ДополнительноеУсловиеЗапроса);
	
	Если ОтборПодписантИспользовать Тогда
		Если ПозицияУсловия = 0 Тогда
			СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
			СвойстваСписка.ТекстЗапроса = Список.ТекстЗапроса + ДополнительноеУсловиеЗапроса;
			ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.Список, СвойстваСписка);
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Подписант", ОтборПодписант);
	Иначе
		Если ПозицияУсловия > 0 Тогда
			СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
			СвойстваСписка.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса, ДополнительноеУсловиеЗапроса, "");
			ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.Список, СвойстваСписка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВидимостьДействийАдминистратора()
	Результат = Ложь;

	ТекущийПользователь = Пользователи.ТекущийПользователь();

	ПравоНаИзмененияНастроекВнутреннегоЭДО  = ПравоДоступа("Изменение", Метаданные.НайтиПоПолномуИмени("РегистрСведений.НастройкиВнутреннегоЭДОБГУ"), ТекущийПользователь) ;
	
	Если ПравоНаИзмененияНастроекВнутреннегоЭДО
		ИЛИ Пользователи.ЭтоПолноправныйПользователь(ТекущийПользователь) Тогда
		Результат = Истина;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура УстановитьВидимостьЭлементовНаСервере()
	
	ВидимостьДействийАдминистратора = ВидимостьДействийАдминистратора();

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаФормулярыPDF", "Видимость", ВидимостьДействийАдминистратора);
	
КонецПроцедуры


