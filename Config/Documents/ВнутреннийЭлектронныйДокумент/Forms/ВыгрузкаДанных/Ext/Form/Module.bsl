
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выгрузить(Команда)
	
	Если ДанныеВыгрузки = 0 Тогда
		ФайлВыгрузки = ФайлВыгрузкиДокументов();
	ИначеЕсли ДанныеВыгрузки = 1 Тогда
		ФайлВыгрузки = ФайлВыгрузкиДокументовИПодписей();
	ИначеЕсли ДанныеВыгрузки = 2 Тогда
		ФайлВыгрузки = ФайлВыгрузкиДокументовPDF();
	ИначеЕсли ДанныеВыгрузки = 3 Тогда
		ФайлВыгрузки = ФайлВыгрузкиДокументовПодписейИPDF();
	Иначе
		ВызватьИсключение "Недопустимое значение переключателя";
	КонецЕсли;
	
	ПродолжитьВыгрузку(ФайлВыгрузки);
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ФайлВыгрузкиДокументов()
	
	ДокументыДляВыгрузки = Параметры.ДокументыДляВыгрузки;
	
	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДокументыДляВыгрузки, "ОсновнойФайл, ОсновнойФайлPDF, УчетныйДокумент");
	
	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанных.ВызыватьИсключение = Ложь;
	
	ИмяВременногоКаталога = ФайловаяСистема.СоздатьВременныйКаталог();
	
	ИмяАрхива = СтрШаблон(НСтр("ru = 'Выгрузка от %1'"), Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy;")) + ".zip";
	
	ЗаписьZipФайла = Новый ЗаписьZipФайла();
	
	Для Каждого Документ Из ДокументыДляВыгрузки Цикл
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(РеквизитыДокументов[Документ].ОсновнойФайл, ПараметрыДанных);
		
		ОсновнойФайлPDF = РеквизитыДокументов[Документ].ОсновнойФайлPDF;
		ДанныеФайлаPDF = Неопределено;
		Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
			ДанныеФайлаPDF = РаботаСФайлами.ДанныеФайла(ОсновнойФайлPDF, ПараметрыДанных);
		КонецЕсли;
		
		ИмяФайлаБезРасширения = Сред(ДанныеФайла.ИмяФайла, 1, СтрДлина(ДанныеФайла.ИмяФайла) - 4);
		
		Если ВыгружатьПрисоединеныеФайлы Тогда
			// Если выгружаются присоединенные файлы, для каждого документа создается отдельный каталог, 
			// для помещения в него всех связанных с документом файлов.
			ИмяПодкаталога = ИмяВременногоКаталога + ИмяФайлаБезРасширения;
			ИмяПодкаталога = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяПодкаталога, Истина) + ПолучитьРазделительПути();
			ПолноеИмяФайла = ИмяПодкаталога + ДанныеФайла.ИмяФайла;
		Иначе
			ИмяПодкаталога = ИмяВременногоКаталога;
			ПолноеИмяФайла = ИмяПодкаталога + ДанныеФайла.ИмяФайла;
			ПолноеИмяФайла = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ПолноеИмяФайла);
		КонецЕсли;
		
		ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		
		Если ДвоичныеДанныеФайла = Неопределено Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Документ %1 не был выгружен. Возможно, он помечен на удаление'"), Документ);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		ДвоичныеДанныеФайла.Записать(ПолноеИмяФайла);
		
		Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
			ДвоичныеДанныеФайлаPDF = ПолучитьИзВременногоХранилища(ДанныеФайлаPDF.СсылкаНаДвоичныеДанныеФайла);
			Если НЕ ДвоичныеДанныеФайла = Неопределено Тогда
				ИмяФайлаPDF = ИмяФайлаБезРасширения+".pdf";
				
				ПолноеИмяФайлаPDF = ИмяПодкаталога + ИмяФайлаPDF;
				ПолноеИмяФайлаPDF = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ПолноеИмяФайлаPDF);
				ДвоичныеДанныеФайлаPDF.Записать(ПолноеИмяФайлаPDF);
			КонецЕсли;
		КонецЕсли;
		
		Если ВыгружатьПрисоединеныеФайлы Тогда
			ВыгрузитьПрисоединенныеФайлы(РеквизитыДокументов[Документ].УчетныйДокумент, ИмяПодкаталога);
		
			ЗаписьZipФайла.Добавить(ИмяПодкаталога,
				РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
				РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
		Иначе
			ЗаписьZipФайла.Добавить(ПолноеИмяФайла);
			ЗаписьZipФайла.Добавить(ПолноеИмяФайлаPDF);
		КонецЕсли;
		
	КонецЦикла;
	
	ДвоичныеДанные = ЗаписьZipФайла.ПолучитьДвоичныеДанные();
	
	ФайловаяСистема.УдалитьВременныйКаталог(ИмяВременногоКаталога);
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФайла", ИмяАрхива);
	Результат.Вставить("АдресФайла", ПоместитьВоВременноеХранилище(ДвоичныеДанные));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ФайлВыгрузкиДокументовИПодписей()
	
	ДокументыДляВыгрузки = Параметры.ДокументыДляВыгрузки;
	
	ПерсональныеНастройки = ЭлектроннаяПодпись.ПерсональныеНастройки();
	СохранятьСертификатВместеСПодписью = ПерсональныеНастройки.СохранятьСертификатВместеСПодписью;
	
	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДокументыДляВыгрузки, "ОсновнойФайл, ОсновнойФайлPDF, УчетныйДокумент");
	
	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанных.ВызыватьИсключение = Ложь;
	
	ИмяВременногоКаталога = ФайловаяСистема.СоздатьВременныйКаталог();
	
	ИмяАрхива = СтрШаблон(НСтр("ru = 'Выгрузка от %1'"), Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy;")) + ".zip";
	
	ЗаписьZipФайла = Новый ЗаписьZipФайла();
	
	Для Каждого Документ Из ДокументыДляВыгрузки Цикл
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(РеквизитыДокументов[Документ].ОсновнойФайл, ПараметрыДанных);

		ОсновнойФайлPDF = РеквизитыДокументов[Документ].ОсновнойФайлPDF;
		ДанныеФайлаPDF = Неопределено;
		Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
			ДанныеФайлаPDF = РаботаСФайлами.ДанныеФайла(ОсновнойФайлPDF, ПараметрыДанных);
		КонецЕсли;
		
		ИмяФайлаБезРасширения = Сред(ДанныеФайла.ИмяФайла, 1, СтрДлина(ДанныеФайла.ИмяФайла) - 4);
		
		ИмяПодкаталога = ИмяВременногоКаталога + ИмяФайлаБезРасширения;
		ИмяПодкаталога = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяПодкаталога, Истина) + ПолучитьРазделительПути();
		
		ИмяПодкаталогаMXL = ИмяПодкаталога + "Формуляр в формате MXL\";
		ИмяПодкаталогаPDF = ИмяПодкаталога + "Формуляр в формате PDF\";
		
		ПолноеИмяФайла = ИмяПодкаталогаMXL + ДанныеФайла.ИмяФайла;
		
		ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		
		Если ДвоичныеДанныеФайла = Неопределено Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Документ %1 не был выгружен. Возможно, он помечен на удаление'"), Документ);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		ДвоичныеДанныеФайла.Записать(ПолноеИмяФайла);
		
		Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
			ДвоичныеДанныеФайлаPDF = ПолучитьИзВременногоХранилища(ДанныеФайлаPDF.СсылкаНаДвоичныеДанныеФайла);
			Если НЕ ДвоичныеДанныеФайла = Неопределено Тогда
				ИмяФайлаPDF = ИмяФайлаБезРасширения+".pdf";
				
				ПолноеИмяФайлаPDF = ИмяПодкаталогаPDF + ИмяФайлаPDF;
				ПолноеИмяФайлаPDF = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ПолноеИмяФайлаPDF);
				ДвоичныеДанныеФайлаPDF.Записать(ПолноеИмяФайлаPDF);
			КонецЕсли;
		КонецЕсли;
		
		ЭлектронныеПодписи = ВнутреннийЭДО.УстановленныеПодписи(РеквизитыДокументов[Документ].ОсновнойФайл);
		Для Каждого ЭлектроннаяПодписьФайла Из ЭлектронныеПодписи Цикл
			Если ЭлектроннаяПодписьФайла.ПростаяПодпись = Истина Тогда
				Продолжить;
			КонецЕсли;
			ИмяФайлаПодписи = ИмяПодкаталогаMXL + ВнутреннийЭДОКлиентСервер.ИмяФайлаПодписиПоУмолчанию(ЭлектроннаяПодписьФайла, ПерсональныеНастройки);
			ИмяФайлаПодписи = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяФайлаПодписи);
			ЭлектроннаяПодписьФайла.Подпись.Записать(ИмяФайлаПодписи);
			Если СохранятьСертификатВместеСПодписью Тогда
				ИмяФайлаСертификата = ИмяПодкаталогаMXL + ВнутреннийЭДОКлиентСервер.ИмяФайлаСертификатаПоУмолчанию(ЭлектроннаяПодписьФайла, СтрДлина(ИмяПодкаталогаMXL));
				ИмяФайлаСертификата = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяФайлаСертификата);
				ЭлектроннаяПодписьФайла.Сертификат.Записать(ИмяФайлаСертификата);
			КонецЕсли;
		КонецЦикла;
		
		ЭлектронныеПодписиPDF = ВнутреннийЭДО.УстановленныеПодписи(РеквизитыДокументов[Документ].ОсновнойФайлPDF);
		Для Каждого ЭлектроннаяПодписьФайла Из ЭлектронныеПодписиPDF Цикл
			Если ЭлектроннаяПодписьФайла.ПростаяПодпись = Истина Тогда
				Продолжить;
			КонецЕсли;
			ИмяФайлаПодписи = ИмяПодкаталогаPDF + ВнутреннийЭДОКлиентСервер.ИмяФайлаПодписиПоУмолчанию(ЭлектроннаяПодписьФайла, ПерсональныеНастройки);
			ИмяФайлаПодписи = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяФайлаПодписи);
			ЭлектроннаяПодписьФайла.Подпись.Записать(ИмяФайлаПодписи);
			Если СохранятьСертификатВместеСПодписью Тогда
				ИмяФайлаСертификата = ИмяПодкаталогаPDF + ВнутреннийЭДОКлиентСервер.ИмяФайлаСертификатаПоУмолчанию(ЭлектроннаяПодписьФайла, СтрДлина(ИмяПодкаталогаPDF));
				ИмяФайлаСертификата = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяФайлаСертификата);
				ЭлектроннаяПодписьФайла.Сертификат.Записать(ИмяФайлаСертификата);
			КонецЕсли;
		КонецЦикла;
		
		ВыгрузитьПрисоединенныеФайлы(РеквизитыДокументов[Документ].УчетныйДокумент, ИмяПодкаталога);
		
		ЗаписьZipФайла.Добавить(ИмяПодкаталога,
			РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
			РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
		
	КонецЦикла;
	
	ДвоичныеДанные = ЗаписьZipФайла.ПолучитьДвоичныеДанные();
	
	ФайловаяСистема.УдалитьВременныйКаталог(ИмяВременногоКаталога);
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФайла", ИмяАрхива);
	Результат.Вставить("АдресФайла", ПоместитьВоВременноеХранилище(ДвоичныеДанные));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ФайлВыгрузкиДокументовPDF()
	
	ДокументыДляВыгрузки = Параметры.ДокументыДляВыгрузки;
	
	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		ДокументыДляВыгрузки, "ОсновнойФайл, Организация, УчетныйДокумент");
	
	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанных.ВызыватьИсключение = Ложь;
	
	ИмяВременногоКаталога = ФайловаяСистема.СоздатьВременныйКаталог();
	
	ИмяАрхива = СтрШаблон(НСтр("ru = 'Выгрузка от %1'"), Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy;")) + ".zip";
	
	ЗаписьZipФайла = Новый ЗаписьZipФайла();
	
	Для Каждого Документ Из ДокументыДляВыгрузки Цикл
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(РеквизитыДокументов[Документ].ОсновнойФайл, ПараметрыДанных);
		
		ИмяФайлаБезРасширения = Сред(ДанныеФайла.ИмяФайла, 1, СтрДлина(ДанныеФайла.ИмяФайла) - 4);
		
		Если ВыгружатьПрисоединеныеФайлы Тогда
			// Если выгружаются присоединенные файлы, для каждого документа создается отдельный каталог, 
			// для помещения в него всех связанных с документом файлов.
			ИмяПодкаталога = ИмяВременногоКаталога + ИмяФайлаБезРасширения;
			ИмяПодкаталога = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяПодкаталога, Истина) + ПолучитьРазделительПути();
			ПолноеИмяФайла = ИмяПодкаталога + ИмяФайлаБезРасширения + " (копия).pdf";
		Иначе
			ИмяПодкаталога = ИмяВременногоКаталога;
			ПолноеИмяФайла = ИмяПодкаталога + ИмяФайлаБезРасширения + " (копия).pdf";
			ПолноеИмяФайла = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ПолноеИмяФайла);
		КонецЕсли;
		
		ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		
		Если ДвоичныеДанныеФайла = Неопределено Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Документ %1 не был выгружен. Возможно, он помечен на удаление'"), Документ);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		СоздатьКаталог(ИмяПодкаталога); // без предварительного создания каталога не работает метод Записать табличного документа
		
		ЭлектронныеПодписи = ВнутреннийЭДО.УстановленныеПодписи(РеквизитыДокументов[Документ].ОсновнойФайл);
		
		СохраненныйТабличныйДокумент = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанныеФайла);
		СохраненныйТабличныйДокумент.АвтоМасштаб = Истина;
		ВнутреннийЭДО.ДобавитьШтампыЭлектронныхПодписей(
			СохраненныйТабличныйДокумент, ЭлектронныеПодписи, РеквизитыДокументов[Документ].Организация);
		СохраненныйТабличныйДокумент.Записать(ПолноеИмяФайла, ТипФайлаТабличногоДокумента.PDF_A_3);
		
		ВыгрузитьПрисоединенныеФайлы(РеквизитыДокументов[Документ].УчетныйДокумент, ИмяПодкаталога);
		
		Если ВыгружатьПрисоединеныеФайлы Тогда
			ЗаписьZipФайла.Добавить(ИмяПодкаталога,
				РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
				РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
		Иначе
			ЗаписьZipФайла.Добавить(ПолноеИмяФайла);
		КонецЕсли;
		
	КонецЦикла;
	
	ДвоичныеДанные = ЗаписьZipФайла.ПолучитьДвоичныеДанные();
	
	ФайловаяСистема.УдалитьВременныйКаталог(ИмяВременногоКаталога);
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФайла", ИмяАрхива);
	Результат.Вставить("АдресФайла", ПоместитьВоВременноеХранилище(ДвоичныеДанные));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ФайлВыгрузкиДокументовПодписейИPDF()
	
	ДокументыДляВыгрузки = Параметры.ДокументыДляВыгрузки;
	
	ПерсональныеНастройки = ЭлектроннаяПодпись.ПерсональныеНастройки();
	СохранятьСертификатВместеСПодписью = ПерсональныеНастройки.СохранятьСертификатВместеСПодписью;
	
	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		ДокументыДляВыгрузки, "ОсновнойФайл, ОсновнойФайлPDF, Организация, УчетныйДокумент");
	
	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанных.ВызыватьИсключение = Ложь;
	
	ИмяВременногоКаталога = ФайловаяСистема.СоздатьВременныйКаталог();
	
	ИмяАрхива = СтрШаблон(НСтр("ru = 'Выгрузка от %1'"), Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy;")) + ".zip";
	
	ЗаписьZipФайла = Новый ЗаписьZipФайла();
	
	Для Каждого Документ Из ДокументыДляВыгрузки Цикл
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(РеквизитыДокументов[Документ].ОсновнойФайл, ПараметрыДанных);

		ОсновнойФайлPDF = РеквизитыДокументов[Документ].ОсновнойФайлPDF;
		ДанныеФайлаPDF = Неопределено;
		Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
			ДанныеФайлаPDF = РаботаСФайлами.ДанныеФайла(ОсновнойФайлPDF, ПараметрыДанных);
		КонецЕсли;
		
		ИмяФайлаБезРасширения = Сред(ДанныеФайла.ИмяФайла, 1, СтрДлина(ДанныеФайла.ИмяФайла) - 4);
		
		ИмяПодкаталога = ИмяВременногоКаталога + ИмяФайлаБезРасширения;
		ИмяПодкаталога = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяПодкаталога, Истина) + ПолучитьРазделительПути();
		
		ИмяПодкаталогаMXL = ИмяПодкаталога + "Формуляр в формате MXL\";
		ИмяПодкаталогаPDF = ИмяПодкаталога + "Формуляр в формате PDF\";
		
		ПолноеИмяФайлаКопииВPDF = ИмяПодкаталога + Сред(ДанныеФайла.ИмяФайла, 1, СтрДлина(ДанныеФайла.ИмяФайла) - 4) + " (копия).pdf";
		ПолноеИмяФайла = ИмяПодкаталогаMXL + ДанныеФайла.ИмяФайла;
		
		ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		
		Если ДвоичныеДанныеФайла = Неопределено Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Документ %1 не был выгружен. Возможно, он помечен на удаление'"), Документ);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		ДвоичныеДанныеФайла.Записать(ПолноеИмяФайла);
		
		Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
			ДвоичныеДанныеФайлаPDF = ПолучитьИзВременногоХранилища(ДанныеФайлаPDF.СсылкаНаДвоичныеДанныеФайла);
			Если НЕ ДвоичныеДанныеФайла = Неопределено Тогда
				ИмяФайлаPDF = ИмяФайлаБезРасширения+".pdf";
				
				ПолноеИмяФайлаPDF = ИмяПодкаталогаPDF + ИмяФайлаPDF;
				ПолноеИмяФайлаPDF = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ПолноеИмяФайлаPDF);
				ДвоичныеДанныеФайлаPDF.Записать(ПолноеИмяФайлаPDF);
			КонецЕсли;
		КонецЕсли;
		
		ЭлектронныеПодписи = ВнутреннийЭДО.УстановленныеПодписи(РеквизитыДокументов[Документ].ОсновнойФайл);
		Для Каждого ЭлектроннаяПодписьФайла Из ЭлектронныеПодписи Цикл
			Если ЭлектроннаяПодписьФайла.ПростаяПодпись = Истина Тогда
				Продолжить;
			КонецЕсли;
			ИмяФайлаПодписи = ИмяПодкаталогаMXL + ВнутреннийЭДОКлиентСервер.ИмяФайлаПодписиПоУмолчанию(ЭлектроннаяПодписьФайла, ПерсональныеНастройки);
			ИмяФайлаПодписи = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяФайлаПодписи);
			ЭлектроннаяПодписьФайла.Подпись.Записать(ИмяФайлаПодписи);
			Если СохранятьСертификатВместеСПодписью Тогда
				ИмяФайлаСертификата = ИмяПодкаталогаMXL + ВнутреннийЭДОКлиентСервер.ИмяФайлаСертификатаПоУмолчанию(ЭлектроннаяПодписьФайла, СтрДлина(ИмяПодкаталогаMXL));
				ИмяФайлаСертификата = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяФайлаСертификата);
				ЭлектроннаяПодписьФайла.Сертификат.Записать(ИмяФайлаСертификата);
			КонецЕсли;
		КонецЦикла;
		
		ЭлектронныеПодписиPDF = ВнутреннийЭДО.УстановленныеПодписи(РеквизитыДокументов[Документ].ОсновнойФайлPDF);
		Для Каждого ЭлектроннаяПодписьФайла Из ЭлектронныеПодписиPDF Цикл
			Если ЭлектроннаяПодписьФайла.ПростаяПодпись = Истина Тогда
				Продолжить;
			КонецЕсли;
			ИмяФайлаПодписи = ИмяПодкаталогаPDF + ВнутреннийЭДОКлиентСервер.ИмяФайлаПодписиПоУмолчанию(ЭлектроннаяПодписьФайла, ПерсональныеНастройки);
			ИмяФайлаПодписи = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяФайлаПодписи);
			ЭлектроннаяПодписьФайла.Подпись.Записать(ИмяФайлаПодписи);
			Если СохранятьСертификатВместеСПодписью Тогда
				ИмяФайлаСертификата = ИмяПодкаталогаPDF + ВнутреннийЭДОКлиентСервер.ИмяФайлаСертификатаПоУмолчанию(ЭлектроннаяПодписьФайла, СтрДлина(ИмяПодкаталогаPDF));
				ИмяФайлаСертификата = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяФайлаСертификата);
				ЭлектроннаяПодписьФайла.Сертификат.Записать(ИмяФайлаСертификата);
			КонецЕсли;
		КонецЦикла;
		
		СохраненныйТабличныйДокумент = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанныеФайла);
		СохраненныйТабличныйДокумент.АвтоМасштаб = Истина;
		ВнутреннийЭДО.ДобавитьШтампыЭлектронныхПодписей(
			СохраненныйТабличныйДокумент, ЭлектронныеПодписи, РеквизитыДокументов[Документ].Организация);
		СохраненныйТабличныйДокумент.Записать(ПолноеИмяФайлаКопииВPDF, ТипФайлаТабличногоДокумента.PDF_A_3);
		
		ВыгрузитьПрисоединенныеФайлы(РеквизитыДокументов[Документ].УчетныйДокумент, ИмяПодкаталога);
		
		ЗаписьZipФайла.Добавить(ИмяПодкаталога,
			РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
			РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
		
	КонецЦикла;
	
	ДвоичныеДанные = ЗаписьZipФайла.ПолучитьДвоичныеДанные();
	
	ФайловаяСистема.УдалитьВременныйКаталог(ИмяВременногоКаталога);
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФайла", ИмяАрхива);
	Результат.Вставить("АдресФайла", ПоместитьВоВременноеХранилище(ДвоичныеДанные));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ВыгрузитьПрисоединенныеФайлы(Документ, ИмяПодкаталога)
	
	Если НЕ ВыгружатьПрисоединеныеФайлы Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.РегистрУчета") Тогда
		Возврат;
	КонецЕсли;	
	
	ИмяПодкаталогаФайлов = ИмяПодкаталога + "Присоединенные файлы" + ПолучитьРазделительПути();
	
	Файлы = Новый Массив;
	РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(Документ, Файлы);
	Для Каждого Файл Из Файлы Цикл
		Если Файл.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(Файл);
		ПолноеИмяФайла = ИмяПодкаталогаФайлов + ДанныеФайла.ИмяФайла;
		ПолноеИмяФайла = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ПолноеИмяФайла);
		ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		ДвоичныеДанныеФайла.Записать(ПолноеИмяФайла);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыгрузку(ФайлВыгрузки)
	
	Оповещение = Новый ОписаниеОповещения("СохранитьДокументПослеПолученияФайла", ЭтотОбъект, Неопределено);
	
	Фильтр = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Файлы %1 (*.%1)|*.%1|Все файлы (*.*)|*.*'"),
		"zip");
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохранения.Диалог.Фильтр = Фильтр;
	ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Выберите файл для сохранения данных'");
	
	ФайловаяСистемаКлиент.СохранитьФайл(
		Оповещение, ФайлВыгрузки.АдресФайла, ФайлВыгрузки.ИмяФайла, ПараметрыСохранения);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДокументПослеПолученияФайла(ПолученныеФайлы, Контекст) Экспорт
	
	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Документы сохранены в файл:'"), , ПолученныеФайлы[0].Имя);
	
КонецПроцедуры

#КонецОбласти
