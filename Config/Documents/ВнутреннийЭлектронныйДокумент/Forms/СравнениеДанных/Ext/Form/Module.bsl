
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ТипЗнч(Параметры.ДокументыДляСравнения) = Тип ("Массив") Тогда
		Для Каждого ДокументСравнения Из Параметры.ДокументыДляСравнения Цикл
			
			НайденыОтличия = ОбновитьАктуальностьДокумента(ДокументСравнения);
			Если НайденыОтличия Тогда 
				НоваяСтрока = ДокументыСравнения.Добавить();
				НоваяСтрока.ДокументСсылка = ДокументСравнения;
				НоваяСтрока.НайденыОтличия = НайденыОтличия;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ДокументыСравнения.Количество() = 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ОбработкаОповещенияОтличийНеНайдено", ЭтотОбъект);
		ПоказатьПредупреждение(Оповещение, НСтр("ru = 'Отличий в выбранных документах не найдено'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДокументыСравнения

&НаКлиенте
Процедура ДокументыСравненияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДокументыСравнения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.НайденыОтличия Тогда
		ТабличныеДокументы = ТабличныеДокументыДляСравнения(ТекущиеДанные.ДокументСсылка);
		
		ТабличныйДокументЛевый = ТабличныеДокументы.СохраненныйДокумент;
		ТабличныйДокументПравый = ТабличныеДокументы.АктуальныйДокумент;
		
		СравниваемыеДокументы = Новый Структура("Левый, Правый", ТабличныйДокументЛевый, ТабличныйДокументПравый);
		АдресТабличныхДокументов = ПоместитьВоВременноеХранилище(СравниваемыеДокументы, Неопределено);
		
		ПараметрыОткрытияФормы = Новый Структура;
		ПараметрыОткрытияФормы.Вставить("АдресТабличныхДокументов", АдресТабличныхДокументов);
		ПараметрыОткрытияФормы.Вставить("ЗаголовокЛевый", НСтр("ru = 'Сохраненный электронный документ'"));
		ПараметрыОткрытияФормы.Вставить("ЗаголовокПравый", НСтр("ru = 'Текущий электронный документ'"));
		
		ОткрытьФорму("ОбщаяФорма.СравнениеТабличныхДокументов", ПараметрыОткрытияФормы, ЭтотОбъект);
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'По выбранному документу не найдено отличий'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы



#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ОбновитьАктуальностьДокумента(ДокументСравнения)
	
	ТабличныеДокументы = ТабличныеДокументыДляСравнения(ДокументСравнения);
	
	// Если актуальный документ пустой, то считаем, что сохраненный документ актуален
	Если ТабличныеДокументы.АктуальныйДокумент.ВысотаТаблицы = 0 Тогда
		НайденыОтличия = Ложь;
	Иначе
		НайденыОтличия = НЕ ВнутреннийЭДО.ТабличныеДокументыИдентичны(
			ТабличныеДокументы.СохраненныйДокумент, ТабличныеДокументы.АктуальныйДокумент);
	КонецЕсли;
		
	Возврат НайденыОтличия;
	
КонецФункции

&НаСервере
Функция ТабличныеДокументыДляСравнения(ДокументСравнения)
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСравнения, "ОсновнойФайл, УчетныйДокумент, ИдентификаторКомандыПечати");
	
	Результат = Новый Структура;
	Результат.Вставить("СохраненныйДокумент", Новый ТабличныйДокумент);
	Результат.Вставить("АктуальныйДокумент", Новый ТабличныйДокумент);
	
	ДвоичныеДанныеСохраненногоДокумента = РаботаСФайлами.ДвоичныеДанныеФайла(РеквизитыДокумента.ОсновнойФайл, Ложь);
	
	Если ДвоичныеДанныеСохраненногоДокумента = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТабличныйДокументСохраненногоДокумента = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанныеСохраненногоДокумента);
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("УчетныйДокумент", РеквизитыДокумента.УчетныйДокумент);
	ПараметрыПечати.Вставить("ИдентификаторКомандыПечати", РеквизитыДокумента.ИдентификаторКомандыПечати);
	
	ВнутреннийЭДОПереопределяемый.ПриПолученииТабличногоДокументаАктуальногоДокумента(ПараметрыПечати);
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДвоичныеДанныеАктуальногоДокумента = ВнутреннийЭДО.ДвоичныеДанныеУчетногоДокумента(ПараметрыПечати);
	ТабличныйДокументАктуальногоДокумента = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанныеАктуальногоДокумента);
	
	Результат.Вставить("СохраненныйДокумент", ТабличныйДокументСохраненногоДокумента);
	Результат.Вставить("АктуальныйДокумент", ТабличныйДокументАктуальногоДокумента);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаОповещенияОтличийНеНайдено(Результат) Экспорт
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти
