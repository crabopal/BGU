&НаСервере
Функция ПользователюРазрешеноИзменениеМаршрута()
	Возврат ПравоДоступа("Изменение", Метаданные.РегистрыСведений.НастройкиВнутреннегоЭДОБГУ)
		ИЛИ ПравоДоступа("Редактирование", Метаданные.Документы.ВнутреннийЭлектронныйДокумент);
КонецФункции

&НаКлиенте
Процедура РазвернутьДеревоМаршрута()
	
	Для Каждого ЭлементДерева Из ДеревоМаршрута.ПолучитьЭлементы() Цикл
		Элементы.ДеревоМаршрута.Развернуть(ЭлементДерева.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПодписантовИСостоянийПоДеревуМаршрута()
	
	ПодписантыИСостояния.Очистить();
	
	Дерево = РеквизитФормыВЗначение("ДеревоМаршрута");
	
	ДобавитьПодписантовПоДеревуМаршрута(Дерево, Объект.Ссылка.Пустая());
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПодписантовПоДеревуМаршрута(УзелДерева, ТолькоСтартовые)
	
	Если ТипЗнч(УзелДерева) = Тип("ДеревоЗначений") Тогда
		Для Каждого СтрокаДерева Из УзелДерева.Строки Цикл
			ДобавитьПодписантовПоДеревуМаршрута(СтрокаДерева, ТолькоСтартовые);
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(УзелДерева.Группа) Тогда
		Если УзелДерева.Группа = "И" ИЛИ УзелДерева.Группа = "ИЛИ" Тогда
			Для Каждого СтрокаДерева Из УзелДерева.Строки Цикл
				ДобавитьПодписантовПоДеревуМаршрута(СтрокаДерева, ТолькоСтартовые);
			КонецЦикла;
		ИначеЕсли УзелДерева.Группа = "ПоОчереди" Тогда
			Для Каждого СтрокаДерева Из УзелДерева.Строки Цикл
				ДобавитьПодписантовПоДеревуМаршрута(СтрокаДерева, ТолькоСтартовые);
				Если ТолькоСтартовые Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Иначе
			ВызватьИсключение НСтр("ru='Недопустимое значение группы маршрута'");
		КонецЕсли;
	Иначе
		НоваяСтрока = ПодписантыИСостояния.Добавить();
		НоваяСтрока.Подписант = УзелДерева.Подписант;
		НоваяСтрока.ВидПодписи = УзелДерева.ВидПодписи;
		НоваяСтрока.Сертификат = УзелДерева.Сертификат;
		Если ТолькоСтартовые Тогда
			НоваяСтрока.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание");
		Иначе
			НоваяСтрока.Состояние = УзелДерева.Состояние;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСоставКомандДействий()
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	ЕстьПравоАннулирования = ПользователюДоступноАннулированиеДокумента(ТекущийПользователь);
	
	Элементы.Подписать.Видимость = Ложь;
	Элементы.ВернутьВРаботу.Видимость = Ложь;
	Элементы.ОтказатьсяОтПодписания.Видимость = Ложь;
	Элементы.Аннулировать.Видимость = Ложь;
	Элементы.ОтменитьОтказОтПодписания.Видимость = Ложь;
	Элементы.ОтменитьАннулирование.Видимость = Ложь;
	Элементы.ПереместитьВНеактуальные.Видимость = Ложь;
	Элементы.СделатьАктуальным.Видимость = Ложь;
	
	Если Объект.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	Если МаршрутИзменен Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Актуальный Тогда
		Если ЕстьПравоАннулирования Тогда
			Элементы.СделатьАктуальным.Видимость = Истина;
		КонецЕсли;
	ИначеЕсли Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.НеНачат") Тогда
		Подписанты = ПодписантыИСостояния.НайтиСтроки(Новый Структура("Подписант, Состояние", ТекущийПользователь,
			ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание")));
		Если Подписанты.Количество() > 0 Тогда
			Элементы.Подписать.Видимость = Истина;
		КонецЕсли;
	ИначеЕсли Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание") Тогда
		Подписанты = ПодписантыИСостояния.НайтиСтроки(Новый Структура("Подписант, Состояние", ТекущийПользователь, Состояние));
		Если Подписанты.Количество() > 0 Тогда
			Элементы.Подписать.Видимость = Истина;
			Элементы.ОтказатьсяОтПодписания.Видимость = Истина;
		КонецЕсли;
		Если ЕстьПравоАннулирования Тогда
			Элементы.Аннулировать.Видимость = Истина;
		КонецЕсли;
	ИначеЕсли Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяУточнение") Тогда
		Подписанты = ПодписантыИСостояния.НайтиСтроки(Новый Структура("Подписант, Состояние", ТекущийПользователь, Состояние));
		Если Подписанты.Количество() > 0 Тогда
			Элементы.ОтменитьОтказОтПодписания.Видимость = Истина;
		КонецЕсли;
		Если ЕстьПравоАннулирования Тогда
			Элементы.ВернутьВРаботу.Видимость = Истина;
			Элементы.Аннулировать.Видимость = Истина;
		КонецЕсли;
	ИначеЕсли Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.Аннулирован") Тогда
		Если ЕстьПравоАннулирования Тогда
			Элементы.ОтменитьАннулирование.Видимость = Истина;
			Элементы.ПереместитьВНеактуальные.Видимость = Истина;
		КонецЕсли;
	ИначеЕсли Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.Завершен") Тогда
		Если ЕстьПравоАннулирования Тогда
			Элементы.Аннулировать.Видимость = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

