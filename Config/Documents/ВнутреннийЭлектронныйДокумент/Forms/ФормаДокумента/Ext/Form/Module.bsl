	КонецЕсли;
	
	ПараметрыОповещения = Новый Структура("ПодписиДляПроверки, ПроверяемыйИндекс", ПодписиДляПроверки, 0);
	Оповещение = Новый ОписаниеОповещения("ПослеПроверкиОчереднойПодписи", ЭтотОбъект, ПараметрыОповещения);
	
	ЭлектроннаяПодписьКлиент.ПроверитьПодпись(Оповещение,
		АдресОсновногоФайла, ПодписиДляПроверки[0].АдресПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПроверкиОчереднойПодписи(Результат, ДопПараметры) Экспорт
	
	ПодписиДляПроверки = ДопПараметры.ПодписиДляПроверки;
	ПроверяемыйИндекс = ДопПараметры.ПроверяемыйИндекс;
	
	ПодписиДляПроверки[ПроверяемыйИндекс].ДатаПроверкиПодписи = ОбщегоНазначенияКлиент.ДатаСеанса();
	
	Если ТипЗнч(Результат) = Тип("Булево") Тогда
		ПодписиДляПроверки[ПроверяемыйИндекс].ПодписьВерна = Результат;
		ПодписиДляПроверки[ПроверяемыйИндекс].ОписаниеОшибки = "";
	ИначеЕсли ТипЗнч(Результат) = Тип("Строка") Тогда
		ТекстОшибки = НСтр("ru = 'Электронная подпись в строке %1 неверна.
								|Причина: %2'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, ПодписиДляПроверки[ПроверяемыйИндекс].НомерСтроки, Результат);
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ТекстОшибки,,"ЭлектронныеПодписи["+(ПодписиДляПроверки[ПроверяемыйИндекс].НомерСтроки-1)+"].Статус");
		ПодписиДляПроверки[ПроверяемыйИндекс].ПодписьВерна = Ложь;
		ПодписиДляПроверки[ПроверяемыйИндекс].ОписаниеОшибки = Результат;
	Иначе
		ТекстСообщения = НСтр("ru = 'Не удалось проверить подписи электронного документа.
									|Проверьте настройки криптографии или обратитесь к администратору.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСтатусПодписи(ПодписиДляПроверки[ПроверяемыйИндекс]);
	
	Если ПроверяемыйИндекс < ПодписиДляПроверки.ВГраница() Тогда
		
		ПараметрыОповещения = Новый Структура("ПодписиДляПроверки, ПроверяемыйИндекс", ПодписиДляПроверки, ПроверяемыйИндекс + 1);
		Оповещение = Новый ОписаниеОповещения("ПослеПроверкиОчереднойПодписи", ЭтотОбъект, ПараметрыОповещения);
		
		ЭлектроннаяПодписьКлиент.ПроверитьПодпись(Оповещение,
			АдресОсновногоФайла, ПодписиДляПроверки[ПроверяемыйИндекс + 1].АдресПодписи);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПеремещениеВНеактуальныеПослеОтвета(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПереместитьВНеактуальныеНаСервере();
	
	Оповестить(ВнутреннийЭДОКлиент.ИмяСобытияОбновленияСостоянияВнутреннегоЭД());
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьАктуализациюПослеОтвета(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	СделатьАктуальнымНаСервере();
	
	Оповестить(ВнутреннийЭДОКлиент.ИмяСобытияОбновленияСостоянияВнутреннегоЭД());
	
КонецПроцедуры

&НаСервере
Функция АдресФайлаСоШтампом()
	
	ТабличныйДокументИзХранилища = ПолучитьИзВременногоХранилища(АдресТабличногоДокумента);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("zip");
	
	ТабличныйДокументИзХранилища.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.PDF_A_3);
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Удаление временного PDF файла'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	КонецПопытки;
	
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Функция МаршрутМожноЗаписать()
	
	ВершиныДляПроверки = Новый Массив;
	ВершиныДляПроверки.Добавить(ДеревоМаршрута);
	Пока ВершиныДляПроверки.Количество() > 0 Цикл
		ВершинаДляПроверки = ВершиныДляПроверки[ВершиныДляПроверки.ВГраница()];
		ВершиныДляПроверки.Удалить(ВершиныДляПроверки.ВГраница());
		Для Каждого ЭлементВершины Из ВершинаДляПроверки.ПолучитьЭлементы() Цикл
			Если ЭлементВершины.ЭтоСтрокаУсловия Тогда
				ВершиныДляПроверки.Добавить(ЭлементВершины);
			ИначеЕсли НЕ ЗначениеЗаполнено(ЭлементВершины.Подписант)
				ИЛИ НЕ ЗначениеЗаполнено(ЭлементВершины.ОсновноеЗначение) Тогда
				ТекстСообщения = НСтр("ru = 'В маршруте есть незаполненные подписанты. Запись запрещена.'");
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ЗаписатьМаршрутНаСервере()
	
	НачатьТранзакцию();
	Попытка
		
		ВнутреннийЭДО.ЗаблокироватьРегистрСостоянияУчетныхДокументов(Объект.УчетныйДокумент);
		
		СостояниеДокумента = ВнутреннийЭДО.СостояниеЭлектронногоДокумента(Объект.Ссылка);
		Если СостояниеДокумента.Состояние <> ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание")
			И СостояниеДокумента.Состояние <> ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяУточнение") Тогда
			
			ТекстОшибки = НСтр("ru = 'Состояние документа не подходит для изменения подписантов'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			
		ИначеЕсли МаршрутИзмененПолностью Тогда
			
			СоставМаршрута = ВнутреннийЭДО.СоставМаршрутаПодписанияДокумента(Объект.Ссылка);
			Для Каждого СтрокаМаршрута Из СоставМаршрута Цикл
				Если ЗначениеЗаполнено(СтрокаМаршрута.ДатаПодписи) Тогда
					ТекстОшибки = НСтр("ru = 'Маршут не может быть изменен, так как подписант %1 уже подписал документ'");
					ТекстОшибки = СтрШаблон(ТекстОшибки, СтрокаМаршрута.Подписант);
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
					ОтменитьТранзакцию();
					Возврат;
				КонецЕсли;
			КонецЦикла;
			
			СоставМаршрута = Неопределено;
			ВнутреннийЭДО.ЗаполнитьТаблицуСоставМаршрутаПоДереву(РеквизитФормыВЗначение("ДеревоМаршрута"), СоставМаршрута);
			
			ПараметрыСостояния = Новый Структура;
			ПараметрыСостояния.Вставить("УчетныйДокумент", Объект.УчетныйДокумент);
			ПараметрыСостояния.Вставить("ЭлектронныйДокумент", Объект.Ссылка);
			ПараметрыСостояния.Вставить("Состояние", ВнутреннийЭДО.СостояниеДокументаТребуетсяПодписание());
			ПараметрыСостояния.Вставить("Актуальный", Истина);
			ПараметрыСостояния.Вставить("ДатаИзменения", ТекущаяДатаСеанса());
			ПараметрыСостояния.Вставить("Комментарий", "");
			
			ВнутреннийЭДО.УстановитьСостояниеДокумента(ПараметрыСостояния);
			
			ПараметрыМаршрута = Новый Структура;
			ПараметрыМаршрута.Вставить("ЭлектронныйДокумент", Объект.Ссылка);
			ПараметрыМаршрута.Вставить("СоставМаршрута", СоставМаршрута);
			
			ВнутреннийЭДО.СохранитьМаршрутПодписанияДокумента(ПараметрыМаршрута);
			
			ДеревоМаршрута.ПолучитьЭлементы().Очистить();
			
		Иначе
			
			ПодписантыДляИзменения = Новый Массив;
			
			СоставМаршрута = ВнутреннийЭДО.СоставМаршрутаПодписанияДокумента(Объект.Ссылка);
			
			ВершиныМаршрута = Новый Массив;
			ВершиныМаршрута.Добавить(ДеревоМаршрута);
			Пока ВершиныМаршрута.Количество() > 0 Цикл
				ВершинаМаршрута = ВершиныМаршрута[ВершиныМаршрута.ВГраница()];
				ВершиныМаршрута.Удалить(ВершиныМаршрута.ВГраница());
				Для Каждого ЭлементВершины Из ВершинаМаршрута.ПолучитьЭлементы() Цикл
					Если ЭлементВершины.ЭтоСтрокаУсловия Тогда
						ВершиныМаршрута.Добавить(ЭлементВершины);
					Иначе
						ПодписантДляИзменения = Новый Структура;
						ПодписантДляИзменения.Вставить("Идентификатор", ЭлементВершины.Идентификатор);
						ПодписантДляИзменения.Вставить("Подписант", ЭлементВершины.Подписант);
						ПодписантДляИзменения.Вставить("Сертификат", ЭлементВершины.Сертификат);
						ПодписантДляИзменения.Вставить("ВидПодписи", ЭлементВершины.ВидПодписи);
						ПодписантыДляИзменения.Добавить(ПодписантДляИзменения);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
			Для Каждого ПодписантДляИзменения Из ПодписантыДляИзменения Цикл
				
				СтрокаМаршрута = СоставМаршрута.Найти(ПодписантДляИзменения.Идентификатор, "Идентификатор");
				
				Если ПодписантДляИзменения.Подписант = СтрокаМаршрута.Подписант
					И ПодписантДляИзменения.Сертификат = СтрокаМаршрута.Сертификат
					И ПодписантДляИзменения.ВидПодписи = СтрокаМаршрута.ВидПодписи Тогда
					Продолжить;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрокаМаршрута.ДатаПодписи) Тогда
					ТекстОшибки = НСтр("ru = 'Подписант %1 уже подписал документ и не может быть изменен на подписанта %2'");
					ТекстОшибки = СтрШаблон(ТекстОшибки, СтрокаМаршрута.Подписант, ПодписантДляИзменения.Подписант);
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
					Продолжить;
				КонецЕсли;
				
				НаборЗаписей = РегистрыСведений.СоставМаршрутаЭлектронногоДокумента.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.ЭлектронныйДокумент.Установить(Объект.Ссылка);
				НаборЗаписей.Отбор.Идентификатор.Установить(ПодписантДляИзменения.Идентификатор);
				
				Запись = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(Запись, СтрокаМаршрута);
				Запись.ЭлектронныйДокумент = Объект.Ссылка;
				Запись.Подписант = ПодписантДляИзменения.Подписант;
				Запись.Сертификат = ПодписантДляИзменения.Сертификат;
				Запись.ВидПодписи = ПодписантДляИзменения.ВидПодписи;
				Запись.ИзмененПользователем = Истина;
				
				НаборЗаписей.Записать();
				
			КонецЦикла;
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	МаршрутИзменен = Ложь;
	МаршрутИзмененПолностью = Ложь;
	
	ЗаполнитьДеревоМаршрута();
	
	ОбновитьСоставКомандДействий();
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПослеПодтвержденияЗакрытия(Результат, ДопПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда
		Если МаршрутМожноЗаписать() Тогда
			ЗаписатьМаршрутНаСервере();
		Иначе
			Возврат;
		КонецЕсли;
	Иначе
		МаршрутИзменен = Ложь;
	КонецЕсли;
	
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРезультатПроверкиПодписиНаСервере(ПорядковыйНомер, СообщениеПользователю)
	
	УстановленныеПодписи = ЭлектроннаяПодпись.УстановленныеПодписи(Объект.ОсновнойФайл, ПорядковыйНомер, Истина);
	Свойства = Новый Структура("ДатаПроверкиПодписи, ПодписьВерна, ТребуетсяПроверка");
	
	Если УстановленныеПодписи.Количество() = 0 Тогда
		СообщениеПользователю = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось найти подпись с порядковым номером %1 у %2'"),
			ПорядковыйНомер, Объект.ОсновнойФайл);
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("ПорядковыйНомер", ПорядковыйНомер);
	ДанныеПодписи = ЭлектронныеПодписи.НайтиСтроки(Отбор)[0];
	
	Подпись = УстановленныеПодписи[0];
	
	Если Подпись.ДатаПодписи         <> ДанныеПодписи.ДатаПодписи
		Или Подпись.Комментарий         <> ДанныеПодписи.Комментарий
		Или Подпись.КомуВыданСертификат <> ДанныеПодписи.КомуВыданСертификат И ЗначениеЗаполнено(ДанныеПодписи.КомуВыданСертификат)
		Или Подпись.Отпечаток           <> ДанныеПодписи.Отпечаток И ЗначениеЗаполнено(ДанныеПодписи.Отпечаток)
		Или Подпись.УстановившийПодпись <> ДанныеПодписи.УстановившийПодпись Тогда
		Возврат; // Если объект был изменен, результаты проверки не переносятся.
	КонецЕсли;
	
	ЕстьИзменения = Ложь;
	
	Для Каждого КлючИЗначение Из Свойства Цикл
		Если Подпись[КлючИЗначение.Ключ] <> ДанныеПодписи[КлючИЗначение.Ключ] Тогда
			ЕстьИзменения = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьИзменения Тогда
		ЗаполнитьЗначенияСвойств(Подпись, ДанныеПодписи, "ДатаПроверкиПодписи, ПодписьВерна, ТребуетсяПроверка");
		ЭлектроннаяПодпись.ОбновитьПодпись(Объект.ОсновнойФайл, Подпись);
		СообщениеПользователю = НСтр("ru = 'Результат проверки подписи записан'");
	Иначе
		СообщениеПользователю = НСтр("ru = 'Результат проверки подписи не изменился'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПодписьДокумента()
	
	ТекущиеДанные = Элементы.ЭлектронныеПодписи.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ПростаяПодпись Тогда
		ВнутреннийЭДОКлиент.ОткрытьПростуюПодпись(ТекущиеДанные);
	ИначеЕсли ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ЭлектроннаяПодпись") Тогда
		ЭлектроннаяПодписьКлиент.ОткрытьПодпись(ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвойстваЭлементовДляВебКлиента(Форма, РазрешеноМенятьМаршрут)
	Объект = Форма.Объект;
	
	Если РазрешеноМенятьМаршрут Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ДеревоМаршрута", "ТолькоПросмотр", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ДеревоМаршрутаОсновноеЗначение", "ТолькоПросмотр", Ложь);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПоказыватьПрисоединенныеФайлыДокументаУчетаСогласноПравамДоступа()

	ПрисоединенныеФайлы.Очистить();
	
	Если ТипЗнч(Объект.УчетныйДокумент) = Тип("ДокументСсылка.РегистрУчета") Тогда
		Возврат;
	КонецЕсли;	
	
	ИмяСправочникаХранилищаФайлов = РаботаСФайламиСлужебный.ИмяСправочникаХраненияФайлов(Объект.УчетныйДокумент); 
	
	Если НЕ ЗначениеЗаполнено(ИмяСправочникаХранилищаФайлов) Тогда
		Возврат;
	КонецЕсли;

	ИмяМетаданныхПрисоединенныхФайлов = "Справочник." + ИмяСправочникаХранилищаФайлов;
	
	ЧтениеПрисоединенныхФайлов  = ПравоДоступа("Чтение", Метаданные.НайтиПоПолномуИмени(ИмяМетаданныхПрисоединенныхФайлов), Пользователи.ТекущийПользователь()) ;
	
	Если ЧтениеПрисоединенныхФайлов Тогда 
		
		ЗаполнитьПредставлениеПрисоединенныеФайлы(ИмяМетаданныхПрисоединенныхФайлов);
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеПрисоединенныеФайлы(ИмяМетаданныхПрисоединенныхФайлов)
	
	МассивПрисоединенныхФайлов = РаботаСФайламиСлужебный.ПолучитьВсеПодчиненныеФайлы(Объект.УчетныйДокумент, ИмяМетаданныхПрисоединенныхФайлов);
		
	ЗаполнитьСписокПрисоединенныхФайлов(МассивПрисоединенныхФайлов);

	Если ПрисоединенныеФайлы.Количество() > 0 Тогда 
		
		ЗаголовокСтранициПрисоединенныеФайлы = СтрШаблон(НСтр("ru = 'Присоединенные файлы (%1)'"), ПрисоединенныеФайлы.Количество());
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "СтраницаПрисоединенныеФайлы", "Заголовок", ЗаголовокСтранициПрисоединенныеФайлы);
				
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СтраницаПрисоединенныеФайлы", "Видимость", ПрисоединенныеФайлы.Количество() > 0);
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПрисоединенныхФайлов(МассивПрисоединенныхФайлов)
	
	Если МассивПрисоединенныхФайлов.Количество() > 0 Тогда
		
		Для Каждого Файл из МассивПрисоединенныхФайлов Цикл 
			
			ФайлОбъект = Файл.ПолучитьОбъект();
			Если ФайлОбъект.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Служебный", Файл.Метаданные()) И ФайлОбъект.Служебный Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ПрисоединенныеФайлы.Добавить();
			ЗаполнитьДанныеСтрокиПрисоединенныеФайлы(НоваяСтрока, Файл);
			
		КонецЦикла;
		
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСтрокиПрисоединенныеФайлы(Строка, Файл)
	
	РеквизитыФайла = ИмяРазмерРасширениеФайла(Файл); 
	
	Строка.Файл 							= Файл;
	Строка.НаименованиеФайла 				= РеквизитыФайла.Наименование;
	Строка.Размер 							= РеквизитыФайла.Размер;
	Строка.РазмерПредставление 				= РеквизитыФайла.ПредставлениеРазмера;
	Строка.Ответственный	   				= РеквизитыФайла.Ответственный;
	Строка.ИндексКартинки	   				= РеквизитыФайла.ИндексКартинки;
	Строка.НомерКартинкиПодписанЗашифрован 	= РеквизитыФайла.НомерКартинкиПодписанЗашифрован;  	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяРазмерРасширениеФайла(Файл)
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Размер", 0);
	Результат.Вставить("ПредставлениеРазмера", "");
	Результат.Вставить("Расширение", "");
	Результат.Вставить("Ответственный", ); 
	Результат.Вставить("ИндексКартинки", 0);
	Результат.Вставить("НомерКартинкиПодписанЗашифрован", 0);
	
	ИмяРазмерРасширение = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Файл, "Наименование, Размер, Расширение, Изменил, ИндексКартинки, ПодписанЭП, Зашифрован");
	Результат.Расширение = ИмяРазмерРасширение.Расширение;
	Шаблон = НСтр("ru='%1.%2'");
	Результат.Наименование = СтрШаблон(Шаблон, ИмяРазмерРасширение.Наименование, ИмяРазмерРасширение.Расширение);
	Размер = ИмяРазмерРасширение.Размер;
	Результат.Размер = Размер;
	БайтовВМегабайте = БайтовВМегабайте();
	БайтовВКилобайте = 1024; 
	
	Если Размер >= БайтовВМегабайте Тогда
		Размер = Размер / БайтовВМегабайте;
		Размер = Окр(Размер, 1);
		Шаблон = НСтр("ru='%1 Мб'");
	Иначе
		Размер = Размер / БайтовВКилобайте;
		Размер = Окр(Размер, 1);
		Шаблон = НСтр("ru='%1 Кб'");
	КонецЕсли;
	Результат.ПредставлениеРазмера = СтрШаблон(Шаблон, Размер);
	Результат.Ответственный		   = ИмяРазмерРасширение.Изменил;
	Результат.ИндексКартинки	   = ИмяРазмерРасширение.ИндексКартинки; 
	
	Если ИмяРазмерРасширение.ПодписанЭП И ИмяРазмерРасширение.Зашифрован Тогда
		НомерКартинки = 2;
	ИначеЕсли ИмяРазмерРасширение.Зашифрован Тогда 
		НомерКартинки = 1; 
	ИначеЕсли ИмяРазмерРасширение.ПодписанЭП Тогда
		НомерКартинки = 0; 
	Иначе
		НомерКартинки = -1;
	КонецЕсли;
	
	Результат.НомерКартинкиПодписанЗашифрован = НомерКартинки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьЭлектронныйДокументФайла(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = ПрисоединенныеФайлы.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеСтроки.Файл) Тогда
		ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ДанныеФайлаДляОткрытия(
			ДанныеСтроки.Файл, Неопределено, УникальныйИдентификатор);
		
		РаботаСФайламиКлиент.ОткрытьФайл(ДанныеФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция БайтовВМегабайте()

	Возврат 1024 * 1024;
	
КонецФункции

&НаСервере
Процедура ВнешнийЭлектронныйДокументФайла(ВнутреннийЭД, ПараметрыФормы)

	ВнутреннийЭДО.ВнешнийЭлектронныйДокументФайла(ВнутреннийЭД, ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВнешнийЭлектронныйДокументФайла(ЭлектронныйДокумент = Неопределено)
	ПараметрыФормы = Новый Структура;
	
	ВнешнийЭлектронныйДокументФайла(Объект.Ссылка, ПараметрыФормы);
	
	Если ЗначениеЗаполнено(ЭлектронныйДокумент) Тогда
		ПараметрыФормы.Вставить("Ключ", ЭлектронныйДокумент);
	КонецЕсли;	
	
	Если ПараметрыФормы.Свойство("ДвоичныеДанныеФайла") Тогда
		ВнутреннийЭДОКлиент.ОткрытьФормуВнешнегоЭлектронногоДокумента(ПараметрыФормы);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура КопияФормуляраВнешнийЭлектронныйДокументФайла(ВнутреннийЭД, ПараметрыФормы)
	
	ВнутреннийЭДО.КопияФормуляраВнешнийЭлектронныйДокументФайла(ВнутреннийЭД, ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВнешнийЭлектронныйДокументСКопиейФайла(ЭлектронныйДокумент = Неопределено)

	ПараметрыФормы = Новый Структура;
	
	КопияФормуляраВнешнийЭлектронныйДокументФайла(Объект.Ссылка, ПараметрыФормы);
	
	Если ЗначениеЗаполнено(ЭлектронныйДокумент) Тогда
		ПараметрыФормы.Вставить("Ключ", ЭлектронныйДокумент);
	КонецЕсли;	
	
	Если ПараметрыФормы.Свойство("ДвоичныеДанныеФайла") Тогда
		ВнутреннийЭДОКлиент.ОткрытьФормуВнешнегоЭлектронногоДокумента(ПараметрыФормы);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовВнешнегоЭДО()
	ЕстьЭДОСКонтрагентами = Истина;
	
	ЭтоДокумент = Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Объект.УчетныйДокумент));
	
	Если ЭтоДокумент Тогда 
		ЕстьПравоДоступаКУчетномуДокументу = ПравоДоступа("Просмотр", Метаданные.Документы[Объект.УчетныйДокумент.Метаданные().Имя]);
	Иначе
		ЕстьПравоДоступаКУчетномуДокументу = ПравоДоступа("Просмотр", Метаданные.Справочники[Объект.УчетныйДокумент.Метаданные().Имя]);	
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);

	Если НЕ Пользователи.РолиДоступны("ДобавлениеИзменениеЭлектронныхДокументов",, Ложь) Тогда
		МожноСоздатьНовыйВнешнийЭД = Ложь;
	Иначе
		КоличествоВнешнихЭДВРаботе = ВнешниеЭлектронныеДокументы.Количество();
		КоличествоВнешнихЭДЗавершены = 0;
		Для Каждого ТекСтрока Из ВнешниеЭлектронныеДокументы Цикл
			Если ТекСтрока.СостояниеЭДО = "Аннулирован" Тогда
				КоличествоВнешнихЭДВРаботе = КоличествоВнешнихЭДВРаботе - 1;
			КонецЕсли;
			Если ТекСтрока.СостояниеЭДО = "Завершен" Тогда
				КоличествоВнешнихЭДВРаботе = КоличествоВнешнихЭДВРаботе - 1;
				КоличествоВнешнихЭДЗавершены = КоличествоВнешнихЭДЗавершены + 1;
			КонецЕсли;
		КонецЦикла;
		МожноСоздатьНовыйВнешнийЭД = Ложь;
		Если (КоличествоВнешнихЭДВРаботе = 0 И КоличествоВнешнихЭДЗавершены = 0) Тогда
			МожноСоздатьНовыйВнешнийЭД = Истина;
		КонецЕсли;	
	КонецЕсли;	

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ОтправитьКакВнешнийЭДКопию", "Видимость", МожноСоздатьНовыйВнешнийЭД И ЕстьПравоДоступаКУчетномуДокументу);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ОтправитьКакВнешнийЭД", "Видимость", МожноСоздатьНовыйВнешнийЭД И ЕстьПравоДоступаКУчетномуДокументу);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ОткрытьТекущиеДелаЭДО", "Видимость", ЕстьПравоДоступаКУчетномуДокументу);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СтраницаВнешниеЭД", "Видимость", ВнешниеЭлектронныеДокументы.Количество() > 0);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВнешнихЭД()
	Если НЕ ЕстьДоступностьВнешнегоЭДО() Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "СтраницаВнешниеЭД", "Видимость", Ложь);
			
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ОтправитьКакВнешнийЭДКопию", "Видимость", Ложь);

		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ОтправитьКакВнешнийЭД", "Видимость", Ложь);
			
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ОткрытьТекущиеДелаЭДО", "Видимость", Ложь);
			
		Возврат;
	КонецЕсли;	
	
	ЭлектронныеДокументыВнешнегоЭДО = Новый ТаблицаЗначений;
	ЭлектронныеДокументыВнешнегоЭДО.Колонки.Добавить("ЭлектронныйДокумент");
	ЭлектронныеДокументыВнешнегоЭДО.Колонки.Добавить("ТипФайлаФормуляра");
	ЭлектронныеДокументыВнешнегоЭДО.Колонки.Добавить("СостояниеЭДО");
	
	ВнутреннийЭДОПереопределяемый.ЗаполнитьВсеВнешниеПроизвольныеЭлектронныеДокументыУчетногоДокумента(Объект.Ссылка, ЭлектронныеДокументыВнешнегоЭДО);
	
	Если ЭлектронныеДокументыВнешнегоЭДО.Количество() > 0 Тогда
		ВнешниеЭлектронныеДокументы.Загрузить(ЭлектронныеДокументыВнешнегоЭДО);
	КонецЕсли;
	
	УстановитьВидимостьЭлементовВнешнегоЭДО();
КонецПроцедуры

&НаСервере
Функция ЕстьДоступностьВнешнегоЭДО()
	Результат = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НЕ ВнутреннийЭДО.ПоддерживаетсяИнтеграцияСБЭД() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("ЭлектронноеВзаимодействие.ОбменСКонтрагентами") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВключенаОпцияЭДО = ПолучитьФункциональнуюОпцию("ИспользоватьОбменЭД");
	Если НЕ ВключенаОпцияЭДО Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьПраваДоступа = Ложь;
	Если Пользователи.РолиДоступны("ДобавлениеИзменениеЭлектронныхДокументов",,Ложь) ИЛИ 
		Пользователи.РолиДоступны("ЧтениеЭлектронныхДокументов",,Ложь) Тогда
		ЕстьПраваДоступа = Истина;
	КонецЕсли;
	
	Если НЕ ЕстьПраваДоступа Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Реквизиты = "УчетныйДокумент";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, Реквизиты);
		
		УчетныйДокумент = ЗначенияРеквизитов.УчетныйДокумент;
		
		ДанныеДляПроверкиНастройкиЭДО = Новый Структура;
		ДанныеДляПроверкиНастройкиЭДО.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
		ДанныеДляПроверкиНастройкиЭДО.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
		
		ЗаполнитьЗначенияСвойств(ДанныеДляПроверкиНастройкиЭДО, УчетныйДокумент);
		
		Если НЕ ЗначениеЗаполнено(ДанныеДляПроверкиНастройкиЭДО.Организация) Тогда
			Результат = Ложь;
		Иначе
			Если НЕ ЗначениеЗаполнено(ДанныеДляПроверкиНастройкиЭДО.Контрагент) Тогда
				Результат = Истина;
			Иначе
				Результат = Ложь;
				ВнутреннийЭДОПереопределяемый.ЗаполнитьВидимостьЭлементовВнешнегоЭДО(ДанныеДляПроверкиНастройкиЭДО.Контрагент, ДанныеДляПроверкиНастройкиЭДО.Организация, Результат);	
			КонецЕсли;	
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Результат; 
КонецФункции	

#КонецОбласти
