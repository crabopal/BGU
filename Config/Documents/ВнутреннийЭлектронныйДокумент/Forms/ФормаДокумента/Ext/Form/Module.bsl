&НаСервере
Процедура ЗаполнитьВидПодписиТекущегоПользователя()
	
	ВидПодписи = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ПустаяСсылка");
	Сертификат = ПредопределенноеЗначение("Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования.ПустаяСсылка");
	
	СтрокиПользователя = ПодписантыИСостояния.НайтиСтроки(
		Новый Структура("Подписант, Состояние",
			Пользователи.ТекущийПользователь(),
			ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание")));
	
	Если СтрокиПользователя.Количество() > 0 Тогда
		ВидПодписи = СтрокиПользователя[0].ВидПодписи;
		Сертификат = СтрокиПользователя[0].Сертификат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПодписей()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ЭлектронныеПодписи.Очистить();
	
	МассивЭП = СписокЭлектронныхПодписей(Объект.ОсновнойФайл, УникальныйИдентификатор);
	
	НомерСтроки = 0;
	
	Для Каждого ЭП Из МассивЭП Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		НоваяСтрока = ЭлектронныеПодписи.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭП);
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НоваяСтрока.Организация = ?(ЗначениеЗаполнено(ЭП.Организация), ЭП.Организация, Объект.Организация);
		
		Если НоваяСтрока.ПростаяПодпись Тогда
			НоваяСтрока.КартинкаЭП = 1;
			НоваяСтрока.КомуВыданСертификат = СтрШаблон(НСтр("ru = '%1, %2, %3'"),
				ЭП.ВладелецПодписи, Объект.Организация, ЭП.Должность);
		Иначе
			НоваяСтрока.КартинкаЭП = 0;
		КонецЕсли;
		
		ЗаполнитьСтатусПодписи(НоваяСтрока);
		
	КонецЦикла;
	
	Если ЭлектронныеПодписи.Количество() > 0 Тогда
		Элементы.СтраницаПодписи.Заголовок = СтрШаблон(НСтр("ru = 'Подписи (%1)'"), ЭлектронныеПодписи.Количество());
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокЭлектронныхПодписей(Объект, УникальныйИдентификатор)
	
	ЭлектронныеПодписи = ВнутреннийЭДО.УстановленныеПодписи(Объект);
	
	Для Каждого ЭлектроннаяПодписьФайла Из ЭлектронныеПодписи Цикл
		
		ЭлектроннаяПодписьФайла.Вставить("Объект", Объект);
		
		АдресПодписи = ПоместитьВоВременноеХранилище(ЭлектроннаяПодписьФайла.Подпись, УникальныйИдентификатор);
		ЭлектроннаяПодписьФайла.Вставить("АдресПодписи", АдресПодписи);
		
		АдресСертификата = ПоместитьВоВременноеХранилище(ЭлектроннаяПодписьФайла.Сертификат, УникальныйИдентификатор);
		ЭлектроннаяПодписьФайла.Вставить("АдресСертификата", АдресСертификата);

		РезультатПроверкиПодписиПоМЧД = ПоместитьВоВременноеХранилище(ЭлектроннаяПодписьФайла.РезультатПроверкиПодписиПоМЧД, УникальныйИдентификатор);
		ЭлектроннаяПодписьФайла.РезультатПроверкиПодписиПоМЧД = РезультатПроверкиПодписиПоМЧД;
		
	КонецЦикла;
	
	Возврат ЭлектронныеПодписи;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСтатусПодписи(СтрокаПодписи)
	
	Если Не ЗначениеЗаполнено(СтрокаПодписи.ДатаПроверкиПодписи) Тогда
		СтрокаПодписи.Статус = "";
	ИначеЕсли НЕ СтрокаПодписи.ПодписьВерна Тогда
		СтрокаПодписи.Статус = НСтр("ru = 'Неверна'");
	Иначе
		СтрокаПодписи.Статус = НСтр("ru = 'Верна'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПодписаниеПослеПодтвержденияЗаписи(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Записать();
	Исключение
		ПоказатьОповещениеПользователя(,,ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			БиблиотекаКартинок.Информация32);
		Возврат; // Запись не удалась, сообщения о причинах выводит платформа.
	КонецПопытки;
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат; // Запись не удалась, сообщения о причинах выводит платформа.
	КонецЕсли;
	
	ПродолжитьПодписание();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПодписание()
	
	ВнутреннийЭДОКлиент.ПодписатьЭлектроннойПодписью(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Ссылка),
		УникальныйИдентификатор,
		ВидПодписи,
		Сертификат);
	
КонецПроцедуры

