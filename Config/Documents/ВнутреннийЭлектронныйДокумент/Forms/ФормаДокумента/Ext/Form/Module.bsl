Процедура ОбновитьНаличиеНеактуальныхВерсий()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВнутреннийЭлектронныйДокумент.Ссылка КАК Ссылка,
	|	СостоянияЭлектронныхДокументов.Состояние КАК Состояние,
	|	СостоянияЭлектронныхДокументов.ДатаИзменения КАК ДатаИзменения,
	|	СостоянияЭлектронныхДокументов.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.ВнутреннийЭлектронныйДокумент КАК ВнутреннийЭлектронныйДокумент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЭлектронныхДокументов КАК СостоянияЭлектронныхДокументов
	|		ПО ВнутреннийЭлектронныйДокумент.Ссылка = СостоянияЭлектронныхДокументов.ЭлектронныйДокумент
	|ГДЕ
	|	СостоянияЭлектронныхДокументов.Актуальный = ЛОЖЬ
	|	И ВнутреннийЭлектронныйДокумент.УчетныйДокумент = &УчетныйДокумент
	|	И ВнутреннийЭлектронныйДокумент.ИдентификаторКомандыПечати = &ИдентификаторКомандыПечати";
	
	Запрос.УстановитьПараметр("УчетныйДокумент", Объект.УчетныйДокумент);
	Запрос.УстановитьПараметр("ИдентификаторКомандыПечати", Объект.ИдентификаторКомандыПечати);
	
	ЕстьНеактуальныеВерсии = НЕ Запрос.Выполнить().Пустой();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьАктуальностьДокумента()
	
	ТабличныеДокументы = ТабличныеДокументыДляСравнения();
	
	// Если актуальный документ пустой, то считаем, что сохраненный документ актуален
	Если ТабличныеДокументы.АктуальныйДокумент.ВысотаТаблицы = 0 Тогда
		ДокументАктуален = Истина;
	Иначе
		ДокументАктуален = ВнутреннийЭДО.ТабличныеДокументыИдентичны(
			ТабличныеДокументы.СохраненныйДокумент, ТабличныеДокументы.АктуальныйДокумент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТабличныеДокументыДляСравнения()
	
	Результат = Новый Структура;
	Результат.Вставить("СохраненныйДокумент", Новый ТабличныйДокумент);
	Результат.Вставить("АктуальныйДокумент", Новый ТабличныйДокумент);
	
	ДвоичныеДанныеСохраненногоДокумента = ДвоичныеДанныеЭлектронногоДокумента();
	
	Если ДвоичныеДанныеСохраненногоДокумента = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТабличныйДокументСохраненногоДокумента = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанныеСохраненногоДокумента);
	
	ПараметрыПечати = Новый Структура;
