
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Объект.Ссылка.Пустая() Тогда
		
		Описание = ВнутреннийЭДО.ОписаниеНовогоЭлектронногоДокумента(Параметры);
		
		Если НЕ ЗначениеЗаполнено(Описание.АдресОсновногоФайла) Тогда
			ТекстСообщения = НСтр("ru='Электронный документ выбранного вида не может быть сформирован, проверьте возможность печати соответствующей формы из документа'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			Возврат;
		КонецЕсли;
		
		Если Параметры.Свойство("ИдентификаторДокумента") Тогда
			МетаданныеОбъекта = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(Параметры.ИдентификаторДокумента);
			
			КомандыПечати = ВнутреннийЭДО.КомандыПечатиОбъекта(МетаданныеОбъекта);
			КомандаПечати = ВнутреннийЭДО.КомандаПечатиПоИдентификатору(КомандыПечати, Параметры.ИдентификаторКомандыПечати);
			
			Если КомандаПечати <> Неопределено Тогда
				
				ТаблицаКомандПечатиИсключений=ВнутреннийЭДО.ПодготовитьТаблицуИсключенийКомандПечати();
			    ВнутреннийЭДОПереопределяемый.ПриЗаполненииТаблицыИсключенийКомандПечатиЭДО(ТаблицаКомандПечатиИсключений);
				
				ЗначениеПустойСсылки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ИдентификаторДокумента, "ЗначениеПустойСсылки");
				СтруктураОтбора = Новый Структура;  
				СтруктураОтбора.Вставить("УчетныйДокумент", ЗначениеПустойСсылки);  
				СтруктураОтбора.Вставить("ИдентификаторКомандыПечати", КомандаПечати.Идентификатор);  
				
				КомандаПечатиИсключение=ТаблицаКомандПечатиИсключений.НайтиСтроки(СтруктураОтбора);
				
				Если КомандаПечатиИсключение.Количество() > 0  Тогда
					ПричинаИсключенияКомандыПечати = КомандаПечатиИсключение[0].ПричинаИсключенияКомандыПечати;			
					
					ВидПечатнойФормы = ?(ЗначениеЗаполнено(Параметры.ВидДокумента),
										Параметры.ВидДокумента,
										ВнутреннийЭДОПереопределяемый.ПредставлениеКомандыПечатиОбъекта(Параметры.ИдентификаторДокумента, Параметры.ИдентификаторКомандыПечати));
					
					ШаблонСообщения = НСтр("ru='Печатная форма ""%1"" не может быть использована для формирования внутреннего электронного документа! '");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ВидПечатнойФормы);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения + Символы.ПС + ПричинаИсключенияКомандыПечати,,,,Отказ);
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		АдресОсновногоФайла = Описание.АдресОсновногоФайла;
		ИмяФайла = Описание.ИмяФайла;

		АдресОсновногоФайлаPDF = Описание.АдресОсновногоФайлаPDF;
		ИмяФайлаPDF = Описание.ИмяФайлаPDF;
		
		Объект.Организация = Параметры.Организация;
		Объект.УчетныйДокумент = Параметры.УчетныйДокумент;
		Объект.ВидДокумента = Параметры.ВидДокумента;
		Объект.ДатаДокумента = Параметры.ДатаДокумента;
		Объект.НомерДокумента = Параметры.НомерДокумента;
		Объект.ИдентификаторКомандыПечати = Параметры.ИдентификаторКомандыПечати;
		
		ПодготовитьФормуНаСервере();
		
	КонецЕсли;
	
	ЗаполнитьСписокВнешнихЭД();
	ЗаполнитьПредставлениеУчетногоДокумента();
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		НеактуальныеДокументы, "УчетныйДокумент", Объект.УчетныйДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
		НеактуальныеДокументы, "ИдентификаторКомандыПечати", Объект.ИдентификаторКомандыПечати);
		
	ПоказыватьПрисоединенныеФайлыДокументаУчетаСогласноПравамДоступа();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ПодготовитьФормуНаСервере();
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СоставМаршрута = Неопределено;
	ВнутреннийЭДО.ЗаполнитьТаблицуСоставМаршрутаПоДереву(РеквизитФормыВЗначение("ДеревоМаршрута"), СоставМаршрута);
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("АдресОсновногоФайла", АдресОсновногоФайла);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ИмяФайла", ИмяФайла);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("АдресОсновногоФайлаPDF", АдресОсновногоФайлаPDF);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ИмяФайлаPDF", ИмяФайлаPDF);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("СоставМаршрута", СоставМаршрута);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	УстановитьЗаголовокФормы();
	
	ОбновитьСостояниеДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	#Если ВебКлиент Тогда
		ИспользованиеВВебКлиенте = Истина;
	#Иначе
		ИспользованиеВВебКлиенте = Ложь;
	#КонецЕсли
	
	Если ИспользованиеВВебКлиенте Тогда
		УстановитьСвойстваЭлементовДляВебКлиента(ЭтотОбъект, ПользователюРазрешеноИзменениеМаршрута());
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РазвернутьДеревоМаршрута();
	
	Оповестить(ВнутреннийЭДОКлиент.ИмяСобытияОбновленияСостоянияВнутреннегоЭД());
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ МаршрутИзменен Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = НСтр("ru = 'Данные были изменены. Все изменения будут потеряны.'");
		Возврат;
	КонецЕсли;
	
	Обработчик = Новый ОписаниеОповещения("ПродолжитьПослеПодтвержденияЗакрытия", ЭтотОбъект);
	ТекстВопроса = НСтр("ru = 'Сохранить измененный маршрут подписания?'");
	ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	Если Объект.Ссылка.Пустая() Тогда
		
		Если Не ЗначениеЗаполнено(АдресОсновногоФайла) Тогда
			ТекстСообщения = НСтр("ru='Электронный документ не сформирован'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		КонецЕсли;
		
	Иначе
		НепроверяемыеРеквизиты.Добавить("ПредставлениеМаршрута");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = ВнутреннийЭДОКлиент.ИмяСобытияОбновленияСостоянияВнутреннегоЭД() Тогда
		
		ПриОбновленииСостоянияВнутреннегоЭД();
		ОповеститьОбИзменении(Объект.УчетныйДокумент);
		УстановитьВидимостьЭлементовВнешнегоЭДО();
		ЗаполнитьСписокВнешнихЭД();
		
	ИначеЕсли ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
	
		УстановитьВидимостьЭлементовВнешнегоЭДО();
		ЗаполнитьСписокВнешнихЭД();
		
	ИначеЕсли ИмяСобытия = "Запись_ВнутреннийЭлектронныйДокумент" Тогда 
		
		ПриОбновленииСостоянияВнутреннегоЭД();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура МаршрутПодписанияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(МаршрутПодписания) Тогда
		ПараметрыФормы.Вставить("Маршрут", МаршрутПодписания);
	Иначе
		ПараметрыФормы.Вставить("Маршрут", ДеревоМаршрута);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.МаршрутыПодписанияБГУ.Форма.ВыборИзДокумента", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура МаршрутПодписанияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ВыбранноеЗначение.Маршрут) = Тип("СправочникСсылка.МаршрутыПодписанияБГУ") Тогда
		МаршрутПодписания = ВыбранноеЗначение.Маршрут;
		ПредставлениеМаршрута = Строка(МаршрутПодписания);
	ИначеЕсли ТипЗнч(ВыбранноеЗначение.Маршрут) = Тип("ДанныеФормыДерево") Тогда
		МаршрутПодписания = ПредопределенноеЗначение("Справочник.МаршрутыПодписанияБГУ.ПустаяСсылка");
		КопироватьДанныеФормы(ВыбранноеЗначение.Маршрут, ДеревоМаршрута);
		ПредставлениеМаршрута = ВнутреннийЭДОКлиентСервер.ПредставлениеМаршрутаПоДереву(ДеревоМаршрута);
	КонецЕсли;
	
	ЗаполнитьДеревоМаршрута();
	
	РазвернутьДеревоМаршрута();
	
	ОбновитьСоставКомандДействий();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКомментарийСостоянияНажатие(Элемент)
	
	ОткрытьФорму("Документ.ВнутреннийЭлектронныйДокумент.Форма.КомментарийСостояния",
		Новый Структура("Комментарий", ОписаниеСостояния), ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеУчетногоДокументаНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(, Объект.УчетныйДокумент);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЭлектронныеПодписи

&НаКлиенте
Процедура ЭлектронныеПодписиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОткрытьПодписьДокумента();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоМаршрута

&НаКлиенте
Процедура ДеревоМаршрутаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МаршрутИзменен = Истина;
	МаршрутИзмененПолностью = Истина;
	
	ДеревоМаршрута.ПолучитьЭлементы().Очистить();
	
	Если ТипЗнч(ВыбранноеЗначение.Маршрут) = Тип("СправочникСсылка.МаршрутыПодписанияБГУ") Тогда
		МаршрутПодписания = ВыбранноеЗначение.Маршрут;
	ИначеЕсли ТипЗнч(ВыбранноеЗначение.Маршрут) = Тип("ДанныеФормыДерево") Тогда
		МаршрутПодписания = "";
		КопироватьДанныеФормы(ВыбранноеЗначение.Маршрут, ДеревоМаршрута);
	КонецЕсли;
	
	ЗаполнитьДеревоМаршрута();
	
	РазвернутьДеревоМаршрута();
	
	ОбновитьСоставКомандДействий();
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаОсновноеЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ТекущаяСтрока", Элементы.ДеревоМаршрута.ТекущиеДанные.ОсновноеЗначение);
	
	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаОсновноеЗначениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаДерева = ДеревоМаршрута.НайтиПоИдентификатору(Элементы.ДеревоМаршрута.ТекущаяСтрока);
	
	Если СтрокаДерева.Подписант = ВыбранноеЗначение Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	СтрокаДерева.Подписант = ВыбранноеЗначение;
	СтрокаДерева.ОсновноеЗначение = ВыбранноеЗначение;
	
	МаршрутИзменен = Истина;
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаОсновноеЗначениеОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаВидПодписиОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаДерева = ДеревоМаршрута.НайтиПоИдентификатору(Элементы.ДеревоМаршрута.ТекущаяСтрока);
	
	Если СтрокаДерева.ВидПодписи = ВыбранноеЗначение Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	СтрокаДерева.ВидПодписи = ВыбранноеЗначение; 
	
	Если ВыбранноеЗначение = ПредопределенноеЗначение("Перечисление.ВидыЭлектронныхПодписейБГУ.Простая") Тогда
		СтрокаДерева.Сертификат = Неопределено;	
	КонецЕсли;
	
	МаршрутИзменен = Истина;
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаСертификатОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаДерева = ДеревоМаршрута.НайтиПоИдентификатору(Элементы.ДеревоМаршрута.ТекущаяСтрока);
	
	Если СтрокаДерева.Сертификат = ВыбранноеЗначение Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	СтрокаДерева.Сертификат = ВыбранноеЗначение;
	
	МаршрутИзменен = Истина;
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаСертификатОчистка(Элемент, СтандартнаяОбработка)
	
	СтрокаДерева = ДеревоМаршрута.НайтиПоИдентификатору(Элементы.ДеревоМаршрута.ТекущаяСтрока);
	
	Если Не ЗначениеЗаполнено(СтрокаДерева.Сертификат) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	СтрокаДерева.Сертификат = ПредопределенноеЗначение("Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования.ПустаяСсылка");
	
	МаршрутИзменен = Истина;
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

#КонецОбласти

#Область  ОбработчикиСобытийЭлементовТаблицыФормыПрисоединенныеФайлы

&НаКлиенте
Процедура ПрисоединенныеФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ПрисоединенныеФайлыНаименованиеФайла" Тогда
		ОткрытьЭлектронныйДокументФайла(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	КонецЕсли; 
	
КонецПроцедуры  

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНеактуальныеДокументы

&НаКлиенте
Процедура НеактуальныеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ПоказатьЗначение(, Элементы.НеактуальныеДокументы.ТекущиеДанные.Ссылка);
КонецПроцедуры

#КонецОбласти

#Область  ОбработчикиСобытийЭлементовТаблицыФормыВнешниеЭлектронные

&НаКлиенте
Процедура ВнешниеЭлектронныеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ВнешниеЭлектронныеДокументы.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ЭлектронныйДокумент) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", ТекущиеДанные.ЭлектронныйДокумент);
		ВнутреннийЭДОКлиент.ОткрытьФормуВнешнегоЭлектронногоДокумента(ПараметрыФормы);
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Перечитать(Команда)
	
	Прочитать();
	
	РазвернутьДеревоМаршрута();
	
	ПоказыватьПрисоединенныеФайлыДокументаУчетаСогласноПравамДоступа();
	
КонецПроцедуры

&НаКлиенте
Процедура Подписать(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		ТекстВопроса = НСтр("ru = 'Выполнение действия возможно после записи данных.
			|Данные будут записаны.'");
		Обработчик = Новый ОписаниеОповещения("ПродолжитьПодписаниеПослеПодтвержденияЗаписи", ЭтотОбъект);
		ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	
	ПродолжитьПодписание();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтказатьсяОтПодписания(Команда)
	
	Обработчик = Новый ОписаниеОповещения("ПослеВводаКомментарияПриОтказеОтПодписания", ЭтотОбъект);
	Подсказка = НСтр("ru = 'Укажите причину отказа от подписания'");
	ПоказатьВводСтроки(Обработчик, , Подсказка, , Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьОтказОтПодписания(Команда)
	
	ОтменитьОтказОтПодписанияНаСервере();
	
	Оповестить(ВнутреннийЭДОКлиент.ИмяСобытияОбновленияСостоянияВнутреннегоЭД());
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьВРаботу(Команда)
	
	Обработчик = Новый ОписаниеОповещения("ПослеВводаКомментарияПриВозвратеВРаботу", ЭтотОбъект);
	Подсказка = НСтр("ru = 'Заполните комментарий (не обязательно)'");
	ПоказатьВводСтроки(Обработчик, , Подсказка, , Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Аннулировать(Команда)
	
	Обработчик = Новый ОписаниеОповещения("ПослеВводаКомментарияПриАннулировании", ЭтотОбъект);
	Подсказка = НСтр("ru = 'Укажите причину аннулирования'");
	ПоказатьВводСтроки(Обработчик, , Подсказка, , Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьАннулирование(Команда)
	
	ОтменитьАннулированиеНаСервере();
	
	Оповестить(ВнутреннийЭДОКлиент.ИмяСобытияОбновленияСостоянияВнутреннегоЭД());
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьВНеактуальные(Команда)
	
	ТекстВопроса = НСтр("ru = 'Документ будет перемещен в неактуальные. Продолжить?'");
	Обработчик = Новый ОписаниеОповещения("ПродолжитьПеремещениеВНеактуальныеПослеОтвета", ЭтотОбъект);
	ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура СделатьАктуальным(Команда)
	
	ТекстВопроса = НСтр("ru = 'Документ будет сделан актуальным. Продолжить?'");
	Обработчик = Новый ОписаниеОповещения("ПродолжитьАктуализациюПослеОтвета", ЭтотОбъект);
	ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура Сравнить(Команда)
	
	ТабличныеДокументы = ТабличныеДокументыДляСравнения();
	
	ТабличныйДокументЛевый = ТабличныеДокументы.СохраненныйДокумент;
	ТабличныйДокументПравый = ТабличныеДокументы.АктуальныйДокумент;
	
	СравниваемыеДокументы = Новый Структура("Левый, Правый", ТабличныйДокументЛевый, ТабличныйДокументПравый);
	АдресТабличныхДокументов = ПоместитьВоВременноеХранилище(СравниваемыеДокументы, Неопределено);
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("АдресТабличныхДокументов", АдресТабличныхДокументов);
	ПараметрыОткрытияФормы.Вставить("ЗаголовокЛевый", НСтр("ru = 'Сохраненный электронный документ'"));
	ПараметрыОткрытияФормы.Вставить("ЗаголовокПравый", НСтр("ru = 'Текущий электронный документ'"));
	
	ОткрытьФорму("ОбщаяФорма.СравнениеТабличныхДокументов", ПараметрыОткрытияФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписи(Команда)
	
	Если Элементы.ЭлектронныеПодписи.ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УсиленныеПодписи = Новый Массив;
	
	Для Каждого Подпись Из Элементы.ЭлектронныеПодписи.ВыделенныеСтроки Цикл
		СтрокаПодписи = ЭлектронныеПодписи.НайтиПоИдентификатору(Подпись);
		Если НЕ СтрокаПодписи.ПростаяПодпись Тогда
			УсиленныеПодписи.Добавить(СтрокаПодписи);
		КонецЕсли;
	КонецЦикла;
	
	НачатьПроверкуПодписей(УсиленныеПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьРезультатПроверкиПодписи(Команда)
	
	ТекущиеДанные = Элементы.ЭлектронныеПодписи.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ПростаяПодпись Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Команда не может быть выполнена для простой подписи'"));
		Возврат;
	КонецЕсли;
	
	СообщениеПользователю = "";
	ЗаписатьРезультатПроверкиПодписиНаСервере(ТекущиеДанные.ПорядковыйНомер, СообщениеПользователю);
	
	Если Не ПустаяСтрока(СообщениеПользователю) Тогда
		ПоказатьОповещениеПользователя(,,СообщениеПользователю);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДокумент(Команда)
	
	ФайлВыгрузки = ФайлВыгрузкиДокументов();

	ПродолжитьВыгрузку(ФайлВыгрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДокументPDF(Команда)
	
	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанных.ПолучатьСсылкуНаДвоичныеДанные = Ложь;
	ДанныеФайла = РаботаСФайламиКлиент.ДанныеФайла(Объект.ОсновнойФайл, ПараметрыДанных);
	ИмяФайла = ДанныеФайла.Наименование;
	
	АдресФайла = АдресФайлаСоШтампом();
	
	Оповещение = Новый ОписаниеОповещения("СохранитьДокументПослеПолученияФайла", ЭтотОбъект, Неопределено);
	Фильтр = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Файлы %1 (*.%1)|*.%1|Все файлы (*.*)|*.*'"),
		"pdf");
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохранения.Диалог.Фильтр = Фильтр;
	ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Выберите файл для сохранения данных'");
	
	ФайловаяСистемаКлиент.СохранитьФайл(Оповещение, АдресФайла, ИмяФайла, ПараметрыСохранения);
	
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьПрисоединенныеФайлы(Документ, ИмяПодкаталога)
	ВыгружатьПрисоединеныеФайлы = Истина;
	
	Если НЕ ВыгружатьПрисоединеныеФайлы Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.РегистрУчета") Тогда
		Возврат;
	КонецЕсли;	
	
	ИмяПодкаталогаФайлов = ИмяПодкаталога + "Присоединенные файлы" + ПолучитьРазделительПути();
	
	Файлы = Новый Массив;
	РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(Документ, Файлы);
	Для Каждого Файл Из Файлы Цикл
		Если Файл.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(Файл);
		ПолноеИмяФайла = ИмяПодкаталогаФайлов + ДанныеФайла.ИмяФайла;
		ПолноеИмяФайла = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ПолноеИмяФайла);
		ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		ДвоичныеДанныеФайла.Записать(ПолноеИмяФайла);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ФайлВыгрузкиДокументов()
	
	ВыгружатьПрисоединеныеФайлы = Истина;
	
	ДокументыДляВыгрузки = Новый Массив;
	ДокументыДляВыгрузки.Добавить(Объект.Ссылка);
	
	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДокументыДляВыгрузки, "ОсновнойФайл, ОсновнойФайлPDF, УчетныйДокумент");
	
	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанных.ВызыватьИсключение = Ложь;
	
	ИмяВременногоКаталога = ФайловаяСистема.СоздатьВременныйКаталог();
	
	ИмяАрхива = СтрШаблон(НСтр("ru = 'Выгрузка от %1'"), Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy;")) + ".zip";
	
	ЗаписьZipФайла = Новый ЗаписьZipФайла();
	
	Для Каждого Документ Из ДокументыДляВыгрузки Цикл
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(РеквизитыДокументов[Документ].ОсновнойФайл, ПараметрыДанных);
		
		ОсновнойФайлPDF = РеквизитыДокументов[Документ].ОсновнойФайлPDF;
		ДанныеФайлаPDF = Неопределено;
		Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
			ДанныеФайлаPDF = РаботаСФайлами.ДанныеФайла(ОсновнойФайлPDF, ПараметрыДанных);
		КонецЕсли;
		
		ИмяФайлаБезРасширения = Сред(ДанныеФайла.ИмяФайла, 1, СтрДлина(ДанныеФайла.ИмяФайла) - 4);
		
		Если ВыгружатьПрисоединеныеФайлы Тогда
			// Если выгружаются присоединенные файлы, для каждого документа создается отдельный каталог, 
			// для помещения в него всех связанных с документом файлов.
			ИмяПодкаталога = ИмяВременногоКаталога + ИмяФайлаБезРасширения;
			ИмяПодкаталога = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяПодкаталога, Истина) + ПолучитьРазделительПути();
			ИмяПодкаталогаMXL = ИмяПодкаталога + "Формуляр в формате MXL\";
			ПолноеИмяФайла = ИмяПодкаталогаMXL + ДанныеФайла.ИмяФайла;
		Иначе
			ИмяПодкаталога = ИмяВременногоКаталога;
			ИмяПодкаталогаMXL = ИмяПодкаталога + "Формуляр в формате MXL\";
			ПолноеИмяФайла = ИмяПодкаталогаMXL + ДанныеФайла.ИмяФайла;
			ПолноеИмяФайла = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ПолноеИмяФайла);
		КонецЕсли;
		ИмяПодкаталогаPDF = ИмяПодкаталога + "Формуляр в формате PDF\";
		
		ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		
		Если ДвоичныеДанныеФайла = Неопределено Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Документ %1 не был выгружен. Возможно, он помечен на удаление'"), Документ);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		ДвоичныеДанныеФайла.Записать(ПолноеИмяФайла);
		
		Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
			ДвоичныеДанныеФайлаPDF = ПолучитьИзВременногоХранилища(ДанныеФайлаPDF.СсылкаНаДвоичныеДанныеФайла);
			Если НЕ ДвоичныеДанныеФайла = Неопределено Тогда
				ИмяФайлаPDF = ИмяФайлаБезРасширения+".pdf";
				
				ПолноеИмяФайлаPDF = ИмяПодкаталогаPDF + ИмяФайлаPDF;
				ПолноеИмяФайлаPDF = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ПолноеИмяФайлаPDF);
				ДвоичныеДанныеФайлаPDF.Записать(ПолноеИмяФайлаPDF);
			КонецЕсли;
		КонецЕсли;
		
		Если ВыгружатьПрисоединеныеФайлы Тогда
			ВыгрузитьПрисоединенныеФайлы(РеквизитыДокументов[Документ].УчетныйДокумент, ИмяПодкаталога);
		
			ЗаписьZipФайла.Добавить(ИмяПодкаталога,
				РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
				РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
		Иначе
			ЗаписьZipФайла.Добавить(ПолноеИмяФайла);
			ЗаписьZipФайла.Добавить(ПолноеИмяФайлаPDF);
		КонецЕсли;
		
	КонецЦикла;
	
	ДвоичныеДанные = ЗаписьZipФайла.ПолучитьДвоичныеДанные();
	
	ФайловаяСистема.УдалитьВременныйКаталог(ИмяВременногоКаталога);
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФайла", ИмяАрхива);
	Результат.Вставить("АдресФайла", ПоместитьВоВременноеХранилище(ДвоичныеДанные));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ФайлВыгрузкиДокументовПодписейИPDF()
	
	ДокументыДляВыгрузки = Новый Массив;
	ДокументыДляВыгрузки.Добавить(Объект.Ссылка);
	
	ПерсональныеНастройки = ЭлектроннаяПодпись.ПерсональныеНастройки();
	СохранятьСертификатВместеСПодписью = ПерсональныеНастройки.СохранятьСертификатВместеСПодписью;
	
	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		ДокументыДляВыгрузки, "ОсновнойФайл, ОсновнойФайлPDF, Организация, УчетныйДокумент");
	
	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанных.ВызыватьИсключение = Ложь;
	
	ИмяВременногоКаталога = ФайловаяСистема.СоздатьВременныйКаталог();
	
	ИмяАрхива = СтрШаблон(НСтр("ru = 'Выгрузка от %1'"), Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy;")) + ".zip";
	
	ЗаписьZipФайла = Новый ЗаписьZipФайла();
	
	Для Каждого Документ Из ДокументыДляВыгрузки Цикл
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(РеквизитыДокументов[Документ].ОсновнойФайл, ПараметрыДанных);

		ОсновнойФайлPDF = РеквизитыДокументов[Документ].ОсновнойФайлPDF;
		ДанныеФайлаPDF = Неопределено;
		Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
			ДанныеФайлаPDF = РаботаСФайлами.ДанныеФайла(ОсновнойФайлPDF, ПараметрыДанных);
		КонецЕсли;
		
		ИмяФайлаБезРасширения = Сред(ДанныеФайла.ИмяФайла, 1, СтрДлина(ДанныеФайла.ИмяФайла) - 4);
		
		ИмяПодкаталога = ИмяВременногоКаталога + ИмяФайлаБезРасширения;
		ИмяПодкаталога = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяПодкаталога, Истина) + ПолучитьРазделительПути();
		
		ИмяПодкаталогаMXL = ИмяПодкаталога + "Формуляр в формате MXL\";
		ИмяПодкаталогаPDF = ИмяПодкаталога + "Формуляр в формате PDF\";
		
		ПолноеИмяФайлаКопииВPDF = ИмяПодкаталога + Сред(ДанныеФайла.ИмяФайла, 1, СтрДлина(ДанныеФайла.ИмяФайла) - 4) + " (копия).pdf";
		
		ПолноеИмяФайла = ИмяПодкаталогаMXL + ДанныеФайла.ИмяФайла;
		
		ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		
		Если ДвоичныеДанныеФайла = Неопределено Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Документ %1 не был выгружен. Возможно, он помечен на удаление'"), Документ);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		ДвоичныеДанныеФайла.Записать(ПолноеИмяФайла);
		
		Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
			ДвоичныеДанныеФайлаPDF = ПолучитьИзВременногоХранилища(ДанныеФайлаPDF.СсылкаНаДвоичныеДанныеФайла);
			Если НЕ ДвоичныеДанныеФайла = Неопределено Тогда
				ИмяФайлаPDF = ИмяФайлаБезРасширения+".pdf";
				
				ПолноеИмяФайлаPDF = ИмяПодкаталогаPDF + ИмяФайлаPDF;
				ПолноеИмяФайлаPDF = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ПолноеИмяФайлаPDF);
				ДвоичныеДанныеФайлаPDF.Записать(ПолноеИмяФайлаPDF);
			КонецЕсли;
		КонецЕсли;
		
		ЭлектронныеПодписиMXL = ВнутреннийЭДО.УстановленныеПодписи(РеквизитыДокументов[Документ].ОсновнойФайл);
		Для Каждого ЭлектроннаяПодписьФайла Из ЭлектронныеПодписиMXL Цикл
			Если ЭлектроннаяПодписьФайла.ПростаяПодпись = Истина Тогда
				Продолжить;
			КонецЕсли;
			ИмяФайлаПодписи = ИмяПодкаталогаMXL + ВнутреннийЭДОКлиентСервер.ИмяФайлаПодписиПоУмолчанию(ЭлектроннаяПодписьФайла, ПерсональныеНастройки);
			ИмяФайлаПодписи = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяФайлаПодписи);
			ЭлектроннаяПодписьФайла.Подпись.Записать(ИмяФайлаПодписи);
			Если СохранятьСертификатВместеСПодписью Тогда
				ИмяФайлаСертификата = ИмяПодкаталогаMXL + ВнутреннийЭДОКлиентСервер.ИмяФайлаСертификатаПоУмолчанию(ЭлектроннаяПодписьФайла, СтрДлина(ИмяПодкаталогаMXL));
				ИмяФайлаСертификата = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяФайлаСертификата);
				ЭлектроннаяПодписьФайла.Сертификат.Записать(ИмяФайлаСертификата);
			КонецЕсли;
		КонецЦикла;
		
		ЭлектронныеПодписиPDF = ВнутреннийЭДО.УстановленныеПодписи(РеквизитыДокументов[Документ].ОсновнойФайлPDF);
		Для Каждого ЭлектроннаяПодписьФайла Из ЭлектронныеПодписиPDF Цикл
			Если ЭлектроннаяПодписьФайла.ПростаяПодпись = Истина Тогда
				Продолжить;
			КонецЕсли;
			ИмяФайлаПодписи = ИмяПодкаталогаPDF + ВнутреннийЭДОКлиентСервер.ИмяФайлаПодписиПоУмолчанию(ЭлектроннаяПодписьФайла, ПерсональныеНастройки);
			ИмяФайлаПодписи = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяФайлаПодписи);
			ЭлектроннаяПодписьФайла.Подпись.Записать(ИмяФайлаПодписи);
			Если СохранятьСертификатВместеСПодписью Тогда
				ИмяФайлаСертификата = ИмяПодкаталогаPDF + ВнутреннийЭДОКлиентСервер.ИмяФайлаСертификатаПоУмолчанию(ЭлектроннаяПодписьФайла, СтрДлина(ИмяПодкаталогаPDF));
				ИмяФайлаСертификата = ВнутреннийЭДОКлиентСервер.УникальноеИмяФайла(ИмяФайлаСертификата);
				ЭлектроннаяПодписьФайла.Сертификат.Записать(ИмяФайлаСертификата);
			КонецЕсли;
		КонецЦикла;
		
		СохраненныйТабличныйДокумент = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанныеФайла);
		СохраненныйТабличныйДокумент.АвтоМасштаб = Истина;
		ВнутреннийЭДО.ДобавитьШтампыЭлектронныхПодписей(
			СохраненныйТабличныйДокумент, ЭлектронныеПодписи, РеквизитыДокументов[Документ].Организация);
		СохраненныйТабличныйДокумент.Записать(ПолноеИмяФайлаКопииВPDF, ТипФайлаТабличногоДокумента.PDF_A_3);
		
		ВыгрузитьПрисоединенныеФайлы(РеквизитыДокументов[Документ].УчетныйДокумент, ИмяПодкаталога);
		
		ЗаписьZipФайла.Добавить(ИмяПодкаталога,
			РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
			РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
		
	КонецЦикла;
	
	ДвоичныеДанные = ЗаписьZipФайла.ПолучитьДвоичныеДанные();
	
	ФайловаяСистема.УдалитьВременныйКаталог(ИмяВременногоКаталога);
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяФайла", ИмяАрхива);
	Результат.Вставить("АдресФайла", ПоместитьВоВременноеХранилище(ДвоичныеДанные));
	
	Возврат Результат;
	
КонецФункции	

&НаКлиенте
Процедура ПродолжитьВыгрузку(ФайлВыгрузки)
	
	Оповещение = Новый ОписаниеОповещения("СохранитьДокументПослеПолученияФайла", ЭтотОбъект, Неопределено);
	
	Фильтр = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Файлы %1 (*.%1)|*.%1|Все файлы (*.*)|*.*'"),
		"zip");
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохранения.Диалог.Фильтр = Фильтр;
	ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Выберите файл для сохранения данных'");
	
	ФайловаяСистемаКлиент.СохранитьФайл(
		Оповещение, ФайлВыгрузки.АдресФайла, ФайлВыгрузки.ИмяФайла, ПараметрыСохранения);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДокументИПодписи(Команда)

	ФайлВыгрузки = ФайлВыгрузкиДокументовПодписейИPDF();

	ПродолжитьВыгрузку(ФайлВыгрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПодпись(Команда)
	
	ТекущиеДанные = Элементы.ЭлектронныеПодписи.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ПростаяПодпись Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Команда не может быть выполнена для простой подписи'"));
		Возврат;
	КонецЕсли;
	
	ПерсональныеНастройки = ЭлектроннаяПодписьКлиент.ПерсональныеНастройки();
	
	ИмяФайла = ВнутреннийЭДОКлиентСервер.ИмяФайлаПодписиПоУмолчанию(ТекущиеДанные, ПерсональныеНастройки);
	
	Оповещение = Новый ОписаниеОповещения("СохранитьПодписьПослеПолученияФайла", ЭтотОбъект, Неопределено);
	Фильтр = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Файлы электронных подписей (*.%1)|*.%1|Все файлы (*.*)|*.*'"),
		ЭлектроннаяПодписьКлиент.ПерсональныеНастройки().РасширениеДляФайловПодписи);
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохранения.Диалог.Фильтр = Фильтр;
	ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Выберите файл для сохранения подписи'");
	
	ФайловаяСистемаКлиент.СохранитьФайл(Оповещение, ТекущиеДанные.АдресПодписи, ИмяФайла, ПараметрыСохранения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПодпись(Команда)
	
	ТекущиеДанные = Элементы.ЭлектронныеПодписи.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ПростаяПодпись Тогда
		ВнутреннийЭДОКлиент.ОткрытьПростуюПодпись(ТекущиеДанные);
	ИначеЕсли ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ЭлектроннаяПодпись") Тогда
		ЭлектроннаяПодписьКлиент.ОткрытьПодпись(ТекущиеДанные);
	КонецЕсли;
	
	ОткрытьПодписьДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьМаршрут(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Маршрут", ДеревоМаршрута);
	
	ОткрытьФорму("Справочник.МаршрутыПодписанияБГУ.Форма.ВыборИзДокумента", ПараметрыФормы, Элементы.ДеревоМаршрута);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьМаршрут(Команда)
	
	Если МаршрутМожноЗаписать() Тогда
		ЗаписатьМаршрутНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьИзменениеМаршрута(Команда)
	
	МаршрутИзменен = Ложь;
	МаршрутИзмененПолностью = Ложь;
	
	ЗаполнитьДеревоМаршрута();
	
	ОбновитьСоставКомандДействий();
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКомментарийПоДокументу(Команда)
	
	Объект.Комментарий = УчетныйДокументПолучитьОписание(Объект.УчетныйДокумент);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УчетныйДокументПолучитьОписание(УчетныйДокумент)
	
	Если ТипЗнч(УчетныйДокумент) = Тип("ДокументСсылка.РегистрУчета") Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетныйДокумент, "Описание");
	Иначе
		Возврат Строка(УчетныйДокумент);
	КонецЕсли;	
	
КонецФункции

&НаКлиенте
Процедура ОбновитьАктуальность(Команда)
	ОбновитьАктуальностьДокумента();	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточкуФайла(Команда)
	
	ТекущиеДанные = Элементы.ПрисоединенныеФайлы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ТекущиеДанные.Файл);
	
	РаботаСФайламиКлиент.ОткрытьФормуФайла(ТекущиеДанные.Файл,, ПараметрыФормы);
	
КонецПроцедуры

 &НаКлиенте
Процедура ОткрытьФайлДляПросмотра(Команда)
	
	ТекущаяСтрока = Элементы.ПрисоединенныеФайлы.ТекущаяСтрока;
	ОткрытьЭлектронныйДокументФайла(ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКакВнешнийЭД(Команда)

	ОткрытьВнешнийЭлектронныйДокументФайла();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКакВнешнийЭДКопию(Команда)

	ОткрытьВнешнийЭлектронныйДокументСКопиейФайла();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТекущиеДелаЭДО(Команда)
	
	ВнутреннийЭДОКлиент.ОткрытьТекущиеДелаЭДО();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьЗаголовокФормы();
	
	ЗаполнитьМаршрутИзНастройки();
	
	ОбновитьСостояниеДокумента();
	
	ВывестиПредставлениеДокумента();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеДокумента()
	
	ЗаполнитьСостояниеДокумента();
	
	ЗаполнитьДеревоМаршрута();
	
	ЗаполнитьСписокПодписей();
	
	ОбновитьНаличиеНеактуальныхВерсий();
	
	ОбновитьСоставКомандДействий();
	
	УправлениеВидимостьюЭлементовФормы();
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Процедура ПриОбновленииСостоянияВнутреннегоЭД()
	
	ОбновитьСостояниеДокумента();
	
	ВывестиПредставлениеДокумента();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСостояниеДокумента()
	
	ОписаниеСостояния = "";
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		СостояниеДокумента = ВнутреннийЭДО.СостояниеЭлектронногоДокумента(Объект.Ссылка);
		Состояние = СостояниеДокумента.Состояние;
		ОписаниеСостояния = СостояниеДокумента.Комментарий;
		Актуальный = СостояниеДокумента.Актуальный;
	Иначе
		Актуальный = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Состояние) Тогда
		Состояние = ВнутреннийЭДО.НачальноеСостояниеДокумента();
	КонецЕсли;
	
	ПредставлениеСостояния = Строка(Состояние);
	Если ЗначениеЗаполнено(ОписаниеСостояния) Тогда
		ПредставлениеСостояния = ПредставлениеСостояния + ": " + ОписаниеСостояния;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМаршрутИзНастройки()
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ТекМаршрутПодписания = РегистрыСведений.НастройкиВнутреннегоЭДОБГУ.МаршрутИзНастройкиВнутреннегоЭДОБГУ(
		Объект.Организация, Объект.УчетныйДокумент, Объект.ИдентификаторКомандыПечати);
		
	Если ЗначениеЗаполнено(ТекМаршрутПодписания) Тогда
		МаршрутПодписания = ТекМаршрутПодписания;
		ПредставлениеМаршрута = Строка(МаршрутПодписания);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоМаршрута()
	
	Если Объект.Ссылка.Пустая() ИЛИ МаршрутИзмененПолностью Тогда
		Если НЕ ЗначениеЗаполнено(МаршрутПодписания) И ДеревоМаршрута.ПолучитьЭлементы().Количество() > 0 Тогда
			СоставМаршрута = Неопределено;
			ВнутреннийЭДО.ЗаполнитьТаблицуСоставМаршрутаПоДереву(РеквизитФормыВЗначение("ДеревоМаршрута"), СоставМаршрута);
		Иначе
			СоставМаршрута = ВнутреннийЭДО.СоставМаршрутаПодписания(МаршрутПодписания);
		КонецЕсли;
		ВнутреннийЭДОПереопределяемый.ПроверитьСоставМаршрутаНовогоДокумента(Объект.УчетныйДокумент, СоставМаршрута, Объект);
	Иначе
		СоставМаршрута = ВнутреннийЭДО.СоставМаршрутаПодписанияДокумента(Объект.Ссылка);
	КонецЕсли;
	
	ВнутреннийЭДО.ЗаполнитьДеревоМаршрутаНаФорме(ЭтотОбъект, СоставМаршрута, "ДеревоМаршрута", "Подписант");
	
	ЗаполнитьКартинкиСостоянийДереваМаршрута(ДеревоМаршрута);
	
	ЗаполнитьТаблицуПодписантовИСостоянийПоДеревуМаршрута();
	
	ЗаполнитьВидПодписиТекущегоПользователя();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКартинкиСостоянийДереваМаршрута(УзелДерева)
	
	Для Каждого СтрокаДерева Из УзелДерева.ПолучитьЭлементы() Цикл
		
		Если СтрокаДерева.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание") Тогда
			Если Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяУточнение") Тогда
				СтрокаДерева.СостояниеКартинка = 3;
			ИначеЕсли Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.Аннулирован") Тогда
				СтрокаДерева.СостояниеКартинка = 6;
			Иначе
				СтрокаДерева.СостояниеКартинка = 0;
			КонецЕсли;
		ИначеЕсли СтрокаДерева.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.Завершен") Тогда
			СтрокаДерева.СостояниеКартинка = 1;
		ИначеЕсли СтрокаДерева.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ЗакрытПринудительно") Тогда
			СтрокаДерева.СостояниеКартинка = 2;
		ИначеЕсли СтрокаДерева.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяУточнение") Тогда
			СтрокаДерева.СостояниеКартинка = 5;
		ИначеЕсли СтрокаДерева.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.Аннулирован") Тогда
			СтрокаДерева.СостояниеКартинка = 4;
		ИначеЕсли СтрокаДерева.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.НеНачат") Тогда
			СтрокаДерева.СостояниеКартинка = 6;
		Иначе
			СтрокаДерева.СостояниеКартинка = 6;
		КонецЕсли;
		
		ЗаполнитьКартинкиСостоянийДереваМаршрута(СтрокаДерева);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеУчетногоДокумента()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПредставлениеУчетногоДокумента = ОбщегоНазначения.ПредметСтрокой(Объект.УчетныйДокумент);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиПредставлениеДокумента()
	
	Если Объект.Ссылка.Пустая()
		И НЕ ЗначениеЗаполнено(АдресОсновногоФайла) Тогда
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанные = ДвоичныеДанныеЭлектронногоДокумента();
	
	Если ДвоичныеДанные = Неопределено Тогда
		
		ТабличныйДокументОсновной.Очистить();
		АдресОсновногоФайла = "";
		АдресТабличногоДокумента = "";
		
		ТекстСообщения = НСтр("ru = 'Не удалось получить данные документа, так как он помечен на удаление.
			|Для продолжения работы с документом необходимо снять пометку удаления.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Возврат;
		
	КонецЕсли;
	
	АдресОсновногоФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
	
	ТабличныйДокументОсновной = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанные);
	
	Если ТабличныйДокументОсновной.ВысотаТаблицы = 0 Тогда 
		ТекстСообщения = НСтр("ru = 'Не удалось получить данные электронного документа.
		|Для продолжения работы с документом необходимо проверить наличие и корректность файла электронного документа.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;	
	КонецЕсли;
	
	АдресТабличногоДокумента = ПоместитьВоВременноеХранилище(ТабличныйДокументОсновной, УникальныйИдентификатор);
	
	ВнутреннийЭДО.ДобавитьШтампыЭлектронныхПодписей(ТабличныйДокументОсновной, ЭлектронныеПодписи, Объект.Организация);

	Если ВнутреннийЭДО.ПоддерживаетсяИнтеграцияСБЭД() Тогда
		ЭлектронныеПодписиВнешнегоЭД = Новый ТаблицаЗначений;
		ЭлектронныеПодписиВнешнегоЭД.Колонки.Добавить("ЭлектронныйДокумент");
		ЭлектронныеПодписиВнешнегоЭД.Колонки.Добавить("ТипФайлаФормуляра");
		ЭлектронныеПодписиВнешнегоЭД.Колонки.Добавить("СостояниеЭДО");
	
		ВнутреннийЭДО.ЗаполнитьЭлектронныеПодписиВнешнегоЭДСвязанногоСВнутреннимЭД(Объект.Ссылка, ЭлектронныеПодписиВнешнегоЭД);
		
		Если ЭлектронныеПодписиВнешнегоЭД.Количество() > 0 Тогда
			ВыводитьДатуПодписи = Ложь;
			
			ОтображатьДатуПодписанияПоОрганизации = Истина;
			ВнутреннийЭДО.ЗаполнитьНастройкуОтображатьДатуПодписанияПоОрганизации(Объект.Организация, ОтображатьДатуПодписанияПоОрганизации);
			
			Если Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭП.Получить() = Истина 
				И ОтображатьДатуПодписанияПоОрганизации Тогда
				ВыводитьДатуПодписи = Истина;
			КонецЕсли;

			ВнутреннийЭДО.ДобавитьШтампыЭлектронныхПодписейВнешнегоЭД(ТабличныйДокументОсновной, 
				ЭлектронныеПодписиВнешнегоЭД, Объект.Организация, ВыводитьДатуПодписи);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДвоичныеДанныеЭлектронногоДокумента()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат ПолучитьИзВременногоХранилища(АдресОсновногоФайла);
	Иначе
		Возврат РаботаСФайлами.ДвоичныеДанныеФайла(Объект.ОсновнойФайл, Ложь);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура СохранитьДокументПослеПолученияФайла(ПолученныеФайлы, Контекст) Экспорт
	
	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Документ сохранен в файл:'"), , ПолученныеФайлы[0].Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДокументИПодписиПослеПолученияФайла(ПолученныеФайлы, Контекст) Экспорт
	
	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПолноеИмя = ПолученныеФайлы[0].ПолноеИмя;
	
	СимволРазделителя = ПолучитьРазделительПути();
	ПозицияРазделителя = СтрНайти(ПолноеИмя, СимволРазделителя, НаправлениеПоиска.СКонца);
	Если ПозицияРазделителя = 0 Тогда
		СимволРазделителя = ?(СимволРазделителя = "/", "\", "/");
		ПозицияРазделителя = СтрНайти(ПолноеИмя, СимволРазделителя, НаправлениеПоиска.СКонца);
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Данные сохранены в папку:'"), , Лев(ПолноеИмя, ПозицияРазделителя));
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПодписьПослеПолученияФайла(ПолученныеФайлы, Контекст) Экспорт
	
	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Электронная подпись сохранена в файл:'"), , ПолученныеФайлы[0].Имя);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	СвойстваПредставления = Новый Структура;
	СвойстваПредставления.Вставить("ВидДокумента", Объект.ВидДокумента);
	СвойстваПредставления.Вставить("НомерДокумента", Объект.НомерДокумента);
	СвойстваПредставления.Вставить("ДатаДокумента", Объект.ДатаДокумента);
	
	Заголовок = ВнутреннийЭДОКлиентСервер.ПредставлениеДокументаПоСвойствам(
		СвойстваПредставления, Объект.Ссылка.Пустая());
	
КонецПроцедуры

&НаСервере
Процедура УправлениеВидимостьюЭлементовФормы()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "Записать", "Видимость", Объект.Ссылка.Пустая());
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "МаршрутПодписания", "Видимость", Объект.Ссылка.Пустая() И МаршрутИзНастройки.Пустая());
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ПоказатьКомментарийСостояния", "Видимость", ЗначениеЗаполнено(ОписаниеСостояния));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "Сравнить", "Видимость", НЕ ДокументАктуален);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СохранитьДокумент", "Видимость", НЕ Объект.Ссылка.Пустая());
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СохранитьДокументИПодписи", "Видимость", НЕ Объект.Ссылка.Пустая());
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СохранитьДокументPDF", "Видимость", НЕ Объект.Ссылка.Пустая());
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "НеактуальныеДокументы", "Видимость", ЕстьНеактуальныеВерсии);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ИзменитьМаршрут", "Видимость",
		НЕ Объект.Ссылка.Пустая()
		И ПользователюРазрешеноИзменениеМаршрута()
		И (Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание")
			ИЛИ Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяУточнение"))
		И ЭлектронныеПодписи.Количество() = 0);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЗаписатьМаршрут", "Видимость",
		НЕ Объект.Ссылка.Пустая()
		И ПользователюРазрешеноИзменениеМаршрута()
		И (Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание")
			ИЛИ Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяУточнение")));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ОтменитьИзменениеМаршрута", "Видимость",
		НЕ Объект.Ссылка.Пустая()
		И ПользователюРазрешеноИзменениеМаршрута()
		И (Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание")
			ИЛИ Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяУточнение")));
			
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЗаполнитьКомментарийПоДокументу", "Видимость", Объект.Ссылка.Пустая());				
		
КонецПроцедуры

