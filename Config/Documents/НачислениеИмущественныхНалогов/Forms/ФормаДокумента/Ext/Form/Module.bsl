&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОграничениеТипаДокументаОснования(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы; 

	МассивТипов = Новый Массив;
	
	ИмяДокумента = ИмяДокументаПоВидуНалога(Объект.ВидНалога);
	
	Если ИмяДокумента = Неопределено Тогда
		МассивТипов.Добавить(Тип("Неопределено"));
	Иначе	
		МассивТипов.Добавить(Тип(СтрШаблон("ДокументСсылка.%1", ИмяДокумента)));
	КонецЕсли;
	
	ОграничениеТипаДокументаОснования = Новый ОписаниеТипов(МассивТипов);
	
	Элементы.ДокументОснование.ОграничениеТипа = ОграничениеТипаДокументаОснования;
	Объект.ДокументОснование = ОграничениеТипаДокументаОснования.ПривестиЗначение(Объект.ДокументОснование);
 	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДокументаОснования(Форма)

	Объект   = Форма.Объект;
	Элементы = Форма.Элементы; 

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументОснование",
		"Доступность", ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.ВидНалога));

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаполнитьПоДокументуОснованию",
		"Доступность", ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.ВидНалога));

КонецПроцедуры

// Управление видимостью раздела лицевого счета
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения -
//
&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьРазделЛицевогоСчета(Форма)

	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РазделЛицевогоСчета",
		"Видимость", Объект.РазделЛицевогоСчетаВТаблице = 0);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДвиженияДокументаРазделЛицевогоСчета",
		"Видимость", Объект.РазделЛицевогоСчетаВТаблице = 1);
	
КонецПроцедуры

// Управление видимостью страницы Данные расчета
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения -
//
&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьГруппаДанныеРасчета(Форма)

	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ВидимостьБыла = Элементы.ГруппаДанныеРасчета.Видимость;

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДанныеРасчета",
		"Видимость", ЗначениеЗаполнено(Объект.ДокументОснование));
	
	Если ВидимостьБыла <> Элементы.ГруппаДанныеРасчета.Видимость Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаБухгалтерскийУчет;
	КонецЕсли;
	
	Если Элементы.ГруппаДанныеРасчета.Видимость Тогда
		
		ВидимостьКБКНалога = Объект.ВидНалога = ПредопределенноеЗначение("Перечисление.ВидыИмущественныхНалогов.ЗемельныйНалог");
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "УчетныеДанныеОСКБК",
			"Видимость", ВидимостьКБКНалога);
	
	КонецЕсли;
	
КонецПроцедуры

// Управление видимостью предупреждающей надписи Сумма к распределению.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения -
//
&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьСуммаКРаспределению(Форма)

	Объект   = Форма.Объект; 
	Элементы = Форма.Элементы;
	
	Видимость = ЗначениеЗаполнено(Объект.ДокументОснование) И Объект.УчетныеДанныеОС.Количество() > 0
		И Объект.ДвиженияДокумента.Итог("Сумма") <> Объект.УчетныеДанныеОС.Итог("Сумма");
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаСуммаКРаспределению",
		"Видимость", Видимость);
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УчетныеДанныеОСОсновноеСредство");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор, "Объект.УчетныеДанныеОС.ОсновноеСредство",,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",      НСтр("ru = 'по всем'"));
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УчетныеДанныеОСИнвентарныйНомер");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор, "Объект.УчетныеДанныеОС.ИнвентарныйНомер",,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",      НСтр("ru = 'по всем'"));
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКэшПараметровНалогПоУмолчанию()

	НалогиПоУмолчанию = Новый Соответствие;
	НалогиПоУмолчанию.Вставить(Перечисления.ВидыИмущественныхНалогов.ТранспортныйНалог,
		Справочники.ВидыНалоговИПлатежей.Транспортный);
	НалогиПоУмолчанию.Вставить(Перечисления.ВидыИмущественныхНалогов.НалогНаИмущество,
		Справочники.ВидыНалоговИПлатежей.ИмуществоОрганизаций);
		
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВидНалогаИлиПлатежаПоУмолчанию",
		НалогиПоУмолчанию[Объект.ВидНалога]);
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("НалогСборПлатежПоУмолчанию",
		НалогСборПлатежПоУмолчанию(Объект.Организация, НалогиПоУмолчанию[Объект.ВидНалога]));

КонецПроцедуры

// Возвращает подходящее значение по виду налога и организации
//
// Параметры:
//  Организация  		- СправочникСсылка.Организации
//  ВидНалогаИлиПлатежа - СправочникСсылка.ВидНалогаИлиПлатежа
//
// Возвращаемое значение:
//   СправочникСсылка.НалогиИПлатежиОрганизации
//
&НаСервереБезКонтекста
Функция НалогСборПлатежПоУмолчанию(Знач Организация, Знач ВидНалогаИлиПлатежа)
	
	Возврат Справочники.НалогиИПлатежиОрганизации.НалогСборПлатежПоУмолчанию(Организация, ВидНалогаИлиПлатежа); 
	
КонецФункции

// Возвращает рекомендуемый КПС для учета налога по объекту налогообложения.
//
// Параметры:
//  ВидНалога	- ПеречислениеСсылка.ВидыИмущественныхНалогов
//  КПС 		- СправочникСсылка.КлассификационныеПризнакиСчетов - КПС объекта налогообложения
//  Дата 		- Дата
//
// Возвращаемое значение:
//   СправочникСсылка.КлассификационныеПризнакиСчетов - Рекомендуемый КПС
//
&НаСервереБезКонтекста
Функция КПСУчетаНалогаПоУмолчанию(Знач ВидНалога, Знач КПС, Знач Дата)

	Возврат 
		УправлениеОсновнымиСредствами.КПСУчетаНалогаПоУмолчанию(ВидНалога, КПС, Дата);

КонецФункции 

// Возвращает имя документа по виду налога.
//
// Параметры:
//  ВидНалога 	- ПеречислениеСсылка.ВидыИмущественныхНалогов
//
// Возвращаемое значение:
//   Строка, Неопределено
//
&НаКлиентеНаСервереБезКонтекста
Функция ИмяДокументаПоВидуНалога(ВидНалога)
	
	Если ВидНалога = ПредопределенноеЗначение("Перечисление.ВидыИмущественныхНалогов.ТранспортныйНалог") Тогда
		ИмяДокумента = "РасчетТранспортногоНалога";
	ИначеЕсли ВидНалога = ПредопределенноеЗначение("Перечисление.ВидыИмущественныхНалогов.ЗемельныйНалог") Тогда
		ИмяДокумента = "РасчетЗемельногоНалога";
	ИначеЕсли ВидНалога = ПредопределенноеЗначение("Перечисление.ВидыИмущественныхНалогов.НалогНаИмущество") Тогда
		ИмяДокумента = "РасчетНалогаНаИмущество";
	Иначе
		ИмяДокумента = Неопределено;
	КонецЕсли;

	Возврат ИмяДокумента;
КонецФункции 

