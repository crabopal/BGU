&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("КЭКПоУмолчанию",
		БухгалтерскийУчетПовтИсп.КЭКПоКоду("291"));

	ОбновитьКэшПараметровНалогПоУмолчанию();
		
	УстановитьОграничениеТипаДокументаОснования(ЭтотОбъект);
	УстановитьДоступностьДокументаОснования(ЭтотОбъект);

	ВидимостьРазделЛицевогоСчета(ЭтотОбъект);
	ВидимостьГруппаДанныеРасчета(ЭтотОбъект);
	ВидимостьСуммаКРаспределению(ЭтотОбъект);

	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

#Область ЗаполнениеДокумента

&НаКлиенте
Процедура ВыбратьДокументОснованиеИПродолжитьЗаполнение()
	
	ИмяДокумента = ИмяДокументаПоВидуНалога(Объект.ВидНалога);
	
	Если ИмяДокумента = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	СтруктураОтбора	= Новый Структура;
	СтруктураОтбора.Вставить("Организация",	Объект.Организация);
	СтруктураОтбора.Вставить("ПометкаУдаления",	Ложь);
	
	СтруктураПараметров	= Новый Структура;
	СтруктураПараметров.Вставить("Отбор",              СтруктураОтбора);
	СтруктураПараметров.Вставить("РежимВыбора",        Истина);
	СтруктураПараметров.Вставить("МножественныйВыбор", Ложь);
	
	ОткрытьФорму(СтрШаблон("Документ.%1.ФормаВыбора", ИмяДокумента), СтруктураПараметров, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуОснованиюНаСервере()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьПоРасчетуИмущественногоНалога();
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");

	ВидимостьРазделЛицевогоСчета(ЭтотОбъект);
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	ВидимостьСуммаКРаспределению(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ДанныеСтроки)
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Дата", Объект.Дата);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("ИФО", ДанныеСтроки.ИФО);
	ПараметрыФормы.Вставить("КФО", ДанныеСтроки.КФО);
	
	ПараметрыФормы.Вставить("КПС", 
		?(ЗначениеЗаполнено(ДанныеСтроки.КПСДт), ДанныеСтроки.КПСДт, ДанныеСтроки.КПС));
	
	ПараметрыФормы.Вставить("Подразделение", 
		?(ЗначениеЗаполнено(ДанныеСтроки.ПодразделениеДт), ДанныеСтроки.ПодразделениеДт, ДанныеСтроки.Подразделение));
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО", 		Истина);
	ПараметрыФормы.Вставить("ТолькоПросмотрКПС", 		Ложь);
	ПараметрыФормы.Вставить("ТолькоПросмотрКЭК", 		Ложь);
	ПараметрыФормы.Вставить("ВидимостьКПС", 			Истина);
	ПараметрыФормы.Вставить("ВидимостьКЭК", 			Ложь);
	ПараметрыФормы.Вставить("ВидимостьПодразделение", 	Истина);
	ПараметрыФормы.Вставить("ВидимостьКоличество", 		Ложь);
	
	// Бухгалтерский учет
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.СчетДт);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.СубконтоДт1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.СубконтоДт2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.СубконтоДт3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", 			НСтр("ru = 'Настройка отражения расходов в учете'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет", 			НСтр("ru = 'Счет дебета'"));
	ПараметрыФормы.Вставить("ЗаголовокПодразделение", 	НСтр("ru = 'Подразделение дебета'"));
	
	ПараметрыСчета = Новый Структура;
	ПараметрыСчета.Вставить("ОграниченияСписокСчетов", 
		БухгалтерскийУчетКлиентСервер.СписокСчетов("106.00,109.00,110.00,401.20", Объект.Дата, , Объект.Организация));
	ПараметрыСчета.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
	ПараметрыСчета.Вставить("Организация", 			Объект.Организация);
	ПараметрыСчета.Вставить("ИФО", 					ДанныеСтроки.ИФО);
	ПараметрыФормы.Вставить("ПараметрыСчета", 		ПараметрыСчета);
	
	ПараметрыФормы.Вставить("ЕстьНДС", Ложь);
	ПараметрыФормы.Вставить("НДСКРаспределению", Ложь);
	ПараметрыФормы.Вставить("СчетУчетаНДС", Неопределено);

	ПараметрыФормы.Вставить("Валюта", ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	
	// Налоговый учет
	ПараметрыФормы.Вставить("СчетНУ",      ДанныеСтроки.СчетНУ);
	ПараметрыФормы.Вставить("СубконтоНУ1", ДанныеСтроки.СубконтоНУ1);
	ПараметрыФормы.Вставить("СубконтоНУ2", ДанныеСтроки.СубконтоНУ2);
	ПараметрыФормы.Вставить("СубконтоНУ3", ДанныеСтроки.СубконтоНУ3);
	
	ПараметрыСчетаНУ = Новый Структура("ОграниченияСписокСчетов",
		БухгалтерскийУчетКлиентСервер.СписокСчетов("Н08,Н15,Н20,Н25,Н26,Н44,Н91.02", Объект.Дата, , Объект.Организация));
	ПараметрыФормы.Вставить("ПараметрыСчетаНУ", ПараметрыСчетаНУ);
	
	// УСН
	ПараметрыФормы.Вставить("ОтражениеВУСН", ДанныеСтроки.ОтражениеВУСН);
	Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		ПараметрыФормы.Вставить("ЕстьНалоговыйУчет", Ложь);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ОтразитьВКарточкеКапвложений", ДанныеСтроки.ОтразитьВКарточкеКапвложений);
	ПараметрыФормы.Вставить("КарточкаКапвложений", ДанныеСтроки.КарточкаКапвложений);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияВУчетеНаКлиенте(СтруктураОтражениеВУчете)
	
	ТекущиеДанные = Элементы.ДвиженияДокумента.ТекущиеДанные;
 
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураОтражениеВУчете,, "КФО, КПС, КЭК"); 
	
	Если НЕ ТекущиеДанные.КПС = СтруктураОтражениеВУчете.КПС Тогда
		ТекущиеДанные.КПСДт = СтруктураОтражениеВУчете.КПС;
	Иначе
		ТекущиеДанные.КПСДт = Неопределено;
	КонецЕсли;
	
	Если НЕ ТекущиеДанные.Подразделение = СтруктураОтражениеВУчете.Подразделение Тогда
		ТекущиеДанные.ПодразделениеДт = СтруктураОтражениеВУчете.Подразделение;
	Иначе
		ТекущиеДанные.ПодразделениеДт = Неопределено;
	КонецЕсли;
	
	ТекущиеДанные.СчетДт      = СтруктураОтражениеВУчете.Счет;
	ТекущиеДанные.СубконтоДт1 = СтруктураОтражениеВУчете.Субконто1;
	ТекущиеДанные.СубконтоДт2 = СтруктураОтражениеВУчете.Субконто2;
	ТекущиеДанные.СубконтоДт3 = СтруктураОтражениеВУчете.Субконто3;
	
	ОбновитьТекстОтражениеВУчете(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, ТекущиеДанные);

	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРаспределенияПоИсточникам()
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	АдресВременногоХранилища = ПоместитьВоВременноеХранилищеУчетныеДанныеОС();
	
	ПараметрыЗакрытияФормы = Новый Структура;
	ПараметрыЗакрытияФормы.Вставить("АдресВременногоХранилища", АдресВременногоХранилища);
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("АдресВременногоХранилища", АдресВременногоХранилища);
	ПараметрыОткрытияФормы.Вставить("ТолькоПросмотр", 			ТолькоПросмотр);
	ПараметрыОткрытияФормы.Вставить("Дата",
		?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата));
	ПараметрыОткрытияФормы.Вставить("Организация", 				Объект.Организация);
	ПараметрыОткрытияФормы.Вставить("ВидНалога", 				Объект.ВидНалога);
	ПараметрыОткрытияФормы.Вставить("ДокументОснование", 		Объект.ДокументОснование);
	ПараметрыОткрытияФормы.Вставить("РазделЛицевогоСчетаВТаблице", Объект.РазделЛицевогоСчетаВТаблице);
	
	ПараметрыОткрытияФормы.Вставить("КэшПараметров", 			Новый Структура);
	ПараметрыОткрытияФормы.КэшПараметров.Вставить("ВалютаРегламентированногоУчета",
		ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	ПараметрыОткрытияФормы.КэшПараметров.Вставить("ИспользоватьУчетПоИФО",
		ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО);
		
	ПараметрыОткрытияФормы.КэшПараметров.Вставить("УчетнаяПолитика", Новый Структура);
	ПараметрыОткрытияФормы.КэшПараметров.УчетнаяПолитика.Вставить("ПлательщикНалогаНаПрибыль",
		ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль);
 	ПараметрыОткрытияФормы.КэшПараметров.УчетнаяПолитика.Вставить("ПрименяетсяУСНДоходыМинусРасходы",
		ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы);
		
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ЗаполнитьРаспределениеПоИсточникам",
		ЭтотОбъект, ПараметрыЗакрытияФормы);
	
	ОткрытьФорму("Обработка.РаспределениеНалогаПоИсточникамФинансирования.Форма.Форма", ПараметрыОткрытияФормы, , , , ,
		ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры
	
&НаКлиенте
Процедура ЗаполнитьРаспределениеПоИсточникам(РезультатЗакрытия, ПараметрыЗакрытияФормы) Экспорт

	Если РезультатЗакрытия = "ПеренестиВДокумент" Тогда
		
		АдресВременногоХранилища = ПараметрыЗакрытияФормы.АдресВременногоХранилища;
		ЗаполнитьРаспределениеПоИсточникамСервере(ПараметрыЗакрытияФормы.АдресВременногоХранилища);
		Модифицированность = Истина;
		
	КонецЕсли;

КонецПроцедуры
	
&НаСервере
Функция ПоместитьВоВременноеХранилищеУчетныеДанныеОС()

	ТаблицыРаспределения = Новый Структура;
	ТаблицыРаспределения.Вставить("УчетныеДанныеОС", Объект.УчетныеДанныеОС.Выгрузить());
	ТаблицыРаспределения.Вставить("ПорядокОтраженияВУчете", Объект.ПорядокОтраженияВУчете.Выгрузить());

	Возврат ПоместитьВоВременноеХранилище(ТаблицыРаспределения, УникальныйИдентификатор);

КонецФункции 

&НаСервере
Процедура ЗаполнитьРаспределениеПоИсточникамСервере(АдресВременногоХранилища)

	ТаблицыРаспределения = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
    Объект.УчетныеДанныеОС.Загрузить(ТаблицыРаспределения.УчетныеДанныеОС);
    Объект.ПорядокОтраженияВУчете.Загрузить(ТаблицыРаспределения.ПорядокОтраженияВУчете);
	
	ТаблицаБухгалтерскийУчет = Документы.НачислениеИмущественныхНалогов.СформироватьТаблицуБухгалтерскийУчет(
		ТаблицыРаспределения.ПорядокОтраженияВУчете);
	
	Объект.ДвиженияДокумента.Загрузить(ТаблицаБухгалтерскийУчет);

	ЗаполнитьДобавленныеКолонкиТаблиц();
	ВидимостьСуммаКРаспределению(ЭтотОбъект);

КонецПроцедуры 

#КонецОбласти

#Область ЗаполнениеДобавленныхКолонок

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()

	Для Каждого СтрокаТаблицы Из Объект.ДвиженияДокумента Цикл
		ОбновитьТекстОтражениеВУчете(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, СтрокаТаблицы);
	КонецЦикла;

	Для Каждого СтрокаТаблицы Из Объект.УчетныеДанныеОС Цикл
		ОбновитьДобавленныеКолонкиУчетныеДанныеОС(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры
		
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчете(УчетнаяПолитика, СтрокаТаблицы)
	
	ПоляФормы = Новый Структура;
	ПоляФормы.Вставить("КПС",			"КПСДт");
	ПоляФормы.Вставить("Подразделение",	"ПодразделениеДт");
	ПоляФормы.Вставить("Счет",			"СчетДт");
	ПоляФормы.Вставить("Субконто1",		"СубконтоДт1");
	ПоляФормы.Вставить("Субконто2",		"СубконтоДт2");
	ПоляФормы.Вставить("Субконто3",		"СубконтоДт3");
	
	ОтражатьВНалоговомУчете = УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаТаблицы.КФО);
	
	ПараметрыОбъекта = Новый Структура;
	ПараметрыОбъекта.Вставить("ОтражатьВНалоговомУчете", ОтражатьВНалоговомУчете);
	ПараметрыОбъекта.Вставить("ОтражатьВУСНДоходыМинусРасходы", Ложь);
	ПараметрыОбъекта.Вставить("ЕстьНДС", Ложь);
	ПараметрыОбъекта.Вставить("ЕстьКПС",
		НЕ СтрокаТаблицы.КПС = СтрокаТаблицы.КПСДт И ЗначениеЗаполнено(СтрокаТаблицы.КПСДт));
	ПараметрыОбъекта.Вставить("ЕстьКЭК", Ложь);
	ПараметрыОбъекта.Вставить("ЕстьПодразделение",
		НЕ СтрокаТаблицы.Подразделение = СтрокаТаблицы.ПодразделениеДт И ЗначениеЗаполнено(СтрокаТаблицы.ПодразделениеДт));
	ПараметрыОбъекта.Вставить("ОтразитьВКарточкеКапвложений", СтрокаТаблицы.ОтразитьВКарточкеКапвложений);
	ПараметрыОбъекта.Вставить("КарточкаКапвложений", СтрокаТаблицы.КарточкаКапвложений);
	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, ПараметрыОбъекта, ПоляФормы);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДобавленныеКолонкиУчетныеДанныеОС(СтрокаТаблицы)

	ПодчиненныеСтроки = Объект.ПорядокОтраженияВУчете.НайтиСтроки(
		Новый Структура("ИдентификаторСтроки", СтрокаТаблицы.ИдентификаторСтроки));
		
	МассивОпределений = Новый Массив;
	Для каждого СтрокаТаблицыПорядокОтражения Из ПодчиненныеСтроки Цикл
		МассивОпределений.Добавить(ТекстОтражениеВУчетеКратко(СтрокаТаблицыПорядокОтражения));
	КонецЦикла;	
	
	СтрокаТаблицы.ОтражениеВУчетеКратко = ТекстОтражениеВУчетеКраткоИзМассиваОпределений(МассивОпределений);

КонецПроцедуры  

&НаСервере
Функция ТекстОтражениеВУчетеКратко(СтрокаТаблицы)
	Возврат СтрШаблон("%1.%2 К.:%3",
		СтрокаТаблицы.КФО,
		СтрокаТаблицы.СчетДт,
		XMLСтрока(СтрокаТаблицы.Коэффициент));
КонецФункции

&НаСервере
Функция ТекстОтражениеВУчетеКраткоИзМассиваОпределений(МассивОпределений)

	Возврат СтрСоединить(МассивОпределений, Символы.ПС);	

КонецФункции  

#КонецОбласти

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВидНалогаПриИзмененииНаСервере()
	
	ОбновитьКэшПараметровНалогПоУмолчанию();
	
	Для каждого Строка Из Объект.ДвиженияДокумента Цикл
		
		Строка.ВидНалогаИлиПлатежа = ЭтотОбъект.КэшПараметров.Локальные.ВидНалогаИлиПлатежаПоУмолчанию;
		Строка.НалогСборПлатеж 	   = ЭтотОбъект.КэшПараметров.Локальные.НалогСборПлатежПоУмолчанию;
		
		Строка.КПС 		= КПСУчетаНалогаПоУмолчанию(Объект.ВидНалога, Строка.КПС, Объект.Дата);
		Строка.КПСДт 	= КПСУчетаНалогаПоУмолчанию(Объект.ВидНалога, Строка.КПСДт, Объект.Дата);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

&НаКлиенте
Процедура РазделЛицевогоСчетаВТаблицеПриИзмененииНаКлиенте()
	
	Если Объект.ДвиженияДокумента.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	Если Объект.РазделЛицевогоСчетаВТаблице = 0
		И Не ЗначениеЗаполнено(Объект.РазделЛицевогоСчета) Тогда
		
		Объект.РазделЛицевогоСчета = Объект.ДвиженияДокумента[0].РазделЛицевогоСчета;
		
	ИначеЕсли Объект.РазделЛицевогоСчетаВТаблице = 1
		И ЗначениеЗаполнено(Объект.РазделЛицевогоСчета) Тогда
		
		ЗаполнитьРазделЛицевогоСчетаВТабличнойЧасти();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРазделЛицевогоСчетаВТабличнойЧасти()
	
	РазделЛицевогоСчета = Объект.РазделЛицевогоСчета;	
	ДопустимыеКФО = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РазделыЛицевыхСчетовДопустимыеКФО.КФО КАК КФО
		|ИЗ
		|	Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО КАК РазделыЛицевыхСчетовДопустимыеКФО
		|ГДЕ
		|	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка = &РазделЛицевогоСчета";
	
	Запрос.УстановитьПараметр("РазделЛицевогоСчета", РазделЛицевогоСчета);
	
	ВыборкаДопустимыеКФО = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДопустимыеКФО.Следующий() Цикл
		ДопустимыеКФО.Вставить(ВыборкаДопустимыеКФО.КФО, Истина);		
	КонецЦикла;
	
	Для каждого Строка Из Объект.ДвиженияДокумента Цикл
		Если ДопустимыеКФО[Строка.КФО] <> Неопределено Тогда
			Строка.РазделЛицевогоСчета = РазделЛицевогоСчета;		
		КонецЕсли;	
	КонецЦикла;
	Для каждого Строка Из Объект.ПорядокОтраженияВУчете Цикл
		Если ДопустимыеКФО[Строка.КФО] <> Неопределено Тогда
			Строка.РазделЛицевогоСчета = РазделЛицевогоСчета;		
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзмененииВСтроке(ТекущиеДанные)
	
	ОтражатьВНалоговомУчете = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(ТекущиеДанные.КФО);
	Если НЕ ОтражатьВНалоговомУчете Тогда
		ТекущиеДанные.СчетНУ      = Неопределено;
		ТекущиеДанные.СубконтоНУ1 = Неопределено;
		ТекущиеДанные.СубконтоНУ2 = Неопределено;
		ТекущиеДанные.СубконтоНУ3 = Неопределено;
	КонецЕсли;
	
	ОбновитьТекстОтражениеВУчете(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, ТекущиеДанные);
	
КонецПроцедуры

