&НаКлиенте
Асинх Процедура ПерезаполнитьПоДокументуОснованию(Команда)
	
	Если Объект.ДвиженияДокумента.Количество() > 0
		Или Объект.УчетныеДанныеОС.Количество() > 0 Тогда
		
		ТекстВопроса = НСтр("ru = 'Документ будет перезаполнен. Продолжить?'");
	    Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	    Если Ответ <> КодВозвратаДиалога.Да Тогда
	        Возврат;
	    КонецЕсли;		
	КонецЕсли;

	ЗаполнитьПоДокументуОснованиюНаСервере();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗаполнитьПоРасчету(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ВидНалога) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Вид налога'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.ВидНалога");
		Возврат;
	КонецЕсли;

	Если Объект.ДвиженияДокумента.Количество() > 0
		Или Объект.УчетныеДанныеОС.Количество() > 0 Тогда
		
		ТекстВопроса = НСтр("ru = 'Документ будет перезаполнен. Продолжить?'");
	    Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	    Если Ответ <> КодВозвратаДиалога.Да Тогда
	        Возврат;
	    КонецЕсли;		
		
	КонецЕсли;
	
	ВыбратьДокументОснованиеИПродолжитьЗаполнение();
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПоИсточникам(Команда)

	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Расчет налога'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;

	ОткрытьФормуРаспределенияПоИсточникам();	
	
КонецПроцедуры

