Функция ТекстЗапросаПодборСпособаРаспределения(НомераТаблиц)

	НомераТаблиц.Вставить("ВТИсчисленоНалогаСпособРаспределения", НомераТаблиц.Количество());

	Возврат
		"ВЫБРАТЬ
		|	ВТИсчисленоНалогаПоУчетнымДанным.ИФО КАК ИФО,
		|	ВТИсчисленоНалогаПоУчетнымДанным.КФО КАК КФО,
		|	ВТИсчисленоНалогаПоУчетнымДанным.КПС КАК КПС,
		|	ВЫБОР
		|		КОГДА ВТСпособПоИнвентарномуНомеру.СпособРаспределения ЕСТЬ NULL
		|				И ВТСпособПоОС.СпособРаспределения ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
		|		ИНАЧЕ ВТИсчисленоНалогаПоУчетнымДанным.ОсновноеСредство
		|	КОНЕЦ КАК ОсновноеСредство,
		|	ВЫБОР
		|		КОГДА ВТСпособПоИнвентарномуНомеру.СпособРаспределения ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
		|		ИНАЧЕ ВТИсчисленоНалогаПоУчетнымДанным.ИнвентарныйНомер
		|	КОНЕЦ КАК ИнвентарныйНомер,
		|	ВТИсчисленоНалогаПоУчетнымДанным.Сумма КАК Сумма,
		|	ВТИсчисленоНалогаПоУчетнымДанным.КодПоОКТМО КАК КодПоОКТМО,
		|	ВТИсчисленоНалогаПоУчетнымДанным.КБК КАК КБК,
		|	ВЫБОР
		|		КОГДА НЕ ВТСпособПоИнвентарномуНомеру.СпособРаспределения ЕСТЬ NULL
		|			ТОГДА ВТСпособПоИнвентарномуНомеру.СпособРаспределения
		|		КОГДА НЕ ВТСпособПоОС.СпособРаспределения ЕСТЬ NULL
		|			ТОГДА ВТСпособПоОС.СпособРаспределения
		|		КОГДА НЕ ВТСпособПоКПС.СпособРаспределения ЕСТЬ NULL
		|			ТОГДА ВТСпособПоКПС.СпособРаспределения
		|		КОГДА НЕ ВТСпособПоКФО.СпособРаспределения ЕСТЬ NULL
		|			ТОГДА ВТСпособПоКФО.СпособРаспределения
		|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.РегистрацияСпособаРаспределенияНалогаПоИсточникамФинансирования.ПустаяСсылка)
		|	КОНЕЦ КАК СпособРаспределения
		|ПОМЕСТИТЬ ВТИсчисленоНалогаСпособРаспределения
		|ИЗ
		|	ВТИсчисленоНалогаПоУчетнымДанным КАК ВТИсчисленоНалогаПоУчетнымДанным
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСпособПоИнвентарномуНомеру КАК ВТСпособПоИнвентарномуНомеру
		|		ПО ВТИсчисленоНалогаПоУчетнымДанным.ОсновноеСредство = ВТСпособПоИнвентарномуНомеру.ОсновноеСредство
		|			И ВТИсчисленоНалогаПоУчетнымДанным.ИнвентарныйНомер = ВТСпособПоИнвентарномуНомеру.ИнвентарныйНомер
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСпособПоОС КАК ВТСпособПоОС
		|		ПО ВТИсчисленоНалогаПоУчетнымДанным.ОсновноеСредство = ВТСпособПоОС.ОсновноеСредство
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСпособПоКПС КАК ВТСпособПоКПС
		|		ПО ВТИсчисленоНалогаПоУчетнымДанным.ИФО = ВТСпособПоКПС.ИФО
		|			И ВТИсчисленоНалогаПоУчетнымДанным.КФО = ВТСпособПоКПС.КФО
		|			И ВТИсчисленоНалогаПоУчетнымДанным.КПС = ВТСпособПоКПС.КПС
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСпособПоКФО КАК ВТСпособПоКФО
		|		ПО ВТИсчисленоНалогаПоУчетнымДанным.ИФО = ВТСпособПоКФО.ИФО
		|			И ВТИсчисленоНалогаПоУчетнымДанным.КФО = ВТСпособПоКФО.КФО";

