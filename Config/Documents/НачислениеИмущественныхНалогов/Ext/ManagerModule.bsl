КонецФункции 

Функция ТекстЗапросаИсчисленоНалогаПоУчетнымДанным(НомераТаблиц)

	НомераТаблиц.Вставить("ВТУчетныеДанныеОС", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВТИсчисленоНалогаПоУчетнымДанным", НомераТаблиц.Количество());

	Возврат
		"ВЫБРАТЬ
		|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
		|	УчетныеДанныеОбъектаОССрезПоследних.КФО КАК КФО,
		|	УчетныеДанныеОбъектаОССрезПоследних.КПС КАК КПС,
		|	ВЫБОР
		|		КОГДА &ИспользоватьУчетПоИФО
		|			ТОГДА УчетныеДанныеОбъектаОССрезПоследних.ИФО
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
		|	КОНЕЦ КАК ИФО
		|ПОМЕСТИТЬ ВТУчетныеДанныеОС
		|ИЗ
		|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
		|			&КонецМесяца,
		|			(Организация, ВидУчета, ОсновноеСредство) В
		|				(ВЫБРАТЬ
		|					ВТДанныеДокумента.Организация,
		|					ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.НаБалансе),
		|					ВТДанныеДокумента.ОсновноеСредство
		|				ИЗ
		|					ВТДанныеДокумента)) КАК УчетныеДанныеОбъектаОССрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТДанныеДокумента.Организация КАК Организация,
		|	ВТДанныеДокумента.ВидНалога КАК ВидНалога,
		|	ВТДанныеДокумента.Сумма КАК Сумма,
		|	ВТДанныеДокумента.ОсновноеСредство КАК ОсновноеСредство,
		|	ВТДанныеДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ВТДанныеДокумента.КодПоОКТМО КАК КодПоОКТМО,
		|	ВТДанныеДокумента.КБК КАК КБК,
		|	ЕСТЬNULL(ВТУчетныеДанныеОС.КФО, ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)) КАК КФО,
		|	ЕСТЬNULL(ВТУчетныеДанныеОС.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
		|	ЕСТЬNULL(ВТУчетныеДанныеОС.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО
		|ПОМЕСТИТЬ ВТИсчисленоНалогаПоУчетнымДанным
		|ИЗ
		|	ВТДанныеДокумента КАК ВТДанныеДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТУчетныеДанныеОС КАК ВТУчетныеДанныеОС
		|		ПО ВТДанныеДокумента.ОсновноеСредство = ВТУчетныеДанныеОС.ОсновноеСредство";

КонецФункции

Функция ТекстЗапросаСпособПоИнвентарномуНомеру(НомераТаблиц)

	НомераТаблиц.Вставить("ВТСпособПоИнвентарномуНомеру", НомераТаблиц.Количество());

	Возврат
		"ВЫБРАТЬ
		|	СпособыРаспределения.ОсновноеСредство КАК ОсновноеСредство,
		|	СпособыРаспределения.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	СпособыРаспределения.СпособРаспределения КАК СпособРаспределения
		|ПОМЕСТИТЬ ВТСпособПоИнвентарномуНомеру
		|ИЗ
		|	РегистрСведений.СпособыРаспределенияНалогаПоИсточникамФинансирования.СрезПоследних(
		|			&Дата,
		|			(Организация, ВидНалога, КФО, КПС, ОсновноеСредство, ИнвентарныйНомер, ИФО) В
		|				(ВЫБРАТЬ
		|					ВТИсчисленоНалогаПоУчетнымДанным.Организация,
		|					ВТИсчисленоНалогаПоУчетнымДанным.ВидНалога,
		|					ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка),
		|					ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка),
		|					ВТИсчисленоНалогаПоУчетнымДанным.ОсновноеСредство,
		|					ВТИсчисленоНалогаПоУчетнымДанным.ИнвентарныйНомер,
		|					ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
		|				ИЗ
		|					ВТИсчисленоНалогаПоУчетнымДанным КАК ВТИсчисленоНалогаПоУчетнымДанным)) КАК СпособыРаспределения";
	
КонецФункции 

