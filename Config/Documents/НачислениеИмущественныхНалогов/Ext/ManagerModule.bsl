#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.НачислениеИмущественныхНалогов";
	КомандаПечати.Идентификатор		= "РаспределениеПоИсточникам";
	КомандаПечати.Представление		= НСтр("ru = 'Распределение по источникам'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу движений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - ТаблицаЗначений - Таблица проводок, которые будут сформированы
//  ДокументОбъект - ДокументОбъект - Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура - Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - ТаблицаЗначений - Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка - Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
//
// Возвращаемое значение:
//  Булево - флаг успешного выполнения. Если Истина - все ОК, иначе - Ложь
//
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт
	
	УникальныеЗначения = Новый Соответствие;
	
	Для каждого Строка Из ДокументОбъект.ДвиженияДокумента Цикл
		Если НЕ Строка.ОтразитьВКарточкеКапвложений ИЛИ НЕ ЗначениеЗаполнено(Строка.КарточкаКапвложений) Тогда
			Продолжить;
		ИначеЕсли УникальныеЗначения[Строка.КарточкаКапвложений] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		НоваяСтрока = ТабДвижений.Добавить();
		НоваяСтрока.Организация         = ДокументОбъект.Организация;
		НоваяСтрока.КарточкаКапвложений = Строка.КарточкаКапвложений;
		НоваяСтрока.Период              = ДокументОбъект.Дата;
		
		УникальныеЗначения.Вставить(Строка.КарточкаКапвложений, Истина);
	КонецЦикла;	

	Возврат Истина;
КонецФункции	

// Возвращаемое значение:
//  Структура:
//        * Дата - Дата
//        * Организация - СправочникСсылка.Организации
//        * ВидНалога - ПеречислениеСсылка.ВидыИмущественныхНалогов
//        * ДокументОснование 	- ДокументСсылка.РасчетТранспортногоНалога
//								- ДокументСсылка.РасчетЗемельногоНалога
//								- ДокументСсылка.РасчетНалогаНаИмущество 
//
Функция ПараметрыЗаполненияУчетныеДанныеИПорядокОтражения() Экспорт

	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Дата");
	ПараметрыЗаполнения.Вставить("Организация");
	ПараметрыЗаполнения.Вставить("ВидНалога");
	ПараметрыЗаполнения.Вставить("ДокументОснование");
	
	Возврат ПараметрыЗаполнения;

КонецФункции

// Возвращает таблицу для заполнения табличной части Бухгалтерский учет по данным 
// таблицы Порядок отражения в учете.
//
// Параметры:
//  ТаблицаПорядокОтраженияВУчете  - ТаблицаЗначений
//
// Возвращаемое значение:
//   ТаблицаЗначений
//
Функция СформироватьТаблицуБухгалтерскийУчет(Знач ТаблицаПорядокОтраженияВУчете) Экспорт
	
	ТаблицаПорядокОтраженияВУчете.Свернуть(КолонкиГруппировкиДвиженияДокумента(), "Сумма");
	ТаблицаПорядокОтраженияВУчете.Сортировать("КФО, КПС, ИФО, Сумма Убыв");
	
	Возврат ТаблицаПорядокОтраженияВУчете;

КонецФункции 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеТаблицУчетныеДанныеИПорядокОтражения

// Заполняет таблицы для распределения имущественных налогов по расчету налога
//
// Параметры:
//  ПараметрыЗаполнения  	- Структура - см. ПараметрыЗаполненияУчетныеДанныеИПорядокОтражения()
//  УчетныеДанныеОС   		- ДокументТабличнаяЧасть.НачислениеИмущественныхНалогов.УчетныеДанныеОС
//	ПорядокОтраженияВУчете 	- ДокументТабличнаяЧасть.НачислениеИмущественныхНалогов.ПорядокОтраженияВУчете
//
Процедура ЗаполнитьУчетныеДанныеИПорядокОтражения(ПараметрыЗаполнения, УчетныеДанныеОС, ПорядокОтраженияВУчете) Экспорт

	Запрос = Новый Запрос;
	ТекстыЗапросов = Новый Массив;
	НомераТаблиц = Новый Структура;
	
	Если ТипЗнч(ПараметрыЗаполнения.ДокументОснование) = Тип("ДокументСсылка.РасчетНалогаНаИмущество") Тогда
		ТекстыЗапросов.Добавить(ТекстЗапросаДанныеРасчетНалогаНаИмущество(НомераТаблиц));	
	ИначеЕсли ТипЗнч(ПараметрыЗаполнения.ДокументОснование) = Тип("ДокументСсылка.РасчетЗемельногоНалога") Тогда
		ТекстыЗапросов.Добавить(ТекстЗапросаДанныеРасчетЗемельногоНалога(НомераТаблиц));	
	Иначе
		ТекстыЗапросов.Добавить(ТекстЗапросаДанныеРасчетТранспортногоНалога(НомераТаблиц));	
	КонецЕсли;

	ТекстыЗапросов.Добавить(ТекстЗапросаИсчисленоНалогаПоУчетнымДанным(НомераТаблиц));
	ТекстыЗапросов.Добавить(ТекстЗапросаСпособПоИнвентарномуНомеру(НомераТаблиц));
	ТекстыЗапросов.Добавить(ТекстЗапросаСпособПоОС(НомераТаблиц));
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ТекстыЗапросов.Добавить(ТекстЗапросаСпособПоКПС(НомераТаблиц));
		ТекстыЗапросов.Добавить(ТекстЗапросаСпособПоКФО(НомераТаблиц));
	Иначе	
		ТекстыЗапросов.Добавить(ТекстЗапросаСпособПоКПСБезУчетаИФО(НомераТаблиц));
		ТекстыЗапросов.Добавить(ТекстЗапросаСпособПоКФОБезУчетаИФО(НомераТаблиц));
	КонецЕсли;	
	
	ТекстыЗапросов.Добавить(ТекстЗапросаПодборСпособаРаспределения(НомераТаблиц));
	ТекстыЗапросов.Добавить(ТекстЗапросаАналитикаУчетаНалога(НомераТаблиц));

	НомераТаблиц.Вставить("ИсчисленоНалога", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("СпособыРаспределения", НомераТаблиц.Количество());
	
	ТекстыЗапросов.Добавить(
		"ВЫБРАТЬ
		|	ВТИсчисленоНалогаСпособРаспределения.ИФО КАК ИФО,
		|	ЕСТЬNULL(ВТИсчисленоНалогаСпособРаспределения.ИФО.Наименование, """") КАК ИФОНаименование,
		|	ВТИсчисленоНалогаСпособРаспределения.КФО КАК КФО,
		|	ВТИсчисленоНалогаСпособРаспределения.КПС КАК КПС,
		|	ЕСТЬNULL(ВТИсчисленоНалогаСпособРаспределения.КПС.Код, """") КАК КПСКод,
		|	ВТИсчисленоНалогаСпособРаспределения.ОсновноеСредство КАК ОсновноеСредство,
		|	ЕСТЬNULL(ВТИсчисленоНалогаСпособРаспределения.ОсновноеСредство.Наименование, """") КАК ОсновноеСредствоНаименование,
		|	ВТИсчисленоНалогаСпособРаспределения.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ЕСТЬNULL(ВТИсчисленоНалогаСпособРаспределения.ИнвентарныйНомер.Код, """") КАК ИнвентарныйНомерКод,
		|	СУММА(ВТИсчисленоНалогаСпособРаспределения.Сумма) КАК Сумма,
		|	ВТИсчисленоНалогаСпособРаспределения.КБК КАК КБК,
		|	ВТИсчисленоНалогаСпособРаспределения.КодПоОКТМО КАК КодПоОКТМО,
		|	ВТИсчисленоНалогаСпособРаспределения.СпособРаспределения КАК СпособРаспределения,
		|	ЕСТЬNULL(ВТАналитикаУчетаНалога.ВидНалогаИлиПлатежа, ЗНАЧЕНИЕ(Справочник.ВидыНалоговИПлатежей.ПустаяСсылка)) КАК ВидНалогаИлиПлатежа,
		|	ЕСТЬNULL(ВТАналитикаУчетаНалога.НалогСборПлатеж, ЗНАЧЕНИЕ(Справочник.НалогиИПлатежиОрганизации.ПустаяСсылка)) КАК НалогСборПлатеж
		|ИЗ
		|	ВТИсчисленоНалогаСпособРаспределения КАК ВТИсчисленоНалогаСпособРаспределения
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТАналитикаУчетаНалога КАК ВТАналитикаУчетаНалога
		|		ПО ВТИсчисленоНалогаСпособРаспределения.КодПоОКТМО = ВТАналитикаУчетаНалога.КодПоОКТМО
		|			И ВТИсчисленоНалогаСпособРаспределения.КБК = ВТАналитикаУчетаНалога.КБК
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТИсчисленоНалогаСпособРаспределения.ИФО,
		|	ЕСТЬNULL(ВТИсчисленоНалогаСпособРаспределения.ИФО.Наименование, """"),
		|	ВТИсчисленоНалогаСпособРаспределения.КФО,
		|	ВТИсчисленоНалогаСпособРаспределения.КПС,
		|	ЕСТЬNULL(ВТИсчисленоНалогаСпособРаспределения.КПС.Код, """"),
		|	ВТИсчисленоНалогаСпособРаспределения.ОсновноеСредство,
		|	ЕСТЬNULL(ВТИсчисленоНалогаСпособРаспределения.ОсновноеСредство.Наименование, """"),
		|	ВТИсчисленоНалогаСпособРаспределения.ИнвентарныйНомер,
		|	ЕСТЬNULL(ВТИсчисленоНалогаСпособРаспределения.ИнвентарныйНомер.Код, """"),
		|	ВТИсчисленоНалогаСпособРаспределения.КБК,
		|	ВТИсчисленоНалогаСпособРаспределения.КодПоОКТМО,
		|	ВТИсчисленоНалогаСпособРаспределения.СпособРаспределения,
		|	ЕСТЬNULL(ВТАналитикаУчетаНалога.ВидНалогаИлиПлатежа, ЗНАЧЕНИЕ(Справочник.ВидыНалоговИПлатежей.ПустаяСсылка)),
		|	ЕСТЬNULL(ВТАналитикаУчетаНалога.НалогСборПлатеж, ЗНАЧЕНИЕ(Справочник.НалогиИПлатежиОрганизации.ПустаяСсылка))
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИФОНаименование,
		|	КФО,
		|	КПСКод,
		|	ОсновноеСредствоНаименование,
		|	ИнвентарныйНомерКод,
		|	КБК,
		|	КодПоОКТМО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СпособыРаспределения.Ссылка КАК СпособРаспределения,
		|	СпособыРаспределения.НомерСтроки КАК НомерСтроки,
		|	ВЫБОР
		|		КОГДА &ИспользоватьУчетПоИФО
		|			ТОГДА СпособыРаспределения.ИФО
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
		|	КОНЕЦ КАК ИФО,
		|	СпособыРаспределения.Подразделение КАК Подразделение,
		|	СпособыРаспределения.КФО КАК КФО,
		|	СпособыРаспределения.КПС КАК КПС,
		|	СпособыРаспределения.КЭК КАК КЭК,
		|	СпособыРаспределения.Коэффициент КАК Коэффициент,
		|	СпособыРаспределения.СчетДт КАК СчетДт,
		|	СпособыРаспределения.ПодразделениеДт КАК ПодразделениеДт,
		|	СпособыРаспределения.КПСДт КАК КПСДт,
		|	СпособыРаспределения.СубконтоДт1 КАК СубконтоДт1,
		|	СпособыРаспределения.СубконтоДт2 КАК СубконтоДт2,
		|	СпособыРаспределения.СубконтоДт3 КАК СубконтоДт3,
		|	СпособыРаспределения.СчетНУ КАК СчетНУ,
		|	СпособыРаспределения.СубконтоНУ1 КАК СубконтоНУ1,
		|	СпособыРаспределения.СубконтоНУ2 КАК СубконтоНУ2,
		|	СпособыРаспределения.СубконтоНУ3 КАК СубконтоНУ3,
		|	СпособыРаспределения.ОтражениеВУСН КАК ОтражениеВУСН,
		|	СпособыРаспределения.ОтразитьВКарточкеКапвложений КАК ОтразитьВКарточкеКапвложений,
		|	СпособыРаспределения.КарточкаКапвложений КАК КарточкаКапвложений,
		|	СпособыРаспределения.РазделЛицевогоСчета КАК РазделЛицевогоСчета,
		|	СпособыРаспределения.КодЦели КАК КодЦели,
		|	СпособыРаспределения.КодМероприятия КАК КодМероприятия,
		|	СпособыРаспределения.ДопКлассификация КАК ДопКлассификация
		|ИЗ
		|	Документ.РегистрацияСпособаРаспределенияНалогаПоИсточникамФинансирования.ПорядокОтраженияВУчете КАК СпособыРаспределения
		|ГДЕ
		|	СпособыРаспределения.Ссылка В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ВТИсчисленоНалогаСпособРаспределения.СпособРаспределения КАК СпособРаспределения
		|			ИЗ
		|				ВТИсчисленоНалогаСпособРаспределения КАК ВТИсчисленоНалогаСпособРаспределения)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СпособРаспределения,
		|	НомерСтроки");
	
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Запрос.УстановитьПараметр("ДокументРасчета", ПараметрыЗаполнения.ДокументОснование);
	Запрос.УстановитьПараметр("Организация", 	 ПараметрыЗаполнения.Организация);
	Запрос.УстановитьПараметр("ВидНалога", 		 ПараметрыЗаполнения.ВидНалога);
	Запрос.УстановитьПараметр("Дата", 			 ПараметрыЗаполнения.Дата);
	Запрос.УстановитьПараметр("КонецМесяца", 	 КонецМесяца(ПараметрыЗаполнения.Дата));
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаИсчисленоНалога = РезультатЗапроса[НомераТаблиц.ИсчисленоНалога].Выбрать();
	СпособыРаспределения   = РезультатЗапроса[НомераТаблиц.СпособыРаспределения].Выгрузить();
	СпособыРаспределения.Колонки.Добавить("Сумма",
		Метаданные.Документы.НачислениеИмущественныхНалогов.ТабличныеЧасти.ПорядокОтраженияВУчете.Реквизиты.Сумма.Тип);
		
	СпособыРаспределения.Индексы.Добавить("СпособРаспределения");
	
	СтрокаРасчета = СтрокаРасчета();
	
	Пока ВыборкаИсчисленоНалога.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчета, ВыборкаИсчисленоНалога);
		СтрокаРасчета.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		
		СтрокаУчетныеДанные = УчетныеДанныеОС.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаУчетныеДанные, СтрокаРасчета);
		
		СтрокиРаспределения = СпособыРаспределения.НайтиСтроки(
			Новый Структура("СпособРаспределения", ВыборкаИсчисленоНалога.СпособРаспределения));
		
		Если СтрокиРаспределения.Количество() > 0 Тогда
				
			ДобавитьСпособРаспределенияПоНастройке(ПараметрыЗаполнения, СтрокаРасчета, ПорядокОтраженияВУчете,
				СтрокиРаспределения);
			
		Иначе	
			
			ДобавитьСпособРаспределенияПоУмолчанию(ПараметрыЗаполнения, СтрокаРасчета, ПорядокОтраженияВУчете);
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

// Инициализация структуры для использования в параметрах
//
// Возвращаемое значение:
//   Структура
//
Функция СтрокаРасчета()
	
	СтрокаРасчета = Новый Структура;

	СтрокаРасчета.Вставить("ИФО", 					Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	СтрокаРасчета.Вставить("КФО", 					Перечисления.КВД.ПустаяСсылка());
	СтрокаРасчета.Вставить("КПС", 					Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
	СтрокаРасчета.Вставить("ОсновноеСредство");
	СтрокаРасчета.Вставить("ИнвентарныйНомер");
	СтрокаРасчета.Вставить("Сумма",					0);
	СтрокаРасчета.Вставить("КодПоОКТМО", 			"");
	СтрокаРасчета.Вставить("КБК", 					"");
	СтрокаРасчета.Вставить("ИдентификаторСтроки", 	"");
	СтрокаРасчета.Вставить("ВидНалогаИлиПлатежа", 	Справочники.ВидыНалоговИПлатежей.ПустаяСсылка());
	СтрокаРасчета.Вставить("НалогСборПлатеж", 		Справочники.НалогиИПлатежиОрганизации.ПустаяСсылка());
	
	Возврат СтрокаРасчета;

КонецФункции

// Добавляет способ распределения по настройке в табличную часть ПорядокОтраженияВУчете
//
// Параметры:
//  ПараметрыЗаполнения  	- Структура - см. ПараметрыЗаполненияУчетныеДанныеИПорядокОтражения()
//  СтрокаРасчета		  	- Структура - см. СтрокаРасчета()
//	ПорядокОтраженияВУчете 	- ДокументТабличнаяЧасть.НачислениеИмущественныхНалогов.ПорядокОтраженияВУчете
//  СтрокиРаспределения		- Массив из СтрокаТаблицыЗначений - Способ распределения для текущей строки учетных данных
//
Процедура ДобавитьСпособРаспределенияПоНастройке(ПараметрыЗаполнения, СтрокаРасчета, 
													ПорядокОтраженияВУчете,	СтрокиРаспределения)

	РаспределитьСуммуНалогаПоБазе(СтрокаРасчета.Сумма, СтрокиРаспределения);												
	
	Для каждого СтрокаРаспределения Из СтрокиРаспределения Цикл

		НоваяСтрока = ПорядокОтраженияВУчете.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаспределения);
		НоваяСтрока.ИдентификаторСтроки = СтрокаРасчета.ИдентификаторСтроки;
        ЗаполнитьВидНалогаНалогВСтрокеПорядокОтраженияВУчете(НоваяСтрока, СтрокаРасчета, ПараметрыЗаполнения);
		
	КонецЦикла;

КонецПроцедуры

Процедура РаспределитьСуммуНалогаПоБазе(СуммаНалога, СтрокиРаспределения)

	Коэффициенты = ОбщегоНазначения.ВыгрузитьКолонку(СтрокиРаспределения, "Коэффициент");	
		
   	СуммыНалога = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(
		СуммаНалога, Коэффициенты);
		
	Для Индекс = 0 По СтрокиРаспределения.ВГраница() Цикл
		СтрокиРаспределения[Индекс].Сумма = ?(СуммыНалога = Неопределено, 0, СуммыНалога[Индекс]);
	КонецЦикла;
	
КонецПроцедуры

// Добавляет способ распределения по умолчанию в табличную часть ПорядокОтраженияВУчете
//
// Параметры:
//  ПараметрыЗаполнения  	- Структура - см. ПараметрыЗаполненияУчетныеДанныеИПорядокОтражения()
//  СтрокаРасчета		  	- Структура - см. СтрокаРасчета()
//	ПорядокОтраженияВУчете 	- ДокументТабличнаяЧасть.НачислениеИмущественныхНалогов.ПорядокОтраженияВУчете
//
Процедура ДобавитьСпособРаспределенияПоУмолчанию(ПараметрыЗаполнения, СтрокаРасчета, ПорядокОтраженияВУчете)

	НоваяСтрока = ПорядокОтраженияВУчете.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасчета, "ИФО,КФО,ИдентификаторСтроки");

    ЗаполнитьВидНалогаНалогВСтрокеПорядокОтраженияВУчете(НоваяСтрока, СтрокаРасчета, ПараметрыЗаполнения);
		
	НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.КЭКПоКоду("291");

	НоваяСтрока.Коэффициент = 1;
	НоваяСтрока.Сумма 		= СтрокаРасчета.Сумма;
	
	Если НоваяСтрока.КФО = Перечисления.КВД.Бюджет Тогда
		НоваяСтрока.СчетДт = БухгалтерскийУчет.СчетПоКоду("401.20", ПараметрыЗаполнения.Дата);
	КонецЕсли;

КонецПроцедуры  

Процедура ЗаполнитьВидНалогаНалогВСтрокеПорядокОтраженияВУчете(НоваяСтрока, СтрокаРасчета, ПараметрыЗаполнения)
	
	Если Не ЗначениеЗаполнено(НоваяСтрока.ВидНалогаИлиПлатежа) Тогда
		НоваяСтрока.ВидНалогаИлиПлатежа = СтрокаРасчета.ВидНалогаИлиПлатежа;
		НоваяСтрока.НалогСборПлатеж 	= СтрокаРасчета.НалогСборПлатеж;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НоваяСтрока.ВидНалогаИлиПлатежа) Тогда
		НоваяСтрока.ВидНалогаИлиПлатежа = Справочники.ВидыНалоговИПлатежей.ВидИмущественногоНалогаПоУмолчанию(
			ПараметрыЗаполнения.ВидНалога, СтрокаРасчета.КБК);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НоваяСтрока.НалогСборПлатеж) Тогда
		НоваяСтрока.НалогСборПлатеж = Справочники.НалогиИПлатежиОрганизации.НалогСборПлатежПоУмолчанию(
			ПараметрыЗаполнения.Организация, НоваяСтрока.ВидНалогаИлиПлатежа, СтрокаРасчета.КодПоОКТМО);
	КонецЕсли;

КонецПроцедуры

// Функция возвращает текст запроса временной таблицы
// с данными документа РасчетНалогаНаИмущество 
//
// Параметры:
//  НомераТаблиц - Структура
//
// Возвращаемое значение:
//   Строка - сформированный текст запроса
//
Функция ТекстЗапросаДанныеРасчетНалогаНаИмущество(НомераТаблиц)
	
	НомераТаблиц.Вставить("ВТДанныеДокумента", НомераТаблиц.Количество());
	
	Возврат
		"ВЫБРАТЬ
		|	&Организация КАК Организация,
		|	&ВидНалога КАК ВидНалога,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ОсновноеСредство КАК ОсновноеСредство,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.Сумма КАК Сумма,
		|	РасчетНалогаНаИмуществоПоСреднегодовой.КодПоОКТМО КАК КодПоОКТМО,
		|	"""" КАК КБК
		|ПОМЕСТИТЬ ВТДанныеДокумента
		|ИЗ
		|	Документ.РасчетНалогаНаИмущество.ПоСреднегодовой КАК РасчетНалогаНаИмуществоПоСреднегодовой
		|ГДЕ
		|	РасчетНалогаНаИмуществоПоСреднегодовой.Ссылка = &ДокументРасчета
		|	И РасчетНалогаНаИмуществоПоСреднегодовой.Сумма <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&Организация,
		|	&ВидНалога,
		|	РасчетНалогаНаИмуществоПоКадастровой.ОсновноеСредство,
		|	РасчетНалогаНаИмуществоПоКадастровой.ИнвентарныйНомер,
		|	РасчетНалогаНаИмуществоПоКадастровой.Сумма,
		|	РасчетНалогаНаИмуществоПоКадастровой.КодПоОКТМО,
		|	""""
		|ИЗ
		|	Документ.РасчетНалогаНаИмущество.ПоКадастровой КАК РасчетНалогаНаИмуществоПоКадастровой
		|ГДЕ
		|	РасчетНалогаНаИмуществоПоКадастровой.Ссылка = &ДокументРасчета
		|	И РасчетНалогаНаИмуществоПоКадастровой.Сумма <> 0";

КонецФункции 

// Функция возвращает текст запроса временной таблицы
// с данными документа РасчетЗемельногоНалога 
//
// Параметры:
//  НомераТаблиц - Структура
//
// Возвращаемое значение:
//   Строка - сформированный текст запроса
//
Функция ТекстЗапросаДанныеРасчетЗемельногоНалога(НомераТаблиц)

	НомераТаблиц.Вставить("ВТДанныеДокумента", НомераТаблиц.Количество());
	
	Возврат
		"ВЫБРАТЬ
		|	&Организация КАК Организация,
		|	&ВидНалога КАК ВидНалога,
		|	РасчетЗемельногоНалогаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	РасчетЗемельногоНалогаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	РасчетЗемельногоНалогаОсновныеСредства.Сумма КАК Сумма,
		|	РасчетЗемельногоНалогаОсновныеСредства.КодПоОКТМО КАК КодПоОКТМО,
		|	РасчетЗемельногоНалогаОсновныеСредства.КБК КАК КБК
		|ПОМЕСТИТЬ ВТДанныеДокумента
		|ИЗ
		|	Документ.РасчетЗемельногоНалога.ОсновныеСредства КАК РасчетЗемельногоНалогаОсновныеСредства
		|ГДЕ
		|	РасчетЗемельногоНалогаОсновныеСредства.Ссылка = &ДокументРасчета
		|	И РасчетЗемельногоНалогаОсновныеСредства.Сумма <> 0";

КонецФункции 

