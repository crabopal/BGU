// Совпадающие имена колонок таблиц ДвиженияДокумента и ПорядокОтраженияВУчете
//
// Возвращаемое значение:
//   Строка
//
Функция КолонкиГруппировкиДвиженияДокумента()
	
	МетаданныеОбъекта = Метаданные.Документы.НачислениеИмущественныхНалогов.ТабличныеЧасти.ДвиженияДокумента;
	ИменаРеквизитовДвиженияДокумента = Новый Соответствие;
	Для каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		ИменаРеквизитовДвиженияДокумента.Вставить(Реквизит.Имя, Истина);	
	КонецЦикла;
	
	МетаданныеОбъекта = Метаданные.Документы.НачислениеИмущественныхНалогов.ТабличныеЧасти.ПорядокОтраженияВУчете;
	
	МассивИмен = Новый Массив;
	
	Для каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		ИмяРеквизита = Реквизит.Имя;
		Если ИмяРеквизита = "Коэффициент"
			Или ИмяРеквизита = "Сумма"
			Или ИмяРеквизита = "ИдентификаторСтроки" Тогда
			Продолжить;
		ИначеЕсли ИменаРеквизитовДвиженияДокумента[ИмяРеквизита] = Неопределено Тогда
			Продолжить;
		Иначе
			МассивИмен.Добавить(ИмяРеквизита);	
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(МассивИмен, ",");
КонецФункции 

#Область ФормированиеПечатныхФорм

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - Массив - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати - СписокЗначений - значение - ссылка на объект;
//                                            представление - имя области, в которой был выведен объект (выходной параметр);
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "РаспределениеПоИсточникам") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"РаспределениеПоИсточникам", "Распределение по источникам",
			ПечатьРаспределениеПоИсточникам(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьРаспределениеПоИсточникам(МассивОбъектов, ОбъектыПечати)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабДок.АвтоМасштаб			= Истина;
	ТабДок.ТолькоПросмотр		= Истина;
	ТабДок.ИмяПараметровПечати	= "ПараметрыПечати_РаспределениеПоИсточникам";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.НачислениеИмущественныхНалогов.ПФ_MXL_РаспределениеПоИсточникам");
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	УбратьИФОИзМакета(Макет, ИспользоватьУчетПоИФО, ИспользоватьУчетПоПодразделениям);
	
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ДоработатьМакетПоИФО(ОбластьШапка, ИспользоватьУчетПоИФО, ИспользоватьУчетПоПодразделениям, "Шапка");
	
	ОбластьСтрокаУчетныеДанные 	= Макет.ПолучитьОбласть("СтрокаУчетныеДанные");
	ДоработатьМакетПоИФО(ОбластьСтрокаУчетныеДанные, ИспользоватьУчетПоИФО, ИспользоватьУчетПоПодразделениям, "СтрокаУчетныеДанные");
	
	ОбластьСтрокаКОтражению		= Макет.ПолучитьОбласть("СтрокаКОтражению");
	ДоработатьМакетПоИФО(ОбластьСтрокаКОтражению, ИспользоватьУчетПоИФО, ИспользоватьУчетПоПодразделениям, "СтрокаКОтражению");

	ОбластьИтоги		= Макет.ПолучитьОбласть("Итоги");
	
	ОбластьСтрокаИтоги 	= Макет.ПолучитьОбласть("СтрокаИтоги");
	ДоработатьМакетПоИФО(ОбластьСтрокаИтоги, ИспользоватьУчетПоИФО, ИспользоватьУчетПоПодразделениям, "СтрокаИтоги");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", МассивОбъектов);
	
	НомераТаблиц = Новый Структура;
	Запрос.Текст = ТекстЗапросаПечатьРаспределениеПоИсточникам(НомераТаблиц);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаДокументов = Результат[НомераТаблиц.ТаблицаРаспределение].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТаблицаИтоги = Результат[НомераТаблиц.ТаблицаИтоги].Выгрузить();
	ТаблицаИтоги.Индексы.Добавить("Ссылка");
	
	Первый = Истина;
	ИтоговыеСуммы = Новый Структура;
	ИтоговыеСуммы.Вставить("Сумма", 0);
	ИтоговыеСуммы.Вставить("УчетныеДанныеСумма", 0);
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не Первый Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		Первый = Ложь;
		
		НомерСтрокиНачало = ТабДок.ВысотаТаблицы + 1;
		
		ЗаполнитьОбластьШапка(ОбластьШапка, ВыборкаДокументов);
		ТабДок.Вывести(ОбластьШапка);
		
		ПлательщикНалогаНаПрибыль = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(
			ВыборкаДокументов.ОрганизацияСсылка, ВыборкаДокументов.Дата);
			
		ИтоговыеСуммы.Сумма = 0;
		ИтоговыеСуммы.УчетныеДанныеСумма = 0;

		ВыборкаРаспределение = ВыборкаДокументов.Выбрать();
		
		Пока ВыборкаРаспределение.СледующийПоЗначениюПоля("УчетныеДанныеНомерСтроки") Цикл
			Если Не ЗначениеЗаполнено(ВыборкаРаспределение.УчетныеДанныеНомерСтроки) Тогда
				Продолжить;			
			КонецЕсли;
			
			ИтоговыеСуммы.УчетныеДанныеСумма = ИтоговыеСуммы.УчетныеДанныеСумма + ВыборкаРаспределение.УчетныеДанныеСумма;
			НомерСтрокиРаспределения = 0;
			
			Пока ВыборкаРаспределение.Следующий() Цикл
				
				ОбластьСтрока = ?(НомерСтрокиРаспределения = 0, ОбластьСтрокаУчетныеДанные, ОбластьСтрокаКОтражению);
				
				ЗаполнитьОбластьСтрокаРаспределения(ОбластьСтрока, ВыборкаРаспределение,
					НомерСтрокиРаспределения, ПлательщикНалогаНаПрибыль);
					
				ТабДок.Вывести(ОбластьСтрока);
				ИтоговыеСуммы.Сумма = ИтоговыеСуммы.Сумма + ВыборкаРаспределение.Сумма;
			
			КонецЦикла;
		
		КонецЦикла;
		ОбластьИтоги.Параметры.Заполнить(ИтоговыеСуммы);
		ТабДок.Вывести(ОбластьИтоги);
		
		СтрокиИтоги = ТаблицаИтоги.НайтиСтроки(Новый Структура("Ссылка", ВыборкаДокументов.Ссылка));
		ВыевестиНаПечатьИтоги(ТабДок, СтрокиИтоги, ОбластьСтрокаИтоги, ПлательщикНалогаНаПрибыль);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДок, НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции 

Процедура УбратьИФОИзМакета(Макет, ИспользоватьУчетПоИФО, ИспользоватьУчетПоПодразделениям)
	
	Если ИспользоватьУчетПоИФО Тогда
		Возврат;	
	КонецЕсли;

	Макет.УдалитьОбласть(Макет.Область("ИФО"),
		ТипСмещенияТабличногоДокумента.ПоГоризонтали);
		
	Если Не ИспользоватьУчетПоПодразделениям Тогда
		Макет.УдалитьОбласть(Макет.Область("ИФОПодразделение"),
			ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	КонецЕсли;	
			
КонецПроцедуры

Процедура ДоработатьМакетПоИФО(ОбластьМакета, ИспользоватьУчетПоИФО, ИспользоватьУчетПоПодразделениям, ИмяОбласти)

	Если ИспользоватьУчетПоИФО И Не ИспользоватьУчетПоПодразделениям Тогда
		
		ОбластьИФОПодразделение = ОбластьМакета.Область(ИмяОбласти + "ИФОПодразделение");
		ОбластьИФОПодразделение.Объединить();
		
	КонецЕсли;
	
	Если ИспользоватьУчетПоПодразделениям И Не ИспользоватьУчетПоИФО Тогда
		
		ОбластьИФОПодразделение = ОбластьМакета.Область(ИмяОбласти + "ИФОПодразделение");
		ОбластьПодразделение 	= ОбластьМакета.Область(ИмяОбласти + "Подразделение");
		
		Если ОбластьПодразделение.Параметр = Неопределено Тогда
			ОбластьИФОПодразделение.Текст 				= ОбластьПодразделение.Текст;
		Иначе		
			ОбластьИФОПодразделение.Параметр 			= ОбластьПодразделение.Параметр;
			ОбластьИФОПодразделение.ПараметрРасшифровки = ОбластьПодразделение.ПараметрРасшифровки;
		КонецЕсли;
		ОбластьИФОПодразделение.Объединить();
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьОбластьШапка(ОбластьШапка, ВыборкаДокументов)
	
	ПараметрыШапки = Новый Структура;
	ПараметрыШапки.Вставить("НаименованиеОрганизации", ВыборкаДокументов.ОрганизацияНаименование);
	ПараметрыШапки.Вставить("ДатаДокумента", Формат(ВыборкаДокументов.Дата, "ДЛФ=D"));
	ПараметрыШапки.Вставить("ШапкаКБК", "");
	
	ШаблонЗаголовка = НСтр("ru = 'Распределение %1 по источникам финансирования'");
	
	Если ВыборкаДокументов.ВидНалога = Перечисления.ВидыИмущественныхНалогов.ТранспортныйНалог Тогда
		ТекстПодстановки = НСтр("ru = 'транспортного налога'");
	ИначеЕсли ВыборкаДокументов.ВидНалога = Перечисления.ВидыИмущественныхНалогов.ЗемельныйНалог Тогда
		ТекстПодстановки = НСтр("ru = 'земельного налога'");
		ПараметрыШапки.ШапкаКБК = "КБК";
	ИначеЕсли ВыборкаДокументов.ВидНалога = Перечисления.ВидыИмущественныхНалогов.НалогНаИмущество Тогда
		ТекстПодстановки = НСтр("ru = 'налога на имущество'");
	КонецЕсли;
	ПараметрыШапки.Вставить("ТекстЗаголовка", СтрШаблон(ШаблонЗаголовка, ТекстПодстановки));
	
    ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаРаспределения(ОбластьСтрока, ВыборкаРаспределение,
			НомерСтрокиРаспределения, ПлательщикНалогаНаПрибыль)
			
	ОбластьСтрока.Параметры.Заполнить(ВыборкаРаспределение);
			
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("КОтражениюПорядковыйНомер", "");
	ДанныеЗаполнения.Вставить("ОтражениеВУчете", "");
	
	Если Не ЗначениеЗаполнено(ВыборкаРаспределение.НомерСтроки) Тогда
	    ОбластьСтрока.Параметры.Заполнить(ДанныеЗаполнения);
		Возврат;
	КонецЕсли;

	НомерСтрокиРаспределения = НомерСтрокиРаспределения + 1;
	
	ДанныеЗаполнения.КОтражениюПорядковыйНомер = СтрШаблон("%1.%2", 
		XMLСтрока(ВыборкаРаспределение.УчетныеДанныеНомерСтроки),
		XMLСтрока(НомерСтрокиРаспределения));
		
	ДанныеЗаполнения.ОтражениеВУчете = ТекстОтражениеВУчетеНаПечать(ВыборкаРаспределение, ПлательщикНалогаНаПрибыль);	
	
    ОбластьСтрока.Параметры.Заполнить(ДанныеЗаполнения);

КонецПроцедуры

Процедура ВыевестиНаПечатьИтоги(ТабДок, СтрокиИтоги, ОбластьСтрокаИтоги, ПлательщикНалогаНаПрибыль)
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("КОтражениюПорядковыйНомер", 0);
	ДанныеЗаполнения.Вставить("ОтражениеВУчете", "");
	
	Для каждого СтрокаИтоги Из СтрокиИтоги Цикл
		
		ОбластьСтрокаИтоги.Параметры.Заполнить(СтрокаИтоги);
		ДанныеЗаполнения.КОтражениюПорядковыйНомер = ДанныеЗаполнения.КОтражениюПорядковыйНомер + 1;
		ДанныеЗаполнения.ОтражениеВУчете = ТекстОтражениеВУчетеНаПечать(СтрокаИтоги, ПлательщикНалогаНаПрибыль);	
		ОбластьСтрокаИтоги.Параметры.Заполнить(ДанныеЗаполнения);
		ТабДок.Вывести(ОбластьСтрокаИтоги);
	
	КонецЦикла;

КонецПроцедуры

Функция ТекстОтражениеВУчетеНаПечать(ВыборкаРаспределение, ПлательщикНалогаНаПрибыль)

	ДанныеСтроки = ДанныеСтрокиОтражениеВУчетеНаПечать();
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, ВыборкаРаспределение);
	
	ПоляФормы = Новый Структура;
	ПоляФормы.Вставить("КПС",			"КПСДт");
	ПоляФормы.Вставить("Подразделение",	"ПодразделениеДт");
	ПоляФормы.Вставить("Счет",			"СчетДт");
	ПоляФормы.Вставить("Субконто1",		"СубконтоДт1");
	ПоляФормы.Вставить("Субконто2",		"СубконтоДт2");
	ПоляФормы.Вставить("Субконто3",		"СубконтоДт3");
	
	ОтражатьВНалоговомУчете = ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(ДанныеСтроки.КФО);
	
	ПараметрыОбъекта = Новый Структура;
	ПараметрыОбъекта.Вставить("ОтражатьВНалоговомУчете", ОтражатьВНалоговомУчете);
	ПараметрыОбъекта.Вставить("ОтражатьВУСНДоходыМинусРасходы", Ложь);
	ПараметрыОбъекта.Вставить("ЕстьНДС", Ложь);
	ПараметрыОбъекта.Вставить("ЕстьКПС",
		НЕ ДанныеСтроки.КПС = ДанныеСтроки.КПСДт И ЗначениеЗаполнено(ДанныеСтроки.КПСДт));
	ПараметрыОбъекта.Вставить("ЕстьКЭК", Ложь);
	ПараметрыОбъекта.Вставить("ЕстьПодразделение",
		НЕ ДанныеСтроки.Подразделение = ДанныеСтроки.ПодразделениеДт И ЗначениеЗаполнено(ДанныеСтроки.ПодразделениеДт));
	ПараметрыОбъекта.Вставить("ОтразитьВКарточкеКапвложений", ДанныеСтроки.ОтразитьВКарточкеКапвложений);
	ПараметрыОбъекта.Вставить("КарточкаКапвложений", ДанныеСтроки.КарточкаКапвложений);
	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(ДанныеСтроки, ПараметрыОбъекта, ПоляФормы);
	
	Возврат ДанныеСтроки.ОтражениеВУчете;
	
КонецФункции

Функция ДанныеСтрокиОтражениеВУчетеНаПечать()
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("Подразделение");
	ДанныеСтроки.Вставить("КФО");
	ДанныеСтроки.Вставить("КПС");
	ДанныеСтроки.Вставить("СчетДт");
	ДанныеСтроки.Вставить("ПодразделениеДт");
	ДанныеСтроки.Вставить("КПСДт");
	ДанныеСтроки.Вставить("СубконтоДт1");
	ДанныеСтроки.Вставить("СубконтоДт2");
	ДанныеСтроки.Вставить("СубконтоДт3");
	ДанныеСтроки.Вставить("СчетНУ");
	ДанныеСтроки.Вставить("СубконтоНУ1");
	ДанныеСтроки.Вставить("СубконтоНУ2");
	ДанныеСтроки.Вставить("СубконтоНУ3");
	ДанныеСтроки.Вставить("ОтражениеВУСН");
	ДанныеСтроки.Вставить("ОтразитьВКарточкеКапвложений");
	ДанныеСтроки.Вставить("КарточкаКапвложений");
	ДанныеСтроки.Вставить("ОтражениеВУчете");
	ДанныеСтроки.Вставить("ОтражениеВУчетеЗаполнено");
	
	Возврат ДанныеСтроки;
	
КонецФункции

Функция ТекстЗапросаПечатьРаспределениеПоИсточникам(НомераТаблиц)
	
	НомераТаблиц.Вставить("ВТОтражениеВУчете", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВТТаблицаРаспределения", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаРаспределение", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаИтоги", НомераТаблиц.Количество());
	
	Возврат
		"ВЫБРАТЬ
		|	ПорядокОтраженияВУчете.Ссылка КАК Ссылка,
		|	ПорядокОтраженияВУчете.НомерСтроки КАК НомерСтроки,
		|	ПорядокОтраженияВУчете.ИФО КАК ИФО,
		|	ПорядокОтраженияВУчете.Подразделение КАК Подразделение,
		|	ПорядокОтраженияВУчете.КФО КАК КФО,
		|	ПорядокОтраженияВУчете.КПС КАК КПС,
		|	ПорядокОтраженияВУчете.КЭК КАК КЭК,
		|	ПорядокОтраженияВУчете.ВидНалогаИлиПлатежа КАК ВидНалогаИлиПлатежа,
		|	ПорядокОтраженияВУчете.НалогСборПлатеж КАК НалогСборПлатеж,
		|	ПорядокОтраженияВУчете.Коэффициент КАК Коэффициент,
		|	ПорядокОтраженияВУчете.Сумма КАК Сумма,
		|	ПорядокОтраженияВУчете.СчетДт КАК СчетДт,
		|	ПорядокОтраженияВУчете.ПодразделениеДт КАК ПодразделениеДт,
		|	ПорядокОтраженияВУчете.КПСДт КАК КПСДт,
		|	ПорядокОтраженияВУчете.СубконтоДт1 КАК СубконтоДт1,
		|	ПорядокОтраженияВУчете.СубконтоДт2 КАК СубконтоДт2,
		|	ПорядокОтраженияВУчете.СубконтоДт3 КАК СубконтоДт3,
		|	ПорядокОтраженияВУчете.СчетНУ КАК СчетНУ,
		|	ПорядокОтраженияВУчете.СубконтоНУ1 КАК СубконтоНУ1,
		|	ПорядокОтраженияВУчете.СубконтоНУ2 КАК СубконтоНУ2,
		|	ПорядокОтраженияВУчете.СубконтоНУ3 КАК СубконтоНУ3,
		|	ПорядокОтраженияВУчете.ОтражениеВУСН КАК ОтражениеВУСН,
		|	ПорядокОтраженияВУчете.ОтразитьВКарточкеКапвложений КАК ОтразитьВКарточкеКапвложений,
		|	ПорядокОтраженияВУчете.КарточкаКапвложений КАК КарточкаКапвложений,
		|	ПорядокОтраженияВУчете.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ПОМЕСТИТЬ ВТОтражениеВУчете
		|ИЗ
		|	Документ.НачислениеИмущественныхНалогов.ПорядокОтраженияВУчете КАК ПорядокОтраженияВУчете
		|ГДЕ
		|	ПорядокОтраженияВУчете.Ссылка В(&Ссылка)
		|
