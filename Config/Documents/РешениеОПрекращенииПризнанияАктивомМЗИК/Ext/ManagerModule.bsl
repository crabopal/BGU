	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Основание.Ссылка КАК Ссылка,
	|	Основание.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	Основание.ДокументИнвентаризации.Номер КАК Номер,
	|	Основание.ДокументИнвентаризации.Дата КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(Основание.СчетУчета) КАК КодСчета,
	|	ПРЕДСТАВЛЕНИЕ(Основание.КФО) КАК КФО
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивомМЗИК.Основание КАК Основание
	|ГДЕ
	|	Основание.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Основание.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Файлы.ВладелецФайла КАК Ссылка,
	|	Файлы.Ссылка КАК Файл,
	|	Файлы.Наименование КАК ИмяФайла,
	|	Файлы.Описание КАК Описание
	|ИЗ
	|	Справочник.Файлы КАК Файлы
	|ГДЕ
	|	Файлы.ВладелецФайла В(&МассивОбъектов)
	|	И НЕ Файлы.Служебный
	|	И НЕ Файлы.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеДокументов = Новый Структура;
	ДанныеДокументов.Вставить("ВыборкаДокументов"	, РезультатЗапроса[0].Выбрать());
	ДанныеДокументов.Вставить("ВыборкаОС"			, РезультатЗапроса[1].Выбрать());
	ДанныеДокументов.Вставить("ВыборкаОпись"		, РезультатЗапроса[2].Выбрать());
	ДанныеДокументов.Вставить("Драгметаллы"			, Неопределено);
	ДанныеДокументов.Вставить("ПТС"					, Неопределено);
	ДанныеДокументов.Вставить("ЕГРН"				, Неопределено);
	ДанныеДокументов.Вставить("Характеристики"		, Неопределено);
	ДанныеДокументов.Вставить("ВыборкаФайлы"		, РезультатЗапроса[3].Выбрать());
	
	Возврат ДанныеДокументов;
	
КонецФункции

Функция ДанныеДляПечати(МассивОбъектов)
	
	ДанныеДокументов = ДанныеИзБазыДляПечати(МассивОбъектов);
	
	ВыборкаДокументов	= ДанныеДокументов.ВыборкаДокументов;
	ВыборкаОС			= ДанныеДокументов.ВыборкаОС;
	ВыборкаОпись		= ДанныеДокументов.ВыборкаОпись;
	ВыборкаФайлы		= ДанныеДокументов.ВыборкаФайлы;
	
	РезультатыГолосования = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(МассивОбъектов);
	ТаблицаДокументов = УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиРешениеОПрекращенииПризнанияАктивом0510440();
	
	Пока ВыборкаДокументов.Следующий() Цикл

		СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		
		СтрокаДокумента = ТаблицаДокументов.Добавить();
		
		// Шапка
		
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ВыборкаДокументов);
		СтрокаДокумента.НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер);
		
		// Данные руководителя
		Если ЗначениеЗаполнено(ВыборкаДокументов.Руководитель) Тогда
			ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(ВыборкаДокументов.Руководитель,
				"Фамилия, Имя, Отчество, Должность, ДолжностьНаименование, Подразделение", ВыборкаДокументов.ДатаАкта, Истина);
			ФИОРуководителя = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);                 
			ДолжностьРуководителя = ДанныеСотрудника.ДолжностьНаименование;
		Иначе	
			Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
				Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ВыборкаДокументов.Организация,
				ВыборкаДокументов.ДатаАкта, ВыборкаДокументов.СтруктурноеПодразделение);
			ФИОРуководителя = КорреспондентыКлиентСервер.ФИО(Руководитель, Истина, "ОтветственноеЛицо");
			ДолжностьРуководителя = Руководитель.ДолжностьПредставление;
		КонецЕсли;	
		СтрокаДокумента.ДолжностьРуководителя = ДолжностьРуководителя;
		СтрокаДокумента.ФИОРуководителя = ФИОРуководителя;
		
		СтрокаДокумента.ИнвентаризационныеОписи = УправлениеПечатьюБГУ.ТаблицаИнвентаризационныеОписиДляПечатиРешениеОПрекращенииПризнанияАктивом0510440();
		Пока ВыборкаОпись.НайтиСледующий(СтруктураПоиска) Цикл
			
			СтрокаОпись = СтрокаДокумента.ИнвентаризационныеОписи.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОпись, ВыборкаОпись);
			ПредставлениеСчета = ?(ЗначениеЗаполнено(ВыборкаОпись.КодСчета), ?(ЗначениеЗаполнено(ВыборкаОпись.КФО), Строка(ВыборкаОпись.КФО), "0")
				+ " " + СтрЗаменить(ВыборкаОпись.КодСчета, ".", " ") + " 000", "-");
			СтрокаОпись.Счет = ПредставлениеСчета;
			
		КонецЦикла;
		
		СтрокаДокумента.СведенияОбОбъектах = УправлениеПечатьюБГУ.ТаблицаСведенияОбОбъектахДляПечатиРешениеОПрекращенииПризнанияАктивом0510440();
		СтрокаДокумента.ХарактеристикиОбъектов = УправлениеПечатьюБГУ.ТаблицаХарактеристикиОбъектовДляПечатиРешениеОПрекращенииПризнанияАктивом0510440();

		// Раздел 3
		
		ВыборкаОС.Сбросить();
		
		СтрокаДокумента.ЗаключениеПоОбъектам = УправлениеПечатьюБГУ.ТаблицаЗаключениеПоОбъектамДляПечатиРешениеОПрекращенииПризнанияАктивом0510440();
		Пока ВыборкаОС.НайтиСледующий(СтруктураПоиска) Цикл
			
			СтрокаЗаключения = СтрокаДокумента.ЗаключениеПоОбъектам.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЗаключения, ВыборкаОС);
			СтрокаЗаключения.КодСчета = УправлениеПечатьюБГУ.ПредставлениеСчета(ВыборкаОС,, Истина);
			
			// Результаты голосования комиссии по строке документа.
			ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки",
			ВыборкаДокументов.Ссылка, ВыборкаОС.ИдентификаторСтроки);
			РезультатыГолосованияПоСтроке = РезультатыГолосования.НайтиСтроки(ОтборПоИдентификаторуСтроки);
			Если РезультатыГолосованияПоСтроке.Количество() > 0
				И РезультатыГолосованияПоСтроке[0].ГолосованиеПоСтрокеЗавершено Тогда
				СтрокаЗаключения.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
				СтрокаЗаключения.РезолюцияИтог = ?(РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена,
					"", НСтр("ru = 'снято с обсуждения'"));
			КонецЕсли;
			
		КонецЦикла;
		
		// Приложения
		
		СтрокаДокумента.Файлы = УправлениеПечатьюБГУ.ТаблицаФайлыДляПечатиПриказ61н();
		Пока ВыборкаФайлы.НайтиСледующий(СтруктураПоиска) Цикл
			СтрокаФайлы = СтрокаДокумента.Файлы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаФайлы, ВыборкаФайлы);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаДокументов;
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
