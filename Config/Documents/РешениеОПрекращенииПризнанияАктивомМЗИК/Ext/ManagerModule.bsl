#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииОграниченияДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы.
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Номенклатура");
	ИменаРеквизитов.Добавить("СчетУчета");
	ИменаРеквизитов.Добавить("ДополнительнаяАналитикаСчета");
	ИменаРеквизитов.Добавить("КПС");
	ИменаРеквизитов.Добавить("КФО");
	ИменаРеквизитов.Добавить("Количество");
	ИменаРеквизитов.Добавить("Сумма");
	Результат.Вставить("Материалы", ИменаРеквизитов);
	Возврат Результат;
КонецФункции

// Текст запроса таблицы для расчета движений.
// 
// Возвращаемое значение:
//  Строка - Текст запроса таблицы для расчета движений
Функция ТекстЗапросаТаблицыДляРасчетаДвижений() Экспорт
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РешениеОПрекращенииПризнанияАктивомМЗИКМатериалы.Ссылка КАК Ссылка,
	|	РешениеОПрекращенииПризнанияАктивомМЗИКМатериалы.НомерСтроки,
	|	РешениеОПрекращенииПризнанияАктивомМЗИКМатериалы.Номенклатура,
	|	РешениеОПрекращенииПризнанияАктивомМЗИКМатериалы.Количество,
	|	РешениеОПрекращенииПризнанияАктивомМЗИКМатериалы.КПС,
	|	РешениеОПрекращенииПризнанияАктивомМЗИКМатериалы.КФО КАК КФО,
	|	РешениеОПрекращенииПризнанияАктивомМЗИКМатериалы.СчетУчета,
	|	РешениеОПрекращенииПризнанияАктивомМЗИКМатериалы.КЭК,
	|	РешениеОПрекращенииПризнанияАктивомМЗИКМатериалы.ДополнительнаяАналитикаСчета,
	|	РешениеОПрекращенииПризнанияАктивомМЗИКМатериалы.Ссылка.Дата КАК Дата,
	|	РешениеОПрекращенииПризнанияАктивомМЗИКМатериалы.Ссылка.Организация КАК Организация,
	|	РешениеОПрекращенииПризнанияАктивомМЗИКМатериалы.Ссылка.ИФО КАК ИФО
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивомМЗИК.Материалы КАК РешениеОПрекращенииПризнанияАктивомМЗИКМатериалы
	|ГДЕ
	|	РешениеОПрекращенииПризнанияАктивомМЗИКМатериалы.Ссылка В (&МассивОбъектов)";
КонецФункции

// Подготовить таблицу списание материальных запасов по документу.
// 
// Параметры:
//  Документ - ДокументОбъект.РешениеОПрекращенииПризнанияАктивомМЗИК
//  Параметры - Структура
// 
// Возвращаемое значение:
//  см. УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу 
Функция ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(Документ, Параметры) Экспорт
	Параметры.Вставить("НеПроверятьЗаполнение", Истина);
	ТаблицаДокумента = УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу();
	НеПересчитыватьСумму = Не Справочники.Организации.ПолучитьУчетнуюПолитику(Документ.Организация, Документ.Дата)
		.ВедениеАналитическогоУчетаИмуществаКазны;
	
	ИмяСписка = "Материалы";
	СинонимСписка = Документ.Метаданные().ТабличныеЧасти.Материалы.Синоним;
	
	Для Каждого СтрокаДокумента Из Документ.Материалы Цикл
		НоваяСтрока = ТаблицаДокумента.Добавить();
		НоваяСтрока.ИмяСписка = ИмяСписка;
		НоваяСтрока.СинонимСписка = СинонимСписка;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента,
			"НомерСтроки, КПС, КЭК, СчетУчета, Номенклатура, Количество");
		НоваяСтрока.СуммаСписания = СтрокаДокумента.Сумма;
		НоваяСтрока.НеПересчитыватьСумму = НеПересчитыватьСумму;
		НоваяСтрока.ДопАналитика = СтрокаДокумента.ДополнительнаяАналитикаСчета;
		НоваяСтрока.ДопИзмерение = Документ.ЦМО;
		НоваяСтрока.ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
		НоваяСтрока.ИФО = Документ.ИФО;
		НоваяСтрока.Подразделение = Документ.Подразделение;
		НоваяСтрока.ПодразделениеПолучатель = Документ.Подразделение;
		НоваяСтрока.КФО = Перечисления.КВД.Бюджет;
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Формирует таблицу разделителей документов для целей формирования текущего документа по данным инвентаризационной описи.
//
// Параметры:
//  ДокОснование - ДокументСсылка - документ, по данным которого заполняется текущий документ
//  СсылкаЦелевогоДокумента - ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗИК -
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица разделителей с полями:
//   * ЦМО - СправочникСсылка.ЦМО
//   * Подразделение - СправочникСсылка.Подразделения
Функция ТаблицаРазделителейДокументов(ДокОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокОснование, СсылкаЦелевогоДокумента);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СправочникЦМО.Ссылка КАК ЦМО,
	|	ДанныеИнвентаризации.Подразделение КАК Подразделение
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ДанныеИнвентаризации.МОЛШапки = СправочникЦМО.Сотрудник
	|			И ДанныеИнвентаризации.МестоИнвентаризации = СправочникЦМО.МестоХранения
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 9
	|	И ДанныеИнвентаризации.Счет В (&ДопустимыеСчета)
	|	И ДанныеИнвентаризации.МестоИнвентаризации ССЫЛКА Справочник.МестаХранения
	|	И (ДанныеИнвентаризации.КоличествоНеСоответствует <> 0
	|			ИЛИ ДанныеИнвентаризации.СуммаНеСоответствует <> 0)
	|			
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СправочникЦМО.Ссылка КАК ЦМО,
	|	ДанныеИнвентаризации.Подразделение КАК Подразделение
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ДанныеИнвентаризации.МОЛШапки = СправочникЦМО.Сотрудник
	|			И СправочникЦМО.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 9
	|	И ДанныеИнвентаризации.Счет В (&ДопустимыеСчета)
	|	И ТИПЗНАЧЕНИЯ(ДанныеИнвентаризации.МестоИнвентаризации) = ТИП(СТРОКА)
	|	И (ДанныеИнвентаризации.КоличествоНеСоответствует <> 0
	|			ИЛИ ДанныеИнвентаризации.СуммаНеСоответствует <> 0)";
	
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	Запрос.УстановитьПараметр("ДопустимыеСчета", ДопустимыеСчетаДокумента());
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	Возврат 
	"ВЫБРАТЬ
	|	Материалы.Ссылка КАК ДокументОтклонения,
	|	Материалы.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	Материалы.Номенклатура КАК НФА,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.НеАктивы) КАК ВидОтклонения,
	|	Материалы.Ссылка.ЦМО.МестоХранения КАК МестоИнвентаризации,
	|	Материалы.Количество КАК Количество
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивомМЗИК.Материалы КАК Материалы
	|ГДЕ
	|	Материалы.ДокументИнвентаризации В(&ДокументыИнвентаризации)
	|	И НЕ Материалы.Ссылка.ПометкаУдаления
	|	И Материалы.Ссылка <> &РешениеОПрекращенииПризнанияАктивомМЗИКСсылка";
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Параметры заполнения КЭК в табличных частях документа:
//  - Имена табличных частей, содержащих КЭК.
//  - сторона проводки - Дт или Кт.
// 
// Возвращаемое значение:
//  Структура:
//   * ДтКт - Строка - "Дт" или "Кт"
//   * Включать105 - Булево - счета 105 не учитываются, при заполнении
//   * Включать108 - Булево - счета 108 учитываются
//   * ИменаТабличныхЧастей - Массив из Строка - Имена табличных частей содержащих КЭК
Функция ПараметрыЗаполненияКЭК() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ДтКт", "Кт");
	Результат.Вставить("Включать105", Ложь);
	Результат.Вставить("Включать108", Истина);
	ИменаТабличныхЧастей = Новый Массив;
	ИменаТабличныхЧастей.Добавить("Материалы");
	Результат.Вставить("ИменаТабличныхЧастей", ИменаТабличныхЧастей);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

// Заполнить по инвентаризации.
// 
// Параметры:
//  ДокументыИнвентаризации - ДокументСсылка.ИнвентаризацияИК
//                          - Массив из ДокументСсылка.ИнвентаризацияИК
//  ЗаполняемыйДокумент - ДокументОбъект.РешениеОПрекращенииПризнанияАктивомМЗИК
//                      - ДанныеФормыСтруктура
Процедура ЗаполнитьПоИнвентаризации(ДокументыИнвентаризации, ЗаполняемыйДокумент) Экспорт
	
	ДокументыИнвентаризацииИК = Новый Массив; // Массив из ДокументСсылка.ИнвентаризацияИК
	ДокументыИнвентаризации0510466 = Новый Массив; // Массив из ДокументСсылка.ИнвентаризационнаяОписьНФА
	
	Если ТипЗнч(ДокументыИнвентаризации) = Тип("Массив") Тогда
		Для Каждого Документ Из ДокументыИнвентаризации Цикл
			Если ТипЗнч(Документ) = Тип("ДокументСсылка.ИнвентаризацияИК") Тогда
				ДокументыИнвентаризацииИК.Добавить(Документ);
			ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
				ДокументыИнвентаризации0510466.Добавить(Документ);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДокументыИнвентаризации) = Тип("ДокументСсылка.ИнвентаризацияИК") Тогда
		ДокументыИнвентаризацииИК.Добавить(ДокументыИнвентаризации);
	ИначеЕсли ТипЗнч(ДокументыИнвентаризации) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		ДокументыИнвентаризации0510466.Добавить(ДокументыИнвентаризации);
	КонецЕсли;
	
	Если ДокументыИнвентаризацииИК.Количество() = 0 И ДокументыИнвентаризации0510466.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаполняемыйДокумент.Дата) Тогда
		ЗаполняемыйДокумент.Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	ЗаполняемыйДокумент.Материалы.Очистить();
	ЗаполнитьПоИнвентаризацииИК(ДокументыИнвентаризацииИК, ЗаполняемыйДокумент);
	ЗаполнитьПоИнвентаризации0510466(ДокументыИнвентаризации0510466, ЗаполняемыйДокумент);

КонецПроцедуры

// Заполнить по инвентаризации МЗ.
// 
// Параметры:
//  ДокументыИнвентаризации - ДокументСсылка.ИнвентаризацияИК
//                          - Массив из ДокументСсылка.ИнвентаризацияИК
//  ЗаполняемыйДокумент - ДокументОбъект.РешениеОПрекращенииПризнанияАктивомМЗИК
//                      - ДанныеФормыСтруктура
Процедура ЗаполнитьПоИнвентаризацииИК(ДокументыИнвентаризации, ЗаполняемыйДокумент)
	Если ЗаполняемыйДокумент.Ссылка.Пустая() Тогда
		Период = КонецДня(ЗаполняемыйДокумент.Дата);
	Иначе
		Период = ЗаполняемыйДокумент.Дата;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",      ДокументыИнвентаризации);
	Запрос.УстановитьПараметр("Период",      Период);
	Запрос.УстановитьПараметр("Организация", ЗаполняемыйДокумент.Организация);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Инвентаризация.Номенклатура КАК Номенклатура,
	|	Инвентаризация.Счет КАК СчетУчета,
	|	Инвентаризация.СтатусОбъекта КАК СтатусОбъекта,
	|	Инвентаризация.ЦелеваяФункцияАктива КАК ЦелеваяФункцияАктива,
	|	СУММА(Инвентаризация.КоличествоНеСоответствует) КАК Количество,
	|	СУММА(Инвентаризация.СуммаНеСоответствует) КАК Сумма,
	|	ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет) КАК КФО,
	|	Инвентаризация.КПС,
	|	Инвентаризация.Ссылка КАК ДокументИнвентаризации
	|ИЗ
	|	Документ.ИнвентаризацияИК.Инвентаризация КАК Инвентаризация
	|ГДЕ
	|	Инвентаризация.Ссылка В (&Ссылка)
	|	И (Инвентаризация.КоличествоНеСоответствует <> 0)
	|СГРУППИРОВАТЬ ПО
	|	Инвентаризация.Номенклатура,
	|	Инвентаризация.Счет,
	|	Инвентаризация.СтатусОбъекта,
	|	Инвентаризация.ЦелеваяФункцияАктива,
	|	Инвентаризация.КПС,
	|	Инвентаризация.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Инвентаризация.Номенклатура.Наименование";
	
	Выборка = Запрос.Выполнить().Выбрать();

	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(ЗаполняемыйДокумент);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет", Ложь);
	ПараметрыОбработки.Вставить("ДтКт",          "Кт");

	Пока Выборка.Следующий() Цикл
		СтрокаМатериалы = ЗаполняемыйДокумент.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаМатериалы, Выборка);
		СтрокаМатериалы.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		ПараметрыОбработки.Номенклатура = СтрокаМатериалы.Номенклатура;
		ПараметрыОбработки.Счет         = СтрокаМатериалы.СчетУчета;
		
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(СтрокаМатериалы, ПараметрыОбработки);
	КонецЦикла;
	
КонецПроцедуры

// Заполнить по инвентаризации0510466.
// 
// Параметры:
//  ДокументыИнвентаризации - Массив из ДокументСсылка.ИнвентаризационнаяОписьНФА - Документы инвентаризации
//  ЗаполняемыйДокумент - ДокументОбъект.РешениеОПрекращенииПризнанияАктивомМЗИК, ДанныеФормыСтруктура - Заполняемый документ
Процедура ЗаполнитьПоИнвентаризации0510466(ДокументыИнвентаризации, ЗаполняемыйДокумент) 
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокументыИнвентаризации);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	ДанныеИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	ДанныеИнвентаризации.НФА КАК НФА,
	|	КОЛИЧЕСТВО(*) КАК КоличествоСтрок,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеИнвентаризации.КФО) КАК КоличествоКФО,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеИнвентаризации.КПС) КАК КоличествоКПС,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеИнвентаризации.Счет) КАК КоличествоСчет
	|ПОМЕСТИТЬ СгруппированныеСтроки
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации В(&Документы466)
	|	И ДанныеИнвентаризации.ВидОбъекта = 9
	|	И ДанныеИнвентаризации.ЦМОРаздела1 = &ЦМО
	|	И ДанныеИнвентаризации.ИФО = &ИФО
	|	И ДанныеИнвентаризации.Счет В(&ДопустимыеСчета)
	|	И (НЕ &УчетПоПодразделениям
	|			ИЛИ НЕ ЕСТЬNULL(ДанныеИнвентаризации.Счет.УчетПоПодразделениям, ЛОЖЬ)
	|			ИЛИ ДанныеИнвентаризации.Подразделение = &Подразделение)
	|	И (ДанныеИнвентаризации.КоличествоНеСоответствует <> 0
	|			ИЛИ ДанныеИнвентаризации.СуммаНеСоответствует <> 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеИнвентаризации.ДокументИнвентаризации,
	|	ДанныеИнвентаризации.НомерСтроки,
	|	ДанныеИнвентаризации.НФА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	ДанныеИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА СгруппированныеСтроки.КоличествоКФО = 1
	|			ТОГДА ДанныеИнвентаризации.КФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)
	|	КОНЕЦ КАК КФО,
	|	ВЫБОР
	|		КОГДА СгруппированныеСтроки.КоличествоКПС = 1
	|			ТОГДА ДанныеИнвентаризации.КПС
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|	КОНЕЦ КАК КПС,
	|	ВЫБОР
	|		КОГДА СгруппированныеСтроки.КоличествоСчет = 1
	|			ТОГДА ДанныеИнвентаризации.Счет
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	КОНЕЦ КАК СчетУчета,
	|	ВЫРАЗИТЬ(ДанныеИнвентаризации.НФА КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ДанныеИнвентаризации.СтатусОбъекта КАК СтатусОбъекта,
	|	ДанныеИнвентаризации.ЦелеваяФункцияАктива КАК ЦелеваяФункцияАктива,
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.Количество < ДанныеИнвентаризации.КоличествоНеСоответствует
	|			ТОГДА ДанныеИнвентаризации.Количество
	|		ИНАЧЕ ДанныеИнвентаризации.КоличествоНеСоответствует
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.Количество < ДанныеИнвентаризации.КоличествоНеСоответствует
	|			ТОГДА ДанныеИнвентаризации.Количество * ДанныеИнвентаризации.СуммаНеСоответствует / ДанныеИнвентаризации.КоличествоНеСоответствует
	|		ИНАЧЕ ДанныеИнвентаризации.СуммаНеСоответствует
	|	КОНЕЦ КАК Сумма
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СгруппированныеСтроки КАК СгруппированныеСтроки
	|		ПО ДанныеИнвентаризации.ДокументИнвентаризации = СгруппированныеСтроки.ДокументИнвентаризации
	|			И ДанныеИнвентаризации.НомерСтроки = СгруппированныеСтроки.НомерСтроки
	|			И ДанныеИнвентаризации.НФА = СгруппированныеСтроки.НФА
	|ГДЕ
	|	ДанныеИнвентаризации.Счет В(&ДопустимыеСчета)";
	Запрос.УстановитьПараметр("Документы466", ДокументыИнвентаризации);
	Запрос.УстановитьПараметр("ЦМО", ЗаполняемыйДокумент.ЦМО);
	Запрос.УстановитьПараметр("ИФО", ЗаполняемыйДокумент.ИФО);
	Запрос.УстановитьПараметр("Подразделение", ЗаполняемыйДокумент.Подразделение);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запрос.УстановитьПараметр("ДопустимыеСчета", ДопустимыеСчетаДокумента());
	
	Выборка = Запрос.Выполнить().Выбрать();

	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(ЗаполняемыйДокумент);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет", Ложь);
	ПараметрыОбработки.Вставить("ДтКт",          "Кт");

	Пока Выборка.Следующий() Цикл
		СтрокаМатериалы = ЗаполняемыйДокумент.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаМатериалы, Выборка);
		СтрокаМатериалы.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		ПараметрыОбработки.Номенклатура = СтрокаМатериалы.Номенклатура;
		ПараметрыОбработки.Счет         = СтрокаМатериалы.СчетУчета;
		
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(СтрокаМатериалы, ПараметрыОбработки);
	КонецЦикла;

КонецПроцедуры

Функция ДопустимыеСчетаДокумента()
	Возврат БухгалтерскийУчет.СписокСчетов("108.00");
