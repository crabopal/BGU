#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ДанныеЗаполнения.Свойство("ДокументОснование", ДокументОснование);
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения,
				"Дата,Организация,ИФО,КФО,Контрагент,Ответственный");
			
			Отбор.Очистить();
			Если ДанныеЗаполнения.Свойство("Договор") Тогда
				ОтборПоДоговору = Отбор.Добавить();
				ОтборПоДоговору.Договор = ДанныеЗаполнения.Договор;
			КонецЕсли;
			
			ЗаполнитьДокумент();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДанныеЗаполнения <> Неопределено И ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") тогда
		ТекстСообщения = "";
		Если НЕ Документы.СписаниеДоходовБудущихПериодов.ЗаполнитьНаОсновании(ДанныеЗаполнения, ЭтотОбъект, ТекстСообщения) тогда
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	РеквизитыСчетаРБП = Новый Структура("Счет, КПС, КЭК, Подразделение",
		"СчетДБП", "КПС", "КЭК", "Подразделение");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаРБП,
		ЭтотОбъект, "ДоходыБудущихПериодов", Отказ);
	
	РеквизитыСчетаРасходов = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
		"СчетДоходов", "СубконтоДоходов1", "СубконтоДоходов2", "СубконтоДоходов3");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаРасходов,
		ЭтотОбъект, "ДоходыБудущихПериодов", Отказ);
	
	ПлательщикНалогаНаПрибыль = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Организация, Дата);
	Для Каждого СтрокаТаблицы Из ДоходыБудущихПериодов Цикл
		
		Если (СтрокаТаблицы.Всего <> СтрокаТаблицы.ВсегоСправедливая)
			И СтрокаТаблицы.ВидОперации <> Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях
			И СтрокаТаблицы.ВидОперации <> Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru='
				|Для вида операции ""%1"" справедливая стоимость (%2) должна совпадать с суммой по договору (%3).'"),
					СтрокаТаблицы.ВидОперации,
					СтрокаТаблицы.ВсегоСправедливая,
					СтрокаТаблицы.Всего);
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				НСтр("ru = 'Сумма по договору'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Доходы будущих периодов'"), ТекстОшибки);
			ПолеОшибки = "ДоходыБудущихПериодов[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Всего";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект", Отказ);
		КонецЕсли;
		
		Если ПлательщикНалогаНаПрибыль И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаТаблицы.КФО) Тогда
			
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ВидДеятельностиНУ) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru = 'Вид деятельности (НУ)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Доходы будущих периодов'"));
				ПолеОшибки = "ДоходыБудущихПериодов[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ВидДеятельностиНУ";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект", Отказ);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетДоходовНУ) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru = 'Счет доходов (НУ)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Доходы будущих периодов'"));
				ПолеОшибки = "ДоходыБудущихПериодов[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СчетДоходовНУ";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект", Отказ);
				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СтатьяПрочихДоходовНУ)
				И БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.СчетДоходовНУ, "Н91.01") Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru = 'Статья прочих доходов (НУ)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Доходы будущих периодов'"));
				ПолеОшибки = "ДоходыБудущихПериодов[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СтатьяПрочихДоходовНУ";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект", Отказ);
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	МассивИдентификаторовСтрок = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		//Если ссылка пустая, значит документ новый, устанавливаем новые идентификаторы всем строкам
		Для Каждого СтрТЧ Из ДоходыБудущихПериодов Цикл
			Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки) Тогда
				СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);			
			ИначеЕсли МассивИдентификаторовСтрок.Найти(СтрТЧ.ИДСтроки)<>Неопределено Тогда
				СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			МассивИдентификаторовСтрок.Добавить(СтрТЧ.ИДСтроки);
		КонецЦикла;
	Иначе
		//Если ссылка не пустая, нужен анализ идентификаторов строк.
		//Т.к. возможна ситуация, когда строку скопировали, а исходную - удалили.
		//В этом случае нужно ранее присвоенные идентификаторы назначить новым строкам.
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Начисления.НомерСтроки КАК НомерСтроки,
		|	Начисления.Контрагент КАК Контрагент,
		|	Начисления.Договор КАК Договор,
		|	Начисления.Номенклатура КАК Номенклатура,
		|	Начисления.КПС КАК КПС,
		|	Начисления.КФО КАК КФО,
		|	Начисления.КЭК КАК КЭК,
		|	Начисления.ИДСтроки КАК ИДСтроки
		|ПОМЕСТИТЬ ТекущиеНачисления
		|ИЗ
		|	&Начисления КАК Начисления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоходыБудущихПериодов.НомерСтроки КАК НомерСтроки,
		|	ДоходыБудущихПериодов.Контрагент КАК Контрагент,
		|	ДоходыБудущихПериодов.Договор КАК Договор,
		|	ДоходыБудущихПериодов.Номенклатура КАК Номенклатура,
		|	ДоходыБудущихПериодов.КПС КАК КПС,
		|	ДоходыБудущихПериодов.КФО КАК КФО,
		|	ДоходыБудущихПериодов.КЭК КАК КЭК,
		|	ДоходыБудущихПериодов.ИДСтроки КАК ИДСтроки
		|ПОМЕСТИТЬ ДанныеДокумента
		|ИЗ
		|	Документ.СписаниеДоходовБудущихПериодов.ДоходыБудущихПериодов КАК ДоходыБудущихПериодов
		|ГДЕ
		|	ДоходыБудущихПериодов.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТекущиеНачисления.НомерСтроки КАК НомерСтроки,
		|	ТекущиеНачисления.Контрагент КАК Контрагент,
		|	ТекущиеНачисления.Договор КАК Договор,
		|	ТекущиеНачисления.Номенклатура КАК Номенклатура,
		|	ТекущиеНачисления.КПС КАК КПС,
		|	ТекущиеНачисления.КФО КАК КФО,
		|	ТекущиеНачисления.КЭК КАК КЭК,
		|	ТекущиеНачисления.ИДСтроки КАК ИДСтроки,
		|	ДанныеДокумента.НомерСтроки КАК НомерСтрокиИсх,
		|	ДанныеДокумента.ИДСтроки КАК ИДСтрокиИсх,
		|	ДанныеДокумента.Номенклатура КАК НоменклатураИсх,
		|	ДанныеДокумента.Контрагент КАК КонтрагентИсх,
		|	ДанныеДокумента.КПС КАК КПСИсх,
		|	ДанныеДокумента.КФО КАК КФОИсх,
		|	ДанныеДокумента.КЭК КАК КЭКИсх,
		|	ДанныеДокумента.Договор КАК ДоговорИсх
		|ПОМЕСТИТЬ СвязанныеТаблицы
		|ИЗ
		|	ТекущиеНачисления КАК ТекущиеНачисления
		|		ПОЛНОЕ СОЕДИНЕНИЕ ДанныеДокумента КАК ДанныеДокумента
		|		ПО ТекущиеНачисления.Контрагент = ДанныеДокумента.Контрагент
		|			И ТекущиеНачисления.Договор = ДанныеДокумента.Договор
		|			И ТекущиеНачисления.Номенклатура = ДанныеДокумента.Номенклатура
		|			И ТекущиеНачисления.КПС = ДанныеДокумента.КПС
		|			И ТекущиеНачисления.КФО = ДанныеДокумента.КФО
		|			И ТекущиеНачисления.КЭК = ДанныеДокумента.КЭК
		|			И ТекущиеНачисления.ИДСтроки = ДанныеДокумента.ИДСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СвязанныеТаблицы.НомерСтрокиИсх КАК НомерСтрокиИсх,
		|	СвязанныеТаблицы.ИДСтрокиИсх КАК ИДСтрокиИсх,
		|	СвязанныеТаблицы.КонтрагентИсх КАК КонтрагентИсх,
		|	СвязанныеТаблицы.НоменклатураИсх КАК НоменклатураИсх,
		|	СвязанныеТаблицы.КПСИсх КАК КПСИсх,
		|	СвязанныеТаблицы.КФОИсх КАК КФОИсх,
		|	СвязанныеТаблицы.КЭКИсх КАК КЭКИсх,
		|	СвязанныеТаблицы.ДоговорИсх КАК ДоговорИсх
		|ПОМЕСТИТЬ СвободныеИдентификаторы
		|ИЗ
		|	СвязанныеТаблицы КАК СвязанныеТаблицы
		|ГДЕ
		|	СвязанныеТаблицы.НомерСтроки ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СвязанныеТаблицы.НомерСтроки КАК НомерСтроки,
		|	СвободныеИдентификаторы.ИДСтрокиИсх КАК ИДСтрокиИсх
		|ИЗ
		|	СвязанныеТаблицы КАК СвязанныеТаблицы
		|		ЛЕВОЕ СОЕДИНЕНИЕ СвободныеИдентификаторы КАК СвободныеИдентификаторы
		|		ПО СвязанныеТаблицы.Контрагент = СвободныеИдентификаторы.КонтрагентИсх
		|			И СвязанныеТаблицы.Договор = СвободныеИдентификаторы.ДоговорИсх
		|			И СвязанныеТаблицы.Номенклатура = СвободныеИдентификаторы.НоменклатураИсх
		|			И СвязанныеТаблицы.КПС = СвободныеИдентификаторы.КПСИсх
		|			И СвязанныеТаблицы.КФО = СвободныеИдентификаторы.КФОИсх
		|			И СвязанныеТаблицы.КЭК = СвободныеИдентификаторы.КЭКИсх
		|ГДЕ
		|	СвязанныеТаблицы.НомерСтрокиИсх ЕСТЬ NULL
		|	И НЕ СвободныеИдентификаторы.ИДСтрокиИсх ЕСТЬ NULL
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки
		|ИТОГИ ПО
		|	НомерСтроки");
		Запрос.УстановитьПараметр("Начисления",ДоходыБудущихПериодов.Выгрузить());
		Запрос.УстановитьПараметр("Ссылка",Ссылка);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Для Каждого СтрТЧ Из ДоходыБудущихПериодов Цикл
			Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки) Тогда
				Если Выборка.НайтиСледующий(Новый Структура("НомерСтроки",СтрТЧ.НомерСтроки)) Тогда
					ВыборкаДетальная = Выборка.Выбрать();
					Пока ВыборкаДетальная.Следующий() Цикл
						Если МассивИдентификаторовСтрок.Найти(ВыборкаДетальная.ИДСтрокиИсх) = Неопределено Тогда
							СтрТЧ.ИДСтроки = ВыборкаДетальная.ИДСтрокиИсх;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки) Тогда
					СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
				КонецЕсли;
			ИначеЕсли МассивИдентификаторовСтрок.Найти(СтрТЧ.ИДСтроки)<>Неопределено Тогда
				СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			МассивИдентификаторовСтрок.Добавить(СтрТЧ.ИДСтроки);
		КонецЦикла;
	КонецЕсли;
	
	Если ТипПериода = 0 Тогда // За месяц.
		Дата = КонецМесяца(Дата);
	КонецЕсли;
	
	СуммаДокумента = ДоходыБудущихПериодов.Итог("ВсегоСправедливая");
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ЗаполнитьДокумент() Экспорт
	
	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	ДоходыБудущихПериодов.Очистить();
	
	ЭтоДоходыТекущегоПериодаПриКорректировкеДБП = ЗначениеЗаполнено(ДокументОснование);
	
	Запрос = Новый Запрос;
	
	Если ТипПериода = 0 Тогда // За месяц.
		Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Дата));
		Запрос.УстановитьПараметр("КонецПериода",  Новый Граница(КонецМесяца(Дата), ВидГраницы.Включая));
	ИначеЕсли ТипПериода = 1 Тогда // На дату.
		Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Дата));
