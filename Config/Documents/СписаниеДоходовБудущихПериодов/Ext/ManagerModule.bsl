// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти
	
#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

// Подготовить таблицу расчетов по документу (в унифицированном формате) для источника данных ТаблицаРасчетовСЗачетомАвансов.
// 
// Параметры:
//  Документ - ДокументОбъект.НачислениеЗаУслугиОбразования
//  Параметры - Структура - Параметры 
//  Отказ - Булево
// 
// Возвращаемое значение:
//  см. УчетРасчетов.ПустаяТаблицаРасчетовПоДокументу
Функция ПодготовитьТаблицуРасчетовПоДокументу(Документ, Параметры, Отказ) Экспорт
	
	ТаблицаРасчетов = УчетРасчетов.ПустаяТаблицаРасчетовПоДокументу();
	// Рублевая сумма рассчитывается по курсу, определяемому по остатку 401.4х.
	//ТаблицаРасчетов.Колонки.Добавить("СуммаРубПоКурсуДБП", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18, 2));
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ДоходыБудущихПериодов",
		"ИФО,КФО,КПС,КЭК,Подразделение,Контрагент,Договор,Валюта,ОстатокДБП,ОстатокДБПВВалюте,СуммаНДС,Всего",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	ДоходыБудущихПериодов.ИФО КАК ИФО,
	|	ДоходыБудущихПериодов.КФО КАК КФО,
	|	ДоходыБудущихПериодов.КПС КАК КПС,
	|	ДоходыБудущихПериодов.КЭК КАК КЭК,
	|	ДоходыБудущихПериодов.Подразделение КАК Подразделение,
	|	ДоходыБудущихПериодов.Контрагент КАК Контрагент,
	|	ДоходыБудущихПериодов.Договор КАК Договор,
	|	ДоходыБудущихПериодов.Валюта КАК Валюта,
	|	ДоходыБудущихПериодов.ОстатокДБП КАК ОстатокДБП,
	|	ДоходыБудущихПериодов.ОстатокДБПВВалюте КАК ОстатокДБПВВалюте,
	|	ДоходыБудущихПериодов.СуммаНДС КАК СуммаНДС,
	|	ДоходыБудущихПериодов.Всего КАК СуммаРасчетов
	|ИЗ
	|	ТаблицаДоходыБудущихПериодов КАК ДоходыБудущихПериодов
	|ГДЕ
	|	ДоходыБудущихПериодов.Всего > 0";
	
	Если Параметры.ПоВсемКФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДоходыБудущихПериодов.КФО",
			"ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
	КонецЕсли;
	Если Параметры.ПоВсемКПС Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДоходыБудущихПериодов.КПС",
			"ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
	КонецЕсли;
	
	РасчетыПоУслугамРаботам = Запрос.Выполнить().Выгрузить();
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Для Каждого СтрокаДокумента Из РасчетыПоУслугамРаботам Цикл
		
		НоваяСтрока = ТаблицаРасчетов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
		
		НоваяСтрока.ЭтоПоступление = Ложь;
		НоваяСтрока.СчетРасчетов   = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(НоваяСтрока.КЭК,
			?(Параметры.Свойство("СчетРасчетов") И ЗначениеЗаполнено(Параметры.СчетРасчетов), Параметры.СчетРасчетов, "205.00"), ,
			Документ.Дата, Документ.Организация, СтрокаДокумента.ИФО);
		
		Если Не ИспользоватьВалютныйУчет ИЛИ Не ЗначениеЗаполнено(НоваяСтрока.Валюта) Тогда
			НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
		//	НоваяСтрока.СуммаРубПоКурсуДБП = НоваяСтрока.СуммаРасчетов;
		//ИначеЕсли НоваяСтрока.Валюта <> ВалютаРегламентированногоУчета Тогда
		//	КурсПересчета = ?(СтрокаДокумента.ОстатокДБПВВалюте = 0, 1, СтрокаДокумента.ОстатокДБП / СтрокаДокумента.ОстатокДБПВВалюте);
		//	НоваяСтрока.СуммаРубПоКурсуДБП = НоваяСтрока.СуммаРасчетов * КурсПересчета;
		КонецЕсли;
		
	КонецЦикла;
	
	//ТаблицаРасчетов.Свернуть("ЭтоПоступление,ИФО,КФО,КПС,КЭК,Подразделение,СчетРасчетов,Контрагент,Договор,Валюта",
	//	"СуммаНДС,СуммаРасчетов,СуммаРубПоКурсуДБП");
	ТаблицаРасчетов.Свернуть("ЭтоПоступление,ИФО,КФО,КПС,КЭК,Подразделение,СчетРасчетов,Контрагент,Договор,Валюта",
		"СуммаНДС,СуммаРасчетов");
	
	Возврат ТаблицаРасчетов;
	
КонецФункции

// Подготовить таблицу документа (в унифицированном формате) для источника данных РеализацияУслугРабот.
// 
// Параметры:
//  Документ - ДокументОбъект.НачислениеЗаУслугиОбразования
//  Параметры - Структура - Параметры 
// 
// Возвращаемое значение:
//  см. УчетРасчетов.ПустаяТаблицаРеализацияУслугРаботПоДокументу
Функция ПодготовитьТаблицуРеализацияУслугРаботПоДокументу(Документ, Параметры) Экспорт
	
	ТаблицаРеализацияУслугРабот = УчетРасчетов.ПустаяТаблицаРеализацияУслугРаботПоДокументу();
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ДоходыБудущихПериодов",
		"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,Контрагент,Договор,Валюта,ОстатокДБП,ОстатокДБПВВалюте,
		|Номенклатура,СодержаниеУслуги,Количество,Сумма,Всего,СтавкаНДС,СуммаНДС,
		|ВидОперации,СчетДБП,СчетДоходов,СубконтоДоходов1,СубконтоДоходов2,СубконтоДоходов3,ВидДеятельностиНУ,СчетДоходовНУ,СтатьяПрочихДоходовНУ,
		|КодЦели,ОтразитьВГрафикеИсполненияДоговора",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""ДоходыБудущихПериодов"" КАК ИмяСписка,
	|	""Доходы будущих периодов"" КАК СинонимСписка,
	|	ДоходыБудущихПериодов.НомерСтроки КАК НомерСтроки,
	|	ДоходыБудущихПериодов.ИФО КАК ИФО,
	|	ДоходыБудущихПериодов.КФО КАК КФО,
	|	ДоходыБудущихПериодов.КПС КАК КПС,
	|	ДоходыБудущихПериодов.КЭК КАК КЭК,
	|	ДоходыБудущихПериодов.Подразделение КАК Подразделение,
	|	ДоходыБудущихПериодов.Номенклатура КАК Номенклатура,
	|	ДоходыБудущихПериодов.СодержаниеУслуги КАК Содержание,
	|	ДоходыБудущихПериодов.Контрагент КАК Контрагент,
	|	ДоходыБудущихПериодов.Договор КАК Договор,
	|	ДоходыБудущихПериодов.КодЦели КАК КодЦели,
	|	ДоходыБудущихПериодов.ВидОперации КАК ВидОперацииДБП,
	|	ДоходыБудущихПериодов.СчетДБП КАК СчетДБП,
	|	ДоходыБудущихПериодов.ОстатокДБП КАК ОстатокДБП,
	|	ДоходыБудущихПериодов.ОстатокДБПВВалюте КАК ОстатокДБПВВалюте,
	|	ДоходыБудущихПериодов.СчетДоходов КАК СчетДоходов,
	|	ДоходыБудущихПериодов.СубконтоДоходов1 КАК СубконтоДоходов1,
	|	ДоходыБудущихПериодов.СубконтоДоходов2 КАК СубконтоДоходов2,
	|	ДоходыБудущихПериодов.СубконтоДоходов3 КАК СубконтоДоходов3,
	|	ДоходыБудущихПериодов.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
	|	ДоходыБудущихПериодов.СчетДоходовНУ КАК СчетДоходовНУ,
	|	ДоходыБудущихПериодов.СтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ,
	|	ДоходыБудущихПериодов.ОтразитьВГрафикеИсполненияДоговора КАК ОтразитьВГрафикеИсполненияДоговора,
	|	ДоходыБудущихПериодов.Валюта КАК Валюта,
	|	1 КАК Количество,
	|	ДоходыБудущихПериодов.Всего КАК Сумма,
	|	ДоходыБудущихПериодов.СтавкаНДС КАК СтавкаНДС,
	|	ДоходыБудущихПериодов.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	ТаблицаДоходыБудущихПериодов КАК ДоходыБудущихПериодов
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());

	РеализацияУслугРабот = Запрос.Выполнить().Выгрузить();
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	// Счет расчетов.
	СчетРасчетов = УчетРасчетов.ОпределитьСчетРасчетовПоПараметрам(Параметры, "Реализация",
		Документ.Дата, Документ.Организация, Документ.ИФО);
	
	Для Каждого СтрокаДокумента Из РеализацияУслугРабот Цикл
		
		НоваяСтрока = ТаблицаРеализацияУслугРабот.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
		
		Если ИспользоватьВалютныйУчет 
			И ЗначениеЗаполнено(НоваяСтрока.Валюта)
			И НоваяСтрока.Валюта <> ВалютаРегламентированногоУчета Тогда
			КурсПересчета = ?(СтрокаДокумента.ОстатокДБПВВалюте = 0, 1, СтрокаДокумента.ОстатокДБП / СтрокаДокумента.ОстатокДБПВВалюте);
			НоваяСтрока.СуммаРубПоКурсуДБП = НоваяСтрока.Сумма * КурсПересчета;
		Иначе
			НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
			НоваяСтрока.СуммаРубПоКурсуДБП = НоваяСтрока.Сумма;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СчетРасчетов) Тогда
			НоваяСтрока.СчетРасчетов = СчетРасчетов;
		ИначеЕсли ЗначениеЗаполнено(НоваяСтрока.КЭК) Тогда
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(НоваяСтрока.КЭК,
				?(Параметры.Свойство("СчетРасчетов") И ЗначениеЗаполнено(Параметры.СчетРасчетов), Параметры.СчетРасчетов, "205.00"), ,
				Документ.Дата, Документ.Организация, СтрокаДокумента.ИФО);
		Иначе // По умолчанию - 205.31.
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("205.31", Документ.Дата, Документ.Организация);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.КЭК) Тогда
			НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(НоваяСтрока.СчетРасчетов);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаРеализацияУслугРабот;
	
КонецФункции

#КонецОбласти

#Область ПечатьДокумента

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.СписаниеДоходовБудущихПериодов";
	КомандаПечати.Идентификатор = "АктОбОказанииУслуг";
	КомандаПечати.Представление = Нстр("ru='Акт об оказании услуг'");
	КомандаПечати.Порядок = 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктОбОказанииУслуг") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"АктОбОказанииУслуг", "Акт об оказании услуг",
			ПечатьАктаОбОказанииУслуг(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьАктаОбОказанииУслуг(МассивОбъектов, ОбъектыПечати);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_АктВыполненныхУслуг");
	ОбластьШапка     = Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьСтрока    = Макет.ПолучитьОбласть("Строка");
	ОбластьИтоги     = Макет.ПолучитьОбласть("Итоги");
	ОбластьПодвал    = Макет.ПолучитьОбласть("Подвал");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокНачисления.Ссылка КАК ДокументОснование,
	|	ДокНачисления.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ДокНачисления.Организация.НаименованиеПолное = """"
	|			ТОГДА ДокНачисления.Организация.Наименование
	|		ИНАЧЕ ДокНачисления.Организация.НаименованиеПолное
	|	КОНЕЦ + "" ИНН "" + ДокНачисления.Организация.ИНН + "" КПП "" + ДокНачисления.Организация.КПП КАК пНаименованиеОрганизации,
	|	ТабЧасть.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ТабЧасть.Контрагент.НаименованиеСокращенное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА ТабЧасть.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ ТабЧасть.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	|						ТОГДА ТабЧасть.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|					ИНАЧЕ ТабЧасть.Контрагент.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ ТабЧасть.Контрагент.НаименованиеСокращенное
	|	КОНЕЦ КАК КонтрагентНаименование,
	|	ТабЧасть.Контрагент.ИНН КАК КонтрагентИНН,
	|	ТабЧасть.Контрагент.КПП КАК КонтрагентКПП,
	|	ДокНачисления.Дата КАК пДата,
	|	ТабЧасть.Договор.Представление КАК пДоговор,
	|	1 КАК пНом,
	|	ТабЧасть.Номенклатура.Представление КАК пНаименование,
	|	ДокНачисления.ТипПериода КАК ТипПериода,
	|	ТабЧасть.СодержаниеУслуги КАК СодержаниеУслуги,
	|	ТабЧасть.Номенклатура.ЕдиницаИзмерения.Представление КАК пЕдИзм,
	|	1 КАК пКоличество,
	|	ТабЧасть.Всего КАК пЦена,
	|	ТабЧасть.Всего КАК пСумма,
	|	ТабЧасть.СуммаНДС КАК пИтогНДС,
	|	ТабЧасть.Всего КАК пИтогСумма,
	|	ТабЧасть.Всего КАК пИтогВсего,
	|	ИСТИНА КАК СуммаВключаетНДС,
	|	&ВалютаРубли КАК ВалютаДокумента,
	|	ДокНачисления.Номер КАК НомерНачисления,
	|	ДокНачисления.Ссылка КАК Начисление,
	|	ТабЧасть.НомерСтроки КАК НомСтр,
	|	&ВалютаРубли КАК пВалюта,
	|	ДокНачисления.Руководитель КАК Руководитель,
	|	ТабЧасть.ОформлятьЭД КАК ОформлятьЭД
	|ИЗ
	|	Документ.СписаниеДоходовБудущихПериодов КАК ДокНачисления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеДоходовБудущихПериодов.ДоходыБудущихПериодов КАК ТабЧасть
	|		ПО ДокНачисления.Ссылка = ТабЧасть.Ссылка
	|ГДЕ
	|	ДокНачисления.Ссылка В(&МассивОбъектов)
	|	И ТабЧасть.Всего <> 0";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ВалютаРубли", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	ВыборкаШапка = Запрос.Выполнить().Выбрать();
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		Если ВыборкаШапка.ОформлятьЭД Тогда
			//Электронные акты
			Продолжить;
		КонецЕсли;	
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
		
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
			Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
			Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
		
		СтруктураОбластьШапка = Новый Структура("пАдресТелефон,пЗаказчик,пДата,пНомер");
		СтруктураОбластьШапка.пАдресТелефон = АдресОрганизации
			+ ?(ПустаяСтрока(ТелефонОрганизации), "", ", тел.:"+ТелефонОрганизации);
		
		СтруктураОбластьШапка.пЗаказчик = ВыборкаШапка.КонтрагентНаименование
			+ ?(ПустаяСтрока(ВыборкаШапка.КонтрагентИНН), "", " ИНН " + ВыборкаШапка.КонтрагентИНН)
			+ ?(ПустаяСтрока(ВыборкаШапка.КонтрагентКПП), "", " КПП " + ВыборкаШапка.КонтрагентКПП);
			
		СтруктураОбластьШапка.пДата	= Формат(ВыборкаШапка.пДата, "ДЛФ=DD");
		СтруктураОбластьШапка.пНомер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Начисление,ВыборкаШапка.НомерНачисления) + "/" + ВыборкаШапка.НомСтр;
		ОбластьШапка.Параметры.Заполнить(СтруктураОбластьШапка);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ОбластьСтрока.Параметры.Заполнить(ВыборкаШапка);
		Если Не ЗначениеЗаполнено(ВыборкаШапка.СодержаниеУслуги) Тогда
			Если ВыборкаШапка.ТипПериода = 0 Тогда // За месяц.
				ОбластьСтрока.Параметры.пНаименование = ОбластьСтрока.Параметры.пНаименование +
					", " + Формат(ВыборкаШапка.пДата, "ДФ=""ММММ гггг 'г.'"""); // Добавляем месяц.
			Иначе // На дату.
				ОбластьСтрока.Параметры.пНаименование = ОбластьСтрока.Параметры.пНаименование +
					", " + Формат(ВыборкаШапка.пДата, "ДЛФ=Д"); // Добавляем дату.
			КонецЕсли;
		Иначе
			ОбластьСтрока.Параметры.пНаименование = ВыборкаШапка.СодержаниеУслуги;
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьСтрока);
		
		ОбластьИтоги.Параметры.Заполнить(Новый Структура("пТекстНДС",?(ВыборкаШапка.СуммаВключаетНДС, "В том числе НДС", "Итого НДС")));
		ОбластьИтоги.Параметры.Заполнить(ВыборкаШапка);
		
		ТабличныйДокумент.Вывести(ОбластьИтоги);
		СтруктураОбластьПодвал = Новый Структура("пИтогВсегоПрописью,пИтогНДСПрописью,РуководительДолжность,РуководительФИО");
		СтруктураОбластьПодвал.пИтогВсегоПрописью = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ВыборкаШапка.пИтогВсего, ВыборкаШапка.ВалютаДокумента);
		СтруктураОбластьПодвал.пИтогНДСПрописью   = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ВыборкаШапка.пИтогНДС, ВыборкаШапка.ВалютаДокумента);
		
		ДанныеРуководителя = Новый Структура("СсылкаНаОбъект, Период, Должность", ВыборкаШапка.Руководитель, ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеРуководителя);
		СтруктураОбластьПодвал.РуководительДолжность = ДанныеРуководителя.Должность;
		СтруктураОбластьПодвал.РуководительФИО = Справочники.Сотрудники.ФамилияИО(ВыборкаШапка.Руководитель, Истина, ВыборкаШапка.пДата);
		
		ОбластьПодвал.Параметры.Заполнить(СтруктураОбластьПодвал);
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		// В табличном документе зададим имя области, в которую был выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.ДокументОснование);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область ФормированиеСчетовФактур

Процедура СформироватьСчетаФактурыНачисления(ДокументОснованиеСсылка, ФормаУправленияСчетамиФактурами) Экспорт
	
	Перем ДокументОбъект;
	
	ДатаСчетовФактур = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснованиеСсылка, "Дата");
	
	ТЗ = ФормаУправленияСчетамиФактурами["Список"].Выгрузить();
	
	ЕдИзмШт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ЗапросДанные = Новый Запрос();
	ЗапросДанные.УстановитьПараметр("ДокументОснованиеСсылка",	ДокументОснованиеСсылка);
	ЗапросДанные.УстановитьПараметр("ТЗ",						ТЗ);
	ЗапросДанные.УстановитьПараметр("ДействиеСоздать",			1);
	ЗапросДанные.УстановитьПараметр("ДействиеИзменить",			2);
	ЗапросДанные.УстановитьПараметр("ДействиеУдалить",			3);
	ЗапросДанные.УстановитьПараметр("ЕдИзмШт",					ЕдИзмШт);
	ЗапросДанные.УстановитьПараметр("Счет30304",				ФормаУправленияСчетамиФактурами["Счет30304"]);
	ЗапросДанные.УстановитьПараметр("КПС30304",					ФормаУправленияСчетамиФактурами["КПС30304"]);
	ЗапросДанные.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Таблица из формы Управление счетами-фактурами и печать
	|//
	|ВЫБРАТЬ
	|	ТЗ.СчетФактура				КАК СчетФактура,
	|	ТЗ.НомерСтрокиНачисления	КАК НомерСтрокиНачисления,
	|	ТЗ.Действие					КАК Действие
	|ПОМЕСТИТЬ
	|	ТаблицаДействий
	|ИЗ
	|	&ТЗ	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Таблица всех начислений из документа-основания
	|//
	|ВЫБРАТЬ
	|	Ссылка.Организация						КАК Организация,
	|	Ссылка.Руководитель						КАК Руководитель,
	|	Ссылка									КАК Ссылка,
	|	ДоходыБудущихПериодов.НомерСтроки		КАК НомерСтроки,
	|	ДоходыБудущихПериодов.ВидОперации		КАК ВидОперации,
	|	ДоходыБудущихПериодов.ИФО				КАК ИФО,
	|	ДоходыБудущихПериодов.Подразделение		КАК Подразделение,
	|	ДоходыБудущихПериодов.Контрагент		КАК Контрагент,
	|	ДоходыБудущихПериодов.Договор			КАК Договор,
	|	ДоходыБудущихПериодов.КФО				КАК КФО,
	|	ДоходыБудущихПериодов.Номенклатура		КАК Номенклатура,
	|	ДоходыБудущихПериодов.СодержаниеУслуги	КАК СодержаниеУслуги,
	|	ВЫБОР
	|		КОГДА ДоходыБудущихПериодов.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование) ТОГДА
	|			ДоходыБудущихПериодов.ВсегоСправедливая
	|		ИНАЧЕ
	|			ДоходыБудущихПериодов.Всего
	|	КОНЕЦ									КАК Всего,
	|	ДоходыБудущихПериодов.СтавкаНДС			КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА ДоходыБудущихПериодов.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование) ТОГДА
	|			ДоходыБудущихПериодов.СуммаНДССправедливая
	|		ИНАЧЕ
	|			ДоходыБудущихПериодов.СуммаНДС
	|	КОНЕЦ									КАК СуммаНДС,
	|	ДоходыБудущихПериодов.СчетДоходов		КАК СчетДоходов,
	|	ДоходыБудущихПериодов.СубконтоДоходов1	КАК СубконтоДоходов1,
	|	ДоходыБудущихПериодов.СубконтоДоходов2	КАК СубконтоДоходов2,
	|	ДоходыБудущихПериодов.СубконтоДоходов3	КАК СубконтоДоходов3,
	|	ДоходыБудущихПериодов.КПС				КАК КПС,
    |	ДоходыБудущихПериодов.КЭК КАК КЭК,
	|	ДоходыБудущихПериодов.ИдентификаторЭД КАК ИдентификаторЭД,
	|	ДоходыБудущихПериодов.Ссылка.Дата КАК Дата
	|ПОМЕСТИТЬ
	|	Начисления
	|ИЗ
	|	Документ.СписаниеДоходовБудущихПериодов.ДоходыБудущихПериодов	КАК ДоходыБудущихПериодов
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Данные для заполнения счетов-фактур. Как создаваемых, так и изменяемых
	|//
	|ВЫБРАТЬ
	|	ТаблицаДействий.СчетФактура				КАК СчетФактураСсылка,
	|	
	|	Начисления.Организация					КАК Организация,
	|	Начисления.Руководитель					КАК Руководитель,
	|	Начисления.Ссылка						КАК ДокументОснование,
	|	Начисления.ИФО							КАК ИФО,
	|	Начисления.Подразделение				КАК Подразделение,
	|	Начисления.Контрагент					КАК Контрагент,
	|	Начисления.Договор						КАК Договор,
	|	Начисления.КФО							КАК КФО,
	|	Начисления.Номенклатура					КАК НФА,
	|	Начисления.СодержаниеУслуги				КАК СодержаниеУслуги,
	|	1										КАК Количество,
	|	ВЫБОР
	|		КОГДА Начисления.Номенклатура.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка) ТОГДА
	|			Начисления.Номенклатура.ЕдиницаИзмерения
	|		ИНАЧЕ
	|			&ЕдИзмШт
	|	КОНЕЦ									КАК ЕдиницаИзмерения,
	|	Начисления.СтавкаНДС					КАК СтавкаНДС,
	|	Начисления.Всего - Начисления.СуммаНДС	КАК Цена,
	|	Начисления.Всего - Начисления.СуммаНДС	КАК Сумма,
	|	Начисления.Всего						КАК Всего,
	|	Начисления.СуммаНДС 					КАК СуммаНДС,
	|	Начисления.СчетДоходов					КАК СчетНачислениеДт,
	|	Начисления.СубконтоДоходов1				КАК Субконто1НачислениеДт,
	|	Начисления.СубконтоДоходов2				КАК Субконто2НачислениеДт,
	|	Начисления.СубконтоДоходов3				КАК Субконто3НачислениеДт,
	|	Начисления.КПС							КАК КПСНачислениеДт,
	|	Начисления.КЭК							КАК КЭКНачислениеДт,
	|	
	|	&Счет30304								КАК Счет30304,
	|	&КПС30304								КАК КПС30304,
	|	
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)	КАК ПричинаНалогообложения,
	|	""01""														КАК КодВидаОперации,
    |	Начисления.ИдентификаторЭД КАК ИдентификаторЭД
	|ИЗ
	|	Начисления
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ТаблицаДействий
	|		ПО	Начисления.НомерСтроки = ТаблицаДействий.НомерСтрокиНачисления
	|ГДЕ
	|	ТаблицаДействий.Действие = &ДействиеСоздать
	|	ИЛИ ТаблицаДействий.Действие = &ДействиеИзменить
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Удаляемые счета-фактуры
	|//
	|ВЫБРАТЬ
	|	СчетФактура	КАК СчетФактураСсылка
	|ИЗ
	|	ТаблицаДействий
	|ГДЕ
	|	Действие = &ДействиеУдалить
	|;";
	
	РеквизитыТиповойОперации = Новый Структура();
	РеквизитыТиповойОперации.Вставить("Курс",		1);
	РеквизитыТиповойОперации.Вставить("Кратность",	1);
	
	НачатьТранзакцию();
	
	Попытка
		
		РезультатыЗапроса = ЗапросДанные.ВыполнитьПакет();
		
		НеобходимоЗаполнитьСчетаФактурыНаАванс = (ДатаСчетовФактур >= '20260101');
		Если НеобходимоЗаполнитьСчетаФактурыНаАванс Тогда
			// Все сч.-ф. создаются с одинаковой причиной налогообложения Реализация.
			ТаблицаДокументовСчетовФактурНаАванс = ПолучитьТаблицуДокументовСчетовФактурНаАванс(РезультатыЗапроса[2], ДатаСчетовФактур);
		КонецЕсли;
		
		// [2]. Данные для заполнения счетов-фактур. Как создаваемых, так и изменяемых
		Выборка = РезультатыЗапроса[2].Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка["СчетФактураСсылка"]) Тогда
				ДокументОбъект = Выборка["СчетФактураСсылка"].ПолучитьОбъект();
				
				ДокументОбъект.СоставНФА.Очистить();
			Иначе
				ДокументОбъект = Документы.СчетФактураВыданный.СоздатьДокумент();
			КонецЕсли;
			
			// Шапка
			ЗаполнитьЗначенияСвойств(ДокументОбъект, Выборка);
			
			ДокументОснованиеЭДО = ЭлектронныеДокументыБГУ.НайтиПередаточныйДокументЭДПоИдентификаторуЭД(Выборка.ИдентификаторЭД, Выборка.Контрагент, Выборка.Договор);
			
			ЗначенияПараметров = Новый Структура();
			ЗначенияПараметров.Вставить("ГлавныйБухгалтер",	ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
																"Главный бухгалтер", 
																Выборка["Организация"],
																ДатаСчетовФактур).ОтветственноеЛицоСсылка);
			ЗначенияПараметров.Вставить("Дата",				ДатаСчетовФактур);
			ЗначенияПараметров.Вставить("ДатаВыставления",	ДатаСчетовФактур);
			ЗначенияПараметров.Вставить("Выставлен",		Истина);
			ЗначенияПараметров.Вставить("ВалютаДокумента",	ВалютаРУ);
			ЗначенияПараметров.Вставить("ДокументОснованиеЭДО",	ДокументОснованиеЭДО);
			Если ЗначениеЗаполнено(ДокументОснованиеЭДО) Тогда
				ЗначенияПараметров.Вставить("КодСпособаВыставления",	2);
			Иначе
				ЗначенияПараметров.Вставить("КодСпособаВыставления",	1);
			КонецЕсли;	
			
			ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияПараметров);
			
			// Табличная часть
			НоваяСтрока = ДокументОбъект.СоставНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			Если Выборка.КФО = Перечисления.КВД.Бюджет Тогда
				ЗаполнитьСчетНачисленияПриКФО1(ДокументОбъект, ФормаУправленияСчетамиФактурами);
			КонецЕсли;
			
			Если НеобходимоЗаполнитьСчетаФактурыНаАванс Тогда
				// Все сч.-ф. создаются с одинаковой причиной налогообложения Реализация.
				ЗаполнитьСчетаФактурыНаАванс(ДокументОбъект, ТаблицаДокументовСчетовФактурНаАванс);
			КонецЕсли;
			
			// Типовая операция
			БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(
				ДокументОбъект,
				ФормаУправленияСчетамиФактурами["ТиповаяОперацияСФ"],
				РеквизитыТиповойОперации);
			
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			
		КонецЦикла;
		
		// [3]. Удаляемые счета-фактуры
		Выборка = РезультатыЗапроса[3].Выбрать();
		Пока Выборка.Следующий() Цикл
			ДокументОбъект = Выборка["СчетФактураСсылка"].ПолучитьОбъект();
			
			ДокументОбъект.УстановитьПометкуУдаления(Истина);
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = НСтр("ru = 'Не удалось создать/обновить счет-фактуру по причине: '");
		ТекстОшибкиКраткий = ТекстОшибки + КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ТекстОшибкиПолный = ТекстОшибки + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибкиКраткий);
		
		ОбъектМетаданных = ?(ДокументОбъект <> Неопределено, ДокументОбъект.Метаданные(), Неопределено);
		
		ЗаписьЖурналаРегистрации("Данные.Изменение",
			УровеньЖурналаРегистрации.Ошибка,
			ОбъектМетаданных,
			Неопределено,
			ТекстОшибкиПолный);
			
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьТаблицуУправлениеСчетамиФактурамиИПечать(ДокументСсылка, МодифицироватьСуществующиеСФ) Экспорт
	
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Организация");
	
	ЗапросТаблица = Новый Запрос();
	ЗапросТаблица.УстановитьПараметр("ДокументОснованиеСсылка",				ДокументСсылка);
	ЗапросТаблица.УстановитьПараметр("ДокументОснованиеОрганизация",		Организация);
	ЗапросТаблица.УстановитьПараметр("ИспользоватьУчетПоИФО",				ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ЗапросТаблица.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ЗапросТаблица.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Таблица всех начислений из документа-основания
	|//
	|ВЫБРАТЬ
	|	&ДокументОснованиеОрганизация	КАК Организация,
	|	НомерСтроки						КАК НомерСтроки,
	|	Подразделение					КАК Подразделение,
	|	Контрагент						КАК Контрагент,
	|	Номенклатура					КАК Номенклатура,
	|	Договор							КАК Договор,
	|	ИФО								КАК ИФО,
	|	КФО								КАК КФО,
	|	ВЫБОР
	|		КОГДА ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование) ТОГДА
	|			ВсегоСправедливая
	|		ИНАЧЕ
	|			Всего
	|	КОНЕЦ							КАК Всего,
	|	ВЫБОР
	|		КОГДА ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование) ТОГДА
	|			СуммаНДССправедливая
	|		ИНАЧЕ
	|			СуммаНДС
	|	КОНЕЦ							КАК СуммаНДС
	|ПОМЕСТИТЬ
	|	Начисления
	|ИЗ
	|	Документ.СписаниеДоходовБудущихПериодов.ДоходыБудущихПериодов
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Уже существующие документы счетов-фактур
	|//
	|ВЫБРАТЬ
	|	СчетФактураВыданный.Ссылка								КАК Ссылка,
	|	СчетФактураВыданный.Проведен							КАК Проведен,
	|	СчетФактураВыданный.ПометкаУдаления						КАК ПометкаУдаления,
	|	СчетФактураВыданный.СуммаДокумента						КАК СуммаДокумента,
	|	СчетФактураВыданный.СуммаНДС							КАК СуммаНДС,
	|	СчетФактураВыданный.Организация							КАК Организация,
	|	СчетФактураВыданный.Подразделение						КАК Подразделение,
	|	СчетФактураВыданный.ИФО									КАК ИФО,
	|	СчетФактураВыданный.КФО									КАК КФО,
	|	СчетФактураВыданный.Контрагент							КАК Контрагент,
	|	СчетФактураВыданный.Договор								КАК Договор,
	|	ЕСТЬNULL(КОЛИЧЕСТВО(ТабличнаяЧасть.Ссылка), 0)			КАК КоличествоСтрокНФА,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КОЛИЧЕСТВО(ТабличнаяЧасть.Ссылка), 0) = 1 ТОГДА
	|			// КоличествоСтрокНФА = 1
	|			ЕСТЬNULL(МАКСИМУМ(ТабличнаяЧасть.НФА), НЕОПРЕДЕЛЕНО)
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ													КАК НФА
	|ПОМЕСТИТЬ
	|	СуществующиеДокументыСчетовФактур
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.СоставНФА	КАК ТабличнаяЧасть
	|		ПО СчетФактураВыданный.Ссылка = ТабличнаяЧасть.Ссылка
	|ГДЕ
	|	СчетФактураВыданный.ДокументОснование = &ДокументОснованиеСсылка
	|СГРУППИРОВАТЬ ПО
	|	СчетФактураВыданный.Ссылка,
	|	СчетФактураВыданный.СуммаДокумента,
	|	СчетФактураВыданный.СуммаНДС,
	|	СчетФактураВыданный.Организация,
	|	СчетФактураВыданный.Подразделение,
	|	СчетФактураВыданный.ИФО,
	|	СчетФактураВыданный.КФО,
	|	СчетФактураВыданный.Контрагент,
	|	СчетФактураВыданный.Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Поля связи счетов-фактур
	|//
	|ВЫБРАТЬ
	|	Контрагент			КАК Контрагент,
	|	Договор				КАК Договор,
	|	НФА					КАК НФА,
	|	КОЛИЧЕСТВО(*)		КАК КоличествоСчетовФактур,
	|	СУММА(ВЫБОР
	|		КОГДА ПометкаУдаления ТОГДА
	|			0
	|		ИНАЧЕ
	|			1
	|	КОНЕЦ)				КАК КоличествоСчетовФактурНеудаленных
	|ПОМЕСТИТЬ
	|	ПоляСвязиСчетовФактур
	|ИЗ
	|	СуществующиеДокументыСчетовФактур
	|СГРУППИРОВАТЬ ПО
	|	Контрагент,
	|	Договор,
	|	НФА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Общий список всех начислений и всех существующих счетов-фактур
	|//
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СуществующиеДокументыСчетовФактур.Ссылка,
	|		ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка))						КАК СчетФактура,
	|	ЕСТЬNULL(СуществующиеДокументыСчетовФактур.Проведен, ЛОЖЬ)						КАК СчетФактураПроведен,
	|	ЕСТЬNULL(СуществующиеДокументыСчетовФактур.ПометкаУдаления, ЛОЖЬ)				КАК СчетФактураПометкаУдаления,
	|	ЕСТЬNULL(Начисления.Контрагент, СуществующиеДокументыСчетовФактур.Контрагент)	КАК Контрагент,
	|	ЕСТЬNULL(Начисления.Номенклатура, СуществующиеДокументыСчетовФактур.НФА)		КАК Номенклатура,
	|	ЕСТЬNULL(Начисления.Договор, СуществующиеДокументыСчетовФактур.Договор)			КАК ДоговорКонтрагента,
	|	
	|	(Начисления.НомерСтроки ЕСТЬ NULL)												КАК ОтсутствуетНачисление,
	|	ЕСТЬNULL(Начисления.НомерСтроки, 0)												КАК НомерСтрокиНачисления,
	|	ЕСТЬNULL(ПоляСвязиСчетовФактур.КоличествоСчетовФактур, 0)						КАК КоличествоСчетовФактур,
	|	ЕСТЬNULL(ПоляСвязиСчетовФактур.КоличествоСчетовФактурНеудаленных, 0)			КАК КоличествоСчетовФактурНеудаленных,
	|	ЕСТЬNULL(СуществующиеДокументыСчетовФактур.КоличествоСтрокНФА, 0)				КАК КоличествоСтрокНФА,
	|	
	|	//	1) Различаются значения Организации начисления и счета-фактуры
	|	ВЫБОР
	|		КОГДА НЕ Начисления.НомерСтроки ЕСТЬ NULL И НЕ СуществующиеДокументыСчетовФактур.Ссылка ЕСТЬ NULL
	|			И ЕСТЬNULL(ПоляСвязиСчетовФактур.КоличествоСчетовФактур, 0) >= 1
	|			И Начисления.Организация <> СуществующиеДокументыСчетовФактур.Организация ТОГДА
	|			1
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ
	|	+
	|	//	2) Различаются значения Подразделения начисления и счета-фактуры
	|	ВЫБОР
	|		КОГДА НЕ Начисления.НомерСтроки ЕСТЬ NULL И НЕ СуществующиеДокументыСчетовФактур.Ссылка ЕСТЬ NULL И &ИспользоватьУчетПоПодразделениям
	|			И ЕСТЬNULL(ПоляСвязиСчетовФактур.КоличествоСчетовФактур, 0) >= 1
	|			И Начисления.Организация <> СуществующиеДокументыСчетовФактур.Организация ТОГДА
	|			2
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ
	|	+
	|	//	3) Различаются значения Контрагента начисления и счета-фактуры
	|	ВЫБОР
	|		КОГДА НЕ Начисления.НомерСтроки ЕСТЬ NULL И НЕ СуществующиеДокументыСчетовФактур.Ссылка ЕСТЬ NULL
	|			И ЕСТЬNULL(ПоляСвязиСчетовФактур.КоличествоСчетовФактур, 0) >= 1
	|			И Начисления.Контрагент <> СуществующиеДокументыСчетовФактур.Контрагент ТОГДА
	|			4
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ
	|	+
	|	//	4) Различаются значения Договора начисления и счета-фактуры
	|	ВЫБОР
	|		КОГДА НЕ Начисления.НомерСтроки ЕСТЬ NULL И НЕ СуществующиеДокументыСчетовФактур.Ссылка ЕСТЬ NULL
	|			И ЕСТЬNULL(ПоляСвязиСчетовФактур.КоличествоСчетовФактур, 0) >= 1
	|			И Начисления.Договор <> СуществующиеДокументыСчетовФактур.Договор ТОГДА
	|			8
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ
	|	+
	|	//	5) Различаются значения Номенклатуры начисления и счета-фактуры
	|	ВЫБОР
	|		КОГДА НЕ Начисления.НомерСтроки ЕСТЬ NULL И НЕ СуществующиеДокументыСчетовФактур.Ссылка ЕСТЬ NULL
	|			И ЕСТЬNULL(ПоляСвязиСчетовФактур.КоличествоСчетовФактур, 0) >= 1
	|			И (СуществующиеДокументыСчетовФактур.КоличествоСтрокНФА <> 1
	|				ИЛИ Начисления.Номенклатура <> СуществующиеДокументыСчетовФактур.НФА) ТОГДА
	|			16
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ
	|	+
	|	//	6) Различаются значения ИФО начисления и счета-фактуры
	|	ВЫБОР
	|		КОГДА НЕ Начисления.НомерСтроки ЕСТЬ NULL И НЕ СуществующиеДокументыСчетовФактур.Ссылка ЕСТЬ NULL И &ИспользоватьУчетПоИФО
	|			И ЕСТЬNULL(ПоляСвязиСчетовФактур.КоличествоСчетовФактур, 0) >= 1
	|			И Начисления.ИФО <> СуществующиеДокументыСчетовФактур.ИФО ТОГДА
	|			32
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ
	|	+
	|	//	7) Различаются значения КФО начисления и счета-фактуры
	|	ВЫБОР
	|		КОГДА НЕ Начисления.НомерСтроки ЕСТЬ NULL И НЕ СуществующиеДокументыСчетовФактур.Ссылка ЕСТЬ NULL
	|			И ЕСТЬNULL(ПоляСвязиСчетовФактур.КоличествоСчетовФактур, 0) >= 1
	|			И Начисления.КФО <> СуществующиеДокументыСчетовФактур.КФО ТОГДА
	|			64
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ
	|	+
	|	//	8) Различаются значения Всего начисления и счета-фактуры
	|	ВЫБОР
	|		КОГДА НЕ Начисления.НомерСтроки ЕСТЬ NULL И НЕ СуществующиеДокументыСчетовФактур.Ссылка ЕСТЬ NULL
	|			И ЕСТЬNULL(ПоляСвязиСчетовФактур.КоличествоСчетовФактур, 0) >= 1
	|			И Начисления.Всего <> СуществующиеДокументыСчетовФактур.СуммаДокумента ТОГДА
	|			128
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ
	|	+
	|	//	9) Различаются значения Суммы НДС начисления и счета-фактуры
	|	ВЫБОР
	|		КОГДА НЕ Начисления.НомерСтроки ЕСТЬ NULL И НЕ СуществующиеДокументыСчетовФактур.Ссылка ЕСТЬ NULL
	|			И ЕСТЬNULL(ПоляСвязиСчетовФактур.КоличествоСчетовФактур, 0) >= 1
	|			И Начисления.СуммаНДС <> СуществующиеДокументыСчетовФактур.СуммаНДС ТОГДА
	|			256
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ				КАК ОшибкаКонтрольныхПолей
	|ИЗ
	|	Начисления
	|	ПОЛНОЕ ВНЕШНЕЕ СОЕДИНЕНИЕ	СуществующиеДокументыСчетовФактур
	|		ПО	Начисления.Контрагент	= СуществующиеДокументыСчетовФактур.Контрагент
	|		И	Начисления.Договор		= СуществующиеДокументыСчетовФактур.Договор
	|		И	Начисления.Номенклатура	= СуществующиеДокументыСчетовФактур.НФА
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ПоляСвязиСчетовФактур
	|		ПО	Начисления.Контрагент	= ПоляСвязиСчетовФактур.Контрагент
	|		И	Начисления.Договор		= ПоляСвязиСчетовФактур.Договор
	|		И	Начисления.Номенклатура	= ПоляСвязиСчетовФактур.НФА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Строки с очищенным полем счета-фактуры,
	|// добавляемые в случае отсутствия доступных к изменению счетов-фактур
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)		КАК СчетФактура,
	|	ЛОЖЬ													КАК СчетФактураПроведен,
	|	ЛОЖЬ													КАК СчетФактураПометкаУдаления,
	|	
	|	Начисления.Контрагент									КАК Контрагент,
	|	Начисления.Номенклатура									КАК Номенклатура,
	|	Начисления.Договор										КАК ДоговорКонтрагента,
	|	
	|	ЛОЖЬ													КАК ОтсутствуетНачисление,
	|	Начисления.НомерСтроки									КАК НомерСтрокиНачисления,
	|	0														КАК КоличествоСчетовФактур,
	|	0														КАК КоличествоСчетовФактурНеудаленных,
	|	0														КАК КоличествоСтрокНФА,
	|	
	|	0														КАК ОшибкаКонтрольныхПолей
	|ИЗ
	|	Начисления
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ПоляСвязиСчетовФактур
	|		ПО	Начисления.Контрагент	= ПоляСвязиСчетовФактур.Контрагент
	|		И	Начисления.Договор		= ПоляСвязиСчетовФактур.Договор
	|		И	Начисления.Номенклатура	= ПоляСвязиСчетовФактур.НФА
	|ГДЕ
	|	ПоляСвязиСчетовФактур.КоличествоСчетовФактурНеудаленных = 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОтсутствуетНачисление,
	|	НомерСтрокиНачисления,
	|	СчетФактураПометкаУдаления,
	|	ОшибкаКонтрольныхПолей
	|;";
	
	Таблица = ЗапросТаблица.Выполнить().Выгрузить();
	
	Таблица.Колонки.Добавить("Ошибка", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Действие", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(1,0,ДопустимыйЗнак.Неотрицательный)));
	Таблица.Колонки.Добавить("ВыделитьСчетФактуру", Новый ОписаниеТипов("Булево"));
	
	НомерПредыдущийСтрокиНачисления = Неопределено;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		УстановитьТекстОшибки(СтрокаТаблицы);
		
		УстановитьДействие(СтрокаТаблицы, МодифицироватьСуществующиеСФ, НомерПредыдущийСтрокиНачисления);
		
		НомерПредыдущийСтрокиНачисления = СтрокаТаблицы["НомерСтрокиНачисления"];
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Процедура ЗаполнитьСчетНачисленияПриКФО1(ДокументОбъект, ФормаУправленияСчетамиФактурами)
	
	КПС40120 = ФормаУправленияСчетамиФактурами.КПС40120;
	
	ТаблицаСоставНФА = ДокументОбъект.СоставНФА.Выгрузить();
	
	// Эти колонки будут созданы и автоматически заполнены далее.
	ТаблицаСоставНФА.Колонки.Удалить("СчетНачислениеДт");
	ТаблицаСоставНФА.Колонки.Удалить("КЭКНачислениеДт");
	
	ШапкаДокумента = Новый Структура("
		|Ссылка,
		|ДокументОснование,
		|Дата,
		|Организация,
		|ИФО,
		|Подразделение,
		|Контрагент,
		|Договор,
		|ВалютаДокумента,
		|ВидЦенности,
		|КодВидаОперации,
		|КФО,
		|РеализацияПоСтавке0,
		|ПричинаНалогообложения");
	
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);
	
	Документы.СчетФактураВыданный.ЗаполнитьКолонкиСчетов(ШапкаДокумента, ТаблицаСоставНФА, ШапкаДокумента.Ссылка);
	
	Индекс = 0;
	
	Для Каждого СтрокаТабличнойЧасти Из ДокументОбъект.СоставНФА Цикл
		СтрокаТаблицы = ТаблицаСоставНФА[Индекс];
		
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтрокаТаблицы, "СчетНачислениеДт,КЭКНачислениеДт");
		
		СтрокаТабличнойЧасти.КПСНачислениеДт = КПС40120;
		
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьТекстОшибки(СтрокаТаблицы)
	
	ОшибкаКонтрольныхПолей = СтрокаТаблицы["ОшибкаКонтрольныхПолей"];
	
	КоличествоСчетовФактур = СтрокаТаблицы["КоличествоСчетовФактур"];
	
	НесколькоСчетовФактур = (КоличествоСчетовФактур >= 2);
	
	ОтсутствуетНачисление = СтрокаТаблицы["ОтсутствуетНачисление"];
	
	СчетФактураНеПроведен = (ЗначениеЗаполнено(СтрокаТаблицы["СчетФактура"]) И НЕ СтрокаТаблицы["СчетФактураПроведен"]);
	
	СчетФактураПомеченНаУдаление = (ЗначениеЗаполнено(СтрокаТаблицы["СчетФактура"]) И СтрокаТаблицы["СчетФактураПометкаУдаления"]);
	
	ЕстьОшибка = (ОшибкаКонтрольныхПолей > 0
		ИЛИ НесколькоСчетовФактур
		ИЛИ ОтсутствуетНачисление
		ИЛИ СчетФактураНеПроведен
		ИЛИ СчетФактураПомеченНаУдаление);
	
	Если НЕ ЕстьОшибка Тогда
		Возврат;
	КонецЕсли;
	
	КонтрольныеПоля = Новый Массив();
	
	КоличествоКонтрольныхПолей = 9;
	
	Для КонтрольноеПоле = 1 По КоличествоКонтрольныхПолей Цикл
		
		ЕстьОшибка = ((ОшибкаКонтрольныхПолей%2) = 1);
		
		ОшибкаКонтрольныхПолей = Цел(ОшибкаКонтрольныхПолей / 2);
		
		Если НЕ ЕстьОшибка Тогда
			Продолжить;
		КонецЕсли;
		
		Если КонтрольноеПоле = 1 Тогда
			КонтрольныеПоля.Добавить("Организация");
			
		ИначеЕсли КонтрольноеПоле = 2 Тогда
			КонтрольныеПоля.Добавить("Подразделение");
			
		ИначеЕсли КонтрольноеПоле = 3 Тогда
			КонтрольныеПоля.Добавить("Контрагент");
			
		ИначеЕсли КонтрольноеПоле = 4 Тогда
			КонтрольныеПоля.Добавить("Договор");
			
		ИначеЕсли КонтрольноеПоле = 5 Тогда
			КонтрольныеПоля.Добавить("Номенклатура");
			
		ИначеЕсли КонтрольноеПоле = 6 Тогда
			КонтрольныеПоля.Добавить("ИФО");
			
		ИначеЕсли КонтрольноеПоле = 7 Тогда
			КонтрольныеПоля.Добавить("КФО");
			
		ИначеЕсли КонтрольноеПоле = 8 Тогда
			КонтрольныеПоля.Добавить("Всего");
			
		ИначеЕсли КонтрольноеПоле = 9 Тогда
			КонтрольныеПоля.Добавить("Сумма НДС");
		
		КонецЕсли;
		
	КонецЦикла;
	
	Ошибка = "";
	
	КоличествоОшибок = 0;
	
	Если СчетФактураПомеченНаУдаление Тогда
		Ошибка = Ошибка
			+ ?(Ошибка = "", "", "; ")
			+ "Сч.-ф. помечен на удаление";
		
		КоличествоОшибок = КоличествоОшибок + 1;
		
	ИначеЕсли СчетФактураНеПроведен Тогда
		Ошибка = Ошибка
			+ ?(Ошибка = "", "", "; ")
			+ "Сч.-ф. не проведен";
		
		КоличествоОшибок = КоличествоОшибок + 1;
		
	КонецЕсли;
	
	Если ОтсутствуетНачисление Тогда
		Ошибка = Ошибка
			+ ?(Ошибка = "", "", "; ")
			+ "Отсутствует начисление";
		
		КоличествоОшибок = КоличествоОшибок + 1;
		
	Иначе
		
		Если НесколькоСчетовФактур Тогда
			Ошибка = Ошибка
				+ ?(Ошибка = "", "", "; ")
				+ "Обнаружено несколько сч.-ф." + "(" + Формат(КоличествоСчетовФактур, "ЧГ=0") + ")";
			
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
		
		КонтрольныеПоляКоличество = КонтрольныеПоля.Количество();
		
		Если КонтрольныеПоляКоличество > 0 Тогда
			Ошибка = Ошибка
				+ ?(Ошибка = "", "", "; ")
				+ "Различаются поля: " + СтрСоединить(КонтрольныеПоля, ",");
			
			КоличествоОшибок = КоличествоОшибок + КонтрольныеПоляКоличество;
				
		КонецЕсли;
	КонецЕсли;
	
	КоличествоОшибокПредставление = ?(КоличествоОшибок > 1, "(" + Формат(КоличествоОшибок, "ЧГ=0") + ") ", "");
	
	Ошибка = КоличествоОшибокПредставление + Ошибка;
	
	СтрокаТаблицы["Ошибка"] = Ошибка;
	
	// Если единственной ошибкой является наличие нескольких сч.-ф.
	// (но при этом сам текущий сч.-ф. ошибок не имеет),
	// то такой сч.-ф. не выделяем оформлением в списке
	ВыделитьСчетФактуру = ОтсутствуетНачисление
		ИЛИ СчетФактураНеПроведен
		ИЛИ КонтрольныеПоляКоличество > 0;
	
	СтрокаТаблицы["ВыделитьСчетФактуру"] = ВыделитьСчетФактуру;
	
КонецПроцедуры

Процедура УстановитьДействие(СтрокаТаблицы, МодифицироватьСуществующиеСФ, НомерПредыдущийСтрокиНачисления)
	
	КоличествоСчетовФактур			= СтрокаТаблицы["КоличествоСчетовФактур"];
	ОтсутствуетНачисление			= СтрокаТаблицы["ОтсутствуетНачисление"];
	СчетФактураПомеченНаУдаление	= ЗначениеЗаполнено(СтрокаТаблицы["СчетФактура"]) И СтрокаТаблицы["СчетФактураПометкаУдаления"];
	
	Если КоличествоСчетовФактур = 0 И НЕ ОтсутствуетНачисление Тогда
		// Создать счет-фактуру
		Действие = 1;
		
	Иначе
		// Ничего не делать со счетом-фактурой
		Действие = 0;
		
	КонецЕсли;
	
	//	КАК ДопустимоИзменитьСчетФактуру
	
	Если ЗначениеЗаполнено(СтрокаТаблицы["СчетФактура"]) И МодифицироватьСуществующиеСФ И НЕ СчетФактураПомеченНаУдаление Тогда
		
		ОшибкаКонтрольныхПолей				= (СтрокаТаблицы["ОшибкаКонтрольныхПолей"] > 0);
		СчетФактураНеПроведен				= (ЗначениеЗаполнено(СтрокаТаблицы["СчетФактура"]) И НЕ СтрокаТаблицы["СчетФактураПроведен"]);
		
		ЭтоПерваяСтрокаНачисления = (НЕ ОтсутствуетНачисление И НомерПредыдущийСтрокиНачисления <> СтрокаТаблицы["НомерСтрокиНачисления"]);
		
		Если ЭтоПерваяСтрокаНачисления Тогда
			// Создание или изменение сч.-ф. предполагается лишь в первой строке начисления
			
			Если ОшибкаКонтрольныхПолей ИЛИ СчетФактураНеПроведен Тогда
				// Изменить (обновить) счет-фактуру
				Действие = 2;
				
			Иначе
				// Ничего не делать со счетом-фактурой
				Действие = 0;
				
			КонецЕсли;
			
		Иначе
			// Удалить счет-фактуру
			Действие = 3;
			
		КонецЕсли;
		
	КонецЕсли;
	
	СтрокаТаблицы["Действие"] = Действие;
	
КонецПроцедуры	

Функция ПолучитьТаблицуДокументовСчетовФактурНаАванс(РезультатЗапроса, НаДату)
	
	Отбор = УчетНДС.НовыйОтборОстаткиВходящийНДСАвансыПолученные();
	Отбор.НаДату = НаДату;
	
	ТаблицаНачислений = РезультатЗапроса.Выгрузить();
	
	Если ТаблицаНачислений.Количество() > 0 Тогда
		ПерваяСтрока = ТаблицаНачислений[0];
		
		Отбор.Организация = ПерваяСтрока.Организация;
		Отбор.СписокДокументовЗачетаАванса.Добавить(ПерваяСтрока.ДокументОснование);
	КонецЕсли;
	
	ТаблицаНачислений.Свернуть("КФО,Контрагент,Договор");
	
	ВремТаблица = ТаблицаНачислений.Скопировать(, "КФО");
	Отбор.СписокКФО = ВремТаблица.ВыгрузитьКолонку("КФО");
	
	ВремТаблица = ТаблицаНачислений.Скопировать(, "Контрагент");
	Отбор.СписокКонтрагентов = ВремТаблица.ВыгрузитьКолонку("Контрагент");
	
	ВремТаблица = ТаблицаНачислений.Скопировать(, "Договор");
	Отбор.СписокДоговоров = ВремТаблица.ВыгрузитьКолонку("Договор");
	
	Возврат УчетНДС.ПолучитьТаблицуДокументовСчетовФактурНаАванс(Отбор, Истина);
	
КонецФункции

Процедура ЗаполнитьСчетаФактурыНаАванс(СчетФактураНаОтгрузку, ТаблицаДокументовСчетовФактурНаАванс)
	
	СчетФактураНаОтгрузку.СчетаФактурыНаАванс.Очистить();
	
	ИменаПолейАналитикиСтрокой = "КФО,Контрагент,Договор";
	
	ПоискАналитики = Новый Структура(ИменаПолейАналитикиСтрокой);
	
	ЗаполнитьЗначенияСвойств(ПоискАналитики, СчетФактураНаОтгрузку);
	
	МассивСтрок = ТаблицаДокументовСчетовФактурНаАванс.НайтиСтроки(ПоискАналитики);
	
	УжеДобавленныеСФ = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СчетФактура = СтрокаТаблицы.СчетФактура;
		
		Если УжеДобавленныеСФ.Найти(СчетФактура) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		УжеДобавленныеСФ.Добавить(СчетФактура);
		
		НоваяСтрока = СчетФактураНаОтгрузку.СчетаФактурыНаАванс.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДокумента

Функция ЗаполнитьНаОсновании(Знач Основание, Объект, ОписаниеОшибки = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен документ основания.'");
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.КорректировкаДоходовБудущихПериодов") Тогда
		
		Объект.ДокументОснование = Основание;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КорректировкаДоходовБудущихПериодов.Ссылка КАК Ссылка,
		|	КорректировкаДоходовБудущихПериодов.Дата КАК Дата,
		|	КорректировкаДоходовБудущихПериодов.Организация КАК Организация,
		|	КорректировкаДоходовБудущихПериодов.ИФО КАК ИФО,
		|	КорректировкаДоходовБудущихПериодов.Контрагент КАК Контрагент,
		|	КорректировкаДоходовБудущихПериодов.Договор КАК Договор,
		|	КорректировкаДоходовБудущихПериодов.ТипДоговораДБП КАК ВидОперации,
		|	КорректировкаДоходовБудущихПериодов.СпособПризнанияДоходов КАК СпособПризнанияДоходов,
		|	КорректировкаДоходовБудущихПериодов.ДатаНачалаСписания КАК ДатаНачалаСписания,
		|	КорректировкаДоходовБудущихПериодов.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
		|	КорректировкаДоходовБудущихПериодов.СчетДоходов КАК СчетДоходов,
		|	КорректировкаДоходовБудущихПериодов.СубконтоДоходов1 КАК СубконтоДоходов1,
		|	КорректировкаДоходовБудущихПериодов.СубконтоДоходов2 КАК СубконтоДоходов2,
		|	КорректировкаДоходовБудущихПериодов.СубконтоДоходов3 КАК СубконтоДоходов3,
		|	КорректировкаДоходовБудущихПериодов.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
		|	КорректировкаДоходовБудущихПериодов.СчетДоходовНУ КАК СчетДоходовНУ,
		|	КорректировкаДоходовБудущихПериодов.СтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ,
		|	КорректировкаДоходовБудущихПериодов.ВидДеятельностиУСН КАК ВидДеятельностиУСН
		|ИЗ
		|	Документ.КорректировкаДоходовБудущихПериодов КАК КорректировкаДоходовБудущихПериодов
		|ГДЕ
		|	КорректировкаДоходовБудущихПериодов.Ссылка = &Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоходыБудущихПериодов.Ссылка.Контрагент КАК Контрагент,
		|	ДоходыБудущихПериодов.Ссылка.Договор КАК Договор,
		|	ДоходыБудущихПериодов.Ссылка.ИФО КАК ИФО,
		|	ДоходыБудущихПериодов.Номенклатура КАК Номенклатура,
		|	ДоходыБудущихПериодов.Номенклатура.СтавкаНДС КАК СтавкаНДС,
		|	ДоходыБудущихПериодов.СчетДБП КАК СчетДБП,
		|	ДоходыБудущихПериодов.КФО КАК КФО,
		|	ДоходыБудущихПериодов.КПС КАК КПС,
		|	ДоходыБудущихПериодов.КЭК КАК КЭК,
		|	ДоходыБудущихПериодов.Подразделение КАК Подразделение,
		|	ДоходыБудущихПериодов.СчетРБППоУпущеннойВыгоде КАК СчетРБППоУпущеннойВыгоде,
		|	ДоходыБудущихПериодов.СтатьяРасходовПоУпущеннойВыгоде КАК СтатьяРасходовПоУпущеннойВыгоде,
		|	ДоходыБудущихПериодов.КПСРасходовПоУпущеннойВыгоде КАК КПСРасходовПоУпущеннойВыгоде,
		|	ДоходыБудущихПериодов.КЭКРасходовПоУпущеннойВыгоде КАК КЭКРасходовПоУпущеннойВыгоде,
		|	ДоходыБудущихПериодов.ОстатокДБП КАК ОстатокДБП,
		|	ДоходыБудущихПериодов.ОстатокРасходовПоУпущеннойВыгоде КАК ОстатокРасходовПоУпущеннойВыгоде,
		|	ДоходыБудущихПериодов.ВсегоСправедливая КАК ВсегоСправедливая,
		|	ДоходыБудущихПериодов.СуммаРасходовПоУпущеннойВыгоде КАК СуммаРасходовПоУпущеннойВыгоде,
		|	ДоходыБудущихПериодов.Всего КАК Всего
		|ИЗ
		|	Документ.КорректировкаДоходовБудущихПериодов.ДоходыБудущихПериодов КАК ДоходыБудущихПериодов
		|ГДЕ
		|	ДоходыБудущихПериодов.Ссылка = &Основание
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДоходыБудущихПериодов.НомерСтроки";
		Запрос.УстановитьПараметр("Основание", Основание);
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		Шапка = РезультатЗапроса[0].Выгрузить();
		ЗаполнитьЗначенияСвойств(Объект, Шапка[0], "Дата,Организация,ИФО,Контрагент");
		
		Если ЗначениеЗаполнено(Шапка[0].Договор) Тогда
			ОтборПоДоговору = Объект.Отбор.Добавить();
			ОтборПоДоговору.Договор = Шапка[0].Договор;
		КонецЕсли;
		
		ДоходыБудущихПериодов = РезультатЗапроса[1].Выгрузить();
		Если ДоходыБудущихПериодов.Количество() = 0 Тогда
			// Не обнаружено остатков доходов будущих периодов для отражения в доходах текущего периода.
			Возврат Истина;
		КонецЕсли;
		
		Для Каждого СтрокаОснования Из ДоходыБудущихПериодов Цикл
			
			ВсегоСправедливая = СтрокаОснования.ОстатокДБП + СтрокаОснования.ВсегоСправедливая;
			СуммаРасходовПоУпущеннойВыгоде = СтрокаОснования.ОстатокРасходовПоУпущеннойВыгоде + СтрокаОснования.СуммаРасходовПоУпущеннойВыгоде;
			Всего = ВсегоСправедливая - СуммаРасходовПоУпущеннойВыгоде;
			
			Если ВсегоСправедливая = 0 И СуммаРасходовПоУпущеннойВыгоде = 0 И Всего = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Объект.ДоходыБудущихПериодов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОснования);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Шапка[0],
				"Контрагент,Договор,ВидОперации,
				|СпособПризнанияДоходов,ДатаНачалаСписания,ДатаОкончанияСписания,
				|СчетДоходов,СубконтоДоходов1,СубконтоДоходов2,СубконтоДоходов3,
				|ВидДеятельностиНУ,СчетДоходовНУ,СтатьяПрочихДоходовНУ");
			
			Если ЗначениеЗаполнено(СтрокаОснования.СтатьяРасходовПоУпущеннойВыгоде) Тогда
				ОтражениеВБухУчете = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаОснования.СтатьяРасходовПоУпущеннойВыгоде,
					"СчетРасходов,СубконтоРасходов1,СубконтоРасходов2,СубконтоРасходов3");
				НоваяСтрока.СчетРасходовПоУпущеннойВыгоде      = ОтражениеВБухУчете.СчетРасходов;
				НоваяСтрока.СубконтоРасходовПоУпущеннойВыгоде1 = ОтражениеВБухУчете.СубконтоРасходов1;
				НоваяСтрока.СубконтоРасходовПоУпущеннойВыгоде2 = ОтражениеВБухУчете.СубконтоРасходов2;
				НоваяСтрока.СубконтоРасходовПоУпущеннойВыгоде3 = ОтражениеВБухУчете.СубконтоРасходов3;
			КонецЕсли;
			
			НоваяСтрока.ВсегоСправедливая = ВсегоСправедливая;
			НоваяСтрока.СуммаРасходовПоУпущеннойВыгоде = СуммаРасходовПоУпущеннойВыгоде;
			НоваяСтрока.Всего = Всего;
			
			// Списываем весь остаток ДБП (отложенных расходов по упущенной выгоде).
			НоваяСтрока.ОстатокДБП = НоваяСтрока.ВсегоСправедливая;
			НоваяСтрока.ОстатокРасходовПоУпущеннойВыгоде = НоваяСтрока.СуммаРасходовПоУпущеннойВыгоде;
			НоваяСтрока.Коэффициент = 1;
			НоваяСтрока.КоэффициентЧислитель = 1;
			НоваяСтрока.КоэффициентЗнаменатель = 1;
			
			Если ЗначениеЗаполнено(НоваяСтрока.СтавкаНДС)
				И НоваяСтрока.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС Тогда
				СуммаВключаетНДС = Истина;
				СтруктураПараметров = Новый Структура("Сумма, СтавкаНДС", НоваяСтрока.Всего, НоваяСтрока.СтавкаНДС);
				НоваяСтрока.СуммаНДС = УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтруктураПараметров, СуммаВключаетНДС);
				СтруктураПараметров = Новый Структура("Сумма, СтавкаНДС", НоваяСтрока.ВсегоСправедливая, НоваяСтрока.СтавкаНДС);
				НоваяСтрока.СуммаНДССправедливая = УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтруктураПараметров, СуммаВключаетНДС);
			КонецЕсли;
			
			НоваяСтрока.ОтразитьВГрафикеИсполненияДоговора = Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас;
			
			// Налоговый учет.
			Если НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, НоваяСтрока.КФО) Тогда
				
				Если НЕ ЗначениеЗаполнено(НоваяСтрока.ВидДеятельностиНУ) Тогда
					// По умолчанию - основная система налогообложения.
					НоваяСтрока.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(НоваяСтрока.СчетДоходовНУ) Тогда
					// По умолчанию - доходы от обычных видов деятельности.
					НоваяСтрока.СчетДоходовНУ = БухгалтерскийУчет.СчетПоКоду("Н90.01", Объект.Дата);
				КонецЕсли;
				
				Если НЕ БухгалтерскийУчет.СчетВИерархии(НоваяСтрока.СчетДоходовНУ, "Н91.01") Тогда
					НоваяСтрока.СтатьяПрочихДоходовНУ = Неопределено;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Заполнение нового реквизита ТипПериода значением 1 ("На дату") в документах с заполненным документом-основанием,
	// которые были введены до версии 2.0.84.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СписаниеДоходовБудущихПериодов.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СписаниеДоходовБудущихПериодов КАК СписаниеДоходовБудущихПериодов
	|ГДЕ
	|	СписаниеДоходовБудущихПериодов.ДокументОснование <> ЗНАЧЕНИЕ(Документ.КорректировкаДоходовБудущихПериодов.ПустаяСсылка)
	|	И СписаниеДоходовБудущихПериодов.ТипПериода = 0";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.СписаниеДоходовБудущихПериодов";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			// Объект не удается заблокировать - попробуем обработать его на следующей итерации.
			// Отдельно обрабатывать ошибку не требуется, т.к. в худшем случае обработчик зациклится
			// и прервется автоматически.
			ЗафиксироватьТранзакцию();
			Продолжить;
		КонецПопытки;
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Выборка.Ссылка) Тогда
			// Вероятно был удален раньше, чем обработчик дошел до него
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.ТипПериода = 1; // На дату.
		
		Если Не Объект.Модифицированность() Тогда
			
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
			
		КонецЕсли;
		
		Попытка
		
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.НакладнаяНаОтпускИК,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли


