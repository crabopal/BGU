&НаКлиенте
Процедура ДоходыБудущихПериодовВсегоСправедливаяПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДоходыБудущихПериодов.ТекущиеДанные;
	
	ПересчитатьСуммыПриИзмененииВсегоСправедливая(ТекущиеДанные);
	
	// Сумма к списанию изменена вручную, сбросим параметры авторасчета.
	ТекущиеДанные.КоэффициентЧислитель   = 0;
	ТекущиеДанные.КоэффициентЗнаменатель = 0;
	
	// Коэффициент списания определим по фактически указанной сумме списания.
	ТекущиеДанные.Коэффициент = ?(ТекущиеДанные.ОстатокДБП = 0, 0,
		ТекущиеДанные.ВсегоСправедливая / ТекущиеДанные.ОстатокДБП);
	
	ДоходыБудущихПериодовРассчитатьКоэффициентСписанияВСтрокеТаблицы(ТекущиеДанные);
	ДоходыБудущихПериодовЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ДоходыБудущихПериодовВсегоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДоходыБудущихПериодов.ТекущиеДанные;
	
	Если ТекущиеДанные.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях") Тогда
		
		Оповещение = Новый ОписаниеОповещения("ВопросПересчитатьПриИзмененииВсегоЗавершение", ЭтотОбъект);
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("ВсегоСправедливая", НСтр("ru='Справедливую стоимость'"));
		Кнопки.Добавить("СуммаРасходовПоУпущеннойВыгоде", НСтр("ru='Упущенную выгоду'"));
		
		ПоказатьВопрос(Оповещение,
			НСтр("ru='Пересчитать справедливую стиомость или упущенную выгоду?'"),
			Кнопки, , "ВсегоСправедливая",
			НСтр("ru='Выберите способ пересчета'"));
		
	Иначе
		
		ПересчитатьСуммыПриИзмененииВсего(ТекущиеДанные);
		ДоходыБудущихПериодовЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоходыБудущихПериодовСуммаРасходовПоУпущеннойВыгодеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДоходыБудущихПериодов.ТекущиеДанные;
	
	Если ТекущиеДанные.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях") Тогда
		
		Оповещение = Новый ОписаниеОповещения("ВопросПересчитатьПриИзмененииРасходовПоУпущеннойВыгодеЗавершение", ЭтотОбъект);
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("ВсегоСправедливая", НСтр("ru='Справедливую стоимость'"));
		Кнопки.Добавить("Всего", НСтр("ru='Сумму по договору'"));
		
		ПоказатьВопрос(Оповещение, НСтр("ru='Пересчитать справедливую стиомость или сумму по договору?'"),
			Кнопки, , "ВсегоСправедливая",
			НСтр("ru='Выберите способ пересчета'"));
		
	Иначе
		
		ПересчитатьСуммыПриИзмененииРасходовПоУпущеннойВыгоде(ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоходыБудущихПериодовСтавкаНДСПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДоходыБудущихПериодов.ТекущиеДанные;
	
	// Рассчитаем суммы НДС.
	СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(ТекущиеДанные.СтавкаНДС);
	ТекущиеДанные.СуммаНДССправедливая = ТекущиеДанные.ВсегоСправедливая * СтавкаНДС / (100 + СтавкаНДС);
	ТекущиеДанные.СуммаНДС = ТекущиеДанные.Всего * СтавкаНДС / (100 + СтавкаНДС);
	
КонецПроцедуры

