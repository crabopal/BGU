&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("НастройкиСчетовУчетаДБП",
		УчетДоходовРасходов.НастройкиСчетовУчетаДБП());
	
	ДоходыБудущихПериодовЗаполнитьДобавленныеКолонки();
	ОтборОбновитьТекстГиперссылки();
	
	КонтрольИсполненияДоговоров.ЗаполнитьДоступныеСтатусыДокументов(
		Элементы.ДоходыБудущихПериодовОтразитьВГрафикеИсполненияДоговора.СписокВыбора, Ложь);
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоСписаниеДБПзаМесяц = (Объект.ТипПериода = 0);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПредставлениеПериодаРегистрации", "Видимость", ЭтоСписаниеДБПзаМесяц);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"Дата", "Видимость", Не ЭтоСписаниеДБПзаМесяц);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДокументОснование", "Видимость", ЗначениеЗаполнено(Объект.ДокументОснование));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ВалютаДокумента", "Доступность", Не ЭтоЛьготнаяАренда(Объект.ВидОперации));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПредупрежденияЕстьОшибкиЗаполнения(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Отбор = Новый Структура("ЕстьОшибкиЗаполнения", Истина);
	ЕстьОшибкиЗаполнения = (Объект.ДоходыБудущихПериодов.НайтиСтроки(Отбор).Количество() > 0);
	
	ЭлементыПредупрежденияЕстьОшибкиЗаполнения = Новый Массив;
	ЭлементыПредупрежденияЕстьОшибкиЗаполнения.Добавить("ЕстьОшибкиЗаполненияКартинка");
	ЭлементыПредупрежденияЕстьОшибкиЗаполнения.Добавить("ЕстьОшибкиЗаполненияНадпись");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыПредупрежденияЕстьОшибкиЗаполнения, "Видимость", ЕстьОшибкиЗаполнения);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ВидыОперацийАренда = Новый СписокЗначений;
	ВидыОперацийАренда.Добавить(Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАренду);
	ВидыОперацийАренда.Добавить(Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях);
	ВидыОперацийАренда.Добавить(Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование);
	
	// Доходы будущих периодов в валюте.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовОстатокВВалюте");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовВалюта");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовВалютаРеглУчета");
	ГруппаИЛИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЭлементУО.Отбор,, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ,
		"Объект.ДоходыБудущихПериодов.СчетДБПВалютный", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ,
		"Объект.ДоходыБудущихПериодов.Валюта", ВидСравненияКомпоновкиДанных.Равно, ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ,
		"Объект.ДоходыБудущихПериодов.Валюта", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Прочие доходы будущих периодов, не по договорам аренды.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКПСРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКФОРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСчетРБППоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКЭКРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовОстатокРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовЗаголовокУпущеннаяВыгода");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСуммаРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСуммаНДСПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовОтражениеРасходовВУчете");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСтатьяРасходовПоУпущеннойВыгоде");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ВидОперации",
			ВидСравненияКомпоновкиДанных.НеВСписке, ВидыОперацийАренда);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Сигнализация об ошибке заполнения документа при отличии справедливой стоимости от суммы договора.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовЗаголовокСправедливая");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовВсегоСправедливая");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСуммаНДССправедливая");
	ГруппаИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЭлементУО.Отбор,, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИ,
		"Объект.ДоходыБудущихПериодов.ВидОперации", ВидСравненияКомпоновкиДанных.НеВСписке, ВидыОперацийАренда);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИ,
		"Объект.ДоходыБудущихПериодов.ЕстьОшибкиЗаполнения", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовЕстьОшибкиЗаполнения");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ЕстьОшибкиЗаполнения", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// При передаче в аренду (обычную) упущенная выгода отсутствует.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСуммаРасходовПоУпущеннойВыгоде");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ВидОперации",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАренду);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Отсутствует'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКПСРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКФОРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСчетРБППоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКЭКРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовОстатокРасходовПоУпущеннойВыгоде");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовОтражениеРасходовВУчете");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСтатьяРасходовПоУпущеннойВыгоде");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ВидОперации",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАренду);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// При передаче в безвозмездное пользование сумма по договору отсутствует.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовВсего");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСуммаНДС");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ВидОперации",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Отсутствует'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Отражение доходов в учете.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовОтражениеДоходовВУчете");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ОтражениеДоходовВУчетеЗаполнено", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НезаполненныйРеквизит);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовОтражениеДоходовВУчете");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ОтражениеДоходовВУчетеЗаполнено", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ГиперссылкаЦвет);
	
	// Отражение расходов в учете.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовОтражениеРасходовВУчете");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ОтражениеРасходовВУчетеЗаполнено", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НезаполненныйРеквизит);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовОтражениеРасходовВУчете");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ОтражениеРасходовВУчетеЗаполнено", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ГиперссылкаЦвет);
	
	// Статья прочих доходов (НУ).
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовСтатьяПрочихДоходовНУ");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.СчетДоходовНУ",
			ВидСравненияКомпоновкиДанных.НеРавно, БухгалтерскийУчет.СчетПоКоду("Н91.01", Объект.Дата));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	СпособыПризнанияДоходовПоГрафику = Новый СписокЗначений;
	СпособыПризнанияДоходовПоГрафику.Добавить(Перечисления.СпособыПризнанияРасходов.ПоГрафику);
	СпособыПризнанияДоходовПоГрафику.Добавить(Перечисления.СпособыПризнанияРасходов.НаДатуПризнания); // Частный случай признания по графику.
	
	// Параметры списания ДБП.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовДатаНачалаСписания");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовДатаОкончанияСписания");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.СпособПризнанияДоходов",
			ВидСравненияКомпоновкиДанных.ВСписке, СпособыПризнанияДоходовПоГрафику);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Доступность поля КодЦели в зависимости от настроек счета ДБП (401.4Х).
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовКодЦели");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.ЕстьКодЦели", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не используется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	// КонтрольИсполненияДоговоров
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ДоходыБудущихПериодовОтразитьВГрафикеИсполненияДоговора");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДоходыБудущихПериодов.СпособПризнанияДоходов",
			ВидСравненияКомпоновкиДанных.НеВСписке, СпособыПризнанияДоходовПоГрафику);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	// Конец КонтрольИсполненияДоговоров
	
КонецПроцедуры

&НаСервере
Функция ТаблицаОтбораВХранилище(АдресХранилища = "")
	
	Если ПустаяСтрока(АдресХранилища) Тогда
		Результат = ПоместитьВоВременноеХранилище(Объект.Отбор.Выгрузить(), УникальныйИдентификатор);
	Иначе
		ТаблицаОтбора = ПолучитьИзВременногоХранилища(АдресХранилища); 
		Объект.Отбор.Загрузить(ТаблицаОтбора);
		ОтборОбновитьТекстГиперссылки();
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДокументНаСервере()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьДокумент();
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ДоходыБудущихПериодовЗаполнитьДобавленныеКолонки();
	
	//Электронные документы (акты)
	НастройкаДоступностиЭДО();
	Для Каждого СтрТЧ Из Объект.ДоходыБудущихПериодов Цикл
		ВидимостьЭлементовЭДО = ЭлектронныеДокументыБГУ.ВидимостьЭлементовЭДО(СтрТЧ.Контрагент, Объект.Организация);
		Если НЕ ЗначениеЗаполнено(СтрТЧ.ИдентификаторЭД) Тогда
			СтрТЧ.ИдентификаторЭД = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		СтрТЧ.ДоступностьЭДО = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
		СтрТЧ.ОформлятьЭД = ВидимостьЭлементовЭДО ИЛИ ВыгружатьЭДОВФайлыБезНастроекЭДО;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПересчитатьПриИзмененииВсегоЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = Элементы.ДоходыБудущихПериодов.ТекущиеДанные;
	
	ПересчитатьСуммыПриИзмененииВсего(ТекущиеДанные, Результат);
	ДоходыБудущихПериодовЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПересчитатьПриИзмененииРасходовПоУпущеннойВыгодеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = Элементы.ДоходыБудущихПериодов.ТекущиеДанные;
	
	ПересчитатьСуммыПриИзмененииРасходовПоУпущеннойВыгоде(ТекущиеДанные, Результат);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыПриИзмененииВсегоСправедливая(СтрокаТаблицы)
	
	// Рассчитаем суммы по договору.
	Если СтрокаТаблицы.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование") Тогда
		СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде = СтрокаТаблицы.ВсегоСправедливая;
		СтрокаТаблицы.Всего = 0;
	ИначеЕсли СтрокаТаблицы.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях") Тогда
		// Рассчитаем через пропорцию остатка на 401.50 и на 401.40.
		СоотношениеДБПиРБП = ?(СтрокаТаблицы.ОстатокДБП = 0, 0, СтрокаТаблицы.ОстатокРасходовПоУпущеннойВыгоде / СтрокаТаблицы.ОстатокДБП);
		СтрокаТаблицы.Всего = СтрокаТаблицы.ВсегоСправедливая * (1 - СоотношениеДБПиРБП);
		СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде = 
			МИН(СтрокаТаблицы.ВсегоСправедливая - СтрокаТаблицы.Всего, СтрокаТаблицы.ОстатокРасходовПоУпущеннойВыгоде);
	Иначе // Аренда по справедливой стоимости и прочие ДБП.
		СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде = 0;
		СтрокаТаблицы.Всего = СтрокаТаблицы.ВсегоСправедливая;
	КонецЕсли;
	
	// Рассчитаем суммы НДС.
	СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС);
	СтрокаТаблицы.СуммаНДС = СтрокаТаблицы.Всего * СтавкаНДС / (100 + СтавкаНДС);
	СтрокаТаблицы.СуммаНДССправедливая = СтрокаТаблицы.ВсегоСправедливая * СтавкаНДС / (100 + СтавкаНДС);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыПриИзмененииВсего(СтрокаТаблицы, Пересчитать = "ВсегоСправедливая")
	
	// Рассчитаем суммы по договору.
	Если СтрокаТаблицы.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях") Тогда
		
		Если Пересчитать = "ВсегоСправедливая" Тогда
		
			// Рассчитаем через пропорцию остатка на 401.50 и на 401.40.
			СоотношениеДБПиРБП = ?(СтрокаТаблицы.ОстатокДБП = 0, 0, СтрокаТаблицы.ОстатокРасходовПоУпущеннойВыгоде / СтрокаТаблицы.ОстатокДБП);
			Если СоотношениеДБПиРБП = 1 Тогда // Соответствует безвозмездной передаче.
				СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде = СтрокаТаблицы.ВсегоСправедливая;
				СтрокаТаблицы.Всего = 0;
			Иначе
				СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде = СоотношениеДБПиРБП/(1-СоотношениеДБПиРБП) * СтрокаТаблицы.Всего;
				СтрокаТаблицы.ВсегоСправедливая = СтрокаТаблицы.Всего + СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде;
			КонецЕсли;
			
		Иначе
			
			// Справедливую стоимость не меняем, пересчитываем упущенную выгоду.
			СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде = СтрокаТаблицы.ВсегоСправедливая - СтрокаТаблицы.Всего;
			
		КонецЕсли;
		
	Иначе
		
		СтрокаТаблицы.ВсегоСправедливая = СтрокаТаблицы.Всего;
		СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде = 0;
		
	КонецЕсли;
	
	// Рассчитаем суммы НДС.
	СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС);
	СтрокаТаблицы.СуммаНДС = СтрокаТаблицы.Всего * СтавкаНДС / (100 + СтавкаНДС);
	СтрокаТаблицы.СуммаНДССправедливая = СтрокаТаблицы.ВсегоСправедливая * СтавкаНДС / (100 + СтавкаНДС);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыПриИзмененииРасходовПоУпущеннойВыгоде(СтрокаТаблицы, Пересчитать = "ВсегоСправедливая")
	
	// Рассчитаем суммы по договору.
	Если СтрокаТаблицы.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях") Тогда
		
		Если Пересчитать = "ВсегоСправедливая" Тогда
		
			// Рассчитаем через пропорцию остатка на 401.50 и на 401.40.
			СоотношениеДБПиРБП = ?(СтрокаТаблицы.ОстатокДБП = 0, 0, СтрокаТаблицы.ОстатокРасходовПоУпущеннойВыгоде / СтрокаТаблицы.ОстатокДБП);
			Если СоотношениеДБПиРБП = 0 Тогда // Соответствует обычной аренде.
				СтрокаТаблицы.Всего = СтрокаТаблицы.ВсегоСправедливая;
				СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде = 0;
			Иначе
				СтрокаТаблицы.Всего = (1-СоотношениеДБПиРБП)/СоотношениеДБПиРБП * СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде;
				СтрокаТаблицы.ВсегоСправедливая = СтрокаТаблицы.Всего + СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде;
			КонецЕсли;
			
		Иначе
			
			// Справедливую стоимость не меняем, пересчитываем стоимость по договору.
			СтрокаТаблицы.Всего = СтрокаТаблицы.ВсегоСправедливая - СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде;
			
		КонецЕсли;
			
	ИначеЕсли СтрокаТаблицы.ВидОперации = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование") Тогда
		
		СтрокаТаблицы.ВсегоСправедливая = СтрокаТаблицы.СуммаРасходовПоУпущеннойВыгоде;
		СтрокаТаблицы.Всего = 0;
		
	КонецЕсли;
	
	// Рассчитаем суммы НДС.
	СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС);
	СтрокаТаблицы.СуммаНДС = СтрокаТаблицы.Всего * СтавкаНДС / (100 + СтавкаНДС);
	СтрокаТаблицы.СуммаНДССправедливая = СтрокаТаблицы.ВсегоСправедливая * СтавкаНДС / (100 + СтавкаНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияДоходовВУчете(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.ДоходыБудущихПериодов.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Дата, Организация, Подразделение, ИФО, КФО, КПС, КЭК");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.Вставить("РежимДоходы", Истина);
	ПараметрыФормы.Вставить("ИмяРеквизитаСчет", "СчетДоходов");
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	// КФО, КПС и КЭК устанавливаются в таблице, изменять их не нужно.
	ПараметрыФормы.Вставить("ВидимостьКФО",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКПС",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКЭК",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКоличество",Ложь);
	
	// При передаче в безвозмездное пользование доходов НУ не возникает.
	ПараметрыФормы.Вставить("ЕстьНалоговыйУчет",
		НЕ ДанныеСтроки.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование"));
	
	// Бухгалтерский учет.
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.СчетДоходов);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.СубконтоДоходов1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.СубконтоДоходов2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.СубконтоДоходов3);
	
	ПараметрыСчета = Новый Структура;
	ПараметрыСчета.Вставить("ОграниченияСчета", "401.10");
	ПараметрыСчета.Вставить("ВыбиратьЗапрещенныеВПроводках", Ложь);
	ПараметрыФормы.Вставить("ПараметрыСчета", ПараметрыСчета);
	
	// Налоговый учет.
	ПараметрыФормы.Вставить("ВидДеятельностиНУ",      ДанныеСтроки.ВидДеятельностиНУ);
	ПараметрыФормы.Вставить("СчетНУ",                 ДанныеСтроки.СчетДоходовНУ);
	ПараметрыФормы.Вставить("СтатьяПрочихДоходовНУ",  ДанныеСтроки.СтатьяПрочихДоходовНУ);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Настройка отражения в учете доходов текущего периода'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет",  НСтр("ru = 'Счет доходов'"));
	
	ПараметрыСчетаНУ = Новый Структура;
	ПараметрыСчетаНУ.Вставить("ОграниченияСчета", "Н90.01,Н91.01");
	ПараметрыСчетаНУ.Вставить("ВыбиратьЗапрещенныеВПроводках", Ложь);
	ПараметрыФормы.Вставить("ПараметрыСчетаНУ", ПараметрыСчетаНУ);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияРасходовВУчете(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.ДоходыБудущихПериодов.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Дата, Организация, Подразделение, ИФО, КФО, КПС, КЭК");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.Вставить("ИмяРеквизитаСчет", "СчетРасходовПоУпущеннойВыгоде");
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	// КФО, КПС и КЭК устанавливаются в таблице, изменять их не нужно.
	ПараметрыФормы.Вставить("ВидимостьКФО",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКПС",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКЭК",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКоличество",Ложь);
	ПараметрыФормы.Вставить("ЕстьНалоговыйУчет",  Ложь); // Упущенная выгода не отражается в НУ.
	
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.СчетРасходовПоУпущеннойВыгоде);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.СубконтоРасходовПоУпущеннойВыгоде1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.СубконтоРасходовПоУпущеннойВыгоде2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.СубконтоРасходовПоУпущеннойВыгоде3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Настройка отражения в учете расходов по упущенной выгоде'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет",  НСтр("ru = 'Счет расходов'"));
	
	ПараметрыСчета = Новый Структура;
	ПараметрыСчета.Вставить("ОграниченияСписокСчетов", БухгалтерскийУчетКлиентСервер.СписокСчетов("401.20", Объект.Дата));
	ОтборСчета = Новый Структура("ЗапретитьИспользоватьВПроводках", Ложь);
	ПараметрыСчета.Вставить("Отбор", ОтборСчета);
	ПараметрыФормы.Вставить("ПараметрыСчета", ПараметрыСчета);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияДоходовВУчетеНаКлиенте(СтруктураОтражениеВУчете)

	ТекущиеДанные = Элементы.ДоходыБудущихПериодов.ТекущиеДанные;
	
	// Бухгалтерский учет.
	ТекущиеДанные.СчетДоходов      = СтруктураОтражениеВУчете.Счет;
	ТекущиеДанные.СубконтоДоходов1 = СтруктураОтражениеВУчете.Субконто1;
	ТекущиеДанные.СубконтоДоходов2 = СтруктураОтражениеВУчете.Субконто2;
	ТекущиеДанные.СубконтоДоходов3 = СтруктураОтражениеВУчете.Субконто3;
	
	// Налоговый учет.
	ТекущиеДанные.ВидДеятельностиНУ     = СтруктураОтражениеВУчете.ВидДеятельностиНУ;
	ТекущиеДанные.СчетДоходовНУ         = СтруктураОтражениеВУчете.СчетНУ;
	ТекущиеДанные.СтатьяПрочихДоходовНУ = СтруктураОтражениеВУчете.СтатьяПрочихДоходовНУ;
	
	ЗаполнитьДобавленныеКолонкиОтраженияДоходовВУчете(ЭтотОбъект, ТекущиеДанные);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияРасходовВУчетеНаКлиенте(СтруктураОтражениеВУчете)

	ТекущиеДанные = Элементы.ДоходыБудущихПериодов.ТекущиеДанные;
	
	ТекущиеДанные.СчетРасходовПоУпущеннойВыгоде      = СтруктураОтражениеВУчете.Счет;
	ТекущиеДанные.СубконтоРасходовПоУпущеннойВыгоде1 = СтруктураОтражениеВУчете.Субконто1;
	ТекущиеДанные.СубконтоРасходовПоУпущеннойВыгоде2 = СтруктураОтражениеВУчете.Субконто2;
	ТекущиеДанные.СубконтоРасходовПоУпущеннойВыгоде3 = СтруктураОтражениеВУчете.Субконто3;
	
	ЗаполнитьДобавленныеКолонкиОтраженияРасходовВУчете(ТекущиеДанные);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СодержаниеУслугиЗавершениеВвода(Знач ВведенныйТекст, Знач ДополнительныеПараметры) Экспорт
	
	Если ВведенныйТекст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ДоходыБудущихПериодов.ТекущиеДанные;
	ТекущиеДанные.СодержаниеУслуги = ВведенныйТекст;
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДобавленныеКолонкиОтраженияДоходовВУчете(Форма, СтрокаТаблицы)
	
	Параметры = Новый Структура;
	Параметры.Вставить("РежимДоходы", Истина);
	Параметры.Вставить("ОтражатьВНалоговомУчете", Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаТаблицы.КФО)
		И НЕ СтрокаТаблицы.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование"));
	
	ПоляФормы = Новый Структура("Счет,Субконто1,Субконто2,Субконто3,СчетНУ,ВидДеятельностиНУ,СтатьяПрочихДоходовНУ,ОтражениеВУчете",
		"СчетДоходов",
		"СубконтоДоходов1",
		"СубконтоДоходов2",
		"СубконтоДоходов3",
		"СчетДоходовНУ",
		"ВидДеятельностиНУ",
		"СтатьяПрочихДоходовНУ",
		"ОтражениеДоходовВУчете");
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, Параметры, ПоляФормы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДобавленныеКолонкиОтраженияРасходовВУчете(СтрокаТаблицы)
	
	ПоляФормы = Новый Структура("Счет,Субконто1,Субконто2,Субконто3,ОтражениеВУчете",
		"СчетРасходовПоУпущеннойВыгоде",
		"СубконтоРасходовПоУпущеннойВыгоде1",
		"СубконтоРасходовПоУпущеннойВыгоде2",
		"СубконтоРасходовПоУпущеннойВыгоде3",
		"ОтражениеРасходовВУчете");
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, , ПоляФормы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
