КонецФункции

&НаСервере
Процедура ДоходыБудущихПериодовЗаполнитьДобавленныеКолонки()
	
	Для Каждого СтрокаТаблицы Из Объект.ДоходыБудущихПериодов Цикл
		
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаТаблицы, СтрокаТаблицы.СчетДБП, ДоходыБудущихПериодовПоляАналитикиСчетаДБП());
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаТаблицы, СтрокаТаблицы.СчетДоходов, ДоходыБудущихПериодовПоляАналитикиСчетаДоходов());
		
		СтрокаТаблицы.ЕстьКодЦели = БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(СтрокаТаблицы.СчетДБП,
			ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ВидыЦелевыхСредств"));
		
		ДоходыБудущихПериодовЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы);
		ДоходыБудущихПериодовРассчитатьКоэффициентСписанияВСтрокеТаблицы(СтрокаТаблицы);
		
	КонецЦикла;
	
	УстановитьВидимостьПредупрежденияЕстьОшибкиЗаполнения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДоходыБудущихПериодовРассчитатьКоэффициентСписанияВСтрокеТаблицы(СтрокаТаблицы)
	
	Если СтрокаТаблицы.КоэффициентЧислитель = 0
	   И СтрокаТаблицы.КоэффициентЗнаменатель = 0 Тогда
		Если СтрокаТаблицы.Коэффициент <> 0 Тогда
			СтрокаТаблицы.РасчетКоэффициентаСписания =
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 (%2 %)'"),
					СтрокаТаблицы.Коэффициент,
					Формат(СтрокаТаблицы.Коэффициент * 100, "ЧЦ=5;ЧДЦ=2"));
		Иначе
			СтрокаТаблицы.РасчетКоэффициентаСписания = "";
		КонецЕсли;
	Иначе
		СтрокаТаблицы.РасчетКоэффициентаСписания =
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 / %2 = %3'"),
				СтрокаТаблицы.КоэффициентЧислитель,
				СтрокаТаблицы.КоэффициентЗнаменатель,
				СтрокаТаблицы.Коэффициент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДоходыБудущихПериодовЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокСправедливая    = НСтр("ru = 'Справедливая стоимость:'");
	СтрокаТаблицы.ЗаголовокПоДоговору      = НСтр("ru = 'Сумма по договору:'");
	СтрокаТаблицы.ЗаголовокУпущеннаяВыгода = НСтр("ru = 'Упущенная выгода:'");
	
	СтрокаТаблицы.ЗаголовокНеЗаполняется = НСтр("ru = '-'");
	
	СтрокаТаблицы.ЗаголовокОформлятьЭД = НСтр("ru = 'Передача по ЭДО:'");
	СтрокаТаблицы.ЗаголовокПередаточныйДокументЭД = НСтр("ru = 'Передаточный документ:'");
	
	СтрокаТаблицы.ЗаголовокПросмотретьЭД = НСтр("ru = 'Электронный документ:'");
	СтрокаТаблицы.ЗаголовокСостояниеЭД = НСтр("ru = 'Состояние ЭД:'");
	
	СтрокаТаблицы.ЕстьОшибкиЗаполнения = (СтрокаТаблицы.Всего <> СтрокаТаблицы.ВсегоСправедливая)
		И НЕ ЭтоЛьготнаяАренда(СтрокаТаблицы.ВидОперации);;
	
	НастройкиСчетовУчетаДБП = Форма.КэшПараметров.Локальные.НастройкиСчетовУчетаДБП;
	Если ТипЗнч(НастройкиСчетовУчетаДБП) = Тип("Соответствие")
		И НастройкиСчетовУчетаДБП[СтрокаТаблицы.СчетДБП] <> Неопределено Тогда
		СтрокаТаблицы.СчетДБПВалютный = НастройкиСчетовУчетаДБП[СтрокаТаблицы.СчетДБП].Валютный;
	Иначе
		СтрокаТаблицы.СчетДБПВалютный = Ложь;
	КонецЕсли;
	СтрокаТаблицы.ВалютаРеглУчета = Форма.КэшПараметров.ВалютаРегламентированногоУчета;
	// Поле ВсегоРуб отображается информационно, рассчитывается по курсу, определяемому по остатку 401.4х.
	КурсПересчета = ?(СтрокаТаблицы.ОстатокДБПВВалюте = 0, 1, СтрокаТаблицы.ОстатокДБП / СтрокаТаблицы.ОстатокДБПВВалюте);
	СтрокаТаблицы.ВсегоРуб = СтрокаТаблицы.Всего * КурсПересчета;
	
	ЗаполнитьДобавленныеКолонкиОтраженияДоходовВУчете(Форма, СтрокаТаблицы);
	ЗаполнитьДобавленныеКолонкиОтраженияРасходовВУчете(СтрокаТаблицы);
	
КонецПроцедуры

&НаКлиенте
Процедура ДоходыБудущихПериодовОформлятьЭДПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ДоходыБудущихПериодов.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока.ДоступностьЭДО Тогда
		ТекущаяСтрока.ОформлятьЭД = Ложь;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Отбор

&НаКлиенте
Процедура НадписьОтборНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОтбора = Новый Структура("Дата,Организация,ИФО,КФО,Контрагент");
	ЗаполнитьЗначенияСвойств(ПараметрыОтбора, Объект);
	
	ПараметрыФормы = Новый Структура("ПараметрыОтбора, Отбор, ТолькоПросмотр",
		ПараметрыОтбора, ТаблицаОтбораВХранилище(), ТолькоПросмотр);
	ОткрытьФорму("ОбщаяФорма.НастройкаОтбораПоДоговорам", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОтборОбновитьТекстГиперссылки()
	
	Если Объект.Отбор.Количество() = 0 Тогда
		ТекстГиперссылки = НСтр("ru = '<Без отбора>'");
	Иначе
		ТекстГиперссылки = "";
		Для Каждого СтрокаОтбора Из Объект.Отбор Цикл
			ТекстГиперссылки = ТекстГиперссылки + ?(ТекстГиперссылки = "", "", "; ") + СтрокаОтбора.Договор;
		КонецЦикла;
	КонецЕсли;
	
	НадписьОтбор = ТекстГиперссылки;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	
	ЕстьДанныеВДокументе = (Объект.ДоходыБудущихПериодов.Количество() > 0);
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено, а данные будут очищены. Заполнить?'");
	ИначеЕсли Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено. Заполнить?'");
	ИначеЕсли ЕстьДанныеВДокументе > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут очищены. Заполнить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьДокументЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьДокументНаСервере();
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьДокументЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДокументНаСервере();
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеСчетамиФактурамиИПечать(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Документ не записан. Сначала следует записать документ!'"));
		
	ИначеЕсли ЭтаФорма.Модифицированность Тогда
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Документ был изменен. Сначала следует записать документ!'"));
		
	ИначеЕсли Объект.ПометкаУдаления Тогда
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Счет-фактуры нельзя вводить на основании документа, помеченного на удаление!'"));
		
	Иначе
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("Документ",	Объект.Ссылка);
		ПараметрыФормы.Вставить("ТиповаяОперация",	Неопределено);
		
		ПараметрыФормы.Вставить("Организация", Объект.Организация);
		ПараметрыФормы.Вставить("ИФО", Объект.ИФО);
		ПараметрыФормы.Вставить("Дата", Объект.Дата);
		
		ПараметрыФормы.Вставить("КФО",  ПредопределенноеЗначение("Перечисление.КВД.Внебюджет")); 

		ОткрытьФорму("ОбщаяФорма.ФормаУправлениеСчетФактурамиПечати", ПараметрыФормы, ЭтаФорма, ЭтаФорма.УникальныйИдентификатор);
								
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПередаточныеДокументыДляЭДО(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.РеквизитыЛицевогоСчета) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен реквизит ""Реквизиты лицевого счета"". Следует заполнить этот реквизит и повторно нажать кнопку ""Создать передаточные документы для ЭДО"".'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		
		Возврат;
	КонецЕсли;
	
	СоздатьПередаточныеДокументыДляЭДОНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЭлектронныеДокументы(Команда)
	
	ОбменСКонтрагентамиКлиент.ОткрытьТекущиеДелаЭДО();

