#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьПоДаннымУчета(ДокументОбъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУОстатки.Счет КАК Счет,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ВЫБОР
	|		КОГДА ЕПСБУОстатки.Валюта ЕСТЬ NULL
	|				ИЛИ ЕПСБУОстатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА &РегламентнаяВалюта
	|		ИНАЧЕ ЕПСБУОстатки.Валюта
	|	КОНЕЦ КАК Валюта,
	|	СУММА(ВЫБОР
	|			КОГДА ЕПСБУОстатки.Субконто3 = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.СтоимостьРазмещенияЦБ)
	|					ИЛИ ЕПСБУОстатки.Субконто3 = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ОтклонениеОтНоминала)
	|				ТОГДА ЕПСБУОстатки.СуммаОстатокКт - ЕПСБУОстатки.СуммаОстатокДт
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаОД,
	|	СУММА(ВЫБОР
	|			КОГДА ЕПСБУОстатки.Субконто3 = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.Проценты)
	|				ТОГДА ЕПСБУОстатки.СуммаОстатокКт - ЕПСБУОстатки.СуммаОстатокДт
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаПроцентов,
	|	СУММА(ЕСТЬNULL(ВЫБОР
	|				КОГДА ЕПСБУОстатки.Субконто3 = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.СтоимостьРазмещенияЦБ)
	|						ИЛИ ЕПСБУОстатки.Субконто3 = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ОтклонениеОтНоминала)
	|					ТОГДА ЕПСБУОстатки.ВалютнаяСуммаОстатокКт - ЕПСБУОстатки.ВалютнаяСуммаОстатокДт
	|				ИНАЧЕ 0
	|			КОНЕЦ, 0)) КАК СуммаОДВалютная,
	|	СУММА(ЕСТЬNULL(ВЫБОР
	|				КОГДА ЕПСБУОстатки.Субконто3 = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.Проценты)
	|					ТОГДА ЕПСБУОстатки.ВалютнаяСуммаОстаток - ЕПСБУОстатки.ВалютнаяСуммаОстатокДт
	|				ИНАЧЕ 0
	|			КОНЕЦ, 0)) КАК СуммаПроцентовВалютная
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаЗапроса,
	|			Счет В ИЕРАРХИИ (&СчетаРасчетов),
	|			,
	|			ВЫБОР
	|					КОГДА &ИспользоватьУчетПоИФО = ИСТИНА
	|							И &БезУчетаИФО = ЛОЖЬ
	|						ТОГДА ИФО = &ИФО
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА &КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ КФО = &КФО
	|				КОНЕЦ
	|				И Организация = &Организация) КАК ЕПСБУОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОстатки.Счет,
	|	ЕПСБУОстатки.КФО,
	|	ЕПСБУОстатки.КПС,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры),
	|	ВЫБОР
	|		КОГДА ЕПСБУОстатки.Валюта ЕСТЬ NULL
	|				ИЛИ ЕПСБУОстатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА &РегламентнаяВалюта
	|		ИНАЧЕ ЕПСБУОстатки.Валюта
	|	КОНЕЦ";
	
	ДатаОпределенияОстатков = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков52н(ДокументОбъект.ДатаИнвентаризации);
	
	Запрос.УстановитьПараметр("ДатаЗапроса", ДатаОпределенияОстатков);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект["Организация"]);
	Запрос.УстановитьПараметр("КФО", ДокументОбъект["КФО"]);
	Запрос.УстановитьПараметр("ИФО", ДокументОбъект["ИФО"]);
	Запрос.УстановитьПараметр("БезУчетаИФО", ДокументОбъект["БезУчетаИФО"]);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("РегламентнаяВалюта", ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета());
	Запрос.УстановитьПараметр("СчетаРасчетов", ДокументОбъект["СчетУчета"]);
	
	ДокументОбъект["Задолженность"].Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

// Флажок <без ограничения>
Функция ФлажокБезОграничения_ПолучитьНастройкиМеханизма() Экспорт
	
	НастройкиМеханизма = Новый Структура();
	НастройкиМеханизма.Вставить("ИмяРеквизитаСсылка",	"ИФО");
	НастройкиМеханизма.Вставить("ИмяРеквизитаФлажок",	"БезУчетаИФО");
	
	Возврат НастройкиМеханизма;
	
КонецФункции

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504084_103н";
	КомандаПечати.Представление = НСтр("ru='Инвентаризационная опись (ф. 0504084) (в ред.103н)'");
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0504084_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Форма0504084_103н",
			"Инвентаризационная опись состояния государственного долга РФ в ценных бумагах (ф. 0504084)",
			ПечатьФормы0504084(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

