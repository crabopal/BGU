Функция ПечатьФормы0504084(МассивСсылок, ОбъектыПечати)
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИнвентаризацияГосдолгаВЦенныхБумагах.ПФ_MXL_Ф0504084");
	КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияГосдолгаВЦенныхБумагах_ф0504084";
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ОбластьЗаголовок 			= Макет.ПолучитьОбласть("Заголовок");
	ОбластьКомиссия 			= Макет.ПолучитьОбласть("Комиссия");
	ОбластьДатаПодписиКомиссии 	= Макет.ПолучитьОбласть("ДатаПодписиКомиссии");
	ОбластьПодзаголовокШапки 	= Макет.ПолучитьОбласть("ПодзаголовокШапки");
	ОбластьШапка1 				= Макет.ПолучитьОбласть("Шапка1");
	ОбластьСтрока1 				= Макет.ПолучитьОбласть("Строка1");
	ОбластьИтог1 				= Макет.ПолучитьОбласть("Итог1");
	ОбластьШапка2 				= Макет.ПолучитьОбласть("Шапка2");
	ОбластьСтрока2 				= Макет.ПолучитьОбласть("Строка2");
	ОбластьИтог2 				= Макет.ПолучитьОбласть("Итог2");
	ОбластьШапка3 				= Макет.ПолучитьОбласть("Шапка3");
	ОбластьСтрока3 				= Макет.ПолучитьОбласть("Строка3");
	ОбластьИтог3 				= Макет.ПолучитьОбласть("Итог3");
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВнутреннийЗапрос.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ВнутреннийЗапрос.ВидЗадолженности) КАК ВидЗадолженности,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВнутреннийЗапрос.ВидЗадолженности) КАК КоличествоВидовЗадолженностей
	|ПОМЕСТИТЬ СтрокиДоговоровВидыЗадолженности
	|ИЗ
	|	(ВЫБРАТЬ
	|		ИнвентаризацияГосдолгаЗадолженность.Ссылка КАК Ссылка,
	|		ВЫБОР
	|			КОГДА ИнвентаризацияГосдолгаЗадолженность.Валюта = &ВалютаРегУчета
	|					ИЛИ ИнвентаризацияГосдолгаЗадолженность.Счет В ИЕРАРХИИ (&Счет30112)
	|				ТОГДА ""внутренний долг""
	|			ИНАЧЕ ""внешний долг""
	|		КОНЕЦ КАК ВидЗадолженности
	|	ИЗ
	|		Документ.ИнвентаризацияГосдолгаВЦенныхБумагах.Задолженность КАК ИнвентаризацияГосдолгаЗадолженность
	|	ГДЕ
	|		ИнвентаризацияГосдолгаЗадолженность.Ссылка В(&МассивОбъектов)) КАК ВнутреннийЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВнутреннийЗапрос.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.Ссылка КАК Ссылка,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.Номер КАК Номер,
	|	ВЫБОР
	|		КОГДА ИнвентаризацияГосдолгаВЦенныхБумагах.СчетУчета В ИЕРАРХИИ (&Счет30112)
	|			ТОГДА ""внутренний долг""
	|		КОГДА ИнвентаризацияГосдолгаВЦенныхБумагах.СчетУчета В ИЕРАРХИИ (&Счет30142)
	|			ТОГДА ""внешний долг""
	|		КОГДА СтрокиДоговоровВидыЗадолженности.КоличествоВидовЗадолженностей = 1
	|			ТОГДА СтрокиДоговоровВидыЗадолженности.ВидЗадолженности
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ВидЗадолженности,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.ДатаИнвентаризации КАК ДатаОтчета,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.ДатаИнвентаризации КАК ДатаИнвентаризации,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.Организация.КодОКПО КАК КодОКПО,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.Подразделение.Наименование КАК НаименованиеПодразделения,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.НомерПриказаИнвентаризации КАК НомерПриказаИнвентаризации,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.ДатаПриказаИнвентаризации КАК ДатаПриказаИнвентаризации,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.ДатаНачала КАК ДатаНачала,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.ДатаОкончания КАК ДатаОкончания,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.ДолжностьПредседателяКомиссии КАК ДолжностьПредседателяКомиссии,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.ФамилияПредседателяКомиссии КАК ФамилияПредседателяКомиссии,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.ИмяПредседателяКомиссии КАК ИмяПредседателяКомиссии,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.ОтчествоПредседателяКомиссии КАК ОтчествоПредседателяКомиссии,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.МестоИнвентаризации КАК МестоИнвентаризации,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.ЗаключениеКомиссии КАК ЗаключениеКомиссии,
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.ДатаПодписиКомиссии КАК ДатаПодписиКомиссии
	|ИЗ
	|	Документ.ИнвентаризацияГосдолгаВЦенныхБумагах КАК ИнвентаризацияГосдолгаВЦенныхБумагах
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтрокиДоговоровВидыЗадолженности КАК СтрокиДоговоровВидыЗадолженности
	|		ПО ИнвентаризацияГосдолгаВЦенныхБумагах.Ссылка = СтрокиДоговоровВидыЗадолженности.Ссылка
	|ГДЕ
	|	ИнвентаризацияГосдолгаВЦенныхБумагах.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИнвентаризацияГосдолгаЗадолженность.Ссылка КАК Ссылка,
	|	ИнвентаризацияГосдолгаЗадолженность.Ссылка.Дата КАК ДатаДокумента,
	|	ИнвентаризацияГосдолгаЗадолженность.Договор КАК Договор
	|ПОМЕСТИТЬ СтрокиДоговоров
	|ИЗ
	|	Документ.ИнвентаризацияГосдолгаВЦенныхБумагах.Задолженность КАК ИнвентаризацияГосдолгаЗадолженность
	|ГДЕ
	|	ИнвентаризацияГосдолгаЗадолженность.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрокиДоговоровСоСрокамиМаксПериод.Ссылка КАК Ссылка,
	|	СтрокиДоговоровСоСрокамиМаксПериод.Договор КАК Договор,
	|	МАКСИМУМ(СрокиИсполненияИСуммыОбязательств.Регистратор) КАК МаксРегистратор
	|ПОМЕСТИТЬ СтрокиДоговоровСоСрокамиМаксРегистратор
	|ИЗ
	|	(ВЫБРАТЬ
	|		СтрокиДоговоров.Ссылка КАК Ссылка,
	|		СтрокиДоговоров.Договор КАК Договор,
	|		МАКСИМУМ(СрокиИсполненияИСуммыОбязательств.Период) КАК МаксПериод
