	Запрос.УстановитьПараметр("Счет30112", БухгалтерскийУчет.СписокСчетов("301.12"));
	Запрос.УстановитьПараметр("Счет30142", БухгалтерскийУчет.СписокСчетов("301.42"));
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	ВыборкаШапка = МассивРезультатов[1].Выбрать();
	ВыборкаТЧ1 = МассивРезультатов[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаТЧ2 = МассивРезультатов[6].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаТЧ3 = МассивРезультатов[7].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКомиссия = МассивРезультатов[8].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Выборки по документам:
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если ПервыйДокумент Тогда
			ПервыйДокумент = Ложь;
		Иначе
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ОбластьЗаголовок.Параметры.Заполнить(ВыборкаШапка);
		ТабДокумент.Вывести(ОбластьЗаголовок);
		
		ОбластьЗаключениеКомиссии = СформироватьЗаключениеКомиссии(ВыборкаШапка.ЗаключениеКомиссии, Макет);
		ТабДокумент.Вывести(ОбластьЗаключениеКомиссии);
		
		// Продвигаемся в остальных выборках до текущего документа:
