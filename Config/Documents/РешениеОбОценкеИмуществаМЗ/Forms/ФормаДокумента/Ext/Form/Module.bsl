КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("Подразделение"	, Объект.Подразделение);
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе"));
	ПараметрыПодбора.Вставить("НужнаАмортизация", Истина);
	
	Если Объект.Материалы.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("СкрытьКолонки", "КФО,КПС,СчетУчета,ЦМО");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьДопКолонкиПоСтроке(ТекСтрока)
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтрока.ОстаточнаяСтоимость = ТекСтрока.Сумма - ТекСтрока.СуммаАмортизации - ТекСтрока.СуммаОбесценения;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьДопКолонкиВоВсехСтроках(ТабЧасть)
	
	Для Каждого ТекСтрока из ТабЧасть Цикл
		РассчитатьДопКолонкиПоСтроке(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОсновныхСредствНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(Знач ВыбранноеЗначение)
	
	ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
	МассивДобавленныхСтрок = Новый Массив;
	Для Каждого СтрокаОС Из ТаблицаОС Цикл
		НоваяСтрока = Объект.Материалы.Добавить();
		НоваяСтрока["СубконтоЗабалансовыйСчет" + НомерЗабалансовогоСубконтоОС] = СтрокаОС.ОсновноеСредство;
		Если ЗначениеЗаполнено(НомерЗабалансовогоСубконтоЦМО) Тогда
			НоваяСтрока["СубконтоЗабалансовыйСчет" + НомерЗабалансовогоСубконтоЦМО] = СтрокаОС.ЦМО;
		КонецЕсли;
		Если ЗначениеЗаполнено(НомерЗабалансовогоСубконтоДоп) Тогда
			Если ВидСубконтоЗабалансовогоСубконтоДоп = ПланыВидовХарактеристик.ВидыСубконто.Договоры Тогда
				НоваяСтрока["СубконтоЗабалансовыйСчет" + НомерЗабалансовогоСубконтоДоп] = СтрокаОС.Договор;
			ИначеЕсли ВидСубконтоЗабалансовогоСубконтоДоп = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
				НоваяСтрока["СубконтоЗабалансовыйСчет" + НомерЗабалансовогоСубконтоДоп] = СтрокаОС.Контрагент;
			КонецЕсли;
		КонецЕсли;
		НоваяСтрока.Сумма = СтрокаОС.Сумма;
		НоваяСтрока.Количество = СтрокаОС.Количество;
		НоваяСтрока.ИнвентарныйНомер = СтрокаОС.ИнвентарныйНомер;
		НоваяСтрока.ЦМО = СтрокаОС.ЦМО;
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		МассивДобавленныхСтрок.Добавить(НоваяСтрока);
	КонецЦикла;
	
	РассчитатьСуммыНаСервере(МассивДобавленныхСтрок);
	РассчитатьДопКолонкиВоВсехСтроках(Объект.Материалы);

КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()
	
	ТаблицаОС = Объект.Материалы.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);
	
КонецФункции

&НаСервере
Процедура ПоместитьМатериалыВХранилищеНаСервере(ПараметрыПодбора)
	
	ПараметрыПодбора.ПараметрыТчДокумента = Новый Структура("АдресТчВХранилище");
	КолонкиРеквизитов = УправлениеМатериальнымиЗапасами.КолонкиПодбораДляВыгрузкиТабличнойЧасти(ЭтотОбъект.ПолучитьРеквизиты("Объект.Материалы"));
	ТаблицаМатериалы = Объект.Материалы.Выгрузить(,КолонкиРеквизитов);
	ПараметрыПодбора.ПараметрыТчДокумента.АдресТчВХранилище = ПоместитьВоВременноеХранилище(ТаблицаМатериалы, ЭтотОбъект.УникальныйИдентификатор);
	
КонецПроцедуры

