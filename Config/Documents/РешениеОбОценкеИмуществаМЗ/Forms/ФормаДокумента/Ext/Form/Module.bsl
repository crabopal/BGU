&НаСервере
Процедура ПолучитьИменаТабличныхЧастей()
	
	Для Каждого ТабличнаяЧасть Из Метаданные.Документы.РешениеОбОценкеИмуществаМЗ.ТабличныеЧасти Цикл
		Если ТабличнаяЧасть.Имя = "ДополнительныеРеквизиты" Тогда
			Продолжить;
		КонецЕсли;
		СписокИменТабличныхЧастей.Добавить(ТабличнаяЧасть.Имя);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Асинх Функция СогласиеПользователяНаОчисткуТЧ()
	
	ТекстВопроса = НСтр("ru = 'Табличные части документа будетут очищены'");
	Результат = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

&НаСервере
Процедура РассчитатьСуммыНаСервере(МассивСтрок = Неопределено)
	
	Запрос = Новый Запрос;
	Если МассивСтрок = Неопределено Тогда
		Запрос.УстановитьПараметр("ТаблицаОС", Объект.Материалы.Выгрузить(, "НомерСтроки,ИнвентарныйНомер,СубконтоЗабалансовыйСчет1,СубконтоЗабалансовыйСчет2,СубконтоЗабалансовыйСчет3"));
	Иначе
		Запрос.УстановитьПараметр("ТаблицаОС", Объект.Материалы.Выгрузить(МассивСтрок, "НомерСтроки,ИнвентарныйНомер,СубконтоЗабалансовыйСчет1,СубконтоЗабалансовыйСчет2,СубконтоЗабалансовыйСчет3"));
	КонецЕсли;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	Запрос.УстановитьПараметр("ТекущийДокумент", Объект.Ссылка);

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Т.СубконтоЗабалансовыйСчет1 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(Т.СубконтоЗабалансовыйСчет1 КАК Справочник.ОсновныеСредства)
	|		КОГДА Т.СубконтоЗабалансовыйСчет2 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(Т.СубконтоЗабалансовыйСчет2 КАК Справочник.ОсновныеСредства)
	|		КОГДА Т.СубконтоЗабалансовыйСчет3 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(Т.СубконтоЗабалансовыйСчет3 КАК Справочник.ОсновныеСредства)
	|	КОНЕЦ КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА Т.СубконтоЗабалансовыйСчет1 ССЫЛКА Справочник.ЦМО
	|			ТОГДА ВЫРАЗИТЬ(Т.СубконтоЗабалансовыйСчет1 КАК Справочник.ЦМО)
	|		КОГДА Т.СубконтоЗабалансовыйСчет2 ССЫЛКА Справочник.ЦМО
	|			ТОГДА ВЫРАЗИТЬ(Т.СубконтоЗабалансовыйСчет2 КАК Справочник.ЦМО)
	|		КОГДА Т.СубконтоЗабалансовыйСчет3 ССЫЛКА Справочник.ЦМО
	|			ТОГДА ВЫРАЗИТЬ(Т.СубконтоЗабалансовыйСчет3 КАК Справочник.ЦМО)
	|	КОНЕЦ КАК ЦМО,
	|	Т.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Т.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_ТаблицаОС
	|ИЗ
	|	&ТаблицаОС КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСтоимостиОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаСтоимостиОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СУММА(ТаблицаСтоимостиОС.БалансоваяСтоимость) КАК БалансоваяСтоимость,
	|	СУММА(ТаблицаСтоимостиОС.СуммаАмортизации) КАК СуммаАмортизации,
	|	СУММА(ТаблицаСтоимостиОС.СуммаОбесценения) КАК СуммаОбесценения
	|ПОМЕСТИТЬ ВТ_СтоимостиОС
	|ИЗ
	|	(ВЫБРАТЬ
	|		СтоимостьОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|		СтоимостьОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|		СтоимостьОбъектовОС.Стоимость КАК БалансоваяСтоимость,
	|		0 КАК СуммаАмортизации,
	|		0 КАК СуммаОбесценения
	|	ИЗ
	|		РегистрНакопления.СтоимостьОбъектовОС КАК СтоимостьОбъектовОС
	|	ГДЕ
	|		СтоимостьОбъектовОС.Организация = &Организация
	|		И СтоимостьОбъектовОС.ВидРаспоряжения В (ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе), ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ОперативныйУчет))
	|		И СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|		И СтоимостьОбъектовОС.Активность
	|		И СтоимостьОбъектовОС.Период <= &Период
	|		И (СтоимостьОбъектовОС.ОсновноеСредство, СтоимостьОбъектовОС.ИнвентарныйНомер, СтоимостьОбъектовОС.ЦМО) В
	|				(ВЫБРАТЬ
	|					ВТ_ТаблицаОС.ОсновноеСредство,
	|					ВТ_ТаблицаОС.ИнвентарныйНомер,
	|					ВТ_ТаблицаОС.ЦМО
	|				ИЗ
	|					ВТ_ТаблицаОС)
	|		И СтоимостьОбъектовОС.Регистратор <> &ТекущийДокумент
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		АмортизацияОбъектовОС.ОсновноеСредство,
	|		АмортизацияОбъектовОС.ИнвентарныйНомер,
	|		0,
	|		АмортизацияОбъектовОС.СуммаАмортизации,
	|		АмортизацияОбъектовОС.СуммаОбесценения
	|	ИЗ
	|		РегистрНакопления.АмортизацияОбъектовОС КАК АмортизацияОбъектовОС
	|	ГДЕ
	|		АмортизацияОбъектовОС.Организация = &Организация
	|		И АмортизацияОбъектовОС.ЭтоСписание
	|		И АмортизацияОбъектовОС.Активность
	|		И АмортизацияОбъектовОС.Период <= &Период
	|		И (АмортизацияОбъектовОС.ОсновноеСредство, АмортизацияОбъектовОС.ИнвентарныйНомер) В
	|				(ВЫБРАТЬ
	|					ВТ_ТаблицаОС.ОсновноеСредство,
	|					ВТ_ТаблицаОС.ИнвентарныйНомер
	|				ИЗ
	|					ВТ_ТаблицаОС)
	|		И АмортизацияОбъектовОС.Регистратор <> &ТекущийДокумент) КАК ТаблицаСтоимостиОС
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаСтоимостиОС.ОсновноеСредство,
	|	ТаблицаСтоимостиОС.ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаОС.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(ВТ_СтоимостиОС.БалансоваяСтоимость, 0) КАК Сумма,
	|	ЕСТЬNULL(ВТ_СтоимостиОС.СуммаОбесценения, 0) КАК СуммаОбесценения,
	|	ЕСТЬNULL(ВТ_СтоимостиОС.СуммаАмортизации, 0) КАК СуммаАмортизации
	|ИЗ
	|	ВТ_ТаблицаОС КАК ВТ_ТаблицаОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтоимостиОС КАК ВТ_СтоимостиОС
	|		ПО ВТ_ТаблицаОС.ОсновноеСредство = ВТ_СтоимостиОС.ОсновноеСредство
	|			И ВТ_ТаблицаОС.ИнвентарныйНомер = ВТ_СтоимостиОС.ИнвентарныйНомер
	|ГДЕ
	|	ЕСТЬNULL(ВТ_СтоимостиОС.БалансоваяСтоимость, 0) > 0"
	;
	
	ВыборкаСтоимостиОС = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаСтоимостиОС.Следующий() Цикл
		ТекущаяСтрока = Объект.Материалы[ВыборкаСтоимостиОС.НомерСтроки-1];
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ВыборкаСтоимостиОС, "Сумма,СуммаОбесценения,СуммаАмортизации");
		РассчитатьДопКолонкиПоСтроке(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере(МассивИменТЧ)
	
	Если Объект.Организация <> ЭтотОбъект.КэшПараметров.Организация Тогда
		
		Если Не ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.ВидОперации) Тогда
			Объект.ВидОперации = Перечисления.ВидыОперацийРешениеОбОценкеМЗ.ПустаяСсылка();
			Объект.ЗабалансовыйСчет = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		КонецЕсли;
		
		УстановитьДоступностьЭлементовФормы_ПоОперации(ЭтотОбъект);
		ЗаполнитьКЭШПараметровФормыЛокальныеСчета();
		ЗаполнитьЗабалансовыйСчет(ЭтотОбъект);
		ПрочитатьСвойстваЗабалансовогоСчета();
		УстановитьВидимостьЭлементовФормы_ЗабалансовыйСчет(ЭтотОбъект);
		УстановитьЗаголовокСубконтоЗабалансовогоСчета(ЭтотОбъект);
		ОчиститьТабличныеЧасти(МассивИменТЧ);
		
		УстановитьРуководителя(Объект);
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	ТребуетсяВызовСервера = ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика
		Или УправлениеМатериальнымиЗапасамиКлиентСервер.ИзменилосьПрименениеДетальногоКЭК340и440(
			ЭтотОбъект.КэшПараметров.Дата,
			ЭтотОбъект.КэшПараметров.Организация,
			Объект.Дата,
			Объект.Организация);
	
	Если ТребуетсяВызовСервера Тогда
		ДатаПриИзмененииНаСервере();
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()

	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	КонецЕсли;
	
	ЗаполнитьКЭШПараметровФормыЛокальныеСчета();
	НужноПерезаполнениеСчета = Истина;
	Для Каждого СчетКЭШ Из ЭтотОбъект.КэшПараметров.Локальные Цикл
		Если СчетКЭШ.Значение = Объект.ЗабалансовыйСчет Тогда
			НужноПерезаполнениеСчета = Ложь;
		КонецЕсли;
	КонецЦикла;
	Если НужноПерезаполнениеСчета Тогда
		ЗаполнитьЗабалансовыйСчет(ЭтотОбъект);
		ПрочитатьСвойстваЗабалансовогоСчета();
		УстановитьВидимостьЭлементовФормы_ЗабалансовыйСчет(ЭтотОбъект);
		УстановитьЗаголовокСубконтоЗабалансовогоСчета(ЭтотОбъект);
	КонецЕсли;

	УправлениеМатериальнымиЗапасами.ОбработатьИзменениеПримененияДетальногоКЭК340и440(ЭтотОбъект,
		ЭтотОбъект.КэшПараметров.Дата,
		ЭтотОбъект.КэшПараметров.Организация);

КонецПроцедуры

&НаСервере
Процедура ОчиститьТабличныеЧасти(МассивИменТЧ)
	
	Для Каждого ИмяТЧ Из МассивИменТЧ Цикл
		Объект[ИмяТЧ].Очистить();
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРуководителя(Объект)

	НовыйРуководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Руководитель",
		Объект.Организация, Объект.Дата, Объект.Подразделение);
	
	Если ЗначениеЗаполнено(НовыйРуководитель.ОтветственноеЛицоСсылка) 
		И Объект.Руководитель <> НовыйРуководитель.ОтветственноеЛицоСсылка Тогда
		Объект.Руководитель = НовыйРуководитель.ОтветственноеЛицоСсылка;
		#Если НаКлиенте Тогда
		ПоказатьОповещениеПользователя(,,НСтр("ru = 'Установлено новое значение поля ""Руководитель""'"));			
		#КонецЕсли
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение);
	
	ТаблицаПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	
	Если ТаблицаПодбора.Количество() Тогда
		ВтМатериалы = Объект.Материалы.Выгрузить();
		УправлениеМатериальнымиЗапасами.ЗаполнитьТаблицуИзПодбораМатериалов(ВтМатериалы, ТаблицаПодбора);
		
		СуммыНоменклатуры = СтоимостьНоменклатуры(ТаблицаПодбора);
		СуммыНоменклатуры.Индексы.Добавить("Номенклатура, КФО");
		Отбор = Новый Структура("Номенклатура, КФО");
		
		Для Каждого СтрокаМатериалы Из ВтМатериалы Цикл
			Если СтрокаМатериалы.НоваяСтрока Тогда
				ЗаполнитьЗначенияСвойств(Отбор, СтрокаМатериалы);
				Остатки = СуммыНоменклатуры.НайтиСтроки(Отбор);
				Если Остатки.Количество() И Остатки[0].Количество <> 0 Тогда
					ЗаполнитьЗначенияСвойств(СтрокаМатериалы, Остатки[0], "СчетУчета, КПС, КЭК");
					Если СтрокаМатериалы.Количество = Остатки[0].Количество Тогда
						СтрокаМатериалы.Сумма = Остатки[0].Сумма;
					Иначе
						СтрокаМатериалы.Сумма = СтрокаМатериалы.Количество * Остатки[0].Сумма / Остатки[0].Количество;
					КонецЕсли;
				КонецЕсли;
				СтрокаМатериалы.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			УстановитьЗаголовкиДинамическихКолонокСтроки(СтрокаМатериалы);
		КонецЦикла;
		
		Объект.Материалы.Загрузить(ВтМатериалы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СтоимостьНоменклатуры(ТаблицаНоменклатуры)

	ПараметрыСтоимости = УправлениеМатериальнымиЗапасами.СтоимостьСписанияНеактивовНаЗабалансе_Параметры(Объект);
	ПараметрыСтоимости.СчетУчетаЗабаланс
		= ОбщегоНазначенияБГУКлиентСервер.СвойствоЛокальногоКэшаФормы(ЭтотОбъект, "Счет024");
	ПараметрыСтоимости.СчетаУчетаБаланс
		= БухгалтерскийУчет.СписокСчетов("105.00, 113.00", Объект.Дата, Ложь, Объект.Организация);
	ПараметрыСтоимости.ТаблицаНоменклатуры = ТаблицаНоменклатуры;
	
	Возврат УправлениеМатериальнымиЗапасами.СтоимостьСписанияНеактивовНаЗабалансе(ПараметрыСтоимости);
	
КонецФункции

&НаКлиенте
Функция ДополнитьСтруктуруПодбора()
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("СчетУчета",              ОбщегоНазначенияБГУКлиентСервер.СвойствоЛокальногоКэшаФормы(ЭтотОбъект, "Счет024"));
	ПараметрыПодбора.Вставить("Подразделение",			Объект.Подразделение);
	ПараметрыПодбора.Вставить("ПоказыватьОстатки",		Истина);
	ПараметрыПодбора.Вставить("ПоказыватьСчетУчета",	Истина);
	ТипыНоменклатуры = Новый СписокЗначений;
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БиологическиеАктивы"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Блюдо"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ГСМ"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Медикаменты"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МолоднякИЖивотныеНаОткорме"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МягкийИнвентарь"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Посуда"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПродуктыПитания"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Стройматериалы"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Оборудование"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БСО"));
	ПараметрыПодбора.Вставить("ТипыНоменклатуры",		ТипыНоменклатуры);
	ПараметрыПодбора.Вставить("ИмяТаблицы",				"Материалы");
	Возврат ПараметрыПодбора;

КонецФункции

&НаСервере
Процедура УстановитьДанныеДинамическихКолонок()

	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТаблицыМатериалы(
		ЭтотОбъект, Объект, "Материалы");
	УстановитьЗаголовкиДинамическихКолонок(ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиДинамическихКолонок(Форма)
	Для Каждого Строка Из Форма.Объект.Материалы Цикл
		УстановитьЗаголовкиДинамическихКолонокСтроки(Строка);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиДинамическихКолонокСтроки(Строка)
	ЗаголовкиСтроки = Новый Структура;
	ЗаголовкиСтроки.Вставить("ЗаголовокМетодРыночныхЦен", НСтр("ru = 'Метод рыночных цен'"));
	ЗаголовкиСтроки.Вставить("ЗаголовокОтчетОценщика", НСтр("ru = 'Отчет оценщика №'"));
	ЗаголовкиСтроки.Вставить("ЗаголовокОтчетОценщикаДата", НСтр("ru = 'от'"));
	ЗаполнитьЗначенияСвойств(Строка, ЗаголовкиСтроки);
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЗаполнитьКЭШПараметровФормыЛокальныеСчета();
	УстановитьДанныеДинамическихКолонок();
	РаботаСФайламиБГУ.ЗаполнитьФайлыСотрудниковВТаблице(
	ОбщегоНазначенияБГУКлиентСервер.ПараметрыВыбораФайлаОсобогоМненияСотрудника(ЭтотОбъект));
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	УстановитьДоступностьЭлементовФормы_ПоОперации(ЭтотОбъект);
	ПрочитатьСвойстваЗабалансовогоСчета();
	УстановитьЗаголовокСубконтоЗабалансовогоСчета(ЭтотОбъект);
	УстановитьВидимостьЭлементовФормы_ЗабалансовыйСчет(ЭтотОбъект);
	РассчитатьДопКолонкиВоВсехСтроках(Объект.Материалы);
	
	ПолучитьИменаТабличныхЧастей();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКЭШПараметровФормыЛокальныеСчета()
	
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСчета = Объект.Дата;
	Иначе
		ДатаСчета = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет105",
		БухгалтерскийУчет.СчетПоКоду("105.00", ДатаСчета, Объект.Организация));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет024",
		БухгалтерскийУчет.СчетПоКоду("02.4", ДатаСчета, Объект.Организация));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет023",
		БухгалтерскийУчет.СчетПоКоду("02.3", ДатаСчета, Объект.Организация));
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция Счет105(Форма)
	Возврат ОбщегоНазначенияБГУКлиентСервер.СвойствоЛокальногоКэшаФормы(
		Форма,
		"Счет105",
		ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка"));
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьСвойстваЗабалансовогоСчета(Форма)
	
	Форма.НомерЗабалансовогоСубконтоЦМО = 0;
	Форма.НомерЗабалансовогоСубконтоДоп = 0;
	Форма.НомерЗабалансовогоСубконтоОС = 0;
	Форма.ЗаголовокЗабалансовогоСубконтоДоп = "";
	Форма.ВидСубконтоЗабалансовогоСубконтоДоп = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьЗабалансовыйСчет(Форма)
	
	Если Форма.Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРешениеОбОценкеМЗ.МатериальныеЗапасы") Тогда
		Форма.Объект.ЗабалансовыйСчет = ОбщегоНазначенияБГУКлиентСервер.СвойствоЛокальногоКэшаФормы(
		Форма,
		"Счет024",
		ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка"));
	ИначеЕсли Форма.Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРешениеОбОценкеМЗ.ОсновныеСредства") Тогда
		Форма.Объект.ЗабалансовыйСчет = ОбщегоНазначенияБГУКлиентСервер.СвойствоЛокальногоКэшаФормы(
		Форма,
		"Счет023",
		ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьСвойстваЗабалансовогоСчета()
	
	ОчиститьСвойстваЗабалансовогоСчета(ЭтотОбъект);
	Если ЗначениеЗаполнено(Объект.ЗабалансовыйСчет)
		И Объект.ВидОперации = Перечисления.ВидыОперацийРешениеОбОценкеМЗ.ОсновныеСредства Тогда
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Объект.ЗабалансовыйСчет);
		Для Номер = 1 По СвойстваСчета.КоличествоСубконто Цикл
			Если СвойстваСчета["ВидСубконто" + Номер] = ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
				НомерЗабалансовогоСубконтоЦМО = Номер;
			ИначеЕсли СвойстваСчета["ВидСубконто" + Номер] = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
				НомерЗабалансовогоСубконтоОС = Номер;
			ИначеЕсли СвойстваСчета["ВидСубконто" + Номер] <> ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
				НомерЗабалансовогоСубконтоДоп = Номер;
				ЗаголовокЗабалансовогоСубконтоДоп = СвойстваСчета["ВидСубконто" + Номер + "Наименование"];
				ВидСубконтоЗабалансовогоСубконтоДоп = СвойстваСчета["ВидСубконто" + Номер];
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокСубконтоЗабалансовогоСчета(Форма)
	Если ЗначениеЗаполнено(Форма.ЗаголовокЗабалансовогоСубконтоДоп) Тогда
		ТекстЗаголовка = СтрШаблон(НСтр("ru = '(заб) %1'"), Форма.ЗаголовокЗабалансовогоСубконтоДоп);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"МатериалыСубконтоЗабалансовыйСчет" + Форма.НомерЗабалансовогоСубконтоДоп,
			"Заголовок",
			ТекстЗаголовка);
	КонецЕсли;
	Если ЗначениеЗаполнено(Форма.НомерЗабалансовогоСубконтоЦМО) Тогда
		ТекстЗаголовка = НСтр("ru = '(заб) ЦМО'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"МатериалыСубконтоЗабалансовыйСчет" + Форма.НомерЗабалансовогоСубконтоЦМО,
			"Заголовок",
			ТекстЗаголовка);
	КонецЕсли;
	Если ЗначениеЗаполнено(Форма.НомерЗабалансовогоСубконтоОС) Тогда
		ТекстЗаголовка = НСтр("ru = '(заб) ОС'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"МатериалыСубконтоЗабалансовыйСчет" + Форма.НомерЗабалансовогоСубконтоОС,
			"Заголовок",
			ТекстЗаголовка);
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементовФормы_ПоОперации(Форма)
	
	ДоступностьПоля = ЗначениеЗаполнено(Форма.Объект.Организация);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	Форма.Элементы,
	"ВидОперации",
	"Доступность",
	ДоступностьПоля);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_ЗабалансовыйСчет(Форма)

	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ВидимостьЗабалансовыхСубконто = Новый Массив(3);
	Для Индекс = 0 По 2 Цикл
		ВидимостьЗабалансовыхСубконто[Индекс] = Ложь;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Форма.НомерЗабалансовогоСубконтоДоп) Тогда
		ВидимостьЗабалансовыхСубконто[Форма.НомерЗабалансовогоСубконтоДоп - 1] = Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(Форма.НомерЗабалансовогоСубконтоЦМО) Тогда
		ВидимостьЗабалансовыхСубконто[Форма.НомерЗабалансовогоСубконтоЦМО - 1] = Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(Форма.НомерЗабалансовогоСубконтоОС) Тогда
		ВидимостьЗабалансовыхСубконто[Форма.НомерЗабалансовогоСубконтоОС - 1] = Истина;
	КонецЕсли;
	
	Для Номер = 1 По ВидимостьЗабалансовыхСубконто.Количество() Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"МатериалыСубконтоЗабалансовыйСчет" + Номер,
		"Видимость",
		ВидимостьЗабалансовыхСубконто[Номер - 1]);
	КонецЦикла;
	
	МассивЭлементовОС = Новый Массив;
	МассивЭлементовОС.Добавить("МатериалыИнвентарныйНомер");
	МассивЭлементовОС.Добавить("МатериалыСуммаАмортизации");
	МассивЭлементовОС.Добавить("МатериалыСуммаОбесценения");
	МассивЭлементовОС.Добавить("МатериалыОстаточнаяСтоимость"); 
	МассивЭлементовОС.Добавить("МатериалыКомандаРассчитатьСтоимостьОС");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(
	Элементы,
	МассивЭлементовОС,
	"Видимость",
	ЗначениеЗаполнено(Форма.НомерЗабалансовогоСубконтоОС));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	Элементы,
	"МатериалыСрокЭксплуатации",
	"Видимость",
	НЕ ЗначениеЗаполнено(Форма.НомерЗабалансовогоСубконтоОС));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеНоменклатурыВСтроке(ИдентификаторСтроки, Знач ЗаполнятьСчет)
	
	ТекущиеДанные = Объект.Материалы.НайтиПоИдентификатору(ИдентификаторСтроки);
	ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, ТекущиеДанные, ЗаполнятьСчет);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеСчетаВСтроке(Форма, Строка, ЗаполнятьСчет)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Форма, Строка);
	ПараметрыОбработки.ЗаполнятьСчет = ЗаполнятьСчет;
	ПараметрыОбработки.ДтКт          = "Дт";
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
	
КонецПроцедуры

&НаСервере
Процедура СотрудникПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	
	РаботаСФайламиБГУ.ПолучитьФайлСотрудника(Сотрудник, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	УправлениеМатериальнымиЗапасами.УстановитьУсловноеОформлениеСпискаМатериалов(ЭтотОбъект, "Материалы");
	УстановитьУсловноеОформлениеЭлементовСпискаВыбора(Элементы.МатериалыОпределенаОценщиком);
	
	// Решение сотрудника.
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.МатериалыРешениеСотрудникаПоРезолюции.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Материалы.РешениеСотрудникаПоРезолюции", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.За);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаПоложительногоВыполненияЗадачи);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.МатериалыРешениеСотрудникаПоРезолюции.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Материалы.РешениеСотрудникаПоРезолюции", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.Против);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаОтрицательногоВыполненияЗадачи);
	
	// Определение стоимости

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.МатериалыЗаголовокМетодРыночныхЦен.Имя);
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.МатериалыМетодРыночныхЦен.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Материалы.ОпределенаОценщиком", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.МатериалыЗаголовокОтчетОценщика.Имя);
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.МатериалыОценкаНомер.Имя);
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.МатериалыЗаголовокОтчетОценщикаДата.Имя);
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.МатериалыОценкаДата.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Материалы.ОпределенаОценщиком", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);

	ОбщегоНазначенияБГУ.УстановитьУсловноеОформлениеКомиссии(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеЭлементовСпискаВыбора(Элемент)
	
	Для Каждого ЭлементСписка Из Элемент.СписокВыбора Цикл
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элемент.Имя);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор, Элемент.ПутьКДанным,
			ВидСравненияКомпоновкиДанных.Равно, ЭлементСписка.Значение);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", ЭлементСписка.Представление);
		
	КонецЦикла;
	
КонецПроцедуры

