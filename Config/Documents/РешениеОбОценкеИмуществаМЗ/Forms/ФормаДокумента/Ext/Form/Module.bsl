&НаКлиенте
Процедура ПодборНоменклатуры(Команда)
	
	Если НомерЗабалансовогоСубконтоОС = 0 Тогда
		ПараметрыПодбора = Новый Структура("ПараметрыТчДокумента", Неопределено);
		Если Объект.Материалы.Количество() Тогда
			ПоместитьМатериалыВХранилищеНаСервере(ПараметрыПодбора)
		КонецЕсли;
		
		УправлениеМатериальнымиЗапасамиКлиент.ОткрытьПодборМатериаловРасширенный(
		ЭтотОбъект,
		Объект,
		,
		ДополнитьСтруктуруПодбора(),
		ПараметрыПодбора.ПараметрыТчДокумента);
	Иначе
		ПараметрыПодбора = Новый Структура;
		ПараметрыПодбора.Вставить("ИФО"				, Объект.ИФО);
		ПараметрыПодбора.Вставить("Счет"			, Объект.ЗабалансовыйСчет);
		ПараметрыПодбора.Вставить("ВидРаспоряжения", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаХранении"));
		ПараметрыПодбора.Вставить("КолонкиКорзины", Новый Структура("Цена", "СтоимостьЕдиницы"));
		УправлениеОсновнымиСредствамиКлиент.ОткрытьПодборОсновныхСредств(ЭтотОбъект, Объект, ПараметрыПодбора);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСохранитьРезультатыГолосования(Команда)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Сотрудник", Сотрудник);
	ДопПараметры.Вставить("РезультатыГолосования", Новый Массив);
	Для Каждого СтрокаОС Из Объект.Материалы Цикл
		Если ЗначениеЗаполнено(СтрокаОС.РешениеСотрудникаПоРезолюции) Тогда
			РезультатГолосования = Новый Структура("ИдентификаторСтроки,РешениеСотрудникаПоРезолюции",
				СтрокаОС.ИдентификаторСтроки, СтрокаОС.РешениеСотрудникаПоРезолюции);
			ДопПараметры.РезультатыГолосования.Добавить(РезультатГолосования);
		КонецЕсли;
	КонецЦикла;
	
	Оповещение = Новый ОписаниеОповещения("ВопросСохранитьРезультатыГолосованияЗавершение", ЭтотОбъект, ДопПараметры);
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Сохранить результаты голосования члена комиссии ""%1""?'"), Сотрудник);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

