#КонецОбласти

#Область ГолосованиеКомиссиии

// Заполнить результат голосования.
// 
// Параметры:
//  Форма - см. Документ.РешениеОбОценкеИмуществаМЗ.Форма.ФормаДокумента
Процедура ЗаполнитьРезультатГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;

	ЗаполнитьРезультатыГолосования = Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	Если ЗаполнитьРезультатыГолосования Тогда
		РезультатГолосованияСотрудника = ОбщегоНазначенияБГУ.РезультатыГолосованияСотрудникаПоДокументу(
			Форма.Сотрудник, Объект.Ссылка, Объект.Комиссия, Объект.Организация);
		РезультатГолосованияКомиссии = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(
			Объект.Ссылка, Объект.Комиссия, Объект.Организация);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.Материалы Цикл
		
		СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Неопределено;
		СтрокаТаблицы.ИтогГолосования = 0;
		СтрокаТаблицы.РезолюцияКомиссииОдобрена = Ложь;
		Если ЗаполнитьРезультатыГолосования Тогда
			
			Если РезультатГолосованияСотрудника.Количество() > 0 Тогда
				Результаты = РезультатГолосованияСотрудника.Найти(СтрокаТаблицы.ИдентификаторСтроки, "ИдентификаторСтроки");
				Если Результаты <> Неопределено Тогда
					СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Результаты.РезультатГолосования;
				КонецЕсли;
			КонецЕсли;
			
			Если РезультатГолосованияКомиссии.Количество() > 0 Тогда
				ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки",
					Объект.Ссылка, СтрокаТаблицы.ИдентификаторСтроки);
				РезультатыГолосованияПоСтроке = РезультатГолосованияКомиссии.НайтиСтроки(ОтборПоИдентификаторуСтроки);
				Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
					СтрокаТаблицы.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
					СтрокаТаблицы.РезолюцияКомиссииОдобрена = РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Форма.ВФормеЕстьРезультатыГолосования = (Объект.Материалы.Итог("ИтогГолосования") <> 0);
КонецПроцедуры

// Управление элементами голосования.
// 
// Параметры:
//  Форма - см. Документ.РешениеОбОценкеИмуществаМЗ.Форма.ФормаДокумента
Процедура УправлениеЭлементамиГолосования(Форма) Экспорт

	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Если НЕ Форма.ВФормеЕстьРезультатыГолосования Тогда
		ЭлементыГолосование = Новый Массив;
		ЭлементыГолосование.Добавить("ГруппаГолосование");
		ЭлементыГолосование.Добавить("МатериалыПодменюУстановитьРешение");
		ЭлементыГолосование.Добавить("МатериалыПодменюУстановитьРешениеЕдиногласно");
		ЭлементыГолосование.Добавить("МатериалыРезолюцияКомиссии");
		ЭлементыГолосование.Добавить("МатериалыРешениеСотрудникаПоРезолюции");
		ЭлементыГолосование.Добавить("МатериалыГруппаПроцентГолосовЗа");
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
			ЭлементыГолосование, "Видимость", ЛОЖЬ);
	Иначе	
		ДоступностьГолосования = Не Объект.Проведен
			И Не Объект.Ссылка.Пустая()
			И ЗначениеЗаполнено(Объект.Комиссия)
			И ЗначениеЗаполнено(Объект.Организация);
		
		ЭлементыГолосование = Новый Массив; // Массив из Строка
		ЭлементыГолосование.Добавить("Сотрудник");
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
			ЭлементыГолосование, "Доступность", ДоступностьГолосования);
		
		ЭлементыГолосование = Новый Массив;
		ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеЕдиногласноЗаВоВсехСтроках");
		ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеЕдиногласноПротивВоВсехСтроках");
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
			ЭлементыГолосование, "Видимость", ДоступностьГолосования И Не ЗначениеЗаполнено(Форма.Сотрудник));
		
		ЭлементыГолосование = Новый Массив;
		ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеЗаВоВсехСтроках");
		ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеПротивВоВсехСтроках");
		ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеЗаВВыделенныхСтроках");
		ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеПротивВВыделенныхСтроках");
		ЭлементыГолосование.Добавить("МатериалыРешениеСотрудникаПоРезолюции");
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
			ЭлементыГолосование, "Видимость", ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник));
		
		ЭлементыГолосование = Новый Массив;
		ЭлементыГолосование.Добавить("СохранитьРезультатыГолосования");
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
			ЭлементыГолосование, "Доступность", 
			ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник) И Форма.РешениеСотрудникаМодифицированность);
	КонецЕсли;		
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РешениеОбОценкеИмуществаМЗ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РешениеОбОценкеИмуществаМЗ КАК РешениеОбОценкеИмуществаМЗ
	|ГДЕ
	|	РешениеОбОценкеИмуществаМЗ.ЗабалансовыйСчет = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)";
	
	РегистрируемыеСсылки = Новый Массив;
	КоличествоСсылок = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		РегистрируемыеСсылки.Добавить(Выборка.Ссылка);
		КоличествоСсылок = КоличествоСсылок + 1;
		Если КоличествоСсылок = 1000 Тогда
			ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, РегистрируемыеСсылки);
			РегистрируемыеСсылки.Очистить();
			КоличествоСсылок = 0;
		КонецЕсли;
	КонецЦикла;
	
	Если РегистрируемыеСсылки.Количество() > 0 Тогда
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, РегистрируемыеСсылки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.РешениеОбОценкеИмуществаМЗ";
	МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	ОбъектовОбработано = 0;
	ПроблемныхОбъектов = 0;
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			
			ПредставлениеОбъекта = Строка(Выборка.Ссылка);
			
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			
			Если Объект = Неопределено Тогда
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Иначе
				Объект.Заблокировать();
				ЗаполнитьДобавленныеРеквизитыШапки_2_102_11(Объект);
				Если Объект.Модифицированность() Тогда
					ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
				Иначе
					ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
				КонецЕсли;
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось обработать объект: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,
			МетаданныеДокумента,
			Выборка.Ссылка,
			ТекстСообщения);
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			// Прервать текущую итерацию цикла, чтобы не увеличивать счетчик обработанных объектов.
			Продолжить;
			
		КонецПопытки;
		ОбъектовОбработано = ОбъектовОбработано + 1;
		
	КонецЦикла;
	
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Не удалось обработать некоторые документы ""%1"" (пропущены): %2'"),
		МетаданныеДокумента.Синоним,
		ПроблемныхОбъектов);
		ВызватьИсключение ТекстСообщения;
	Иначе
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
		УровеньЖурналаРегистрации.Информация, МетаданныеДокумента,,
		СтрШаблон(НСтр("ru = 'Обработана очередная порция документов ""%1"": %2'"),
		МетаданныеДокумента.Синоним,
		ОбъектовОбработано));
	КонецЕсли;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

Процедура ЗаполнитьДобавленныеРеквизитыШапки_2_102_11(Объект)
	
	Объект.ВидОперации 		= Перечисления.ВидыОперацийРешениеОбОценкеМЗ.МатериальныеЗапасы;
	Объект.ЗабалансовыйСчет = БухгалтерскийУчет.СчетПоКоду("02.4", Объект.Дата, Объект.Организация);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
