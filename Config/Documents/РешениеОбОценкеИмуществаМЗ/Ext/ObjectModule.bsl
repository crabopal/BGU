#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Материалы Цикл
		
		Если СтрокаТаблицы.ОпределенаОценщиком Тогда
			СтрокаТаблицы.МетодРыночныхЦен = Перечисления.МетодыОпределенияРыночныхЦенПриОценкеСтоимостиИмущества.ПустаяСсылка();
		Иначе
			СтрокаТаблицы.ОценкаНомер = "";
			СтрокаТаблицы.ОценкаДата  = '00010101';
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	НепроверяемыеРеквизиты = Новый Массив;
	НепроверяемыеРеквизиты.Добавить("Материалы.МетодРыночныхЦен");
	НепроверяемыеРеквизиты.Добавить("Материалы.ОценкаНомер");
	НепроверяемыеРеквизиты.Добавить("Материалы.ОценкаДата");
	
	ДобавитьНепроверяемыеСубконтоЗабалансовогоСчета(НепроверяемыеРеквизиты);

	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	ПроверитьЗаполнениеРеквизитовСтрок(Отказ);
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ЗаполнениеРеквизитовОбъектов.ЗаполнитьДатуПриКопировании(ЭтотОбъект, ОбъектКопирования);
	ДатаНовогоДокумента = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	
	ОбязательноЗаполнитьКЭК = УправлениеМатериальнымиЗапасамиКлиентСервер.ИзменилосьПрименениеДетальногоКЭК340и440(
		ОбъектКопирования.Дата,
		ОбъектКопирования.Организация,
		ДатаНовогоДокумента,
		Организация);
	
	УправлениеМатериальнымиЗапасами.УстановитьНовоеЗначениеКЭКВТабличныхЧастях(ЭтотОбъект, ДатаНовогоДокумента,
		ОбязательноЗаполнитьКЭК);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗаполнениеРеквизитовСтрок(Отказ)
	
	Для Каждого Строка Из Материалы Цикл
		Если Строка.ОпределенаОценщиком Тогда
			Если Не ЗначениеЗаполнено(Строка.ОценкаНомер) Тогда
				ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
					"Колонка",
					"Заполнение",
					НСтр("ru = 'Номер отчета оценщика'"),
					Строка.НомерСтроки,
					НСтр("ru = 'Материалы'"));
				ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
					"Материалы",
					Строка.НомерСтроки,
					"ОценкаНомер");
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Ссылка, ПутьКПолю, "Объект", Отказ);
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Строка.ОценкаДата) Тогда
				ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
					"Колонка",
					"Заполнение",
					НСтр("ru = 'Дата отчета оценщика'"),
					Строка.НомерСтроки,
					НСтр("ru = 'Материалы'"));
				ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
					"Материалы",
					Строка.НомерСтроки,
					"ОценкаДата");
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Ссылка, ПутьКПолю, "Объект", Отказ);
			КонецЕсли;
		Иначе
			Если Не ЗначениеЗаполнено(Строка.МетодРыночныхЦен) Тогда
				ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
					"Колонка",
					"Заполнение",
					НСтр("ru = 'Метод рыночных цен'"),
					Строка.НомерСтроки,
					НСтр("ru = 'Материалы'"));
				ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
					"Материалы",
					Строка.НомерСтроки,
					"МетодРыночныхЦен");
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Ссылка, ПутьКПолю, "Объект", Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьНепроверяемыеСубконтоЗабалансовогоСчета(НепроверяемыеРеквизиты)
	
	МаксимальноеКоличествоСубконто = БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто();
	
	Если ЗначениеЗаполнено(ЗабалансовыйСчет) Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ЗабалансовыйСчет);
		Для Счетчик = 1 По МаксимальноеКоличествоСубконто Цикл
			Если Счетчик > СвойстваСчета.КоличествоСубконто
				ИЛИ СвойстваСчета["ВидСубконто" + Счетчик] = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура
				ИЛИ НЕ СвойстваСчета["ВидСубконто" + Счетчик + "Обязательный"] 
				ИЛИ ВидОперации = Перечисления.ВидыОперацийРешениеОбОценкеМЗ.МатериальныеЗапасы Тогда
				НепроверяемыеРеквизиты.Добавить("Материалы.СубконтоЗабалансовыйСчет" + Счетчик);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли