&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	УстановитьОтветственного();
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДокументОснованиеТребуетВыбораДанных(Объект)
	Возврат ЗначениеЗаполнено(Объект.ДокументОснование)
		И (ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.АктСписанияМЗ")
			Или ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ТребованиеНакладная0315006")
			Или ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ВедомостьНаВыдачуМЗНаНуждыУчреждения"));
КонецФункции

&НаКлиенте
Процедура Подключаемый_ОткрытьВыборРеквизитовОснования()
	ОкончаниеВыбора = Новый ОписаниеОповещения("ПослеВыбораРеквизитовОснования", ЭтотОбъект);
	ПараметрыФормы = Новый Структура("Основание", Объект.ДокументОснование);
	ОткрытьФорму("Документ.ПоступлениеБСО.Форма.ФормаВыбораКФОИлиЦМО", ПараметрыФормы, ЭтотОбъект, УникальныйИдентификатор,
		,,ОкончаниеВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораРеквизитовОснования(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Объект.КФО = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "КФО", ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка"));
	Объект.ЦМО = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "ЦМО", ПредопределенноеЗначение("Справочник.ЦМО.ПустаяСсылка"));
	Объект.Подразделение = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "Подразделение", ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка"));
	
	ЗаполнитьПоДокументуОснованиюНаСервере(Объект.КФО, Объект.ЦМО, Объект.Подразделение);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуОснованиюНаСервере(КФО, ЦМО, Подразделение)
	Объект.СоставБСО.Очистить();
	Для Каждого Строка Из Документы.ПоступлениеБСО.ТаблицаДокументаОснования(Объект.ДокументОснование, КФО, ЦМО, Подразделение) Цикл
		ЗаполнитьЗначенияСвойств(Объект.СоставБСО.Добавить(), Строка);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияСостояниеОригиналаНажатие()
    // СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
    УчетОригиналовПервичныхДокументовКлиент.ОткрытьМенюВыбораСостояния(ЭтотОбъект,Элементы.ДекорацияСостояниеОригинала);
    //Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()

	ОрганизацияЗаполнена = ЗначениеЗаполнено(Объект.Организация);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЦМО",
		"Доступность", ОрганизацияЗаполнена);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Подразделение",
		"Доступность", ОрганизацияЗаполнена);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьМаскуПолейПорядковогоНомера(ДлинаНомера)

	#Если НЕ ВебКлиент Тогда
	УправлениеМатериальнымиЗапасамиКлиент.УстановитьМаскуПолейПорядковогоНомера(ДлинаНомера,
																				Элементы.СоставБСОНомерНачальный,
																				Элементы.СоставБСОНомерКонечный);
	#КонецЕсли
	
КонецПроцедуры
 
&НаСервере
Процедура ЗаполнитьДлиныНомеров()

	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Объект.СоставБСО.Выгрузить().ВыгрузитьКолонку("БСО"), "ДлинаНомера");
	Для каждого ТекСтр Из Объект.СоставБСО Цикл
		ТекБСО = ЗначенияРеквизитов[ТекСтр.БСО];
		Если ТекБСО <> Неопределено Тогда
			ТекСтр.ДлинаНомера = ТекБСО.ДлинаНомера;
		КонецЕсли;
	КонецЦикла; 	

КонецПроцедуры

&НаСервереБезКонтекста 
Функция ПолучитьДлинуНомера(ТекБСО)
	Возврат  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекБСО, "ДлинаНомера");
КонецФункции

