#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.ПоступлениеБСО.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

    // Движения по денежным средствам.
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ДвиженияБСО")
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если (НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"))
		ИЛИ (Не БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ЭтотОбъект.СчетУчета).УчетПоПодразделениям) Тогда
		НеПроверяемыеРеквизиты = Новый Массив;
		НеПроверяемыеРеквизиты.Добавить("Подразделение");
		ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
	КонецЕсли;
	
	ТаблицаБСО = Новый ТаблицаЗначений;
	ТаблицаБСО.Колонки.Добавить("БСО", Новый ОписаниеТипов("СправочникСсылка.БСО"));
	ТаблицаБСО.Колонки.Добавить("СерияБСО", Новый ОписаниеТипов("СправочникСсылка.СерииБСО"));
	ТаблицаБСО.Колонки.Добавить("НомерНачальный", Новый ОписаниеТипов("Число"));
	ТаблицаБСО.Колонки.Добавить("НомерКонечный", Новый ОписаниеТипов("Число"));
	ТаблицаБСО.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Для каждого ТекСтр Из СоставБСО Цикл
	
		НовСтр = ТаблицаБСО.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, ТекСтр, "БСО, СерияБСО, НомерСтроки");
		НовСтр.НомерНачальный = Число(ТекСтр.НомерНачальный);
		НовСтр.НомерКонечный = Число(?(ЗначениеЗаполнено(ТекСтр.НомерКонечный),ТекСтр.НомерКонечный,ТекСтр.НомерНачальный));
	
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоставБСО.БСО,
	               |	СоставБСО.СерияБСО,
	               |	СоставБСО.НомерСтроки,
	               |	СоставБСО.НомерНачальный,
	               |	СоставБСО.НомерКонечный
	               |ПОМЕСТИТЬ СоставБСО
	               |ИЗ
	               |	&СоставБСО КАК СоставБСО
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СоставБСО.НомерСтроки,
	               |	1 КАК Приоритет
	               |ПОМЕСТИТЬ Ошибки
	               |ИЗ
	               |	СоставБСО КАК СоставБСО
	               |ГДЕ
	               |	СоставБСО.НомерНачальный = 0
	               |	И СоставБСО.НомерКонечный = 0
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СоставБСО.НомерСтроки,
	               |	2
	               |ИЗ
	               |	СоставБСО КАК СоставБСО
	               |ГДЕ
	               |	СоставБСО.НомерНачальный = 0
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СоставБСО.НомерСтроки,
	               |	3
	               |ИЗ
	               |	СоставБСО КАК СоставБСО
	               |ГДЕ
	               |	СоставБСО.НомерКонечный = 0
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СоставБСО.НомерСтроки,
	               |	4
	               |ИЗ
	               |	СоставБСО КАК СоставБСО
	               |ГДЕ
	               |	СоставБСО.НомерКонечный < СоставБСО.НомерНачальный
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СоставБСО.НомерСтроки,
	               |	5
	               |ИЗ
	               |	СоставБСО КАК СоставБСО
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СоставБСО КАК СоставБСО1
	               |		ПО СоставБСО.БСО = СоставБСО1.БСО
	               |			И СоставБСО.СерияБСО = СоставБСО1.СерияБСО
	               |			И СоставБСО.НомерНачальный >= СоставБСО1.НомерНачальный
	               |			И СоставБСО.НомерНачальный <= СоставБСО1.НомерКонечный
	               |			И СоставБСО.НомерСтроки > СоставБСО1.НомерСтроки
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СоставБСО.НомерСтроки,
	               |	6
	               |ИЗ
	               |	СоставБСО КАК СоставБСО
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СоставБСО КАК СоставБСО1
	               |		ПО СоставБСО.БСО = СоставБСО1.БСО
	               |			И СоставБСО.СерияБСО = СоставБСО1.СерияБСО
	               |			И СоставБСО.НомерКонечный >= СоставБСО1.НомерНачальный
	               |			И СоставБСО.НомерКонечный <= СоставБСО1.НомерКонечный
	               |			И СоставБСО.НомерСтроки > СоставБСО1.НомерСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Ошибки.НомерСтроки КАК НомерСтроки,
	               |	МИНИМУМ(Ошибки.Приоритет) КАК Приоритет
	               |ИЗ
	               |	Ошибки КАК Ошибки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Ошибки.НомерСтроки
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	Запрос.УстановитьПараметр("СоставБСО", ТаблицаБСО);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Приоритет = 1 Тогда
			ТекстОшибки = НСтр("ru='В строке %1 не заполнены начальный и конечный номера'");
			ИмяПоля = "НомерНачальный";
		ИначеЕсли Выборка.Приоритет = 2 Тогда
			ТекстОшибки = НСтр("ru='В строке %1 не заполнен начальный номер'");
			ИмяПоля = "НомерНачальный";
		ИначеЕсли Выборка.Приоритет = 3 Тогда
			ТекстОшибки = НСтр("ru='В строке %1 не заполнен конечный номер'");
			ИмяПоля = "НомерКонечный";
		ИначеЕсли Выборка.Приоритет = 4 Тогда
			ТекстОшибки = НСтр("ru='В строке %1 конечный номер меньше начального'");
			ИмяПоля = "НомерКонечный";
		ИначеЕсли Выборка.Приоритет = 5 Тогда
			ТекстОшибки = НСтр("ru='В строке %1 начальный номер входит в интервал из предыдущих строк'");
			ИмяПоля = "НомерНачальный";
		Иначе
			ТекстОшибки = НСтр("ru='В строке %1 конечный номер входит в интервал из предыдущих строк'");
			ИмяПоля = "НомерКонечный";
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю(	СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.НомерСтроки),
															,"Объект.СоставБСО["+(Выборка.НомерСтроки-1)+"]."+ИмяПоля,,Отказ);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если ЭтоСписаниеМЗ(ДанныеЗаполнения) Тогда
		ЗаполнитьПоСписаниюМЗ(ДанныеЗаполнения, СтандартнаяОбработка);
	ИначеЕсли ЭтоЗаполнениеНаОснованииИнвентаризации0510465(ДанныеЗаполнения) Тогда
		ЗаполнитьПоИнвентаризации0510465(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ДокОснование = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "Основание");
		
		Если ТипЗнч(ДокОснование) = Тип("ДокументСсылка.ИнвентаризацияКассы") Тогда
			СтандартнаяОбработка = Ложь;
			Документы.ИнвентаризацияКассы.ВводНаОсновании_ЗаполнитьДокумент(ЭтотОбъект, ДанныеЗаполнения);
		ИначеЕсли ЭтоСписаниеМЗ(ДокОснование) Тогда
			ЗаполнитьПоСписаниюМЗ(ДокОснование, СтандартнаяОбработка);
			ЗаполнитьТабличнуюЧастьПриВводеНаОсновании(ДанныеЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьТабличнуюЧастьПриВводеНаОсновании(ДанныеЗаполнения = Неопределено)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЦМООснования = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "ЦМО", Справочники.ЦМО.ПустаяСсылка());
		ПодразделениеОснования = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "Подразделение", Справочники.Подразделения.ПустаяСсылка());
		КФООснования = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "КФО", Перечисления.КВД.ПустаяСсылка());
	Иначе
		ДанныеКФОЦМО = ПолучитьЕдинственныйЦМОКФО(ДокументОснование);
		ЦМООснования = ДанныеКФОЦМО.ЦМО;
		ПодразделениеОснования = ДанныеКФОЦМО.Подразделение;
		КФООснования = ДанныеКФОЦМО.КФО;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЦМООснования) И ЗначениеЗаполнено(КФООснования) Тогда
		ЦМО = ЦМООснования;
		Подразделение = ПодразделениеОснования;
		КФО = КФООснования;
		Для Каждого Строка Из Документы.ПоступлениеБСО.ТаблицаДокументаОснования(ДокументОснование, КФООснования, ЦМООснования, ПодразделениеОснования) Цикл
			ЗаполнитьЗначенияСвойств(СоставБСО.Добавить(), Строка);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьЕдинственныйЦМОКФО(Основание)
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПолученияКФОЦМО(Основание);
	Запрос.УстановитьПараметр("Ссылка", Основание);
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Структура;
	Результат.Вставить("ЦМО", Справочники.ЦМО.ПустаяСсылка());
	Результат.Вставить("КФО", Перечисления.КВД.ПустаяСсылка());
	Результат.Вставить("Подразделение", Справочники.Подразделения.ПустаяСсылка());
	Если Выборка.Количество() = 1 И Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ТекстЗапросаПолученияКФОЦМО(Основание)
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.АктСписанияМЗ") Тогда
		Возврат
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	АктСписанияМЗМатериалы.КФО,
		|	АктСписанияМЗМатериалы.Ссылка.ЦМООтправитель КАК ЦМО,
		|	АктСписанияМЗМатериалы.Ссылка.ПодразделениеОтправитель КАК Подразделение
		|ИЗ
		|	Документ.АктСписанияМЗ.Материалы КАК АктСписанияМЗМатериалы
		|ГДЕ
		|	АктСписанияМЗМатериалы.Ссылка = &Ссылка
		|	И АктСписанияМЗМатериалы.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.БСО)";
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ТребованиеНакладная0315006") Тогда
		Возврат
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТребованиеНакладная0315006Материалы.КФО,
		|	ТребованиеНакладная0315006Материалы.Ссылка.ЦМОПолучатель КАК ЦМО,
		|	ТребованиеНакладная0315006Материалы.Ссылка.ПодразделениеПолучатель КАК Подразделение
		|ИЗ
		|	Документ.ТребованиеНакладная0315006.Материалы КАК ТребованиеНакладная0315006Материалы
		|ГДЕ
		|	ТребованиеНакладная0315006Материалы.Ссылка = &Ссылка
		|	И ТребованиеНакладная0315006Материалы.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.БСО)";
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ВедомостьНаВыдачуМЗНаНуждыУчреждения") Тогда
		Возврат
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.ЦМОПолучатель КАК ЦМО,
		|	ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.ПодразделениеПолучатель КАК Подразделение,
		|	ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Ссылка.КФО
		|ИЗ
		|	Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения.МатериальныеЗапасы КАК
		|		ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы
		|ГДЕ
		|	ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Ссылка = &Ссылка
		|	И ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.БСО)";
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не известный тип документа (%1) в функции Документы.ПоступлениеБСО.ТекстЗапросаПолученияКФОЦМО'"), ТипЗнч(Ссылка));
	КонецЕсли;
	
КонецФункции

Функция ЭтоСписаниеМЗ(ДанныеЗаполнения)
	Возврат ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.АктСписанияМЗ")
		Или ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ТребованиеНакладная0315006")
		Или ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВедомостьНаВыдачуМЗНаНуждыУчреждения");
КонецФункции

Процедура ЗаполнитьПоСписаниюМЗ(ДанныеЗаполнения, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.АктСписанияМЗ") Тогда
		ЗаполнитьПоАктуСписанияМЗ(ДанныеЗаполнения, СтандартнаяОбработка);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ТребованиеНакладная0315006") Тогда
		ЗаполнитьНаОснованииТребованияНакладнойМЗ(ДанныеЗаполнения, СтандартнаяОбработка);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВедомостьНаВыдачуМЗНаНуждыУчреждения") Тогда
