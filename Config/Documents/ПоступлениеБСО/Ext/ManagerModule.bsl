#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеБСО";
	КомандаПечати.Идентификатор		= "ПриходныйОрдер0504207_103н";
	КомандаПечати.Представление		= НСтр("ru = 'Приходный ордер (ф.0504207) (ред. 103н)'");
	КомандаПечати.Порядок			= 1;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеБСО";
	КомандаПечати.Идентификатор		= "ПриходныйОрдер0504207_52н";
	КомандаПечати.Представление		= НСтр("ru = 'Приходный ордер (ф.0504207) (ред. 52н)'");
	КомандаПечати.Порядок			= 2;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПоступлениеБСО";
	КомандаПечати.Идентификатор		= "ПриходныйОрдерМ4";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Приходный ордер (М-4)'");
	КомандаПечати.Порядок			= 99;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПриходныйОрдерМ4") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ПриходныйОрдерМ4","Приходный ордер (М-4)",ПечатьМ4(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_103н",
			"Приходный ордер (ф.0504207) ред. 103н",
			Печать0504207(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПриходныйОрдер0504207_103н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_52н",
			"Приходный ордер (ф.0504207) ред. 52н",
			Печать0504207(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПриходныйОрдер0504207"));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры
//  Ссылка  - ДокументСсылка.РасходныйОрдерФондовый - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	СчетУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "СчетУчета");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчета).УчетПоПодразделениям;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ПоступлениеБСОСоставБСО.Ссылка.Организация КАК Организация,
	|	ПоступлениеБСОСоставБСО.Ссылка.ИФО КАК ИФО,
	|	ПоступлениеБСОСоставБСО.Ссылка.КФО КАК КФО,
	|	ПоступлениеБСОСоставБСО.Ссылка.ЦМО КАК ЦМО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА ПоступлениеБСОСоставБСО.Ссылка.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ПоступлениеБСОСоставБСО.БСО,
	|	ПоступлениеБСОСоставБСО.СерияБСО,
	|	ПоступлениеБСОСоставБСО.НомерНачальный,
	|	ПоступлениеБСОСоставБСО.НомерКонечный,
	|	ПоступлениеБСОСоставБСО.Количество,
	|	ПоступлениеБСОСоставБСО.Ссылка.Дата КАК Период,
	|	ПоступлениеБСОСоставБСО.Ссылка.СчетУчета КАК СчетУчета
	|ИЗ
	|	Документ.ПоступлениеБСО.СоставБСО КАК ПоступлениеБСОСоставБСО
	|ГДЕ
	|	ПоступлениеБСОСоставБСО.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПоступлениеБСОСоставБСО.НомерСтроки";	
	
	Запрос.УстановитьПараметр("Ссылка", 							ДокументСсылка);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	
	ДвиженияБСО = Запрос.Выполнить().Выгрузить();
	ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументСсылка);
	Если ЗначениеЗаполнено(ДатаПроведения) Тогда
		ДвиженияБСО.ЗаполнитьЗначения(ДатаПроведения, "Период");
	КонецЕсли;
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("ДвиженияБСО",  ДвиженияБСО);
		
КонецПроцедуры // ИнициализироватьДанныеДокумента()

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Формирует таблицу разделителей документов для целей формирования текущего документа по данным инвентаризационной описи.
//
// Параметры:
//  ДокОснование - ДокументСсылка.ИнвентаризационнаяОписьНФА - документ, по данным которого заполняется текущий документ
//  СсылкаЦелевогоДокумента - ДокументСсылка.АктСписанияМЗ -
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица разделителей с полями:
//   * ЦМООтправитель - СправочникСсылка.ЦМО
//   * ПодразделениеОтправитель - СправочникСсылка.Подразделения
Функция ТаблицаРазделителейДокументов(ДокОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьБСО.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокОснование, СсылкаЦелевогоДокумента);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеИнвентаризации.ИФО КАК ИФО,
	|	СправочникЦМО.Ссылка КАК ЦМО,
	|	ДанныеИнвентаризации.КФО КАК КФО,
	|	ДанныеИнвентаризации.СчетУчета КАК СчетУчета
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ДанныеИнвентаризации.МОЛШапки = СправочникЦМО.Сотрудник
	|			И ДанныеИнвентаризации.МестоИнвентаризации = СправочникЦМО.МестоХранения
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 11
	|	И ДанныеИнвентаризации.МестоИнвентаризации ССЫЛКА Справочник.МестаХранения
	|	И ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ДанныеИнвентаризации.ИФО КАК ИФО,
	|	СправочникЦМО.Ссылка КАК ЦМО,
	|	ДанныеИнвентаризации.КФО КАК КФО,
	|	ДанныеИнвентаризации.СчетУчета КАК СчетУчета
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ДанныеИнвентаризации.МОЛШапки = СправочникЦМО.Сотрудник
	|			И (СправочникЦМО.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка))
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 11
	|	И ТИПЗНАЧЕНИЯ(ДанныеИнвентаризации.МестоИнвентаризации) = ТИП(СТРОКА)
	|	И ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0";
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = УправлениеНФА.УдалитьПолеИзТекстЗапроса(Запрос.Текст, "ИФО");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	Возврат
	"ВЫБРАТЬ
	|	ПоступлениеБСО.Ссылка КАК Ссылка,
	|	ПоступлениеБСО.ДокументОснование КАК ДокументИнвентаризации,
	|	СоставДокумента.БСО КАК НФА,
	|	СоставДокумента.СерияБСО КАК СерияБСО,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Излишки) КАК ВидОтклонения,
	|	ПоступлениеБСО.ЦМО.МестоХранения КАК МестоИнвентаризации,
	|	СоставДокумента.Количество КАК Количество,
	|	СоставДокумента.НомерНачальный КАК НомерНачальный,
	|	СоставДокумента.НомерКонечный КАК НомерКонечный
	|ПОМЕСТИТЬ НФАУчетныхДокументов1
	|ИЗ
	|	Документ.ПоступлениеБСО КАК ПоступлениеБСО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеБСО.СоставБСО КАК СоставДокумента
	|		ПО (ПоступлениеБСО.Ссылка = СоставДокумента.Ссылка)
	|ГДЕ
	|	ПоступлениеБСО.ДокументОснование В(&ДокументыИнвентаризации)
	|	И НЕ ПоступлениеБСО.ПометкаУдаления
	|	И ПоступлениеБСО.Ссылка <> &ПоступлениеБСОСсылка";
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция формирует табличный документ Приходный ордер (ф.0504207)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция Печать0504207(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	Запрос = Новый Запрос;	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Документ.ПоступлениеБСО) КАК Ссылка,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт) КАК СчетДт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт) КАК КПСДт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт) КАК КПСКт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт) КАК СчетКт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт) КАК КЭКДт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт) КАК КЭККт,
	|	МАКСИМУМ(ЖурналПроводокЕПСБУДвиженияССубконто.КФО) КАК КФО,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.БСО)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.БСО)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.БСО)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	КОНЕЦ КАК БСОСсылка
	|ПОМЕСТИТЬ СчетаДтКт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В (&МассивОбъектов)
	|				И (ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО)
	|					ИЛИ ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО)
	|					ИЛИ ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.БСО))
	|				И СчетДт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский),
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|
	|СГРУППИРОВАТЬ ПО
