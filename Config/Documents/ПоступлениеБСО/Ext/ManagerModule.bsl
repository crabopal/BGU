// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьМ4(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫПЕЧАТИ_ПРИХОДНЫЙОРДЕР_М4";
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ПриходныйОрдерМ4");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьИтогПодвал = Новый ТабличныйДокумент;
	ОбластьИтогПодвал.Вывести(ОбластьИтог);
	ОбластьИтогПодвал.Вывести(ОбластьПодвал);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПоступлениеБСО.Организация,
	               |	ПоступлениеБСО.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	               |	ПоступлениеБСО.Организация.КодОКПО КАК КодОКПО,
	               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеБСО.Подразделение) КАК МестоХранения,
	               |	ПоступлениеБСО.Дата КАК Дата,
	               |	ПоступлениеБСО.Номер,
	               |	ВЫБОР
	               |		КОГДА ПоступлениеБСО.Контрагент.ЮридическоеФизическоеЛицо ССЫЛКА Справочник.ЮридическиеЛица
	               |			ТОГДА ВЫБОР
	               |					КОГДА ПОДСТРОКА(ПоступлениеБСО.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное, 1, 100) = """"
	               |						ТОГДА ПоступлениеБСО.Контрагент.ЮридическоеФизическоеЛицо.Наименование
	               |					ИНАЧЕ ПоступлениеБСО.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	               |				КОНЕЦ
	               |		КОГДА ПоступлениеБСО.Контрагент.ЮридическоеФизическоеЛицо ССЫЛКА Справочник.ФизическиеЛица
	               |			ТОГДА ПоступлениеБСО.Контрагент.ЮридическоеФизическоеЛицо.Наименование
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК Поставщик,
	               |	ЕСТЬNULL(ПоступлениеБСО.Контрагент.Код, """") КАК КодПоставщика,
	               |	ПоступлениеБСО.Контрагент,
	               |	ПоступлениеБСОСоставБСО.БСО.Наименование КАК Номенклатура,
	               |	ВЫБОР
	               |		КОГДА ПоступлениеБСОСоставБСО.НомерНачальный = """"
	               |			ТОГДА ПоступлениеБСОСоставБСО.НомерКонечный
	               |		КОГДА ПоступлениеБСОСоставБСО.НомерКонечный = """"
	               |			ТОГДА ПоступлениеБСОСоставБСО.НомерНачальный
	               |		ИНАЧЕ ПоступлениеБСОСоставБСО.НомерНачальный + ""-"" + ПоступлениеБСОСоставБСО.НомерКонечный
	               |	КОНЕЦ КАК НоменклатурныйНомер,
	               |	ПоступлениеБСОСоставБСО.БСО.ЕдиницаИзмерения.Код КАК КодЕдИзм,
	               |	ПоступлениеБСОСоставБСО.БСО.ЕдиницаИзмерения.Наименование КАК ЕдИзм,
	               |	ПоступлениеБСОСоставБСО.Количество,
	               |	1 КАК Цена,
	               |	ПоступлениеБСОСоставБСО.Количество КАК Сумма,
	               |	0 КАК НДС,
	               |	ПоступлениеБСОСоставБСО.Количество КАК Всего,
	               |	ПоступлениеБСОСоставБСО.НомерСтроки КАК НомерСтроки,
	               |	ПоступлениеБСО.ЦМО.Сотрудник КАК МОЛ,
	               |	ПоступлениеБСО.Ссылка КАК Ссылка,
	               |	ПоступлениеБСО.ВидПервичногоДокумента,
	               |	ПоступлениеБСО.ДатаПервичногоДокумента,
	               |	ПоступлениеБСО.НомерПервичногоДокумента
	               |ИЗ
	               |	Документ.ПоступлениеБСО КАК ПоступлениеБСО
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеБСО.СоставБСО КАК ПоступлениеБСОСоставБСО
	               |		ПО ПоступлениеБСО.Ссылка = ПоступлениеБСОСоставБСО.Ссылка
	               |ГДЕ
	               |	ПоступлениеБСО.Ссылка В(&МассивОбъектов)
	               |	И ПоступлениеБСОСоставБСО.Ссылка В(&МассивОбъектов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата,
	               |	ПоступлениеБСОСоставБСО.НомерСтроки
	               |ИТОГИ
	               |	МАКСИМУМ(НомерСтроки)
	               |ПО
	               |	Ссылка";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
		НомерСопроводительногоДокумента = "";
		Если ЗначениеЗаполнено(ВыборкаШапка.ВидПервичногоДокумента) ИЛИ ЗначениеЗаполнено(ВыборкаШапка.НомерПервичногоДокумента) ИЛИ ЗначениеЗаполнено(ВыборкаШапка.ДатаПервичногоДокумента) Тогда
			НомерСопроводительногоДокумента = "" + ВыборкаШапка.ВидПервичногоДокумента + " от " + Формат(ВыборкаШапка.ДатаПервичногоДокумента, "ДЛФ=Д") + " № " + ВыборкаШапка.НомерПервичногоДокумента;
		КонецЕсли;
		СтруктураНомерДокумента = Новый Структура(	"Номер, НомерСопроводительногоДокумента",
													ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка,ВыборкаШапка.Номер),
													НомерСопроводительногоДокумента);
		ОбластьШапка.Параметры.Заполнить(СтруктураНомерДокумента);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		КоличествоИтог=0;
		Выборка = ВыборкаШапка.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ОбластьСтрока.Параметры.Заполнить(Выборка);
			Если Выборка.НомерСтроки = ВыборкаШапка.НомерСтроки Тогда
				ОбластиВывода = Новый Массив;
				ОбластиВывода.Добавить(ОбластьИтогПодвал);
				ОбластиВывода.Добавить(ОбластьСтрока);
				Если Не ТабличныйДокумент.ПроверитьВывод(ОбластиВывода) Тогда
					ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					ТабличныйДокумент.Вывести(ОбластьЗаголовок);
				КонецЕсли;
			ИначеЕсли Не ТабличныйДокумент.ПроверитьВывод(ОбластьСтрока) Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент.Вывести(ОбластьЗаголовок);
			КонецЕсли;
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			КоличествоИтог = КоличествоИтог + Выборка.Количество;
		КонецЦикла;
		
		СтруктураПараметров = Новый Структура("КоличествоИтог,СуммаИтог,НДСИтог,ВсегоИтог", КоличествоИтог, КоличествоИтог, 0, КоличествоИтог);
		ОбластьИтог.Параметры.Заполнить(СтруктураПараметров);
		ТабличныйДокумент.Вывести(ОбластьИтог);
		
		ТребуемыеДанные = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
											ВыборкаШапка.МОЛ,
											ВыборкаШапка.Дата);
											
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ТребуемыеДанные, Истина);
		
		СтруктураПараметров = Новый Структура("ДолжностьМОЛ, ФИОМОЛ", ТребуемыеДанные.Должность, КорреспондентыКлиентСервер.ФИО(ТребуемыеДанные, Истина));
		ОбластьПодвал.Параметры.Заполнить(СтруктураПараметров);
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
													   НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
КонецФункции

// Таблица документа основания.
// 
// Параметры:
//  Ссылка - ДокументСсылка
//  КФО - ПеречислениеСсылка.КВД
//  ЦМО - СправочникСсылка.ЦМО
// 
// Возвращаемое значение:
//  см. ПустаяТаблицаДокументаОснования 
Функция ТаблицаДокументаОснования(Ссылка, КФО, ЦМО, Подразделение) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаТаблицыДокументаОснования(Ссылка);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("КФО", КФО);
	Запрос.УстановитьПараметр("ЦМО", ЦМО);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Таблица = ПустаяТаблицаДокументаОснования();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Выборка);
	КонецЦикла;
		
	Возврат Таблица;
	
КонецФункции

// Пустая таблица документа основания.
// 
// Возвращаемое значение:
//  ТаблицаЗначений -  Пустая таблица документа основания:
// * БСО - СправочникСсылка.БСО - 
// * Количество - Число - 
Функция ПустаяТаблицаДокументаОснования()
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("БСО", Новый ОписаниеТипов("СправочникСсылка.БСО"));
	Результат.Колонки.Добавить("СерияБСО", Новый ОписаниеТипов("СправочникСсылка.СерииБСО"));
	Результат.Колонки.Добавить("НомерНачальный", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("НомерКонечный", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Возврат Результат;
КонецФункции

Функция ТекстЗапросаТаблицыДокументаОснования(Ссылка)
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.АктСписанияМЗ") Тогда
		Возврат
		"ВЫБРАТЬ
		|	АктСписанияМЗМатериалы.Номенклатура.БСО КАК БСО,
		|	АктСписанияМЗМатериалы.Количество КАК Количество,
		|	АктСписанияМЗМатериалы.СерияБСО КАК СерияБСО,
		|	АктСписанияМЗМатериалы.НачальныйНомерБСО КАК НомерНачальный,
		|	АктСписанияМЗМатериалы.КонечныйНомерБСО КАК НомерКонечный
		|ИЗ
		|	Документ.АктСписанияМЗ.Материалы КАК АктСписанияМЗМатериалы
		|ГДЕ
		|	АктСписанияМЗМатериалы.Ссылка = &Ссылка
		|	И АктСписанияМЗМатериалы.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.БСО)
		|	И ВЫБОР
		|			КОГДА АктСписанияМЗМатериалы.Ссылка.КФОВТабличнойЧасти
		|				ТОГДА АктСписанияМЗМатериалы.КФО = &КФО
		|			ИНАЧЕ АктСписанияМЗМатериалы.Ссылка.КФО = &КФО
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	АктСписанияМЗМатериалы.НомерСтроки";
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ТребованиеНакладная0315006") Тогда
		Возврат
		"ВЫБРАТЬ
		|	ТребованиеНакладная0315006Материалы.Номенклатура.БСО КАК БСО,
		|	ТребованиеНакладная0315006Материалы.Количество,
		|	ТребованиеНакладная0315006Материалы.СерияБСО КАК СерияБСО,
		|	ТребованиеНакладная0315006Материалы.НачальныйНомерБСО КАК НомерНачальный,
		|	ТребованиеНакладная0315006Материалы.КонечныйНомерБСО КАК НомерКонечный
		|ИЗ
		|	Документ.ТребованиеНакладная0315006.Материалы КАК ТребованиеНакладная0315006Материалы
		|ГДЕ
		|	ТребованиеНакладная0315006Материалы.Ссылка = &Ссылка
		|	И ТребованиеНакладная0315006Материалы.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.БСО)
		|	И ТребованиеНакладная0315006Материалы.КФО = &КФО
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТребованиеНакладная0315006Материалы.НомерСтроки";
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ВедомостьНаВыдачуМЗНаНуждыУчреждения") Тогда
		Возврат
		"ВЫБРАТЬ
		|	ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Номенклатура.БСО КАК БСО,
		|	ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Количество
		|ИЗ
		|	Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения.МатериальныеЗапасы КАК
		|		ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы
		|ГДЕ
		|	ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Ссылка = &Ссылка
		|	И ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.БСО)
		|	И ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.ЦМОПолучатель = &ЦМО
		|	И ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.ПодразделениеПолучатель = &Подразделение
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.НомерСтроки";
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не известный тип документа (%1) в функции Документы.ПоступлениеБСО.ТекстЗапросаТаблицыДокументаОснования'"), ТипЗнч(Ссылка));
	КонецЕсли;
КонецФункции

// Заполнить по инвентаризации 0510465.
// 
// Параметры:
//  ДокументИнвентаризации - ДокументСсылка.ИнвентаризационнаяОписьБСО - Документы инвентаризации
//  ЗаполняемыйДокумент - ДокументОбъект.ПоступлениеБСО, ДанныеФормыСтруктура - Заполняемый документ
Процедура ЗаполнитьПоИнвентаризации0510465(ДокументИнвентаризации, ЗаполняемыйДокумент) Экспорт 
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьБСО.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокументИнвентаризации);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НФАУчетныхДокументов.ДокументИнвентаризации,
	|	НФАУчетныхДокументов.НФА КАК БСО,
	|	НФАУчетныхДокументов.СерияБСО КАК СерияБСО,
	|	НФАУчетныхДокументов.МестоИнвентаризации КАК МестоИнвентаризации,
	|	НФАУчетныхДокументов.Количество КАК Количество,
	|	НФАУчетныхДокументов.НомерНачальный КАК НомерНачальный,
	|	НФАУчетныхДокументов.НомерКонечный КАК НомерКонечный
	|ИЗ
	|	НФАУчетныхДокументов1 КАК НФАУчетныхДокументов
	|ГДЕ
	|	НФАУчетныхДокументов.Ссылка ССЫЛКА Документ.ПоступлениеБСО
	|;
	|
	|ВЫБРАТЬ
	|	ДанныеДокументаИнвентаризации.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	ДанныеДокументаИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	ДанныеДокументаИнвентаризации.БСО КАК БСО,
	|	ДанныеДокументаИнвентаризации.Серия КАК СерияБСО,
	|	ДанныеДокументаИнвентаризации.НачальныйНомерИзлишкиНеПодтверждено КАК НомерНачальный,
	|	ДанныеДокументаИнвентаризации.КонечныйНомерИзлишкиНеПодтверждено КАК НомерКонечный,
	|	ДанныеДокументаИнвентаризации.КоличествоИзлишкиНеПодтверждено КАК Количество
	|ИЗ
	|	ДанныеДокументаИнвентаризации2 КАК ДанныеДокументаИнвентаризации
	|ГДЕ
	|	ДанныеДокументаИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0
	|	И ДанныеДокументаИнвентаризации.БСО <> ЗНАЧЕНИЕ(Справочник.БСО.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	РанееУчтенныеБСО = РезультатЗапроса[РезультатЗапроса.ВГраница() - 1].Выгрузить();
	НеУчтенныеБСО = РезультатЗапроса[РезультатЗапроса.ВГраница()].Выгрузить();
	
	НеУчтенныеБСО = УправлениеМатериальнымиЗапасами.ВычестьРанееУчтенныеБСОИзТаблицы(НеУчтенныеБСО, РанееУчтенныеБСО);
	
	Для Каждого СтрокаБСО Из НеУчтенныеБСО Цикл
		ЗаполнитьЗначенияСвойств(ЗаполняемыйДокумент.СоставБСО.Добавить(), СтрокаБСО);
	КонецЦикла;
	УправлениеМатериальнымиЗапасами.УстановитьФорматированныйНомерБСО(ЗаполняемыйДокумент.СоставБСО);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
