#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьСостояниеТабличногоДокумента(Истина);
	
	ПолучитьРасшифровкуКлиент();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РассчитатьСумму(Команда)
	
	РассчитатьПоказателиДинамически();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьСостояниеТабличногоДокумента(ЗначениеВидимости)
	
	Элемент = Элементы["ТабДокумент"];
	
	Элемент.ОтображениеСостояния.Картинка = БиблиотекаКартинок.ДлительнаяОперация48;
	Элемент.ОтображениеСостояния.Текст = НСтр("ru='Пожалуйста, подождите...'");
	
	Элемент.ОтображениеСостояния.Видимость = ЗначениеВидимости;
	
КонецПроцедуры


&НаКлиенте
Процедура ПолучитьРасшифровкуКлиент()
	
	РезультатЗадания = ПолучитьРасшифровкуСервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеПолученияРасшифровкиКлиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьРасшифровкуСервер()
	
	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru='Расшифровка сумм реализации'");
	
	ПараметрыПроцедуры = Новый Структура();
	ПараметрыПроцедуры.Вставить("ШапкаДокумента", Параметры.ШапкаДокумента);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.РаспределениеВходящегоНДС.ПолучитьРасшифровку",
		ПараметрыПроцедуры, ПараметрыЗадания);
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеПолученияРасшифровкиКлиент(Результат, ДополнительныеПараметры) Экспорт
	
	УстановитьСостояниеТабличногоДокумента(Ложь);
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		ЗавершениеПолученияРасшифровкиСервер(Результат.АдресРезультата);
		
	Иначе
		
		ПоказатьПредупреждение(, НСтр("ru='При поиске сумм реализации возникла ошибка'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеПолученияРасшифровкиСервер(АдресРезультата)
	
	Перем Расшифровка;
	
	РезультатыЗаполнения = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Если НЕ РезультатыЗаполнения.Свойство("Расшифровка", Расшифровка) Тогда
		Возврат;
	КонецЕсли;
	
	Документы.РаспределениеВходящегоНДС.ЗаполнитьТабличныйДокументРасшифровки(ТабДокумент, Расшифровка);
	
КонецПроцедуры

&НаКлиенте
Процедура ТабДокументПриАктивизацииОбласти(Элемент)
	
	ПодключитьОбработчикОжидания("РассчитатьПоказателиДинамически", 0.2, Истина);
	
КонецПроцедуры


&НаКлиенте
Процедура РассчитатьПоказателиДинамически()
	
	ПараметрыРасчета = ПараметрыРасчетаПоказателейЯчеек(ТабДокумент);
	
	Если ПараметрыРасчета.РассчитатьНаСервере Тогда 
		РасчетныеПоказатели = СтандартныеПодсистемыВызовСервера.РасчетныеПоказателиЯчеек(
			ТабДокумент, ПараметрыРасчета.ВыделенныеОбласти);
	Иначе
		РасчетныеПоказатели = ОбщегоНазначенияСлужебныйКлиентСервер.РасчетныеПоказателиЯчеек(
			ТабДокумент, ПараметрыРасчета.ВыделенныеОбласти);
	КонецЕсли;
	
	Сумма = РасчетныеПоказатели.Сумма;
	
КонецПроцедуры

// Копия ОбщегоНазначенияСлужебныйКлиент.ПараметрыРасчетаПоказателейЯчеек
&НаКлиенте
Функция ПараметрыРасчетаПоказателейЯчеек(ТабличныйДокумент) 
	
	ПараметрыРасчетаПоказателей = Новый Структура;
	ПараметрыРасчетаПоказателей.Вставить("ВыделенныеОбласти", Новый Массив);
	ПараметрыРасчетаПоказателей.Вставить("РассчитатьНаСервере", Ложь);
	
	ВыделенныеОбласти = ПараметрыРасчетаПоказателей.ВыделенныеОбласти;
	Для Каждого ВыделеннаяОбласть Из ТабличныйДокумент.ВыделенныеОбласти Цикл
		
		Если ТипЗнч(ВыделеннаяОбласть) <> Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Продолжить;
		КонецЕсли;
		
		ГраницыОбласти = Новый Структура("Верх, Низ, Лево, Право, ТипОбласти");
		ЗаполнитьЗначенияСвойств(ГраницыОбласти, ВыделеннаяОбласть);
		ВыделенныеОбласти.Добавить(ГраницыОбласти);
		
	КонецЦикла;
	
	ВыделеноВсе = Ложь;
	
	Если ВыделенныеОбласти.Количество() = 1 Тогда 
		
		ВыделеннаяОбласть = ВыделенныеОбласти[0];
		ВыделеноВсе = Не Булево(
			ВыделеннаяОбласть.Верх
			+ ВыделеннаяОбласть.Низ
			+ ВыделеннаяОбласть.Лево
			+ ВыделеннаяОбласть.Право);
		
	КонецЕсли;
	
	ПараметрыРасчетаПоказателей.РассчитатьНаСервере = (ВыделеноВсе Или ВыделенныеОбласти.Количество() >= 100);
	
	Возврат ПараметрыРасчетаПоказателей;
	
КонецФункции

#КонецОбласти