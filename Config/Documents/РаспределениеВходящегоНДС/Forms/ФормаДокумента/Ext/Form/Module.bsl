//---
// Заполнение документа

&НаКлиенте
Процедура ПроверитьИЗаполнитьДокумент()
	
	ЕстьЗаполненнаяТаблица	= (Объект["СоставРаспределяемыхСумм"].Количество() > 0);
	
	ЕстьЗаполненныеСуммы	= НЕ (Объект["СуммаРеализацииВсего"] = 0
		И Объект["СуммаРеализацииНДС"] = 0
		И Объект["СуммаРеализацииОблагаемаяБезНДС"] = 0);	
	
	Если ЕстьЗаполненнаяТаблица ИЛИ ЕстьЗаполненныеСуммы Тогда
		ТекстСообщения = НСтр("ru='Перед заполнением по данным учета документ будет очищен.
			|
			|Продолжить и заполнить по данным учета?'");
			
		ОписаниеОповещенияОВыборе = Новый ОписаниеОповещения("ПроверитьИЗаполнитьДокумент_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОВыборе, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьДокументКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьДокумент_Выбор(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ЗаполнитьДокументКлиент();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокументКлиент()
	
	ИмяКоманды = "ЗаполнитьДокумент";
	
	ЗаполнитьПоДаннымБухУчетаКлиент(ИмяКоманды);
	
	РаспределитьПоПропорцииКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьСуммыРеализации()
	
	ЕстьЗаполненныеСуммы = НЕ (Объект["СуммаРеализацииВсего"] = 0
		И Объект["СуммаРеализацииНДС"] = 0
		И Объект["СуммаРеализацииОблагаемаяБезНДС"] = 0);
		
	Если ЕстьЗаполненныеСуммы Тогда
		ТекстСообщения = НСтр("ru='Суммы реализации будут перезаполнены по данным бухгалтерского учета.
			|
			|Продолжить?'");
			
		ОписаниеОповещенияОВыборе = Новый ОписаниеОповещения("ПроверитьИЗаполнитьСуммыРеализации_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОВыборе, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьСуммыРеализацииКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьСуммыРеализации_Выбор(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ЗаполнитьСуммыРеализацииКлиент();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСуммыРеализацииКлиент()
	
	ИмяКоманды = "ЗаполнитьСуммыРеализации";
	
	ЗаполнитьПоДаннымБухУчетаКлиент(ИмяКоманды);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьСуммыКРаспределению(ИмяКоманды)
	
	ЕстьЗаполненнаяТаблица	= (Объект["СоставРаспределяемыхСумм"].Количество() > 0);
	
	Если ЕстьЗаполненнаяТаблица Тогда
		ТекстСообщения = НСтр("ru='Перед заполнением по данным учета будет очищена
			|табличная часть ""Суммы к распределению"".
			|
			|Продолжить и заполнить по данным учета?'");
			
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКоманды);
		
		ОписаниеОповещенияОВыборе = Новый ОписаниеОповещения("ПроверитьИЗаполнитьСуммыКРаспределению_Выбор", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВопрос(ОписаниеОповещенияОВыборе, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьСуммыКРаспределениюКлиент(ИмяКоманды);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьСуммыКРаспределению_Выбор(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ЗаполнитьСуммыКРаспределениюКлиент(ПараметрыОповещения["ИмяКоманды"]);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСуммыКРаспределениюКлиент(ИмяКоманды)
	
	ЗаполнитьПоДаннымБухУчетаКлиент(ИмяКоманды);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИРаспределитьПоПропорции()
	
	ЕстьЗаполненнаяТаблица	= (Объект["СоставРаспределяемыхСумм"].Количество() > 0);
	
	Если ЕстьЗаполненнаяТаблица Тогда
		ТекстСообщения = НСтр("ru='В табличной части ""Суммы к распределению"" будут пересчитаны суммы НДС.
			|
			|Продолжить?'");
			
		ОписаниеОповещенияОВыборе = Новый ОписаниеОповещения("ПроверитьИРаспределитьПоПропорции_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОВыборе, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		РаспределитьПоПропорцииКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИРаспределитьПоПропорции_Выбор(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		РаспределитьПоПропорцииКлиент();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьПоПропорцииКлиент()
	
	ТаблЧасть = Объект["СоставРаспределяемыхСумм"];
	Для Каждого СтрокаТЧ Из ТаблЧасть Цикл
		СтрокаТЧ["СуммаНДСКВычету"] 	= СтрокаТЧ["СуммаНДСВсего"] * ДоляПринимаемаяКВычету;
		СтрокаТЧ["СуммаНДСВСтоимость"] 	= СтрокаТЧ["СуммаНДСВсего"] - СтрокаТЧ["СуммаНДСКВычету"];
		
		СтрокаТЧ["СуммаНДСКВычетуВалютная"] 	= СтрокаТЧ["СуммаНДСВсегоВалютная"] * ДоляПринимаемаяКВычету;
		СтрокаТЧ["СуммаНДСВСтоимостьВалютная"] 	= СтрокаТЧ["СуммаНДСВсегоВалютная"] - СтрокаТЧ["СуммаНДСКВычетуВалютная"];
		
		ОбновитьЗначенияОтметитьСтроку(СтрокаТЧ);
	КонецЦикла;
	
КонецПроцедуры	


// Заполнение аналитики затрат по КФО и КПС

&НаКлиенте
Процедура ОткрытьФормуЗаполненияСчетаДтКлиент()
	
	ПараметрыФормы = ПолучитьПараметрыОткрытияФормыЗаполненияСчетаДебетаСервер();
	
	ОписаниеОповещенияОВыборе = Новый ОписаниеОповещения("ОткрытьФормуЗаполненияСчетаДтКлиент_Выбор", ЭтотОбъект);
	
	ОткрытьФорму("Документ.РаспределениеВходящегоНДС.Форма.ФормаЗаполненияСчетаДт", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияОВыборе, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗаполненияСчетаДтКлиент_Выбор(Результат, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		ЗаполнитьСчетаДебетаСервер(Результат["СчетаДебета"]);
		
		Объект["ВидЗатрат"] = Результат["ВидЗатрат"];
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыОткрытияФормыЗаполненияСчетаДебетаСервер()
	
	ЗапросТаблица = Новый Запрос();
	ЗапросТаблица.УстановитьПараметр("ТЗСоставРаспределяемыхСумм", Объект["СоставРаспределяемыхСумм"].Выгрузить());
	ЗапросТаблица.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходная табличная часть СоставРаспределяемыхСумм
	|//
	|ВЫБРАТЬ
	|	ТЧ.НомерСтроки			КАК НомерСтроки,
	|	ТЧ.СчетДт				КАК СчетДт,
	|	ТЧ.КЭКСчетаДебета		КАК КЭКСчетаДебета,
	|	ТЧ.СубконтоДт1			КАК СубконтоДт1,
	|	ТЧ.СубконтоДт2			КАК СубконтоДт2,
	|	ТЧ.СубконтоДт3			КАК СубконтоДт3,
	|	// Поле свертки
	|	ТЧ.КФО					КАК КФО,
	|	ТЧ.КПССчетаДебета		КАК КПССчетаДебета
	|ПОМЕСТИТЬ
	|	ТаблЧастьСоставРаспределяемыхСумм
	|ИЗ
	|	&ТЗСоставРаспределяемыхСумм	КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Количество различных значений каждого поля
	|//
	|ВЫБРАТЬ
	|	МИНИМУМ(НомерСтроки)					КАК НомерПервойСтроки,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СчетДт)			КАК КолвоРазличныхСчетДт,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КЭКСчетаДебета)	КАК КолвоРазличныхКЭКСчетаДебета,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СубконтоДт1)		КАК КолвоРазличныхСубконтоДт1,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СубконтоДт2)		КАК КолвоРазличныхСубконтоДт2,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СубконтоДт3)		КАК КолвоРазличныхСубконтоДт3,
	|	МИНИМУМ(СчетДт)							КАК СчетДт,
	|	МИНИМУМ(КЭКСчетаДебета)					КАК КЭКСчетаДебета,
	|	МИНИМУМ(СубконтоДт1)					КАК СубконтоДт1,
	|	МИНИМУМ(СубконтоДт2)					КАК СубконтоДт2,
	|	МИНИМУМ(СубконтоДт3)					КАК СубконтоДт3,
	|	// Поле свертки
	|	КФО										КАК КФО,
	|	КПССчетаДебета							КАК КПССчетаДебета
	|ПОМЕСТИТЬ
	|	КоличествоСтрокСРазличнымиПолями
	|ИЗ
	|	ТаблЧастьСоставРаспределяемыхСумм
	|СГРУППИРОВАТЬ ПО
	|	// Поле свертки     
	|	КФО,
	|	КПССчетаДебета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Таблица счетов дебета с установленными значениями полей
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА КолвоРазличныхСчетДт = 1 ТОГДА
	|			СчетДт
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ									КАК СчетДт,
	|	ВЫБОР
	|		КОГДА КолвоРазличныхКЭКСчетаДебета = 1 ТОГДА
	|			КЭКСчетаДебета
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ									КАК КЭКСчетаДебета,
	|	ВЫБОР
	|		КОГДА КолвоРазличныхСубконтоДт1 = 1 ТОГДА
	|			СубконтоДт1
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ									КАК СубконтоДт1,
	|	ВЫБОР
	|		КОГДА КолвоРазличныхСубконтоДт2 = 1 ТОГДА
	|			СубконтоДт2
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ									КАК СубконтоДт2,
	|	ВЫБОР
	|		КОГДА КолвоРазличныхСубконтоДт3 = 1 ТОГДА
	|			СубконтоДт3
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ									КАК СубконтоДт3,
	|	// Поле свертки     
	|	КФО										КАК КФО,
	|	КПССчетаДебета							КАК КПССчетаДебета
	|ИЗ
	|	КоличествоСтрокСРазличнымиПолями
	|УПОРЯДОЧИТЬ ПО
	|	НомерПервойСтроки
	|;";
	
	ТЗСчетаДебета = ЗапросТаблица.Выполнить().Выгрузить();
	
	Данные = Новый Структура("
		|Дата,
		|Организация,
		|ИФО,
		|ВидЗатрат");
	ЗаполнитьЗначенияСвойств(Данные, Объект);
	
	Данные.Вставить("СчетаДебета", ТЗСчетаДебета);
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Данные);
	
	Результат = Новый Структура();
	Результат.Вставить("АдресХранилища",			АдресХранилища);
	Результат.Вставить("РежимЗаполненияПоКФОиКПС",	Истина);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСчетаДебетаСервер(ИсточникДанных)
	
	ПоляПоиска = "КФО,КПССчетаДебета";
	
	ЗаполняемыеПоля = "СчетДт,КЭКСчетаДебета,СубконтоДт1,СубконтоДт2,СубконтоДт3";
	
	Поиск = Новый Структура(ПоляПоиска);
	
	Для Каждого СтрокаТаблицы Из ИсточникДанных Цикл
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		
		МассивСтрок = Объект["СоставРаспределяемыхСумм"].НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаПриемник Из МассивСтрок Цикл
			ЗаполнитьЗначенияСвойств(СтрокаПриемник, СтрокаТаблицы, ЗаполняемыеПоля);
			
			УстановитьФлажокОтразитьВКарточкеКапвложений(СтрокаПриемник, СчетаКапвложений);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры


// Групповое заполнение строк

&НаКлиенте
Функция ПолучитьПараметрыФормыГрупповогоЗаполненияСтрок(КоличествоСтрок)
	
	СтруктураДанных = Новый Структура("
		|Дата,
		|Организация,
		|ИФО");
	
	ЗаполнитьЗначенияСвойств(СтруктураДанных, Объект);
	
	ТекущиеДанные = Новый Структура("
		|КФО,
		|КПССчетаДебета,
		|СчетДт,
		|КЭКСчетаДебета,
		|СубконтоДт1,
		|СубконтоДт2,
		|СубконтоДт3");
		
	ТекДанные = Элементы["СоставРаспределяемыхСумм"].ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, ТекДанные);
		
	КонецЕсли;
	
	СтруктураДанных.Вставить("ТекущиеДанные", ТекущиеДанные);
	
	Результат = Новый Структура();
	Результат.Вставить("СтруктураДанных",			СтруктураДанных);
	Результат.Вставить("РежимЗаполненияПоКФОиКПС",	Ложь);
	Результат.Вставить("КоличествоСтрок",			КоличествоСтрок);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаГрупповогоЗаполненияСтрок(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы["СоставРаспределяемыхСумм"].ВыделенныеСтроки;
	
	ТабличнаяЧасть = Объект["СоставРаспределяемыхСумм"];
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		
		СтрокаТаблицы = ТабличнаяЧасть.НайтиПоИдентификатору(ИдСтроки);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, РезультатВыбора);
		
		УстановитьФлажокОтразитьВКарточкеКапвложений(СтрокаТаблицы, СчетаКапвложений);
	КонецЦикла;
	
КонецПроцедуры


// Заполнение по данным учета

&НаКлиенте
Процедура ЗаполнитьПоДаннымБухУчетаКлиент(ИмяКоманды)
	
	РезультатЗадания = ЗаполнитьПоДаннымБухУчетаСервер(ИмяКоманды);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияПоДаннымБухУчетаКлиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПоДаннымБухУчетаСервер(ИмяКоманды)
	
	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru='Распределение входящего НДС'");
	
	ПараметрыПроцедуры = ПолучитьПараметрыПроцедурыЗаполненияПоДаннымУчета(ИмяКоманды);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.РаспределениеВходящегоНДС.ПолучитьДанныеБухУчета",
		ПараметрыПроцедуры, ПараметрыЗадания);
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияПоДаннымБухУчетаКлиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		ЗавершениеЗаполненияПоДаннымБухУчетаСервер(Результат.АдресРезультата);
		
		РаспределитьПоПропорцииКлиент();
		
	Иначе
		
		ПоказатьПредупреждение(, НСтр("ru='При распределении входящего НДС возникла ошибка'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияПоДаннымБухУчетаСервер(АдресРезультата)
	
	Перем Значение;
	
	РезультатыЗаполнения = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Если РезультатыЗаполнения.Свойство("СуммыРеализации", Значение) Тогда
		
		ЗаполнитьЗначенияСвойств(Объект, Значение);
		
		РезультатРасчета = РассчитатьДолюПринимаемуюКВычету(Значение);
		
		НастроитьФормуПослеРасчетаДолиКВычету(ЭтаФорма, РезультатРасчета);
		
	КонецЕсли;
	
	Если РезультатыЗаполнения.Свойство("СоставРаспределяемыхСумм", Значение) Тогда
		
		Объект["СоставРаспределяемыхСумм"].Загрузить(Значение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыПроцедурыЗаполненияПоДаннымУчета(ИмяКоманды)
	
	ШапкаДокумента = ПолучитьСтруктуруШапкиДокумента();
	
	ПараметрыПроцедуры = Новый Структура();
	ПараметрыПроцедуры.Вставить("ШапкаДокумента", ШапкаДокумента);
	
	Если ИмяКоманды = "ЗаполнитьДокумент" Тогда
		ПараметрыПроцедуры.Вставить("ЗаполнитьСуммыРеализации");
		ПараметрыПроцедуры.Вставить("ЗаполнитьРаспределяемыеСуммыСАналитикой");
		
	ИначеЕсли ИмяКоманды = "ЗаполнитьСуммыРеализации" Тогда
		ПараметрыПроцедуры.Вставить("ЗаполнитьСуммыРеализации");
		
	ИначеЕсли ИмяКоманды = "ЗаполнитьБезАналитики" Тогда
		ПараметрыПроцедуры.Вставить("ЗаполнитьРаспределяемыеСуммыБезАналитики");
		
	ИначеЕсли ИмяКоманды = "ЗаполнитьСАналитикой" Тогда
		ПараметрыПроцедуры.Вставить("ЗаполнитьРаспределяемыеСуммыСАналитикой");
		
	КонецЕсли;
	
	Возврат ПараметрыПроцедуры;
	
КонецФункции

