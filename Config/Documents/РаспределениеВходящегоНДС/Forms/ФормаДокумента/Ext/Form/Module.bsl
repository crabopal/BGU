	ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных("СоставРаспределяемыхСуммСуммаНДСВсегоВалютная");
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыИтогов()
	
	// ВНЕШНИЙ ВИД ИТОГОВ ТАБЛИЦ
	//
	//	----------------------------------------
	//			ИспользоватьВалютныйУчет
	//	--------------------+-------------------
	//			Истина		|		Ложь
	//	--------------------+-------------------
	//	Всего               |
	//	в рублях: _________	|	Всего: _________
	//	в валюте: _________	|
	//	----------------------------------------
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	
	//---
	// Итоги таблицы Суммы к распределению
	//---
	ИменаЭлементов = Новый Структура();
	//						Имя элемента-группы					Имя элемента-поля для рублевой суммы
	ИменаЭлементов.Вставить("ГруппаИтогиВсего",					"СоставРаспределяемыхСуммИтогВсего");
	ИменаЭлементов.Вставить("ГруппаИтогиСуммаНДС",				"СоставРаспределяемыхСуммИтогСуммаНДСВсего");
	ИменаЭлементов.Вставить("ГруппаИтогиСуммаНДСКВычету",		"СоставРаспределяемыхСуммИтогСуммаНДСКВычету");
	ИменаЭлементов.Вставить("ГруппаИтогиСуммаНДСВСтоимость",	"СоставРаспределяемыхСуммИтогСуммаНДСВСтоимость");
	
	ОтображатьЗаголовокГруппы = ИспользоватьВалютныйУчет;
	
	Для Каждого Элемент Из ИменаЭлементов Цикл
		ИмяЭлементаГруппы	= Элемент.Ключ;
		ИмяЭлементаПоля		= Элемент.Значение;
		
		УстановитьЗаголовокПоля = НЕ ИспользоватьВалютныйУчет;
		
		// Элемент группы
		Элементы[ИмяЭлементаГруппы].ОтображатьЗаголовок = ОтображатьЗаголовокГруппы;
		
		// Элемент поля
		Если УстановитьЗаголовокПоля Тогда
			Элементы[ИмяЭлементаПоля].Заголовок				= Элементы[ИмяЭлементаГруппы].Заголовок;
			Элементы[ИмяЭлементаПоля].ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Лево;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

