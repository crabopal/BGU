&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьДолюПринимаемуюКВычету(СтруктураСумм)
	
	ДоляПринимаемаяКВычету						= 0;
	ОтметитьПолеСуммаРеализацииНДС				= Ложь;
	ОтметитьПолеСуммаРеализацииОблагаемаяБезНДС	= Ложь;
	
	Числитель = СтруктураСумм["СуммаРеализацииОблагаемаяБезНДС"];
	
	Знаменатель = СтруктураСумм["СуммаРеализацииВсего"] - СтруктураСумм["СуммаРеализацииНДС"];
	
	ОперандыЗнаменателяПустые = (СтруктураСумм["СуммаРеализацииВсего"] = 0 И СтруктураСумм["СуммаРеализацииНДС"] = 0);
	
	Если Знаменатель > 0 Тогда
		
		Если Числитель <= Знаменатель Тогда
			
			ДоляПринимаемаяКВычету = Числитель / Знаменатель;
			
		Иначе
			ОтметитьПолеСуммаРеализацииОблагаемаяБезНДС = Истина;
			
		КонецЕсли;
		
	ИначеЕсли НЕ ОперандыЗнаменателяПустые Тогда
		
		ОтметитьПолеСуммаРеализацииНДС = Истина;
			
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("ДоляПринимаемаяКВычету",						ДоляПринимаемаяКВычету);
	Результат.Вставить("ОтметитьПолеСуммаРеализацииНДС",				ОтметитьПолеСуммаРеализацииНДС);
	Результат.Вставить("ОтметитьПолеСуммаРеализацииОблагаемаяБезНДС",	ОтметитьПолеСуммаРеализацииОблагаемаяБезНДС);
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьФормуПослеРасчетаДолиКВычету(Форма, РезультатРасчета)
	
	ЗаполнитьЗначенияСвойств(Форма, РезультатРасчета);
	
	ИмяПоля = "СуммаРеализацииОблагаемаяБезНДС";
	
	Элемент = Форма.Элементы[ИмяПоля];
	
	Если РезультатРасчета["ОтметитьПоле" + ИмяПоля] Тогда
		Элемент.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСправа;
	Иначе
		Элемент.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	КонецЕсли;
	
	ИмяПоля = "СуммаРеализацииНДС";
	
	Элемент = Форма.Элементы[ИмяПоля];
	
	Если РезультатРасчета["ОтметитьПоле" + ИмяПоля] Тогда
		Элемент.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСправа;
	Иначе
		Элемент.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	КонецЕсли;
	
КонецПроцедуры

