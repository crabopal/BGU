&НаКлиенте
Процедура ГрупповоеЗаполнениеСтрок(Команда)
	
	КоличествоСтрок = Элементы["СоставРаспределяемыхСумм"].ВыделенныеСтроки.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		
		ТекстСообщения = НСтр("ru='Выделите несколько строк для выполнения группового заполнения'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
		
	КонецЕсли;
	
	ПараметрыФормы = ПолучитьПараметрыФормыГрупповогоЗаполненияСтрок(КоличествоСтрок);
	
	ОповещениеВыбор = Новый ОписаниеОповещения("ЗакрытаФормаГрупповогоЗаполненияСтрок", ЭтотОбъект);
	
	ОткрытьФорму("Документ.РаспределениеВходящегоНДС.Форма.ФормаЗаполненияСчетаДт", ПараметрыФормы, ЭтаФорма,,,,ОповещениеВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

