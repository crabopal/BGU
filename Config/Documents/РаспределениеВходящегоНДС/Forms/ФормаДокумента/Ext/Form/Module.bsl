// Аналог установки свойства ТолькоПросмотр, но с возможностью открытия значения

&НаСервере
Процедура ТолькоПросмотр_ПоДаннымУчета_ИнициализацияСервер()
	
	НастройкиТаблиц = Новый Структура();
	
	НастройкиОднойТаблицы = Новый Структура();
	НастройкиОднойТаблицы.Вставить("ИмяФлажкаПоДаннымУчета", "ПоУчету");
	НастройкиОднойТаблицы.Вставить("ИменаЭлементов",
		"СоставРаспределяемыхСуммКонтрагент,
		|СоставРаспределяемыхСуммОбъектНалогообложения,
		|СоставРаспределяемыхСуммВидЦенности,
		|СоставРаспределяемыхСуммСтавкаНДС,
		|СоставРаспределяемыхСуммВалюта");
	НастройкиТаблиц.Вставить("СоставРаспределяемыхСумм", НастройкиОднойТаблицы);
	
	УчетНДС.ТолькоПросмотр_ПоДаннымУчета_Инициализация(ЭтаФорма, НастройкиТаблиц);
	
КонецПроцедуры

