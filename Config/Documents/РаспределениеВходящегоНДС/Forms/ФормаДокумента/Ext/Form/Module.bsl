&НаСервере
Процедура НастроитьФормуСервер()
	
	РезультатРасчета = РассчитатьДолюПринимаемуюКВычету(Объект);
	
	НастроитьФормуПослеРасчетаДолиКВычету(ЭтаФорма, РезультатРасчета);
	
	НастроитьЭлементыИтогов();
	
	Элементы["СоставРаспределяемыхСуммВалюта"].Видимость = ИспользоватьВалютныйУчет;
	
	Элементы.СоставРаспределяемыхСуммПодразделение.Видимость = Документы.РаспределениеВходящегоНДС.ИспользуетсяКолонкаПодразделение();
	
	//---
	// Аналог установки свойства ТолькоПросмотр, но с возможностью открытия значения
	//---
	ТолькоПросмотр_ПоДаннымУчета_ИнициализацияСервер();
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекстНадписиНалоговогоПериода(Организация, Дата)
	
	Если ЗначениеЗаполнено(Дата) Тогда
		СвойстваНалоговогоПериода = УчетНДС.ПолучитьСвойстваНалоговогоПериода(Организация, Дата);
		Результат = СвойстваНалоговогоПериода["ПериодПредставление"]
			+ " (" + СвойстваНалоговогоПериода["ПериодПредставлениеДиапазон"] + ")";	
	Иначе
		Результат = НСтр("ru='<заполните дату документа>'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСвойстваСчета(СчетСсылка)
	
	Возврат Документы.РаспределениеВходящегоНДС.ПолучитьСвойстваСчета(СчетСсылка);
	
КонецФункции

&НаСервере
Процедура РассчитатьКолонкиОтметитьСтрокуНаСервере()
	
	ТаблЧасть = Объект["СоставРаспределяемыхСумм"];
	Для Каждого СтрокаТЧ Из ТаблЧасть Цикл
		ОбновитьЗначенияОтметитьСтроку(СтрокаТЧ);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЗначенияОтметитьСтроку(СтрокаТЧ)
	
	СтрокаТЧ["ОтметитьКолонкиКВычетуИВСтоимость"] = НЕ (СтрокаТЧ["СуммаНДСВсего"] =
		СтрокаТЧ["СуммаНДСКВычету"] + СтрокаТЧ["СуммаНДСВСтоимость"]);
		
	СтрокаТЧ["ОтметитьКолонкиКВычетуИВСтоимостьВалютная"] = НЕ (СтрокаТЧ["СуммаНДСВсегоВалютная"] =
		СтрокаТЧ["СуммаНДСКВычетуВалютная"] + СтрокаТЧ["СуммаНДСВСтоимостьВалютная"]);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыВСтроке(Элемент)
	
	ТекДанные = Элементы["СоставРаспределяемыхСумм"].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Множитель = УчетНДСКлиентСервер.ПолучитьМножительСтавки(ТекДанные.СтавкаНДС, Истина);
	
	ИмяПоля = СтрЗаменить(Элемент.Имя, "СоставРаспределяемыхСумм", "");
	
	ПрименитьПропорциюРубли = (ИмяПоля = "Всего" ИЛИ ИмяПоля = "СуммаНДСВсего" ИЛИ ИмяПоля = "СтавкаНДС");
	
	ПрименитьПропорциюВалюта = (ИмяПоля = "ВсегоВалютная" ИЛИ ИмяПоля = "СуммаНДСВсегоВалютная" ИЛИ ИмяПоля = "СтавкаНДС");
		
	Если ИмяПоля = "СуммаНДСВСтоимость" Тогда
		
		ТекДанные["СуммаНДСКВычету"] = ТекДанные["СуммаНДСВсего"] - ТекДанные["СуммаНДСВСтоимость"];
		
	ИначеЕсли ИмяПоля = "СуммаНДСВСтоимостьВалютная" Тогда
		
		ТекДанные["СуммаНДСКВычетуВалютная"] = ТекДанные["СуммаНДСВсегоВалютная"] - ТекДанные["СуммаНДСВСтоимостьВалютная"];
		
	ИначеЕсли ИмяПоля = "СуммаНДСКВычету" Тогда
		
		ТекДанные["СуммаНДСВСтоимость"] = ТекДанные["СуммаНДСВсего"] - ТекДанные["СуммаНДСКВычету"];
		
	ИначеЕсли ИмяПоля = "СуммаНДСКВычетуВалютная" Тогда
		
		ТекДанные["СуммаНДСВСтоимостьВалютная"] = ТекДанные["СуммаНДСВсегоВалютная"] - ТекДанные["СуммаНДСКВычетуВалютная"];
		
	ИначеЕсли ИмяПоля = "Всего" Тогда
		
		ТекДанные["СуммаНДСВсего"] = ТекДанные["Всего"] * Множитель;
		
	ИначеЕсли ИмяПоля = "ВсегоВалютная" Тогда
		
		ТекДанные["СуммаНДСВсегоВалютная"] = ТекДанные["ВсегоВалютная"] * Множитель;
		
	ИначеЕсли ИмяПоля = "СтавкаНДС" Тогда
		
		ТекДанные["СуммаНДСВсего"] = ТекДанные["Всего"] * Множитель;
		
		ТекДанные["СуммаНДСВсегоВалютная"] = ТекДанные["ВсегоВалютная"] * Множитель;
		
	ИначеЕсли ИмяПоля = "СуммаНДСВсего" Тогда
		
		ТекДанные["Всего"] = ТекДанные["СуммаНДСВсего"] / Множитель;
		
	ИначеЕсли ИмяПоля = "СуммаНДСВсегоВалютная" Тогда
		
		ТекДанные["ВсегоВалютная"] = ТекДанные["СуммаНДСВсегоВалютная"] / Множитель;
		
	КонецЕсли;
	
	
	Если ПрименитьПропорциюРубли Тогда
		
		ТекДанные["СуммаНДСКВычету"] = ТекДанные["СуммаНДСВсего"] * ДоляПринимаемаяКВычету;
		
		ТекДанные["СуммаНДСВСтоимость"] = ТекДанные["СуммаНДСВсего"] - ТекДанные["СуммаНДСКВычету"];
		
	КонецЕсли;
	
	Если ПрименитьПропорциюВалюта Тогда
		
		ТекДанные["СуммаНДСКВычетуВалютная"] = ТекДанные["СуммаНДСВсегоВалютная"] * ДоляПринимаемаяКВычету;
		
		ТекДанные["СуммаНДСВСтоимостьВалютная"] = ТекДанные["СуммаНДСВсегоВалютная"] - ТекДанные["СуммаНДСКВычетуВалютная"];
		
	КонецЕсли;
	
	ОбновитьЗначенияОтметитьСтроку(ТекДанные);
	
КонецПроцедуры	

