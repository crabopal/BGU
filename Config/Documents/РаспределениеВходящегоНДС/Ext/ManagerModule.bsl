Функция ПолучитьСвойстваСчета(СчетСсылка) Экспорт
	
	СвойстваСчета = Новый Структура();
	СвойстваСчета.Вставить("НомерСубконтоВидыЗатрат",	0);
	СвойстваСчета.Вставить("КЭКДт",						Справочники.КОСГУ.ПустаяСсылка());
	
	Если НЕ ЗначениеЗаполнено(СчетСсылка) Тогда
		Возврат СвойстваСчета;
	КонецЕсли;
	
	Для Каждого Субконто Из СчетСсылка.ВидыСубконто Цикл
		Если Субконто.ВидСубконто.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ВидыЗатрат")) Тогда
			СвойстваСчета.Вставить("НомерСубконтоВидыЗатрат",	Субконто.НомерСтроки);
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	СвойстваСчета.Вставить("КЭКДт",	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетСсылка, "КОСГУДт"));
	
	Возврат СвойстваСчета;
	
КонецФункции

Функция ПолучитьТаблицуАналитикиЗатратИзДокументов(ОбъектыНалогообложения) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ОбъектыНалогообложения", ОбъектыНалогообложения);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Аналитика затрат из документов распределения НДС
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбъектНалогообложения					КАК ОбъектНалогообложения,
	|	ВидЦенности								КАК ВидЦенности,
	|	СтавкаНДС								КАК СтавкаНДС,
	|	СчетДт									КАК СчетДт,
	|	КЭКСчетаДебета							КАК КЭКСчетаДебета,
	|	КПССчетаДебета							КАК КПССчетаДебета,
	|	СубконтоДт1								КАК СубконтоДт1,
	|	СубконтоДт2								КАК СубконтоДт2,
	|	СубконтоДт3								КАК СубконтоДт3,
	|	ЕСТЬNULL(СУММА(СуммаНДСКВычету), 0)		КАК СуммаНДСКВычету,
	|	ЕСТЬNULL(СУММА(СуммаНДСВСтоимость), 0)	КАК СуммаНДСВСтоимость
	|ПОМЕСТИТЬ
	|	АналитикаЗатрат
	|ИЗ
	|	Документ.РаспределениеВходящегоНДС.СоставРаспределяемыхСумм
	|ГДЕ
	|	Ссылка.Проведен = ИСТИНА
	|	И ОбъектНалогообложения В(&ОбъектыНалогообложения)
	|СГРУППИРОВАТЬ ПО
	|	ОбъектНалогообложения,
	|	ВидЦенности,
	|	СтавкаНДС,
	|	СчетДт,
	|	КЭКСчетаДебета,
	|	КПССчетаДебета,
	|	СубконтоДт1,
	|	СубконтоДт2,
	|	СубконтоДт3
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Аналитика затрат из документов распределения НДС плюс пропорция к вычету
	|//
	|ВЫБРАТЬ
	|	*,
	|	ВЫРАЗИТЬ(ВЫБОР
	|		КОГДА СуммаНДСКВычету + СуммаНДСВСтоимость = 0 ТОГДА
	|			100
	|		ИНАЧЕ
	|			СуммаНДСКВычету * 100 / (СуммаНДСКВычету + СуммаНДСВСтоимость)
	|	КОНЕЦ КАК ЧИСЛО(6,2))	КАК ПроцентНДСкВычету
	|ИЗ
	|	АналитикаЗатрат
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектНалогообложения,
	|	ВидЦенности,
	|	СтавкаНДС,
	|	СуммаНДСКВычету УБЫВ
	|;";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

