	|	ДозаполненныйПриходныйДокумент.СтавкаНДС			КАК СтавкаНДС,
	|	ДозаполненныйПриходныйДокумент.СуммаНДС				КАК СуммаНДС,
	|	ДозаполненныйПриходныйДокумент.СуммаНДСВалютная		КАК СуммаНДСВалютная,
	|	ДозаполненныйПриходныйДокумент.Всего				КАК Всего,
	|	ДозаполненныйПриходныйДокумент.ВсегоВалютная		КАК ВсегоВалютная,
	|	ЛОЖЬ												КАК ПересчитатьКЭК
	|ИЗ
	|	ДозаполненныеДокументыПоступления	КАК ДозаполненныйПриходныйДокумент
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	АвансовыеОтчетыПриходныеДокументы	КАК ТекущийАвансовыйОтчет
	|		ПО	ДозаполненныйПриходныйДокумент.Ссылка = ТекущийАвансовыйОтчет.ПриходныйДокумент
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектНалогообложения,
	|	НомерСтрокиАвансовогоОтчета,
	|	НомерСтрокиПриходногоДокумента";
	
	РезультатыВыполнения = ЗапросАналитика.ВыполнитьПакет();
	
	// [1]. Суммы к распределению по данным учета без аналитики 106, 109
	Остатки = РезультатыВыполнения[1].Выгрузить();
	
	// Переименуем колонки на время сопоставления показателей
	// Приводим имена к полям аналитики
	Переименование = Новый Структура();
	Переименование.Вставить("СуммаНДСВсего",			"СуммаНДС");
	Переименование.Вставить("СуммаНДСВсегоВалютная",	"СуммаНДСВалютная");
	Переименование.Вставить("КПССчетаДебета",			"КПС");
	
	УчетНДС.ПереименоватьКолонки(Остатки, Переименование, "вперед");
	
	// [10]. Искомые суммы и аналитика затрат (все, кроме авансовых отчетов)
	Аналитика = РезультатыВыполнения[10].Выгрузить();
	
	// [11]. Искомые суммы и аналитика затрат (только авансовые отчеты)
	ТаблицаАвансовыеОтчеты = РезультатыВыполнения[11].Выгрузить();
	
	// Пересчитываем КЭК в некоторых строках
	// Добавляем авансовые отчеты в общую таблицу
	Для Каждого СтрокаТаблицы Из ТаблицаАвансовыеОтчеты Цикл
		Если НЕ СтрокаТаблицы["ПересчитатьКЭК"] Тогда
			Продолжить;
		КонецЕсли;
		
		КЭК = БухгалтерскиеОперации.КЭКСчета(
			СтрокаТаблицы.Организация,
			СтрокаТаблицы.ИФО,
			СтрокаТаблицы.КФО,
			СтрокаТаблицы.Дата,
			СтрокаТаблицы.Счет,
			"Дт",
			СтрокаТаблицы.КЭК);
		
		Если НЕ ЗначениеЗаполнено(КЭК) Тогда
			КЭК = СтрокаТаблицы.КЭК;
		КонецЕсли;
		
		СтрокаТаблицы["КЭК"] = КЭК;
		
		НоваяСтрока = Аналитика.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	КлючСвязи = Новый Массив();
	КлючСвязи.Добавить("ОбъектНалогообложения");
	КлючСвязи.Добавить("КФО");
	КлючСвязи.Добавить("КПС");
	КлючСвязи.Добавить("СтавкаНДС");
	
	Показатели = Новый Массив();
	Показатели.Добавить("СуммаНДС");
	Показатели.Добавить("Всего");
	
	Если ЗапросАналитика.Параметры.ЗаполнитьВалютныеСуммы Тогда
		Показатели.Добавить("СуммаНДСВалютная");
		Показатели.Добавить("ВсегоВалютная");
	КонецЕсли;
	
	РезультатыСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
		Остатки,
		Аналитика,
		КлючСвязи,
		Показатели,
		"СписанияВОбеихТаблицахВРазмереСоответствия,ОстаткиВТаблице1");
		
	Таблица = РезультатыСравнения["СписанияВОбеихТаблицахВРазмереСоответствия"];
	
	Для Каждого СтрокаТаблицы Из РезультатыСравнения["ОстаткиВТаблице1"] Цикл
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	Таблица.Сортировать("ОбъектНалогообложения,Счет УБЫВ");
	
	// Обратно переименуем колонки после выполнения сопоставления показателей
	УчетНДС.ПереименоватьКолонки(Таблица, Переименование, "назад");
	
	НастроитьСоставКолонокТаблицыСоставРаспределяемыхСумм(Таблица);
	
	Возврат Таблица;
	
КонецФункции

Процедура НастроитьСоставКолонокТаблицыСоставРаспределяемыхСумм(Таблица)
	
	Перем НовоеИмя;
	
	КолонкиТабличнойЧасти = Метаданные.Документы.РаспределениеВходящегоНДС.ТабличныеЧасти.СоставРаспределяемыхСумм.Реквизиты;
	
	Переименование = Новый Структура();
	Переименование.Вставить("Счет",				"СчетДт");
	Переименование.Вставить("КЭК",				"КЭКСчетаДебета");
	Переименование.Вставить("КПС",				"КПССчетаДебета");
	Переименование.Вставить("Субконто1",		"СубконтоДт1");
	Переименование.Вставить("Субконто2",		"СубконтоДт2");
	Переименование.Вставить("Субконто3",		"СубконтоДт3");
	Переименование.Вставить("СуммаНДС",			"СуммаНДСВсего");
	Переименование.Вставить("СуммаНДСВалютная",	"СуммаНДСВсегоВалютная");
	
	КоличествоКолонок = Таблица.Колонки.Количество();
	
	Для Сч = 1 По КоличествоКолонок Цикл
		
		Индекс = КоличествоКолонок - Сч;
		
		Колонка = Таблица.Колонки.Получить(Индекс);
		
		Если Переименование.Свойство(Колонка.Имя, НовоеИмя) Тогда
			Колонка.Имя = НовоеИмя;
		КонецЕсли;
		
		ЭтоЛишняяКолонка = (КолонкиТабличнойЧасти.Найти(Колонка.Имя) = Неопределено);
		
		Если ЭтоЛишняяКолонка Тогда
			Таблица.Колонки.Удалить(Индекс);
		КонецЕсли;
		
	КонецЦикла;
	
	ИмяКолонкиПоУчету = "ПоУчету";
	
	Таблица.Колонки.Добавить(ИмяКолонкиПоУчету, Новый ОписаниеТипов("Булево"));
	
	Таблица.ЗаполнитьЗначения(Истина, ИмяКолонкиПоУчету);
	
КонецПроцедуры

Процедура ДобавитьКолонкиСуммБезНДС(Таблица)
	
	ТипЧисло = Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2, ДопустимыйЗнак.Неотрицательный));
	
	// Общая сумма
	Таблица.Колонки.Добавить("СуммаБезНДСВсего",			ТипЧисло);
	Таблица.Колонки.Добавить("СуммаБезНДСВсегоВалютная",	ТипЧисло);
	
	// К вычету
	Таблица.Колонки.Добавить("СуммаБезНДСКВычету",			ТипЧисло);
	Таблица.Колонки.Добавить("СуммаБезНДСКВычетуВалютная",	ТипЧисло);
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		ПропорцияВычета = ?(СтрокаТаблицы["СуммаНДСВсего"] = 0, 0, СтрокаТаблицы["СуммаНДСКВычету"] / СтрокаТаблицы["СуммаНДСВсего"]);
		
		ВсегоКВычету = Окр(СтрокаТаблицы["Всего"] * ПропорцияВычета, 2);
		
		ВсегоКВычетуВалютная = Окр(СтрокаТаблицы["ВсегоВалютная"] * ПропорцияВычета, 2);
		
		СуммаБезНДСКВычету = ВсегоКВычету - СтрокаТаблицы["СуммаНДСКВычету"];
		
		СуммаБезНДСКВычетуВалютная = ВсегоКВычетуВалютная - СтрокаТаблицы["СуммаНДСКВычетуВалютная"];
		
		СтрокаТаблицы["СуммаБезНДСКВычету"]				= СуммаБезНДСКВычету;
		СтрокаТаблицы["СуммаБезНДСКВычетуВалютная"]		= СуммаБезНДСКВычетуВалютная;
		
		СтрокаТаблицы["СуммаБезНДСВсего"]			= СтрокаТаблицы["Всего"]			- СтрокаТаблицы["СуммаНДСВсего"];
		СтрокаТаблицы["СуммаБезНДСВсегоВалютная"]	= СтрокаТаблицы["ВсегоВалютная"]	- СтрокаТаблицы["СуммаНДСВсегоВалютная"];
		
	КонецЦикла;
	
КонецПроцедуры

Функция УчитыватьРаботыУслугиПоГосЗаданию(Организация, Знач НаДату)
	
	Перем ЗначениеРеквизита;
	
	ЗначениеПоУмолчанию = Истина;
	
	ИмяРеквизита = "НДСУчитыватьРаботыУслугиПоГосЗаданию";
	
	Результат = ЗначениеПоУмолчанию;
	
	Если ТипЗнч(НаДату) = Тип("Граница") Тогда
		НаДату = НаДату.Значение;
	КонецЕсли;
	
	Если ТипЗнч(НаДату) = Тип("МоментВремени") Тогда
		НаДату = НаДату.Дата;
	КонецЕсли;
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, НаДату);
	
	Если ТипЗнч(УчетнаяПолитика) = Тип("Структура") Тогда
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(УчетнаяПолитика, ИмяРеквизита) Тогда
			
			УчетнаяПолитика.Свойство(ИмяРеквизита, ЗначениеРеквизита);
			
			Если ТипЗнч(ЗначениеРеквизита) = Тип("Булево") Тогда
				
				Результат = ЗначениеРеквизита;
				
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСчетаЗатрат()
	
	ПараметрыВыбора = Метаданные.Документы.РаспределениеВходящегоНДС.ТабличныеЧасти.СоставРаспределяемыхСумм.Реквизиты.СчетДт.ПараметрыВыбора;
	
	Для Каждого ПараметрВыбора Из ПараметрыВыбора Цикл
		Если ПараметрВыбора.Имя = "ОграниченияСписокСчетов" Тогда
			МассивКодов = Новый Массив(ПараметрВыбора.Значение);
			
			Возврат БухгалтерскийУчет.СписокСчетов(МассивКодов);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Массив();
	
КонецФункции

