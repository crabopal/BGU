Функция ПолучитьСуммыРеализации(ШапкаДокумента)
	
	Расшифровка = ПолучитьРасшифровкуСуммРеализации(ШапкаДокумента);
	
	СуммыРеализации = Новый Структура();
	СуммыРеализации.Вставить("СуммаРеализацииВсего",			Расшифровка["ТаблицаВсего"].Итог("СуммаРеализации"));
	СуммыРеализации.Вставить("СуммаРеализацииОблагаемаяБезНДС",	Расшифровка["ТаблицаОблагаемая"].Итог("СуммаБезНДС"));
	СуммыРеализации.Вставить("СуммаРеализацииНДС",				Расшифровка["ТаблицаОблагаемая"].Итог("СуммаНДС"));
	
	Возврат СуммыРеализации;
	
КонецФункции

Функция ПолучитьРасшифровкуСуммРеализации(ШапкаДокумента)
	
	ГраницыПериода = ПолучитьГраницыПериода(ШапкаДокумента);
	
	ИспользоватьОтборПоПодразделению	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ЗначениеЗаполнено(ШапкаДокумента["Подразделение"]);
	ИспользоватьОтборПоИФО 				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ШапкаДокумента["ИФО"]);
	
	НаДату = ГраницыПериода["КонецПериода"];
	
	СчетаДлительныеДоговоры = Документы.АктСверкиВзаиморасчетов.ПолучитьСчетаДлительныеДоговоры(НаДату);
	
	// Все детальные счета (и устаревшие, и новые) для исключения конструкции В ИЕРАРХИИ и ускорения работы запроса
	Счета20500	= БухгалтерскийУчет.СписокСчетов("205.00", НаДату);
	Счета20520	= БухгалтерскийУчет.СписокСчетов("205.23,205.28,205.29", НаДату);
	
	// Кроме 205.35
	Счета20530	= БухгалтерскийУчет.СписокСчетов("205.30", НаДату);
	Исключаемые	= БухгалтерскийУчет.СписокСчетов("205.35,205.36", НаДату);
	
	Для Каждого Счет Из Исключаемые Цикл
		Индекс = Счета20530.Найти(Счет);
		
		Если Индекс = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Счета20530.Удалить(Индекс);
	КонецЦикла;
	
