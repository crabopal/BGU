	|		Период
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Регистратор								КАК Регистратор,
	|		Период									КАК Период,
	|		ЕСТЬNULL(СУММА(СуммаБезНДСОборот), 0)	КАК СуммаБезНДС,
	|		ЕСТЬNULL(СУММА(СуммаНДСОборот), 0)		КАК СуммаНДС
	|	ИЗ
	|		РегистрНакопления.КнигаПродаж.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			Организация = &Организация
	|			И ПричинаНалогообложения В (&ПричиныРеализации)
	|			И НЕ СтавкаНДС В (&СтавкиБезНДС)
	|			И ВЫБОР
	|				КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|					СчетФактура.ИФО = &ИФО
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ
	|			И ВЫБОР
	|				КОГДА &ИспользоватьОтборПоПодразделению ТОГДА
	|					СчетФактура.Подразделение = &Подразделение
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ			   
	|			И (СчетФактура.Дата <= &КонецПериодаДата
	|				ИЛИ ТИПЗНАЧЕНИЯ(СчетФактура) = ТИП(Документ.СчетФактураВыданный)
	|					И СчетФактура.РегистрацияВПредыдущемПериоде
	|					И (СчетФактура.ДокументОснование.Дата МЕЖДУ &НачалоПериодаДата И &КонецПериодаДата))
	|		)	КАК Обороты
	|	СГРУППИРОВАТЬ ПО
	|		Регистратор,
	|		Период
	|	)	КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	Регистратор
	|ИМЕЮЩИЕ
	|	ЕСТЬNULL(СУММА(СуммаБезНДС), 0) <> 0
	|	ИЛИ ЕСТЬNULL(СУММА(СуммаНДС), 0) <> 0
	|УПОРЯДОЧИТЬ ПО
	|	Период
	|;";
	
	РезультатыЗапроса = ЗапросСуммы.ВыполнитьПакет();
	
	// [1]. Сумма реализации всего (облагаемая + необлагаемая)
	ТаблицаРеализацияВсего = РезультатыЗапроса[1].Выгрузить();
	
	// [2]. Сумма реализации облагаемая и НДС
	ТаблицаРеализацияОблагаемая = РезультатыЗапроса[2].Выгрузить();
	
	Расшифровка = Новый Структура();
	Расшифровка.Вставить("ТаблицаВсего",		ТаблицаРеализацияВсего);
	Расшифровка.Вставить("ТаблицаОблагаемая",	ТаблицаРеализацияОблагаемая);
	
	Возврат Расшифровка;
	
КонецФункции


Функция ПолучитьРаспределяемыеСуммыБезАналитики(ШапкаДокумента)
		
	ЗапросОстатки = ИнициализироватьЗапросОстатки(ШапкаДокумента);
	
	ЗапросОстатки.Текст = ЗапросОстатки.Текст
		+ ПолучитьТекстЗапросаРаспределяемыеСуммыБезАналитики();
	
	Таблица = ЗапросОстатки.Выполнить().Выгрузить();
	
	ИмяКолонкиПоУчету = "ПоУчету";
	
	Таблица.Колонки.Добавить(ИмяКолонкиПоУчету, Новый ОписаниеТипов("Булево"));
	
	Таблица.ЗаполнитьЗначения(Истина, ИмяКолонкиПоУчету);
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьРаспределяемыеСуммыСАналитикой(ШапкаДокумента)
	
	ЗапросАналитика = ИнициализироватьЗапросОстатки(ШапкаДокумента);
	
	ЗапросАналитика.УстановитьПараметр("СчетаЗатрат", ПолучитьСчетаЗатрат());
	ЗапросАналитика.УстановитьПараметр("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	ЗапросАналитика.Текст = ЗапросАналитика.Текст
