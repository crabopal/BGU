Функция ПолучитьГраницыПериода(ШапкаДокумента)
	
	СвойстваНалоговогоПериода = УчетНДС.ПолучитьСвойстваНалоговогоПериода(ШапкаДокумента["Организация"], ШапкаДокумента["Дата"]);
	
	ГраницыПериода = Новый Структура();
	ГраницыПериода.Вставить("НачалоПериода",	Новый Граница(НачалоДня(СвойстваНалоговогоПериода["ДатаНачала"]), ВидГраницы.Включая));
	ГраницыПериода.Вставить("КонецПериода",		Новый Граница(КонецДня(СвойстваНалоговогоПериода["ДатаОкончания"]), ВидГраницы.Включая));
	
	Возврат ГраницыПериода;
	
КонецФункции

