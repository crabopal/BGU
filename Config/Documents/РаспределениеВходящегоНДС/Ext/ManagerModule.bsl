#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	ЕстьОшибкиЗаполнения = Ложь;
	
	ЗаполнитьВалютныеСуммы = УчетНДС.СледуетЗаполнитьВалютныеСуммы();
	
	СоставРаспределяемыхСумм = ДокументОбъект["СоставРаспределяемыхСумм"].Выгрузить();
	
	//---
	// Корректность сумм в пределах одной строки
	//---
	ЗапросПроверки = Новый Запрос();
	ЗапросПроверки.УстановитьПараметр("СоставРаспределяемыхСумм", СоставРаспределяемыхСумм);
	ЗапросПроверки.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Табличная часть СоставРаспределяемыхСумм
	|//
	|ВЫБРАТЬ
	|	ТЧ.НомерСтроки				КАК НомерСтроки,
	|	ТЧ.Всего					КАК СуммаВсего,
	|	ТЧ.СуммаНДСВсего			КАК СуммаНДСВсего,
	|	ТЧ.СуммаНДСКВычету			КАК СуммаНДСКВычету,
	|	ТЧ.СуммаНДСВСтоимость		КАК СуммаНДСВСтоимость
	|ПОМЕСТИТЬ
	|	СоставРаспределяемыхСумм
	|ИЗ
	|	&СоставРаспределяемыхСумм	КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Строки с некорректно заполненными суммами
	|//
	|// НДСВсего <> (КВычету + ВСтоимость)
	|ВЫБРАТЬ
	|	НомерСтроки	КАК НомерСтроки,
	|	1			КАК КодПроверки
	|ПОМЕСТИТЬ
	|	НекорректныеСуммы
	|ИЗ
	|	СоставРаспределяемыхСумм
	|ГДЕ
	|	НЕ СуммаНДСВсего = СуммаНДСКВычету + СуммаНДСВСтоимость
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// НДСВсего > Всего
	|ВЫБРАТЬ
	|	НомерСтроки	КАК НомерСтроки,
	|	2			КАК КодПроверки
	|ИЗ
	|	СоставРаспределяемыхСумм
	|ГДЕ
	|	СуммаНДСВсего > 0 И СуммаНДСВсего > СуммаВсего
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Строки с некорректно заполненными суммами
	|//		(Финальная таблица для вывода сообщений)
	|//
	|ВЫБРАТЬ
	|	НомерСтроки				КАК НомерСтроки,
	|	МИНИМУМ(КодПроверки)	КАК КодПроверки
	|ИЗ
	|	НекорректныеСуммы
	|СГРУППИРОВАТЬ ПО
	|	НомерСтроки
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";
	
	РезультатПроверки = ЗапросПроверки.Выполнить();
	
	Если НЕ РезультатПроверки.Пустой() Тогда
		
		ЕстьОшибкиЗаполнения = Истина;
		
		ИмяТаблЧастиДляВыводаСообщений	= "СоставРаспределяемыхСумм";
		ИмяПоляДляВыводаСообщений		= "СуммаНДСВсего";
		
		// 1) НДСВсего <> (КВычету + ВСтоимость)
		Текст1 = НСтр("ru='Значение ""НДС всего"" не равно сумме ""к вычету"" и ""в стоимость"" (таблица ""Суммы к распределению"" строка%1)'");
		
		// 2) НДСВсего > Всего
		Текст2 = НСтр("ru='Значение ""НДС всего"" больше чем общая ""Сумма всего"" (таблица ""Суммы к распределению"" строка%1)'");
		
		Выборка = РезультатПроверки.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ИндексСтроки = Выборка["НомерСтроки"] - 1;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			НомерСтрокиПредставление = Символы.НПП + Выборка["НомерСтроки"];
			
			Если Выборка["КодПроверки"] = 1 Тогда
				Текст = Текст1;
				
			ИначеЕсли Выборка["КодПроверки"] = 2 Тогда
				Текст = Текст2;
				
			Иначе
				Продолжить;
			КонецЕсли;
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, НомерСтрокиПредставление);
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЕстьОшибкиЗаполнения Тогда
		Возврат ЕстьОшибкиЗаполнения;
	КонецЕсли;
	
	//---
	// Превышение остатков
	//---
	ЗапросОстатки = ИнициализироватьЗапросОстатки(ДокументОбъект);
	
	ЗапросОстатки.Текст = ЗапросОстатки.Текст + "
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	ВсеОстатки;";
	
	Остатки = ЗапросОстатки.Выполнить().Выгрузить();
	
	КлючСвязи = Новый Структура(ПолучитьИменаКолонокСопоставленияОстатков());
	
	Показатели = Новый Массив();
	Показатели.Добавить("СуммаНДС");
	Показатели.Добавить("Всего");
	
	Если ЗаполнитьВалютныеСуммы Тогда
		Показатели.Добавить("СуммаНДСВалютная");
		Показатели.Добавить("ВсегоВалютная");
	КонецЕсли;
	
	// Переименуем колонки на время сопоставления показателей
	// Приводим имена к полям остатков
	Переименование = Новый Структура();
	Переименование.Вставить("СуммаНДСВсего",			"СуммаНДС");
	Переименование.Вставить("СуммаНДСВсегоВалютная",	"СуммаНДСВалютная");
	
	УчетНДС.ПереименоватьКолонки(СоставРаспределяемыхСумм, Переименование, "вперед");
	
	ТаблицаПревышения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
		СоставРаспределяемыхСумм,
		Остатки,
		КлючСвязи,
		Показатели,
		"ПревышенияТаблицы1НадТаблицей2")["ПревышенияТаблицы1НадТаблицей2"];
		
	Если ТаблицаПревышения.Количество() > 0 Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		// Необходимо из-за предшествующего переименования колонок
		ЗаменаКолонок = Новый Структура();
		ЗаменаКолонок.Вставить("СуммаНДС",			"СуммаНДСВсего");
		ЗаменаКолонок.Вставить("СуммаНДСВалютная",	"СуммаНДСВсегоВалютная");
		
		ПараметрыВывода = Новый Структура();
		ПараметрыВывода.Вставить("ТаблицаИмя",				"СоставРаспределяемыхСумм");
		ПараметрыВывода.Вставить("ТаблицаПредставление",	НСтр("ru='Суммы к распределению'"));
		ПараметрыВывода.Вставить("ОбъектСсылка",			ДокументОбъект["Ссылка"]);
		ПараметрыВывода.Вставить("ЗаменаКолонок",			ЗаменаКолонок);
		
		УчетНДС.ВывестиСообщенияОПревышенииОстатков(ТаблицаПревышения, ПараметрыВывода);
	КонецЕсли;
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента(ДокументОбъект, СтруктураДополнительныеСвойства) Экспорт
	
	ТаблицаВходящийНДС = ДокументОбъект.Движения["ВходящийНДС"].Выгрузить();
	ТаблицаВходящийНДС.Очистить();
	
	ТаблицаВходящийНДСКРаспределению = ДокументОбъект.Движения["ВходящийНДСКРаспределению"].Выгрузить();
	ТаблицаВходящийНДСКРаспределению.Очистить();
	
	ЗаполнитьВалютныеСуммы = УчетНДС.СледуетЗаполнитьВалютныеСуммы();
	
	ШапкаДокумента = Новый Структура(ПолучитьИменаРеквизитовШапкиДляПоискаОстатков());
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);
	
	//
	// Свернутая табличная часть
	//
	ЗапросТЧ = Новый Запрос();
	ЗапросТЧ.УстановитьПараметр("ДокСсылка", ШапкаДокумента["Ссылка"]);
	ЗапросТЧ.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Свернутая табличная часть СоставРаспределяемыхСумм (подготовка)
	|//
	|ВЫБРАТЬ
	|	КФО									КАК КФО,
	|	СтавкаНДС							КАК СтавкаНДС,
	|	ВидЦенности							КАК ВидЦенности,
	|	ОбъектНалогообложения				КАК ОбъектНалогообложения,
	|	СУММА(СуммаНДСВсего)				КАК СуммаНДСВсего,
	|	СУММА(СуммаНДСВсегоВалютная)		КАК СуммаНДСВсегоВалютная,
	|	СУММА(СуммаНДСКВычету)				КАК СуммаНДСКВычету,
	|	СУММА(СуммаНДСКВычетуВалютная)		КАК СуммаНДСКВычетуВалютная,
	|	СУММА(СуммаНДСВСтоимость)			КАК СуммаНДСВСтоимость,
	|	СУММА(СуммаНДСВСтоимостьВалютная)	КАК СуммаНДСВСтоимостьВалютная,
	|	СУММА(Всего)						КАК Всего,
	|	СУММА(ВсегоВалютная)				КАК ВсегоВалютная
	|ПОМЕСТИТЬ
	|	СвернутаяТЧ
	|ИЗ
	|	Документ.РаспределениеВходящегоНДС.СоставРаспределяемыхСумм
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|СГРУППИРОВАТЬ ПО
	|	КФО,
	|	СтавкаНДС,
	|	ВидЦенности,
	|	ОбъектНалогообложения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Свернутая табличная часть СоставРаспределяемыхСумм
	|//
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	СвернутаяТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Список используемых документов поступления
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОбъектНалогообложения
	|ИЗ
	|	СвернутаяТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Движения по регистру накопления НДСНеоблагаемыеОперации
	|//
	|ВЫБРАТЬ
	|	Ссылка.Дата					КАК Период,
	|	Ссылка.Организация			КАК Организация,
	|	СУММА(СуммаНДСВСтоимость)	КАК СуммаНДСНеПодлежащаяВычету
	|ИЗ
	|	Документ.РаспределениеВходящегоНДС.СоставРаспределяемыхСумм
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|СГРУППИРОВАТЬ ПО
	|	Ссылка.Дата,
	|	Ссылка.Организация
	|;";
	
	РезультатыЗапроса = ЗапросТЧ.ВыполнитьПакет();
	
	// [1]. Свернутая табличная часть СоставРаспределяемыхСумм
	СвернутаяТЧ = РезультатыЗапроса[1].Выгрузить();
	
	ДобавитьКолонкиСуммБезНДС(СвернутаяТЧ);
	
	// [2]. Список используемых документов поступления
	ОбъектыНалогообложения = РезультатыЗапроса[2].Выгрузить().ВыгрузитьКолонку("ОбъектНалогообложения");
	
	// [3]. Движения по регистру накопления НДСНеоблагаемыеОперации
	ТаблицаНДСНеоблагаемыеОперации = РезультатыЗапроса[3].Выгрузить();
	
	//
	// Детальные остатки
	//
	ЗапросОстатки = ИнициализироватьЗапросОстатки(ШапкаДокумента);
	ЗапросОстатки.Текст = ЗапросОстатки.Текст + "
	|ВЫБРАТЬ
	|	*,
	|	СуммаБезНДС + СуммаНДС					КАК Всего,
	|	СуммаБезНДСВалютная + СуммаНДСВалютная	КАК ВсегоВалютная
	|ИЗ
	|	ВсеОстатки
	|;";
	
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПоОбъектуНалогообложения",	Истина);
	ЗапросОстатки.УстановитьПараметр("ОбъектыНалогообложения",						ОбъектыНалогообложения);
	
	ДетальныеОстатки = ЗапросОстатки.Выполнить().Выгрузить(); // Допустимы строки с отрицательными суммами остатков
	
	//
	// Свернутые остатки
	// Приведем обе таблицы к одинаковому уровню детализации для выполнения сопоставления
	//
	
	ИменаКолонокСопоставленияОстатков = ПолучитьИменаКолонокСопоставленияОстатков();
	
	СвернутыеОстатки = ДетальныеОстатки.Скопировать();
	
	СвернутыеОстатки.Свернуть(ИменаКолонокСопоставленияОстатков, "СуммаНДС,СуммаНДСВалютная,СуммаБезНДС,СуммаБезНДСВалютная");
	
	Поиск = Новый Структура(ИменаКолонокСопоставленияОстатков);
	
	Для Каждого СтрокаСвернутойТЧ Из СвернутаяТЧ Цикл
		
		ПропорцияВычета = СтрокаСвернутойТЧ["СуммаНДСКВычету"] / СтрокаСвернутойТЧ["СуммаНДСВсего"]; // нулевой знаменатель исключается в проверке заполнения
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаСвернутойТЧ);
		
		ВремМассив = СвернутыеОстатки.НайтиСтроки(Поиск);
		
		// Наличие соответствующего остатка гарантируется в проверке заполнения
		// Остаток всего один из-за группировки, идентичной группировке табличной части
		СтрокаСвернутогоОстатка = ВремМассив[0];
		
		ПропорцияОстатка = СтрокаСвернутогоОстатка["СуммаНДС"] / СтрокаСвернутойТЧ["СуммаНДСВсего"];
		
		МассивСтрок = ДетальныеОстатки.НайтиСтроки(Поиск);
		
		КоличествоСтрок = МассивСтрок.Количество();
		
		НомерСтроки = 0;
		
		СписаноНДС				= 0;
		СписаноНДСВалютная		= 0;
		СписаноБезНДС			= 0;
		СписаноБезНДСВалютная	= 0;
		
		ОтложеноНДСКВычету				= 0;
		ОтложеноНДСКВычетуВалютная		= 0;
		ОтложеноБезНДСКВычету			= 0;
		ОтложеноБезНДСКВычетуВалютная	= 0;
		
		Для Каждого СтрокаДетальногоОстатка Из МассивСтрок Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			Если НомерСтроки < КоличествоСтрок Тогда
				// Не последняя строка детального остатка
				// Рассчитываем суммы по пропорции
				
				НДС				= Окр(СтрокаДетальногоОстатка["СуммаНДС"] * ПропорцияОстатка, 2);
				НДСВалютная		= Окр(СтрокаДетальногоОстатка["СуммаНДСВалютная"] * ПропорцияОстатка, 2);
				БезНДС			= Окр(СтрокаДетальногоОстатка["СуммаБезНДС"] * ПропорцияОстатка, 2);
				БезНДСВалютная	= Окр(СтрокаДетальногоОстатка["СуммаБезНДСВалютная"] * ПропорцияОстатка, 2);
				
				НДСВычет			= Окр(НДС * ПропорцияВычета, 2);
				НДСВалютнаяВычет	= Окр(НДСВалютная * ПропорцияВычета, 2);
				БезНДСВычет			= Окр(БезНДС * ПропорцияВычета, 2);
				БезНДСВалютнаяВычет	= Окр(БезНДСВалютная * ПропорцияВычета, 2);
				
			Иначе
				// Последняя строка детального остатка
				// Рассчитываем суммы по оставшейся части
				
				НДС				= СтрокаСвернутойТЧ["СуммаНДСВсего"]			- СписаноНДС;
				НДСВалютная		= СтрокаСвернутойТЧ["СуммаНДСВсегоВалютная"]	- СписаноНДСВалютная;
				БезНДС			= СтрокаСвернутойТЧ["СуммаБезНДСВсего"]			- СписаноБезНДС;
				БезНДСВалютная	= СтрокаСвернутойТЧ["СуммаБезНДСВсегоВалютная"]	- СписаноБезНДСВалютная;
				
				НДСВычет			= СтрокаСвернутойТЧ["СуммаНДСКВычету"]				- ОтложеноНДСКВычету;
				НДСВалютнаяВычет	= СтрокаСвернутойТЧ["СуммаНДСКВычетуВалютная"]		- ОтложеноНДСКВычетуВалютная;
				БезНДСВычет			= СтрокаСвернутойТЧ["СуммаБезНДСКВычету"]			- ОтложеноБезНДСКВычету;
				БезНДСВалютнаяВычет	= СтрокаСвернутойТЧ["СуммаБезНДСКВычетуВалютная"]	- ОтложеноБезНДСКВычетуВалютная;
				
			КонецЕсли;
			
			СписаноНДС				= СписаноНДС			+ НДС;
			СписаноНДСВалютная		= СписаноНДСВалютная	+ НДСВалютная;
			СписаноБезНДС			= СписаноБезНДС			+ БезНДС;
			СписаноБезНДСВалютная	= СписаноБезНДСВалютная	+ БезНДСВалютная;
			
			ОтложеноНДСКВычету				= ОтложеноНДСКВычету			+ НДСВычет;
			ОтложеноНДСКВычетуВалютная		= ОтложеноНДСКВычетуВалютная	+ НДСВалютнаяВычет;
			ОтложеноБезНДСКВычету			= ОтложеноБезНДСКВычету			+ БезНДСВычет;
			ОтложеноБезНДСКВычетуВалютная	= ОтложеноБезНДСКВычетуВалютная	+ БезНДСВалютнаяВычет;
			
			//
			// Списание части остатка
			//
			Движение = ТаблицаВходящийНДСКРаспределению.Добавить();
			
			ЗаполнитьЗначенияСвойств(Движение, СтрокаДетальногоОстатка);
			
			Движение["СуммаНДС"]			= НДС;
			Движение["СуммаНДСВалютная"]	= НДСВалютная;
			Движение["СуммаБезНДС"]			= БезНДС;
			Движение["СуммаБезНДСВалютная"]	= БезНДСВалютная;
			
			//
			// Отложение к вычету
			//
			Движение = ТаблицаВходящийНДС.Добавить();
			
			ЗаполнитьЗначенияСвойств(Движение, СтрокаДетальногоОстатка);
			
			Движение["СуммаНДС"]			= НДСВычет;
			Движение["СуммаНДСВалютная"]	= НДСВалютнаяВычет;
			Движение["СуммаБезНДС"]			= БезНДСВычет;
			Движение["СуммаБезНДСВалютная"]	= БезНДСВалютнаяВычет;
			
		КонецЦикла;
			
	КонецЦикла;
	
	ТаблицаВходящийНДСКРаспределению.ЗаполнитьЗначения(ВидДвиженияНакопления.Расход,	"ВидДвижения");
	ТаблицаВходящийНДСКРаспределению.ЗаполнитьЗначения(ШапкаДокумента["Дата"],			"Период");
	ТаблицаВходящийНДСКРаспределению.ЗаполнитьЗначения(Истина,							"Активность");
	
	ТаблицаВходящийНДС.ЗаполнитьЗначения(ВидДвиженияНакопления.Приход,	"ВидДвижения");
	ТаблицаВходящийНДС.ЗаполнитьЗначения(ШапкаДокумента["Дата"],		"Период");
	ТаблицаВходящийНДС.ЗаполнитьЗначения(Истина,						"Активность");
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	ТаблицыДляДвижений.Вставить("ВходящийНДСКРаспределению",	ТаблицаВходящийНДСКРаспределению);
	ТаблицыДляДвижений.Вставить("ВходящийНДС",					ТаблицаВходящийНДС);
	ТаблицыДляДвижений.Вставить("НДСНеоблагаемыеОперации",		ТаблицаНДСНеоблагаемыеОперации);
	
КонецПроцедуры

Процедура ПолучитьДанныеБухУчета(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ШапкаДокумента = ПараметрыПроцедуры["ШапкаДокумента"];
	
	РезультатыЗаполнения = Новый Структура();
	
	Если ПараметрыПроцедуры.Свойство("ЗаполнитьСуммыРеализации") Тогда
		
		СуммыРеализации = ПолучитьСуммыРеализации(ШапкаДокумента);
		
		РезультатыЗаполнения.Вставить("СуммыРеализации", СуммыРеализации);
		
	КонецЕсли;
	
	Если ПараметрыПроцедуры.Свойство("ЗаполнитьРаспределяемыеСуммыБезАналитики") Тогда
		
		Таблица = ПолучитьРаспределяемыеСуммыБезАналитики(ШапкаДокумента);
		
		РезультатыЗаполнения.Вставить("СоставРаспределяемыхСумм", Таблица);
		
	ИначеЕсли ПараметрыПроцедуры.Свойство("ЗаполнитьРаспределяемыеСуммыСАналитикой") Тогда
		
		Таблица = ПолучитьРаспределяемыеСуммыСАналитикой(ШапкаДокумента);
		
		РезультатыЗаполнения.Вставить("СоставРаспределяемыхСумм", Таблица);
		
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(РезультатыЗаполнения, АдресРезультата);
	
КонецПроцедуры

Процедура ПолучитьРасшифровку(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ШапкаДокумента = ПараметрыПроцедуры["ШапкаДокумента"];
	
	РезультатыЗаполнения = Новый Структура();
	
	РезультатыЗаполнения.Вставить("Расшифровка", ПолучитьРасшифровкуСуммРеализации(ШапкаДокумента));
	
	ПоместитьВоВременноеХранилище(РезультатыЗаполнения, АдресРезультата);
	
КонецПроцедуры

Функция ЗаполнитьТабличныйДокументРасшифровки(ТабДокумент, Расшифровка) Экспорт
	
	ТабДокумент.Очистить();
	
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = "ПараметрыПечати_РаспределениеВходящегоНДС_Расшифровка";
	
	Макет = ПолучитьМакет("Расшифровка");
	
	Области = Новый Структура();
	
	Области.Вставить("ЗаголовокВсего",			Макет.ПолучитьОбласть("ЗаголовокВсего"));
	Области.Вставить("ЗаголовокВсегоГруппа1",	Макет.ПолучитьОбласть("ЗаголовокВсегоГруппа1"));
	Области.Вставить("ЗаголовокВсегоГруппа2",	Макет.ПолучитьОбласть("ЗаголовокВсегоГруппа2"));
	Области.Вставить("ЗаголовокВсегоГруппа3",	Макет.ПолучитьОбласть("ЗаголовокВсегоГруппа3"));
	Области.Вставить("ЗаголовокВсегоГруппа4",	Макет.ПолучитьОбласть("ЗаголовокВсегоГруппа4"));
	Области.Вставить("ЗаголовокВсегоГруппа5",	Макет.ПолучитьОбласть("ЗаголовокВсегоГруппа5"));
	Области.Вставить("ЗаголовокВсегоГруппа6",	Макет.ПолучитьОбласть("ЗаголовокВсегоГруппа6"));
	Области.Вставить("ЗаголовокВсегоГруппа7",	Макет.ПолучитьОбласть("ЗаголовокВсегоГруппа7"));
	
	Области.Вставить("ЗаголовокОблагаемая",		Макет.ПолучитьОбласть("ЗаголовокОблагаемая"));
	Области.Вставить("ЗаголовокНДС",			Макет.ПолучитьОбласть("ЗаголовокНДС"));
	
	Области.Вставить("ШапкаТаблицы",			Макет.ПолучитьОбласть("ШапкаТаблицы"));
	Области.Вставить("СтрокаТаблицы",			Макет.ПолучитьОбласть("СтрокаТаблицы"));
	
	//---
	// Реализация всего
	//---
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("Сумма", Расшифровка["ТаблицаВсего"].Итог("СуммаРеализации"));
	
	Области.ЗаголовокВсего.Параметры.Заполнить(ЗначенияПараметров);
	
	ТабДокумент.Вывести(Области.ЗаголовокВсего);
	
	Если Расшифровка["ТаблицаВсего"].Количество() > 0 Тогда
		
		ТабДокумент.НачатьГруппуСтрок(, Истина);
		
		ТекущийНомерГруппы = 0;
		
		НомерСтроки = 0;
		
		НПП = 0;
		
		Для Каждого СтрокаТаблицы Из Расшифровка["ТаблицаВсего"] Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			НПП = НПП + 1;
			
			НачаласьНоваяГруппа = (ТекущийНомерГруппы <> СтрокаТаблицы["НомерГруппы"]);
			
			Если НачаласьНоваяГруппа Тогда
				
				ТекущийНомерГруппы = СтрокаТаблицы["НомерГруппы"];
				
				НПП = 1;
				
				ТабДокумент.Вывести(Области["ЗаголовокВсегоГруппа" + ТекущийНомерГруппы]);
				
				ТабДокумент.Вывести(Области.ШапкаТаблицы);
				
			КонецЕсли;
			
			ЗначенияПараметров = Новый Структура();
			ЗначенияПараметров.Вставить("НПП",		НПП);
			ЗначенияПараметров.Вставить("Документ",	СтрокаТаблицы["Регистратор"]);
			ЗначенияПараметров.Вставить("Сумма",	СтрокаТаблицы["СуммаРеализации"]);
			
			Области.СтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
			
			ТабДокумент.Вывести(Области.СтрокаТаблицы);
			
		КонецЦикла;
		
		ТабДокумент.ЗакончитьГруппуСтрок();
		
	КонецЕсли;
	
	//---
	// Реализация облагаемая
	//---
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("Сумма", Расшифровка["ТаблицаОблагаемая"].Итог("СуммаБезНДС"));
	
	Области.ЗаголовокОблагаемая.Параметры.Заполнить(ЗначенияПараметров);
	
	ТабДокумент.Вывести(Области.ЗаголовокОблагаемая);
	
	Если Расшифровка["ТаблицаОблагаемая"].Количество() > 0 Тогда
		
		ТабДокумент.НачатьГруппуСтрок(, Ложь);
		
		ТабДокумент.Вывести(Области.ШапкаТаблицы);
		
		НомерСтроки = 0;
		
		Для Каждого СтрокаТаблицы Из Расшифровка["ТаблицаОблагаемая"] Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			ЗначенияПараметров = Новый Структура();
			ЗначенияПараметров.Вставить("НПП",		НомерСтроки);
			ЗначенияПараметров.Вставить("Документ",	СтрокаТаблицы["Регистратор"]);
			ЗначенияПараметров.Вставить("Сумма",	СтрокаТаблицы["СуммаБезНДС"]);
			
			Области.СтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
			
			ТабДокумент.Вывести(Области.СтрокаТаблицы);
			
		КонецЦикла;
		
		ТабДокумент.ЗакончитьГруппуСтрок();
		
	КонецЕсли;
	
	//---
	// Сумма налога
	//---
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("Сумма", Расшифровка["ТаблицаОблагаемая"].Итог("СуммаНДС"));
	
	Области.ЗаголовокНДС.Параметры.Заполнить(ЗначенияПараметров);
	
	ТабДокумент.Вывести(Области.ЗаголовокНДС);
	
	Если Расшифровка["ТаблицаОблагаемая"].Количество() > 0 Тогда
		
		ТабДокумент.НачатьГруппуСтрок(, Ложь);
		
		ТабДокумент.Вывести(Области.ШапкаТаблицы);
		
		НомерСтроки = 0;
		
		Для Каждого СтрокаТаблицы Из Расшифровка["ТаблицаОблагаемая"] Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			ЗначенияПараметров = Новый Структура();
			ЗначенияПараметров.Вставить("НПП",		НомерСтроки);
			ЗначенияПараметров.Вставить("Документ",	СтрокаТаблицы["Регистратор"]);
			ЗначенияПараметров.Вставить("Сумма",	СтрокаТаблицы["СуммаНДС"]);
			
			Области.СтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
			
			ТабДокумент.Вывести(Области.СтрокаТаблицы);
			
		КонецЦикла;
		
		ТабДокумент.ЗакончитьГруппуСтрок();
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

