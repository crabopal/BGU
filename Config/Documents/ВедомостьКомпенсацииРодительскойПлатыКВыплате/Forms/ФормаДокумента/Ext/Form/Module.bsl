&НаКлиенте
Процедура ОтметкаУдаляемыхНастроекКомпенсации(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьСтрокиНастроекКомпенсацииНаСервере(ОбщегоНазначенияКлиентСервер.ОтмеченныеЭлементы(Результат));
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиНастроекКомпенсацииНаСервере(УдаляемыеНастройкиКомпенсации)
	
	УдаляемыеСтроки = Новый Массив;
	Для Каждого УдаляемаяНастройка Из УдаляемыеНастройкиКомпенсации Цикл
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(УдаляемыеСтроки,
			Объект.ВедомостьКомпенсации.НайтиСтроки(Новый Структура("НастройкаКомпенсации", УдаляемаяНастройка)));
	КонецЦикла;
	
	Для Каждого Строка Из УдаляемыеСтроки Цикл
		Объект.ВедомостьКомпенсации.Удалить(Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ИспользуемыеНастройкиКомпенсации()
	
	ТаблицаНастроек = Объект.ВедомостьКомпенсации.Выгрузить(, "НастройкаКомпенсации");
	ТаблицаНастроек.Свернуть("НастройкаКомпенсации");

	ИспользуемыеНастройки = Новый СписокЗначений;
	ИспользуемыеНастройки.ЗагрузитьЗначения(ТаблицаНастроек.ВыгрузитьКолонку("НастройкаКомпенсации"));
	
	Возврат ИспользуемыеНастройки;
КонецФункции

&НаСервере
Процедура ЗаполнитьДобавленныеКолонки()
	
	НастройкиКомпенсации = Объект.ВедомостьКомпенсации.Выгрузить(,"НастройкаКомпенсации");
	НастройкиКомпенсации.Свернуть("НастройкаКомпенсации");
	
	ДанныеНастроек = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(НастройкиКомпенсации.ВыгрузитьКолонку("НастройкаКомпенсации"),
		"РасчетКомпенсацииНеЗависитОтБазы");
	
	Для Каждого СтрокаКомпенсации Из Объект.ВедомостьКомпенсации Цикл
		СтрокаКомпенсации.НеЗависитОтБазы = ДанныеНастроек.Получить(СтрокаКомпенсации.НастройкаКомпенсации) = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	РодительскаяПлата.УстановитьУсловноеОформлениеПроцентКомпенсацииНеЗависитОтБазы(ЭтотОбъект, "ВедомостьКомпенсации");
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()

	РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставление(ЭтаФорма, "Объект.НачалоПериода", "НачалоПериодаСтрокой");
	РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставление(ЭтаФорма, "Объект.КонецПериода", "КонецПериодаСтрокой");
	УстановитьВидимостьПоПериодуРасчета(ЭтотОбъект);
	УстановитьПредупреждение(ЭтотОбъект);
	УстановитьСвязи();
	ВидимостьЗаголовкиГрупп(ЭтотОбъект);
	УстановитьВидимостьГруппыДетскогоУчреждения(ЭтотОбъект);
	УстановитьВидимостьДетскогоУчреждения(ЭтотОбъект);
	УстановитьИтогПоТЧ();
	ЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииГруппыДетскогоУчрежденияНаСервре()
	ПриИзмененииОтбора("ГруппаДетскогоУчреждения");
	УстановитьИтогПоТЧ();
	УстановитьВидимостьГруппыДетскогоУчреждения(ЭтотОбъект);
	ВидимостьЗаголовкиГрупп(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура УстановитьИтогПоТЧ()
	ИтогПоТЧ = ПолучитьСуммуДокумента() - Объект.СуммаДокумента;	
КонецПроцедуры

&НаСервере
Функция ПолучитьСуммуДокумента()
	ИтогТаблицы = Объект.ВедомостьКомпенсации.Итог("СуммаКомпенсации");
	ТабАннулировано = Объект.ВедомостьКомпенсации.Выгрузить(Новый Структура("Аннулировано", Истина), "СуммаКомпенсации");
	ИтогАннулировано = ТабАннулировано.Итог("СуммаКомпенсации");
	
	Возврат ИтогТаблицы - ИтогАннулировано;
КонецФункции

