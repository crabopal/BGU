#Область ОбработчикиОповещений

&НаКлиенте
Процедура ЗапроситьЗаполнениеПоДокументуРасчета(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДокументПоРасчетуКомпенсации();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьВыборТипаДокумента(ВыбранныйТип, ДопПараметры) Экспорт
	Если ВыбранныйТип <> Неопределено Тогда
		Если Модифицированность Или Объект.Ссылка.Пустая() Тогда
			ТекстВопроса = СтроковыеФункцииКлиентСервер
									.ПодставитьПараметрыВСтроку(НСтр("ru='Данные еще не записаны.
																|Выполнение действия ""%1: создать на основании"" возможно только после записи данных.
																|Данные будут записаны.'"), ВыбранныйТип.Представление);
																
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ВыбранныйТип", ВыбранныйТип);
			
			Оповещение = Новый ОписаниеОповещения("ЗапроситьЗаписьДокумента", ЭтотОбъект, ДопПараметры);
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , КодВозвратаДиалога.ОК);
		Иначе
			СоздатьДокументНаОсновании(ВыбранныйТип);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьЗаписьДокумента(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.ОК Тогда
		Если Записать() Тогда
			СоздатьДокументНаОсновании(ДопПараметры.ВыбранныйТип);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередВыборомБанка(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.КассовыйОрган);
	
	ОткрытьФорму("Справочник.Банки.Форма.ФормаВыбора", ПараметрыФормы, Элементы.КассовыйОрган, , , , , РежимОткрытияокнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТабличнойЧастиВедомостьКомпенсации

&НаКлиенте
Процедура ВедомостьКомпенсацииПриИзменении(Элемент)
	Если Элементы.ВедомостьКомпенсации.ТекущиеДанные = Неопределено Тогда
		УстановитьПредупреждение(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВедомостьКомпенсацииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущаяСтрока = Элементы.ВедомостьКомпенсации.ТекущиеДанные;
		Если Копирование Тогда
			ТекущаяСтрока.Договор            = Неопределено;
			ТекущаяСтрока.НастройкаКомпенсации = Неопределено;
			ТекущаяСтрока.ПроцентКомпенсации = 0;
			ТекущаяСтрока.СуммаКомпенсации   = 0;
		Иначе
			ТекущаяСтрока.ДетскоеУчреждение        = Объект.ДетскоеУчреждение;
			ТекущаяСтрока.ГруппаДетскогоУчреждения = Объект.ГруппаДетскогоУчреждения;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВедомостьКомпенсацииРебенокНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", ?(ЗначениеЗаполнено(Объект.ДетскоеУчреждение), Объект.ДетскоеУчреждение, Объект.Организация));
	ПараметрыФормы.Вставить("ГруппаДетскогоУчреждения", Объект.ГруппаДетскогоУчреждения);
	ПараметрыФормы.Вставить("НаДату", НачалоДня(Объект.НачалоПериода));
	
	ОткрытьФорму("Справочник.Дети.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ВедомостьКомпенсацииРебенокПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ВедомостьКомпенсации.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ЗаполнитьПараметрыКомпенсации(ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ВедомостьКомпенсацииПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
