Процедура УстановитьВидимостьДетскогоУчреждения(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ВедомостьКомпенсацииДетскоеУчреждение",
		"Видимость", Не ЗначениеЗаполнено(Форма.Объект.ДетскоеУчреждение));
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьГруппыДетскогоУчреждения(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ВедомостьКомпенсацииГруппаДетскогоУчреждения",
		"Видимость", Не ЗначениеЗаполнено(Форма.Объект.ГруппаДетскогоУчреждения));
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПоПериодуРасчета(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КонецПериодаСтрокой",
		"Видимость", Форма.Объект.РасчетЗаНесколькоМесяцев);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредупреждение(Форма)

	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("Организация");
	ИменаЭлементов.Добавить("ДетскоеУчреждение");
	ИменаЭлементов.Добавить("ГруппаДетскогоУчреждения");
	ИменаЭлементов.Добавить("КонецПериодаСтрокой");
	ИменаЭлементов.Добавить("НачалоПериодаСтрокой");
	ИменаЭлементов.Добавить("Дата");
	ИменаЭлементов.Добавить("НачислениеКомпенсации");
	ИменаЭлементов.Добавить("ИФО");
	ИменаЭлементов.Добавить("Подразделение");
	ИменаЭлементов.Добавить("НаправлениеДеятельности");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(
		Форма.Элементы,
		ИменаЭлементов,
		"ОтображениеПредупрежденияПриРедактировании",
		?(Форма.Объект.ВедомостьКомпенсации.Количество() > 0,
			ОтображениеПредупрежденияПриРедактировании.Отображать,
			ОтображениеПредупрежденияПриРедактировании.НеОтображать));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеНачалаПериода(Элемент)
	
	НовоеЗначение = Неопределено;
	
	Если НЕ Объект.РасчетЗаНесколькоМесяцев Тогда
		
		Если НЕ КонецМесяца(Объект.НачалоПериода) = КонецМесяца(Объект.КонецПериода) Тогда
			
			НовоеЗначение =  КонецМесяца(Объект.НачалоПериода);
			
		КонецЕсли;
		
	Иначе
		
		Если КонецМесяца(Объект.НачалоПериода) >  КонецМесяца(Объект.КонецПериода) Тогда
			
			НовоеЗначение =  КонецМесяца(Объект.НачалоПериода);
			
		КонецЕсли;

	КонецЕсли;	
	
	Если НЕ НовоеЗначение = Неопределено Тогда
		
		Объект.КонецПериода = НовоеЗначение;
		
		РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставление(ЭтаФорма, "Объект.КонецПериода", "КонецПериодаСтрокой", Ложь);

	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработатьИзменениеОкончанияПериода(Элемент)
	
	НовоеЗначение = Неопределено;
	
	Если КонецМесяца(Объект.НачалоПериода) >  КонецМесяца(Объект.КонецПериода) Тогда
			
			НовоеЗначение =  НачалоМесяца(Объект.КонецПериода);
			
	КонецЕсли;

	
	Если НЕ НовоеЗначение = Неопределено Тогда
		
		Объект.НачалоПериода = НовоеЗначение;
		
		РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставление(ЭтаФорма, "Объект.НачалоПериода", "НачалоПериодаСтрокой", Ложь);
		
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ПриИзмененииОтбора(ИмяРеквизита)

	НужныеСтроки = Объект.ВедомостьКомпенсации.Выгрузить(Новый Структура(ИмяРеквизита, Объект[ИмяРеквизита]));
	
	Объект.ВедомостьКомпенсации.Загрузить(НужныеСтроки);
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтветственныхЛиц(Организация, Подразделение, Дата, ГлБухгалтер)

	ГлБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Главный бухгалтер", 
																					Организация,
										                                            Дата, Подразделение).ОтветственноеЛицоСсылка;

КонецПроцедуры // УстановитьОтветственныхЛиц()

&НаСервере
Процедура ЗаполнитьПараметрыКомпенсации(ИдентификаторСтроки)
	
	ТекущиеДанные = Объект.ВедомостьКомпенсации.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ДанныеПлательщика = РегистрыСведений.ПлательщикиПоУслугамДДУ.ДанныеПлательщикаРебенка(Объект.Дата, Объект.Организация, ТекущиеДанные.Ребенок);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеПлательщика);
	
	СтавкиКомпенсации = РегистрыСведений.ПараметрыКомпенсацииРодительскойПлатыПоДетям.ПараметрыНаДату(Объект.Дата, ТекущиеДанные.Ребенок);
	
	Если ЗначениеЗаполнено(ТекущиеДанные.НастройкаКомпенсации) Тогда
		
		Отбор = Новый Структура("НастройкаКомпенсации", ТекущиеДанные.НастройкаКомпенсации);
		СтавкиПоНастройке = СтавкиКомпенсации.НайтиСтроки(Отбор);
		Если СтавкиПоНастройке.Количество() = 1 Тогда
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтавкиПоНастройке[0]);
		КонецЕсли;
	
	Иначе
		
		Отбор = Новый Структура("Ребенок", ТекущиеДанные.Ребенок);
		ИспользованныеСтавки = Объект.ВедомостьКомпенсации.Выгрузить(Отбор, "НастройкаКомпенсации").ВыгрузитьКолонку("НастройкаКомпенсации");
		
		Для Каждого СтрокаСтавки Из СтавкиКомпенсации Цикл
			Если ИспользованныеСтавки.Найти(СтрокаСтавки.НастройкаКомпенсации) = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтрокаСтавки);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ТекущиеДанные.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущиеДанные.Ребенок, "Контрагент");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличнуюЧасть()
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ЗаполнитьДокументПоРасчетуКомпенсации();
	Иначе
		ЗаполнитьДокументПоОстаткам();
	КонецЕсли;
	УстановитьИтогПоТЧ();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументПоРасчетуКомпенсации()
	
	ДанныеНачисления = Документы.ВедомостьКомпенсацииРодительскойПлатыКВыплате.ПолучитьДанныеНачисленияКомпенсации(
		Объект.ДокументОснование, Объект.КассовыйОрган);
	
	ЗаполнитьЗначенияСвойств(Объект, ДанныеНачисления.Шапка);
	Объект.ВедомостьКомпенсации.Загрузить(ДанныеНачисления.ВедомостьКомпенсации);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументПоОстаткам()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УчетКомпенсации.ДетскоеУчреждение КАК ДетскоеУчреждение,
	|	УчетКомпенсации.ИФО КАК ИФО,
	|	СоставГрупп.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	СоставГрупп.Договор КАК Договор,
	|	УчетКомпенсации.Ребенок КАК Ребенок,
	|	УчетКомпенсации.Ребенок.Контрагент КАК Контрагент,
	|	УчетКомпенсации.Плательщик КАК Плательщик,
	|	УчетКомпенсации.ПроцентКомпенсации КАК ПроцентКомпенсации,
	|	УчетКомпенсации.НастройкаКомпенсации КАК НастройкаКомпенсации,
	|	УчетКомпенсации.КПС,
	|	УчетКомпенсации.КФО,
	|	УчетКомпенсации.СуммаКомпенсацииОстаток КАК СуммаКомпенсации
	|ПОМЕСТИТЬ втУчетКомпенсации
	|ИЗ
	|	РегистрНакопления.УчетКомпенсацииРодительскойПлаты.Остатки(&НачалоПериода, Организация = &Организация
	|	И &УсловиеИФО И &УсловиеДетскоеУчреждение) КАК УчетКомпенсации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставГруппДДУ.СрезПоследних(&НачалоПериода, &УсловиеОрганизацияРебенка) КАК
	|			СоставГрупп
	|		ПО УчетКомпенсации.ДетскоеУчреждение = СоставГрупп.Ребенок.Организация
	|		И УчетКомпенсации.Ребенок = СоставГрупп.Ребенок
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УчетКомпенсации.ДетскоеУчреждение,
	|	УчетКомпенсации.ИФО,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(УчетКомпенсации.Регистратор) = ТИП(Документ.НачислениеКомпенсацииРодительскойПлаты)
	|			ТОГДА ТаблицаНачислений.ГруппаДетскогоУчреждения
	|		КОГДА ТИПЗНАЧЕНИЯ(УчетКомпенсации.Регистратор) = ТИП(Документ.ВедомостьКомпенсацииРодительскойПлатыКВыплате)
	|			ТОГДА ВедомостьКомпенсации.ГруппаДетскогоУчреждения
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(УчетКомпенсации.Регистратор) = ТИП(Документ.НачислениеКомпенсацииРодительскойПлаты)
	|			ТОГДА ТаблицаНачислений.Договор
	|		КОГДА ТИПЗНАЧЕНИЯ(УчетКомпенсации.Регистратор) = ТИП(Документ.ВедомостьКомпенсацииРодительскойПлатыКВыплате)
	|			ТОГДА ВедомостьКомпенсации.Договор
	|	КОНЕЦ,
	|	УчетКомпенсации.Ребенок,
	|	УчетКомпенсации.Ребенок.Контрагент,
	|	УчетКомпенсации.Плательщик,
	|	УчетКомпенсации.ПроцентКомпенсации,
	|	УчетКомпенсации.НастройкаКомпенсации,
	|	УчетКомпенсации.КПС,
	|	УчетКомпенсации.КФО,
	|	УчетКомпенсации.СуммаКомпенсацииОборот
	|ИЗ
	|	РегистрНакопления.УчетКомпенсацииРодительскойПлаты.Обороты(&НачалоПериода, &КонецПериода, Регистратор,
	|		Организация = &Организация
	|	И &УсловиеИФО И &УсловиеДетскоеУчреждение) КАК УчетКомпенсации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВедомостьКомпенсацииРодительскойПлатыКВыплате.ВедомостьКомпенсации КАК
	|			ВедомостьКомпенсации
	|		ПО УчетКомпенсации.Регистратор = ВедомостьКомпенсации.Ссылка
	|		И УчетКомпенсации.ДетскоеУчреждение = ВедомостьКомпенсации.ДетскоеУчреждение
	|		И УчетКомпенсации.Ребенок = ВедомостьКомпенсации.Ребенок
	|		И УчетКомпенсации.НастройкаКомпенсации = ВедомостьКомпенсации.НастройкаКомпенсации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеКомпенсацииРодительскойПлаты.Начисления КАК ТаблицаНачислений
	|		ПО УчетКомпенсации.Регистратор = ТаблицаНачислений.Ссылка
	|		И УчетКомпенсации.ДетскоеУчреждение = ТаблицаНачислений.ДетскоеУчреждение
	|		И УчетКомпенсации.Ребенок = ТаблицаНачислений.Ребенок
	|		И УчетКомпенсации.НастройкаКомпенсации = ТаблицаНачислений.НастройкаКомпенсации
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПлательщикиПоУслугамДДУСрезПоследних.Ребенок,
	|	ПлательщикиПоУслугамДДУСрезПоследних.СчетПлательщика
	|ПОМЕСТИТЬ ДанныеПлательщиков
	|ИЗ
	|	РегистрСведений.ПлательщикиПоУслугамДДУ.СрезПоследних(&КонецПериода, Ребенок В
	|		(ВЫБРАТЬ
	|			втУчетКомпенсации.Ребенок
	|		ИЗ
	|			втУчетКомпенсации КАК втУчетКомпенсации)) КАК ПлательщикиПоУслугамДДУСрезПоследних
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втУчетКомпенсации.ДетскоеУчреждение КАК ДетскоеУчреждение,
	|	втУчетКомпенсации.ИФО КАК ИФО,
	|	втУчетКомпенсации.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	втУчетКомпенсации.Договор КАК Договор,
	|	втУчетКомпенсации.Ребенок КАК Ребенок,
	|	втУчетКомпенсации.Контрагент КАК Контрагент,
	|	втУчетКомпенсации.Плательщик КАК Плательщик,
	|	втУчетКомпенсации.ПроцентКомпенсации КАК ПроцентКомпенсации,
	|	ЛОЖЬ КАК Аннулировано,
	|	ЕСТЬNULL(ДанныеПлательщиков.СчетПлательщика, ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка)) КАК
	|		СчетПлательщика,
	|	СУММА(втУчетКомпенсации.СуммаКомпенсации) КАК СуммаКомпенсации,
	|	втУчетКомпенсации.НастройкаКомпенсации,
	|	ЕстьNULL(втУчетКомпенсации.НастройкаКомпенсации.РасчетКомпенсацииНеЗависитОтБазы, ЛОЖЬ) КАК НеЗависитОтБазы,
	|	втУчетКомпенсации.КПС,
	|	втУчетКомпенсации.КФО
	|ИЗ
	|	втУчетКомпенсации КАК втУчетКомпенсации
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПлательщиков КАК ДанныеПлательщиков
	|		ПО втУчетКомпенсации.Ребенок = ДанныеПлательщиков.Ребенок
	|ГДЕ
	|	&УсловиеГруппа
	|	И &УсловиеНаправлениеДеятельности
	|	И &УсловиеКассовыйОрган
	|СГРУППИРОВАТЬ ПО
	|	втУчетКомпенсации.ДетскоеУчреждение,
	|	втУчетКомпенсации.ИФО,
	|	втУчетКомпенсации.ГруппаДетскогоУчреждения,
	|	втУчетКомпенсации.Договор,
	|	втУчетКомпенсации.Ребенок,
	|	втУчетКомпенсации.Контрагент,
	|	втУчетКомпенсации.Плательщик,
	|	втУчетКомпенсации.ПроцентКомпенсации,
	|	втУчетКомпенсации.НастройкаКомпенсации,
	|	втУчетКомпенсации.КПС,
	|	втУчетКомпенсации.КФО,
	|	ЛОЖЬ,
	|	ЕСТЬNULL(ДанныеПлательщиков.СчетПлательщика, ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка)),
	|	ЕстьNULL(втУчетКомпенсации.НастройкаКомпенсации.РасчетКомпенсацииНеЗависитОтБазы, ЛОЖЬ)";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	Если ЗначениеЗаполнено(Объект.ДетскоеУчреждение) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДетскоеУчреждение", "ДетскоеУчреждение = &ДетскоеУчреждение");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизацияРебенка", "Ребенок.Организация = &ДетскоеУчреждение");
		Запрос.УстановитьПараметр("ДетскоеУчреждение", Объект.ДетскоеУчреждение);
	Иначе				   
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДетскоеУчреждение", "ИСТИНА");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизацияРебенка", "ИСТИНА");
	КонецЕсли;
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Если ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
	Иначе				   
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ГруппаДетскогоУчреждения) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеГруппа", "ГруппаДетскогоУчреждения = &ГруппаДетскогоУчреждения");
		Запрос.УстановитьПараметр("ГруппаДетскогоУчреждения", Объект.ГруппаДетскогоУчреждения);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеГруппа", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.НаправлениеДеятельности) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаправлениеДеятельности", "втУчетКомпенсации.Договор.НаправлениеДеятельности = &НаправлениеДеятельности");
		Запрос.УстановитьПараметр("НаправлениеДеятельности", Объект.НаправлениеДеятельности);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаправлениеДеятельности", "ИСТИНА");
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.КассовыйОрган) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКассовыйОрган", "ЕстьNULL(ДанныеПлательщиков.СчетПлательщика.КассовыйОрган, ЗНАЧЕНИЕ(Справочник.Банки.ПустаяСсылка)) = &КассовыйОрган");
		Запрос.УстановитьПараметр("КассовыйОрган", Объект.КассовыйОрган);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКассовыйОрган", "ИСТИНА");
	КонецЕсли;
			
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Объект.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Объект.КонецПериода));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Объект.ВедомостьКомпенсации.Загрузить(Результат);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументНаОсновании(ВыбранныйТип)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Основание", Объект.Ссылка);
			
	ОткрытьФорму("Документ." + ВыбранныйТип + ".ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияЗаписиДокумента(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.ОК Тогда
		Если Записать() Тогда
			СоздатьДокументНаОсновании(ДопПараметры);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьСвязи()
	Если ЗначениеЗаполнено(Объект.ДетскоеУчреждение) Тогда
		Связь = Новый СвязьПараметраВыбора("Организация", "Объект.ДетскоеУчреждение");
		СвязьДляГруппы = Новый СвязьПараметраВыбора("Отбор.Владелец", "Объект.ДетскоеУчреждение");
	Иначе
		Связь = Новый СвязьПараметраВыбора("Организация", "Объект.Организация");
		СвязьДляГруппы = Новый СвязьПараметраВыбора("Отбор.Владелец", "Объект.Организация");
	КонецЕсли;
	МассивСвязей = Новый Массив;
	МассивСвязей.Добавить(Связь);
	
	МассивСвязейДляГруппы = Новый Массив;
	МассивСвязейДляГруппы.Добавить(СвязьДляГруппы);
	
	Элементы.НастройкаВыгрузки.СвязиПараметровВыбора = Новый ФиксированныйМассив(МассивСвязей);
	Элементы.ГруппаДетскогоУчреждения.СвязиПараметровВыбора = Новый ФиксированныйМассив(МассивСвязейДляГруппы);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьЗаголовкиГрупп(Форма)
	
	ВидимостьКолонкиДетскоеУчреждение = ОбщегоНазначенияКлиентСервер.ЗначениеСвойстваЭлементаФормы(
		Форма.Элементы, "ВедомостьКомпенсацииДетскоеУчреждение", "Видимость") = Истина;
	ВидимостьКолонкиГруппаДетскогоУчреждения = ОбщегоНазначенияКлиентСервер.ЗначениеСвойстваЭлементаФормы(
		Форма.Элементы, "ВедомостьКомпенсацииГруппаДетскогоУчреждения", "Видимость") = Истина;
													
	Если ВидимостьКолонкиДетскоеУчреждение И ВидимостьКолонкиГруппаДетскогоУчреждения Тогда
		ЗаголовокЭлемента = НСтр("ru='Детское учреждение, группа по услугам'");
	ИначеЕсли ВидимостьКолонкиДетскоеУчреждение Тогда
		ЗаголовокЭлемента = НСтр("ru='Детское учреждение'");
	Иначе
		ЗаголовокЭлемента = НСтр("ru='Группа по услугам'");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаУчреждениеГруппа",
		"Заголовок", ЗаголовокЭлемента); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаУчреждениеГруппа",
		"Видимость", (ВидимостьКолонкиДетскоеУчреждение Или ВидимостьКолонкиГруппаДетскогоУчреждения));
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьНастройкуВыгрузкиПоУмолчанию()
	
	Объект.НастройкаВыгрузки = Справочники.НастройкиВыгрузкиКомпенсацииРодительскойПлаты.ПолучитьНастройкуВыгрузкиПоУмолчанию(
		?(ЗначениеЗаполнено(Объект.ДетскоеУчреждение), Объект.ДетскоеУчреждение, Объект.Организация),
		"Документ.ВедомостьКомпенсацииРодительскойПлатыКВыплате",
		Объект.КассовыйОрган);
	
КонецПроцедуры

&НаСервере
Процедура ДетскоеУчреждениеПриИзмененииНаСервере()
	
	ПолучитьНастройкуВыгрузкиПоУмолчанию();
	
	ПриИзмененииОтбора("ДетскоеУчреждение");
	УстановитьИтогПоТЧ();
	УстановитьВидимостьДетскогоУчреждения(ЭтотОбъект);
	
	УстановитьСвязи();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКомандПрикрепления(Элементы, Прикреплен)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаПриложитьКСуществующемуДокументу", "Доступность", НЕ Прикреплен);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ФормаОткрепитьОтДокумента", "Доступность", Прикреплен);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКомандыПрикрепления()
	
	Для Каждого ТипДокумента ИЗ СписокТиповДокументовВводимыхНаОсновании Цикл
		
		ИмяКоманды = "СвязатьСДокументом" + ТипДокумента.Значение;
		
		НоваяКоманда = Команды.Добавить(ИмяКоманды);
		НоваяКоманда.Действие = "Подключаемый_ПриложитьКСуществующемуДокументу";
		НоваяКоманда.Заголовок = ТипДокумента.Представление;
		НоваяКоманда.Картинка = БиблиотекаКартинок.Документ;
		НоваяКоманда.Отображение = ОтображениеКнопки.КартинкаИТекст;
		
		НоваяКнопка = Элементы.Добавить("Кнопка" + ИмяКоманды,
										Тип("КнопкаФормы"),
										Элементы.ГруппаПриложитьКСуществующемуДокументу);
		НоваяКнопка.ИмяКоманды = ИмяКоманды;
		НоваяКнопка.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПослеВыбораТипаДокументаДляПрикрепления(ВыбранныйТип)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Или Объект.Ссылка.Пустая() Тогда
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Данные еще не записаны.
			|Выполнение действия ""Приложить ведомость к документу: %1"" возможно только после записи данных.
			|Данные будут записаны.'"), ВыбранныйТип.Представление);
		
		Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияЗаписиДокументаПередПриложениемКДокументу", ЭтотОбъект, ВыбранныйТип.Значение);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , КодВозвратаДиалога.ОК);
	Иначе
		ОткрытьФорму("Документ." + ВыбранныйТип.Значение + ".ФормаВыбора", , ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияЗаписиДокументаПередПриложениемКДокументу(Ответ, ДополнительныеПараметры) Экспорт
	
	Если НЕ Ответ = КодВозвратаДиалога.ОК Тогда
		Возврат
	КонецЕсли;
	
	Если Записать() Тогда
		ОткрытьФорму("Документ." + ДополнительныеПараметры + ".ФормаВыбора", , ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьНадписьПлатежныйДокумент(Надпись, Документ, Элементы)
	
	Если ЗначениеЗаполнено(Документ) Тогда
		ЗаголовокТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Ведомость является приложением к документу %1'"), Документ);
		Надпись = ЗаголовокТекст;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "Перезаполнить", "Видимость", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "НадписьПлатежныйДокумент", "МаксимальнаяШирина", 0);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "НадписьПриложитьКСуществующемуДокументу", "Видимость", Ложь);
	Иначе
		Надпись = НСтр("ru='<Создать расчетно-платежный документ...>'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "Перезаполнить", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "НадписьПлатежныйДокумент", "МаксимальнаяШирина", 30);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "НадписьПриложитьКСуществующемуДокументу", "Видимость", Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораТипаДокумента(ВыбранныйТип, ДопПараметры) Экспорт
	
	Если ВыбранныйТип = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Или Объект.Ссылка.Пустая() Тогда
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Данные еще не записаны.
			|Выполнение действия ""Создать на основании: %1"" возможно только после записи данных.
			|Данные будут записаны.'"), ВыбранныйТип.Представление);
		
		Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияЗаписиДокумента", ЭтотОбъект, ВыбранныйТип.Значение);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , КодВозвратаДиалога.ОК);
	Иначе
		СоздатьДокументНаОсновании(ВыбранныйТип.Значение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораТипаДокументаДляПрикрепления(ВыбранныйТип, ДопПараметры) Экспорт
	
	Если ВыбранныйТип = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьПослеВыбораТипаДокументаДляПрикрепления(ВыбранныйТип);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДокументОснованиеПлатежногоДокумента(ПлатежныйДокумент)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежныйДокумент, "ДокументОснование");
	
КонецФункции

&НаКлиенте
Асинх Процедура ОбработкаВыбораПлатежногоДокументаНаКлиентеАсинх(ВыбранноеЗначение)

	ОчиститьСообщения();

	ТекущийДокументОснование = ДокументОснованиеПлатежногоДокумента(ВыбранноеЗначение);
	Если ЗначениеЗаполнено(ТекущийДокументОснование) Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Расчетно-платежный документ ""%1"" уже связан с другим документом-основанием: ""%2""'"),
			ВыбранноеЗначение, ТекущийДокументОснование);
		ПоказатьПредупреждение( , ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ДокументВМассиве = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыбранноеЗначение);
	
	РасчетноПлатежныйДокументПроведен = ОбщегоНазначенияКлиент.ПроверитьПроведенностьДокументов(
		ДокументВМассиве).Количество() = 0;
		
	Если РасчетноПлатежныйДокументПроведен Тогда
		
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить("Перепровести", "Перепровести");
		СписокКнопок.Добавить("НеПерепроводить", "Не перепроводить");
		СписокКнопок.Добавить("ОтменитьПроведение", "Отменить проведение");
		СписокКнопок.Добавить("Отмена", "Отмена");
		
		ТекстВопроса = СтрШаблон(НСтр("ru='Выбранный документ ""%1"" уже проведен.
			|Выберите одно из возможных действий после прикрепления ведомости.'"),
			ВыбранноеЗначение);

		Ответ = Ждать ВопросАсинх(ТекстВопроса, СписокКнопок);
		
		Если Ответ = "Перепровести" Тогда
			РежимЗаписи = РежимЗаписиДокумента.Проведение;
		ИначеЕсли Ответ = "НеПерепроводить" Тогда
			РежимЗаписи = РежимЗаписиДокумента.Запись;
		ИначеЕсли Ответ = "ОтменитьПроведение" Тогда
			РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
		Иначе
			Возврат;
		КонецЕсли;
		
	Иначе
		РежимЗаписи = РежимЗаписиДокумента.Запись;
	КонецЕсли;	

	ЗаблокироватьДанныеФормыДляРедактирования();
	Результат = ПрикрепитьВедомостьКПлатежноРасчетномуДокументу(Объект.Ссылка, ВыбранноеЗначение, РежимЗаписи);
	РазблокироватьДанныеФормыДляРедактирования();
	
	Если Результат.Ошибка Тогда
		
		ЗаголовокОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось приложить ведомость ""%1"" к расчетно-платежному документу ""%2"":'"),
				Объект.Ссылка, ВыбранноеЗначение);
	    Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(Результат.ИнформацияОбОшибке, ЗаголовокОшибки);
	    
	    Если ЗначениеЗаполнено(Уточнение.Категория) Тогда
			ОбработкаОшибок.ПоказатьИнформациюОбОшибке(Результат.ИнформацияОбОшибке, Уточнение.Текст);
	    Иначе
	    	ПоказатьПредупреждение(, Уточнение.Текст);
	    КонецЕсли;

		Возврат;
	КонецЕсли;

	РасчетноПлатежныйДокумент = ВыбранноеЗначение;
	ОповеститьОбИзменении(РасчетноПлатежныйДокумент);

	УстановитьДоступностьКомандПрикрепления(Элементы, ЗначениеЗаполнено(РасчетноПлатежныйДокумент));
	ОбновитьНадписьПлатежныйДокумент(НадписьРасчетноПлатежныйДокумент, РасчетноПлатежныйДокумент, Элементы);

	ТекстВопроса = НСтр("ru='Ведомость прикреплена к расчетно-платежному документу.'");
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ТекстВопроса = ТекстВопроса + НСтр("ru='
		|Выполнено перепроведение расчетно-платежного документа.'");
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ТекстВопроса = ТекстВопроса + НСтр("ru='
		|Выполнена отмена проведения расчетно-платежного документа.'");
	КонецЕсли;
	
	ТекстВопроса = ТекстВопроса + СтрШаблон(НСтр("ru='
		|Открыть ""%1""?'"), РасчетноПлатежныйДокумент);
	
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПоказатьЗначение(, РасчетноПлатежныйДокумент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрикрепитьВедомостьКПлатежноРасчетномуДокументу(Знач Ведомость, Знач ПлатежныйДокумент,	Знач РежимЗаписи)

	Возврат
		ПлатежноРасчетныеДокументы.ПрикрепитьВедомостьКПлатежноРасчетномуДокументу(Ведомость,
			ПлатежныйДокумент, РежимЗаписи);
	
КонецФункции

&НаСервереБезКонтекста
Функция ОткрепитьВедомостьНаСервере(Знач Ведомость, Знач ПлатежныйДокумент)
	
	Возврат
		ПлатежноРасчетныеДокументы.ОткрепитьВедомостьОтПлатежноРасчетногоДокумента(Ведомость,
			ПлатежныйДокумент);

КонецФункции

&НаСервере
Функция УточнитьПараметрыЗаполнения()

	Результат = Новый Структура;
	Результат.Вставить("ЗаполнитьДетализацию", Ложь);
	Результат.Вставить("ТекстПредупреждения", "");
			
	СтатусПлатежногоДокумента = БухгалтерскиеОперации.СтатусДокумента(РасчетноПлатежныйДокумент);
	
	Если ЗначениеЗаполнено(СтатусПлатежногоДокумента)
		И СтатусПлатежногоДокумента <> Перечисления.СтатусыИсполненияДокумента.ВРаботе Тогда
	
		Если ТипЗнч(РасчетноПлатежныйДокумент) = Тип("ДокументСсылка.РСКППеречисление") Тогда
			
			Результат.ЗаполнитьДетализацию = Истина;
			
		КонецЕсли;

		Результат.ТекстПредупреждения = СтрШаблон(НСтр("ru='Статус платежного документа: ""%1"".'"),
			СтатусПлатежногоДокумента);
	
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаСервере
Функция ПерезаполнитьПлатежныйДокументНаСервере(ПараметрыЗаполнения)

	ВедомостьОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ПлатежноРасчетныеДокументы.ПерезаполнитьПлатежныйДокументПоВедомости(ВедомостьОбъект,
		РасчетноПлатежныйДокумент, ПараметрыЗаполнения);
	ЗначениеВРеквизитФормы(ВедомостьОбъект, "Объект");
	
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ВведенныйНаОснованииРасчетноПлатежныйДокумент(Ведомость)
	Возврат ПлатежноРасчетныеДокументы.ВведенныйНаОснованииВедомостиКомпенсацииРасчетноПлатежныйДокумент(Ведомость);
КонецФункции

&НаСервереБезКонтекста
Функция СписокДокументовВводимыхНаОсновании()
	Возврат ПлатежноРасчетныеДокументы.СписокТиповДокументовНаОснованииВедомостиКомпенсации();
КонецФункции

