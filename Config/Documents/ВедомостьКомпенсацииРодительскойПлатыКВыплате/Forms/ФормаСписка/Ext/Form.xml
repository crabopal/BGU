			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.Ссылка КАК Ссылка,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.ПометкаУдаления КАК ПометкаУдаления,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.Номер КАК Номер,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.Дата КАК Дата,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.Проведен КАК Проведен,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.Организация КАК Организация,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.ИФО КАК ИФО,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.Подразделение КАК Подразделение,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.ДетскоеУчреждение КАК ДетскоеУчреждение,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.ГлБухгалтер КАК ГлБухгалтер,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.РасчетЗаНесколькоМесяцев КАК РасчетЗаНесколькоМесяцев,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.НачалоПериода КАК Начало,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.КонецПериода КАК Окончание,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.СуммаДокумента КАК СуммаДокумента,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.Комментарий КАК Комментарий,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.ВедомостьКомпенсации.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		ДетскоеУчреждение КАК ДетскоеУчреждение,
		ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
		Ребенок КАК Ребенок,
		Контрагент КАК Контрагент,
		Договор КАК Договор,
		Плательщик КАК Плательщик,
		ПроцентКомпенсации КАК ПроцентКомпенсации,
		СуммаКомпенсации КАК СуммаКомпенсации,
		Аннулировано КАК Аннулировано,
		СчетПлательщика КАК СчетПлательщика
	) КАК ВедомостьКомпенсации,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.МоментВремени КАК МоментВремени,
	ДокументВедомостьКомпенсацииРодительскойПлатыКВыплате.КассовыйОрган КАК КассовыйОрган,
	ОперацииДокументов.Операция КАК Операция,
	"с:" КАК ПериодС,
	"по:" КАК ПериодПо,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
