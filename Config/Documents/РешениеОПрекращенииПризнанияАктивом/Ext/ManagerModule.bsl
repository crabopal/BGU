	|	И НЕ Файлы.Служебный
	|	И НЕ Файлы.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеДокументов = Новый Структура;
	ДанныеДокументов.Вставить("ВыборкаДокументов"	, РезультатЗапроса[00].Выбрать());
	ДанныеДокументов.Вставить("ВыборкаОС"			, РезультатЗапроса[05].Выбрать());
	ДанныеДокументов.Вставить("ВыборкаОпись"		, РезультатЗапроса[10].Выбрать());
	ДанныеДокументов.Вставить("Драгметаллы"			, РезультатЗапроса[06].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДокументов.Вставить("ПТС"					, РезультатЗапроса[07].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДокументов.Вставить("ЕГРН"				, РезультатЗапроса[08].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДокументов.Вставить("Характеристики"		, РезультатЗапроса[09].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДокументов.Вставить("ВыборкаФайлы"		, РезультатЗапроса[11].Выбрать());
	
	Возврат ДанныеДокументов;
	
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу разделителей документов для целей формирования текущего документа 
// "Решение о прекращении прознания активом" по данным других документов
//
// Параметры:
//  - ДокОснование - ДокументСсылка - документ, по данным которого заполнияется текущий документ
//  - СсылкаЦелевогоДокумента - ДокументСсылка.РешениеОПрекращенииПризнанияАктивом - ссылка на текущий документ.
//						Следует передавать, только, если ссылка не пустая. Если передан, то данные этого 
//                      документа не учитываются, как отработанные. Передается, если документ заполняется
//                      из формы самого документа (при выборе документа-основания)
//
// Возвращаемое значение:
// 	- ТаблицаЗначений с полями:
//   * ЦМО - СправочникСсылка.ЦМО
//   * Подразделение - СправочникСсылка.Подразделения
//   * ПоИнвентарнымОбъектам - Булево
Функция ТаблицаРазделителейДокументов(ДокОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	Если ТипЗнч(ДокОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		Возврат(РазделителиДокументов_ИнвентаризационнаяОписьНФА(ДокОснование, СсылкаЦелевогоДокумента));
	КонецЕсли;	
КонецФункции	

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	ТекстЗапроса = " 
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК ДокументОтклонения,
	|	ОсновныеСредства.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	ОсновныеСредства.ОсновноеСредство КАК НФА,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.НеАктивы) КАК ВидОтклонения,
	|	ОсновныеСредства.Ссылка.ЦМО.МестоХранения КАК МестоИнвентаризации,
	|	ОсновныеСредства.Количество КАК Количество
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивом.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.ДокументИнвентаризации В(&ДокументыИнвентаризации)
	|	И НЕ ОсновныеСредства.Ссылка = &РешениеОПрекращенииПризнанияАктивомСсылка
	|	И НЕ ОсновныеСредства.Ссылка.ПометкаУдаления";
	
	Возврат ТекстЗапроса;
КонецФункции	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ГолосованиеКомиссии

Процедура ЗаполнитьРезультатГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	ЗаполнитьРезультатыГолосования = Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	Если ЗаполнитьРезультатыГолосования Тогда
		РезультатГолосованияСотрудника = ОбщегоНазначенияБГУ.РезультатыГолосованияСотрудникаПоДокументу(
			Форма.Сотрудник, Объект.Ссылка, Объект.Комиссия, Объект.Организация);
		РезультатГолосованияКомиссии = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(
			Объект.Ссылка, Объект.Комиссия, Объект.Организация);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		
		СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Неопределено;
		СтрокаТаблицы.ИтогГолосования = 0;
		СтрокаТаблицы.РезолюцияКомиссииОдобрена = Ложь;
		Если ЗаполнитьРезультатыГолосования Тогда
			
			Если РезультатГолосованияСотрудника.Количество() > 0 Тогда
				Результаты = РезультатГолосованияСотрудника.Найти(СтрокаТаблицы.ИдентификаторСтроки, "ИдентификаторСтроки");
				Если Результаты <> Неопределено Тогда
					СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Результаты.РезультатГолосования;
				КонецЕсли;
			КонецЕсли;
			
			Если РезультатГолосованияКомиссии.Количество() > 0 Тогда
				ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки",
					Объект.Ссылка, СтрокаТаблицы.ИдентификаторСтроки);
				РезультатыГолосованияПоСтроке = РезультатГолосованияКомиссии.НайтиСтроки(ОтборПоИдентификаторуСтроки);
				Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
					СтрокаТаблицы.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
					СтрокаТаблицы.РезолюцияКомиссииОдобрена = РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УправлениеЭлементамиГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;

	ДоступностьГолосования = Не Объект.Проведен;
	Если ПолучитьФункциональнуюОпцию("РезервироватьОСПриВыбытии") Тогда
		ДоступностьГолосования = Не Объект.Аннулирован
			И (Объект.Резервировать Или Не Объект.Проведен);
	КонецЕсли;
	
	ДоступностьГолосования = ДоступностьГолосования
		И Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("Сотрудник");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Доступность", ДоступностьГолосования);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("ОсновныеСредстваУстановитьРешениеЕдиногласноЗаВоВсехСтроках");
	ЭлементыГолосование.Добавить("ОсновныеСредстваУстановитьРешениеЕдиногласноПротивВоВсехСтроках");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И Не ЗначениеЗаполнено(Форма.Сотрудник));
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("ОсновныеСредстваУстановитьРешениеЗаВоВсехСтроках");
	ЭлементыГолосование.Добавить("ОсновныеСредстваУстановитьРешениеПротивВоВсехСтроках");
	ЭлементыГолосование.Добавить("ОсновныеСредстваУстановитьРешениеЗаВВыделенныхСтроках");
	ЭлементыГолосование.Добавить("ОсновныеСредстваУстановитьРешениеПротивВВыделенныхСтроках");
	ЭлементыГолосование.Добавить("ОсновныеСредстваРешениеСотрудникаПоРезолюции");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник));
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("СохранитьРезультатыГолосования");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Доступность", ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник) И Форма.РешениеСотрудникаМодифицированность);
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.РешениеОПрекращенииПризнанияАктивом";
	КомандаПечати.Идентификатор		= "Решение";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Решение о прекращении признания активами объектов НФА'"), "0510440");
	КомандаПечати.Порядок			= 1;
	
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОСодержанииДрагМатериалов", 3);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Решение") Тогда
		
		ТабличныйДокумент = НапечататьРешение(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Решение","Решение о прекращении признания активами объектов НФА (ф. 0510440)", ТабличныйДокумент);
		
	КонецЕсли;
	
КонецПроцедуры

Функция НапечататьРешение(МассивОбъектов, ОбъектыПечати)

	Возврат УправлениеПечатьюБГУ.НапечататьРешениеОПрекращенииПризнанияАктивом(МассивОбъектов, ОбъектыПечати,
		ДанныеДляПечати(МассивОбъектов));
	
КонецФункции

Функция ДанныеДляПечати(МассивОбъектов)
	
	РезультатыГолосования = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(МассивОбъектов);
	ТаблицаДокументов = УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиРешениеОПрекращенииПризнанияАктивом0510440();
	
	Для Каждого Документ Из ОбщегоНазначенияБГУ.ДокументыПоТипам(МассивОбъектов) Цикл
		МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Документ.Значение[0]);
		ДанныеДокументов = МенеджерДокумента.ДанныеДляПечати0510440(Документ.Значение);

		ВыборкаДокументов	= ДанныеДокументов.ВыборкаДокументов;
		ВыборкаОС			= ДанныеДокументов.ВыборкаОС;
		ВыборкаОпись		= ДанныеДокументов.ВыборкаОпись;
		ВыборкаФайлы		= ДанныеДокументов.ВыборкаФайлы;
		
		Данные = Новый Структура;
		Данные.Вставить("Драгметаллы"		, ДанныеДокументов.Драгметаллы);
		Данные.Вставить("ПТС"				, ДанныеДокументов.ПТС);
		Данные.Вставить("ЕГРН"				, ДанныеДокументов.ЕГРН);
		Данные.Вставить("Характеристики"	, ДанныеДокументов.Характеристики);
		Данные.Вставить("ДатаСписания"		, '00010101');
		
		Справочники.ОсновныеСредства.ИнициализироватьПараметрыДопХарактеристик(Данные);
		
		Пока ВыборкаДокументов.Следующий() Цикл
			
			СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
			
			СтрокаДокумента = ТаблицаДокументов.Добавить();
			
			// Шапка
			
			ЗаполнитьЗначенияСвойств(СтрокаДокумента, ВыборкаДокументов);
			СтрокаДокумента.НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
				ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер);
			
			// Данные руководителя
			Если ЗначениеЗаполнено(ВыборкаДокументов.Руководитель) Тогда
				ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(ВыборкаДокументов.Руководитель,
					"Фамилия, Имя, Отчество, Должность, ДолжностьНаименование, Подразделение", ВыборкаДокументов.ДатаАкта, Истина);
				ФИОРуководителя = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);                 
				ДолжностьРуководителя = ДанныеСотрудника.ДолжностьНаименование;
			Иначе	
				Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
					Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ВыборкаДокументов.Организация,
					ВыборкаДокументов.ДатаАкта, ВыборкаДокументов.СтруктурноеПодразделение);
				ФИОРуководителя = КорреспондентыКлиентСервер.ФИО(Руководитель, Истина, "ОтветственноеЛицо");
				ДолжностьРуководителя = Руководитель.ДолжностьПредставление;
			КонецЕсли;	
			СтрокаДокумента.ДолжностьРуководителя = ДолжностьРуководителя;
			СтрокаДокумента.ФИОРуководителя = ФИОРуководителя;

			СтрокаДокумента.ИнвентаризационныеОписи = УправлениеПечатьюБГУ.ТаблицаИнвентаризационныеОписиДляПечатиРешениеОПрекращенииПризнанияАктивом0510440();
			ВыборкаОпись.Сбросить();
			Пока ВыборкаОпись.НайтиСледующий(СтруктураПоиска) Цикл
				
				СтрокаОпись = СтрокаДокумента.ИнвентаризационныеОписи.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаОпись, ВыборкаОпись);
				ПредставлениеСчета = ?(ЗначениеЗаполнено(ВыборкаОпись.КодСчета), ?(ЗначениеЗаполнено(ВыборкаОпись.КФО), Строка(ВыборкаОпись.КФО), "0")
					+ " " + СтрЗаменить(ВыборкаОпись.КодСчета, ".", " ") + " 000", "-");
				СтрокаОпись.Счет = ПредставлениеСчета;
				
			КонецЦикла;
			
			СтрокаДокумента.СведенияОбОбъектах = УправлениеПечатьюБГУ.ТаблицаСведенияОбОбъектахДляПечатиРешениеОПрекращенииПризнанияАктивом0510440();
			СтрокаДокумента.ХарактеристикиОбъектов = УправлениеПечатьюБГУ.ТаблицаХарактеристикиОбъектовДляПечатиРешениеОПрекращенииПризнанияАктивом0510440();
			Если ВыборкаДокументов.ИнвентарныйУчет Тогда
				
				// Раздел 1
				
				ВыборкаОС.Сбросить();
				
				Пока ВыборкаОС.НайтиСледующий(СтруктураПоиска) Цикл
					
					СтрокаОС = СтрокаДокумента.СведенияОбОбъектах.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаОС, ВыборкаОС);
					ФактическийСрокЭксплуатации = УправлениеОсновнымиСредствами.РассчитатьМесяцыЭксплуатации(,
						ВыборкаОС.ДатаВводаВЭксплуатацию, ВыборкаДокументов.ДатаАкта);
					СтрокаОС.СрокЭксплуатации = ФактическийСрокЭксплуатации;
					
					// Раздел 2
					Данные.Вставить("МожетСодержатьДрагМатериалы", ВыборкаОС.МожетСодержатьДрагМатериалы);
					СтруктураПоискаОС = Новый Структура("ОсновноеСредство", ВыборкаОС.ОсновноеСредство);
					Справочники.ОсновныеСредства.ЗаполнитьТаблицуДопХарактеристик(Данные, СтруктураПоискаОС);
					Для НомерСтроки = 1 По Данные.ТаблицаХарактеристики.Количество() Цикл
						НоваяСтрокаХарактеристики = СтрокаДокумента.ХарактеристикиОбъектов.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаХарактеристики, Данные.ТаблицаХарактеристики[НомерСтроки-1]);
						НоваяСтрокаХарактеристики.НомерСтроки = Строка(ВыборкаОС.НомерСтроки) + "." + Строка(НомерСтроки);
						Если НомерСтроки = 1 Тогда
							НоваяСтрокаХарактеристики.НомерОбъекта = ВыборкаОС.ИнвентарныйНомер;
						КонецЕсли;
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЕсли;
			
			// Раздел 3
			
			ВыборкаОС.Сбросить();
			
			СтрокаДокумента.ЗаключениеПоОбъектам = УправлениеПечатьюБГУ.ТаблицаЗаключениеПоОбъектамДляПечатиРешениеОПрекращенииПризнанияАктивом0510440();
			Пока ВыборкаОС.НайтиСледующий(СтруктураПоиска) Цикл
				
				СтрокаЗаключения = СтрокаДокумента.ЗаключениеПоОбъектам.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаЗаключения, ВыборкаОС);
				СтрокаЗаключения.КодСчета = УправлениеПечатьюБГУ.ПредставлениеСчета(ВыборкаОС,, Истина);
				
				// Результаты голосования комиссии по строке документа.
				ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки",
				ВыборкаДокументов.Ссылка, ВыборкаОС.ИдентификаторСтроки);
				РезультатыГолосованияПоСтроке = РезультатыГолосования.НайтиСтроки(ОтборПоИдентификаторуСтроки);
				Если РезультатыГолосованияПоСтроке.Количество() > 0
					И РезультатыГолосованияПоСтроке[0].ГолосованиеПоСтрокеЗавершено Тогда
					СтрокаЗаключения.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
					СтрокаЗаключения.РезолюцияИтог = ?(РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена,
						"", НСтр("ru = 'снято с обсуждения'"));
				КонецЕсли;
				
			КонецЦикла;
			
			// Приложения
			
			СтрокаДокумента.Файлы = УправлениеПечатьюБГУ.ТаблицаФайлыДляПечатиПриказ61н();
			Пока ВыборкаФайлы.НайтиСледующий(СтруктураПоиска) Цикл
				СтрокаФайлы = СтрокаДокумента.Файлы.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаФайлы, ВыборкаФайлы);
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаДокументов;
	
КонецФункции

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДокументСсылка, "Номер, Дата, Организация, Ссылка, ТребуетсяУтилизация, Резервировать");
		
	Если РеквизитыДокумента.Резервировать Тогда
		Возврат;
	КонецЕсли;		
		
	НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, РеквизитыДокумента.Номер);
	ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументСсылка);
	Если ЗначениеЗаполнено(ДатаПроведения) Тогда
		РеквизитыДокумента.Вставить("Дата", ДатаПроведения);
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"				, ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента"		, НСтр("ru = 'Решение о прекращении признания активами объектов нефинансовых активов'"));
	Запрос.УстановитьПараметр("НомерДокумента"		, НомерДокумента);
	Запрос.УстановитьПараметр("Одобренные"			, ОбщегоНазначенияБГУ.ОдобренныеОбъектыГолосования(ДокументСсылка));
	Запрос.УстановитьПараметр("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запрос.УстановитьПараметр("УчетПоПодр02"		, БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("02.3").УчетПоПодразделениям);
	
	ТаблицыЗапроса = Новый Массив;
	
	ТаблицыЗапроса.Добавить("ТаблицаОсновныеСредства");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Ссылка КАК Ссылка,
	|	ТаблицаОсновныеСредства.Ссылка.Номер КАК Номер,
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК ДатаСписанияСБухУчета,
	|	ТаблицаОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.Ссылка.ЦМО КАК ЦМО,
	|	ТаблицаОсновныеСредства.Ссылка.Подразделение КАК Подразделение,
	|	&ПустойДоговор_ПодЗамену КАК Договор,
	|	&ИмяДокумента КАК НазваниеДокумента,
	|	&НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК ДатаДокумента,
	|	ТаблицаОсновныеСредства.СчетУчета КАК СчетУчета,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	ТаблицаОсновныеСредства.Количество КАК Количество,
	|	ТаблицаОсновныеСредства.Сумма КАК Сумма,
	|	ТаблицаОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ТаблицаОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения,
	|	ТаблицаОсновныеСредства.СуммаАмортизацииЗаТекущийМесяц КАК СуммаАмортизацииЗаТекущийМесяц,
	|	ТаблицаОсновныеСредства.РезолюцияКомиссии КАК РезолюцияКомиссии,
	|	ТаблицаОсновныеСредства.ПричинаСписания КАК ПричинаСписания,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|				ИЛИ НЕ ТаблицаОсновныеСредства.ОсновноеСредство.ГрупповойУчет
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПообъектныйУчет,
	|	ЕСТЬNULL(ЗначенияДополнительныхРеквизитовОпераций.Значение, ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)) КАК ЦМОНаХранении
	|ПОМЕСТИТЬ ТаблицаОсновныеСредства
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивом.ОсновныеСредства КАК ТаблицаОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
	|		ПО ТаблицаОсновныеСредства.Ссылка = ЗначенияДополнительныхРеквизитовОпераций.Объект
	|			И (ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации.ИмяДляФормулы = ""ЦМОНаХранении"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ТаблицаОсновныеСредства.Ссылка)
	|ГДЕ
	|	ТаблицаОсновныеСредства.Ссылка = &Ссылка
	|	И ТаблицаОсновныеСредства.ИдентификаторСтроки В(&Одобренные)
	|	И ЗначенияДополнительныхРеквизитовОпераций.Объект = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер";
	
	// Определим договор, на случай, если списывается право пользования НМА со счетов 111.60. Эта вставка 
	// используется и в документах, "Списание объектов ОС, НМА, НПА", "Передача объектов ОС, НМА, НПА"
	УправлениеОсновнымиСредствами.ДополнитьТекстЗапросаДоговоромИзРНСтоимостьОС(Запрос, РеквизитыДокумента);
	
	Если НЕ РеквизитыДокумента.ТребуетсяУтилизация Тогда
			
		// Если ОС списывается с баланса, и НЕ приходуется на забалансовый счет 02.3, то это окончательное списание 
		// и нужно сформировать движение по регистру "СобытияОС"
	 	
		ТаблицыЗапроса.Добавить("СобытияОС");
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК Период,
		|	ТаблицаОсновныеСредства.Организация КАК Организация,
		|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвНомер,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание) КАК Событие,
		|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК ДатаСобытия,
		//|	ТаблицаОсновныеСредства.РезолюцияКомиссии КАК ПричинаСписания,
		|	ТаблицаОсновныеСредства.ПричинаСписания КАК ПричинаСписания,
		|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
		|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
		|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента
		|ИЗ
		|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
		|ГДЕ
		|	ТаблицаОсновныеСредства.ПообъектныйУчет
		|	И НЕ ТаблицаОсновныеСредства.СчетУчета.Забалансовый";
	КонецЕсли;
	
	ТаблицыЗапроса.Добавить("СтоимостьОбъектовОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК Период,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.СчетУчета.Забалансовый
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ОперативныйУчет)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|	КОНЕЦ КАК ВидРаспоряжения,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.ЦМО КАК ЦМО,
	|	ТаблицаОсновныеСредства.Договор КАК Договор,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|		И ТаблицаОсновныеСредства.СчетУчета.УчетПоПодразделениям
	|			ТОГДА ТаблицаОсновныеСредства.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ТаблицаОсновныеСредства.Сумма КАК Стоимость,
	|	ТаблицаОсновныеСредства.Количество КАК Количество,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание) КАК Событие,
	|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента,
	|	ТаблицаОсновныеСредства.ПричинаСписания КАК Причина
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	(ТаблицаОсновныеСредства.Сумма <> 0
	|	ИЛИ ТаблицаОсновныеСредства.Количество <> 0)";
	
	ТаблицыЗапроса.Добавить("АмортизацияОбъектовОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК Период,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.СуммаАмортизацииЗаТекущийМесяц КАК СуммаАмортизации,
	|	0 КАК СуммаОбесценения,
	|	ЛОЖЬ КАК ЭтоСписание
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.СуммаАмортизацииЗаТекущийМесяц <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета,
	|	ТаблицаОсновныеСредства.Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.СуммаАмортизации + ТаблицаОсновныеСредства.СуммаАмортизацииЗаТекущийМесяц,
	|	ТаблицаОсновныеСредства.СуммаОбесценения,
	|	ИСТИНА
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	(ТаблицаОсновныеСредства.СуммаАмортизации + ТаблицаОсновныеСредства.СуммаАмортизацииЗаТекущийМесяц <> 0
	|			ИЛИ ТаблицаОсновныеСредства.СуммаОбесценения <> 0)";
	
	Если РеквизитыДокумента.ТребуетсяУтилизация Тогда
			
		// Приходовать в регистр "СтоимостьОбъектовОСПоКонтрагентам" нужно, только если ОС принимается
		// на хранение на забалансовый счет	
		ТаблицыЗапроса.Добавить("СтоимостьОбъектовОСПоКонтрагентам");
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении) КАК ВидРаспоряжения,
		|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК Период,
		|	ТаблицаОсновныеСредства.Организация КАК Организация,
		|	ВЫБОР
		|		КОГДА &УчетПоПодразделениям
		|				И &УчетПоПодр02
		|			ТОГДА ТаблицаОсновныеСредства.Подразделение
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ КАК Подразделение,
		|	ВЫБОР
		|		КОГДА ТаблицаОсновныеСредства.ЦМОНаХранении = ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
		|			ТОГДА ТаблицаОсновныеСредства.ЦМО
		|		ИНАЧЕ ТаблицаОсновныеСредства.ЦМОНаХранении
		|	КОНЕЦ КАК ЦМО,
		|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
		|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор,
		|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТаблицаОсновныеСредства.Количество КАК Количество,
		|	ТаблицаОсновныеСредства.Количество КАК Стоимость,
		|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
		|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
		|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента
		|ИЗ
		|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства";
	КонецЕсли;	
	
	#Область УчетДрагМатериалов
	Если НЕ РеквизитыДокумента.ТребуетсяУтилизация Тогда
		ИнициализироватьЗапросыДМ(Запрос, ТаблицыЗапроса);
	КонецЕсли;	
	#КонецОбласти
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, ТаблицыЗапроса)
	
	ТаблицыЗапроса.Добавить("НаличиеДрагМатериаловВОбъектахНФА");
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ДрагоценныеМатериалы.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	|	ДрагоценныеМатериалы.ОбъектНФА КАК ОбъектНФА,
	|	ДрагоценныеМатериалы.ИнвНомер КАК ИнвНомер,
	|	ДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	|	ДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	|	ДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	|	&ИмяДокумента КАК Основание,
	|	&НомерДокумента КАК НомерОснования,
	|	ДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	|	ДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	|	ДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации,
	|	ИСТИНА КАК ЭтоСписание
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивом.ДрагоценныеМатериалы КАК ДрагоценныеМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ДрагоценныеМатериалы.Ссылка)
	|ГДЕ
	|	ДрагоценныеМатериалы.Ссылка = &Ссылка
	|	И ДрагоценныеМатериалы.МассаДМ > 0
	|	И (ДрагоценныеМатериалы.ОбъектНФА, ДрагоценныеМатериалы.ИнвНомер) В
	|			(ВЫБРАТЬ
	|				ВТ.ОсновноеСредство,
	|				ВТ.ИнвентарныйНомер
	|			ИЗ
	|				ТаблицаОсновныеСредства КАК ВТ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДрагоценныеМатериалы.НомерСтроки";
	
	ТаблицыЗапроса.Добавить("НаличиеДрагМатериаловВЛомеИОтходах");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ДрагоценныеМатериалы.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
