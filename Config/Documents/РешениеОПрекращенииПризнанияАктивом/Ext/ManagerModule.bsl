#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы.
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("ОсновноеСредство");
	ИменаРеквизитов.Добавить("ИнвентарныйНомер");
	ИменаРеквизитов.Добавить("СчетУчета");
	ИменаРеквизитов.Добавить("КПС");
	ИменаРеквизитов.Добавить("КФО");
	ИменаРеквизитов.Добавить("Количество");
	ИменаРеквизитов.Добавить("Сумма");
	ИменаРеквизитов.Добавить("СуммаАмортизации");
	ИменаРеквизитов.Добавить("СуммаАмортизацииЗаТекущийМесяц");
	ИменаРеквизитов.Добавить("СуммаОбесценения");
	Результат.Вставить("ОсновныеСредства", ИменаРеквизитов);
	Возврат Результат;
КонецФункции

// Формирует данные для печати ф. 0510440 "Решение о прекращении признания активом"
//
// Параметры:
//  МассивОбъектов - Массив - тип элементов ДокументСсылка.РешениеОПрекращенииПризнанияАктивомИК
//
// Возвращаемое значение:      
//  Структура с элементами:
//   * ВыборкаДокументов - выборка запроса
//   * ВыборкаОС - выборка запроса
//   * ВыборкаОпись - выборка запроса
//   * Драгметаллы - выборка запроса
//   * ПТС - выборка запроса
//   * ЕГРН - выборка запроса
//   * Характеристики - выборка запроса
//   * ВыборкаФайлы - выборка запроса
Функция ДанныеДляПечати0510440(МассивОбъектов) Экспорт
	
	ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию();
	ЕдиницаИзмерения = ?(ЗначениеЗаполнено(ЕдиницаИзмерения),
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмерения, "Наименование"), "");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", ЕдиницаИзмерения);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.Номер КАК Номер,
	|	Документ.Дата КАК ДатаАкта,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА Документ.Организация
	|		ИНАЧЕ Документ.Организация.ГоловнаяОрганизация
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА ВЫБОР
	|					КОГДА Документ.Организация.НаименованиеПолное = """"
	|						ТОГДА Документ.Организация.Наименование
	|					ИНАЧЕ Документ.Организация.НаименованиеПолное
	|				КОНЕЦ
	|		ИНАЧЕ Документ.Организация.ГоловнаяОрганизация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОрганизации,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА Документ.Организация.КодПоРПБС
	|		ИНАЧЕ Документ.Организация.ГоловнаяОрганизация.КодПоРПБС
	|	КОНЕЦ КАК КодРПБС,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|		ИНАЧЕ Документ.Организация
	|	КОНЕЦ КАК ОбособленноеПодразделение,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА """"
	|		ИНАЧЕ Документ.Организация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОбособленногоПодразделения,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА """"
	|		ИНАЧЕ Документ.Организация.КодПоРПБС
	|	КОНЕЦ КАК КодРПБСПодр,
	|	Документ.Подразделение КАК СтруктурноеПодразделение,
	|	ВЫБОР
	|		КОГДА Документ.Подразделение.НаименованиеПолное = """"
	|			ТОГДА Документ.Подразделение.Наименование
	|		ИНАЧЕ Документ.Подразделение.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеСтруктурногоПодразделения,
	|	Документ.Организация.КодПоППП.НаименованиеПолное КАК Учредитель,
	|	Документ.Организация.КодПоППП.Код КАК ГлаваБК,
	|	Документ.Организация.Бюджет.НаименованиеПолное КАК БюджетНаименование,
	|	Документ.Организация.Бюджет.Код КАК ОКТМО,
	|	Документ.Комиссия.НаименованиеПриказа КАК НаименованиеПриказа,
	|	Документ.Комиссия.НомерПриказа КАК НомерПриказа,
	|	Документ.Комиссия.ДатаПриказа КАК ДатаПриказа,
	|	Документ.ВидЛокальногоАкта КАК ВидЛокальногоАкта,
	|	Документ.НомерЛокальногоАкта КАК НомерЛокальногоАкта,
	|	Документ.ДатаЛокальногоАкта КАК ДатаЛокальногоАкта,
	|	Документ.ИнвентарныйУчет КАК ИнвентарныйУчет,
	|	Документ.Ответственный КАК Ответственный,
	|	Документ.Руководитель КАК Руководитель
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивом КАК Документ
	|ГДЕ
	|	Документ.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документ.Дата,
	|	Документ.Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|			ТОГДА ОсновныеСредства.ОсновноеСредство.Код
	|		ИНАЧЕ ОсновныеСредства.ИнвентарныйНомер
	|	КОНЕЦ КАК ИнвентарныйНомер,
	|	ОсновныеСредства.Сумма КАК Сумма,
	|	ОсновныеСредства.Количество КАК Количество,
	|	ОсновныеСредства.СуммаАмортизации + ОсновныеСредства.СуммаАмортизацииЗаТекущийМесяц КАК СуммаАмортизации,
	|	ОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения,
	|	ОсновныеСредства.СчетУчета КАК СчетУчета,
	|	ОсновныеСредства.КФО КАК КФО,
	|	ОсновныеСредства.КПС КАК КПС,
	|	ОсновныеСредства.СтатусОбъекта КАК СтатусОбъекта,
	|	ОсновныеСредства.ЦелеваяФункцияАктива КАК ЦелеваяФункцияАктива,
	|	ОсновныеСредства.Количество КАК КоличествоНеСоответствует,
	|	ОсновныеСредства.Сумма КАК СуммаНеСоответствует,
	|	ОсновныеСредства.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ОсновныеСредства.РезолюцияКомиссии КАК РезолюцияКомиссии
	|ПОМЕСТИТЬ ОсновныеСредства
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивом.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ ИнвентарныеОС
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивом.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&МассивОбъектов)
	|	И ОсновныеСредства.Ссылка.ИнвентарныйУчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОССрезПоследних.ДатаСобытия КАК ДатаСобытия,
	|	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ДатаВводаВЭксплуатацию
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			,
	|			ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						ИнвентарныеОС КАК ВТ)
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)) КАК СобытияОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетАмортизацииОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	РасчетАмортизацииОССрезПоследних.СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|ПОМЕСТИТЬ СПИ
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	|			,
	|			ОсновноеСредство В
	|				(ВЫБРАТЬ
	|					ВТ.ОсновноеСредство
	|				ИЗ
	|					ИнвентарныеОС КАК ВТ)) КАК РасчетАмортизацииОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА ОсновныеСредства.ОсновноеСредство.Наименование
	|		ИНАЧЕ ОсновныеСредства.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОС,
	|	ОсновныеСредства.ИнвентарныйНомер.ДатаВыпуска КАК ДатаВыпуска,
	|	0 КАК СрокЭксплуатации,
	|	ОсновныеСредства.ОсновноеСредство.Сведения КАК Сведения,
	|	ЕСТЬNULL(ОсновныеСредства.ОсновноеСредство.МожетСодержатьДрагМатериалы, ЛОЖЬ) КАК МожетСодержатьДрагМатериалы,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.ИнвентарныйНомер.РеестровыйНомер КАК РеестровыйНомер,
	|	ОсновныеСредства.ИнвентарныйНомер.ЗаводскойНомер КАК ЗаводскойНомер,
	|	ОсновныеСредства.ИнвентарныйНомер.ИнойНомер КАК ИнойНомер,
	|	ОсновныеСредства.Количество КАК Количество,
	|	ОсновныеСредства.Сумма КАК Сумма,
	|	ОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения,
	|	ЕСТЬNULL(СПИ.СрокПолезногоИспользования, 0) КАК СрокПолезногоИспользования,
	|	ЕСТЬNULL(ДатаВводаВЭксплуатацию.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВводаВЭксплуатацию,
	|	ОсновныеСредства.СчетУчета.Код КАК Счет,
	|	ПРЕДСТАВЛЕНИЕ(ОсновныеСредства.КФО) КАК КФО,
	|	ОсновныеСредства.КПС.Код КАК КПС,
	|	ОсновныеСредства.СчетУчета.КОСГУКт.Код КАК КЭК,
	|	ОсновныеСредства.СтатусОбъекта КАК Статус,
	|	ОсновныеСредства.ЦелеваяФункцияАктива КАК ЦелеваяФункция,
	|	ОсновныеСредства.КоличествоНеСоответствует КАК НеАктивКоличество,
	|	ОсновныеСредства.СуммаНеСоответствует КАК НеАктивСумма,
	|	ОсновныеСредства.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ОсновныеСредства.РезолюцияКомиссии КАК РезолюцияКомиссии,
	|	&ЕдиницаИзмерения КАК ЕдИзм
	|ИЗ
	|	ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию
	|		ПО ОсновныеСредства.ОсновноеСредство = ДатаВводаВЭксплуатацию.ОсновноеСредство
	|			И ОсновныеСредства.ИнвентарныйНомер = ДатаВводаВЭксплуатацию.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ СПИ КАК СПИ
	|		ПО ОсновныеСредства.ОсновноеСредство = СПИ.ОсновноеСредство
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОсновныеСредства.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДрагоценныеМатериалы.ОбъектНФА КАК ОсновноеСредство,
	|	ДрагоценныеМатериалы.ВидДрагМатериала КАК Драгметалл,
	|	ДрагоценныеМатериалы.ЕдИзм КАК НаименованиеЕИ,
	|	ДрагоценныеМатериалы.ЕдИзм.Код КАК КодЕИ,
	|	ДрагоценныеМатериалы.МассаДМ КАК Количество
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивом.ДрагоценныеМатериалы КАК ДрагоценныеМатериалы
	|ГДЕ
	|	ДрагоценныеМатериалы.Ссылка В(&МассивОбъектов)
	|	И ДрагоценныеМатериалы.Ссылка.ИнвентарныйУчет
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДрагоценныеМатериалы.НомерСтроки
	|ИТОГИ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПаспортаТранспортныхСредствСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	ПаспортаТранспортныхСредствСрезПоследних.СерияНомер КАК СерияНомер,
	|	ПаспортаТранспортныхСредствСрезПоследних.ИдентификационныйНомер КАК ИдентификационныйНомер,
	|	ПаспортаТранспортныхСредствСрезПоследних.Марка КАК Марка,
	|	ПаспортаТранспортныхСредствСрезПоследних.Модель КАК Модель,
	|	ПаспортаТранспортныхСредствСрезПоследних.Тип КАК Тип,
	|	ПаспортаТранспортныхСредствСрезПоследних.ДвигательМодель КАК ДвигательМодель,
	|	ПаспортаТранспортныхСредствСрезПоследних.ДвигательНомер КАК ДвигательНомер,
	|	ПаспортаТранспортныхСредствСрезПоследних.НомерШасси КАК НомерШасси,
	|	ПаспортаТранспортныхСредствСрезПоследних.НомерКузова КАК НомерКузова,
	|	ПаспортаТранспортныхСредствСрезПоследних.ЭкологическийКласс КАК ЭкологическийКласс,
	|	ПаспортаТранспортныхСредствСрезПоследних.Масса КАК Масса,
	|	ПаспортаТранспортныхСредствСрезПоследних.ГаражныйНомер КАК ГаражныйНомер,
	|	ПаспортаТранспортныхСредствСрезПоследних.Грузоподъемность КАК Грузоподъемность,
	|	ПаспортаТранспортныхСредствСрезПоследних.Колонна КАК Колонна,
	|	ПаспортаТранспортныхСредствСрезПоследних.РегистрационныйЗнак КАК РегистрационныйЗнак,
	|	ПаспортаТранспортныхСредствСрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
