// ************Общая часть обновления ************************************

// Многопоточный обработчик обновления.
// 
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//  ТипДокумента - Тип
Процедура ЗарегистрироватьДокументыКОбработкеДляПереходаНаНовуюВерсию(Параметры, ТипДокумента) Экспорт
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипДокумента);
	// Параметры выборки данных для многопоточного обновления.
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаОбъектов = ОбъектМетаданных.ПолноеИмя();
	ПараметрыВыборки.ПоляУпорядочиванияПриОбработкеДанных = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("Дата");
	ПараметрыВыборки.ПоляУпорядочиванияПриРаботеПользователей = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("Дата");
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиСсылки();
	
	АктуальныеДанные = Параметры.АктуальныеДанные;
	АктуальныеДанные.ПолеОтбора = "Дата";
	АктуальныеДанные.ВидСравнения = ВидСравнения.Больше;
	АктуальныеДанные.Значение = Дата("20231231235959");

	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЖурналПроводокЕПСБУ.Регистратор КАК Ссылка
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.СчетДт = &СчетДт
	|	И ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУ.Регистратор) = &ТипРегистратора
	|	И НЕ &УсловиеНаФлагТребуетсяУтилизация";
	
	ТипДанных = "Документ." + ОбъектМетаданных.Имя;
	ТипРегистратора = "ТИП(" + ТипДанных + ")";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипРегистратора", ТипРегистратора);

	УсловиеНаФлагТребуетсяУтилизация = 
		"ВЫРАЗИТЬ(ЖурналПроводокЕПСБУ.Регистратор КАК " + ТипДанных + ").ТребуетсяУтилизация";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеНаФлагТребуетсяУтилизация", УсловиеНаФлагТребуетсяУтилизация);

	Запрос = Новый Запрос(ТекстЗапроса);                                   
	КодСчетаДт = "02.3";
	Если ТипДокумента = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомИК") Тогда
		КодСчетаДт = "02.5";
	КонецЕсли;	
	Запрос.УстановитьПараметр("СчетДт", БухгалтерскийУчет.СчетПоКоду(КодСчетаДт));
	Выборка = Запрос.Выполнить().Выбрать();

	ДокументыКОбработке = Новый Массив;
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		ДокументыКОбработке.Добавить(Выборка.Ссылка);
		Если Счетчик = 1000 Тогда
			ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, ДокументыКОбработке);
			ДокументыКОбработке.Очистить();
			Счетчик = 0;
		КонецЕсли;
	КонецЦикла;
	
	Если Счетчик > 0 Тогда
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, ДокументыКОбработке);
	КонецЕсли;
	
КонецПроцедуры

// Парный обработчик к процедуре ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию
// 
// Параметры:
//  Параметры - Структура:
//   * ОбработкаЗавершена - Булево
//  ТипДокумента - Тип
Процедура ОбработатьДокументыДляПереходаНаНовуюВерсию(Параметры, ТипДокумента) Экспорт
	
//	// Выборка данных для многопоточного обновления.
	ОбрабатываемыеДокументы = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);

	ПроблемныхОбъектов = 0;
	ОбъектовОбработано = 0;
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипДокумента);
	ПолноеИмяОбъекта = ОбъектМетаданных.ПолноеИмя();
	
	Для каждого ОбрабатываемыйДокумент Из ОбрабатываемыеДокументы Цикл
		ПредставлениеСсылки = Строка(ОбрабатываемыйДокумент.Ссылка);
		Попытка
			//@skip-check query-in-loop
			ОбработатьДокументПриОбновлении(ОбрабатываемыйДокумент, ОбъектМетаданных);
			ОбъектовОбработано = ОбъектовОбработано + 1;
		Исключение
			// Если не удалось обработать какой-либо документ, повторяем попытку снова.
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеСсылки);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				ОбъектМетаданных,
				ОбрабатываемыйДокумент.Ссылка,
				ТекстСообщения);
		КонецПопытки;
		
	КонецЦИкла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось обработать некоторые ""%2"" (пропущены): %1'"), 
			ПроблемныхОбъектов,
			ПолноеИмяОбъекта);
		ВызватьИсключение ТекстСообщения;
	Иначе
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Информация,
			ОбъектМетаданных,,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Обработана очередная порция ""%2"": %1'"),
				ОбъектовОбработано,
				ПолноеИмяОбъекта));
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДокументПриОбновлении(ОбрабатываемыйДокумент, ОбъектМетаданных)
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ОбъектМетаданных.ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ОбрабатываемыйДокумент.Ссылка);
		Блокировка.Заблокировать();
		
		ДокументОбъект = ОбрабатываемыйДокумент.Ссылка.ПолучитьОбъект(); // ДокументОбъект
		Если ДокументОбъект = Неопределено Тогда
			Возврат;
		КонецЕсли;	

		ДокументОбъект.Заблокировать();

		Если Не ДокументОбъект.ТребуетсяУтилизация Тогда
			ДокументОбъект.ТребуетсяУтилизация = Истина;
		КонецЕсли;		
		
		Если ДокументОбъект.Модифицированность() Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
		Иначе
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ОбрабатываемыйДокумент.Ссылка);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

// Формирует таблицу разделителей документов для ввода документов "Решение о прекращении
// признания активом" по данным документа "Инвентаризационная опись НФА" (0510466)
//
// Параметры:
//  ДокИнвентаризации - ДокументСсылка.ИнвентаризационнаяОписьНФА - документ инвентаризации
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица разделителей с полями:
//   * ЦМО - СправочникСсылка.ЦМО
//   * Подразделение - СправочникСсылка.Подразделения
//   * ИнвентарныйОбъект - Булево
Функция РазделителиДокументов_ИнвентаризационнаяОписьНФА(ДокОснование, СсылкаЦелевогоДокумента)
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокОснование, СсылкаЦелевогоДокумента);
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеИнвентаризации.ИФО КАК ИФО,
	|	ДанныеИнвентаризации.ЦМОРаздела4 КАК ЦМО,
	|	ДанныеИнвентаризации.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(ДанныеИнвентаризации.НФА КАК Справочник.ОсновныеСредства).ВидНФА <> ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС)
	|		ИЛИ ВЫБОР
	|			КОГДА ДанныеИнвентаризации.Количество <> 0
	|				ТОГДА ДанныеИнвентаризации.Сумма / ДанныеИнвентаризации.Количество
	|			ИНАЧЕ ДанныеИнвентаризации.Сумма
	|		КОНЕЦ > &ПервыйПредел
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПоИнвентарнымОбъектам
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта В (2, 3, 4)
	|	И (ДанныеИнвентаризации.КоличествоНеСоответствует <> 0
	|	ИЛИ ДанныеИнвентаризации.СуммаНеСоответствует <> 0)
	|СГРУППИРОВАТЬ ПО
	|	ДанныеИнвентаризации.ИФО,
	|	ДанныеИнвентаризации.ЦМОРаздела4,
	|	ДанныеИнвентаризации.Подразделение,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(ДанныеИнвентаризации.НФА КАК Справочник.ОсновныеСредства).ВидНФА <> ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС)
	|		ИЛИ ВЫБОР
	|			КОГДА ДанныеИнвентаризации.Количество <> 0
	|				ТОГДА ДанныеИнвентаризации.Сумма / ДанныеИнвентаризации.Количество
	|			ИНАЧЕ ДанныеИнвентаризации.Сумма
	|		КОНЕЦ > &ПервыйПредел
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	ДатаДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокОснование, "Дата");
	ПервыйПредел = УправлениеОсновнымиСредствами.ПолучитьПараметрыУчетаОС(ДатаДокумента).ПервыйПределОС;
	Запрос.УстановитьПараметр("ПервыйПредел", ПервыйПредел);
	
	ТаблицаРазделителей = Запрос.Выполнить().Выгрузить();
	СтруктураРазделителей = Новый Структура("Разделители, ЗаголовкиКолонок");
	СтруктураРазделителей.Вставить("Разделители", ТаблицаРазделителей);
	СтруктураРазделителей.Вставить("ЗаголовкиКолонок", Новый Структура("ПоИнвентарнымОбъектам", "По инвентарным объектам"));
	
	Возврат(СтруктураРазделителей);
КонецФункции	

#КонецОбласти

#КонецЕсли
