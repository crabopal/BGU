//---
// Применяемая инструкция
//---

// ПрименяемаяИнструкция=f(ПричинаНалогообложения,КФО,Дата)
&НаСервере
Процедура ПрименяемаяИнструкция_НастроитьФормуСервер(ЗаполнитьКолонкиСчетов, ИдентификаторИнструкции = Неопределено)
	
	ШапкаДокумента = Документы.РегистрацияСтрокиКнигиПродаж.ПолучитьШапкуДокумента(Объект);
	
	УчетНДС.НастроитьФорму_ВидимостьКолонок(ЭтаФорма);
	
	// Определяем инструкцию
	Если ИдентификаторИнструкции = Неопределено Тогда
		// Определяем применяемую инструкцию из данных документа
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ШапкаДокумента);
	Иначе
		// Применяемая инструкция указана явно
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ШапкаДокумента, , ИдентификаторИнструкции);
	КонецЕсли;
	ЭтаФорма["ПрименяемаяИнструкция_СтруктураСвойств"] = Новый ФиксированнаяСтруктура(ПрименяемаяИнструкцияСтруктура);
	
	// Элементы формы, связанные с инструкцией
	ЗаголовокКоманды = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Применяемая инструкция (%1)'"),
		ПрименяемаяИнструкцияСтруктура["Идентификатор"]);
	Элементы["ФормаПрименяемаяИнструкция"].Заголовок = ЗаголовокКоманды;
	
	// Определяем свойства инструкции для каждой строки
	Документы.РегистрацияСтрокиКнигиПродаж.ПрименяемаяИнструкция_ОбновитьСтруктурыСвойств(
		ШапкаДокумента,
		Объект["СуммыНДС"],
		ИдентификаторИнструкции);
	
	Если ЗаполнитьКолонкиСчетов Тогда
		// Заполняем полные счета
		Документы.РегистрацияСтрокиКнигиПродаж.ПрименяемаяИнструкция_ЗаполнитьКолонкиСчетов(
			Объект["СуммыНДС"],
			Объект);
		
		//---
		// Механизм автоустановки субконто
		//---
		АвтоустановкаСубконто_ВыполнитьАвтоустановкуЗначений_Сервер("СуммыНДС");
	КонецЕсли;
	
	// Скрываем неиспользуемые элементы
	НастроитьФормуСерверДляТекущегоРежимаРаботы();
	
	ЭтоНалоговыйАгент = УчетНДСПовтИсп.НалоговыйАгент(Объект.ПричинаНалогообложения);
	
КонецПроцедуры

// ПрименяемаяИнструкция=f(ПричинаНалогообложения,КФО,Дата)
&НаСервере
Процедура ПрименяемаяИнструкция_НастроитьТекущуюСтрокуСервер(ТекущаяСтрока, СтруктураДляПередачиНаСервер)
	
	ТекДанные		= Объект["СуммыНДС"].НайтиПоИдентификатору(ТекущаяСтрока);
	ШапкаДокумента	= Документы.РегистрацияСтрокиКнигиПродаж.ПолучитьШапкуДокумента(Объект);
	
	// Определяем свойства инструкции для одной текущей строки
	ИдентификаторИнструкции	= ЭтаФорма["ПрименяемаяИнструкция_СтруктураСвойств"]["Идентификатор"];
	Документы.РегистрацияСтрокиКнигиПродаж.ПрименяемаяИнструкция_ОбновитьСтруктурыСвойств(
		ШапкаДокумента,
		Объект["СуммыНДС"],
		ИдентификаторИнструкции,
		ТекДанные);
	
	// Заполняем полные счета
	ПараметрыЗаполнения = Новый Структура("СтрокаТаблицы", ТекДанные);
	Документы.РегистрацияСтрокиКнигиПродаж.ПрименяемаяИнструкция_ЗаполнитьКолонкиСчетов(
		Объект["СуммыНДС"],
		Объект,
		ПараметрыЗаполнения);
	
	Если ТекДанные["ПрименяемаяИнструкция_СтруктураСвойств"]["ИзменилсяСчетНачислениеДт"] Тогда
		//---
		// Механизм автоустановки субконто (клиентская часть)
		//---
		АвтоустановкаСубконто_ПриИзмененииСчета_Сервер("СуммыНДССчетНачислениеДт", СтруктураДляПередачиНаСервер);
	КонецЕсли;
	
КонецПроцедуры


//---
// Отметка пустых субконто
//---

&НаСервере
Процедура ОтметкаПустыхСубконто_ЗаполнитьСлужебныеКолонки(ТекущаяСтрокаТаблицы = Неопределено, ИмяКолонкиСчет = Неопределено)
	
	Перем	СтрокиТаблицы,
			ИспользоватьКолонкуСчетСписания,
			ИспользоватьКолонкуСчетСписанияНУ;
			
	ИспользоватьКолонкуСчетСписания		= (ИмяКолонкиСчет = Неопределено) ИЛИ (ИмяКолонкиСчет = "СчетСписания");
	ИспользоватьКолонкуСчетСписанияНУ	= (ИмяКолонкиСчет = Неопределено) ИЛИ (ИмяКолонкиСчет = "СчетСписанияНУ");
	
	Если ТекущаяСтрокаТаблицы = Неопределено Тогда
		// Обрабатываем все строки таблицы
		СтрокиТаблицы = Объект["СуммыНДС"];
		
		Если ИспользоватьКолонкуСчетСписания Тогда
			СчетаСписания	= Объект["СуммыНДС"].Выгрузить(, "СчетСписания").ВыгрузитьКолонку("СчетСписания");
			ВидыСубконто	= ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СчетаСписания, "ВидыСубконто");
		КонецЕсли;
		Если ИспользоватьКолонкуСчетСписанияНУ Тогда
			СчетаСписанияНУ	= Объект["СуммыНДС"].Выгрузить(, "СчетСписанияНУ").ВыгрузитьКолонку("СчетСписанияНУ");
			ВидыСубконтоНУ	= ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СчетаСписанияНУ, "ВидыСубконто");
		КонецЕсли;
	Иначе
		// Обрабатываем одну указанную строку таблицы
		СтрокаТаблицы = Объект["СуммыНДС"].НайтиПоИдентификатору(ТекущаяСтрокаТаблицы);
		СтрокиТаблицы = Новый Массив();
		СтрокиТаблицы.Добавить(СтрокаТаблицы);
		
		Если ИспользоватьКолонкуСчетСписания Тогда
			ВидыСубконто	= Новый Соответствие();
			ВидыСубконто.Вставить(СтрокаТаблицы["СчетСписания"], ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблицы["СчетСписания"], "ВидыСубконто"));
		КонецЕсли;
		Если ИспользоватьКолонкуСчетСписанияНУ Тогда
			ВидыСубконтоНУ	= Новый Соответствие();
			ВидыСубконтоНУ.Вставить(СтрокаТаблицы["СчетСписанияНУ"], ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблицы["СчетСписанияНУ"], "ВидыСубконто"));
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		Если ИспользоватьКолонкуСчетСписания Тогда
			РезультатЗапроса = ВидыСубконто.Получить(СтрокаТаблицы["СчетСписания"]);
			Если НЕ РезультатЗапроса = Неопределено Тогда
				СтрокаТаблицы["ОтметкаПустыхСубконто_СчетСписания_КоличествоСубконто"] = РезультатЗапроса.Выбрать().Количество();
			КонецЕсли;
		КонецЕсли;
		
		Если ИспользоватьКолонкуСчетСписанияНУ Тогда
			РезультатЗапроса = ВидыСубконтоНУ.Получить(СтрокаТаблицы["СчетСписанияНУ"]);
			Если НЕ РезультатЗапроса = Неопределено Тогда
				СтрокаТаблицы["ОтметкаПустыхСубконто_СчетСписанияНУ_КоличествоСубконто"] = РезультатЗапроса.Выбрать().Количество();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОтметкаПустыхСубконто_УстановитьУсловноеОформление(ИмяТаблицы, Знач ПоляСчетИСубконто)
	
	Перем	ИмяЭлементаСубконто1,
			ИмяЭлементаСубконто2,
			ИмяЭлементаСубконто3,
			ИменаЭлементовСубконто;
	
	// Опциональные имена полей
	ИменаЭлементовСубконто = Новый Соответствие();
	ПоляСчетИСубконто.Свойство("ИмяЭлементаСубконто1", ИмяЭлементаСубконто1);
	ПоляСчетИСубконто.Свойство("ИмяЭлементаСубконто2", ИмяЭлементаСубконто2);
	ПоляСчетИСубконто.Свойство("ИмяЭлементаСубконто3", ИмяЭлементаСубконто3);
	Если ЗначениеЗаполнено(ИмяЭлементаСубконто1) Тогда
		ИменаЭлементовСубконто.Вставить(1, ИмяЭлементаСубконто1);
	Иначе
		ИменаЭлементовСубконто.Вставить(1, ИмяТаблицы + ПоляСчетИСубконто["ИмяРеквизитаСубконто1"]);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяЭлементаСубконто2) Тогда
		ИменаЭлементовСубконто.Вставить(2, ИмяЭлементаСубконто2);
	Иначе
		ИменаЭлементовСубконто.Вставить(2, ИмяТаблицы + ПоляСчетИСубконто["ИмяРеквизитаСубконто2"]);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяЭлементаСубконто3) Тогда
		ИменаЭлементовСубконто.Вставить(3, ИмяЭлементаСубконто3);
	Иначе
		ИменаЭлементовСубконто.Вставить(3, ИмяТаблицы + ПоляСчетИСубконто["ИмяРеквизитаСубконто3"]);
	КонецЕсли;
	
	ПолноеИмяРеквизитаСчет					= "Объект." + ИмяТаблицы + "." + ПоляСчетИСубконто["ИмяРеквизитаСчет"];
	ПолноеИмяРеквизитаКоличествоСубконто	= "Объект." + ИмяТаблицы + "." + "ОтметкаПустыхСубконто_" + ПоляСчетИСубконто["ИмяРеквизитаСчет"] + "_КоличествоСубконто";
	
	Для НомерСубконто = 1 По 3 Цикл
		ПолноеИмяРеквизитаСубконто	= "Объект." + ИмяТаблицы + "." + ПоляСчетИСубконто["ИмяРеквизитаСубконто" + НомерСубконто];
		ИмяЭлементаСубконто			= ИменаЭлементовСубконто.Получить(НомерСубконто);
		
		НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		НовыйЭлементУО.Представление = "Отметка пустых субконто - таблица """ + ИмяТаблицы
			+ """ - отметка незаполненного субконто " + Строка(НомерСубконто)
			+ " (счет " + ПоляСчетИСубконто["ИмяРеквизитаСчет"] + ")";
		// Условие:
		// ЗначениеЗаполнено(Счет) И НЕ ЗначениеЗаполнено(Субконто) И НомерСубконто<=КоличествоСубконто
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолноеИмяРеквизитаСчет);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
		Условие.ПравоеЗначение = Истина;
		
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолноеИмяРеквизитаСубконто);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		Условие.ПравоеЗначение = Истина;
		
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолноеИмяРеквизитаКоличествоСубконто);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
		Условие.ПравоеЗначение = НомерСубконто;
		
		// Оформление:
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",	ЦветаСтиля.ЦветНедоступноеПоле);
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",		"<...>");
		// Оформляемые поля:
		ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлементаСубконто);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСчетИСубконтоНУ()
	
	ТекДанные = Элементы["СуммыНДС"].ТекущиеДанные;
	
	СчетИСубконтоБУ = Новый Структура();
	СчетИСубконтоБУ.Вставить("Счет",		ТекДанные["СчетСписания"]);
	СчетИСубконтоБУ.Вставить("Субконто1",	ТекДанные["Субконто1Списания"]);
	СчетИСубконтоБУ.Вставить("Субконто2",	ТекДанные["Субконто2Списания"]);
	СчетИСубконтоБУ.Вставить("Субконто3",	ТекДанные["Субконто3Списания"]);
	
	ПараметрыОпределенияСчета = Новый Структура();
	ПараметрыОпределенияСчета.Вставить("КорСчетБУ",		ТекДанные["СчетНачислениеДт"]);
	ПараметрыОпределенияСчета.Вставить("Дата",			Объект["Дата"]);
	ПараметрыОпределенияСчета.Вставить("Организация",	Объект["Организация"]);
	ПараметрыОпределенияСчета.Вставить("ИФО",			Объект["ИФО"]);
	ПараметрыОпределенияСчета.Вставить("Подразделение",	Объект["Подразделение"]);
	
	СчетИСубконтоНУ = ПолучитьСчетИСубконтоНУ(СчетИСубконтоБУ, ПараметрыОпределенияСчета);
	
	ТекДанные["СчетСписанияНУ"]			= СчетИСубконтоНУ["Счет"];
	ТекДанные["Субконто1СписанияНУ"]	= СчетИСубконтоНУ["Субконто1"];
	ТекДанные["Субконто2СписанияНУ"]	= СчетИСубконтоНУ["Субконто2"];
	ТекДанные["Субконто3СписанияНУ"]	= СчетИСубконтоНУ["Субконто3"];
	
	//---
	// Отметка пустых субконто
	//---
	ТекДанные["ОтметкаПустыхСубконто_СчетСписания_КоличествоСубконто"]		= СчетИСубконтоНУ["КоличествоСубконтоСчетБУ"];
	ТекДанные["ОтметкаПустыхСубконто_СчетСписанияНУ_КоличествоСубконто"]	= СчетИСубконтоНУ["КоличествоСубконтоСчетНУ"];
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСчетИСубконтоНУ(СчетИСубконтоБУ, ПараметрыОпределенияСчета)
	
	Возврат Документы.РегистрацияСтрокиКнигиПродаж.ПолучитьСчетИСубконтоНУ(СчетИСубконтоБУ, ПараметрыОпределенияСчета);
	
КонецФункции

