&НаКлиенте
Процедура СуммыНДССубконтоСписанияПриИзменении(Элемент, НомерСубконто)
	
	СтруктураИменСубконто = Новый Структура();
	СтруктураИменСубконто.Вставить("НомерСубконто",			НомерСубконто);
	СтруктураИменСубконто.Вставить("ИмяРеквизитаСубконто",	"Субконто" + Строка(НомерСубконто) + "Списания");
	СтруктураИменСубконто.Вставить("ИмяРеквизитаСубконто1",	"Субконто1Списания");
	СтруктураИменСубконто.Вставить("ИмяРеквизитаСубконто2",	"Субконто2Списания");
	СтруктураИменСубконто.Вставить("ИмяРеквизитаСубконто3",	"Субконто3Списания");
	
	БухгалтерскиеОперацииКлиент.СубконтоПриИзменении(Элемент,, СтруктураИменСубконто);
	
КонецПроцедуры
&НаКлиенте
Процедура СуммыНДССубконтоСписанияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, НомерСубконто)
	
	ТекДанные = Элементы["СуммыНДС"].ТекущиеДанные;
	
	СтруктураВыбораСубконто = БухгалтерскийУчетКлиент.ИнициализироватьСтруктуруНачалаВыбораСубконто();
	СтруктураВыбораСубконто.Вставить("НомерСубконто",	НомерСубконто);
	СтруктураВыбораСубконто.Вставить("Организация", 	Объект["Организация"]);
	СтруктураВыбораСубконто.Вставить("КФО", 			ТекДанные["КФО"]);
	СтруктураВыбораСубконто.Вставить("КПС", 			ТекДанные["КПССписания"]);
	СтруктураВыбораСубконто.Вставить("КЭК", 			ТекДанные["КЭКСписания"]);
	СтруктураВыбораСубконто.Вставить("Счет", 			ТекДанные["СчетСписания"]);
	СтруктураВыбораСубконто.Вставить("Субконто1", 		ТекДанные["Субконто1Списания"]);
	СтруктураВыбораСубконто.Вставить("Субконто2", 		ТекДанные["Субконто2Списания"]);
	СтруктураВыбораСубконто.Вставить("Субконто3", 		ТекДанные["Субконто3Списания"]);
	
	БухгалтерскиеОперацииКлиент.СубконтоНачалоВыбора(Элемент,
		ДанныеВыбора,
		СтандартнаяОбработка,
		Объект["Организация"],
		Элементы["СуммыНДС"].ТекущиеДанные["Субконто" + НомерСубконто + "Списания"],
		,
		,
		СтруктураВыбораСубконто);
	
КонецПроцедуры

