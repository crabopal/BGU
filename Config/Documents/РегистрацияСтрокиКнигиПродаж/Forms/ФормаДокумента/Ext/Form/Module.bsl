&НаКлиенте
Процедура СуммыНДСКФОПриИзменении(Элемент)
	
	//---
	// Механизм автоустановки субконто (клиентская часть)
	//---
	ЭлементСчета = Элементы["СуммыНДССчетНачислениеДт"];
	СтруктураДляПередачиНаСервер = УчетНДСКлиент.АвтоустановкаСубконто_ПолучитьТекущуюСтроку(ЭтаФорма, ЭлементСчета)["СтруктураДляПередачиНаСервер"];
	
	ПрименяемаяИнструкция_НастроитьТекущуюСтрокуСервер(Элементы["СуммыНДС"].ТекущаяСтрока, СтруктураДляПередачиНаСервер);
	
КонецПроцедуры

&НаКлиенте
Процедура СуммыНДССчетНачислениеДтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекДанные = Элементы["СуммыНДС"].ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент,
															СтандартнаяОбработка,
															Новый Структура("Счет, КПС, КЭК, КФО",
																			ТекДанные["СчетНачислениеДт"],
																			ТекДанные["КПСНачислениеДт"],
																			ТекДанные["КЭКНачислениеДт"],
																			ТекДанные["КФО"]),
															Объект["Организация"],
															Объект["ИФО"],
															УчетНДСКлиентСервер.ПрименяемаяИнструкция_ПолучитьЗначениеРеквизита("СчетНачислениеДт", ЭтаФорма, ТекДанные),
															ТекДанные["КФО"],
															УчетНДСКлиентСервер.ПрименяемаяИнструкция_ПолучитьЗначениеРеквизита("ВидыПоказателяКПСНачислениеДт", ЭтаФорма, ТекДанные),
															Объект["Дата"]);
КонецПроцедуры
