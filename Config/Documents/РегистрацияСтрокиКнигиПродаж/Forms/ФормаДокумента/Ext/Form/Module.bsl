&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//---
	// Таблица Суммы НДС, надпись "в рублях"
	//---
	ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Таблица ""Суммы НДС"" - надпись ""в рублях""'");
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='в рублях'"));
	// Условие
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение	= Истина;
	Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение	= Истина;
	// Оформляемые поля
	ИмяЭлемента = "СуммыНДСНадписьВРублях";
	ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
	ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	
	//---
	// Таблица Суммы НДС, надпись "в валюте"
	//---
	ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Таблица ""Суммы НДС"" - надпись ""в валюте""'");
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='в валюте'"));
	// Условие
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение	= Истина;
	Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение	= Истина;
	// Оформляемые поля
	ИмяЭлемента = "СуммыНДСНадписьВВалюте";
	ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
	ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	
	
	//---
	// Отметка пустых субконто
	//---
	ПоляСчетИСубконто = Новый Структура();
	ПоляСчетИСубконто.Вставить("ИмяРеквизитаСчет",		"СчетСписания");
	ПоляСчетИСубконто.Вставить("ИмяРеквизитаСубконто1",	"Субконто1Списания");
	ПоляСчетИСубконто.Вставить("ИмяРеквизитаСубконто2",	"Субконто2Списания");
	ПоляСчетИСубконто.Вставить("ИмяРеквизитаСубконто3",	"Субконто3Списания");
	ОтметкаПустыхСубконто_УстановитьУсловноеОформление("СуммыНДС", ПоляСчетИСубконто);
	
	ПоляСчетИСубконто = Новый Структура();
	ПоляСчетИСубконто.Вставить("ИмяРеквизитаСчет",		"СчетСписанияНУ");
	ПоляСчетИСубконто.Вставить("ИмяРеквизитаСубконто1",	"Субконто1СписанияНУ");
	ПоляСчетИСубконто.Вставить("ИмяРеквизитаСубконто2",	"Субконто2СписанияНУ");
	ПоляСчетИСубконто.Вставить("ИмяРеквизитаСубконто3",	"Субконто3СписанияНУ");
	ОтметкаПустыхСубконто_УстановитьУсловноеОформление("СуммыНДС", ПоляСчетИСубконто);
	
	ДобавитьУсловноеОформлениеПоляСчетовНачисление();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформлениеПоляСчетовНачисление()
	
	ПредставлениеШаблон = НСтр("ru='Таблица СуммыНДС, сброс отметки незаполненного поля %1 при отсутствии необходимости начисления налога'");
	
	ИменаКолонокСчетовНачисление = Документы.РегистрацияСтрокиКнигиПродаж.ПолучитьИменаКолонокСчетовНачисление();
	
	Для Каждого ИмяПоля Из ИменаКолонокСчетовНачисление Цикл
		
		ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблон, ИмяПоля);
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
		
		// Условие
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("Объект.СуммыНДС." + ИмяПоля);
		Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("Объект.СуммыНДС.СуммаНДС");
		Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("Объект.СуммыНДС.СуммаНДСВалютная");
		Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		// Оформляемые поля
		ИмяЭлемента = "СуммыНДС" + ИмяПоля;
		ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
		ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОписаниеПоляИтогов(ИмяЭлементаГруппы, ИмяЭлементаПоляРублевойСуммы, ЗаголовокЭлементаПоляРублевойСуммы = "", ОписаниеПолей)
	
	ОписаниеПоля = Новый Структура();
	
	ОписаниеПоля.Вставить("ИмяЭлементаГруппы",					ИмяЭлементаГруппы);
	ОписаниеПоля.Вставить("ИмяЭлементаПоляРублевойСуммы",		ИмяЭлементаПоляРублевойСуммы);
	ОписаниеПоля.Вставить("ЗаголовокЭлементаПоляРублевойСуммы",	ЗаголовокЭлементаПоляРублевойСуммы);
	
	ОписаниеПолей.Добавить(ОписаниеПоля);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыИтогов(ОписаниеПолей, ВидимостьВалютныхСумм)
	
	ОтображатьЗаголовокГруппы = ВидимостьВалютныхСумм;
	
	Для Каждого ОписаниеПоля Из ОписаниеПолей Цикл
		ИмяЭлементаГруппы					= ОписаниеПоля["ИмяЭлементаГруппы"];
		ИмяЭлементаПоляРублевойСуммы		= ОписаниеПоля["ИмяЭлементаПоляРублевойСуммы"];
		ЗаголовокЭлементаПоляРублевойСуммы	= ОписаниеПоля["ЗаголовокЭлементаПоляРублевойСуммы"];
		
		Если ВидимостьВалютныхСумм Тогда
			ОтображатьЗаголовокПоля	= ЗначениеЗаполнено(ЗаголовокЭлементаПоляРублевойСуммы);
			ЗаголовокПоля			= ЗаголовокЭлементаПоляРублевойСуммы;
		Иначе
			ОтображатьЗаголовокПоля = Истина;
			ЗаголовокПоля			= Элементы[ИмяЭлементаГруппы].Заголовок;
		КонецЕсли;
		
		// Элемент группы
		Элементы[ИмяЭлементаГруппы].ОтображатьЗаголовок = ОтображатьЗаголовокГруппы;
		
		// Элемент поля
		Элементы[ИмяЭлементаПоляРублевойСуммы].Заголовок = ЗаголовокПоля;
		Если ОтображатьЗаголовокПоля Тогда
			Элементы[ИмяЭлементаПоляРублевойСуммы].ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Лево;
		Иначе
			Элементы[ИмяЭлементаПоляРублевойСуммы].ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Нет;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТрансформироватьРеквизитыОбъектаВРеквизитыФормы()
	
	Если Объект["ДопЛист"] Тогда
		МестоЗаписи	= 1;
	Иначе
		МестоЗаписи = 0;
	КонецЕсли;
	
	ДатаКопия = Объект["Дата"];
	
КонецПроцедуры
&НаКлиенте
Процедура ТрансформироватьРеквизитыФормыВРеквизитыОбъекта()
	
	Если МестоЗаписи = 1 Тогда
		Объект["ДопЛист"] = Истина;
	Иначе
		Объект["ДопЛист"] = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьФормуСервер()
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	
	ИнициализироватьНастройкиЭлементовКолонок();
	
	// Значения, идентичные заданным в ОграниченияСписокСчетов (параметры выбора СчетСписания)
	СчетСписанияСписокВыбора = Новый СписокЗначений();
	СчетСписанияСписокВыбора.Добавить("109.00");
	СчетСписанияСписокВыбора.Добавить("401.20");
	
	УчетНДСКлиентСервер.ЗаполнитьСписокКодовВидовОпераций(
		Элементы["КодВидаОперации"].СписокВыбора,
		,
		Объект["Дата"]);
	
	//---
	// Механизм автоустановки субконто
	//---
	АвтоустановкаСубконто_Инициализация_Сервер();
	
	ПрименяемаяИнструкция_НастроитьФормуСервер(Ложь);
	
	УстановитьУсловноеОформление();
	
	//---
	// Документы остатков НДС
	//---
	ДокументыОстатковНДС_НастроитьФормуСервер();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьНастройкиЭлементовКолонок()
	
	КоллекцияСкрываемых = Новый Соответствие();
	
	СкрываемыеЭлементы = Новый Массив();
	СкрываемыеЭлементы.Добавить("СуммыНДСВсего");
	СкрываемыеЭлементы.Добавить("СуммыНДСВсегоВалютная");
	СкрываемыеЭлементы.Добавить("СуммыНДССумма");
	СкрываемыеЭлементы.Добавить("СуммыНДССуммаВалютная");
	СкрываемыеЭлементы.Добавить("СуммыНДСИтогСумма");			// подвал
	СкрываемыеЭлементы.Добавить("СуммыНДСИтогСуммаВалютная");	// подвал
	СкрываемыеЭлементы.Добавить("СуммыНДСИтогВсего");			// подвал
	СкрываемыеЭлементы.Добавить("СуммыНДСИтогВсегоВалютная");	// подвал
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученный, СкрываемыеЭлементы);
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.АвансВыданный, СкрываемыеЭлементы);
	
	СкрываемыеЭлементы = Новый Массив();
	СкрываемыеЭлементы.Добавить("СуммыНДСВсего");
	СкрываемыеЭлементы.Добавить("СуммыНДСВсегоВалютная");
	СкрываемыеЭлементы.Добавить("СуммыНДСИтогВсего");
	СкрываемыеЭлементы.Добавить("СуммыНДСИтогВсегоВалютная");
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйЛом, СкрываемыеЭлементы);
	
	СкрываемыеЭлементы = Новый Массив();
	СкрываемыеЭлементы.Добавить("СуммыНДСВсегоАванс");
	СкрываемыеЭлементы.Добавить("СуммыНДСВсегоАвансВалютная");
	СкрываемыеЭлементы.Добавить("СуммыНДСИтогВсегоАванс");
	СкрываемыеЭлементы.Добавить("СуммыНДСИтогВсегоАвансВалютная");
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.РеализацияЛом, СкрываемыеЭлементы);
	
	СкрываемыеЭлементы = Новый Массив();
	СкрываемыеЭлементы.Добавить("СуммыНДСВсегоАванс");
	СкрываемыеЭлементы.Добавить("СуммыНДСВсегоАвансВалютная");
	СкрываемыеЭлементы.Добавить("СуммыНДСИтогВсегоАванс");			// подвал
	СкрываемыеЭлементы.Добавить("СуммыНДСИтогВсегоАвансВалютная");	// подвал
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.ПустаяСсылка(), СкрываемыеЭлементы);
	
	УчетНДС.ИнициализироватьНастройкиЭлементовКолонок(ЭтаФорма, КоллекцияСкрываемых);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытииНастроитьФормуКлиент()
	
	ТрансформироватьРеквизитыОбъектаВРеквизитыФормы();
	
	МестоЗаписиПриИзмененииКлиент();
	
	ДействиеПриИзмененииНастроитьФормуКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзмененииКлиент()
	
	ЗаполнитьНаОснованииКлиент();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСерверДляТекущегоРежимаРаботы()
	
	// Реквизиты документа-основания недоступны для редактирования при заполненном основании
	НовыйТолькоПросмотр = (ЗначениеЗаполнено(Объект["ДокументОснование"]));
	РеквизитыДокументаОснования = Новый Структура("
		|Контрагент,
		|Договор,
		|ПричинаНалогообложения,
		|ВалютаДокумента");
	Для Каждого Реквизит Из РеквизитыДокументаОснования Цикл
		Элементы[Реквизит.Ключ].ТолькоПросмотр = НовыйТолькоПросмотр;
	КонецЦикла;
	
	СкрытьНеиспользуемыеРеквизиты();
	
	//---
	// Отметка пустых субконто
	//---
	ОтметкаПустыхСубконто_ЗаполнитьСлужебныеКолонки();
	
КонецПроцедуры

&НаСервере
Процедура СкрытьНеиспользуемыеРеквизиты()
	
	ПризнакиИспользованияРеквизитов = Документы.РегистрацияСтрокиКнигиПродаж.ПолучитьПризнакиИспользованияРеквизитов(Объект);
	
	Для Каждого ПризнакИспользования Из ПризнакиИспользованияРеквизитов["Шапка"] Цикл
		ИмяРеквизита			= ПризнакИспользования["ИмяРеквизита"];
		РеквизитИспользуется	= ПризнакИспользования["Видимость"];
		Элементы[ИмяРеквизита].Видимость = РеквизитИспользуется;
	КонецЦикла;
	
	Для Каждого ПризнакИспользования Из ПризнакиИспользованияРеквизитов["СуммыНДС"] Цикл
		ИмяРеквизита			= ПризнакИспользования["ИмяРеквизита"];
		РеквизитИспользуется	= ПризнакИспользования["Видимость"];
		Элементы["СуммыНДС" + ИмяРеквизита].Видимость = РеквизитИспользуется;
	КонецЦикла;
	
	СкрытьНеиспользуемыеРеквизитыВалютныхСумм();
	
КонецПроцедуры

&НаСервере
Процедура СкрытьНеиспользуемыеРеквизитыВалютныхСумм()
	
	ПоказыватьВалютныеСуммы = Документы.РегистрацияСтрокиКнигиПродаж.ПоказыватьВалютныеСуммы(Объект["ВалютаДокумента"]);
	
	Элементы["СуммыНДСНадписьВРублях"].Видимость	= ПоказыватьВалютныеСуммы;
	Элементы["СуммыНДСНадписьВВалюте"].Видимость	= ПоказыватьВалютныеСуммы;
	
	// Валютные суммы
	Элементы["СуммыНДССуммаНДСВалютная"].Видимость		= ПоказыватьВалютныеСуммы;
	// Учитываем результат работы АвансНеАванс
	Элементы["СуммыНДССуммаВалютная"].Видимость			= ПоказыватьВалютныеСуммы И Элементы["СуммыНДССумма"].Видимость;
	Элементы["СуммыНДСВсегоВалютная"].Видимость			= ПоказыватьВалютныеСуммы И Элементы["СуммыНДСВсего"].Видимость;
	Элементы["СуммыНДСВсегоАвансВалютная"].Видимость	= ПоказыватьВалютныеСуммы И Элементы["СуммыНДСВсегоАванс"].Видимость;
	
	// Итоги
	Элементы["СуммыНДСИтогСуммаНДСВалютная"].Видимость		= ПоказыватьВалютныеСуммы;
	// Учитываем результат работы АвансНеАванс
	Элементы["СуммыНДСИтогСуммаВалютная"].Видимость			= ПоказыватьВалютныеСуммы И Элементы["СуммыНДССумма"].Видимость;
	Элементы["СуммыНДСИтогВсегоВалютная"].Видимость			= ПоказыватьВалютныеСуммы И Элементы["СуммыНДСВсего"].Видимость;
	Элементы["СуммыНДСИтогВсегоАвансВалютная"].Видимость	= ПоказыватьВалютныеСуммы И Элементы["СуммыНДСВсегоАванс"].Видимость;
	
	
	// ВНЕШНИЙ ВИД ИТОГОВ ТАБЛИЦ
	//
	//	----------------------------------------
	//			ПоказыватьВалютныеСуммы
	//	--------------------+-------------------
	//			Истина		|		Ложь
	//	--------------------+-------------------
	//	Всего               |
	//	в рублях: _________	|	Всего: _________
	//	в валюте: _________	|
	//	----------------------------------------
	
	//---
	// Итоги таблицы Суммы НДС
	//---
	ОписаниеПолей = Новый Массив();
	//							Имя элемента-группы		Имя элемента-поля для рублевой суммы    Заголовок элемента-поля для рублевой суммы
	ДобавитьОписаниеПоляИтогов("ИтогиСуммаБезНДС",		"СуммыНДСИтогСумма",					НСтр("ru='в рублях'"),	ОписаниеПолей);
	ДобавитьОписаниеПоляИтогов("ИтогиВсегоАванс",		"СуммыНДСИтогВсегоАванс",				НСтр("ru='в рублях'"),	ОписаниеПолей);
	ДобавитьОписаниеПоляИтогов("ИтогиНДС",				"СуммыНДСИтогСуммаНДС",,										ОписаниеПолей);
	ДобавитьОписаниеПоляИтогов("ИтогиВсего",			"СуммыНДСИтогВсего",,											ОписаниеПолей);
	НастроитьЭлементыИтогов(ОписаниеПолей, ПоказыватьВалютныеСуммы);
	
	Элементы.Курс.ТолькоПросмотр = Не ПоказыватьВалютныеСуммы;
	Элементы.Кратность.ТолькоПросмотр = Не ПоказыватьВалютныеСуммы;
	
КонецПроцедуры

&НаКлиенте
Процедура ДействиеПриИзмененииНастроитьФормуКлиент()
	
	Если Объект["Действие"] = ПредопределенноеЗначение("Перечисление.ВариантыРегистрацииСтрокиКнигиПродаж.Аннулирование") Тогда
		НовДоступностьСуммыНДС	= Ложь;
		НовЦветТекстаСуммыНДС	= Новый Цвет(96, 96, 96);
	Иначе
		НовДоступностьСуммыНДС	= Истина;
		НовЦветТекстаСуммыНДС	= Новый Цвет();
	КонецЕсли;
	Элементы["СуммыНДС"].ТолькоПросмотр = НЕ НовДоступностьСуммыНДС;
	Элементы["СуммыНДС"].ЦветТекста = НовЦветТекстаСуммыНДС;
	Элементы["СуммыНДСКомандаНадписьАннулирование"].Доступность = НЕ НовДоступностьСуммыНДС;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНалоговыйПериодПредставление()
	
	Если Объект["ДопЛист"] Тогда
		ПроверяемаяДата = Объект["КорректируемыйПериод"];
	Иначе
		ПроверяемаяДата = Объект["Дата"];
	КонецЕсли;
	
	НалоговыйПериодПредставление = ПолучитьНалоговыйПериодПредставление(Объект["Организация"], ПроверяемаяДата);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНалоговыйПериодПредставление(Организация, Дата)
	
	СвойстваНалоговогоПериода = УчетНДС.ПолучитьСвойстваНалоговогоПериода(Организация, Дата);
	
	Возврат СвойстваНалоговогоПериода["ПериодПредставление"];
	
КонецФункции

&НаКлиенте
Процедура МестоЗаписиПриИзмененииКлиент()
	
	ТрансформироватьРеквизитыФормыВРеквизитыОбъекта();
	
	НастроитьФормуКлиент_КорректируемыйПериод();
	
	ОбновитьНалоговыйПериодПредставление();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент_КорректируемыйПериод()
	
	НовТолькоПросмотр = НЕ Объект["ДопЛист"];
	
	Элементы["КорректируемыйПериод"].ТолькоПросмотр = НовТолькоПросмотр;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДатаКопия(Форма)
	
	Форма["ДатаКопия"] = Форма.Объект["Дата"];
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыВСтроке(Элемент)
	
	ТекДанные = Элементы.СуммыНДС.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяЭлемента = Элемент.Имя;
	
	Если ИмяЭлемента = "СуммыНДССумма" Тогда
		ИмяИзмененногоПоля = "Сумма";
		
	ИначеЕсли ИмяЭлемента = "СуммыНДССуммаНДС" Тогда
		ИмяИзмененногоПоля = "СуммаНДС";
		
	ИначеЕсли	ИмяЭлемента = "СуммыНДСВсего"
		ИЛИ		ИмяЭлемента = "СуммыНДСВсегоАванс"	Тогда
		ИмяИзмененногоПоля = "Всего";
		
	ИначеЕсли ИмяЭлемента = "СуммыНДССтавкаНДС" Тогда
		ИмяИзмененногоПоля = "СтавкаНДС";
		
		
	ИначеЕсли ИмяЭлемента = "СуммыНДССуммаВалютная" Тогда
		ИмяИзмененногоПоля = "СуммаВалютная";
		
	ИначеЕсли ИмяЭлемента = "СуммыНДССуммаНДСВалютная" Тогда
		ИмяИзмененногоПоля = "СуммаНДСВалютная";
		
	ИначеЕсли	ИмяЭлемента = "СуммыНДСВсегоВалютная"
		ИЛИ		ИмяЭлемента = "СуммыНДСВсегоАвансВалютная"	Тогда
		ИмяИзмененногоПоля = "ВсегоВалютная";
		
	Иначе
		// Выходим
		Возврат;
	КонецЕсли;
	
	СтруктураИменПолей = Новый Структура();
	СтруктураИменПолей.Вставить("Сумма",	"Сумма");
	СтруктураИменПолей.Вставить("СуммаНДС",	"СуммаНДС");
	СтруктураИменПолей.Вставить("Всего",	"Всего");
	СтруктураИменПолей.Вставить("СтавкаНДС","СтавкаНДС");
	
	Если ПоказыватьВалютныеСуммы Тогда
		СтруктураИменПолей.Вставить("СуммаВалютная",	"СуммаВалютная");
		СтруктураИменПолей.Вставить("СуммаНДСВалютная",	"СуммаНДСВалютная");
		СтруктураИменПолей.Вставить("ВсегоВалютная",	"ВсегоВалютная");
	КонецЕсли;
	
	УчетНДСКлиентСервер.РассчитатьСуммы(ТекДанные, ИмяИзмененногоПоля, СтруктураИменПолей, ЭтоАванс, ЭтоНалоговыйАгент,, Объект.Курс, Объект.Кратность);
	
	Если Не ПоказыватьВалютныеСуммы Тогда
		Если ИспользоватьВалютныйУчет Тогда
			ЗаполнитьВалютныеСуммы(ТекДанные);
		Иначе
			ОчиститьВалютныеСуммы(ТекДанные);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВалютаПриИзмененииСервер()
	
	ОбновитьКурсВалюты();
	
	ПересчитатьРублевыеСуммыПоКурсу();
	
	СкрытьНеиспользуемыеРеквизитыВалютныхСумм();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКурсВалюты()
	
	КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.ВалютаДокумента, Объект.Дата);
	
	ЗаполнитьЗначенияСвойств(Объект, КурсКратность, "Курс,Кратность");
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьРублевыеСуммыПоКурсу()
	
	Если Объект.Кратность = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.СуммыНДС Цикл
		Если ЭтоАванс Тогда
			СтрокаТаблицы.Всего		= СтрокаТаблицы.ВсегоВалютная * Объект.Курс / Объект.Кратность;
			СтрокаТаблицы.СуммаНДС	= СтрокаТаблицы.СуммаНДСВалютная * Объект.Курс / Объект.Кратность;
			СтрокаТаблицы.Сумма		= СтрокаТаблицы.Всего - СтрокаТаблицы.СуммаНДС;
		Иначе
			СтрокаТаблицы.Сумма		= СтрокаТаблицы.СуммаВалютная * Объект.Курс / Объект.Кратность;
			СтрокаТаблицы.СуммаНДС	= СтрокаТаблицы.СуммаНДСВалютная * Объект.Курс / Объект.Кратность;
			СтрокаТаблицы.Всего		= СтрокаТаблицы.Сумма + СтрокаТаблицы.СуммаНДС;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьНаОснованииКлиент(ВыводитьПредупреждение = Истина)
	
	Если ЗначениеЗаполнено(Объект["ДокументОснование"]) Тогда
		ТекстСообщения = НСтр("ru='Заполнить документ по документу-основанию?'");
		
		ОписаниеОповещенияОВыборе = Новый ОписаниеОповещения("ПроверитьИЗаполнитьНаОснованииКлиент_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОВыборе, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		Если ВыводитьПредупреждение Тогда
			ТекстСообщения = НСтр("ru='Не заполнено поле Документ-основание'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстСообщения,
				Объект.Ссылка,
				"Объект.ДокументОснование");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьНаОснованииКлиент_Выбор(Результат, ПараметрыОповещения) Экспорт
	
	Перем ОписаниеОшибки;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьНаОснованииКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаОснованииКлиент()
	
	ДокументОснованиеОчищен = (Объект["ДокументОснование"] = Неопределено);
	
	Если ЗначениеЗаполнено(Объект["ДокументОснование"]) ИЛИ ДокументОснованиеОчищен Тогда
		ВыполнитьЗаполнениеНаОснованииКлиент("ДокументОснование");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаполнениеНаОснованииКлиент(ИмяИзмененногоПоля)
	
	Перем	ОписаниеОшибки,
			ДействиеДопустимое;
			
	ИзмененоПолеДействие = (ИмяИзмененногоПоля = "Действие");
	
	Если ВыполнитьЗаполнениеНаОснованииСервер(ОписаниеОшибки, ДействиеДопустимое, ИмяИзмененногоПоля) Тогда
		
		ПриОткрытииНастроитьФормуКлиент();
		
	Иначе
		Если ИзмененоПолеДействие Тогда
			Если ДействиеДопустимое Тогда
				ИмяПоляДляВыводаСообщений = "ДокументОснование";
				ТекстСообщения = НСтр("ru='Не удалось заполнить документ на основании:
					|'") + ОписаниеОшибки;
			Иначе
				ИмяПоляДляВыводаСообщений = "Действие";
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Отменено изменение поля Действие.
						|Для указанного документа-основания
						|не поддерживается %1'"),
					Строка(Объект["Действие"]));
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстСообщения,
				Объект["Ссылка"],
				"Объект." + ИмяПоляДляВыводаСообщений);
		Иначе
			Если ЗначениеЗаполнено(Объект["ДокументОснование"]) Тогда
				ИмяПоляДляВыводаСообщений = "ДокументОснование";
				ТекстСообщения = ОписаниеОшибки;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					ТекстСообщения,
					Объект["Ссылка"],
					"Объект." + ИмяПоляДляВыводаСообщений);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ДействиеДопустимое И ИзмененоПолеДействие Тогда
		ОтменитьИзменениеДействия();
	КонецЕсли;
	
	ЗапомнитьТекущееДействие();
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗаполнениеНаОснованииСервер(ВозвратОписаниеОшибки, ВозвратДействиеДопустимое, ИмяИзмененногоПоля)
	
	ИзмененоПолеДействие = (ИмяИзмененногоПоля = "Действие");
	
	Если ИзмененоПолеДействие Тогда
		// Необходимо проверить, является ли допустимым новое действие
		ВозвратДействиеДопустимое	= ДействиеДопустимоеСервер();
		СледуетЗаполнитьНаОсновании	= ВозвратДействиеДопустимое;
	Иначе
		// Заполняем в любом случае, действие автоматически установится в корректное значение
		СледуетЗаполнитьНаОсновании	= Истина;
		ОчищающаяСтруктура = Новый Структура("
			|Контрагент,
			|Договор,
			|ПричинаНалогообложения,
			|ВалютаДокумента,
			|ДатаПервичногоДокумента,
			|НомерПервичногоДокумента,
			|ДатаОплаты,
			|КодВидаОперации");
		ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
		Объект["СуммыНДС"].Очистить();
	КонецЕсли;
	
	Если СледуетЗаполнитьНаОсновании Тогда
		Если ЗначениеЗаполнено(Объект["ДокументОснование"]) Тогда
			ЗаполнениеВыполнено = Документы.РегистрацияСтрокиКнигиПродаж.ЗаполнитьНаОсновании(Объект["ДокументОснование"], Объект, ВозвратОписаниеОшибки);
			
			Если ЗаполнениеВыполнено Тогда
				Модифицированность = Истина;
				ОбновитьДатаКопия(ЭтаФорма);
			КонецЕсли;
		Иначе
			ЗаполнениеВыполнено = Истина;
		КонецЕсли;
		
		ПрименяемаяИнструкция_НастроитьФормуСервер(Ложь); // размещаем здесь для экономии серверного вызова
		
		ВозвратДействиеДопустимое = ДействиеДопустимоеСервер();
	Иначе
		ЗаполнениеВыполнено = Ложь;
	КонецЕсли;
	
	Возврат ЗаполнениеВыполнено;
	
КонецФункции

&НаКлиенте
Процедура ОтменитьИзменениеДействия()
	
	Объект["Действие"] = ДействиеПрежнееЗначение;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьТекущееДействие()
	
	ДействиеПрежнееЗначение = Объект["Действие"];
	
КонецПроцедуры

&НаКлиенте
Процедура ДействиеПриИзмененииКлиент()
	
	Если ЗначениеЗаполнено(Объект["ДокументОснование"]) Тогда
		ТекстВопроса = НСтр("ru='При изменении действия документ будет перезаполнен по документу-основанию.
			|Продолжить?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ДействиеПриИзмененииКлиент_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20 ,КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ВыполнитьЗаполнениеНаОснованииКлиент("Действие");
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ДействиеПриИзмененииКлиент_Выбор(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыполнитьЗаполнениеНаОснованииКлиент("Действие");
	Иначе
		ОтменитьИзменениеДействия();
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Функция ДействиеДопустимоеСервер()
	
	СписокДопустимыхДействий = Документы.РегистрацияСтрокиКнигиПродаж.ПолучитьСписокДопустимыхДействий(Объект);
	ДействиеДопустимое = НЕ (СписокДопустимыхДействий.Найти(Объект["Действие"]) = Неопределено);
	
	Если ДействиеДопустимое Тогда
		СкрытьНеиспользуемыеРеквизиты(); // Располагаем здесь для экономии серверного вызова
	КонецЕсли;
	
	Возврат ДействиеДопустимое;
	
КонецФункции

//---
// Механизм автоустановки субконто
//---

&НаСервере
Процедура АвтоустановкаСубконто_Инициализация_Сервер() Экспорт
	
	МассивСтруктурНастроек = УчетНДС.АвтоустановкаСубконто_ПолучитьМассивСтруктурНастроек_РегистрацияСтрокиКнигиПродаж();
	
	УчетНДС.АвтоустановкаСубконто_Инициализация(ЭтаФорма, МассивСтруктурНастроек);
	
КонецПроцедуры

// Вызывается механизмом при начале выбора субкнто в редактируемой таблице.
&НаКлиенте
Процедура Переопределяемый_АвтоустановкаСубконто_СубконтоНачалоВыбора_Клиент(СтруктураВыбораСубконто) Экспорт
	
	ТекущиеДанные = Элементы["СуммыНДС"].ТекущиеДанные;
	
	// Здесь можно модифицировать структуру СтруктураВыбораСубконто
	СтруктураВыбораСубконто.Вставить("Организация",	Объект["Организация"]);
	СтруктураВыбораСубконто.Вставить("КПС",			ТекущиеДанные["КПСНачислениеДт"]);
	СтруктураВыбораСубконто.Вставить("КФО",			ТекущиеДанные["КФО"]);
	
КонецПроцедуры

&НаСервере
Процедура АвтоустановкаСубконто_ВыполнитьАвтоустановкуЗначений_Сервер(ИмяЭлементаТаблица = Неопределено)
	
	УчетНДС.АвтоустановкаСубконто_ВыполнитьАвтоустановкуЗначений(ЭтаФорма, ИмяЭлементаТаблица);
	
КонецПроцедуры

&НаСервере
Процедура АвтоустановкаСубконто_ПриИзмененииСчета_Сервер(ИмяЭлемента, СтруктураТекущаяСтрока)
	
	УчетНДС.АвтоустановкаСубконто_ПриИзмененииСчета(ЭтаФорма, ИмяЭлемента, СтруктураТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура АвтоустановкаСубконто_ПриИзмененииЗначенияАвтоустановки_Сервер(ИмяЭлемента, СтруктураТекущаяСтрока)
	
	УчетНДС.АвтоустановкаСубконто_ПриИзмененииЗначенияАвтоустановки(ЭтаФорма, ИмяЭлемента, СтруктураТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура АвтоустановкаСубконто_ПослеЗаписиНаСервере_Сервер()
	
	УчетНДС.АвтоустановкаСубконто_ПослеЗаписиНаСервере(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_АвтоустановкаСубконто_ПослеЗаписиНаСервере_Клиент()
	
	АвтоустановкаСубконто_ПослеЗаписиНаСервере_Сервер();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_АвтоустановкаСубконто_ПриИзмененииСчета_Клиент(Элемент)
	
	СтруктураДляПередачиНаСервер = УчетНДСКлиент.АвтоустановкаСубконто_ПолучитьТекущуюСтроку(ЭтаФорма, Элемент)["СтруктураДляПередачиНаСервер"];
	
	АвтоустановкаСубконто_ПриИзмененииСчета_Сервер(Элемент.Имя, СтруктураДляПередачиНаСервер);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_АвтоустановкаСубконто_ПриИзмененииЗначенияАвтоустановки_Клиент(Элемент)
	
	СтруктураДляПередачиНаСервер = УчетНДСКлиент.АвтоустановкаСубконто_ПолучитьТекущуюСтроку(ЭтаФорма, Элемент)["СтруктураДляПередачиНаСервер"];
	
	АвтоустановкаСубконто_ПриИзмененииЗначенияАвтоустановки_Сервер(Элемент.Имя, СтруктураДляПередачиНаСервер);
	
КонецПроцедуры

