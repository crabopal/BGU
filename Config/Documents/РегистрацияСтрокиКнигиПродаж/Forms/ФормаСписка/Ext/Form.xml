	ДокументРегистрацияСтрокиКнигиПродаж.ИФО,
	ДокументРегистрацияСтрокиКнигиПродаж.Подразделение,
	ДокументРегистрацияСтрокиКнигиПродаж.Комментарий,
	ДокументРегистрацияСтрокиКнигиПродаж.Контрагент,
	ДокументРегистрацияСтрокиКнигиПродаж.Договор,
	ДокументРегистрацияСтрокиКнигиПродаж.ВалютаДокумента,
	ДокументРегистрацияСтрокиКнигиПродаж.СуммаДокумента,
	ДокументРегистрацияСтрокиКнигиПродаж.СуммаНДС,
	ДокументРегистрацияСтрокиКнигиПродаж.КорректируемыйПериод,
	ДокументРегистрацияСтрокиКнигиПродаж.ДатаОплаты,
	ДокументРегистрацияСтрокиКнигиПродаж.ПричинаНалогообложения,
	ДокументРегистрацияСтрокиКнигиПродаж.ДокументОснование,
	ДокументРегистрацияСтрокиКнигиПродаж.ДатаПервичногоДокумента,
	ДокументРегистрацияСтрокиКнигиПродаж.НомерПервичногоДокумента,
	ДокументРегистрацияСтрокиКнигиПродаж.СуммыНДС.(
		Ссылка,
		НомерСтроки,
		ОбъектНалогообложения,
		Сумма,
		СтавкаНДС,
		СуммаНДС,
		Всего,
		КФО,
		СчетНачислениеДт,
		КПСНачислениеДт,
		КЭКНачислениеДт,
		Субконто1НачислениеДт,
		Субконто2НачислениеДт,
		Субконто3НачислениеДт,
		Счет30304,
		КПС30304,
		СчетСписания,
		КПССписания,
		КЭКСписания,
		Субконто1Списания,
		Субконто2Списания,
		Субконто3Списания,
		СчетСписанияНУ,
		Субконто1СписанияНУ,
		Субконто2СписанияНУ,
		Субконто3СписанияНУ,
		СуммаВалютная,
		СуммаНДСВалютная,
		ВсегоВалютная
	),
	ДокументРегистрацияСтрокиКнигиПродаж.МоментВремени,
	ДокументРегистрацияСтрокиКнигиПродаж.Действие,
	ДокументРегистрацияСтрокиКнигиПродаж.ДопЛист,
	ОперацииДокументов.Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
