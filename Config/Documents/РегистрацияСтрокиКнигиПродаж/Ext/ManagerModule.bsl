	ТабличныеЧасти	= Новый Структура("СуммыНДС", ТаблицаСуммыНДС);
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ОтчетОРозничныхПродажах(ОснованиеСсылка, Действие, ВозвратДанные) Экспорт
	
	// Возвращаемое значение
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Получаем данные           
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("ВалютаРУ",					Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Табличная часть документа-основания
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки,
	|	Сумма,
	|	СтавкаНДС,
	|	СуммаНДС
	|ПОМЕСТИТЬ
	|	ТаблицаПродажи
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах.Продажи	КАК Продажи
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка
	|ИНДЕКСИРОВАТЬ ПО
	|	Сумма
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Проводки документа-основания
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.НомерСтроки,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма
	|ПОМЕСТИТЬ
	|	ПроводкиДокументаОснования
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(, , Регистратор = &ДокументОснованиеСсылка)	КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|ИНДЕКСИРОВАТЬ ПО
	|	Сумма
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Номера используемых строк в таблице проводок документа-основания
	|//
	|ВЫБРАТЬ
	|	ТаблицаПродажи.Сумма							КАК Сумма,
	|	МИНИМУМ(ПроводкиДокументаОснования.НомерСтроки)	КАК НомерСтроки
	|ПОМЕСТИТЬ
	|	ПроводкиДокументаОснованияНомераИспользуемыхСтрок
	|ИЗ
	|	ПроводкиДокументаОснования
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ТаблицаПродажи
	|		ПО	ПроводкиДокументаОснования.Сумма = ТаблицаПродажи.Сумма
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаПродажи.Сумма
	|ИНДЕКСИРОВАТЬ ПО
	|	ТаблицаПродажи.Сумма
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗНАЧЕНИЕ(Перечисление.ВариантыРегистрацииСтрокиКнигиПродаж.Регистрация)	КАК Действие,
	|	ЛОЖЬ																	КАК ДопЛист,
	|	Ссылка																	КАК ДокументОснование,
	|	Контрагент																КАК Контрагент,
	|	НЕОПРЕДЕЛЕНО															КАК Договор,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)				КАК ПричинаНалогообложения,
	|	&ВалютаРУ																КАК ВалютаДокумента,
	|	Организация																КАК Организация,
	|	Подразделение															КАК Подразделение,
	|	ИФО																		КАК ИФО,
	|	Дата																	КАК ДатаОплаты,
	|	ВидПервичногоДокумента													КАК ВидПервичногоДокумента,
	|	ДатаПервичногоДокумента													КАК ДатаПервичногоДокумента,
	|	НомерПервичногоДокумента												КАК НомерПервичногоДокумента,
	|	""01""																	КАК КодВидаОперации
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах КАК ОтчетОРозничныхПродажах
	|ГДЕ
	|	ОтчетОРозничныхПродажах.Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Данные для табличной части ""СуммыНДС""
	|//
	|ВЫБРАТЬ
	|	ТаблицаПродажи.Сумма								КАК Всего,
	|	ТаблицаПродажи.СтавкаНДС							КАК СтавкаНДС,
	|	ТаблицаПродажи.СуммаНДС								КАК СуммаНДС,
	|	ТаблицаПродажи.Сумма - ТаблицаПродажи.СуммаНДС		КАК Сумма,
	|	ЕСТЬNULL(ПроводкиДокументаОснования.КФО, ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка))								КАК КФО,
	|	ЕСТЬNULL(ПроводкиДокументаОснования.СчетДт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))							КАК СчетНачислениеДт,
	|	ЕСТЬNULL(ПроводкиДокументаОснования.СубконтоДт1, НЕОПРЕДЕЛЕНО)													КАК Субконто1НачислениеДт,
	|	ЕСТЬNULL(ПроводкиДокументаОснования.СубконтоДт2, НЕОПРЕДЕЛЕНО)													КАК Субконто2НачислениеДт,
	|	ЕСТЬNULL(ПроводкиДокументаОснования.СубконтоДт3, НЕОПРЕДЕЛЕНО)													КАК Субконто3НачислениеДт,
	|	ЕСТЬNULL(ПроводкиДокументаОснования.КПСДт, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка))	КАК КПСНачислениеДт,
	|	ЕСТЬNULL(ПроводкиДокументаОснования.КЭКДт, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка))								КАК КЭКНачислениеДт
	|ИЗ
	|	ТаблицаПродажи
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ПроводкиДокументаОснованияНомераИспользуемыхСтрок	КАК НомераСтрок
	|		ПО	ТаблицаПродажи.Сумма = НомераСтрок.Сумма
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ПроводкиДокументаОснования
	|		ПО	НомераСтрок.НомерСтроки = ПроводкиДокументаОснования.НомерСтроки
	|;";
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	//	[3] Данные для реквизитов шапки
	ТаблицаШапка = РезультатыЗаполнения[3].Выгрузить();
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = ПолучитьШапкуДокумента();
	КонецЕсли;
	ЗаполнитьОбщиеРеквизиты(Шапка, Действие);
	
	Шапка.Вставить("Дата", ТекущаяДатаСеанса());
	
	//	[4] Данные для табличной части ""СуммыНДС""
	ТаблицаСуммыНДС	= РезультатыЗаполнения[4].Выгрузить();
	
	// Заполняем полные счета и аналитику
	ПараметрыЗаполнения = Новый Структура();
	ПараметрыЗаполнения.Вставить("ЗаполнитьСчетНачислениеДт",	Ложь);
	ПараметрыЗаполнения.Вставить("ЗаполнитьСчет30304",			Истина);
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСуммыНДС, ПараметрыЗаполнения);
	
	// Искомые данные
	ТабличныеЧасти	= Новый Структура("СуммыНДС", ТаблицаСуммыНДС);
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ОтчетПоКассовойСмене(ОснованиеСсылка, Действие, ВозвратДанные) Экспорт
	
	// Возвращаемое значение
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Получаем данные
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("СчетУчетаРозницы",	БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("401.10"));
	ЗапросЗаполнение.УстановитьПараметр("ВалютаРУ",					Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросЗаполнение.УстановитьПараметр("СтавкаНДСБезНДС",			Перечисления.СтавкиНДС.БезНДС);
	
	ЗапросЗаполнение.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                         |	СУММА(Продажи.Сумма) КАК Сумма,
	                         |	Продажи.СтавкаНДС,
	                         |	СУММА(Продажи.СуммаНДС) КАК СуммаНДС,
	                         |	Продажи.СтатьяАналитикиОплаты.КФО КАК КФО,
	                         |	Продажи.СтатьяАналитикиОплаты.КПС КАК КПС,
	                         |	Продажи.СтатьяАналитикиОплаты.КЭК КАК КЭК
	                         |ПОМЕСТИТЬ ТаблицаПродажи
	                         |ИЗ
	                         |	Документ.ОтчетПоКассовойСмене.ПродажиПоСтавкамНДС КАК Продажи
	                         |ГДЕ
	                         |	Продажи.Ссылка = &ДокументОснованиеСсылка
	                         |	И Продажи.ЭтоРозничныйПокупатель = ИСТИНА
	                         |	И НЕ Продажи.СтавкаНДС = &СтавкаНДСБезНДС
	                         |
	                         |СГРУППИРОВАТЬ ПО
	                         |	Продажи.СтавкаНДС,
	                         |	Продажи.СтатьяАналитикиОплаты.КФО,
	                         |	Продажи.СтатьяАналитикиОплаты.КПС,
	                         |	Продажи.СтатьяАналитикиОплаты.КЭК
	                         |;
	                         |
	                         |////////////////////////////////////////////////////////////////////////////////
	                         |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                         |	ЗНАЧЕНИЕ(Перечисление.ВариантыРегистрацииСтрокиКнигиПродаж.Регистрация) КАК Действие,
	                         |	ЛОЖЬ КАК ДопЛист,
	                         |	ОтчетПоКассовойСмене.Ссылка КАК ДокументОснование,
	                         |	ВЫРАЗИТЬ(ОтчетПоКассовойСмене.КассаККМ КАК Справочник.ФискальныеРегистраторы).КонтрагентДляРозничныхПродаж КАК Контрагент,
	                         |	НЕОПРЕДЕЛЕНО КАК Договор,
	                         |	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация) КАК ПричинаНалогообложения,
	                         |	&ВалютаРУ КАК ВалютаДокумента,
	                         |	ОтчетПоКассовойСмене.Организация КАК Организация,
	                         |	ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) КАК Подразделение,
	                         |	ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка) КАК ИФО,
	                         |	ОтчетПоКассовойСмене.КассоваяСмена.Дата КАК ДатаОплаты,
	                         |	""Отчет о закрытии смены"" КАК ВидПервичногоДокумента,
	                         |	ОтчетПоКассовойСмене.КассоваяСмена.Дата КАК ДатаПервичногоДокумента,
	                         |	ОтчетПоКассовойСмене.КассоваяСмена.НомерСменыККТ КАК НомерПервичногоДокумента,
	                         |	""01"" КАК КодВидаОперации
	                         |ИЗ
	                         |	Документ.ОтчетПоКассовойСмене КАК ОтчетПоКассовойСмене
	                         |ГДЕ
	                         |	ОтчетПоКассовойСмене.Ссылка = &ДокументОснованиеСсылка
	                         |;
	                         |
	                         |////////////////////////////////////////////////////////////////////////////////
	                         |ВЫБРАТЬ
	                         |	ТаблицаПродажи.Сумма КАК Всего,
	                         |	ТаблицаПродажи.СтавкаНДС КАК СтавкаНДС,
	                         |	ТаблицаПродажи.СуммаНДС КАК СуммаНДС,
	                         |	ТаблицаПродажи.Сумма - ТаблицаПродажи.СуммаНДС КАК Сумма,
	                         |	ТаблицаПродажи.КФО КАК КФО,
	                         |	&СчетУчетаРозницы КАК СчетНачислениеДт,
	                         |	НЕОПРЕДЕЛЕНО КАК Субконто1НачислениеДт,
	                         |	НЕОПРЕДЕЛЕНО КАК Субконто2НачислениеДт,
	                         |	НЕОПРЕДЕЛЕНО КАК Субконто3НачислениеДт,
	                         |	ТаблицаПродажи.КПС КАК КПСНачислениеДт,
	                         |	ТаблицаПродажи.КЭК КАК КЭКНачислениеДт
	                         |ИЗ
	                         |	ТаблицаПродажи КАК ТаблицаПродажи";
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	//	[1] Данные для реквизитов шапки
	ТаблицаШапка = РезультатыЗаполнения[1].Выгрузить();
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = ПолучитьШапкуДокумента();
	КонецЕсли;
	ЗаполнитьОбщиеРеквизиты(Шапка, Действие);
	
	Шапка.Вставить("Дата", ТекущаяДатаСеанса());
	
	//	[2] Данные для табличной части ""СуммыНДС""
	ТаблицаСуммыНДС	= РезультатыЗаполнения[2].Выгрузить();
	
	// Заполняем полные счета и аналитику
	ПараметрыЗаполнения = Новый Структура();
	ПараметрыЗаполнения.Вставить("ЗаполнитьСчетНачислениеДт",	Ложь);
	ПараметрыЗаполнения.Вставить("ЗаполнитьСчет30304",			Истина);
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСуммыНДС, ПараметрыЗаполнения);
	
	// Искомые данные
	ТабличныеЧасти	= Новый Структура("СуммыНДС", ТаблицаСуммыНДС);
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Истина;
	
КонецФункции

