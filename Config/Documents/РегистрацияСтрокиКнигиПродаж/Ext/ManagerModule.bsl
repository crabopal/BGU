	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ОтчетКомиссионера(ОснованиеСсылка, Действие, ВозвратДанные) Экспорт
	
	// Возвращаемое значение
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Получаем данные
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("СчетУчетаРозницы",	БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("401.10"));
	ЗапросЗаполнение.УстановитьПараметр("ВалютаРУ",					Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросЗаполнение.УстановитьПараметр("СтавкаНДСБезНДС",			Перечисления.СтавкиНДС.БезНДС);
	
	ЗапросЗаполнение.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОтчетКомиссионераПокупатели.Всего КАК Всего,
	|	ОтчетКомиссионера.СтавкаНДСВознаграждения КАК СтавкаНДС,
	|	ОтчетКомиссионераПокупатели.НДС КАК СуммаНДС,
	|	ОтчетКомиссионераПокупатели.Ссылка КАК Ссылка,
	|	ОтчетКомиссионера.КФО КАК КФО
	|ПОМЕСТИТЬ ТаблицаПродажи
	|ИЗ
	|	Документ.ОтчетКомиссионера.Покупатели КАК ОтчетКомиссионераПокупатели
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетКомиссионера КАК ОтчетКомиссионера
	|		ПО ОтчетКомиссионераПокупатели.Ссылка = ОтчетКомиссионера.Ссылка
	|ГДЕ
	|	ОтчетКомиссионераПокупатели.Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗНАЧЕНИЕ(Перечисление.ВариантыРегистрацииСтрокиКнигиПродаж.Регистрация) КАК Действие,
	|	ЛОЖЬ КАК ДопЛист,
	|	ОтчетКомиссионера.Ссылка КАК ДокументОснование,
	|	ОтчетКомиссионера.КонтрагентДляРозничныхПродаж КАК Контрагент,
	|	НЕОПРЕДЕЛЕНО КАК Договор,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация) КАК ПричинаНалогообложения,
	|	&ВалютаРУ КАК ВалютаДокумента,
	|	ОтчетКомиссионера.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка) КАК ИФО,
	|	ОтчетКомиссионера.Дата КАК ДатаОплаты,
	|	""Отчет комитента"" КАК ВидПервичногоДокумента,
	|	ОтчетКомиссионера.Дата КАК ДатаПервичногоДокумента,
	|	ОтчетКомиссионера.Номер КАК НомерПервичногоДокумента,
	|	""26"" КАК КодВидаОперации
	|ИЗ
	|	Документ.ОтчетКомиссионера КАК ОтчетКомиссионера
	|ГДЕ
	|	ОтчетКомиссионера.Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаПродажи.Всего КАК Всего,
	|	ТаблицаПродажи.СтавкаНДС КАК СтавкаНДС,
	|	ТаблицаПродажи.СуммаНДС КАК СуммаНДС,
	|	ТаблицаПродажи.Всего - ТаблицаПродажи.СуммаНДС КАК Сумма,
	|	ТаблицаПродажи.КФО КАК КФО,
	|	&СчетУчетаРозницы КАК СчетНачислениеДт,
	|	НЕОПРЕДЕЛЕНО КАК Субконто1НачислениеДт,
	|	НЕОПРЕДЕЛЕНО КАК Субконто2НачислениеДт,
	|	НЕОПРЕДЕЛЕНО КАК Субконто3НачислениеДт
	|ИЗ
	|	ТаблицаПродажи КАК ТаблицаПродажи";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	//	[1] Данные для реквизитов шапки
	ТаблицаШапка = РезультатыЗаполнения[1].Выгрузить();
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = ПолучитьШапкуДокумента();
	КонецЕсли;
	ЗаполнитьОбщиеРеквизиты(Шапка, Действие);
	
	Шапка.Вставить("Дата", ТекущаяДатаСеанса());
	
	//	[2] Данные для табличной части ""СуммыНДС""
	ТаблицаСуммыНДС	= РезультатыЗаполнения[2].Выгрузить();
	
	// Заполняем полные счета и аналитику
	ПараметрыЗаполнения = Новый Структура();
	ПараметрыЗаполнения.Вставить("ЗаполнитьСчетНачислениеДт",	Ложь);
	ПараметрыЗаполнения.Вставить("ЗаполнитьСчет30304",			Истина);
	ЗаполнитьКолонкиСчетов(Шапка, ТаблицаСуммыНДС, ПараметрыЗаполнения);
	
	// Искомые данные
	ТабличныеЧасти	= Новый Структура("СуммыНДС", ТаблицаСуммыНДС);
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Истина;
	
КонецФункции

// При необходимости создает и заполняет колонки счетов и аналитики.
Процедура ЗаполнитьКолонкиСчетов(ШапкаДокумента, ТаблицаСуммыНДС, ПараметрыЗаполнения = Неопределено) Экспорт
	
	// Заполняемые колонки счетов и аналитики
	ТипКолонкиСубконто		= Новый ОписаниеТипов(Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	ТипКолонкиСчет			= Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
	ТипКолонкиКПС			= Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов");
	ТипКолонкиКЭК			= Новый ОписаниеТипов("СправочникСсылка.КОСГУ");
	ТипКолонкиФиксСтруктура	= Новый ОписаниеТипов("Структура");
	КолонкиСчетов = Новый Структура();
	КолонкиСчетов.Вставить("СчетНачислениеДт",		ТипКолонкиСчет);
	КолонкиСчетов.Вставить("КПСНачислениеДт",		ТипКолонкиКПС);
	КолонкиСчетов.Вставить("КЭКНачислениеДт",		ТипКолонкиКЭК);
	КолонкиСчетов.Вставить("Субконто1НачислениеДт",	ТипКолонкиСубконто);
	КолонкиСчетов.Вставить("Субконто2НачислениеДт",	ТипКолонкиСубконто);
	КолонкиСчетов.Вставить("Субконто3НачислениеДт",	ТипКолонкиСубконто);
	КолонкиСчетов.Вставить("Счет30304",				ТипКолонкиСчет);
	КолонкиСчетов.Вставить("КПС30304",				ТипКолонкиКПС);
	// Служебная колонка
	КолонкиСчетов.Вставить("ПрименяемаяИнструкция_СтруктураСвойств",	ТипКолонкиФиксСтруктура);
	Для Каждого ОписаниеКолонки Из КолонкиСчетов Цикл
		ИмяКолонки = ОписаниеКолонки.Ключ;
		СоздатьКолонку = (ТаблицаСуммыНДС.Колонки.Найти(ИмяКолонки) = Неопределено);
		Если СоздатьКолонку Тогда
			ТаблицаСуммыНДС.Колонки.Добавить(ИмяКолонки, ОписаниеКолонки.Значение);
		КонецЕсли;
	КонецЦикла;
	
	// Определяем свойства инструкции для каждой строки
	ПрименяемаяИнструкция_ОбновитьСтруктурыСвойств(ШапкаДокумента, ТаблицаСуммыНДС);
	
	// Заполняем полные счета
	ПрименяемаяИнструкция_ЗаполнитьКолонкиСчетов(ТаблицаСуммыНДС, ШапкаДокумента, ПараметрыЗаполнения);
	
	//---
	// Механизм автоустановки субконто
	//---
	МассивОбслуживаемыхИдентификаторов = Новый Массив();
	МассивОбслуживаемыхИдентификаторов.Добавить(1);
	ДокументСтруктура = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ШапкаДокумента);
	ДокументСтруктура.Вставить("СуммыНДС", ТаблицаСуммыНДС);
	ТаблицаПараметровАвтоустановки = УчетНДС.АвтоустановкаСубконто_ПолучитьТаблицуПараметрыАвтоустановки_РегистрацияСтрокиКнигиПродаж_ВызовНеИзФормы(
		ДокументСтруктура,
		МассивОбслуживаемыхИдентификаторов,
		Истина);
	УчетНДС.АвтоустановкаСубконто_ВыполнитьАвтоустановкуЗначений_ВызовНеИзФормы(ДокументСтруктура, ТаблицаПараметровАвтоустановки, Истина);
	
КонецПроцедуры

//---
// Применяемая инструкция
//---

Процедура ПрименяемаяИнструкция_ОбновитьСтруктурыСвойств(ШапкаДокумента, ЗаполняемаяТаблица, ИдентификаторИнструкции = Неопределено, СтрокаТаблицы = Неопределено) Экспорт
	
	СтруктураСвойств = Новый Структура("
		|СчетНачислениеДт,
		|СчетНачислениеДтЕдинственный,
		|СчетНачислениеДтРодители,
		|ВидыПоказателяКПСНачислениеДт,
		|Счет30304,
		|Счет30304Единственный,
		|ВидыПоказателяКПС30304,
		|ИзменилсяСчетНачислениеДт,
		|ИзменилсяСчет30304");
		
	// Структура для определения применяемой инструкции
	// (эти реквизиты берем из шапки)
	ОбъектСтруктура = Новый Структура("
		|Организация,
		|ПричинаНалогообложения,
		|Дата,
		|ИФО,
		|Действие");
	ЗаполнитьЗначенияСвойств(ОбъектСтруктура, ШапкаДокумента);
	
	Если СтрокаТаблицы = Неопределено Тогда
		// Обрабатываем все строки таблицы
		МассивСтрок = ЗаполняемаяТаблица;
		Если ТипЗнч(ЗаполняемаяТаблица) = Тип("ТаблицаЗначений") Тогда
			МассивСчетНачислениеДт = ЗаполняемаяТаблица.ВыгрузитьКолонку("СчетНачислениеДт");
		Иначе
			МассивСчетНачислениеДт = ЗаполняемаяТаблица.Выгрузить(, "СчетНачислениеДт").ВыгрузитьКолонку("СчетНачислениеДт");
		КонецЕсли;
	Иначе
		// Обрабатываем только одну указанную строку таблицы
		МассивСтрок = Новый Массив();
		МассивСтрок.Добавить(СтрокаТаблицы);
		МассивСчетНачислениеДт = Новый Массив();
		МассивСчетНачислениеДт.Добавить(СтрокаТаблицы["СчетНачислениеДт"]);
	КонецЕсли;
	
	// Определим счета-родители и запомним их
	// (нужно для дальнейшего очищения счетов, если они не соответствуют инструкции)
	РезультатЗапросаРодители = ПолучитьРодителейСчетов(МассивСчетНачислениеДт);
	ВыборкаСчет = РезультатЗапросаРодители.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для Каждого СтрокаТЧ Из МассивСтрок Цикл
		// Эти реквизиты берем из таблицы
		ОбъектСтруктура.Вставить("КФО", СтрокаТЧ["КФО"]);
		
		// Одноименные свойства инструкции
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ОбъектСтруктура, , ИдентификаторИнструкции);
		ЗаполнитьЗначенияСвойств(СтруктураСвойств, ПрименяемаяИнструкцияСтруктура);
		
		// Дополнительные рассчитанные свойства
		ТекущаяСтруктураСвойств = СтрокаТЧ["ПрименяемаяИнструкция_СтруктураСвойств"];
		ТекущиеЗначенияСчетов = Новый Структура("СчетНачислениеДт, Счет30304");
		Если ЗначениеЗаполнено(ТекущаяСтруктураСвойств) Тогда
			ЗаполнитьЗначенияСвойств(ТекущиеЗначенияСчетов, ТекущаяСтруктураСвойств);
		КонецЕсли;
		ИзменилсяСчетНачислениеДт	= НЕ (ТекущиеЗначенияСчетов["СчетНачислениеДт"] = СтруктураСвойств["СчетНачислениеДт"]);
		ИзменилсяСчет30304			= НЕ (ТекущиеЗначенияСчетов["Счет30304"] = СтруктураСвойств["Счет30304"]);
		СтруктураСвойств.Вставить("Счет30304Единственный",		Истина);
		СтруктураСвойств.Вставить("ИзменилсяСчетНачислениеДт",	ИзменилсяСчетНачислениеДт);
		СтруктураСвойств.Вставить("ИзменилсяСчет30304",			ИзменилсяСчет30304);
		
		// Родители счета из текущей строки
		СчетНачислениеДтРодители = Новый Массив();
		// Продвигаемся в выборке до текущего счета
		ПоискТекущегоСчета = Новый Структура("Счет", СтрокаТЧ["СчетНачислениеДт"]);
		ВыборкаСчет.Сбросить();
		ВыборкаСчет.НайтиСледующий(ПоискТекущегоСчета);
		ВыборкаСчетРодители = ВыборкаСчет.Выбрать();
		Пока ВыборкаСчетРодители.Следующий() Цикл
			СчетНачислениеДтРодители.Добавить(ВыборкаСчетРодители["Родитель"]);
		КонецЦикла;
		СтруктураСвойств.Вставить("СчетНачислениеДтРодители",	СчетНачислениеДтРодители);
		
		СтрокаТЧ["ПрименяемаяИнструкция_СтруктураСвойств"] = СтруктураСвойств; //Новый ФиксированнаяСтруктура(СтруктураСвойств);
	КонецЦикла;
	
КонецПроцедуры

// В таблице должна быть заранее заполнена колонка ПрименяемаяИнструкция_СтруктураСвойств.
Процедура ПрименяемаяИнструкция_ЗаполнитьКолонкиСчетов(ЗаполняемаяТаблица, ПараметрыПодбораКПС, ПараметрыЗаполнения = Неопределено) Экспорт
	
	// Параметры заполнения
	Перем	ЗаполнитьСчетНачислениеДт,
			ЗаполнитьСчет30304,
			СтрокаТаблицы;
	
	Если ТипЗнч(ПараметрыЗаполнения) = Тип("Структура") Тогда
		ПараметрыЗаполнения.Свойство("ЗаполнитьСчетНачислениеДт",	ЗаполнитьСчетНачислениеДт);
		ПараметрыЗаполнения.Свойство("ЗаполнитьСчет30304",			ЗаполнитьСчет30304);
		ПараметрыЗаполнения.Свойство("СтрокаТаблицы",				СтрокаТаблицы);
	КонецЕсли;
	Если НЕ ЗаполнитьСчетНачислениеДт = Ложь Тогда
		ЗаполнитьСчетНачислениеДт = Истина; // Значение по умолчанию
	КонецЕсли;
	Если НЕ ЗаполнитьСчет30304 = Ложь Тогда
		ЗаполнитьСчет30304 = Истина; // Значение по умолчанию
	КонецЕсли;
	
	Если СтрокаТаблицы = Неопределено Тогда
		// Обрабатываем все строки таблицы
		МассивСтрок	= ЗаполняемаяТаблица;
	Иначе
		// Обрабатываем только одну указанную строку таблицы
		МассивСтрок = Новый Массив();
		МассивСтрок.Добавить(СтрокаТаблицы);
	КонецЕсли;
	
	// Устанавливаем счета
	Для Каждого СтрокаТЧ Из МассивСтрок Цикл
		СтруктураСвойств = СтрокаТЧ["ПрименяемаяИнструкция_СтруктураСвойств"];
		
		ЗаполняющаяСтруктура = Новый Структура();
		
		//
		// СчетНачислениеДт
		//
		Если ЗаполнитьСчетНачислениеДт Тогда
			Если СтруктураСвойств["СчетНачислениеДтЕдинственный"] = Истина Тогда
				СчетНачислениеДт = СтруктураСвойств["СчетНачислениеДт"];
				ИзменилсяСчетНачислениеДт = СтруктураСвойств["ИзменилсяСчетНачислениеДт"];
				
			ИначеЕсли ПрименяемаяИнструкция_СчетСоответствуетИнструкции(СтрокаТЧ) Тогда
				СчетНачислениеДт = СтрокаТЧ["СчетНачислениеДт"];
				ИзменилсяСчетНачислениеДт = Ложь;
				
			Иначе
				СчетНачислениеДт = Неопределено;
				ИзменилсяСчетНачислениеДт = Истина;
				
			КонецЕсли;
			
			Если ИзменилсяСчетНачислениеДт Тогда
				ЗаполняющаяСтруктура.Вставить("СчетНачислениеДт",		СчетНачислениеДт);
				ЗаполняющаяСтруктура.Вставить("КПСНачислениеДт",		Неопределено);
				ЗаполняющаяСтруктура.Вставить("КЭКНачислениеДт",		Неопределено);
				ЗаполняющаяСтруктура.Вставить("Субконто1НачислениеДт",	Неопределено);
				ЗаполняющаяСтруктура.Вставить("Субконто2НачислениеДт",	Неопределено);
				ЗаполняющаяСтруктура.Вставить("Субконто3НачислениеДт",	Неопределено);
			КонецЕсли;
			
			// Обновляем при необходимости
			Если НЕ ИзменилсяСчетНачислениеДт = СтруктураСвойств["ИзменилсяСчетНачислениеДт"] Тогда
				СтруктураСвойств["ИзменилсяСчетНачислениеДт"] = ИзменилсяСчетНачислениеДт;
			КонецЕсли;
		КонецЕсли;
		
		//
		// Счет30304
		//
		Если ЗаполнитьСчет30304 Тогда
			Если СтруктураСвойств["Счет30304Единственный"] = Истина Тогда
				Счет30304 = СтруктураСвойств["Счет30304"];
				ИзменилсяСчет30304 = СтруктураСвойств["ИзменилсяСчет30304"];
				
			Иначе
				Счет30304 = Неопределено;
				ИзменилсяСчет30304 = Истина;
				
			КонецЕсли;
			
			Если ИзменилсяСчет30304 Тогда
				ЗаполняющаяСтруктура.Вставить("Счет30304",				Счет30304);
				ЗаполняющаяСтруктура.Вставить("КПС30304",				Неопределено);
			КонецЕсли;
			
			// Обновляем при необходимости
			Если НЕ ИзменилсяСчет30304 = СтруктураСвойств["ИзменилсяСчет30304"] Тогда
				СтруктураСвойств["ИзменилсяСчет30304"] = ИзменилсяСчет30304;
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ЗаполняющаяСтруктура);
	КонецЦикла;
	
	// Устанавливаем КПС из рабочих счетов
	Если СтрокаТаблицы = Неопределено Тогда
		// Обрабатываем все строки таблицы
		ТаблицаДляЗаполнениеКПС = ЗаполняемаяТаблица;
	Иначе
		// Обрабатываем только одну указанную строку таблицы
		ТаблицаДляЗаполнениеКПС = ЗаполняемаяТаблица.Выгрузить(Новый Массив());
		НоваяСтрока = ТаблицаДляЗаполнениеКПС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЕсли;
	Если ТаблицаДляЗаполнениеКПС.Количество() > 0 Тогда
		// Фактически виды показателя КПС являются одинаковыми для всех строк таблицы
		// (для любого КФО), поэтому определяем их из любой строки, например, самой первой
		СтруктураСвойств = ТаблицаДляЗаполнениеКПС[0]["ПрименяемаяИнструкция_СтруктураСвойств"];
		
		Если ЗаполнитьСчетНачислениеДт Тогда
			ОписаниеТаблицы = Новый Структура();
			ОписаниеТаблицы.Вставить("ИмяКолонкиСчет",		"СчетНачислениеДт");
			ОписаниеТаблицы.Вставить("ИмяКолонкиКПС",		"КПСНачислениеДт");
			ОписаниеТаблицы.Вставить("ИмяКолонкиКЭК",		"КЭКНачислениеДт");
			ПараметрыЗаполнения = Новый Структура();
			ПараметрыЗаполнения.Вставить("Организация",							ПараметрыПодбораКПС["Организация"]);
			ПараметрыЗаполнения.Вставить("Дата",								ПараметрыПодбораКПС["Дата"]);
			ПараметрыЗаполнения.Вставить("ИФО",									ПараметрыПодбораКПС["ИФО"]);
			ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКПС",					Истина);
			ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКЭК",					ИзменилсяСчетНачислениеДт);
			ПараметрыЗаполнения.Вставить("ЗаполнитьТолькоПустыеПоля",			Ложь);
			ПараметрыЗаполнения.Вставить("ВидыПоказателяКПС",					СтруктураСвойств["ВидыПоказателяКПСНачислениеДт"]);
			ПараметрыЗаполнения.Вставить("СторонаПроводки",						"Дт");
			УчетНДС.ЗаполнитьТаблицуПоРабочемуПлануСчетов(ТаблицаДляЗаполнениеКПС, ОписаниеТаблицы, ПараметрыЗаполнения);
		КонецЕсли;
		
		Если ЗаполнитьСчет30304 Тогда
			ОписаниеТаблицы = Новый Структура();
			ОписаниеТаблицы.Вставить("ИмяКолонкиСчет",		"Счет30304");
			ОписаниеТаблицы.Вставить("ИмяКолонкиКПС",		"КПС30304");
			ПараметрыЗаполнения = Новый Структура();
			ПараметрыЗаполнения.Вставить("Организация",							ПараметрыПодбораКПС["Организация"]);
			ПараметрыЗаполнения.Вставить("Дата",								ПараметрыПодбораКПС["Дата"]);
			ПараметрыЗаполнения.Вставить("ИФО",									ПараметрыПодбораКПС["ИФО"]);
			ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКПС",					Истина);
			ПараметрыЗаполнения.Вставить("ЗаполнитьТолькоПустыеПоля",			Ложь);
			ПараметрыЗаполнения.Вставить("ВидыПоказателяКПС",					СтруктураСвойств["ВидыПоказателяКПС30304"]);
			УчетНДС.ЗаполнитьТаблицуПоРабочемуПлануСчетов(ТаблицаДляЗаполнениеКПС, ОписаниеТаблицы, ПараметрыЗаполнения);
		КонецЕсли;
		
		Если НЕ СтрокаТаблицы = Неопределено Тогда
			// Обрабатываем только одну указанную строку таблицы
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ТаблицаДляЗаполнениеКПС[0]);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПрименяемаяИнструкция_СчетСоответствуетИнструкции(СтрокаТаблицы)
	
	СтруктураСвойств		= СтрокаТаблицы["ПрименяемаяИнструкция_СтруктураСвойств"];
	СчетВИнструкции			= СтруктураСвойств["СчетНачислениеДт"];
	СчетВСтроке				= СтрокаТаблицы["СчетНачислениеДт"];
	РодителиСчетаВСтроке	= СтруктураСвойств["СчетНачислениеДтРодители"];
	
	Если ТипЗнч(СчетВИнструкции) = Тип("Массив") Тогда
		// Несколько значений счетов
		Для Каждого Счет Из СчетВИнструкции Цикл
			Если (СчетВСтроке = Счет) ИЛИ НЕ (РодителиСчетаВСтроке.Найти(Счет) = Неопределено) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	Иначе
		// Одно значение счета
		Если (СчетВСтроке = СчетВИнструкции) ИЛИ НЕ (РодителиСчетаВСтроке.Найти(СчетВИнструкции) = Неопределено) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

