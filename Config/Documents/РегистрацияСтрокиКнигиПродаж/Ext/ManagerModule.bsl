#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
Функция ПолучитьСписокДопустимыхДействий(ДокументОбъект) Экспорт
	
	Перем ПричинаНалогообложения;
	
	ДокументОснование = ДокументОбъект["ДокументОснование"];
	
	СписокДопустимыхДействий = Новый Массив();
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетОРозничныхПродажах") Тогда
			// Разрешено одно действие
			СписокДопустимыхДействий.Добавить(Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Регистрация);
			
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетПоКассовойСмене") Тогда
			// Разрешено одно действие
			СписокДопустимыхДействий.Добавить(Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Регистрация);
			
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетКомиссионера") Тогда
			// Разрешено одно действие
			СписокДопустимыхДействий.Добавить(Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Регистрация);
			
			
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РегистрацияСтрокиКнигиПродаж") Тогда
			// Разрешено одно действие или ни одного
			ДействиеОснования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "Действие");
			Если ДействиеОснования = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Регистрация
				ИЛИ ДействиеОснования = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Восстановление Тогда
				СписокДопустимыхДействий.Добавить(Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Аннулирование);
			КонецЕсли;
			
		ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("ПричинаНалогообложения", ДокументОснование.Метаданные()) Тогда
			// Разрешено несколько действий
			СписокДопустимыхДействий.Добавить(Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Регистрация);
			СписокДопустимыхДействий.Добавить(Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Аннулирование);
			
			ПричинаНалогообложения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ПричинаНалогообложения");
			
			Если УчетНДСПовтИсп.Вычет(ПричинаНалогообложения) Тогда
				СписокДопустимыхДействий.Добавить(Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Восстановление);
			КонецЕсли;
		КонецЕсли;
	Иначе
		// Разрешено одно действие
		СписокДопустимыхДействий.Добавить(Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Регистрация);
	КонецЕсли;
	
	Возврат СписокДопустимыхДействий;
	
КонецФункции

Функция ПолучитьПризнакиИспользованияРеквизитов(ДокументОбъект) Экспорт
	
	Перем	Действие,
			ДокументОснование,
			ДействиеОснования;
			
	ТаблицаНастроек = Новый ТаблицаЗначений();
	ТаблицаНастроек.Колонки.Добавить("ИмяРеквизита",		Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("Видимость",			Новый ОписаниеТипов("Булево"));
	ТаблицаНастроек.Колонки.Добавить("ПроверкаЗаполнения",	Новый ОписаниеТипов("Булево"));
	
	ТаблицаНастроекШапка	= ТаблицаНастроек.СкопироватьКолонки();
	ТаблицаНастроекСуммыНДС	= ТаблицаНастроек.СкопироватьКолонки();
	
	Действие			= ДокументОбъект["Действие"];
	ДокументОснование	= ДокументОбъект["ДокументОснование"];
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РегистрацияСтрокиКнигиПродаж") Тогда
		ДействиеОснования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "Действие");
	КонецЕсли;
	ВалютаДокумента		= ДокументОбъект["ВалютаДокумента"];
	ВидимостьВалюты		= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	
	// По умолчанию все реквизиты видимы
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекШапка, "Договор", Истина, Ложь);
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "ОбъектНалогообложения",	Истина, Ложь);
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "СчетСписания",			Истина, Истина);
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "КПССписания",				Истина, Истина);
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "КЭКСписания",				Истина, Истина);
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "Субконто1Списания",		Истина, Ложь);
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "Субконто2Списания",		Истина, Ложь);
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "Субконто3Списания",		Истина, Ложь);
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "СчетСписанияНУ",			Истина, Истина);
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "Субконто1СписанияНУ",		Истина, Ложь);
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "Субконто2СписанияНУ",		Истина, Ложь);
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "Субконто3СписанияНУ",		Истина, Ложь);
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "СуммаВалютная",			ВидимостьВалюты, Ложь);
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "СуммаНДСВалютная",		ВидимостьВалюты, Ложь);
	УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "ВсегоВалютная",			ВидимостьВалюты, Ложь);
	
	// По некоторым условия отключаем использование реквизитов
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетОРозничныхПродажах")
		ИЛИ НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекШапка, "Договор", Ложь, Ложь);
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "ОбъектНалогообложения",	Ложь, Ложь);
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетПоКассовойСмене")
		ИЛИ НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекШапка, "Договор", Ложь, Ложь);
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "ОбъектНалогообложения",	Ложь, Ложь);
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетКомиссионера")
		ИЛИ НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекШапка, "Договор", Ложь, Ложь);
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "ОбъектНалогообложения",	Ложь, Ложь);
	КонецЕсли;
	
	Если НЕ ПоказыватьВалютныеСуммы(ВалютаДокумента) Тогда
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "СуммаВалютная",			Ложь, Ложь);
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "СуммаНДСВалютная",		Ложь, Ложь);
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "ВсегоВалютная",			Ложь, Ложь);
	КонецЕсли;
	
	Если НЕ ИспользуетсяКолонкаСчетСписания(Действие, ДокументОснование) Тогда
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "СчетСписания",		Ложь, Ложь);
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "КПССписания",			Ложь, Ложь);
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "КЭКСписания",			Ложь, Ложь);
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "Субконто1Списания",	Ложь, Ложь);
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "Субконто2Списания",	Ложь, Ложь);
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "Субконто3Списания",	Ложь, Ложь);
	КонецЕсли;
	
	Если НЕ ИспользуетсяКолонкаСчетСписанияНУ(Действие, ДокументОснование, ДокументОбъект["Организация"], ДокументОбъект["Дата"]) Тогда
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "СчетСписанияНУ",		Ложь, Ложь);
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "Субконто1СписанияНУ",	Ложь, Ложь);
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "Субконто2СписанияНУ",	Ложь, Ложь);
		УстановитьПризнакИспользованияРеквизита(ТаблицаНастроекСуммыНДС, "Субконто3СписанияНУ",	Ложь, Ложь);
	КонецЕсли;
	
	ПризнакиИспользованияРеквизитов = Новый Структура();
	ПризнакиИспользованияРеквизитов.Вставить("Шапка",		ТаблицаНастроекШапка);
	ПризнакиИспользованияРеквизитов.Вставить("СуммыНДС",	ТаблицаНастроекСуммыНДС);
	
	Возврат ПризнакиИспользованияРеквизитов;
	
КонецФункции

Функция ЕстьОшибкиЗаполнения(ДокументОбъект, ПроверяемыеРеквизиты) Экспорт
	
	Перем ОписаниеОшибки;
	
	//---
	// Документы остатков НДС
	//---
	Если УчетНДС.ДокументыОстатковНДС_СообщитьЕслиИспользуетсяДляВводаОстатков(ДокументОбъект) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЕстьОшибкиЗаполнения = Ложь;
	
	Регистрация		= (ДокументОбъект["Действие"] = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Регистрация);
	Аннулирование	= (ДокументОбъект["Действие"] = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Аннулирование);
	Восстановление	= (ДокументОбъект["Действие"] = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Восстановление);
	
	//
	// Корректность указанного действия для документа-основания
	//
	СписокДопустимыхДействий = ПолучитьСписокДопустимыхДействий(ДокументОбъект);
	Действие = ДокументОбъект["Действие"];
	Если ЗначениеЗаполнено(Действие) Тогда
		ДействиеДопустимое = НЕ (СписокДопустимыхДействий.Найти(Действие) = Неопределено);
		Если НЕ ДействиеДопустимое Тогда
			ИмяПоляДляВыводаСообщений = "ДокументОснование";
			ТекстШаблона = НСтр("ru='Для указанного документа-основания не поддерживается выбранное действие (%1)'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстШаблона,
				Строка(Действие));
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"Объект." + ИмяПоляДляВыводаСообщений);
				
			// Дальнейшие проверки не имеют смысла. Выходим
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	//
	// Настраиваем состав ПроверяемыеРеквизиты
	// (для обработчика модуля объекта)
	//
	Если ДокументОбъект["ДопЛист"] Тогда
		ПроверяемыеРеквизиты.Добавить("КорректируемыйПериод");
	КонецЕсли;
	ПризнакиИспользованияРеквизитов = ПолучитьПризнакиИспользованияРеквизитов(ДокументОбъект);
	Для Каждого ПризнакИспользования Из ПризнакиИспользованияРеквизитов["Шапка"] Цикл
		ИмяРеквизита			= ПризнакИспользования["ИмяРеквизита"];
		РеквизитИспользуется	= ПризнакИспользования["ПроверкаЗаполнения"];
		Если РеквизитИспользуется Тогда
			ПроверяемыеРеквизиты.Добавить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ПризнакИспользования Из ПризнакиИспользованияРеквизитов["СуммыНДС"] Цикл
		ИмяРеквизита			= ПризнакИспользования["ИмяРеквизита"];
		РеквизитИспользуется	= ПризнакИспользования["ПроверкаЗаполнения"];
		Если РеквизитИспользуется Тогда
			ПроверяемыеРеквизиты.Добавить("СуммыНДС." + ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	ПроверитьТабличнуюЧасть(ДокументОбъект, ПроверяемыеРеквизиты, ЕстьОшибкиЗаполнения);
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Перем Курс, Кратность;
	
	// Создаваемые движения
	ТаблицаВходящийНДС						= РегистрыНакопления.ВходящийНДС.СоздатьНаборЗаписей().Выгрузить();
	ТаблицаВходящийНДСКРаспределению		= РегистрыНакопления.ВходящийНДСКРаспределению.СоздатьНаборЗаписей().Выгрузить();
	ТаблицаИсходящийНДС						= РегистрыНакопления.ИсходящийНДС.СоздатьНаборЗаписей().Выгрузить();
	ТаблицаКнигаПродаж						= РегистрыНакопления.КнигаПродаж.СоздатьНаборЗаписей().Выгрузить();
	ТаблицаДополнительныеЛистыКнигиПродаж	= РегистрыНакопления.ДополнительныеЛистыКнигиПродаж.СоздатьНаборЗаписей().Выгрузить();
	
	ШапкаДокумента			= ОбщегоНазначенияБГУ.СформироватьСтруктуруШапкиДокументаПоСсылке(ДокументСсылка);
	Регистрация				= (ШапкаДокумента["Действие"] = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Регистрация);
	Аннулирование			= (ШапкаДокумента["Действие"] = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Аннулирование);
	Восстановление			= (ШапкаДокумента["Действие"] = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Восстановление);
	Период					= ШапкаДокумента["Дата"];
	ДокументОснование		= ШапкаДокумента["ДокументОснование"];
	ЗаполнитьВалютныеСуммы	= УчетНДС.СледуетЗаполнитьВалютныеСуммы();
	СчетФактура				= ?(НЕ ЗначениеЗаполнено(ДокументОснование) ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетОРозничныхПродажах")
								ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетКомиссионера")
								ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетПоКассовойСмене"),
								ДокументСсылка,
								ДокументОснование);
	
	// Движения документа-основания по регистрам НДС
	ДвиженияДокументаОснования = УчетНДС.ПолучитьДвиженияПоРегистрам(ДокументОснование,
		"КнигаПродаж, ДополнительныеЛистыКнигиПродаж",
		Аннулирование);
	ДвиженияКнигаПродаж						= ДвиженияДокументаОснования["КнигаПродаж"];
	ДвиженияДополнительныеЛистыКнигиПродаж	= ДвиженияДокументаОснования["ДополнительныеЛистыКнигиПродаж"];
	
	ТаблицаСуммыНДС = ДокументСсылка["СуммыНДС"].Выгрузить();
	ТаблицаСуммыНДС.Колонки.Найти("Сумма").Имя = "СуммаБезНДС";
	ТаблицаСуммыНДС.Колонки.Найти("СуммаВалютная").Имя = "СуммаБезНДСВалютная";
	
	//---
	// КнигаПродаж, ДополнительныеЛистыКнигиПродаж
	//---
	Если ШапкаДокумента["ДопЛист"] Тогда
		ЗаполняемаяТаблица	= ТаблицаДополнительныеЛистыКнигиПродаж;
	Иначе
		ЗаполняемаяТаблица	= ТаблицаКнигаПродаж;
	КонецЕсли;
	Если Аннулирование Тогда
		// Аннулирование
		
		УчетНДС.ДобавитьВТаблицу(ЗаполняемаяТаблица, ДвиженияКнигаПродаж);
		УчетНДС.ДобавитьВТаблицу(ЗаполняемаяТаблица, ДвиженияДополнительныеЛистыКнигиПродаж);
		
		Для Каждого СтрокаТаблицы Из ЗаполняемаяТаблица Цикл
			СтрокаТаблицы["СуммаБезНДС"]			= -СтрокаТаблицы["СуммаБезНДС"];
			СтрокаТаблицы["СуммаНДС"]				= -СтрокаТаблицы["СуммаНДС"];
			СтрокаТаблицы["СуммаБезНДСВалютная"]	= -СтрокаТаблицы["СуммаБезНДСВалютная"];
			СтрокаТаблицы["СуммаНДСВалютная"]		= -СтрокаТаблицы["СуммаНДСВалютная"];
		КонецЦикла;
		
	Иначе
		// Регистрация
		// Восстановление
		
		УчетНДС.ДобавитьВТаблицу(ЗаполняемаяТаблица, ТаблицаСуммыНДС);
		
		ЗаполняемаяТаблица.ЗаполнитьЗначения(ШапкаДокумента["Организация"],				"Организация");
		ЗаполняемаяТаблица.ЗаполнитьЗначения(СчетФактура,								"СчетФактура");
		ЗаполняемаяТаблица.ЗаполнитьЗначения(ШапкаДокумента["ПричинаНалогообложения"],	"ПричинаНалогообложения");
		ЗаполняемаяТаблица.ЗаполнитьЗначения(ШапкаДокумента["ДатаОплаты"],				"ДатаОплаты");
		ЗаполняемаяТаблица.ЗаполнитьЗначения(ШапкаДокумента["КодВидаОперации"],			"КодВидаОперации");
	КонецЕсли;
	ЗаполняемаяТаблица.ЗаполнитьЗначения(Истина,										"Активность");
	ЗаполняемаяТаблица.ЗаполнитьЗначения(Период,										"Период");
	Если ШапкаДокумента["ДопЛист"] Тогда
		ЗаполняемаяТаблица.ЗаполнитьЗначения(ШапкаДокумента["КорректируемыйПериод"],	"КорректируемыйПериод");
	КонецЕсли;
	
	ОбъектыНалогообложения = ТаблицаСуммыНДС.ВыгрузитьКолонку("ОбъектНалогообложения");
	
	// Оставляем только заполненные ссылки
	КоличествоДокументов = ОбъектыНалогообложения.Количество();
	Для Счетчик = 1 По КоличествоДокументов Цикл
		Индекс = КоличествоДокументов - Счетчик;
		Если НЕ ЗначениеЗаполнено(ОбъектыНалогообложения[Индекс]) Тогда
			ОбъектыНалогообложения.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
	Если ОбъектыНалогообложения.Количество() > 0 Тогда
		// Для сопоставления с регистрами отложенной регистрации
		// приведем суммы в табличной части к положительным значениям
		
		СтруктураСумм = Новый Структура("
			|СуммаБезНДС,
			|СуммаБезНДСВалютная,
			|СуммаНДС,
			|СуммаНДСВалютная,
			|Всего,
			|ВсегоВалютная");
		
		Для Каждого СтрокаТаблицы Из ТаблицаСуммыНДС Цикл
			ЗаполнитьЗначенияСвойств(СтруктураСумм, СтрокаТаблицы);
			
			УчетНДС.УстановитьЗнакЧисел(СтруктураСумм, "+");
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтруктураСумм);
		КонецЦикла;
		
		ОстаткиПоОбъектуНалогообложения	= УчетНДС.ПолучитьОстаткиПоОбъектуНалогообложения(
			ОбъектыНалогообложения,
			"ИсходящийНДС,ВходящийНДС,ВходящийНДСКРаспределению",
			ШапкаДокумента["Дата"],
			ДокументСсылка,
			ШапкаДокумента.ДокументОснование);
		
		//---
		// ИсходящийНДС
		//---
		ОстаткиИсходящийНДС = ОстаткиПоОбъектуНалогообложения["ИсходящийНДС"];
		
		Если ОстаткиИсходящийНДС.Количество() > 0 Тогда
			КолонкиСвязи = "ОбъектНалогообложения, КФО";
			
			Если ЗаполнитьВалютныеСуммы Тогда
				КолонкиПоказателей = "СуммаБезНДС,СуммаНДС,СуммаБезНДСВалютная,СуммаНДСВалютная";
			Иначе
				КолонкиПоказателей = "СуммаБезНДС,СуммаНДС";
			КонецЕсли;
			
			РезультатСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
				ТаблицаСуммыНДС,
				ОстаткиИсходящийНДС,
				КолонкиСвязи,
				КолонкиПоказателей,
				"СписанияВТаблице2ВРазмереСоответствия");
				
			ТаблицаИсходящийНДС = РезультатСравнения["СписанияВТаблице2ВРазмереСоответствия"];
			
			УчетНДС.УдалитьСтрокиСНулевымиСуммами(ТаблицаИсходящийНДС);
			
			ТаблицаИсходящийНДС.Колонки.Добавить("ВидДвижения",	Новый ОписаниеТипов("ВидДвиженияНакопления"));
			ТаблицаИсходящийНДС.Колонки.Добавить("Период",		Новый ОписаниеТипов("Дата"));
			
			ТаблицаИсходящийНДС.ЗаполнитьЗначения(ВидДвиженияНакопления.Расход,	"ВидДвижения");
			ТаблицаИсходящийНДС.ЗаполнитьЗначения(Период,						"Период");
		КонецЕсли;
		
		//---
		// ВходящийНДС
		//---
		ОстаткиВходящийНДС = ОстаткиПоОбъектуНалогообложения["ВходящийНДС"];
		
		Если ОстаткиВходящийНДС.Количество() > 0 Тогда
			КолонкиСвязи = "ОбъектНалогообложения, КФО";
			
			Если ЗаполнитьВалютныеСуммы Тогда
				КолонкиПоказателей = "СуммаБезНДС,СуммаНДС,СуммаБезНДСВалютная,СуммаНДСВалютная";
			Иначе
				КолонкиПоказателей = "СуммаБезНДС,СуммаНДС";
			КонецЕсли;
			
			РезультатСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
				ТаблицаСуммыНДС,
				ОстаткиВходящийНДС,
				КолонкиСвязи,
				КолонкиПоказателей,
				"ОстаткиВТаблице1,СписанияВТаблице2ВРазмереСоответствия");
				
			ТаблицаСуммыНДСОстатки = РезультатСравнения["ОстаткиВТаблице1"];
			
			ТаблицаВходящийНДС = РезультатСравнения["СписанияВТаблице2ВРазмереСоответствия"];
			
			УчетНДС.УдалитьСтрокиСНулевымиСуммами(ТаблицаВходящийНДС);
			
			ТаблицаВходящийНДС.Колонки.Добавить("ВидДвижения",	Новый ОписаниеТипов("ВидДвиженияНакопления"));
			ТаблицаВходящийНДС.Колонки.Добавить("Период",		Новый ОписаниеТипов("Дата"));
			
			ТаблицаВходящийНДС.ЗаполнитьЗначения(ВидДвиженияНакопления.Расход,	"ВидДвижения");
			ТаблицаВходящийНДС.ЗаполнитьЗначения(Период,						"Период");
		Иначе
			ТаблицаСуммыНДСОстатки = ТаблицаСуммыНДС;
		КонецЕсли;
		
		//---
		// ВходящийНДСКРаспределению
		//---
		ОстаткиВходящийНДСКРаспределению = ОстаткиПоОбъектуНалогообложения["ВходящийНДСКРаспределению"];
		
		Если ОстаткиВходящийНДСКРаспределению.Количество() > 0 Тогда
			КолонкиСвязи = "ОбъектНалогообложения, КФО";
			
			Если ЗаполнитьВалютныеСуммы Тогда
				КолонкиПоказателей = "СуммаБезНДС,СуммаНДС,СуммаБезНДСВалютная,СуммаНДСВалютная";
			Иначе
				КолонкиПоказателей = "СуммаБезНДС,СуммаНДС";
			КонецЕсли;
			
			РезультатСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
				ТаблицаСуммыНДСОстатки,
				ОстаткиВходящийНДСКРаспределению,
				КолонкиСвязи,
				КолонкиПоказателей,
				"СписанияВТаблице2ВРазмереСоответствия");
				
			ТаблицаВходящийНДСКРаспределению = РезультатСравнения["СписанияВТаблице2ВРазмереСоответствия"];
			
			УчетНДС.УдалитьСтрокиСНулевымиСуммами(ТаблицаВходящийНДСКРаспределению);
			
			ТаблицаВходящийНДСКРаспределению.Колонки.Добавить("ВидДвижения",	Новый ОписаниеТипов("ВидДвиженияНакопления"));
			ТаблицаВходящийНДСКРаспределению.Колонки.Добавить("Период",			Новый ОписаниеТипов("Дата"));
			
			ТаблицаВходящийНДСКРаспределению.ЗаполнитьЗначения(ВидДвиженияНакопления.Расход,	"ВидДвижения");
			ТаблицаВходящийНДСКРаспределению.ЗаполнитьЗначения(Период,							"Период");
		КонецЕсли;
	КонецЕсли;
	
	// Финальные таблицы движений
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("ВходящийНДС",						ТаблицаВходящийНДС);
	ТаблицыДляДвижений.Вставить("ВходящийНДСКРаспределению",		ТаблицаВходящийНДСКРаспределению);
	ТаблицыДляДвижений.Вставить("ИсходящийНДС",						ТаблицаИсходящийНДС);
	ТаблицыДляДвижений.Вставить("КнигаПродаж",						ТаблицаКнигаПродаж);
	ТаблицыДляДвижений.Вставить("ДополнительныеЛистыКнигиПродаж",	ТаблицаДополнительныеЛистыКнигиПродаж);
	
КонецПроцедуры

Функция ПолучитьСчетИСубконтоНУ(СчетИСубконтоБУ, ПараметрыОпределенияСчета) Экспорт
	
	Перем	СчетБУ,
			СчетНУ,
			СубконтоБУ;
			
	Результат = Новый Структура();
	Результат.Вставить("Счет",						Неопределено);
	Результат.Вставить("Субконто1",					Неопределено);
	Результат.Вставить("Субконто2",					Неопределено);
	Результат.Вставить("Субконто3",					Неопределено);
	Результат.Вставить("КоличествоСубконтоСчетБУ",	0);
	Результат.Вставить("КоличествоСубконтоСчетНУ",	0);
	
	СчетИСубконтоБУ.Свойство("Счет", СчетБУ);
	Если НЕ ЗначениеЗаполнено(СчетБУ) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СчетНУ = НалоговыйУчетКлиентСервер.СчетРасходовНУ(СчетБУ,
		СчетИСубконтоБУ["Субконто1"],
		СчетИСубконтоБУ["Субконто2"],
		СчетИСубконтоБУ["Субконто3"],
		ПараметрыОпределенияСчета["КорСчетБУ"],
		ПараметрыОпределенияСчета["Организация"],
		ПараметрыОпределенияСчета["ИФО"],
		ПараметрыОпределенияСчета["Подразделение"],
		ПараметрыОпределенияСчета["Дата"]);
	Если ЗначениеЗаполнено(СчетНУ) Тогда
		Результат.Вставить("Счет", СчетНУ);
		
		// Пробуем установить субконто НУ
		
		СубконтоБУ = Новый Соответствие();
		НомерСубконто = 0;
		Для Каждого ВидСубконто Из СчетБУ.ВидыСубконто Цикл
			НомерСубконто		= НомерСубконто + 1;
			ЗначениеСубконто	= СчетИСубконтоБУ["Субконто" + НомерСубконто];
			Если ЗначениеЗаполнено(ЗначениеСубконто) Тогда
				СубконтоБУ.Вставить(ВидСубконто.ВидСубконто, ЗначениеСубконто);
			КонецЕсли;
		КонецЦикла;
		Результат.Вставить("КоличествоСубконтоСчетБУ", НомерСубконто);
		
		НомерСубконто = 0;
		Для Каждого ВидСубконто Из СчетНУ.ВидыСубконто Цикл
			НомерСубконто		= НомерСубконто + 1;
			ЗначениеСубконто	= СубконтоБУ.Получить(ВидСубконто.ВидСубконто);
			Если ЗначениеЗаполнено(ЗначениеСубконто) Тогда
				Результат.Вставить("Субконто" + НомерСубконто, ЗначениеСубконто);
			КонецЕсли;
		КонецЦикла;
		Результат.Вставить("КоличествоСубконтоСчетНУ", НомерСубконто);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяКолонкаСчетСписания(Действие, ДокументОснование) Экспорт
	
	Перем ДействиеОснования;
	
	Если Действие = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Восстановление Тогда
		Возврат Истина;
		
	ИначеЕсли Действие = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Аннулирование
		И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РегистрацияСтрокиКнигиПродаж") Тогда
		ДействиеОснования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "Действие");
		Если ДействиеОснования = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Восстановление Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ИспользуетсяКолонкаСчетСписанияНУ(Действие, ДокументОснование, Организация, Дата) Экспорт
	
	Если ИспользуетсяКолонкаСчетСписания(Действие, ДокументОснование) Тогда
		Возврат НалоговыйУчет.ПлательщикНалогаНаПрибыль(Организация, Дата);
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПоказыватьВалютныеСуммы(ВалютаДокумента) Экспорт
	
	Возврат ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет")
				И	ЗначениеЗаполнено(ВалютаДокумента)
				И	НЕ ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	
КонецФункции

Функция УстановитьВалютныеСуммыПоРублевым(ВалютаДокумента) Экспорт
	
	Возврат ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет")
				И	ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	
КонецФункции

Функция ПолучитьИменаКолонокСчетовНачисление() Экспорт
	
	ИменаКолонок = Новый Массив();
	ИменаКолонок.Добавить("СчетНачислениеДт");
	ИменаКолонок.Добавить("КПСНачислениеДт");
	ИменаКолонок.Добавить("КЭКНачислениеДт");
	ИменаКолонок.Добавить("Счет30304");
	ИменаКолонок.Добавить("КПС30304");
	
	Возврат ИменаКолонок;
	
КонецФункции

// Используется для заполнения колонок счетов
Функция ПолучитьШапкуДокумента(ДокументОбъект = Неопределено) Экспорт
	
	Шапка = Новый Структура("
		|Организация,
		|ИФО,
		|Дата,
		|Действие,
		|ДопЛист,
		|КорректируемыйПериод,
		|ПричинаНалогообложения,
		|Контрагент,
		|Договор,
		|ВалютаДокумента,
		|ДокументОснование");
		
	Если НЕ ДокументОбъект = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Шапка, ДокументОбъект);
	КонецЕсли;
	
	Возврат Шапка;
	
КонецФункции

// Для типовых операций
Функция СледуетСписатьНаРасходы(Действие, ДокументОснование) Экспорт
	
	Возврат ИспользуетсяКолонкаСчетСписания(Действие, ДокументОснование);
	
КонецФункции

