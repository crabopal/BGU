#Область СлужебныеПроцедурыИФункции
Процедура УстановитьПризнакИспользованияРеквизита(ТаблицаНастроек, ИмяРеквизита, Видимость, ПроверкаЗаполнения)
	
	СтрокаТаблицы = ТаблицаНастроек.Найти(ИмяРеквизита, "ИмяРеквизита");
	Если СтрокаТаблицы = Неопределено Тогда
		СтрокаТаблицы = ТаблицаНастроек.Добавить();
	КонецЕсли;
	
	СтрокаТаблицы["ИмяРеквизита"]		= ИмяРеквизита;
	СтрокаТаблицы["Видимость"]			= Видимость;
	СтрокаТаблицы["ПроверкаЗаполнения"]	= ПроверкаЗаполнения;
	
КонецПроцедуры

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата()
	
	Возврат Новый Структура("
		|Шапка,
		|ТабличныеЧасти,
		|ТиповаяОперация,
		|ОписаниеОшибки");
	
КонецФункции

Функция ПолучитьРодителейСчетов(МассивСчетов)
	
	ЗапросРодители = Новый Запрос();
	ЗапросРодители.УстановитьПараметр("Счета", МассивСчетов);
	ЗапросРодители.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Родители первого уровня
	|//
	|ВЫБРАТЬ
	|	Ссылка		КАК Счет,
	|	Родитель	КАК Родитель
	|ПОМЕСТИТЬ
	|	РодителиПервогоУровня
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В (&Счета)
	|	И	НЕ Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Родители второго уровня
	|//
	|ВЫБРАТЬ
	|	Счет				КАК Счет,
	|	Родитель.Родитель	КАК Родитель
	|ПОМЕСТИТЬ
	|	РодителиВторогоУровня
	|ИЗ
	|	РодителиПервогоУровня
	|ГДЕ
	|	НЕ Родитель.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Родители первого и второго уровней
	|//
	|ВЫБРАТЬ
	|	Счет		КАК Счет,
	|	Родитель	КАК Родитель
	|ИЗ
	|	РодителиПервогоУровня
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Счет		КАК Счет,
	|	Родитель	КАК Родитель
	|ИЗ
	|	РодителиВторогоУровня
	|	
	|ИТОГИ
	|ПО
	|	Счет
	|;";
	
	Возврат ЗапросРодители.Выполнить();
	
КонецФункции

Процедура ПроверитьТабличнуюЧасть(ДокументОбъект, ПроверяемыеРеквизиты, ЕстьОшибкиЗаполнения)
	
	ТекстШаблон = НСтр("ru='Не заполнена колонка ""%1"" в строке %2 списка ""%3""'");
	
	СинонимТабличнойЧасти	= Метаданные.Документы.РегистрацияСтрокиКнигиПродаж.ТабличныеЧасти.СуммыНДС.Синоним;
	МетаданныеКолонок		= Метаданные.Документы.РегистрацияСтрокиКнигиПродаж.ТабличныеЧасти.СуммыНДС.Реквизиты;
	
	ИменаКолонокСчетовНачисление = ПолучитьИменаКолонокСчетовНачисление();
	
	Для Каждого ИмяПоля Из ИменаКолонокСчетовНачисление Цикл
		ИндексЭлемента = ПроверяемыеРеквизиты.Найти("СуммыНДС." + ИмяПоля);
		
		Если ИндексЭлемента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПроверяемыеРеквизиты.Удалить(ИндексЭлемента);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.СуммыНДС Цикл
		ЗаполненаСуммаНДС = СтрокаТаблицы.СуммаНДС <> 0 ИЛИ СтрокаТаблицы.СуммаНДСВалютная <> 0;
		
		Если НЕ ЗаполненаСуммаНДС Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ИмяПоля Из ИменаКолонокСчетовНачисление Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоля]) Тогда
				Продолжить;
			КонецЕсли;
			
			ЕстьОшибкиЗаполнения = Истина;
			
			ТекстСообщения = СтрШаблон(ТекстШаблон,
				МетаданныеКолонок[ИмяПоля].Синоним,
				Формат(СтрокаТаблицы.НомерСтроки, "ЧГ=0"),
				СинонимТабличнойЧасти);
				
			ИндексСтрокой = Формат(СтрокаТаблицы.НомерСтроки-1, "ЧГ=0;ЧН=0");
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"Объект.СуммыНДС[" + ИндексСтрокой + "]." + ИмяПоля);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Ввод на основании

Функция ОтменитьВводНаОсновании(ДокументОснованиеСсылка, ЗаполняемыйДокумент, ВозвратОписаниеОшибки, ВозвратДействие)
	
	Если ЗаполняемыйДокумент["Ссылка"] = ДокументОснованиеСсылка Тогда
		ВозвратОписаниеОшибки = НСтр("ru='Не допускается вводить документ на основании себя самого'");
		Возврат Истина;
	КонецЕсли;
	
	// Проконтролируем корректность указанного действия.
	// Если действие некорректное, то заменяем его на корректное.
	ОбъектСтруктура = Новый Структура();
	ОбъектСтруктура.Вставить("ДокументОснование",		ДокументОснованиеСсылка);
	ОбъектСтруктура.Вставить("Действие",				ЗаполняемыйДокумент["Действие"]);
	ОбъектСтруктура.Вставить("ПричинаНалогообложения",	ЗаполняемыйДокумент["ПричинаНалогообложения"]);
	СписокДопустимыхДействий = ПолучитьСписокДопустимыхДействий(ОбъектСтруктура);
	ДействиеДопустимое = НЕ (СписокДопустимыхДействий.Найти(ЗаполняемыйДокумент["Действие"]) = Неопределено);
	Если ДействиеДопустимое Тогда
		ВозвратДействие = ЗаполняемыйДокумент["Действие"];
	Иначе
		Если СписокДопустимыхДействий.Количество() = 0 Тогда
			ВозвратДействие = Неопределено;
			ВозвратОписаниеОшибки = НСтр("ru='Не предусмотрено допустимого действия
				|для такого документа-основания'");
			// Выходим
			Возврат Истина;
		КонецЕсли;
		ВозвратДействие = СписокДопустимыхДействий[0];
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументОснованиеСсылка) Тогда
		ВозвратОписаниеОшибки = НСтр("ru='Не заполнен документ-основание'");
		ЗаполняемыйДокумент["Действие"] = ВозвратДействие;
		
		Возврат Истина;
	КонецЕсли;
	
	ОтменитьВводНаОсновании = Ложь;
	
	СвойстваОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснованиеСсылка, "Проведен");
	
	Если СвойстваОснования.Проведен И (ТипЗнч(ДокументОснованиеСсылка) = Тип("ДокументСсылка.ОтчетОРозничныхПродажах")) Тогда
		// Документ Отчет о розничных продажах можно регистрировать только один раз
		
		ЗапросПоиск = Новый Запрос();
		ЗапросПоиск.УстановитьПараметр("ДокументОснованиеСсылка",	ДокументОснованиеСсылка);
		ЗапросПоиск.УстановитьПараметр("ЗаполняемыйДокументСсылка",	ЗаполняемыйДокумент.Ссылка);
		ЗапросПоиск.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РегистрацияСтрокиКнигиПродаж	КАК РегистрацияСтрокиКнигиПродаж
		|ГДЕ
		|	ДокументОснование = &ДокументОснованиеСсылка
		|	И	НЕ ПометкаУдаления
		|	И	НЕ Ссылка = &ЗаполняемыйДокументСсылка
		|;";
		
		Выборка = ЗапросПоиск.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ОтменитьВводНаОсновании = Истина;
			ВозвратОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='На основании этого Отчета о розничных продажах уже введен документ %1'"),
				Строка(Выборка.Ссылка));
		КонецЕсли;
	КонецЕсли;	
	
	Возврат ОтменитьВводНаОсновании;
	
КонецФункции	

Процедура ЗаполнитьОбщиеРеквизиты(Шапка, Действие)
	
	Шапка.Вставить("Дата",		ТекущаяДатаСеанса());
	Шапка.Вставить("Действие",	Действие);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "РегистрацияСтрокиКнигиПродаж");
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	
	Если ЗначениеЗаполнено(КодВидаОперации) Тогда
		Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСуммыДляНФА(ТаблицаСуммыНДС, Курс, Кратность, ОснованиеСсылка)
	
	ПричинаНалогообложения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОснованиеСсылка, "ПричинаНалогообложения");
	
	ЭтоНалоговыйАгент = УчетНДСПовтИсп.НалоговыйАгент(ПричинаНалогообложения);
	
	Поиск = Новый Структура("РассчитатьОстаточнуюСтоимость", Истина);
	ТаблицаОбъектыКапитальныхВложений = ТаблицаСуммыНДС.Скопировать(Поиск, "ОбъектКапитальныхВложений");
	ТаблицаОбъектыКапитальныхВложений.Свернуть("ОбъектКапитальныхВложений");
	
	ТаблицаОстаточнаяСтоимостьНФА = ПолучитьОстаточнуюСтоимостьНФА(ТекущаяДатаСеанса(), ТаблицаОбъектыКапитальныхВложений);
	
	ИмяИзмененногоПоля	= "Сумма";
	ЭтоАванс			= Ложь;
	СтруктураИменПолей	= Новый Структура();
	СтруктураИменПолей.Вставить("Сумма",			"Сумма");
	СтруктураИменПолей.Вставить("СуммаНДС",			"СуммаНДС");
	СтруктураИменПолей.Вставить("Всего",			"Всего");
	СтруктураИменПолей.Вставить("СтавкаНДС",		"СтавкаНДС");
	
	Поиск = Новый Структура("ОбъектКапитальныхВложений, РассчитатьОстаточнуюСтоимость", Неопределено, Истина);
	Для Каждого СтрокаОстаточнаяСтоимость Из ТаблицаОстаточнаяСтоимостьНФА Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаОстаточнаяСтоимость);
		МассивСтрок = ТаблицаСуммыНДС.НайтиСтроки(Поиск);
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			СтрокаТаблицы["Сумма"] = СтрокаОстаточнаяСтоимость["ОстаточнаяСтоимость"];
			УчетНДСКлиентСервер.РассчитатьСуммы(СтрокаТаблицы, ИмяИзмененногоПоля, СтруктураИменПолей, ЭтоАванс, ЭтоНалоговыйАгент);
			
			ИспользуютсяВалютныеСуммы = (СтрокаТаблицы["ВсегоВалютная"] > 0);
			Если ИспользуютсяВалютныеСуммы Тогда
				СтрокаТаблицы["СуммаВалютная"]		= СтрокаТаблицы["Сумма"] / Курс * Кратность;
				СтрокаТаблицы["СуммаНДСВалютная"]	= СтрокаТаблицы["СуммаНДС"] / Курс * Кратность;
				СтрокаТаблицы["ВсегоВалютная"]		= СтрокаТаблицы["Всего"] / Курс * Кратность;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьОстаточнуюСтоимостьНФА(ДатаЗапроса, ТаблицаОбъектыКапитальныхВложений)
	
	ЗапросОстаточнаяСтоимость = Новый Запрос();
	ЗапросОстаточнаяСтоимость.УстановитьПараметр("ДатаЗапроса",							ДатаЗапроса);
	ЗапросОстаточнаяСтоимость.УстановитьПараметр("ТаблицаОбъектыКапитальныхВложений",	ТаблицаОбъектыКапитальныхВложений);
	ЗапросОстаточнаяСтоимость.УстановитьПараметр("Счет101",								БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.00"));
	ЗапросОстаточнаяСтоимость.УстановитьПараметр("Счет104",								БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("104.00"));
	ЗапросОстаточнаяСтоимость.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходный список объектов капитальных вложений
	|//
	|ВЫБРАТЬ
	|	ТЗ.ОбъектКапитальныхВложений	КАК ОбъектКапитальныхВложений
	|ПОМЕСТИТЬ
	|	ОбъектыКапитальныхВложений
	|ИЗ
	|	&ТаблицаОбъектыКапитальныхВложений	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Основные средства, принятые к учету
	|//
	|// Принятие к учету групп объектов ОС (ОС-1б)
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Ссылка.ВнеоборотныйАктив	КАК ОбъектКапитальныхВложений,
	|	ОсновноеСредство			КАК ОС
	|ПОМЕСТИТЬ
	|	ПринятыеКУчетуОС
	|ИЗ
	|	Документ.ПринятиеКУчетуОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	Ссылка.Проведен
	|	И	Ссылка.ВнеоборотныйАктив В (ВЫБРАТЬ ОбъектКапитальныхВложений ИЗ ОбъектыКапитальныхВложений)
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Принятие к учету здания (сооружения) (ОС-1а)
	|ВЫБРАТЬ
	|	ВнеоборотныйАктив			КАК ОбъектКапитальныхВложений,
	|	ОсновноеСредство			КАК ОС
	|ИЗ
	|	Документ.ПринятиеКУчетуЗдания КАК ПринятиеКУчетуЗдания
	|ГДЕ
	|	Проведен
	|	И	ВнеоборотныйАктив В (ВЫБРАТЬ ОбъектКапитальныхВложений ИЗ ОбъектыКапитальныхВложений)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Принятие к учету объекта ОС (кроме зданий и сооружений) (ОС-1)
	|ВЫБРАТЬ
	|	ВнеоборотныйАктив			КАК ОбъектКапитальныхВложений,
	|	ОсновноеСредство			КАК ОС
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектаОС КАК ПринятиеКУчетуОбъектаОС
	|ГДЕ
	|	Проведен
	|	И	ВнеоборотныйАктив В (ВЫБРАТЬ ОбъектКапитальныхВложений ИЗ ОбъектыКапитальныхВложений)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Принятие к учету ОС, НМА, НПА
	|ВЫБРАТЬ
	|	Ссылка.ВнеоборотныйАктив	КАК ОбъектКапитальныхВложений,
	|	ОсновноеСредство			КАК ОС
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	Ссылка.Проведен
	|	И	Ссылка.ВнеоборотныйАктив В (ВЫБРАТЬ ОбъектКапитальныхВложений ИЗ ОбъектыКапитальныхВложений)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Ввод начальных остатков ОС и НМА
	|ВЫБРАТЬ
	|	ОсновноеСредство			КАК ОбъектКапитальныхВложений,
	|	ОсновноеСредство			КАК ОС
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.ОстаткиИОбороты(
	|		&ДатаЗапроса,
	|		&ДатаЗапроса,
	|		Регистратор,
	|		,
	|		ОсновноеСредство В (ВЫБРАТЬ ОбъектКапитальныхВложений ИЗ ОбъектыКапитальныхВложений)
	|		И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|	)
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(Регистратор) = ТИП(Документ.ВводНачальныхОстатков)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Балансовая стоимость
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства)	КАК ОС,
	|	СуммаОстатокДт										КАК БалансоваяСтоимость
	|ПОМЕСТИТЬ
	|	Остатки101
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ДатаЗапроса,
	|		Счет В ИЕРАРХИИ (&Счет101),
	|		,
	|		Субконто1 В (ВЫБРАТЬ ОС ИЗ ПринятыеКУчетуОС)
	|	)	КАК Остатки
	|ИНДЕКСИРОВАТЬ ПО
	|	ОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Сумма амортизации
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства)	КАК ОС,
	|	СуммаОстатокКт										КАК СуммаАмортизации
	|ПОМЕСТИТЬ
	|	Остатки104
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ДатаЗапроса,
	|		Счет В ИЕРАРХИИ (&Счет104),
	|		,
	|		Субконто1 В (ВЫБРАТЬ ОС ИЗ ПринятыеКУчетуОС)
	|	)	КАК Остатки
	|ИНДЕКСИРОВАТЬ ПО
	|	ОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Остаточная стоимость
	|//
	|ВЫБРАТЬ
	|	ОбъектыКапитальныхВложений.ОбъектКапитальныхВложений	КАК ОбъектКапитальныхВложений,
	|	СУММА(ЕСТЬNULL(Остатки101.БалансоваяСтоимость, 0)
	|		- ЕСТЬNULL(Остатки104.СуммаАмортизации, 0))			КАК ОстаточнаяСтоимость
	|ИЗ
	|	ОбъектыКапитальныхВложений	КАК ОбъектыКапитальныхВложений
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ПринятыеКУчетуОС	КАК ПринятыеКУчетуОС
	|		ПО	ОбъектыКапитальныхВложений.ОбъектКапитальныхВложений = ПринятыеКУчетуОС.ОбъектКапитальныхВложений
	|	ЛЕВОЕ СОЕДИНЕНИЕ	Остатки101	КАК Остатки101
	|		ПО	ПринятыеКУчетуОС.ОС = Остатки101.ОС
	|	ЛЕВОЕ СОЕДИНЕНИЕ	Остатки104	КАК Остатки104
	|		ПО	ПринятыеКУчетуОС.ОС = Остатки104.ОС
	|СГРУППИРОВАТЬ ПО
	|	ОбъектыКапитальныхВложений.ОбъектКапитальныхВложений
	|;";

	Возврат ЗапросОстаточнаяСтоимость.Выполнить().Выгрузить();
	
КонецФункции
#КонецОбласти

#Область УстаревшиеПроцедурыИФункции

// Устарела. Условие формирования проводок по НУ задается в формуле типовой операции.
//
Функция СледуетСписатьНаРасходыНУ(Действие, ДокументОснование, Организация, Дата, КФО) Экспорт
	
	Если СледуетСписатьНаРасходы(Действие, ДокументОснование) Тогда
		Возврат НалоговыйУчет.ОтражатьВНалоговомУчете(Организация, Дата, КФО);
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Устарела. Условие формирования проводок по НУ задается в формуле типовой операции.
//
Функция СледуетНачислитьНДСНУ(Действие, ДокументОснование, Организация, Дата, КФО) Экспорт
	
	Если Действие = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Регистрация
		И (ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетОРозничныхПродажах")
			ИЛИ ДокументОснование = Неопределено) Тогда
		Возврат НалоговыйУчет.ОтражатьВНалоговомУчете(Организация, Дата, КФО);
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Действия обработчика обновления:
	// 1) Установка признака ВводНачальныхОстатков и отмена проведения документов остатков НДС
	
	Данные = Новый Массив();
	
	//---
	// Документы остатков НДС
	//---
	УчетНДС.ДокументыОстатковНДС_ДобавитьВСписокДокументыДляОбработчикаОбновленияВводНачальныхОстатков(Данные, "РегистрацияСтрокиКнигиПродаж");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Действия обработчика обновления:
	// 1) Установка признака ВводНачальныхОстатков и отмена проведения документов остатков НДС
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.РегистрацияСтрокиКнигиПродаж";
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта, МенеджерВременныхТаблиц, ДополнительныеПараметры);
	
	Если Не Результат.ЕстьДанныеДляОбработки Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	Если Не Результат.ЕстьЗаписиВоВременнойТаблице Тогда
		Параметры.ОбработкаЗавершена = Ложь;
		Возврат;
	КонецЕсли;
	
	//---
	// Документы остатков НДС
	//---
	СписокДокументыОстатковНДС = УчетНДС.ДокументыОстатковНДС_СписокДокументовДляОбработчикаОбновленияВводНачальныхОстатков("РегистрацияСтрокиКнигиПродаж");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 500
	|	Ссылка
	|ИЗ
	|	ВТДляОбработки
	|;";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		УстановитьПризнакВводОстатков = (СписокДокументыОстатковНДС.Найти(Выборка.Ссылка) <> Неопределено);
		
		Если НЕ УстановитьПризнакВводОстатков Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			
			НачатьТранзакцию();
			
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			Если УстановитьПризнакВводОстатков Тогда
				
				ДокОбъект.ВводНачальныхОстатков = Истина;
				
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект,,,РежимЗаписиДокумента.ОтменаПроведения);
				
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#Область ОбработчикОбновления_2_0_92_55_КурсКратность

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию_2_0_92_55(Параметры) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ПустаяВалюта",	Справочники.Валюты.ПустаяСсылка());
	Запрос.УстановитьПараметр("ВалютаРУ",		Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РегистрацияСтрокиКнигиПродаж
	|ГДЕ
	|	ВалютаДокумента <> &ПустаяВалюта
	|	И ВалютаДокумента <> &ВалютаРУ
	|	И Курс = 0
	|	И Кратность	= 0";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию_2_0_92_55(Параметры) Экспорт
	
	// Параллельный отложенный обработчик обновления
	
	МетаданныеДокумента = Метаданные.Документы.РегистрацияСтрокиКнигиПродаж;
	
	ПолноеИмяОбъекта = МетаданныеДокумента.ПолноеИмя();
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	СписокСсылок = Новый Массив();
	
	Пока Выборка.Следующий() Цикл
		СписокСсылок.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Если СписокСсылок.Количество() = 0 Тогда
		Параметры.ОбработкаЗавершена = Истина;
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Обработчик обновления завершил обработку документов %1'"),
			ПолноеИмяОбъекта);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
			
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("СписокСсылок", СписокСсылок);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	РегистрацияСтрокиКнигиПродаж.Ссылка	КАК Ссылка,
	|	ОперацииДокументов.Курс				КАК Курс,
	|	ОперацииДокументов.Кратность 		КАК Кратность
	|ИЗ
	|	Документ.РегистрацияСтрокиКнигиПродаж КАК РегистрацияСтрокиКнигиПродаж
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО РегистрацияСтрокиКнигиПродаж.Ссылка = ОперацииДокументов.Документ
	|ГДЕ
	|	РегистрацияСтрокиКнигиПродаж.Ссылка В (&СписокСсылок)";
	
	Результат = Запрос.Выполнить();
	
	ПроблемныхОбъектов = 0;
	ОбъектовОбработано = 0;
	ПлохиеДанные = Новый Соответствие;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДокументСсылка = Выборка.Ссылка;
		
		НачатьТранзакцию();
		
		Попытка
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", ДокументСсылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
			
			ПропуститьДокумент = (ДокументОбъект = Неопределено)
				Или ЗначениеЗаполнено(ДокументОбъект.Курс)
				Или ЗначениеЗаполнено(ДокументОбъект.Кратность);
			
			Если ПропуститьДокумент Тогда
	     		// Если объект ранее был удален или обработан другими сеансами, пропускаем его.
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ДокументСсылка);
				ЗафиксироватьТранзакцию();
				
				ОбъектовОбработано = ОбъектовОбработано + 1;
				
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ДокументОбъект, Выборка, "Курс,Кратность");
			
			Если ДокументОбъект.Модифицированность() Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ДокументСсылка);
			КонецЕсли;
			
			ОбъектовОбработано = ОбъектовОбработано + 1;
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Не удалось установить Курс и Кратность документа по причине %1'"), 
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеДокумента,
				ДокументСсылка,
				ТекстСообщения);
		КонецПопытки;
	
	КонецЦикла;
	
	Для Каждого НеобработанныйОбъект Из ПлохиеДанные Цикл
		ОбновлениеИнформационнойБазы.ЗарегистрироватьПроблемуСДанными(НеобработанныйОбъект.Ключ, НеобработанныйОбъект.Значение);
	КонецЦикла;
	
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Не удалось обработать всю очередную порцию объектов %1 (пропущены): %2 шт.'"),
			ПолноеИмяОбъекта,
			ПроблемныхОбъектов);
			
		ВызватьИсключение ТекстСообщения;
	Иначе
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Обработана очередная порция документов %1: %2 шт.'"),
			ПолноеИмяОбъекта,
			ОбъектовОбработано);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
	КонецЕсли;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
