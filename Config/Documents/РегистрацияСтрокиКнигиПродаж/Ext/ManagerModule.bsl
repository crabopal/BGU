		РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
		
		//	[1] Данные для табличной части ""СуммыНДС"" (Таблица для дальнейшей обработки)
		ТаблицаСуммыНДС	= РезультатыЗаполнения[1].Выгрузить();
		
		ЗаполнитьСуммыДляНФА(ТаблицаСуммыНДС, Курс, Кратность, ОснованиеСсылка);
	КонецЕсли;
	
	//	[0] Данные для реквизитов шапки
	ТаблицаШапка = РезультатыЗаполнения[0].Выгрузить();
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = ПолучитьШапкуДокумента();
	КонецЕсли;
	ЗаполнитьОбщиеРеквизиты(Шапка, Действие);
	
	Шапка.Вставить("Дата", ТекущаяДатаСеанса());
	
