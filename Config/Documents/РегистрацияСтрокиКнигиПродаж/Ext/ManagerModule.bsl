Функция ЗаполнитьНаОсновании(Знач Основание, Объект, ОписаниеОшибки = "", ПроверятьВозможностьВводаНаОсновании = Истина) Экспорт
	
	Перем	Действие,
			НовыеДанные;
	
	Если ПроверятьВозможностьВводаНаОсновании = Истина Тогда
		Если ОтменитьВводНаОсновании(Основание, Объект, ОписаниеОшибки, Действие) Тогда
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Действие = Объект["Действие"];
	КонецЕсли;
	
	ТипДокументаОснования = ТипЗнч(Основание);
	
	Если ТипДокументаОснования = Тип("ДокументСсылка.ОтчетОРозничныхПродажах") Тогда
		НовыеДанныеПолучены = ПолучитьДанныеДляЗаполненияНаОсновании_ОтчетОРозничныхПродажах(Основание, Действие, НовыеДанные);
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.ОтчетПоКассовойСмене") Тогда
		НовыеДанныеПолучены = ПолучитьДанныеДляЗаполненияНаОсновании_ОтчетПоКассовойСмене(Основание, Действие, НовыеДанные);
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		НовыеДанныеПолучены = ПолучитьДанныеДляЗаполненияНаОсновании_СчетФактураВыданный(Основание, Действие, НовыеДанные);
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
		НовыеДанныеПолучены = ПолучитьДанныеДляЗаполненияНаОсновании_СчетФактураПолученный(Основание, Действие, НовыеДанные);
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.РегистрацияСтрокиКнигиПродаж") Тогда
		НовыеДанныеПолучены = ПолучитьДанныеДляЗаполненияНаОсновании_РегистрацияСтрокиКнигиПродаж(Основание, Действие, НовыеДанные);
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		НовыеДанныеПолучены = ПолучитьДанныеДляЗаполненияНаОсновании_ИсправительныйСчетФактураВыданный(Основание, Действие, НовыеДанные);
	
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный") Тогда
		НовыеДанныеПолучены = ПолучитьДанныеДляЗаполненияНаОсновании_ИсправительныйСчетФактураПолученный(Основание, Действие, НовыеДанные);
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.ОтчетКомиссионера") Тогда
		НовыеДанныеПолучены = ПолучитьДанныеДляЗаполненияНаОсновании_ОтчетКомиссионера(Основание, Действие, НовыеДанные);
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
		НовыеДанныеПолучены = ПолучитьДанныеДляЗаполненияНаОсновании_КорректировочныйСчетФактураВыданный(Основание, Действие, НовыеДанные);
		
	ИначеЕсли ТипДокументаОснования = Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный") Тогда
		НовыеДанныеПолучены = ПолучитьДанныеДляЗаполненияНаОсновании_КорректировочныйСчетФактураПолученный(Основание, Действие, НовыеДанные);
		
	Иначе
		ОписаниеОшибки = НСтр("ru='Не поддерживается выбранный вид документов'");
		Возврат Ложь;
	КонецЕсли;
	
	Если НовыеДанныеПолучены Тогда
		ЗаполнитьЗначенияСвойств(Объект, НовыеДанные["Шапка"]);
		Если ТипЗнч(Объект["СуммыНДС"]) = Тип("ТаблицаЗначений") Тогда
			Объект["СуммыНДС"] = НовыеДанные["ТабличныеЧасти"]["СуммыНДС"];
		Иначе
			Объект["СуммыНДС"].Загрузить(НовыеДанные["ТабличныеЧасти"]["СуммыНДС"]);
		КонецЕсли;
		
		// Начисление (КЭК и КПС)
		ПараметрыЗаполнения = Новый Структура();
		ПараметрыЗаполнения.Вставить("Организация",		Объект["Организация"]);
		ПараметрыЗаполнения.Вставить("Дата",			Объект["Дата"]);
		ПараметрыЗаполнения.Вставить("ИмяКолонкиСчет",	"СчетНачислениеДт");
		ПараметрыЗаполнения.Вставить("ИмяКолонкиКПС",	"КПСНачислениеДт");
		ПараметрыЗаполнения.Вставить("ИмяКолонкиКЭК",	"КЭКНачислениеДт");
		
		УчетНДС.ЗаполнитьКЭК189иКПС(Объект["СуммыНДС"], ПараметрыЗаполнения);

	Иначе
		ОписаниеОшибки = НовыеДанные["ОписаниеОшибки"];
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ИсправительныйСчетФактураВыданный(ОснованиеСсылка, Действие, ВозвратДанные) Экспорт
	
	// Возвращаемое значение
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Значения реквизитов типовой операции документа-основания
	Основание_ТиповаяОперацияСсылка		= БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(ОснованиеСсылка);
	Основание_РеквизитыТиповойОперации	= Справочники.ТиповыеОперации.ПустаяСтруктураДопРеквизитовОперации(Основание_ТиповаяОперацияСсылка);
	Основание_РеквизитыТиповойОперации	= БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка, Основание_РеквизитыТиповойОперации);
	РеквизитыОперации					= Новый Структура("КФО, КПС, КЭК, КПС_30304, Курс, Кратность");
	ЗаполнитьЗначенияСвойств(РеквизитыОперации, Основание_РеквизитыТиповойОперации);
	Если Основание_ТиповаяОперацияСсылка = Справочники.ТиповыеОперации.ИсправительныйСчетФактураВыданный_ИсправлениеНДСБюджет Тогда
		// Исправление исходящего НДС за счет расходов (КФО 1)
		СчетНачислениеДт	= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("401.20");
		КФО					= Перечисления.КВД.Бюджет;
	Иначе
		// Исправление исходящего НДС
		СчетНачислениеДт	= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("401.10");
		КФО					= РеквизитыОперации["КФО"];
	КонецЕсли;
	КПСНачислениеДт	= РеквизитыОперации["КПС"];
	КЭКНачислениеДт	= РеквизитыОперации["КЭК"];
	КПС30304		= РеквизитыОперации["КПС_30304"];
	Курс = ?(ЗначениеЗаполнено(РеквизитыОперации["Курс"]),
		РеквизитыОперации["Курс"],
		1);
	Кратность = ?(ЗначениеЗаполнено(РеквизитыОперации["Кратность"]),
		РеквизитыОперации["Кратность"],
		1);
	
	// Получаем данные
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("СчетНачислениеДт",			СчетНачислениеДт);
	ЗапросЗаполнение.УстановитьПараметр("КПСНачислениеДт",			КПСНачислениеДт);
	ЗапросЗаполнение.УстановитьПараметр("КЭКНачислениеДт",			КЭКНачислениеДт);
	ЗапросЗаполнение.УстановитьПараметр("КФО",						КФО);
	ЗапросЗаполнение.УстановитьПараметр("Счет30304",				БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("303.04"));
	ЗапросЗаполнение.УстановитьПараметр("КПС30304",					КПС30304);
	ЗапросЗаполнение.УстановитьПараметр("ЗаполнитьВалютныеСуммы",	УчетНДС.СледуетЗаполнитьВалютныеСуммы());
	ЗапросЗаполнение.УстановитьПараметр("Курс",						Курс);
	ЗапросЗаполнение.УстановитьПараметр("Кратность",				Кратность);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка	КАК ДокументОснование,
	|	Организация					КАК Организация,
	|	ИФО							КАК ИФО,
	|	Подразделение				КАК Подразделение,
	|	Контрагент					КАК Контрагент,
	|	Договор						КАК Договор,
	|	ПричинаНалогообложения		КАК ПричинаНалогообложения,
	|	ВалютаДокумента				КАК ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА ВариантРегистрации = ЗНАЧЕНИЕ(Перечисление.ВариантыРегистрацииДляКорректирующихСФ.ВДопЛистахКнигПродажПокупок) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ						КАК ДопЛист,
	|	КорректируемыйПериод		КАК КорректируемыйПериод,
	|	КодВидаОперации				КАК КодВидаОперации,
	|	Дата						КАК ДатаПервичногоДокумента,
	|	Номер						КАК НомерПервичногоДокумента
	|ИЗ
	|	Документ.ИсправительныйСчетФактураВыданный	КАК ИсправительныйСчетФактураВыданный
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части ""СуммыНДС""
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА НЕ Ссылка.ДокументОснование = НЕОПРЕДЕЛЕНО ТОГДА
	|			Ссылка.ДокументОснование
	|		ИНАЧЕ
	|			Ссылка
	|	КОНЕЦ									КАК ОбъектНалогообложения,
	|	&КФО									КАК КФО,
	|	&СчетНачислениеДт						КАК СчетНачислениеДт,
	|	&КПСНачислениеДт						КАК КПСНачислениеДт,
	|	&КЭКНачислениеДт						КАК КЭКНачислениеДт,
	|	НЕОПРЕДЕЛЕНО							КАК Субконто1НачислениеДт,
	|	НЕОПРЕДЕЛЕНО							КАК Субконто2НачислениеДт,
	|	НЕОПРЕДЕЛЕНО							КАК Субконто3НачислениеДт,
	|	&Счет30304								КАК Счет30304,
	|	&КПС30304								КАК КПС30304,
	|	СтавкаНДС								КАК СтавкаНДС,
	|	СУММА(Сумма * &Курс / &Кратность)		КАК Сумма,
	|	СУММА(СуммаНДС * &Курс / &Кратность)	КАК СуммаНДС,
	|	СУММА(Всего * &Курс / &Кратность)		КАК Всего,
	|	СУММА(ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			Сумма
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)									КАК СуммаВалютная,
	|	СУММА(ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			СуммаНДС
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)									КАК СуммаНДСВалютная,
	|	СУММА(ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			Всего
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)									КАК ВсегоВалютная
	|ИЗ
	|	Документ.ИсправительныйСчетФактураВыданный.СоставНФА	КАК СоставНФА
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА НЕ Ссылка.ДокументОснование = НЕОПРЕДЕЛЕНО ТОГДА
	|			Ссылка.ДокументОснование
	|		ИНАЧЕ
	|			Ссылка
	|	КОНЕЦ,
	|	&КФО,
	|	&СчетНачислениеДт,
	|	&КПСНачислениеДт,
	|	&КЭКНачислениеДт,
	|	НЕОПРЕДЕЛЕНО,
	|	НЕОПРЕДЕЛЕНО,
	|	НЕОПРЕДЕЛЕНО,
	|	&Счет30304,
	|	&КПС30304,
	|	СтавкаНДС
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	//	[0] Данные для реквизитов шапки
	ТаблицаШапка = РезультатыЗаполнения[0].Выгрузить();
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = ПолучитьШапкуДокумента();
	КонецЕсли;
	ЗаполнитьОбщиеРеквизиты(Шапка, Действие);
	
	Шапка.Вставить("Дата", ТекущаяДатаСеанса());
	
	//	[1] Данные для табличной части ""СуммыНДС""
	ТаблицаСуммыНДС	= РезультатыЗаполнения[1].Выгрузить();
	
	// Искомые данные
	ТабличныеЧасти	= Новый Структура("СуммыНДС", ТаблицаСуммыНДС);
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ИсправительныйСчетФактураПолученный(ОснованиеСсылка, Действие, ВозвратДанные) Экспорт
	
	// Возвращаемое значение
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Значения реквизитов типовой операции документа-основания
	Основание_ТиповаяОперацияСсылка		= БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(ОснованиеСсылка);
	Основание_РеквизитыТиповойОперации	= Справочники.ТиповыеОперации.ПустаяСтруктураДопРеквизитовОперации(Основание_ТиповаяОперацияСсылка);
	Основание_РеквизитыТиповойОперации	= БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка, Основание_РеквизитыТиповойОперации);
	РеквизитыОперации					= Новый Структура("КПС_30304, Курс, Кратность");
	ЗаполнитьЗначенияСвойств(РеквизитыОперации, Основание_РеквизитыТиповойОперации);
	Курс = ?(ЗначениеЗаполнено(РеквизитыОперации["Курс"]),
		РеквизитыОперации["Курс"],
		1);
	Кратность = ?(ЗначениеЗаполнено(РеквизитыОперации["Кратность"]),
		РеквизитыОперации["Кратность"],
		1);
	
	// Получаем данные
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("КПС30304",					РеквизитыОперации["КПС_30304"]);
	ЗапросЗаполнение.УстановитьПараметр("ЗаполнитьВалютныеСуммы",	УчетНДС.СледуетЗаполнитьВалютныеСуммы());
	ЗапросЗаполнение.УстановитьПараметр("Курс",						Курс);
	ЗапросЗаполнение.УстановитьПараметр("Кратность",				Кратность);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка	КАК ДокументОснование,
	|	Организация					КАК Организация,
	|	ИФО							КАК ИФО,
	|	Подразделение				КАК Подразделение,
	|	Контрагент					КАК Контрагент,
	|	Договор						КАК Договор,
	|	ПричинаНалогообложения		КАК ПричинаНалогообложения,
	|	ВалютаДокумента				КАК ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА ВариантРегистрации = ЗНАЧЕНИЕ(Перечисление.ВариантыРегистрацииДляКорректирующихСФ.ВДопЛистахКнигПродажПокупок) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ						КАК ДопЛист,
	|	КорректируемыйПериод		КАК КорректируемыйПериод,
	|	КодВидаОперации				КАК КодВидаОперации,
	|	Дата						КАК ДатаПервичногоДокумента,
	|	Номер						КАК НомерПервичногоДокумента
	|ИЗ
	|	Документ.ИсправительныйСчетФактураПолученный	КАК ИсправительныйСчетФактураПолученный
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|";
	
	Если Действие = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Регистрация
		ИЛИ Действие = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Аннулирование Тогда
		
		ЗапросЗаполнение.Текст = ЗапросЗаполнение.Текст + "
		|////////////////////////////////////////////////////////////////////////////////
		|// [1]. Данные для табличной части ""СуммыНДС""
		|//
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА НЕ ДокументОснование = НЕОПРЕДЕЛЕНО ТОГДА
		|			ДокументОснование
		|		ИНАЧЕ
		|			Ссылка.ДокументОснование
		|	КОНЕЦ									КАК ОбъектНалогообложения,
		|	КФО										КАК КФО,
		|	Счет30304								КАК Счет30304,
		|	&КПС30304								КАК КПС30304,
		|	СтавкаНДС								КАК СтавкаНДС,
		|	СУММА(Сумма * &Курс / &Кратность)		КАК Сумма,
		|	СУММА(СуммаНДС * &Курс / &Кратность)	КАК СуммаНДС,
		|	СУММА(Всего * &Курс / &Кратность)		КАК Всего,
		|	СУММА(ВЫБОР
		|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
		|			Сумма
		|		ИНАЧЕ
		|			0
		|	КОНЕЦ)									КАК СуммаВалютная,
		|	СУММА(ВЫБОР
		|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
		|			СуммаНДС
		|		ИНАЧЕ
		|			0
		|	КОНЕЦ)									КАК СуммаНДСВалютная,
		|	СУММА(ВЫБОР
		|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
