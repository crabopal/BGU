// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	Одобренные = ОбщегоНазначенияБГУ.ОдобренныеОбъектыГолосования(ДокументСсылка);
	Если Одобренные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка,
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Номер"));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("НомерДокумента", НомерДокумента);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА Документ1.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	Документ1.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе) КАК ВидРаспоряжения,
	|	Документ1.ОсновноеСредство КАК ОсновноеСредство,
	|	Документ1.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Документ1.ЦМО КАК ЦМО,
	|	Документ1.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА Документ1.ВидОперации = 0
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Консервация)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Расконсервация)
	|	КОНЕЦ КАК Событие,
	|	""Акт"" КАК НазваниеДокумента,
	|	&НомерДокумента КАК НомерДокумента,
	|	Документ1.Дата КАК ДатаДокумента,
	|	ВЫБОР
	|		КОГДА Документ1.ВидОперации = 0
	|			ТОГДА Документ1.ДатаНачала
	|		ИНАЧЕ Документ1.ДатаОкончания
	|	КОНЕЦ КАК ДатаСобытия,
	|	Документ1.Причина КАК Причина
	|ИЗ
	|	Документ.АктКонсервацииРасконсервации КАК Документ1
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = Документ1.Ссылка)
	|ГДЕ
	|	Документ1.Ссылка = &Ссылка";
	//|	И ДОБАВИТЬКДАТЕ(Документ.ДатаНачала, МЕСЯЦ, 3) <= Документ.ДатаОкончания"; 
	// Движение в регистре нужно делать в любом случае, даже если срок меньше 3 месяцев. 
	// А в инвентарной карточке отображать только, если срок более 3 мес.
	
	Результат = Запрос.Выполнить().Выгрузить();
	ДополнительныеСвойства.ТаблицыДляДвижений.Вставить("СтоимостьОбъектовОС", Результат);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ГолосованиеКомиссии

Процедура ЗаполнитьРезультатГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	ЗаполнитьРезультатыГолосования = Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	
	Форма.РешениеСотрудникаПоРезолюции = Неопределено;
	Форма.ИтогГолосования = 0;
	Форма.РезолюцияКомиссииОдобрена = Ложь;
	Если ЗаполнитьРезультатыГолосования Тогда
		
		Если ЗначениеЗаполнено(Форма.Сотрудник) Тогда
			РезультатГолосованияСотрудника = ОбщегоНазначенияБГУ.РезультатыГолосованияСотрудникаПоДокументу(
				Форма.Сотрудник, Объект.Ссылка, Объект.Комиссия, Объект.Организация);
			Форма.РешениеСотрудникаПоРезолюции = ?(РезультатГолосованияСотрудника.Количество() > 0,
				РезультатГолосованияСотрудника[0].РезультатГолосования, Неопределено);
		КонецЕсли;
		
		РезультатГолосованияКомиссии = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(
			Объект.Ссылка, Объект.Комиссия, Объект.Организация);
		Если РезультатГолосованияКомиссии.Количество() > 0 Тогда
			Форма.ИтогГолосования = РезультатГолосованияКомиссии[0].ИтогГолосования;
			Форма.РезолюцияКомиссииОдобрена = РезультатГолосованияКомиссии[0].РезолюцияКомиссииОдобрена;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УправлениеЭлементамиГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ДоступностьГолосования = Не Объект.Ссылка.Пустая() И Не Объект.Проведен
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("Сотрудник");
	ЭлементыГолосование.Добавить("СохранитьРезультатыГолосования");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Доступность", ДоступностьГолосования);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("РешениеСотрудникаПоРезолюции");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник));
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктКонсервацииРасконсервации";
	КомандаПечати.Идентификатор		= "Акт";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о консервации (расконсервации)'"), "0510433");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Акт") Тогда
		
		ТабличныйДокумент = НапечататьАкт(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Акт","Акт о консервации (расконсервации) (ф. 0510433)", ТабличныйДокумент);
		
	КонецЕсли;
	
КонецПроцедуры

Функция НапечататьАкт(МассивОбъектов, ОбъектыПечати)
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПроверитьДостижениеКворумаПрисутствияПриПечати(МассивОбъектов);
	// Конец ИндикаторКворумаПрисутствия
	
	ТабличныйДокумент						= Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ИмяПараметровПечати	= "ПараметрыПечати_Акт0510433";
	ТабличныйДокумент.ТолькоПросмотр		= Истина;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.АктКонсервацииРасконсервации.ПФ_MXL_Акт0510433");
	
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьР1Шапка		= Макет.ПолучитьОбласть("Раздел1_Шапка");
	ОбластьР1Строка		= Макет.ПолучитьОбласть("Раздел1_Строка");
	ОбластьР2Шапка		= Макет.ПолучитьОбласть("Раздел2_Шапка");
	ОбластьР2Строка		= Макет.ПолучитьОбласть("Раздел2_Строка");
	ОбластьР3Шапка		= Макет.ПолучитьОбласть("Раздел3_Шапка");
	ОбластьР3Строка		= Макет.ПолучитьОбласть("Раздел3_Строка");
	ОбластьР4Шапка		= Макет.ПолучитьОбласть("Раздел4_Шапка");
	ОбластьР4Строка		= Макет.ПолучитьОбласть("Раздел4_Строка");
	ОбластьР4Подвал		= Макет.ПолучитьОбласть("Раздел4_Подвал");
	ОбластьР5Шапка		= Макет.ПолучитьОбласть("Раздел5_Шапка");
	ОбластьР5Строка		= Макет.ПолучитьОбласть("Раздел5_Строка");
	ОбластьПустаяСтрока	= Макет.ПолучитьОбласть("ПустаяСтрока");
	ОбластьПриложение	= Макет.ПолучитьОбласть("Приложение");
	ОбластьКомиссияП	= Макет.ПолучитьОбласть("Комиссия_Председатель");
	ОбластьКомиссияС	= Макет.ПолучитьОбласть("Комиссия_Строка");
	ОбластьИсполнитель	= Макет.ПолучитьОбласть("Исполнитель");
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	
	ДанныеДляПечати		= ДанныеДляПечати(МассивОбъектов);
	ВыборкаДокументов	= ДанныеДляПечати[3].Выбрать();
	ВыборкаВидыРабот	= ДанныеДляПечати[4].Выбрать();
	ВыборкаФайлы		= ДанныеДляПечати[5].Выбрать();
	
	РезультатыГолосования = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(МассивОбъектов);
	СоставКомиссий = ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов);
	
	ДанныеПечатиОбщие = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		НомерСтраницы = 1;
		
		// Шапка
		
		ОбластьШапка.Параметры.Заполнить(ВыборкаДокументов);
		
		ДанныеПечатиОбщиеДокумента = ДанныеПечатиОбщие.Получить(ВыборкаДокументов.Ссылка);

		ПараметрыШапки	= Новый Структура;
		ПараметрыШапки.Вставить("НомерАкта", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер));
		
		// Данные руководителя
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность, Подразделение", 
			ВыборкаДокументов["Руководитель"], ВыборкаДокументов.ДатаАкта);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина, Истина);
		РуководительФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		ПараметрыШапки.Вставить("ДолжностьРуководителя", ДанныеСотрудника.Должность);
		ПараметрыШапки.Вставить("ФИОРуководителя", РуководительФИО);

		ПараметрыШапки.Вставить("НаименованиеОрганизации"               , ДанныеПечатиОбщиеДокумента.НаименованиеОрганизации);
		ПараметрыШапки.Вставить("КодРПБС"								, ДанныеПечатиОбщиеДокумента.КодРПБС);
		ПараметрыШапки.Вставить("Организация"                           , ДанныеПечатиОбщиеДокумента.Организация);
		ПараметрыШапки.Вставить("НаименованиеОбособленногоПодразделения", ДанныеПечатиОбщиеДокумента.НаименованиеОбособленногоПодразделения);
		ПараметрыШапки.Вставить("КодРПБСПодр"							, ДанныеПечатиОбщиеДокумента.КодРПБСОбособленногоПодразделения);
		ПараметрыШапки.Вставить("ОбособленноеПодразделение"				, ДанныеПечатиОбщиеДокумента.НаименованиеОбособленногоПодразделения);
		ПараметрыШапки.Вставить("НаименованиеСтруктурногоПодразделения" , ДанныеПечатиОбщиеДокумента.СтруктурноеПодразделение);
		ПараметрыШапки.Вставить("СтруктурноеПодразделение"				, ДанныеПечатиОбщиеДокумента.СтруктурноеПодразделение);
		ПараметрыШапки.Вставить("Учредитель"							, ДанныеПечатиОбщиеДокумента.Учредитель);
		ПараметрыШапки.Вставить("ГлаваБК"								, ДанныеПечатиОбщиеДокумента.ГлаваБК);
		ПараметрыШапки.Вставить("БюджетНаименование"					, ДанныеПечатиОбщиеДокумента.БюджетНаименование);
		ПараметрыШапки.Вставить("ОКТМО"									, ДанныеПечатиОбщиеДокумента.ОКТМО);
		
		ПараметрыШапки.Вставить("Основание", ?(ВыборкаДокументов.КодОснования = 2,
			НСтр("ru = 'Расконсервация'"), НСтр("ru = 'Консервация'")));
		
		ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		// Раздел 1
		
		ТабличныйДокумент.Вывести(ОбластьР1Шапка);
		
		ФактическийСрокЭксплуатации = УправлениеОсновнымиСредствами.РассчитатьМесяцыЭксплуатации(,
			Выборкадокументов.ДатаВводаВЭксплуатацию, ВыборкаДокументов.ДатаАкта);
		ПараметрыСтроки = Новый Структура("СрокЭксплуатации", ФактическийСрокЭксплуатации);
		
		ОбластьР1Строка.Параметры.Заполнить(ВыборкаДокументов);
		ОбластьР1Строка.Параметры.Заполнить(ПараметрыСтроки);
		ТабличныйДокумент.Вывести(ОбластьР1Строка);
		
		// Раздел 2
		
		ТабличныйДокумент.Вывести(ОбластьР2Шапка);
		ОбластьР2Строка.Параметры.Заполнить(ВыборкаДокументов);
		ТабличныйДокумент.Вывести(ОбластьР2Строка);
		
		// Раздел 3
		
		ТабличныйДокумент.Вывести(ОбластьР3Шапка);
		ОбластьР3Строка.Параметры.Заполнить(ВыборкаДокументов);
		ТабличныйДокумент.Вывести(ОбластьР3Строка);
		
		// Раздел 4
		
		СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		
		ТабличныйДокумент.Вывести(ОбластьР4Шапка);
		СуммаРабот = 0;
		Пока ВыборкаВидыРабот.НайтиСледующий(СтруктураПоиска) Цикл
			ОбластьР4Строка.Параметры.Заполнить(ВыборкаВидыРабот);
			ТабличныйДокумент.Вывести(ОбластьР4Строка);
			СуммаРабот = СуммаРабот + ВыборкаВидыРабот.Сумма;
		КонецЦикла;
		
		ДанныеПодвала = Новый Структура("Сумма", СуммаРабот);
		ОбластьР4Подвал.Параметры.Заполнить(ДанныеПодвала);
		ТабличныйДокумент.Вывести(ОбластьР4Подвал);
		
		// Раздел 5
		
		ТабличныйДокумент.Вывести(ОбластьР5Шапка);
		ОбластьР5Строка.Параметры.Заполнить(ВыборкаДокументов);
		
		ПараметрыГолосования = Новый Структура("ИтогГолосования");
		ОтборПоИдентификаторуСтроки = Новый Структура("Документ", ВыборкаДокументов.Ссылка);
		РезультатыГолосованияПоСтроке = РезультатыГолосования.НайтиСтроки(ОтборПоИдентификаторуСтроки);
		Если РезультатыГолосованияПоСтроке.Количество() > 0
			И РезультатыГолосованияПоСтроке[0].ГолосованиеПоСтрокеЗавершено Тогда
			ПараметрыГолосования.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
		Иначе // Результаты голосования по строке документа не найдены.
			ПараметрыГолосования.ИтогГолосования = 0;
		КонецЕсли;
		ОбластьР5Строка.Параметры.Заполнить(ПараметрыГолосования);
		
		ТабличныйДокумент.Вывести(ОбластьР5Строка);
		
		// Приложения
		
		Сч = 0;
		Пока ВыборкаФайлы.НайтиСледующий(СтруктураПоиска) Цикл
			Если Сч = 0 Тогда
				ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
			КонецЕсли;
			Сч = Сч + 1;
			ОбластьПриложение.Параметры.Заполнить(Новый Структура("Номер", Сч));
			ОбластьПриложение.Параметры.Заполнить(ВыборкаФайлы);
			ТабличныйДокумент.Вывести(ОбластьПриложение);
		КонецЦикла;
		
		// Комиссия
		
		// Председатель
		Отбор = Новый Структура("Ссылка,Председатель", ВыборкаДокументов.Ссылка, Истина);
		СтрокиПредседатель = СоставКомиссий.НайтиСтроки(Отбор);
		ДанныеПредседателя = Новый Структура("Должность,НаименованиеДолжности,Сотрудник,ОсобыеОтметки,ФайлОсобогоМнения,ФИО");
		Для Каждого Председатель Из СтрокиПредседатель Цикл
			ЗаполнитьЗначенияСвойств(ДанныеПредседателя, Председатель);
			ДанныеПредседателя.ФИО = КорреспондентыКлиентСервер.ФИО(Председатель);
			ОбластьКомиссияП.Параметры.Заполнить(ДанныеПредседателя);
		КонецЦикла;
		ТабличныйДокумент.Вывести(ОбластьКомиссияП);
		
		// Члены комиссии
		Отбор = Новый Структура("Ссылка,Председатель", ВыборкаДокументов.Ссылка, Ложь);
		СтрокиЧленыКомиссии = СоставКомиссий.НайтиСтроки(Отбор);
		ПерваяСтрока = Истина;
		ДанныеЧК = Новый Структура("Должность,НаименованиеДолжности,Сотрудник,ОсобыеОтметки,ФайлОсобогоМнения,ФИО,Заголовок");
		Для Каждого ЧленКомиссии Из СтрокиЧленыКомиссии Цикл
			ЗаполнитьЗначенияСвойств(ДанныеЧК, ЧленКомиссии);
			ДанныеЧК.ФИО = КорреспондентыКлиентСервер.ФИО(ЧленКомиссии);
			ДанныеЧК.Заголовок = ?(ПерваяСтрока, НСтр("ru = 'Члены комиссии:'"), "");
			ОбластьКомиссияС.Параметры.Заполнить(ДанныеЧК);
			ТабличныйДокумент.Вывести(ОбластьКомиссияС);
			ПерваяСтрока = Ложь;
		КонецЦикла;
		
		// Исполнитель
		
		СведенияИсполнителя = УправлениеПечатьюБГУ.СведенияИсполнителяПоОтветственному(ВыборкаДокументов.Ответственный,
			ВыборкаДокументов.Организация, ВыборкаДокументов.ДатаАкта, Истина, Ложь);
		ОбластьИсполнитель.Параметры.Заполнить(СведенияИсполнителя);
		ТабличныйДокумент.Вывести(ОбластьИсполнитель);
		
		// Подвал
		
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		// В табличном документе зададим имя области, в которую был
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ДанныеДляПечати(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ОсновныеСредства
	|ИЗ
	|	Документ.АктКонсервацииРасконсервации КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер,
	|	СобытияОССрезПоследних.Событие КАК Событие,
	|	СобытияОССрезПоследних.ДатаСобытия КАК ДатаСобытия
	|ПОМЕСТИТЬ ДатыСобытий
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			,
	|			ОсновноеСредство В
	|				(ВЫБРАТЬ
	|					ОсновныеСредства.ОсновноеСредство
	|				ИЗ
	|					ОсновныеСредства КАК ОсновныеСредства)) КАК СобытияОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетАмортизацииОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	РасчетАмортизацииОССрезПоследних.СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|ПОМЕСТИТЬ СПИ
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	|			,
	|			ОсновноеСредство В
	|				(ВЫБРАТЬ
	|					ОсновныеСредства.ОсновноеСредство
	|				ИЗ
	|					ОсновныеСредства КАК ОсновныеСредства)) КАК РасчетАмортизацииОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктКонсервацииРасконсервации.Ссылка КАК Ссылка,
	|	АктКонсервацииРасконсервации.Номер КАК Номер,
	|	АктКонсервацииРасконсервации.Дата КАК ДатаАкта,
	|	ВЫБОР
	|		КОГДА АктКонсервацииРасконсервации.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА АктКонсервацииРасконсервации.Организация
	|		ИНАЧЕ АктКонсервацииРасконсервации.Организация.ГоловнаяОрганизация
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА АктКонсервацииРасконсервации.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА ВЫБОР
	|					КОГДА АктКонсервацииРасконсервации.Организация.НаименованиеПолное = """"
	|						ТОГДА АктКонсервацииРасконсервации.Организация.Наименование
	|					ИНАЧЕ АктКонсервацииРасконсервации.Организация.НаименованиеПолное
	|				КОНЕЦ
	|		ИНАЧЕ АктКонсервацииРасконсервации.Организация.ГоловнаяОрганизация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОрганизации,
	|	ВЫБОР
	|		КОГДА АктКонсервацииРасконсервации.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА АктКонсервацииРасконсервации.Организация.КодПоРПБС
	|		ИНАЧЕ АктКонсервацииРасконсервации.Организация.ГоловнаяОрганизация.КодПоРПБС
	|	КОНЕЦ КАК КодРПБС,
	|	ВЫБОР
	|		КОГДА АктКонсервацииРасконсервации.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|		ИНАЧЕ АктКонсервацииРасконсервации.Организация
	|	КОНЕЦ КАК ОбособленноеПодразделение,
	|	ВЫБОР
	|		КОГДА АктКонсервацииРасконсервации.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА """"
	|		ИНАЧЕ АктКонсервацииРасконсервации.Организация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОбособленногоПодразделения,
	|	ВЫБОР
	|		КОГДА АктКонсервацииРасконсервации.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА """"
	|		ИНАЧЕ АктКонсервацииРасконсервации.Организация.КодПоРПБС
	|	КОНЕЦ КАК КодРПБСПодр,
	|	АктКонсервацииРасконсервации.Подразделение КАК СтруктурноеПодразделение,
	|	ВЫБОР
	|		КОГДА АктКонсервацииРасконсервации.Подразделение.НаименованиеПолное = """"
	|			ТОГДА АктКонсервацииРасконсервации.Подразделение.Наименование
	|		ИНАЧЕ АктКонсервацииРасконсервации.Подразделение.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеСтруктурногоПодразделения,
	|	АктКонсервацииРасконсервации.Организация.КодПоППП.НаименованиеПолное КАК Учредитель,
	|	АктКонсервацииРасконсервации.Организация.КодПоППП.Код КАК ГлаваБК,
	|	АктКонсервацииРасконсервации.Организация.Бюджет.НаименованиеПолное КАК БюджетНаименование,
	|	АктКонсервацииРасконсервации.Организация.Бюджет.Код КАК ОКТМО,
	|	АктКонсервацииРасконсервации.Комиссия.НаименованиеПриказа КАК НаименованиеПриказа,
	|	АктКонсервацииРасконсервации.Комиссия.НомерПриказа КАК НомерПриказа,
	|	АктКонсервацииРасконсервации.Комиссия.ДатаПриказа КАК ДатаПриказа,
	|	ЕСТЬNULL(ДатаПринятияКУчету.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПринятияКУчету,
	|	ЕСТЬNULL(ДатаВводаВЭксплуатацию.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВводаВЭксплуатацию,
	|	ЕСТЬNULL(СПИ.СрокПолезногоИспользования, 0) КАК СрокПолезногоИспользования,
	|	АктКонсервацииРасконсервации.ВидОперации + 1 КАК КодОснования,
	|	АктКонсервацииРасконсервации.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА АктКонсервацииРасконсервации.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА АктКонсервацииРасконсервации.ОсновноеСредство.Наименование
	|		ИНАЧЕ АктКонсервацииРасконсервации.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОС,
	|	АктКонсервацииРасконсервации.ОсновноеСредство.АмортизационнаяГруппа.Порядок + 1 КАК АмортизационнаяГруппа,
	|	АктКонсервацииРасконсервации.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	АктКонсервацииРасконсервации.Причина КАК Причина,
	|	АктКонсервацииРасконсервации.Характеристика КАК Характеристика,
	|	АктКонсервацииРасконсервации.ДатаНачала КАК ДатаНачала,
	|	АктКонсервацииРасконсервации.ДатаОкончания КАК ДатаОкончания,
	|	АктКонсервацииРасконсервации.Состояние КАК Состояние,
	|	АктКонсервацииРасконсервации.Статус КАК Статус,
	|	АктКонсервацииРасконсервации.ЦМО КАК ЦМО,
	|	АктКонсервацииРасконсервации.БалансоваяСтоимость КАК БалансоваяСтоимость,
	|	АктКонсервацииРасконсервации.СуммаАмортизацииКонсервация КАК АмортизацияКонсервация,
	|	АктКонсервацииРасконсервации.СуммаАмортизацииРасконсервация КАК АмортизацияРасконсервация,
	|	АктКонсервацииРасконсервации.БалансоваяСтоимость - АктКонсервацииРасконсервации.СуммаАмортизацииКонсервация - АктКонсервацииРасконсервации.СуммаОбесцененияКонсервация КАК ОстаточнаяСтоимостьК,
	|	ВЫБОР
	|		КОГДА АктКонсервацииРасконсервации.ВидОперации = 0
	|				И АктКонсервацииРасконсервации.СуммаАмортизацииРасконсервация = 0
	|				И АктКонсервацииРасконсервации.СуммаОбесцененияРасконсервация = 0
	|			ТОГДА 0
	|		ИНАЧЕ АктКонсервацииРасконсервации.БалансоваяСтоимость - АктКонсервацииРасконсервации.СуммаАмортизацииРасконсервация - АктКонсервацииРасконсервации.СуммаОбесцененияРасконсервация
	|	КОНЕЦ КАК ОстаточнаяСтоимостьР,
	|	АктКонсервацииРасконсервации.ОсновноеСредство.Местонахождение КАК Местонахождение,
	|	АктКонсервацииРасконсервации.ИнвентарныйНомер.ДатаВыпуска КАК ДатаВыпуска,
	|	АктКонсервацииРасконсервации.ИнвентарныйНомер.ЗаводскойНомер КАК ЗаводскойНомер,
	|	АктКонсервацииРасконсервации.ИнвентарныйНомер.РеестровыйНомер КАК РеестровыйНомерОС,
	|	АктКонсервацииРасконсервации.РезолюцияКомиссии КАК РезолюцияКомиссии,
	|	АктКонсервацииРасконсервации.РешениеКомиссии КАК РезолюцияИтог,
	|	АктКонсервацииРасконсервации.Ответственный КАК Ответственный,
	|	АктКонсервацииРасконсервации.Руководитель КАК Руководитель
	|ИЗ
	|	Документ.АктКонсервацииРасконсервации КАК АктКонсервацииРасконсервации
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДатыСобытий КАК ДатаПринятияКУчету
	|		ПО АктКонсервацииРасконсервации.ОсновноеСредство = ДатаПринятияКУчету.ОсновноеСредство
	|			И АктКонсервацииРасконсервации.ИнвентарныйНомер = ДатаПринятияКУчету.ИнвентарныйНомер
	|			И (ДатаПринятияКУчету.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету))
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДатыСобытий КАК ДатаВводаВЭксплуатацию
	|		ПО АктКонсервацииРасконсервации.ОсновноеСредство = ДатаВводаВЭксплуатацию.ОсновноеСредство
	|			И АктКонсервацииРасконсервации.ИнвентарныйНомер = ДатаВводаВЭксплуатацию.ИнвентарныйНомер
	|			И (ДатаВводаВЭксплуатацию.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию))
	|		ЛЕВОЕ СОЕДИНЕНИЕ СПИ КАК СПИ
	|		ПО АктКонсервацииРасконсервации.ОсновноеСредство = СПИ.ОсновноеСредство
	|ГДЕ
