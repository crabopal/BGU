#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если Не ЗначениеЗаполнено(УсловиеПользования) Тогда
		// Автоматическое отражение по регистрам контроля исполнения договоров доступно
		// только в документах с заполненным реквизитом "Условие пользования",
		// которые формируют движения по специальным регистрам Карточки прав пользования
		// (СведенияОбОбъектахПравПользованияОС, ГрафикАмортизацииПравПользованияОС).
		АвтоматическиОтразитьВГрафикахИсполненияДоговоров = Ложь;
	КонецЕсли;
	
	СуммаДокумента = ОсновныеСредства.Итог("ВсегоСправедливая");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	Если Не УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетПравПользованияПоПодразделениям() Тогда
		НепроверяемыеРеквизиты.Добавить("Подразделение");
	КонецЕсли;
	
	ОтраженДоНачалаПримененияКарточкиПравПользования = Не ЗначениеЗаполнено(УсловиеПользования);
	
	Если ОтраженДоНачалаПримененияКарточкиПравПользования Тогда
		
		// В документах, отраженных до начала применения Карточки 0509214,
		// реквизиты ДатаНачалаАмортизации и ДатаОкончанияАмортизации могли не заполняться.
		НепроверяемыеРеквизиты.Добавить("ОсновныеСредства.ДатаНачалаАмортизации");
		НепроверяемыеРеквизиты.Добавить("ОсновныеСредства.ДатаОкончанияАмортизации");
		Для Каждого СтрокаТаблицы Из ОсновныеСредства Цикл
			
			Если СтрокаТаблицы.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам
			 ИЛИ СтрокаТаблицы.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаНачалаАмортизации) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Дата начала начисления амортизации'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Амортизация'"));
					ПолеОшибки = "ОсновныеСредства[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДатаНачалаАмортизации";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаОкончанияАмортизации) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Дата окончания начисления амортизации'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Амортизация'"));
					ПолеОшибки = "ОсновныеСредства[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДатаОкончанияАмортизации";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
				Если НЕ Отказ И СтрокаТаблицы.ДатаОкончанияАмортизации < СтрокаТаблицы.ДатаНачалаАмортизации Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
						НСтр("ru = 'Дата окончания начисления амортизации'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Амортизация'"),
						НСтр("ru = 'Дата начала начисления амортизации превышает дату окончания.'"));
					ПолеОшибки = "ОсновныеСредства[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДатаОкончанияАмортизации";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе // В документах, отраженных после начала применения Карточки 0509214,
		// реквизиты ДатаНачалаАмортизации и ДатаОкончанияАмортизации проверяются в зависимости от условия пользования.
		
		Код = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УсловиеПользования, "Код");
		ОпределенныйСрокПользования = (СтрНайти("11,21", Код) > 0);
		
		НепроверяемыеРеквизиты.Добавить("ОсновныеСредства.ДатаНачалаАмортизации");
		НепроверяемыеРеквизиты.Добавить("ОсновныеСредства.ДатаОкончанияАмортизации");
		Для Каждого СтрокаТаблицы Из ОсновныеСредства Цикл
			
			Если ОпределенныйСрокПользования Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаНачалаАмортизации) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
						НСтр("ru = 'График амортизации'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Основные средства, НПА'"),
						НСтр("ru = 'Дата начала срока пользования (аренды) не заполнена.'"));
					ПолеОшибки = "ОсновныеСредства[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ГрафикАмортизации";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаОкончанияАмортизации) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
						НСтр("ru = 'График амортизации'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Основные средства, НПА'"),
						НСтр("ru = 'Дата окончания срока пользования (аренды) не заполнена.'"));
					ПолеОшибки = "ОсновныеСредства[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ГрафикАмортизации";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
			КонецЕсли;
			
			Если НЕ Отказ
				И ЗначениеЗаполнено(СтрокаТаблицы.ДатаНачалаАмортизации)
				И ЗначениеЗаполнено(СтрокаТаблицы.ДатаОкончанияАмортизации)
				И СтрокаТаблицы.ДатаОкончанияАмортизации < СтрокаТаблицы.ДатаНачалаАмортизации Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					НСтр("ru = 'График амортизации'"),
					СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Основные средства, НПА'"),
					НСтр("ru = 'Дата начала срока пользования (аренды) превышает дату окончания.'"));
				ПолеОшибки = "ОсновныеСредства[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ГрафикАмортизации";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ РазныеПараметрыНачисленияАмортизацииПоОбъектам Тогда // Параметры амортизации в шапке.
		
		НепроверяемыеРеквизиты.Добавить("ОсновныеСредства.СчетРасходов");
		НепроверяемыеРеквизиты.Добавить("ОсновныеСредства.КЭКРасходов");
		
		РеквизитыСчетаРасходов = Новый Структура("Счет, Субконто1, Субконто2, Субконто3, Подразделение",
			"СчетРасходов", "СубконтоРасходов1", "СубконтоРасходов2", "СубконтоРасходов3", "ПодразделениеРасходов");
		БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаРасходов,
			ЭтотОбъект, , Отказ);
		
	Иначе // Параметры амортизации в табличной части.
		
		НепроверяемыеРеквизиты.Добавить("СчетРасходов");
		НепроверяемыеРеквизиты.Добавить("КЭКРасходов");
		
		РеквизитыСчетаРасходов = Новый Структура("Счет, Субконто1, Субконто2, Субконто3, Подразделение",
			"СчетРасходов", "СубконтоРасходов1", "СубконтоРасходов2", "СубконтоРасходов3", "ПодразделениеРасходов");
		БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаРасходов,
			ЭтотОбъект, "ОсновныеСредства" , Отказ);
		
	КонецЕсли;
	
	ЭтоПоступлениеВАренду =
		(ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду);
	ЭтоПоступлениеВАрендуНаЛьготныхУсловиях =
		(ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях);
	ЭтоПоступлениеВБезвозмездноеПользование =
		(ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
		
	Если ЭтоПоступлениеВАрендуНаЛьготныхУсловиях ИЛИ ЭтоПоступлениеВБезвозмездноеПользование Тогда
		РеквизитыСчетаДоходов = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
			"СчетДоходов", "СубконтоДоходов1", "СубконтоДоходов2", "СубконтоДоходов3");
		БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаДоходов,
			ЭтотОбъект, , Отказ);
	КонецЕсли;
	
	Если ЭтоПоступлениеВБезвозмездноеПользование Тогда
		НепроверяемыеРеквизиты.Добавить("ОсновныеСредства.СчетРасчетов");
	КонецЕсли;
	
	// Налоговый учет.
	ДатаУчетнойПолитики = ?(ЗначениеЗаполнено(ВидМежотчетногоПериода), КонецГода(Дата) + 1, Дата);
	Если НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, ДатаУчетнойПолитики, КФО) Тогда
		
		Если ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях
		 ИЛИ ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование Тогда
			
			ЭтоПрочиеДоходы = БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетДоходовНУ, "Н91.01");
			Если НЕ ЭтоПрочиеДоходы Тогда
				НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
			КонецЕсли;
			
		Иначе
			НепроверяемыеРеквизиты.Добавить("ВидДеятельностиНУ");
			НепроверяемыеРеквизиты.Добавить("СчетДоходовНУ");
			НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
		КонецЕсли;
		
		Если НЕ РазныеПараметрыНачисленияАмортизацииПоОбъектам Тогда // Параметры амортизации в шапке.
			
			НепроверяемыеРеквизиты.Добавить("ОсновныеСредства.СтатьяПрочихРасходовНУ");
			
			ЭтоПрочиеРасходы = БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетРасходов, "401.20");
			Если НЕ ЭтоПрочиеРасходы Тогда
				НепроверяемыеРеквизиты.Добавить("СтатьяПрочихРасходовНУ");
			КонецЕсли;
			
		Иначе // Параметры амортизации в табличной части.
			
			НепроверяемыеРеквизиты.Добавить("СтатьяПрочихРасходовНУ");
			
			НепроверяемыеРеквизиты.Добавить("ОсновныеСредства.СтатьяПрочихРасходовНУ");
			Для Каждого СтрокаТаблицы Из ОсновныеСредства Цикл
				
				ЭтоПрочиеРасходы = БухгалтерскийУчетКлиентСервер.СчетВИерархии(СтрокаТаблицы.СчетРасходов, "401.20");
				Если ЭтоПрочиеРасходы И НЕ ЗначениеЗаполнено(СтрокаТаблицы.СтатьяПрочихРасходовНУ) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Статья прочих расходов (НУ)'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Амортизация'"));
					ПолеОшибки = "ОсновныеСредства[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СтатьяПрочихРасходовНУ";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		НепроверяемыеРеквизиты.Добавить("ВидДеятельностиНУ");
		НепроверяемыеРеквизиты.Добавить("СчетДоходовНУ");
		НепроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
		НепроверяемыеРеквизиты.Добавить("СтатьяПрочихРасходовНУ");
		НепроверяемыеРеквизиты.Добавить("ОсновныеСредства.СтатьяПрочихРасходовНУ");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	Если ОтраженДоНачалаПримененияКарточкиПравПользования Тогда
		
		Отбор = Новый Структура("СпособПризнанияРасходов", Перечисления.СпособыПризнанияРасходов.ПоГрафику);
		СтрокиСоСпособомПризнанияПоГрафику = ОсновныеСредства.НайтиСтроки(Отбор);
		Если СтрокиСоСпособомПризнанияПоГрафику.Количество() > 0 Тогда
			
			// Способ признания расходов "По графику" нельзя использовать при безвозмездном поступлении имущества.
			Если ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование Тогда
				
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					НСтр("ru = 'Способ признания расходов'"),
					СтрокиСоСпособомПризнанияПоГрафику[0].НомерСтроки, НСтр("ru = 'Амортизация'"),
					НСтр("ru='Способ ""По графику"" нельзя использовать по договорам безвозмездного пользования.'"));
				ПолеОшибки = "ОсновныеСредства[" + Формат(СтрокиСоСпособомПризнанияПоГрафику[0].НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СпособПризнанияРасходов";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				
			КонецЕсли;
			
			Если НЕ Отказ Тогда
				
				// Способ "По графику" можно использовать только для всех объектов по договору сразу,
				// т.к. график платежей регистрируется и фактическая оплата производится по договору в целом.
				Для Каждого СтрокаТаблицы Из ОсновныеСредства Цикл
					Если СтрокаТаблицы.СпособПризнанияРасходов <> Перечисления.СпособыПризнанияРасходов.ПоГрафику Тогда
						
						ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
							НСтр("ru = 'Способ признания расходов'"),
							СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Амортизация'"),
							НСтр("ru='Способ ""По графику"" можно использовать только для всех объектов по договору сразу.'"));
						ПолеОшибки = "ОсновныеСредства[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СпособПризнанияРасходов";
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
						
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		// Контроль соответствия графика амортизации и итоговой суммы (колонка "Всего") в строке документа.
		Для Каждого СтрокаТаблицы Из ОсновныеСредства Цикл
			
			Отбор = Новый Структура("ОсновноеСредство", СтрокаТаблицы.ОсновноеСредство);
			ГрафикАмортизацииПоОбъекту = ГрафикАмортизации.Выгрузить(Отбор);
			
			Если СтрокаТаблицы.ВсегоСправедливая <> ГрафикАмортизацииПоОбъекту.Итог("Амортизация") Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Итоговая справедливая стоимость арендных платежей (%1) не совпадает с итоговой суммой по графику начисления амортизации (%2).'"),
						Формат(СтрокаТаблицы.ВсегоСправедливая, "ЧЦ=15; ЧДЦ=2"),
						Формат(ГрафикАмортизацииПоОбъекту.Итог("Амортизация"), "ЧЦ=15; ЧДЦ=2") );
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					НСтр("ru = 'Всего - Справедливая стоимость'"),
					СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Основные средства, НПА'"),
					ТекстОшибки);
				ПолеОшибки = "ОсновныеСредства[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ВсегоСправедливая";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
			КонецЕсли;
			
			Если СтрокаТаблицы.Всего <> ГрафикАмортизацииПоОбъекту.Итог("АренднаяПлата") Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Итоговая сумма арендных платежей по договору (%1) не совпадает с итоговой суммой арендной платы по графику начисления амортизации (%2).'"),
						Формат(СтрокаТаблицы.Всего, "ЧЦ=15; ЧДЦ=2"),
						Формат(ГрафикАмортизацииПоОбъекту.Итог("АренднаяПлата"), "ЧЦ=15; ЧДЦ=2") );
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					НСтр("ru = 'Всего - Сумма по договору'"),
					СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Основные средства, НПА'"),
					ТекстОшибки);
				ПолеОшибки = "ОсновныеСредства[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Всего";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Контроль ведения расчетов в иностранной валюте.
	Если ЗначениеЗаполнено(ВалютаДокумента)
		И ВалютаДокумента <> Константы.ВалютаРегламентированногоУчета.Получить()
		И ВидОперации <> Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru='Учет в иностранной валюте не поддерживается для вида операции ""%1"".
			|Учет в иностранной валюте поддерживается только для вида операции ""%2"".'"),
				ВидОперации, Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "ВидОперации", "Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
