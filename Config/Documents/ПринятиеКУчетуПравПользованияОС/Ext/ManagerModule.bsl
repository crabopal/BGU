Функция ПечатьСведениийОПризнанииОбъектовПраваПользования0510478(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ТолькоПросмотр		= Истина;
	ТабличныйДокумент.КлючПараметровПечати	= "ПараметрыПечати_СведениияОПризнанииОбъектовПраваПользования_0510478";
	
	Макет = Документы.ПринятиеКУчетуПравПользованияОС.ПолучитьМакет("ПФ_MXL_0510478");
	
	ОбщиеСведения = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ПринятиеКУчетуПравПользованияОС.Ссылка КАК Ссылка,
	|	ПринятиеКУчетуПравПользованияОС.Номер КАК Номер,
	|	ПринятиеКУчетуПравПользованияОС.Организация КАК Организация,
	|	ПринятиеКУчетуПравПользованияОС.Дата КАК ДатаДок,
	|	ПринятиеКУчетуПравПользованияОС.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ПринятиеКУчетуПравПользованияОС.Контрагент.НаименованиеСокращенное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА ПринятиеКУчетуПравПользованияОС.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ ПринятиеКУчетуПравПользованияОС.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	|						ТОГДА ПринятиеКУчетуПравПользованияОС.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|					ИНАЧЕ ПринятиеКУчетуПравПользованияОС.Контрагент.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ ПринятиеКУчетуПравПользованияОС.Контрагент.НаименованиеСокращенное
	|	КОНЕЦ КАК Правообладатель,
	|	ВЫБОР
	|		КОГДА ПринятиеКУчетуПравПользованияОС.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА ПринятиеКУчетуПравПользованияОС.Контрагент.ЮридическоеФизическоеЛицо.КодПоРПБС
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КодРПБСПравообладатель,
	|	ПринятиеКУчетуПравПользованияОС.Договор КАК Договор,
	|	ПринятиеКУчетуПравПользованияОС.Договор.ВидОбязательства КАК ДокументПравоПользования,
	|	ПринятиеКУчетуПравПользованияОС.Договор.НомерДоговора КАК ДокументПравоПользованияНомер,
	|	ПринятиеКУчетуПравПользованияОС.Договор.ДатаДоговора КАК ДокументПравоПользованияДата,
	|	ПринятиеКУчетуПравПользованияОС.ВидПервичногоДокумента КАК ДокументПередачи,
	|	ПринятиеКУчетуПравПользованияОС.НомерПервичногоДокумента КАК ДокументПередачиНомер,
	|	ПринятиеКУчетуПравПользованияОС.ДатаПервичногоДокумента КАК ДокументПередачиДата,
	|	ПринятиеКУчетуПравПользованияОС.Руководитель КАК Руководитель
	|ИЗ
	|	Документ.ПринятиеКУчетуПравПользованияОС КАК ПринятиеКУчетуПравПользованияОС
	|ГДЕ
	|	ПринятиеКУчетуПравПользованияОС.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.НомерСтроки КАК КодСтроки,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ВсегоСправедливая КАК ВсегоСправедливая,
	|	ОсновныеСредства.АренднаяПлатаСумма КАК АренднаяПлатаСумма,
	|	ОсновныеСредства.АренднаяПлатаЗаПериод КАК АренднаяПлатаЗаПериод,
	|	ОсновныеСредства.АренднаяПлатаДеньНачисления КАК АренднаяПлатаДеньНачисления,
	|	ОсновныеСредства.ОсновноеСредство.НаименованиеПолное КАК НаименованиеОбъекта,
	|	ОсновныеСредства.ОсновноеСредство.Назначение КАК НазначениеОбъекта,
	|	ОсновныеСредства.Ссылка.ЦМО КАК МОЛ,
	|	ОсновныеСредства.Ссылка.ЦМО.Сотрудник КАК Сотрудник,
	|	ОсновныеСредства.Ссылка.ЦМО.МестоХранения КАК МестоХранения,
	|	ОсновныеСредства.Ссылка.УсловиеПользования КАК УсловиеПользования,
	|	ОсновныеСредства.Ссылка.УсловиеПользования.Код КАК УсловиеПользованияКод,
	|	ОсновныеСредства.СчетУчета КАК СчетУчета,
	|	ОсновныеСредства.СчетУчета.Код КАК КодСчета,
	|	ПОДСТРОКА(ОсновныеСредства.СчетУчета.Код, 5, 2) КАК АналитическаяГруппа,
	|	ОсновныеСредства.СчетУчета.Наименование КАК НаименованиеСчета,
	|	ОсновныеСредства.ДатаНачалаАмортизации КАК ДатаНачалаПользования,
	|	ОсновныеСредства.ДатаОкончанияАмортизации КАК ДатаОкончанияПользования,
	|	ОсновныеСредства.ДатаПриемкиОбъектаВПользование КАК ДатаПриемкиОбъектаВПользование,
	|	ОсновныеСредства.Всего КАК Всего,
	|	ОсновныеСредства.ВсегоСправедливая КАК ВсегоСправедливая1
	|ИЗ
	|	Документ.ПринятиеКУчетуПравПользованияОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	ОсновныеСредства.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеХарактеристики.Ссылка КАК Ссылка,
	|	ОсновныеХарактеристики.НомерСтроки КАК НомерСтроки,
	|	ОсновныеХарактеристики.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеХарактеристики.НаименованиеОбъекта КАК НаименованиеОбъекта,
	|	ОсновныеХарактеристики.Количество КАК Количество,
	|	ОсновныеХарактеристики.НаименованиеХарактеристик КАК НаименованиеХарактеристик,
	|	ОсновныеХарактеристики.ЗначениеХарактеристик КАК ЗначениеХарактеристик
	|ИЗ
	|	Документ.ПринятиеКУчетуПравПользованияОС.СведенияОбИмуществе КАК ОсновныеХарактеристики
	|ГДЕ
	|	ОсновныеХарактеристики.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.ВыполнитьПакет();
	Выборка = Результат[0].Выбрать();	
	ОсновныеСредства = Результат[1].Выгрузить();
	СведенияОбИмуществе = Результат[2].Выгрузить();
	
	ПервыйДокумент = Истина;
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;  
		
		ОбщиеСведенияПоДокументу = ОбщиеСведения.Получить(Выборка.Ссылка);
		
		ВывестиШапку(Макет, ТабличныйДокумент, Выборка, ОбщиеСведенияПоДокументу);
		ВывестиРаздел1(Макет, ТабличныйДокумент, Выборка, ОсновныеСредства);
		ВывестиРаздел2(Макет, ТабличныйДокумент, Выборка, ОсновныеСредства, СведенияОбИмуществе);
		ВывестиПодвал(Макет, ТабличныйДокумент, Выборка, ОбщиеСведенияПоДокументу);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура ВывестиШапку(Макет, ТабличныйДокумент, Выборка, ОбщиеСведения)
	
	ОбластьМакетаУтверждаю = Макет.ПолучитьОбласть("Утверждаю");
	ОбластьМакетаШапка = Макет.ПолучитьОбласть("Шапка");
	
	ОбластьМакетаУтверждаю.Параметры.ФИОРуководителя =
		Справочники.Сотрудники.ФамилияИО(Выборка.Руководитель, Ложь, Выборка.ДатаДок);
	ДанныеПодписанта = Новый Структура("СсылкаНаОбъект, Период, Должность", Выборка.Руководитель, Выборка.ДатаДок);
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеПодписанта);
	ОбластьМакетаУтверждаю.Параметры.ДолжностьРуководителя = ДанныеПодписанта.Должность;
	
	ТабличныйДокумент.Вывести(ОбластьМакетаУтверждаю);
	
	ОбластьМакетаШапка.Параметры.Заполнить(Выборка);
	
	ЗаполнитьЗначенияСвойств(ОбластьМакетаШапка.Параметры, ОбщиеСведения,
		"НаименованиеОрганизации, НаименованиеОбособленногоПодразделения, НаименованиеСтруктурногоПодразделения, СтруктурноеПодразделение,
		|БюджетНаименование, КодРПБС, КодРПБСОбособленногоПодразделения, ОКТМО, Учредитель, ГлаваБК");
	
	РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьМакетаШапка,
		"НомерДокумента", Выборка.Номер, Выборка.Ссылка, Неопределено, Истина);
	
	ОбластьМакетаШапка.Параметры.ДатаСтрокой = Формат(Выборка.ДатаДок, "ДЛФ=ДД");
	
	ТабличныйДокумент.Вывести(ОбластьМакетаШапка);
	
КонецПроцедуры

Процедура ВывестиРаздел1(Макет, ТабличныйДокумент, Выборка, ОсновныеСредства)
	
	ОбластьМакетаРаздел11Шапка  = Макет.ПолучитьОбласть("Раздел11Шапка");
	ОбластьМакетаРаздел11Строка = Макет.ПолучитьОбласть("Раздел11Строка");
	ОбластьМакетаРаздел11Итоги  = Макет.ПолучитьОбласть("Раздел11Итоги");
	ОбластьМакетаРаздел12Шапка  = Макет.ПолучитьОбласть("Раздел12Шапка");
	ОбластьМакетаРаздел12Строка = Макет.ПолучитьОбласть("Раздел12Строка");
	ОбластьМакетаРаздел12Итоги  = Макет.ПолучитьОбласть("Раздел12Итоги");
	
	СтрокиДокумента = ОсновныеСредства.НайтиСтроки(Новый Структура("Ссылка", Выборка.Ссылка));
	
	// Разделы 1, верхняя таблица.
	ТабличныйДокумент.Вывести(ОбластьМакетаРаздел11Шапка);
	Для Каждого СтрокаДокумента Из СтрокиДокумента Цикл
		
		ОбластьМакетаРаздел11Строка.Параметры.Заполнить(СтрокаДокумента);
		
		Если ЗначениеЗаполнено(СтрокаДокумента.МестоХранения) Тогда
			АдресМестаХранения = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(СтрокаДокумента.МестоХранения,
				Справочники.ВидыКонтактнойИнформации.АдресМестаХранения);
		Иначе
			АдресМестаХранения = "";
		КонецЕсли;
		Если ЗначениеЗаполнено(АдресМестаХранения) Тогда
			МестонахождениеОбъекта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1, %2'"), СтрокаДокумента.МестоХранения, АдресМестаХранения);
		Иначе
			МестонахождениеОбъекта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1'"), СтрокаДокумента.МестоХранения);
		КонецЕсли;
		ОбластьМакетаРаздел11Строка.Параметры.МестонахождениеОбъекта = МестонахождениеОбъекта;
		
		Если ЗначениеЗаполнено(СтрокаДокумента.Сотрудник) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект,Период,Фамилия,Имя,Отчество,Должность,ДолжностьНаименование", СтрокаДокумента.Сотрудник, Выборка.ДатаДок);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
			ОтветственноеЛицоФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь, , Ложь);
			ОбластьМакетаРаздел11Строка.Параметры.ОтветственноеЛицо = ?(ЗначениеЗаполнено(ДанныеСотрудника.ДолжностьНаименование),
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1, %2'"), ОтветственноеЛицоФИО, ДанныеСотрудника.ДолжностьНаименование),
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"), ОтветственноеЛицоФИО));
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьМакетаРаздел11Строка);
		
	КонецЦикла;
	ТабличныйДокумент.Вывести(ОбластьМакетаРаздел11Итоги);
	
	// Разделы 1, нижняя таблица.
	ТабличныйДокумент.Вывести(ОбластьМакетаРаздел12Шапка);
	Для Каждого СтрокаДокумента Из СтрокиДокумента Цикл
		
		ОбластьМакетаРаздел12Строка.Параметры.Заполнить(СтрокаДокумента);
		
		Если СтрНайти("12,22", СтрокаДокумента.УсловиеПользованияКод) Тогда
			// Графа 16 не заполняется, если срок пользования в договоре аренды не определен, т.е. если графа 8 принимает одно из значений:
			// 12 - аренда с неопределенным сроком использования или
			// 22 - безвозмездное пользование с неопределенным сроком использования.
			ОбластьМакетаРаздел12Строка.Параметры.АренднаяПлатаОбщаяСумма = 0;
		Иначе
			ОбластьМакетаРаздел12Строка.Параметры.АренднаяПлатаОбщаяСумма = СтрокаДокумента.ВсегоСправедливая;
		КонецЕсли;
		Если СтрНайти("21,22", СтрокаДокумента.УсловиеПользованияКод) Тогда
			 // В случае признания в бухгалтерском учете объекта учета операционной аренды на льготных условиях по договорам безвозмездного пользования графа 15 не заполняется.
			ОбластьМакетаРаздел12Строка.Параметры.АренднаяПлатаДеньНачисления = "";
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьМакетаРаздел12Строка);
		
	КонецЦикла;
	ТабличныйДокумент.Вывести(ОбластьМакетаРаздел12Итоги);
	
КонецПроцедуры

Процедура ВывестиРаздел2(Макет, ТабличныйДокумент, Выборка, ОсновныеСредства, СведенияОбИмуществе)
	
	ОбластьМакетаРаздел21Заголовок = Макет.ПолучитьОбласть("Раздел21Заголовок");
	ОбластьМакетаРаздел21Шапка     = Макет.ПолучитьОбласть("Раздел21Шапка");
	ОбластьМакетаРаздел21Строка    = Макет.ПолучитьОбласть("Раздел21Строка");
	ОбластьМакетаРаздел21Итоги     = Макет.ПолучитьОбласть("Раздел21Итоги");
	
	ТабличныйДокумент.Вывести(ОбластьМакетаРаздел21Заголовок);
	
	СтрокиДокумента = ОсновныеСредства.НайтиСтроки(Новый Структура("Ссылка", Выборка.Ссылка));
	Для Каждого СтрокаДокумента Из СтрокиДокумента Цикл
		
		// Заголовок и шапка таблицы.
		ОбластьМакетаРаздел21Шапка.Параметры.Заполнить(СтрокаДокумента);
		ОбластьМакетаРаздел21Шапка.Параметры.Раздел21Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("2.%1. %2",
				СтрокаДокумента.КодСтроки,
				НСтр("ru = 'Наименование основного объекта имущественного комплекса (при наличии)'"));
		ТабличныйДокумент.Вывести(ОбластьМакетаРаздел21Шапка);
		
		// Строки таблицы.
		НомерСтрокиСведений = 1;
		СтрокиСведенияОбИмуществе = СведенияОбИмуществе.НайтиСтроки(Новый Структура("ОсновноеСредство", СтрокаДокумента.ОсновноеСредство));
		Для Каждого СтрокаСведенияОбИмуществе Из СтрокиСведенияОбИмуществе Цикл
			ОбластьМакетаРаздел21Строка.Параметры.Заполнить(СтрокаСведенияОбИмуществе);
			ОбластьМакетаРаздел21Строка.Параметры.КодСтроки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("2.%1.%2",
				СтрокаДокумента.КодСтроки,
				Формат(НомерСтрокиСведений, "ЧЦ=2; ЧВН=1"));
			ТабличныйДокумент.Вывести(ОбластьМакетаРаздел21Строка);
			НомерСтрокиСведений = НомерСтрокиСведений + 1;
		КонецЦикла;
		
		ТабличныйДокумент.Вывести(ОбластьМакетаРаздел21Итоги);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиПодвал(Макет, ТабличныйДокумент, Выборка, ОбщиеСведения)
	
	ОбластьПодпись = Макет.ПолучитьОбласть("Подпись");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ЗаполнитьЗначенияСвойств(ОбластьПодпись.Параметры, ОбщиеСведения,
		"ОтветственныйФИО, ОтветственныйДолжность, ОтветственныйТелефон, ОтветственныйЭлПочта");
	ТабличныйДокумент.Вывести(ОбластьПодпись);
	
	ОбластьПодвал.Параметры.ДатаПодписи = Формат(Выборка.ДатаДок, "ДЛФ=ДД");
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Перенести значения реквизитов шапки УдалитьСпособПризнанияРасходов, УдалитьДатаНачалаАмортизации, УдалитьДатаОкончанияАмортизации
	// в табличную часть ОсновныеСредства.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПринятиеКУчетуПравПользованияОС.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПринятиеКУчетуПравПользованияОС.ОсновныеСредства КАК ПринятиеКУчетуПравПользованияОС
	|ГДЕ
	|	(ПринятиеКУчетуПравПользованияОС.СпособПризнанияРасходов = ЗНАЧЕНИЕ(Перечисление.СпособыПризнанияРасходов.ПустаяСсылка)
	|			ИЛИ ПринятиеКУчетуПравПользованияОС.ДатаНачалаАмортизации = &ПустаяДата
	|			ИЛИ ПринятиеКУчетуПравПользованияОС.ДатаОкончанияАмортизации = &ПустаяДата)
	|	И ПринятиеКУчетуПравПользованияОС.Ссылка.УдалитьСпособПризнанияРасходов <> ЗНАЧЕНИЕ(Перечисление.СпособыПризнанияРасходов.ПустаяСсылка)
	|	И НЕ ПринятиеКУчетуПравПользованияОС.Ссылка.РазныеПараметрыНачисленияАмортизацииПоОбъектам";
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.ПринятиеКУчетуПравПользованияОС";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			// Объект не удается заблокировать - попробуем обработать его на следующей итерации.
			// Отдельно обрабатывать ошибку не требуется, т.к. в худшем случае обработчик зациклится
			// и прервется автоматически.
			ЗафиксироватьТранзакцию();
			Продолжить;
		КонецПопытки;
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Выборка.Ссылка) Тогда
			// Вероятно был удален раньше, чем обработчик дошел до него
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		
		Для Каждого СтрокаОсновныеСредства Из Объект.ОсновныеСредства Цикл
			
			Если Не Объект.РазныеПараметрыНачисленияАмортизацииПоОбъектам Тогда
				СтрокаОсновныеСредства.СпособПризнанияРасходов = Объект.УдалитьСпособПризнанияРасходов;
				СтрокаОсновныеСредства.ДатаНачалаАмортизации = Объект.УдалитьДатаНачалаАмортизации;
				СтрокаОсновныеСредства.ДатаОкончанияАмортизации = Объект.УдалитьДатаОкончанияАмортизации;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не Объект.Модифицированность() Тогда
			
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
			
		КонецЕсли;
		
		Попытка
		
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.НакладнаяНаОтпускИК,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
