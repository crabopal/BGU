// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПринятиеКУчетуПравПользованияОС";
	КомандаПечати.Идентификатор		= "СведенияОПризнанииОбъектовПраваПользования0510478";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Сведения о признании объектов права пользования НФА'"), "0510478");
	КомандаПечати.Порядок			= 1;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПринятиеКУчетуПравПользованияОС";
	КомандаПечати.Идентификатор		= "ПечатьКарточекУчетаПраваПользованияНФА";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Карточки учета прав пользования НФА'"), "0509214");
	КомандаПечати.Порядок			= 2;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПечатьКарточекУчетаПраваПользованияНФА") Тогда
		
		ДанныеДляПечати = УправлениеОсновнымиСредствами.ОбъектыДляГрупповойПечатиКарточек(МассивОбъектов, "ОсновноеСредство", "ОсновныеСредства");
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПечатьКарточекУчетаПраваПользованияНФА", "Карточки учета прав пользования НФА",
			Справочники.ОсновныеСредства.ПечатьКарточкиУчетаПраваПользованияНФА(
				ДанныеДляПечати, ОбъектыПечати, ПараметрыПечати));
			
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СведенияОПризнанииОбъектовПраваПользования0510478") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"СведенияОПризнанииОбъектовПраваПользования0510478",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
				НСтр("ru = 'Сведения о признании объектов права пользования НФА'"), "0510478", "61н"),
			ПечатьСведениийОПризнанииОбъектовПраваПользования0510478(МассивОбъектов, ОбъектыПечати, ПараметрыПечати));
			
	КонецЕсли;
	
