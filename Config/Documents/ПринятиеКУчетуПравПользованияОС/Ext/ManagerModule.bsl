#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Начало применения унифицированной формы "Сведения о признании объектов права пользования нефинансовыми активами" (ф. 0510478).
// 
Функция НачалоПримененияФормыСведения0510478() Экспорт
	
	Возврат Дата(2026, 1, 1);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,Дата,ВидМежотчетногоПериода,ПервичныйДокумент,ВидОперации,КФО,СчетРасходов,СчетДоходовНУ,
		|АвтоматическиОтразитьВГрафикахИсполненияДоговоров,УсловиеПользования,РазныеПараметрыНачисленияАмортизацииПоОбъектам");
	
	ДатаУчетнойПолитики = ?(ЗначениеЗаполнено(ЗначенияРеквизитов.ВидМежотчетногоПериода),
		КонецГода(ЗначенияРеквизитов.Дата) + 1, ЗначенияРеквизитов.Дата);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ОтражатьВНалоговомУчете",
		НалоговыйУчет.ОтражатьВНалоговомУчете(ЗначенияРеквизитов.Организация, ДатаУчетнойПолитики, ЗначенияРеквизитов.КФО));
	Запрос.УстановитьПараметр("СчетаУчетаПрочихРасходов", БухгалтерскийУчет.СписокСчетов("401.20"));
	Запрос.УстановитьПараметр("ЭтоПрочиеДоходы",
		БухгалтерскийУчетКлиентСервер.СчетВИерархии(ЗначенияРеквизитов.СчетДоходовНУ, "Н91.01"));
	Запрос.УстановитьПараметр("ЕстьПервичныйДокумент", ЗначениеЗаполнено(ЗначенияРеквизитов.ПервичныйДокумент));  // Первичный документ ф.0510478 с 01.01.2026.
	
	Запрос.УстановитьПараметр("РазныеПараметрыНачисленияАмортизацииПоОбъектам",
		ЗначенияРеквизитов.РазныеПараметрыНачисленияАмортизацииПоОбъектам);
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	ВидыОперацийЛьготнаяАренда = Новый Массив;
	ВидыОперацийЛьготнаяАренда.Добавить(Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях);
	ВидыОперацийЛьготнаяАренда.Добавить(Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
	Запрос.УстановитьПараметр("ВидыОперацийЛьготнаяАренда", ВидыОперацийЛьготнаяАренда);
	
	Запрос.УстановитьПараметр("ЭтоПоступлениеВБезвозмездноеПользование",
		ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ПараметрыАмортизацииПравПользованияОС", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПринятиеКУчетуПравПользованияОС.Ссылка.Дата КАК Период,
	|	ПринятиеКУчетуПравПользованияОС.Ссылка.Договор КАК Договор,
	|	ПринятиеКУчетуПравПользованияОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ПринятиеКУчетуПравПользованияОС.Ссылка.Организация КАК Организация,
	|	ПринятиеКУчетуПравПользованияОС.Ссылка.ВидОперации КАК ВидОперации,
	|	ПринятиеКУчетуПравПользованияОС.СпособПризнанияРасходов КАК СпособПризнанияРасходов,
	|	ПринятиеКУчетуПравПользованияОС.ДатаНачалаАмортизации КАК ДатаНачалаАмортизации,
	|	ПринятиеКУчетуПравПользованияОС.ДатаОкончанияАмортизации КАК ДатаОкончанияАмортизации,
	|	ПринятиеКУчетуПравПользованияОС.Ссылка.СчетРасходов КАК СчетРасходов,
	|	ПринятиеКУчетуПравПользованияОС.Ссылка.КПСРасходов КАК КПСРасходов,
	|	ПринятиеКУчетуПравПользованияОС.Ссылка.КЭКРасходов КАК КЭКРасходов,
	|	ПринятиеКУчетуПравПользованияОС.Ссылка.ПодразделениеРасходов КАК ПодразделениеРасходов,
	|	ПринятиеКУчетуПравПользованияОС.Ссылка.СубконтоРасходов1 КАК СубконтоРасходов1,
	|	ПринятиеКУчетуПравПользованияОС.Ссылка.СубконтоРасходов2 КАК СубконтоРасходов2,
	|	ПринятиеКУчетуПравПользованияОС.Ссылка.СубконтоРасходов3 КАК СубконтоРасходов3,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|				И ПринятиеКУчетуПравПользованияОС.Ссылка.СчетРасходов В (&СчетаУчетаПрочихРасходов)
	|			ТОГДА ПринятиеКУчетуПравПользованияОС.Ссылка.СтатьяПрочихРасходовНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|	КОНЕЦ КАК СтатьяПрочихРасходовНУ,
	|	ПринятиеКУчетуПравПользованияОС.Ссылка.ПринятьНДСКВычету КАК ПринятьНДСКВычету,
	|	ВЫБОР
	|		КОГДА &ЭтоПоступлениеВБезвозмездноеПользование
	|			ТОГДА ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|		ИНАЧЕ ПринятиеКУчетуПравПользованияОС.СчетРасчетов
	|	КОНЕЦ КАК СчетРасчетов,
	|	ВЫБОР
	|		КОГДА &ЭтоПоступлениеВБезвозмездноеПользование
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|		КОГДА ПринятиеКУчетуПравПользованияОС.КПСРасчетов = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|			ТОГДА ПринятиеКУчетуПравПользованияОС.КПС
	|		ИНАЧЕ ПринятиеКУчетуПравПользованияОС.КПСРасчетов
	|	КОНЕЦ КАК КПСРасчетов,
	|	ВЫБОР
	|		КОГДА &ЭтоПоступлениеВБезвозмездноеПользование
	|			ТОГДА ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|		ИНАЧЕ ПринятиеКУчетуПравПользованияОС.СчетРезервов
	|	КОНЕЦ КАК СчетРезервов,
	|	ВЫБОР
	|		КОГДА &ЭтоПоступлениеВБезвозмездноеПользование
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|		КОГДА ПринятиеКУчетуПравПользованияОС.КПСРасчетов = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|				И ПринятиеКУчетуПравПользованияОС.КПСРезервов = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|			ТОГДА ПринятиеКУчетуПравПользованияОС.КПС
	|		КОГДА ПринятиеКУчетуПравПользованияОС.КПСРасчетов <> ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|				И ПринятиеКУчетуПравПользованияОС.КПСРезервов = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|			ТОГДА ПринятиеКУчетуПравПользованияОС.КПСРасчетов
	|		ИНАЧЕ ПринятиеКУчетуПравПользованияОС.КПСРезервов
	|	КОНЕЦ КАК КПСРезервов,
	|	ВЫБОР
	|		КОГДА &ЭтоПоступлениеВБезвозмездноеПользование
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Резервы.ПустаяСсылка)
	|		ИНАЧЕ ПринятиеКУчетуПравПользованияОС.Резерв
	|	КОНЕЦ КАК Резерв
	|ИЗ
	|	Документ.ПринятиеКУчетуПравПользованияОС.ОсновныеСредства КАК ПринятиеКУчетуПравПользованияОС
	|ГДЕ
	|	ПринятиеКУчетуПравПользованияОС.Ссылка = &Ссылка";
	
	Если ЗначенияРеквизитов.РазныеПараметрыНачисленияАмортизацииПоОбъектам Тогда
		
		// Параметры начисления амортизации в табличной части.
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ПринятиеКУчетуПравПользованияОС.Ссылка.СчетРасходов",
			"ПринятиеКУчетуПравПользованияОС.СчетРасходов");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ПринятиеКУчетуПравПользованияОС.Ссылка.КПСРасходов",
			"ПринятиеКУчетуПравПользованияОС.КПСРасходов");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ПринятиеКУчетуПравПользованияОС.Ссылка.КЭКРасходов",
			"ПринятиеКУчетуПравПользованияОС.КЭКРасходов");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ПринятиеКУчетуПравПользованияОС.Ссылка.ПодразделениеРасходов",
			"ПринятиеКУчетуПравПользованияОС.ПодразделениеРасходов");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ПринятиеКУчетуПравПользованияОС.Ссылка.СубконтоРасходов1",
			"ПринятиеКУчетуПравПользованияОС.СубконтоРасходов1");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ПринятиеКУчетуПравПользованияОС.Ссылка.СубконтоРасходов2",
			"ПринятиеКУчетуПравПользованияОС.СубконтоРасходов2");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ПринятиеКУчетуПравПользованияОС.Ссылка.СубконтоРасходов3",
			"ПринятиеКУчетуПравПользованияОС.СубконтоРасходов3");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ПринятиеКУчетуПравПользованияОС.Ссылка.СтатьяПрочихРасходовНУ",
			"ПринятиеКУчетуПравПользованияОС.СтатьяПрочихРасходовНУ");
		
	КонецЕсли;
	
	НомераТаблиц.Вставить("ПараметрыСписанияДоходовБудущихПериодов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ПринятиеКУчетуПравПользованияОС.Дата КАК Период,
	|	ПринятиеКУчетуПравПользованияОС.Договор КАК Договор,
	|	ПринятиеКУчетуПравПользованияОС.Организация КАК Организация,
	|	ПринятиеКУчетуПравПользованияОС.ВидОперации КАК ВидОперации,
	|	ЗНАЧЕНИЕ(Перечисление.СпособыПризнанияРасходов.ПустаяСсылка) КАК СпособПризнанияДоходов,
	|	&ПустаяДата КАК ДатаНачалаСписания,
	|	&ПустаяДата КАК ДатаОкончанияСписания,
	|	ПринятиеКУчетуПравПользованияОС.СчетДоходов КАК СчетДоходов,
	|	ПринятиеКУчетуПравПользованияОС.СубконтоДоходов1 КАК СубконтоДоходов1,
	|	ПринятиеКУчетуПравПользованияОС.СубконтоДоходов2 КАК СубконтоДоходов2,
	|	ПринятиеКУчетуПравПользованияОС.СубконтоДоходов3 КАК СубконтоДоходов3,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|			ТОГДА ПринятиеКУчетуПравПользованияОС.ВидДеятельностиНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ПустаяСсылка)
	|	КОНЕЦ КАК ВидДеятельностиНУ,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|			ТОГДА ПринятиеКУчетуПравПользованияОС.СчетДоходовНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	КОНЕЦ КАК СчетДоходовНУ,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|				И &ЭтоПрочиеДоходы
	|			ТОГДА ПринятиеКУчетуПравПользованияОС.СтатьяПрочихДоходовНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|	КОНЕЦ КАК СтатьяПрочихДоходовНУ
	|ИЗ
	|	Документ.ПринятиеКУчетуПравПользованияОС КАК ПринятиеКУчетуПравПользованияОС
	|ГДЕ
	|	ПринятиеКУчетуПравПользованияОС.Ссылка = &Ссылка
	|	И ПринятиеКУчетуПравПользованияОС.ВидОперации В(&ВидыОперацийЛьготнаяАренда)";
	
	Если ЗначениеЗаполнено(ЗначенияРеквизитов.УсловиеПользования) Тогда
		
		НомераТаблиц.Вставить("СведенияОбОбъектахПравПользованияОС", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ПринятиеКУчетуПравПользованияОС.Ссылка.Дата КАК Период,
		|	ПринятиеКУчетуПравПользованияОС.Ссылка.Договор КАК Договор,
		|	ПринятиеКУчетуПравПользованияОС.ОсновноеСредство КАК ОсновноеСредство,
		|	ПринятиеКУчетуПравПользованияОС.Ссылка.Организация КАК Организация,
		|	ПринятиеКУчетуПравПользованияОС.Ссылка.УсловиеПользования КАК УсловиеПользования,
		|	ПринятиеКУчетуПравПользованияОС.СпособПризнанияРасходов КАК СпособПризнанияРасходов,
		|	ПринятиеКУчетуПравПользованияОС.ДатаНачалаАмортизации КАК ДатаНачалаСрокаПользования,
		|	ПринятиеКУчетуПравПользованияОС.ДатаОкончанияАмортизации КАК ДатаОкончанияСрокаПользования,
		|	ПринятиеКУчетуПравПользованияОС.АренднаяПлатаСумма КАК АренднаяПлатаСумма,
		|	ПринятиеКУчетуПравПользованияОС.АренднаяПлатаЗаПериод КАК АренднаяПлатаЗаПериод,
		|	ПринятиеКУчетуПравПользованияОС.АренднаяПлатаДеньНачисления КАК АренднаяПлатаДеньНачисления,
		|	ПринятиеКУчетуПравПользованияОС.ДатаПриемкиОбъектаВПользование КАК ДатаПриемкиОбъектаВПользование,
		|	ВЫБОР
		|		КОГДА &ЕстьПервичныйДокумент
		|			ТОГДА ПринятиеКУчетуПравПользованияОС.Ссылка.Договор.ВидОбязательства
		|		ИНАЧЕ ПринятиеКУчетуПравПользованияОС.Ссылка.ВидПервичногоДокумента
		|	КОНЕЦ КАК ДокументОснованиеВид,
		|	ВЫБОР
		|		КОГДА &ЕстьПервичныйДокумент
		|			ТОГДА ПринятиеКУчетуПравПользованияОС.Ссылка.Договор.ДатаДоговора
		|		ИНАЧЕ ПринятиеКУчетуПравПользованияОС.Ссылка.ДатаПервичногоДокумента
		|	КОНЕЦ КАК ДокументОснованиеДата,
		|	ВЫБОР
