
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, ПараметрыНачисленияАмортизации());
	
	ВидОперации = Параметры.ВидОперации;
	Договор = Параметры.Договор;
	Если Не ЗначениеЗаполнено(АренднаяПлатаЗаПериод) Тогда
		АренднаяПлатаЗаПериод = "месяц"; // По умолчанию.
	КонецЕсли;
	Если АренднаяПлатаДеньНачисления = 0 Тогда
		АренднаяПлатаДеньНачисления = 1; // По умолчанию.
	КонецЕсли;
	Если АренднаяПлатаДеньОплаты = 0 Тогда
		АренднаяПлатаДеньОплаты = 1; // По умолчанию.
	КонецЕсли;
	
	Если Параметры.Свойство("ГрафикАмортизации") И ЭтоАдресВременногоХранилища(Параметры.ГрафикАмортизации) Тогда
		ТаблицаГрафикАмортизации = ПолучитьИзВременногоХранилища(Параметры.ГрафикАмортизации);
		ГрафикАмортизации.Загрузить(ТаблицаГрафикАмортизации);
	КонецЕсли;
	
	Если ГрафикАмортизации.Количество() = 0 Тогда
		СформироватьГрафикНачисленияАмортизацииНаСервере();
	КонецЕсли;
	
	ИтогАмортизация = ГрафикАмортизации.Итог("Амортизация");
	ИтогАренднаяПлата = ГрафикАмортизации.Итог("АренднаяПлата");
	
	Если Параметры.Свойство("СпособПризнанияРасходовДоступность") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СпособПризнанияРасходов",
			"Доступность", Параметры.СпособПризнанияРасходовДоступность);
	КонецЕсли;
	Если Параметры.Свойство("ДатаНачалаАмортизацииДоступность") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДатаНачалаАмортизации",
			"Доступность", Параметры.ДатаНачалаАмортизацииДоступность);
	КонецЕсли;
	Если Параметры.Свойство("ДатаОкончанияАмортизацииДоступность") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДатаОкончанияАмортизации",
			"Доступность", Параметры.ДатаОкончанияАмортизацииДоступность);
	КонецЕсли;
	
	ВестиГрафикПлатежей = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров")
		И ЗначениеЗаполнено(Договор)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ВестиГрафикПлатежей");
	
	УстановитьДоступностьКнопкиСформироватьГрафик(ЭтотОбъект);
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность И НЕ ПеренестиВДокумент Тогда
		
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");
		Оповещение = Новый ОписаниеОповещения("ВопросЗавершитьРедактирование", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
		Отказ = Истина;
		
	Иначе
		
		Если ПеренестиВДокумент И НЕ Отказ Тогда
			Отказ = НЕ ПроверитьЗаполнениеНаКлиенте();
		КонецЕсли;
		
		Если Отказ Тогда
			ПеренестиВДокумент = Ложь;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВопросЗавершитьРедактирование(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокумент = Истина;
		Закрыть();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		ПеренестиВДокумент = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если ПеренестиВДокумент Тогда
		
		СтруктураРезультат = Новый Структура(ПараметрыНачисленияАмортизации());
		ЗаполнитьЗначенияСвойств(СтруктураРезультат, ЭтаФорма);
		
		СтруктураРезультат.Вставить("ГрафикАмортизации", ПоместитьГрафикАмортизацииВХранилище());
		
		ОповеститьОВыборе(СтруктураРезультат);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ФормаГрафикНачисленияАмортизации_Закрыть" И Источник = ВладелецФормы Тогда
		// Сообщение от основной формы документа при нажатии там Esc.
		// Сбрасываем флаг модифицированности и закрываем форму редактирования строки без вопросов.
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура АренднаяПлатаСуммаПриИзменении(Элемент)
	
	РассчитатьИтоговыеСуммы();
	
	Если ГрафикАмортизации.Количество() = 0 Тогда
		СформироватьГрафикНачисленияАмортизацииНаСервере();
	Иначе
		ГрафикНеАктуален = Истина;
	КонецЕсли;
	
	УстановитьДоступностьКнопкиСформироватьГрафик(ЭтотОбъект);
	
КонецПроцедуры

