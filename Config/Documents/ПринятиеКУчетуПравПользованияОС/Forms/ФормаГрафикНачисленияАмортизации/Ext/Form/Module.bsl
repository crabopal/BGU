Процедура ДатаОкончанияАмортизацииПриИзменении(Элемент)
	
	Если ГрафикАмортизации.Количество() = 0 Тогда
		СформироватьГрафикНачисленияАмортизацииНаСервере();
	Иначе
		ГрафикНеАктуален = Истина;
	КонецЕсли;
	
	УстановитьДоступностьКнопкиСформироватьГрафик(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура АренднаяПлатаДеньНачисленияПриИзменении(Элемент)
	
	Если АренднаяПлатаДеньНачисления <= 0 Тогда
		АренднаяПлатаДеньНачисления = 1;
	ИначеЕсли АренднаяПлатаДеньНачисления > 31 Тогда
		АренднаяПлатаДеньНачисления = 31;
	КонецЕсли;
	
	Если ГрафикАмортизации.Количество() = 0 Тогда
		СформироватьГрафикНачисленияАмортизацииНаСервере();
	Иначе
		ГрафикНеАктуален = Истина;
	КонецЕсли;
	
	УстановитьДоступностьКнопкиСформироватьГрафик(ЭтотОбъект);
	
КонецПроцедуры

