	Если АренднаяПлатаДеньОплаты <= 0 Тогда
		АренднаяПлатаДеньОплаты = 1;
	ИначеЕсли АренднаяПлатаДеньОплаты > 31 Тогда
		АренднаяПлатаДеньОплаты = 31;
	КонецЕсли;
	
	Если ГрафикАмортизации.Количество() = 0 Тогда
		СформироватьГрафикНачисленияАмортизацииНаСервере();
	Иначе
		ГрафикНеАктуален = Истина;
	КонецЕсли;
	
	УстановитьДоступностьКнопкиСформироватьГрафик(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ГрафикАмортизации

&НаКлиенте
Процедура ГрафикАмортизацииПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ГрафикАмортизации.Сортировать("ДатаНачисленияАмортизации,ОплатитьДо");
	
	ИтогАмортизация = ГрафикАмортизации.Итог("Амортизация");
	ИтогАренднаяПлата = ГрафикАмортизации.Итог("АренднаяПлата");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьПериодАмортизации(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период.ДатаНачала = ДатаНачалаАмортизации;
	Диалог.Период.ДатаОкончания = ДатаОкончанияАмортизации;
	Диалог.Показать(Новый ОписаниеОповещения("УстановитьПериодАмортизацииЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодАмортизацииЗавершение(Период, ДополнительныеПараметры) Экспорт
	
	Если Период <> Неопределено Тогда
		
		ДатаНачалаАмортизации = Период.ДатаНачала;
		ДатаОкончанияАмортизации  = Период.ДатаОкончания;
		
		Модифицированность = Истина;
		
		Если ГрафикАмортизации.Количество() = 0 Тогда
			СформироватьГрафикНачисленияАмортизацииНаСервере();
		Иначе
			ГрафикНеАктуален = Истина;
		КонецЕсли;
		
		УстановитьДоступностьКнопкиСформироватьГрафик(ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьГрафик(Команда)
	
	СформироватьГрафикНачисленияАмортизацииНаСервере();
	
	УстановитьДоступностьКнопкиСформироватьГрафик(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ПеренестиВДокумент = Истина;
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыНачисленияАмортизации()
	
	Возврат "АмортизацияСумма,СуммаПоДоговору,КоличествоПериодов,Валюта,
		|АренднаяПлатаСумма,АренднаяПлатаЗаПериод,АренднаяПлатаДеньНачисления,АренднаяПлатаДеньОплаты,
		|СпособПризнанияРасходов,ДатаНачалаАмортизации,ДатаОкончанияАмортизации";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	ЭтоПоступлениеВБезвозмездноеПользование =
		(Форма.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СуммаПоДоговору", "Доступность", Не ЭтоПоступлениеВБезвозмездноеПользование);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "АренднаяПлатаДеньНачисления", "Доступность", Не ЭтоПоступлениеВБезвозмездноеПользование);
	
	Если Форма.СпособПризнанияРасходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоМесяцам")
	 ИЛИ Форма.СпособПризнанияРасходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоКалендарнымДням") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГрафикАмортизации",
			"ТолькоПросмотр", Истина); // Редактирование графика недоступно.
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГрафикАмортизации",
			"ТолькоПросмотр", Ложь); // Редактирование графика доступно.
	КонецЕсли;
	
	ЭлементыГрафикПлатежей = Новый Массив;
	ЭлементыГрафикПлатежей.Добавить("АренднаяПлатаДеньОплаты");
	ЭлементыГрафикПлатежей.Добавить("ГрафикАмортизацииОплатитьДо");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ЭлементыГрафикПлатежей, "Видимость",
		Форма.ВестиГрафикПлатежей И Не ЭтоПоступлениеВБезвозмездноеПользование);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКнопкиСформироватьГрафик(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГрафикАмортизацииСформироватьГрафик", "Доступность", Форма.ГрафикНеАктуален
			И ЗначениеЗаполнено(Форма.АмортизацияСумма)
			И ЗначениеЗаполнено(Форма.ДатаНачалаАмортизации)
			И ЗначениеЗаполнено(Форма.ДатаОкончанияАмортизации)
			И ЗначениеЗаполнено(Форма.СпособПризнанияРасходов));

КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеНаКлиенте()
	
	Отказ = Ложь;
	
	Если ГрафикАмортизации.Итог("Амортизация") <> АмортизацияСумма Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Итоговая сумма по колонке %1 (%2) графика не совпадает со значением, указанным в поле %1 (%3)'"),
				НСтр("ru = 'Амортизация (справедливая стоимость)'"),
				Формат(ГрафикАмортизации.Итог("Амортизация"), "ЧЦ=15; ЧДЦ=2"),
				Формат(АмортизацияСумма, "ЧЦ=15; ЧДЦ=2"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "АмортизацияСумма", "", Отказ);
	КонецЕсли;
	
	Если ГрафикАмортизации.Итог("АренднаяПлата") <> СуммаПоДоговору Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Итоговая сумма по колонке ""%1"" (%2) графика не совпадает со значением, указанным в поле ""%1"" (%3)'"),
				НСтр("ru = 'Арендная плата (сумма по договору)'"),
				Формат(ГрафикАмортизации.Итог("АренднаяПлата"), "ЧЦ=15; ЧДЦ=2"),
				Формат(СуммаПоДоговору, "ЧЦ=15; ЧДЦ=2"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "СуммаПоДоговору", "", Отказ);
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции

&НаСервере
Функция ПоместитьГрафикАмортизацииВХранилище()
	
	Возврат ПоместитьВоВременноеХранилище(ГрафикАмортизации.Выгрузить(), УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Функция РассчитатьИтоговыеСуммы()
	
	ЭтоПоступлениеВБезвозмездноеПользование =
		(ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование"));
	
	АмортизацияСумма = КоличествоПериодов * АренднаяПлатаСумма;
	
	Если ЭтоПоступлениеВБезвозмездноеПользование Тогда
		СуммаПоДоговору = 0;
	Иначе
		СуммаПоДоговору = АмортизацияСумма;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура СформироватьГрафикНачисленияАмортизацииНаСервере()
	
	ПараметрыАмортизации = Новый Структура("СпособПризнанияРасходов,ДатаНачалаАмортизации,ДатаОкончанияАмортизации,АмортизацияСумма,СуммаПоДоговору");
	ЗаполнитьЗначенияСвойств(ПараметрыАмортизации, ЭтотОбъект);
	ПараметрыАмортизации.Вставить("ДеньНачисленияАмортизации", АренднаяПлатаДеньНачисления);
	ПараметрыАмортизации.Вставить("ДеньОплаты", АренднаяПлатаДеньОплаты);
	
	СформироватьГрафикНачисленияАмортизации(ГрафикАмортизации, ПараметрыАмортизации);
	
	ИтогАмортизация = ГрафикАмортизации.Итог("Амортизация");
	ИтогАренднаяПлата = ГрафикАмортизации.Итог("АренднаяПлата");
	
	ГрафикНеАктуален = Ложь;
	
КонецПроцедуры

// Формирует график амортизации при первоначальном признании (принятии к учету) прав пользования.
//
&НаСервереБезКонтекста
Процедура СформироватьГрафикНачисленияАмортизации(ГрафикАмортизации, ПараметрыАмортизации)
	
	ГрафикАмортизации.Очистить();
	
	Если ПараметрыАмортизации.СпособПризнанияРасходов <> Перечисления.СпособыПризнанияРасходов.ПоМесяцам
		И ПараметрыАмортизации.СпособПризнанияРасходов <> Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням Тогда
		ПризнаниеРасходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам; // По умолчанию распределяем равномерно по месяцам.
	Иначе
		ПризнаниеРасходов = ПараметрыАмортизации.СпособПризнанияРасходов;
	КонецЕсли;
	
	ОчереднойМесяц = НачалоМесяца(ПараметрыАмортизации.ДатаНачалаАмортизации);
	ОсталосьПогаситьАмортизация = ПараметрыАмортизации.АмортизацияСумма;
	ОсталосьПогаситьАренднаяПлата = ПараметрыАмортизации.СуммаПоДоговору;
	
	// Цикл по месяцам с даты начала начисления амортизации по дату окончания.
	Пока КонецДня(ОчереднойМесяц) <= КонецДня(ПараметрыАмортизации.ДатаОкончанияАмортизации) Цикл
		
		ПротоколРасчета = Неопределено;
		ДоляОчередногоМесяца = БухгалтерскийУчет.ДоляОчередногоМесяцаПриРавномерномПризнанииДоходовРасходов(
			ПризнаниеРасходов,
			ОчереднойМесяц,
			ПараметрыАмортизации.ДатаНачалаАмортизации,
			ПараметрыАмортизации.ДатаОкончанияАмортизации,
			ПротоколРасчета);
		
		НоваяСтрока = ГрафикАмортизации.Добавить();
		
		МаксДатаНачисленияАмортизации = КонецДня(ОчереднойМесяц + ПараметрыАмортизации.ДеньНачисленияАмортизации * 24*60*60 - 1);
		ОкончаниеНачисленияАмортизации = Мин( КонецМесяца(ОчереднойМесяц), КонецДня(ПараметрыАмортизации.ДатаОкончанияАмортизации) );
		НоваяСтрока.ДатаНачисленияАмортизации = Мин(МаксДатаНачисленияАмортизации, ОкончаниеНачисленияАмортизации);
		
		МаксДатаОплаты = КонецДня(ОчереднойМесяц + ПараметрыАмортизации.ДеньОплаты * 24*60*60 - 1);
		ОплатитьДо = Мин( КонецМесяца(ОчереднойМесяц), КонецДня(ПараметрыАмортизации.ДатаОкончанияАмортизации) );
		НоваяСтрока.ОплатитьДо = Мин(МаксДатаОплаты, ОкончаниеНачисленияАмортизации);
		
		НоваяСтрока.Амортизация = ОсталосьПогаситьАмортизация * ДоляОчередногоМесяца;
		НоваяСтрока.АренднаяПлата = ОсталосьПогаситьАренднаяПлата * ДоляОчередногоМесяца;
		
		// Следующее значение переменной цикла.
		ОчереднойМесяц = ДобавитьМесяц(ОчереднойМесяц, 1);
		ОсталосьПогаситьАмортизация = ОсталосьПогаситьАмортизация - НоваяСтрока.Амортизация;
		ОсталосьПогаситьАренднаяПлата = ОсталосьПогаситьАренднаяПлата - НоваяСтрока.АренднаяПлата;
	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

