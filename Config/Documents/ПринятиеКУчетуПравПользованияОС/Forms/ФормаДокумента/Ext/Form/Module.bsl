&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ПараметрыАмортизацииУстановленыПоДоговоруВЦелом = НЕ Объект.РазныеПараметрыНачисленияАмортизацииПоОбъектам;
	
	ЗапомнитьПараметрыДоговораВКэшеФормы();
	
	ПараметрыВыбораСпособаПризнанияРасходов =
		Перечисления.СпособыПризнанияРасходов.ПараметрыВыбораСпособаПризнанияРасходов(Объект.ВидОперации);
	Элементы.СпособПризнанияРасходов.ПараметрыВыбора = ПараметрыВыбораСпособаПризнанияРасходов;
	Элементы.ОсновныеСредстваСпособПризнанияРасходов.ПараметрыВыбора = ПараметрыВыбораСпособаПризнанияРасходов;
	Элементы.ПараметрыАмортизацииСпособПризнанияРасходов.ПараметрыВыбора = ПараметрыВыбораСпособаПризнанияРасходов;
	
	СписокУсловийПользования = СписокВыбораУсловийПользования(Объект.ВидОперации);
	Элементы.УсловиеПользования.СписокВыбора.Очистить();
	Для Каждого УсловиеПользования Из СписокУсловийПользования Цикл
		Элементы.УсловиеПользования.СписокВыбора.Добавить(УсловиеПользования.Значение);
	КонецЦикла;

	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	
	УстановитьВидимостьПараметровНачисленияАмортизации(ЭтотОбъект);
	
	БухгалтерскийУчетКлиентСервер.УстановитьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект, "Видимость");
	
	УстановитьДоступностьРеквизитовОрганизации(ЭтотОбъект);
	УстановитьДоступностьДоговора(ЭтотОбъект);
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
	ОсновныеСредстваЗаполнитьДобавленныеКолонки(ЭтотОбъект);
	ПараметрыАмортизацииЗаполнитьДобавленныеКолонки(ЭтотОбъект);
	
	УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект, Объект, "СчетДоходов");
	УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект, Объект, "СчетРасходов");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	// Удалить управление видимостью одновременно с соответствующими группами элементов на форме.
	ОсобыйПорядокПризнанияРасходовТекущегоПериода =
		(Объект.УдалитьСпособПризнанияРасходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ВОсобомПорядке"));
	ПризнаниеРасходовТекущегоПериодаПоГрафику =
		(Объект.УдалитьСпособПризнанияРасходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоГрафику"));
	
	ВедутсяГрафикиИсполненияПоДоговору = Форма.КэшПараметров.Локальные.Свойство("ВедутсяГрафикиИсполненияПоДоговору")
		И Форма.КэшПараметров.Локальные.ВедутсяГрафикиИсполненияПоДоговору;
	ВедетсяГрафикПоДоговору = Форма.КэшПараметров.Локальные.Свойство("ВедетсяГрафикПоДоговору")
		И Форма.КэшПараметров.Локальные.ВедетсяГрафикПоДоговору;
	ЕстьГрафикПоДоговору = Форма.КэшПараметров.Локальные.Свойство("ЕстьГрафикПоДоговору")
		И Форма.КэшПараметров.Локальные.ЕстьГрафикПоДоговору;
	
	СрокСписания = Новый Массив;
	СрокСписания.Добавить("ДатаНачалаАмортизации");
	СрокСписания.Добавить("ДатаОкончанияАмортизации");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		СрокСписания, "Видимость", НЕ ПризнаниеРасходовТекущегоПериодаПоГрафику);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаГрафикАмортизации",
		"Видимость", ПризнаниеРасходовТекущегоПериодаПоГрафику И ВедетсяГрафикПоДоговору);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГрафикАмортизацииПредупреждение",
		"Видимость", ПризнаниеРасходовТекущегоПериодаПоГрафику И НЕ ВедетсяГрафикПоДоговору);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВвестиГрафикАмортизации", "Видимость",
		ПризнаниеРасходовТекущегоПериодаПоГрафику И ВедетсяГрафикПоДоговору И НЕ ЕстьГрафикПоДоговору);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОткрытьГрафикАмортизации", "Видимость",
		ПризнаниеРасходовТекущегоПериодаПоГрафику И ВедетсяГрафикПоДоговору И ЕстьГрафикПоДоговору);
	
	Если ОсобыйПорядокПризнанияРасходовТекущегоПериода Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаАмортизации", "АвтоОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаАмортизации", "ОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияАмортизации", "АвтоОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияАмортизации", "ОтметкаНезаполненного", Ложь);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаАмортизации", "АвтоОтметкаНезаполненного", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаАмортизации", "ОтметкаНезаполненного", Не ЗначениеЗаполнено(Объект.УдалитьДатаНачалаАмортизации));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияАмортизации", "АвтоОтметкаНезаполненного", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияАмортизации", "ОтметкаНезаполненного", Не ЗначениеЗаполнено(Объект.УдалитьДатаОкончанияАмортизации));
	КонецЕсли;
	
	Если ПризнаниеРасходовТекущегоПериодаПоГрафику Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыАмортизации", "Подсказка",
			НСтр("ru = 'Амортизация прав пользования начисляется согласно графику, установленному договором.'"));
	ИначеЕсли ОсобыйПорядокПризнанияРасходовТекущегоПериода Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыАмортизации", "Подсказка",
			НСтр("ru = 'Суммы амортизации прав пользования указывается вручную в регламентном документе ""Начисление амортизации прав пользования ОС, НПА"".'"));
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыАмортизации", "Подсказка",
			НСтр("ru = 'В течение указанного срока ежемесячно начисляется амортизация прав пользования в сумме арендных платежей, причитающихся к уплате.'"));
	КонецЕсли;
	
	ЭтоПоступлениеВАренду =
		(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду"));
	ЭтоПоступлениеВАрендуНаЛьготныхУсловиях =
		(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях"));
	ЭтоПоступлениеВБезвозмездноеПользование =
		(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование"));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтраницаОтложенныеДоходы", "Видимость", ЭтоПоступлениеВАрендуНаЛьготныхУсловиях ИЛИ ЭтоПоступлениеВБезвозмездноеПользование);
	
	УсловиеПользованияЗаполнено = ЗначениеЗаполнено(Объект.УсловиеПользования); // Документ отражается по специальным регистрам 
	// Карточки прав пользования (СведенияОбОбъектахПравПользованияОС, ГрафикАмортизацииПравПользованияОС).
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОсновныеСредстваГрафикАмортизации",
		"Видимость", УсловиеПользованияЗаполнено);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "АвтоматическиОтразитьВГрафикахИсполненияДоговоров",
		"Видимость", УсловиеПользованияЗаполнено И ВедутсяГрафикиИсполненияПоДоговору);
	
	СрокСписания = Новый Массив;
	СрокСписания.Добавить("ОсновныеСредстваСпособПризнанияРасходов");
	СрокСписания.Добавить("ОсновныеСредстваДатаНачалаАмортизации");
	СрокСписания.Добавить("ОсновныеСредстваДатаОкончанияАмортизации");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		СрокСписания, "Видимость", НЕ УсловиеПользованияЗаполнено);
	
	ЭлементыРасчетов = Новый Массив;
	ЭлементыРасчетов.Добавить("ОсновныеСредстваСчетРасчетов");
	ЭлементыРасчетов.Добавить("ОсновныеСредстваКПСРасчетов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыРасчетов, "Видимость", НЕ ЭтоПоступлениеВБезвозмездноеПользование);
	
	ЭлементыРезервов = Новый Массив;
	ЭлементыРезервов.Добавить("ОсновныеСредстваСчетРезервов");
	ЭлементыРезервов.Добавить("ОсновныеСредстваКПСРезервов");
	ЭлементыРезервов.Добавить("ОсновныеСредстваРезерв");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыРезервов, "Видимость", НЕ ЭтоПоступлениеВБезвозмездноеПользование);
	
	ЕстьПервичныйДокумент = ЗначениеЗаполнено(Объект.ПервичныйДокумент); // Первичный документ ф.0510478 с 01.01.2026.
	
	ЭлементыЕстьПервичныйДокумент = Новый Массив;
	ЭлементыЕстьПервичныйДокумент.Добавить("СведенияОбИмуществе");
	ЭлементыЕстьПервичныйДокумент.Добавить("Руководитель");
	ЭлементыЕстьПервичныйДокумент.Добавить("ОтветственныйИсполнитель");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыЕстьПервичныйДокумент, "Видимость", ЕстьПервичныйДокумент);
	
	ЭлементыНетПервичногоДокумента = Новый Массив;
	ЭлементыНетПервичногоДокумента.Добавить("СтраницаКомиссия"); // Комиссия не используется при принятии к учету прав пользования.
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыНетПервичногоДокумента, "Видимость", Не ЕстьПервичныйДокумент);
	
	ЗаголовокПервичныйДокумент = ?(ЕстьПервичныйДокумент,
		НСтр("ru = 'Документ поставщика (акт о приеме-передаче):'"),
		НСтр("ru = 'Первичный документ:'"));
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаПервичныйДокумент", "Заголовок", ЗаголовокПервичныйДокумент);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(Объект.КФО)
		И Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаНалоговыйУчет", "Видимость", ОтражатьВНалоговомУчете);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаБухгалтерскийУчет", "ОтображатьЗаголовок", ОтражатьВНалоговомУчете);
	
	ЭтоПрочиеДоходы = БухгалтерскийУчетКлиентСервер.СчетВИерархии(Объект.СчетДоходовНУ, "Н91.01");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтатьяПрочихДоходовНУ", "Видимость", ЗначениеЗаполнено(Объект.СчетДоходовНУ) И ЭтоПрочиеДоходы);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтатьяПрочихРасходовНУ", "Видимость",
			НалоговыйУчетКлиентСервер.ЭтоПрочиеРасходы(Объект.СчетРасходов)
			И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(Объект.КФО) );
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПараметрыАмортизацииСтатьяПрочихРасходовНУ", "Видимость", ОтражатьВНалоговомУчете);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПараметровНачисленияАмортизации(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПараметрыАмортизацииПоКаждомуОбъекту", "Видимость", НЕ Форма.ПараметрыАмортизацииУстановленыПоДоговоруВЦелом);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПараметрыАмортизацииПоДоговоруВЦелом", "Видимость", Форма.ПараметрыАмортизацииУстановленыПоДоговоруВЦелом);
	
	// Удалить. Порядок и сроки списания ДБП показываем информационно,
	// только если параметры амортизации установлены для договора в целом.
	ПорядокСписанияДБП = Новый Массив;
	ПорядокСписанияДБП.Добавить("СпособПризнанияДоходов");
	ПорядокСписанияДБП.Добавить("ДатаНачалаСписания");
	ПорядокСписанияДБП.Добавить("ДатаОкончанияСписания");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ПорядокСписанияДБП, "Видимость", Форма.ПараметрыАмортизацииУстановленыПоДоговоруВЦелом
			И Объект.УдалитьСпособПризнанияРасходов <> ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоГрафику"));
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Доступность и оформление сумм в зависимости от вида операции.
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваЦенаСправедливая");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваСуммаСправедливая");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваСуммаНДССправедливая");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваВсегоСправедливая");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ВидОперации", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваЦена");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваСумма");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваСуммаНДС");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваВсего");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ВидОперации", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "-");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	// Видимость "Статьи прочих расходов (НУ)" в таблице параметров амортизации.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииСтатьяПрочихРасходовНУ");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.СчетРасходов", ВидСравненияКомпоновкиДанных.НеРавно,
			БухгалтерскийУчет.СчетПоКоду("401.20", Объект.Дата));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Удалить. Способ начисления амортизации "По графику".
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииДатаНачалаАмортизации");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииДатаОкончанияАмортизации");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.СпособПризнанияРасходов", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.СпособыПризнанияРасходов.ПоГрафику);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Способ начисления амортизации "По графику" до начала применения Карточки прав пользования.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваДатаНачалаАмортизации");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваДатаОкончанияАмортизации");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.УсловиеПользования", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.СпособПризнанияРасходов", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.СпособыПризнанияРасходов.ПоГрафику);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// График начисления амортизации.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваГрафикАмортизации");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ГрафикАмортизацииЗаполнен", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НезаполненныйРеквизит);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваГрафикАмортизации");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ГрафикАмортизацииЗаполнен", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ГиперссылкаЦвет);
	
	// Основные характеристики объекта.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СведенияОбИмуществеОсновныеХарактеристики");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ОсновныеХарактеристикиЗаполнены", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НезаполненныйРеквизит);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СведенияОбИмуществеОсновныеХарактеристики");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ОсновныеХарактеристикиЗаполнены", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ГиперссылкаЦвет);
	
КонецПроцедуры

&НаСервере
Процедура ЗапомнитьПараметрыДоговораВКэшеФормы()
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВедутсяГрафикиИсполненияПоДоговору", Ложь);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВедетсяГрафикПоДоговору", Ложь);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ЕстьГрафикПоДоговору", Ложь);
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
		ЭтотОбъект.КэшПараметров.Локальные.ВедутсяГрафикиИсполненияПоДоговору = 
			?(РеквизитыДоговора = Неопределено, Ложь, РеквизитыДоговора.ВестиГрафикПлатежей ИЛИ РеквизитыДоговора.ВестиПланГрафикИсполнения);
		ЭтотОбъект.КэшПараметров.Локальные.ВедетсяГрафикПоДоговору = 
			?(РеквизитыДоговора = Неопределено, Ложь, РеквизитыДоговора.ВестиПланГрафикИсполнения);
		ЭтотОбъект.КэшПараметров.Локальные.ЕстьГрафикПоДоговору = 
			КонтрольИсполненияДоговоров.ЕстьГрафикПоДоговору(Объект.Договор, "ПланГрафикИсполнения");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ВидНФА"		, ПредопределенноеЗначение("Перечисление.ВидыНФА.ПраваПользованияИмуществом"));
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения"	, "ПринятиеКУчету");
	ПараметрыПодбора.Вставить("СкрытьКолонки"	, "ГрупповойУчет,ИнвентарныйНомер,Количество");
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОССервер(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()
	
	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОССервер(Знач ВыбранноеЗначение)
	
	ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
	ИсходныеДанные = Объект.ОсновныеСредства.Выгрузить();
	ИсходныеДанные.Индексы.Добавить("ОсновноеСредство");
	
	Объект.ОсновныеСредства.Очистить();
	СчетаДляАвтоЗаполненияКПС = Новый Массив;
	СтрокиДляАвтоЗаполненияКПС = Новый Массив;

	Для каждого СтрокаТаблицыОС Из ТаблицаОС Цикл
		
		НоваяСтрока = Объект.ОсновныеСредства.Добавить();
		СтрокаИсходныхДанных = ИсходныеДанные.Найти(СтрокаТаблицыОС.ОсновноеСредство, "ОсновноеСредство");
		Если СтрокаИсходныхДанных <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсходныхДанных);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыОС);
		
		ДанныеОбъекта = ДанныеОбъектаОС(НоваяСтрока.ОсновноеСредство, Объект.Дата);
		Если ЗначениеЗаполнено(ДанныеОбъекта.СтавкаНДС) Тогда
			НоваяСтрока.СтавкаНДС = ДанныеОбъекта.СтавкаНДС;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеОбъекта.ТипНФА) Тогда
			НоваяСтрока.СчетУчета    = ДанныеОбъекта.СчетУчета;
			НоваяСтрока.СчетРасчетов = ДанныеОбъекта.СчетРасчетов;
			НоваяСтрока.СчетРезервов = ДанныеОбъекта.СчетРезервов;
			
			Если Не ЗначениеЗаполнено(НоваяСтрока.КПС) И ЗначениеЗаполнено(НоваяСтрока.СчетУчета) Тогда
				СчетаДляАвтоЗаполненияКПС.Добавить(НоваяСтрока.СчетУчета);
				Если Не ЗначениеЗаполнено(НоваяСтрока.КПСРасчетов) И ЗначениеЗаполнено(НоваяСтрока.СчетРасчетов) Тогда
					СчетаДляАвтоЗаполненияКПС.Добавить(НоваяСтрока.СчетРасчетов);
				КонецЕсли;
				СтрокиДляАвтоЗаполненияКПС.Добавить(НоваяСтрока);
			КонецЕсли;
			
		КонецЕсли;
		
		РасчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "Сумма");
		ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(НоваяСтрока);
		
	КонецЦикла;
	
	Если ЭтотОбъект.КэшПараметров.КонтролироватьОперацииНаСоответствиеРПС И СтрокиДляАвтоЗаполненияКПС.Количество() Тогда
		
		ЗначенияЗаполнения = УправлениеНФА.ЗначенияКПСКФОПоУмолчаниюДляСчетов(
		Объект.Организация,
		Объект.ИФО,
		СчетаДляАвтоЗаполненияКПС,
		Объект.Дата,
		Объект.КФО);
		
		Для Каждого СтрокаЗаполненияКПС Из СтрокиДляАвтоЗаполненияКПС Цикл
			ЗаполнитьКПСВСтроке(СтрокаЗаполненияКПС, ЗначенияЗаполнения)
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьКПСВСтроке(СтрокаЗаполнения, Знач ЗначенияЗаполнения)

	ЗависимыеРеквизитыСтроки = Новый Соответствие;
	ЗависимыеРеквизитыСтроки.Вставить("КПС", "СчетУчета");
	ЗависимыеРеквизитыСтроки.Вставить("КПСРасчетов", "СчетРасчетов");
	
	Для Каждого РекизитКПС Из ЗависимыеРеквизитыСтроки Цикл
		
		ЗначенияЗаполненияПоСчету = ЗначенияЗаполнения.Получить(СтрокаЗаполнения[ЗависимыеРеквизитыСтроки.Получить(РекизитКПС.Ключ)]);
		Если ЗначенияЗаполненияПоСчету <> Неопределено Тогда
			СтрокаЗаполнения[РекизитКПС.Ключ] = ЗначенияЗаполненияПоСчету.КПС;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначенияКПСКФОПоУмолчаниюДляСчетов(Знач Организация, Знач ИФО, Знач Счета, Знач ДатаЗначений, Знач КФО)

	Возврат УправлениеНФА.ЗначенияКПСКФОПоУмолчаниюДляСчетов(Организация, ИФО, Счета, ДатаЗначений, КФО);
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииЗависимыхРеквизитовЗаполненияКПС(ТекущиеДанные)
	
	СчетаДляКПС = Новый Массив;
	СчетаДляКПС.Добавить(ТекущиеДанные.СчетУчета);
	Если ЗначениеЗаполнено(ТекущиеДанные.СчетРасчетов) Тогда
		СчетаДляКПС.Добавить(ТекущиеДанные.СчетРасчетов);
	КонецЕсли;
	
	ЗначенияЗаполнения = ЗначенияКПСКФОПоУмолчаниюДляСчетов(
	Объект.Организация,
	Объект.ИФО,
	СчетаДляКПС,
	Объект.Дата,
	Объект.КФО);
	
	ЗаполнитьКПСВСтроке(ТекущиеДанные, ЗначенияЗаполнения);
	
КонецПроцедуры

