&НаКлиенте
Процедура ОткрытьФормуГрафикаНачисленияАмортизации(ВыбранноеЗначение)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Объект.ОсновныеСредства.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Дата, Организация, Договор, ВидОперации");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ПараметрыФормы.Вставить("Валюта", ?(ЗначениеЗаполнено(Объект.ВалютаДокумента), Объект.ВалютаДокумента, ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета));
	
	ПараметрыФормы.Вставить("АмортизацияСумма",   ДанныеСтроки.ВсегоСправедливая);
	ПараметрыФормы.Вставить("СуммаПоДоговору",    ДанныеСтроки.Всего);
	ПараметрыФормы.Вставить("КоличествоПериодов", ДанныеСтроки.Количество);
	
	ПараметрыФормы.Вставить("АренднаяПлатаСумма",          ?(ЗначениеЗаполнено(ДанныеСтроки.АренднаяПлатаСумма), ДанныеСтроки.АренднаяПлатаСумма, ДанныеСтроки.ЦенаСправедливая));
	ПараметрыФормы.Вставить("АренднаяПлатаЗаПериод",       ДанныеСтроки.АренднаяПлатаЗаПериод);
	ПараметрыФормы.Вставить("АренднаяПлатаДеньНачисления", ДанныеСтроки.АренднаяПлатаДеньНачисления);
	ПараметрыФормы.Вставить("АренднаяПлатаДеньОплаты",     ДанныеСтроки.АренднаяПлатаДеньОплаты);
	
	ПараметрыФормы.Вставить("СпособПризнанияРасходов",  ДанныеСтроки.СпособПризнанияРасходов);
	ПараметрыФормы.Вставить("ДатаНачалаАмортизации",    ДанныеСтроки.ДатаНачалаАмортизации);
	ПараметрыФормы.Вставить("ДатаОкончанияАмортизации", ДанныеСтроки.ДатаОкончанияАмортизации);
	
	ПараметрыФормы.Вставить("ГрафикАмортизации", ПоместитьГрафикАмортизацииВХранилище(ДанныеСтроки.ОсновноеСредство));
	
	ОткрытьФорму("Документ.ПринятиеКУчетуПравПользованияОС.Форма.ФормаГрафикНачисленияАмортизации", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОсновныеХарактеристики(ВыбранноеЗначение)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Объект.ОсновныеСредства.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Дата, Организация, Договор, ВидОперации");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ПараметрыФормы.Вставить("ОсновноеСредство", ДанныеСтроки.ОсновноеСредство);
	ПараметрыФормы.Вставить("ОсновныеХарактеристики", ПоместитьОсновныеХарактеристикиВХранилище(ДанныеСтроки.ОсновноеСредство));
	
	ОткрытьФорму("Документ.ПринятиеКУчетуПравПользованияОС.Форма.ФормаОсновныеХарактеристики", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьГрафикАмортизацииВХранилище(ОсновноеСредство = Неопределено)
	
	Отбор = Новый Структура;
	Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
		Отбор.Вставить("ОсновноеСредство", ОсновноеСредство);
	КонецЕсли;
	ГрафикАмортизации = Объект.ГрафикАмортизации.Выгрузить(Отбор);
	
	Возврат ПоместитьВоВременноеХранилище(ГрафикАмортизации);
	
КонецФункции

&НаСервере
Функция ПоместитьОсновныеХарактеристикиВХранилище(ОсновноеСредство = Неопределено)
	
	Отбор = Новый Структура;
	Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
		Отбор.Вставить("ОсновноеСредство", ОсновноеСредство);
	КонецЕсли;
	СведенияОбИмуществе = Объект.СведенияОбИмуществе.Выгрузить(Отбор);
	
	Возврат ПоместитьВоВременноеХранилище(СведенияОбИмуществе);
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораГрафикаНачисленияАмортизацииНаСервере(ТекущаяСтрока, ПараметрыГрафикаАмортизации)
	
	ДанныеСтроки = Объект.ОсновныеСредства.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, ПараметрыГрафикаАмортизации,
		"СпособПризнанияРасходов,ДатаНачалаАмортизации,ДатаОкончанияАмортизации,
		|АренднаяПлатаСумма,АренднаяПлатаЗаПериод,АренднаяПлатаДеньНачисления,АренднаяПлатаДеньОплаты");
	
	// Удаляем строки особого графика из табличной части.
	ОтборПоОбъектуОС = Новый Структура("ОсновноеСредство", ДанныеСтроки.ОсновноеСредство);
	НайденныеСтроки = Объект.ГрафикАмортизации.НайтиСтроки(ОтборПоОбъектуОС);
	Для Каждого СтрокаГрафика Из НайденныеСтроки Цикл
		Объект.ГрафикАмортизации.Удалить(Объект.ГрафикАмортизации.Индекс(СтрокаГрафика));
	КонецЦикла;
	
	// Добавляем новые строки графика амортизации.
	ГрафикАмортизацииПоОбъекту = ПолучитьИзВременногоХранилища(ПараметрыГрафикаАмортизации.ГрафикАмортизации);
	Если ГрафикАмортизацииПоОбъекту.Количество() > 0 Тогда
		Для Каждого СтрокаГрафика Из ГрафикАмортизацииПоОбъекту Цикл
			НоваяСтрока = Объект.ГрафикАмортизации.Добавить();
			НоваяСтрока.ОсновноеСредство = ДанныеСтроки.ОсновноеСредство;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика,
				"ДатаНачисленияАмортизации,Амортизация,АренднаяПлата,ОплатитьДо");
		КонецЦикла;
	КонецЕсли;
	
	ДанныеСтроки.Количество = ПараметрыГрафикаАмортизации.КоличествоПериодов;
	ДанныеСтроки.ВсегоСправедливая = ПараметрыГрафикаАмортизации.АмортизацияСумма;
	ДанныеСтроки.Всего = ПараметрыГрафикаАмортизации.СуммаПоДоговору;
	
	РасчитатьСтроку(ДанныеСтроки, Объект.СуммаВключаетНДС, "Всего");
	РасчитатьСтроку(ДанныеСтроки, Объект.СуммаВключаетНДС, "ВсегоСправедливая");
	
	ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ДанныеСтроки);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораОсновныхХарактеристикНаСервере(ТекущаяСтрока, ПараметрыОсновныеХарактеристики)
	
	ДанныеСтроки = Объект.ОсновныеСредства.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Удаляем существующие строки по объекту из табличной части.
	ОтборПоОбъектуОС = Новый Структура("ОсновноеСредство", ДанныеСтроки.ОсновноеСредство);
	НайденныеСтроки = Объект.СведенияОбИмуществе.НайтиСтроки(ОтборПоОбъектуОС);
	Для Каждого СтрокаСведенияОбИмуществе Из НайденныеСтроки Цикл
		Объект.СведенияОбИмуществе.Удалить(Объект.СведенияОбИмуществе.Индекс(СтрокаСведенияОбИмуществе));
	КонецЦикла;
	
	ДанныеСтроки.ОсновныеХарактеристикиОбъекта = "";
	
	// Добавляем новые строки по объекту.
	ОсновныеХарактеристикиПоОбъекту = ПолучитьИзВременногоХранилища(ПараметрыОсновныеХарактеристики.ОсновныеХарактеристики);
	Если ОсновныеХарактеристикиПоОбъекту.Количество() > 0 Тогда
		
		Для Каждого СтрокаОсновныеХарактеристики Из ОсновныеХарактеристикиПоОбъекту Цикл
			
			НоваяСтрока = Объект.СведенияОбИмуществе.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки, "ОсновноеСредство");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОсновныеХарактеристики,
				"НаименованиеОбъекта,Количество,НаименованиеХарактеристик,ЗначениеХарактеристик");
			
			Если Не ЗначениеЗаполнено(ДанныеСтроки.ОсновныеХарактеристикиОбъекта)
				И ЗначениеЗаполнено(СтрокаОсновныеХарактеристики.НаименованиеОбъекта) Тогда
				// Формируем описание объекта в строке основной таблицы ОсновныеСредства из первой заполненной строки СведенияОбИмуществе.
				Если ЗначениеЗаполнено(СтрокаОсновныеХарактеристики.Количество) Тогда
					ДанныеСтроки.ОсновныеХарактеристикиОбъекта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 (%2)'"),
						СтрокаОсновныеХарактеристики.НаименованиеОбъекта,
						СтрокаОсновныеХарактеристики.Количество);
				Иначе
					ДанныеСтроки.ОсновныеХарактеристикиОбъекта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"),
						СтрокаОсновныеХарактеристики.НаименованиеОбъекта);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ОсновныеХарактеристикиПоОбъекту.Количество() > 1 Тогда
			ДанныеСтроки.ОсновныеХарактеристикиОбъекта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 и еще %2 ...'"),
				ДанныеСтроки.ОсновныеХарактеристикиОбъекта,
				ОсновныеХарактеристикиПоОбъекту.Количество() - 1);
		КонецЕсли;
		
	КонецЕсли;
	
	ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ДанныеСтроки);
	
	Модифицированность = Истина;
	
КонецПроцедуры

