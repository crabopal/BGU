&НаКлиентеНаСервереБезКонтекста
Процедура ОсновныеСредстваЗаполнитьДобавленныеКолонки(Форма)
	
	Объект = Форма.Объект;
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокСумма             = НСтр("ru = 'Сумма по договору:'");
	СтрокаТаблицы.ЗаголовокСуммаСправедливая = НСтр("ru = 'Справедливая стоимость:'");
	
	Если БухгалтерскийУчетКлиентСервер.МодульЧисла(СтрокаТаблицы.ВсегоСправедливая) >
			БухгалтерскийУчетКлиентСервер.МодульЧисла(СтрокаТаблицы.Всего) Тогда
		СтрокаТаблицы.ОтложенныеДоходы = Формат(СтрокаТаблицы.ВсегоСправедливая - СтрокаТаблицы.Всего, "ЧЦ=12; ЧДЦ=2");
	Иначе
		СтрокаТаблицы.ОтложенныеДоходы = НСтр("ru = 'Отсутствуют'");
	КонецЕсли;
	
	СтрокаТаблицы.ГрафикАмортизации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1, с %2 по %3'"),
		СтрокаТаблицы.СпособПризнанияРасходов,
		Формат(СтрокаТаблицы.ДатаНачалаАмортизации, "ДЛФ=Д"),
		Формат(СтрокаТаблицы.ДатаОкончанияАмортизации, "ДЛФ=Д"));
	СтрокаТаблицы.ГрафикАмортизацииЗаполнен = ЗначениеЗаполнено(СтрокаТаблицы.АренднаяПлатаСумма);
	
	СтрокаТаблицы.ОсновныеХарактеристикиЗаполнены = ЗначениеЗаполнено(СтрокаТаблицы.ОсновныеХарактеристикиОбъекта);
	Если СтрокаТаблицы.ОсновныеХарактеристикиЗаполнены Тогда
		СтрокаТаблицы.ОсновныеХарактеристики = СтрокаТаблицы.ОсновныеХарактеристикиОбъекта;
	Иначе
		СтрокаТаблицы.ОсновныеХарактеристики = "<не указаны>";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

