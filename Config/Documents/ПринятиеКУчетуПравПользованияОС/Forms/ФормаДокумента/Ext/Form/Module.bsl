Процедура ОсновныеСредстваПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ЭтоНоваяСтрока = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ДанныеОбъекта = ДанныеОбъектаОС(ТекущиеДанные.ОсновноеСредство, Объект.Дата);
	Если ЗначениеЗаполнено(ДанныеОбъекта.СтавкаНДС) Тогда
		ТекущиеДанные.СтавкаНДС = ДанныеОбъекта.СтавкаНДС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеОбъекта.ТипНФА) Тогда
		ТекущиеДанные.СчетУчета    = ДанныеОбъекта.СчетУчета;
		ТекущиеДанные.СчетРасчетов = ДанныеОбъекта.СчетРасчетов;
		ТекущиеДанные.СчетРезервов = ДанныеОбъекта.СчетРезервов;
		
		Если ЭтотОбъект.КэшПараметров.КонтролироватьОперацииНаСоответствиеРПС
			И ЗначениеЗаполнено(ТекущиеДанные.СчетУчета) Тогда
			ПриИзмененииЗависимыхРеквизитовЗаполненияКПС(ТекущиеДанные);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСчетУчетаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ТекущиеДанные.СчетРасчетов = СчетРасчетовПоСчетуУчета(ТекущиеДанные.СчетУчета, Объект.Дата, Объект.Организация);
	
	Если ЭтотОбъект.КэшПараметров.КонтролироватьОперацииНаСоответствиеРПС
			И ЗначениеЗаполнено(ТекущиеДанные.СчетУчета) Тогда
		ПриИзмененииЗависимыхРеквизитовЗаполненияКПС(ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСчетРасчетовПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если ЭтотОбъект.КэшПараметров.КонтролироватьОперацииНаСоответствиеРПС Тогда
		ЗначенияАвтозаполнения = УправлениеНФАВызовСервера.ЗначенияКПСКФОПоУмолчаниюДляСчета(
		Объект.Организация,
		Объект.ИФО,
		ТекущиеДанные.СчетРасчетов,
		Объект.Дата,
		Объект.КФО);
		
		Если ЗначенияАвтозаполнения <> Неопределено Тогда
			ТекущиеДанные.КПСРасчетов = ЗначенияАвтозаполнения.КПС;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

