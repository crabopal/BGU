КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеОбъектаОС(ОсновноеСредство, Период)
	
	СтруктураДанных = Новый Структура("ВидНФА,ТипНФА,СтавкаНДС");
	ДанныеОбъектаОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновноеСредство, СтруктураДанных);
	
	Если ЗначениеЗаполнено(ДанныеОбъектаОС.ТипНФА) Тогда
		СчетаУчета = УправлениеОсновнымиСредствами.СчетаУчетаПравПользованияОСПоТипуНФА(ДанныеОбъектаОС.ТипНФА, Период);
		ДанныеОбъектаОС.Вставить("СчетУчета",    СчетаУчета.СчетУчета);
		ДанныеОбъектаОС.Вставить("СчетРасчетов", СчетаУчета.СчетРасчетов);
		ДанныеОбъектаОС.Вставить("СчетРезервов", СчетаУчета.СчетРезервов);
	Иначе
		ДанныеОбъектаОС.Вставить("СчетУчета",    ПланыСчетов.ЕПСБУ.ПустаяСсылка());
		ДанныеОбъектаОС.Вставить("СчетРасчетов", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
		ДанныеОбъектаОС.Вставить("СчетРезервов", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	КонецЕсли;
	
	Возврат ДанныеОбъектаОС;
	
КонецФункции

&НаСервере
Процедура ПересчитатьТабличнуюЧасть()
	
	Для Каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		
		РасчитатьСтроку(СтрокаТЧ, Объект.СуммаВключаетНДС, "Сумма");
		РасчитатьСтроку(СтрокаТЧ, Объект.СуммаВключаетНДС, "СуммаСправедливая");
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РасчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("РассчитыватьЦену", Истина);
	
	ЭтоРеквизитГруппыСправедливаяСтоимость = (СтрНайти(ВРЕГ(ИмяРеквизита), "СПРАВЕДЛИВАЯ") <> 0);
	
	Если НЕ ЭтоРеквизитГруппыСправедливаяСтоимость Тогда
		
		// Расчет реквизитов "Цена", "Сумма", "СуммаНДС", "Всего".
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
		
	КонецЕсли;
	
	Если ЭтоРеквизитГруппыСправедливаяСтоимость ИЛИ ИмяРеквизита = "Количество" ИЛИ ИмяРеквизита = "СтавкаНДС" Тогда
		
		// Расчет реквизитов "ЦенаСправедливая", "СуммаСправедливая", "СуммаНДССправедливая", "ВсегоСправедливая".
		ПараметрыРасчета.Вставить("ИмяРеквизитаЦена",     "ЦенаСправедливая");
		ПараметрыРасчета.Вставить("ИмяРеквизитаСумма",    "СуммаСправедливая");
		ПараметрыРасчета.Вставить("ИмяРеквизитаСуммаНДС", "СуммаНДССправедливая");
		ПараметрыРасчета.Вставить("ИмяРеквизитаВсего",    "ВсегоСправедливая");
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ,
			СтрЗаменить(ВРЕГ(ИмяРеквизита), "СПРАВЕДЛИВАЯ", ""), ПараметрыРасчета);
		
	КонецЕсли;
	
	ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(СтрокаТЧ);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)

	Объект = Форма.Объект;
	
	ПараметрыПредставления = Новый Структура("ВалютаДокумента, ПринятьНДСКВычету, СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(ПараметрыПредставления, Объект);
	ПараметрыПредставления.Вставить("ПоказыватьНДС", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьВалюту", Форма.КэшПараметров.ИспользоватьВалютныйУчет);
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИДоступностьСубконто(Форма, Объект, ИмяРеквизитаСчет)
	Перем МассивПолей;
	
	Если ИмяРеквизитаСчет = "СчетРасходов" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Подразделение", "ПодразделениеРасходов", "ПодразделениеРасходов", Истина, "ПодразделениеРасходов", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоРасходов1", "СубконтоРасходов1", Истина, "СубконтоРасходов1", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоРасходов2", "СубконтоРасходов2", Истина, "СубконтоРасходов2", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоРасходов3", "СубконтоРасходов3", Истина, "СубконтоРасходов3", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетРасходов, Форма, Объект, МассивПолей);
		
	ИначеЕсли ИмяРеквизитаСчет = "СчетДоходов" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоДоходов1", "СубконтоДоходов1", Истина, "СубконтоДоходов1", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоДоходов2", "СубконтоДоходов2", Истина, "СубконтоДоходов2", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоДоходов3", "СубконтоДоходов3", Истина, "СубконтоДоходов3", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетДоходов, Форма, Объект, МассивПолей);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРуководителя(Объект)

	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
