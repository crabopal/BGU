#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			УстановитьОтветственныхЛиц(Объект.Организация, Объект.Подразделение, Объект.Дата, Объект.Руководитель, Объект.ГлБухгалтер);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.КассовыйОрган) Тогда
			ПолучитьБанкПоУмолчанию();
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.НастройкаВыгрузки) Тогда
			ПолучитьНастройкуВыгрузкиПоУмолчанию();
		КонецЕсли;
		
		ПредыдущаяНастройкаВыгрузки = Объект.НастройкаВыгрузки;
		
		ОбновитьТекстКлассификацииВсехСтрокТаблицыСостав(Объект);
		
		ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ГодДокумента", Год(Объект.Дата));
	
	СписокТиповДокументовВводимыхНаОсновании = СписокДокументовВводимыхНаОсновании();
	СписокТиповДокументовВводимыхНаОсновании.СортироватьПоЗначению();
	
	РасчетноПлатежныйДокумент = ВведенныйНаОснованииРасчетноПлатежныйДокумент(Объект.Ссылка);
	ОбновитьНадписьПлатежныйДокумент(НадписьРасчетноПлатежныйДокумент, РасчетноПлатежныйДокумент, Элементы);
	
	НадписьПриложитьКСуществующемуДокументу = НСтр(
		"ru='<Приложить к существующему расчетно-платежному документу...>'");
	
	ДобавитьКомандыПрикрепления();
	УстановитьДоступностьКомандПрикрепления(Элементы, ЗначениеЗаполнено(РасчетноПлатежныйДокумент));
	
	РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
	
	РедактированиеКлассификацииВДиалоге = ХранилищеНастроекДанныхФорм.Загрузить(
		"Документ.ВедомостьНаВыплатуВБанк.Форма.ФормаДокумента", "РедактированиеКлассификацииВДиалоге");
	Если РедактированиеКлассификацииВДиалоге <> Неопределено Тогда
		УправлениеВидимостьюТабличныхЧастей(Элементы, РедактированиеКлассификацииВДиалоге);
	КонецЕсли;
	
	УстановитьВидимостьСотрудникКонтрагент(Элементы, Объект.СотрудникКонтрагент = 0);
	
	ПлатежноРасчетныеДокументы.ЗаполнитьСписокВыбораКодовДохода(Элементы.КодВидаДохода);
	
	// Централизованная бухгалтерия
	ЗаполнениеРеквизитовОбъектов.ОпределитьПараметрыВыбораСотрудников(ЭтаФорма, Объект.Организация);
	// Конец Централизованная бухгалтерия
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами".
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	Если ТипЗнч(НовыйОбъект) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход") 
		Или ТипЗнч(НовыйОбъект) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная") 
		Или ТипЗнч(НовыйОбъект) = Тип("ДокументСсылка.КассовоеВыбытие")
		Или ТипЗнч(НовыйОбъект) = Тип("ДокументСсылка.ПлатежноеПоручение")
		Или ТипЗнч(НовыйОбъект) = Тип("ДокументСсылка.РСКППеречисление") Тогда
		
		РасчетноПлатежныйДокумент = НовыйОбъект;
		
		УстановитьДоступностьКомандПрикрепления(Элементы, ЗначениеЗаполнено(РасчетноПлатежныйДокумент));
		
		ОбновитьНадписьПлатежныйДокумент(НадписьРасчетноПлатежныйДокумент, РасчетноПлатежныйДокумент, Элементы);
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ПредыдущаяНастройкаВыгрузки = Объект.НастройкаВыгрузки;
	
	ОбновитьТекстКлассификацииВсехСтрокТаблицыСостав(Объект,Неопределено);
	
	ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы(ЭтотОбъект, Объект);
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(РасчетноПлатежныйДокумент) И НЕ (ПараметрыЗаписи.Свойство("НеПроверятьПлатежныйДокумент")
		И ПараметрыЗаписи.НеПроверятьПлатежныйДокумент) Тогда
		
		ПроверкаНеПройдена = Ложь;
		ПлатежноРасчетныеДокументы.ПроверитьПлатежныйДокументНаСоответствиеВедомости(ТекущийОбъект,
			РасчетноПлатежныйДокумент, ПроверкаНеПройдена);
		
		Если ПроверкаНеПройдена Тогда

			Если ТипЗнч(РасчетноПлатежныйДокумент) = Тип("ДокументСсылка.КассовоеВыбытие") Тогда
				ПлатежныйДокументПроведен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РасчетноПлатежныйДокумент,
					"Проведен");
				СтатусПлатежногоДокумента = ?(ПлатежныйДокументПроведен,
					Перечисления.СтатусыИсполненияДокумента.Исполнен, Перечисления.СтатусыИсполненияДокумента.ВРаботе);
			Иначе
				СтатусПлатежногоДокумента = БухгалтерскиеОперации.СтатусДокумента(РасчетноПлатежныйДокумент);
			КонецЕсли;

			Если ЗначениеЗаполнено(СтатусПлатежногоДокумента) 
				И СтатусПлатежногоДокумента	<> Перечисления.СтатусыИсполненияДокумента.ВРаботе Тогда

				Отказ = Истина;

				ТекстИсключения = СтрШаблон(
					НСтр("ru='Не удалось %1: ""%2""!'"), ?(ПараметрыЗаписи.РежимЗаписи
					= РежимЗаписиДокумента.Проведение, НСтр("ru='провести'"), НСтр("ru='записать'")), ТекущийОбъект);
				
				ВызватьИсключение ТекстИсключения;

			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбновитьТекстКлассификацииВсехСтрокТаблицыСостав(Объект);
	
	ХранилищеНастроекДанныхФорм.Сохранить(
		"Документ.ВедомостьНаВыплатуВБанк.Форма.ФормаДокумента",
		"РедактированиеКлассификацииВДиалоге",
		Элементы.СоставРедактированиеВДиалоге.Пометка);
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Документ.ВедомостьНаВыплатуВБанк.Форма.ФормаПодбораПоЗаявлениям" Тогда
		
		ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение);
		
		РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход")
		Или ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная")
		Или ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.КассовоеВыбытие")
		Или ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.ПлатежноеПоручение")
		Или ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.РСКППеречисление") Тогда
		
		ОбработкаВыбораПлатежногоДокументаНаКлиентеАсинх(ВыбранноеЗначение);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".
	
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	Если ЭтотОбъект.КэшПараметров.Локальные.ГодДокумента <> Год(Объект.Дата) И Объект.НомерРеестра <> 0 Тогда
		
		Объект.НомерРеестра = 0;
		
		ТекстОповещения = НСтр("ru = 'Номер реестра очищен'");
		ТекстПояснения = НСтр("ru = '(будет присвоен при записи документа)'");
		ПоказатьОповещениеПользователя(ТекстОповещения, , ТекстПояснения, БиблиотекаКартинок.Информация32);
		
	КонецЕсли;
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ГодДокумента", Год(Объект.Дата));
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			УстановитьОтветственныхЛиц(Объект.Организация, Объект.Подразделение, Объект.Дата, Объект.Руководитель, Объект.ГлБухгалтер);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КассовыйОрганПриИзменении(Элемент)
	
	КассовыйОрганПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаДокументаПриИзменении(Элемент)
	
	РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	УстановитьОтветственныхЛиц(Объект.Организация, Объект.Подразделение, Объект.Дата, Объект.Руководитель, Объект.ГлБухгалтер);
	
	ПолучитьНастройкуВыгрузкиПоУмолчанию();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		УстановитьОтветственныхЛиц(Объект.Организация, Объект.Подразделение, Объект.Дата, Объект.Руководитель, Объект.ГлБухгалтер);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьПлатежныйДокументНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(РасчетноПлатежныйДокумент) Тогда
		
		Если СписокТиповДокументовВводимыхНаОсновании.Количество() > 0 Тогда
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораТипаДокумента", ЭтотОбъект);
			ПоказатьВыборИзМеню(Оповещение, СписокТиповДокументовВводимыхНаОсновании);
		КонецЕсли;
		
	Иначе
		
		ПоказатьЗначение(, РасчетноПлатежныйДокумент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьПриложитьКСуществующемуДокументуНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(РасчетноПлатежныйДокумент) Тогда
		
		Если СписокТиповДокументовВводимыхНаОсновании.Количество() > 0 Тогда
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораТипаДокументаДляПрикрепления", ЭтотОбъект);
			ПоказатьВыборИзМеню(Оповещение, СписокТиповДокументовВводимыхНаОсновании);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникКонтрагентПриИзменении(Элемент)
	
	Если Объект.Состав.Количество() > 0 Тогда
		
		Если Объект.СотрудникКонтрагент = 0
			И Объект.Состав.НайтиСтроки(Новый Структура("Контрагент",
				ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"))).Количество() <> Объект.Состав.Количество() Тогда
			
			ТекстВопроса = НСтр("ru = 'Список контрагентов будет очищен. Продолжить?'");
			ОписаниеОповещенияИзменение = Новый ОписаниеОповещения("ДействияПриИзмененииСпособаЗаполнения", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещенияИзменение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20);
			Возврат;
		КонецЕсли;
		
		Если Объект.СотрудникКонтрагент = 1
			И Объект.Состав.НайтиСтроки(Новый Структура("Сотрудник",
				ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка"))).Количество() <> Объект.Состав.Количество() Тогда
			
			ТекстВопроса = НСтр("ru = 'Список сотрудников будет очищен. Продолжить?'");
			ОписаниеОповещенияИзменение = Новый ОписаниеОповещения("ДействияПриИзмененииСпособаЗаполнения", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещенияИзменение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьВидимостьСотрудникКонтрагент(Элементы, Объект.СотрудникКонтрагент = 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияПриИзмененииСпособаЗаполнения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Объект.СотрудникКонтрагент = ?(Объект.СотрудникКонтрагент = 0, 1, 0);
		Возврат;
	КонецЕсли;
	
	Объект.Состав.Очистить();
	Объект.РасшифровкаПлатежа.Очистить();
	
	УстановитьВидимостьСотрудникКонтрагент(Элементы, Объект.СотрудникКонтрагент = 0);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаВыгрузкиПриИзменении(Элемент)
	
	Если ПредыдущаяНастройкаВыгрузки <> Объект.НастройкаВыгрузки И Объект.НомерРеестра <> 0 Тогда
		
		Объект.НомерРеестра = 0;
		
		ТекстОповещения = НСтр("ru = 'Номер реестра очищен'");
		ТекстПояснения = НСтр("ru = '(будет присвоен при записи документа)'");
		ПоказатьОповещениеПользователя(ТекстОповещения, , ТекстПояснения, БиблиотекаКартинок.Информация32);
		
	КонецЕсли;
	
	ПредыдущаяНастройкаВыгрузки = Объект.НастройкаВыгрузки;
	
КонецПроцедуры

