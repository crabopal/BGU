#Область ОбработчикиСобытийЭлементовТаблицыФормыСоставПодробно

&НаКлиенте
Процедура СоставПодробноПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ОтборДляРасшифровкиПлатежа(Элемент.ТекущиеДанные.ИдентификаторСтроки);
		ИдентификаторТекущейСтроки = Элемент.ТекущиеДанные.ИдентификаторСтроки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноПередУдалением(Элемент, Отказ)
	УдалитьСтрокиРасшифровкиПлатежа(Элемент.ВыделенныеСтроки);
	РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Копирование Тогда
		// скопируем также классификацию
		ТекущаяКлассификация.Очистить();
		СтрокиДляКопирования = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки",ИдентификаторТекущейСтроки));
		Для Каждого Строка Из СтрокиДляКопирования Цикл
			ЗаполнитьЗначенияСвойств(ТекущаяКлассификация.Добавить(),Строка);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		ИдентификаторТекущейСтроки = Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки;
		
		Если Копирование Тогда
			Для Каждого Строка Из ТекущаяКлассификация Цикл
				НоваяСтрокаРасшифровки = Объект.РасшифровкаПлатежа.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаРасшифровки,Строка);
				НоваяСтрокаРасшифровки.ИдентификаторСтроки = Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки;
			КонецЦикла;
			РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
		КонецЕсли;
		
		ОтборДляРасшифровкиПлатежа(Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноСотрудникПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СоставПодробно.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.СчетСотрудника) Тогда
		ТекущиеДанные.СчетСотрудника = СчетСотрудника(ТекущиеДанные.Сотрудник, Объект.КассовыйОрган);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СчетСотрудника) Тогда
		Элементы.СоставПодробно.ЗакончитьРедактированиеСтроки(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставПодробноКонтрагентПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СоставПодробно.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.СчетСотрудника) Тогда
		ТекущиеДанные.СчетСотрудника = СчетКонтрагента(ТекущиеДанные.Контрагент, Объект.КассовыйОрган);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СчетСотрудника) Тогда
		Элементы.СоставПодробно.ЗакончитьРедактированиеСтроки(Ложь);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРасшифровкаПлатежаПодробно

&НаКлиенте
Процедура РасшифровкаПлатежаПодробноПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Элементы.СоставПодробно.ТекущиеДанные = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не выбран сотрудник!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, , "СоставПодробно", "Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПодробноПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.СоставПодробно.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		Если Копирование Тогда
			РассчитатьИтогСтрокиПоИдентификатору(ТекущиеДанные.ИдентификаторСтроки,"СоставПодробно");
			РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
		ИначеЕсли НоваяСтрока Тогда
			Элементы.РасшифровкаПлатежаПодробно.ТекущиеДанные.ИдентификаторСтроки = ТекущиеДанные.ИдентификаторСтроки;
			Элементы.РасшифровкаПлатежаПодробно.ТекущиеДанные.Сотрудник = ТекущиеДанные.Сотрудник;
			Элементы.РасшифровкаПлатежаПодробно.ТекущиеДанные.ОснованиеПринятияОбязательства = ТекущиеДанные.ОснованиеПринятияОбязательства;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПодробноПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НЕ ОтменаРедактирования Тогда
		
		ТекущиеДанные = Элементы.РасшифровкаПлатежаПодробно.ТекущиеДанные;
		
		Если ТекущиеДанные <> Неопределено Тогда
			РассчитатьИтогСтрокиПоИдентификатору(ТекущиеДанные.ИдентификаторСтроки,"СоставПодробно");
		КонецЕсли;
		
		РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
		
		СтрокаСостава = Объект.Состав.НайтиСтроки(Новый Структура("ИдентификаторСтроки",
		Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки));
		ПриПолученииДанныхСтрокиСостава(Объект,СтрокаСостава[0],ВалютаРегламентированногоУчета);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПодробноПослеУдаления(Элемент)
	
	ТекущиеДанные = Элементы.РасшифровкаПлатежаПодробно.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Элементы.СоставПодробно.ТекущиеДанные.Сумма = 0;
	Иначе
		РассчитатьИтогСтрокиПоИдентификатору(ТекущиеДанные.ИдентификаторСтроки,"СоставПодробно");
	КонецЕсли;
	
	СтрокаСостава = Объект.Состав.НайтиСтроки(Новый Структура("ИдентификаторСтроки",
		Элементы.СоставПодробно.ТекущиеДанные.ИдентификаторСтроки));
	ПриПолученииДанныхСтрокиСостава(Объект,СтрокаСостава[0],ВалютаРегламентированногоУчета);
	
	РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПодробноКПСПриИзменении(Элемент)
	ТекущиеДанные = Элементы.РасшифровкаПлатежаПодробно.ТекущиеДанные;
	БухгалтерскийУчетКлиент.ПроверитьОчиститьКЭК(ТекущиеДанные.КПС, ТекущиеДанные.КЭК); 
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСостав

&НаКлиенте
Процедура СоставПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ИдентификаторТекущейСтроки = Элемент.ТекущиеДанные.ИдентификаторСтроки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоставВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторСтроки) Тогда
		Если Поле.ГиперссылкаЯчейки ИЛИ Поле.ТолькоПросмотр Тогда
			РедактироватьКлассификациюСтроки(ТекущиеДанные);
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоставПередУдалением(Элемент, Отказ)
	УдалитьСтрокиРасшифровкиПлатежа(Элемент.ВыделенныеСтроки);
	РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура СоставПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Копирование Тогда
		// скопируем также классификацию
		ТекущаяКлассификация.Очистить();
		СтрокиДляКопирования = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки",ИдентификаторТекущейСтроки));
		Для Каждого Строка Из СтрокиДляКопирования Цикл
			ЗаполнитьЗначенияСвойств(ТекущаяКлассификация.Добавить(),Строка);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоставПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		Элементы.Состав.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		ИдентификаторТекущейСтроки = Элементы.Состав.ТекущиеДанные.ИдентификаторСтроки;
		
		Если Копирование Тогда
			Для Каждого Строка Из ТекущаяКлассификация Цикл
				НоваяСтрокаРасшифровки = Объект.РасшифровкаПлатежа.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаРасшифровки,Строка);
				НоваяСтрокаРасшифровки.ИдентификаторСтроки = Элементы.Состав.ТекущиеДанные.ИдентификаторСтроки;
			КонецЦикла;
			РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
		КонецЕсли;
		
		ПриПолученииДанныхСтрокиСостава(Объект,Элементы.Состав.ТекущиеДанные,ВалютаРегламентированногоУчета);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если НЕ ОтменаРедактирования Тогда
		
		ДанныеСтроки = Элемент.ТекущиеДанные;
		ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", ДанныеСтроки.ИдентификаторСтроки);
		МассивКИзменению = Объект.РасшифровкаПлатежа.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКИзменению Из МассивКИзменению Цикл
			СтрокаКИзменению.Сотрудник = ДанныеСтроки.Сотрудник;
		КонецЦикла;
		
	ИначеЕсли НоваяСтрока Тогда
		
		УдалитьСтрокиРасшифровкиПлатежа(Элемент.ВыделенныеСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставСотрудникПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.СчетСотрудника) Тогда
		ТекущиеДанные.СчетСотрудника = СчетСотрудника(ТекущиеДанные.Сотрудник, Объект.КассовыйОрган);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставКонтрагентПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.СчетСотрудника) Тогда
		ТекущиеДанные.СчетСотрудника = СчетКонтрагента(ТекущиеДанные.Контрагент, Объект.КассовыйОрган);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьСумму(Команда)
	
	Если Объект.СуммаДокумента <> Объект.РасшифровкаПлатежа.Итог("Сумма") Тогда
		Объект.СуммаДокумента = Объект.РасшифровкаПлатежа.Итог("Сумма");
		РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПерезаполнитьПлатежныйДокумент(Команда)

	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(РасчетноПлатежныйДокумент) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	УточнитьПараметрыЗаполнения = УточнитьПараметрыЗаполнения();

	ТекстВопроса = "";
	Если УточнитьПараметрыЗаполнения.ЗаполнитьДетализацию Тогда
		ТекстВопроса = ТекстВопроса + СтрШаблон(НСтр("ru='
			|Табличная часть ""Детализация платежа"" документа
			|""%1""
			|будет очищена и заполнена по данным ведомости.'"), РасчетноПлатежныйДокумент);
	Иначе
		ТекстВопроса = ТекстВопроса + СтрШаблон(НСтр("ru='
			|Данные платежного документа
			|""%1""
			|будут очищены и заполнены по данным ведомости.'"), РасчетноПлатежныйДокумент);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УточнитьПараметрыЗаполнения.ТекстПредупреждения) Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС
			+ УточнитьПараметрыЗаполнения.ТекстПредупреждения;
	КонецЕсли;
		
	ТекстВопроса = ТекстВопроса + НСтр("ru=' Продолжить?'");
			
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ДокументВМассиве = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(РасчетноПлатежныйДокумент);
	
	РасчетноПлатежныйДокументПроведен = ОбщегоНазначенияКлиент.ПроверитьПроведенностьДокументов(
		ДокументВМассиве).Количество() = 0;

	Если РасчетноПлатежныйДокументПроведен Тогда
		
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить("Перепровести", "Перепровести");
		СписокКнопок.Добавить("ОтменитьПроведение", "Отменить проведение");
		СписокКнопок.Добавить("Отмена", "Отмена");
		
		ТекстВопроса = СтрШаблон(НСтр("ru='Выбранный документ ""%1"" уже проведен.
			|Выберите одно из возможных действий после заполнения.'"),
			РасчетноПлатежныйДокумент);

		Ответ = Ждать ВопросАсинх(ТекстВопроса, СписокКнопок);
		
		Если Ответ = "Перепровести" Тогда
			РежимЗаписи = РежимЗаписиДокумента.Проведение;
		ИначеЕсли Ответ = "ОтменитьПроведение" Тогда
			РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
		Иначе
			Возврат;
		КонецЕсли;
		
	Иначе
		РежимЗаписи = РежимЗаписиДокумента.Запись;
	КонецЕсли;	

	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ЗаписатьВедомость", Модифицированность);
	ПараметрыЗаполнения.Вставить("РежимЗаписи", РежимЗаписи);
	ПараметрыЗаполнения.Вставить("ЗаполнитьДетализацию", УточнитьПараметрыЗаполнения.ЗаполнитьДетализацию);
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	Результат = ПерезаполнитьПлатежныйДокументНаСервере(ПараметрыЗаполнения);
	РазблокироватьДанныеФормыДляРедактирования();
	
	Если Результат.Ошибка Тогда
		
		ЗаголовокОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось перезаполнить расчетно-платежный документ ""%1"" по данным ведомости ""%2"":'"),
				РасчетноПлатежныйДокумент, Объект.Ссылка);
	    Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(Результат.ИнформацияОбОшибке, ЗаголовокОшибки);
	    
	    Если ЗначениеЗаполнено(Уточнение.Категория) Тогда
			ОбработкаОшибок.ПоказатьИнформациюОбОшибке(Результат.ИнформацияОбОшибке, Уточнение.Текст);
	    Иначе
	    	ПоказатьПредупреждение(, Уточнение.Текст);
	    КонецЕсли;

		Возврат;
	КонецЕсли;

	Если ПараметрыЗаполнения.ЗаписатьВедомость Тогда
		Прочитать();
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
	
	ОповеститьОбИзменении(РасчетноПлатежныйДокумент);

	ТекстВопроса = НСтр("ru='Расчетно-платежный документ заполнен по данным ведомости.'");
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ТекстВопроса = ТекстВопроса + НСтр("ru='
		|Выполнено перепроведение расчетно-платежного документа.'");
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ТекстВопроса = ТекстВопроса + НСтр("ru='
		|Выполнена отмена проведения расчетно-платежного документа.'");
	КонецЕсли;
	
	ТекстВопроса = ТекстВопроса + СтрШаблон(НСтр("ru='
		|Открыть ""%1""?'"), РасчетноПлатежныйДокумент);
	
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПоказатьЗначение(, РасчетноПлатежныйДокумент);
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеВДиалоге(Команда)
	
	Если Элементы.СтраницыТЧ.ТекущаяСтраница = Элементы.СтраницаСостав Тогда
		Пометка = Элементы.СоставРедактированиеВДиалоге.Пометка;
	Иначе
		Пометка = Элементы.СоставПодробноРедактированиеВДиалоге.Пометка;
	КонецЕсли;
	
	ПометкаНовая = НЕ Пометка;
	
	УправлениеВидимостьюТабличныхЧастей(Элементы,ПометкаНовая);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоЗаявлениям(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстОшибки = НСтр("ru='Не выбрана организация!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, , "Организация", "Объект");
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	
	ПараметрыОткрытия.Вставить("Организация", 		Объект.Организация);
	ПараметрыОткрытия.Вставить("ИФО", 				Объект.ИФО);
	ПараметрыОткрытия.Вставить("Подразделение", 	Объект.Подразделение);
	ПараметрыОткрытия.Вставить("Дата", 				Объект.Дата);
	
	ПараметрыОткрытия.Вставить("ТолькоПросмотр", 	ТолькоПросмотр);
	
	ОткрытьФорму("Документ.ВедомостьНаВыплатуВБанк.Форма.ФормаПодбораПоЗаявлениям",
		ПараметрыОткрытия, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриложитьКСуществующемуДокументу(Команда)
	
	ИмяТипаДокумента = Сред(Команда.Имя, 19);
	ВыбранныйТип = СписокТиповДокументовВводимыхНаОсновании.НайтиПоЗначению(ИмяТипаДокумента);
	
	ПродолжитьПослеВыбораТипаДокументаДляПрикрепления(ВыбранныйТип);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ОткрепитьОтДокумента(Команда)
	
	ОчиститьСообщения();

	Если НЕ ЗначениеЗаполнено(РасчетноПлатежныйДокумент) Тогда
		Возврат;
	КонецЕсли;
		
	ДокументВМассиве = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(РасчетноПлатежныйДокумент);
	
	РасчетноПлатежныйДокументПроведен = ОбщегоНазначенияКлиент.ПроверитьПроведенностьДокументов(
		ДокументВМассиве).Количество() = 0;
	
	ТекстВопроса = СтрШаблон(НСтр("ru='""%1""
		|будет откреплена от документа
		|""%2""'"),
		Объект.Ссылка,
		РасчетноПлатежныйДокумент);
		
	Если РасчетноПлатежныйДокументПроведен Тогда
		ТекстВопроса = ТекстВопроса + НСтр("ru='
		|Будет выполнена отмена проведения документа.'");
	КонецЕсли;

	ТекстВопроса = ТекстВопроса + НСтр("ru='
		|Продолжить?'");
			
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Результат = ОткрепитьВедомостьНаСервере(Объект.Ссылка, РасчетноПлатежныйДокумент);
	Если Результат.Ошибка Тогда
		ИнформацияОбОшибке = Результат.ИнформацияОбОшибке;
	    Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке,
	       НСтр("ru = 'Не удалось открепить ведомость от расчетно-платежного документа:'"));
	    Если ЗначениеЗаполнено(Уточнение.Категория) Тогда
			ОбработкаОшибок.ПоказатьИнформациюОбОшибке(Результат.ИнформацияОбОшибке, Уточнение.Текст);
	    Иначе
	    	ПоказатьПредупреждение(, Уточнение.Текст);
	    КонецЕсли;
		Возврат;
	КонецЕсли;
	ОповеститьОбИзменении(РасчетноПлатежныйДокумент);
		
	РасчетноПлатежныйДокументБыл = РасчетноПлатежныйДокумент;
	РасчетноПлатежныйДокумент = Неопределено;
	УстановитьДоступностьКомандПрикрепления(Элементы, ЗначениеЗаполнено(РасчетноПлатежныйДокумент));
	ОбновитьНадписьПлатежныйДокумент(НадписьРасчетноПлатежныйДокумент, РасчетноПлатежныйДокумент, Элементы);
	
	ТекстВопроса = СтрШаблон(НСтр("ru='""%1"" откреплена от ""%2"".'"), Объект.Ссылка, РасчетноПлатежныйДокументБыл);
	Если РасчетноПлатежныйДокументПроведен Тогда
		ТекстВопроса = ТекстВопроса + СтрШаблон(НСтр("ru='
			|Выполнена отмена проведения ""%1"".'"), РасчетноПлатежныйДокументБыл);
	КонецЕсли;
	
	ТекстВопроса = ТекстВопроса + СтрШаблон(НСтр("ru='
		|Открыть ""%1""?'"), РасчетноПлатежныйДокументБыл);
	
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПоказатьЗначение(, РасчетноПлатежныйДокументБыл);
	КонецЕсли;

КонецПроцедуры

