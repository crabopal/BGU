#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьРазницуШапкиИИтогаТЧ(Форма)
	
	Объект = Форма.Объект;
	Форма.ИтогПоТЧ = Объект.РасшифровкаПлатежа.Итог("Сумма") - Объект.СуммаДокумента;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтветственныхЛиц(Организация, Подразделение, Дата, Руководитель, ГлБухгалтер)
	
	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Руководитель", Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	ГлБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Главный бухгалтер", Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	
КонецПроцедуры // УстановитьОтветственныхЛиц()

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьНадписьПлатежныйДокумент(Надпись, Документ, Элементы)
	
	Если ЗначениеЗаполнено(Документ) Тогда
		ЗаголовокТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Ведомость является приложением к документу %1'"), Документ);
		Надпись = ЗаголовокТекст;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "Перезаполнить", "Видимость", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "НадписьПлатежныйДокумент", "МаксимальнаяШирина", 0);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "НадписьПриложитьКСуществующемуДокументу", "Видимость", Ложь);
	Иначе
		Надпись = НСтр("ru='<Создать расчетно-платежный документ...>'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "Перезаполнить", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "НадписьПлатежныйДокумент", "МаксимальнаяШирина", 25);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "НадписьПриложитьКСуществующемуДокументу", "Видимость", Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораТипаДокумента(ВыбранныйТип, ДопПараметры) Экспорт
	
	Если ВыбранныйТип = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Или Объект.Ссылка.Пустая() Тогда
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Данные еще не записаны.
			|Выполнение действия ""Создать на основании: %1"" возможно только после записи данных.
			|Данные будут записаны.'"), ВыбранныйТип.Представление);
		
		Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияЗаписиДокумента", ЭтотОбъект, ВыбранныйТип.Значение);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , КодВозвратаДиалога.ОК);
	Иначе
		СоздатьДокументНаОсновании(ВыбранныйТип.Значение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументНаОсновании(ВыбранныйТип)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Основание", Объект.Ссылка);
	
	ОткрытьФорму("Документ." + ВыбранныйТип + ".ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияЗаписиДокумента(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.ОК Тогда
		Если Записать() Тогда
			СоздатьДокументНаОсновании(ДопПараметры);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораТипаДокументаДляПрикрепления(ВыбранныйТип, ДопПараметры) Экспорт
	
	Если ВыбранныйТип = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьПослеВыбораТипаДокументаДляПрикрепления(ВыбранныйТип);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПослеВыбораТипаДокументаДляПрикрепления(ВыбранныйТип)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Или Объект.Ссылка.Пустая() Тогда
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Данные еще не записаны.
			|Выполнение действия ""Приложить ведомость к документу: %1"" возможно только после записи данных.
			|Данные будут записаны.'"), ВыбранныйТип.Представление);
		
		Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияЗаписиДокументаПередПриложениемКДокументу", ЭтотОбъект, ВыбранныйТип.Значение);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , КодВозвратаДиалога.ОК);
	Иначе
		ОткрытьФорму("Документ." + ВыбранныйТип.Значение + ".ФормаВыбора", , ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СчетКонтрагента(Знач Контрагент, Знач КассовыйОрган)
	
	Возврат Справочники.БанковскиеИКазначейскиеСчета.СчетКонтрагентаВКассовомОргане(Контрагент, КассовыйОрган);
	
КонецФункции

&НаСервереБезКонтекста
Функция СчетСотрудника(Знач Сотрудник, Знач КассовыйОрган)
	
	Возврат СчетКонтрагента(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник, "Контрагент"), КассовыйОрган);
	
КонецФункции

&НаСервере
Процедура ПолучитьНастройкуВыгрузкиПоУмолчанию()
	
	Объект.НастройкаВыгрузки = Справочники.НастройкиВыгрузкиКомпенсацииРодительскойПлаты.ПолучитьНастройкуВыгрузкиПоУмолчанию(
		Объект.Организация, "Документ.ВедомостьНаВыплатуВБанк", Объект.КассовыйОрган);
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьБанкПоУмолчанию()
	
	Объект.КассовыйОрган = Справочники.Банки.ПолучитьБанкПоУмолчанию(Объект.Организация, "Документ.ВедомостьНаВыплатуВБанк");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДокументОснованиеПлатежногоДокумента(ПлатежныйДокумент)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежныйДокумент, "ДокументОснование");
	
КонецФункции

&НаКлиенте
Процедура УдалитьСтрокиРасшифровкиПлатежа(ВыделенныеСтроки)
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		Строка = Объект.Состав.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		Если Строка <> Неопределено Тогда
			
			ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
			МассивКУдалению = Объект.РасшифровкаПлатежа.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
				Объект.РасшифровкаПлатежа.Удалить(СтрокаКУдалению);
			КонецЦикла;
			
		КонецЕсли
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьКлассификациюСтроки(ДанныеСтроки)
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	
	ПараметрыОткрытия.Вставить("Организация",			Объект.Организация);
	ПараметрыОткрытия.Вставить("ИФО",					Объект.ИФО);
	ПараметрыОткрытия.Вставить("Дата",					Объект.Дата);
	
	ПараметрыОткрытия.Вставить("ИдентификаторСтроки",	ДанныеСтроки.ИдентификаторСтроки);
	ПараметрыОткрытия.Вставить("ЗаголовокФормы", 		?(Объект.СотрудникКонтрагент = 0, Строка(ДанныеСтроки.Сотрудник), Строка(ДанныеСтроки.Контрагент)));
	ПараметрыОткрытия.Вставить("АдресВХранилищеВедомостиПоСтроке", АдресВХранилищеВедомостиПоСтроке(ДанныеСтроки.ИдентификаторСтроки));
	
	ПараметрыОткрытия.Вставить("ТолькоПросмотр",		ТолькоПросмотр);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", ЭтаФорма);
	
	Оповещение = Новый ОписаниеОповещения("РедактированиеСтрокиВыплатыЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.ВедомостьНаВыплатуВБанк.Форма.РедактированиеСтрокиВыплаты",
		ПараметрыОткрытия, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеСтрокиВыплатыЗавершение(РезультатыРедактирования, ДополнительныеПараметры) Экспорт
	
	Если РезультатыРедактирования <> Неопределено И РезультатыРедактирования.Модифицированность Тогда
		
		РедактированиеСтрокиВыплатыЗавершениеНаСервере(РезультатыРедактирования);
		
		РассчитатьИтогСтрокиПоИдентификатору(РезультатыРедактирования.ИдентификаторСтроки,"Состав");
		РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РедактированиеСтрокиВыплатыЗавершениеНаСервере(РезультатыРедактирования)
	
	ИдентификаторСтроки = РезультатыРедактирования.ИдентификаторСтроки;
	
	СтрокиСостава = ЭтаФорма.Объект.Состав.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Если СтрокиСостава.Количество() <> 0 Тогда
		СтрокаСостава = СтрокиСостава[0];
	Иначе
		Возврат;
	КонецЕсли;
	
	РасшифровкаСтроки = ПолучитьИзВременногоХранилища(РезультатыРедактирования.АдресВХранилищеВедомостиПоСтроке);
	
	УдаляемыеСтроки = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		Объект.РасшифровкаПлатежа.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
	ПоляСостава = Новый Массив;
	Для Каждого РеквизитСостава Из Объект.Ссылка.Метаданные().ТабличныеЧасти.Состав.Реквизиты  Цикл
		Если РасшифровкаСтроки.Колонки.Найти(РеквизитСостава.Имя) = Неопределено Тогда
			РасшифровкаСтроки.Колонки.Добавить(РеквизитСостава.Имя, РеквизитСостава.Тип);
		КонецЕсли;
		Если РеквизитСостава.Имя = "Сумма" Тогда
			Продолжить;
		КонецЕсли;
		ПоляСостава.Добавить(РеквизитСостава.Имя);
	КонецЦикла;
	СписокСвойств = СтрСоединить(ПоляСостава, ", ");
	
	Для Каждого СтрокаЗарплаты Из РасшифровкаСтроки Цикл
		ЗаполнитьЗначенияСвойств(СтрокаЗарплаты, СтрокаСостава, СписокСвойств)
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(РасшифровкаСтроки, Объект.РасшифровкаПлатежа);
	
	ПриПолученииДанныхСтрокиСостава(Объект,СтрокаСостава,ВалютаРегламентированногоУчета);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриПолученииДанныхСтрокиСостава(Объект, СтрокаСостава, Валюта)
	
	СтрокиКлассификацииСотрудника = Объект.РасшифровкаПлатежа.НайтиСтроки(
		Новый Структура("ИдентификаторСтроки", СтрокаСостава.ИдентификаторСтроки));
	
	РасшифровкаКлассификации = "";
	
	Для Каждого СтрокаКлассификацииСотрудника Из СтрокиКлассификацииСотрудника Цикл
		
		Если РасшифровкаКлассификации <> "" Тогда
			РасшифровкаКлассификации = РасшифровкаКлассификации + Символы.ПС;
		КонецЕсли;
		
		РасшифровкаКлассификации = РасшифровкаКлассификации + "(";
		РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.КПС;
		РасшифровкаКлассификации = РасшифровкаКлассификации + "; ";
		РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.КЭК;
		РасшифровкаКлассификации = РасшифровкаКлассификации + "; ";
		РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.КФО;
		
		Если ЗначениеЗаполнено(СтрокаКлассификацииСотрудника.КодЦели) Тогда
			РасшифровкаКлассификации = РасшифровкаКлассификации + "; ";
			РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.КодЦели;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаКлассификацииСотрудника.КодМероприятия) Тогда
			РасшифровкаКлассификации = РасшифровкаКлассификации + "; ";
			РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.КодМероприятия;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаКлассификацииСотрудника.ДопКлассификация) Тогда
			РасшифровкаКлассификации = РасшифровкаКлассификации + "; ";
			РасшифровкаКлассификации = РасшифровкаКлассификации + СтрокаКлассификацииСотрудника.ДопКлассификация;
		КонецЕсли;
		
		РасшифровкаКлассификации = РасшифровкаКлассификации + ") ";
		РасшифровкаКлассификации = РасшифровкаКлассификации + Формат(СтрокаКлассификацииСотрудника.Сумма,"ЧДЦ=2; ЧН=");
		
		РасшифровкаКлассификации = РасшифровкаКлассификации + " ";
		РасшифровкаКлассификации = РасшифровкаКлассификации + Валюта;
		
	КонецЦикла;
	
	СтрокаСостава.Классификация = РасшифровкаКлассификации;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДляРасшифровкиПлатежа(ИдентификаторСтроки)
	
	ОтборСтрок = Элементы.РасшифровкаПлатежаПодробно.ОтборСтрок;
	
	Если ОтборСтрок = Неопределено
		ИЛИ НЕ (ОтборСтрок.Свойство("ИдентификаторСтроки")
				И ОтборСтрок.ИдентификаторСтроки = ИдентификаторСтроки) Тогда
		
		Элементы.РасшифровкаПлатежаПодробно.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ИдентификаторСтроки",ИдентификаторСтроки));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИтогСтрокиПоИдентификатору(ИдентификаторСтроки, ИмяТаблицыФормы)
	
	ИтогПоРасшифровке = 0;
	
	ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	МассивСтрокДляСуммирования = Объект.РасшифровкаПлатежа.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого СтрокаСуммирования Из МассивСтрокДляСуммирования Цикл
		ИтогПоРасшифровке = ИтогПоРасшифровке + СтрокаСуммирования.Сумма;
	КонецЦикла;
	
	Элементы[ИмяТаблицыФормы].ТекущиеДанные.Сумма = ИтогПоРасшифровке;
	
КонецПроцедуры

&НаСервере
Функция АдресВХранилищеВедомостиПоСтроке(ИдентификаторСтроки) Экспорт
	Возврат ПоместитьВоВременноеХранилище(Объект.РасшифровкаПлатежа.Выгрузить(
		Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки)), УникальныйИдентификатор);
КонецФункции

&НаСервереБезКонтекста
Процедура ОбновитьТекстКлассификацииВсехСтрокТаблицыСостав(ПереданныйОбъект, Валюта = Неопределено)
	Если Валюта = Неопределено Тогда
		Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	Для Каждого СтрокаСостава Из ПереданныйОбъект.Состав Цикл
		ПриПолученииДанныхСтрокиСостава(ПереданныйОбъект,СтрокаСостава,Валюта);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюТабличныхЧастей(Элементы, Пометка)
	
	Элементы.СоставРедактированиеВДиалоге.Пометка = Пометка;
	Элементы.СоставПодробноРедактированиеВДиалоге.Пометка = Пометка;
	
	Если Пометка Тогда
		Элементы.СтраницыТЧ.ТекущаяСтраница = Элементы.СтраницаСостав;
	Иначе
		Элементы.СтраницыТЧ.ТекущаяСтраница = Элементы.СтраницаПодробно;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСотрудникКонтрагент(ЭлементыФормы, ПоСотрудникам)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставПодробноСотрудник", "Видимость", ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставПодробноСчетСотрудника", "Видимость", ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставПодробноОснованиеПринятияОбязательстваСотрудник", "Видимость", ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставСотрудник", "Видимость", ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставСчетСотрудника", "Видимость", ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставОснованиеПринятияОбязательстваСотрудник", "Видимость", ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставПодробноКонтрагент", "Видимость", НЕ ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставПодробноСчетКонтрагента", "Видимость", НЕ ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставПодробноОснованиеПринятияОбязательстваКонтрагент", "Видимость", НЕ ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставКонтрагент", "Видимость", НЕ ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставСчетКонтрагента", "Видимость", НЕ ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставОснованиеПринятияОбязательстваКонтрагент", "Видимость", НЕ ПоСотрудникам);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставЗаполнитьПоЗаявлениям", "Видимость", ПоСотрудникам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "СоставПодробноЗаполнитьПоЗаявлениям", "Видимость", ПоСотрудникам);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение);
	
	СписокПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение);
	
	Если СписокПодбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	СписокПодбора.Колонки.Добавить("Индекс",Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	Для Каждого ЭлементПодбора Из СписокПодбора Цикл
		ЭлементПодбора.Индекс = СписокПодбора.Индекс(ЭлементПодбора);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПодобранныеЗаявления.Ссылка КАК Ссылка,
	|	ПодобранныеЗаявления.Сотрудник КАК Сотрудник,
	|	ПодобранныеЗаявления.ОснованиеПринятияОбязательства КАК ОснованиеПринятияОбязательства,
	|	ПодобранныеЗаявления.Индекс КАК Индекс
	|ПОМЕСТИТЬ ПодобранныеЗаявления
	|ИЗ
	|	&ПодобранныеЗаявления КАК ПодобранныеЗаявления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодобранныеЗаявления.Сотрудник КАК Сотрудник,
	|	ПодобранныеЗаявления.ОснованиеПринятияОбязательства КАК ОснованиеПринятияОбязательства,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.КФО КАК КФО,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.КПС КАК КПС,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.КЭК КАК КЭК,
	|	ПодобранныеЗаявления.Индекс КАК Индекс,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.НомерСтроки КАК НомерСтроки,
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Сумма КАК Сумма
	|ПОМЕСТИТЬ ДетализацияОснований
	|ИЗ
	|	ПодобранныеЗаявления КАК ПодобранныеЗаявления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявлениеНаВыдачуАванса.РасчетРазмераАванса КАК ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса
	|		ПО ПодобранныеЗаявления.Ссылка = ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПодобранныеЗаявления.Сотрудник,
	|	ПодобранныеЗаявления.ОснованиеПринятияОбязательства,
	|	РешениеОКомандированииФинансовоеОбеспечение.КФО,
	|	РешениеОКомандированииФинансовоеОбеспечение.КПС,
	|	РешениеОКомандированииФинансовоеОбеспечение.КЭК,
	|	ПодобранныеЗаявления.Индекс,
	|	РешениеОКомандированииФинансовоеОбеспечение.НомерСтроки,
	|	РешениеОКомандированииФинансовоеОбеспечение.Сумма
	|ИЗ
	|	ПодобранныеЗаявления КАК ПодобранныеЗаявления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОКомандировании.ФинансовоеОбеспечение КАК РешениеОКомандированииФинансовоеОбеспечение
	|		ПО ПодобранныеЗаявления.Ссылка = РешениеОКомандированииФинансовоеОбеспечение.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПодобранныеЗаявления.Сотрудник,
	|	ПодобранныеЗаявления.ОснованиеПринятияОбязательства,
	|	РешениеОКомпенсацииФинансовоеОбеспечение.КФО,
	|	РешениеОКомпенсацииФинансовоеОбеспечение.КПС,
	|	РешениеОКомпенсацииФинансовоеОбеспечение.КЭК,
	|	ПодобранныеЗаявления.Индекс,
	|	РешениеОКомпенсацииФинансовоеОбеспечение.НомерСтроки,
	|	РешениеОКомпенсацииФинансовоеОбеспечение.Сумма
	|ИЗ
	|	ПодобранныеЗаявления КАК ПодобранныеЗаявления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера.ФинансовоеОбеспечение КАК РешениеОКомпенсацииФинансовоеОбеспечение
	|		ПО ПодобранныеЗаявления.Ссылка = РешениеОКомпенсацииФинансовоеОбеспечение.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПодобранныеЗаявления.Сотрудник,
	|	ПодобранныеЗаявления.ОснованиеПринятияОбязательства,
	|	ЗаявкаТоварыРаботыУслуги.КФО,
	|	ЗаявкаТоварыРаботыУслуги.КПС,
	|	ЗаявкаТоварыРаботыУслуги.КЭК,
	|	ПодобранныеЗаявления.Индекс,
	|	ЗаявкаТоварыРаботыУслуги.НомерСтроки,
	|	ЗаявкаТоварыРаботыУслуги.Сумма
	|ИЗ
	|	ПодобранныеЗаявления КАК ПодобранныеЗаявления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо.ТоварыРаботыУслуги КАК ЗаявкаТоварыРаботыУслуги
	|		ПО ПодобранныеЗаявления.Ссылка = ЗаявкаТоварыРаботыУслуги.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПодобранныеЗаявления.Сотрудник,
	|	ПодобранныеЗаявления.ОснованиеПринятияОбязательства,
	|	ЗаявкаТоварыРаботыУслуги.КФО,
	|	ЗаявкаТоварыРаботыУслуги.КПС,
	|	ЗаявкаТоварыРаботыУслуги.КЭК,
	|	ПодобранныеЗаявления.Индекс,
	|	ЗаявкаТоварыРаботыУслуги.НомерСтроки,
	|	ЗаявкаТоварыРаботыУслуги.Сумма
	|ИЗ
	|	ПодобранныеЗаявления КАК ПодобранныеЗаявления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъема.ТоварыРаботыУслуги КАК ЗаявкаТоварыРаботыУслуги
	|		ПО ПодобранныеЗаявления.Ссылка = ЗаявкаТоварыРаботыУслуги.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДетализацияОснований.Сотрудник КАК Сотрудник,
	|	ДетализацияОснований.ОснованиеПринятияОбязательства КАК ОснованиеПринятияОбязательства,
	|	ДетализацияОснований.КФО КАК КФО,
	|	ДетализацияОснований.КПС КАК КПС,
	|	ДетализацияОснований.КЭК КАК КЭК,
	|	МИНИМУМ(ДетализацияОснований.Индекс) КАК Индекс,
	|	МИНИМУМ(ДетализацияОснований.НомерСтроки) КАК НомерСтроки,
	|	СУММА(ДетализацияОснований.Сумма) КАК Сумма
	|ИЗ
	|	ДетализацияОснований КАК ДетализацияОснований
	|
	|СГРУППИРОВАТЬ ПО
	|	ДетализацияОснований.КЭК,
	|	ДетализацияОснований.КПС,
	|	ДетализацияОснований.КФО,
	|	ДетализацияОснований.ОснованиеПринятияОбязательства,
	|	ДетализацияОснований.Сотрудник
	|
	|УПОРЯДОЧИТЬ ПО
	|	Индекс,
	|	НомерСтроки
	|ИТОГИ
	|	СУММА(Сумма)
	|ПО
	|	Сотрудник,
	|	ОснованиеПринятияОбязательства";
	
	Запрос.УстановитьПараметр("ПодобранныеЗаявления", СписокПодбора);
	
	ВыборкаПоСотрудникам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоСотрудникам.Следующий() Цикл
		
		ВыборкаПоДоговорам = ВыборкаПоСотрудникам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоДоговорам.Следующий() Цикл
			
			НоваяСтрокаСостава = Объект.Состав.Добавить();
			НоваяСтрокаСостава.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСостава, ВыборкаПоДоговорам);
			НоваяСтрокаСостава.СчетСотрудника = СчетСотрудника(НоваяСтрокаСостава.Сотрудник, Объект.КассовыйОрган);
			
			ВыборкаРасшифровка = ВыборкаПоДоговорам.Выбрать();
			Пока ВыборкаРасшифровка.Следующий() Цикл
				НоваяСтрокаРасшифровки = Объект.РасшифровкаПлатежа.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаРасшифровки,ВыборкаРасшифровка);
				НоваяСтрокаРасшифровки.ИдентификаторСтроки = НоваяСтрокаСостава.ИдентификаторСтроки;
			КонецЦикла;
			
			ПриПолученииДанныхСтрокиСостава(Объект, НоваяСтрокаСостава, ВалютаРегламентированногоУчета);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура КассовыйОрганПриИзмененииНаСервере()
	
	ПолучитьНастройкуВыгрузкиПоУмолчанию();
	
	Для Каждого СтрокаСостава Из Объект.Состав Цикл
		Если Объект.СотрудникКонтрагент = 0 Тогда
			СтрокаСостава.СчетСотрудника = СчетСотрудника(СтрокаСостава.Сотрудник, Объект.КассовыйОрган);
		Иначе
			СтрокаСостава.СчетСотрудника = СчетКонтрагента(СтрокаСостава.Контрагент, Объект.КассовыйОрган);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКомандыПрикрепления()
	
	Для Каждого ТипДокумента ИЗ СписокТиповДокументовВводимыхНаОсновании Цикл
		
		ИмяКоманды = "СвязатьСДокументом" + ТипДокумента.Значение;
		
		НоваяКоманда = Команды.Добавить(ИмяКоманды);
		НоваяКоманда.Действие = "Подключаемый_ПриложитьКСуществующемуДокументу";
		НоваяКоманда.Заголовок = ТипДокумента.Представление;
		НоваяКоманда.Картинка = БиблиотекаКартинок.Документ;
		НоваяКоманда.Отображение = ОтображениеКнопки.КартинкаИТекст;
		
		НоваяКнопка = Элементы.Добавить("Кнопка" + ИмяКоманды,
										Тип("КнопкаФормы"),
										Элементы.ГруппаПриложитьКСуществующемуДокументу);
		НоваяКнопка.ИмяКоманды = ИмяКоманды;
		НоваяКнопка.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияЗаписиДокументаПередПриложениемКДокументу(Ответ, ДополнительныеПараметры) Экспорт
	
	Если НЕ Ответ = КодВозвратаДиалога.ОК Тогда
		Возврат
	КонецЕсли;
	
	Если Записать() Тогда
		ОткрытьФорму("Документ." + ДополнительныеПараметры + ".ФормаВыбора", , ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКомандПрикрепления(Элементы, Прикреплен)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаПриложитьКСуществующемуДокументу", "Доступность", НЕ Прикреплен);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ФормаОткрепитьОтДокумента", "Доступность", Прикреплен);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияОткрепленияОтДокумента(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОчиститьОснованиеРасчетноПлатежногоДокумента(
			ДополнительныеПараметры.РасчетноПлатежныйДокумент,
			ДополнительныеПараметры.ТребуетсяОтменитьПроведение,
			Объект.Ссылка,
			РасчетноПлатежныйДокумент);
		УстановитьДоступностьКомандПрикрепления(Элементы, ЗначениеЗаполнено(РасчетноПлатежныйДокумент));
		ОбновитьНадписьПлатежныйДокумент(НадписьРасчетноПлатежныйДокумент, РасчетноПлатежныйДокумент, Элементы);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьОснованиеРасчетноПлатежногоДокумента(ПлатежныйДокумент, ОтменитьПроведение, Ведомость, ПлатежныйДокументРеквизитФормы)
	
	ПлатежныйДокументОбъект = ПлатежныйДокумент.ПолучитьОбъект();
	
	НачатьТранзакцию();
	Попытка
		
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить(Метаданные.НайтиПоТипу(ТипЗнч(ПлатежныйДокумент)).ПолноеИмя());
		ЭлементБлокировкиДанных.УстановитьЗначение("Ссылка", ПлатежныйДокумент);
		БлокировкаДанных.Заблокировать();
		
		ПлатежныйДокументОбъект.Заблокировать();
		
	Исключение
		ОтменитьТранзакцию();
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru='Расчетно-платежный документ занят. Необходимо завершить его редактирование.'"));
		Возврат;
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(ПлатежныйДокументОбъект.ДокументОснование) Тогда
		ТекстСообщения = НСтр("ru='Расчетно-платежный документ не связан с документом-основанием: %1'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ОтменитьТранзакцию();
		ПлатежныйДокументОбъект.Разблокировать();
		Возврат;
	КонецЕсли;
	
	Если ПлатежныйДокументОбъект.ДокументОснование <> Ведомость Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Расчетно-платежный документ связан с другим документом-основанием: %1'"),
			ПлатежныйДокументОбъект.ДокументОснование);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ОтменитьТранзакцию();
		ПлатежныйДокументОбъект.Разблокировать();
		Возврат;
	КонецЕсли;
	
	ПлатежныйДокументОбъект.ДокументОснование = Неопределено;
	ПлатежныйДокументРеквизитФормы = Неопределено;
	
	Попытка
		Если ОтменитьПроведение Тогда
			ПлатежныйДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Иначе
			ПлатежныйДокументОбъект.Записать();
		КонецЕсли;
		ПлатежныйДокументОбъект.Разблокировать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ПлатежныйДокументОбъект.Разблокировать();
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ОбработкаВыбораПлатежногоДокументаНаКлиентеАсинх(ВыбранноеЗначение)

	ОчиститьСообщения();

	ТекущийДокументОснование = ДокументОснованиеПлатежногоДокумента(ВыбранноеЗначение);
	Если ЗначениеЗаполнено(ТекущийДокументОснование) Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Расчетно-платежный документ ""%1"" уже связан с другим документом-основанием: ""%2""'"),
			ВыбранноеЗначение, ТекущийДокументОснование);
		ПоказатьПредупреждение( , ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ДокументВМассиве = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыбранноеЗначение);
	
	РасчетноПлатежныйДокументПроведен = ОбщегоНазначенияКлиент.ПроверитьПроведенностьДокументов(
		ДокументВМассиве).Количество() = 0;
		
	Если РасчетноПлатежныйДокументПроведен Тогда
		
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить("Перепровести", "Перепровести");
		СписокКнопок.Добавить("НеПерепроводить", "Не перепроводить");
		СписокКнопок.Добавить("ОтменитьПроведение", "Отменить проведение");
		СписокКнопок.Добавить("Отмена", "Отмена");
		
		ТекстВопроса = СтрШаблон(НСтр("ru='Выбранный документ ""%1"" уже проведен.
			|Выберите одно из возможных действий после прикрепления ведомости.'"),
			ВыбранноеЗначение);

		Ответ = Ждать ВопросАсинх(ТекстВопроса, СписокКнопок);
		
		Если Ответ = "Перепровести" Тогда
			РежимЗаписи = РежимЗаписиДокумента.Проведение;
		ИначеЕсли Ответ = "НеПерепроводить" Тогда
			РежимЗаписи = РежимЗаписиДокумента.Запись;
		ИначеЕсли Ответ = "ОтменитьПроведение" Тогда
			РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
		Иначе
			Возврат;
		КонецЕсли;
		
	Иначе
		РежимЗаписи = РежимЗаписиДокумента.Запись;
	КонецЕсли;	

	ЗаблокироватьДанныеФормыДляРедактирования();
	Результат = ПрикрепитьВедомостьКПлатежноРасчетномуДокументу(Объект.Ссылка, ВыбранноеЗначение, РежимЗаписи);
	РазблокироватьДанныеФормыДляРедактирования();
	
	Если Результат.Ошибка Тогда
		
		ЗаголовокОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось приложить ведомость ""%1"" к расчетно-платежному документу ""%2"":'"),
				Объект.Ссылка, ВыбранноеЗначение);
	    Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(Результат.ИнформацияОбОшибке, ЗаголовокОшибки);
	    
	    Если ЗначениеЗаполнено(Уточнение.Категория) Тогда
			ОбработкаОшибок.ПоказатьИнформациюОбОшибке(Результат.ИнформацияОбОшибке, Уточнение.Текст);
	    Иначе
	    	ПоказатьПредупреждение(, Уточнение.Текст);
	    КонецЕсли;

		Возврат;
	КонецЕсли;

	РасчетноПлатежныйДокумент = ВыбранноеЗначение;
	ОповеститьОбИзменении(РасчетноПлатежныйДокумент);

	УстановитьДоступностьКомандПрикрепления(Элементы, ЗначениеЗаполнено(РасчетноПлатежныйДокумент));
	ОбновитьНадписьПлатежныйДокумент(НадписьРасчетноПлатежныйДокумент, РасчетноПлатежныйДокумент, Элементы);

	ТекстВопроса = НСтр("ru='Ведомость прикреплена к расчетно-платежному документу.'");
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ТекстВопроса = ТекстВопроса + НСтр("ru='
		|Выполнено перепроведение расчетно-платежного документа.'");
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ТекстВопроса = ТекстВопроса + НСтр("ru='
		|Выполнена отмена проведения расчетно-платежного документа.'");
	КонецЕсли;
	
	ТекстВопроса = ТекстВопроса + СтрШаблон(НСтр("ru='
		|Открыть ""%1""?'"), РасчетноПлатежныйДокумент);
	
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПоказатьЗначение(, РасчетноПлатежныйДокумент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрикрепитьВедомостьКПлатежноРасчетномуДокументу(Знач Ведомость, Знач ПлатежныйДокумент,	Знач РежимЗаписи)

	Возврат
		ПлатежноРасчетныеДокументы.ПрикрепитьВедомостьКПлатежноРасчетномуДокументу(Ведомость,
			ПлатежныйДокумент, РежимЗаписи);
	
КонецФункции

&НаСервереБезКонтекста
Функция ОткрепитьВедомостьНаСервере(Знач Ведомость, Знач ПлатежныйДокумент)
	
	Возврат
		ПлатежноРасчетныеДокументы.ОткрепитьВедомостьОтПлатежноРасчетногоДокумента(Ведомость,
			ПлатежныйДокумент);

КонецФункции

&НаСервере
Функция УточнитьПараметрыЗаполнения()

	Результат = Новый Структура;
	Результат.Вставить("ЗаполнитьДетализацию", Ложь);
	Результат.Вставить("ТекстПредупреждения", "");
			
	СтатусПлатежногоДокумента = БухгалтерскиеОперации.СтатусДокумента(РасчетноПлатежныйДокумент);
	
	Если ЗначениеЗаполнено(СтатусПлатежногоДокумента)
		И СтатусПлатежногоДокумента <> Перечисления.СтатусыИсполненияДокумента.ВРаботе Тогда
	
		Если ТипЗнч(РасчетноПлатежныйДокумент) = Тип("ДокументСсылка.РСКППеречисление") Тогда
			
			Результат.ЗаполнитьДетализацию = Истина;
			
		КонецЕсли;

		Результат.ТекстПредупреждения = СтрШаблон(НСтр("ru='Статус платежного документа: ""%1"".'"),
			СтатусПлатежногоДокумента);
	
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаСервере
Функция ПерезаполнитьПлатежныйДокументНаСервере(ПараметрыЗаполнения)

	ВедомостьОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ПлатежноРасчетныеДокументы.ПерезаполнитьПлатежныйДокументПоВедомости(ВедомостьОбъект,
		РасчетноПлатежныйДокумент, ПараметрыЗаполнения);
	ЗначениеВРеквизитФормы(ВедомостьОбъект, "Объект");
	
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ВведенныйНаОснованииРасчетноПлатежныйДокумент(Ведомость)
	Возврат ПлатежноРасчетныеДокументы.ВведенныйНаОснованииВедомостиВБанкРасчетноПлатежныйДокумент(Ведомость);
КонецФункции

&НаСервереБезКонтекста
Функция СписокДокументовВводимыхНаОсновании()
	Возврат ПлатежноРасчетныеДокументы.СписокТиповДокументовНаОснованииВедомостиВБанк();
КонецФункции

