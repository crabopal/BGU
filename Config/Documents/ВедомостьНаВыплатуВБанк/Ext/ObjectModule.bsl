#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	РазницаШапкиИИтогаТЧ = СуммаДокумента - РасшифровкаПлатежа.Итог("Сумма");
	
	Если РазницаШапкиИИтогаТЧ <> 0 Тогда
		ТекстСообщения = НСтр("ru='Сумма документа не равна сумме расшифровки платежа. Не распределена сумма: '") + Формат((РазницаШапкиИИтогаТЧ), "ЧДЦ=2");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "СуммаДокумента", "Объект",Отказ);
	КонецЕсли;
	
	НеПроверяемыеРеквизиты = Новый Массив;
	
	Если СотрудникКонтрагент = 0 Тогда
		НепроверяемыеРеквизиты.Добавить("Состав.Контрагент");
	Иначе
		НепроверяемыеРеквизиты.Добавить("Состав.Сотрудник");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	УчетРасчетов.ЗаполнитьНомерРеестраВВедомости(ЭтотОбъект);
	
	// Очистка табличной части РасшифровкаПлатежа от строк, не имеющих "родителя" в ТЧ Состав
	// Синхронизация общих реквизитов табличных частей Состав и РасшифровкаПлатежа
	ПоляСостава = Новый Массив;
	Для Каждого РеквизитСостава Из ЭтотОбъект.Метаданные().ТабличныеЧасти.Состав.Реквизиты Цикл
		Если НЕ РеквизитСостава.Имя = "Сумма"
			И НЕ РеквизитСостава.Имя = "СчетСотрудника" Тогда
			ПоляСостава.Добавить(РеквизитСостава.Имя);
		КонецЕсли;
	КонецЦикла;
	СписокСвойств = СтрСоединить(ПоляСостава, ", ");
	
	ЛишниеСтроки = Новый Массив;
	Для Каждого СтрокаРасшифровки Из ЭтотОбъект.РасшифровкаПлатежа Цикл
		СтрокаСостава = ЭтотОбъект.Состав.Найти(СтрокаРасшифровки.ИдентификаторСтроки, "ИдентификаторСтроки");
		Если СтрокаСостава = Неопределено Тогда
			ЛишниеСтроки.Добавить(СтрокаРасшифровки);
		Иначе
			ЗаполнитьЗначенияСвойств(СтрокаРасшифровки, СтрокаСостава, СписокСвойств);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЛишняяСтрока Из ЛишниеСтроки Цикл
		ЭтотОбъект.РасшифровкаПлатежа.Удалить(ЛишняяСтрока);
	КонецЦикла;
	
	Получатели = Новый Массив;
	Для Каждого СтрокаСотрудник Из Состав Цикл
		Если СотрудникКонтрагент = 0 Тогда
			Получатели.Добавить(Справочники.Сотрудники.ФамилияИО(СтрокаСотрудник.Сотрудник));
		Иначе
			Получатели.Добавить(Справочники.Контрагенты.ФамилияИО(СтрокаСотрудник.Контрагент));
		КонецЕсли;
	КонецЦикла;
	Получатели = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Получатели);
	КраткийСоставДокумента = СтрСоединить(Получатели, ", ");
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.НачислениеКомпенсацииОбразование") Тогда
		ЗаполнитьПоНачислениюКомпенсацииОбразование(ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	НомерРеестра = 0;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ЗаполнитьПоНачислениюКомпенсацииОбразование(Основание)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НачислениеКомпенсацииОбразование.Ссылка КАК ДокументОснование,
	|	НачислениеКомпенсацииОбразование.Организация КАК Организация,
	|	НачислениеКомпенсацииОбразование.ИФО КАК ИФО,
	|	НачислениеКомпенсацииОбразование.Факультет КАК Подразделение,
	|	НачислениеКомпенсацииОбразование.Основание КАК Основание,
	|	НачислениеКомпенсацииОбразование.СуммаДокумента КАК СуммаДокумента,
	|	НачислениеКомпенсацииОбразование.Компенсация.(
	|		Контрагент КАК Контрагент,
	|		Сумма КАК Сумма,
	|		КФО КАК КФО,
	|		КПС КАК КПС,
	|		ДоговорКонтрагента КАК ОснованиеПринятияОбязательства,
	|		КЭК КАК КЭК
	|	) КАК Компенсация
	|ИЗ
	|	Документ.НачислениеКомпенсацииОбразование КАК НачислениеКомпенсацииОбразование
	|ГДЕ
	|	НачислениеКомпенсацииОбразование.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Компенсация.НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", Основание);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
		
		СотрудникКонтрагент = 1;
		
		Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			"Руководитель", Организация, ТекущаяДатаСеанса(), Подразделение).ОтветственноеЛицоСсылка;
		ГлБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			"Главный бухгалтер", Организация, ТекущаяДатаСеанса(), Подразделение).ОтветственноеЛицоСсылка;
		
		КассовыйОрган = Справочники.Банки.ПолучитьБанкПоУмолчанию(Организация, "Документ.ВедомостьНаВыплатуВБанк");
		НастройкаВыгрузки = Справочники.НастройкиВыгрузкиКомпенсацииРодительскойПлаты.ПолучитьНастройкуВыгрузкиПоУмолчанию(
			Организация, "Документ.ВедомостьНаВыплатуВБанк", КассовыйОрган);
		
		ВыборкаКомпенсация = Выборка.Компенсация.Выбрать();
		Пока ВыборкаКомпенсация.Следующий() Цикл
			
			СтрокаСостав = Состав.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСостав, ВыборкаКомпенсация);
			Если Не ЗначениеЗаполнено(СтрокаСостав.ОснованиеПринятияОбязательства) Тогда
				СтрокаСостав.ОснованиеПринятияОбязательства = Выборка.Основание;
			КонецЕсли;
			СтрокаСостав.СчетСотрудника = Справочники.БанковскиеИКазначейскиеСчета.СчетКонтрагентаВКассовомОргане(СтрокаСостав.Контрагент, КассовыйОрган);
			СтрокаСостав.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			
			СтрокаРасшифровкаПлатежа = РасшифровкаПлатежа.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРасшифровкаПлатежа, ВыборкаКомпенсация);
			СтрокаРасшифровкаПлатежа.ИдентификаторСтроки = СтрокаСостав.ИдентификаторСтроки;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#КонецОбласти 

#КонецЕсли