
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс	
	
// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПереоценкаТоваровВРознице";
	КомандаПечати.Идентификатор		= "ВедомостьПереоценки";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость переоценки'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ВедомостьПереоценки") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ВедомостьПереоценки", "Ведомость переоценки", ПечатьВедомостиПереоценки(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
		
КонецПроцедуры // Печать()

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьВедомостиПереоценки(МассивОбъектов, ОбъектыПечати)

	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_МЗ_ПереоценкаТоваровВРознице";	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПереоценкаТоваровВРознице.ПФ_MXL_ПереоценкаТоваровВРознице");
	
	ОбластьЗаголовок    = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапкаФормы   = Макет.ПолучитьОбласть("ШапкаФормы");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьСтрока       = Макет.ПолучитьОбласть("Строка");
	ОбластьПодписи      = Макет.ПолучитьОбласть("Подписи");
	
	Запрос = Новый Запрос;   
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПереоценкаТоваровВРознице.Номер КАК Номер,
	               |	ПереоценкаТоваровВРознице.Дата КАК Дата,
	               |	ПереоценкаТоваровВРознице.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	               |	ПРЕДСТАВЛЕНИЕ(ПереоценкаТоваровВРознице.ЦМО.МестоХранения) КАК ПредставлениеСклад,
	               |	ВЫБОР
	               |		КОГДА ПереоценкаТоваровВРозницеТовары.Номенклатура.НаименованиеПолное <> """"
	               |			ТОГДА ПереоценкаТоваровВРозницеТовары.Номенклатура.НаименованиеПолное
	               |		ИНАЧЕ ПереоценкаТоваровВРозницеТовары.Номенклатура.Наименование
	               |	КОНЕЦ КАК Товар,
	               |	ПРЕДСТАВЛЕНИЕ(ПереоценкаТоваровВРозницеТовары.Номенклатура.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
	               |	ПереоценкаТоваровВРозницеТовары.ЦенаСтарая,
	               |	ПереоценкаТоваровВРозницеТовары.ЦенаНовая,
	               |	ПереоценкаТоваровВРознице.ЦМО.Сотрудник КАК МОЛ,
	               |	ПереоценкаТоваровВРознице.Ссылка КАК Ссылка,
	               |	ПереоценкаТоваровВРозницеТовары.НомерСтроки,
	               |	ПереоценкаТоваровВРозницеТовары.Количество
	               |ИЗ
	               |	Документ.ПереоценкаТоваровВРознице КАК ПереоценкаТоваровВРознице
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПереоценкаТоваровВРознице.Товары КАК ПереоценкаТоваровВРозницеТовары
	               |		ПО ПереоценкаТоваровВРознице.Ссылка = ПереоценкаТоваровВРозницеТовары.Ссылка
	               |ГДЕ
	               |	ПереоценкаТоваровВРознице.Ссылка В(&МассивОбъектов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата,
	               |	Номер,
	               |	ПереоценкаТоваровВРозницеТовары.НомерСтроки
	               |ИТОГИ ПО
	               |	Ссылка";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);				   
	
	ПервыйДокумент = Истина;
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ПараметрыЗаголовка = Новый Структура("Дата, Номер", Формат(ВыборкаШапка.Дата, "ДЛФ=D"), ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка,ВыборкаШапка.Номер));
		ОбластьЗаголовок.Параметры.Заполнить(ПараметрыЗаголовка);
		ТабДокумент.Вывести(ОбластьЗаголовок);
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, НаименованиеПолное", ВыборкаШапка.МОЛ, ВыборкаШапка.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);

		ПараметрыШапки = Новый Структура(	"НаименованиеОрганизации, ПредставлениеСклад, ФИОМОЛ",
											ВыборкаШапка.НаименованиеОрганизации,
											ВыборкаШапка.ПредставлениеСклад,
											ДанныеСотрудника.НаименованиеПолное);
		ОбластьШапкаФормы.Параметры.Заполнить(ПараметрыШапки);
		ТабДокумент.Вывести(ОбластьШапкаФормы);
		ТабДокумент.Вывести(ОбластьШапкаТаблицы);
		
		Выборка = ВыборкаШапка.Выбрать();
		Пока Выборка.Следующий() Цикл
				
			ОбластьСтрока.Параметры.Заполнить(Выборка);
			ТабДокумент.Вывести(ОбластьСтрока);
				
		КонецЦикла;

		ТабДокумент.Вывести(ОбластьПодписи);

		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла; 
	
	Возврат ТабДокумент;

КонецФункции		

#КонецОбласти

#КонецЕсли
