&НаКлиенте
Функция ДополнитьСтруктуруПодбора()
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("ЦМО",					Объект.ЦМО);
	ПараметрыПодбора.Вставить("Подразделение",			Объект.Подразделение);
	
	ТипыНоменклатуры = Новый СписокЗначений;
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Блюдо"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ГСМ"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Медикаменты"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МолоднякИЖивотныеНаОткорме"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МягкийИнвентарь"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Посуда"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПродуктыПитания"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Стройматериалы"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Оборудование"));
	
	ПараметрыПодбора.Вставить("ТипыНоменклатуры",ТипыНоменклатуры);

	ПараметрыПодбора.Вставить("ВыводитьНулевуюНоменклатуру",Истина);
	ПараметрыПодбора.Вставить("ИмяТаблицы","Товары");
	Возврат ПараметрыПодбора;
	
КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()

	ДоступностьСвязанныхРеквизитов = ЗначениеЗаполнено(Объект.Организация);
	Элементы.ЦМО.Доступность					= НЕ ТолькоПросмотр И ДоступностьСвязанныхРеквизитов;
	Элементы.Подразделение.Доступность			= НЕ ТолькоПросмотр И ДоступностьСвязанныхРеквизитов;
	Элементы.УстановкаЦенаСтарая.Доступность	= НЕ ТолькоПросмотр И ДоступностьСвязанныхРеквизитов И НЕ Объект.УказатьСуммуВручную;
	Элементы.УстановкаЦенНовая.Доступность		= НЕ ТолькоПросмотр И ДоступностьСвязанныхРеквизитов И НЕ Объект.УказатьСуммуВручную;

КонецПроцедуры

&НаКлиенте
Функция ОрганизацияНеЗаполнена()

	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не выбрана организация'"),,"Объект.Организация");
	Возврат Истина;

КонецФункции // ОрганизацияЗаполнена()

&НаСервереБезКонтекста
Процедура ПолучитьЦеныНоменклатуры(Номенклатура, УстановкаЦенДо, УстановкаЦенПосле, ЦеныДо, ЦеныПосле)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СписокНоменклатуры.Ссылка,
	               |	ЕСТЬNULL(УстановкаЦенНоменклатурыМатериалыДо.Цена, 0) КАК ЦенаДо,
	               |	ЕСТЬNULL(УстановкаЦенНоменклатурыМатериалыПосле.Цена, 0) КАК ЦенаПосле
	               |ИЗ
	               |	Справочник.Номенклатура КАК СписокНоменклатуры
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УстановкаЦенНоменклатуры.Материалы КАК УстановкаЦенНоменклатурыМатериалыДо
	               |		ПО СписокНоменклатуры.Ссылка = УстановкаЦенНоменклатурыМатериалыДо.Номенклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УстановкаЦенНоменклатуры.Материалы КАК УстановкаЦенНоменклатурыМатериалыПосле
	               |		ПО СписокНоменклатуры.Ссылка = УстановкаЦенНоменклатурыМатериалыПосле.Номенклатура
	               |ГДЕ
	               |	СписокНоменклатуры.Ссылка В(&Номенклатура)
	               |	И УстановкаЦенНоменклатурыМатериалыДо.Ссылка = &УстановкаЦенДо
	               |	И УстановкаЦенНоменклатурыМатериалыПосле.Ссылка = &УстановкаЦенПосле";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("УстановкаЦенДо", УстановкаЦенДо);
	Запрос.УстановитьПараметр("УстановкаЦенПосле", УстановкаЦенПосле);
	
	ЦеныДо = Новый Соответствие;
	ЦеныПосле = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		ЦеныДо.Вставить(Выборка.Ссылка, Выборка.ЦенаДо);
		ЦеныПосле.Вставить(Выборка.Ссылка, Выборка.ЦенаПосле);
	
	КонецЦикла;

КонецПроцедуры // ПолучитьЦеныНоменклатуры()

&НаСервере
Процедура ЗаполнитьЦеныНаСервере(ЗаполнятьЦеныДо = Истина, ЗаполнятьЦеныПосле = Истина)
	Перем ЦеныДо, ЦеныПосле;
	
	ПолучитьЦеныНоменклатуры(	Объект.Товары.Выгрузить(,"Номенклатура").ВыгрузитьКолонку("Номенклатура"),
								Объект.УстановкаЦенаСтарая,
								Объект.УстановкаЦенНовая,
								ЦеныДо,
								ЦеныПосле);
	Для каждого ТекСтр Из Объект.Товары Цикл
		
		Если ЗаполнятьЦеныДо Тогда
			ТекСтр.ЦенаСтарая = ЦеныДо[ТекСтр.Номенклатура];
		КонецЕсли;
		Если ЗаполнятьЦеныПосле Тогда
			ТекСтр.ЦенаНовая = ЦеныПосле[ТекСтр.Номенклатура];
		КонецЕсли;
		ПересчитатьСумму(ТекСтр);
	
	КонецЦикла; 	
	
КонецПроцедуры
 
&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСумму(ТекущиеДанные)

	ТекущиеДанные.СуммаПереоценки = ТекущиеДанные.ЦенаНовая*ТекущиеДанные.Количество-ТекущиеДанные.ЦенаСтарая*ТекущиеДанные.Количество;

КонецПроцедуры // ПересчитатьСумму()

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение);
	СписокПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	Для Каждого ЭлементПодбора Из СписокПодбора Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементПодбора);
	КонецЦикла;
    ЗаполнитьЦеныНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура УказатьСуммуВручнуюПриИзменении(Элемент)
	
	Если Объект.УказатьСуммуВручную И Объект.Товары.Количество() > 0 Тогда
		
		ТекстВопроса = НСтр("ru = 'При установки суммы переоценки вручную табличная часть будет очищена.
								|Продолжить и очистить табличную часть?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru='Продолжить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='Отмена'"));
		
		ПоказатьВопрос(Новый ОписаниеОповещения("УказатьСуммуВручнуюПриИзмененииЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки);
		
		Возврат;
		
	КонецЕсли;
	
	УказатьСуммуВручнуюПриИзмененииДействие();
	
КонецПроцедуры

&НаКлиенте
Процедура УказатьСуммуВручнуюПриИзмененииЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Объект.Товары.Очистить();
	Иначе
		Объект.УказатьСуммуВручную = Ложь;
	КонецЕсли;
	
	УказатьСуммуВручнуюПриИзмененииДействие();

КонецПроцедуры

&НаКлиенте
Процедура УказатьСуммуВручнуюПриИзмененииДействие()
	
	Элементы.СуммаДокумента.Доступность = Объект.УказатьСуммуВручную;
	УстановитьДоступностьСвязанныхРеквизитовОрганизации();

КонецПроцедуры

&НаКлиенте
Функция СуммаДокументаУстанавливаетсяВручную()

	Если Объект.УказатьСуммуВручную Тогда
		ТекстСообщения = НСтр("ru='Сумма переоценки указывается вручную'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.СуммаДокумента");
		Возврат Истина;
	КонецЕсли;
    Возврат Ложь;
	
КонецФункции // СуммаДокументаУстанавливаетсяВручную()

