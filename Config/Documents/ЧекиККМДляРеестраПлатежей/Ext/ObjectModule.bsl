			НайденнаяСтрока = ТЗРасшифровкаПлатежа.Найти(ТекСтрока.НомерСтроки, "НомерСтроки");
		Иначе	
			НайденнаяСтрока = ТЗРасшифровкаПлатежа.Найти(ТекСтрока.Контрагент, "Контрагент");
