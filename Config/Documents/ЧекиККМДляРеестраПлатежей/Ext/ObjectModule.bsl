				ТекСтрока.Номенклатура = НоменклатураПлатежаДляЧекаККМ;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	ТЗРасшифровкаПлатежаПоКонтрагентам = ТЗРасшифровкаПлатежаПолная;
	
	ЭтотОбъект.РасшифровкаПлатежейКонтрагентов.Загрузить(ТЗРасшифровкаПлатежаПоКонтрагентам);
	
КонецПроцедуры

Процедура ЗаполнитьСуммыДокумента()
	СуммаФискализированныхЧековККМ = 0;
	СуммаДокументаОснования = 0;
	СуммаКомиссииЭСП = 0;
	СуммаДокументаОснованияСКомиссиейЭСП = 0;
	
	Если ВидОперации = 2 Тогда
		
		СписокДокументовОснований = ДокументыГруппыЧековККМ.Выгрузить();
		ДанныеДляЧековККМПоДокументамРеализации = ПодключаемоеОборудованиеБГУ.ДанныеДляЧековККМПоДокументамРеализации(СписокДокументовОснований);
		СуммаДокументаОснованияСОтбором = ДанныеДляЧековККМПоДокументамРеализации.Итог("Всего");
		
		Для каждого ТекСтрока Из ДокументыГруппыЧековККМ Цикл
			Если ЗначениеЗаполнено(ТекСтрока.ДокументОснованиеЧековККМ) Тогда
				СуммаДокументаОснования = СуммаДокументаОснования + ТекСтрока.ДокументОснованиеЧековККМ.СуммаДокумента;
			КонецЕсли;
		КонецЦикла;
		
		Если СуммаДокументаОснованияСОтбором = СуммаДокументаОснования Тогда
			ЕстьПлатежиПоДоговорамБезПримененияККТ = Ложь;
		Иначе
			ЕстьПлатежиПоДоговорамБезПримененияККТ = Истина;
		КонецЕсли;	
		
		СуммаДокумента = ПлатежиКонтрагентов.Итог("СуммаРеализации");
		
		Для каждого ТекСтрока Из ЧекиККМ Цикл
			НомерКассовогоЧека = ТекСтрока.НомерЧекаККМ;
			Если НомерКассовогоЧека > 0 Тогда
				ЗаключительныйЧекИсправительный = ЗаключительныйЧекИсправительный(Ссылка, НомерКассовогоЧека);
				Если НЕ ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
					СуммаФискализированныхЧековККМ = СуммаФискализированныхЧековККМ + ТекСтрока.СуммаРеализации;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
	Иначе
		СуммаДокумента = ПлатежиКонтрагентов.Итог("Сумма");
		СуммаКомиссииЭСП = РасшифровкаПлатежейКонтрагентов.Итог("СуммаКомиссииЭСП");
		
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			СуммаДокументаОснования = ДокументОснование.СуммаДокумента;
		КонецЕсли;
		
		Для каждого ТекСтрока Из ЧекиККМ Цикл
			НомерКассовогоЧека = ТекСтрока.НомерЧекаККМ;
			Если НомерКассовогоЧека > 0 Тогда
				ЗаключительныйЧекИсправительный = ЗаключительныйЧекИсправительный(Ссылка, НомерКассовогоЧека);
				Если НЕ ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
					СуммаФискализированныхЧековККМ = СуммаФискализированныхЧековККМ + ТекСтрока.Сумма;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	СуммаДокументаОснованияСКомиссиейЭСП = СуммаДокументаОснования + СуммаКомиссииЭСП;
	
КонецПроцедуры

Функция ЗаключительныйЧекИсправительный(ДокументСсылка, НомерЧекаККМ)
	
	Возврат ПодключаемоеОборудованиеБГУ.ЗаключительныйЧекИсправительный(ДокументСсылка, НомерЧекаККМ);

КонецФункции

#КонецОбласти

#КонецЕсли
