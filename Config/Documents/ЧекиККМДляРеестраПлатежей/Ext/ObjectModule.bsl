
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) ИЛИ ТипЗнч(ДанныеЗаполнения)=Тип("Структура") Тогда
		Возврат;
	КонецЕсли;	
	
	ЧекиККМСпискомСсылка = НайтиЧекиККМСпискомПоДокументу(ДанныеЗаполнения);
	Если ЗначениеЗаполнено(ЧекиККМСпискомСсылка) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для документа %1 уже введен документ %2.'"), ДанныеЗаполнения, ЧекиККМСпискомСсылка);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения.НомерЧекаККМ) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для документа %1 уже пробит чек.'"), ДанныеЗаполнения);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КассовоеПоступление") Тогда
		ЗаполнитьПоКассовомуПоступлению(ДанныеЗаполнения);	
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеНаСчет") Тогда
		ЗаполнитьПоПоступлениюНаСчет(ДанныеЗаполнения);	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	ЗаполнитьСуммыДокумента();
	
	Если ВидОперации = 1 Тогда
		ФормироватьЧекиПоКаждомуПлатежуРеестра = Ложь;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиЧекиККМСпискомПоДокументу(ДокументОснование)
	Результат = Документы.ЧекиККМДляРеестраПлатежей.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЧекиККМДляРеестраПлатежей.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЧекиККМДляРеестраПлатежей КАК ЧекиККМДляРеестраПлатежей
	|ГДЕ
	|	ЧекиККМДляРеестраПлатежей.ДокументОснование = &ДокументОснование
	|	И ЧекиККМДляРеестраПлатежей.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.Ссылка;
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьПоКассовомуПоступлению(ДокументОснование)
	ДатаСведений = ДокументОснование.Дата;
	ЗаполняемыеДанные = "Организация, РодительскаяПлата";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	
	ЭтотОбъект.ДокументОснование = ДокументОснование;
	
	РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	НастройкиОборудования = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьНастройкиОборудования(РабочееМесто, ДокументОснование.Организация);
	ЭтотОбъект.КассаККМ = НастройкиОборудования.ФискальныйРегистратор;
	
	ЭтотОбъект.ФормироватьЧекиПоКаждомуПлатежуРеестра = Ложь;
	Если ЗначениеЗаполнено(НастройкиОборудования.ФискальныйРегистратор) Тогда
		ЭтотОбъект.СистемаНалогообложенияЧекаККМ = НастройкиОборудования.ФискальныйРегистратор.СистемаНалогообложенияЧекаККМ;
		ЭтотОбъект.ФормироватьЧекиПоКаждомуПлатежуРеестра = НастройкиОборудования.ФискальныйРегистратор.ФормироватьЧекиПоКаждомуПлатежуРеестра;
	КонецЕсли;
	ЭтотОбъект.НаправлятьПокупателямЭлектронныеЧеки = Истина;
	
	СведенияРасшифровки = ПодключаемоеОборудованиеБГУВызовСервера.РасшифровкаКассовогоПоступления(ДокументОснование);
	
	ТЗРасшифровкаПлатежа = СведенияРасшифровки.Расшифровка;
	ЕстьПлатежиПоДоговорамБезПримененияККТ = СведенияРасшифровки.ЕстьДоговорыБезПримененияККТ;
	
	Для каждого ТекСтрока Из ТЗРасшифровкаПлатежа Цикл
		Если ТекСтрока.СуммаОплатыЭСП > 0 Тогда
			ТекСтрока.Сумма = ТекСтрока.СуммаОплатыЭСП;
		КонецЕсли;	
	КонецЦикла;	
	
	ТЗРасшифровкаПлатежа.Колонки.Добавить("Плательщик", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	
	Если ЭтотОбъект.ФормироватьЧекиПоКаждомуПлатежуРеестра Тогда
		ТЗРасшифровкаПлатежа.Свернуть("НомерСтроки, Контрагент, Плательщик", "Сумма, СуммаКомиссииЭСП, СуммаОплатыЭСП");
	Иначе
		ТЗРасшифровкаПлатежа.Свернуть("Контрагент, Плательщик", "Сумма, СуммаКомиссииЭСП, СуммаОплатыЭСП");
	КонецЕсли;
	ТЗРасшифровкаПлатежа.Колонки.Добавить("КлючСтроки", Новый ОписаниеТипов("Строка"));
	
	Для каждого ТекСтрока Из ТЗРасшифровкаПлатежа Цикл
		ТекСтрока.КлючСтроки = Новый УникальныйИдентификатор;	
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Плательщик) Тогда
			ТекСтрока.Плательщик = ТекСтрока.Контрагент;
		КонецЕсли;
	КонецЦикла;
	
	ЭтотОбъект.ПлатежиКонтрагентов.Загрузить(ТЗРасшифровкаПлатежа);
	
	СведенияРасшифровки = ПодключаемоеОборудованиеБГУВызовСервера.РасшифровкаКассовогоПоступления(ДокументОснование);
	ТЗРасшифровкаПлатежаПолная = СведенияРасшифровки.Расшифровка;
	
	Если ЭтотОбъект.ФормироватьЧекиПоКаждомуПлатежуРеестра Тогда
		ТЗРасшифровкаПлатежаПолная.Свернуть("НомерСтроки, Контрагент, Договор, Ребенок", "Сумма, СуммаКомиссииЭСП, СуммаОплатыЭСП");
	Иначе
		ТЗРасшифровкаПлатежаПолная.Свернуть("Контрагент, Договор, Ребенок", "Сумма, СуммаКомиссииЭСП, СуммаОплатыЭСП");
	КонецЕсли;
	ТЗРасшифровкаПлатежаПолная.Колонки.Добавить("КлючСтроки", Новый ОписаниеТипов("Строка"));
	ТЗРасшифровкаПлатежаПолная.Колонки.Добавить("ГруппаДетскогоУчреждения", Новый ОписаниеТипов("СправочникСсылка.ГруппыДетскогоУчреждения"));
	ТЗРасшифровкаПлатежаПолная.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	Если ЗначениеЗаполнено(ЭтотОбъект.КассаККМ) Тогда
		НоменклатураПлатежаКассыККМ = ЭтотОбъект.КассаККМ.НоменклатураПлатежа;
	Иначе
		НоменклатураПлатежаКассыККМ = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;	
	
	Для каждого ТекСтрока Из ТЗРасшифровкаПлатежаПолная Цикл
		Если ЭтотОбъект.ФормироватьЧекиПоКаждомуПлатежуРеестра Тогда
			НайденнаяСтрока = ТЗРасшифровкаПлатежа.Найти(ТекСтрока.НомерСтроки, "НомерСтроки");
		Иначе	
			НайденнаяСтрока = ТЗРасшифровкаПлатежа.Найти(ТекСтрока.Контрагент, "Контрагент");
		КонецЕсли;	
			
		Если НЕ НайденнаяСтрока = Неопределено Тогда
			ТекСтрока.КлючСтроки = НайденнаяСтрока.КлючСтроки;	
		КонецЕсли;
		
		ТекСтрока.Ребенок = Справочники.Дети.ПустаяСсылка();
		ТекСтрока.Номенклатура = НоменклатураПлатежаКассыККМ;
		Если ЗначениеЗаполнено(ТекСтрока.Договор) Тогда
			НоменклатураПлатежаДляЧекаККМ = ТекСтрока.Договор.НоменклатураПлатежаДляЧекаККМ;
			Если ЗначениеЗаполнено(НоменклатураПлатежаДляЧекаККМ) Тогда
				ТекСтрока.Номенклатура = НоменклатураПлатежаДляЧекаККМ;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	ТЗРасшифровкаПлатежаПоКонтрагентам = ТЗРасшифровкаПлатежаПолная;
	
	ЭтотОбъект.РасшифровкаПлатежейКонтрагентов.Загрузить(ТЗРасшифровкаПлатежаПоКонтрагентам);
	
КонецПроцедуры

Процедура ЗаполнитьПоПоступлениюНаСчет(ДокументОснование)
