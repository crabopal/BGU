#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЧекиККМДляРеестраПлатежей";
	КомандаПечати.Идентификатор		= "СведенияДляУдержанияИзЗаработнойПлатыДляЧековККМ";
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	КомандаПечати.Представление		= НСтр("ru = 'Сведения для удержания из заработной платы за товары, работы, услуги'");
	КомандаПечати.Порядок			= 1;
	
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "РасчетныйДокументБезККТ", 5);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"СведенияДляУдержанияИзЗаработнойПлатыДляЧековККМ") Тогда
		
		ТабличныйДокумент = ПечатьСведенияДляУдержанияИзЗаработнойПлатыДляЧековККМ(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"СведенияДляУдержанияИзЗаработнойПлатыДляЧековККМ","Сведения для удержания из заработной платы за товары, работы, услуги", ТабличныйДокумент);
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"РасчетныйДокументБезККТ") Тогда
	
		ТабличныйДокумент = РозничныеПродажиБГУ.ПечатьРасчетногоДокументаБезККТ(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"РасчетныйДокументБезККТ","Расчетный документ без ККТ (Пост. № 296 от 15.03.2017)", ТабличныйДокумент);
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьСведенияДляУдержанияИзЗаработнойПлатыДляЧековККМ(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_СведенияДляУдержанияИзЗаработнойПлатыДляЧековККМ";
	РеквизитыДокумента = Новый Структура("Номер, Дата, Префикс");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЧекиККМДляРеестраПлатежейДокументыЧекаККМ.Ссылка КАК Ссылка,
	               |	ЧекиККМДляРеестраПлатежейДокументыЧекаККМ.НомерСтроки КАК НомерСтроки,
	               |	ЧекиККМДляРеестраПлатежейДокументыЧекаККМ.Контрагент КАК Контрагент,
	               |	ЧекиККМДляРеестраПлатежейДокументыЧекаККМ.Сумма - ЧекиККМДляРеестраПлатежейДокументыЧекаККМ.СуммаПредоплаты - ЧекиККМДляРеестраПлатежейДокументыЧекаККМ.СуммаАванса КАК Сумма
	               |ПОМЕСТИТЬ ДанныеДляУдержанияИзЗП
	               |ИЗ
	               |	Документ.ЧекиККМДляРеестраПлатежей.ДокументыЧекаККМ КАК ЧекиККМДляРеестраПлатежейДокументыЧекаККМ
	               |ГДЕ
	               |	ЧекиККМДляРеестраПлатежейДокументыЧекаККМ.Ссылка В(&МассивОбъектов)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеДляУдержанияИзЗП.Ссылка КАК Ссылка,
	               |	ДанныеДляУдержанияИзЗП.Ссылка.Номер КАК Номер,
	               |	ДанныеДляУдержанияИзЗП.Ссылка.Дата КАК Дата,
	               |	ДанныеДляУдержанияИзЗП.Ссылка.Организация КАК Организация,
	               |	ДанныеДляУдержанияИзЗП.Ссылка.Ответственный КАК Ответственный,
	               |	ВЫБОР
	               |		КОГДА ДанныеДляУдержанияИзЗП.Ссылка.Организация.НаименованиеПолное = """"
	               |			ТОГДА ДанныеДляУдержанияИзЗП.Ссылка.Организация.Наименование
	               |		ИНАЧЕ ДанныеДляУдержанияИзЗП.Ссылка.Организация.НаименованиеПолное
	               |	КОНЕЦ КАК НаименованиеОрганизации
	               |ИЗ
	               |	ДанныеДляУдержанияИзЗП КАК ДанныеДляУдержанияИзЗП
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Ссылка
	               |ИТОГИ ПО
	               |	Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеДляУдержанияИзЗП.Ссылка КАК Ссылка,
	               |	ДанныеДляУдержанияИзЗП.НомерСтроки КАК НомерСтроки,
	               |	ДанныеДляУдержанияИзЗП.Контрагент КАК Контрагент,
	               |	ДанныеДляУдержанияИзЗП.Сумма КАК Сумма,
	               |	ДанныеДляУдержанияИзЗП.Контрагент.ИНН КАК ИНН,
	               |	Сотрудники.Код КАК ТабельныйНомер
	               |ИЗ
	               |	ДанныеДляУдержанияИзЗП КАК ДанныеДляУдержанияИзЗП
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	               |		ПО ДанныеДляУдержанияИзЗП.Контрагент = Сотрудники.Контрагент
	               |ГДЕ
	               |	ДанныеДляУдержанияИзЗП.Сумма > 0
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Ссылка,
	               |	НомерСтроки
	               |ИТОГИ ПО
	               |	Ссылка";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результаты = Запрос.ВыполнитьПакет();
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЧекиККМДляРеестраПлатежей.ПФ_MXL_СведенияДляУдержанияИзЗаработнойПлатыДляЧековККМ");
	
	ОбластьЗаголовок 	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьОрганизация 	= Макет.ПолучитьОбласть("Организация");
	
	ОбластьШапка 	= Макет.ПолучитьОбласть("ШапкаТаблицы");
	
	ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаТаблицы");
	
	// Вывести Итого.
	ОбластьИтого = Макет.ПолучитьОбласть("Итого");
	
	ОбластьСуммаПрописью = Макет.ПолучитьОбласть("СуммаПрописью");
	ОбластьПодписей      = Макет.ПолучитьОбласть("Подписи");
	
	ВыборкаПоДокументам = Результаты[1].Выбрать();
	ВыборкаПоТабличнойЧастиДокументыЧекаККМ = Результаты[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаПоДокументам.Следующий() Цикл
		Если НЕ ВыборкаПоТабличнойЧастиДокументыЧекаККМ.НайтиСледующий(Новый Структура("Ссылка",ВыборкаПоДокументам.Ссылка)) Тогда
			Продолжить;
		КонецЕсли;
		
		ВыборкаПоСтрокамТЧ = ВыборкаПоТабличнойЧастиДокументыЧекаККМ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Если НЕ ПервыйДокумент Тогда
			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СинонимДокумента   = НСтр("ru='Сведения для удержания из заработной платы за товары, работы, услуги реализованные сотрудникам'");
		
		ЗаполнитьЗначенияСвойств(РеквизитыДокумента, ВыборкаПоДокументам);
		ОбластьЗаголовок.Параметры.ТекстЗаголовка = СформироватьЗаголовокДокумента(РеквизитыДокумента, СинонимДокумента);
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		ОбластьОрганизация.Параметры.ПредставлениеОрганизации = ВыборкаПоДокументам.НаименованиеОрганизации;
		ОбластьОрганизация.Параметры.Организация = ВыборкаПоДокументам.Организация;
		ТабличныйДокумент.Вывести(ОбластьОрганизация);
		
		// Шапка
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		Всего = 0;
		ВсегоНаименований = 0;
		Пока ВыборкаПоСтрокамТЧ.Следующий() Цикл
			
			ОбластьСтрока.Параметры.Заполнить(ВыборкаПоСтрокамТЧ);
			ОбластьСтрока.Параметры.НомерСтроки = Формат(ВсегоНаименований+1, "ЧЦ=10");
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			Всего = Всего + ВыборкаПоСтрокамТЧ.Сумма;
			
			ВсегоНаименований = ВсегоНаименований + 1;
		КонецЦикла;	
		
		ОбластьИтого.Параметры.Всего = Всего;
		ТабличныйДокумент.Вывести(ОбластьИтого);
		
		ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
		
		ТекстИтоговойСтроки = НСтр("ru = 'Всего удержаний %ВсегоНаименований%, на сумму %Итого%'");
		
		ТекстИтоговойСтроки = СтрЗаменить(ТекстИтоговойСтроки,"%ВсегоНаименований%", ВсегоНаименований);
		ТекстИтоговойСтроки = СтрЗаменить(ТекстИтоговойСтроки,"%Итого%", Формат(Всего, "ЧЦ=15; ЧДЦ=2; ЧРД=,; ЧГ=0"));
		
		ОбластьСуммаПрописью.Параметры.ИтоговаяСтрока = ТекстИтоговойСтроки;
		ОбластьСуммаПрописью.Параметры.СуммаПрописью = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(Всего, ВалютаРубли);
		ТабличныйДокумент.Вывести(ОбластьСуммаПрописью);
		
		ОбластьПодписей.Параметры.Ответственный = ?(ЗначениеЗаполнено(ВыборкаПоДокументам.Ответственный.ФизическоеЛицо),
			ВыборкаПоДокументам.Ответственный.ФизическоеЛицо, "");
		ТабличныйДокумент.Вывести(ОбластьПодписей);
	КонецЦикла;	
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;
КонецФункции

#КонецОбласти

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти
#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Функция СформироватьЗаголовокДокумента(Шапка, НазваниеДокумента = "", ФорматДаты = "") Экспорт
	
	Если НазваниеДокумента = ""
		И Шапка.Свойство("Представление")
		И ЗначениеЗаполнено(Шапка.Представление) Тогда
		
		ПоложениеНомера = Найти(Шапка.Представление,Шапка.Номер);
		
		Если ПоложениеНомера > 0 Тогда
			НазваниеДокумента = СокрЛП(Лев(Шапка.Представление,ПоложениеНомера-1));
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПустаяСтрока(ФорматДаты) Тогда
		ФорматДаты = "ДФ='дд ММММ гггг'";
	КонецЕсли;
	
	Возврат НазваниеДокумента + " № " + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Шапка.Номер, Ложь, Истина)
	                          + " от " + Формат(Шапка.Дата, ФорматДаты) + " г.";
	
КонецФункции // СформироватьЗаголовокДокумента()

#КонецОбласти
#КонецЕсли
