&НаКлиенте
Перем ПеренестиВДокумент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЕстьПравоНастройкиККТ = ПодключаемоеОборудованиеБГУ.ЕстьПравоНастройкиККТ();
	
	// Заполним реквизиты формы из параметров.
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, СписокРеквизитовДокумента());
	ЗагрузитьПереданыйСписокНоменклатурыЧека(Параметры.АдресНоменклатурыЧекаВХранилище);
	
	Если Параметры.ДокументЧекиККМ.ВидОперации = 1 Тогда
		Элементы.Сумма.Заголовок = НСтр("ru = 'Сумма встречного предоставления'");
	ИначеЕсли Параметры.ДокументЧекиККМ.ВидОперации = 2 Тогда
		Сумма = 0;
	КонецЕсли;	
	
	СуммаПостоплаты = ?(СуммаРеализации - СуммаПредоплаты - Сумма < 0, 0, СуммаРеализации - СуммаПредоплаты - Сумма);
	
	ПрочитатьДополнительныеДанныеЧековККМ();
	
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма);
	
	УстановитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПредставитьТелефонИEmailКлиент();
	ОбновитьФормуSMSИEmail();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПеренестиВДокумент <> Истина И Модифицированность Тогда
	
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), НСтр("ru = 'Данные чека изменены. Продолжить редактирование?'"), РежимДиалогаВопрос.ДаНетОтмена);
			
		Отказ = Истина;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Если ПеренестиВДокумент = Истина Тогда
		ЗаписатьДополнительныеДанныеЧековККМ();
		
		АдресДанныхЧекаВХранилище = ПоместитьДанныеЧекаВХранилище();
		Структура = Новый Структура("АдресДанныхЧекаВХранилище", АдресДанныхЧекаВХранилище);
		ПеренестиВДокумент = Истина;
		ОповеститьОВыборе(Структура);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапки

&НаКлиенте
Процедура НеНаправлятьПокупателюЭлектронныйЧекПриИзменении(Элемент)
	Если НеНаправлятьПокупателюЭлектронныйЧек Тогда
		АдресЭП = "";
		Телефон = "";
		ДанныеSMSИлиEmail = "";
		ТелефонСтрокой = "";
		ОбновитьФормуSMSИEmail();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВводДанныхЧекаВручнуюПриИзменении(Элемент)
	ВводДанныхЧекаВручнуюПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТоварыРаботыУслуги

&НаКлиенте
Процедура НоменклатураЧекаККМСтавкаНДСПриИзменении(Элемент)
	РассчитатьСтроку(Элементы.НоменклатураЧекаККМ.ТекущиеДанные, Истина, "СтавкаНДС");
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЧекаККМСуммаПриИзменении(Элемент)
	РассчитатьСтроку(Элементы.НоменклатураЧекаККМ.ТекущиеДанные, Истина, "Сумма");
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураЧекаККМПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока ИЛИ Копирование Тогда
		ТекущиеДанные = Элементы.НоменклатураЧекаККМ.ТекущиеДанные;
		ТекущиеДанные.КлючЧека = КлючЧека;
		Если НоваяСтрока Тогда
			Если НоменклатураЧекаККМ.Количество() = 1 Тогда
				ТекущиеДанные.Сумма = Сумма;
			КонецЕсли;	
			Если РодительскаяПлата Тогда
				ТекущиеДанные.ДополнениеНаименованияНоменклатуры = ПодключаемоеОборудованиеБГУВызовСервера.ФИОКонтрагента(Контрагент);
			КонецЕсли;	
			ТекущиеДанные.Количество = 1;
			ТекущиеДанные.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
			ТекущиеДанные.ПризнакСпособаРасчета = ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой");
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	Если ВсеРеквизитыДляЧекаЗаполнены() Тогда
		ПеренестиВДокумент = Истина;
		Закрыть(КодВозвратаДиалога.OK);
	Иначе	
		Возврат;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПосмотретьПредставлениеЧека(Команда)
	ВывестиПредставлениеЧека();
КонецПроцедуры

&НаКлиенте
Процедура КомандаEmail(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытиеФормыВводаEmail", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Email", АдресЭП);
	ПараметрыФормы.Вставить("Контрагент", Плательщик);
	ПараметрыФормы.Вставить("Заголовок", НСтр("ru = 'Введите адрес электронной почты (Email)'"));
	ПараметрыФормы.Вставить("ОтказКлиентаОтСохраненияEmail", ОтказПокупателяОтСохраненияДанных);
	
	ПодключаемоеОборудованиеБГУКлиент.ОткрытьФормуВводаEmailОтправкиЧерезОФД(ОбработчикОповещения, ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаSMS(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытиеФормыВводаТелефона", ЭтотОбъект, ДополнительныеПараметры);
	
	Если ЗначениеЗаполнено(Телефон) Тогда
		ТелефонЧислом = Число(Телефон);
	Иначе
		ТелефонЧислом = 0;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок" , НСтр("ru = 'Введите номер телефона'"));
	ПараметрыФормы.Вставить("Контрагент", Плательщик);
	ПараметрыФормы.Вставить("ЧислоВвода", ТелефонЧислом);
	ПараметрыФормы.Вставить("ОтказКлиентаОтСохраненияТелефона", ОтказПокупателяОтСохраненияДанных);
	
	ПодключаемоеОборудованиеБГУКлиент.ОткрытьФормуВводаТелефонаДляОтправкиЧерезОФД(ОбработчикОповещения, ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОчиститьEmailИSMS(Команда)
	АдресЭП = "";
	Телефон = "";
	ДанныеSMSИлиEmail = "";
	ТелефонСтрокой = "";
	ОбновитьФормуSMSИEmail();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПросмотрЧекаККМ

&НаКлиенте
Процедура ВывестиПредставлениеЧека()
	ЕстьОшибки = Ложь;
	ЧекСформирован = Ложь;
	
	КассаККМЧека = КассаККМ;
	
	ОчиститьСообщения();
	
	Если НЕ ВсеРеквизитыДляЧекаЗаполнены() Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЕстьОшибки И ПроверитьЗаполнение() Тогда
		Если НомерЧекаККМ = 0 Тогда   
			НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
			НомерДокКассыККМ = ?(НомерДокументаКассыККМ[КассаККМ]=Неопределено, 0, НомерДокументаКассыККМ[КассаККМ]);
			НомерЧека = НомерДокКассыККМ+1;
		Иначе
			НомерЧека = НомерЧекаККМ;	
			ЧекСформирован = Истина;
		КонецЕсли;	
		ОбщиеПараметры = ПодготовитьДанныеДляПробитияЧека(НомерСтрокиЧека);
		
		Если ЧекСформирован Тогда
			ОбщиеПараметры.ДатаВремя = ДатаЧекаККМ;	
		КонецЕсли;	
		
		ВерсияФФД = ВерсияФФД(КассаККМЧека);
		
		ТекстЧека = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.СформироватьТекстНефискальногоЧека(ОбщиеПараметры, 34, ВерсияФФД);
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(ТекстЧека);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТекстовыйДокумент", ТекстовыйДокумент);
		ПараметрыФормы.Вставить("ДокументОснование", ДокументЧекиККМ);
		ПараметрыФормы.Вставить("НомерЧекаККМ", НомерЧекаККМ);

		Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		ОткрытьФорму("ОбщаяФорма.ФормаПросмотраЧекаККМ", ПараметрыФормы, , ,,,, Режим);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВерсияФФД(КассаККМЧека) Экспорт
	Возврат ПодключаемоеОборудованиеБГУ.ВерсияФФД(КассаККМЧека);	
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ОбновитьФормуSMSИEmail()
	
	Если ЗначениеЗаполнено(ДанныеSMSИлиEmail) Тогда
		Если ОтказПокупателяОтСохраненияДанных Тогда
			Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.НеСохранять16;
		Иначе
			Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.Сохранить16;
		КонецЕсли;
	Иначе
		Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.Пустая;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеДляПробитияЧека(НомерСтрокиСпискаЧеков)
	ОбщиеПараметры = Неопределено;
	
	ОбщиеПараметры  = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(ДокументЧекиККМ, ДокументЧекиККМ.Ссылка, НомерСтрокиСпискаЧеков);
	
	Возврат ОбщиеПараметры;
КонецФункции

&НаКлиенте
Процедура ПредставитьТелефонИEmailКлиент()
	
	Если ЗначениеЗаполнено(Телефон) Тогда
		Если ЗначениеЗаполнено(Телефон) Тогда
			Попытка
				СохраненныйТелефон = Число(Телефон);
			Исключение
				ТекстСообщения = НСтр("ru = 'Номер телефона для SMS указан некорректно. Следует изменить значение реквизита и повторить попытку.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,"Телефон");
				
				Возврат;
			КонецПопытки
		Иначе
			СохраненныйТелефон = 0;
		КонецЕсли;
		ТелефонЧислом = 0;
		ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(СохраненныйТелефон, Телефон, ТелефонСтрокой);
		ДанныеSMSИлиEmail = ТелефонСтрокой;
	ИначеЕсли ЗначениеЗаполнено(АдресЭП) Тогда
		ДанныеSMSИлиEmail = АдресЭП;
	Иначе
		ДанныеSMSИлиEmail = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СписокРеквизитовДокумента()
	
	Возврат "КассаККМ, Дата, Организация, КлючЧека, Сумма, ИспользоватьНастройкиПлатежногоАгента, СуммаПредоплаты, 
		|Контрагент, Плательщик, ТипРасчета, ПараметрыДоговораПлатежногоАгента, НомерСменыККМ, СуммаРеализации, 
		|СтатусЧекаККМ, СистемаНалогообложенияЧекаККМ, Телефон, АдресЭП, НомерЧекаККМ, ДатаЧекаККМ, ФискальныйПризнак,
		|ОтказКлиентаОтСохраненияТелефонаEmail, РодительскаяПлата, ВалютаРубли, ИспользуетсяККТСПередачейДанных,
		|НаправлятьПокупателямЭлектронныеЧеки, НеНаправлятьПокупателюЭлектронныйЧек, НомерСтрокиЧека, 
		|ИспользоватьКассуККМБезПодключенияОборудования, ДокументЧекиККМ, КомментарийКЧекуККМ, НеПробиватьЧекККМ, ВводДанныхЧекаВручную";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаДанныеЧекаККМ(Форма)
	ТекстЗаголовкаДанныхЧека = НСтр("ru='Подготовлен'");
	
	ИспользуетсяККТСПередачейДанных = Форма.ИспользуетсяККТСПередачейДанных;
	
	Если ИспользуетсяККТСПередачейДанных Тогда
		ТекстНомераЧека = НСтр("ru='Пробит ФД № '")+Формат(Форма.НомерЧекаККМ,"ЧГ=")+" от "+Формат(Форма.ДатаЧекаККМ,"ЧГ=; ДФ='dd.MM.yyyy hh:mm'")+", ФП: "+СокрЛП(Форма.ФискальныйПризнак);
	Иначе	
		ТекстНомераЧека = НСтр("ru='№ '")+Формат(Форма.НомерЧекаККМ,"ЧГ=");
	КонецЕсли;
	
	Если Форма.НомерЧекаККМ<>0 Тогда
		ТекстЗаголовкаДанныхЧека = ТекстНомераЧека;
	КонецЕсли;
	
	Форма.Заголовок = ТекстЗаголовкаДанныхЧека;
	
КонецПроцедуры	

&НаКлиенте
Процедура ОповещениеОткрытиеФормыВводаEmail(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		
		Если ЗначениеЗаполнено(РезультатОткрытияФормы.Email) Тогда
			АдресЭП = РезультатОткрытияФормы.Email;
			Телефон = "";
			ТелефонСтрокой = "";
			ДанныеSMSИлиEmail = АдресЭП;
			ОтказПокупателяОтСохраненияДанных = РезультатОткрытияФормы.ОтказКлиентаОтСохраненияEmail;
			
			ЗаписатьДополнительныеДанныеЧековККМ();
		Иначе
			АдресЭП = "";
			Телефон = "";
			Телефон = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытиеФормыВводаТелефона(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		
		Если ЗначениеЗаполнено(РезультатОткрытияФормы.ВведенноеЧисло) Тогда
			Телефон = 0;
			ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(РезультатОткрытияФормы.ВведенноеЧисло, Телефон, ТелефонСтрокой);
			Телефон = "7" + Формат(РезультатОткрытияФормы.ВведенноеЧисло, "ЧЦ=10; ЧДЦ=; ЧГ=0");
			АдресЭП = "";
			ДанныеSMSИлиEmail = ТелефонСтрокой;
			ОтказПокупателяОтСохраненияДанных = РезультатОткрытияФормы.ОтказКлиентаОтСохраненияТелефона;
			
			ЗаписатьДополнительныеДанныеЧековККМ();
		Иначе
			Телефон = 0;
			ТелефонСтрокой = "";
			АдресЭП = "";
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()

	НомерКассовогоЧека = ЭтаФорма.НомерЧекаККМ;
	СтатусЧекаККМПробит = ?(НомерКассовогоЧека<>0, Истина, Ложь);
	
	ВидимостьКнопкиПечатьЧекаККМ = Ложь;
	ЕстьЗаключительныйЧекИсправительный = Ложь;
	
	Если СтатусЧекаККМПробит Тогда
		ЗаключительныйЧекИсправительный = ЗаключительныйЧекИсправительный(ДокументЧекиККМ, НомерКассовогоЧека);
		Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
			ВидимостьКнопкиПечатьЧекаККМ = Истина;
			ЕстьЗаключительныйЧекИсправительный = Истина;
		Иначе
			ВидимостьКнопкиПечатьЧекаККМ = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаключительныйЧекИсправительный", 		"Видимость", ЕстьЗаключительныйЧекИсправительный);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Контрагент", "Видимость", ?(Плательщик = Контрагент, Ложь, Истина));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НеНаправлятьПокупателюЭлектронныйЧек", "Видимость", НаправлятьПокупателямЭлектронныеЧеки);
	
	ДоступностьРедактирования = ?(НомерЧекаККМ = 0, Истина, Ложь);
	Если ЕстьЗаключительныйЧекИсправительный ИЛИ ВводДанныхЧекаВручную ИЛИ НеПробиватьЧекККМ ИЛИ ЕстьДанныеДляСохранения Тогда
		ДоступностьРедактирования = Истина;	
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаЗаписатьИЗакрыть", "Видимость", ДоступностьРедактирования);
	Элементы.ФормаЗакрыть.КнопкаПоУмолчанию = НЕ ДоступностьРедактирования;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДанныеЧекаРучнойВвод", "Видимость", ЕстьПравоНастройкиККТ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НомерЧекаККМ", 
		"Видимость", ВводДанныхЧекаВручную);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДатаЧекаККМ", 
		"Видимость", ВводДанныхЧекаВручную);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтатусЧекаККМ", 
		"Видимость", ВводДанныхЧекаВручную);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПереданыйСписокНоменклатурыЧека(АдресСпискаНоменклатурыВХранилище)

	Если ЭтоАдресВременногоХранилища(АдресСпискаНоменклатурыВХранилище) Тогда
		ТаблицаНоменклатурыЧека = ПолучитьИзВременногоХранилища(АдресСпискаНоменклатурыВХранилище);
		НоменклатураЧекаККМ.Загрузить(ТаблицаНоменклатурыЧека);
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("РассчитыватьЦену", Ложь);
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
КонецПроцедуры

&НаСервере
Функция ПоместитьДанныеЧекаВХранилище()
	ДанныеЧека = Новый Структура;

	ДанныеЧека.Вставить("КлючЧека", КлючЧека);
	ДанныеЧека.Вставить("СистемаНалогообложенияЧекаККМ", СистемаНалогообложенияЧекаККМ);
	ДанныеЧека.Вставить("ПараметрыДоговораПлатежногоАгента", ПараметрыДоговораПлатежногоАгента);
	ДанныеЧека.Вставить("Телефон", Телефон);
	ДанныеЧека.Вставить("АдресЭП", АдресЭП);
	ДанныеЧека.Вставить("ОтказКлиентаОтСохраненияТелефонаEmail", ОтказПокупателяОтСохраненияДанных);
	ДанныеЧека.Вставить("НеНаправлятьПокупателюЭлектронныйЧек", НеНаправлятьПокупателюЭлектронныйЧек);
	ДанныеЧека.Вставить("НеПробиватьЧекККМ", НеПробиватьЧекККМ);
	ДанныеЧека.Вставить("КомментарийКЧекуККМ", КомментарийКЧекуККМ);
	ДанныеЧека.Вставить("ВводДанныхЧекаВручную", ВводДанныхЧекаВручную);
	ДанныеЧека.Вставить("НомерЧекаККМ", НомерЧекаККМ);
	ДанныеЧека.Вставить("ДатаЧекаККМ", ДатаЧекаККМ);
	ДанныеЧека.Вставить("СтатусЧекаККМ", СтатусЧекаККМ);
	
	НоменклатураЧека = НоменклатураЧекаККМ.Выгрузить();
	
	ДанныеЧека.Вставить("НоменклатураЧека", НоменклатураЧека);
	
	АдресДанныхЧекаВХранилище = ПоместитьВоВременноеХранилище(ДанныеЧека, УникальныйИдентификатор);

	Возврат АдресДанныхЧекаВХранилище;
	
КонецФункции

&НаСервере
Функция ВсеРеквизитыДляЧекаЗаполнены()
	Результат = Истина;
	
	ЕстьПустыеНаименованияТоваровУслуг = Ложь;
	ЕстьПустыеПредметыРасчетаТоваровУслуг = Ложь;
	НомераСтрокПустыхНаименований = "";
	НомераСтрокПустыхПредметовРасчета = "";
	
	Если ЗначениеЗаполнено(Телефон) Тогда
		Попытка
			СохраненныйТелефон = Число(Телефон);
		Исключение
			ТекстСообщения = НСтр("ru = 'Номер телефона для SMS указан некорректно. Следует изменить значение реквизита и повторить попытку.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,"Телефон");
			
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДокументЧекиККМ.Ответственный) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Ответственный""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
		
		Результат = Ложь;
	Иначе
		Если НЕ ЗначениеЗаполнено(ДокументЧекиККМ.Ответственный.ФизическоеЛицо) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Физическое лицо"" у реквизита ""Ответственный""!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
			
			Результат = Ложь;
		Иначе
			КассирККМ = ДокументЧекиККМ.Ответственный.ФизическоеЛицо;
			Если НЕ КассаККМ.НеПроверятьИННКассира Тогда
				Если СтрДлина(КассирККМ.ИНН)<12 Тогда
					ТекстСообщения = НСтр("ru = 'Не заполнен ИНН у реквизита ""Физическое лицо"" у реквизита ""Ответственный""!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
					
					Результат = Ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	НомерСтрЧека = 1;
	Для каждого ТекСтрока Из НоменклатураЧекаККМ Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			ЕстьПустыеНаименованияТоваровУслуг = Истина;
			НомераСтрокПустыхНаименований = НомераСтрокПустыхНаименований + СокрЛП(НомерСтрЧека)+", ";
		Иначе
			Если Не ЗначениеЗаполнено(ТекСтрока.Номенклатура.ПризнакПредметаРасчета) Тогда
				ЕстьПустыеПредметыРасчетаТоваровУслуг = Истина;
				НомераСтрокПустыхПредметовРасчета = НомераСтрокПустыхПредметовРасчета + СокрЛП(НомерСтрЧека)+", ";
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ПризнакСпособаРасчета) Тогда
			Если Не ЗначениеЗаполнено(ТекСтрока.ПризнакСпособаРасчета) Тогда
				ЕстьПустыеПредметыРасчетаТоваровУслуг = Истина;
				НомераСтрокПустыхПредметовРасчета = НомераСтрокПустыхПредметовРасчета + СокрЛП(НомерСтрЧека)+", ";
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Сумма) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Сумма"" в строке %1!'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомерСтрЧека);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "НоменклатураЧекаККМ");
			
			Результат = Ложь;
		КонецЕсли;
		
		НомерСтрЧека = НомерСтрЧека + 1;
	КонецЦикла;
	
	Если ЕстьПустыеНаименованияТоваровУслуг Тогда
		НомераСтрокПустыхНаименований = Сред(НомераСтрокПустыхНаименований, 0, СтрДлина(НомераСтрокПустыхНаименований)-2);
		Если НомераСтрокПустыхНаименований = "1" Тогда
			ТекстСообщения = НСтр("ru = 'В строке %1 списка номенклатуры кассового чека пустое наименование номенклатуры! 
			|Следует заполнить номенклатуру и повторить попытку!'");
		Иначе
			ТекстСообщения = НСтр("ru = 'В строках %1 списка номенклатуры кассового чека пустые наименования номенклатуры!
			|Следует заполнить номенклатуру и повторить попытку!'");
		КонецЕсли;	
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомераСтрокПустыхНаименований);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "НоменклатураЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
	
	Если ЕстьПустыеПредметыРасчетаТоваровУслуг Тогда
		НомераСтрокПустыхПредметовРасчета = Сред(НомераСтрокПустыхПредметовРасчета, 0, СтрДлина(НомераСтрокПустыхПредметовРасчета)-2);
		Если НомераСтрокПустыхПредметовРасчета = "1" Тогда
			ТекстСообщения = НСтр("ru = 'В строке %1 у номенклатуры не заполнен признак предмета расчета! 
			|Следует заполнить у номенклатуры реквизит ""Признак предмета расчета"" и повторить попытку!'");
		Иначе
			ТекстСообщения = НСтр("ru = 'В строках %1 списка номенклатуры не заполнен признак предмета расчета!
			|Следует заполнить у номенклатуры реквизит ""Признак предмета расчета"" и повторить попытку!'");
		КонецЕсли;	
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомераСтрокПустыхПредметовРасчета);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "НоменклатураЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
		
	Если НоменклатураЧекаККМ.Итог("Сумма")<>(Сумма + СуммаПостоплаты + СуммаПредоплаты) Тогда
		ТекстСообщения = НСтр("ru = 'Сумма номенклатуры не равна сумме оплаты!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Сумма");
		
		Результат = Ложь;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
        Возврат;
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда	
		ПеренестиВДокумент = Ложь;
		Модифицированность = Ложь;
		Закрыть();
    КонецЕсли;

КонецПроцедуры	

&НаСервере
Функция ЗаключительныйЧекИсправительный(ДокументСсылка, НомерЧекаККМ)
	
	Возврат ПодключаемоеОборудованиеБГУ.ЗаключительныйЧекИсправительный(ДокументСсылка, НомерЧекаККМ);

КонецФункции

&НаСервере
Процедура ВводДанныхЧекаВручнуюПриИзмененииНаСервере()
	ЕстьДанныеДляСохранения = Истина;
	
	УстановитьВидимостьЭлементовФормы();
КонецПроцедуры	

&НаСервере
Процедура ЗаписатьДополнительныеДанныеЧековККМ()
	ДополнительныеДанныеЧекаККМ = Новый Структура;
	ДополнительныеДанныеЧекаККМ.Вставить("ДокументОснование", ДокументЧекиККМ);
	ДополнительныеДанныеЧекаККМ.Вставить("Контрагент", ?(ЗначениеЗаполнено(Плательщик), Плательщик, Контрагент));
	ДополнительныеДанныеЧекаККМ.Вставить("АбонентскийНомерТелефона", Телефон);
	ДополнительныеДанныеЧекаККМ.Вставить("АдресЭлектроннойПочты", АдресЭП);
	ДополнительныеДанныеЧекаККМ.Вставить("ОтказПокупателяОтСохраненияДанных", ОтказПокупателяОтСохраненияДанных);
	
	ПодключаемоеОборудованиеБГУВызовСервера.ЗаписатьДополнительныеСведенияКассовогоЧека(ДополнительныеДанныеЧекаККМ, КлючЧека);	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДополнительныеДанныеЧековККМ()
	ДополнительныеСведенияКассовогоЧека = 
		ПодключаемоеОборудованиеБГУВызовСервера.ДополнительныеСведенияКассовогоЧека(ДокументЧекиККМ, КлючЧека);
		
	Если НЕ ЗначениеЗаполнено(Телефон) Тогда
		Телефон = ДополнительныеСведенияКассовогоЧека.АбонентскийНомерТелефона;
	КонецЕсли;
	Телефон = СтрЗаменить(Телефон, " ", "");
	Если НЕ ЗначениеЗаполнено(АдресЭП) Тогда
		АдресЭП = ДополнительныеСведенияКассовогоЧека.АдресЭлектроннойПочты;
	КонецЕсли;
	ОтказПокупателяОтСохраненияДанных = ДополнительныеСведенияКассовогоЧека.ОтказПокупателяОтСохраненияДанных;
	Если ОтказКлиентаОтСохраненияТелефонаEmail Тогда
		ОтказПокупателяОтСохраненияДанных = ОтказКлиентаОтСохраненияТелефонаEmail;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

