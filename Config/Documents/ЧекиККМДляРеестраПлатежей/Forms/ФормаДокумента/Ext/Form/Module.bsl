&НаКлиенте
Процедура Подключаемый_КомментарийСледующемуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийСледующемуНачалоВыбора(ЭтотОбъект, Элемент, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ИзменитьЗаголовкиЗакладок()

	Если Объект.ВидОперации = 0 Или Объект.ВидОперации = 4 Тогда
		Элементы.ГруппаПлатежиКонтрагентов.Заголовок = НСтр("ru='Платежи контрагентов'");
	ИначеЕсли Объект.ВидОперации = 1 Тогда
		Элементы.ГруппаПлатежиКонтрагентов.Заголовок = НСтр("ru='Удержания из заработной платы сотрудников'");
	ИначеЕсли Объект.ВидОперации = 2 Тогда
		Элементы.ГруппаПлатежиКонтрагентов.Заголовок = НСтр("ru='Расчеты с контрагентами'");
	ИначеЕсли Объект.ВидОперации = 3 Тогда
		Элементы.ГруппаПлатежиКонтрагентов.Заголовок = НСтр("ru='Передача контрагентам'");
		ЗаполнятьПоВсемДокументамРеализации = Ложь;
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСписокОтбораПоТипуДокумента()

	ОтборПоТипуДокумента.Очистить();
	
	ОтборПоТипуДокумента.Добавить(0, НСтр("ru='Начисление доходов'")								, Ложь);
	ОтборПоТипуДокумента.Добавить(1, НСтр("ru='Начисление за услуги образования'")					, Ложь);
	ОтборПоТипуДокумента.Добавить(2, НСтр("ru='Начисление учащимся за прочие услуги'")				, Ложь);
	ОтборПоТипуДокумента.Добавить(3, НСтр("ru='Начисление платы за услуги дошкольного учреждения'")	, Ложь);
	ОтборПоТипуДокумента.Добавить(4, НСтр("ru='Списание доходов будущих периодов'")					, Ложь);
	ОтборПоТипуДокумента.Добавить(5, НСтр("ru='Акт об оказании услуг'")								, Ложь);
	
	Если Объект.ОтборДокументыОснованияЧековККМ.Количество() = 0 Тогда
		Для каждого ТекСтрока Из ОтборПоТипуДокумента Цикл
			ТекСтрока.Пометка = Истина;
		КонецЦикла;
	Иначе	
		Для каждого ТекСтрока Из Объект.ОтборДокументыОснованияЧековККМ Цикл
			ОтборПоТипуДокумента[ТекСтрока.ТипДокументаОснования].Пометка = Истина;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СохранитьСписокОтбораПоТипуДокумента(ТекОбъект)
	
	ТекОбъект.ОтборДокументыОснованияЧековККМ.Очистить();
	Для каждого ТекСтрока Из ОтборПоТипуДокумента Цикл
		Если ТекСтрока.Пометка Тогда
			НоваяСтрока = ТекОбъект.ОтборДокументыОснованияЧековККМ.Добавить();
			НоваяСтрока.ТипДокументаОснования = ТекСтрока.Значение;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ВидОперацииПриИзмененииНаСервере()
	УстановитьВидимостьЭлементовФормы();
	ИзменитьЗаголовкиЗакладок();
	УстановитьДанныеДляПечатиЧековККМ();
	
	Если НЕ ЗначениеЗаполнено(Объект.НачалоРасчетногоПериода) Тогда
		Если Объект.ВидОперации = 3 Тогда
			Объект.НачалоРасчетногоПериода = НачалоДня(Объект.Дата);
		Иначе	
			Объект.НачалоРасчетногоПериода = НачалоМесяца(Объект.Дата);
		КонецЕсли;	
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Объект.ОкончаниеРасчетногоПериода) Тогда
		Если Объект.ВидОперации = 3 Тогда
			Объект.ОкончаниеРасчетногоПериода = КонецДня(Объект.Дата);
		Иначе	
			Объект.ОкончаниеРасчетногоПериода = КонецМесяца(Объект.Дата);
		КонецЕсли;	
	КонецЕсли;
	
	Если Объект.ВидОперации = 1 Тогда
		Объект.ФормироватьЧекиПоКаждомуПлатежуРеестра = Ложь;	
		Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаДокументыОснованияУдержанияИзЗаработнойПлаты;
	ИначеЕсли Объект.ВидОперации = 2 Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаДокументыОснованияРеализацииГруппыКонтрагентов;
	ИначеЕсли Объект.ВидОперации = 3 Тогда
		Если Параметры.Ключ.Пустая() Тогда
			Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаДокументыОснованияУдержанияИзЗаработнойПлаты;
		Иначе
			Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаПлатежиКонтрагентов;
		КонецЕсли;
		Объект.ЗаполнятьПредоплатуИАвансыПоДаннымДокументов = Ложь;
		ЗаполнятьПоВсемДокументамРеализации = Ложь;
	ИначеЕсли Объект.ВидОперации = 4 Тогда
		Объект.ФормироватьЧекиПоКаждомуПлатежуРеестра = Истина;
	Иначе
		Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаПлатежиКонтрагентов;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Объект["НачалоРасчетногоПериода"]	= РезультатВыбора["НачалоПериода"];
		Объект["ОкончаниеРасчетногоПериода"]	= РезультатВыбора["КонецПериода"];
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДокументовРасчетаССотрудникамиНаСервере(ЗаполнятьБезУчетаПризнакаОплатаВстречнымПредоставлением = Ложь)
	
	Если НЕ ЗначениеЗаполнено(Объект.НачалоРасчетногоПериода) Тогда
		ТекстСообщения = НСтр("ru='Значение поля ""Начало расчетного периода"" не не заполнено. Список документов не может быть заполнен.'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.НачалоРасчетногоПериода");
		
		Возврат;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.ОкончаниеРасчетногоПериода) Тогда
		ТекстСообщения = НСтр("ru='Значение поля ""Окончание расчетного периода"" не не заполнено. Список документов не может быть заполнен.'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ОкончаниеРасчетногоПериода");
		
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ТекстСообщения = НСтр("ru='Значение поля ""Касса ККМ"" не не заполнено. Список документов не может быть заполнен.'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
		
		Возврат;
	КонецЕсли;
	
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.КассаККМ, "ПризнакСпособаРасчетаДляДокументаОснованияЧекаККМ");
	ПризнакСпособаРасчетаПоУмолчанию = СтруктураДанных.ПризнакСпособаРасчетаДляДокументаОснованияЧекаККМ;
	Если ЗначениеЗаполнено(ПризнакСпособаРасчетаПоУмолчанию) Тогда
		ПризнакСпособаРасчета = ПризнакСпособаРасчетаПоУмолчанию;
	Иначе			
		ПризнакСпособаРасчета = ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ОплатаКредита");
	КонецЕсли;
	
	КонтрагентыСотрудники = КонтрагентыСотрудники();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АктОбОказанииУслуг.Ссылка КАК Ссылка,
	               |	АктОбОказанииУслуг.Контрагент КАК Контрагент,
	               |	&ПризнакСпособаРасчетаПоУмолчанию КАК ПризнакСпособаРасчетаПоУмолчанию
	               |ПОМЕСТИТЬ ДокументыРеализации
	               |ИЗ
	               |	Документ.АктОбОказанииУслуг КАК АктОбОказанииУслуг
	               |ГДЕ
	               |	АктОбОказанииУслуг.ПометкаУдаления = ЛОЖЬ
	               |	И АктОбОказанииУслуг.Дата МЕЖДУ &ДатаНачалаПериода И &ДатаОкончанияПериода
	               |	И АктОбОказанииУслуг.Организация = &Организация
	               |	И АктОбОказанииУслуг.Контрагент В(&КонтрагентыСотрудники)
	               |	И (АктОбОказанииУслуг.ОплатаВстречнымПредоставлением = &УсловиеЗаполненияДокументамиРеализации
	               |			ИЛИ АктОбОказанииУслуг.ОплатаВстречнымПредоставлением = ИСТИНА)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КвитанцияНаОплатуГосуслуг.Ссылка,
	               |	КвитанцияНаОплатуГосуслуг.Плательщик,
	               |	&ПризнакСпособаРасчетаПоУмолчанию
	               |ИЗ
	               |	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
	               |ГДЕ
	               |	КвитанцияНаОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ
	               |	И КвитанцияНаОплатуГосуслуг.Дата МЕЖДУ &ДатаНачалаПериода И &ДатаОкончанияПериода
	               |	И КвитанцияНаОплатуГосуслуг.Организация = &Организация
	               |	И КвитанцияНаОплатуГосуслуг.Плательщик В(&КонтрагентыСотрудники)
	               |	И (КвитанцияНаОплатуГосуслуг.ОплатаВстречнымПредоставлением = &УсловиеЗаполненияДокументамиРеализации
	               |			ИЛИ КвитанцияНаОплатуГосуслуг.ОплатаВстречнымПредоставлением = ИСТИНА)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НакладнаяНаОтпускМ15.Ссылка,
	               |	НакладнаяНаОтпускМ15.Контрагент,
	               |	&ПризнакСпособаРасчетаПоУмолчанию
	               |ИЗ
	               |	Документ.НакладнаяНаОтпускМ15 КАК НакладнаяНаОтпускМ15
	               |ГДЕ
	               |	НакладнаяНаОтпускМ15.ПометкаУдаления = ЛОЖЬ
	               |	И НакладнаяНаОтпускМ15.Дата МЕЖДУ &ДатаНачалаПериода И &ДатаОкончанияПериода
	               |	И НакладнаяНаОтпускМ15.Организация = &Организация
	               |	И НакладнаяНаОтпускМ15.Контрагент В(&КонтрагентыСотрудники)
	               |	И (НакладнаяНаОтпускМ15.ОплатаВстречнымПредоставлением = &УсловиеЗаполненияДокументамиРеализации
	               |			ИЛИ НакладнаяНаОтпускМ15.ОплатаВстречнымПредоставлением = ИСТИНА)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НакладнаяНаРеализациюТорг12.Ссылка,
	               |	НакладнаяНаРеализациюТорг12.Контрагент,
	               |	&ПризнакСпособаРасчетаПоУмолчанию
	               |ИЗ
	               |	Документ.НакладнаяНаРеализациюТорг12 КАК НакладнаяНаРеализациюТорг12
	               |ГДЕ
	               |	НакладнаяНаРеализациюТорг12.ПометкаУдаления = ЛОЖЬ
	               |	И НакладнаяНаРеализациюТорг12.Дата МЕЖДУ &ДатаНачалаПериода И &ДатаОкончанияПериода
	               |	И НакладнаяНаРеализациюТорг12.Организация = &Организация
	               |	И НакладнаяНаРеализациюТорг12.Контрагент В(&КонтрагентыСотрудники)
	               |	И (НакладнаяНаРеализациюТорг12.ОплатаВстречнымПредоставлением = &УсловиеЗаполненияДокументамиРеализации
	               |			ИЛИ НакладнаяНаРеализациюТорг12.ОплатаВстречнымПредоставлением = ИСТИНА)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДокументыРеализации.Ссылка КАК ДокументОснованиеЧекаККМ,
	               |	ДокументыРеализации.Контрагент КАК Контрагент,
	               |	ДокументыРеализации.ПризнакСпособаРасчетаПоУмолчанию КАК ПризнакСпособаРасчета,
	               |	ДокументыРеализации.Ссылка.СуммаДокумента КАК Сумма
	               |ИЗ
	               |	ДокументыРеализации КАК ДокументыРеализации";
	
	Запрос.УстановитьПараметр("ДатаНачалаПериода", НачалоДня(Объект.НачалоРасчетногоПериода));
	Запрос.УстановитьПараметр("ДатаОкончанияПериода", КонецДня(Объект.ОкончаниеРасчетногоПериода));
	Запрос.УстановитьПараметр("ПризнакСпособаРасчетаПоУмолчанию", ПризнакСпособаРасчета);
	Запрос.УстановитьПараметр("ДатаЧекаККМ", Объект.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("КонтрагентыСотрудники", КонтрагентыСотрудники);
	Запрос.УстановитьПараметр("УсловиеЗаполненияДокументамиРеализации",
		НЕ ЗаполнятьБезУчетаПризнакаОплатаВстречнымПредоставлением);
	
	ТаблицаДокументовРасчетов = Запрос.Выполнить().Выгрузить();
	
	Объект.ДокументыЧекаККМ.Загрузить(ТаблицаДокументовРасчетов);
	
	Если Объект.ЗаполнятьПредоплатуИАвансыПоДаннымДокументов Тогда
		ЗаполнитьПредоплатуПоДокументамОснованиямЧекаККМ();
		ЗаполнитьСуммуАвансовНаСервере();
	КонецЕсли;	
	
	Если Объект.ДляСпискаКонтрагентовПоРеализации Тогда
		ЗаполнитьСписокУдержанийПоДокументамРеализацииНаСервере();
	КонецЕсли;
	
	Если НЕ ЗаполнятьБезУчетаПризнакаОплатаВстречнымПредоставлением И Объект.ДокументыЧекаККМ.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не найдено документов реализации с включенным флажком ""Оплата встречным предоставлением""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыЧекаККМ");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДокументовНаПередачуДляСотрудниковНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.НачалоРасчетногоПериода) Тогда
		ТекстСообщения = НСтр("ru='Значение поля ""Начало расчетного периода"" не не заполнено. Список документов не может быть заполнен.'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.НачалоРасчетногоПериода");
		
		Возврат;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.ОкончаниеРасчетногоПериода) Тогда
		ТекстСообщения = НСтр("ru='Значение поля ""Окончание расчетного периода"" не не заполнено. Список документов не может быть заполнен.'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ОкончаниеРасчетногоПериода");
		
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ТекстСообщения = НСтр("ru='Значение поля ""Касса ККМ"" не не заполнено. Список документов не может быть заполнен.'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
		
		Возврат;
	КонецЕсли;
	
	ПризнакСпособаРасчета = ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ПередачаБезОплаты");
	
	КонтрагентыСотрудники = КонтрагентыСотрудники();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АктОбОказанииУслуг.Ссылка КАК Ссылка,
	               |	АктОбОказанииУслуг.Контрагент КАК Контрагент,
	               |	&ПризнакСпособаРасчетаПоУмолчанию КАК ПризнакСпособаРасчетаПоУмолчанию
	               |ПОМЕСТИТЬ ДокументыРеализации
	               |ИЗ
	               |	Документ.АктОбОказанииУслуг КАК АктОбОказанииУслуг
	               |ГДЕ
	               |	АктОбОказанииУслуг.ПометкаУдаления = ЛОЖЬ
	               |	И АктОбОказанииУслуг.Дата МЕЖДУ &ДатаНачалаПериода И &ДатаОкончанияПериода
	               |	И АктОбОказанииУслуг.Организация = &Организация
	               |	И АктОбОказанииУслуг.Контрагент В(&КонтрагентыСотрудники)
	               |	И АктОбОказанииУслуг.ОплатаВстречнымПредоставлением = ИСТИНА
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КвитанцияНаОплатуГосуслуг.Ссылка,
	               |	КвитанцияНаОплатуГосуслуг.Плательщик,
	               |	&ПризнакСпособаРасчетаПоУмолчанию
	               |ИЗ
	               |	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
	               |ГДЕ
	               |	КвитанцияНаОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ
	               |	И КвитанцияНаОплатуГосуслуг.Дата МЕЖДУ &ДатаНачалаПериода И &ДатаОкончанияПериода
	               |	И КвитанцияНаОплатуГосуслуг.Организация = &Организация
	               |	И КвитанцияНаОплатуГосуслуг.Плательщик В(&КонтрагентыСотрудники)
	               |	И КвитанцияНаОплатуГосуслуг.ОплатаВстречнымПредоставлением = ИСТИНА
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НакладнаяНаОтпускМ15.Ссылка,
	               |	НакладнаяНаОтпускМ15.Контрагент,
	               |	&ПризнакСпособаРасчетаПоУмолчанию
	               |ИЗ
	               |	Документ.НакладнаяНаОтпускМ15 КАК НакладнаяНаОтпускМ15
	               |ГДЕ
	               |	НакладнаяНаОтпускМ15.ПометкаУдаления = ЛОЖЬ
	               |	И НакладнаяНаОтпускМ15.Дата МЕЖДУ &ДатаНачалаПериода И &ДатаОкончанияПериода
	               |	И НакладнаяНаОтпускМ15.Организация = &Организация
	               |	И НакладнаяНаОтпускМ15.Контрагент В(&КонтрагентыСотрудники)
	               |	И НакладнаяНаОтпускМ15.ОплатаВстречнымПредоставлением = ИСТИНА
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НакладнаяНаРеализациюТорг12.Ссылка,
	               |	НакладнаяНаРеализациюТорг12.Контрагент,
	               |	&ПризнакСпособаРасчетаПоУмолчанию
	               |ИЗ
	               |	Документ.НакладнаяНаРеализациюТорг12 КАК НакладнаяНаРеализациюТорг12
	               |ГДЕ
	               |	НакладнаяНаРеализациюТорг12.ПометкаУдаления = ЛОЖЬ
	               |	И НакладнаяНаРеализациюТорг12.Дата МЕЖДУ &ДатаНачалаПериода И &ДатаОкончанияПериода
	               |	И НакладнаяНаРеализациюТорг12.Организация = &Организация
	               |	И НакладнаяНаРеализациюТорг12.Контрагент В(&КонтрагентыСотрудники)
	               |	И НакладнаяНаРеализациюТорг12.ОплатаВстречнымПредоставлением = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДокументыРеализации.Ссылка КАК ДокументОснованиеЧекаККМ,
	               |	ДокументыРеализации.Контрагент КАК Контрагент,
	               |	ДокументыРеализации.ПризнакСпособаРасчетаПоУмолчанию КАК ПризнакСпособаРасчета,
	               |	ДокументыРеализации.Ссылка.СуммаДокумента КАК Сумма,
	               |	ЧекККМНаПередачуДокументыЧекаККМ.ДокументОснованиеЧекаККМ КАК ДокументОснованиеЧекаККМПриПередаче,
	               |	ЧекККМНаПередачуДокументыЧекаККМ.Ссылка КАК ЧекККМНаПередачу,
	               |	ЧекККМНаПередачуДокументыЧекаККМ.Ссылка.ПометкаУдаления КАК ЧекККМНаПередачуПометкаУдаления
	               |ПОМЕСТИТЬ РеализацииИЧекиНаПередачу
	               |ИЗ
	               |	ДокументыРеализации КАК ДокументыРеализации
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМНаПередачу.ДокументыЧекаККМ КАК ЧекККМНаПередачуДокументыЧекаККМ
	               |		ПО ДокументыРеализации.Ссылка = ЧекККМНаПередачуДокументыЧекаККМ.ДокументОснованиеЧекаККМ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РеализацииИЧекиНаПередачу.ДокументОснованиеЧекаККМ КАК ДокументОснованиеЧекаККМ,
	               |	РеализацииИЧекиНаПередачу.Контрагент КАК Контрагент,
	               |	РеализацииИЧекиНаПередачу.ПризнакСпособаРасчета КАК ПризнакСпособаРасчета,
	               |	РеализацииИЧекиНаПередачу.Сумма КАК Сумма
	               |ИЗ
	               |	РеализацииИЧекиНаПередачу КАК РеализацииИЧекиНаПередачу
	               |ГДЕ
	               |	(ЕСТЬNULL(РеализацииИЧекиНаПередачу.ЧекККМНаПередачу, 0) = 0
	               |			ИЛИ РеализацииИЧекиНаПередачу.ЧекККМНаПередачуПометкаУдаления = ИСТИНА)";
	
	Запрос.УстановитьПараметр("ДатаНачалаПериода", НачалоДня(Объект.НачалоРасчетногоПериода));
	Запрос.УстановитьПараметр("ДатаОкончанияПериода", КонецДня(Объект.ОкончаниеРасчетногоПериода));
	Запрос.УстановитьПараметр("ПризнакСпособаРасчетаПоУмолчанию", ПризнакСпособаРасчета);
	Запрос.УстановитьПараметр("ДатаЧекаККМ", Объект.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("КонтрагентыСотрудники", КонтрагентыСотрудники);
	
	ТаблицаДокументовРасчетов = Запрос.Выполнить().Выгрузить();
	
	Объект.ДокументыЧекаККМ.Загрузить(ТаблицаДокументовРасчетов);
	
	Если Объект.ДокументыЧекаККМ.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не найдено документов реализации с включенным флажком ""Оплата встречным предоставлением""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыЧекаККМ");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДанныеДляЧековККМПоСотрудникамНаСервере()
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Касса ККМ""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
			
		Возврат;		
	КонецЕсли;
	
	Если Объект.ДокументыЧекаККМ.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнены документы реализации на закладке ""Сведения о реализации"" для заполнения номенклатуры чеков ККМ!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыЧекаККМ");
			
		Возврат;		
	КонецЕсли;
	
	Объект.ЧекиККМ.Очистить();
	Объект.НоменклатураЧековККМ.Очистить();
	Объект.ТипЗаполненияЧеков = 3;
	
	СписокДокументовОснований = Объект.ДокументыЧекаККМ.Выгрузить();
	СписокПлательщиков = Объект.ПлатежиКонтрагентов.Выгрузить();
	
	ШапкаЧеков = Объект.ЧекиККМ.Выгрузить();
	НоменклатураЧеков = Объект.НоменклатураЧековККМ.Выгрузить();
	ДанныеЧеков = Новый Структура;
	ДанныеЧеков.Вставить("ШапкаЧеков", ШапкаЧеков);
	ДанныеЧеков.Вставить("НоменклатураЧеков", НоменклатураЧеков);
	
	СформироватьДанныеДляЧековККМПоСотрудникам(Объект.КассаККМ, СписокПлательщиков,
		СписокДокументовОснований, ДанныеЧеков, Объект.СистемаНалогообложенияЧекаККМ,
		Объект.НаправлятьПокупателямЭлектронныеЧеки);	
	
	Объект.ЧекиККМ.Загрузить(ДанныеЧеков.ШапкаЧеков);
	Объект.НоменклатураЧековККМ.Загрузить(ДанныеЧеков.НоменклатураЧеков);
	
	Если ИспользоватьНастройкиПлатежногоАгента Тогда
		Для каждого ТекСтрока Из Объект.ЧекиККМ Цикл
			Если НЕ ЗначениеЗаполнено(ТекСтрока.ПараметрыДоговораПлатежногоАгента)
				И НЕ Объект.РодительскаяПлата Тогда
					ТекСтрока.ПараметрыДоговораПлатежногоАгента = ПараметрыДоговораПлатежногоАгента;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
	ЗаполнитьДанныеДляНаправленияПокупателямЭлектронныхЧеков();
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

