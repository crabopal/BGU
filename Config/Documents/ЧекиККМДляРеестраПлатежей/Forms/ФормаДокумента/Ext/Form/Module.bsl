&НаСервере
Функция СуммаДокументаЧекаККМ(ДокументСсылкаЧекаККМ)
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылкаЧекаККМ, "СуммаДокумента");
	
	Возврат СтруктураДанных.СуммаДокумента;
КонецФункции	

&НаСервере
Процедура СформироватьДанныеДляЧековККМПоСотрудникам(КассаККМ, СписокПлательщиков, СписокДокументовОснований,
	 ДанныеЧеков, СистемаНалогообложения, НаправлятьПокупателямЭлектронныеЧеки)
	 
	СведенияОПризнакахСпособаРасчета = Новый ТаблицаЗначений;
	СведенияОПризнакахСпособаРасчета.Колонки.Добавить("ДокументОснованиеЧекаККМ", Документы.ТипВсеСсылки());
	СведенияОПризнакахСпособаРасчета.Колонки.Добавить("ПризнакСпособаРасчета", Новый ОписаниеТипов("ПеречислениеСсылка.ПризнакиСпособаРасчета"));
	 
	Для каждого ТекКонтрагент Из СписокПлательщиков Цикл
		ПараметрыОтбораКонтрагента = Новый Структура("Контрагент", ТекКонтрагент.Контрагент);
		
		НоваяШапка = ДанныеЧеков.ШапкаЧеков.Добавить();
		КлючЧека = Новый УникальныйИдентификатор;
		НоваяШапка.КлючЧека = КлючЧека;
		НоваяШапка.Контрагент = ТекКонтрагент.Контрагент;
		НоваяШапка.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
		НоваяШапка.Сумма = ТекКонтрагент.Сумма;
		НоваяШапка.СуммаПредоплаты = ТекКонтрагент.СуммаПредоплаты;
		НоваяШапка.СуммаРеализации = ТекКонтрагент.СуммаРеализации;
		НоваяШапка.СистемаНалогообложенияЧекаККМ = СистемаНалогообложения;
		НоваяШапка.Плательщик = ТекКонтрагент.Плательщик;
		
		НайденныеСтроки = СписокДокументовОснований.НайтиСтроки(ПараметрыОтбораКонтрагента);
		
		НоменклатураДляСпискаДокументов = Неопределено;
		Если НайденныеСтроки.Количество()>0 Тогда
			СведенияОПризнакахСпособаРасчета.Очистить();
			Для каждого ТекСведения Из НайденныеСтроки Цикл
				Если ТекСведения.Сумма <> (ТекСведения.СуммаПредоплаты + ТекСведения.СуммаАванса) Тогда
					НоваяСтрокаДокЧека = СведенияОПризнакахСпособаРасчета.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаДокЧека, ТекСведения);
				КонецЕсли;
			КонецЦикла;	
			
			НоменклатураДляСпискаДокументов = ПодключаемоеОборудованиеБГУ.ТаблицаНоменклатурыЧекаККМДляДокументовОснований(СведенияОПризнакахСпособаРасчета);
		КонецЕсли;
		
		СуммаНоменклатуры = 0;
		Если НЕ НоменклатураДляСпискаДокументов = Неопределено Тогда
			Для Каждого СтрокаНоменклатурыЧека Из НоменклатураДляСпискаДокументов Цикл
				НоваяНоменклатура = ДанныеЧеков.НоменклатураЧеков.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяНоменклатура, СтрокаНоменклатурыЧека);
				НоваяНоменклатура.КлючЧека = КлючЧека;
				НоваяНоменклатура.Сумма = СтрокаНоменклатурыЧека.Всего;
				НоваяНоменклатура.ДополнениеНаименованияНоменклатуры = СтрокаНоменклатурыЧека.СодержаниеУслуги;
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура СформироватьДанныеДляЧековККМНаПередачуПоСотрудникам(КассаККМ, СписокПлательщиков, СписокДокументовОснований,
	 ДанныеЧеков, СистемаНалогообложения, НаправлятьПокупателямЭлектронныеЧеки)
	 
	СведенияОПризнакахСпособаРасчета = Новый ТаблицаЗначений;
	СведенияОПризнакахСпособаРасчета.Колонки.Добавить("ДокументОснованиеЧекаККМ", Документы.ТипВсеСсылки());
	СведенияОПризнакахСпособаРасчета.Колонки.Добавить("ПризнакСпособаРасчета", Новый ОписаниеТипов("ПеречислениеСсылка.ПризнакиСпособаРасчета"));
	 
	Для каждого ТекСведения Из СписокДокументовОснований Цикл
		КлючЧека = Новый УникальныйИдентификатор;
		
		НоваяШапка = ДанныеЧеков.ШапкаЧеков.Добавить();
		
		НоваяШапка.КлючЧека = КлючЧека;
		НоваяШапка.Контрагент = ТекСведения.Контрагент;
		НоваяШапка.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
		НоваяШапка.Сумма = 0;
		НоваяШапка.СуммаПредоплаты = ТекСведения.СуммаПредоплаты;
		НоваяШапка.СуммаРеализации = ТекСведения.Сумма;
		НоваяШапка.СистемаНалогообложенияЧекаККМ = СистемаНалогообложения;
		НоваяШапка.Плательщик = ТекСведения.Контрагент;
		
		НоваяСтрока = Объект.ПлатежиКонтрагентов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСведения);
		НоваяСтрока.КлючСтроки = КлючЧека;
		НоваяСтрока.СуммаРеализации = ТекСведения.Сумма;
		НоваяСтрока.Плательщик = ТекСведения.Контрагент;
		НоваяСтрока.Договор = ТекСведения.ДокументОснованиеЧекаККМ.Договор;
		
		СведенияОПризнакахСпособаРасчета.Очистить();
		НоваяСтрокаДокЧека = СведенияОПризнакахСпособаРасчета.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаДокЧека, ТекСведения);
		НоменклатураДляСпискаДокументов = ПодключаемоеОборудованиеБГУ.ТаблицаНоменклатурыЧекаККМДляДокументовОснований(СведенияОПризнакахСпособаРасчета);
		
		СуммаНоменклатуры = 0;
		Если НЕ НоменклатураДляСпискаДокументов = Неопределено Тогда
			Для Каждого СтрокаНоменклатурыЧека Из НоменклатураДляСпискаДокументов Цикл
				НоваяНоменклатура = ДанныеЧеков.НоменклатураЧеков.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяНоменклатура, СтрокаНоменклатурыЧека);
				НоваяНоменклатура.КлючЧека = КлючЧека;
				НоваяНоменклатура.Сумма = СтрокаНоменклатурыЧека.Всего;
				НоваяНоменклатура.ДополнениеНаименованияНоменклатуры = СтрокаНоменклатурыЧека.СодержаниеУслуги;
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСписокДокументовОтражениеЗарплатыВУчетеНаСервере()
	Если НЕ ЗначениеЗаполнено(Объект.НачалоРасчетногоПериода) Тогда
		ТекстСообщения = НСтр("ru='Значение поля ""Начало расчетного периода"" не не заполнено. Список документов не может быть заполнен.'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.НачалоРасчетногоПериода");
		
		Возврат;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.ОкончаниеРасчетногоПериода) Тогда
		ТекстСообщения = НСтр("ru='Значение поля ""Окончание расчетного периода"" не не заполнено. Список документов не может быть заполнен.'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ОкончаниеРасчетногоПериода");
		
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОтражениеЗарплатыВУчете.Ссылка КАК ОтражениеЗарплатыВУчете
	               |ИЗ
	               |	Документ.ОтражениеЗарплатыВУчете КАК ОтражениеЗарплатыВУчете
	               |ГДЕ
	               |	ОтражениеЗарплатыВУчете.Организация = &Организация
	               |	И ОтражениеЗарплатыВУчете.Дата МЕЖДУ &ДатаНачалаПериода И &ДатаОкончанияПериода";

	Запрос.УстановитьПараметр("ДатаНачалаПериода", НачалоДня(Объект.НачалоРасчетногоПериода));
	Запрос.УстановитьПараметр("ДатаОкончанияПериода", КонецДня(Объект.ОкончаниеРасчетногоПериода));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	СсылкиОтражениеЗарплатыВУчете = Запрос.Выполнить().Выгрузить();
	Объект.ОтраженияЗарплатыВУчете.Загрузить(СсылкиОтражениеЗарплатыВУчете);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокУдержанийПоОтражениямЗарплатыВУчетеНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЧекиККМДляРеестраПлатежейСведенияОбУдержанияхИзЗарплаты.Контрагент КАК Контрагент
	               |ПОМЕСТИТЬ УволенныеУжеРассчитанныеСотрудникиКонтрагенты
	               |ИЗ
	               |	Документ.ЧекиККМДляРеестраПлатежей.СведенияОбУдержанияхИзЗарплаты КАК ЧекиККМДляРеестраПлатежейСведенияОбУдержанияхИзЗарплаты
	               |ГДЕ
	               |	ЧекиККМДляРеестраПлатежейСведенияОбУдержанияхИзЗарплаты.Ссылка.ВидОперации = 1
	               |	И ЧекиККМДляРеестраПлатежейСведенияОбУдержанияхИзЗарплаты.Ссылка.ДляСпискаКонтрагентовПоРеализации = ИСТИНА
	               |	И ЧекиККМДляРеестраПлатежейСведенияОбУдержанияхИзЗарплаты.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И ЧекиККМДляРеестраПлатежейСведенияОбУдержанияхИзЗарплаты.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОтражениеЗарплатыВУчетеОперации.Контрагент КАК Контрагент,
	               |	ОтражениеЗарплатыВУчетеОперации.Сумма КАК Сумма,
	               |	УволенныеУжеРассчитанныеСотрудникиКонтрагенты.Контрагент КАК КонтрагентУволенный
	               |ИЗ
	               |	Документ.ОтражениеЗарплатыВУчете.Операции КАК ОтражениеЗарплатыВУчетеОперации
	               |		ЛЕВОЕ СОЕДИНЕНИЕ УволенныеУжеРассчитанныеСотрудникиКонтрагенты КАК УволенныеУжеРассчитанныеСотрудникиКонтрагенты
	               |		ПО ОтражениеЗарплатыВУчетеОперации.Контрагент = УволенныеУжеРассчитанныеСотрудникиКонтрагенты.Контрагент
	               |ГДЕ
	               |	ОтражениеЗарплатыВУчетеОперации.Ссылка В(&СписокДокументовОтраженияЗП)
	               |	И ОтражениеЗарплатыВУчетеОперации.ЯвляетсяОснованиемОформленияКассовогоЧека = ИСТИНА
	               |	И УволенныеУжеРассчитанныеСотрудникиКонтрагенты.Контрагент ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("СписокДокументовОтраженияЗП", Объект.ОтраженияЗарплатыВУчете.Выгрузить().ВыгрузитьКолонку("ОтражениеЗарплатыВУчете"));
	Запрос.УстановитьПараметр("ДатаНачала", Объект.НачалоРасчетногоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания", Объект.ОкончаниеРасчетногоПериода);
	
	СведенияОбУдержаниях = Запрос.Выполнить().Выгрузить();
	Объект.СведенияОбУдержанияхИзЗарплаты.Загрузить(СведенияОбУдержаниях);
	
	СписокКонтрагентов = СведенияОбУдержаниях;
	СписокКонтрагентов.Колонки.Добавить("КлючСтроки", Новый ОписаниеТипов("Строка"));
	СписокКонтрагентов.Колонки.Добавить("Плательщик", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	СписокКонтрагентов.Колонки.Добавить("СуммаПредоплаты", Новый ОписаниеТипов("Число"));
	СписокКонтрагентов.Колонки.Добавить("СуммаРеализации", Новый ОписаниеТипов("Число"));
	
	СписокДокументовИКонтрагентов = Новый ТаблицаЗначений;
	СписокДокументовИКонтрагентов.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	СписокДокументовИКонтрагентов.Колонки.Добавить("СуммаПредоплаты", Новый ОписаниеТипов("Число"));
	СписокДокументовИКонтрагентов.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	
	Для каждого ТекСтрока Из Объект.ДокументыЧекаККМ Цикл
		Если ТекСтрока.Сумма > ТекСтрока.СуммаПредоплаты Тогда
			НоваяСтрока = СписокДокументовИКонтрагентов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.СуммаПредоплаты = ТекСтрока.СуммаПредоплаты + ТекСтрока.СуммаАванса;
		КонецЕсли;
	КонецЦикла;	
	
	сч = 1;
	Для каждого ТекСтрока Из СписокКонтрагентов Цикл
		ТекСтрока.КлючСтроки = Новый УникальныйИдентификатор;	
		ТекСтрока.Плательщик = ТекСтрока.Контрагент;
		
		ПараметрыОтбораКонтрагента = Новый Структура("Контрагент", ТекСтрока.Контрагент);
		НайденныеСтроки = СписокДокументовИКонтрагентов.НайтиСтроки(ПараметрыОтбораКонтрагента);
		Если НайденныеСтроки.Количество()>0 Тогда
			ТекСтрока.СуммаПредоплаты = НайденныеСтроки[0].СуммаПредоплаты;
			ТекСтрока.СуммаРеализации = НайденныеСтроки[0].Сумма;
		Иначе	
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
				"ru='Для контрагента %1 в строке %2 не найден документ реализации.'"),
				ТекСтрока.Контрагент, сч);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		сч = сч + 1;
	КонецЦикла;
	
	Объект.ПлатежиКонтрагентов.Загрузить(СписокКонтрагентов);
	
	ЗаполнитьДанныеДляНаправленияПокупателямЭлектронныхЧеков();
	
	ПодготовитьФормуНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокУдержанийПоДокументамРеализацииНаСервере()
	СписокДокументовИКонтрагентов = Объект.ДокументыЧекаККМ.Выгрузить();
	СписокКонтрагентов = Объект.ДокументыЧекаККМ.Выгрузить();
	СписокКонтрагентов.Свернуть("Контрагент", "Сумма");
	СписокКонтрагентов.Колонки.Добавить("КлючСтроки", Новый ОписаниеТипов("Строка"));
	СписокКонтрагентов.Колонки.Добавить("Плательщик", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	СписокКонтрагентов.Колонки.Добавить("СуммаПредоплаты", Новый ОписаниеТипов("Число"));
	СписокКонтрагентов.Колонки.Добавить("СуммаРеализации", Новый ОписаниеТипов("Число"));
	
	СписокДокументовИКонтрагентов = Новый ТаблицаЗначений;
	СписокДокументовИКонтрагентов.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	СписокДокументовИКонтрагентов.Колонки.Добавить("СуммаПредоплаты", Новый ОписаниеТипов("Число"));
	СписокДокументовИКонтрагентов.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	
	Для каждого ТекСтрока Из Объект.ДокументыЧекаККМ Цикл
		Если ТекСтрока.Сумма > ТекСтрока.СуммаПредоплаты + ТекСтрока.СуммаАванса Тогда
			НоваяСтрока = СписокДокументовИКонтрагентов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.СуммаПредоплаты = ТекСтрока.СуммаПредоплаты + ТекСтрока.СуммаАванса;
		КонецЕсли;
	КонецЦикла;	
	
	Для каждого ТекСтрока Из СписокКонтрагентов Цикл
		ТекСтрока.КлючСтроки = Новый УникальныйИдентификатор;	
		ТекСтрока.Плательщик = ТекСтрока.Контрагент;
	КонецЦикла;
	
	СписокДокументовИКонтрагентов.Свернуть("Контрагент", "Сумма, СуммаПредоплаты");
	
	сч = 1;
	Для каждого ТекСтрока Из СписокКонтрагентов Цикл
		ТекСтрока.КлючСтроки = Новый УникальныйИдентификатор;	
		ТекСтрока.Плательщик = ТекСтрока.Контрагент;
		
		ПараметрыОтбораКонтрагента = Новый Структура("Контрагент", ТекСтрока.Контрагент);
		НайденныеСтроки = СписокДокументовИКонтрагентов.НайтиСтроки(ПараметрыОтбораКонтрагента);
		Если НайденныеСтроки.Количество()>0 Тогда
			ТекСтрока.СуммаПредоплаты = НайденныеСтроки[0].СуммаПредоплаты;
			ТекСтрока.СуммаРеализации = НайденныеСтроки[0].Сумма;
			ТекСтрока.Сумма = ТекСтрока.СуммаРеализации - ТекСтрока.СуммаПредоплаты;
		Иначе	
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
				"ru='Для контрагента %1 в строке %2 не найден документ реализации.'"),
				ТекСтрока.Контрагент, сч);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		сч = сч + 1;
	КонецЦикла;
	
	Объект.ПлатежиКонтрагентов.Загрузить(СписокКонтрагентов);
	
	ЗаполнитьДанныеДляНаправленияПокупателямЭлектронныхЧеков();
	
	ПодготовитьФормуНаСервере();
КонецПроцедуры

&НаСервере
Функция КонтрагентыСотрудники()
	Результат = Новый Массив;
	Если Объект.ДляСпискаКонтрагентовПоРеализации Тогда
		Результат = Объект.СведенияОбУдержанияхИзЗарплаты.Выгрузить(,"Контрагент");
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ЧекиККМДляРеестраПлатежейСведенияОбУдержанияхИзЗарплаты.Контрагент КАК Контрагент
		               |ПОМЕСТИТЬ УволенныеУжеРассчитанныеСотрудникиКонтрагенты
		               |ИЗ
		               |	Документ.ЧекиККМДляРеестраПлатежей.СведенияОбУдержанияхИзЗарплаты КАК ЧекиККМДляРеестраПлатежейСведенияОбУдержанияхИзЗарплаты
		               |ГДЕ
		               |	ЧекиККМДляРеестраПлатежейСведенияОбУдержанияхИзЗарплаты.Ссылка.ВидОперации = 1
		               |	И ЧекиККМДляРеестраПлатежейСведенияОбУдержанияхИзЗарплаты.Ссылка.ДляСпискаКонтрагентовПоРеализации = ИСТИНА
		               |	И ЧекиККМДляРеестраПлатежейСведенияОбУдержанияхИзЗарплаты.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		               |	И ЧекиККМДляРеестраПлатежейСведенияОбУдержанияхИзЗарплаты.Ссылка.ПометкаУдаления = ЛОЖЬ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	Сотрудники.Контрагент КАК Контрагент,
		               |	УволенныеУжеРассчитанныеСотрудникиКонтрагенты.Контрагент КАК КонтрагентУволенный
		               |ИЗ
		               |	Справочник.Сотрудники КАК Сотрудники
		               |		ЛЕВОЕ СОЕДИНЕНИЕ УволенныеУжеРассчитанныеСотрудникиКонтрагенты КАК УволенныеУжеРассчитанныеСотрудникиКонтрагенты
		               |		ПО Сотрудники.Контрагент = УволенныеУжеРассчитанныеСотрудникиКонтрагенты.Контрагент
		               |ГДЕ
		               |	Сотрудники.ПометкаУдаления = ЛОЖЬ
		               |	И УволенныеУжеРассчитанныеСотрудникиКонтрагенты.Контрагент ЕСТЬ NULL";
		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Объект.НачалоРасчетногоПериода));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Объект.ОкончаниеРасчетногоПериода));
		
		Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Контрагент");
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция СуммаПредоплатыПоДокументам(ДатаСведений, ТаблицаДокументовОснованийЧекаККМ)

	Результат = ПодключаемоеОборудованиеБГУ.СуммаПредоплатыПоДокументам(ДатаСведений, ТаблицаДокументовОснованийЧекаККМ);
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция СуммаАвансаПоКонтрагенту(ДатаНачала, ДатаСведений, Контрагенты)

	Результат = ПодключаемоеОборудованиеБГУ.СуммаАвансаПоКонтрагенту(ДатаНачала, ДатаСведений, Контрагенты);
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ЗаполнитьПредоплатуПоДокументамОснованиямЧекаККМ()
	СписокДокументовОснованийЧекаККМ = Объект.ДокументыЧекаККМ.Выгрузить();
	СписокКонтрагентов = СписокДокументовОснованийЧекаККМ.ВыгрузитьКолонку("Контрагент");
	СписокДокументовОснованийЧекаККМ.Свернуть("ДокументОснованиеЧекаККМ", "СуммаПредоплаты");
	
	ДатаСведений = Объект.Дата;
	
	ВыборкаДанныхОПредоплате = СуммаПредоплатыПоДокументам(ДатаСведений, СписокДокументовОснованийЧекаККМ);
	
	Для каждого ТекСтрока Из ВыборкаДанныхОПредоплате Цикл
		ПараметрыОтбораДокумента = Новый Структура("ДокументОснованиеЧекаККМ", ТекСтрока.ДокументОснованиеЧекаККМ);
		НайденныеСтроки = Объект.ДокументыЧекаККМ.НайтиСтроки(ПараметрыОтбораДокумента);
		Если НайденныеСтроки.Количество()>0 Тогда
			НайденныеСтроки[0].СуммаПредоплаты = ТекСтрока.СуммаПредоплаты;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСуммуАвансовНаСервере()
	СписокДокументовОснованийЧекаККМ = Объект.ДокументыЧекаККМ.Выгрузить();
	СписокКонтрагентов = СписокДокументовОснованийЧекаККМ.ВыгрузитьКолонку("Контрагент");
	
	ДатаСведений = Объект.Дата;
	
	СуммаАвансаПоКонтрагенту = СуммаАвансаПоКонтрагенту(Объект.НачалоРасчетногоПериода, ДатаСведений, СписокКонтрагентов);
	
	Для каждого ТекСтрока Из СуммаАвансаПоКонтрагенту Цикл
		ПараметрыОтбораДокумента = Новый Структура("Контрагент", ТекСтрока.Контрагент);
		НайденныеСтроки = Объект.ДокументыЧекаККМ.НайтиСтроки(ПараметрыОтбораДокумента);
		СуммаАванса = ТекСтрока.Сумма;
		Для каждого ТекДокумент Из НайденныеСтроки Цикл
			Если СуммаАванса <= 0 Тогда
				Прервать;
			КонецЕсли;	
			СуммаОстатка = ТекДокумент.Сумма - ТекДокумент.СуммаПредоплаты;
			Если СуммаОстатка > 0 Тогда
				Если СуммаОстатка <= СуммаАванса Тогда
					ТекДокумент.СуммаАванса = СуммаОстатка;
				Иначе
					ТекДокумент.СуммаАванса = СуммаАванса;
				КонецЕсли;	
				СуммаАванса = СуммаАванса - СуммаОстатка;
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;
	
	Если Объект.ДляСпискаКонтрагентовПоРеализации Тогда
		ЗаполнитьСписокУдержанийПоДокументамРеализацииНаСервере();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ДанныеУведомления()
	Результат = Новый Структура();
	Результат.Вставить("ТекстУведомления", "");
	Результат.Вставить("ЭтоПроблема", Истина);
	
	ВсегоЧековККМ = Объект.ЧекиККМ.Количество();
	Если ВсегоЧековККМ = 0 Тогда
		Результат.ТекстУведомления = НСтр("ru='Сведения чеков ККМ не заполнены'");
	Иначе
		КоличествоПробитыхЧековККМ = 0;
		Для каждого ТекСтрока Из Объект.ЧекиККМ Цикл
			Если ТекСтрока.НомерЧекаККМ > 0  Тогда
				КоличествоПробитыхЧековККМ = КоличествоПробитыхЧековККМ + 1;
			КонецЕсли;	
		КонецЦикла;
		Если ВсегоЧековККМ = КоличествоПробитыхЧековККМ Тогда
			Результат.ЭтоПроблема = Ложь;
			Результат.ТекстУведомления = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
				"ru='Все чеки ККМ фискализированы (%1 шт.)'"),
				КоличествоПробитыхЧековККМ);
		Иначе
			Если КоличествоПробитыхЧековККМ = 0 Тогда
				Результат.ТекстУведомления = НСтр("ru='Чеки ККМ не фискализированы'");
			ИначеЕсли КоличествоПробитыхЧековККМ = 1 Тогда
				Результат.ТекстУведомления = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
					"ru='Фискализирован %1 чек ККМ из %2'"),
					КоличествоПробитыхЧековККМ, ВсегоЧековККМ);
			Иначе	
				Результат.ТекстУведомления = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр(
					"ru='Фискализированы %1 чеков ККМ из %2'"),
					КоличествоПробитыхЧековККМ, ВсегоЧековККМ);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ЗаполнитьСписокДокументовРасчетаНачисленияНаСервере()
	Объект.ДокументыГруппыЧековККМ.Очистить();
	
	Запрос = Новый Запрос;	
	Запрос.Текст = "ВЫБРАТЬ
	               |	НачислениеДоходов.Ссылка КАК ДокументОснованиеЧековККМ
	               |ИЗ
	               |	Документ.НачислениеДоходов КАК НачислениеДоходов
	               |ГДЕ
	               |	НачислениеДоходов.Организация = &Организация
	               |	И &НачислениеДоходов = ИСТИНА
	               |	И НачислениеДоходов.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И НачислениеДоходов.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НачислениеЗаУслугиОбразования.Ссылка
	               |ИЗ
	               |	Документ.НачислениеЗаУслугиОбразования КАК НачислениеЗаУслугиОбразования
	               |ГДЕ
	               |	НачислениеЗаУслугиОбразования.Организация = &Организация
	               |	И НачислениеЗаУслугиОбразования.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И &НачислениеЗаУслугиОбразования = ИСТИНА
	               |	И НачислениеЗаУслугиОбразования.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НачислениеСтудентамЗаПрочиеУслуги.Ссылка
	               |ИЗ
	               |	Документ.НачислениеСтудентамЗаПрочиеУслуги КАК НачислениеСтудентамЗаПрочиеУслуги
	               |ГДЕ
	               |	НачислениеСтудентамЗаПрочиеУслуги.Организация = &Организация
	               |	И НачислениеСтудентамЗаПрочиеУслуги.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И &НачислениеСтудентамЗаПрочиеУслуги = ИСТИНА
	               |	И НачислениеСтудентамЗаПрочиеУслуги.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НачислениеРодительскойПлаты.Ссылка
	               |ИЗ
	               |	Документ.НачислениеРодительскойПлаты КАК НачислениеРодительскойПлаты
	               |ГДЕ
	               |	НачислениеРодительскойПлаты.Организация = &Организация
	               |	И НачислениеРодительскойПлаты.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И &НачислениеРодительскойПлаты = ИСТИНА
	               |	И НачислениеРодительскойПлаты.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СписаниеДоходовБудущихПериодов.Ссылка
	               |ИЗ
	               |	Документ.СписаниеДоходовБудущихПериодов КАК СписаниеДоходовБудущихПериодов
	               |ГДЕ
	               |	СписаниеДоходовБудущихПериодов.Организация = &Организация
	               |	И СписаниеДоходовБудущихПериодов.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И &СписаниеДоходовБудущихПериодов = ИСТИНА
	               |	И СписаниеДоходовБудущихПериодов.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	АктОбОказанииУслуг.Ссылка
	               |ИЗ
	               |	Документ.АктОбОказанииУслуг КАК АктОбОказанииУслуг
	               |ГДЕ
	               |	АктОбОказанииУслуг.Организация = &Организация
	               |	И АктОбОказанииУслуг.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И &АктОбОказанииУслуг = ИСТИНА
	               |	И АктОбОказанииУслуг.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ДатаНачала"							, НачалоДня(Объект.НачалоРасчетногоПериода));
	Запрос.УстановитьПараметр("ДатаОкончания"						, КонецДня(Объект.ОкончаниеРасчетногоПериода));
	Запрос.УстановитьПараметр("Организация"							, Объект.Организация);
	Запрос.УстановитьПараметр("НачислениеДоходов"					, ОтборПоТипуДокумента[0].Пометка);
	Запрос.УстановитьПараметр("НачислениеЗаУслугиОбразования"		, ОтборПоТипуДокумента[1].Пометка);
	Запрос.УстановитьПараметр("НачислениеСтудентамЗаПрочиеУслуги"	, ОтборПоТипуДокумента[2].Пометка);
	Запрос.УстановитьПараметр("НачислениеРодительскойПлаты"			, ОтборПоТипуДокумента[3].Пометка);
	Запрос.УстановитьПараметр("СписаниеДоходовБудущихПериодов"		, ОтборПоТипуДокумента[4].Пометка);
	Запрос.УстановитьПараметр("АктОбОказанииУслуг"					, ОтборПоТипуДокумента[5].Пометка);
	
	ДанныеДокументовОснований = Запрос.Выполнить().Выгрузить();
	
	ДокументыПоКоторымЕстьЧеки = ПодключаемоеОборудованиеБГУ.ДокументыОснованияСЧекамиДляРеестра(Объект.Ссылка, ДанныеДокументовОснований); 
	
	Если ОтборПоТипуДокумента[5].Пометка Тогда 
		ДокументыЧекККМНаПередачу = ПолучитьДокументыЧекККМНаПередачу(ДанныеДокументовОснований.ВыгрузитьКолонку("ДокументОснованиеЧековККМ"));
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ДокументыЧекККМНаПередачу, ДокументыПоКоторымЕстьЧеки);
	КонецЕсли;	
	
	Для каждого ТекСтрока Из ДанныеДокументовОснований Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ДокументОснованиеЧековККМ", ТекСтрока.ДокументОснованиеЧековККМ);
		НайденныеДокументы = ДокументыПоКоторымЕстьЧеки.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеДокументы.Количество() = 0 Тогда
			НоваяСтрока = Объект.ДокументыГруппыЧековККМ.Добавить();
			НоваяСтрока.ДокументОснованиеЧековККМ = ТекСтрока.ДокументОснованиеЧековККМ;
		КонецЕсли;	
	КонецЦикла;	
	
	ПроверитьСписокДокументовРасчетаНачисленияНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьСписокДокументовРасчетаНачисленияНаСервере()
	Если Объект.ВидОперации = 2 Тогда
		
		ТаблицаДокументовОснованийЧекаККМ = Объект.ДокументыГруппыЧековККМ.Выгрузить();
		
		ПроводкиПоДокументамПередачи = ПодключаемоеОборудованиеБГУ.ПроводкиПоДокументамПередачи(ТаблицаДокументовОснованийЧекаККМ, "ДокументОснованиеЧековККМ");
		
		Для каждого ТекСтрока Из Объект.ДокументыГруппыЧековККМ Цикл
			Если ЗначениеЗаполнено(ТекСтрока.ДокументОснованиеЧековККМ) Тогда
				Если ТекСтрока.ДокументОснованиеЧековККМ.Проведен Тогда
					ПроверитьБухОперацииСписокДокументовРасчетаНачисленияНаСервере(ПроводкиПоДокументамПередачи, 
						ТекСтрока.ДокументОснованиеЧековККМ, ТекСтрока.НомерСтроки);
				Иначе	
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='В строке %1 не проведен документ-основание чеков ККМ'"),
							СокрЛП(ТекСтрока.НомерСтроки));
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
				КонецЕсли;	
			Иначе
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='В строке %1 не заполнен документ-основание чеков ККМ'"),
						СокрЛП(ТекСтрока.НомерСтроки));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПроверитьБухОперацииСписокДокументовРасчетаНачисленияНаСервере(ПроводкиПоДокументамПередачи, ДокОснованиеЧекаККМ, НомерСтрокиДокОснованиеЧекаККМ)
	Если Объект.ВидОперации = 2 Тогда
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Регистратор", ДокОснованиеЧекаККМ);
		
		МассивПроводок = ПроводкиПоДокументамПередачи.НайтиСтроки(ПараметрыОтбора);
		Если МассивПроводок.Количество() = 0 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Бухгалтерская операция документа %1 в строке %2 не имеет проводок'"),
					СокрЛП(ДокОснованиеЧекаККМ), СокрЛП(НомерСтрокиДокОснованиеЧекаККМ));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);		
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ДокументыГруппыЧековККМДокументОснованиеЧековККМПриИзмененииНаСервере()
	ДокументыПоКоторымЕстьЧеки = ПодключаемоеОборудованиеБГУ.ДокументыОснованияСЧекамиДляРеестра(Объект.Ссылка, Объект.ДокументыГруппыЧековККМ.Выгрузить()); 
	
	Для каждого ТекСтрока Из ДокументыПоКоторымЕстьЧеки Цикл 
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Для документа %1 уже есть документ ""Чеки ККМ для реестра платежей"".
			|Просмотреть этот документ можно с помощью команды ""Связанные документы"" в панели навигации формы документа.'"),
				СокрЛП(ТекСтрока.ДокументОснованиеЧековККМ));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЭквайринговыеОперацииДляОплатыЭСПНаКлиенте()
	Если Объект.ВидОперации > 0 Тогда
		ТекстСообщения = НСтр("ru='Данная команда используется только для вида операции ""Поступление платежей по реестру""
		|для случая оплаты с помощью электронных средств платежа.'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ВидОперации");
		
		Возврат;
	КонецЕсли;
	
	Если НЕ Объект.ФормироватьЧекиПоКаждомуПлатежуРеестра Тогда
		ТекстСообщения = НСтр("ru='Данная команда требует формирования кассовых чеков с включенным флажком ""Формировать чеки по каждому платежу в документе ""Чеки ККМ для реестра платежей""
		|в свойствах Кассы ККМ на закладке ""Настройки заполнения документов"". Следует включить эту настройку и переформировать сведения о чеках ККМ командой ""Заполнить сведения чеков ККМ по контрагентам"".'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ВидОперации");
		
		Возврат;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура("КассаККМ, Организация,  
		|АдресСпискаПлатежейВХранилище, ВалютаРубли, ДокументЧекиККМ");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	
	ПараметрыФормы.ДокументЧекиККМ = Объект.Ссылка;
	ПараметрыФормы.ВалютаРубли = ВалютаРубли;
	ПараметрыФормы.АдресСпискаПлатежейВХранилище = ПоместитьТаблицуОплатыЭСПВХранилище();
	
	ОткрытьФорму("Документ.ЧекиККМДляРеестраПлатежей.Форма.ФормаСозданияОтраженияВУчетеОплатыЭСП",
		ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьТаблицуОплатыЭСПВХранилище()
	
	СведенияОбОплатахЭСП = Объект.РасшифровкаПлатежейКонтрагентов.Выгрузить();
	СведенияОбОплатахЭСП.Очистить();
	СведенияОбОплатахЭСП.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	СведенияОбОплатахЭСП.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число"));
	
	Для каждого ТекСтрока Из Объект.РасшифровкаПлатежейКонтрагентов Цикл
		Если ТекСтрока.СуммаОплатыЭСП > 0 Тогда
			СуммаНДС = 0;
			НоваяСтрока = СведенияОбОплатахЭСП.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			
			СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
			Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
				СтавкаНДС = ТекСтрока.Номенклатура.СтавкаНДС;
			КонецЕсли;
			
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			
			ПараметрыОтбораНоменклатуры = Новый Структура("КлючЧека", ТекСтрока.КлючСтроки); 	
			МассивНоменклатурыЧека = Объект.НоменклатураЧековККМ.НайтиСтроки(ПараметрыОтбораНоменклатуры);

			Для каждого ТекСтрокаНоменклатуры Из МассивНоменклатурыЧека Цикл
				СуммаНДС = СуммаНДС + ТекСтрокаНоменклатуры.СуммаНДС;
			КонецЦикла;
			
			НоваяСтрока.СуммаНДС = СуммаНДС;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат ПоместитьВоВременноеХранилище(СведенияОбОплатахЭСП);

КонецФункции

&НаСервере
Функция ДанныеОбЭквайринговыхОперацияхДокумента()
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЭквайринговаяОперация.Ссылка КАК Ссылка,
		               |	ЭквайринговаяОперация.КлючСтрокиЧековККМДляРеестраПлатежей КАК КлючСтроки
		               |ИЗ
		               |	Документ.ЭквайринговаяОперация КАК ЭквайринговаяОперация
		               |ГДЕ
		               |	ЭквайринговаяОперация.ДокументОснование = &ДокументОснование
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ЭквайринговаяОперация.Дата УБЫВ,
		               |	ЭквайринговаяОперация.Номер УБЫВ";
		
		Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
		Результат = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ПрочитатьДополнительныеДанныеЧековККМ()
	
	ДополнительныеСведенияКассовогоЧека = 
		ПодключаемоеОборудованиеБГУВызовСервера.ДополнительныеСведенияКассовыхЧеков(Объект.Ссылка);
	
	Для каждого ТекЧекККМ Из Объект.ЧекиККМ Цикл
		ПараметрыОтбораЧека = Новый Структура("ИдентификаторЗаписи", ТекЧекККМ.КлючЧека); 	
		Чек = ДополнительныеСведенияКассовогоЧека.НайтиСтроки(ПараметрыОтбораЧека);
		
		Для каждого ТекДанные Из Чек Цикл
			ТекЧекККМ.АбонентскийНомерТелефона = ТекДанные.АбонентскийНомерТелефона;
			ТекЧекККМ.АдресЭлектроннойПочты = ТекДанные.АдресЭлектроннойПочты;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДополнительныеДанныеЧековККМ(ТекущийОбъект)
	
	Для каждого ТекЧекККМ Из Объект.ЧекиККМ Цикл
		ДополнительныеДанныеЧекаККМ = Новый Структура;
		ДополнительныеДанныеЧекаККМ.Вставить("ДокументОснование", ТекущийОбъект.Ссылка);
		ДополнительныеДанныеЧекаККМ.Вставить("Контрагент", ТекЧекККМ.Контрагент);
		ДополнительныеДанныеЧекаККМ.Вставить("АдресЭлектроннойПочты", ТекЧекККМ.АдресЭлектроннойПочты);
		ДополнительныеДанныеЧекаККМ.Вставить("АбонентскийНомерТелефона", ТекЧекККМ.АбонентскийНомерТелефона);
		ДополнительныеДанныеЧекаККМ.Вставить("ОтказПокупателяОтСохраненияДанных", ТекЧекККМ.ОтказКлиентаОтСохраненияТелефонаEmail);
		
		
		ПодключаемоеОборудованиеБГУВызовСервера.ЗаписатьДополнительныеСведенияКассовогоЧека(ДополнительныеДанныеЧекаККМ, ТекЧекККМ.КлючЧека);	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОчиститьДополнительныеДанныеЧековККМ(ТекущийОбъект)
	
	Для каждого ТекЧекККМ Из Объект.ЧекиККМ Цикл
		Если ТекЧекККМ.НомерЧекаККМ > 0  Тогда
			Если ЗначениеЗаполнено(ТекЧекККМ.АдресЭлектроннойПочты) 
				ИЛИ ЗначениеЗаполнено (ТекЧекККМ.АбонентскийНомерТелефона) Тогда
				ДополнительныеДанныеЧекаККМ = Новый Структура;
				ДополнительныеДанныеЧекаККМ.Вставить("ДокументОснование", ТекущийОбъект.Ссылка);
				ДополнительныеДанныеЧекаККМ.Вставить("Контрагент", ТекЧекККМ.Контрагент);
				ДополнительныеДанныеЧекаККМ.Вставить("АдресЭлектроннойПочты", "");
				ДополнительныеДанныеЧекаККМ.Вставить("АбонентскийНомерТелефона", "");
				ДополнительныеДанныеЧекаККМ.Вставить("ОтказПокупателяОтСохраненияДанных", Истина);
				
				Физлицо = Справочники.ФизическиеЛица.ПустаяСсылка();
				Если ЗначениеЗаполнено(ТекЧекККМ.Контрагент) Тогда
					ДанныеКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекЧекККМ.Контрагент, "ВидКонтрагента, ЮридическоеФизическоеЛицо");	
					Если ДанныеКонтрагента.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
						Физлицо = ДанныеКонтрагента.ЮридическоеФизическоеЛицо;
					КонецЕсли;	
				КонецЕсли;	
					
				ДополнительныеДанныеЧекаККМ.Вставить("Физлицо", Физлицо);
				
				ПодключаемоеОборудованиеБГУВызовСервера.ОчиститьДополнительныеСведенияКассовогоЧека(ДополнительныеДанныеЧекаККМ, ТекЧекККМ.КлючЧека);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПолучитьДокументыЧекККМНаПередачу(ДокументыОснования)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ВЫБОР
	               |		КОГДА ЧекККМНаПередачуДокументыЧекаККМ.ДокументОснованиеЧекаККМ ССЫЛКА Документ.АктОбОказанииУслуг
	               |			ТОГДА ВЫРАЗИТЬ(ЧекККМНаПередачуДокументыЧекаККМ.ДокументОснованиеЧекаККМ КАК Документ.АктОбОказанииУслуг).Ссылка
	               |	КОНЕЦ КАК ДокументОснованиеЧековККМ
	               |ИЗ
	               |	Документ.ЧекККМНаПередачу.ДокументыЧекаККМ КАК ЧекККМНаПередачуДокументыЧекаККМ
	               |ГДЕ
	               |	ЧекККМНаПередачуДокументыЧекаККМ.ДокументОснованиеЧекаККМ В(&ДокументОснованиеЧекаККМ)
	               |	И ЧекККМНаПередачуДокументыЧекаККМ.Ссылка.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ДокументОснованиеЧекаККМ", ДокументыОснования);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса;
	
КонецФункции	

&НаСервере
Процедура ЗаполнитьПоЭквайринговымОперациямЗаДеньНаСервере()
	Объект.ПлатежиКонтрагентов.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭквайринговаяОперация.Ссылка КАК ДокументОплаты
	               |ПОМЕСТИТЬ ВТДокументыЭквайринга
	               |ИЗ
	               |	Документ.ЭквайринговаяОперация КАК ЭквайринговаяОперация
	               |ГДЕ
	               |	ЭквайринговаяОперация.Организация = &Организация
	               |	И ЭквайринговаяОперация.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И ЭквайринговаяОперация.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииЭквайринга.ОплатаЧерезСервисПриемаПлатежей)
	               |	И ЭквайринговаяОперация.ПробитЧек = ЛОЖЬ
	               |	И ЭквайринговаяОперация.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЧекиККМДляРеестраПлатежейПлатежиКонтрагентов.Ссылка КАК Ссылка,
	               |	ВТДокументыЭквайринга.ДокументОплаты КАК ДокументОплаты,
	               |	ЧекиККМДляРеестраПлатежейПлатежиКонтрагентов.КлючСтроки КАК КлючСтроки
	               |ПОМЕСТИТЬ ВТДокументыЧекиДляРеестра
	               |ИЗ
	               |	ВТДокументыЭквайринга КАК ВТДокументыЭквайринга
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекиККМДляРеестраПлатежей.ПлатежиКонтрагентов КАК ЧекиККМДляРеестраПлатежейПлатежиКонтрагентов
	               |		ПО ВТДокументыЭквайринга.ДокументОплаты = ЧекиККМДляРеестраПлатежейПлатежиКонтрагентов.ДокументОплаты
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТДокументыЧекиДляРеестра.Ссылка КАК Ссылка,
	               |	ВТДокументыЧекиДляРеестра.ДокументОплаты КАК ДокументОплаты,
	               |	ЧекиККМДляРеестраПлатежейЧекиККМ.НомерЧекаККМ КАК НомерЧекаККМ
	               |ПОМЕСТИТЬ ВТДанныеЧеков
	               |ИЗ
	               |	ВТДокументыЧекиДляРеестра КАК ВТДокументыЧекиДляРеестра
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекиККМДляРеестраПлатежей.ЧекиККМ КАК ЧекиККМДляРеестраПлатежейЧекиККМ
	               |		ПО ВТДокументыЧекиДляРеестра.Ссылка = ЧекиККМДляРеестраПлатежейЧекиККМ.Ссылка
	               |			И ВТДокументыЧекиДляРеестра.КлючСтроки = ЧекиККМДляРеестраПлатежейЧекиККМ.КлючЧека
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТДанныеЧеков.ДокументОплаты КАК ДокументОплаты,
	               |	ФискальныеОперации.НомерЧекаККМ КАК НомерЧекаККМ
	               |ПОМЕСТИТЬ ВТФискальныеОперации
	               |ИЗ
	               |	ВТДанныеЧеков КАК ВТДанныеЧеков
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	               |		ПО ВТДанныеЧеков.Ссылка = ФискальныеОперации.ДокументОснование
	               |			И ВТДанныеЧеков.НомерЧекаККМ = ФискальныеОперации.НомерЧекаККМ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТФискальныеОперации.ДокументОплаты.Ссылка КАК ДокументОплаты,
	               |	ВТФискальныеОперации.ДокументОплаты.Контрагент КАК Контрагент,
	               |	ВТФискальныеОперации.ДокументОплаты.Договор КАК Договор,
	               |	ВТФискальныеОперации.ДокументОплаты.СуммаДокумента КАК Сумма,
	               |	ВТФискальныеОперации.НомерЧекаККМ КАК НомерЧекаККМ
	               |ИЗ
	               |	ВТФискальныеОперации КАК ВТФискальныеОперации
	               |ГДЕ
	               |	ВТФискальныеОперации.НомерЧекаККМ ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Объект.Дата));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Объект.Дата));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НомерЧека = ПодключаемоеОборудованиеБГУ.НомерЧека(Выборка.ДокументОплаты);
		Если НомерЧека = 0 Тогда
			НоваяСтрока = Объект.ПлатежиКонтрагентов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор;	
			НоваяСтрока.Плательщик = Выборка.Контрагент;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДанныеДляЧековККМПоЭквайринговымОперациямНаСервере()
	Если Объект.СуммаФискализированныхЧековККМ > 0 тогда
		ТекстСообщения = НСтр("ru = 'Есть фискализированные чеки. Операция не выполнена.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
		
		Возврат;
	КонецЕсли;	
	
	СформироватьИЗаполнитьДанныеДляЧековККМПоЭквайринговымОперациям();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьИЗаполнитьДанныеДляЧековККМПоЭквайринговымОперациям()

	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Касса ККМ""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
			
		Возврат;		
	КонецЕсли;
	
	Объект.ЧекиККМ.Очистить();
	Объект.НоменклатураЧековККМ.Очистить();
	Объект.ТипЗаполненияЧеков = 5;
	
	Для Каждого ТекСтрока Из Объект.ПлатежиКонтрагентов Цикл
		ДокументОплаты = ТекСтрока.ДокументОплаты;
		
		НоваяСтрокаЧек = Объект.ЧекиККМ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаЧек, ТекСтрока);
		НоваяСтрокаЧек.КлючЧека = ТекСтрока.КлючСтроки;
		НоваяСтрокаЧек.ПараметрыДоговораПлатежногоАгента = ДокументОплаты.ПараметрыДоговораПлатежногоАгента;
		НоваяСтрокаЧек.ТипРасчета = ДокументОплаты.ТипРасчета;
		НоваяСтрокаЧек.СистемаНалогообложенияЧекаККМ = ?(ЗначениеЗаполнено(ДокументОплаты.СистемаНалогообложенияЧекаККМ),
			ДокументОплаты.СистемаНалогообложенияЧекаККМ,
			Перечисления.ВидыСистемыНалогообложенияЧекаККМ.ОСН);
		
		ДокументыОснованияПлатежа = ДокументОплаты.ДокументыЧекаККМ.Выгрузить();
		НоменклатураТоваровИУслуг = ПодключаемоеОборудованиеБГУ.ТаблицаНоменклатурыЧекаККМДляДокументовОснований(ДокументыОснованияПлатежа);
		
		Для Каждого ТекСтрокаНоменклатуры Из НоменклатураТоваровИУслуг Цикл
			НоваяСтрокаНоменклатурыЧека = Объект.НоменклатураЧековККМ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаНоменклатурыЧека, ТекСтрокаНоменклатуры);
			НоваяСтрокаНоменклатурыЧека.КлючЧека = ТекСтрока.КлючСтроки;
			НоваяСтрокаНоменклатурыЧека.Сумма = ТекСтрокаНоменклатуры.Всего;
			НоваяСтрокаНоменклатурыЧека.ДополнениеНаименованияНоменклатуры = ТекСтрокаНоменклатуры.ДополнениеНоменклатуры;
		КонецЦикла;	
	КонецЦикла;	
	
	ЗаполнитьДанныеДляНаправленияПокупателямЭлектронныхЧеков();
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

