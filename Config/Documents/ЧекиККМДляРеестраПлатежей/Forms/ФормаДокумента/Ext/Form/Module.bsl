&НаСервере
Функция ПодготовитьДанныеДляПробитияЧека(НомерЧека)
	
	ОбщиеПараметры  = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(Объект, Объект.Ссылка, НомерЧека);
	
	Возврат ОбщиеПараметры;
КонецФункции

&НаСервере
Функция ПодготовитьДанныеДляПробитияЧекаДляРасчетногоДокумента(НомерЧека, КлючЧека)
	
	ПараметрыОтбора = Новый Структура("КлючЧека", КлючЧека); 	
	НайденныеСтроки = Объект.ЧекиККМ.НайтиСтроки(ПараметрыОтбора);
		
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	ТекЧекККМ = НайденныеСтроки[0];
	
	ОбщиеПараметры  = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(Объект, Объект.Ссылка, ТекЧекККМ.НомерСтроки);
	
	ОбщиеПараметры.НомерЧека = НомерЧека;
	
	Возврат ОбщиеПараметры;
КонецФункции


&НаКлиенте
Процедура ПечатьЧека_ПослеОткрытияЧека(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	ШапкаЧека = ПараметрыВыполнения.ВходныеПараметры;
	
	Если ПараметрыВыполнения.НомерСмены <> 0 Тогда
		ШапкаЧека.НомерСменыККТ = ПараметрыВыполнения.НомерСмены;
	КонецЕсли;
	
	Если ПараметрыВыполнения.НомерЧека <> 0 Тогда
		ШапкаЧека.НомерЧекаККТ = ПараметрыВыполнения.НомерЧека;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ПараметрыВыполнения.ОповещениеПродолжения, ПараметрыВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЧека_ПослеОшибкиПечатиЧека(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	ШапкаЧека = ПараметрыВыполнения.ВходныеПараметры;
	ШапкаЧека.НомерЧекаККТ = ШапкаЧека.НомерЧекаККТ + 1000000;
	
	Если ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств") Тогда
		ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств");
	Иначе
		ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КассаККМПриИзмененииНаСервере()
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		Объект.СистемаНалогообложенияЧекаККМ = Объект.КассаККМ.СистемаНалогообложенияЧекаККМ;
	КонецЕсли;
	
	СписокВидовНалогообложения = ПодключаемоеОборудованиеБГУ.ПереченьСистемНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	Элементы.СистемаНалогообложенияЧекаККМ.СписокВыбора.ЗагрузитьЗначения(СписокВидовНалогообложения);
	Элементы.СистемаНалогообложенияЧекаККМ.РежимВыбораИзСписка = Истина;
	
	ИспользуетсяККТСПередачейДанных = ПодключаемоеОборудованиеБГУ.ИспользуетсяККТСПередачейДанных(Объект.КассаККМ);
КонецПроцедуры

&НаСервере
Процедура ДокументОснованиеПриИзмененииНаСервере()
	
	ДокументОснование = Объект.ДокументОснование;
	
	ЧекиККМСпискомСсылка = НайтиЧекиККМСпискомПоДокументу(ДокументОснование);
	Если ЗначениеЗаполнено(ЧекиККМСпискомСсылка) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для документа %1 уже введен документ %2.'"), ДокументОснование, ЧекиККМСпискомСсылка);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДокументОснование.НомерЧекаККМ) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для документа %1 уже пробит чек.'"), ДокументОснование);
		
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КассовоеПоступление") Тогда
		ЗаполнитьПоКассовомуПоступлению(ДокументОснование);	
	КонецЕсли;
	
	ЗаполнитьДанныеДляНаправленияПокупателямЭлектронныхЧеков();
	
	ПодготовитьФормуНаСервере();

КонецПроцедуры

&НаСервере
Функция НайтиЧекиККМСпискомПоДокументу(ДокументОснование)
	Результат = Документы.ЧекиККМДляРеестраПлатежей.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЧекиККМДляРеестраПлатежей.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЧекиККМДляРеестраПлатежей КАК ЧекиККМДляРеестраПлатежей
	|ГДЕ
	|	ЧекиККМДляРеестраПлатежей.ДокументОснование = &ДокументОснование
	|	И НЕ ЧекиККМДляРеестраПлатежей.Ссылка = &СсылкаНаДокумент";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("СсылкаНаДокумент", Объект.Ссылка);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.Ссылка;
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ЗаполнитьПоКассовомуПоступлению(ДокументОснование)
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат;
	КонецЕсли;	
	
	ДатаСведений = ДокументОснование.Дата;
	ЗаполняемыеДанные = "Организация, РодительскаяПлата";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(Объект, ДанныеДокументаОснования);
	
	Объект.ДокументОснование = ДокументОснование;
	
	РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	НастройкиОборудования = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьНастройкиОборудования(РабочееМесто, ДокументОснование.Организация);
	Объект.КассаККМ = НастройкиОборудования.ФискальныйРегистратор;
	Если ЗначениеЗаполнено(НастройкиОборудования.ФискальныйРегистратор) Тогда
		Объект.СистемаНалогообложенияЧекаККМ = НастройкиОборудования.ФискальныйРегистратор.СистемаНалогообложенияЧекаККМ;
		Объект.ФормироватьЧекиПоКаждомуПлатежуРеестра = НастройкиОборудования.ФискальныйРегистратор.ФормироватьЧекиПоКаждомуПлатежуРеестра;
	КонецЕсли;
	Объект.НаправлятьПокупателямЭлектронныеЧеки = Истина;
	
	СведенияРасшифровки = ПодключаемоеОборудованиеБГУВызовСервера.РасшифровкаКассовогоПоступления(ДокументОснование);
	ТЗРасшифровкаПлатежа = СведенияРасшифровки.Расшифровка;
	ЕстьПлатежиПоДоговорамБезПримененияККТ = СведенияРасшифровки.ЕстьДоговорыБезПримененияККТ;
	
	Для каждого ТекСтрока Из ТЗРасшифровкаПлатежа Цикл
		Если ТекСтрока.СуммаОплатыЭСП > 0 Тогда
			ТекСтрока.Сумма = ТекСтрока.СуммаОплатыЭСП;
		КонецЕсли;	
	КонецЦикла;	
	
	ТЗРасшифровкаПлатежа.Колонки.Добавить("Плательщик", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	
	Если Объект.ФормироватьЧекиПоКаждомуПлатежуРеестра Тогда
		Если ТЗРасшифровкаПлатежа.Колонки.Найти("НомерСтроки") = Неопределено Тогда
			ТЗРасшифровкаПлатежа.Свернуть("Контрагент, Плательщик", "Сумма, СуммаКомиссииЭСП, СуммаОплатыЭСП");
		Иначе
			ТЗРасшифровкаПлатежа.Свернуть("НомерСтроки, Контрагент, Плательщик", "Сумма, СуммаКомиссииЭСП, СуммаОплатыЭСП");
		КонецЕсли;
	Иначе	
		ТЗРасшифровкаПлатежа.Свернуть("Контрагент, Плательщик", "Сумма, СуммаКомиссииЭСП, СуммаОплатыЭСП");
	КонецЕсли;
	ТЗРасшифровкаПлатежа.Колонки.Добавить("КлючСтроки", Новый ОписаниеТипов("Строка"));
	
	Для каждого ТекСтрока Из ТЗРасшифровкаПлатежа Цикл
		ТекСтрока.КлючСтроки = Новый УникальныйИдентификатор;	
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Плательщик) Тогда
			ТекСтрока.Плательщик = ТекСтрока.Контрагент;
		КонецЕсли;
	КонецЦикла;
	
	Объект.ПлатежиКонтрагентов.Загрузить(ТЗРасшифровкаПлатежа);
	
	СведенияРасшифровки = ПодключаемоеОборудованиеБГУВызовСервера.РасшифровкаКассовогоПоступления(ДокументОснование);
	ТЗРасшифровкаПлатежаПолная = СведенияРасшифровки.Расшифровка;
	Если Объект.ФормироватьЧекиПоКаждомуПлатежуРеестра Тогда
		ТЗРасшифровкаПлатежаПолная.Свернуть("НомерСтроки, Контрагент, Договор, Ребенок", "Сумма, СуммаКомиссииЭСП, СуммаОплатыЭСП");
	Иначе
		ТЗРасшифровкаПлатежаПолная.Свернуть("Контрагент, Договор, Ребенок", "Сумма, СуммаКомиссииЭСП, СуммаОплатыЭСП");
	КонецЕсли;	
	ТЗРасшифровкаПлатежаПолная.Колонки.Добавить("КлючСтроки", Новый ОписаниеТипов("Строка"));
	ТЗРасшифровкаПлатежаПолная.Колонки.Добавить("ГруппаДетскогоУчреждения", Новый ОписаниеТипов("СправочникСсылка.ГруппыДетскогоУчреждения"));
	ТЗРасшифровкаПлатежаПолная.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		НоменклатураПлатежаКассыККМ = Объект.КассаККМ.НоменклатураПлатежа;
	Иначе
		НоменклатураПлатежаКассыККМ = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;	
	
	Для каждого ТекСтрока Из ТЗРасшифровкаПлатежаПолная Цикл
		Если Объект.ФормироватьЧекиПоКаждомуПлатежуРеестра Тогда
			НайденнаяСтрока = ТЗРасшифровкаПлатежа.Найти(ТекСтрока.НомерСтроки, "НомерСтроки"); 
		Иначе	
			НайденнаяСтрока = ТЗРасшифровкаПлатежа.Найти(ТекСтрока.Контрагент, "Контрагент"); 
		КонецЕсли;
		Если НЕ НайденнаяСтрока = Неопределено Тогда
			ТекСтрока.КлючСтроки = НайденнаяСтрока.КлючСтроки;	
		КонецЕсли;
		
		ТекСтрока.Ребенок = Справочники.Дети.ПустаяСсылка();
		ТекСтрока.Номенклатура = НоменклатураПлатежаКассыККМ;
		Если ЗначениеЗаполнено(ТекСтрока.Договор) Тогда
			НоменклатураПлатежаДляЧекаККМ = ТекСтрока.Договор.НоменклатураПлатежаДляЧекаККМ;
			Если ЗначениеЗаполнено(НоменклатураПлатежаДляЧекаККМ) Тогда
				ТекСтрока.Номенклатура = НоменклатураПлатежаДляЧекаККМ;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	ТЗРасшифровкаПлатежаПоКонтрагентам = ТЗРасшифровкаПлатежаПолная;
	
	Объект.РасшифровкаПлатежейКонтрагентов.Загрузить(ТЗРасшифровкаПлатежаПоКонтрагентам);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНоменклатуруПлатежаНаСервере()
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		НоменклатураПлатежаКассыККМ = Объект.КассаККМ.НоменклатураПлатежа;
	Иначе
		НоменклатураПлатежаКассыККМ = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;	
	
	Для каждого ТекСтрока Из Объект.РасшифровкаПлатежейКонтрагентов Цикл
		ТекСтрока.Номенклатура = НоменклатураПлатежаКассыККМ;
		Если ЗначениеЗаполнено(ТекСтрока.Договор) Тогда
			НоменклатураПлатежаДляЧекаККМ = ТекСтрока.Договор.НоменклатураПлатежаДляЧекаККМ;
			Если ЗначениеЗаполнено(НоменклатураПлатежаДляЧекаККМ) Тогда
				ТекСтрока.Номенклатура = НоменклатураПлатежаДляЧекаККМ;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	
	ТекстСообщения = НСтр("ru='Изменена номенклатура платежа. Следует перезаполнить сведения чеков ККМ командой ""Заполнить сведения чеков ККМ по контрагентам"" на закладке ""Платежи контрагентов"".'");
		
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,);
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	УстановитьДанныеДляПечатиЧековККМ(Истина);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДанныеДляПечатиЧековККМ(ИзмененаОрганизация = Ложь)
	Если НЕ ЗначениеЗаполнено(Объект.СистемаНалогообложенияЧекаККМ) ИЛИ ИзмененаОрганизация Тогда
		Объект.СистемаНалогообложенияЧекаККМ = ПодключаемоеОборудованиеБГУ.ВидСистемыНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	КонецЕсли;
	
	СписокВидовНалогообложения = ПодключаемоеОборудованиеБГУ.ПереченьСистемНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	Элементы.СистемаНалогообложенияЧекаККМ.СписокВыбора.ЗагрузитьЗначения(СписокВидовНалогообложения);
	Элементы.СистемаНалогообложенияЧекаККМ.РежимВыбораИзСписка = Истина;
	
	РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	НастройкиОборудования = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьНастройкиОборудования(РабочееМесто, Объект.Организация);
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		Объект.КассаККМ = НастройкиОборудования.ФискальныйРегистратор;
		Объект.СистемаНалогообложенияЧекаККМ = НастройкиОборудования.ФискальныйРегистратор.СистемаНалогообложенияЧекаККМ;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		Если Объект.КассаККМ.ИспользоватьБезПодключенияОборудования Тогда
			ИспользоватьПодключаемоеОборудование = Ложь;
		Иначе
			ИспользоватьПодключаемоеОборудование = Истина;
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Функция НомерЧекаДляДокумента(ТекущийЧек)
	КлючЧека = ТекущийЧек.КлючЧека;
	НомерЧекаККМ = ТекущийЧек.НомерЧекаККМ;
	
	Если НомерЧекаККМ<>0 Тогда
		Возврат НомерЧекаККМ;
	КонецЕсли;	
	
	Возврат ПодключаемоеОборудованиеБГУ.НомерЧекаГруппыПлатежей(Объект.Ссылка, КлючЧека);
КонецФункции

&НаСервере
Функция ДанныеЧекаДляДокумента(ТекущийЧек)
	Возврат ПодключаемоеОборудованиеБГУ.ДанныеЧекаГруппыПлатежей(Объект.Ссылка, , ТекущийЧек.НомерЧекаККМ);
КонецФункции

&НаСервере
Функция ЗаключительныйЧекИсправительный(ДокументСсылка, НомерЧекаККМ)
	
	Возврат ПодключаемоеОборудованиеБГУ.ЗаключительныйЧекИсправительный(ДокументСсылка, НомерЧекаККМ);

КонецФункции

&НаСервере
Процедура ЗаписатьФискальныеДанныеДляРасчетногоДокумента(НомерЧека, ТипРасчета, КлючЧека)
	ПараметрыФискализации = Новый Структура;
	ПараметрыФискализации.Вставить("ДатаВремяЧека", ТекущаяДата());
	ПараметрыФискализации.Вставить("ДокументОснование", Объект.Ссылка);
	ПараметрыФискализации.Вставить("Организация", Объект.Организация);
	ПараметрыФискализации.Вставить("ТипРасчета", ТипРасчета);
	ПараметрыФискализации.Вставить("НомерСменыККТ", 1);
	ПараметрыФискализации.Вставить("ТорговыйОбъект", "");
	ПараметрыФискализации.Вставить("КорректируемыйДокумент", "");
	ПараметрыФискализации.Вставить("НомерЧекаККТ", НомерЧека);
	ПараметрыФискализации.Вставить("ФискальныйПризнак", Строка(НомерЧека));
	ПараметрыФискализации.Вставить("ТипДокумента", Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек);
	ПараметрыФискализации.Вставить("АдресСайтаПроверки", "");
	ПараметрыФискализации.Вставить("ЗаводскойНомерФН", "");
	ПараметрыФискализации.Вставить("РегистрационныйНомерККТ", "");
	ПараметрыФискализации.Вставить("ДополнительныйРеквизит", "");
	ПараметрыФискализации.Вставить("ДанныеЧекаXML", Неопределено);
	
	ОбщиеПараметры = ПодготовитьДанныеДляПробитияЧекаДляРасчетногоДокумента(НомерЧека, КлючЧека);
	
	СуммаЧека = 0;
	ОплатаНаличные = 0;
	ОплатаЭлектронно = 0;
	ОплатаПостоплата = 0;
	ОплатаПредоплата = 0;
	
	Для каждого ТекСтрока Из ОбщиеПараметры.ТаблицаОплат Цикл
		СуммаЧека = СуммаЧека + ТекСтрока.Сумма;
		Если ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Наличные Тогда
			ОплатаНаличные = ОплатаНаличные + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Электронно Тогда
			ОплатаЭлектронно = ОплатаЭлектронно + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Предоплата Тогда
			ОплатаПредоплата = ОплатаПредоплата + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Постоплата Тогда
			ОплатаПостоплата = ОплатаПостоплата + ТекСтрока.Сумма;
		КонецЕсли;	
	КонецЦикла;	
	ПараметрыФискализации.Вставить("СуммаЧека", СуммаЧека);
	ПараметрыФискализации.Вставить("ОплатаНаличные", ОплатаНаличные);
	ПараметрыФискализации.Вставить("ОплатаЭлектронно", ОплатаЭлектронно);
	ПараметрыФискализации.Вставить("ОплатаПредоплата", ОплатаПредоплата);
	ПараметрыФискализации.Вставить("ОплатаПостоплата", ОплатаПостоплата);
	
	ПодключаемоеОборудованиеБГУВызовСервера.ЗаписатьФискальнуюОперацию(ПараметрыФискализации, КлючЧека);

КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекСПроверкойСтавокНДС()
	ЕстьУстаревшиеСтавкиНДС = Ложь;
	ПроверитьКассовыйЧекНаУстаревшиеСтавкиНДСНаСервере(Объект.Ссылка, ЕстьУстаревшиеСтавкиНДС);
	
	Если ЕстьУстаревшиеСтавкиНДС Тогда
		ТекстСообщения = НСтр("ru='При формировании кассового чека используется устаревшая ставка НДС. Прервать печать чека?'");
		Оповещение = Новый ОписаниеОповещения("ПрерватьПечатьКассовогоЧекаПриЗамечаниях", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
	Иначе
		ПробитьЧекиНаКлиенте();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПрерватьПечатьКассовогоЧекаПриЗамечаниях(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		ПробитьЧекиНаКлиенте();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПроверитьКассовыйЧекНаУстаревшиеСтавкиНДСНаСервере(ДокументПечатиЧека, ЕстьУстаревшиеСтавкиНДС)
	
	УстаревшиеСтавкиНДС = ПодключаемоеОборудованиеБГУ.УстаревшиеСтавкиНДС();
	ТаблицаНоменклатуры = ДокументПечатиЧека.НоменклатураЧековККМ.Выгрузить();
	ТаблицаНоменклатуры.Свернуть("СтавкаНДС");
	Для каждого ТекСтрока Из ТаблицаНоменклатуры Цикл
		Если НЕ УстаревшиеСтавкиНДС.Найти(ТекСтрока.СтавкаНДС) = Неопределено Тогда
			ЕстьУстаревшиеСтавкиНДС = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

#Область ОбработчикиСобытийПроцессыОбработкиДокументов

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента(Команда)
	ОбщегоНазначенияБГУКлиент.ВыполнитьЗадачу(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение(Контекст, ДополнительныеПараметры) Экспорт
	ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст);
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры, Контекст);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст)
	ОбщегоНазначенияБГУ.ВыполнитьЗадачу(ЭтотОбъект, Контекст, Объект);
КонецПроцедуры

