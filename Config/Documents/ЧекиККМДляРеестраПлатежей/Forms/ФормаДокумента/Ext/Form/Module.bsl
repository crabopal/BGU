	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументыЧекаККМПерезаполнитьСписокУдержанийПоРеализации",
		"Видимость",ВидимостьДокументовРасчетаССотрудниками И Объект.ДляСпискаКонтрагентовПоРеализации);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаСписокКонтрагентовСотрудников",
		"Видимость", ВидимостьДокументовРасчетаССотрудниками И Объект.ДляСпискаКонтрагентовПоРеализации);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаНапечататьЧеки",
		"Видимость", Объект.СуммаДокумента > 0 И Объект.СуммаДокумента <> Объект.СуммаФискализированныхЧековККМ);
	
	Если Объект.ФормироватьЧекиПоКаждомуПлатежуРеестра Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПлатежиКонтрагентовСформироватьДанныеДляЧековККМПоПлательщикам",	"Видимость", Ложь);
	КонецЕсли;	
	
	ДанныеУведомления = ДанныеУведомления();
	Элементы.ДекорацияТекстУведомления.Заголовок = ДанныеУведомления.ТекстУведомления;
	Элементы.ДекорацияТекстУведомления.ЦветТекста = ?(ДанныеУведомления.ЭтоПроблема, ЦветаСтиля["ПоясняющийОшибкуТекст"], ЦветаСтиля["РезультатУспехЦвет"]);
	
КонецПроцедуры	

&НаСервере
Функция ПоместитьТаблицуЧековККМДляПлатежаВХранилище(МассивЧековОтбора)
	
	ТаблицаЧековККМ = Новый ТаблицаЗначений;
	ТаблицаЧековККМ.Колонки.Добавить("КлючЧека", Новый ОписаниеТипов("Строка"));
	ТаблицаЧековККМ.Колонки.Добавить("ТекстОписанияЧекаККМ", Новый ОписаниеТипов("Строка"));

	Для каждого ТекКлючЧека Из МассивЧековОтбора Цикл
		ТекСтрока = ЧекККМПоКлючуЧека(ТекКлючЧека);
		ТекстОписанияЧекаККМ = ТекстОписанияЧекаККМ(ТекСтрока, ВалютаРубли);
		
		НоваяСтрока = ТаблицаЧековККМ.Добавить();
		НоваяСтрока.КлючЧека = ТекКлючЧека;
		НоваяСтрока.ТекстОписанияЧекаККМ = ТекстОписанияЧекаККМ;
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаЧековККМ);

КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьКнопокПроведенияКлиент()
	
	УстановитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекиВыполнить(ОповещениеПриЗавершении)
	
	ПараметрыКассыККМ         = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.КассаККМ);
	ИдентификаторУстройстваФР = ПараметрыКассыККМ.ИдентификаторУстройства;
	
	ИспользоватьКассуККМБезПодключенияОборудования = ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	ИспользоватьБезПримененияККТ = Ложь;
	Если ИспользоватьКассуККМБезПодключенияОборудования Тогда
		ИспользоватьБезПримененияККТ = ПараметрыКассыККМ.ИспользоватьБезПримененияККТ;
	КонецЕсли;
	
	Для каждого ТекСтрока Из Объект.ЧекиККМ Цикл
		
		НомерКассовогоЧека = ТекСтрока.НомерЧекаККМ;
		
		Если НЕ ТекСтрока.НеПробиватьЧекККМ Тогда
			
			Если НЕ ЗначениеЗаполнено(НомерКассовогоЧека) Тогда
				ПробитьЧекВыполнить(ТекСтрока, ПараметрыКассыККМ, ИдентификаторУстройстваФР, ИспользоватьКассуККМБезПодключенияОборудования, ОповещениеПриЗавершении);
				Если НЕ ИспользоватьБезПримененияККТ Тогда
					Прервать;
				КонецЕсли;
			Иначе
				ЗаключительныйЧекИсправительный = ЗаключительныйЧекИсправительный(Объект.Ссылка, НомерКассовогоЧека);
				Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
					ПробитьЧекВыполнить(ТекСтрока, ПараметрыКассыККМ, ИдентификаторУстройстваФР, ИспользоватьКассуККМБезПодключенияОборудования, ОповещениеПриЗавершении, Истина);
					Прервать;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	
	Если ИспользоватьБезПримененияККТ Тогда
		Подключаемый_ВыполнитьКоманду(ЭтотОбъект.Команды.Найти("ПодменюПечатьОбычное__РасчетныйДокументБезККТ"));
		
		ЭтотОбъект.Доступность = Истина;
		УстановитьДоступностьКнопокПроведенияКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекВыполнить(ТекЧекККМ, ПараметрыКассыККМ, ИдентификаторУстройстваФР, ИспользоватьКассуККМБезПодключенияОборудования, ОповещениеПриЗавершении, ПечатьИсправленногоЧека = Ложь)
	НомерСтроки = ТекЧекККМ.НомерСтроки;
	
	Если ПечатьИсправленногоЧека Тогда
		НомерКассовогоЧека = 0;
	Иначе	
		НомерКассовогоЧека = ТекЧекККМ.НомерЧекаККМ;
	КонецЕсли;
	
	Если НомерКассовогоЧека <> 0 Тогда
		ТекстСообщения = НСтр("ru = 'Чек № %1 уже пробит на фискальном регистраторе!'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомерСтроки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	ПодключаемоеОборудованиеБГУКлиент.ЗаполнитьНомерДокументаКассыККМ(Объект.КассаККМ); 
	НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
	ПорядковыйНомерПродажи = НомерДокументаКассыККМ[Объект.КассаККМ];
	
	Если ИспользоватьКассуККМБезПодключенияОборудования Тогда
		ИспользоватьБезПримененияККТ = ПараметрыКассыККМ.ИспользоватьБезПримененияККТ;
		
		Если ИспользоватьБезПримененияККТ Тогда
			
			ЗаписатьФискальныеДанныеДляРасчетногоДокумента(ПорядковыйНомерПродажи, ТекЧекККМ.ТипРасчета, ТекЧекККМ.КлючЧека);
			
			ТекЧекККМ.НомерЧекаККМ  = ПорядковыйНомерПродажи;
			
			Модифицированность = Истина;
			РезультатЗаписи = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, РезультатЗаписи = Истина);
			
			Если РезультатЗаписи = Истина Тогда
				НомерДокументаКассыККМ[Объект.КассаККМ] = ТекЧекККМ.НомерЧекаККМ + 1;
			КонецЕсли;
		Иначе
			ТекстСообщения = НСтр("ru = 'Для включения возможности печати расчетных документов следует включить 
			|флажок ""Использовать для печати расчетных документов без применения ККТ"" 
			|у кассы, которая указана в реквизите ""Касса ККМ"".'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
		КонецЕсли;	
		
		Возврат;
	КонецЕсли;

	Если ИдентификаторУстройстваФР <> Неопределено Тогда
		
		// Готовим данные
		НомерЧека = ПорядковыйНомерПродажи;
		ОбщиеПараметры    = ПодготовитьДанныеДляПробитияЧека(НомерСтроки);
		
		Контекст = Новый Структура();
		Контекст.Вставить("ОповещениеПриЗавершении", ОповещениеПриЗавершении);
		Контекст.Вставить("ТекЧекККМ", ТекЧекККМ);
		
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекВыполнитьЗавершение", ЭтотОбъект, Контекст);
		
		ДополнительныеПараметры = МенеджерОборудованияКлиентСервер.ДополнительныеПараметрыОперации();
   		ДополнительныеПараметры.ОповещениеПослеОткрытииЧека = Новый ОписаниеОповещения("ПечатьЧека_ПослеОткрытияЧека", ЭтотОбъект, Контекст);
    	ДополнительныеПараметры.ОповещениеПриОшибкеПечатиЧека = Новый ОписаниеОповещения("ПечатьЧека_ПослеОшибкиПечатиЧека", ЭтотОбъект, Контекст);
				
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(Оповещение, 
										УникальныйИдентификатор, 
										ИдентификаторУстройстваФР,
										ОбщиеПараметры, 
										ДополнительныеПараметры);
			
	Иначе
		ТекстСообщения = НСтр("ru = 'Устройство для печати чеков не выбрано.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекВыполнитьЗавершение(РезультатВыполнения, Параметры) Экспорт
	ТекЧекККМ	= Параметры.ТекЧекККМ;
	
	Если РезультатВыполнения.Результат Тогда
		
		// Установить полученное значение номера чека реквизиту документа.
		ТекЧекККМ.НомерЧекаККМ  = РезультатВыполнения.НомерЧекаККТ;
		
		Модифицированность = Истина;
		
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Запись);
		РезультатЗаписи = Записать(ПараметрыЗаписи);
		
		ВыполнитьОбработкуОповещения(Параметры.ОповещениеПриЗавершении, РезультатЗаписи);
		
		Если ТекЧекККМ.НомерСтроки < Объект.ЧекиККМ.Количество() Тогда
			
			ПодключитьОбработчикОжидания("ПробитьЧекиККМНаКлиенте", 1, Истина);
			
		Иначе
			ЭтотОбъект.Доступность = Истина;
			УстановитьДоступностьКнопокПроведенияКлиент();
		КонецЕсли;
	Иначе
		ТекстСообщения = НСтр("ru = 'При печати чека № %1 произошла ошибка.
		                            |Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекЧекККМ.НомерСтроки);
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(Параметры.ОповещениеПриЗавершении, Ложь);
	КонецЕсли;

КонецПроцедуры

