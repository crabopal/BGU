КонецПроцедуры

&НаКлиенте
Процедура ДокументыЧекаККМДокументОснованиеЧекаККМПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДокументыЧекаККМ.ТекущиеДанные;
	
	СуммаДокументаЧекаККМ = СуммаДокументаЧекаККМ(ТекущиеДанные.ДокументОснованиеЧекаККМ);
	ТекущиеДанные.Сумма = СуммаДокументаЧекаККМ;
КонецПроцедуры

&НаКлиенте
Процедура ДляСпискаКонтрагентовПоРеализацииПриИзменении(Элемент)
	УстановитьВидимостьЭлементовФормы();
КонецПроцедуры

&НаКлиенте
Процедура ДокументыГруппыЧековККМДокументОснованиеЧековККМПриИзменении(Элемент)
	ДокументыГруппыЧековККМДокументОснованиеЧековККМПриИзмененииНаСервере();
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НапечататьЧеки(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.ЧекиККМ.Количество()) Тогда
		ТекстСообщения = НСтр("ru = 'Не подготовлены кассовые чеки. Следует использовать команду из подменю ""Подготовить данные для чеков ККМ"" для списка платежей контрагентов!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ПлатежиКонтрагентов");
		
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.Модифицированность Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Операция возможна только после сохранения документа'"));
		Возврат;
	КонецЕсли;
	
	ПробитьЧекСПроверкойСтавокНДС();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДанныеДляЧековККМПоПлательщикам(Команда)
	
	Если Объект.СуммаФискализированныхЧековККМ > 0 тогда
		ТекстСообщения = НСтр("ru = 'Есть фискализированные чеки. Операция не выполнена.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
		
		Возврат;
	КонецЕсли;	
	
	СформироватьДанныеДляЧековККМПоПлательщикамНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДанныеДляЧековККМПоКонтрагентам(Команда)
	
	Если Объект.СуммаФискализированныхЧековККМ > 0 тогда
		ТекстСообщения = НСтр("ru = 'Есть фискализированные чеки. Операция не выполнена.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
		
		Возврат;
	КонецЕсли;	
	
	СформироватьДанныеДляЧековККМПоКонтрагентамНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНоменклатуруПлатежа(Команда)
	ЗаполнитьНоменклатуруПлатежаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодРасчетов(Команда)
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("НачалоПериода",	Объект["НачалоРасчетногоПериода"]);
	СтруктураПараметров.Вставить("КонецПериода",	Объект["ОкончаниеРасчетногоПериода"]);
	
	СтандартныеОтчетыКлиент.ВыборПериодаОтчета(СтруктураПараметров, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодРасчетовДляНачислений(Команда)
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("НачалоПериода",	Объект["НачалоРасчетногоПериодаНачисления"]);
	СтруктураПараметров.Вставить("КонецПериода",	Объект["ОкончаниеРасчетногоПериодаНачисления"]);
	
	СтандартныеОтчетыКлиент.ВыборПериодаОтчета(СтруктураПараметров, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокДокументовРасчетаССотрудниками(Команда)
	Если Объект.ВидОперации = 3 Тогда
		ЗаполнитьСписокДокументовНаПередачуДляСотрудниковНаСервере();
	Иначе	
		ЗаполнитьСписокДокументовРасчетаССотрудникамиНаСервере(ЗаполнятьПоВсемДокументамРеализации);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДанныеДляЧековККМПоДокументамРасчетовССотрудниками(Команда)
	
	Если Объект.СуммаФискализированныхЧековККМ > 0 тогда
		ТекстСообщения = НСтр("ru = 'Есть фискализированные чеки. Операция не выполнена.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
		
		Возврат;
	КонецЕсли;	
	
	Если Объект.ВидОперации = 1 Тогда
		СформироватьДанныеДляЧековККМПоСотрудникамНаСервере();
	ИначеЕсли Объект.ВидОперации = 2 Тогда
		СформироватьДанныеДляЧековККМПоКонтрагентамНаСервере();
	ИначеЕсли Объект.ВидОперации = 3 Тогда
		СформироватьДанныеДляЧековККМНаПередачуПоСотрудникамНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокДокументовОтражениеЗарплатыВУчете(Команда)
	ЗаполнитьСписокДокументовОтражениеЗарплатыВУчетеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокУдержанийПоОтражениямЗарплатыВУчете(Команда)
	ЗаполнитьСписокУдержанийПоОтражениямЗарплатыВУчетеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьСписокУдержанийПоРеализации(Команда)
	ЗаполнитьСписокУдержанийПоДокументамРеализацииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокДокументовРасчетаНачисления(Команда)
	ЗаполнитьСписокДокументовРасчетаНачисленияНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЭквайринговыеОперацииДляОплатыЭСП(Команда)
	СоздатьЭквайринговыеОперацииДляОплатыЭСПНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоЭквайринговымОперациямЗаДень(Команда)
	ЗаполнитьПоЭквайринговымОперациямЗаДеньНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДанныеДляЧековККМПоЭквайринговымОперациям(Команда)
	СформироватьДанныеДляЧековККМПоЭквайринговымОперациямНаСервере();
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом(Команда)
	ОбменСАрхивомКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Объект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыМатериалы

&НаКлиенте
Процедура ПлатежиКонтрагентовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущаяСтрока = Элементы.ПлатежиКонтрагентов.ТекущиеДанные;
	
	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		Возврат;
	КонецЕсли;

	Если НоваяСтрока ИЛИ Копирование Тогда
		ТекущаяСтрока.КлючСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;	
	
	ТекущаяСтрока.ЧекиККМКонтрагента = НСтр("ru = 'Не подготовлен'");
	
КонецПроцедуры

&НаКлиенте
Процедура ПлатежиКонтрагентовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ПлатежиКонтрагентовЧекиККМКонтрагента" Тогда
		Если ЭтаФорма.Модифицированность Тогда
			ПоказатьПредупреждение( , НСтр("ru = 'Операция возможна только после сохранения документа'"));
			Возврат;
		КонецЕсли;
		
		Если Объект.ФормироватьЧекиПоКаждомуПлатежуРеестра ИЛИ Объект.ВидОперации = 2 Тогда
			ТекущаяСтрока = Элементы.ПлатежиКонтрагентов.ТекущиеДанные;
			ОткрытьФормуЧекаККМ(ВыбраннаяСтрока, ТекущаяСтрока.КлючСтроки);
		Иначе	
			ОткрытьФормуЧекаККМ(ВыбраннаяСтрока);
		КонецЕсли;
	
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРасшифровкаПлатежейКонтрагентов

&НаКлиенте
Процедура РасшифровкаПлатежейКонтрагентовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ТекДанныеСтроки = Элементы.РасшифровкаПлатежейКонтрагентов.ТекущиеДанные;
		ТекДанныеСтроки.КлючСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЧекиККМ

&НаКлиенте
Процедура ЧекиККМПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущаяСтрока = Элементы.ЧекиККМ.ТекущиеДанные;
	
	Если НоваяСтрока ИЛИ Копирование Тогда
		ТекущаяСтрока.КлючЧека = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

&НаКлиенте
Процедура ЧекиККМПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ЗаполнитьДобавленныеКолонкиТаблиц();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРасшифровкаПлатежейКонтрагентов

&НаКлиенте
Процедура РасшифровкаПлатежейКонтрагентовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "РасшифровкаПлатежейКонтрагентовОтражениеОплатыВУчете" Тогда
		СтандартнаяОбработка = Ложь;
		ТекущиеДанные = Элементы.РасшифровкаПлатежейКонтрагентов.ТекущиеДанные;
		Если ЗначениеЗаполнено(ТекущиеДанные.ОтражениеОплатыВУчете) Тогда
			ПараметрыФормы = Новый Структура("Ключ", ТекущиеДанные.ОтражениеОплатыВУчете);
			ОткрытьФорму("Документ.ЭквайринговаяОперация.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьДанныеДляЧековККМПоКонтрагентамНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Касса ККМ""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
			
		Возврат;		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ.НоменклатураПлатежа) И НЕ Объект.РодительскаяПлата Тогда
		ТекстСообщения = НСтр("ru = 'Чеки для платежей не сформированы.
			|Следует указать значение реквизита ""Номенклатура платежа"" у кассы ККМ на закладке ""Настройки заполнения документов"", заполнить номенклатуру 
			|по кнопке ""Заполнить номенклатуру платежа"" на закладке ""Расшифровка платежей контрагентов"" и повторить попытку!'");
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
		Возврат;		
	КонецЕсли;
	
	Объект.ЧекиККМ.Очистить();
	Объект.НоменклатураЧековККМ.Очистить();
	Объект.ТипЗаполненияЧеков = 1;
	
	РасшифровкаПлатежейДляЧеков = Объект.РасшифровкаПлатежейКонтрагентов.Выгрузить();
	Если Объект.ПлатежиКонтрагентов.Количество() = 0 Тогда
		Объект.ПлатежиКонтрагентов.Загрузить(РасшифровкаПлатежейДляЧеков);	
	КонецЕсли;	
	
	СписокКонтрагентов = Объект.ПлатежиКонтрагентов.Выгрузить();
	
	Если Объект.ФормироватьЧекиПоКаждомуПлатежуРеестра Тогда
		СписокКонтрагентов.Свернуть("КлючСтроки, Контрагент", "Сумма");
	Иначе	
		СписокКонтрагентов.Свернуть("Контрагент", "Сумма");
	КонецЕсли;
	
	СписокПлательщиков = Объект.ПлатежиКонтрагентов.Выгрузить();
	
	ШапкаЧеков = Объект.ЧекиККМ.Выгрузить();
	НоменклатураЧеков = Объект.НоменклатураЧековККМ.Выгрузить();
	ДанныеЧеков = Новый Структура;
	ДанныеЧеков.Вставить("ШапкаЧеков", ШапкаЧеков);
	ДанныеЧеков.Вставить("НоменклатураЧеков", НоменклатураЧеков);
	
	Если Объект.ВидОперации = 2 Тогда
		СписокДокументовРеализации = Объект.ДокументыГруппыЧековККМ.Выгрузить();
		ПодключаемоеОборудованиеБГУ.СформироватьДанныеДляЧековККМПоГруппеКонтрагентов(Объект.КассаККМ,
			СписокДокументовРеализации, ДанныеЧеков, 
			Объект.СистемаНалогообложенияЧекаККМ, Объект.НаправлятьПокупателямЭлектронныеЧеки);
	Иначе	
		Если Объект.ФормироватьЧекиПоКаждомуПлатежуРеестра Тогда
			ПодключаемоеОборудованиеБГУ.СформироватьДанныеДляЧековККМПоКаждомуПлатежуКонтрагентов(Объект.КассаККМ,
				СписокПлательщиков,	СписокКонтрагентов, РасшифровкаПлатежейДляЧеков, ДанныеЧеков, 
				Объект.СистемаНалогообложенияЧекаККМ, Объект.НаправлятьПокупателямЭлектронныеЧеки,
				Объект.РодительскаяПлата);
		Иначе	
			ПодключаемоеОборудованиеБГУ.СформироватьДанныеДляЧековККМПоКонтрагентам(Объект.КассаККМ,
				СписокПлательщиков,	СписокКонтрагентов, РасшифровкаПлатежейДляЧеков, ДанныеЧеков, 
				Объект.СистемаНалогообложенияЧекаККМ, Объект.НаправлятьПокупателямЭлектронныеЧеки,
				Объект.РодительскаяПлата);
		КонецЕсли;
	КонецЕсли;
	
	Объект.ЧекиККМ.Загрузить(ДанныеЧеков.ШапкаЧеков);
	Объект.НоменклатураЧековККМ.Загрузить(ДанныеЧеков.НоменклатураЧеков);
	
	Если Объект.ВидОперации = 2 Тогда
		Объект.ПлатежиКонтрагентов.Очистить();
		Для каждого ТекСтрока Из Объект.ЧекиККМ Цикл
			НоваяСтрока = Объект.ПлатежиКонтрагентов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.КлючСтроки = ТекСтрока.КлючЧека;
		КонецЦикла;	
	КонецЕсли;	
	
	Если ИспользоватьНастройкиПлатежногоАгента Тогда
		Для каждого ТекСтрока Из Объект.ЧекиККМ Цикл
			Если НЕ ЗначениеЗаполнено(ТекСтрока.ПараметрыДоговораПлатежногоАгента)
				И НЕ Объект.РодительскаяПлата Тогда
					ТекСтрока.ПараметрыДоговораПлатежногоАгента = ПараметрыДоговораПлатежногоАгента;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
	ЗаполнитьДанныеДляНаправленияПокупателямЭлектронныхЧеков();
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДанныеДляЧековККМПоПлательщикамНаСервере()
	Объект.ЧекиККМ.Очистить();
	Объект.НоменклатураЧековККМ.Очистить();
	Объект.ТипЗаполненияЧеков = 2;
	
	РасшифровкаПлатежейДляЧеков = Объект.РасшифровкаПлатежейКонтрагентов.Выгрузить();
	СписокПлательщиков = Объект.ПлатежиКонтрагентов.Выгрузить();
	СписокПлательщиков.Свернуть("Плательщик", "Сумма");

	СписокКонтрагентов = Объект.ПлатежиКонтрагентов.Выгрузить();
	
	ШапкаЧеков = Объект.ЧекиККМ.Выгрузить();
	НоменклатураЧеков = Объект.НоменклатураЧековККМ.Выгрузить();
	ДанныеЧеков = Новый Структура;
	ДанныеЧеков.Вставить("ШапкаЧеков", ШапкаЧеков);
	ДанныеЧеков.Вставить("НоменклатураЧеков", НоменклатураЧеков);
	
	ПодключаемоеОборудованиеБГУ.СформироватьДанныеДляЧековККМПоПлательщикам(Объект.КассаККМ,
		СписокПлательщиков, СписокКонтрагентов, РасшифровкаПлатежейДляЧеков, ДанныеЧеков, 
		Объект.СистемаНалогообложенияЧекаККМ, Объект.НаправлятьПокупателямЭлектронныеЧеки,
		Объект.РодительскаяПлата);
	
	Объект.ЧекиККМ.Загрузить(ДанныеЧеков.ШапкаЧеков);
	Объект.НоменклатураЧековККМ.Загрузить(ДанныеЧеков.НоменклатураЧеков);
	
	ЗаполнитьДанныеДляНаправленияПокупателямЭлектронныхЧеков();
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеДляНаправленияПокупателямЭлектронныхЧеков()
	Для каждого ТекЧек Из Объект.ЧекиККМ Цикл
		Плательщик = ТекЧек.Плательщик;
		
		Если Объект.НаправлятьПокупателямЭлектронныеЧеки Тогда
			АдресЭП = ПодключаемоеОборудованиеБГУВызовСервера.ПервыйАдресЭлектроннойПочтыПокупателя(Плательщик);
			Если ЗначениеЗаполнено(АдресЭП) Тогда
				ТекЧек.АдресЭлектроннойПочты = АдресЭП;
			Иначе
				ТекЧек.АбонентскийНомерТелефона = ПодключаемоеОборудованиеБГУВызовСервера.ПервыйНомерТелефонаПокупателя(Плательщик);
			КонецЕсли;	
		Иначе
			ТекЧек.АдресЭлектроннойПочты = "";
			ТекЧек.АбонентскийНомерТелефона = "";
		КонецЕсли;	
	КонецЦикла;	
		
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
	
	УстановитьФункциональныеОпцииФормы();
	
	РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	НастройкиОборудования = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьНастройкиОборудования(РабочееМесто, Объект.Организация);
	
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		Объект.СистемаНалогообложенияЧекаККМ = Объект.КассаККМ.СистемаНалогообложенияЧекаККМ;
	КонецЕсли;
	
	СписокВидовНалогообложения = ПодключаемоеОборудованиеБГУ.ПереченьСистемНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	Элементы.СистемаНалогообложенияЧекаККМ.СписокВыбора.ЗагрузитьЗначения(СписокВидовНалогообложения);
	Элементы.СистемаНалогообложенияЧекаККМ.РежимВыбораИзСписка = Истина;
	
	ИспользуетсяККТСПередачейДанных = ПодключаемоеОборудованиеБГУ.ИспользуетсяККТСПередачейДанных(Объект.КассаККМ);
	
	ПараметрыДоговораПлатежногоАгента = НастройкиОборудования.ПараметрыДоговораПлатежногоАгента;
	
	УстановитьВидимостьЭлементовФормы();
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()
	
	// Колонка ЧекиККМКонтрагента в ПлатежиКонтрагентов
	Если Объект.ЧекиККМ.Количество() = 0 Тогда
		Для каждого ТекСтрока Из Объект.ПлатежиКонтрагентов Цикл
			ТекСтрока.ЧекиККМКонтрагента = НСтр("ru = 'Не подготовлен'");
		КонецЦикла;
	Иначе
		Для каждого ТекСтрока Из Объект.ПлатежиКонтрагентов Цикл
			Если Объект.ФормироватьЧекиПоКаждомуПлатежуРеестра ИЛИ (Объект.ВидОперации = 2) ИЛИ (Объект.ВидОперации = 3) Тогда
				КлючСвязи = ТекСтрока.КлючСтроки;
			Иначе	
				Если (Объект.ТипЗаполненияЧеков = 1)ИЛИ(Объект.ТипЗаполненияЧеков = 3) Тогда
					КлючСвязи = ТекСтрока.Контрагент;
				ИначеЕсли Объект.ТипЗаполненияЧеков = 2 Тогда
					КлючСвязи = ТекСтрока.Плательщик;
				КонецЕсли;
			КонецЕсли;
			
			МассивЧеков = СведенияОЧекеККМ(КлючСвязи);
			
			ТекСтрока.ЧекиККМКонтрагента = ОписаниеЧекаККМ(МассивЧеков, ВалютаРубли);
			ТекСтрока.КонтактнаяИнформация = СведенияОКонтактахИзЧекаККМ(МассивЧеков);
		КонецЦикла;
	КонецЕсли;	
	
	ДанныеОбЭквайринговыхОперацияхДокумента = ДанныеОбЭквайринговыхОперацияхДокумента();
	Если ДанныеОбЭквайринговыхОперацияхДокумента <> Неопределено Тогда
		Для каждого ТекСтрока Из Объект.РасшифровкаПлатежейКонтрагентов Цикл
			ПараметрыОтбораЭО = Новый Структура("КлючСтроки", ТекСтрока.КлючСтроки); 	
			МассивЭО = ДанныеОбЭквайринговыхОперацияхДокумента.НайтиСтроки(ПараметрыОтбораЭО);

			Для каждого ТекЭО Из МассивЭО Цикл
				ТекСтрока.ОтражениеОплатыВУчете = ТекЭО.Ссылка;
				
				Прервать;
			КонецЦикла;	
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СведенияОЧекеККМ(Контрагент)
	Результат = Неопределено;
	
	Если Объект.ФормироватьЧекиПоКаждомуПлатежуРеестра ИЛИ Объект.ВидОперации = 2  ИЛИ Объект.ВидОперации = 3 Тогда
		ПараметрыОтбора = Новый Структура("КлючЧека", Контрагент); 	
	Иначе	
		Если (Объект.ТипЗаполненияЧеков = 1)ИЛИ(Объект.ТипЗаполненияЧеков = 3) Тогда
			ПараметрыОтбора = Новый Структура("Контрагент", Контрагент); 	
		ИначеЕсли Объект.ТипЗаполненияЧеков = 2 Тогда
			ПараметрыОтбора = Новый Структура("Плательщик", Контрагент); 	
		КонецЕсли;
	КонецЕсли;
	
	МассивЧековОтбора = Объект.ЧекиККМ.НайтиСтроки(ПараметрыОтбора);
	
	Если МассивЧековОтбора.Количество()>0 Тогда
		Результат = МассивЧековОтбора;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ОписаниеЧекаККМ(МассивЧеков, ВалютаРубли)
	Результат = "";
	
	Если МассивЧеков = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Если МассивЧеков.Количество() = 1 Тогда
		ТекЧекККМ = МассивЧеков[0];
		Результат = ТекстОписанияЧекаККМ(ТекЧекККМ, ВалютаРубли);
	Иначе	
		Результат = НСтр("ru = 'Подготовлены чеки № '");
		СтрокаЗамены = НСтр("ru = 'Подготовлен чек №'");
		Для каждого ТекЧекККМ Из МассивЧеков Цикл
			Результат = Результат + СтрЗаменить(ТекстОписанияЧекаККМ(ТекЧекККМ, ВалютаРубли), СтрокаЗамены, "") + "; ";
		КонецЦикла;
	КонецЕсли;
	
	Возврат СокрЛП(Результат);
КонецФункции

&НаСервере
Функция ТекстОписанияЧекаККМ(ТекЧекККМ, ВалютаРубли)
	Результат = "";
	
	НомерКассовогоЧека = НомерЧекаДляДокумента(ТекЧекККМ);
	
	ДанныеЧека = ДанныеЧекаДляДокумента(ТекЧекККМ);
	
	Если ЗначениеЗаполнено(НомерКассовогоЧека) Тогда
		ЗаключительныйЧекИсправительный = ЗаключительныйЧекИсправительный(Объект.Ссылка, НомерКассовогоЧека);
		СуммаОписанияЧекаККМ = Формат(ДанныеЧека.СуммаЧекаККМ, "ЧЦ=15; ЧДЦ=2");
		Если Объект.ВидОперации = 2 Тогда
			Если ДанныеЧека.ОплатаПредоплата = ТекЧекККМ.СуммаРеализации Тогда
				СуммаОписанияЧекаККМ = "зачет аванса: "+ Формат(ТекЧекККМ.СуммаПредоплаты, "ЧЦ=15; ЧДЦ=2");
			ИначеЕсли ДанныеЧека.ОплатаПредоплата = 0 Тогда
				СуммаОписанияЧекаККМ = "постоплата: "+Формат(ТекЧекККМ.СуммаРеализации - ТекЧекККМ.СуммаПредоплаты, "ЧЦ=15; ЧДЦ=2");
			ИначеЕсли ДанныеЧека.ОплатаПредоплата <> ТекЧекККМ.СуммаРеализации Тогда
				СуммаОписанияЧекаККМ = "зачет аванса: "+ Формат(ДанныеЧека.ОплатаПредоплата, "ЧЦ=15; ЧДЦ=2")+" из "+Формат(ТекЧекККМ.СуммаРеализации, "ЧЦ=15; ЧДЦ=2");
			КонецЕсли;
		ИначеЕсли Объект.ВидОперации = 3 Тогда
			СуммаОписанияЧекаККМ = "постоплата: "+Формат(ТекЧекККМ.СуммаРеализации - ТекЧекККМ.СуммаПредоплаты, "ЧЦ=15; ЧДЦ=2");
		КонецЕсли;	
		Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
			Результат = " Отменен ФД № "+Формат(НомерКассовогоЧека, "ЧГ=")+" от "+Формат(ДанныеЧека.ДатаЧекаККМ, "ДФ='dd.MM.yyyy hh:mm'")+" ("+СуммаОписанияЧекаККМ+" "+СокрЛП(ВалютаРубли)+")";
		Иначе
			Результат = " Пробит ФД № "+Формат(НомерКассовогоЧека, "ЧГ=")+" от "+Формат(ДанныеЧека.ДатаЧекаККМ, "ДФ='dd.MM.yyyy hh:mm'")+" ("+СуммаОписанияЧекаККМ+" "+СокрЛП(ВалютаРубли)+")";
		КонецЕсли;	
		
	Иначе
		СуммаОписанияЧекаККМ = Формат(ТекЧекККМ.Сумма, "ЧЦ=15; ЧДЦ=2");
		Если Объект.ВидОперации = 2 Тогда
			Если ТекЧекККМ.СуммаПредоплаты = ТекЧекККМ.СуммаРеализации Тогда
				СуммаОписанияЧекаККМ = "зачет аванса: "+ Формат(ТекЧекККМ.СуммаПредоплаты, "ЧЦ=15; ЧДЦ=2");
			ИначеЕсли ТекЧекККМ.СуммаПредоплаты = 0 Тогда
				СуммаОписанияЧекаККМ = "постоплата: "+Формат(ТекЧекККМ.СуммаРеализации - ТекЧекККМ.СуммаПредоплаты, "ЧЦ=15; ЧДЦ=2");
			ИначеЕсли ТекЧекККМ.СуммаПредоплаты <> ТекЧекККМ.СуммаРеализации Тогда
				СуммаОписанияЧекаККМ = "зачет аванса: "+ Формат(ТекЧекККМ.СуммаПредоплаты, "ЧЦ=15; ЧДЦ=2")+" из "+Формат(ТекЧекККМ.СуммаРеализации, "ЧЦ=15; ЧДЦ=2");
			КонецЕсли;	
		ИначеЕсли Объект.ВидОперации = 3 Тогда
			СуммаОписанияЧекаККМ = "постоплата: "+Формат(ТекЧекККМ.СуммаРеализации - ТекЧекККМ.СуммаПредоплаты, "ЧЦ=15; ЧДЦ=2");
		КонецЕсли;	
			
		Результат = " Подготовлен чек №"+ СокрЛП(ТекЧекККМ.НомерСтроки) +" ("+СуммаОписанияЧекаККМ+" "+СокрЛП(ВалютаРубли)+")";
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

&НаСервере
Функция СведенияОКонтактахИзЧекаККМ(МассивЧеков)
	Результат = "";
	
	Если МассивЧеков<>Неопределено Тогда
		Для каждого ТекЧекККМ Из МассивЧеков Цикл
			Если ЗначениеЗаполнено(ТекЧекККМ.АдресЭлектроннойПочты) Тогда
				Результат = Результат + " " + ТекЧекККМ.АдресЭлектроннойПочты;
			ИначеЕсли ЗначениеЗаполнено(ТекЧекККМ.АбонентскийНомерТелефона) Тогда
				Результат = Результат + " " + ТекЧекККМ.АбонентскийНомерТелефона;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СокрЛП(Результат);
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуЧекаККМ(ВыбранноеЗначение, КлючЧека = "")
	Если ЗначениеЗаполнено(КлючЧека) Тогда
		МассивЧековОтбора = Новый Массив;
	    МассивЧековОтбора.Добавить(КлючЧека);
	Иначе	
		Если ВыбранноеЗначение = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ДанныеСтроки = Объект.ПлатежиКонтрагентов.НайтиПоИдентификатору(ВыбранноеЗначение);
		Если ДанныеСтроки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ДанныеСтроки.ЧекиККМКонтрагента = НСтр("ru = 'Не подготовлен'") 
			ИЛИ НЕ ЗначениеЗаполнено(ДанныеСтроки.ЧекиККМКонтрагента) Тогда
			Если Объект.ВидОперации = 0 Тогда
				ТекстСообщения = НСтр("ru = 'Чек для данного платежа не подготовлен! Следует использовать команду из подменю ""Подготовить данные для чека ККМ"".'");
			ИначеЕсли Объект.ВидОперации = 1 Тогда
				ТекстСообщения = НСтр("ru = 'Чек для данного удержания не подготовлен! Следует использовать команду ""Заполнить сведения чеков ККМ"".'");
			КонецЕсли;	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		МассивЧековОтбора = МассивЧековОтбора(ДанныеСтроки.Контрагент, ДанныеСтроки.Плательщик);
	
	Конецесли;	
		
	ПараметрыФормы = Новый Структура("КассаККМ, Дата, Организация, КлючЧека, Сумма, СуммаПредоплаты, СуммаРеализации,
		|Контрагент, Плательщик, ТипРасчета, ПараметрыДоговораПлатежногоАгента, НомерСменыККМ, ФискальныйПризнак, 
		|СтатусЧекаККМ, СистемаНалогообложенияЧекаККМ, Телефон, АдресЭП, НомерЧекаККМ,
		|ОтказКлиентаОтСохраненияТелефонаEmail, РодительскаяПлата, ИспользуетсяККТСПередачейДанных,
		|АдресНоменклатурыЧекаВХранилище, ВалютаРубли, ИспользоватьНастройкиПлатежногоАгента,
		|ИспользоватьКассуККМБезПодключенияОборудования, ДатаЧекаККМ, НомерСтрокиЧека, ДокументЧекиККМ,
		|НаправлятьПокупателямЭлектронныеЧеки, НеНаправлятьПокупателюЭлектронныйЧек, КомментарийКЧекуККМ, НеПробиватьЧекККМ, ВводДанныхЧекаВручную");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	
	ПараметрыФормы.ВалютаРубли = ВалютаРубли;
	
	Если МассивЧековОтбора.Количество() = 1 Тогда
		Для каждого ТекЧек Из МассивЧековОтбора Цикл
			ТекСтрока = ЧекККМПоКлючуЧека(ТекЧек);
			ЗаполнитьЗначенияСвойств(ПараметрыФормы, ТекСтрока);
			
			ПараметрыФормы.ДокументЧекиККМ = Объект.Ссылка;
			ПараметрыФормы.НомерСтрокиЧека = ТекСтрока.НомерСтроки;
			
			ПараметрыФормы.ИспользуетсяККТСПередачейДанных = ИспользуетсяККТСПередачейДанных;
			ПараметрыФормы.ИспользоватьНастройкиПлатежногоАгента = ИспользоватьНастройкиПлатежногоАгента;
			ПараметрыФормы.ИспользоватьКассуККМБезПодключенияОборудования = ИспользоватьКассуККМБезПодключенияОборудования;
			
			ДанныеЧека = ДанныеЧекаДляДокумента(ТекСтрока);
			
			Если ДанныеЧека.СуммаЧекаККМ <> 0 Тогда 
				ПараметрыФормы.ДатаЧекаККМ = ДанныеЧека.ДатаЧекаККМ;
				ПараметрыФормы.Сумма = ДанныеЧека.СуммаЧекаККМ;
				ПараметрыФормы.ФискальныйПризнак = ДанныеЧека.ФискальныйПризнак;
			КонецЕсли;
			
			ПараметрыФормы.АдресНоменклатурыЧекаВХранилище = ПоместитьТаблицуНоменклатурыЧекаВХранилище(ТекСтрока);
		КонецЦикла;	
		
		ОткрытьФорму("Документ.ЧекиККМДляРеестраПлатежей.Форма.ФормаЧекаККМ", ПараметрыФормы, ЭтаФорма);
	Иначе
		ПараметрыФормыВыбора = Новый Структура("АдресТаблицыЧековККМДляПлатежаВХранилище");
		ПараметрыФормыВыбора.АдресТаблицыЧековККМДляПлатежаВХранилище = ПоместитьТаблицуЧековККМДляПлатежаВХранилище(МассивЧековОтбора);
		
		ОткрытьФорму("Документ.ЧекиККМДляРеестраПлатежей.Форма.ФормаВыбораЧекаККМ", ПараметрыФормыВыбора, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЧекККМПоКлючуЧека(КлючЧекаККМ)
	Результат = Новый Структура("КлючЧека, Сумма, СуммаПредоплаты, СуммаРеализации, ДатаЧекаККМ, НомерЧекаККМ, НомерСтроки,   
		|Контрагент, Плательщик, ТипРасчета, ПараметрыДоговораПлатежногоАгента, НомерСменыККМ, 
		|СтатусЧекаККМ, СистемаНалогообложенияЧекаККМ, Телефон, АдресЭП, НомерЧекаККМ,
		|ОтказКлиентаОтСохраненияТелефонаEmail, НеНаправлятьПокупателюЭлектронныйЧек, КомментарийКЧекуККМ, НеПробиватьЧекККМ, ВводДанныхЧекаВручную");
	
	ПараметрыОтбора = Новый Структура("КлючЧека", КлючЧекаККМ); 	
	МассивЧековОтбора = Объект.ЧекиККМ.НайтиСтроки(ПараметрыОтбора);
	
	Для каждого ТекСтрока Из МассивЧековОтбора Цикл
		ЗаполнитьЗначенияСвойств(Результат, ТекСтрока);
		
		Прервать;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция МассивЧековОтбора(Контрагент, Плательщик)
	Результат = Новый Массив;
	Если (Объект.ТипЗаполненияЧеков = 1)ИЛИ(Объект.ТипЗаполненияЧеков = 3) Тогда
		ПараметрыОтбора = Новый Структура("Контрагент", Контрагент); 	
	Иначе
		ПараметрыОтбора = Новый Структура("Плательщик", Плательщик); 	
	КонецЕсли;	

	МассивОтбора = Объект.ЧекиККМ.НайтиСтроки(ПараметрыОтбора);
	
	Для каждого ТекСтрока Из МассивОтбора Цикл
		Результат.Добавить(ТекСтрока.КлючЧека);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ПоместитьТаблицуНоменклатурыЧекаВХранилище(ЧекККМ)
	
	СведенияНоменклатураЧекаККМ = Объект.НоменклатураЧековККМ.Выгрузить();
	СведенияНоменклатураЧекаККМ.Очистить();
	
	ПараметрыОтбораНоменклатуры = Новый Структура("КлючЧека", ЧекККМ.КлючЧека); 	
		
	МассивНоменклатурыЧека = Объект.НоменклатураЧековККМ.НайтиСтроки(ПараметрыОтбораНоменклатуры);
	
	Для каждого ТекСтрокаНоменклатуры Из МассивНоменклатурыЧека Цикл
		НоваяСтрокаНоменклатуры = СведенияНоменклатураЧекаККМ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаНоменклатуры, ТекСтрокаНоменклатуры);
	КонецЦикла;	
	
	Возврат ПоместитьВоВременноеХранилище(СведенияНоменклатураЧекаККМ);

КонецФункции

&НаСервере
Процедура УстановитьФункциональныеОпцииФормы()
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрыФункциональныхОпцийФормыДокумента(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаИзмененияДанныхЧека(Знач ВыбранноеЗначение)
	
	ДанныеЧека = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресДанныхЧекаВХранилище);
	
	Если ТипЗнч(ДанныеЧека) = Тип("Структура") Тогда
		КлючЧека = ДанныеЧека.КлючЧека;
		ПараметрыОтбора = Новый Структура("КлючЧека", КлючЧека); 	
		МассивЧековОтбора = Объект.ЧекиККМ.НайтиСтроки(ПараметрыОтбора);
		
		Если МассивЧековОтбора.Количество()>0 Тогда
			ТекЧекККМ = МассивЧековОтбора[0];
			ЗаполнитьЗначенияСвойств(ТекЧекККМ, ДанныеЧека);
			ТекЧекККМ.АбонентскийНомерТелефона = ДанныеЧека.Телефон;
			ТекЧекККМ.АдресЭлектроннойПочты = ДанныеЧека.АдресЭП;
			
			ПараметрыОтбораНоменклатуры = Новый Структура("КлючЧека", КлючЧека); 	
			//удаление номенклатуры чека
			МассивКУдалению = Объект.НоменклатураЧековККМ.НайтиСтроки(ПараметрыОтбораНоменклатуры);
			Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
				Объект.НоменклатураЧековККМ.Удалить(СтрокаКУдалению);
			КонецЦикла;
			
			Для каждого ТекНоменклатура Из ДанныеЧека.НоменклатураЧека Цикл
				НоваяСтрока = Объект.НоменклатураЧековККМ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекНоменклатура);
			КонецЦикла;	
		Иначе	
			ТекстСообщения = НСтр("ru = 'Редактируемый чек не найден!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,);
		КонецЕсли;	
	КонецЕсли;	
	
	ПрочитатьДополнительныеДанныеЧековККМ();
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекиНаКлиенте()
	
	Результат = Ложь;
	ЕстьОшибки = Ложь;
	
	ОчиститьСообщения();
	
	ЕстьОшибки = НЕ ПодключаемоеОборудованиеБГУКлиент.ПроверитьВозможностьПечатиЧека(ЭтотОбъект);
	
	Если НЕ ВсеРеквизитыДляЧекаЗаполнены() Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЕстьОшибки И ПроверитьЗаполнение() Тогда
		
		НомерЧекаВПакете = 0;
		ЭтотОбъект.Доступность = Ложь;
		
		ПробитьЧекиККМНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекиККМНаКлиенте()
	Оповещение = Новый ОписаниеОповещения("ПробитьЧекНаКлиентеЗавершение", ЭтотОбъект);
	ПробитьЧекиВыполнить(Оповещение);
КонецПроцедуры

&НаСервере
Функция ВсеРеквизитыДляЧекаЗаполнены()
	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Касса ККМ""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
			
		Возврат Ложь;	
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Ответственный""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
		
		Результат = Ложь;
	Иначе
		Если НЕ ЗначениеЗаполнено(Объект.Ответственный.ФизическоеЛицо) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Физическое лицо"" у реквизита ""Ответственный""!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
			
			Результат = Ложь;
		Иначе
			КассирККМ = Объект.Ответственный.ФизическоеЛицо;
			Если НЕ Объект.КассаККМ.НеПроверятьИННКассира Тогда
				Если СтрДлина(КассирККМ.ИНН)<12 Тогда
					ТекстСообщения = НСтр("ru = 'Не заполнен ИНН у реквизита ""Физическое лицо"" у реквизита ""Ответственный""!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
					
					Результат = Ложь;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Для каждого ТекСтрока Из Объект.ЧекиККМ Цикл
		НомерСтроки = ТекСтрока.НомерСтроки;
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.СистемаНалогообложенияЧекаККМ) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Система налогообложения"" в чеке № %1!'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомерСтроки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
			
			Результат = Ложь;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ТипРасчета) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Тип расчета"" в чеке № %1!'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомерСтроки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
			
			Результат = Ложь;	
		КонецЕсли;
		
		Если Объект.НаправлятьПокупателямЭлектронныеЧеки Тогда
			Если НЕ ЗначениеЗаполнено(ТекСтрока.АдресЭлектроннойПочты) И 
				НЕ ЗначениеЗаполнено(ТекСтрока.АбонентскийНомерТелефона) И
				НЕ ТекСтрока.НеНаправлятьПокупателюЭлектронныйЧек Тогда 
				ТекстСообщения = НСтр("ru = 'Не заполнены реквизиты ""Адрес эл. почты"" и ""Номер телефона"" в чеке № %1 
				|при включенном флажке ""Направлять покупателям электронные чеки""!'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомерСтроки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
				
				Результат = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекСтрока.Плательщик) Тогда
			ПолучательЧекаККМ = ТекСтрока.Плательщик
		Иначе
			ПолучательЧекаККМ = ТекСтрока.Контрагент
		КонецЕсли;
		Если ЗначениеЗаполнено(ПолучательЧекаККМ) Тогда
			ДанныеЮЛиИП = ПодключаемоеОборудованиеБГУ.ЧекККМДляЮЛилиИП(ПолучательЧекаККМ, Объект.Дата);
			Если ДанныеЮЛиИП.Заполнить Тогда
				Если НЕ ЗначениеЗаполнено(ДанныеЮЛиИП.Получатель) Тогда
					ТекстСообщения = НСтр("ru = 'Контрагент-получатель чека ККМ - юр.лицо или ИП. У контрагента не указано наименование!'");
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Контрагент");
							
					Результат = Ложь;
				КонецЕсли;	
				Если НЕ ЗначениеЗаполнено(ДанныеЮЛиИП.ПолучательИНН) Тогда
					ТекстСообщения = НСтр("ru = 'Контрагент-получатель чека ККМ - юр.лицо или ИП. У контрагента не указан ИНН!'");
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Контрагент");
							
					Результат = Ложь;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
		
		ТаблицаНоменклатуры = ПодключаемоеОборудованиеБГУ.ТаблицаНоменклатурыЧекаККМ(Объект.Ссылка, , НомерСтроки);
		ЕстьПустыеНаименованияТоваровУслуг = Ложь;
		ЕстьПустыеПредметыРасчетаТоваровУслуг = Ложь;
		НомераСтрокПустыхНаименований = "";
		НомераСтрокПустыхПредметовРасчета = "";
		Для каждого ТекСтрокаТовара Из ТаблицаНоменклатуры Цикл
			Если Не ЗначениеЗаполнено(ТекСтрокаТовара.Наименование) Тогда
				ЕстьПустыеНаименованияТоваровУслуг = Истина;
				НомераСтрокПустыхНаименований = НомераСтрокПустыхНаименований + СокрЛП(ТекСтрокаТовара.НомерСтроки)+", ";
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ТекСтрокаТовара.ПризнакПредметаРасчета) Тогда
				ЕстьПустыеПредметыРасчетаТоваровУслуг = Истина;
				НомераСтрокПустыхПредметовРасчета = НомераСтрокПустыхПредметовРасчета + СокрЛП(ТекСтрокаТовара.НомерСтроки)+", ";
			КонецЕсли;
		КонецЦикла;	
		
		Если ЕстьПустыеНаименованияТоваровУслуг Тогда
			НомераСтрокПустыхНаименований = Сред(НомераСтрокПустыхНаименований, 0, СтрДлина(НомераСтрокПустыхНаименований)-2);
			Если НомераСтрокПустыхНаименований = "1" Тогда
				ТекстСообщения = НСтр("ru = 'В строке %1 списка номенклатуры кассового чека № %2 пустое наименование номенклатуры! 
				|Следует указать значение реквизита ""Номенклатура платежа"" у кассы ККМ и заполнить номенклатуру 
				|по кнопке ""Заполнить номенклатуру платежа"" на закладке ""Расшифровка платежей контрагентов"" или
				|перейти по ссылке в графе ""Чеки ККМ"", заполнить номенклатуру и повторить попытку!'");
			Иначе
				ТекстСообщения = НСтр("ru = 'В строках %1 списка номенклатуры кассового чека № %2 пустые наименования номенклатуры!
				|Следует указать значение реквизита ""Номенклатура платежа"" у кассы ККМ и заполнить номенклатуру 
				|по кнопке ""Заполнить номенклатуру платежа"" на закладке ""Расшифровка платежей контрагентов"" или
				|перейти по ссылке в графе ""Чеки ККМ"", заполнить номенклатуру и повторить попытку!'");
			КонецЕсли;	
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомераСтрокПустыхНаименований, НомерСтроки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ПлатежиКонтрагентов");
			
			Результат = Ложь;	
		КонецЕсли;
		
		Если ЕстьПустыеПредметыРасчетаТоваровУслуг Тогда
			НомераСтрокПустыхПредметовРасчета = Сред(НомераСтрокПустыхПредметовРасчета, 0, СтрДлина(НомераСтрокПустыхПредметовРасчета)-2);
			Если НомераСтрокПустыхПредметовРасчета = "1" Тогда
				ТекстСообщения = НСтр("ru = 'В строке %1 списка номенклатуры кассового чека № %2 не заполнен признак предмета расчета! 
				|Следует перейти по ссылке в графе ""Чеки ККМ"", заполнить у номенклатуры реквизит ""Признак предмета расчета"" и повторить попытку!'");
			Иначе
				ТекстСообщения = НСтр("ru = 'В строках %1 списка номенклатуры кассового чека № %2 не заполнен признак предмета расчета!
				|Следует  перейти по ссылке в графе ""Чеки ККМ"", заполнить у номенклатуры реквизит ""Признак предмета расчета"" и повторить попытку!'");
			КонецЕсли;	
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомераСтрокПустыхПредметовРасчета, НомерСтроки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ПлатежиКонтрагентов");
			
			Результат = Ложь;	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПлатежиКонтрагентовКонтактнаяИнформация", 							"Видимость", Объект.НаправлятьПокупателямЭлектронныеЧеки);
