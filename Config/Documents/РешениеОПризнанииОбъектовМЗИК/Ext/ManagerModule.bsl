#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата, Номер, ДокументОснование");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ПериодДвижений", ДанныеДокумента.Дата);
	Запрос.УстановитьПараметр("НомерДокумента",
		ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ДанныеДокумента.Номер));
	
	НомераТаблиц = Новый Структура;
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц, Ложь, ДанныеДокумента.ДокументОснование);
	ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц);
	Результат = Запрос.ВыполнитьПакет();                                     
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);

	БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц, ЭтоКорректировка, КорректируемыйДокумент)

	Запрос.УстановитьПараметр("ИмяДокументаДМ", НСтр("ru = 'Решение о признании объектов НФА (ф. 0510441)'"));
	
	ПараметрыЗапроса = УчетДрагМатериалов.ТекстЗапросаДвиженияНаличиеДрагМатериаловВОбъектахНФА_Параметры(
		"Документ.РешениеОПризнанииОбъектовМЗ.ДрагоценныеМатериалы", "Приход");
	ПараметрыЗапроса.ЭтоКорректировка = ЭтоКорректировка;
	ПараметрыЗапроса.КорректируемыйДокумент = КорректируемыйДокумент;
	
	УчетДрагМатериалов.ИнициализироватьДанныеДокумента(Запрос, НомераТаблиц, ПараметрыЗапроса);
	 
КонецПроцедуры	

Процедура ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("ОтражениеЭДВУчете", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	РегистрыНакопления.ОтражениеЭДВУчете.ТекстЗапросаПоОтражениюЭДВУчете(Запрос.Параметры.Ссылка);
