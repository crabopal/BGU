#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ГолосованиеКомиссии

Процедура ЗаполнитьРезультатГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	ЗаполнитьРезультатыГолосования = Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	Если ЗаполнитьРезультатыГолосования Тогда
		РезультатГолосованияСотрудника = ОбщегоНазначенияБГУ.РезультатыГолосованияСотрудникаПоДокументу(
			Форма.Сотрудник, Объект.Ссылка, Объект.Комиссия, Объект.Организация);
		РезультатГолосованияКомиссии = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(
			Объект.Ссылка, Объект.Комиссия, Объект.Организация);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.Материалы Цикл
		
		СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Неопределено;
		СтрокаТаблицы.ИтогГолосования = 0;
		СтрокаТаблицы.РезолюцияКомиссииОдобрена = Ложь;
		Если ЗаполнитьРезультатыГолосования Тогда
			
			Если РезультатГолосованияСотрудника.Количество() > 0 Тогда
				Результаты = РезультатГолосованияСотрудника.Найти(СтрокаТаблицы.ИдентификаторСтроки, "ИдентификаторСтроки");
				Если Результаты <> Неопределено Тогда
					СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Результаты.РезультатГолосования;
				КонецЕсли;
			КонецЕсли;
			
			Если РезультатГолосованияКомиссии.Количество() > 0 Тогда
				ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки",
					Объект.Ссылка, СтрокаТаблицы.ИдентификаторСтроки);
				РезультатыГолосованияПоСтроке = РезультатГолосованияКомиссии.НайтиСтроки(ОтборПоИдентификаторуСтроки);
				Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
					СтрокаТаблицы.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
					СтрокаТаблицы.РезолюцияКомиссииОдобрена = РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УправлениеЭлементамиГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ДоступностьГолосования = Не Объект.Ссылка.Пустая() И Не Объект.Проведен
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("Сотрудник");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Доступность", ДоступностьГолосования);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеЕдиногласноЗаВоВсехСтроках");
	ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеЕдиногласноПротивВоВсехСтроках");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И Не ЗначениеЗаполнено(Форма.Сотрудник));
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеЗаВоВсехСтроках");
	ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеПротивВоВсехСтроках");
	ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеЗаВВыделенныхСтроках");
	ЭлементыГолосование.Добавить("МатериалыУстановитьРешениеПротивВВыделенныхСтроках");
	ЭлементыГолосование.Добавить("МатериалыРешениеСотрудникаПоРезолюции");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник));
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("СохранитьРезультатыГолосования");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Доступность", ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник) И Форма.РешениеСотрудникаМодифицированность);
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.РешениеОПризнанииОбъектовМЗИК";
	КомандаПечати.Идентификатор		= "Решение";
	КомандаПечати.Представление		= НСтр("ru = 'Решение о признании объектов НФА (ф. 0510441)'");
	КомандаПечати.Порядок			= 1;

	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОСодержанииДрагМатериалов", 3);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Решение") Тогда
		
		ТабличныйДокумент = НапечататьРешение(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Решение","Решение о признании объектов НФА (ф. 0510441)", ТабличныйДокумент);
		
	КонецЕсли;
	
КонецПроцедуры

Функция НапечататьРешение(МассивОбъектов, ОбъектыПечати)

	Возврат УправлениеПечатьюБГУ.НапечататьРешениеОПризнанииНФА(МассивОбъектов, ОбъектыПечати,
		ДанныеДляПечати(МассивОбъектов));
	
КонецФункции

Функция ДанныеДляПечати(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("РезолюцияПоУмолчанию",
		УправлениеНФАКлиентСервер.ТекстРезолюцииКомиссииПоУмолчанию("РешениеОПризнанииОбъектовМЗ"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(МестаХраненияКонтактнаяИнформация.Представление) КАК Адрес,
	|	РешениеОПризнанииОбъектовМЗИК.Ссылка КАК Документ
	|ПОМЕСТИТЬ КонтактнаяИнформацияЦМО
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовМЗИК КАК РешениеОПризнанииОбъектовМЗИК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.МестаХранения.КонтактнаяИнформация КАК МестаХраненияКонтактнаяИнформация
	|			ПО СправочникЦМО.МестоХранения = МестаХраненияКонтактнаяИнформация.Ссылка
	|				И (МестаХраненияКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресМестаХранения))
	|		ПО РешениеОПризнанииОбъектовМЗИК.ЦМО = СправочникЦМО.Ссылка
	|ГДЕ
	|	РешениеОПризнанииОбъектовМЗИК.Ссылка В(&МассивОбъектов)
	|
	|СГРУППИРОВАТЬ ПО
	|	РешениеОПризнанииОбъектовМЗИК.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Документ.Ссылка КАК Ссылка,
	|	ЛОЖЬ КАК ИнвентарныйУчет,
	|	Документ.Номер КАК Номер,
	|	Документ.Дата КАК ДатаАкта,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА Документ.Организация
	|		ИНАЧЕ Документ.Организация.ГоловнаяОрганизация
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА ВЫБОР
	|					КОГДА Документ.Организация.НаименованиеПолное = """"
	|						ТОГДА Документ.Организация.Наименование
	|					ИНАЧЕ Документ.Организация.НаименованиеПолное
	|				КОНЕЦ
	|		ИНАЧЕ Документ.Организация.ГоловнаяОрганизация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОрганизации,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА Документ.Организация.КодПоРПБС
	|		ИНАЧЕ Документ.Организация.ГоловнаяОрганизация.КодПоРПБС
	|	КОНЕЦ КАК КодРПБС,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|		ИНАЧЕ Документ.Организация
	|	КОНЕЦ КАК ОбособленноеПодразделение,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА """"
	|		ИНАЧЕ Документ.Организация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОбособленногоПодразделения,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА """"
	|		ИНАЧЕ Документ.Организация.КодПоРПБС
	|	КОНЕЦ КАК КодРПБСПодр,
	|	Документ.Подразделение КАК СтруктурноеПодразделение,
	|	ВЫБОР
	|		КОГДА Документ.Подразделение.НаименованиеПолное = """"
	|			ТОГДА Документ.Подразделение.Наименование
	|		ИНАЧЕ Документ.Подразделение.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеСтруктурногоПодразделения,
	|	Документ.Организация.КодПоППП.НаименованиеПолное КАК Учредитель,
	|	Документ.Организация.КодПоППП.Код КАК ГлаваБК,
	|	Документ.Организация.Бюджет.НаименованиеПолное КАК БюджетНаименование,
	|	Документ.Организация.Бюджет.Код КАК ОКТМО,
	|	ПРЕДСТАВЛЕНИЕ(Документ.ВидОперации) КАК ТипРешения,
	|	Документ.ВидОперации.Порядок + 1 КАК КодТипаРешения,
	|	Документ.ЦМО КАК ЦМО,
	|	Документ.ЦМО.Сотрудник КАК Сотрудник,
	|	Документ.СчетУчета КАК СчетУчета,
	|	Документ.СчетУчета.Наименование КАК ВидОбъекта,
	|	ПОДСТРОКА(Документ.СчетУчета.Код, 5, 1) + ""0"" КАК СчетГруппа,
	|	ПОДСТРОКА(Документ.СчетУчета.Код, 6, 1) КАК СчетВид,
	|	Документ.Комиссия.НаименованиеПриказа КАК НаименованиеПриказа,
	|	Документ.Комиссия.НомерПриказа КАК НомерПриказа,
	|	Документ.Комиссия.ДатаПриказа КАК ДатаПриказа,
	|	Документ.Ответственный КАК Ответственный
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовМЗИК КАК Документ
	|ГДЕ
	|	Документ.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документ.Дата,
	|	Документ.Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Материалы.Ссылка КАК Ссылка,
	|	Материалы.НомерСтроки КАК НомерСтроки,
	|	Материалы.Номенклатура КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА Материалы.Номенклатура.НаименованиеПолное = """"
	|			ТОГДА Материалы.Номенклатура.Наименование
	|		ИНАЧЕ Материалы.Номенклатура.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОС,
	|	Материалы.Номенклатура.Код КАК КодОбъекта,
	|	Материалы.Номенклатура.Сведения КАК Сведения,
	|	ЕСТЬNULL(Материалы.Номенклатура.МожетСодержатьДрагМатериалы, ЛОЖЬ) КАК МожетСодержатьДрагМатериалы,
	|	0 КАК АмортизационнаяГруппа,
	|	"""" КАК ИнвентарныйНомер,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаВыпуска,
	|	"""" КАК РеестровыйНомер,
	|	"""" КАК ЗаводскойНомер,
	|	Материалы.Номенклатура.НоменклатурныйНомер КАК ИнойНомер,
	|	Материалы.Сумма КАК Сумма,
	|	Материалы.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА Материалы.Количество <> 0
	|			ТОГДА Материалы.Сумма / Материалы.Количество
	|		ИНАЧЕ Материалы.Сумма
	|	КОНЕЦ КАК Цена,
	|	0 КАК СуммаАмортизации,
	|	0 КАК СуммаОбесценения,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаВводаВЭксплуатацию,
	|	Материалы.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
	|	НЕОПРЕДЕЛЕНО КАК СпособНачисленияАмортизации,
	|	Материалы.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВЫБОР
	|		КОГДА Материалы.РезолюцияКомиссии <> """"
