	ДанныеДокументов.Вставить("ВыборкаДокументов"	, РезультатЗапроса[1].Выбрать());
	ДанныеДокументов.Вставить("ВыборкаОС"			, РезультатЗапроса[2].Выбрать());
	ДанныеДокументов.Вставить("ВыборкаРаботы"		, РезультатЗапроса[4].Выбрать());
	ДанныеДокументов.Вставить("Драгметаллы"			, РезультатЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДокументов.Вставить("Характеристики"		, РезультатЗапроса[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДокументов.Вставить("ПТС"					, Неопределено);
	ДанныеДокументов.Вставить("ЕГРН"				, Неопределено);
	ДанныеДокументов.Вставить("ВыборкаФайлы"		, РезультатЗапроса[6].Выбрать());
	
	Возврат ДанныеДокументов;
	
