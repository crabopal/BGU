#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ВсегоПоДокументу = КапВложения.Итог("Всего");
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	УчетРасчетов.ЗачетАвансовВыданныхОбработкаПроверкиЗаполнения(ЭтотОбъект, НепроверяемыеРеквизиты, Отказ);
	
	СписокСчетов = БухгалтерскийУчет.СписокСчетов("107.11,107.21,107.31,107.41");
	
	Если НЕ БухгалтерскийУчет.ВедетсяУчетПоПодразделениям(СписокСчетов) Тогда
		
		НепроверяемыеРеквизиты.Добавить("Подразделение");
		
	КонецЕсли;

	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	Для каждого ТекСтр Из КапВложения Цикл
		
		Если ЗначениеЗаполнено(ТекСтр.ВнеоборотныйАктив) Тогда
			ТекВидНФА = ТекСтр.ВнеоборотныйАктив.ВидНФА;
			Если ТекВидНФА<>Перечисления.ВидыНФА.ОС И ТекВидНФА<>Перечисления.ВидыНФА.КапВложения Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='В строке %1 выбран НФА вида %2'"), ТекСтр.НомерСтроки, ТекВидНФА);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"Объект.КапВложения["+(ТекСтр.НомерСтроки-1)+"].ВнеоборотныйАктив",,Отказ);
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Перем Основание;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
		
		Если ЭлектронныеДокументыБГУ.КонтролироватьСоответствиеНаименованияТРУДляДокументовУчетаНаОснованииЭДП(ДанныеЗаполнения.Организация) Тогда
			РазличающаясяНоменклатураКонтрагентаИОрганизации = ЭлектронныеДокументыБГУ.РазличающаясяНоменклатураКонтрагентаИОрганизации(ДанныеЗаполнения);
			Если РазличающаясяНоменклатураКонтрагентаИОрганизации.Количество() > 0 Тогда
				ТекстСообщения = ЭлектронныеДокументыБГУ.ТекстСообщенияОРазличающейсяНоменклатуре(ДанныеЗаполнения, РазличающаясяНоменклатураКонтрагентаИОрганизации);
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
		КонецЕсли;	
		
		ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ДанныеЗаполнения.Свойство("Основание", Основание);
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
			
			Если ЭлектронныеДокументыБГУ.КонтролироватьСоответствиеНаименованияТРУДляДокументовУчетаНаОснованииЭДП(Основание.Организация) Тогда
				РазличающаясяНоменклатураКонтрагентаИОрганизации = ЭлектронныеДокументыБГУ.РазличающаясяНоменклатураКонтрагентаИОрганизации(Основание);
				Если РазличающаясяНоменклатураКонтрагентаИОрганизации.Количество() > 0 Тогда
					ТекстСообщения = ЭлектронныеДокументыБГУ.ТекстСообщенияОРазличающейсяНоменклатуре(Основание, РазличающаясяНоменклатураКонтрагентаИОрганизации);
					ВызватьИсключение ТекстСообщения;
				КонецЕсли;
			КонецЕсли;	
			
			ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения.Основание, ДанныеЗаполнения.НоменклатураДляОтраженияВУчете.Выгрузить());
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДокумента

// Заполняет документ остатками авансов к зачету.
//
Процедура ЗаполнитьПоОстаткамАвансов(ПараметрыЗаполнения, Отказ) Экспорт

	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	ПараметрыЗаполнения.Вставить("Организация", Организация);
	ПараметрыЗаполнения.Вставить("Дата",        Дата);
	ПараметрыЗаполнения.Вставить("Ссылка",      Ссылка);
	
	ТаблицаДокумента = УчетРасчетов.ПодготовитьТаблицуРасчетовПоДокументу(
		ЭтотОбъект, ПараметрыЗаполнения, Отказ);
	
	ТаблицаРасчетов = УчетРасчетов.ТаблицаРасчетовСЗачетомАвансов(
		ТаблицаДокумента, , ПараметрыЗаполнения, Отказ);
	
	Если НЕ Отказ Тогда
		
		ЗачетАвансов.Очистить();
		
		АвансыКЗачету = ТаблицаРасчетов.НайтиСтроки(
			Новый Структура("ЭтоЗачетАванса", Истина));
		
		Для Каждого АвансКЗачету Из АвансыКЗачету Цикл
			
			Если АвансКЗачету.ВидДопСубконтоАвансов <> ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ЗачетАвансов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, АвансКЗачету, "КФО,КПС");
			
			НоваяСтрока.ДокументАванса = АвансКЗачету.ДопСубконтоАвансов;
			НоваяСтрока.КЭК            = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(АвансКЗачету.СчетАвансов);
			НоваяСтрока.СуммаЗачета    = АвансКЗачету.СуммаРасчетов;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения, СписокНоменклатуры = Неопределено) Экспорт
	ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеОСВПути;

	ДатаПодписания = Дата(1,1,1);
	Если ДанныеЗаполнения.ЗагруженИзЕИС Тогда
		ДатаПодписания = ЭлектронныеДокументыБГУ.ДатаПоследнейЭлектроннойПодписиЭД(ДанныеЗаполнения);
		Если ЗначениеЗаполнено(ДатаПодписания) Тогда
			Дата = ДатаПодписания;
		КонецЕсли;	
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаПодписания) Тогда
		Дата = ЭлектронныеДокументыБГУ.ДатаВходящегоИзвещенияЭДП(ДанныеЗаполнения);
	КонецЕсли;
	
	ДатаПодписанияПервичногоДокумента = Дата;

	Организация = ДанныеЗаполнения.Организация;
	Контрагент = ДанныеЗаполнения.Контрагент;
	Договор = ДанныеЗаполнения.Договор;
	ВалютаДокумента = ДанныеЗаполнения.ВалютаДокумента;
	СуммаВключаетНДС = ДанныеЗаполнения.СуммаВключаетНДС;
	ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
	НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;
	ДокументОснование = ДанныеЗаполнения;
	СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
	
	Если НЕ ТипЗнч(СписокНоменклатуры) = Тип("ТаблицаЗначений") Тогда
		СписокНоменклатуры = ЭлектронныеДокументыБГУВызовСервера.СписокДоступнойНоменклатурыЭДПоставщика(ТипДокументаУчета, ДокументОснование);
	КонецЕсли;
	
	Для Каждого СтрокаТЧ из СписокНоменклатуры Цикл
		Если СтрокаТЧ.КодВидаНоменклатуры = 2 Тогда
			Если СтрокаТЧ.Номенклатура.ВидНФА = Перечисления.ВидыНФА.ОС
				ИЛИ СтрокаТЧ.Номенклатура.ВидНФА = Перечисления.ВидыНФА.КапВложения Тогда
				НоваяСтрока = КапВложения.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
				НоваяСтрока.ВнеоборотныйАктив = СтрокаТЧ.Номенклатура;
				НоваяСтрока.СчетУчета = БухгалтерскийУчет.СчетПоКоду("106.31");
			ИначеЕсли СтрокаТЧ.Номенклатура.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
				НоваяСтрока = КапВложения.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
				НоваяСтрока.ВнеоборотныйАктив = СтрокаТЧ.Номенклатура;
				НоваяСтрока.СчетУчета = БухгалтерскийУчет.СчетПоКоду("106.11");
			ИначеЕсли СтрокаТЧ.Номенклатура.ВидНФА = Перечисления.ВидыНФА.НПА Тогда 
				НоваяСтрока = КапВложения.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
				НоваяСтрока.ВнеоборотныйАктив = СтрокаТЧ.Номенклатура;
				НоваяСтрока.СчетУчета = БухгалтерскийУчет.СчетПоКоду("106.32");
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	ВсегоПоДокументу = КапВложения.Итог("Всего");
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
