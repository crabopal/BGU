&НаКлиенте
Асинх Процедура ЗаполнитьРаздел1(Команда)
	
	Если Объект.Раздел1.Количество() > 0
		Или Объект.Раздел31.Количество() > 0 Тогда
			
		ТекстВопроса = НСтр("ru='Табличные части раздела 1 и раздела 3.1 будут очищены. Продолжить?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;		
		
	КонецЕсли;
	
	Отказ = Неопределено;
	
	ПроверитьПередЗаполнениемРаздела1Сервер(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел1Клиент();
	
КонецПроцедуры

