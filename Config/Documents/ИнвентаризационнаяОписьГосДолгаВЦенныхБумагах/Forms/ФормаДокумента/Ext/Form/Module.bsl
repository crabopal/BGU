Процедура ПодготовитьФормуНаСервере()

	// ПанельРасписки
	НастроитьФормуПоРасписке();
	// Конец ПанельРасписки

	// ЗамещениеЧленаКомиссии
	Если Не ДобавленыРеквизитыЗамещениеЧленаКомиссии Тогда
		РаботаСКомиссиями.ИнициализироватьФормуДокументаЗамещениеЧленаКомиссии(ЭтотОбъект);
		ДобавленыРеквизитыЗамещениеЧленаКомиссии = Истина;
	КонецЕсли;
	// Конец ЗамещениеЧленаКомиссии
	
	УстановитьПредставлениеНомераКомиссии();
	УстановитьПредставлениеМестаПроведения();
	УстановитьПредставлениеСпискаСчетов();
	УправлениеКомандойПересчетРублевогоЭквивалента(ЭтотОбъект);

	ВалютаРегламентированногоУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	НастроитьНедоступностьИзмененияКолонок();
	
	НастроитьОтборПоПодразделению();
	
КонецПроцедуры

