&НаСервере
Процедура НастроитьФормуПоРасписке()
	
	НастроитьПанельРаспискиИнвентаризацииСервер();
	НастроитьДоступностьРазделов();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПанельРаспискиИнвентаризацииСервер()
	
	ИнвентаризацияСервер.НастроитьПанельРаспискиНаФормеОписи(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНадписьРасписки()
	Если Не ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка) Тогда
		Элементы.ДекорацияРаспискаНадпись.Заголовок = НСтр("ru='Создать расписку'");		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура НастроитьДоступностьРазделов()

	Если ТолькоПросмотр Тогда
		Возврат;	
	КонецЕсли;
	
	ДоступностьРазделов = ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка) И ДанныеПанелиРасписки.РаспискаПроведена;

	Элементы.ГруппаРаздел1Заголовок.Доступность = ДоступностьРазделов;
	Элементы.ГруппаРаздел2Заголовок.Доступность = ДоступностьРазделов;
	Элементы.ГруппаРаздел31Заголовок.Доступность = ДоступностьРазделов;
	Элементы.ГруппаРаздел32Заголовок.Доступность = ДоступностьРазделов;
	
КонецПроцедуры

&НаСервере
Процедура ЗаблокироватьРеквизитыПриНаличииРасписки()

	Если ТолькоПросмотр Тогда
		Возврат;	
	КонецЕсли;

	Если ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка) Тогда
		// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
		ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
		// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура СоздатьРаспискуАсинх()
	
	Если Не ПроверитьЗаполнениеПередФормированиемРасписки() Тогда
		Возврат;		
	КонецЕсли;
	
	ДокументЗаписан = ЗначениеЗаполнено(Параметры.Ключ) И Не Модифицированность;
	
	Если Не ДокументЗаписан Тогда
		
		Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
			ТекстВопроса = НСтр("ru = 'Документ изменен. Перед формированием расписки необходимо записать документ.'");
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Записать и продолжить'"));
			Кнопки.Добавить(КодВозвратаДиалога.Отмена);
			Ответ = Ждать ВопросАсинх(ТекстВопроса, Кнопки, ,КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
			Если Ответ <> КодВозвратаДиалога.Да Тогда
				Возврат;
			КонецЕсли;		
		КонецЕсли;
		
		ДокументЗаписан = Записать();
	КонецЕсли;
	
	Если ДокументЗаписан Тогда
		ИнвентаризацияКлиент.СоздатьДокументРасписки(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеПередФормированиемРасписки()
	
	Отказ = Ложь;
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.Организация",, Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.РешениеОПроведенииИнвентаризации) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Решение о проведении инвентаризации'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.РешениеОПроведенииИнвентаризации",, Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ВидЗадолженности) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Вид задолженности'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.ВидЗадолженности",, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ОтветственноеЛицоУправленческогоУчета) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Ответственное лицо'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.ОтветственноеЛицоУправленческогоУчета",,
			Отказ);
	КонецЕсли;
	
	Возврат Не Отказ;
КонецФункции

#КонецОбласти

