&НаКлиенте
Процедура ВидЗадолженностиПриИзменении(Элемент)
	УправлениеКомандойПересчетРублевогоЭквивалента(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ВидЗадолженностиОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением,
	СтандартнаяОбработка)

	Если (Объект.Раздел1.Количество() > 0 Или Объект.Раздел31.Количество() > 0) И ВыбранноеЗначение
		<> Объект.ВидЗадолженности Тогда

		СтандартнаяОбработка = Ложь;
		ВопросПриВыбореВидаЗадолженностиАсинх(ВыбранноеЗначение);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВидЗадолженностиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СчетаЗадолженности = Новый Массив;
	Для Каждого СтрокаСпискаСчетов Из Объект.СписокСчетов Цикл
		СчетаЗадолженности.Добавить(СтрокаСпискаСчетов.Счет);
	КонецЦикла;
	
	Если СчетаЗадолженности.Количество() > 0 Тогда
		НаДату = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(Объект.ДатаИнвентаризации);
		ЗначенияПараметровВыбора = Новый Массив;
		ЗначенияПараметровВыбора.Добавить(Новый ПараметрВыбора("Счет", СчетаЗадолженности));
		ЗначенияПараметровВыбора.Добавить(Новый ПараметрВыбора("Организация", Объект.Организация));
		ЗначенияПараметровВыбора.Добавить(Новый ПараметрВыбора("НаДату", НаДату));
		Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(ЗначенияПараметровВыбора);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РешениеОПроведенииИнвентаризацииОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные,
	ВыборДобавлением, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормыВыборДанных = ПараметрыФормыВыборДанныхИзРешения(Объект.Ссылка, ВыбранноеЗначение, 
		УникальныйИдентификатор);
	
	Если ПараметрыФормыВыборДанных.РешениеСодержитДанныеДляЗаполненияОписи Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Решение", ВыбранноеЗначение);
		
		ОписаниеОповещенияВыбор = 
			Новый ОписаниеОповещения("ЗаполнитьОписьПослеВыбораДанныхИзРешения", ЭтотОбъект,
			ДополнительныеПараметры);
		
		ОткрытьФорму("ОбщаяФорма.ВыборДанныхИзРешенияОПроведенииИнвентаризации", ПараметрыФормыВыборДанных,
			ЭтотОбъект, , , , ОписаниеОповещенияВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	КонецЕсли;
	
КонецПроцедуры

