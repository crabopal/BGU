&НаКлиенте
Асинх Процедура ВопросПередНачаломДобавленияСтрокРаздела2Асинх(Копирование)
	
	ТекстВопроса = НСтр("ru = 'Табличные части раздела 3.1 и раздела 3.2 будут очищены. Продолжить?'");
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;		
	Объект.Раздел31.Очистить();
	Объект.Раздел32.Очистить();
	Раздел31ИтогСуммаИтогоРуб = 0;
	Раздел32ИтогПросроченоИтогоРуб = 0;
	
	Если Копирование Тогда
		Элементы.Раздел2.СкопироватьСтроку();
	Иначе
		Элементы.Раздел2.ДобавитьСтроку();
	КонецЕсли;

	Модифицированность = Истина;
	
КонецПроцедуры

