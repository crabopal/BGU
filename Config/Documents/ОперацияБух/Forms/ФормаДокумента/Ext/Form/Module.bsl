&НаКлиенте
Процедура ЗаполнитьПоТиповойОперации(Команда)
	
	ИмяРеквизитаТиповыеОперации = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаФормыТиповаяОперация();
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизитаТиповыеОперации]) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,НСтр("ru = 'Типовая операция'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, ИмяРеквизитаТиповыеОперации);
		Возврат;
	КонецЕсли;
	
	Если НЕ БухгалтерскиеОперацииКлиентСервер.ОбязательныеРеквизитыЗаполнены(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоТиповойОперацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПроводкиНУ(Команда)
	
	НомераПроводокНУ = ПолучитьНомераПроводокНУ();
	
	Если НомераПроводокНУ.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьПроводкиНУЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Существующие проводки налогового учета будут очищены. Заполнить?'"),
			РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьПроводкиНУНаСервере(НомераПроводокНУ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьПроводкиНУЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПроводкиНУНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроводкиНУНаСервере(НомераПроводокНУ = Неопределено)
	
	Если НомераПроводокНУ = Неопределено Тогда
		НомераПроводокНУ = ПолучитьНомераПроводокНУ();
	КонецЕсли;
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	НаборДвижений = ДокументОбъект.Движения.ЖурналПроводокЕПСБУ;
	
	// Удаляем существующие проводки НУ.
	КоличествоПроводокНУ = НомераПроводокНУ.Количество();
	Для Сч=1 По КоличествоПроводокНУ Цикл
		НомерПроводкиНУ = НомераПроводокНУ.Получить(КоличествоПроводокНУ - Сч);
		НаборДвижений.Удалить(НомерПроводкиНУ - 1);
	КонецЦикла;
	
	// Сформируем таблицу проводок БУ.
	// В новых проводках могут быть не заполнены Организация и Период.
	ТаблицаПроводок = НаборДвижений.Выгрузить();
	ТаблицаПроводок.ЗаполнитьЗначения(ДокументОбъект.Организация, "Организация");
	ТаблицаПроводок.ЗаполнитьЗначения(ДокументОбъект.Дата, "Период");
	
	// Сформируем таблицу проводок НУ по таблице проводок БУ.
	ТаблицаПроводокНУ = НалоговыйУчет.СформироватьПроводкиНУпоБУ(ДокументОбъект, ТаблицаПроводок);
	
	// Загрузим проводки БУ и НУ в табличную часть операции.
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаПроводокНУ, ТаблицаПроводок);
	НаборДвижений.Загрузить(ТаблицаПроводок);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьНаОбратнуюПроводку(Команда)
	
	Для Каждого ВыделеннаяСтрока Из Элементы.ДвиженияЖурналПроводок.ВыделенныеСтроки Цикл
		
		ТекущиеДанные = Объект.Движения.ЖурналПроводокЕПСБУ.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		БуферДт = Новый Структура("СчетДт,СубконтоДт1,СубконтоДт2,СубконтоДт3,КПСДт,КЭКДт,
									|ВалютаДт,ПодразделениеДт,ВалютнаяСуммаДт,КоличествоДт,ХарактеристикаДвиженияДт");
		ЗаполнитьЗначенияСвойств(БуферДт, ТекущиеДанные);
		
		Для Каждого КлючЗначение Из БуферДт Цикл
			КлючКт = СтрЗаменить(КлючЗначение.Ключ,"Дт","Кт");
			ТекущиеДанные[КлючЗначение.Ключ] = ТекущиеДанные[КлючКт];
			ТекущиеДанные[КлючКт] = КлючЗначение.Значение;
		КонецЦикла;
		
		ОбновитьДопДействияВСтрокеТаблицыПроводок(ТекущиеДанные);
		
		Если ЗначениеЗаполнено(ТекущиеДанные["СчетДт"]) Тогда
			СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные["СчетДт"]);
			Если ЗначениеЗаполнено(СвойстваСчета.КОСГУДт) Тогда
				ТекущиеДанные["КЭКДт"] = СвойстваСчета.КОСГУДт; 
				// Уточняем КОСГУ по контрагентами или МЗ  
				ТипЗначения = ТипЗнч(ТекущиеДанные.СубконтоДт1);
				Если ТипЗначения = Тип("СправочникСсылка.Контрагенты") ИЛИ ТипЗначения = Тип("СправочникСсылка.Номенклатура") Тогда
					ПараметрыКЭК = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
					ПараметрыКЭК.Дата = Объект.Дата;
					ПараметрыКЭК.ИФО = ТекущиеДанные.ИФО;
					ПараметрыКЭК.КФО = ТекущиеДанные.КФО;
					ПараметрыКЭК.Организация =ТекущиеДанные.Организация;
					ПараметрыКЭК.Субконто1 = ТекущиеДанные.СубконтоДт1;
					ПараметрыКЭК.Субконто2 = ТекущиеДанные.СубконтоДт2;
					ПараметрыКЭК.Субконто3 = ТекущиеДанные.СубконтоДт3;
					ПараметрыКЭК.Счет = ТекущиеДанные["СчетДт"];
					ПараметрыКЭК.ДтКт = "Дт";
					КЭКПроводки = БухгалтерскийУчетВызовСервера.КЭКПроводки(ПараметрыКЭК);
					Если ЗначениеЗаполнено(КЭКПроводки) Тогда
						ТекущиеДанные["КЭКДт"] = КЭКПроводки;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	
		Если ЗначениеЗаполнено(ТекущиеДанные["СчетКт"]) Тогда
			СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные["СчетКт"]);
			Если ЗначениеЗаполнено(СвойстваСчета.КОСГУКт) Тогда
				ТекущиеДанные["КЭККт"] = СвойстваСчета.КОСГУКт; 
				ТипЗначения = ТипЗнч(ТекущиеДанные.СубконтоКт1);
				Если ТипЗначения = Тип("СправочникСсылка.Контрагенты") ИЛИ ТипЗначения = Тип("СправочникСсылка.Номенклатура") Тогда
					ПараметрыКЭК = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
					ПараметрыКЭК.Дата = Объект.Дата;
					ПараметрыКЭК.ИФО = ТекущиеДанные.ИФО;
					ПараметрыКЭК.КФО = ТекущиеДанные.КФО;
					ПараметрыКЭК.Организация =ТекущиеДанные.Организация;
					ПараметрыКЭК.Субконто1 = ТекущиеДанные.СубконтоКт1;
					ПараметрыКЭК.Субконто2 = ТекущиеДанные.СубконтоКт2;
					ПараметрыКЭК.Субконто3 = ТекущиеДанные.СубконтоКт3;
					ПараметрыКЭК.Счет = ТекущиеДанные["СчетКт"];
					ПараметрыКЭК.ДтКт = "Кт";
					КЭКПроводки = БухгалтерскийУчетВызовСервера.КЭКПроводки(ПараметрыКЭК);
					Если ЗначениеЗаполнено(КЭКПроводки) Тогда
						ТекущиеДанные["КЭККт"] = КЭКПроводки;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ТекущиеДанные.ЖурналОпераций = БухгалтерскийУчетВызовСервераПовтИсп.НомерЖурнала(ТекущиеДанные["СчетДт"], ТекущиеДанные["СчетКт"]);
		
	КонецЦикла;
	
КонецПроцедуры

