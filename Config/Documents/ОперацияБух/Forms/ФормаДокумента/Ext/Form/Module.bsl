&НаКлиенте
Процедура ДвиженияЖурналПроводокСчетКтПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДвиженияЖурналПроводок.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СчетДт) Тогда
		ТекущиеДанные.ЖурналОпераций = БухгалтерскийУчетВызовСервераПовтИсп.НомерЖурнала(ТекущиеДанные.СчетДт, ТекущиеДанные.СчетКт);
	КонецЕсли;
	
	ОчиститьНеиспользуемыеПоляПоПризнакамУчета(ТекущиеДанные, "Кт");
	
	// Уточняем КОСГУ по контрагентами или МЗ
	БухгалтерскиеОперацииКлиент.СубконтоПриИзменении(Элементы.ДвиженияЖурналПроводокСубконтоКт1,,, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ДвиженияЖурналПроводокСчетКтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДвиженияЖурналПроводок.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			ТекущиеДанные.СчетКт, 
																			ТекущиеДанные.КПСКт, 
																			ТекущиеДанные.КФО), 
															Объект.Организация,
															Объект.ИФО,
															,
															ТекущиеДанные.КФО,
															,
															Объект.Дата,
															Новый Структура("КорреспонденцияДт", ТекущиеДанные.СчетДт));
	
КонецПроцедуры

