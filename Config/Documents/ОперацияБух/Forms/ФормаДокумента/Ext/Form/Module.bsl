&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрыФункциональныхОпцийФормыДокумента(ЭтаФорма);
	
	ТекущаяДатаДокумента = Объект.Дата;
	
	ОбновитьДопДействияВсехСтрокТаблицыПроводок(ЭтотОбъект);
	УстановитьВидимостьПредупрежденияОДопДействиях(ЭтотОбъект);
	
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтотОбъект, Объект);
	
	БухгалтерскийУчетКлиентСервер.УстановитьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	//БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект);
	
	ВидимостьТиповойОперации(ЭтотОбъект, Объект); 
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Сторно.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Сторно КАК Сторно
	|ГДЕ
	|	Сторно.ДокументОснование = &ДокументОснование");
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	ДокументСторнирован = НЕ Запрос.Выполнить().Пустой();
	
	// переключатель активности движений
	АктивностьДвижений = Истина;
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	Для Каждого Движение Из ДокументОбъект.Движения Цикл 
		Движение.Прочитать();
		Если Движение.Количество() > 0 Тогда
			АктивностьДвижений = АктивностьДвижений И Движение[0].Активность;
		КонецЕсли;	
	КонецЦикла;
	Элементы.ФормаПереключитьАктивностьДвижений.Заголовок = ?(АктивностьДвижений, 
		НСтр("ru='Выключить активность движений'"), НСтр("ru='Включить активность движений'"));   
		
	// Счета с контролем КПС и КЭК	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СчетаСконтролем", ПланыСчетов.ЕПСБУ.СчетаСНеоборотнымиКЭК());
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоТиповойОперацииНаСервере()
	
	Объект.Движения.ЖурналПроводокЕПСБУ.Очистить();
	
	ДопРеквизиты = Новый Структура;
	ЗаполнитьСписокДопРеквизитов(Элементы.РеквизитыОперации, ДопРеквизиты);
	
	ИмяРеквизитаТиповыеОперации = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаФормыТиповаяОперация();
	ФормированиеПроводок = Обработки.ФормированиеБухгалтерскихПроводок.Создать();
	ФормированиеПроводок.ДокументОснование = Объект.Ссылка;
	ФормированиеПроводок.ТиповаяОперация   = ЭтотОбъект[ИмяРеквизитаТиповыеОперации];

	ТаблицаПроводок = Неопределено;
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ПараметрыАвтоФормированияПроводок = ФормированиеПроводок.ПараметрыАвтоФормированияПроводок();
	ПараметрыАвтоФормированияПроводок.ДопРеквизиты 		= ДопРеквизиты;
	ПараметрыАвтоФормированияПроводок.ТаблицаПроводок	= ТаблицаПроводок;
	ПараметрыАвтоФормированияПроводок.ТекущийОбъект 	= ДокументОбъект;
	ФормированиеПроводок.АвтоФормированиеПроводок(ПараметрыАвтоФормированияПроводок);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	Модифицированность = ДокументОбъект.Модифицированность();
	
	Если ПараметрыАвтоФормированияПроводок.ТаблицаПроводок <> Неопределено Тогда  
		ПараметрыАвтоФормированияПроводок.ТаблицаПроводок.ЗаполнитьЗначения(ИСТИНА, "Активность");
		Для каждого ТекПроводка Из ПараметрыАвтоФормированияПроводок.ТаблицаПроводок Цикл
			ЗаполнитьЗначенияСвойств(Объект.Движения.ЖурналПроводокЕПСБУ.Добавить(), ТекПроводка);
		КонецЦикла;
		АктивностьДвижений = Истина;
		УстановитьСостояниеДокумента();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДопРеквизитов(ТекЭлемент, ДопРеквизиты)
	
	Для каждого ДопРеквизитОперации Из ЭтотОбъект["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"] Цикл
	
		Если ДопРеквизитОперации.ЭтоГруппа
			ИЛИ ЗначениеЗаполнено(ДопРеквизитОперации.ИмяТаблицы) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДопРеквизитОперации.ИмяДляФормулы)
			И ЗначениеЗаполнено(ДопРеквизитОперации.ИмяРеквизита) Тогда
			
			ДопРеквизиты.Вставить(ДопРеквизитОперации.ИмяДляФормулы,
				ЭтотОбъект[ДопРеквизитОперации.ИмяРеквизита]);
			
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНомераПроводокНУ()
	
	Возврат НалоговыйУчет.ПолучитьНомераПроводокНУ(Объект.Движения.ЖурналПроводокЕПСБУ);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПересчитатьСуммуВРублях(ВалютнаяСумма, Валюта, Дата)
	
	КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, Дата);
		
	Возврат РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
		ВалютнаяСумма, 
		Новый Структура("Валюта, Курс, Кратность", Валюта, КурсВалюты.Курс, КурсВалюты.Кратность),
		Новый Структура("Валюта, Курс, Кратность", Константы.ВалютаРегламентированногоУчета.Получить(), 1, 1));	
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГлБухгалтер",
		"Доступность", ЗначениеЗаполнено(Объект.Организация));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьГлБухгалтера(Организация, Дата)

	Если ЗначениеЗаполнено(Организация) Тогда
		Возврат ОрганизационнаяСтруктураВызовСервераПовтИсп.ОтветственноеЛицоОрганизации(Организация,
			ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер"),
			Дата).ОтветственноеЛицоСсылка;
	Иначе
		Возврат ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура ОчиститьНеиспользуемыеПоляПоПризнакамУчета(ТекущиеДанные, СторонаПроводки)

	Количественный = Ложь;
	Валютный = Ложь;
	Если ЗначениеЗаполнено(ТекущиеДанные["Счет" + СторонаПроводки]) Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные["Счет" + СторонаПроводки]);
		Количественный = СвойстваСчета.Количественный;
		Валютный = СвойстваСчета.Валютный;
	КонецЕсли;
	
	Если Не Количественный И ЗначениеЗаполнено(ТекущиеДанные["Количество" + СторонаПроводки]) Тогда
		ТекущиеДанные["Количество" + СторонаПроводки] = Неопределено;
	КонецЕсли;
	
	Если Не Валютный Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные["Валюта" + СторонаПроводки]) Тогда
			ТекущиеДанные["Валюта" + СторонаПроводки] = Неопределено;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекущиеДанные["ВалютнаяСумма" + СторонаПроводки]) Тогда
			ТекущиеДанные["ВалютнаяСумма" + СторонаПроводки] = Неопределено;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

