	ТекущиеДанные = Элементы.ДвиженияЖурналПроводок.ТекущиеДанные; 
	
	Если ЭтотОбъект.КэшПараметров.Локальные.СчетаСконтролем.Найти(ТекущиеДанные.СчетДт) = Неопределено Тогда
		КПС = Неопределено;
	Иначе
		КПС = ТекущиеДанные.КПСДт;
	КонецЕсли;	
    	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент, 
								СтандартнаяОбработка,
								ТекущиеДанные.КЭКДт,
								Объект.Организация, 
								Объект.ИФО,
								ТекущиеДанные.КФО, 
                                ТекущиеДанные.СчетДт,
								Объект.Дата,
								,,,,
								КПС,
								ИСТИНА,
								ОтразитьВМежотчетномПериоде);
