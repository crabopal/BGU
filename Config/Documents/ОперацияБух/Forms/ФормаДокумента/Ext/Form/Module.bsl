&НаКлиенте
Процедура ДвиженияЖурналПроводокПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.ДвиженияЖурналПроводок.ТекущиеДанные;
	
	Если НоваяСтрока Тогда
		// Заполним Организацию и Период в проводке, т.к. в дальнейшем их значения используются
		// для проверки необходимости доп. действий.
		ТекущиеДанные.Организация = Объект.Организация;
		ТекущиеДанные.Период = Объект.Дата;
	КонецЕсли;
	
	Если Элемент.ТекущийЭлемент.Имя = "ДвиженияЖурналПроводокДопДействияТребуются" Тогда
		
		Если ТекущиеДанные.ДопДействияТребуются Тогда
			
			ПараметрыФормы = Новый Структура("НомерСтроки,Организация,Период,КФО,
				|Событие,ДтКт,
				|СчетДт,СубконтоДт1,СубконтоДт2,СубконтоДт3,
				|СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
			ЗаполнитьЗначенияСвойств(ПараметрыФормы, ТекущиеДанные);
			ПараметрыФормы.Вставить("ИФО", Объект.ИФО);
			
			// Код события и сторона проводки, по которой возникло событие.
			ПараметрыФормы.Событие = ТекущиеДанные.ДопДействияСобытие;
			ПараметрыФормы.ДтКт    = ТекущиеДанные.ДопДействияДтКт;
			
			ОткрытьФорму("Документ.ОперацияБух.Форма.ДополнительныеДействия", ПараметрыФормы, ЭтотОбъект);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

