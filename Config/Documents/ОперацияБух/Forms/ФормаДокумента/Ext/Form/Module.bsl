	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДопДействияВСтрокеТаблицыПроводок(Проводка)
	
	Проводка.ДопДействияТребуются = Ложь;
	Проводка.ДопДействияСобытие = "";
	Проводка.ДопДействияДтКт = "";
	
	// Список обрабатываемых операций.
	ИзмениласьСтоимостьОС = Ложь;
	ИзмениласьАмортизацияОС = Ложь;
	ИзменилосьОбесценениеОС = Ложь;
	
	СчетДтЭтоСчетУчета = БухгалтерскийУчетВызовСервера.СчетВИерархии(Проводка.СчетДт, "101.00,102.00,103.00,108.00,21");
	СчетКтЭтоСчетУчета = БухгалтерскийУчетВызовСервера.СчетВИерархии(Проводка.СчетКт, "101.00,102.00,103.00,108.00,21");
	
	// Дт 101,102,103,108 - Кт 401.10,303.04,...
	Если СчетДтЭтоСчетУчета И Не СчетКтЭтоСчетУчета Тогда
		ИзмениласьСтоимостьОС = Истина;
		ДтКт = "Дт";
	// Дт 401.20,303.04,... - Кт 101,102,103,108.
	ИначеЕсли Не СчетДтЭтоСчетУчета И СчетКтЭтоСчетУчета Тогда
		ИзмениласьСтоимостьОС = Истина;
		ДтКт = "Кт";
	КонецЕсли;
	
	СчетДтЭтоСчетАмортизации = БухгалтерскийУчетВызовСервера.СчетВИерархии(Проводка.СчетДт, "104.00");
	СчетКтЭтоСчетАмортизации = БухгалтерскийУчетВызовСервера.СчетВИерархии(Проводка.СчетКт, "104.00");
	
	// Дт ... - Кт 104.
	Если Не СчетДтЭтоСчетАмортизации И СчетКтЭтоСчетАмортизации Тогда
		ИзмениласьАмортизацияОС = Истина;
		ДтКт = "Кт";
	// Дт 104 - Кт ...
	ИначеЕсли СчетДтЭтоСчетАмортизации И Не СчетКтЭтоСчетАмортизации Тогда
		ИзмениласьАмортизацияОС = Истина;
		ДтКт = "Дт";
	КонецЕсли;
	
	СчетДтЭтоСчетОбесценения = БухгалтерскийУчетВызовСервера.СчетВИерархии(Проводка.СчетДт, "114.00");
	СчетКтЭтоСчетОбесценения = БухгалтерскийУчетВызовСервера.СчетВИерархии(Проводка.СчетКт, "114.00");
	
	// Дт ... - Кт 114.
	Если Не СчетДтЭтоСчетОбесценения И СчетКтЭтоСчетОбесценения Тогда
		ИзменилосьОбесценениеОС = Истина;
		ДтКт = "Кт";
	// Дт 114 - Кт ...
	ИначеЕсли СчетДтЭтоСчетОбесценения И Не СчетКтЭтоСчетОбесценения Тогда
		ИзменилосьОбесценениеОС = Истина;
		ДтКт = "Дт";
	КонецЕсли;
	
	Если ИзмениласьСтоимостьОС Или ИзмениласьАмортизацияОС Или ИзменилосьОбесценениеОС Тогда
		
		РеквизитыПроводки = Новый Структура("Организация,Период,СчетДт,СчетКт,
			|СубконтоДт1,СубконтоДт2,СубконтоДт3,СубконтоКт1,СубконтоКт2,СубконтоКт3");
		ЗаполнитьЗначенияСвойств(РеквизитыПроводки, Проводка);
		ДанныеОбъектаОС = ПолучитьДанныеОбъектаОСизПроводки(РеквизитыПроводки, ДтКт);
		
		ПоНорме = ДанныеОбъектаОС.ПорядокПогашенияСтоимости =
			ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации")
			И (ДанныеОбъектаОС.СпособНачисленияАмортизации =
					ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный")
				Или ДанныеОбъектаОС.СпособНачисленияАмортизации =
					ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка")
				Или ДанныеОбъектаОС.СпособНачисленияАмортизации =
					ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции"));
					
		Если ПоНорме Тогда
			Проводка.ДопДействияТребуются = Истина;
			Проводка.ДопДействияСобытие = "ИзменениеСтоимостиАмортизацииОСЛинейныйМетод";
			Проводка.ДопДействияДтКт = ДтКт;
		ИначеЕсли ДанныеОбъектаОС.ГрупповойУчет Тогда
			Проводка.ДопДействияТребуются = Истина;
			Проводка.ДопДействияСобытие = "ИзменениеСтоимостиАмортизацииОСГрупповойУчет";
			Проводка.ДопДействияДтКт = ДтКт;			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеОбъектаОСизПроводки(Проводка, ДтКт)
	
	ДанныеОбъектаОС = Новый Структура;
	ДанныеОбъектаОС.Вставить("ОсновноеСредство", Справочники.ОсновныеСредства.ПустаяСсылка());
	ДанныеОбъектаОС.Вставить("ГрупповойУчет", Ложь);
	ДанныеОбъектаОС.Вставить("ПорядокПогашенияСтоимости", Перечисления.ПорядокПогашенияСтоимостиОС.ПустаяСсылка());
	ДанныеОбъектаОС.Вставить("СпособНачисленияАмортизации", Перечисления.СпособНачисленияАмортизации.ПустаяСсылка());
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка["Счет" + ДтКт]);
	Если СвойстваСчета.ВидСубконто1 = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
		ДанныеОбъектаОС.Вставить("ОсновноеСредство", Проводка["Субконто" + ДтКт + "1"]);
	ИначеЕсли СвойстваСчета.ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
		ДанныеОбъектаОС.Вставить("ОсновноеСредство", Проводка["Субконто" + ДтКт + "2"]);
	ИначеЕсли СвойстваСчета.ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
		ДанныеОбъектаОС.Вставить("ОсновноеСредство", Проводка["Субконто" + ДтКт + "3"]);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеОбъектаОС.ОсновноеСредство) Тогда
		Возврат ДанныеОбъектаОС; // Возвращаем структуру с пустыми значениями.
	КонецЕсли;
	
	ГрупповойУчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОбъектаОС.ОсновноеСредство, "ГрупповойУчет");
	ДанныеОбъектаОС.Вставить("ГрупповойУчет", ГрупповойУчет);
	
	Отбор = Новый Структура("ОсновноеСредство, Организация", ДанныеОбъектаОС.ОсновноеСредство, Проводка.Организация);
	ПараметрыАмортизации = РегистрыСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.ПолучитьПоследнее(Проводка.Период, Отбор);
	ДанныеОбъектаОС.Вставить("ПорядокПогашенияСтоимости", ПараметрыАмортизации.ПорядокПогашенияСтоимости);
	ДанныеОбъектаОС.Вставить("СпособНачисленияАмортизации", ПараметрыАмортизации.СпособНачисленияАмортизации);
	
	Возврат ДанныеОбъектаОС;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПредупрежденияОДопДействиях(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Отбор = Новый Структура("ДопДействияТребуются", Истина);
	ЕстьСтрокиСДопДействиями = (Объект.Движения.ЖурналПроводокЕПСБУ.НайтиСтроки(Отбор).Количество() > 0);
	
	ЭлементыПредупрежденияОДопДействиях = Новый Массив;
	ЭлементыПредупрежденияОДопДействиях.Добавить("ГруппаТребуютсяДопДействия");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыПредупрежденияОДопДействиях, "Видимость", ЕстьСтрокиСДопДействиями);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВводаТекстаСубконто(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДвиженияЖурналПроводок.ТекущиеДанные;
	
	ДлинаТекста = СтрДлина(Элемент.Имя);
	СторонаПроводки = Сред(Элемент.Имя, ДлинаТекста - 2, 2);
	НомерСубконто = Прав(Элемент.Имя, 1);
	
	ПараметрыДляВыбора = Новый Структура;
	ПараметрыДляВыбора.Вставить("НомерСубконто",   	Число(НомерСубконто));
	ПараметрыДляВыбора.Вставить("Организация",     	Объект.Организация);
	ПараметрыДляВыбора.Вставить("ИФО",				ТекущиеДанные.ИФО);
	ПараметрыДляВыбора.Вставить("КФО", 				ТекущиеДанные.КФО);
	ПараметрыДляВыбора.Вставить("Счет",            	ТекущиеДанные["Счет" + СторонаПроводки]);
	ПараметрыДляВыбора.Вставить("КПС",            	ТекущиеДанные["КПС" + СторонаПроводки]);
	ПараметрыДляВыбора.Вставить("КЭК",            	ТекущиеДанные["КЭК" + СторонаПроводки]);
	ПараметрыДляВыбора.Вставить("Субконто1",       	ТекущиеДанные["Субконто" + СторонаПроводки + "1"]);
	ПараметрыДляВыбора.Вставить("Субконто2",       	ТекущиеДанные["Субконто" + СторонаПроводки + "2"]);
	ПараметрыДляВыбора.Вставить("Субконто3",       	ТекущиеДанные["Субконто" + СторонаПроводки + "3"]);
	
	БухгалтерскийУчетКлиент.ОкончаниеВводаТекстаСубконто(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка, ПараметрыДляВыбора);

КонецПроцедуры

