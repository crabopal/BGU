#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ПроводкиДокумента = Движения.ЖурналПроводокЕПСБУ;
	Если НЕ ПроводкиДокумента.Модифицированность() Тогда
		ПроводкиДокумента.Прочитать();
	КонецЕсли;
	ПроводкиДокумента.Записывать = Истина;
	АктивностьДвижений = Истина;
	Если ПроводкиДокумента.Количество() > 0 Тогда
		АктивностьДвижений = ПроводкиДокумента[0].Активность;
	КонецЕсли;
	АктивностьДвижений = АктивностьДвижений И Не ПометкаУдаления; 
	
	ПроводкиДокумента.УстановитьАктивность(АктивностьДвижений);
	
	ПериодПроводки = ?(ЗначениеЗаполнено(ВидМежотчетногоПериода), ФинансовыйГод, Дата);
	
	ТаблицаДвижений = ПроводкиДокумента.Выгрузить();
	ТаблицаДвижений.ЗаполнитьЗначения(Организация,            "Организация");
	ТаблицаДвижений.ЗаполнитьЗначения(ПериодПроводки,         "Период");
	ТаблицаДвижений.ЗаполнитьЗначения(ВидМежотчетногоПериода, "ВидМежотчетногоПериода");
	ТаблицаДвижений.ЗаполнитьЗначения(БухгалтерскийУчет.ЗначениеУточненияПериода(ВидМежотчетногоПериода), "УточнениеПериода");
	
	Если ТаблицаДвижений.Колонки.Найти("ИФО") <> Неопределено Тогда
		ТаблицаДвижений.ЗаполнитьЗначения(ИФО, "ИФО");
	КонецЕсли;
	
	СуммаДокумента = ТаблицаДвижений.Итог("Сумма");
	
	Движения.ЖурналПроводокЕПСБУ.Загрузить(ТаблицаДвижений);
	
	// Критерии отбора "Документы по контрагенту", "Документы по договору",
	// "Документы по объекту ОС, НМА, НПА".
	СвязанныеОбъекты.Очистить();
	Для Каждого СтрокаОперации Из ТаблицаДвижений Цикл
		Для НомерСубконто = 1 По 3 Цикл
			ЗначениеСубконтоДт = СтрокаОперации["СубконтоДт" + НомерСубконто];   
			ЗначениеСубконтоКт = СтрокаОперации["СубконтоКт" + НомерСубконто]; 
			Если ЗначениеЗаполнено(ЗначениеСубконтоДт)
				И (ТипЗнч(ЗначениеСубконтоДт) = Тип("СправочникСсылка.Контрагенты")
				Или ТипЗнч(ЗначениеСубконтоДт) = Тип("СправочникСсылка.Договоры")  
				Или ТипЗнч(ЗначениеСубконтоДт) = Тип("СправочникСсылка.ОсновныеСредства")) 
				И СвязанныеОбъекты.Найти(ЗначениеСубконтоДт, "СвязанныйОбъект") = Неопределено Тогда
				НовыйОбъект = СвязанныеОбъекты.Добавить();
				НовыйОбъект.СвязанныйОбъект = ЗначениеСубконтоДт;
			КонецЕсли;	
			Если ЗначениеЗаполнено(ЗначениеСубконтоКт)
				И (ТипЗнч(ЗначениеСубконтоКт) = Тип("СправочникСсылка.Контрагенты")
				Или ТипЗнч(ЗначениеСубконтоКт) = Тип("СправочникСсылка.Договоры")  
				Или ТипЗнч(ЗначениеСубконтоКт) = Тип("СправочникСсылка.ОсновныеСредства")) 
				И СвязанныеОбъекты.Найти(ЗначениеСубконтоКт, "СвязанныйОбъект") = Неопределено Тогда
				НовыйОбъект = СвязанныеОбъекты.Добавить();
				НовыйОбъект.СвязанныйОбъект = ЗначениеСубконтоКт;
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;  
	
	Для Каждого ТаблицаДвижений Из Движения Цикл
		Если ТаблицаДвижений <> ПроводкиДокумента Тогда
			ТаблицаДвижений.Очистить();
			ТаблицаДвижений.УстановитьАктивность(АктивностьДвижений);
			ТаблицаДвижений.Записывать = Истина;
		КонецЕсли;
	КонецЦикла;  

    
	Если Не ПометкаУдаления Тогда
		
		УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
			ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		Документы.ОперацияБух.СформироватьДвиженияПоРегистрамУчетаОС(Движения,
			ЭтотОбъект, Движения.ЖурналПроводокЕПСБУ, УчетнаяПолитика, Отказ);
		
		Если УчетнаяПолитика.ПрименяетсяУСН Тогда
			УчетУСН.ОтразитьДоходыРасходыВКУДиР(Движения, ЭтотОбъект.Ссылка, Движения.ЖурналПроводокЕПСБУ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИДИсточника		= Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	НомерИсточника	= "";
	
	НоваяСсылка = Документы.ОперацияБух.ПолучитьСсылку();
	ЭтотОбъект.УстановитьСсылкуНового(НоваяСсылка);
	
	ПроводкиДокумента = Движения.ЖурналПроводокЕПСБУ;
	
	ПроводкиОбъектаКопирования = ОбъектКопирования.Движения.ЖурналПроводокЕПСБУ;
	ПроводкиОбъектаКопирования.Прочитать();
	
	ПроводкиКопирования = ПроводкиОбъектаКопирования.Выгрузить();
	ПроводкиКопирования.ЗаполнитьЗначения(НоваяСсылка, "Регистратор");
	
	ПроводкиДокумента.Загрузить(ПроводкиКопирования);
	ПроводкиДокумента.УстановитьАктивность(Истина);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
