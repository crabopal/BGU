#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОперацияБух.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОперацияБух КАК ОперацияБух
	|ГДЕ
	|	НЕ ОперацияБух.ВидМежотчетногоПериода = ЗНАЧЕНИЕ(Перечисление.ВидыМежотчетногоПериода.ПустаяСсылка)
	|	И ОперацияБух.ФинансовыйГод = &ПустаяДата";	 
	
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.ОперацияБух";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			ПредставлениеОбъекта = Строка(Выборка.Ссылка);
			
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект(); 
			Если НЕ Объект = Неопределено Тогда 
				Объект.Заблокировать(); 
				Объект.ФинансовыйГод = Объект.Дата;
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.ОперацияБух,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Проводки = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
	Проводки.Отбор.Регистратор.Установить(ДокументСсылка);
	Проводки.Прочитать();
	
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация,Дата");
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
		ДанныеДокумента.Организация, ДанныеДокумента.Дата);
		
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("СтоимостьОбъектовОС",
		РегистрыНакопления.СтоимостьОбъектовОС.СоздатьНаборЗаписей().ВыгрузитьКолонки());
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("СтоимостьОбъектовОСПоКонтрагентам",
		РегистрыНакопления.СтоимостьОбъектовОСПоКонтрагентам.СоздатьНаборЗаписей().ВыгрузитьКолонки());
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("АмортизацияОбъектовОС",
		РегистрыНакопления.АмортизацияОбъектовОС.СоздатьНаборЗаписей().ВыгрузитьКолонки());
	Для Каждого СтрокаТаблицы Из СтруктураДополнительныеСвойства.ТаблицыДляДвижений Цикл // удаление служебных колонок
		СтрокаТаблицы.Значение.Колонки.Удалить("Активность");
		СтрокаТаблицы.Значение.Колонки.Удалить("НомерСтроки");
		СтрокаТаблицы.Значение.Колонки.Удалить("Регистратор");
	КонецЦикла;
	
	СформироватьДвиженияПоРегистрамУчетаОС(СтруктураДополнительныеСвойства.ТаблицыДляДвижений,
		ДанныеДокумента, Проводки, УчетнаяПолитика, Ложь);
	
КонецПроцедуры

// Для проводок по счетам 101,102,103,104,108,111.60,114,01,02,21,25,26 формируются движения по регистрам учета ОС.
//
Процедура СформироватьДвиженияПоРегистрамУчетаОС(Движения, ДокументОбъект, ПроводкиДокумента, УчетнаяПолитика, Отказ) Экспорт
	
	ТаблицаПроводок = Новый ТаблицаЗначений;
	ТаблицаПроводок.Колонки.Добавить("Проводка");
	ТаблицаПроводок.Колонки.Добавить("ДтКт");
	ТаблицаПроводок.Колонки.Добавить("ОсновноеСредство");
	ТаблицаПроводок.Колонки.Добавить("ВидРаспоряжения");
	ТаблицаПроводок.Колонки.Добавить("НомерПроводки");
	
	Для Каждого Проводка Из ПроводкиДокумента Цикл
		
		ВидРаспоряженияДт = ВидРаспоряженияПоСчету(Проводка.СчетДт);
		ВидРаспоряженияКт = ВидРаспоряженияПоСчету(Проводка.СчетКт);
		
		Если ЗначениеЗаполнено(ВидРаспоряженияДт) Или ЗначениеЗаполнено(ВидРаспоряженияКт) Тогда
			
			Если ВидРаспоряженияДт <> ВидРаспоряженияКт
				Или Проводка.ПодразделениеДт <> Проводка.ПодразделениеКт
				Или Проводка.СубконтоДт.ОсновныеСредства <> Проводка.СубконтоКт.ОсновныеСредства
				Или Проводка.СубконтоДт.ЦМО <> Проводка.СубконтоКт.ЦМО
				Или Проводка.СубконтоДт.Контрагенты <> Проводка.СубконтоКт.Контрагенты Тогда
				
				Если ЗначениеЗаполнено(ВидРаспоряженияДт) И ЗначениеЗаполнено(Проводка.СубконтоДт.ОсновныеСредства) Тогда
					СтрокаТаблицы					= ТаблицаПроводок.Добавить();
					СтрокаТаблицы.Проводка			= Проводка;
					СтрокаТаблицы.ДтКт				= "Дт";
					СтрокаТаблицы.ОсновноеСредство	= Проводка.СубконтоДт.ОсновныеСредства;
					СтрокаТаблицы.ВидРаспоряжения	= ВидРаспоряженияДт;
					СтрокаТаблицы.НомерПроводки		= ?(Проводка.НомерСтроки = 0, ПроводкиДокумента.Индекс(Проводка) + 1, Проводка.НомерСтроки);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВидРаспоряженияКт) И ЗначениеЗаполнено(Проводка.СубконтоКт.ОсновныеСредства) Тогда
					СтрокаТаблицы					= ТаблицаПроводок.Добавить();
					СтрокаТаблицы.Проводка			= Проводка;
					СтрокаТаблицы.ДтКт				= "Кт";
					СтрокаТаблицы.ОсновноеСредство	= Проводка.СубконтоКт.ОсновныеСредства;
					СтрокаТаблицы.ВидРаспоряжения	= ВидРаспоряженияКт;
					СтрокаТаблицы.НомерПроводки		= ?(Проводка.НомерСтроки = 0, ПроводкиДокумента.Индекс(Проводка) + 1, Проводка.НомерСтроки);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТаблицаПроводок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОбъектовОС = ПолучитьДанныеОбъектовОСизПроводок(ТаблицаПроводок.ВыгрузитьКолонку("ОсновноеСредство"), ДокументОбъект);
	ДанныеОбъектовОС.Индексы.Добавить("ОсновноеСредство");
	
	Для Каждого СтрокаПроводки Из ТаблицаПроводок Цикл
		
		ДанныеОбъектаОС = ДанныеОбъектовОС.Найти(СтрокаПроводки.ОсновноеСредство, "ОсновноеСредство");
		
		Если ДанныеОбъектаОС = Неопределено Тогда
			Продолжить; // Для ОС с групповым учетом движения по регистрам ОС автоматически не формируются.
		КонецЕсли;
		
		ПроверитьДанныеОбъектаОСизПроводки(ДанныеОбъектаОС, СтрокаПроводки, УчетнаяПолитика, ДокументОбъект);
		
		ОтразитьДанныеПроводкиПоРегистру(Движения, СтрокаПроводки, ДанныеОбъектаОС);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВидРаспоряженияПоСчету(Счет)
	
	Если БухгалтерскийУчет.СчетВИерархии(Счет, "101.00,102.00,103.00,108.00,111.60") Тогда
		ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаБалансе;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Счет, "21") Тогда
		ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ОперативныйУчет;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Счет, "104.10,104.20,104.30,104.50,104.60,104.90") Тогда // - 104.40
		ВидРаспоряжения = "Амортизация";
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Счет, "114.10,114.20,114.30,114.60,114.70") Тогда // - 114.40, 114.80
		ВидРаспоряжения = "Обесценение";
	Иначе
		ВидРаспоряжения = РегистрыНакопления.СтоимостьОбъектовОСПоКонтрагентам.ВидРаспоряженияПоСчету(Счет);
	КонецЕсли;
	
	Возврат ВидРаспоряжения;
	
КонецФункции

Функция ПолучитьДанныеОбъектовОСизПроводок(СписокОС, ДокументОбъект)
	
	// Получим необходимые данные для массива объектов ОС.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокОС"	, СписокОС);
	Запрос.УстановитьПараметр("Организация"	, ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("Период"		, ДокументОбъект.Дата);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ СобытияОС
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&СписокОС)) КАК СобытияОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение
	|ПОМЕСТИТЬ ОстаткиОС
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&СписокОС)) КАК СтоимостьОбъектовОСОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСПоКонтрагентам.ОсновноеСредство,
	|	СтоимостьОбъектовОСПоКонтрагентам.ИнвентарныйНомер,
	|	СтоимостьОбъектовОСПоКонтрагентам.ЦМО,
	|	СтоимостьОбъектовОСПоКонтрагентам.Подразделение
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&СписокОС)) КАК СтоимостьОбъектовОСПоКонтрагентам
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство,
	|	ОсновныеСредства.Организация КАК Организация,
	|	ОсновныеСредства.ВидНФА КАК ВидНФА,
	|	ОсновныеСредства.ИмуществоКазны КАК ЭтоИмуществоКазны,
	|	ЕСТЬNULL(ОстаткиОС.ИнвентарныйНомер, ЕСТЬNULL(СобытияОС.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))) КАК ИнвентарныйНомер,
	|	ЕСТЬNULL(ОстаткиОС.ЦМО, ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)) КАК ЦМО,
	|	ЕСТЬNULL(ОстаткиОС.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ СобытияОС КАК СобытияОС
	|		ПО ОсновныеСредства.Ссылка = СобытияОС.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиОС КАК ОстаткиОС
	|		ПО ОсновныеСредства.Ссылка = ОстаткиОС.ОсновноеСредство
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&СписокОС)
	|	И НЕ ОсновныеСредства.ГрупповойУчет";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ПроверитьДанныеОбъектаОСизПроводки(ДанныеОбъектаОС, СтрокаПроводки, УчетнаяПолитика, ДокументОбъект)
	
	Проводка		= СтрокаПроводки.Проводка;
	НомерПроводки	= СтрокаПроводки.НомерПроводки;
	
	// Организация.
	Если ДанныеОбъектаОС.Организация <> Проводка.Организация Тогда
		ТекстШаблона = НСтр("ru='Проводка %1. В проводке указан объект ОС, НМА, НПА другой организации: %2.'");
		ТекстОшибки = СтрШаблон(ТекстШаблона, НомерПроводки, ДанныеОбъектаОС.Организация);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
	Если СтрокаПроводки.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаБалансе Тогда
		
		Если Не ДанныеОбъектаОС.ЭтоИмуществоКазны Или УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
			
			// Инвентарный номер.
			Если Не ЗначениеЗаполнено(ДанныеОбъектаОС.ИнвентарныйНомер) Тогда
				ТекстШаблона = НСтр("ru='Проводка %1. Для объекта ОС, НМА, НПА ""%2"" не определен инвентарный номер.'");
				ТекстОшибки = СтрШаблон(ТекстШаблона, НомерПроводки, ДанныеОбъектаОС.ОсновноеСредство);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
			
			// МОЛ.
			ЦМОПроводки = Проводка["Субконто" + СтрокаПроводки.ДтКт].ЦМО;
			Если ЗначениеЗаполнено(ЦМОПроводки) И ДанныеОбъектаОС.ЦМО <> ЦМОПроводки Тогда
				ТекстШаблона = НСтр("ru='Проводка %1. В проводке указан МОЛ / Место хранения ""%2"".
					|МОЛ / Место хранения объекта ""%3"": %4 (по данным регистра ""Стоимость объектов ОС, НМА, НПА"").'");
				ТекстОшибки = СтрШаблон(ТекстШаблона, НомерПроводки, ЦМОПроводки,
					ДанныеОбъектаОС.ОсновноеСредство, ДанныеОбъектаОС.ЦМО);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
			
		КонецЕсли;
		
		// Вид НФА.
		СчетПроводки = Проводка["Счет" + СтрокаПроводки.ДтКт];
		ВидНФА = УправлениеОсновнымиСредствамиПовтИсп.ВидНФАпоСчетуУчета(СчетПроводки);
		Если ДанныеОбъектаОС.ВидНФА <> ВидНФА Тогда
			ТекстШаблона = НСтр("ru='Проводка %1. Вид НФА объекта ОС, НМА, НПА ""%2"" не соответствует счету учета: %3.'");
			ТекстОшибки = СтрШаблон(ТекстШаблона, НомерПроводки, ДанныеОбъектаОС.ОсновноеСредство, СчетПроводки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтразитьДанныеПроводкиПоРегистру(Движения, СтрокаПроводки, ДанныеОбъектаОС)
	
	Проводка = СтрокаПроводки.Проводка;
	ДтКт = СтрокаПроводки.ДтКт;
	
	Если СтрокаПроводки.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаБалансе
		Или СтрокаПроводки.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ОперативныйУчет Тогда
		
		ВидДвижения = ?(ДтКт = "Кт", ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
		
		// Формируем синхронные движения в регистр СтоимостьОбъектовОС.
		ЗаписьСтоимость						= Движения.СтоимостьОбъектовОС.Добавить();
		ЗаписьСтоимость.ВидДвижения			= ВидДвижения;
		ЗаписьСтоимость.Период				= Проводка.Период;
		
		ЗаписьСтоимость.Организация			= Проводка.Организация;
		ЗаписьСтоимость.ОсновноеСредство	= СтрокаПроводки.ОсновноеСредство;
		ЗаписьСтоимость.ИнвентарныйНомер	= ДанныеОбъектаОС.ИнвентарныйНомер;
		ЗаписьСтоимость.ЦМО					= Проводка["Субконто" + ДтКт].ЦМО;
		ЗаписьСтоимость.Договор				= Проводка["Субконто" + ДтКт].Договоры;
		ЗаписьСтоимость.ВидРаспоряжения		= СтрокаПроводки.ВидРаспоряжения;
		ЗаписьСтоимость.Подразделение		= Проводка["Подразделение" + ДтКт];
		
		ЗаписьСтоимость.Стоимость			= Проводка.Сумма;
		ЗаписьСтоимость.Количество			= Проводка["Количество" + ДтКт];
		
		ЗаписьСтоимость.Событие				= Перечисления.ВидыСобытийОС.Прочее;
		ЗаписьСтоимость.НазваниеДокумента	= Проводка.ВидПервичногоДокумента;
		ЗаписьСтоимость.НомерДокумента		= Проводка.НомерПервичногоДокумента;
		ЗаписьСтоимость.ДатаДокумента		= Проводка.ДатаПервичногоДокумента;
		ЗаписьСтоимость.Причина				= Проводка.Содержание;
		
	ИначеЕсли СтрокаПроводки.ВидРаспоряжения = "Амортизация"
		Или СтрокаПроводки.ВидРаспоряжения = "Обесценение" Тогда
		
		ВидДвижения = ?(ДтКт = "Дт", ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
		
		// Формируем синхронные движения в регистр АмортизацияОбъектовОС.
		ЗаписьАмортизация					= Движения.АмортизацияОбъектовОС.Добавить();
		ЗаписьАмортизация.ВидДвижения		= ВидДвижения;
		ЗаписьАмортизация.Период			= Проводка.Период;
		
		ЗаписьАмортизация.Организация		= Проводка.Организация;
		ЗаписьАмортизация.ОсновноеСредство	= СтрокаПроводки.ОсновноеСредство;
		ЗаписьАмортизация.ИнвентарныйНомер	= ДанныеОбъектаОС.ИнвентарныйНомер;
		
		ЗаписьАмортизация.СуммаАмортизации	= ?(СтрокаПроводки.ВидРаспоряжения = "Амортизация", Проводка.Сумма, 0);
		ЗаписьАмортизация.СуммаОбесценения	= ?(СтрокаПроводки.ВидРаспоряжения = "Обесценение", Проводка.Сумма, 0);
		
		ЗаписьАмортизация.ЭтоСписание		= Ложь;
		
	ИначеЕсли СтрокаПроводки.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПолученоВПользование
		Или СтрокаПроводки.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаХранении
		Или СтрокаПроводки.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВАренду
		Или СтрокаПроводки.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВПользование Тогда
		
		ВидДвижения = ?(ДтКт = "Кт", ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
		
		ЦМО = Проводка["Субконто" + ДтКт].ЦМО;
		Если Не ЗначениеЗаполнено(ЦМО) Тогда
			ЦМО = ДанныеОбъектаОС.ЦМО;
		КонецЕсли;
		
		// Формируем синхронные движения в регистр СтоимостьОбъектовОСПоКонтрагентам.
		ЗаписьСтоимость						= Движения.СтоимостьОбъектовОСПоКонтрагентам.Добавить();
		ЗаписьСтоимость.ВидДвижения			= ВидДвижения;
		ЗаписьСтоимость.Период				= Проводка.Период;
		
		ЗаписьСтоимость.Организация			= Проводка.Организация;
		ЗаписьСтоимость.ЦМО					= ЦМО;
		ЗаписьСтоимость.Контрагент			= Проводка["Субконто" + ДтКт].Контрагенты;
		ЗаписьСтоимость.Договор				= Проводка["Субконто" + ДтКт].Договоры;
		ЗаписьСтоимость.ОсновноеСредство	= СтрокаПроводки.ОсновноеСредство;
		ЗаписьСтоимость.ИнвентарныйНомер	= ДанныеОбъектаОС.ИнвентарныйНомер;
		ЗаписьСтоимость.ВидРаспоряжения		= СтрокаПроводки.ВидРаспоряжения;
		ЗаписьСтоимость.Подразделение		= Проводка["Подразделение" + ДтКт];
		
		ЗаписьСтоимость.Стоимость			= Проводка.Сумма;
		ЗаписьСтоимость.Количество			= Проводка["Количество" + ДтКт];
		
		Если Не ЗначениеЗаполнено(ЗаписьСтоимость.Контрагент) И ЗначениеЗаполнено(ЗаписьСтоимость.Договор) Тогда
			ЗаписьСтоимость.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаписьСтоимость.Договор, "Контрагент");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

