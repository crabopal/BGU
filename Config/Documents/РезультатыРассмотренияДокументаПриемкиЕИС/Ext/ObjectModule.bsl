#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭлектронноеАктированиеБГУ.ДокументПриемкиДляРезультатовРассмотрен(Ссылка) Тогда
		НаборОбъектов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОснование);
		ТаблицаЭД = ИнтеграцияЭДО.АктуальныеЭлектронныеДокументы(ДокументОснование);
		Если ТаблицаЭД.Количество() > 0 Тогда

			Если ТаблицаЭД.Найти(Ссылка, "ЭлектронныйДокумент") = Неопределено Тогда
				ЭлектронныйДокумент = ТаблицаЭД[0].ЭлектронныйДокумент;
				НаборОбъектов.Добавить(Ссылка);
				ИнтеграцияЭДО.УстановитьАктуальныйЭлектронныйДокумент(НаборОбъектов, ЭлектронныйДокумент);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	РезультатыРассмотренияСсылка = ЭлектронноеАктированиеБГУ.НайтиРезультатыРассмотренияПоДокументу(ДанныеЗаполнения);
	Если ЗначениеЗаполнено(РезультатыРассмотренияСсылка) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для документа уже введен документ %1.'"),РезультатыРассмотренияСсылка);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;	
	
	ЗаполнитьПоДокументуПриемкиЕИС(ДанныеЗаполнения);
КонецПроцедуры

Процедура ЗаполнитьПоДокументуПриемкиЕИС(ДокументПриемкиЕИС) Экспорт
	ДокументОснование = ДокументПриемкиЕИС;
	
	ЗаполняемыеДанные = "Организация, Контрагент, ДатаЭлектронногоДокумента, НомерЭлектронногоДокумента, ИдентификаторДокумента, ЭтоКорректировка";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	
	ЭтотОбъект.НомерДокументаОПриемке = ДанныеДокументаОснования.НомерЭлектронногоДокумента;
	ЭтотОбъект.ДатаДокументаОПриемке = ДанныеДокументаОснования.ДатаЭлектронногоДокумента;
	
	ЭтотОбъект.ДокументОснование = ДокументОснование;
	
	ЭлектронныеДокументыБГУ.ЗаполнитьПоЭДДокументаПриемкиЕИС(ЭтотОбъект, ДокументОснование);
	
КонецПроцедуры

#КонецОбласти 

#КонецЕсли