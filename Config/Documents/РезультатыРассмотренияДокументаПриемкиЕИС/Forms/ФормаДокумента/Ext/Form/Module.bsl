Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом(Команда)
	ОбменСАрхивомКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Объект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция КомандаЭДОПрименяетсяДляДокумента(ДокументСсылка, ИмяКоманды)
	
	Если ДокументСсылка = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Документ не записан.
		|После заполнения и сохранения документа следует повторить попытку.'");
		Сообщение.Сообщить();
		
		Возврат Истина;
	КонецЕсли;	
	
	Результат = ЭлектронноеАктированиеБГУ.ДокументПриемкиДляРезультатовРассмотрен(ДокументСсылка);
	
	Если Результат = Ложь Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Состояние документа ""На рассмотрении"".
		|После изменения состояния на ""Рассмотрен"" следует повторить попытку.'");
		Сообщение.Сообщить();
	КонецЕсли;	 
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура КомиссияПриИзмененииНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Комиссия", Объект.Комиссия);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоставКомиссии.Подписант КАК Подписант
	|ИЗ
	|	Справочник.ПриемочныеКомиссииЕИСБГУ.СоставКомиссии КАК СоставКомиссии
	|ГДЕ
	|	СоставКомиссии.Ссылка = &Комиссия
	|
	|УПОРЯДОЧИТЬ ПО
	|	СоставКомиссии.НомерСтроки";
	
	Результат = Запрос.Выполнить().Выгрузить();
	Объект.УполномоченныеЛицаЗаказчика.Загрузить(Результат);
	
	УстановитьВидимостьЭлементовФормы(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ИтогПриемкиПриИзмененииНаСервере()
	Объект.ДатаПолученияТРУ = Объект.Дата;
	Объект.УказатьСведенияОЛицеПринявшемТРУ = Истина;

	Если (Объект.ИтогПриемки = 3) Тогда 
		Для Каждого ТекСтрока Из Объект.РасхожденияДляОбъектовЗакупки Цикл
			ТекСтрока.ПризнакПринятияТРУ = Ложь;
		КонецЦикла;
	КонецЕсли;	
	
	УстановитьВидимостьЭлементовФормы(ЭтаФорма);
	ЗаполнитьСодержаниеОперацииПоУмолчанию();
	ОбновитьДанныеЗаголовкаДанныеПриемки(ЭтаФорма);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	Объект = Форма.Объект;
	
	ВидимостьЗакладкиРасхождений = ?(Объект.ИтогПриемки = 2 ИЛИ Объект.ИтогПриемки = 3, Истина, Ложь);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаРасхождения", "Видимость", ВидимостьЗакладкиРасхождений);
	
	ВидимостьПринялТовары = Объект.УказатьСведенияОЛицеПринявшемТРУ;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаСведенияОЛицеПринявшемТРУ", "Видимость", ВидимостьПринялТовары);
	
	ВидимостьРешенияКомиссии = ?(ЗначениеЗаполнено(Объект.Комиссия), Истина, Ложь);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаРешениеПриемочнойКомиссии", "Видимость", ВидимостьРешенияКомиссии);
	
	Если Объект.ИтогПриемки = 2 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ИнформацияОПричинахИОснованияхОтказа", "Заголовок", НСтр("ru = 'Информация о расхождениях в приемке в соответствии с условиями контракта'"));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаИнформацияОРасхождениях", "Заголовок", НСтр("ru = 'Информация о расхождениях в приемке товаров, работ, услуг'"));
	ИначеЕсли Объект.ИтогПриемки = 3 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ИнформацияОПричинахИОснованияхОтказа", "Заголовок", НСтр("ru = 'Информация о причинах и основаниях отказа в приемке в соответствии с условиями контракта'"));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаИнформацияОРасхождениях", "Заголовок", НСтр("ru = 'Информация о причинах отказа в приемке товаров, работ, услуг'"));
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаКорректировка", "Видимость", Объект.ЭтоКорректировка);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаИсходныеДокументы", "Видимость", Объект.ЭтоКорректировка);
	Если Объект.ЭтоКорректировка Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаПрочиеКонтрагенты", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаПриемкаТРУ", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаРасхождения", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаНачисления", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаУполномоченныеЛицаЗаказчика", "Видимость", Ложь);
		
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВариантовРешенияПриемочнойКомиссии()

	СписокВыбора = Элементы.РешениеПриемочнойКомиссии.СписокВыбора;
	СписокВыбора.Очистить();
	
	СписокВыбораДляКомиссии = Элементы.РешениеЧленовПриемочнойКомиссииКодРешения.СписокВыбора;
	СписокВыбораДляКомиссии.Очистить();
	
	Если Объект.ЭтоКорректировка Тогда
		СписокВыбора.Добавить(0, НСтр("ru = 'Не определено'"));		
		СписокВыбора.Добавить(1, НСтр("ru = '1 - с изменением стоимости согласны'"));		
		СписокВыбора.Добавить(2, НСтр("ru = '2 - с изменением стоимости не согласны'"));
		
		СписокВыбораДляКомиссии.Добавить(1, НСтр("ru = '1 - с изменением стоимости согласны'"));		
		СписокВыбораДляКомиссии.Добавить(2, НСтр("ru = '2 - с изменением стоимости не согласны'"));
		
	Иначе
		СписокВыбора.Добавить(0, НСтр("ru = 'Не определено'"));		
		СписокВыбора.Добавить(1, НСтр("ru = '1 - товары поставлены (работы выполнены, услуги оказаны)'"));		
		СписокВыбора.Добавить(2, НСтр("ru = '2 - выявлены недостатки'"));
		СписокВыбора.Добавить(3, НСтр("ru = '3 - товары не поставлены (работы не выполнены, услуги не оказаны)'"));
		
		СписокВыбораДляКомиссии.Добавить(1, НСтр("ru = '1 - замечания отсутствуют'"));		
		СписокВыбораДляКомиссии.Добавить(2, НСтр("ru = '2 - выявлены замечания'"));
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура УказатьСведенияОЛицеПринявшемТРУПриИзмененииНаСервере()
	
	УстановитьВидимостьЭлементовФормы(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура РешениеПриемочнойКомиссииПриИзмененииНаСервере()
	
	Если НЕ Объект.ЭтоКорректировка Тогда
		Объект.ИтогПриемки = Объект.КодРешенияПриемочнойКомиссии;
		Объект.ДатаПолученияТРУ = Объект.Дата;
		Объект.УказатьСведенияОЛицеПринявшемТРУ = Истина;
	
		Если (Объект.ИтогПриемки = 3) Тогда 
			Для Каждого ТекСтрока Из Объект.РасхожденияДляОбъектовЗакупки Цикл
				ТекСтрока.ПризнакПринятияТРУ = Ложь;
			КонецЦикла;
		КонецЕсли;	
	
	КонецЕсли;
	
	ЗаполнитьСодержаниеОперацииПоУмолчанию();
	УстановитьВидимостьЭлементовФормы(ЭтаФорма);
	ОбновитьДанныеЗаголовкаДанныеПриемки(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура СостояниеОбработкиПриИзмененииНаСервере()
	НетЗамечаний = Ложь;
	НеобходимыеРеквизитыЗаполнены(НетЗамечаний);
	Если НетЗамечаний Тогда
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			НовоеСостояние = СостояниеОбработки;
			ЗаписьСостоянияДокумента = РегистрыСведений.СостоянияДокументовБГУДляЕИС.СоздатьМенеджерЗаписи();
			ЗаписьСостоянияДокумента.СсылкаНаОбъект = Объект.Ссылка;
			
			ЗаписьСостоянияДокумента.Прочитать();
			Если ЗаписьСостоянияДокумента.Состояние <> НовоеСостояние Тогда
				ЗаписьСостоянияДокумента.СсылкаНаОбъект = Объект.Ссылка;
				ЗаписьСостоянияДокумента.Состояние = НовоеСостояние;
				ЗаписьСостоянияДокумента.Записать();
			КонецЕсли; 
		КонецЕсли;	
	КонецЕсли;
	
	Если ЭлектронноеАктированиеБГУ.ДокументПриемкиДляРезультатовРассмотрен(Объект.Ссылка) Тогда
		НаборОбъектов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.ДокументОснование);
		ТаблицаЭД = ИнтеграцияЭДО.АктуальныеЭлектронныеДокументы(Объект.ДокументОснование);
		Если ТаблицаЭД.Количество() > 0 Тогда

			Если ТаблицаЭД.Найти(Объект.Ссылка, "ЭлектронныйДокумент") = Неопределено Тогда
				ЭлектронныйДокумент = ТаблицаЭД[0].ЭлектронныйДокумент;
				НаборОбъектов.Добавить(Объект.Ссылка);
				ИнтеграцияЭДО.УстановитьАктуальныйЭлектронныйДокумент(НаборОбъектов, ЭлектронныйДокумент);
			КонецЕсли;
		КонецЕсли;
		
		// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
		ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
		ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
		ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
		ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		ИнтерфейсДокументовЭДОКлиентСервер.ЗаполнитьСостояниеЭДО_ФормаДокумента(ПараметрыПослеЗаписи);
		// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура НеобходимыеРеквизитыЗаполнены(РезультатПроверки)
	Если Объект.ЭтоКорректировка Тогда
		Если ЗначениеЗаполнено(Объект.Комиссия) Тогда
			Если Объект.РешениеЧленовПриемочнойКомиссии.Количество() > 0 Тогда
				РезультатПроверки = Истина;
			КонецЕсли;	
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Не заполнен реквизит ""Комиссия"" на закладке ""Подписанты"".
				|После заполнения и сохранения документа следует повторить попытку.'");
			Сообщение.Сообщить();
		КонецЕсли;	
	Иначе
		РезультатПроверки = Истина;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Функция ТекущееСостояниеОбработкиДокумента()
	Результат = Перечисления.СостоянияДокументовБГУДляЕИС.НаРассмотрении;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СостоянияДокументовБГУДляЕИС.Состояние КАК Состояние
		               |ИЗ
		               |	РегистрСведений.СостоянияДокументовБГУДляЕИС КАК СостоянияДокументовБГУДляЕИС
		               |ГДЕ
		               |	СостоянияДокументовБГУДляЕИС.СсылкаНаОбъект = &СсылкаНаОбъект";
		
		Запрос.УстановитьПараметр("СсылкаНаОбъект", Объект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Состояние;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаДанныеПриемки(Форма)
	ТекстИтогаПриемки = "";
	
	Объект = Форма.Объект;
	
	Если Объект.ИтогПриемки = 1 Тогда
		ТекстИтогаПриемки = НСтр("ru='итог: полностью приняли'");
	ИначеЕсли Объект.ИтогПриемки = 2 Тогда
		ТекстИтогаПриемки = НСтр("ru='итог: есть расхождения'");
	ИначеЕсли Объект.ИтогПриемки = 3 Тогда
		ТекстИтогаПриемки = НСтр("ru='итог: не приняли'");
	КонецЕсли;
	
	Форма.ДанныеЗаголовкаПриемка = ТекстИтогаПриемки;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьДоговора()

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Договор",
		"Доступность", ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент));

КонецПроцедуры // УстановитьДоступностьДоговора()

&НаСервере
Процедура ЗаполнитьСодержаниеОперацииПоУмолчанию()
	Если Объект.ЭтоКорректировка Тогда
		Если Объект.КодРешенияПриемочнойКомиссии = 1 Тогда
			Объект.ТекстРешенияПриемочнойКомиссии = НСтр("ru = 'С изменением стоимости согласны'");
			Объект.СодержаниеОперации = НСтр("ru = 'С изменением стоимости согласны'");
		ИначеЕсли Объект.КодРешенияПриемочнойКомиссии = 2 Тогда
			Объект.ТекстРешенияПриемочнойКомиссии = НСтр("ru = 'С изменением стоимости не согласны'");
			Объект.СодержаниеОперации = НСтр("ru = 'С изменением стоимости не согласны'");
		КонецЕсли;
	Иначе	
		Если Объект.ИтогПриемки = 1 Тогда
			Объект.СодержаниеОперации = НСтр("ru = 'Товары (работы, услуги, права) приняты без расхождений (претензий)'");
		ИначеЕсли Объект.ИтогПриемки = 2 Тогда
			Объект.СодержаниеОперации = НСтр("ru = 'Товары (работы, услуги, права) приняты с расхождениями (претензией)'");
		ИначеЕсли Объект.ИтогПриемки = 3 Тогда
			Объект.СодержаниеОперации = НСтр("ru = 'Товары (работы, услуги, права) не приняты'");	
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.Комиссия) Тогда
			Объект.ТекстРешенияПриемочнойКомиссии = Объект.СодержаниеОперации;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьДанныеПричиныНеустойки()
	
	ТипНеустойки = СокрЛП(Элементы.ПрочиеНачисления.ТекущиеДанные.ТипНеустойки);
	
	Если ТипНеустойки = НСтр("ru = 'Штраф'") Тогда
		Элементы.ПрочиеНачисления.ТекущиеДанные.КодПричины = НСтр("ru = '11'");
		Элементы.ПрочиеНачисления.ТекущиеДанные.НаименованиеПричины = НСтр("ru = 'Ненадлежащее исполнение поставщиком (подрядчиком, исполнителем) обязательств, предусмотренных контрактом,
			|за исключением просрочки исполнения поставщиком (подрядчиком, исполнителем) обязательств (в том числе гарантийного обязательства), предусмотренных контрактом'");
	ИначеЕсли ТипНеустойки = НСтр("ru = 'Пеня'") Тогда
		Элементы.ПрочиеНачисления.ТекущиеДанные.КодПричины = НСтр("ru = '21'");
		Элементы.ПрочиеНачисления.ТекущиеДанные.НаименованиеПричины = НСтр("ru = 'Просрочка исполнения поставщиком (подрядчиком, исполнителем) обязательств, предусмотренных контрактом (в том числе гарантийного обязательства)'");
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеРешенияПоКоду()
	КодРешения = Элементы.РешениеЧленовПриемочнойКомиссии.ТекущиеДанные.КодРешения;
	
	Если Объект.ЭтоКорректировка Тогда
		Если КодРешения = 1 Тогда
			Элементы.РешениеЧленовПриемочнойКомиссии.ТекущиеДанные.КодРешения = 1;
			Элементы.РешениеЧленовПриемочнойКомиссии.ТекущиеДанные.Решение = НСтр("ru = 'С изменением стоимости согласен'");
		ИначеЕсли КодРешения = 2 Тогда
			Элементы.РешениеЧленовПриемочнойКомиссии.ТекущиеДанные.КодРешения = 2;
			Элементы.РешениеЧленовПриемочнойКомиссии.ТекущиеДанные.Решение = НСтр("ru = 'С изменением стоимости не согласен'");
		КонецЕсли;
	Иначе	
		Если КодРешения = 1 Тогда
			Элементы.РешениеЧленовПриемочнойКомиссии.ТекущиеДанные.КодРешения = 1;
			Элементы.РешениеЧленовПриемочнойКомиссии.ТекущиеДанные.Решение = НСтр("ru = 'Замечания отсутствуют'");
		ИначеЕсли КодРешения = 2 Тогда
			Элементы.РешениеЧленовПриемочнойКомиссии.ТекущиеДанные.КодРешения = 2;
			Элементы.РешениеЧленовПриемочнойКомиссии.ТекущиеДанные.Решение = НСтр("ru = 'Выявлены замечания'");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
	
&НаСервере
Процедура ЗаполнитьПоДокументуПриемкиЕИС() Экспорт
	ДокументОснование = Объект.ДокументОснование;
	
	ЗаполняемыеДанные = "Организация, Контрагент, ДатаЭлектронногоДокумента, НомерЭлектронногоДокумента, ИдентификаторДокумента, ЭтоКорректировка";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(Объект, ДанныеДокументаОснования);
	
	Объект.НомерДокументаОПриемке = ДанныеДокументаОснования.НомерЭлектронногоДокумента;
	Объект.ДатаДокументаОПриемке = ДанныеДокументаОснования.ДатаЭлектронногоДокумента;
	
	ЭлектронныеДокументыБГУ.ЗаполнитьПоЭДДокументаПриемкиЕИС(Объект, ДокументОснование);
	
	ЗаполнитьСписокВариантовРешенияПриемочнойКомиссии();
	
КонецПроцедуры

#Область ЭлектронноеВзаимодействиеОбменСКонтрагентами

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуЭДО(Команда)
	
	Если КомандаЭДОПрименяетсяДляДокумента(Объект.Ссылка, Команда.Имя) Тогда
		
		ЭлектронноеВзаимодействиеКлиент.ВыполнитьПодключаемуюКомандуЭДО(Команда, ЭтотОбъект, Объект);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодписантовПоКомиссииНаСервере()
	Если ЗначениеЗаполнено(Объект.Комиссия) ТОгда
		Объект.РешениеЧленовПриемочнойКомиссии.Очистить();
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПриемочныеКомиссииЕИСБГУСоставКомиссии.Подписант КАК Подписант,
		               |	ПриемочныеКомиссииЕИСБГУСоставКомиссии.Председатель КАК Председатель
		               |ИЗ
		               |	Справочник.ПриемочныеКомиссииЕИСБГУ.СоставКомиссии КАК ПриемочныеКомиссииЕИСБГУСоставКомиссии
		               |ГДЕ
		               |	ПриемочныеКомиссииЕИСБГУСоставКомиссии.Ссылка = &КомиссияСсылка";
		
		Запрос.УстановитьПараметр("КомиссияСсылка", Объект.Комиссия);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Объект.РешениеЧленовПриемочнойКомиссии.Добавить();
			НоваяСтрока.Подписант = Выборка.Подписант;
			Если Выборка.Председатель Тогда
				НоваяСтрока.РольВПриемочнойКомиссии = Перечисления.РолиВПриемочнойКомиссииЕИС.ПредседательПриемочнойКомиссии;
			Иначе
				НоваяСтрока.РольВПриемочнойКомиссии = Перечисления.РолиВПриемочнойКомиссииЕИС.ЧленПриемочнойКомиссии;
			КонецЕсли;	
			КодРешения = 1;
			НоваяСтрока.КодРешения = КодРешения;
			Если Объект.ЭтоКорректировка Тогда
				НоваяСтрока.Решение = НСтр("ru = 'С изменением стоимости согласен'");
			Иначе	
				НоваяСтрока.Решение = НСтр("ru = 'Замечания отсутствуют'");
			КонецЕсли;
		КонецЦикла;	
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

