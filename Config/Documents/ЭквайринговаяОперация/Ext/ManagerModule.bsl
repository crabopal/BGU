Процедура УстановитьТиповуюОперациюПоУмолчанию_2_0_64() Экспорт
	
	НоваяТиповаяОперацияПоУмолчанию = Справочники.ТиповыеОперации.ЭквайринговаяОперация_ЭквайринговаяОперация2018;
	ИдентификаторДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяТиповаяОперацияПоУмолчанию, "ИдентификаторДокумента");
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		// Выходим:
		Возврат;
	КонецЕсли;
	
	// Сведения для вывода в журнал регистрации:
	ИмяСобытия			= НСтр("ru='Данные. Изменение'");
	КомментарийОК 		= НСтр("ru='Установлена типовая операция по умолчанию всем пользователям документа Эквайринговая операция'");
	КомментарийОшибка	= НСтр("ru='Ошибка при установке типовой операции по умолчанию всем пользователям документа Эквайринговая операция: '");
	
	Попытка
		// Настраиваем запрос:
		ЗапросПоиск = Новый Запрос();
		ЗапросПоиск.УстановитьПараметр("ИдентификаторДокумента",	ИдентификаторДокумента);
		ЗапросПоиск.УстановитьПараметр("ПустойПользователь",		Справочники.Пользователи.ПустаяСсылка());
		ЗапросПоиск.УстановитьПараметр("ПустаяТиповаяОперация",		Справочники.ТиповыеОперации.ПустаяСсылка());
		ЗапросПоиск.Текст = "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Истина
		|ИЗ
		|	РегистрСведений.ТиповыеОперацииПоУмолчанию
		|ГДЕ
		|	Пользователь = &ПустойПользователь
		|	И	ИдентификаторДокумента = &ИдентификаторДокумента
		|	И	НЕ ТиповаяОперация = &ПустаяТиповаяОперация
		|;";
		
		// Выполняем запрос:
		Если ЗапросПоиск.Выполнить().Пустой() Тогда
			БухгалтерскиеОперацииВызовСервера.УстановитьОперациюПоУмолчанию(НоваяТиповаяОперацияПоУмолчанию, Истина); // ДляВсехПользователей
			
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,								// имя события
				УровеньЖурналаРегистрации.Информация,	// уровень
				,										// объект метаданных
				,										// данные
				КомментарийОК);							// комментарий
		КонецЕсли;
		
	Исключение
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,							// имя события
			УровеньЖурналаРегистрации.Ошибка,	// уровень
			,									// объект метаданных
			,									// данные
			КомментарийОшибка + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	// комментарий
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ЗаполнениеДокумента

Функция ЗаполнитьНаОсновании(Знач Основание, Объект, ОписаниеОшибки = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен документ основания.'");
		Возврат Ложь;
	КонецЕсли;	
	
	Отказ = НЕ Основание.Проведен;
	Если Отказ	Тогда
		ОписаниеОшибки = НСтр("ru='Документ-основание не проведен. Проведите документ-основание и повторите операцию.'");
		Возврат Ложь;
	КонецЕсли;	
	
	ТипДанныхЗаполнения = ТипЗнч(Основание);

	Если ТипДанныхЗаполнения = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		ЗаполнитьДокументНаОснованииАктаОбОказанииУслуг(Основание, Объект);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ЗаполнитьДокументНаОснованииНакладнойТорг12(Основание, Объект);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.СчетНаОплату") Тогда
		ЗаполнитьДокументНаОснованииСчетНаОплату(Основание, Объект);	
	КонецЕсли;
		
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьДокументНаОснованииАктаОбОказанииУслуг(Знач ДокументОснование, Объект)

	ТекстЗапроса = "ВЫБРАТЬ
	               |	АктОбОказанииУслуг.Организация КАК Организация,
	               |	АктОбОказанииУслуг.ИФО КАК ИФО,
	               |	АктОбОказанииУслуг.Контрагент КАК Контрагент,
	               |	АктОбОказанииУслуг.Договор КАК Договор,
	               |	АктОбОказанииУслуг.Подразделение КАК Подразделение,
	               |	АктОбОказанииУслуг.СуммаДокумента КАК СуммаДокумента,
	               |	АктОбОказанииУслуг.Ссылка КАК ДокументОснование,
	               |	АктОбОказанииУслуг.УслугиОказанные.(
	               |		СтавкаНДС КАК СтавкаНДС,
	               |		СУММА(СуммаНДС) КАК СуммаНДС
	               |	) КАК УслугиОказанные
	               |ИЗ
	               |	Документ.АктОбОказанииУслуг КАК АктОбОказанииУслуг
	               |ГДЕ
	               |	АктОбОказанииУслуг.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	АктОбОказанииУслуг.УслугиОказанные.(СтавкаНДС)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Основание = Запрос.Выполнить().Выбрать();
	Основание.Следующий();
		
	ЗаполнитьЗначенияСвойств(Объект, Основание);
	Объект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой;
	Если ЗначениеЗаполнено(Основание.Договор) Тогда 
		Объект.Основание = ПредставлениеДоговора(Объект.Договор);
	КонецЕсли;
	
	Расшифровка = Основание.УслугиОказанные.Выгрузить();
	Если Расшифровка.Количество() = 1 Тогда 
		Объект.СтавкаНДС 	= Расшифровка[0].СтавкаНДС;
		Объект.СуммаНДС 	= Расшифровка[0].СуммаНДС;
	ИначеЕсли Расшифровка.Количество() > 1 Тогда 
		Объект.СуммаНДС 	= Расшифровка.Итог("СуммаНДС");
	КонецЕсли;	
		
	ДокументыЧекаККМ = Объект.ДокументыЧекаККМ.Добавить();
	ДокументыЧекаККМ.ДокументОснованиеЧекаККМ 	= ДокументОснование;
	ДокументыЧекаККМ.ПризнакСпособаРасчета 		= Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
	
КонецФункции	

Функция ЗаполнитьДокументНаОснованииНакладнойТорг12(Знач ДокументОснование, Объект)

	ТекстЗапроса = "ВЫБРАТЬ
	               |	НакладнаяНаРеализациюТорг12.Ссылка КАК ДокументОснование,
	               |	НакладнаяНаРеализациюТорг12.Организация КАК Организация,
	               |	НакладнаяНаРеализациюТорг12.ИФО КАК ИФО,
	               |	НакладнаяНаРеализациюТорг12.Контрагент КАК Контрагент,
	               |	НакладнаяНаРеализациюТорг12.Договор КАК Договор,
	               |	НакладнаяНаРеализациюТорг12.Подразделение КАК Подразделение,
	               |	НакладнаяНаРеализациюТорг12.КФО КАК КФО,
	               |	НакладнаяНаРеализациюТорг12.Номенклатура.(
	               |		СтавкаНДС КАК СтавкаНДС,
	               |		СУММА(СуммаНДС) КАК СуммаНДС
	               |	) КАК Номенклатура,
	               |	НакладнаяНаРеализациюТорг12.СуммаДокумента КАК СуммаДокумента
	               |ИЗ
	               |	Документ.НакладнаяНаРеализациюТорг12 КАК НакладнаяНаРеализациюТорг12
	               |ГДЕ
	               |	НакладнаяНаРеализациюТорг12.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НакладнаяНаРеализациюТорг12.Номенклатура.(СтавкаНДС)";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Основание = Запрос.Выполнить().Выбрать();
	Основание.Следующий();
		
	ЗаполнитьЗначенияСвойств(Объект, Основание);
	Объект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой;
	Если ЗначениеЗаполнено(Основание.Договор) Тогда 
		Объект.Основание = ПредставлениеДоговора(Объект.Договор);
	КонецЕсли;
	
	Расшифровка = Основание.Номенклатура.Выгрузить();
	Если Расшифровка.Количество() = 1 Тогда 
		Объект.СтавкаНДС 	= Расшифровка[0].СтавкаНДС;
		Объект.СуммаНДС 	= Расшифровка[0].СуммаНДС;
	ИначеЕсли Расшифровка.Количество() > 1 Тогда 
		Объект.СуммаНДС 	= Расшифровка.Итог("СуммаНДС");
	КонецЕсли;	
		
	ДокументыЧекаККМ = Объект.ДокументыЧекаККМ.Добавить();
	ДокументыЧекаККМ.ДокументОснованиеЧекаККМ 	= ДокументОснование;
	ДокументыЧекаККМ.ПризнакСпособаРасчета 		= Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
	
КонецФункции	

Функция ЗаполнитьДокументНаОснованииСчетНаОплату(Знач ДокументОснование, Объект) Экспорт 

	Объект.ДокументыЧекаККМ.Очистить();
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	                      |	0 КАК СуммаНДС
	                      |ПОМЕСТИТЬ СуммыПлатежа
	                      |ИЗ
	                      |	Документ.СчетНаОплату.ВозвратнаяТара КАК СчетНаОплатуВозвратнаяТара
	                      |ГДЕ
	                      |	СчетНаОплатуВозвратнаяТара.Ссылка = &Ссылка
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	СчетНаОплатуМатериалы.СтавкаНДС,
	                      |	СчетНаОплатуМатериалы.СуммаНДС
	                      |ИЗ
	                      |	Документ.СчетНаОплату.Материалы КАК СчетНаОплатуМатериалы
	                      |ГДЕ
	                      |	СчетНаОплатуМатериалы.Ссылка = &Ссылка
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	СчетНаОплатуОсновныеСредства.СтавкаНДС,
	                      |	СчетНаОплатуОсновныеСредства.СуммаНДС
	                      |ИЗ
	                      |	Документ.СчетНаОплату.ОсновныеСредства КАК СчетНаОплатуОсновныеСредства
	                      |ГДЕ
	                      |	СчетНаОплатуОсновныеСредства.Ссылка = &Ссылка
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	СчетНаОплатуУслуги.СтавкаНДС,
	                      |	СчетНаОплатуУслуги.СуммаНДС
	                      |ИЗ
	                      |	Документ.СчетНаОплату.Услуги КАК СчетНаОплатуУслуги
	                      |ГДЕ
	                      |	СчетНаОплатуУслуги.Ссылка = &Ссылка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	СуммыПлатежа.СтавкаНДС КАК СтавкаНДС,
	                      |	СУММА(СуммыПлатежа.СуммаНДС) КАК СуммаНДС
	                      |ИЗ
	                      |	СуммыПлатежа КАК СуммыПлатежа
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	СуммыПлатежа.СтавкаНДС
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	СчетНаОплату.Ссылка КАК ДокументОснование,
	                      |	СчетНаОплату.ИФО КАК ИФО,
	                      |	СчетНаОплату.Организация КАК Организация,
	                      |	СчетНаОплату.Подразделение КАК Подразделение,
	                      |	СчетНаОплату.Контрагент КАК Контрагент,
	                      |	СчетНаОплату.КФО КАК КФО,
	                      |	СчетНаОплату.КОСГУ КАК КОСГУ,
	                      |	СчетНаОплату.Договор КАК Договор,
	                      |	СчетНаОплату.СуммаДокумента КАК СуммаДокумента,
	                      |	СчетНаОплату.Контрагент.Наименование КАК ФИО,
	                      |	СчетНаОплату.Контрагент.ВидКонтрагента КАК ВидКонтрагента,
	                      |	СчетНаОплату.КПС КАК КПС
	                      |ИЗ
	                      |	Документ.СчетНаОплату КАК СчетНаОплату
	                      |ГДЕ
	                      |	СчетНаОплату.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаНДС 		= МассивРезультатов[1].Выгрузить();
	ВыборкаШапка 	= МассивРезультатов[2].Выбрать();
	
	Если ВыборкаШапка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(Объект, ВыборкаШапка);
		Объект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой;
		Если ЗначениеЗаполнено(ВыборкаШапка.Договор) Тогда 
			Объект.Основание = ПредставлениеДоговора(Объект.Договор);
		КонецЕсли;
		
		Объект.СчетРасчетов 	= БухгалтерскийУчет.СчетПоКоду("205.31");
		
		Если ВыборкаНДС.Количество() = 1 Тогда 
			Объект.СтавкаНДС 	= ВыборкаНДС[0].СтавкаНДС;
			Объект.СуммаНДС 	= ВыборкаНДС[0].СуммаНДС;
		ИначеЕсли ВыборкаНДС.Количество() > 1 Тогда 
			Объект.СуммаНДС 	= ВыборкаНДС.Итог("СуммаНДС");
		КонецЕсли;	
		
		Объект.КФО      				= ВыборкаШапка.КФО;
		Объект.КБКНазначениеПлатежа     = ВыборкаШапка.КПС;
		Объект.КОСГУНазначениеПлатежа 	= ВыборкаШапка.КОСГУ;
		
		ДокументыЧекаККМ 							= Объект.ДокументыЧекаККМ.Добавить();
		ДокументыЧекаККМ.ДокументОснованиеЧекаККМ 	= ДокументОснование;
		ДокументыЧекаККМ.ПризнакСпособаРасчета 		= Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная;
		
	КонецЕсли;
	
КонецФункции

Функция ПредставлениеДоговора(Договор)
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидОбязательства,ДатаДоговора,НомерДоговора");
	Возврат "" + РеквизитыДоговора.ВидОбязательства
		+ " от " + Формат(РеквизитыДоговора.ДатаДоговора, "ДФ=dd.MM.yyyy") + " № " + РеквизитыДоговора.НомерДоговора;
	
КонецФункции
	
#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "РасчетныйДокументБезККТ", 5);
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// В документах по кор.счетам 205.00,209.00 с заполненным ДопСубконтоРасчетов
	// заполним новый реквизит СчетРасчетов.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЭквайринговаяОперация.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЭквайринговаяОперация КАК ЭквайринговаяОперация
	|ГДЕ
	|	ЭквайринговаяОперация.КорСчет В(&КорСчет)
	|	И ЭквайринговаяОперация.СчетРасчетов = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	И ЭквайринговаяОперация.ДопСубконтоРасчетов <> НЕОПРЕДЕЛЕНО";
	Запрос.УстановитьПараметр("КорСчет", БухгалтерскийУчет.СписокСчетов("205.00,209.00", , Истина));
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.ЭквайринговаяОперация";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			// Объект не удается заблокировать - попробуем обработать его на следующей итерации.
			// Отдельно обрабатывать ошибку не требуется, т.к. в худшем случае обработчик зациклится
			// и прервется автоматически.
			ЗафиксироватьТранзакцию();
			Продолжить;
		КонецПопытки;
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Выборка.Ссылка) Тогда
			// Вероятно был удален раньше, чем обработчик дошел до него
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		
		// Проводки документа Дт Расчеты Кт Деньги по балансовым счетам.
		ПроводкиДокумента = БухгалтерскийУчет.ПроводкиДокументов(Выборка.Ссылка, Объект.КорСчет, "Кт", "201.00,304.05").Выгрузить();
		
		Отбор = Новый Структура("ХарактеристикаДвиженияДт", Объект.КОСГУНазначениеПлатежа);
		ПроводкиСДаннымКЭК = ПроводкиДокумента.НайтиСтроки(Отбор);
		
		Если ПроводкиСДаннымКЭК.Количество() > 0 Тогда
			// Заполняем СчетРасчетов из проводок.
			Объект.СчетРасчетов = ПроводкиСДаннымКЭК[0].СчетКт;
		Иначе
			// Заполняем СчетРасчетов по КОСГУ, как при проведении документа.
			НаДату = УчетРасчетов.ПериодПолученияОстатков(Объект, "Дата");
			Объект.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
				Объект.КОСГУНазначениеПлатежа, Объект.КорСчет,, НаДату, Объект.Организация, Объект.ИФО);
		КонецЕсли;
		
		Если Не Объект.Модифицированность() Тогда
			
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
			
		КонецЕсли;
		
		
		Попытка
		
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.НакладнаяНаОтпускИК,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
