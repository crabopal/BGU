#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НеПроверяемыеРеквизиты = Новый Массив;
	
	// При отражении доходов от розничных продаж Контрагент и Договор не указывается.
	Если ВидОперации = Перечисления.ВидыОперацииЭквайринга.ПоступлениеВыручкиОтРозничныхПродаж
	 ИЛИ ВидОперации = Перечисления.ВидыОперацииЭквайринга.ВозвратВыручкиОтРозничныхПродаж Тогда
		
		НеПроверяемыеРеквизиты.Добавить("Контрагент");
		НеПроверяемыеРеквизиты.Добавить("Договор");
		НеПроверяемыеРеквизиты.Добавить("ФискальныйРегистратор");
		НеПроверяемыеРеквизиты.Добавить("СистемаНалогообложенияЧекаККМ");
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаЭлектроннымиСредствамиПлатежаПоРеестру
		ИЛИ ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаЧерезСервисПриемаПлатежей Тогда
		НеПроверяемыеРеквизиты.Добавить("ВидПлатежнойКарты");
		НеПроверяемыеРеквизиты.Добавить("ЭквайринговыйТерминал");
		НеПроверяемыеРеквизиты.Добавить("ФискальныйРегистратор");
		НеПроверяемыеРеквизиты.Добавить("СистемаНалогообложенияЧекаККМ");
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацииЭквайринга.ВозвратОплатыПлатежнойКартой Тогда
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЭквайринговаяОперация") Тогда
			Если ДокументОснование.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаЧерезСервисПриемаПлатежей Тогда
				НеПроверяемыеРеквизиты.Добавить("ВидПлатежнойКарты");
				НеПроверяемыеРеквизиты.Добавить("ЭквайринговыйТерминал");
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, Дата, КФО);
	
	// Реквизиты учета затрат на услуги банка-эквайера.
	КомиссияУдерживаетсяПриПроведенииПлатежа = (СпособОплатыУслугЭквайера =
		Перечисления.СпособыОплатыУслугЭквайринга.КомиссияУдерживаетсяПриПроведенииПлатежа);
	ЭтоВозвратОплаты =
		(ВидОперации = Перечисления.ВидыОперацииЭквайринга.ВозвратОплатыПлатежнойКартой
		ИЛИ ВидОперации = Перечисления.ВидыОперацииЭквайринга.ВозвратВыручкиОтРозничныхПродаж);
	Если КомиссияУдерживаетсяПриПроведенииПлатежа И НЕ ЭтоВозвратОплаты Тогда
		
		// Комиссия отражается в расходах организации.
		// Проверяем настройки счета и аналитики затрат.
		
		РеквизитыСчетаЗатрат = Новый Структура("Счет, КПС, Субконто1, Субконто2, Субконто3",
			"СчетУчетаЗатрат", "КПСУчетаЗатрат", "СубконтоЗатрат1", "СубконтоЗатрат2", "СубконтоЗатрат3");
		БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаЗатрат,
			ЭтотОбъект, , Отказ);
		
		Если ОтражатьВНалоговомУчете Тогда
			
			РеквизитыСчетаЗатратНУ = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
				"СчетУчетаЗатратНУ", "СубконтоЗатратНУ1", "СубконтоЗатратНУ2", "СубконтоЗатратНУ3");
			БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаЗатратНУ,
				ЭтотОбъект, , Отказ);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ИспользуетсяНастройкаПогашенияЗадолженности =
		(ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой
		ИЛИ ВидОперации = Перечисления.ВидыОперацииЭквайринга.ВозвратОплатыПлатежнойКартой
		ИЛИ ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаЧерезСервисПриемаПлатежей
		ИЛИ ВидОперации = Перечисления.ВидыОперацииЭквайринга.ПоступлениеВыручкиОтРозничныхПродажКомиссионныхТоваров
		ИЛИ ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаЭлектроннымиСредствамиПлатежаПоРеестру);
	Если НЕ ИспользуетсяНастройкаПогашенияЗадолженности Тогда
		СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
		ДопСубконтоРасчетов = Неопределено;
	КонецЕсли;
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ОплатаВыполнена = Ложь;
	ПробитЧек = Ложь;
	СсылочныйНомер = "";
	НомерЧекаЭТ = "";
	НомерЧекаККМ = "";
	
	// Очистим поле "Оплатить до", т.к. данный платеж, скорее всего, уже был оплачен в документе, который копируем.
	ОплатитьДо = Дата("00010101");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭквайринговаяОперация") Тогда
		Если ДанныеЗаполнения.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой
		 ИЛИ ДанныеЗаполнения.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ПоступлениеВыручкиОтРозничныхПродаж 
		 ИЛИ ДанныеЗаполнения.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаЧерезСервисПриемаПлатежей	Тогда
			ОформитьВозвратОплаты(ДанныеЗаполнения)
		ИначеЕсли ДанныеЗаполнения.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаЭлектроннымиСредствамиПлатежаПоРеестру Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для документа %1 нельзя ввести на основании данный вид документа.'"), ДанныеЗаполнения);
			ВызватьИсключение ТекстСообщения;
		Конецесли;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		Если ДанныеЗаполнения <> Неопределено И ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") тогда
			ТекстСообщения = "";
			Если НЕ Документы.ЭквайринговаяОперация.ЗаполнитьНаОсновании(ДанныеЗаполнения, ЭтотОбъект, ТекстСообщения) тогда
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		Если ДанныеЗаполнения <> Неопределено И ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") тогда
			ТекстСообщения = "";
			Если НЕ Документы.ЭквайринговаяОперация.ЗаполнитьНаОсновании(ДанныеЗаполнения, ЭтотОбъект, ТекстСообщения) тогда
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		Если ДанныеЗаполнения <> Неопределено И ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") тогда
			ТекстСообщения = "";
			Если НЕ Документы.ЭквайринговаяОперация.ЗаполнитьНаОсновании(ДанныеЗаполнения, ЭтотОбъект, ТекстСообщения) тогда
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОформитьВозвратОплаты(ДокументЭквайринговаяОперация)
	
	ЭтотОбъект.ДокументОснование = ДокументЭквайринговаяОперация;
	
	Если ДокументЭквайринговаяОперация.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой Тогда
		ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ВозвратОплатыПлатежнойКартой;
		ЭтотОбъект.НомерЧекаЭТВозврата = ДокументЭквайринговаяОперация.НомерЧекаЭТ;
		ЭтотОбъект.СсылочныйНомерВозврата = ДокументЭквайринговаяОперация.СсылочныйНомер;
	ИначеЕсли ДокументЭквайринговаяОперация.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаЧерезСервисПриемаПлатежей Тогда
		ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ВозвратОплатыПлатежнойКартой;
		ЭтотОбъект.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;
	Иначе
		ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ВозвратВыручкиОтРозничныхПродаж;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДокументЭквайринговаяОперация,
		"Организация,ИФО,КФО,Подразделение,ВидПлатежнойКарты,ЛицевойСчет, ПараметрыДоговораЭквайринга, Эквайер, ДоговорЭквайринга, СпособОплатыУслугЭквайера,
		|Контрагент,Договор,Основание,ИсточникСредств,КБКНазначениеПлатежа,КОСГУНазначениеПлатежа, СпособУчетаОбязательств,
		|ВидПервичногоДокумента,НомерПервичногоДокумента,ДатаПервичногоДокумента,СтавкаНДС,СуммаНДС,СуммаДокумента");
		
	ЭтотОбъект.ДокументыЧекаККМ.Загрузить(ДокументЭквайринговаяОперация.ДокументыЧекаККМ.Выгрузить());	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли