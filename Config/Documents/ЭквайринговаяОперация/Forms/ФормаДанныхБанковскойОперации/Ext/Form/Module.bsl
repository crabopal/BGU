
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НомерПлатежнойКарты = Параметры.НомерПлатежнойКарты;
	НомерЧекаЭТ = Параметры.НомерЧекаЭТ;
	СсылочныйНомер = Параметры.СсылочныйНомер;
	НомерЧекаККМ = Параметры.НомерЧекаККМ;
	
	Если Параметры.Свойство("ОперацияОтменена") Тогда 
		Если Параметры.ОперацияОтменена Тогда
			НомерЧекаЭТОтмены = Параметры.НомерЧекаЭТОтмены;
			СсылочныйНомерОтмены = Параметры.СсылочныйНомерОтмены;
			НомерЧекаККМОтмены = Параметры.НомерЧекаККМОтмены;
		КонецЕсли;	
		ОперацияОтменена = Параметры.ОперацияОтменена;
	Иначе
		ОперацияОтменена = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьЭлементов(ЭтаФорма);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаСведенияОперацииОтменыОплаты", "Видимость", Форма.ОперацияОтменена);

КонецПроцедуры
