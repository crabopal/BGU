	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Ref</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументЭквайринговаяОперация.Ссылка,
	ДокументЭквайринговаяОперация.ВерсияДанных,
	ДокументЭквайринговаяОперация.ПометкаУдаления,
	ДокументЭквайринговаяОперация.Номер,
	ДокументЭквайринговаяОперация.Дата,
	ДокументЭквайринговаяОперация.Проведен,
	ДокументЭквайринговаяОперация.Комментарий,
	ДокументЭквайринговаяОперация.Организация,
	ДокументЭквайринговаяОперация.Подразделение,
	ДокументЭквайринговаяОперация.ИФО,
	ДокументЭквайринговаяОперация.КФО,
	ДокументЭквайринговаяОперация.ВидОперации,
	ДокументЭквайринговаяОперация.ПараметрыДоговораЭквайринга,
	ДокументЭквайринговаяОперация.Контрагент,
	ДокументЭквайринговаяОперация.Договор,
	ДокументЭквайринговаяОперация.СуммаДокумента,
	ДокументЭквайринговаяОперация.КоличествоОпераций,
	ДокументЭквайринговаяОперация.МоментВремени,
	ДокументЭквайринговаяОперация.Эквайер,
	ДокументЭквайринговаяОперация.СпособОплатыУслугЭквайера,
	ДокументЭквайринговаяОперация.СпособУчетаОбязательств,
	ДокументЭквайринговаяОперация.ДоговорЭквайринга,
	ДокументЭквайринговаяОперация.ЭквайринговыйТерминал,
	ДокументЭквайринговаяОперация.ФискальныйРегистратор,
	ДокументЭквайринговаяОперация.ВидПлатежнойКарты,
	ДокументЭквайринговаяОперация.ПроцентКомиссииБанка,
	ДокументЭквайринговаяОперация.СуммаКомиссииБанка,
	ДокументЭквайринговаяОперация.ОплатаВыполнена,
	ВЫБОР
		КОГДА ДокументЭквайринговаяОперация.ОплатаВыполнена = ИСТИНА
			ТОГДА 0
		ИНАЧЕ -1
	КОНЕЦ КАК БанковскаяОперацияВыполнена,
	ДокументЭквайринговаяОперация.ПробитЧек,
	ДокументЭквайринговаяОперация.СсылочныйНомер,
	ДокументЭквайринговаяОперация.НомерЧекаЭТ,
	ДокументЭквайринговаяОперация.НомерПлатежнойКарты,
	ДокументЭквайринговаяОперация.НомерЧекаККМ,
	ДокументЭквайринговаяОперация.ЛицевойСчет,
	ДокументЭквайринговаяОперация.СтавкаНДС,
	ДокументЭквайринговаяОперация.СуммаНДС,
	ДокументЭквайринговаяОперация.ВидПервичногоДокумента,
	ДокументЭквайринговаяОперация.НомерПервичногоДокумента,
	ДокументЭквайринговаяОперация.ДатаПервичногоДокумента,
	ОперацииДокументов.Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
ДокументЭквайринговаяОперация.Ответственный
ИЗ
	Документ.ЭквайринговаяОперация КАК ДокументЭквайринговаяОперация
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		ПО ДокументЭквайринговаяОперация.Ссылка = ОперацииДокументов.Документ}</QueryText>
				<MainTable>Document.ЭквайринговаяОперация</MainTable>
				<AutoSaveUserSettings>false</AutoSaveUserSettings>
				<ListSettings>
