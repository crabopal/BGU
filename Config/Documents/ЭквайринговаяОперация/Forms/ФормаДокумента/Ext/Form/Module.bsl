#Область ОбработчикиСобытийТаблицыФормыДокументыЧекаККМ
&НаКлиенте
Процедура ДокументыЧекаККМДокументОснованиеЧекаККМПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДокументыЧекаККМ.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ДокументОснованиеЧекаККМ) Тогда
		Если ТипЗнч(ТекущиеДанные.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.ЗаявлениеНаВозвратПоЧекуККМ") Тогда
			Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой") ИЛИ
				Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЭквайринга.ПоступлениеВыручкиОтРозничныхПродаж") Тогда
				
				ТекстСообщения = НСтр("ru = 'Документ-основание со списком номенклатуры чека ККМ ""Заявление на возврат по чеку ККМ"" не соответствует виду операции!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				
				ТекущиеДанные.ДокументОснованиеЧекаККМ = "";
				
				Возврат;
			КонецЕсли;	
			
			ДокументВозвратаРозницы = ТекущиеДанные.ДокументОснованиеЧекаККМ;
			ЗаполнитьДанныеПоПеречнюНоменклатурыПрейскуранта(ДокументВозвратаРозницы);	
			ТекущиеДанные.ПризнакСпособаРасчета = ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ПредоплатаПолная");
		ИначеЕсли ТипЗнч(ТекущиеДанные.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.СчетНаОплату") Тогда
			ТекущиеДанные.ПризнакСпособаРасчета = ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ПредоплатаПолная");
		Иначе
			Если ЗначениеЗаполнено(ПризнакСпособаРасчетаПоУмолчанию) Тогда
				ТекущиеДанные.ПризнакСпособаРасчета = ПризнакСпособаРасчетаПоУмолчанию;
			Иначе
				ТекущиеДанные.ПризнакСпособаРасчета = ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой");
			КонецЕсли;	
		КонецЕсли;
		РасчетЗачетаАвансаПостоплаты();
	КонецЕсли;	
КонецПроцедуры

