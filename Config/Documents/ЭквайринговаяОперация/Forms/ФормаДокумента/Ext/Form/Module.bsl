#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	Элементы.ВидПлатежнойКарты.СписокВыбора.ЗагрузитьЗначения(
		ЭквайрингВызовСервера.ПолучитьМассивВидовПлатежныхКарт(Объект.ПараметрыДоговораЭквайринга) );
	Элементы.ЭквайринговыйТерминал.СписокВыбора.ЗагрузитьЗначения(
		ЭквайрингВызовСервера.ПолучитьМассивТерминалов(Объект.ПараметрыДоговораЭквайринга) );
	
	Элементы.КорСчет.СписокВыбора.Очистить();
	Элементы.КорСчет.СписокВыбора.Добавить(
		БухгалтерскийУчет.СчетПоКоду("205.00", Неопределено, Неопределено), НСтр("ru = '205.00'"));
	Элементы.КорСчет.СписокВыбора.Добавить(
		БухгалтерскийУчет.СчетПоКоду("209.00", Неопределено, Неопределено), НСтр("ru = '209.00'"));
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	СтатусЧекаККМПробит = ?(НомерКассовогоЧека<>0, Истина, Ложь);
	Если (Объект.ПробитЧек) ИЛИ (СтатусЧекаККМПробит) ИЛИ (Объект.ОплатаВыполнена) Тогда
		Элементы.ВидОперации.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ВалютаРубли = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета;
	
	ЗаполнитьДинамическиеРеквизитыФормы();
	ОплатитьДоУстановитьПредставление(Элементы.ОплатитьДо, Объект.ОплатитьДо);
	
	УстановитьЗаголовкиСубконтоЗатрат(ЭтаФорма, Объект, "СчетУчетаЗатрат");
	УстановитьЗаголовкиСубконтоЗатрат(ЭтаФорма, Объект, "СчетУчетаЗатратНУ");
	
	УстановитьВидимостьЭлементов(ЭтотОбъект, НомерКассовогоЧека);
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	УстановитьВидимостьЭлементовГрафикПлатежей();
	
	ОбновитьНадписьДокументОснование();
	ОбновитьДанныеЗаголовкаКомиссияБанка(ЭтаФорма);
	
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтаФорма, Объект);
	УстановитьДоступностьДоговора(ЭтаФорма, Объект);
	УстановитьДоступностьДоговораЭквайринга(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДинамическиеРеквизитыФормы()
	
	Если УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(Объект.КорСчет) Тогда
		
		УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(ЭтотОбъект,
			Объект.КОСГУНазначениеПлатежа, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма, НомерКассовогоЧека)
	
	Объект = Форма.Объект;
	
	ЭтоРозница = ЭтоРозница(Объект.ВидОперации);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"КоличествоОпераций", "Видимость", ЭтоРозница);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"Контрагент", "Видимость", НЕ ЭтоРозница);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"Договор", "Видимость", НЕ ЭтоРозница);
		
	ЭтоТолькоОтражениеУчетнойОперации = Объект.БезИспользованияОборудования ИЛИ ЭтоРозница;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаДанныеЧекаККМ", "Видимость", НЕ ЭтоТолькоОтражениеУчетнойОперации);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"КассаККМ", "Видимость", ЭтоТолькоОтражениеУчетнойОперации);
	
	СтатусЧекаККМПробит = ?(НомерКассовогоЧека<>0, Истина, Ложь);
	
	Если ЭтоРозница Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ФормаОплатитьКартой", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ФормаНапечататьЧек", "Видимость", Ложь);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ФормаОплатитьКартой", "Видимость", (НЕ Объект.ОплатаВыполнена) И (НЕ Объект.БезИспользованияОборудования));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ФормаНапечататьЧек", "Видимость", НЕ (Объект.ПробитЧек ИЛИ СтатусЧекаККМПробит) И Объект.ОплатаВыполнена И (НЕ Объект.БезИспользованияОборудования));
	КонецЕсли;
	
	Если ЭтоРозница Тогда
		Форма.Элементы.СтраницыСтатусОперации.ТекущаяСтраница = Форма.Элементы.СтраницаКоличествоОпераций;
	ИначеЕсли Объект.ОтменаОплатыВыполнена Тогда
		Форма.Элементы.СтраницыСтатусОперации.ТекущаяСтраница = Форма.Элементы.СтраницаОперацияОтменена;
	ИначеЕсли Объект.ОплатаВыполнена Тогда
		Форма.Элементы.СтраницыСтатусОперации.ТекущаяСтраница = Форма.Элементы.СтраницаОперацияПроизведена;
	Иначе
		Форма.Элементы.СтраницыСтатусОперации.ТекущаяСтраница = Форма.Элементы.СтраницаОперацияНеПроизведена;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ФормаОтменитьОплату", "Видимость", Объект.ОплатаВыполнена И НЕ Объект.ОтменаОплатыВыполнена И СтатусЧекаККМПробит);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ФормаНапечататьЧекНаОтмену", "Видимость", НЕ (Объект.ПробитЧекОтмены ИЛИ Значениезаполнено(Объект.СтатусЧекаККМОтмены)) И Объект.ОплатаВыполнена И Объект.ОтменаОплатыВыполнена И (НЕ Объект.БезИспользованияОборудования));
	
	
	КомиссияУдерживаетсяПриПроведенииПлатежа = (Объект.СпособОплатыУслугЭквайера =
		ПредопределенноеЗначение("Перечисление.СпособыОплатыУслугЭквайринга.КомиссияУдерживаетсяПриПроведенииПлатежа"));
	ЭтоВозвратОплаты = ЭтоВозвратОплаты(Объект.ВидОперации);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СтраницаКомиссияБанка", "Видимость", КомиссияУдерживаетсяПриПроведенииПлатежа И НЕ ЭтоВозвратОплаты);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СпособУчетаОбязательств", "Доступность", КомиссияУдерживаетсяПриПроведенииПлатежа И НЕ ЭтоВозвратОплаты);
		
	ЭтоВозвратОплатыПлатежнойКартой = ЭтоВозвратОплатыПлатежнойКартой(Объект.ВидОперации);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаВозвратПоДокументу", "Видимость", ЭтоВозвратОплатыПлатежнойКартой И НЕ ЭтоТолькоОтражениеУчетнойОперации);
	
	Если ЭтоВозвратОплатыПлатежнойКартой Тогда
		Форма.Элементы.ФормаОплатитьКартой.Заголовок = НСтр("ru = 'Вернуть на карту'");
	Иначе
		Форма.Элементы.ФормаОплатитьКартой.Заголовок = НСтр("ru = 'Оплатить картой'");
	КонецЕсли;
	
	ИспользуетсяНастройкаПогашенияЗадолженности = НЕ ЭтоРозница;
	НастройкаПогашенияЗадолженности = Новый Массив;
	НастройкаПогашенияЗадолженности.Добавить("КорСчет");
	НастройкаПогашенияЗадолженности.Добавить("СчетРасчетов");
	НастройкаПогашенияЗадолженности.Добавить("СпособПогашенияЗадолженности");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		НастройкаПогашенияЗадолженности, "Видимость", ИспользуетсяНастройкаПогашенияЗадолженности);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДопСубконтоРасчетов", "Видимость",
			ИспользуетсяНастройкаПогашенияЗадолженности
			И Форма.ДопСубконтоРасчетовДоступность <> 0
			И ?(Форма.ДопСубконтоРасчетовВид = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ДокументыРасчетов"),
				Объект.СпособПогашенияЗадолженности = ПредопределенноеЗначение("Перечисление.СпособыПогашенияЗадолженности.ПоДокументу"), Истина) );
				
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЭквайринга.ОплатаЭлектроннымиСредствамиПлатежаПоРеестру") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ФормаПосмотретьПредставлениеЧека", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ФормаНапечататьЧек", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ФормаНапечататьЧекНаОтмену", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ФормаОплатитьКартой", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ФормаОтменитьОплату", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ДекорацияОплатаВыполнена", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаПараметрыПлатежаПраваяКолонка", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаДанныеЧекаККМ", "Видимость", Ложь);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ЭквайринговыйТерминал", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"КассаККМ", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ПараметрыДоговораПлатежногоАгентаИзОтчетаПоКассовойСмене", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"СтраницыСтатусОперации", "Видимость", Ложь);
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЭквайринга.ОплатаЧерезСервисПриемаПлатежей") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ВидПлатежнойКарты", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ЭквайринговыйТерминал", "Видимость", Ложь);
	КонецЕсли;  
	
	Если Объект.СпособОплатыУслугЭквайера = ПредопределенноеЗначение("Перечисление.СпособыОплатыУслугЭквайринга.КомиссияОплачиваетсяПослеПоступленияДенежныхСредств") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ОтражениеНДССКомиссииВРасходах", "Доступность", Ложь);
		Объект.ОтражениеНДССКомиссииВРасходах = 0; 
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ОтражениеНДССКомиссииВРасходах", "Доступность", Истина);
	КонецЕсли;	
	
КонецПроцедуры


&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	СтатусЧекаККМПробит = ?(НомерКассовогоЧека<>0, Истина, Ложь);
	
	ВидимостьКнопкиПечатьЧекаККМ = Истина;
	ЕстьЗаключительныйЧекИсправительный = Ложь;
	
	Если СтатусЧекаККМПробит Тогда
		ЗаключительныйЧекИсправительный = ПодключаемоеОборудованиеБГУ.ЗаключительныйЧекИсправительный(Объект.Ссылка);
		Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
			ВидимостьКнопкиПечатьЧекаККМ = Истина;
			ЕстьЗаключительныйЧекИсправительный = Истина;
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаНапечататьЧек", 		"Видимость", ВидимостьКнопкиПечатьЧекаККМ И ЕстьЗаключительныйЧекИсправительный);
		Иначе
			ВидимостьКнопкиПечатьЧекаККМ = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаключительныйЧекИсправительный", 		"Видимость", ЕстьЗаключительныйЧекИсправительный);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсправительныйЧекККМ", 		"Видимость", НЕ ЕстьЗаключительныйЧекИсправительный);
	
	ВидимостьКомандККТ = ПодключаемоеОборудованиеБГУ.ВидимостьКомандККТПоТипуКассыККМ(Объект.ФискальныйРегистратор);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаEmail", 											"Видимость", ВидимостьКомандККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаSMS", 											"Видимость", ВидимостьКомандККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияОтказКлиентаОтСохраненияТелефонаEmail", 		"Видимость", ВидимостьКомандККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДанныеSMSИлиEmail", 									"Видимость", ВидимостьКомандККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаОчиститьEmailИSMS",								"Видимость", ВидимостьКомандККТ);
	
	ЭтоТолькоОтражениеУчетнойОперации = Объект.БезИспользованияОборудования;
	
	ТекущийТипПланаСчетов = БухгалтерскийУчетПовтИсп.ТекущийТипПланаСчетов(Объект.Организация);
	Если ТекущийТипПланаСчетов = Перечисления.ТипыПлановСчетов.ДляКазенных Тогда
		ВидимостьЛицевойСчетКУ = Истина;	
	Иначе
		ВидимостьЛицевойСчетКУ = Ложь;	
	КонецЕсли;	
	
	ВидимостьДокументОснование = Ложь;
	Если ЗначениеЗаполнено(Объект.ДокументОснование) И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		ВидимостьДокументОснование = Истина;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ЛицевойСчетКУ", "Видимость", ВидимостьЛицевойСчетКУ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ЛицевойСчет", "Видимость", НЕ ВидимостьЛицевойСчетКУ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтраницыСтатусОперации", "Видимость", НЕ ЭтоТолькоОтражениеУчетнойОперации);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаДанныеЧекаККМ", "Видимость", НЕ ЭтоТолькоОтражениеУчетнойОперации);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПараметрыДоговораПлатежногоАгентаИзОтчетаПоКассовойСмене", "Видимость", ЭтоТолькоОтражениеУчетнойОперации);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"Основание", "Видимость", НЕ ЭтоТолькоОтражениеУчетнойОперации);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НадписьДокументОснованиеРозница", "Видимость", ЭтоТолькоОтражениеУчетнойОперации);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДокументыЧекаККМСуммаПредоплаты", "Видимость", Объект.ЭтоПостоплата);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СуммаЗачетаАванса", "Видимость", Объект.ЭтоПостоплата);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СуммаПостоплаты", "Видимость", Объект.ЭтоПостоплата);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаДокументОснование", "Видимость", ВидимостьДокументОснование);
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЭквайринга.ОплатаЭлектроннымиСредствамиПлатежаПоРеестру") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ГруппаДанныеЧекаККМ", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"СтраницыСтатусОперации", "Видимость", Ложь);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Если ВидОперацииДокументаОснования() = ПредопределенноеЗначение("Перечисление.ВидыОперацииЭквайринга.ОплатаЧерезСервисПриемаПлатежей") Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ВидПлатежнойКарты", "Видимость", Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ЭквайринговыйТерминал", "Видимость", Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"НомерЧекаЭТВозврата", "Видимость", Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"СсылочныйНомерВозврата", "Видимость", Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ЗаполнитьДанныеВозвратаОплаты", "Видимость", Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ФормаОплатитьКартой", "Видимость", Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ФормаНапечататьЧек", "Видимость", Истина);
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма)
	
	Объект = Форма.Объект;
	
	ОтражатьВНалоговомУчете = Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(Объект.КФО);
	ОтражатьВУСНДоходыМинусРасходы = Форма.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы
		И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(Объект.КФО);
	
	Если ОтражатьВНалоговомУчете Тогда
		ТекущаяСтраница = Форма.Элементы.СтраницаНалогНаПрибыль;
	ИначеЕсли ОтражатьВУСНДоходыМинусРасходы Тогда
		ТекущаяСтраница = Форма.Элементы.СтраницаНалоговыйУчетУСН;
	Иначе
		ТекущаяСтраница = Форма.Элементы.СтраницаПустая;
	КонецЕсли;
	Если Форма.Элементы.СтраницыНалоговыйУчет.ТекущаяСтраница <> ТекущаяСтраница Тогда
		Форма.Элементы.СтраницыНалоговыйУчет.ТекущаяСтраница = ТекущаяСтраница;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)
	
	СвязанныеРеквизиты = Новый Массив;
	СвязанныеРеквизиты.Добавить("Подразделение");
	СвязанныеРеквизиты.Добавить("ЛицевойСчет");
	СвязанныеРеквизиты.Добавить("ПараметрыДоговораЭквайринга");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(
		Форма.Элементы, СвязанныеРеквизиты, "Доступность", ЗначениеЗаполнено(Объект.Организация));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговора(Форма, Объект)
	
	ДоступностьДоговора = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Договор", "Доступность", ДоступностьДоговора);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговораЭквайринга(Форма, Объект)
	
	ДоступностьДоговора = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Эквайер);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ДоговорЭквайринга", "Доступность", ДоступностьДоговора);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьНДС()
	
	СтавкаНДС = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(Объект.СтавкаНДС);
	Объект.СуммаНДС = Объект.СуммаДокумента / (100 + СтавкаНДС) * СтавкаНДС;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыПоПараметрам();
	
	Объект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой;
	
	Если ЗначениеЗаполнено(Объект.ПараметрыДоговораЭквайринга) Тогда
		
		Если ЗначениеЗаполнено(Объект.СтавкаНДС) ИЛИ ЗначениеЗаполнено(Объект.СуммаНДС) Тогда 
			ЗаполнитьЗначенияСвойств(Объект, Объект.ПараметрыДоговораЭквайринга, , "СтавкаНДС");
		Иначе 
			ЗаполнитьЗначенияСвойств(Объект, Объект.ПараметрыДоговораЭквайринга);
		КонецЕсли;	
		
		Если Объект.ПараметрыДоговораЭквайринга.ИспользоватьДляРозничныхПродаж Тогда
			Объект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ПоступлениеВыручкиОтРозничныхПродаж;
		КонецЕсли;
		
		Объект.КорСчет = КорСчетПоУмолчанию(Объект.ВидОперации);
		
		Если УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(Объект.КорСчет) Тогда
			НаДату = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
			УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(ЭтотОбъект,
				Объект.КОСГУНазначениеПлатежа, Объект.КорСчет, НаДату, Объект.Организация, Объект.ИФО);
		КонецЕсли;
		
		ДанныеОВидеКартыИПроценте =
			ЭквайрингВызовСервера.ПолучитьДанныеВидаКартыДоговораЭквайринга(Объект.ПараметрыДоговораЭквайринга);
		Если ДанныеОВидеКартыИПроценте <> Неопределено Тогда
			Объект.ВидПлатежнойКарты = ДанныеОВидеКартыИПроценте.ВидПлатежнойКарты;
			Объект.ПроцентКомиссииБанка = ДанныеОВидеКартыИПроценте.ПроцентТорговойУступки;
			Объект.СтавкаНДССКомиссииБанка = ДанныеОВидеКартыИПроценте.СтавкаНДССКомисии;
			Объект.НДССКомиссииСверху = ДанныеОВидеКартыИПроценте.НДССКомиссииСверху;
			ПересчитатьКомиссию(ЭтаФорма);
		КонецЕсли;
		
		Терминалы = ЭквайрингВызовСервера.ПолучитьМассивТерминалов(Объект.ПараметрыДоговораЭквайринга);
		
		Элементы.ВидПлатежнойКарты.СписокВыбора.ЗагрузитьЗначения(
			ЭквайрингВызовСервера.ПолучитьМассивВидовПлатежныхКарт(Объект.ПараметрыДоговораЭквайринга) );
		Элементы.ЭквайринговыйТерминал.СписокВыбора.ЗагрузитьЗначения(Терминалы);
		Если НЕ ЗначениеЗаполнено(Объект.ЭквайринговыйТерминал) Тогда
			Если Терминалы.Количество() = 1 Тогда
				Объект.ЭквайринговыйТерминал = Терминалы[0];
			КонецЕсли;
		КонецЕсли;
		
		Элементы.ИсточникСредств.СписокВыбора.ЗагрузитьЗначения(
			ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет));
		Если Элементы.ИсточникСредств.СписокВыбора.Количество() = 1 Тогда
			Если НЕ ЗначениеЗаполнено(Объект.ИсточникСредств) Тогда
				Объект.ИсточникСредств = Элементы.ИсточникСредств.СписокВыбора[0].Значение;
			КонецЕсли;
		КонецЕсли;		
		
		ЗаполнятьПервичныйДокументПриОплате = Объект.ПараметрыДоговораЭквайринга.ЗаполнятьПервичныйДокументПриОплате;
	Иначе
		ЗаполнятьПервичныйДокументПриОплате = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЛицевойСчетПриИзмененииСервер()
	
	Элементы.ИсточникСредств.СписокВыбора.ЗагрузитьЗначения(
		ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет));
	Если Элементы.ИсточникСредств.СписокВыбора.Количество() = 1 Тогда
		Объект.ИсточникСредств = Элементы.ИсточникСредств.СписокВыбора[0].Значение;	
	КонецЕсли;		
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьКомиссию(Форма)
	
	Объект = Форма.Объект;
	
	Если ЭтоВозвратОплаты(Объект.ВидОперации) Тогда
		Объект.ПроцентКомиссииБанка = 0;	
	КонецЕсли;
	
	Объект.СуммаКомиссииБанка = Объект.СуммаДокумента * Объект.ПроцентКомиссииБанка / 100; 
	Если ЗначениеЗаполнено(Объект.СтавкаНДССКомиссииБанка) Тогда 
		СтавкаНДС = УчетНДСКлиентСервер.ПолучитьМножительСтавки(Объект.СтавкаНДССКомиссииБанка, Не Объект.НДССКомиссииСверху);
		Объект.СуммаНДССКомиссииБанка = Объект.СуммаКомиссииБанка * СтавкаНДС;
		
		Если Объект.НДССКомиссииСверху Тогда 
			Объект.СуммаКомиссииБанка = Объект.СуммаКомиссииБанка + Объект.СуммаНДССКомиссииБанка;
		КонецЕсли;	
	КонецЕсли;	
	
	ОбновитьДанныеЗаголовкаКомиссияБанка(Форма);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаКомиссияБанка(Форма)
	
	Объект = Форма.Объект;
	
	Форма.ДанныеЗаголовкаКомиссияБанка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='%1%, %2 %3'"),
			Объект.ПроцентКомиссииБанка,
			Формат(Объект.СуммаКомиссииБанка, "ЧЦ=15; ЧДЦ=2; ЧН=0"),
			Строка(Форма.ВалютаРубли)); 
			
	Форма.Элементы.СтавкаНДССКомиссииБанка.Заголовок = ?(Объект.НДССКомиссииСверху, НСтр("ru='НДС сверху'"), НСтр("ru='НДС в сумме'"));		

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоРозница(ВидОперации)
	
	Возврат (ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЭквайринга.ПоступлениеВыручкиОтРозничныхПродаж")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЭквайринга.ВозвратВыручкиОтРозничныхПродаж"));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоВозвратОплаты(ВидОперации)
	
	Возврат (ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЭквайринга.ВозвратОплатыПлатежнойКартой")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЭквайринга.ВозвратВыручкиОтРозничныхПродаж"));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоВозвратОплатыПлатежнойКартой(ВидОперации)
	
	Возврат (ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЭквайринга.ВозвратОплатыПлатежнойКартой"));
	
КонецФункции

&НаСервереБезКонтекста
Функция КорСчетПоУмолчанию(ВидОперации)
	
	// Реквизит "Кор.счет" скрыт, оставлен для совместимости с предыдущими версиями.
	Если ЭтоКомиссионнаяРеализация(ВидОперации) Тогда
		Возврат БухгалтерскийУчет.СчетПоКоду("210.05", Неопределено, Неопределено);
	ИначеЕсли НЕ ЭтоРозница(ВидОперации) Тогда
		Возврат БухгалтерскийУчет.СчетПоКоду("205.00", Неопределено, Неопределено);
	Иначе
		Возврат БухгалтерскийУчет.СчетПоКоду("401.00", Неопределено, Неопределено);
	КонецЕсли;
	
КонецФункции

