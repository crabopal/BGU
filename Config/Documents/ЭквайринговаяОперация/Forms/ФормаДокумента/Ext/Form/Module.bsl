#Область ОплатаКартой

&НаКлиенте
Процедура ОплатаКартой()
	Перем ПараметрыЭТ;
	
	Если НЕ ПроверкаВозможностиРаботыСКартой(ПараметрыЭТ) Тогда
		Возврат;
	КонецЕсли;
	
	// Предварительно авторизуем операцию
	ПараметрыФормы = Новый Структура("Сумма, ПределСуммы", Объект.СуммаДокумента, Объект.СуммаДокумента);
	ПараметрыФормы.Вставить("ЗапретРедактированияСуммы", Истина);
	Если ПараметрыЭТ.ИспользоватьБезПодключенияОборудования Тогда
		ПараметрыФормы.Вставить("ПоказыватьНомерКарты", НЕ ПараметрыЭТ.НеВводитьНомерПлатежнойКарты);
	КонецЕсли;
	
	ПараметрДействия = Новый Структура;
	ПараметрДействия.Вставить("ОписаниеОшибкиФР", "");
	ПараметрДействия.Вставить("ПараметрыЭТ", ПараметрыЭТ);
	ПараметрДействия.Вставить("СуммаОперации", 0);
	ПараметрДействия.Вставить("НомерКарты", "");
	
	ПараметрДействия.Вставить("НомерСсылкиОперации", "");
	ПараметрДействия.Вставить("НомерЧекаЭТ", 0);
	ПараметрДействия.Вставить("НомерЧекаККМ", Объект.Номер);
	ПараметрДействия.Вставить("СтрокаСлипЧека", "");
	
	Если НЕ ЭтоВозвратОплаты(Объект.ВидОперации) Тогда
		ПараметрДействия.Вставить("ТипТранзакции", "AuthorizeSales");
	Иначе
		ПараметрыФормы.Вставить("НомерЧека", Объект.НомерЧекаЭТВозврата);
		ПараметрыФормы.Вставить("СсылочныйНомер", Объект.СсылочныйНомерВозврата);
		
		ПараметрДействия.Вставить("ТипТранзакции", "AuthorizeRefund");
		ПараметрыФормы.Вставить("УказатьДополнительныеДанные", Истина);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПараметрДействия", ПараметрДействия);
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуАвторизацииЭТ", ЭтотОбъект, ДополнительныеПараметры);
	Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	ОткрытьФорму("Справочник.ПодключаемоеОборудование.Форма.ФормаАвторизацииЭТ", ПараметрыФормы,,,,, ОбработчикОповещения, Режим); 
КонецПроцедуры

&НаКлиенте
Функция ПроверкаВозможностиРаботыСКартой(ПараметрыЭТ)
	Перем Отказ;
	Перем ИспользоватьБезПодключенияОборудованияФР;
	
	Результат = Ложь;
	Отказ     = Ложь;
	ПараметрыЭТ = Новый Структура("УстройствоПодключено, УстройствоПечатиПодключено", Ложь, Ложь);
	
	РезультатПроверки = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидОперации) Тогда
		ТекстСообщения = НСтр("ru = 'Не указан вид операции - оплата или возврат!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		РезультатПроверки = Ложь;
	КонецЕсли;
	
	Если ЭтоВозвратОплатыПлатежнойКартой(Объект.ВидОперации) Тогда
		Если НЕ ЗначениеЗаполнено(Объект.СсылочныйНомерВозврата) Тогда
			ТекстСообщения = НСтр("ru = 'Не указан ссылочный номер платежа!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			РезультатПроверки = Ложь;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.НомерЧекаЭТВозврата) Тогда
			ТекстСообщения = НСтр("ru = 'Не указан номер чека ЭТ платежа!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			РезультатПроверки = Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	Если Объект.ОплатаВыполнена Тогда
		
		Если ЭтоВозвратОплаты(Объект.ВидОперации) Тогда
			ТекстСообщения = "ru='Для данного документа уже выполнен возврат на платежную карту.'";
		Иначе	
			ТекстСообщения = "ru='Для данного документа уже выполнена оплата платежной картой.'";
		КонецЕсли;	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(ТекстСообщения));
		РезультатПроверки = Ложь;
	КонецЕсли;
	
	Если Модифицированность Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Документ необходимо записать.'"));
		РезультатПроверки = Ложь;
	КонецЕсли; 
	
	Если НЕ РезультатПроверки Тогда
		Возврат Результат;
	КонецЕсли;	
	
	ПолучитьНеобходимыеДанныеДляРаботыСКартой(ПараметрыЭТ, Отказ, ИспользоватьБезПодключенияОборудованияФР);
	
	Если Отказ  Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ИспользоватьБезПодключенияОборудованияФР Тогда
		ПараметрыЭТ.УстройствоПодключено = Ложь;
	Иначе	
		ПараметрыЭТ.УстройствоПодключено = Истина;
	КонецЕсли;
	
	Если ПараметрыЭТ.ИспользоватьУстройствоПечатиСлипЧека Тогда
		ПараметрыЭТ.Вставить("НеобходимоНапечататьСлипЧекНаФР", Истина);
		ПараметрыЭТ.Вставить("РезультатФР", Истина);
	Иначе
		ПараметрыЭТ.Вставить("НеобходимоНапечататьСлипЧекНаФР", Ложь);
		ПараметрыЭТ.Вставить("РезультатФР", Ложь);
	КонецЕсли;
	
	Результат = Истина;
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ПолучитьНеобходимыеДанныеДляРаботыСКартой(ПараметрыЭТ, Отказ, ИспользоватьБезПодключенияОборудованияФР = Ложь)
	
	ПараметрыЭТ = ЭквайрингВызовСервера.ПолучитьПараметрыЭТ(Объект.ЭквайринговыйТерминал);
	ПараметрыЭТ.Вставить("УстройствоПодключено", Ложь);
	ПараметрыЭТ.Вставить("УстройствоПечатиПодключено", Ложь);
	
	ИспользоватьБезПодключенияОборудованияФР = РаботаБезПодключенияФР(Объект.ФискальныйРегистратор);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РаботаБезПодключенияФР(ОбъектКасса)
	
	Если ЗначениеЗаполнено(ОбъектКасса) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектКасса, "ИспользоватьБезПодключенияОборудования");
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции


&НаКлиенте
Процедура ОповещениеВопросУспешностиОплатыКартой(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ПараметрДействия = ДополнительныеПараметры.ПараметрДействия;
	
	РезультатЭТ = (РезультатВопроса = КодВозвратаДиалога.Да);
	
	Если НЕ РезультатЭТ Тогда
		СтрокаСлипЧека = "";
		ТекстОписаниеОшибки = НСтр("ru = 'Операция отменена'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	ЗавершитьОплатуКартой(ПараметрДействия);
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуАвторизацииЭТЗавершение(РезультатВыполнения, ПараметрДействия) Экспорт 
	
	ЭтаФорма.Доступность = Истина;
	
	Если НЕ РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр("ru = 'При выполнении операции возникла ошибка:
			|""%ОписаниеОшибки%"".
			|Оплата по карте не была произведена.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	Иначе
		ПараметрДействия.НомерКарты          = РезультатВыполнения.НомерКарты;
		ПараметрДействия.НомерСсылкиОперации = РезультатВыполнения.СсылочныйНомер;
		ПараметрДействия.НомерЧекаЭТ         = РезультатВыполнения.НомерЧекаЭТ;
		ПараметрДействия.СтрокаСлипЧека      = РезультатВыполнения.ТекстСлипЧека;
		ЗавершитьОплатуКартой(ПараметрДействия);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуАвторизацииЭТ(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	ПараметрДействия = ДополнительныеПараметры.ПараметрДействия;
	
	Если ТипЗнч(РезультатОткрытияФормы) = Тип("Структура") Тогда
		
		ПараметрДействия.СуммаОперации = РезультатОткрытияФормы.Сумма;
		
		Если НЕ ПараметрДействия.ПараметрыЭТ.ИспользоватьБезПодключенияОборудования Тогда
			
			ЭтаФорма.Доступность = Ложь;
			
			ПараметрыОперации = ОборудованиеПлатежныеСистемыКлиентСервер.ПараметрыВыполненияЭквайринговойОперации();
			ПараметрыОперации.ТипТранзакции  = ПараметрДействия.ТипТранзакции;
			ПараметрыОперации.СуммаОперации  = РезультатОткрытияФормы.Сумма;
			ПараметрыОперации.НомерЧека      = РезультатОткрытияФормы.НомерЧека;
			ПараметрыОперации.СсылочныйНомер = РезультатОткрытияФормы.СсылочныйНомер;
			
			Оповещение = Новый ОписаниеОповещения("ОповещениеОткрытьФормуАвторизацииЭТЗавершение", ЭтотОбъект, ПараметрДействия);
			ОборудованиеПлатежныеСистемыКлиент.НачатьВыполнениеОперацииНаЭквайринговомТерминале(Оповещение, УникальныйИдентификатор, 
				ПараметрДействия.ПараметрыЭТ.ИдентификаторУстройства, ПараметрыОперации,,ПараметрДействия.ПараметрыЭТ.ИдентификаторУстройстваПечатиСлипЧека);
			
		Иначе
			
			ПараметрДействия.НомерКарты          = РезультатОткрытияФормы.НомерКарты;
			ПараметрДействия.НомерСсылкиОперации = РезультатОткрытияФормы.СсылочныйНомер;
			ПараметрДействия.НомерЧекаЭТ         = РезультатОткрытияФормы.НомерЧека;
			
			ТекстВопроса = НСтр("ru = 'Требуется выполнить операцию оплаты на эквайринговом терминале.'") + Символы.ПС;
			ТекстВопроса = ТекстВопроса + НСтр("ru = 'Сумма операции:'") + " "+ ПараметрДействия.СуммаОперации  + Символы.ПС;
			ТекстВопроса = ТекстВопроса + Символы.ПС;
			ТекстВопроса = ТекстВопроса + НСтр("ru = 'Операция оплаты на эквайринговом терминале прошла успешно?'");
			
			ДополнительныеПараметры = Новый Структура; 
			ДополнительныеПараметры.Вставить("ПараметрДействия", ПараметрДействия);
			ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеВопросУспешностиОплатыКартой", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьВопрос(ОбработчикОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОплатуКартой(ПараметрДействия)
	
	Объект.НомерПлатежнойКарты = ПараметрДействия.НомерКарты;
	Объект.СсылочныйНомер = ПараметрДействия.НомерСсылкиОперации;
	Объект.НомерЧекаЭТ = ПараметрДействия.НомерЧекаЭТ;
	
	Объект.ОплатаВыполнена     = Истина;
	
	ИспользоватьБезПодключенияОборудованияФР = РаботаБезПодключенияФР(Объект.ФискальныйРегистратор);
 
	Если ИспользоватьБезПодключенияОборудованияФР Тогда
		Объект.ПробитЧек = Истина;
		ПодключаемоеОборудованиеБГУКлиент.ЗаполнитьНомерДокументаКассыККМ(Объект.ФискальныйРегистратор);
		НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
		ПорядковыйНомерПродажи = НомерДокументаКассыККМ[Объект.ФискальныйРегистратор];
		
		ЗаписатьФискальныеДанныеДляРасчетногоДокумента(ПорядковыйНомерПродажи);
		
		НомерДокументаКассыККМ[Объект.ФискальныйРегистратор] = ПорядковыйНомерПродажи + 1;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
	ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись);
	Если ЗаполнятьПервичныйДокументПриОплате Тогда
		Если ЗначениеЗаполнено(Объект.ВидПервичногоДокумента) 
			И ЗначениеЗаполнено(Объект.НомерПервичногоДокумента) 
			И (НЕ(Объект.ДатаПервичногоДокумента = Дата(1,1,1))) Тогда
			ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение);
		Иначе
			ЗаполнитьПервичныйДокументПоНастройкам();
			Если ЗначениеЗаполнено(Объект.ВидПервичногоДокумента) 
				И ЗначениеЗаполнено(Объект.НомерПервичногоДокумента) 
				И (НЕ(Объект.ДатаПервичногоДокумента = Дата(1,1,1))) Тогда
				ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	РезультатЗаписи = Записать(ПараметрыЗаписи);
	
	Если РезультатЗаписи = Истина Тогда
		Если НЕ Объект.ПробитЧек Тогда
			ПробитьЧекНаКлиенте();
		Иначе
			НомерДокументаКассыККМ[Объект.ФискальныйРегистратор] = Объект.НомерЧекаККМ + 1;
			
			Подключаемый_ВыполнитьКоманду(ЭтотОбъект.Команды.Найти("ПодменюПечатьОбычное__РасчетныйДокументБезККТ"));
		КонецЕсли;
	КонецЕсли;
	
	НомерКассовогоЧека  = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	УстановитьВидимостьЭлементов(ЭтотОбъект, НомерКассовогоЧека);
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьСлипЧека

&НаКлиенте
Процедура НадписьДокументОснованиеНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭквайринговаяОперация") Тогда
		ВидДокумента = "ЭквайринговаяОперация";
	ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ОтчетПоКассовойСмене") Тогда
		ВидДокумента = "ОтчетПоКассовойСмене";
	Иначе
		Возврат;
	Конецесли;	
	
	ПараметрыФормыДокументаОснования = Новый Структура("Ключ", Объект.ДокументОснование);
		
	ОткрытьФорму("Документ."+ВидДокумента+".ФормаОбъекта", ПараметрыФормыДокументаОснования, ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ОбновитьНадписьДокументОснование()
	
	ДокументОснование = Объект.ДокументОснование;
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭквайринговаяОперация") Тогда
			НадписьДокументОснование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Эквайринговая операция № %1 от %2 г.'"),
					СокрЛП(ДокументОснование.Номер),
					Формат(ДокументОснование.Дата, "ДЛФ=D"));
		ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ОтчетПоКассовойСмене") Тогда
			НадписьДокументОснование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Отчет по кассовой смене № %1 от %2 г.'"),
					СокрЛП(ДокументОснование.Номер),
					Формат(ДокументОснование.Дата, "ДЛФ=D"));
		КонецЕсли;
	Иначе			
		НадписьДокументОснование = "";
	КонецЕсли;
	ЭтаФорма.НадписьДокументОснование = НадписьДокументОснование;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконтоЗатрат(Форма, Объект, ИмяРеквизитаСчет)
	Перем МассивПолей;
	
	Если ИмяРеквизитаСчет = "СчетУчетаЗатрат" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоЗатрат1", "ЗаголовокСубконтоЗатрат1", Истина, "СубконтоЗатрат1", Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоЗатрат2", "ЗаголовокСубконтоЗатрат2", Истина, "СубконтоЗатрат2", Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоЗатрат3", "ЗаголовокСубконтоЗатрат3", Истина, "СубконтоЗатрат3", Истина, Истина);
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетУчетаЗатрат, Форма, Объект, МассивПолей);
		
	ИначеЕсли ИмяРеквизитаСчет = "СчетУчетаЗатратНУ" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоЗатратНУ1", "ЗаголовокСубконтоЗатратНУ1", Истина, "СубконтоЗатратНУ1", Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоЗатратНУ2", "ЗаголовокСубконтоЗатратНУ2", Истина, "СубконтоЗатратНУ2", Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоЗатратНУ3", "ЗаголовокСубконтоЗатратНУ3", Истина, "СубконтоЗатратНУ3", Истина, Истина);
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетУчетаЗатратНУ, Форма, Объект, МассивПолей);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура АктуализироватьСубконтоЗатрат(Форма, Объект, ИмяРеквизитаСчет)
	Перем МассивПолей;
	
	Если ИмяРеквизитаСчет = "СчетУчетаЗатрат" Тогда
		Если Форма.ЗаголовокСубконтоЗатрат1 = "" Тогда
			Объект.СубконтоЗатрат1 = "";
		КонецЕсли;	
		Если Форма.ЗаголовокСубконтоЗатрат2 = "" Тогда
			Объект.СубконтоЗатрат2 = "";
		КонецЕсли;	
		Если Форма.ЗаголовокСубконтоЗатрат3 = "" Тогда
			Объект.СубконтоЗатрат3 = "";
		КонецЕсли;	
	ИначеЕсли ИмяРеквизитаСчет = "СчетУчетаЗатратНУ" Тогда
		Если Форма.ЗаголовокСубконтоЗатратНУ1 = "" Тогда
			Объект.СубконтоЗатратНУ1 = "";
		КонецЕсли;	
		Если Форма.ЗаголовокСубконтоЗатратНУ2 = "" Тогда
			Объект.СубконтоЗатратНУ2 = "";
		КонецЕсли;	
		Если Форма.ЗаголовокСубконтоЗатратНУ3 = "" Тогда
			Объект.СубконтоЗатратНУ3 = "";
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьПредставлениеДоговора(Договор)

	Возврат ""+Договор.ВидОбязательства+" от "+Формат(Договор.ДатаДоговора,"ДФ=dd.MM.yyyy")+" № "+Договор.НомерДоговора;		

КонецФункции

#КонецОбласти

#Область ФискальныеОперации

&НаСервере
Процедура УстановитьДанныеДляПечатиЧековККМ(ИзмененаОрганизация = Ложь)
	
	СписокВидовНалогообложения = ПодключаемоеОборудованиеБГУ.ПереченьСистемНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	Элементы.СистемаНалогообложенияЧекаККМ.СписокВыбора.ЗагрузитьЗначения(СписокВидовНалогообложения);
	Элементы.СистемаНалогообложенияЧекаККМ.РежимВыбораИзСписка = Истина;
	
	РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	НастройкиОборудования = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьНастройкиОборудования(РабочееМесто, Объект.Организация);
	
	Если ЗначениеЗаполнено(Объект.ФискальныйРегистратор) Тогда
		СистемаНалогообложенияЧекаККМ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ФискальныйРегистратор, "СистемаНалогообложенияЧекаККМ");
		Объект.СистемаНалогообложенияЧекаККМ = СистемаНалогообложенияЧекаККМ;
	Иначе	
		Объект.ФискальныйРегистратор = НастройкиОборудования.ФискальныйРегистратор;
		СистемаНалогообложенияЧекаККМ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкиОборудования.ФискальныйРегистратор, "СистемаНалогообложенияЧекаККМ");
		Объект.СистемаНалогообложенияЧекаККМ = СистемаНалогообложенияЧекаККМ;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.СистемаНалогообложенияЧекаККМ) ИЛИ ИзмененаОрганизация Тогда
		Объект.СистемаНалогообложенияЧекаККМ = ПодключаемоеОборудованиеБГУ.ВидСистемыНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ПараметрыДоговораПлатежногоАгента) Тогда
		Объект.ПараметрыДоговораПлатежногоАгента = НастройкиОборудования.ПараметрыДоговораПлатежногоАгента;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ФискальныйРегистратор) Тогда
		Если Объект.ФискальныйРегистратор.ИспользоватьБезПодключенияОборудования Тогда
			ИспользоватьПодключаемоеОборудование = Ложь;
		Иначе
			ИспользоватьПодключаемоеОборудование = Истина;
		КонецЕсли;
		
		ПризнакСпособаРасчетаПоУмолчанию = Объект.ФискальныйРегистратор.ПризнакСпособаРасчетаДляДокументаОснованияЧекаККМ;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипРасчета) Тогда
		
		Если Объект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой Тогда
			Объект.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;	
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ВозвратОплатыПлатежнойКартой Тогда
			Объект.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;	
		Иначе
			Объект.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПустаяСсылка();	
		КонецЕсли;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ПризнакСпособаРасчетаДляДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ПризнакСпособаРасчета");
		Если ЗначениеЗаполнено(ПризнакСпособаРасчетаДляДоговора) Тогда
			ПризнакСпособаРасчетаПоУмолчанию = ПризнакСпособаРасчетаДляДоговора;
		Иначе
			ПризнакСпособаРасчетаПоУмолчанию = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ФискальныйРегистратор, "ПризнакСпособаРасчетаДляДокументаОснованияЧекаККМ");
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОповещениеОткрытиеФормыВводаEmail(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		
		Если ЗначениеЗаполнено(РезультатОткрытияФормы.Email) Тогда
			АдресЭлектроннойПочты = РезультатОткрытияФормы.Email;
			АбонентскийНомерТелефона = "";
			ТелефонСтрокой = "";
			ДанныеSMSИлиEmail = АдресЭлектроннойПочты;
			ОтказПокупателяОтСохраненияДанных = РезультатОткрытияФормы.ОтказКлиентаОтСохраненияEmail;
			
			ЗаписатьДополнительныеДанныеЧековККМ();
		Иначе
			АдресЭлектроннойПочты = "";
			АбонентскийНомерТелефона = "";
			ТелефонSMS = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытиеФормыВводаТелефона(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		
		Если ЗначениеЗаполнено(РезультатОткрытияФормы.ВведенноеЧисло) Тогда
			ТелефонSMS = 0;
			ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(РезультатОткрытияФормы.ВведенноеЧисло, ТелефонSMS, ТелефонСтрокой);
			АбонентскийНомерТелефона = "7" + Формат(РезультатОткрытияФормы.ВведенноеЧисло, "ЧЦ=10; ЧДЦ=; ЧГ=0");
			АдресЭлектроннойПочты = "";
			ДанныеSMSИлиEmail = ТелефонСтрокой;
			ОтказПокупателяОтСохраненияДанных = РезультатОткрытияФормы.ОтказКлиентаОтСохраненияТелефона;
			
			ЗаписатьДополнительныеДанныеЧековККМ();
		Иначе
			АдресЭлектроннойПочты = "";
			АбонентскийНомерТелефона = "";
			ТелефонСтрокой = "";
			ТелефонSMS = 0;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФормуSMSИEmail()
	
	Если ЗначениеЗаполнено(ДанныеSMSИлиEmail) Тогда
		Если ОтказПокупателяОтСохраненияДанных Тогда
			Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.НеСохранять16;
		Иначе
			Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.Сохранить16;
		КонецЕсли;
	Иначе
		Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.Пустая;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекВыполнить(ОповещениеПриЗавершении)
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	
	Если НомерКассовогоЧека <> 0 Тогда
		ЗаключительныйЧекИсправительный = ЗаключительныйЧекИсправительный();
		
		Если НЕ ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
			ТекстСообщения = НСтр("ru = 'Чек уже пробит на фискальном регистраторе!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПодключаемоеОборудованиеБГУКлиент.ЗаполнитьНомерДокументаКассыККМ(Объект.ФискальныйРегистратор); 
	НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
	ПорядковыйНомерПродажи = НомерДокументаКассыККМ[Объект.ФискальныйРегистратор];
	
	ПараметрыКассыККМ         = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.ФискальныйРегистратор);
	ИдентификаторУстройстваФР = ПараметрыКассыККМ.ИдентификаторУстройства;
	
	ИспользоватьКассуККМБезПодключенияОборудования = ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	
	Если ИспользоватьКассуККМБезПодключенияОборудования Тогда
		
		ИспользоватьБезПримененияККТ = ПараметрыКассыККМ.ИспользоватьБезПримененияККТ;
		Если ИспользоватьБезПримененияККТ Тогда
			ЗаписатьФискальныеДанныеДляРасчетногоДокумента(ПорядковыйНомерПродажи);
			
			НомерДокументаКассыККМ[Объект.ФискальныйРегистратор] = ПорядковыйНомерПродажи +	1;
				
			Подключаемый_ВыполнитьКоманду(ЭтотОбъект.Команды.Найти("ПодменюПечатьОбычное__РасчетныйДокументБезККТ"));
			
			ЭтотОбъект.Доступность = Истина;
			НомерКассовогоЧека = НомерЧекаДляДокумента();
			ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
			УстановитьВидимостьЭлементовФормы();
		Иначе
			ТекстСообщения = НСтр("ru = 'Для включения возможности печати расчетных документов следует включить 
			|флажок ""Использовать для печати расчетных документов без применения ККТ"" 
			|у кассы, которая указана в реквизите ""Касса ККМ"".'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
		КонецЕсли;	
		
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторУстройстваФР <> Неопределено Тогда
		
		ПроверитьКодыМаркировки(ИдентификаторУстройстваФР);
		
		ЭтотОбъект.Доступность = Ложь;

		// Готовим данные
		НомерЧека = ПорядковыйНомерПродажи;
		ОбщиеПараметры    = ПодготовитьДанныеДляПробитияЧека(НомерЧека);
		
		Контекст = Новый Структура();
		Контекст.Вставить("ОповещениеПриЗавершении", ОповещениеПриЗавершении);
		
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекВыполнитьЗавершение", ЭтотОбъект, Контекст);
		
		ДополнительныеПараметры = МенеджерОборудованияКлиентСервер.ДополнительныеПараметрыОперации(Истина);
   		ДополнительныеПараметры.ОповещениеПослеОткрытииЧека = Новый ОписаниеОповещения("ПечатьЧека_ПослеОткрытияЧека", ЭтотОбъект, Контекст);
    	ДополнительныеПараметры.ОповещениеПриОшибкеПечатиЧека = Новый ОписаниеОповещения("ПечатьЧека_ПослеОшибкиПечатиЧека", ЭтотОбъект, Контекст);
				
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(Оповещение, 
										УникальныйИдентификатор, 
										ИдентификаторУстройстваФР,
										ОбщиеПараметры, 
										ДополнительныеПараметры);
			
	Иначе
		ТекстСообщения = НСтр("ru = 'Устройство для печати чеков не выбрано.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЧека_ПослеОткрытияЧека(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	ШапкаЧека = ПараметрыВыполнения.ВходныеПараметры;
	
	Если ПараметрыВыполнения.НомерСмены <> 0 Тогда
		ШапкаЧека.НомерСменыККТ = ПараметрыВыполнения.НомерСмены;
	КонецЕсли;
	
	Если ПараметрыВыполнения.НомерЧека <> 0 Тогда
		ШапкаЧека.НомерЧекаККТ = ПараметрыВыполнения.НомерЧека;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ПараметрыВыполнения.ОповещениеПродолжения, ПараметрыВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЧека_ПослеОшибкиПечатиЧека(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	
	ШапкаЧека = ПараметрыВыполнения.ВходныеПараметры;
	ШапкаЧека.НомерЧекаККТ = ШапкаЧека.НомерЧекаККТ + 1000000;
	
	Если ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств") Тогда
		ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств");
	Иначе
		ШапкаЧека.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств");
	КонецЕсли;
	
КонецПроцедуры

// Процедура вызывается при нажатии кнопки "НапечататьЧек" командной панели.
//
&НаКлиенте
Процедура ПробитьЧекНаКлиенте()
	
	Результат = Ложь;
	ЕстьОшибки = Ложь;
	
	ОчиститьСообщения();
	
	ЕстьОшибки = НЕ ПодключаемоеОборудованиеБГУКлиент.ПроверитьВозможностьПечатиЧека(ЭтотОбъект);
	
	Если НЕ ВсеРеквизитыДляЧекаЗаполнены() Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЕстьОшибки И ПроверитьЗаполнение() Тогда
		ПробитьЧекСПроверкойСтавокНДС();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекНаКлиентеЗавершение(ЧекПробит, Параметры) Экспорт
	
	ЭтотОбъект.Доступность = Истина;
	
	Если ЧекПробит Тогда
		ТолькоПросмотр = Истина;
		УстановитьДоступностьКнопокПроведенияКлиент();
	КонецЕсли;
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементов(ЭтотОбъект, НомерКассовогоЧека);
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекВыполнитьЗавершение(РезультатВыполнения, Параметры) Экспорт
	ПодключаемоеОборудованиеБГУКлиент.ЗаполнитьНомерДокументаКассыККМ(Объект.ФискальныйРегистратор); 
	НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
	ПорядковыйНомерПродажи = НомерДокументаКассыККМ[Объект.ФискальныйРегистратор];
	
	ЭтотОбъект.Доступность = Истина;
	
	Если НЕ РезультатВыполнения.Результат Тогда
		
		ТекстСообщения = НСтр("ru = 'При печати чека произошла ошибка.
		                            |Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(Параметры.ОповещениеПриЗавершении, Ложь);
	КонецЕсли;
	
	НомерКассовогоЧека  = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементов(ЭтотОбъект, НомерКассовогоЧека);
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеДляПробитияЧека(НомерЧека, ОтменаОплаты = Ложь)
	
	ОбщиеПараметры  = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(Объект, Объект.Ссылка, НомерЧека, , , ОтменаОплаты);
	
	Возврат ОбщиеПараметры;
КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьКнопокПроведенияКлиент()
	
	НомерКассовогоЧека  = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементов(ЭтотОбъект, НомерКассовогоЧека);
	
КонецПроцедуры

&НаСервере
Функция ЕстьЧекНепримененияККТ()
	Результат = Ложь;
	
	ЧекНепримененияККТ = ПодключаемоеОборудованиеБГУ.ИсправительныйЧекККМОперацииНепримененияККТ(Объект.Ссылка);
	Если ЗначениеЗаполнено(ЧекНепримененияККТ) Тогда
		ТекстСообщения = НСтр("ru = 'Кассовый чек не может быть напечатан. Для документа %1 
		|введен документ ""Исправительный чек ККМ"" с видом операции ""Неприменение ККТ""!
		|Документ %2 можно открыть через ""Связанные документы"" меню навигации.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Объект.Ссылка, ЧекНепримененияККТ);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
		
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ВсеРеквизитыДляЧекаЗаполнены(ПросмотрЧека = Ложь)
	Результат = Истина;
	
	Если НЕ ПросмотрЧека Тогда
		ЕстьЧекНепримененияККТ = ЕстьЧекНепримененияККТ();
		Если ЕстьЧекНепримененияККТ Тогда
			Возврат Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ФискальныйРегистратор) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Касса ККМ""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ФискальныйРегистратор");
		
		Возврат Ложь;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Ответственный""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
		
		Результат = Ложь;
	Иначе
		Если НЕ ЗначениеЗаполнено(Объект.Ответственный.ФизическоеЛицо) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Физическое лицо"" у реквизита ""Ответственный""!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
			
			Результат = Ложь;
		Иначе
			КассирККМ = Объект.Ответственный.ФизическоеЛицо;
			Если НЕ Объект.ФискальныйРегистратор.НеПроверятьИННКассира Тогда
				Если СтрДлина(КассирККМ.ИНН)<12 Тогда
					ТекстСообщения = НСтр("ru = 'Не заполнен ИНН у реквизита ""Физическое лицо"" реквизита ""Ответственный""!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Ответственный");
					
					Результат = Ложь;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ДокументыЧекаККМ.Количество() = 0 Тогда
		Если НЕ ЗначениеЗаполнено(Объект.СтавкаНДС) Тогда
			ТекстСообщения = НСтр("ru = 'Не указана ставка НДС на закладке ""Реквизиты документа"".'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.СистемаНалогообложенияЧекаККМ) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Система налогообложения""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.СистемаНалогообложенияЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипРасчета) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Тип расчета""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ТипРасчета");
		
		Результат = Ложь;	
	КонецЕсли;
	
	СтавкаДокумента = ПодключаемоеОборудованиеБГУ.ЕдиныеСтавкиВДокументеОснованииЧекаККМ(Объект.Ссылка);
	СуммаВсего = СтавкаДокумента.Всего;
	Если СуммаВсего > Объект.СуммаДокумента Тогда
		Если НЕ Объект.ЭтоПостоплата Тогда
			ТекстСообщения = НСтр("ru = 'Сумма документа меньше итоговой суммы списка номенклатуры документов-оснований чека ККМ! 
			|Если часть суммы будет оплачена позднее или нужно зачесть предоплату, то следует включить флажок ""Постоплата и (или) зачет предоплаты"" на закладке ""Чек ККМ"".
			|При необходимости сумма предоплаты вводится в колонке ""Сумма предоплаты"" списка номенклатуры чека на закладке ""Чек ККМ"".'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ЭтоПостоплата");
				
			Результат = Ложь;
		Иначе
			Если НесоответствиеСуммыЧека(СуммаВсего) Тогда
				ТекстСообщения = НСтр("ru = 'Сумма оплаты с учетом зачета аванса превышает сумму списка номенклатуры!
				|Следует уточнить сумму предоплаты в списке номенклатуры чека на закладке ""Чек ККМ"" или сформировать отдельный чек на аванс на сумму разницы.'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.СуммаДокумента");
						
				Результат = Ложь;
			КонецЕсли;	
		КонецЕсли;
	ИначеЕсли СуммаВсего < Объект.СуммаДокумента Тогда
		ТекстСообщения = НСтр("ru = 'Сумма документа больше итоговой суммы списка номенклатуры документов-оснований чека ККМ! 
		|Если часть суммы является авансом необходимо сумму документа указать равной сумме номенклатуры и ввести новый документ ""Эквайринговая операция"" на сумму аванса.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.СуммаДокумента");
				
		Результат = Ложь;
	КонецЕсли;
	
	ТаблицаСпособовРасчета = Объект.ДокументыЧекаККМ.Выгрузить();
	ТаблицаСпособовРасчета.Свернуть("ПризнакСпособаРасчета");
	Если ТаблицаСпособовРасчета.Количество() > 1 Тогда
		ТекстСообщения = НСтр("ru = 'В списке номенклатуры чека ККМ должны быть документы-основания только с одним признаком способа расчета!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыЧекаККМ");
				
		Результат = Ложь;
	КонецЕсли;
	
	Если НесоответствиеПризнакаСпособаРасчета(СуммаВсего) Тогда
		Результат = Ложь;
	КонецЕсли;
	
	ЕстьВозвратыНоменклатурыПрейскуранта = Ложь;
	Для каждого ТекСтрока Из Объект.ДокументыЧекаККМ Цикл
		Если ТипЗнч(ТекСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.ЗаявлениеНаВозвратПоЧекуККМ") Тогда
			ЕстьВозвратыНоменклатурыПрейскуранта = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	Если ЕстьВозвратыНоменклатурыПрейскуранта Тогда
		ВозвратНоменклатурыПрейскуранта = Объект.ДокументыЧекаККМ[0].ДокументОснованиеЧекаККМ;
		
		Если Объект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ВозвратОплатыПлатежнойКартой Тогда
			Если Объект.ДокументыЧекаККМ.Количество() > 1 Тогда 
				ТекстСообщения = НСтр("ru = 'Допускается только один документ-основание ""Заявление на возврат по чеку ККМ""!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				
				Результат = Ложь;
			ИначеЕсли Объект.ДокументыЧекаККМ.Количество() = 1 Тогда
				Если НЕ(Объект.СистемаНалогообложенияЧекаККМ = ВозвратНоменклатурыПрейскуранта.СистемаНалогообложенияЧекаККМ) Тогда
					ТекстСообщения = НСтр("ru = 'Система налогообложения в документе-основании ""Перечень номенклатуры прейскуранта для возврата"" не соответствует системе налогообложения на закладке ""Чек ККМ""!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					
					Результат = Ложь;
				КонецЕсли;
				Если НЕ(Объект.ПараметрыДоговораПлатежногоАгента = ВозвратНоменклатурыПрейскуранта.ПараметрыДоговораПлатежногоАгента) Тогда
					ТекстСообщения = НСтр("ru = 'Параметры договора платежного агента в документе-основании ""Перечень номенклатуры прейскуранта для возврата"" не соответствуют параметрам на закладке ""Чек ККМ""!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					
					Результат = Ложь;
				КонецЕсли;
				
				ЧекПродажи = ВозвратНоменклатурыПрейскуранта.ДокументОснование;
				Если ЗначениеЗаполнено(ЧекПродажи) Тогда
					Если ЧекПродажи.Оплата.Количество()>0 Тогда
						Если ЧекПродажи.ФормаОплаты = 1 Или ЧекПродажи.ФормаОплаты = 2 Тогда
							Если НЕ(ЧекПродажи.Оплата[0].ЭквайринговыйТерминал = Объект.ЭквайринговыйТерминал) Тогда 
								ТекстСообщения = НСтр("ru = 'Оплата была выполнена на ином эквайринговом терминале (%1)! Следует выполнять возврат на том же эквайринговом терминале  
								|или наличными с использованием документа ""Расходный кассовый ордер"".'");
								ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СокрЛП(ЧекПродажи.Оплата[0].ЭквайринговыйТерминал));
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
								
								Результат = Ложь;
							КонецЕсли;
						Иначе
							ТекстСообщения = НСтр("ru = 'Оплата была выполнена наличными! Следует выполнять возврат наличными
							|с использованием документа ""Расходный кассовый ордер"".'");
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
								
							Результат = Ложь;
						КонецЕсли;	
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Иначе
			ТекстСообщения = НСтр("ru = 'Указывать ""Перечень номенклатуры прейскуранта для возврата"" в качестве документа-основания чека допускается только для вида операции ""Возврат оплаты платежной картой""!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					
			Результат = Ложь;
		КонецЕсли;
		
	КонецЕсли;	
	
	ТаблицаНоменклатуры = ПодключаемоеОборудованиеБГУ.ТаблицаНоменклатурыЧекаККМ(Объект.Ссылка);
	ЕстьПустыеНаименованияТоваровУслуг = Ложь;
	ЕстьПустыеПредметыРасчетаТоваровУслуг = Ложь;
	НомераСтрокПустыхНаименований = "";
	НомераСтрокПустыхПредметовРасчета = "";
	Для каждого ТекСтрока Из ТаблицаНоменклатуры Цикл
		Если Не ЗначениеЗаполнено(ТекСтрока.Наименование) Тогда
			ЕстьПустыеНаименованияТоваровУслуг = Истина;
			НомераСтрокПустыхНаименований = НомераСтрокПустыхНаименований + СокрЛП(ТекСтрока.НомерСтроки)+", ";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ТекСтрока.ПризнакПредметаРасчета) Тогда
			ЕстьПустыеПредметыРасчетаТоваровУслуг = Истина;
			НомераСтрокПустыхПредметовРасчета = НомераСтрокПустыхПредметовРасчета + СокрЛП(ТекСтрока.НомерСтроки)+", ";
		КонецЕсли;
	КонецЦикла;	
	
	Если ЕстьПустыеНаименованияТоваровУслуг Тогда
		НомераСтрокПустыхНаименований = Сред(НомераСтрокПустыхНаименований, 0, СтрДлина(НомераСтрокПустыхНаименований)-2);
		Если НомераСтрокПустыхНаименований = "1" Тогда
			ТекстСообщения = НСтр("ru = 'В строке %1 полного списка номенклатуры кассового чека пустое наименование номенклатуры! 
			|Следует в документе-основании заполнить номенклатуру и повторить попытку!'");
		Иначе
			ТекстСообщения = НСтр("ru = 'В строках %1 полного списка номенклатуры кассового чека пустые наименования номенклатуры!
			|Следует в документах-основаниях для этих строк заполнить номенклатуру и повторить попытку!'");
		КонецЕсли;	
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомераСтрокПустыхНаименований);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
	
	Если ЕстьПустыеПредметыРасчетаТоваровУслуг Тогда
		НомераСтрокПустыхПредметовРасчета = Сред(НомераСтрокПустыхПредметовРасчета, 0, СтрДлина(НомераСтрокПустыхПредметовРасчета)-2);
		Если НомераСтрокПустыхПредметовРасчета = "1" Тогда
			ТекстСообщения = НСтр("ru = 'В строке %1 полного списка номенклатуры кассового чека не заполнен признак предмета расчета! 
			|Следует в документе-основании заполнить у номенклатуры реквизит ""Признак предмета расчета"" и повторить попытку!'");
		Иначе
			ТекстСообщения = НСтр("ru = 'В строках %1 полного списка номенклатуры кассового чека не заполнен признак предмета расчета!
			|Следует в документах-основаниях для этих строк заполнить у номенклатуры реквизит ""Признак предмета расчета"" и повторить попытку!'");
		КонецЕсли;	
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомераСтрокПустыхПредметовРасчета);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ДокументыЧекаККМ");
		
		Результат = Ложь;	
	КонецЕсли;
	
	ПолучательЧекаККМ = Объект.Контрагент;
	Если ЗначениеЗаполнено(ПолучательЧекаККМ) Тогда
		ДанныеЮЛиИП = ПодключаемоеОборудованиеБГУ.ЧекККМДляЮЛилиИП(ПолучательЧекаККМ, Объект.Дата);
		Если ДанныеЮЛиИП.Заполнить Тогда
			Если НЕ ЗначениеЗаполнено(ДанныеЮЛиИП.Получатель) Тогда
				ТекстСообщения = НСтр("ru = 'Контрагент-получатель чека ККМ - юр.лицо или ИП. У контрагента не указано наименование!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Контрагент");
						
				Результат = Ложь;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ДанныеЮЛиИП.ПолучательИНН) Тогда
				ТекстСообщения = НСтр("ru = 'Контрагент-получатель чека ККМ - юр.лицо или ИП. У контрагента не указан ИНН!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Контрагент");
						
				Результат = Ложь;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
		Если НЕ ПодключаемоеОборудованиеБГУ.НомерТелефонаДляЭлектронногоЧекаКорректен(АбонентскийНомерТелефона) Тогда
			ТекстСообщения = НСтр("ru = 'Номер телефона для электронного чека указан некорректно!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.АбонентскийНомерТелефона");
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
		Если НЕ ПодключаемоеОборудованиеБГУ.АдресЭлектроннойПочтаДляЭлектронногоЧекаКорректен(АдресЭлектроннойПочты) Тогда
			ТекстСообщения = НСтр("ru = 'Адрес электронной почты для электронного чека указан некорректно!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.АдресЭлектроннойПочты");
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции	

&НаКлиенте
Процедура ПредставитьТелефонИEmailКлиент()
	
	Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
		Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
			Попытка
				СохраненныйТелефон = Число(АбонентскийНомерТелефона);
			Исключение
				ТекстСообщения = НСтр("ru = 'Номер телефона для SMS указан некорректно. Следует изменить значение реквизита и повторить попытку.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,"АбонентскийНомерТелефона");
				
				Возврат;
			КонецПопытки
		Иначе
			СохраненныйТелефон = 0;
		КонецЕсли;
		ТелефонSMS = 0;
		ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(СохраненныйТелефон, ТелефонSMS, ТелефонСтрокой);
		ДанныеSMSИлиEmail = ТелефонСтрокой;
	ИначеЕсли ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
		ДанныеSMSИлиEmail = АдресЭлектроннойПочты;
	Иначе
		ДанныеSMSИлиEmail = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаДанныеЧекаККМ(Форма, НомерЧекаККМ = 0)
	ТекстЗаголовкаДанныхЧека = "";
	
	Объект = Форма.Объект;
	
	ИспользуетсяККТСПередачейДанных = Форма.ИспользуетсяККТСПередачейДанных;
	
	НомерЧекаККМ = ?(НомерЧекаККМ<>0, НомерЧекаККМ, Объект.НомерЧекаККМ);
	
	Если ИспользуетсяККТСПередачейДанных Тогда
		ТекстНомераЧека = НСтр("ru='ФД № '")+Формат(НомерЧекаККМ,"ЧГ=");
		Если ЗначениеЗаполнено(Объект.НомерЧекаККМОтмены) Тогда
			ТекстНомераЧека = НСтр("ru='оплата отменена: ФД № '")+Формат(Объект.НомерЧекаККМОтмены,"ЧГ=");
		КонецЕсли;	
	Иначе	
		ТекстНомераЧека = НСтр("ru='№ '")+Формат(НомерЧекаККМ,"ЧГ=");
		Если ЗначениеЗаполнено(Объект.НомерЧекаККМОтмены) Тогда
			ТекстНомераЧека = НСтр("ru='оплата отменена: чек № '")+Формат(Объект.НомерЧекаККМОтмены,"ЧГ=");
		КонецЕсли;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Форма.ЗаключительныйЧекИсправительный) Тогда
		ТекстНомераЧека = ТекстНомераЧека + " отменен";
	КонецЕсли;	
		
	Если НомерЧекаККМ<>0 Тогда
		ТекстЗаголовкаДанныхЧека = ТекстНомераЧека;
	КонецЕсли;	
	
	Форма.ДанныеЗаголовкаСтраницыЧекаККМ = ТекстЗаголовкаДанныхЧека;

КонецПроцедуры

&НаКлиенте
Функция ПроверитьВозможностьЗаполненияСуммы(Форма) Экспорт
	
	Результат = Истина;
	
	Если Форма.Модифицированность Тогда
		
		ПоказатьПредупреждение( , НСтр("ru = 'Операция возможна только после записи документа'"));
		Результат = Ложь;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ПроверитьВозможностьПечатиЧека()

&НаСервере
Процедура КомандаЗаполнитьСуммуДокументаНаСервере()
	
	СтавкаДокумента = ПодключаемоеОборудованиеБГУ.ЕдиныеСтавкиВДокументеОснованииЧекаККМ(Объект.Ссылка);
	Объект.СуммаДокумента = СтавкаДокумента.Всего;
	
	Если СтавкаДокумента.ЕдинаяДляТЧ Тогда
		Объект.СтавкаНДС = СтавкаДокумента.Значение;
		Объект.СуммаНДС = СтавкаДокумента.СуммаНДС;
	Иначе
		Объект.СтавкаНДС = Перечисления.СтавкиНДС.ПустаяСсылка();
		Объект.СуммаНДС = СтавкаДокумента.СуммаНДС;
	КонецЕсли;	
	
	Для Каждого ТекСтрока Из Объект.ДокументыЧекаККМ Цикл              		
		СуммаОплаты = 0;
		Если ТипЗнч(ТекСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.ЗаявлениеНаВозвратПоЧекуККМ") Тогда
			Если ТекСтрока.ДокументОснованиеЧекаККМ.ЕстьОплатаЭС Тогда 
				ТипОплаты = ТекСтрока.ДокументОснованиеЧекаККМ.ТипОплаты; 
				Для Каждого СтрокаТовар Из ТекСтрока.ДокументОснованиеЧекаККМ.ТоварыРаботыУслуги Цикл 
					Если ТипОплаты = Перечисления.ТипыОплатЧекаККМ.Наличные Тогда 
						СуммаОплаты = СуммаОплаты + СтрокаТовар.СуммаЭС;
					Иначе 
						СуммаОплаты = СуммаОплаты + СтрокаТовар.Всего;
					КонецЕсли;	
				КонецЦикла;
				Объект.СуммаДокумента 	= СуммаОплаты;
				СтавкаНДС 				= УчетНДСКлиентСервер.ЗначениеСтавкиНДС(Объект.СтавкаНДС);
				Объект.СуммаНДС 		= СуммаОплаты * СтавкаНДС / (100 + СтавкаНДС);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПервичныйДокументПоНастройкам()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ПараметрыДоговораЭквайрингаЗаполнениеПервичныхДокументов.ВидПервичногоДокумента,
	               |	ПараметрыДоговораЭквайрингаЗаполнениеПервичныхДокументов.НомерПервичногоДокумента,
	               |	ПараметрыДоговораЭквайрингаЗаполнениеПервичныхДокументов.ДатаПервичногоДокумента
	               |ИЗ
	               |	Справочник.ПараметрыДоговораЭквайринга.ЗаполнениеПервичныхДокументов КАК ПараметрыДоговораЭквайрингаЗаполнениеПервичныхДокументов
	               |ГДЕ
	               |	ПараметрыДоговораЭквайрингаЗаполнениеПервичныхДокументов.Ссылка = &ПараметрыДоговораЭквайринга
	               |	И ПараметрыДоговораЭквайрингаЗаполнениеПервичныхДокументов.ВидОперации = &ВидОперации";
				   
	Запрос.УстановитьПараметр("ПараметрыДоговораЭквайринга", Объект.ПараметрыДоговораЭквайринга);
	Запрос.УстановитьПараметр("ВидОперации", Объект.ВидОперации);
	Результат = Запрос.Выполнить().Выгрузить();
	Для Каждого ТекСтрока Из Результат Цикл
		Объект.ВидПервичногоДокумента = ТекСтрока.ВидПервичногоДокумента;
		
		Если ТекСтрока.НомерПервичногоДокумента = "Номер чека эквайрингового терминала" Тогда
			Объект.НомерПервичногоДокумента = Объект.НомерЧекаЭТ;
		ИначеЕсли ТекСтрока.НомерПервичногоДокумента = "Номер чека эквайрингового терминала операции-основания" Тогда
			Объект.НомерПервичногоДокумента = Объект.НомерЧекаЭТВозврата;
		КонецЕсли;	
		
		Если ТекСтрока.ДатаПервичногоДокумента = "Дата документа" Тогда
			Объект.ДатаПервичногоДокумента = Объект.Дата;
		ИначеЕсли ТекСтрока.ДатаПервичногоДокумента = "Дата документа-основания" Тогда
			Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
				Объект.ДатаПервичногоДокумента = Объект.ДокументОснование.Дата;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура КассаККМПриИзмененииНаСервере()
	Если ЗначениеЗаполнено(Объект.ФискальныйРегистратор) Тогда
		
		СтруктураРеквизитов = Новый Структура;
		СтруктураРеквизитов.Вставить("СистемаНалогообложенияЧекаККМ", "");
		СтруктураРеквизитов.Вставить("ПризнакСпособаРасчетаДляДокументаОснованияЧекаККМ", "");
		
		РеквизитыККТ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ФискальныйРегистратор, СтруктураРеквизитов);
		
		Объект.СистемаНалогообложенияЧекаККМ = РеквизитыККТ.СистемаНалогообложенияЧекаККМ;
		ПризнакСпособаРасчетаПоУмолчанию = РеквизитыККТ.ПризнакСпособаРасчетаДляДокументаОснованияЧекаККМ;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ПризнакСпособаРасчетаДляДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ПризнакСпособаРасчета");
		Если ЗначениеЗаполнено(ПризнакСпособаРасчетаДляДоговора) Тогда
			ПризнакСпособаРасчетаПоУмолчанию = ПризнакСпособаРасчетаДляДоговора;
		КонецЕсли;	
	КонецЕсли;	
	
	ИспользуетсяККТСПередачейДанных = ПодключаемоеОборудованиеБГУ.ИспользуетсяККТСПередачейДанных(Объект.ФискальныйРегистратор);
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	УстановитьВидимостьЭлементовФормы();
КонецПроцедуры	

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтотОбъект, "СканерШтрихкода");
	// Конец ПодключаемоеОборудование
	
	ПредставитьТелефонИEmailКлиент();
	ОбновитьФормуSMSИEmail();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если ЕстьДокументОплаты Тогда 
		ТекстСообщения = НСтр("ru='Для документа " + Объект.ДокументОснование + " уже введен документ оплаты!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НадписьДокументОснованиеРозницаНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭквайринговаяОперация") Тогда
		ВидДокумента = "ЭквайринговаяОперация";
	ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ОтчетПоКассовойСмене") Тогда
		ВидДокумента = "ОтчетПоКассовойСмене";
	Иначе
		Возврат;
	Конецесли;	
	
	ПараметрыФормыДокументаОснования = Новый Структура("Ключ", Объект.ДокументОснование);
		
	ОткрытьФорму("Документ."+ВидДокумента+".ФормаОбъекта", ПараметрыФормыДокументаОснования, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьПараметрыДобавленияДокументовОснованийЧекаККМ(ПараметрыПодбора) Экспорт
	ПараметрыПодбора.Вставить("АдресДокументыОснованияВХранилище", "");
КонецПроцедуры

&НаСервере
Процедура ОбработкаДобавленияДокументовОснованийДляЧекаНаСервере(Знач ВыбранноеЗначение)
	
	МассивДокументовОснований = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресДокументыОснованияВХранилище);
	Для каждого ТекСтрока Из МассивДокументовОснований Цикл
		Если НЕ ЕстьВСпискеДокументовЧекаККМ(ТекСтрока.ДокументОснованиеЧекаККМ) Тогда
			НоваяСтрока = Объект.ДокументыЧекаККМ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			
			Если ТипЗнч(НоваяСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.СчетНаОплату") Тогда
				НоваяСтрока.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная;
			Иначе
				Если ЗначениеЗаполнено(ПризнакСпособаРасчетаПоУмолчанию) Тогда
					НоваяСтрока.ПризнакСпособаРасчета = ПризнакСпособаРасчетаПоУмолчанию;
				Иначе			
					НоваяСтрока.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
				КонецЕсли;	
			КонецЕсли;	
		Иначе
			ТекстСообщения = НСтр("ru = 'Документ %1 не добавлен, т.к. уже содержится в списке!'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекСтрока.ДокументОснованиеЧекаККМ);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция ЕстьВСпискеДокументовЧекаККМ(ДокСсылка)
	Результат = Истина;
	ПараметрыПоиска = Новый Структура("ДокументОснованиеЧекаККМ", ДокСсылка);
	РезультатПоиска = Объект.ДокументыЧекаККМ.НайтиСтроки(ПараметрыПоиска);
	Если РезультатПоиска.Количество() = 0 Тогда
		Результат = Ложь;
	КонецЕсли;
		
	Возврат Результат;	
КонецФункции	

&НаСервере
Процедура ЗаполнитьДанныеПоПеречнюНоменклатурыПрейскуранта(ДокументВозвратаРозницы) 
	ЗаполняемыеДанные = "СистемаНалогообложенияЧекаККМ, ПараметрыДоговораПлатежногоАгента";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументВозвратаРозницы, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(Объект, ДанныеДокументаОснования);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеВозвратаОплатыНаСервере()
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭквайринговаяОперация") Тогда
		Объект.НомерЧекаЭТВозврата = Объект.ДокументОснование.НомерЧекаЭТ;
		Объект.СсылочныйНомерВозврата = Объект.ДокументОснование.СсылочныйНомер;
	Иначе
		//перечень номенклатуры прейскуранта
		ЕстьВозвратыНоменклатурыПрейскуранта = Ложь;
		Для каждого ТекСтрока Из Объект.ДокументыЧекаККМ Цикл
			Если ТипЗнч(ТекСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.ЗаявлениеНаВозвратПоЧекуККМ") Тогда
				ЕстьВозвратыНоменклатурыПрейскуранта = Истина;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		Если ЕстьВозвратыНоменклатурыПрейскуранта Тогда
			Если Объект.ДокументыЧекаККМ.Количество() > 1 Тогда 
				ТекстСообщения = НСтр("ru = 'Допускается только один документ-основание ""Заявление на возврат по чеку ККМ""!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ИначеЕсли Объект.ДокументыЧекаККМ.Количество() = 1 Тогда
				ВозвратНоменклатурыПрейскуранта = Объект.ДокументыЧекаККМ[0].ДокументОснованиеЧекаККМ;
				Если ЗначениеЗаполнено(ВозвратНоменклатурыПрейскуранта) Тогда
					//заполнение
					ЧекПродажи = ВозвратНоменклатурыПрейскуранта.ДокументОснование;
					Если ЗначениеЗаполнено(ЧекПродажи) Тогда
						Если ЧекПродажи.Оплата.Количество()>0 Тогда
							Если (ЧекПродажи.ФормаОплаты = 1 Или ЧекПродажи.ФормаОплаты = 2) Или (ВозвратНоменклатурыПрейскуранта.ЕстьОплатаЭС) Тогда
								Если ЧекПродажи.Оплата.Количество() = 2 Тогда 
									СтрокаОплата = ЧекПродажи.Оплата[1];
								Иначе	                              
									СтрокаОплата = ЧекПродажи.Оплата[0];
								КонецЕсли;	
								
								Если СтрокаОплата.ЭквайринговыйТерминал = Объект.ЭквайринговыйТерминал Тогда 
									Объект.НомерЧекаЭТВозврата = СтрокаОплата.НомерЧекаЭТ;
									Объект.СсылочныйНомерВозврата = СтрокаОплата.СсылочныйНомер;
								Иначе
									ТекстСообщения = НСтр("ru = 'Оплата была выполнена на ином эквайринговом терминале! Следует выполнять возврат на том же эквайринговом терминале  
									|или наличными с использованием документа ""Расходный кассовый ордер"".'");
									ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
								КонецЕсли;
							Иначе
								ТекстСообщения = НСтр("ru = 'Оплата была выполнена наличными! Следует выполнять возврат наличными
								|с использованием документа ""Расходный кассовый ордер"".'");
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
							КонецЕсли;	
						КонецЕсли;
					КонецЕсли;
				Иначе
					ТекстСообщения = НСтр("ru = 'Не заполнен документ-основание ""Перечень номенклатуры прейскуранта для возврата""!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	Конецесли;
	
КонецПроцедуры

&НаСервере
Процедура РасчетЗачетаАвансаПостоплаты()
	
	Если Объект.ДокументыЧекаККМ.Количество() > 0 Тогда
		ТаблицаНоменклатурыЧека = ПодключаемоеОборудованиеБГУ.ТаблицаНоменклатурыЧекаККМДляДокументовОснований(Объект.ДокументыЧекаККМ);
		СуммаВсего = ТаблицаНоменклатурыЧека.Итог("Всего");
		
		СуммаЗачетаАванса = Объект.ДокументыЧекаККМ.Итог("СуммаПредоплаты");
		
		СуммаПостоплаты = СуммаВсего - СуммаЗачетаАванса - Объект.СуммаДокумента;
	Иначе
		СуммаЗачетаАванса = 0;
		СуммаПостоплаты = 0;
	КонецЕсли;
	
	Если СуммаПостоплаты > 0 Тогда
		СуммаПостоплатыСтрокой = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Постоплата: %1 %2'"),
					Формат(СуммаПостоплаты, "ЧЦ=15; ЧДЦ=2"),
					Строка(ВалютаРубли));
	ИначеЕсли СуммаПостоплаты < 0 Тогда
		СуммаПостоплатыСтрокой = НСтр("ru='Сумма оплаты с учетом зачета аванса превышает сумму списка номенклатуры!
		|Следует уточнить сумму предоплаты или сформировать отдельный чек на аванс на сумму разницы.'");
	Иначе
		СуммаПостоплатыСтрокой = "";
	КонецЕсли;
	
	Если СуммаЗачетаАванса > 0 Тогда
		СуммаЗачетаАвансаСтрокой = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Зачет аванса: %1 %2'"),
					Формат(СуммаЗачетаАванса, "ЧЦ=15; ЧДЦ=2"),
					Строка(ВалютаРубли));
	Иначе
		СуммаЗачетаАвансаСтрокой = "";
	КонецЕсли;
	
	Элементы.СуммаЗачетаАванса.Заголовок = СуммаЗачетаАвансаСтрокой;
	Элементы.СуммаПостоплаты.Заголовок = СуммаПостоплатыСтрокой;
	
	Элементы.СуммаПостоплаты.ЦветТекста = ?(СтрДлина(СуммаПостоплатыСтрокой) > 40, ЦветаСтиля["ПоясняющийОшибкуТекст"], ЦветаСтиля["ПоясняющийТекст"]);
КонецПроцедуры

&НаСервере
Процедура ЭтоПостоплатаПриИзмененииНаСервере();
	РасчетЗачетаАвансаПостоплаты();
	УстановитьВидимостьЭлементовФормы();
КонецПроцедуры

&НаСервере
Функция НесоответствиеСуммыЧека(СуммаСпискаНоменклатуры)
	СуммаЗачетаАванса = Объект.ДокументыЧекаККМ.Итог("СуммаПредоплаты");
	СуммаПостоплаты = СуммаСпискаНоменклатуры - СуммаЗачетаАванса - Объект.СуммаДокумента;
	Если СуммаПостоплаты < 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции	

&НаСервере
Функция НесоответствиеПризнакаСпособаРасчета(СуммаСпискаНоменклатуры)
	Результат = Ложь;
	
	Если Объект.ДокументыЧекаККМ.Количество()>0 Тогда
		ПризнакСпособаРасчета = Объект.ДокументыЧекаККМ[0].ПризнакСпособаРасчета;
		
		Если (Объект.СуммаДокумента + Объект.ДокументыЧекаККМ.Итог("СуммаПредоплаты")) < СуммаСпискаНоменклатуры Тогда
			Если ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Сумма документа с признаком способа расчета ""%1"" в списке номенклатуры чека меньше суммы списка номенклатуры чека ККМ!
					|Укажите корректное значение признака способа расчета или суммы документа.'"),
					ПризнакСпособаРасчета);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.СуммаДокумента");
				
				Результат = Истина;
			КонецЕсли;
		КонецЕсли;	
		
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ДействияСКонтактнымиДаннымиДляЧекаККМ()
	
	ЗаписатьДополнительныеДанныеЧековККМ();
	
	Если НЕ ОтказПокупателяОтСохраненияДанных Тогда
		Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
			ПодключаемоеОборудованиеБГУ.ЗаписатьТелефонКонтрагента(Объект.Контрагент, АбонентскийНомерТелефона);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
			ПодключаемоеОборудованиеБГУ.ЗаписатьEmailКонтрагента(Объект.Контрагент, АдресЭлектроннойПочты);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиПредставлениеЧека()
	ЕстьОшибки = Ложь;
	ЧекСформирован = Ложь;
	
	КассаККМЧека = Объект.ФискальныйРегистратор;
	
	ОчиститьСообщения();
	
	Если ЭтаФорма.Модифицированность Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Операция возможна только после сохранения документа'"));
		Возврат;
	КонецЕсли;
	
	Если НЕ ВсеРеквизитыДляЧекаЗаполнены(Истина) Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЕстьОшибки И ПроверитьЗаполнение() Тогда
		ДанныеЧекаДляДокумента = ДанныеЧекаДляДокумента();
		
		НомерКассовогоЧека = ДанныеЧекаДляДокумента.НомерЧекаККМ;		
		
		Если (НомерКассовогоЧека = 0) ИЛИ ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда 
			НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
			НомерДокКассыККМ = ?(НомерДокументаКассыККМ[КассаККМЧека]=Неопределено, 0, НомерДокументаКассыККМ[КассаККМЧека]);
			НомерЧека = НомерДокКассыККМ+1;
		Иначе
			НомерЧека = НомерКассовогоЧека;	
			ЧекСформирован = Истина;
		КонецЕсли;	
		
		ОбщиеПараметры = ПодготовитьДанныеДляПросмотраЧека(НомерЧека);
		
		Если ОбщиеПараметры = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Недостаточно данных для просмотра кассового чека.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			Возврат;
		КонецЕсли;			
		
		Если ЧекСформирован Тогда
			ОбщиеПараметры.ДатаВремя = ДанныеЧекаДляДокумента.ДатаЧекаККМ;	
		КонецЕсли;	
		
		ВерсияФФД = ВерсияФФД(КассаККМЧека);
		
		ТекстЧека = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.СформироватьТекстНефискальногоЧека(ОбщиеПараметры, 34, ВерсияФФД);
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(ТекстЧека);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТекстовыйДокумент", ТекстовыйДокумент);
		ПараметрыФормы.Вставить("ДокументОснование", Объект.Ссылка);
		ПараметрыФормы.Вставить("ИдентификаторЗаписи", ДанныеЧекаДляДокумента.ИдентификаторЗаписи);

		Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		ОткрытьФорму("ОбщаяФорма.ФормаПросмотраЧекаККМ", ПараметрыФормы, , Объект,,,, Режим);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВерсияФФД(КассаККМЧека) Экспорт
	Возврат ПодключаемоеОборудованиеБГУ.ВерсияФФД(КассаККМЧека);	
КонецФункции

&НаКлиенте
Процедура ОтменитьОплату(Команда)
	ОтменитьОплатуПлатежнойКартой();
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьОплатуПлатежнойКартой()
	Если НачалоДня(Объект.ДатаЧекаККМ) = НачалоДня(ТекущаяДата()) Тогда
		ТекстВопроса = НСтр("ru = 'Выполнить операцию отмены оплаты?'");
		
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеВопросПредупреждениеДляОтменыОплатыКартой", ЭтотОбъект, );
		ПоказатьВопрос(ОбработчикОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе	
		ТекстВопроса = НСтр("ru = 'Дата операции оплаты не совпадает с датой отмены оплаты.'") + Символы.ПС;
		ТекстВопроса = ТекстВопроса + НСтр("ru = 'Если после операции оплаты была произведена сверка с банком,'") + Символы.ПС;
		ТекстВопроса = ТекстВопроса + НСтр("ru = 'то отмена оплаты завершится с ошибкой.'") + Символы.ПС;
		ТекстВопроса = ТекстВопроса + НСтр("ru = 'Не выполнять операцию отмены оплаты?'");
		
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеВопросКорректностиОтменыОплатыКартой", ЭтотОбъект, );
		ПоказатьВопрос(ОбработчикОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеВопросПредупреждениеДляОтменыОплатыКартой(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	РезультатВопросаОКорректностиОтменыОплаты = (РезультатВопроса = КодВозвратаДиалога.Да);
	
	Если НЕ РезультатВопросаОКорректностиОтменыОплаты Тогда
		СтрокаСлипЧека = "";
		ТекстОписаниеОшибки = НСтр("ru = 'Операция отмены оплаты не выполнена'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	ВыполнитьОтменуОплатыКартой();
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеВопросКорректностиОтменыОплатыКартой(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	РезультатВопросаОКорректностиОтменыОплаты = (РезультатВопроса = КодВозвратаДиалога.Нет);
	
	Если НЕ РезультатВопросаОКорректностиОтменыОплаты Тогда
		СтрокаСлипЧека = "";
		ТекстОписаниеОшибки = НСтр("ru = 'Операция отмены оплаты не выполнена'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	ВыполнитьОтменуОплатыКартой();
	
КонецПроцедуры

&НаКлиенте
Функция ПроверкаВозможностиРаботыСКартойДляОтменыОперации(ПараметрыЭТ)
	Перем Отказ;
	Перем ИспользоватьБезПодключенияОборудованияФР;
	
	Результат = Ложь;
	Отказ     = Ложь;
	ПараметрыЭТ = Новый Структура("УстройствоПодключено, УстройствоПечатиПодключено", Ложь, Ложь);
	
	РезультатПроверки = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидОперации) Тогда
		ТекстСообщения = НСтр("ru = 'Не указан вид операции - оплата или возврат!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		РезультатПроверки = Ложь;
	КонецЕсли;
	
	Если ЭтоВозвратОплатыПлатежнойКартой(Объект.ВидОперации) Тогда
		ТекстСообщения = НСтр("ru = 'Операция отмены оплаты предназначена только для операции с видом - оплата!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		РезультатПроверки = Ложь;
	КонецЕсли;	
	
	Если НЕ Объект.ОплатаВыполнена Тогда
		ТекстСообщения = НСтр("ru = 'Операция оплаты не выполнена и поэтому не может быть отменена!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		РезультатПроверки = Ложь;
	КонецЕсли;
	
	Если Объект.ОтменаОплатыВыполнена Тогда
		ТекстСообщения = НСтр("ru = 'Операция отмены оплаты уже выполнена!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		РезультатПроверки = Ложь;
	КонецЕсли;
	
	Если Модифицированность Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Документ необходимо записать.'"));
		РезультатПроверки = Ложь;
	КонецЕсли; 
	
	Если НЕ РезультатПроверки Тогда
		Возврат Результат;
	КонецЕсли;	
	
	ПолучитьНеобходимыеДанныеДляРаботыСКартой(ПараметрыЭТ, Отказ, ИспользоватьБезПодключенияОборудованияФР);
	
	Если Отказ  Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ИспользоватьБезПодключенияОборудованияФР Тогда
		ПараметрыЭТ.УстройствоПодключено = Ложь;
	Иначе	
		ПараметрыЭТ.УстройствоПодключено = Истина;
	КонецЕсли;
	
	Если ПараметрыЭТ.ИспользоватьУстройствоПечатиСлипЧека Тогда
		ПараметрыЭТ.Вставить("НеобходимоНапечататьСлипЧекНаФР", Истина);
		ПараметрыЭТ.Вставить("РезультатФР", Истина);
	Иначе
		ПараметрыЭТ.Вставить("НеобходимоНапечататьСлипЧекНаФР", Ложь);
		ПараметрыЭТ.Вставить("РезультатФР", Ложь);
	КонецЕсли;
	
	Результат = Истина;
	
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура ВыполнитьОтменуОплатыКартой()
	Перем ПараметрыЭТ;
	
	Если НЕ ПроверкаВозможностиРаботыСКартойДляОтменыОперации(ПараметрыЭТ) Тогда
		Возврат;
	КонецЕсли;

	// Предварительно авторизуем операцию
	ПараметрыФормы = Новый Структура("Сумма, ПределСуммы", Объект.СуммаДокумента, Объект.СуммаДокумента);
	ПараметрыФормы.Вставить("ЗапретРедактированияСуммы", Истина);
	Если ПараметрыЭТ.ИспользоватьБезПодключенияОборудования Тогда
		ПараметрыФормы.Вставить("ПоказыватьНомерКарты", НЕ ПараметрыЭТ.НеВводитьНомерПлатежнойКарты);
	КонецЕсли;
	
	ДанныеОперацииОплаты = Новый Структура;
	ДанныеОперацииОплаты.Вставить("Сумма", Объект.СуммаДокумента);
	ДанныеОперацииОплаты.Вставить("НомерПлатежнойКарты", Объект.НомерПлатежнойКарты);
	ДанныеОперацииОплаты.Вставить("СсылочныйНомер", Объект.СсылочныйНомер);
	ДанныеОперацииОплаты.Вставить("НомерЧекаЭТ", Объект.НомерЧекаЭТ);
	
	УдалитьОплатуКартой(ДанныеОперацииОплаты);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОплатуКартой(ТекущиеДанные)
	
	ИдентификаторУстройстваЭТ = Неопределено;
	ИдентификаторУстройстваФР = Неопределено;
	
	СуммаОперации       = ТекущиеДанные.Сумма;
	НомерКарты          = ТекущиеДанные.НомерПлатежнойКарты;
	НомерСсылкиОперации = ТекущиеДанные.СсылочныйНомер;
	НомерЧекаЭТ         = ТекущиеДанные.НомерЧекаЭТ;
	СтрокаСлипЧека      = "";
		
	СтруктураЭквайринговыйТерминал = СтруктураДанныхЭТ(Объект.ЭквайринговыйТерминал);
	ИдентификаторУстройстваЭТ = СтруктураЭквайринговыйТерминал.ПодключаемоеОборудование;
	
	ПараметрыКассыККМ = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.ФискальныйРегистратор);
	ИдентификаторУстройстваФР  = ПараметрыКассыККМ.ИдентификаторУстройства;
	Если НЕ ИспользоватьПодключаемоеОборудование Тогда
		ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования = Истина;
		СтруктураЭквайринговыйТерминал.ИспользоватьБезПодключенияОборудования = Истина;
	КонецЕсли;
	
	ИспользоватьКассуККМБезПодключенияОборудования = ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	ИспользоватьБезПодключенияОборудованияЭТ = СтруктураЭквайринговыйТерминал.ИспользоватьБезПодключенияОборудования;
	
	ПараметрДействия = Новый Структура;
	ПараметрДействия.Вставить("ИспользоватьКассуККМБезПодключенияОборудования", ИспользоватьКассуККМБезПодключенияОборудования);
	ПараметрДействия.Вставить("ИдентификаторУстройстваФР", ИдентификаторУстройстваФР);
	ПараметрДействия.Вставить("ИспользоватьБезПодключенияОборудованияЭТ", ИспользоватьБезПодключенияОборудованияЭТ);
	ПараметрДействия.Вставить("ИдентификаторУстройстваЭТ", ИдентификаторУстройстваЭТ);
	ПараметрДействия.Вставить("ТекстОписаниеОшибки", "");
	ПараметрДействия.Вставить("СтрокаСлипЧека", СтрокаСлипЧека);
	ПараметрДействия.Вставить("СуммаОперации", СуммаОперации);
	ПараметрДействия.Вставить("НомерСсылкиОперации", НомерСсылкиОперации);
	ПараметрДействия.Вставить("НомерЧекаЭТ", НомерЧекаЭТ);
	
	Если НЕ ИспользоватьБезПодключенияОборудованияЭТ Тогда
		
		ЭтотОбъект.Доступность = Ложь;
			
		ПараметрыОперации = ОборудованиеПлатежныеСистемыКлиентСервер.ПараметрыВыполненияЭквайринговойОперации();
		ПараметрыОперации.ТипТранзакции  = "AuthorizeVoid";
		ПараметрыОперации.СуммаОперации  = СуммаОперации;
		ПараметрыОперации.НомерКарты     = НомерКарты;
		ПараметрыОперации.НомерЧекаЭТ    = НомерЧекаЭТ;
		ПараметрыОперации.СсылочныйНомер = НомерСсылкиОперации;
		
		Оповещение = Новый ОписаниеОповещения("УдалитьОплатуКартойЗавершение", ЭтотОбъект, ПараметрДействия);
		ОборудованиеПлатежныеСистемыКлиент.НачатьВыполнениеОперацииНаЭквайринговомТерминале(Оповещение, УникальныйИдентификатор, 
			ПараметрДействия.ИдентификаторУстройстваЭТ, ПараметрыОперации,,ПараметрДействия.ИдентификаторУстройстваФР);
	
	Иначе
		
		ТекстВопроса = НСтр("ru = 'Требуется выполнить операцию отмены оплаты на эквайринговом терминале.'") + Символы.ПС;
		ТекстВопроса = ТекстВопроса + НСтр("ru = 'Сумма операции:'")        + " "+ СуммаОперации         + Символы.ПС;
		ТекстВопроса = ТекстВопроса + НСтр("ru = 'Номер карты:'")           + " "+ НомерКарты            + Символы.ПС;
		ТекстВопроса = ТекстВопроса + НСтр("ru = 'Ссылочный номер:'")       + " "+ НомерСсылкиОперации   + Символы.ПС;
		ТекстВопроса = ТекстВопроса + НСтр("ru = 'Номер чека:'")            + " "+ НомерЧекаЭТ           + Символы.ПС;
		ТекстВопроса = ТекстВопроса + Символы.ПС;
		ТекстВопроса = ТекстВопроса + НСтр("ru = 'Операция отмены оплаты на эквайринговом терминале прошла успешно?'");
		
		ДополнительныеПараметры = Новый Структура; 
		ДополнительныеПараметры.Вставить("ПараметрДействия", ПараметрДействия);
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеВопросУспешностиОтменыОперацииНаЭТ", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(ОбработчикОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СтруктураДанныхЭТ(Терминал)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ЭквайринговыеТерминалы.ПодключаемоеОборудование,
	|	ЭквайринговыеТерминалы.ИспользоватьБезПодключенияОборудования,
	|	ЭквайринговыеТерминалы.Ссылка
	|ИЗ
	|	Справочник.ЭквайринговыеТерминалы КАК ЭквайринговыеТерминалы
	|ГДЕ
	|	ЭквайринговыеТерминалы.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Терминал);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	СтруктураВозврата = Новый Структура("ПодключаемоеОборудование, ИспользоватьБезПодключенияОборудования");
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, Выборка);
	Иначе
		СтруктураВозврата = Неопределено; 
		СтруктураВозврата.ИспользоватьБезПодключенияОборудования = Истина;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаКлиенте
Процедура УдалитьОплатуКартойЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	ЭтотОбъект.Доступность = Истина;
	
	Если НЕ РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр("ru = 'При выполнении операции возникла ошибка:
			|""%ОписаниеОшибки%"".
			|Оплата по карте не была произведена.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	Иначе
		ЗавершитьОтменуОплатыПлатежнойКартойЧерезЭквайринговыйТерминал(Истина, Параметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОтменуОплатыПлатежнойКартойЧерезЭквайринговыйТерминал(РезультатОперации, ПараметрДействия)
	
	Если РезультатОперации Тогда
		
		ЗавершитьОтменуОплатыКартой(ПараметрДействия);
		
	КонецЕсли;
	
	ОбновитьОтображениеДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОтменуОплатыКартой(ПараметрДействия)
	
	Объект.СсылочныйНомерОтмены = ПараметрДействия.НомерСсылкиОперации;
	Объект.НомерЧекаЭТОтмены = ПараметрДействия.НомерЧекаЭТ;
	Объект.ОтменаОплатыВыполнена = Истина;
	
	ИспользоватьБезПодключенияОборудованияФР = РаботаБезПодключенияФР(Объект.ФискальныйРегистратор);
		
	ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение);
	
	РезультатЗаписи = Записать(ПараметрыЗаписи);
	
	Если РезультатЗаписи = Истина Тогда
		Если НЕ ЗначениеЗаполнено(Объект.СтатусЧекаККМОтмены) Тогда
			ПробитьЧекДляОтменыОплатыНаКлиенте();
		КонецЕсли;
	КонецЕсли;
	
	НомерКассовогоЧека  = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементов(ЭтотОбъект, НомерКассовогоЧека);
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекДляОтменыОплатыНаКлиенте()

	Результат = Ложь;
	ЕстьОшибки = Ложь;
	
	ОчиститьСообщения();
	
	ЕстьОшибки = НЕ ПодключаемоеОборудованиеБГУКлиент.ПроверитьВозможностьПечатиЧека(ЭтотОбъект);
	
	Если НЕ ВсеРеквизитыДляЧекаЗаполнены() Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЕстьОшибки И ПроверитьЗаполнение() Тогда
		
		ЭтотОбъект.Доступность = Ложь;
		
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекОтменыНаКлиентеЗавершение", ЭтотОбъект);
		ПробитьЧекНаОтменуВыполнить(Оповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекОтменыНаКлиентеЗавершение(ЧекПробит, Параметры) Экспорт
	
	ЭтотОбъект.Доступность = Истина;
	
	Если ЧекПробит Тогда
		ТолькоПросмотр = Истина;
		УстановитьДоступностьКнопокПроведенияКлиент();
	КонецЕсли;
	
	НомерКассовогоЧека  = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	УстановитьВидимостьЭлементов(ЭтотОбъект, НомерКассовогоЧека);
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекНаОтменуВыполнить(ОповещениеПриЗавершении)
	
	Если Объект.НомерЧекаККМОтмены <> 0 Тогда
		ТекстСообщения = НСтр("ru = 'Чек на отмену оплаты уже пробит на фискальном регистраторе!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
		Возврат;
	КонецЕсли;
	
	ПодключаемоеОборудованиеБГУКлиент.ЗаполнитьНомерДокументаКассыККМ(Объект.ФискальныйРегистратор);
	НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
	ПорядковыйНомерПродажи = НомерДокументаКассыККМ[Объект.ФискальныйРегистратор];
	
	ПараметрыКассыККМ         = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.ФискальныйРегистратор);
	ИдентификаторУстройстваФР = ПараметрыКассыККМ.ИдентификаторУстройства;
	
	ИспользоватьКассуККМБезПодключенияОборудования = ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	
	Если ИспользоватьКассуККМБезПодключенияОборудования Тогда
		
		ИспользоватьБезПримененияККТ = ПараметрыКассыККМ.ИспользоватьБезПримененияККТ;
		Если ИспользоватьБезПримененияККТ Тогда
		
			Объект.НомерСменыККМ = 0;
			Объект.НомерЧекаККМОтмены  = ПорядковыйНомерПродажи;
			Объект.СтатусЧекаККМОтмены = ПредопределенноеЗначение("Перечисление.СтатусыЧековККМ.Пробитый");
			Объект.ДатаЧекаККМОтмены   = ОбщегоНазначенияКлиент.ДатаСеанса();
			
			Модифицированность = Истина;
			РезультатЗаписи = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, РезультатЗаписи = Истина);
			
			Если РезультатЗаписи = Истина Тогда
				НомерДокументаКассыККМ[Объект.ФискальныйРегистратор] = Объект.НомерЧекаККМОтмены + 1;
				
				Подключаемый_ВыполнитьКоманду(ЭтотОбъект.Команды.Найти("ПодменюПечатьОбычное__РасчетныйДокументБезККТ"));
			КонецЕсли;
			
			ЭтотОбъект.Доступность = Истина;
			НомерКассовогоЧека = НомерЧекаДляДокумента();
			ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
			УстановитьВидимостьЭлементовФормы();
		Иначе
			ТекстСообщения = НСтр("ru = 'Для включения возможности печати расчетных документов следует включить 
			|флажок ""Использовать для печати расчетных документов без применения ККТ"" 
			|у кассы, которая указана в реквизите ""Касса ККМ"".'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
		КонецЕсли;	
		
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторУстройстваФР <> Неопределено Тогда
		
		ЭтотОбъект.Доступность = Ложь;

		// Готовим данные для отмены
		НомерЧека = ПорядковыйНомерПродажи;
		ОбщиеПараметры    = ПодготовитьДанныеДляПробитияЧека(НомерЧека, Истина);
		ОбщиеПараметры.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств");
		
		Контекст = Новый Структура();
		Контекст.Вставить("ОповещениеПриЗавершении", ОповещениеПриЗавершении);
		
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекВыполнитьЗавершение", ЭтотОбъект, Контекст);
		
		ДополнительныеПараметры = МенеджерОборудованияКлиентСервер.ДополнительныеПараметрыОперации();
   		ДополнительныеПараметры.ОповещениеПослеОткрытииЧека = Новый ОписаниеОповещения("ПечатьЧека_ПослеОткрытияЧека", ЭтотОбъект, Контекст);
    	ДополнительныеПараметры.ОповещениеПриОшибкеПечатиЧека = Новый ОписаниеОповещения("ПечатьЧека_ПослеОшибкиПечатиЧека", ЭтотОбъект, Контекст);
				
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(Оповещение, 
										УникальныйИдентификатор, 
										ИдентификаторУстройстваФР,
										ОбщиеПараметры, 
										ДополнительныеПараметры);
			
	Иначе
		ТекстСообщения = НСтр("ru = 'Устройство для печати чеков не выбрано.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекНаОтменуОплатыВыполнитьЗавершение(РезультатВыполнения, Параметры) Экспорт
	ПодключаемоеОборудованиеБГУКлиент.ЗаполнитьНомерДокументаКассыККМ(Объект.ФискальныйРегистратор); 
	НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
	ПорядковыйНомерПродажи = НомерДокументаКассыККМ[Объект.ФискальныйРегистратор];
	
	ЭтотОбъект.Доступность = Истина;
	
	Если РезультатВыполнения.Результат Тогда
		
		// Установить полученное значение номера чека реквизиту документа.
		Объект.НомерСменыККМ = РезультатВыполнения.ВыходныеПараметры[0];
		Объект.НомерЧекаККМОтмены  = РезультатВыполнения.ВыходныеПараметры[1];
		
		Объект.СтатусЧекаККМОтмены = ПредопределенноеЗначение("Перечисление.СтатусыЧековККМ.Пробитый");
		Объект.ДатаЧекаККМОтмены   = ОбщегоНазначенияКлиент.ДатаСеанса();
		Если Не ЗначениеЗаполнено(Объект.НомерЧекаККМОтмены) Тогда
			Объект.НомерЧекаККМОтмены = ПорядковыйНомерПродажи;
		КонецЕсли;
		
		Модифицированность = Истина;
		
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Запись);
		РезультатЗаписи = Записать(ПараметрыЗаписи);
		
		ВыполнитьОбработкуОповещения(Параметры.ОповещениеПриЗавершении, РезультатЗаписи);
		
	Иначе
		ТекстСообщения = НСтр("ru = 'При печати чека произошла ошибка.
		                            |Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ВыполнитьОбработкуОповещения(Параметры.ОповещениеПриЗавершении, Ложь);
	КонецЕсли;
	
	НомерКассовогоЧека  = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	УстановитьВидимостьЭлементов(ЭтотОбъект, НомерКассовогоЧека);
	
КонецПроцедуры

&НаКлиенте
Процедура НапечататьЧекНаОтмену(Команда)
	ПробитьЧекДляОтменыОплатыНаКлиенте();	
КонецПроцедуры

&НаСервере
Процедура КонтрольСчетовФактурПриОтменеОперации()
	Если Объект.ОтменаОплатыВыполнена Тогда
		СФ = Эквайринг.ЕстьСчетФактураДляЭквайринговойОперации(Объект.Ссылка);
		
		Если СФ.Количество()>0 Тогда
			ТекстСообщения = НСтр("ru = 'Следует пометить на удаление:'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Для каждого ТекСтрока Из СФ Цикл
				ТекстСообщения = СокрЛП(ТекСтрока.Ссылка);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеВопросУспешностиОтменыОперацииНаЭТ(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	РезультатОперации = (РезультатВопроса = КодВозвратаДиалога.Да);
	
	Если НЕ РезультатОперации Тогда
		ТекстСообщения = НСтр("ru = 'Операция отмены не выполнена'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	ЗавершитьОтменуОплатыПлатежнойКартойЧерезЭквайринговыйТерминал(РезультатОперации, ДополнительныеПараметры.ПараметрДействия);
	
	ОбновитьОтображениеДанных();
	
КонецПроцедуры

&НаСервере
Процедура ПараметрыДоговораПлатежногоАгентаПриИзмененииНаСервере()
	ПодразделениеПлатежногоАгента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ПараметрыДоговораПлатежногоАгента, "Подразделение");
	Если ЗначениеЗаполнено(ПодразделениеПлатежногоАгента) Тогда
		Объект.Подразделение = ПодразделениеПлатежногоАгента;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция НомерЧекаДляДокумента()
	Если Объект.НомерЧекаККМ<>0 Тогда
		Возврат Объект.НомерЧекаККМ;
	КонецЕсли;	
	
	Возврат ПодключаемоеОборудованиеБГУ.НомерЧека(Объект.Ссылка);
КонецФункции

&НаСервере
Функция ДанныеЧекаДляДокумента()
	Результат = Новый Структура;
	Результат.Вставить("НомерЧекаККМ", 0);
	Результат.Вставить("ДатаЧекаККМ", Дата(1,1,1));
	Результат.Вставить("ФискальныйПризнак", "");
	Результат.Вставить("ИдентификаторЗаписи", "");
	
	Если Объект.НомерЧекаККМОтмены<>0 Тогда
		Результат.НомерЧекаККМ = Объект.НомерЧекаККМОтмены;
		Результат.ДатаЧекаККМ = Объект.ДатаЧекаККМОтмены;
		
		Возврат Результат;
	ИначеЕсли Объект.НомерЧекаККМ<>0 Тогда
		Результат.НомерЧекаККМ = Объект.НомерЧекаККМ;
		Результат.ДатаЧекаККМ = Объект.ДатаЧекаККМ;
		
		Возврат Результат;
	КонецЕсли;	
	
	Возврат ПодключаемоеОборудованиеБГУ.ДанныеЧека(Объект.Ссылка);
КонецФункции

&НаСервере
Процедура ЗаписатьФискальныеДанныеДляРасчетногоДокумента(НомерЧека)
	ПараметрыФискализации = Новый Структура;
	ПараметрыФискализации.Вставить("ДатаВремяЧека", ТекущаяДата());
	ПараметрыФискализации.Вставить("ДокументОснование", Объект.Ссылка);
	ПараметрыФискализации.Вставить("Организация", Объект.Организация);
	ПараметрыФискализации.Вставить("ТипРасчета", Объект.ТипРасчета);
	ПараметрыФискализации.Вставить("НомерСменыККТ", 1);
	ПараметрыФискализации.Вставить("НомерЧекаККТ", НомерЧека);
	ПараметрыФискализации.Вставить("ФискальныйПризнак", Строка(НомерЧека));
	ПараметрыФискализации.Вставить("ТипДокумента", Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек);
	ПараметрыФискализации.Вставить("АдресСайтаПроверки", "");
	ПараметрыФискализации.Вставить("ЗаводскойНомерФН", "");
	ПараметрыФискализации.Вставить("РегистрационныйНомерККТ", "");
	ПараметрыФискализации.Вставить("ДополнительныйРеквизит", "");
	ПараметрыФискализации.Вставить("ДанныеЧекаXML", Неопределено);
	
	ОбщиеПараметры = ПодготовитьДанныеДляПробитияЧека(НомерЧека);
	
	СуммаЧека = 0;
	ОплатаНаличные = 0;
	ОплатаЭлектронно = 0;
	ОплатаПостоплата = 0;
	ОплатаПредоплата = 0;
	
	Для каждого ТекСтрока Из ОбщиеПараметры.ТаблицаОплат Цикл
		СуммаЧека = СуммаЧека + ТекСтрока.Сумма;
		Если ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Наличные Тогда
			ОплатаНаличные = ОплатаНаличные + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Электронно Тогда
			ОплатаЭлектронно = ОплатаЭлектронно + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Предоплата Тогда
			ОплатаПредоплата = ОплатаПредоплата + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Постоплата Тогда
			ОплатаПостоплата = ОплатаПостоплата + ТекСтрока.Сумма;
		КонецЕсли;	
	КонецЦикла;	
	ПараметрыФискализации.Вставить("СуммаЧека", СуммаЧека);
	ПараметрыФискализации.Вставить("ОплатаНаличные", ОплатаНаличные);
	ПараметрыФискализации.Вставить("ОплатаЭлектронно", ОплатаЭлектронно);
	ПараметрыФискализации.Вставить("ОплатаПредоплата", ОплатаПредоплата);
	ПараметрыФискализации.Вставить("ОплатаПостоплата", ОплатаПостоплата);
	
	ПодключаемоеОборудованиеБГУВызовСервера.ЗаписатьФискальнуюОперацию(ПараметрыФискализации);

КонецПроцедуры

&НаСервере
Функция ЗаключительныйЧекИсправительный()
	
	Возврат ПодключаемоеОборудованиеБГУ.ЗаключительныйЧекИсправительный(Объект.Ссылка);

КонецФункции

&НаКлиенте
Функция ПодготовитьДанныеДляПросмотраЧека(НомерЧека)
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
		
		Результат = ПодготовитьДанныеДляПробитияЧека(НомерЧека);
		
		Возврат Результат;
	КонецЕсли;	
	
	ДанныеЧека = ДанныеЧекаДляДокумента();
	Если ЗначениеЗаполнено(ДанныеЧека.ИдентификаторЗаписи) И ЗначениеЗаполнено(ДанныеЧека.ТекстовыеДанныеXML) Тогда
		Результат = ПодключаемоеОборудованиеБГУВызовСервера.ЗагрузитьДанныеФискализацииИзXML(ДанныеЧека.ТекстовыеДанныеXML);
		
		Возврат Результат;
	КонецЕсли;
	
	Результат = ПодготовитьДанныеДляПробитияЧека(НомерЧека);
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПробитьЧекСПроверкойСтавокНДС()
	ЕстьУстаревшиеСтавкиНДС = Ложь;
	ПроверитьКассовыйЧекНаУстаревшиеСтавкиНДСНаСервере(Объект.Ссылка, ЕстьУстаревшиеСтавкиНДС);
	
	Если ЕстьУстаревшиеСтавкиНДС Тогда
		ТекстСообщения = НСтр("ru='При формировании кассового чека используется устаревшая ставка НДС. Прервать печать чека?'");
		Оповещение = Новый ОписаниеОповещения("ПрерватьПечатьКассовогоЧекаПриЗамечаниях", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
	Иначе
		ЭтотОбъект.Доступность = Ложь;
		
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекНаКлиентеЗавершение", ЭтотОбъект);
		ПробитьЧекВыполнить(Оповещение);
	КонецЕсли;	
КонецПроцедуры		

&НаКлиенте
Процедура ПрерватьПечатьКассовогоЧекаПриЗамечаниях(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		ЭтотОбъект.Доступность = Ложь;
			
		Оповещение = Новый ОписаниеОповещения("ПробитьЧекНаКлиентеЗавершение", ЭтотОбъект);
		ПробитьЧекВыполнить(Оповещение);
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ПроверитьКассовыйЧекНаУстаревшиеСтавкиНДСНаСервере(ДокументПечатиЧека, ЕстьУстаревшиеСтавкиНДС)
	
	УстаревшиеСтавкиНДС = ПодключаемоеОборудованиеБГУ.УстаревшиеСтавкиНДС();
	ТаблицаНоменклатуры = ПодключаемоеОборудованиеБГУ.ТаблицаНоменклатурыЧекаККМ(ДокументПечатиЧека);
	ТаблицаНоменклатуры.Свернуть("СтавкаНДС");
	Для каждого ТекСтрока Из ТаблицаНоменклатуры Цикл
		Если НЕ УстаревшиеСтавкиНДС.Найти(ТекСтрока.СтавкаНДС) = Неопределено Тогда
			ЕстьУстаревшиеСтавкиНДС = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДополнительныеДанныеЧековККМ()
	ДополнительныеДанныеЧекаККМ = Новый Структура;
	ДополнительныеДанныеЧекаККМ.Вставить("ДокументОснование", Объект.Ссылка);
	ДополнительныеДанныеЧекаККМ.Вставить("Контрагент", Объект.Контрагент);
	ДополнительныеДанныеЧекаККМ.Вставить("АбонентскийНомерТелефона", АбонентскийНомерТелефона);
	ДополнительныеДанныеЧекаККМ.Вставить("АдресЭлектроннойПочты", АдресЭлектроннойПочты);
	ДополнительныеДанныеЧекаККМ.Вставить("ОтказПокупателяОтСохраненияДанных", ОтказПокупателяОтСохраненияДанных);
	
	ПодключаемоеОборудованиеБГУВызовСервера.ЗаписатьДополнительныеСведенияКассовогоЧека(ДополнительныеДанныеЧекаККМ);	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДополнительныеДанныеЧековККМ()
	ДополнительныеСведенияКассовогоЧека = 
		ПодключаемоеОборудованиеБГУВызовСервера.ДополнительныеСведенияКассовогоЧека(Объект.Ссылка);
	АбонентскийНомерТелефона = ДополнительныеСведенияКассовогоЧека.АбонентскийНомерТелефона;
	АдресЭлектроннойПочты = ДополнительныеСведенияКассовогоЧека.АдресЭлектроннойПочты;
	ОтказПокупателяОтСохраненияДанных = ДополнительныеСведенияКассовогоЧека.ОтказПокупателяОтСохраненияДанных;
	Если Объект.ОтказКлиентаОтСохраненияТелефонаEmail Тогда
		ОтказПокупателяОтСохраненияДанных = Объект.ОтказКлиентаОтСохраненияТелефонаEmail;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНовуюЭквайринговуюОперацию(СтруктураДанныхДокумента, НовыйДокумент)
	
	ПараметрыДоговораЭквайринга = СтруктураДанныхДокумента.ПараметрыДоговораЭквайринга;
	
	ЗаполнитьЗначенияСвойств(НовыйДокумент, ПараметрыДоговораЭквайринга);
	ЗаполнитьЗначенияСвойств(НовыйДокумент, СтруктураДанныхДокумента);
	Счет21005 = БухгалтерскийУчет.СчетПоКоду("210.05",НовыйДокумент.Дата);
	Если СтруктураДанныхДокумента.СтатьяАналитикиОплаты.СчетУчета = Счет21005 Тогда
		НовыйДокумент.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ПоступлениеВыручкиОтРозничныхПродажКомиссионныхТоваров;
		БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	Иначе
		НовыйДокумент.ВидОперации = ?(СтруктураДанныхДокумента.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат, 
			Перечисления.ВидыОперацииЭквайринга.ВозвратОплатыПлатежнойКартой, Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой);
		Если СтруктураДанныхДокумента.ЭтоРозничныйПокупатель Тогда
			НовыйДокумент.ВидОперации = ?(СтруктураДанныхДокумента.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат, 
				Перечисления.ВидыОперацииЭквайринга.ВозвратОплатыПлатежнойКартой, Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой);
		КонецЕсли;
	КонецЕсли;
	НовыйДокумент.ВидПервичногоДокумента = СтруктураДанныхДокумента.ВидПервичногоДокумента;
	НовыйДокумент.ЛицевойСчет = ПараметрыДоговораЭквайринга.ЛицевойСчет;
	НовыйДокумент.ИсточникСредств = ПараметрыДоговораЭквайринга.ИсточникСредств;
	НовыйДокумент.Эквайер = ПараметрыДоговораЭквайринга.Эквайер;
	НовыйДокумент.ДоговорЭквайринга = ПараметрыДоговораЭквайринга.ДоговорЭквайринга;
	НовыйДокумент.СпособОплатыУслугЭквайера = ПараметрыДоговораЭквайринга.СпособОплатыУслугЭквайера;
	НовыйДокумент.СпособУчетаОбязательств = ПараметрыДоговораЭквайринга.СпособУчетаОбязательств;
	
	НовыйДокумент.КодЦелиЗатрат = ПараметрыДоговораЭквайринга.КодЦелиЗатрат;
	НовыйДокумент.КодМероприятияЗатрат = ПараметрыДоговораЭквайринга.КодМероприятияЗатрат;
	НовыйДокумент.ДопКлассификацияЗатрат = ПараметрыДоговораЭквайринга.ДопКлассификацияЗатрат;
	
	СтатьяАналитикиОплаты = СтруктураДанныхДокумента.СтатьяАналитикиОплаты;
	
	ДатаСведений = СтруктураДанныхДокумента.Дата;
	Организация = НовыйДокумент.Организация;
	
	СчетУчета = СтатьяАналитикиОплаты.СчетУчета;		
	Если НЕ ЗначениеЗаполнено(СчетУчета) Тогда
		СчетУчета = БухгалтерскийУчет.СчетПоКоду("205.31", ДатаСведений, Организация);
	КонецЕсли;
	
	Счет40110 = БухгалтерскийУчет.СчетПоКоду("401.10", ДатаСведений, Организация);
	Счет40100 = БухгалтерскийУчет.СчетПоКоду("401.00", ДатаСведений, Организация);
	Счет20500 = БухгалтерскийУчет.СчетПоКоду("205.00", ДатаСведений, Организация);
	
	Если СчетУчета = Счет40110 Тогда
		НовыйДокумент.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ПоступлениеВыручкиОтРозничныхПродаж;
		НовыйДокумент.КорСчет = Счет40100;
	ИначеЕсли СчетУчета = Счет21005 Тогда
		НовыйДокумент.КорСчет = Счет21005;
	Иначе
		НовыйДокумент.КорСчет = Счет20500;
	КонецЕсли;
	НовыйДокумент.СчетРасчетов = СчетУчета;
	
	НовыйДокумент.ИФО = СтатьяАналитикиОплаты.ИФО;
	
	НовыйДокумент.КФО = СтатьяАналитикиОплаты.КФО;
	НовыйДокумент.КБКНазначениеПлатежа = СтатьяАналитикиОплаты.КПС;
	НовыйДокумент.КОСГУНазначениеПлатежа = СтатьяАналитикиОплаты.КЭК;
	
	НовыйДокумент.КодЦели = СтатьяАналитикиОплаты.КодЦели;
	НовыйДокумент.КодМероприятия = СтатьяАналитикиОплаты.КодМероприятия;
	НовыйДокумент.ДопКлассификация = СтатьяАналитикиОплаты.ДопКлассификация;
	
	
	КассоваяСмена = СтруктураДанныхДокумента.КассоваяСмена;
	ОтчетПоКассовойСмене = СтруктураДанныхДокумента.ОтчетПоКассовойСмене;
	
	НовыйДокумент.ДокументОснование = ОтчетПоКассовойСмене;
	
	Если ЗначениеЗаполнено(КассоваяСмена) Тогда
		НомерПервичногоДокумента = КассоваяСмена.НомерСменыККТ;
		ДатаПервичногоДокумента = КассоваяСмена.Дата;
	Иначе
		НомерПервичногоДокумента = ОтчетПоКассовойСмене.НомерСмены;
		ДатаПервичногоДокумента = ОтчетПоКассовойСмене.Дата;
	КонецЕсли;
	
	НовыйДокумент.НомерПервичногоДокумента = НомерПервичногоДокумента;
	НовыйДокумент.ДатаПервичногоДокумента = ДатаПервичногоДокумента;
	
	НовыйДокумент.БезИспользованияОборудования = Истина;
	
	ПараметрыДоговораПлатежногоАгента = СтруктураДанныхДокумента.ПараметрыДоговораПлатежногоАгента;
	Если ЗначениеЗаполнено(ПараметрыДоговораПлатежногоАгента) Тогда
		Если ЗначениеЗаполнено(ПараметрыДоговораПлатежногоАгента.Подразделение) Тогда
			НовыйДокумент.Подразделение = ПараметрыДоговораПлатежногоАгента.Подразделение;		
		КонецЕсли;	
	КонецЕсли;	
	НовыйДокумент.ПараметрыДоговораПлатежногоАгента = ПараметрыДоговораПлатежногоАгента;
	
	Если ЗначениеЗаполнено(НовыйДокумент.СтавкаНДС) Тогда
		СтавкаНДС = УчетНДСПовтИсп.ПолучитьСтавкуНДС(НовыйДокумент.СтавкаНДС);
		НовыйДокумент.СуммаНДС = НовыйДокумент.СуммаДокумента / (100 + СтавкаНДС) * СтавкаНДС;
	КонецЕсли;	
	
	Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Документ создан на основании отчета по кассовой смене № %1 от %2'"),
			СокрЛП(ОтчетПоКассовойСмене.Номер),
			Формат(ОтчетПоКассовойСмене.Дата, "ДЛФ=D"));
	
	НовыйДокумент.Комментарий = Комментарий;
	
КонецПроцедуры

&НаСервере
Функция ВидОперацииДокументаОснования()
	Результат = Перечисления.ВидыОперацииЭквайринга.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭквайринговаяОперация") Тогда
			Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "ВидОперации");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

&НаКлиенте
Процедура ПроверитьКодыМаркировки(ИдентификаторУстройстваФР) 
	
	МенеджерОборудованияКлиент.НачатьПодключениеОборудования(Неопределено, ЭтотОбъект, , ИдентификаторУстройстваФР);
	
	Если ИспользуетсяККТСПередачейДанных И ВерсияФФД(Объект.ФискальныйРегистратор) = "1.2" Тогда 
		СписокДокументов = Новый Массив;
		Для Каждого ДокументОснование Из Объект.ДокументыЧекаККМ Цикл 
			Если ТипЗнч(ДокументОснование.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.ЗаявлениеНаВозвратПоЧекуККМ") Тогда
				СписокДокументов.Добавить(ДокументОснование.ДокументОснованиеЧекаККМ);
			КонецЕсли;	
		КонецЦикла;
		Если СписокДокументов <> Неопределено И СписокДокументов.Количество() > 0 Тогда 
			СписокКодовМаркировки = ПолучитьСписокКодовМаркировки(СписокДокументов);
			Для Каждого СтрокаТовар Из СписокКодовМаркировки Цикл 
				ОтправитьЗапросНаПроверкуКМ(СтрокаТовар, ИдентификаторУстройстваФР);	
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьСписокКодовМаркировки(СписокДокументов)
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ЗаявлениеНаВозвратПоЧекуККМТоварыРаботыУслуги.КодМаркировки КАК КодМаркировки,
	               |	ЗаявлениеНаВозвратПоЧекуККМТоварыРаботыУслуги.Количество КАК Количество
	               |ИЗ
	               |	Документ.ЗаявлениеНаВозвратПоЧекуККМ.ТоварыРаботыУслуги КАК ЗаявлениеНаВозвратПоЧекуККМТоварыРаботыУслуги
	               |ГДЕ
	               |	ЗаявлениеНаВозвратПоЧекуККМТоварыРаботыУслуги.Ссылка В(&СписокДокументов)
	               |	И ЗаявлениеНаВозвратПоЧекуККМТоварыРаботыУслуги.МаркируемыйТовар = ИСТИНА
	               |	И ЗаявлениеНаВозвратПоЧекуККМТоварыРаботыУслуги.КодМаркировки <> """"";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	СписокКодовМаркировки = Новый Массив;
	Для Каждого СтрокаРезультат Из РезультатЗапроса Цикл 
		КодМаркировки = Новый Структура("КодМаркировки, Количество", СтрокаРезультат.КодМаркировки, СтрокаРезультат.Количество);
		СписокКодовМаркировки.Добавить(КодМаркировки);
	КонецЦикла;	
	Возврат СписокКодовМаркировки;
	
КонецФункции	
	
&НаКлиенте
Процедура ОтправитьЗапросНаПроверкуКМ(СтрокаТовар, ИдентификаторУстройстваФР)
	
	УникальныйИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор); 
	
	ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыЗапросКМ();
	ПараметрыОперации.ИдентификаторЗапроса 			= УникальныйИдентификаторЗапроса;
	ПараметрыОперации.Количество 					= СтрокаТовар.Количество;  
	ПараметрыОперации.ДробноеКоличество.Числитель   = 0;     
	ПараметрыОперации.ДробноеКоличество.Знаменатель = 0;     
	ПараметрыОперации.МераКоличестваПредметаРасчета = ПредопределенноеЗначение("Перечисление.МераКоличестваПредметаРасчетаККТ.Штука");
	ПараметрыОперации.ПланируемыйСтатусТовара 		= ПредопределенноеЗначение("Перечисление.ПланируемыйСтатусМаркируемогоТовара.ШтучныйТоварРеализован");
	ПараметрыОперации.КонтрольнаяМарка 				= СтрокаТовар.КодМаркировки;
	ПараметрыОперации.ОжидатьПолучениеОтветаОИСМ 	= Ложь;
	
	ДопПараметры = Новый Структура("УникальныйИдентификаторЗапроса,ИдентификаторУстройстваФР", УникальныйИдентификаторЗапроса, ИдентификаторУстройстваФР);
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаВыполнитьЗавершениеКМ", ЭтотОбъект, ДопПараметры);
	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьЗапросКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, ИдентификаторУстройстваФР, ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнитьЗавершениеКМ(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		ДопПараметры = Новый Структура("УникальныйИдентификаторЗапроса,ИдентификаторУстройстваФР", Параметры.УникальныйИдентификаторЗапроса, Параметры.ИдентификаторУстройстваФР);
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаЗавершениеПолучениеОтветаКМ", ЭтотОбъект, ДопПараметры);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПолученияРезультатовЗапросаКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, Параметры.ИдентификаторУстройстваФР, Неопределено);
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗавершениеПолучениеОтветаКМ(РезультатВыполнения, Параметры) Экспорт

	Если РезультатВыполнения.Результат Тогда
		ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыПодтверждениеКМ();
		ПараметрыОперации.ИдентификаторЗапроса 	= Параметры.УникальныйИдентификаторЗапроса;
		ПараметрыОперации.Выбытие				= Истина;
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаЗавершениеПодтвержденияКМ", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПодтверждениеКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, Параметры.ИдентификаторУстройстваФР, ПараметрыОперации);
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура КомандаЗавершениеПодтвержденияКМ(РезультатВыполнения, Параметры) Экспорт 
	
	Если НЕ РезультатВыполнения.Результат Тогда
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеДанныхДляЧекаККМ()

	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ЗаполнитьДанныеДляОтправкиЧека(НомерКассовогоЧека); 
	ОбновитьФормуSMSИEmail();
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьДанныеДляОтправкиЧека(НомерКассовогоЧека)
	
	Если Не ЗначениеЗаполнено(НомерКассовогоЧека) Тогда  
		Если ЗначениеЗаполнено(Объект.ФискальныйРегистратор) И ЗаполнятьПочтуИТелефонДляОтправкиЧека() Тогда 	
			АдресПочты 		= ПодключаемоеОборудованиеБГУВызовСервера.ПервыйАдресЭлектроннойПочтыПокупателя(Объект.Контрагент);
			НомерТелефона 	= ПодключаемоеОборудованиеБГУВызовСервера.ПервыйНомерТелефонаПокупателя(Объект.Контрагент);
			Если ЗначениеЗаполнено(АдресПочты) Тогда 
				АдресЭлектроннойПочты = АдресПочты;
				АбонентскийНомерТелефона = "";
				ТелефонСтрокой = "";
				ДанныеSMSИлиEmail = АдресЭлектроннойПочты;
				ОтказПокупателяОтСохраненияДанных = Истина;
			ИначеЕсли ЗначениеЗаполнено(НомерТелефона) Тогда 
				ТелефонSMS = 0;
				ПодключаемоеОборудованиеБГУКлиент.ПреобразоватьТелефонКПользовательсткомуВиду(НомерТелефона, ТелефонSMS, ТелефонСтрокой);
				АбонентскийНомерТелефона = "7" + Формат(НомерТелефона, "ЧЦ=10; ЧДЦ=; ЧГ=0");
				АдресЭлектроннойПочты = "";
				ДанныеSMSИлиEmail = ТелефонСтрокой;
				ОтказПокупателяОтСохраненияДанных = Истина;  
			Иначе
				АдресЭлектроннойПочты = "";
				АбонентскийНомерТелефона = "";
				ТелефонСтрокой = "";
				ДанныеSMSИлиEmail = "";
			КонецЕсли;  
			ЗаписатьДополнительныеДанныеЧековККМ();  
		Иначе
			АдресЭлектроннойПочты = "";
			АбонентскийНомерТелефона = "";
			ТелефонСтрокой = "";
			ДанныеSMSИлиEmail = "";	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнятьПочтуИТелефонДляОтправкиЧека()
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ФискальныйРегистратор, "ЗаполнятьПочтуИТелефонДляОтправкиЧека");
	
КонецФункции

&НаКлиенте
Процедура СтавкаНДССКомиссииБанкаПриИзменении(Элемент)
	
	ПересчитатьКомиссию(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура НДССКомиссииСверхуПриИзменении(Элемент)
	
	ПересчитатьКомиссию(ЭтаФорма);

КонецПроцедуры

#КонецОбласти


