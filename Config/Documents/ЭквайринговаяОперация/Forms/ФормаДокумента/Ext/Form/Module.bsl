
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Параметры.ЗначениеКопирования) И Не ЗначениеЗаполнено(Объект.ДокументОснование) И Не ЗначениеЗаполнено(Объект.ВидОперации) Тогда 
		Объект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой;
	КонецЕсли;	
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка,
		Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если Параметры.Свойство("ОтчетПоКассовойСмене") Тогда
					Элементы.ИсточникСредств.СписокВыбора.ЗагрузитьЗначения(ЭквайрингВызовСервера.ПолучитьМассивИсточниковСредств(Параметры.ПараметрыДоговораЭквайринга));
					ЗаполнитьНовуюЭквайринговуюОперацию(Параметры, Объект);
					УстановитьВидимостьЭлементовФормы();
		КонецЕсли;		

		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			Объект.НомерПервичногоДокумента = "";
			Объект.ДатаПервичногоДокумента = "";
			Объект.НомерЧекаККМ = 0;
			Объект.НомерЧекаЭТ = "";
			Объект.НомерСменыККМ = 0;
			Объект.ДатаЧекаККМ = "";
			Объект.СтатусЧекаККМ = "";
			Объект.ДокументыЧекаККМ.Очистить();
			
			Объект.НомерЧекаККМОтмены = "";
			Объект.ДатаЧекаККМОтмены = "";
			Объект.СтатусЧекаККМОтмены = "";
			Объект.ОтменаОплатыВыполнена = Ложь;
			Объект.ПробитЧекОтмены = Ложь;
		
			Объект.ОплатаВыполнена = Ложь;
			Объект.ПробитЧек = Ложь;
			
			Объект.ИсправительныйЧекККМ = "";
		Иначе	
			// Получим параметры эквайринга, установленные для этого рабочего места:
			// эквайринговый терминал и фискальный регистратор.
			РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
			НастройкиОборудования = ЭквайрингВызовСервера.ПолучитьНастройкиОборудованияЭквайринга(РабочееМесто, Объект.Организация);
			Объект.ЭквайринговыйТерминал = НастройкиОборудования.ЭТ;
			Объект.ФискальныйРегистратор = НастройкиОборудования.ФР;
			Объект.ПараметрыДоговораПлатежногоАгента = НастройкиОборудования.ПараметрыДоговораПлатежногоАгента;
			
			Если Объект.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкиОборудования.ПДЭ, "Организация") И Не ЗначениеЗаполнено(Объект.ПараметрыДоговораЭквайринга) Тогда
				// Если шаблон параметров договора и операций эквайринга, установленный для данного рабочего места,
				// предназначен для организации, указанной в документе, то применим эти параметры.
				Объект.ПараметрыДоговораЭквайринга = НастройкиОборудования.ПДЭ;
			КонецЕсли;
			
			ЭтоВозврат = ЗначениеЗаполнено(Объект.ДокументОснование);
			Если ЭтоВозврат И ТипЗнч(Объект.ДокументОснование) <> Тип("ДокументСсылка.АктОбОказанииУслуг") И ТипЗнч(Объект.ДокументОснование) <> Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
				ЗаполнитьЗначенияСвойств(Объект, Объект.ПараметрыДоговораЭквайринга,
					"Эквайер,ДоговорЭквайринга,СпособУчетаОбязательств,СпособОплатыУслугЭквайера");
				Объект.КорСчет = КорСчетПоУмолчанию(Объект.ВидОперации);
			Иначе
				ЗаполнитьРеквизитыПоПараметрам();
			КонецЕсли;
			
			Объект.КоличествоОпераций = 1;
			
		КонецЕсли;
		
		Если Параметры.Основание <> Неопределено И (ТипЗнч(Параметры.Основание) = Тип("ДокументСсылка.АктОбОказанииУслуг") ИЛИ ТипЗнч(Параметры.Основание) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")) Тогда 
			ВведенныеДокументыПКО 	= РозничныеПродажиБГУ.НайтиДокументыВведенныеНаОсновании(Параметры.Основание, "ПриходныйКассовыйОрдер");
			ВведенныеДокументыЭО	= РозничныеПродажиБГУ.НайтиДокументыВведенныеНаОсновании(Параметры.Основание, "ЭквайринговаяОперация");
			Если ВведенныеДокументыПКО.Количество() > 0 ИЛИ ВведенныеДокументыЭО.Количество() > 0 Тогда 
				ЕстьДокументОплаты = Истина;
			КонецЕсли;
		КонецЕсли;
		
		ПодготовитьФормуНаСервере();
		
	КонецЕсли;
	РасчетЗачетаАвансаПостоплаты();
	
	Если ЗначениеЗаполнено(Объект.ПараметрыДоговораЭквайринга) Тогда
		ЗаполнятьПервичныйДокументПриОплате = Объект.ПараметрыДоговораЭквайринга.ЗаполнятьПервичныйДокументПриОплате;
	КонецЕсли;	
	
	ИспользуетсяККТСПередачейДанных = ПодключаемоеОборудованиеБГУ.ИспользуетсяККТСПередачейДанных(Объект.ФискальныйРегистратор);
	УстановитьДанныеДляПечатиЧековККМ();
	ПрочитатьДополнительныеДанныеЧековККМ();
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	УстановитьВидимостьЭлементовФормы();
		
	Элементы.ИсточникСредств.СписокВыбора.ЗагрузитьЗначения(
		ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет));
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, ЭтаФорма.Элементы.ИнформационныеСсылки);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды  
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1Сдокументооборотом
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект,
		Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЭтоРозница(ТекущийОбъект.ВидОперации) Тогда
		ТекущийОбъект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		ТекущийОбъект.Договор    = Справочники.Договоры.ПустаяСсылка();
	Иначе
		ТекущийОбъект.КоличествоОпераций = 1;
	КонецЕсли;   
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1Сдокументооборотом
	
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	ПредставитьТелефонИEmailКлиент();
	ОбновитьФормуSMSИEmail();	
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Оповестить("ЭквайринговаяОперацияДляОтчетаПоКассовойСменеИзменение");
	КонецЕсли;
	
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	РасчетЗачетаАвансаПостоплаты();
	
	КонтрольСчетовФактурПриОтменеОперации();
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ДействияСКонтактнымиДаннымиДляЧекаККМ();
	
	ЗаполнитьДинамическиеРеквизитыФормы();
	
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, ТекущийОбъект);
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.ПодборДокументаОснованияЧекаККМ.Форма.Форма" Тогда
		ОбработкаДобавленияДокументовОснованийДляЧекаНаСервере(ВыбранноеЗначение);
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ПодборПлатежейПоГрафику" Тогда
		ОбработатьПодборПоГрафикуПлатежейНаСервере(ВыбранноеЗначение);
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если (ИмяСобытия = "ФискальныеОперацииБГУИзменение") Тогда
		УстановитьВидимостьЭлементовФормы();
		НомерКассовогоЧека  = НомерЧекаДляДокумента();
		ОбновитьДанныеЗаголовкаДанныеЧекаККМ(ЭтаФорма, НомерКассовогоЧека);
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(Неопределено, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТиповыхОпераций

&НаКлиенте
Процедура Подключаемый_ПриНачалеВыбораТиповойОперации(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	БухгалтерскиеОперацииКлиент.ПриНачалеВыбораТиповойОперации(Элемент, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииТиповойОперации(Элемент)
	
	ПодключаемыйСервер_ПриИзмененииТиповойОперации(Элемент.Родитель.Имя);
	
КонецПроцедуры

&НаСервере
Процедура ПодключаемыйСервер_ПриИзмененииТиповойОперации(ИмяЭлемента)

	БухгалтерскиеОперацииСервер.ПриИзмененииТиповойОперации(ЭтаФорма.Элементы[ИмяЭлемента]);	

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомандаОткрытьОперацию(Команда)

	БухгалтерскиеОперацииКлиент.КомандаОткрытьОперацию(Объект, Элементы.БухгалтерскаяОперация);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриНачалеВыбораДопРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	БухгалтерскиеОперацииКлиент.ДопРеквизитНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДопРеквизита(Элемент)

	БухгалтерскиеОперацииКлиент.ДопРеквизитИзменение(Элемент, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииРеквизитаДополнительнойТабличнойЧасти(Элемент)

	БухгалтерскиеОперацииКлиент.ПриИзмененииРеквизитаДополнительнойТабличнойЧасти(Элемент, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УправлениеТиповымиОперациями(Команда)

	БухгалтерскиеОперацииКлиент.КомандаУправлениеТиповымиОперациями(ЭтаФорма, Команда);	

КонецПроцедуры 

&НаКлиенте
Процедура ПриИзмененииКлючевогоРеквизитаТиповойОперации()
	БухгалтерскиеОперацииКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере()
	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		ДатаПриИзмененииНаСервере();
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
		УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтаФорма, Объект);
	УстановитьДоступностьДоговора(ЭтаФорма, Объект);
	УстановитьДоступностьДоговораЭквайринга(ЭтаФорма, Объект);
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	
	УстановитьВидимостьЭлементовФормы();
	
	УстановитьДанныеДляПечатиЧековККМ(Истина);
	
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура КОСГУНазначениеПлатежаПриИзменении(Элемент)
	
	КОСГУНазначениеПлатежаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура КОСГУНазначениеПлатежаПриИзмененииНаСервере()
	
	Если УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(Объект.КорСчет) Тогда
		УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(ЭтотОбъект,
			Объект.КОСГУНазначениеПлатежа, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО);
	КонецЕсли;
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементов(ЭтотОбъект, НомерКассовогоЧека);
	
КонецПроцедуры

&НаКлиенте
Процедура КорСчетПриИзменении(Элемент)
	
	КорСчетПриИзмененииНаСервере();
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	
КонецПроцедуры

&НаСервере
Процедура КорСчетПриИзмененииНаСервере()
	
	УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(ЭтотОбъект,
		Объект.КОСГУНазначениеПлатежа, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО);
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементов(ЭтотОбъект, НомерКассовогоЧека);
	УстановитьВидимостьЭлементовГрафикПлатежей();
	ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СпособПогашенияЗадолженностиПриИзменении(Элемент)
	
	НомерКассовогоЧека  = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементов(ЭтотОбъект, НомерКассовогоЧека);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетРасчетовПриИзменении(Элемент)
	
	СчетРасчетовПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СчетРасчетовПриИзмененииНаСервере()
	
	Объект.ДопСубконтоРасчетов = Неопределено;
	Объект.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
	
	УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(ЭтотОбъект,
		Объект.КОСГУНазначениеПлатежа, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО, Истина);
	
	Если НЕ ЗначениеЗаполнено(Объект.КОСГУНазначениеПлатежа) И ЗначениеЗаполнено(Объект.СчетРасчетов) Тогда
		Объект.КОСГУНазначениеПлатежа = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(Объект.СчетРасчетов);
	КонецЕсли;
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементов(ЭтотОбъект, НомерКассовогоЧека);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетРасчетовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПараметрыОтбора = УчетРасчетовКлиент.ПараметрыОтбораСчетаРасчетов(
		Объект, Объект.КОСГУНазначениеПлатежа, Объект.КорСчет, Объект.СчетРасчетов);
	УчетРасчетовКлиент.РасшифровкаПлатежаСчетРасчетовНачалоВыбора(ПараметрыОтбора,
		Элемент, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетРасчетовАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	ПараметрыОтбора = УчетРасчетовКлиент.ПараметрыОтбораСчетаРасчетов(
		Объект, Объект.КОСГУНазначениеПлатежа, Объект.КорСчет, Объект.СчетРасчетов);
	УчетРасчетовКлиент.РасшифровкаПлатежаСчетРасчетовАвтоПодбор(ПараметрыОтбора,
		Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетРасчетовОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	ПараметрыОтбора = УчетРасчетовКлиент.ПараметрыОтбораСчетаРасчетов(
		Объект, Объект.КОСГУНазначениеПлатежа, Объект.КорСчет, Объект.СчетРасчетов);
	УчетРасчетовКлиент.РасшифровкаПлатежаСчетРасчетовОкончаниеВводаТекста(ПараметрыОтбора,
		Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ДопСубконтоРасчетовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ДопСубконтоРасчетовВид) Тогда
		ПараметрыВыбораДопСубконто = Новый Структура;
		ПараметрыВыбораДопСубконто.Вставить("Организация",   Объект.Организация);
		ПараметрыВыбораДопСубконто.Вставить("Счет",          Объект.СчетРасчетов);
		ПараметрыВыбораДопСубконто.Вставить("НомерСубконто", ДопСубконтоРасчетовНомер);
		ПараметрыВыбораДопСубконто.Вставить("Субконто" + ДопСубконтоРасчетовНомер, Объект.ДопСубконтоРасчетов);
		БухгалтерскийУчетКлиент.ПриНачалеВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, ПараметрыВыбораДопСубконто);
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыДоговораЭквайрингаПриИзменении(Элемент)
	
	ЗаполнитьРеквизитыПоПараметрам();
	
	НомерКассовогоЧека = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементов(ЭтотОбъект, НомерКассовогоЧека);
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	Если НЕ ЭтоРозница(Объект.ВидОперации) Тогда
		Объект.КоличествоОпераций = 1;
	КонецЕсли;
	
	Если ЭтоРозница(Объект.ВидОперации) Тогда
		Объект.Контрагент = Неопределено;
		Объект.Договор = Неопределено;
		Объект.Основание = "";
	КонецЕсли;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой") Тогда
		Объект.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств");	
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЭквайринга.ВозвратОплатыПлатежнойКартой") Тогда
		Объект.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств");	
	Иначе
		Объект.ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПустаяСсылка");	
	КонецЕсли;	
	
	ВидОперацииПриИзмененииНаСервере();
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	
КонецПроцедуры

&НаСервере
Процедура ВидОперацииПриИзмененииНаСервере()
	
	Объект.КорСчет = КорСчетПоУмолчанию(Объект.ВидОперации);
	
	УчетРасчетов.ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(ЭтотОбъект,
		Объект.КОСГУНазначениеПлатежа, Объект.КорСчет, Объект.Дата, Объект.Организация, Объект.ИФО);
	
	НомерКассовогоЧека  = НомерЧекаДляДокумента();
	УстановитьВидимостьЭлементов(ЭтотОбъект, НомерКассовогоЧека);
	УстановитьВидимостьЭлементовГрафикПлатежей();
	ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	КонтрагентПриИзмененииНаСервере(); 
	
	ЗаполнениеДанныхДляЧекаККМ();
	
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	
	УстановитьДоступностьДоговора(ЭтотОбъект, Объект);
	
	УстановитьВидимостьЭлементовГрафикПлатежей();
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	ДоговорПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Договор)
	И НЕ ЗначениеЗаполнено(Объект.Основание)
	И НЕ ЭтоРозница(Объект.ВидОперации) Тогда
		Объект.Основание = ПолучитьПредставлениеДоговора(Объект.Договор);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ПризнакСпособаРасчетаДляДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ПризнакСпособаРасчета");
		Если ЗначениеЗаполнено(ПризнакСпособаРасчетаДляДоговора) Тогда
			ПризнакСпособаРасчетаПоУмолчанию = ПризнакСпособаРасчетаДляДоговора;
		КонецЕсли;	
	КонецЕсли;	
	
	УстановитьВидимостьЭлементовГрафикПлатежей();
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатитьДоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Отбор = Новый Структура("ВидРасчетов,КФО,КодЦели,КодМероприятия,ДопКлассификация");
	ЗаполнитьЗначенияСвойств(Отбор, Объект);
	Отбор.Вставить("ИФО", Объект.ИФО);
	Отбор.Вставить("Контрагент", Объект.Контрагент);
	Отбор.Вставить("Договор", Объект.Договор);
	Отбор.Вставить("Валюта", БухгалтерскийУчетВызовСервераПовтИсп.ВалютаРегламентированногоУчета());
	Отбор.Вставить("КПС", Объект.КБКНазначениеПлатежа);
	Отбор.Вставить("КЭК", Объект.КОСГУНазначениеПлатежа);
	Отбор.Вставить("ЭтоПоступление", Истина);
	
	СписокОчередныхПлатежей = СписокОчередныхПлатежейПоГрафику(Объект.Организация, Объект.Договор, Отбор);
	
	Элемент.СписокВыбора.Очистить();
	Для Каждого Платеж Из СписокОчередныхПлатежей Цикл
		Элемент.СписокВыбора.Добавить(Платеж.Значение, Платеж.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатитьДоОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОплатитьДоУстановитьПредставление(Элементы.ОплатитьДо, ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЭквайерПриИзменении(Элемент)
	
	УстановитьДоступностьДоговораЭквайринга(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПлатежнойКартыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ДанныеОВидеКартыИПроценте = ЭквайрингВызовСервера.ПолучитьДанныеВидаКартыДоговораЭквайринга(
		Объект.ПараметрыДоговораЭквайринга, ВыбранноеЗначение);
	Если ДанныеОВидеКартыИПроценте <> Неопределено Тогда
		Объект.ПроцентКомиссииБанка = ДанныеОВидеКартыИПроценте.ПроцентТорговойУступки;
		ПересчитатьКомиссию(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаДокументаПриИзменении(Элемент)
	
	ПересчитатьКомиссию(ЭтаФорма);
	ПересчитатьНДС();
	РасчетЗачетаАвансаПостоплаты();
	
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСПриИзменении(Элемент)
	
	ПересчитатьНДС();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПервичногоДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура();
	ОткрытьФорму("Справочник.ВидыПервичныхДокументов.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОплатаВыполненаНажатие(Элемент)
	
	ДанныеБанковскойОперации = Новый Структура;
	ДанныеБанковскойОперации.Вставить("НомерПлатежнойКарты",Объект.НомерПлатежнойКарты);
	ДанныеБанковскойОперации.Вставить("НомерЧекаЭТ",Объект.НомерЧекаЭТ);
	ДанныеБанковскойОперации.Вставить("СсылочныйНомер",Объект.СсылочныйНомер);
	ДанныеБанковскойОперации.Вставить("НомерЧекаККМ",Формат(Объект.НомерЧекаККМ,"ЧГ="));
	
	ДанныеБанковскойОперации.Вставить("ОперацияОтменена",Объект.ОтменаОплатыВыполнена);
	ДанныеБанковскойОперации.Вставить("НомерЧекаЭТОтмены",Объект.НомерЧекаЭТОтмены);
