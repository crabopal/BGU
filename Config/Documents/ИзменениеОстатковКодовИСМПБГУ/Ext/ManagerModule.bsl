#Область ПрограммныйИнтерфейс

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры
//  Ссылка  - ДокументСсылка.ТаксировкаПутевогоЛиста - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ДобавитьДвиженияОстаткиКодовИСМП(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры // ИнициализироватьДанныеДокумента()

Процедура ДобавитьДвиженияОстаткиКодовИСМП(ТаблицыДляДвижений, ДокументСсылка)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ИзменениеОстатковКодовИСМПКодыТоваров.Ссылка.Дата КАК Период,
	               |	ИзменениеОстатковКодовИСМПКодыТоваров.Ссылка КАК Регистратор,
	               |	ИзменениеОстатковКодовИСМПКодыТоваров.Ссылка.Организация КАК Организация,
	               |	ИзменениеОстатковКодовИСМПКодыТоваров.Номенклатура КАК Номенклатура,
	               |	ИзменениеОстатковКодовИСМПКодыТоваров.КодИСМП КАК КодИСМП,
	               |	СУММА(ИзменениеОстатковКодовИСМПКодыТоваров.Количество) КАК Количество
	               |ПОМЕСТИТЬ КодыТоваров
	               |ИЗ
	               |	Документ.ИзменениеОстатковКодовИСМПБГУ.КодыТоваров КАК ИзменениеОстатковКодовИСМПКодыТоваров
	               |ГДЕ
	               |	ИзменениеОстатковКодовИСМПКодыТоваров.Ссылка = &ДокументСсылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИзменениеОстатковКодовИСМПКодыТоваров.Ссылка,
	               |	ИзменениеОстатковКодовИСМПКодыТоваров.Номенклатура,
	               |	ИзменениеОстатковКодовИСМПКодыТоваров.КодИСМП,
	               |	ИзменениеОстатковКодовИСМПКодыТоваров.Ссылка.Дата,
	               |	ИзменениеОстатковКодовИСМПКодыТоваров.Ссылка.Организация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КодыТоваров.Период КАК Период,
	               |	КодыТоваров.Регистратор КАК Регистратор,
	               |	КодыТоваров.Организация КАК Организация,
	               |	КодыТоваров.Номенклатура КАК Номенклатура,
	               |	КодыТоваров.КодИСМП КАК КодИСМП,
	               |	КодыТоваров.Количество КАК Количество,
	               |	ВЫБОР
	               |		КОГДА КодыТоваров.Регистратор.ВидДвижения = 1
	               |			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	               |	КОНЕЦ КАК ВидДвижения
	               |ИЗ
	               |	КодыТоваров КАК КодыТоваров
	               |ГДЕ
	               |	КодыТоваров.КодИСМП <> """""; 
	
	ТаблицаДвиженийОстаткиКодовИСМП = Запрос.Выполнить().Выгрузить();   
	ТаблицыДляДвижений.Вставить("КодыИСМПБГУ", ТаблицаДвиженийОстаткиКодовИСМП);
		
КонецПроцедуры

