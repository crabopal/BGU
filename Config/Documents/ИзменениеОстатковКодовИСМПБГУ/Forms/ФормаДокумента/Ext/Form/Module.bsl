
&НаКлиенте
Процедура КодыТоваровКодИСМПНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.КодыТоваров.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда 
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораКода", ЭтотОбъект);
		Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Организация"		, Объект.Организация);
		ПараметрыФормы.Вставить("Номенклатура"		, ТекущиеДанные.Номенклатура);
		ПараметрыФормы.Вставить("ВыборПоДокументам"	, Истина);  
		ПараметрыФормы.Вставить("ДатаОстатков"		, Объект.Дата);
						
		ОткрытьФорму("ОбщаяФорма.ВыборКодаИСМПБГУ", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзДокументовПоступления(Команда)
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораДокументовПоступления", ЭтотОбъект);
	Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;  
	Отбор = Новый Структура("Организация", Объект.Организация);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор"				, Отбор);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	
	ОткрытьФорму("Документ.ЭлектронныйДокументПоставщика.ФормаВыбора", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораДокументовПоступления(РезультатОткрытияФормы, ПараметрыВыполнения) Экспорт
	
	ЗаполнитьТаблицуКодовПоДокументам(РезультатОткрытияФормы);	
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьТаблицуКодовПоДокументам(СписокДокументов)
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.НомерУпаковки КАК КодИСМП,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура КАК Номенклатура,
	               |	1 КАК Количество
	               |ИЗ
	               |	Документ.ЭлектронныйДокументПоставщика.КодыУпаковокМаркируемойПродукции КАК ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектронныйДокументПоставщика.СписокНоменклатуры КАК ЭлектронныйДокументПоставщикаСписокНоменклатуры
	               |		ПО ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.ИдентификаторСтроки = ЭлектронныйДокументПоставщикаСписокНоменклатуры.ИдентификаторСтроки
	               |			И ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.Ссылка = ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка
	               |ГДЕ
	               |	ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.Ссылка В(&СписокДокументов)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура,
	               |	ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.НомерУпаковки";	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаЗапроса Из РезультатЗапроса Цикл 
		ПараметрыСтроки	 			= ОбменИСМПБГУКлиентСервер.ПараметрыСтрокиИзКодаИСМП(СтрокаЗапроса.КодИСМП);
		СтрокаЗапроса.КодИСМП 		= ПараметрыСтроки.КодИСМП;
		СтрокаЗапроса.Количество 	= ПараметрыСтроки.Количество;  
		
		НоваяСтрока = Объект.КодыТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗапроса);
	КонецЦикла; 
	ТаблицаДляСвертки = Объект.КодыТоваров.Выгрузить();
	ТаблицаДляСвертки.Свернуть("КодИСМП, Номенклатура", "Количество");
	Объект.КодыТоваров.Загрузить(ТаблицаДляСвертки);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораКода(РезультатОткрытияФормы, ПараметрыВыполнения) Экспорт
	
	Если ЗначениеЗаполнено(РезультатОткрытияФормы) Тогда 
		 ТекущиеДанные 				= Элементы.КодыТоваров.ТекущиеДанные;
		 ТекущиеДанные.КодИСМП 		= РезультатОткрытияФормы[0].Код;     
	 КонецЕсли;		
	
 КонецПроцедуры

