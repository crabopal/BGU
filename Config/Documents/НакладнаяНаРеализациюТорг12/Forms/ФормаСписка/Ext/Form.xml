	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Ref</Field>
				<Field>Список.ОбщееСостояние</Field>
				<Field>Список.СостояниеОригиналаПервичногоДокумента</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументНакладнаяНаРеализациюТорг12.Ссылка,
	ДокументНакладнаяНаРеализациюТорг12.ВерсияДанных,
	ДокументНакладнаяНаРеализациюТорг12.ПометкаУдаления,
	ДокументНакладнаяНаРеализациюТорг12.Номер,
	ДокументНакладнаяНаРеализациюТорг12.Дата,
	ДокументНакладнаяНаРеализациюТорг12.Проведен,
	ДокументНакладнаяНаРеализациюТорг12.Организация,
	ДокументНакладнаяНаРеализациюТорг12.ИФО,
	ДокументНакладнаяНаРеализациюТорг12.Контрагент,
	ДокументНакладнаяНаРеализациюТорг12.Договор,
	ДокументНакладнаяНаРеализациюТорг12.Подразделение,
	ДокументНакладнаяНаРеализациюТорг12.ЦМО,
	ДокументНакладнаяНаРеализациюТорг12.Комментарий,
	ДокументНакладнаяНаРеализациюТорг12.КФО,
	ДокументНакладнаяНаРеализациюТорг12.ТипЦены,
	ДокументНакладнаяНаРеализациюТорг12.СуммаДокумента,
	ДокументНакладнаяНаРеализациюТорг12.СуммаВключаетНДС,
	ДокументНакладнаяНаРеализациюТорг12.ВалютаДокумента,
	ДокументНакладнаяНаРеализациюТорг12.Грузоотправитель,
	ДокументНакладнаяНаРеализациюТорг12.Грузополучатель,
	ДокументНакладнаяНаРеализациюТорг12.РеквизитыЛицевогоСчета,
	ДокументНакладнаяНаРеализациюТорг12.РасчетныйСчетКонтрагента,
	ДокументНакладнаяНаРеализациюТорг12.РасчетныйСчетГрузополучателя,
	ДокументНакладнаяНаРеализациюТорг12.РасчетныйСчетГрузоотправителя,
	ДокументНакладнаяНаРеализациюТорг12.ДокументОснование,
	СостоянияЭД.ПредставлениеСостояния КАК СостояниеЭДО,
	ОперацииДокументов.Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
	ДокументНакладнаяНаРеализациюТорг12.Ответственный,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	NULL КАК СостояниеОригиналаПервичногоДокумента,
	ИСТИНА КАК ОбщееСостояние,
	0 КАК СостояниеОригиналПолучен,
	ВЫБОР
        КОГДА НастройкиЭДО.Получатель = ДокументНакладнаяНаРеализациюТорг12.Контрагент
            ТОГДА ЗНАЧЕНИЕ(Перечисление.СпособыСоставленияДокумента.ВЭлектронномВиде)
        ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СпособыСоставленияДокумента.НаБумажномНосителе)
    КОНЕЦ КАК СпособСоставленияДокументаПоУмолчанию,
	ВЫБОР
        КОГДА НастройкиЭДО.Получатель = ДокументНакладнаяНаРеализациюТорг12.Контрагент
            ТОГДА 1
        ИНАЧЕ 0
