&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатуры(Номенклатура, ТипЦены, Дата, Организация)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И Номенклатура = &Номенклатура
	|				И ТипЦен = &ТипЦены) КАК ЦеныНоменклатурыСрезПоследних";
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура = &Номенклатура", "Номенклатура В (&Номенклатура)");
	КонецЕсли;
	Запрос.УстановитьПараметр("Номенклатура",	Номенклатура);
	Запрос.УстановитьПараметр("ТипЦены",		ТипЦены);
	Запрос.УстановитьПараметр("Период",			Дата);
	Запрос.УстановитьПараметр("Организация",	Организация);
	Результат = Запрос.Выполнить();
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Возврат Результат.Выгрузить();
	Иначе
		Если Результат.Пустой() Тогда
			Возврат 0;
		КонецЕсли;
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Цена;
	КонецЕсли;

КонецФункции // ПолучитьЦенуНоменклатуры()

&НаСервере
Процедура ПересчитатьЦеныНоменклатуры()

	МассивНоменклатуры = Объект.Номенклатура.Выгрузить(, "Номенклатура");
	ТаблицаЦен = ПолучитьЦенуНоменклатуры(МассивНоменклатуры.ВыгрузитьКолонку("Номенклатура"),
		Объект.ТипЦены, Объект.Дата, Объект.Организация);
	
	Для каждого ТекСтрока Из Объект.Номенклатура Цикл
	
		СтрокаЦены = ТаблицаЦен.Найти(ТекСтрока.Номенклатура, "Номенклатура");
		Если СтрокаЦены<>Неопределено Тогда
			ТекСтрока.Цена = СтрокаЦены.Цена;
		Иначе
			ТекСтрока.Цена = 0;
		КонецЕсли;
		РасчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена");
	
	КонецЦикла;

КонецПроцедуры // ПересчитатьЦеныНоменклатуры()

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение,ИмяТаблицы)
	СписокПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	
	СчетТоваровНаКомиссии = БухгалтерскийУчет.СчетПоКоду("02.33",Объект.Дата,Объект.Организация);
	
	Для Каждого ЭлементПодбора Из СписокПодбора Цикл
		
		НоваяСтрока = Объект[ИмяТаблицы].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементПодбора);
		
		Если ИмяТаблицы = "Номенклатура" Тогда
			Если Объект.РеализацияПоСтавке0 Тогда
				НоваяСтрока.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0");	
			КонецЕсли;
			РасчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "Сумма");
		КонецЕсли;
		
		ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, НоваяСтрока, Ложь);
		
		Если ЗначениеЗаполнено(ЭлементПодбора.СчетУчета) И ИмяТаблицы = "Номенклатура" Тогда
			Если ЭлементПодбора.СчетУчета = СчетТоваровНаКомиссии Тогда
				НоваяСтрока.КомиссионнаяТорговля = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеСчетаВСтроке(Форма, Строка, ЗаполнятьСчет)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Форма, Строка);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет", ЗаполнятьСчет);
	ПараметрыОбработки.Вставить("ДтКт",          "Кт");
	ПараметрыОбработки.Вставить("Включать113", Истина);
	ПараметрыОбработки.Вставить("Включать0233", Истина);
	
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
	
