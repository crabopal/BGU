&НаКлиенте
Процедура ЗаполнитьСведенияОСУПоСтроке()

	ТекущиеДанные = Элементы.НоменклатураОбъемноСортовогоУчетаМаркированныхТоваров.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.КодGTIN) Тогда 
		ТекущиеДанные.СведенияОбъемноСортовогоУчетаМаркированныхТоваров = СтрШаблон(НСтр("ru='02(%1)37(%2)'"),
				ТекущиеДанные.КодGTIN, Формат(ТекущиеДанные.Количество,"ЧГ="));
		Иначе
			ТекущиеДанные.СведенияОбъемноСортовогоУчетаМаркированныхТоваров = "";
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
 Процедура ОповещениеОткрытьФормуВыбораКода(РезультатОткрытияФормы, ПараметрыВыполнения) Экспорт
	 
	 Если ЗначениеЗаполнено(РезультатОткрытияФормы) Тогда 
		 ТекущиеДанные 				= Элементы.НоменклатураОбъемноСортовогоУчетаМаркированныхТоваров.ТекущиеДанные;
		 ТекущиеДанные.КодGTIN 		= РезультатОткрытияФормы[0].Код; 
		 ЗаполнитьСведенияОСУПоСтроке();
	 КонецЕсли;	
	 
 КонецПроцедуры

&НаКлиенте
Процедура НоменклатураДополнительнаяАналитикаСчетаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Номенклатура.ТекущиеДанные;
	Если ТекущиеДанные.СчетУчета = БухгалтерскийУчетВызовСервера.СчетПоКоду("02.33") Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("СчетДт", ТекущиеДанные.СчетУчета);
		ПараметрыФормы.Вставить("Организация", Объект.Организация);
		ПараметрыФормы.Вставить("Дата", Объект.Дата);
		ПараметрыФормы.Вставить("ИФО", Объект.ИФО);
		ПараметрыФормы.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
		ОткрытьФорму("Документ.ПоступлениеМЗ.ФормаВыбора", ПараметрыФормы, Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПризнакКомиссионногоТовараНоменклатуры(ЭтотОбъект, ТекущиеДанные)
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.СчетУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.СчетУчета = ЭтотОбъект.КэшПараметров.Локальные.Счет0233 Тогда
		ТекущиеДанные.КомиссионнаяТорговля = Истина;
	Иначе
		ТекущиеДанные.КомиссионнаяТорговля = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСчетаВЛокальныйКэшФормы()
	
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСчетов = Объект.Дата;
	Иначе
		ДатаСчетов = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет0233", БухгалтерскийУчет.СчетПоКоду("02.33", ДатаСчетов, Объект.Организация));
	
КонецПроцедуры

