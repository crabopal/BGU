#Область МаркировкаПродукции

&НаСервере
Функция МаркируемыйТовар(ИдентификаторНоменклатуры)
	
	МассивНоменклатуры = Новый Массив;
	МассивНоменклатуры.Добавить(Объект.Номенклатура.НайтиПоИдентификатору(ИдентификаторНоменклатуры).Номенклатура);
	СписокМаркируемыхТоваров = ЭлектронныеДокументыБГУ.ПолучитьМаркируемыеТовары(МассивНоменклатуры);
	Если СписокМаркируемыхТоваров.Количество() = 0 Тогда 
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	

КонецФункции	

Функция МаркируемыйТоварОбъемноСортовогоУчета(ИдентификаторНоменклатуры)
	
	МассивНоменклатуры = Новый Массив;
	МассивНоменклатуры.Добавить(Объект.Номенклатура.НайтиПоИдентификатору(ИдентификаторНоменклатуры).Номенклатура);
	СписокМаркируемыхТоваров = ЭлектронныеДокументыБГУ.ПолучитьМаркируемыеТоварыОбъемноСортовогоУчета(МассивНоменклатуры);
	Если СписокМаркируемыхТоваров.Количество() = 0 Тогда 
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	

КонецФункции	


#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовПрослеживаемости(Форма)

	ИменаЭлементовПрослеживаемости = Новый Массив;
	ИменаЭлементовПрослеживаемости.Добавить("НоменклатураПрослеживаемыйТовар");
	ИменаЭлементовПрослеживаемости.Добавить("НоменклатураСтранаПроисхождения");
	ИменаЭлементовПрослеживаемости.Добавить("НоменклатураРНПТ");
	//ИменаЭлементовПрослеживаемости.Добавить("ГруппаУведомлениеОПеремещении");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементовПрослеживаемости,
		"Видимость", Форма.ВедетсяУчетПрослеживаемыхТоваров);

КонецПроцедуры

&НаКлиенте
Процедура НоменклатураРНПТНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПрослеживаемостьФормыБГУКлиент.ОткрытьФормуПодбораРНПТ(ЭтотОбъект, "Номенклатура");
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураРНПТОчистка(Элемент, СтандартнаяОбработка)
	СтрокаТабличнойЧасти = Элементы.Номенклатура.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если СтрокаТабличнойЧасти.ПрослеживаемыйТовар Тогда
		УдалитьСтрокиРНПТ(СтрокаТабличнойЧасти.ИдентификаторСтроки);
	Иначе
		СтрокаТабличнойЧасти.НомерГТД = Неопределено;
	КонецЕсли;
	
	ПрослеживаемостьФормыБГУКлиентСервер.ОчиститьПредставлениеРНПТ(ЭтотОбъект, СтрокаТабличнойЧасти);
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиРНПТ(Знач ИдентификаторСтроки)
	СтрокиСРНПТ = Объект.СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	
	Для Каждого СтрокаСРНПТ Из СтрокиСРНПТ Цикл
		Объект.СведенияПрослеживаемости.Удалить(СтрокаСРНПТ);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьРНПТВХранилище(Адрес, ДополнительныеПараметры) Экспорт
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ПоместитьРНПТВХранилищеНаСервере(Адрес, ДополнительныеПараметры.ИдентификаторСтроки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПоместитьРНПТВХранилищеНаСервере(Адрес, ИдентификаторСтроки)

	ТаблицаРНПТ = Объект.СведенияПрослеживаемости.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	ПоместитьВоВременноеХранилище(ТаблицаРНПТ, Адрес);

КонецПроцедуры
&НаКлиенте
Процедура ОбработкаВыбораРНПТННаКлиенте(ВыбранноеЗначение)
	
	СтрокаТабличнойЧасти = Элементы.Номенклатура.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
		СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	Если ЗначениеЗаполнено(ВыбранноеЗначение.ВариантКомплектаПТ) Тогда
		СтрокаТабличнойЧасти.ВариантКомплектаПТ = ВыбранноеЗначение.ВариантКомплектаПТ;
	КонецЕсли;
	ОбработкаВыбораРНПТННаСервере(СтрокаТабличнойЧасти.ИдентификаторСтроки, ВыбранноеЗначение, СтрокаТабличнойЧасти.ПолучитьИдентификатор());
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораРНПТННаСервере(Знач ИдентификаторСтроки, Знач ВыбранноеЗначение, Знач ИдентификаторСтрокиВнутр)
	
	СтрокаТабличнойЧасти = Объект.Номенклатура.НайтиПоИдентификатору(ИдентификаторСтрокиВнутр);
	ПрослеживаемостьФормыБГУ.ОбработкаВыбораРНПТН(ЭтотОбъект, ИдентификаторСтроки, ВыбранноеЗначение);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТ(ЭтаФорма, СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	УправлениеМатериальнымиЗапасами.УстановитьУсловноеОформлениеСпискаМатериалов(ЭтотОбъект, "Номенклатура", Истина);
	УправлениеМатериальнымиЗапасами.УстановитьУсловноеОформлениеСпискаМатериалов(ЭтотОбъект, "ВозвратнаяТара", Истина);
	УправлениеМатериальнымиЗапасами.УстановитьУсловноеОформлениеПоляСтавкаНДС(ЭтотОбъект, "Номенклатура");
	ПрослеживаемостьФормыБГУ.УстановитьУсловноеОформление(ЭтотОбъект);

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НоменклатураМаркируемыеУпаковки");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Номенклатура.МаркируемыеУпаковки", ВидСравненияКомпоновкиДанных.Равно, "");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Номенклатура.МаркируемыйТовар", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<...>");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НоменклатураМаркируемыеУпаковки");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Номенклатура.МаркируемыеУпаковки", ВидСравненияКомпоновкиДанных.Равно, "");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Номенклатура.МаркируемыйТовар", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "Не используется");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НапоминатьОбУведомленииОПеремещении()
	РассчитатьНеобходимостьНапоминанияОПеремещении();
КонецПроцедуры

&НаСервере
Процедура РассчитатьНеобходимостьНапоминанияОПеремещении()
	
	ТребуетсяНапоминаниеДо = ТребуетсяНапоминаниеУведомленийОПеремещении;
	ПоказыватьБаннерДо     = ПоказыватьБаннерУведомленийОПеремещении;
	
	ТребуетсяНапоминаниеУведомленийОПеремещении = ТребуетсяНапоминаниеОбУведомленииОПеремещении();
	ПоказыватьБаннерУведомленийОПеремещении     = ТребуетсяНапоминаниеУведомленийОПеремещении 
							И НЕ ЗначениеЗаполнено(УведомлениеОПеремещении) 
							И НЕ ОтключитьБаннерУведомленийОПеремещении
							И НЕ Объект.ПометкаУдаления;
	Если ПоказыватьБаннерУведомленийОПеремещении Тогда
		СрокУведомленияОПеремещении = ПрослеживаемостьБГУ.СрокПодачиУведомления(Объект.Дата);
	КонецЕсли;
	
	Если ОбновитьСрокОтправкиУведомлений
		ИЛИ ТребуетсяНапоминаниеДо <> ТребуетсяНапоминаниеУведомленийОПеремещении
		ИЛИ ПоказыватьБаннерДо <> ПоказыватьБаннерУведомленийОПеремещении Тогда
		
		НапоминатьОбУведомленияхОПеремещении();
		ОбновитьСрокОтправкиУведомлений = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_Прослеживаемость(Форма)

	Элементы = Форма.Элементы;
	
	ВидимостьОсновныхЭлементов = Форма.ВедетсяУчетПрослеживаемыхТоваров И Форма.ЕстьПрослеживаемыеТовары;
	ИменаЭлементовПрослеживаемости = Новый Массив;
	ИменаЭлементовПрослеживаемости.Добавить("НоменклатураСтранаПроисхождения");
	ИменаЭлементовПрослеживаемости.Добавить("НоменклатураПрослеживаемыйТовар");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовПрослеживаемости,
		"Видимость", ВидимостьОсновныхЭлементов);
	
	ВидимостьРНПТ = ВидимостьОсновныхЭлементов И НЕ Форма.РеализацияВЕАЭС;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НоменклатураРНПТ",
		"Видимость", ВидимостьРНПТ);
	
	ВидимостьУведомленияОВвозе = ВидимостьОсновныхЭлементов И Форма.РеализацияВЕАЭС;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьУведомлениеОПеремещении",
		"Видимость", ВидимостьУведомленияОВвозе);

КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеНадписиУведомлениеОПеремещении()
	
	ПрослеживаемостьФормыБГУ.УстановитьПредставлениеНадписиУведомлениеОПеремещении(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Функция ТребуетсяНапоминаниеОбУведомленииОПеремещении()
	
	ПрослеживаемыеТовары = Объект.Номенклатура.НайтиСтроки(Новый Структура("ПрослеживаемыйТовар", Истина));
	
	ЕстьПрослеживаемыеТовары = ПрослеживаемыеТовары.Количество() > 0;
	
	Возврат ЕстьПрослеживаемыеТовары И РеализацияВЕАЭС;
	
КонецФункции

&НаСервере
Процедура НапоминатьОбУведомленияхОПеремещении()
	
	Элементы.ГруппаУведомлениеОПеремещении.Видимость = ТребуетсяНапоминаниеУведомленийОПеремещении;
	Если ПоказыватьБаннерУведомленийОПеремещении Тогда
		// Дата отсчета срока - 5 дней со дня продажи товара.
		СрокУведомления = ПрослеживаемостьБГУ.СрокПодачиУведомления(Объект.Дата);
		
		ШаблонТекста = НСтр("ru = 'В документе присутствуют прослеживаемые товары. До %1 необходимо создать уведомление о перемещении в ЕАЭС и отправить в ФНС.'");
		Элементы.ДекорацияУведомление.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонТекста, Формат(СрокУведомления, "ДФ='дд ММММ'"));
		Элементы.ГруппаБаннерУведомлениеОПеремещении.Видимость = Истина;
	Иначе
		Элементы.ГруппаБаннерУведомлениеОПеремещении.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияИВидимостьРеквизитовПрослеживаемости()

	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУКлиентСервер.ВедетсяУчетПрослеживаемыхТоваров(
		?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ОбщегоНазначения.ТекущаяДатаПользователя()));
	УстановитьВидимостьЭлементовПрослеживаемости(ЭтотОбъект);
	ПрослеживаемостьБГУ.ОбновитьПризнакПрослеживаемости(Объект, Объект.Номенклатура, ВедетсяУчетПрослеживаемыхТоваров);
	РассчитатьНеобходимостьНапоминанияОПеремещении();

КонецПроцедуры
 
&НаКлиенте
Процедура ОбновитьДанныеКорректировки()

	ОбновитьДанныеКорректировкиСервер();

КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеКорректировкиСервер()

	УправлениеМатериальнымиЗапасами.УстановитьКорректирующийДокумент(ЭтотОбъект);
	УправлениеМатериальнымиЗапасамиФормыКлиентСервер.УстановитьСвойстваЭлементовГруппыКорректировка(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоКонтрактуНаСервере()
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	ЭлектронноеАктированиеБГУ.ЗаполнитьПоКонтрактуНаСервере(ЭтотОбъект);
	ЭлектронноеАктированиеБГУ.ЗаполнитьСлужебныеДанныеЕИС(ЭтотОбъект, "Номенклатура", "Номенклатура");
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	ЭлектронныеДокументыБГУ.ЗаполнитьРеквизитыМаркировки(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоКонтрактуПослеВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоКонтрактуНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияОбъемноСортовогоУчетаМаркированныхТоваровНаСервере()
	ВидыМаркировкиОбъемноСортовогоУчета = ЭлектронныеДокументыБГУ.ВидыМаркировкиОбъемноСортовогоУчета();
	
	Для Каждого ТекСтрока Из Объект.Материалы Цикл
		ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.Номенклатура, "ВидМаркируемойПродукции");
		КодGTIN = ТекСтрока.КодGTIN;
		ВидМаркируемойПродукции = ДанныеНоменклатуры.ВидМаркируемойПродукции;
		
		Если НЕ ВидыМаркировкиОбъемноСортовогоУчета.Найти(ВидМаркируемойПродукции) = Неопределено И ЗначениеЗаполнено(КодGTIN) Тогда
			ТекСтрока.СведенияОбъемноСортовогоУчетаМаркированныхТоваров = СтрШаблон(НСтр("ru='02(%1)37(%2)'"),
				КодGTIN, Формат(ТекСтрока.Количество,"ЧГ="));
		Иначе
			ТекСтрока.СведенияОбъемноСортовогоУчетаМаркированныхТоваров = "";	
		КонецЕсли;		
	КонецЦикла;		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПризнакиОбъемноСортовогоУчетаМаркированныхТоваровНаСервере()
	ВидыМаркировкиОбъемноСортовогоУчета = ЭлектронныеДокументыБГУ.ВидыМаркировкиОбъемноСортовогоУчета();
	Для Каждого ТекСтрока Из Объект.Номенклатура Цикл
		ТекСтрока.МаркируемыйТоварОбъемноСортовогоУчета = ЭлектронныеДокументыБГУВызовСервера.ЭтоМаркируемыйТоварОбъемноСортовогоУчета(ТекСтрока.Номенклатура);
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроДопСведенияДляЭлектронногоУПД(КлючевойДопРеквизит = Неопределено)
	ЭлектронныеДокументыБГУ.ЗаполнитьТекстПроДопСведенияДляЭлектронногоУПД(ЭтотОбъект, КлючевойДопРеквизит);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборСведенийЭлектронногоУПДПоставщика(ДанныеДляУПД)
 	
	Объект.РеквизитыЛицевогоСчета = ДанныеДляУПД.РеквизитыЛицевогоСчета;
	Объект.РасчетныйСчетКонтрагента = ДанныеДляУПД.РасчетныйСчетКонтрагента;
	Объект.Грузоотправитель = ДанныеДляУПД.Грузоотправитель;
	Объект.Грузополучатель = ДанныеДляУПД.Грузополучатель;
	Объект.РасчетныйСчетГрузоотправителя = ДанныеДляУПД.РасчетныйСчетГрузоотправителя;
	Объект.РасчетныйСчетГрузополучателя = ДанныеДляУПД.РасчетныйСчетГрузополучателя;
	
	Объект.КПСПродавца = ДанныеДляУПД.КПСПродавца;
	Объект.КодЦелиПродавца = ДанныеДляУПД.КодЦелиПродавца;

	Объект.СведенияОВыбытииМаркированныхТоваров = ДанныеДляУПД.СведенияОВыбытииМаркированныхТоваров;

	Объект.ТРУПереданы = ДанныеДляУПД.ТРУПереданы;
	Объект.ДатаПередачиТРУ = ДанныеДляУПД.ДатаПередачиТРУ;
	Объект.ОтветственныйПередалТРУ = ДанныеДляУПД.ОтветственныйПередалТРУ;
	Объект.ОтветственныйПередалТРУВид = ДанныеДляУПД.ОтветственныйПередалТРУВид;
	Объект.ОтветственныйПередалТРУДоверенность = ДанныеДляУПД.ОтветственныйПередалТРУДоверенность;
	Объект.ОтветственныйПередалТРУДолжность = ДанныеДляУПД.ОтветственныйПередалТРУДолжность;
	Объект.ОтветственныйПередалТРУИныеСведения = ДанныеДляУПД.ОтветственныйПередалТРУИныеСведения;
	Объект.ОтветственныйПередалТРУКонтрагент = ДанныеДляУПД.ОтветственныйПередалТРУКонтрагент;
	Объект.ОтветственныйПередалТРУОснованиеПолномочий = ДанныеДляУПД.ОтветственныйПередалТРУОснованиеПолномочий;
	Объект.ОтветственныйПередалТРУДокументПолномочий = ДанныеДляУПД.ОтветственныйПередалТРУДокументПолномочий;
	Объект.ИдентификаторФИАС = ДанныеДляУПД.ИдентификаторФИАС;

	ЗаполнитьТекстПроДопСведенияДляЭлектронногоУПД(ДанныеДляУПД.РеквизитыЛицевогоСчета);
	
КонецПроцедуры	

&НаСервере
Функция НовыеПараметрыДополнительныхСведенийУПД()
	Возврат ЭлектронныеДокументыБГУ.НовыеПараметрыДополнительныхСведенийУПД();
КонецФункции

&НаСервере
Процедура ЗаполнитьСведенияОПриемкеПередачеПоставщикаДляУПД()
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Возврат;	
	КонецЕсли;
	
	ЛицевойСчетОрганизиции = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация,
			"Документ.ЗаявкаНаВозврат", Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
	Если ЗначениеЗаполнено(ЛицевойСчетОрганизиции.РеквизитыЛицевогоСчета) Тогда
		Объект.РеквизитыЛицевогоСчета = ЛицевойСчетОрганизиции.РеквизитыЛицевогоСчета;
	КонецЕсли;
	
	Если ЭлектронныеДокументыБГУ.УПДЗаполнятьДатуПередачиПоДатеДокументаРеализации(Объект.Организация) Тогда
		
		Объект.ДатаПередачиТРУ = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
		Объект.ТРУПереданы = Истина;
		
	КонецЕсли;  
	
	СведенияПоОтветственному = ЭлектронныеДокументыБГУ.ПолучитьСведенияОтветственныхЭлектронныУПД(Объект.Организация);
	
	Если ЗначениеЗаполнено(СведенияПоОтветственному) Тогда
		
		Объект.ОтветственныйПередалТРУ 						= СведенияПоОтветственному.ОтветственныйПередалТРУ;	
		Объект.ОтветственныйПередалТРУВид 					= СведенияПоОтветственному.ОтветственныйПередалТРУВид;
		Объект.ОтветственныйПередалТРУДоверенность 			= СведенияПоОтветственному.ОтветственныйПередалТРУДоверенность;
		Объект.ОтветственныйПередалТРУДолжность 			= СведенияПоОтветственному.ОтветственныйПередалТРУДолжность;
		Объект.ОтветственныйПередалТРУИныеСведения 			= СведенияПоОтветственному.ОтветственныйПередалТРУИныеСведения;
		Объект.ОтветственныйПередалТРУКонтрагент 			= СведенияПоОтветственному.ОтветственныйПередалТРУКонтрагент;
		Объект.ОтветственныйПередалТРУДокументПолномочий 	= СведенияПоОтветственному.ОтветственныйПередалТРУДокументПолномочий;
		Объект.ОтветственныйПередалТРУОснованиеПолномочий 	= ""; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.РеквизитыЛицевогоСчета) Тогда
		ЗаполнитьТекстПроДопСведенияДляЭлектронногоУПД(Объект.РеквизитыЛицевогоСчета);
	КонецЕсли;
	
КонецПроцедуры

