&НаКлиенте
Процедура ЗаполнитьТекстПроСчетФактуруКлиент(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения)
	
	Перем ЗначениеСвойства;
	
	ЭтотДокументЯвляетсяОснованием = (ТипЗнч(ПараметрОбработкиОповещения) = Тип("Структура")
		И ПараметрОбработкиОповещения.Свойство("ДокументыОснования", ЗначениеСвойства)
		И ЗначениеСвойства.Найти(Объект.Ссылка) <> Неопределено);
	
	Если ЭтотДокументЯвляетсяОснованием Тогда
		ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено)
	
	УчетНДС.ЗаполнитьТекстПроСчетФактуру(ЭтаФорма, ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКПСнаСервере(Знач ИмяТаблицы)

	УправлениеМатериальнымиЗапасами.ЗаполнитьКПСвТабличнойЧастиДокументаМЗ(Объект[ИмяТаблицы], Объект);

КонецПроцедуры

#Область УчетДрагМатериалов

&НаСервере
Функция СтруктураПараметровПолученияОстатков()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Ссылка",Объект.Ссылка);
	СтруктураПараметров.Вставить("Период",Объект.Дата);
	
	Если Объект.Ссылка.Пустая() Тогда
		СтруктураПараметров.Период = КонецДня(Объект.Дата);
	Иначе
		СтруктураПараметров.Период = Объект.Дата;
	КонецЕсли;
	
	Возврат СтруктураПараметров;
	
КонецФункции
	
&НаСервере
Процедура ЗаполнитьСписокДМДляСписанияНаСервере()
	ПараметрыПолученияОстатков = СтруктураПараметровПолученияОстатков();
	
	Если НЕ ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;

	ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков);

	УчетДрагМатериалов.ЗаполнитьИсточникиОбразованияЛомаОтходовДрагМатериалов(Объект.Организация, Объект.ДрагоценныеМатериалы, Объект.Дата);
	
КонецПроцедуры	
	
&НаСервере
Функция ПолучитьТаблицуОСДляДМ()
	
	ТЧ = Объект.Номенклатура.Выгрузить();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаОбъектовНФА.Номенклатура,
			|	ТаблицаОбъектовНФА.Количество КАК Количество
			|ПОМЕСТИТЬ СписокНФАСписания
			|ИЗ
			|	&ТаблицаОбъектовНФА КАК ТаблицаОбъектовНФА
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СписокНФАСписания.Номенклатура КАК ОбъектНФА,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
			|	СписокНФАСписания.Количество
			|ИЗ
			|	СписокНФАСписания КАК СписокНФАСписания";
			
	Запрос.УстановитьПараметр("ТаблицаОбъектовНФА", ТЧ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
КонецФункции	

&НаСервере
Процедура ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков)
	ТаблицаСписанияОбъектов = ПолучитьТаблицуОСДляДМ();
	
	ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияМЗ(
		Объект.Организация, ТаблицаСписанияОбъектов, ПериодОстатков);
	
	Объект.ДрагоценныеМатериалы.Загрузить(ОстаткиДМ);
	
	Для Каждого ТекСтрока Из Объект.Номенклатура Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОбъектНФА", ТекСтрока.Номенклатура);
		НайденныеСтроки = ОстаткиДМ.НайтиСтроки(ПараметрыОтбора);
		Если ТипЗнч(НайденныеСтроки) = Тип("Массив") Тогда
			Для Каждого ТекСтрокаМассива Из НайденныеСтроки Цикл
				ТекСтрока.КоличествоВсегоДМ = ТекСтрокаМассива.КоличествоВсего; 
				Прервать;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	Для каждого ТекСтрока Из Объект.ДрагоценныеМатериалы Цикл
		ТекСтрока.КлючСтроки = УчетДрагМатериаловКлиент.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, "");
	КонецЦикла;
	
КонецПроцедуры
	
&НаСервере
Процедура ЗаполнитьОбъектыСДрагМатериалами()
	ТаблицаВсехОбъектов = Объект.Номенклатура.Выгрузить(,"Номенклатура, Количество, КоличествоВсегоДМ");
	
	ТаблицаОбъектовМЗ = Новый ТаблицаЗначений;
	ТаблицаОбъектовМЗ.Колонки.Добавить("КлючСтроки",Новый ОписаниеТипов("Строка"));
	ТаблицаОбъектовМЗ.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаОбъектовМЗ.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
	ТаблицаОбъектовМЗ.Колонки.Добавить("КоличествоВсегоДМ",Новый ОписаниеТипов("Число"));
	
	НеСодержатДрагМатериалы = УчетДрагМатериалов.ПолучитьМассивТиповНоменклатурыБезДрагМатериалов();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			Если НеСодержатДрагМатериалы.Найти(ТекСтрока.Номенклатура.ТипНоменклатуры) = Неопределено Тогда
				НоваяСтрока = ТаблицаОбъектовМЗ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				НоваяСтрока.КлючСтроки = УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.Номенклатура, "");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	ОбъектыНФАСДрагМатериалами.Загрузить(ТаблицаОбъектовМЗ);
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьВидимостьДанныхДрагМатериалов()
	Если ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Истина;
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
		
		Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные <> Неопределено Тогда
			ОтборДрагМатериаловДляОбъекта(Элементы.СписокНФАДокументаОснования.ТекущиеДанные.КлючСтроки);
		КонецЕсли;
	Иначе
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
		Элементы.ДрагоценныеМатериалы.ОтборСтрок = Неопределено;
	КонецЕсли;	
	
	//Заголовки
	РеквизитыДрагМатериалы = Новый Массив;
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМЗаголовок");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоЗаголовок");
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМ");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличество");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма.Элементы,
		РеквизитыДрагМатериалы, "Видимость", Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОбъектовДрагМатериалов(ТекущаяСтрока)

	ТекущаяСтрока.КоличествоВсегоДМЗаголовок = НСтр("ru = 'Всего:'");
	ТекущаяСтрока.КоличествоЗаголовок = НСтр("ru = 'Списать:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(Форма)
	
	Для каждого ТекущаяСтрока Из Форма.ОбъектыНФАСДрагМатериалами Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОбъектовДрагМатериалов(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДрагМатериаловДляОбъекта(КлючСтроки)
	
	Элементы.ДрагоценныеМатериалы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки",КлючСтроки));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючиСтрокДрагМатериалов()
	Если ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОДрагМатериалах(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Параметры.НайденныеСтроки Цикл
		Объект.ДрагоценныеМатериалы.Удалить(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьСтрокиТаблицыДрагМатериаловПриАктивизацииОбъектаНФА()
	Элемент = Элементы.СписокНФАДокументаОснования;
	ОтборДрагМатериаловДляОбъекта(Элемент.ТекущиеДанные.КлючСтроки);
КонецПроцедуры	

#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)

	Объект = Форма.Объект;
	
	ПараметрыПредставления = Новый Структура("ТипЦены, ВалютаДокумента, СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(ПараметрыПредставления, Объект);
	ПараметрыПредставления.Вставить("ПоказыватьТипЦены", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьНДС", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьВалюту", Форма.КэшПараметров.ИспользоватьВалютныйУчет);
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЧековККМ(Форма, ВидимостьЭлементовЧековККМ)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОплатаВстречнымПредоставлением", "Видимость", ВидимостьЭлементовЧековККМ);
		
КонецПроцедуры

#Область ЭДОСКонтрагентами

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДО(Форма, ВидимостьЭлементовЭДО, ВидимостьЭлементовМаркировки, ВидимостьДанныхПродавца = Ложь, ВидимостьЭлементовАктирования = Ложь)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияСостояниеЭДО", "Видимость", ВидимостьЭлементовЭДО);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"НоменклатураМаркируемыеУпаковки", "Видимость", ВидимостьЭлементовЭДО И ВидимостьЭлементовМаркировки);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаРеализацияДляГосНужд", "Видимость", ВидимостьДанныхПродавца);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"НоменклатураПредставлениеДляАктированияЕИС", "Видимость", ВидимостьЭлементовАктирования);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"НоменклатураГруппаСтраныТовараЕИС", "Видимость", ВидимостьЭлементовАктирования);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ТоварыУслугиЗаполнитьПоКонтракту", "Видимость", ВидимостьЭлементовАктирования);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СостояниеЭТрН", "Видимость", Форма.МожноОформитьЭПД);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаРасчетныеСчета", "Видимость", НЕ ВидимостьЭлементовЭДО);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаГрузоотправитель", "Видимость", НЕ ВидимостьЭлементовЭДО);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаГрузополучатель", "Видимость", НЕ ВидимостьЭлементовЭДО);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаСостояниеЭПД", "Видимость", Форма.НастроенОбменЭПД И Форма.ЕстьПравоСозданиеЭТрН);

	Если Форма.НастроенОбменЭПД И Форма.ЕстьПравоСозданиеЭТрН Тогда
		ЭлектронныеДокументыБГУКлиентСервер.ОбновитьТекстЭПД(Форма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовМаркировкиОбъектноСортовойУчет(Форма, ВидимостьЭлементовМаркировкиОбъектноСортовойУчет)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СтраницаОбъемноСортовойУчет", "Видимость", ВидимостьЭлементовМаркировкиОбъектноСортовойУчет);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеЭДОПродавцаДляГосНужд(ВидимостьДанныхПродавца)
	Если ВидимостьДанныхПродавца Тогда 
		ДанныеЭДОДоговора = ЭлектронныеДокументыБГУ.ДанныеЭДОПродавцаДляГосНужд(Объект.Договор);
		Если  НЕ ЗначениеЗаполнено(Объект.КПСПродавца) Тогда
			Объект.КПСПродавца = ДанныеЭДОДоговора.КПСПродавца;
		КонецЕсли;
		Если  НЕ ЗначениеЗаполнено(Объект.КодЦелиПродавца) Тогда
			Объект.КодЦелиПродавца = ДанныеЭДОДоговора.КодЦелиПродавца;
		КонецЕсли;
		Если  НЕ ЗначениеЗаполнено(Объект.РасчетныйСчетКонтрагента) Тогда
			Объект.РасчетныйСчетКонтрагента = ДанныеЭДОДоговора.СчетКонтрагента;
		КонецЕсли;
		Если  НЕ ЗначениеЗаполнено(Объект.РеквизитыЛицевогоСчета) Тогда
			Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.ЗаявкаНаВозврат", Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
			Объект.РеквизитыЛицевогоСчета = Умолчания.РеквизитыЛицевогоСчета;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ПриИзмененииКлючевыхРеквизитовСостояниеЭДО()
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ПараметрыПриИзменении = ОбменСКонтрагентами.ПараметрыПриИзмененииКлючевыхРеквизитовЭДО();
	
	ПараметрыПриИзменении.Форма                 = ЭтотОбъект;
	ПараметрыПриИзменении.ДокументСсылка        = Объект.Ссылка;
	ПараметрыПриИзменении.ДокументОбъект        = РеквизитФормыВЗначение("Объект");
	ПараметрыПриИзменении.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПриИзменении.ГруппаСостояниеЭДО    = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриИзмененииКлючевыхРеквизитовЭДО(ПараметрыПриИзменении);
	
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
