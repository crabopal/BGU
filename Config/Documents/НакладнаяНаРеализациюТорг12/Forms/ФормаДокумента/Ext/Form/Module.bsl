&НаКлиенте
Процедура НоменклатураМаркируемыеУпаковкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекДанныеСтроки = Элементы.Номенклатура.ТекущиеДанные;
	
	Если ТекДанныеСтроки <> Неопределено Тогда
		
		ИдентификаторСтроки = ТекДанныеСтроки.ИдентификаторСтроки;
		Если НЕ ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
			ТекДанныеСтроки.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);	
		КонецЕсли;
		
		Если НЕ ТекДанныеСтроки.МаркируемыйТовар Тогда
			ТекДанныеСтроки.МаркируемыйТовар = МаркируемыйТовар(ТекДанныеСтроки.ПолучитьИдентификатор());	
		КонецЕсли;	
		
		Если ТекДанныеСтроки.МаркируемыйТовар Тогда   
			ПараметрыПодбора = Новый Структура;
			ПараметрыПодбора.Вставить("Организация"	, Объект.Организация);
			ПараметрыПодбора.Вставить("Дата"		, Объект.Дата);
			ЭлектронныеДокументыБГУКлиент.ВыбратьКодыМаркировки(ЭтотОбъект, СтандартнаяОбработка, "Номенклатура",, ПараметрыПодбора);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

