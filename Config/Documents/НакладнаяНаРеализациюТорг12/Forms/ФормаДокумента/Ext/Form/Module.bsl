&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьОтветственныеЛица(Объект)
	НовыйРуководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"),
		Объект.Организация, Объект.Дата, Объект.Подразделение);
	НовыйГлавныйБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер"),
		Объект.Организация, Объект.Дата, Объект.Подразделение);
	
	УстановленРуководитель = Ложь;
	УстановленГлавныйБухгалтер = Ложь;
	
	Если ЗначениеЗаполнено(НовыйРуководитель.ОтветственноеЛицоСсылка) 
		И Объект.Руководитель <> НовыйРуководитель.ОтветственноеЛицоСсылка Тогда
		Объект.Руководитель = НовыйРуководитель.ОтветственноеЛицоСсылка;
		УстановленРуководитель = Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(НовыйГлавныйБухгалтер.ОтветственноеЛицоСсылка) 
		И Объект.ГлавныйБухгалтер <> НовыйГлавныйБухгалтер.ОтветственноеЛицоСсылка Тогда
		Объект.ГлавныйБухгалтер = НовыйГлавныйБухгалтер.ОтветственноеЛицоСсылка;
		УстановленГлавныйБухгалтер = Истина;
	КонецЕсли;

	#Если НаКлиенте Тогда
	Если УстановленРуководитель Тогда
		ПоказатьОповещениеПользователя(,,НСтр("ru = 'Установлено новое значение поля ""Руководитель""'"));
	КонецЕсли;			
	Если УстановленГлавныйБухгалтер Тогда
		ПоказатьОповещениеПользователя(,,НСтр("ru = 'Установлено новое значение поля ""Главный бухгалтер""'"));
	КонецЕсли;			
	#КонецЕсли
КонецПроцедуры

