&НаКлиенте
Процедура КартинкаЗакрытьБаннерНажатие(Элемент)
	
	ОтключитьБаннерУведомленийОПеремещении = Истина;
	ПодключитьОбработчикОжидания("Подключаемый_НапоминатьОбУведомленииОПеремещении", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьУведомлениеОПеремещенииОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	Если Модифицированность И Не ЗначениеЗаполнено(УведомлениеОПеремещении) Тогда
		Записать();
	КонецЕсли;
	
	ПрослеживаемостьФормыБГУКлиент.СоздатьПоказатьУведомления(ЭтотОбъект, Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура РеализацияПоСтавке0ПриИзменении(Элемент)
	
	Если Объект.Номенклатура.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.РеализацияПоСтавке0 Тогда
		
		ТекстВопроса = НСтр("ru='При включении признака реализации по ставке 0%
							|всем материалам в документе будет установлена ставка НДС 0%.
							|Установить ставку НДС 0%?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, "Установить ставку 0%");
		Кнопки.Добавить(КодВозвратаДиалога.Нет, "Не устанавливать ставку 0%");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("РеализацияПоСтавке0ПриИзмененииЗавершение", ЭтотОбъект,
			), ТекстВопроса, Кнопки,,КодВозвратаДиалога.Нет);
		
	Иначе
		
		ТекстВопроса = НСтр("ru='При отключении признака реализации по ставке 0%
								|всем услугам в документе можно установить ставки НДС из справочника ""Номенклатура"".
								|Установить ставки НДС из справочника ""Номенклатура""?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, "Установить ставки НДС из справочника ""Номенклатура""");
		Кнопки.Добавить(КодВозвратаДиалога.Нет, "Не изменять ставки");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("УстановитьСтавкиНДССтрокИзНоменклатуры", ЭтотОбъект,
			), ТекстВопроса, Кнопки,,КодВозвратаДиалога.Нет);
		
	КонецЕсли;
	
КонецПроцедуры

