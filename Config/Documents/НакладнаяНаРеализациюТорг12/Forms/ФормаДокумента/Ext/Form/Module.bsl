&НаКлиенте
Процедура НоменклатураПередУдалением(Элемент, Отказ)
	ОбъектНаУдаление = Элементы.Номенклатура.ТекущиеДанные.Номенклатура;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ОбъектНаУдаление);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()<>0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		ПараметрыОповещения = Новый Структура("НайденныеСтроки", НайденныеСтроки);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДрагМатериалах", ЭтаФорма, ПараметрыОповещения);
		ТекстВопроса = СтрШаблон(НСтр("ru = 'Удалить данные о содержании драгоценных материалов в удаленном объекте НФА (%1) на закладке ""Драгоценные материалы""?'"),
			ОбъектНаУдаление);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Режим, 0);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "НоменклатураМаркируемыеУпаковки" Тогда
		ТекДанныеСтроки = Элементы.Номенклатура.ТекущиеДанные;
		
		Если ТекДанныеСтроки <> Неопределено И ТекДанныеСтроки.МаркируемыйТовар Тогда
			
			ИдентификаторСтроки = ТекДанныеСтроки.ИдентификаторСтроки;
			Если НЕ ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
				ТекДанныеСтроки.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);	
			КонецЕсли;
			
			СтандартнаяОбработка = Ложь; 
			ПараметрыПодбора = Новый Структура;
			ПараметрыПодбора.Вставить("Организация"	, Объект.Организация);
			ПараметрыПодбора.Вставить("Дата"		, Объект.Дата);
			ЭлектронныеДокументыБГУКлиент.ВыбратьКодыМаркировки(ЭтотОбъект, СтандартнаяОбработка, "Номенклатура",, ПараметрыПодбора);
		КонецЕсли;	
	КонецЕсли;
	ПрослеживаемостьФормыБГУКлиент.МатериалыВыбор(ЭтотОбъект, Поле, СтандартнаяОбработка, Ложь, "Номенклатура");
КонецПроцедуры

&НаСервере
Процедура НоменклатураПриИзмененииНаСервере(ИдентификаторСтроки)

	ТекущиеДанные = Объект.Номенклатура.НайтиПоИдентификатору(ИдентификаторСтроки);
	ТекущиеДанные.Цена = ПолучитьЦенуНоменклатуры(ТекущиеДанные.Номенклатура, Объект.ТипЦены, Объект.Дата,
		Объект.Организация);
	РасчитатьСтроку(ТекущиеДанные, Объект.СуммаВключаетНДС, "Цена");
	ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, ТекущиеДанные, Истина);

	РеквизитыНоменклатуры = УправлениеМатериальнымиЗапасамиВызовСервера.ПолучитьСвойстваНоменклатуры(ТекущиеДанные.Номенклатура, Объект.Дата);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, РеквизитыНоменклатуры,
		"ПрослеживаемыйТовар, КомплектСПрослеживаемымиТоварами, СтранаПроисхождения, СтавкаНДС");
	
	ТекущиеДанные.МаркируемыйТовар = МаркируемыйТовар(ТекущиеДанные.ПолучитьИдентификатор());
	ТекущиеДанные.МаркируемыйТоварОбъемноСортовогоУчета = МаркируемыйТоварОбъемноСортовогоУчета(ТекущиеДанные.ПолучитьИдентификатор());
	Если ЗначениеЗаполнено(ТекущиеДанные.ВариантКомплектаПТ) Тогда
		ТекущиеДанные.ВариантКомплектаПТ = Справочники.ВариантыКомплектовМЗПТ.ПустаяСсылка();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПредставлениеДляАктированияЕИСПриИзменении(Элемент)
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	СписокВыбора = Элемент.СписокВыбора;
	ТекущиеДанные = Элементы.Номенклатура.ТекущиеДанные;
	ЭлектронноеАктированиеЕИСКлиент.ПриИзмененииИдентификатораДляАктированияЕИС(
		СписокВыбора, "Номенклатура", ТекущиеДанные);
	ДанныеСтроки = ЭлектронноеАктированиеЕИСВызовСервера.ДанныеСтрокиКонтрактаПоИдентификатору(
		Объект.Договор,
		ТекущиеДанные.ИдентификаторДляАктированияЕИС);
	ТекущиеДанные.Цена = ДанныеСтроки.Цена;
	ТекущиеДанные.Всего = ДанныеСтроки.Сумма;		
	РасчитатьСтроку(Элементы.Номенклатура.ТекущиеДанные, Объект.СуммаВключаетНДС, "Всего");
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
КонецПроцедуры

