#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ПодготовкаДанныхЭДО

Функция ПодготовитьДанныеДляЭД(ДокументСсылка) Экспорт
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	Руководитель = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ДокументСсылка.Организация, 
																				Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
																				ДокументСсылка.Дата);
	ГлБухгалтер	 = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ДокументСсылка.Организация, 
																				Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер,
																				ДокументСсылка.Дата);
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ВалютаДокумента) Тогда
		КурсВзаиморасчетов = 1;
		КратностьВзаиморасчетов = 1;
	Иначе
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокументСсылка.ВалютаДокумента, ДокументСсылка.Дата);
		КурсВзаиморасчетов = КурсКратность.Курс;
		КратностьВзаиморасчетов = КурсКратность.Кратность;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	НакладнаяНаРеализациюТорг12.Номер КАК Номер,
	               |	НакладнаяНаРеализациюТорг12.Дата КАК Дата,
	               |	НакладнаяНаРеализациюТорг12.Организация КАК Организация,
	               |	НакладнаяНаРеализациюТорг12.Контрагент КАК Контрагент,
	               |	НакладнаяНаРеализациюТорг12.РасчетныйСчетКонтрагента КАК СчетПлательщика,
	               |	НакладнаяНаРеализациюТорг12.Грузоотправитель КАК Грузоотправитель,
	               |	ВЫБОР
	               |		КОГДА НакладнаяНаРеализациюТорг12.РасчетныйСчетГрузоотправителя <> ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка)
	               |			ТОГДА НакладнаяНаРеализациюТорг12.РасчетныйСчетГрузоотправителя
	               |	КОНЕЦ КАК СчетГрузоотправителя,
	               |	НакладнаяНаРеализациюТорг12.Грузополучатель КАК Грузополучатель,
	               |	ВЫБОР
	               |		КОГДА НакладнаяНаРеализациюТорг12.РасчетныйСчетГрузополучателя <> ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка)
	               |			ТОГДА НакладнаяНаРеализациюТорг12.РасчетныйСчетГрузополучателя
	               |		КОГДА НакладнаяНаРеализациюТорг12.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |			ТОГДА НакладнаяНаРеализациюТорг12.РасчетныйСчетКонтрагента
	               |	КОНЕЦ КАК СчетГрузополучателя,
	               |	ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).Владелец КАК ЛицевойСчет,
	               |	НакладнаяНаРеализациюТорг12.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	               |	&Руководитель КАК Руководитель,
	               |	&ГлБухгалтер КАК ГлавныйБухгалтер,
	               |	НакладнаяНаРеализациюТорг12.ДокументОснование КАК ДокументОснование,
	               |	ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.Договор КАК Справочник.Договоры) КАК Договор,
	               |	ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.Договор КАК Справочник.Договоры).НомерДоговора КАК ДокументОснованиеНомер,
	               |	ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.Договор КАК Справочник.Договоры).ДатаДоговора КАК ДокументОснованиеДата,
	               |	ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.Договор КАК Справочник.Договоры).ВидОбязательства КАК ДокументОснованиеНаименование,
	               |	ВЫБОР
	               |		КОГДА НакладнаяНаРеализациюТорг12.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.ВалютаДокумента КАК Справочник.Валюты).Код
	               |		ИНАЧЕ ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).Код
	               |	КОНЕЦ КАК ВалютаКод,
	               |	ВЫБОР
	               |		КОГДА НакладнаяНаРеализациюТорг12.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.ВалютаДокумента КАК Справочник.Валюты).НаименованиеПолное
	               |		ИНАЧЕ ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).НаименованиеПолное
	               |	КОНЕЦ КАК ВалютаНаименование,
	               |	&КурсВзаиморасчетов КАК Курс,
	               |	ВЫБОР
	               |		КОГДА НакладнаяНаРеализациюТорг12.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА НакладнаяНаРеализациюТорг12.ВалютаДокумента
	               |		ИНАЧЕ &РегламентированнаяВалюта
	               |	КОНЕЦ КАК Валюта,
	               |	НакладнаяНаРеализациюТорг12.Контрагент.ОбособленноеПодразделение КАК КонтрагентОбособленноеПодразделение,
	               |	НакладнаяНаРеализациюТорг12.Контрагент.ГоловнаяОрганизация КАК КонтрагентГоловнаяОрганизация,
	               |	ВЫБОР
	               |		КОГДА НакладнаяНаРеализациюТорг12.Контрагент.ОбособленноеПодразделение = ИСТИНА
	               |			ТОГДА ВЫБОР
	               |					КОГДА НакладнаяНаРеализациюТорг12.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |						ТОГДА """"
	               |					КОГДА НЕ НакладнаяНаРеализациюТорг12.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное = """"
	               |						ТОГДА НакладнаяНаРеализациюТорг12.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное
	               |					КОГДА НакладнаяНаРеализациюТорг12.Контрагент.ГоловнаяОрганизация.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	               |							И НЕ НакладнаяНаРеализациюТорг12.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	               |						ТОГДА ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное КАК СТРОКА(1000))
	               |					ИНАЧЕ НакладнаяНаРеализациюТорг12.Контрагент.ГоловнаяОрганизация.Наименование
	               |				КОНЕЦ
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК КонтрагентГоловнаяОрганизацияПредставление,
	               |	ВЫБОР
	               |		КОГДА НакладнаяНаРеализациюТорг12.Контрагент.ОбособленноеПодразделение = ИСТИНА
	               |			ТОГДА ВЫБОР
	               |					КОГДА НакладнаяНаРеализациюТорг12.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |						ТОГДА """"
	               |					ИНАЧЕ НакладнаяНаРеализациюТорг12.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.ИНН
	               |				КОНЕЦ
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК КонтрагентГоловнаяОрганизацияИНН,
	               |	НакладнаяНаРеализациюТорг12.СведенияОВыбытииМаркированныхТоваров КАК СведенияОВыбытииМаркированныхТоваров,
	               |	НакладнаяНаРеализациюТорг12.Ссылка КАК Ссылка,
	               |	НакладнаяНаРеализациюТорг12.ОтветственныйПередалТРУВид КАК ОтветственныйПередалТРУВид,
	               |	НакладнаяНаРеализациюТорг12.ОтветственныйПередалТРУДолжность КАК ОтветственныйПередалТРУДолжность,
	               |	НакладнаяНаРеализациюТорг12.ОтветственныйПередалТРУИныеСведения КАК ОтветственныйПередалТРУИныеСведения,
	               |	НакладнаяНаРеализациюТорг12.ОтветственныйПередалТРУ КАК ОтветственныйПередалТРУ,
	               |	НакладнаяНаРеализациюТорг12.ОтветственныйПередалТРУДоверенность КАК ОтветственныйПередалТРУДоверенность,
	               |	НакладнаяНаРеализациюТорг12.ОтветственныйПередалТРУОснованиеПолномочий КАК ОтветственныйПередалТРУОснованиеПолномочий,
	               |	НакладнаяНаРеализациюТорг12.ОтветственныйПередалТРУКонтрагент КАК ОтветственныйПередалТРУКонтрагент,
	               |	НакладнаяНаРеализациюТорг12.ДатаПередачиТРУ КАК ДатаПередачиТРУ,
	               |	НакладнаяНаРеализациюТорг12.ТРУПереданы КАК ТРУПереданы
	               |ИЗ
	               |	Документ.НакладнаяНаРеализациюТорг12 КАК НакладнаяНаРеализациюТорг12
	               |ГДЕ
	               |	НакладнаяНаРеализациюТорг12.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	НакладнаяНаРеализациюТорг12Материалы.НомерСтроки КАК НомерСтроки,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12Материалы.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное = """"
	               |			ТОГДА ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12Материалы.Номенклатура КАК Справочник.Номенклатура).Представление
	               |		ИНАЧЕ ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12Материалы.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное
	               |	КОНЕЦ КАК НаименованиеНоменклатуры,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12Материалы.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное = """"
	               |			ТОГДА ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12Материалы.Номенклатура КАК Справочник.Номенклатура).Представление
	               |		ИНАЧЕ ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12Материалы.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное
	               |	КОНЕЦ КАК ТоварНаименование,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12Материалы.Номенклатура КАК Справочник.Номенклатура).НоменклатурныйНомер = """"
	               |			ТОГДА ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12Материалы.Номенклатура КАК Справочник.Номенклатура).Код
	               |		ИНАЧЕ ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12Материалы.Номенклатура КАК Справочник.Номенклатура).НоменклатурныйНомер
	               |	КОНЕЦ КАК КодТовара,
	               |	ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12Материалы.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения.Представление КАК ЕдиницаИзмерения,
	               |	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12Материалы.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения.Код) КАК БазоваяЕдиницаКод,
	               |	НакладнаяНаРеализациюТорг12Материалы.Количество КАК МассаНетто,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА НЕ НакладнаяНаРеализациюТорг12Материалы.Ссылка.СуммаВключаетНДС
	               |				ТОГДА НакладнаяНаРеализациюТорг12Материалы.Цена
	               |			КОГДА НакладнаяНаРеализациюТорг12Материалы.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И НакладнаяНаРеализациюТорг12Материалы.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА (НакладнаяНаРеализациюТорг12Материалы.Всего - НакладнаяНаРеализациюТорг12Материалы.СуммаНДС) * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА НакладнаяНаРеализациюТорг12Материалы.Количество = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ НакладнаяНаРеализациюТорг12Материалы.Количество
	               |					КОНЕЦ
	               |			КОГДА НакладнаяНаРеализациюТорг12Материалы.СуммаНДС = 0 И НакладнаяНаРеализациюТорг12Материалы.Цена <> 0
	               |				ТОГДА НакладнаяНаРеализациюТорг12Материалы.Цена
	               |			ИНАЧЕ (НакладнаяНаРеализациюТорг12Материалы.Всего - НакладнаяНаРеализациюТорг12Материалы.СуммаНДС) / ВЫБОР
	               |					КОГДА НакладнаяНаРеализациюТорг12Материалы.Количество = 0
	               |						ТОГДА 1
	               |					ИНАЧЕ НакладнаяНаРеализациюТорг12Материалы.Количество
	               |				КОНЕЦ
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК Цена,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА НакладнаяНаРеализациюТорг12Материалы.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И НакладнаяНаРеализациюТорг12Материалы.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА (НакладнаяНаРеализациюТорг12Материалы.Всего - НакладнаяНаРеализациюТорг12Материалы.СуммаНДС) * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ
	               |			ИНАЧЕ НакладнаяНаРеализациюТорг12Материалы.Всего - НакладнаяНаРеализациюТорг12Материалы.СуммаНДС
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК СуммаБезНДС,
	               |	НакладнаяНаРеализациюТорг12Материалы.СтавкаНДС КАК СтавкаНДС,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА НакладнаяНаРеализациюТорг12Материалы.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И НакладнаяНаРеализациюТорг12Материалы.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА НакладнаяНаРеализациюТорг12Материалы.СуммаНДС * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ
	               |			ИНАЧЕ НакладнаяНаРеализациюТорг12Материалы.СуммаНДС
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК СуммаНДС,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА НакладнаяНаРеализациюТорг12Материалы.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И НакладнаяНаРеализациюТорг12Материалы.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА НакладнаяНаРеализациюТорг12Материалы.Всего * ВЫБОР
