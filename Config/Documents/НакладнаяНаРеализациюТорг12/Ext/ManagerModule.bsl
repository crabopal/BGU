	ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
	ПервыйДокумент = Истина;
	
	ТипДоговораРеализацияЛомаШкур = Перечисления.ТипыДоговоровДляНДС.РеализацияЛомаШкур;
	
	ОчищающаяСтруктураСтрокаТаблицы = Новый Структура();
	ОчищающаяСтруктураСтрокаТаблицы.Вставить("пСтавкаНДС",	УчетНДСКлиентСервер.ТекстСтавкиНДСИсчисляетсяНалоговымАгентом());
	ОчищающаяСтруктураСтрокаТаблицы.Вставить("пСуммаНДС",	"-");
	ОчищающаяСтруктураСтрокаТаблицы.Вставить("пВсего",		"-");
	
	ОчищающаяСтруктураИтогиПоСтранице = Новый Структура();
	ОчищающаяСтруктураИтогиПоСтранице.Вставить("пСуммаНДСИтогоНаСтранице",	"-");
	ОчищающаяСтруктураИтогиПоСтранице.Вставить("пВсегоИтогоНаСтранице",		"-");
	
	ОчищающаяСтруктураИтогиПоТаблице = Новый Структура();
	ОчищающаяСтруктураИтогиПоТаблице.Вставить("пСуммаНДСИтого",	"-");
	ОчищающаяСтруктураИтогиПоТаблице.Вставить("пВсегоИтого",	"-");
	
	ОбластьПолеСтавкаНДС = ОбластьМакетаСтрока.Область(1,14,1,14);
	ШрифтПолеСтавкаНДС = ОбластьПолеСтавкаНДС.Шрифт;
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		// Высота строки таблицы в макете является фиксированной.
		// Если в поле для ставки вывести длинный текст, то он не поместится целиком.
		// Поэтому, в таком случае уменьшаем размер шрифта.
		РазмерШрифта = ?(ВыборкаШапка.ДоговорТипДоговораНДС = ТипДоговораРеализацияЛомаШкур, 5, 8);
		
		ОбластьПолеСтавкаНДС.Шрифт = Новый Шрифт(ШрифтПолеСтавкаНДС,, РазмерШрифта);
		
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьМакетаШапка.Параметры.Заполнить(ВыборкаШапка);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьМакетаШапка,
			"пНомер", ВыборкаШапка.пНомер, ВыборкаШапка.Ссылка, Неопределено, Истина);
		
		ОбластьМакетаШапка.Параметры.Заполнить(ПараметрыЗаполненияКонтрагентовВШапке(ВыборкаШапка));
		
		ТабличныйДокумент.Вывести(ОбластьМакетаШапка);
		
		пНомерСтраницы = 1;
		ОбластьМакетаЗаголовок.Параметры.Заполнить(Новый Структура("пНомерСтраницы", "Страница " + пНомерСтраницы));
		ТабличныйДокумент.Вывести(ОбластьМакетаЗаголовок);
		
		ВыборкаСтроки = ВыборкаШапка.Выбрать();
		КоличествоСтрок = ВыборкаСтроки.Количество();
		КоличествоПоСтранице	= 0;
		СуммаБезНДСПоСтранице   = 0;
		СуммаНДСПоСтранице		= 0;
		СуммаВсегоПоСтранице	= 0;
		Количество	= 0;
		СуммаБезНДС	= 0;
		СуммаНДС	= 0;
		СуммаВсего	= 0;
		НомерСтроки = 0;
		
		Пока ВыборкаСтроки.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			
			Если ВыборкаСтроки.пНомерСтроки = 0 Тогда
				// пустой документ
				КоличествоСтрок = КоличествоСтрок - 1;
				Продолжить;
			КонецЕсли;
		
			ОбластьМакетаСтрока.Параметры.Заполнить(ВыборкаСтроки);
			ОбластьМакетаСтрока.Параметры.Заполнить(Новый Структура("пНомерСтроки", НомерСтроки));
			
			ЦенаПоСтроке = ВыборкаСтроки.пЦена;
			СуммаБезНДСПоСтроке = ВыборкаСтроки.пСуммаБезНДС;
			СуммаНДСПоСтроке = ВыборкаСтроки.пСуммаНДС;
			ВсегоПоСтроке = ВыборкаСтроки.пВсего;
			
			Если ЗначениеЗаполнено(ВыборкаШапка.ВалютаДокумента) И ВыборкаШапка.ВалютаДокумента <> ВалютаРубли Тогда
				ВсегоПоСтроке = Окр(ВыборкаСтроки.пВсего * ВыборкаСтроки.Курс / ВыборкаСтроки.Кратность, 2);
				СуммаНДСПоСтроке = Окр(ВыборкаСтроки.пСуммаНДС * ВыборкаСтроки.Курс / ВыборкаСтроки.Кратность, 2);
				Если ВыборкаШапка.СуммаВключаетНДС Тогда
					СуммаБезНДСПоСтроке = ВсегоПоСтроке;
				Иначе
					СуммаБезНДСПоСтроке = ВсегоПоСтроке - СуммаНДСПоСтроке;
				КонецЕсли;
				Если ВыборкаСтроки.пКоличество <> 0 Тогда
					ЦенаПоСтроке = Окр(СуммаБезНДСПоСтроке / ВыборкаСтроки.пКоличество, 2);
				Иначе
					ЦенаПоСтроке = Окр(ВыборкаСтроки.пЦенаПоСтроке * ВыборкаСтроки.Курс / ВыборкаСтроки.Кратность, 2);
				КонецЕсли;
				ПараметрыПересчитаннойСуммы = Новый Структура;
				ПараметрыПересчитаннойСуммы.Вставить("пЦена", ЦенаПоСтроке);
				ПараметрыПересчитаннойСуммы.Вставить("пСуммаБезНДС", СуммаБезНДСПоСтроке);
				ПараметрыПересчитаннойСуммы.Вставить("пСуммаНДС", СуммаНДСПоСтроке);
				ПараметрыПересчитаннойСуммы.Вставить("пВсего", ВсегоПоСтроке);
				ОбластьМакетаСтрока.Параметры.Заполнить(ПараметрыПересчитаннойСуммы);
			КонецЕсли; 
			
			Если ВыборкаШапка.ДоговорТипДоговораНДС = ТипДоговораРеализацияЛомаШкур Тогда
				ЗаполнитьЗначенияСвойств(ОбластьМакетаСтрока.Параметры, ОчищающаяСтруктураСтрокаТаблицы);
			КонецЕсли;
			
			НаСледСтраницу = Ложь;
			Если НомерСтроки = КоличествоСтрок Тогда
				Если НЕ	ТабличныйДокумент.ПроверитьВывод(МассивСтрокДляВыводаСПодвалом) Тогда
					НаСледСтраницу = Истина;
				КонецЕсли;
			ИначеЕсли Не ТабличныйДокумент.ПроверитьВывод(МассивСтрокДляВывода) Тогда
				НаСледСтраницу = Истина;
			КонецЕсли;
			
			Если НаСледСтраницу Тогда
				
				ОбластьМакетаИтогоПоСтранице.Параметры.Заполнить(
					ПараметрыИтогПоСтранице(КоличествоПоСтранице, СуммаБезНДСПоСтранице, СуммаНДСПоСтранице, СуммаВсегоПоСтранице));
				
				Если ВыборкаШапка.ДоговорТипДоговораНДС = ТипДоговораРеализацияЛомаШкур Тогда
					ЗаполнитьЗначенияСвойств(ОбластьМакетаИтогоПоСтранице.Параметры, ОчищающаяСтруктураИтогиПоСтранице);
				КонецЕсли;
				
				ТабличныйДокумент.Вывести(ОбластьМакетаИтогоПоСтранице);
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				пНомерСтраницы = пНомерСтраницы + 1;
				ОбластьМакетаЗаголовок.Параметры.Заполнить(Новый Структура("пНомерСтраницы", "Страница " + пНомерСтраницы));
				
				ТабличныйДокумент.Вывести(ОбластьМакетаЗаголовок);
				
				КоличествоПоСтранице	= 0;
				СуммаБезНДСПоСтранице   = 0;
				СуммаНДСПоСтранице		= 0;
				СуммаВсегоПоСтранице	= 0;
				
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьМакетаСтрока);
			
			КоличествоПоСтранице	= КоличествоПоСтранице	+ ВыборкаСтроки.пКоличество;
			СуммаБезНДСПоСтранице   = СуммаБезНДСПоСтранице	+ СуммаБезНДСПоСтроке;
			СуммаНДСПоСтранице		= СуммаНДСПоСтранице	+ СуммаНДСПоСтроке;
			СуммаВсегоПоСтранице	= СуммаВсегоПоСтранице	+ ВсегоПоСтроке;
			Количество	= Количество	+ ВыборкаСтроки.пКоличество;
			СуммаБезНДС	= СуммаБезНДС	+ СуммаБезНДСПоСтроке;
			СуммаНДС	= СуммаНДС		+ СуммаНДСПоСтроке;
			СуммаВсего	= СуммаВсего	+ ВсегоПоСтроке;
		
		КонецЦикла; 
		
		ОбластьМакетаИтогоПоСтранице.Параметры.Заполнить(
			ПараметрыИтогПоСтранице(КоличествоПоСтранице, СуммаБезНДСПоСтранице, СуммаНДСПоСтранице, СуммаВсегоПоСтранице));
		
		Если ВыборкаШапка.ДоговорТипДоговораНДС = ТипДоговораРеализацияЛомаШкур Тогда
			ЗаполнитьЗначенияСвойств(ОбластьМакетаИтогоПоСтранице.Параметры, ОчищающаяСтруктураИтогиПоСтранице);
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьМакетаИтогоПоСтранице);

		СтруктураОбластьМакетаВсего = Новый Структура("пКоличествоИтого,пСуммаБезНДСИтого,пСуммаНДСИтого,пВсегоИтого");
		СтруктураОбластьМакетаВсего.пКоличествоИтого	= Количество;
		СтруктураОбластьМакетаВсего.пСуммаБезНДСИтого	= СуммаБезНДС;
		СтруктураОбластьМакетаВсего.пСуммаНДСИтого		= СуммаНДС;
		СтруктураОбластьМакетаВсего.пВсегоИтого		= СуммаВсего;
		ОбластьМакетаВсего.Параметры.Заполнить(СтруктураОбластьМакетаВсего);
		
		Если ВыборкаШапка.ДоговорТипДоговораНДС = ТипДоговораРеализацияЛомаШкур Тогда
			ЗаполнитьЗначенияСвойств(ОбластьМакетаВсего.Параметры, ОчищающаяСтруктураИтогиПоТаблице);
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьМакетаВсего);
		
		СтруктураОбластьМакетаПодвал = Новый Структура("пКоличествоНаименованийПрописью,пВсегоИтогоПрописью,пДолжностьРуководитель,пФИОРуководитель,пФИОГлавныйБухгалтер");
		СтруктураОбластьМакетаПодвал.Вставить("пДолжностьОтпустил");
		СтруктураОбластьМакетаПодвал.Вставить("пФИООтпустил");
		
		СтруктураОбластьМакетаПодвал.пКоличествоНаименованийПрописью	= ЧислоПрописью(КоличествоСтрок,,"наименование,наименования,наименований,с,,,,,0");
		СтруктураОбластьМакетаПодвал.пВсегоИтогоПрописью				= ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СуммаВсего, ВалютаРубли);
		Если ЗначениеЗаполнено(ВыборкаШапка.Руководитель) Тогда
			Руководитель = ВыборкаШапка.Руководитель;
		Иначе
			Руководитель = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ВыборкаШапка.Организация, 
																					Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
																					ВыборкаШапка.пДата).ОтветственноеЛицоСсылка;
		КонецЕсли;
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", 
											Руководитель,
											ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
		СтруктураОбластьМакетаПодвал.пДолжностьРуководитель = ДанныеСотрудника.Должность;
		СтруктураОбластьМакетаПодвал.пФИОРуководитель = КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																										ДанныеСотрудника.Фамилия,
																										ДанныеСотрудника.Имя,
																										ДанныеСотрудника.Отчество), Истина);
		Если ЗначениеЗаполнено(ВыборкаШапка.ГлавныйБухгалтер) Тогда
			ГлБухгалтер = ВыборкаШапка.ГлавныйБухгалтер;
		Иначе
			ГлБухгалтер	 = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ВыборкаШапка.Организация, 
																					Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер,
																					ВыборкаШапка.пДата).ОтветственноеЛицоСсылка;
		КонецЕсли;
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", 
											ГлБухгалтер,
											ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
		СтруктураОбластьМакетаПодвал.пФИОГлавныйБухгалтер	= КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																										ДанныеСотрудника.Фамилия,
																										ДанныеСотрудника.Имя,
																										ДанныеСотрудника.Отчество), Истина);
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", 
											ВыборкаШапка.Отпустил,
											ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
		СтруктураОбластьМакетаПодвал.пДолжностьОтпустил = ДанныеСотрудника.Должность;
		СтруктураОбластьМакетаПодвал.пФИООтпустил       = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		
		ОбластьМакетаПодвал.Параметры.Заполнить(СтруктураОбластьМакетаПодвал);
		
		Если ВыборкаШапка.ДоговорТипДоговораНДС = ТипДоговораРеализацияЛомаШкур Тогда
			// В качестве итоговой суммы документа выводим сумму без НДС.
			
			ЗначенияПараметров = Новый Структура();
			ЗначенияПараметров.Вставить(
				"пВсегоИтогоПрописью",
				ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СуммаБезНДС, ВалютаРубли));
			
			ЗаполнитьЗначенияСвойств(ОбластьМакетаПодвал.Параметры, ЗначенияПараметров);
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьМакетаПодвал);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла; 
	
	Возврат ТабличныйДокумент;
КонецФункции

Функция ТекстЗапросаТоварыДляТТН(ОбщийИтог, ИмяОбъекта, ИмяТЧТовары) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	Шапка.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА Шапка.Грузоотправитель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Шапка.Организация
	|		ИНАЧЕ Шапка.Грузоотправитель
	|	КОНЕЦ КАК Грузоотправитель,
	|	ВЫБОР
	|		КОГДА Шапка.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Шапка.Контрагент
	|		ИНАЧЕ Шапка.Грузополучатель
	|	КОНЕЦ КАК Грузополучатель,
	|	ВЫБОР
	|		КОГДА Шапка.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(Шапка.Договор.СчетКонтрагента, ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка)) 
	|						= ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка)
	|						ТОГДА Шапка.РасчетныйСчетКонтрагента
	|					ИНАЧЕ Шапка.Договор.СчетКонтрагента
	|				КОНЕЦ
	|		ИНАЧЕ Шапка.РасчетныйСчетГрузополучателя
	|	КОНЕЦ КАК РасчетныйСчетГрузополучателя,
	|	Шапка.Перевозчик КАК Перевозчик,
	|	Шапка.Организация КАК Организация
	|ИЗ
	|	#ИмяОбъектаШапка КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НомеклатураДокумента.Номенклатура КАК Номенклатура,
	|	НомеклатураДокумента.ТоварАртикул КАК ТоварАртикул,
	|	НомеклатураДокумента.ТоварКод КАК ТоварКод,
	|	НомеклатураДокумента.ТоварНаименование КАК ТоварНаименование,
	|	НомеклатураДокумента.Цена КАК Цена,
	|	СУММА(НомеклатураДокумента.Количество) КАК Количество,
	|	СУММА(НомеклатураДокумента.Количество) КАК КоличествоМест,
	|	СУММА(НомеклатураДокумента.Всего) КАК СуммаСНДС,
	|	НомеклатураДокумента.НомерПрейскуранта КАК НомерПрейскуранта,
	|	НомеклатураДокумента.ВидУпаковки КАК ВидУпаковки,
	|	НомеклатураДокумента.Масса КАК Масса,
	|	НомеклатураДокумента.НомерЗаписиВКартотеке КАК НомерЗаписиВКартотеке
	|ИЗ
	|	(ВЫБРАТЬ
	|		Таблица.Номенклатура КАК Номенклатура,
	|		Таблица.Номенклатура.НоменклатурныйНомер КАК ТоварКод,
	|		Таблица.Номенклатура.НоменклатурныйНомер КАК ТоварАртикул,
	|		Таблица.Номенклатура.НаименованиеПолное КАК ТоварНаименование,
	|		Таблица.Номенклатура.ЕдиницаИзмерения.НациональноеСокращение КАК БазоваяЕдиницаНаименование,
	|		Таблица.Количество КАК Количество,
	|		ВЫБОР
	|			КОГДА НЕ Таблица.Ссылка.СуммаВключаетНДС
	|				ТОГДА ВЫБОР
	|						КОГДА Таблица.Количество = 0
	|							ТОГДА 0
	|						ИНАЧЕ Таблица.Всего / Таблица.Количество
	|					КОНЕЦ
	|			ИНАЧЕ Таблица.Цена
	|		КОНЕЦ КАК Цена,
	|		Таблица.Всего КАК Всего,
	|		"""" КАК НомерПрейскуранта,
	|		"""" КАК ВидУпаковки,
	|		"""" КАК Масса,
	|		"""" КАК НомерЗаписиВКартотеке
	|	ИЗ
	|		#ИмяОбъектаНоменклатура КАК Таблица
	|	ГДЕ
	|		Таблица.Ссылка = &Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Таблица.Номенклатура,
	|		Таблица.Номенклатура.НоменклатурныйНомер,
	|		Таблица.Номенклатура.НоменклатурныйНомер,
	|		Таблица.Номенклатура.НаименованиеПолное,
	|		Таблица.Номенклатура.ЕдиницаИзмерения.НациональноеСокращение,
	|		Таблица.Количество,
	|		0,
	|		Таблица.Сумма,
	|		"""",
	|		"""",
	|		"""",
	|		""""
	|	ИЗ
	|		#ИмяОбъектаВозвратнаяТара КАК Таблица) КАК НомеклатураДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	НомеклатураДокумента.Номенклатура,
	|	НомеклатураДокумента.ТоварАртикул,
	|	НомеклатураДокумента.ТоварКод,
	|	НомеклатураДокумента.ТоварНаименование,
	|	НомеклатураДокумента.Цена,
	|	НомеклатураДокумента.НомерПрейскуранта,
	|	НомеклатураДокумента.ВидУпаковки,
	|	НомеклатураДокумента.Масса,
	|	НомеклатураДокумента.НомерЗаписиВКартотеке";
	
	Если ОбщийИтог  Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ИТОГИ ПО
		|	ОБЩИЕ";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#ИмяОбъектаШапка",ИмяОбъекта);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#ИмяОбъектаНоменклатура",ИмяОбъекта+"."+ИмяТЧТовары);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#ИмяОбъектаВозвратнаяТара",ИмяОбъекта+".ВозвратнаяТара");
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ДанныеДляТТН(Ссылка, ОбщийИтог = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	
	Запрос.Текст = ТекстЗапросаТоварыДляТТН(ОбщийИтог, "Документ.НакладнаяНаРеализациюТорг12", "Номенклатура");
		
	Возврат Запрос.ВыполнитьПакет();
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокумента

Функция ЗаполнитьНаОсновании(Знач Основание, Объект, ОписаниеОшибки = "") Экспорт
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		ОписаниеОшибки = НСтр("ru='Не выбран документ-основание'");
		Возврат Ложь;
	КонецЕсли;
	ТипОснования = ТипЗнч(Основание);
	Если ТипОснования = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ЗаполнитьКорректировку(Основание, Объект);
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.СчетНаОплату") Тогда
		ЗаполнитьНаОснованииСчета(Основание, Объект);
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.ОтчетПоКассовойСмене") Тогда
		ЗаполнитьНаОснованииОтчетаОКассовойСмене(Основание, Объект);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ЗаполнитьНаОснованииСчета(Основание, Объект)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СчетНаОплату.Ссылка КАК ДокументОснование,
	               |	СчетНаОплату.Организация,
				   |	СчетНаОплату.ИФО,
	               |	СчетНаОплату.Подразделение,
	               |	СчетНаОплату.КФО,
	               |	СчетНаОплату.Договор,
	               |	СчетНаОплату.Контрагент,
	               |	СчетНаОплату.РеквизитыЛицевогоСчета,
	               |	СчетНаОплату.СуммаВключаетНДС,
	               |	СчетНаОплату.ТипЦены,
	               |	СчетНаОплату.ВалютаДокумента
	               |ИЗ
	               |	Документ.СчетНаОплату КАК СчетНаОплату
	               |ГДЕ
	               |	СчетНаОплату.Ссылка = &Счет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СчетНаОплатуМатериалы.НомерСтроки КАК НомерСтроки,
	               |	СчетНаОплатуМатериалы.Номенклатура,
	               |	СчетНаОплатуМатериалы.Количество,
	               |	СчетНаОплатуМатериалы.Цена,
	               |	СчетНаОплатуМатериалы.Сумма,
	               |	СчетНаОплатуМатериалы.СтавкаНДС,
	               |	СчетНаОплатуМатериалы.СуммаНДС,
	               |	СчетНаОплатуМатериалы.Всего,
	               |	ЕПСБУ.Ссылка КАК СчетУчета
	               |ИЗ
	               |	Документ.СчетНаОплату.Материалы КАК СчетНаОплатуМатериалы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |			ПО СпрНоменклатура.СчетУчета = ЕПСБУ.Код
	               |		ПО СчетНаОплатуМатериалы.Номенклатура = СпрНоменклатура.Ссылка
	               |ГДЕ
	               |	СчетНаОплатуМатериалы.Ссылка = &Счет
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СчетНаОплатуВозвратнаяТара.НомерСтроки КАК НомерСтроки,
	               |	СчетНаОплатуВозвратнаяТара.Номенклатура,
	               |	СчетНаОплатуВозвратнаяТара.Количество,
	               |	СчетНаОплатуВозвратнаяТара.Цена,
	               |	СчетНаОплатуВозвратнаяТара.Сумма,
	               |	ЕПСБУ.Ссылка КАК СчетУчета
	               |ИЗ
	               |	Документ.СчетНаОплату.ВозвратнаяТара КАК СчетНаОплатуВозвратнаяТара
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |			ПО СпрНоменклатура.СчетУчета = ЕПСБУ.Код
	               |		ПО СчетНаОплатуВозвратнаяТара.Номенклатура = СпрНоменклатура.Ссылка
	               |ГДЕ
	               |	СчетНаОплатуВозвратнаяТара.Ссылка = &Счет
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	Запрос.УстановитьПараметр("Счет", Основание);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаШапка		= РезультатЗапроса[0].Выгрузить();
	ВыборкаМатериалы	= РезультатЗапроса[1].Выгрузить();
	ВыборкаТара			= РезультатЗапроса[2].Выгрузить();
	
	ЗаполнитьЗначенияСвойств(Объект, ВыборкаШапка[0]);
	Объект.Номенклатура.Загрузить(ВыборкаМатериалы);
	Объект.ВозвратнаяТара.Загрузить(ВыборкаТара);
	
	УправлениеМатериальнымиЗапасами.ЗаполнитьКПСвТабличнойЧастиДокументаМЗ(Объект.Номенклатура, Объект);	
	УправлениеМатериальнымиЗапасами.ЗаполнитьКПСвТабличнойЧастиДокументаМЗ(Объект.ВозвратнаяТара, Объект);	

КонецПроцедуры

Процедура ЗаполнитьНаОснованииОтчетаОКассовойСмене(Основание, Объект)
	
	ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание, "Дата, Организация");
	
	Счет0233 = БухгалтерскийУчет.СчетПоКоду("02.33", ДанныеДокументаОснования.Дата, ДанныеДокументаОснования.Организация);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОтчетПоКассовойСмене.Ссылка КАК ДокументОснование,
	               |	ОтчетПоКассовойСмене.Организация КАК Организация,
	               |	ВЫРАЗИТЬ(ОтчетПоКассовойСмене.КассаККМ КАК Справочник.ФискальныеРегистраторы).КонтрагентДляРозничныхПродаж КАК Контрагент,
	               |	ВЫРАЗИТЬ(ОтчетПоКассовойСмене.КассаККМ КАК Справочник.ФискальныеРегистраторы).ДоговорДляРозничныхПродаж КАК Договор,
	               |	ВЫРАЗИТЬ(ОтчетПоКассовойСмене.КассаККМ КАК Справочник.ФискальныеРегистраторы).ТипЦены КАК ТипЦены,
	               |	ВЫРАЗИТЬ(ОтчетПоКассовойСмене.КассаККМ КАК Справочник.ФискальныеРегистраторы).СуммаВключаетНДС КАК СуммаВключаетНДС,
	               |	&ВалютаДокумента КАК ВалютаДокумента
	               |ИЗ
	               |	Документ.ОтчетПоКассовойСмене КАК ОтчетПоКассовойСмене
	               |ГДЕ
	               |	ОтчетПоКассовойСмене.Ссылка = &ОтчетПоКассовойСмене
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ОтчетПоКассовойСменеПродажиТовары.Номенклатура КАК Справочник.Прейскурант).Номенклатура КАК Номенклатура,
	               |	ОтчетПоКассовойСменеПродажиТовары.Количество КАК Количество,
	               |	ОтчетПоКассовойСменеПродажиТовары.Цена КАК Цена,
	               |	ОтчетПоКассовойСменеПродажиТовары.Сумма КАК Сумма,
	               |	ОтчетПоКассовойСменеПродажиТовары.СтавкаНДС КАК СтавкаНДС,
	               |	ОтчетПоКассовойСменеПродажиТовары.СуммаНДС КАК СуммаНДС,
	               |	ОтчетПоКассовойСменеПродажиТовары.Всего КАК Всего
	               |ПОМЕСТИТЬ РезультатыПродаж
	               |ИЗ
	               |	Документ.ОтчетПоКассовойСмене.ПродажиТовары КАК ОтчетПоКассовойСменеПродажиТовары
	               |ГДЕ
	               |	ОтчетПоКассовойСменеПродажиТовары.Ссылка = &ОтчетПоКассовойСмене
	               |	И ОтчетПоКассовойСменеПродажиТовары.ЭтоРозничныйПокупатель = ИСТИНА
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ОтчетПоКассовойСменеВозвратТовары.Номенклатура КАК Справочник.Прейскурант).Номенклатура,
	               |	-1 * ОтчетПоКассовойСменеВозвратТовары.Количество,
	               |	ОтчетПоКассовойСменеВозвратТовары.Цена,
	               |	-1 * ОтчетПоКассовойСменеВозвратТовары.Сумма,
	               |	ОтчетПоКассовойСменеВозвратТовары.СтавкаНДС,
	               |	-1 * ОтчетПоКассовойСменеВозвратТовары.СуммаНДС,
	               |	-1 * ОтчетПоКассовойСменеВозвратТовары.Всего
	               |ИЗ
	               |	Документ.ОтчетПоКассовойСмене.ВозвратТовары КАК ОтчетПоКассовойСменеВозвратТовары
	               |ГДЕ
	               |	ОтчетПоКассовойСменеВозвратТовары.Ссылка = &ОтчетПоКассовойСмене
	               |	И ОтчетПоКассовойСменеВозвратТовары.ЭтоРозничныйПокупатель = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РезультатыПродаж.Номенклатура КАК Номенклатура,
	               |	СУММА(РезультатыПродаж.Количество) КАК Количество,
	               |	РезультатыПродаж.Цена КАК Цена,
	               |	СУММА(РезультатыПродаж.Сумма) КАК Сумма,
	               |	РезультатыПродаж.СтавкаНДС КАК СтавкаНДС,
	               |	СУММА(РезультатыПродаж.СуммаНДС) КАК СуммаНДС,
	               |	СУММА(РезультатыПродаж.Всего) КАК Всего,
				   |	ВЫБОР
				   |		КОГДА ЕПСБУ.Ссылка = &Счет0233
				   |			ТОГДА ИСТИНА
				   |		ИНАЧЕ ЛОЖЬ
				   |	КОНЕЦ КАК КомиссионнаяТорговля,
	               |	ЕПСБУ.Ссылка КАК СчетУчета
	               |ПОМЕСТИТЬ РезультатыПродажИСчетаУчета
	               |ИЗ
	               |	РезультатыПродаж КАК РезультатыПродаж
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |			ПО СпрНоменклатура.СчетУчета = ЕПСБУ.Код
	               |		ПО РезультатыПродаж.Номенклатура = СпрНоменклатура.Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РезультатыПродаж.Номенклатура,
	               |	РезультатыПродаж.СтавкаНДС,
	               |	ЕПСБУ.Ссылка,
	               |	РезультатыПродаж.Цена
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РезультатыПродажИСчетаУчета.Номенклатура КАК Номенклатура,
	               |	РезультатыПродажИСчетаУчета.Количество КАК Количество,
	               |	РезультатыПродажИСчетаУчета.Цена КАК Цена,
	               |	РезультатыПродажИСчетаУчета.Сумма КАК Сумма,
	               |	РезультатыПродажИСчетаУчета.СтавкаНДС КАК СтавкаНДС,
	               |	РезультатыПродажИСчетаУчета.СуммаНДС КАК СуммаНДС,
	               |	РезультатыПродажИСчетаУчета.Всего КАК Всего,
	               |	РезультатыПродажИСчетаУчета.КомиссионнаяТорговля КАК КомиссионнаяТорговля,
	               |	РезультатыПродажИСчетаУчета.СчетУчета КАК СчетУчета
	               |ИЗ
	               |	РезультатыПродажИСчетаУчета КАК РезультатыПродажИСчетаУчета
	               |ГДЕ
	               |	РезультатыПродажИСчетаУчета.Количество <> 0";
	
	Запрос.УстановитьПараметр("ОтчетПоКассовойСмене", Основание);
	Запрос.УстановитьПараметр("ВалютаДокумента", ВалютаРубли);
	Запрос.УстановитьПараметр("Счет0233", Счет0233);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаШапка		= РезультатЗапроса[0].Выгрузить();
	ВыборкаМатериалы	= РезультатЗапроса[3].Выгрузить();
	
	ЗаполнитьЗначенияСвойств(Объект, ВыборкаШапка[0]);
	Объект.Номенклатура.Загрузить(ВыборкаМатериалы);
	Объект.СуммаДокумента = ВыборкаМатериалы.Итог("Всего");
	
	РеквизитыККМ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание.КассаККМ, "ЦМО, Подразделение");
	Объект.ЦМО = РеквизитыККМ.ЦМО;
	Объект.Подразделение = РеквизитыККМ.Подразделение;
	
	УправлениеМатериальнымиЗапасами.ЗаполнитьКПСвТабличнойЧастиДокументаМЗ(Объект.Номенклатура, Объект);	
	
КонецПроцедуры

Процедура ЗаполнитьКорректировку(Основание, Объект) Экспорт
	
	УправлениеМатериальнымиЗапасами.ПроверитьДокументОснованиеНеКорректировался(Основание, Объект.Ссылка);
	
	ОснованиеОбъект = Основание.ПолучитьОбъект();
	Если ОснованиеОбъект = Неопределено Тогда
		ВызватьИсключение "Не выбран документ-основание";
	КонецЕсли;
	
	Объект.ДокументОснование = Основание;
	ЗаполнитьКорректировкуШапка(Объект, ОснованиеОбъект);
	ЗаполнитьКорректировкуНоменклатура(Объект, ОснованиеОбъект);
	ЗаполнитьКорректировкуВозвратнаяТара(Объект, ОснованиеОбъект);
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(Объект, ОснованиеОбъект, "ДрагоценныеМатериалы"); 	
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(Объект, ОснованиеОбъект, "ДополнительныеРеквизиты"); 	
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(Объект, ОснованиеОбъект, "КодыУпаковокМаркируемойПродукции"); 	
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(Объект, ОснованиеОбъект, "СведенияПрослеживаемости"); 	
	
	Объект.ЭтоКорректировка = Истина;
	Объект.НомерКорректировки = ОснованиеОбъект.НомерКорректировки + 1;
	
КонецПроцедуры

Процедура ЗаполнитьКорректировкуШапка(Объект, ОснованиеОбъект)

	ИменаИсключенныхПолейШапки =
	"Ссылка,
	|ВерсияДанных,
	|ПометкаУдаления,
	|Номер,
	|Дата,
	|Проведен,
	|Комментарий,
	|ДокументОснование,
	|Ответственный,
	|ЭтоКорректировка,
	|НомерКорректировки";
	ИсключаемыеПоля = Новый Массив;
	ИсключаемыеПоля.Добавить(ИменаИсключенныхПолейШапки);
	Для каждого ТабЧасть Из ОснованиеОбъект.Метаданные().ТабличныеЧасти Цикл
		ИсключаемыеПоля.Добавить(ТабЧасть.Имя);
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(Объект, ОснованиеОбъект, , СтрСоединить(ИсключаемыеПоля, ","));

КонецПроцедуры

Процедура ЗаполнитьКорректировкуНоменклатура(Объект, ОснованиеОбъект)
	
	ИменаПолей =
	"Номенклатура,
	|Количество,
	|Цена,
	|Сумма,
	|СтавкаНДС,
	|Всего,
	|СуммаНДС,
	|СчетУчета,
	|ДополнительнаяАналитикаСчета,
	|КПС,
	|КоличествоВсегоДМ,
	|КЭК,
	|ИдентификаторСтроки,
	|ПрослеживаемыйТовар,
	|СтранаПроисхождения";
	
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(Объект, ОснованиеОбъект, "Номенклатура", ИменаПолей); 
	
	КорректируемыеКолонки =
	"Количество,
	|Цена,
	|Сумма,
	|СуммаНДС,
	|Всего";
	УправлениеМатериальнымиЗапасами.ЗаполнитьКолонкиДоКорректировки(Объект.Номенклатура, КорректируемыеКолонки);
	
КонецПроцедуры

Процедура ЗаполнитьКорректировкуВозвратнаяТара(Объект, ОснованиеОбъект)
	
	ИменаПолей =
	"Номенклатура,
	|Количество,
	|Сумма,
	|СчетУчета,
	|КПС,
	|ДополнительнаяАналитикаСчета,
	|КЭК";
	
	УправлениеМатериальнымиЗапасами.СкопироватьТабличнуюЧастьОбъекта(Объект, ОснованиеОбъект, "ВозвратнаяТара", ИменаПолей); 
	
	КорректируемыеКолонки =
	"Количество,
	|Сумма";
	УправлениеМатериальнымиЗапасами.ЗаполнитьКолонкиДоКорректировки(Объект.ВозвратнаяТара, КорректируемыеКолонки);
	
КонецПроцедуры

