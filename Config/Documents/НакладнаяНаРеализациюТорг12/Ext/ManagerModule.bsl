Функция ПредварительныйКонтрольДанныхДляЭД(ДокументСсылка) Экспорт
	Результат = Истина;
	
	ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		ДокументСсылка.Организация, ВидКИАдрес);
		
	Если НЕ ЗначениеЗаполнено(АдресОрганизации) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес организации.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Контрагент) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен контрагент.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	Иначе
		Контрагент = ДокументСсылка.Контрагент;
		
		Если ЗначениеЗаполнено(Контрагент.ЮридическоеФизическоеЛицо) Тогда
			Если ТипЗнч(Контрагент.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
			Иначе
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
			КонецЕсли;
			АдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Контрагент.ЮридическоеФизическоеЛицо, ВидКИАдрес);
			
			Если НЕ ЗначениеЗаполнено(АдресКонтрагента) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес контрагента.'");
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;	
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнено юридическое/физическое лицо контрагента.'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.РасчетныйСчетКонтрагента) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен расчетный счет контрагента в форме по ссылке ""Сведения для электронного УПД"" на закладке ""Дополнительно"".'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.РеквизитыЛицевогоСчета) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнены реквизиты лицевого счета в форме по ссылке ""Сведения для электронного УПД"" на закладке ""Дополнительно"".'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДокументСсылка.Грузоотправитель) Тогда
		Если НЕ ЗначениеЗаполнено(ДокументСсылка.РасчетныйСчетГрузоотправителя) Тогда
			ОписаниеОшибки = НСтр("ru='Заполнен грузоотправитель, но не заполнен расчетный счет грузоотправителя в форме по ссылке ""Сведения для электронного УПД"" на закладке ""Дополнительно"".'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДокументСсылка.Грузополучатель) Тогда
		Если НЕ ЗначениеЗаполнено(ДокументСсылка.РасчетныйСчетГрузополучателя) Тогда
			ОписаниеОшибки = НСтр("ru='Заполнен грузополучатель, но не заполнен расчетный счет грузополучателя в форме по ссылке ""Сведения для электронного УПД"" на закладке ""Дополнительно"".'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	НеобходимостьДанныхЭДОПродавцаДляГосНужд = ЭлектронныеДокументыБГУ.ВидимостьДанныхЭДОПродавцаДляГосНужд(ДокументСсылка.Контрагент, ДокументСсылка.Организация);
	Если НеобходимостьДанныхЭДОПродавцаДляГосНужд Тогда
		ДанныеЭДОПродавцаДляГосНужд = ЭлектронныеДокументыБГУ.ДанныеДляЭДПродавцаДляГосНужд(ДокументСсылка);
		Если НЕ ЗначениеЗаполнено(ДанныеЭДОПродавцаДляГосНужд.ДатаГосКонтракта) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнена дата гос.контракта в карточке договора %1 (реквизит ""от"" на закладке ""Обязательство"").'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка.Договор);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(ДанныеЭДОПродавцаДляГосНужд.НомерГосКонтракта) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнен номер гос.контракта в карточке договора %1 (реквизит ""№"" на закладке ""Обязательство"").'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДокументСсылка.Договор);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Для Каждого ТекСтрока Из ДокументСсылка.Номенклатура Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.Номенклатура, "ЕдиницаИзмерения, КодПоКТРУ, КодКаталога");
			
			Если НЕ ЗначениеЗаполнено(ДанныеНоменклатуры.ЕдиницаИзмерения) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнена единица измерения в карточке номенклатуры в строке %1 таблицы на закладке ""Материалы"".'");
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнена номенклатура в строке %1 таблицы на закладке ""Материалы"".'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ДокументСсылка.ВозвратнаяТара Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура.ЕдиницаИзмерения) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнена единица измерения в карточке номенклатуры в строке %1 таблицы на закладке ""Возвратная тара"".'");
				ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнена номенклатура в строке %1 таблицы на закладке ""Возвратная тара"".'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЦикла;
	
	ЭлектронныеДокументыБГУ.ПроверитьЗаполнениеДанныхМаркировкиВТаблицеМатериалов(ДокументСсылка, "Номенклатура", "Номенклатура", "Номенклатура", Результат);
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата, Номер, ЭтоКорректировка, ДокументОснование");
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ПериодДвижений", ДанныеДокумента.Дата);
	Запрос.УстановитьПараметр("ИмяДокументаДМ", НСтр("ru = 'Накладная на реализацию (Торг-12)'"));
	
	Запрос.УстановитьПараметр("НомерДокумента", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ДанныеДокумента.Номер));
	Если ДанныеДокумента.ЭтоКорректировка Тогда
		Запрос.УстановитьПараметр("КорректируемыйДокумент", ДанныеДокумента.ДокументОснование);
	КонецЕсли;
	
	НомераТаблиц = Новый Структура;
	
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц, ДанныеДокумента.ЭтоКорректировка, ДанныеДокумента.ДокументОснование);
	
	ИнициализироватьЗапросыПоРеализованнымТоварамКомитентов(Запрос, НомераТаблиц, ДокументСсылка, ДанныеДокумента.Дата);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
	УчетНДСРаздельный.ДобавитьДвиженияНеоблагаемыеНДСОперации(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
	ДобавитьДвиженияРасходОстаткиКодовИСМП(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц, ЭтоКорректировка, КорректируемыйДокумент)

	ПараметрыЗапроса = УчетДрагМатериалов.ТекстЗапросаДвиженияНаличиеДрагМатериаловВОбъектахНФА_Параметры(
		"Документ.НакладнаяНаРеализациюТорг12.ДрагоценныеМатериалы", "Расход");
	ПараметрыЗапроса.ЭтоКорректировка = ЭтоКорректировка;
	ПараметрыЗапроса.КорректируемыйДокумент = КорректируемыйДокумент;

	УчетДрагМатериалов.ИнициализироватьДанныеДокумента(Запрос, НомераТаблиц, ПараметрыЗапроса);
	 
КонецПроцедуры	

Процедура ДобавитьДвиженияРасходОстаткиКодовИСМП(ТаблицыДляДвижений, ДокументСсылка)

	Если ОбменИСМПБГУ.ВедетсяКонтрольОстатковКодовИСМП(ДокументСсылка.Организация) Тогда
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыУпаковокМаркируемойПродукции.Ссылка.Организация КАК Организация,
		|	КодыУпаковокМаркируемойПродукции.НомерУпаковки КАК КодИСМП,
		|	НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура КАК Номенклатура,
		|	КодыУпаковокМаркируемойПродукции.Ссылка.Дата КАК Период,
		|	КодыУпаковокМаркируемойПродукции.Ссылка КАК Регистратор,
		|	1 КАК Количество,
		|	НакладнаяНаРеализациюТорг12Номенклатура.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТКоды
		|ИЗ
		|	Документ.НакладнаяНаРеализациюТорг12.КодыУпаковокМаркируемойПродукции КАК КодыУпаковокМаркируемойПродукции
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НакладнаяНаРеализациюТорг12.Номенклатура КАК НакладнаяНаРеализациюТорг12Номенклатура
		|		ПО КодыУпаковокМаркируемойПродукции.Ссылка = НакладнаяНаРеализациюТорг12Номенклатура.Ссылка
		|			И КодыУпаковокМаркируемойПродукции.ИдентификаторСтроки = НакладнаяНаРеализациюТорг12Номенклатура.ИдентификаторСтроки
		|ГДЕ
		|	КодыУпаковокМаркируемойПродукции.Ссылка = &ДокументСсылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НакладнаяНаРеализациюТорг12Номенклатура.Ссылка.Организация,
		|	НакладнаяНаРеализациюТорг12Номенклатура.КодGTIN,
		|	НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура,
		|	НакладнаяНаРеализациюТорг12Номенклатура.Ссылка.Дата,
		|	НакладнаяНаРеализациюТорг12Номенклатура.Ссылка,
		|	НакладнаяНаРеализациюТорг12Номенклатура.Количество,
		|	НакладнаяНаРеализациюТорг12Номенклатура.НомерСтроки
		|ИЗ
		|	Документ.НакладнаяНаРеализациюТорг12.Номенклатура КАК НакладнаяНаРеализациюТорг12Номенклатура
		|ГДЕ
		|	НакладнаяНаРеализациюТорг12Номенклатура.Ссылка = &ДокументСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТКоды.Организация КАК Организация,
		|	ВТКоды.КодИСМП КАК КодИСМП,
		|	ВТКоды.Номенклатура КАК Номенклатура,
		|	ВТКоды.Период КАК Период,
		|	ВТКоды.Регистратор КАК Регистратор,
		|	СУММА(ВТКоды.Количество) КАК Количество,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
		|	ВТКоды.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	ВТКоды КАК ВТКоды
		|ГДЕ
		|	ВТКоды.КодИСМП <> """"
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТКоды.Организация,
		|	ВТКоды.КодИСМП,
		|	ВТКоды.Номенклатура,
		|	ВТКоды.Период,
		|	ВТКоды.Регистратор,
		|	ВТКоды.НомерСтроки"; 
		
		ТаблицаДвиженийОстаткиКодовИСМП = Запрос.Выполнить().Выгрузить();  
		
		ТаблицыДляДвижений.Вставить("КодыИСМПБГУ", ТаблицаДвиженийОстаткиКодовИСМП);  
		Если ТаблицаДвиженийОстаткиКодовИСМП.Количество() > 0 Тогда 
			ОбменИСМПБГУ.ПроверитьОстаткиКодовИСМП(ДокументСсылка, ТаблицаДвиженийОстаткиКодовИСМП);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоРеализованнымТоварамКомитентов(Запрос, НомераТаблиц, ДокументСсылка, ДатаДокумента)
	
	Запрос.УстановитьПараметр("Счет", БухгалтерскийУчет.СписокСчетов("02.33", ДатаДокумента));
	Запрос.УстановитьПараметр("Период", Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
	
	НомераТаблиц.Вставить("ДанныеДокумента", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ОстаткиМатериаловПоПартиям", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("РеализованныеТоварыКомитентов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + 
	"ВЫБРАТЬ
	|	НакладнаяНаРеализациюТорг12.Дата КАК Период,
	|	НакладнаяНаРеализациюТорг12.Организация КАК Организация,
	|	НакладнаяНаРеализациюТорг12.Контрагент КАК Покупатель,
	|	НакладнаяНаРеализациюТорг12.Дата КАК ДатаРеализации,
	|	НакладнаяНаРеализациюТорг12.Ссылка КАК ДокументРасчетов,
	|	НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура КАК Номенклатура,
	|	НакладнаяНаРеализациюТорг12Номенклатура.Количество КАК Количество,
	|	НакладнаяНаРеализациюТорг12Номенклатура.Всего КАК Выручка,
	|	НакладнаяНаРеализациюТорг12Номенклатура.ДополнительнаяАналитикаСчета КАК Партия,
	|	НакладнаяНаРеализациюТорг12Номенклатура.СуммаНДС КАК СуммаНДС,
	|	НакладнаяНаРеализациюТорг12.ЦМО КАК ЦМО
	|ПОМЕСТИТЬ ДанныеДокумента
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12.Номенклатура КАК НакладнаяНаРеализациюТорг12Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НакладнаяНаРеализациюТорг12 КАК НакладнаяНаРеализациюТорг12
	|		ПО НакладнаяНаРеализациюТорг12Номенклатура.Ссылка = НакладнаяНаРеализациюТорг12.Ссылка
	|ГДЕ
	|	НакладнаяНаРеализациюТорг12.Ссылка = &Ссылка
	|	И НЕ НакладнаяНаРеализациюТорг12.Резервировать
	|	И НакладнаяНаРеализациюТорг12Номенклатура.СчетУчета В(&Счет)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Документ.ПоступлениеМЗ) КАК Партия,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ЦМО) КАК ЦМО,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК СуммаОстаток,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ ОстаткиМатериаловПоПартиям
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&Счет), , ) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ДанныеДокумента.Период КАК Период,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ОстаткиМатериаловПоПартиям.Партия.Контрагент КАК Контрагент,
	|	ОстаткиМатериаловПоПартиям.Партия.Договор КАК ДоговорКомитента,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	ДанныеДокумента.Покупатель КАК Покупатель,
	|	ДанныеДокумента.ДатаРеализации КАК ДатаРеализации,
	|	ДанныеДокумента.ДокументРасчетов КАК ДокументРасчетов,
	|	СУММА(ДанныеДокумента.Количество) КАК Количество,
	|	СУММА(ДанныеДокумента.Выручка) КАК Выручка,
	|	СУММА(ВЫБОР
	|			КОГДА ОстаткиМатериаловПоПартиям.КоличествоОстаток > 0
	|				ТОГДА ОстаткиМатериаловПоПартиям.СуммаОстаток / ОстаткиМатериаловПоПартиям.КоличествоОстаток * ДанныеДокумента.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаПоступления,
	|	СУММА(ДанныеДокумента.СуммаНДС) КАК СуммаНДС
	|ИЗ
	|	ДанныеДокумента КАК ДанныеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиМатериаловПоПартиям КАК ОстаткиМатериаловПоПартиям
	|		ПО ДанныеДокумента.Партия = ОстаткиМатериаловПоПартиям.Партия
	|			И ДанныеДокумента.Номенклатура = ОстаткиМатериаловПоПартиям.Номенклатура
	|			И ДанныеДокумента.ЦМО = ОстаткиМатериаловПоПартиям.ЦМО
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.Организация,
	|	ОстаткиМатериаловПоПартиям.Партия.Контрагент,
	|	ОстаткиМатериаловПоПартиям.Партия.Договор,
	|	ДанныеДокумента.Номенклатура,
	|	ДанныеДокумента.Покупатель,
	|	ДанныеДокумента.ДатаРеализации,
	|	ДанныеДокумента.ДокументРасчетов,
	|	ДанныеДокумента.Период"; 
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.НакладнаяНаРеализациюТорг12";
	КомандаПечати.Идентификатор		= "Накладная0330212";
	КомандаПечати.Представление		= НСтр("ru = 'Товарная накладная (ТОРГ-12)'");
	КомандаПечати.Порядок			= 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.НакладнаяНаРеализациюТорг12";
	КомандаПечати.Идентификатор		= "ПечатьТТН_1208";
	КомандаПечати.Представление		= Нстр("ru='Товарно-транспортная накладная (ф. № 1-Т)'");
	КомандаПечати.Обработчик		= "УправлениеПечатьюБГУКлиент.ПечатьТТН";
	
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОСодержанииДрагМатериалов", 3);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры:
//   МассивОбъектов  - Массив из ДокументСсылка.НакладнаяНаРеализациюТорг12    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - ТаблицаЗначений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений из ДокументСсылка.НакладнаяНаРеализациюТорг12   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0330212") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"Накладная0330212","Товарная накладная (Торг-12)",ПечатьНакладной0330212(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
		
КонецПроцедуры // Печать()

Функция РасчетныйСчетДляПечати(РасчетныйСчет, РеквизитыЛицевогоСчета, ПолучатьТекстКорреспондент)
	
	Если НЕ ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
		Возврат "";
	КонецЕсли;
	
	СтруктураПлатежныхРеквизитов = Новый Структура("Бик, Банк, Корреспондент, СчетНомер, КоррСчет");
	СтруктураПлатежныхРеквизитов.Бик           = "Бик";
	СтруктураПлатежныхРеквизитов.Банк          = "Банк";
	СтруктураПлатежныхРеквизитов.Корреспондент = "Корреспондент";
	СтруктураПлатежныхРеквизитов.СчетНомер     = "СчетНомер";
	СтруктураПлатежныхРеквизитов.КоррСчет      = "КоррСчет";
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(РасчетныйСчет,
																			РеквизитыЛицевогоСчета,
																			СтруктураПлатежныхРеквизитов);
	
	Возврат ПредставлениеРС(СтруктураПлатежныхРеквизитов.СчетНомер,
		СтруктураПлатежныхРеквизитов.Банк,
		СтруктураПлатежныхРеквизитов.КоррСчет,
		СтруктураПлатежныхРеквизитов.Бик,
		?(ПолучатьТекстКорреспондент, СтруктураПлатежныхРеквизитов.Корреспондент, ""));

КонецФункции

Функция ПредставлениеРС(НомерРС, Банк, КоррСчет, БИК, Корреспондент)

	Результат = Новый Массив;
	Если ЗначениеЗаполнено(НомерРС) Тогда
		Результат.Добавить(СтрШаблон(НСтр("ru = 'р/с %1 в %2'"), НомерРС, Банк));
		Если ЗначениеЗаполнено(Корреспондент) Тогда
			Результат.Добавить(Корреспондент);
		КонецЕсли;
		Если ЗначениеЗаполнено(КоррСчет) Тогда
			Результат.Добавить(СтрШаблон(НСтр("ru = 'к/с %1'"), КоррСчет));
		КонецЕсли;
		Если ЗначениеЗаполнено(БИК) Тогда
			Результат.Добавить(СтрШаблон(НСтр("ru = 'БИК %1'"), БИК));
		КонецЕсли;
	КонецЕсли;
	Возврат СтрСоединить(Результат, ", ");

КонецФункции

Функция ПредставлениеКонтрагентаДляПечати(Наименование, ИНН, КПП, Адрес, Телефон, Факс, РасчетныйСчет)
	
	Результат = Новый Массив;
	Результат.Добавить(Наименование);
	Если ЗначениеЗаполнено(ИНН) Тогда
		ТекстИНН = ?(ЗначениеЗаполнено(КПП), НСтр("ru = 'ИНН/КПП %1/%2'"), НСтр("ru = 'ИНН %1'"));
		Результат.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстИНН, ИНН, КПП));
	КонецЕсли;
	Если ЗначениеЗаполнено(Адрес) Тогда
		Результат.Добавить(СтрШаблон(НСтр("ru = 'адрес: %1'"), Адрес));
	КонецЕсли;
	Если ЗначениеЗаполнено(Телефон) Тогда
		Результат.Добавить(СтрШаблон(НСтр("ru = 'т.: %1'"), Телефон));
	КонецЕсли;
	Если ЗначениеЗаполнено(Факс) Тогда
		Результат.Добавить(СтрШаблон(НСтр("ru = 'факс: %1'"), Факс));
	КонецЕсли;
	Если ЗначениеЗаполнено(РасчетныйСчет) Тогда
		Результат.Добавить(РасчетныйСчет);
	КонецЕсли;
	
	Возврат СтрСоединить(Результат, ", ");
	
КонецФункции

Функция ЮридическийАдресКонтрагента(Контрагент, ВидКонтрагента)

	Если ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда 
		
		Возврат УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Контрагент, Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты);
		
	Иначе
		
		Возврат УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Контрагент, Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица);
		
	КонецЕсли;

КонецФункции

Функция ПочтовыйАдресКонтрагента(Контрагент, ВидКонтрагента)

	Если ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда 
		
		Возврат УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Контрагент, Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты);
		
	Иначе
		
		Возврат УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Контрагент, Справочники.ВидыКонтактнойИнформации.АдресДляИнформированияФизическиеЛица);
		
	КонецЕсли;

КонецФункции

Функция ТелефонКонтрагента(Контрагент, ВидКонтрагента)

	Если ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда 
		ВидКИ = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты;
	Иначе
		ВидКИ = Справочники.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица;
	КонецЕсли;
	
	Возврат УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Контрагент, ВидКИ);

КонецФункции

Функция ПараметрыЗаполненияКонтрагентовВШапке(ВыборкаШапка)

	СтруктураОбластьМакетаШапка = Новый Структура("пГрузоотправитель,пКодОКПОГрузоотправитель,пГрузополучатель,пКодОКПОГрузополучатель,пНаименованиеОрганизации,пКодОКПО,пКонтрагент,пКодОКПОКонтрагент");
	
	
	ПоставщикТелефон  = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
																	Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
	ПоставщикФакс     = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация,
																	Справочники.ВидыКонтактнойИнформации.ФаксОрганизации);
	ПоставщикБанкСчет = РасчетныйСчетДляПечати(ВыборкаШапка.РасчетныйСчетОрганизации,
		ВыборкаШапка.РеквизитыЛицевогоСчета,
		ЗначениеЗаполнено(ВыборкаШапка.КорреспондентТекст));
	
	Если ЗначениеЗаполнено(ВыборкаШапка.ГоловнаяОрганизация) Тогда
		ГоловнаяОрганизацияТелефон  = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.ГоловнаяОрганизация,
																		Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
		ГоловнаяОрганизацияФакс     = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.ГоловнаяОрганизация,
																		Справочники.ВидыКонтактнойИнформации.ФаксОрганизации);
		СтруктураОбластьМакетаШапка.пНаименованиеОрганизации = ПредставлениеКонтрагентаДляПечати(
			ВыборкаШапка.НаименованиеГоловнойОрганизации,
			ВыборкаШапка.ГоловнаяОрганизацияИНН,
			ВыборкаШапка.ГоловнаяОрганизацияКПП,
			УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.ГоловнаяОрганизация, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации),
			ГоловнаяОрганизацияТелефон,
			ГоловнаяОрганизацияФакс,
			Неопределено);
		СтруктураОбластьМакетаШапка.пКодОКПО  = ВыборкаШапка.ГоловнаяОрганизацияКодОКПО;
	Иначе
		СтруктураОбластьМакетаШапка.пНаименованиеОрганизации = ПредставлениеКонтрагентаДляПечати(
			ВыборкаШапка.НаименованиеОрганизации,
			ВыборкаШапка.ОрганизацияИНН,
			ВыборкаШапка.ОрганизацияКПП,
			УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации),
			ПоставщикТелефон,
			ПоставщикФакс,
			ПоставщикБанкСчет);
		СтруктураОбластьМакетаШапка.пКодОКПО  = ВыборкаШапка.ОрганизацияКодОКПО;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВыборкаШапка.Грузоотправитель) Тогда
		// Грузоотправитель = Поставщик. Используется фактический адрес.
		
		СтруктураОбластьМакетаШапка.пКодОКПОГрузоотправитель = ВыборкаШапка.ОрганизацияКодОКПО;
		
		СтруктураОбластьМакетаШапка.пГрузоотправитель = ПредставлениеКонтрагентаДляПечати(
			ВыборкаШапка.НаименованиеОрганизации,
			ВыборкаШапка.ОрганизацияИНН,
			ВыборкаШапка.ОрганизацияКПП,
			УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаШапка.Организация, Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации),
			ПоставщикТелефон,
			ПоставщикФакс,
			ПоставщикБанкСчет);
	Иначе
		
		ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, НаименованиеПолное, КодОКПО, ИНН, КПП", ВыборкаШапка.Грузоотправитель);
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
		
		Если ВыборкаШапка.ВидГрузоотправителя = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			ГрузоотправительНаименование = ДанныеКонтрагента.НаименованиеПолное;
		Иначе
			Если ЗначениеЗаполнено(ВыборкаШапка.ГрузоотправительНаименованиеСокращенное) Тогда
				ГрузоотправительНаименование = ВыборкаШапка.ГрузоотправительНаименованиеСокращенное;
			Иначе
				ГрузоотправительНаименование = ДанныеКонтрагента.НаименованиеПолное;
			КонецЕсли;
		КонецЕсли;

		СтруктураОбластьМакетаШапка.пКодОКПОГрузоотправитель = ДанныеКонтрагента.КодОКПО;
		
		СтруктураОбластьМакетаШапка.пГрузоотправитель = ПредставлениеКонтрагентаДляПечати(
			ГрузоотправительНаименование,
			ДанныеКонтрагента.ИНН,
			ДанныеКонтрагента.КПП,
			ПочтовыйАдресКонтрагента(ВыборкаШапка.ГрузоотправительЮридическоеФизическоеЛицо, ВыборкаШапка.ВидГрузоотправителя),
			ТелефонКонтрагента(ВыборкаШапка.ГрузоотправительЮридическоеФизическоеЛицо, ВыборкаШапка.ВидГрузоотправителя),
			"",
			РасчетныйСчетДляПечати(ВыборкаШапка.РасчетныйСчетГрузоотправителя,
				ВыборкаШапка.РасчетныйСчетГрузоотправителя,
				ЗначениеЗаполнено(ВыборкаШапка.ГрузоотправительКорреспондентТекст)));
		
	КонецЕсли;
		
	ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, НаименованиеПолное, КодОКПО, ИНН, КПП", ВыборкаШапка.Контрагент);
	Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
	
	Если ВыборкаШапка.КонтрагентОбособленноеПодразделение И ЗначениеЗаполнено(ВыборкаШапка.КонтрагентГоловнаяОрганизация) Тогда
			
		КонтрагентНаименование = ВыборкаШапка.КонтрагентГоловнаяОрганизацияПредставление;
		ГоловнаяОрганизацияИНН = ВыборкаШапка.КонтрагентГоловнаяОрганизацияИНН;
		ГоловнаяОрганизацияКПП = Справочники.Контрагенты.ПолучитьКПП(ВыборкаШапка.Контрагент, ВыборкаШапка.пДата);
		
		СтруктураДанныхГоловнойОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаШапка.КонтрагентГоловнаяОрганизация,
			"ВидКонтрагента, ЮридическоеФизическоеЛицо");
		
		СтруктураДанныхЮрЛицаГоловнойОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанныхГоловнойОрганизации.ЮридическоеФизическоеЛицо,
			"КодОКПО");
		
		СтруктураОбластьМакетаШапка.пКодОКПОКонтрагент		= СтруктураДанныхЮрЛицаГоловнойОрганизации.КодОКПО;
		КонтрагентТелефон = ТелефонКонтрагента(СтруктураДанныхГоловнойОрганизации.ЮридическоеФизическоеЛицо,
			СтруктураДанныхГоловнойОрганизации.ВидКонтрагента);
		
		КонтрагентБанкСчет		= РасчетныйСчетДляПечати(ВыборкаШапка.РасчетныйСчетКонтрагента,
			ВыборкаШапка.РасчетныйСчетКонтрагента,
			ЗначениеЗаполнено(ВыборкаШапка.КонтрагентКорреспондентТекст));
			
		СтруктураОбластьМакетаШапка.пКонтрагент = ПредставлениеКонтрагентаДляПечати(
			КонтрагентНаименование,
			ГоловнаяОрганизацияИНН,
			ГоловнаяОрганизацияКПП,
			ЮридическийАдресКонтрагента(ВыборкаШапка.КонтрагентГоловнаяОрганизация, СтруктураДанныхГоловнойОрганизации.ВидКонтрагента),
			КонтрагентТелефон,
			"",
			КонтрагентБанкСчет);
		
	Иначе
		Если ВыборкаШапка.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			КонтрагентНаименование = ДанныеКонтрагента.НаименованиеПолное;
		Иначе
			Если ЗначениеЗаполнено(ВыборкаШапка.КонтрагентНаименованиеСокращенное) Тогда
				КонтрагентНаименование = ВыборкаШапка.КонтрагентНаименованиеСокращенное;
			Иначе
				КонтрагентНаименование = ДанныеКонтрагента.НаименованиеПолное;
			КонецЕсли;
		КонецЕсли;
		
		СтруктураОбластьМакетаШапка.пКодОКПОКонтрагент		= ДанныеКонтрагента.КодОКПО;
		КонтрагентТелефон = ТелефонКонтрагента(ВыборкаШапка.КонтрагентЮридическоеФизическоеЛицо, ВыборкаШапка.ВидКонтрагента);
		
		КонтрагентБанкСчет		= РасчетныйСчетДляПечати(ВыборкаШапка.РасчетныйСчетКонтрагента,
			ВыборкаШапка.РасчетныйСчетКонтрагента,
			ЗначениеЗаполнено(ВыборкаШапка.КонтрагентКорреспондентТекст));
			
		СтруктураОбластьМакетаШапка.пКонтрагент = ПредставлениеКонтрагентаДляПечати(
			КонтрагентНаименование,
			ДанныеКонтрагента.ИНН,
			ДанныеКонтрагента.КПП,
			ЮридическийАдресКонтрагента(ВыборкаШапка.КонтрагентЮридическоеФизическоеЛицо, ВыборкаШапка.ВидКонтрагента),
			КонтрагентТелефон,
			"",
			КонтрагентБанкСчет);
		
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(ВыборкаШапка.Грузополучатель) Тогда
		// Грузополучатель = Покупатель. Используется почтовый адрес.
		СтруктураОбластьМакетаШапка.пГрузополучатель = ПредставлениеКонтрагентаДляПечати(
			КонтрагентНаименование,
			ДанныеКонтрагента.ИНН,
			ДанныеКонтрагента.КПП,
			ПочтовыйАдресКонтрагента(ВыборкаШапка.КонтрагентЮридическоеФизическоеЛицо, ВыборкаШапка.ВидКонтрагента),
			КонтрагентТелефон,
			"",
			КонтрагентБанкСчет);
		
	Иначе
		
		ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, НаименованиеПолное, КодОКПО, ИНН, КПП", ВыборкаШапка.Грузополучатель);
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
		
		Если ВыборкаШапка.ВидГрузополучателя = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			ГрузополучательНаименование = ДанныеКонтрагента.НаименованиеПолное;
		Иначе
			Если ЗначениеЗаполнено(ВыборкаШапка.КонтрагентНаименованиеСокращенное) Тогда
				ГрузополучательНаименование = ВыборкаШапка.КонтрагентНаименованиеСокращенное;
			Иначе
				ГрузополучательНаименование = ДанныеКонтрагента.НаименованиеПолное;
			КонецЕсли;
		КонецЕсли;
		
		СтруктураОбластьМакетаШапка.пКодОКПОГрузополучатель	= ДанныеКонтрагента.КодОКПО;
		
		СтруктураОбластьМакетаШапка.пГрузополучатель = ПредставлениеКонтрагентаДляПечати(
			ГрузополучательНаименование,
			ДанныеКонтрагента.ИНН,
			ДанныеКонтрагента.КПП,
			ПочтовыйАдресКонтрагента(ВыборкаШапка.ГрузополучательЮридическоеФизическоеЛицо, ВыборкаШапка.ВидГрузополучателя),
			ТелефонКонтрагента(ВыборкаШапка.ГрузополучательЮридическоеФизическоеЛицо, ВыборкаШапка.ВидГрузополучателя),
			"",
			РасчетныйСчетДляПечати(ВыборкаШапка.РасчетныйСчетГрузополучателя,
				ВыборкаШапка.РасчетныйСчетГрузополучателя,
				ЗначениеЗаполнено(ВыборкаШапка.ГрузополучательКорреспондентТекст)));
		
	КонецЕсли;
	
	Возврат СтруктураОбластьМакетаШапка;

КонецФункции

Функция ПараметрыИтогПоСтранице(КоличествоПоСтранице, СуммаБезНДСПоСтранице, СуммаНДСПоСтранице, СуммаВсегоПоСтранице)

	СтруктураОбластьМакетаИтогоПоСтранице = Новый Структура("пКоличествоИтогоНаСтранице,пСуммаБезНДСИтогоНаСтранице,пСуммаНДСИтогоНаСтранице,пВсегоИтогоНаСтранице");

	СтруктураОбластьМакетаИтогоПоСтранице.пКоличествоИтогоНаСтранице  = КоличествоПоСтранице;
	СтруктураОбластьМакетаИтогоПоСтранице.пСуммаБезНДСИтогоНаСтранице = СуммаБезНДСПоСтранице;
	СтруктураОбластьМакетаИтогоПоСтранице.пСуммаНДСИтогоНаСтранице    = СуммаНДСПоСтранице;
	СтруктураОбластьМакетаИтогоПоСтранице.пВсегоИтогоНаСтранице       = СуммаВсегоПоСтранице;
	
	Возврат СтруктураОбластьМакетаИтогоПоСтранице;

КонецФункции

Функция ПечатьНакладной0330212(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_НакладнаяТорг12";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_Накладная0330212");
	ОбластьМакетаШапка  			= Макет.ПолучитьОбласть("Шапка");
	ОбластьМакетаЗаголовок			= Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакетаСтрока 			= Макет.ПолучитьОбласть("Строка");
	ОбластьМакетаВсего  			= Макет.ПолучитьОбласть("Всего");
	ОбластьМакетаИтогоПоСтранице	= Макет.ПолучитьОбласть("ИтогоПоСтранице");
	ОбластьМакетаПодвал				= Макет.ПолучитьОбласть("Подвал");
	
	МассивСтрокДляВывода = Новый Массив;
	МассивСтрокДляВывода.Добавить(ОбластьМакетаСтрока);
	МассивСтрокДляВывода.Добавить(ОбластьМакетаСтрока);
	МассивСтрокДляВывода.Добавить(ОбластьМакетаИтогоПоСтранице);
	
	МассивСтрокДляВыводаСПодвалом = Новый Массив;
	МассивСтрокДляВыводаСПодвалом.Добавить(ОбластьМакетаСтрока);
	МассивСтрокДляВыводаСПодвалом.Добавить(ОбластьМакетаИтогоПоСтранице);
	МассивСтрокДляВыводаСПодвалом.Добавить(ОбластьМакетаВсего);
	МассивСтрокДляВыводаСПодвалом.Добавить(ОбластьМакетаПодвал);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НакладнаяНаРеализациюТорг12.Ссылка КАК Ссылка,
	|	НакладнаяНаРеализациюТорг12.Дата КАК пДата,
	|	НакладнаяНаРеализациюТорг12.Номер КАК пНомер,
	|	НакладнаяНаРеализациюТорг12.Организация.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	|	НакладнаяНаРеализациюТорг12.Организация.ГоловнаяОрганизация.НаименованиеПолное КАК НаименованиеГоловнойОрганизации,
	|	НакладнаяНаРеализациюТорг12.Организация.ГоловнаяОрганизация.КодОКПО КАК ГоловнаяОрганизацияКодОКПО,
	|	НакладнаяНаРеализациюТорг12.Организация КАК Организация,
	|	НакладнаяНаРеализациюТорг12.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	|	НакладнаяНаРеализациюТорг12.Организация.КодОКПО КАК ОрганизацияКодОКПО,
	|	НакладнаяНаРеализациюТорг12.Контрагент КАК Контрагент,
	|	ЕСТЬNULL(НакладнаяНаРеализациюТорг12.Контрагент.ВидКонтрагента, ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ПустаяСсылка)) КАК ВидКонтрагента,
	|	ЕСТЬNULL(НакладнаяНаРеализациюТорг12.Контрагент.ЮридическоеФизическоеЛицо, ЗНАЧЕНИЕ(Справочник.ЮридическиеЛица.ПустаяСсылка)) КАК КонтрагентЮридическоеФизическоеЛицо,
	|	НакладнаяНаРеализациюТорг12.Грузоотправитель КАК Грузоотправитель,
	|	ЕСТЬNULL(НакладнаяНаРеализациюТорг12.Грузоотправитель.ВидКонтрагента, ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ПустаяСсылка)) КАК ВидГрузоотправителя,
	|	ЕСТЬNULL(НакладнаяНаРеализациюТорг12.Грузоотправитель.ЮридическоеФизическоеЛицо, ЗНАЧЕНИЕ(Справочник.ЮридическиеЛица.ПустаяСсылка)) КАК ГрузоотправительЮридическоеФизическоеЛицо,
	|	НакладнаяНаРеализациюТорг12.Грузоотправитель.НаименованиеСокращенное КАК ГрузоотправительНаименованиеСокращенное,
	|	НакладнаяНаРеализациюТорг12.Грузополучатель КАК Грузополучатель,
	|	ЕСТЬNULL(НакладнаяНаРеализациюТорг12.Грузополучатель.ВидКонтрагента, ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ПустаяСсылка)) КАК ВидГрузополучателя,
	|	ЕСТЬNULL(НакладнаяНаРеализациюТорг12.Грузополучатель.ЮридическоеФизическоеЛицо, ЗНАЧЕНИЕ(Справочник.ЮридическиеЛица.ПустаяСсылка)) КАК ГрузополучательЮридическоеФизическоеЛицо,
	|	НакладнаяНаРеализациюТорг12.Договор КАК Договор,
	|	НакладнаяНаРеализациюТорг12.Договор.Представление КАК пДоговор,
	|	ЕСТЬNULL(НакладнаяНаРеализациюТорг12.Договор.НомерДоговора, """") КАК пНомерДоговора,
	|	ЕСТЬNULL(НакладнаяНаРеализациюТорг12.Договор.ДатаДоговора, ДАТАВРЕМЯ(1, 1, 1)) КАК пДатаДоговора,
	|	НакладнаяНаРеализациюТорг12.Отпустил КАК Отпустил,
	|	ЕСТЬNULL(НакладнаяНаРеализациюТорг12Номенклатура.НомерСтроки, 0) КАК пНомерСтроки,
	|	НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура.НаименованиеПолное = """"
	|			ТОГДА НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура.Наименование
	|		ИНАЧЕ НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура.НаименованиеПолное
	|	КОНЕЦ КАК пНоменклатура,
	|	НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура.НаименованиеПолное КАК НоменклатураНаименованиеПолное,
	|	ВЫБОР
	|		КОГДА НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура.НоменклатурныйНомер = """"
	|			ТОГДА НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура.Код
	|		ИНАЧЕ НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура.НоменклатурныйНомер
	|	КОНЕЦ КАК пНоменклатурныйНомер,
	|	НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура.ЕдиницаИзмерения.Представление КАК пЕдиница,
	|	НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура.ЕдиницаИзмерения.Код КАК пКодЕдиницы,
	|	ЕСТЬNULL(НакладнаяНаРеализациюТорг12Номенклатура.Количество, 0) КАК пКоличество,
	|	ВЫБОР
	|		КОГДА НЕ НакладнаяНаРеализациюТорг12.СуммаВключаетНДС
	|			ТОГДА ЕСТЬNULL(НакладнаяНаРеализациюТорг12Номенклатура.Цена, 0)
	|		ИНАЧЕ ВЫБОР
	|				КОГДА НакладнаяНаРеализациюТорг12Номенклатура.Количество <> 0
	|					ТОГДА (НакладнаяНаРеализациюТорг12Номенклатура.Всего - НакладнаяНаРеализациюТорг12Номенклатура.СуммаНДС) / НакладнаяНаРеализациюТорг12Номенклатура.Количество
	|				ИНАЧЕ НакладнаяНаРеализациюТорг12Номенклатура.Всего - НакладнаяНаРеализациюТорг12Номенклатура.СуммаНДС
	|			КОНЕЦ
	|	КОНЕЦ КАК пЦена,
	|	ВЫБОР
	|		КОГДА НЕ НакладнаяНаРеализациюТорг12.СуммаВключаетНДС
