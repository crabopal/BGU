#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	ПрослеживаемостьБГУ.ОбработкаПроведения(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	ТипОснования = ТипЗнч(ДанныеЗаполнения);
	Если ТипОснования = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("КорректируемыйДокумент") Тогда
			Документы.НакладнаяНаРеализациюТорг12.ЗаполнитьКорректировку(ДанныеЗаполнения.КорректируемыйДокумент, ЭтотОбъект);
		КонецЕсли;
	ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипОснования) Тогда
		ТекстСообщения = "";
		Если НЕ Документы.НакладнаяНаРеализациюТорг12.ЗаполнитьНаОсновании(ДанныеЗаполнения, ЭтотОбъект, ТекстСообщения) тогда
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	УправлениеМатериальнымиЗапасами.ПроверитьОчиститьКолонкуКПС(Номенклатура);
	УправлениеМатериальнымиЗапасами.ПроверитьОчиститьКолонкуКПС(ВозвратнаяТара);
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	УправлениеМатериальнымиЗапасами.ДокументПередЗаписью(ЭтотОбъект, РежимЗаписи, Отказ);
	
	ПрослеживаемыйТовар = Номенклатура.НайтиСтроки(Новый Структура("ПрослеживаемыйТовар", Истина));
	ЕстьПрослеживаемыйТовар = ПрослеживаемыйТовар.Количество() <> 0;
	
	Если ЕстьПрослеживаемыйТовар Тогда
		ПрослеживаемостьБГУ.УстановкаВариантаКомплектаВТЧДокументов(ЭтотОбъект, "Номенклатура",, Отказ);
		
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			ПрослеживаемостьБГУ.ПодобратьРНПТ(ЭтотОбъект, Отказ, "Номенклатура");
		КонецЕсли;
	КонецЕсли;
	
	ПрослеживаемостьБГУ.УдалитьНеиспользуемыеСтрокиСведенийПрослеживаемости(ЭтотОбъект, "Номенклатура", Истина);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	НепроверяемыеРеквизиты.Добавить("Номенклатура.СтранаПроисхождения");
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУКлиентСервер.ВедетсяУчетПрослеживаемыхТоваров(Дата);
	ВедетсяУчетПоРеализацииТоваровУслугКомитентов = ПолучитьФункциональнуюОпцию("ВестиУчетПоРеализацииТоваровУслугКомитентов");
	Если ВедетсяУчетПрослеживаемыхТоваров Тогда
		ПрослеживаемыйТовар = Номенклатура.НайтиСтроки(Новый Структура("ПрослеживаемыйТовар", Истина));
		ЕстьПрослеживаемыйТовар = ПрослеживаемыйТовар.Количество() <> 0;
	Иначе
		ЕстьПрослеживаемыйТовар = Ложь;
	КонецЕсли;
	Если Не ЕстьПрослеживаемыйТовар Тогда
		НепроверяемыеРеквизиты.Добавить("КодОперацииПрослеживаемости");
	КонецЕсли;
	
	Если Не ЭтоКорректировка Тогда
		НепроверяемыеРеквизиты.Добавить("ДокументОснование");
	КонецЕсли;
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	Если ВедетсяУчетПоРеализацииТоваровУслугКомитентов Тогда
		ПроверитьЗаполнениеДополнительнойАналитикиКомиссионныхТоваров(ЭтотОбъект, Отказ);
	КонецЕсли;
	
	УправлениеМатериальнымиЗапасами.ПроверитьЗаполнениеКолонкиКПСВТаблицеМатериалов(ЭтотОбъект, "Номенклатура", "Номенклатура", Отказ);		
	УправлениеМатериальнымиЗапасами.ПроверитьЗаполнениеКолонкиКПСВТаблицеМатериалов(ЭтотОбъект, "ВозвратнаяТара", "Возвратная тара", Отказ);		
	ПрослеживаемостьБГУ.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, "Номенклатура");
	
	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);	
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(ЭтотОбъект);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет", Ложь);
	ПараметрыОбработки.Вставить("ДтКт",          "Кт");
	
	ТабличныеЧасти = Новый Массив;
	ТабличныеЧасти.Добавить(Номенклатура);
	ТабличныеЧасти.Добавить(ВозвратнаяТара);
	
	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
	
		Для каждого Строка Из ТабличнаяЧасть Цикл
			
			Если Не ЗначениеЗаполнено(Строка.КЭК) Тогда
				ПараметрыОбработки.Номенклатура = Строка.Номенклатура;
				ПараметрыОбработки.Счет         = Строка.СчетУчета;
				
				УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;
	
	Если ЭтоКорректировка Тогда
		ОчиститьРеквизитыКорректировки();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
 
Процедура ОчиститьРеквизитыКорректировки()

	РеквизитыКорректировки = Новый Структура;
	РеквизитыКорректировки.Вставить("Номенклатура", Новый Массив);
	РеквизитыКорректировки.Номенклатура.Добавить("КоличествоДоКорректировки");
	РеквизитыКорректировки.Номенклатура.Добавить("ЦенаДоКорректировки");
	РеквизитыКорректировки.Номенклатура.Добавить("СуммаДоКорректировки");
	РеквизитыКорректировки.Номенклатура.Добавить("СуммаНДСДоКорректировки");
	РеквизитыКорректировки.Номенклатура.Добавить("ВсегоДоКорректировки");

	РеквизитыКорректировки.Вставить("ВозвратнаяТара", Новый Массив);
	РеквизитыКорректировки.ВозвратнаяТара.Добавить("КоличествоДоКорректировки");
	РеквизитыКорректировки.ВозвратнаяТара.Добавить("СуммаДоКорректировки");
	
	УправлениеНФА.ОчиститьРеквизитыКорректировки(ЭтотОбъект, РеквизитыКорректировки);

КонецПроцедуры

#Область ЗаполнениеДокумента

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	
	ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА");
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА");
	ОбъектыДМ.Свернуть("ОбъектНФА");
	
	ТаблицаВсехОбъектов = Номенклатура.Выгрузить(,"СчетУчета, Номенклатура");
	
	ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
	ТаблицаОбъектовНФА.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	МассивСчетовМЗ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗ();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовМЗ.Найти(ТекСтрока.СчетУчета)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		ОбъектНФА = ТекСтрока.ОбъектНФА;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Номенклатура", ОбъектНФА);
		НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);   

		Если НайденныеСтроки.Количество() = 0 Тогда
			ПараметрыОтбораОбъекта = Новый Структура;
			ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
			СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
			Если СтрокиСпискаДМ.Количество()=1 Тогда
				ТекстСтрокиДМ = "В строке ";
			Иначе
				ТекстСтрокиДМ = "В строках ";
			КонецЕсли;
			Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
				ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
			КонецЦикла;	
			
			ТекстОшибки = НСтр("ru='"+Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2)+" списка ""Содержание драг. материалов"" указана информация по номенклатуре, которой нет в списке ""Материальные запасы"": %1'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ОбъектНФА);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			
		КонецЕсли;	
	КонецЦикла;	
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	Для каждого ТекСтрока Из ОбъектыДМ Цикл
		//контроль лом/не лом
		Если (ТекСтрока.МассаДМ > 0)И(ТекСтрока.ЛигатурнаяМасса > 0 ИЛИ ТекСтрока.ЧистаяМасса>0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" следует указать массу в реквизите ""Масса драг. материалов"" или в реквизитах ""Лигатурная масса лома"" и ""Чистая масса в ломе"": ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
		
		//заполнение количества драг. камней
		Если НЕ (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;	
	КонецЦикла;
	
	//контроль содержания учетных драг. материалов в списываемых НФА
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	&Организация КАК Организация,
	               |	ДрагМатериалыДокумента.ОбъектНФА,
	               |	ДрагМатериалыДокумента.МассаДМ,
	               |	ДрагМатериалыДокумента.ЛигатурнаяМасса,
	               |	ДрагМатериалыДокумента.ЧистаяМасса,
	               |	ДрагМатериалыДокумента.КоличествоДМ
	               |ПОМЕСТИТЬ ДрагМатериалыДокумента
	               |ИЗ
	               |	&ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	&Организация КАК Организация,
	               |	ОбъектыДокумента.Номенклатура
	               |ПОМЕСТИТЬ ОбъектыДокумента
	               |ИЗ
	               |	&ОбъектыДокумента КАК ОбъектыДокумента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОбъектыНФАДокумента.Организация,
	               |	ОбъектыНФАДокумента.Номенклатура КАК Номенклатура,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(ДрагМатериалыДокумента.МассаДМ, 0) = 0
	               |				И ЕСТЬNULL(ДрагМатериалыДокумента.ЛигатурнаяМасса, 0) = 0
	               |				И ЕСТЬNULL(ДрагМатериалыДокумента.ЧистаяМасса, 0) = 0
	               |				И ЕСТЬNULL(ДрагМатериалыДокумента.КоличествоДМ, 0) = 0
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ЕстьДрагМатериалы
	               |ПОМЕСТИТЬ ОбъектыНФАДокумента
	               |ИЗ
	               |	ОбъектыДокумента КАК ОбъектыНФАДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
	               |		ПО ОбъектыНФАДокумента.Организация = ДрагМатериалыДокумента.Организация
	               |			И ОбъектыНФАДокумента.Номенклатура = ДрагМатериалыДокумента.ОбъектНФА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК ОбъектНФА,
	               |	0 КАК ЧистаяМассаОстаток,
	               |	0 КАК ЛигатурнаяМассаОстаток,
	               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток КАК МассаДМОстаток,
	               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток КАК КоличествоДМОстаток,
	               |	ОбъектыНФАДокумента.ЕстьДрагМатериалы КАК ЕстьДрагМатериалы
	               |ИЗ
	               |	ОбъектыНФАДокумента КАК ОбъектыНФАДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&ДатаСведений, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
	               |		ПО (НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА = ОбъектыНФАДокумента.Номенклатура)
	               |			И (НаличиеДрагМатериаловВОбъектахНФАОстатки.Организация = ОбъектыНФАДокумента.Организация)
	               |ГДЕ
	               |	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА, 0) <> 0
	               |	И ОбъектыНФАДокумента.ЕстьДрагМатериалы = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА,
	               |	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток,
	               |	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЛигатурнаяМассаОстаток,
	               |	0,
	               |	0,
	               |	ОбъектыНФАДокумента.ЕстьДрагМатериалы
	               |ИЗ
	               |	ОбъектыНФАДокумента КАК ОбъектыНФАДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВЛомеИОтходах.Остатки(&ДатаСведений, Организация = &Организация) КАК НаличиеДрагМатериаловВЛомеИОтходахОстатки
	               |		ПО (НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА = ОбъектыНФАДокумента.Номенклатура)
	               |			И (НаличиеДрагМатериаловВЛомеИОтходахОстатки.Организация = ОбъектыНФАДокумента.Организация)
	               |ГДЕ
	               |	ЕСТЬNULL(НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА, 0) <> 0
	               |	И ОбъектыНФАДокумента.ЕстьДрагМатериалы = ЛОЖЬ";
				   
	ТаблицаОбъектовНФА = Номенклатура.Выгрузить(,"Номенклатура");
	
	Запрос.УстановитьПараметр("ДрагМатериалыДокумента", ОбъектыДМ);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОбъектыДокумента", ТаблицаОбъектовНФА);
	Запрос.УстановитьПараметр("ДатаСведений", Новый Граница(Ссылка.Дата, ВидГраницы.Включая));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстОшибки = НСтр("ru='Для объекта ""%1"" из списка ""Материальные запасы"" в учете присутствуют остатки драгоценных материалов. Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.ОбъектНФА);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект");
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ПроверитьЗаполнениеДополнительнойАналитикиКомиссионныхТоваров(Объект, Отказ)
	
	Для каждого ТекСтрока Из Объект.Номенклатура Цикл
	
		Если ЗначениеЗаполнено(ТекСтрока.СчетУчета)
			И ТекСтрока.КомиссионнаяТорговля
			И НЕ ЗначениеЗаполнено(ТекСтрока.ДополнительнаяАналитикаСчета)Тогда
				
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru = 'Дополнительная аналитика счета'"), ТекСтрока.НомерСтроки, "Номенклатура");
			ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Номенклатура", ТекСтрока.НомерСтроки, "ДополнительнаяАналитикаСчета");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ПутьКПолю, ,Отказ);
			
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

