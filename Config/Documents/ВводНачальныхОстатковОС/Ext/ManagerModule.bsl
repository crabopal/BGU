	|	СобытиеПринятиеКУчету.НазваниеДокумента,
	|	СобытиеПринятиеКУчету.НомерДокумента,
	|	СобытиеПринятиеКУчету.ДатаДокумента,
	|	СобытиеВводВЭксплуатацию.ДатаСобытия,
	|	СобытиеВводВЭксплуатацию.НазваниеДокумента,
	|	СобытиеВводВЭксплуатацию.НомерДокумента,
	|	СобытиеВводВЭксплуатацию.ДатаДокумента,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СобытиеВводВЭксплуатацию.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
	|		КОГДА ЕСТЬNULL(СобытиеПринятиеКУчету.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОС.пустаяСсылка)
	|	КОНЕЦ";
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО, "ИФО = &ИФО", "ИСТИНА"));
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаДанныеБухУчета = Результат[1].Выгрузить();
	Если ТаблицаДанныеБухУчета.Количество() > 0 Тогда
		ДанныеБухУчета = ТаблицаДанныеБухУчета[0]; // Из первой строки.
	Иначе
		ДанныеБухУчета = Неопределено;
	КонецЕсли;
	
	ОстаткиПоИнвентарнымНомерам = Результат[2].Выгрузить();
	Если ОстаткиПоИнвентарнымНомерам.Количество() = 1 Тогда
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, УчетныеДанныеОбъекта, "ИФО,КФО,КПС,СчетУчета");
		
		ДокументОбъект.НомерИнвентарнойКарточки = НомераИнвентарныхКарточек.НомерИнвентарнойКарточки;
		
		Для Каждого СтрокаИнвНомер Из ОстаткиПоИнвентарнымНомерам Цикл
			
			Если ЗначениеЗаполнено(ДанныеБухУчета) Тогда
				
				ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеБухУчета,
					"ПервоначальнаяСтоимость,ПервоначальнаяСуммаАмортизации,ПервоначальнаяСуммаОбесценения,ПервоначальноеКоличество");
				
				Если ОтражатьВНалоговомУчетеОСН Тогда
					
					Если ДанныеБухУчета.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
						И ДанныеБухУчета.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.Линейный Тогда
					
						ДокументОбъект.ПорядокВключенияСтоимостиВСоставРасходовНУ =
							Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации;
						
						ДокументОбъект.СрокПолезногоИспользованияНУ = ДанныеБухУчета.СрокПолезногоИспользования;
						ДокументОбъект.НачислятьАмортизациюНУ       = ДанныеБухУчета.НачислятьАмортизацию;
						ДокументОбъект.СпециальныйКоэффициентНУ     = 1;
						
					ИначеЕсли ДанныеБухУчета.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию
						Или (ДанныеБухУчета.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
						И ДанныеБухУчета.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию) Тогда
					
						ДокументОбъект.ПорядокВключенияСтоимостиВСоставРасходовНУ =
							Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету;
						
					Иначе
						
						ДокументОбъект.ПорядокВключенияСтоимостиВСоставРасходовНУ =
							Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если ОтражатьВУСНДоходыМинусРасходы Тогда
					
					Если ДанныеБухУчета.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
						И ДанныеБухУчета.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.Линейный Тогда
					
						ДокументОбъект.ПорядокВключенияСтоимостиВСоставРасходовУСН =
							Перечисления.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА;
						
						ДокументОбъект.СрокПолезногоИспользованияУСН = ДанныеБухУчета.СрокПолезногоИспользования;
						
					ИначеЕсли ДанныеБухУчета.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию
						Или (ДанныеБухУчета.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
						И ДанныеБухУчета.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию) Тогда
					
						ДокументОбъект.ПорядокВключенияСтоимостиВСоставРасходовУСН =
							Перечисления.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставМатериальныхРасходов;
						
					Иначе
						
						ДокументОбъект.ПорядокВключенияСтоимостиВСоставРасходовУСН =
							Перечисления.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.НеВключатьВСоставРасходов;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаИнвНомер,
				"ДатаПринятияКУчету,ДокументПринятияНомер,ДокументПринятияДата,ДокументПринятияВид");
			
			НоваяСтрока = ДокументОбъект.ИнвентарныеОбъекты.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИнвНомер,
				"ИнвентарныйНомер,ЦМО,Подразделение,СостояниеОС,
				|ДатаВводаВЭксплуатацию,ДокументВводаНомер,ДокументВводаДата,ДокументВводаВид,
				|Количество,Стоимость,СуммаАмортизации,СуммаОбесценения");
			
			// Заполняем реквизиты НУ по данным БУ - другой информации нет, т.к. НУ ранее не велся.
			ДокументОбъект.ПервоначальнаяСтоимостьНУ = ДокументОбъект.ПервоначальнаяСтоимость;
			НоваяСтрока.СуммаНУ                      = СтрокаИнвНомер.Стоимость;
			НоваяСтрока.СуммаАмортизацииНУ           = СтрокаИнвНомер.СуммаАмортизации;
			
		КонецЦикла;
		
	ИначеЕсли ОстаткиПоИнвентарнымНомерам.Количество() = 0 Тогда
		Возврат; // Нет остатков по регистру СтоимостьОбъектовОС.
	Иначе
		Возврат; // Найдено несколько инвентарных номеров.
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеАгрегатора

Процедура ПерезаполнитьДокументАгрегатор(ДокументСсылка, НеТолькоАгрегаторы = Ложь) Экспорт
	
	ДокОбъект = ДокументСсылка.ПолучитьОбъект();
	
	Если Не НеТолькоАгрегаторы И Не ДокОбъект.ЭтоАгрегаторДвижений Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Таблица Из ДокОбъект.Движения Цикл
		Таблица.Прочитать();
	КонецЦикла;
	
	ОсДок = ДокОбъект.ОсновноеСредство;
	
	ЗаполнитьИзДвижений(ДокОбъект);
	
	Если Не ЗначениеЗаполнено(ДокОбъект.ОсновноеСредство) Тогда
		ДокОбъект.ОсновноеСредство = ОсДок;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДокОбъект.Организация) И ЗначениеЗаполнено(ДокОбъект.ОсновноеСредство) Тогда
		ДокОбъект.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокОбъект.ОсновноеСредство, "Организация");
	КонецЕсли;
	
	ДокОбъект.ОбменДанными.Загрузка = Истина;
	ДокОбъект.Записать();
	
КонецПроцедуры

Процедура ЗаполнитьИзДвижений(Объект) Экспорт
	
	// Очищаем документ
	
	Для Каждого Реквизит Из Объект.Метаданные().Реквизиты Цикл
		Объект[Реквизит.Имя] = Неопределено;
	КонецЦикла;
	
	Для Каждого ТабличнаяЧасть Из Объект.Метаданные().ТабличныеЧасти Цикл
		Объект [ТабличнаяЧасть.Имя].Очистить();
	КонецЦикла;
	
	// Определяем счет учета и общие суммы документа
	
	СтрокаСчетаУчета	= Неопределено;
	СтрокаСчета21		= Неопределено;
	
	Для Каждого Движение Из Объект.Движения.ЖурналПроводокЕПСБУ Цикл
		Если БухгалтерскийУчет.СчетВИерархии(Движение.СчетДт, "101.00,102.00,103.00,108.00") Тогда
			СтрокаСчетаУчета = Движение;
			Объект.СуммаБалансовая = Объект.СуммаБалансовая + Движение.Сумма;
			Объект.ОсновноеСредство = Движение.СубконтоДт.ОсновныеСредства;
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Движение.СчетКт, "104.00") Тогда
			Объект.СуммаАмортизации = Объект.СуммаАмортизации + Движение.Сумма;
			Объект.ОсновноеСредство = Движение.СубконтоКт.ОсновныеСредства;
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Движение.СчетКт, "114.00") Тогда
			Объект.СуммаОбесценения = Объект.СуммаОбесценения + Движение.Сумма;
			Объект.ОсновноеСредство = Движение.СубконтоКт.ОсновныеСредства;
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Движение.СчетДт, "21") Тогда
			СтрокаСчета21 = Движение;
			Объект.СуммаЗабалансовая = Объект.СуммаЗабалансовая + Движение.Сумма;
			Объект.ОсновноеСредство = Движение.СубконтоДт.ОсновныеСредства;
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Движение.СчетДт, "25") Тогда
			Объект.СуммаВАренде = Объект.СуммаВАренде + Движение.Сумма;
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Движение.СчетДт, "26") Тогда
			Объект.СуммаВПользовании = Объект.СуммаВПользовании + Движение.Сумма;
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Движение.СчетДт, "Н01,Н04,У01,У04") Тогда
			Объект.СуммаНУ				= Объект.СуммаНУ + Движение.Сумма;
			Объект.СуммаНеУчитываетсяНУ	= Объект.СуммаНеУчитываетсяНУ + Движение.СуммаНеУчитываетсяНУ;
			Объект.СуммаЕНВД			= Объект.СуммаЕНВД + Движение.СуммаЕНВД;
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Движение.СчетДт, "Н02,Н05") Тогда
			Объект.СуммаАмортизацииНУ				= Объект.СуммаАмортизацииНУ + Движение.Сумма;
			Объект.СуммаАмортизацииНеУчитываетсяНУ	= Объект.СуммаАмортизацииНеУчитываетсяНУ + Движение.СуммаНеУчитываетсяНУ;
			Объект.СуммаАмортизацииЕНВД				= Объект.СуммаАмортизацииЕНВД + Движение.СуммаЕНВД;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаСчетаУчета <> Неопределено Тогда
		Объект.ИФО			= СтрокаСчетаУчета.ИФО;
		Объект.КФО			= СтрокаСчетаУчета.КФО;
		Объект.КПС			= СтрокаСчетаУчета.КПСДт;
		Объект.СчетУчета	= СтрокаСчетаУчета.СчетДт;
	ИначеЕсли СтрокаСчета21 <> Неопределено Тогда
		Объект.ИФО			= СтрокаСчета21.ИФО;
		Объект.КФО			= СтрокаСчета21.КФО;
		Объект.КПС			= СтрокаСчета21.КПСДт;
		Объект.СчетУчета	= УправлениеОсновнымиСредствамиКлиентСервер.ОпределитьБалансовыйСчетДляЗабалансового(СтрокаСчета21.СчетДт);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.КФО) Или Не ЗначениеЗаполнено(Объект.КПС) Или Не ЗначениеЗаполнено(Объект.СчетУчета) Тогда
		ПоследнийПериод		= '00010101';
		СтрокаУчетныеДанные	= Неопределено;
		Для Каждого Движение Из Объект.Движения.УчетныеДанныеОбъектаОС Цикл
			Если Движение.Период > ПоследнийПериод И БухгалтерскийУчет.СчетВИерархии(Движение.СчетУчета, "101.00,102.00,103.00,108.00") Тогда
				СтрокаУчетныеДанные = Движение;
				ПоследнийПериод = Движение.Период;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаУчетныеДанные <> Неопределено Тогда
			Если Не ЗначениеЗаполнено(Объект.КПС) И ЗначениеЗаполнено(СтрокаУчетныеДанные.КПС) Тогда
				Объект.КПС = ?(ТипЗнч(СтрокаУчетныеДанные.КПС) = Тип("Строка"),
					Справочники.КлассификационныеПризнакиСчетов.НайтиПоКоду(СтрокаУчетныеДанные.КПС),
					СтрокаУчетныеДанные.КПС);
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Объект.КФО) Тогда
				Объект.КФО = СтрокаУчетныеДанные.КФО;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Объект.СчетУчета) Тогда
				Объект.СчетУчета = СтрокаУчетныеДанные.СчетУчета;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Номер инвентарной карточки
	
	СрезПоследних = СрезПоследнихТаблицы(Объект.Движения.НомераИнвентарныхКарточек);
	Для Каждого Движение Из СрезПоследних Цикл
		Объект.НомерИнвентарнойКарточки = Движение.НомерИнвентарнойКарточки;
	КонецЦикла;
	
	// Первоначальные сведения
	
	СрезПоследних = СрезПоследнихТаблицы(Объект.Движения.ПервоначальныеСведенияОСБухгалтерскийУчет);
	Для Каждого Движение Из СрезПоследних Цикл
		Объект.ПервоначальноеКоличество			= ?(Движение.Количество = 0, 1, Движение.Количество);
		Объект.ПервоначальнаяСтоимость			= Движение.ПервоначальнаяСтоимость * Объект.ПервоначальноеКоличество;
		Объект.ПервоначальнаяСуммаАмортизации	= Движение.ПервоначальнаяСуммаАмортизации;
		Объект.ПервоначальнаяСуммаОбесценения	= Движение.ПервоначальнаяСуммаОбесценения;
	КонецЦикла;
	
	// Начислять амортизацию
	
	СрезПоследних = СрезПоследнихТаблицы(Объект.Движения.НачислениеАмортизацииОСБухгалтерскийУчет);
	Если СрезПоследних.Количество() > 0 Тогда
		Для Каждого Движение Из СрезПоследних Цикл
			Объект.НачислятьАмортизацию = Движение.НачислятьАмортизацию;
		КонецЦикла;
	Иначе
		Объект.НачислятьАмортизацию = Истина;
	КонецЕсли;
	
	// Счет учета затрат по амортизации
	
	СрезПоследних = СрезПоследнихТаблицы(Объект.Движения.АмортизацияОС);
	Для Каждого Движение Из СрезПоследних Цикл
		Объект.СчетУчетаЗатрат		= Движение.СчетУчетаЗатрат;
		Объект.ПодразделениеЗатрат	= Движение.Подразделение;
		Объект.КПСЗатрат			= Движение.КПС;
		Объект.СубконтоЗатрат1		= Движение.Субконто1;
		Объект.СубконтоЗатрат2		= Движение.Субконто2;
		Объект.СубконтоЗатрат3		= Движение.Субконто3;
		Объект.СтатьяПрочихРасходов	= Движение.СубконтоНУ;
	КонецЦикла;
	
	// Первоначальные сведения НУ
	
	СрезПоследних = СрезПоследнихТаблицы(Объект.Движения.ПервоначальныеСведенияОСНалоговыйУчет);
	Для Каждого Движение Из СрезПоследних Цикл
		Объект.ПервоначальнаяСтоимостьНУ					= Движение.ПервоначальнаяСтоимостьНУ;
		Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ	= Движение.ПорядокВключенияСтоимостиВСоставРасходов;
		Объект.МетодНачисленияАмортизацииНУ					= Движение.МетодНачисленияАмортизации;
		Объект.АмортизацияДо2009							= Движение.АмортизацияДо2009;
		Объект.ФактическийСрокИспользованияДо2009			= Движение.ФактическийСрокИспользованияДо2009;
		Объект.СтоимостьДо2002НУ							= Движение.СтоимостьДо2002;
		Объект.АмортизацияДо2002НУ							= Движение.АмортизацияДо2002;
	КонецЦикла;
	
	// Начислять амортизацию НУ
	
	СрезПоследних = СрезПоследнихТаблицы(Объект.Движения.НачислениеАмортизацииОСНалоговыйУчет);
	Для Каждого Движение Из СрезПоследних Цикл
		Объект.НачислятьАмортизациюНУ = Движение.НачислятьАмортизацию;
	КонецЦикла;
	
	// Параметры амортизации НУ
	
	СрезПоследних = СрезПоследнихТаблицы(Объект.Движения.ПараметрыАмортизацииОСНалоговыйУчет);
	Для Каждого Движение Из СрезПоследних Цикл
		Объект.СрокПолезногоИспользованияНУ = Движение.СрокПолезногоИспользования;
	КонецЦикла;
	
	// Специальный коэффициент НУ
	
	СрезПоследних = СрезПоследнихТаблицы(Объект.Движения.НачислениеАмортизацииОССпециальныйКоэффициентНалоговыйУчет);
	Для Каждого Движение Из СрезПоследних Цикл
		Объект.СпециальныйКоэффициентНУ = Движение.СпециальныйКоэффициент;
	КонецЦикла;
	
	// Первоначальные сведения УСН
	
	СрезПоследних = СрезПоследнихТаблицы(Объект.Движения.ПервоначальныеСведенияОСНалоговыйУчетУСН);
	Для Каждого Движение Из СрезПоследних Цикл
		Объект.СрокПолезногоИспользованияУСН				= Движение.СрокПолезногоИспользованияУСН;
		Объект.ПорядокВключенияСтоимостиВСоставРасходовУСН	= Движение.ПорядокВключенияСтоимостиВСоставРасходовУСН;
	КонецЦикла;
	
	// Таблица Инвентарные объекты
	
	ТаблицаОбъектов = Объект.ИнвентарныеОбъекты.ВыгрузитьКолонки();
	ТипДата = Новый ОписаниеТипов("Дата",,,,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
	ТаблицаОбъектов.Колонки.Добавить("ПериодВвод"		, ТипДата);
	ТаблицаОбъектов.Колонки.Добавить("ПериодСписание"	, ТипДата);
	ТаблицаОбъектов.Колонки.Добавить("ПериодПередача"	, ТипДата);
	
	ПериодПринятие = '00010101';
	ДатаПринятияДетальная = '00010101';
	
	Для Каждого Движение Из Объект.Движения.СобытияОС Цикл
		
		Если Движение.Событие = Перечисления.ВидыСобытийОС.ПринятиеКУчету
			И Движение.Период > ПериодПринятие Тогда
			Объект.ОсновноеСредство			= Движение.ОсновноеСредство;
			Объект.Организация				= Движение.Организация;
			Объект.ДатаПринятияКУчету		= Движение.ДатаСобытия;
			Объект.ДокументПринятияДата		= Движение.ДатаДокумента;
			Объект.ДокументПринятияНомер	= Движение.НомерДокумента;
			Объект.ДокументПринятияВид		= Движение.НазваниеДокумента;
			ПериодПринятие					= Движение.Период;
			ДатаПринятияДетальная			= Движение.ДатаСобытия;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Движение.ИнвНомер) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы = ТаблицаОбъектов.Найти(Движение.ИнвНомер, "ИнвентарныйНомер");
		
		Если СтрокаТаблицы = Неопределено Тогда
			СтрокаТаблицы = ТаблицаОбъектов.Добавить();
			СтрокаТаблицы.ИнвентарныйНомер = Движение.ИнвНомер;
		КонецЕсли;
		
		Если Движение.Событие = Перечисления.ВидыСобытийОС.ВводВЭксплуатацию
			И Движение.Период >= СтрокаТаблицы.ПериодВвод Тогда
			
			СтрокаТаблицы.ДатаВводаВЭксплуатацию	= Движение.ДатаСобытия;
			СтрокаТаблицы.ДокументВводаДата			= Движение.ДатаДокумента;
			СтрокаТаблицы.ДокументВводаНомер		= Движение.НомерДокумента;
			СтрокаТаблицы.ДокументВводаВид			= Движение.НазваниеДокумента;
			СтрокаТаблицы.ПериодВвод				= Движение.Период;
			
		КонецЕсли;
		
		Если Движение.Событие = Перечисления.ВидыСобытийОС.Списание
			И Движение.Период >= СтрокаТаблицы.ПериодСписание Тогда
			
			СтрокаТаблицы.ДатаСписания				= Движение.ДатаСобытия;
			СтрокаТаблицы.ДокументСписанияДата		= Движение.ДатаДокумента;
			СтрокаТаблицы.ДокументСписанияНомер		= Движение.НомерДокумента;
			СтрокаТаблицы.ДокументСписанияВид		= Движение.НазваниеДокумента;
			СтрокаТаблицы.ПричинаСписания			= Движение.ПричинаСписания;
			СтрокаТаблицы.ПериодСписание			= Движение.Период;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтоимостьОстатки = Объект.Движения.СтоимостьОбъектовОС.Выгрузить();
	Для Каждого СтрокаСтоимости Из СтоимостьОстатки Цикл
		Если СтрокаСтоимости.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
			СтрокаСтоимости.Стоимость				= - СтрокаСтоимости.Стоимость;
			СтрокаСтоимости.Количество				= - СтрокаСтоимости.Количество;
			СтрокаСтоимости.СуммаНеУчитываетсяНУ	= - СтрокаСтоимости.СуммаНеУчитываетсяНУ;
			СтрокаСтоимости.СуммаЕНВД				= - СтрокаСтоимости.СуммаЕНВД;
			СтрокаСтоимости.СуммаНДС				= - СтрокаСтоимости.СуммаНДС;
		КонецЕсли;
	КонецЦикла;
	СтоимостьОстатки.Свернуть("ИнвентарныйНомер,ЦМО,Подразделение,ВидРаспоряжения",
		"Стоимость,Количество,СуммаНеУчитываетсяНУ,СуммаЕНВД,СуммаНДС");
	
	Для Каждого Движение Из СтоимостьОстатки Цикл
		
		Если Движение.Стоимость = 0 И Движение.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Движение.ИнвентарныйНомер) Тогда
			СтрокаТаблицы = ТаблицаОбъектов.Найти(Движение.ИнвентарныйНомер, "ИнвентарныйНомер");
		Иначе
			СтрокаТаблицы = Неопределено;
		КонецЕсли;
		
		Если СтрокаТаблицы = Неопределено Тогда
			СтрокаТаблицы = ТаблицаОбъектов.Добавить();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Движение);
		СтрокаТаблицы.НаСчете21 = (Движение.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ОперативныйУчет);
		
	КонецЦикла;
	
	Для Каждого Движение Из Объект.Движения.СтоимостьОбъектовОС Цикл
		Если ЗначениеЗаполнено(Движение.ИнвентарныйНомер)
			И Движение.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаБалансе
			И Движение.Событие = Перечисления.ВидыСобытийОС.Списание Тогда
			
			СтрокаТаблицы = ТаблицаОбъектов.Найти(Движение.ИнвентарныйНомер, "ИнвентарныйНомер");
			
			Если СтрокаТаблицы <> Неопределено Тогда
				СтрокаТаблицы.ЦМО = Движение.ЦМО;
				СтрокаТаблицы.Стоимость = Движение.Стоимость;
				СтрокаТаблицы.Количество = Движение.Количество;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	ОстаткиАмортизация = Объект.Движения.АмортизацияОбъектовОС.Выгрузить();
	Для Каждого СтрокаАмортизации Из ОстаткиАмортизация Цикл
		Если СтрокаАмортизации.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
			СтрокаАмортизации.СуммаАмортизации = - СтрокаАмортизации.СуммаАмортизации;
			СтрокаАмортизации.СуммаОбесценения = - СтрокаАмортизации.СуммаОбесценения;
		КонецЕсли;
	КонецЦикла;
	ОстаткиАмортизация.Свернуть("ИнвентарныйНомер", "СуммаАмортизации,СуммаОбесценения");
	
	Для Каждого Движение Из ОстаткиАмортизация Цикл
		
		СтрокаТаблицы = ТаблицаОбъектов.Найти(Движение.ИнвентарныйНомер, "ИнвентарныйНомер");
		
		Если СтрокаТаблицы = Неопределено Тогда
			СтрокаТаблицы = ТаблицаОбъектов.Добавить();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Движение);
		
	КонецЦикла;
	
	Для Каждого Движение Из Объект.Движения.СтоимостьОбъектовОСПоКонтрагентам Цикл
		
		ВАренде			= (Движение.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВАренду);
		ВПользовании	= (Движение.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВПользование);
		
		Если ВАренде Или ВПользовании Тогда
			
			СтрокаТаблицы = ТаблицаОбъектов.Найти(Движение.ИнвентарныйНомер, "ИнвентарныйНомер");
			
			Если СтрокаТаблицы = Неопределено Тогда
				СтрокаТаблицы = ТаблицаОбъектов.Добавить();
				СтрокаТаблицы.ИнвентарныйНомер = Движение.ИнвентарныйНомер;
			КонецЕсли;
			
			Если Движение.Период >= СтрокаТаблицы.ПериодПередача Тогда
				
				Если ВАренде Тогда
					СтрокаТаблицы.ВПользованииСостояниеОС = Перечисления.ВидыСобытийОС.СдачаВАренду;
				ИначеЕсли ВПользовании Тогда
					СтрокаТаблицы.ВПользованииСостояниеОС = Перечисления.ВидыСобытийОС.ПередачаВБезвозмездноеПользование;
				КонецЕсли;
				СтрокаТаблицы.ВПользованииКонтрагент = Движение.Контрагент;
				СтрокаТаблицы.ПериодПередача = Движение.Период;
				
			КонецЕсли;
			
			к = ?(Движение.ВидДвижения = ВидДвиженияНакопления.Расход, -1, 1);
			СтрокаТаблицы.ВПользованииСтоимость  = СтрокаТаблицы.ВПользованииСтоимость + к * Движение.Стоимость;
			СтрокаТаблицы.ВПользованииКоличество = СтрокаТаблицы.ВПользованииКоличество + к * Движение.Количество;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЕстьИнвНомер = Ложь;
	
	ТаблицаОбъектов.Колонки.Добавить("ПорядокНомера");
	
	Для Каждого СтрокаТаблицы Из ТаблицаОбъектов Цикл
		
		Если СтрокаТаблицы.НаСчете21 Или ЗначениеЗаполнено(СтрокаТаблицы.ДатаСписания) Тогда
			СтрокаТаблицы.СостояниеОС = Перечисления.СостоянияОС.СнятоСУчета;
		ИначеЕсли ЗначениеЗаполнено(СтрокаТаблицы.ДатаВводаВЭксплуатацию) Тогда
			СтрокаТаблицы.СостояниеОС = Перечисления.СостоянияОС.ВведеноВЭксплуатацию;
		Иначе
			СтрокаТаблицы.СостояниеОС = Перечисления.СостоянияОС.ПринятоКУчету;
		КонецЕсли;
		
		СтрокаТаблицы.ПорядокНомера = ?(ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомер), 0, 1);
		ЕстьИнвНомер = ЕстьИнвНомер Или ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомер);
		
	КонецЦикла;
	
	ТаблицаОбъектов.Сортировать("ПорядокНомера,ИнвентарныйНомер,СостояниеОС,НаСчете21 Убыв,ЦМО");
	
	Объект.ИнвентарныеОбъекты.Загрузить(ТаблицаОбъектов);
	
	Если Не ЗначениеЗаполнено(Объект.ОсновноеСредство) И Объект.ДополнительныеСвойства.Свойство("Отбор")
		И Объект.ДополнительныеСвойства.Отбор.Свойство("ОсновноеСредство") Тогда
		Объект.ОсновноеСредство = Объект.ДополнительныеСвойства.Отбор.ОсновноеСредство;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Если Объект.ДополнительныеСвойства.Свойство("Отбор") И Объект.ДополнительныеСвойства.Отбор.Свойство("Организация") Тогда
			Объект.Организация = Объект.ДополнительныеСвойства.Отбор.Организация;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.ОсновноеСредство) Тогда
			Объект.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ОсновноеСредство, "Организация");
		КонецЕсли;
	КонецЕсли;
	
	// Таблица КапитальныйРемонт
	
	Для Каждого Движение Из Объект.Движения.КапРемонтОС Цикл
		
		СтрокаТаблицы					= Объект.КапитальныйРемонт.Добавить();
		СтрокаТаблицы.ИнвентарныйНомер	= Движение.ИнвНомер;
		СтрокаТаблицы.Период			= Движение.Период;
		СтрокаТаблицы.Сумма				= Движение.СуммаНаКапРемонт;
		СтрокаТаблицы.НазваниеДокумента	= Движение.НазваниеДокумента;
		СтрокаТаблицы.НомерДокумента	= Движение.НомерДокумента;
		СтрокаТаблицы.НомерГТ			= Движение.НомерГТ;
		СтрокаТаблицы.ДатаГТ			= Движение.ДатаГТ;
		СтрокаТаблицы.СрокДействияГТ	= Движение.СрокДействияГТ;
		
	КонецЦикла;
	
	// Таблица Местонахождение
	
	Для Каждого Движение Из Объект.Движения.СтоимостьОбъектовОС Цикл
		Если Движение.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаБалансе
			И (Движение.Событие = Перечисления.ВидыСобытийОС.ПринятиеКУчету
			Или Движение.Событие = Перечисления.ВидыСобытийОС.ВнутреннееПеремещение
			Или Движение.Событие = Перечисления.ВидыСобытийОС.Списание) Тогда
			
			ДатаСобытия = ?(ЗначениеЗаполнено(Движение.ДатаСобытия), Движение.ДатаСобытия, Движение.Период);
			
			Если Движение.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
				
				Если Движение.Событие = Перечисления.ВидыСобытийОС.ПринятиеКУчету Тогда
					ЭтоПринятие = Истина;
				Иначе
					ЭтоПринятие = ?(ДатаСобытия = НачалоДня(ДатаСобытия),
						(ДатаСобытия = НачалоДня(ДатаПринятияДетальная)),
						(ДатаСобытия = ДатаПринятияДетальная));
				КонецЕсли;
				
				Событие = ?(ЭтоПринятие,
					Перечисления.СобытияИсторииМестонахожденияОС.ПринятиеКУчету,
					Перечисления.СобытияИсторииМестонахожденияОС.ПеремещениеПоступление);
				
			Иначе
				
				Если ЗначениеЗаполнено(Движение.ИнвентарныйНомер) Тогда
					
					Событие = Неопределено;
					
				Иначе
					
					Событие = ?(Движение.Событие = Перечисления.ВидыСобытийОС.Списание,
						Перечисления.СобытияИсторииМестонахожденияОС.Списание,
						Перечисления.СобытияИсторииМестонахожденияОС.ПеремещениеВыбытие);
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если Событие <> Неопределено Тогда
				
				СтрокаТаблицы					= Объект.Местонахождение.Добавить();
				СтрокаТаблицы.ИнвентарныйНомер	= Движение.ИнвентарныйНомер;
				СтрокаТаблицы.ЦМО				= Движение.ЦМО;
				СтрокаТаблицы.Событие			= Событие;
				СтрокаТаблицы.Период			= ДатаСобытия;
				СтрокаТаблицы.Сумма				= Движение.Стоимость;
				СтрокаТаблицы.Количество		= Движение.Количество;
				СтрокаТаблицы.НазваниеДокумента	= Движение.НазваниеДокумента;
				СтрокаТаблицы.НомерДокумента	= Движение.НомерДокумента;
				СтрокаТаблицы.ДатаДокумента		= Движение.ДатаДокумента;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Объект.Местонахождение.Сортировать("Период,Событие,ИнвентарныйНомер");
	
	ЛишниеСтроки = Новый Массив;
	ПредыдущаяСтрока = Неопределено;
	
	Для Каждого СтрокаТаблицы Из Объект.Местонахождение Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомер) И ПредыдущаяСтрока <> Неопределено Тогда
			Если СтрокаТаблицы.ИнвентарныйНомер = ПредыдущаяСтрока.ИнвентарныйНомер
				И СтрокаТаблицы.ЦМО = ПредыдущаяСтрока.ЦМО Тогда
				ЛишниеСтроки.Добавить(СтрокаТаблицы);
			КонецЕсли;
		КонецЕсли;
		ПредыдущаяСтрока = СтрокаТаблицы;
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ЛишниеСтроки Цикл
		Объект.Местонахождение.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	// Таблица Стоимость и амортизация
	
	КолвоИнвНомеров = Макс(Объект.ИнвентарныеОбъекты.Количество(), 1);
	
// Данные по переоценке есть в движениях РН.СтоимостьОбъектовОС, которые будут заполняться ниже.
// В противном случае данные переоценки задвоятся	
//	Для Каждого Движение Из Объект.Движения.ПереоценкаНФА Цикл
//		
//		Для Каждого СтрокаИнвОбъект Из Объект.ИнвентарныеОбъекты Цикл
//			
//			СтрокаТаблицы							= Объект.СтоимостьИАмортизация.Добавить();
//			СтрокаТаблицы.ИнвентарныйНомер			= СтрокаИнвОбъект.ИнвентарныйНомер;
//			СтрокаТаблицы.Период					= Движение.ПереоценкаПоСостояниюНА;
//			СтрокаТаблицы.Событие					= Перечисления.СобытияИсторииСтоимостиОС.Переоценка;
//			СтрокаТаблицы.БалансоваяСтоимостьДельта	= Движение.ДооценкаБалансовойСтоимости / КолвоИнвНомеров;
//			СтрокаТаблицы.ВидПервичногоДокумента	= Движение.ПриказОПереоценке;
//			СтрокаТаблицы.ДатаПервичногоДокумента	= Движение.ДатаПроведения;
//			
//			СтрокаТаблицы.ГруппаОФ					= Движение.ГруппаОФ;
//			СтрокаТаблицы.ОсновнойКоэффициент		= Движение.ОсновнойКоэффициент;
//			СтрокаТаблицы.ПоправочныйКоэффициент	= Движение.ПоправочныйКоэффициент;
//			СтрокаТаблицы.ДооценкаАмортизации		= Движение.ДооценкаАмортизации;
//			
//		КонецЦикла;
//		
//	КонецЦикла;
	
	Для Каждого Движение Из Объект.Движения.СтоимостьОбъектовОС Цикл
		Если Движение.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаБалансе Тогда
			
			Если Движение.Событие = Перечисления.ВидыСобытийОС.ПринятиеКУчету Тогда
				Событие = Перечисления.СобытияИсторииСтоимостиОС.ПринятиеКУчету;
			ИначеЕсли Движение.Событие = Перечисления.ВидыСобытийОС.Переоценка Тогда
				Событие = Перечисления.СобытияИсторииСтоимостиОС.Переоценка;
			ИначеЕсли Движение.Событие = Перечисления.ВидыСобытийОС.Реконструкция Тогда
				Событие = Перечисления.СобытияИсторииСтоимостиОС.Модернизация;
			ИначеЕсли Движение.Событие = Перечисления.ВидыСобытийОС.Прочее Тогда
				Событие = Перечисления.СобытияИсторииСтоимостиОС.Прочее;
			Иначе
				Продолжить;
			КонецЕсли;
			
			ДатаСобытия = ?(ЗначениеЗаполнено(Движение.ДатаСобытия), Движение.ДатаСобытия, Движение.Период);
			
			СтрокаТаблицы							= Объект.СтоимостьИАмортизация.Добавить();
			СтрокаТаблицы.ИнвентарныйНомер			= Движение.ИнвентарныйНомер;
			СтрокаТаблицы.Период					= ДатаСобытия;
			СтрокаТаблицы.Событие					= Событие;
			СтрокаТаблицы.БалансоваяСтоимостьДельта	= Движение.Стоимость;
			СтрокаТаблицы.ВидПервичногоДокумента	= Движение.НазваниеДокумента;
			СтрокаТаблицы.ДатаПервичногоДокумента	= Движение.ДатаДокумента;
			СтрокаТаблицы.НомерПервичногоДокумента	= Движение.НомерДокумента;
			СтрокаТаблицы.ПричинаИзмененияСтоимости	= Движение.Причина;
			
		КонецЕсли;
	КонецЦикла;
	
	// - собираем события по изменению срока полезного использования
	РасчетАмортизацииОС = Объект.Движения.РасчетАмортизацииОС.Выгрузить();
	
	Для Каждого Движение Из РасчетАмортизацииОС Цикл
		Для Каждого СтрокаТаблицы Из Объект.ИнвентарныеОбъекты Цикл
			Строки = Объект.СтоимостьИАмортизация.НайтиСтроки(Новый Структура("Период,ИнвентарныйНомер", НачалоДня(Движение.Период), СтрокаТаблицы.ИнвентарныйНомер));
			Если Строки.Количество() = 0 Тогда
				НоваяСтрока = Объект.СтоимостьИАмортизация.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Движение);
				НоваяСтрока.ИнвентарныйНомер	= СтрокаТаблицы.ИнвентарныйНомер;
				НоваяСтрока.Событие				= Перечисления.СобытияИсторииСтоимостиОС.Прочее;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// - собираем события по изменению параметров амортизации	
	ПараметрыАмортизацииОС = Объект.Движения.ПараметрыАмортизацииОСБухгалтерскийУчет.Выгрузить();
	
	Для Каждого Движение Из ПараметрыАмортизацииОС Цикл
		Для Каждого СтрокаТаблицы Из Объект.ИнвентарныеОбъекты Цикл
			Строки = Объект.СтоимостьИАмортизация.НайтиСтроки(Новый Структура("Период,ИнвентарныйНомер", НачалоДня(Движение.Период), СтрокаТаблицы.ИнвентарныйНомер));
			Если Строки.Количество() = 0 Тогда
				НоваяСтрока = Объект.СтоимостьИАмортизация.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Движение);
				НоваяСтрока.ИнвентарныйНомер	= СтрокаТаблицы.ИнвентарныйНомер;
				НоваяСтрока.Событие				= Перечисления.СобытияИсторииСтоимостиОС.Прочее;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	РасчетАмортизацииОС.Сортировать("Период");
	Для Каждого Движение Из РасчетАмортизацииОС Цикл
		Для Каждого СтрокаТаблицы Из Объект.СтоимостьИАмортизация Цикл
			Если НачалоДня(Движение.Период) <= НачалоДня(СтрокаТаблицы.Период) Тогда
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Движение,, "Период");
				Если СтрокаТаблицы.СрокИспользованияДляВычисленияАмортизации <> 0 Тогда
					СтрокаТаблицы.РасчетАмортизацииВручную = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ПараметрыАмортизацииОС.Сортировать("Период");
	Для Каждого Движение Из ПараметрыАмортизацииОС Цикл
		Для Каждого СтрокаТаблицы Из Объект.СтоимостьИАмортизация Цикл
			Если НачалоДня(Движение.Период) <= НачалоДня(СтрокаТаблицы.Период) Тогда
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Движение,, "Период");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из Объект.ИнвентарныеОбъекты Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомер) Тогда
			
			Отбор = Новый Структура("ИнвентарныйНомер,Событие", СтрокаТаблицы.ИнвентарныйНомер, Перечисления.СобытияИсторииСтоимостиОС.ПринятиеКУчету); 
			СтрокиПринятия = Объект.СтоимостьИАмортизация.НайтиСтроки(Отбор);
			
			Если СтрокиПринятия.Количество() = 0 Тогда
				
				Отбор.Событие = Перечисления.СобытияИсторииСтоимостиОС.Прочее;
				СтрокиПрочее = Объект.СтоимостьИАмортизация.НайтиСтроки(Отбор);
				Если СтрокиПрочее.Количество() = 1 Тогда
					СтрокаПринятия = СтрокиПрочее[0];
					СтрокаПринятия.Событие = Перечисления.СобытияИсторииСтоимостиОС.ПринятиеКУчету;
					СтрокаПринятия.Период					= Объект.ДатаПринятияКУчету;
					СтрокаПринятия.ВидПервичногоДокумента	= Объект.ДокументПринятияВид;
					СтрокаПринятия.ДатаПервичногоДокумента	= Объект.ДокументПринятияДата;
					СтрокаПринятия.НомерПервичногоДокумента	= Объект.ДокументПринятияНомер;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Объект.СтоимостьИАмортизация.Сортировать("Период,Событие,ИнвентарныйНомер");
	
	РаспределитьСтоимостьИАмортизацию(Объект);
	
	// Таблица Драгматериалы
	
	ОстаткиДМ = Объект.Движения.НаличиеДрагМатериаловВОбъектахНФА.Выгрузить();
	Для Каждого СтрокаДМ Из ОстаткиДМ Цикл
		Если СтрокаДМ.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
			СтрокаДМ.МассаДМ		= - СтрокаДМ.МассаДМ;
			СтрокаДМ.КоличествоДМ	= - СтрокаДМ.КоличествоДМ;
		КонецЕсли;
	КонецЦикла;
	ОстаткиДМ.Свернуть("ИнвНомер,ВидДрагМатериала,ЕдИзм", "МассаДМ,КоличествоДМ");
	ОстаткиДМ.Сортировать("ИнвНомер,ВидДрагМатериала,ЕдИзм");
	
	Для Каждого СтрокаДМ Из ОстаткиДМ Цикл
		
		НоваяСтрока						= Объект.ДрагМатериалы.Добавить();
		НоваяСтрока.ИнвентарныйНомер	= СтрокаДМ.ИнвНомер;
		НоваяСтрока.ДрагМатериал		= СтрокаДМ.ВидДрагМатериала;
		НоваяСтрока.ЕдиницаИзмерения	= СтрокаДМ.ЕдИзм;
		НоваяСтрока.Масса				= СтрокаДМ.МассаДМ;
		НоваяСтрока.Количество			= СтрокаДМ.КоличествоДМ;
		
	КонецЦикла;
	
	// Таблица Консервация
	
	Для Каждого Движение Из Объект.Движения.СтоимостьОбъектовОС Цикл
		Если Движение.Событие = Перечисления.ВидыСобытийОС.Консервация
			Или Движение.Событие = Перечисления.ВидыСобытийОС.Расконсервация Тогда
			
			ДатаСобытия = ?(ЗначениеЗаполнено(Движение.ДатаСобытия), Движение.ДатаСобытия, Движение.Период);
			
			СтрокаТаблицы					= Объект.Консервация.Добавить();
			СтрокаТаблицы.ИнвентарныйНомер	= Движение.ИнвентарныйНомер;
			СтрокаТаблицы.Период			= ДатаСобытия;
			СтрокаТаблицы.Событие			= Движение.Событие;
			СтрокаТаблицы.Причина			= Движение.Причина;
			СтрокаТаблицы.ДатаАкта			= Движение.ДатаДокумента;
			СтрокаТаблицы.НомерАкта			= Движение.НомерДокумента;
			СтрокаТаблицы.ЦМО				= Движение.ЦМО;
			
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Движение Из Объект.Движения.НачислениеАмортизацииОСБухгалтерскийУчет Цикл
		Если Движение.Консервация Тогда
			
			Для Каждого СтрокаТаблицы Из Объект.ИнвентарныеОбъекты Цикл
				
				Событие = ?(Движение.НачислятьАмортизацию,
					Перечисления.ВидыСобытийОС.Расконсервация, Перечисления.ВидыСобытийОС.Консервация);
				
				СтрокаТаблицы					= Объект.Консервация.Добавить();
				СтрокаТаблицы.ИнвентарныйНомер	= СтрокаТаблицы.ИнвентарныйНомер;
				СтрокаТаблицы.Период			= Движение.Период;
				СтрокаТаблицы.Событие			= Событие;
				СтрокаТаблицы.Причина			= "";
				СтрокаТаблицы.ДатаАкта			= Движение.ДатаПервичногоДокумента;
				СтрокаТаблицы.НомерАкта			= Движение.НомерПервичногоДокумента;
				СтрокаТаблицы.ЦМО				= Неопределено;
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
	Объект.Консервация.Сортировать("Период,Событие,ИнвентарныйНомер");
	
	// Устанавливаем флаги
	
	Объект.ОтражатьВНалоговомУчете		= Объект.СуммаНУ <> 0 Или Объект.СуммаНеУчитываетсяНУ <> 0 Или Объект.СуммаЕНВД <> 0
		Или Объект.СуммаАмортизацииНУ <> 0 Или Объект.СуммаАмортизацииНеУчитываетсяНУ <> 0 Или Объект.СуммаАмортизацииЕНВД <> 0;
	Объект.ОтражатьВБухгалтерскомУчете	= Объект.СуммаБалансовая <> 0 Или Объект.СуммаАмортизации <> 0
		Или Объект.СуммаЗабалансовая <> 0 Или Объект.СуммаВАренде <> 0 Или Объект.СуммаВПользовании <> 0
		Или Не Объект.ОтражатьВНалоговомУчете;
	Объект.ОтражатьИсторию				= Объект.ОтражатьВБухгалтерскомУчете;
	Объект.ДокументОснование			= Документы.ВводНачальныхОстатковОС.ПустаяСсылка();
	Объект.ЭтоАгрегаторДвижений			= Истина;
	Объект.ИнвентарныйУчет				= ?(ЕстьИнвНомер, 0, 1);
	
КонецПроцедуры

Функция СрезПоследнихТаблицы(ТаблицаДвижений)
	
	ПоследняяСтрока = Неопределено;
	Период = '00010101';
	
	Для Каждого Движение Из ТаблицаДвижений Цикл
		Если Движение.Период >= Период Тогда
			ПоследняяСтрока = Движение;
			Период = Движение.Период;
		КонецЕсли;
	КонецЦикла;
		
	Строки = Новый Массив;
	Если ПоследняяСтрока <> Неопределено Тогда
		Строки.Добавить(ПоследняяСтрока);
	КонецЕсли;
	
	Результат = ТаблицаДвижений.Выгрузить(Строки);
	
	Возврат Результат;
	
КонецФункции

Процедура РаспределитьСтоимостьИАмортизацию(Объект)
	
	// - получаем список всех инв. номеров
	СписокИнвНомеров = Новый Массив;
	Для Каждого СтрокаТаблицы Из Объект.СтоимостьИАмортизация Цикл
		Если СписокИнвНомеров.Найти(СтрокаТаблицы.ИнвентарныйНомер) = Неопределено Тогда
			СписокИнвНомеров.Добавить(СтрокаТаблицы.ИнвентарныйНомер);
		КонецЕсли;
	КонецЦикла;
	
	// - собираем амортизацию
	Амортизация = Объект.Движения.АмортизацияОбъектовОС.Выгрузить(,"ВидДвижения,ИнвентарныйНомер,СуммаАмортизации,ДатаСобытия");
	Для Каждого СтрокаАм Из Амортизация Цикл
		Если СтрокаАм.ВидДвижения = ВидДвиженияНАкопления.Расход Тогда
			СтрокаАм.СуммаАмортизации = - СтрокаАм.СуммаАмортизации;
		КонецЕсли;
	КонецЦикла;
	
	Амортизация.Колонки.ДатаСобытия.Имя = "Период";
	Амортизация.Свернуть("Период,ИнвентарныйНомер", "СуммаАмортизации");
	
	//  - распределяем
	Для Каждого ИнвентарныйНомер Из СписокИнвНомеров Цикл
		
		Отбор = Новый Структура("ИнвентарныйНомер", ИнвентарныйНомер);
		
		СтрокиТаблицы = Объект.СтоимостьИАмортизация.НайтиСтроки(Отбор);
		КоличествоСтрок = СтрокиТаблицы.Количество();
		
		СтрокиАмортизации = Амортизация.НайтиСтроки(Отбор);
		
		Для Сч = 1 По КоличествоСтрок Цикл
			
			СтрокаЗапись			= СтрокиТаблицы[Сч-1];
			ПредыдущаяСтрокаЗапись	= ?(Сч = 1, Неопределено, СтрокиТаблицы[Сч-2]);
			СледующаяСтрокаЗапись	= ?(Сч = КоличествоСтрок, Неопределено, СтрокиТаблицы[Сч]); 
			
			БалансоваяСтоимость = ?(ПредыдущаяСтрокаЗапись = Неопределено, 0, ПредыдущаяСтрокаЗапись.БалансоваяСтоимость);
			СтрокаЗапись.БалансоваяСтоимость = БалансоваяСтоимость + СтрокаЗапись.БалансоваяСтоимостьДельта;
			Если СтрокаЗапись.БалансоваяСтоимость = 0 И ПредыдущаяСтрокаЗапись = Неопределено Тогда
				СтрокаЗапись.БалансоваяСтоимость = ?(Объект.ПервоначальноеКоличество = 0, Объект.ПервоначальнаяСтоимость,
					Объект.ПервоначальнаяСтоимость / Объект.ПервоначальноеКоличество);
			КонецЕсли;
				
			Если СтрокиАмортизации.Количество() > 0 Тогда
				СтрокаЗапись.СуммаАмортизации = 0;
			КонецЕсли;
			
			Для Каждого СтрокаАмортизации Из СтрокиАмортизации Цикл
				Если СтрокаАмортизации.СуммаАмортизации <> 0 Тогда
					
					Если (СледующаяСтрокаЗапись = Неопределено Или СтрокаАмортизации.Период < СледующаяСтрокаЗапись.Период) Тогда
						СтрокаЗапись.СуммаАмортизации =  СтрокаЗапись.СуммаАмортизации + СтрокаАмортизации.СуммаАмортизации;
						Если СтрокаАмортизации.Период >= СтрокаЗапись.Период Тогда
							СтрокаЗапись.ПериодАмортизацииНачало = ?(СтрокаЗапись.ПериодАмортизацииНачало = '00010101', СтрокаАмортизации.Период,
																  Мин(СтрокаЗапись.ПериодАмортизацииНачало, СтрокаАмортизации.Период));
							СтрокаЗапись.ПериодАмортизацииКонец = Макс(СтрокаЗапись.ПериодАмортизацииКонец, СтрокаАмортизации.Период);
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
			
			Если СтрокаЗапись.СуммаАмортизации > СтрокаЗапись.БалансоваяСтоимость Тогда
				СтрокаЗапись.СуммаАмортизации = СтрокаЗапись.БалансоваяСтоимость;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Используется в правилах обмена
Процедура ДозаполнитьПриПереносеИзБГУ1(Объект) Экспорт
	
	ОсновноеСредство = Неопределено;
	Организация = Неопределено;
	
	Если Объект.ДополнительныеСвойства.Свойство("МестонахождениеОС") Тогда
		ДвиженияМестонаходение = Объект.ДополнительныеСвойства["МестонахождениеОС"];
	Иначе
		ДвиженияМестонаходение = Новый ТаблицаЗначений;
	КонецЕсли;
	
	// 1. В регистре накопления СтоимостьОбъектовОС отсутствуют движения по ОС в оперативном учете
	
	Таблица21 = Новый ТаблицаЗначений;
	Таблица21.Колонки.Добавить("ЦМО");
	Таблица21.Колонки.Добавить("Сумма");
	Таблица21.Колонки.Добавить("Количество");
	
	Для Каждого Движение Из Объект.Движения.ЖурналПроводокЕПСБУ Цикл
		Если БухгалтерскийУчет.СчетВИерархии(Движение.СчетДт, "21") Тогда
			СтрокаСчета21				= Таблица21.Добавить();
			СтрокаСчета21.ЦМО			= Движение.СубконтоДт.ЦМО;
			СтрокаСчета21.Сумма			= Движение.Сумма;
			СтрокаСчета21.Количество	= Движение.КоличествоДт;
			ОсновноеСредство			= Движение.СубконтоДт.ОсновныеСредства;
			Организация					= Движение.Организация;
		КонецЕсли;
	КонецЦикла;
	
	Если Таблица21.Количество() > 0 Тогда
		
		Таблица21Стоимость = Таблица21.Скопировать();
		Таблица21Стоимость.Свернуть(, "Сумма,Количество");
		ОбщаяСумма = Таблица21Стоимость[0].Сумма;
		ОбщееКоличество = Таблица21Стоимость[0].Количество;
		Цена = ?(ОбщееКоличество = 0, ОбщаяСумма, Окр(ОбщаяСумма / ОбщееКоличество, 2));
		
		СобытияВвода	= Новый Массив;
		СобытияСписания	= Новый Массив;
		СписаныеНомера	= Новый Массив;
		
		Для Каждого СтрокаСобытия Из Объект.Движения.СобытияОС Цикл
			Если ЗначениеЗаполнено(СтрокаСобытия.ИнвНомер) Тогда
				Если СтрокаСобытия.Событие = Перечисления.ВидыСобытийОС.ВводВЭксплуатацию Тогда
					СобытияВвода.Добавить(СтрокаСобытия);
				ИначеЕсли СтрокаСобытия.Событие = Перечисления.ВидыСобытийОС.Списание Тогда
					СобытияСписания.Добавить(СтрокаСобытия);
					СписаныеНомера.Добавить(СтрокаСобытия.ИнвНомер);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаСобытия Из СобытияВвода Цикл
			Если СписаныеНомера.Найти(СтрокаСобытия.ИнвНомер) = Неопределено Тогда
				СтрокаЦМО = Неопределено;
				ПериодЗаписи = '00010101';
				Для Каждого ЗаписьМестонаходение Из ДвиженияМестонаходение Цикл
					Если ЗаписьМестонаходение.ИнвНомер = СтрокаСобытия.ИнвНомер И ЗаписьМестонаходение.Период >= ПериодЗаписи Тогда
						СтрокаЦМО = ЗаписьМестонаходение;
						ПериодЗаписи = ЗаписьМестонаходение.Период;
					КонецЕсли;
				КонецЦикла;
				Если СтрокаЦМО <> Неопределено Тогда
					
					СтрокаРегистра = Объект.Движения.СтоимостьОбъектовОС.Добавить();
					СтрокаРегистра.ВидДвижения			= ВидДвиженияНакопления.Приход;
					СтрокаРегистра.Период				= Объект.Дата;
					СтрокаРегистра.Организация			= Организация;
					СтрокаРегистра.ОсновноеСредство		= ОсновноеСредство;
					СтрокаРегистра.ИнвентарныйНомер		= СтрокаСобытия.ИнвНомер;
					СтрокаРегистра.ЦМО					= СтрокаЦМО.ЦМО;
					СтрокаРегистра.ВидРаспоряжения		= Перечисления.ВидыРаспоряженияОС.ОперативныйУчет;
					СтрокаРегистра.Подразделение		= СтрокаЦМО.Подразделение;
					СтрокаРегистра.Стоимость			= Цена;
					СтрокаРегистра.Количество			= 1;
					СтрокаРегистра.Событие				= Перечисления.ВидыСобытийОС.ПринятиеКУчету;
					СтрокаРегистра.ДатаСобытия			= СтрокаСобытия.ДатаСобытия;
					СтрокаРегистра.НазваниеДокумента	= СтрокаСобытия.НазваниеДокумента;
					СтрокаРегистра.НомерДокумента		= СтрокаСобытия.НомерДокумента;
					СтрокаРегистра.ДатаДокумента		= СтрокаСобытия.ДатаДокумента;
					
					СтрокаТаблицы						= Таблица21.Добавить();
					СтрокаТаблицы.ЦМО					= СтрокаЦМО.ЦМО;
					СтрокаТаблицы.Сумма					= - Цена;
					СтрокаТаблицы.Количество			= - 1;
					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Таблица21.Свернуть("ЦМО", "Сумма,Количество");
		
		Для Каждого СтрокаТаблицы Из Таблица21 Цикл
			Если СтрокаТаблицы.Сумма <> 0 Или СтрокаТаблицы.Количество <> 0 Тогда
				
				СтрокаРегистра = Объект.Движения.СтоимостьОбъектовОС.Добавить();
				СтрокаРегистра.ВидДвижения			= ВидДвиженияНакопления.Приход;
				СтрокаРегистра.Период				= Объект.Дата;
				СтрокаРегистра.Организация			= Организация;
				СтрокаРегистра.ОсновноеСредство		= ОсновноеСредство;
				СтрокаРегистра.ИнвентарныйНомер		= Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
				СтрокаРегистра.ЦМО					= СтрокаТаблицы.ЦМО;
				СтрокаРегистра.ВидРаспоряжения		= Перечисления.ВидыРаспоряженияОС.ОперативныйУчет;
				СтрокаРегистра.Подразделение		= Справочники.Подразделения.ПустаяСсылка();
				СтрокаРегистра.Стоимость			= СтрокаТаблицы.Сумма;
				СтрокаРегистра.Количество			= СтрокаТаблицы.Количество;
				СтрокаРегистра.Событие				= Перечисления.ВидыСобытийОС.ПринятиеКУчету;
				
			КонецЕсли;
		КонецЦикла;
		
		// Подменяем событие списания
		
		Для Каждого СтрокаСобытия Из СобытияВвода Цикл
			
			НоваяСтрока = Объект.Движения.СобытияОС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСобытия);
			НоваяСтрока.Событие = Перечисления.ВидыСобытийОС.Списание;
			
			Для Каждого СтрокаСписания Из СобытияСписания Цикл
				Если СтрокаСписания.ИнвНомер = СтрокаСобытия.ИнвНомер Тогда
					Объект.Движения.СобытияОС.Удалить(СтрокаСписания);
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// 2. В регистре накопления СтоимостьОбъектовОСПоКонтрагентам отсутствуют записи
	
	ТаблицаПередачи = Новый ТаблицаЗначений;
	ТаблицаПередачи.Колонки.Добавить("ВидРаспоряжения");
	ТаблицаПередачи.Колонки.Добавить("Контрагент");
	ТаблицаПередачи.Колонки.Добавить("Сумма");
	ТаблицаПередачи.Колонки.Добавить("Количество");
	
	Для Каждого Движение Из Объект.Движения.ЖурналПроводокЕПСБУ Цикл
		Если БухгалтерскийУчет.СчетВИерархии(Движение.СчетДт, "25") Тогда
			СтрокаПередачи					= ТаблицаПередачи.Добавить();
			СтрокаПередачи.ВидРаспоряжения	= Перечисления.ВидыРаспоряженияОС.ПереданоВАренду;
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Движение.СчетДт, "26") Тогда
			СтрокаПередачи					= ТаблицаПередачи.Добавить();
			СтрокаПередачи.ВидРаспоряжения	= Перечисления.ВидыРаспоряженияОС.ПереданоВПользование;
		Иначе
			Продолжить;
		КонецЕсли;
		СтрокаПередачи.Контрагент	= Движение.СубконтоДт.Контрагенты;
		СтрокаПередачи.Сумма		= Движение.Сумма;
		СтрокаПередачи.Количество	= Движение.КоличествоДт;
		ОсновноеСредство			= Движение.СубконтоДт.ОсновныеСредства;
		Организация					= Движение.Организация;
	КонецЦикла;
	
	Если ТаблицаПередачи.Количество() > 0 Тогда
		
		ОстаткиНомера = Новый ТаблицаЗначений;
		ОстаткиНомера.Колонки.Добавить("ИнвентарныйНомер");
		ОстаткиНомера.Колонки.Добавить("ЦМО");
		ОстаткиНомера.Колонки.Добавить("Сумма");
		
		Для Каждого СтрокаСтоимость Из Объект.Движения.СтоимостьОбъектовОС Цикл
			Если СтрокаСтоимость.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаБалансе Тогда
				НоваяСтрока = ОстаткиНомера.Добавить();
				НоваяСтрока.ИнвентарныйНомер = СтрокаСтоимость.ИнвентарныйНомер;
				НоваяСтрока.ЦМО = СтрокаСтоимость.ЦМО;
				Если СтрокаСтоимость.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
					НоваяСтрока.Сумма = - СтрокаСтоимость.Стоимость;
				Иначе
					НоваяСтрока.Сумма = СтрокаСтоимость.Стоимость;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ОстаткиНомера.Свернуть("ИнвентарныйНомер,ЦМО", "Сумма");
		ВсегоСтрок = ОстаткиНомера.Количество();
		Для Сч = 1 По ВсегоСтрок Цикл
			ТекСтрока = ОстаткиНомера[ВсегоСтрок - Сч];
			Если ТекСтрока.Сумма <= 0 Тогда
				ОстаткиНомера.Удалить(ТекСтрока);
			КонецЕсли;
		КонецЦикла;
		
		КоличествоНомеров = ОстаткиНомера.Количество();
		Если КоличествоНомеров = 0 Тогда
			ОстаткиНомера.Добавить();
			КоличествоНомеров = 1;
		КонецЕсли;
		
		Для Каждого СтрокаОстатка Из ОстаткиНомера Цикл
			Для Каждого СтрокаПередачи Из ТаблицаПередачи Цикл
				СтрокаРегистра = Объект.Движения.СтоимостьОбъектовОСПоКонтрагентам.Добавить();
				СтрокаРегистра.ВидДвижения			= ВидДвиженияНакопления.Приход;
				СтрокаРегистра.Период				= Объект.Дата;
				СтрокаРегистра.Организация			= Организация;
				СтрокаРегистра.ЦМО					= СтрокаОстатка.ЦМО;
				СтрокаРегистра.Контрагент			= СтрокаПередачи.Контрагент;
				СтрокаРегистра.ОсновноеСредство		= ОсновноеСредство;
				СтрокаРегистра.ИнвентарныйНомер		= СтрокаОстатка.ИнвентарныйНомер;
				СтрокаРегистра.ВидРаспоряжения		= СтрокаПередачи.ВидРаспоряжения;
				СтрокаРегистра.Подразделение		= Справочники.Подразделения.ПустаяСсылка();
				СтрокаРегистра.Стоимость			= СтрокаПередачи.Сумма / КоличествоНомеров;
				СтрокаРегистра.Количество			= СтрокаПередачи.Количество / КоличествоНомеров; 
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	// 3. Если есть история местонаждения в старом регистре, то перенесем ее
	
	Если ДвиженияМестонаходение.Количество() > 0 Тогда
		ПеренестиИсториюМестонахождения(ДвиженияМестонаходение, Объект.Движения.СтоимостьОбъектовОС, Объект.Дата);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПеренестиИсториюМестонахождения(ДвиженияМестонаходение, ДвиженияСтоимость, Период)
	
	Данные = ДвиженияСтоимость.Выгрузить();
	
	Для Каждого Запись Из ДвиженияМестонаходение Цикл
		
		Если Не ЗначениеЗаполнено(Запись.ИнвНомер) Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("ВидДвижения,ИнвентарныйНомер,ЦМО",
			ВидДвиженияНакопления.Приход, Запись.ИнвНомер, Запись.ЦМО);
		СтрокиРегистра = Данные.НайтиСтроки(Отбор);
		НужнаяСтрока = Неопределено;
		Для Каждого СтрокаРегистра Из СтрокиРегистра Цикл
			Если НачалоДня(СтрокаРегистра.ДатаСобытия) = НачалоДня(Запись.Период) Тогда
				НужнаяСтрока = ДвиженияСтоимость[Данные.Индекс(СтрокаРегистра)];
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НужнаяСтрока = Неопределено Тогда
			Для Каждого СтрокаРегистра Из СтрокиРегистра Цикл
				Если НачалоДня(СтрокаРегистра.ДатаСобытия) = НачалоДня(Запись.ДатаДокумента) Тогда
					НужнаяСтрока = ДвиженияСтоимость[Данные.Индекс(СтрокаРегистра)];
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если НужнаяСтрока <> Неопределено Тогда
			Если НужнаяСтрока.Событие = Перечисления.ВидыСобытийОС.ПринятиеКУчету
				Или СтрокаРегистра.Событие = Перечисления.ВидыСобытийОС.ВнутреннееПеремещение Тогда
				// Ничего не делаем, нужная строка с нужным событием существует;
			ИначеЕсли НужнаяСтрока.Событие = Перечисления.ВидыСобытийОС.ПустаяСсылка() Тогда
				НужнаяСтрока.Событие = Перечисления.ВидыСобытийОС.ВнутреннееПеремещение;
			Иначе
				НужнаяСтрока = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		Если НужнаяСтрока = Неопределено Тогда
			
			СтрокаРегистра						= ДвиженияСтоимость.Добавить();
			СтрокаРегистра.ВидДвижения			= ВидДвиженияНакопления.Приход;
			СтрокаРегистра.Период				= Период;
			СтрокаРегистра.Организация			= Запись.Организация;
			СтрокаРегистра.ОсновноеСредство		= Запись.ОсновноеСредство;
			СтрокаРегистра.ИнвентарныйНомер		= Запись.ИнвНомер;
			СтрокаРегистра.ЦМО					= Запись.ЦМО;
			СтрокаРегистра.ВидРаспоряжения		= Перечисления.ВидыРаспоряженияОС.НаБалансе;
			СтрокаРегистра.Стоимость			= 0;
			СтрокаРегистра.Количество			= 0;
			СтрокаРегистра.Событие				= Перечисления.ВидыСобытийОС.ВнутреннееПеремещение;
			СтрокаРегистра.ДатаСобытия			= Запись.Период;
			СтрокаРегистра.НазваниеДокумента	= Запись.НазваниеДокумента;
			СтрокаРегистра.НомерДокумента		= Запись.НомерДокумента;
			СтрокаРегистра.ДатаДокумента		= Запись.ДатаДокумента;
			СтрокаРегистра.Подразделение		= Запись.Подразделение;
			
		Иначе
			
			Если Не ЗначениеЗаполнено(НужнаяСтрока.НазваниеДокумента) Тогда
				НужнаяСтрока.НазваниеДокумента = Запись.НазваниеДокумента;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(НужнаяСтрока.НомерДокумента) Тогда
				НужнаяСтрока.НомерДокумента = Запись.НомерДокумента;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(НужнаяСтрока.ДатаДокумента) Тогда
				НужнаяСтрока.ДатаДокумента = Запись.ДатаДокумента;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Функция ПараметрыУчетаОбъектаОС(ОсновноеСредство, Дата) Экспорт
	
	Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
		
		Реквизиты = "Организация,ИмуществоКазны,ГрупповойУчет,ТипНФА"; 
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновноеСредство, Реквизиты);
		
		Если ЗначенияРеквизитов.ИмуществоКазны Тогда
			УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(ЗначенияРеквизитов.Организация, КонецГода(Дата)+1);
			ВедетсяАналитическийУчет		= УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны;
			ВедетсяНачислениеАмортизации	= УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны;
			ВедетсяУчетПоПодразделениям		= УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетИКПоПодразделениям();
		Иначе
			ВедетсяАналитическийУчет		= Не ЗначенияРеквизитов.ГрупповойУчет
				Или ЗначенияРеквизитов.ТипНФА <> Перечисления.ТипыНФА.БиблиотечныйФонд;
			ВедетсяНачислениеАмортизации	= Истина;
			ВедетсяУчетПоПодразделениям		= УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям();
		КонецЕсли;
		
	Иначе
		
		ВедетсяАналитическийУчет		= Истина;
		ВедетсяНачислениеАмортизации	= Истина;
		ВедетсяУчетПоПодразделениям		= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ВедетсяАналитическийУчет"		, ВедетсяАналитическийУчет);
	Результат.Вставить("ВедетсяНачислениеАмортизации"	, ВедетсяНачислениеАмортизации);
	Результат.Вставить("ВедетсяУчетПоПодразделениям"	, ВедетсяУчетПоПодразделениям);
	
	Возврат Результат;
	
КонецФункции

Функция ДатаВводаОстатков(Параметр) Экспорт
	
	ЭтоОрганизация		= (ТипЗнч(Параметр) = Тип("СправочникСсылка.Организации"));
	Организация			= ?(ЭтоОрганизация, Параметр, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметр, "Организация"));
	ОсновноеСредство	= ?(ЭтоОрганизация, Неопределено, Параметр);
	
	// Получим дату ввода начальных остатков
	МенеджерЗаписиРегистра = РегистрыСведений.ДатыВводаНачальныхОстатков.СоздатьМенеджерЗаписи();
	МенеджерЗаписиРегистра.Организация = Организация;
	МенеджерЗаписиРегистра.Прочитать();
	Если МенеджерЗаписиРегистра.Выбран() Тогда
		Возврат КонецДня(МенеджерЗаписиРегистра.ДатаВводаНачальныхОстатков);
	КонецЕсли;
	
	// Получим дату ввода остатков и свертки из документов
	Запрос = Новый Запрос;
	
	Если ЭтоОрганизация Тогда
		
		РазделУчета = Новый Массив;
		РазделУчета.Добавить(Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства);
		РазделУчета.Добавить(Перечисления.РазделыУчетаДляВводаОстатков.НПА);
		РазделУчета.Добавить(Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны);
		РазделУчета.Добавить(Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете);
		
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("РазделУчета", РазделУчета);
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Документ.Дата КАК Дата
		|ПОМЕСТИТЬ ВТ_ВводОстатков
		|ИЗ
		|	Документ.ВводНачальныхОстатков КАК Документ
		|ГДЕ
		|	Документ.Проведен
		|	И Документ.Организация = &Организация
		|	И Документ.РазделУчета В(&РазделУчета)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Документ.Дата
		|ИЗ
		|	Документ.ВводНачальныхОстатковОС КАК Документ
		|ГДЕ
		|	Документ.Проведен
		|	И Документ.Организация = &Организация
		|	И Документ.ОтражатьВБухгалтерскомУчете
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(Регистр.Регистратор КАК Документ.КорректировкаРегистров).Дата КАК Дата
		|ПОМЕСТИТЬ ВТ_Корректировка
		|ИЗ
		|	РегистрСведений.СобытияОС КАК Регистр
		|ГДЕ
		|	Регистр.Регистратор ССЫЛКА Документ.КорректировкаРегистров
		|	И Регистр.Организация = &Организация";
		
	Иначе
		
		Запрос.УстановитьПараметр("ОС", ОсновноеСредство);
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Таблица.Ссылка.Дата КАК Дата
		|ПОМЕСТИТЬ ВТ_ВводОстатков
		|ИЗ
		|	Документ.ВводНачальныхОстатков.ОС_Основная КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка.Проведен
		|	И Таблица.ОС = &ОС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(Регистр.Регистратор КАК Документ.КорректировкаРегистров).Дата КАК Дата
		|ПОМЕСТИТЬ ВТ_Корректировка
		|ИЗ
		|	РегистрСведений.СобытияОС КАК Регистр
		|ГДЕ
		|	Регистр.Регистратор ССЫЛКА Документ.КорректировкаРегистров
		|	И Регистр.ОсновноеСредство = &ОС";
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + ";" +
	
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_ВводОстатков.Дата КАК Дата
	|ИЗ
	|	ВТ_ВводОстатков КАК ВТ_ВводОстатков
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			МИНИМУМ(ВТ_ВводОстатков.Дата) КАК Дата
	|		ИЗ
	|			ВТ_ВводОстатков КАК ВТ_ВводОстатков) КАК ДатаМин
	|		ПО (ИСТИНА)
	|ГДЕ
	|	ВТ_ВводОстатков.Дата <= КОНЕЦПЕРИОДА(ДатаМин.Дата, ДЕНЬ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_ВводОстатков.Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_Корректировка.Дата КАК Дата
	|ИЗ
	|	ВТ_Корректировка КАК ВТ_Корректировка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			МИНИМУМ(ВТ_Корректировка.Дата) КАК Дата
	|		ИЗ
	|			ВТ_Корректировка КАК ВТ_Корректировка) КАК ДатаМин
	|		ПО (ИСТИНА)
	|ГДЕ
	|	ВТ_Корректировка.Дата <= КОНЕЦПЕРИОДА(ДатаМин.Дата, ДЕНЬ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Корректировка.Дата УБЫВ";
	
	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.ВыполнитьПакет();
	
	Выборка = Результат[2].Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Дата;
	КонецЕсли;
	
	Выборка = Результат[3].Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Дата;
	КонецЕсли;
	
	Возврат '00010101';
	
КонецФункции

// Устарела.
