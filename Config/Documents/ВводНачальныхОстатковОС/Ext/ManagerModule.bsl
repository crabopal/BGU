Процедура УсловноеОформлениеАгрегатора(УсловноеОформление, ИмяСписка = "Список", ИмяПоля = "СостояниеОперацииКартинка") Экспорт
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, ИмяПоля);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор, ИмяСписка + ".ЭтоАгрегаторДвижений",
		ВидСравненияКомпоновкиДанных.Равно, Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаПодсказки);
	
КонецПроцедуры

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	События = Новый СписокЗначений;
	События.Добавить(Перечисления.СобытияИсторииСтоимостиОС.Консервация);
	События.Добавить(Перечисления.СобытияИсторииСтоимостиОС.Расконсервация);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("События", События);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВводНачальныхОстатковОССтоимостьИАмортизация.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС.СтоимостьИАмортизация КАК ВводНачальныхОстатковОССтоимостьИАмортизация
	|ГДЕ
	|	ВводНачальныхОстатковОССтоимостьИАмортизация.Событие В (&События)
	|	И ВводНачальныхОстатковОССтоимостьИАмортизация.Ссылка.ЭтоАгрегаторДвижений";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяОбъекта = "Документ.ВводНачальныхОстатковОС";
	Параметры.ОбработкаЗавершена = Ложь;
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			Документы.ВводНачальныхОстатковОС.ПерезаполнитьДокументАгрегатор(Выборка.Ссылка);
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка,, Параметры.Очередь);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			Шаблон = НСтр("ru = 'Не удалось записать документ: %1 по причине: %2'");
			ТекстСообщения = СтрШаблон(Шаблон, Выборка.Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.ВводНачальныхОстатковОС,
				Выборка.Ссылка,
				ТекстСообщения);
			
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ВыполнитьОперацию", Истина);
	Методы.Вставить("ПеренестиУстаревшиеДокументы", Истина);
КонецПроцедуры

#КонецОбласти

#Область ПомощникОбъединения

Процедура ВыполнитьОперацию(Параметры, АдресХранилища) Экспорт
	
	Если Параметры.Операция = "ПолучитьСписокОС" Тогда
		
		СписокОС = ПолучитьСписокОС(Параметры.Период, Параметры.Организация, Параметры.ВидДокумента);
		ПоместитьВоВременноеХранилище(СписокОС, АдресХранилища);
		
	ИначеЕсли Параметры.Операция = "ПолучитьДокументы" Тогда
		
		ДокументыОС = ПолучитьДокументы(Параметры.Период, Параметры.Организация,
			Параметры.ОсновноеСредство, Параметры.ПолучитьОбщийСписок, Параметры.ВидДокумента);
		ПоместитьВоВременноеХранилище(ДокументыОС, АдресХранилища);
		
	ИначеЕсли Параметры.Операция = "СоздатьАгрегатор" Тогда
		
		СоздатьАгрегатор(Параметры.Период, Параметры.СписокОС, Параметры.Организация, Параметры.ВидДокумента);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСписокОС(Период, Организация, ВидДокумента)
	
	КодыСчетов = ?(ВидДокумента = 0, "101.00,102.00,103.00,104.00,108.00,21,25,26", "01,02,22");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"		, Период);
	Запрос.УстановитьПараметр("Граница"		, Новый Граница(Период, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Запрос.УстановитьПараметр("Субконто"	, ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	Запрос.УстановитьПараметр("Счет"		, БухгалтерскийУчет.СписокСчетов(КодыСчетов));
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	
	// У списанных ОС нет остатков, поэтому подбираем и по РС СобытияОС
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Проводки.Субконто1 КАК ОсновноеСредство
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Граница, Счет В (&Счет), &Субконто, Организация = &Организация) КАК Проводки
	|ГДЕ
	|	Проводки.Субконто1 <> НЕОПРЕДЕЛЕНО
	|	И Проводки.Субконто1 <> ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СобытияОС.ОсновноеСредство
	|ИЗ
	|	РегистрСведений.СобытияОС КАК СобытияОС
	|ГДЕ
	|	СобытияОС.Организация = &Организация
	|	И СобытияОС.Период <= &Период
	|	И &ВидДокумента = 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОсновноеСредство
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДокументы(Период, Организация, ОсновноеСредство, ПолучитьОбщийСписок, ВидДокумента)
	
	Регистры = ОпределитьДвигаемыеРегистры(ВидДокумента);
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПроводкиПоОС.ОсновноеСредство,
	|	ЖурналПроводокЕПСБУ.Регистратор
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЖурналПроводокЕПСБУСубконто.Регистратор КАК Регистратор,
	|			ЖурналПроводокЕПСБУСубконто.НомерСтроки КАК НомерСтроки,
	|			ЖурналПроводокЕПСБУСубконто.Значение КАК ОсновноеСредство
	|		ИЗ
	|			РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Субконто КАК ЖурналПроводокЕПСБУСубконто
	|		ГДЕ
	|			ЖурналПроводокЕПСБУСубконто.Вид = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)
	|			И ЖурналПроводокЕПСБУСубконто.Значение В(&ОсновноеСредство)) КАК ПроводкиПоОС
	|		ПО ЖурналПроводокЕПСБУ.Регистратор = ПроводкиПоОС.Регистратор
	|			И ЖурналПроводокЕПСБУ.НомерСтроки = ПроводкиПоОС.НомерСтроки
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.Период <= &Период
	|	И ЖурналПроводокЕПСБУ.УточнениеПериода = 0
	|	И ЖурналПроводокЕПСБУ.Организация = &Организация
	|	И ЖурналПроводокЕПСБУ.Активность
	|	И (ЖурналПроводокЕПСБУ.СчетДт В (&Счет)
	|			ИЛИ ЖурналПроводокЕПСБУ.СчетКт В (&Счет))";
	
	// В тексте запроса исключаются движения межотчетного периода по условию УточнениеПериода = 0.
	// Но в старых документах уточнение периода не заполнено и равно 0. По этому дополнительно
	// исключаем движения заведомо известных документов межотчетного периода по типу документа
	ТекстЗапроса = ТекстЗапроса + "
	|	И НЕ ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.ЗакрытиеГода
	|	И НЕ ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.ЗакрытиеГодаТехнологическое
	|	И НЕ ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.ЗакрытиеЗабалансовыхСчетовПоступленийИВыбытийДенежныхСредств
	|	И НЕ ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.ЗакрытиеСчетовСанкционирования
	|	И НЕ ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.ПереносОстатковПоКПС";
	
	
	Для Каждого СтрокаРегистра Из Регистры Цикл
		
		Если СтрокаРегистра.ИмяРегистра = "ЖурналПроводокЕПСБУ" Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
		| ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Регистр." + СтрокаРегистра.ИмяРеквизита + " КАК ОсновноеСредство,
		|	Регистр.Регистратор
		|ИЗ
		|	" + СтрокаРегистра.ПолноеИмяРегистра + " КАК Регистр
		|ГДЕ
		|	" + ?(СтрокаРегистра.ИмяУчреждения = "", "", "Регистр." + СтрокаРегистра.ИмяУчреждения + " = &Организация И") + "
		|	Регистр." + СтрокаРегистра.ИмяРеквизита + " В (&ОсновноеСредство)
		|	И Регистр.Период <= &Период
		|	И Регистр.Активность";
		
		Если СтрокаРегистра.ИмяРегистра = "УчетныеДанныеОбъектаОС" Тогда
			ТекстЗапроса = ТекстЗапроса + " И Регистр.СчетУчета В (&СчетУчета)
				|И НЕ Регистр.Регистратор ССЫЛКА Документ.ПереносОстатковПоКПС";
		ИначеЕсли СтрокаРегистра.ИмяРегистра = "ПервоначальныеСведенияОСНалоговыйУчет" Тогда
			ТекстЗапроса = ТекстЗапроса + " И НЕ Регистр.Регистратор ССЫЛКА Документ.ЗакрытиеСчетовНалоговогоУчета";
		КонецЕсли;
		
		мРегистра = Метаданные.НайтиПоПолномуИмени(СтрокаРегистра.ПолноеИмяРегистра);
		Подчиненный = СтрокаРегистра.ТипРегистра <> "РегистрСведений" Или Строка(мРегистра.РежимЗаписи) = "ПодчинениеРегистратору";
		Если Подчиненный Тогда
			мДвижения = Метаданные.Документы.ПереносОстатков64нНФА.Движения;
			Если мДвижения.Содержит(мРегистра) Тогда
				ТекстЗапроса = ТекстЗапроса + " И НЕ Регистр.Регистратор ССЫЛКА Документ.ПереносОстатков64нНФА";
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + ";" +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ.Регистратор,
	|	ВТ.Регистратор.Дата КАК ДатаДокумента
	|ИЗ
	|	ВТ_Документы КАК ВТ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДокумента
	|ИТОГИ ПО
	|	ОсновноеСредство";
	
	Если ТипЗнч(ОсновноеСредство) = Тип("Массив") Тогда
		КолВо = ОсновноеСредство.Количество();
		Для Сч = 1 По КолВо Цикл
			Индекс = КолВо - Сч;
			Если Не ЗначениеЗаполнено(ОсновноеСредство[Индекс]) Тогда
				ОсновноеСредство.Удалить(Индекс);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ВидДокумента = 0 Тогда
		КодыСчет		= "101.00,102.00,103.00,104.00,108.00,21,25,26";
		КодыСчетУчета	= "101.00,102.00,103.00,108.00";
		ТипДокОст		= Тип("ДокументСсылка.ВводНачальныхОстатковОС");
	Иначе
		КодыСчет		= "01,02,22";
		КодыСчетУчета	= "01,02,22";
		ТипДокОст		= Тип("ДокументСсылка.ВводНачальныхОстатков");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, ОсновноеСредство);
	Запрос.УстановитьПараметр("Организация"			, Организация);
	Запрос.УстановитьПараметр("Период"				, Период);
	Запрос.УстановитьПараметр("Субконто"			, ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	Запрос.УстановитьПараметр("Счет"				, БухгалтерскийУчет.СписокСчетов(КодыСчет));
	Запрос.УстановитьПараметр("СчетУчета"			, БухгалтерскийУчет.СписокСчетов(КодыСчетУчета));
	
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДокументыПереноса = ДоступныеДляПереносаДокументы();
	
	
	ТаблицаОС = Новый ТаблицаЗначений;
	ТаблицаОС.Колонки.Добавить("ОсновноеСредство");
	ТаблицаОС.Колонки.Добавить("Состояние");
	ТаблицаОС.Колонки.Добавить("СписокДокументов");
	ТаблицаОС.Колонки.Добавить("Документ");
	
	СписокДокументов = Новый ТаблицаЗначений;
	СписокДокументов.Колонки.Добавить("Документ");
	СписокДокументов.Колонки.Добавить("Состояние");
	
	ВсеДокументы = Новый ТаблицаЗначений;
	ВсеДокументы.Колонки.Добавить("Документ");
	
	Для Каждого ОС Из ОсновноеСредство Цикл
		
		СтрокаОС = ТаблицаОС.Добавить();
		СтрокаОС.СписокДокументов = СписокДокументов.СкопироватьКолонки();
		СтрокаОС.ОсновноеСредство = ОС;
		
		ДокументыОС = Результат.Строки.Найти(ОС, "ОсновноеСредство");
		
		Если ДокументыОС <> Неопределено Тогда
			
			ДокументыОСМассив = ДокументыОС.Строки.ВыгрузитьКолонку("Регистратор");
			
			Если ДокументыОСМассив.Количество() = 1 Тогда
				
				Док = ДокументыОСМассив[0];
				
				СтрокаДок = СтрокаОС.СписокДокументов.Добавить();
				СтрокаДок.Документ = Док;
				
				Если ТипЗнч(Док) = ТипДокОст Тогда
					
					СтрокаДок.Состояние	= 3;	// Золотой шар
					СтрокаОС.Состояние	= 3;
					СтрокаОС.Документ	= Док;
					
				ИначеЕсли ПолучитьОбщийСписок Тогда 
					
					// Добавим документ в общий список
					ВсеДокументы.Добавить().Документ = Док;
					
				КонецЕсли;
				
			Иначе
				
				ЕстьОшибки = Ложь;
				
				Для Каждого Док Из ДокументыОСМассив Цикл
					
					СтрокаДок = СтрокаОС.СписокДокументов.Добавить();
					СтрокаДок.Документ = Док;
					СтрокаДок.Состояние = 0;
					
					Если ДокументыПереноса.Найти(ТипЗнч(Док)) = Неопределено Тогда
						СтрокаДок.Состояние = 6; // Красный шар
						ЕстьОшибки = Истина;
					КонецЕсли;
					
					Если ПолучитьОбщийСписок Тогда 
						// Добавим документ в общий список
						ВсеДокументы.Добавить().Документ = Док;
					КонецЕсли;
					
				КонецЦикла;
				
				Если ЕстьОшибки Тогда
					СтрокаОС.Состояние = 6;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ПолучитьОбщийСписок Тогда	
		ВсеДокументы.Свернуть("Документ");
		ВсеДокументы.Сортировать("Документ");
		ВсеДокументы = ВсеДокументы.ВыгрузитьКолонку("Документ");
	Иначе
		ВсеДокументы = Новый Массив;
	КонецЕсли;
	
	Возврат Новый Структура("ТаблицаОС,СписокДокументов", ТаблицаОС, ВсеДокументы);
	
КонецФункции

Процедура СоздатьАгрегатор(Период, СписокОС, Организация, ВидДокумента)
	
	Регистры = ОпределитьДвигаемыеРегистры(ВидДокумента);
	
	Если ВидДокумента = 0 Тогда
		
		ТиповаяОперация = Справочники.ТиповыеОперации.ВводНачальныхОстатковОС_ВводНачальныхОстатковОС;
		
		УстановитьИспользованиеИтогов(Ложь, Регистры);
		
		Для Каждого СтрокаОС Из СписокОС Цикл
			
			Результат = СоздатьДокументАгрегатор(СтрокаОС.ОсновноеСредство, СтрокаОС.СписокДокументов, Период, Регистры, ТиповаяОперация);
			Результат.Вставить("ОсновноеСредство", СтрокаОС.ОсновноеСредство); 
			Результат = ОбщегоНазначения.ЗначениеВСтрокуXML(Результат);
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "#Агрегатор#" + Результат;
			Сообщение.Сообщить();
			
		КонецЦикла;
		
	ИначеЕсли ВидДокумента = 1 Тогда
		
		ДеревоДокументов = ПолучитьДеревоДокументовВводаОстатков(Период, СписокОС.ВыгрузитьКолонку("ОсновноеСредство"), Организация);
		
		УстановитьИспользованиеИтогов(Ложь, Регистры);
		
		Для Каждого СтрокаДерева Из ДеревоДокументов.Строки Цикл
			
			СоздатьДокументВводОстатков(СтрокаДерева, СписокОС, Период, Регистры);
			
			Для Каждого СтрокаОС Из СтрокаДерева.Строки Цикл
				
				Результат = СтрокаОС.Результат;
				Результат.Вставить("ОсновноеСредство", СтрокаОС.ОсновноеСредство);
				Результат.Вставить("Документ", СтрокаДерева.Документ);
				Результат = ОбщегоНазначения.ЗначениеВСтрокуXML(СтрокаОС.Результат);
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "#Агрегатор#" + Результат;
				Сообщение.Сообщить();
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьИспользованиеИтогов(Истина, Регистры);
	
	ПометитьНаУдалениеПустыеКорректировки(Организация);
	
КонецПроцедуры


Функция ОпределитьДвигаемыеРегистры(ВидДокумента = 0) Экспорт
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	Регистры = Новый ТаблицаЗначений;
	Регистры.Колонки.Добавить("ТипРегистра"			, ТипСтрока);
	Регистры.Колонки.Добавить("ИмяРегистра"			, ТипСтрока);
	Регистры.Колонки.Добавить("ИмяРеквизита"		, ТипСтрока);
	Регистры.Колонки.Добавить("ИмяУчреждения"		, ТипСтрока);
	Регистры.Колонки.Добавить("ПолноеИмяРегистра"	, ТипСтрока);
	Регистры.Колонки.Добавить("Отбор"				, Новый ОписаниеТипов("Структура"));
	
	
	ДобавитьРегистр(Регистры, "РегистрБухгалтерии", "ЖурналПроводокЕПСБУ");
	
	Если ВидДокумента = 0 Тогда
		
		ДобавитьРегистр(Регистры, "РегистрСведений", "УчетныеДанныеОбъектаОС");
		ДобавитьРегистр(Регистры, "РегистрСведений", "ПервоначальныеСведенияОСБухгалтерскийУчет");
		ДобавитьРегистр(Регистры, "РегистрСведений", "НомераИнвентарныхКарточек");
		ДобавитьРегистр(Регистры, "РегистрСведений", "СобытияОС");
		ДобавитьРегистр(Регистры, "РегистрСведений", "АмортизацияОС");
		ДобавитьРегистр(Регистры, "РегистрСведений", "НачислениеАмортизацииОСБухгалтерскийУчет");
		ДобавитьРегистр(Регистры, "РегистрСведений", "ПараметрыАмортизацииОСБухгалтерскийУчет");
		ДобавитьРегистр(Регистры, "РегистрСведений", "РасчетАмортизацииОС");
		ДобавитьРегистр(Регистры, "РегистрСведений", "КапРемонтОС", "ОС");
		ДобавитьРегистр(Регистры, "РегистрСведений", "ПереоценкаНФА", "НФА");
		
		ДобавитьРегистр(Регистры, "РегистрНакопления", "СтоимостьОбъектовОС");
		ДобавитьРегистр(Регистры, "РегистрНакопления", "СтоимостьОбъектовОСПоКонтрагентам");
		ДобавитьРегистр(Регистры, "РегистрНакопления", "АмортизацияОбъектовОС");
		ДобавитьРегистр(Регистры, "РегистрНакопления", "НаличиеДрагМатериаловВОбъектахНФА", "ОбъектНФА");
		
		ДобавитьРегистр(Регистры, "РегистрСведений", "НачислениеАмортизацииОСНалоговыйУчет");
		ДобавитьРегистр(Регистры, "РегистрСведений", "ПараметрыАмортизацииОСНалоговыйУчет");
		ДобавитьРегистр(Регистры, "РегистрСведений", "ПервоначальныеСведенияОСНалоговыйУчет");
		ДобавитьРегистр(Регистры, "РегистрСведений", "НачислениеАмортизацииОССпециальныйКоэффициентНалоговыйУчет");
		ДобавитьРегистр(Регистры, "РегистрСведений", "ПервоначальныеСведенияОСНалоговыйУчетУСН");
		
	Иначе
		
		ДобавитьРегистр(Регистры, "РегистрСведений", "УчетныеДанныеОбъектаОС");
		ДобавитьРегистр(Регистры, "РегистрСведений", "ПервоначальныеСведенияОСБухгалтерскийУчет");
		ДобавитьРегистр(Регистры, "РегистрСведений", "НомераИнвентарныхКарточек");
		ДобавитьРегистр(Регистры, "РегистрСведений", "СобытияОС");
		ДобавитьРегистр(Регистры, "РегистрСведений", "КапРемонтОС", "ОС");
		
		ДобавитьРегистр(Регистры, "РегистрНакопления", "СтоимостьОбъектовОСПоКонтрагентам");
		
	КонецЕсли;
	
	Возврат Регистры;
	
КонецФункции

Функция ДоступныеДляПереносаДокументы()
	
	ДокументыПереноса = Новый Массив;
	
	ДокументыПереноса.Добавить(Тип("ДокументСсылка.ВводИсторииКапремонта"));
	ДокументыПереноса.Добавить(Тип("ДокументСсылка.ИзменениеСостоянияОС"));
	ДокументыПереноса.Добавить(Тип("ДокументСсылка.ВводНачальныхОстатков"));
	ДокументыПереноса.Добавить(Тип("ДокументСсылка.ИзменениеДанныхОС"));
	ДокументыПереноса.Добавить(Тип("ДокументСсылка.ИзменениеПараметровАмортизации"));
	ДокументыПереноса.Добавить(Тип("ДокументСсылка.КорректировкаАмортизации"));
	ДокументыПереноса.Добавить(Тип("ДокументСсылка.КорректировкаРегистров"));
	ДокументыПереноса.Добавить(Тип("ДокументСсылка.ОперацияБух"));
	ДокументыПереноса.Добавить(Тип("ДокументСсылка.ВводНачальныхОстатковОС"));
	ДокументыПереноса.Добавить(Тип("ДокументСсылка.ИзменениеНаличияДрагМатериалов"));
	ДокументыПереноса.Добавить(Тип("ДокументСсылка.ВводИсторииАмортизацииОС"));
	
	Возврат ДокументыПереноса;
	
КонецФункции

Процедура ДобавитьРегистр(Регистры, ТипРегистра, ИмяРегистра, ИмяРеквизита = "ОсновноеСредство", ИмяУчреждения = "Организация")
	
	НовыйРегистр = Регистры.Добавить();
	
	НовыйРегистр.ТипРегистра		= ТипРегистра;
	НовыйРегистр.ИмяРегистра		= ИмяРегистра;
	НовыйРегистр.ИмяРеквизита		= ИмяРеквизита;
	НовыйРегистр.ИмяУчреждения		= ИмяУчреждения;
	НовыйРегистр.ПолноеИмяРегистра	= ТипРегистра + "." + ИмяРегистра;
	
	Если ТипРегистра = "РегистрСведений" Тогда
		МетаданныеРег = Метаданные.РегистрыСведений[ИмяРегистра];
		ИзмеренияРегистра = Новый Массив;
		Для Каждого Реквизит Из МетаданныеРег.СтандартныеРеквизиты Цикл
			Если Реквизит.Имя = "Период" Тогда
				ИзмеренияРегистра.Добавить(Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Измерение Из МетаданныеРег.Измерения Цикл
			ИзмеренияРегистра.Добавить(Измерение.Имя);
		КонецЦикла;
		Измерения = СтрСоединить(ИзмеренияРегистра, ",");
		НовыйРегистр.Отбор = Новый Структура(Измерения);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьИспользованиеИтогов(Использование, Регистры) Экспорт
	НачатьТранзакцию();
	Попытка
		Для Каждого Регистр Из Регистры Цикл
			
			Если Регистр.ТипРегистра = "РегистрБухгалтерии" Тогда
				ТипРегистра = РегистрыБухгалтерии;
			ИначеЕсли Регистр.ТипРегистра = "РегистрНакопления" Тогда
				Если Строка(Метаданные.РегистрыНакопления[Регистр.ИмяРегистра].ВидРегистра) <> "Остатки" Тогда
					Продолжить;
				КонецЕсли;
				ТипРегистра = РегистрыНакопления;
			Иначе
				Продолжить;
			КонецЕсли;
			
			УстановитьИспользованиеИтоговРегистра(ТипРегистра[Регистр.ИмяРегистра], Использование);
			
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(ИнформацияОбОшибке);
		ВызватьИсключение(ТекстСообщения);
	КонецПопытки;		
КонецПроцедуры

Процедура УстановитьИспользованиеИтоговРегистра(МенеджерРегистра, Признак)
	
	// Непосредственное изменение использования итогов вынесено в отдельну процедуру
	// чтобы оптимальнее занимать и освобождать память
	
	МенеджерРегистра.УстановитьИспользованиеИтогов(Признак);
	
	Если Признак Тогда
		МенеджерРегистра.ПересчитатьИтоги();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПометитьНаУдалениеПустыеКорректировки(Организация = Неопределено) Экспорт
	
	ТаблицыЗапросов = Новый Массив;
	
	Для Каждого Движения Из Метаданные.Документы.КорректировкаРегистров.Движения Цикл
		
		ТекстТаблицы =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Регистр.Регистратор КАК Регистратор
		|ИЗ
		|	&Регистр КАК Регистр
		|ГДЕ
		|	Регистр.Регистратор ССЫЛКА Документ.КорректировкаРегистров";
		
		ТаблицыЗапросов.Добавить(СтрЗаменить(ТекстТаблицы, "&Регистр", Движения.ПолноеИмя()));
		
	КонецЦикла;
	
	ТекстЗапроса = СтрСоединить(ТаблицыЗапросов, "
		| ОБЪЕДИНИТЬ
		|");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	ДокСДвижениями = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"		, ДокСДвижениями);
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КорректировкаРегистров.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КорректировкаРегистров КАК КорректировкаРегистров
	|ГДЕ
	|	КорректировкаРегистров.Организация = &Организация
	|	И НЕ КорректировкаРегистров.ПометкаУдаления
	|	И НЕ КорректировкаРегистров.Ссылка В (&Ссылка)";
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КорректировкаРегистров.Организация = &Организация", "ИСТИНА");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект.ПометкаУдаления = Истина;
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЦикла;
	
КонецПроцедуры

#Область ДокументАгрегатор

Функция СоздатьДокументАгрегатор(ОсновноеСредство, СписокДокументов, Период, Регистры, ТиповаяОперация)
	
	Результат = Новый Структура("Документ,СостояниеОС,СостояниеДокументов", Неопределено, 0, Новый Массив);
	
	Если СписокДокументов.Количество() = 0 Тогда
		Результат.СостояниеОС = 2;
		Возврат Результат;
	КонецЕсли;
	
	
	Отказ = Ложь;
	
	НачатьТранзакцию();
	
	НовыйДокумент = Документы.ВводНачальныхОстатковОС.СоздатьДокумент();
	
	Для Каждого СтрокаДокумента Из СписокДокументов Цикл
		
		Попытка
			
			УдалитьОсновноеСредствоИзДокумента(СтрокаДокумента.Документ, ОсновноеСредство, НовыйДокумент.Движения, Регистры);
			Результат.СостояниеДокументов.Добавить(1); //Зеленый шар
			
		Исключение
			
			Результат.СостояниеДокументов.Добавить(6);
			Отказ = Истина;
			
			ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			Прервать;
			
		КонецПопытки;
		
	КонецЦикла;
	
	ЕстьПроводки = (НовыйДокумент.Движения.ЖурналПроводокЕПСБУ.Количество() > 0);
	ЕстьСобытия  = (НовыйДокумент.Движения.СобытияОС.Количество() > 0);
	НетДвижений  = (Не ЕстьПроводки И Не ЕстьСобытия);
	
	Если Отказ Или НетДвижений Тогда
		
		ОтменитьТранзакцию();
		
	Иначе
		
		Для Каждого ТаблицаДвижений Из НовыйДокумент.Движения Цикл
			ТаблицаДвижений.ОбменДанными.Загрузка = Истина;
			ТаблицаДвижений.Записывать = Истина;
		КонецЦикла;
		
		Попытка
			
			НовыйДокумент.Заполнить("ИзДвиженийДокумента");
			НовыйДокумент.ОсновноеСредство = ОсновноеСредство;
			Если Не ЗначениеЗаполнено(НовыйДокумент.Организация) Тогда
				НовыйДокумент.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновноеСредство, "Организация");
			КонецЕсли;
			НовыйДокумент.Дата = Период;
			НовыйДокумент.УстановитьНовыйНомер();
			НовыйДокумент.Проведен = Истина;
			НовыйДокумент.ОбменДанными.Загрузка = Истина;
			НовыйДокумент.Записать();
			
			БухгалтерскиеОперацииСервер.ЗаписатьДанныеТиповойОперацииОбъекта(НовыйДокумент, ТиповаяОперация,,,, ЕстьПроводки);
			
			ДокументРезультат = НовыйДокумент.Ссылка;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			Отказ = Истина;
			
			ДокументРезультат = Документы.ВводНачальныхОстатковОС.ПустаяСсылка();
			
		КонецПопытки;
		
	КонецЕсли;
	
	Результат.СостояниеОС = ?(Отказ, 6, ?(НетДвижений, 2, 1));
	Результат.Документ = ДокументРезультат;
	
	Возврат Результат;
	
КонецФункции

Функция УдалитьОсновноеСредствоИзДокумента(ДокументСсылка, ОсновноеСредство, Движения, Регистры)
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	ДокОбъект = ДокументСсылка.ПолучитьОбъект();
	
	Если ДокОбъект = Неопределено Тогда
		ВызватьИсключение Строка(ТипЗнч(ДокументСсылка)) + ": " + Строка(ДокументСсылка);
	КонецЕсли;
	
	Если ТипДокумента = Тип("ДокументСсылка.ВводИсторииКапремонта")
		Или ТипДокумента = Тип("ДокументСсылка.ВводИсторииАмортизацииОС")
		Или ТипДокумента = Тип("ДокументСсылка.ИзменениеСостоянияОС")
		Или ТипДокумента = Тип("ДокументСсылка.ВводНачальныхОстатковОС") Тогда
		
		СкопироватьДвиженияДокумента(Регистры, Движения, ДокОбъект.Движения, ОсновноеСредство);
		ЗаписатьДокумент(ДокОбъект, Истина);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВводНачальныхОстатков") Тогда
		
		УдалитьОСИзТаблицы(ДокОбъект.ОС_Основная		, ОсновноеСредство, "ОС");
		УдалитьОСИзТаблицы(ДокОбъект.ОС_Амортизация		, ОсновноеСредство, "ОС");
		УдалитьОСИзТаблицы(ДокОбъект.ОС_РасходыУСН		, ОсновноеСредство, "ОС");
		УдалитьОСИзТаблицы(ДокОбъект.КапРемонтОС		, ОсновноеСредство, "ОС");
		УдалитьОСИзТаблицы(ДокОбъект.КапРемонтОСОтбор	, ОсновноеСредство, "ОС");
		УдалитьОСИзТаблицы(ДокОбъект.МодернизацияОС		, ОсновноеСредство, "ОС");
		УдалитьОСИзТаблицы(ДокОбъект.МодернизацияОСОтбор, ОсновноеСредство, "ОС");
		УдалитьОСИзТаблицы(ДокОбъект.ПереоценкаНФА		, ОсновноеСредство, "НФА");
		УдалитьОСИзТаблицы(ДокОбъект.ПереоценкаНФАОтбор	, ОсновноеСредство, "НФА");
		
		ДокОбъект.СуммаДокумента = ДокОбъект.ОС_Основная.Итог("Сумма");
		Если ДокОбъект.РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства
			И Не ДокОбъект.ОтражатьВБухгалтерскомУчете И ДокОбъект.ОтражатьВНалоговомУчете Тогда
			ДокОбъект.СуммаДокумента = ДокОбъект.ОС_Амортизация.Итог("СуммаНУ");
		КонецЕсли;
		
		СкопироватьДвиженияДокумента(Регистры, Движения, ДокОбъект.Движения, ОсновноеСредство, Истина);
		ЗаписатьДокумент(ДокОбъект, ДокОбъект.ОС_Основная.Количество() = 0);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИзменениеДанныхОС") Тогда
		
		УдалитьОСИзТаблицы(ДокОбъект.ИзмененияУчетныхДанных, ОсновноеСредство, "ОсновноеСредство");
		
		СкопироватьДвиженияДокумента(Регистры, Движения, ДокОбъект.Движения, ОсновноеСредство, Истина);
		ЗаписатьДокумент(ДокОбъект, ДокОбъект.ИзмененияУчетныхДанных.Количество() = 0);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИзменениеПараметровАмортизации")
		Или ТипДокумента = Тип("ДокументСсылка.КорректировкаАмортизации") Тогда
		
		УдалитьОСИзТаблицы(ДокОбъект.ОсновныеСредства, ОсновноеСредство, "ОсновноеСредство");
		
		СкопироватьДвиженияДокумента(Регистры, Движения, ДокОбъект.Движения, ОсновноеСредство, Истина);
		ЗаписатьДокумент(ДокОбъект, ДокОбъект.ОсновныеСредства.Количество() = 0);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИзменениеНаличияДрагМатериалов") Тогда
		
		УдалитьОСИзТаблицы(ДокОбъект.СписокНФАДокументаОснования, ОсновноеСредство, "ОбъектНФА");
		УдалитьОСИзТаблицы(ДокОбъект.ДрагоценныеМатериалы, ОсновноеСредство, "ОбъектНФА");
		
		СкопироватьДвиженияДокумента(Регистры, Движения, ДокОбъект.Движения, ОсновноеСредство, Истина);
		ЗаписатьДокумент(ДокОбъект, ДокОбъект.СписокНФАДокументаОснования.Количество() = 0
			И ДокОбъект.ДрагоценныеМатериалы.Количество() = 0);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КорректировкаРегистров")
		Или ТипДокумента = Тип("ДокументСсылка.ОперацияБух") Тогда
		
		СкопироватьДвиженияДокумента(Регистры, Движения, ДокОбъект.Движения, ОсновноеСредство, Истина);
		ДокОбъект.Движения.ЖурналПроводокЕПСБУ.ДополнительныеСвойства.Вставить("НеФормироватьУчетныеДанныеИзПроводок");
		ЗаписатьДокумент(ДокОбъект);
		
	Иначе
		
		ТекстСообщения = НСтр("ru = 'не поддерживатеся перенос данных из документов типа ""'") + Метаданные.НайтиПоТипу(ТипДокумента).Синоним + """";
		ВызватьИсключение ТекстСообщения;
		
	КонецЕсли;
	
КонецФункции

Процедура ЗаписатьДокумент(ДокументОбъект, ПометитьтНаУдаление = Ложь)
	
	Если ПометитьтНаУдаление Тогда
		ДокументОбъект.ПометкаУдаления = Истина;
		ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Иначе
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьОСИзТаблицы(Таблица, ОсновноеСредство, ИмяРеквизита = "ОС")
	
	СтрокиОС = Таблица.НайтиСтроки(Новый Структура(ИмяРеквизита, ОсновноеСредство));
	Для Каждого СтрокаОС Из СтрокиОС Цикл
		Таблица.Удалить(СтрокаОС);
	КонецЦикла;
	
КонецПроцедуры

Процедура СкопироватьДвиженияДокумента(Регистры, ДвиженияПриемник, ДвиженияИсточник, ОсновноеСредство, УдалятьДвижения = Ложь) Экспорт
	
	Для Каждого СтрокаРегистра Из Регистры Цикл
		
		НаборЗаписей = ДвиженияИсточник.Найти(СтрокаРегистра.ИмяРегистра);
		
		Если НаборЗаписей = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей.Прочитать();
		
		УдаляемыеЗаписи = Новый Массив;
		
		Если СтрокаРегистра.ИмяРегистра = "ЖурналПроводокЕПСБУ" Тогда
			
			Для Каждого Запись Из НаборЗаписей Цикл
				Если Запись.СубконтоДт.ОсновныеСредства = ОсновноеСредство
					Или Запись.СубконтоКт.ОсновныеСредства = ОсновноеСредство Тогда
					
					Если Запись.Активность Тогда
						СтрокаПриемника = ДвиженияПриемник[СтрокаРегистра.ИмяРегистра].Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаПриемника, Запись);
						ЗаполнитьЗначенияСвойств(СтрокаПриемника.СубконтоДт, Запись.СубконтоДт);
						ЗаполнитьЗначенияСвойств(СтрокаПриемника.СубконтоКт, Запись.СубконтоКт);
					КонецЕсли;
					
					УдаляемыеЗаписи.Добавить(Запись);
					
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			
			Для Каждого Запись Из НаборЗаписей Цикл
				Если Запись[СтрокаРегистра.ИмяРеквизита] = ОсновноеСредство Тогда
					
					Если Запись.Активность Тогда
						СтрокаПриемника = ПолучитьСтрокуНабора(ДвиженияПриемник, СтрокаРегистра, Запись);
						ЗаполнитьЗначенияСвойств(СтрокаПриемника, Запись);
					КонецЕсли;
						
					УдаляемыеЗаписи.Добавить(Запись);
					
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Если УдалятьДвижения Тогда
			Для Каждого Запись Из УдаляемыеЗаписи Цикл
				НаборЗаписей.Удалить(Запись);
			КонецЦикла;
			НаборЗаписей.ОбменДанными.Загрузка = Истина;
			НаборЗаписей.Записывать = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Запись Из ДвиженияПриемник.СтоимостьОбъектовОС Цикл
		Если Не ЗначениеЗаполнено(Запись.ВидРаспоряжения) Тогда
			Запись.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаБалансе;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСтрокуНабора(Движения, СтрокаРегистра, Запись)
	
	НаборЗаписей = Движения[СтрокаРегистра.ИмяРегистра];
	
	Если СтрокаРегистра.Отбор.Количество() > 0 Тогда
		
		ЗаполнитьЗначенияСвойств(СтрокаРегистра.Отбор, Запись);
		Для Каждого СтрокаНабора Из НаборЗаписей Цикл
			СтрокаНайдена = Истина;
			Для Каждого КлючОтбора Из СтрокаРегистра.Отбор Цикл
				Если СтрокаНабора[КлючОтбора.Ключ] <> КлючОтбора.Значение Тогда
					СтрокаНайдена = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если СтрокаНайдена Тогда
				Возврат СтрокаНабора;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат НаборЗаписей.Добавить();
	
КонецФункции

#КонецОбласти

#Область ДокументАгрегатор2

Функция ПолучитьДеревоДокументовВводаОстатков(Период, СписокОС, Организация)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Граница"		, Новый Граница(Период, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Запрос.УстановитьПараметр("ОС"			, СписокОС);
//	Запрос.УстановитьПараметр("Субконто"	, БухгалтерскийУчет.СписокСубконто("ОсновныеСредства,Контрагенты"));
	Запрос.УстановитьПараметр("Субконто"	, БухгалтерскийУчет.СписокСубконто("ОсновныеСредства,Договоры"));
	Запрос.УстановитьПараметр("Счет"		, БухгалтерскийУчет.СписокСчетов("01,02,22"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Проводки.Организация КАК Организация,
	|	ЕСТЬNULL(Проводки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	Проводки.КФО КАК КФО,
	|	ЕСТЬNULL(Проводки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	Проводки.Счет КАК Счет,
	|	Проводки.Субконто1 КАК ОсновноеСредство,
	|	Проводки.Субконто2 КАК Контрагент
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Граница, Счет В (&Счет), &Субконто, Организация = &Организация) КАК Проводки
	|ГДЕ
	|	Проводки.Субконто1 В(&ОС)
	|ИТОГИ ПО
	|	Организация,
	|	ИФО,
	|	КФО,
	|	КПС,
	|	Счет,
	|	Контрагент";
	
	Данные = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Результат = Данные.Скопировать();
	Результат.Строки.Очистить();
	Результат.Колонки.Добавить("Результат"	, Новый ОписаниеТипов("Структура"));
	Результат.Колонки.Добавить("Документ"	, Новый ОписаниеТипов("ДокументСсылка.ВводНачальныхОстатков"));
	Результат.Колонки.Добавить("Пропустить"	, Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрокаОрганизация Из Данные.Строки Цикл
		Для Каждого СтрокаИФО Из СтрокаОрганизация.Строки Цикл
			Для Каждого СтрокаКФО Из СтрокаИФО.Строки Цикл
				Для Каждого СтрокаКПС Из СтрокаКФО.Строки Цикл
					Для Каждого СтрокаСчет Из СтрокаКПС.Строки Цикл
						Для Каждого СтрокаКонтрагент Из СтрокаСчет.Строки Цикл
							НоваяСтрока = Результат.Строки.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКонтрагент);
							Для Каждого СтрокаЗапись Из СтрокаКонтрагент.Строки Цикл
								НоваяСтрокаОС = НоваяСтрока.Строки.Добавить();
								НоваяСтрокаОС.ОсновноеСредство = СтрокаЗапись.ОсновноеСредство;
								НоваяСтрокаОС.Результат = Новый Структура("СостояниеОС,СостояниеДокументов", 0, Новый Массив);
							КонецЦикла;
						КонецЦикла;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура СоздатьДокументВводОстатков(СтрокаНовогоДокумента, СписокОС, Период, Регистры)
	
	НовыйДокумент = Документы.ВводНачальныхОстатков.СоздатьДокумент();
	
	Отказ = Ложь;
	
	НачатьТранзакцию();
	
	Для Каждого СтрокаОС Из СтрокаНовогоДокумента.Строки Цикл
		
		Если СтрокаОС.Пропустить Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеОС = СписокОС.Найти(СтрокаОС.ОсновноеСредство, "ОсновноеСредство");
		Если ДанныеОС = Неопределено Тогда
			СтрокаОС.Результат.СостояниеОС = 2;
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаДокумента Из ДанныеОС.СписокДокументов Цикл
			
			Попытка
				
				УдалитьОсновноеСредствоИзДокумента(СтрокаДокумента.Документ, СтрокаОС.ОсновноеСредство, НовыйДокумент.Движения, Регистры);
				СтрокаОС.Результат.СостояниеДокументов.Добавить(1); //Зеленый шар
				
			Исключение
				
				СтрокаОС.Результат.СостояниеДокументов.Добавить(6);
				СтрокаОС.Пропустить = Истина;
				Отказ = Истина;
				
				ОбщегоНазначения.СообщитьПользователю(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				Прервать;
				
			КонецПопытки;
			
		КонецЦикла;
		
		Если Отказ Тогда
			СтрокаОС.Результат.СостояниеОС = 6;
			Прервать;
		Иначе
			СтрокаОС.Результат.СостояниеОС = 1;
		КонецЕсли;
		
	КонецЦикла;
	
	// Рекурсия. Пробуем создать общий документ "Ввод остатков" без проблемного ОС (у него признак Пропустить = Истина)
	Если Отказ Тогда
		ОтменитьТранзакцию();
		СоздатьДокументВводОстатков(СтрокаНовогоДокумента, СписокОС, Период, Регистры);
		Возврат;
	КонецЕсли;
	
	ЕстьДвижения = Ложь;
	Для Каждого ТаблицаДвижений Из НовыйДокумент.Движения Цикл
		ТаблицаДвижений.ОбменДанными.Загрузка = Истина;
		ТаблицаДвижений.Записывать = Истина;
		ЕстьДвижения = ЕстьДвижения Или (ТаблицаДвижений.Количество() > 0);
	КонецЦикла;
	
	Если ЕстьДвижения Тогда
		
		Попытка
			
			НовыйДокумент.ДополнительныеСвойства.Вставить("РазделУчета",
				Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе);
			
			НовыйДокумент.Заполнить("ИзДвиженийДокумента");
			ЗаполнитьЗначенияСвойств(НовыйДокумент, СтрокаНовогоДокумента);
			НовыйДокумент.Дата = Период;
			НовыйДокумент.УстановитьНовыйНомер();
			НовыйДокумент.Проведен = Истина;
			НовыйДокумент.ОбменДанными.Загрузка = Истина;
			НовыйДокумент.Записать();
			
			ТиповаяОперация = Справочники.ТиповыеОперации.ВводНачальныхОстатков_ОСВОперУчете;
			ЕстьПроводки = (НовыйДокумент.Движения.ЖурналПроводокЕПСБУ.Количество() > 0);
			БухгалтерскиеОперацииСервер.ЗаписатьДанныеТиповойОперацииОбъекта(НовыйДокумент, ТиповаяОперация,,,, ЕстьПроводки);
			
			ДокументРезультат = НовыйДокумент.Ссылка;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ДокументРезультат = Документы.ВводНачальныхОстатков.ПустаяСсылка();
			
		КонецПопытки;
		
		СтрокаНовогоДокумента.Документ = ДокументРезультат;
		
	Иначе
		
		ОтменитьТранзакцию();
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТиповуюОперациюОбменДанными()
	
	ОписаниеОбъектаМетаданных	= Метаданные.Документы.ВводНачальныхОстатков.ПолноеИмя();
	ИдентификаторДокумента		= ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ОписаниеОбъектаМетаданных);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторДокумента"	, ИдентификаторДокумента);
	Запрос.УстановитьПараметр("Наименование"			, "Обмен данными");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТиповыеОперации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ТиповыеОперации КАК ТиповыеОперации
	|ГДЕ
	|	ТиповыеОперации.ИдентификаторДокумента = &ИдентификаторДокумента
	|	И ТиповыеОперации.Наименование = &Наименование";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Операция = Справочники.ТиповыеОперации.СоздатьЭлемент();
	Операция.ИдентификаторДокумента = ИдентификаторДокумента;
	Операция.Наименование = Запрос.Параметры.Наименование;
	Операция.ОбменДанными.Загрузка = Истина;
	Операция.Записать();
	
	ЗаписьОперации = РегистрыСведений.ДанныеТиповыхОпераций.СоздатьМенеджерЗаписи();
	ЗаписьОперации.ТиповаяОперация = Операция.Ссылка;
	ЗаписьОперации.ФормулаДата = "Документ.Дата";
	ЗаписьОперации.ФормулаОрганизация = "Документ.Организация";
	ЗаписьОперации.ИспользуетсяВнешняяПроцедура = Истина;
	ЗаписьОперации.ИмяВнешнейПроцедуры = "ПереносДанных";
	ЗаписьОперации.Записать(Истина);
	
	ДанныеТиповойОперации = РегистрыСведений.ДанныеТиповыхОпераций.СоздатьМенеджерЗаписи();
	ДанныеТиповойОперации.ТиповаяОперация = Операция.Ссылка;
	ДанныеТиповойОперации.Прочитать();
	
	СхемыФормирования = Справочники.ТиповыеОперации.СформироватьСхемыДляТиповойОперации(Операция.Ссылка);
	ДанныеТиповойОперации.СхемаФормированияПроводок = Новый ХранилищеЗначения(
		СхемыФормирования.СхемаФормированияПроводок, Новый СжатиеДанных(9));
	ДанныеТиповойОперации.СхемаПроверкиУсловия = Новый ХранилищеЗначения(
		СхемыФормирования.СхемаПроверкиУсловия, Новый СжатиеДанных(9));
	ДанныеТиповойОперации.Записать(Истина);
	
	Возврат Операция.Ссылка;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПереносУстаревшихДокументов

Функция ЕстьДанныеДляПереноса(Подробно = Ложь, Организация = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РазделУчета", ВводНачальныхОстатковКлиентСервер.УстаревшиеРазделыУчетаДляВводаОстатков());
	
	Если Подробно Тогда
		
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВводНачальныхОстатков.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВводНачальныхОстатков КАК ВводНачальныхОстатков
		|ГДЕ
		|	ВводНачальныхОстатков.Проведен
		|	И ВводНачальныхОстатков.РазделУчета В(&РазделУчета)
		|	И (ВводНачальныхОстатков.ОтражатьВБухгалтерскомУчете
		|			ИЛИ НЕ ВводНачальныхОстатков.ОтражатьВНалоговомУчете)
		|	И ВводНачальныхОстатков.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВводНачальныхОстатковОС.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВводНачальныхОстатковОС КАК ВводНачальныхОстатковОС
		|ГДЕ
		|	ВводНачальныхОстатковОС.ЭтоПереносИзСтарогоДокумента
		|	И ВводНачальныхОстатковОС.Организация = &Организация";
		
		ДанныеЗапроса = Запрос.ВыполнитьПакет();
		
		Результат = Новый Структура;
		Результат.Вставить("СтарыхДокументов"	, ДанныеЗапроса[0].Выгрузить().Количество());
		Результат.Вставить("НовыхДокументов"	, ДанныеЗапроса[1].Выгрузить().Количество());
		
	Иначе
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВводНачальныхОстатков.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВводНачальныхОстатков КАК ВводНачальныхОстатков
		|ГДЕ
		|	ВводНачальныхОстатков.Проведен
		|	И ВводНачальныхОстатков.РазделУчета В(&РазделУчета)
		|	И (ВводНачальныхОстатков.ОтражатьВБухгалтерскомУчете
		|			ИЛИ НЕ ВводНачальныхОстатков.ОтражатьВНалоговомУчете)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВводНачальныхОстатковОС.Ссылка
		|ИЗ
		|	Документ.ВводНачальныхОстатковОС КАК ВводНачальныхОстатковОС
		|ГДЕ
		|	ВводНачальныхОстатковОС.ЭтоПереносИзСтарогоДокумента";
		
		Результат = Не Запрос.Выполнить().Пустой();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПеренестиУстаревшиеДокументы(Параметры, АдресХранилища) Экспорт
	
	Регистры = Документы.ВводНачальныхОстатковОС.ОпределитьДвигаемыеРегистры();
	
	СтрокиРегистров = Новый Массив;
	МетаданныеДвиженияДокумента = Метаданные.Документы.ВводНачальныхОстатков.Движения;
	Для Каждого Регистр Из Регистры Цикл	
		Если МетаданныеДвиженияДокумента.Содержит(Метаданные.НайтиПоПолномуИмени(Регистр.ПолноеИмяРегистра)) Тогда
			СтрокиРегистров.Добавить(Регистр);
		КонецЕсли;
	КонецЦикла;
	
	Регистры = Регистры.Скопировать(СтрокиРегистров);
	
	РазделыУчета = ВводНачальныхОстатковКлиентСервер.УстаревшиеРазделыУчетаДляВводаОстатков();
	
	СоздатьНовыеДокументы(Регистры, РазделыУчета);
	Для Каждого СтрокаРегистра Из Регистры Цикл
		ПеренестиРегистр(СтрокаРегистра, РазделыУчета);
	КонецЦикла;
	СнятьСтарыеДокументыСПроведения(РазделыУчета);
	ЗаполнитьНовыеДокументы();
	
КонецПроцедуры

Процедура СоздатьНовыеДокументы(Регистры, РазделыУчета)
	
	ЧастиЗапроса = Новый Массив;
	
	ПараметрыРегистра = Новый Структура("ТипРегистра,ИмяРегистра,ИмяРеквизита");
	
	Для Каждого Рег Из Регистры Цикл
		
		ЗаполнитьЗначенияСвойств(ПараметрыРегистра, Рег);
		
		ТекстПодзапроса =
		"ВЫБРАТЬ
		|	Регистр.[ИмяРеквизита] КАК ОсновноеСредство,
		|	ВЫРАЗИТЬ(Регистр.Регистратор КАК Документ.ВводНачальныхОстатков).Дата КАК ДатаДокумента,
		|	0 КАК ЕстьПроводки
		|	%1
		|ИЗ
		|	[ТипРегистра].[ИмяРегистра] КАК Регистр
		|ГДЕ
		|	Регистр.Регистратор ССЫЛКА Документ.ВводНачальныхОстатков
		|	И ВЫРАЗИТЬ(Регистр.Регистратор КАК Документ.ВводНачальныхОстатков).РазделУчета В (&РазделУчета)
		|	И ВЫРАЗИТЬ(Регистр.Регистратор КАК Документ.ВводНачальныхОстатков).ОтражатьВБухгалтерскомУчете";
		
		Если ПараметрыРегистра.ИмяРегистра = "ЖурналПроводокЕПСБУ" Тогда
			ТекстПодзапроса = СтрЗаменить(ТекстПодзапроса, "0", "1");
			ТекстПодзапроса = ТекстПодзапроса + "
			|	И Регистр.Вид = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)";
			ПараметрыРегистра.ИмяРегистра = "ЖурналПроводокЕПСБУ.Субконто";
			ПараметрыРегистра.ИмяРеквизита = "Значение"
		КонецЕсли;
		
		ТекстПодзапроса = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстПодзапроса, ПараметрыРегистра);
		ТекстПодзапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстПодзапроса,
			?(ЧастиЗапроса.Количество() = 0, "ПОМЕСТИТЬ ВТ", ""));
		
		ЧастиЗапроса.Добавить(ТекстПодзапроса);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РазделУчета", РазделыУчета);
	Запрос.Текст =
	СтрСоединить(ЧастиЗапроса, "
	|
	| ОБЪЕДИНИТЬ ВСЕ
	|
	|") + ";
	|
	|" +
	"ВЫБРАТЬ
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ.ОсновноеСредство.Организация КАК Организация,
	|	МАКСИМУМ(ВТ.ДатаДокумента) КАК ДатаДокумента,
	|	СУММА(ВТ.ЕстьПроводки) КАК ЕстьПроводки
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводНачальныхОстатковОС КАК ВводНачальныхОстатковОС
	|		ПО ВТ.ОсновноеСредство = ВводНачальныхОстатковОС.ОсновноеСредство
	|			И (ВводНачальныхОстатковОС.ЭтоПереносИзСтарогоДокумента)
	|ГДЕ
	|	ВводНачальныхОстатковОС.Ссылка ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.ОсновноеСредство,
	|	ВТ.ОсновноеСредство.Организация";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТиповаяОперация = Справочники.ТиповыеОперации.ВводНачальныхОстатковОС_ВводНачальныхОстатковОС;
	
	Пока Выборка.Следующий() Цикл
		
		НовыйДокумент = Документы.ВводНачальныхОстатковОС.СоздатьДокумент();
		
		НовыйДокумент.ОсновноеСредство = Выборка.ОсновноеСредство;
		НовыйДокумент.Организация = Выборка.Организация;
		НовыйДокумент.Дата = Выборка.ДатаДокумента;
		НовыйДокумент.УстановитьНовыйНомер();
		НовыйДокумент.ЭтоАгрегаторДвижений = Истина;
		НовыйДокумент.ЭтоПереносИзСтарогоДокумента = Истина;
		НовыйДокумент.Проведен = Истина;
		НовыйДокумент.ОбменДанными.Загрузка = Истина;
		НовыйДокумент.Записать();
		
		БухгалтерскиеОперацииСервер.ЗаписатьДанныеТиповойОперацииОбъекта(НовыйДокумент, ТиповаяОперация,,,, Выборка.ЕстьПроводки > 0);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПеренестиРегистр(СтрокаРегистра, РазделыУчета)
	
	ПараметрыРегистра = Новый Структура("ТипРегистра,ИмяРегистра,ИмяРеквизита");
	ЗаполнитьЗначенияСвойств(ПараметрыРегистра, СтрокаРегистра);
	
	ТекстПодзапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(Регистр.Регистратор КАК Документ.ВводНачальныхОстатков) КАК Регистратор,
	|	Регистр.[ИмяРеквизита] КАК ОсновноеСредство,
	|	ВводНачальныхОстатковОС.Ссылка КАК ДокументПереноса
	|ИЗ
	|	[ТипРегистра].[ИмяРегистра] КАК Регистр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводНачальныхОстатковОС КАК ВводНачальныхОстатковОС
	|		ПО Регистр.[ИмяРеквизита] = ВводНачальныхОстатковОС.ОсновноеСредство
	|			И (ВводНачальныхОстатковОС.ЭтоПереносИзСтарогоДокумента)
	|ГДЕ
	|	Регистр.Регистратор ССЫЛКА Документ.ВводНачальныхОстатков
	|	И ВЫРАЗИТЬ(Регистр.Регистратор КАК Документ.ВводНачальныхОстатков).РазделУчета В (&РазделУчета)
	|	И ВЫРАЗИТЬ(Регистр.Регистратор КАК Документ.ВводНачальныхОстатков).ОтражатьВБухгалтерскомУчете";
	
	Если ПараметрыРегистра.ИмяРегистра = "ЖурналПроводокЕПСБУ" Тогда
		ТекстПодзапроса = ТекстПодзапроса + "
		|	И Регистр.Вид = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)";
		ПараметрыРегистра.ИмяРегистра = "ЖурналПроводокЕПСБУ.Субконто";
		ПараметрыРегистра.ИмяРеквизита = "Значение";
	КонецЕсли;
	
	ТекстПодзапроса = ТекстПодзапроса + "
	|ИТОГИ ПО
	|	Регистратор";
	
	ТекстПодзапроса = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстПодзапроса, ПараметрыРегистра);
	
	Запрос = Новый Запрос(ТекстПодзапроса);
	Запрос.УстановитьПараметр("РазделУчета", РазделыУчета);
	
	ВыборкаДок = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	сТипыРегистров = Новый Соответствие;
	сТипыРегистров.Вставить("РегистрБухгалтерии", РегистрыБухгалтерии);
	сТипыРегистров.Вставить("РегистрСведений"	, РегистрыСведений);
	сТипыРегистров.Вставить("РегистрНакопления"	, РегистрыНакопления);
	
	Пока ВыборкаДок.Следующий() Цикл
		
		НаборыОС = Новый Соответствие;
		
		Выборка = ВыборкаДок.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НаборЗаписей = сТипыРегистров[СтрокаРегистра.ТипРегистра][СтрокаРегистра.ИмяРегистра].СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(Выборка.ДокументПереноса);
			НаборЗаписей.Прочитать();
			
			НаборыОС.Вставить(Выборка.ОсновноеСредство, НаборЗаписей); 
			
		КонецЦикла;
		
		НаборИсточник = сТипыРегистров[СтрокаРегистра.ТипРегистра][СтрокаРегистра.ИмяРегистра].СоздатьНаборЗаписей();
		НаборИсточник.Отбор.Регистратор.Установить(ВыборкаДок.Регистратор);
		НаборИсточник.Прочитать();
		
		РаспределитьДвиженияРегистра(СтрокаРегистра, НаборИсточник, НаборыОС);
		
		НаборыОС.Вставить("НаборИсточник", НаборИсточник);
		
		// Записываем наборы
		
		НачатьТранзакцию();
		
		Попытка
			
			Для Каждого СтрокаНабора Из НаборыОС Цикл
				Набор = СтрокаНабора.Значение;
				Набор.ОбменДанными.Загрузка = Истина;
				Набор.Записывать = Истина;
				Набор.Записать();
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось перенести регистр ""%1"" для документа ""%2"" по причине: %3'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
				СтрокаРегистра.ИмяРегистра, ВыборкаДок.Регистратор, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.ВводНачальныхОстатков, ВыборкаДок.Регистратор, ТекстСообщения);
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РаспределитьДвиженияРегистра(СтрокаРегистра, НаборИсточник, НаборыОС)
	
	УдаляемыеЗаписи = Новый Массив;
	
	Если СтрокаРегистра.ИмяРегистра = "ЖурналПроводокЕПСБУ" Тогда
		
		Для Каждого Запись Из НаборИсточник Цикл
			
			НаборПриемник = НаборыОС[Запись.СубконтоДт.ОсновныеСредства];
			Если НаборПриемник = Неопределено Тогда
				НаборПриемник = НаборыОС[Запись.СубконтоКт.ОсновныеСредства];
				Если НаборПриемник = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если Запись.Активность Тогда
				СтрокаПриемника = НаборПриемник.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПриемника, Запись);
				ЗаполнитьЗначенияСвойств(СтрокаПриемника.СубконтоДт, Запись.СубконтоДт);
				ЗаполнитьЗначенияСвойств(СтрокаПриемника.СубконтоКт, Запись.СубконтоКт);
			КонецЕсли;
			
			УдаляемыеЗаписи.Добавить(Запись);
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Запись Из НаборИсточник Цикл
			
			НаборПриемник = НаборыОС[Запись[СтрокаРегистра.ИмяРеквизита]];
			Если НаборПриемник = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если Запись.Активность Тогда
				Контейнер = Новый Структура(СтрокаРегистра.ИмяРегистра, НаборПриемник); 
				СтрокаПриемника = ПолучитьСтрокуНабора(Контейнер, СтрокаРегистра, Запись);
				ЗаполнитьЗначенияСвойств(СтрокаПриемника, Запись);
			КонецЕсли;
			
			УдаляемыеЗаписи.Добавить(Запись);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого Запись Из УдаляемыеЗаписи Цикл
		НаборИсточник.Удалить(Запись);
	КонецЦикла;
	
КонецПроцедуры

Процедура СнятьСтарыеДокументыСПроведения(РазделыУчета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РазделУчета", РазделыУчета);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВводНачальныхОстатков.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВводНачальныхОстатков КАК ВводНачальныхОстатков
	|ГДЕ
	|	ВводНачальныхОстатков.РазделУчета В(&РазделУчета)
	|	И ВводНачальныхОстатков.Проведен
	|	И ВводНачальныхОстатков.ОтражатьВБухгалтерскомУчете";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		ЕстьДвижения = Ложь;
		Для Каждого ТаблицаДвижений Из ДокОбъект.Движения Цикл
			ТаблицаДвижений.Прочитать();
			Если ТаблицаДвижений.Количество() > 0 Тогда
				ЕстьДвижения = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЕстьДвижения Тогда
			ДокОбъект.Проведен = Ложь;
			ДокОбъект.ОбменДанными.Загрузка = Истина;
			ДокОбъект.Записать();
			СброситьПризнакНаличияПроводок(Выборка.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьНовыеДокументы()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВводНачальныхОстатковОС.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС КАК ВводНачальныхОстатковОС
	|ГДЕ
	|	ВводНачальныхОстатковОС.ЭтоПереносИзСтарогоДокумента";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Для Каждого Таблица Из ДокОбъект.Движения Цикл
			Таблица.Прочитать();
		КонецЦикла;
		
		ОсДок = ДокОбъект.ОсновноеСредство;
		
		ДокОбъект.Заполнить("ИзДвиженийДокумента");
		
		Если Не ЗначениеЗаполнено(ДокОбъект.ОсновноеСредство) Тогда
			ДокОбъект.ОсновноеСредство = ОсДок;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДокОбъект.Организация) И ЗначениеЗаполнено(ДокОбъект.ОсновноеСредство) Тогда
			ДокОбъект.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокОбъект.ОсновноеСредство, "Организация");
		КонецЕсли;
		
		ДокОбъект.ЭтоПереносИзСтарогоДокумента = Ложь;
		
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		ДокОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СброситьПризнакНаличияПроводок(СсылкаДокумента)
	
	НаборЗаписей = РегистрыСведений.ОперацииДокументов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(СсылкаДокумента);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Запись.ЕстьПроводки = Ложь;
	КонецЦикла;
	
	НаборЗаписей.ОбменДанными.Загрузка = Истина;
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
