КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВводНачальныхОстатковОС.ОсновноеСредство КАК ОсновноеСредство
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС КАК ВводНачальныхОстатковОС
	|ГДЕ
	|	ВводНачальныхОстатковОС.Ссылка В(&Ссылка)";
	
	МассивОС = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
	ТипыМакета = Новый Массив;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИнвентарнаяКарточка52н") Тогда
		ТипыМакета.Добавить("52н");
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИнвентарнаяКарточка194н") Тогда
		ТипыМакета.Добавить("194н");
	КонецЕсли;
	
	Для Каждого ТипМакета Из ТипыМакета Цикл
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ИнвентарнаяКарточка"+ТипМакета, "Инвентарная карточка учета НФА",
			Справочники.ОсновныеСредства.ПечатьИнвентарнойКарточки(МассивОС, ОбъектыПечати, ТипМакета));
		
	КонецЦикла;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИнвентарнаяКарточка61н") Тогда
		
		ИменаФайловПечати = Новый Соответствие;
		ТабДок = Справочники.ОсновныеСредства.ПечатьИнвентарнойКарточки61н(МассивОС, ПараметрыПечати, ОбъектыПечати, ИменаФайловПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ИнвентарнаяКарточка61н", "Инвентарная карточка учета НФА", ТабДок,,, ИменаФайловПечати);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДокумента

Процедура ЗаполнитьПоДаннымБухУчета(ДокументОбъект) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДокументОбъект.ОсновноеСредство) Тогда
		Возврат;
	КонецЕсли;
	
	ДатаОстатков = Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая);
	ДатаУчетнойПолитики = КонецГода(ДокументОбъект.Дата) + 1;
	
	Отбор = Новый Структура("Организация, ОсновноеСредство", ДокументОбъект.Организация, ДокументОбъект.ОсновноеСредство);
	УчетныеДанныеОбъекта = РегистрыСведений.УчетныеДанныеОбъектаОС.ПолучитьПоследнее(ДатаОстатков, Отбор);
	НомераИнвентарныхКарточек = РегистрыСведений.НомераИнвентарныхКарточек.ПолучитьПоследнее(ДатаОстатков, Отбор);
	
	ОтражатьВНалоговомУчетеОСН = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(
		ДокументОбъект.Организация, ДатаУчетнойПолитики, УчетныеДанныеОбъекта.КФО);
	ОтражатьВУСНДоходыМинусРасходы = УчетУСНКлиентСервер.ОтражатьВУСНДоходыМинусРасходы(
		ДокументОбъект.Организация, ДатаУчетнойПолитики, УчетныеДанныеОбъекта.КФО);
	Если Не ОтражатьВНалоговомУчетеОСН И Не ОтражатьВУСНДоходыМинусРасходы Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект.ИнвентарныеОбъекты.Очистить();
	ДокументОбъект.РасходыУСН.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаОстатков"		, ДатаОстатков);
	Запрос.УстановитьПараметр("Организация"			, ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, ДокументОбъект.ОсновноеСредство);
	Запрос.УстановитьПараметр("ИФО"					, УчетныеДанныеОбъекта.ИФО);
	Запрос.УстановитьПараметр("КФО"					, УчетныеДанныеОбъекта.КФО);
	Запрос.УстановитьПараметр("КПС"					, УчетныеДанныеОбъекта.КПС);
	Запрос.УстановитьПараметр("СчетУчета"			, УчетныеДанныеОбъекта.СчетУчета);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОС
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаОстатков,
	|			Счет В (&СчетУчета),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И КФО = &КФО
	|				И КПС = &КПС
	|				И Субконто1 = &ОсновноеСредство) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
