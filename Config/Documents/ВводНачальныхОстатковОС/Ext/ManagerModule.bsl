	#Область НалоговыйУчет
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(
		ЗначенияРеквизитов.Организация, КонецГода(ЗначенияРеквизитов.Дата)+1, ЗначенияРеквизитов.КФО);
	
