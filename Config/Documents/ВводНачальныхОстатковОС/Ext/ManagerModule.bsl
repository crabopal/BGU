	ТаблицыЗапроса.Добавить("ПрослеживаемыеОС");
	Запрос.Текст = Запрос.Текст + ТекстРазделителяЗапросовПакета +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ВводНачальныхОстатковОСИнвентарныеОбъекты.Количество) КАК Количество,
	|	СУММА(ВводНачальныхОстатковОСИнвентарныеОбъекты.Стоимость) КАК Стоимость
