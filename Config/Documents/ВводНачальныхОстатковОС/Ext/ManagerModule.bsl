#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Реквизиты = Новый Структура(
	"ГрупповойУчет,ОсновноеСредство,Организация,Дата,КФО,СчетУчета,ОтражатьВНалоговомУчете,ДатаПринятияКУчету,Договор", 
	"ОсновноеСредство.ГрупповойУчет");
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, Реквизиты);
	
	ПараметрыУчета = ПараметрыУчетаОбъектаОС(ЗначенияРеквизитов.ОсновноеСредство, ЗначенияРеквизитов.Дата); 
	ВедетсяАналитическийУчет		= ПараметрыУчета.ВедетсяАналитическийУчет;
	ВедетсяНачислениеАмортизации	= ПараметрыУчета.ВедетсяНачислениеАмортизации;
	
	ВедетсяУчетПоЦМО = БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(ЗначенияРеквизитов.СчетУчета, ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	ВедетсяУчетПоДоговорам = БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(ЗначенияРеквизитов.СчетУчета, ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	УчетНаСчете21ВУсловнойОценке = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
		ЗначенияРеквизитов.Организация, КонецГода(ЗначенияРеквизитов.Дата)+1).УчетНаСчете21ВУсловнойОценке;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"						, ДокументСсылка);
	Запрос.УстановитьПараметр("ВедетсяУчетПоЦМО"			, ВедетсяУчетПоЦМО);
	Запрос.УстановитьПараметр("ВедетсяУчетПоДоговорам"		, ВедетсяУчетПоДоговорам);
	Запрос.УстановитьПараметр("ВедетсяАналитическийУчет"	, ВедетсяАналитическийУчет);
	Запрос.УстановитьПараметр("ВедетсяНачислениеАмортизации", ВедетсяНачислениеАмортизации);
	Запрос.УстановитьПараметр("ГрупповойУчет"				, ЗначенияРеквизитов.ГрупповойУчет);
	Запрос.УстановитьПараметр("Учет21Условно"				, УчетНаСчете21ВУсловнойОценке);
	Запрос.УстановитьПараметр("Организация", ЗначенияРеквизитов.Организация);
	
	ТаблицыЗапроса = Новый Массив;
	ТекстРазделителяЗапросовПакета = ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
	
	///////////////////////////////////////////////////
	// Бухгалтерский учет и история
	
	СтруктураДополнительныеСвойства.Вставить("НеФормироватьУчетныеДанныеИзПроводок");
	
	ТаблицыЗапроса.Добавить("УчетныеДанныеОбъектаОС");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Документ.Дата КАК Период,
	|	Документ.Организация КАК Организация,
	|	Документ.ИФО КАК ИФО,
	|	Документ.ОсновноеСредство КАК ОсновноеСредство,
	|	Документ.СчетУчета КАК СчетУчета,
	|	Документ.КФО КАК КФО,
	|	Документ.КПС КАК КПС,
	|	Документ.СчетУчета.КОСГУДт КАК КЭК,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.ПустаяСсылка) КАК ВидУчета,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ПустаяСсылка) КАК ВидИмущества
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС КАК Документ
	|ГДЕ
	|	Документ.Ссылка = &Ссылка
	|	И Документ.ОтражатьВБухгалтерскомУчете";
	
	ТаблицыЗапроса.Добавить("НомераИнвентарныхКарточек");
	Запрос.Текст = Запрос.Текст + ТекстРазделителяЗапросовПакета +
	"ВЫБРАТЬ
	|	Документ.Дата КАК Период,
	|	Документ.Организация,
	|	Документ.ОсновноеСредство,
	|	Документ.НомерИнвентарнойКарточки,
	|	Документ.ДатаПринятияКУчету КАК ДатаИнвентарнойКарточки
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС КАК Документ
	|ГДЕ
	|	Документ.Ссылка = &Ссылка
	|	И Документ.НомерИнвентарнойКарточки <> """"
	|	И (Документ.ОтражатьВБухгалтерскомУчете
	|			ИЛИ Документ.ОтражатьИсторию)";
	
	ТаблицыЗапроса.Добавить("АмортизацияОС");
	Запрос.УстановитьПараметр("Счета106"	, БухгалтерскийУчет.СписокСчетов("106"));
	Запрос.УстановитьПараметр("Счета111"	, БухгалтерскийУчет.СписокСчетов("111.60"));
	Запрос.УстановитьПараметр("КЭК226"		, БухгалтерскийУчетПовтИсп.КЭКПоКоду("226"));
	Запрос.УстановитьПараметр("КЭК271"		, БухгалтерскийУчетПовтИсп.КЭКПоКоду("271"));
	Запрос.УстановитьПараметр("КЭК340"		, БухгалтерскийУчетПовтИсп.КЭКПоКоду("340"));
	Запрос.Текст = Запрос.Текст + ТекстРазделителяЗапросовПакета +
	"ВЫБРАТЬ
	|	Документ.Дата КАК Период,
	|	Документ.ОсновноеСредство КАК ОсновноеСредство,
	|	Документ.Организация КАК Организация,
	|	Документ.СчетУчетаЗатрат КАК СчетУчетаЗатрат,
	|	Документ.ПодразделениеЗатрат КАК Подразделение,
	|	Документ.КПСЗатрат КАК КПС,
	|	ВЫБОР
	|		КОГДА Документ.СчетУчета В (&Счета111)
	|			ТОГДА &КЭК226
	|		КОГДА Документ.СчетУчетаЗатрат В (&Счета106)
	|			ТОГДА &КЭК340
	|		ИНАЧЕ &КЭК271
	|	КОНЕЦ КАК КЭК,
	|	Документ.СубконтоЗатрат1 КАК Субконто1,
	|	Документ.СубконтоЗатрат2 КАК Субконто2,
	|	Документ.СубконтоЗатрат3 КАК Субконто3,
	|	ВЫБОР
	|		КОГДА Документ.ОтражатьВНалоговомУчете
	|			ТОГДА Документ.СтатьяПрочихРасходов
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|	КОНЕЦ КАК СубконтоНУ
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС КАК Документ
	|ГДЕ
	|	Документ.Ссылка = &Ссылка
	|	И &ВедетсяНачислениеАмортизации
	|	И Документ.СчетУчетаЗатрат <> ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	И Документ.ОтражатьВБухгалтерскомУчете";
	
	ТаблицыЗапроса.Добавить("ПереоценкаНФА");
	Запрос.Текст = Запрос.Текст + ТекстРазделителяЗапросовПакета +
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА НАЧАЛОПЕРИОДА(СтоимостьИАмортизация.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(СтоимостьИАмортизация.Ссылка.Дата, ДЕНЬ)
	|			ТОГДА СтоимостьИАмортизация.Ссылка.Дата
	|		ИНАЧЕ СтоимостьИАмортизация.Период
	|	КОНЕЦ КАК Период,
	|	СтоимостьИАмортизация.Ссылка.Организация КАК Организация,
	|	СтоимостьИАмортизация.Ссылка.ОсновноеСредство КАК НФА,
	|	СтоимостьИАмортизация.Период КАК ПереоценкаПоСостояниюНА,
	|	СтоимостьИАмортизация.ОсновнойКоэффициент КАК ОсновнойКоэффициент,
	|	СтоимостьИАмортизация.ПоправочныйКоэффициент КАК ПоправочныйКоэффициент,
	|	СУММА(СтоимостьИАмортизация.БалансоваяСтоимостьДельта) КАК ДооценкаБалансовойСтоимости,
	|	СУММА(СтоимостьИАмортизация.ДооценкаАмортизации) КАК ДооценкаАмортизации,
	|	СУММА(СтоимостьИАмортизация.БалансоваяСтоимость) КАК БалансоваяСтоимостьПослеПереоценки,
	|	СУММА(СтоимостьИАмортизация.СуммаАмортизации) КАК АмортизацияПослеПереоценки,
	|	СтоимостьИАмортизация.ВидПервичногоДокумента КАК ПриказОПереоценке,
	|	СтоимостьИАмортизация.ГруппаОФ КАК ГруппаОФ,
	|	СтоимостьИАмортизация.ДатаПервичногоДокумента КАК ДатаПроведения
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС.СтоимостьИАмортизация КАК СтоимостьИАмортизация
	|ГДЕ
	|	СтоимостьИАмортизация.Ссылка = &Ссылка
	|	И СтоимостьИАмортизация.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияИсторииСтоимостиОС.Переоценка)
	|	И СтоимостьИАмортизация.Ссылка.ОтражатьИсторию
	|
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьИАмортизация.ДатаПервичногоДокумента,
	|	СтоимостьИАмортизация.ВидПервичногоДокумента,
	|	СтоимостьИАмортизация.ГруппаОФ,
	|	СтоимостьИАмортизация.Ссылка.ОсновноеСредство,
	|	СтоимостьИАмортизация.Ссылка.Организация,
	|	ВЫБОР
	|		КОГДА НАЧАЛОПЕРИОДА(СтоимостьИАмортизация.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(СтоимостьИАмортизация.Ссылка.Дата, ДЕНЬ)
	|			ТОГДА СтоимостьИАмортизация.Ссылка.Дата
	|		ИНАЧЕ СтоимостьИАмортизация.Период
	|	КОНЕЦ,
	|	СтоимостьИАмортизация.ОсновнойКоэффициент,
	|	СтоимостьИАмортизация.ПоправочныйКоэффициент,
	|	СтоимостьИАмортизация.Период";
	
	ТаблицыЗапроса.Добавить("НачислениеАмортизацииОСБухгалтерскийУчет");
	Запрос.Текст = Запрос.Текст + ТекстРазделителяЗапросовПакета +
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Документ.ОтражатьВБухгалтерскомУчете
	|			ТОГДА Документ.Дата
	|		ИНАЧЕ Документ.ДокументОснование.Дата
	|	КОНЕЦ КАК Период,
	|	Документ.Организация КАК Организация,
	|	Документ.ОсновноеСредство КАК ОсновноеСредство,
	|	NULL КАК ВидПервичногоДокумента,
	|	NULL КАК ДатаПервичногоДокумента,
	|	NULL КАК НомерПервичногоДокумента,
	|	0 КАК СрокПриостановки,
	|	Документ.НачислятьАмортизацию КАК НачислятьАмортизацию,
	|	ЛОЖЬ КАК Консервация
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС КАК Документ
	|ГДЕ
	|	Документ.Ссылка = &Ссылка
	|	И &ВедетсяНачислениеАмортизации
	|	И НЕ Документ.НачислятьАмортизацию
	|	И (Документ.ОтражатьВБухгалтерскомУчете
	|			ИЛИ Документ.ОтражатьИсторию)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА НАЧАЛОПЕРИОДА(СтоимостьИАмортизация.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(СтоимостьИАмортизация.Ссылка.Дата, ДЕНЬ)
	|			ТОГДА СтоимостьИАмортизация.Ссылка.Дата
	|		ИНАЧЕ СтоимостьИАмортизация.Период
	|	КОНЕЦ,
	|	СтоимостьИАмортизация.Ссылка.Организация,
	|	СтоимостьИАмортизация.Ссылка.ОсновноеСредство,
	|	СтоимостьИАмортизация.ВидПервичногоДокумента,
	|	СтоимостьИАмортизация.ДатаПервичногоДокумента,
	|	СтоимостьИАмортизация.НомерПервичногоДокумента,
	|	СтоимостьИАмортизация.СрокПриостановки,
	|	ВЫБОР
	|		КОГДА СтоимостьИАмортизация.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияИсторииСтоимостиОС.Консервация)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ,
	|	ИСТИНА
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС.СтоимостьИАмортизация КАК СтоимостьИАмортизация
	|ГДЕ
	|	СтоимостьИАмортизация.Ссылка = &Ссылка
	|	И &ВедетсяНачислениеАмортизации
	|	И СтоимостьИАмортизация.Ссылка.ОтражатьИсторию
	|	И (СтоимостьИАмортизация.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияИсторииСтоимостиОС.Консервация)
	|			ИЛИ СтоимостьИАмортизация.Событие = ЗНАЧЕНИЕ(Перечисление.СобытияИсторииСтоимостиОС.Расконсервация))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	ТаблицыЗапроса.Добавить("ПараметрыАмортизацииОСБухгалтерскийУчет");
	Запрос.Текст = Запрос.Текст + ТекстРазделителяЗапросовПакета +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА НАЧАЛОПЕРИОДА(СтоимостьИАмортизация.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(СтоимостьИАмортизация.Ссылка.Дата, ДЕНЬ)
	|			ТОГДА СтоимостьИАмортизация.Ссылка.Дата
	|		ИНАЧЕ СтоимостьИАмортизация.Период
	|	КОНЕЦ КАК Период,
	|	СтоимостьИАмортизация.Ссылка.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьИАмортизация.Ссылка.Организация КАК Организация,
	|	СтоимостьИАмортизация.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ВЫБОР
	|		КОГДА СтоимостьИАмортизация.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|			ТОГДА СтоимостьИАмортизация.СпособНачисленияАмортизации
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПустаяСсылка)
	|	КОНЕЦ КАК СпособНачисленияАмортизации
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС.СтоимостьИАмортизация КАК СтоимостьИАмортизация
	|ГДЕ
	|	СтоимостьИАмортизация.Ссылка = &Ссылка
	|	И &ВедетсяНачислениеАмортизации
	|	И (СтоимостьИАмортизация.Ссылка.ОтражатьВБухгалтерскомУчете
	|			ИЛИ СтоимостьИАмортизация.Ссылка.ОтражатьИсторию)";
	
	ТаблицыЗапроса.Добавить("ПервоначальныеСведенияОСБухгалтерскийУчет");
	Запрос.Текст = Запрос.Текст + ТекстРазделителяЗапросовПакета +
	"ВЫБРАТЬ
	|	Документ.Дата КАК Период,
	|	Документ.Организация КАК Организация,
	|	Документ.ОсновноеСредство КАК ОсновноеСредство,
	|	Документ.ПервоначальноеКоличество КАК Количество,
	|	Документ.ПервоначальнаяСуммаАмортизации КАК ПервоначальнаяСуммаАмортизации,
	|	Документ.ПервоначальнаяСуммаОбесценения КАК ПервоначальнаяСуммаОбесценения,
	|	ВЫБОР
	|		КОГДА Документ.ПервоначальноеКоличество < 2
