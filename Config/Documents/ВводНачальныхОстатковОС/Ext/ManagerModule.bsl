	УдалитьПовторяющиесяСтроки(ТаблицыДляДвижений.РасчетАмортизацииОС);
	
	/////////////////////////////////////////////////
	// Дозаполняем данные регистра УчетныеДанныеОбъектаОС
	
	СПИ = 0;
	КоличествоСтрокАм = ТаблицыДляДвижений.РасчетАмортизацииОС.Количество();
	Если КоличествоСтрокАм > 0 Тогда
		СПИ = ТаблицыДляДвижений.РасчетАмортизацииОС[КоличествоСтрокАм-1].СрокПолезногоИспользования;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицыДляДвижений.УчетныеДанныеОбъектаОС Цикл
		
		СтрокаТаблицы.ВидУчета		= УправлениеОсновнымиСредствамиКлиентСервер.ВидУчетаПоСчетуУчета(СтрокаТаблицы.СчетУчета);
		СтрокаТаблицы.ВидИмущества	= УправлениеОсновнымиСредствамиКлиентСервер.ВидИмуществаПоСчетуУчета(СтрокаТаблицы.СчетУчета);
		
		Если БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.СчетУчета, "111.60") Тогда
			КодКЭК = ?(СПИ > 0, "352", "353");
			СтрокаТаблицы.КЭК = Справочники.КОСГУ.НайтиПоКоду(КодКЭК);
		КонецЕсли;
		
	КонецЦикла;
	
	/////////////////////////////////////////////////
	// Получаем данные регистра СтоимостьОбъектовОС
	
	ДеревоСтоимость = Результат[НомерТаблицыСтоимости-1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Договор = ?(ВедетсяУчетПоДоговорам, ЗначенияРеквизитов.Договор, Справочники.Договоры.ПустаяСсылка());
	
	Для Каждого ИнвНомерДерева Из ДеревоСтоимость.Строки Цикл
		
		пЦМО			= Неопределено;
		пПодразделение	= Неопределено;
		пСтоимость		= 0;
		
		ПредыдущаяСтрока = Неопределено;
		СтрокаДвижения	 = Неопределено;
		
		Для Каждого СтрокаДерева Из ИнвНомерДерева.Строки Цикл
			
			Если СтрокаДерева.ВидТаблицы = 1 Тогда // Таблица Местонахождение
				
				Если ПредыдущаяСтрока = Неопределено Тогда
					пЦМО			= СтрокаДерева.ЦМО;
					пПодразделение	= СтрокаДерева.Подразделение;
					Продолжить;
				КонецЕсли;
				
				//Сначала делаем движение списания с предыдущего ЦМО
				СтрокаДвижения = ТаблицыДляДвижений.СтоимостьОбъектовОС.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДвижения, СтрокаДерева);
				СтрокаДвижения.ВидДвижения = ВидДвиженияНакопления.Расход;
				СтрокаДвижения.ВидРаспоряжения = ?(СтрокаДерева.НаСчете21, 
					Перечисления.ВидыРаспоряженияОС.ОперативныйУчет, Перечисления.ВидыРаспоряженияОС.НаБалансе);
				СтрокаДвижения.Стоимость = пСтоимость;
				СтрокаДвижения.ЦМО = пЦМО;
				СтрокаДвижения.Подразделение = пПодразделение;
				СтрокаДвижения.Договор = Договор;
				
				//Делаем движение поступления на текущий ЦМО
				СтрокаДвижения = ТаблицыДляДвижений.СтоимостьОбъектовОС.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДвижения, СтрокаДерева);
				СтрокаДвижения.ВидДвижения = ВидДвиженияНакопления.Приход;
				СтрокаДвижения.ВидРаспоряжения = ?(СтрокаДерева.НаСчете21, 
					Перечисления.ВидыРаспоряженияОС.ОперативныйУчет, Перечисления.ВидыРаспоряженияОС.НаБалансе);
				СтрокаДвижения.Стоимость = пСтоимость;
				СтрокаДвижения.Договор = Договор;
				
				// Запоминаем текущий ЦМО как предыдущий
				пЦМО			= СтрокаДерева.ЦМО;
				пПодразделение	= СтрокаДерева.Подразделение;
				
				
			ИначеЕсли СтрокаДерева.ВидТаблицы = 2 Тогда // Таблица Стоимость
				
				СтрокаДвижения = ТаблицыДляДвижений.СтоимостьОбъектовОС.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДвижения, СтрокаДерева);
				СтрокаДвижения.ВидДвижения = ВидДвиженияНакопления.Приход;
				СтрокаДвижения.ВидРаспоряжения = ?(СтрокаДерева.НаСчете21, 
					Перечисления.ВидыРаспоряженияОС.ОперативныйУчет, Перечисления.ВидыРаспоряженияОС.НаБалансе);
				СтрокаДвижения.ЦМО = пЦМО;
				СтрокаДвижения.Подразделение = пПодразделение;
				СтрокаДвижения.Договор = Договор;
				
				пСтоимость = СтрокаДерева.СтоимостьБалансовая;
				
			КонецЕсли;
			
			ПредыдущаяСтрока = СтрокаДерева;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицыДляДвижений.СтоимостьОбъектовОС.Сортировать("ИнвентарныйНомер,Период,ЦМО,ВидРаспоряжения Убыв,ВидДвижения");
	
	ТаблицыДляДвижений.СтоимостьОбъектовОС.Колонки.Добавить("ДатаСобытия", Новый ОписаниеТипов("Дата"));
	Для Каждого СтрокаТаблицы Из ТаблицыДляДвижений.СтоимостьОбъектовОС Цикл
		СтрокаТаблицы.ДатаСобытия = СтрокаТаблицы.Период;
		СтрокаТаблицы.Период = ЗначенияРеквизитов.Дата;
	КонецЦикла;
	
	/////////////////////////////////////////////////
	// Получаем данные регистра АмортизацияОбъектовОС
	
	ДеревоАмортизация = Результат[НомерТаблицыАмортизации-1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для Каждого ИнвНомерДерева Из ДеревоАмортизация.Строки Цикл
		
		НомерСтроки = 1;
		КоличествоСтрок = ИнвНомерДерева.Строки.Количество();
		
		Для Каждого СтрокаДерева Из ИнвНомерДерева.Строки Цикл
			
			СтрокаДвижения = ТаблицыДляДвижений.АмортизацияОбъектовОС.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДвижения, СтрокаДерева);
			
			Если ЗначениеЗаполнено(СтрокаДерева.ПериодАмортизацииНачало) Тогда
				СтрокаДвижения.Период = СтрокаДерева.ПериодАмортизацииНачало;
			Иначе
				Если СтрокаДерева.Линейный Тогда	
					Если СтрокаДерева.ЭтоПринятиеКУчету Тогда
						СтрокаДвижения.Период = ДобавитьМесяц(СтрокаДерева.Период, 1);
					Иначе
						// Если амортизация начисляется 1 числом, то в момент события амортизация уже начислена по 
						// старому. Начисление по новому будет со следующего месяца
						СтрокаДвижения.Период = ?(СтрокаДерева.НачислятьАмортизациюПервымЧислом,
							ДобавитьМесяц(СтрокаДерева.Период, 1), СтрокаДерева.Период);
					КонецЕсли;
				ИначеЕсли ЗначениеЗаполнено(СтрокаДерева.ДатаВводаВЭксплуатацию) И СтрокаДерева.ДатаВводаВЭксплуатацию > СтрокаДерева.Период Тогда
					СтрокаДвижения.Период = СтрокаДерева.ДатаВводаВЭксплуатацию;
				Иначе
					СтрокаДвижения.Период = СтрокаДерева.Период;
				КонецЕсли;
			
				Если СтрокаДерева.Линейный Тогда
					СтрокаДвижения.Период = ?(СтрокаДерева.НачислятьАмортизациюПервымЧислом, 
					НачалоМесяца(СтрокаДвижения.Период), КонецМесяца(СтрокаДвижения.Период));
				КонецЕсли;
			КонецЕсли;
			
			СуммаАмортизации = СтрокаДерева.СуммаАмортизации - ?(НомерСтроки > 1, ИнвНомерДерева.Строки[НомерСтроки-2].СуммаАмортизации, 0);
			СтрокаДвижения.СуммаАмортизации = СуммаАмортизации;
			
			СуммаОбесценения = СтрокаДерева.СуммаОбесценения - ?(НомерСтроки > 1, ИнвНомерДерева.Строки[НомерСтроки-2].СуммаОбесценения, 0);
			СтрокаДвижения.СуммаОбесценения = СуммаОбесценения;
			
			// Строки с нулевыми суммами не пишем в регистр
			Если СуммаАмортизации = 0 И СуммаОбесценения = 0 Тогда
				ТаблицыДляДвижений.АмортизацияОбъектовОС.Удалить(СтрокаДвижения);
				НомерСтроки = НомерСтроки + 1;
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаДерева.ПериодАмортизацииКонец) Тогда
				КонецПериода = СтрокаДерева.ПериодАмортизацииКонец;
			Иначе
				Если СтрокаДерева.Линейный Тогда
					Если НомерСтроки < КоличествоСтрок Тогда
						// Если амортизация начисляется 1 числом, то окончание начисления по текущему событию 
						// будет в месяце следующего события первым числом
						КонецПериода = ?(СтрокаДерева.НачислятьАмортизациюПервымЧислом,
							ДобавитьМесяц(ИнвНомерДерева.Строки[НомерСтроки].Период, -1), 
							ИнвНомерДерева.Строки[НомерСтроки].Период);
					Иначе
						КонецПоПлану = ДобавитьМесяц(ЗначенияРеквизитов.ДатаПринятияКУчету, СтрокаДерева.СрокПолезногоИспользования);
						КонецПоДатеДокумента = ?(КонецМесяца(ЗначенияРеквизитов.Дата) = КонецДня(ЗначенияРеквизитов.Дата),
							ЗначенияРеквизитов.Дата, НачалоМесяца(ЗначенияРеквизитов.Дата)-1);
						КонецПериода = Мин(КонецПоПлану, КонецПоДатеДокумента);
					КонецЕсли;
				Иначе
					НомерСтроки = НомерСтроки + 1;
					Продолжить;
				КонецЕсли;
			
				Если СтрокаДерева.Линейный Тогда
					КонецПериода = ?(СтрокаДерева.НачислятьАмортизациюПервымЧислом,
					НачалоМесяца(КонецПериода), КонецМесяца(КонецПериода));
				КонецЕсли;
			КонецЕсли;

			Если КонецМесяца(КонецПериода) = КонецМесяца(СтрокаДвижения.Период) Тогда
				СтрокаДвижения.Период = КонецПериода;
			ИначеЕсли КонецМесяца(КонецПериода) > КонецМесяца(СтрокаДвижения.Период) Тогда
				
				ПерваяПоловинаАмортизации = Окр(СуммаАмортизации / 2, 2);
				СтрокаДвижения.СуммаАмортизации = ПерваяПоловинаАмортизации;
				
				ПерваяПоловинаОбесценения = Окр(СуммаОбесценения / 2, 2);
				СтрокаДвижения.СуммаОбесценения = ПерваяПоловинаОбесценения;
				
				СтрокаДвижения = ТаблицыДляДвижений.АмортизацияОбъектовОС.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДвижения, СтрокаДерева);
				СтрокаДвижения.Период = КонецПериода;
				СтрокаДвижения.СуммаАмортизации = СуммаАмортизации - ПерваяПоловинаАмортизации;
				СтрокаДвижения.СуммаОбесценения = СуммаОбесценения - ПерваяПоловинаОбесценения;
			КонецЕсли;

			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла;
	КонецЦикла;
	
	ТаблицыДляДвижений.АмортизацияОбъектовОС.Колонки.Добавить("ДатаСобытия", Новый ОписаниеТипов("Дата"));
	Для Каждого СтрокаТаблицы Из ТаблицыДляДвижений.АмортизацияОбъектовОС Цикл
		СтрокаТаблицы.ДатаСобытия = СтрокаТаблицы.Период;
		СтрокаТаблицы.Период = ЗначенияРеквизитов.Дата;
	КонецЦикла;
	
	/////////////////////////////////////////////////
	// Редактируем период капремонта
	
	ВсегоСтрок = ТаблицыДляДвижений.КапРемонтОС.Количество();
	Для Сч = 1 По ВсегоСтрок Цикл
		СтрокаТаблицы = ТаблицыДляДвижений.КапРемонтОС[Сч-1];
		СтрокаТаблицы.Период = СтрокаТаблицы.Период - (ВсегоСтрок - Сч);
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьПовторяющиесяСтроки(Таблица)
	
	Сч = 1;
	
	Пока Сч < Таблица.Количество() Цикл
		ТекущаяСтрока = Таблица[Сч];
		ПредыдущаяСтрока = Таблица[Сч-1];
		
		СтрокаПовторяется = Истина;
		
		Для Каждого Колонка Из Таблица.Колонки Цикл
			
			Если Колонка.Имя = "Период" Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекущаяСтрока[Колонка.Имя] <> ПредыдущаяСтрока[Колонка.Имя] Тогда
				СтрокаПовторяется = Ложь;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрокаПовторяется Тогда
			Таблица.Удалить(ТекущаяСтрока);
		Иначе
			Сч = Сч + 1;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьОстаткиПоОсновномуСредству(ОсновноеСредство, Период, ПараметрыПроверки) Экспорт
	
	ЕстьОстатки = Новый Структура("ЕстьОстаткиБУ, ЕстьОстаткиНУ, ЕстьОстаткиУСН", Ложь, Ложь, Ложь);
	
	Запрос = Новый Запрос;
	НомераТаблиц = Новый Структура;
	
	Если ПараметрыПроверки.БухгалтерскийУчет Тогда
		НомераТаблиц.Вставить("БухгалтерскийУчет", НомераТаблиц.Количество());
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	БухгалтерскийУчет.Регистратор
		|ИЗ
		|	РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(
		|			&Период,
		|			ОсновноеСредство = &ОсновноеСредство
		|				И Регистратор <> &Регистратор) КАК БухгалтерскийУчет";
	КонецЕсли;
	Если ПараметрыПроверки.НалоговыйУчет Тогда
		НомераТаблиц.Вставить("НалоговыйУчет", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ?(НЕ ПустаяСтрока(Запрос.Текст), ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета(), "") +
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	НалоговыйУчет.Регистратор
		|ИЗ
		|	РегистрСведений.ПервоначальныеСведенияОСНалоговыйУчет.СрезПоследних(
		|			&Период,
		|			ОсновноеСредство = &ОсновноеСредство
		|				И Регистратор <> &Регистратор) КАК НалоговыйУчет
		|ГДЕ
		|	НЕ НалоговыйУчет.Регистратор ССЫЛКА Документ.ЗакрытиеСчетовНалоговогоУчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	НалоговыйУчет.Период УБЫВ";
	КонецЕсли;
	Если ПараметрыПроверки.НалоговыйУчетУСН Тогда
		НомераТаблиц.Вставить("НалоговыйУчетУСН", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ?(НЕ ПустаяСтрока(Запрос.Текст), ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета(), "") +
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	НалоговыйУчетУСН.Регистратор
		|ИЗ
		|	РегистрСведений.ПервоначальныеСведенияОСНалоговыйУчетУСН.СрезПоследних(
		|			&Период,
		|			ОсновноеСредство = &ОсновноеСредство
		|				И Регистратор <> &Регистратор) КАК НалоговыйУчетУСН";
	КонецЕсли;
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	
	ТипПериода = ТипЗнч(Период);
	ГраницаСреза = '00010101000000'; // Последнее актуальное значение регистра.
	Регистратор = Неопределено;
	
	Если ЗначениеЗаполнено(Период) Тогда
		Если ТипПериода = Тип("Дата") Тогда
			ГраницаСреза = Новый Граница(Период, ВидГраницы.Включая);
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипПериода) Тогда
			ГраницаСреза = Новый Граница(Период.МоментВремени(), ВидГраницы.Исключая);
			Регистратор = Период;
		ИначеЕсли ТипПериода = Тип("Граница") Тогда
			ГраницаСреза = Период;
		КонецЕсли;
	КонецЕсли;
	Запрос.УстановитьПараметр("Период"		, ГраницаСреза);
	Запрос.УстановитьПараметр("Регистратор"	, Регистратор);
	
	Если ПараметрыПроверки.БухгалтерскийУчет
		ИЛИ ПараметрыПроверки.НалоговыйУчет
		ИЛИ ПараметрыПроверки.НалоговыйУчетУСН Тогда
		Результат = Запрос.ВыполнитьПакет();
	Иначе
		Возврат ЕстьОстатки;
	КонецЕсли;
	
	Если ПараметрыПроверки.БухгалтерскийУчет Тогда
		ЕстьОстатки.ЕстьОстаткиБУ = НЕ Результат[НомераТаблиц.БухгалтерскийУчет].Пустой();
	КонецЕсли;
	Если ПараметрыПроверки.НалоговыйУчет Тогда
		ЕстьОстатки.ЕстьОстаткиНУ = НЕ Результат[НомераТаблиц.НалоговыйУчет].Пустой();
	КонецЕсли;
	Если ПараметрыПроверки.НалоговыйУчетУСН Тогда
		ЕстьОстатки.ЕстьОстаткиУСН = НЕ Результат[НомераТаблиц.НалоговыйУчетУСН].Пустой();
	КонецЕсли;
	
	Возврат ЕстьОстатки;
	
КонецФункции

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВводНачальныхОстатковОС";
	КомандаПечати.Идентификатор		= "ИнвентарнаяКарточка61н";
