
#Область Переменные

&НаКлиенте
Перем	Операция,
		ПараметрыОбработчикаОжидания,
		ИдентификаторЗадания,
		АдресХранилища,
		Объединение_Выполнено,
		Объединение_ТекущаяСтрока;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИндивидуальныйРежим = Параметры.Свойство("ОсновноеСредство");
	
	Элементы.Организация.Видимость		 = Не ИндивидуальныйРежим;
	Элементы.ОсновноеСредство.Видимость	 = ИндивидуальныйРежим;
	Элементы.ВидДокумента.Видимость		 = Не ИндивидуальныйРежим;
	Элементы.ГруппаТаблицаОС.Видимость	 = Не ИндивидуальныйРежим;
	Элементы.ГруппаДокИнд.Видимость		 = ИндивидуальныйРежим;
	Элементы.ГруппаДокСписок.Видимость	 = Не ИндивидуальныйРежим;
	Элементы.СписокДокументов.Видимость	 = Ложь;
	Элементы.ДлительнаяОперация.Видимость= Ложь;
	
	Если ИндивидуальныйРежим Тогда
		
		ПерваяСтрока = ТаблицаОС.Добавить();
		ПерваяСтрока.ОсновноеСредство = Параметры.ОсновноеСредство;
		
		Если ЗначениеЗаполнено(ПерваяСтрока.ОсновноеСредство) Тогда
			Период = ПолучитьПериодАгрегатора(ПерваяСтрока.ОсновноеСредство);
		КонецЕсли;
		
	Иначе
		
		ЕстьОрганизация = Параметры.Свойство("Организация", Организация);
		//Элементы.Организация.ТолькоПросмотр = ЕстьОрганизация;
		Если Не ЕстьОрганизация Тогда
			Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
		КонецЕсли;
		
		Если Параметры.Свойство("ОсновныеСредства") Тогда
			СписокОС = Параметры["ОсновныеСредства"];
		ИначеЕсли Параметры.Свойство("АдресОС") Тогда
			СписокОС = ПолучитьИзВременногоХранилища(Параметры["АдресОС"]);
		Иначе
			СписокОС = Неопределено;
		КонецЕсли;
		
		Если СписокОС <> Неопределено Тогда
			Для Каждого Значение Из СписокОС Цикл
				ТаблицаОС.Добавить().ОсновноеСредство = Значение;
			КонецЦикла;
		КонецЕсли;
		
		Если Параметры.Свойство("Период") Тогда
			Период = Параметры["Период"];
		ИначеЕсли ЗначениеЗаполнено(Организация) Тогда
			Период = ПолучитьПериодАгрегатора(Организация);
		КонецЕсли;
		
		Параметры.Свойство("ВидДокумента", ВидДокумента);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ИндивидуальныйРежим И ЗначениеЗаполнено(Период) Тогда
		ВыполнитьДлительнуюОперацию("ПолучитьДокументы", "Получение документов");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ИдентификаторЗадания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	Если ЗавершениеРаботы Тогда
		
		ТекстПредупреждения = НСтр("ru = 'Выполняется объединение движений документов. Рекомендуется дождаться результата выполнения.'");
		
	Иначе
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗакрытиемПослеОтветаНаВопрос", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'Операция еще выполняется. При закрытии формы операция будет прервана.
									|Закрыть?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемПослеОтветаНаВопрос(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОтменитьВыполнениеЗадания(Истина);
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ТаблицаОС.Очистить();
	СписокДокументов.Очистить();
	ПредставлениеВсехДокументов();
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Период = ПолучитьПериодАгрегатора(Организация);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)
	
	ТаблицаОС.Очистить();
	СписокДокументов.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаОС

&НаКлиенте
Процедура ТаблицаОСПодбор(Команда)
	
	Отбор = Новый Структура("Организация", Организация);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора"		, Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("Отбор"				, Отбор);
	
	ОткрытьФорму("Справочник.ОсновныеСредства.ФормаВыбора", ПараметрыФормы, Элементы.ТаблицаОС);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОСОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Для Каждого ВыбранноеОС Из ВыбранноеЗначение Цикл
		Результат = ТаблицаОС.НайтиСтроки(Новый Структура("ОсновноеСредство", ВыбранноеОС));
		Если Результат.Количество() = 0 Тогда
			НоваяСтрока = ТаблицаОС.Добавить();
			НоваяСтрока.ОсновноеСредство = ВыбранноеОС;
		Иначе
			Сообщить("Основное средство """ + (ВыбранноеОС) + """ уже подобрано");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОСЗаполнить(Команда)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Поле ""Организация"" не заполнено");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Период) Тогда
		Сообщить("Поле ""Период"" не заполнено");
		Возврат;
	КонецЕсли;
	
	ТаблицаОС.Очистить();
	СписокДокументов.Очистить();
	ПредставлениеВсехДокументов();
	
	ВыполнитьДлительнуюОперацию("ПолучитьСписокОС", "Заполнение списка ОС, НМА, НПА");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОСОчистить(Команда)
	
	ТаблицаОС.Очистить();
	СписокДокументов.Очистить();
	ПредставлениеВсехДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОСОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаОС.ТекущиеДанные;
	ТекущиеДанные.СписокДокументов.Очистить();
	ТекущиеДанные.Состояние = 0;
	ТекущиеДанные.Документ = ПредопределенноеЗначение("Документ.ВводНачальныхОстатковОС.ПустаяСсылка");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОСДокументНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОСДокументОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Документы

&НаКлиенте
Процедура ДокументыЗаполнить(Команда)
	
	СписокДокументов.Очистить();
	ПредставлениеВсехДокументов();
	
	Если ТаблицаОС.Количество() = 0 Тогда
		Сообщить("Список основных средств пуст");
	Иначе
		ВыполнитьДлительнуюОперацию("ПолучитьДокументы", "Получение документов");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьДокументыПоОСПриИзменении(Элемент)
	
	Элементы.ТаблицаОССписокДокументов.Видимость = (ОтображатьДокументыПоОС = 0);
	Элементы.СписокДокументов.Видимость = (ОтображатьДокументыПоОС = 1);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерваяСтрокаСписокДокументовДокументНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерваяСтрокаСписокДокументовДокументОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОССписокДокументовДокументНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОССписокДокументовДокументОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовЗначениеОбщНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовЗначениеОбщОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбъединениеВыполнить(Команда)
	
	Если ТаблицаОС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Объединение_Выполнено		= 0;
	Объединение_ТекущаяСтрока	= Неопределено;
	
	ВыполнитьДлительнуюОперацию("СоздатьАгрегатор", "Объединение документов");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъединениеОбновить(Команда)
	
	ИнформацияАгрегатор = Новый Массив;
	ПоказатьСообщенияФоновогоЗадания(, ИнформацияАгрегатор);
	ПоказатьРезультатОбъединенияДокументов(ИнформацияАгрегатор);
	
	Если Объединение_ТекущаяСтрока <> Неопределено Тогда
		Элементы.ТаблицаОС.ТекущаяСтрока = Объединение_ТекущаяСтрока;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительнаяОперацияПрервать(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПрерватьОперациюПослеОтветаНаВопрос", ЭтаФорма);
	ТекстВопроса = НСтр("ru = 'Операция еще выполняется. Прервать?'");
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрерватьОперациюПослеОтветаНаВопрос(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОтменитьВыполнениеЗадания();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоСостояниюУстановить(Команда)
	
	ОтборСтрок = Элементы.ТаблицаОС.ОтборСтрок;
	Если ОтборСтрок <> Неопределено И ОтборСтрок.Свойство("Состояние") Тогда
		ОтборСостояние = ОтборСтрок.Состояние;
	Иначе
		ОтборСостояние = -1;
	КонецЕсли;
	
	Количества = Новый Структура("Количество1,Количество2,Количество3,Количество6,КоличествоВсе",0,0,0,0,0);
	Количества.КоличествоВсе = ТаблицаОС.Количество();
	Для Каждого СтрокаТаблицы Из ТаблицаОС Цикл
		Если СтрокаТаблицы.Состояние <> 0 Тогда
			Поле = "Количество" + СтрокаТаблицы.Состояние;
			Количества[Поле] = Количества[Поле] + 1;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура("Состояние,Количества", ОтборСостояние,Количества);
	Оп = Новый ОписаниеОповещения("ОтборПоСостояниюПослеВыбора", ЭтотОбъект);
	ОткрытьФорму("Документ.ВводНачальныхОстатковОС.Форма.ОтборПоСостоянию",
		ПараметрыФормы, ЭтаФорма,,,, Оп, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоСостояниюПослеВыбора(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	ИначеЕсли Результат >= 0 Тогда
		ОтборСтрок = Новый ФиксированнаяСтруктура("Состояние", Результат);
	Иначе
		ОтборСтрок = Неопределено;
	КонецЕсли;
	
	Элементы.ТаблицаОС.ОтборСтрок = ОтборСтрок;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиДвижения(Команда)
	
	Если ТаблицаОС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписокОС = ПолучитьСписокОС();
	ТабДок = ПолучитьДвиженияСервер(СписокОС, ВидДокумента);
	ПоказатьТабличныйДокумент(ТабДок, СписокОС, "Движения ОС");
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиИнвентарныеКарточки(Команда)
	
	Если ТаблицаОС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписокОС = ПолучитьСписокОС();
	ТабДок = ПолучитьИнвКарточкиСервер(СписокОС);
	ПоказатьТабличныйДокумент(ТабДок, СписокОС, "Инвентарные карточки");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьПериодАгрегатора(Параметр)
	
	Возврат Документы.ВводНачальныхОстатковОС.ДатаВводаОстатков(Параметр);
	
КонецФункции

#Область ДлительныеОперации

&НаКлиенте
Процедура ВыполнитьДлительнуюОперацию(ТекущаяОперация, ПредставлениеОперации)
	
	Операция = ТекущаяОперация;
	СведенияЗадания = ВыполнитьДлительнуюОперациюСервер(Операция, ПредставлениеОперации);
	
	ИдентификаторЗадания = СведенияЗадания.ИдентификаторЗадания;
	АдресХранилища = СведенияЗадания.АдресРезультата;
	
	Если СведенияЗадания.Статус = "Выполнено" Тогда
		ВыполнитьПоЗавершениюДлительнойОперации(, СведенияЗадания.Сообщения);
	Иначе
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		
		Элементы.ДлительнаяОперация_Заголовок.Заголовок = ПредставлениеОперации + " ...";
		УстановитьДоступностьЭлементовПриДлительнойОперации(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьДлительнуюОперациюСервер(Операция, ПредставлениеОперации)
	
	пОрганизация = ?(ЗначениеЗаполнено(Организация), Организация,
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТаблицаОС[0].ОсновноеСредство, "Организация"));
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("Период"		, Период);
	ПараметрыЗадания.Вставить("Организация"	, пОрганизация);
	ПараметрыЗадания.Вставить("Операция"	, Операция);
	ПараметрыЗадания.Вставить("ВидДокумента", ВидДокумента);
	
	Если Операция = "ПолучитьСписокОС" Тогда
		//
	ИначеЕсли Операция = "ПолучитьДокументы" Тогда
	
		ОС = ТаблицаОС.Выгрузить(, "ОсновноеСредство").ВыгрузитьКолонку("ОсновноеСредство");
		ПараметрыЗадания.Вставить("ОсновноеСредство"	, ОС);
		ПараметрыЗадания.Вставить("ПолучитьОбщийСписок"	, Не ИндивидуальныйРежим);
		
	ИначеЕсли Операция = "СоздатьАгрегатор" Тогда
		
		СписокОС = РеквизитФормыВЗначение("ТаблицаОС");
		СписокОС = СписокОС.Скопировать(Новый Структура("Состояние", 0), "ОсновноеСредство,СписокДокументов");
		ПараметрыЗадания.Вставить("СписокОС", СписокОС);
		
		Объединение_Всего = СписокОС.Количество();
		Элементы.ДлительнаяОперация_Состояние.Заголовок = "0 из " + Строка(Объединение_Всего) + " (0%)";
		
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Помощник объединения документов по ОС, НМА, НПА (" + ПредставлениеОперации + ")";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	СведенияЗадания = ДлительныеОперации.ВыполнитьВФоне("Документы.ВводНачальныхОстатковОС.ВыполнитьОперацию",
		ПараметрыЗадания, ПараметрыВыполнения); 
	
	Возврат СведенияЗадания;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка
		
		Если ПроверитьВыполнениеФоновогоЗаданияНаСервере(ИдентификаторЗадания) Тогда
			ВыполнитьПоЗавершениюДлительнойОперации();
			Возврат;
		ИначеЕсли Операция = "СоздатьАгрегатор" Тогда
			ИнформацияАгрегатор = Новый Массив;
			ПоказатьСообщенияФоновогоЗадания(, ИнформацияАгрегатор);
			ПоказатьРезультатОбъединенияДокументов(ИнформацияАгрегатор);
		КонецЕсли;
		
	Исключение
		
		ИдентификаторЗадания = Неопределено;
		УстановитьДоступностьЭлементовПриДлительнойОперации(Ложь);
		ВызватьИсключение ОписаниеОшибки();
		
	КонецПопытки;
	
	ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
	ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", ПараметрыОбработчикаОжидания.ТекущийИнтервал, Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьВыполнениеФоновогоЗаданияНаСервере(ФоновоеЗаданиеИдентификатор)
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ФоновоеЗаданиеИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПоЗавершениюДлительнойОперации(Прервано = Ложь, Сообщения = Неопределено)
	
	ИнформацияАгрегатор = Новый Массив;
	ПоказатьСообщенияФоновогоЗадания(Сообщения, ИнформацияАгрегатор);
	
	Если Операция = "ПолучитьСписокОС" Тогда
		
		Результат = ПолучитьИзВременногоХранилища(АдресХранилища);
		Если Результат <> Неопределено Тогда
			Для Каждого СтрокаОС Из Результат Цикл
				НоваяСтрока = ТаблицаОС.Добавить();
				НоваяСтрока.ОсновноеСредство = СтрокаОС;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли Операция = "ПолучитьДокументы" Тогда
		
		ПолучитьДокументыСервер(АдресХранилища);
		ПредставлениеВсехДокументов(СписокДокументов.Количество());
		
	ИначеЕсли Операция = "СоздатьАгрегатор" Тогда
		
		ПоказатьРезультатОбъединенияДокументов(ИнформацияАгрегатор);
		
		Объединение_ТекущаяСтрока = Неопределено;
		
		Если Прервано Тогда
			Элементы.ДлительнаяОперация_Состояние.Заголовок = "расчет итогов, подождите...";
			ВключитьИспользованиеИтогов(ВидДокумента);
		Иначе
			Если ИндивидуальныйРежим Тогда
				Если ЗначениеЗаполнено(ТаблицаОС[0].Документ) Тогда
					ИдентификаторЗадания = Неопределено;
					ОповеститьОВыборе(ТаблицаОС[0].Документ);
				КонецЕсли;
			Иначе
				ПоказатьПредупреждение(, НСтр("ru = 'Объединение завершено!'"));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьДоступностьЭлементовПриДлительнойОперации(Ложь);
	
	ИдентификаторЗадания = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеВсехДокументов(Количество = Неопределено) 
	
	Если Количество = Неопределено Тогда
		Представление = НСтр("ru = 'всех ОС'");
	Иначе
		Представление = НСтр("ru = 'всех ОС (%1)'");
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Представление,
			Формат(СписокДокументов.Количество(), "ЧН=0"));
	КонецЕсли;
	Элементы.ОтображатьДокументыПоОС.СписокВыбора[1].Представление = Представление;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВыполнениеЗадания(Закрытие = Ложь)
	
	ОтключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания");
	ОтменитьВыполнениеЗаданияСервер(ИдентификаторЗадания);
	Если Закрытие Тогда
		ИдентификаторЗадания = Неопределено;
	Иначе
		ВыполнитьПоЗавершениюДлительнойОперации(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьВыполнениеЗаданияСервер(ИдентификаторЗадания)
	
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ПоказатьСообщенияФоновогоЗадания(Знач Сообщения, ИнформацияАгрегатор)
	
	Если Сообщения = Неопределено Тогда
		Сообщения = ПолучитьСообщенияФоновогоЗадания(ИдентификаторЗадания);
	КонецЕсли;
	
	Для Каждого Сообщение Из Сообщения Цикл
		Если Лев(Сообщение.Текст, 11) = "#Агрегатор#" Тогда
			ИнформацияАгрегатор.Добавить(Сред(Сообщение.Текст, 12));
		Иначе
			Сообщение.ИдентификаторНазначения = УникальныйИдентификатор;
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСообщенияФоновогоЗадания(ИдентификаторЗадания)
	
	Возврат ДлительныеОперации.СообщенияПользователю(Истина, ИдентификаторЗадания);
	
КонецФункции

&НаКлиенте
Процедура ПоказатьРезультатОбъединенияДокументов(ИнформацияАгрегатор)
	
	Если ИнформацияАгрегатор.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ПолучитьДанныеОбъединенияАгрегатора(ИнформацияАгрегатор);
	
	Для Каждого СтрокаОС Из ТаблицаОС Цикл
		Если СтрокаОС.Состояние = 0 Тогда
			Данные = Результат[СтрокаОС.ОсновноеСредство];
			Если Данные <> Неопределено Тогда
				СтрокаОС.Состояние = Данные.СостояниеОС;
				СтрокаОС.Документ = Данные.Документ;
				КолВоСтрок = Мин(СтрокаОС.СписокДокументов.Количество(), Данные.СостояниеДокументов.Количество()); 
				Для Сч = 1 По КолВоСтрок Цикл
					СтрокаОС.СписокДокументов[Сч-1].Состояние = Данные.СостояниеДокументов[Сч-1];
				КонецЦикла;
				Объединение_ТекущаяСтрока = СтрокаОС.ПолучитьИдентификатор();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Объединение_Выполнено = Объединение_Выполнено + Результат.Количество();
	
	Если Объединение_Выполнено = Объединение_Всего Тогда
		Элементы.ДлительнаяОперация_Состояние.Заголовок = "расчет итогов, подождите...";
		Элементы.ОбъединениеОбновить.Видимость			= Ложь;
		Элементы.ДлительнаяОперацияПрервать.Видимость	= Ложь;
	Иначе
		Элементы.ДлительнаяОперация_Состояние.Заголовок = Строка(Объединение_Выполнено) + " из " + Строка(Объединение_Всего)
			+ " (" +Формат(Объединение_Выполнено / Объединение_Всего, "ЧЦ=10; ЧДЦ=2; ЧС=-2; ЧН=") + "%)";
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеОбъединенияАгрегатора(Сообщения) 
	
	Результат = Новый Соответствие;
	
	Для Каждого Сообщение Из Сообщения Цикл
		Данные = ОбщегоНазначения.ЗначениеИзСтрокиXML(Сообщение);
		Результат.Вставить(Данные.ОсновноеСредство, Данные);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПолучитьДокументыСервер(АдресХранилища)
	
	Результат = ПолучитьИзВременногоХранилища(АдресХранилища);
	Если Результат <> Неопределено Тогда
		
		ТаблицаОС.Очистить();
		Для Каждого СтрокаОС Из Результат.ТаблицаОС Цикл
			НоваяСтрока = ТаблицаОС.Добавить();
			НоваяСтрока.ОсновноеСредство = СтрокаОС.ОсновноеСредство;
			НоваяСтрока.Документ = СтрокаОС.Документ;
			НоваяСтрока.Состояние = СтрокаОС.Состояние;
			НоваяСтрока.СписокДокументов.Загрузить(СтрокаОС.СписокДокументов);
		КонецЦикла;
		
		СписокДокументов.ЗагрузитьЗначения(Результат.СписокДокументов);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементовПриДлительнойОперации(ЭтоДлительнаяОперация)
	
	ОперацияОбъединения = (Операция = "СоздатьАгрегатор");
	
	Элементы.ГруппаШапка.ТолькоПросмотр = ЭтоДлительнаяОперация;
	
	Элементы.ТаблицаОС.ТолькоПросмотр					= ЭтоДлительнаяОперация И Не ОперацияОбъединения;
	Элементы.ТаблицаОСОсновноеСредство.ТолькоПросмотр	= ЭтоДлительнаяОперация;
	Элементы.ТаблицаОС.КоманднаяПанель.Доступность		= Не ЭтоДлительнаяОперация;
	Элементы.ТаблицаОС.КонтекстноеМеню.Доступность		= Не ЭтоДлительнаяОперация;
	
	Элементы.ДокументыЗаполнитьИнд.Доступность			= Не ЭтоДлительнаяОперация;
	Элементы.ДокументыЗаполнить.Доступность				= Не ЭтоДлительнаяОперация;
	
	Элементы.ПерваяСтрокаСписокДокументов.ТолькоПросмотр = ЭтоДлительнаяОперация И Не ОперацияОбъединения;
	Элементы.ПерваяСтрокаСписокДокументов.КонтекстноеМеню.Доступность = Не ЭтоДлительнаяОперация;
	
	Элементы.ТаблицаОССписокДокументов.ТолькоПросмотр = ЭтоДлительнаяОперация И Не ОперацияОбъединения;
	Элементы.ТаблицаОССписокДокументов.КонтекстноеМеню.Доступность = Не ЭтоДлительнаяОперация;
	
	Элементы.ОбъединениеВыполнить.Доступность		= Не ЭтоДлительнаяОперация;
	
	Элементы.ГруппаОперацияАгрегатор.Видимость		= ОперацияОбъединения И Не ИндивидуальныйРежим;
	
	Элементы.ДлительнаяОперация.Видимость			= ЭтоДлительнаяОперация;
	Элементы.ОбъединениеОбновить.Видимость			= Истина;
	Элементы.ДлительнаяОперацияПрервать.Видимость	= Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВключитьИспользованиеИтогов(ВидДокумента)
	
	Регистры = Документы.ВводНачальныхОстатковОС.ОпределитьДвигаемыеРегистры(ВидДокумента);
	Документы.ВводНачальныхОстатковОС.УстановитьИспользованиеИтогов(Истина, Регистры);
	
КонецПроцедуры


// Панель контроля

&НаКлиенте
Функция ПолучитьСписокОС()
	
	СписокОС = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаОС Цикл
		СписокОС.Добавить(СтрокаТаблицы.ОсновноеСредство);
	КонецЦикла;
	
	Возврат СписокОС;
	
КонецФункции

&НаКлиенте
Функция ПоказатьТабличныйДокумент(ТабДок, СписокОС, Синоним)
	
	ПечатнаяФорма = Новый Структура;
	ПечатнаяФорма.Вставить("ИмяВРЕГ"				, "");
	ПечатнаяФорма.Вставить("ИмяМакета"				, "");
	ПечатнаяФорма.Вставить("ИмяФайлаПечатнойФормы"	, Синоним);
	ПечатнаяФорма.Вставить("Картинка"				, Неопределено);
	ПечатнаяФорма.Вставить("ПолныйПутьКМакету"		, "");
	ПечатнаяФорма.Вставить("СинонимМакета"			, Синоним);
	ПечатнаяФорма.Вставить("ТабличныйДокумент"		, ТабДок);
	ПечатнаяФорма.Вставить("Экземпляров"			, 1);
	ПечатнаяФорма.Вставить("ОфисныеДокументы"		, Неопределено);
	ПечатнаяФорма.Вставить("ДоступенВыводНаДругихЯзыках", Ложь);
	ПечатнаяФорма.Вставить("ТекстОшибкиФормирования", "");
	
	Данные = Новый Массив;
	Данные.Добавить(ПечатнаяФорма);
	
	ПараметрыПечатнойФормы = Новый Структура;
	ПараметрыПечатнойФормы.Вставить("КоллекцияПечатныхФорм", Данные);
	ПараметрыПечатнойФормы.Вставить("ПараметрКоманды", СписокОС);
	
	ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыПечатнойФормы, ЭтаФорма);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДвиженияСервер(СписокОС, ВидДокумента)
	
	Регистры = Документы.ВводНачальныхОстатковОС.ОпределитьДвигаемыеРегистры(ВидДокумента);
	
	ТаблицыЗапросов = Новый Массив;
	
	Для Каждого СтрокаРегистра Из Регистры Цикл
		
		Если СтрокаРегистра.ИмяРегистра = "ЖурналПроводокЕПСБУ" Тогда
			
			ТаблицыЗапросов.Добавить(
			"ВЫБРАТЬ
			|	*,
			|	ВЫБОР
			|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоДт1 = &ВидОС
			|			ТОГДА ЕПСБУДвиженияССубконто.СубконтоДт1
			|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоДт2 = &ВидОС
			|			ТОГДА ЕПСБУДвиженияССубконто.СубконтоДт2
			|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоДт3 = &ВидОС
			|			ТОГДА ЕПСБУДвиженияССубконто.СубконтоДт3
			|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоКт1 = &ВидОС
			|			ТОГДА ЕПСБУДвиженияССубконто.СубконтоКт1
			|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоКт2 = &ВидОС
			|			ТОГДА ЕПСБУДвиженияССубконто.СубконтоКт2
			|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоКт3 = &ВидОС
			|			ТОГДА ЕПСБУДвиженияССубконто.СубконтоКт3
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
			|	КОНЕЦ КАК ОсновноеСредство
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
			|			,
			|			,
			|			(Регистратор, НомерСтроки) В
			|				(ВЫБРАТЬ
			|					ЕПСБУСубконто.Регистратор,
			|					ЕПСБУСубконто.НомерСтроки
			|				ИЗ
			|					РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Субконто КАК ЕПСБУСубконто
			|				ГДЕ
			|					ЕПСБУСубконто.Значение В (&ОсновноеСредство)),
			|			,
			|			) КАК ЕПСБУДвиженияССубконто
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период,
			|	СчетДт,
			|	СубконтоДт1,
			|	ВидСубконтоДт1,
			|	СубконтоДт2,
			|	ВидСубконтоДт2,
			|	СубконтоДт3,
			|	ВидСубконтоДт3,
			|	СчетКт,
			|	СубконтоКт1,
			|	ВидСубконтоКт1,
			|	СубконтоКт2,
			|	ВидСубконтоКт2,
			|	СубконтоКт3,
			|	ВидСубконтоКт3,
			|	Организация,
			|	КФО,
			|	КПСДт,
			|	КПСКт,
			|	ВалютаДт,
			|	ВалютаКт,
			|	ИФО,
			|	Сумма,
			|	ВалютнаяСуммаДт,
			|	ВалютнаяСуммаКт,
			|	КоличествоДт,
			|	КоличествоКт,
			|	Содержание,
			|	ХарактеристикаДвиженияДт,
			|	ХарактеристикаДвиженияКт,
			|	ВидПервичногоДокумента,
			|	НомерПервичногоДокумента,
			|	ДатаПервичногоДокумента,
			|	КЭКДт,
			|	КЭККт,
			|	ПодразделениеДт,
			|	ПодразделениеКт,
			|	ЖурналОпераций,
			|	СуммаНеУчитываетсяНУ,
			|	СуммаЕНВД,
			|	СуммаНДС
			|ИТОГИ ПО
			|	ОсновноеСредство");
			
		Иначе
			
			ТаблицыЗапросов.Добавить(
			"ВЫБРАТЬ 
			|	*
			|ИЗ
			|	" + СтрокаРегистра.ПолноеИмяРегистра + " КАК Регистр
			|ГДЕ		
			|	Регистр." + СтрокаРегистра.ИмяРеквизита + " В (&ОсновноеСредство)
			|
			|УПОРЯДОЧИТЬ ПО
			|	" + ПоляПорядка(СтрокаРегистра) + "
			|ИТОГИ ПО
			|	" + СтрокаРегистра.ИмяРеквизита);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстЗапроса = СтрСоединить(ТаблицыЗапросов, ";" + Символы.ПС);
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ОсновноеСредство", СписокОС);
	Запрос.УстановитьПараметр("ВидОС", ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	Результат = Запрос.ВыполнитьПакет();
	
	
	РезультатОС = Новый ТаблицаЗначений;
	РезультатОС.Колонки.Добавить("ОС");
	РезультатОС.Колонки.Добавить("Код");
	РезультатОС.Колонки.Добавить("Данные", Новый ОписаниеТипов("Структура"));
	
	Сч = 0;
	
	Для Каждого СтрокаРегистра Из Регистры Цикл
		
		Данные = Результат[Сч].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		Сч = Сч + 1;
		
		Данные.Колонки.Удалить("НомерСтроки");
		Данные.Колонки.Удалить("Регистратор");
		
		Для Каждого СтрокаОС Из Данные.Строки Цикл
			
			ОС = СтрокаОС[СтрокаРегистра.ИмяРеквизита];
			ДанныеОС = РезультатОС.Найти(ОС, "ОС");
			Если ДанныеОС = Неопределено Тогда
				ДанныеОС = РезультатОС.Добавить();
				ДанныеОС.ОС = ОС;
				ДанныеОС.Код = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОС, "Код");
			КонецЕсли;
			
			ДанныеОС.Данные.Вставить(СтрокаРегистра.ИмяРегистра, СтрокаОС.Строки);
			
		КонецЦикла;
		
		Если СтрокаРегистра.ТипРегистра = "РегистрБухгалтерии" Тогда
			Данные.Колонки.Удалить("ОсновноеСредство");
		КонецЕсли;
		
	КонецЦикла;
	
	РезультатОС.Сортировать("Код");
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	Макет = Документы.ВводНачальныхОстатковОС.ПолучитьМакет("Движения");
	Область_ОС				= Макет.ПолучитьОбласть("ОС");
	Область_РегистрНазвание	= Макет.ПолучитьОбласть("РегистрНазвание");
	Область_РегистрШапка	= Макет.ПолучитьОбласть("РегистрШапка");
	Область_РегистрСтрока	= Макет.ПолучитьОбласть("РегистрСтрока");
	
	Для Каждого СтрокаРез Из РезультатОС Цикл
		
		Область_ОС.Параметры.Наименование = Строка(СтрокаРез.ОС) + " (" + СокрП(СтрокаРез.Код) + ")";
		ТабДок.Вывести(Область_ОС);
		ТабДок.НачатьГруппуСтрок();
		
		Для Каждого СтрокаРегистр Из СтрокаРез.Данные Цикл
			
			Область_РегистрНазвание.Параметры.Наименование = СтрокаРегистр.Ключ;
			ТабДок.Вывести(Область_РегистрНазвание);
			ТабДок.НачатьГруппуСтрок();
			
			Строки = СтрокаРегистр.Значение; 
			Колонки = Строки[0].Владелец().Колонки;
			
			ОчиститьПараметрыОбласти(Область_РегистрШапка);
			НомерКолонки = 1;
			Для Каждого Колонка Из Колонки Цикл
				Область_РегистрШапка.Параметры["Параметр" + НомерКолонки] = Колонка.Имя;
				НомерКолонки = НомерКолонки + 1;
			КонецЦикла;
			ТабДок.Вывести(Область_РегистрШапка);
			
			ОчиститьПараметрыОбласти(Область_РегистрСтрока);
			Для Каждого СтрокаДвижение Из Строки Цикл
				НомерКолонки = 1;
				Для Каждого Колонка Из Колонки Цикл
					Область_РегистрСтрока.Параметры["Параметр" + НомерКолонки] = СтрокаДвижение[Колонка.Имя];
					НомерКолонки = НомерКолонки + 1;
				КонецЦикла;
				ТабДок.Вывести(Область_РегистрСтрока);
			КонецЦикла;
			
			ТабДок.ЗакончитьГруппуСтрок();
			
		КонецЦикла;
		
		ТабДок.ЗакончитьГруппуСтрок();
		
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПоляПорядка(СтрокаРегистра)
	
	МетаданныеРег = Метаданные[СтрЗаменить(СтрокаРегистра.ТипРегистра, "Регистр", "Регистры")][СтрокаРегистра.ИмяРегистра];
	
	Поля = Новый Массив;
	
	Для Каждого Реквизит Из МетаданныеРег.СтандартныеРеквизиты Цикл
		Если Реквизит.Имя <> "Регистратор" И Реквизит.Имя <> "НомерСтроки" Тогда
			Поля.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Реквизит Из МетаданныеРег.Измерения Цикл
		Поля.Добавить(Реквизит.Имя);
	КонецЦикла;
	
	Для Каждого Реквизит Из МетаданныеРег.Ресурсы Цикл
		Поля.Добавить(Реквизит.Имя);
	КонецЦикла;
	
	Для Каждого Реквизит Из МетаданныеРег.Реквизиты Цикл
		Если Реквизит.Имя <> "ПриказОПереоценке" И Реквизит.Имя <> "Основание" Тогда // Исключаем поле неограниченной длины
			Поля.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ПоляСтрокой = СтрСоединить(Поля, ",");
	
	Возврат ПоляСтрокой;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОчиститьПараметрыОбласти(Область)
	
	Для Параметр = 0 По Область.Параметры.Количество()-1 Цикл
		Область.Параметры[Параметр] = Неопределено;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИнвКарточкиСервер(СписокОС)
	
	Возврат Справочники.ОсновныеСредства.ПечатьИнвентарнойКарточки(СписокОС, Новый СписокЗначений);
	
КонецФункции

#КонецОбласти
