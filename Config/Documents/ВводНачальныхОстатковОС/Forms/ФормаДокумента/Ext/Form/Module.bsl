	ТекущиеДанные.СтоимостьДляВычисленияАмортизации			= 0;
	ТекущиеДанные.КоэффициентУскорения						= 0;
	ТекущиеДанные.ПараметрВыработки							= Неопределено;
	ТекущиеДанные.ПредполагаемыйОбъемВыработки				= 0;
	
