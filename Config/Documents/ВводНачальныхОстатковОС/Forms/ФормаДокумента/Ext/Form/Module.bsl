Процедура ПорядокВключенияСтоимостиВСоставРасходовНУПриИзменении(Элемент)
	
	ЭтоНачислениеАмортизации = (Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации"));
		
	Если ЭтоНачислениеАмортизации Тогда
		
		Если Объект.СтоимостьИАмортизация.Количество() > 0
			И Не ЗначениеЗаполнено(Объект.СрокПолезногоИспользованияНУ) Тогда
			Объект.СрокПолезногоИспользованияНУ = Объект.СтоимостьИАмортизация[0].СрокПолезногоИспользования;
			ОбновитьКомментарийСрокаПолезногоИспользования("НУ");
		КонецЕсли;
		
		Объект.НачислятьАмортизациюНУ = Объект.НачислятьАмортизацию;
		Объект.СпециальныйКоэффициентНУ = 1;
		
	КонецЕсли;
	
	НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовНУ();
	
