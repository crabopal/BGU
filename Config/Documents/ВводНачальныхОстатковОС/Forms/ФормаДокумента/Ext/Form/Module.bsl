Процедура Подключаемый_ПриНачалеВыбораДопРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	БухгалтерскиеОперацииКлиент.ДопРеквизитНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДопРеквизита(Элемент)
	
	БухгалтерскиеОперацииКлиент.ДопРеквизитИзменение(Элемент, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УправлениеТиповымиОперациями(Команда)
	
	БухгалтерскиеОперацииКлиент.КомандаУправлениеТиповымиОперациями(ЭтотОбъект, Команда);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИнвентарныеОбъекты

&НаКлиенте
Процедура ИнвентарныеОбъектыВПользованииКонтрагентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	КонтрагентНачалоВыбора(Элемент, Элементы.ИнвентарныеОбъекты.ТекущиеДанные, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыВПользованииКонтрагентОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	КонтрагентОбработкаВыбора(ВыбранноеЗначение, Элементы.ИнвентарныеОбъекты.ТекущиеДанные, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда
		ТекущиеДанные = Элементы.ИнвентарныеОбъекты.ТекущиеДанные;
		ОбновитьТекстЗаголовковВСтрокеИнвентарныеОбъекты(ТекущиеДанные);
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		ИнвентарныеОбъектыРассчитатьИтоги();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыПослеУдаления(Элемент)
	
	ИнвентарныеОбъектыРассчитатьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыИнвентарныйНомерПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИнвентарныеОбъекты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Количество = 0 Тогда
		ТекущиеДанные.Количество = 1;
		ИнвентарныеОбъектыРассчитатьСтоимость(ТекущиеДанные);
		ИнвентарныеОбъектыРассчитатьИтоги();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыСостояниеОСвОрганизацииПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИнвентарныеОбъекты.ТекущиеДанные;
	
	ПриИзмененииСостоянияОСвОрганизации(ТекущиеДанные);
	
	ТекущиеДанные.ЗаголовокСтоимость = ЗаголовокСтоимости(ТекущиеДанные.СостояниеОСвОрганизации);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСостоянияОСвОрганизации(ТекущиеДанные)
	
	Если ТекущиеДанные.СостояниеОСвОрганизации = "БалансПринятоКУчету" Тогда
		ТекущиеДанные.СостояниеОС	= ПредопределенноеЗначение("Перечисление.СостоянияОС.ПринятоКУчету");
		ТекущиеДанные.НаСчете21		= Ложь;
	ИначеЕсли ТекущиеДанные.СостояниеОСвОрганизации = "БалансВведеноВЭксплуатацию" Тогда
		ТекущиеДанные.СостояниеОС	= ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию");
		ТекущиеДанные.НаСчете21		= Ложь;
	ИначеЕсли ТекущиеДанные.СостояниеОСвОрганизации = "НаСчете21" Тогда
		ТекущиеДанные.СостояниеОС	= ПредопределенноеЗначение("Перечисление.СостоянияОС.СнятоСУчета");
		ТекущиеДанные.НаСчете21		= Истина;
	ИначеЕсли ТекущиеДанные.СостояниеОСвОрганизации = "Списано" Тогда
		ТекущиеДанные.СостояниеОС	= ПредопределенноеЗначение("Перечисление.СостоянияОС.СнятоСУчета");
		ТекущиеДанные.НаСчете21		= Ложь;
	КонецЕсли;
	
	ИнвентарныеОбъектыРассчитатьСтоимость(ТекущиеДанные);
	ИнвентарныеОбъектыРассчитатьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИнвентарныеОбъекты.ТекущиеДанные;
	Если ТекущиеДанные.Количество = 0 И ЗначениеЗаполнено(ТекущиеДанные.ИнвентарныйНомер) Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
	
	ИнвентарныеОбъектыРассчитатьСтоимость(ТекущиеДанные);
	ИнвентарныеОбъектыРассчитатьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыСтоимостьПриИзменении(Элемент)
	
	ИнвентарныеОбъектыРассчитатьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыСуммаАмортизацииПриИзменении(Элемент)
	
	ИнвентарныеОбъектыРассчитатьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыСостояниеОСвПользованииПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИнвентарныеОбъекты.ТекущиеДанные;
	УстановитьОграничениеСчетаВПользовании(ТекущиеДанные);
	
	ИнвентарныеОбъектыРассчитатьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыВПользованииКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИнвентарныеОбъекты.ТекущиеДанные;
	Если ТекущиеДанные.ВПользованииКоличество = 0 И ЗначениеЗаполнено(ТекущиеДанные.ИнвентарныйНомер) Тогда
		ТекущиеДанные.ВПользованииКоличество = 1;
	КонецЕсли;
	
	ИнвентарныеОбъектыРассчитатьСтоимость(ТекущиеДанные);
	ИнвентарныеОбъектыРассчитатьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыВПользованииСтоимостьПриИзменении(Элемент)
	
	ИнвентарныеОбъектыРассчитатьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыРассчитатьСтоимость(ТекущиеДанные)
	
	Если Объект.ПервоначальноеКоличество = 0 Или Не ГрупповойУчет Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.Стоимость = ТекущиеДанные.Количество * Объект.ПервоначальнаяСтоимость / Объект.ПервоначальноеКоличество;
	
	Если ТекущиеДанные.СостояниеОСвОрганизации = "БалансВведеноВЭксплуатацию" И Объект.ИнвентарныйУчет = 0 Тогда
		ТекущиеДанные.СуммаАмортизации = ТекущиеДанные.Стоимость;
	Иначе
		ТекущиеДанные.СуммаАмортизации = 0;
	КонецЕсли;
	
	Если ОтражатьВНалоговомУчете
		И ТекущиеДанные.СостояниеОСвОрганизации = "БалансПринятоКУчету" Тогда
		ТекущиеДанные.СуммаНУ = ТекущиеДанные.Стоимость;
	Иначе
		ТекущиеДанные.СуммаНУ = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыРассчитатьИтоги(Инициализация = Ложь)
	
	Итоги_СтоимостьБаланс	= 0;
	Итоги_КоличествоБаланс	= 0;
	Итоги_Стоимость21		= 0;
	Итоги_Количество21		= 0;
	Итоги_Стоимость25		= 0;
	Итоги_Количество25		= 0;
	Итоги_Стоимость26		= 0;
	Итоги_Количество26		= 0;
	Итоги_Стоимость27		= 0;
	Итоги_Количество27		= 0;
	Итоги_СуммаАмортизации	= 0;
	
	Для Каждого ТекущиеДанные Из Объект.ИнвентарныеОбъекты Цикл
		
		Если ТекущиеДанные.СостояниеОСвОрганизации = "БалансПринятоКУчету"
			Или ТекущиеДанные.СостояниеОСвОрганизации = "БалансВведеноВЭксплуатацию" Тогда
			Итоги_СтоимостьБаланс	= Итоги_СтоимостьБаланс + ТекущиеДанные.Стоимость;
			Итоги_КоличествоБаланс	= Итоги_КоличествоБаланс + ТекущиеДанные.Количество;
			Итоги_СуммаАмортизации	= Итоги_СуммаАмортизации + ТекущиеДанные.СуммаАмортизации;
		ИначеЕсли ТекущиеДанные.СостояниеОСвОрганизации = "НаСчете21" Тогда
			Итоги_Стоимость21		= Итоги_Стоимость21 + ТекущиеДанные.Стоимость;
			Итоги_Количество21		= Итоги_Количество21 + ТекущиеДанные.Количество;
		КонецЕсли;
		
		КолПередано = ?(Объект.УчетныеДанныеПодробно, ТекущиеДанные.ВПользованииКоличество, ТекущиеДанные.Количество);
		СумПередано = ?(Объект.УчетныеДанныеПодробно, ТекущиеДанные.ВПользованииСтоимость, ТекущиеДанные.Стоимость);
		Если ТекущиеДанные.ВПользованииСостояниеОС = 
			ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.СдачаВАренду") Тогда
			Итоги_Стоимость25	= Итоги_Стоимость25 + СумПередано;		
			Итоги_Количество25	= Итоги_Количество25 + КолПередано;	
		ИначеЕсли ТекущиеДанные.ВПользованииСостояниеОС = 
			ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ПередачаВБезвозмездноеПользование") Тогда
			Итоги_Стоимость26	= Итоги_Стоимость26 + СумПередано;		
			Итоги_Количество26	= Итоги_Количество26 + КолПередано;	
		ИначеЕсли ТекущиеДанные.ВПользованииСостояниеОС = 
			ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ПередачаВЛичноеПользование") Тогда
			Итоги_Стоимость27	= Итоги_Стоимость27 + СумПередано;
			Итоги_Количество27	= Итоги_Количество27 + КолПередано; 
		КонецЕсли;
		
		Если Инициализация Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекущиеДанные.СостояниеОСвОрганизации = "БалансПринятоКУчету"
			Или ТекущиеДанные.СостояниеОСвОрганизации = "БалансВведеноВЭксплуатацию" Тогда
			Если ТекущиеДанные.СуммаНУ = 0 Тогда
				ТекущиеДанные.СуммаНУ = ТекущиеДанные.Стоимость;
			КонецЕсли;
			Если ТекущиеДанные.СуммаАмортизацииНУ = 0 Тогда
				ТекущиеДанные.СуммаАмортизацииНУ = ТекущиеДанные.СуммаАмортизации;
			КонецЕсли;
		Иначе
			ТекущиеДанные.СуммаНУ = 0;
			ТекущиеДанные.СуммаАмортизацииНУ = 0;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИнвентарныеОбъектыНомерами(Команда)
	
	ЗаполнитьИнвентарныеОбъектыНомерамиСервер();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнвентарныеОбъектыНомерамиСервер()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, Объект.Организация);
	Запрос.УстановитьПараметр("ОС"			, Объект.ОсновноеСредство);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИнвентарныеНомераОС.Ссылка
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.Владелец = &Организация
	|	И ИнвентарныеНомераОС.ОС = &ОС
	|	И НЕ ИнвентарныеНомераОС.ПометкаУдаления";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	КоличествоСтрок = Объект.ИнвентарныеОбъекты.Количество();
	ПерваяСтрока = ?(КоличествоСтрок > 0, Объект.ИнвентарныеОбъекты[0], Неопределено);
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.ИнвентарныеОбъекты.Добавить();
		Если ПерваяСтрока <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПерваяСтрока);
		КонецЕсли;
		НоваяСтрока.ИнвентарныйНомер = Выборка.Ссылка;
		
	КонецЦикла;
	
	Для Сч = 1 По КоличествоСтрок Цикл
		Объект.ИнвентарныеОбъекты.Удалить(0);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыПричинаСписанияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	УправлениеОсновнымиСредствамиКлиент.ПричинаСписанияНачалоВыбора(
		Элемент, Элементы.ИнвентарныеОбъекты.ТекущиеДанные, СтандартнаяОбработка, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеОбъектыПричинаСписанияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	УправлениеОсновнымиСредствамиКлиент.ПричинаСписанияОбработкаВыбора(
		Элементы.ИнвентарныеОбъекты.ТекущиеДанные, ВыбранноеЗначение, Ложь);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СтоимостьИАмортизация

&НаКлиенте
Процедура СтоимостьИАмортизацияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекущиеДанные = Элементы.СтоимостьИАмортизация.ТекущиеДанные;
		ТекущиеДанные.СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(АмортизационнаяГруппа);
		
		ОбновитьТекстЗаголовковВСтрокеСтоимостьИАмортизация(ТекущиеДанные);
		ОбновитьТекстДопСведенияВСтрокеСтоимостьИАмортизация(ТекущиеДанные);
		ОбновитьТекстПереоценкиСтоимостьИАмортизация(ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтоимостьИАмортизацияСобытиеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СтоимостьИАмортизация.ТекущиеДанные;
	
	Если ТекущиеДанные.Событие = ПредопределенноеЗначение("Перечисление.СобытияИсторииСтоимостиОС.ПринятиеКУчету") Тогда
		Если ВедетсяАналитическийУчет Тогда
			УстановитьРеквизитыПринятияКУчетуСтоимость(ТекущиеДанные);
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьТекстДопСведенияВСтрокеСтоимостьИАмортизация(ТекущиеДанные);
	ОбновитьТекстПереоценкиСтоимостьИАмортизация(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура СтоимостьИАмортизацияПредставлениеПереоценкаОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.СтоимостьИАмортизация.ТекущиеДанные;
	
	ТекущиеДанные.ГруппаОФ					= "";
	ТекущиеДанные.ОсновнойКоэффициент		= 0;
	ТекущиеДанные.ПоправочныйКоэффициент	= 0;
	ТекущиеДанные.ДооценкаАмортизации		= 0;
	
	ОбновитьТекстПереоценкиСтоимостьИАмортизация(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура СтоимостьИАмортизацияПредставлениеПереоценкаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.СтоимостьИАмортизация.ТекущиеДанные;
	
	ИменаРеквизитов = "ГруппаОФ,ОсновнойКоэффициент,ПоправочныйКоэффициент,ДооценкаАмортизации";
	
	ДанныеТекущейСтроки = Новый Структура(ИменаРеквизитов);
	ЗаполнитьЗначенияСвойств(ДанныеТекущейСтроки, ТекущиеДанные);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДанныеТекущейСтроки", ДанныеТекущейСтроки);
	ПараметрыФормы.Вставить("СписокРеквизитовСтрокиДокумента", ИменаРеквизитов);
	ПараметрыФормы.Вставить("ЭтоПараметрыПереоценки");
	
	ОткрытьФорму("Документ.ВводНачальныхОстатковОС.Форма.ФормаДополнительныеСведения", ПараметрыФормы, Элемент);
	
КонецПроцедуры

