
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	УстановитьУсловноеОформление();
	
	// Настроим элементы формы СостояниеОСвОрганизации и СостояниеОСвПользовании.
	СостоянияОСвОрганизации = СостоянияОСвОрганизации();
	СостоянияОСвПользовании = СостоянияОСвПользовании();
	ЗаполнитьСписокВыбораЭлемента(Элементы.СостояниеОСвОрганизацииИнд, СостоянияОСвОрганизации);
	ЗаполнитьСписокВыбораЭлемента(Элементы.СостояниеОСвПользованииИнд, СостоянияОСвПользовании);
	ЗаполнитьСписокВыбораЭлемента(Элементы.ИнвентарныеОбъектыСостояниеОСвОрганизации, СостоянияОСвОрганизации);
	ЗаполнитьСписокВыбораЭлемента(Элементы.ИнвентарныеОбъектыСостояниеОСвПользовании, СостоянияОСвПользовании);
	УстановитьУсловноеОформлениеЭлементовСпискаВыбора(Элементы.ИнвентарныеОбъектыСостояниеОСвОрганизации);
	УстановитьУсловноеОформлениеЭлементовСпискаВыбора(Элементы.ИнвентарныеОбъектыСостояниеОСвПользовании);
	
	// Типовые операции
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Элементы.БухгалтерскаяОперация);
	// Конец Типовые операции
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	Если Объект.Ссылка.Пустая() Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
			Если Не Объект.ОтражатьИсторию Тогда // Вводим начальные остатки.
				Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
			Иначе
				Объект.Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
			КонецЕсли;
		КонецЕсли;
		
		ПодготовитьФормуНаСервере();
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИнвентарныеОбъектыРассчитатьИтоги(Истина);
	
	Элементы.ГруппаСтраницыИндивидуальныйГрупповойУчет.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	
	УстановитьВидимостьЭлементов();
	УстановитьВидимостьЭлементовИнд();
	УстановитьВидимостьЭлементовНалоговогоУчета();
	ОбновитьКомментарийСрокаПолезногоИспользования();
	УстановитьЗаголовкиИДоступностьСубконтоСчетаЗатрат();
	
	Элементы.ГруппаАгрегатор.Видимость = Объект.ЭтоАгрегаторДвижений;
	
	// Налоговый учет (ОСН)
	НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовНУ();
	НастроитьФормуВЗависимостиОтМетодНачисленияАмортизацииНУ();
	УстановитьВидимостьСтатьиПрочихРасходовНУ();
	
	// Налоговый учет (УСН)
	НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовУСН();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Элементы.ГруппаПеренос.Видимость = Объект.ЭтоПереносИзСтарогоДокумента;
	Если Объект.ЭтоПереносИзСтарогоДокумента Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
		Элементы.ГруппаАгрегатор.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Документ.ВводНачальныхОстатковОС.Форма.НастройкиРежима" Тогда
		ЗаполнитьЗначенияСвойств(Объект, ВыбранноеЗначение);
		Если ВыбранноеЗначение.Заполнить Тогда
			ЗаполнитьДокументПоОснованию();
		ИначеЕсли НЕ ВыбранноеЗначение.ОтражатьВБухгалтерскомУчете И ВыбранноеЗначение.ОтражатьВНалоговомУчете Тогда
			ЗаполнитьДокументПоДаннымБухУчета();
			ИнициализироватьПараметрыФормы();
		КонецЕсли;
		СоздатьНедостающиеСтроки();
		УстановитьВидимостьЭлементов();
		УстановитьВидимостьЭлементовИнд();
		УстановитьВидимостьЭлементовНалоговогоУчета();
		НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовНУ();
		НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовУСН();
		ИнвентарныеОбъектыРассчитатьИтоги();
		ОбновитьТекстЗаголовковВсехТаблиц(Объект, ВалютаРубли);
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_ОсновныеСредства" И Источник = Объект.ОсновноеСредство Тогда
		
		ЗначенияРеквизитов = ПолучитьЗначенияРеквизитовОсновногоСредства(Объект.ОсновноеСредство);
		
		НеобходимоОбновитьВидимостьЭлементов = (ГрупповойУчет <> ЗначенияРеквизитов.ГрупповойУчет);
		
		ГрупповойУчет			= ЗначенияРеквизитов.ГрупповойУчет;
		АмортизационнаяГруппа	= ЗначенияРеквизитов.АмортизационнаяГруппа;
		ВидНФА					= ЗначенияРеквизитов.ВидНФА;
		ИмуществоКазны			= ЗначенияРеквизитов.ИмуществоКазны;
		
		Если НеобходимоОбновитьВидимостьЭлементов Тогда
			УстановитьИнвентарныйУчет();
			УстановитьВидимостьЭлементов();
			УстановитьВидимостьЭлементовИнд();
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "Запись_ВводНачальныхОстатковОС"
		И Параметр.Свойство("ДокументОснование") И Параметр.ДокументОснование = Объект.Ссылка Тогда
		
		ДействующаяРедакция = Параметр.ДействующаяРедакция;
		Элементы.ГруппаНеДействующаяРедакцияДокумента.Видимость = ЗначениеЗаполнено(ДействующаяРедакция);
		ТолькоПросмотр = (Объект.Проведен И ЗначениеЗаполнено(ДействующаяРедакция));
		Элементы.СнятьПризнакАгрегатора.Доступность = Не ТолькоПросмотр;
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Типовые операции
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект, Элементы.БухгалтерскаяОперация);
	// Конец Типовые операции
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтотОбъект);
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбновитьФормуПоОсновномуСредству();
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОбновитьТекстЗаголовковВсехТаблиц(Объект, ВалютаРубли);
	
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтотОбъект);
	
	ПараметрыОповещения = Новый Структура("ДокументОснование,ДействующаяРедакция",
		Объект.ДокументОснование, ?(Объект.Проведен, Объект.Ссылка, Неопределено));
	Оповестить("Запись_ВводНачальныхОстатковОС", ПараметрыОповещения, Объект.Ссылка);
	
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СнятьПризнакАгрегатора(Команда)
	
	ВводНачальныхОстатковКлиент.СнятьПризнакАгрегатора(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		
		Объект.ДокументОснование = ПредопределенноеЗначение("Документ.ВводНачальныхОстатковОС.ПустаяСсылка");
		
		ОрганизацияПриИзмененииНаСервере();
		УстановитьИнвентарныйУчет();
		
		УстановитьВидимостьЭлементов();
		УстановитьВидимостьЭлементовИнд();
		УстановитьВидимостьЭлементовНалоговогоУчета();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	УстановитьФункциональныеОпцииФормы();
	
	ОбновитьФормуПоОсновномуСредству();
	
	ИнициализироватьПараметрыФормы();
	
	// Устанавливаем новую дату документа:
	Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	// Если определили, что изменение даты может повлиять на какие-либо параметры, 
	// то передаем обработку на сервер.
	ТребуетсяВызовСервера = ОбщегоНазначенияБГУКлиент.ТребуетсяВызовСервераПриИзмененииДатыДокумента(
		Объект.Дата, ТекущаяДатаДокумента);
	Если ТребуетсяВызовСервера Тогда
		ДатаПриИзмененииНаСервере();
	КонецЕсли;
		
	УстановитьИнвентарныйУчет();
	
	УстановитьВидимостьЭлементов();
	УстановитьВидимостьЭлементовНалоговогоУчета();
	НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовНУ();
	НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовУСН();
	ТекущаяДатаДокумента = Объект.Дата; // Запомним новую дату документа.
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	УстановитьФункциональныеОпцииФормы();
	
	Если ЗначениеЗаполнено(Объект.ОсновноеСредство) И Объект.Ссылка.Пустая()
		И Не ОБъект.ОтражатьВБухгалтерскомУчете И Объект.ОтражатьВНалоговомУчете Тогда
		ЗаполнитьДокументПоДаннымБухУчета();
		ОбновитьФормуПоОсновномуСредству();
	КонецЕсли;
	
	ИнициализироватьПараметрыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоПриИзменении(Элемент)
	
	Объект.ДокументОснование = ПредопределенноеЗначение("Документ.ВводНачальныхОстатковОС.ПустаяСсылка");
	Если Не Объект.ОтражатьВБухгалтерскомУчете Тогда
		Объект.ОтражатьИсторию = Ложь;
	КонецЕсли;
	
	ОсновноеСредствоПриИзмененииНаСервере();
	
	УстановитьИнвентарныйУчет();
	УстановитьВидимостьЭлементов();
	УстановитьВидимостьЭлементовИнд();
	УстановитьВидимостьЭлементовНалоговогоУчета();
	НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовНУ();
	НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовУСН();
	
КонецПроцедуры

&НаСервере
Процедура ОсновноеСредствоПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.ОсновноеСредство) И Объект.Ссылка.Пустая() Тогда
		
		ДатаУчетнойПолитики = КонецГода(Объект.Дата) + 1;
		ПлательщикНалогаНаПрибыль = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Объект.Организация, ДатаУчетнойПолитики);
		ПрименяетсяУСНДоходыМинусРасходы = УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Объект.Организация, ДатаУчетнойПолитики);
		
		ПараметрыПроверки = Новый Структура("БухгалтерскийУчет, НалоговыйУчет, НалоговыйУчетУСН", Истина, Истина, Истина);
		ЕстьОстаткиПоОС = Документы.ВводНачальныхОстатковОС.ЕстьОстаткиПоОсновномуСредству(
			Объект.ОсновноеСредство, ДатаУчетнойПолитики, ПараметрыПроверки);
		Если Не ЕстьОстаткиПоОС.ЕстьОстаткиБУ Тогда 
			Объект.ОтражатьВБухгалтерскомУчете = Истина;
			Объект.ОтражатьВНалоговомУчете = ПлательщикНалогаНаПрибыль ИЛИ ПрименяетсяУСНДоходыМинусРасходы;
		Иначе // Есть остатки БУ, ввод остатков только в НУ.
			Объект.ОтражатьВБухгалтерскомУчете = Ложь;
			Если ПлательщикНалогаНаПрибыль Тогда
				Объект.ОтражатьВНалоговомУчете = Не ЕстьОстаткиПоОС.ЕстьОстаткиНУ;
			ИначеЕсли ПрименяетсяУСНДоходыМинусРасходы Тогда
				Объект.ОтражатьВНалоговомУчете = Не ЕстьОстаткиПоОС.ЕстьОстаткиУСН;
			КонецЕсли;
			ЗаполнитьДокументПоДаннымБухУчета();
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьФормуПоОсновномуСредству();
	ИнициализироватьПараметрыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныйУчетПриИзменении(Элемент)
	
	ИнвентарныеОбъектыРассчитатьИтоги();
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимВводаИзменитьНажатие(Элемент)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Для редактирования режима ввода остатков сначала укажите организацию.'"),
			Объект.Ссылка,
			"Объект.Организация");
		Возврат;
	ИначеЕсли Не ЗначениеЗаполнено(Объект.ОсновноеСредство) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Для редактирования режима ввода остатков сначала укажите основное средство.'"),
			Объект.Ссылка,
			"Объект.ОсновноеСредство");
		Возврат;
	КонецЕсли;
	
	ПараметрыРежима = Новый Структура(
	"ОтражатьВБухгалтерскомУчете,
	|ОтражатьВНалоговомУчете,
	|ОтражатьИсторию,
	|УчетныеДанныеПодробно,
	|ОсновноеСредство,
	|Организация,
	|Дата,
	|Проведен,
	|Ссылка,
	|КФО,
	|ДокументОснование");
	
	ЗаполнитьЗначенияСвойств(ПараметрыРежима, Объект);
	
	ПараметрыФормы = Новый Структура("ПараметрыРежима,ТолькоПросмотр",
		ПараметрыРежима, ТолькоПросмотр Или Элементы.ГруппаДанные.ТолькоПросмотр);
	ОткрытьФорму("Документ.ВводНачальныхОстатковОС.Форма.НастройкиРежима", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОтборСчета = Новый Массив;
	Если ИмуществоКазны Тогда
		Если ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС") Тогда
			ОтборСчета.Добавить("108.51");
			ОтборСчета.Добавить("108.52");
			ОтборСчета.Добавить("108.91");
			ОтборСчета.Добавить("108.92");
		ИначеЕсли ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА") Тогда
			ОтборСчета.Добавить("108.54");
		ИначеЕсли ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА") Тогда
			ОтборСчета.Добавить("108.55");
			ОтборСчета.Добавить("108.95");
		КонецЕсли;
	Иначе
		Если ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС") Тогда
			ОтборСчета.Добавить("101.00");
		ИначеЕсли ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА") Тогда
			ОтборСчета.Добавить("102.00");
			ОтборСчета.Добавить("111.60");
		ИначеЕсли ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА") Тогда
			ОтборСчета.Добавить("103.00");
		КонецЕсли;
	КонецЕсли;
	
	НачальноеЗначениеВыбора = Новый Структура("Счет, КПС, КФО",
		Объект.СчетУчета, Объект.КПС, Объект.КФО);
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент,
		СтандартнаяОбработка,
		НачальноеЗначениеВыбора,
		Объект.Организация, Объект.ИФО, ОтборСчета,,, КонецГода(Объект.Дата) + 1);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетОчистка(Элемент, СтандартнаяОбработка)
	
	Объект.КФО = Неопределено;
