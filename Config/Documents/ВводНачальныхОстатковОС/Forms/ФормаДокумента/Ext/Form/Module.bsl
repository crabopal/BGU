#Область ОбработчикиСобытийЭлементовТаблицыФормы_Местонахождение

&НаКлиенте
Процедура МестонахождениеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		Если Объект.ИнвентарныйУчет = 0 Тогда
			ТекущиеДанные = Элементы.Местонахождение.ТекущиеДанные;
			ТекущиеДанные.Событие = ПредопределенноеЗначение("Перечисление.СобытияИсторииМестонахожденияОС.ПеремещениеПоступление");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МестонахождениеСобытиеПриИзменении(Элемент)
	
	Если Не ВедетсяАналитическийУчет Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Местонахождение.ТекущиеДанные;
	
	Если ТекущиеДанные.Событие = ПредопределенноеЗначение("Перечисление.СобытияИсторииМестонахожденияОС.ПринятиеКУчету") Тогда	
		УстановитьРеквизитыПринятияКУчетуМестонахождение(ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМестонахождение(Команда)
	
	// Нужно задать вопрос, если таблица не пустая
	
	Модифицированность = Истина;
	
	Объект.Местонахождение.Очистить();
	
	Для Каждого СтрокаИнвНомер Из Объект.ИнвентарныеОбъекты Цикл
		
		НоваяСтрока = Объект.Местонахождение.Добавить();
		
		НоваяСтрока.ИнвентарныйНомер = СтрокаИнвНомер.ИнвентарныйНомер;
		НоваяСтрока.ЦМО = СтрокаИнвНомер.ЦМО;
		НоваяСтрока.Подразделение = СтрокаИнвНомер.Подразделение;
		НоваяСтрока.Событие = ПредопределенноеЗначение("Перечисление.СобытияИсторииМестонахожденияОС.ПринятиеКУчету");
		Если ВедетсяАналитическийУчет Тогда
			НоваяСтрока.Период				= Объект.ДатаПринятияКУчету;
			НоваяСтрока.НазваниеДокумента	= Объект.ДокументПринятияВид;
			НоваяСтрока.ДатаДокумента		= Объект.ДокументПринятияДата;
			НоваяСтрока.НомерДокумента		= Объект.ДокументПринятияНомер;
		Иначе
			НоваяСтрока.Период				= СтрокаИнвНомер.ДатаВводаВЭксплуатацию;
			НоваяСтрока.НазваниеДокумента	= СтрокаИнвНомер.ДокументВводаВид;
			НоваяСтрока.ДатаДокумента		= СтрокаИнвНомер.ДокументВводаДата;
			НоваяСтрока.НомерДокумента		= СтрокаИнвНомер.ДокументВводаНомер;
		КонецЕсли;
		
		Если Объект.ИнвентарныйУчет = 1 Тогда
			НоваяСтрока.Сумма = СтрокаИнвНомер.Стоимость;
			НоваяСтрока.Количество = СтрокаИнвНомер.Количество;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

