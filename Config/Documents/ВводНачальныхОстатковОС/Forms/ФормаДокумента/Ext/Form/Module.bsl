	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.СтоимостьИАмортизация.ТекущиеДанные;
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ВыбранноеЗначение);
	ОбновитьТекстДопСведенияВСтрокеСтоимостьИАмортизация(ТекущиеДанные);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтоимостьИАмортизация(Команда)
	
	// Нужно задать вопрос, если таблица не пустая
	
	Модифицированность = Истина;
	
	ДанныеТаблицы = Новый Структура("ПорядокПогашенияСтоимости,СпособНачисленияАмортизации,СрокПолезногоИспользования,
		|РасчетАмортизацииВручную,СтоимостьДляВычисленияАмортизации,СрокИспользованияДляВычисленияАмортизации");
	
	Если Объект.СтоимостьИАмортизация.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(ДанныеТаблицы, Объект.СтоимостьИАмортизация[0]); 
	Иначе
		ДанныеТаблицы.СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(АмортизационнаяГруппа);
	КонецЕсли;
	
	Объект.СтоимостьИАмортизация.Очистить();
	
	Для Каждого СтрокаИнвНомер Из Объект.ИнвентарныеОбъекты Цикл
		
		НоваяСтрока = Объект.СтоимостьИАмортизация.Добавить();
		
		НоваяСтрока.ИнвентарныйНомер = СтрокаИнвНомер.ИнвентарныйНомер;
		НоваяСтрока.Событие = ПредопределенноеЗначение("Перечисление.СобытияИсторииСтоимостиОС.ПринятиеКУчету");
		НоваяСтрока.БалансоваяСтоимость = СтрокаИнвНомер.Стоимость;
		НоваяСтрока.СуммаАмортизации = СтрокаИнвНомер.СуммаАмортизации;
		НоваяСтрока.СуммаОбесценения = СтрокаИнвНомер.СуммаОбесценения;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеТаблицы);
		Если ВедетсяАналитическийУчет Тогда
			НоваяСтрока.Период						= Объект.ДатаПринятияКУчету;
			НоваяСтрока.ВидПервичногоДокумента		= Объект.ДокументПринятияВид;
			НоваяСтрока.ДатаПервичногоДокумента		= Объект.ДокументПринятияДата;
			НоваяСтрока.НомерПервичногоДокумента	= Объект.ДокументПринятияНомер;
		Иначе
			НоваяСтрока.Период						= СтрокаИнвНомер.ДатаВводаВЭксплуатацию;
			НоваяСтрока.ВидПервичногоДокумента		= СтрокаИнвНомер.ДокументВводаВид;
			НоваяСтрока.ДатаПервичногоДокумента		= СтрокаИнвНомер.ДокументВводаДата;
			НоваяСтрока.НомерПервичногоДокумента	= СтрокаИнвНомер.ДокументВводаНомер;
		КонецЕсли;
		
		ОбновитьТекстЗаголовковВСтрокеСтоимостьИАмортизация(НоваяСтрока);
		ОбновитьТекстДопСведенияВСтрокеСтоимостьИАмортизация(НоваяСтрока);
		ОбновитьТекстПереоценкиСтоимостьИАмортизация(НоваяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

