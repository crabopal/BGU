&НаКлиенте
Процедура СчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(ВыбранноеЗначение, Объект.КПС, Объект.КФО);
	Объект.СчетУчета = ВыбранноеЗначение;
	
	ИнициализироватьПараметрыФормы();
	
	УстановитьИнвентарныйУчет();
	
	УстановитьВидимостьЭлементов();
	УстановитьВидимостьЭлементовИнд();
	УстановитьВидимостьЭлементовНалоговогоУчета();
	
	Для Каждого СтрокаТаблицы Из Объект.ИнвентарныеОбъекты Цикл
		СтрокаТаблицы.СчетАмортизации = Неопределено;
		СтрокаТаблицы.Счет21 = Неопределено;
		СтрокаТаблицы.ВПользованииСчет = Неопределено;
	КонецЦикла;
	
	Счет25 = Неопределено;
	Счет26 = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПринятияКУчетуПриИзменении(Элемент)
	
	Если Не ВедетсяАналитическийУчет Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущиеДанные Из Объект.СтоимостьИАмортизация Цикл
		Если ТекущиеДанные.Событие = ПредопределенноеЗначение("Перечисление.СобытияИсторииСтоимостиОС.ПринятиеКУчету") Тогда
			УстановитьРеквизитыПринятияКУчетуСтоимость(ТекущиеДанные);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекущиеДанные Из Объект.Местонахождение Цикл
		Если ТекущиеДанные.Событие = ПредопределенноеЗначение("Перечисление.СобытияИсторииМестонахожденияОС.ПринятиеКУчету") Тогда
			УстановитьРеквизитыПринятияКУчетуМестонахождение(ТекущиеДанные);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

