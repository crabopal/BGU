КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеЭлементовСпискаВыбора(Элемент)
	
	Для Каждого ЭлементСписка Из Элемент.СписокВыбора Цикл
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элемент.Имя);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор, Элемент.ПутьКДанным,
			ВидСравненияКомпоновкиДанных.Равно, ЭлементСписка.Значение);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", ЭлементСписка.Представление);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеСчета(КодСчета)
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы["ИнвентарныеОбъекты" + КодСчета].Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ИнвентарныеОбъекты." + КодСчета, ВидСравненияКомпоновкиДанных.НеЗаполнено);
	
	Если КодСчета = "СчетАмортизации" Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			"Объект.ИнвентарныеОбъекты.СуммаАмортизации", ВидСравненияКомпоновкиДанных.Заполнено);
	Иначе
		Префикс = ?(КодСчета = "ВПользованииСчет", "ВПользовании", "");
		ОтборГруппаИЛИ = ЭлементУО.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ОтборГруппаИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ОтборГруппаИЛИ,
			"Объект.ИнвентарныеОбъекты."+Префикс+"Стоимость", ВидСравненияКомпоновкиДанных.Заполнено);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ОтборГруппаИЛИ,
			"Объект.ИнвентарныеОбъекты."+Префикс+"Количество", ВидСравненияКомпоновкиДанных.Заполнено);
	КонецЕсли;
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "Авто");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеРеквизитНеЗаполняется(Элемент, ВидСравнения, Состояние)
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элемент.Имя);
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ИнвентарныеОбъекты.СостояниеОСвОрганизации", ВидСравненияКомпоновкиДанных[ВидСравнения], Состояние);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		Элемент.ПутьКДанным, ВидСравненияКомпоновкиДанных.НеЗаполнено);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не заполняется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИнвентарныйУчет()
	
	Если Не ВедетсяАналитическийУчет Тогда
		Объект.ИнвентарныйУчет = 1;
	ИначеЕсли Не ГрупповойУчет Тогда
		Объект.ИнвентарныйУчет = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехТаблиц(Объект, ВалютаРубли)
	
	Для Каждого ТекущаяСтрока Из Объект.ИнвентарныеОбъекты Цикл
		ОбновитьТекстЗаголовковВСтрокеИнвентарныеОбъекты(ТекущаяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.СтоимостьИАмортизация Цикл
		ОбновитьТекстЗаголовковВСтрокеСтоимостьИАмортизация(ТекущаяСтрока);
		ОбновитьТекстДопСведенияВСтрокеСтоимостьИАмортизация(ТекущаяСтрока);
		ОбновитьТекстПереоценкиСтоимостьИАмортизация(ТекущаяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.КапитальныйРемонт Цикл
		ОбновитьТекстЗаголовковВСтрокеКапРемонт(ТекущаяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.РасходыУСН Цикл
		ОбновитьТекстЗаголовковВСтрокеРасходыУСН(ТекущаяСтрока, ВалютаРубли);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеИнвентарныеОбъекты(ТекущаяСтрока)
	
	ТекущаяСтрока.ЗаголовокСтоимость	= ЗаголовокСтоимости(ТекущаяСтрока.СостояниеОСвОрганизации);
	ТекущаяСтрока.ЗаголовокАмортизация	= НСтр("ru = 'Амортизация:'");
	
	ТекущаяСтрока.ЗаголовокСуммаНУ				= НСтр("ru = 'Сумма:'");
	ТекущаяСтрока.ЗаголовокСуммаНеУчитываетсяНУ	= НСтр("ru = 'Не уч.:'");
	ТекущаяСтрока.ЗаголовокСуммаЕНВД			= НСтр("ru = 'ЕНВД:'");
	
	ТекущаяСтрока.ЗаголовокДатаСобытия	= НСтр("ru = 'Дата события:'");
	ТекущаяСтрока.ЗаголовокВидДок		= НСтр("ru = 'Название док.:'");
	ТекущаяСтрока.ЗаголовокНомерДок		= НСтр("ru = 'Дата, номер док.:'");
	
	ТекущаяСтрока.ЗаголовокКоличествоВПользовании	= НСтр("ru = 'Кол.:'");
	ТекущаяСтрока.ЗаголовокСуммаВПользовании		= НСтр("ru = 'Сумма:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеСтоимостьИАмортизация(ТекущаяСтрока)
	
	ТекущаяСтрока.ЗаголовокСрок		= НСтр("ru = 'Срок:'");      
	ТекущаяСтрока.ЗаголовокНорма	= НСтр("ru = 'Норма:'");
	
	ТекущаяСтрока.ЗаголовокПорядокПогашенияСтоимости   = НСтр("ru = 'Порядок погашения стоимости:'");
	ТекущаяСтрока.ЗаголовокСпособНачисленияАмортизации = НСтр("ru = 'Способ начисления амортизации:'");
	
	ТекущаяСтрока.ЗаголовокСуммаАмортизации  = НСтр("ru = 'Сумма:'");
	ТекущаяСтрока.ЗаголовокПериодАмортизации = НСтр("ru = 'Период:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстДопСведенияВСтрокеСтоимостьИАмортизация(ТекущаяСтрока)
	
	Если ТекущаяСтрока.СпособНачисленияАмортизации
		= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный") Тогда
		
		Если ТекущаяСтрока.РасчетАмортизацииВручную Тогда	
			Шаблон = "[Стоимость] / [СПИ]";
		Иначе
			Шаблон = НСтр("ru = 'Авто'");
		КонецЕсли;
		
	ИначеЕсли ТекущаяСтрока.СпособНачисленияАмортизации
		= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка") Тогда
		
		Если ТекущаяСтрока.РасчетАмортизацииВручную Тогда
			Шаблон = "[Стоимость] / [СПИ]";
		Иначе
			Шаблон = НСтр("ru = 'Авто'");
		КонецЕсли;
		
		Если ТекущаяСтрока.КоэффициентУскорения <> 1 Тогда
			Шаблон = Шаблон + " * [Коэф]";	
		КонецЕсли;
		
	ИначеЕсли ТекущаяСтрока.СпособНачисленияАмортизации
		= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции") Тогда
		
		Шаблон = "1 / [ВыработкаНорма] ([ВыработкаПарам])";
		
	Иначе
		Шаблон = "";
	КонецЕсли;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Стоимость"		, ТекущаяСтрока.СтоимостьДляВычисленияАмортизации);
	ПараметрыРасчета.Вставить("СПИ"				, ТекущаяСтрока.СрокИспользованияДляВычисленияАмортизации);
	ПараметрыРасчета.Вставить("Коэф"			, ТекущаяСтрока.КоэффициентУскорения);
	ПараметрыРасчета.Вставить("ВыработкаНорма"	, ТекущаяСтрока.ПредполагаемыйОбъемВыработки);
	ПараметрыРасчета.Вставить("ВыработкаПарам"	, ТекущаяСтрока.ПараметрВыработки);
	
	ТекущаяСтрока.ПредставлениеНорма = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ПараметрыРасчета);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстПереоценкиСтоимостьИАмортизация(ТекущаяСтрока)
	
	Если ТекущаяСтрока.Событие = ПредопределенноеЗначение("Перечисление.СобытияИсторииСтоимостиОС.Переоценка") Тогда
		ЧастиШаблона = Новый Массив;
		Если ЗначениеЗаполнено(ТекущаяСтрока.ОсновнойКоэффициент)
			Или ЗначениеЗаполнено(ТекущаяСтрока.ПоправочныйКоэффициент) Тогда
			ЧастиШаблона.Добавить(НСтр("ru = 'Коэф.: %1/%2'"));
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекущаяСтрока.ГруппаОФ) Тогда
			ЧастиШаблона.Добавить(НСтр("ru = 'Группа: %3'"));
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекущаяСтрока.ДооценкаАмортизации) Тогда
			ЧастиШаблона.Добавить(НСтр("ru = 'Ам.: %4'"));
		КонецЕсли;
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			СтрСоединить(ЧастиШаблона, "; "),
			ТекущаяСтрока.ОсновнойКоэффициент, ТекущаяСтрока.ПоправочныйКоэффициент,
			ТекущаяСтрока.ГруппаОФ, ТекущаяСтрока.ДооценкаАмортизации);
	Иначе
		Текст = "";
	КонецЕсли;
	
	ТекущаяСтрока.ПредставлениеПереоценка = Текст;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеКапРемонт(ТекущаяСтрока)
	
	ТекущаяСтрока.ДатаГТЗаголовок			= НСтр("ru = 'Дата:'");
	ТекущаяСтрока.СрокДействияГТЗаголовок	= НСтр("ru = 'Срок действия:'");
	ТекущаяСтрока.НомерГТЗаголовок			= НСтр("ru = 'Номер:'");
	ТекущаяСтрока.НаименованиеГТЗаголовок   = НСтр("ru = 'Вид:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеРасходыУСН(ТекущаяСтрока, ВалютаРубли)
	
	ТекущаяСтрока.ЗаголовокРубли		= Строка(ВалютаРубли);
	ТекущаяСтрока.ЗаголовокДатаОплаты	= НСтр("ru = 'Дата оплаты:'");
	
КонецПроцедуры

&НаСервере
Процедура СоздатьНедостающиеСтроки()
	
	Если Не ГрупповойУчет Тогда
		Если Объект.ИнвентарныеОбъекты.Количество() = 0 Тогда
			Объект.ИнвентарныеОбъекты.Добавить();
		Конецесли;
	КонецЕсли;
	
	Если Не Объект.ОтражатьИсторию Или Объект.ИнвентарныйУчет = 1 Тогда
		Если Объект.СтоимостьИАмортизация.Количество() = 0 Тогда
			СтрокаСтоимостьИАмортизация = Объект.СтоимостьИАмортизация.Добавить();
			СтрокаСтоимостьИАмортизация.Событие = Перечисления.ВидыСобытийОС.ПринятиеКУчету;
			СтрокаСтоимостьИАмортизация.СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(АмортизационнаяГруппа);
		ИначеЕсли Объект.СтоимостьИАмортизация[0].СрокПолезногоИспользования = 0 Тогда
			Объект.СтоимостьИАмортизация[0].СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(АмортизационнаяГруппа);
		КонецЕсли;
	Конецесли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовкиИДоступностьСубконтоСчетаЗатрат()
	
	МассивПолей = Новый Массив;
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Подразделение", "ПодразделениеЗатрат", "ПодразделениеЗатрат", Истина, "ПодразделениеЗатрат", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоЗатрат1", "СубконтоЗатрат1", Истина, "СубконтоЗатрат1", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоЗатрат2", "СубконтоЗатрат2", Истина, "СубконтоЗатрат2", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоЗатрат3", "СубконтоЗатрат3", Истина, "СубконтоЗатрат3", Истина, Истина, Истина);
	
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетУчетаЗатрат, ЭтаФорма, Объект, МассивПолей);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКомментарийСрокаПолезногоИспользования(БУилиНУ = Неопределено)
	
	Если БУилиНУ = Неопределено  Тогда
		// и БУ и НУ
		СрокПолезногоИспользования = ?(Объект.СтоимостьИАмортизация.Количество() > 0, Объект.СтоимостьИАмортизация[0].СрокПолезногоИспользования, 0);
		СрокПолезногоИспользованияКомментарийБУ =
			УправлениеОсновнымиСредствамиКлиентСервер.РасшифровкаСрокаПолезногоИспользования(СрокПолезногоИспользования);
		СрокПолезногоИспользованияКомментарийНУ =
			УправлениеОсновнымиСредствамиКлиентСервер.РасшифровкаСрокаПолезногоИспользования(Объект.СрокПолезногоИспользованияНУ);
		СрокПолезногоИспользованияКомментарийУСН =
			УправлениеОсновнымиСредствамиКлиентСервер.РасшифровкаСрокаПолезногоИспользования(Объект.СрокПолезногоИспользованияУСН);
	ИначеЕсли БУилиНУ = "НУ" Тогда
		// только НУ
		СрокПолезногоИспользованияКомментарийНУ =
			УправлениеОсновнымиСредствамиКлиентСервер.РасшифровкаСрокаПолезногоИспользования(Объект.СрокПолезногоИспользованияНУ);
		СрокПолезногоИспользованияКомментарийУСН =
			УправлениеОсновнымиСредствамиКлиентСервер.РасшифровкаСрокаПолезногоИспользования(Объект.СрокПолезногоИспользованияУСН);
	Иначе
		// только БУ
		СрокПолезногоИспользования = ?(Объект.СтоимостьИАмортизация.Количество() > 0, Объект.СтоимостьИАмортизация[0].СрокПолезногоИспользования, 0);
		СрокПолезногоИспользованияКомментарийБУ =
			УправлениеОсновнымиСредствамиКлиентСервер.РасшифровкаСрокаПолезногоИспользования(СрокПолезногоИспользования);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовНУ()
	
	Если Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации") Тогда
		
		Элементы["ГруппаПорядокВключенияСтоимостиВСоставРасходовНУ"].ТекущаяСтраница =
			Элементы["СтраницаОСННачислениеАмортизацииНУ"];
		
	ИначеЕсли Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету") Тогда
		
		Элементы["ГруппаПорядокВключенияСтоимостиВСоставРасходовНУ"].ТекущаяСтраница =
			Элементы["СтраницаОСНВключениеВРасходыПриПринятииКУчету"];
		
	Иначе
		Элементы["ГруппаПорядокВключенияСтоимостиВСоставРасходовНУ"].ТекущаяСтраница =
			Элементы["СтраницаОСНСтоимостьНеВключаетсяВРасходы"];
			
	КонецЕсли;
	
	УстановитьВидимостьСтатьиПрочихРасходовНУ();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуВЗависимостиОтМетодНачисленияАмортизацииНУ()
	
	Доступность2009 = (Объект.МетодНачисленияАмортизацииНУ <> ПредопределенноеЗначение("Перечисление.МетодыНачисленияАмортизации.Линейный"));
	Элементы.АмортизацияДо2009.Доступность					= Доступность2009;
	Элементы.ФактическийСрокИспользованияДо2009.Доступность	= Доступность2009;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьСтатьиПрочихРасходовНУ()
	
	ДоступностьСтатьиПрочихРасходов = ОтражатьВНалоговомУчете И Объект.ОтражатьВНалоговомУчете
		И НалоговыйУчетКлиентСервер.ЭтоПрочиеРасходы(Объект.СчетУчетаЗатрат);
		
	Элементы.ГруппаСтатьяПрочихРасходовНУ.Видимость = ДоступностьСтатьиПрочихРасходов
		И (Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации")
		Или Объект.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету"));
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовУСН()
	
	Если Объект.ПорядокВключенияСтоимостиВСоставРасходовУСН =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА") Тогда
		
		Элементы["ГруппаСтраницыВключениеСтоимостиВСоставРасходовУСН"].ТекущаяСтраница =
			Элементы["ГруппаВключитьВСоставРасходовНаОСиНМАприУСН"];
		Элементы["ГруппаРасходыУСН"].Видимость = Истина;
		Элементы["РасходыУСНРасходыПроизведеныДоПереходаНаУСН"].Видимость = Истина;
		
	ИначеЕсли Объект.ПорядокВключенияСтоимостиВСоставРасходовУСН =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставМатериальныхРасходов") Тогда
		
		Элементы["ГруппаСтраницыВключениеСтоимостиВСоставРасходовУСН"].ТекущаяСтраница =
			Элементы["ГруппаВключитьВСоставМатериальныхРасходовУСН"];
		Элементы["ГруппаРасходыУСН"].Видимость = Истина;
		Элементы["РасходыУСНРасходыПроизведеныДоПереходаНаУСН"].Видимость = Ложь;
		
	ИначеЕсли Объект.ПорядокВключенияСтоимостиВСоставРасходовУСН =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.НеВключатьВСоставРасходов") Тогда
		
		Элементы["ГруппаСтраницыВключениеСтоимостиВСоставРасходовУСН"].ТекущаяСтраница =
			Элементы["ГруппаНеВключатьВСоставРасходовУСН"];
		Элементы["ГруппаРасходыУСН"].Видимость = Ложь;
		
	Иначе
		Элементы["ГруппаСтраницыВключениеСтоимостиВСоставРасходовУСН"].ТекущаяСтраница =
			Элементы["ГруппаПорядокВключенияСтоимостиВСоставРасходовНеУказанУСН"];
		Элементы["ГруппаРасходыУСН"].Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДействующуюРедакцию()
	
	ДействующаяРедакция = Документы.ВводНачальныхОстатковОС.ПустаяСсылка();
	
	Если Объект.Проведен Тогда
		
		ДействующаяРедакцияНайдена = Ложь;
		Основание = Объект.Ссылка;
		
		Запрос = Новый Запрос;
		Запрос.Текст =		
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВводНачальныхОстатковОС.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВводНачальныхОстатковОС КАК ВводНачальныхОстатковОС
		|ГДЕ
		|	ВводНачальныхОстатковОС.ДокументОснование = &Основание
		|	И ВводНачальныхОстатковОС.Проведен";
		
		Пока Не ДействующаяРедакцияНайдена Цикл
			
			Запрос.УстановитьПараметр("Основание", Основание);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Основание = Выборка.Ссылка;
			Иначе
				Если Основание <> Объект.Ссылка Тогда
					ДействующаяРедакция = Основание;
				КонецЕсли;
				ДействующаяРедакцияНайдена = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Элементы.ГруппаНеДействующаяРедакцияДокумента.Видимость = ЗначениеЗаполнено(ДействующаяРедакция);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуДополнительныхСведений(Элемент, ЭлементТаблица)
	
	ТекущиеДанные = ЭлементТаблица.ТекущиеДанные;
	
	ИменаРеквизитов = "РасчетАмортизацииВручную,СрокИспользованияДляВычисленияАмортизации,СтоимостьДляВычисленияАмортизации,
		|КоэффициентУскорения,ПараметрВыработки,ПредполагаемыйОбъемВыработки";
		
	ДанныеТекущейСтроки = Новый Структура(ИменаРеквизитов);
	ЗаполнитьЗначенияСвойств(ДанныеТекущейСтроки, ТекущиеДанные);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СпособНачисленияАмортизации"		, ТекущиеДанные.СпособНачисленияАмортизации); 
	ПараметрыФормы.Вставить("ДанныеТекущейСтроки"				, ДанныеТекущейСтроки);
	ПараметрыФормы.Вставить("СписокРеквизитовСтрокиДокумента"	, ИменаРеквизитов);
	
	ОткрытьФорму("Документ.ВводНачальныхОстатковОС.Форма.ФормаДополнительныеСведения", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументПоОснованию()
	
	Режим = Новый Структура("ОтражатьВБухгалтерскомУчете,ОтражатьВНалоговомУчете,ОтражатьИсторию,УчетныеДанныеПодробно");
	ЗаполнитьЗначенияСвойств(Режим, Объект);
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	ДокОбъект.Заполнить(Объект.ДокументОснование);
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
	
	ЗаполнитьЗначенияСвойств(Объект, Режим);
	
	ПодготовитьФормуНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументПоДаннымБухУчета()
	
	Документы.ВводНачальныхОстатковОС.ЗаполнитьПоДаннымБухУчета(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРеквизитыПринятияКУчетуСтоимость(ТекущиеДанные)
	
	ТекущиеДанные.Период					= Объект.ДатаПринятияКУчету;
	ТекущиеДанные.ВидПервичногоДокумента	= Объект.ДокументПринятияВид;
	ТекущиеДанные.ДатаПервичногоДокумента	= Объект.ДокументПринятияДата;
	ТекущиеДанные.НомерПервичногоДокумента	= Объект.ДокументПринятияНомер;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРеквизитыПринятияКУчетуМестонахождение(ТекущиеДанные)
	
	ТекущиеДанные.Период			= Объект.ДатаПринятияКУчету;
	ТекущиеДанные.НазваниеДокумента	= Объект.ДокументПринятияВид;
	ТекущиеДанные.ДатаДокумента		= Объект.ДокументПринятияДата;
	ТекущиеДанные.НомерДокумента	= Объект.ДокументПринятияНомер;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОграничениеСчетаВПользовании(ТекущиеДанные)
	
	Если ТекущиеДанные.ВПользованииСостояниеОС = ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.СдачаВАренду") Тогда
		КодСчета = "25";
	ИначеЕсли ТекущиеДанные.ВПользованииСостояниеОС = ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ПередачаВБезвозмездноеПользование") Тогда
		КодСчета = "26";
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ВПользованииСчет) Тогда
		НовыйКод = КодСчета + "." + Прав(ТекущиеДанные.ВПользованииСчет, 2);
		ТекущиеДанные.ВПользованииСчет = БухгалтерскийУчетВызовСервера.СчетПоКоду(НовыйКод);
	КонецЕсли;
	
	ОграниченияСписокСчетов = Новый Массив;
	ОграниченияСписокСчетов.Добавить(КодСчета);
	МассивПараметровВыбора = Новый Массив;
	МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("ОграниченияСписокСчетов", Новый ФиксированныйМассив(ОграниченияСписокСчетов)));
	Элементы.ИнвентарныеОбъектыВПользованииСчет.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	
КонецПроцедуры

