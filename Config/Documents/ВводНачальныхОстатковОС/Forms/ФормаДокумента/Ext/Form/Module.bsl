&НаКлиенте
Процедура КонтрагентНачалоВыбора(Элемент, СтрокаТЧ, СтандартнаяОбработка)
	Если СтрокаТЧ.ВПользованииСостояниеОС 
		= ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ПередачаВЛичноеПользование") Тогда
		СтандартнаяОбработка = Ложь;
		
		Отбор = Новый Структура("Владелец", Объект.Организация);
		ПараметрыФормы = Новый Структура("Отбор", Отбор);

		Если ЗначениеЗаполнено(СтрокаТЧ.ВПользованииКонтрагент) Тогда		
			ТекСотрудник = СотрудникПоКонтрагенту(СтрокаТЧ.ВПользованииКонтрагент, Объект.Организация);
			ПараметрыФормы.Вставить("ТекущаяСтрока", ТекСотрудник);
		КонецЕсли;	
		
		ОткрытьФорму("Справочник.Сотрудники.ФормаВыбора", ПараметрыФормы, Элемент);
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура КонтрагентОбработкаВыбора(ВыбранноеЗначение, СтрокаТЧ, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(ВыбранноеЗначение) И 
		ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Сотрудники") Тогда
		СтандартнаяОбработка = Ложь;
		СтрокаТЧ.ВПользованииКонтрагент = ПолучитьРеквизитИзСсылки(ВыбранноеЗначение, "Контрагент");
	КонецЕсли;	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция СотрудникПоКонтрагенту(ТекКонтрагент, ТекОрганизация)
	Результат = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Контрагент = &Контрагент
	|	И Сотрудники.Владелец = &Организация";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", ТекОрганизация);
	Запрос.УстановитьПараметр("Контрагент", ТекКонтрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

// Работа формы

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьФункциональныеОпцииФормы();
	ОбновитьФормуПоОсновномуСредству();
	ИнициализироватьПараметрыФормы();
	
	ТекущаяДатаДокумента = Объект.Дата;
	
	ОбновитьТекстЗаголовковВсехТаблиц(Объект, ВалютаРубли);
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьПараметрыФормы()
	
	ОтражатьВНалоговомУчете =
		НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, КонецГода(Объект.Дата)+1, Объект.КФО);
	ОтражатьВУСНДоходыМинусРасходы =
		УчетУСНКлиентСервер.ОтражатьВУСНДоходыМинусРасходы(Объект.Организация, КонецГода(Объект.Дата)+1, Объект.КФО);
	
	ПараметрыУчета = Документы.ВводНачальныхОстатковОС.ПараметрыУчетаОбъектаОС(Объект.ОсновноеСредство, Объект.Дата);
	ВедетсяАналитическийУчет		= ПараметрыУчета.ВедетсяАналитическийУчет;
	ВедетсяНачислениеАмортизации	= ПараметрыУчета.ВедетсяНачислениеАмортизации;
	
	ВедетсяУчетПоЦМО = Не ЗначениеЗаполнено(Объект.СчетУчета)
		Или БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Объект.СчетУчета, ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	ВедетсяУчетПоДоговорам = ЗначениеЗаполнено(Объект.СчетУчета)
		И БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Объект.СчетУчета, ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФункциональныеОпцииФормы()
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрОрганизацияФункциональныхОпцийФормы(
		ЭтаФорма, Объект.Организация, КонецГода(Объект.Дата)+1);
	БухгалтерскиеОперацииСервер.ПриИзмененииПараметровФункциональныхОпций(Элементы.БухгалтерскаяОперация);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьФормуПоОсновномуСредству()
	
	Если ЗначениеЗаполнено(Объект.ОсновноеСредство) Тогда
		ЗначенияРеквизитов = ПолучитьЗначенияРеквизитовОсновногоСредства(Объект.ОсновноеСредство);
		ГрупповойУчет         = ЗначенияРеквизитов.ГрупповойУчет;
		АмортизационнаяГруппа = ЗначенияРеквизитов.АмортизационнаяГруппа;
		ВидНФА                = ЗначенияРеквизитов.ВидНФА;
		ИмуществоКазны        = ЗначенияРеквизитов.ИмуществоКазны;
		ЭтоБиблиотечныйФонд   = (
			ЗначенияРеквизитов.ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.БиблиотечныйФонд"));  
	Иначе
		ГрупповойУчет         = Ложь;
		АмортизационнаяГруппа = Перечисления.АмортизационныеГруппы.ПустаяСсылка();
		ВидНФА                = Перечисления.ВидыНФА.ПустаяСсылка();
		ИмуществоКазны        = Ложь;
		ЭтоБиблиотечныйФонд   = Ложь;
	КонецЕсли;
	
	СоздатьНедостающиеСтроки();
	
	ПолучитьДействующуюРедакцию();
	
	ТолькоПросмотр = (Объект.Проведен И ЗначениеЗаполнено(ДействующаяРедакция));
	Элементы.ГруппаДанные.ТолькоПросмотр = Объект.ЭтоАгрегаторДвижений;
	Элементы.СнятьПризнакАгрегатора.Доступность = Не ТолькоПросмотр;
	
	// Рассчитаем реквизиты состояния ОС в таблице "Инвентарные объекты".
	Для Каждого СтрокаТаблицы Из Объект.ИнвентарныеОбъекты Цикл
		
		// СостояниеОСвОрганизации
		Если СтрокаТаблицы.СостояниеОС = Перечисления.СостоянияОС.ПринятоКУчету Тогда
			СтрокаТаблицы.СостояниеОСвОрганизации = "БалансПринятоКУчету";
		ИначеЕсли СтрокаТаблицы.СостояниеОС = Перечисления.СостоянияОС.ВведеноВЭксплуатацию Тогда
			СтрокаТаблицы.СостояниеОСвОрганизации = "БалансВведеноВЭксплуатацию";
		ИначеЕсли СтрокаТаблицы.СостояниеОС = Перечисления.СостоянияОС.СнятоСУчета Тогда
			СтрокаТаблицы.СостояниеОСвОрганизации = ?(СтрокаТаблицы.НаСчете21, "НаСчете21", "Списано");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначенияРеквизитовОсновногоСредства(ОсновноеСредство)
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновноеСредство,
		"ГрупповойУчет,АмортизационнаяГруппа,ВидНФА,ИмуществоКазны,ТипНФА");
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

&НаСервереБезКонтекста
Функция СостоянияОСвОрганизации()
	
	Список = Новый СписокЗначений;
	Список.Добавить("БалансПринятоКУчету"		, НСтр("ru = 'Принят к учету (счета 101,102,103,108)'"));
	Список.Добавить("БалансВведеноВЭксплуатацию", НСтр("ru = 'Введен в эксплуатацию (счета 101,102,103,108)'"));
	Список.Добавить("НаСчете21"					, НСтр("ru = 'Списан при вводе в эксплуатацию (счет 21)'"));
	Список.Добавить("Списано"					, НСтр("ru = 'Выбыл с учета'"));
	
	Возврат Список;
	
КонецФункции

&НаСервереБезКонтекста
Функция СостоянияОСвПользовании()
	
	Список = Новый СписокЗначений;
	Список.Добавить(Перечисления.ВидыСобытийОС.ПустаяСсылка() , НСтр("ru = 'Не передавался'"));
	Список.Добавить(Перечисления.ВидыСобытийОС.СдачаВАренду , НСтр("ru = 'Передан в аренду (счет 25)'"));
	Список.Добавить(Перечисления.ВидыСобытийОС.ПередачаВБезвозмездноеПользование, 
		НСтр("ru = 'Передан в безвозмездное пользование (счет 26)'"));
	Список.Добавить(Перечисления.ВидыСобытийОС.ПередачаВЛичноеПользование, 
		НСтр("ru = 'Передан в личное пользование (счет 27.01)'"));
	
	Возврат Список;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокВыбораЭлемента(Элемент, СписокВыбора)
	
	Элемент.СписокВыбора.Очистить();
	Для Каждого ЭлементСписка Из СписокВыбора Цикл
		Элемент.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	ОтражатьВБухгалтерскомУчете = Объект.ОтражатьВБухгалтерскомУчете
		Или (Не Объект.ОтражатьВНалоговомУчете И Не Объект.ОтражатьИсторию);
	
	УчетСИнвентарнымиНомерами = (Объект.ИнвентарныйУчет = 0);
	УчетГруппыБезИнвНомеров = ГрупповойУчет И Не УчетСИнвентарнымиНомерами;
	
	// Видимость страниц.
	Элементы.СтраницаАмортизация.Видимость				= ВедетсяНачислениеАмортизации И (ОтражатьВБухгалтерскомУчете Или Объект.ОтражатьИсторию И УчетГруппыБезИнвНомеров);
	Элементы.СтраницаСтоимостьИАмортизация.Видимость	= Объект.ОтражатьИсторию И Не УчетГруппыБезИнвНомеров;
	Элементы.СтраницаМестонахождение.Видимость			= Объект.ОтражатьИсторию И ВедетсяУчетПоЦМО;
	Элементы.СтраницаКапитальныйРемонт.Видимость		= Объект.ОтражатьИсторию;
	Элементы.СтраницаДрагМатериалы.Видимость			= Объект.ОтражатьИсторию;
	Элементы.СтраницаКонсервация.Видимость				= Объект.ОтражатьИсторию;
	
	Элементы.ГруппаПараметрыПогашенияСтоимости.Видимость = Не Элементы.СтраницаСтоимостьИАмортизация.Видимость;
	
	// Настройка формы в зависимости от способа учета: индивидуальный учет / групповой учет.
	Элементы.ИнвентарныйНомер.Видимость					= Не ГрупповойУчет И ВедетсяАналитическийУчет;
	Элементы.ИнвентарныйУчет.Видимость					= ГрупповойУчет Или Не ВедетсяАналитическийУчет;
	Элементы.ИнвентарныйУчет.ТолькоПросмотр				= Не ВедетсяАналитическийУчет;
	Элементы.СтраницаИндУчет.Видимость					= Не ГрупповойУчет;
	Элементы.СтраницаГрупУчет.Видимость					= ГрупповойУчет; 
	Элементы.СтраницаИнвентарныеОбъекты.Видимость		= ГрупповойУчет;
	
	Элементы.ИнвентарныеОбъектыИнвентарныйНомер.Видимость	= УчетСИнвентарнымиНомерами;
	Элементы.ИнвентарныеОбъектыЦМО.Видимость				= ВедетсяУчетПоЦМО;
	Элементы.ИнвентарныеОбъектыГруппаСобытия.Видимость		= (Не ГрупповойУчет Или УчетСИнвентарнымиНомерами);
	
	Элементы.МестонахождениеСобытие.Видимость		= УчетГруппыБезИнвНомеров;
	Элементы.МестонахождениеСобытиеСокр.Видимость	= Не УчетГруппыБезИнвНомеров;
	Элементы.МестонахождениеПериодСлева.Видимость	= Не УчетГруппыБезИнвНомеров;
	Элементы.МестонахождениеПериодСправа.Видимость	= УчетГруппыБезИнвНомеров;
	Элементы.МестонахождениеКоличество.Видимость	= УчетГруппыБезИнвНомеров;
	Элементы.МестонахождениеСумма.Видимость			= УчетГруппыБезИнвНомеров;
	
	ПодсказкаМестонахождение = Новый Массив;
	ПодсказкаМестонахождение.Добавить(НСтр("ru = 'История изменения местонахождения инвентарных объектов до даты ввода начальных остатков.'"));
	Если УчетГруппыБезИнвНомеров Тогда
		ПодсказкаМестонахождение.Добавить(НСтр("ru = 'Укажите операции поступления и выбытия объектов: принятие к учету, внутренние перемещения, выбытие с учета.'"));
	Иначе
		ПодсказкаМестонахождение.Добавить(НСтр("ru = 'Укажите местонахождение объекта (объектов) на дату принятия к учету и внутренние перемещения.'"));
	КонецЕсли;
	Элементы.Местонахождение.Подсказка = СтрСоединить(ПодсказкаМестонахождение, Символы.ПС);
	
	Элементы.ИнвентарныеОбъектыГруппаОбъектОС.Заголовок = ?(УчетГруппыБезИнвНомеров, "Состояние", "Объект ОС, НМА, НПА");
	
	Элементы.СтоимостьИАмортизацияИнвентарныйНомер.Видимость= (ГрупповойУчет И УчетСИнвентарнымиНомерами);
	Элементы.МестонахождениеИнвентарныйНомер.Видимость		= (ГрупповойУчет И УчетСИнвентарнымиНомерами);
	Элементы.КапитальныйРемонтИнвентарныйНомер.Видимость	= (ГрупповойУчет И УчетСИнвентарнымиНомерами);
	Элементы.ДрагМатериалыИнвентарныйНомер.Видимость		= (ГрупповойУчет И УчетСИнвентарнымиНомерами);
	Элементы.КонсервацияИнвентарныйНомер.Видимость			= (ГрупповойУчет И УчетСИнвентарнымиНомерами);
	
	Элементы.СтоимостьИАмортизацияГруппаПогашениеСтоимости.Видимость = ВедетсяНачислениеАмортизации;
	Элементы.СтоимостьУчетГруппаАмортизация.Видимость = ВедетсяНачислениеАмортизации;
	
	Элементы.ДоговорГрупп.Видимость = ВедетсяУчетПоДоговорам;
	
	// Если вводим остатки только по НУ, следующие реквизиты БУ доступны только на просмотр.
	ЭлементыБУ = Новый Массив;
	ЭлементыБУ.Добавить("ГруппаСчет");
	ЭлементыБУ.Добавить("НомерИнвентарнойКарточки");
	ЭлементыБУ.Добавить("ГруппаСведенияОбОбъектеИндУчет");
	ЭлементыБУ.Добавить("ГруппаСобытияИндУчет");
	ЭлементыБУ.Добавить("ГруппаБалансСуммыБУИнд");
	ЭлементыБУ.Добавить("ГруппаЗабалансИнд");
	
	ЭлементыБУ.Добавить("ГруппаСобытияГруппУчет");
	ЭлементыБУ.Добавить("ГруппаБалансСуммыБУГрупп");
	ЭлементыБУ.Добавить("ГруппаЗабалансГрупп");
	
	ЭлементыБУ.Добавить("ИнвентарныеОбъектыГруппаОбъектОС");
	ЭлементыБУ.Добавить("ИнвентарныеОбъектыГруппаМестонахождение");
	ЭлементыБУ.Добавить("ИнвентарныеОбъектыГруппаКоличество");
	ЭлементыБУ.Добавить("ИнвентарныеОбъектыГруппаСтоимость");
	ЭлементыБУ.Добавить("ИнвентарныеОбъектыВПользовании");
	ЭлементыБУ.Добавить("ИнвентарныеОбъектыГруппаСобытия");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыБУ, "ТолькоПросмотр", Объект.ОтражатьВНалоговомУчете И Не Объект.ОтражатьВБухгалтерскомУчете И Не Объект.ОтражатьИсторию);		
	
	// Если вводим остатки по НУ или истории, следующие реквизиты БУ доступны только на просмотр.
	ЭлементыБУТолькоПросмотр = Новый Массив;
	ЭлементыБУТолькоПросмотр.Добавить("ГруппаБалансСуммыБУИнд");
	ЭлементыБУТолькоПросмотр.Добавить("ГруппаБалансСуммыБУГрупп");
	ЭлементыБУТолькоПросмотр.Добавить("ГруппаСчет");
	ЭлементыБУТолькоПросмотр.Добавить("ГруппаСведенияОбОбъектеИндУчет");
	ЭлементыБУТолькоПросмотр.Добавить("ИнвентарныеОбъектыГруппаСтоимость");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыБУТолькоПросмотр, "ТолькоПросмотр", (Объект.ОтражатьВНалоговомУчете Или Объект.ОтражатьИсторию) И Не Объект.ОтражатьВБухгалтерскомУчете);
	
	// Если вводим только историю, следующие реквизиты должны быть доступны для редактирования.
	ЭлементыБУ = Новый Массив;
	ЭлементыБУ.Добавить("ГруппаСобытияДокументы");
	ЭлементыБУ.Добавить("ДокументПринятияНомерГрупп");
	ЭлементыБУ.Добавить("ДокументПринятияДатаГрупп");
	ЭлементыБУ.Добавить("ДокументПринятияВидГрупп");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыБУ, "ТолькоПросмотр", Не ОтражатьВБухгалтерскомУчете И Не Объект.ОтражатьИсторию);
	
	Элементы.НомерИнвентарнойКарточки.ТолькоПросмотр = Не (ОтражатьВБухгалтерскомУчете Или Объект.ОтражатьИсторию);
	
	// Если вводим только историю, следующие реквизиты должны быть доступны только на просмотр.
	ЭлементыБУ = Новый Массив;
	ЭлементыБУ.Добавить("ГруппаСчет");
	ЭлементыБУ.Добавить("СчетАмортизацииИнд");
	ЭлементыБУ.Добавить("ГруппаСобытияДаты");
	ЭлементыБУ.Добавить("ПервоначальноеКоличествоИнд");
	ЭлементыБУ.Добавить("ПервоначальнаяСтоимостьИнд");
	ЭлементыБУ.Добавить("ПервоначальнаяСуммаАмортизацииИнд");
	ЭлементыБУ.Добавить("ДатаПринятияКУчетуГрупп");
	ЭлементыБУ.Добавить("ПервоначальноеКоличествоГрупп");
	ЭлементыБУ.Добавить("ПервоначальнаяСтоимостьГрупп");
	ЭлементыБУ.Добавить("ПервоначальнаяСуммаАмортизацииГрупп");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыБУ, "ТолькоПросмотр", Объект.ОтражатьИсторию И Не Объект.ОтражатьВБухгалтерскомУчете И Не Объект.ОтражатьВНалоговомУчете);	
	
	// Счета показываем только в режиме "Подробно".
	// Количество и стоимость в пользовании показываем только в режиме "Подробно".
	ЭлементыПодробно = Новый Массив;
	ЭлементыПодробно.Добавить("ГруппаЗабалансИндСчета");
	ЭлементыПодробно.Добавить("ИнвентарныеОбъектыСчет21");
	ЭлементыПодробно.Добавить("ИнвентарныеОбъектыСчетАмортизации");
	ЭлементыПодробно.Добавить("ИнвентарныеОбъектыПараметрыОбъектовВПользовании");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыПодробно, "Видимость", Объект.ОтражатьВБухгалтерскомУчете И Объект.УчетныеДанныеПодробно);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СчетАмортизацииИнд",
		"Видимость", Объект.ОтражатьВБухгалтерскомУчете И Не ГрупповойУчет И Объект.УчетныеДанныеПодробно);
	
	Если Объект.СтоимостьИАмортизация.Количество() > 0 Тогда
		УстановитьВидимостьЭлементовОтПорядкаПогашенияСтоимости();
		УстановитьВидимостьПараметровРасчетаАмортизации();
	КонецЕсли;
	
	Элементы.ПервоначальноеКоличествоГрупп.ОтметкаНезаполненного = НЕ ЭтоБиблиотечныйФонд;
	Элементы.ПервоначальноеКоличествоГрупп.АвтоОтметкаНезаполненного = НЕ ЭтоБиблиотечныйФонд;
	Элементы.МестонахождениеКоличество.ОтметкаНезаполненного = НЕ ЭтоБиблиотечныйФонд;
	Элементы.МестонахождениеКоличество.АвтоОтметкаНезаполненного = НЕ ЭтоБиблиотечныйФонд;
	ЭлементыПодробно = Новый Массив;
	ЭлементыПодробно.Добавить("ГруппаНадписьДляБиблиотечногоФонда");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыПодробно, "Видимость", ЭтоБиблиотечныйФонд);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементовОтПорядкаПогашенияСтоимости()
	
	НачислениеАмортизации = (Объект.СтоимостьИАмортизация[0].ПорядокПогашенияСтоимости
			= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации"));
	СписаниеПриВводеВЭксплуатацию = (Объект.СтоимостьИАмортизация[0].ПорядокПогашенияСтоимости 
			= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию"));
		
	Элементы.СпособНачисленияАмортизации.Видимость = НачислениеАмортизации;	
	Элементы.ГруппаСчетЗатратБУиНУ.Видимость = Не Элементы.ГруппаПараметрыПогашенияСтоимости.Видимость
		Или НачислениеАмортизации Или СписаниеПриВводеВЭксплуатацию;
	
	УстановитьВидимостьЭлементовОтСпособаНачисления();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементовОтСпособаНачисления()
	
	Метод = Объект.СтоимостьИАмортизация[0].СпособНачисленияАмортизации;
	
	Если Метод = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный") Тогда
		
		ПродолжительноеНачислениеАмортизации		= Истина;
		Элементы.ГруппаСПИ.Видимость				= Истина;
		Элементы.КоэффициентУскорения.Видимость		= Ложь;
		Элементы.ГруппаВыработка.Видимость			= Ложь;
		
	ИначеЕсли Метод = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка") Тогда
		
		ПродолжительноеНачислениеАмортизации		= Истина;
		Элементы.ГруппаСПИ.Видимость				= Истина;
		Элементы.КоэффициентУскорения.Видимость		= Истина;
		Элементы.ГруппаВыработка.Видимость			= Ложь;
		
	ИначеЕсли Метод = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции") Тогда
		
		ПродолжительноеНачислениеАмортизации		= Истина;
		Элементы.ГруппаСПИ.Видимость				= Ложь;
		Элементы.ГруппаВыработка.Видимость			= Истина;
		
	Иначе
		
		ПродолжительноеНачислениеАмортизации		= Ложь;
		Элементы.ГруппаСПИ.Видимость				= Ложь;
		Элементы.ГруппаВыработка.Видимость			= Ложь;
		
	КонецЕсли;
	
	Если Объект.ОтражатьИсторию Тогда
		Элементы.НачислятьАмортизацию.Видимость = Истина;
	Иначе
		Элементы.НачислятьАмортизацию.Видимость = ПродолжительноеНачислениеАмортизации;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПараметровРасчетаАмортизации()
	
	Вручную = Объект.СтоимостьИАмортизация[0].РасчетАмортизацииВручную;
	
	Элементы.РасчетАмортизацииСтоимость.ТолькоПросмотр = Не Вручную;
	Элементы.РасчетАмортизацииСрокИспользования.ТолькоПросмотр = Не Вручную;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементовИнд()
	
	Если Объект.ИнвентарныеОбъекты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Объект.ИнвентарныеОбъекты[0];
	
	Принято   = (ТекущиеДанные.СостояниеОСвОрганизации = "БалансПринятоКУчету");
	Введено   = (ТекущиеДанные.СостояниеОСвОрганизации = "БалансВведеноВЭксплуатацию");
	Списано   = (ТекущиеДанные.СостояниеОСвОрганизации = "Списано" 
		Или ТекущиеДанные.СостояниеОСвОрганизации = "НаСчете21");
	НаСчете25 = (ТекущиеДанные.ВПользованииСостояниеОС = 
		ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.СдачаВАренду"));
	НаСчете26 = (ТекущиеДанные.ВПользованииСостояниеОС = 
		ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ПередачаВБезвозмездноеПользование"));
	НаСчете27 = (ТекущиеДанные.ВПользованииСостояниеОС = 
		ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ПередачаВЛичноеПользование"));
	
	ЭлементыИнд = Новый Массив;
	ЭлементыИнд.Добавить("ДатаПринятияКУчетуИнд");
	ЭлементыИнд.Добавить("ДокументПринятияНомерИнд");
	ЭлементыИнд.Добавить("ДокументПринятияДатаИнд");
	ЭлементыИнд.Добавить("ДокументПринятияВидИнд");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыИнд, "ТолькоПросмотр", Не (Принято Или Введено Или Списано));
	
	ЭлементыИнд = Новый Массив;
	ЭлементыИнд.Добавить("ДатаВводаВЭксплуатациюИнд");
	ЭлементыИнд.Добавить("ДокументВводаНомерИнд");
	ЭлементыИнд.Добавить("ДокументВводаДатаИнд");
	ЭлементыИнд.Добавить("ДокументВводаВидИнд");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыИнд, "ТолькоПросмотр", Не (Введено Или Списано));
	
	ЭлементыИнд = Новый Массив;
	ЭлементыИнд.Добавить("ДатаСписанияИнд");
	ЭлементыИнд.Добавить("ДокументСписанияНомерИнд");
	ЭлементыИнд.Добавить("ДокументСписанияДатаИнд");
	ЭлементыИнд.Добавить("ГруппаСобытияСписаниеИнд");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыИнд, "ТолькоПросмотр", Не Списано);
	
	Элементы25 = Новый Массив;
	Элементы25.Добавить("Количество25Инд");
	Элементы25.Добавить("Стоимость25Инд");
	Элементы25.Добавить("Счет25Инд");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		Элементы25, "ТолькоПросмотр", Не (НаСчете25 И Объект.УчетныеДанныеПодробно));
	
	Элементы26 = Новый Массив;
	Элементы26.Добавить("Количество26Инд");
	Элементы26.Добавить("Стоимость26Инд");
	Элементы26.Добавить("Счет26Инд");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		Элементы26, "ТолькоПросмотр", Не (НаСчете26 И Объект.УчетныеДанныеПодробно));
	
	Элементы27 = Новый Массив;
	Элементы27.Добавить("Количество27Инд");
	Элементы27.Добавить("Стоимость27Инд");
	Элементы27.Добавить("Счет27Инд");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		Элементы27, "ТолькоПросмотр", Не (НаСчете27 И Объект.УчетныеДанныеПодробно));
	
	Элементы.КонтрагентИнд.ТолькоПросмотр = Не (НаСчете25 Или НаСчете26 Или НаСчете27);
	Элементы.ВидБезвозмездногоПоступленияИнд.Видимость = НаСчете26;
	
	Элементы.ЦМОИнд.Видимость = ВедетсяУчетПоЦМО;
	Элементы.ДоговорИнд.Видимость = ВедетсяУчетПоДоговорам;
	
	Элементы.НадписьБалансоваяИнд.Заголовок = ЗаголовокСтоимости(ТекущиеДанные.СостояниеОСвОрганизации);
	
	Если Не Объект.ОтражатьВБухгалтерскомУчете Тогда
		Элементы.ДатаПринятияКУчетуИнд.ТолькоПросмотр		= Истина;
		Элементы.ДатаВводаВЭксплуатациюИнд.ТолькоПросмотр	= Истина;
		Элементы.ДатаСписанияИнд.ТолькоПросмотр				= Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокСтоимости(Состояние) 
	
	Возврат ?(Состояние = "Списано" Или Состояние = "НаСчете21",
		НСтр("ru = 'При выбытии'"), НСтр("ru = 'Балансовая'")) + ":";
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьЭлементовНалоговогоУчета()
	
	Форма = ЭтаФорма;
	
	Если Объект.ИнвентарныеОбъекты.Количество() <> 0 Тогда
		ЭтоИндивидуальныйУчетНаСчете21 = НЕ Форма.ГрупповойУчет
			И Объект.ИнвентарныеОбъекты[0].НаСчете21;
		ЭтоИндивидуальныйУчетСписано = НЕ Форма.ГрупповойУчет
			И Объект.ИнвентарныеОбъекты[0].СостояниеОС = ПредопределенноеЗначение("Перечисление.СостоянияОС.СнятоСУчета");
	Иначе
		ЭтоИндивидуальныйУчетНаСчете21 = Ложь;
		ЭтоИндивидуальныйУчетСписано = Ложь;
	КонецЕсли;
	
	// Видимость элементов налогового учета по налогу на прибыль.
	ЭлементыНУ = Новый Массив;
	ЭлементыНУ.Добавить("СтраницаНалоговыйУчет");
	ЭлементыНУ.Добавить("НадписьСтоимостьНУИнд");
	ЭлементыНУ.Добавить("НадписьСтоимостьНУГрупп");
	ЭлементыНУ.Добавить("НадписьАмортизацияНУИнд");
	ЭлементыНУ.Добавить("ПервоначальнаяСтоимостьНУИнд");
	ЭлементыНУ.Добавить("ПервоначальнаяСтоимостьНУГрупп");
	ЭлементыНУ.Добавить("СуммаНУИнд");
	ЭлементыНУ.Добавить("СуммаНУГрупп");
	ЭлементыНУ.Добавить("СуммаАмортизацииНУИнд");
	ЭлементыНУ.Добавить("ГруппаНеУчитываетсяЕНВДИнд");
	ЭлементыНУ.Добавить("ГруппаНеУчитываетсяЕНВДГрупп");
	ЭлементыНУ.Добавить("ИнвентарныеОбъектыГруппаСтоимостьНУ");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ЭлементыНУ, "Видимость", Объект.ОтражатьВНалоговомУчете И Форма.ОтражатьВНалоговомУчете
			И НЕ ЭтоИндивидуальныйУчетНаСчете21 И НЕ ЭтоИндивидуальныйУчетСписано);
	
	// Видимость элементов налогового учета при УСН.
	Форма.Элементы.СтраницаНалоговыйУчетУСН.Видимость =
		Объект.ОтражатьВНалоговомУчете И Форма.ОтражатьВУСНДоходыМинусРасходы;
	
	// Видимость элементов в режиме ввода остатков только в НУ (УСН).
	ЭтоВводОстатковТолькоВНУ = (Объект.ОтражатьВНалоговомУчете И НЕ Объект.ОтражатьВБухгалтерскомУчете);
	ЭлементыТолькоВБУ = Новый Массив;
	ЭлементыТолькоВБУ.Добавить("СостояниеОСвПользованииИнд");
	ЭлементыТолькоВБУ.Добавить("КонтрагентИнд");
	ЭлементыТолькоВБУ.Добавить("Количество21Инд");
	ЭлементыТолькоВБУ.Добавить("Количество25Инд");
	ЭлементыТолькоВБУ.Добавить("Количество26Инд");
	ЭлементыТолькоВБУ.Добавить("Количество27Инд");
	ЭлементыТолькоВБУ.Добавить("Стоимость21Инд");
	ЭлементыТолькоВБУ.Добавить("Стоимость25Инд");
	ЭлементыТолькоВБУ.Добавить("Стоимость26Инд");
	ЭлементыТолькоВБУ.Добавить("Стоимость27Инд");
	ЭлементыТолькоВБУ.Добавить("Счет21Инд");
	ЭлементыТолькоВБУ.Добавить("Счет25Инд");
	ЭлементыТолькоВБУ.Добавить("Счет26Инд");
	ЭлементыТолькоВБУ.Добавить("Счет27Инд");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ЭлементыТолькоВБУ, "Видимость", НЕ ЭтоВводОстатковТолькоВНУ);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Таблица "Инвентарные объекты" (ИнвентарныеОбъекты).
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ИнвентарныеОбъектыСчет21");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ИнвентарныеОбъекты.СостояниеОСвОрганизации",
		ВидСравненияКомпоновкиДанных.НеРавно, "НаСчете21");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Суммы НУ заполняются только для принятых к учету объектов ОС.
	УстановитьУсловноеОформлениеРеквизитНеЗаполняется(Элементы.ИнвентарныеОбъектыСуммаНУ,
		"НеРавно", "БалансПринятоКУчету");
	УстановитьУсловноеОформлениеРеквизитНеЗаполняется(Элементы.ИнвентарныеОбъектыСуммаНеУчитываетсяНУ,
		"НеРавно", "БалансПринятоКУчету");
	УстановитьУсловноеОформлениеРеквизитНеЗаполняется(Элементы.ИнвентарныеОбъектыСуммаЕНВД,
		"НеРавно", "БалансПринятоКУчету");
	
	// Блок "Ввод в эксплуатацию" не заполняется для принятых к учету объектов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ИнвентарныеОбъектыДатаВводаВЭксплуатацию");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ИнвентарныеОбъектыДокументВводаВид");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ИнвентарныеОбъектыДокументВводаДата");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ИнвентарныеОбъектыДокументВводаНомер");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ИнвентарныеОбъекты.СостояниеОСвОрганизации",
		ВидСравненияКомпоновкиДанных.Равно, "БалансПринятоКУчету");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "-");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	// Блок "Списание" заполняется только для списанных объектов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ИнвентарныеОбъектыДатаСписания");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ИнвентарныеОбъектыДокументСписанияВид");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ИнвентарныеОбъектыПричинаСписания");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ИнвентарныеОбъектыДокументСписанияДата");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ИнвентарныеОбъектыДокументСписанияНомер");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ИнвентарныеОбъекты.СостояниеОС",
		ВидСравненияКомпоновкиДанных.НеРавно, Перечисления.СостоянияОС.СнятоСУчета);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "-");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
