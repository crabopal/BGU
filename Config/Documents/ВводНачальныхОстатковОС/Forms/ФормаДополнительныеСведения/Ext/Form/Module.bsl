
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.ДанныеТекущейСтроки);
	
	Если Параметры.Свойство("ЭтоПараметрыПереоценки") Тогда
		Элементы.ГруппаСПИ.Видимость		= Ложь;
		Элементы.ГруппаВыработка.Видимость	= Ложь;
		Заголовок = НСтр("ru = 'Параметры переоценки 2007 года'");
		Возврат;
	Иначе
		Элементы.ГруппаПереоценка.Видимость = Ложь;
	КонецЕсли;
	
	Пропорционально		= (Параметры.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции);
	УменьшаемогоОстатка	= (Параметры.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.УменьшаемогоОстатка);
	
	Элементы.ГруппаСПИ.Видимость			= Не Пропорционально;
	Элементы.КоэффициентУскорения.Видимость	= УменьшаемогоОстатка;
	Элементы.ГруппаВыработка.Видимость		= Пропорционально;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДоступностьРеквизитов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РасчетАмортизацииВручнуюПриИзменении(Элемент)
	
	ДоступностьРеквизитов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	ЗавершитьРедактирование();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции


&НаКлиенте
Процедура ДоступностьРеквизитов();
	
	Элементы.СрокИспользованияДляВычисленияАмортизации.ТолькоПросмотр	= Не РасчетАмортизацииВручную;
	Элементы.СтоимостьДляВычисленияАмортизации.ТолькоПросмотр			= Не РасчетАмортизацииВручную;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРедактирование()

	Модифицированность = Ложь;
	
	// Ключевой параметр СписокРеквизитовСтрокиДокумента содержит список реквизитов,
	// которые будут установлены в строке таб.части ОсновныеСредства.
	Результат = Новый Структура(Параметры.СписокРеквизитовСтрокиДокумента);
	ЗаполнитьЗначенияСвойств(Результат, ЭтотОбъект);
	
	ОповеститьОВыборе(Результат);

КонецПроцедуры

#КонецОбласти
