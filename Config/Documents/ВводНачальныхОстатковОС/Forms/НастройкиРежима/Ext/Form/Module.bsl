
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.ПараметрыРежима);
	
	Если ЗначениеЗаполнено(Организация) И ЗначениеЗаполнено(Дата) Тогда
		ПлательщикНалогаНаПрибыль =
			НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Организация, КонецГода(Дата)+1);
		ПрименяетсяУСНДоходыМинусРасходы =
			УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Организация, КонецГода(Дата)+1);
	КонецЕсли;
	
	ВстроеннаяСправка = Документы.ВводНачальныхОстатковОС.ПолучитьМакет("ВстроеннаяСправка").ПолучитьТекст();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьПодробно();
	УстановитьВидимостьРеквизитовИстории();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Документ.ВводНачальныхОстатковОС.Форма.ПомощникОбъединения" Тогда
		Модифицированность = Истина;
		ДокументОснование = ВыбранноеЗначение;
		УстановитьВидимостьРеквизитовИстории();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтражатьВБухгалтерскомУчетеПриИзменении(Элемент)
	
	НуженДокументОснования = ОтражатьИсторию И Не ОтражатьВБухгалтерскомУчете;
	Если НуженДокументОснования И Не ЗначениеЗаполнено(ДокументОснование) Тогда
		// Попытаемся найти документ-основание автоматически.
		ДокументОснование = НайтиДокументОснование();
	КонецЕсли;
	
	УстановитьВидимостьПодробно();
	УстановитьВидимостьРеквизитовИстории();

КонецПроцедуры

&НаКлиенте
Процедура ОтражатьИсториюПриИзменении(Элемент)

	НуженДокументОснования = ОтражатьИсторию И Не ОтражатьВБухгалтерскомУчете;
	Если НуженДокументОснования И Не ЗначениеЗаполнено(ДокументОснование) Тогда
		// Попытаемся найти документ-основание автоматически.
		ДокументОснование = НайтиДокументОснование();
	КонецЕсли;
	
	УстановитьВидимостьРеквизитовИстории();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиНачальныеОстаткиВНовыйДокументНажатие(Элемент)
	
	ПараметрыФормы = Новый Структура("ОсновноеСредство", ОсновноеСредство);	
	ОткрытьФорму("Документ.ВводНачальныхОстатковОС.Форма.ПомощникОбъединения", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ПроверитьИЗакрытьФорму();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	ПроверитьИЗакрытьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗакрытьФорму()
	
	//1. Проверка на повторный ввод начальных остатков в БУ.
	//2. Проверка на повторный ввод начальных остатков в НУ.
	//3. Должен быть выбран хотя бы один вид учета.
	//4. Если ввод истории без БУ (отдельным документом), то должен быть указан документ основание.
	//5. Если ввод начальных остатков НУ, то КФО из списка допустимых.
	
	Отказ = Ложь;
	
	Если Не ОтражатьВБухгалтерскомУчете И Не ОтражатьВНалоговомУчете И Не ОтражатьИсторию Тогда
		ТекстСообщения = НСтр("ru='Режим ввода остатков установлен некорректно.
			|Необходимо установить отражение документа хотя бы по одному виду учета.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);	
	ИначеЕсли ОтражатьВБухгалтерскомУчете Или ОтражатьВНалоговомУчете Тогда
		ПараметрыПроверки = Новый Структура("БухгалтерскийУчет, НалоговыйУчет, НалоговыйУчетУСН",
			ОтражатьВБухгалтерскомУчете,
			ОтражатьВНалоговомУчете И ПлательщикНалогаНаПрибыль,
			ОтражатьВНалоговомУчете И ПрименяетсяУСНДоходыМинусРасходы);
		ЕстьОстаткиПоОС = ЕстьОстаткиПоОсновномуСредству(ПараметрыПроверки);
		Если ЕстьОстаткиПоОС.ЕстьОстаткиБУ Тогда 
			ТекстСообщения = НСтр("ru='По объекту уже введены остатки в бухгалтерском учете.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;
		Если ЕстьОстаткиПоОС.ЕстьОстаткиНУ ИЛИ ЕстьОстаткиПоОС.ЕстьОстаткиУСН Тогда 
			ТекстСообщения = НСтр("ru='По объекту уже введены остатки в налоговом учете.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если ОтражатьВНалоговомУчете Тогда
		
		Если НЕ ПлательщикНалогаНаПрибыль И НЕ ПрименяетсяУСНДоходыМинусРасходы Тогда
			ТекстСообщения = НСтр("ru='Ввод остатков по налоговому учету не требуется.
				|
				|Остатки по налоговому учету вводятся, только если организация является плательщиком налога на прибыль, либо применяет УСН с объектом налогообложения ""Доходы, уменьшенные на величину расходов"".'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КФО) И Не Отказ Тогда // Проверим КФО.
			Если ПлательщикНалогаНаПрибыль И НЕ НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(КФО) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Налоговый учет (по налогу на прибыль) по КФО %1 не ведется.'"), КФО);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			ИначеЕсли ПрименяетсяУСНДоходыМинусРасходы И НЕ УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(КФО) ТОгда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Налоговый учет при УСН по КФО %1 не ведется.'"), КФО);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	НуженДокументОснования = ОтражатьИсторию И Не ОтражатьВБухгалтерскомУчете;
	Если НуженДокументОснования И Не ЗначениеЗаполнено(ДокументОснование) Тогда
		
		РезультатПроверки = ВозможенВводИсторииПоОсновномуСредству();
		Если РезультатПроверки.НетОстатковБУ Тогда
			ТекстСообщения = НСтр("ru='Выбранный объект ОС, НМА, НПА не отражался в бухгалтерском учете.
				|
				|Ввод (корректировка) исторических сведений доступен только для объектов ОС, НМА, НПА, остатки по которым введены документом ""Ввод начальных остатков ОС, НМА, НПА"".'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		ИначеЕсли РезультатПроверки.НетВводаОстатков Тогда
			ТекстСообщения = НСтр("ru='Выбранный объект ОС, НМА, НПА принят к учету после ввода начальных остатков по организации.
				|
				|Ввод (корректировка) исторических сведений доступен только для объектов ОС, НМА, НПА, остатки по которым введены документом ""Ввод начальных остатков ОС, НМА, НПА"".'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		Иначе
			ТекстСообщения = НСтр("ru='Для ввода (корректировки) истории сведений необходимо перенести информацию о начальных остатках в новый документ ""Ввод начальных остатков ОС, НМА, НПА"".'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если НуженДокументОснования Тогда
		ТекстВопроса = НСтр("ru = 'Заполнить документ данными из документа основания?'");
		Оповещение = Новый ОписаниеОповещения("ПроверитьИЗакрытьФормуЗавершение", ЭтаФорма);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);		
	Иначе		
		ПроверитьИЗакрытьФормуЗавершение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗакрытьФормуЗавершение(Результат = Неопределено, Параметры = Неопределено) Экспорт
	
	Если Не ОтражатьВБухгалтерскомУчете Тогда
		УчетныеДанныеПодробно = Ложь;
	КонецЕсли;
	
	Если Не ОтражатьИсторию Тогда
		ДокументОснование = Неопределено;
	КонецЕсли;
	
	Заполнить = (Результат = КодВозвратаДиалога.Да);
	
	ПараметрЗакрытия = Новый Структура;
	ПараметрЗакрытия.Вставить("ОтражатьВБухгалтерскомУчете"	, ОтражатьВБухгалтерскомУчете);
	ПараметрЗакрытия.Вставить("ОтражатьВНалоговомУчете"		, ОтражатьВНалоговомУчете);
	ПараметрЗакрытия.Вставить("ОтражатьИсторию"				, ОтражатьИсторию);
	ПараметрЗакрытия.Вставить("УчетныеДанныеПодробно"		, УчетныеДанныеПодробно);
	ПараметрЗакрытия.Вставить("ДокументОснование"			, ДокументОснование);
	ПараметрЗакрытия.Вставить("Заполнить"					, Заполнить);
	
	Модифицированность = Ложь;
	ОповеститьОВыборе(ПараметрЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПодробно()
	
	Элементы.УчетныеДанныеПодробно.Доступность = ОтражатьВБухгалтерскомУчете;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьРеквизитовИстории()
	
	НуженДокументОснования = ОтражатьИсторию И Не ОтражатьВБухгалтерскомУчете;
	Элементы.СтраницыДокументОснование.Видимость = НуженДокументОснования;
	Если НуженДокументОснования Тогда
		
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			Элементы.СтраницыДокументОснование.ТекущаяСтраница = ЭтаФорма.Элементы.СтраницаДокументОснованиеНайден;
		Иначе
			РезультатПроверки = ВозможенВводИсторииПоОсновномуСредству();
			Если РезультатПроверки.НетОстатковБУ Тогда
				Элементы.СтраницыДокументОснование.ТекущаяСтраница = ЭтаФорма.Элементы.СтраницаНеверныйОбъектОС;
				Элементы.КомментарийНеверныйОбъектНетОстатковБУ.Видимость    = Истина;
				Элементы.КомментарийНеверныйОбъектНетВводаОстатков.Видимость = Ложь;
			ИначеЕсли РезультатПроверки.НетВводаОстатков Тогда
				Элементы.СтраницыДокументОснование.ТекущаяСтраница = ЭтаФорма.Элементы.СтраницаНеверныйОбъектОС;
				Элементы.КомментарийНеверныйОбъектНетОстатковБУ.Видимость    = Ложь;
				Элементы.КомментарийНеверныйОбъектНетВводаОстатков.Видимость = Истина;
			Иначе
				Элементы.СтраницыДокументОснование.ТекущаяСтраница = ЭтаФорма.Элементы.СтраницаДокументОснованиеНеНайден;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВозможенВводИсторииПоОсновномуСредству()
	
	РезультатПроверки = Новый Структура("НетОстатковБУ, НетВводаОстатков", Ложь, Ложь);
	
	// 1. Ввод истории невозможен, если нет остатков по ОС в БУ
	// (нет учетных данных по ОС, есть только элемент справочника "Основные средства").
	ПараметрыПроверки = Новый Структура("БухгалтерскийУчет, НалоговыйУчет, НалоговыйУчетУСН", Истина, Ложь, Ложь);
	ЕстьОстаткиПоОС = ЕстьОстаткиПоОсновномуСредству(ПараметрыПроверки);
	РезультатПроверки.НетОстатковБУ = НЕ ЕстьОстаткиПоОС.ЕстьОстаткиБУ;
	
	// 2. Ввод истории возможен только по объектам, введенным вводом начальных остатков,
	// т.к. это история сведений "до ввода начальных остатков".
	// Если объект принят к учету в период ведения учета в ИБ, история по нему не вводится.
	РезультатПроверки.НетВводаОстатков = НетВводаНачальныхОстатковПоОсновномуСредству(ОсновноеСредство, Организация);
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Функция ЕстьОстаткиПоОсновномуСредству(ПараметрыПроверки)
	
	ПериодПроверки = ?(Проведен, Ссылка, КонецГода(Дата));
	
	Возврат Документы.ВводНачальныхОстатковОС.ЕстьОстаткиПоОсновномуСредству(
		ОсновноеСредство, ПериодПроверки, ПараметрыПроверки);
	
КонецФункции

&НаСервереБезКонтекста
Функция НетВводаНачальныхОстатковПоОсновномуСредству(ОсновноеСредство, Организация)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПервоначальныеСведенияОС.Регистратор
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет КАК ПервоначальныеСведенияОС
	|ГДЕ
	|	ПервоначальныеСведенияОС.Организация = &Организация
	|	И ПервоначальныеСведенияОС.ОсновноеСредство = &ОсновноеСредство
	|	И (ПервоначальныеСведенияОС.Регистратор ССЫЛКА Документ.ПринятиеКУчетуЗдания
	|			ИЛИ ПервоначальныеСведенияОС.Регистратор ССЫЛКА Документ.ПринятиеКУчетуЗданияИК
	|			ИЛИ ПервоначальныеСведенияОС.Регистратор ССЫЛКА Документ.ПринятиеКУчетуИК
	|			ИЛИ ПервоначальныеСведенияОС.Регистратор ССЫЛКА Документ.ПринятиеКУчетуОбъектаИК
	|			ИЛИ ПервоначальныеСведенияОС.Регистратор ССЫЛКА Документ.ПринятиеКУчетуОбъектаОС
	|			ИЛИ ПервоначальныеСведенияОС.Регистратор ССЫЛКА Документ.ПринятиеКУчетуОбъектовИК
	|			ИЛИ ПервоначальныеСведенияОС.Регистратор ССЫЛКА Документ.ПринятиеКУчетуОбъектовОС
	|			ИЛИ ПервоначальныеСведенияОС.Регистратор ССЫЛКА Документ.ПринятиеКУчетуОС)";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервере
Функция НайтиДокументОснование()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВводНачальныхОстатковОС.Ссылка
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС КАК ВводНачальныхОстатковОС
	|ГДЕ
	|	ВводНачальныхОстатковОС.ОсновноеСредство = &ОсновноеСредство
	|	И ВводНачальныхОстатковОС.Ссылка <> &Ссылка
	|	И ВводНачальныхОстатковОС.Проведен
	|	И (ВводНачальныхОстатковОС.ОтражатьВБухгалтерскомУчете
	|			ИЛИ ВводНачальныхОстатковОС.ОтражатьИсторию)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВводНачальныхОстатковОС.Дата УБЫВ";
