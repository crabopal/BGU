
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Состояние = Параметры.Состояние;
	
	Для Каждого КлючКоличество Из Параметры.Количества Цикл
		ЭтаФорма[КлючКоличество.Ключ] = СтрШаблон("(%1)", Строка(КлючКоличество.Значение));
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ОповеститьОВыборе(Состояние);
	
КонецПроцедуры

#КонецОбласти
