
#Область Переменные

&НаКлиенте
Перем ПараметрыОбработчикаОжидания, ИдентификаторЗадания;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Пользователи.ЭтоПолноправныйПользователь()  Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Парам = ИнициализацияПараметров();
	
	ИдентификаторЗадания = Парам.ИдентификаторЗадания;	
	ОтобразитьСостояние(Парам.Состояние);
	
	Если Парам.Состояние = "Выполняется" Тогда		
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НадписьПомощникНажатие(Элемент)
	
	ПараметрыФормы = Новый Структура("ПоказатьУстаревшиеРазделы", Истина);
	ОткрытьФорму("Обработка.ПомощникВводаНачальныхОстатков.Форма.Форма", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьЖурналРегистрацииНажатие(Элемент)

	ОткрытьФорму("Обработка.ЖурналРегистрации.Форма.ЖурналРегистрации");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиДанные(Команда)
	
	СведенияЗадания = ВыполнитьДлительнуюОперациюСервер();
		
	Если СведенияЗадания.Статус = "Выполнено" Тогда
		ВыполнитьПоЗавершениюДлительнойОперации();
	Иначе
		ИдентификаторЗадания = СведенияЗадания.ИдентификаторЗадания;
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		ОтобразитьСостояние("Выполняется");
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительнаяОперацияПрервать(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПрерватьОперациюПослеОтветаНаВопрос", ЭтаФорма);	
	ТекстВопроса = НСтр("ru = 'Перенос еще выполняется. Прервать?'");
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ИнициализацияПараметров()
	
	ИдентификаторЗадания = ИдентификаторЗаданияПереноса();
	
	Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Состояние = "Выполняется";
	Иначе
		ЕстьДанные = Документы.ВводНачальныхОстатковОС.ЕстьДанныеДляПереноса();
		Если ЕстьДанные Тогда
			Состояние = "НеВыполнено";
		Иначе
			Состояние = "НеТребуется";
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура("ИдентификаторЗадания,Состояние", ИдентификаторЗадания, Состояние);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИдентификаторЗаданияПереноса()
	
	Отбор = Новый Структура;
	Отбор.Вставить("Наименование", "Перенос устаревших документов ввода остатков");
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	
	Задания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	Если Задания.Количество() > 0 Тогда
		Идентификатор = Задания[0].УникальныйИдентификатор;
	Иначе
		Идентификатор = Неопределено;
	КонецЕсли;
	
	Возврат Идентификатор;		
	
КонецФункции

&НаКлиенте
Процедура ОтобразитьСостояние(Состояние)
	
	Если Состояние = "НеТребуется" Тогда
		
		Элементы.Группа_НеТребуется.Видимость	= Истина;	
		Элементы.Группа_Информация.Видимость	= Ложь;
		Элементы.Группа_Перенести.Видимость		= Ложь;
		Элементы.Группа_Выполняется.Видимость	= Ложь;
		Элементы.Группа_Выполнено.Видимость		= Ложь;
		
	ИначеЕсли Состояние = "НеВыполнено" Тогда
		
		Элементы.Группа_НеТребуется.Видимость	= Ложь;	
		Элементы.Группа_Информация.Видимость	= Истина;
		Элементы.Группа_Перенести.Видимость		= Истина;
		Элементы.Группа_Выполняется.Видимость	= Ложь;
		Элементы.Группа_Выполнено.Видимость		= Ложь;
		
		Элементы.Картинка2.Видимость = Истина;
		Элементы.Картинка3.Видимость = Ложь;
		
	ИначеЕсли Состояние = "Ошибка" Тогда
		
		Элементы.Группа_НеТребуется.Видимость	= Ложь;	
		Элементы.Группа_Информация.Видимость	= Истина;
		Элементы.Группа_Перенести.Видимость		= Истина;
		Элементы.Группа_Выполняется.Видимость	= Ложь;
		Элементы.Группа_Выполнено.Видимость		= Ложь;
		
		Элементы.Картинка2.Видимость = Ложь;
		Элементы.Картинка3.Видимость = Истина;
		
	ИначеЕсли Состояние = "Выполняется" Тогда
		
		Элементы.Группа_НеТребуется.Видимость	= Ложь;	
		Элементы.Группа_Информация.Видимость	= Истина;
		Элементы.Группа_Перенести.Видимость		= Ложь;
		Элементы.Группа_Выполняется.Видимость	= Истина;
		Элементы.Группа_Выполнено.Видимость		= Ложь;
		
	ИначеЕсли Состояние = "Выполнено" Тогда
		
		Элементы.Группа_НеТребуется.Видимость	= Ложь;	
		Элементы.Группа_Информация.Видимость	= Ложь;
		Элементы.Группа_Перенести.Видимость		= Ложь;
		Элементы.Группа_Выполняется.Видимость	= Ложь;
		Элементы.Группа_Выполнено.Видимость		= Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрерватьОперациюПослеОтветаНаВопрос(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ОтключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания");
		ОтменитьВыполнениеЗаданияСервер(ИдентификаторЗадания);
		ОтобразитьСостояние("НеВыполнено");
		
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыполнитьДлительнуюОперациюСервер()
	
	ИдентификаторЗадания = ИдентификаторЗаданияПереноса();
	Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		СведенияЗадания =  Новый Структура("Статус,ИдентификаторЗадания", "Выполняется", ИдентификаторЗадания);
		Возврат СведенияЗадания;
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Перенос устаревших документов ввода остатков";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	СведенияЗадания = ДлительныеОперации.ВыполнитьВФоне(
		"Документы.ВводНачальныхОстатковОС.ПеренестиУстаревшиеДокументы",, ПараметрыВыполнения);	
	
	Возврат СведенияЗадания;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка 
		
		Если ПроверитьВыполнениеФоновогоЗаданияНаСервере(ИдентификаторЗадания) Тогда
			ВыполнитьПоЗавершениюДлительнойОперации();
			Возврат;
		КонецЕсли;
		
	Исключение
		
		ИдентификаторЗадания = Неопределено;
		ОтобразитьСостояние("Ошибка");
		
		ТекстСообщения = НСтр("ru = 'При переносе документов возникла ошибка. Подробности в журнале регистрации'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
		
	КонецПопытки;	
	
	ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);	
	ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", ПараметрыОбработчикаОжидания.ТекущийИнтервал, Истина);
	
КонецПроцедуры

 &НаСервереБезКонтекста
Функция ПроверитьВыполнениеФоновогоЗаданияНаСервере(ФоновоеЗаданиеИдентификатор)
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ФоновоеЗаданиеИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПоЗавершениюДлительнойОперации()
	
	ИдентификаторЗадания = Неопределено;
	ОтобразитьСостояние("Выполнено");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьВыполнениеЗаданияСервер(ИдентификаторЗадания)
	
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	
КонецПроцедуры

#КонецОбласти
