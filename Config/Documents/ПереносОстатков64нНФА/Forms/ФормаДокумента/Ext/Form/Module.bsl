&НаСервереБезКонтекста
Функция ПолучитьДатуДокументаСервер(Организация)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("РедакцияПС", Перечисления.РедакцииПланаСчетов.Приказ64н2018);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДатыПереходаНаПрименениеРедакцийПС.ДатаНачалаПрименения КАК ДатаНачалаПрименения
	|ИЗ
	|	РегистрСведений.ДатыПереходаНаПрименениеРедакцийПС КАК ДатыПереходаНаПрименениеРедакцийПС
	|ГДЕ
	|	ДатыПереходаНаПрименениеРедакцийПС.Организация = &Организация
	|	И ДатыПереходаНаПрименениеРедакцийПС.РедакцияПС = &РедакцияПС";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ДатаНачалаПрименения;
	Иначе
		Результат = '00010101';
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()

	ИнициализироватьПараметрыОпераций();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьПараметрыОпераций()

	ПравилаПереноса = Новый ТаблицаЗначений;
	ПравилаПереноса.Колонки.Добавить("Операция"		, Новый ОписаниеТипов("Строка"));
	ПравилаПереноса.Колонки.Добавить("СчетСтарый"	, Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПравилаПереноса.Колонки.Добавить("СчетНовый"	, Новый ОписаниеТипов("СписокЗначений"));
	ПравилаПереноса.Колонки.Добавить("ДопУсловие"	, Новый ОписаниеТипов("Строка"));
	ПравилаПереноса.Колонки.Добавить("Описание"		, Новый ОписаниеТипов("Строка"));
	
	ИсключитьОЦИ = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ЭтоКазенноеУчреждение;
	
	Макет = Документы.ПереносОстатков64нНФА.ПолучитьМакет("Настройки");
	Для Сч = 2 По Макет.ВысотаТаблицы Цикл			
		Операция = СокрЛП(Макет.Область("R"+Сч+"C1").Текст);
		Если Не ПустаяСтрока(Операция) Тогда				
			СписокСчетов = СписокСчетовПоКодуИДате(Макет.Область("R"+Сч+"C2").Текст);
			Если СписокСчетов.Количество() > 0 Тогда
				СчетСтарый = СписокСчетов[0];
				Если ЗначениеЗаполнено(СчетСтарый) Тогда
					КодыСчетов = СокрЛП(Макет.Область("R"+Сч+"C3").Текст);
					СчетНовый = Новый СписокЗначений;
					Если Не ПустаяСтрока(КодыСчетов) Тогда
						СчетНовый.ЗагрузитьЗначения(СписокСчетовПоКодуИДате(КодыСчетов, ИсключитьОЦИ));
					КонецЕсли;
					НоваяСтрока				= ПравилаПереноса.Добавить();
					НоваяСтрока.Операция	= Операция;
					НоваяСтрока.СчетСтарый	= СчетСтарый;
					НоваяСтрока.СчетНовый	= СчетНовый;
					НоваяСтрока.ДопУсловие	= СокрЛП(Макет.Область("R"+Сч+"C4").Текст);
					НоваяСтрока.Описание	= СокрЛП(Макет.Область("R"+Сч+"C5").Текст);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыОпераций.Очистить();
	
	Для Каждого Операция Из Перечисления.ОперацииПереносОстатков64нНФА Цикл
		
		ИмяОперации = ЗначениеРеквизитаПеречисления(Операция, "Имя");		
		СтрокиПравил = ПравилаПереноса.НайтиСтроки(Новый Структура("Операция", ИмяОперации));
		ПравилаОперации = ПравилаПереноса.Скопировать(СтрокиПравил, "СчетСтарый,СчетНовый,ДопУсловие");
		
		СчетаОперации = ПравилаОперации.ВыгрузитьКолонку("СчетСтарый");
				
		ПараметрыОперации = ПараметрыОпераций.Добавить();
		ПараметрыОперации.Операция = Операция;
		ПараметрыОперации.Правила.Загрузить(ПравилаОперации);
		ПараметрыОперации.Счета.ЗагрузитьЗначения(СчетаОперации);		
		Если СтрокиПравил.Количество() > 0 Тогда
			ПараметрыОперации.Описание = СтрокиПравил[0].Описание;
		КонецЕсли;
		
		ДополнитьПараметрыОперации(ПараметрыОперации); 
		
	КонецЦикла;
	
	ПараметрыОперации = ПараметрыОпераций.Добавить();
	ПараметрыОперации.Операция = Перечисления.ОперацииПереносОстатков64нНФА.ПустаяСсылка();
	ДополнитьПараметрыОперации(ПараметрыОперации);	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокСчетовПоКодуИДате(СтрокаКодов, ИсключитьОЦИ = Ложь)
	
	МассивКодов = СтрРазделить(СтрокаКодов, ",", Ложь);
	ТаблицаКодов = Новый ТаблицаЗначений;
	ТаблицаКодов.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(6)));
	ТаблицаКодов.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Для Каждого ТекКод Из МассивКодов Цикл
		пТекКод = СокрЛП(ТекКод);
		НоваяСтрока = ТаблицаКодов.Добавить();
		ПозицияТочек = Найти(пТекКод, ":");
		Если ПозицияТочек = 0 Тогда
			НоваяСтрока.Код        = пТекКод;
			НоваяСтрока.ДатаНачала = Дата(1,1,1);
		Иначе	
			НоваяСтрока.Код        = Лев(пТекКод, (ПозицияТочек - 1));
			НоваяСтрока.ДатаНачала = Дата(Сред(пТекКод, (ПозицияТочек + 1)));
		КонецЕсли;	
	КонецЦикла;	
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаКодов.Код КАК Код,
	|	НАЧАЛОПЕРИОДА(ТаблицаКодов.ДатаНачала, ДЕНЬ) КАК ДатаНачала
	|ПОМЕСТИТЬ ТабКодов
	|ИЗ
	|	&ТаблицаКодов КАК ТаблицаКодов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабКодов КАК ТабКодов
	|		ПО ЕПСБУ.Код = ТабКодов.Код
	|			И ЕПСБУ.ДатаНачалаДействия = ТабКодов.ДатаНачала";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаКодов", ТаблицаКодов);
	
	Если ИсключитьОЦИ Тогда
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	НЕ ЕПСБУ.Ссылка В (&СчетаОЦИ)";
		Запрос.УстановитьПараметр("СчетаОЦИ", БухгалтерскийУчетКлиентСервер.СписокСчетов("101.20,102.20,104.20,105.20,106.20,107.20"));
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеРеквизитаПеречисления(Значение, Реквизит)
	
	Мет			= Значение.Метаданные();
	Индекс		= Перечисления[Мет.Имя].Индекс(Значение);
	Результат	= Мет.ЗначенияПеречисления[Индекс][Реквизит];
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДополнитьПараметрыОперации(ПараметрыОперации)
	
	ПараметрыОперации.ТипОбъекта	= "ОсновныеСредства";
	ПараметрыОперации.ТипНФА		= Перечисления.ТипыНФА.ПустаяСсылка();
	ПараметрыОперации.ИК			= Null;
	ПараметрыОперации.Заголовок		= "Основное средство";
	
	Если ПараметрыОперации.Операция = Перечисления.ОперацииПереносОстатков64нНФА.ИмуществоВКонцессии Тогда
		ПараметрыОперации.ИК = Ложь;	
	ИначеЕсли ПараметрыОперации.Операция = Перечисления.ОперацииПереносОстатков64нНФА.ИмуществоВКонцессииИК Тогда
		ПараметрыОперации.ИК = Истина;	
	ИначеЕсли ПараметрыОперации.Операция = Перечисления.ОперацииПереносОстатков64нНФА.ПредметыЛизингаМЗ Тогда
		ПараметрыОперации.ТипОбъекта = "Номенклатура";	
	ИначеЕсли ПараметрыОперации.Операция = Перечисления.ОперацииПереносОстатков64нНФА.ИнвестиционнаяНедвижимость Тогда
		ПараметрыОперации.ТипНФА = Перечисления.ТипыНФА.ИнвестиционнаяНедвижимость;
	ИначеЕсли ПараметрыОперации.Операция = Перечисления.ОперацииПереносОстатков64нНФА.Сооружения Тогда
		ПараметрыОперации.ТипНФА = Перечисления.ТипыНФА.Сооружения;
	ИначеЕсли ПараметрыОперации.Операция = Перечисления.ОперацииПереносОстатков64нНФА.БиблиотечныйФонд Тогда
		ПараметрыОперации.ТипНФА = Перечисления.ТипыНФА.БиблиотечныйФонд;
	ИначеЕсли ПараметрыОперации.Операция = Перечисления.ОперацииПереносОстатков64нНФА.БиологическиеРесурсы Тогда	
		ПараметрыОперации.ТипНФА = Перечисления.ТипыНФА.Биоресурсы;
	КонецЕсли;
	
	Если ПараметрыОперации.ТипОбъекта = "Номенклатура" Тогда		
		ПараметрыОперации.Заголовок = "Номенклатура";
	ИначеЕсли ЗначениеЗаполнено(ПараметрыОперации.ТипНФА) Тогда
		ПараметрыОперации.Заголовок = ЗначениеРеквизитаПеречисления(ПараметрыОперации.ТипНФА, "Синоним");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьПараметрыОперации()
	
	Возврат ПараметрыОпераций.НайтиСтроки(Новый Структура("Операция", Объект.ВидОперации))[0];
	
КонецФункции

&НаКлиенте
Процедура ОтразитьВидимостьДатыПС()
	
	Элементы.ДатаПС.Видимость = ЗначениеЗаполнено(ДатаПС);
	Элементы.ДатаПСЗадать.Видимость = Не ЗначениеЗаполнено(ДатаПС);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтразитьПараметрыОперацииНаФорме()
	
	ПараметрыОперации = ПолучитьПараметрыОперации();
	Элементы.Контрагент.Видимость = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ОперацииПереносОстатков64нНФА.НеАктивы"));
	Элементы.ПереводыОбъект.Заголовок = ПараметрыОперации.Заголовок;
	Элементы.ВидОперации.РасширеннаяПодсказка.Заголовок = ?(ЗначениеЗаполнено(ПараметрыОперации.Описание),
		"Варианты переноса:" + Символы.ПС + Символы.ПС + ПараметрыОперации.Описание, "");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПереносаСервер()
	
	Результат = ПолучитьТаблицуОстатков();
	Объект.Переводы.Загрузить(Результат);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуОстатков(СпОбъектов = Неопределено)
	
	ПараметрыОперации = ПараметрыОпераций.НайтиСтроки(Новый Структура("Операция", Объект.ВидОперации))[0];
	
	Если ПараметрыОперации.ТипОбъекта = "Номенклатура" Тогда
		Субконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура;	
	Иначе
		Субконто = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства;	
	КонецЕсли;
	
	ДатаПерехода = НачалоДня(ДатаПС) - 1;	
	ПериодКонец	 = Новый Граница(ДатаПерехода, ВидГраницы.Включая);
	ПериодНачало = ?(КонецДня(ДатаПерехода) = КонецГода(ДатаПерехода), ПериодКонец, Новый Граница(НачалоГода(ДатаПерехода), ВидГраницы.Исключая));	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"		, Объект.Ссылка);
	Запрос.УстановитьПараметр("ПериодНачало", ПериодНачало);
	Запрос.УстановитьПараметр("ПериодКонец"	, ПериодКонец);
	Запрос.УстановитьПараметр("Организация"	, Объект.Организация);
	Запрос.УстановитьПараметр("Счет"		, ПараметрыОперации.Счета);
	Запрос.УстановитьПараметр("Субконто"	, Субконто);
	
	Если СпОбъектов = Неопределено И
		(ЗначениеЗаполнено(Объект.ОтборИФО) Или ЗначениеЗаполнено(Объект.ОтборПодразделение)
		Или ЗначениеЗаполнено(Объект.ОтборСчет) Или ЗначениеЗаполнено(Объект.ОтборКФО)) Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Остатки.Субконто1 КАК Объект
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
		|			&ПериодНачало,
		|			&ПериодКонец,
		|			,
		|			,
		|			Счет В (&Счет),
		|			&Субконто,
		|			Организация = &Организация
		|				И ИФО = &ИФО
		|				И КФО = &КФО) КАК Остатки
		|ГДЕ
		|	Остатки.Подразделение = &Подразделение";
		
		Если ЗначениеЗаполнено(Объект.ОтборИФО) Тогда
			Запрос.УстановитьПараметр("ИФО", Объект.ОтборИФО);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.ОтборПодразделение) Тогда
			Запрос.УстановитьПараметр("Подразделение", Объект.ОтборПодразделение);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки.Подразделение = &Подразделение", "ИСТИНА");
		КонецЕсли;
			
		Если ЗначениеЗаполнено(Объект.ОтборСчет) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Счет", "&пСчет");
			Запрос.УстановитьПараметр("пСчет", Объект.ОтборСчет);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.ОтборКФО) Тогда
			Запрос.УстановитьПараметр("КФО", Объект.ОтборКФО);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И КФО = &КФО", "");
		КонецЕсли;
		
		СпОбъектов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Объект");
		
	КонецЕсли;
		
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Остатки.Счет КАК СчетСтарый,
	|	Остатки.Субконто1 КАК Объект
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
	|			&ПериодНачало,
	|			&ПериодКонец,
	|			,
	|			,
	|			Счет В (&Счет),
	|			&Субконто,
	|			Организация = &Организация
	|				И Субконто1 В (&СпОбъектов)
	|				И НЕ Субконто1 В
	|						(ВЫБРАТЬ
	|							Переводы.Объект
	|						ИЗ
	|							Документ.ПереносОстатков64нНФА.Переводы КАК Переводы
	|						ГДЕ
	|							Переводы.Ссылка.Проведен
	|							И Переводы.Ссылка <> &Ссылка)) КАК Остатки
	|ГДЕ
	|	&Условие
	|
	|УПОРЯДОЧИТЬ ПО
	|	Объект,
	|	Остатки.Счет.Порядок";
	
	Если СпОбъектов = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Субконто1 В (&СпОбъектов)", "");				
	Иначе
		Запрос.УстановитьПараметр("СпОбъектов", СпОбъектов); 
	КонецЕсли;
	
	Условие = "ИСТИНА";
	
	Если Объект.ВидОперации = Перечисления.ОперацииПереносОстатков64нНФА.ИмуществоВКонцессии Тогда
	    Условие = "ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства).ИмуществоКазны = ЛОЖЬ";
	ИначеЕсли Объект.ВидОперации = Перечисления.ОперацииПереносОстатков64нНФА.ИмуществоВКонцессииИК Тогда
	    Условие = "ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства).ИмуществоКазны = ИСТИНА";	
	ИначеЕсли Объект.ВидОперации = Перечисления.ОперацииПереносОстатков64нНФА.ИнвестиционнаяНедвижимость Тогда
		Условие = "ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства).ТипНФА = ЗНАЧЕНИЕ(Перечисление.ТипыНФА.ИнвестиционнаяНедвижимость)";
	ИначеЕсли Объект.ВидОперации = Перечисления.ОперацииПереносОстатков64нНФА.БиологическиеРесурсы Тогда
		Условие = "ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства).ТипНФА = ЗНАЧЕНИЕ(Перечисление.ТипыНФА.Биоресурсы)";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", Условие);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Колонки.Добавить("СчетНовый");
	
	Для Каждого ТекСтрока Из Результат Цикл
		СписокНовыхСчетов = ПолучитьНовыйСчет(ПараметрыОперации.Правила, ТекСтрока);
		Если СписокНовыхСчетов.Количество() = 1 Тогда
			ТекСтрока.СчетНовый = СписокНовыхСчетов[0];
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьНовыйСчет(Правила, ТекСтрока)
	
	Для Каждого СтрокаОперации Из Правила Цикл
		Если СтрокаОперации.СчетСтарый = ТекСтрока.СчетСтарый Тогда
			Если СтрокаОперации.ДопУсловие = "био" И Не ЭтоБиоресурс(ТекСтрока.Объект) Тогда
				Продолжить;				
			КонецЕсли;
			Возврат СтрокаОперации.СчетНовый.ВыгрузитьЗначения();
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Массив;
	
КонецФункции

&НаКлиенте
Функция ПолучитьНовыйСчетКлиент(ТекСтрока)
	
	Правила = ПолучитьПараметрыОперации().Правила;
	
	Для Каждого СтрокаОперации Из Правила Цикл
		Если СтрокаОперации.СчетСтарый = ТекСтрока.СчетСтарый Тогда
			Если СтрокаОперации.ДопУсловие = "био" И Не ЭтоБиоресурс(ТекСтрока.Объект) Тогда
				Продолжить;				
			КонецЕсли;
			Возврат СтрокаОперации.СчетНовый.ВыгрузитьЗначения();
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Массив;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоБиоресурс(ОС)
	
	Возврат (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОС, "ТипНФА") = Перечисления.ТипыНФА.Биоресурсы);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокуТЧ(ОбъектНФА)
	
	Если ЗначениеЗаполнено(ОбъектНФА) Тогда
		Данные = ПолучитьТаблицуОстатков(ОбъектНФА);
	Иначе
		Данные = Новый ТаблицаЗначений;
	КонецЕсли;
	
	Если Данные.Количество() > 0 Тогда	
		Для Сч = 1 По Данные.Количество() Цикл
			НоваяСтрока				= Объект.Переводы.Добавить();
			НоваяСтрока.Объект		= Данные[Сч-1].Объект;
			НоваяСтрока.СчетСтарый	= Данные[Сч-1].СчетСтарый;
			НоваяСтрока.СчетНовый	= Данные[Сч-1].СчетНовый;			
		КонецЦикла;
	Иначе
		Для Каждого Об Из ОбъектНФА Цикл
			НоваяСтрока				= Объект.Переводы.Добавить();
			НоваяСтрока.Объект		= Об;		
			НоваяСтрока.СчетСтарый	= ПланыСчетов.ЕПСБУ.ПустаяСсылка();
			НоваяСтрока.СчетНовый	= ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ВсеНовыеСчетаОперации()
	
	Результат = Новый Массив;
	
	ПараметрыОперации = ПолучитьПараметрыОперации();
	
	Для Каждого СтрокаОперации Из ПараметрыОперации.Правила Цикл
		Для Каждого СчетОперации Из СтрокаОперации.СчетНовый Цикл
			Если Результат.Найти(СчетОперации.Значение) = Неопределено Тогда
				Результат.Добавить(СчетОперации.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВыборСчета(Владелец, ТекущиееЗначение, СписокСчетов, НовыйСчет = Истина)
	
	ДатаПерехода = НачалоДня(ДатаПС) - 1;
	Если КонецДня(ДатаПерехода) = КонецГода(ДатаПерехода) Тогда		
		ДатаДляОтбора = ?(НовыйСчет, КонецДня(ДатаПерехода) + 1, ДатаПерехода); 
	Иначе
		ДатаДляОтбора = ?(НовыйСчет, ДатаПерехода, НачалоГода(ДатаПерехода) - 1);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НаДату", ДатаДляОтбора);
	ПараметрыФормы.Вставить("Отбор", Новый Структура("Ссылка", СписокСчетов));	
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Владелец);
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьСтарыйСчетСервер()
	
	СпОбъектов = Объект.Переводы.Выгрузить().ВыгрузитьКолонку("Объект");
	Результат = ПолучитьТаблицуОстатков(СпОбъектов);
	
	ПустойСчет = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	
	Правила = ПараметрыОпераций.НайтиСтроки(Новый Структура("Операция", Объект.ВидОперации))[0].Правила;
	
	Для Каждого ТекСтрока Из Объект.Переводы Цикл
		
		СтрРезультат = Результат.Найти(ТекСтрока.Объект, "Объект");
		
		Если СтрРезультат = Неопределено Тогда
			ТекСтрока.СчетСтарый = ПустойСчет;
			//ТекСтрока.СчетНовый = ПустойСчет;
		Иначе
			ТекСтрока.СчетСтарый = СтрРезультат.СчетСтарый;
			Если СтрРезультат.СчетНовый <> ПустойСчет Тогда
				ТекСтрока.СчетНовый = СтрРезультат.СчетНовый;
			ИначеЕсли ТекСтрока.СчетНовый <> ПустойСчет Тогда
				СписокНовыхСчетов = ПолучитьНовыйСчет(Правила, ТекСтрока);
				Если СписокНовыхСчетов.Найти(ТекСтрока.СчетНовый) = Неопределено Тогда
					ТекСтрока.СчетНовый = ПустойСчет;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

