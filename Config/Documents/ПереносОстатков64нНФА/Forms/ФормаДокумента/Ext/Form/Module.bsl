	ЗначенияЗаполнения.Вставить("РедакцияПС"	, ПредопределенноеЗначение("Перечисление.РедакцииПланаСчетов.Приказ64н2018"));
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ОткрытьФорму("РегистрСведений.ДатыПереходаНаПрименениеРедакцийПС.ФормаЗаписи", ПараметрыФормы, ЭтаФорма);
	
