#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Переводы

&НаКлиенте
Процедура ПереводыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТипЗнач = ТипЗнч(ВыбранноеЗначение);
	
	Если ТипЗнач = Тип("СправочникСсылка.ОсновныеСредства")
		Или ТипЗнач = Тип("СправочникСсылка.Номенклатура") Тогда
		
		СписокОбъектов = Новый Массив;
		СписокОбъектов.Добавить(ВыбранноеЗначение);
		
		ЗаполнитьСтрокуТЧ(СписокОбъектов);
		
	ИначеЕсли ТипЗнач = Тип("Массив") Тогда
		
		ЗаполнитьСтрокуТЧ(ВыбранноеЗначение);
		
	ИначеЕсли ТипЗнач = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		
		Для Каждого ТекСтрока Из Элементы.Переводы.ВыделенныеСтроки Цикл
			Объект.Переводы.НайтиПоИдентификатору(ТекСтрока).СчетНовый = ВыбранноеЗначение;
		КонецЦикла;		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереводыСчетНовыйНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Элементы.Переводы.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекСтрока.СчетСтарый) Тогда
		СписокНовыхСчетов = ПолучитьНовыйСчетКлиент(ТекСтрока);
	Иначе
		СписокНовыхСчетов = ВсеНовыеСчетаОперации();
	КонецЕсли;
	
	ВыборСчета(Элемент, ТекСтрока.СчетНовый, СписокНовыхСчетов);
	
КонецПроцедуры

#КонецОбласти

