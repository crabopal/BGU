#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Для Каждого ТаблицаДвижений Из Движения Цикл
		ТаблицаДвижений.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения");
	КонецЦикла;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И Проведен Тогда
		ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	КонецЕсли;		
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(Организация) И ЗначениеЗаполнено(Дата) Тогда	
		
		ДатаПерехода = БухгалтерскийУчет.ДатаПереходаНаРедакциюПС(Организация, Дата);
		
		Если Не ЗначениеЗаполнено(ДатаПерехода) Тогда
			ТекстОшибки = Нстр("ru = 'Для выбранной организации не задана дата перехода на приказ 64н'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,,, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВидОперации <> Перечисления.ОперацииПереносОстатков64нНФА.НеАктивы Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Контрагент"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Переводы.Очистить();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли