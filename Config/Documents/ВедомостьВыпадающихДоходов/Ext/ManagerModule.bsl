#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом
// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
Процедура СформироватьОписаниеДокументовСТабличнымиЧастями(Форма, Описание) Экспорт
	
	ПроверкаКонтрагентов.ДополнитьОписаниеТабличныхЧастей(
	Форма, Описание, "Начисления", "НачисленияКонтрагент", "");

КонецПроцедуры
// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

Функция СуммыДоходаДляСтроки(Организация, ИФО, Дата, ДанныеСтроки) Экспорт
	
	СуммыДохода = Новый Структура("Доход, Зачтено", 0, 0);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОборотыДтКт.СуммаОборот, 0) КАК СуммаОборот,
	|	0 КАК СуммаВыпадающая
	|ПОМЕСТИТЬ СуммыДоходовПредв
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(
	|			,
	|			,
	|			,
	|			СчетДт = &СчетРасчеты,
	|			,
	|			СчетКт = &СчетДоходы,
	|			,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И КФО = &КФО
	|				И КПСДт = &КПС
	|				И КПСКт = &КПС
	|				И СубконтоДт1 = &Контрагент
	|				И СубконтоДт2 = &Договор
	|				И КЭККт = &КЭКРасчетов) КАК ЖурналПроводокЕПСБУОборотыДтКт
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	-ЕСТЬNULL(ЖурналПроводокЕПСБУОборотыДтКт.СуммаОборот, 0),
	|	0
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(
	|			,
	|			,
	|			,
	|			СчетДт = &СчетДоходы,
	|			,
	|			СчетКт = &СчетРасчеты,
	|			,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И КФО = &КФО
	|				И КПСДт = &КПС
	|				И КПСКт = &КПС
	|				И СубконтоКт1 = &Контрагент
	|				И СубконтоКт2 = &Договор
	|				И КЭКДт = &КЭКРасчетов) КАК ЖурналПроводокЕПСБУОборотыДтКт
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОборотыДтКт.СуммаОборот, 0),
	|	0
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(
	|			,
	|			,
	|			,
	|			СчетДт = &СчетДоходыБП,
	|			,
	|			СчетКт = &СчетДоходы,
	|			,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И КФО = &КФО
	|				И КПСДт = &КПС
	|				И КПСКт = &КПС
	|				И СубконтоДт2 = &Договор
	|				И КЭККт = &КЭКРасчетов
	|				И КЭКДт = &КЭКРасчетов) КАК ЖурналПроводокЕПСБУОборотыДтКт
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	-ЕСТЬNULL(ЖурналПроводокЕПСБУОборотыДтКт.СуммаОборот, 0),
	|	0
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(
	|			,
	|			,
	|			,
	|			СчетДт = &СчетДоходы,
	|			,
	|			СчетКт = &СчетДоходыБП,
	|			,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И КФО = &КФО
	|				И КПСДт = &КПС
	|				И КПСКт = &КПС
	|				И СубконтоКт2 = &Договор
	|				И КЭККт = &КЭКРасчетов
	|				И КЭКДт = &КЭКРасчетов) КАК ЖурналПроводокЕПСБУОборотыДтКт
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	0,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОборотыДтКт.СуммаОборот, 0)
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(
	|			,
	|			,
	|			,
	|			СчетДт = &СчетДоходы,
	|			,
	|			СчетКт = &СчетРасчеты,
	|			,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И КФО = &КФО
	|				И КПСДт = &КПС
	|				И КПСКт = &КПС
	|				И СубконтоКт1 = &Контрагент
	|				И СубконтоКт2 = &Договор
	|				И КЭКДт = &КЭКВыпадающие) КАК ЖурналПроводокЕПСБУОборотыДтКт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(СуммыДоходовПредв.СуммаОборот) КАК СуммаОборот,
	|	СУММА(СуммыДоходовПредв.СуммаВыпадающая) КАК СуммаВыпадающая
	|ИЗ
	|	СуммыДоходовПредв КАК СуммыДоходовПредв");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИФО", ИФО);
	Запрос.УстановитьПараметр("Контрагент", ДанныеСтроки.Контрагент);
	Запрос.УстановитьПараметр("Договор", ДанныеСтроки.ДоговорКонтрагента);
	Запрос.УстановитьПараметр("КФО", ДанныеСтроки.КФО);
	Запрос.УстановитьПараметр("КПС", ДанныеСтроки.КПС);
	Запрос.УстановитьПараметр("КЭКРасчетов", ДанныеСтроки.КОСГУ);
	Запрос.УстановитьПараметр("СчетРасчеты", ДанныеСтроки.СчетРасчетов);
	Запрос.УстановитьПараметр("СчетДоходы",  БухгалтерскийУчет.СчетПоКоду("401.10", Дата, Организация));
	Запрос.УстановитьПараметр("СчетДоходыБП", БухгалтерскийУчет.СчетПоКоду("401.40", Дата, Организация));
	Запрос.УстановитьПараметр("КЭКВыпадающие", БухгалтерскийУчетПовтИсп.КЭКПоКоду("174"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СуммыДохода.Доход = Выборка.СуммаОборот;
		СуммыДохода.Зачтено = Выборка.СуммаВыпадающая;
	КонецЕсли;
	
	Возврат СуммыДохода;
		
КонецФункции	

Функция СчетКЭКПоДоговору(Организация, ИФО, Дата, ПараметрыЗапроса) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Обороты.Счет КАК Счет,
	|	Обороты.Счет.Родитель.Родитель КАК ВидДохода,
	|	Обороты.КФО КАК КФО,
	|	Обороты.ИФО КАК ИФО,
	|	Обороты.КПС КАК КПС,
	|	Обороты.Организация КАК Организация,
	|	ВЫРАЗИТЬ(Обороты.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫРАЗИТЬ(Обороты.Субконто2 КАК Справочник.Договоры) КАК Договор
	|ПОМЕСТИТЬ ВТ_Счета
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			,
	|			&КонецПериода,
	|			,
	|			Счет В ИЕРАРХИИ (&ГруппаСчетов),
	|			&СписокСубконто,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И КФО В (&СписокКФО)
	|				И КПС В (&СписокКПС)
	|				И ВЫРАЗИТЬ(Субконто1 КАК Справочник.Контрагенты) В (&СписокКонтрагентов)
	|				И ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры) В (&СписокДоговоров),
	|			,
	|			) КАК Обороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Обороты.Субконто1 КАК Справочник.Контрагенты),
	|	ВЫРАЗИТЬ(Обороты.Субконто2 КАК Справочник.Договоры),
	|	Обороты.Организация,
	|	Обороты.ИФО,
	|	Обороты.Счет,
	|	Обороты.КПС,
	|	Обороты.Счет.Родитель.Родитель,
	|	Обороты.КФО
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Счета.Организация КАК Организация,
	|	ВТ_Счета.Контрагент КАК Контрагент,
	|	ВТ_Счета.Договор КАК Договор,
	|	ВТ_Счета.КФО КАК КФО,
	|	ВТ_Счета.ИФО КАК ИФО,
	|	ВТ_Счета.КПС КАК КПС,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Счета.Счет) КАК КоличествоСчетов
	|ПОМЕСТИТЬ ВТ_КолСчетов
	|ИЗ
	|	ВТ_Счета КАК ВТ_Счета
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Счета.КПС,
	|	ВТ_Счета.ИФО,
	|	ВТ_Счета.Организация,
	|	ВТ_Счета.Контрагент,
	|	ВТ_Счета.Договор,
	|	ВТ_Счета.КФО
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КПС,
	|	ИФО,
	|	Организация,
	|	Контрагент,
	|	Договор,
	|	КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Счета.Организация КАК Организация,
	|	ВТ_Счета.КФО КАК КФО,
	|	ВТ_Счета.ИФО КАК ИФО,
	|	ВТ_Счета.КПС КАК КПС,
	|	ВТ_Счета.Контрагент КАК Контрагент,
	|	ВТ_Счета.Счет КАК СчетРасчетов,
	|	ВТ_Счета.Договор КАК ДоговорКонтрагента,
	|	ВТ_Счета.ВидДохода КАК ВидДохода,
	|	ЕСТЬNULL(СоответствияАналитическихСчетовКЭК.КЭК, ЗНАЧЕНИЕ(справочник.косгу.пустаяссылка)) КАК КОСГУ
	|ИЗ
	|	ВТ_Счета КАК ВТ_Счета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияАналитическихСчетовКЭК КАК СоответствияАналитическихСчетовКЭК
	|		ПО ВТ_Счета.Счет = СоответствияАналитическихСчетовКЭК.Счет
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КолСчетов КАК ВТ_КолСчетов
	|		ПО ВТ_Счета.КПС = ВТ_КолСчетов.КПС
	|			И ВТ_Счета.ИФО = ВТ_КолСчетов.ИФО
	|			И ВТ_Счета.Организация = ВТ_КолСчетов.Организация
	|			И ВТ_Счета.Контрагент = ВТ_КолСчетов.Контрагент
	|			И ВТ_Счета.Договор = ВТ_КолСчетов.Договор
	|			И ВТ_Счета.КФО = ВТ_КолСчетов.КФО
	|ГДЕ
	|	ВТ_КолСчетов.КоличествоСчетов = 1";
	
	СписокСубконто = Новый СписокЗначений;
	СписокСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	СписокСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	
	ГруппаСчетов = Новый СписокЗначений;
	ГруппаСчетов.Добавить(БухгалтерскийУчет.СчетПоКоду("205.00", Дата, Организация));
	ГруппаСчетов.Добавить(БухгалтерскийУчет.СчетПоКоду("209.00", Дата, Организация));
	
	Запрос.УстановитьПараметр("Организация",			Организация);
	Запрос.УстановитьПараметр("ИФО",					ИФО);
	Запрос.УстановитьПараметр("СписокКФО",			ПараметрыЗапроса.КФО);
	Запрос.УстановитьПараметр("КонецПериода",		КонецДня(Дата));
	Запрос.УстановитьПараметр("СписокКПС",			ПараметрыЗапроса.КПС);
	Запрос.УстановитьПараметр("СписокКонтрагентов",	ПараметрыЗапроса.Контрагенты);
	Запрос.УстановитьПараметр("СписокДоговоров",	ПараметрыЗапроса.Договоры);
	Запрос.УстановитьПараметр("ГруппаСчетов",		ГруппаСчетов);
	Запрос.УстановитьПараметр("СписокСубконто",		СписокСубконто);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВедомостьВыпадающихДоходов";
	КомандаПечати.Идентификатор		= "Форма0510838";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость выпадающих доходов (ф. 0510838)'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0510838") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
		"Форма0510838",
		НСтр("ru = 'Ведомость выпадающих доходов (ф. 0510838)'"),
		ПечатьВедомостьНачислений(МассивОбъектов, ОбъектыПечати, ПараметрыПечати));
		
	КонецЕсли;
		
КонецПроцедуры

Функция ПечатьВедомостьНачислений(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)   
	
	ОбщиеСведения = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ВедомостьВыпадающихДоходов.Ссылка КАК Ссылка,
	|	ВедомостьВыпадающихДоходов.Номер КАК Номер,
	|	ВедомостьВыпадающихДоходов.Дата КАК ДатаДок,
	|	ВедомостьВыпадающихДоходов.ВидРегламентирующегоДокумента КАК ВидРегламентирующегоДокумента,
	|	ВедомостьВыпадающихДоходов.ДатаРегламентирующегоДокумента КАК ДатаРегламентирующегоДокумента,
	|	ВедомостьВыпадающихДоходов.НомерРегламентирующегоДокумента КАК НомерРегламентирующегоДокумента,
	|	ВедомостьВыпадающихДоходов.СтатьяРегламентирующегоДокумента КАК СтатьяРегламентирующегоДокумента
	|ИЗ
	|	Документ.ВедомостьВыпадающихДоходов КАК ВедомостьВыпадающихДоходов
	|ГДЕ
	|	ВедомостьВыпадающихДоходов.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВедомостьВыпадающихДоходовНачисления.Ссылка КАК Ссылка,
	|	ВедомостьВыпадающихДоходовНачисления.НомерСтроки КАК НомерСтроки,
