			ОбщиеСведенияОрг = Новый Структура; 
		КонецЕсли;	
		
		СтруктураДанных = Новый Структура;
				
		// для печати даты в виде "__" ________ 20__ г.
		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(Выборка.ДатаДок);
        СтруктураДанных.Вставить("ЧислоДаты", СтруктураДаты.Число);	
		СтруктураДанных.Вставить("МесяцДаты", СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДаты", СтруктураДаты.Год);    
		
		// реквизиты, требующие преобразования
		СтруктураДанных.Вставить("НомерДок", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Выборка.Ссылка, Выборка.Номер));

		ОбластьМакетаШапка.Параметры.Заполнить(Выборка);
		ОбластьМакетаШапка.Параметры.Заполнить(СтруктураДанных);  
		ОбластьМакетаШапка.Параметры.Заполнить(ОбщиеСведенияОрг); 
		
		ТабличныйДокумент.Вывести(ОбластьМакетаШапка);
				
		СтрокиНачислений = Начисления.Скопировать(Новый Структура("Ссылка", Выборка.Ссылка));
		СтрокиГрупп = ГруппыУчета.Скопировать(Новый Структура("Ссылка", Выборка.Ссылка));

		ДлинаНомераГр = ?(СтрокиГрупп.Количество() =0, 0, СтрДлина(Строка(СтрокиГрупп.Количество())));
		ДлинаНомераСтр = СтрДлина(Строка(СтрокиНачислений.Количество()));
		
		Если НЕ ДлинаНомераГр = 0 Тогда
			ФорматНомераГр = "ЧЦ=" + Строка(Макс(ДлинаНомераГр, 2)) + "; ЧДЦ=0; ЧВН=; ЧГ=0";
			ФорматНомераСтр = "ЧЦ=" + Строка(Макс(ДлинаНомераСтр, 2)) + "; ЧДЦ=0; ЧВН=; ЧГ=0";
		Иначе
			ФорматНомераСтр = "ЧЦ=" + Строка(Макс(ДлинаНомераСтр, 4)) + "; ЧДЦ=0; ЧВН=; ЧГ=0";
		КонецЕсли;
				
		Если СтрокиГрупп.Количество() = 0 Тогда
			Группа = СтрокиГрупп.Добавить();
			Группа.КлючСтроки = "";
		КонецЕсли;	 
		
		Для Каждого Группа Из СтрокиГрупп Цикл
			
			СтрокиДокумента = СтрокиНачислений.Скопировать(Новый Структура("КлючСтроки", Группа.КлючСтроки));
			ОбластьМакетаЗаголовок_1   		= Макет.ПолучитьОбласть("Заголовок_1");
			ОбластьМакетаЗаголовок_1.Параметры.Заполнить(Группа);
			ТабличныйДокумент.Вывести(ОбластьМакетаЗаголовок_1);
			ТабличныйДокумент.Вывести(ОбластьМакетаЗаголовок_2);
			
			Для Каждого СтрокаДок Из СтрокиДокумента Цикл
				
				СтрокаДок.КБК = ?(ЗначениеЗаполнено(ОбщиеСведенияОрг.ГлаваБК), ОбщиеСведенияОрг.ГлаваБК, "000") + СтрокаДок.КПС;
				
				Если НЕ ЗначениеЗаполнено(СтрокаДок.КодОКВ) Тогда
					СтрокаДок.КодОКВ = "643";
				КонецЕсли;
				
				СтрокаДок.НомерНаПечать = ?(НЕ ДлинаНомераГр = 0, Формат(Группа.НомерСтроки, ФорматНомераГр), "")
				+ Формат(СтрокаДок.НомерСтроки, ФорматНомераСтр);
				
				ОбластьМакетаСтрока = Макет.ПолучитьОбласть("Строка");
				
				ОбластьМакетаСтрока.Параметры.Заполнить(СтрокаДок);
				
				ТабличныйДокумент.Вывести(ОбластьМакетаСтрока);
				
			КонецЦикла;
			
			ОбластьМакетаИтого = Макет.ПолучитьОбласть("Итого");
			ОбластьМакетаИтого.Параметры.Заполнить(Новый Структура("Сумма", СтрокиДокумента.Итог("Сумма")));
			ТабличныйДокумент.Вывести(ОбластьМакетаИтого);
			
			СтрокиДокумента.Свернуть("КБК", "Сумма");
			Для Каждого СтрКБК Из  СтрокиДокумента Цикл
				ОбластьМакетаПоКД = Макет.ПолучитьОбласть("ПоКД");
				ОбластьМакетаПоКД.Параметры.Заполнить(СтрКБК);
				ТабличныйДокумент.Вывести(ОбластьМакетаПоКД);
			КонецЦикла;
			
			ТабличныйДокумент.Вывести(ОбластьМакетаПодвал);
			
		КонецЦикла;
		
		Файлы = УправлениеПечатьюБГУ.ПолучитьСписокФайловДокумента(Выборка.Ссылка);
		Для Каждого Приложение Из Файлы Цикл
			ОбластьМакетаПриложение = Макет.ПолучитьОбласть("Приложение");
			ОбластьМакетаПриложение.Параметры.Заполнить(Приложение);
			ТабличныйДокумент.Вывести(ОбластьМакетаПриложение);
		КонецЦикла;
		
		ОбластьМакетаПодписи = Макет.ПолучитьОбласть("Подписи");
		ОбластьМакетаПодписи.Параметры.Заполнить(ОбщиеСведенияОрг);
		ТабличныйДокумент.Вывести(ОбластьМакетаПодписи);
		
		// В табличном документе зададим имя области, в которую был выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,ИФО,Дата");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет", ИспользоватьВалютныйУчет);
	
	Если ДополнительныеСвойства.ИспользоватьОтдельнуюДатуПроведенияДокументов
		И ЗначениеЗаполнено(ДополнительныеСвойства.УстановленнаяДатаПроведения) Тогда
		Запрос.УстановитьПараметр("ДатаПроведения", ДополнительныеСвойства.УстановленнаяДатаПроведения);
	Иначе
		Запрос.УстановитьПараметр("ДатаПроведения", ЗначенияРеквизитов.Дата);
	КонецЕсли;
	
	НомераТаблиц = Новый Структура;
	
	ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	Если ИспользоватьКонтрольИсполненияДоговоров Тогда
		
		НомераТаблиц.Вставить("ОплатаОтПокупателейДебиторов", НомераТаблиц.Количество());
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	ВедомостьВыпадающихДоходов.ОплатитьДо КАК Период,
		|	ВедомостьВыпадающихДоходов.Ссылка.Организация КАК Организация,
		|	ВедомостьВыпадающихДоходов.Контрагент КАК Контрагент,
		|	ВедомостьВыпадающихДоходов.ДоговорКонтрагента КАК Договор,
		|	ВедомостьВыпадающихДоходов.СчетРасчетов КАК СчетРасчетов,
		|	ВедомостьВыпадающихДоходов.ВидРасчетов КАК ВидРасчетов,
		|	ВЫБОР
		|		КОГДА НЕ &ИспользоватьВалютныйУчет
		|				ИЛИ ВедомостьВыпадающихДоходов.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА &ВалютаРеглУчета
		|		ИНАЧЕ ВедомостьВыпадающихДоходов.Валюта
		|	КОНЕЦ КАК Валюта,
		|	ВедомостьВыпадающихДоходов.Ссылка.ИФО КАК ИФО,
		|	ВедомостьВыпадающихДоходов.КФО КАК КФО,
		|	ВедомостьВыпадающихДоходов.КПС КАК КПС,
		|	ВедомостьВыпадающихДоходов.КОСГУ КАК КЭК,
		|	ЗНАЧЕНИЕ(Справочник.ДополнительнаяБюджетнаяКлассификация.ПустаяСсылка) КАК ДопКлассификация,
		|	ЗНАЧЕНИЕ(Справочник.Мероприятия.ПустаяСсылка) КАК КодМероприятия,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЦелевыхСредств.ПустаяСсылка) КАК КодЦели,
		|	ВедомостьВыпадающихДоходов.ОплатитьДо КАК ОплатитьДо,
		|	ВЫБОР
		|		КОГДА НЕ &ИспользоватьВалютныйУчет
		|				ИЛИ ВедомостьВыпадающихДоходов.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|				ИЛИ ВедомостьВыпадающихДоходов.Валюта = &ВалютаРеглУчета
		|			ТОГДА -1 * ВедомостьВыпадающихДоходов.Сумма
		|		ИНАЧЕ -1 * ВедомостьВыпадающихДоходов.СуммаВВалюте
		|	КОНЕЦ КАК Сумма
		|ИЗ
		|	Документ.ВедомостьВыпадающихДоходов.Начисления КАК ВедомостьВыпадающихДоходов
		|ГДЕ
		|	ВедомостьВыпадающихДоходов.Ссылка = &Ссылка
		|	И ВедомостьВыпадающихДоходов.ДоговорКонтрагента.ВестиГрафикПлатежей
		|	И ВедомостьВыпадающихДоходов.АвтоматическиОтразитьВГрафикахИсполненияДоговоров";
		
		НомераТаблиц.Вставить("ИсполнениеДоговоровСПокупателями", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	&ДатаПроведения КАК Период,
		|	ВедомостьВыпадающихДоходов.Ссылка.Организация КАК Организация,
		|	ВедомостьВыпадающихДоходов.Контрагент КАК Контрагент,
		|	ВедомостьВыпадающихДоходов.ДоговорКонтрагента КАК Договор,
		|	ВедомостьВыпадающихДоходов.СчетРасчетов КАК СчетРасчетов,
		|	ВЫБОР
		|		КОГДА НЕ &ИспользоватьВалютныйУчет
		|				ИЛИ ВедомостьВыпадающихДоходов.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА &ВалютаРеглУчета
		|		ИНАЧЕ ВедомостьВыпадающихДоходов.Валюта
		|	КОНЕЦ КАК Валюта,
		|	ВедомостьВыпадающихДоходов.Ссылка.ИФО КАК ИФО,
		|	ВедомостьВыпадающихДоходов.КФО КАК КФО,
		|	ВедомостьВыпадающихДоходов.КПС КАК КПС,
		|	ВедомостьВыпадающихДоходов.КОСГУ КАК КЭК,
		|	&ДатаПроведения КАК ИсполнитьДо,
		|	ВЫБОР
		|		КОГДА НЕ &ИспользоватьВалютныйУчет
		|				ИЛИ ВедомостьВыпадающихДоходов.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|				ИЛИ ВедомостьВыпадающихДоходов.Валюта = &ВалютаРеглУчета
		|			ТОГДА -1 * ВедомостьВыпадающихДоходов.Сумма
		|		ИНАЧЕ -1 * ВедомостьВыпадающихДоходов.СуммаВВалюте
		|	КОНЕЦ КАК Сумма
		|ИЗ
		|	Документ.ВедомостьВыпадающихДоходов.Начисления КАК ВедомостьВыпадающихДоходов
		|ГДЕ
		|	ВедомостьВыпадающихДоходов.Ссылка = &Ссылка
		|	И ВедомостьВыпадающихДоходов.ДоговорКонтрагента.ВестиПланГрафикИсполнения
		|	И ВедомостьВыпадающихДоходов.АвтоматическиОтразитьВГрафикахИсполненияДоговоров
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
		|	&ДатаПроведения,
		|	ВедомостьВыпадающихДоходов.Ссылка.Организация,
		|	ВедомостьВыпадающихДоходов.Контрагент,
		|	ВедомостьВыпадающихДоходов.ДоговорКонтрагента,
		|	ВедомостьВыпадающихДоходов.СчетРасчетов,
		|	ВЫБОР
		|		КОГДА НЕ &ИспользоватьВалютныйУчет
		|				ИЛИ ВедомостьВыпадающихДоходов.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА &ВалютаРеглУчета
		|		ИНАЧЕ ВедомостьВыпадающихДоходов.Валюта
		|	КОНЕЦ,
		|	ВедомостьВыпадающихДоходов.Ссылка.ИФО,
		|	ВедомостьВыпадающихДоходов.КФО,
		|	ВедомостьВыпадающихДоходов.КПС,
		|	ВедомостьВыпадающихДоходов.КОСГУ,
		|	&ДатаПроведения,
		|	ВЫБОР
		|		КОГДА НЕ &ИспользоватьВалютныйУчет
		|				ИЛИ ВедомостьВыпадающихДоходов.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|				ИЛИ ВедомостьВыпадающихДоходов.Валюта = &ВалютаРеглУчета
		|			ТОГДА -1 * ВедомостьВыпадающихДоходов.Сумма
		|		ИНАЧЕ -1 * ВедомостьВыпадающихДоходов.СуммаВВалюте
		|	КОНЕЦ
		|ИЗ
		|	Документ.ВедомостьВыпадающихДоходов.Начисления КАК ВедомостьВыпадающихДоходов
		|ГДЕ
		|	ВедомостьВыпадающихДоходов.Ссылка = &Ссылка
		|	И ВедомостьВыпадающихДоходов.ДоговорКонтрагента.ВестиПланГрафикИсполнения
		|	И ВедомостьВыпадающихДоходов.АвтоматическиОтразитьВГрафикахИсполненияДоговоров";
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		
		Результат = Запрос.ВыполнитьПакет();
		
		ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
		БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.ВедомостьВыпадающихДоходов";
	МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	
	ОбъектовОбработано = 0;
	ПроблемныхОбъектов = 0;
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			ПредставлениеОбъекта = Строка(Выборка.Ссылка);
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			
			Если Объект = Неопределено Тогда
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Иначе
				Объект.Заблокировать();
				Для Каждого СтрокаТЧ Из Объект.Начисления Цикл
					СтрокаТЧ.ВидДохода = Объект.УдалитьКорСчет;
				КонецЦикла;
				
				Если Объект.Модифицированность() Тогда
					ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
				Иначе
					ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
				КонецЕсли;
				
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось обработать объект: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбновлениеИнформационнойБазы.ЗаписатьОшибкуВЖурналРегистрации(
						Выборка.Ссылка,
						ПредставлениеОбъекта,
						ТекстСообщения,
						УровеньЖурналаРегистрации.Предупреждение);
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			// Прервать текущую итерацию цикла, чтобы не увеличивать счетчик обработанных объектов.
			Продолжить;
			
		КонецПопытки;
		
		ОбъектовОбработано = ОбъектовОбработано + 1;
		
	КонецЦикла;
	
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		ТекстСообщения = СтрШаблон(
					НСтр("ru = 'Не удалось обработать некоторые документы ""%1"" (пропущены): %2'"),
					МетаданныеДокумента.Синоним,
					ПроблемныхОбъектов);
		ВызватьИсключение ТекстСообщения;
	Иначе
		ОбновлениеИнформационнойБазы.ЗаписатьОшибкуВЖурналРегистрации(
						МетаданныеДокумента,
						МетаданныеДокумента.Синоним,
						СтрШаблон(НСтр("ru = 'Обработана очередная порция документов ""%1"": %2'"), МетаданныеДокумента.Синоним, ОбъектовОбработано),
						УровеньЖурналаРегистрации.Информация);
	КонецЕсли;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВедомостьВыпадающихДоходовНачисления.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВедомостьВыпадающихДоходов.Начисления КАК ВедомостьВыпадающихДоходовНачисления
	|ГДЕ
	|	ВедомостьВыпадающихДоходовНачисления.ВидДохода = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)";
	
	РегистрируемыеСсылки = Новый Массив;
	КоличествоСсылок = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		РегистрируемыеСсылки.Добавить(Выборка.Ссылка);
		КоличествоСсылок = КоличествоСсылок + 1;
		
		Если КоличествоСсылок = 1000 Тогда
			ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, РегистрируемыеСсылки);
			РегистрируемыеСсылки.Очистить();
			КоличествоСсылок = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Если РегистрируемыеСсылки.Количество() > 0 Тогда
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, РегистрируемыеСсылки);
	КонецЕсли;
	
КонецПроцедуры

