	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВедомостьВыпадающихДоходовГруппыУчета.Ссылка КАК Ссылка,
	|	ВедомостьВыпадающихДоходовГруппыУчета.НомерСтроки КАК НомерСтроки,
	|	ВедомостьВыпадающихДоходовГруппыУчета.ГруппаУчета.Наименование КАК ГруппаУчета,
	|	ВедомостьВыпадающихДоходовГруппыУчета.КлючСтроки КАК КлючСтроки
	|ИЗ
	|	Документ.ВедомостьВыпадающихДоходов.ГруппыУчета КАК ВедомостьВыпадающихДоходовГруппыУчета
	|ГДЕ
	|	ВедомостьВыпадающихДоходовГруппыУчета.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки,
	|	КлючСтроки";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
		
	Результат = Запрос.ВыполнитьПакет();
	Выборка 	= Результат[0].Выбрать();	
	Начисления 	= Результат[1].Выгрузить();
	ГруппыУчета	= Результат[2].Выгрузить();

	
	Начисления.Колонки.Добавить("КБК", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(20)));
	Начисления.Колонки.Добавить("НомерНаПечать", Новый ОписаниеТипов("Строка"));
			
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ВедомостьВыпадающихДоходов_ПФ_MXL_Форма0510838";
    	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ВедомостьВыпадающихДоходов.ПФ_MXL_Форма0510838");
	
	ОбластьМакетаШапка         	= Макет.ПолучитьОбласть("Шапка");
	ОбластьМакетаЗаголовок_2   	= Макет.ПолучитьОбласть("Заголовок_2");
	ОбластьМакетаПодвал 		= Макет.ПолучитьОбласть("Подвал");
		
	ПервыйДокумент = Истина;
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
        ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;  
		
		ОбщиеСведенияОрг =  ОбщиеСведения.Получить(Выборка.Ссылка);  
