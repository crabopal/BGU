#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	НепроверяемыеРеквизиты.Добавить("Начисления.ДоговорКонтрагента");
	НепроверяемыеРеквизиты.Добавить("Начисления.ВидРасчетов");
	НепроверяемыеРеквизиты.Добавить("Начисления.ОплатитьДо");
	
	ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	Если ИспользоватьКонтрольИсполненияДоговоров Тогда
		
		Для Каждого СтрокаТаблицы Из Начисления Цикл
			
			Если СтрокаТаблицы.АвтоматическиОтразитьВГрафикахИсполненияДоговоров Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДоговорКонтрагента) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Договор'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Начисления'"));
					ПолеОшибки = "Начисления[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДоговорКонтрагента";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
					Продолжить;
				КонецЕсли;
				
				РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицы.ДоговорКонтрагента, "ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
				
				Если НЕ РеквизитыДоговора.ВестиГрафикПлатежей Тогда
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Для автоматического отражения в графике платежей, в том числе, учета задолженности в разрезе дат исполнения, следует установить признак ""График платежей"" в группе ""Вести графики исполнения"" в карточке договора ""%1"".'"),
							СтрокаТаблицы.ДоговорКонтрагента);
					ПолеКолонки = "Начисления[" + Формат(СтрокаТаблицы.НомерСтроки-1, "ЧН=0; ЧГ=") + "].ДоговорКонтрагента";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеКолонки, "Объект", Отказ);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ВидРасчетов) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Вид расчетов'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Начисления'"));
					ПолеОшибки = "Начисления[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ВидРасчетов";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ОплатитьДо) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Оплатить до'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Начисления'"));
					ПолеОшибки = "Начисления[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ОплатитьДо";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из Начисления Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетРасчетов) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Не определен счет расчетов по ""КОСГУ"" и ""Виду дохода"" в строке %1.
			|Проверьте настройки в регистре сведений ""Соответствия аналитических счетов КЭК""
			|или укажите счет вручную (отображение счета включается командой Еще - показать счета расчетов).'"),
				СтрокаТаблицы.НомерСтроки);
			ПолеОшибки = СтрШаблон("Начисления[%1].КОСГУ", Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ="));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
		
	СуммаДокумента = Начисления.Итог("Сумма");
		
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли