&НаСервере
Процедура ЗаполнитьСчетКЭКПоДоговоруНаСервере()
	
	ДанныеСтроки = Объект.Начисления.НайтиПоИдентификатору(Элементы.Начисления.ТекущаяСтрока);
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("Договоры",	ДанныеСтроки.ДоговорКонтрагента);
	ПараметрыЗапроса.Вставить("Контрагенты",	ДанныеСтроки.Контрагент);
	ПараметрыЗапроса.Вставить("КПС",			ДанныеСтроки.КПС);
	ПараметрыЗапроса.Вставить("КФО",			ДанныеСтроки.КФО);
	
	СчетКЭК = Документы.ВедомостьВыпадающихДоходов.СчетКЭКПоДоговору(Объект.Организация, Объект.ИФО, Объект.Дата, ПараметрыЗапроса);
	
	Если СчетКЭК.Количество() = 1 Тогда
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, СчетКЭК[0], "КОСГУ, СчетРасчетов, ВидДохода");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВидДоходаПриИзмененииНаСервере()
	
	ДанныеСтроки = Объект.Начисления.НайтиПоИдентификатору(Элементы.Начисления.ТекущаяСтрока);
	ДанныеСтроки.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
				ДанныеСтроки.КОСГУ,
				ДанныеСтроки.ВидДохода, ,
				Объект.Дата,
				Объект.Организация,
				Объект.ИФО);
	
КонецПроцедуры

