КонецПроцедуры

&НаКлиенте
Процедура ГрупповаяПриИзменении(Элемент)
	
	Если Объект.Групповая Тогда 
		Если Объект.Начисления.Количество() > 0 Тогда	
			Объект.ГруппыУчета.Очистить();
			НоваяГруппа = Объект.ГруппыУчета.Добавить();
			НоваяГруппа.КлючСтроки = Новый УникальныйИдентификатор;
			Для Каждого Стр Из Объект.Начисления Цикл
				Стр.КлючСтроки = НоваяГруппа.КлючСтроки;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли  Объект.ГруппыУчета.Количество() > 0 Тогда
		Объект.ГруппыУчета.Очистить();
		Для Каждого Стр Из Объект.Начисления Цикл
			Стр.КлючСтроки = "";
		КонецЦикла;
	КонецЕсли;	
	
	УстановитьОтборСтрокВТаблицеНачисления();
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура РегламентирующийДокументПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.РегламентирующийДокумент) Тогда
		ЗаполнитьСкидкиНаСервере();
		ОбновитьРеквизитыРегламентирующегоДокумента();
	Иначе
		ЭтотОбъект.КЭШПараметров.Локальные.Вставить("ПроцентСкидки", 0);
		ЭтотОбъект.КЭШПараметров.Локальные.Вставить("СуммаСкидки", 0);
	КонецЕсли;
КонецПроцедуры

