&НаКлиенте
Процедура РассчитатьСтроку(Команда)
	
	ДанныеСтроки = Элементы.Начисления.ТекущиеДанные;
	
	Если Данныестроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Ошибки = "";
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Ошибки = Ошибки + "
		|" + НСтр("ru = 'Не заполнено поле Организация'")
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.Контрагент) Тогда
		Ошибки = Ошибки + "
		|" + НСтр("ru = 'Не заполнено поле Контрагент'")
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ДоговорКонтрагента) Тогда
		Ошибки = Ошибки + "
		|" + НСтр("ru = 'Не заполнено поле Договор'")
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.КПС) Тогда
		Ошибки = Ошибки + "
		|" + НСтр("ru = 'Не заполнено поле КПС'")
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.КФО) Тогда
		Ошибки = Ошибки + "
		|" + НСтр("ru = 'Не заполнено поле КФО'")
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ошибки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Ошибки);
		Возврат
	КонецЕсли;
	
	РссчитатьСтрокуНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура РссчитатьСтрокуНаСервере()
	
	ДанныеСтроки = Объект.Начисления.НайтиПоИдентификатору(Элементы.Начисления.ТекущаяСтрока);
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.СчетРасчетов) ИЛИ НЕ ЗначениеЗаполнено(ДанныеСтроки.КОСГУ) Тогда
		ЗаполнитьСчетКЭКПоДоговоруНаСервере();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ВидДохода) Тогда
		Ошибки = НСтр("ru = 'Не заполнено поле ""Вид дохода"" (не найдено начисленных доходов)'");
		ОбщегоНазначения.СообщитьПользователю(Ошибки);
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.КОСГУ) Тогда
		Ошибки = НСтр("ru = 'Не заполнено поле ""КОСГУ"" (не найдено начисленных доходов или отсутствует настройка в регистре сведений ""Соответствия аналитических счетов КЭК"")'");
		ОбщегоНазначения.СообщитьПользователю(Ошибки);
		Возврат;
	КонецЕсли;
	
	СуммыНачисленныхДоходов = Документы.ВедомостьВыпадающихДоходов.СуммыДоходаДляСтроки(Объект.Организация, Объект.ИФО, Объект.Дата, ДанныеСтроки);
	
	Если НЕ СуммыНачисленныхДоходов.Доход > 0 Тогда
		Ошибки = НСтр("ru = 'Не найдено начисленных доходов'");
		ОбщегоНазначения.СообщитьПользователю(Ошибки);
		Возврат;
	КонецЕсли;
	
	Если СуммыНачисленныхДоходов.Зачтено > 0 Тогда
		Ошибки = НСтр("ru = 'По указанным реквизитам уже начислены выпадающие доходы'");
		ОбщегоНазначения.СообщитьПользователю(Ошибки);
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки.СуммаДохода = СуммыНачисленныхДоходов.Доход;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.КЭШПараметров.Локальные.ПроцентСкидки) Тогда
		ДанныеСтроки.Сумма = ДанныеСтроки.СуммаДохода * ЭтотОбъект.КЭШПараметров.Локальные.ПроцентСкидки / 100;
	Иначе
		ДанныеСтроки.Сумма = Макс(0, ДанныеСтроки.СуммаДохода - ЭтотОбъект.КЭШПараметров.Локальные.СуммаСкидки);
	КонецЕсли;
	
	Если ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров Тогда
		
		ДанныеСтроки.АвтоматическиОтразитьВГрафикахИсполненияДоговоров = Ложь;
		
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеСтроки.ДоговорКонтрагента, "ВестиГрафикПлатежей");
		Если РеквизитыДоговора.ВестиГрафикПлатежей Тогда
			
			Отбор = Новый Структура;
			Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
				Отбор.Вставить("ИФО", Объект.ИФО);
			КонецЕсли;
			Отбор.Вставить("Контрагент", ДанныеСтроки.Контрагент);
			Отбор.Вставить("Договор", ДанныеСтроки.ДоговорКонтрагента);
			Отбор.Вставить("КФО", ДанныеСтроки.КФО);
			Отбор.Вставить("КПС", ДанныеСтроки.КПС);
			Если ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями Тогда
				Отбор.Вставить("КЭК", ДанныеСтроки.КОСГУ);
			КонецЕсли;
			Отбор.Вставить("СчетРасчетов", ДанныеСтроки.СчетРасчетов);
			
			Если НЕ ЭтотОбъект.КэшПараметров.ИспользоватьВалютныйУчет
				ИЛИ НЕ ЗначениеЗаполнено(ДанныеСтроки.Валюта) Тогда
				Отбор.Вставить("Валюта", ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
			Иначе
				Отбор.Вставить("Валюта", ДанныеСтроки.Валюта);
			КонецЕсли;
			
			Отбор.Вставить("Сумма", ДанныеСтроки.Сумма);
			
			НеисполненныеПлатежи = КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(Отбор, Объект.Организация);
			Если НеисполненныеПлатежи.Количество() = 1 Тогда
				ДанныеСтроки.АвтоматическиОтразитьВГрафикахИсполненияДоговоров = Истина;
				НеисполненныйПлатеж = НеисполненныеПлатежи[0];
				ЗаполнитьЗначенияСвойств(ДанныеСтроки, НеисполненныйПлатеж, "ВидРасчетов,ОплатитьДо");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

