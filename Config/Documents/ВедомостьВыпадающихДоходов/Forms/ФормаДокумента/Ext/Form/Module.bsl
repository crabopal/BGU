&НаКлиенте
Процедура РассчитатьСуммуСтрокиНаКлиенте(ДанныеСтроки)
	
	Если ЭтотОбъект.КэшПараметров.ИспользоватьВалютныйУчет Тогда 
		Если НЕ ЗначениеЗаполнено(ДанныеСтроки.Валюта)
			ИЛИ ДанныеСтроки.Валюта = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
			ДанныеСтроки.СуммаВВалюте = 0;
		ИначеЕсли ДанныеСтроки.СуммаВВалюте = 0 Тогда
			ДанныеСтроки.Сумма = 0;
		Иначе
			КурсКратность = ПолучитьКурс(ДанныеСтроки.Валюта, Объект.Дата);
			ДанныеСтроки.Сумма 	= ДанныеСтроки.СуммаВВалюте*КурсКратность.Курс/?(КурсКратность.Кратность=0, 1, КурсКратность.Кратность);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыСтрокНаСервере()
	
	Если НЕ ЭтотОбъект.КэшПараметров.ИспользоватьВалютныйУчет Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого ДанныеСтроки Из Объект.Начисления Цикл
		
		Если НЕ ЗначениеЗаполнено(ДанныеСтроки.Валюта)
			ИЛИ ДанныеСтроки.Валюта = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
			Если НЕ ДанныеСтроки.СуммаВВалюте = 0 Тогда
				ДанныеСтроки.СуммаВВалюте = 0;
				ЭтотОбъект.КэшПараметров.Служебные.ИзмениласьДатаДляКонтроляКурса = Истина;
			КонецЕсли;	
		ИначеЕсли ДанныеСтроки.СуммаВВалюте = 0 И НЕ ДанныеСтроки.Сумма = 0 Тогда
			ДанныеСтроки.Сумма = 0;
			ЭтотОбъект.КэшПараметров.Служебные.ИзмениласьДатаДляКонтроляКурса = Истина;
		Иначе
			КурсКратность = ПолучитьКурс(ДанныеСтроки.Валюта, Объект.Дата);
			НоваяСумма = ДанныеСтроки.СуммаВВалюте*КурсКратность.Курс/?(КурсКратность.Кратность=0, 1, КурсКратность.Кратность);
			Если НЕ ДанныеСтроки.Сумма = НоваяСумма Тогда
				ДанныеСтроки.Сумма = НоваяСумма;
				ЭтотОбъект.КэшПараметров.Служебные.ИзмениласьДатаДляКонтроляКурса = Истина;
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

