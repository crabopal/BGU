&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияВидРасчетов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияОплатитьДо");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Начисления.АвтоматическиОтразитьВГрафикахИсполненияДоговоров", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияВидДохода");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Начисления.ВидДохода", ВидСравненияКомпоновкиДанных.Равно, БухгалтерскийУчет.СчетПоКоду("205.00", Неопределено, Неопределено));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Администрируемые доходы (205.00)'"));
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияВидДохода");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Начисления.ВидДохода", ВидСравненияКомпоновкиДанных.Равно, БухгалтерскийУчет.СчетПоКоду("209.00", Неопределено, Неопределено));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Иные доходы (209.00)'"));
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрокВТаблицеНачисления()
	
	ТекущиеДанные = Элементы.ГруппыУчета.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Элементы.Начисления.ОтборСтрок = Неопределено;
	Иначе
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("КлючСтроки", ТекущиеДанные.КлючСтроки);
		ТекущийОтборСтрок = Элементы.Начисления.ОтборСтрок;
		Если ТекущийОтборСтрок = Неопределено
			ИЛИ ТекущийОтборСтрок.КлючСтроки <> НовыйОтборСтрок.КлючСтроки Тогда
			Элементы.Начисления.ОтборСтрок = НовыйОтборСтрок;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

