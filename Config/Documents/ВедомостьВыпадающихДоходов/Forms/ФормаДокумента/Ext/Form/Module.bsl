&НаКлиенте
Процедура ГруппыУчетаПриАктивизацииСтроки(Элемент)
	Если Объект.Групповая Тогда
		ПодключитьОбработчикОжидания("УстановитьОтборСтрокВТаблицеНачисления", 0.2, Истина); 
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ГруппыУчетаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Элементы.ГруппыУчета.ТекущиеДанные.КлючСтроки = Новый УникальныйИдентификатор;
		ПодключитьОбработчикОжидания("УстановитьОтборСтрокВТаблицеНачисления", 0.2, Истина); 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ГруппыУчетаПередУдалением(Элемент, Отказ)
	
	Если НЕ Отказ Тогда
		
		ТекущиеДанные = Элементы.ГруппыУчета.ТекущиеДанные;
		
		ОтборПоГруппе = Новый Структура("КлючСтроки", ТекущиеДанные.КлючСтроки);
		СтрокиПоГруппе = Объект.Начисления.НайтиСтроки(ОтборПоГруппе);
		Для Каждого СтрокаНачисления Из СтрокиПоГруппе Цикл
			Объект.Начисления.Удалить(Объект.Начисления.Индекс(СтрокаНачисления));
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппыУчетаГруппаУчетаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Отбор = Новый Структура("ГруппаУчета", ВыбранноеЗначение);
		НайденныеСтроки = Объект.ГруппыУчета.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			ПоказатьПредупреждение(, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Группа учета ""%1"" уже присутствует в списке.
			|Выберите другое значение.'"), ВыбранноеЗначение));
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНачисления

&НаКлиенте
Процедура НачисленияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентовКлиент.ТаблицаФормыВыбор(ЭтотОбъект, Элемент, Поле);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
КонецПроцедуры

&НаКлиенте
Процедура НачисленияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	Если НЕ Копирование Тогда
		ТекущаяГруппаУчета = Элементы.ГруппыУчета.ТекущиеДанные;
		Если ТекущаяГруппаУчета = Неопределено И Объект.Групповая Тогда
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
		
		Если НЕ Копирование Тогда
			
			ТекущаяГруппаУчета = Элементы.ГруппыУчета.ТекущиеДанные;
			
			Если ТекущаяГруппаУчета = Неопределено И Объект.Групповая Тогда
				Отказ = Истина;
			ИначеЕсли НЕ Объект.Групповая Тогда
				ТекущиеДанные.КлючСтроки = "";
			Иначе
				ТекущиеДанные.КлючСтроки = ТекущаяГруппаУчета.КлючСтроки; 
			КонецЕсли;
			
			Если ТекущиеДанные <> Неопределено Тогда
				ТекущиеДанные.ВидДохода = БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("205.00");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияКонтрагентПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	ТекущиеДанные.ИдентификаторПлательщика = ИдентификаторКонтрагента(ТекущиеДанные.Контрагент, Объект.ВидДокументаФизЛиц);
	
	// СтандартныеПодсистемы.РаботаСКонтрагентами
	ПроверкаКонтрагентовКлиент.ЗапуститьПроверкуКонтрагентовВДокументе(ЭтотОбъект, Элементы.Начисления);
	// Конец СтандартныеПодсистемы.РаботаСКонтрагентами
	
КонецПроцедуры

