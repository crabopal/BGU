&НаКлиенте
Процедура НачисленияДоговорКонтрагентаПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Элементы.Начисления.ТекущиеДанные.ДоговорКонтрагента) Тогда
		НачисленияДоговорКонтрагентаПриИзмененииНаСервере();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура НачисленияДоговорКонтрагентаПриИзмененииНаСервере()
	ДанныеСтроки = Объект.Начисления.НайтиПоИдентификатору(Элементы.Начисления.ТекущаяСтрока);
	РеквизитыКонтракта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеСтроки.ДоговорКонтрагента, "ВидОбязательства,ДатаДоговора,НомерДоговора"); 
	ДанныеСтроки.ВидПервичногоДокумента = РеквизитыКонтракта.ВидОбязательства;
	ДанныеСтроки.ДатаПервичногоДокумента = РеквизитыКонтракта.ДатаДоговора;
	ДанныеСтроки.НомерПервичногоДокумента = РеквизитыКонтракта.НомерДоговора;
КонецПроцедуры
	
&НаКлиенте
Процедура НачисленияКПСПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	БухгалтерскийУчетКлиент.ПроверитьОчиститьКЭК(ТекущиеДанные.КПС, ТекущиеДанные.КОСГУ);
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияКОСГУПриИзменении(Элемент)
	
	ТекДанные = Элементы.Начисления.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено И ЗначениеЗаполнено(ТекДанные.ВидДохода) Тогда
		КОСГУПриИзмененииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КОСГУПриИзмененииНаСервере()
	
	ДанныеСтроки = Объект.Начисления.НайтиПоИдентификатору(Элементы.Начисления.ТекущаяСтрока);
	ДанныеСтроки.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(ДанныеСтроки.КОСГУ,
							ДанныеСтроки.ВидДохода, ,
							Объект.Дата,
							Объект.Организация,
							Объект.ИФО);
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияОплатитьДоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	Отбор = Новый Структура("ВидРасчетов,КФО,КПС");
	ЗаполнитьЗначенияСвойств(Отбор, ТекущиеДанные);
	Отбор.Вставить("ЭтоПоступление", Истина);
	Отбор.Вставить("ИФО", Объект.ИФО);
	Отбор.Вставить("КЭК", ТекущиеДанные.КОСГУ);
	Отбор.Вставить("Контрагент", ТекущиеДанные.Контрагент);
	Отбор.Вставить("Договор", ТекущиеДанные.ДоговорКонтрагента);
	
	Если НЕ ЭтотОбъект.КэшПараметров.ИспользоватьВалютныйУчет
		ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.Валюта) Тогда
		Отбор.Вставить("Валюта", ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	Иначе
		Отбор.Вставить("Валюта", ТекущиеДанные.Валюта);
	КонецЕсли;
	
	СписокОчередныхПлатежей = СписокОчередныхПлатежейПоГрафику(Объект.Организация, ТекущиеДанные.ДоговорКонтрагента, Отбор);
	
	Элемент.СписокВыбора.Очистить();
	Для Каждого Платеж Из СписокОчередныхПлатежей Цикл
		Элемент.СписокВыбора.Добавить(Платеж.Значение, Платеж.Представление);
	КонецЦикла;
	
КонецПроцедуры

