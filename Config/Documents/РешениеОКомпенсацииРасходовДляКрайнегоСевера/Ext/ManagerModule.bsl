// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

Функция ДанныеДляВводаВедомостиНаВыдачуДенегИзКассы(МассивСсылок) Экспорт
	
	Результат = Новый Массив;
	
	ВалютаРегУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РешениеОКомпенсацииУсловияПроезда.Ссылка КАК Ссылка,
	|	РешениеОКомпенсацииУсловияПроезда.Ссылка.Организация КАК Организация,
	|	РешениеОКомпенсацииУсловияПроезда.Ссылка.ИФО КАК ИФО,
	|	РешениеОКомпенсацииУсловияПроезда.Ссылка.Сотрудник КАК Сотрудник,
	|	РешениеОКомпенсацииУсловияПроезда.Ссылка.Подразделение КАК Подразделение,
	|	РешениеОКомпенсацииУсловияПроезда.Сумма КАК Сумма,
	|	&ВалютаРегУчета КАК Валюта,
	|	РешениеОКомпенсацииУсловияПроезда.КФО КАК КФО,
	|	РешениеОКомпенсацииУсловияПроезда.КПС КАК КПС,
	|	РешениеОКомпенсацииУсловияПроезда.КЭК КАК КЭК
	|ПОМЕСТИТЬ ТаблицаРасходов
	|ИЗ
	|	Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера.УсловияПроезда КАК РешениеОКомпенсацииУсловияПроезда
	|ГДЕ
	|	РешениеОКомпенсацииУсловияПроезда.Ссылка В(&МассивСсылок)
	|	И РешениеОКомпенсацииУсловияПроезда.СпособОбеспечения = ЗНАЧЕНИЕ(Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РешениеОКомпенсацииПрочиеРасходы.Ссылка,
	|	РешениеОКомпенсацииПрочиеРасходы.Ссылка.Организация,
	|	РешениеОКомпенсацииПрочиеРасходы.Ссылка.ИФО,
	|	РешениеОКомпенсацииПрочиеРасходы.Ссылка.Сотрудник,
	|	РешениеОКомпенсацииПрочиеРасходы.Ссылка.Подразделение,
	|	РешениеОКомпенсацииПрочиеРасходы.Сумма,
	|	&ВалютаРегУчета,
	|	РешениеОКомпенсацииПрочиеРасходы.КФО,
	|	РешениеОКомпенсацииПрочиеРасходы.КПС,
	|	РешениеОКомпенсацииПрочиеРасходы.КЭК
	|ИЗ
	|	Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера.ПрочиеРасходы КАК РешениеОКомпенсацииПрочиеРасходы
	|ГДЕ
	|	РешениеОКомпенсацииПрочиеРасходы.Ссылка В(&МассивСсылок)
	|	И РешениеОКомпенсацииПрочиеРасходы.СпособОбеспечения = ЗНАЧЕНИЕ(Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаРасходов.Ссылка КАК Ссылка,
	|	ТаблицаРасходов.Организация КАК Организация,
	|	ТаблицаРасходов.ИФО КАК ИФО,
	|	ТаблицаРасходов.Сотрудник КАК Сотрудник,
	|	ТаблицаРасходов.Подразделение КАК Подразделение,
	|	СУММА(ТаблицаРасходов.Сумма) КАК Сумма,
	|	ТаблицаРасходов.Валюта КАК Валюта,
	|	ТаблицаРасходов.КФО КАК КФО,
	|	ТаблицаРасходов.КПС КАК КПС,
	|	ТаблицаРасходов.КЭК КАК КЭК
	|ПОМЕСТИТЬ ТаблицаРасходовСгруппированная
	|ИЗ
	|	ТаблицаРасходов КАК ТаблицаРасходов
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаРасходов.Ссылка,
	|	ТаблицаРасходов.Организация,
	|	ТаблицаРасходов.ИФО,
	|	ТаблицаРасходов.КЭК,
	|	ТаблицаРасходов.Сотрудник,
	|	ТаблицаРасходов.Подразделение,
	|	ТаблицаРасходов.КФО,
	|	ТаблицаРасходов.Валюта,
	|	ТаблицаРасходов.КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаРасходовСгруппированная.Организация КАК Организация,
	|	ТаблицаРасходовСгруппированная.Валюта КАК Валюта,
	|	ТаблицаРасходовСгруппированная.ИФО КАК ИФО,
	|	АВТОНОМЕРЗАПИСИ() КАК ИдентификаторНабора
	|ПОМЕСТИТЬ ТаблицаШапок
	|ИЗ
	|	ТаблицаРасходовСгруппированная КАК ТаблицаРасходовСгруппированная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаШапок.Организация КАК Организация,
	|	ТаблицаШапок.Валюта КАК Валюта,
	|	ТаблицаШапок.ИФО КАК ИФО,
	|	ТаблицаШапок.ИдентификаторНабора КАК ИдентификаторНабора,
	|	ТаблицаРасходовСгруппированная.Ссылка КАК ДокументОснование,
	|	ТаблицаРасходовСгруппированная.Сотрудник КАК Сотрудник,
	|	ТаблицаРасходовСгруппированная.Подразделение КАК ПодразделениеКор,
	|	ТаблицаРасходовСгруппированная.Сумма КАК Сумма,
	|	ТаблицаРасходовСгруппированная.КФО КАК КФО,
	|	ТаблицаРасходовСгруппированная.КПС КАК КПС,
	|	ТаблицаРасходовСгруппированная.КЭК КАК КЭК,
	|	СоответствияАналитическихСчетовКЭК.Счет КАК КорСчет
	|ИЗ
	|	ТаблицаШапок КАК ТаблицаШапок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаРасходовСгруппированная КАК ТаблицаРасходовСгруппированная
	|		ПО ТаблицаШапок.Организация = ТаблицаРасходовСгруппированная.Организация
	|			И ТаблицаШапок.Валюта = ТаблицаРасходовСгруппированная.Валюта
	|			И ТаблицаШапок.ИФО = ТаблицаРасходовСгруппированная.ИФО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияАналитическихСчетовКЭК КАК СоответствияАналитическихСчетовКЭК
	|		ПО (ТаблицаРасходовСгруппированная.КЭК = СоответствияАналитическихСчетовКЭК.КЭК)
	|			И (СоответствияАналитическихСчетовКЭК.Счет В (&Счет208))
	|			И (НЕ СоответствияАналитическихСчетовКЭК.Счет.ЭлементГруппа)
	|ИТОГИ
	|	МАКСИМУМ(Организация),
	|	МАКСИМУМ(Валюта),
	|	МАКСИМУМ(ИФО),
	|	СУММА(Сумма)
	|ПО
	|	ИдентификаторНабора";
	
	Запрос.УстановитьПараметр("ВалютаРегУчета", ВалютаРегУчета);
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	Запрос.УстановитьПараметр("Счет208",
		БухгалтерскийУчет.СписокСчетов("208.00", Новый Граница(МассивСсылок[0].МоментВремени())));
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Ведомость = Новый Структура;
		Ведомость.Вставить("Организация", ВыборкаШапка.Организация);
		Ведомость.Вставить("Валюта", ВыборкаШапка.Валюта);
		Ведомость.Вставить("ИФО", ВыборкаШапка.ИФО);
		Ведомость.Вставить("Ключ", Строка(ВыборкаШапка.Организация) + Строка(ВыборкаШапка.Валюта) + Строка(ВыборкаШапка.ИФО));
		
		ВедомостьТЧ = Новый Массив;
		ВыборкаСтроки = ВыборкаШапка.Выбрать();
		Пока ВыборкаСтроки.Следующий() Цикл
			СтрокаТЧ = Новый Структура;
			СтрокаТЧ.Вставить("Сотрудник", ВыборкаСтроки.Сотрудник);
			СтрокаТЧ.Вставить("ДокументОснование", ВыборкаСтроки.ДокументОснование);
			СтрокаТЧ.Вставить("КорСчет", ВыборкаСтроки.КорСчет);
			СтрокаТЧ.Вставить("ПодразделениеКор", ВыборкаСтроки.ПодразделениеКор);
			СтрокаТЧ.Вставить("КФО", ВыборкаСтроки.КФО);
			СтрокаТЧ.Вставить("КПС", ВыборкаСтроки.КПС);
			СтрокаТЧ.Вставить("КЭК", ВыборкаСтроки.КЭК);
			СтрокаТЧ.Вставить("Сумма", ВыборкаСтроки.Сумма);
			ВедомостьТЧ.Добавить(СтрокаТЧ);
		КонецЦикла;
		Ведомость.Вставить("РасшифровкаПлатежа", ВедомостьТЧ);
		
		Результат.Добавить(Ведомость);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера";
	КомандаПечати.Идентификатор = "ПФ_MXL_РешениеОКомпенсацииРасходов";
	КомандаПечати.Представление = НСтр("ru = 'Решение о компенсации расходов'");
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - Массив - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати - СписокЗначений - значение - ссылка на объект;
//                                            представление - имя области, в которой был выведен объект (выходной параметр);
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_РешениеОКомпенсацииРасходов") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_РешениеОКомпенсацииРасходов",
			"Решение о компенсации расходов",
			ПечатьРешенияОКомпенсацииРасходов(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьРешенияОКомпенсацииРасходов(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_РешениеОКомпенсацииРасходов";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера.ПФ_MXL_РешениеОКомпенсацииРасходов");
	
	ОбластьЗаголовок 								= Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапкаСоставСемьи 						= Макет.ПолучитьОбласть("ШапкаСоставСемьи");
	ОбластьСтрокаСоставСемьи 						= Макет.ПолучитьОбласть("СтрокаСоставСемьи");
	ОбластьПодвалСоставСемьи 						= Макет.ПолучитьОбласть("ПодвалСоставСемьи");
	ОбластьШапкаУсловияПроезда 						= Макет.ПолучитьОбласть("ШапкаУсловияПроезда");
	ОбластьСтрокаУсловияПроезда 					= Макет.ПолучитьОбласть("СтрокаУсловияПроезда");
	ОбластьШапкаРасчетОбязательств 					= Макет.ПолучитьОбласть("ШапкаРасчетОбязательств");
	ОбластьСтрокаРасчетОбязательств 				= Макет.ПолучитьОбласть("СтрокаРасчетОбязательств");
	ОбластьИтогоРасчетОбязательств 					= Макет.ПолучитьОбласть("ИтогоРасчетОбязательств");
	ОбластьСтрокаСпособВыдачиДенежныхСредств 		= Макет.ПолучитьОбласть("СтрокаСпособВыдачиДенежныхСредств");
	ОбластьСтрокаЗадолженностьВсегоПервая 			= Макет.ПолучитьОбласть("СтрокаЗадолженностьВсегоПервая");
	ОбластьСтрокаЗадолженностьВсего 				= Макет.ПолучитьОбласть("СтрокаЗадолженностьВсего");
	ОбластьСтрокаЗадолженностьНаПроверкеПервая 		= Макет.ПолучитьОбласть("СтрокаЗадолженностьНаПроверкеПервая");
	ОбластьСтрокаЗадолженностьНаПроверке 			= Макет.ПолучитьОбласть("СтрокаЗадолженностьНаПроверке");
	ОбластьСтрокаЗадолженностьПросроченнаяПервая 	= Макет.ПолучитьОбласть("СтрокаЗадолженностьПросроченнаяПервая");
	ОбластьСтрокаЗадолженностьПросроченная 			= Макет.ПолучитьОбласть("СтрокаЗадолженностьПросроченная");
	ОбластьПодвалЗадолженность 						= Макет.ПолучитьОбласть("ПодвалЗадолженность");
	ОбластьШапкаФинансовоеОбеспечение 				= Макет.ПолучитьОбласть("ШапкаФинансовоеОбеспечение");
	ОбластьСтрокаФинансовоеОбеспечение 				= Макет.ПолучитьОбласть("СтрокаФинансовоеОбеспечение");
	ОбластьПодвалФинансовоеОбеспечение 				= Макет.ПолучитьОбласть("ПодвалФинансовоеОбеспечение");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РешениеОКомпенсацииРасходовДляКрайнегоСевера.Ссылка КАК Ссылка,
	|	РешениеОКомпенсацииРасходовДляКрайнегоСевера.Номер КАК Номер,
	|	РешениеОКомпенсацииРасходовДляКрайнегоСевера.Дата КАК Дата,
	|	РешениеОКомпенсацииРасходовДляКрайнегоСевера.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА РешениеОКомпенсацииРасходовДляКрайнегоСевера.Организация.НаименованиеПолное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА РешениеОКомпенсацииРасходовДляКрайнегоСевера.Организация.НаименованиеСокращенное = """"
	|						ТОГДА РешениеОКомпенсацииРасходовДляКрайнегоСевера.Организация.Наименование
	|					ИНАЧЕ РешениеОКомпенсацииРасходовДляКрайнегоСевера.Организация.НаименованиеСокращенное
	|				КОНЕЦ
	|		ИНАЧЕ РешениеОКомпенсацииРасходовДляКрайнегоСевера.Организация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОрганизации,
	|	РешениеОКомпенсацииРасходовДляКрайнегоСевера.Организация.КодПоРПБС КАК КодПоСводномуРееструОрганизации,
	|	РешениеОКомпенсацииРасходовДляКрайнегоСевера.Подразделение КАК Подразделение,
