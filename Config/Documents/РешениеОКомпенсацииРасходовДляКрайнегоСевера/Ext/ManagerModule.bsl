		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(СтруктураДанных.Дата);
		СтруктураДанных.Вставить("ЧислоДаты", 	СтруктураДаты.Число);
		СтруктураДанных.Вставить("МесяцДаты", 	СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДаты", 	СтруктураДаты.Год);
		
		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(СтруктураДанных.ДатаУтверждения);
		СтруктураДанных.Вставить("ЧислоДатыУтв",СтруктураДаты.Число);
		СтруктураДанных.Вставить("МесяцДатыУтв",СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДатыУтв", 	СтруктураДаты.Год);
		
		СтруктураДанных.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(СтруктураДанных.Ссылка, СтруктураДанных.Номер);
		
		СтруктураПоискаТЧ = Новый Структура("Ссылка", Выборка.Ссылка);
		
		ОбластьЗаголовок.Параметры.Заполнить(СтруктураДанных);
		ДатаНачала = ?(ЗначениеЗаполнено(СтруктураДанных.ДатаНачалаПериодаКомпенсации), Формат(СтруктураДанных.ДатаНачалаПериодаКомпенсации, "ДФ=дд.ММ.гггг"), "...");
		ДатаОкончания = Формат(СтруктураДанных.ДатаОкончанияПериодаКомпенсации, "ДФ=дд.ММ.гггг");
		ОбластьЗаголовок.Параметры.ПериодКомпенсации = СтрШаблон("%1 - %2", ДатаНачала, ДатаОкончания);
		
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		ТабличныйДокумент.Вывести(ОбластьШапкаСоставСемьи);
		
		СтрокиСоставСемьи = СтруктураДанных.СоставСемьи.Выбрать();
		СтрокиПодтверждающиеДокументы = СтруктураДанных.ПодтверждающиеДокументы.Выбрать();
		
		Пока СтрокиСоставСемьи.Следующий() Цикл
			
			НомерПервойСтроки = ТабличныйДокумент.ВысотаТаблицы + 1;
			
			ЗаполнитьЗначенияСвойств(ОбластьСтрокаСоставСемьи.Параметры, СтрокиСоставСемьи);
			ОбластьСтрокаСоставСемьи.Параметры.ФИО = СокрЛП(СтрокиСоставСемьи.Фамилия + " "
				+ СтрокиСоставСемьи.Имя + " " + СтрокиСоставСемьи.Отчество);
			
			СтруктураПоискаДокументов = Новый Структура("ИдентификаторСтроки", СтрокиСоставСемьи.ИдентификаторСтроки);
			
			СтрокиПодтверждающиеДокументы.Сбросить();
			Пока СтрокиПодтверждающиеДокументы.НайтиСледующий(СтруктураПоискаДокументов) Цикл
				ЗаполнитьЗначенияСвойств(ОбластьСтрокаСоставСемьи.Параметры, СтрокиПодтверждающиеДокументы);
				ОбластьСтрокаСоставСемьи.Параметры.НомерСтроки = СтрокиСоставСемьи.НомерСтроки;
				ТабличныйДокумент.Вывести(ОбластьСтрокаСоставСемьи);
			КонецЦикла;
			
			// Если подтверждающих документов не выводилось, то выведем строку с ФИО
			Если НомерПервойСтроки > ТабличныйДокумент.ВысотаТаблицы Тогда
				ТабличныйДокумент.Вывести(ОбластьСтрокаСоставСемьи);
			// Если было выведено более одного документа, то необходимо объединить строки ФИО
			ИначеЕсли НомерПервойСтроки < ТабличныйДокумент.ВысотаТаблицы Тогда
				ОбластьДляОбъединения = ТабличныйДокумент.Область(НомерПервойСтроки, 1, ТабличныйДокумент.ВысотаТаблицы, 2);
				ОбластьДляОбъединения.Объединить();
				ОбластьДляОбъединения = ТабличныйДокумент.Область(НомерПервойСтроки, 3, ТабличныйДокумент.ВысотаТаблицы, 18);
				ОбластьДляОбъединения.Объединить();
				ОбластьДляОбъединения = ТабличныйДокумент.Область(НомерПервойСтроки, 19, ТабличныйДокумент.ВысотаТаблицы, 22);
				ОбластьДляОбъединения.Объединить();
				ОбластьДляОбъединения = ТабличныйДокумент.Область(НомерПервойСтроки, 23, ТабличныйДокумент.ВысотаТаблицы, 26);
				ОбластьДляОбъединения.Объединить();
			КонецЕсли;
			
		КонецЦикла;
		
		ОбластьПодвалСоставСемьи.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьПодвалСоставСемьи);
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ТабличныйДокумент.Вывести(ОбластьШапкаУсловияПроезда);
		
		СтрокиУсловияПроезда.Сбросить();
		Пока СтрокиУсловияПроезда.НайтиСледующий(СтруктураПоискаТЧ) Цикл
			ОбластьСтрокаУсловияПроезда.Параметры.Заполнить(СтрокиУсловияПроезда);
			ТабличныйДокумент.Вывести(ОбластьСтрокаУсловияПроезда);
		КонецЦикла;
		
		ТабличныйДокумент.Вывести(ОбластьШапкаРасчетОбязательств);
		
		НомерСтроки = 1;
		ИтогоСумма = 0;
		
		СтрокиУсловияПроезда.Сбросить();
		Пока СтрокиУсловияПроезда.НайтиСледующий(СтруктураПоискаТЧ) Цикл
			
			ЗаполнитьЗначенияСвойств(ОбластьСтрокаРасчетОбязательств.Параметры, СтрокиУсловияПроезда);
			
			ОбластьСтрокаРасчетОбязательств.Параметры.НомерСтроки = НомерСтроки;
			ОбластьСтрокаРасчетОбязательств.Параметры.Количество = 1;
			ОбластьСтрокаРасчетОбязательств.Параметры.Цена = СтрокиУсловияПроезда.Сумма;
			
			ТабличныйДокумент.Вывести(ОбластьСтрокаРасчетОбязательств);
			
			НомерСтроки = НомерСтроки + 1;
			
			ИтогоСумма = ИтогоСумма + СтрокиУсловияПроезда.Сумма;
			
		КонецЦикла;
		
		СтрокиПрочиеРасходы = СтруктураДанных.ПрочиеРасходы.Выбрать();
		Пока СтрокиПрочиеРасходы.Следующий() Цикл
			
			ЗаполнитьЗначенияСвойств(ОбластьСтрокаРасчетОбязательств.Параметры, СтрокиПрочиеРасходы);
			
			ОбластьСтрокаРасчетОбязательств.Параметры.НомерСтроки = НомерСтроки;
			
			ТабличныйДокумент.Вывести(ОбластьСтрокаРасчетОбязательств);
			
			НомерСтроки = НомерСтроки + 1;
			
			ИтогоСумма = ИтогоСумма + СтрокиПрочиеРасходы.Сумма;
			
		КонецЦикла;
		
		ОбластьИтогоРасчетОбязательств.Параметры.ИтогоСумма = ИтогоСумма;
		ТабличныйДокумент.Вывести(ОбластьИтогоРасчетОбязательств);
		
		ОбластьСтрокаСпособВыдачиДенежныхСредств.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьСтрокаСпособВыдачиДенежныхСредств);
		
		СтрокиЗадолженность = СтруктураДанных.Задолженность.Выбрать();
		
		Если СтрокиЗадолженность.Количество() = 0 Тогда
			ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьВсегоПервая);
			ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьНаПроверкеПервая);
			ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьПросроченнаяПервая);
		КонецЕсли;
		
		НомерОбхода = 0;
		Пока НомерОбхода < 3 Цикл
			НомерОбхода = НомерОбхода + 1;
			Пока СтрокиЗадолженность.Следующий() Цикл
				Если НомерОбхода = 1 Тогда
					ОбластьЗадолженность = ?(СтрокиЗадолженность.НомерСтроки = 1, ОбластьСтрокаЗадолженностьВсегоПервая, ОбластьСтрокаЗадолженностьВсего);
					ОбластьЗадолженность.Параметры.ВалютаКод = СтрокиЗадолженность.ВалютаКод;
					Если СтрокиЗадолженность.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
						ОбластьЗадолженность.Параметры.СуммаВал = 0;
					Иначе
						ОбластьЗадолженность.Параметры.СуммаВал = СтрокиЗадолженность.Сумма;
					КонецЕсли;
					ОбластьЗадолженность.Параметры.Сумма = СтрокиЗадолженность.СуммаРуб;
					ТабличныйДокумент.Вывести(ОбластьЗадолженность);
				ИначеЕсли НомерОбхода = 2 И СтрокиЗадолженность.СуммаНаПроверкеРуб <> 0 Тогда
					ОбластьЗадолженность = ?(СтрокиЗадолженность.НомерСтроки = 1, ОбластьСтрокаЗадолженностьНаПроверкеПервая, ОбластьСтрокаЗадолженностьНаПроверке);
					ОбластьЗадолженность.Параметры.ВалютаКод = СтрокиЗадолженность.ВалютаКод;
					Если СтрокиЗадолженность.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
						ОбластьЗадолженность.Параметры.СуммаВал = 0;
					Иначе
						ОбластьЗадолженность.Параметры.СуммаВал = СтрокиЗадолженность.СуммаНаПроверке;
					КонецЕсли;
					ОбластьЗадолженность.Параметры.Сумма = СтрокиЗадолженность.СуммаНаПроверкеРуб;
					ТабличныйДокумент.Вывести(ОбластьЗадолженность);
				ИначеЕсли НомерОбхода = 3 И СтрокиЗадолженность.СуммаПросроченнаяРуб <> 0 Тогда
					ОбластьЗадолженность = ?(СтрокиЗадолженность.НомерСтроки = 1, ОбластьСтрокаЗадолженностьПросроченнаяПервая, ОбластьСтрокаЗадолженностьПросроченная);
					ОбластьЗадолженность.Параметры.ВалютаКод = СтрокиЗадолженность.ВалютаКод;
					Если СтрокиЗадолженность.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
						ОбластьЗадолженность.Параметры.СуммаВал = 0;
					Иначе
						ОбластьЗадолженность.Параметры.СуммаВал = СтрокиЗадолженность.СуммаПросроченная;
					КонецЕсли;
					ОбластьЗадолженность.Параметры.Сумма = СтрокиЗадолженность.СуммаПросроченнаяРуб;
					ТабличныйДокумент.Вывести(ОбластьЗадолженность);
				КонецЕсли;
			КонецЦикла;
			СтрокиЗадолженность.Сбросить();
		КонецЦикла;    
		
		//если не все строки СПРАВОЧНО было выведены ранее
		Если ТабличныйДокумент.Области.Найти("СтрокаЗадолженностьНаПроверкеПервая") = Неопределено Тогда
			 ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьНаПроверкеПервая);
		КонецЕсли;     
		Если ТабличныйДокумент.Области.Найти("СтрокаЗадолженностьПросроченнаяПервая") = Неопределено Тогда
			 ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьПросроченнаяПервая);
	    КонецЕсли; 
		
		ОбластьПодвалЗадолженность.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьПодвалЗадолженность);
		
		ОбластьШапкаФинансовоеОбеспечение.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьШапкаФинансовоеОбеспечение);
		
		СтрокиФинансовоеОбеспечение = СтруктураДанных.ФинансовоеОбеспечение.Выбрать();
		Пока СтрокиФинансовоеОбеспечение.Следующий() Цикл
			ОбластьСтрокаФинансовоеОбеспечение.Параметры.Заполнить(СтрокиФинансовоеОбеспечение);
			ТабличныйДокумент.Вывести(ОбластьСтрокаФинансовоеОбеспечение);
		КонецЦикла;
		
		ОбластьПодвалФинансовоеОбеспечение.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьПодвалФинансовоеОбеспечение);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Заполнение реквизита "СуммаДокумента" шапки и "СуммаАванса" табличной части "Финансовое обеспечение"
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РешениеОКомпенсацииУсловияПроезда.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ РешенияСВозмещениемПоФакту
	|ИЗ
	|	Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера.УсловияПроезда КАК РешениеОКомпенсацииУсловияПроезда
	|ГДЕ
	|	РешениеОКомпенсацииУсловияПроезда.СпособОбеспечения = ЗНАЧЕНИЕ(Перечисление.СпособыОбеспеченияКомандировки.ВозмещениеПоФакту)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РешениеОКомпенсацииПрочиеРасходы.Ссылка
	|ИЗ
	|	Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера.ПрочиеРасходы КАК РешениеОКомпенсацииПрочиеРасходы
	|ГДЕ
	|	РешениеОКомпенсацииПрочиеРасходы.СпособОбеспечения = ЗНАЧЕНИЕ(Перечисление.СпособыОбеспеченияКомандировки.ВозмещениеПоФакту)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РешениеОКомпенсацииФинансовоеОбеспечение.Ссылка КАК Ссылка,
	|	СУММА(РешениеОКомпенсацииФинансовоеОбеспечение.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ФинансовоеОбеспечениеСумма
	|ИЗ
	|	Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера.ФинансовоеОбеспечение КАК РешениеОКомпенсацииФинансовоеОбеспечение
	|
	|СГРУППИРОВАТЬ ПО
	|	РешениеОКомпенсацииФинансовоеОбеспечение.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РешениеОКомпенсацииФинансовоеОбеспечение.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера.ФинансовоеОбеспечение КАК РешениеОКомпенсацииФинансовоеОбеспечение
	|		ЛЕВОЕ СОЕДИНЕНИЕ РешенияСВозмещениемПоФакту КАК РешенияСВозмещениемПоФакту
	|		ПО РешениеОКомпенсацииФинансовоеОбеспечение.Ссылка = РешенияСВозмещениемПоФакту.Ссылка
	|ГДЕ
	|	РешениеОКомпенсацииФинансовоеОбеспечение.Сумма <> РешениеОКомпенсацииФинансовоеОбеспечение.СуммаАванса
	|	И РешенияСВозмещениемПоФакту.Ссылка ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РешениеОКомпенсацииРасходовДляКрайнегоСевера.Ссылка
	|ИЗ
	|	Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера КАК РешениеОКомпенсацииРасходовДляКрайнегоСевера
	|		ЛЕВОЕ СОЕДИНЕНИЕ ФинансовоеОбеспечениеСумма КАК ФинансовоеОбеспечениеСумма
	|		ПО РешениеОКомпенсацииРасходовДляКрайнегоСевера.Ссылка = ФинансовоеОбеспечениеСумма.Ссылка
	|ГДЕ
	|	РешениеОКомпенсацииРасходовДляКрайнегоСевера.СуммаДокумента <> ФинансовоеОбеспечениеСумма.Сумма";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	ВозмещениеПоФакту = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.ВозмещениеПоФакту");
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("УсловияПроезда");
	МассивТЧ.Добавить("ПрочиеРасходы");
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			// Объект не удается заблокировать - попробуем обработать его на следующей итерации.
			// Отдельно обрабатывать ошибку не требуется, т.к. в худшем случае обработчик зациклится
			// и прервется автоматически.
			ЗафиксироватьТранзакцию();
			Продолжить;
		КонецПопытки;
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Выборка.Ссылка) Тогда
			// Вероятно был удален раньше, чем обработчик дошел до него
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		
		// Проверка, есть ли в документе способы обеспечения с возмещением по факту
		ЕстьВозмещениеПоФакту = Ложь;
		Для Каждого ТЧ Из МассивТЧ Цикл
			Для Каждого СтрокаТаблицы Из Объект[ТЧ] Цикл
				Если СтрокаТаблицы.СпособОбеспечения = ВозмещениеПоФакту Тогда
					ЕстьВозмещениеПоФакту = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЕстьВозмещениеПоФакту Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ЕстьВозмещениеПоФакту Тогда
			Для Каждого СтрокаТаблицы Из Объект.ФинансовоеОбеспечение Цикл
				
				Если СтрокаТаблицы.СуммаАванса <> СтрокаТаблицы.Сумма Тогда
					СтрокаТаблицы.СуммаАванса = СтрокаТаблицы.Сумма;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		Объект.СуммаДокумента = Объект.ФинансовоеОбеспечение.Итог("Сумма");
		
		Если Не Объект.Модифицированность() Тогда
			
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
			
		КонецЕсли;
		
		Попытка
		
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.РешениеОКомпенсацииРасходовДляКрайнегоСевера,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
