#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = ФинансовоеОбеспечение.Итог("Сумма");
	
	Если ДатаНачалаОтпуска > ДатаОкончанияОтпуска Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Некорректный период отпуска'"), ,
			"Объект.ДатаНачалаОтпуска", , Отказ)
	КонецЕсли;
	
	Если ДатаНачалаПериодаКомпенсации > ДатаОкончанияПериодаКомпенсации Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Некорректный период компенсации'"), ,
			"Объект.ДатаНачалаПериодаКомпенсации", , Отказ)
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаНачалаОтпуска) И ДатаНачалаОтпуска < ДатаПриемаНаРаботу Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Дата начала отпуска не может быть ранее даты приема на работу'"), ,
			"Объект.ДатаНачалаОтпуска", , Отказ)
	КонецЕсли;
	
	Для Каждого УсловиеПроезда Из УсловияПроезда Цикл
		Если УсловиеПроезда.ДатаОтправления > УсловиеПроезда.ДатаПрибытия Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru = 'Дата отправления больше даты прибытия'"), ,
				"Объект.УсловияПроезда[" + УсловияПроезда.Индекс(УсловиеПроезда) + "].ДатаОтправления", , Отказ)
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЧленСемьи Из СоставСемьи Цикл
		Если ЧленСемьи.СтепеньРодства <> НСтр("ru = 'Сын'")
			И ЧленСемьи.СтепеньРодства <> НСтр("ru = 'Дочь'") Тогда
			Продолжить;
		КонецЕсли;
		Если ДобавитьМесяц(ЧленСемьи.ДатаРождения, 216) <= ДатаНачалаОтпуска
			// согласно ПП РФ от 19.06.2020 N 887
			// дети (члены семьи работника), которым в 2020 или 2021 году исполнилось либо исполнится 18 лет, сохраняют право
			// на компенсацию расходов к месту использования работником отпуска и обратно соответственно в 2021 или в 2022 году
			И НЕ (ЧленСемьи.ДатаРождения >= Дата(2003, 1, 1) И Год(ДатаНачалаОтпуска) = 2022) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru = 'Предупреждение: компенсация расходов осуществляется только для несовершеннолетних детей'"), ,
				"Объект.СоставСемьи[" + СоставСемьи.Индекс(ЧленСемьи) + "].ДатаРождения")
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ДатаУтверждения = Неопределено;
	
	Задолженность.Очистить();
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(ДатаУтверждения) И ДатаУтверждения < Дата Тогда
		ТекстСообщения = НСтр("ru='Дата утверждения не может быть меньше даты документа.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ДатаУтверждения", "Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
