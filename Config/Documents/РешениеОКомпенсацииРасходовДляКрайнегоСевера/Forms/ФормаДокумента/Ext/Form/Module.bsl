#Область ОбработчикиСобытийЭлементовТаблицыФормыСоставСемьи

&НаКлиенте
Процедура СоставСемьиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "СоставСемьиДокументы" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		РедактированиеСпискаДокументов(Элемент.ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставСемьиПередУдалением(Элемент, Отказ)
	УдалитьСтрокиПодтверждающиеДокументы(Элемент.ВыделенныеСтроки);
КонецПроцедуры

&НаКлиенте
Процедура СоставСемьиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Копирование Тогда
		// скопируем также документы
		ТекущиеДокументы.Очистить();
		СтрокиДляКопирования = Объект.ПодтверждающиеДокументы.НайтиСтроки(
			Новый Структура("ИдентификаторСтроки", Элемент.ТекущиеДанные.ИдентификаторСтроки));
		Для Каждого Строка Из СтрокиДляКопирования Цикл
			ЗаполнитьЗначенияСвойств(ТекущиеДокументы.Добавить(), Строка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставСемьиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.СоставСемьи.ТекущиеДанные;
	
	ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	ИдентификаторТекущейСтроки = ТекущиеДанные.ИдентификаторСтроки;
	
	Если Копирование Тогда
		Для Каждого Строка Из ТекущиеДокументы Цикл
			НоваяСтрокаДокументы = Объект.ПодтверждающиеДокументы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДокументы,Строка);
			НоваяСтрокаДокументы.ИдентификаторСтроки = ТекущиеДанные.ИдентификаторСтроки;
		КонецЦикла;
	ИначеЕсли Объект.СоставСемьи.Количество() = 1 Тогда
		// Первую строку необходимо заполнить данными подотчетного лица
		
	КонецЕсли;
	
	ОбновитьТекстДокументыСтрокеТаблицыСоставСемьи(Объект, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура СоставСемьиПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если ОтменаРедактирования И НоваяСтрока Тогда
		
		УдалитьСтрокиПодтверждающиеДокументы(Элемент.ВыделенныеСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставСемьиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеФизЛица = ДанныеФизическогоЛица(ВыбранноеЗначение, Объект.Дата);
	
	НоваяСтрокаСостав = Объект.СоставСемьи.Добавить();
	НоваяСтрокаСостав.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	ЗаполнитьЗначенияСвойств(НоваяСтрокаСостав, ДанныеФизЛица);
	
	Для Каждого ПодтверждающийДокумент Из ДанныеФизЛица.ПодтверждающиеДокументы Цикл
		НоваяСтрокаДокумент = Объект.ПодтверждающиеДокументы.Добавить();
		НоваяСтрокаДокумент.ИдентификаторСтроки = НоваяСтрокаСостав.ИдентификаторСтроки;
		ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумент, ПодтверждающийДокумент);
	КонецЦикла;
	
	ОбновитьТекстДокументыСтрокеТаблицыСоставСемьи(Объект, НоваяСтрокаСостав);
	
	Элементы.СоставСемьи.ТекущаяСтрока = Объект.СоставСемьи.Количество() - 1;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыУсловияПроезда

&НаКлиенте
Процедура УсловияПроездаПриИзменении(Элемент)
	
	ОбновитьТаблицуФинансовоеОбеспечение();
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияПроездаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.УсловияПроезда.ТекущиеДанные;
	
	ОбновитьТекстЗаголовковВСтрокеТаблицыУсловияПроезда(ТекущаяСтрока);
	
	ТекущаяСтрока.СпособОбеспечения = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу");
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияПроездаВидТранспортногоСредстваПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.УсловияПроезда.ТекущиеДанные;
	
	ПересчитатьНормативыПроездаВСтрокеНаКлиенте(ТекущаяСтрока);
	
	ЗаполнитьНаименованиеРасходаПроезд(ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияПроездаПунктОтправленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.УсловияПроезда.ТекущиеДанные;
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидТранспорта", ТекущаяСтрока.ВидТранспорта);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОткрытьФорму("Справочник.ПунктыОтправленийПрибытий.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияПроездаПунктОтправленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("ДанныеФормыСтруктура") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Модифицированность = Истина;
	
	ТекущаяСтрока = Элементы.УсловияПроезда.ТекущиеДанные;
	ТекущаяСтрока.ПунктОтправления = ВыбранноеЗначение.Наименование;
	
	ЗаполнитьНаименованиеРасходаПроезд(ТекущаяСтрока);
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияПроездаПунктОтправленияАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	Если СтрДлина(Текст) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.УсловияПроезда.ТекущиеДанные;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидТранспорта", ТекущаяСтрока.ВидТранспорта);
	
	ПараметрыВыбораЗначения = Новый Структура;
	ПараметрыВыбораЗначения.Вставить("СтрокаПоиска", Текст);
	ПараметрыВыбораЗначения.Вставить("Отбор", Отбор);
	ПараметрыВыбораЗначения.Вставить("СпособПоискаСтроки", СпособПоискаСтрокиПриВводеПоСтроке.ЛюбаяЧасть);
	
	ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.ПунктыОтправленийПрибытий"), ПараметрыВыбораЗначения);
	Если ДанныеВыбора.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияПроездаПунктОтправленияПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.УсловияПроезда.ТекущиеДанные;
	
	ЗаполнитьНаименованиеРасходаПроезд(ТекущаяСтрока);
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
