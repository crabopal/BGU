#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
	ОрганизацииСовпадают = Не ЗначениеЗаполнено(Объект.ОрганизацияОсуществляющаяОбеспечение)
		ИЛИ Объект.Организация = Объект.ОрганизацияОсуществляющаяОбеспечение;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьЗадолженностьНаСервере()
	
	Объект.Задолженность.Очистить();
	
	ВыборкаЗадолженностьПоВалютам = РасчетыСПодотчетнымиЛицами.ЗадолженностьСотрудникаНаДатуПоВалютам(
		Объект.Организация, Объект.ИФО, Объект.Сотрудник, Объект.Дата);
	
	Пока ВыборкаЗадолженностьПоВалютам.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Объект.Задолженность.Добавить(), ВыборкаЗадолженностьПоВалютам);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	УстановитьОтветственныхЛиц(Объект.Руководитель, Объект.РуководительФинЭкономПодразделения,
		Объект.ОтветственныйИсполнительКадры, Объект.Организация, Объект.Дата, Объект.Подразделение);
	
	Если Объект.Организация = Объект.ОрганизацияОсуществляющаяОбеспечение Тогда
		ОрганизацииСовпадают = Истина;
	ИначеЕсли ОрганизацииСовпадают Тогда
		Объект.ОрганизацияОсуществляющаяОбеспечение = Объект.Организация;
	КонецЕсли;
	
	Объект.РазделЛицевогоСчета = Справочники.РазделыЛицевыхСчетов.РазделЛицевогоСчетаПоУмолчанию(Объект.Организация,
		Объект.Дата, "Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера", "РазделЛицевогоСчета");
	
	ОбновитьДанныеСотрудника();
	
	ПересчитатьЗадолженностьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	ПересчитатьЗадолженностьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСотрудникаНаСервере()
	
	ОбновитьДанныеСотрудника();
	
	ПеречитатьНормативыПроезда();
	
	ОбновитьТаблицуФинансовоеОбеспечение();
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
	ПересчитатьЗадолженностьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеСотрудника()
	
	ДанныеСотрудника = ОписаниеДанныхСотрудника(Объект.Сотрудник, Объект.Дата);
	
	Объект.Подразделение = ДанныеСотрудника.Подразделение;
	Объект.Должность = ДанныеСотрудника.Должность;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОписаниеДанныхСотрудника(Сотрудник, Дата)
	
	ТребуемыеДанные = Новый Структура;
	ТребуемыеДанные.Вставить("СсылкаНаОбъект", Сотрудник);
	ТребуемыеДанные.Вставить("Период", Дата);
	ТребуемыеДанные.Вставить("Подразделение");
	ТребуемыеДанные.Вставить("Должность");
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ТребуемыеДанные, Истина);
	
	Возврат ТребуемыеДанные;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()
	
	Для Каждого ТекущаяСтрока Из Объект.СоставСемьи Цикл
		ОбновитьТекстДокументыСтрокеТаблицыСоставСемьи(Объект, ТекущаяСтрока);
	КонецЦикла;
	
	Для Каждого ТекущаяСтрока Из Объект.УсловияПроезда Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыУсловияПроезда(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстДокументыСтрокеТаблицыСоставСемьи(Объект, СтрокаСостава)
	
	ДокументыЧленаСемьи = Объект.ПодтверждающиеДокументы.НайтиСтроки(
		Новый Структура("ИдентификаторСтроки", СтрокаСостава.ИдентификаторСтроки));
	
	ПредставлениеДокументов = "";
	
	Для Каждого ПодтверждающийДокумент Из ДокументыЧленаСемьи Цикл
		
		Если ПредставлениеДокументов <> "" Тогда
			ПредставлениеДокументов = ПредставлениеДокументов + Символы.ПС;
		КонецЕсли;
		
		ПредставлениеДокументов = ПредставлениеДокументов + ПодтверждающийДокумент.Вид;
		ПредставлениеДокументов = ПредставлениеДокументов + " № ";
		ПредставлениеДокументов = ПредставлениеДокументов + ПодтверждающийДокумент.Номер;
		ПредставлениеДокументов = ПредставлениеДокументов + " выдан ";
		ПредставлениеДокументов = ПредставлениеДокументов + Формат(ПодтверждающийДокумент.ДатаВыдачи, "ДФ=dd.MM.yyyy");
		ПредставлениеДокументов = ПредставлениеДокументов + " ";
		ПредставлениеДокументов = ПредставлениеДокументов + ПодтверждающийДокумент.КемВыдан;
		
	КонецЦикла;
	
	Если ПустаяСтрока(ПредставлениеДокументов) Тогда
		ПредставлениеДокументов = "<...>";
	КонецЕсли;
	
	СтрокаСостава.Документы = ПредставлениеДокументов;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыУсловияПроезда(ТекущаяСтрока)
	
	ТекущаяСтрока.ЗаголовокПунктОтправления = НСтр("ru = 'Пункт:'");
	ТекущаяСтрока.ЗаголовокДатаОтправления 	= НСтр("ru = 'Дата:'");
	ТекущаяСтрока.ЗаголовокПунктПрибытия 	= НСтр("ru = 'Пункт:'");
	ТекущаяСтрока.ЗаголовокДатаПрибытия 	= НСтр("ru = 'Дата:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьНаименованиеРасходаПроезд(ТекущаяСтрока)
	ТекущаяСтрока.НаименованиеРасхода =
		НСтр("ru = 'Расходы по проезду: '")
		+ НРег(Строка(ТекущаяСтрока.ВидТранспорта))
		+ НСтр("ru = ' транспорт, '")
		+ ТекущаяСтрока.ПунктОтправления + " - " + ТекущаяСтрока.ПунктПрибытия;
КонецПроцедуры

&НаСервере
Процедура ПеречитатьНормативыПроезда()
	
	Для Каждого ТекущаяСтрока Из Объект.УсловияПроезда Цикл
		ПересчитатьНормативыПроездаВСтроке(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьНормативыПроездаВСтроке(ТекущаяСтрока)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Период", ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата));
	Отбор.Вставить("Организация", Объект.Организация);
	Отбор.Вставить("ВидТранспорта", ТекущаяСтрока.ВидТранспорта);
	
	ТекущаяСтрока.КатегорияПоНормативу = УсловиеПроездаПоНормативу(Отбор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьНормативыПроездаВСтрокеНаКлиенте(ТекущаяСтрока)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Период", ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата));
	Отбор.Вставить("Организация", Объект.Организация);
	Отбор.Вставить("ВидТранспорта", ТекущаяСтрока.ВидТранспорта);
	
	ТекущаяСтрока.КатегорияПоНормативу = УсловиеПроездаПоНормативу(Отбор);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуФинансовоеОбеспечение()
	
	ТекущаяТаблицаФО = Объект.ФинансовоеОбеспечение.Выгрузить();
	
	НоваяТаблицаФО = ТекущаяТаблицаФО.Скопировать();
	НоваяТаблицаФО.Очистить();
	
	Объект.ФинансовоеОбеспечение.Очистить();
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("УсловияПроезда");
	МассивТЧ.Добавить("ПрочиеРасходы");
	
	Для Каждого ТЧ Из МассивТЧ Цикл
		Для Каждого СтрокаТЧ Из Объект[ТЧ] Цикл
			Если СтрокаТЧ.СпособОбеспечения <> ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу")
				И СтрокаТЧ.СпособОбеспечения <> ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.ВозмещениеПоФакту") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрокаФО = НоваяТаблицаФО.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаФО, СтрокаТЧ);
			Если СтрокаТЧ.СпособОбеспечения = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу") Тогда
				НоваяСтрокаФО.СуммаАванса = НоваяСтрокаФО.Сумма;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	НоваяТаблицаФО.Свернуть("КФО, КПС, КЭК, КодЦели, КодМероприятия, ДопКлассификация", "Сумма, СуммаАванса");
	
	Для Каждого СтрокаФО Из НоваяТаблицаФО Цикл
		
		НоваяСтрока = Объект.ФинансовоеОбеспечение.Добавить();
		
		Отбор = Новый Структура("КФО, КПС, КЭК, КодЦели, КодМероприятия, ДопКлассификация",
			СтрокаФО.КФО, СтрокаФО.КПС, СтрокаФО.КЭК, СтрокаФО.КодЦели, СтрокаФО.КодМероприятия, СтрокаФО.ДопКлассификация);
		ИмеющиесяСтроки = ТекущаяТаблицаФО.НайтиСтроки(Отбор);
		Если ИмеющиесяСтроки.Количество() = 1 Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ИмеющиесяСтроки[0]);
			ТекущаяТаблицаФО.Удалить(ИмеющиесяСтроки[0]);
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаФО);
			НоваяСтрока.ФинансовыйГод = Год(Объект.Дата);
		КонецЕсли;
		
		НоваяСтрока.Сумма = СтрокаФО.Сумма;
		НоваяСтрока.СуммаАванса = СтрокаФО.СуммаАванса;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТаблицуКлассификацияРасходов(Форма)
	
	Форма.КлассификацияРасходов.Очистить();
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("УсловияПроезда");
	МассивТЧ.Добавить("ПрочиеРасходы");
	
	НомерСтроки = 1;
	Для Каждого ТЧ Из МассивТЧ Цикл
		Для Каждого СтрокаТЧ Из Форма.Объект[ТЧ] Цикл
			Если СтрокаТЧ.СпособОбеспечения <> ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу")
				И СтрокаТЧ.СпособОбеспечения <> ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.ВозмещениеПоФакту") Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТЧ.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			НоваяСтрока = Форма.КлассификацияРасходов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			НоваяСтрока.НомерСтроки = НомерСтроки;
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтветственныхЛиц(Руководитель, РуководительФЭП, ОтветственныйКадры, Организация, Дата, Подразделение)
	
	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"),
		Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	
	РуководительФЭП = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.РуководительПФС"),
		Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	
	ОтветственныйКадры = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.ОтветственныйИсполнительКадры"),
		Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УсловиеПроездаПоНормативу(Отбор)
	
	Возврат РасчетыСПодотчетнымиЛицами.УсловиеПроездаКМестуОтпускаДляКрайнегоСевераПоНормативу(Отбор);
	
КонецФункции

&НаКлиенте
Процедура РедактированиеСпискаДокументов(ДанныеСтроки)
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	
	ПараметрыОткрытия.Вставить("ИдентификаторСтроки", ДанныеСтроки.ИдентификаторСтроки);
	ПараметрыОткрытия.Вставить("ЗаголовокФормы",
		ДанныеСтроки.Фамилия + " " + ДанныеСтроки.Имя + " " + ДанныеСтроки.Отчество);
	ПараметрыОткрытия.Вставить("АдресВХранилищеСпискаДокументов",
		АдресВХранилищеСпискаДокументовПоСтроке(ДанныеСтроки.ИдентификаторСтроки));
	ПараметрыОткрытия.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	Оповещение = Новый ОписаниеОповещения("РедактированиеСпискаДокументовЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера.Форма.РедактированиеСпискаДокументов",
		ПараметрыОткрытия, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Функция АдресВХранилищеСпискаДокументовПоСтроке(ИдентификаторСтроки) Экспорт
	Возврат ПоместитьВоВременноеХранилище(Объект.ПодтверждающиеДокументы.Выгрузить(
		Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки)), УникальныйИдентификатор);
КонецФункции

&НаКлиенте
Процедура РедактированиеСпискаДокументовЗавершение(РезультатыРедактирования, ДополнительныеПараметры) Экспорт
	
	Если РезультатыРедактирования <> Неопределено И РезультатыРедактирования.Модифицированность Тогда
		
		РедактированиеСпискаДокументовЗавершениеНаСервере(РезультатыРедактирования);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РедактированиеСпискаДокументовЗавершениеНаСервере(РезультатыРедактирования)
	
	ИдентификаторСтроки = РезультатыРедактирования.ИдентификаторСтроки;
	
	СтрокиСостава = Объект.СоставСемьи.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Если СтрокиСостава.Количество() <> 0 Тогда
		СтрокаСостава = СтрокиСостава[0];
	Иначе
		Возврат;
	КонецЕсли;
	
	СписокДокументов = ПолучитьИзВременногоХранилища(РезультатыРедактирования.АдресВХранилищеСпискаДокументов);
	
	УдаляемыеСтроки = Объект.ПодтверждающиеДокументы.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		Объект.ПодтверждающиеДокументы.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
	Для Каждого Документ Из СписокДокументов Цикл
		ЗаполнитьЗначенияСвойств(Объект.ПодтверждающиеДокументы.Добавить(), Документ);
	КонецЦикла;
	
	ОбновитьТекстДокументыСтрокеТаблицыСоставСемьи(Объект, СтрокаСостава);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокиПодтверждающиеДокументы(ВыделенныеСтроки)
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		Строка = Объект.СоставСемьи.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		Если Строка <> Неопределено Тогда
			
			ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
			МассивКУдалению = Объект.ПодтверждающиеДокументы.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
				Объект.ПодтверждающиеДокументы.Удалить(СтрокаКУдалению);
			КонецЦикла;
			
		КонецЕсли
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюКлассификацииРасходов(Элементы, Пометка)
	
	РеквизитыКлассификацииДетально = Новый Массив;
	РеквизитыКлассификацииДетально.Добавить("УсловияПроездаКФО");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроездаКПС");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроездаКЭК");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроездаКодЦели");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроездаКодМероприятия");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроездаДопКлассификация");
	РеквизитыКлассификацииДетально.Добавить("ПрочиеРасходыКФО");
	РеквизитыКлассификацииДетально.Добавить("ПрочиеРасходыКПС");
	РеквизитыКлассификацииДетально.Добавить("ПрочиеРасходыКЭК");
	РеквизитыКлассификацииДетально.Добавить("ПрочиеРасходыКодЦели");
	РеквизитыКлассификацииДетально.Добавить("ПрочиеРасходыКодМероприятия");
	РеквизитыКлассификацииДетально.Добавить("ПрочиеРасходыДопКлассификация");
	
	Для Каждого Реквизит Из РеквизитыКлассификацииДетально Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, Реквизит, "Видимость", НЕ Пометка);
	КонецЦикла;
	
	РеквизитыКлассификацииСводно = Новый Массив;
	РеквизитыКлассификацииСводно.Добавить("ГруппаКлассификацияРасходов");
	
	Для Каждого Реквизит Из РеквизитыКлассификацииСводно Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, Реквизит, "Видимость", Пометка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаличиеЛБОНаСервере()
	
	ЭтоКазенноеУчреждение = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ЭтоКазенноеУчреждение;
	
	Для Каждого СтрокаФО Из Объект.ФинансовоеОбеспечение Цикл
		СтрокаФО.НаличиеЛБО = Ложь;
	КонецЦикла;
	
	// По каждому финансовому году будет выполнен отдельный запрос
	Года = Объект.ФинансовоеОбеспечение.Выгрузить().ВыгрузитьКолонку("ФинансовыйГод");
	Года = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Года);
	
	Для Каждого Год Из Года Цикл
		
		Если Не ЗначениеЗаполнено(Год) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Год < Год(Объект.Дата) Тогда
			Продолжить;
		КонецЕсли;
		
		КодСчета = Строка(Год - Год(Объект.Дата) + 1);
		Если ЭтоКазенноеУчреждение Тогда
			СчетаФинансирование = БухгалтерскийУчет.СписокСчетов("501."+КодСчета+"3");
		Иначе
			СчетаФинансирование = БухгалтерскийУчет.СписокСчетов("506."+КодСчета+"0");
		КонецЕсли;
		
		Запрос = Новый Запрос;
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЖурналПроводокЕПСБУОстатки.КЭК) КАК КоличествоКЭК,
		|	МАКСИМУМ(ЖурналПроводокЕПСБУОстатки.КЭК) КАК КЭК,
		|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт) КАК ОстатокЛБО
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&ДатаОстатков,
		|			Счет В (&СчетЛБО),
		|			,
		|			Организация = &Организация
		|				И ИФО = &ИФО
		|				И Подразделение = &Подразделение
		|				И (ВЫРАЗИТЬ(Субконто1 КАК Справочник.РазделыЛицевыхСчетов)) = &РазделЛицевогоСчета) КАК ЖурналПроводокЕПСБУОстатки
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЖурналПроводокЕПСБУОстатки.КЭК) = 1 И
		|	МАКСИМУМ(ЖурналПроводокЕПСБУОстатки.КЭК) = &КЭК000";
		
		Запрос.УстановитьПараметр("ДатаОстатков",
			?(Объект.Ссылка.Пустая(), ТекущаяДатаСеанса(), Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая)));
		Запрос.УстановитьПараметр("СчетЛБО", СчетаФинансирование);
		Запрос.УстановитьПараметр("Организация",
			?(ЗначениеЗаполнено(Объект.ОрганизацияОсуществляющаяОбеспечение), Объект.ОрганизацияОсуществляющаяОбеспечение, Объект.Организация));
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
		КонецЕсли;
		Если БухгалтерскийУчет.ВедетсяУчетПоПодразделениям(СчетаФинансирование)
			И (НЕ ЗначениеЗаполнено(Объект.ОрганизацияОсуществляющаяОбеспечение)
			ИЛИ Объект.ОрганизацияОсуществляющаяОбеспечение = Объект.Организация) Тогда
			Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение = &Подразделение", "");
		КонецЕсли;
		Запрос.УстановитьПараметр("РазделЛицевогоСчета", Объект.РазделЛицевогоСчета);
		Запрос.УстановитьПараметр("КЭК000", БухгалтерскийУчетПовтИсп.КЭКПоКоду("000"));
		
		ЛБОсДетализациейПоКЭК = Запрос.Выполнить().Пустой();
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
		|	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.ДополнительнаяБюджетнаяКлассификация)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ДополнительнаяБюджетнаяКлассификация)
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.ДополнительнаяБюджетнаяКлассификация)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ДополнительнаяБюджетнаяКлассификация)
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.ДополнительнаяБюджетнаяКлассификация)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ДополнительнаяБюджетнаяКлассификация)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДополнительнаяБюджетнаяКлассификация.ПустаяСсылка)
		|	КОНЕЦ КАК ДопКлассификация,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.ВидыЦелевыхСредств)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ВидыЦелевыхСредств)
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.ВидыЦелевыхСредств)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЦелевыхСредств)
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.ВидыЦелевыхСредств)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ВидыЦелевыхСредств)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЦелевыхСредств.ПустаяСсылка)
		|	КОНЕЦ КАК КодЦели,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.Мероприятия)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Мероприятия)
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.Мероприятия)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Мероприятия)
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.Мероприятия)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Мероприятия)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Мероприятия.ПустаяСсылка)
		|	КОНЕЦ КАК КодМероприятия,
		|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт КАК ОстатокЛБО
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&ДатаОстатков,
		|			Счет В (&СчетЛБО),
		|			,
		|			Организация = &Организация
		|				И ИФО = &ИФО
		|				И Подразделение = &Подразделение
		|				И (ВЫРАЗИТЬ(Субконто1 КАК Справочник.РазделыЛицевыхСчетов)) = &РазделЛицевогоСчета) КАК ЖурналПроводокЕПСБУОстатки";
		
		Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
		КонецЕсли;
		Если НЕ (БухгалтерскийУчет.ВедетсяУчетПоПодразделениям(СчетаФинансирование)
			И (НЕ ЗначениеЗаполнено(Объект.ОрганизацияОсуществляющаяОбеспечение)
			ИЛИ Объект.ОрганизацияОсуществляющаяОбеспечение = Объект.Организация)) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение = &Подразделение", "");
		КонецЕсли;
		Если НЕ ЛБОсДетализациейПоКЭК Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "
			|	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.ДополнительнаяБюджетнаяКлассификация)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ДополнительнаяБюджетнаяКлассификация)
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.ДополнительнаяБюджетнаяКлассификация)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ДополнительнаяБюджетнаяКлассификация)
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.ДополнительнаяБюджетнаяКлассификация)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ДополнительнаяБюджетнаяКлассификация)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДополнительнаяБюджетнаяКлассификация.ПустаяСсылка)
			|	КОНЕЦ КАК ДопКлассификация,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.ВидыЦелевыхСредств)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ВидыЦелевыхСредств)
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.ВидыЦелевыхСредств)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЦелевыхСредств)
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.ВидыЦелевыхСредств)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ВидыЦелевыхСредств)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЦелевыхСредств.ПустаяСсылка)
			|	КОНЕЦ КАК КодЦели,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.Мероприятия)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Мероприятия)
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.Мероприятия)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Мероприятия)
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.Мероприятия)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Мероприятия)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Мероприятия.ПустаяСсылка)
			|	КОНЕЦ КАК КодМероприятия,", "");
		КонецЕсли;
		
		Результат = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрокаФО Из Объект.ФинансовоеОбеспечение Цикл
			
			Если СтрокаФО.ФинансовыйГод <> Год Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЛБОсДетализациейПоКЭК Тогда
				Отбор = Новый Структура("КФО, КПС, КЭК, КодЦели, КодМероприятия, ДопКлассификация",
					СтрокаФО.КФО, СтрокаФО.КПС, СтрокаФО.КЭК, СтрокаФО.КодЦели, СтрокаФО.КодМероприятия, СтрокаФО.ДопКлассификация);
			Иначе
				Отбор = Новый Структура("КФО, КПС", СтрокаФО.КФО, СтрокаФО.КПС);
			КонецЕсли;
			
			Строки = Результат.НайтиСтроки(Отбор);
			Если Строки.Количество() > 0 Тогда
				Если Строки[0].ОстатокЛБО >= СтрокаФО.Сумма Тогда
					СтрокаФО.НаличиеЛБО = Истина;
				КонецЕсли;
				Строки[0].ОстатокЛБО = Строки[0].ОстатокЛБО - СтрокаФО.Сумма;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция НеЗаполненРеквзитВТаблицеОбъекта(ИмяТЧ, ИмяРеквизита, ПредставлениеРеквизита)
	
	Отказ = Ложь;
	
	Для Каждого Строка Из Объект[ИмяТЧ] Цикл
		
		Если Не ЗначениеЗаполнено(Строка[ИмяРеквизита]) Тогда
			
			ИндексСтроки = Объект[ИмяТЧ].Индекс(Строка);
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'В строке %1 не заполнен %2'"),
								ИндексСтроки + 1, ПредставлениеРеквизита);
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,
														,
														"Объект."+ИмяТЧ+"["+ИндексСтроки+"]."+ИмяРеквизита,
														,
														Отказ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Отказ;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеФизическогоЛица(ФизическоеЛицо, Дата)
	
	ТребуемыеДанные = Новый Структура;
	ТребуемыеДанные.Вставить("Фамилия");
	ТребуемыеДанные.Вставить("Имя");
	ТребуемыеДанные.Вставить("Отчество");
	ТребуемыеДанные.Вставить("ДатаРождения");
	ТребуемыеДанные.Вставить("ПодтверждающиеДокументы");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФИОФизическихЛицСрезПоследних.Фамилия КАК Фамилия,
	|	ФИОФизическихЛицСрезПоследних.Имя КАК Имя,
	|	ФИОФизическихЛицСрезПоследних.Отчество КАК Отчество
	|ИЗ
	|	РегистрСведений.ФИОФизическихЛиц.СрезПоследних(&Дата, ФизическоеЛицо = &ФизическоеЛицо) КАК ФИОФизическихЛицСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ТребуемыеДанные.Вставить("Фамилия", Выборка.Фамилия);
		ТребуемыеДанные.Вставить("Имя", Выборка.Имя);
		ТребуемыеДанные.Вставить("Отчество", Выборка.Отчество);
	КонецЕсли;
	
	ТребуемыеДанные.Вставить("ДатаРождения", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФизическоеЛицо, "ДатаРождения"));
	
	ПодтверждающиеДокументы = Новый Массив;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументыФизическихЛицСрезПоследних.ВидДокумента КАК ВидДокумента,
	|	ДокументыФизическихЛицСрезПоследних.ДатаВыдачи КАК ДатаВыдачи,
	|	ДокументыФизическихЛицСрезПоследних.Серия КАК Серия,
	|	ДокументыФизическихЛицСрезПоследних.Номер КАК Номер,
	|	ДокументыФизическихЛицСрезПоследних.КемВыдан КАК КемВыдан
	|ИЗ
	|	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(&Дата, Физлицо = &ФизическоеЛицо) КАК ДокументыФизическихЛицСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ПодтверждающийДокумент = Новый Структура;
		ПодтверждающийДокумент.Вставить("Вид", Выборка.ВидДокумента);
		ПодтверждающийДокумент.Вставить("ДатаВыдачи", Выборка.ДатаВыдачи);
		ПодтверждающийДокумент.Вставить("Номер", Выборка.Серия + " " + Выборка.Номер);
		ПодтверждающийДокумент.Вставить("КемВыдан", Выборка.КемВыдан);
		ПодтверждающиеДокументы.Добавить(ПодтверждающийДокумент);
	КонецЦикла;
	
	ТребуемыеДанные.Вставить("ПодтверждающиеДокументы", ПодтверждающиеДокументы);
	
	Возврат ТребуемыеДанные;
	
КонецФункции

