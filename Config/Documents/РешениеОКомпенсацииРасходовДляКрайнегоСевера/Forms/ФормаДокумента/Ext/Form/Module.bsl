&НаКлиенте
Процедура УсловияПроездаПунктПрибытияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("ДанныеФормыСтруктура") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Модифицированность = Истина;
	
	ТекущаяСтрока = Элементы.УсловияПроезда.ТекущиеДанные;
	ТекущаяСтрока.ПунктПрибытия = ВыбранноеЗначение.Наименование;
	
	ЗаполнитьНаименованиеРасходаПроезд(ТекущаяСтрока);
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияПроездаПунктПрибытияАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	Если СтрДлина(Текст) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.УсловияПроезда.ТекущиеДанные;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидТранспорта", ТекущаяСтрока.ВидТранспорта);
	
	ПараметрыВыбораЗначения = Новый Структура;
	ПараметрыВыбораЗначения.Вставить("СтрокаПоиска", Текст);
	ПараметрыВыбораЗначения.Вставить("Отбор", Отбор);
	ПараметрыВыбораЗначения.Вставить("СпособПоискаСтроки", СпособПоискаСтрокиПриВводеПоСтроке.ЛюбаяЧасть);
	
	ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.ПунктыОтправленийПрибытий"), ПараметрыВыбораЗначения);
	Если ДанныеВыбора.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияПроездаПунктПрибытияПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.УсловияПроезда.ТекущиеДанные;
	
	ЗаполнитьНаименованиеРасходаПроезд(ТекущаяСтрока);
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияПроездаКПСПриИзменении(Элемент)
	ТекущиеДанные = Элементы.УсловияПроезда.ТекущиеДанные;
	БухгалтерскийУчетКлиент.ПроверитьОчиститьКЭК(ТекущиеДанные.КПС, ТекущиеДанные.КЭК);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыПрочиеРасходы

&НаКлиенте
Процедура ПрочиеРасходыПриИзменении(Элемент)
	
	ОбновитьТаблицуФинансовоеОбеспечение();
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочиеРасходыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ПрочиеРасходы.ТекущиеДанные;
	
	ТекущаяСтрока.СпособОбеспечения = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу");
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочиеРасходыНаименованиеРасходаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ОткрытьФорму("Справочник.ПрочиеВидыРасходовПоКомандировкам.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочиеРасходыКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПрочиеРасходы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочиеРасходыЦенаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПрочиеРасходы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочиеРасходыСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПрочиеРасходы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Количество = 0 Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
	
	ТекущиеДанные.Цена = ТекущиеДанные.Сумма / ТекущиеДанные.Количество;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочиеРасходыКПСПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ПрочиеРасходы.ТекущиеДанные;
	БухгалтерскийУчетКлиент.ПроверитьОчиститьКЭК(ТекущиеДанные.КПС, ТекущиеДанные.КЭК);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыЗадолженность

&НаКлиенте
Процедура ЗадолженностьСуммаНаПроверкеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Задолженность.ТекущиеДанные;
	
	Курс = ?(ТекущиеДанные.Сумма = 0, 1, ТекущиеДанные.СуммаРуб / ТекущиеДанные.Сумма);
	
	ТекущиеДанные.СуммаНаПроверкеРуб = ТекущиеДанные.СуммаНаПроверке * Курс;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьСуммаПросроченнаяПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Задолженность.ТекущиеДанные;
	
	Курс = ?(ТекущиеДанные.Сумма = 0, 1, ТекущиеДанные.СуммаРуб / ТекущиеДанные.Сумма);
	
	ТекущиеДанные.СуммаПросроченнаяРуб = ТекущиеДанные.СуммаПросроченная * Курс;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыКлассификацияРасходов

&НаКлиенте
Процедура КлассификацияРасходовПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.КлассификацияРасходов.ТекущиеДанные;
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("УсловияПроезда");
	МассивТЧ.Добавить("ПрочиеРасходы");
	
	НомерСтроки = 1;
	Для Каждого ТЧ Из МассивТЧ Цикл
		Для Каждого СтрокаТЧ Из Объект[ТЧ] Цикл
			Если СтрокаТЧ.ИдентификаторСтроки = ТекущаяСтрока.ИдентификаторСтроки Тогда
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, ТекущаяСтрока, "КФО, КПС, КЭК, КодЦели, КодМероприятия, ДопКлассификация");
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ОбновитьТаблицуФинансовоеОбеспечение();
	
КонецПроцедуры

&НаКлиенте
Процедура КлассификацияРасходовКПСПриИзменении(Элемент)
	ТекущиеДанные = Элементы.КлассификацияРасходов.ТекущиеДанные;
	БухгалтерскийУчетКлиент.ПроверитьОчиститьКЭК(ТекущиеДанные.КПС, ТекущиеДанные.КЭК);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПересчитатьЗадолженность(Команда)
	
	ПересчитатьЗадолженностьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодОтпуска(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период = Новый СтандартныйПериод(Объект.ДатаНачалаОтпуска, Объект.ДатаОкончанияОтпуска);
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеРедактированияПериодаОтпуска", ЭтотОбъект);
	
	Диалог.Показать(ОписаниеОповещенияОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеРедактированияПериодаОтпуска(ВыбранныйПериод, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйПериод = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ДатаНачалаОтпуска = ВыбранныйПериод.ДатаНачала;
	Объект.ДатаОкончанияОтпуска = ВыбранныйПериод.ДатаОкончания;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодКомпенсации(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период = Новый СтандартныйПериод(Объект.ДатаНачалаПериодаКомпенсации, Объект.ДатаОкончанияПериодаКомпенсации);
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеРедактированияПериодаКомпенсации", ЭтотОбъект);
	
	Диалог.Показать(ОписаниеОповещенияОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеРедактированияПериодаКомпенсации(ВыбранныйПериод, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйПериод = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ДатаНачалаПериодаКомпенсации = ВыбранныйПериод.ДатаНачала;
	Объект.ДатаОкончанияПериодаКомпенсации = ВыбранныйПериод.ДатаОкончания;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаличиеЛБО(Команда)
	
	Если НеЗаполненРеквзитВТаблицеОбъекта("ФинансовоеОбеспечение", "ФинансовыйГод", НСтр("ru = 'финансовый год'")) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаличиеЛБОНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КлассификацияРасходовНаОтдельнойЗакладке(Команда)
	
	Пометка = Элементы.ФормаКлассификацияРасходовНаОтдельнойЗакладке.Пометка;
	
	ПометкаНовая = НЕ Пометка;
	
	УправлениеВидимостьюКлассификацииРасходов(Элементы, ПометкаНовая);
	
	Элементы.ФормаКлассификацияРасходовНаОтдельнойЗакладке.Пометка = ПометкаНовая;
	
	Если ПометкаНовая Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаКлассификацияРасходов;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьИзФизЛиц(Команда)
	
	ОткрытьФорму("Справочник.ФизическиеЛица.ФормаВыбора", , Элементы.СоставСемьи);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОбратныйПроезд(Команда)
	
	ТекущиеДанные = Элементы.УсловияПроезда.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура("ВидТранспорта, КатегорияПоНормативу,
		|КПС, КЭК, КФО, КодЦели, КодМероприятия, ДопКлассификация, СпособОбеспечения, Цена, Количество, Сумма");
	ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, ТекущиеДанные);
	
	НоваяСтрока = Объект.УсловияПроезда.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураРеквизитов);
	
	НоваяСтрока.ПунктОтправления 	= ТекущиеДанные.ПунктПрибытия;
	НоваяСтрока.ПунктПрибытия 		= ТекущиеДанные.ПунктОтправления;
	
	ЗаполнитьНаименованиеРасходаПроезд(НоваяСтрока);
	
	ОбновитьТекстЗаголовковВСтрокеТаблицыУсловияПроезда(НоваяСтрока);
	
	Элементы.УсловияПроезда.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	
КонецПроцедуры

