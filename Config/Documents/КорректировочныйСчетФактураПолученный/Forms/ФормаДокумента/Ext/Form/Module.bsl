&НаКлиенте
Процедура ЗаполнитьСчетФактурыВыданныеПокупателям(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ДатаПервичногоДокумента) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Для заполнения необходимо указать ""Дату первичного документа""";
		Сообщение.Сообщить();	
		Возврат;		
	КонецЕсли;
	
	ЕстьДанные = Объект.СчетаФактурыВыданныеПокупателям.Количество() > 0;
	
	Если ЕстьДанные Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьСчетаФактурыВыданныеЗавершение", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Табличная часть будет очищена. Заполнить?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
	Иначе
		ЗаполнитьСчетаФактурыВыданные();
	КонецЕсли; 
	
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьСчетаФактурыВыданныеЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьСчетаФактурыВыданные();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСчетаФактурыВыданные()
 	
	ПараметрыЗапроса = Документы.КорректировочныйСчетФактураПолученный.НовыйПараметрыЗапросаСчетовФактурВыданныхПокупателям();
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Объект);
	
	Объект.СчетаФактурыВыданныеПокупателям.Очистить();
	Объект.СчетаФактурыВыданныеПокупателям.Загрузить(
		Документы.КорректировочныйСчетФактураПолученный.СчетаФактурыВыданныеПокупателям(ПараметрыЗапроса));
		
	Если Объект.СчетаФактурыВыданныеПокупателям.Количество() > 1 Тогда
		Если Объект.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомитента Тогда	
			Объект.КодВидаОперации = "28"
		ИначеЕсли Объект.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаРеализациюОтКомитента Тогда
            Объект.КодВидаОперации = "27"
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыВСтрокеКомиссия(Элемент)
	
	ТекДанные = Элементы["СоставНФА"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.КомиссионнаяТорговля Тогда
		ТекДанные.СуммаНДСПоКомиссииУвеличение = ТекДанные.СуммаНДСУвеличение;
		ТекДанные.СуммаНДСПоКомиссииУменьшение = ТекДанные.СуммаНДСУменьшение;
		ТекДанные.ВсегоПоКомиссииУвеличение = ТекДанные.ВсегоУвеличение;
		ТекДанные.ВсегоПоКомиссииУменьшение = ТекДанные.ВсегоУменьшение;
	Иначе
		ТекДанные.СуммаНДСПоКомиссииУвеличение = 0;
		ТекДанные.СуммаНДСПоКомиссииУменьшение = 0;
		ТекДанные.ВсегоПоКомиссииУвеличение = 0;
		ТекДанные.ВсегоПоКомиссииУменьшение = 0;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
