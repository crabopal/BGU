&НаСервере
Процедура ИнициализироватьФормуСервер()
	
	ИнициализироватьНастройкиЭлементовКолонок();
	
	УчетНДСКлиентСервер.ЗаполнитьСписокКодовВидовОпераций(
		Элементы["КодВидаОперации"].СписокВыбора,
		"ПолученныеСчетаФактуры",
		Объект["Дата"]);
		
		УчетНДСКлиентСервер.ЗаполнитьСписокКодовВидовОпераций(
		Элементы["КодВидаОперацииКомиссия"].СписокВыбора,
		"ПолученныеСчетаФактуры",
		Объект["Дата"]);	
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	Массив.Добавить(Тип("СправочникСсылка.Номенклатура"));
	Массив.Добавить(Тип("СправочникСсылка.ОсновныеСредства"));
	СписокТиповНФА = Новый ОписаниеТипов(Массив);
	
	Элементы.СоставНФАКФО.СписокВыбора.ЗагрузитьЗначения(ПолучитьДоступныеКФО(
		Объект.Организация, Объект.ИфО, ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ДатаПоследнегоИзменения));
	
	НастроитьФормуСервер_ПоПричинеНалогообложения();
	
	НастроитьФормуСервер_ПоВариантуРегистрации();
	
	//---
	// Документы остатков НДС
	//---
	ДокументыОстатковНДС_НастроитьФормуСервер();
	
	УстановитьУсловноеОформление();
	
	// Прослеживаемость
	НастроитьФормуПрослеживаемостьСервер();
	// Конец Прослеживаемость
	
	ДиагностироватьЦепочкуДокументовСчетовФактур();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//---
	// 1. Надпись А (до изменения)
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = "Надпись А (до изменения)";

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНФА.НомерСтроки");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='А (до изменения)'"));

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставНФАНадписьА");


	//---
	// 2. Надпись Б (после изменения)
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = "Надпись Б (после изменения)";

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНФА.НомерСтроки");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='Б (после изменения)'"));

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставНФАНадписьБ");

	
	//---
	// 3. Надпись В (увеличение)
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = "Надпись В (увеличение)";

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНФА.НомерСтроки");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='В (увеличение)'"));

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставНФАНадписьВ");


	//---
	// 4. Надпись Г (уменьшение)
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = "Надпись Г (уменьшение)";

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНФА.НомерСтроки");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='Г (уменьшение)'"));

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставНФАНадписьГ");
	
	//---
	// 5.Заполненный реквизит "Документ основание" устанавливает реквизиты табличной части "Комиссионная торговля" в значение только просмотр
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Заполненный реквизит ""Документ основание"" устанавливает реквизиты табличной части ""Комиссионная торговля"" в значение только просмотр");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ДокументОснование");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	Условие.ПравоеЗначение = Неопределено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставНФАКомиссионнаяТорговля");
	
	//---
	// 6.Установленный признак "Комиссионная торговля" устанавливает реквизит "Отразить в книге" в значение только просмотр
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Установленный признак ""Комиссионная торговля"" устанавливает реквизит ""Отразить в книге"" в значение только просмотр'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНФА.КомиссионнаяТорговля");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставНФАНДСКВычету");
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьНастройкиЭлементовКолонок()
	
	КоллекцияСкрываемых = Новый Соответствие();
	
	СкрываемыеЭлементы = Новый Массив();
	СкрываемыеЭлементы.Добавить("СоставНФАЕдиницаИзмерения");
	СкрываемыеЭлементы.Добавить("СоставНФАГруппаКоличество");
	СкрываемыеЭлементы.Добавить("СоставНФАГруппаСумма");
	СкрываемыеЭлементы.Добавить("СоставНФАГруппаВсего");
	СкрываемыеЭлементы.Добавить("ГруппаИтогиСумма");
	СкрываемыеЭлементы.Добавить("ГруппаИтогиВсего");
	СкрываемыеЭлементы.Добавить("ГруппаСводныйСчетФактура");
	СкрываемыеЭлементы.Добавить("КодВидаОперацииКомиссия");
	СкрываемыеЭлементы.Добавить("ВходящийДокументСводныйСФ");
	СкрываемыеЭлементы.Добавить("ГруппаПродавецКомиссионера");
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.АвансВыданный, СкрываемыеЭлементы);
	
	
	СкрываемыеЭлементы = Новый Массив();
	СкрываемыеЭлементы.Добавить("СоставНФАГруппаВсегоАванс");
	СкрываемыеЭлементы.Добавить("ГруппаИтогиВсегоАванс");
	СкрываемыеЭлементы.Добавить("ГруппаСводныйСчетФактура");
	СкрываемыеЭлементы.Добавить("КодВидаОперацииКомиссия");
	СкрываемыеЭлементы.Добавить("ВходящийДокументСводныйСФ");
	СкрываемыеЭлементы.Добавить("ГруппаПродавецКомиссионера");
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.ПустаяСсылка(), СкрываемыеЭлементы);
	
	СкрываемыеЭлементы = Новый Массив();
	СкрываемыеЭлементы.Добавить("Содержание");
	СкрываемыеЭлементы.Добавить("ВариантРегистрации");
	СкрываемыеЭлементы.Добавить("ГруппаПлатежныеДокументы");
	СкрываемыеЭлементы.Добавить("ВходящийДокумент");
	СкрываемыеЭлементы.Добавить("ГруппаПродавецКомиссионера");
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомитента, СкрываемыеЭлементы);  
	
	СкрываемыеЭлементы = Новый Массив();
	СкрываемыеЭлементы.Добавить("Содержание");
	СкрываемыеЭлементы.Добавить("ВариантРегистрации");
	СкрываемыеЭлементы.Добавить("ГруппаПлатежныеДокументы");
	СкрываемыеЭлементы.Добавить("ВходящийДокумент");
	СкрываемыеЭлементы.Добавить("ГруппаПродавецКомиссионера");
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаРеализациюОтКомитента, СкрываемыеЭлементы);
	
	СкрываемыеЭлементы = Новый Массив();
	СкрываемыеЭлементы.Добавить("СоставНФАГруппаВсегоАванс");
	СкрываемыеЭлементы.Добавить("ГруппаИтогиВсегоАванс");
	СкрываемыеЭлементы.Добавить("ГруппаСводныйСчетФактура");
	СкрываемыеЭлементы.Добавить("КодВидаОперацииКомиссия");
	СкрываемыеЭлементы.Добавить("ВходящийДокументСводныйСФ");
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаПокупкуОтКомиссионера, СкрываемыеЭлементы);
	
	СкрываемыеЭлементы = Новый Массив();
	СкрываемыеЭлементы.Добавить("СоставНФАЕдиницаИзмерения");
	СкрываемыеЭлементы.Добавить("СоставНФАГруппаКоличество");
	СкрываемыеЭлементы.Добавить("СоставНФАГруппаСумма");
	СкрываемыеЭлементы.Добавить("СоставНФАГруппаВсего");
	СкрываемыеЭлементы.Добавить("ГруппаИтогиСумма");
	СкрываемыеЭлементы.Добавить("ГруппаИтогиВсего");
	СкрываемыеЭлементы.Добавить("ГруппаСводныйСчетФактура");
	СкрываемыеЭлементы.Добавить("КодВидаОперацииКомиссия");
	СкрываемыеЭлементы.Добавить("ВходящийДокументСводныйСФ");
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера, СкрываемыеЭлементы);
	
	УчетНДС.ИнициализироватьНастройкиЭлементовКолонок(ЭтаФорма, КоллекцияСкрываемых);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ПоПричинеНалогообложения()
	
	УчетНДС.НастроитьФорму_ВидимостьКолонок(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ПоВариантуРегистрации()
	
	ЭтоДопЛист = (Объект["ВариантРегистрации"] = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВДопЛистахКнигПродажПокупок);
	
	Элементы["КорректируемыйПериод"].ТолькоПросмотр = НЕ ЭтоДопЛист;
	
	Элементы["СоставНФАПроцентНДСкВычету"].Видимость	= ЭтоДопЛист;
	Элементы["СоставНФАГруппаСчетЗатрат"].Видимость		= ЭтоДопЛист;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаОснованииКлиент(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	
	НовоеЗначение = Объект[ИмяЭлемента];
	
	Если ЗначениеЗаполнено(НовоеЗначение) Тогда
		
		ТекстВопроса = НСтр("ru='Заполнить на основании указанного документа?'");
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ИмяЭлемента", Элемент.Имя);
		
		ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ЗаполнитьНаОснованииКлиент_Выбор", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВопрос(ОписаниеОповещенияВыбор, ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет);
		
	Иначе
		ДиагностироватьЦепочкуДокументовСчетовФактур();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаОснованииКлиент_Выбор(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ЗаполнитьНаОснованииСервер(ДополнительныеПараметры);
		
	Иначе
		ДиагностироватьЦепочкуДокументовСчетовФактур();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаОснованииСервер(ДополнительныеПараметры)
	
	Перем ОписаниеОшибки, ДопПараметры;
	
	Если ЗначениеЗаполнено(Объект.ДокументКорректировки) Тогда
		Основание = Объект.ДокументКорректировки;
		
		Если ДополнительныеПараметры.ИмяЭлемента = "ДокументОснование" Тогда
			ДопПараметры = "ТолькоДозаполнитьПоСчетуФактуре";
		КонецЕсли;
	Иначе
		Основание = Объект.ДокументОснование;
	КонецЕсли;
	
	Если Не Документы.КорректировочныйСчетФактураПолученный.ЗаполнитьНаОсновании(Основание, Объект, ОписаниеОшибки, ДопПараметры) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		
		ДиагностироватьЦепочкуДокументовСчетовФактур();
		
		Возврат;
	КонецЕсли;
	
	НастроитьФормуСервер_ПоПричинеНалогообложения();
	
	НастроитьФормуСервер_ПоВариантуРегистрации();
	
	// Прослеживаемость
	НастроитьФормуПрослеживаемостьСервер();
	// Конец Прослеживаемость
	
	ДиагностироватьЦепочкуДокументовСчетовФактур();
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПолучитьСвойстваСчета(СчетСсылка)
	
	Возврат Документы.РаспределениеВходящегоНДС.ПолучитьСвойстваСчета(СчетСсылка);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДоступныеКФО(Организация,ИфО,Дата)
	
	Возврат БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(Организация, ИФО, Дата);
	
КонецФункции

&НаКлиенте
Процедура РассчитатьСуммыВСтроке(Элемент)
	
	Перем ИмяИзмененногоПоля;
	
	ТекДанные = Элементы["СоставНФА"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяЭлемента = Элемент.Имя;
	
	// Колонки, относящиеся к НДС:
	Если ИмяЭлемента = "СоставНФАСумма" Тогда
		ИмяИзмененногоПоля	= "Сумма";
		ИмяПоляСумма		= "Сумма";
		ИмяПоляСуммаНДС		= "СуммаНДС";
		ИмяПоляВсего		= "Всего";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
	ИначеЕсли ИмяЭлемента = "СоставНФАСуммаДоИзменения" Тогда
		ИмяИзмененногоПоля	= "СуммаДоИзменения";
		ИмяПоляСумма		= "СуммаДоИзменения";
		ИмяПоляСуммаНДС		= "СуммаНДСДоИзменения";
		ИмяПоляВсего		= "ВсегоДоИзменения";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
		
	ИначеЕсли ИмяЭлемента = "СоставНФАСуммаНДС" Тогда
		ИмяИзмененногоПоля	= "СуммаНДС";
		ИмяПоляСумма		= "Сумма";
		ИмяПоляСуммаНДС		= "СуммаНДС";
		ИмяПоляВсего		= "Всего";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
	ИначеЕсли ИмяЭлемента = "СоставНФАСуммаНДСДоИзменения" Тогда
		ИмяИзмененногоПоля	= "СуммаНДСДоИзменения";
		ИмяПоляСумма		= "СуммаДоИзменения";
		ИмяПоляСуммаНДС		= "СуммаНДСДоИзменения";
		ИмяПоляВсего		= "ВсегоДоИзменения";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
		
	ИначеЕсли	ИмяЭлемента = "СоставНФАВсего" ИЛИ ИмяЭлемента = "СоставНФАВсегоАванс" Тогда
		ИмяИзмененногоПоля	= "Всего";
		ИмяПоляСумма		= "Сумма";
		ИмяПоляСуммаНДС		= "СуммаНДС";
		ИмяПоляВсего		= "Всего";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
	ИначеЕсли	ИмяЭлемента = "СоставНФАВсегоДоИзменения" ИЛИ ИмяЭлемента = "СоставНФАВсегоДоИзмененияАванс" Тогда
		ИмяИзмененногоПоля	= "ВсегоДоИзменения";
		ИмяПоляСумма		= "СуммаДоИзменения";
		ИмяПоляСуммаНДС		= "СуммаНДСДоИзменения";
		ИмяПоляВсего		= "ВсегоДоИзменения";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
		
	ИначеЕсли ИмяЭлемента = "СоставНФАСтавкаНДС" Тогда
		ИмяИзмененногоПоля	= "СтавкаНДС";
		ИмяПоляСумма		= "Сумма";
		ИмяПоляСуммаНДС		= "СуммаНДС";
		ИмяПоляВсего		= "Всего";
		ИмяПоляСтавкаНДС	= "СтавкаНДС";
	ИначеЕсли ИмяЭлемента = "СоставНФАСтавкаНДСДоИзменения" Тогда
		ИмяИзмененногоПоля	= "СтавкаНДСДоИзменения";
		ИмяПоляСумма		= "СуммаДоИзменения";
		ИмяПоляСуммаНДС		= "СуммаНДСДоИзменения";
		ИмяПоляВсего		= "ВсегоДоИзменения";
		ИмяПоляСтавкаНДС	= "СтавкаНДСДоИзменения";
	КонецЕсли;
	
	СтруктураИменПолей = Новый Структура();
	СтруктураИменПолей.Вставить("Сумма",		ИмяПоляСумма);
	СтруктураИменПолей.Вставить("СуммаНДС",		ИмяПоляСуммаНДС);
	СтруктураИменПолей.Вставить("Всего",		ИмяПоляВсего);
	СтруктураИменПолей.Вставить("СтавкаНДС",	ИмяПоляСтавкаНДС);
	УчетНДСКлиентСервер.РассчитатьСуммы(ТекДанные, ИмяИзмененногоПоля, СтруктураИменПолей, Ложь);
	
	УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(ТекДанные, "Сумма");
	УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(ТекДанные, "СуммаНДС");
	УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(ТекДанные, "Всего");
	
	Если ТекДанные.КомиссионнаяТорговля Тогда
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(ТекДанные, "СуммаНДС", "СуммаНДСПоКомиссии");
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(ТекДанные, "Всего", "ВсегоПоКомиссии");
	КонецЕсли;

	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДО(Форма, ВидимостьЭлементовЭДО)
	Объект = Форма.Объект;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияСостояниеЭДО", "Видимость", ВидимостьЭлементовЭДО);
	
КонецПроцедуры	


&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика
	 ИЛИ (Объект.ВалютаДокумента <> ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета
	 	И НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня) Тогда
		
		ДатаПриИзмененииНаСервере();
		
		БухгалтерскиеОперацииКлиент.ПоказатьОповещениеПриИзмененииКурсаВалюты(
			ЭтотОбъект.КэшПараметров.Служебные.ИзмениласьДатаДляКонтроляКурса,
			ЭтотОбъект.КэшПараметров.Служебные.ИзмениласьВалютаДляКонтроляКурса);
		
	КонецЕсли;
	
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		
		УчетНДСКлиентСервер.ЗаполнитьСписокКодовВидовОпераций(
			Элементы["КодВидаОперации"].СписокВыбора,
			"ПолученныеСчетаФактуры",
			Объект["Дата"]);
		
	КонецЕсли;
	
	// СтандартныеПодсистемы.РаботаСКонтрагентами
	ПроверкаКонтрагентовКлиент.ЗапуститьПроверкуКонтрагентовВДокументе(ЭтотОбъект, Объект.Дата);
	// Конец СтандартныеПодсистемы.РаботаСКонтрагентами
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
	БухгалтерскиеОперацииКлиентСервер.ОбновитьКурсВалютыВФормеДокумента(ЭтотОбъект, Объект);
	
	Документы.КорректировочныйСчетФактураПолученный.ЗаполнитьРеквизитыСторонСделки(Объект);
	
	// Прослеживаемость
	НастроитьФормуПрослеживаемостьСервер();
	// Конец Прослеживаемость
	
КонецПроцедуры

