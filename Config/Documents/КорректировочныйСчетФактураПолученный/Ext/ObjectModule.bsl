#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ 

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Перем Основание; 
	Если ДанныеЗаполнения <> Неопределено и ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") тогда
		ТекстСообщения = "";
		Если не Документы.КорректировочныйСчетФактураПолученный.ЗаполнитьНаОсновании(ДанныеЗаполнения, ЭтотОбъект, ТекстСообщения) тогда
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект["ВалютаДокумента"]) Тогда
		ЭтотОбъект["ВалютаДокумента"] = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если НЕ ДанныеЗаполнения.Свойство("ДокументОснование") Тогда
			ДанныеЗаполнения.Свойство("Основание", Основание);
			Если ТипЗнч(Основание) = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
				СтандартнаяОбработка = Ложь; 
	            ЗаполнитьПоОтчетуКомитентуОПродажах(ДанныеЗаполнения);
		    КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Документы.КорректировочныйСчетФактураПолученный.СформироватьДвиженияПоРегистрам(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	//---
	// Документы остатков НДС
	//---
	Если УчетНДС.ДокументыОстатковНДС_СообщитьЕслиИспользуетсяДляВводаОстатков(ЭтотОбъект) Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если ЭтотОбъект.ПричинаНалогообложения <> Перечисления.ПричиныНалогообложенияНДС.АвансВыданный Тогда
		УчетНДС.ПроверитьНеизменностьСтавокНалога(ЭтотОбъект, Отказ);
	КонецЕсли;
	
	// Прослеживаемость
	Если УчетНДС.ДокументКорректировкиОбязателенКЗаполнению(ЭтотОбъект) Тогда
		ПроверяемыеРеквизиты.Добавить("ДокументКорректировки");
	КонецЕсли;
	// Конец Прослеживаемость
	
	УчетНДС.ПроверитьДопустимостьВычетаНалогаПоСчетуФактуре(ЭтотОбъект, "Дата", Отказ);
	
	УчетНДС.ПроверитьЦепочкуДокументовСчетовФактур(ЭтотОбъект, Отказ);
	
	УчетНДС.ПроверитьНаличиеПозицийНФАВДокументеОсновании(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ЭтоДопЛист = (ВариантРегистрации = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВДопЛистахКнигПродажПокупок);
	
	Если НЕ ЭтоДопЛист Тогда
		Документы.КорректировочныйСчетФактураПолученный.ОчиститьАналитикуЗатрат(ЭтотОбъект);
	КонецЕсли;
	
	Если УчетНДС.ЭтоКомиссионнаяРеализация(ПричинаНалогообложения) Тогда
		ВсегоУвеличение = СчетаФактурыВыданныеПокупателям.Итог("СуммаУвеличение");
	
		ВсегоУменьшение = СчетаФактурыВыданныеПокупателям.Итог("СуммаУменьшение");
	Иначе
		ВсегоУвеличение = СоставНФА.Итог("ВсегоУвеличение");
	
		ВсегоУменьшение = СоставНФА.Итог("ВсегоУменьшение");
		
		ВсегоУвеличениеПоКомиссии = СоставНФА.Итог("ВсегоПоКомиссииУвеличение");
	
		ВсегоУменьшениеПоКомиссии = СоставНФА.Итог("ВсегоПоКомиссииУменьшение");
	
		СуммаНДСУвеличениеПоКомиссии = СоставНФА.Итог("СуммаНДСПоКомиссииУвеличение");
	
		СуммаНДСУменьшениеПоКомиссии = СоставНФА.Итог("СуммаНДСПоКомиссииУменьшение");
		
	КонецЕсли;	
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
Процедура ЗаполнитьПоОтчетуКомитентуОПродажах(ДанныеЗаполнения) 
	
	ПричинаНалогообложения = ДанныеЗаполнения.ПричинаНалогообложенияНДС;
	ДанныеДокОснование = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения.Основание, "Организация, ИФО, Дата, Контрагент, Договор");
	Договор = ДанныеДокОснование.Договор;
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокОснование);
	ВариантРегистрации = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВКнигеПродажПокупок;
	КодСпособаВыставления = 1;
	КодВидаОперацииКомиссия = "18";
	
КонецПроцедуры

#КонецЕсли

