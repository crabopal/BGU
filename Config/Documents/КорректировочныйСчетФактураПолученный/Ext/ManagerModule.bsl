Функция СформироватьДвижениеПоРН_ВходящийНДС(Движение, СтруктураШапкиДокумента, ТекСтрока)
	Результат = Истина;
	
	ЗаполнитьЗначенияСвойств(Движение, ТекСтрока);
	
	Движение.ВидДвижения            = ВидДвиженияНакопления.Приход;
	Движение.Период                 = СтруктураШапкиДокумента.Дата;
	Движение.Организация            = СтруктураШапкиДокумента.Организация;
	Движение.КФО                    = ТекСтрока.КФО;
	Движение.СчетФактура            = СтруктураШапкиДокумента.ДокументОснование;
	Движение.ОбъектНалогообложения  = ?(ТекСтрока.ОбъектНалогообложения = Неопределено,СтруктураШапкиДокумента.ДокументОснование, ТекСтрока.ОбъектНалогообложения);
	Движение.ПричинаНалогообложения = СтруктураШапкиДокумента.ПричинаНалогообложения;
	Движение.ВидЦенности 			= ТекСтрока.ВидЦенности;
	Движение.ДокументКорректировки  = СтруктураШапкиДокумента.Ссылка;
	
	Если ТекСтрока.МестоРегистрации = Перечисления.МестаРегистрацииСчетовФактур.КнигаПродаж Тогда
		Движение.СуммаНДС				= -Движение.СуммаНДС;
		Движение.СуммаБезНДС			= -Движение.СуммаБезНДС;
		Движение.СуммаНДСВалютная		= -Движение.СуммаНДСВалютная;
		Движение.СуммаБезНДСВалютная	= -Движение.СуммаБезНДСВалютная;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция СформироватьДвижениеПоРН_КнигаПродажПокупок(Движения, СтруктураШапкиДокумента, ТекСтрока)
	Результат = Истина;
	
	ТекСчетКредита = ТекСтрока.СчетКредита;
	Если НЕ ЗначениеЗаполнено(ТекСчетКредита) Тогда
		Возврат Результат;
	КонецЕсли;	
	Если не ЗначениеЗаполнено(ТекСтрока.МестоРегистрации) тогда
		Возврат Результат;
	КонецЕсли;	
	
	Если ТекСтрока.МестоРегистрации = Перечисления.МестаРегистрацииСчетовФактур.КнигаПокупок тогда
		Движение = Движения.КнигаПокупок.Добавить();
	Иначе
		Движение = Движения.КнигаПродаж.Добавить();
	КонецЕсли;	
	
	ЗаполнитьЗначенияСвойств(Движение, ТекСтрока);
	
	
	ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения");
	
	Движение.Период      = СтруктураШапкиДокумента.Дата;
	Движение.СчетФактура = СтруктураШапкиДокумента.Ссылка;
	Движение.КодВидаОперации= СтруктураШапкиДокумента.КодВидаОперации;
	
	Движение.СуммаНДС    = ТекСтрока.СуммаНДС;
	Движение.СуммаНДСВалютная    = ТекСтрока.СуммаНДСВалютная;
	
	Возврат Результат;
КонецФункции	

Функция СформироватьДвижениеПоРН_ДопЛист(Движения, СтруктураШапкиДокумента, ТекСтрока)
	Результат = Истина;
	
	ТекСчетКредита = ТекСтрока.СчетКредита;
	Если НЕ ЗначениеЗаполнено(ТекСчетКредита) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Если не ЗначениеЗаполнено(ТекСтрока.МестоРегистрации) тогда
		Возврат Результат;
	КонецЕсли;	
	
	Если ТекСтрока.МестоРегистрации = Перечисления.МестаРегистрацииСчетовФактур.КнигаПокупок тогда
		Движение = Движения.ДополнительныеЛистыКнигиПокупок.Добавить();
	Иначе
		Движение = Движения.ДополнительныеЛистыКнигиПродаж.Добавить();
	КонецЕсли;	
	ЗаполнитьЗначенияСвойств(Движение, ТекСтрока);
	
	ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения, КорректируемыйПериод");
	
	
	Движение.Период      = СтруктураШапкиДокумента.Дата;
	Движение.СчетФактура = СтруктураШапкиДокумента.Ссылка;
	Движение.КодВидаОперации= СтруктураШапкиДокумента.КодВидаОперации;
	
	МножительПроцент = ТекСтрока.ПроцентНДСкВычету / 100;
	
	Движение.СуммаБезНДС			= Движение.СуммаБезНДС			* МножительПроцент;
	Движение.СуммаНДС				= Движение.СуммаНДС				* МножительПроцент;
	Движение.СуммаБезНДСВалютная	= Движение.СуммаБезНДСВалютная	* МножительПроцент;
	Движение.СуммаНДСВалютная		= Движение.СуммаНДСВалютная		* МножительПроцент;
	
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьДанныеДляВходящегоНДСпоДокументу(СтруктураШапкиДокумента)
	
	ДокументСсылка	= СтруктураШапкиДокумента.Ссылка;
	Курс			= СтруктураШапкиДокумента.Курс;
	Кратность		= СтруктураШапкиДокумента.Кратность;
	
	СчетаНДСКРаспределению = Новый Массив();
	Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("210.Н1");
	Если ЗначениеЗаполнено(Счет) Тогда
		СчетаНДСКРаспределению.Добавить(Счет);
	КонецЕсли;
	Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("210.Н2");
	Если ЗначениеЗаполнено(Счет) Тогда
		СчетаНДСКРаспределению.Добавить(Счет);
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДокументСсылка",			ДокументСсылка);
	Запрос.УстановитьПараметр("Курс",					?(ЗначениеЗаполнено(Курс), Курс, 1));
	Запрос.УстановитьПараметр("Кратность",				?(ЗначениеЗаполнено(Кратность), Кратность, 1));
	Запрос.УстановитьПараметр("ЗаполнитьВалютныеСуммы",	УчетНДС.СледуетЗаполнитьВалютныеСуммы());
	Запрос.УстановитьПараметр("СчетаНДСКРаспределению",	СчетаНДСКРаспределению);
	Запрос.УстановитьПараметр("ЭтоАванс",				СтруктураШапкиДокумента.ЭтоАванс);
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Табличная часть документа
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ВсегоУвеличение < ВсегоУменьшение ТОГДА
	|			// Данная полученная корректировка на уменьшение,
	|			// и поэтому должна быть зарегистрирована в книге продаж
	|			ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПродаж)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПокупок)
	|	КОНЕЦ										КАК МестоРегистрации,
	|	НФА											КАК НФА,
	|	СтавкаНДС									КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА &ЭтоАванс ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Аванс)
	|			
	|		КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.ОсновныеСредства) И НФА.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ПраваПользованияИмуществом) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Услуги)
	|			
	|		КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.ОС)
	|			
	|		КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫБОР
	|				КОГДА НФА.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа) ИЛИ НФА.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга) ТОГДА
	|					ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Услуги)
	|				ИНАЧЕ
	|					ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Материалы)
	|			КОНЕЦ
	|			
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Прочее)
	|			
	|	КОНЕЦ										КАК ВидЦенности,
	|	СчетВычетКт									КАК СчетКредита,
	|	ДокументОснование							КАК ОбъектНалогообложения,
	|	ДокументОснование.Дата						КАК ДатаОснования,
	|	КФО											КАК КФО,
	|	НДСКВычету									КАК НДСКВычету,
	|	ВЫБОР
	|		КОГДА СчетВычетКт В(&СчетаНДСКРаспределению) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ										КАК НДСКРаспределению,
	|	СчетРасчетов								КАК СчетРасчетов,
	|	КПСВычетКт									КАК КПССчетРасчетов,
	|	ПроцентНДСкВычету							КАК ПроцентНДСкВычету,
	|
	|	ВЫБОР
	|		КОГДА ВсегоУвеличение - СуммаНДСУвеличение > ВсегоУменьшение - СуммаНДСУменьшение ТОГДА
	|			(ВсегоУвеличение - СуммаНДСУвеличение) - (ВсегоУменьшение - СуммаНДСУменьшение)
	|		ИНАЧЕ
	|			(ВсегоУменьшение - СуммаНДСУменьшение) - (ВсегоУвеличение - СуммаНДСУвеличение)
	|	КОНЕЦ * &Курс / &Кратность					КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА СуммаНДСУвеличение > СуммаНДСУменьшение ТОГДА
	|			СуммаНДСУвеличение - СуммаНДСУменьшение
	|		ИНАЧЕ
	|			СуммаНДСУменьшение - СуммаНДСУвеличение
	|	КОНЕЦ * &Курс / &Кратность					КАК СуммаНДС,
	|	
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			ВЫБОР
	|				КОГДА ВсегоУвеличение - СуммаНДСУвеличение > ВсегоУменьшение - СуммаНДСУменьшение ТОГДА
	|					(ВсегоУвеличение - СуммаНДСУвеличение) - (ВсегоУменьшение - СуммаНДСУменьшение)
	|				ИНАЧЕ
	|					(ВсегоУменьшение - СуммаНДСУменьшение) - (ВсегоУвеличение - СуммаНДСУвеличение)
	|			КОНЕЦ
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ										КАК СуммаБезНДСВалютная,
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			ВЫБОР
	|				КОГДА СуммаНДСУвеличение > СуммаНДСУменьшение ТОГДА
	|					СуммаНДСУвеличение - СуммаНДСУменьшение
	|				ИНАЧЕ
	|					СуммаНДСУменьшение - СуммаНДСУвеличение
	|			КОНЕЦ
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ										КАК СуммаНДСВалютная
	|ИЗ
	|	Документ.КорректировочныйСчетФактураПолученный.СоставНФА КАК СоставНФА
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|	И НДСКВычету";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Инициализация новых колонок
	//	1) СтавкаНДСДоИзменения
	//	2) КоличествоДоИзменения
	//	3) Аналитика затрат
	//		ПроцентНДСкВычету
	//		СчетДт
	//		КЭКСчетаДебета
	//		КПССчетаДебета
	//		СубконтоДт1
	//		СубконтоДт2
	//		СубконтоДт3
	//	4) СчетРасчетов
	
	ПричиныШкурыЛом = Новый Массив();
	ПричиныШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.РеализацияЛом);
	ПричиныШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйЛом);
	
	Параметры.Вставить("ПричиныШкурыЛом", ПричиныШкурыЛом);
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ПричиныШкурыЛом", ПричиныШкурыЛом);
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка
	|ИЗ
	|	Документ.КорректировочныйСчетФактураПолученный.СоставНФА
	|ГДЕ
	|	// Условие 1
	|	(КоличествоДоИзменения = 0 И КоличествоДоИзменения <> Количество)
	|	ИЛИ
	|	// Условие 2
	|	(СтавкаНДСДоИзменения = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) И НЕ Ссылка.ПричинаНалогообложения В(&ПричиныШкурыЛом))
	|	ИЛИ
	|	// Условие 3
	|	(Ссылка.ВариантРегистрации = ЗНАЧЕНИЕ(Перечисление.ВариантыРегистрацииДляКорректирующихСФ.ВДопЛистахКнигПродажПокупок) И СчетДт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
	|	ИЛИ
	|	// Условие 4
	|	СчетРасчетов = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|;";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.КорректировочныйСчетФактураПолученный";
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта, МенеджерВременныхТаблиц, ДополнительныеПараметры);
	
	Если Не Результат.ЕстьДанныеДляОбработки Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	Если Не Результат.ЕстьЗаписиВоВременнойТаблице Тогда
		Параметры.ОбработкаЗавершена = Ложь;
		Возврат;
	КонецЕсли;
	
	ПричиныШкурыЛом = Новый Массив();
	ПричиныШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.РеализацияЛом);
	ПричиныШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйЛом);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПричиныШкурыЛом", ПричиныШкурыЛом);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Ссылка																			КАК Ссылка,
	|
	|	// Флаг условия 1
	|	МАКСИМУМ(КоличествоДоИзменения = 0 И КоличествоДоИзменения <> Количество)		КАК ИнициализироватьКоличествоДоИзменения,
	|	
	|	// Флаг условия 2
	|	МАКСИМУМ((СтавкаНДСДоИзменения = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
	|		И НЕ Ссылка.ПричинаНалогообложения В(&ПричиныШкурыЛом)))					КАК ИнициализироватьСтавкаНДСДоИзменения,
	|		
	|	// Флаг условия 3
	|	МАКСИМУМ((Ссылка.ВариантРегистрации = ЗНАЧЕНИЕ(Перечисление.ВариантыРегистрацииДляКорректирующихСФ.ВДопЛистахКнигПродажПокупок)
	|		И СчетДт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)))						КАК ИнициализироватьАналитикуЗатрат,
	|		
	|	// Флаг условия 4
	|	МАКСИМУМ(СчетРасчетов = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))				КАК ИнициализироватьСчетРасчетов
	|ИЗ
	|	Документ.КорректировочныйСчетФактураПолученный.СоставНФА
	|ГДЕ
	|	Ссылка В (ВЫБРАТЬ Ссылка ИЗ ВТДляОбработки)
	|СГРУППИРОВАТЬ ПО
	|	Ссылка
	|;";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			НачатьТранзакцию();
			
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			ЭтоШкурыЛом = УчетНДСПовтИсп.ШкурыЛом(ДокОбъект["ПричинаНалогообложения"]);
			
			Для Каждого СтрокаТаблицы Из ДокОбъект.СоставНФА Цикл
				
				Если Выборка["ИнициализироватьКоличествоДоИзменения"] Тогда
					
					СтрокаТаблицы["КоличествоДоИзменения"] = СтрокаТаблицы["Количество"];
					
				КонецЕсли;
				
				Если Выборка["ИнициализироватьСтавкаНДСДоИзменения"] Тогда
					
					СтрокаТаблицы["СтавкаНДСДоИзменения"] = СтрокаТаблицы["СтавкаНДС"];
					
				КонецЕсли;
				
			КонецЦикла;
			
			СоставНФА = Неопределено;
			
			//
			// Аналитика затрат
			//
			Если Выборка["ИнициализироватьАналитикуЗатрат"] Тогда
				
				Если СоставНФА = Неопределено Тогда
					СоставНФА = ДокОбъект.СоставНФА.Выгрузить();
				КонецЕсли;
				
				УчетНДС.ЗаполнитьВидЦенности(СоставНФА, ДокОбъект["ПричинаНалогообложения"]);
				
				Переименование = Новый Структура();
				Переименование.Вставить("ДокументОснование", "ОбъектНалогообложения");
				
				УчетНДС.ПереименоватьКолонки(СоставНФА, Переименование, "вперед");
				
				УчетНДС.ЗаполнитьАналитикуЗатрат(СоставНФА);
				
				УчетНДС.ПереименоватьКолонки(СоставНФА, Переименование, "назад");
				
			КонецЕсли;
			
			//
			// Счет расчетов
			//
			Если Выборка["ИнициализироватьСчетРасчетов"] Тогда
				
				Если СоставНФА = Неопределено Тогда
					СоставНФА = ДокОбъект.СоставНФА.Выгрузить();
				КонецЕсли;
				
				УчетНДС.ЗаполнитьСчетРасчетов(СоставНФА);
				
			КонецЕсли;
			
			Если СоставНФА <> Неопределено Тогда
				
				ДокОбъект.СоставНФА.Загрузить(СоставНФА);
				
			КонецЕсли;
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#Область СчетаФактурыВыданныеПокупателям

Функция НовыйПараметрыЗапросаСчетовФактурВыданныхПокупателям() Экспорт

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ДатаПервичногоДокумента" , Неопределено);
	ПараметрыЗапроса.Вставить("Организация"         	, Неопределено);
	ПараметрыЗапроса.Вставить("ДокументОснование"       , Неопределено);
	ПараметрыЗапроса.Вставить("Контрагент"        		, Неопределено);
	ПараметрыЗапроса.Вставить("Договор"           		, Неопределено);
	ПараметрыЗапроса.Вставить("ПричинаНалогообложения"  , Неопределено);
	ПараметрыЗапроса.Вставить("Корректировочный"  , Ложь);
	
	Возврат ПараметрыЗапроса;

КонецФункции

Функция СчетаФактурыВыданныеПокупателям(ПараметрыЗапроса) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаПервичногоДокумента"	, ПараметрыЗапроса.ДатаПервичногоДокумента);
	Запрос.УстановитьПараметр("ДокументОснование"     	, ПараметрыЗапроса.ДокументОснование);
	Запрос.УстановитьПараметр("Организация"          	, ПараметрыЗапроса.Организация);
	Запрос.УстановитьПараметр("Контрагент"            	, ПараметрыЗапроса.Контрагент);
	Запрос.УстановитьПараметр("Договор"      		  	, ПараметрыЗапроса.Договор);
	
	Если ПараметрыЗапроса.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомитента Тогда
		
		Запрос.Текст = ТекстЗапросаВыданныеСчетаФактурыНаАванс();
		
	ИначеЕсли ПараметрыЗапроса.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаРеализациюОтКомитента Тогда
		
		Запрос.Текст = ТекстЗапросаКорректировка();
		
	КонецЕсли;
		
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции 

Функция ТекстЗапросаВыданныеСчетаФактурыНаАванс()
	
	Возврат "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КорректировочныйСчетФактураВыданный.Контрагент КАК Покупатель,
	|	КорректировочныйСчетФактураВыданный.Ссылка КАК СчетФактура,
	|	СУММА(КорректировочныйСчетФактураВыданныйСоставНФА.СуммаНДСУвеличение) КАК СуммаНДСУвеличение,
	|	СУММА(КорректировочныйСчетФактураВыданныйСоставНФА.СуммаНДСУменьшение) КАК СуммаНДСУменьшение,
	|	КорректировочныйСчетФактураВыданный.ВсегоУвеличение) КАК СуммаУвеличение,
	|	КорректировочныйСчетФактураВыданный.ВсегоУменьшение КАК СуммаУменьшение
	|ИЗ
	|	Документ.КорректировочныйСчетФактураВыданный.СоставНФА КАК КорректировочныйСчетФактураВыданныйСоставНФА
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировочныйСчетФактураВыданный КАК КорректировочныйСчетФактураВыданный
	|		ПО КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка = КорректировочныйСчетФактураВыданный.Ссылка
	|ГДЕ
	|	КорректировочныйСчетФактураВыданный.Организация = &Организация
	|	И КорректировочныйСчетФактураВыданный.ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученныйКомиссионером)
	|	И НАЧАЛОПЕРИОДА(КорректировочныйСчетФактураВыданный.Дата, ДЕНЬ) = &ДатаПервичногоДокумента
	|	И НЕ КорректировочныйСчетФактураВыданный.ПометкаУдаления
	|	И КорректировочныйСчетФактураВыданный.Проведен
	|	И КорректировочныйСчетФактураВыданный.Комитент = &Контрагент
	|
	|СГРУППИРОВАТЬ ПО
	|	КорректировочныйСчетФактураВыданный.Контрагент,
	|	КорректировочныйСчетФактураВыданный.Ссылка";
	
КонецФункции 

Функция ТекстЗапросаКорректировка()
	
	Возврат "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СчетФактураПолученныйСчетаФактурыВыданныеПокупателям.Покупатель КАК Покупатель
	|ПОМЕСТИТЬ ПокупателиПоОтчету
	|ИЗ
	|	Документ.СчетФактураПолученный.СчетаФактурыВыданныеПокупателям КАК СчетФактураПолученныйСчетаФактурыВыданныеПокупателям
	|ГДЕ
	|	СчетФактураПолученныйСчетаФактурыВыданныеПокупателям.Ссылка = &ДокументОснование
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Покупатель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КорректировочныйСчетФактураВыданный.Контрагент КАК Покупатель,
	|	КорректировочныйСчетФактураВыданный.Ссылка КАК СчетФактура,
	|	КорректировочныйСчетФактураВыданный.ВсегоУвеличениеПоКомиссии КАК СуммаУвеличение,
	|	0 КАК СуммаУменьшение,
	|	КорректировочныйСчетФактураВыданный.СуммаНДСУвеличениеПоКомиссии КАК СуммаНДСУвеличение,
	|	0 КАК СуммаНДСУменьшение
	|ИЗ
	|	Документ.КорректировочныйСчетФактураВыданный КАК КорректировочныйСчетФактураВыданный
	|ГДЕ
	|	КорректировочныйСчетФактураВыданный.Организация = &Организация
	|	И НАЧАЛОПЕРИОДА(КорректировочныйСчетФактураВыданный.Дата, ДЕНЬ) = &ДатаПервичногоДокумента
	|	И КорректировочныйСчетФактураВыданный.Контрагент В
	|			(ВЫБРАТЬ
	|				ПокупателиПоОтчету.Покупатель
	|			ИЗ
	|				ПокупателиПоОтчету)
	|	И КорректировочныйСчетФактураВыданный.ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)
	|	И КорректировочныйСчетФактураВыданный.ВсегоУвеличениеПоКомиссии <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КорректировочныйСчетФактураВыданный.Контрагент,
	|	КорректировочныйСчетФактураВыданный.Ссылка,
	|	0,
	|	КорректировочныйСчетФактураВыданный.ВсегоУменьшениеПоКомиссии,
	|	0,
	|	КорректировочныйСчетФактураВыданный.СуммаНДСУменьшениеПоКомиссии
	|ИЗ
	|	Документ.КорректировочныйСчетФактураВыданный КАК КорректировочныйСчетФактураВыданный
	|ГДЕ
