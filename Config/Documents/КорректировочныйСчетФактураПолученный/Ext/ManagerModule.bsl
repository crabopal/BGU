Процедура ЗаполнитьНаОснованииСчетФактураПолученный(Знач ДокументОснования, Объект)
	
	ПричинаНалогообложения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснования, "ПричинаНалогообложения");
	
	ЭтоАванс = УчетНДСПовтИсп.Аванс(ПричинаНалогообложения);
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка",		ДокументОснования);
	Запрос.УстановитьПараметр("ЭтоАванс",	ЭтоАванс);
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетФактураПолученный.Организация,
	|	СчетФактураПолученный.ИФО,
	|	СчетФактураПолученный.Подразделение,
	|	СчетФактураПолученный.Контрагент,
	|	ВЫБОР
	|		КОГДА СчетФактураПолученный.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА
	|			""""
	|		// Если задано наименование для печати - используем его:
	|		КОГДА НЕ СчетФактураПолученный.Контрагент.НаименованиеСокращенное = """" ТОГДА
	|			СчетФактураПолученный.Контрагент.НаименованиеСокращенное
	|			
	|		// Для юридических лиц есть реквизит НаименованиеПолное:
	|		КОГДА СчетФактураПолученный.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			И НЕ СчетФактураПолученный.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное = """" ТОГДА
	|			ВЫРАЗИТЬ(СчетФактураПолученный.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное	КАК СТРОКА(1000))
	|			
	|		ИНАЧЕ
	|			СчетФактураПолученный.Контрагент.Наименование
	|	КОНЕЦ КАК НаименованиеПродавца,
	|	СчетФактураПолученный.Контрагент.ЮридическоеФизическоеЛицо.ИНН	КАК ИННПродавца,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СчетФактураПолученный.Контрагент.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ЮридическиеЛица) ТОГДА
	|			СчетФактураПолученный.Контрагент.ЮридическоеФизическоеЛицо.КПП
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КПППродавца,
	|	СчетФактураПолученный.НомерПервичногоДокумента КАК НомерСчетФактуры,
	|	СчетФактураПолученный.ДатаПервичногоДокумента КАК ДатаСчетФактуры,
	|	СчетФактураПолученный.Ссылка КАК ИсправляемыйДокумент,
	|	СчетФактураПолученный.Дата КАК КорректируемыйПериод,
	|	СчетФактураПолученный.Договор,
	|	СчетФактураПолученный.СуммаДокумента,
	|	СчетФактураПолученный.СуммаНДС,
	|	СчетФактураПолученный.ПричинаНалогообложения,
	|	СчетФактураПолученный.ВидЦенности,
	|	СчетФактураПолученный.ВалютаДокумента,
	|	ПродавецКомиссионера,
	|	КодВидаОперации,
	|	СчетФактураПолученный.СоставНФА.(
	|		НомерСтроки,
	|		НФА,
	|		ЕдиницаИзмерения,
	|		Количество,
	|		Сумма,
	|		СтавкаНДС,
	|		СуммаНДС,
	|		Всего,
	|		СуммаАкциза,
	|		Количество КАК КоличествоДоИзменения,
	|		СтавкаНДС КАК СтавкаНДСДоИзменения,
    |		Сумма КАК СуммаДоИзменения,
    |		СуммаНДС КАК СуммаНДСДоИзменения,
    |		Всего КАК ВсегоДоИзменения,
	|		СуммаАкциза КАК СуммаАкцизаДоИзменения,
	|		НДСКВычету,
	|		КПСВычетКт,
	|       КФО,
	|       СчетВычетКт,
	|		Счет30304,
	|		КомиссионнаяТорговля,
	|       ВЫБОР
	|			КОГДА ДокументОснование = НЕОПРЕДЕЛЕНО ТОГДА
	|				Ссылка
	|			ИНАЧЕ
	|				ДокументОснование
	|		КОНЕЦ	КАК ДокументОснование,
	|
	|		Ссылка.ВидЦенности	КАК ВидЦенности
	// Пока в документе применяется реквизит шапки
	//|		ВЫБОР
	//|			КОГДА &ЭтоАванс ТОГДА
	//|				ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Аванс)
	//|				
	//|			КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.ОсновныеСредства) И НФА.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ПраваПользованияИмуществом) ТОГДА
	//|				ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Услуги)
	//|				
	//|			КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	//|				ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.ОС)
	//|				
	//|			КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.Номенклатура) ТОГДА
	//|				ВЫБОР
	//|					КОГДА НФА.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа) ИЛИ НФА.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга) ТОГДА
	//|						ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Услуги)
	//|					ИНАЧЕ
	//|						ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Материалы)
	//|				КОНЕЦ
	//|				
	//|			ИНАЧЕ
	//|				ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Прочее)
	//|				
	//|		КОНЕЦ										КАК ВидЦенности
	|	)  Как ОснованиеСоставНФА,
	|	СчетФактураПолученный.ПлатежноРасчетныеДокументы.(
    |		ДатаДокумента	КАК ДатаДокумента,
    |		НомерДокумента	КАК НомерДокумента
	|	) КАК ОснованиеПлатежноРасчетныеДокументы
	|ИЗ
	|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
	|ГДЕ
	|	СчетФактураПолученный.Ссылка = &Ссылка";
	
	ДанныеЗаполнения = Запрос.Выполнить().Выгрузить();
	
	Шапка		= ДанныеЗаполнения[0];
	СоставНФА	= ДанныеЗаполнения[0]["ОснованиеСоставНФА"];
	ОснованиеПлатежноРасчетныеДокументы	= ДанныеЗаполнения[0]["ОснованиеПлатежноРасчетныеДокументы"];
	
	Объект.ПлатежноРасчетныеДокументы.Загрузить(ОснованиеПлатежноРасчетныеДокументы);
	
	//
	// Аналитика затрат
	//
	Переименование = Новый Структура();
	Переименование.Вставить("ДокументОснование", "ОбъектНалогообложения");
	
	УчетНДС.ПереименоватьКолонки(СоставНФА, Переименование, "вперед");
	
	УчетНДС.ЗаполнитьАналитикуЗатрат(СоставНФА);
	
	УчетНДС.ПереименоватьКолонки(СоставНФА, Переименование, "назад");
	
	//
	// Счет расчетов
	//
	УчетНДС.ЗаполнитьСчетРасчетов(СоставНФА);
	
	
	ЗаполнитьЗначенияСвойств(Объект, Шапка);
	
	Объект.СоставНФА.Загрузить(СоставНФА);
	
КонецПроцедуры

Процедура ЗаполнитьНаОснованииИсправительныйСчетФактураПолученный(Знач ДокументОснования, Объект, ЗаполнятьШапкуПоОснованию = истина)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", ДокументОснования);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СчетФактураПолученный.Организация КАК Организация,
	               |	СчетФактураПолученный.ИФО КАК ИФО,
	               |	СчетФактураПолученный.Подразделение КАК Подразделение,
	               |	СчетФактураПолученный.Контрагент КАК Контрагент,
	               |	СчетФактураПолученный.НаименованиеПродавца КАК НаименованиеПродавца,
	               |	СчетФактураПолученный.ИННПродавца КАК ИННПродавца,
	               |	СчетФактураПолученный.КПППродавца КАК КПППродавца,
	               |	СчетФактураПолученный.НомерСчетаФактуры КАК НомерСчетаФактуры,
	               |	СчетФактураПолученный.ДатаСчетаФактуры КАК ДатаСчетаФактуры,
	               |	СчетФактураПолученный.Договор КАК Договор,
	               |	СчетФактураПолученный.ПричинаНалогообложения КАК ПричинаНалогообложения,
	               |	СчетФактураПолученный.ВалютаДокумента КАК ВалютаДокумента,
	               |	СчетФактураПолученный.ИсправляемыйДокумент КАК ИсправляемыйДокумент,
					|	КодВидаОперации,
	               |	СчетФактураПолученный.СоставНФА.(
	               |		НФА,
	               |		ЕдиницаИзмерения,
	               |		Количество,
	               |		Сумма,
	               |		СтавкаНДС,
	               |		СтавкаНДСДоКорректировки КАК СтавкаНДСДоКорректировки,
	               |		СтавкаНДС КАК СтавкаНДСДоИзменения,
	               |		СуммаНДС,
	               |		Всего,
	               |		Количество КАК КоличествоДоИзменения,
	               |		Сумма КАК СуммаДоИзменения,
	               |		СуммаНДС КАК СуммаНДСДоИзменения,
	               |		Всего КАК ВсегоДоИзменения,
	               |		КоличествоДоКорректировки КАК КоличествоДоКорректировки,
	               |		СуммаДоКорректировки КАК СуммаДоКорректировки,
	               |		СуммаНДСДоКорректировки КАК СуммаНДСДоКорректировки,
	               |		ВсегоДоКорректировки КАК ВсегоДоКорректировки,
	               |		НДСКВычету,
	               |		КПСВычетКт,
	               |		КФО,
	               |		СчетВычетКт,
	               |		Счет30304,
	               |		ДокументОснование,
				   |
					|	ПроцентНДСкВычету,
					|	СчетДт,
					|	КЭКСчетаДебета,
					|	КПССчетаДебета,
					|	СубконтоДт1,
					|	СубконтоДт2,
					|	СубконтоДт3,
					|	СчетРасчетов
				   |
	               |	) КАК ОснованиеСоставНФА,
					|	СчетФактураПолученный.ПлатежноРасчетныеДокументы.(
				    |		ДатаДокумента	КАК ДатаДокумента,
				    |		НомерДокумента	КАК НомерДокумента
					|	) КАК ОснованиеПлатежноРасчетныеДокументы
	               |ИЗ
	               |	Документ.ИсправительныйСчетФактураПолученный КАК СчетФактураПолученный
	               |ГДЕ
	               |	СчетФактураПолученный.Ссылка = &Ссылка";
	
	Основание = Запрос.Выполнить().Выбрать();
	Основание.Следующий();
	Объект.СоставНФА.Очистить();
	Если ЗаполнятьШапкуПоОснованию тогда
		ЗаполнитьЗначенияСвойств(Объект, Основание);
	КонецЕсли;	
	
	НФА = Основание.ОснованиеСоставНФА.Выбрать();
	
	Пока НФА.Следующий() Цикл
		СтрокаНФА = Объект.СоставНФА.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаНФА, НФА);
	КонецЦикла;	
	
	Объект.ПлатежноРасчетныеДокументы.Очистить();
	Выборка = Основание.ОснованиеПлатежноРасчетныеДокументы.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ПлатежноРасчетныеДокументы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПРоцедуры

Процедура ЗаполнитьНаОснованииКорректировочныйСчетФактураПолученный(Знач ДокументОснования, Объект)
	
	СтруктураШапкиОснования = ОбщегоНазначенияБГУ.СформироватьСтруктуруШапкиДокументаПоСсылке(ДокументОснования.Ссылка);
	
	ОбъектОснования = ДокументОснования.ПолучитьОбъект();
	
	Объект.СоставНФА.Очистить();
	Объект.ПлатежноРасчетныеДокументы.Очистить();
	
	ЗаполнитьЗначенияСвойств(Объект, СтруктураШапкиОснования,,"Номер,Проведен,ПометкаУдаления");
	
	Объект.НомерСчетаФактуры = ОбъектОснования.НомерПервичногоДокумента;
	Объект.ДатаСчетаФактуры = ОбъектОснования.ДатаПервичногоДокумента;
	
	Объект.ДокументОснование		= ОбъектОснования.Ссылка;
	Объект.ДокументКорректировки	= Неопределено;
	
	Для Каждого СтрокаТаблицы Из ОбъектОснования.СоставНФА Цикл
		СтрокаНФА = Объект.СоставНФА.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаНФА, СтрокаТаблицы);
	КонецЦикла;
	
	Объект.ПлатежноРасчетныеДокументы.Загрузить(ОбъектОснования.ПлатежноРасчетныеДокументы.Выгрузить());
	
КонецПРоцедуры

Процедура ЗаполнитьНаОснованииПоступлениеМЗ(Знач ДокументОснования, Объект, ДополнительныеПараметры)
	
	Если ДополнительныеПараметры = "ТолькоДозаполнитьПоСчетуФактуре" Тогда
		ДозаполнитьПоСчетуФактуре(Объект, Объект.ДокументОснование);
		
		Возврат;
	КонецЕсли;
	
	РеквизитыОперацииОснования = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(
		ДокументОснования,
		"СчетУчетаНДСКРаспределению,СчетУчетаНДС");
	
	Счет30304 = ПланыСчетов.ЕПСБУ.НайтиПоКоду("303.04");
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокОснованиеСсылка",			ДокументОснования);
	ЗапросЗаполнение.УстановитьПараметр("СчетУчетаНДСКРаспределению",	РеквизитыОперацииОснования["СчетУчетаНДСКРаспределению"]);
	ЗапросЗаполнение.УстановитьПараметр("СчетУчетаНДС",					РеквизитыОперацииОснования["СчетУчетаНДС"]);
	ЗапросЗаполнение.УстановитьПараметр("Счет30304",					Счет30304);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка											КАК ДокументКорректировки,
	|	Дата											КАК Дата,
	|	Организация										КАК Организация,
	|	ИФО												КАК ИФО,
	|	Подразделение									КАК Подразделение,
	|	Контрагент										КАК Контрагент,
	|	Договор											КАК Договор,
	|	ВалютаДокумента									КАК ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.АгентскийДоговор) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Покупка)
	|	КОНЕЦ											КАК ПричинаНалогообложения,
	|	ВЫБОР
	|		КОГДА Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.АгентскийДоговор) ТОГДА
	|			""06""
	|		ИНАЧЕ
	|			""01""
	|	КОНЕЦ											КАК КодВидаОперации
	|ИЗ
	|	Документ.ПоступлениеМЗ
	|ГДЕ
	|	Ссылка = &ДокОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка 											КАК ДокументОснование,
	|	Номенклатура									КАК НФА,
	|	ЕдиницаИзмерения								КАК ЕдиницаИзмерения,
	|	Ссылка.ПринятьНДСКВычету						КАК НДСКВычету,
	|	НДСКРаспределению								КАК НДСКРаспределению,
	|	КФО												КАК КФО,
	|	ВЫБОР
	|		КОГДА Ссылка.КПСРасчетов <> ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) ТОГДА
	|			Ссылка.КПСРасчетов
	|		ИНАЧЕ
	|			КПС
	|	КОНЕЦ											КАК КПСВычетКт,
	|	ВЫБОР
	|		КОГДА НДСКРаспределению ТОГДА
	|			&СчетУчетаНДСКРаспределению
	|		ИНАЧЕ
	|			&СчетУчетаНДС
	|	КОНЕЦ											КАК СчетВычетКт,
	|	&Счет30304										КАК Счет30304,
	|	
	|	// До корректировки
	|	СтавкаНДС										КАК СтавкаНДСДоИзменения,
	|	КоличествоДоКорректировки						КАК КоличествоДоИзменения,
	|	ВЫБОР
	|		КОГДА КоличествоДоКорректировки <> 0 И Ссылка.СуммаВключаетНДС ТОГДА
	|			ВЫРАЗИТЬ((СуммаДоКорректировки - СуммаНДСДоКорректировки) / КоличествоДоКорректировки КАК Число(15,2))
	|			
	|		КОГДА КоличествоДоКорректировки <> 0 И НЕ Ссылка.СуммаВключаетНДС ТОГДА
	|			ВЫРАЗИТЬ(СуммаДоКорректировки / КоличествоДоКорректировки КАК Число(15,2))
	|			
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ											КАК ЦенаДоИзменения,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			СуммаДоКорректировки - СуммаНДСДоКорректировки
	|		ИНАЧЕ
	|			СуммаДоКорректировки
	|	КОНЕЦ											КАК СуммаДоИзменения,
	|	СуммаНДСДоКорректировки							КАК СуммаНДСДоИзменения,
	|	ВсегоДоКорректировки							КАК ВсегоДоИзменения,
	|	
	|	// После корректировки
	|	СтавкаНДС										КАК СтавкаНДС,
	|	Количество										КАК Количество,
	|	ВЫБОР
	|		КОГДА Количество <> 0 И Ссылка.СуммаВключаетНДС ТОГДА
	|			ВЫРАЗИТЬ((Сумма - СуммаНДС) / Количество КАК Число(15,2))
	|			
	|		КОГДА Количество <> 0 И НЕ Ссылка.СуммаВключаетНДС ТОГДА
	|			ВЫРАЗИТЬ(Сумма / Количество КАК Число(15,2))
	|			
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ											КАК Цена,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			Сумма - СуммаНДС
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ											КАК Сумма,
	|	СуммаНДС										КАК СуммаНДС,
	|	Всего											КАК Всего
	|ИЗ
	|	Документ.ПоступлениеМЗ.Материалы КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &ДокОснованиеСсылка
	|;";
	
	РезультатыЗапросов = ЗапросЗаполнение.ВыполнитьПакет();
	
	// [0]. Данные шапки
	Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РезультатыЗапросов[0].Выгрузить()[0]);
	ЗаполнитьЗначенияСвойств(Объект, Шапка);
	
	// [1]. Данные табличной части СоставНФА
	Таблица = РезультатыЗапросов[1].Выгрузить();
	Объект.СоставНФА.Загрузить(Таблица);
	
	РезультатыПоиска = УчетНДС.НайтиПредыдущийСчетФактуруПоступления(ДокументОснования);
	
	Если РезультатыПоиска <> Неопределено Тогда
		ДозаполнитьПоСчетуФактуре(Объект, РезультатыПоиска.Ссылка);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.СоставНФА Цикл
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(СтрокаТаблицы, "Сумма");
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(СтрокаТаблицы, "СуммаНДС");
		УчетНДСКлиентСервер.ЗаполнитьУвеличениеУменьшение(СтрокаТаблицы, "Всего");
	КонецЦикла;
	
КонецПроцедуры

Процедура ДозаполнитьПоСчетуФактуре(ДокументОбъект, СчетФактура)
	
	Если НЕ ЗначениеЗаполнено(СчетФактура) Тогда
		Возврат;
	КонецЕсли;
	
	// Реквизиты шапки
	
	Если ТипЗнч(СчетФактура) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
		// Частичное заполнение, аналогичное ЗаполнитьНаОснованииСчетФактураПолученный
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "
			|Дата,
			|НомерПервичногоДокумента,
			|ДатаПервичногоДокумента,
			|ПричинаНалогообложения,
			|ВалютаДокумента,
			|КодВидаОперации");
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияРеквизитов,,"Дата");
		
		ДокументОбъект.ДокументОснование = СчетФактура;
		ДокументОбъект.ИсправляемыйДокумент = СчетФактура;
		ДокументОбъект.НомерСчетаФактуры = ЗначенияРеквизитов.НомерПервичногоДокумента;
		ДокументОбъект.ДатаСчетаФактуры = ЗначенияРеквизитов.ДатаПервичногоДокумента;
		ДокументОбъект.КорректируемыйПериод = ЗначенияРеквизитов.Дата;
		
	ИначеЕсли ТипЗнч(СчетФактура) = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный") Тогда
		// Частичное заполнение, аналогичное ЗаполнитьНаОснованииИсправительныйСчетФактураПолученный
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "
			|НомерСчетаФактуры,
			|ДатаСчетаФактуры,
			|ПричинаНалогообложения,
			|ВалютаДокумента,
			|ИсправляемыйДокумент,
			|КодВидаОперации");
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияРеквизитов);
		
		ДокументОбъект.ДокументОснование = СчетФактура;
		
	ИначеЕсли ТипЗнч(СчетФактура) = Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный") Тогда
		// Частичное заполнение, аналогичное ЗаполнитьНаОснованииКорректировочныйСчетФактураПолученный
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "
			|ПричинаНалогообложения,
			|ИсправляемыйДокумент,
			|КодВидаОперации");
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияРеквизитов);
		
		ДокументОбъект.ДокументОснование = СчетФактура;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	// Табличные части
	
	УчетНДС.ЗаполнитьПлатежноРасчетныеДокументы(ДокументОбъект, СчетФактура);
	
КонецПроцедуры


Процедура ЗаполнитьРеквизитыСторонСделки(ДокументОбъект) Экспорт
	
	ШапкаДокумента = Новый Структура("
		|Дата,
		|Контрагент,
		|Организация,
		|Подразделение,
		|ПричинаНалогообложения");
	
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);
	
	Если НЕ УчетНДС.ЗаполненыОбязательныеРеквизитыДляОпределенияСторонСделки(ШапкаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Данные = УчетНДС.РасширитьШапкуДокументаДляОпределенияПродавцаПокупателяГрузоотправителяГрузополучателя(ШапкаДокумента);
	
	ОбщаяКонтактнаяИнформация = УчетНДС.ПолучитьОбщуюКонтактнуюИнформациюПродавцаПокупателяГрузоотправителяГрузополучателя(
		Данные["СписокОбъектовДляОпределенияАдресов"]);
	
	СтороныСделки = УчетНДС.ОпределитьПродавцаПокупателяГрузоотправителяГрузополучателя(
		Данные["ШапкаДокументаРасширенная"],
		ОбщаяКонтактнаяИнформация);
	
	Параметры = Новый Структура();
	
	Параметры.Вставить("НаименованиеПродавца",	СтороныСделки.Продавец.Наименование);
	Параметры.Вставить("ИННПродавца",			СтороныСделки.Продавец.ИНН);
	Параметры.Вставить("КПППродавца",			СтороныСделки.Продавец.КПП);
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Параметры);
	
КонецПроцедуры


Функция СформироватьДвижения(СтруктураШапкиДокумента, ТаблицаДанных, Движения)
	//СчетРаспределения = ПланыСчетов.ЕПСБУ.НайтиПоКоду("210.Н1");
	// Если это счет-фактура налогового агента, то следует начислить НДС в бюджет и зарегистрироваться
