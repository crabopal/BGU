&НаКлиенте
Перем ПеренестиВДокумент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОтчетПоКассовойСмене = Параметры.ОтчетПоКассовойСмене;
	ТаблицаОстатков = РозничныеПродажиБГУ.ТаблицаДанныхДляВводаПКО(ОтчетПоКассовойСмене);
	НеучтенныеОплатыПоСчетамУчета.Загрузить(ТаблицаОстатков);
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ПеренестиВДокумент = Истина Тогда
		ОповеститьОВыборе(РезультатВыбора);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормы_НеучтенныеОплатыПоСчетамУчета

&НаКлиенте
Процедура НеучтенныеОплатыПоСчетамУчетаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	РезультатВыбора = Новый Структура("ИФО, КоличествоСчетовУчета, СчетУчета, Сумма, Подразделение", 
		ПредопределенноеЗначение("Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка"),
		0, Неопределено, 0, ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка"));
	ЗаполнитьЗначенияСвойств(РезультатВыбора, НеучтенныеОплатыПоСчетамУчета[ВыбраннаяСтрока]);
	РезультатВыбора.КоличествоСчетовУчета = 1;
	ПеренестиВДокумент = Истина;
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьСчетУчетаДляНовогоДокумента(Команда)
	
	ТекущиеДанные = Элементы.НеучтенныеОплатыПоСчетамУчета.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не выбран счет учета!'");
		Сообщение.Сообщить();
	Иначе
		РезультатВыбора = Новый Структура("ИФО, КоличествоСчетовУчета, СчетУчета, Сумма, Подразделение", 
		ПредопределенноеЗначение("Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка"),
		0, Неопределено, 0, ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка"));
		ЗаполнитьЗначенияСвойств(РезультатВыбора, ТекущиеДанные);
		РезультатВыбора.КоличествоСчетовУчета = 1;
		ПеренестиВДокумент = Истина;
		
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции


#КонецОбласти