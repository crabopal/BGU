	Результат = "";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЭквайринговаяОперация.ДокументОснование КАК ДокументОснование,
	|	ЭквайринговаяОперация.СуммаДокумента КАК Сумма
	|ИЗ
