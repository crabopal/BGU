&НаСервере
Функция ТекстОтраженияВУчетеАктов()
	
	Результат = "";
	
	УстановитьПривилегированныйРежим(Истина);
	
	СуммаОтраженияВучете = СуммаАктовОбОказанииУслуг(Объект.Ссылка);
	СуммаУслугКОтражению = Объект.СуммаУслугКОтражению;
	
	Если (СуммаУслугКОтражению = СуммаОтраженияВучете) Тогда
		Результат = НСтр("ru = 'Отражено в учете услуг на сумму: '") + Формат(СуммаОтраженияВучете, "ЧЦ=17; ЧДЦ=2") +" "+ Строка(ВалютаРубли);
	Иначе
		Результат = НСтр("ru = 'Не отражено в учете услуг на сумму: '") + Формат(СуммаУслугКОтражению - СуммаОтраженияВучете, "ЧЦ=17; ЧДЦ=2") +" "+ Строка(ВалютаРубли);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СоздатьДокументыАктОбОказанииУслугНаСервере()
	
	Если  ЗначениеЗаполнено(Объект.Ссылка) Тогда 
				
		ДатаДокументов 		= Объект.Дата;
		Организация 		= Объект.Организация;
		ДокументСсылка 		= Объект.Ссылка;
		РеквизитыККМ 		= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.КассаККМ, "ТипЦены,СуммаВключаетНДС,ОперацияОтраженияУслуг,УчетПоПодразделениям, ПроводитьДокументыОтраженияУслуг");
		
		РезультатЗапроса 	= Документы.ОтчетПоКассовойСмене.ЗапросНоменклатураАктовОбОказанииУслуг(Объект);
		ДанныеДокументов 	= РезультатЗапроса[2].Выбрать();
		ДанныеПродаж 		= РезультатЗапроса[3].Выгрузить();
		
		Объект.СуммаУслугКОтражению = ДанныеПродаж.Итог("Всего");
		
		НовыйДокумент = Истина;
		
		Если ДанныеПродаж.Итог("Всего") = СуммаАктовОбОказанииУслуг(ДокументСсылка) Тогда 
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Сумма оказанных услуг соответствует сумме документов ""Акт об оказании услуг"""
				+ ", созданных на основании отчета. Создание документов ""Акт об оказании услуг"" не требуется.'"))	
		Иначе 	
			Пока ДанныеДокументов.Следующий() Цикл 
				
				ПараметрыОтбора = Новый Структура();
				ПараметрыОтбора.Вставить("Контрагент" 		, ДанныеДокументов.Контрагент);
				ПараметрыОтбора.Вставить("Договор" 			, ДанныеДокументов.Договор);
				ПараметрыОтбора.Вставить("СтатьяАналитики" 	, ДанныеДокументов.СтатьяАналитики);
				Если РеквизитыККМ.УчетПоПодразделениям Тогда 
					ПараметрыОтбора.Вставить("Подразделение" 	, ДанныеДокументов.Подразделение);	
				КонецЕсли;	
				ТаблицаПродаж = ДанныеПродаж.НайтиСтроки(ПараметрыОтбора);
				
				Если НовыйДокумент ИЛИ НЕ ДанныеДокументов.КомиссионнаяТорговля Тогда
					ДокументОбъект = Документы.АктОбОказанииУслуг.СоздатьДокумент();
					
					ЛицевойСчетОрганизиции = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация,
						"Документ.ЗаявкаНаВозврат", Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
					Если ЗначениеЗаполнено(ЛицевойСчетОрганизиции.РеквизитыЛицевогоСчета) Тогда
						ДокументОбъект.РеквизитыЛицевогоСчета = ЛицевойСчетОрганизиции.РеквизитыЛицевогоСчета;
					КонецЕсли;   
					
					Если ЭлектронныеДокументыБГУ.УПДЗаполнятьДатуПередачиПоДатеДокументаРеализации(Объект.Организация) Тогда
						
						ДокументОбъект.ДатаПередачиТРУ = ДатаДокументов;
						ДокументОбъект.ТРУПереданы = Истина;
						
					КонецЕсли;  
					
					СведенияПоОтветственному = ЭлектронныеДокументыБГУ.ПолучитьСведенияОтветственныхЭлектронныУПД(Объект.Организация);
					
					Если ЗначениеЗаполнено(СведенияПоОтветственному) Тогда
						
						ДокументОбъект.ОтветственныйПередалТРУ 						= СведенияПоОтветственному.ОтветственныйПередалТРУ;	
						ДокументОбъект.ОтветственныйПередалТРУВид 					= СведенияПоОтветственному.ОтветственныйПередалТРУВид;
						ДокументОбъект.ОтветственныйПередалТРУДоверенность 			= СведенияПоОтветственному.ОтветственныйПередалТРУДоверенность;
						ДокументОбъект.ОтветственныйПередалТРУДолжность 			= СведенияПоОтветственному.ОтветственныйПередалТРУДолжность;
						ДокументОбъект.ОтветственныйПередалТРУИныеСведения 			= СведенияПоОтветственному.ОтветственныйПередалТРУИныеСведения;
						ДокументОбъект.ОтветственныйПередалТРУКонтрагент 			= СведенияПоОтветственному.ОтветственныйПередалТРУКонтрагент;
						ДокументОбъект.ОтветственныйПередалТРУДокументПолномочий 	= СведенияПоОтветственному.ОтветственныйПередалТРУДокументПолномочий;
						ДокументОбъект.ОтветственныйПередалТРУОснованиеПолномочий 	= "";
					КонецЕсли;

					НовыйДокумент = Ложь;
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеДокументов);
				
				Для Каждого СтрокаДокумента Из ТаблицаПродаж Цикл 
					НоваяСтрока = ДокументОбъект.УслугиОказанные.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
				КонецЦикла;	
				
				ДокументОбъект.Организация			= Организация;
				ДокументОбъект.Дата 				= ДатаДокументов;
				ДокументОбъект.СуммаДокумента 		= ДанныеДокументов.Всего;
				ДокументОбъект.ДокументОснование 	= ДокументСсылка;
				ДокументОбъект.ТипЦены 				= РеквизитыККМ.ТипЦены;
				ДокументОбъект.СуммаВключаетНДС 	= РеквизитыККМ.СуммаВключаетНДС;
				ДокументОбъект.Руководитель 		= ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
					Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, Организация, ДатаДокументов).ОтветственноеЛицоСсылка;
				
				ДанныеАналитики = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеДокументов.СтатьяАналитики, "СчетУчета,КФО,КПС,КЭК");
				Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Документ создан на основании отчета по кассовой смене № %1 от %2. Счет учета: %3, КФО: %4, КПС: %5, КЭК: %6'"),
				СокрЛП(Объект.Номер),
				Формат(Объект.Дата, "ДЛФ=D"),
				ДанныеАналитики.СчетУчета,
				ДанныеАналитики.КФО,
				ДанныеАналитики.КПС,
				ДанныеАналитики.КЭК);
				ДокументОбъект.Комментарий 			= Комментарий;
				
				РеквизитыОперации = БухгалтерскиеОперацииСервер.РеквизитыТиповойОперацииПоУмолчанию(
					ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ.АктОбОказанииУслуг"), РеквизитыККМ.ОперацияОтраженияУслуг, Организация);
				РеквизитыОперации.Вставить("СчетРасчетов"	, ДанныеАналитики.СчетУчета); 
				РеквизитыОперации.Вставить("КОСГУ"			, ДанныеАналитики.КЭК);
				РеквизитыОперации.Вставить("КПС"			, ДанныеАналитики.КПС);
				РеквизитыОперации.Вставить("КФО"			, ДанныеАналитики.КФО);
				БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(ДокументОбъект, РеквизитыККМ.ОперацияОтраженияУслуг, РеквизитыОперации);
				
				Если РеквизитыККМ.ПроводитьДокументыОтраженияУслуг Тогда
					РежимЗаписи = РежимЗаписиДокумента.Проведение;
					
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Проведен документ ""%1"".'"),
					ДокументОбъект);
				Иначе
					РежимЗаписи = РежимЗаписиДокумента.Запись;
					
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Создан документ ""%1"". Для проведения необходимо заполнить реквизиты бухгалтерской операции!'"),
					ДокументОбъект);
				КонецЕсли;
				
				ДокументОбъект.Записать(РежимЗаписи);
				
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				
				Если СтрокаДокумента.КомиссионнаяТорговля Тогда
					ПризнакКомиссионнойТорговли = Истина;
					Продолжить;
				КонецЕсли;
				
			КонецЦикла;	
		КонецЕсли;
		РассчитатьИтогиАктОбОказанииУслуг();
	Иначе
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Для выполнения операции необходимо записать документ!'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВычислитьСуммуУслугКОтражению()
	
	РезультатЗапроса = Документы.ОтчетПоКассовойСмене.ЗапросНоменклатураАктовОбОказанииУслуг(Объект);
	Объект.СуммаУслугКОтражению = РезультатЗапроса[2].Выгрузить().Итог("Всего");
	УстановитьВидимостьЭлементовФормы();
	
КонецПроцедуры	
	
