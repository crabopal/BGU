&НаСервере
Процедура ЗаполнитьДокументЗаСменуНаСервере()

	ТипОборудования = 0;
	
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		Если Объект.КассаККМ.ИспользоватьБезПодключенияОборудования Тогда
			ЗаполнитьПоДаннымЧековНаСервереЗаДень();
		Иначе
			ТипОборудования = Объект.КассаККМ.ТипОборудования;
			Если (ТипОборудования = 0 И ЗначениеЗаполнено(Объект.КассаККМ.ПодключаемоеОборудование)) 
				Или (ТипОборудования = 1 И ЗначениеЗаполнено(Объект.КассаККМ.ОффлайнОборудование)) Тогда
				ПараметрыОбмена = ПолучитьПараметрыОбмена(Объект.КассаККМ);
				Если ПараметрыОбмена.Следующий() Тогда 
					ЗагружатьКакЧекиККМ = ПараметрыОбмена.ЗагружатьКакЧекиККМ;
				КонецЕсли;	
				Если (ТипОборудования = 1) И НЕ ЗагружатьКакЧекиККМ Тогда
					ТекстОшибки = НСтр("ru='Для офлайн кассы ККМ заполнение осуществляется автоматически при загрузке сведений о продажах через обработку ""Обмен с офлайн оборудованием"" в разделе ""Денежные средства""!'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.КассоваяСмена");
					Возврат;
				Иначе
					Если НЕ ЗначениеЗаполнено(Объект.КассоваяСмена) Тогда
						ТекстОшибки = НСтр("ru='Не указана кассовая смена!'");
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.КассоваяСмена");
						Возврат;
					КонецЕсли;	
				
					ЗаполнитьПоДаннымЧековНаСервере(Объект.КассоваяСмена);
				КонецЕсли;	
			Иначе
				ТекстОшибки = НСтр("ru='Не указано оборудование у кассы ККМ!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.КассаККМ");
				Возврат;
			КонецЕсли;	
		КонецЕсли;
		РассчитатьИтогиОплаты();
		РассчитатьИтогиНДС();
		РассчитатьИтогиПродажиТовары();
		РассчитатьИтогиПродажиРаботыУслуги();
			
		Объект.СуммаДокумента = Объект.ОплатаНаличными.Итог("Сумма");
			
		Объект.СуммаПродажНаличнымиРозничнымПокупателям = ВсегоРозницаНаличными();
		
		ВычислитьСуммуУслугКОтражению();
		
		УстановитьВидимостьЭлементовФормы();
		
		НадписьОтражениеВУчетеКассы 		= ТекстОтраженияВУчетеКассы();
		НадписьОтражениеВУчетеЭквайринга 	= ТекстОтраженияВУчетеЭквайринга();
		НадписьОтражениеВУчетеАктов 		= ТекстОтраженияВУчетеАктов();
		
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Функция ВсегоРозницаНаличными()
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Таб.Сумма,
	               |	Таб.ЭтоРозничныйПокупатель
	               |ПОМЕСТИТЬ ДанныеРозницы
	               |ИЗ
	               |	&ДанныеРозницыНаличными КАК Таб
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(ДанныеРозницы.Сумма) КАК Сумма
	               |ИЗ
	               |	ДанныеРозницы КАК ДанныеРозницы
	               |ГДЕ
	               |	ДанныеРозницы.ЭтоРозничныйПокупатель = ИСТИНА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДанныеРозницы.ЭтоРозничныйПокупатель";
	Запрос.УстановитьПараметр("ДанныеРозницыНаличными", Объект.ОплатаНаличными.Выгрузить(,"ЭтоРозничныйПокупатель, Сумма"));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.Сумма;
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Функция ЧекиДляЗаполнения(ЗаДень = Ложь, КассоваяСмена = Неопределено)
	
	Запрос = Новый Запрос;
	
	Если ЗаДень Тогда
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ЧекККМ.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.ЧекККМ КАК ЧекККМ
		               |ГДЕ
		               |	НАЧАЛОПЕРИОДА(ЧекККМ.Дата, ДЕНЬ) = &ДатаСведений
		               |	И ЧекККМ.ПометкаУдаления = ЛОЖЬ
		               |	И ЧекККМ.КассаККМ = &КассаККМ
		               |	И НЕ ЧекККМ.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПередачаБезОплаты)
		               |	И НЕ ЧекККМ.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПредоплатаЧастичная)
		               |	И НЕ ЧекККМ.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ОплатаКредита)
		               |	И ЧекККМ.СтатусЧекаККМ = &СтатусЧекаККМПробит
		               |	И ЧекККМ.УчитыватьТолькоОплату = ЛОЖЬ
		               |	И НЕ ЧекККМ.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПредоплатаПолная)
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ФискальныеОперации.ДокументОснование
		               |ИЗ
		               |	РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
		               |ГДЕ
		               |	ФискальныеОперации.ДокументОснование ССЫЛКА Документ.ЧекККМ
		               |	И НАЧАЛОПЕРИОДА(ФискальныеОперации.Дата, ДЕНЬ) = &ДатаСведений
		               |	И ФискальныеОперации.ДокументОснование.КассаККМ = &КассаККМ
		               |	И НЕ ФискальныеОперации.ДокументОснование.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПередачаБезОплаты)
		               |	И НЕ ФискальныеОперации.ДокументОснование.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПредоплатаЧастичная)
		               |	И НЕ ФискальныеОперации.ДокументОснование.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ОплатаКредита)
		               |	И ФискальныеОперации.ДокументОснование.Проведен = ИСТИНА
		               |	И ФискальныеОперации.ДокументОснование.УчитыватьТолькоОплату = ЛОЖЬ
		               |	И НЕ ФискальныеОперации.ДокументОснование.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПредоплатаПолная)";
		
		Запрос.УстановитьПараметр("КассаККМ", Объект.КассаККМ);
		Запрос.УстановитьПараметр("ДатаСведений", НачалоДня(Объект.Дата));
	Иначе
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ЧекККМ.Ссылка КАК Ссылка,
		               |	ЧекККМ.Дата КАК Дата
		               |ИЗ
		               |	Документ.ЧекККМ КАК ЧекККМ
		               |ГДЕ
		               |	ЧекККМ.КассоваяСмена = &КассоваяСмена
		               |	И ЧекККМ.ПометкаУдаления = ЛОЖЬ
		               |	И НЕ ЧекККМ.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПередачаБезОплаты)
		               |	И НЕ ЧекККМ.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПредоплатаЧастичная)
		               |	И НЕ ЧекККМ.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ОплатаКредита)
		               |	И ЧекККМ.СтатусЧекаККМ = &СтатусЧекаККМПробит
		               |	И ЧекККМ.УчитыватьТолькоОплату = ЛОЖЬ
		               |	И НЕ ЧекККМ.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПредоплатаПолная)
		               |	И ЧекККМ.ИдентификаторКорзины = """"
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ФискальныеОперации.ДокументОснование,
		               |	ФискальныеОперации.Дата
		               |ИЗ
		               |	РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
		               |ГДЕ
		               |	ФискальныеОперации.ДокументОснование ССЫЛКА Документ.ЧекККМ
		               |	И НЕ ФискальныеОперации.ДокументОснование.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПередачаБезОплаты)
		               |	И НЕ ФискальныеОперации.ДокументОснование.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПредоплатаЧастичная)
		               |	И НЕ ФискальныеОперации.ДокументОснование.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ОплатаКредита)
		               |	И ФискальныеОперации.ДокументОснование.КассоваяСмена = &КассоваяСмена
		               |	И ФискальныеОперации.ДокументОснование.Проведен = ИСТИНА
		               |	И ФискальныеОперации.ДокументОснование.УчитыватьТолькоОплату = ЛОЖЬ
		               |	И НЕ ФискальныеОперации.ДокументОснование.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПредоплатаПолная)
		               |	И ФискальныеОперации.ДокументОснование.ИдентификаторКорзины = """"";
		
		Запрос.УстановитьПараметр("КассоваяСмена", КассоваяСмена);
	КонецЕсли;				   
	
	Запрос.УстановитьПараметр("СтатусЧекаККМПробит", Перечисления.СтатусыЧековККМ.Пробитый);
	
	Результаты = Запрос.Выполнить().Выгрузить();
	
	Возврат Результаты.ВыгрузитьКолонку("Ссылка");

КонецФункции

&НаСервере
Функция ЧекиВозвратаДляЗаполнения(ЗаДень = Ложь, КассоваяСмена = Неопределено)
	
	Запрос = Новый Запрос;
	
	Если ЗаДень Тогда
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ЧекККМНаВозврат.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.ЧекККМНаВозврат КАК ЧекККМНаВозврат
		               |ГДЕ
		               |	НАЧАЛОПЕРИОДА(ЧекККМНаВозврат.Дата, ДЕНЬ) = &ДатаСведений
		               |	И ЧекККМНаВозврат.ПометкаУдаления = ЛОЖЬ
		               |	И ЧекККМНаВозврат.КассаККМ = &КассаККМ
		               |	И НЕ ЧекККМНаВозврат.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПередачаБезОплаты)
		               |	И НЕ ЧекККМНаВозврат.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПредоплатаЧастичная)
		               |	И НЕ ЧекККМНаВозврат.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ОплатаКредита)
		               |	И ЧекККМНаВозврат.СтатусЧекаККМ = &СтатусЧекаККМПробит
		               |	И ЧекККМНаВозврат.УчитыватьТолькоОплату = ЛОЖЬ
		               |	И НЕ ЧекККМНаВозврат.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПредоплатаПолная)
		               |
