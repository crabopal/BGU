&НаСервере
Процедура УстановитьДанныеДляПечатиЧековККМ(ИзмененаОрганизация = Ложь)

	РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	НастройкиОборудования = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьНастройкиОборудования(РабочееМесто, Объект.Организация);
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) ИЛИ ИзмененаОрганизация Тогда
		Объект.КассаККМ = НастройкиОборудования.ФискальныйРегистратор;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.КассоваяСмена) Тогда
		Объект.КассоваяСмена = РозничныеПродажиБГУ.ПоследняяКассоваяСмена(Объект.Организация, Объект.КассаККМ);	
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура РассчитатьИтогиОплаты()
	РассчитатьИтогиОплатыНаличными();	
	РассчитатьИтогиОплатыПлатежнымиКартами();
КонецПроцедуры	

&НаСервере
Процедура РассчитатьИтогиОплатыНаличными()
	
	ИтогОплатыНаличнымиВсего = Объект.ОплатаНаличными.Итог("Сумма");
	ИтогОплатыНаличнымиВозвраты = 0;
	ИтогОплатыНаличнымиПродажи = 0;
	
	ОплатаНаличными = Объект.ОплатаНаличными.Выгрузить();
	
	ОплатаНаличными.Свернуть("ВидОперации", "Сумма");
	
	Для каждого ТекСтрока Из ОплатаНаличными Цикл
		Если ТекСтрока.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат Тогда
			ИтогОплатыНаличнымиВозвраты = ТекСтрока.Сумма;
		Иначе
			ИтогОплатыНаличнымиПродажи = ТекСтрока.Сумма;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура РассчитатьИтогиОплатыПлатежнымиКартами()
	
	ИтогОплатыПлатежныеКартыВсего 		= Объект.ОплатаПлатежнымиКартами.Итог("Сумма");
	ИтогОплатыПлатежныеКартыВозвраты 	= 0;
	ИтогОплатыПлатежныеКартыПродажи 	= 0;
	
	ОплатаПлатежнымиКартами = Объект.ОплатаПлатежнымиКартами.Выгрузить();
	
	ОплатаПлатежнымиКартами.Свернуть("ВидОперации", "Сумма");
	
	Для каждого ТекСтрока Из ОплатаПлатежнымиКартами Цикл
		Если ТекСтрока.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат Тогда
			ИтогОплатыПлатежныеКартыВозвраты = ТекСтрока.Сумма;
		Иначе
			ИтогОплатыПлатежныеКартыПродажи = ТекСтрока.Сумма;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

