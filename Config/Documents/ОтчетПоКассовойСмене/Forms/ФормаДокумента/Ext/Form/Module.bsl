&НаСервере
Функция ЕдинственныйСчетУчетаПродажЗаНаличные()
	
	Результат = Новый Структура("ИФО, КоличествоСчетовУчета, СчетУчета, Сумма, Подразделение", 
		Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка(), 0, Неопределено, 0, Справочники.Подразделения.ПустаяСсылка());
	
	ТаблицаОстатков = РозничныеПродажиБГУ.ТаблицаДанныхДляВводаПКО(Объект.Ссылка);
	
	Результат.КоличествоСчетовУчета = ТаблицаОстатков.Количество();	
	Если ТаблицаОстатков.Количество() = 1 Тогда
		Результат.КоличествоСчетовУчета = 1;	
		ЗаполнитьЗначенияСвойств(Результат, ТаблицаОстатков[0]);
	ИначеЕсли ТаблицаОстатков.Количество() > 1 Тогда
		Результат.Сумма = ТаблицаОстатков.Итог("Сумма");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СуммаЭквайринговыхОперацийДляОтчета()
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭквайринговаяОперация.ДокументОснование КАК ДокументОснование,
	               |	СУММА(ЭквайринговаяОперация.СуммаДокумента) КАК СуммаДокумента
	               |ИЗ
	               |	Документ.ЭквайринговаяОперация КАК ЭквайринговаяОперация
	               |ГДЕ
	               |	ЭквайринговаяОперация.ПометкаУдаления = ЛОЖЬ
	               |	И ЭквайринговаяОперация.ДокументОснование = &ОтчетПоКассовойСмене
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЭквайринговаяОперация.ДокументОснование";
	
	Запрос.УстановитьПараметр("ОтчетПоКассовойСмене", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.СуммаДокумента;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура СоздатьПриходныйКассовыйОрдерНаКлиенте()
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Документ не записан. Сначала следует записать документ!'"));
		Возврат;
	КонецЕсли;
	
	СчетУчетаПродажЗаНаличные = ЕдинственныйСчетУчетаПродажЗаНаличные();
	Если (СчетУчетаПродажЗаНаличные.КоличествоСчетовУчета = 0) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Введены приходные кассовые ордеры на всю сумму наличных денежных средств!'");
		Сообщение.Сообщить();
		
		Возврат;
	ИначеЕсли СчетУчетаПродажЗаНаличные.КоличествоСчетовУчета = 1 Тогда	
		СоздатьНовыйДокументПКОНаКлиенте(СчетУчетаПродажЗаНаличные);
	Иначе
		Если (СчетУчетаПродажЗаНаличные.Сумма = 0) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Введены приходные кассовые ордеры на всю сумму наличных денежных средств!'");
			Сообщение.Сообщить();
			
			Возврат;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ОтчетПоКассовойСмене", Объект.Ссылка);
		ОткрытьФорму("Документ.ОтчетПоКассовойСмене.Форма.ПомощникЗаполненияДокументовУчетаРозничныхПродаж", ПараметрыФормы, ЭтаФорма);
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура СоздатьНовыйДокументПКОНаКлиенте(СчетУчетаПродажЗаНаличные)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОтчетПоКассовойСмене", Объект.Ссылка);
	ПараметрыФормы.Вставить("СчетУчетаПродажЗаНаличные", СчетУчетаПродажЗаНаличные);
	ОткрытьФорму("Документ.ПриходныйКассовыйОрдер.Форма.ФормаДокумента", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтражениеУчтенныхДенежныхСредств()
	НадписьОтражениеВУчетеКассы = ТекстОтраженияВУчетеКассы();
	НадписьОтражениеВУчетеЭквайринга = ТекстОтраженияВУчетеЭквайринга();
	НадписьОтражениеВУчетеАктов = ТекстОтраженияВУчетеАктов();
КонецПроцедуры

&НаСервере
Функция ТекстОтраженияВУчетеКассы()
	Результат = "";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПриходныйКассовыйОрдер.ДокументОснование КАК ДокументОснование,
	|	ПриходныйКассовыйОрдер.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|ГДЕ
	|	ПриходныйКассовыйОрдер.ПометкаУдаления = ЛОЖЬ
	|	И ПриходныйКассовыйОрдер.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	ДокументыОтражения = Запрос.Выполнить().Выгрузить();
	СуммаОтраженияВучете = ДокументыОтражения.Итог("Сумма");
	
	Если Объект.ОплатаНаличными.Итог("Сумма") = СуммаОтраженияВучете Тогда
		Результат = НСтр("ru = 'Отражено в учете кассы на сумму: '") + Формат(СуммаОтраженияВучете, "ЧЦ=17; ЧДЦ=2") +" "+ Строка(ВалютаРубли);
	Иначе
		Результат = НСтр("ru = 'Не отражено в учете кассы на сумму: '") + Формат(Объект.СуммаДокумента - СуммаОтраженияВучете, "ЧЦ=17; ЧДЦ=2") +" "+ Строка(ВалютаРубли);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
КонецФункции

&НаСервере
