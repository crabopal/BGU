Процедура РассчитатьИтогиНДС()
	
	ИтогНДСВсего = Объект.ПродажиПоСтавкамНДС.Итог("СуммаНДС");
	ИтогНДСНаличными = 0;
	ИтогНДСПлатежнымиКартами = 0;
	
	ИтогНДССуммаВсего = Объект.ПродажиПоСтавкамНДС.Итог("Сумма");
	ИтогНДССуммаНаличными = 0;
	ИтогНДССуммаПлатежнымиКартами = 0;
	
	ТЗ_ПродажиПоСтавкамНДС = Объект.ПродажиПоСтавкамНДС.Выгрузить();
	
	ТЗ_ПродажиПоСтавкамНДС.Свернуть("ТипОплаты", "СуммаНДС, Сумма");
	
	Для каждого ТекСтрока Из ТЗ_ПродажиПоСтавкамНДС Цикл
		Если ТекСтрока.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта Тогда
			ИтогНДСПлатежнымиКартами = ТекСтрока.СуммаНДС;
			ИтогНДССуммаПлатежнымиКартами = ТекСтрока.Сумма;
		Иначе
			ИтогНДСНаличными = ТекСтрока.СуммаНДС;
			ИтогНДССуммаНаличными = ТекСтрока.Сумма;
		КонецЕсли;	
	КонецЦикла;
	
	ИтогНДСПредоплатаВсего 		= Объект.ПродажиПоСтавкамНДСПредоплата.Итог("СуммаНДС");
	ИтогНДССуммаПредоплатаВсего = Объект.ПродажиПоСтавкамНДСПредоплата.Итог("Сумма");
	
КонецПроцедуры	

&НаСервере
Процедура РассчитатьИтогиПродажиТовары()
	
	ИтогРеализацияТоваровВозвратыСумма 		= Объект.ВозвратТовары.Итог("Всего");
	ИтогРеализацияТоваровПродажиСумма 		= Объект.ПродажиТовары.Итог("Всего");
	ИтогРеализацияТоваровВсегоСумма 		= ИтогРеализацияТоваровПродажиСумма - ИтогРеализацияТоваровВозвратыСумма;
	
	ИтогРеализацияТоваровВозвратыКоличество = Объект.ВозвратТовары.Итог("Количество");
	ИтогРеализацияТоваровПродажиКоличество 	= Объект.ПродажиТовары.Итог("Количество");
	ИтогРеализацияТоваровВсегоКоличество 	= ИтогРеализацияТоваровПродажиКоличество - ИтогРеализацияТоваровВозвратыКоличество;
		
КонецПроцедуры

&НаСервере
Процедура РассчитатьИтогиПродажиРаботыУслуги()
	
	ИтогРеализацияРаботУслугВозвратыСумма 		= Объект.ОтменаРаботыУслуги.Итог("Всего");
	ИтогРеализацияРаботУслугПродажиСумма 		= Объект.ПродажиРаботыУслуги.Итог("Всего");
	ИтогРеализацияРаботУслугВсегоСумма 			= ИтогРеализацияРаботУслугПродажиСумма - ИтогРеализацияРаботУслугВозвратыСумма;
	
	ИтогРеализацияРаботУслугВозвратыКоличество	= Объект.ОтменаРаботыУслуги.Итог("Количество");
	ИтогРеализацияРаботУслугПродажиКоличество 	= Объект.ПродажиРаботыУслуги.Итог("Количество");
	ИтогРеализацияРаботУслугВсегоКоличество 	= ИтогРеализацияРаботУслугПродажиКоличество - ИтогРеализацияРаботУслугВозвратыКоличество;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСуммуДокументаНаСервере()
	
	Объект.СуммаДокумента = Объект.ОплатаНаличными.Итог("Сумма");
	Объект.СуммаПродажНаличнымиРозничнымПокупателям = ВсегоРозницаНаличными();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЭквайринговуюОперациюНаКлиенте()
	
	ТекущиеДанные = Элементы.ОплатаПлатежнымиКартами.ТекущиеДанные;
	
	СуммаЭквайринговыхОперацийДляОтчета = СуммаЭквайринговыхОперацийДляОтчета();
	Если СуммаЭквайринговыхОперацийДляОтчета >= Объект.ОплатаПлатежнымиКартами.Итог("Сумма") Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Введены эквайринговые операции на всю сумму оплаты платежными картами!'");
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не выбрана строка для создания эквайринговой операции!'");
		Сообщение.Сообщить();
		
		Возврат;
	ИначеЕсли ТекущиеДанные.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЧекККМ.Возврат") Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Операция возврата в пределах кассовой смены не требует отдельной операции учитывается 
		|как уменьшение суммы продаж и комиссии в эквайринговой операции по строке продаж!'");
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;	

	СуммаДокумента = ТекущиеДанные.Сумма;
	СуммаКомиссии = ТекущиеДанные.СуммаКомиссии;
	
	ДанныеВозврата = ПолучитьСвденияОВозвратеПоСтроке(ТекущиеДанные);
	
	Если ДанныеВозврата.Сумма<>0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Сумма эквайринговой операции скорректирована на сумму возврата!'");
		Сообщение.Сообщить();
	Конецесли;	
	
	СуммаДокумента = ТекущиеДанные.Сумма + ДанныеВозврата.Сумма;
	СуммаКомиссии = ТекущиеДанные.СуммаКомиссии + ДанныеВозврата.СуммаКомиссии;
	
	ПроцентКомиссии = ?(СуммаДокумента = 0, 0,СуммаКомиссии/(СуммаДокумента/100));
	
	ПараметрыДоговораЭквайринга = ТекущиеДанные.ПараметрыДоговораЭквайринга;
	
	ПараметрыНДСКомиссии = ПолучитьПараметрыНДСКомиссииБанка(ПараметрыДоговораЭквайринга, СуммаКомиссии);
		
	Если ТекущиеДанные.ПризнакСпособаРасчетаЧекаККМ = ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ПредоплатаЧастичная") ИЛИ
		 ТекущиеДанные.ПризнакСпособаРасчетаЧекаККМ = ПредопределенноеЗначение("Перечисление.ПризнакиСпособаРасчета.ПредоплатаПолная") Тогда 
		СпособПогашенияЗадолженности = ПредопределенноеЗначение("Перечисление.СпособыПогашенияЗадолженности.НеПогашать");
	Иначе	
		СпособПогашенияЗадолженности = ПредопределенноеЗначение("Перечисление.СпособыПогашенияЗадолженности.Автоматически");
	КонецЕсли;	
	
	СтруктураДанныхДокумента = Новый Структура;
	СтруктураДанныхДокумента.Вставить("ОтчетПоКассовойСмене"				, Объект.Ссылка);
	СтруктураДанныхДокумента.Вставить("Дата"								, Объект.Дата);
	СтруктураДанныхДокумента.Вставить("Организация"							, Объект.Организация);
	СтруктураДанныхДокумента.Вставить("ВидОперации"							, ТекущиеДанные.ВидОперации);
	СтруктураДанныхДокумента.Вставить("ПараметрыДоговораЭквайринга"			, ПараметрыДоговораЭквайринга);
	СтруктураДанныхДокумента.Вставить("СуммаДокумента"						, СуммаДокумента);
	СтруктураДанныхДокумента.Вставить("СуммаКомиссииБанка"					, СуммаКомиссии);
	СтруктураДанныхДокумента.Вставить("ПроцентКомиссииБанка"				, ПроцентКомиссии);
	СтруктураДанныхДокумента.Вставить("ЭквайринговыйТерминал"				, ТекущиеДанные.ЭквайринговыйТерминал);
	СтруктураДанныхДокумента.Вставить("Контрагент"							, ТекущиеДанные.Контрагент);
	СтруктураДанныхДокумента.Вставить("Договор"								, ТекущиеДанные.Договор);
	СтруктураДанныхДокумента.Вставить("Подразделение"						, ТекущиеДанные.Подразделение);
	СтруктураДанныхДокумента.Вставить("ЭтоРозничныйПокупатель"				, ТекущиеДанные.ЭтоРозничныйПокупатель);
	СтруктураДанныхДокумента.Вставить("ПроцентКомиссии"						, ТекущиеДанные.ПроцентКомиссии);
	СтруктураДанныхДокумента.Вставить("ВидПлатежнойКарты"					, ТекущиеДанные.ВидПлатежнойКарты);
	СтруктураДанныхДокумента.Вставить("СтатьяАналитикиОплаты"				, ТекущиеДанные.СтатьяАналитикиОплаты);
	СтруктураДанныхДокумента.Вставить("КоличествоОпераций"					, 1);
	СтруктураДанныхДокумента.Вставить("ВидПервичногоДокумента"				, "Отчет о закрытии смены");
	СтруктураДанныхДокумента.Вставить("КассоваяСмена"						, Объект.КассоваяСмена);
	СтруктураДанныхДокумента.Вставить("ПараметрыДоговораПлатежногоАгента"	, ТекущиеДанные.ПараметрыДоговораПлатежногоАгента);
	СтруктураДанныхДокумента.Вставить("ФискальныйРегистратор"				, Объект.КассаККМ);
	СтруктураДанныхДокумента.Вставить("ПризнакСпособаРасчетаЧекаККМ"		, ТекущиеДанные.ПризнакСпособаРасчетаЧекаККМ);
	СтруктураДанныхДокумента.Вставить("СпособПогашенияЗадолженности"		, СпособПогашенияЗадолженности);
	СтруктураДанныхДокумента.Вставить("ВидРасчетов"							, ТекущиеДанные.ВидРасчетов);
	СтруктураДанныхДокумента.Вставить("ОплатитьДо"							, ТекущиеДанные.ОплатитьДо);
	СтруктураДанныхДокумента.Вставить("СтавкаНДССКомиссииБанка"				, ПараметрыНДСКомиссии.СтавкаНДССКомисииБанка);
	СтруктураДанныхДокумента.Вставить("СуммаНДССКомиссииБанка"				, ПараметрыНДСКомиссии.СуммаНДССКомиссииБанка);
	СтруктураДанныхДокумента.Вставить("НДССКомиссииСверху"					, ПараметрыНДСКомиссии.НДССКомиссииСверху); 
	
	Если ПараметрыНДСКомиссии.НДССКомиссииСверху Тогда 
		СтруктураДанныхДокумента.ПроцентКомиссииБанка = ТекущиеДанные.ПроцентКомиссии;	
	КонецЕсли;	
		
	ОткрытьФорму("Документ.ЭквайринговаяОперация.Форма.ФормаДокумента", СтруктураДанныхДокумента);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСвденияОВозвратеПоСтроке(ТекСтрока)
	
	Сумма 			= 0;
	СуммаКомиссии 	= 0;
	ПроцентКомиссии = 0;
	
	ВидОперации 						= ПредопределенноеЗначение("Перечисление.ВидыОперацийЧекККМ.Возврат");
	СистемаНалогообложенияЧекаККМ 		= ТекСтрока.СистемаНалогообложенияЧекаККМ;
	ПараметрыДоговораПлатежногоАгента 	= ТекСтрока.ПараметрыДоговораПлатежногоАгента;
	СтатьяАналитикиОплаты 				= ТекСтрока.СтатьяАналитикиОплаты;
	ПараметрыДоговораЭквайринга 		= ТекСтрока.ПараметрыДоговораЭквайринга;
	Контрагент 							= ТекСтрока.Контрагент;
	Договор 							= ТекСтрока.Договор;
	ЭквайринговыйТерминал 				= ТекСтрока.ЭквайринговыйТерминал;
	ЭтоРозничныйПокупатель 				= ТекСтрока.ЭтоРозничныйПокупатель;
	ВидПлатежнойКарты 					= ТекСтрока.ВидПлатежнойКарты;
	ПризнакСпособаРасчетаЧекаККМ 		= ТекСтрока.ПризнакСпособаРасчетаЧекаККМ;
	
	ПараметрыОтбора = Новый Структура("ВидОперации, СистемаНалогообложенияЧекаККМ, ПараметрыДоговораПлатежногоАгента,
		|СтатьяАналитикиОплаты, ПараметрыДоговораЭквайринга, Контрагент, Договор,
		|ЭквайринговыйТерминал, ЭтоРозничныйПокупатель, ВидПлатежнойКарты, ПризнакСпособаРасчетаЧекаККМ", 
		ВидОперации, СистемаНалогообложенияЧекаККМ, ПараметрыДоговораПлатежногоАгента,
		СтатьяАналитикиОплаты, ПараметрыДоговораЭквайринга, Контрагент, Договор,
		ЭквайринговыйТерминал, ЭтоРозничныйПокупатель, ВидПлатежнойКарты, ПризнакСпособаРасчетаЧекаККМ); 	
	МассивВозвратов = Объект.ОплатаПлатежнымиКартами.НайтиСтроки(ПараметрыОтбора);
	
	Для каждого ТекОплата Из МассивВозвратов Цикл
		Сумма = Сумма + ТекОплата.Сумма;	
		СуммаКомиссии = СуммаКомиссии + ТекОплата.СуммаКомиссии;	
	КонецЦикла;
	ПроцентКомиссии = ?(Сумма = 0, 0,СуммаКомиссии/(Сумма/100));
	
	Результат = Новый Структура("Сумма, СуммаКомиссии, ПроцентКомиссии");
	Результат.Сумма = Сумма;
	Результат.СуммаКомиссии = СуммаКомиссии;
	Результат.ПроцентКомиссии = ПроцентКомиссии;
	
	Возврат Результат;

КонецФункции

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()

	УчетПоПодразделениям 			= Ложь;
	ВидимостьСведенийОЧеках 		= Ложь;
	ВидимостьКассовойСмены 			= Ложь;
	ВидимостьАктовОбОказанииУслуг 	= ПравоДоступа("Добавление", Метаданные.Документы.АктОбОказанииУслуг); 
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		
		ТипОборудования = Объект.КассаККМ.ТипОборудования; 
		Если ТипОборудования = 0 Тогда 
			ВидимостьКассовойСмены = НЕ Объект.КассаККМ.ИспользоватьБезПодключенияОборудования;
		Иначе
			ПараметрыОбмена = ПолучитьПараметрыОбмена(Объект.КассаККМ);
			Если ПараметрыОбмена.Следующий() Тогда 
				ВидимостьКассовойСмены = ПараметрыОбмена.ЗагружатьКакЧекиККМ;
			КонецЕсли;	
		КонецЕсли;	
		ВидимостьСведенийОЧеках = ВидимостьКассовойСмены;
		
		УчетПоПодразделениям = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "УчетПоПодразделениям");
	КонецЕсли;
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"КассоваяСмена", "Видимость", ВидимостьКассовойСмены);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"КассоваяСменаНомерСменыККТ", "Видимость", ВидимостьКассовойСмены);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НомерСмены", "Видимость", НЕ ВидимостьКассовойСмены);
	
	Если (Объект.ЧекиККМ.Количество()>0)ИЛИ(Объект.ЧекиККМНаВозврат.Количество()>0) Тогда
		ВидимостьСведенийОЧеках = Истина;
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаЧекиККМ", "Видимость", ВидимостьСведенийОЧеках);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаЧекиККМНаПредоплату", "Видимость", ВидимостьСведенийОЧеках);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НадписьОтражениеВУчетеКассы", "Видимость", Объект.ОплатаНаличными.Количество()>0);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НадписьОтражениеВУчетеЭквайринга", "Видимость", Объект.ОплатаПлатежнымиКартами.Количество()>0);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НадписьОтражениеВУчетеАктов", "Видимость",НЕ Объект.СуммаУслугКОтражению=0);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаАктыОбОказанииУслуг", "Видимость", ВидимостьАктовОбОказанииУслуг);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОплатаНаличнымиПодразделение", "Видимость", УчетПоПодразделениям);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОплатаПлатежнымиКартамиПодразделение", "Видимость", УчетПоПодразделениям);
	
КонецПроцедуры

#Область ОбработчикиСобытийПроцессыОбработкиДокументов

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента(Команда)
	ОбщегоНазначенияБГУКлиент.ВыполнитьЗадачу(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение(Контекст, ДополнительныеПараметры) Экспорт
	ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст);
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры, Контекст);
