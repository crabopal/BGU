&НаСервере
Процедура ПроверитьСуммуВыручки()
	
	СуммаВыручки 	= Объект.ПродажиПоСтавкамНДС.Итог("Сумма") + Объект.ПродажиПоСтавкамНДСПредоплата.Итог("Сумма");
	СуммаОплат 		= Объект.ОплатаНаличными.Итог("Сумма") + Объект.ОплатаПлатежнымиКартами.Итог("Сумма");
	Если СуммаВыручки <> СуммаОплат Тогда 
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Сумма выручки не равна сумме расчетов наличными и платежными картами.'"))
	КонецЕсли;	
	
