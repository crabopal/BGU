	ПродажиПоСтавкамНДС 	= Результаты[11].Выгрузить();
	
	ТаблицыДанных = Новый Структура; 
	КолонкиГруппировки 	= "ВидОперации, СистемаНалогообложенияЧекаККМ, ПараметрыДоговораПлатежногоАгента, СтатьяАналитикиОплаты,
						  |Контрагент, Договор, ЭтоРозничныйПокупатель, ПризнакСпособаРасчетаЧекаККМ, Подразделение, ВидРасчетов, ОплатитьДо";
	КолонкиСуммирования = "Сумма";
	ТаблицыДанных.Вставить("ОплатаНаличными", Новый Структура("Таблица, КолонкиГруппировки, КолонкиСуммирования", ОплатаНаличными, КолонкиГруппировки, КолонкиСуммирования));
	
	КолонкиГруппировки 	= "ВидОперации, СистемаНалогообложенияЧекаККМ, ПараметрыДоговораПлатежногоАгента, СтатьяАналитикиОплаты,
						  |ПараметрыДоговораЭквайринга, Контрагент, Договор, ЭквайринговыйТерминал, ЭтоРозничныйПокупатель, ПроцентКомиссии, 
						  |ВидПлатежнойКарты, ПризнакСпособаРасчетаЧекаККМ, Подразделение, ВидРасчетов, ОплатитьДо";
	КолонкиСуммирования = "Сумма, СуммаКомиссии";
	ТаблицыДанных.Вставить("ОплатаПлатежнымиКартами", Новый Структура("Таблица, КолонкиГруппировки, КолонкиСуммирования", ОплатаПлатежнымиКартами, КолонкиГруппировки, КолонкиСуммирования));
	
	КолонкиГруппировки 	= "Номенклатура, Цена,СтавкаНДС, ЭтоРозничныйПокупатель";
	КолонкиСуммирования = "Количество, Сумма, СуммаНДС, Всего";
	ТаблицыДанных.Вставить("ПродажиТовары", Новый Структура("Таблица, КолонкиГруппировки, КолонкиСуммирования", ПродажиТовары, КолонкиГруппировки, КолонкиСуммирования));
	
	КолонкиГруппировки 	= "Номенклатура, Цена,СтавкаНДС, ЭтоРозничныйПокупатель";
	КолонкиСуммирования = "Количество, Сумма, СуммаНДС, Всего";
	ТаблицыДанных.Вставить("ПродажиРаботыУслуги", Новый Структура("Таблица, КолонкиГруппировки, КолонкиСуммирования", ПродажиРаботыУслуги, КолонкиГруппировки, КолонкиСуммирования));
	
	КолонкиГруппировки 	= "Номенклатура, Цена,СтавкаНДС, ЧекККМПродажа, ЭтоРозничныйПокупатель";
	КолонкиСуммирования = "Количество, Сумма, СуммаНДС, Всего";
	ТаблицыДанных.Вставить("ВозвратТовары", Новый Структура("Таблица, КолонкиГруппировки, КолонкиСуммирования", ВозвратТовары, КолонкиГруппировки, КолонкиСуммирования));
	
	КолонкиГруппировки 	= "Номенклатура, Цена,СтавкаНДС, ЧекККМПродажа, ЭтоРозничныйПокупатель";
	КолонкиСуммирования = "Количество, Сумма, СуммаНДС, Всего";
	ТаблицыДанных.Вставить("ОтменаРаботыУслуги", Новый Структура("Таблица, КолонкиГруппировки, КолонкиСуммирования", ОтменаРаботыУслуги, КолонкиГруппировки, КолонкиСуммирования));
	
	Для Каждого СтрокаЗапроса Из ТаблицыДанных Цикл 
		Для Каждого СтрокаТаблицы Из СтрокаЗапроса.Значение.Таблица Цикл 
			НоваяСтрока = Объект[СтрокаЗапроса.Ключ].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы); 
		КонецЦикла;
		ВТ = Объект[СтрокаЗапроса.Ключ].Выгрузить();
		ВТ.Свернуть(СтрокаЗапроса.Значение.КолонкиГруппировки, СтрокаЗапроса.Значение.КолонкиСуммирования);
		Объект[СтрокаЗапроса.Ключ].Загрузить(ВТ); 
	КонецЦикла;	                                             
	 
	Для Каждого СтрокаВыручка Из ПродажиПоСтавкамНДС Цикл 
		СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтрокаВыручка.СтавкаНДС);
		Если (СтрокаВыручка.Сумма - СтрокаВыручка.СуммаЭС) <> 0 Тогда  
			НоваяСтрока = Объект.ПродажиПоСтавкамНДС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВыручка);
			НоваяСтрока.Сумма 		= НоваяСтрока.Сумма - СтрокаВыручка.СуммаЭС;
			НоваяСтрока.СуммаНДС 	= УправлениеНФАКлиентСервер.РассчитатьСуммуНДС(НоваяСтрока.Сумма, СтрокаВыручка.СуммаВключаетНДС, СтавкаНДС); 
		КонецЕсли;
		
		Если СтрокаВыручка.СуммаЭС <> 0 Тогда 
			НоваяСтрока = Объект.ПродажиПоСтавкамНДС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВыручка);
			НоваяСтрока.Сумма 		= СтрокаВыручка.СуммаЭС;
			НоваяСтрока.ТипОплаты 	= Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта;
			НоваяСтрока.СуммаНДС 	= УправлениеНФАКлиентСервер.РассчитатьСуммуНДС(НоваяСтрока.Сумма, СтрокаВыручка.СуммаВключаетНДС, СтавкаНДС);
		КонецЕсли;
	КонецЦикла;	
	ВТПродажиПоСтавкамНДС = Объект.ПродажиПоСтавкамНДС.Выгрузить();
	ВТПродажиПоСтавкамНДС.Свернуть("ТипОплаты, СтавкаНДС, ЭтоРозничныйПокупатель, СтатьяАналитикиОплаты", "СуммаНДС, Сумма");
	Объект.ПродажиПоСтавкамНДС.Загрузить(ВТПродажиПоСтавкамНДС); 
	
	Для Каждого СтрокаЧек Из ЧекиОплатыЭС Цикл 
		Если Объект.ЧекиККМ.НайтиСтроки(Новый Структура("Чек", СтрокаЧек.Ссылка)).Количество() = 0 Тогда  
			НоваяСтрока = Объект.ЧекиККМ.Добавить();
			НоваяСтрока.Чек = СтрокаЧек.Ссылка; 
		КонецЕсли;	
	КонецЦикла;	
	
	Для Каждого СтрокаЧек Из ЧекиВовзратаОплатыЭС Цикл 
		Если Объект.ЧекиККМНаВозврат.НайтиСтроки(Новый Структура("Чек", СтрокаЧек.Ссылка)).Количество() = 0 Тогда  
			НоваяСтрока = Объект.ЧекиККМНаВозврат.Добавить();
			НоваяСтрока.Чек = СтрокаЧек.Ссылка;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыНакладнаяНаРеализациюТорг12(Команда)
	
	СоздатьДокументыНакладнаяНаРеализациюТорг12НаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыНакладнаяНаРеализациюТорг12НаКлиенте()
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Документ не записан. Сначала следует записать документ!'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Основание", Объект.Ссылка);
	ОткрытьФорму("Документ.НакладнаяНаРеализациюТорг12.Форма.ФормаДокумента", ПараметрыФормы);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыНДСКомиссииБанка(ПараметрыДоговора, СуммаКомиссии)
	
	СтавкаНДССКомисииБанка 	= Перечисления.СтавкиНДС.НДС22;
	НДССКомиссииСверху 		= Ложь;
	Если ЗначениеЗаполнено(ПараметрыДоговора) Тогда 
		Если ПараметрыДоговора.ТарифыЗаРасчетноеОбслуживание.Количество() <> 0 Тогда 
			Для Каждого СтрокаТариф Из ПараметрыДоговора.ТарифыЗаРасчетноеОбслуживание Цикл 
				Если СтрокаТариф.ОсновнойВид Тогда 
					СтавкаНДССКомисииБанка 	= СтрокаТариф.СтавкаНДССКомисии; 
					НДССКомиссииСверху 		= СтрокаТариф.НДССКомиссииСверху;
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;
	СтавкаНДСКомиссии 		= УчетНДСКлиентСервер.ПолучитьМножительСтавки(СтавкаНДССКомисииБанка, Истина);
	СуммаНДССКомиссииБанка 	= СуммаКомиссии * СтавкаНДСКомиссии;
	
	ПараметрыНДС = Новый Структура;
	ПараметрыНДС.Вставить("СтавкаНДССКомисииБанка"	, СтавкаНДССКомисииБанка);
	ПараметрыНДС.Вставить("СуммаНДССКомиссииБанка"	, СуммаНДССКомиссииБанка); 
	ПараметрыНДС.Вставить("НДССКомиссииСверху"		, НДССКомиссииСверху);
	
	Возврат ПараметрыНДС;
	
КонецФункции

