		               |	ЧекККМ.Ссылка КАК Чек,
		               |	ЧекККМ.Дата КАК Дата
		               |ИЗ
		               |	Документ.ЧекККМ КАК ЧекККМ
		               |ГДЕ
		               |	ЧекККМ.КассоваяСмена = &КассоваяСмена
		               |	И ЧекККМ.ПометкаУдаления = ЛОЖЬ
		               |	И (ЧекККМ.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПредоплатаЧастичная)
		               |			ИЛИ ЧекККМ.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПредоплатаПолная)
		               |			ИЛИ ЧекККМ.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ОплатаКредита)
		               |			ИЛИ ЧекККМ.УчитыватьТолькоОплату = ИСТИНА)
		               |	И ЧекККМ.СтатусЧекаККМ = &СтатусЧекаККМПробит
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ФискальныеОперации.ДокументОснование,
		               |	ФискальныеОперации.Дата
		               |ИЗ
		               |	РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
		               |ГДЕ
		               |	ФискальныеОперации.ДокументОснование ССЫЛКА Документ.ЧекККМ
		               |	И (ФискальныеОперации.ДокументОснование.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПредоплатаЧастичная)
		               |			ИЛИ ФискальныеОперации.ДокументОснование.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПредоплатаПолная)
		               |			ИЛИ ФискальныеОперации.ДокументОснование.ПризнакСпособаРасчетаЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ОплатаКредита)
		               |			ИЛИ ФискальныеОперации.ДокументОснование.УчитыватьТолькоОплату = ИСТИНА)
		               |	И ФискальныеОперации.ДокументОснование.КассоваяСмена = &КассоваяСмена
		               |	И ФискальныеОперации.ДокументОснование.Проведен = ИСТИНА";
		
		Запрос.УстановитьПараметр("КассоваяСмена", КассоваяСмена);
	КонецЕсли;				   
	
	Запрос.УстановитьПараметр("СтатусЧекаККМПробит", Перечисления.СтатусыЧековККМ.Пробитый);
	
	Результаты = Запрос.Выполнить().Выгрузить();
	
