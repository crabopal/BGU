&НаСервереБезКонтекста
Функция СписокОчередныхПлатежейПоГрафику(Организация, Договор, Отбор, СтатьяАналитикиОплаты)
	
	Отбор.Вставить("КФО"				, СтатьяАналитикиОплаты.КФО);
	Отбор.Вставить("КодЦели"			, СтатьяАналитикиОплаты.КодЦели);
	Отбор.Вставить("КодМероприятия"		, СтатьяАналитикиОплаты.КодМероприятия);
	Отбор.Вставить("ДопКлассификация"	, СтатьяАналитикиОплаты.ДопКлассификация);
	Отбор.Вставить("ИФО"				, СтатьяАналитикиОплаты.ИФО);
	Отбор.Вставить("КПС"				, СтатьяАналитикиОплаты.КПС);
	Отбор.Вставить("КЭК"				, СтатьяАналитикиОплаты.КЭК);
	
	Возврат КонтрольИсполненияДоговоров.СписокОчередныхПлатежейПоГрафику(Организация, Договор, Отбор);
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьЭлементовГрафикПлатежей()
	
	ВидимостьЭлементовГрафикаПлатежей = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	
	ЭлементыГрафикПлатежей = Новый Массив;
	ЭлементыГрафикПлатежей.Добавить("ОплатаНаличнымиГрафикПлатежей");
	ЭлементыГрафикПлатежей.Добавить("ОплатаПлатежнымиКартамиГрафикПлатежей");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГрафикПлатежей, "Видимость", ВидимостьЭлементовГрафикаПлатежей);
			
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОплатаНаличнымиОплатитьДо");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОплатаНаличными.ОплатитьДо", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<авто>");
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОплатаПлатежнымиКартамиОплатитьДо");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОплатаПлатежнымиКартами.ОплатитьДо", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<авто>");
	
КонецПроцедуры	

&НаСервере
Процедура ДополнитьДаннымиОплатыЭС(КассоваяСмена)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЧекККМ.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЧекККМ КАК ЧекККМ
	               |ГДЕ
	               |	ЧекККМ.КассоваяСмена = &КассоваяСмена
	               |	И ЧекККМ.ПометкаУдаления = ЛОЖЬ
	               |	И ЧекККМ.СтатусЧекаККМ = &СтатусЧекаККМПробит
	               |	И ЧекККМ.ИдентификаторКорзины <> """"
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ФискальныеОперации.ДокументОснование
	               |ИЗ
	               |	РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	               |ГДЕ
	               |	ФискальныеОперации.ДокументОснование ССЫЛКА Документ.ЧекККМ
	               |	И ФискальныеОперации.ДокументОснование.КассоваяСмена = &КассоваяСмена
	               |	И ФискальныеОперации.ДокументОснование.Проведен = ИСТИНА
	               |	И ФискальныеОперации.ДокументОснование.ИдентификаторКорзины <> """"";
	
	Запрос.УстановитьПараметр("КассоваяСмена"		, КассоваяСмена);
	Запрос.УстановитьПараметр("СтатусЧекаККМПробит"	, Перечисления.СтатусыЧековККМ.Пробитый);
	ЧекиОплатыЭС = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЧекККМНаВозврат.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЧекККМНаВозврат КАК ЧекККМНаВозврат
	               |ГДЕ
	               |	ЧекККМНаВозврат.КассоваяСмена = &КассоваяСмена
	               |	И ЧекККМНаВозврат.ПометкаУдаления = ЛОЖЬ
	               |	И ЧекККМНаВозврат.СтатусЧекаККМ = &СтатусЧекаККМПробит
	               |	И ЧекККМНаВозврат.ИдентификаторКорзины <> """"
	               |	И ЧекККМНаВозврат.ВовзратВТекущуюСмену = ИСТИНА
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ФискальныеОперации.ДокументОснование
	               |ИЗ
	               |	РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	               |ГДЕ
	               |	ФискальныеОперации.ДокументОснование ССЫЛКА Документ.ЧекККМНаВозврат
	               |	И ФискальныеОперации.ДокументОснование.КассоваяСмена = &КассоваяСмена
	               |	И ФискальныеОперации.ДокументОснование.Проведен = ИСТИНА
	               |	И ФискальныеОперации.ДокументОснование.ИдентификаторКорзины <> """"
	               |	И ФискальныеОперации.ДокументОснование.ВовзратВТекущуюСмену = ИСТИНА";
	Запрос.УстановитьПараметр("КассоваяСмена"		, КассоваяСмена);  
	Запрос.УстановитьПараметр("СтатусЧекаККМПробит"	, Перечисления.СтатусыЧековККМ.Пробитый);
    ЧекиВовзратаОплатыЭС = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Запрос = Новый Запрос;  
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа) КАК ВидОперации,
	               |	ЧекККМРасшифровкаОплаты.Ссылка.СистемаНалогообложенияЧекаККМ КАК СистемаНалогообложенияЧекаККМ,
	               |	ЧекККМРасшифровкаОплаты.Ссылка.ПараметрыДоговораПлатежногоАгента КАК ПараметрыДоговораПлатежногоАгента,
	               |	ВЫБОР
	               |		КОГДА ЧекККМРасшифровкаОплаты.Ссылка.ЭтоРозничныйПокупатель
	               |			ТОГДА &КонтрагентДляРозничныхПродаж
	               |		ИНАЧЕ ЧекККМРасшифровкаОплаты.Ссылка.Контрагент
	               |	КОНЕЦ КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА ЧекККМРасшифровкаОплаты.Ссылка.ЭтоРозничныйПокупатель
	               |			ТОГДА &ДоговорДляРозничныхПродаж
	               |		ИНАЧЕ ЧекККМРасшифровкаОплаты.Ссылка.Договор
	               |	КОНЕЦ КАК Договор,
	               |	ЧекККМРасшифровкаОплаты.СтатьяАналитикиОплаты КАК СтатьяАналитикиОплаты,
	               |	ЧекККМРасшифровкаОплаты.Сумма КАК Сумма,
	               |	ЧекККМРасшифровкаОплаты.Ссылка.ЭтоРозничныйПокупатель КАК ЭтоРозничныйПокупатель,
	               |	ЧекККМРасшифровкаОплаты.Ссылка.ПризнакСпособаРасчетаЧекаККМ КАК ПризнакСпособаРасчетаЧекаККМ,
	               |	ВЫБОР
	               |		КОГДА &УчетПоПодразделениям
	               |			ТОГДА ЧекККМРасшифровкаОплаты.Ссылка.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ КАК Подразделение
	               |ПОМЕСТИТЬ ДанныеЧековОплатаНаличными
	               |ИЗ
	               |	Документ.ЧекККМ.РасшифровкаОплаты КАК ЧекККМРасшифровкаОплаты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ.Оплата КАК ЧекККМОплата
	               |		ПО ЧекККМРасшифровкаОплаты.КлючСвязиОплаты = ЧекККМОплата.КлючСвязиОплаты
	               |			И ЧекККМРасшифровкаОплаты.Ссылка = ЧекККМОплата.Ссылка
	               |ГДЕ
