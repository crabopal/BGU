Функция ДанныеПоСтатьямАналитикиОплатыОтчетаПоКассовойСмене(ОтчетПоКассовойСмене, СписокСчетовОтбора, Подразделение)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ОтчетПоКассовойСменеОплатаНаличными.Ссылка КАК Ссылка,
	               |	ОтчетПоКассовойСменеОплатаНаличными.НомерСтроки КАК НомерСтроки,
	               |	ОтчетПоКассовойСменеОплатаНаличными.ВидОперации КАК ВидОперации,
	               |	ОтчетПоКассовойСменеОплатаНаличными.СистемаНалогообложенияЧекаККМ КАК СистемаНалогообложенияЧекаККМ,
	               |	ОтчетПоКассовойСменеОплатаНаличными.ПараметрыДоговораПлатежногоАгента КАК ПараметрыДоговораПлатежногоАгента,
	               |	ОтчетПоКассовойСменеОплатаНаличными.СтатьяАналитикиОплаты КАК СтатьяАналитикиОплаты,
	               |	ОтчетПоКассовойСменеОплатаНаличными.Сумма КАК Сумма,
	               |	ОтчетПоКассовойСменеОплатаНаличными.Контрагент КАК Контрагент,
	               |	ОтчетПоКассовойСменеОплатаНаличными.Договор КАК Договор,
	               |	ОтчетПоКассовойСменеОплатаНаличными.ЭтоРозничныйПокупатель КАК ЭтоРозничныйПокупатель,
	               |	ОтчетПоКассовойСменеОплатаНаличными.Подразделение КАК Подразделение
	               |ИЗ
	               |	Документ.ОтчетПоКассовойСмене.ОплатаНаличными КАК ОтчетПоКассовойСменеОплатаНаличными
	               |ГДЕ
	               |	ОтчетПоКассовойСменеОплатаНаличными.Ссылка = &ОтчетПоКассовойСмене
	               |	И ОтчетПоКассовойСменеОплатаНаличными.СтатьяАналитикиОплаты.СчетУчета В(&СчетаУчета)
	               |	И ОтчетПоКассовойСменеОплатаНаличными.Подразделение = &Подразделение";
	
	Запрос.УстановитьПараметр("ОтчетПоКассовойСмене", ОтчетПоКассовойСмене);
	Запрос.УстановитьПараметр("СчетаУчета", СписокСчетовОтбора);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Результат = Запрос.Выполнить().Выгрузить();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;

КонецФункции	

Процедура ВводНаОсновании_ЗаполнитьДокумент(ЗаполняемыйДокумент, ДанныеЗаполнения, УточненныеДанныеЗаполнения = Неопределено) Экспорт
	
	ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ВалютаРегламентированногоУчета = ВалютаРубли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СУММА(ЕСТЬNULL(ОтчетПоКассовойСменеПродажиПлатежногоАгента.Сумма, 0)) КАК СуммаПродажПлатежногоАгента,
	               |	ОтчетПоКассовойСменеПродажиПлатежногоАгента.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ПродажиПА
	               |ИЗ
	               |	Документ.ОтчетПоКассовойСмене.ПродажиПлатежногоАгента КАК ОтчетПоКассовойСменеПродажиПлатежногоАгента
	               |ГДЕ
	               |	ОтчетПоКассовойСменеПродажиПлатежногоАгента.Ссылка = &ДокументОснование
	               |	И ОтчетПоКассовойСменеПродажиПлатежногоАгента.ТипОплаты = ЗНАЧЕНИЕ(Перечисление.ТипыОплатЧекаККМ.Наличные)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОтчетПоКассовойСменеПродажиПлатежногоАгента.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ОтчетПоКассовойСмене.Дата КАК Дата,
	               |	ОтчетПоКассовойСмене.Организация КАК Организация,
	               |	ОтчетПоКассовойСмене.СуммаДокумента - ПродажиПА.СуммаПродажПлатежногоАгента КАК СуммаДокумента,
	               |	&ВалютаРегламентированногоУчета КАК ВалютаДокумента,
	               |	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(ОтчетПоКассовойСмене.КассирОперационист КАК Справочник.Сотрудники).Контрагент) КАК ПринятоОт,
	               |	ВЫРАЗИТЬ(ОтчетПоКассовойСмене.КассирОперационист КАК Справочник.Сотрудники).Контрагент КАК Контрагент,
	               |	ИСТИНА КАК Оплачено,
	               |	ОтчетПоКассовойСмене.Ссылка КАК ДокументОснование
	               |ИЗ
	               |	Документ.ОтчетПоКассовойСмене КАК ОтчетПоКассовойСмене
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПродажиПА КАК ПродажиПА
	               |		ПО ОтчетПоКассовойСмене.Ссылка = ПродажиПА.Ссылка
	               |ГДЕ
	               |	ОтчетПоКассовойСмене.Ссылка = &ДокументОснование";
	Запрос.УстановитьПараметр("ДокументОснование", ДанныеЗаполнения);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", ВалютаРегламентированногоУчета);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(ЗаполняемыйДокумент, Выборка);
	
	ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, НаименованиеПолное, Фамилия, Имя, Отчество, ПолучитьОтКого", Выборка.Контрагент); 
	Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
	Если ЗначениеЗаполнено(ДанныеКонтрагента.ПолучитьОтКого) Тогда
		ПринятоОт = ДанныеКонтрагента.ПолучитьОтКого;
	ИначеЕсли ЗначениеЗаполнено(ДанныеКонтрагента.Фамилия) или
		ЗначениеЗаполнено(ДанныеКонтрагента.Имя) или
		ЗначениеЗаполнено(ДанныеКонтрагента.Отчество) Тогда
		ПринятоОт = "" + ДанныеКонтрагента.Фамилия+" "+ДанныеКонтрагента.Имя+" "+ДанныеКонтрагента.Отчество;
	Иначе
		ПринятоОт = ДанныеКонтрагента.НаименованиеПолное;
	КонецЕсли;
	ЗаполняемыйДокумент.ПринятоОт = ПринятоОт;
	ЗаполняемыйДокумент.ПоступлениеВыручкиТорговойТочки = Истина;
	
	// Продолжаем заполнение нового документа
	
	Если ТипЗнч(ЗаполняемыйДокумент.Ссылка) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		Счет20531 = БухгалтерскийУчет.СчетПоКоду("205.31");
		ЗаполняемыйДокумент["Счет"]	= БухгалтерскийУчет.СчетПоКоду("201.34");
		Если УточненныеДанныеЗаполнения = Неопределено Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Для ввода приходных ордеров рекомендуется использовать помощник ввода новых ПКО по кнопке ""Создать приходный кассовый ордер"" на закладке ""Расчет наличными""!'");
			Сообщение.Сообщить();
			
			ЗаполняемыйДокумент["КорСчет"] = Счет20531;
		Иначе
			ЗаполняемыйДокумент["КорСчет"] = УточненныеДанныеЗаполнения.СчетУчета;
			ЗаполняемыйДокумент["ИФО"] = УточненныеДанныеЗаполнения.ИФО;
			ЗаполняемыйДокумент["Подразделение"] = УточненныеДанныеЗаполнения.Подразделение;
		КонецЕсли;
		ЗаполняемыйДокумент["ПоступлениеВыручкиТорговойТочки"] = Истина;
		
		//Заполнение расшифровки
		СписокСчетовОтбора = Новый Массив;
		Если ЗаполняемыйДокумент["КорСчет"] = Счет20531 Тогда
			СписокСчетовОтбора.Добавить(Счет20531);
			СписокСчетовОтбора.Добавить(ПланыСчетов.ЕПСБУ.ПустаяСсылка());
		Иначе
			СписокСчетовОтбора.Добавить(ЗаполняемыйДокумент["КорСчет"]);
		КонецЕсли;	
		
		ДанныеПоСтатьямАналитикиОплаты = ДанныеПоСтатьямАналитикиОплатыОтчетаПоКассовойСмене(ДанныеЗаполнения, СписокСчетовОтбора, ЗаполняемыйДокумент["Подразделение"]);
		СуммаНаличнымиПоСтатьямАналитикиОплаты = ДанныеПоСтатьямАналитикиОплаты.Итог("Сумма");
		СуммаНаличными = ДанныеПоСтатьямАналитикиОплаты.Итог("Сумма");
		Если УточненныеДанныеЗаполнения = Неопределено Тогда
			ЗаполняемыйДокумент["СуммаДокумента"] = СуммаНаличными;
		Иначе
			ЗаполняемыйДокумент["СуммаДокумента"] = УточненныеДанныеЗаполнения.Сумма;
		КонецЕсли;	
		
		СуммаРазницы = СуммаНаличными - СуммаНаличнымиПоСтатьямАналитикиОплаты;
		Если СуммаРазницы <> 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Сумма документа ""Отчет по кассовой смене"" не равна сумме наличных расчетов по контрагентам!'");
			Сообщение.Сообщить();
		КонецЕсли;	
		
		ДанныеПоСтатьямАналитикиОплаты.Свернуть("СтатьяАналитикиОплаты", "Сумма");
		
		ДанныеПоБюджетнойКлассификации = ЗаполняемыйДокумент.РасшифровкаПлатежа.Выгрузить();
		ДанныеПоБюджетнойКлассификации.Очистить();
		Для каждого ТекСтрока Из ДанныеПоСтатьямАналитикиОплаты Цикл
			СтатьяАналитикиОплаты = ТекСтрока.СтатьяАналитикиОплаты;
			Если ЗначениеЗаполнено(СтатьяАналитикиОплаты) Тогда
				НоваяСтрока = ДанныеПоБюджетнойКлассификации.Добавить();
				НоваяСтрока.Сумма = ТекСтрока.Сумма;
				НоваяСтрока.КФО = СтатьяАналитикиОплаты.КФО;
				НоваяСтрока.КПС = СтатьяАналитикиОплаты.КПС;
				НоваяСтрока.КЭК = СтатьяАналитикиОплаты.КЭК;
				НоваяСтрока.КодЦели = СтатьяАналитикиОплаты.КодЦели;
				НоваяСтрока.КодМероприятия = СтатьяАналитикиОплаты.КодМероприятия;
				НоваяСтрока.ДопКлассификация = СтатьяАналитикиОплаты.ДопКлассификация;
			КонецЕсли;	
		КонецЦикла;
		
		ДанныеПоБюджетнойКлассификации.Свернуть("КФО, КПС, КЭК, КодЦели, КодМероприятия, ДопКлассификация", "Сумма");
		ЗаполняемыйДокумент["РасшифровкаПлатежа"].Загрузить(ДанныеПоБюджетнойКлассификации);
		
		КассирОперационист = ДанныеЗаполнения["КассирОперационист"];
		Контрагент = КассирОперационист.Контрагент;
		
		ЗаполняемыйДокумент["Контрагент"] = Контрагент;
		
		ЗаполняемыйДокумент["ДокументОснование"] = ДанныеЗаполнения;
		
		ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, НаименованиеПолное, Фамилия, Имя, Отчество, ПолучитьОтКого", Контрагент); 
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
		Если ЗначениеЗаполнено(ДанныеКонтрагента.ПолучитьОтКого) Тогда
			ПринятоОт = ДанныеКонтрагента.ПолучитьОтКого;
		ИначеЕсли ЗначениеЗаполнено(ДанныеКонтрагента.Фамилия) или
			ЗначениеЗаполнено(ДанныеКонтрагента.Имя) или
			ЗначениеЗаполнено(ДанныеКонтрагента.Отчество) Тогда
	    	ПринятоОт = "" + ДанныеКонтрагента.Фамилия+" "+ДанныеКонтрагента.Имя+" "+ДанныеКонтрагента.Отчество;
		Иначе
			ПринятоОт = ДанныеКонтрагента.НаименованиеПолное;
		КонецЕсли;
		ЗаполняемыйДокумент["ПринятоОт"] = ПринятоОт;
		
		СтавкаДокумента = ПодключаемоеоборудованиеБГУ.ЕдиныеСтавкиВДокументеОтчетПоКассовойСмене(ДанныеЗаполнения, СписокСчетовОтбора);
		Если СтавкаДокумента.ЕдинаяДляТЧ Тогда
			ЗаполняемыйДокумент["СтавкаНДС"] = СтавкаДокумента.Значение;
			ЗаполняемыйДокумент["СуммаНДС"] = СтавкаДокумента.СуммаНДС;
		Иначе
			ЗаполняемыйДокумент["СтавкаНДС"] = Перечисления.СтавкиНДС.ПустаяСсылка();
			ЗаполняемыйДокумент["СуммаНДС"] = СтавкаДокумента.СуммаНДС;
		КонецЕсли;	
		
	КонецЕсли;

КонецПроцедуры

Процедура ИнициализироватьЗапросыОплатаПоДоговорамПлатежногоАгента(Запрос, НомераТаблиц)

	НомераТаблиц.Вставить("ОплатаПоДоговорамПлатежногоАгента", НомераТаблиц.Количество()+2);
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОтчетПоКассовойСменеПродажиПлатежногоАгента.Ссылка.Дата КАК Период,
	|	ОтчетПоКассовойСменеПродажиПлатежногоАгента.Ссылка.Организация КАК Организация,
	|	ОтчетПоКассовойСменеПродажиПлатежногоАгента.ПараметрыДоговораПлатежногоАгента КАК ПараметрыДоговораПлатежногоАгента,
	|	ВЫРАЗИТЬ(ОтчетПоКассовойСменеПродажиПлатежногоАгента.ПараметрыДоговораПлатежногоАгента КАК Справочник.ПараметрыДоговораПлатежногоАгента).ПоставщикУслуг КАК ПоставщикУслуг,
	|	ОтчетПоКассовойСменеПродажиПлатежногоАгента.ТипОплаты КАК ТипОплаты,
	|	ОтчетПоКассовойСменеПродажиПлатежногоАгента.Сумма КАК Сумма,
	|	ОтчетПоКассовойСменеПродажиПлатежногоАгента.СуммаВознаграждения КАК СуммаВознаграждения,
	|	ОтчетПоКассовойСменеПродажиПлатежногоАгента.СуммаКомиссии КАК СуммаКомиссии
	|ИЗ
	|	Документ.ОтчетПоКассовойСмене.ПродажиПлатежногоАгента КАК ОтчетПоКассовойСменеПродажиПлатежногоАгента
	|ГДЕ
	|	ОтчетПоКассовойСменеПродажиПлатежногоАгента.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОтчетПоКассовойСменеПродажиПлатежногоАгента.НомерСтроки";
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоОстаткамТоваров(Запрос, НомераТаблиц)

	НомераТаблиц.Вставить("ТоварыВТорговыхТочках", НомераТаблиц.Количество()+2);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Дата КАК Период,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка КАК Регистратор,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Организация КАК Организация,
	|	ВЫРАЗИТЬ(ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.КассаККМ КАК Справочник.ФискальныеРегистраторы).ЦМО КАК ЦМО,
	|	ВЫРАЗИТЬ(ИзмененияОстатковТоваровВТорговойТочкеТовары.Номенклатура КАК Справочник.Прейскурант).Номенклатура КАК Номенклатура,
	|	СУММА(ИзмененияОстатковТоваровВТорговойТочкеТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ ДвиженияТоваров
	|ИЗ
	|	Документ.ОтчетПоКассовойСмене.ПродажиТовары КАК ИзмененияОстатковТоваровВТорговойТочкеТовары
	|ГДЕ
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка = &Ссылка
	|	И ВЫРАЗИТЬ(ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.КассаККМ КАК Справочник.ФискальныеРегистраторы).ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки = ИСТИНА
	|	И ИСТИНА = &НеЗаполненСписокЧековККМ
	|
	|СГРУППИРОВАТЬ ПО
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка,
	|	ВЫРАЗИТЬ(ИзмененияОстатковТоваровВТорговойТочкеТовары.Номенклатура КАК Справочник.Прейскурант).Номенклатура,
	|	ВЫРАЗИТЬ(ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.КассаККМ КАК Справочник.ФискальныеРегистраторы).ЦМО,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Организация,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Дата
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОтчетПоКассовойСменеВозвратТовары.Ссылка.Дата,
	|	ОтчетПоКассовойСменеВозвратТовары.Ссылка,
	|	ОтчетПоКассовойСменеВозвратТовары.Ссылка.Организация,
	|	ВЫРАЗИТЬ(ОтчетПоКассовойСменеВозвратТовары.Ссылка.КассаККМ КАК Справочник.ФискальныеРегистраторы).ЦМО,
	|	ВЫРАЗИТЬ(ОтчетПоКассовойСменеВозвратТовары.Номенклатура КАК Справочник.Прейскурант).Номенклатура,
	|	СУММА(-ОтчетПоКассовойСменеВозвратТовары.Количество)
	|ИЗ
	|	Документ.ОтчетПоКассовойСмене.ВозвратТовары КАК ОтчетПоКассовойСменеВозвратТовары
	|ГДЕ
	|	ОтчетПоКассовойСменеВозвратТовары.Ссылка = &Ссылка
	|	И ВЫРАЗИТЬ(ОтчетПоКассовойСменеВозвратТовары.Ссылка.КассаККМ КАК Справочник.ФискальныеРегистраторы).ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки = ИСТИНА
	|	И ИСТИНА = &НеЗаполненСписокЧековККМ
	|
	|СГРУППИРОВАТЬ ПО
	|	ОтчетПоКассовойСменеВозвратТовары.Ссылка,
	|	ВЫРАЗИТЬ(ОтчетПоКассовойСменеВозвратТовары.Номенклатура КАК Справочник.Прейскурант).Номенклатура,
	|	ВЫРАЗИТЬ(ОтчетПоКассовойСменеВозвратТовары.Ссылка.КассаККМ КАК Справочник.ФискальныеРегистраторы).ЦМО,
	|	ОтчетПоКассовойСменеВозвратТовары.Ссылка.Организация,
	|	ОтчетПоКассовойСменеВозвратТовары.Ссылка.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДвиженияТоваров.Период КАК Период,
	|	ДвиженияТоваров.Регистратор КАК Регистратор,
	|	ДвиженияТоваров.Организация КАК Организация,
	|	ДвиженияТоваров.ЦМО КАК ЦМО,
	|	ДвиженияТоваров.Номенклатура КАК Номенклатура,
	|	СУММА(ДвиженияТоваров.Количество) КАК Количество
	|ПОМЕСТИТЬ ДвиженияТоваровСвернуты
	|ИЗ
	|	ДвиженияТоваров КАК ДвиженияТоваров
	|
	|СГРУППИРОВАТЬ ПО
	|	ДвиженияТоваров.Период,
	|	ДвиженияТоваров.ЦМО,
	|	ДвиженияТоваров.Номенклатура,
	|	ДвиженияТоваров.Организация,
	|	ДвиженияТоваров.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ДвиженияТоваровСвернуты.Период КАК Период,
	|	ДвиженияТоваровСвернуты.Регистратор КАК Регистратор,
	|	ДвиженияТоваровСвернуты.Организация КАК Организация,
	|	ДвиженияТоваровСвернуты.ЦМО КАК ЦМО,
	|	ДвиженияТоваровСвернуты.Номенклатура КАК Номенклатура,
	|	ДвиженияТоваровСвернуты.Количество КАК Количество
	|ИЗ
	|	ДвиженияТоваровСвернуты КАК ДвиженияТоваровСвернуты";
	
КонецПроцедуры

Функция ЗапросНоменклатураАктовОбОказанииУслуг(ОтчетПоКассовойСмене) Экспорт 
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЧекККМ.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТЧеки
	               |ИЗ
	               |	Документ.ЧекККМ КАК ЧекККМ
	               |ГДЕ
	               |	НЕ ЧекККМ.Ссылка В
	               |				(ВЫБРАТЬ
	               |					ЧекККМДокументыОснования.Ссылка КАК Ссылка
	               |				ИЗ
	               |					Документ.ЧекККМ.ДокументыОснования КАК ЧекККМДокументыОснования
	               |				ГДЕ
	               |					ЧекККМДокументыОснования.Ссылка В (&СписокЧеков)
	               |					И ЧекККМДокументыОснования.ДокументОснованиеЧекаККМ ССЫЛКА Документ.АктОбОказанииУслуг)
	               |	И ЧекККМ.Ссылка В(&СписокЧеков)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЧекККМТоварыРаботыУслуги.Номенклатура.Номенклатура КАК Номенклатура,
	               |	ЧекККМТоварыРаботыУслуги.Количество КАК Количество,
	               |	ЧекККМТоварыРаботыУслуги.Цена КАК Цена,
	               |	ЧекККМТоварыРаботыУслуги.Сумма КАК Сумма,
	               |	ЧекККМТоварыРаботыУслуги.СтавкаНДС КАК СтавкаНДС,
	               |	ЧекККМТоварыРаботыУслуги.СуммаНДС КАК СуммаНДС,
	               |	ЧекККМТоварыРаботыУслуги.Всего КАК Всего,
	               |	ЧекККМТоварыРаботыУслуги.Номенклатура.ОсновнаяСтатьяАналитикиОплаты КАК СтатьяАналитики,
	               |	ЧекККМТоварыРаботыУслуги.Ссылка.Контрагент КАК Контрагент,
	               |	ЧекККМТоварыРаботыУслуги.Ссылка.Договор КАК Договор,
	               |	ЧекККМТоварыРаботыУслуги.Номенклатура.АгентскаяУслуга КАК КомиссионнаяТорговля,
	               |	ЧекККМТоварыРаботыУслуги.Ссылка.Подразделение КАК Подразделение
	               |ПОМЕСТИТЬ ВТНоменклатура
	               |ИЗ
	               |	ВТЧеки КАК ВТЧеки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ.ТоварыРаботыУслуги КАК ЧекККМТоварыРаботыУслуги
	               |		ПО ВТЧеки.Ссылка = ЧекККМТоварыРаботыУслуги.Ссылка
	               |ГДЕ
	               |	ЧекККМТоварыРаботыУслуги.Номенклатура.Номенклатура.ТипНоменклатуры В(&ТипНоменклатурыУслуга)
	               |	И ЧекККМТоварыРаботыУслуги.Номенклатура.НеУчитыватьПриФормированииАктаОбОказанииУслуг = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.Номенклатура.Номенклатура,
	               |	-ЧекККМНаВозвратТоварыРаботыУслуги.Количество,
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.Цена,
	               |	-ЧекККМНаВозвратТоварыРаботыУслуги.Сумма,
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.СтавкаНДС,
	               |	-ЧекККМНаВозвратТоварыРаботыУслуги.СуммаНДС,
	               |	-ЧекККМНаВозвратТоварыРаботыУслуги.Всего,
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.Номенклатура.ОсновнаяСтатьяАналитикиОплаты,
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.Ссылка.Контрагент,
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.Ссылка.Договор,
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.Номенклатура.АгентскаяУслуга,
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.Ссылка.Подразделение
	               |ИЗ
	               |	ВТЧеки КАК ВТЧеки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМНаВозврат.ТоварыРаботыУслуги КАК ЧекККМНаВозвратТоварыРаботыУслуги
	               |		ПО ВТЧеки.Ссылка = ЧекККМНаВозвратТоварыРаботыУслуги.Ссылка.ЧекККМПродажа
	               |ГДЕ
	               |	ЧекККМНаВозвратТоварыРаботыУслуги.Номенклатура.Номенклатура.ТипНоменклатуры В(&ТипНоменклатурыУслуга)
	               |	И ЧекККМНаВозвратТоварыРаботыУслуги.Номенклатура.НеУчитыватьПриФормированииАктаОбОказанииУслуг = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТНоменклатура.Контрагент КАК Контрагент,
	               |	ВТНоменклатура.Договор КАК Договор,
	               |	ВТНоменклатура.СтатьяАналитики КАК СтатьяАналитики,
	               |	ВТНоменклатура.КомиссионнаяТорговля КАК КомиссионнаяТорговля,
	               |	СУММА(ВТНоменклатура.Всего) КАК Всего,
	               |	ВЫБОР
	               |		КОГДА &УчетПоПодразделениям
	               |			ТОГДА ВТНоменклатура.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ КАК Подразделение
	               |ИЗ
	               |	ВТНоменклатура КАК ВТНоменклатура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТНоменклатура.Контрагент,
	               |	ВТНоменклатура.Договор,
	               |	ВТНоменклатура.КомиссионнаяТорговля,
	               |	ВТНоменклатура.СтатьяАналитики,
	               |	ВЫБОР
	               |		КОГДА &УчетПоПодразделениям
	               |			ТОГДА ВТНоменклатура.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КомиссионнаяТорговля
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТНоменклатура.Номенклатура КАК Номенклатура,
	               |	СУММА(ВТНоменклатура.Количество) КАК Количество,
	               |	ВТНоменклатура.Цена КАК Цена,
	               |	СУММА(ВТНоменклатура.Сумма) КАК Сумма,
	               |	ВТНоменклатура.СтавкаНДС КАК СтавкаНДС,
	               |	СУММА(ВТНоменклатура.СуммаНДС) КАК СуммаНДС,
	               |	СУММА(ВТНоменклатура.Всего) КАК Всего,
	               |	ВТНоменклатура.СтатьяАналитики КАК СтатьяАналитики,
	               |	ВТНоменклатура.Контрагент КАК Контрагент,
	               |	ВТНоменклатура.КомиссионнаяТорговля КАК КомиссионнаяТорговля,
	               |	ВТНоменклатура.Договор КАК Договор,
	               |	ВЫБОР
	               |		КОГДА &УчетПоПодразделениям
	               |			ТОГДА ВТНоменклатура.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ КАК Подразделение
	               |ИЗ
	               |	ВТНоменклатура КАК ВТНоменклатура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТНоменклатура.Номенклатура,
	               |	ВТНоменклатура.Цена,
	               |	ВТНоменклатура.СтавкаНДС,
	               |	ВТНоменклатура.СтатьяАналитики,
	               |	ВТНоменклатура.Контрагент,
	               |	ВТНоменклатура.КомиссионнаяТорговля,
	               |	ВТНоменклатура.Договор,
	               |	ВЫБОР
	               |		КОГДА &УчетПоПодразделениям
	               |			ТОГДА ВТНоменклатура.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(ВТНоменклатура.Количество) <> 0";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СписокЧеков"				, ОтчетПоКассовойСмене.ЧекиККМ.Выгрузить(,"Чек"));
	Запрос.УстановитьПараметр("ТипНоменклатурыУслуга"	, РозничныеПродажиБГУ.ТипыУслугРабот());
	Запрос.УстановитьПараметр("УчетПоПодразделениям"	, ОтчетПоКассовойСмене.КассаККМ.УчетПоПодразделениям);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет(); 
	
	Возврат(РезультатЗапроса);
	
КонецФункции

#КонецОбласти

#КонецЕсли
