Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ВедомостьНаВыдачуОС_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															 "ВедомостьНаВыдачуОС_103н",
															 "Ведомость на выдачу ОС, ред. 103н",
															 ПечатьВедомостиНаВыдачу(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ВедомостьВыдачиНФА_0504210_103н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ВедомостьНаВыдачуОС_52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															 "ВедомостьНаВыдачуОС_52н",
															 "Ведомость на выдачу ОС, ред. 52н",
															 ПечатьВедомостиНаВыдачу(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ВедомостьВыдачиНФА_0504210_52н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ВедомостьНаВыдачуОС") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															 "ВедомостьНаВыдачуОС",
															 "Ведомость на выдачу ОС",
															 ПечатьВедомостиНаВыдачу(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ВедомостьВыдачиНФА_0504210"));
		
	КонецЕсли;

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СправкаОСодержанииДрагМатериаловДляВнутреннегоПеремещения") Тогда
		
		ТабличныйДокумент = УчетДрагМатериалов.ПечатьСправкиОСодержанииДрагМатериаловДляВнутреннегоПеремещения(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"СправкаОСодержанииДрагМатериаловДляВнутреннегоПеремещения","Справка о содержании драг. материалов", ТабличныйДокумент);

	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьВедомостиНаВыдачу(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивОбъектов"	, МассивОбъектов);
	Запрос.УстановитьПараметр("ЕдИзмШт"			, Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУ.Регистратор КАК Документ.ВедомостьНаВыдачуОСНаНуждыУчреждения) КАК Регистратор,
	|	ЖурналПроводокЕПСБУ.Сумма КАК Сумма,
	|	ЖурналПроводокЕПСБУ.СчетДт КАК СчетДт,
	|	ЖурналПроводокЕПСБУ.КПСДт КАК КПСДт,
	|	ЖурналПроводокЕПСБУ.КЭКДт КАК КЭКДт,
	|	ЖурналПроводокЕПСБУ.СчетКт КАК СчетКт,
	|	ЖурналПроводокЕПСБУ.КПСКт КАК КПСКт,
	|	ЖурналПроводокЕПСБУ.КЭККт КАК КЭККт,
	|	ЖурналПроводокЕПСБУ.КФО КАК КФО
	|ПОМЕСТИТЬ Движения
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.Регистратор В(&МассивОбъектов)
	|	И (ЖурналПроводокЕПСБУ.СчетДт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|			ИЛИ ЖурналПроводокЕПСБУ.СчетКт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский))";
	Запрос.Выполнить();
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ШапкаДокумента.Ссылка КАК Ссылка,
	|	ШапкаДокумента.Дата КАК Дата,
	|	ШапкаДокумента.Номер КАК Номер,
	|	ШапкаДокумента.Организация КАК Организация,
	|	ШапкаДокумента.Организация.НаименованиеПолное КАК ОрганизацияНаименование,
	|	ШапкаДокумента.Организация.КодОКПО КАК ОрганизацияКодОКПО,
	|	ШапкаДокумента.Подразделение.Наименование КАК ПодразделениеНаименование,
	|	ШапкаДокумента.ЦМО.Сотрудник КАК МОЛ,
	|	ШапкаДокумента.Подразделение КАК Подразделение,
	|	ШапкаДокумента.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель
	|ИЗ
	|	Документ.ВедомостьНаВыдачуОСНаНуждыУчреждения КАК ШапкаДокумента
	|ГДЕ
	|	ШапкаДокумента.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Движения.Регистратор КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(Движения.СчетДт) КАК СчетДтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КПСДт) КАК КПСДтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КЭКДт) КАК КЭКДтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.СчетКт) КАК СчетКтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КПСКт) КАК КПСКтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КЭККт) КАК КЭККтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КФО) КАК КФОПредставление,
	|	ЕСТЬNULL(Движения.СчетДт.Порядок, 0) КАК СчетДтПорядок,
	|	ЕСТЬNULL(Движения.СчетКт.Порядок, 0) КАК СчетКтПорядок
	|ИЗ
	|	Движения КАК Движения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	СчетДтПорядок,
	|	СчетКтПорядок
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧДокумента.Ссылка КАК Ссылка,
	|	МИНИМУМ(ТЧДокумента.НомерСтроки) КАК НомерСтроки,
	|	ТЧДокумента.ЦМОПолучатель КАК ЦМОПолучатель,
	|	ТЧДокумента.ЦМОПолучатель.Сотрудник КАК Сотрудник
	|ИЗ
	|	Документ.ВедомостьНаВыдачуОСНаНуждыУчреждения.ОсновныеСредства КАК ТЧДокумента
	|ГДЕ
	|	ТЧДокумента.Ссылка В(&МассивОбъектов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧДокумента.Ссылка,
	|	ТЧДокумента.ЦМОПолучатель,
	|	ТЧДокумента.ЦМОПолучатель.Сотрудник
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА СправочникОсновныеСредства.НаименованиеПолное = """"
	|			ТОГДА СправочникОсновныеСредства.Наименование
	|		ИНАЧЕ СправочникОсновныеСредства.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеМатериал,
	|	СправочникОсновныеСредства.Код КАК КодМатериал,
	|	ВЫРАЗИТЬ(&ЕдИзмШт КАК Справочник.КлассификаторЕдиницИзмерения).Наименование КАК НаименованиеЕдИзм,
	|	ВЫРАЗИТЬ(&ЕдИзмШт КАК Справочник.КлассификаторЕдиницИзмерения).Код КАК КодЕдИзм
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТЧДокумента.Ссылка КАК Ссылка,
	|		ТЧДокумента.ОсновноеСредство КАК Номенклатура,
	|		МИНИМУМ(ТЧДокумента.НомерСтроки) КАК НомерСтроки
	|	ИЗ
	|		Документ.ВедомостьНаВыдачуОСНаНуждыУчреждения.ОсновныеСредства КАК ТЧДокумента
	|	ГДЕ
	|		ТЧДокумента.Ссылка В(&МассивОбъектов)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ТЧДокумента.Ссылка,
	|		ТЧДокумента.ОсновноеСредство) КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК СправочникОсновныеСредства
	|		ПО Т.Номенклатура = СправочникОсновныеСредства.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Ссылка,
	|	Т.НомерСтроки
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧДокумента.Ссылка КАК Ссылка,
	|	ТЧДокумента.НомерСтроки КАК НомерСтроки,
	|	ТЧДокумента.ОсновноеСредство КАК Номенклатура,
	|	ТЧДокумента.ЦМОПолучатель КАК ЦМОПолучатель,
	|	ТЧДокумента.Количество КАК Количество
	|ИЗ
	|	Документ.ВедомостьНаВыдачуОСНаНуждыУчреждения.ОсновныеСредства КАК ТЧДокумента
	|ГДЕ
	|	ТЧДокумента.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧДокумента.Ссылка КАК Ссылка,
	|	ТЧДокумента.ОсновноеСредство КАК Номенклатура,
	|	СУММА(ТЧДокумента.Количество) КАК Количество,
	|	СУММА(ТЧДокумента.Сумма) КАК Сумма,
	|	ВЫБОР
	|		КОГДА СУММА(ТЧДокумента.Количество) <> 0
	|			ТОГДА ВЫРАЗИТЬ(СУММА(ТЧДокумента.Сумма) / СУММА(ТЧДокумента.Количество) КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	Документ.ВедомостьНаВыдачуОСНаНуждыУчреждения.ОсновныеСредства КАК ТЧДокумента
	|ГДЕ
	|	ТЧДокумента.Ссылка В(&МассивОбъектов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧДокумента.Ссылка,
	|	ТЧДокумента.ОсновноеСредство";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Возврат УправлениеПечатьюБГУ.ПечатьВедомостиВыдачиНФА_0504210(РезультатЗапроса, ОбъектыПечати, ИмяМакета);

КонецФункции

#КонецОбласти

#КонецЕсли
