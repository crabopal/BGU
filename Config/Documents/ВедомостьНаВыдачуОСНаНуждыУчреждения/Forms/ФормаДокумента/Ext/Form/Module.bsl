&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Отображение обязательности колонки КПС
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваКПС.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ВидОперации", ВидСравненияКомпоновкиДанных.Равно,
		Перечисления.ВидыОперацийВыдачаОСНаНуждыУчреждения.ВнутреннееПеремещение);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"УчетПоКПС21", ВидСравненияКомпоновкиДанных.Равно, Ложь);		
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста"				, ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного"	, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст"					, "<не используется>");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр"			, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УчетПоПодразделениям101 = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("101.00").УчетПоПодразделениям;
	ПризнакиУчета21 = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("21");
	УчетПоПодразделениям21	= ПризнакиУчета21.УчетПоПодразделениям;
	УчетПоКПС21	= ПризнакиУчета21.УчетПоКПС;
	
	УстановитьДинамическиеДанныеТаблицыОсновныеСредства();
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтаФорма, Объект);
	УстановитьОбязательностьЭлементовФормы(ЭтаФорма, Объект);
	РезервированиеНФАКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПодразделениеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	
	УстановитьПоВсем = Ложь;
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		УстановитьПоВсем = Истина;
	КонецЕсли;
	
	ВыбратьИУстановитьПодразделение(УстановитьПоВсем);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьЦМОЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	
	УстановитьПоВсем = Ложь;
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		УстановитьПоВсем = Истина;
	КонецЕсли;
	
	ВыбратьИУстановитьЦМО(УстановитьПоВсем);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьИУстановитьЦМО(УстановитьПоВсем)

	ПараметрыВыбораЗначения = Новый Структура;
	ОтборВыбора = Новый Структура;
	ОтборВыбора.Вставить("Владелец", Объект.Организация);
	ПараметрыВыбораЗначения.Вставить("Отбор", ОтборВыбора);
	ПараметрыВыбораЗначения.Вставить("МножественныйВыбор", Ложь);
	ПараметрыВыбораЗначения.Вставить("РежимВыбора", Истина);
	
	Оповещение = Новый ОписаниеОповещения("ВыбратьИУстановитьЦМОЗавершение", ЭтотОбъект,
		Новый Структура("УстановитьПоВсем", УстановитьПоВсем));
	ОткрытьФорму("Справочник.ЦМО.ФормаВыбора", ПараметрыВыбораЗначения, ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьИУстановитьЦМОЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВыделенныеСтроки = Элементы.ОсновныеСредства.ВыделенныеСтроки;
	УстановитьПоВсем = ДополнительныеПараметры.УстановитьПоВсем;
	ВыбранныйЦМО = Результат;
	
	Если ЗначениеЗаполнено(ВыбранныйЦМО) Тогда
		Если УстановитьПоВсем Тогда
			Для каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
				ТекСтрока.ЦМОПолучатель = ВыбранныйЦМО;
			КонецЦикла; 
		Иначе
			Для каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
				ТекСтрока = Объект.ОсновныеСредства.НайтиПоИдентификатору(ВыделеннаяСтрока);
				ТекСтрока.ЦМОПолучатель = ВыбранныйЦМО;
			КонецЦикла; 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // ВыбратьИУстановитьЦМО()

&НаКлиенте
Процедура ВыбратьИУстановитьПодразделение(УстановитьПоВсем)

	ПараметрыВыбораЗначения = Новый Структура;
	ОтборВыбора = Новый Структура;
	ОтборВыбора.Вставить("Владелец", Объект.Организация);
	ПараметрыВыбораЗначения.Вставить("Отбор", ОтборВыбора);
	ПараметрыВыбораЗначения.Вставить("МножественныйВыбор", Ложь);
	ПараметрыВыбораЗначения.Вставить("РежимВыбора", Истина);
	
	Оповещение = Новый ОписаниеОповещения("ВыбратьИУстановитьПодразделениеЗавершение", ЭтотОбъект,
		Новый Структура("УстановитьПоВсем", УстановитьПоВсем));
	
	ОткрытьФорму("Справочник.Подразделения.ФормаВыбора", ПараметрыВыбораЗначения, ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьИУстановитьПодразделениеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	УстановитьПоВсем = ДополнительныеПараметры.УстановитьПоВсем;
	ВыбранноеПодразделение = Результат;
	ВыделенныеСтроки = Элементы.ОсновныеСредства.ВыделенныеСтроки;
	
	Если ЗначениеЗаполнено(ВыбранноеПодразделение) Тогда
		Если УстановитьПоВсем Тогда
			Для каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
				ТекСтрока.ПодразделениеПолучатель = ВыбранноеПодразделение;
			КонецЦикла; 
		Иначе
			Для каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
				ТекСтрока = Объект.ОсновныеСредства.НайтиПоИдентификатору(ВыделеннаяСтрока);
				ТекСтрока.ПодразделениеПолучатель = ВыбранноеПодразделение;
			КонецЦикла; 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // ВыбратьИУстановитьПодразделение()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)

	Элементы = Форма.Элементы;
	
	ДоступностьСвязанныхЭлементов = ЗначениеЗаполнено(Объект.Организация);
	Элементы.ЦМО.Доступность			= ДоступностьСвязанныхЭлементов;
	Элементы.Подразделение.Доступность	= ДоступностьСвязанныхЭлементов;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОбязательностьЭлементовФормы(Форма, Объект)

	Элементы = Форма.Элементы;
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийВыдачаОСНаНуждыУчреждения.ВводВЭксплуатацию") Тогда
		ПодразделениеОтправительОбязательно	= Форма.КэшПараметров.ИспользоватьУчетПоПодразделениям И Форма.УчетПоПодразделениям101;
	Иначе
		ПодразделениеОтправительОбязательно	= Форма.КэшПараметров.ИспользоватьУчетПоПодразделениям И Форма.УчетПоПодразделениям21;
	КонецЕсли;
	ПодразделениеПолучательОбязательно		= Форма.КэшПараметров.ИспользоватьУчетПоПодразделениям И Форма.УчетПоПодразделениям21;
	
	Если ПодразделениеОтправительОбязательно Тогда
		Элементы.Подразделение.АвтоОтметкаНезаполненного  = Истина;
		Элементы.Подразделение.ОтметкаНезаполненного		= НЕ ЗначениеЗаполнено(Объект.Подразделение);
	Иначе
		Элементы.Подразделение.АвтоОтметкаНезаполненного  = Ложь;
		Элементы.Подразделение.ОтметкаНезаполненного		= Ложь;
	КонецЕсли;
	Если ПодразделениеПолучательОбязательно Тогда
		Элементы.ОсновныеСредстваПодразделениеПолучатель.АвтоОтметкаНезаполненного  = Истина;
	Иначе
		Элементы.ОсновныеСредстваПодразделениеПолучатель.АвтоОтметкаНезаполненного  = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьДинамическиеДанныеТаблицыОсновныеСредства()
	
	МассивОбъектовОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	ДанныеОбъектовОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОбъектовОС, "ГрупповойУчет,ВидНФА");
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		
		ДанныеОбъектаОС = ДанныеОбъектовОС[СтрокаТаблицы.ОсновноеСредство];
		Если ДанныеОбъектаОС <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеОбъектаОС);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммы(СообщатьОбОшибках = Истина)

	Если Объект.Проведен Тогда
		ТекстСообщения = НСтр("ru = 'Расчет доступен только в непроведенном документе'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;

	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(
		СтруктураПроверяемыхРеквизитов(), Объект, СообщатьОбОшибках);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьСуммыНаСервере();

КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыНаСервере()
	
	ТаблицаОС = УправлениеОсновнымиСредствами.ПустаяТаблицаОС_ДляРасчетаУчетныхДанных();
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		НоваяСтрока = ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
	КонецЦикла;	
	
	ТабОстатков = УправлениеОсновнымиСредствами.ТаблицаУчетныхДанных(ПараметрыПолученияУчетныхДанных(ТаблицаОС));
	
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		ЗаполнитьСтрокуТЧ(СтрокаТЧ, ТабОстатков);
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		СтруктураРеквизитов.Вставить("ИФО", "ИФО");
	КонецЕсли;
	СтруктураРеквизитов.Вставить("ЦМО", "МОЛ/Место хранения");
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям
		И Элементы.Подразделение.АвтоОтметкаНезаполненного = Истина Тогда
		СтруктураРеквизитов.Вставить("Подразделение", "Подразделение");
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("ЦМО"			, Объект.ЦМО);
	ПараметрыПодбора.Отбор.Вставить("Подразделение"	, Объект.Подразделение);
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения", Неопределено);
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийВыдачаОСНаНуждыУчреждения.ВводВЭксплуатацию") Тогда
		
		ПараметрыПодбора.ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе");
		ПараметрыПодбора.Отбор.Вставить("Счет", "101.00");
		//ПараметрыПодбора.Отбор.Вставить("ПорядокПогашенияСтоимости", ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию"));
		ПараметрыПодбора.Отбор.Вставить("Состояние", ПредопределенноеЗначение("Перечисление.СостоянияОС.ПринятоКУчету"));
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийВыдачаОСНаНуждыУчреждения.ВнутреннееПеремещение") Тогда
		
		ПараметрыПодбора.ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ОперативныйУчет");
		
	КонецЕсли;
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	ПараметрыПодбора.Вставить("ДокументСРезервированиемОС", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОсновныхСредствНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()

	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);

КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(Знач ВыбранноеЗначение)
	
	ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(
		Объект.ОсновныеСредства, ВыбранноеЗначение);
	
	УстановитьДинамическиеДанныеТаблицыОсновныеСредства();
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьУстановитьКоличествоОСВСтроке(СтрокаТаблицы);
	КонецЦикла;
	
	//РассчитатьСуммыНаСервере();
	
КонецПроцедуры

