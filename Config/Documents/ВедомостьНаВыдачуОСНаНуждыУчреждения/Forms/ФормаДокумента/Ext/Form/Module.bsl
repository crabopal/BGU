&НаКлиенте
Процедура УстановитьЦМО(Команда)
	
	ВыделенныеСтроки = Элементы.ОсновныеСредства.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПоВсем = Ложь;
	Если ВыделенныеСтроки.Количество() = 1 Тогда
		ТекстВопроса = НСтр("ru = 'Выделена всего одна строка.
									|Есть возможность установить выбранного получателя в указанную строку или во все строки документа.'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Установить в указанную строку'"));
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Установить во все строки документа'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
		ПоказатьВопрос(Новый ОписаниеОповещения("УстановитьЦМОЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки,,КодВозвратаДиалога.Да);
		Возврат;
		
	КонецЕсли;
	
	ВыбратьИУстановитьЦМО(УстановитьПоВсем);
КонецПроцедуры

