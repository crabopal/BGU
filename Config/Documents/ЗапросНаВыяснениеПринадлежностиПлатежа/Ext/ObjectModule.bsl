#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
	
// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти
	
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = ПлатежныеДокументы.Итог("Сумма");
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
			
	РеквизитыРегистрацииОФК = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ЭтотОбъект.Ссылка);

	Если ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ЭтотОбъект.Ссылка).Статус = Неопределено Тогда
		РеквизитыРегистрацииОФК.Вставить("ПлатежноРасчетныйДокумент", ЭтотОбъект.Ссылка);
		РеквизитыРегистрацииОФК.Статус = Перечисления.СтатусыИсполненияДокумента.ВРаботе;
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(РеквизитыРегистрацииОФК);
	КонецЕсли;		

КонецПроцедуры

#КонецОбласти

#КонецЕсли