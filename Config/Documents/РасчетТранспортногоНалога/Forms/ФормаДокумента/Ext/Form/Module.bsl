&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	Объект.ОсновныеСредства.Очистить();
	
	ЗаполнитьГлавногоБухгалтера();
	ЗаполнитьОтветственногоИсполнителя();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГлавногоБухгалтера()
	
	ЗаполнениеРеквизитовОбъектов.ЗаполнитьПодписанта(Объект, "ГлавныйБухгалтер", "ГлавныйБухгалтер");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтветственногоИсполнителя()
	
	Объект.ОтветственныйИсполнитель = ЗаполнениеРеквизитовОбъектов.ПолучитьОтветственногоИсполнителя(
		Объект.Ответственный, Объект.Организация, "Документ.РасчетТранспортногоНалога");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеПериода(Форма)

	Объект = Форма.Объект;
	
	Форма.ПредставлениеПериодаРегистрации = ВыборПериодаКлиентСервер.ПолучитьПредставлениеПериодаОтчета(
		ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.Квартал"),
		НачалоКвартала(Объект.ОтчетныйПериод), КонецМесяца(Объект.ОтчетныйПериод));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьГодовойРасчет(Форма)

	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ГодовойРасчет = ГодовойРасчет(Объект.ОтчетныйПериод);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОсновныеСредстваСуммаАванса",
		"Видимость", ГодовойРасчет);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОсновныеСредстваСуммаИсчислено",
		"Видимость", ГодовойРасчет);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОсновныеСредстваИтогСуммаИсчислено",
		"Видимость", ГодовойРасчет);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОсновныеСредстваИтогСуммаАванса",
		"Видимость", ГодовойРасчет);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьНалогВТаблице()
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		РассчитатьНалогВСтроке(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьНалогВСтроке(СтрокаТаблицы)
	
	ПараметрыРасчета = РасчетИмущественныхНалоговКлиентСервер.ПараметрыРасчетаСуммаТранспортногоНалога();
	ЗаполнитьЗначенияСвойств(ПараметрыРасчета, СтрокаТаблицы);
	
	СтрокаТаблицы.СуммаИсчислено = РасчетИмущественныхНалоговКлиентСервер.СуммаТранспортногоНалога(ПараметрыРасчета);
	
	СтрокаТаблицы.Сумма = СтрокаТаблицы.СуммаИсчислено - ?(ГодовойРасчет(Объект.ОтчетныйПериод),
		СтрокаТаблицы.СуммаАванса, 0);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИРассчитатьНаКлиенте()
	
	ДлительнаяОперация = НачатьЗаполнениеНаСервере();
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаполнитьИРассчитатьЗавершение", ЭтотОбъект);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция НачатьЗаполнениеНаСервере()
	
	Объект.ОсновныеСредства.Очистить();
	
	ПараметрыРасчета = РасчетИмущественныхНалогов.ПараметрыРасчетаТранспортногоНалога();
	ПараметрыРасчета.Организация = Объект.Организация;
	ПараметрыРасчета.ОтчетныйПериод = Объект.ОтчетныйПериод;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр(
		"ru = 'Заполнение и расчет документа ""Расчет транспортного налога""'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	Возврат 
		ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"РасчетИмущественныхНалогов.ТаблицаРасчетаТранспортногоНалога", ПараметрыРасчета);
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьИРассчитатьЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		ТекстПредупреждения = НСтр("ru = 'При расчете возникла ошибка:
			|%1'");
		ТекстПредупреждения = СтрШаблон(ТекстПредупреждения, Результат.КраткоеПредставлениеОшибки);
		ПоказатьПредупреждение( , ТекстПредупреждения);
		Возврат;
	КонецЕсли;

	ЗаполнитьИРассчитатьЗавершениеНаСервере(Результат.АдресРезультата);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИРассчитатьЗавершениеНаСервере(Знач АдресРезультата)

	ТаблицаРасчетаТранспортногоНалога = ПолучитьИзВременногоХранилища(АдресРезультата);
	Для Каждого СтрокаРасчета Из ТаблицаРасчетаТранспортногоНалога Цикл
		ЗаполнитьЗначенияСвойств(Объект.ОсновныеСредства.Добавить(), СтрокаРасчета);
	КонецЦикла;

	УдалитьИзВременногоХранилища(АдресРезультата);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ГодовойРасчет(ОтчетныйПериод)
	
	Возврат КонецДня(ОтчетныйПериод) = КонецГода(ОтчетныйПериод);
	
КонецФункции

