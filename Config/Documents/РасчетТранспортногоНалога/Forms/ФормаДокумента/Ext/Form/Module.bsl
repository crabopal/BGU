#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НачалоПериода", 			НачалоКвартала(Объект.ОтчетныйПериод));	
	ПараметрыФормы.Вставить("КонецПериода", 			Объект.ОтчетныйПериод);	
	ПараметрыФормы.Вставить("НарастающимИтогом", 		Ложь);	
	ПараметрыФормы.Вставить("БезПоследнегоКвартала", 	Ложь);	

	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериодаКвартал", ПараметрыФормы, Элементы.ПредставлениеПериодаРегистрации);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	Объект.ОтчетныйПериод = КонецМесяца(ДобавитьМесяц(Объект.ОтчетныйПериод, Направление * 3));
	УстановитьПредставлениеПериода(ЭтотОбъект);

	Объект.ОсновныеСредства.Очистить();
	УстановитьВидимостьГодовойРасчет(ЭтотОбъект);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Объект.ОтчетныйПериод = ВыбранноеЗначение.КонецПериода;
	УстановитьПредставлениеПериода(ЭтотОбъект);
	
	Объект.ОсновныеСредства.Очистить();
	УстановитьВидимостьГодовойРасчет(ЭтотОбъект);
	
	Модифицированность = Истина;
	
КонецПроцедуры

