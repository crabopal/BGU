	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Если Результат.Свойство("ТаблицаРаздела21") И Результат.Свойство("ТаблицаРаздела22") Тогда
		Объект.Раздел21.Загрузить(Результат.ТаблицаРаздела21);
		Объект.Раздел22.Загрузить(Результат.ТаблицаРаздела22);
	КонецЕсли;
	
	Документы.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям.ЗаполнитьСлужебныеКолонки(ЭтаФорма);
	
