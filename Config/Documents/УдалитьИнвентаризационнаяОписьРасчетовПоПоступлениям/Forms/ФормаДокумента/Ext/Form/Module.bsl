&НаКлиенте
Процедура ОбновитьПоказателиВСтроке(ИмяТабличнойЧасти, Элемент)
	
	ТекДанные = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяИзмененногоПоля = СтрЗаменить(Элемент.Имя, ИмяТабличнойЧасти, "");
	
	ИнвентаризацияКлиент.ОбновитьПоказателиВСтроке0510468(ТекДанные, ИмяИзмененногоПоля, ВалютаРУ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуГрупповогоЗаполненияСтрок(ИмяТабличнойЧасти)
	
	КоличествоСтрок = Элементы[ИмяТабличнойЧасти].ВыделенныеСтроки.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		ТекстСообщения = НСтр("ru='Выделите несколько строк для выполнения группового заполнения'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
	
	ОповещениеВыбор = Новый ОписаниеОповещения("ЗакрытаФормаГрупповогоЗаполненияСтрок", ЭтаФорма, ДополнительныеПараметры);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("КоличествоСтрок",			КоличествоСтрок);
	ПараметрыФормы.Вставить("СвязиПараметровВыбора",	Новый Структура());
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",		Новый Структура());
	ПараметрыФормы.Вставить("ОписьСсылка",				Объект.Ссылка);
	
	ОткрытьФорму("Документ.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям.Форма.ГрупповоеЗаполнениеСтрокЗадолженности", ПараметрыФормы,,,,, ОповещениеВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытаФормаГрупповогоЗаполненияСтрок(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТабличнойЧасти = ПараметрыОповещения["ИмяТабличнойЧасти"];
	
	ВыделенныеСтроки = Элементы[ИмяТабличнойЧасти].ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() < 100 Тогда
		ЗаполнитьВыделенныеСтрокиКлиент(ИмяТабличнойЧасти, ВыделенныеСтроки, РезультатВыбора);
	Иначе
		ЗаполнитьВыделенныеСтрокиСервер(ИмяТабличнойЧасти, ВыделенныеСтроки, РезультатВыбора);
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВыделенныеСтрокиКлиент(ИмяТабличнойЧасти, ВыделенныеСтроки, РезультатВыбора)
	
	ЗаполнитьВыделенныеСтроки(Объект[ИмяТабличнойЧасти], ВыделенныеСтроки, РезультатВыбора);
	
