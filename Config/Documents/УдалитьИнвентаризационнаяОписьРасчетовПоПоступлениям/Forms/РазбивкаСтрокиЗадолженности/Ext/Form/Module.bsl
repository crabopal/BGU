&НаКлиенте
Перем ИзмененаСуммаВал, ИзмененаСуммаРуб, ДопустимостьСумм;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ЗагрузитьПереданныеСведения();
	
	НастроитьВидимостьВалютныхПолей();
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДопустимостьСумм = Новый Структура("Отрицательные,Положительные", Новый Структура(), Новый Структура());
	ДопустимостьСумм.Отрицательные.Вставить("Валютные",	(СуммаВал <= 0));
	ДопустимостьСумм.Отрицательные.Вставить("Рублевые",	(СуммаРуб <= 0));
	ДопустимостьСумм.Положительные.Вставить("Валютные",	(СуммаВал >= 0));
	ДопустимостьСумм.Положительные.Вставить("Рублевые",	(СуммаРуб >= 0));
	
	ЗаполнитьНПП();
	
	ОбновитьИтогиТаблицы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность Тогда
		Отказ = Истина;
		СтандартнаяОбработка = Ложь;
		
		Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
		
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаФрагментыСтроки

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТаблицаФрагментыСтроки.ТекущиеДанные;
	
	ЗаполнитьНПП();
	
	ОбновитьИтогиТаблицы();
	
	Если ИзмененаСуммаВал = Истина Тогда
		ИзмененаСуммаВал = Неопределено;
		
		ИмяПоляСуммы	= "СуммаВал";
		ОбозначениеСумм	= "Валютные";
		
	ИначеЕсли ИзмененаСуммаРуб = Истина Тогда
		ИзмененаСуммаРуб = Неопределено;
		
		ИмяПоляСуммы	= "СуммаРуб";
		ОбозначениеСумм	= "Рублевые";
		
	ИначеЕсли УказанаИностраннаяВалюта Тогда
		ИмяПоляСуммы	= "СуммаВал";
		ОбозначениеСумм	= "Валютные";
		
	Иначе
		ИмяПоляСуммы	= "СуммаРуб";
		ОбозначениеСумм	= "Рублевые";
	КонецЕсли;
	
	СравниваемыеИтоги = ОпределитьСравниваемыеИтоги(ОбозначениеСумм);
	
	ТекущийИтог		= СравниваемыеИтоги.ТекущийИтог;
	ИсходнаяСумма	= СравниваемыеИтоги.ИсходнаяСумма;
	
	Если ТекущийИтог = ИсходнаяСумма Тогда
		Возврат;
	КонецЕсли;	
	
	ДопустимаОтрицательнаяСумма = ДопустимостьСумм.Отрицательные[ОбозначениеСумм];
	ДопустимаПоложительнаяСумма = ДопустимостьСумм.Положительные[ОбозначениеСумм];
	
	СтрокаТаблицы = ОпределитьСтрокуФрагментаДляКорректировки();
	
	СтрокаТаблицы[ИмяПоляСуммы] = СтрокаТаблицы[ИмяПоляСуммы] + ИсходнаяСумма - ТекущийИтог;
	
	Если СтрокаТаблицы[ИмяПоляСуммы] < 0 И Не ДопустимаОтрицательнаяСумма
		Или СтрокаТаблицы[ИмяПоляСуммы] > 0 И Не ДопустимаПоложительнаяСумма Тогда
		СтрокаТаблицы[ИмяПоляСуммы] = 0;
		
		Если ТекДанные <> Неопределено И СтрокаТаблицы <> ТекДанные Тогда
			ОбновитьИтогиТаблицы();
			
			СравниваемыеИтоги = ОпределитьСравниваемыеИтоги(ОбозначениеСумм);
			
			ТекущийИтог		= СравниваемыеИтоги.ТекущийИтог;
			ИсходнаяСумма	= СравниваемыеИтоги.ИсходнаяСумма;
			
			ТекДанные[ИмяПоляСуммы] = ТекДанные[ИмяПоляСуммы] + ИсходнаяСумма - ТекущийИтог;
			
			ОбновитьПоказателиВСтроке(Элементы["ТаблицаФрагментыСтроки" + ИмяПоляСуммы], ТекДанные);
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьПоказателиВСтроке(Элементы["ТаблицаФрагментыСтроки" + ИмяПоляСуммы], СтрокаТаблицы);
	
	ОбновитьИтогиТаблицы();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиПередУдалением(Элемент, Отказ)
	
	Если ТаблицаФрагментыСтроки.Количество() = Элементы.ТаблицаФрагментыСтроки.ВыделенныеСтроки.Количество() Тогда
		Отказ = Истина;
		
		ПоказатьПредупреждение(, НСтр("ru='Не предусмотрена полная очистка таблицы фрагментов строк.
			|Должна присутствовать хотя бы одна строка.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда
		ТекДанные = Элементы.ТаблицаФрагментыСтроки.ТекущиеДанные;
		
		ЗаполнитьЗначенияСвойств(ТекДанные, СтруктураЗаполненияНовойСтроки);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаФрагментыСтрокиСуммаВалПриИзменении(Элемент)
	
	ИзмененаСуммаВал = Истина;
	
	ОбновитьПоказателиВСтроке(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиСуммаРубПриИзменении(Элемент)
	
	ИзмененаСуммаРуб = Истина;
	
	ОбновитьПоказателиВСтроке(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиСуммаПодтвержденаАктомСверкиВалПриИзменении(Элемент)
	
	ОбновитьПоказателиВСтроке(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиСуммаПодтвержденаАктомСверкиРубПриИзменении(Элемент)
	
	ОбновитьПоказателиВСтроке(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиСуммаНеПодтвержденаАктомСверкиВалПриИзменении(Элемент)
	
	ОбновитьПоказателиВСтроке(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиСуммаНеПодтвержденаАктомСверкиРубПриИзменении(Элемент)
	
	ОбновитьПоказателиВСтроке(Элемент);
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаФрагментыСтрокиЗаключениеКомиссииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ИнвентаризацияКлиент.НачатьВыборЗаключенияКомиссииПоИнвОписи(ЭтаФорма, Элементы.ТаблицаФрагментыСтроки.ТекущиеДанные, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФрагментыСтрокиЗаключениеКомиссииОткрытие(Элемент, СтандартнаяОбработка)
	
	ИнвентаризацияКлиент.НачатьВводТекстовойСтрокиЗаключенияКомиссии(ЭтаФорма, СтандартнаяОбработка, "ТаблицаФрагментыСтроки");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ПроверитьИПеренестиВДокумент();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ДобавитьУсловноеОформление_ИтогиРасходятсяСИсходнойСтрокой();
	
	Документы.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям.ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, "ТаблицаИсходнаяСтрока", ВалютаРУ, Истина);
	Документы.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям.ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, "ТаблицаФрагментыСтроки", ВалютаРУ, Истина);
	
	Документы.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям.ДобавитьУсловноеОформление_ОтметкаНезаполненныхРеквизитовАктаСверки(УсловноеОформление, "ТаблицаФрагментыСтроки", Истина);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПереданныеСведения()
	
	ИдентификаторСтроки = Параметры.ИсходнаяСтрока.ИдентификаторСтроки;
	Валюта				= Параметры.ИсходнаяСтрока.Валюта;
	СуммаВал			= Параметры.ИсходнаяСтрока.СуммаВал;
	СуммаРуб			= Параметры.ИсходнаяСтрока.СуммаРуб;
	
	УказанаИностраннаяВалюта = ЗначениеЗаполнено(Валюта) И Валюта <> ВалютаРУ;
	
	Если ЗначениеЗаполнено(Параметры.КурсВалюты) И ЗначениеЗаполнено(Параметры.КратностьВалюты) Тогда
		ПрименяемыйКурс = Параметры.КурсВалюты / Параметры.КратностьВалюты;
	ИначеЕсли УказанаИностраннаяВалюта Тогда
		ПрименяемыйКурс = ?(ЗначениеЗаполнено(СуммаВал), СуммаРуб/СуммаВал, 0);
	Иначе
		ПрименяемыйКурс = 1;
	КонецЕсли;
	
	ТаблицаИсходнаяСтрока.Очистить();
	
	НоваяСтрока = ТаблицаИсходнаяСтрока.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры.ИсходнаяСтрока);
	
	ТаблицаФрагментыСтроки.Очистить();
	
	СписокНомеров = Новый СписокЗначений();
	
	Если Параметры.ФрагментыСтроки = Неопределено Тогда
		НоваяСтрока = ТаблицаФрагментыСтроки.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры.ИсходнаяСтрока);
		
		СписокНомеров.Добавить(Параметры.ИсходнаяСтрока.НомерСтроки);
	Иначе
		Для Каждого СтруктураСтроки Из Параметры.ФрагментыСтроки Цикл
			НоваяСтрока = ТаблицаФрагментыСтроки.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
			
			СписокНомеров.Добавить(СтруктураСтроки.НомерСтроки);
		КонецЦикла;
	КонецЕсли;
	
	СписокНомеров.СортироватьПоЗначению();
	
	НомераСтрокФрагментов = Новый ФиксированныйМассив(СписокНомеров.ВыгрузитьЗначения());
	
	СтруктураЗаполненияНовойСтроки = Новый Структура();
	СтруктураЗаполненияНовойСтроки.Вставить("Валюта", Валюта);
	
	СтруктураЗаполненияНовойСтроки = Новый ФиксированнаяСтруктура(СтруктураЗаполненияНовойСтроки);
	
	ПустыеСтатусыЗадолженности.Очистить();
	ПустыеСтатусыЗадолженности.Добавить(Перечисления.СтатусыЗадолженности.ПустаяСсылка());
	
	Объект = Новый Структура("Ссылка", Параметры.ОписьСсылка);
	Объект = Новый ФиксированнаяСтруктура(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтогиТаблицы()
	
	КоличествоФрагментовСтроки = ТаблицаФрагментыСтроки.Количество();
	
	ИтогСуммаВал							= ТаблицаФрагментыСтроки.Итог("СуммаВал");
	ИтогСуммаРуб							= ТаблицаФрагментыСтроки.Итог("СуммаРуб");
	ИтогСуммаПодтвержденаАктомСверкиВал		= ТаблицаФрагментыСтроки.Итог("СуммаПодтвержденаАктомСверкиВал");
	ИтогСуммаПодтвержденаАктомСверкиРуб		= ТаблицаФрагментыСтроки.Итог("СуммаПодтвержденаАктомСверкиРуб");
	ИтогСуммаНеПодтвержденаАктомСверкиВал	= ТаблицаФрагментыСтроки.Итог("СуммаНеПодтвержденаАктомСверкиВал");
	ИтогСуммаНеПодтвержденаАктомСверкиРуб	= ТаблицаФрагментыСтроки.Итог("СуммаНеПодтвержденаАктомСверкиРуб");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоказателиВСтроке(Элемент, ТекДанные = Неопределено)
	
	ИмяТабличнойЧасти = "ТаблицаФрагментыСтроки";
	
	Если ТекДанные = Неопределено Тогда
		ТекДанные = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	КонецЕсли;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяИзмененногоПоля = СтрЗаменить(Элемент.Имя, ИмяТабличнойЧасти, "");
	
	ИнвентаризацияКлиент.ОбновитьПоказателиВСтроке0510468(ТекДанные, ИмяИзмененногоПоля, ВалютаРУ, ПрименяемыйКурс, ДопустимостьСумм);
	
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьНПП()
	
	НПП = 0;
	
	Для Каждого СтрокаТаблицы Из ТаблицаФрагментыСтроки Цикл
		НПП = НПП + 1;
		
		СтрокаТаблицы.НПП = НПП;
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Процедура НастроитьВидимостьВалютныхПолей()
	
	НовВидимость = ЗначениеЗаполнено(Валюта) И Валюта <> ВалютаРУ;
	
	Элементы.НадписьВВалюте.Видимость							= НовВидимость;
	Элементы.ИтогСуммаВал.Видимость								= НовВидимость;
	Элементы.ИтогСуммаПодтвержденаАктомСверкиВал.Видимость		= НовВидимость;
	Элементы.ИтогСуммаНеПодтвержденаАктомСверкиВал.Видимость	= НовВидимость;
	
КонецПроцедуры	


&НаСервере
Процедура ДобавитьУсловноеОформление_ИтогиРасходятсяСИсходнойСтрокой()
	
	ИменаПолей = Новый Массив();
	ИменаПолей.Добавить("СуммаВал");
	ИменаПолей.Добавить("СуммаРуб");
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Итог по таблице фрагментов отличается от показателя исходной строки (%1)'"), ИмяПоля);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		Условие.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоля);
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,,,Истина));
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Итог" + ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Функция ОпределитьСтрокуФрагментаДляКорректировки()
	
	// Анализируемая строка может быть редактируемой или иной.
	//
	// Приоритеты выбора строки для корректировки:
	// 1. Иная строка с пустым статусом задолженности;
	// 2. Редактируемая строка с пустым статусом задолженности;
	// 3. Иная строка самая последняя с заполненным статусом задолженности;
	// 4. Редактируемая строка с заполненным статусом задолженности.
	
	Перем СтрокаПриоритет2, СтрокаПриоритет3, СтрокаПриоритет4;
	
	ТекДанные = Элементы.ТаблицаФрагментыСтроки.ТекущиеДанные;
	
	КоличествоСтрок = ТаблицаФрагментыСтроки.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		СтрокаТаблицы = ТаблицаФрагментыСтроки[КоличествоСтрок - Счетчик];
		
		Если ПустыеСтатусыЗадолженности.НайтиПоЗначению(СтрокаТаблицы.СтатусЗадолженности) <> Неопределено Тогда
			Если СтрокаТаблицы <> ТекДанные Тогда
				Возврат СтрокаТаблицы;
				
			ИначеЕсли СтрокаПриоритет2 = Неопределено Тогда
				СтрокаПриоритет2 = СтрокаТаблицы;
			КонецЕсли;
			
		Иначе
			Если СтрокаТаблицы <> ТекДанные Тогда
				Если СтрокаПриоритет3 = Неопределено Тогда
					СтрокаПриоритет3 = СтрокаТаблицы;
				КонецЕсли;
			Иначе
				Если СтрокаПриоритет4 = Неопределено Тогда
					СтрокаПриоритет4 = СтрокаТаблицы;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаПриоритет2 <> Неопределено Тогда
		Возврат СтрокаПриоритет2;
		
	ИначеЕсли СтрокаПриоритет3 <> Неопределено Тогда
		Возврат СтрокаПриоритет3;
		
	ИначеЕсли СтрокаПриоритет4 <> Неопределено Тогда
		Возврат СтрокаПриоритет4;
		
	Иначе
		Возврат ТаблицаФрагментыСтроки[КоличествоСтрок - 1];
	КонецЕсли;
	
КонецФункции


&НаКлиенте
Функция ОпределитьСравниваемыеИтоги(ОбозначениеСумм)
	
	СравниваемыеИтоги = Новый Структура("ТекущийИтог,ИсходнаяСумма");
	
	Если ОбозначениеСумм = "Валютные" Тогда
		СравниваемыеИтоги.ТекущийИтог	= ИтогСуммаВал;
		СравниваемыеИтоги.ИсходнаяСумма	= СуммаВал;
	ИначеЕсли ОбозначениеСумм = "Рублевые" Тогда
		СравниваемыеИтоги.ТекущийИтог	= ИтогСуммаРуб;
		СравниваемыеИтоги.ИсходнаяСумма	= СуммаРуб;
	КонецЕсли;
	
	Возврат СравниваемыеИтоги;
	
КонецФункции


&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		
		Закрыть();
	КонецЕсли;
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьИПеренестиВДокумент();
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПроверитьИПеренестиВДокумент()
	
	Если ПроверитьКорректностьЗаполнения() Тогда
		Модифицированность = Ложь;
		
		Закрыть(ПолучитьВозвращаемоеЗначениеКлиент());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьКорректностьЗаполнения()
	
	ЕстьОшибкиЗаполнения = Ложь;
	
	ТекстШаблонИтог = НСтр("ru='Итог по колонке ""%1"" (%2) не совпадает с исходной разбиваемой суммой %3.
		|Исправьте значение в одной из строк табличной части.'");
	
	ФорматнаяСтрока = "ЧДЦ=2";
	
	Если ИтогСуммаВал <> СуммаВал Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ТекстСообщения = СтрШаблон(ТекстШаблонИтог, НСтр("ru='Сумма в валюте'"), Формат(ИтогСуммаВал, ФорматнаяСтрока), Формат(СуммаВал, ФорматнаяСтрока));
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "ТаблицаФрагментыСтроки");
	КонецЕсли;
	
	Если ИтогСуммаРуб <> СуммаРуб Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ТекстСообщения = СтрШаблон(ТекстШаблонИтог, НСтр("ru='Сумма в рублях'"), Формат(ИтогСуммаРуб, ФорматнаяСтрока), Формат(СуммаРуб, ФорматнаяСтрока));
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "ТаблицаФрагментыСтроки");
	КонецЕсли;
	
	Возврат Не ЕстьОшибкиЗаполнения;
	
КонецФункции


&НаКлиенте
Функция ПолучитьВозвращаемоеЗначениеКлиент()
	
	Возврат ПолучитьВозвращаемоеЗначениеСервер();
	
КонецФункции

&НаСервере
Функция ПолучитьВозвращаемоеЗначениеСервер()
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
		ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	
	Таблица = ТаблицаФрагментыСтроки.Выгрузить();
	Таблица.Колонки.Удалить("Валюта");
	
	ФрагментыСтроки = ОбщегоНазначения.ТаблицаЗначенийВМассив(Таблица);
	
	Для Каждого СтруктураСтроки Из ФрагментыСтроки Цикл
		СтруктураСтроки.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
		СтруктураСтроки.Вставить("ПризнакФрагментаСтроки", Истина);
		
		СтруктураСтроки.Удалить("НомерСтроки");
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("ФрагментыСтроки",		ФрагментыСтроки);
	Результат.Вставить("НомераСтрокФрагментов",	НомераСтрокФрагментов);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

