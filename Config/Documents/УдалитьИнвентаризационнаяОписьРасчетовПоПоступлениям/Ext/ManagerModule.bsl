#Область ПрограммныйИнтерфейс

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	ЕстьОшибки = Ложь;
	
	ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ДокументОбъект, ЕстьОшибки);
	
	ПроверитьЗаполнениеРаздела2(ДокументОбъект, ЕстьОшибки);
	
	Возврат ЕстьОшибки;
	
КонецФункции

Процедура ЗаполнитьСписокСчетовПоУмолчанию(ДокументОбъект) Экспорт
	
	НаДату = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(ДокументОбъект.ДатаИнвентаризации);
	
	СписокСчетов = ПолучитьСписокСчетовПоУмолчанию(НаДату);
	
	ДокументОбъект.СписокСчетов.Очистить();
	
	Для Каждого Счет Из СписокСчетов Цикл
		НоваяСтрока = ДокументОбъект.СписокСчетов.Добавить();
		НоваяСтрока.Счет = Счет;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДанныеДляРаздела1(ПараметрыФункции) Экспорт
	
	Данные = ПолучитьДанныеБухУчета(ПараметрыФункции);
	
	РасчетСерииДокументов = ИнвентаризацияСервер.РассчитатьСериюДокументов(Данные, ПараметрыФункции);
	
	Если РасчетСерииДокументов = Неопределено Тогда
		Возврат Данные;
	Иначе
		ИнвентаризацияСервер.СоздатьСериюДокументов(РасчетСерииДокументов, Данные, ПараметрыФункции);
		
		Возврат РасчетСерииДокументов;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанныеДляРаздела2(ПараметрыФункции) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументСсылка", ПараметрыФункции.Ссылка);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Раздел11,
	|	Раздел12
	|ИЗ
	|	Документ.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям
	|ГДЕ
	|	Ссылка = &ДокументСсылка";
	
	УстановитьПривилегированныйРежим(Истина);
	Таблица = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Таблица.Количество() = 0 Тогда
		ТаблицаРаздела21 = Новый ТаблицаЗначений();
		ТаблицаРаздела22 = Новый ТаблицаЗначений();
	Иначе
		ТаблицаРаздела21 = Таблица[0].Раздел11;
		ТаблицаРаздела22 = Таблица[0].Раздел12;
		
		ДобавитьСтрокиПоСтатусуЗадолженности(ТаблицаРаздела21);
		ДобавитьСтрокиПоСтатусуЗадолженности(ТаблицаРаздела22);
	КонецЕсли;
	
	Данные = Новый Структура();
	Данные.Вставить("ТаблицаРаздела21", ТаблицаРаздела21);
	Данные.Вставить("ТаблицаРаздела22", ТаблицаРаздела22);
	
	Возврат Данные;
	
КонецФункции

Процедура ЗаполнитьСлужебныеКолонки(ФормаДокумента) Экспорт
	
	Объект = ФормаДокумента.Объект;
	
	Для Каждого СтрокаТаблицы Из Объект.Раздел21 Цикл
		СтрокаТаблицы.ПризнакФрагментаСтроки = ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторСтроки);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из Объект.Раздел22 Цикл
		СтрокаТаблицы.ПризнакФрагментаСтроки = ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторСтроки);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПараметрыФормыРазбивкиСтрокиРаздела2(ДокументОбъект, ИмяТЧ, ТекДанные) Экспорт
	
	Если ЗначениеЗаполнено(ТекДанные.ИдентификаторСтроки) Тогда
		ФрагментыСтроки = ПолучитьФрагментыРазбитойСтроки(ДокументОбъект[ИмяТЧ], ТекДанные);
		
		ИсходнаяСтрока = СобратьИсходнуюСтрокуРаздела2ПоФрагментам(ФрагментыСтроки);
		
		ФрагментыСтроки = ОбщегоНазначения.ТаблицаЗначенийВМассив(ФрагментыСтроки);
	Иначе
		ФрагментыСтроки = Неопределено;
		
		ИсходнаяСтрока = ПолучитьПустуюСтруктуруСтрокиРаздела2();
		
		ЗаполнитьЗначенияСвойств(ИсходнаяСтрока, ТекДанные);
	КонецЕсли;
	
	ПараметрыФормыРазбивки = Новый Структура();
	ПараметрыФормыРазбивки.Вставить("ОписьСсылка", ДокументОбъект.Ссылка);
	ПараметрыФормыРазбивки.Вставить("ИсходнаяСтрока", ИсходнаяСтрока);
	ПараметрыФормыРазбивки.Вставить("ФрагментыСтроки", ФрагментыСтроки);
	
	Возврат ПараметрыФормыРазбивки;
	
КонецФункции

Процедура ДобавитьУсловноеОформление_НедоступностьВалютныхСумм(УсловноеОформление, ИмяТЧ, ВалютаРУ, ДляФормыРазбивкиСтрокиЗадолженности = Ложь) Экспорт
	
	//---
	// Редактирование номеров доступно только при виде документа "БСО"
	//---
	ПредставлениеШаблон = НСтр("ru='Редактирование валютных сумм доступно только при указании иностранной валюты (%1)'");
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблон, ИмяТЧ);

	// Условия
	Поле = ?(ДляФормыРазбивкиСтрокиЗадолженности, "", "Объект.") + ИмяТЧ + ".Валюта";
	
	ГруппаИли = ЭлементУО.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаИли.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	
	Условие = ГруппаИли.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Поле);
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;

	Условие = ГруппаИли.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Поле);
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = ВалютаРУ;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",		ЦветаСтиля.ТекстИнформационнойНадписи);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",			"х");
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + "СуммаВал");
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + "СуммаПодтвержденаАктомСверкиВал");
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + "СуммаНеПодтвержденаАктомСверкиВал");
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_ОтметкаНезаполненныхРеквизитовАктаСверки(УсловноеОформление, ИмяТЧ, ДляФормыРазбивкиСтрокиЗадолженности = Ложь) Экспорт
	
	ИменаПолей = Новый Массив();
	ИменаПолей.Добавить("ДатаАктаСверки");
	ИменаПолей.Добавить("НомерАктаСверки");
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Отметка незаполненного реквизита %1 акта сверки (%2)'"), ИмяПоля, ИмяТЧ);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(?(ДляФормыРазбивкиСтрокиЗадолженности, "", "Объект.") + ИмяТЧ + ".СуммаПодтвержденаАктомСверкиРуб");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(?(ДляФормыРазбивкиСтрокиЗадолженности, "", "Объект.") + ИмяТЧ + "." + ИмяПоля);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_БлокировкаКолонокВоФрагментахСтроки(УсловноеОформление, ИмяТЧ) Экспорт
	
	ИменаПолей = Новый Массив();
	ИменаПолей.Добавить("НомерСтроки");
	ИменаПолей.Добавить("Счет");
	ИменаПолей.Добавить("КПС");
	ИменаПолей.Добавить("КЭК");
	ИменаПолей.Добавить("ИФО");
	ИменаПолей.Добавить("Контрагент");
	ИменаПолей.Добавить("ИдентификаторКонтрагента");
	ИменаПолей.Добавить("Договор");
	ИменаПолей.Добавить("ДатаИсполнения");
	ИменаПолей.Добавить("Валюта");
	ИменаПолей.Добавить("СуммаВал");
	ИменаПолей.Добавить("СуммаРуб");
	ИменаПолей.Добавить("СтатусЗадолженности");
	ИменаПолей.Добавить("КФО");
	
	ШрифтНаклонный = Новый Шрифт(,,,Истина);
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Выделение поля %1 во фрагментах разбитой строки (%2)'"), ИмяПоля, ИмяТЧ);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТЧ + ".ПризнакФрагментаСтроки");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Истина;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтНаклонный);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0510468";
	КомандаПечати.Представление = НСтр("ru='Инвентаризационная опись расчетов по поступлениям (ф. 0510468)'");
	КомандаПечати.Порядок = 1;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0510468") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Форма0510468",
			"Инвентаризационная опись расчетов по поступлениям (ф. 0510468)",
			ПечатьФормы0510468(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода));
	КонецЕсли;
	
КонецПроцедуры

