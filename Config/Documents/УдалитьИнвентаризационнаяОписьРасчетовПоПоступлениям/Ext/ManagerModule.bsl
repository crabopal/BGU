Функция СформироватьПечатнуюФорму0510468(Данные, СтрокаШапки, ОбластиМакета, ПечатныеФормыРасписок, ТиповыеПараметры)
	
	Перем ОписаниеСерииДокументов, СтрокаШапкиДокументаСРаспиской;
	
	КлючПараметровПечати = "ПечатьФормы0510468";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	// СерииДокументов
	ЭтоЗаголовочныйДокумент = ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(СтрокаШапки);
	ЭтоСодержательныйДокумент = ИнвентаризацияКлиентСервер.ЭтоСодержательныйДокументСерииДокументовОписи(СтрокаШапки);
	
	Если ЭтоЗаголовочныйДокумент Или ЭтоСодержательныйДокумент Тогда
		СтрокаШапкиДокументаСРаспиской = ИнвентаризацияСервер.ПолучитьСтрокуШапкиЗаголовочногоДокумента(Данные, СтрокаШапки, ОписаниеСерииДокументов);
	Иначе
		СтрокаШапкиДокументаСРаспиской = СтрокаШапки;
	КонецЕсли;
	// Конец СерииДокументов
	
	// РАСПИСКА
	
	ИнвентаризацияСервер.ВывестиПечатнуюФормуРасписки(ТабДокумент, СтрокаШапкиДокументаСРаспиской.Ссылка, ПечатныеФормыРасписок);
	
	// ЗАГОЛОВОК
	
	ЗначенияПараметров = Новый Структура();
	
	УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, СтрокаШапкиДокументаСРаспиской.Ссылка, Данные.СведенияУчреждений);
	
	ИнвентаризацияСервер.ЗаполнитьДатуНомерДокументаДляПечатиСерииДокументов(ЗначенияПараметров, СтрокаШапкиДокументаСРаспиской, СтрокаШапки);
	
	НомерРешенияОПроведенииИнвентаризации = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапкиДокументаСРаспиской.РешениеОПроведенииИнвентаризации,
		СтрокаШапкиДокументаСРаспиской.НомерРешенияОПроведенииИнвентаризации);
	
	ЗначенияПараметров.Вставить("НомерРешения",		НомерРешенияОПроведенииИнвентаризации);
	ЗначенияПараметров.Вставить("ДатаРешения",		СтрокаШапкиДокументаСРаспиской.ДатаРешенияОПроведенииИнвентаризации);
	ЗначенияПараметров.Вставить("НомерКомиссии",	ИнвентаризацияКлиентСервер.ФорматироватьПолныйНомерКомиссии(СтрокаШапкиДокументаСРаспиской.НомерКомиссии, СтрокаШапкиДокументаСРаспиской.НомерРабочейКомиссии, Истина));
	
	// СерииДокументов
	ИнвентаризацияСервер.ЗаполнитьБлокСведенийСерииДокументов(ЗначенияПараметров, СтрокаШапки);
	// Конец СерииДокументов
	
	Область = ОбластиМакета.Заголовок;
	Область.Параметры.Заполнить(СтрокаШапкиДокументаСРаспиской);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапкиДокументаСРаспиской.Дата, Истина));
	
	// СерииДокументов
	Если ЭтоЗаголовочныйДокумент Или ЭтоСодержательныйДокумент Тогда
		ИнвентаризацияСервер.ОбвестиЗаголовокСерииДокументов(Область);
	КонецЕсли;
	// Конец СерииДокументов
	
	ТабДокумент.Вывести(Область);
	
	// СерииДокументов
	ИнвентаризацияСервер.ОбвестиЗаголовокСерииДокументов(Область, Истина);
	// Конец СерииДокументов
	
	// РАЗДЕЛ 1
	
	ВывестиРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.ОтветственныйИсполнительБухгалтерскойСлужбы, СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель бухгалтерской службы'"));
	
	Область = ОбластиМакета.ОтветственныйИсполнительБезТелефона;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	
	Если Не ТабДокумент.ПроверитьВывод(Область) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 2
	
	ВывестиРаздел2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	// КОМИССИЯ
	
	ПараметрыВывода = УправлениеПечатьюБГУ.ПараметрыВыводаСоставаКомиссииПриПечати();
	ПараметрыВывода.ЗаголовокПредседателя			= НСтр("ru='Председатель комиссии:'");
	ПараметрыВывода.ЗаголовокПервогоРядовогоЧлена	= НСтр("ru='Члены комиссии:'");
	ПараметрыВывода.ПризнакРабочейКомиссии			= ЗначениеЗаполнено(СтрокаШапкиДокументаСРаспиской.НомерРабочейКомиссии);
	
	УправлениеПечатьюБГУ.ВывестиСоставКомиссииПриПечати(ТабДокумент, СтрокаШапкиДокументаСРаспиской.Ссылка, ОбластиМакета.ЧленКомиссии, Данные.СоставКомиссий, ПараметрыВывода);
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапкиДокументаСРаспиской.ОтветственныйИсполнитель, СтрокаШапкиДокументаСРаспиской.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель:'"));
	
	Область = ОбластиМакета.ОтветственныйИсполнительСТелефоном;
	Область.Параметры.Заполнить(СтрокаШапкиДокументаСРаспиской);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета)
	
	ТабДокумент.Вывести(ОбластиМакета.Раздел1Заголовок);
	
	ВывестиПодразделРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, "1");
	
	ВывестиПодразделРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, "2");
	
КонецПроцедуры

Процедура ВывестиПодразделРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборка = Данные.Выборки["Раздел1" + НомерПодразделаСтрокой];
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
	
	ПараметрыВыводаТаблицы.Области.Заголовок				= ОбластиМакета["Раздел1" + НомерПодразделаСтрокой + "Заголовок"];
	ПараметрыВыводаТаблицы.Области.ШапкаТаблицы				= ОбластиМакета["Раздел1" + НомерПодразделаСтрокой + "Шапка"];
	ПараметрыВыводаТаблицы.Области.СтрокаТаблицы			= ОбластиМакета["Раздел1" + НомерПодразделаСтрокой + "Строка"];
	ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами	= ОбластиМакета["Раздел1" + НомерПодразделаСтрокой + "Итого"];
	
	ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям.ЗаполнитьОбластьСтрокаТаблицы0510468_Раздел1";
	
	ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
	
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Истина;
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
	
	ПараметрыВыводаТаблицы.ДополнительныеПараметры = Данные.ДополнительныеПараметры;
	
	ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
	ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ОбщаяВыборка;
	
	ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
	
КонецПроцедуры

Процедура ВывестиРаздел2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета)
	
	ТабДокумент.Вывести(ОбластиМакета.Раздел2Заголовок);
	
	ВывестиПодразделРаздел2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, "1");
	
	ВывестиПодразделРаздел2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, "2");
	
КонецПроцедуры

Процедура ВывестиПодразделРаздел2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
	
	ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям.ЗаполнитьОбластьСтрокаТаблицы0510468_Раздел2";
	
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ОписаниеСтатусовЗадолженности", Данные.ДополнительныеПараметры.ОписаниеСтатусовЗадолженности);
	
	// Два набора колонок
	
	// Набор колонок №1
	
	ОбщаяВыборка = Данные.Выборки["Раздел2" + НомерПодразделаСтрокой];
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	ПараметрыВыводаТаблицы.Области.Заголовок				= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Заголовок"];
	ПараметрыВыводаТаблицы.Области.ШапкаТаблицы				= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Шапка1"];
	ПараметрыВыводаТаблицы.Области.СтрокаТаблицы			= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Строка1"];
	ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами	= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Итого1"];
	
	ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
	
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Истина;
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
	
	ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
	ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ОбщаяВыборка;
	
	ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
	
	ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
	
	ВывестиИтогиРаздела2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой, "1");
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	// Набор колонок №2
	
	ОбщаяВыборка = Данные.Выборки["Раздел2" + НомерПодразделаСтрокой];
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	ПараметрыВыводаТаблицы.Области.Заголовок				= Неопределено;
	ПараметрыВыводаТаблицы.Области.ШапкаТаблицы				= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Шапка2"];
	ПараметрыВыводаТаблицы.Области.СтрокаТаблицы			= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Строка2"];
	ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами	= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Итого2"];
	
	ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
	
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Истина;
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
	
	ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
	ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ОбщаяВыборка;
	
	ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
	
	ВывестиИтогиРаздела2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой, "2");
	
КонецПроцедуры

Процедура ВывестиИтогиРаздела2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой, НомерНабораДанныхСтрокой)
	
	ВывестиИтогиРаздела2ПоСчету(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой, НомерНабораДанныхСтрокой);
	
	ВывестиИтогиРаздела2ПоКонтрагенту(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой, НомерНабораДанныхСтрокой);
	
КонецПроцедуры

Процедура ВывестиИтогиРаздела2ПоСчету(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой, НомерНабораДанныхСтрокой)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборка = Данные.Выборки["ИтогиРаздела2" + НомерПодразделаСтрокой + "ПоСчету"];
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	КоличествоСтрок = Выборка.Количество();
	
	ОбластьПервая		= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Итого" + НомерНабораДанныхСтрокой + "ПоНомеруСчетаПервая"];
	ОбластьОчередная	= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Итого" + НомерНабораДанныхСтрокой + "ПоНомеруСчетаОчередная"];
	
	Если КоличествоСтрок = 0 Тогда
		ОчищающаяСтруктура = Новый Структура("
			|НомерСчета,
			|СуммаРуб,
			|СуммаПодтвержденаАктомСверкиРуб,
			|СуммаНеПодтвержденаАктомСверкиРуб");
		
		ОбластьПервая.Параметры.Заполнить(ОчищающаяСтруктура);
		
		ТабДокумент.Вывести(ОбластьПервая);
		
		Возврат;
	КонецЕсли;
	
	ЗначенияПараметров = Новый Структура("НомерСчета");
	
	НомерСтроки = 0;
	
	Пока Выборка.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		
		ЗначенияПараметров.НомерСчета =  ИнвентаризацияКлиентСервер.ПолучитьПолныйНомерСчета(
			Выборка.КПС, Выборка.КФО, Выборка.Счет, Выборка.КЭК,, Выборка.СчетУчетПоКПС, Выборка.СчетУчетПоКЭК);

		Область = ?(НомерСтроки = 1, ОбластьПервая, ОбластьОчередная);
		
		Область.Параметры.Заполнить(Выборка);
		Область.Параметры.Заполнить(ЗначенияПараметров);
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиИтогиРаздела2ПоКонтрагенту(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодразделаСтрокой, НомерНабораДанныхСтрокой)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборка = Данные.Выборки["ИтогиРаздела2" + НомерПодразделаСтрокой + "ПоКонтрагенту"];
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	КоличествоСтрок = Выборка.Количество();
	
	ОбластьЕдинственная	= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Итого" + НомерНабораДанныхСтрокой + "ПоКонтрагентуЕдинственная"];
	ОбластьПервая		= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Итого" + НомерНабораДанныхСтрокой + "ПоКонтрагентуПервая"];
	ОбластьОчередная	= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Итого" + НомерНабораДанныхСтрокой + "ПоКонтрагентуОчередная"];
	ОбластьПоследняя	= ОбластиМакета["Раздел2" + НомерПодразделаСтрокой + "Итого" + НомерНабораДанныхСтрокой + "ПоКонтрагентуПоследняя"];
	
	Если КоличествоСтрок = 0 Тогда
		ОчищающаяСтруктура = Новый Структура("
			|ИдентификаторКонтрагента,
			|НаименованиеКонтрагента,
			|СуммаРуб,
			|СуммаПодтвержденаАктомСверкиРуб,
			|СуммаНеПодтвержденаАктомСверкиРуб");
		
		ОбластьЕдинственная.Параметры.Заполнить(ОчищающаяСтруктура);
		
		ТабДокумент.Вывести(ОбластьЕдинственная);
		
		Возврат;
	КонецЕсли;
	
	НомерСтроки = 0;
	
	Пока Выборка.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		
		Если КоличествоСтрок = 1 Тогда
			Область = ОбластьЕдинственная;
			
		ИначеЕсли НомерСтроки = 1 Тогда
			Область = ОбластьПервая;
			
		ИначеЕсли НомерСтроки = КоличествоСтрок Тогда
			Область = ОбластьПоследняя;
			
		Иначе
			Область = ОбластьОчередная;
		КонецЕсли;
		
		Область.Параметры.Заполнить(Выборка);
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы0510468_Раздел1(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("КодСтроки", Выборка.НомерСтроки);
	ЗначенияПараметров.Вставить("НомерСчета", ИнвентаризацияКлиентСервер.ПолучитьПолныйНомерСчета(
		Выборка.КПС, Выборка.КФО, Выборка.Счет, Выборка.КЭК,, Выборка.СчетУчетПоКПС, Выборка.СчетУчетПоКЭК));
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы0510468_Раздел2(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ОписаниеСтатусаЗадолженности = ДополнительныеПараметры.ОписаниеСтатусовЗадолженности.Получить(Выборка.СтатусЗадолженности);
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("КодСтроки", Выборка.НомерСтроки);
	ЗначенияПараметров.Вставить("НомерСчета", ИнвентаризацияКлиентСервер.ПолучитьПолныйНомерСчета(
		Выборка.КПС, Выборка.КФО, Выборка.Счет, Выборка.КЭК,, Выборка.СчетУчетПоКПС, Выборка.СчетУчетПоКЭК));
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ОписаниеСтатусаЗадолженности);
	
КонецПроцедуры

Функция ПолучитьОписаниеСтатусовЗадолженности()
	
	ИменаПолей = "КодСтатуса,НаименованиеСтатуса";
	
	ОписаниеСтатусаЗадолженности = Новый Структура(ИменаПолей);
	ОписаниеСтатусаЗадолженности.КодСтатуса = "";
	ОписаниеСтатусаЗадолженности.НаименованиеСтатуса = "";
	
	ОписаниеСтатусовЗадолженности = Новый Соответствие();
	ОписаниеСтатусовЗадолженности.Вставить(Перечисления.СтатусыЗадолженности.ПустаяСсылка(), ОписаниеСтатусаЗадолженности);
	
	МетаданныеЗначений = Метаданные.Перечисления.СтатусыЗадолженности.ЗначенияПеречисления;
	
	Для Каждого Элемент Из МетаданныеЗначений Цикл
		ОписаниеСтатусаЗадолженности = Новый Структура(ИменаПолей);
		
		ОписаниеСтатусаЗадолженности.КодСтатуса = СтрЗаменить(Элемент.Комментарий, "Код ", "");
		ОписаниеСтатусаЗадолженности.НаименованиеСтатуса = Элемент.Синоним;
		
		ОписаниеСтатусовЗадолженности.Вставить(Перечисления.СтатусыЗадолженности[Элемент.Имя], ОписаниеСтатусаЗадолженности);
	КонецЦикла;
	
	Возврат ОписаниеСтатусовЗадолженности;
	
КонецФункции

