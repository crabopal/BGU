Процедура ДозаполнитьТаблицуЗадолженностиПоДаннымБухУчета(ТаблицаЗадолженности, ВидЗадолженности, ПараметрыПроцедуры, ПараметрыПоиска, СчетаРасчетовКИСЕ)
	
	СоответствиеСчетов = УчетРасчетов.СоответствиеСчетовАвансовСчетамРасчетов("302.00", ПараметрыПроцедуры.ДатаИнвентаризации, ПараметрыПроцедуры.Организация);
	
	// Соответствие счетов 206.00 - 302.00.
	СоответствующиеСчетаРасчетов = Новый Соответствие();
	
	Для Каждого Элемент Из СоответствиеСчетов Цикл
		СоответствующиеСчетаРасчетов.Вставить(Элемент.Значение, Элемент.Ключ);
	КонецЦикла;
	
	Если ПараметрыПроцедуры.ДатаИнвентаризации >= Дата(2020,12,31) Тогда
		ИнвентаризацияСервер.ЗаполнитьКЭКОстатков(ТаблицаЗадолженности, СчетаРасчетовКИСЕ);
	КонецЕсли;
	
	ПараметрыЗаполнения = ИнвентаризацияСервер.ПараметрыЗаполненияДолгосрочнойЗадолженностиИнвентаризации61н();
	ПараметрыЗаполнения.ВидЗадолженности				= ВидЗадолженности;
	ПараметрыЗаполнения.ПараметрыПоиска					= ПараметрыПоиска; 
	ПараметрыЗаполнения.СоответствующиеСчетаРасчетов	= СоответствующиеСчетаРасчетов;
	
	ИнвентаризацияСервер.ЗаполнитьДолгосрочнуюЗадолженностьИнвентаризации61н(ТаблицаЗадолженности, ПараметрыПроцедуры, ПараметрыЗаполнения);
	
	ЗаполнитьИдентификаторыКонтрагентов(ТаблицаЗадолженности);
	
КонецПроцедуры

Процедура ЗаполнитьИдентификаторыКонтрагентов(ТаблицаЗадолженности)
	
	Если ТаблицаЗадолженности.Колонки.Найти("ИдентификаторКонтрагента") = Неопределено Тогда
		ТаблицаЗадолженности.Колонки.Добавить("ИдентификаторКонтрагента", ОбщегоНазначения.ОписаниеТипаСтрока(22));
	КонецЕсли;
	
	ВремТЗ = ТаблицаЗадолженности.Скопировать(, "Контрагент");
	ВремТЗ.Свернуть("Контрагент");
	СписокКонтрагентов = ВремТЗ.ВыгрузитьКолонку("Контрагент");
	
	ИдентификаторыКонтрагентов = БухгалтерскийУчет.ИдентификаторыКонтрагентов(СписокКонтрагентов);
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗадолженности Цикл
		СтрокаТаблицы.ИдентификаторКонтрагента = ИдентификаторыКонтрагентов.Получить(СтрокаТаблицы.Контрагент);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРаздела2

Процедура ДобавитьСтрокиПоСтатусуЗадолженности(ТаблицаЗадолженности)
	
	// Все суммы считаем не подтвержденными актом сверки.
	
	ТипСумма = ОбщегоНазначения.ОписаниеТипаЧисло(18, 2, ДопустимыйЗнак.Любой);
	
	ТаблицаЗадолженности.Колонки.Добавить("ИдентификаторСтроки",				ОбщегоНазначения.ОписаниеТипаСтрока(36));
	ТаблицаЗадолженности.Колонки.Добавить("СтатусЗадолженности",				Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыЗадолженности"));
	ТаблицаЗадолженности.Колонки.Добавить("СуммаНеПодтвержденаАктомСверкиВал",	ТипСумма);
	ТаблицаЗадолженности.Колонки.Добавить("СуммаНеПодтвержденаАктомСверкиРуб",	ТипСумма);
	
	СтатусЗадолженностиДолгосрочная = Перечисления.СтатусыЗадолженности.Долгосрочная;
	СтатусЗадолженностиПросроченная = Перечисления.СтатусыЗадолженности.Просроченная;
	
	ТаблицаНовыеСтроки = ТаблицаЗадолженности.СкопироватьКолонки();
	ТаблицаНовыеСтроки.Колонки.Добавить("ИндексВставки", ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный));
	
	ОчищающаяСтруктура = Новый Структура("
		|ДолгосрочнаяВал,
		|ДолгосрочнаяРуб,
		|ПросроченнаяВал,
		|ПросроченнаяРуб");
	
	НовыеСтроки = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗадолженности Цикл
		Если СтрокаТаблицы.ДолгосрочнаяВал = 0 И СтрокаТаблицы.ДолгосрочнаяРуб = 0
			И СтрокаТаблицы.ПросроченнаяВал = 0 И СтрокаТаблицы.ПросроченнаяРуб = 0 Тогда
			СтрокаТаблицы.СуммаНеПодтвержденаАктомСверкиВал = СтрокаТаблицы.СуммаВал;
			СтрокаТаблицы.СуммаНеПодтвержденаАктомСверкиРуб = СтрокаТаблицы.СуммаРуб;
			
			Продолжить;
		КонецЕсли;
		
		ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
		
		Если СтрокаТаблицы.ДолгосрочнаяВал <> 0 Или СтрокаТаблицы.ДолгосрочнаяРуб <> 0 Тогда
			Если СтрокаТаблицы.ДолгосрочнаяВал = СтрокаТаблицы.СуммаВал И СтрокаТаблицы.ДолгосрочнаяРуб = СтрокаТаблицы.СуммаРуб Тогда
				// Сумма полностью является долгосрочной.
				// Разбивать такую строку не требуется.
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
				
				СтрокаТаблицы.СтатусЗадолженности = СтатусЗадолженностиДолгосрочная;
				СтрокаТаблицы.СуммаНеПодтвержденаАктомСверкиВал = СтрокаТаблицы.СуммаВал;
				СтрокаТаблицы.СуммаНеПодтвержденаАктомСверкиРуб = СтрокаТаблицы.СуммаРуб;
				
				Продолжить;
			КонецЕсли;
			
			// Добавляем новую строку.
			НоваяСтрока = ТаблицаНовыеСтроки.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОчищающаяСтруктура);
			
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			НоваяСтрока.СтатусЗадолженности = СтатусЗадолженностиДолгосрочная;
			НоваяСтрока.ИндексВставки = СтрокаТаблицы.НомерСтроки; // Вставка после исходной строки.
			
			НоваяСтрока.СуммаВал = СтрокаТаблицы.ДолгосрочнаяВал;
			НоваяСтрока.СуммаРуб = СтрокаТаблицы.ДолгосрочнаяРуб;
			
			НоваяСтрока.СуммаНеПодтвержденаАктомСверкиВал = НоваяСтрока.СуммаВал;
			НоваяСтрока.СуммаНеПодтвержденаАктомСверкиРуб = НоваяСтрока.СуммаРуб;
			
			// Уменьшаем сумму в исходной строке.
			СтрокаТаблицы.СуммаВал = СтрокаТаблицы.СуммаВал - СтрокаТаблицы.ДолгосрочнаяВал;
			СтрокаТаблицы.СуммаРуб = СтрокаТаблицы.СуммаРуб - СтрокаТаблицы.ДолгосрочнаяРуб;
		КонецЕсли;
		
		Если СтрокаТаблицы.ПросроченнаяВал <> 0 Или СтрокаТаблицы.ПросроченнаяРуб <> 0 Тогда
			Если СтрокаТаблицы.ПросроченнаяВал = СтрокаТаблицы.СуммаВал И СтрокаТаблицы.ПросроченнаяРуб = СтрокаТаблицы.СуммаРуб Тогда
				// Сумма полностью является просроченной.
				// Разбивать такую строку не требуется.
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
				
				СтрокаТаблицы.СтатусЗадолженности = СтатусЗадолженностиПросроченная;
				СтрокаТаблицы.СуммаНеПодтвержденаАктомСверкиВал = СтрокаТаблицы.СуммаВал;
				СтрокаТаблицы.СуммаНеПодтвержденаАктомСверкиРуб = СтрокаТаблицы.СуммаРуб;
				
				Продолжить;
			КонецЕсли;
			
			// Добавляем новую строку.
			НоваяСтрока = ТаблицаНовыеСтроки.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОчищающаяСтруктура);
			
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			НоваяСтрока.СтатусЗадолженности = СтатусЗадолженностиПросроченная;
			НоваяСтрока.ИндексВставки = СтрокаТаблицы.НомерСтроки; // Вставка после исходной строки.
			
			НоваяСтрока.СуммаВал = СтрокаТаблицы.ПросроченнаяВал;
			НоваяСтрока.СуммаРуб = СтрокаТаблицы.ПросроченнаяРуб;
			
			НоваяСтрока.СуммаНеПодтвержденаАктомСверкиВал = НоваяСтрока.СуммаВал;
			НоваяСтрока.СуммаНеПодтвержденаАктомСверкиРуб = НоваяСтрока.СуммаРуб;
			
			// Уменьшаем сумму в исходной строке.
			СтрокаТаблицы.СуммаВал = СтрокаТаблицы.СуммаВал - СтрокаТаблицы.ПросроченнаяВал;
			СтрокаТаблицы.СуммаРуб = СтрокаТаблицы.СуммаРуб - СтрокаТаблицы.ПросроченнаяРуб;
		КонецЕсли;
		
		СтрокаТаблицы.СуммаНеПодтвержденаАктомСверкиВал = СтрокаТаблицы.СуммаВал;
		СтрокаТаблицы.СуммаНеПодтвержденаАктомСверкиРуб = СтрокаТаблицы.СуммаРуб;
		СтрокаТаблицы.ИдентификаторСтроки = ИдентификаторСтроки;
	КонецЦикла;
	
	КоличествоСтрок = ТаблицаНовыеСтроки.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		ИндексСтроки = КоличествоСтрок - Счетчик;
		
		ДобавленнаяСтрока = ТаблицаНовыеСтроки[ИндексСтроки];
		
		НоваяСтрока = ТаблицаЗадолженности.Вставить(ДобавленнаяСтрока.ИндексВставки);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДобавленнаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область РазбивкаСтрокиРаздела2

Функция ПолучитьПустуюСтруктуруСтрокиРаздела2()
	
	Возврат Новый Структура("
		// Колонки табличной части
		|НомерСтроки,
		|Контрагент,
		|ИдентификаторКонтрагента,
		|Договор,
		|Счет,
		|КПС,
		|КЭК,
		|КФО,
		|ИФО,
		|Валюта,
		|СуммаРуб,
		|СуммаВал,
		|ИдентификаторСтроки,
		|ДатаИсполнения,
		|СтатусЗадолженности");
		
КонецФункции

Функция ПолучитьФрагментыРазбитойСтроки(ТаблицаРаздела, ТекДанные)
	
	Поиск = Новый Структура("ИдентификаторСтроки", ТекДанные.ИдентификаторСтроки);
	
	ФрагментыСтроки = ТаблицаРаздела.Выгрузить(Поиск);
	
	ФрагментыСтроки.Сортировать("НомерСтроки");
	
	Возврат ФрагментыСтроки;
	
КонецФункции

Функция СобратьИсходнуюСтрокуРаздела2ПоФрагментам(ФрагментыСтроки)
	
	СтруктураИсходнойСтроки = ПолучитьПустуюСтруктуруСтрокиРаздела2();
	
	ЗаполнитьЗначенияСвойств(СтруктураИсходнойСтроки, ФрагментыСтроки[0]);
	
	СтруктураИсходнойСтроки.СуммаВал = ФрагментыСтроки.Итог("СуммаВал");
	СтруктураИсходнойСтроки.СуммаРуб = ФрагментыСтроки.Итог("СуммаРуб");
	
	Возврат СтруктураИсходнойСтроки;
	
КонецФункции

#КонецОбласти

#Область Печать

Функция ПечатьФормы0510468(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	КлючПараметровПечати = "ПечатьФормы0510468";
	
	ОбщийТабДокумент = Новый ТабличныйДокумент();
	ОбщийТабДокумент.АвтоМасштаб = Истина;
	ОбщийТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ОбщийТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ТиповыеПараметры = Новый Структура();
	ТиповыеПараметры.Вставить("МассивОбъектов",			МассивОбъектов);
	ТиповыеПараметры.Вставить("ПараметрыПечати",		ПараметрыПечати);
	ТиповыеПараметры.Вставить("КоллекцияПечатныхФорм",	КоллекцияПечатныхФорм);
	ТиповыеПараметры.Вставить("ОбъектыПечати",			ОбъектыПечати);
	ТиповыеПараметры.Вставить("ПараметрыВывода",		ПараметрыВывода);
	
	Данные = ПолучитьДанныеДляПечати0510468(МассивОбъектов);
	
	
	
	// СерииДокументов
	ПечатныеФормыРасписок = Документы.РаспискаИнвентаризации.ПолучитьПечатныеФормыРасписокДляОписей(Данные.СерииДокументовДляПечати.ДополненныйМассивОбъектов);
	
	//ПечатныеФормыРасписок = Документы.РаспискаИнвентаризации.ПолучитьПечатныеФормыРасписокДляОписей(МассивОбъектов);
	// Конец СерииДокументов
	
	
	ОбластиМакета = ПолучитьОбластиМакета0510468();
	
	ПервыйДокумент = Истина;
	
	ВыборкаШапка = Данные.Выборки.Шапки;
	
	Пока ВыборкаШапка.Следующий() Цикл
		Если МассивОбъектов.Найти(ВыборкаШапка.Ссылка) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТабДокумент = СформироватьПечатнуюФорму0510468(Данные, ВыборкаШапка, ОбластиМакета, ПечатныеФормыРасписок, ТиповыеПараметры);
		
		Если Не ПервыйДокумент Тогда
			ОбщийТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НомерСтрокиНачало = ОбщийТабДокумент.ВысотаТаблицы + 1;
		
		ОбщийТабДокумент.Вывести(ТабДокумент);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ОбщийТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.Ссылка);
			
		ПервыйДокумент = Ложь;
	КонецЦикла;
	
	// Колонтитулы
	ОбщийТабДокумент.ВерхнийКолонтитул.Выводить				= Истина;
	ОбщийТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница	= 2;
	ОбщийТабДокумент.ВерхнийКолонтитул.ТекстСправа			= НСтр("ru='Форма 0510468 с.[&НомерСтраницы]'");
	
	Возврат ОбщийТабДокумент;
	
КонецФункции

Функция ПолучитьОбластиМакета0510468()
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям.ПФ_MXL_Ф0510468");
	
	ОбластиМакета = Новый Структура();
	ОбластиМакета.Вставить("Заголовок",									Макет.ПолучитьОбласть("Заголовок"));

	ОбластиМакета.Вставить("Раздел1Заголовок",							Макет.ПолучитьОбласть("Раздел1Заголовок"));

