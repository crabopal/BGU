#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Форма 0317012
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0317012";
	КомандаПечати.Представление = НСтр("ru='Акт инвентаризации расходов будущих периодов (ф. 0317012)'");
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0317012") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Форма0317012",
			"АКТ инвентаризации расходов будущих периодов (ф. 0317012)",
			ПечатьФормы0317012(МассивОбъектов, ОбъектыПечати));
			
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьФормы0317012(МассивОбъектов, ОбъектыПечати)
	
	// Возвращаемый таб.документ
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = "ИнвентаризацияРасходовБудущихПериодов_ПечатьФормы0317012";
	
	// Используемый макет
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ИнвентаризацияРБП_0317012");

	ЗапросПечать = Новый Запрос();
	ЗапросПечать.УстановитьПараметр("МассивСсылок", МассивОбъектов);
	ЗапросПечать.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка КАК ДокСсылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата,
	|	Док.ДатаИнвентаризации КАК ДатаИнвентаризации,
	|	Док.Организация КАК Организация,
	|	Док.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	|	Док.Подразделение.Наименование КАК НаименованиеПодразделения,
	|	Док.Организация.КодОКПО КАК КодОКПО,
	|	Док.Счет.Представление КАК СчетПредставление,
	|	Док.Счет.Забалансовый КАК СчетЗабалансовый,
	|	Док.КФО КАК КФО,
	|	Док.НомерПриказаИнвентаризации КАК ДокументОснованиеНомер,
	|	Док.ДатаПриказаИнвентаризации КАК ДокументОснованиеДата,
	|	Док.МестоИнвентаризации КАК МестоИнвентаризации,
	|	Док.ДатаНачала КАК ДатаНачалаИнвентаризации,
	|	Док.ДатаОкончания КАК ДатаОкончанияИнвентаризации,
	|	Док.ДолжностьПредседателяКомиссии КАК ДолжностьПредседателяКомиссии,
	|	Док.ФамилияПредседателяКомиссии КАК ФамилияПредседателяКомиссии,
	|	Док.ИмяПредседателяКомиссии КАК ИмяПредседателяКомиссии,
	|	Док.ОтчествоПредседателяКомиссии КАК ОтчествоПредседателяКомиссии,
	|	Док.МОЛ КАК МОЛ
	|ИЗ
	|	Документ.ИнвентаризацияРасходовБудущихПериодов КАК Док
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка КАК ДокСсылка,
	|	ТЧ.ДолжностьЧленаКомиссии КАК ДолжностьЧленаКомиссии,
	|	ТЧ.ФамилияЧленаКомиссии КАК ФамилияЧленаКомиссии,
	|	ТЧ.ИмяЧленаКомиссии КАК ИмяЧленаКомиссии,
	|	ТЧ.ОтчествоЧленаКомиссии КАК ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ИнвентаризацияРасходовБудущихПериодов.СоставКомиссии КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка В(&МассивСсылок)
	|ИТОГИ ПО
	|	ДокСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка КАК ДокСсылка,
	|	ТЧ.НомерСтроки КАК НомерСтроки,
	|	ТЧ.СтатьяРБП.Код КАК ВидРасходовКод,
	|	ТЧ.СтатьяРБП.Наименование КАК ВидРасходовНаименование,
	|	ТЧ.ОбщаяПервоначальнаяСумма КАК ОбщаяПервоначальнаяСумма,
	|	ТЧ.ДатаВозникновенияРасходов КАК ДатаВозникновенияРасходов,
	|	ТЧ.СрокПогашенияРасходов КАК СрокПогашенияРасходов,
	|	ТЧ.РасчетнаяСуммаКСписанию КАК РасчетнаяСуммаКСписанию,
	|	ТЧ.СписаноДоНачалаИнвентаризации КАК СписаноДоНачалаИнвентаризации,
	|	ТЧ.ОстатокПоДаннымУчета КАК ОстатокПоДаннымУчета,
	|	ТЧ.МесяцевСоДняВозникновения КАК МесяцевСоДняВозникновения,
	|	ТЧ.ПодлежитСписаниюМесяц КАК ПодлежитСписаниюМесяц,
	|	ТЧ.ПодлежитСписаниюГод КАК ПодлежитСписаниюГод,
	|	ТЧ.РасчетныйОстаток КАК РасчетныйОстаток,
	|	ТЧ.ПодлежитДосписанию КАК ПодлежитДосписанию,
	|	ТЧ.ИзлишнеСписано КАК ИзлишнеСписано
	|ПОМЕСТИТЬ ТаблицаДанных
	|ИЗ
	|	Документ.ИнвентаризацияРасходовБудущихПериодов.РасходыБудущихПериодов КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка В(&МассивСсылок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДанных.ДокСсылка КАК ДокСсылка,
	|	ТаблицаДанных.НомерСтроки КАК НомерСтроки,
	|	ТаблицаДанных.ВидРасходовКод КАК ВидРасходовКод,
	|	ТаблицаДанных.ВидРасходовНаименование КАК ВидРасходовНаименование,
	|	ТаблицаДанных.ОбщаяПервоначальнаяСумма КАК ОбщаяПервоначальнаяСумма,
	|	ТаблицаДанных.ДатаВозникновенияРасходов КАК ДатаВозникновенияРасходов,
	|	ТаблицаДанных.СрокПогашенияРасходов КАК СрокПогашенияРасходов,
	|	ТаблицаДанных.РасчетнаяСуммаКСписанию КАК РасчетнаяСуммаКСписанию,
	|	ТаблицаДанных.СписаноДоНачалаИнвентаризации КАК СписаноДоНачалаИнвентаризации,
	|	ТаблицаДанных.ОстатокПоДаннымУчета КАК ОстатокПоДаннымУчета,
	|	ТаблицаДанных.МесяцевСоДняВозникновения КАК МесяцевСоДняВозникновения,
	|	ТаблицаДанных.ПодлежитСписаниюМесяц КАК ПодлежитСписаниюМесяц,
	|	ТаблицаДанных.ПодлежитСписаниюГод КАК ПодлежитСписаниюГод,
	|	ТаблицаДанных.РасчетныйОстаток КАК РасчетныйОстаток,
	|	ТаблицаДанных.ПодлежитДосписанию КАК ПодлежитДосписанию,
	|	ТаблицаДанных.ИзлишнеСписано КАК ИзлишнеСписано
	|ИЗ
	|	ТаблицаДанных КАК ТаблицаДанных
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаДанных.ДокСсылка,
	|	ТаблицаДанных.НомерСтроки
	|ИТОГИ
	|	СУММА(ОбщаяПервоначальнаяСумма),
	|	СУММА(РасчетнаяСуммаКСписанию),
	|	СУММА(СписаноДоНачалаИнвентаризации),
	|	СУММА(ОстатокПоДаннымУчета),
	|	СУММА(МесяцевСоДняВозникновения),
	|	СУММА(ПодлежитСписаниюМесяц),
	|	СУММА(ПодлежитСписаниюГод),
	|	СУММА(РасчетныйОстаток),
	|	СУММА(ПодлежитДосписанию),
	|	СУММА(ИзлишнеСписано)
	|ПО
	|	ДокСсылка";
	
	Результаты = ЗапросПечать.ВыполнитьПакет();
	
	// [0]. Шапки документов
	ВыборкаШапка = Результаты[0].Выбрать();
	
	// [1]. Таблицы инвентаризационных комиссий
	ВыборкаДокКомиссия = Результаты[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// [3]. Таблицы документов
	ВыборкаДокДанные = Результаты[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	// Выборки по документам
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		// Используемые области макета
		ОбластьШапка				= Макет.ПолучитьОбласть("Шапка");
		ОбластьЗаголовокТаблицы		= Макет.ПолучитьОбласть("ЗаголовокТаблицы");
		ОбластьСтрокаТаблицы		= Макет.ПолучитьОбласть("СтрокаТаблицы");
		ОбластьИтогоПоСтранице 		= Макет.ПолучитьОбласть("ИтогоПоСтранице");
		ОбластьИтогоПоСтраницеЗаг 	= Макет.ПолучитьОбласть("ИтогоПоСтраницеЗаг");
		ОбластьИтогоПоОписиЧисло	= Макет.ПолучитьОбласть("ИтогоПоОписиЧисло");
		ОбластьПустаяСтрока 		= Макет.ПолучитьОбласть("ПустаяСтрока");
		ОбластьКомиссия 			= Макет.ПолучитьОбласть("Комиссия");
		//ОбластьПолеДаты 			= Макет.ПолучитьОбласть("ПолеДаты");
		ОбластьПримечание 			= Макет.ПолучитьОбласть("Примечание");
		ОбластьПодписьМОЛ 			= Макет.ПолучитьОбласть("ПодписьМОЛ");
		ОбластьПроверкаПодпись		= Макет.ПолучитьОбласть("ПроверкаПодпись");
		
		// Продвигаемся в остальных выборках до текущего документа
		ПоискТекущегоДокумента = Новый Структура("ДокСсылка", ВыборкаШапка["ДокСсылка"]);
		ВыборкаДокКомиссия.Сбросить();
		ВыборкаДокДанные.Сбросить();
		ЕстьВыборкаДокКомиссия				= ВыборкаДокКомиссия.НайтиСледующий(ПоискТекущегоДокумента);
		ЕстьВыборкаДокДанные				= ВыборкаДокДанные.НайтиСледующий(ПоискТекущегоДокумента);
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		ОбщееКоличествоПорядковыхНомеров = 0;
		
		//---------------------
		// с.1, Титульный лист
		//---------------------
		НомерСтраницы = 1;
		
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("НомерДокумента",		РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
			ВыборкаШапка.ДокСсылка,
			ВыборкаШапка.Номер));
		ЗначенияПараметров.Вставить("ДатаДокумента",		Формат(ВыборкаШапка.Дата, "ДФ=""дд ММММ гггг 'г.'"""));
		ЗначенияПараметров.Вставить("ДатаИнвентаризации",	Формат(ВыборкаШапка.ДатаИнвентаризации, "ДФ=""дд ММММ гггг 'г.'"""));
		
		ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
		ОбластьШапка.Параметры.Заполнить(ЗначенияПараметров);
		
		ТабДокумент.Вывести(ОбластьШапка);
		
		//-----------------------------
		// с.2 и далее, Таблица док-та
		//-----------------------------
		//---
		// Шапка таблицы
		//---
		ТабДокумент.Вывести(ОбластьЗаголовокТаблицы);
		
		// Статистика по странице
		ИтогоПоСтранице = ПолучитьСтруктуруИтоговПоСтранице();
		ТекущаяСтрока	= 0;
		
		Если ЕстьВыборкаДокДанные Тогда
			ВыборкаДанные = ВыборкаДокДанные.Выбрать();
			ОбщееКоличествоПорядковыхНомеров = ВыборкаДанные.Количество();
			Пока ВыборкаДанные.Следующий() Цикл
		
				ОбластьСтрокаТаблицы.Параметры.Заполнить(ВыборкаДанные);
				ТекущаяСтрока = ТекущаяСтрока + 1;
				
				// Выводимые одновременно на страницу области
				МассивОбластей = Новый Массив();
				МассивОбластей.Добавить(ОбластьСтрокаТаблицы);
				МассивОбластей.Добавить(ОбластьИтогоПоСтранице);
				Если ТекущаяСтрока = ОбщееКоличествоПорядковыхНомеров Тогда
					МассивОбластей.Добавить(ОбластьИтогоПоОписиЧисло);
				КонецЕсли;
				МассивОбластей.Добавить(ОбластьИтогоПоСтраницеЗаг);
				
				// Все области помещаются на лист?
				Если НЕ ТабДокумент.ПроверитьВывод(МассивОбластей) Тогда
					
					//---
					// Итого по странице
					//---
					ИспользуемыеОбласти = Новый Структура();
					ИспользуемыеОбласти.Вставить("ОбластьИтогоПоСтранице",			ОбластьИтогоПоСтранице);
					ИспользуемыеОбласти.Вставить("ОбластьИтогиЗаголовок",			ОбластьИтогоПоСтраницеЗаг);
					ИспользуемыеВыборки = Новый Структура();
					ВывестиИтогиПоСтранице(ТабДокумент, ИспользуемыеОбласти, ИспользуемыеВыборки, ИтогоПоСтранице);
					
					ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					
					ТабДокумент.Вывести(ОбластьЗаголовокТаблицы);
				КонецЕсли;
				
				//---
				// Строка таблицы
				//---
				ТабДокумент.Вывести(ОбластьСтрокаТаблицы);
				
				// Статистика по странице
				ИтогоПоСтранице["ОбщаяПервоначальнаяСумма"]			= ИтогоПоСтранице["ОбщаяПервоначальнаяСумма"]		+ ВыборкаДанные["ОбщаяПервоначальнаяСумма"];
				ИтогоПоСтранице["РасчетнаяСуммаКСписанию"]			= ИтогоПоСтранице["РасчетнаяСуммаКСписанию"]		+ ВыборкаДанные["РасчетнаяСуммаКСписанию"];
				ИтогоПоСтранице["СписаноДоНачалаИнвентаризации"]	= ИтогоПоСтранице["СписаноДоНачалаИнвентаризации"]	+ ВыборкаДанные["СписаноДоНачалаИнвентаризации"];
				ИтогоПоСтранице["ОстатокПоДаннымУчета"]				= ИтогоПоСтранице["ОстатокПоДаннымУчета"]			+ ВыборкаДанные["ОстатокПоДаннымУчета"];
				ИтогоПоСтранице["ПодлежитСписаниюМесяц"]			= ИтогоПоСтранице["ПодлежитСписаниюМесяц"]			+ ВыборкаДанные["ПодлежитСписаниюМесяц"];
				ИтогоПоСтранице["ПодлежитСписаниюГод"]				= ИтогоПоСтранице["ПодлежитСписаниюГод"]			+ ВыборкаДанные["ПодлежитСписаниюГод"];
				ИтогоПоСтранице["РасчетныйОстаток"]					= ИтогоПоСтранице["РасчетныйОстаток"]				+ ВыборкаДанные["РасчетныйОстаток"];
				ИтогоПоСтранице["ПодлежитДосписанию"]				= ИтогоПоСтранице["ПодлежитДосписанию"]				+ ВыборкаДанные["ПодлежитДосписанию"];
				ИтогоПоСтранице["ИзлишнеСписано"]					= ИтогоПоСтранице["ИзлишнеСписано"]					+ ВыборкаДанные["ИзлишнеСписано"];
				
			КонецЦикла;	
		КонецЕсли;
		
		//---
		// Итого по странице, включая строку итогов по всей описи
		//---
		ИспользуемыеОбласти = Новый Структура();
		ИспользуемыеОбласти.Вставить("ОбластьИтогоПоСтранице",			ОбластьИтогоПоСтранице);
		ИспользуемыеОбласти.Вставить("ОбластьИтогиЗаголовок",			ОбластьИтогоПоСтраницеЗаг);
		ИспользуемыеОбласти.Вставить("ОбластьИтогоПоОписиЧисло",		ОбластьИтогоПоОписиЧисло);
		ИспользуемыеВыборки = Новый Структура();
		ИспользуемыеВыборки.Вставить("ВыборкаДокДанные",				ВыборкаДокДанные);
		ВывестиИтогиПоСтранице(ТабДокумент, ИспользуемыеОбласти, ИспользуемыеВыборки, ИтогоПоСтранице);
		
		//---
		// Инвентаризационная комиссия
		//---
		
		ОбластьВсяКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(
			ВыборкаШапка,
			ВыборкаДокКомиссия.Выбрать(), 
			ОбластьКомиссия, 
			3);
		
		ТабДокумент.Вывести(ОбластьВсяКомиссия);
		//ТабДокумент.Вывести(ОбластьПолеДаты);
		
		ОбластьПримечание.Параметры.ДатаНачалаИнвентаризации = Формат(ВыборкаШапка.ДатаНачалаИнвентаризации, "ДФ=""дд ММММ гггг 'г.'""");
		ОбластьПримечание.Параметры.ДатаОкончанияИнвентаризации = Формат(ВыборкаШапка.ДатаОкончанияИнвентаризации, "ДФ=""дд ММММ гггг 'г.'""");
		ТабДокумент.Вывести(ОбластьПримечание);
				
		//
		// МОЛ
		//
		ОписаниеМОЛ = ИнвентаризацияСервер.ПолучитьОписаниеМОЛ(ВыборкаШапка);
		
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("МОЛДолжность",				ОписаниеМОЛ.МОЛДолжность);
		ЗначенияПараметров.Вставить("МОЛНаименование",			ОписаниеМОЛ.МОЛКраткоеФИО);
		ЗначенияПараметров.Вставить("МОЛНаименованиеПолное",	ОписаниеМОЛ.МОЛПолноеФИО);
		
		ОбластьПодписьМОЛ.Параметры.Заполнить(ЗначенияПараметров);
		
		ТабДокумент.Вывести(ОбластьПодписьМОЛ);
		//ТабДокумент.Вывести(ОбластьПолеДаты);
		
		ТабДокумент.Вывести(ОбластьПроверкаПодпись);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.ДокСсылка);
	КонецЦикла;
	
	Возврат ТабДокумент;
		
КонецФункции

Процедура ВывестиИтогиПоСтранице(ТабДокумент, ИспользуемыеОбласти, ИспользуемыеВыборки, СтруктураИтоговПоСтранице)
	
	ОбластьИтогоПоСтранице			= ИспользуемыеОбласти["ОбластьИтогоПоСтранице"];
	ВыборкаДокДанные				= Неопределено;
	
	//---
	// Итого по странице, числом
	//---
	ЗначенияПараметров = ПолучитьСтруктуруИтоговПоСтранице();
	ЗаполнитьЗначенияСвойств(ЗначенияПараметров, СтруктураИтоговПоСтранице);
	ОбластьИтогоПоСтранице.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(ОбластьИтогоПоСтранице);
	
	//---
	// Итого по всей описи, числом
	//---
	Если ИспользуемыеВыборки.Свойство("ВыборкаДокДанные", ВыборкаДокДанные) Тогда
		ОбластьИтогоПоОписиЧисло = ИспользуемыеОбласти["ОбластьИтогоПоОписиЧисло"];
		ВыборкаЗаполнена = НЕ (ВыборкаДокДанные["ДокСсылка"] = Неопределено);
		ЗначенияПараметров = ПолучитьСтруктуруИтоговПоСтранице();
		Если ВыборкаЗаполнена Тогда
			ЗаполнитьЗначенияСвойств(ЗначенияПараметров, ВыборкаДокДанные);
		КонецЕсли;
		// Форматируем числа
		ОбластьИтогоПоОписиЧисло.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(ОбластьИтогоПоОписиЧисло);
	КонецЕсли;
	
	// Обнуляем статистику по странице:
	СтруктураИтоговПоСтранице = ПолучитьСтруктуруИтоговПоСтранице();

КонецПроцедуры

Функция ПолучитьСтруктуруИтоговПоСтранице()
	
	Результат = Новый Структура();
	
	Результат.Вставить("ОбщаяПервоначальнаяСумма",		0);
	Результат.Вставить("РасчетнаяСуммаКСписанию",		0);
	Результат.Вставить("СписаноДоНачалаИнвентаризации",	0);
	Результат.Вставить("ОстатокПоДаннымУчета",			0);
	Результат.Вставить("ПодлежитСписаниюМесяц",			0);
	Результат.Вставить("ПодлежитСписаниюГод",			0);
	Результат.Вставить("РасчетныйОстаток",				0);
	Результат.Вставить("ПодлежитДосписанию",			0);
	Результат.Вставить("ИзлишнеСписано",				0);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокумента

Процедура ЗаполнитьПоДаннымУчета(ДокументОбъект) Экспорт
	
	ЗапросОстатки = Новый Запрос();
	ЗапросОстатки.УстановитьПараметр("ДатаЗапроса",
		ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков52н(ДокументОбъект.ДатаИнвентаризации));
	
	Если ДокументОбъект.ДатаИнвентаризации >= ИнвентаризацияКлиентСервер.ПолучитьДатуНачалаОпределенияОстатковНаКонецПредыдущегоДня52н() Тогда
		ДатаИнвентаризации = КонецДня(НачалоДня(ДокументОбъект.ДатаИнвентаризации) - 1); // Конец предыдущего дня.
	Иначе
		ДатаИнвентаризации = ДокументОбъект.ДатаИнвентаризации;
	КонецЕсли;
	
	ЗапросОстатки.УстановитьПараметр("Организация",		ДокументОбъект["Организация"]);
	ЗапросОстатки.УстановитьПараметр("СчетаОстатков",	БухгалтерскийУчет.СписокСчетов(ДокументОбъект["Счет"]));
	ЗапросОстатки.УстановитьПараметр("ВидРБП",			ДокументОбъект["ВидРБП"]);
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасходыБудущихПериодов.Ссылка КАК Ссылка,
	|	РасходыБудущихПериодов.ВидРБП КАК ВидРБП,
	|	РасходыБудущихПериодов.СпособПризнанияРасходов КАК СпособПризнанияРасходов,
	|	РасходыБудущихПериодов.ДатаНачалаСписания КАК ДатаНачалаСписания,
	|	РасходыБудущихПериодов.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
	|	РасходыБудущихПериодов.Сумма КАК ОбщаяПервоначальнаяСумма,
	|	РасходыБудущихПериодов.ДатаВозникновенияРасходов КАК ДатаВозникновенияРасходов
	|ПОМЕСТИТЬ СтатьиРБП
	|ИЗ
	|	Справочник.РасходыБудущихПериодов КАК РасходыБудущихПериодов
	|ГДЕ
	|	РасходыБудущихПериодов.ВидРБП = &ВидРБП
	|	И &ОтборПоРБП
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.РасходыБудущихПериодов) КАК СтатьяРБП,
	|	СУММА(Остатки.СуммаОстаток) КАК СуммаОстаток
	|ПОМЕСТИТЬ ОстаткиРБП
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаЗапроса,
	|			Счет В(&СчетаОстатков),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.РасходыБудущихПериодов),
	|			Организация = &Организация
	|				И Субконто1 В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						СтатьиРБП.Ссылка
	|					ИЗ
	|						СтатьиРБП)
	|				И ВЫБОР
	|					КОГДА &НакладыватьОтборПоИФО
	|						ТОГДА ИФО = &ИФО
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА &НакладыватьОтборПоКФО
	|						ТОГДА КФО = &КФО
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА &НакладыватьОтборПоКПС
	|						ТОГДА КПС = &КПС
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА &НакладыватьОтборПоПодразделению
	|						ТОГДА Подразделение = &Подразделение
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.РасходыБудущихПериодов)
	|
	|ИМЕЮЩИЕ
	|	НЕ СУММА(Остатки.СуммаОстаток) = 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СтатьяРБП
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиРБП.СтатьяРБП КАК СтатьяРБП,
	|	ОстаткиРБП.СуммаОстаток КАК ОстатокПоДаннымУчета,
	|	СтатьиРБП.ВидРБП КАК ВидРБП,
	|	СтатьиРБП.СпособПризнанияРасходов КАК СпособПризнанияРасходов,
	|	СтатьиРБП.ДатаНачалаСписания КАК ДатаНачалаСписания,
	|	СтатьиРБП.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
	|	СтатьиРБП.ОбщаяПервоначальнаяСумма КАК ОбщаяПервоначальнаяСумма,
	|	СтатьиРБП.ДатаВозникновенияРасходов КАК ДатаВозникновенияРасходов
	|ИЗ
	|	ОстаткиРБП КАК ОстаткиРБП
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтатьиРБП КАК СтатьиРБП
	|		ПО ОстаткиРБП.СтатьяРБП = СтатьиРБП.Ссылка";
	
	Если ЗначениеЗаполнено(ДокументОбъект.ГруппаРасходов) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоРБП",
			"РасходыБудущихПериодов.Родитель В ИЕРАРХИИ(&ГруппаРасходов)");
		ЗапросОстатки.УстановитьПараметр("ГруппаРасходов", ДокументОбъект["ГруппаРасходов"]);
	Иначе // Без органичения по группе РБП.
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоРБП", "Истина");
	КонецЕсли;
	
	ПараметрыНакладываемогоОтбора = ОпределитьПараметрыНакладываемогоОтбора(ДокументОбъект);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьУчетПоИФО",					ПараметрыНакладываемогоОтбора["ИспользоватьУчетПоИФО"]);
	ЗапросОстатки.УстановитьПараметр("НакладыватьОтборПоИФО",					ПараметрыНакладываемогоОтбора["НакладыватьОтборПоИФО"]);
	ЗапросОстатки.УстановитьПараметр("ИФО",										ДокументОбъект["ИФО"]);
	ЗапросОстатки.УстановитьПараметр("НакладыватьОтборПоКФО",					ПараметрыНакладываемогоОтбора["НакладыватьОтборПоКФО"]);
	ЗапросОстатки.УстановитьПараметр("КФО",										ДокументОбъект["КФО"]);
	ЗапросОстатки.УстановитьПараметр("НакладыватьОтборПоПодразделению",			ПараметрыНакладываемогоОтбора["НакладыватьОтборПоПодразделению"]);
	ЗапросОстатки.УстановитьПараметр("Подразделение",							ДокументОбъект["Подразделение"]);
	ЗапросОстатки.УстановитьПараметр("НакладыватьОтборПоКПС",					ПараметрыНакладываемогоОтбора["НакладыватьОтборПоКПС"]);
	ЗапросОстатки.УстановитьПараметр("КПС",										ДокументОбъект["КПС"]);
	
	ЗапросОстатки.Текст = ТекстЗапроса;
	
	ОстаткиРБП = ЗапросОстатки.Выполнить().Выгрузить();
	Для Каждого ОстатокРБП Из ОстаткиРБП Цикл
		
		НоваяСтрока = ДокументОбъект.РасходыБудущихПериодов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстатокРБП,
			"СтатьяРБП,ОстатокПоДаннымУчета,ДатаВозникновенияРасходов");
		
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("ОбщаяПервоначальнаяСумма", ОстатокРБП.ОбщаяПервоначальнаяСумма);
		ПараметрыРасчета.Вставить("СпособПризнанияРасходов",  ОстатокРБП.СпособПризнанияРасходов);
		ПараметрыРасчета.Вставить("ДатаНачалаСписания",       ОстатокРБП.ДатаНачалаСписания);
		ПараметрыРасчета.Вставить("ДатаОкончанияСписания",    ОстатокРБП.ДатаОкончанияСписания);
		ПараметрыРасчета.Вставить("ОстатокПоДаннымУчета",     ОстатокРБП.ОстатокПоДаннымУчета);
		ПараметрыРасчета.Вставить("ДатаИнвентаризации",       ДатаИнвентаризации);
		
		РассчитатьПоказателиВСтрокеДокумента(НоваяСтрока, ПараметрыРасчета);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РассчитатьПоказателиВСтрокеДокумента(СтрокаДокумента, ПараметрыРасчета, Знач ИзмененПоказатель = "") Экспорт
	
	РекурсивныйПересчетПоказателей = Новый Массив;
	
	ОбщаяПервоначальнаяСуммаИзвестна = ЗначениеЗаполнено(ПараметрыРасчета.ОбщаяПервоначальнаяСумма);
	
	Если ИзмененПоказатель = "" Тогда // Пересчет всех показателей.
		
		// Графа 4. Общая (первоначальная) сумма расходов.
		Если ОбщаяПервоначальнаяСуммаИзвестна Тогда
			СтрокаДокумента.ОбщаяПервоначальнаяСумма = ПараметрыРасчета.ОбщаяПервоначальнаяСумма;
		Иначе
			СтрокаДокумента.ОбщаяПервоначальнаяСумма = 0;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыРасчета.СпособПризнанияРасходов)
			И ЗначениеЗаполнено(ПараметрыРасчета.ДатаНачалаСписания)
			И ЗначениеЗаполнено(ПараметрыРасчета.ДатаОкончанияСписания)
			И ПараметрыРасчета.ДатаНачалаСписания <= ПараметрыРасчета.ДатаОкончанияСписания Тогда
			
			// Графа 6. Срок погашения расходов (в месяцах).
			СтрокаДокумента.СрокПогашенияРасходов = БухгалтерскийУчет.КоличествоМесяцевДнейМеждуДатами(
				ПараметрыРасчета.СпособПризнанияРасходов,
				ПараметрыРасчета.ДатаНачалаСписания,
				ПараметрыРасчета.ДатаОкончанияСписания);
			
			// Графа 10. Количество месяцев со дня возникновения расходов.
			СтрокаДокумента.МесяцевСоДняВозникновения = БухгалтерскийУчет.КоличествоМесяцевДнейМеждуДатами(
				ПараметрыРасчета.СпособПризнанияРасходов,
				ПараметрыРасчета.ДатаНачалаСписания,
				ПараметрыРасчета.ДатаИнвентаризации);
			
		Иначе
			СтрокаДокумента.СрокПогашенияРасходов = 0;
			СтрокаДокумента.МесяцевСоДняВозникновения = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИзмененПоказатель = "" // Пересчет всех показателей.
	 ИЛИ ИзмененПоказатель = "ОбщаяПервоначальнаяСумма"
	 ИЛИ ИзмененПоказатель = "МесяцевСоДняВозникновения"
	 ИЛИ ИзмененПоказатель = "СрокПогашенияРасходов" Тогда
		
		// Графа 7. Расчетная сумма к списанию.
		Если ЗначениеЗаполнено(СтрокаДокумента.СрокПогашенияРасходов)
			И ЗначениеЗаполнено(СтрокаДокумента.МесяцевСоДняВозникновения)
			И ОбщаяПервоначальнаяСуммаИзвестна Тогда
			// Расчет из предположения равномерности списания РБП на финансовый результат:
			// доля срока списания, которая уже прошла к моменту инвентаризации * общую сумму расходов.
			ДоляСрокаПогашения = Мин(СтрокаДокумента.МесяцевСоДняВозникновения / СтрокаДокумента.СрокПогашенияРасходов,  1);
			ДоляСрокаПогашения = ?(ДоляСрокаПогашения < 0, 0, ДоляСрокаПогашения); // Срок списания еще не начался.
			СтрокаДокумента.РасчетнаяСуммаКСписанию = ДоляСрокаПогашения * СтрокаДокумента.ОбщаяПервоначальнаяСумма;
		Иначе
			СтрокаДокумента.РасчетнаяСуммаКСписанию = 0; // Нет данных для расчета суммы к списанию.
		КонецЕсли;
		
		РекурсивныйПересчетПоказателей.Добавить("РасчетнаяСуммаКСписанию");
		
	КонецЕсли;
	
	Если ИзмененПоказатель = "" // Пересчет всех показателей.
	 ИЛИ ИзмененПоказатель = "ОбщаяПервоначальнаяСумма"
	 ИЛИ ИзмененПоказатель = "ОстатокПоДаннымУчета" Тогда
		
		// Графа 8. Списано (погашено) расходов до начала инвентаризации.
		Если ОбщаяПервоначальнаяСуммаИзвестна Тогда
			СтрокаДокумента.СписаноДоНачалаИнвентаризации = СтрокаДокумента.ОбщаяПервоначальнаяСумма - СтрокаДокумента.ОстатокПоДаннымУчета;
		Иначе
			СтрокаДокумента.СписаноДоНачалаИнвентаризации = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИзмененПоказатель = "" // Пересчет всех показателей.
	 ИЛИ ИзмененПоказатель = "ОбщаяПервоначальнаяСумма"
	 ИЛИ ИзмененПоказатель = "СрокПогашенияРасходов" Тогда
		
		Если СтрокаДокумента.МесяцевСоДняВозникновения > 0 Тогда // "Подлежит списанию" запоняем, только если начался срок списания РБП.
			
			// Графа 11. Подлежит списанию - за месяц.
			ПодлежитСписаниюЗаМесяцДень = ?(СтрокаДокумента.СрокПогашенияРасходов = 0, 0,
				СтрокаДокумента.ОбщаяПервоначальнаяСумма / СтрокаДокумента.СрокПогашенияРасходов);
			СтрокаДокумента.ПодлежитСписаниюМесяц = Окр(ПодлежитСписаниюЗаМесяцДень, 18, 2);
			
			// Графа 12. Подлежит списанию - с начала года.
			МесяцевДнейСНачалаГода = БухгалтерскийУчет.КоличествоМесяцевДнейМеждуДатами(
				ПараметрыРасчета.СпособПризнанияРасходов,
				Макс( ПараметрыРасчета.ДатаНачалаСписания, НачалоГода(ПараметрыРасчета.ДатаИнвентаризации) ),
				ПараметрыРасчета.ДатаИнвентаризации);
			СтрокаДокумента.ПодлежитСписаниюГод = МесяцевДнейСНачалаГода * ПодлежитСписаниюЗаМесяцДень;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИзмененПоказатель = "" // Пересчет всех показателей.
	 ИЛИ ИзмененПоказатель = "ОбщаяПервоначальнаяСумма"
	 ИЛИ ИзмененПоказатель = "РасчетнаяСуммаКСписанию" Тогда
		
		// Графа 13. Расчетный остаток расходов, подлежащий погашению в будущем периоде.
		СтрокаДокумента.РасчетныйОстаток = СтрокаДокумента.ОбщаяПервоначальнаяСумма - СтрокаДокумента.РасчетнаяСуммаКСписанию;
		
		РекурсивныйПересчетПоказателей.Добавить("РасчетныйОстаток");
		
	КонецЕсли;
	
	Если ИзмененПоказатель = "" // Пересчет всех показателей.
	 ИЛИ ИзмененПоказатель = "ОстатокПоДаннымУчета"
	 ИЛИ ИзмененПоказатель = "РасчетныйОстаток" Тогда
		
		// Графа 14. Подлежит досписанию.
		СтрокаДокумента.ПодлежитДосписанию = ?(СтрокаДокумента.ОстатокПоДаннымУчета > СтрокаДокумента.РасчетныйОстаток,
			СтрокаДокумента.ОстатокПоДаннымУчета - СтрокаДокумента.РасчетныйОстаток, 0);
		// Графа 15. Излишне списао (подлежит восстановлению).
		СтрокаДокумента.ИзлишнеСписано = ?(СтрокаДокумента.ОстатокПоДаннымУчета < СтрокаДокумента.РасчетныйОстаток,
			СтрокаДокумента.РасчетныйОстаток - СтрокаДокумента.ОстатокПоДаннымУчета, 0);
		
	КонецЕсли;
	
	// Рекурсивный пересчет связанных показателей.
	Если ИзмененПоказатель <> "" // Не требуется при расчете всех показателей.
		И РекурсивныйПересчетПоказателей.Количество() > 0 Тогда
		
		Для Каждого Показатель Из РекурсивныйПересчетПоказателей Цикл
			РассчитатьПоказателиВСтрокеДокумента(СтрокаДокумента, ПараметрыРасчета, Показатель);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьПараметрыНакладываемогоОтбора(ДокументОбъект)
	
	СвойстваДопустимыхСчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ДокументОбъект["Счет"]);
	
	ИспользоватьУчетПоИФО						= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям			= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	НакладыватьОтборПоКФО						= ЗначениеЗаполнено(ДокументОбъект["КФО"]);
	НакладыватьОтборПоИФО						= ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ДокументОбъект["ИФО"]);
	НакладыватьОтборПоКПС						= СвойстваДопустимыхСчетов["УчетПоКПС"] И ЗначениеЗаполнено(ДокументОбъект["КПС"]);
	НакладыватьОтборПоПодразделению				= ИспользоватьУчетПоПодразделениям И СвойстваДопустимыхСчетов["УчетПоПодразделениям"]
													И ЗначениеЗаполнено(ДокументОбъект["Подразделение"]);
	
	ПараметрыНакладываемогоОтбора = Новый Структура();
	ПараметрыНакладываемогоОтбора.Вставить("ИспользоватьУчетПоИФО",							ИспользоватьУчетПоИФО);
	ПараметрыНакладываемогоОтбора.Вставить("ИспользоватьУчетПоПодразделениям",				ИспользоватьУчетПоПодразделениям);
	ПараметрыНакладываемогоОтбора.Вставить("НакладыватьОтборПоКФО",							НакладыватьОтборПоКФО);
	ПараметрыНакладываемогоОтбора.Вставить("НакладыватьОтборПоИФО",							НакладыватьОтборПоИФО);
	ПараметрыНакладываемогоОтбора.Вставить("НакладыватьОтборПоКПС",							НакладыватьОтборПоКПС);
	ПараметрыНакладываемогоОтбора.Вставить("НакладыватьОтборПоПодразделению",				НакладыватьОтборПоПодразделению);
	
	Возврат ПараметрыНакладываемогоОтбора;
	
КонецФункции

