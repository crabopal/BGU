&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ИнициализироватьФорму();
	
	Если Объект.Ссылка.Пустая() Тогда
		
		// Этот документ создан копированием?
		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			// Это копия существующего документа
			
			// Очищаем некоторые реквизиты
			Объект["РасходыБудущихПериодов"].Очистить();
			
			// Выводим сообщение:
			ТекстСообщения = НСтр("ru='Этот документ был создан путем копирования другого документа. Поэтому некоторые табличные части и реквизиты копии были очищены.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				Объект.Ссылка);
		КонецЕсли;
		
	КонецЕсли;

	ВыбратьСчетПоУмолчанию();
	
	//---
	// Флажок <без ограничения>
	//---
	НастройкиМеханизма = Документы.ИнвентаризацияМЗ.ФлажокБезОграничения_ПолучитьНастройкиМеханизма();
	ОбщегоНазначенияБГУ.ФлажокБезОграничения_ИнициализироватьФорму(ЭтаФорма, НастройкиМеханизма);
	
	// Если нет прав на изменение документа, то дополнительно отключаем еще элементы:
	ОбщегоНазначенияБГУ.УстановитьНедоступныеЭлементыФормы(Элементы, Объект,
		// Кнопки (6)
		"РасходыБудущихПериодовЗаполнитьПоДаннымУчета"
		
		// Инвентаризационная комиссия
		+ "УстановитьПериод, КомандаВыбратьКомиссию, ВыбратьПредседателяКомиссии, СоставКомиссииПодобратьСотрудников"
		);
	
КонецПроцедуры

&НаСервере
Процедура ВыбратьСчетПоУмолчанию()
	
	Перем	ИнициализацияФормыНовогоДокументаНеКопирование,
			ЗначениеКопирования;
	
	Если Параметры.Свойство("ЗначениеКопирования", ЗначениеКопирования) Тогда
		ИнициализацияФормыНовогоДокументаНеКопирование = (Объект.Ссылка.Пустая() И НЕ ЗначениеЗаполнено(ЗначениеКопирования));
	Иначе
		ИнициализацияФормыНовогоДокументаНеКопирование = Ложь;
	КонецЕсли;
	
	УстановитьПолеСчет	= ИнициализацияФормыНовогоДокументаНеКопирование;
	
	Если УстановитьПолеСчет Тогда
		Объект["Счет"] = БухгалтерскийУчетКлиентСервер.СчетПоКоду("401.50");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение = Неопределено)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	
	ТекстСообщения = НСтр("ru='Изменение организации вызовет полную очистку
		|табличных частей документа.
		|
		|Продолжить и сменить организацию?'");
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОрганизацияПередИзменениемКлиент_Ответ", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Объект["Организация"] = ПараметрыОповещения["ВыбранноеЗначение"];
		ЭтаФорма.Модифицированность = Истина;
		ОрганизацияПриИзмененииКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзмененииКлиент()
	
	НастроитьФормуСервер_ПриИзмененииОрганизации();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ПриИзмененииОрганизации()
	
	// Очищаем реквизиты документа:
	ОчищающаяСтруктура = Новый Структура("
		|ДолжностьПредседателяКомиссии,
		|ФамилияПредседателяКомиссии,
		|ИмяПредседателяКомиссии,
		|ОтчествоПредседателяКомиссии,
		|НомерПриказа,
		|ДатаПриказа,
		|МестоИнвентаризации");
	ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
	
	// Очищаем все табличные части документа:
	Объект["РасходыБудущихПериодов"].Очистить();
	Объект["СоставКомиссии"].Очистить();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьДоступностьЭлементов()
	
	Если ПравоДоступаИзменение Тогда
		
		НовДоступностьТаблицы	= ЗначениеЗаполнено(Объект["Организация"]);
		НовДоступностьКомиссия	= ЗначениеЗаполнено(Объект["Организация"]);
		
		// Отдельные элементы
		Элементы["СтраницаРасходыБудущихПериодов"].ТолькоПросмотр	= НЕ НовДоступностьТаблицы;
		
		// Кнопки (6)
		Элементы["РасходыБудущихПериодовЗаполнитьПоДаннымУчета"].Доступность			= НовДоступностьТаблицы;
		
		// Инвентаризационная комиссия
		Элементы["СтраницаИнвентаризация"].ТолькоПросмотр			= НЕ НовДоступностьКомиссия;
		Элементы["УстановитьПериод"].Доступность					= НовДоступностьКомиссия;
		Элементы["КомандаВыбратьКомиссию"].Доступность				= НовДоступностьКомиссия;
		Элементы["ВыбратьПредседателяКомиссии"].Доступность			= НовДоступностьКомиссия;
		Элементы["СоставКомиссииПодобратьСотрудников"].Доступность	= НовДоступностьКомиссия;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьФорму()
	
	Если ИнициализацияВыполнена Тогда
		Возврат;
	КонецЕсли;
	
	ПравоДоступаИзменение = ПравоДоступа("Изменение", Объект.Ссылка.Метаданные());
	
	ИнициализацияВыполнена = Истина;
	
	НастроитьДоступностьЭлементов();
	
КонецПроцедуры

