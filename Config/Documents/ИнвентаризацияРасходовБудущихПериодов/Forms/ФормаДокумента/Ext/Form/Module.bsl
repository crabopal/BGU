&НаКлиенте
Функция НеобходимыеРеквизитыЗаполнены()
	
	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаИнвентаризации) Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не указана дата проведения инвентаризации'"),
			Объект["Ссылка"],
			"Объект.ДатаИнвентаризации");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Результат = Ложь;
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ВидРБП) Тогда
		Результат = Ложь;
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Вид РБП'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.ВидРБП");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымУчета()
	
	Если НеобходимыеРеквизитыЗаполнены() Тогда
		Если Объект["РасходыБудущихПериодов"].Количество() > 0 Тогда
			ТекстСообщения = НСтр("ru='Перед заполнением по данным учета будет очищена
				|табличная часть Расходы будущих периодов.
				|
				|Продолжить и заполнить по данным учета?'");
			
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьПоДаннымУчета_Выбор", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
		Иначе
			ЗаполнитьПоДаннымУчетаКлиент();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымУчета_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоДаннымУчетаКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьДокументЗавершение(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Если НеобходимыеРеквизитыЗаполнены() Тогда
			ЗаполнитьПоДаннымУчетаКлиент();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДаннымУчетаКлиент()
	
	ЗаполнитьПоДаннымУчетаСервер();
	
	// Если по данным учета не было добавлено ни одной строки, выведем сообщение:
	Если Объект["РасходыБудущихПериодов"].Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Остатки расходов будущих периодов, соответствующие условиям поиска, отсутствуют'");
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДаннымУчетаСервер()
	
	Объект.РасходыБудущихПериодов.Очистить();
	
	Документы.ИнвентаризацияРасходовБудущихПериодов.ЗаполнитьПоДаннымУчета(Объект);
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьПоказателиВСтрокеДокумента(Знач ИзмененПоказатель = "")
	
	ДанныеСтроки = Объект.РасходыБудущихПериодов.НайтиПоИдентификатору(Элементы.РезультатыИнвентаризации.ТекущаяСтрока);
	
	ПараметрыРасчета = Новый Структура;
	
	Если Объект.ДатаИнвентаризации >= ИнвентаризацияКлиентСервер.ПолучитьДатуНачалаОпределенияОстатковНаКонецПредыдущегоДня52н() Тогда
		ДатаИнвентаризации = КонецДня(НачалоДня(Объект.ДатаИнвентаризации) - 1); // Конец предыдущего дня.
	Иначе
		ДатаИнвентаризации = Объект.ДатаИнвентаризации;
	КонецЕсли;
	ПараметрыРасчета.Вставить("ДатаИнвентаризации", ДатаИнвентаризации);
	
	ПараметрыРБП = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеСтроки.СтатьяРБП,
		"СпособПризнанияРасходов,ДатаНачалаСписания,ДатаОкончанияСписания,Сумма,ДатаВозникновенияРасходов");
	ПараметрыРасчета.Вставить("СпособПризнанияРасходов", ПараметрыРБП.СпособПризнанияРасходов);
	ПараметрыРасчета.Вставить("ДатаНачалаСписания",      ПараметрыРБП.ДатаНачалаСписания);
	ПараметрыРасчета.Вставить("ДатаОкончанияСписания",   ПараметрыРБП.ДатаОкончанияСписания);
	
	Если ИзмененПоказатель = "" Тогда // Пересчет всех показателей.
		ПараметрыРасчета.Вставить("ОбщаяПервоначальнаяСумма", ПараметрыРБП.Сумма);
		ПараметрыРасчета.Вставить("ОстатокПоДаннымУчета",     0);
	Иначе
		ПараметрыРасчета.Вставить("ОбщаяПервоначальнаяСумма", ДанныеСтроки.ОбщаяПервоначальнаяСумма);
		ПараметрыРасчета.Вставить("ОстатокПоДаннымУчета",     ДанныеСтроки.ОстатокПоДаннымУчета);
	КонецЕсли;
	
	Документы.ИнвентаризацияРасходовБудущихПериодов.РассчитатьПоказателиВСтрокеДокумента(ДанныеСтроки, ПараметрыРасчета, ИзмененПоказатель);
	
КонецПроцедуры

