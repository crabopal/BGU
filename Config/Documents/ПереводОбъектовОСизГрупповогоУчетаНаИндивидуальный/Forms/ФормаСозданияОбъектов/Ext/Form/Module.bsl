#Область ПрограммныйИнтерфейс
#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПереноситьДополнительныеРеквизитыОС = Истина;
	ПереноситьДополнительныеСведенияОС = Истина;
	
	ЗаполнитьФормуИзПараметров();
	УстановитьВидимостьюЭлементов(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НаименованиеОбъектаУказыватьВТаблицеПриИзменении(Элемент)
	УстановитьВидимостьюЭлементов(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИнвентарныеНомера

&НаКлиенте
Процедура ИнвентарныеНомераВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ТипЗнч(Поле) = Тип("ПолеФормы") Тогда
		Если Поле.Имя = "ИнвентарныеНомераИнвентарныйНомер" Тогда
			СтандартнаяОбработка = Ложь;
			ТекСтрока = ИнвентарныеНомера.НайтиПоИдентификатору(ВыбраннаяСтрока);
			Если ТекСтрока <> Неопределено Тогда
				ПараметрыФормы = Новый Структура("Ключ", ТекСтрока.ИнвентарныйНомер);
				ОткрытьФорму("Справочник.ИнвентарныеНомераОС.Форма.ФормаЭлемента", ПараметрыФормы, Элемент);
			КонецЕсли;	
		ИначеЕсли Поле.Имя = "ИнвентарныеНомераОсновноеСредство" Тогда
			СтандартнаяОбработка = Ложь;
			ТекСтрока = ИнвентарныеНомера.НайтиПоИдентификатору(ВыбраннаяСтрока);
			Если ТекСтрока <> Неопределено Тогда
				ПараметрыФормы = Новый Структура("Ключ", ТекСтрока.ОсновноеСредство);
				ОткрытьФорму("Справочник.ОсновныеСредства.Форма.ФормаЭлемента", ПараметрыФормы, Элемент);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИспользоватьНаименованиеГрупповогоОбъекта(Команда)
	НаименованиеОбъекта = ЗначениеРеквизитаОбъекта(ОсновноеСредствоГрупповое, "Наименование");
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьНаименованиеГрупповогоОбъектаВТаблице(Команда)
	ТекНаименование = ЗначениеРеквизитаОбъекта(ОсновноеСредствоГрупповое, "Наименование");
	Для каждого ТекСтрока из ИнвентарныеНомера Цикл
		ТекСтрока.НаименованиеОбъекта = ТекНаименование;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОбъекты(Команда)
	ЕстьОшибка = Ложь;
	ТекстОшибки = "";
	Если НаименованиеОбъектаУказыватьВТаблице Тогда
		Для каждого ТекСтрока из ИнвентарныеНомера Цикл
			Если НЕ ЗначениеЗаполнено(ТекСтрока.НаименованиеОбъекта) Тогда
				ЕстьОшибка = Истина;
				ТекстОшибки = НСтр("ru = 'В таблице нужно заполнить наименования объектов'");
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
	Иначе
		Если НЕ ЗначениеЗаполнено(НаименованиеОбъекта) Тогда
			ЕстьОшибка = Истина;
			ТекстОшибки = НСтр("ru = 'Нужно заполнить наименование объекта'");
		КонецЕсли;
	КонецЕсли;	
	
	Если ЕстьОшибка Тогда 
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			Если НаименованиеОбъектаУказыватьВТаблице Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,,, "ИнвентарныеНомера");
			Иначе	
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,, "НаименованиеОбъекта");
			КонецЕсли;	
		КонецЕсли;
		Возврат;	
	КонецЕсли;	
	
	СоздатьОбъектыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВДокумент(Команда)
	Закрыть(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьФормуИзПараметров()
	Если ТипЗнч(Параметры.ИнвентарныеНомера) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;	
	
	Для каждого ТекСтрока из Параметры.ИнвентарныеНомера Цикл
		НоваяСтрока = ИнвентарныеНомера.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;	
	
	Если ЗначениеЗаполнено(Параметры.ОсновноеСредствоГрупповое) Тогда
		ОсновноеСредствоГрупповое = Параметры.ОсновноеСредствоГрупповое;
	КонецЕсли;	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьюЭлементов(Форма)
	Элементы = Новый Массив;
	Элементы.Добавить("НаименованиеОбъекта");
	Элементы.Добавить("ВзятьНаименованиеГрупповогоОбъекта");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, Элементы,
		"Видимость", НЕ Форма.НаименованиеОбъектаУказыватьВТаблице);	
	
	Элементы = Новый Массив;
	Элементы.Добавить("ИнвентарныеНомераНаименованиеОбъекта");
	Элементы.Добавить("ИнвентарныеНомераИспользоватьНаименованиеГрупповогоОбъектаВТаблице");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, Элементы,
		"Видимость", Форма.НаименованиеОбъектаУказыватьВТаблице);	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита);
КонецФункции

&НаСервере
Процедура ПеренестиДополнительныеСведения(ИсточникДопСведений, ОбъектПриемникСсылка, ТекИнвентарныйНомерВГруппе)
	// Перенесем дополнительные сведения объекта ОС
	Если ИсточникДопСведений.Количество() <> 0 Тогда
		НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить(ОбъектПриемникСсылка, Истина);
		НаборЗаписей.Прочитать();
		
		Для каждого СтрокаСведений из ИсточникДопСведений Цикл
			НоваяЗапись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаСведений);
			НоваяЗапись.Объект = ОбъектПриемникСсылка;
		КонецЦикла;	
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей, Истина);
		Исключение	
			ОтменитьТранзакцию();
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Не удалось перенести дополнительные сведения объекта для инвентарного номера: %1'"), 
				ТекИнвентарныйНомерВГруппе);
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке, ТекстОшибки);
			ВызватьИсключение(Уточнение.Текст, Уточнение.Категория,,,ИнформацияОбОшибке);
		КонецПопытки;	
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура СоздатьОбъектыНаСервере()
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ИнвентарныеНомераОС.ИнвентарныйНомерЗаимствованный КАК ИнвентарныйНомерВГруппе,
	|	ИнвентарныеНомераОС.ОС КАК ОсновноеСредство,
	|	ИнвентарныеНомераОС.Ссылка КАК ИнвентарныйНомер
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.ИнвентарныйНомерЗаимствуется
	|	И ИнвентарныеНомераОС.ИнвентарныйНомерЗаимствованный В (&ИнвНомера)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Родитель КАК Родитель,
	|	ОсновныеСредства.Организация КАК Организация,
	|	ОсновныеСредства.ВидНФА КАК ВидНФА,
	|	ОсновныеСредства.ТипНФА КАК ТипНФА,
	|	ОсновныеСредства.КодОКОФ КАК КодОКОФ,
	|	ОсновныеСредства.АмортизационнаяГруппа КАК АмортизационнаяГруппа,
	|	ОсновныеСредства.МожетСодержатьДрагМатериалы КАК МожетСодержатьДрагМатериалы,
	|	ОсновныеСредства.Назначение КАК Назначение,
	|	ОсновныеСредства.ИзготовительОС КАК ИзготовительОС,
	|	ОсновныеСредства.Сведения КАК Сведения,
	|	ОсновныеСредства.СтавкаНДС КАК СтавкаНДС,
	|	ОсновныеСредства.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ОсновныеСредства.КодТНВЭД КАК КодТНВЭД,
	|	ОсновныеСредства.ОКП КАК ОКП,
	|	ОсновныеСредства.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ОсновныеСредства.КодКонтураИдентификацииСведенийОбОбъекте КАК КодКонтураИдентификацииСведенийОбОбъекте,
	|	ОсновныеСредства.ДополнительныеРеквизиты.(
	|		НомерСтроки КАК НомерСтроки,
	|		Свойство КАК Свойство,
	|		Значение КАК Значение,
	|		ТекстоваяСтрока КАК ТекстоваяСтрока) КАК ДополнительныеРеквизиты
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &ОСГрупповое
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИнвентарныеНомераОС.Ссылка КАК ИнвентарныйНомерЗаимствованный,
	|	ИнвентарныеНомераОС.Владелец КАК Владелец,
	|	ИнвентарныеНомераОС.Код КАК Код,
	|	ИнвентарныеНомераОС.ЗаводскойНомер КАК ЗаводскойНомер,
	|	ИнвентарныеНомераОС.РеестровыйНомер КАК РеестровыйНомер,
	|	ИнвентарныеНомераОС.ИнойНомер КАК ИнойНомер,
	|	ИнвентарныеНомераОС.НомерПаспорта КАК НомерПаспорта,
	|	ИнвентарныеНомераОС.ДатаВыпуска КАК ДатаВыпуска,
	|	ИнвентарныеНомераОС.ДополнительныеРеквизиты.(
	|		НомерСтроки КАК НомерСтроки,
	|		Свойство КАК Свойство,
	|		Значение КАК Значение,
	|		ТекстоваяСтрока КАК ТекстоваяСтрока) КАК ДополнительныеРеквизиты
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.Ссылка В (&ИнвНомера)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДополнительныеСведения.Объект КАК ИнвентарныйНомерВГруппе,
	|	ДополнительныеСведения.Свойство КАК Свойство,
	|	ДополнительныеСведения.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Объект В (&ИнвНомера)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДополнительныеСведения.Объект КАК ИнвентарныйНомерВГруппе,
	|	ДополнительныеСведения.Свойство КАК Свойство,
	|	ДополнительныеСведения.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Объект = &ОСГрупповое";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ОСГрупповое", ОсновноеСредствоГрупповое);
	Запрос.УстановитьПараметр("ИнвНомера", ИнвентарныеНомера.Выгрузить().ВыгрузитьКолонку("ИнвентарныйНомерВГруппе"));
	
	Результат = Запрос.ВыполнитьПакет();
	ТабИнвНомеров = Результат[0].Выгрузить();
	ВыборкаОС = Результат[1].Выбрать();
	Если НЕ ВыборкаОС.Следующий() Тогда
		Возврат;
	КонецЕсли;	
	ТабСвойств = Результат[2].Выгрузить();
	ТабДопСвойств = Результат[3].Выгрузить();
	ТабДопСвойствОС = Результат[4].Выгрузить();
	
	НачатьТранзакцию();
	СтруктураПоиска = Новый Структура("ИнвентарныйНомерВГруппе");
	Для каждого ТекСтрока из ИнвентарныеНомера Цикл
		НайденнаяСтрока = ТабИнвНомеров.Найти(ТекСтрока.ИнвентарныйНомерВГруппе, "ИнвентарныйНомерВГруппе");
		Если НайденнаяСтрока <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ТекСтрока, НайденнаяСтрока);
			Продолжить;
		КонецЕсли;
			
		// Создадим новый объект основного средства	
		НовыйОбъект = Справочники.ОсновныеСредства.СоздатьЭлемент();
		НовыйОбъект.Наименование = 
			?(НаименованиеОбъектаУказыватьВТаблице, ТекСтрока.НаименованиеОбъекта, НаименованиеОбъекта);
		ЗаполнитьЗначенияСвойств(НовыйОбъект, ВыборкаОС,, "ДополнительныеРеквизиты");
		НовыйОбъект.УстановитьНовыйКод();

		// Заполним дополнительные реквизиты объекта ОС
		Если ПереноситьДополнительныеРеквизитыОС Тогда
			ВыборкаДопРеков = ВыборкаОС.ДополнительныеРеквизиты.Выбрать();
			Пока ВыборкаДопРеков.Следующий() Цикл
				НовыйРеквизит = НовыйОбъект.ДополнительныеРеквизиты.Добавить();
				ЗаполнитьЗначенияСвойств(НовыйРеквизит, ВыборкаДопРеков);
			КонецЦикла;	
		КонецЕсли;	 
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(НовыйОбъект, Истина);
		Исключение	
			ОтменитьТранзакцию();
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Не удалось создать объект основного средства для инвентарного номера: %1'"), 
				ТекСтрока.ИнвентарныйНомерВГруппе);
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке, ТекстОшибки);
				ВызватьИсключение(Уточнение.Текст, Уточнение.Категория,,,ИнформацияОбОшибке);
		КонецПопытки;	
		
		// Перенесем дополнительные сведения объекта ОС
		ПеренестиДополнительныеСведения(ТабДопСвойствОС, НовыйОбъект.Ссылка, ТекСтрока.ИнвентарныйНомерВГруппе);		

		// Создадим новый объект инвентарного номера и перенесем его свойства и дополнительные свойства	
		НайденнаяСтрока = ТабСвойств.Найти(ТекСтрока.ИнвентарныйНомерВГруппе, "ИнвентарныйНомерЗаимствованный");
		Если НайденнаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НовыйИнвНомер = Справочники.ИнвентарныеНомераОС.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(НовыйИнвНомер, НайденнаяСтрока);
		НовыйИнвНомер.ИнвентарныйНомерЗаимствуется = Истина;
		НовыйИнвНомер.ОС = НовыйОбъект.Ссылка;
		Для каждого СтрокаСвойства из НайденнаяСтрока.ДополнительныеРеквизиты Цикл
			НовоеСвойство = НовыйИнвНомер.ДополнительныеРеквизиты.Добавить();
			ЗаполнитьЗначенияСвойств(НовоеСвойство, СтрокаСвойства);
		КонецЦикла;	

		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(НовыйИнвНомер, Истина);
		Исключение	
			ОтменитьТранзакцию();
			ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Не удалось создать инвентарный номер: %1'"), ТекСтрока.ИнвентарныйНомерВГруппе);
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке, ТекстОшибки);
				ВызватьИсключение(Уточнение.Текст, Уточнение.Категория,,,ИнформацияОбОшибке);
		КонецПопытки;	
		
		// Перенесем дополнительные сведения инвентарного номера
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, ТекСтрока);
		НайденныеСтроки = ТабДопСвойств.НайтиСтроки(СтруктураПоиска);
		ПеренестиДополнительныеСведения(НайденныеСтроки, НовыйИнвНомер.Ссылка, ТекСтрока.ИнвентарныйНомерВГруппе);		
		
		ТекСтрока.ОсновноеСредство = НовыйОбъект.Ссылка;
		ТекСтрока.ИнвентарныйНомер = НовыйИнвНомер.Ссылка;
	КонецЦикла;	
	ЗафиксироватьТранзакцию();
КонецПроцедуры	

#КонецОбласти
