#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыборИнвентарногоНомера_Завершение(Результат, ДопПараметры) Экспорт
	Если ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда
		ДопПараметры["ТекущиеДанные"].ИнвентарныйНомерВГруппе = Результат.Значение;
	ИначеЕсли ТипЗнч(Результат) = Тип("СписокЗначений") Тогда
		Объект.ИнвентарныеНомера.Очистить();
		Для каждого ТекЭлемент из Результат Цикл
			Если НЕ ТекЭлемент.Пометка Тогда
				Продолжить;
			КонецЕсли;	
			
			НоваяСтрока = Объект.ИнвентарныеНомера.Добавить();
			НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор();
			НоваяСтрока.ПрослеживаемыйТовар = Объект.ПрослеживаемыйТовар;
			НоваяСтрока.ИнвентарныйНомерВГруппе = ТекЭлемент.Значение;
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ОсновноеСредствоГрупповоеПриИзмененииНаСервере()
	СписокВыбораИнвентарныхНомеров = 
		СписокВыбораИнвентарныхНомеров(Объект.ОсновноеСредствоГрупповое, Объект.Ссылка, Объект.Дата);
	Элементы.ИнвентарныеНомераИнвентарныйНомерВГруппе.СписокВыбора.ЗагрузитьЗначения(
		СписокВыбораИнвентарныхНомеров.ВыгрузитьЗначения());

	ДанныеОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ОсновноеСредствоГрупповое, "СтранаПроисхождения");
	Объект.ПрослеживаемыйТовар = 
		ПрослеживаемостьБГУ.ПрослеживаемоеОсновноеСредство(Объект.ОсновноеСредствоГрупповое, Объект);
	Объект.СтранаПроисхождения = ДанныеОС.СтранаПроисхождения; 
КонецПроцедуры	 

&НаКлиенте
Процедура ПодобратьЗавершение(Результат, Параметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	СтруктураПоиска = Новый Структура("ИнвентарныйНомерВГруппе");
	Для каждого ТекНомер из Результат Цикл
		СтруктураПоиска.ИнвентарныйНомерВГруппе = ТекНомер;
		НайденныеСтроки = Объект.ИнвентарныеНомера.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() <> 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		НоваяСтрока = Объект.ИнвентарныеНомера.Добавить();
		НоваяСтрока.ИнвентарныйНомерВГруппе = ТекНомер;
		НоваяСтрока.ПрослеживаемыйТовар = Объект.ПрослеживаемыйТовар;
	КонецЦикла;		
КонецПроцедуры	

&НаКлиенте
Процедура СформироватьНовыеОбъекты_Завершение(Результат, Параметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	СтруктураПоиска = Новый Структура("ИнвентарныйНомерВГруппе");
	Для каждого ТекСтрока из Результат.ИнвентарныеНомера Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, ТекСтрока);
		НайденныеСтроки = Объект.ИнвентарныеНомера.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		ЗаполнитьЗначенияСвойств(НайденныеСтроки[0], ТекСтрока);
	КонецЦикла;	
	ЗаполнитьНомераИнвентарныхКарточекНаСервере();
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПолучитьНовыеОбъекты(ИнвНомера)
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИнвНомераОС.Ссылка КАК ИнвентарныйНомерВГруппе,
	|	ЕСТЬNULL(ИнвНомераДубли.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК
	|		ИнвентарныйНомер,
	|	ЕСТЬNULL(ИнвНомераДубли.ОсновноеСредство, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)) КАК ОсновноеСредство
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвНомераОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ИнвНомера.ИнвентарныйНомерЗаимствованный КАК ИнвентарныйНомерВГруппе,
	|			ИнвНомера.ОС КАК ОсновноеСредство,
	|			ИнвНомера.Ссылка КАК ИнвентарныйНомер
	|		ИЗ
	|			Справочник.ИнвентарныеНомераОС КАК ИнвНомера
	|		ГДЕ
	|			ИнвНомера.ИнвентарныйНомерЗаимствуется
	|			И ИнвНомера.ИнвентарныйНомерЗаимствованный В (&ИнвНомера)) КАК ИнвНомераДубли
	|		ПО ИнвНомераОС.Ссылка = ИнвНомераДубли.ИнвентарныйНомерВГруппе
	|ГДЕ
	|	ИнвНомераОС.Ссылка В (&ИнвНомера)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ИнвНомера", ИнвНомера);
	Таб = Запрос.Выполнить().Выгрузить();
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(Таб);
КонецФункции	

