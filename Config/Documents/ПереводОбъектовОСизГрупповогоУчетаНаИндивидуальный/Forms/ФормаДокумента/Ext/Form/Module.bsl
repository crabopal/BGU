#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИнвентарныеНомера

&НаКлиенте
Процедура ИнвентарныеНомераПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ТекДанные = Элементы.ИнвентарныеНомера.ТекущиеДанные;
		ТекДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор();
		ТекДанные.ПрослеживаемыйТовар = Объект.ПрослеживаемыйТовар;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеНомераВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ТипЗнч(Поле) = Тип("ПолеФормы") Тогда
		Если Поле.Имя = "ИнвентарныеНомераРНПТ" Тогда
			СтандартнаяОбработка = Ложь;
			ТекущиеДанные = Элементы.ИнвентарныеНомера.ТекущиеДанные;
		
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Организация", Объект.Организация);
			СтруктураПараметров.Вставить("Номенклатура", Объект.ОсновноеСредствоГрупповое);
			СтруктураПараметров.Вставить("Период", Объект.Дата);
			СтруктураПараметров.Вставить("ВнеоборотныйАктив", Объект.ОсновноеСредствоГрупповое);
			СтруктураПараметров.Вставить("ВыборПоОстаткам", Истина);
			СтруктураПараметров.Вставить("Количество", 1);
			СтруктураПараметров.Вставить("СтранаПроисхождения", Объект.СтранаПроисхождения);
			СтруктураПараметров.Вставить("ПрослеживаемыйТовар", Объект.ПрослеживаемыйТовар);
			СтруктураПараметров.Вставить("ЭтоВозвратПоставщику", ложь);
			СтруктураПараметров.Вставить("ДатаТекущегоДокумента", '00010101');
			СтруктураПараметров.Вставить("ДокументРеализации", Неопределено);
			СтруктураПараметров.Вставить("ЭтоВозвратПоставщику", Ложь);
			СтруктураПараметров.Вставить("ТекущийДокумент", Объект.Ссылка);
			
			АдресТаблицыРНПТВХранилище = ПоместитьРНПТВХранилищеНаСервере(
			Элементы.ИнвентарныеНомера.ТекущиеДанные.ИдентификаторСтроки);
			
			СтруктураПараметров.Вставить("АдресТаблицыРНПТВХранилище", АдресТаблицыРНПТВХранилище);
			СтруктураПараметров.Вставить("ЭтоПоступление", Ложь);
			
			ОткрытьФорму("Справочник.НомераГТД.Форма.ФормаПодбораРНПТДляОС", СтруктураПараметров, ЭтотОбъект);
		ИначеЕсли Поле.Имя = "ИнвентарныеНомераИнвентарныйНомер" Тогда
			СтандартнаяОбработка = Ложь;
			ТекСтрока = Объект.ИнвентарныеНомера.НайтиПоИдентификатору(ВыбраннаяСтрока);
			Если ТекСтрока <> Неопределено Тогда
				ПараметрыФормы = Новый Структура("Ключ", ТекСтрока.ИнвентарныйНомер);
				ОткрытьФорму("Справочник.ИнвентарныеНомераОС.Форма.ФормаЭлемента", ПараметрыФормы, Элемент);
			КонецЕсли;	
		ИначеЕсли Поле.Имя = "ИнвентарныеНомераОсновноеСредство" Тогда
			СтандартнаяОбработка = Ложь;
			ТекСтрока = Объект.ИнвентарныеНомера.НайтиПоИдентификатору(ВыбраннаяСтрока);
			Если ТекСтрока <> Неопределено Тогда
				ПараметрыФормы = Новый Структура("Ключ", ТекСтрока.ОсновноеСредство);
				ОткрытьФорму("Справочник.ОсновныеСредства.Форма.ФормаЭлемента", ПараметрыФормы, Элемент);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеНомераИнвентарныйНомерВГруппеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;

	ТекДанные = Элементы.ИнвентарныеНомера.ТекущиеДанные;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ТекущиеДанные", ТекДанные);
	Оповещение = Новый ОписаниеОповещения("ВыборИнвентарногоНомера_Завершение", ЭтотОбъект, ДопПараметры);
	ЭлементСписка = СписокВыбораИнвентарныхНомеров.НайтиПоЗначению(ТекДанные.ИнвентарныйНомерВГруппе);
	СписокВыбораИнвентарныхНомеров.ПоказатьВыборЭлемента(Оповещение, НСтр("ru = 'Выберите инвентарный номер'"), ЭлементСписка);
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеНомераПричинаСписанияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	УправлениеОсновнымиСредствамиКлиент.ПричинаСписанияНачалоВыбора(
		Элемент, Элементы.ИнвентарныеНомера.ТекущиеДанные, СтандартнаяОбработка, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныеНомераПричинаСписанияОбработкаВыбора(
	Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	УправлениеОсновнымиСредствамиКлиент.ПричинаСписанияОбработкаВыбора(
		Элементы.ИнвентарныеНомера.ТекущиеДанные, ВыбранноеЗначение, Ложь);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	// СтандартныеПодсистемы.Свойства
	Если ПараметрыСвойств.Свойство(ТекущаяСтраница.Имя)
	        И Не ПараметрыСвойств.ВыполненаОтложеннаяИнициализация Тогда
	    
	    СвойстваВыполнитьОтложеннуюИнициализацию();
	    УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
    ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Объект);
