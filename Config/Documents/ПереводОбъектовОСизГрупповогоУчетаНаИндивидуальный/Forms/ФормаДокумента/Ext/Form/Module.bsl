&НаКлиенте
Процедура ОбработкаВыбораРНПТННаКлиенте(ВыбранноеЗначение)
	
	СтрокаТабличнойЧасти = Элементы.ИнвентарныеНомера.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
			СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		ОбработкаВыбораРНПТННаСервере(
			СтрокаТабличнойЧасти.ИдентификаторСтроки, ВыбранноеЗначение, СтрокаТабличнойЧасти.ПолучитьИдентификатор());
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораРНПТННаСервере(Знач ИдентификаторСтроки, Знач ВыбранноеЗначение, Знач ИдентификаторСтрокиВнутр)
	
	СтрокаТабличнойЧасти = Объект.ИнвентарныеНомера.НайтиПоИдентификатору(ИдентификаторСтрокиВнутр);
	ПрослеживаемостьФормыБГУ.ОбработкаВыбораРНПТН(ЭтотОбъект, ИдентификаторСтроки, ВыбранноеЗначение);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТ(ЭтотОбъект, СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНомераИнвентарныхКарточекНаСервере()
	ПараметрыДляКарточки = УчетныеДанныеДляИнвентарныхКарточек();
	НомераКарточек = Новый Массив;
	Для каждого СтрокаТЧ из Объект.ИнвентарныеНомера ЦИкл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.НомерИнвентарнойКарточки) Тогда
			Продолжить;
		КонецЕсли;	
		НомераКарточек.Добавить(СтрокаТЧ.НомерИнвентарнойКарточки);
	КонецЦикла;	
	
	Для каждого СтрокаТЧ из Объект.ИнвентарныеНомера Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.НомерИнвентарнойКарточки) Тогда
			Продолжить;
		КонецЕсли;	
		
		ПараметрыДляКарточки.ИнвентарныйНомер = СтрокаТЧ.ИнвентарныйНомер;

		СтрокаТЧ.НомерИнвентарнойКарточки = УправлениеОсновнымиСредствамиВызовСервера.ПолучитьНомерИнвентарнойКарточи(
			Объект.Ссылка, Объект.Организация, СтрокаТЧ.ОсновноеСредство, 
			ПараметрыДляКарточки, КонецДня(Объект.Дата), НомераКарточек);
			
		Если ЗначениеЗаполнено(СтрокаТЧ.НомерИнвентарнойКарточки) 
			И НомераКарточек.Найти(СтрокаТЧ.НомерИнвентарнойКарточки) = Неопределено Тогда
			НомераКарточек.Добавить(СтрокаТЧ.НомерИнвентарнойКарточки);
		КонецЕсли;		
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция УчетныеДанныеДляИнвентарныхКарточек()
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК Счет
	|ПОМЕСТИТЬ Счета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ПОДСТРОКА(ЕПСБУ.Код, 1, 3) В (&КодыСчетов)
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаЗапроса, Счет В
	|		(ВЫБРАТЬ
	|			Таб.Счет
	|		ИЗ
	|			Счета КАК Таб), &СубконтоОС, Организация = &Организация
	|	И Субконто1 = &ОС) КАК ЖурналПроводокЕПСБУОстатки";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КодыСчетов", """101"", ""102"", ""103"", ""108""");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаЗапроса", Объект.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ОС", Объект.ОсновноеСредствоГрупповое);
	Запрос.УстановитьПараметр("СубконтоОС", ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПараметрыДляКарточки = Новый Структура;
	ПараметрыДляКарточки.Вставить("СчетУчета", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	ПараметрыДляКарточки.Вставить("ИФО", Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	ПараметрыДляКарточки.Вставить("КПС", Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
	ПараметрыДляКарточки.Вставить("КФО", Перечисления.КВД.ПустаяСсылка());
	ПараметрыДляКарточки.Вставить("ИнвентарныйНомер", Справочники.ИнвентарныеНомераОС.ПустаяСсылка());
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыДляКарточки, Выборка);
	КонецЕсли;	
	 
	Возврат ПараметрыДляКарточки;
КонецФункции		

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьПрослеживаемыйТоварВТЧ(Форма)
	Для каждого СтрокаТЧ из Форма.Объект.ИнвентарныеНомера Цикл
		СтрокаТЧ.ПрослеживаемыйТовар = Форма.Объект.ПрослеживаемыйТовар; 
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция ПоместитьРНПТВХранилищеНаСервере(ИдентификаторСтроки)
	
	ТаблицаРНПТ = Объект.СведенияПрослеживаемости.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Возврат ПоместитьВоВременноеХранилище(ТаблицаРНПТ, УникальныйИдентификатор);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеДанныхПрослеживаемости(СтранаПроисхождения)
	Результат = СтрШаблон(
		НСтр("ru = 'Страна происхождения: %1'"), ?(ЗначениеЗаполнено(СтранаПроисхождения), СтранаПроисхождения, "<...>"));
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Элементы = Форма.Элементы;
	
	ЭлементыПрослеживаемости = Новый Массив;
	ЭлементыПрослеживаемости.Добавить("ГруппаПрослеживаемость");
	ЭлементыПрослеживаемости.Добавить("ИнвентарныеНомераРНПТ");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыПрослеживаемости,
		"Видимость", Форма.Объект.ПрослеживаемыйТовар);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокВыбораИнвентарныхНомеров(ОС, Ссылка, ДатаДокумента)
	СписокВыбора = Новый СписокЗначений();
	Если НЕ ЗначениеЗаполнено(ОС) Тогда
		Возврат СписокВыбора;
	КонецЕсли;
		 
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ОстаткиИнвНомеров
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&Дата1, ОсновноеСредство = &ОсновноеСредство) КАК
	|		СтоимостьОбъектовОСОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ИнвентарныйНомер
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(&Дата1, ОсновноеСредство = &ОсновноеСредство) КАК
	|		СтоимостьОбъектовОСПоКонтрагентамОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИнвентарныеНомераОС.Ссылка КАК ИнвентарныйНомер
	|ИЗ
	|	ОстаткиИнвНомеров КАК ОстаткиИнвНомеров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|		ПО ОстаткиИнвНомеров.ИнвентарныйНомер = ИнвентарныеНомераОС.Ссылка
	|ГДЕ
	|	ИнвентарныеНомераОС.ОС = &ОсновноеСредство
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИнвентарныеНомераОС.Код";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОС);
	ДатаЗапроса = ?(ЗначениеЗаполнено(Ссылка), Новый Граница(Ссылка.МоментВремени(), ВидГраницы.Исключая), ДатаДокумента);
	Запрос.УстановитьПараметр("Дата1", ДатаЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокВыбора.Добавить(Выборка.ИнвентарныйНомер);
	КонецЦикла;	
	Возврат СписокВыбора;
КонецФункции	

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	
	Возврат СтруктураРеквизитов;
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Счет", "101.00, 102,00, 108.00, 111.60");
	ПараметрыПодбора.Отбор.Вставить("ГрупповойУчет", Истина);
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения"	, "УчетныеДанные");
	ПараметрыПодбора.Вставить("СкрытьКолонки", "КФО,КПС");
	ПараметрыПодбора.Вставить("НужнаАмортизация", Ложь);
	ПараметрыПодбора.Вставить("ДокументСРезервированиемОС", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОсновныхСредствНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(Знач ВыбранноеЗначение)
	
	ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
	Если ТаблицаОС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	Объект.ОсновноеСредствоГрупповое = ТаблицаОС[0].ОсновноеСредство;
	
	ОсновноеСредствоГрупповоеПриИзмененииНаСервере();
	Элементы.НадписьПрослеживаемость.Заголовок = ПредставлениеДанныхПрослеживаемости(Объект.СтранаПроисхождения);
	УстановитьВидимостьЭлементов(ЭтотОбъект);
КонецПроцедуры

