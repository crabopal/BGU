&НаКлиенте
Процедура СформироватьНовыеОбъекты(Команда)
	ИнвНомера = Новый Массив;
	Для каждого ТекСтрока из Объект.ИнвентарныеНомера Цикл
		ИнвНомера.Добавить(ТекСтрока.ИнвентарныйНомерВГруппе);
	КонецЦикла;
		 
	МассивТаб = ПолучитьНовыеОбъекты(ИнвНомера);
	МассивНезаполненных = Новый Массив;
	ЕстьНезаполненные = Ложь;
	СтруктураПоиска = Новый Структура("ИнвентарныйНомерВГруппе");
	Для каждого СтрокаОбъекта из МассивТаб Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаОбъекта);
		НайденныеСтроки = Объект.ИнвентарныеНомера.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаОбъекта.ОсновноеСредство) Тогда	
			ЕстьНезаполненные = Истина;
			МассивНезаполненных.Добавить(СтрокаОбъекта);
			Продолжить;
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(НайденныеСтроки[0], СтрокаОбъекта);
	КонецЦикла;	
	
	Если ЕстьНезаполненные Тогда
		ПараметрыФормы = Новый Структура("ИнвентарныеНомера, ОсновноеСредствоГрупповое", 
			МассивНезаполненных, Объект.ОсновноеСредствоГрупповое);
		Оповещение = Новый ОписаниеОповещения("СформироватьНовыеОбъекты_Завершение", ЭтотОбъект);	
		ОткрытьФорму(
			"Документ.ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный.Форма.ФормаСозданияОбъектов", 
			ПараметрыФормы, ЭтотОбъект,,,, Оповещение);
	Иначе		
		ЗаполнитьНомераИнвентарныхКарточекНаСервере();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыТЧ(Команда)
	Реквизиты = Новый Структура;
	
	Реквизиты.Вставить("ПричинаСписания", Новый Структура);
	Реквизиты.ПричинаСписания.Вставить("ТипыДляВыбора", 
		Новый ОписаниеТипов("Строка, СправочникСсылка.ПричиныСписанияНФА"));
	Реквизиты.ПричинаСписания.Вставить("СинонимДляВыбора", НСтр("ru = 'Причина списания'")); 
	
	УправлениеНФАКлиент.ИзменитьРеквизитыСтрокТЧ(ЭтотОбъект, 
		"ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный", "ИнвентарныеНомера", "ИнвентарныеНомера", Реквизиты);
КонецПроцедуры  

&НаКлиенте
Процедура Подобрать(Команда)
	ТекДанные = Элементы.ИнвентарныеНомера.ТекущиеДанные;
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ТекущиеДанные", ТекДанные);
	Оповещение = Новый ОписаниеОповещения("ВыборИнвентарногоНомера_Завершение", ЭтотОбъект, ДопПараметры);
	СписокВыбораИнвентарныхНомеров.ПоказатьОтметкуЭлементов(
		Оповещение, НСтр("ru = 'Отметьте инвентарные номера для выбора'"));
КонецПроцедуры

