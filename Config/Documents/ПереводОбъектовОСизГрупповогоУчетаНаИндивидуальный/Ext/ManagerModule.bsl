КонецПроцедуры	

Процедура ЗапросыПоДрагМеталлам(ТекстЗапроса, НомераТаблиц)
	НомераТаблиц.Вставить("ДрагМеталлыОстатки", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("НаличиеДрагМатериаловВОбъектахНФА", НомераТаблиц.Количество());
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НаличиеДрагМатериаловОстатки.ИнвНомер КАК ИнвентарныйНомер,
	|	НаличиеДрагМатериаловОстатки.ВидДрагМатериала КАК ВидДрагМатериала,
	|	НаличиеДрагМатериаловОстатки.ЕдИзм КАК ЕдИзм,
	|	НаличиеДрагМатериаловОстатки.МассаДМОстаток КАК МассаДМОстаток,
	|	НаличиеДрагМатериаловОстатки.КоличествоДМОстаток КАК КоличествоДМОстаток
	|ПОМЕСТИТЬ ДрагМеталлыОстатки
	|ИЗ
	|	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&ДатаЗапроса, Организация = &Организация
	|	И ОбъектНФА = &ОсновноеСредствоГрупповое) КАК НаличиеДрагМатериаловОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДатаЗапроса КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ТаблицаИнвентарныеНомера.ОсновноеСредствоГрупповое КАК ОбъектНФА,
	|	ТаблицаИнвентарныеНомера.ИнвентарныйНомерВГруппе КАК ИнвНомер,
	|	ТаблицаИнвентарныеНомера.Организация КАК Организация,
	|	ДрагМеталлыОстатки.ВидДрагМатериала КАК ВидДрагМатериала,
	|	ДрагМеталлыОстатки.ЕдИзм КАК ЕдИзм,
	|	ДрагМеталлыОстатки.МассаДМОстаток КАК МассаДМ,
	|	ДрагМеталлыОстатки.КоличествоДМОстаток КАК КоличествоДМ,
	|	ИСТИНА КАК ЭтоСписание
	|ИЗ
	|	ДрагМеталлыОстатки КАК ДрагМеталлыОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаИнвентарныеНомера КАК ТаблицаИнвентарныеНомера
	|		ПО ДрагМеталлыОстатки.ИнвентарныйНомер = ТаблицаИнвентарныеНомера.ИнвентарныйНомерВГруппе
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ДатаЗапроса,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	ТаблицаИнвентарныеНомера.ОсновноеСредство,
	|	ТаблицаИнвентарныеНомера.ИнвентарныйНомер,
	|	ТаблицаИнвентарныеНомера.Организация,
	|	ДрагМеталлыОстатки.ВидДрагМатериала,
	|	ДрагМеталлыОстатки.ЕдИзм,
	|	ДрагМеталлыОстатки.МассаДМОстаток,
	|	ДрагМеталлыОстатки.КоличествоДМОстаток,
	|	ЛОЖЬ КАК ЭтоСписание
	|ИЗ
	|	ДрагМеталлыОстатки КАК ДрагМеталлыОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаИнвентарныеНомера КАК ТаблицаИнвентарныеНомера
	|		ПО ДрагМеталлыОстатки.ИнвентарныйНомер = ТаблицаИнвентарныеНомера.ИнвентарныйНомерВГруппе";

КонецПроцедуры

Процедура ЗапросыПоНУ(ТекстЗапроса, НомераТаблиц)
	НомераТаблиц.Вставить("НачислениеАмортизацииОСНалоговыйУчет", НомераТаблиц.Количество());
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	&ДатаЗапроса КАК Период,
	|	АмортизацияОС.Организация КАК Организация,
	|	ТаблицаИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОС.НачислятьАмортизацию КАК НачислятьАмортизацию
	|ИЗ
	|	РегистрСведений.НачислениеАмортизацииОСНалоговыйУчет.СрезПоследних(&ДатаЗапроса, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			Таб.ОсновноеСредствоГрупповое
	|		ИЗ
	|			ТаблицаИнвентарныеНомера КАК Таб)) КАК АмортизацияОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаИнвентарныеНомера КАК ТаблицаИнвентарныеНомера
	|		ПО АмортизацияОС.ОсновноеСредство = ТаблицаИнвентарныеНомера.ОсновноеСредствоГрупповое";
	
	НомераТаблиц.Вставить("НачислениеАмортизацииОССпециальныйКоэффициентНалоговыйУчет", НомераТаблиц.Количество());
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	&ДатаЗапроса КАК Период,
	|	НачислениеАмортизацииОССпециальныйКоэффициентНУ.Организация КАК Организация,
	|	ТаблицаИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредство,
	|	НачислениеАмортизацииОССпециальныйКоэффициентНУ.СпециальныйКоэффициент КАК СпециальныйКоэффициент
	|ИЗ
	|	РегистрСведений.НачислениеАмортизацииОССпециальныйКоэффициентНалоговыйУчет.СрезПоследних(&ДатаЗапроса, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			Таб.ОсновноеСредствоГрупповое
	|		ИЗ
	|			ТаблицаИнвентарныеНомера КАК Таб)) КАК НачислениеАмортизацииОССпециальныйКоэффициентНУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаИнвентарныеНомера КАК ТаблицаИнвентарныеНомера
	|		ПО НачислениеАмортизацииОССпециальныйКоэффициентНУ.ОсновноеСредство = ТаблицаИнвентарныеНомера.ОсновноеСредствоГрупповое";
	
	НомераТаблиц.Вставить("ПараметрыАмортизацииОСНалоговыйУчет", НомераТаблиц.Количество());
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	&ДатаЗапроса КАК Период,
	|	ПараметрыАмортизацииОСНУ.Организация КАК Организация,
	|	ТаблицаИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредство,
	|	ПараметрыАмортизацииОСНУ.СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСНалоговыйУчет.СрезПоследних(&ДатаЗапроса, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			Таб.ОсновноеСредствоГрупповое
	|		ИЗ
	|			ТаблицаИнвентарныеНомера КАК Таб)) КАК ПараметрыАмортизацииОСНУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаИнвентарныеНомера КАК ТаблицаИнвентарныеНомера
	|		ПО ПараметрыАмортизацииОСНУ.ОсновноеСредство = ТаблицаИнвентарныеНомера.ОсновноеСредствоГрупповое";
	
	НомераТаблиц.Вставить("ПараметрыАмортизационнойПремииНалоговыйУчет", НомераТаблиц.Количество());
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	&ДатаЗапроса КАК Период,
	|	ПараметрыАмортизационнойПремииНУ.Организация КАК Организация,
	|	ТаблицаИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредство,
	|	ПараметрыАмортизационнойПремииНУ.СчетУчетаРасходов КАК СчетУчетаРасходов,
	|	ПараметрыАмортизационнойПремииНУ.СубконтоРасходов1 КАК СубконтоРасходов1,
	|	ПараметрыАмортизационнойПремииНУ.СубконтоРасходов2 КАК СубконтоРасходов2,
	|	ПараметрыАмортизационнойПремииНУ.СубконтоРасходов3 КАК СубконтоРасходов3,
	|	ПараметрыАмортизационнойПремииНУ.ПодразделениеРасходов КАК ПодразделениеРасходов
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизационнойПремииНалоговыйУчет.СрезПоследних(&ДатаЗапроса, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			Таб.ОсновноеСредствоГрупповое
	|		ИЗ
	|			ТаблицаИнвентарныеНомера КАК Таб)) КАК ПараметрыАмортизационнойПремииНУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаИнвентарныеНомера КАК ТаблицаИнвентарныеНомера
	|		ПО ПараметрыАмортизационнойПремииНУ.ОсновноеСредство = ТаблицаИнвентарныеНомера.ОсновноеСредствоГрупповое";
	
	НомераТаблиц.Вставить("ПервоначальныеСведенияОСНалоговыйУчет", НомераТаблиц.Количество());
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	&ДатаЗапроса КАК Период,
	|	ПервоначальныеСведенияОСНУ.Организация КАК Организация,
	|	ТаблицаИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредство,
	|	ПервоначальныеСведенияОСНУ.АмортизацияДо2002 КАК АмортизацияДо2002,
	|	ПервоначальныеСведенияОСНУ.АмортизацияДо2009 КАК АмортизацияДо2009,
	|	ПервоначальныеСведенияОСНУ.МетодНачисленияАмортизации КАК МетодНачисленияАмортизации,
	|	ПервоначальныеСведенияОСНУ.ПервоначальнаяСтоимостьНУ КАК ПервоначальнаяСтоимостьНУ,
	|	ПервоначальныеСведенияОСНУ.ПорядокВключенияСтоимостиВСоставРасходов КАК ПорядокВключенияСтоимостиВСоставРасходов,
	|	ПервоначальныеСведенияОСНУ.СтоимостьДо2002 КАК СтоимостьДо2002,
	|	ПервоначальныеСведенияОСНУ.ФактическийСрокИспользованияДо2009 КАК ФактическийСрокИспользованияДо2009,
	|	&ДатаЗапроса КАК ДатаПринятияКУчету,
	|	ПервоначальныеСведенияОСНУ.РасходыНеУчитываетсяНУ КАК РасходыНеУчитываетсяНУ,
	|	ПервоначальныеСведенияОСНУ.РасходыЕНВД КАК РасходыЕНВД
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСНалоговыйУчет.СрезПоследних(&ДатаЗапроса, Организация = &Организация
	|	И ОсновноеСредство = &ОсновноеСредствоГрупповое) КАК ПервоначальныеСведенияОСНУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаИнвентарныеНомера КАК ТаблицаИнвентарныеНомера
	|		ПО ПервоначальныеСведенияОСНУ.ОсновноеСредство = ТаблицаИнвентарныеНомера.ОсновноеСредствоГрупповое";
	
	НомераТаблиц.Вставить("ПервоначальныеСведенияОСНалоговыйУчетУСН", НомераТаблиц.Количество());
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	&ДатаЗапроса КАК Период,
	|	ПервоначальныеСведенияОСНУУСН.Организация КАК Организация,
	|	ТаблицаИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредство,
	|	ПервоначальныеСведенияОСНУУСН.СрокПолезногоИспользованияУСН КАК СрокПолезногоИспользованияУСН,
	|	ПервоначальныеСведенияОСНУУСН.ПорядокВключенияСтоимостиВСоставРасходовУСН КАК ПорядокВключенияСтоимостиВСоставРасходовУСН
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСНалоговыйУчетУСН.СрезПоследних(&ДатаЗапроса, Организация = &Организация
	|	И ОсновноеСредство = &ОсновноеСредствоГрупповое) КАК ПервоначальныеСведенияОСНУУСН
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаИнвентарныеНомера КАК ТаблицаИнвентарныеНомера
	|		ПО ПервоначальныеСведенияОСНУУСН.ОсновноеСредство = ТаблицаИнвентарныеНомера.ОсновноеСредствоГрупповое";
	
КонецПроцедуры	

