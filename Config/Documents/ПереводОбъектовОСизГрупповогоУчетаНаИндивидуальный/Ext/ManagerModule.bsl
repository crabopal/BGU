#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// СтандартныеПодсистемы.ВерсионированиеОбъектов
// Определяет настройки объекта для подсистемы ВерсионированиеОбъектов.
//
// Параметры:
// Настройки - Структура - настройки подсистемы.
Процедура ПриОпределенииНастроекВерсионированияОбъектов(Настройки) Экспорт
КонецПроцедуры
// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#Область Прослеживаемость

// Заполняет таблицу ТаблицаОС по данным документа Объект
//
// Параметры:
//   Объект - ДокументОбъект.ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный - документ - источник данных для заполнения
//   ТаблицаОС - ТаблицаЗначений - выходная таблица. Состав колонок:
//	    НомерСтроки - Число
//	    ОсновноеСредство - СправочникСсылка.ОсновныеСредства
//	    ИдентификаторСтроки - Строка
//	    Количество - Число
//	    ОбщееКоличество - Число
Процедура ДобавитьВТаблицуОССоставДокумента(Объект, ТаблицаОС) Экспорт
	Для каждого СтрокаТЧ из Объект.ИнвентарныеНомера Цикл
		НоваяСтрока = ТаблицаОС.Добавить();
		НоваяСтрока.НомерСтроки = СтрокаТЧ.НомерСтроки;
		НоваяСтрока.ОсновноеСредство = Объект.ОсновноеСредствоГрупповое;
		НоваяСтрока.ИдентификаторСтроки = СтрокаТЧ.ИдентификаторСтроки;
		НоваяСтрока.Количество = 1;
	КонецЦикла;	
КонецПроцедуры	

// Заполняет таблицу ТаблицаОС по данным документа Объект для запроса остатокв РНПТ
//
// Параметры:
//   Объект - ДокументОбъект.ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный - документ - источник данных для заполнения
//   ТаблицаОС - ТаблицаЗначений - выходная таблица. Состав колонок:
//	    ОсновноеСредство - СправочникСсылка.ОсновныеСредства
//	    СтранаПроисхождения - СправочникСсылка.СтраныМира
Процедура ТаблицаОСдляОстатковРНПТ(Объект, ТаблицаОС) Экспорт
	НоваяСтрока = ТаблицаОС.Добавить();
	НоваяСтрока.ОсновноеСредство = Объект.ОсновноеСредствоГрупповое;
	НоваяСтрока.СтранаПроисхождения = Объект.СтранаПроисхождения;
КонецПроцедуры

// Формирует параметры для отражения документа в прослеживаемости.
//
// Параметры:
//   ДокументОбъект - ДокументОбъект.ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный - Документ, для которого формируются параметры
//
// Возвращаемое значение:
//   Структура - Параметры для отражения в прослеживаемости, включая таблицу РНПТ и признак списания
Функция ПараметрыОтраженияВПрослеживаемости(ДокументОбъект) Экспорт
	Результат = ПрослеживаемостьБГУ.ПараметрыОтраженияВПрослеживаемости();
	
	Если ДокументОбъект.Ссылка.Пустая() Тогда
		Период = Новый Граница(ДокументОбъект.Дата, ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	ТипДокументаВПрослеживаемости = ПрослеживаемостьБГУ.ВидСопроводительногоДокументаОтражающегоСодержаниеОперации(
		ДокументОбъект); 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ТипДокументаВПрослеживаемости", ТипДокументаВПрослеживаемости);

	Запрос.Текст = ТекстЗапросаТаблицаРНПТПоДокументу();
	Результат.РНПТ_ОС = Запрос.Выполнить().Выгрузить();
	Результат.ЭтоСписание = Истина;
	
	Возврат Результат;	
КонецФункции

// Формирует текст запроса для получения данных о прослеживаемости при разукомплектации группового объекта ОС.
//
// Возвращаемое значение:
//   Строка - текст запроса для получения данных.
Функция ТекстЗапросаТаблицаРНПТПоДокументу() Экспорт
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТЧСведенияПрослеживаемости.Ссылка.ОсновноеСредствоГрупповое КАК ОсновноеСредство,
	|	ТЧСведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТЧСведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	ТЧСведенияПрослеживаемости.Количество КАК Количество,
	|	ТЧСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ТЧСведенияПрослеживаемости.Комплектующее КАК Комплектующее
	|ПОМЕСТИТЬ РНПТОС
	|ИЗ
	|	Документ.ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный.СведенияПрослеживаемости КАК ТЧСведенияПрослеживаемости
	|ГДЕ
	|	ТЧСведенияПрослеживаемости.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрослеживаемыеОСОстатки.Организация КАК Организация,
	|	ПрослеживаемыеОСОстатки.РНПТ КАК РНПТ,
	|	ПрослеживаемыеОСОстатки.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПрослеживаемыеОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	ПрослеживаемыеОСОстатки.Комплектующее КАК Комплектующее,
	|	ПрослеживаемыеОСОстатки.КоличествоОстаток КАК Количество,
	|	ПрослеживаемыеОСОстатки.КоличествоПрослеживаемостиОстаток КАК КоличествоПрослеживаемости,
	|	ПрослеживаемыеОСОстатки.СуммаБезНДСОстаток КАК СуммаБезНДС
	|ПОМЕСТИТЬ ОстаткиРНПТ
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеОС.Остатки(&Период, Организация = &Организация
	|	И (ОсновноеСредство, РНПТ) В
	|		(ВЫБРАТЬ
	|			Таб.ОсновноеСредство,
	|			Таб.РНПТ
	|		ИЗ
	|			РНПТОС КАК Таб)) КАК ПрослеживаемыеОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумент.Ссылка.Дата КАК Период,
	|	ТаблицаДокумент.Ссылка.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияВОтчетностиПоПрослеживаемости.ПустаяСсылка) КАК ОтражениеВОтчетности,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ПериодОперации,
	|	ТаблицаДокумент.Ссылка КАК ДокументОперации,
	|	РНПТОС.РНПТ КАК РНПТ,
	|	НЕОПРЕДЕЛЕНО КАК Контрагент,
	|	РНПТОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаДокумент.ИнвентарныйНомерВГруппе КАК ИнвентарныйНомер,
	|	ТаблицаДокумент.ОсновноеСредство КАК ОсновноеСредствоНовое,
	|	ТаблицаДокумент.ИнвентарныйНомер КАК ИнвентарныйНомерНовый,
	|	ТаблицаДокумент.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	РНПТОС.Комплектующее КАК Комплектующее,
	|	НЕОПРЕДЕЛЕНО КАК КодОперации,
	|	ВЫБОР
	|		КОГДА РНПТОС.Комплектующее = НЕОПРЕДЕЛЕНО
	|		ИЛИ РНПТОС.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|		ИЛИ РНПТОС.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА РНПТОС.ОсновноеСредство.СтранаПроисхождения
	|		ИНАЧЕ РНПТОС.Комплектующее.СтранаПроисхождения
	|	КОНЕЦ КАК СтранаПроисхождения,
	|	&ТипДокументаВПрослеживаемости КАК ТипДокументаВПрослеживаемости,
	|	ТаблицаДокумент.Ссылка.Номер КАК НомерДокумента,
	|	ТаблицаДокумент.Ссылка.Дата КАК ДатаДокумента,
	|	СУММА(РНПТОС.Количество) КАК Количество,
	|	СУММА(РНПТОС.КоличествоПрослеживаемости) КАК КоличествоПрослеживаемости,
	|	СУММА(ВЫБОР
	|		КОГДА ОстаткиРНПТ.Количество = 0
	|			ТОГДА 0
	|		КОГДА РНПТОС.Количество < ОстаткиРНПТ.Количество
	|			ТОГДА ОстаткиРНПТ.СуммаБезНДС * РНПТОС.Количество / ОстаткиРНПТ.Количество
	|		ИНАЧЕ ОстаткиРНПТ.СуммаБезНДС
	|	КОНЕЦ) КАК СуммаБезНДС
	|ПОМЕСТИТЬ ТабРезультат
	|ИЗ
	|	РНПТОС КАК РНПТОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный.ИнвентарныеНомера КАК ТаблицаДокумент
	|		ПО РНПТОС.ИдентификаторСтроки = ТаблицаДокумент.ИдентификаторСтроки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиРНПТ КАК ОстаткиРНПТ
	|		ПО РНПТОС.ОсновноеСредство = ОстаткиРНПТ.ОсновноеСредство
	|		И РНПТОС.РНПТ = ОстаткиРНПТ.РНПТ
	|		И РНПТОС.Комплектующее = ОстаткиРНПТ.Комплектующее
	|ГДЕ
	|	ТаблицаДокумент.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДокумент.Ссылка,
	|	РНПТОС.РНПТ,
	|	РНПТОС.ОсновноеСредство,
	|	ТаблицаДокумент.ИнвентарныйНомерВГруппе,
	|	ТаблицаДокумент.ОсновноеСредство,
	|	ТаблицаДокумент.ИнвентарныйНомер,
	|	ТаблицаДокумент.ИдентификаторСтроки,
	|	РНПТОС.Комплектующее,
	|	ВЫБОР
	|		КОГДА РНПТОС.Комплектующее = НЕОПРЕДЕЛЕНО
	|		ИЛИ РНПТОС.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|		ИЛИ РНПТОС.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА РНПТОС.ОсновноеСредство.СтранаПроисхождения
	|		ИНАЧЕ РНПТОС.Комплектующее.СтранаПроисхождения
	|	КОНЕЦ,
	|	ТаблицаДокумент.Ссылка.Дата,
	|	ТаблицаДокумент.Ссылка.Организация,
	|	ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияВОтчетностиПоПрослеживаемости.ПустаяСсылка),
	|	ТаблицаДокумент.Ссылка.Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабРезультат.Период КАК Период,
	|	ТабРезультат.Организация КАК Организация,
	|	ТабРезультат.ОтражениеВОтчетности КАК ОтражениеВОтчетности,
	|	ТабРезультат.ПериодОперации КАК ПериодОперации,
	|	ТабРезультат.ДокументОперации КАК ДокументОперации,
	|	ТабРезультат.РНПТ КАК РНПТ,
	|	ТабРезультат.Контрагент КАК Контрагент,
	|	ТабРезультат.ОсновноеСредство КАК ОсновноеСредство,
	|	ТабРезультат.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТабРезультат.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТабРезультат.Комплектующее КАК Комплектующее,
	|	ТабРезультат.КодОперации КАК КодОперации,
	|	ТабРезультат.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ТабРезультат.ТипДокументаВПрослеживаемости КАК ТипДокументаВПрослеживаемости,
	|	ТабРезультат.НомерДокумента КАК НомерДокумента,
	|	ТабРезультат.ДатаДокумента КАК ДатаДокумента,
	|	ИСТИНА КАК ЭтоСписание,
	|	ТабРезультат.Количество КАК Количество,
	|	ТабРезультат.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ТабРезультат.СуммаБезНДС КАК СуммаБезНДС
	|ИЗ
	|	ТабРезультат КАК ТабРезультат
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТабРезультат.Период,
	|	ТабРезультат.Организация,
	|	ТабРезультат.ОтражениеВОтчетности,
	|	ТабРезультат.ПериодОперации,
	|	ТабРезультат.ДокументОперации,
	|	ТабРезультат.РНПТ,
	|	ТабРезультат.Контрагент,
	|	ТабРезультат.ОсновноеСредствоНовое,
	|	ТабРезультат.ИнвентарныйНомерНовый,
	|	ТабРезультат.ИдентификаторСтроки,
	|	ТабРезультат.Комплектующее,
	|	ТабРезультат.КодОперации,
	|	ТабРезультат.СтранаПроисхождения,
	|	ТабРезультат.ТипДокументаВПрослеживаемости,
	|	ТабРезультат.НомерДокумента,
	|	ТабРезультат.ДатаДокумента,
	|	ЛОЖЬ,
	|	ТабРезультат.Количество,
	|	ТабРезультат.КоличествоПрослеживаемости,
	|	ТабРезультат.СуммаБезНДС
	|ИЗ
	|	ТабРезультат КАК ТабРезультат";
	
	Возврат ТекстЗапроса;

КонецФункции

#КонецОбласти

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДокументСсылка, "Организация, Дата, ОсновноеСредствоГрупповое, Номер, ПервичныйДокумент");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ДатаЗапроса", ЗначенияРеквизитов.Дата);
	Запрос.УстановитьПараметр("Организация", ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредствоГрупповое", ЗначенияРеквизитов.ОсновноеСредствоГрупповое);
	Запрос.УстановитьПараметр("НомерПервичногоДокумента", 
		ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ЗначенияРеквизитов.Номер));

	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ТаблицаИнвентарныеНомера", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ОстаткиСтоимостиРН", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ДвиженияСтоимостиРН", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ОстаткиАмортизацииРН", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ДвиженияАмортизацииРН", НомераТаблиц.Количество());
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИнвентарныеНомера.Ссылка.Организация КАК Организация,
	|	ИнвентарныеНомера.Ссылка.ОсновноеСредствоГрупповое КАК ОсновноеСредствоГрупповое,
	|	ИнвентарныеНомера.ИнвентарныйНомерВГруппе КАК ИнвентарныйНомерВГруппе,
	|	ИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредство,
	|	ИнвентарныеНомера.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ИнвентарныеНомера.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки,
	|	ИнвентарныеНомера.ПричинаСписания КАК ПричинаСписания,
	|	ВЫБОР
	|		КОГДА ИнвентарныеНомера.Ссылка.ПервичныйДокумент <> ЗНАЧЕНИЕ(Справочник.ПервичныеДокументы.ПустаяСсылка)
	|			ТОГДА ИнвентарныеНомера.Ссылка.ПервичныйДокумент.ВидПервичногоДокумента 
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НазваниеДокумента,
	|	ВЫБОР
	|		КОГДА ИнвентарныеНомера.Ссылка.ПервичныйДокумент <> ЗНАЧЕНИЕ(Справочник.ПервичныеДокументы.ПустаяСсылка)
	|			ТОГДА &НомерПервичногоДокумента 
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НомерДокумента,
	|	ВЫБОР
	|		КОГДА ИнвентарныеНомера.Ссылка.ПервичныйДокумент <> ЗНАЧЕНИЕ(Справочник.ПервичныеДокументы.ПустаяСсылка)
	|			ТОГДА ИнвентарныеНомера.Ссылка.Дата
	|		ИНАЧЕ ДАТАВРЕМЯ(1,1,1)	
	|	КОНЕЦ КАК ДатаДокумента,
	|	ЕстьNULL(ТаблицаГТ.НаименованиеГТ, """") КАК НаименованиеГТ,
	|	ЕстьNULL(ТаблицаГТ.НомерГТ, """") КАК НомерГТ,
	|	ЕстьNULL(ТаблицаГТ.ДатаГТ, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаГТ,
	|	ЕстьNULL(ТаблицаГТ.СрокДействияГТ, ДАТАВРЕМЯ(1, 1, 1)) КАК СрокДействияГТ
	|ПОМЕСТИТЬ ТаблицаИнвентарныеНомера
	|ИЗ
	|	Документ.ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный.ИнвентарныеНомера КАК ИнвентарныеНомера
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СтоимостьОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|			СтоимостьОбъектовОС.НаименованиеГТ КАК НаименованиеГТ,
	|			СтоимостьОбъектовОС.НомерГТ КАК НомерГТ,
	|			СтоимостьОбъектовОС.ДатаГТ КАК ДатаГТ,
	|			СтоимостьОбъектовОС.СрокДействияГТ КАК СрокДействияГТ
	|		ИЗ
	|			РегистрНакопления.СтоимостьОбъектовОС КАК СтоимостьОбъектовОС
	|		ГДЕ
	|			СтоимостьОбъектовОС.ОсновноеСредство = &ОсновноеСредствоГрупповое
	|			И СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|			И (СтоимостьОбъектовОС.НомерГТ <> """"
	|			ИЛИ СтоимостьОбъектовОС.ДатаГТ <> ДАТАВРЕМЯ(1, 1, 1))) КАК ТаблицаГТ
	|		ПО ИнвентарныеНомера.ИнвентарныйНомерВГруппе = ТаблицаГТ.ИнвентарныйНомер
	|ГДЕ
	|	ИнвентарныеНомера.Ссылка = &ДокументСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСОстатки.Договор КАК Договор,
	|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение,
	|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК Стоимость,
	|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК Количество,
	|	СтоимостьОбъектовОСОстатки.СуммаНеУчитываетсяНУОстаток КАК СуммаНеУчитываетсяНУ,
	|	СтоимостьОбъектовОСОстатки.СуммаЕНВДОстаток КАК СуммаЕНВД,
	|	СтоимостьОбъектовОСОстатки.СуммаНДСОстаток КАК СуммаНДС
	|ПОМЕСТИТЬ ОстаткиСтоимостиРН
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&ДатаЗапроса, Организация = &Организация
	|	И ОсновноеСредство = &ОсновноеСредствоГрупповое
	|	И ВидРаспоряжения = Значение(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|	И ИнвентарныйНомер В
	|		(ВЫБРАТЬ
	|			Таб.ИнвентарныйНомерВГруппе
	|		ИЗ
	|			ТаблицаИнвентарныеНомера КАК Таб)) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостьОбъектовОС.Период КАК Период,
	|	СтоимостьОбъектовОС.ВидДвижения КАК ВидДвижения,
	|	СтоимостьОбъектовОС.ВидРаспоряжения КАК ВидРаспоряжения,
	|	СтоимостьОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОС.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОС.Договор КАК Договор,
	|	СтоимостьОбъектовОС.Подразделение КАК Подразделение,
	|	СтоимостьОбъектовОС.Стоимость КАК Стоимость,
	|	СтоимостьОбъектовОС.Количество КАК Количество,
	|	СтоимостьОбъектовОС.СуммаНеУчитываетсяНУ КАК СуммаНеУчитываетсяНУ,
	|	СтоимостьОбъектовОС.СуммаЕНВД КАК СуммаЕНВД,
	|	СтоимостьОбъектовОС.СуммаНДС КАК СуммаНДС,
	|	СтоимостьОбъектовОС.Событие КАК Событие,
	|	СтоимостьОбъектовОС.ДатаСобытия КАК ДатаСобытия,
	|	СтоимостьОбъектовОС.НазваниеДокумента КАК НазваниеДокумента,
	|	СтоимостьОбъектовОС.НомерДокумента КАК НомерДокумента,
	|	СтоимостьОбъектовОС.ДатаДокумента КАК ДатаДокумента,
	|	СтоимостьОбъектовОС.Причина КАК Причина,
	|	СтоимостьОбъектовОС.ВидРаботы КАК ВидРаботы,
	|	СтоимостьОбъектовОС.ДоговорИсполнителя КАК ДоговорИсполнителя,
	|	СтоимостьОбъектовОС.НаименованиеГТ КАК НаименованиеГТ,
	|	СтоимостьОбъектовОС.НомерГТ КАК НомерГТ,
	|	СтоимостьОбъектовОС.ДатаГТ КАК ДатаГТ,
	|	СтоимостьОбъектовОС.СрокДействияГТ КАК СрокДействияГТ
	|ПОМЕСТИТЬ ДвиженияСтоимостиРН
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС КАК СтоимостьОбъектовОС
	|ГДЕ
	|	СтоимостьОбъектовОС.Активность
	|	И СтоимостьОбъектовОС.Организация = &Организация
	|	И СтоимостьОбъектовОС.Период < &ДатаЗапроса
	|	И СтоимостьОбъектовОС.ОсновноеСредство = &ОсновноеСредствоГрупповое
	|	И СтоимостьОбъектовОС.ИнвентарныйНомер В
	|		(ВЫБРАТЬ
	|			Таб.ИнвентарныйНомерВГруппе
	|		ИЗ
	|			ТаблицаИнвентарныеНомера КАК Таб)
	|	И СтоимостьОбъектовОС.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АмортизацияОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	АмортизацияОбъектовОСОстатки.СуммаАмортизацииОстаток КАК СуммаАмортизации,
	|	АмортизацияОбъектовОСОстатки.СуммаОбесцененияОстаток КАК СуммаОбесценения
	|ПОМЕСТИТЬ ОстаткиАмортизацииРН
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС.Остатки(&ДатаЗапроса, Организация = &Организация
	|	И ОсновноеСредство = &ОсновноеСредствоГрупповое
	|	И ИнвентарныйНомер В
	|		(ВЫБРАТЬ
	|			Таб.ИнвентарныйНомерВГруппе
	|		ИЗ
	|			ТаблицаИнвентарныеНомера КАК Таб)) КАК АмортизацияОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АмортизацияОбъектовОС.Период КАК Период,
	|	АмортизацияОбъектовОС.ВидДвижения КАК ВидДвижения,
	|	АмортизацияОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	АмортизацияОбъектовОС.СуммаАмортизации КАК СуммаАмортизации,
	|	АмортизацияОбъектовОС.СуммаОбесценения КАК СуммаОбесценения,
	|	АмортизацияОбъектовОС.ДатаСобытия КАК ДатаСобытия,
	|	АмортизацияОбъектовОС.ЭтоСписание КАК ЭтоСписание
	|ПОМЕСТИТЬ ДвиженияАмортизацииРН
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС КАК АмортизацияОбъектовОС
	|ГДЕ
	|	АмортизацияОбъектовОС.Активность
	|	И АмортизацияОбъектовОС.Период < &ДатаЗапроса
	|	И АмортизацияОбъектовОС.Организация = &Организация
	|	И АмортизацияОбъектовОС.ИнвентарныйНомер В
	|		(ВЫБРАТЬ
	|			Таб.ИнвентарныйНомерВГруппе
	|		ИЗ
	|			ТаблицаИнвентарныеНомера КАК Таб)";

	ЗапросыПоБУ(ТекстЗапроса, НомераТаблиц);
	ЗапросыПоДрагМеталлам(ТекстЗапроса, НомераТаблиц);
	ЗапросыПоНУ(ТекстЗапроса, НомераТаблиц);
	
	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
	
	// Рассчитаем оставшийся срока полезного использования по общему алгоритму. Его достаточно посчитать по первой 
	// строке, т.к. от инвентарного номера он не зависит. 
	Строка1 = СтруктураДополнительныеСвойства.ТаблицыДляДвижений.РасчетАмортизацииОС[0];	
	ОставшийсяСПИ = УправлениеОсновнымиСредствамиКлиентСервер.ОставшийсяСрокПолезногоИспользования(
		Строка1.ДатаВводаВЭксплуатацию,
		Строка1.СрокПолезногоИспользования,
		Строка1.Период);
	ОставшийсяСПИ = ?(ОставшийсяСПИ < 0, 0, ОставшийсяСПИ);

	// Установим оставшийся СПИ во все строки для РН.РасчетАмортизацииОС
	Для каждого ТекСтрока из СтруктураДополнительныеСвойства.ТаблицыДляДвижений.РасчетАмортизацииОС Цикл
		ТекСтрока.СрокИспользованияДляВычисленияАмортизации = ОставшийсяСПИ;
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗапросыПоБУ(ТекстЗапроса, НомераТаблиц)
	НомераТаблиц.Вставить("АмортизацияОС", НомераТаблиц.Количество());
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДатаЗапроса КАК Период,
	|	АмортизацияОС.Организация КАК Организация,
	|	ТаблицаИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОС.СчетУчетаЗатрат КАК СчетУчетаЗатрат,
	|	АмортизацияОС.Подразделение КАК Подразделение,
	|	АмортизацияОС.КПС КАК КПС,
	|	АмортизацияОС.КЭК КАК КЭК,
	|	АмортизацияОС.Субконто1 КАК Субконто1,
	|	АмортизацияОС.Субконто2 КАК Субконто2,
	|	АмортизацияОС.Субконто3 КАК Субконто3,
	|	АмортизацияОС.СубконтоНУ КАК СубконтоНУ
	|ИЗ
	|	РегистрСведений.АмортизацияОС.СрезПоследних(&ДатаЗапроса, Организация = &Организация
	|	И ОсновноеСредство = &ОсновноеСредствоГрупповое) КАК АмортизацияОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаИнвентарныеНомера КАК ТаблицаИнвентарныеНомера
	|		ПО АмортизацияОС.ОсновноеСредство = ТаблицаИнвентарныеНомера.ОсновноеСредствоГрупповое";
	
	НомераТаблиц.Вставить("НачислениеАмортизацииОСБухгалтерскийУчет", НомераТаблиц.Количество());
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДатаЗапроса КАК Период,
	|	НачислениеАмортизацииОСБУ.Организация КАК Организация,
	|	ТаблицаИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредство,
	|	НачислениеАмортизацииОСБУ.НачислятьАмортизацию КАК НачислятьАмортизацию
	|ИЗ
	|	РегистрСведений.НачислениеАмортизацииОСБухгалтерскийУчет.СрезПоследних(&ДатаЗапроса, Организация = &Организация
	|	И ОсновноеСредство = &ОсновноеСредствоГрупповое) КАК НачислениеАмортизацииОСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаИнвентарныеНомера КАК ТаблицаИнвентарныеНомера
	|		ПО НачислениеАмортизацииОСБУ.ОсновноеСредство = ТаблицаИнвентарныеНомера.ОсновноеСредствоГрупповое";
	
	НомераТаблиц.Вставить("НомераИнвентарныхКарточек", НомераТаблиц.Количество());
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	&ДатаЗапроса КАК Период,
	|	ТаблицаИнвентарныеНомера.Организация КАК Организация,
	|	ТаблицаИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаИнвентарныеНомера.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки,
	|	&ДатаЗапроса КАК ДатаИнвентарнойКарточки
	|ИЗ
	|	ТаблицаИнвентарныеНомера КАК ТаблицаИнвентарныеНомера
	|";
	
	НомераТаблиц.Вставить("ПараметрыАмортизацииОСБухгалтерскийУчет", НомераТаблиц.Количество());
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДатаЗапроса КАК Период,
	|	ПараметрыАмортизацииОСБУ.Организация КАК Организация,
	|	ТаблицаИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредство,
	|	ПараметрыАмортизацииОСБУ.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ПараметрыАмортизацииОСБУ.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(&ДатаЗапроса, Организация = &Организация
	|	И ОсновноеСредство = &ОсновноеСредствоГрупповое) КАК ПараметрыАмортизацииОСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаИнвентарныеНомера КАК ТаблицаИнвентарныеНомера
	|		ПО ПараметрыАмортизацииОСБУ.ОсновноеСредство = ТаблицаИнвентарныеНомера.ОсновноеСредствоГрупповое";
	
	НомераТаблиц.Вставить("ПервоначальныеСведенияОСБухгалтерскийУчет", НомераТаблиц.Количество());
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДатаЗапроса КАК Период,
	|	ПервоначальныеСведенияОСБУ.Организация КАК Организация,
	|	ТаблицаИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредство,
	|	ПервоначальныеСведенияОСБУ.ПервоначальнаяСтоимость КАК ПервоначальнаяСтоимость,
	|	ЕСТЬNULL(ОстаткиАмортизацииРН.СуммаАмортизации, 0) КАК ПервоначальнаяСуммаАмортизации,
	|	ЕСТЬNULL(ОстаткиАмортизацииРН.СуммаОбесценения, 0) КАК ПервоначальнаяСуммаОбесценения,
	|	ПервоначальныеСведенияОСБУ.ПервоначальнаяСтоимостьВВалюте КАК ПервоначальнаяСтоимостьВВалюте,
	|	ПервоначальныеСведенияОСБУ.ВалютаПоступления КАК ВалютаПоступления,
