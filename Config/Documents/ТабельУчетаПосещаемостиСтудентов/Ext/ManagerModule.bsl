#Область ПрограммныйИнтерфейс

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
 
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "НачалоПериода, Ссылка, Организация, Факультет, Дата");  
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПериодТабеля", РеквизитыДокумента.НачалоПериода);
	Запрос.УстановитьПараметр("Ссылка", РеквизитыДокумента.Ссылка);
	Запрос.УстановитьПараметр("Организация", РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("Факультет", РеквизитыДокумента.Факультет);
	Запрос.УстановитьПараметр("Дата", РеквизитыДокумента.Дата);
	
	Если ДокументСсылка.ВидТабеля = 0 Тогда
		Запрос.Текст = "ВЫБРАТЬ
					   |	&Ссылка КАК Регистратор,
					   |	&Организация КАК Организация,
		               |	&Факультет КАК Факультет,
					   |	НевыходыПоДням.ДатаНевыхода КАК Период,
		               |	НевыходыПоДням.ГруппаСтудентов КАК ГруппаСтудентов,
		               |	НевыходыПоДням.Студент КАК Студент,
					   |	ВЫБОР
					   |		КОГДА НевыходыПоДням.ВидНевыхода = 1 ТОГДА 1
					   |		ИНАЧЕ 0
					   |	КОНЕЦ КАК НеоплачиваемыеНевыходы,
		               |	ВЫБОР
					   |		КОГДА НевыходыПоДням.ВидНевыхода = -1 ТОГДА 1
					   |		ИНАЧЕ 0
					   |	КОНЕЦ КАК ОплачиваемыеНевыходы,
		               |	НевыходыПоДням.ПричиныНевыходов КАК ПричиныНевыходов
		               |ИЗ
		               |	Документ.ТабельУчетаПосещаемостиСтудентов.НевыходыПоДням КАК НевыходыПоДням
					   |ГДЕ
					   |	НевыходыПоДням.Ссылка = &Ссылка";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
					   |	&Ссылка КАК Регистратор,
		               |	&Организация КАК Организация,
		               |	&Факультет КАК Факультет,
					   |	НАЧАЛОПЕРИОДА(&ПериодТабеля, ДЕНЬ) КАК Период, //ДатаНевыхода,
					   |	НевыходыСводно.ГруппаСтудентов КАК ГруппаСтудентов,
					   |	НевыходыСводно.Студент КАК Студент,
					   |	НевыходыСводно.ОплачиваемыеНевыходы КАК ОплачиваемыеНевыходы,
					   |	НевыходыСводно.НеоплачиваемыеНевыходы КАК НеоплачиваемыеНевыходы,
					   |	НевыходыСводно.ПричиныНевыходов КАК ПричиныНевыходов
		               |ИЗ
		               |	Документ.ТабельУчетаПосещаемостиСтудентов.НевыходыСводно КАК НевыходыСводно
		               |ГДЕ
		               |	НевыходыСводно.Ссылка = &Ссылка
					   |	И (НевыходыСводно.ОплачиваемыеНевыходы <> 0
					   |		ИЛИ НевыходыСводно.НеоплачиваемыеНевыходы <> 0)
					   |";
	КонецЕсли;			   
	
	Результат = Запрос.Выполнить().Выгрузить();			   
	
	ТаблицыДляДвижений.Вставить("ТабельУчетаПосещаемостиСтудентов", Результат);

КонецПроцедуры

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ТабельУчетаПосещаемостиСтудентов";
	КомандаПечати.Идентификатор = "ПФ_MXL_ТабельУчетаПосещаемостиСтудентовПоДням";
	КомандаПечати.Представление = Нстр("ru='Табель учета посещаемости учащихся (по дням)'");
	КомандаПечати.Порядок = 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ТабельУчетаПосещаемостиСтудентов";
	КомандаПечати.Идентификатор = "ПФ_MXL_ТабельУчетаПосещаемостиСтудентовСводно";
	КомандаПечати.Представление = Нстр("ru='Табель учета посещаемости учащихся (сводно)'");
	КомандаПечати.Порядок = 2;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Проверяем, нужно ли для макета ЗаявкаНаКассовыйРасход0531801 формировать табличный документ.
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ТабельУчетаПосещаемостиСтудентовПоДням") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_ТабельУчетаПосещаемостиСтудентовПоДням",
			"Табель учета посещаемости студентов (по дням)",
			ПечатьТабеляУчетаПосещаемостиПоДням(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ТабельУчетаПосещаемостиСтудентовПоДням"));
	ИначеЕсли
		УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ТабельУчетаПосещаемостиСтудентовСводно") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_ТабельУчетаПосещаемостиСтудентовСводно",
			"Табель учета посещаемости студентов (сводно)",
			ПечатьТабеляУчетаПосещаемостиСводно(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ТабельУчетаПосещаемостиСтудентовСводно"));
	КонецЕсли;

КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьТабеляУчетаПосещаемостиПоДням(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.РазмерСтраницы = "A4";
	ТабДокумент.ИмяПараметровПечати = "ПараметрыПечати_ТабельУчетаПосещаемостиСтудентовПоДням";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ТабельУчетаПосещаемостиСтудентов."+ИмяМакета);
	ОблЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОблСтрока = Макет.ПолучитьОбласть("Строка");
	ОблИтого = Макет.ПолучитьОбласть("Итого");
	ОблПодвал = Макет.ПолучитьОбласть("Подвал");
	
	Для Каждого Ссылка Из МассивОбъектов Цикл
		Если Ссылка.ВидТабеля <> 0 Тогда
			ТекстСообщения = НСтр("ru='Не верная печатная форма (вариант ""По дням"") для документа ""%1"" (вид табеля: ""Сводно"")!'");
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Ссылка));
			
			Продолжить;
		КонецЕсли;
		
		ДанныеДляПечати = ПодготовитьДанныеДляПечатиПоДням(Ссылка);
		
		ОблЗаголовок.Параметры.Заполнить(ДанныеДляПечати.Заголовок);
		ТабДокумент.Вывести(ОблЗаголовок);
		
		К = 1;
		Для Каждого Стр Из ДанныеДляПечати.Строки Цикл
			ОблСтрока.Параметры.Заполнить(Стр);
			ОблСтрока.Параметры.НомерСчета = Стр.Студент.Код;
			ОблСтрока.Параметры.Нпп = К;
			
			ТабДокумент.Вывести(ОблСтрока);
			
			К = К + 1;
		КонецЦикла;
		
		ОблИтого.Параметры.Заполнить(ДанныеДляПечати.Итого[0]);
		ТабДокумент.Вывести(ОблИтого);
		
		ОблПодвал.Параметры.Заполнить(ДанныеДляПечати.Подвал);
		ТабДокумент.Вывести(ОблПодвал);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 1, ОбъектыПечати, Ссылка);
	КонецЦикла;
	
	Возврат ТабДокумент;
КонецФункции

Функция ПечатьТабеляУчетаПосещаемостиСводно(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.РазмерСтраницы = "A4";
	ТабДокумент.ИмяПараметровПечати = "ПараметрыПечати_ТабельУчетаПосещаемостиСтудентовСводно";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ТабельУчетаПосещаемостиСтудентов."+ИмяМакета);
	ОблЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОблСтрока = Макет.ПолучитьОбласть("Строка");
	ОблИтог = Макет.ПолучитьОбласть("Итог");
	ОблПодвал = Макет.ПолучитьОбласть("Подвал");
	
	Для Каждого Ссылка Из МассивОбъектов Цикл
		Если Ссылка.ВидТабеля <> 1 Тогда
			ТекстСообщения = НСтр("ru='Не верная печатная форма (вариант ""Сводно"") для документа ""%1"" (вид табеля: ""По дням"")!'");
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Ссылка));
			
			Продолжить;
		КонецЕсли;
		
		ДанныеДляПечати = ПодготовитьДанныеДляПечатиСводно(Ссылка);
		
		ОблЗаголовок.Параметры.Заполнить(ДанныеДляПечати.Заголовок);
		ТабДокумент.Вывести(ОблЗаголовок);
		
		Для Каждого Стр Из ДанныеДляПечати.Строки Цикл
			ОблСтрока.Параметры.Заполнить(Стр);
			ТабДокумент.Вывести(ОблСтрока);
		КонецЦикла;
		
		ОблИтог.Параметры.Заполнить(ДанныеДляПечати.Итог);
		ТабДокумент.Вывести(ОблИтог);
		
		ОблПодвал.Параметры.Заполнить(ДанныеДляПечати.Подвал);
		ТабДокумент.Вывести(ОблПодвал);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 1, ОбъектыПечати, Ссылка);
	КонецЦикла;
	
	Возврат ТабДокумент;
КонецФункции

Функция ПодготовитьДанныеДляПечатиСводно(Ссылка)
	Результат = Новый Структура("Заголовок,Строки,Итог,Подвал");
	
	Организация = Ссылка.Организация;
	
	Заголовок = Новый Структура;
	Заголовок.Вставить("Период", ПредставлениеПериода(НачалоДня(Ссылка.НачалоПериода), КонецДня(Ссылка.КонецПериода)));
	Заголовок.Вставить("Дата", Ссылка.Дата);
	Заголовок.Вставить("ПоОКУД", "");
	Заголовок.Вставить("ПоОКПО", Организация.КодОКПО);
	Заголовок.Вставить("Организация", ?(Организация.ИспользоватьВПлатежныхДокументахСокращенноеНаименование, Организация.НаименованиеСокращенное, Организация.НаименованиеПолное));
	Заголовок.Вставить("Факультет", Ссылка.Факультет);
	Заголовок.Вставить("ГруппаСтудентов", Ссылка.ГруппаСтудентов);
	Результат.Заголовок = Заголовок;
	
	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("Нпп", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10, 0));
	Строки.Колонки.Добавить("ГруппаСтудентов", Новый ОписаниеТипов("СправочникСсылка.ГруппыСтудентов"));
	Строки.Колонки.Добавить("Студент", Новый ОписаниеТипов("СправочникСсылка.Студенты"));
	Строки.Колонки.Добавить("Нн", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(2, 0));
	Строки.Колонки.Добавить("Но", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(2, 0));
	Строки.Колонки.Добавить("ПричиныНевыходов", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(0));
	
	К = 1;
	Для Каждого Стр Из Ссылка.НевыходыСводно Цикл
		Строка = Строки.Добавить();
		Строка.Нпп = К;
		Строка.ГруппаСтудентов = Стр.ГруппаСтудентов;
		Строка.Студент = Стр.Студент;
		Строка.Нн = Стр.НеоплачиваемыеНевыходы;
		Строка.Но = Стр.ОплачиваемыеНевыходы;
		Строка.ПричиныНевыходов = Стр.ПричиныНевыходов;
		
		К = К + 1;
	КонецЦикла;
	Результат.Строки = Строки;
	
	Результат.Итог = Новый Структура("Нн,Но", Строки.Итог("Нн"), Строки.Итог("Но"));
	
	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизацииСсылка("Руководитель", Организация, Ссылка.Дата, Неопределено);
	
	Подвал = Новый Структура;
	Подвал.Вставить("Дата", Ссылка.Дата);
	Подвал.Вставить("Руководитель", Корреспонденты.ФИОПоОбъекту(Руководитель, ИСТИНА));
	
	Результат.Подвал = Подвал;
	
	Возврат Результат;	
КонецФункции

Функция ПодготовитьДанныеДляПечатиПоДням(Ссылка)
	Результат = Новый Структура("Заголовок,Строки,Итого,Подвал");
	
	Организация = Ссылка.Организация;
	
	Заголовок = Новый Структура;
	Заголовок.Вставить("Период", ПредставлениеПериода(НачалоДня(Ссылка.НачалоПериода), КонецДня(Ссылка.КонецПериода)));
	Заголовок.Вставить("Организация", ?(Организация.ИспользоватьВПлатежныхДокументахСокращенноеНаименование, Организация.НаименованиеСокращенное, Организация.НаименованиеПолное));
	Заголовок.Вставить("Факультет", Ссылка.Факультет);
	Заголовок.Вставить("ГруппаСтудентов", Ссылка.ГруппаСтудентов);
	Заголовок.Вставить("Дата", Ссылка.Дата);
	Заголовок.Вставить("КодОКУД", "");
	Заголовок.Вставить("КодОКПО", Организация.КодОКПО);
	Результат.Заголовок = Заголовок;
	
	КалендарныйГрафик = РаботаСоСтудентами.ПолучитьКалендарныйГрафикГруппы(Ссылка.ГруппаСтудентов, Ссылка.НачалоПериода);
	
	ТабСтудентов = ТаблицаСтудентов(Ссылка.НачалоПериода, Ссылка.КонецПериода, Организация, Ссылка.Факультет, Ссылка.ГруппаСтудентов);
	ТабДней = ТаблицаДнейМесяца(Ссылка.НачалоПериода, Ссылка.КонецПериода, Ссылка.КоличествоДнейВМесяце, Ссылка.КоличествоРабочихДней, КалендарныйГрафик, Ложь);
	ТаблицаДляПечати = ПолучитьПересечениеТаблиц(ТабСтудентов, ТабДней);
	
	ТаблицаДляПечати.Колонки.Добавить("ПропущеноВсего", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10,0));
	ТаблицаДляПечати.Колонки.Добавить("ПропущеноОплачиваемых", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10,0));
	ТаблицаДляПечати.Колонки.Добавить("ДнейКОплате", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10,0));
	
	ТаблицаДляПечати(Ссылка, ТаблицаДляПечати);
	
	Если Ссылка.КоличествоДнейВМесяце < 31 Тогда
		Для К = (Ссылка.КоличествоДнейВМесяце + 1) По 31 Цикл
			ТаблицаДляПечати.ЗаполнитьЗначения("-", "Д"+К);
		КонецЦикла;
	КонецЕсли;
	Результат.Строки = ТаблицаДляПечати;
	
	ТабИтог = Новый ТаблицаЗначений;
	ПодготовитьИтоговуюТаблицу(ТабИтог, ТаблицаДляПечати);
	Результат.Итого = ТабИтог;
	
	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизацииСсылка("Руководитель", Организация, Ссылка.Дата, Неопределено);
	
	Подвал = Новый Структура;
	Подвал.Вставить("Дата", Ссылка.Дата);
	Подвал.Вставить("Руководитель", Корреспонденты.ФИОПоОбъекту(Руководитель, ИСТИНА));
	
	Результат.Подвал = Подвал;
	
	Возврат Результат;
КонецФункции

Функция ТаблицаСтудентов(НачалоПериода, КонецПериода, Организация, Факультет, ГруппаСтудентов) Экспорт
	
	КалендарныйГрафик = РаботаСоСтудентами.ПолучитьКалендарныйГрафикГруппы(ГруппаСтудентов, НачалоПериода);
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Студенты.Ссылка КАК Студент
	               |ПОМЕСТИТЬ СписокСтудентов
	               |ИЗ
	               |	Справочник.Студенты КАК Студенты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			СведенияОСтудентахСрезПоследних.Студент КАК Студент,
	               |			СведенияОСтудентахСрезПоследних.Факультет КАК Факультет
	               |		ИЗ
	               |			РегистрСведений.СведенияОСтудентах.СрезПоследних(&КонецПериода, Факультет = &Факультет) КАК СведенияОСтудентахСрезПоследних
	               |		ГДЕ
	               |			СведенияОСтудентахСрезПоследних.Студент.Организация = &Организация
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			СведенияОСтудентахСрезПоследних.Студент,
	               |			СведенияОСтудентахСрезПоследних.Факультет) КАК ВложенныйЗапрос
	               |		ПО Студенты.Ссылка = ВложенныйЗапрос.Студент
	               |ГДЕ
	               |	Студенты.Организация = &Организация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	&НачалоПериода КАК НачалоПериода,
	               |	NULL КАК ОкончаниеПериода,
	               |	СведенияОСтудентахСрезПоследних.Студент КАК Студент,
	               |	СведенияОСтудентахСрезПоследних.Факультет КАК Факультет,
	               |	СведенияОСтудентахСрезПоследних.Договор КАК Договор,
	               |	СведенияОСтудентахСрезПоследних.Значение КАК СостояниеСтудента,
	               |	СведенияОСтудентахГруппа.Значение КАК ГруппаСтудента
	               |ПОМЕСТИТЬ СостояниеСтудентовПодготовка
	               |ИЗ
	               |	РегистрСведений.СведенияОСтудентах.СрезПоследних(
	               |			&НачалоПериода,
	               |			Студент В
	               |					(ВЫБРАТЬ
	               |						СписокСтудентов.Студент
	               |					ИЗ
	               |						СписокСтудентов КАК СписокСтудентов)
	               |				И Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СостояниеСтудента)
	               |				И Факультет = &Факультет) КАК СведенияОСтудентахСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСтудентах.СрезПоследних(
	               |				&НачалоПериода,
	               |				Студент В
	               |						(ВЫБРАТЬ
	               |							СписокСтудентов.Студент
	               |						ИЗ
	               |							СписокСтудентов КАК СписокСтудентов)
	               |					И Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.Группа)
	               |					И Факультет = &Факультет) КАК СведенияОСтудентахГруппа
	               |		ПО СведенияОСтудентахСрезПоследних.Студент = СведенияОСтудентахГруппа.Студент
	               |			И СведенияОСтудентахСрезПоследних.Договор = СведенияОСтудентахГруппа.Договор
	               |ГДЕ
	               |	ВЫРАЗИТЬ(СведенияОСтудентахСрезПоследних.Значение КАК Справочник.СостоянияСтудентов).ДействуетНачисление
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(СведенияОСтудентах.Значение КАК Справочник.СостоянияСтудентов).ДействуетНачисление
	               |			ТОГДА СведенияОСтудентах.Период
	               |		ИНАЧЕ NULL
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА НЕ ВЫРАЗИТЬ(СведенияОСтудентах.Значение КАК Справочник.СостоянияСтудентов).ДействуетНачисление
	               |			ТОГДА ВЫБОР
	               |					КОГДА ВЫРАЗИТЬ(СведенияОСтудентах.Значение КАК Справочник.СостоянияСтудентов).НачислятьВДеньПриказа
	               |						ТОГДА СведенияОСтудентах.Период
	               |					ИНАЧЕ ДОБАВИТЬКДАТЕ(СведенияОСтудентах.Период, ДЕНЬ, -1)
	               |				КОНЕЦ
	               |		ИНАЧЕ NULL
	               |	КОНЕЦ,
	               |	СведенияОСтудентах.Студент,
	               |	СведенияОСтудентах.Факультет,
	               |	СведенияОСтудентах.Договор,
	               |	СведенияОСтудентах.Значение,
	               |	СведенияОСтудентахГруппа.ГруппаСтудента
	               |ИЗ
	               |	РегистрСведений.СведенияОСтудентах КАК СведенияОСтудентах
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			СведенияОСтудентах.Студент КАК Студент,
	               |			СведенияОСтудентах.Значение КАК ГруппаСтудента,
	               |			СведенияОСтудентах.Договор КАК Договор
	               |		ИЗ
	               |			РегистрСведений.СведенияОСтудентах КАК СведенияОСтудентах
	               |		ГДЕ
	               |			СведенияОСтудентах.Период МЕЖДУ &НачалоПериода И &КонецПериода
	               |			И СведенияОСтудентах.Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.Группа)
	               |			И СведенияОСтудентах.Студент В
	               |					(ВЫБРАТЬ
	               |						СписокСтудентов.Студент
	               |					ИЗ
	               |						СписокСтудентов КАК СписокСтудентов)
	               |			И СведенияОСтудентах.Факультет = &Факультет) КАК СведенияОСтудентахГруппа
	               |		ПО СведенияОСтудентах.Студент = СведенияОСтудентахГруппа.Студент
	               |			И СведенияОСтудентах.Договор = СведенияОСтудентахГруппа.Договор
	               |ГДЕ
	               |	СведенияОСтудентах.Период МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И СведенияОСтудентах.Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СостояниеСтудента)
	               |	И СведенияОСтудентах.Студент В
	               |			(ВЫБРАТЬ
	               |				СписокСтудентов.Студент
	               |			ИЗ
	               |				СписокСтудентов КАК СписокСтудентов)
	               |	И СведенияОСтудентах.Факультет = &Факультет
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	NULL,
	               |	&КонецПериода,
	               |	СведенияОСтудентахСрезПоследних.Студент,
	               |	СведенияОСтудентахСрезПоследних.Факультет,
	               |	СведенияОСтудентахСрезПоследних.Договор,
	               |	СведенияОСтудентахСрезПоследних.Значение,
	               |	СведенияОСтудентахГруппа.Значение
	               |ИЗ
	               |	РегистрСведений.СведенияОСтудентах.СрезПоследних(
	               |			&КонецПериода,
	               |			Студент В
	               |					(ВЫБРАТЬ
	               |						СписокСтудентов.Студент
	               |					ИЗ
	               |						СписокСтудентов КАК СписокСтудентов)
	               |				И Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СостояниеСтудента)
	               |				И Факультет = &Факультет) КАК СведенияОСтудентахСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСтудентах.СрезПоследних(
	               |				&КонецПериода,
	               |				Студент В
	               |						(ВЫБРАТЬ
	               |							СписокСтудентов.Студент
	               |						ИЗ
	               |							СписокСтудентов КАК СписокСтудентов)
	               |					И Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.Группа)
	               |					И Факультет = &Факультет) КАК СведенияОСтудентахГруппа
	               |		ПО СведенияОСтудентахСрезПоследних.Студент = СведенияОСтудентахГруппа.Студент
	               |			И СведенияОСтудентахСрезПоследних.Договор = СведенияОСтудентахГруппа.Договор
	               |ГДЕ
	               |	ВЫРАЗИТЬ(СведенияОСтудентахСрезПоследних.Значение КАК Справочник.СостоянияСтудентов).ДействуетНачисление
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СостояниеСтудентовПодготовка.НачалоПериода КАК НачалоПериода,
	               |	СостояниеСтудентовПодготовкаВл.ОкончаниеПериода КАК ОкончаниеПериода,
	               |	СостояниеСтудентовПодготовка.Студент КАК Студент,
	               |	СостояниеСтудентовПодготовка.Факультет КАК Факультет,
	               |	СостояниеСтудентовПодготовка.Договор КАК Договор,
	               |	СостояниеСтудентовПодготовка.СостояниеСтудента КАК СостояниеСтудента,
	               |	СостояниеСтудентовПодготовка.ГруппаСтудента КАК ГруппаСтудента,
	               |	СостояниеСтудентовПодготовка.Студент.Наименование КАК ИмяСтудента,
	               |	ЕСТЬNULL(ГрафикиРаботыГруппСтудентовСрезПоследних.ГрафикРаботы, НЕОПРЕДЕЛЕНО) КАК ГрафикРаботы
	               |ПОМЕСТИТЬ СтудентыПериоды
	               |ИЗ
	               |	СостояниеСтудентовПодготовка КАК СостояниеСтудентовПодготовка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			СостояниеСтудентовПодготовка.ОкончаниеПериода КАК ОкончаниеПериода,
	               |			СостояниеСтудентовПодготовка.Студент КАК Студент,
	               |			СостояниеСтудентовПодготовка.Факультет КАК Факультет,
	               |			СостояниеСтудентовПодготовка.Договор КАК Договор
	               |		ИЗ
	               |			СостояниеСтудентовПодготовка КАК СостояниеСтудентовПодготовка
	               |		ГДЕ
	               |			НЕ СостояниеСтудентовПодготовка.ОкончаниеПериода ЕСТЬ NULL) КАК СостояниеСтудентовПодготовкаВл
	               |		ПО СостояниеСтудентовПодготовка.Студент = СостояниеСтудентовПодготовкаВл.Студент
	               |			И СостояниеСтудентовПодготовка.Факультет = СостояниеСтудентовПодготовкаВл.Факультет
	               |			И СостояниеСтудентовПодготовка.Договор = СостояниеСтудентовПодготовкаВл.Договор
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикиРаботыГруппСтудентов.СрезПоследних(&НачалоПериода) КАК ГрафикиРаботыГруппСтудентовСрезПоследних
	               |		ПО СостояниеСтудентовПодготовка.ГруппаСтудента = ГрафикиРаботыГруппСтудентовСрезПоследних.ГруппаСтудентов
	               |ГДЕ
	               |	НЕ СостояниеСтудентовПодготовка.НачалоПериода ЕСТЬ NULL
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СтудентыПериоды.НачалоПериода КАК НачалоПериода,
	               |	СтудентыПериоды.ОкончаниеПериода КАК ОкончаниеПериода,
	               |	СтудентыПериоды.Студент КАК Студент,
	               |	СтудентыПериоды.Факультет КАК Факультет,
	               |	СтудентыПериоды.СостояниеСтудента КАК СостояниеСтудента,
	               |	СтудентыПериоды.ГруппаСтудента КАК ГруппаСтудентов,
	               |	СтудентыПериоды.ИмяСтудента КАК ИмяСтудента,
	               |	СтудентыПериоды.ГрафикРаботы КАК ГрафикРаботы
	               |ИЗ
	               |	СтудентыПериоды КАК СтудентыПериоды
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА &ГруппаСтудентов <> ЗНАЧЕНИЕ(Справочник.ГруппыСтудентов.ПустаяСсылка)
	               |				ТОГДА СтудентыПериоды.ГруппаСтудента = &ГруппаСтудентов
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &КалендарныйГрафик = НЕОПРЕДЕЛЕНО
	               |				ТОГДА СтудентыПериоды.ГрафикРаботы = НЕОПРЕДЕЛЕНО
	               |			ИНАЧЕ СтудентыПериоды.ГрафикРаботы = &КалендарныйГрафик
	               |		КОНЕЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ГруппаСтудентов,
	               |	ИмяСтудента";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", КонецДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Факультет", Факультет);
	Запрос.УстановитьПараметр("ГруппаСтудентов", ГруппаСтудентов);
	Запрос.УстановитьПараметр("КалендарныйГрафик", КалендарныйГрафик);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ТаблицаДнейМесяца(НачалоПериода, КонецПериода, ДнейВМесяце, РабочихДней, КалендарныйГрафик = Неопределено, НеСворачивать = Истина) Экспорт
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВЫБОР
	               |		КОГДА &КалендарныйГрафик <> ЗНАЧЕНИЕ(Справочник.Календари.ПустаяСсылка)
	               |				И НЕ КалендарныеГрафики.ДатаГрафика ЕСТЬ NULL 
	               |			ТОГДА ДЕНЬ(КалендарныеГрафики.ДатаГрафика)
	               |		ИНАЧЕ ДЕНЬ(ДанныеКалендаря.Дата)
	               |	КОНЕЦ КАК ДеньМесяца,
	               |	ВЫБОР
	               |		КОГДА &КалендарныйГрафик <> ЗНАЧЕНИЕ(Справочник.Календари.ПустаяСсылка)
	               |				И НЕ КалендарныеГрафики.ДатаГрафика ЕСТЬ NULL 
	               |			ТОГДА ВЫБОР
	               |					КОГДА КалендарныеГрафики.ДеньВключенВГрафик
	               |						ТОГДА """"
	               |					ИНАЧЕ ""В""
	               |				КОНЕЦ
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный))
	               |					ТОГДА """"
	               |				ИНАЧЕ ""В""
	               |			КОНЕЦ
	               |	КОНЕЦ КАК ВидДня
	               |ПОМЕСТИТЬ ТаблицаДней
	               |ИЗ
	               |	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеКалендаря
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
	               |		ПО ДанныеКалендаря.Дата = КалендарныеГрафики.ДатаГрафика
	               |ГДЕ
	               |	ДанныеКалендаря.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
	               |	И ДанныеКалендаря.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ВЫБОР
	               |			КОГДА &КалендарныйГрафик <> ЗНАЧЕНИЕ(Справочник.Календари.ПустаяСсылка)
	               |				ТОГДА КалендарныеГрафики.Календарь = &КалендарныйГрафик
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ";
				   
	Для К = 1 По 31 Цикл
		ТекстЗапроса = ТекстЗапроса + "
					|	ВЫБОР
					|		КОГДА ТаблицаДней.ДеньМесяца = " + К + " 
					|			ТОГДА ТаблицаДней.ВидДня
					|	КОНЕЦ КАК Д" + К;
					
		Если К < 31 Тогда
			ТекстЗапроса = ТекстЗапроса + ",";
		КонецЕсли;
	КонецЦикла;
					
	ТекстЗапроса = ТекстЗапроса + "
					|ИЗ
	              	|	ТаблицаДней КАК ТаблицаДней";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("КалендарныйГрафик", ?(КалендарныйГрафик = Неопределено, Справочники.Календари.ПустаяСсылка(), КалендарныйГрафик));
	Запрос.УстановитьПараметр("ПроизводственныйКалендарь", КалендарныеГрафики.ОсновнойПроизводственныйКалендарь());
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если НеСворачивать Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДниМесяца = Новый ТаблицаЗначений;
	
	Для Каждого Колонка Из Результат.Колонки Цикл
		ДниМесяца.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Стр = ДниМесяца.Добавить();
	
	К = 1;
	
	Для Каждого Строка Из Результат Цикл
		Стр["Д" + К] = Строка["Д" + К];
		К = К + 1;
	КонецЦикла;
	
	Возврат ДниМесяца;
КонецФункции

Функция ПолучитьПересечениеТаблиц(ТаблицаСтудентов, ТаблицаДнейМесяца) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабСтудентов.НачалоПериода КАК НачалоПериода,
	               |	ТабСтудентов.ОкончаниеПериода КАК ОкончаниеПериода,
	               |	ТабСтудентов.Факультет КАК Факультет,
	               |	ТабСтудентов.ГруппаСтудентов КАК ГруппаСтудентов,
	               |	ТабСтудентов.Студент КАК Студент
	               |ПОМЕСТИТЬ ТаблицаСтудентов
	               |ИЗ
	               |	&ТабСтудентов КАК ТабСтудентов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ";
				   
	Для К = 1 По 31 Цикл
		Запрос.Текст = Запрос.Текст + "
				   |	ТабДней.Д" + К + " КАК Д" + К;
		Если К < 31 Тогда
			Запрос.Текст = Запрос.Текст + ",";
		КонецЕсли;
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + "
	               |ПОМЕСТИТЬ ТаблицаДней
	               |ИЗ
	               |	&ТабДней КАК ТабДней
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаСтудентов.Факультет КАК Факультет,
	               |	ТаблицаСтудентов.ГруппаСтудентов КАК ГруппаСтудентов,
	               |	ТаблицаСтудентов.Студент КАК Студент,";
				   
	Для К = 1 По 31 Цикл
		Запрос.Текст = Запрос.Текст + "
	               |	ВЫБОР
	               |		КОГДА ТаблицаДней.Д" + К + " <> ""В""
	               |				И ДЕНЬ(ТаблицаСтудентов.НачалоПериода) > " + К + "
	               |			ТОГДА ""х""
	               |		КОГДА ТаблицаДней.Д" + К + " <> ""В""
	               |				И ДЕНЬ(ТаблицаСтудентов.ОкончаниеПериода) < " + К + "
	               |			ТОГДА ""х""
	               |		ИНАЧЕ ТаблицаДней.Д" + К + "
	               |	КОНЕЦ КАК Д" + К + ",";
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + "
				   |	ВЫРАЗИТЬ("""" КАК Строка(1024)) КАК ПричиныНевыходов
	               |ИЗ
	               |	ТаблицаСтудентов КАК ТаблицаСтудентов,
	               |	ТаблицаДней КАК ТаблицаДней";
				   
	Запрос.УстановитьПараметр("ТабДней", ТаблицаДнейМесяца);
	Запрос.УстановитьПараметр("ТабСтудентов", ТаблицаСтудентов);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ТаблицаДляПечати(Ссылка, Таблица)
	КолРабДней = Ссылка.КоличествоРабочихДней;
	Если Ссылка.НевыходыПоДням.Количество() > 0 Тогда
		
		Для Каждого Стр Из Таблица Цикл
			Факультет = Стр.Факультет;
			ГруппаСтудентов = Стр.ГруппаСтудентов;
			Студент = Стр.Студент;
			
			Строки = Ссылка.НевыходыПоДням.НайтиСтроки(Новый Структура("Факультет,ГруппаСтудентов,Студент", Факультет, ГруппаСтудентов, Студент));
			
			Если Строки.Количество() > 0 Тогда
				Но = 0;
				Нн = 0;
				Нх = 0;
				
				Для Каждого Строка Из Строки Цикл
					ДеньНевыхода = День(Строка.ДатаНевыхода);
					ПричиныНевыходов = Строка.ПричиныНевыходов;
					
					Если Строка.ВидНевыхода = -1 И Стр["Д" + ДеньНевыхода] = "" Тогда
						Но = Но + 1;
						Стр["Д" + ДеньНевыхода] = "Н";
					ИначеЕсли Строка.ВидНевыхода = 1 И Стр["Д" + ДеньНевыхода] = "" Тогда
						Нн = Нн + 1;
						Стр["Д" + ДеньНевыхода] = "Н";
					ИначеЕсли Строка.ВидНевыхода = 1 И Стр["Д" + ДеньНевыхода] = "х" Тогда
						Нх = Нх + 1;
					КонецЕсли;
				КонецЦикла;
				
				Стр.ПричиныНевыходов = ПричиныНевыходов;
				
				Стр.ПропущеноВсего = Но + Нн;
				Стр.ПропущеноОплачиваемых = Но;
				Стр.ДнейКОплате = КолРабДней - Нн - Нх;
			Иначе
				Стр.ДнейКОплате = КолРабДней;
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		Таблица.ЗаполнитьЗначения(КолРабДней, "ДнейКОплате");	
	КонецЕсли;
КонецПроцедуры

Процедура ПодготовитьИтоговуюТаблицу(ТабИтог, ТаблицаДляПечати)
	Для К = 1 По 31 Цикл
		ТабИтог.Колонки.Добавить("Д"+К, ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(5));
	КонецЦикла;
	
	ТабИтог.Колонки.Добавить("ПропущеноВсего", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10,0));
	ТабИтог.Колонки.Добавить("ПропущеноОплачиваемых", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10,0));
	ТабИтог.Колонки.Добавить("ДнейКОплате", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10,0));
	
	СтрокаИтог = ТабИтог.Добавить();
	
	Для К = 1 По 31 Цикл
		ИтогДня = 0;
		
		Для Каждого Стр Из ТаблицаДляПечати Цикл
			Если Стр["Д"+К] = "В" Тогда
				СтрокаИтог["Д"+К] = "В";
				Прервать;
			ИначеЕсли Стр["Д"+К] = "-" Тогда
				СтрокаИтог["Д"+К] = "-";
				Прервать;
			ИначеЕсли Стр["Д"+К] = "Н" Тогда
				ИтогДня = ИтогДня + 1;
			КонецЕсли;
		КонецЦикла;
		
		Если ИтогДня > 0 Тогда
			СтрокаИтог["Д"+К] = ИтогДня;
		КонецЕсли;
	КонецЦикла;
	
	СтрокаИтог.ПропущеноВсего = ТаблицаДляПечати.Итог("ПропущеноВсего");
	СтрокаИтог.ПропущеноОплачиваемых = ТаблицаДляПечати.Итог("ПропущеноОплачиваемых");
	СтрокаИтог.ДнейКОплате = ТаблицаДляПечати.Итог("ДнейКОплате");
КонецПроцедуры

#КонецОбласти

#КонецЕсли
