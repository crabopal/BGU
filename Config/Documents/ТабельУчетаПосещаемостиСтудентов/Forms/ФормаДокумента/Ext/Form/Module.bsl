&НаКлиенте
Процедура ЗаполнитьТабель(Команда)
	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.НачалоПериода) Тогда
		Отказ = Истина;
		
		ТекстСообщения = НСтр("ru='Не заполнен период документа, заполнение невозможно!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "НачалоПериодаСтрокой");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Отказ = Истина;
		
		ТекстСообщения = НСтр("ru='Не указана организация, заполнение невозможно!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Организация", "Объект");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Факультет) Тогда
		Отказ = Истина;
		
		ТекстСообщения = НСтр("ru='Не указан факультет, заполнение невозможно!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Факультет", "Объект");
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ТабЧасть = ?(Объект.ВидТабеля = 0, НевыходыПоДням, Объект.НевыходыСводно);
	
	Если ТабЧасть.Количество() > 0 Тогда
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Событие", "Перезаполнение");
		ДопПараметры.Вставить("Путь", "");
		ДопПараметры.Вставить("Элемент", Неопределено);
		ДопПараметры.Вставить("ПараметрыФормы", Новый Структура);
		
		ТекстСообщения = НСтр("ru='Текущая табличная часть будет очищена. Продолжить?'");
		Оповещение = Новый ОписаниеОповещения("ЗапроситьОчисткуТабличнойЧасти", ЭтотОбъект, ДопПараметры);
		ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		
		Возврат;
	КонецЕсли;
	
	Если Объект.ВидТабеля = 0 Тогда
		ЗаполнитьТабельПоДнямСервер();
	Иначе
		ЗаполнитьТабельСводноСервер();
	КонецЕсли;
	
	УстановитьПредупреждение();
КонецПроцедуры

