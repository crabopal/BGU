		НевыходыПоДням.Очистить();
		Объект.НевыходыПоДням.Очистить();
	Иначе
		Объект.НевыходыСводно.Очистить();
	КонецЕсли;
	
	РаботаСоСтудентамиКлиент.ПериодРегистрацииОкончаниеВводаТекста(ЭтаФорма, "Объект.НачалоПериода", "НачалоПериодаСтрокой", Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);	
КонецПроцедуры

&НаКлиенте
Процедура ФакультетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТабЧасть = ?(Объект.ВидТабеля = 0, НевыходыПоДням, Объект.НевыходыСводно);
	
	Если ТабЧасть.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Событие", "Выбор");
		ДопПараметры.Вставить("Путь", "Справочник.Подразделения");
