&НаКлиенте
Процедура ЗапроситьОчисткуТабличнойЧасти(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если Объект.ВидТабеля = 0 Тогда
			НевыходыПоДням.Очистить();
			Объект.НевыходыПоДням.Очистить();
		Иначе
			Объект.НевыходыСводно.Очистить();
		КонецЕсли;
		
		Если ДопПараметры <> Неопределено Тогда
			Событие = "";
			Путь = "";
			Элемент = Неопределено;
			ПараметрыФормы = Неопределено;
			
			ДопПараметры.Свойство("Событие", Событие);
			ДопПараметры.Свойство("Путь", Путь);
			ДопПараметры.Свойство("Элемент", Элемент);
			ДопПараметры.Свойство("ПараметрыФормы", ПараметрыФормы);
			
			Если Событие = "Выбор" Тогда
				ОткрытьФорму(Путь + ".ФормаВыбора", ПараметрыФормы, Элемент);
			ИначеЕсли Событие = "Очистка" Тогда
				Если Объект.ВидТабеля = 0 Тогда
					Объект.ГруппаСтудентов = Неопределено;
					ЗаполнитьТабельПоДнямСервер();
				КонецЕсли;					
			ИначеЕсли Событие = "Перезаполнение" Тогда
				Если Объект.ВидТабеля = 0 Тогда
					ЗаполнитьТабельПоДнямСервер();
				Иначе
					ЗаполнитьТабельСводноСервер();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
					
		УстановитьПредупреждение();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВведенТекстПричинНепосещения(Результат, ДопПараметры) Экспорт
	Если ЗначениеЗаполнено(Результат) Тогда
		ТекущиеДанные = Неопределено;
		ТекущиеПричины = "";
		
		ДопПараметры.Свойство("ТекущиеДанные", ТекущиеДанные);
		ДопПараметры.Свойство("ТекущиеПричины", ТекущиеПричины);
		
		Если Результат <> ТекущиеПричины Тогда
			ТекущиеДанные.ПричиныНевыходов = Результат;
			Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеВидаТабеля(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если ТекВидТабеля = 0 Тогда
			НевыходыПоДням.Очистить();
			Объект.НевыходыПоДням.Очистить();
		Иначе
			Объект.НевыходыСводно.Очистить();
		КонецЕсли;
		
		ТекВидТабеля = Объект.ВидТабеля;
	Иначе
		Объект.ВидТабеля = ТекВидТабеля;
	КонецЕсли;
	
	Элементы.ГруппаНевыходыПоДням.Видимость = (Объект.ВидТабеля = 0);
	Элементы.ГруппаНевыходыСводно.Видимость = (Объект.ВидТабеля = 1);
	
	Если Объект.ВидТабеля = 0 Тогда
		ТаблицаДнейМесяца();
		ЗаполнитьСпискиВыбораКолонок();
		УстановитьВидимостьКолонокДней();
		УстановитьУсловноеОформление();
	КонецЕсли;
	
	УстановитьВидимостьРеквизитов();
	УстановитьПредупреждение();
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ЗаполнитьТабельСводноСервер()
	ТаблицаСтудентов = Документы.ТабельУчетаПосещаемостиСтудентов.ТаблицаСтудентов(Объект.НачалоПериода, Объект.КонецПериода, Объект.Организация, Объект.Факультет, Объект.ГруппаСтудентов);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабСтудентов.Факультет КАК Факультет,
	               |	ТабСтудентов.ГруппаСтудентов КАК ГруппаСтудентов,
	               |	ТабСтудентов.Студент КАК Студент
	               |ПОМЕСТИТЬ ТаблицаСтудентов
	               |ИЗ
	               |	&ТабСтудентов КАК ТабСтудентов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТабСтудентов.Факультет КАК Факультет,
	               |	ТабСтудентов.ГруппаСтудентов КАК ГруппаСтудентов,
	               |	ТабСтудентов.Студент КАК Студент,
				   |	0 КАК НеоплачиваемыеНевыходы,
				   |	0 КАК ОплачиваемыеНевыходы,
				   |	"""" КАК ПричиныНепосещений
	               |ИЗ
	               |	ТаблицаСтудентов КАК ТабСтудентов";
				   
	Запрос.УстановитьПараметр("ТабСтудентов", ТаблицаСтудентов);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Объект.НевыходыСводно.Загрузить(Результат);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабельПоДнямСервер()
	ТаблицаСтудентов = Документы.ТабельУчетаПосещаемостиСтудентов.ТаблицаСтудентов(Объект.НачалоПериода, Объект.КонецПериода, Объект.Организация, Объект.Факультет, Объект.ГруппаСтудентов);
	ТаблицаДнейМесяца = РеквизитФормыВЗначение("ДниМесяца");
	
	Результат = Документы.ТабельУчетаПосещаемостиСтудентов.ПолучитьПересечениеТаблиц(ТаблицаСтудентов, ТаблицаДнейМесяца);
	
	ЗначениеВРеквизитФормы(Результат, "НевыходыПоДням");
	
	Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокумент()
	ТаблицаСтудентов = Документы.ТабельУчетаПосещаемостиСтудентов.ТаблицаСтудентов(Объект.НачалоПериода, Объект.КонецПериода, Объект.Организация, Объект.Факультет, Объект.ГруппаСтудентов);
	ТаблицаДнейМесяца = РеквизитФормыВЗначение("ДниМесяца");
	
	Результат = Документы.ТабельУчетаПосещаемостиСтудентов.ПолучитьПересечениеТаблиц(ТаблицаСтудентов, ТаблицаДнейМесяца);
	
	Если Объект.НевыходыПоДням.Количество() > 0 Тогда
		Для Каждого Стр Из Результат Цикл
			Факультет = Стр.Факультет;
			ГруппаСтудентов = Стр.ГруппаСтудентов;
			Студент = Стр.Студент;
			
			Строки = Объект.НевыходыПоДням.НайтиСтроки(Новый Структура("Факультет,ГруппаСтудентов,Студент", Факультет, ГруппаСтудентов, Студент));
			
			Если Строки.Количество() > 0 Тогда
				Для Каждого Строка Из Строки Цикл
					ДеньНевыхода = День(Строка.ДатаНевыхода);
					ПричиныНевыходов = Строка.ПричиныНевыходов;
					
					Если Строка.ВидНевыхода = -1 И Стр["Д" + ДеньНевыхода] = "" Тогда
						Стр["Д" + ДеньНевыхода] = "Н(о)";
					ИначеЕсли Строка.ВидНевыхода = 1 И Стр["Д" + ДеньНевыхода] = "" Тогда
						Стр["Д" + ДеньНевыхода] = "Н(н)";
					КонецЕсли;
				КонецЦикла;
				
				Стр.ПричиныНевыходов = ПричиныНевыходов;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(Результат, "НевыходыПоДням");
КонецПроцедуры

&НаСервереБезКонтекста
Функция КоличествоРабочихДнейПериода(Начало, Окончание, ГрафикРаботы = Неопределено)
	Возврат РодительскаяПлата.ПолучитьКоличествоРабочихДнейПоКалендарю(Начало, Окончание, ГрафикРаботы);
КонецФункции	

&НаКлиенте
Процедура УстановитьВидимостьРеквизитов()
	Если Объект.ВидТабеля = 0 Тогда
		Элементы.НевыходыПоДнямФакультет.Видимость = Не ЗначениеЗаполнено(Объект.Факультет);
		Элементы.НевыходыПоДнямГруппаСтудентов.Видимость = Не ЗначениеЗаполнено(Объект.ГруппаСтудентов);
	Иначе
		Элементы.НевыходыСводноФакультет.Видимость = Не ЗначениеЗаполнено(Объект.Факультет);
		Элементы.НевыходыСводноГруппаСтудентов.Видимость = Не ЗначениеЗаполнено(Объект.ГруппаСтудентов);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ТаблицаДнейМесяца()
	
	ПроизводственныйКалендарь = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
	КалендарныйГрафик = РаботаСоСтудентами.ПолучитьКалендарныйГрафикГруппы(Объект.ГруппаСтудентов, Объект.НачалоПериода);
	
	Элементы.КалендарныйГрафик.Видимость = ЗначениеЗаполнено(КалендарныйГрафик);
	Элементы.ПроизводственныйКалендарь.Видимость = НЕ ЗначениеЗаполнено(КалендарныйГрафик);
		
	Объект.КоличествоДнейВМесяце = День(Объект.КонецПериода);
	Объект.КоличествоРабочихДней = КоличествоРабочихДнейПериода(Объект.НачалоПериода, Объект.КонецПериода, КалендарныйГрафик);
	
	ТаблицаДней = Документы.ТабельУчетаПосещаемостиСтудентов.ТаблицаДнейМесяца(Объект.НачалоПериода, Объект.КонецПериода, Объект.КоличествоДнейВМесяце, 
																				Объект.КоличествоРабочихДней,КалендарныйГрафик);
	
	ДниМесяца.Очистить();
	
	Стр = ДниМесяца.Добавить();
	
	К = 1;
	
	Для Каждого Строка Из ТаблицаДней Цикл
		Стр["Д" + К] = Строка["Д" + К];
		
		Если Стр["Д" + К] = "В" Тогда
			Элементы["НевыходыПоДнямД" + К].ЦветТекстаЗаголовка = Новый Цвет(255, 0, 0);
			Элементы["НевыходыПоДнямД" + К].ЦветТекста = Новый Цвет(255, 0, 0);
			Элементы["НевыходыПоДнямД" + К].ТолькоПросмотр = Истина;
		Иначе
			Элементы["НевыходыПоДнямД" + К].ЦветТекстаЗаголовка = Новый Цвет(65, 48, 3);
			Элементы["НевыходыПоДнямД" + К].ЦветТекста = Новый Цвет(0, 0, 0);
			Элементы["НевыходыПоДнямД" + К].ТолькоПросмотр = Ложь;
		КонецЕсли;
		
		К = К + 1;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьКолонокДней()
	Для К = 29 По 31 Цикл
		Элементы["НевыходыПоДнямД" + К].Видимость = (К <= День(Объект.КонецПериода));
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеНачалаПериода(Элемент)
	Объект.КонецПериода = КонецМесяца(Объект.НачалоПериода);
	ТаблицаДнейМесяца();
	УстановитьВидимостьКолонокДней();
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьПредупреждение()
	Если Объект.ВидТабеля = 0 Тогда
		Таблица = НевыходыПоДням;
	Иначе
		Таблица = Объект.НевыходыСводно;
	КонецЕсли;
	
	Если Таблица.Количество() > 0 Тогда
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании 				= ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.Дата.ОтображениеПредупрежденияПриРедактировании 						= ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.Факультет.ОтображениеПредупрежденияПриРедактировании					= ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.ВидТабеля.ОтображениеПредупрежденияПриРедактировании					= ОтображениеПредупрежденияПриРедактировании.Отображать;
	Иначе
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании 				= ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		Элементы.Дата.ОтображениеПредупрежденияПриРедактировании 						= ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		Элементы.Факультет.ОтображениеПредупрежденияПриРедактировании					= ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		Элементы.ВидТабеля.ОтображениеПредупрежденияПриРедактировании					= ОтображениеПредупрежденияПриРедактировании.НеОтображать;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	Для К = 1 По 31 Цикл
		ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		
		Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НевыходыПоДням.Д"+К);
		Отбор.ПравоеЗначение = "х";
		Отбор.Использование = Истина;
		
		Оформление = ЭлементОформления.Оформление.Элементы;
		
		ЦветФона = Оформление.Найти("ЦветФона");
		ЦветФона.Значение =	ЦветаСтиля.ДатаГрафикаИзмененнаяФон;
		ЦветФона.Использование = Истина;
		
		Шрифт = Оформление.Найти("Шрифт");
		Шрифт.Значение = Новый Шрифт(,,Истина);
		Шрифт.Использование = Истина;
		
		ТолькоЧтение = Оформление.Найти("ТолькоПросмотр");
		ТолькоЧтение.Значение = Истина;
		ТолькоЧтение.Использование = Истина;
		
		Поля = ЭлементОформления.Поля.Элементы.Добавить();
		Поля.Использование = Истина;
		Поля.Поле = Новый ПолеКомпоновкиДанных("НевыходыПоДнямД"+К);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСпискиВыбораКолонок()
	Для К = 1 По 31 Цикл
		Если Элементы["НевыходыПоДнямД" + К].СписокВыбора.Количество() = 0 Тогда
			Элементы["НевыходыПоДнямД" + К].СписокВыбора.Добавить(" ", "посещение");
			Элементы["НевыходыПоДнямД" + К].СписокВыбора.Добавить("Н(н)", "Н(н)");
			Элементы["НевыходыПоДнямД" + К].СписокВыбора.Добавить("Н(о)", "Н(о)");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СоздатьОбразСтроки(НомерСтроки)
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(НевыходыПоДням[НомерСтроки]);
	
	ОбразСтроки = НевыходыПоДням.Выгрузить(МассивСтрок);
	
	АдресЭлементаКоллекции = ПоместитьВоВременноеХранилище(ОбразСтроки, ЭтаФорма.УникальныйИдентификатор);
КонецПроцедуры

&НаСервере
Процедура СравнитьСтроки(НомерСтроки)
	ОбразСтроки = ПолучитьИзВременногоХранилища(АдресЭлементаКоллекции);
	ТекущаяСтрока = НевыходыПоДням[НомерСтроки];
	
	Если ОбразСтроки <> Неопределено И ТекущаяСтрока <> Неопределено Тогда
		Для Каждого Колонка Из ОбразСтроки.Колонки Цикл
			Если ОбразСтроки[0][Колонка.Имя] <> ТекущаяСтрока[Колонка.Имя] Тогда
				Модифицированность = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	АдресЭлементаКоллекции = "";
КонецПроцедуры

