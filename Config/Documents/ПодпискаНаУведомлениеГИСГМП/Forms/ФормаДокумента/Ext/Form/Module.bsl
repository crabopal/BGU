#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоОбменИСРНИП = ГосУслуги.ЭтоОбменИСРНИП(Объект.Организация);
	Если ЭтоОбменИСРНИП Тогда
		ТекЭлемент = Элементы.ТаблицаЗначенийПараметровСтатус.СписокВыбора.НайтиПоЗначению(2);
		Если ТекЭлемент <> Неопределено Тогда
			Элементы.ТаблицаЗначенийПараметровСтатус.СписокВыбора.Удалить(ТекЭлемент);
		КонецЕсли;
	КонецЕсли;
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
		Для Каждого СтрТЧ Из Объект.ГруппыПараметров Цикл
			СтрТЧ.РезультатИмпортаКод = "";
			СтрТЧ.РезультатИмпортаОписание = "";
		КонецЦикла;
		Объект.РезультатОбработкиОбщий = "";
		
		Если ЗначениеЗаполнено(Объект.Подписка) Тогда
			ЗаполнитьПараметрыПодписки();
			ДобавитьРеквизитыТаблицыПоПараметрамПодписки();
			
			Если Объект.СтатусПодписки = 2 Тогда//изменение
				ЗаполнитьЗначенияПараметров();	
			КонецЕсли;
		КонецЕсли;
	Иначе
		ДобавитьРеквизитыТаблицыПоПараметрамПодписки();
	КонецЕсли;
		
	Таблица = РеквизитФормыВЗначение("ТаблицаЗначенийПараметров");
	Таблица.Индексы.Добавить("КлючСтроки");
	
	//если это существующий документ
	Для Каждого СтрГруппы Из Объект.ГруппыПараметров Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.КлючСтроки = СтрГруппы.КлючСтроки;
		СтрокаТаблицы.Статус = СтрГруппы.СтатусПараметра;
		СтрокаТаблицы.РезультатИмпортаКод = СтрГруппы.РезультатИмпортаКод;
		СтрокаТаблицы.РезультатИмпортаОписание = СтрГруппы.РезультатИмпортаОписание;
		
		Для Каждого СтрТЧ Из Объект.ЗначенияПараметровПодписки.НайтиСтроки(Новый Структура("КлючСтроки",СтрГруппы.КлючСтроки)) Цикл
			
			СтрокаТаблицы[СтрТЧ.КодПараметра] = СтрТЧ.ЗначениеПараметра;			
			СтрокаТаблицы["OLD_"+СтрТЧ.КодПараметра] = СтрТЧ.СтароеЗначениеПараметра;
			
			Если СтрокаТаблицы.Статус = 2 Тогда
				СтрокаТаблицы["Текст_"+СтрТЧ.КодПараметра] = СтрТЧ.ЗначениеПараметра + " (прошлое значение: "+СтрТЧ.СтароеЗначениеПараметра+")";
				СтрокаТаблицы["Текст_"+СтрТЧ.КодПараметра] = СтрЗаменить(СтрокаТаблицы["Текст_"+СтрТЧ.КодПараметра],"false","Нет");
				СтрокаТаблицы["Текст_"+СтрТЧ.КодПараметра] = СтрЗаменить(СтрокаТаблицы["Текст_"+СтрТЧ.КодПараметра],"true","Да");
			КонецЕсли;
		КонецЦикла;
		
		СтрокаТаблицы.ОписаниеРезультата = ?(ЗначениеЗаполнено(СтрокаТаблицы.РезультатИмпортаКод),"Код = "+СтрокаТаблицы.РезультатИмпортаКод+", "+ СтрокаТаблицы.РезультатИмпортаОписание,"");
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Таблица,"ТаблицаЗначенийПараметров");
	
	КоличествоСтрокПараметров = ТаблицаЗначенийПараметров.Количество();
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);	
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.ЗначенияПараметровПодписки.Очистить();
	ТекущийОбъект.ГруппыПараметров.Очистить();
	Для Каждого СтрТЧ Из ТаблицаЗначенийПараметров Цикл
		Если НЕ ЗначениеЗаполнено(СтрТЧ.КлючСтроки) Тогда
			СтрТЧ.КлючСтроки = "P" + Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		СтрГруппы = ТекущийОбъект.ГруппыПараметров.Добавить();
		СтрГруппы.КлючСтроки = СтрТЧ.КлючСтроки;
		СтрГруппы.СтатусПараметра = СтрТЧ.Статус;
		СтрГруппы.РезультатИмпортаКод = СтрТЧ.РезультатИмпортаКод;
		СтрГруппы.РезультатИмпортаОписание = СтрТЧ.РезультатИмпортаОписание;
		Для Каждого СтрПараметра Из Объект.ПараметрыПодписки Цикл
			НовСтр = ТекущийОбъект.ЗначенияПараметровПодписки.Добавить();
			НовСтр.КлючСтроки = СтрТЧ.КлючСтроки;
			НовСтр.КодПараметра = СтрПараметра.КодПараметра;
			НовСтр.ЗначениеПараметра = СтрТЧ[СтрПараметра.КодПараметра];
			НовСтр.СтароеЗначениеПараметра = СтрТЧ["OLD_"+СтрПараметра.КодПараметра];
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПодпискаПриИзменении(Элемент)
	ПодпискаПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ЗаполнитьИдентификаторПодписки();
КонецПроцедуры

&НаКлиенте
Процедура СтатусПодпискиПриИзменении(Элемент)
	
	СтатусПодпискиПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СтатусПодпискиПриИзмененииНаСервере()
	
	Если Объект.СтатусПодписки = 2
		ИЛИ Объект.СтатусПодписки = 3 Тогда
		ЗаполнитьИдентификаторПодписки();
	КонецЕсли;
	
	Если Объект.СтатусПодписки = 3 Тогда
		ТаблицаЗначенийПараметров.Очистить();//при удалении подписки передавать удаление параметов не надо
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаЗначенийПараметров

&НаКлиенте
Процедура ТаблицаЗначенийПараметровПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если НЕ ЗначениеЗаполнено(Объект.Подписка) Тогда
		ТекстСообщения = НСтр("ru='Перед добавлением параметров выберите подписку.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,Объект.Ссылка,"Подписка","Объект",Отказ);	
	ИначеЕсли Объект.ПараметрыПодписки.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Для выбранной подписки не предусмотрено указание параметров.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,Объект.Ссылка,,,Отказ);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗначенийПараметровПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элемент.ТекущиеДанные;
		ТекущиеДанные.Статус = 1;
		Если Копирование Тогда		
			ТекущиеДанные.КлючСтроки = "";
			ТекущиеДанные.РезультатИмпортаКод = "";
			ТекущиеДанные.РезультатИмпортаОписание = "";
			ТекущиеДанные.ОписаниеРезультата = "";
		
			Для Каждого СтрТЧ Из Объект.ПараметрыПодписки Цикл
				ТекущиеДанные["OLD_"+СтрТЧ.КодПараметра]="";
			КонецЦикла;
		КонецЕсли;
		КоличествоСтрокПараметров = КоличествоСтрокПараметров+1;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗначенийПараметровПослеУдаления(Элемент)
	КоличествоСтрокПараметров = ТаблицаЗначенийПараметров.Количество();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗначенийПараметровСтатусОчистка(Элемент, СтандартнаяОбработка)
	ТекДанные = Элементы.ТаблицаЗначенийПараметров.ТекущиеДанные;
	ТекДанные.Статус = -1;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТаблицаЗначенийПараметровЗначениеПараметраПриИзменении(Элемент)
	ТекДанные = Элементы.ТаблицаЗначенийПараметров.ТекущиеДанные;
	ИмяПоляТаблицыФормы = "ТаблицаЗначенийПараметров";
	ИмяПоля = Сред(Элемент.Имя,СтрДлина(ИмяПоляТаблицыФормы)+1);
	Если ТекДанные.Статус = -1
		ИЛИ ТекДанные.Статус = 2 Тогда
		ТекДанные["Текст_"+ИмяПоля] = ТекДанные[ИмяПоля] + " (прошлое значение: "+ТекДанные["OLD_"+ИмяПоля]+")";
		ТекДанные["Текст_"+ИмяПоля] = СтрЗаменить(ТекДанные["Текст_"+ИмяПоля],"false","Нет");
		ТекДанные["Текст_"+ИмяПоля] = СтрЗаменить(ТекДанные["Текст_"+ИмяПоля],"true","Да");
		ТекДанные.Статус = 2;//изменение
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Проверить(Команда)
	ПроверитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьЗначенияПараметров();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодпискаПриИзмененииНаСервере()
	Объект.ЗначенияПараметровПодписки.Очистить();
	
	ТаблицаЗначенийПараметров.Очистить();
	
	ЗаполнитьПараметрыПодписки();

	ДобавитьРеквизитыТаблицыПоПараметрамПодписки();
	
	ЗаполнитьИдентификаторПодписки();
	
	Если НЕ ЗначениеЗаполнено(Объект.СтатусПодписки) Тогда
		Если ЗначениеЗаполнено(Объект.ИдентификаторПодписки) Тогда
			Объект.СтатусПодписки = 2;//изменение
			ЗаполнитьЗначенияПараметров();
		Иначе
			Объект.СтатусПодписки = 1; //новая
		КонецЕсли;
	КонецЕсли;
	
	КоличествоСтрокПараметров = ТаблицаЗначенийПараметров.Количество();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыПодписки()
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	ДокОбъект.ЗаполнитьПараметрыПодписки();
	ЗначениеВРеквизитФормы(ДокОбъект,"Объект");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИдентификаторПодписки()
		
	Объект.ИдентификаторПодписки = Документы.ПодпискаНаУведомлениеГИСГМП.ПолучитьИдентификаторПодписки(Объект.Организация, Объект.Подписка);

КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизитыТаблицыПоПараметрамПодписки()
	
	ИмяПоляТаблицыФормы = "ТаблицаЗначенийПараметров";
	
	УдаляемыеРеквизиты = Новый Массив;
	Таблица = РеквизитФормыВЗначение(ИмяПоляТаблицыФормы);
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если Колонка.Имя = "КлючСтроки"
			ИЛИ Колонка.Имя = "Статус"
			ИЛИ Колонка.Имя = "РезультатИмпортаКод"
			ИЛИ Колонка.Имя = "РезультатИмпортаОписание"
			ИЛИ Колонка.Имя = "ОписаниеРезультата" Тогда
			Продолжить;
		КонецЕсли;
		УдаляемыеРеквизиты.Добавить(ИмяПоляТаблицыФормы+"."+Колонка.Имя);
		СтарыйЭлемент = Элементы.Найти(ИмяПоляТаблицыФормы + Колонка.Имя);
		Если СтарыйЭлемент <> Неопределено Тогда
			Элементы.Удалить(СтарыйЭлемент);
		КонецЕсли;
	КонецЦикла;
	
	ДобавляемыеРеквизиты = Новый Массив;
	ТипСтрока = ОбщегоНазначения.ОписаниеТипаСтрока(50);
	ТипСтрока100 = ОбщегоНазначения.ОписаниеТипаСтрока(100);
	Для Каждого СтрТЧ Из Объект.ПараметрыПодписки Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(СтрТЧ.КодПараметра, ТипСтрока, ИмяПоляТаблицыФормы, СтрТЧ.НаименованиеПараметра, Истина));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("OLD_"+СтрТЧ.КодПараметра, ТипСтрока, ИмяПоляТаблицыФормы, СтрТЧ.НаименованиеПараметра, Истина));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Текст_"+СтрТЧ.КодПараметра, ТипСтрока100, ИмяПоляТаблицыФормы, СтрТЧ.НаименованиеПараметра, Истина));
	КонецЦикла;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты,УдаляемыеРеквизиты);
	
	МассивУО = Новый Массив;
	Для Каждого ЭлМас Из УсловноеОформление.Элементы Цикл
		Если ЭлМас.Представление = "ТаблицаЗначенийПараметров" Тогда
			МассивУО.Добавить(ЭлМас);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлМас Из МассивУО Цикл
		УсловноеОформление.Элементы.Удалить(ЭлМас);	
	КонецЦикла;
	
	Для Каждого СтрТЧ Из Объект.ПараметрыПодписки Цикл
		
		ЭлементРеквизита					= Элементы.Вставить(ИмяПоляТаблицыФормы + СтрТЧ.КодПараметра, Тип("ПолеФормы"), Элементы.ТаблицаЗначенийПараметров,Элементы.ТаблицаЗначенийПараметровОписаниеРезультата);
        ЭлементРеквизита.ПутьКДанным		= ИмяПоляТаблицыФормы + "." + СтрТЧ.КодПараметра;
        ЭлементРеквизита.Вид				= ВидПоляФормы.ПолеВвода;
		ЭлементРеквизита.АвтоОтметкаНезаполненного = СтрТЧ.Обязательный;
		
		ЭлементРеквизита.УстановитьДействие("ПриИзменении","Подключаемый_ТаблицаЗначенийПараметровЗначениеПараметраПриИзменении");
		
		ПроверяемыйФормат = НРег(СтрТЧ.ФорматПараметра);
		Если СтрНайти(ПроверяемыйФормат,"false")>0
			И СтрНайти(ПроверяемыйФормат,"true")>0 Тогда
			ЭлементРеквизита.РежимВыбораИзСписка = Истина;
