		ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение  = "false";
		ПолеЭлемента = НовУО.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяПоляТаблицыФормы + СтрТЧ.КодПараметра);
		
		НовУО = УсловноеОформление.Элементы.Добавить();
		НовУО.Представление = "ТаблицаЗначенийПараметров";
		НовУО.Оформление.УстановитьЗначениеПараметра("Текст", Новый ПолеКомпоновкиДанных(ИмяПоляТаблицыФормы+"."+"Текст_"+СтрТЧ.КодПараметра));
		ОтборЭлемента = НовУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
