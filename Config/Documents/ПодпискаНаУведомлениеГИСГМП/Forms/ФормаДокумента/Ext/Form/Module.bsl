&НаСервере
Процедура ПроверитьНаСервере()
	
	Для Каждого СтрТЧ Из ТаблицаЗначенийПараметров Цикл
		ТекстОшибки = "";
		ИндексСтроки = Формат(ТаблицаЗначенийПараметров.Индекс(СтрТЧ),"ЧН=0");
		Для Каждого СтрПараметра Из Объект.ПараметрыПодписки Цикл
			
			Если Не ЗначениеЗаполнено(СтрТЧ[СтрПараметра.КодПараметра])
				И СтрПараметра.Обязательный Тогда
				ТекстОшибки = НСтр("ru='В строке не заполнен обязательный параметр %1'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,СтрПараметра.НаименованиеПараметра);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,Объект.Ссылка,"ТаблицаЗначенийПараметров["+ИндексСтроки+"]."+СтрПараметра.КодПараметра,,);	
				
			ИначеЕсли ЗначениеЗаполнено(СтрПараметра.ФорматПараметра) Тогда
				ЗначениеКорректно = БиблиотекаФункцийОбмена.ПроверитьПоРегулярномуВыражению(СтрТЧ[СтрПараметра.КодПараметра],СтрПараметра.ФорматПараметра,СтрПараметра.Обязательный=Ложь,Ложь);
				
				Если НЕ ЗначениеКорректно Тогда
					
					ТекстОшибки = НСтр("ru='В строке значение параметра %1 = %2 не соответствует формату'");
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,СтрПараметра.НаименованиеПараметра,СтрТЧ[СтрПараметра.КодПараметра]);
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,Объект.Ссылка,"ТаблицаЗначенийПараметров["+ИндексСтроки+"]."+СтрПараметра.КодПараметра,,);	

				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначенияПараметров()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПараметрыПодписокГИСГМПСрезПоследних.ИдентификаторГруппыПараметров КАК ИдентификаторГруппыПараметров,
		|	ПараметрыПодписокГИСГМПСрезПоследних.КодПараметра КАК КодПараметра,
		|	ПараметрыПодписокГИСГМПСрезПоследних.ЗначениеПараметра КАК ЗначениеПараметра
		|ИЗ
		|	РегистрСведений.ПараметрыПодписокГИСГМП.СрезПоследних КАК ПараметрыПодписокГИСГМПСрезПоследних
		|ГДЕ
		|	ПараметрыПодписокГИСГМПСрезПоследних.Организация = &Организация
		|	И ПараметрыПодписокГИСГМПСрезПоследних.Подписка = &Подписка
		|	И ПараметрыПодписокГИСГМПСрезПоследних.ИдентификаторПодписки = &ИдентификаторПодписки 
		|	И ПараметрыПодписокГИСГМПСрезПоследних.ПараметрАктивен";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Подписка", Объект.Подписка);
	Запрос.УстановитьПараметр("ИдентификаторПодписки", Объект.ИдентификаторПодписки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Таблица = РеквизитФормыВЗначение("ТаблицаЗначенийПараметров");
	Таблица.Индексы.Добавить("КлючСтроки");
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаТЧ = Таблица.Найти(ВыборкаДетальныеЗаписи.ИдентификаторГруппыПараметров,"КлючСтроки");
		Если СтрокаТЧ = Неопределено Тогда
			СтрокаТЧ = Таблица.Добавить();
			СтрокаТЧ.КлючСтроки = ВыборкаДетальныеЗаписи.ИдентификаторГруппыПараметров;
		КонецЕсли;
		
		СтрокаТЧ[ВыборкаДетальныеЗаписи.КодПараметра] = ВыборкаДетальныеЗаписи.ЗначениеПараметра;
		СтрокаТЧ["OLD_"+ВыборкаДетальныеЗаписи.КодПараметра] = ВыборкаДетальныеЗаписи.ЗначениеПараметра;
		СтрокаТЧ["Текст_"+ВыборкаДетальныеЗаписи.КодПараметра] = "";
		СтрокаТЧ.Статус = -1;//существующий параметр
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Таблица,"ТаблицаЗначенийПараметров");
	
	КоличествоСтрокПараметров = ТаблицаЗначенийПараметров.Количество();
КонецПроцедуры

#КонецОбласти
