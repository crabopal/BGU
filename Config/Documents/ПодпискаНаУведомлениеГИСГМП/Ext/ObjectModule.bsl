#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

Процедура ЗаполнитьПараметрыПодписки() Экспорт
	
	Перем ВыборкаДетальныеЗаписи, Запрос, РезультатЗапроса;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодпискиГИСГМППараметрыПодписки.Ссылка КАК Ссылка,
	|	ПодпискиГИСГМППараметрыПодписки.НомерСтроки КАК НомерСтроки,
	|	ПодпискиГИСГМППараметрыПодписки.КодПараметра КАК КодПараметра,
	|	ПодпискиГИСГМППараметрыПодписки.НаименованиеПараметра КАК НаименованиеПараметра,
	|	ПодпискиГИСГМППараметрыПодписки.ФорматПараметра КАК ФорматПараметра,
	|	ПодпискиГИСГМППараметрыПодписки.Обязательный КАК Обязательный,
	|	ПодпискиГИСГМППараметрыПодписки.ОписаниеДопОграничений КАК ОписаниеДопОграничений
	|ИЗ
	|	Справочник.ПодпискиГИСГМП.ПараметрыПодписки КАК ПодпискиГИСГМППараметрыПодписки
	|ГДЕ
	|	ПодпискиГИСГМППараметрыПодписки.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Подписка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ЭтотОбъект.ПараметрыПодписки.Очистить();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ЭтотОбъект.ПараметрыПодписки.Добавить(),ВыборкаДетальныеЗаписи);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли