Функция ПолучитьИдентификаторПодписки(Организация,Подписка) Экспорт
	Запрос = Новый Запрос;
	//В обмене с ИС РНИП может быть несколько подключено несколько одинаковых подписок,
	//и у них будет разный идентификатор
	Запрос.Текст = 
	"ВЫБРАТЬ Первые 1
	|	ПодключенныеПодпискиГИСГМПСрезПоследних.ИдентификаторПодписки КАК ИдентификаторПодписки
	|ИЗ
	|	РегистрСведений.ПодключенныеПодпискиГИСГМП.СрезПоследних КАК ПодключенныеПодпискиГИСГМПСрезПоследних
	|ГДЕ
	|	ПодключенныеПодпискиГИСГМПСрезПоследних.Организация = &Организация
	|	И ПодключенныеПодпискиГИСГМПСрезПоследних.Подписка = &Подписка
	|	И ПодключенныеПодпискиГИСГМПСрезПоследних.ПодпискаАктивна
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПодключенныеПодпискиГИСГМПСрезПоследних.Период УБЫВ";
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("Подписка",Подписка);
	Выборка = Запрос.Выполнить().Выбрать();
	ИдентификаторПодписки = "";
	Если Выборка.Следующий() Тогда
		ИдентификаторПодписки = Выборка.ИдентификаторПодписки;
	КонецЕсли;
	Возврат ИдентификаторПодписки;
КонецФункции

