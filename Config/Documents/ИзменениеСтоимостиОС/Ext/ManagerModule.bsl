#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует стркутру с данными ОС для одного ОС и Инвентарного номера, если есть. 
//
// Параметры:
//  Параметры см. функцией ПолучитьДанныеОС(...)
//
// Возвращаемое значение:
//  - Структура - ключи структуры, соответствуют колонкам таблицы значений, возвращаемой функцией ПолучитьДанныеОС(...)
Функция ДанныеОССтруктурой(Дата, Организация, ОсновноеСредство, ИнвентарныйНомер = Неопределено) Экспорт
	ТабОС = ПолучитьДанныеОС(Дата, Организация, ОсновноеСредство, ИнвентарныйНомер);
	
	Данные = Новый Структура;
	Для Каждого Колонка Из ТабОС.Колонки Цикл
	    Данные.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Если ТабОС.Количество() <> 0 Тогда
		ЗаполнитьЗначенияСвойств(Данные, ТабОС[0]);
	КонецЕсли;
	
	Возврат Данные;
КонецФункции	
	
// Формирует таблицу данных ОС для заполнения табличной части документа
//
// Параметры:
//  - Дата - Дата - дата, на которую собираются данные
//  - Организация - СправочникСсылка.Организации - организация, для которой собируются данные
//  - ОсновноеСредство - СправочникСсылка.ОсновныеСредства
//            ИЛИ Массив строк таблицы значений
//            ИЛИ ТаблицаЗначений - либо одно основное средство, либо таблица, с заполненными колонками
//                   	"ОсновноеСредство" и "ИнвентарныйНомер"
//  - ИнвентарныйНомер - СправочникСсылка.ИнвентарныеНомераОС - инвентарный номер
//
// Возвращаемое значение:
//  - ТаблицаЗначений - таблица, содрежащая данные ОС (см. поля текста запроса в фцнкции ТексЗапросаДанныеОС())
Функция ПолучитьДанныеОС(Дата, Организация, ОсновноеСредство, ИнвентарныйНомер = Неопределено) Экспорт
	ТабОС = Новый ТаблицаЗначений();
	ТабОС.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТабОС.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	
	УсловиеПоОСиИнвНомеру = "
	|(ОсновноеСредство, ИнвентарныйНомер) В (ВЫБРАТЬ ОсновноеСредство, ИнвентарныйНомер из ТабОС)";
	Если ТипЗнч(ОсновноеСредство) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		НоваяСтрока = ТабОС.Добавить();
		НоваяСтрока.ОсновноеСредство = ОсновноеСредство;
		Если ЗначениеЗаполнено(ИнвентарныйНомер) Тогда
			НоваяСтрока.ИнвентарныйНомер = ИнвентарныйНомер;
		Иначе	
			УсловиеПоОСиИнвНомеру = "
			|ОсновноеСредство В (ВЫБРАТЬ ОсновноеСредство из ТабОС)";
		КонецЕсли;
	ИначеЕсли ТипЗнч(ОсновноеСредство) = Тип("Массив") Тогда
		Для каждого ТекСтрока из ОсновноеСредство Цикл
			НоваяСтрока = ТабОС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;	
	ИначеЕсли ТипЗнч(ОсновноеСредство) = Тип("ТаблицаЗначений") Тогда
		ТабОС = ОсновноеСредство;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"			, Новый Граница(Дата, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ДатаСобытия"		, Дата);	
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);	
	Запрос.УстановитьПараметр("ИнвентарныйНомер", ИнвентарныйНомер);
	Запрос.УстановитьПараметр("НаБалансе"		, Перечисления.ВидыРаспоряженияОС.НаБалансе);
	Запрос.УстановитьПараметр("ТабОС"			, ТабОС);
	
	ТекстЗапроса = ТексЗапросаДанныеОС();
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоОСиИнвНомеру", УсловиеПоОСиИнвНомеру);
	
	Запрос.Текст = ТекстЗапроса;
	ТабДанных = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабДанных;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация,ВидОперации,Дата");
	
	ИзменениеАмортизации	= (ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийИзмененияСтоимостиОС.Амортизация);
	УвеличениеСтоимости		= (ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийИзмененияСтоимостиОС.Увеличение);
	СписаниеСтоимости		= (ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийИзмененияСтоимостиОС.Списание);
	ПередачаСтоимости		= (ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийИзмененияСтоимостиОС.Передача);
	ИзменениеНормы			= (ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийИзмененияСтоимостиОС.Норма);
	Реклассификация			= (ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийИзмененияСтоимостиОС.Реклассификация);
	
	УвеличениеАмортизации	= (ИзменениеАмортизации Или УвеличениеСтоимости Или Реклассификация);
	ИзменениеСтоимости		= (УвеличениеСтоимости Или СписаниеСтоимости Или ПередачаСтоимости);
	
	Если Не Реклассификация Тогда
		СтруктураДополнительныеСвойства.Вставить("НеФормироватьУчетныеДанныеИзПроводок");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"					, ДокументСсылка);
	Запрос.УстановитьПараметр("Период"					, ЗначенияРеквизитов.Дата);
	Запрос.УстановитьПараметр("Организация"				, ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("УвеличениеСтоимости"		, УвеличениеСтоимости);
	Запрос.УстановитьПараметр("СписаниеСтоимости"		, СписаниеСтоимости);
	Запрос.УстановитьПараметр("УвеличениеАмортизации"	, УвеличениеАмортизации);
	Запрос.УстановитьПараметр("ИзменениеСтоимости"		, ИзменениеСтоимости);
	Запрос.УстановитьПараметр("ИзменениеНормы"			, ИзменениеНормы);
	Запрос.УстановитьПараметр("Реклассификация"			, Реклассификация);
	
	ТаблицыЗапроса = Новый Массив;
	ТаблицыЗапроса.Добавить("РасчетАмортизацииОС");
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.СПИНовый КАК СрокПолезногоИспользования,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ОставшийсяСрокНовый < 1
	|			ТОГДА 1
	|		ИНАЧЕ ОсновныеСредства.ОставшийсяСрокНовый
	|	КОНЕЦ КАК СрокИспользованияДляВычисленияАмортизации,
	|	ОсновныеСредства.СтоимостьНовая - ОсновныеСредства.СуммаАмортизацииНовая - ОсновныеСредства.СуммаОбесцененияНовая КАК СтоимостьДляВычисленияАмортизации,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.СпособНачисленияАмортизацииНовый = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка)
	|			ТОГДА ОсновныеСредства.КоэффициентУскоренияНовый
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоэффициентУскорения,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.СпособНачисленияАмортизацииНовый = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции)
	|			ТОГДА ОсновныеСредства.ПараметрВыработкиНовый
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ПараметрВыработки,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.СпособНачисленияАмортизацииНовый = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции)
	|			ТОГДА ОсновныеСредства.ПредполагаемыйОбъемВыработкиНовый
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПредполагаемыйОбъемВыработки
	|ИЗ
	|	Документ.ИзменениеСтоимостиОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И ОсновныеСредства.Ссылка.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИзмененияСтоимостиОС.Амортизация)
	|	И НЕ(ОсновныеСредства.ПорядокПогашенияСтоимости = ОсновныеСредства.ПорядокПогашенияСтоимостиНовый
	|				И ОсновныеСредства.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается))
	|	И (ОсновныеСредства.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИзмененияСтоимостиОС.Норма)
	|			ИЛИ ОсновныеСредства.Стоимость <> ОсновныеСредства.СтоимостьНовая
	|			ИЛИ ОсновныеСредства.СуммаАмортизации <> ОсновныеСредства.СуммаАмортизацииНовая
	|			ИЛИ ОсновныеСредства.СуммаОбесценения <> ОсновныеСредства.СуммаОбесцененияНовая
	|			ИЛИ ОсновныеСредства.СПИ <> ОсновныеСредства.СПИНовый
	|			ИЛИ ОсновныеСредства.ОставшийсяСрок <> ОсновныеСредства.ОставшийсяСрокНовый
	|			ИЛИ ОсновныеСредства.ПараметрВыработки <> ОсновныеСредства.ПараметрВыработкиНовый
	|			ИЛИ ОсновныеСредства.ПредполагаемыйОбъемВыработки <> ОсновныеСредства.ПредполагаемыйОбъемВыработкиНовый
	|			ИЛИ ОсновныеСредства.КоэффициентУскорения <> ОсновныеСредства.КоэффициентУскоренияНовый)";
//	|	И ОсновныеСредства.СтоимостьНовая - ОсновныеСредства.СуммаАмортизацииНовая - ОсновныеСредства.СуммаОбесцененияНовая <> 0";
	
	ТаблицыЗапроса.Добавить("ПараметрыАмортизацииОСБухгалтерскийУчет");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ПорядокПогашенияСтоимостиНовый КАК ПорядокПогашенияСтоимости,
	|	ОсновныеСредства.СпособНачисленияАмортизацииНовый КАК СпособНачисленияАмортизации
	|ИЗ
	|	Документ.ИзменениеСтоимостиОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И (&ИзменениеСтоимости
	|			ИЛИ &Реклассификация)
	|	И (ОсновныеСредства.ПорядокПогашенияСтоимости <> ОсновныеСредства.ПорядокПогашенияСтоимостиНовый
	|			ИЛИ ОсновныеСредства.СпособНачисленияАмортизации <> ОсновныеСредства.СпособНачисленияАмортизацииНовый)";
	
	ТаблицыЗапроса.Добавить("");
	ТаблицыЗапроса.Добавить("");
	ТаблицыЗапроса.Добавить("СтоимостьОбъектовОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.СтоимостьНовая - ОсновныеСредства.Стоимость КАК Стоимость,
	|	ОсновныеСредства.Причина КАК Причина
	|ПОМЕСТИТЬ ВТ_Таблица
	|ИЗ
	|	Документ.ИзменениеСтоимостиОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И &ИзменениеСтоимости
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение,
	|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК СтоимостьОстаток,
	|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И (ОсновноеСредство, ИнвентарныйНомер) В
	|					(ВЫБРАТЬ
	|						ВТ_Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|						ВТ_Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер
	|					ИЗ
	|						ВТ_Таблица КАК ВТ_Таблица
	|					ГДЕ
	|						ВТ_Таблица.Стоимость <> 0)
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА &УвеличениеСтоимости
	|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	КОНЕЦ КАК ВидДвижения,
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Остатки.ЦМО КАК ЦМО,
	|	ВТ_Остатки.Подразделение КАК Подразделение,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе) КАК ВидРаспоряжения,
	|	ВЫБОР
	|		КОГДА &УвеличениеСтоимости
	|			ТОГДА ОсновныеСредства.Стоимость
	|		ИНАЧЕ -ОсновныеСредства.Стоимость
	|	КОНЕЦ КАК Стоимость,
	|	0 КАК Количество,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Прочее) КАК Событие,
	|	ОсновныеСредства.Ссылка.ВидПервичногоДокумента КАК НазваниеДокумента,
	|	ОсновныеСредства.Ссылка.НомерПервичногоДокумента КАК НомерДокумента,
	|	ОсновныеСредства.Ссылка.ДатаПервичногоДокумента КАК ДатаДокумента,
	|	ОсновныеСредства.Причина КАК Причина
	|ИЗ
	|	ВТ_Таблица КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ОсновныеСредства.ОсновноеСредство = ВТ_Остатки.ОсновноеСредство
	|			И ОсновныеСредства.ИнвентарныйНомер = ВТ_Остатки.ИнвентарныйНомер
	|ГДЕ
	|	ОсновныеСредства.Стоимость <> 0";
	
	ТаблицыЗапроса.Добавить("АмортизацияОбъектовОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА &УвеличениеАмортизации
	|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	КОНЕЦ КАК ВидДвижения,
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА &УвеличениеАмортизации
	|			ТОГДА ОсновныеСредства.СуммаАмортизацииНовая - ОсновныеСредства.СуммаАмортизации
	|		ИНАЧЕ ОсновныеСредства.СуммаАмортизации - ОсновныеСредства.СуммаАмортизацииНовая
	|	КОНЕЦ КАК СуммаАмортизации,
	|	ВЫБОР
	|		КОГДА &УвеличениеАмортизации
	|			ТОГДА ОсновныеСредства.СуммаОбесцененияНовая - ОсновныеСредства.СуммаОбесценения
	|		ИНАЧЕ ОсновныеСредства.СуммаОбесценения - ОсновныеСредства.СуммаОбесцененияНовая
	|	КОНЕЦ КАК СуммаОбесценения,
	|	ЛОЖЬ КАК ЭтоСписание
	|ИЗ
	|	Документ.ИзменениеСтоимостиОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И НЕ &ИзменениеНормы
	|	И (ОсновныеСредства.СуммаАмортизации <> ОсновныеСредства.СуммаАмортизацииНовая
	|			ИЛИ ОсновныеСредства.СуммаОбесценения <> ОсновныеСредства.СуммаОбесцененияНовая)";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
КонецПроцедуры

// Функция возвращает таблицу для источника данных при формировании проводок
//
Функция ТаблицаОС(РеквизитыДокумента = Неопределено) Экспорт
	
	Если РеквизитыДокумента = Неопределено Тогда
		
		ОписаниеТипаСчет		= Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
		ОписаниеТипаСубконто	= Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
		ОписаниеТипаСуммы		= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
		ОписаниеТипаЧисло		= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный));
		
		ПустаяТаблица = Новый ТаблицаЗначений;
		
		// Идентификация строки.
		ПустаяТаблица.Колонки.Добавить("ИмяСписка"						, ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
		ПустаяТаблица.Колонки.Добавить("СинонимСписка"					, ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
		ПустаяТаблица.Колонки.Добавить("НомерСтроки"					, ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
		// Таблица
		ПустаяТаблица.Колонки.Добавить("ОсновноеСредство"				, Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ПустаяТаблица.Колонки.Добавить("ИнвентарныйНомер"				, Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
		ПустаяТаблица.Колонки.Добавить("СтоимостьНовая"					, ОписаниеТипаСуммы);
		ПустаяТаблица.Колонки.Добавить("СуммаОбесцененияНовая"			, ОписаниеТипаСуммы);
		ПустаяТаблица.Колонки.Добавить("Стоимость"						, ОписаниеТипаСуммы);
		ПустаяТаблица.Колонки.Добавить("СуммаАмортизации"				, ОписаниеТипаСуммы);
		ПустаяТаблица.Колонки.Добавить("СуммаОбесценения"				, ОписаниеТипаСуммы);
		ПустаяТаблица.Колонки.Добавить("Количество"						, ОписаниеТипаЧисло);
		ПустаяТаблица.Колонки.Добавить("СПИ"							, ОписаниеТипаЧисло);
		ПустаяТаблица.Колонки.Добавить("СПИНовый"						, ОписаниеТипаЧисло);
		ПустаяТаблица.Колонки.Добавить("СпособНачисленияАмортизацииНовый",Новый ОписаниеТипов("ПеречислениеСсылка.СпособНачисленияАмортизации"));
		ПустаяТаблица.Колонки.Добавить("ПорядокПогашенияСтоимостиНовый"	, Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокПогашенияСтоимостиОС"));
		ПустаяТаблица.Колонки.Добавить("СчетУчета"						, ОписаниеТипаСчет);
		ПустаяТаблица.Колонки.Добавить("КПС"							, Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ПустаяТаблица.Колонки.Добавить("ЦМО"							, Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
		ПустаяТаблица.Колонки.Добавить("Подразделение"					, Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ПустаяТаблица.Колонки.Добавить("Договор"						, Новый ОписаниеТипов("СправочникСсылка.Договоры"));
		ПустаяТаблица.Колонки.Добавить("СчетУчетаЗатрат"				, ОписаниеТипаСчет);
		ПустаяТаблица.Колонки.Добавить("ПодразделениеСчетаУчетаЗатрат"	, Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ПустаяТаблица.Колонки.Добавить("КПССчетаУчетаЗатрат"			, Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ПустаяТаблица.Колонки.Добавить("КЭКСчетаУчетаЗатрат"			, Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
		ПустаяТаблица.Колонки.Добавить("СубконтоСчетаУчетаЗатрат1"		, ОписаниеТипаСубконто);
		ПустаяТаблица.Колонки.Добавить("СубконтоСчетаУчетаЗатрат2"		, ОписаниеТипаСубконто);
		ПустаяТаблица.Колонки.Добавить("СубконтоСчетаУчетаЗатрат3"		, ОписаниеТипаСубконто);
		ПустаяТаблица.Колонки.Добавить("СчетАмортизации"				, ОписаниеТипаСчет);
		ПустаяТаблица.Колонки.Добавить("СчетОбесценения"				, ОписаниеТипаСчет);
		
		Возврат ПустаяТаблица;
		
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.СтоимостьНовая КАК СтоимостьНовая,
	|	ОсновныеСредства.СуммаОбесцененияНовая КАК СуммаОбесцененияНовая,
	|	ОсновныеСредства.СтоимостьНовая - ОсновныеСредства.Стоимость КАК Стоимость,
	|	ОсновныеСредства.СуммаАмортизацииНовая - ОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ОсновныеСредства.СуммаОбесцененияНовая - ОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения,
	|	ОсновныеСредства.СПИ КАК СПИ,
	|	ОсновныеСредства.СПИНовый КАК СПИНовый,
	|	ОсновныеСредства.СпособНачисленияАмортизацииНовый КАК СпособНачисленияАмортизацииНовый,
	|	ОсновныеСредства.ПорядокПогашенияСтоимостиНовый КАК ПорядокПогашенияСтоимостиНовый
	|ПОМЕСТИТЬ Данные
	|ИЗ
	|	Документ.ИзменениеСтоимостиОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение,
	|	СтоимостьОбъектовОСОстатки.Договор КАК Договор,
	|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						Данные КАК ВТ)) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.КПС КАК КПС
	|ПОМЕСТИТЬ УчетныеДанные
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&Период,
	|			&Организация = Организация
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.НаБалансе)
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						Данные КАК ВТ)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АмортизацияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОССрезПоследних.СчетУчетаЗатрат КАК СчетУчетаЗатрат,
	|	АмортизацияОССрезПоследних.Подразделение КАК ПодразделениеСчетаУчетаЗатрат,
	|	АмортизацияОССрезПоследних.КПС КАК КПССчетаУчетаЗатрат,
	|	АмортизацияОССрезПоследних.КЭК КАК КЭКСчетаУчетаЗатрат,
	|	АмортизацияОССрезПоследних.Субконто1 КАК Субконто1,
	|	АмортизацияОССрезПоследних.Субконто2 КАК Субконто2,
	|	АмортизацияОССрезПоследних.Субконто3 КАК Субконто3
	|ПОМЕСТИТЬ АмортизацияОС
	|ИЗ
	|	РегистрСведений.АмортизацияОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						Данные КАК ВТ)) КАК АмортизацияОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""ОсновныеСредства"" КАК ИмяСписка,
	|	""Основные средства"" КАК СинонимСписка,
	|	Данные.НомерСтроки КАК НомерСтроки,
	|	Данные.ОсновноеСредство КАК ОсновноеСредство,
	|	Данные.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Данные.Стоимость КАК Стоимость,
	|	Данные.СуммаАмортизации КАК СуммаАмортизации,
	|	Данные.СуммаОбесценения КАК СуммаОбесценения,
	|	Данные.СтоимостьНовая КАК СтоимостьНовая,
	|	Данные.СуммаОбесцененияНовая КАК СуммаОбесцененияНовая,
	|	Данные.СПИ КАК СПИ,
	|	Данные.СПИНовый КАК СПИНовый,
	|	Данные.СпособНачисленияАмортизацииНовый КАК СпособНачисленияАмортизацииНовый,
	|	Данные.ПорядокПогашенияСтоимостиНовый КАК ПорядокПогашенияСтоимостиНовый,
	|	УчетныеДанные.СчетУчета КАК СчетУчета,
	|	УчетныеДанные.КПС КАК КПС,
	|	Остатки.ЦМО КАК ЦМО,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.Договор КАК Договор,
	|	Остатки.Количество КАК Количество,
	|	АмортизацияОС.СчетУчетаЗатрат КАК СчетУчетаЗатрат,
	|	АмортизацияОС.ПодразделениеСчетаУчетаЗатрат КАК ПодразделениеСчетаУчетаЗатрат,
	|	ВЫБОР
	|		КОГДА АмортизацияОС.КПССчетаУчетаЗатрат = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|			ТОГДА УчетныеДанные.КПС
	|		ИНАЧЕ АмортизацияОС.КПССчетаУчетаЗатрат
	|	КОНЕЦ КАК КПССчетаУчетаЗатрат,
	|	АмортизацияОС.КЭКСчетаУчетаЗатрат КАК КЭКСчетаУчетаЗатрат,
	|	АмортизацияОС.Субконто1 КАК СубконтоСчетаУчетаЗатрат1,
	|	АмортизацияОС.Субконто2 КАК СубконтоСчетаУчетаЗатрат2,
	|	АмортизацияОС.Субконто3 КАК СубконтоСчетаУчетаЗатрат3,
	|	СоответствиеСчетовОС.СчетАмортизации КАК СчетАмортизации,
	|	СоответствиеСчетовОС.СчетОбесценения КАК СчетОбесценения
	|ИЗ
	|	Данные КАК Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО Данные.ОсновноеСредство = Остатки.ОсновноеСредство
	|			И Данные.ИнвентарныйНомер = Остатки.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеДанные КАК УчетныеДанные
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
	|			ПО УчетныеДанные.СчетУчета = СоответствиеСчетовОС.СчетОС
	|		ПО Данные.ОсновноеСредство = УчетныеДанные.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ АмортизацияОС КАК АмортизацияОС
	|		ПО Данные.ОсновноеСредство = АмортизацияОС.ОсновноеСредство
	|
	|УПОРЯДОЧИТЬ ПО
	|	Данные.НомерСтроки";
	
	Если ТипЗнч(РеквизитыДокумента.Ссылка) = Тип("ДокументСсылка.ИзменениеСтоимостиИК") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИзменениеСтоимостиОС", "ИзменениеСтоимостиИК");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ОсновныеСредства.СуммаОбесцененияНовая - ОсновныеСредства.СуммаОбесценения", "0");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ОсновныеСредства.СуммаОбесцененияНовая", "0");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка"		, РеквизитыДокумента.Ссылка);
	Запрос.УстановитьПараметр("Период"		, РеквизитыДокумента.Дата);
	Запрос.УстановитьПараметр("Организация"	, РеквизитыДокумента.Организация);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
