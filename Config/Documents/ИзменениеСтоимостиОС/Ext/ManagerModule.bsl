//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Только бух. справка
	
КонецПроцедуры

#КонецОбласти

// Формирует текст запроса по получению данных ОС для заполнения табличной части документа
//
// Возвращаемое значение:
//  - Строка - текст запроса
Функция ТексЗапросаДанныеОС()
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТабОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТабОС.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ТабОС
	|ИЗ
	|	&ТабОС КАК ТабОС
	|	
	|ИНДЕКСИРОВАТЬ ПО	
	|	ОсновноеСредство,
	|	ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетнаяПолитикаОрганизаций.НачислятьАмортизациюПервымЧислом КАК НачислятьАмортизациюПервымЧислом,
	|	УчетнаяПолитикаОрганизаций.Период КАК Период
	|ПОМЕСТИТЬ ДатыУП
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|ГДЕ
	|	УчетнаяПолитикаОрганизаций.Организация = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДатыУП.НачислятьАмортизациюПервымЧислом КАК НачислятьАмортизациюПервымЧислом,
	|	ДатыУП.Период КАК Дата1,
	|	МИНИМУМ(ДОБАВИТЬКДАТЕ(ЕСТЬNULL(ДатыУП1.Период, ДАТАВРЕМЯ(2999, 1, 1)), СЕКУНДА, -1)) КАК Дата2
	|ПОМЕСТИТЬ ПериодыУП
	|ИЗ
	|	ДатыУП КАК ДатыУП
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДатыУП КАК ДатыУП1
	|		ПО ДатыУП.Период < ДатыУП1.Период
	|СГРУППИРОВАТЬ ПО
	|	ДатыУП.НачислятьАмортизациюПервымЧислом,
	|	ДатыУП.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК Стоимость
	|ПОМЕСТИТЬ ВТ_Стоимость
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&Период, Организация = &Организация
	|	И &УсловиеПоОСиИнвНомеру
	|	И ВидРаспоряжения = &НаБалансе) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АмортизацияОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	АмортизацияОбъектовОСОстатки.СуммаАмортизацииОстаток КАК СуммаАмортизации,
	|	АмортизацияОбъектовОСОстатки.СуммаОбесцененияОстаток КАК СуммаОбесценения
	|ПОМЕСТИТЬ ВТ_Амортизация
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС.Остатки(&Период, Организация = &Организация
	|	И &УсловиеПоОСиИнвНомеру) КАК АмортизацияОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	МИНИМУМ(СобытияОССрезПоследних.ДатаСобытия) КАК ДатаПринятияКУчету
	|ПОМЕСТИТЬ ВТ_Событие
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(&Период, Организация = &Организация
	|	И ОсновноеСредство В (ВЫБРАТЬ ОсновноеСредство из ТабОС)
	|	И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)
	|СГРУППИРОВАТЬ ПО
	|	СобытияОССрезПоследних.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетАмортизацииОС.ОсновноеСредство КАК ОсновноеСредство,
	|	РасчетАмортизацииОС.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
	|	РасчетАмортизацииОС.КоэффициентУскорения КАК КоэффициентУскорения,
	|	РасчетАмортизацииОС.ПараметрВыработки КАК ПараметрВыработки,
	|	РасчетАмортизацииОС.ПредполагаемыйОбъемВыработки КАК ПредполагаемыйОбъемВыработки,
	|	ВЫБОР
	|		КОГДА РАЗНОСТЬДАТ(ВЫБОР
	|			КОГДА НАЧАЛОПЕРИОДА(РасчетАмортизацииОС.Период, МЕСЯЦ) = НАЧАЛОПЕРИОДА(ВТ_Событие.ДатаПринятияКУчету, МЕСЯЦ)
	|			И НЕ ПериодыУП.НачислятьАмортизациюПервымЧислом
	|				ТОГДА ДОБАВИТЬКДАТЕ(РасчетАмортизацииОС.Период, МЕСЯЦ, 1)
	|			ИНАЧЕ РасчетАмортизацииОС.Период
	|		КОНЕЦ, &ДатаСобытия, МЕСЯЦ) <= 0
	|			ТОГДА 0
	|		ИНАЧЕ РАЗНОСТЬДАТ(ВЫБОР
	|			КОГДА НАЧАЛОПЕРИОДА(РасчетАмортизацииОС.Период, МЕСЯЦ) = НАЧАЛОПЕРИОДА(ВТ_Событие.ДатаПринятияКУчету, МЕСЯЦ)
	|			И НЕ ПериодыУП.НачислятьАмортизациюПервымЧислом
	|				ТОГДА ДОБАВИТЬКДАТЕ(РасчетАмортизацииОС.Период, МЕСЯЦ, 1)
	|			ИНАЧЕ РасчетАмортизацииОС.Период
	|		КОНЕЦ, &ДатаСобытия, МЕСЯЦ)
	|	КОНЕЦ + ВЫБОР
	|		КОГДА РасчетАмортизацииОС.СрокИспользованияДляВычисленияАмортизации = 0
	|		И НАЧАЛОПЕРИОДА(РасчетАмортизацииОС.Период, МЕСЯЦ) = НАЧАЛОПЕРИОДА(ВТ_Событие.ДатаПринятияКУчету, МЕСЯЦ)
	|		ИЛИ РасчетАмортизацииОС.СрокИспользованияДляВычисленияАмортизации >= РасчетАмортизацииОС.СрокПолезногоИспользования
	|			ТОГДА 0
	|		ИНАЧЕ РасчетАмортизацииОС.СрокПолезногоИспользования - РасчетАмортизацииОС.СрокИспользованияДляВычисленияАмортизации
	|	КОНЕЦ КАК ФактическийСрокПолезногоИспользования
	|ПОМЕСТИТЬ ВТ_СПИ
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(&Период, ОсновноеСредство В (ВЫБРАТЬ ОсновноеСредство из ТабОС)) КАК
	|		РасчетАмортизацииОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Событие КАК ВТ_Событие
	|		ПО РасчетАмортизацииОС.ОсновноеСредство = ВТ_Событие.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПериодыУП КАК ПериодыУП
	|		ПО РасчетАмортизацииОС.Период МЕЖДУ ПериодыУП.Дата1 И ПериодыУП.Дата2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации
	|ПОМЕСТИТЬ ВТ_Параметры
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(&Период, Организация = &Организация
	|	И ОсновноеСредство В (ВЫБРАТЬ ОсновноеСредство из ТабОС)) КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА НЕ ВТ_Стоимость.ИнвентарныйНомер ЕСТЬ NULL
	|			ТОГДА ВТ_Стоимость.ИнвентарныйНомер
	|		ИНАЧЕ ВТ_Амортизация.ИнвентарныйНомер
	|	КОНЕЦ КАК ИнвентарныйНомер,
	|	ВТ_Стоимость.Стоимость КАК Стоимость,
	|	ВТ_Стоимость.Стоимость КАК СтоимостьНовая,
	|	ВТ_Амортизация.СуммаАмортизации КАК СуммаАмортизации,
	|	ВТ_Амортизация.СуммаАмортизации КАК СуммаАмортизацииНовая,
	|	ВТ_Амортизация.СуммаОбесценения КАК СуммаОбесценения,
	|	ВТ_Амортизация.СуммаОбесценения КАК СуммаОбесцененияНовая,
	|	ВТ_СПИ.СрокПолезногоИспользования КАК СПИ,
	|	ВТ_СПИ.СрокПолезногоИспользования КАК СПИНовый,
	|	ВЫБОР
	|		КОГДА ВТ_СПИ.СрокПолезногоИспользования > ВТ_СПИ.ФактическийСрокПолезногоИспользования
	|			ТОГДА ВТ_СПИ.СрокПолезногоИспользования - ВТ_СПИ.ФактическийСрокПолезногоИспользования
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ОставшийсяСрок,
	|	ВЫБОР
	|		КОГДА ВТ_СПИ.СрокПолезногоИспользования > ВТ_СПИ.ФактическийСрокПолезногоИспользования
	|			ТОГДА ВТ_СПИ.СрокПолезногоИспользования - ВТ_СПИ.ФактическийСрокПолезногоИспользования
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ОставшийсяСрокНовый,
	|	ВТ_СПИ.КоэффициентУскорения КАК КоэффициентУскорения,
	|	ВТ_СПИ.КоэффициентУскорения КАК КоэффициентУскоренияНовый,
	|	ВТ_СПИ.ПараметрВыработки КАК ПараметрВыработки,
	|	ВТ_СПИ.ПараметрВыработки КАК ПараметрВыработкиНовый,
	|	ВТ_СПИ.ПредполагаемыйОбъемВыработки КАК ПредполагаемыйОбъемВыработки,
	|	ВТ_СПИ.ПредполагаемыйОбъемВыработки КАК ПредполагаемыйОбъемВыработкиНовый,
	|	ВТ_Параметры.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ВТ_Параметры.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимостиНовый,
	|	ВТ_Параметры.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
	|	ВТ_Параметры.СпособНачисленияАмортизации КАК СпособНачисленияАмортизацииНовый
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Стоимость КАК ВТ_Стоимость
	|		ПО ОсновныеСредства.Ссылка = ВТ_Стоимость.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Амортизация КАК ВТ_Амортизация
	|		ПО ОсновныеСредства.Ссылка = ВТ_Амортизация.ОсновноеСредство
	|			И ВТ_Стоимость.ИнвентарныйНомер = ВТ_Амортизация.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СПИ КАК ВТ_СПИ
	|		ПО ОсновныеСредства.Ссылка = ВТ_СПИ.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Параметры КАК ВТ_Параметры
	|		ПО ОсновныеСредства.Ссылка = ВТ_Параметры.ОсновноеСредство
	|ГДЕ
	|	ОсновныеСредства.Ссылка В (ВЫБРАТЬ ОсновноеСредство из ТабОС)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер";
	
	Возврат ТекстЗапроса;
КонецФункции	

#КонецОбласти

#КонецЕсли
