Функция ПолучитьДанныеПоОписям_194н(ДокументОбъект)
	
	Организация	= ДокументОбъект["Организация"];
	ТЗОписи		= ДокументОбъект["ИнвентаризационныеОписи"].Выгрузить();
	
	ПраваДоступаЧтение = ПолучитьПраваДоступаЧтение();
	
	ИсключитьНедоступныеОписи(ТЗОписи, ПраваДоступаЧтение);
	
	// Подготавливаем параметры
	СчетКассы					= БухгалтерскийУчет.СчетПоКоду("201.34",, Организация);
	СчетКассыФондовый			= БухгалтерскийУчет.СчетПоКоду("201.35",, Организация);
	СчетКассыФондовыйЗабаланс	= БухгалтерскийУчет.СчетПоКоду("08",, Организация);
	СчетБСО						= БухгалтерскийУчет.СчетПоКоду("03.1",, Организация);
	Если НЕ ЗначениеЗаполнено(СчетБСО) Тогда
		СчетБСО					= БухгалтерскийУчет.СчетПоКоду("03",, Организация);
	КонецЕсли;
	ЕдИзмШтука					= Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию();
	
	// Настройки из макета печатной формы 0504087
	Макет0504087 = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ИнвентаризационнаяОписьНФА_0504087_194н");
	Графа3_ВыводитьКодОС = ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет0504087, "Графа3_ВыводитьКодОС", Ложь);
	Графа3_ВыводитьКодМЗ = ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет0504087, "Графа3_ВыводитьКодМЗ", Истина);
	
