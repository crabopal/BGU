Функция ПолныйНомерСчета(ВыборкаДанные)

	КФОПредставление = ?(ЗначениеЗаполнено(ВыборкаДанные["КФО"]), Строка(ВыборкаДанные["КФО"]), "0");
	
	Если ВыборкаДанные["СчетУчетПоКПС"] = Истина Тогда
		КПСПредставление = ?(ЗначениеЗаполнено(ВыборкаДанные["КПС"]), Строка(ВыборкаДанные["КПС"]), "00000000000000000");
		КЭКПредставление = ?(ЗначениеЗаполнено(ВыборкаДанные["КЭК"]), Строка(ВыборкаДанные["КЭК"]), "000");
		
		Возврат КПСПредставление + "." + КФОПредставление + "." + ВыборкаДанные["Счет"] + "." + КЭКПредставление;
		
	Иначе
		Возврат КФОПредставление + "." + ВыборкаДанные["Счет"];
		
	КонецЕсли;
	
КонецФункции // НомерСчета()

#КонецОбласти

