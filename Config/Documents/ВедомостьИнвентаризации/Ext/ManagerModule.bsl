		ЭтоПерваяВыборка = Ложь;
	КонецЕсли;
	
	Если ПраваДоступаЧтение.ИнвентаризацияИК Тогда
		ТекстЗапроса = ТекстЗапроса
		+ ?(ЭтоПерваяВыборка, "", ТекстОбъединитьВсе)
		+ ?(ЭтоПерваяВыборка, ТекстВыбратьРазрешенные, ТекстВыбрать) + "
		|	ИнвентаризацияИК.ДолжностьПредседателяКомиссии	КАК ДолжностьПредседателяКомиссии,
		|	ИнвентаризацияИК.ФамилияПредседателяКомиссии	КАК ФамилияПредседателяКомиссии,
		|	ИнвентаризацияИК.ИмяПредседателяКомиссии		КАК ИмяПредседателяКомиссии,
		|	ИнвентаризацияИК.ОтчествоПредседателяКомиссии	КАК ОтчествоПредседателяКомиссии,
		|	ИнвентаризацияИК.ДатаПриказаИнвентаризации		КАК ДатаПриказаИнвентаризации,
		|	ИнвентаризацияИК.НомерПриказаИнвентаризации		КАК НомерПриказаИнвентаризации,
		|	ИнвентаризацияИК.ДатаПриказаКомиссии			КАК ДатаПриказаКомиссии,
		|	ИнвентаризацияИК.НомерПриказаКомиссии			КАК НомерПриказаКомиссии,
		|	ИнвентаризацияИК.МестоИнвентаризации			КАК МестоИнвентаризации,
		|	ИнвентаризацияИК.ПричинаИнвентаризации			КАК ПричинаИнвентаризации,
		|	ИнвентаризацияИК.СоставКомиссии.(
		|		ДолжностьЧленаКомиссии	КАК ДолжностьЧленаКомиссии,
		|		ФамилияЧленаКомиссии	КАК ФамилияЧленаКомиссии,
		|		ИмяЧленаКомиссии		КАК ИмяЧленаКомиссии,
		|		ОтчествоЧленаКомиссии	КАК ОтчествоЧленаКомиссии
		|	)
		|ИЗ
		|	Документ.ИнвентаризацияИК КАК ИнвентаризацияИК
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ОписьДляВыбораКомиссии
		|		ПО	ИнвентаризацияИК.Ссылка = ОписьДляВыбораКомиссии.Ссылка
		|";
		
		ЭтоПерваяВыборка = Ложь;
	КонецЕсли;
	
	ЗапросыВедомость.Текст = ТекстЗапроса;
	
	РезультатыЗапросов = ЗапросыВедомость.ВыполнитьПакет();
	
	// [2]. Описи, не содержащие расхождений
	НомераСтрокОписейБезРасхождений = РезультатыЗапросов[2].Выгрузить().ВыгрузитьКолонку("НомерСтроки");
	
	// [3]. Финальная таблица для заполнения ведомости
	ТаблицаВедомостьРасхождений = РезультатыЗапросов[3].Выгрузить();
	
	РеквизитыШапкиКомиссия = ПолучитьИменаРеквизитовШапкиКомиссия();
	
	// [5]. Данные для заполнения инвентаризационной комиссии
	ВыборкаКомиссия = РезультатыЗапросов[5].Выбрать();
	
	Если ВыборкаКомиссия.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыШапкиКомиссия, ВыборкаКомиссия);
		
		ТаблицаКомиссия = ВыборкаКомиссия["СоставКомиссии"].Выгрузить();
	Иначе
		ТаблицаКомиссия = Новый ТаблицаЗначений();
	КонецЕсли;
	
	// 3. Устанавливаем диапазон номеров БСО
	Поиск = Новый Структура("РазделДокумента", "БСО. Излишки");
	МассивСтрок = ТаблицаВедомостьРасхождений.НайтиСтроки(Поиск);
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СтрокаТаблицы["НомерОбъектаУчета"] = ПолучитьПредставлениеНомераБСО(СтрокаТаблицы["ДопПоле1"], // НачальныйНомер
			СтрокаТаблицы["ДопПоле3"]) 
			+ "-"
			+ ПолучитьПредставлениеНомераБСО(СтрокаТаблицы["ДопПоле2"], // КонечныйНомер
				СтрокаТаблицы["ДопПоле3"]);
	КонецЦикла;
	
	// 4. Устанавливаем диапазон номеров БСО
	Поиск = Новый Структура("РазделДокумента", "БСО. Недостачи");
	МассивСтрок = ТаблицаВедомостьРасхождений.НайтиСтроки(Поиск);
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СтрокаТаблицы["НомерОбъектаУчета"] = ПолучитьПредставлениеНомераБСО(СтрокаТаблицы["ДопПоле1"], // НачальныйНомер
			СтрокаТаблицы["ДопПоле3"]) 
			+ "-"
			+ ПолучитьПредставлениеНомераБСО(СтрокаТаблицы["ДопПоле2"], // КонечныйНомер
				СтрокаТаблицы["ДопПоле3"]);
	КонецЦикла;
	
	Данные = Новый Структура();
	Данные.Вставить("ТаблицаВедомостьРасхождений",		ТаблицаВедомостьРасхождений);
	Данные.Вставить("НомераСтрокОписейБезРасхождений",	НомераСтрокОписейБезРасхождений);
	Данные.Вставить("РеквизитыШапкиКомиссия",			РеквизитыШапкиКомиссия);
	Данные.Вставить("ТаблицаКомиссия",					ТаблицаКомиссия);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьПраваДоступаЧтение()
	
	ПраваДоступаЧтение = Новый Структура();
	
	ПраваДоступаЧтение.Вставить("ИнвентаризацияКассы",	ПравоДоступа("Чтение", Метаданные.Документы.ИнвентаризацияКассы));
	ПраваДоступаЧтение.Вставить("ИнвентаризацияМЗ",		ПравоДоступа("Чтение", Метаданные.Документы.ИнвентаризацияМЗ));
	ПраваДоступаЧтение.Вставить("ИнвентаризацияОС",		ПравоДоступа("Чтение", Метаданные.Документы.ИнвентаризацияОС));
	ПраваДоступаЧтение.Вставить("ИнвентаризацияИК",		ПравоДоступа("Чтение", Метаданные.Документы.ИнвентаризацияИК));
	
	Возврат ПраваДоступаЧтение;
	
КонецФункции

Процедура ИсключитьНедоступныеОписи(ТЗОписи, ПраваДоступаЧтение)
	
	// Исключаем недоступные типы документов в колонке Опись
	
	ВычитаемыеТипы = Новый Массив();
	
	Если НЕ ПраваДоступаЧтение.ИнвентаризацияКассы Тогда
		ВычитаемыеТипы.Добавить(Тип("ДокументСсылка.ИнвентаризацияКассы"));
	КонецЕсли;
	
	Если НЕ ПраваДоступаЧтение.ИнвентаризацияМЗ Тогда
		ВычитаемыеТипы.Добавить(Тип("ДокументСсылка.ИнвентаризацияМЗ"));
	КонецЕсли;
	
	Если НЕ ПраваДоступаЧтение.ИнвентаризацияОС Тогда
		ВычитаемыеТипы.Добавить(Тип("ДокументСсылка.ИнвентаризацияОС"));
	КонецЕсли;
	
	Если НЕ ПраваДоступаЧтение.ИнвентаризацияИК Тогда
		ВычитаемыеТипы.Добавить(Тип("ДокументСсылка.ИнвентаризацияИК"));
	КонецЕсли;
	
	ОписаниеТиповОписьПолное = ТЗОписи.Колонки.Найти("Опись").ТипЗначения;
	
	ОписаниеТиповОписьРазрешенные = Новый ОписаниеТипов(ОписаниеТиповОписьПолное,, ВычитаемыеТипы);
	
	ТЗОписиРазрешенные = ТЗОписи.Скопировать();
	ТЗОписиРазрешенные.Колонки.Добавить("ОписьРазрешенная", ОписаниеТиповОписьРазрешенные);
	
	КоличествоСтрок = ТЗОписиРазрешенные.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		
		ИндексСтроки = КоличествоСтрок - Счетчик;
		
		СтрокаТаблицы = ТЗОписиРазрешенные[ИндексСтроки];
		
		СтрокаТаблицы["ОписьРазрешенная"] = СтрокаТаблицы["Опись"];
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы["ОписьРазрешенная"]) Тогда
			ТЗОписиРазрешенные.Удалить(ИндексСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
	ТЗОписиРазрешенные.Колонки.Удалить("Опись");
	ТЗОписиРазрешенные.Колонки.Найти("ОписьРазрешенная").Имя = "Опись";
	
	ТЗОписи = ТЗОписиРазрешенные;	
	
КонецПроцедуры

