Процедура ЗаполнитьОбластьСтрокаТаблицы_0504092_194н(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗначенияПараметров = Новый Структура("НомерСчетаУчета", ПолныйНомерСчета(Выборка));
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
КонецПроцедуры

Процедура Печать0504092_194н_ВывестиИнвОписи(ТабДокумент, ВыборкаДокИнвОписи, ОбластьТитулИнвОписьНеПоследняя, ОбластьТитулИнвОписьПоследняя)
	
	ВыборкаДанные = ВыборкаДокИнвОписи.Выбрать();
	
	// Инв.описи с первой по предпоследнюю
	Для НомерСтроки = 1 По ВыборкаДанные.Количество() - 1 Цикл
		ЕстьДанные = ВыборкаДанные.Следующий();
		
		Печать0504092_194н_ВывестиИнвОпись(ТабДокумент, ВыборкаДанные, ОбластьТитулИнвОписьНеПоследняя, ЕстьДанные);
	КонецЦикла;
	
	// Последняя инв.опись
	ЕстьДанные = ВыборкаДанные.Следующий();
	Печать0504092_194н_ВывестиИнвОпись(ТабДокумент, ВыборкаДанные, ОбластьТитулИнвОписьПоследняя, ЕстьДанные);
	
КонецПроцедуры

Процедура Печать0504092_194н_ВывестиИнвОпись(ТабДокумент, ВыборкаИнвОписи, ВыводимаяОбласть, ЕстьДанные)
	
	
	ЗначенияПараметров = Новый Структура();
	
	Если ЕстьДанные Тогда
		ЗначенияПараметров.Вставить("НомерИнвОписи",
			РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
				ВыборкаИнвОписи.Опись,
				ВыборкаИнвОписи.НомерИнвОписи));
		ЗначенияПараметров.Вставить("ДатаИнвОписи", Формат(ВыборкаИнвОписи.ДатаИнвОписи, "ДФ=""дд ММММ гггг 'г.'"""));
	Иначе
		// Инв.описей вообще нет.
		ЗначенияПараметров.Вставить("НомерИнвОписи", "__");
		ЗначенияПараметров.Вставить("ДатаИнвОписи", """__"" ___________ 20__г.");
	КонецЕсли;
	
	ВыводимаяОбласть.Параметры.Заполнить(ЗначенияПараметров);
	
	ТабДокумент.Вывести(ВыводимаяОбласть);
	
КонецПроцедуры

