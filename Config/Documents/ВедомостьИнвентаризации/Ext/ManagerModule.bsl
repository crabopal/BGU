#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВедомостьИнвентаризации";
	КомандаПечати.Идентификатор		= "Форма0504092";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость расхождений (ф. 0504092)'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Форма0504092") Тогда
		
		ПрименяемыеПечатныеФормы = ИнвентаризацияСервер.ОпределитьПрименяемыеПечатныеФормы_194н(
			МассивОбъектов,
			"ВедомостьИнвентаризации");
		
		Ссылки52н = ПрименяемыеПечатныеФормы["Ссылки52н"];
		Ссылки194н = ПрименяемыеПечатныеФормы["Ссылки194н"];
		
		ТабличныеДокументы = Новый Соответствие();
		ТабличныйДокумент = Новый ТабличныйДокумент();
		
		//
		// Печатная форма в редакции Приказа 52н
		//
		Если Ссылки52н.Количество() > 0 Тогда
			ТабДокумент = Печать0504092(Ссылки52н, ОбъектыПечати);
			
			ТабличныеДокументы.Вставить("52н", ТабДокумент);
		КонецЕсли;
		
		//
		// Печатная форма в редакции Приказа 194н
		//
		
		Если Ссылки194н.Количество() > 0 Тогда
			
			Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			ТабДокумент = Печать0504092_194н(Ссылки194н, ОбъектыПечати);
			
			ТабличныеДокументы.Вставить("194н", ТабДокумент);
		КонецЕсли;
		
		// Порядок вывода версий печатных форм
		ПорядокВывода = Новый Массив();
		ПорядокВывода.Добавить("52н");
		ПорядокВывода.Добавить("194н");
		
		ОбщийТабличныйДокумент = Неопределено;
		
		Для Каждого ВерсияПечатнойФормы Из ПорядокВывода Цикл
			
			ПечатнаяФорма = ТабличныеДокументы.Получить(ВерсияПечатнойФормы);
			
			Если ПечатнаяФорма = Неопределено Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Если ОбщийТабличныйДокумент = Неопределено Тогда
				
				ОбщийТабличныйДокумент = ПечатнаяФорма;
				
			Иначе
				
				ОбщийТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				
				ОбщийТабличныйДокумент.Вывести(ПечатнаяФорма);
				
			КонецЕсли;
			
		КонецЦикла;
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"Форма0504092",
															"ф.0504092",
															ОбщийТабличныйДокумент);
	КонецЕсли;
	
КонецПроцедуры // Печать()

Процедура ЗаполнитьИнвентаризационныеОписи(ДокументОбъект) Экспорт
	
	ТаблицаИнвентаризационныеОписи = ПолучитьИнвентаризационныеОписи(ДокументОбъект);
	
	ДокументОбъект["ИнвентаризационныеОписи"].Загрузить(ТаблицаИнвентаризационныеОписи);
	
КонецПроцедуры

Процедура ЗаполнитьПоОписям(ДокументОбъект, ВозвратНомераСтрокОписейБезРасхождений = Неопределено) Экспорт
	
	Если ДокументОбъект["ВариантФормированияОписи"] = 0 Тогда
		// 0. Опись до 2018 г.
		
		Данные = ПолучитьДанныеПоОписям(ДокументОбъект);
		
		ОчиститьСоставИнвентаризационнойКомиссии(ДокументОбъект);
		
	Иначе
		// 1. Опись с 2018 г.
		
		Данные = ПолучитьДанныеПоОписям_194н(ДокументОбъект);
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, Данные["РеквизитыШапкиКомиссия"]);
		
		ДокументОбъект["СоставКомиссии"].Загрузить(Данные["ТаблицаКомиссия"]);
	КонецЕсли;
	
	ДокументОбъект["ВедомостьРасхождений"].Загрузить(Данные["ТаблицаВедомостьРасхождений"]);
	
	ВозвратНомераСтрокОписейБезРасхождений = Данные["НомераСтрокОписейБезРасхождений"];
	
КонецПроцедуры

Процедура ОчиститьСоставИнвентаризационнойКомиссии(ДокументОбъект) Экспорт
	
	ОчищающаяСтруктура = ПолучитьИменаРеквизитовШапкиКомиссия();
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ОчищающаяСтруктура);
	
	ДокументОбъект["СоставКомиссии"].Очистить();
	
КонецПроцедуры

Функция ПолучитьИменаРеквизитовШапкиКомиссия() Экспорт
	
	ИменаРеквизитов = Новый Структура("
		|ДолжностьПредседателяКомиссии,
		|ФамилияПредседателяКомиссии,
		|ИмяПредседателяКомиссии,
		|ОтчествоПредседателяКомиссии,
		|ДатаПриказаИнвентаризации,
		|НомерПриказаИнвентаризации,
		|ДатаПриказаКомиссии,
		|НомерПриказаКомиссии,
		|МестоИнвентаризации,
		|ПричинаИнвентаризации");
	
	Возврат ИменаРеквизитов;
	
КонецФункции

// Возвращает таблицу документов инвентаризации (описей) по указанному МОЛ.
//
// Параметры
//	 СтруктураПараметров	-	Структура или документ ВедомостьИнвентаризации с полями
//		- Организация
//		- МОЛ
//		- ДатаНачалаИнвентаризации
//		- ДатаОкончанияИнвентаризации
Функция ПолучитьИнвентаризационныеОписи(СтруктураПараметров) Экспорт
	
	СписокОтбораПоМОЛ = ИнвентаризацияСервер.ПолучитьСписокОтбораПоМОЛ(СтруктураПараметров);
	
	ПраваДоступаЧтение = ПолучитьПраваДоступаЧтение();
	
	ЗапросОписи = Новый Запрос();
	ЗапросОписи.УстановитьПараметр("Организация",	СтруктураПараметров["Организация"]);
	ЗапросОписи.УстановитьПараметр("МОЛ",			СписокОтбораПоМОЛ);
	ЗапросОписи.УстановитьПараметр("ДатаНачала",	СтруктураПараметров["ДатаНачалаИнвентаризации"]);
	ЗапросОписи.УстановитьПараметр("ДатаОкончания",	СтруктураПараметров["ДатаОкончанияИнвентаризации"]);
	
	ТекстОбъединитьВсе = "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|";
	
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Список инвентаризационных описей
	|//
	|// 0. Пустышка, используется для гарантированного наличия текста запроса
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НЕОПРЕДЕЛЕНО	КАК Опись,
	|	НЕОПРЕДЕЛЕНО	КАК Дата
	|ГДЕ
	|	ЛОЖЬ";
	
	Если ПраваДоступаЧтение.ИнвентаризацияКассы Тогда
		ТекстЗапроса = ТекстЗапроса	+ "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|// 1. ИнвентаризацияКассы
			|ВЫБРАТЬ
			|	Ссылка	КАК Опись,
			|	Дата	КАК Дата
			|ИЗ
			|	Документ.ИнвентаризацияКассы
			|ГДЕ
			|	Проведен
			|	И	ДатаНачала МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И	ДатаОкончания МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И	Организация = &Организация
			|	И	МОЛ В(&МОЛ)";
	КонецЕсли;
		
	Если ПраваДоступаЧтение.ИнвентаризацияМЗ Тогда
		ТекстЗапроса = ТекстЗапроса	+ "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|// 2. ИнвентаризацияМЗ
			|ВЫБРАТЬ
			|	Ссылка	КАК Опись,
			|	Дата	КАК Дата
			|ИЗ
			|	Документ.ИнвентаризацияМЗ
			|ГДЕ
			|	Проведен
			|	И	ДатаНачала МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И	ДатаОкончания МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И	Организация = &Организация
			|	И	ЦМО В(&МОЛ)";
	КонецЕсли;
	
	Если ПраваДоступаЧтение.ИнвентаризацияОС Тогда
		ТекстЗапроса = ТекстЗапроса	+ "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|// 3. ИнвентаризацияОС
			|ВЫБРАТЬ
			|	Ссылка	КАК Опись,
			|	Дата	КАК Дата
			|ИЗ
			|	Документ.ИнвентаризацияОС
			|ГДЕ
			|	Проведен
			|	И	ДатаНачала МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И	ДатаОкончания МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И	Организация = &Организация
			|	И	ЦМО В(&МОЛ)";
	КонецЕсли;
	
	Если ПраваДоступаЧтение.ИнвентаризацияИК Тогда
		ТекстЗапроса = ТекстЗапроса	+ "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|// 4. ИнвентаризацияИК
			|ВЫБРАТЬ
			|	Ссылка	КАК Опись,
			|	Дата	КАК Дата
			|ИЗ
			|	Документ.ИнвентаризацияИК
			|ГДЕ
			|	Проведен
			|	И	ДатаНачала МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И	ДатаОкончания МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И	Организация = &Организация
			|	И	ЦМО В(&МОЛ)";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса	+ "
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата
		|;";
	
	ЗапросОписи.Текст = ТекстЗапроса;
	
	Возврат ЗапросОписи.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьДанныеПоОписям(ДокументОбъект)
	
	Организация	= ДокументОбъект["Организация"];
	ТЗОписи		= ДокументОбъект["ИнвентаризационныеОписи"].Выгрузить();
	
	// Подготавливаем параметры
	СчетКассы					= БухгалтерскийУчет.СчетПоКоду("201.34",, Организация);
	СчетКассыФондовый			= БухгалтерскийУчет.СчетПоКоду("201.35",, Организация);
	СчетКассыФондовыйЗабаланс	= БухгалтерскийУчет.СчетПоКоду("08",, Организация);
	СчетБСО						= БухгалтерскийУчет.СчетПоКоду("03.1",, Организация);
	Если НЕ ЗначениеЗаполнено(СчетБСО) Тогда
		СчетБСО					= БухгалтерскийУчет.СчетПоКоду("03",, Организация);
	КонецЕсли;
	ЕдИзмШтука					= Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796"); // шт.
	
	// Настраиваем запрос
	ЗапросыВедомость = Новый Запрос();
	ЗапросыВедомость.УстановитьПараметр("ТЗОписи",						ТЗОписи);
	ЗапросыВедомость.УстановитьПараметр("СчетКассы",					СчетКассы);
	ЗапросыВедомость.УстановитьПараметр("СчетКассыФондовый",			СчетКассыФондовый);
	ЗапросыВедомость.УстановитьПараметр("СчетКассыФондовыйЗабаланс",	СчетКассыФондовыйЗабаланс);
	ЗапросыВедомость.УстановитьПараметр("СчетБСО",						СчетБСО);
	ЗапросыВедомость.УстановитьПараметр("ЕдИзмШтука",					ЕдИзмШтука);
	ЗапросыВедомость.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Исходные документы (инвентаризационные описи)
	|//		(Заполнение ведомости по описям)
	|//
	|ВЫБРАТЬ
	|	ТЗ.Опись		КАК Опись,
	|	ТЗ.НомерСтроки	КАК НомерСтроки
	|ПОМЕСТИТЬ
	|	Описи
	|ИЗ
	|	&ТЗОписи	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Цены номенклатуры (для заполнения поля ""Сумма"" в недостачах МЗ)
	|//		(Заполнение ведомости по описям)
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Ссылка			КАК ДокСсылка,
	|	Номенклатура	КАК Номенклатура,
	|	МАКСИМУМ(Цена)	КАК Цена
	|ПОМЕСТИТЬ
	|	ЦеныНоменклатуры
	|ИЗ
	|	Описи
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	Документ.ИнвентаризацияМЗ.Материалы	КАК ТЗ
	|		ПО	Описи.Опись = ТЗ.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	Ссылка,
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. (Подготовка) Цены ОС (для заполнения поля ""Сумма"" в недостачах ОС)
	|//		(Заполнение ведомости по описям)
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Ссылка				КАК ДокСсылка,
	|	ОсновноеСредство	КАК ОС,
	|	МАКСИМУМ(Цена)		КАК Цена
	|ПОМЕСТИТЬ
	|	ЦеныОС
	|ИЗ
	|	Описи
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	Документ.ИнвентаризацияОС.Инвентаризация	КАК ТЗ
	|		ПО	Описи.Опись = ТЗ.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	Ссылка,
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. (Подготовка) Финальная таблица для заполнения ведомости
	|//		(Заполнение ведомости по описям)
	|//
	|// 1. Документы ""ИнвентаризацияКассы""
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""Касса (наличные средства). Излишки""	КАК РазделДокумента,
	|	Описи.Опись								КАК ДокСсылка,
	|	Описи.Опись.Дата						КАК Дата,
	|	""Касса (наличные средства). Излишки""	КАК	ИспользованиеДопПолей,
	|	ТЧ.ИФО									КАК ДопПоле1,
	|	ТЧ.КФО									КАК ДопПоле2,
	|	НЕОПРЕДЕЛЕНО							КАК ДопПоле3,
	|	
	|	ТЧ.Ссылка.МОЛ							КАК МОЛ,
	|	ТЧ.Валюта.Наименование					КАК ОбъектУчета,
	|	ТЧ.Валюта.Код							КАК НомерОбъектаУчета,
	|	НЕОПРЕДЕЛЕНО							КАК ЕдИзм,
	|	ТЧ.КПС									КАК КПС,
	|	ТЧ.КФО									КАК КФО,
	|	&СчетКассы								КАК Счет,
	|	НЕОПРЕДЕЛЕНО							КАК КЭК, //*** будет рассчитано позже (в коде)
	|	
	|	0										КАК БалансоваяСтоимость,
	|	0										КАК ЕстественнаяУбыльКоличество,
	|	0										КАК ЕстественнаяУбыльСумма,
	|	0										КАК СверхНормКоличество,
	|	0										КАК СверхНормСумма,
	|	0										КАК РыночнаяСтоимость,
	|	0										КАК РазницаСтоимостей,
	|	
	|	0										КАК ИзлишкиКоличество,
	|	ТЧ.Сумма								КАК ИзлишкиСумма
	|
	|ПОМЕСТИТЬ
	|	Ведомость
	|ИЗ
	|	Описи
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	Документ.ИнвентаризацияКассы.ДенежныеСредстваИзлишки	КАК ТЧ
	|		ПО	Описи.Опись = ТЧ.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Касса (наличные средства). Недостачи""	КАК РазделДокумента,
	|	Описи.Опись								КАК ДокСсылка,
	|	Описи.Опись.Дата						КАК Дата,
