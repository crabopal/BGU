Функция ПолучитьПредставлениеНомераБСО(НомерЧисло, ДлинаПредставления)
	
	Если НомерЧисло = 0 Тогда
		НомерСтрокой = "";
		
	Иначе
		Если НЕ ЗначениеЗаполнено(ДлинаПредставления) Тогда
			ДлинаПредставления = ОбщегоНазначенияБГУКлиентСервер.МаксимальнаяДлинаНомераБСО();
		КонецЕсли;
		
		НомерСтрокой = Формат(Число(НомерЧисло), "ЧГ=0");
		ТекущаяДлинаНомера = СтрДлина(НомерСтрокой);
		
		КоличествоСимволов = ДлинаПредставления - ТекущаяДлинаНомера;
		Для сч = 1 по КоличествоСимволов Цикл 
			НомерСтрокой = "0" + НомерСтрокой;
		КонецЦикла;
	КонецЕсли;
	
	Возврат НомерСтрокой;
	
КонецФункции	

Функция Печать0504092(МассивСсылок, ОбъектыПечати)
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = "ПечатьФормы0504092";
	
	// Используемый макет:
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ВедомостьИнвентаризации.ПФ_MXL_Ф0504092");
	
	// Настраиваем запрос:
	ЗапросыПечать = Новый Запрос();
	ЗапросыПечать.УстановитьПараметр("МассивСсылок", МассивСсылок);
	
	ЗапросыПечать.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Шапка документа
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка							КАК ДокСсылка,
	|	Док.Номер							КАК Номер,
	|	Док.Дата 							КАК Дата,
	|	Док.Организация						КАК Организация,
	|	Док.Организация.НаименованиеПолное	КАК НаименованиеОрганизации,
	|	Док.Подразделение.Наименование		КАК НаименованиеПодразделения,
	|	Док.Организация.КодОКПО				КАК КодОКПО
	|	
	|ИЗ
	|	Документ.ВедомостьИнвентаризации	КАК Док
	|
	|ГДЕ
	|	Док.Ссылка В (&МассивСсылок)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Таблица данных документа
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка									КАК ДокСсылка,
	|	НомерСтроки								КАК НПП,
	|	
	|	МОЛ.Наименование + "", "" + ОбъектУчета	КАК НаименованиеМОЛОбъектУчета,
	|	НомерОбъектаУчета						КАК НомерОбъектаУчета,
	|	ЕдИзм.Наименование						КАК ЕдИзм,
	|	ЕдИзм.Код								КАК КодЕдИзм,
	|	КПС										КАК КПС,
	|	КФО										КАК КФО,
	|	Счет									КАК Счет,
	|	Счет.УчетПоКПС							КАК СчетУчетПоКПС,
	|	КЭК										КАК КЭК,
	|	БалансоваяСтоимость						КАК БалансоваяСтоимость,
	|	ЕстественнаяУбыльКоличество				КАК ЕстественнаяУбыльКоличество,
	|	ЕстественнаяУбыльСумма					КАК ЕстественнаяУбыльСумма,
	|	СверхНормКоличество						КАК СверхНормКоличество,
	|	СверхНормСумма							КАК СверхНормСумма,
	|	РыночнаяСтоимость						КАК РыночнаяСтоимость,
	|	РазницаСтоимостей						КАК РазницаСтоимостей,
	|	ИзлишкиКоличество						КАК ИзлишкиКоличество,
	|	ИзлишкиСумма							КАК ИзлишкиСумма
	|
	|ИЗ
	|	Документ.ВедомостьИнвентаризации.ВедомостьРасхождений	КАК ТЧ
	|
	|ГДЕ
	|	Ссылка В (&МассивСсылок)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|
	|ИТОГИ
	|	СУММА(БалансоваяСтоимость)		КАК БалансоваяСтоимость,
	|	СУММА(ЕстественнаяУбыльСумма)	КАК ЕстественнаяУбыльСумма,
	|	СУММА(СверхНормСумма)			КАК СверхНормСумма,
	|	СУММА(РыночнаяСтоимость)		КАК РыночнаяСтоимость,
	|	СУММА(РазницаСтоимостей)		КАК РазницаСтоимостей,
	|	СУММА(ИзлишкиСумма)				КАК ИзлишкиСумма
	|ПО
	|	// Обязательно первые итоги по ссылке на документ:
	| 	ДокСсылка
	|;";
	
	РезультатПечать = ЗапросыПечать.ВыполнитьПакет();
	
	ВыборкаШапка		= РезультатПечать[0].Выбрать();
	ВыборкаДокДанные	= РезультатПечать[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Выборки по документам:
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		// Используемые области макета:
		ОбластьТитул			= Макет.ПолучитьОбласть("Титул");
		ОбластьШапка 			= Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока 			= Макет.ПолучитьОбласть("Строка");
		ОбластьИтогоПоСтранице	= Макет.ПолучитьОбласть("ИтогоПоСтранице");
		ОбластьПодвал 			= Макет.ПолучитьОбласть("Подвал");
	
		// Продвигаемся в остальных выборках до текущего документа:
		ПоискТекущегоДокумента = Новый Структура("ДокСсылка", ВыборкаШапка["ДокСсылка"]);
		ВыборкаДокДанные.Сбросить();
		ЕстьВыборкаДокДанные = ВыборкаДокДанные.НайтиСледующий(ПоискТекущегоДокумента);
		
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		//---
		// Титул
		//---
		НомерСтраницы  = 1;
	
		// Заполняем значения параметров выводимой области:
		ЗначенияПараметров = Новый Структура("ДатаПрописью", Формат(ВыборкаШапка.Дата, "ДЛФ=DD"));
		ОбластьТитул.Параметры.Заполнить(ВыборкаШапка);
		ОбластьТитул.Параметры.Заполнить(ЗначенияПараметров);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(
			ОбластьТитул,
			"Номер",
			ВыборкаШапка.Номер,
			ВыборкаШапка.ДокСсылка,
			Неопределено,
			Истина);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьТитул);
		ТабДокумент.Вывести(ОбластьШапка);
		
		//---
		// Подвал
		// (заполняем, но сейчас не выводим)
		//---
		// Заполняем значения параметров выводимой области:
		ЗначенияПараметров = Новый Структура("Дата, ФИОГлавныйБухгалтер",
			ВыборкаШапка.Дата,
			БюджетнаяОтчетностьПолучениеНСИ.ФИОГлавногоБухгалтера(ВыборкаШапка.Организация, ВыборкаШапка.Дата));
		ОбластьПодвал.Параметры.Заполнить(ЗначенияПараметров);
		// Итого:
		Если ЕстьВыборкаДокДанные Тогда
