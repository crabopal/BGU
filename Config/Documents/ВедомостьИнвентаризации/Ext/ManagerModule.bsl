	ЗапросыВедомость.УстановитьПараметр("СчетКассыФондовыйЗабаланс",	СчетКассыФондовыйЗабаланс);
	ЗапросыВедомость.УстановитьПараметр("СчетБСО",						СчетБСО);
	ЗапросыВедомость.УстановитьПараметр("ЕдИзмШтука",					ЕдИзмШтука);
	ЗапросыВедомость.УстановитьПараметр("КФО1",							Перечисления.КВД.Бюджет);
	ЗапросыВедомость.УстановитьПараметр("Графа3_ВыводитьКодОС",			Графа3_ВыводитьКодОС);
	ЗапросыВедомость.УстановитьПараметр("Графа3_ВыводитьКодМЗ",			Графа3_ВыводитьКодМЗ);
	
