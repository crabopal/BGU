// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ВедомостьРасхождений

&НаКлиенте
Процедура ВедомостьРасхожденийПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Объект["ВариантФормированияОписи"] = 1 Тогда
		Возврат
	КонецЕсли;
	
	ТекМОЛ = Объект["МОЛ"];
	
	Если НоваяСтрока И НЕ Копирование И ЗначениеЗаполнено(ТекМОЛ)Тогда
		ТекДанные = Элементы["ВедомостьРасхождений"].ТекущиеДанные;
		ТекДанные["МОЛ"] = ТекМОЛ;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВедомостьРасхожденийСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы["ВедомостьРасхождений"].ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			ТекущиеДанные.Счет, 
																			ТекущиеДанные.КПС, 
																			ТекущиеДанные.КФО), 
															Объект.Организация,
															,
															,
															ТекущиеДанные.КФО,
															,
															Объект.Дата);
КонецПроцедуры
&НаКлиенте
Процедура ВедомостьРасхожденийСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы["ВедомостьРасхождений"].ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
															ТекущиеДанные.КПС,
															ТекущиеДанные.КФО,
															ТекущиеДанные.КЭК);
КонецПроцедуры

&НаКлиенте
Процедура ВедомостьРасхожденийКПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы["ВедомостьРасхождений"].ТекущиеДанные;

