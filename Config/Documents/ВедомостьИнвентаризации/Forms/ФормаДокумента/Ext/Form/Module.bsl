													Объект.Организация,
													,
													ТекущиеДанные.КФО,
													ТекущиеДанные.Счет,
													Объект.Дата);
КонецПроцедуры

&НаКлиенте
Процедура ВедомостьРасхожденийКЭКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы["ВедомостьРасхождений"].ТекущиеДанные;
    	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент, 
								СтандартнаяОбработка,
								ТекущиеДанные.КЭК,
								Объект.Организация, 
								,
								ТекущиеДанные.КФО, 
                                ТекущиеДанные.Счет,
								Объект.Дата,
								"Дт");
КонецПроцедуры


&НаКлиенте
Процедура РассчитатьСуммыВСтроке(Элемент)
	
	ТекущиеДанные = Элементы["ВедомостьРасхождений"].ТекущиеДанные;
	
	ИмяИзмененногоПоля = Сред(Элемент.Имя, 21); // Длина("ВедомостьРасхождений")=20
	
	Если Объект["ВариантФормированияОписи"] = 0 Тогда
		// 0. Опись до 2018 г.
		
		Если ИмяИзмененногоПоля = "БалансоваяСтоимость"
			ИЛИ ИмяИзмененногоПоля = "РыночнаяСтоимость" Тогда
			
			ТекущиеДанные["РазницаСтоимостей"] = ТекущиеДанные["РыночнаяСтоимость"] - ТекущиеДанные["БалансоваяСтоимость"];
		КонецЕсли;
		
	Иначе
		// 1. Опись с 2018 г.
		
		// Гр.11 = Гр.10 х Гр.6
		// Недостача в пределах естественной убыли
		Если ИмяИзмененногоПоля = "БалансоваяЦена"
			ИЛИ ИмяИзмененногоПоля = "ЕстественнаяУбыльКоличество" Тогда
			
			ТекущиеДанные["ЕстественнаяУбыльСумма"] = ТекущиеДанные["БалансоваяЦена"] * ТекущиеДанные["ЕстественнаяУбыльКоличество"];
		КонецЕсли;
		
		// Гр.9 = Гр.8 х Гр.6
		// Всего недостача
		Если ИмяИзмененногоПоля = "БалансоваяЦена"
			ИЛИ ИмяИзмененногоПоля = "ЕстественнаяУбыльКоличество"
			ИЛИ ИмяИзмененногоПоля = "СверхНормКоличество" Тогда
			
			НедостачаВсегоКоличество = ТекущиеДанные["ЕстественнаяУбыльКоличество"] + ТекущиеДанные["СверхНормКоличество"];
			
			НедостачаВсегоСумма = ТекущиеДанные["БалансоваяЦена"] * НедостачаВсегоКоличество;
			
			ТекущиеДанные["СверхНормСумма"] = НедостачаВсегоСумма - ТекущиеДанные["ЕстественнаяУбыльСумма"];
		КонецЕсли;
		
		// Гр.13 = Гр.12 х Гр.7
		// Излишки
		Если ИмяИзмененногоПоля = "ОценочнаяЦена"
			ИЛИ ИмяИзмененногоПоля = "ИзлишкиКоличество" Тогда
			
			ТекущиеДанные["ИзлишкиСумма"] = ТекущиеДанные["ОценочнаяЦена"] * ТекущиеДанные["ИзлишкиКоличество"];
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

