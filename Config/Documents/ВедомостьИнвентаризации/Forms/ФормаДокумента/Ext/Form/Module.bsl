	Если Объект["ВедомостьРасхождений"].Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Отсутствуют расхождения (недостачи и излишки) во всех указанных описях'");
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОписямСервер()
	
	Перем НомераСтрокОписейБезРасхождений;
	
	Документы.ВедомостьИнвентаризации.ЗаполнитьПоОписям(Объект, НомераСтрокОписейБезРасхождений);
	
	// Если есть описи, которые не содержат расхождений, то выведем об этом сообщения
	Если НомераСтрокОписейБезРасхождений.Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru='Обнаружены инвентаризационные описи, среди указанных, которые не содержат расхождений (излишков или недостач)'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект["Ссылка"],
			"Объект.ИнвентаризационныеОписи");
			
		Для Каждого НомерСтроки Из НомераСтрокОписейБезРасхождений Цикл
			ИндексСтрокиТекст = Формат(НомерСтроки - 1, "ЧГ=0");
			
			Текст = НСтр("ru='Опись не содержит расхождений (таблица ""Инвентаризационные описи"", строка %1)'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, НомерСтроки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				Объект["Ссылка"],
				"Объект.ИнвентаризационныеОписи[" + ИндексСтрокиТекст + "].Опись");
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

