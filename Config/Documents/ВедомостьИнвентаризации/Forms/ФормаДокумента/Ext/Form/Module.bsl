// Заполнение табличных частей

// Вызывается перед заполнением по данным учета, чтобы убедиться в заполненности отбора.
&НаКлиенте
Функция НеобходимыеРеквизитыЗаполнены()
	
	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""Организация"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.Организация");
	КонецЕсли;
	
	Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоПодразделениям") И НЕ ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""Подразделение"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.Подразделение");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.МОЛ) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""МОЛ"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.МОЛ");
		КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Объект.ДатаНачалаИнвентаризации) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""Дата начала инвентаризации"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.ДатаНачалаИнвентаризации");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОкончанияИнвентаризации) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""Дата окончания инвентаризации"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.ДатаОкончанияИнвентаризации");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаНачалаИнвентаризации) И ЗначениеЗаполнено(Объект.ДатаОкончанияИнвентаризации)
		И Объект.ДатаНачалаИнвентаризации > Объект.ДатаОкончанияИнвентаризации Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Неверно задан период инвентаризации: начальная дата больше конечной'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.ДатаНачалаИнвентаризации");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьОписиКлиент()
	
	ЗаполнитьОписиСервер();
	
	Если Объект["ИнвентаризационныеОписи"].Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Проведенные документы инвентаризации отсутствуют для указанных МОЛ и периода инвентаризации'");
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

