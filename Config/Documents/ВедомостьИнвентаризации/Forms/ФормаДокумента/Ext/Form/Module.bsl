&НаСервереБезКонтекста
Функция ПолучитьСписокОтбораПоМОЛ(МОЛ, Организация)
	
	ШапкаДокумента = Новый Структура();
	ШапкаДокумента.Вставить("МОЛ", МОЛ);
	ШапкаДокумента.Вставить("Организация", Организация);
	
	Возврат ИнвентаризацияСервер.ПолучитьСписокОтбораПоМОЛ(ШапкаДокумента);
	
КонецФункции

&НаСервере
Процедура ИнициализироватьТипыОписей()
	
	ТипыОписей.Очистить();
	
	МассивТипов = Метаданные.Документы.ВедомостьИнвентаризации.ТабличныеЧасти.ИнвентаризационныеОписи.Реквизиты.Опись.Тип.Типы();
	
	Для Каждого Тип Из МассивТипов Цикл
		ПредставлениеТипа = ОбщегоНазначения.СтроковоеПредставлениеТипа(Тип);
		
		ИмяДокумента = СтрЗаменить(ПредставлениеТипа, "ДокументСсылка.", "");
		
		ОбъектМетаданных = Метаданные.Документы[ИмяДокумента];
		
		ТипыОписей.Добавить(ИмяДокумента, ОбъектМетаданных.Представление());
	КонецЦикла;
	
	ТипыОписей.СортироватьПоПредставлению();
	
КонецПроцедуры	
	
&НаКлиенте
Процедура ИнвентаризационныеОписиОписьНачалоВыбора_Выбор(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОткрытьФормуТиповОписей(Результат.Значение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуТиповОписей(ИмяДокумента)
	
	ИмяОткрываемойФормы = "Документ." + ИмяДокумента + ".ФормаВыбора";
	
	Отбор = Новый Структура();
	Отбор.Вставить("Организация", Объект.Организация);
	Отбор.Вставить("Проведен", Истина);
	
	Если ЗначениеЗаполнено(Объект.МОЛ) Тогда
		СписокОтбораПоМОЛ = ПолучитьСписокОтбораПоМОЛ(Объект.МОЛ, Объект.Организация);
		
		Отбор.Вставить("МОЛ", СписокОтбораПоМОЛ);
		Отбор.Вставить("ЦМО", СписокОтбораПоМОЛ);
	КонецЕсли;
	
	ПараметрыОткрываемойФормы = Новый Структура("Отбор", Отбор);
	
	ПараметрыОткрываемойФормы.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыОткрываемойФормы, Элементы.ИнвентаризационныеОписиОпись);
	
КонецПроцедуры

