#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Используемые параметры:
	Перем ПараметрОрганизация, ПараметрМОЛ, ПараметрОбластьПоискаМОЛ;
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "Список");
	
	// Отбор по организации:
	ОтборОрганизация = Параметры.Организация;
	Если НЕ ЗначениеЗаполнено(ОтборОрганизация) И Параметры.Отбор.Свойство("Организация", ПараметрОрганизация) Тогда
		ОтборОрганизация = ПараметрОрганизация;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ОтборОрганизация) Тогда
		ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(Список, ОтборОрганизация);
	КонецЕсли;
	ОтборОрганизацияПриИзмененииНаСервере();
	
	// Отбор по МОЛ:
	ОтборМОЛ = Параметры.МОЛ;
	Если НЕ ЗначениеЗаполнено(ОтборМОЛ) И Параметры.Отбор.Свойство("МОЛ", ПараметрМОЛ) Тогда
		ОтборМОЛ = ПараметрМОЛ;
	КонецЕсли;
	
	ЗаполнитьСписокМОЛДляОтбора();
	
	// Отбор по области поиска МОЛ:
	ОбластьПоиска = Параметры.ОбластьПоискаМОЛ;
	Если НЕ ЗначениеЗаполнено(ОбластьПоиска) И Параметры.Отбор.Свойство("ОбластьПоискаМОЛ", ПараметрОбластьПоискаМОЛ) Тогда
		ОбластьПоиска = ПараметрОбластьПоискаМОЛ;
	КонецЕсли;
	ОбластьПоиска = ВРег(ОбластьПоиска);
	Если ОбластьПоиска = "ШАПКА" ИЛИ ОбластьПоиска = "В ШАПКЕ" Тогда
		ОбластьПоискаМОЛ = 1;
	ИначеЕсли ОбластьПоиска = "ТАБЛИЦА" ИЛИ ОбластьПоиска = "В ТАБЛИЦЕ" Тогда
		ОбластьПоискаМОЛ = 2;
	ИначеЕсли ОбластьПоиска = "ВЕЗДЕ" Тогда
		ОбластьПоискаМОЛ = 3;
	Иначе
		ОбластьПоискаМОЛ = 1;
	КонецЕсли;
	
	// Взаимосвязь параметров:
	// При пустом МОЛ явно устанавливаем режим поиска "Только в шапке":
	Если НЕ ЗначениеЗаполнено(ОтборМОЛ) Тогда
		ОбластьПоискаМОЛ = 1;
	КонецЕсли;
	
	НастроитьФормуСервер();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.КомандыФормы;
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.КомандыФормы);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Отключаем автоматический отбор по МОЛ (такой отбор выполняется запросом списка)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "МОЛ", ,,, Ложь);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	ОтборОрганизацияПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборМОЛПриИзменении(Элемент)
	
	ЗаполнитьСписокМОЛДляОтбора();
	
	ОбновитьСписок();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбластьПоискаМОЛПриИзменении(Элемент)
	
	ОбновитьСписок();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Элементы.Список);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Элементы.Список, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.Список);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НастроитьФормуСервер()
	
	Элементы["ОтборОрганизация"].ТолькоПросмотр = ЗначениеЗаполнено(ОтборОрганизация);
	
	НовВидимостьМОЛ = ЗначениеЗаполнено(ОтборМОЛ);
	Элементы["ОтборМОЛ"].Видимость			= НовВидимостьМОЛ;
	Элементы["ОбластьПоискаМОЛ"].Видимость	= НовВидимостьМОЛ;
	
	УстановитьПараметрыСписка(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок()
	
	УстановитьПараметрыСписка(ЭтаФорма);
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПараметрыСписка(Форма)
	
	ОтборМОЛ = Форма.ОтборМОЛ;
	
	ОбластьПоискаМОЛ = Форма.ОбластьПоискаМОЛ;
	
	СписокМОЛДляОтбора = Форма.СписокМОЛДляОтбора;
	
	ИскатьМОЛВШапке = (ОбластьПоискаМОЛ = 1 ИЛИ ОбластьПоискаМОЛ = 3);
	
	ИскатьМОЛВТаблице = (ОбластьПоискаМОЛ = 2 ИЛИ ОбластьПоискаМОЛ = 3);
	
	ИспользоватьОтборПоМОЛ = ЗначениеЗаполнено(ОтборМОЛ);
	
	Форма.Список.Параметры.УстановитьЗначениеПараметра("СписокМОЛ",					СписокМОЛДляОтбора);
	Форма.Список.Параметры.УстановитьЗначениеПараметра("ИскатьМОЛВШапке",			ИскатьМОЛВШапке);
	Форма.Список.Параметры.УстановитьЗначениеПараметра("ИскатьМОЛВТаблице",			ИскатьМОЛВТаблице);
	Форма.Список.Параметры.УстановитьЗначениеПараметра("ИспользоватьОтборПоМОЛ",	ИспользоватьОтборПоМОЛ);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокМОЛДляОтбора()
	
	МассивСсылок = ИнвентаризацияСервер.ПолучитьВсеЦМОСотрудникаДляОтбора(ОтборМОЛ);
	
	СписокМОЛДляОтбора.ЗагрузитьЗначения(МассивСсылок);
	
КонецПроцедуры

&НаСервере
Процедура ОтборОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	
	Элементы.Организация.Видимость = Не ЗначениеЗаполнено(ОтборОрганизация);
	
КонецПроцедуры

#КонецОбласти
