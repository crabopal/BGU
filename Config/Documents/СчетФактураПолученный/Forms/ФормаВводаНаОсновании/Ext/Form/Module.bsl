&НаКлиенте
Перем ПараметрыОбработчикаОжидания;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПроверитьПереданныеПараметры(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПереданнаяСтруктура = ПолучитьИзВременногоХранилища(Параметры.АдресХранилища);
	
	СоздатьРеквизитыФормы(ПереданнаяСтруктура);
	
	СоздатьЭлементыФормы(ПереданнаяСтруктура);
	
	ДобавитьОбработчикиСобытийФормы(ПереданнаяСтруктура);
	
	ЗагрузитьПереданныеЗначения(ПереданнаяСтруктура);
	
	НастроитьФорму(ПереданнаяСтруктура);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборКонтрагентПриИзменении(Элемент)
	
	ПрименитьОтборСтрокПоРеквизитамШапкиСФ();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДоговорПриИзменении(Элемент)
	
	ПрименитьОтборСтрокПоРеквизитамШапкиСФ();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПодразделениеПриИзменении(Элемент)
	
	ПрименитьОтборСтрокПоРеквизитамШапкиСФ();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_НаличиеОтмеченныхСтрок

&НаКлиенте
Процедура НаличиеОтмеченныхСтрокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.НаличиеОтмеченныхСтрок.ТекущиеДанные;
	
	ИмяЭлементаСтраницы = ПолучитьИмяРеквизита("Страница", ТекДанные.НомерСтроки);
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы[ИмяЭлементаСтраницы];
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СнятьОтметки(Команда)
	
	ПодтвердитьИСнятьОтметки();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметки(Команда)
	
	ПодтвердитьИУстановитьОтметки();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСчетаФактурыПолученные(Команда)
	
	СоздатьСчетаФактурыПолученныеКлиент();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроверитьПереданныеПараметры(Отказ)
	
	ТекстСообщения = НСтр("ru='Ошибка открытия формы ввода на основании.
		|Передано недопустимое значение параметра формы АдресХранилища.
		|Ожидается адрес хранилища, содержащего значение в формате СчетФактураПолученный.НовыйДанныеДляПередачиНаФормуВводаНаОсновании()'");
	
	Если ЭтоАдресВременногоХранилища(Параметры.АдресХранилища) Тогда
		ПереданнаяСтруктура = ПолучитьИзВременногоХранилища(Параметры.АдресХранилища);
		
		Если Не Документы.СчетФактураПолученный.ЭтоДанныеДляПередачиНаФормуВводаНаОсновании(ПереданнаяСтруктура) Тогда
			Отказ = Истина;
		КонецЕсли;
	Иначе
		Отказ = Истина;
	КонецЕсли;
	
	Если Отказ Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПереданныеЗначения(ПереданнаяСтруктура)
	
	СчетФактураСсылка = ПереданнаяСтруктура.СчетФактураСсылка;
	
	// Отбор из шапки счета-фактуры
	
	Если ПереданнаяСтруктура.ОтборИзШапкиСФ <> Неопределено Тогда
		ИзФормыОбъекта = Истина;
		
		Для Каждого Элемент Из ПереданнаяСтруктура.ОтборИзШапкиСФ.ПоляОтбора Цикл
			ИмяПоля = Элемент.Ключ;
			Значение = Элемент.Значение;
			
			ЭтотОбъект[СтрШаблон("Отбор%1", ИмяПоля)] = Значение;
		КонецЦикла;
	КонецЕсли;
	
	// Таблицы оснований
	
	ОснованийВсего = ПереданнаяСтруктура.ТаблицыОснований.Количество();
	
	Счетчик = 0;
	
	Для Каждого Элемент Из ПереданнаяСтруктура.ТаблицыОснований Цикл
		Счетчик = Счетчик + 1;
		
		ТекДокументОснование = Элемент.Ключ;
		ТекТаблицаОснования = Элемент.Значение;
		
		ЭтотОбъект[ПолучитьИмяРеквизита("Основание", Счетчик)] = ТекДокументОснование;
		
		ИмяТаблицыФормы = ПолучитьИмяТаблицыФормы(Счетчик);
		
		ЭтотОбъект[ИмяТаблицыФормы].Загрузить(ТекТаблицаОснования);
		
		// Несопоставленные счета-фактуры
		ТекТаблицаНесопоставленныхСчетовФактур = ПереданнаяСтруктура.ТаблицыНесопоставленныхСчетовФактур.Получить(ТекДокументОснование);
		
		Если ТекТаблицаНесопоставленныхСчетовФактур <> Неопределено Тогда
			ИмяТаблицыФормы = ПолучитьИмяТаблицыФормы(Счетчик, "НесопоставленныеСчетаФактуры");
			
			ЭтотОбъект[ИмяТаблицыФормы].Загрузить(ТекТаблицаНесопоставленныхСчетовФактур);
			
			ИмяРеквизита = ПолучитьИмяРеквизита("КоличествоНесопоставленныхСчетовФактур", Счетчик);
			
			ЭтотОбъект[ИмяРеквизита] = ТекТаблицаНесопоставленныхСчетовФактур.Количество();
		КонецЕсли;
	КонецЦикла;
	
	ИнициализироватьНаличиеОтмеченныхСтрок();
	
КонецПроцедуры

#Область ГенерацияФормы

&НаСервере
Процедура СоздатьРеквизитыФормы(ПереданнаяСтруктура)
	
	КоличествоОснований = ПереданнаяСтруктура.ТаблицыОснований.Количество();
	
	ДобавляемыеРеквизиты = Новый Массив();
	
	Для Счетчик = 1 По КоличествоОснований Цикл
		// ОСНОВАНИЕ
		
		ДобавитьКопиюРеквизитаФормы(ДобавляемыеРеквизиты, "ОбразецОснование", Счетчик);
		
		// ТАБЛИЦА ФОРМЫ
		
		ДобавитьКопиюТаблицыФормы(ДобавляемыеРеквизиты, "ОбразецТаблицаОснования", Счетчик);
		ДобавитьКопиюТаблицыФормы(ДобавляемыеРеквизиты, "ОбразецНесопоставленныеСчетаФактуры", Счетчик);
		
		// СТАТИСТИКА ТАБЛИЦЫ ФОРМЫ
		
		ДобавитьКопиюРеквизитаФормы(ДобавляемыеРеквизиты, "ОбразецКоличествоСтрокТаблицаОснованияПредставление", Счетчик);
		ДобавитьКопиюРеквизитаФормы(ДобавляемыеРеквизиты, "ОбразецКоличествоСтрокТаблицаОснованияСоответствуетОтбору", Счетчик);
		ДобавитьКопиюРеквизитаФормы(ДобавляемыеРеквизиты, "ОбразецКоличествоНесопоставленныхСчетовФактур", Счетчик);
	КонецЦикла;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыФормы(ПереданнаяСтруктура)
	
	КоличествоОснований = ПереданнаяСтруктура.ТаблицыОснований.Количество();
	
	Для Счетчик = 1 По КоличествоОснований Цикл
		// Страница
		ЭлементСтраницы = ДобавитьКопиюЭлементаСтраницы(Счетчик);
		
		// Основание
		ДобавитьКопиюЭлементаОснования(ЭлементСтраницы, Счетчик);
		
		// Таблица основания
		ЭлементГруппы = ДобавитьКопиюЭлементаГруппы(ЭлементСтраницы, "ОбразецГруппаТаблицаОснования", Счетчик);
		
		ДобавитьКопиюЭлементаТаблицы(ЭлементГруппы, "ОбразецТаблицаОснования", Счетчик);
		
		// Таблица несопоставленных счетов-фактур
		ЭлементГруппы = ДобавитьКопиюЭлементаГруппы(ЭлементСтраницы, "ОбразецГруппаНесопоставленныеСчетаФактуры", Счетчик);
		
		ДобавитьКопиюЭлементаТаблицы(ЭлементГруппы, "ОбразецНесопоставленныеСчетаФактуры", Счетчик);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьКопиюРеквизитаФормы(ДобавляемыеРеквизиты, ИмяРеквизитаОбразца, Счетчик)
	
	РеквизитОбразец = ПолучитьРеквизитФормы(ИмяРеквизитаОбразца);
	
	ОчищенноеИмяРеквизита = ОчиститьИмяРеквизитаОтПрефиксаОбразца(ИмяРеквизитаОбразца);
	
	НовыйРеквизитФормы = Новый РеквизитФормы(
		ПолучитьИмяРеквизита(ОчищенноеИмяРеквизита, Счетчик),
		РеквизитОбразец.ТипЗначения,
		,
		РеквизитОбразец.Заголовок);
		
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКопиюТаблицыФормы(ДобавляемыеРеквизиты, ИмяТаблицыОбразца, Счетчик)
	
	ОчищенноеИмя = ОчиститьИмяРеквизитаОтПрефиксаОбразца(ИмяТаблицыОбразца);
	
	// ТАБЛИЦА ФОРМЫ
	
	ДобавитьКопиюРеквизитаФормы(ДобавляемыеРеквизиты, ИмяТаблицыОбразца, Счетчик);
	
	// КОЛОНКИ ТАБЛИЦЫ
	
	РеквизитыТаблицы = ПолучитьРеквизиты(ИмяТаблицыОбразца);
	
	Для Каждого КолонкаОбразец Из РеквизитыТаблицы Цикл
		НовыйРеквизитФормы = Новый РеквизитФормы(
			КолонкаОбразец.Имя,
			КолонкаОбразец.ТипЗначения,
			ПолучитьИмяТаблицыФормы(Счетчик, ОчищенноеИмя),
			КолонкаОбразец.Заголовок);
			
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьКопиюЭлементаСтраницы(Счетчик)
	
	ИмяЭлемента = ПолучитьИмяРеквизита("Страница", Счетчик);
	
	НовыйЭлементСтраницы = Элементы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), Элементы.ГруппаСтраницы);
	
	НовыйЭлементСтраницы.Заголовок = СтрШаблон(НСтр("ru='Основание N%1'"), Счетчик);
	
	НовыйЭлементСтраницы.ПутьКДаннымЗаголовка = ПолучитьИмяРеквизита("КоличествоСтрокТаблицаОснованияПредставление", Счетчик);
	
	ЗаполнитьЗначенияСвойств(НовыйЭлементСтраницы, Элементы.ОбразецСтраница, "Картинка");
	
	Возврат НовыйЭлементСтраницы;
	
КонецФункции

&НаСервере
Процедура ДобавитьКопиюЭлементаОснования(ЭлементРодитель, Счетчик)
	
	ЭлементОбразец = Элементы.ОбразецОснование;
	
	ИмяЭлемента = ПолучитьИмяРеквизита("Основание", Счетчик);
	
	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ЭлементРодитель);
	
	ЗаполнитьЗначенияСвойств(НовыйЭлемент, ЭлементОбразец, "Вид,Гиперссылка,АвтоМаксимальнаяШирина");
	
	НовыйЭлемент.ПутьКДанным = ИмяЭлемента;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьКопиюЭлементаГруппы(ЭлементРодитель, ИмяЭлементаОбразца, Счетчик)
	
	ЭлементОбразец = Элементы[ИмяЭлементаОбразца];
	
	ИмяЭлемента = ПолучитьИмяРеквизита(ОчиститьИмяРеквизитаОтПрефиксаОбразца(ИмяЭлементаОбразца), Счетчик);
	
	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ЭлементРодитель);
	
	ЗаполнитьЗначенияСвойств(НовыйЭлемент, ЭлементОбразец, "Заголовок,Вид,Отображение,Группировка");
	
	НовыйЭлемент.ПутьКДаннымЗаголовка = ПолучитьИмяРеквизита(
		ОчиститьИмяРеквизитаОтПрефиксаОбразца(ЭлементОбразец.ПутьКДаннымЗаголовка), Счетчик);
		
	Возврат НовыйЭлемент;
	
КонецФункции

&НаСервере
Процедура ДобавитьКопиюЭлементаТаблицы(ЭлементРодитель, ИмяЭлементаОбразца, Счетчик)
	
	ЭлементТаблицыОбразец = Элементы[ИмяЭлементаОбразца];
	
	ОчищенноеИмяЭлемента = ОчиститьИмяРеквизитаОтПрефиксаОбразца(ИмяЭлементаОбразца);
	
	// ТАБЛИЦА ФОРМЫ
	
	ИмяТаблицыФормы = ПолучитьИмяТаблицыФормы(Счетчик, ОчищенноеИмяЭлемента);
	
	НовыйЭлементТаблицыФормы = Элементы.Добавить(ИмяТаблицыФормы, Тип("ТаблицаФормы"), ЭлементРодитель);
	
	ЗаполнитьЗначенияСвойств(НовыйЭлементТаблицыФормы, ЭлементТаблицыОбразец,
		"ИзменятьПорядокСтрок,ИзменятьСоставСтрок,ПоложениеЗаголовка,ПоложениеКоманднойПанели");
	
	НовыйЭлементТаблицыФормы.ПутьКДанным = ИмяТаблицыФормы;
	
	// КОЛОНКИ ТАБЛИЦЫ ФОРМЫ
	
	Для Каждого ЭлементОбразец Из ЭлементТаблицыОбразец.ПодчиненныеЭлементы Цикл
		ИмяКолонки = СтрЗаменить(ЭлементОбразец.ПутьКДанным, ИмяЭлементаОбразца + ".", "");
		
		ИмяЭлемента = ПолучитьИмяЭлементаКолонкиТаблицыФормы(ИмяКолонки, Счетчик, ОчищенноеИмяЭлемента);
		
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), НовыйЭлементТаблицыФормы);
		
		ЗаполнитьЗначенияСвойств(НовыйЭлемент, ЭлементОбразец,
			"Вид,ТолькоПросмотр,Видимость,Доступность,ГиперссылкаЯчейки,ЦветТекста");
		
		НовыйЭлемент.ПутьКДанным = СтрЗаменить(ЭлементОбразец.ПутьКДанным, ИмяЭлементаОбразца, ИмяТаблицыФормы);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОбработчикиСобытийФормы(ПереданнаяСтруктура)
	
	КоличествоОснований = ПереданнаяСтруктура.ТаблицыОснований.Количество();
	
	Для Счетчик = 1 По КоличествоОснований Цикл
		ИмяТаблицыФормы = ПолучитьИмяТаблицыФормы(Счетчик);
		
		// Выбор строки таблицы оснований
		
		Элемент = Элементы[ИмяТаблицыФормы];
		
		ИмяСобытия		= "Выбор";
		ИмяОбработчика	= "Подключаемый_ТаблицаОснованияВыбор";
		Элемент.УстановитьДействие(ИмяСобытия, ИмяОбработчика);
		
		// Флажок "Создавать"
		
		Элемент = Элементы[ПолучитьИмяЭлементаКолонкиТаблицыФормы("Создавать", Счетчик)];
		
		ИмяСобытия		= "ПриИзменении";
		ИмяОбработчика	= "Подключаемый_ТаблицаОснованияСоздаватьПриИзменении";
		Элемент.УстановитьДействие(ИмяСобытия, ИмяОбработчика);
		
		// Выбор строки таблицы несопоставленных счетов-фактур
		
		ИмяТаблицыФормы = ПолучитьИмяТаблицыФормы(Счетчик, "НесопоставленныеСчетаФактуры");
		
		Элемент = Элементы[ИмяТаблицыФормы];
		
		ИмяСобытия		= "Выбор";
		ИмяОбработчика	= "Подключаемый_ТаблицаНесопоставленныхСчетовФактурВыбор";
		Элемент.УстановитьДействие(ИмяСобытия, ИмяОбработчика);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьРеквизитФормы(ИмяРеквизита)
	
	МассивРеквизитов = ПолучитьРеквизиты();
	
	Для Каждого Реквизит Из МассивРеквизитов Цикл
		Если Реквизит.Имя = ИмяРеквизита Тогда
			Возврат Реквизит;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ТаблицаОснованияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ИмяТаблицыФормы = Элемент.Имя;
	
	Номер = Число(СтрЗаменить(ИмяТаблицыФормы, ПолучитьПрефиксИмениСоздаваемыхТаблицФорм(), ""));
	
	ИмяПоля = СтрЗаменить(Поле.Имя, ИмяТаблицыФормы, "");
	
	Если ИмяПоля = "СчетФактура" Тогда
		ДокументСсылка = Элемент.ТекущиеДанные.СчетФактура;
		
		Если ЗначениеЗаполнено(ДокументСсылка) Тогда
			СтандартнаяОбработка = Ложь;
			
			ПоказатьЗначение(Неопределено, ДокументСсылка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТаблицаНесопоставленныхСчетовФактурВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ИмяТаблицыФормы = Элемент.Имя;
	
	Номер = Число(СтрЗаменить(ИмяТаблицыФормы, "НесопоставленныеСчетаФактуры", ""));
	
	ИмяПоля = СтрЗаменить(Поле.Имя, ИмяТаблицыФормы, "");
	
	Если ИмяПоля = "СчетФактура" Или ИмяПоля = "Комментарий" Тогда
		Значение = Элемент.ТекущиеДанные[ИмяПоля];
		
		Если ЗначениеЗаполнено(Значение) Тогда
			СтандартнаяОбработка = Ложь;
			
			ПоказатьЗначение(Неопределено, Значение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТаблицаОснованияСоздаватьПриИзменении(Элемент)
	
	Если Не ИзФормыОбъекта Тогда
		Возврат;
	КонецЕсли;
	
	// При установке флажка подключаем обработчик ожидания для вызова серверной процедуры.
	// Если в интервал ожидания были изменены еще какие-то флажки, то такие изменения отменяем и игнорируем.
	// Обрабатываем изменение только одного первого флажка.
	
	Номер = ПолучитьНомерОснованияИзИмениЭлементаКолонки(Элемент.Имя);
	
	ИмяТаблицыФормы = ПолучитьИмяТаблицыФормы(Номер);
	
	ТекДанные = Элементы[ИмяТаблицыФормы].ТекущиеДанные;
	
	ИдентификаторСтроки = ТекДанные.ПолучитьИдентификатор();
	
	УстановитьКоличествоОтмеченныхВСтрокеТаблицы(ТекДанные);
	
	УстановитьНаличиеОтмеченныхСтрокКлиент(Номер, ИмяТаблицыФормы);
	
	Если ПараметрыОбработчикаОжидания = Неопределено И ТекДанные.Создавать Тогда
		ПараметрыОбработчикаОжидания = Новый Структура();
		ПараметрыОбработчикаОжидания.Вставить("ИмяТаблицыФормы",		ИмяТаблицыФормы);
		ПараметрыОбработчикаОжидания.Вставить("ИдентификаторСтроки",	ИдентификаторСтроки);
		
		ПодключитьОбработчикОжидания("ПриУстановкеФлажкаСоздавать", 0.1, Истина);
		
		Возврат;
	КонецЕсли;
	
	Если ПараметрыОбработчикаОжидания <> Неопределено Тогда
		СобытиеПоТойЖеСтроке = (ИмяТаблицыФормы = ПараметрыОбработчикаОжидания.ИмяТаблицыФормы
			И ИдентификаторСтроки = ПараметрыОбработчикаОжидания.ИдентификаторСтроки);
			
		Если СобытиеПоТойЖеСтроке Тогда
			Если Не ТекДанные.Создавать Тогда
				// В период интервала ожидания сбросили флажок в той же строке, что и недавно установили.
				ОтключитьОбработчикОжидания("ПриУстановкеФлажкаСоздавать");
				
				ПараметрыОбработчикаОжидания = Неопределено;
				
				Возврат;
			КонецЕсли;
		Иначе
			// В период интервала ожидания изменили флажок в какой-то еще иной строке.
			ТекДанные.Создавать = Не ТекДанные.Создавать;
			
			УстановитьКоличествоОтмеченныхВСтрокеТаблицы(ТекДанные);
			
			УстановитьНаличиеОтмеченныхСтрокКлиент(Номер, ИмяТаблицыФормы);
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область НастройкаФормы

&НаСервере
Процедура НастроитьФорму(ПереданнаяСтруктура)
	
	ОснованийВсего = ПереданнаяСтруктура.ТаблицыОснований.Количество();
	
	Если ОснованийВсего = 1 Тогда
		Элементы.ГруппаСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;
	
	Если ОснованийВсего = 1 Или Не ИзФормыОбъекта Тогда
		Элементы.НаличиеОтмеченныхСтрок.Видимость = Ложь;
	КонецЕсли;
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Элементы.ОбразецСтраница.Видимость = Ложь;
	
	Если Не ИспользоватьУчетПоПодразделениям Тогда
		СкрытьКолонкиПодразделений();
	КонецЕсли;
	
	НастроитьПоляОтбораИзШапкиСФ(ПереданнаяСтруктура);
	
	СкрытьНесопоставленныеСчетаФактурыПриОтсутствии();
	
	ИнициализироватьКоличествоСтрокТаблиц();
	
	НастроитьТекстыНадписей();
	
	НастроитьПоясненияНельзяСоздатьСФ();
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура СкрытьКолонкиПодразделений()
	
	ИменаЭлементов = Новый Массив();
	
	Для Счетчик = 1 По ОснованийВсего Цикл
		ИмяЭлемента = ПолучитьИмяЭлементаКолонкиТаблицыФормы("Подразделение", Счетчик, "ТаблицаОснования");
		ИменаЭлементов.Добавить(ИмяЭлемента);
		
		ИмяЭлемента = ПолучитьИмяЭлементаКолонкиТаблицыФормы("Подразделение", Счетчик, "НесопоставленныеСчетаФактуры");
		ИменаЭлементов.Добавить(ИмяЭлемента);
	КонецЦикла;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов, "Видимость", Ложь);
	
КонецПроцедуры

&НаСервере
Процедура СкрытьНесопоставленныеСчетаФактурыПриОтсутствии()
	
	Для Счетчик = 1 По ОснованийВсего Цикл
		ИмяРеквизита = ПолучитьИмяРеквизита("КоличествоНесопоставленныхСчетовФактур", Счетчик);
		
		КоличествоНесопоставленныхСчетовФактур = ЭтотОбъект[ИмяРеквизита];
		
		Если КоличествоНесопоставленныхСчетовФактур = 0 Тогда
			Элементы[ПолучитьИмяРеквизита("НесопоставленныеСчетаФактуры", Счетчик)].Видимость = Ложь;
			
			Элементы[ПолучитьИмяРеквизита("Страница", Счетчик)].Картинка = Новый Картинка();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьТекстыНадписей()
	
	Если ИзФормыОбъекта Тогда
		// Заменяем тексты "создать" на "выбрать".
		
		Элементы.ФормаСоздатьСчетаФактурыПолученные.Заголовок = НСтр("ru='Выбрать'");
		
		Для Счетчик = 1 По ОснованийВсего Цикл
			ИмяЭлемента = ПолучитьИмяЭлементаКолонкиТаблицыФормы("Создавать", Счетчик);
			
			Элементы[ИмяЭлемента].Заголовок = НСтр("ru='Выбрать'");
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПоясненияНельзяСоздатьСФ()
	
	НовВидимость = Ложь;
	
	Если Не ИзФормыОбъекта Тогда
		НовВидимость = СФСозданыПоВсемНаборамДанныхОснования();
	КонецЕсли;
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("ДекорацияКартинка");
	ИменаЭлементов.Добавить("ДекорацияНадпись");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов, "Видимость", НовВидимость);
	
КонецПроцедуры

&НаСервере
Функция СФСозданыПоВсемНаборамДанныхОснования()
	
	// Возможное наличие несопоставленных сч.-ф. не учитываем.
	
	Счетчик = 1;
	
	ТаблицаОснования = ЭтотОбъект[ПолучитьИмяТаблицыФормы(Счетчик)];
	
	Для Каждого СтрокаТаблицы Из ТаблицаОснования Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СчетФактура) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ДобавитьУсловноеОформление_ОтсутствиеДопустимыхКОтметкеСтрок();
	
	ДобавитьУсловноеОформление_ЭтотСФ("ТаблицаОснования");
	
	ДобавитьУсловноеОформление_ЭтотСФ("НесопоставленныеСчетаФактуры");
	
	Если ИзФормыОбъекта Тогда
		ДобавитьУсловноеОформление_ПустыеПоляШапкиСФ();
	Иначе
		ДобавитьУсловноеОформление_ЗаблокированФлажокОтметкиПриНаличииСФ();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_ОтсутствиеДопустимыхКОтметкеСтрок()
	
	Для Счетчик = 1 По ОснованийВсего Цикл
		ИмяРеквизитаКоличествоСтрокСоответствуетОтбору = ПолучитьИмяРеквизита("КоличествоСтрокТаблицаОснованияСоответствуетОтбору", Счетчик);
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Отсутствуют допустимые к отметке из-за отбора строки для основания №%1'"), Счетчик);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизитаКоличествоСтрокСоответствуетОтбору);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НаличиеОтмеченныхСтрок.НомерСтроки");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Счетчик;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НаличиеОтмеченныхСтрок.ЕстьОтмеченные");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Ложь;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ИтогиФонГруппы);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("НаличиеОтмеченныхСтрокЕстьОтмеченные");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_ПустыеПоляШапкиСФ()
	
	ИменаПолей = ПолучитьИменаПолейРеквизитовШапкиСФ();
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Пустое поле %1 отбора из шапки сч.-ф.'"), ИмяПоля);
		
		ИмяРеквизита = СтрШаблон("Отбор%1", ИмяПоля);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизита);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ФонУправляющегоПоля);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяРеквизита);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_ЭтотСФ(ОчищенноеИмяТаблицы)
	
	ИменаПолей = ПолучитьИменаПолейРеквизитовШапкиСФ();
	
	Для Счетчик = 1 По ОснованийВсего Цикл
		ИмяТаблицыФормы = ПолучитьИмяТаблицыФормы(Счетчик, ОчищенноеИмяТаблицы);
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Ссылка счета-фактуры совпадает с переданной (%1)'"), ИмяТаблицыФормы);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицыФормы + ".СчетФактура");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
		
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицыФормы + ".СчетФактура");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Новый ПолеКомпоновкиДанных("СчетФактураСсылка");
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='<этот счет-фактура>'"));
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицыФормы + "СчетФактура");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_ЗаблокированФлажокОтметкиПриНаличииСФ()
	
	Счетчик = 1;
	
	ИмяТаблицыОснования = ПолучитьИмяТаблицыФормы(Счетчик);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Флажок отметки недоступен из-за наличия счета-фактуры'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрШаблон("%1.СчетФактура", ИмяТаблицыОснования));
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ПолучитьИмяЭлементаКолонкиТаблицыФормы("Создавать", Счетчик));
	
КонецПроцедуры

#КонецОбласти

#Область НастройкиРасчета

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПрефиксИмениРеквизитовОбразцов()
	
	Возврат "Образец";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПрефиксИмениСоздаваемыхТаблицФорм()
	
	Возврат "ТаблицаОснования";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИмяРеквизита(Префикс, Номер)
	
	Возврат СтрШаблон("%1%2", Префикс, Формат(Номер, "ЧГ="));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОчиститьИмяРеквизитаОтПрефиксаОбразца(ИмяРеквизитаОбразца)
	
	Возврат СтрЗаменить(ИмяРеквизитаОбразца, ПолучитьПрефиксИмениРеквизитовОбразцов(), "");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИмяТаблицыФормы(Номер, ПрефиксИмени = Неопределено)
	
	Если ПрефиксИмени = Неопределено Тогда
		ПрефиксИмени = ПолучитьПрефиксИмениСоздаваемыхТаблицФорм();
	КонецЕсли;
	
	Возврат ПолучитьИмяРеквизита(ПрефиксИмени, Номер);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИмяЭлементаКолонкиТаблицыФормы(ИмяКолонки, Номер, ПрефиксИмени = Неопределено)
	
	Возврат СтрШаблон("%1%2", ПолучитьИмяТаблицыФормы(Номер, ПрефиксИмени), ИмяКолонки);
	
КонецФункции

&НаКлиенте
Функция ПолучитьНомерОснованияИзИмениЭлементаКолонки(ИмяЭлементаКолонки)
	
	Префикс = ПолучитьПрефиксИмениСоздаваемыхТаблицФорм();
	
	Представление = "";
	
	Для Счетчик = СтрДлина(Префикс) + 1 По СтрДлина(ИмяЭлементаКолонки) Цикл
		Символ = Сред(ИмяЭлементаКолонки, Счетчик, 1);
		
		Если Не ОбщегоНазначенияКлиентСервер.ЭтоЧисло(Представление + Символ) Тогда
			Возврат Число(Представление);
		КонецЕсли;
		
		Представление = Представление + Символ;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область ОтборИзШапкиСФ

&НаСервере
Функция ПолучитьИменаПолейРеквизитовШапкиСФ()
	
	Возврат СтрРазделить("Контрагент,Договор,Подразделение", ", ", Ложь);
	
КонецФункции

&НаКлиенте
Процедура ПрименитьОтборСтрокПоРеквизитамШапкиСФ()
	
	ПрименитьОтборСтрокПоРеквизитамШапкиСФСервер();
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборСтрокПоРеквизитамШапкиСФСервер()
	
	// Сбрасываем флажки у строк, не соответствующих отбору.
	
	НовыйОтбор = ПолучитьПрименяемыйОтбор();
	
	Для Счетчик = 1 По ОснованийВсего Цикл
		ИмяТаблицыФормы = ПолучитьИмяТаблицыФормы(Счетчик);
		
		ЭлементТаблицыФормы = Элементы[ИмяТаблицыФормы];
		ЭлементТаблицыФормы.ОтборСтрок = Новый ФиксированнаяСтруктура(НовыйОтбор);
		
		ТаблицаФормы = ЭтотОбъект[ИмяТаблицыФормы];
		
		КоличествоСтрокСоответствуетОтбору = 0;
		
		КоличествоСтрокВсего = ТаблицаФормы.Количество();
		
		Для Каждого СтрокаТаблицы Из ТаблицаФормы Цикл
			Если СтрокаТаблицыСоответствуетОтбору(СтрокаТаблицы, НовыйОтбор) Тогда
				КоличествоСтрокСоответствуетОтбору = КоличествоСтрокСоответствуетОтбору + 1;
			Иначе
				СтрокаТаблицы.Создавать = Ложь;
				
				УстановитьКоличествоОтмеченныхВСтрокеТаблицы(СтрокаТаблицы);
			КонецЕсли;
		КонецЦикла;
		
		УстановитьНаличиеОтмеченныхСтрокСервер(Счетчик, ТаблицаФормы);
		
		ИмяРеквизита = ПолучитьИмяРеквизита("КоличествоСтрокТаблицаОснованияСоответствуетОтбору", Счетчик);
		
		ЭтотОбъект[ИмяРеквизита] = КоличествоСтрокСоответствуетОтбору;
		
		ИмяРеквизита = ПолучитьИмяРеквизита("КоличествоСтрокТаблицаОснованияПредставление", Счетчик);
		
		ЭтотОбъект[ИмяРеквизита] = ?(КоличествоСтрокВсего = КоличествоСтрокСоответствуетОтбору,
			КоличествоСтрокВсего,
			СтрШаблон(НСтр("ru='%1 из %2'"), КоличествоСтрокСоответствуетОтбору, ТаблицаФормы.Количество()));
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКоличествоСтрокТаблиц()
	
	Для Счетчик = 1 По ОснованийВсего Цикл
		ИмяТаблицыФормы = ПолучитьИмяТаблицыФормы(Счетчик);
		
		ТаблицаФормы = ЭтотОбъект[ИмяТаблицыФормы];
		
		КоличествоСтрок = ТаблицаФормы.Количество();
		
		ИмяРеквизита = ПолучитьИмяРеквизита("КоличествоСтрокТаблицаОснованияПредставление", Счетчик);
		
		ЭтотОбъект[ИмяРеквизита] = КоличествоСтрок;
		
		ИмяРеквизита = ПолучитьИмяРеквизита("КоличествоСтрокТаблицаОснованияСоответствуетОтбору", Счетчик);
		
		ЭтотОбъект[ИмяРеквизита] = КоличествоСтрок;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьНаличиеОтмеченныхСтрок()
	
	Для Счетчик = 1 По ОснованийВсего Цикл
		НоваяСтрока = НаличиеОтмеченныхСтрок.Добавить();
		
		НоваяСтрока.НомерСтроки = Счетчик;
		
		ИмяРеквизита = ПолучитьИмяРеквизита("Основание", Счетчик);
		
		НоваяСтрока.ДокументОснование = ЭтотОбъект[ИмяРеквизита];
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПрименяемыйОтбор()
	
	ПрименяемыйОтбор = Новый Структура();
	
	ИменаПолей = ПолучитьИменаПолейРеквизитовШапкиСФ();
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ЗначениеОтбора = ЭтотОбъект[СтрШаблон("Отбор%1", ИмяПоля)];
		
		Если ЗначениеЗаполнено(ЗначениеОтбора) Тогда
			ПрименяемыйОтбор.Вставить(ИмяПоля, ЗначениеОтбора);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПрименяемыйОтбор;
	
КонецФункции

&НаСервере
Функция СтрокаТаблицыСоответствуетОтбору(СтрокаТаблицы, НовыйОтбор)
	
	Для Каждого Элемент Из НовыйОтбор Цикл
		ИмяПоля = Элемент.Ключ;
		Значение = Элемент.Значение;
		
		Если СтрокаТаблицы[ИмяПоля] <> Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура НастроитьПоляОтбораИзШапкиСФ(ПереданнаяСтруктура)
	
	ИменаЭлементовОтбора = Новый Массив();
	ИменаЭлементовОтбора.Добавить("ОтборКонтрагент");
	ИменаЭлементовОтбора.Добавить("ОтборПодразделение");
	ИменаЭлементовОтбора.Добавить("ОтборДоговор");
	
	Если Не ИзФормыОбъекта Тогда
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовОтбора, "Видимость", Ложь);
		
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовОтбора, "ТолькоПросмотр", Истина);
	
	Для Каждого Элемент Из ПереданнаяСтруктура.ОтборИзШапкиСФ.ПоляОтбора Цикл
		ИмяПоля = Элемент.Ключ;
		Значение = Элемент.Значение;
		
		Если ЗначениеЗаполнено(Значение) Тогда
			ИмяЭлемента = СтрШаблон("Отбор%1", ИмяПоля);
			
			ЭлементФормы = Элементы[ИмяЭлемента];
			
			ЭлементФормы.СписокВыбора.Очистить();
			ЭлементФормы.СписокВыбора.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элемент Из ПереданнаяСтруктура.СпискиЗначенийОтбораИзШапкиСФ Цикл
		ИмяПоля = Элемент.Ключ;
		СписокЗначений = Элемент.Значение;
		
		ИмяЭлемента = СтрШаблон("Отбор%1", ИмяПоля);
		
		ЭлементФормы = Элементы[ИмяЭлемента];
		
		ЭлементФормы.СписокВыбора.ЗагрузитьЗначения(СписокЗначений);
		
		Если СписокЗначений.Количество() = 1 И Не ЗначениеЗаполнено(ЭтотОбъект[ИмяЭлемента]) Тогда
			ЭтотОбъект[ИмяЭлемента] = СписокЗначений[0];
			
		ИначеЕсли СписокЗначений.Количество() > 1 Тогда
			ЭлементФормы.ТолькоПросмотр = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НеобходимоУстановитьОтборСтрокПоТекущейСтроке(ТекДанные)
	
	ИменаПолей = ПолучитьИменаПолейРеквизитовШапкиСФ();
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ЗначениеОтбора = ЭтотОбъект[СтрШаблон("Отбор%1", ИмяПоля)];
		
		Если ЗначениеЗаполнено(ТекДанные[ИмяПоля]) И Не ЗначениеЗаполнено(ЗначениеОтбора) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура УстановитьРеквизитыШапкиСФПоТекущейСтроке(ТекДанные)
	
	ИменаПолей = ПолучитьИменаПолейРеквизитовШапкиСФ();
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ИмяПоляОтбор = СтрШаблон("Отбор%1", ИмяПоля);
		
		ЗначениеОтбора = ЭтотОбъект[ИмяПоляОтбор];
		
		ЗнеачениеВТекущейСтроке = ТекДанные[ИмяПоля];
		
		Если ЗначениеЗаполнено(ЗначениеОтбора) Или Не ЗначениеЗаполнено(ЗнеачениеВТекущейСтроке) Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтотОбъект[ИмяПоляОтбор] = ЗнеачениеВТекущейСтроке;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОтметкаСтрок

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьКоличествоОтмеченныхВСтрокеТаблицы(СтрокаТаблицы)
	
	СтрокаТаблицы.КоличествоОтмеченных = ?(СтрокаТаблицы.Создавать, 1, 0);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьНаличиеОтмеченныхВСтрокеТаблицы(СтрокаТаблицы, КоличествоОтмеченных)
	
	СтрокаТаблицы.ЕстьОтмеченные = (КоличествоОтмеченных > 0);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНаличиеОтмеченныхСтрокКлиент(Номер, ИмяТаблицыФормы)
	
	ТаблицаФормы = ЭтотОбъект[ИмяТаблицыФормы];
	
	КоличествоОтмеченных = ТаблицаФормы.Итог("КоличествоОтмеченных");
	
	СтрокаТаблицы = НаличиеОтмеченныхСтрок.Получить(Номер - 1);
	
	УстановитьНаличиеОтмеченныхВСтрокеТаблицы(СтрокаТаблицы, КоличествоОтмеченных);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНаличиеОтмеченныхСтрокСервер(Номер, ТаблицаФормы)
	
	КоличествоОтмеченных = ТаблицаФормы.Итог("КоличествоОтмеченных");
	
	СтрокаТаблицы = НаличиеОтмеченныхСтрок.Получить(Номер - 1);
	
	УстановитьНаличиеОтмеченныхВСтрокеТаблицы(СтрокаТаблицы, КоличествоОтмеченных);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриУстановкеФлажкаСоздавать()
	
	ПриУстановкеФлажкаСоздаватьСервер(ПараметрыОбработчикаОжидания);
	
	ПараметрыОбработчикаОжидания = Неопределено;
	
КонецПроцедуры

&НаСервере
Процедура ПриУстановкеФлажкаСоздаватьСервер(ПараметрыОбработчикаОжидания)
	
	ИмяТаблицыФормы		= ПараметрыОбработчикаОжидания.ИмяТаблицыФормы;
	ИдентификаторСтроки	= ПараметрыОбработчикаОжидания.ИдентификаторСтроки;
	
	ТаблицаФормы = ЭтотОбъект[ИмяТаблицыФормы];
	
	ТекДанные = ТаблицаФормы.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	СброситьФлажкиВОстальныхСтроках(ТаблицаФормы, ТекДанные);
	
	Если НеобходимоУстановитьОтборСтрокПоТекущейСтроке(ТекДанные) Тогда
		УстановитьРеквизитыШапкиСФПоТекущейСтроке(ТекДанные);
		
		ПрименитьОтборСтрокПоРеквизитамШапкиСФСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СброситьФлажкиВОстальныхСтроках(ТаблицаФормы, ТекДанные)
	
	Для Каждого СтрокаТаблицы Из ТаблицаФормы Цикл
		Если СтрокаТаблицы = ТекДанные Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.Создавать = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИСнятьОтметки()
	
	Оповещение = Новый ОписаниеОповещения("ПодтвержденоСнятиеОтметок", ЭтотОбъект);
	
	ПоказатьВопрос(Оповещение, НСтр("ru='Снять все установленные отметки?'"), РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвержденоСнятиеОтметок(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		УстановитьЗначениеОтметок(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИУстановитьОтметки()
	
	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(ОтборКонтрагент) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", "Контрагент"),, "ОтборКонтрагент",, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОтборДоговор) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", "Договор"),, "ОтборДоговор",, Отказ);
	КонецЕсли;
	
	Если ИспользоватьУчетПоПодразделениям И Не ЗначениеЗаполнено(ОтборПодразделение) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", "Подразделение"),, "ОтборПодразделение",, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПодтвержденаУстановкаОтметок", ЭтотОбъект);
	
	ПоказатьВопрос(Оповещение, НСтр("ru='Установить все отметки?'"), РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвержденаУстановкаОтметок(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		УстановитьЗначениеОтметок(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеОтметок(НовоеЗначение)
	
	ПрименяемыйОтбор = ПолучитьПрименяемыйОтбор();
	
	Для Счетчик = 1 По ОснованийВсего Цикл
		ИмяТаблицыФормы = ПолучитьИмяТаблицыФормы(Счетчик);
		
		ТаблицаФормы = ЭтотОбъект[ИмяТаблицыФормы];
		
		УстановитьЗначениеОтметокВТаблице(Счетчик, ТаблицаФормы, ПрименяемыйОтбор, НовоеЗначение);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеОтметокВТаблице(Счетчик, ТаблицаФормы, ПрименяемыйОтбор, НовоеЗначение)
	
	Для Каждого СтрокаТаблицы Из ТаблицаФормы Цикл
		Если НовоеЗначение = Истина И Не СтрокаТаблицыСоответствуетОтбору(СтрокаТаблицы, ПрименяемыйОтбор) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.Создавать = НовоеЗначение;
		
		УстановитьКоличествоОтмеченныхВСтрокеТаблицы(СтрокаТаблицы);
		
		УстановитьНаличиеОтмеченныхСтрокСервер(Счетчик, ТаблицаФормы);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПередачаРезультатаРаботы

&НаКлиенте
Процедура СоздатьСчетаФактурыПолученныеКлиент()
	
	Если ИзФормыОбъекта Тогда
		ПроверитьИЗакрытьДляВызоваИзФормыОбъекта();
	Иначе
		ПроверитьИЗакрытьДляВызоваИзВводаНаОсновании();
	КонецЕсли;
	
КонецПроцедуры

#Область ДляВызоваИзФормыОбъекта

&НаКлиенте
Процедура ПроверитьИЗакрытьДляВызоваИзФормыОбъекта()
	
	РезультатПроверки = ПроверитьНаличиеОтметок();
	
	Если Не РезультатПроверки.ЕстьОтмеченные Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не отмечено ни одной строки.'"));
		
		Возврат;
	КонецЕсли;
	
	Если РезультатПроверки.ЕстьНеотмеченные Тогда
		ТекстВопроса = НСтр("ru='По некоторым основаниям не отмечены строки.
			|
			|Продолжить и заполнить без учета таких оснований?'");
		
		Оповещение = Новый ОписаниеОповещения("ПодтвержденоНаличиеНеотмеченныхОснований", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
	КонецЕсли;
	
	ЗакрытьФормуДляВызоваИзФормыОбъекта();
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьНаличиеОтметок()
	
	// Если для основания доступно 0 строк из-за установленного отбора, то отсутствует возможность отметить строку.
	
	РезультатПроверки = Новый Структура();
	РезультатПроверки.Вставить("ЕстьОтмеченные",			Ложь);
	РезультатПроверки.Вставить("ЕстьНеотмеченные",			Ложь);
	РезультатПроверки.Вставить("ЕстьНедоступныеКОтметке",	Ложь);
	
	КоличествоНеотмеченных = 0;
	
	Для Счетчик = 1 По ОснованийВсего Цикл
		СтрокаТаблицы = НаличиеОтмеченныхСтрок.Получить(Счетчик - 1);
		
		Если СтрокаТаблицы.ЕстьОтмеченные Тогда
			РезультатПроверки.ЕстьОтмеченные = Истина;
		Иначе
			КоличествоСтрокСоответствуетОтбору = ЭтотОбъект[ПолучитьИмяРеквизита("КоличествоСтрокТаблицаОснованияСоответствуетОтбору", Счетчик)];
			
			Если КоличествоСтрокСоответствуетОтбору > 0 Тогда
				РезультатПроверки.ЕстьНеотмеченные = Истина;
			Иначе
				РезультатПроверки.ЕстьНедоступныеКОтметке = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаКлиенте
Процедура ПодтвержденоНаличиеНеотмеченныхОснований(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗакрытьФормуДляВызоваИзФормыОбъекта();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуДляВызоваИзФормыОбъекта()
	
	АдресХранилища = ПоместитьВХранилищеВозвращаемоеЗначение();
	
	Закрыть(АдресХранилища);
	
КонецПроцедуры

#КонецОбласти

#Область ДляВызоваИзВводаНаОсновании

&НаКлиенте
Процедура ПроверитьИЗакрытьДляВызоваИзВводаНаОсновании()
	
	Если Не ЕстьОтмеченныеОснования() Тогда
		ТекстСообщения = НСтр("ru='Не отмечено ни одной строки.
			|Отметьте одну или несколько строк.'");
		
		ПоказатьПредупреждение(, ТекстСообщения);
		
		Возврат;
	КонецЕсли;
	
	ЗакрытьФормуДляВызоваИзВводаНаОсновании();
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьОтмеченныеОснования()
	
	// Табличная часть НаличиеОтмеченныхСтрок используется только в режиме ИзФормыОбъекта.
	
	Для Счетчик = 1 По ОснованийВсего Цикл
		ТаблицаФормы = ЭтотОбъект[ПолучитьИмяТаблицыФормы(Счетчик)];
		
		Для Каждого СтрокаТаблицы Из ТаблицаФормы Цикл
			Если СтрокаТаблицы.Создавать Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытьФормуДляВызоваИзВводаНаОсновании()
	
	Перем ОтмеченныеСтроки, ОбразецСтруктураОснования;
	
	ПолучитьДанныеДляОткрытияФормДокументов(ОтмеченныеСтроки, ОбразецСтруктураОснования);
	
	Для Каждого Элемент Из ОтмеченныеСтроки Цикл
		ДокументОснование = Элемент.Ключ;
		ТаблицаОснования = Элемент.Значение;
		
		Для Каждого СтрокаАванса Из ТаблицаОснования Цикл
			СчетФактураСсылка = СтрокаАванса.СчетФактура;
			
			ПараметрыФормы = Новый Структура();
			
			Если ЗначениеЗаполнено(СчетФактураСсылка) тогда
				ПараметрыФормы.Вставить("Ключ", СчетФактураСсылка);
			Иначе
				СтруктураОснования = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ОбразецСтруктураОснования);
				
				СтруктураОснования.ДокументОснование = ДокументОснование;
				ЗаполнитьЗначенияСвойств(СтруктураОснования.ОтборИзШапкиСФ.ПоляОтбора, СтрокаАванса);
				
				ПараметрыФормы.Вставить("Основание", СтруктураОснования);
			КонецЕсли;
			
			ОткрытьФорму("Документ.СчетФактураПолученный.ФормаОбъекта", ПараметрыФормы, , Новый УникальныйИдентификатор);
		КонецЦикла;
	КонецЦикла;
	
	Закрыть();
	
КонецПроцедуры

&НаСервере
Функция ПоместитьВХранилищеВозвращаемоеЗначение()
	
	ВозвращаемоеЗначение = Документы.СчетФактураПолученный.НовыйВозвращаемоеЗначениеИзФормыВводаНаОсновании();
	
	ОтборИзШапкиСФ = Документы.СчетФактураПолученный.НовыйОтборИзШапкиСФ();
	ОтборИзШапкиСФ.Ссылка = СчетФактураСсылка;
	ОтборИзШапкиСФ.ПоляОтбора.Договор		= ОтборДоговор;
	ОтборИзШапкиСФ.ПоляОтбора.Контрагент	= ОтборКонтрагент;
	ОтборИзШапкиСФ.ПоляОтбора.Подразделение	= ОтборПодразделение;
	
	ВозвращаемоеЗначение.ОтборИзШапкиСФ = ОтборИзШапкиСФ;
	
	ВозвращаемоеЗначение.ОтмеченныеСтроки = ПолучитьОтмеченныеСтроки();
	
	АдресХранилища = ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение);
	
	Возврат АдресХранилища;
	
КонецФункции

&НаСервере
Функция ПолучитьОтмеченныеСтроки()
	
	ОтмеченныеСтроки = Новый Соответствие();
	
	Для Счетчик = 1 По ОснованийВсего Цикл
		ДокументОснование = ЭтотОбъект[ПолучитьИмяРеквизита("Основание", Счетчик)];
		
		ТаблицаФормы = ЭтотОбъект[ПолучитьИмяТаблицыФормы(Счетчик)];
		
		Поиск = Новый Структура("Создавать", Истина);
		
		Таблица = ТаблицаФормы.Выгрузить(Поиск, "Контрагент,Договор,Подразделение,Сумма,СчетФактура");
		
		Если Таблица.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОтмеченныеСтроки.Вставить(ДокументОснование, ОбщегоНазначения.ТаблицаЗначенийВМассив(Таблица));
	КонецЦикла;
	
	Возврат ОтмеченныеСтроки;
	
КонецФункции

&НаСервере
Процедура ПолучитьДанныеДляОткрытияФормДокументов(ОтмеченныеСтроки, ОбразецСтруктураОснования)
	
	ОтмеченныеСтроки = ПолучитьОтмеченныеСтроки();
	
	ОбразецСтруктураОснования = Документы.СчетФактураПолученный.НовыйСтруктураОснованияИзФормыВводаНаОсновании();
	
КонецПроцедуры

#КонецОбласти

