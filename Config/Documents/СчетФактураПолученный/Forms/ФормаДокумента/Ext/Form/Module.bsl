&НаСервере
Процедура ИнициализироватьФормуСервер()
	
	ИнициализироватьНастройкиЭлементовКолонок();
	
	МестоРегистрации = 0;
	Если Объект["РегистрацияВДопЛисте"] Тогда
		МестоРегистрации = 1;
	ИначеЕсли Объект["РегистрацияВПредыдущемПериоде"] Тогда
		МестоРегистрации = 2;
	КонецЕсли;	
	
	ЕдИзмШт		= Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	ВидДоговора	= Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
	
	ОграниченияСписокСчетов.ЗагрузитьЗначения(БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("205.2А,205.3А,205.7А,205.8А,206.10,206.20,206.30,206.91,209.00,305.06", Истина));
	
	УчетНДСКлиентСервер.ЗаполнитьСписокКодовВидовОпераций(
		Элементы["КодВидаОперации"].СписокВыбора,
		"ПолученныеСчетаФактуры",
		Объект["Дата"]);
		
	АвтоустановкаКПС = Истина;
	Элементы["ФормаАвтоустановкаКПС"].Пометка = АвтоустановкаКПС;
	
	ИнициализироватьНастройкиОграниченийВыбораДокументовОснований();
	
	//---
	// Совместимость с БГУ1
	//---
	УчетНДС.ЗаполнитьСписокВыбораЭлементаПричинаНалогообложения(
		Элементы["ПричинаНалогообложения"],
		Ложь, // ЭтоСчетФактураВыданный
		Объект["ПричинаНалогообложения"],// ТекущееЗначение
		СовместимостьБГУ1_НекорректнаяПричинаНалогообложения// ВозвратНекорректноеЗначение
	);
	
	НастроитьФормуСервер_ПоПрименяемойИнструкции(Ложь);
	
	//---
	// Документы остатков НДС
	//---
	ДокументыОстатковНДС_НастроитьФормуСервер();
	
	НастроитьВидимостьДокументаОплатыНалога();
	
	УстановитьУсловноеОформление();
	
	// Прослеживаемость
	НастроитьФормуПрослеживаемостьСервер();
	// Конец Прослеживаемость
	
	ДиагностироватьЦепочкуДокументовСчетовФактур();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ДобавитьУсловноеОформление_СовместимостьСБГУ1();
	
    ДобавитьУсловноеОформление_НедоступныПоляПриОтсутствииВычета();
	
	УчетНДС.ДобавитьУсловноеОформлениеОтметкиНезаполненнойКолонкиПриНаличииСуммыНалога(ЭтаФорма, "СчетВычетКт", Истина);
	
	УчетНДС.ДобавитьУсловноеОформлениеОтметкиНезаполненнойКолонкиПриНаличииСуммыНалога(ЭтаФорма, "КПСВычетКт", Истина);
	
	УчетНДС.ДобавитьУсловноеОформлениеОтметкиНезаполненнойКолонкиПриНаличииСуммыНалога(ЭтаФорма, "КФО", Истина);
	
	УчетНДС.ДобавитьУсловноеОформлениеОтметкиНезаполненнойКолонкиПриНаличииСуммыНалога(ЭтаФорма, "Счет30304", Истина);
	
	ДобавитьУсловноеОформление_КомиссионнаяЗакупка(УсловноеОформление);
	
КонецПроцедуры

