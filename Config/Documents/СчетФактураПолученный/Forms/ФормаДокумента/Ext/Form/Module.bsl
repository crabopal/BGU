	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставНФАКПСВычетКт");

	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставНФАСчет30304");
	
	//---
	// 2. Активный флажок "КомиссионнаяТорговля" - недоступные поля группы недоступные пнедоступные поля СоставНФАНДСКВычету, СоставНФАНДСКРаспределению
	//---
