&НаКлиенте
Процедура РассчитатьСуммыВСтроке(Элемент)
	
	Перем ИмяИзмененногоПоля;
	
	ТекДанные = Элементы["СоставНФА"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяЭлемента = Элемент.Имя;
	
	// Колонки, относящиеся к НДС:
	Если ИмяЭлемента = "СоставНФАСумма" Тогда
		ИмяИзмененногоПоля = "Сумма";
		
	ИначеЕсли ИмяЭлемента = "СоставНФАСуммаНДС" Тогда
		ИмяИзмененногоПоля = "СуммаНДС";
		
	ИначеЕсли	ИмяЭлемента = "СоставНФАВсего"
		ИЛИ		ИмяЭлемента = "СоставНФАВсегоАванс"	Тогда
		ИмяИзмененногоПоля = "Всего";
		
	ИначеЕсли ИмяЭлемента = "СоставНФАСтавкаНДС" Тогда
		ИмяИзмененногоПоля = "СтавкаНДС";
		
	КонецЕсли;
	
	СтруктураИменПолей = Новый Структура();
	СтруктураИменПолей.Вставить("Сумма",			"Сумма");
	СтруктураИменПолей.Вставить("СуммаНДС",			"СуммаНДС");
	СтруктураИменПолей.Вставить("Всего",			"Всего");
	СтруктураИменПолей.Вставить("СтавкаНДС",		"СтавкаНДС");
	УчетНДСКлиентСервер.РассчитатьСуммы(ТекДанные, ИмяИзмененногоПоля, СтруктураИменПолей, ЭтоАванс);
	
КонецПроцедуры	

&НаКлиенте
Функция УдалитьЗависимыеСтроки(Основание)
	ПараметрыОтбора = Новый Структура("ДокументОснование", Основание); 	
	МассивКУдалению = Объект.СоставНФА.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
		Объект.СоставНФА.Удалить(СтрокаКУдалению);
	КонецЦикла;	
КонецФункции	

// ПрименяемаяИнструкция=f(ПричинаНалогообложения,КФО,Дата)
&НаСервере
Процедура НастроитьФормуСервер_ПоПрименяемойИнструкции(ЗаполнитьКолонкиСчетовЗначениямиПоУмолчанию, ИдентификаторИнструкции = Неопределено)
	
	Перем	УстановитьСчетВычетКт;
	
	// Текущее (или до изменения) значение применяемой инструкции
	Если ЗаполнитьКолонкиСчетовЗначениямиПоУмолчанию = Истина Тогда
		Попытка
			СохраненнаяИнструкцияСтруктура	= ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ПрименяемаяИнструкция_СтруктураСвойств);
			ПрежнийСчетВычетКт				= СохраненнаяИнструкцияСтруктура["СчетВычетКт"];
			ПрежнийСчетВычетКтЗадан			= Истина;
		Исключение
			СохраненнаяИнструкцияСтруктура	= Неопределено;
			ПрежнийСчетВычетКт				= Неопределено;
			ПрежнийСчетВычетКтЗадан			= Ложь;
		КонецПопытки;
	КонецЕсли;
	
	// Новое значение применяемой инструкции (без значения КФО)
	ОбъектСтруктура = Новый Структура("Организация,ПричинаНалогообложения,КФО,Дата,ИФО");
	ЗаполнитьЗначенияСвойств(ОбъектСтруктура, Объект);
	Если ИдентификаторИнструкции = Неопределено Тогда
		// Определяем применяемую инструкцию из данных документа
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ОбъектСтруктура);
	Иначе
		// Применяемая инструкция указана явно
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ОбъектСтруктура, , ИдентификаторИнструкции);
	КонецЕсли;
	ЭтаФорма["ПрименяемаяИнструкция_СтруктураСвойств"] = Новый ФиксированнаяСтруктура(ПрименяемаяИнструкцияСтруктура);
	
	ПрименяемаяИнструкция_ЗаполнитьСлужебныеКолонки(ИдентификаторИнструкции);
	
	Начисление					= ПрименяемаяИнструкцияСтруктура["Начисление"];
	НачислениеВБудущем			= ПрименяемаяИнструкцияСтруктура["НачислениеВБудущем"];
	Вычет						= ПрименяемаяИнструкцияСтруктура["Вычет"];
	ВычетВБудущем				= ПрименяемаяИнструкцияСтруктура["ВычетВБудущем"];
	РаспределениеВозможно		= ПрименяемаяИнструкцияСтруктура["РаспределениеВозможно"];
	НалоговыйАгент				= ПрименяемаяИнструкцияСтруктура["НалоговыйАгент"];
	КомиссионнаяЗакупкаКомиссионер			= ПрименяемаяИнструкцияСтруктура["КомиссионнаяЗакупкаКомиссионер"];
	
	// Настраиваем элементы формы
	Элементы["СоставНФАНДСКВычету"].Видимость				= Вычет;
	Элементы["СоставНФАНДСКРаспределению"].Видимость		= Вычет И РаспределениеВозможно;
	Элементы["СоставНФАСчетВычетКт"].Видимость				= Вычет;
	Элементы["СоставНФАКПСВычетКт"].Видимость				= Вычет;
	Элементы["СоставНФАКФО"].Видимость						= Вычет;
	Элементы["СоставНФАСчет30304"].Видимость				= Начисление ИЛИ Вычет;
	//Элементы["СоставНФАКПС30304"].Видимость					= Начисление ИЛИ Вычет;
	
	// Счет-фактура полученный покупателем-комитентом от комиссионера
	Если ПрименяемаяИнструкцияСтруктура["КомиссионнаяЗакупка"] Тогда
		НадписьВыбор = НСтр("ru = 'Выбор'");
		КоличествоПродавцов = Объект.ПродавцыКомиссионера.Количество();
				
		Если КоличествоПродавцов = 0 Тогда
			ЭтаФорма.НадписьНесколькоПродавцовВыбор = НадписьВыбор;
				
		ИначеЕсли КоличествоПродавцов > 1 Тогда
				
			Предмет = "продавец,продавца,продавцов,м,,,,0";
			ЭтаФорма.НадписьНесколькоПродавцовСсылка = ПредставлениеСсылкиПредмета(
				Предмет, "прод", Объект.ПродавцыКомиссионера[0].Продавец, КоличествоПродавцов);
				
		КонецЕсли;
				
		Элементы["НадписьНесколькоПродавцовВыбор"].Видимость  = КоличествоПродавцов = 0;
		Элементы["ГруппаОдинПродавец"].Видимость              = КоличествоПродавцов = 1;
		Элементы["НадписьНесколькоПродавцовСсылка"].Видимость = КоличествоПродавцов > 1;
	КонецЕсли;
	
	ЗаголовокКоманды = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Применяемая инструкция (%1)'"),
		ПрименяемаяИнструкцияСтруктура["Идентификатор"]);
	Элементы["ФормаПрименяемаяИнструкция"].Заголовок = ЗаголовокКоманды;
	
	УчетНДС.НастроитьФорму_ВидимостьКолонок(ЭтаФорма);
	
	ОграничитьСписокВыбораСчетРасчетов();
	
	// Очищаем и инициализируем по возможности счет СчетВычетКт
	Если ЗаполнитьКолонкиСчетовЗначениямиПоУмолчанию = Истина Тогда
		СчетВычетКт			= ПрименяемаяИнструкцияСтруктура["СчетВычетКт"];
		УстановитьСчетВычетКт		= НЕ (ПрежнийСчетВычетКт = СчетВычетКт);
		
		Если УстановитьСчетВычетКт Тогда
			ЗаполняющаяСтруктура = Новый Структура();
			ЗаполняющаяСтруктура.Вставить("Счет30304", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("303.04"));
			
			Если УстановитьСчетВычетКт Тогда
				ЗаполняющаяСтруктура.Вставить("КПСВычетКт",			Неопределено);
			КонецЕсли;
			
			Для Каждого СтрокаТЧ Из Объект["СоставНФА"] Цикл
				ЗаполняющаяСтруктура.Вставить("СчетВычетКт",
					?(СтрокаТЧ["НДСКРаспределению"],
						УчетНДСКлиентСервер.ПрименяемаяИнструкция_ПолучитьЗначениеРеквизита("СчетВычетКтКРаспределениюПоУмолчанию", ЭтаФорма, СтрокаТЧ),
						УчетНДСКлиентСервер.ПрименяемаяИнструкция_ПолучитьЗначениеРеквизита("СчетВычетКтБезРаспределенияПоУмолчанию", ЭтаФорма, СтрокаТЧ)));
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, ЗаполняющаяСтруктура);
				Если КомиссионнаяЗакупкаКомиссионер Тогда
					СтрокаТЧ["НДСКВычету"] = Ложь;
				КонецЕсли;
			КонецЦикла;
			
			// При изменении КФО,Дата мог измениться применяемый рабочий счет.
			// Поэтому пробуем установить КПС.
			Если УстановитьСчетВычетКт И АвтоустановкаКПС Тогда
				ОписаниеТаблицы = Новый Структура();
				ОписаниеТаблицы.Вставить("ИмяКолонкиСчет",		"СчетВычетКт");
				ОписаниеТаблицы.Вставить("ИмяКолонкиКПС",		"КПСВычетКт");
				ПараметрыЗаполнения = Новый Структура();
				ПараметрыЗаполнения.Вставить("Организация",							Объект["Организация"]);
				ПараметрыЗаполнения.Вставить("Дата",								Объект["Дата"]);
				ПараметрыЗаполнения.Вставить("ИФО",									Объект["ИФО"]);
				ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКПС",					Истина);
				ПараметрыЗаполнения.Вставить("ЗаполнитьТолькоПустыеПоля",			Истина);
				УчетНДС.ЗаполнитьТаблицуПоРабочемуПлануСчетов(Объект["СоставНФА"], ОписаниеТаблицы, ПараметрыЗаполнения);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// ПрименяемаяИнструкция=f(ПричинаНалогообложения,КФО,Дата)
&НаСервере
Процедура НастроитьТекущуюСтрокуСервер_ПоПрименяемойИнструкции(ТекущаяСтрока)
	
	ТекДанные = Объект["СоставНФА"].НайтиПоИдентификатору(ТекущаяСтрока);
	
	ЗаполнитьКолонкиСчетовЗначениямиПоУмолчанию = Истина;
	
	ПрименяемаяИнструкция_ЗаполнитьСлужебныеКолонки(
		ПрименяемаяИнструкция_СтруктураСвойств["Идентификатор"],
		ТекДанные);
	
	НастроитьПараметрыВыбораСчетВычетКтСервер(ТекДанные);
	
КонецПроцедуры

&НаСервере
Процедура ПрименяемаяИнструкция_ЗаполнитьСлужебныеКолонки(ИдентификаторИнструкции = Неопределено, СтрокаТаблицы = Неопределено)
	
	ОбъектСтруктура = Новый Структура();
	ОбъектСтруктура.Вставить("Организация",				Объект["Организация"]);
	ОбъектСтруктура.Вставить("ПричинаНалогообложения",	Объект["ПричинаНалогообложения"]);
	ОбъектСтруктура.Вставить("Дата",					Объект["Дата"]);
	ОбъектСтруктура.Вставить("ИФО",						Объект["ИФО"]);
	
	СтруктураСвойств = Новый Структура("
		|СчетВычетКт,
		|СчетВычетКтКРаспределениюПоУмолчанию,
		|СчетВычетКтБезРаспределенияПоУмолчанию,
		|ВидыПоказателяКПСВычетКт,
		|ВидыПоказателяКПС30304,
		|Счет30304");
		
	Если СтрокаТаблицы = Неопределено Тогда
		МассивСтрок = Объект["СоставНФА"];
	Иначе
		МассивСтрок = Новый Массив();
		МассивСтрок.Добавить(СтрокаТаблицы);
	КонецЕсли;
		
	Для Каждого СтрокаТЧ Из МассивСтрок Цикл
		ОбъектСтруктура.Вставить("КФО", СтрокаТЧ["КФО"]);
		
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ОбъектСтруктура, , ИдентификаторИнструкции);
		ЗаполнитьЗначенияСвойств(СтруктураСвойств, ПрименяемаяИнструкцияСтруктура);
		
		СтрокаТЧ["ПрименяемаяИнструкция_СтруктураСвойств"] = Новый ФиксированнаяСтруктура(СтруктураСвойств);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВзаимосвязанныеПоляСчетВычетКт(ИзмененныйЭлемент)
	
	ТекДанные = Элементы["СоставНФА"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИзмененныйЭлемент.Имя = "СоставНФАНДСКРаспределению" Тогда
		// Изменили флажок "К распределению".
		// Будем настраивать поле счета.
		СчетВычетКт = ТекДанные["СчетВычетКт"];
		СчетВычетКтКРаспределениюПоУмолчанию	= УчетНДСКлиентСервер.ПрименяемаяИнструкция_ПолучитьЗначениеРеквизита("СчетВычетКтКРаспределениюПоУмолчанию", ЭтаФорма, ТекДанные);
		СчетВычетКтБезРаспределенияПоУмолчанию	= УчетНДСКлиентСервер.ПрименяемаяИнструкция_ПолучитьЗначениеРеквизита("СчетВычетКтБезРаспределенияПоУмолчанию", ЭтаФорма, ТекДанные);
		УстановитьСчет = НЕ ЗначениеЗаполнено(СчетВычетКт)
			ИЛИ СчетВычетКт = СчетВычетКтКРаспределениюПоУмолчанию
			ИЛИ СчетВычетКт = СчетВычетКтБезРаспределенияПоУмолчанию;
		Если УстановитьСчет Тогда
			ТекДанные["СчетВычетКт"] = ?(ТекДанные["НДСКРаспределению"],
				СчетВычетКтКРаспределениюПоУмолчанию,
				СчетВычетКтБезРаспределенияПоУмолчанию);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура НастроитьПараметрыВыбораСчетВычетКтКлиент(ТекущиеДанные)
	
	// Параметры выбора СчетВычетКт
	СчетВычетКт = УчетНДСКлиентСервер.ПрименяемаяИнструкция_ПолучитьЗначениеРеквизита("СчетВычетКт", ЭтаФорма, ТекущиеДанные);
	НовыйПараметр = Новый ПараметрВыбора("Ссылка", СчетВычетКт);
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	Элементы["СоставНФАСчетВычетКт"].ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
	
КонецПроцедуры
&НаСервере
Процедура НастроитьПараметрыВыбораСчетВычетКтСервер(ТекущиеДанные)
	
	// Параметры выбора СчетВычетКт
	СчетВычетКт = УчетНДСКлиентСервер.ПрименяемаяИнструкция_ПолучитьЗначениеРеквизита("СчетВычетКт", ЭтаФорма, ТекущиеДанные);
	НовыйПараметр = Новый ПараметрВыбора("Ссылка", СчетВычетКт);
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	Элементы["СоставНФАСчетВычетКт"].ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент_РегистрацияВДопЛистеПриИзменении()
	
	НовДоступность = Объект["РегистрацияВДопЛисте"];
	
	Элементы["КорректируемыйПериод"].Доступность = НовДоступность;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИОбновитьСоставНФА(ЗапроситьПодтверждение = Истина)
	
	Если Не ПроверитьПередОбновлениемПоДокументамОснованиям() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗапроситьПодтверждение Тогда
		ТекстВопроса = НСтр("ru='Заполнить редактируемый счет-фактуру на основании указанных документов?'");
		ТекстЗаголовка = НСтр("ru='Счет-фактура полученный'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОбновитьСоставНФАКлиент_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет, ТекстЗаголовка);
	Иначе
		ОбновитьСоставНФАКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСоставНФАКлиент_Выбор(Результат, ПараметрыОповещения) Экспорт
	
	Перем ОписаниеОшибки;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОбновитьСоставНФАКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьПередОбновлениемПоДокументамОснованиям()
	
	Отказ = Ложь;
	
	Для Каждого СтрокаТаблицы Из Объект.ДокументыОснования Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДокументОснование) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru='Документ-основание'"), СтрокаТаблицы.НомерСтроки, НСтр("ru='Документы-основания'"));
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ДокументыОснования", СтрокаТаблицы.НомерСтроки, "ДокументОснование"),
				"Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаДублиСтрок = ОбщегоНазначенияБГУ.НайтиДублиСтрок(Объект.ДокументыОснования, "ДокументОснование", Ложь);
	
	Если ТаблицаДублиСтрок.Количество() > 0 Тогда
		ПараметрыВывода = ОбщегоНазначенияБГУ.ПараметрыВыводаСообщенийОДубляхСтрок();
		ПараметрыВывода.ТаблицаИмя = "ДокументыОснования";
		ПараметрыВывода.ТаблицаПредставление = НСтр("ru='Документы-основания'");
		ПараметрыВывода.ОбъектСсылка = Объект.Ссылка;
		ПараметрыВывода.ИмяПоляДляВыводаСообщений = "ДокументОснование";
		
		ОбщегоНазначенияБГУ.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
		
		Отказ = Истина;
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСоставНФАКлиент()
	
	АдресХранилища = ПоместитьВХранилищеОснованияТребующиеУточнения();
	
	Если ЭтоАдресВременногоХранилища(АдресХранилища) Тогда
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("АдресХранилища", АдресХранилища);
		
		Оповещение = Новый ОписаниеОповещения("ЗакрытаФормаВводаНаОсновании", ЭтотОбъект);
		
		ОткрытьФорму("Документ.СчетФактураПолученный.Форма.ФормаВводаНаОсновании", ПараметрыФормы, ЭтотОбъект,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		Возврат;
	КонецЕсли;
	
	ОбновитьСоставНФАСервер();
	
	ОбновитьИтогиКомиссия(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСоставНФАСервер(АдресХранилища = Неопределено)
	
	Перем ТекстСообщения;
	
	Результат = Документы.СчетФактураПолученный.ОбновитьСоставНФА(Объект, ТекстСообщения, АдресХранилища);
	
	Если Результат Тогда
		НастроитьФормуСервер_ПоПрименяемойИнструкции(Ложь);
		
		// Прослеживаемость
		НастроитьФормуПрослеживаемостьСервер();
		// Конец Прослеживаемость
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстСообщения,
			Объект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьДокументаОплатыНалога()
	
	НовВидимость = (ЗначениеЗаполнено(Объект.ДатаДокументаОплаты) ИЛИ ЗначениеЗаполнено(Объект.НомерДокументаОплаты));
	
	Элементы.ГруппаДокументПодтверждающийОплату.Видимость = НовВидимость;
	
КонецПроцедуры

&НаСервере
Процедура ОграничитьСписокВыбораСчетРасчетов();
	
	МассивПараметров = Новый Массив();
	
	Если ЭтоАванс Тогда
		НовыйПараметр = Новый ПараметрВыбора("ОграниченияСчета", "206.00");
		МассивПараметров.Добавить(НовыйПараметр);
		
		НовыйПараметр = Новый ПараметрВыбора("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
		МассивПараметров.Добавить(НовыйПараметр);
	КонецЕсли;
	
	Элементы.СоставНФАСчетРасчетов.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	
КонецПроцедуры

#Область ВыборДокументовОснований

&НаСервере
Процедура ИнициализироватьНастройкиОграниченийВыбораДокументовОснований()
	
	// В указанных группах документов допустимо выбирать произвольное количество документов-оснований
	// указанных типов в произвольном сочетании.
	// Все остальные типы документов, не указанные явно в этих группах, предусматривают возможность выбора
	// лишь одного документа-основания.
	
	НастройкиОграничений = Новый Структура();
	
	ОтдельныеГруппыДокументов = Новый Массив();
	
	ТипыДокументов = Новый Массив();
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.КассовоеВыбытие"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ПлатежноеПоручение"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.РасходныйКассовыйОрдер"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.РСКППеречисление"));
	
	ОтдельныеГруппыДокументов.Добавить(ТипыДокументов);
	
	ТипыДокументов = Новый Массив();
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ПоступлениеМЗ"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ПоступлениеМЗВПути"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ПоступлениеОС"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ПоступлениеОСВПути"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ПоступлениеУслугРабот"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ПоступлениеУслугРаботПоСчетамУчетаЗатрат"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.НачислениеАмортизацииПравПользованияОС"));
	
	ОтдельныеГруппыДокументов.Добавить(ТипыДокументов);
	
	НастройкиОграничений.Вставить("ОтдельныеГруппыДокументов", ОтдельныеГруппыДокументов);
	
	НастройкиОграничений.Вставить("ДопустимТолькоОдинДокумент", ПолучитьОставшиесяТипыДокументовОснований(ОтдельныеГруппыДокументов));
	
	СинонимыДокументов = Новый Соответствие();
	
	ТипыДокументов = Метаданные.Документы.СчетФактураПолученный.ТабличныеЧасти.ДокументыОснования.Реквизиты.ДокументОснование.Тип.Типы();
	
	Для Каждого ТипДокумента Из ТипыДокументов Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипДокумента);
		
		СинонимыДокументов.Вставить(ТипДокумента, ОбъектМетаданных.Синоним);
	КонецЦикла;
	
	НастройкиОграничений.Вставить("СинонимыДокументов", СинонимыДокументов);
	
	НастройкиОграниченийВыбораДокументовОснований = Новый ФиксированнаяСтруктура(НастройкиОграничений);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОставшиесяТипыДокументовОснований(ОтдельныеГруппыДокументов)
	
	ТипыДокументов = Метаданные.Документы.СчетФактураПолученный.ТабличныеЧасти.ДокументыОснования.Реквизиты.ДокументОснование.Тип.Типы();
	
	Для Каждого СписокТипов Из ОтдельныеГруппыДокументов Цикл
		ТипыДокументов = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ТипыДокументов, СписокТипов);
	КонецЦикла;
	
	Возврат ТипыДокументов;
	
КонецФункции

&НаКлиенте
Функция ПолучитьОграничениеТипаДокументаОснования(ИндексГруппы, ТипДокумента, ТекстСообщения)
	
	ИндексГруппы = ИндексГруппыТиповДокументов(Элементы.ДокументыОснования.ТекущиеДанные, ТипДокумента);
	
	Если ИндексГруппы = Неопределено Тогда
		ТекстСообщения = ПолучитьТекстСообщенияДопустимТолькоОдинДокумент(ТипДокумента);
	КонецЕсли;
	
	Если ИндексГруппы = Неопределено Или ИндексГруппы = -1 Тогда
		ТипыДокументов = Новый Массив();
	Иначе
		ТипыДокументов = НастройкиОграниченийВыбораДокументовОснований.ОтдельныеГруппыДокументов[ИндексГруппы];
	КонецЕсли;
	
	Возврат Новый ОписаниеТипов(ТипыДокументов);
	
КонецФункции

&НаКлиенте
Процедура УстановитьПараметрыВыбораДокументаОснования(ТипДокумента)
	
	МассивПараметров = Новый Массив();
	
	МножественныйВыбор = (НастройкиОграниченийВыбораДокументовОснований.ДопустимТолькоОдинДокумент.Найти(ТипДокумента) = Неопределено);
	
	НовыйПараметр = Новый ПараметрВыбора("МножественныйВыбор", МножественныйВыбор);
	МассивПараметров.Добавить(НовыйПараметр);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Организация", Объект.Организация);
	МассивПараметров.Добавить(НовыйПараметр);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Контрагент", Объект.Контрагент);
	МассивПараметров.Добавить(НовыйПараметр);
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		НовыйПараметр = Новый ПараметрВыбора("Отбор.Договор", Объект.Договор);
		МассивПараметров.Добавить(НовыйПараметр);
	КонецЕсли;
	
	Если ТипДокумента = Тип("ДокументСсылка.РСКППеречисление") Тогда
		// Значения заполнения для создания нового документа РКСППеречисление.
		НовыйПараметр = Новый ПараметрВыбора("ДополнительныеПараметры.МодульИнтеграции", ПредопределенноеЗначение("Перечисление.МодулиИнтеграции.ЕБПАУБУ"));
		МассивПараметров.Добавить(НовыйПараметр);
	КонецЕсли;
	
	Элементы.ДокументыОснованияДокументОснование.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокВыбораДокументОснованиеСоставНФА()
	
	СписокДокументов = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из Объект.ДокументыОснования Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДокументОснование) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СписокДокументов.Найти(СтрокаТаблицы.ДокументОснование) = Неопределено Тогда
			СписокДокументов.Добавить(СтрокаТаблицы.ДокументОснование);
		КонецЕсли;
	КонецЦикла;
	
	Элементы.СоставНФАДокументОснование.СписокВыбора.ЗагрузитьЗначения(СписокДокументов);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВыбранныеДокументы(СписокДокументов)
	
	ТекДанные = Элементы.ДокументыОснования.ТекущиеДанные;
	
	Счетчик = 1;
	
	Для Каждого ДокументОснование Из СписокДокументов Цикл
		Если ДокументОснованиеУказанВИнойСтроке(ДокументОснование, ТекДанные) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Счетчик = 1 Тогда
			Если ТекДанные <> Неопределено Тогда
				СтрокаТаблицы = ТекДанные;
			Иначе
				СтрокаТаблицы = Объект.ДокументыОснования.Добавить();
			КонецЕсли;
		Иначе
			СтрокаТаблицы = Объект.ДокументыОснования.Добавить();
		КонецЕсли;
		
		СтрокаТаблицы.ДокументОснование = ДокументОснование;
		
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ДокументОснованиеУказанВИнойСтроке(ДокументОснование, ТекущаяСтрокаТаблицы)
	
	Поиск = Новый Структура("ДокументОснование", ДокументОснование);
	
	МассивСтрок = Объект.ДокументыОснования.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Ложь;
		
	ИначеЕсли МассивСтрок.Количество() = 1 И МассивСтрок[0] = ТекущаяСтрокаТаблицы Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ЗапрещеноДобавитьНовыйДокументОснование(ТекстСообщения)
	
	Перем ТипДокумента;
	
	Если Объект.ДокументыОснования.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИндексГруппы = ИндексГруппыТиповДокументов(, ТипДокумента);
	
	Если ИндексГруппы = Неопределено Тогда
		ТекстСообщения = ПолучитьТекстСообщенияДопустимТолькоОдинДокумент(ТипДокумента);
		
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ПолучитьТекстСообщенияДопустимТолькоОдинДокумент(ТипДокумента)
	
	СинонимДокумента = НастройкиОграниченийВыбораДокументовОснований.СинонимыДокументов.Получить(ТипДокумента);
	
	Возврат СтрШаблон(НСтр("ru='Документ-основание ""%1"" может быть добавлен только один раз.
		|При этом не предусмотрено добавление каких-либо еще документов-оснований.'"), СинонимДокумента);
	
КонецФункции

&НаКлиенте
Функция ИндексГруппыТиповДокументов(Знач ПропуститьСтрокуТаблицы = Неопределено, ТипДокумента = Неопределено)
	
	Для Каждого СтрокаТаблицы Из Объект.ДокументыОснования Цикл
		ДокументОснование = СтрокаТаблицы.ДокументОснование;
		
		Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
			Продолжить;
		КонецЕсли;
		
		ТипДокумента = ТипЗнч(ДокументОснование);
		
		Если ПропуститьСтрокуТаблицы <> Неопределено И СтрокаТаблицы = ПропуститьСтрокуТаблицы Тогда
			Продолжить;
		КонецЕсли;
		
		Если НастройкиОграниченийВыбораДокументовОснований.ДопустимТолькоОдинДокумент.Найти(ТипДокумента) <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ИндексГруппы = 0;
		
		Для Каждого ТипыДокументов Из НастройкиОграниченийВыбораДокументовОснований.ОтдельныеГруппыДокументов Цикл
			Если ТипыДокументов.Найти(ТипДокумента) <> Неопределено Тогда
				Возврат ИндексГруппы;
			КонецЕсли;
			
			ИндексГруппы = ИндексГруппы + 1;
		КонецЦикла;
	КонецЦикла;
	
	Возврат -1;
	
КонецФункции

&НаКлиенте
Функция ПроверитьПередНачаломВыбораДокументаОснования()
	
	Результат = Истина;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Результат = Ложь;
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", "Организация"),
			Объект.Ссылка, "Объект.Организация");
	КонецЕсли;
			
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Результат = Ложь;
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", "Контрагент"),
			Объект.Ссылка, "Объект.Контрагент");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

