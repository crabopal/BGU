Процедура ДобавитьУсловноеОформление_КомиссионнаяЗакупка(УсловноеОформление)
	
	//---
	// 1. Активный флажок "КомиссионнаяТорговля" - недоступные поля группы недоступные поля группы СоставНФАГруппаВычетКт, СоставНФАСчетРасчетов, СоставНФАСчет30304
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Активный флажок ""КомиссионнаяТорговля"" - недоступные поля группы СоставНФАГруппаВычетКт, СоставНФАСчетРасчетов, СоставНФАСчет30304'");
	
