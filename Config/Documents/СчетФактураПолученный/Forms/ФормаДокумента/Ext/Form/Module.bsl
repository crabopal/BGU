&НаСервере
Функция ВидимостьЭлементовЭДОДляДокумента()
	Результат = Ложь;
	Если ЗначениеЗаполнено(Объект.ЭДПоставщика) Тогда
		Если ТипЗнч(Объект.ЭДПоставщика) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	ОтражениеВУчетеЭлектронногоДокумента = Результат;
	
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДО(Форма, ВидимостьЭлементовЭДО, ВидимостьЭлементовЭДОДляЭДПоставщика)
	Объект = Форма.Объект;

	Если ВидимостьЭлементовЭДОДляЭДПоставщика И Форма.Элементы.ДекорацияСостояниеЭДО.Заголовок = НСтр("ru='Не начат'") Тогда
		ВидимостьЭлементовЭДО = Истина;
		Форма.Элементы.ДекорацияСостояниеЭДО.Заголовок = НСтр("ru='Отражение ЭД в учете'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ДекорацияСостояниеЭДО", "Доступность", ВидимостьЭлементовЭДОДляЭДПоставщика);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияСостояниеЭДО", "Видимость", ВидимостьЭлементовЭДО);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументыОснованияПоЭДПоставщикаНаСервере()
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(Объект.ИФО) Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ПоступлениеМЗ.Ссылка КАК ДокументОснование
		               |ИЗ
		               |	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
		               |ГДЕ
		               |	ПоступлениеМЗ.ДокументОснование = &ДокументОснование
		               |	И ПоступлениеМЗ.ИФО = &ИФО
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ПоступлениеОС.Ссылка
		               |ИЗ
		               |	Документ.ПоступлениеОС КАК ПоступлениеОС
		               |ГДЕ
		               |	ПоступлениеОС.ДокументОснование = &ДокументОснование
		               |	И ПоступлениеОС.ИФО = &ИФО
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ПоступлениеУслугРабот.Ссылка
		               |ИЗ
		               |	Документ.ПоступлениеУслугРабот КАК ПоступлениеУслугРабот
		               |ГДЕ
		               |	ПоступлениеУслугРабот.ДокументОснование = &ДокументОснование
		               |	И ПоступлениеУслугРабот.ИФО = &ИФО";
		Запрос.УстановитьПараметр("ИФО", Объект.ИФО);	
	Иначе	
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ПоступлениеМЗ.Ссылка КАК ДокументОснование
		               |ИЗ
		               |	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
		               |ГДЕ
		               |	ПоступлениеМЗ.ДокументОснование = &ДокументОснование
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ПоступлениеОС.Ссылка
		               |ИЗ
		               |	Документ.ПоступлениеОС КАК ПоступлениеОС
		               |ГДЕ
		               |	ПоступлениеОС.ДокументОснование = &ДокументОснование
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ПоступлениеУслугРабот.Ссылка
		               |ИЗ
		               |	Документ.ПоступлениеУслугРабот КАК ПоступлениеУслугРабот
		               |ГДЕ
		               |	ПоступлениеУслугРабот.ДокументОснование = &ДокументОснование";
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.ЭДПоставщика);	
	ДокументыОснованияЭДПоставщика = Запрос.Выполнить().Выгрузить();
	Объект.ДокументыОснования.Очистить();
	Объект.ДокументыОснования.Загрузить(ДокументыОснованияЭДПоставщика);
КонецПроцедуры

&НаСервере
Процедура СверитьЗаполнениеДокументаСЭДНаСервере(БезСообщенийОбОтсутствииРасхождений = Ложь)
	
	РезультатЭДО = ОбменСКонтрагентами.СтатусДокументооборота(Объект.Ссылка);
	
	Если ТипЗнч(РезультатЭДО) = Тип("Структура") Тогда
		ЭД = РезультатЭДО.ЭлектронныйДокумент;
		Если ЗначениеЗаполнено(ЭД) Тогда
			
			ДанныеЭД = ОбменСКонтрагентами.ДанныеЭлектронногоДокумента(ЭД);
			
			ДокументыУчета = ЭлектронныеДокументыБГУ.СравнитьДанныеОбъекта(ДанныеЭД, Объект.Ссылка, Истина, , );			
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

