&НаКлиенте
Процедура ДокументыОснованияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Перем ТекстСообщения;
	
	Если Не ПроверитьПередНачаломВыбораДокументаОснования() Тогда
		Отказ = Истина;
		
		Возврат;
	КонецЕсли;
	
	Если ЗапрещеноДобавитьНовыйДокументОснование(ТекстСообщения) Тогда
		Отказ = Истина;
		
		ПоказатьПредупреждение(, ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

