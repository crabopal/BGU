	Если ВедетсяУчетПрослеживаемыхТоваров Тогда
	РассчитатьПрослеживаемыеТовары();
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"СоставНФАПрослеживаемыйТовар",
		"Видимость",
		ЕстьПрослеживаемыеТовары);
