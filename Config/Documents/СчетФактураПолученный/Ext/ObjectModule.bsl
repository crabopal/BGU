#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Перем Основание; 
	
	Если ДанныеЗаполнения <> Неопределено И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ДанныеЗаполнения)) Тогда
		// Стандартный ввод на основании.
		ТекстСообщения = "";
		Если Не Документы.СчетФактураПолученный.ЗаполнитьНаОсновании(ДанныеЗаполнения, ЭтотОбъект, ТекстСообщения) тогда
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
	ИначеЕсли Документы.СчетФактураПолученный.ЭтоСтруктураОснованияИзФормыВводаНаОсновании(ДанныеЗаполнения) Тогда
		// Ввод на основании из формы ввода на основании.
		ТекстСообщения = "";
		Если Не Документы.СчетФактураПолученный.ЗаполнитьНаОсновании(ДанныеЗаполнения.ДокументОснование, ЭтотОбъект,
				ТекстСообщения, ДанныеЗаполнения.ОтборИзШапкиСФ.ПоляОтбора) Тогда
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если НЕ ДанныеЗаполнения.Свойство("ДокументОснование") Тогда
			ДанныеЗаполнения.Свойство("Основание", Основание);
			Если ТипЗнч(Основание) = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
				СтандартнаяОбработка = Ложь; 
	            ЗаполнитьПоОтчетуКомитентуОПродажах(ДанныеЗаполнения);
		    КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект["ВалютаДокумента"]) Тогда
		ЭтотОбъект["ВалютаДокумента"] = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Документы.СчетФактураПолученный.СформироватьДвиженияПоРегистрам(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СчетФактураПоКомиссионнойРеализации = УчетНДС.ЭтоКомиссионнаяРеализация(ЭтотОбъект.ПричинаНалогообложения);
	
	АвансВыданныйКомиссионером = ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансВыданныйКомиссионером;
		
	Если СчетФактураПоКомиссионнойРеализации Тогда
		СуммаДокумента	= СчетаФактурыВыданныеПокупателям.Итог("Сумма");
		СуммаНДС 		= СчетаФактурыВыданныеПокупателям.Итог("НДС");
		
		Если СчетаФактурыВыданныеПокупателям.Количество() > 1 Тогда
			СводныйКомиссионный = Истина;
		КонецЕсли;
		
	Иначе
		СуммаДокумента	= СоставНФА.Итог("Всего");
		СуммаНДС 		= СоставНФА.Итог("СуммаНДС");
	КонецЕсли;	
	
	Если АвансВыданныйКомиссионером Тогда
		СуммаДокументаКомиссия = СоставНФА.Итог("Всего");
		СуммаНДСДокументаКомиссия = СоставНФА.Итог("СуммаНДС");
	КонецЕсли;
	
	КопияСоставНФА = СоставНФА.Выгрузить(, "НФА");
	УчетНДС.ЗаполнитьВидЦенности(КопияСоставНФА, ПричинаНалогообложения);
	ВидЦенности = УчетНДС.ПолучитьОбщийВидЦенности(КопияСоставНФА);
	
	ДозаполнитьТабличнуюЧастьДокументыОснования();
	
	УчетНДСВызовСервера.УстановитьДатуДвиженийВРегистреНДС(ЭтотОбъект);
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Очистить();
	
	ЕстьОшибкиЗаполнения = Документы.СчетФактураПолученный.ЕстьОшибкиЗаполнения(ЭтотОбъект);
		
	Если ЕстьОшибкиЗаполнения Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Процедура ДозаполнитьТабличнуюЧастьДокументыОснования()
	
	МассивДокументов = Новый Массив();
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаТаблицы ИЗ СоставНФА Цикл
		
		ДокументСсылка = СтрокаТаблицы.ДокументОснование;
		
		Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		Поиск.Вставить("ДокументОснование", ДокументСсылка);
		
		МассивСтрок = ДокументыОснования.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		МассивДокументов.Добавить(ДокументСсылка);
		
	КонецЦикла;
	
	Для Каждого ДокументСсылка Из МассивДокументов Цикл
		
		НоваяСтрока = ДокументыОснования.Добавить();
		
		НоваяСтрока.ДокументОснование = ДокументСсылка;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПоОтчетуКомитентуОПродажах(ДанныеЗаполнения) 
	
	ПричинаНалогообложения = ДанныеЗаполнения.ПричинаНалогообложенияНДС;
	ДанныеДокОснование = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения.Основание, "Организация, ИФО, Дата, Контрагент, Договор");
	Договор = ДанныеДокОснование.Договор;
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокОснование); 
	
	ДокументыОснования.Очистить();
	НоваяСтрока = ДокументыОснования.Добавить();
	НоваяСтрока.ДокументОснование = ДанныеЗаполнения.Основание;
	
	КодСпособаВыставления = 1;
	
	Если ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомитента Тогда	
		КодВидаОперации = "02";		
	ИначеЕсли ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаРеализациюОтКомитента Тогда 
		КодВидаОперации = "01";	
	КонецЕсли;
				
КонецПроцедуры

#КонецЕсли
