	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("Ссылка",					ДокументОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("СчетНДСКРаспределению",	Основание_РеквизитыТиповойОперации["СчетНДСКРаспределению"]);
	ЗапросЗаполнение.УстановитьПараметр("СчетНДС",					Основание_РеквизитыТиповойОперации["СчетНДС"]);
	ЗапросЗаполнение.УстановитьПараметр("Счет30304",				Счет30304);
	ЗапросЗаполнение.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступлениеМЗ.Ссылка,
	|	ПоступлениеМЗ.Дата,
	|	ПоступлениеМЗ.Организация,
	|	ПоступлениеМЗ.ИФО,
	|	ПоступлениеМЗ.Подразделение,
	|	ПоступлениеМЗ.Контрагент,
	|	ПоступлениеМЗ.Договор,
	|	ПоступлениеМЗ.ВалютаДокумента,
	|	ПоступлениеМЗ.СуммаВключаетНДС,
	|	ПоступлениеМЗ.Материалы.(
	|		Ссылка КАК ДокументОснование,
	|		Номенклатура КАК НФА,
	|		Количество,
	|		ВЫБОР
	|			КОГДА Ссылка.СуммаВключаетНДС Тогда
	|				Сумма - СуммаНДС
	|			ИНАЧЕ
	|				Сумма
	|		КОНЕЦ		КАК Сумма,
	|		СтавкаНДС,
	|		СуммаНДС,
	|		Всего,
	|		ЕдиницаИзмерения,
	|		НДСКРаспределению,
	|		ВЫБОР
	|			КОГДА Ссылка.ПринятьНДСКВычетуУказываетсяВСтроках ТОГДА
	|				ПринятьНДСКВычету
	|			ИНАЧЕ
	|				Ссылка.ПринятьНДСКВычету
	|		КОНЕЦ	КАК НДСКВычету,
	|		КФО				КАК КФО,
	|		КПС	КАК КПСВычетКт,
	|		ВЫБОР
	|			КОГДА НДСКРаспределению ТОГДА
	|				&СчетНДСКРаспределению
	|			ИНАЧЕ
	|				&СчетНДС
	|		КОНЕЦ				КАК СчетВычетКт,
	|		&Счет30304			КАК Счет30304
	|	) КАК ТабличнаяЧасть,
	|	ВЫБОР
	|		КОГДА ПоступлениеМЗ.Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.АгентскийДоговор)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Покупка)
	|	КОНЕЦ КАК ПричинаНалогообложения,
	|	ВЫБОР
	|		КОГДА ПоступлениеМЗ.Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.АгентскийДоговор)
	|			ТОГДА ""06""
	|		ИНАЧЕ ""01""
	|	КОНЕЦ КАК КодВидаОперации
	|ИЗ
	|	Документ.ПоступлениеМЗВПути КАК ПоступлениеМЗ
	|ГДЕ
	|	ПоступлениеМЗ.Ссылка = &Ссылка";
	
	Основание = ЗапросЗаполнение.Выполнить().Выбрать();
	Основание.Следующий();
	
	Если ИзТаблицы Тогда
		ЗаполнитьЗначенияСвойств(Объект, Основание, "КодВидаОперации,ПричинаНалогообложения");
	Иначе
		Объект.ДокументыОснования.Очистить();
		
		НоваяСтрока = Объект.ДокументыОснования.Добавить();
		НоваяСтрока.ДокументОснование = ДокументОснованиеСсылка;
		
		ЗаполнитьЗначенияСвойств(Объект, Основание);
	КонецЕсли;	
	
	Материал = Основание.ТабличнаяЧасть.Выбрать();
	Пока Материал.Следующий() цикл
		СтрокаНФА = Объект.СоставНФА.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНФА, Материал);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДокументНаОснованииПоступлениеОС(Знач ДокументОснованиеСсылка, Знач ИмяДокумента, Объект, Знач ИзТаблицы)
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_ТиповаяОперацияСсылка		= БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(ДокументОснованиеСсылка);
	Основание_РеквизитыТиповойОперации	= Справочники.ТиповыеОперации.ПустаяСтруктураДопРеквизитовОперации(Основание_ТиповаяОперацияСсылка);
	Основание_РеквизитыТиповойОперации	= БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументОснованиеСсылка, Основание_РеквизитыТиповойОперации);
	
	// Каноническая типовая операция документа-основания:
	Основание_ТиповаяОперация = Новый Структура("
		|КПСОперации,
		|СчетУчетаНДС,
		|СчетУчетаНДСКРаспределению");
	СинонимыРеквизитов = Новый Структура();
	СинонимыРеквизитов.Вставить("СчетУчетаНДС",					"СчетНДС,СчетУчетаНДС");
	СинонимыРеквизитов.Вставить("СчетУчетаНДСКРаспределению",	"СчетНДСКРаспределению,СчетУчетаНДСКРаспределению");
	УчетНДС.ЗаполнитьЗначенияСвойствТиповойОперации(Основание_ТиповаяОперация, Основание_РеквизитыТиповойОперации, СинонимыРеквизитов);
	
	// Настраиваем запрос:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("Ссылка",					ДокументОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("СчетНДС",					Основание_ТиповаяОперация["СчетУчетаНДС"]);
	ЗапросЗаполнение.УстановитьПараметр("СчетНДСКРаспределению",	Основание_ТиповаяОперация["СчетУчетаНДСКРаспределению"]);
	ЗапросЗаполнение.УстановитьПараметр("Счет30304",				ПланыСчетов.ЕПСБУ.НайтиПоКоду("303.04"));
	ЗапросЗаполнение.УстановитьПараметр("ЕдИзмШт",					Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796")); // шт.
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступлениеОС.Ссылка,
	|	ПоступлениеОС.Дата,
	|	ПоступлениеОС.Организация,
	|	ПоступлениеОС.ИФО,
	|	ПоступлениеОС.Подразделение,
	|	ПоступлениеОС.Контрагент,
	|	ПоступлениеОС.Договор,
	|	ПоступлениеОС.ВалютаДокумента,
	|	ПоступлениеОС.СуммаВключаетНДС,
	|	""01"" КАК КодВидаОперации,
	|	ВЫБОР
	|		КОГДА ПоступлениеОС.Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.АгентскийДоговор)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Покупка)
	|	КОНЕЦ КАК ПричинаНалогообложения,
	|	ПоступлениеОС.КапВложения.(
	|		Ссылка КАК ДокументОснование,
	|		ВнеоборотныйАктив КАК НФА,";
	
	Если ИмяДокумента = "ПоступлениеОС" тогда
		ТекстЗапроса = ТекстЗапроса	+ "	
		|		КоличествоМест,
		|		Коэффициент,
		|		ЕдиницаИзмерения,";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса	+ "	
	|		Количество,
	|		ВЫБОР
	|			КОГДА Ссылка.СуммаВключаетНДС Тогда
	|				Сумма - СуммаНДС
	|			ИНАЧЕ
	|				Сумма
	|		КОНЕЦ		КАК Сумма,
	|		СтавкаНДС,
	|		СуммаНДС,
	|		НДСКРаспределению,
	|		Всего,
	|		&ЕдИзмШт	КАК ЕдиницаИзмерения,
	|		ВЫБОР
	|			КОГДА Ссылка.ПринятьНДСКВычетуУказываетсяВСтроках ТОГДА
	|				ПринятьНДСКВычету
	|			ИНАЧЕ
	|				Ссылка.ПринятьНДСКВычету
	|		КОНЕЦ	КАК НДСКВычету,
	|		КФО		КАК КФО,
	|		КПС		КАК КПСВычетКт,
	|		ВЫБОР
	|			КОГДА НДСКРаспределению ТОГДА
	|				&СчетНДСКРаспределению
	|			ИНАЧЕ
	|				&СчетНДС
	|		КОНЕЦ		КАК СчетВычетКт,
	|		&Счет30304	КАК Счет30304
	|	) КАК ТабличнаяЧасть
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК ПоступлениеОС
	|ГДЕ
	|	ПоступлениеОС.Ссылка = &Ссылка";
	
	ЗапросЗаполнение.Текст = ТекстЗапроса;
	
	Основание = ЗапросЗаполнение.Выполнить().Выбрать();
	Основание.Следующий();
	
	Если ИзТаблицы Тогда
		ЗаполнитьЗначенияСвойств(Объект, Основание, "КодВидаОперации,ПричинаНалогообложения");
	Иначе
		Объект.ДокументыОснования.Очистить();
		
		НоваяСтрока = Объект.ДокументыОснования.Добавить();
		НоваяСтрока.ДокументОснование = ДокументОснованиеСсылка;
		
		ЗаполнитьЗначенияСвойств(Объект, Основание);
	КонецЕсли;
	
	Материал = Основание.ТабличнаяЧасть.Выбрать();
	Пока Материал.Следующий() Цикл
		СтрокаНФА = Объект.СоставНФА.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНФА, Материал);
	КонецЦикла;
	
КонецПроцедуры	

Процедура ЗаполнитьДокументНаОснованииПоступлениеУслугРабот(Знач ДокументОснованиеСсылка, Объект, Знач ИзТаблицы, ОписаниеОшибки)
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_РеквизитыТиповойОперации	= БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументОснованиеСсылка,
		"СчетУчетаНДС,СчетУчетаНДСКРаспределению");
	
	// Настраиваем запрос:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокОснованиеСсылка",			ДокументОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("Счет106КС",					БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("106.КС"));
	ЗапросЗаполнение.УстановитьПараметр("Счет30304",					БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("303.04"));
	ЗапросЗаполнение.УстановитьПараметр("СчетУчетаНДС",					Основание_РеквизитыТиповойОперации["СчетУчетаНДС"]);
	ЗапросЗаполнение.УстановитьПараметр("СчетУчетаНДСКРаспределению",	Основание_РеквизитыТиповойОперации["СчетУчетаНДСКРаспределению"]);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для заполнения шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организация										КАК Организация,
	|	Дата											КАК Дата,
	|	ИФО												КАК ИФО,
	|	Подразделение									КАК Подразделение,
	|	Контрагент										КАК Контрагент,
	|	Договор											КАК Договор,
	|	ВалютаДокумента									КАК ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА НЕ ОпределитьСМР.Сумма = 0 ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.СМРПодряднымСпособом)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Покупка)
	|	КОНЕЦ											КАК ПричинаНалогообложения,
	|	""01""											КАК КодВидаОперации,
	|	
	|	// Служебные колонки:
	|	Договор.ТипДоговораНДС							КАК ТипДоговораНДС,
	|	ВЫБОР
	|		КОГДА	Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.АгентскийДоговор)
	|			ИЛИ	Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.АгентскийДоговорНерезидент) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ											КАК ЭтоНедопустимыйТипДоговораНДС
	|ИЗ
	|	Документ.ПоступлениеУслугРабот КАК Док,
	|	(ВЫБРАТЬ
	|		СУММА(ЕПСБУДвижения.Сумма)	КАК Сумма
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор = &ДокОснованиеСсылка
	|			И	СчетДт В ИЕРАРХИИ(&Счет106КС)
	|			И	СубконтоДт3 = ЗНАЧЕНИЕ(Перечисление.СпособыСтроительства.Подрядный),
	|			,
	|		)	КАК ЕПСБУДвижения
	|	)	КАК ОпределитьСМР
	|ГДЕ
	|	Ссылка = &ДокОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для заполнения таблицы СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка						КАК ДокументОснование,
	|	ВЫБОР
	|		КОГДА Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) ТОГДА
	|			Номенклатура
	|		ИНАЧЕ
	|			ВЫРАЗИТЬ(Содержание КАК Строка(100))
	|	КОНЕЦ						КАК НФА,
	|	ЕдиницаИзмерения			КАК ЕдиницаИзмерения,
	|	Количество					КАК Количество,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			Сумма - СуммаНДС
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ						КАК Сумма,
	|	СтавкаНДС					КАК СтавкаНДС,
	|	СуммаНДС					КАК СуммаНДС,
	|	Всего						КАК Всего,
	|	КомиссионнаяТорговля		КАК КомиссионнаяТорговля,
	|	
	|	ВЫБОР
	|		КОГДА КомиссионнаяТорговля ТОГДА
	|			Ложь
	|		КОГДА Ссылка.ПринятьНДСКВычетуУказываетсяВСтроках ТОГДА
	|			ПринятьНДСКВычету
	|		ИНАЧЕ
	|			Ссылка.ПринятьНДСКВычету
	|	КОНЕЦ						КАК НДСКВычету,
	|	НДСКРаспределению			КАК НДСКРаспределению,
	|	КФО							КАК КФО,
	|	КПС							КАК КПСВычетКт,
	|	ВЫБОР
	|		КОГДА НДСКРаспределению ТОГДА
	|			&СчетУчетаНДСКРаспределению
	|		ИНАЧЕ
	|			&СчетУчетаНДС
	|	КОНЕЦ						КАК СчетВычетКт,
	|	&Счет30304					КАК Счет30304
	|ИЗ
	|	Документ.ПоступлениеУслугРабот.УслугиИРаботы КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &ДокОснованиеСсылка
	|;";
	
	// Выполняем запросы:
	РезультатыЗаполнения	= ЗапросЗаполнение.ВыполнитьПакет();
	РезультатШапка			= РезультатыЗаполнения[0].Выбрать();
	РезультатСоставНФА		= РезультатыЗаполнения[1].Выгрузить();
	
	Если РезультатШапка.Следующий() Тогда
		// Можно корректно заполнить на основании?
		Если РезультатШапка["ЭтоНедопустимыйТипДоговораНДС"] Тогда
			Текст = НСтр("ru='Заполнение документа ""Счет-фактура полученный"" на основании документа ""Поступление услуг, работ"" отменено.
			|В документе-основании ""Поступление услуг, работ"" указан договор, у которого тип для целей НДС ""%1"".
			|
			|На основании такого документа ""Поступление услуг, работ"" следует заполнять иной документ: ""Счет-фактура выданный"".'");
			
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, РезультатШапка["ТипДоговораНДС"]);
			Возврат;
		Иначе
			// Заполняем документ.
			
			Если ИзТаблицы Тогда
				ЗаполнитьЗначенияСвойств(Объект, РезультатШапка, "КодВидаОперации,ПричинаНалогообложения");
				
				// Добавляем строки в табличную часть:
				Для Каждого ОчереднаяСтрока Из РезультатСоставНФА Цикл
					НоваяСтрока = Объект["СоставНФА"].Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ОчереднаяСтрока);
				КонецЦикла;
				
			Иначе
				// Шапка счета-фактуры:
				ЗаполнитьЗначенияСвойств(Объект, РезультатШапка);
				
				// Список документов-оснований:
				ДокументыОснования = Объект["ДокументыОснования"];
				ДокументыОснования.Очистить();
				НоваяСтрока = ДокументыОснования.Добавить();
				НоваяСтрока["ДокументОснование"] = ДокументОснованиеСсылка;
				
				// Загружаем табличную часть целиком:
				Объект["СоставНФА"].Загрузить(РезультатСоставНФА);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

