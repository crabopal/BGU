Процедура ЗаполнитьКолонкуСчетВычетКт(ШапкаДокумента, ТаблицаСоставНФА)
	
	ОбъектСтруктура = Новый Структура();
	ОбъектСтруктура.Вставить("Организация",				ШапкаДокумента["Организация"]);
	ОбъектСтруктура.Вставить("ПричинаНалогообложения",	ШапкаДокумента["ПричинаНалогообложения"]);
	ОбъектСтруктура.Вставить("Дата",					ШапкаДокумента["Дата"]);
	ОбъектСтруктура.Вставить("ИФО",						ШапкаДокумента["ИФО"]);
	
	Для Каждого СтрокаТаблицы Из ТаблицаСоставНФА Цикл
		ОбъектСтруктура.Вставить("КФО", СтрокаТаблицы["КФО"]);
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ОбъектСтруктура);
		
		СчетВычетКт = ?(СтрокаТаблицы["НДСКРаспределению"],
			ПрименяемаяИнструкцияСтруктура["СчетВычетКтКРаспределениюПоУмолчанию"],
			ПрименяемаяИнструкцияСтруктура["СчетВычетКтБезРаспределенияПоУмолчанию"]);
		СтрокаТаблицы["СчетВычетКт"] = СчетВычетКт;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТаблицуАвансовВыданных(ДокументОснования, ПоляОтбораИзШапкиСФ)
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаДляВводаНаОсновании();
	
	СпискиОтбора = ПолучитьСпискиОтбора(ПоляОтбораИзШапкиСФ, ПараметрыПоиска);
	
	ТаблицаАвансов = ПрочитатьПроводкиАвансовВыданных(ДокументОснования, СпискиОтбора, ПараметрыПоиска);
	
	Возврат ТаблицаАвансов;
	
КонецФункции

Функция ПрочитатьПроводкиАвансовВыданных(СписокДокументовОснований, СпискиОтбора, ПараметрыПоиска)
	
	НаДату = Неопределено;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Счет20600",							БухгалтерскийУчетКлиентСервер.СчетПоКоду("206.00", НаДату));
	ЗапросПоиск.УстановитьПараметр("СчетаКредита",						БухгалтерскийУчетКлиентСервер.СписокСчетов("201.00,304.05", НаДату));
	ЗапросПоиск.УстановитьПараметр("СписокДокументовОснований",			СписокДокументовОснований);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоДоговору",		СпискиОтбора.ИспользоватьОтборПоДоговору);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоКонтрагенту",	СпискиОтбора.ИспользоватьОтборПоКонтрагенту);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	СпискиОтбора.ИспользоватьОтборПоПодразделению);
	ЗапросПоиск.УстановитьПараметр("СписокДоговоров",					СпискиОтбора.СписокДоговоров);
	ЗапросПоиск.УстановитьПараметр("СписокКонтрагентов",				СпискиОтбора.СписокКонтрагентов);
	ЗапросПоиск.УстановитьПараметр("СписокПодразделений",				СпискиОтбора.СписокПодразделений);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Регистратор											КАК ДокументОснование,
	|	КФО													КАК КФО,
	|	СчетДт												КАК Счет,
	|	КПСДт												КАК КПС,
	|	ВЫБОР
	|		КОГДА СубконтоДт1 ССЫЛКА Справочник.Контрагенты ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.Контрагенты)
	|		КОГДА СубконтоДт2 ССЫЛКА Справочник.Контрагенты ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Контрагенты)
	|		КОГДА СубконтоДт3 ССЫЛКА Справочник.Контрагенты ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДт3 КАК Справочник.Контрагенты)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ												КАК Контрагент,
	|	ВЫБОР
	|		КОГДА СубконтоДт1 ССЫЛКА Справочник.Договоры ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.Договоры)
	|		КОГДА СубконтоДт2 ССЫЛКА Справочник.Договоры ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Договоры)
	|		КОГДА СубконтоДт3 ССЫЛКА Справочник.Договоры ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДт3 КАК Справочник.Договоры)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ												КАК Договор,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			ЕСТЬNULL(ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ												КАК Подразделение,
	|	СУММА(Сумма)										КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		Регистратор В(&СписокДокументовОснований)
	|		И СчетДт В ИЕРАРХИИ(&Счет20600)
	|		И СчетКт В ИЕРАРХИИ(&СчетаКредита)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКонтрагенту И СубконтоДт1 ССЫЛКА Справочник.Контрагенты ТОГДА
	|				ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.Контрагенты) В(&СписокКонтрагентов)
	|			КОГДА &ИспользоватьОтборПоКонтрагенту И СубконтоДт2 ССЫЛКА Справочник.Контрагенты ТОГДА
	|				ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Контрагенты) В(&СписокКонтрагентов)
	|			КОГДА &ИспользоватьОтборПоКонтрагенту И СубконтоДт3 ССЫЛКА Справочник.Контрагенты ТОГДА
	|				ВЫРАЗИТЬ(СубконтоДт3 КАК Справочник.Контрагенты) В(&СписокКонтрагентов)
	|			ИНАЧЕ
	|				НЕ &ИспользоватьОтборПоКонтрагенту
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоДоговору И СубконтоДт1 ССЫЛКА Справочник.Договоры ТОГДА
	|				ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.Договоры) В(&СписокДоговоров)
	|			КОГДА &ИспользоватьОтборПоДоговору И СубконтоДт2 ССЫЛКА Справочник.Договоры ТОГДА
	|				ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Договоры) В(&СписокДоговоров)
	|			КОГДА &ИспользоватьОтборПоДоговору И СубконтоДт3 ССЫЛКА Справочник.Договоры ТОГДА
	|				ВЫРАЗИТЬ(СубконтоДт3 КАК Справочник.Договоры) В(&СписокДоговоров)
	|			ИНАЧЕ
	|				НЕ &ИспользоватьОтборПоДоговору
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоПодразделению ТОГДА
	|				ЕСТЬNULL(ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) В(&СписокПодразделений)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)
	|СГРУППИРОВАТЬ ПО
	|	Регистратор,
	|	КФО,
	|	СчетДт,
	|	КПСДт,
	|	ВЫБОР
	|		КОГДА СубконтоДт1 ССЫЛКА Справочник.Контрагенты ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.Контрагенты)
	|		КОГДА СубконтоДт2 ССЫЛКА Справочник.Контрагенты ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Контрагенты)
	|		КОГДА СубконтоДт3 ССЫЛКА Справочник.Контрагенты ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДт3 КАК Справочник.Контрагенты)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ,
