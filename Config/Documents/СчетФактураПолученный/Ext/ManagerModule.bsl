	|			ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Договоры)
	|		КОГДА СубконтоДт3 ССЫЛКА Справочник.Договоры ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДт3 КАК Справочник.Договоры)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			ЕСТЬNULL(ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьСпискиОтбора(ПоляОтбораИзШапкиСФ, ПараметрыПоиска)
	
	СпискиОтбора = Новый Структура();
	
	СпискиОтбора.Вставить("ИспользоватьОтборПоДоговору",		Ложь);
	СпискиОтбора.Вставить("ИспользоватьОтборПоКонтрагенту",		Ложь);
	СпискиОтбора.Вставить("ИспользоватьОтборПоПодразделению",	Ложь);
	
	СпискиОтбора.Вставить("СписокДоговоров",		Новый Массив());
	СпискиОтбора.Вставить("СписокКонтрагентов",		Новый Массив());
	СпискиОтбора.Вставить("СписокПодразделений",	Новый Массив());
	
	Если ТипЗнч(ПоляОтбораИзШапкиСФ) = Тип("Структура") Тогда
		Если ЗначениеЗаполнено(ПоляОтбораИзШапкиСФ.Договор) Тогда
			СпискиОтбора.СписокДоговоров.Добавить(ПоляОтбораИзШапкиСФ.Договор);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПоляОтбораИзШапкиСФ.Контрагент) Тогда
			СпискиОтбора.СписокКонтрагентов.Добавить(ПоляОтбораИзШапкиСФ.Контрагент);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПоляОтбораИзШапкиСФ.Подразделение) Тогда
			СпискиОтбора.СписокПодразделений.Добавить(ПоляОтбораИзШапкиСФ.Подразделение);
		КонецЕсли;
		
		СпискиОтбора.ИспользоватьОтборПоДоговору		= СпискиОтбора.СписокДоговоров.Количество() > 0;
		СпискиОтбора.ИспользоватьОтборПоКонтрагенту		= СпискиОтбора.СписокКонтрагентов.Количество() > 0;
		СпискиОтбора.ИспользоватьОтборПоПодразделению	= ПараметрыПоиска.ИспользоватьУчетПоПодразделениям
			И СпискиОтбора.СписокПодразделений.Количество() > 0;
	КонецЕсли;
	
	Возврат СпискиОтбора;
	
КонецФункции

Процедура ЗаполнитьТабличнуюЧастьСоставНФАДляАвансаВыданного(Объект, ТаблицаАвансов, ДокументОснования, СтавкаНДСИзПлатежногоДокумента = Неопределено)
	
	Счет30304 = ПланыСчетов.ЕПСБУ.НайтиПоКоду("303.04");
	
	ПредставлениеПозицииАванса = УчетНДСКлиентСервер.ПолучитьПредставлениеПозицииАванса();
	
	ИменаПолейОтбораИзШапкиСФ = ПолучитьИменаПолейОтбораИзШапкиСФ();
	
	СтавкаНДС = УчетНДСКлиентСервер.ПолучитьСтавкуДляАванса(Объект.Дата, СтавкаНДСИзПлатежногоДокумента);
	
	Для Каждого СтрокаАванса Из ТаблицаАвансов Цикл
		ЗаполнитьЗначенияСвойств(Объект, СтрокаАванса, ИменаПолейОтбораИзШапкиСФ);
		
		НоваяСтрока = Объект.СоставНФА.Добавить();
		
		НоваяСтрока.НФА = ПредставлениеПозицииАванса;
		НоваяСтрока.ДокументОснование = ДокументОснования;			
		НоваяСтрока.Всего = СтрокаАванса.Сумма;
		НоваяСтрока.СтавкаНДС = СтавкаНДС;
		НоваяСтрока.СуммаНДС = СтрокаАванса.Сумма * УчетНДСКлиентСервер.ПолучитьМножительСтавки(СтавкаНДС);
		НоваяСтрока.Сумма = НоваяСтрока.Всего - НоваяСтрока.СуммаНДС;
		НоваяСтрока.НДСКВычету = Истина;
		
		НоваяСтрока.КФО = СтрокаАванса.КФО;
		НоваяСтрока.СчетРасчетов = СтрокаАванса.Счет;
		НоваяСтрока.КПСВычетКт = СтрокаАванса.КПС;
		НоваяСтрока.Счет30304 = Счет30304;			
	КонецЦикла;
	
	ЗаполнитьКолонкуСчетВычетКт(Объект, Объект.СоставНФА);
	
КонецПроцедуры

Процедура СогласоватьЗаполнениеСчетРасчетовАванс(ДокументОбъект)
	
	// Если во всех строках указан одинаковый счет расчетов, то такой счет
	// указываем в реквизите шапки СчетРасчетовАванс, а колонку очищаем.	
	
	ПустойСчет = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	
	ВремТаблица = ДокументОбъект.СоставНФА.Выгрузить(, "СчетРасчетов");
	ВремТаблица.Свернуть("СчетРасчетов");
	
	СчетаРасчетов = ВремТаблица.ВыгрузитьКолонку("СчетРасчетов");
	
	Индекс = СчетаРасчетов.Найти(ПустойСчет);
	
	Если Индекс <> Неопределено Тогда
		СчетаРасчетов.Удалить(Индекс);
	КонецЕсли;
	
	Если СчетаРасчетов.Количество() = 0 Тогда
		Возврат;
		
	ИначеЕсли СчетаРасчетов.Количество() = 1 Тогда
		ОбщийСчетРасчетов = СчетаРасчетов[0];
		
	Иначе
		ОбщийСчетРасчетов = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	ДокументОбъект.СчетРасчетовАванс = ОбщийСчетРасчетов;
	
	Если ЗначениеЗаполнено(ОбщийСчетРасчетов) Тогда
		Для Каждого СтрокаТаблицы Из ДокументОбъект.СоставНФА Цикл
			СтрокаТаблицы.СчетРасчетов = ПустойСчет;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьУникальныйПлатежноРасчетныйДокумент(ПлатежноРасчетныеДокументы, Дата, Номер)
	
	Поиск = Новый Структура();
	Поиск.Вставить("ДатаДокумента", НачалоДня(Дата));
	Поиск.Вставить("НомерДокумента", Номер);
	
	МассивСтрок = ПлатежноРасчетныеДокументы.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ПлатежноРасчетныеДокументы.Добавить();
	
	НоваяСтрока.ДатаДокумента = Дата;
	НоваяСтрока.НомерДокумента = Номер;
	
КонецПроцедуры

Функция ПолучитьСписокЗаполненныхОснований(ДокументыОснования)
	
	СписокЗаполненныхОснований = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ДокументыОснования Цикл
		ДокументОснование = СтрокаТаблицы.ДокументОснование;
		
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			Если СписокЗаполненныхОснований.Найти(ДокументОснование) = Неопределено Тогда
				СписокЗаполненныхОснований.Добавить(ДокументОснование);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокЗаполненныхОснований;
	
КонецФункции

Процедура ПроверитьВозможностьСозданияНовогоСчетаФаткуры(Знач Основание, Знач Объект, ОписаниеОшибки, Знач ПоляОтбораИзШапкиСФ)
	
	ПоляПоискаСФ = Новый Соответствие();
	
	Если Не ОбнаруживатьПомеченныеНаУдалениеСчетаФактурыПриВводеНаОсновании() Тогда
		ПоляПоискаСФ.Вставить("Ссылка.ПометкаУдаления", Ложь);
	КонецЕсли;
	
	Если ПоляОтбораИзШапкиСФ <> Неопределено Тогда
		Для Каждого Элемент Из ПоляОтбораИзШапкиСФ Цикл
			ИмяПоля = Элемент.Ключ;
			ЗначениеПоля = Элемент.Значение;
			
			Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
				ПоляПоискаСФ.Вставить(СтрШаблон("Ссылка.%1", ИмяПоля), ЗначениеПоля);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ПоляПоискаСФ.Количество() = 0 Тогда
		ОтборПоискаСФ = Неопределено;
	Иначе
		ОтборПоискаСФ = Новый Структура();
		ОтборПоискаСФ.Вставить("СчетФактураПолученный", ПоляПоискаСФ);
	КонецЕсли;
	
	НайденныйДокумент = УчетНДС.НайтиПодчиненныйСчетФактуру(Основание, "СчетФактураПолученный", ОтборПоискаСФ);
	
	Отказ = НайденныйДокумент <> Неопределено И НайденныйДокумент <> Объект.Ссылка;
	
	Если Отказ Тогда
		ОписаниеОшибки = СтрШаблон(НСтр("ru='На основании документа уже сформирован счет-фактура %1'"), НайденныйДокумент);
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьДокументНаОснованииОтчетКомиссионера(Знач ДокументОснованиеСсылка, Объект, ИзТаблицы, ОписаниеОшибки)
	
	// Возвращаемое значение:
	Перем ЗаполнениеВыполнено;
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_РеквизитыТиповойОперации	= БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументОснованиеСсылка,
		"СчетУчетаНДС,СчетУчетаНДСКРаспределению");
	
	КПСДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснованиеСсылка,"КПСРасчетов");
	
	// Настраиваем запрос:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокОснованиеСсылка",			ДокументОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("Счет30304",					БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("303.04"));
	ЗапросЗаполнение.УстановитьПараметр("СчетУчетаНДС",					Основание_РеквизитыТиповойОперации["СчетУчетаНДС"]);
	ЗапросЗаполнение.УстановитьПараметр("СчетУчетаНДСКРаспределению",	Основание_РеквизитыТиповойОперации["СчетУчетаНДСКРаспределению"]);
	ЗапросЗаполнение.УстановитьПараметр("КПСВычетКт",					КПСДокумента);
	
	ЗапросЗаполнение.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОтчетКомиссионера.Организация КАК Организация,
	|	ОтчетКомиссионера.Дата КАК Дата,
	|	ОтчетКомиссионера.ИФО КАК ИФО,
	|	ОтчетКомиссионера.Подразделение КАК Подразделение,
	|	ОтчетКомиссионера.Контрагент КАК Контрагент,
	|	ОтчетКомиссионера.Договор КАК Договор,
	|	ОтчетКомиссионера.ВалютаДокумента КАК ВалютаДокумента,
	|	""01"" КАК КодВидаОперации,
	|	ОтчетКомиссионера.Договор.ТипДоговораНДС КАК ТипДоговораНДС,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Покупка) КАК ПричинаНалогообложения,
	|	ОтчетКомиссионера.Ссылка КАК ДокументОснование,
	|	ОтчетКомиссионера.УслугаПоВознаграждению КАК НФА,
	|	ОтчетКомиссионера.УслугаПоВознаграждению.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	1 КАК Количество,
	|	ВЫБОР
	|		КОГДА ОтчетКомиссионера.СуммаВключаетНДС
	|			ТОГДА ОтчетКомиссионера.СуммаВознаграждения - ОтчетКомиссионера.СуммаНДСВознаграждения
	|		ИНАЧЕ ОтчетКомиссионера.СуммаВознаграждения
	|	КОНЕЦ КАК Сумма,
	|	ОтчетКомиссионера.СтавкаНДСВознаграждения КАК СтавкаНДС,
	|	ОтчетКомиссионера.СуммаНДСВознаграждения КАК СуммаНДС,
	|	ОтчетКомиссионера.СуммаВознаграждения КАК Всего,
	|	ОтчетКомиссионера.ПринятьНДСКВычету КАК НДСКВычету,
	|	ОтчетКомиссионера.РаспределяетсяНДС КАК НДСКРАспределению,
	|	ОтчетКомиссионера.КФО КАК КФО,
	|	ВЫБОР
	|		КОГДА ОтчетКомиссионера.РаспределяетсяНДС
	|			ТОГДА &СчетУчетаНДСКРаспределению
	|		ИНАЧЕ &СчетУчетаНДС
	|	КОНЕЦ КАК СчетВычетКт,
	|	&КПСВычетКт КАК КПСВычетКт,
	|	&Счет30304 КАК Счет30304
	|ИЗ
	|	Документ.ОтчетКомиссионера КАК ОтчетКомиссионера
	|ГДЕ
	|	ОтчетКомиссионера.Ссылка = &ДокОснованиеСсылка";
	
	// Выполняем запросы:
	РезультатыЗаполнения	= ЗапросЗаполнение.Выполнить().Выгрузить();
	
	Шапка = РезультатыЗаполнения[0];
	
	Если не ИзТаблицы тогда
		Объект.ДокументыОснования.Очистить();
		
		НоваяСтрока = Объект.ДокументыОснования.Добавить();
		НоваяСтрока.ДокументОснование = ДокументОснованиеСсылка;
		
		ЗаполнитьЗначенияСвойств(Объект, Шапка);
		
	КонецЕсли;	
	
	СтрокаНФА = Объект.СоставНФА.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаНФА, Шапка);
	ЗаполнитьКолонкуСчетВычетКт(Объект, Объект["СоставНФА"]);
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ФормаВводаНаОсновании

Функция ПолучитьСписокТиповДокументовНесколькоНаОснованииОдного()
	
	// Используется при стандартном вводе на основании.
	
	СписокТипов = Новый Массив();
	
	// В нескольких проводках может быть несколько различных подразделений и договоров.
	СписокТипов.Добавить(Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход"));
	СписокТипов.Добавить(Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная"));
	СписокТипов.Добавить(Тип("ДокументСсылка.КассовоеВыбытие"));
	СписокТипов.Добавить(Тип("ДокументСсылка.ПлатежноеПоручение"));
	СписокТипов.Добавить(Тип("ДокументСсылка.РасходныйКассовыйОрдер"));
	СписокТипов.Добавить(Тип("ДокументСсылка.РСКППеречисление"));
	
	Возврат СписокТипов;
	
КонецФункции

Функция ВозможенВводНесколькихДокументовНаОснованииОдного(Основание)
	
	СписокТипов = ПолучитьСписокТиповДокументовНесколькоНаОснованииОдного();
	
	Возврат (СписокТипов.Найти(ТипЗнч(Основание)) <> Неопределено);
	
КонецФункции

Функция НовыйДанныеДляПередачиНаФормуВводаНаОсновании()
	
	Возврат Новый Структура("
		|СчетФактураСсылка,
		|ОтборИзШапкиСФ,
		|ТаблицыОснований,
		|ТаблицыНесопоставленныхСчетовФактур,
		|СпискиЗначенийОтбораИзШапкиСФ");
	
КонецФункции

Функция ПолучитьДанныеОснованийТребующиеУточнения(СписокДокументовОснований, ОтборИзШапкиСФ)
	
	// Проводки одного документа-основания могут иметь различную аналитику по контрагенту, договору, подразделению,
	// и такой набор данных не может быть помещен в один документ счета-фактуры.
	// Необходимо формировать несколько документов счетов-фактур по такому документу-основанию.
	// Перед формированием счетов-фактур необходимо уточнить (выбрать) аналитику, по которой будет выполнено формирование.
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаДляВводаНаОсновании();
	
	Если ОтборИзШапкиСФ <> Неопределено Тогда
		ИсключитьСчетФактуру = ОтборИзШапкиСФ.Ссылка;
		ПоляОтбораИзШапкиСФ = ОтборИзШапкиСФ.ПоляОтбора;
	Иначе
		ПоляОтбораИзШапкиСФ = Неопределено;
		ИсключитьСчетФактуру = Неопределено;
	КонецЕсли;
	
	СпискиОтбора = ПолучитьСпискиОтбора(ПоляОтбораИзШапкиСФ, ПараметрыПоиска);
	
	ТаблицаСчетовФактур = ПолучитьСчетаФактуры(СписокДокументовОснований, СпискиОтбора, ПараметрыПоиска, ИсключитьСчетФактуру);
	
	СписокТаблицОснований = Новый Массив();
	
	ДобавитьАвансыТребующиеУточнения(СписокТаблицОснований, СписокДокументовОснований, СпискиОтбора, ПараметрыПоиска);
	
	СписокНесопоставленныхСчетовФактур = Новый Массив();
	
	Для Каждого ТаблицаОснования Из СписокТаблицОснований Цикл
		НесопоставленныеСчетаФактуры = Новый ТаблицаЗначений();
		
		ЗаполнитьКолонкуСчетФактура(ТаблицаОснования, ТаблицаСчетовФактур, НесопоставленныеСчетаФактуры);
		
		Если НесопоставленныеСчетаФактуры.Количество() > 0 Тогда
			СписокНесопоставленныхСчетовФактур.Добавить(НесопоставленныеСчетаФактуры);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицыОснований = ПреобразоватьСписокТаблицОснованийВСоответствие(СписокТаблицОснований);
	
	ТаблицыНесопоставленныхСчетовФактур = ПреобразоватьСписокТаблицОснованийВСоответствие(СписокНесопоставленныхСчетовФактур);
	
	Если ОтборИзШапкиСФ <> Неопределено Тогда
		СпискиЗначенийОтбораИзШапкиСФ = ПолучитьСпискиЗначенийОтбораИзШапкиСФ(ТаблицыОснований, ОтборИзШапкиСФ);
	Иначе
		СпискиЗначенийОтбораИзШапкиСФ = Неопределено;
	КонецЕсли;
	
	Данные = Новый Структура();
	Данные.Вставить("ТаблицыОснований", ТаблицыОснований);
	Данные.Вставить("ТаблицыНесопоставленныхСчетовФактур", ТаблицыНесопоставленныхСчетовФактур);
	Данные.Вставить("СпискиЗначенийОтбораИзШапкиСФ", СпискиЗначенийОтбораИзШапкиСФ);
	
	Возврат Данные;
	
КонецФункции

Процедура ДобавитьАвансыТребующиеУточнения(СписокТаблицОснований, СписокДокументовОснований, СпискиОтбора, ПараметрыПоиска)
	
	ТаблицаОснования = ПрочитатьПроводкиАвансовВыданных(СписокДокументовОснований, СпискиОтбора, ПараметрыПоиска);
	
	ТаблицаОснования.Свернуть("ДокументОснование,Договор,Контрагент,Подразделение", "Сумма");
	
	Если БолееОднойАналитики(ТаблицаОснования) Тогда
		СписокТаблицОснований.Добавить(ТаблицаОснования);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСчетаФактуры(СписокДокументовОснований, СпискиОтбора, ПараметрыПоиска, ИсключитьСчетФактуру)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокДокументовОснований",			СписокДокументовОснований);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоДоговору",		СпискиОтбора.ИспользоватьОтборПоДоговору);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоКонтрагенту",	СпискиОтбора.ИспользоватьОтборПоКонтрагенту);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	СпискиОтбора.ИспользоватьОтборПоПодразделению);
	ЗапросПоиск.УстановитьПараметр("СписокДоговоров",					СпискиОтбора.СписокДоговоров);
	ЗапросПоиск.УстановитьПараметр("СписокКонтрагентов",				СпискиОтбора.СписокКонтрагентов);
	ЗапросПоиск.УстановитьПараметр("СписокПодразделений",				СпискиОтбора.СписокПодразделений);
	ЗапросПоиск.УстановитьПараметр("ИсключитьСчетФактуру",				ИсключитьСчетФактуру);
	ЗапросПоиск.УстановитьПараметр("ВыбиратьПомеченныеНаУдаление",		ОбнаруживатьПомеченныеНаУдалениеСчетаФактурыПриВводеНаОсновании());
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка												КАК Ссылка,
	|	Док.Контрагент											КАК Контрагент,
	|	Док.Договор												КАК Договор,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			Док.Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ													КАК Подразделение,
	|	СведенияОснований.ДокументОснование						КАК ДокументОснование,
	|	СведенияОснований.Всего									КАК Всего
	|ИЗ
	|	Документ.СчетФактураПолученный КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ (
	|		ВЫБРАТЬ
	|			Ссылка				КАК Ссылка,
	|			ДокументОснование	КАК ДокументОснование,
	|			СУММА(Всего)		КАК Всего
	|		ИЗ
	|			(ВЫБРАТЬ
	|				ТЧСоставНФА.Ссылка				КАК Ссылка,
	|				ТЧСоставНФА.ДокументОснование	КАК ДокументОснование,
	|				ТЧСоставНФА.Всего				КАК Всего
	|			ИЗ
	|				Документ.СчетФактураПолученный.СоставНФА КАК ТЧСоставНФА
	|			ГДЕ
	|				ТЧСоставНФА.ДокументОснование В(&СписокДокументовОснований)
	|			
	|			ОБЪЕДИНИТЬ ВСЕ
	|			
	|			ВЫБРАТЬ
	|				ТЧДокументыОснования.Ссылка				КАК Ссылка,
	|				ТЧДокументыОснования.ДокументОснование	КАК ДокументОснование,
	|				0										КАК Всего
	|			ИЗ
	|				Документ.СчетФактураПолученный.ДокументыОснования КАК ТЧДокументыОснования
	|			ГДЕ
	|				ТЧДокументыОснования.ДокументОснование В(&СписокДокументовОснований)) КАК ВсеОснования
	|		СГРУППИРОВАТЬ ПО
	|			Ссылка,
	|			ДокументОснование) КАК СведенияОснований
	|		ПО	Док.Ссылка = СведенияОснований.Ссылка
	|ГДЕ
	|	НЕ Док.Ссылка = &ИсключитьСчетФактуру
	|	И ВЫБОР
	|		КОГДА &ВыбиратьПомеченныеНаУдаление ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			НЕ Док.ПометкаУдаления
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоКонтрагенту ТОГДА
	|			Док.Контрагент В(&СписокКонтрагентов)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоДоговору ТОГДА
	|			Док.Договор В(&СписокДоговоров)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоПодразделению ТОГДА
	|			ЕСТЬNULL(Док.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) В(&СписокПодразделений)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ		
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Функция БолееОднойАналитики(ТаблицаОснования)
	
	ИменаПолей = ПолучитьИменаПолейОтбораИзШапкиСФ();
	
	СвернутаяТаблица = ТаблицаОснования.Скопировать();
	СвернутаяТаблица.Свернуть(ИменаПолей);
	
	Возврат (СвернутаяТаблица.Количество() > 1);
	
КонецФункции

Функция ПолучитьПараметрыПоискаДляВводаНаОсновании()
	
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	Возврат ПараметрыПоиска;
	
КонецФункции

Процедура ЗаполнитьКолонкуСчетФактура(ТаблицаОснования, Знач ТаблицаСчетовФактур, НесопоставленныеСчетаФактуры)
	
	ТаблицаОснования.Колонки.Добавить("СчетФактура", Новый ОписаниеТипов("ДокументСсылка.СчетФактураПолученный"));
	
	НесопоставленныеСчетаФактуры = ТаблицаОснования.СкопироватьКолонки("ДокументОснование,Контрагент,Договор,Подразделение,Сумма,СчетФактура");
	НесопоставленныеСчетаФактуры.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка"));
	
	ТаблицаСчетовФактур.Колонки.Добавить("Сопоставлен", Новый ОписаниеТипов("Булево"));
	
	ПоискСФ = Новый Структура("ДокументОснование,Контрагент,Договор,Подразделение,Всего");
	
	Для Каждого СтрокаТаблицы Из ТаблицаОснования Цикл
		ЗаполнитьЗначенияСвойств(ПоискСФ, СтрокаТаблицы);
		
		ПоискСФ.Всего = СтрокаТаблицы.Сумма;
		
		МассивСтрок = ТаблицаСчетовФактур.НайтиСтроки(ПоискСФ);
		
		Если МассивСтрок.Количество() > 0 Тогда
			СтрокаТаблицы.СчетФактура = МассивСтрок[0].Ссылка;
		КонецЕсли;
		
		Для Каждого СтрокаТаблицыСчетовФактур Из МассивСтрок Цикл
			СтрокаТаблицыСчетовФактур.Сопоставлен = Истина;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаПоиска = Новый ТаблицаЗначений();
	ТаблицаПоиска.Колонки.Добавить("КоличествоОтличающихсяПолей", ОбщегоНазначения.ОписаниеТипаЧисло(2, 0, ДопустимыйЗнак.Неотрицательный));
	ТаблицаПоиска.Колонки.Добавить("ОтличающиесяПоля", Новый ОписаниеТипов("Массив"));
	
	ПараметрыПоискаОтличающихсяПолей = Новый Структура();
	ПараметрыПоискаОтличающихсяПолей.Вставить("ТаблицаПоиска", ТаблицаПоиска);
	ПараметрыПоискаОтличающихсяПолей.Вставить("ПроверяемыеПоля", СтрРазделить("Контрагент,Договор,Подразделение,Сумма", ", ", Ложь));
	
	ПоискСопоставлен = Новый Структура("Сопоставлен", Ложь);
	
	МассивСтрок = ТаблицаСчетовФактур.НайтиСтроки(ПоискСопоставлен);
	
	Для Каждого СтрокаТаблицыСчетовФактур Из МассивСтрок Цикл
		НоваяСтрока = НесопоставленныеСчетаФактуры.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыСчетовФактур);
		
		НоваяСтрока.СчетФактура = СтрокаТаблицыСчетовФактур.Ссылка;
		НоваяСтрока.Сумма = СтрокаТаблицыСчетовФактур.Всего;
		
		ЗаполнитьКомментарийНесопоставленногоСчетаФактуры(НоваяСтрока, ТаблицаОснования, ПараметрыПоискаОтличающихсяПолей);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКомментарийНесопоставленногоСчетаФактуры(СтрокаТаблицыНесопоставленногоСчетаФактуры, ТаблицаОснования, ПараметрыПоискаОтличающихсяПолей)
	
	ТаблицаПоиска	= ПараметрыПоискаОтличающихсяПолей.ТаблицаПоиска;
	ПроверяемыеПоля	= ПараметрыПоискаОтличающихсяПолей.ПроверяемыеПоля;
	
	ТаблицаПоиска.Очистить();
	
	Для Каждого СтрокаТаблицыОснования Из ТаблицаОснования Цикл
		ОтличающиесяПоля = ОпределитьОтличающиесяПоля(СтрокаТаблицыНесопоставленногоСчетаФактуры, СтрокаТаблицыОснования, ПроверяемыеПоля);
		
		Если ОтличающиесяПоля.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаПоиска.Добавить();
		НоваяСтрока.КоличествоОтличающихсяПолей = ОтличающиесяПоля.Количество();
		НоваяСтрока.ОтличающиесяПоля = ОтличающиесяПоля;
	КонецЦикла;
	
	ТаблицаПоиска.Сортировать("КоличествоОтличающихсяПолей Возр");
	
	Если ТаблицаПоиска.Количество() = 0 Тогда
		Комментарий = НСтр("ru='Отличается заполнение'");
	Иначе
		Комментарий = СтрШаблон(НСтр("ru='Отличается %1'"), СтрСоединить(ТаблицаПоиска[0].ОтличающиесяПоля, ", "));
	КонецЕсли;
	
	СтрокаТаблицыНесопоставленногоСчетаФактуры.Комментарий = Комментарий;
	
КонецПроцедуры

Функция ОпределитьОтличающиесяПоля(СтрокаТаблицыНесопоставленногоСчетаФактуры, СтрокаТаблицыОснования, ПроверяемыеПоля)
	
	ОтличающиесяПоля = Новый Массив();
	
	Для Каждого ИмяПоля Из ПроверяемыеПоля Цикл
		Если СтрокаТаблицыНесопоставленногоСчетаФактуры[ИмяПоля] <> СтрокаТаблицыОснования[ИмяПоля] Тогда
			ОтличающиесяПоля.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОтличающиесяПоля;
	
КонецФункции

Функция ПреобразоватьСписокТаблицОснованийВСоответствие(СписокТаблиц)
	
	ТаблицыОснований = Новый Соответствие();
	
	Для Каждого Таблица Из СписокТаблиц Цикл
		
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			ДокументОснование = СтрокаТаблицы.ДокументОснование;
			
			ТекущаяТаблицаОснования = ТаблицыОснований.Получить(ДокументОснование);
			
			Если ТекущаяТаблицаОснования = Неопределено Тогда
				ТекущаяТаблицаОснования = Таблица.СкопироватьКолонки();
			КонецЕсли;
			
			НоваяСтрока = ТекущаяТаблицаОснования.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
			ТаблицыОснований.Вставить(ДокументОснование, ТекущаяТаблицаОснования);
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицыОснований;
	
КонецФункции

Функция ПолучитьСпискиЗначенийОтбораИзШапкиСФ(ТаблицыОснований, ОтборИзШапкиСФ)
	
	СпискиЗначений = Новый Структура();
	
	Для Каждого Элемент Из ОтборИзШапкиСФ.ПоляОтбора Цикл
		ИмяПоля = Элемент.Ключ;
		ЗначениеПоля = Элемент.Значение;
		
		Если Не ЗначениеЗаполнено(ЗначениеПоля) Тогда
			СпискиЗначений.Вставить(ИмяПоля, Новый Массив());
		КонецЕсли;
	КонецЦикла;
	
	Если СпискиЗначений.Количество() = 0 Тогда
		Возврат СпискиЗначений;
	КонецЕсли;
	
	Для Каждого Элемент Из ТаблицыОснований Цикл
		ТаблицаОснования = Элемент.Значение;
		
		Для Каждого СтрокаТаблицы Из ТаблицаОснования Цикл
			Для Каждого Элемент Из СпискиЗначений Цикл
				ИмяПоля = Элемент.Ключ;
				СписокЗначений = Элемент.Значение;
				
				ЗначениеПоля = СтрокаТаблицы[ИмяПоля];
				
				Если ЗначениеЗаполнено(ЗначениеПоля) И СписокЗначений.Найти(ЗначениеПоля) = Неопределено Тогда
					СписокЗначений.Добавить(ЗначениеПоля);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СпискиЗначений;
	
КонецФункции

#КонецОбласти

#Область Движения

Функция ПолучитьТабличнуюЧастьСоставНФА(СтруктураШапкиДокумента, ОперацияДокумента)
	
	Курс = ?(ЗначениеЗаполнено(ОперацияДокумента.Курс), ОперацияДокумента.Курс, 1);
	Кратность = ?(ЗначениеЗаполнено(ОперацияДокумента.Кратность), ОперацияДокумента.Кратность, 1);
	
	ПричиныНалогообложенияНалоговыйАгент = УчетНДСПовтИсп.ПолучитьПричиныНалогообложенияНалоговыйАгент();
	
	ЭтоНалоговыйАгент = (ПричиныНалогообложенияНалоговыйАгент.Найти(СтруктураШапкиДокумента.ПричинаНалогообложения) <> Неопределено);
	
	ДляКнигиПокупок = НЕ ЭтоНалоговыйАгент;
	
	ЗапросВыборка = Новый Запрос();
	ЗапросВыборка.УстановитьПараметр("ДокументСсылка",							СтруктураШапкиДокумента.Ссылка);
	ЗапросВыборка.УстановитьПараметр("Курс",									Курс);
	ЗапросВыборка.УстановитьПараметр("Кратность",								Кратность);
	ЗапросВыборка.УстановитьПараметр("ДляКнигиПокупок",							ДляКнигиПокупок);
	ЗапросВыборка.УстановитьПараметр("ЗаполнитьВалютныеСуммы",					УчетНДС.СледуетЗаполнитьВалютныеСуммы());
	ЗапросВыборка.УстановитьПараметр("ПричиныНалогообложенияНалоговыйАгент",	ПричиныНалогообложенияНалоговыйАгент);
	ЗапросВыборка.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Табличная часть СоставНФА
	|//
	|ВЫБРАТЬ
	|	НомерСтроки															КАК НомерСтроки,
	|	ДокументОснование													КАК ДокументОснование,
	|	ЕСТЬNULL(ДокументОснование.Дата, Ссылка.ДатаПервичногоДокумента)	КАК ДатаОснования,
	|	Ссылка.СчетРасчетовАванс											КАК СчетРасчетовАванс,
	|	НФА																	КАК НФА,
	|	КФО																	КАК КФО,
	|	СчетВычетКт															КАК СчетКредита,
	|	КПСВычетКт															КАК КПСВычетКт,
	|	СчетРасчетов														КАК СчетРасчетов,
	|	КПСВычетКт															КАК КПССчетРасчетов,
	|	НДСКРаспределению													КАК НДСКРаспределению,
	|	СтавкаНДС															КАК СтавкаНДС,
	|	НДСКВычету															КАК НДСКВычету,
	|	ВЫРАЗИТЬ(Всего * &Курс / &Кратность КАК ЧИСЛО(15,2))				КАК Всего,
	|	ВЫРАЗИТЬ((Всего - СуммаНДС) * &Курс / &Кратность КАК ЧИСЛО(15,2))	КАК СуммаБезНДС,
	|	ВЫРАЗИТЬ(СуммаНДС * &Курс / &Кратность КАК ЧИСЛО(15,2))				КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			Всего
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ																КАК ВсегоВалютная,
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			Всего - СуммаНДС
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ																КАК СуммаБезНДСВалютная,
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			СуммаНДС
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ																КАК СуммаНДСВалютная
	|ИЗ
	|	Документ.СчетФактураПолученный.СоставНФА
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|	И ВЫБОР
	|		КОГДА &ДляКнигиПокупок ТОГДА
	|			НДСКВычету = ИСТИНА
	|		ИНАЧЕ
	|			// Для книги продаж
	|			Ссылка.ПричинаНалогообложения В(&ПричиныНалогообложенияНалоговыйАгент)
	|	КОНЕЦ
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";
	
	ТаблицаСоставНФА = ЗапросВыборка.Выполнить().Выгрузить();
	
	УчетНДС.ЗаполнитьВидЦенности(ТаблицаСоставНФА, СтруктураШапкиДокумента.ПричинаНалогообложения);
	
	ТаблицаСоставНФА.Колонки.Найти("ДокументОснование").Имя = "ОбъектНалогообложения";
	
	Возврат ТаблицаСоставНФА;
	
КонецФункции

Функция СформироватьДвижения(СтруктураШапкиДокумента, ТаблицаДанных, Движения)
	
	Результат = Истина;
	
	ПричиныНалогообложенияНалоговыйАгент = УчетНДСПовтИсп.ПолучитьПричиныНалогообложенияНалоговыйАгент();
	
	ЭтоНалоговыйАгент = (ПричиныНалогообложенияНалоговыйАгент.Найти(СтруктураШапкиДокумента.ПричинаНалогообложения) <> Неопределено);
	
	Если ЭтоНалоговыйАгент Тогда
		//---
		// Совместимость с БГУ1
		//---
		// Если это счет-фактура налогового агента, то следует начислить НДС в бюджет и зарегистрироваться
		// в книге продаж или доп. листе книги продаж
		Для каждого ТекСтрока из ТаблицаДанных Цикл
			Если СтруктураШапкиДокумента.РегистрацияВДопЛисте Тогда
				Если НЕ СформироватьДвижениеПоРН_ДопЛистКнигиПродаж(Движения, СтруктураШапкиДокумента, ТекСтрока) Тогда
					Возврат Ложь;
				КонецЕсли;	
			Иначе	
				Если НЕ СформироватьДвижениеПоРН_КнигаПродаж(Движения, СтруктураШапкиДокумента, ТекСтрока) Тогда
					Возврат Ложь;
				КонецЕсли;	
			КонецЕсли;	
			
			Если ТекСтрока["НДСКВычету"] Тогда
				Регистр = ?(ТекСтрока["НДСКРаспределению"], Движения.ВходящийНДСКРаспределению, Движения.ВходящийНДС);
				
				Если НЕ СформироватьДвижениеПоРН_ВходящийНДС(Регистр, СтруктураШапкиДокумента, ТекСтрока) Тогда
					Возврат Ложь;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
		
		Возврат Истина;
	ИначеЕсли СтруктураШапкиДокумента.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансВыданный
		ИЛИ СтруктураШапкиДокумента.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера Тогда
		Для каждого ТекСтрока из ТаблицаДанных Цикл
			
			Если СтруктураШапкиДокумента.РегистрацияВДопЛисте Тогда
				Если НЕ СформироватьДвижениеПоРН_ДопЛист(Движения, СтруктураШапкиДокумента, ТекСтрока, ТекСтрока.ДатаОснования) Тогда
					Возврат Ложь;
				КонецЕсли;	
			Иначе
				Если НЕ СформироватьДвижениеПоРН_КнигаПокупок(Движения, СтруктураШапкиДокумента, ТекСтрока, ТекСтрока.ДатаОснования) Тогда
					Возврат Ложь;
				КонецЕсли;	
			КонецЕсли;	
			
			СформироватьДвиженияПоРН_ИсходящийНДС(Движения, СтруктураШапкиДокумента, ТекСтрока);
		КонецЦикла;	
		
		Возврат Истина;
	КонецЕсли;	
	
//******************************************	
	
	Для каждого ТекСтрока из ТаблицаДанных Цикл
		// Если ВидЦенности = ОС, то все ложим либо в РН: НДС_Входящий, либо РН: НДС_КРаспределению
		
//		Если ТекСтрока.ВидЦенности = Перечисления.ВидыЦенностейНДС.ОС Тогда
//			Если ТекСтрока["НДСКРаспределению"] Тогда
//				Если НЕ СформироватьДвижениеПоРН_ВходящийНДС(Движения.ВходящийНДСКРаспределению, СтруктураШапкиДокумента, ТекСтрока) Тогда
//					Возврат Ложь;
//				КонецЕсли;	
//			Иначе	
//				//ТекДвижения = ДвиженияВходящийНДС;
//				Если СтруктураШапкиДокумента.РегистрацияВДопЛисте Тогда
//					Если НЕ СформироватьДвижениеПоРН_ДопЛист(Движения, СтруктураШапкиДокумента, ТекСтрока, ТекСтрока.ДатаОснования) Тогда
//						Возврат Ложь;
//					КонецЕсли;	
//				Иначе
//					Если НЕ СформироватьДвижениеПоРН_ВходящийНДС(Движения.ВходящийНДС, СтруктураШапкиДокумента, ТекСтрока) Тогда
//						Возврат Ложь;
//					КонецЕсли;	
//				КонецЕсли;	
//			КонецЕсли;	
//			
//		ИначеЕсли  СтруктураШапкиДокумента.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Покупка или
		Если СтруктураШапкиДокумента.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Покупка или
			СтруктураШапкиДокумента.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаПокупкуОтКомиссионера или
			СтруктураШапкиДокумента.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ВозвратОтПокупателя Тогда
			
			Если ТекСтрока["НДСКРаспределению"] Тогда
				Если НЕ СформироватьДвижениеПоРН_ВходящийНДС(Движения.ВходящийНДСКРаспределению, СтруктураШапкиДокумента, ТекСтрока) Тогда
					Возврат Ложь;
				КонецЕсли;	
			Иначе	
				Если СтруктураШапкиДокумента.РегистрацияВДопЛисте Тогда
					Если НЕ СформироватьДвижениеПоРН_ДопЛист(Движения, СтруктураШапкиДокумента, ТекСтрока, ТекСтрока.ДатаОснования) Тогда
						Возврат Ложь;
					КонецЕсли;	
				Иначе
					Если НЕ СформироватьДвижениеПоРН_КнигаПокупок(Движения, СтруктураШапкиДокумента, ТекСтрока, ТекСтрока.ДатаОснования) Тогда
						Возврат Ложь;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
			
		Иначе	
			Если ТекСтрока["НДСКРаспределению"] Тогда
				Если НЕ СформироватьДвижениеПоРН_ВходящийНДС(Движения.ВходящийНДСКРаспределению, СтруктураШапкиДокумента, ТекСтрока) Тогда
					Возврат Ложь;
				КонецЕсли;	
			Иначе	
				Если СтруктураШапкиДокумента.РегистрацияВДопЛисте Тогда
					Если НЕ СформироватьДвижениеПоРН_ДопЛист(Движения, СтруктураШапкиДокумента, ТекСтрока, ТекСтрока.ДатаОснования) Тогда
						Возврат Ложь;
					КонецЕсли;	
				Иначе
					// Политика "По оплате", нет регистрации в доп. листе, НДС не к распределению.
					// Надо еще проверить если это поступление через подотчетное лицо, то будем считать, что
					// поставка оплачена
					Если ЗначениеЗаполнено(ТекСтрока.СчетРасчетов) ТОгда
						Если БухгалтерскийУчет.СчетВИерархии(ТекСтрока.СчетРасчетов, "208.00") Тогда
							Если НЕ СформироватьДвижениеПоРН_КнигаПокупок(Движения, СтруктураШапкиДокумента, ТекСтрока, ТекСтрока.ДатаОснования) Тогда
								Возврат Ложь;
							КонецЕсли;	
						Иначе
							Если НЕ СформироватьДвижениеПоРН_ВходящийНДС(Движения.ВходящийНДС, СтруктураШапкиДокумента, ТекСтрока) Тогда
								Возврат Ложь;
							КонецЕсли;	
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЦикла;	
	
	
	Возврат Результат;
КонецФункции	

Функция СформироватьДвижениеПоРН_КнигаПродаж(Движения, СтруктураШапкиДокумента, ТекСтрока)
	
	Движение = Движения.КнигаПродаж.Добавить();
	ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения");
	ЗаполнитьЗначенияСвойств(Движение, ТекСтрока, "КФО, СтавкаНДС, СуммаБезНДС, СуммаНДС, СуммаБезНДСВалютная, СуммаНДСВалютная");
	
	Движение.Период      = УчетНДСВызовСервера.ДатаФормированияДвиженияВРегистреНДС(СтруктураШапкиДокумента);
	Движение.СчетФактура = СтруктураШапкиДокумента.Ссылка;
	
	Возврат Истина;
	
КонецФункции	

Функция СформироватьДвижениеПоРН_ДопЛистКнигиПродаж(Движения, СтруктураШапкиДокумента, ТекСтрока)
	
	Движение = Движения.ДополнительныеЛистыКнигиПродаж.Добавить();
	ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения, КорректируемыйПериод");
	ЗаполнитьЗначенияСвойств(Движение, ТекСтрока, "КФО, СтавкаНДС, СуммаБезНДС, СуммаНДС, СуммаБезНДСВалютная, СуммаНДСВалютная");
	
	Движение.Период      = УчетНДСВызовСервера.ДатаФормированияДвиженияВРегистреНДС(СтруктураШапкиДокумента);
	Движение.СчетФактура = СтруктураШапкиДокумента.Ссылка;
	
	Возврат Истина;
	
КонецФункции	

Функция СформироватьДвиженияПоРН_ИсходящийНДС(Движения, СтруктураШапкиДокумента, ТекСтрока)
	
	Движение = Движения.ИсходящийНДС.Добавить();
	ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения");
	ЗаполнитьЗначенияСвойств(Движение, ТекСтрока, "КФО, СтавкаНДС, СуммаБезНДС, СуммаНДС, СуммаБезНДСВалютная, СуммаНДСВалютная");
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("СчетРасчетов", ?(ЗначениеЗаполнено(ТекСтрока.СчетРасчетов), ТекСтрока.СчетРасчетов, СтруктураШапкиДокумента.СчетРасчетовАванс));
	ЗначенияПараметров.Вставить("КПССчетРасчетов",	ТекСтрока.КПСВычетКт);
	
	ЗаполнитьЗначенияСвойств(Движение, ЗначенияПараметров);
	
	Движение.ВидДвижения            = ВидДвиженияНакопления.Приход;
	Движение.Период                 = УчетНДСВызовСервера.ДатаФормированияДвиженияВРегистреНДС(СтруктураШапкиДокумента);
	
	Движение.СчетФактура            = СтруктураШапкиДокумента.Ссылка;
	Движение.ОбъектНалогообложения  = ?(ТекСтрока.ОбъектНалогообложения = Неопределено,СтруктураШапкиДокумента.Ссылка,ТекСтрока.ОбъектНалогообложения);
	
	Движение.СчетДебета             = ТекСтрока.СчетКредита;
	Движение.КОСГУСчетДебета        = БухгалтерскийУчет.КЭКСчета(СтруктураШапкиДокумента.Организация, СтруктураШапкиДокумента.ИФО, ТекСтрока.КФО, СтруктураШапкиДокумента.Дата, Движение.СчетДебета, "Дт");
	
	Возврат Истина;
	
КонецФункции	

Функция СформироватьДвижениеПоРН_ВходящийНДС(Движения, СтруктураШапкиДокумента, ТекСтрока)
	
	Если ТекСтрока.СуммаНДС = 0 И НЕ УчетНДСКлиентСервер.РегистрироватьВычетПриНулевойСуммеНалога() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Движение = Движения.Добавить();
	
	ЗаполнитьЗначенияСвойств(Движение, ТекСтрока);
	
	Движение.ВидДвижения            = ВидДвиженияНакопления.Приход;
	Движение.Период                 = УчетНДСВызовСервера.ДатаФормированияДвиженияВРегистреНДС(СтруктураШапкиДокумента);
	Движение.Организация            = СтруктураШапкиДокумента.Организация;
	Движение.КФО                    = ТекСтрока.КФО;
	Движение.СчетФактура            = СтруктураШапкиДокумента.Ссылка;
	Движение.ОбъектНалогообложения  = ?(ТекСтрока.ОбъектНалогообложения = Неопределено,СтруктураШапкиДокумента.Ссылка,ТекСтрока.ОбъектНалогообложения);
	Движение.ПричинаНалогообложения = СтруктураШапкиДокумента.ПричинаНалогообложения;
	Движение.ВидЦенности 			= ТекСтрока.ВидЦенности;
	
	Возврат Истина;
	
КонецФункции	

Функция СформироватьДвижениеПоРН_КнигаПокупок(Движения, СтруктураШапкиДокумента, ТекСтрока, ДатаОснования)
	
	Если ТекСтрока.СуммаНДС = 0 И НЕ УчетНДСКлиентСервер.РегистрироватьВычетПриНулевойСуммеНалога() Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекСчетКредита = ТекСтрока.СчетКредита;
	Если НЕ ЗначениеЗаполнено(ТекСчетКредита) Тогда
		Возврат Истина;
	КонецЕсли;	
	
	Движение = Движения.КнигаПокупок.Добавить();
	ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения");
	ЗаполнитьЗначенияСвойств(Движение, ТекСтрока, "КФО, ВидЦенности, СтавкаНДС, СуммаНДС, СуммаБезНДС, СуммаНДСВалютная, СуммаБезНДСВалютная");
	
	Движение.Период      = УчетНДСВызовСервера.ДатаФормированияДвиженияВРегистреНДС(СтруктураШапкиДокумента);
	Движение.ДатаСобытия = ДатаОснования;
	Движение.СчетФактура = СтруктураШапкиДокумента.Ссылка;
	Движение.ДатаОплаты		= СтруктураШапкиДокумента.ДатаДокументаОплаты;
	Движение.КодВидаОперации = СтруктураШапкиДокумента.КодВидаОперации;
	
	Возврат Истина;
	
КонецФункции	

Функция СформироватьДвижениеПоРН_ДопЛист(ТекДвижения, СтруктураШапкиДокумента, ТекСтрока, ДатаОснования)
	
	ТекСуммаНДС = ТекСтрока.СуммаНДС;
	ТекСчетКредита = ТекСтрока.СчетКредита;
	Если НЕ ЗначениеЗаполнено(ТекСчетКредита) Тогда
		Возврат Истина;
	КонецЕсли;	
	
	Движение = ТекДвижения.ДополнительныеЛистыКнигиПокупок.Добавить();
	ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокумента, "Организация, ПричинаНалогообложения, КорректируемыйПериод");
	ЗаполнитьЗначенияСвойств(Движение, ТекСтрока, "КФО, СтавкаНДС, ВидЦенности");
	
	Движение.Период      = УчетНДСВызовСервера.ДатаФормированияДвиженияВРегистреНДС(СтруктураШапкиДокумента);
	Движение.СчетФактура = СтруктураШапкиДокумента.Ссылка;
	Движение.ДатаСобытия = ДатаОснования;
	Движение.ДатаОплаты		= СтруктураШапкиДокумента.ДатаДокументаОплаты;
	Движение.КодВидаОперации = СтруктураШапкиДокумента.КодВидаОперации;
	Движение.СуммаБезНДС = ТекСтрока.СуммаБезНДС;
	Движение.СуммаНДС    = ТекСуммаНДС;
	Движение.СуммаБезНДСВалютная = ТекСтрока.СуммаБезНДСВалютная;
	Движение.СуммаНДСВалютная    = ТекСтрока.СуммаНДСВалютная;
	
	Возврат Истина;
	
КонецФункции	

#КонецОбласти

