#Область СчетаФактурыВыданныеПокупателям

Функция НовыйПараметрыЗапросаСчетовФактурВыданныхПокупателям() Экспорт

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ДатаПервичногоДокумента" , Неопределено);
	ПараметрыЗапроса.Вставить("Организация"         	, Неопределено);
	ПараметрыЗапроса.Вставить("ДокументыОснования"       , Неопределено);
	ПараметрыЗапроса.Вставить("Контрагент"        		, Неопределено);
	ПараметрыЗапроса.Вставить("Договор"           		, Неопределено);
	ПараметрыЗапроса.Вставить("ПричинаНалогообложения"  , Неопределено);
	
	Возврат ПараметрыЗапроса;

КонецФункции

Функция СчетаФактурыВыданныеПокупателям(ПараметрыЗапроса) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаПервичногоДокумента"	, ПараметрыЗапроса.ДатаПервичногоДокумента);
	Запрос.УстановитьПараметр("ДокументыОснования"     	, ПараметрыЗапроса.ДокументыОснования);
	Запрос.УстановитьПараметр("Организация"          	, ПараметрыЗапроса.Организация);
	Запрос.УстановитьПараметр("Контрагент"            	, ПараметрыЗапроса.Контрагент);
	Запрос.УстановитьПараметр("Договор"      		  	, ПараметрыЗапроса.Договор);
	
	Если ПараметрыЗапроса.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомитента Тогда
		
		Запрос.Текст = ТекстЗапросаВыданныеСчетаФактурыНаАванс();
		
	ИначеЕсли ПараметрыЗапроса.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаРеализациюОтКомитента Тогда
		
		Запрос.Текст = ТекстЗапросаСчетФактураНаРеализацию();
		
	КонецЕсли;
		
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции 

Функция ТекстЗапросаВыданныеСчетаФактурыНаАванс()
	
	Возврат "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СчетФактураВыданный.Контрагент КАК Покупатель,
	|	СчетФактураВыданный.Ссылка КАК СчетФактура,
	|	СчетФактураВыданный.СуммаДокумента КАК Сумма,
	|	СчетФактураВыданный.СуммаНДС КАК НДС
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.Организация = &Организация
	|	И СчетФактураВыданный.ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученныйКомиссионером)
	|	И НАЧАЛОПЕРИОДА(СчетФактураВыданный.Дата, ДЕНЬ) = &ДатаПервичногоДокумента
	|	И СчетФактураВыданный.Комитент = &Контрагент
	|	И НЕ СчетФактураВыданный.ПометкаУдаления
	|	И СчетФактураВыданный.Проведен";
	
КонецФункции 

Функция ТекстЗапросаСчетФактураНаРеализацию()
	
	Возврат "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РеализацииПоОтчету.Покупатель КАК Покупатель
	|ПОМЕСТИТЬ ПокупателиПоОтчету
	|ИЗ
	|	Документ.ОтчетКомитенту.Товары КАК РеализацииПоОтчету
	|ГДЕ
	|	РеализацииПоОтчету.Ссылка В(&ДокументыОснования)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Покупатель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализованныеТоварыКомитентов.Покупатель КАК Покупатель,
	|	РеализованныеТоварыКомитентов.Субкомиссионер КАК Субкомиссионер,
	|	СУММА(РеализованныеТоварыКомитентов.Выручка) КАК Сумма,
	|	СУММА(РеализованныеТоварыКомитентов.СуммаНДС) КАК НДС,
	|	СчетФактураВыданный.Ссылка КАК СчетФактура
	|ПОМЕСТИТЬ ПродажиПоКомиссии
	|ИЗ
	|	РегистрНакопления.РеализованныеТоварыКомитентов КАК РеализованныеТоварыКомитентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|		ПО РеализованныеТоварыКомитентов.Регистратор = СчетФактураВыданный.ДокументОснование
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПокупателиПоОтчету КАК ПокупателиПоОтчету
	|		ПО РеализованныеТоварыКомитентов.Покупатель = ПокупателиПоОтчету.Покупатель
	|ГДЕ
	|	РеализованныеТоварыКомитентов.ДатаРеализации = &ДатаПервичногоДокумента
	|	И РеализованныеТоварыКомитентов.Активность
	|	И РеализованныеТоварыКомитентов.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И РеализованныеТоварыКомитентов.Контрагент = &Контрагент
	|	И РеализованныеТоварыКомитентов.ДоговорКомитента = &Договор
	|	И РеализованныеТоварыКомитентов.Организация = &Организация
	|	И НЕ РеализованныеТоварыКомитентов.Регистратор ССЫЛКА Документ.ОтчетКомитенту
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализованныеТоварыКомитентов.Покупатель,
	|	РеализованныеТоварыКомитентов.Субкомиссионер,
	|	СчетФактураВыданный.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПродажиПоКомиссии.Покупатель КАК Покупатель,
	|	ПродажиПоКомиссии.Субкомиссионер КАК Субкомиссионер,
	|	ПродажиПоКомиссии.СчетФактура КАК СчетФактура,
	|	ВЫБОР
	|		КОГДА ПродажиПоКомиссии.НДС > 0
	|			ТОГДА ПродажиПоКомиссии.Сумма
	|		ИНАЧЕ ПродажиПоКомиссии.СчетФактура.СуммаДокумента
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА ПродажиПоКомиссии.НДС > 0
	|			ТОГДА ПродажиПоКомиссии.НДС
	|		ИНАЧЕ ПродажиПоКомиссии.СчетФактура.СуммаНДСДокументаКомиссия
	|	КОНЕЦ КАК НДС
	|ИЗ
	|	ПродажиПоКомиссии КАК ПродажиПоКомиссии";
	
КонецФункции

#КонецОбласти

#КонецЕсли
