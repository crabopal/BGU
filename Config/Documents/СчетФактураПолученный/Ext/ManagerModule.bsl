// Печать

Функция ПолучитьДанныеДокументовДляПечати(МассивОбъектов)
	
	ЗапросПечать = Новый Запрос();
	ЗапросПечать.УстановитьПараметр("СсылкиНаДокументы",				МассивОбъектов);
	ЗапросПечать.УстановитьПараметр("ВалютаРУ",							Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросПечать.УстановитьПараметр("ИспользоватьВалютныйУчет", 		ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	ЗапросПечать.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ЗапросПечать.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка										КАК Ссылка,
	|	ВЫБОР
	|		КОГДА	ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.Номенклатура)
	|			ИЛИ ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			ВЫБОР
	|				КОГДА НФА.НаименованиеПолное = """" ТОГДА
	|					НФА.Наименование
	|				ИНАЧЕ
	|					НФА.НаименованиеПолное
	|			КОНЕЦ
	|		ИНАЧЕ
	|			НФА
	|	КОНЕЦ										КАК НоменклатураПредставление,
	|	ЕдиницаИзмерения							КАК ЕдиницаИзмерения,
	|	ЕдиницаИзмерения.Представление				КАК ЕдиницаИзмеренияПредставление,
	|	ЕдиницаИзмерения.Код						КАК ЕдиницаИзмеренияКод,
	|	""""											КАК КодВидаТовара,
	|	Количество									КАК Количество,
	|	ВЫБОР
	|		КОГДА Количество = 0 ТОГДА
	|			Всего - СуммаНДС
	|		ИНАЧЕ
	|			(Всего - СуммаНДС) / Количество
	|	КОНЕЦ										КАК Цена,
	|	(Всего - СуммаНДС)							КАК Стоимость,
	|	СтавкаНДС									КАК СтавкаНДС,
	|	СуммаНДС									КАК СуммаНДС,
	|	Всего										КАК Всего,
	|	СуммаАкциза									КАК Акциз,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.Номенклатура) ТОГДА
	|			НФА.СтранаПроисхождения
	|		ИНАЧЕ
	|			""""
	|	КОНЕЦ										КАК СтранаПроисхождения,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.Номенклатура) ТОГДА
	|			НФА.СтранаПроисхождения.Код
	|		ИНАЧЕ
	|			""""
	|	КОНЕЦ										КАК СтранаПроисхожденияКод,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.Номенклатура) ТОГДА
	|			НФА.СтранаПроисхождения.Наименование
	|		ИНАЧЕ
	|			""""
	|	КОНЕЦ										КАК ПредставлениеСтраны,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Справочник.Номенклатура) ТОГДА
	|			НФА.НомерГТД.Представление
	|		ИНАЧЕ 
	|			""""
	|	КОНЕЦ										КАК ПредставлениеГТД,
	|	Ссылка.ПричинаНалогообложения				КАК ПричинаНалогообложения
	|ИЗ
	|	Документ.СчетФактураПолученный.СоставНФА КАК СоставНФА
	|ГДЕ
	|	Ссылка В(&СсылкиНаДокументы)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные табличной части РасчетноПлатежныеДокументы
	|//
	|ВЫБРАТЬ
	|	Ссылка			КАК ДокСсылка,
	|	ДатаДокумента	КАК ДатаДокумента,
