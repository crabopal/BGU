	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансВыданный)		
	|	КОНЕЦ																КАК ПричинаНалогообложения,	
	|	СтавкаНДС														КАК СтавкаНДС
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер
	|ГДЕ
	|	Ссылка = &Ссылка";
	
	Основание = Запрос.Выполнить().Выгрузить();
	
	Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Основание[0]);
	
	Если ИзТаблицы Тогда
		ЗаполнитьЗначенияСвойств(Объект, Шапка, "КодВидаОперации,ПричинаНалогообложения");
	Иначе
		ЗаполнитьЗначенияСвойств(Объект, Шапка,, "Номер");
		
		НоваяСтрока = Объект.ДокументыОснования.Добавить();
		НоваяСтрока.ДокументОснование = ДокументОснования;
	КонецЕсли;

	ЗаполнитьТабличнуюЧастьСоставНФАДляАвансаВыданного(Объект, ТаблицаАвансов, ДокументОснования, Шапка.СтавкаНДС);
	
	ДобавитьУникальныйПлатежноРасчетныйДокумент(Объект.ПлатежноРасчетныеДокументы,
		Шапка.Дата,
		ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументОснования, Шапка.Номер));
	
КонецПроцедуры

