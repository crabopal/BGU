#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

Функция ЕстьОшибкиЗаполнения(ДокументОбъект, ПрименяемаяИнструкцияСтруктура = Неопределено) Экспорт
	
	Перем РезультатПроверки;
	
	//---
	// Документы остатков НДС
	//---
	Если УчетНДС.ДокументыОстатковНДС_СообщитьЕслиИспользуетсяДляВводаОстатков(ДокументОбъект) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ПрименяемаяИнструкцияСтруктура = Неопределено Тогда
		ОбъектСтруктура = Новый Структура("Дата, ПричинаНалогообложения, КФО");
		ЗаполнитьЗначенияСвойств(ОбъектСтруктура, ДокументОбъект);
		
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ОбъектСтруктура);
	КонецЕсли;
	
	// Проверяем заполненность реквизитов
	ПроверяемыеРеквизиты = Новый Массив();
	ПроверяемыеРеквизиты.Добавить("Организация");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ПроверяемыеРеквизиты.Добавить("ИФО");
	КонецЕсли;
	ПроверяемыеРеквизиты.Добавить("ПричинаНалогообложения");
	ПроверяемыеРеквизиты.Добавить("Контрагент");
	ПроверяемыеРеквизиты.Добавить("НомерПервичногоДокумента");
	ПроверяемыеРеквизиты.Добавить("ДатаПервичногоДокумента");
	
	ПроверяемыеРеквизитыУсловияСоставНФА = Новый Структура();
	
	// Проверяется заполненность только при заполненной сумме налога
	Если ПрименяемаяИнструкцияСтруктура["Вычет"] Тогда
		ПроверяемыеРеквизиты.Добавить("СоставНФА.СчетВычетКт");
		ПроверяемыеРеквизиты.Добавить("СоставНФА.КПСВычетКт");
		ПроверяемыеРеквизиты.Добавить("СоставНФА.КФО");
		ПроверяемыеРеквизиты.Добавить("СоставНФА.Счет30304");
		
		ПроверяемыеРеквизитыУсловияСоставНФА.Вставить("СчетВычетКт",	"НДСКВычету И СуммаНДС <> 0");
		ПроверяемыеРеквизитыУсловияСоставНФА.Вставить("КПСВычетКт",		"НДСКВычету И СуммаНДС <> 0");
		ПроверяемыеРеквизитыУсловияСоставНФА.Вставить("КФО",			"НДСКВычету И СуммаНДС <> 0");
		ПроверяемыеРеквизитыУсловияСоставНФА.Вставить("Счет30304",		"НДСКВычету И СуммаНДС <> 0");
	КонецЕсли;
	
	ПроверяемыеРеквизиты.Добавить("ПлатежноРасчетныеДокументы.ДатаДокумента");
	ПроверяемыеРеквизиты.Добавить("ПлатежноРасчетныеДокументы.НомерДокумента");
	
	ПроверяемыеРеквизитыУсловия = Новый Структура();
	ПроверяемыеРеквизитыУсловия.Вставить("СоставНФА", ПроверяемыеРеквизитыУсловияСоставНФА);
	
	ПараметрыПроверки = Новый Структура("
		|ПроверяемыеРеквизиты,
		|ПроверяемыеРеквизитыУсловия,
		|ВыводитьСообщения",
		ПроверяемыеРеквизиты,
		ПроверяемыеРеквизитыУсловия,
		Истина);
	
	РеквизитыЗаполнены = ОбщегоНазначенияБГУ.УказанныеРеквизитыЗаполнены(
		ДокументОбъект,
		ПараметрыПроверки,
		РезультатПроверки);
	
	ЕстьОшибкиЗаполнения = НЕ РеквизитыЗаполнены;
	
	УчетНДС.ПроверитьДопустимостьВычетаНалогаПоСчетуФактуре(ДокументОбъект, "ДатаПервичногоДокумента", ЕстьОшибкиЗаполнения);
	
	ПроверитьДублиДокументовОснований(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	ПроверитьНаличиеДокументовОснованийВТабличнойЧастиСоставНФА(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

// Заполняет документ по документу основания
//   Основание - Документ на основании которого заполняется
//   Объект    - Сам доккумент 
//	 ИзТаблицы - Если истина то считается что заполнение происходит из табличной части и заголовок документа не заполняется, иначе считается что выполняется ввод на основании	
//   ОписаниеОшибки - описание по какой причине отказ
//   ПоляОтбораИзШапкиСФ - Структура - опциональный отбор
Функция ЗаполнитьНаОсновании(Знач Основание, Объект, ОписаниеОшибки = "", ПоляОтбораИзШапкиСФ = Неопределено) Экспорт
	Отказ = НЕ ЗначениеЗаполнено(Основание);
	Если Отказ Тогда
		ОписаниеОшибки = НСтр("ru='Основание не заполнено'");
		Возврат Ложь;
	КонецЕсли;
	
	Отказ = НЕ Основание.Проведен;
	Если Отказ	Тогда
		ОписаниеОшибки = НСтр("ru='Документ - основание не проведен'");
		Возврат Ложь;
	КонецЕсли;	
	
	Если ТипЗнч(Основание) <> Тип("ДокументСсылка.АвансовыйОтчет") тогда
		ПроверитьВозможностьСозданияНовогоСчетаФаткуры(Основание, Объект, ОписаниеОшибки, ПоляОтбораИзШапкиСФ);
		
		Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗаполнитьПоТипуДокументаОснования(Основание, Объект, ОписаниеОшибки, Ложь, ПоляОтбораИзШапкиСФ) тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(Объект.ВалютаДокумента) тогда
		Объект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	Если Объект.СоставНФА.Количество() = 0 тогда
		ОписаниеОшибки = НСтр("ru='Ввод счета-фактуры на основании отменен.
			|Табличная часть пустая, не содержит строк.
			|Оформление таких счетов-фактур не предусмотрено.'");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

Функция ЗаполнитьДокументНаОснованииАвансовогоОтчета(Знач ДокументОснования, Объект, ИзТаблицы, ОписаниеОшибки = "") Экспорт
	
	// Проверяем наличие уже введенных счетов-фактур
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("Ссылка",					ДокументОснования);
	ЗапросЗаполнение.УстановитьПараметр("НомерПервичногоДокумента",	Объект["НомерПервичногоДокумента"]);
	ЗапросЗаполнение.УстановитьПараметр("ДатаПервичногоДокумента",	Объект["ДатаПервичногоДокумента"]);
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АвансовыйОтчетИзрасходовано.Контрагент			КАК Контрагент,
	|	АвансовыйОтчетИзрасходовано.ДатаСФ				КАК ДатаСФ,
	|	АвансовыйОтчетИзрасходовано.НомерСФ				КАК НомерСФ,
	|	КОЛИЧЕСТВО(АвансовыйОтчетИзрасходовано.Ссылка)	КАК КоличествоСЧФ
	|ПОМЕСТИТЬ
	|	ДанныеПоСЧФ
	|ИЗ
	|	Документ.АвансовыйОтчет.Израсходовано	КАК АвансовыйОтчетИзрасходовано
	|ГДЕ
	|	АвансовыйОтчетИзрасходовано.Ссылка = &Ссылка
	|	И	АвансовыйОтчетИзрасходовано.ПредъявленСФ = ИСТИНА
	|СГРУППИРОВАТЬ ПО
	|	АвансовыйОтчетИзрасходовано.Контрагент,
	|	АвансовыйОтчетИзрасходовано.ДатаСФ,
	|	АвансовыйОтчетИзрасходовано.НомерСФ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СчетФактураПолученный.Ссылка, ЗНАЧЕНИЕ(Документ.СчетФактураПолученный.ПустаяСсылка))	КАК СчетФактура,
	|	ДанныеПоСЧФ.Контрагент,
	|	ДанныеПоСЧФ.ДатаСФ,
	|	ДанныеПоСЧФ.НомерСФ,
	|	ДанныеПоСЧФ.КоличествоСЧФ
	|ИЗ
	|	ДанныеПоСЧФ	КАК ДанныеПоСЧФ
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный	КАК СчетФактураПолученный
	|		ПО	(СчетФактураПолученный.Контрагент = ДанныеПоСЧФ.Контрагент)
	|		И	(СчетФактураПолученный.НомерПервичногоДокумента = ДанныеПоСЧФ.НомерСФ)
	|		И	(СчетФактураПолученный.ВидПервичногоДокумента = ДанныеПоСЧФ.ДатаСФ)";
	
	Если ЗначениеЗаполнено(Объект.НомерПервичногоДокумента) И ЗначениеЗаполнено(Объект.ДатаПервичногоДокумента) Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ГДЕ
		|	СчетФактураПолученный.НомерПервичногоДокумента = &НомерПервичногоДокумента
		|	И СчетФактураПолученный.ДатаПервичногоДокумента = &ДатаПервичногоДокумента";
	КонецЕсли;				   
	ЗапросЗаполнение.Текст = ТекстЗапроса;
	
	Выборка = ЗапросЗаполнение.Выполнить().Выбрать();
	
	ПараметрыОтбора = Новый Структура("Контрагент,ДатаСФ,НомерСФ");
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.СчетФактура) Тогда
			ЗаполнитьЗначенияСвойств(ПараметрыОтбора,Выборка,"Контрагент,ДатаСФ,НомерСФ");
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыОтбора.Контрагент) И НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ОписаниеОшибки = НСтр("ru='По документу авансовый отчет № "+ДокументОснования.Номер+" от "+ ДокументОснования.Дата +" все счета-фактуры входящие сформированы.'");
		Возврат Ложь;
	КонецЕсли;	
	
	// Получаем данные для заполнения нового счета-фактуры
	Если ИзТаблицы Тогда				    
		Контрагент = Объект.Контрагент;
	Иначе
		Контрагент = ПараметрыОтбора.Контрагент;
	КонецЕсли;				   
	Если ИзТаблицы И ЗначениеЗаполнено(Объект.НомерПервичногоДокумента) И ЗначениеЗаполнено(Объект.ДатаПервичногоДокумента) Тогда
		ДатаСФ	= Объект.ДатаПервичногоДокумента;
		НомерСФ	= Объект.НомерПервичногоДокумента;
	Иначе
		ДатаСФ	= ПараметрыОтбора.ДатаСФ;
		НомерСФ	= ПараметрыОтбора.НомерСФ;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПараметрыОтбора["ДатаСФ"]) ИЛИ ПараметрыОтбора["ДатаСФ"] >= '20150101' Тогда
		КодВидаОперации = "23";
	Иначе
		КодВидаОперации = "01";
	КонецЕсли;
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ДокументОснования);
	ЗапросЗаполнение.УстановитьПараметр("ЕдИзмШт",					Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796")); // шт.
	ЗапросЗаполнение.УстановитьПараметр("Счет30304",				ПланыСчетов.ЕПСБУ.НайтиПоКоду("303.04"));
	ЗапросЗаполнение.УстановитьПараметр("Контрагент",				Контрагент);
	ЗапросЗаполнение.УстановитьПараметр("ДатаСФ",					ДатаСФ);
	ЗапросЗаполнение.УстановитьПараметр("НомерСФ",					НомерСФ);
	ЗапросЗаполнение.УстановитьПараметр("КодВидаОперации",			КодВидаОперации);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Дата														КАК Дата,
	|	Организация													КАК Организация,
	|	&Контрагент													КАК Контрагент,
	|	&ДатаСФ														КАК ДатаПервичногоДокумента,
	|	&НомерСФ													КАК НомерПервичногоДокумента,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Покупка)	КАК ПричинаНалогообложения,
	|	&КодВидаОперации											КАК КодВидаОперации,
	|	ИСТИНА														КАК БланкСтрогойОтчетности,
	|	&ДокументОснованиеСсылка									КАК ДокументОснование
	|ИЗ
	|	Документ.АвансовыйОтчет
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДебета1) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДебета1	КАК Справочник.Номенклатура)
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДебета2) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДебета2	КАК Справочник.Номенклатура)
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДебета3) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДебета3	КАК Справочник.Номенклатура)
	|		
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДебета1) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДебета1	КАК Справочник.ОсновныеСредства)
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДебета2) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДебета2	КАК Справочник.ОсновныеСредства)
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДебета3) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДебета3	КАК Справочник.ОсновныеСредства)
	|			
	|		ИНАЧЕ
	|			КомуЗаЧто
	|	КОНЕЦ														КАК НФА,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДебета1) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДебета1	КАК Справочник.Номенклатура).ЕдиницаИзмерения
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДебета2) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДебета2	КАК Справочник.Номенклатура).ЕдиницаИзмерения
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДебета3) = ТИП(Справочник.Номенклатура) ТОГДА
	|			ВЫРАЗИТЬ(СубконтоДебета3	КАК Справочник.Номенклатура).ЕдиницаИзмерения
	|		ИНАЧЕ
	|			&ЕдИзмШт
	|	КОНЕЦ														КАК ЕдиницаИзмерения,
	|	ИСТИНА														КАК НДСКВычету,
	|	НДСКРаспределению											КАК НДСКРаспределению,
	|	КФО															КАК КФО,
	|	КПС															КАК КПСВычетКт,
	|	СтавкаНДС													КАК СтавкаНДС,
	|	&Счет30304													КАК Счет30304,
	|	&ДокументОснованиеСсылка									КАК ДокументОснование,
	|	Количество													КАК Количество,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			Сумма - СуммаНДС
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ														КАК Сумма,
	|	СуммаНДС													КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			Сумма
	|		ИНАЧЕ
	|	        Сумма + СуммаНДС
	|	КОНЕЦ														КАК Всего
	|ИЗ
	|	Документ.АвансовыйОтчет.Израсходовано	КАК АвансовыйОтчетИзрасходовано
	|ГДЕ
	|	Ссылка = &ДокументОснованиеСсылка
	|	И	Контрагент = &Контрагент
	|	И	ДатаСФ = &ДатаСФ
	|	И	НомерСФ = &НомерСФ
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	//	[0]. Данные для реквизитов шапки
	ТаблицаШапка = РезультатыЗаполнения[0].Выгрузить();
	
	//	[1]. Данные для табличной части ""СоставНФА""
	ТаблицаСоставНФА = РезультатыЗаполнения[1].Выгрузить();
	
	Если ТаблицаШапка.Количество() = 0 ИЛИ ТаблицаСоставНФА.Количество() = 0 Тогда
		ОписаниеОшибки = НСтр("ru='Нет данных для заполнения'");
		Возврат Ложь;
	КонецЕсли;
	
	Если ИзТаблицы Тогда
		// Шапка
		ЗаполнитьЗначенияСвойств(Объект, ТаблицаШапка[0]);
	Иначе
		// Шапка
		ЗаполнитьЗначенияСвойств(Объект, ТаблицаШапка[0]);
		
		// Табл.часть "Документы-основания"
		Объект["ДокументыОснования"].Очистить();
		НоваяСтрока = Объект["ДокументыОснования"].Добавить();
		НоваяСтрока["ДокументОснование"] = ДокументОснования;
	КонецЕсли;	
	
	// Табл.часть "Состав НФА"
	Объект["СоставНФА"].Загрузить(ТаблицаСоставНФА);
	ЗаполнитьКолонкуСчетВычетКт(Объект, Объект["СоставНФА"]);
	
	Возврат Истина;
	
КонецФункции	

// Заполняет документ по списку документов-оснований, указанных в табличной части ДокументыОснования.
Функция ОбновитьСоставНФА(Объект, ОписаниеОшибки = "", АдресХранилища) Экспорт
	
	Объект.СоставНФА.Очистить();
	Объект.ПлатежноРасчетныеДокументы.Очистить();
	
	СписокОснований = ПолучитьСписокЗаполненныхОснований(Объект.ДокументыОснования);
	
	Если СписокОснований.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(АдресХранилища) Тогда
		Данные = ПолучитьИзВременногоХранилища(АдресХранилища);
		
		ОтмеченныеСтроки	= Данные.ОтмеченныеСтроки;
		ОтборИзШапкиСФ		= Данные.ОтборИзШапкиСФ;
	Иначе
		ОтмеченныеСтроки	= Неопределено;
		ОтборИзШапкиСФ		= Документы.СчетФактураПолученный.НовыйОтборИзШапкиСФ(Объект);
	КонецЕсли;
	
	ПоляОтбораИзШапкиСФ = ОтборИзШапкиСФ.ПоляОтбора;
	
	ПризнакиПроведения = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СписокОснований, "Проведен");
	
	Для Каждого ДокументОснование Из СписокОснований Цикл
		Проведен = ПризнакиПроведения.Получить(ДокументОснование);
		
		Если Проведен <> Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОтмеченныеСтроки <> Неопределено Тогда
			МассивСтрок = ОтмеченныеСтроки.Получить(ДокументОснование);
			
			Если МассивСтрок = Неопределено Тогда
				// По такому основанию не было отмечено строк в форме ввода на основании,
				// по такому основанию заполнение не выполняем.
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьПоТипуДокументаОснования(ДокументОснование, Объект, ОписаниеОшибки, Истина, ПоляОтбораИзШапкиСФ);
	КонецЦикла;
	
	Если УчетНДСПовтИсп.Аванс(Объект.ПричинаНалогообложения) Тогда
		СогласоватьЗаполнениеСчетРасчетовАванс(Объект);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура СформироватьДвиженияПоРегистрам(ДокументОбъект, Отказ) Экспорт
	Движения = ДокументОбъект.Движения;
	Для каждого РегистрДвижения из Движения цикл
		Если ТипЗнч(РегистрДвижения) <> Тип("РегистрБухгалтерииНаборЗаписей.ЖурналПроводокЕПСБУ")
			И ТипЗнч(РегистрДвижения) <> Тип("РегистрСведенийНаборЗаписей.ОперацииСПрослеживаемымиТоварами") Тогда
			РегистрДвижения.Записывать = Истина;
			РегистрДвижения.Очистить();
		КонецЕсли;	
	КонецЦикла;
	
	ОперацияДокумента = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументОбъект.Ссылка,Новый Структура("КФО,Операция,Курс,Кратность"));
	
	КомиссионныеСчетаФактуры = Ложь;
	Если УчетНДС.ЭтоКомиссионнаяРеализация(ДокументОбъект.ПричинаНалогообложения) 
		ИЛИ УчетНДС.ЭтоКомиссионнаяЗакупка(ДокументОбъект.ПричинаНалогообложения) Тогда
		КомиссионныеСчетаФактуры = Истина;
	КонецЕсли;
	
	//Если ЗначениеЗаполнено(ОперацияДокумента.Операция) тогда
	Если ЗначениеЗаполнено(ОперацияДокумента.Операция) ИЛИ КомиссионныеСчетаФактуры Тогда
		
		СтруктураШапкиДокумента = ОбщегоНазначенияБГУ.СформироватьСтруктуруШапкиДокументаПоСсылке(ДокументОбъект.Ссылка);
		
		ТаблицаДанных = ПолучитьТабличнуюЧастьСоставНФА(СтруктураШапкиДокумента, ОперацияДокумента);
		
		Если НЕ СформироватьДвижения(СтруктураШапкиДокумента, ТаблицаДанных, Движения) Тогда
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ Отказ И НЕ ДокументОбъект.БланкСтрогойОтчетности Тогда
			УчетНДС.ЗарегестрироватьСчетФактуру(ДокументОбъект.Ссылка,Движения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#Область ФормаВводаНаОсновании

Функция ПоместитьВХранилищеОснованияТребующиеУточнения(СписокОснований, СчетФактураСсылка = Неопределено, ОтборИзШапкиСФ = Неопределено, УникальныйИдентификатор = Неопределено) Экспорт
	
	ДанныеОснованийТребующиеУточнения = ПолучитьДанныеОснованийТребующиеУточнения(СписокОснований, ОтборИзШапкиСФ);
	
	АдресХранилища = Неопределено;
	
	Если ДанныеОснованийТребующиеУточнения.ТаблицыОснований.Количество() > 0 Тогда
		ДанныеДляПередачи = НовыйДанныеДляПередачиНаФормуВводаНаОсновании();
		
		ДанныеДляПередачи.СчетФактураСсылка						= СчетФактураСсылка;
		ДанныеДляПередачи.ОтборИзШапкиСФ						= ОтборИзШапкиСФ;
		ДанныеДляПередачи.ТаблицыОснований						= ДанныеОснованийТребующиеУточнения.ТаблицыОснований;
		ДанныеДляПередачи.ТаблицыНесопоставленныхСчетовФактур	= ДанныеОснованийТребующиеУточнения.ТаблицыНесопоставленныхСчетовФактур;
		ДанныеДляПередачи.СпискиЗначенийОтбораИзШапкиСФ			= ДанныеОснованийТребующиеУточнения.СпискиЗначенийОтбораИзШапкиСФ;
		
		АдресХранилища = ПоместитьВоВременноеХранилище(ДанныеДляПередачи, УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат АдресХранилища;
	
КонецФункции

Функция НовыйВозвращаемоеЗначениеИзФормыВводаНаОсновании() Экспорт
	
	Возврат Новый Структура("
		|ОтборИзШапкиСФ,
		|ОтмеченныеСтроки");
	
КонецФункции

Функция НовыйОтборИзШапкиСФ(ДокументОбъект = Неопределено) Экспорт
	
	ОтборИзШапкиСФ = Новый Структура();
	ОтборИзШапкиСФ.Вставить("Ссылка",		Документы.СчетФактураПолученный.ПустаяСсылка());
	ОтборИзШапкиСФ.Вставить("ПоляОтбора",	Новый Структура(ПолучитьИменаПолейОтбораИзШапкиСФ()));
	
	Если ДокументОбъект <> Неопределено Тогда
		ОтборИзШапкиСФ.Ссылка = ДокументОбъект.Ссылка;
		
		ЗаполнитьЗначенияСвойств(ОтборИзШапкиСФ.ПоляОтбора, ДокументОбъект);
	КонецЕсли;
	
	Возврат ОтборИзШапкиСФ;
	
КонецФункции

Функция ПолучитьИменаПолейОтбораИзШапкиСФ() Экспорт
	
	Возврат "Договор,Контрагент,Подразделение";
	
КонецФункции

Функция НовыйСтруктураОснованияИзФормыВводаНаОсновании() Экспорт
	
	СтруктураОснования = Новый Структура();
	СтруктураОснования.Вставить("ВводНаОсновании", Истина);
	СтруктураОснования.Вставить("ФормаВводаНаОсновании", Истина);
	СтруктураОснования.Вставить("ДокументОснование");
	СтруктураОснования.Вставить("ОтборИзШапкиСФ", НовыйОтборИзШапкиСФ());
	
	Возврат СтруктураОснования;
	
КонецФункции

// Проверяет ДанныеЗаполнения на соответствие структуры НовыйСтруктураОснованияИзФормыВводаНаОсновании().
Функция ЭтоСтруктураОснованияИзФормыВводаНаОсновании(ДанныеЗаполнения) Экспорт
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураОснованияОбразец = НовыйСтруктураОснованияИзФормыВводаНаОсновании();
	
	Для Каждого Элемент Из СтруктураОснованияОбразец Цикл
		ИмяСвойства = Элемент.Ключ;
		
		Если Не ДанныеЗаполнения.Свойство(ИмяСвойства) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если ДанныеЗаполнения.ВводНаОсновании <> Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ДанныеЗаполнения.ФормаВводаНаОсновании <> Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Проверяет ДанныеЗаполнения на соответствие структуры НовыйДанныеДляПередачиНаФормуВводаНаОсновании().
Функция ЭтоДанныеДляПередачиНаФормуВводаНаОсновании(Данные) Экспорт
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураОбразец = НовыйДанныеДляПередачиНаФормуВводаНаОсновании();
	
	Для Каждого Элемент Из СтруктураОбразец Цикл
		ИмяСвойства = Элемент.Ключ;
		
		Если Не Данные.Свойство(ИмяСвойства) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ИнициализироватьНовыеКолонки_2_0_30_МонопольныйОбработчик() Экспорт
	
	ИнициализироватьНовыеКолонки_2_0_30();
	
КонецПроцедуры

Процедура ИнициализироватьНовыеКолонки_2_0_30_ОтложенныйОбработчик(Параметры) Экспорт
	
	ИнициализироватьНовыеКолонки_2_0_30(Параметры);
	
КонецПроцедуры

Процедура ИнициализироватьНовыеКолонки_2_0_30(ПараметрыОтложенногоОбработчика = Неопределено)
	
	Перем	ДатаРаздела, // до этой даты - отложенный обработчик, позже - монопольный
			УжеОбработанныеДокументы;
	
	// Настройки массовой обработки документов:
	КоличествоДокументовОбрабатываемыхМонопольноСтрока			= "1000";
	КоличествоДокументовОбрабатываемыхВИтерацииОтложенноСтрока	= "1000";
	
	ЭтоОтложенноеВыполнение = (ТипЗнч(ПараметрыОтложенногоОбработчика) = Тип("Структура"));
	
	Если ЭтоОтложенноеВыполнение Тогда
		РежимЗапускаСтрока					= "(отложенный запуск)";
		ОпределитьДатуРаздела				= НЕ ПараметрыОтложенногоОбработчика.Свойство("ДатаРаздела", ДатаРаздела);
		ВыбратьДокументыНовееУказаннойДаты	= Ложь;
	Иначе
		РежимЗапускаСтрока					= "(монопольный запуск)";
		ОпределитьДатуРаздела				= Истина;
		ВыбратьДокументыНовееУказаннойДаты	= Истина;
	КонецЕсли;
	
	// Определяем дату раздела отложенной и монопольной обработки документов
	Если ОпределитьДатуРаздела Тогда
		ЗапросДатаРаздела = Новый Запрос();
		ЗапросДатаРаздела.Текст = "
		|////////////////////////////////////////////////////////////////////////////////
		|// [0]. Дата самого раннего из N последних документов
		|//
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(Дата)	КАК Дата
		|ИЗ
		|	(ВЫБРАТЬ ПЕРВЫЕ " + КоличествоДокументовОбрабатываемыхМонопольноСтрока + "
		|		Дата
		|	ИЗ
		|		Документ.СчетФактураПолученный
		|	ГДЕ
		|		НЕ Ссылка.ПометкаУдаления
		|	УПОРЯДОЧИТЬ ПО
		|		Дата УБЫВ
		|	)	КАК ВТ
		|;";
		Выборка = ЗапросДатаРаздела.Выполнить().Выбрать();
		ДатаРаздела = Неопределено;
		Пока Выборка.Следующий() Цикл
			ДатаРаздела = Выборка["Дата"];
		КонецЦикла;
		Если НЕ ЗначениеЗаполнено(ДатаРаздела) Тогда
			ДатаРаздела = '00010101'; // приведение типа
		КонецЕсли;
		
		ДатаНачалаТекущегоКвартала = НачалоКвартала(ТекущаяДатаСеанса());
		Если ЗначениеЗаполнено(ДатаРаздела) И ДатаРаздела < ДатаНачалаТекущегоКвартала Тогда
			ДатаРаздела = ДатаНачалаТекущегоКвартала;
		КонецЕсли;
		
		Если ЭтоОтложенноеВыполнение Тогда
			ПараметрыОтложенногоОбработчика.Вставить("ДатаРаздела", ДатаРаздела);
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыОтложенногоОбработчика) = Тип("Структура") Тогда
    	Если НЕ ПараметрыОтложенногоОбработчика.Свойство("УжеОбработанныеДокументы", УжеОбработанныеДокументы) Тогда
			УжеОбработанныеДокументы = Новый Массив();
		КонецЕсли;
	Иначе
		УжеОбработанныеДокументы = Новый Массив();
	КонецЕсли;
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ВыбратьДокументыНовееУказаннойДаты",			ВыбратьДокументыНовееУказаннойДаты);
	ЗапросЗаполнение.УстановитьПараметр("УказаннаяДата",								ДатаРаздела);
	ЗапросЗаполнение.УстановитьПараметр("УжеОбработанныеДокументы",						УжеОбработанныеДокументы);
	ЗапросЗаполнение.УстановитьПараметр("СчетНДСКРаспределению",						БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("210.Н1"));
	ЗапросЗаполнение.УстановитьПараметр("ПричиныНалогообложенияРаспределениеВозможно",	УчетНДСПовтИсп.ПолучитьПричиныНалогообложенияРаспределениеВозможно());
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Документы, подлежащие обработке
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ДокументыПодлежащиеОбработке
	|ИЗ
	|	Документ.СчетФактураПолученный.СоставНФА
	|ГДЕ
	|	НЕ Ссылка В (&УжеОбработанныеДокументы)
	|	И НЕ Ссылка.ПометкаУдаления
	|	И Ссылка.ПричинаНалогообложения В (&ПричиныНалогообложенияРаспределениеВозможно)
	|	И ВЫБОР
	|		КОГДА &ВыбратьДокументыНовееУказаннойДаты ТОГДА
	|			Ссылка.Дата >= &УказаннаяДата
	|		ИНАЧЕ
	|			Ссылка.Дата < &УказаннаяДата
	|	КОНЕЦ
	|	И	СчетВычетКт = &СчетНДСКРаспределению
	|	И	НЕ НДСКРаспределению
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Заполнение колонки НДСКРаспределению
	|//		(Финальная таблица)
	|ВЫБРАТЬ
	|	ДокументыПодлежащиеОбработке.Ссылка		КАК Ссылка,
	|	ВЫБОР
	|		КОГДА СоставНФА.СчетВычетКт = &СчетНДСКРаспределению ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ									КАК НДСКРаспределению
	|ИЗ
	|	ДокументыПодлежащиеОбработке
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	Документ.СчетФактураПолученный.СоставНФА	КАК СоставНФА
	|		ПО	ДокументыПодлежащиеОбработке.Ссылка = СоставНФА.Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	СоставНФА.НомерСтроки
	|ИТОГИ
	|ПО
	|	Ссылка
	|;";
	
	// [1]. Заполнение колонки НДСКРаспределению
	РезультатДокументыСФ = ЗапросЗаполнение.Выполнить();
	
	ВыборкаДокумент = РезультатДокументыСФ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Сведения для вывода в журнал регистрации:
	ИмяСобытия					= НСтр("ru='Данные. Изменение'");
	КомментарийОК 				= НСтр("ru='Успешно обработано документов: %1 - Инициализация новой колонки НДСКРаспределению в документах Счет-фактура полученный'");
	КомментарийОшибка			= НСтр("ru='Ошибок при обработке документов: %1 - Инициализация новой колонки НДСКРаспределению в документах Счет-фактура полученный'");
	КомментарийПропуск			= НСтр("ru='Документов, подлежащих обработке, не обнаружено - Инициализация новой колонки НДСКРаспределению в документах Счет-фактура полученный'");
	КомментарийБлокировка		= НСтр("ru='Не удалось заблокировать документы для модификации - Инициализация новой колонки НДСКРаспределению в документах Счет-фактура полученный'");
	КомментарийОшибкаДокумент	= НСтр("ru='Ошибка при обработке документа (%1) - Инициализация новой колонки НДСКРаспределению в документах Счет-фактура полученный'");
	
	СчетчикДокументовВсего	= ВыборкаДокумент.Количество();
	СчетчикДокументовОК		= 0;
	СчетчикДокументовОшибка	= 0;
	
	Если ЭтоОтложенноеВыполнение Тогда
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Документ.СчетФактураПолученный");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.ИсточникДанных = РезультатДокументыСФ;
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
			Блокировка.Заблокировать();
		Исключение
			// Не удалось заблокировать необходимые документы
			ОтменитьТранзакцию();
			Комментарий = КомментарийБлокировка + ". " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + РежимЗапускаСтрока;
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				,									// объект метаданных
				,									// данные
				Комментарий);						// комментарий
			// Выходим:
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	
	Пока ВыборкаДокумент.Следующий() Цикл
		Попытка
			ДокументОбъект = ВыборкаДокумент["Ссылка"].ПолучитьОбъект();
			Если ДокументОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТЧСоставНФА = ДокументОбъект["СоставНФА"];
			
			// Заполняем новую колонку
			ВыборкаСоставНФА = ВыборкаДокумент.Выбрать();
			ИндексСтроки = -1;
			Пока ВыборкаСоставНФА.Следующий() Цикл
				ИндексСтроки = ИндексСтроки + 1;
				ЗаполнитьЗначенияСвойств(ТЧСоставНФА[ИндексСтроки], ВыборкаСоставНФА);
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			
			СчетчикДокументовОК = СчетчикДокументовОК + 1;
			
			УжеОбработанныеДокументы.Добавить(ВыборкаДокумент["Ссылка"]);
			Если ТипЗнч(ПараметрыОтложенногоОбработчика) = Тип("Структура") Тогда
				ПараметрыОтложенногоОбработчика.Вставить("УжеОбработанныеДокументы", УжеОбработанныеДокументы);
			КонецЕсли;
			
		Исключение
			СчетчикДокументовОшибка = СчетчикДокументовОшибка + 1;
			ПоследняяОшибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			Если ЭтоОтложенноеВыполнение Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			
			Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(КомментарийОшибкаДокумент,
				Строка(ВыборкаДокумент["Ссылка"])) + ". " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
				+ РежимЗапускаСтрока;
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				,									// объект метаданных
				,									// данные
				Комментарий);						// комментарий
				
			УжеОбработанныеДокументы.Добавить(ВыборкаДокумент["Ссылка"]);
			Если ТипЗнч(ПараметрыОтложенногоОбработчика) = Тип("Структура") Тогда
				ПараметрыОтложенногоОбработчика.Вставить("УжеОбработанныеДокументы", УжеОбработанныеДокументы);
			КонецЕсли;
			
			// Выходим:
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
	Если ЭтоОтложенноеВыполнение Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
	Если ЭтоОтложенноеВыполнение Тогда
		ОбработкаЗавершена = (СчетчикДокументовВсего = 0);
		ПараметрыОтложенногоОбработчика.Вставить("ОбработкаЗавершена", ОбработкаЗавершена);
	КонецЕсли;
	
	// Сообщения в журнале регистрации
	
	Если СчетчикДокументовВсего = 0 Тогда
		Комментарий = КомментарийПропуск + РежимЗапускаСтрока;
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если СчетчикДокументовОК > 0 Тогда
		Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(КомментарийОК, Строка(СчетчикДокументовОК))
			+ РежимЗапускаСтрока;
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если СчетчикДокументовОшибка > 0 Тогда
		Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(КомментарийОшибка, Строка(СчетчикДокументовОшибка))
			+ ". Последняя ошибка: " + ПоследняяОшибка + РежимЗапускаСтрока;
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Ошибка,		// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.СчетФактураПолученный";
	КомандаПечати.Идентификатор		= "СчетФактураАвто";
	КомандаПечати.Представление		= НСтр("ru='Счет-фактура'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ИдентификаторПостановления = Неопределено;
	
	ИмяМакета = "СчетФактураАвто";
	
	СинонимМакета = "Счет-фактура";
	
	СтруктураПараметровОбработчика = Новый Структура();
	СтруктураПараметровОбработчика.Вставить("МассивОбъектов",	МассивОбъектов);
	СтруктураПараметровОбработчика.Вставить("ПараметрыПечати",	ПараметрыПечати);
	СтруктураПараметровОбработчика.Вставить("ОбъектыПечати",	ОбъектыПечати);
	СтруктураПараметровОбработчика.Вставить("ПараметрыВывода",	ПараметрыВывода);
	
	ДанныеДокументов = ПолучитьДанныеДокументовДляПечати(СтруктураПараметровОбработчика["МассивОбъектов"]);
	
	ТабДокумент = УчетНДС.ПечатьСчетаФактуры(
		ДанныеДокументов,
		СтруктураПараметровОбработчика,
		ИдентификаторПостановления);
	
	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		СинонимМакета,
		ТабДокумент);
		
КонецПроцедуры

// СтандартныеПодсистемы.РаботаСКонтрагентами
Процедура СформироватьОписаниеДокументовСКонтрагентомВШапке(Описание, ДокументСсылка, ДокументОбъект, Форма) Экспорт
	
	ПроверкаКонтрагентов.ДополнитьОписание(
		Описание, 
		ДокументСсылка, 
		Форма.Элементы["Контрагент"],
		ДокументОбъект["Контрагент"],
		Форма.Элементы["ГруппаКонтрагент"]);
	
КонецПроцедуры
// Конец СтандартныеПодсистемы.РаботаСКонтрагентами 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Перем Основание;
	
	ЭтоВводНаОсновании = (ВидФормы = "ФормаОбъекта" И Параметры.Свойство("Основание", Основание));
	
	Если Не ЭтоВводНаОсновании Тогда
		Возврат;
	КонецЕсли;
	
	Если ВозможенВводНесколькихДокументовНаОснованииОдного(Основание) Тогда
		АдресХранилища = ПоместитьВХранилищеОснованияТребующиеУточнения(Основание);
		
		Если ЭтоАдресВременногоХранилища(АдресХранилища) Тогда
			СтандартнаяОбработка = Ложь;
			
			ВыбраннаяФорма = "ФормаВводаНаОсновании";
			
			Параметры.Вставить("АдресХранилища",	АдресХранилища);
			Параметры.Вставить("ИзФормыОбъекта",	Ложь);
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбнаруживатьПомеченныеНаУдалениеСчетаФактурыПриВводеНаОсновании()
	
	Возврат Ложь;
	
КонецФункции

Процедура ПроверитьДублиДокументовОснований(ДокументОбъект, ЕстьОшибкиЗаполнения)
	
	ТаблицаДублиСтрок = ОбщегоНазначенияБГУ.НайтиДублиСтрок(ДокументОбъект.ДокументыОснования, "ДокументОснование");
	
	Если ТаблицаДублиСтрок.Количество() > 0 Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ПараметрыВывода = ОбщегоНазначенияБГУ.ПараметрыВыводаСообщенийОДубляхСтрок();
		ПараметрыВывода.ТаблицаИмя					= "ДокументыОснования";
		ПараметрыВывода.ТаблицаПредставление		= Метаданные.Документы.СчетФактураПолученный.ТабличныеЧасти.ДокументыОснования.Синоним;
		ПараметрыВывода.ОбъектСсылка				= ДокументОбъект.Ссылка;
		ПараметрыВывода.ИмяПоляДляВыводаСообщений	= "ДокументОснование";
		
		ОбщегоНазначенияБГУ.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьНаличиеДокументовОснованийВТабличнойЧастиСоставНФА(ДокументОбъект, ЕстьОшибкиЗаполнения)
	
	// Каждый документ из табличной части "Документы-основания"
	// должен быть указан в табличной части "Состав НФА".
	
	// В обратную сторону проверка не проводится, табличная часть "Документы-основания"
	// дозаполняется автоматически принудительно при записи документа.
	
	Если ДокументОбъект.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаРеализациюОтКомитента
		Или ДокументОбъект.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомитента Тогда
		Возврат;
	КонецЕсли;
	
	Поиск = Новый Структура("ДокументОснование");
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.ДокументыОснования Цикл
		ДокументОснование = СтрокаТаблицы.ДокументОснование;
		
		Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
			Продолжить;
		КонецЕсли;
		
		Поиск.ДокументОснование = ДокументОснование;
		
		МассивСтрок = ДокументОбъект.СоставНФА.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Справочно: Документ-основание %1 не указан в табличной части ""Товары, работы, услуги""'"),
				ДокументОснование);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ДокументыОснования", СтрокаТаблицы.НомерСтроки, "ДокументОснование"),
				"Объект");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#Область ЗаполнениеНаОсновании

Функция ЗаполнитьПоТипуДокументаОснования(Знач Основание, Объект, ОписаниеОшибки, Знач ИзТаблицы, Знач ПоляОтбораИзШапкиСФ)
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураПолученный");
	
	ТипДанныхЗаполнения	= ТипЗнч(Основание);
	
	Если ТипДанныхЗаполнения = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		ЗаполнитьДокументНаОснованииПоступлениеМЗ(Основание, Объект, ИзТаблицы, ОписаниеОшибки);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
		ЗаполнитьДокументНаОснованииПоступлениеУслугРабот(Основание, Объект, ИзТаблицы, ОписаниеОшибки);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ПоступлениеУслугРаботПоСчетамУчетаЗатрат") Тогда
		ЗаполнитьДокументНаОснованииПоступлениеУслугРаботПоСчетамУчетаЗатрат(Основание, Объект, ИзТаблицы, ОписаниеОшибки);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ПоступлениеОС") Тогда
		ЗаполнитьДокументНаОснованииПоступлениеОС(Основание, "ПоступлениеОС", Объект, ИзТаблицы);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ПоступлениеОСВПути") Тогда
		ЗаполнитьДокументНаОснованииПоступлениеОС(Основание, "ПоступлениеОСВПути", Объект, ИзТаблицы);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ПоступлениеМЗВПути") Тогда
		ЗаполнитьДокументНаОснованииПоступлениеМЗВПути(Основание, Объект, ИзТаблицы);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
		ЗаполнитьДокументНаОснованииСчетФактураПолученный(Основание, Объект, ИзТаблицы);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход") Тогда
		ЗаполнитьДокументНаОснованииЗаявкаНаКассовыйРасход(Основание, Объект, ИзТаблицы, ОписаниеОшибки, ПоляОтбораИзШапкиСФ);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная") Тогда
		ЗаполнитьДокументНаОснованииЗаявкаНаКассовыйРасходСокращенная(Основание, Объект, ИзТаблицы, ОписаниеОшибки, ПоляОтбораИзШапкиСФ);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ПлатежноеПоручение") Тогда
		ЗаполнитьДокументНаОснованииПлатежноеПоручение(Основание, Объект, ИзТаблицы, ОписаниеОшибки, ПоляОтбораИзШапкиСФ);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.КассовоеВыбытие") Тогда
		ЗаполнитьДокументНаОснованииКассовоеВыбытие(Основание, Объект, ИзТаблицы, ОписаниеОшибки, ПоляОтбораИзШапкиСФ);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		ЗаполнитьДокументНаОснованииРасходныйКассовыйОрдер(Основание, Объект, ИзТаблицы, ОписаниеОшибки, ПоляОтбораИзШапкиСФ);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.РСКППеречисление") Тогда
		ЗаполнитьДокументНаОснованииРСКППеречисление(Основание, Объект, ИзТаблицы, ОписаниеОшибки, ПоляОтбораИзШапкиСФ);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.АвансовыйОтчет") Тогда
		ЗаполнениеВыполнено = ЗаполнитьДокументНаОснованииАвансовогоОтчета(Основание, Объект, ИзТаблицы, ОписаниеОшибки);
		
		ДополнительныеПараметры.Вставить("ДокументОснование", Основание);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ОтчетКомиссионера") Тогда
		ЗаполнениеВыполнено = ЗаполнитьДокументНаОснованииОтчетКомиссионера(Основание, Объект, ИзТаблицы, ОписаниеОшибки);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Код вида операции
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Объект, ДополнительныеПараметры);
	Объект["КодВидаОперации"] = КодВидаОперации;
	
	//
	// Счет расчетов
	//
	Если УчетНДСПовтИсп.Аванс(Объект.ПричинаНалогообложения) Тогда
		Если Не ИзТаблицы Тогда
			СогласоватьЗаполнениеСчетРасчетовАванс(Объект);
		КонецЕсли;
	Иначе
		СоставНФА = Объект.СоставНФА.Выгрузить();
		
		УчетНДС.ЗаполнитьСчетРасчетов(СоставНФА);
		
		Объект.СоставНФА.Загрузить(СоставНФА);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ЗаполнитьДокументНаОснованииПоступлениеМЗ(Знач ДокументОснованиеСсылка, ЗаполняемыйДокумент, Знач ИзТаблицы, ОписаниеОшибки)
	
	Если НЕ УчетНДС.ДопустимВводСФНаОснованииПоступления(ДокументОснованиеСсылка, ОписаниеОшибки) Тогда
		Возврат;
	КонецЕсли;
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_РеквизитыТиповойОперации	= БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументОснованиеСсылка,
		"СчетУчетаНДСКРаспределению,СчетУчетаНДС");
	
	Счет30304 = ПланыСчетов.ЕПСБУ.НайтиПоКоду("303.04");
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("Ссылка",						ДокументОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("СчетУчетаНДСКРаспределению",	Основание_РеквизитыТиповойОперации["СчетУчетаНДСКРаспределению"]);
	ЗапросЗаполнение.УстановитьПараметр("СчетУчетаНДС",					Основание_РеквизитыТиповойОперации["СчетУчетаНДС"]);
	ЗапросЗаполнение.УстановитьПараметр("Счет30304",					Счет30304);
	ЗапросЗаполнение.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступлениеМЗ.Ссылка,
	|	ПоступлениеМЗ.Дата,
	|	ПоступлениеМЗ.Организация,
	|	ПоступлениеМЗ.ИФО,
	|	ПоступлениеМЗ.Подразделение,
	|	ПоступлениеМЗ.Контрагент,
	|	ПоступлениеМЗ.Договор,
	|	ПоступлениеМЗ.ВалютаДокумента,
	|	ПоступлениеМЗ.Материалы.(
	|		Ссылка КАК ДокументОснование,
	|		Номенклатура КАК НФА,
	|		Количество,
	|		ВЫБОР
	|			КОГДА Ссылка.СуммаВключаетНДС Тогда
	|				Сумма - СуммаНДС
	|			ИНАЧЕ
	|				Сумма
	|		КОНЕЦ		КАК Сумма,
	|		СтавкаНДС,
	|		СуммаНДС,
	|		Всего,
	|		ЕдиницаИзмерения,
	|		НДСКРаспределению,
	|		ВЫБОР
	|			КОГДА ПоступлениеМЗ.Материалы.КомиссионнаяТорговля ТОГДА
	|				ЛОЖЬ
	|			КОГДА Ссылка.ПринятьНДСКВычетуУказываетсяВСтроках ТОГДА
	|				ПринятьНДСКВычету
	|			ИНАЧЕ
	|				Ссылка.ПринятьНДСКВычету
	|		КОНЕЦ	КАК НДСКВычету,
	|		КФО		КАК КФО,
	|		КомиссионнаяТорговля	КАК КомиссионнаяТорговля,
	|		ВЫБОР
	|			КОГДА Ссылка.НесколькоКПСРасчетов И КПСРасчетов <> ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) ТОГДА
	|				КПСРасчетов
	|			КОГДА Ссылка.КПСРасчетов <> ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) ТОГДА
	|				Ссылка.КПСРасчетов
	|			ИНАЧЕ
	|				КПС
	|		КОНЕЦ КАК КПСВычетКт,
	|		ВЫБОР
	|			КОГДА НДСКРаспределению ТОГДА
	|				&СчетУчетаНДСКРаспределению
	|			ИНАЧЕ
	|				&СчетУчетаНДС
	|		КОНЕЦ		КАК СчетВычетКт,
	|		&Счет30304	КАК Счет30304
	|	) КАК ТабличнаяЧасть,
	|	ВЫБОР
	|		КОГДА ПоступлениеМЗ.Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.АгентскийДоговор)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент)
	|		КОГДА ПоступлениеМЗ.Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СКомиссионеромНаЗакупку)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.СчетФактураНаПокупкуОтКомиссионера)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Покупка)
	|	КОНЕЦ КАК ПричинаНалогообложения,
	|	ВЫБОР
	|		КОГДА ПоступлениеМЗ.Договор.ТипДоговораНДС = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровДляНДС.АгентскийДоговор)
	|			ТОГДА ""06""
	|		ИНАЧЕ ""01""
	|	КОНЕЦ КАК КодВидаОперации
	|ИЗ
	|	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	|ГДЕ
	|	ПоступлениеМЗ.Ссылка = &Ссылка";
	
	Основание = ЗапросЗаполнение.Выполнить().Выбрать();
	Основание.Следующий();
	
	Если ИзТаблицы Тогда
		ЗаполнитьЗначенияСвойств(ЗаполняемыйДокумент, Основание, "КодВидаОперации,ПричинаНалогообложения");
	Иначе
		ЗаполняемыйДокумент.ДокументыОснования.Очистить();
		
		НоваяСтрока = ЗаполняемыйДокумент.ДокументыОснования.Добавить();
		НоваяСтрока.ДокументОснование = ДокументОснованиеСсылка;
		
		ЗаполнитьЗначенияСвойств(ЗаполняемыйДокумент, Основание);
	КонецЕсли;	
	
	Материал = Основание.ТабличнаяЧасть.Выбрать();
	Пока Материал.Следующий() Цикл
		СтрокаНФА = ЗаполняемыйДокумент["СоставНФА"].Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНФА, Материал);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДокументНаОснованииПоступлениеМЗВПути(Знач ДокументОснованиеСсылка, Объект, Знач ИзТаблицы)
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_РеквизитыТиповойОперации	= БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументОснованиеСсылка,
		"СчетНДСКРаспределению,СчетНДС");
	
