#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Действия обработчика обновления:
	// 1) Инициализация новой колонки СчетРасчетов
	// 2) Установка признака ВводНачальныхОстатков и отмена проведения документов остатков НДС
	
	Запрос = Новый Запрос();
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Все документы
	|//
	|ВЫБРАТЬ
	|	Регистратор	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ВсеДокументы
	|ИЗ
	|	РегистрНакопления.ВходящийНДС
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(Регистратор) = ТИП(Документ.СчетФактураПолученный)
	|	
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Регистратор	КАК Ссылка
	|ИЗ
	|	РегистрНакопления.ВходящийНДСКРаспределению
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(Регистратор) = ТИП(Документ.СчетФактураПолученный)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Исключаемые документы
	|//
	|ВЫБРАТЬ
	|	ВсеДокументы.Ссылка
	|ПОМЕСТИТЬ
	|	ИсключаемыеДокументы
	|ИЗ
	|	ВсеДокументы
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	Документ.СчетФактураПолученный.СоставНФА	КАК СоставНФА
	|		ПО	ВсеДокументы.Ссылка = СоставНФА.Ссылка
	|ГДЕ
	|	СоставНФА.СчетРасчетов <> ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВсеДокументы.Ссылка
	|ИЗ
	|	ВсеДокументы
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	Документ.СчетФактураПолученный.СоставНФА	КАК СоставНФА
	|		ПО	ВсеДокументы.Ссылка = СоставНФА.Ссылка
	|ГДЕ
	|	СоставНФА.ДокументОснование = НЕОПРЕДЕЛЕНО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Потенциальные кандидаты на обработку
	|//
	|ВЫБРАТЬ
	|	Ссылка
	|ПОМЕСТИТЬ
	|	ПотенциальныеКандидаты
	|ИЗ
	|	ВсеДокументы
	|ГДЕ
	|	НЕ Ссылка В(ВЫБРАТЬ Ссылка ИЗ ИсключаемыеДокументы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Обрабатываемые документы
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка
	|ИЗ
	|	Документ.СчетФактураПолученный.СоставНФА
	|ГДЕ
	|	СчетРасчетов = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	И Ссылка В (ВЫБРАТЬ Ссылка ИЗ ПотенциальныеКандидаты)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка.Дата УБЫВ
	|;";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	//---
	// Документы остатков НДС
	//---
	УчетНДС.ДокументыОстатковНДС_ДобавитьВСписокДокументыДляОбработчикаОбновленияВводНачальныхОстатков(Данные, "СчетФактураПолученный");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Действия обработчика обновления:
	// 1) Инициализация новой колонки СчетРасчетов
	// 2) Установка признака ВводНачальныхОстатков и отмена проведения документов остатков НДС
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.СчетФактураПолученный";
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта, МенеджерВременныхТаблиц, ДополнительныеПараметры);
	
	Если Не Результат.ЕстьДанныеДляОбработки Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	Если Не Результат.ЕстьЗаписиВоВременнойТаблице Тогда
		Параметры.ОбработкаЗавершена = Ложь;
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исключаемые документы для инициализации счета расчетов
	|//
	|ВЫБРАТЬ
	|	ВТДляОбработки.Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ИсключаемыеДокументыСчетРасчетов
	|ИЗ
	|	ВТДляОбработки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	Документ.СчетФактураПолученный.СоставНФА	КАК СоставНФА
	|		ПО	ВТДляОбработки.Ссылка = СоставНФА.Ссылка
	|ГДЕ
	|	СоставНФА.СчетРасчетов <> ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТДляОбработки.Ссылка	КАК Ссылка
	|ИЗ
	|	ВТДляОбработки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	Документ.СчетФактураПолученный.СоставНФА	КАК СоставНФА
	|		ПО	ВТДляОбработки.Ссылка = СоставНФА.Ссылка
	|ГДЕ
	|	СоставНФА.ДокументОснование = НЕОПРЕДЕЛЕНО
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Обрабатываемые документы
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 500
	|	Ссылка																КАК Ссылка,
	|	НЕ (Ссылка В (ВЫБРАТЬ Ссылка ИЗ ИсключаемыеДокументыСчетРасчетов))	КАК ИнициализироватьСчетРасчетов
	|ИЗ
	|	ВТДляОбработки
	|;";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	//---
	// Документы остатков НДС
	//---
	СписокДокументыОстатковНДС = УчетНДС.ДокументыОстатковНДС_СписокДокументовДляОбработчикаОбновленияВводНачальныхОстатков("СчетФактураПолученный");
	
	Пока Выборка.Следующий() Цикл
		
		УстановитьПризнакВводОстатков = (СписокДокументыОстатковНДС.Найти(Выборка.Ссылка) <> Неопределено);
		
		Если НЕ Выборка.ИнициализироватьСчетРасчетов И НЕ УстановитьПризнакВводОстатков Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			
			НачатьТранзакцию();
			
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			Если Выборка.ИнициализироватьСчетРасчетов Тогда
				
				СоставНФА = ДокОбъект.СоставНФА.Выгрузить();
				
				УчетНДС.ЗаполнитьСчетРасчетов(СоставНФА);
				
				ДокОбъект.СоставНФА.Загрузить(СоставНФА);
				
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект);
				
			КонецЕсли;
			
			Если УстановитьПризнакВводОстатков Тогда
				
				ДокОбъект.ВводНачальныхОстатков = Истина;
				
			КонецЕсли;
			
			//
			// Записываем документ
			//
			
			Если УстановитьПризнакВводОстатков Тогда
				
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект,,,РежимЗаписиДокумента.ОтменаПроведения);
				
			ИначеЕсли Выборка.ИнициализироватьСчетРасчетов Тогда
				
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект);
				
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#Область ОбработчикОбновления_2_0_93_ОбъектНалогообложенияОтчетОРасходахПодотчетногоЛица

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию_2_0_93(Параметры) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка КАК Ссылка
	|ПОМЕСТИТЬ
	|	ДокументыКандидаты
	|ИЗ
	|	Документ.СчетФактураПолученный.СоставНФА
	|ГДЕ
	|	ДокументОснование ССЫЛКА Документ.ОтчетОРасходахПодотчетногоЛица
	|	И Ссылка.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Регистратор КАК Ссылка
	|ИЗ
	|	РегистрНакопления.ВходящийНДС
	|ГДЕ
	|	Регистратор В(ВЫБРАТЬ Ссылка ИЗ ДокументыКандидаты)
	|	И ОбъектНалогообложения = НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Регистратор КАК Ссылка
	|ИЗ
	|	РегистрНакопления.ВходящийНДСКРаспределению
	|ГДЕ
	|	Регистратор В(ВЫБРАТЬ Ссылка ИЗ ДокументыКандидаты)
	|	И ОбъектНалогообложения = НЕОПРЕДЕЛЕНО";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию_2_0_93(Параметры) Экспорт
	
	// Параллельный отложенный обработчик обновления
	
	МетаданныеДокумента = Метаданные.Документы.СчетФактураПолученный;
	
	ПолноеИмяОбъекта = МетаданныеДокумента.ПолноеИмя();
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Если Выборка.Количество() = 0 Тогда
		Параметры.ОбработкаЗавершена = Истина;
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Обработчик обновления завершил обработку движений документов %1'"),
			ПолноеИмяОбъекта);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
			
		Возврат;
	КонецЕсли;
	
	ПроблемныхОбъектов = 0;
	ОбъектовОбработано = 0;
	ПлохиеДанные = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		ДокументСсылка = Выборка.Ссылка;
		
		НачатьТранзакцию();
		
		Попытка
			Блокировка = Новый БлокировкаДанных;
			
			Элемент = Блокировка.Добавить("РегистрНакопления.ВходящийНДС.НаборЗаписей");
			Элемент.УстановитьЗначение("Регистратор", ДокументСсылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Элемент = Блокировка.Добавить("РегистрНакопления.ВходящийНДСКРаспределению.НаборЗаписей");
			Элемент.УстановитьЗначение("Регистратор", ДокументСсылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
			
			Если ДокументОбъект = Неопределено Тогда
				ПропуститьДокумент = Истина;
			Иначе
				ТаблицаСоставНФА = ДокументОбъект.СоставНФА.Выгрузить();
				
				УстановитьОбъектНалогообложенияВДвижениях(ДокументОбъект, ТаблицаСоставНФА, "ВходящийНДС");
				УстановитьОбъектНалогообложенияВДвижениях(ДокументОбъект, ТаблицаСоставНФА, "ВходящийНДСКРаспределению");
				
				ПропуститьДокумент = Не ДокументОбъект.Движения.ВходящийНДС.Записывать И Не ДокументОбъект.Движения.ВходящийНДСКРаспределению.Записывать
			КонецЕсли;
			
			Если ПропуститьДокумент Тогда
	     		// Если объект ранее был удален или обработан другими сеансами, пропускаем его.
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ДокументСсылка);
				ЗафиксироватьТранзакцию();
				
				ОбъектовОбработано = ОбъектовОбработано + 1;
				
				Продолжить;
			КонецЕсли;
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			
			ОбъектовОбработано = ОбъектовОбработано + 1;
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Не удалось установить ОбъектНалогообложения в движениях документа по причине %1'"), 
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеДокумента,
				ДокументСсылка,
				ТекстСообщения);
		КонецПопытки;
	
	КонецЦикла;
	
	Для Каждого НеобработанныйОбъект Из ПлохиеДанные Цикл
		ОбновлениеИнформационнойБазы.ЗарегистрироватьПроблемуСДанными(НеобработанныйОбъект.Ключ, НеобработанныйОбъект.Значение);
	КонецЦикла;
	
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Не удалось обработать всю очередную порцию объектов %1 (пропущены): %2 шт.'"),
			ПолноеИмяОбъекта,
			ПроблемныхОбъектов);
			
		ВызватьИсключение ТекстСообщения;
	Иначе
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Обработана очередная порция документов %1: %2 шт.'"),
			ПолноеИмяОбъекта,
			ОбъектовОбработано);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
	КонецЕсли;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

Процедура УстановитьОбъектНалогообложенияВДвижениях(ДокументОбъект, ТаблицаСоставНФА, ИмяРегистра)
				
	НаборЗаписей = ДокументОбъект.Движения[ИмяРегистра];
	НаборЗаписей.Прочитать();
	
	Поиск = Новый Структура("
		|КФО,
		|СчетРасчетов,
		|СчетВычетКт,
		|КПСВычетКт,
		|СтавкаНДС,
		|Сумма,
		|СуммаНДС");
	
	ИзмененыДвижения = Ложь;
	
	Если НаборЗаписей.Количество() > 0 Тогда
		Для Каждого Движение Из НаборЗаписей Цикл
			Если ТипЗнч(Движение.ОбъектНалогообложения) = Тип("ДокументСсылка.ОтчетОРасходахПодотчетногоЛица") Тогда
				Прервать;
			КонецЕсли;
			
			Поиск.КФО			= Движение.КФО;
			Поиск.СчетРасчетов	= Движение.СчетРасчетов;
			Поиск.СчетВычетКт	= Движение.СчетКредита;
			Поиск.КПСВычетКт	= Движение.КПССчетРасчетов;
			Поиск.СтавкаНДС		= Движение.СтавкаНДС;
			Поиск.Сумма			= Движение.СуммаБезНДС;
			Поиск.СуммаНДС		= Движение.СуммаНДС;

			МассивСтрок = ТаблицаСоставНФА.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ОбъектНалогообложения = МассивСтрок[0].ДокументОснование;
			
			Если ТипЗнч(ОбъектНалогообложения) <> Тип("ДокументСсылка.ОтчетОРасходахПодотчетногоЛица") Тогда
				Продолжить;
			КонецЕсли;
			
			Движение.ОбъектНалогообложения = ОбъектНалогообложения;
			
			ИзмененыДвижения = Истина;
		КонецЦикла;
	КонецЕсли;
	
	Если ИзмененыДвижения Тогда
		НаборЗаписей.Записывать = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

