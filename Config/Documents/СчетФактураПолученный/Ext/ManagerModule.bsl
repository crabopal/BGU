	|	НЕОПРЕДЕЛЕНО	КАК НомерСтроки,
	|	НЕОПРЕДЕЛЕНО	КАК СчетФактура,
	|	НЕОПРЕДЕЛЕНО	КАК Дата,
	|	НЕОПРЕДЕЛЕНО	КАК Номер,
	|	НЕОПРЕДЕЛЕНО	КАК ДатаИсправления,
	|	НЕОПРЕДЕЛЕНО	КАК НомерИсправления
	|ГДЕ
	|	ЛОЖЬ";
	
	МассивРезультатов = ЗапросПечать.ВыполнитьПакет();
	
	Результат = Новый Структура();
	
	// [0]. Данные табличной части СоставНФА
	ОбщаяТаблицаСоставНФА = МассивРезультатов[0].Выгрузить();
	ОбщаяТаблицаСоставНФА.Индексы.Добавить("Ссылка");
	Результат.Вставить("ОбщаяТаблицаСоставНФА", ОбщаяТаблицаСоставНФА);
	
	// [1]. Данные табличной части РасчетноПлатежныеДокументы
	Результат.Вставить("ВыборкаДокПлатежноРасчетныеДокументы",	МассивРезультатов[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	// [3]. Список объектов для дальнейшего группового получения контактной информации (адресов)
	Результат.Вставить("СписокОбъектовДляОпределенияАдресов",	МассивРезультатов[3].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	// [4]. Данные шапки документа, без контактной информации
	Результат.Вставить("ВыборкаШапка",							МассивРезультатов[4].Выбрать());
	
	// [5]. Данные табличной части ДокументыОбОтгрузке
	Результат.Вставить("ОбщаяТаблицаДокументыОбОтгрузке",		МассивРезультатов[5].Выгрузить());
	
	// [6]. Данные табличной части СчетаФактурыОтКомиссионера
	Результат.Вставить("ВыборкаПокупатели",		МассивРезультатов[6].Выгрузить());
	
	// [7]. Данные табличной части СчетаФактурыНаАванс
	Результат.Вставить("ОбщаяТаблицаСчетаФактурыНаАванс", МассивРезультатов[7].Выгрузить());
	
	Возврат Результат;
	
КонецФункции

