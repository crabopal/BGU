		// Можно корректно заполнить на основании?
		Если РезультатШапка["ЭтоНедопустимыйТипДоговораНДС"] Тогда
			Текст = НСтр("ru='Заполнение документа ""Счет-фактура полученный"" на основании документа ""Поступление услуг, работ (по счетам учета затрат)"" отменено.
			|В документе-основании ""Поступление услуг, работ (по счетам учета затрат)"" указан договор, у которого тип для целей НДС ""%1"".
			|
			|На основании такого документа ""Поступление услуг, работ (по счетам учета затрат)"" следует заполнять иной документ: ""Счет-фактура выданный"".'");
			
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, РезультатШапка["ТипДоговораНДС"]);
			Возврат;
		Иначе
			// Заполняем документ.
			
			Если ИзТаблицы Тогда
				ЗаполнитьЗначенияСвойств(Объект, РезультатШапка, "КодВидаОперации,ПричинаНалогообложения");
				
				// Добавляем строки в табличную часть:
				Для Каждого ОчереднаяСтрока Из РезультатСоставНФА Цикл
					НоваяСтрока = Объект["СоставНФА"].Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ОчереднаяСтрока);
				КонецЦикла;
				
			Иначе
				// Шапка счета-фактуры:
				ЗаполнитьЗначенияСвойств(Объект, РезультатШапка);
				
				// Список документов-оснований:
				ДокументыОснования = Объект["ДокументыОснования"];
				ДокументыОснования.Очистить();
				НоваяСтрока = ДокументыОснования.Добавить();
				НоваяСтрока["ДокументОснование"] = ДокументОснованиеСсылка;
				
				// Загружаем табличную часть целиком:
				Объект["СоставНФА"].Загрузить(РезультатСоставНФА);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДокументНаОснованииСчетФактураПолученный(Знач ДокументОснования, Объект, Знач ИзТаблицы)
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СчетФактураПолученный.Дата,
	               |	СчетФактураПолученный.Ссылка,
	               |	СчетФактураПолученный.Организация,
	               |	СчетФактураПолученный.ИФО,
	               |	СчетФактураПолученный.Подразделение,
	               |	СчетФактураПолученный.Контрагент,
	               |	СчетФактураПолученный.Договор,
	               |	СчетФактураПолученный.ВалютаДокумента,
	               |	СчетФактураПолученный.СуммаВключаетНДС,
	               |	СчетФактураПолученный.ПричинаНалогообложения,
	               |	СчетФактураПолученный.КодВидаОперации,
	               |	СчетФактураПолученный.СчетРасчетовАванс,
	               |	СчетФактураПолученный.СоставНФА.(
	               |		Ссылка КАК ДокументОснование,
	               |		НомерСтроки,
	               |		НФА,
	               |		ЕдиницаИзмерения,
	               |		Количество,
	               |		Сумма,
	               |		СтавкаНДС,
	               |		СуммаНДС,
	               |		Всего,
	               |		КПСВычетКт,
	               |		КФО,
	               |		СчетВычетКт,
	               |		Счет30304,
	               |		НДСКВычету,
	               |		НДСКРаспределению
	               |	) КАК ТабличнаяЧасть,
	               |	СчетФактураПолученный.ПлатежноРасчетныеДокументы.(
	               |		ДатаДокумента КАК ДатаДокумента,
	               |		НомерДокумента КАК НомерДокумента
	               |	) КАК ПлатежноРасчетныеДокументы
	               |ИЗ
	               |	Документ.СчетФактураПолученный КАК СчетФактураПолученный
	               |ГДЕ
	               |	СчетФактураПолученный.Ссылка = &Ссылка";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",ДокументОснования);
	Основание = Запрос.Выполнить().Выбрать();
	Основание.Следующий();
	
	Если ИзТаблицы Тогда
		ЗаполнитьЗначенияСвойств(Объект, Основание, "КодВидаОперации,ПричинаНалогообложения");
	Иначе
		Объект.ДокументыОснования.Очистить();
		
		НоваяСтрока = Объект.ДокументыОснования.Добавить();
		НоваяСтрока.ДокументОснование = ДокументОснования;
		
		ЗаполнитьЗначенияСвойств(Объект, Основание);
	КонецЕсли;	
	
	Выборка = Основание.ТабличнаяЧасть.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаНФА = Объект.СоставНФА.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНФА, Выборка);
	КонецЦикла;	
	
	Выборка = Основание.ПлатежноРасчетныеДокументы.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ПлатежноРасчетныеДокументы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ЗаполнитьДокументНаОснованииЗаявкаНаКассовыйРасход(Знач ДокументОснования, Объект, Знач ИзТаблицы, ОписаниеОшибки, Знач ПоляОтбораИзШапкиСФ)
	
	ТаблицаАвансов = ПолучитьТаблицуАвансовВыданных(ДокументОснования, ПоляОтбораИзШапкиСФ);
	
	Если ТаблицаАвансов.Количество() = 0 Тогда
		ОписаниеОшибки = НСтр("ru='Заявка на кассовый расход не является авансовой'");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", ДокументОснования);
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаявкаНаКассовыйРасход.Дата											КАК Дата,
	|	ЗаявкаНаКассовыйРасход.Организация									КАК Организация,
	|	ЗаявкаНаКассовыйРасход.ИФО											КАК ИФО,
	|	ЗаявкаНаКассовыйРасход.ВалютаДокумента								КАК ВалютаДокумента,
	|	""02""																КАК КодВидаОперации,
	|	ВЫБОР
	|		КОГДА ЗаявкаНаКассовыйРасход.Договор.ВидДоговора = Значение(Перечисление.ВидыДоговоровКонтрагентов.СКомиссионеромНаЗакупку) ТОГДА
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансВыданный)		
	|	КОНЕЦ																КАК ПричинаНалогообложения,
	|	ЗаявкаНаКассовыйРасход.СтавкаНДС									КАК СтавкаНДС,
	|	СостояниеПлатежноРасчетныхДокументов.НомерПодтверждающегоДокумента	КАК НомерПодтверждающегоДокумента,
	|	СостояниеПлатежноРасчетныхДокументов.ДатаПодтверждающегоДокумента	КАК ДатаПодтверждающегоДокумента,
	|	СостояниеПлатежноРасчетныхДокументов.ВидПодтверждающегоДокумента	КАК ВидПодтверждающегоДокумента
	|ИЗ
	|	Документ.ЗаявкаНаКассовыйРасход КАК ЗаявкаНаКассовыйРасход
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
	|		ПО (СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент = ЗаявкаНаКассовыйРасход.Ссылка)
	|ГДЕ
	|	ЗаявкаНаКассовыйРасход.Ссылка = &Ссылка";
	
	Основание = Запрос.Выполнить().Выгрузить();
	
	Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Основание[0]);
	
	Если ИзТаблицы Тогда
		ЗаполнитьЗначенияСвойств(Объект, Шапка, "КодВидаОперации,ПричинаНалогообложения");
	Иначе
		ЗаполнитьЗначенияСвойств(Объект, Шапка);
		
		НоваяСтрока = Объект.ДокументыОснования.Добавить();
		НоваяСтрока.ДокументОснование = ДокументОснования;
	КонецЕсли;

	ЗаполнитьТабличнуюЧастьСоставНФАДляАвансаВыданного(Объект, ТаблицаАвансов, ДокументОснования, Шапка.СтавкаНДС);
	
	ДобавитьУникальныйПлатежноРасчетныйДокумент(Объект.ПлатежноРасчетныеДокументы,
		Шапка.ДатаПодтверждающегоДокумента,
		Шапка.НомерПодтверждающегоДокумента);
	
КонецПроцедуры

