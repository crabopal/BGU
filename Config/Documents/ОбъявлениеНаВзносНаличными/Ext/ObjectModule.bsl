#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры 

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		
		ДокументОснование 	= ДанныеЗаполнения.Ссылка;
		СуммаДокумента 		= ДанныеЗаполнения.СуммаДокумента;
		Организация 		= ДанныеЗаполнения.Организация;
		
		ПечатьСуммыВКвитанции = Ложь;
		
		// Лицевой счет и реквизиты лицевого счета
		
		БухОперация 		= БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(ДанныеЗаполнения.Ссылка);
		РеквизитыОперации 	= БухгалтерскиеОперацииСервер.ЗаполнитьДополнительныеРеквизиты(ДанныеЗаполнения.Ссылка, БухОперация);
		
		Для Каждого РеквизитОперации Из РеквизитыОперации Цикл
			
			Если ТипЗнч(РеквизитОперации.Значение) = Тип("СправочникСсылка.РеквизитыЛицевыхСчетов")
				И ЗначениеЗаполнено(РеквизитОперации.Значение) Тогда
				
				ЛицевойСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитОперации.Значение, "Владелец");
				РеквизитыЛицевогоСчета = РеквизитОперации.Значение;
				
			ИначеЕсли ТипЗнч(РеквизитОперации.Значение) = Тип("СправочникСсылка.РазделыЛицевыхСчетов") Тогда
				
				ЛСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитОперации.Значение, "Владелец");
				
				Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
				|	РазделыЛицевыхСчетов.Ссылка
				|ИЗ
				|	Справочник.РазделыЛицевыхСчетов КАК РазделыЛицевыхСчетов
				|ГДЕ
				|	РазделыЛицевыхСчетов.Владелец = &Владелец");
				
				Запрос.УстановитьПараметр("Владелец", ЛСчет);
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Следующий() Тогда
					
					ЛицевойСчет = ЛСчет;
					РеквизитыЛицевогоСчета = Выборка.Ссылка;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;	

		Символы.Очистить();
		
		Для каждого ТекСтрокаРКО Из ДокументОснование.РасшифровкаПлатежа Цикл
			
			НовСтр = Символы.Добавить();
			НовСтр.КЭК = ТекСтрокаРКО.КЭК;
			НовСтр.КПС = ТекСтрокаРКО.КПС;
			НовСтр.Сумма = ТекСтрокаРКО.Сумма;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ДокументОснование = ПредопределенноеЗначение("Документ.РасходныйКассовыйОрдер.ПустаяСсылка");	
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
