#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаполнитьНазначениеПлатежаНаКлиенте(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
    
     Если ВыбранныйЭлемент <> Неопределено Тогда
		НазначениеПлатежа(ВыбранныйЭлемент.Значение);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию()
	
	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.ОбъявлениеНаВзносНаличными", Объект.Дата);
	
	Объект.ЛицевойСчет = Умолчания.ЛицевойСчет;
	Объект.РеквизитыЛицевогоСчета = Умолчания.РеквизитыЛицевогоСчета;
	
	ЗаполнитьРеквизитыКорреспондента();
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьИсточникПоступления()
	
	Результат="";
	Для каждого ТекСтр Из Объект.Символы Цикл
	
		КБК         = ?(ЗначениеЗаполнено(ТекСтр.КПС), ТекСтр.КПС, "00000000000000000");
		КОСГУ       = ?(ЗначениеЗаполнено(ТекСтр.КЭК), ТекСтр.КЭК,        "000");
		Сумма       = ?(ЗначениеЗаполнено(ТекСтр.Сумма), " : " + Формат(ТекСтр.Сумма, "ЧЦ=15; ЧДЦ=2; ЧРД=-") + " руб.", "");
		Расшифровка = ?(ЗначениеЗаполнено(ТекСтр.Расшифровка),  " : " + ТекСтр.Расшифровка, "");
		
		Результат = Результат + КБК + КОСГУ + Сумма + Расшифровка + "; ";

	КонецЦикла;
	
	Объект.ИсточникПоступления = Результат;
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьНаСервере()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Заполнить(Объект.ДокументОснование);
	ЗначениеВРеквизитФормы(ДокументОбъект,"Объект");
	ИФО 		= Объект.ДокументОснование.ИФО;
	КорСчет 	= Объект.ДокументОснование.КорСчет;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЛицевойСчет(РеквизитыЛС)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыЛС, "Владелец");
	
КонецФункции

&НаСервереБезКонтекста
Функция РеквизитыКорреспондентаЛицевогоСчета(РеквизитыЛицевогоСчета)
	
	ПлатежныеРеквизиты =  Новый Структура("КорреспондентИНН, КорреспондентКПП, КорреспондентТекст, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя",
		"ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");		
		
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(РеквизитыЛицевогоСчета.Владелец, 
																					 РеквизитыЛицевогоСчета,
																					 ПлатежныеРеквизиты,
																					 Истина);	
	
	Если ПустаяСтрока(РеквизитыЛицевогоСчета.КорреспондентТекст) Тогда
		

		Возврат Новый Структура("КорреспондентИНН, КорреспондентКПП, КорреспондентТекст, РасчетныйСчет, КодОКАТО, Банк, БИК",
								ПлатежныеРеквизиты.КорреспондентИНН,
								ПлатежныеРеквизиты.КорреспондентКПП,
								ПлатежныеРеквизиты.КорреспондентТекст,
								РеквизитыЛицевогоСчета.Владелец.Код,
								РеквизитыЛицевогоСчета.Владелец.Владелец.КодОКАТО,
								ПлатежныеРеквизиты.НаименованиеБанкаПолучателя,
								ПлатежныеРеквизиты.БикБанкаПолучателя);
	Иначе
		Возврат Новый Структура("КорреспондентИНН, КорреспондентКПП, КорреспондентТекст, РасчетныйСчет, КодОКАТО, Банк, БИК",
								РеквизитыЛицевогоСчета.КорреспондентИНН,
								РеквизитыЛицевогоСчета.КорреспондентКПП,
								РеквизитыЛицевогоСчета.КорреспондентТекст,
								РеквизитыЛицевогоСчета.Владелец.Код,
								РеквизитыЛицевогоСчета.Владелец.Владелец.КодОКАТО,
								ПлатежныеРеквизиты.НаименованиеБанкаПолучателя,
								ПлатежныеРеквизиты.БикБанкаПолучателя);

	КонецЕсли;	
							
КонецФункции // РеквизитыКорреспондентаЛицевогоСчета()

&НаСервере
Процедура ЗаполнитьРеквизитыКорреспондента()
	
	РеквизитыСчета = РеквизитыКорреспондентаЛицевогоСчета(Объект.РеквизитыЛицевогоСчета);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ОбъявлениеНаВзносНаличными.ИНН КАК ИНН,
	|	ОбъявлениеНаВзносНаличными.КПП КАК КПП,
	|	ОбъявлениеНаВзносНаличными.Получатель КАК Получатель,
	|	ОбъявлениеНаВзносНаличными.ОтКого КАК ОтКого,
	|	ОбъявлениеНаВзносНаличными.РасчетныйСчет КАК РасчетныйСчет,
	|	ОбъявлениеНаВзносНаличными.ОКАТО КАК ОКАТО,
	|	ОбъявлениеНаВзносНаличными.ОтКогоСчет КАК ОтКогоСчет,
	|	ОбъявлениеНаВзносНаличными.БанкВноситель КАК БанкВноситель,
	|	ОбъявлениеНаВзносНаличными.БанкПолучатель КАК БанкПолучатель,
	|	ОбъявлениеНаВзносНаличными.БИКБанкаВносителя КАК БИКБанкаВносителя,
	|	ОбъявлениеНаВзносНаличными.БИКБанкаПолучателя КАК БИКБанкаПолучателя
	|ИЗ
	|	Документ.ОбъявлениеНаВзносНаличными КАК ОбъявлениеНаВзносНаличными
	|ГДЕ
	|	ОбъявлениеНаВзносНаличными.РеквизитыЛицевогоСчета = &РеквизитыЛицевогоСчета
	|	И НЕ ОбъявлениеНаВзносНаличными.ПометкаУдаления
	|	И ОбъявлениеНаВзносНаличными.Ссылка <> &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбъявлениеНаВзносНаличными.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("РеквизитыЛицевогоСчета", Объект.РеквизитыЛицевогоСчета);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	Результат = Запрос.Выполнить();
		
	Если Результат.Пустой() Тогда
		
		Если ЗначениеЗаполнено(Объект.РеквизитыЛицевогоСчета) Тогда 
			
			Объект.ИНН 					= РеквизитыСчета.КорреспондентИНН;
			Объект.КПП 					= РеквизитыСчета.КорреспондентКПП;
			Объект.Получатель 			= РеквизитыСчета.КорреспондентТекст;
			Объект.ОтКого 				= РеквизитыСчета.КорреспондентТекст;
			Объект.РасчетныйСчет 		= РеквизитыСчета.РасчетныйСчет;
			Объект.ОКАТО 				= РеквизитыСчета.КодОКАТО;
			Объект.ОтКогоСчет 			= "";
			Объект.БанкВноситель    	= РеквизитыСчета.Банк;
			Объект.БанкПолучатель 		= РеквизитыСчета.Банк;
			Объект.БИКБанкаВносителя 	= РеквизитыСчета.БИК;
			Объект.БИКБанкаПолучателя	= РеквизитыСчета.БИК;

		КонецЕсли;
		
	Иначе
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Объект.ИНН 					= ?(ЗначениеЗаполнено(Выборка.ИНН), Выборка.ИНН, РеквизитыСчета.КорреспондентИНН);
		Объект.КПП 					= ?(ЗначениеЗаполнено(Выборка.КПП), Выборка.КПП, РеквизитыСчета.КорреспондентКПП);
		Объект.Получатель 			= ?(ЗначениеЗаполнено(Выборка.Получатель), Выборка.Получатель, РеквизитыСчета.КорреспондентТекст);
		Объект.ОтКого 				= ?(ЗначениеЗаполнено(Выборка.ОтКого), Выборка.ОтКого, РеквизитыСчета.КорреспондентТекст);
		Объект.РасчетныйСчет 		= ?(ЗначениеЗаполнено(Выборка.РасчетныйСчет), Выборка.РасчетныйСчет, РеквизитыСчета.РасчетныйСчет);
		Объект.ОКАТО 				= ?(ЗначениеЗаполнено(Выборка.ОКАТО), Выборка.ОКАТО, РеквизитыСчета.КодОКАТО);
		Объект.ОтКогоСчет 			= Выборка.ОтКогоСчет;
		Объект.БанкВноситель 		= ?(ЗначениеЗаполнено(Выборка.БанкВноситель), Выборка.БанкВноситель, РеквизитыСчета.Банк);
		Объект.БанкПолучатель 		= ?(ЗначениеЗаполнено(Выборка.БанкПолучатель), Выборка.БанкПолучатель, РеквизитыСчета.Банк);
		Объект.БИКБанкаВносителя 	= ?(ЗначениеЗаполнено(Выборка.БИКБанкаВносителя), Выборка.БИКБанкаВносителя, РеквизитыСчета.БИК);
		Объект.БИКБанкаПолучателя 	= ?(ЗначениеЗаполнено(Выборка.БИКБанкаПолучателя), Выборка.БИКБанкаПолучателя, РеквизитыСчета.БИК);
		
	КонецЕсли;

КонецПроцедуры // ЗаполнитьРеквизитыКорреспондента()

&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()

	Элементы.ЛицевойСчет.Доступность		= ЗначениеЗаполнено(Объект.Организация);
	Элементы.ДокументОснование.Доступность	= ЗначениеЗаполнено(Объект.Организация);

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()

&НаСервере
Функция СписокШаблонов()
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	
	СписокШаблонов = Справочники.ШаблоныЗаполненияПП.ПолучитьСписокШаблонов(ДокОбъект);
	
	Возврат СписокШаблонов;
	
КонецФункции

&НаСервере
Процедура НазначениеПлатежа(ВыбранныйШаблон)
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	Шаблон = ВыбранныйШаблон.ПолучитьОбъект();
	Объект.ИсточникПоступления = Шаблон.СформироватьНазначениеПлатежа(ДокОбъект);
	
КонецПроцедуры

