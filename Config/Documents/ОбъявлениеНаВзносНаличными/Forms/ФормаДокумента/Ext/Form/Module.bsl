#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы


&НаКлиенте
Процедура СимволыКБКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Символы.ТекущиеДанные;

	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													ТекущиеДанные.КПС, 
													Объект.Организация,
													ИФО,
													"",//ТекущиеДанные.КФО,
													КорСчет,
													Объект.Дата);
КонецПроцедуры

&НаКлиенте
Процедура СимволыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Объект.СуммаДокумента = Объект.Символы.Итог("Сумма");

КонецПроцедуры

&НаКлиенте
Процедура СимволыПослеУдаления(Элемент)
	
	Объект.СуммаДокумента = Объект.Символы.Итог("Сумма");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаПерезаполнить(Команда)
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ПерезаполнитьНаСервере();
	Иначе
		Объект.СуммаДокумента = Объект.Символы.Итог("Сумма");
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьНазначениеПлатежа(Команда)
	
	СписокШаблонов = СписокШаблонов();
	
	Если СписокШаблонов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не найдено ни одного подходящего шаблона заполнения. Заполнено стандартным способом.'"));
		ЗаполнитьИсточникПоступления();
	ИначеЕсли СписокШаблонов.Количество() = 1 Тогда
		ЗаполнитьНазначениеПлатежаНаКлиенте(СписокШаблонов[0], "");
	Иначе
		СписокШаблонов.ПоказатьВыборЭлемента(Новый ОписаниеОповещения("ЗаполнитьНазначениеПлатежаНаКлиенте", ЭтотОбъект), "Выберите шаблон");
	КонецЕсли;
	
КонецПроцедуры

