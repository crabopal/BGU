&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	СчетаЦенныхБумаг.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("204.20, 204.31"));
	
	УстановитьДоступностьРеквизитовОрганизации(ЭтотОбъект);
	
	УправлениеВидимостьюЭлементов(ЭтотОбъект);
	
	ОбновитьДанныеФинансовогоВложения();
	
	БухгалтерскийУчетКлиентСервер.УстановитьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект, "Видимость");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюЭлементов(Форма)
	
	ЭтоПередачаКонтрагенту =
		Форма.Объект.ВидВыбытия = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийВыбытияФинансовыхВложений.РеализацияФинансовыхВложений")
		ИЛИ Форма.Объект.ВидВыбытия = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийВыбытияФинансовыхВложений.ПередачаФинансовыхВложений")
		ИЛИ Форма.Объект.ВидВыбытия = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийВыбытияФинансовыхВложений.ПередачаВложенийВФинансовыеАктивы");
	
	ЭтоФинансовыеВложения =
		Форма.Объект.ВидВыбытия = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийВыбытияФинансовыхВложений.РеализацияФинансовыхВложений")
		ИЛИ Форма.Объект.ВидВыбытия = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийВыбытияФинансовыхВложений.ПередачаФинансовыхВложений")
		ИЛИ Форма.Объект.ВидВыбытия = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийВыбытияФинансовыхВложений.ПрочееВыбытиеФинансовыхВложений");
	
	ЭтоРеализация =
		Форма.Объект.ВидВыбытия = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийВыбытияФинансовыхВложений.РеализацияФинансовыхВложений");
	
	ЭтоЦеннаяБумага = Форма.СчетаЦенныхБумаг.НайтиПоЗначению(Форма.Объект.СчетУчета) <> Неопределено;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Контрагент", "Видимость", ЭтоПередачаКонтрагенту);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Договор", "Видимость", ЭтоПередачаКонтрагенту);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СуммаРеализации", "Видимость", ЭтоРеализация);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СуммаРеализацииВалюта", "Видимость", ЭтоРеализация);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Количество", "Видимость", ЭтоФинансовыеВложения И ЭтоЦеннаяБумага);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "НоминальнаяСтоимостьЕдиницы", "Видимость", ЭтоФинансовыеВложения И ЭтоЦеннаяБумага);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "НоминальнаяСтоимостьЕдиницыВалюта", "Видимость", ЭтоФинансовыеВложения И ЭтоЦеннаяБумага);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "НоминальнаяСтоимость", "Видимость", ЭтоФинансовыеВложения И ЭтоЦеннаяБумага);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "НоминальнаяСтоимостьВалюта", "Видимость", ЭтоФинансовыеВложения И ЭтоЦеннаяБумага);
	
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьПодборНаСервере(ВыбранноеЗначение);
	
	СписокПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение);
	
	Если СписокПодбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ЗаполнитьЗначенияСвойств(Объект, СписокПодбора[0]);
	
	Объект.СуммаДокумента = СписокПодбора[0].Сумма;
	
	Если Объект.ВидВыбытия <> ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийВыбытияФинансовыхВложений.ПередачаВложенийВФинансовыеАктивы") Тогда
		
		НоминальнаяСтоимостьЕдиницы = СписокПодбора[0].НоминальнаяСтоимостьЕдиницы;
		ПервоначальнаяСтоимостьЕдиницы = СписокПодбора[0].Сумма / ?(СписокПодбора[0].Количество = 0, 1, СписокПодбора[0].Количество);
		
		РассчитатьНоминальнуюСтоимость(ЭтотОбъект);
		
	КонецЕсли;
	
	УправлениеВидимостьюЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьРеквизитовОрганизации(Форма)

	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("Подразделение");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Доступность", ЗначениеЗаполнено(Форма.Объект.Организация));

КонецПроцедуры // УстановитьДоступностьРеквизитовОрганизации()

&НаСервере
Функция СвойстваОбъектаФинансовыхВложений()
	
	Результат = Новый Структура;
	Результат.Вставить("КФО", Неопределено);
	Результат.Вставить("КПС", Неопределено);
	Результат.Вставить("СчетУчета", Неопределено);
	Результат.Вставить("Количество", 0);
	Результат.Вставить("Сумма", 0);
	
	Если Объект.ВидВыбытия <> ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийВыбытияФинансовыхВложений.ПередачаВложенийВФинансовыеАктивы") Тогда
		
		СчетаУчета = БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("204.00");
		СчетаУчетаСтрокой = "204";
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦенныеБумагиОстатки.Организация КАК Организация,
		|	ЦенныеБумагиОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦенныеБумагиОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ ОстаткиЦенныхБумаг
		|ИЗ
		|	РегистрНакопления.ЦенныеБумаги.Остатки(
		|			&Период,
		|			ЦеннаяБумага = &ОбъектФинансовыхВложений
		|				И Организация = &Организация) КАК ЦенныеБумагиОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОбъектыФинансовыхВложений) КАК ОбъектФинансовыхВложений,
		|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
		|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
		|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК Сумма,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОстатки.Валюта ЕСТЬ NULL
		|				ИЛИ ЖурналПроводокЕПСБУОстатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА &ВалютаРегламентированногоУчета
		|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.Валюта
		|	КОНЕЦ КАК ВалютаОстатков,
		|	ЕСТЬNULL(ОстаткиЦенныхБумаг.КоличествоОстаток, 0) КАК Количество,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОбъектыФинансовыхВложений).НоминальнаяСтоимость КАК НоминальнаяСтоимостьЕдиницы
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			Счет В (&СчетаУчета),
		|			&ОбъектыФинансовыхВложений,
		|			Организация = &Организация
		|				И ИФО = &ИФО
		|				И (Подразделение = &Подразделение
		|					ИЛИ НЕ &ИспользоватьУчетПоПодразделениям)
		|				И Субконто1 = &ОбъектФинансовыхВложений) КАК ЖурналПроводокЕПСБУОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|		ПО ЖурналПроводокЕПСБУОстатки.Организация = ОстаткиЦенныхБумаг.Организация
		|			И ЖурналПроводокЕПСБУОстатки.Субконто1 = ОстаткиЦенныхБумаг.ЦеннаяБумага";
		
	Иначе
		
		СчетаУчета = БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("215.00");
		СчетаУчетаСтрокой = "215";
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОбъектыФинансовыхВложений) КАК ОбъектФинансовыхВложений,
		|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
		|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
		|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК Сумма,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОстатки.Валюта ЕСТЬ NULL
		|				ИЛИ ЖурналПроводокЕПСБУОстатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА &ВалютаРегламентированногоУчета
		|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.Валюта
		|	КОНЕЦ КАК ВалютаОстатков
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			Счет В (&СчетаУчета),
		|			&ОбъектыФинансовыхВложений,
		|			Организация = &Организация
		|				И ИФО = &ИФО
		|				И (Подразделение = &Подразделение
		|					ИЛИ НЕ &ИспользоватьУчетПоПодразделениям)
		|				И Субконто1 = &ОбъектФинансовыхВложений) КАК ЖурналПроводокЕПСБУОстатки";
		
	КонецЕсли;
	
	ВалютаРегламентированногоУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	
	ОбъектыФинансовыхВложений = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		ПланыВидовХарактеристик.ВидыСубконто.ОбъектыФинансовыхВложений);
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	УчетПоПодразделениямНаСчетах = УчетПоПодразделениям И БухгалтерскийУчет.ВедетсяУчетПоПодразделениям(СчетаУчета);
	
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
	Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям", УчетПоПодразделениямНаСчетах);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", ВалютаРегламентированногоУчета);
	Запрос.УстановитьПараметр("СчетаУчета", СчетаУчета);
	Запрос.УстановитьПараметр("ОбъектыФинансовыхВложений", ОбъектыФинансовыхВложений);
	Запрос.УстановитьПараметр("ОбъектФинансовыхВложений", Объект.ОбъектФинансовыхВложений);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	СвойстваОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ОбъектФинансовыхВложений,
		"ВидВложения, ФормаУчастияВКапитале, ВидЦеннойБумаги, НоминальнаяСтоимость");
	
	Если Результат.СчетУчета = Неопределено Тогда
		Результат.Вставить("СчетУчета", УчетФинансовыхВложений.СчетУчетаОбъектаФинансовыхВложений(
			СвойстваОбъекта, СчетаУчетаСтрокой, Объект.Дата, Объект.Организация));
	КонецЕсли;
	
	Результат.Вставить("НоминальнаяСтоимость", СвойстваОбъекта.НоминальнаяСтоимость);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьДанныеФинансовогоВложения()
	
	Если Объект.ВидВыбытия = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийВыбытияФинансовыхВложений.ПередачаВложенийВФинансовыеАктивы") Тогда
		Возврат;
	КонецЕсли;
	
	СвойстваАктива = СвойстваОбъектаФинансовыхВложений();
	
	ПервоначальнаяСтоимостьЕдиницы = СвойстваАктива.Сумма / ?(СвойстваАктива.Количество = 0, 1, СвойстваАктива.Количество);
	
	НоминальнаяСтоимостьЕдиницы = СвойстваАктива.НоминальнаяСтоимость;
	
	РассчитатьНоминальнуюСтоимость(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьНоминальнуюСтоимость(Форма)
	Форма.НоминальнаяСтоимость = Форма.Объект.Количество * Форма.НоминальнаяСтоимостьЕдиницы;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСчетаУчета()
	
	Если Объект.ВидВыбытия = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийВыбытияФинансовыхВложений.ПередачаВложенийВФинансовыеАктивы") Тогда
		КодыСчетов = "215.00";
	Иначе
		КодыСчетов = "204.00";
	КонецЕсли;
	
КонецПроцедуры

