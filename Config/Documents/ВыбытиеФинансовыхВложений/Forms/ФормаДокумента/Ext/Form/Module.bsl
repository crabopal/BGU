&НаКлиенте
Процедура ОбъектФинансовыхВложенийПриИзменении(Элемент)
	
	СвойстваАктива = СвойстваОбъектаФинансовыхВложений();
	
	Объект.КПС = СвойстваАктива.КПС;
	Объект.КФО = СвойстваАктива.КФО;
	Объект.Количество = СвойстваАктива.Количество;
	Объект.СчетУчета = СвойстваАктива.СчетУчета;
	Объект.СуммаДокумента = СвойстваАктива.Сумма;
	
	ПервоначальнаяСтоимостьЕдиницы = СвойстваАктива.Сумма / ?(СвойстваАктива.Количество = 0, 1, СвойстваАктива.Количество);
	
	НоминальнаяСтоимостьЕдиницы = СвойстваАктива.НоминальнаяСтоимость;
	
	РассчитатьНоминальнуюСтоимость(ЭтотОбъект);
	
	УправлениеВидимостьюЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)
	
	Если Объект.ВидВыбытия = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийВыбытияФинансовыхВложений.ПередачаВложенийВФинансовыеАктивы") Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьНоминальнуюСтоимость(ЭтотОбъект);
	
	Объект.СуммаДокумента = Объект.Количество * ПервоначальнаяСтоимостьЕдиницы;
	
КонецПроцедуры

