&НаКлиенте
Процедура Подобрать(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстОшибки = НСтр("ru='Не выбрана организация!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , "Организация", "Объект");
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	
	ПараметрыОткрытия.Вставить("Организация", Объект.Организация);
	ПараметрыОткрытия.Вставить("ИФО", Объект.ИФО);
	ПараметрыОткрытия.Вставить("Подразделение", Объект.Подразделение);
	Если НачалоДня(Объект.Дата) = НачалоДня(ТекущаяДата()) И Объект.Ссылка.Пустая() Тогда
		ПараметрыОткрытия.Вставить("Дата", Неопределено);
	Иначе
		ПараметрыОткрытия.Вставить("Дата", Объект.Дата);
	КонецЕсли;
	
	ПараметрыОткрытия.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	Если Объект.ВидВыбытия = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийВыбытияФинансовыхВложений.ПередачаВложенийВФинансовыеАктивы") Тогда
		ОткрытьФорму("Документ.ВыбытиеФинансовыхВложений.Форма.ПодборВложенийВФинансовыеАктивы",
			ПараметрыОткрытия, ЭтотОбъект, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ОткрытьФорму("Документ.ВыбытиеФинансовыхВложений.Форма.ПодборФинансовыхВложений",
			ПараметрыОткрытия, ЭтотОбъект, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

