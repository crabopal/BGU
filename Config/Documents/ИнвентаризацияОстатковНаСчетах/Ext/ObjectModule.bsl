#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Документы.ИнвентаризацияОстатковНаСчетах.ЗаполнитьСписокСчетовПоУмолчанию(ЭтотОбъект);
	
	ИнвентаризацияСервер.УстановитьДатуИнвентаризации(ДанныеЗаполнения, ЭтотОбъект);
	
	//---
	// Флажок <без ограничения>
	//---
	НастройкиМеханизма = Документы.ИнвентаризацияОстатковНаСчетах.ФлажокБезОграничения_ПолучитьНастройкиМеханизма();
	ОбщегоНазначенияБГУКлиентСервер.ФлажокБезОграничения_ИнициализироватьВсеФлажкиБезОграничения(ЭтотОбъект, НастройкиМеханизма, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = Остатки.Итог("СуммаРУ");
	
	РезультатПроверки = ИнвентаризацияСервер.СуществуютАналогичныеДокументы(ЭтотОбъект,
		"ДатаИнвентаризации,ДатаНачала,ДатаОкончания,Организация,Подразделение");
	
	Если РезультатПроверки.Существуют Тогда
		ОбщегоНазначения.СообщитьПользователю(
			РезультатПроверки.ТекстСообщения,
			Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ИнвентаризацияСервер.ПроверитьДатыИнвентаризации(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

