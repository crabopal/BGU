// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы = "ФормаВыбора" Тогда
		//чтобы при программном открытии формы выбора установился режим выбора
		Параметры.Вставить("РежимВыбора", Истина);
		ВыбраннаяФорма = Метаданные.Документы.ИнвентаризацияОстатковНаСчетах.Формы.ФормаСписка;
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСписокСчетовПоУмолчанию(ИсключитьГруппы = Истина) Экспорт
	
	СписокСчетовКазначейские	= БухгалтерскийУчет.СписокСчетов("201.10");
	СписокСчетовБанковские		= БухгалтерскийУчет.СписокСчетов("201.20");
	
	Если ИсключитьГруппы Тогда
		ИсключаемыеСчетаГруппы = БухгалтерскийУчет.СписокСчетов("201.10, 201.20",,Истина);
		
		ИсключитьСчетаГруппы(СписокСчетовКазначейские,	ИсключаемыеСчетаГруппы);
		ИсключитьСчетаГруппы(СписокСчетовБанковские,	ИсключаемыеСчетаГруппы);
	КонецЕсли;
	
	СписокСчетов = Новый Структура();
	СписокСчетов.Вставить("Казначейские",	СписокСчетовКазначейские);
	СписокСчетов.Вставить("Банковские",		СписокСчетовБанковские);
		
	Возврат СписокСчетов;
	
КонецФункции

Процедура ИсключитьСчетаГруппы(МассивСчетов, ИсключаемыеСчетаГруппы)
	
	Количество = МассивСчетов.Количество();
	
	Для Счетчик = 1 По Количество Цикл
		Индекс = Количество - Счетчик;
		
		Счет = МассивСчетов[Индекс];
		
		Если ИсключаемыеСчетаГруппы.Найти(Счет) <> Неопределено Тогда
			МассивСчетов.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьОбозначениеИзТипаЛицевогоСчета(ТипЛицевогоСчета)
	
	Если ТипЛицевогоСчета = 1 Тогда
		Возврат "Казначейский";
	ИначеЕсли ТипЛицевогоСчета = 2 Тогда
		Возврат "Банковский";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Форма 0504082 (инвентаризационная опись остатков на счетах учета денежных средств)
Функция	ПечатьФормы0504082(МассивСсылок, ОбъектыПечати)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабДокумент.КлючПараметровПечати= "ПАРАМЕТРЫ_ПЕЧАТИ_ИнвентаризацияОстатковНаСчетах_ф0504082";
	
	// Используемый макет:
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИнвентаризацияОстатковНаСчетах.ПФ_MXL_Ф0504082");
	
	// Настраиваем запросы:
	Запросы = Новый Запрос;
	Запросы.УстановитьПараметр("МассивСсылок", МассивСсылок);
	Запросы.УстановитьПараметр("ТекстБезОграниченияКФО", НСтр("ru='без ограничения'"));
	Запросы.УстановитьПараметр("ТекстБезОграниченияИФО", НСтр("ru='без ограничения'"));
	Запросы.УстановитьПараметр("ТекстПустоеЗначениеИФО", НСтр("ru='<пустое значение>'"));
	
	Запросы.УстановитьПараметр("ТекстТипЛицевогоСчетаКазначейский",		НСтр("ru='Казначейский'"));
	Запросы.УстановитьПараметр("ТекстТипЛицевогоСчетаБанковский",		НСтр("ru='Банковский'"));
	Запросы.УстановитьПараметр("ТекстТипЛицевогоСчетаБезОграничения",	НСтр("ru='без ограничения'"));
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаРУКод = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВалютаРУ, "Код");
	Запросы.УстановитьПараметр("ВалютаРУ",		ВалютаРУ);
	Запросы.УстановитьПараметр("ВалютаРУКод",	ВалютаРУКод);

	Запросы.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Список счетов (для вывода отбора по счетам)
	|//
	|ВЫБРАТЬ
	|	ТЧ.Ссылка						КАК ДокСсылка,
	|	ТЧ.Счет							КАК Счет,
	|	ВЫБОР
	|		КОГДА ТЧ.Счет В	(
	|			ВЫБРАТЬ ПЕРВЫЕ 1
	|				ЕПСБУ.Родитель
	|			ИЗ
	|				ПланСчетов.ЕПСБУ	КАК ЕПСБУ
	|			ГДЕ
	|				ЕПСБУ.Родитель = ТЧ.Счет)	ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ							КАК ЭтоГруппа
	|ИЗ
	|	Документ.ИнвентаризацияОстатковНаСчетах.СписокСчетов	КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка В (&МассивСсылок)
	|	И ТЧ.УчаствуетВРасчетах
	|УПОРЯДОЧИТЬ ПО
	|	ТЧ.Счет.Порядок
	|ИТОГИ ПО
	|	// Обязательно первые итоги по ссылке на документ:
	|	ТЧ.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Таблица инвентаризационной комиссии
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка					КАК ДокСсылка,
	|	ТЧ.ДолжностьЧленаКомиссии	КАК ДолжностьЧленаКомиссии,
	|	ТЧ.ФамилияЧленаКомиссии		КАК ФамилияЧленаКомиссии,
	|	ТЧ.ИмяЧленаКомиссии			КАК ИмяЧленаКомиссии,
	|	ТЧ.ОтчествоЧленаКомиссии	КАК ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ИнвентаризацияОстатковНаСчетах.СоставКомиссии	КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка В (&МассивСсылок)
	|ИТОГИ ПО
	|	// Обязательно первые итоги по ссылке на документ:
	|	ТЧ.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Шапка документа
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка							КАК ДокСсылка,
	|	Док.Дата							КАК Дата,
	|	Док.ДатаИнвентаризации				КАК ДатаИнвентаризации,
	|	Док.Номер							КАК Номер,
	|	Док.Организация						КАК Организация,
