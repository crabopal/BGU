	|	Док.Организация.КодОКПО				КАК КодОКПО,
	|	Док.Подразделение.Представление		КАК Подразделение,
	|	Док.НомерПриказаИнвентаризации		КАК НомерПриказаИнвентаризации,
	|	Док.ДатаПриказаИнвентаризации		КАК ДатаПриказаИнвентаризации,
	|	Док.ДатаНачала						КАК ДатаНачала,
	|	Док.ДатаОкончания					КАК ДатаОкончания,
	|	Док.ДолжностьПредседателяКомиссии	КАК ДолжностьПредседателяКомиссии,
	|	Док.ФамилияПредседателяКомиссии		КАК ФамилияПредседателяКомиссии,
	|	Док.ИмяПредседателяКомиссии			КАК ИмяПредседателяКомиссии,
	|	Док.ОтчествоПредседателяКомиссии	КАК ОтчествоПредседателяКомиссии,
	|	Док.МестоИнвентаризации				КАК МестоИнвентаризации,
	|	Док.ПричинаИнвентаризации			КАК ПричинаИнвентаризации,
	|	Док.ЗаключениеКомиссии				КАК ЗаключениеКомиссии,
	|	Док.ДатаПодписиКомиссии				КАК ДатаПодписиКомиссии,
	|	
	|	// Часть отбора:
	|	Док.КФО								КАК КФО,
	|	Док.ПечататьОтбор					КАК ПечататьОтбор,
	|	ВЫБОР
	|		КОГДА Док.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка) ТОГДА
	|			&ТекстБезОграниченияКФО
	|		ИНАЧЕ
	|			Док.КФО
	|	КОНЕЦ								КАК ОтборКФО,
	|	ВЫБОР
	|		КОГДА Док.БезУчетаИФО = ИСТИНА ТОГДА
	|			&ТекстБезОграниченияИФО
	|		ИНАЧЕ
	|			ВЫБОР
	|				КОГДА Док.ИФО = ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка) ТОГДА
	|					&ТекстПустоеЗначениеИФО
	|				ИНАЧЕ
	|					Док.ИФО
	|			КОНЕЦ
	|	КОНЕЦ								КАК ОтборИФО,
	|	ВЫБОР
	|		КОГДА Док.ТипЛицевогоСчета = 1 ТОГДА
	|			&ТекстТипЛицевогоСчетаКазначейский
	|		КОГДА Док.ТипЛицевогоСчета = 2 ТОГДА
	|			&ТекстТипЛицевогоСчетаБанковский
	|		ИНАЧЕ
	|			&ТекстТипЛицевогоСчетаБезОграничения
	|	КОНЕЦ								КАК ОтборТипЛицевогоСчета
	|ИЗ
	|	Документ.ИнвентаризацияОстатковНаСчетах	КАК Док
	|ГДЕ
	|	Док.Ссылка В (&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Таблица данных документа
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка								КАК ДокСсылка,
	|	
	|	ТЧ.НомерЛицевогоСчета					КАК НомерСчета,
	|	ТЧ.РазделЛицевогоСчета.Наименование		КАК РазделЛицевогоСчета,
