	|		КОГДА ТЧ.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) ИЛИ ТЧ.Валюта = &ВалютаРУ ТОГДА
	|			&ВалютаРУКод
	|		ИНАЧЕ
	|			ТЧ.Валюта.Код
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТЧ.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) ИЛИ ТЧ.Валюта = &ВалютаРУ ИЛИ ТЧ.Кратность = 0 ТОГДА
	|			0
	|		ИНАЧЕ
	|			ТЧ.Курс / ТЧ.Кратность
	|	КОНЕЦ
	|УПОРЯДОЧИТЬ ПО
	|	МИНИМУМ(ТЧ.НомерСтроки)
	|ИТОГИ
	|	СУММА(Сумма)						КАК Сумма
	|ПО
	|	// Обязательно первые итоги по ссылке на документ:
	|	ДокСсылка
	|;";
	
	Результаты = Запросы.ВыполнитьПакет();
	
	ВыборкаДокОтборСчета	= Результаты[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаДокКомиссия		= Результаты[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаШапка			= Результаты[2].Выбрать();
	ВыборкаДокТаблица		= Результаты[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Выборки по документам:
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		// Продвигаемся в остальных выборках до текущего документа:
		ПоискТекущегоДокумента = Новый Структура("ДокСсылка", ВыборкаШапка["ДокСсылка"]);
		ВыборкаДокКомиссия.Сбросить();
		ВыборкаДокТаблица.Сбросить();
		ВыборкаДокОтборСчета.Сбросить();
		ЕстьВыборкаДокКомиссия			= ВыборкаДокКомиссия.НайтиСледующий(ПоискТекущегоДокумента);
		ЕстьВыборкаДокТаблица			= ВыборкаДокТаблица.НайтиСледующий(ПоискТекущегоДокумента);
		ЕстьВыборкаДокОтборСчета		= ВыборкаДокОтборСчета.НайтиСледующий(ПоискТекущегоДокумента);
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		// Запомним номер строки, с которой начали выводить текущий документ:
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		// Используемые области макета:
		ОбластьОтборКФО					= Макет.ПолучитьОбласть("ОтборКФО");
		ОбластьОтборИФО					= Макет.ПолучитьОбласть("ОтборИФО");
		ОбластьОтборСписокСчетов		= Макет.ПолучитьОбласть("ОтборСписокСчетов");
		ОбластьОтборТипЛицевогоСчета	= Макет.ПолучитьОбласть("ОтборТипЛицевогоСчета");
		ОбластьТитул					= Макет.ПолучитьОбласть("Титул");
		ОбластьШапка					= Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока					= Макет.ПолучитьОбласть("Строка");
		ОбластьИтогоПоСтранице			= Макет.ПолучитьОбласть("ИтогоПоСтранице");
		ОбластьИтого					= Макет.ПолучитьОбласть("Итого");
		ОбластьЗаключение				= Макет.ПолучитьОбласть("Заключение");
		ОбластьКомиссия					= Макет.ПолучитьОбласть("Комиссия");
		ОбластьДатаПодписиКомиссии		= Макет.ПолучитьОбласть("ДатаПодписиКомиссии");
		ОбластьНомерСтраницы			= Макет.ПолучитьОбласть("НомерСтраницы");
		
		// Страница 1.
		НомерСтраницы  = 1;
		НПП = 1;
		
		//---
		// Титул
		//---
		// Полный счет учета:
		КодСчета = "000.00";
		Если ЕстьВыборкаДокОтборСчета Тогда
			// Код счета:
			Выборка = ВыборкаДокОтборСчета.Выбрать();
			Если Выборка.Количество() = 1 Тогда
				Выборка.Следующий();
				КодСчета = Строка(Выборка["Счет"]);
			КонецЕсли;
			
			// Восстанавливаем выборку списка счетов:
			ВыборкаДокОтборСчета.Сбросить();
			ЕстьВыборкаДокОтборСчета = ВыборкаДокОтборСчета.НайтиСледующий(ПоискТекущегоДокумента);
		КонецЕсли;
		КФО = ВыборкаШапка["КФО"];
		КодКФО = ?(ЗначениеЗаполнено(КФО), Строка(КФО), "0");
		Параметр_ПолныйНомерСчета = "00000000000000000." + КодКФО + "." + КодСчета + ".000";
		
		// Заполняем значения параметров выводимой области:
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("ПолныйНомерСчета",	Параметр_ПолныйНомерСчета);
		ЗначенияПараметров.Вставить("Дата",				ВыборкаШапка["ДатаИнвентаризации"]);
		
		ОбластьТитул.Параметры.Заполнить(ВыборкаШапка);
		ОбластьТитул.Параметры.Заполнить(ЗначенияПараметров);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьТитул);
		
		//---
		// Отбор
		//---
		Если ВыборкаШапка["ПечататьОтбор"] Тогда
			
			// 1. Текст для отбора счетов:
			Если ЕстьВыборкаДокОтборСчета Тогда
				
				Текст = "";
				
				// Цикл по конкретным счетам:
				ВыборкаОтборСчетаДетальные = ВыборкаДокОтборСчета.Выбрать();
				СтавитьЗапятую = Ложь;
				Пока ВыборкаОтборСчетаДетальные.Следующий() Цикл
					Текст = Текст
						+ ?(СтавитьЗапятую, ", ", "")
						+ ?(ВыборкаОтборСчетаДетальные["ЭтоГруппа"], "(Группа) " , "")
						+ ВыборкаОтборСчетаДетальные["Счет"];
					
					СтавитьЗапятую = Истина;
				КонецЦикла;
				
			Иначе
				Текст = НСтр("ru='счета не указаны'");
				
			КонецЕсли;
			// Заполняем значения параметров выводимой области:
			ЗначенияПараметров = Новый Структура("ОтборСписокСчетов", Текст);
			ОбластьОтборСписокСчетов.Параметры.Заполнить(ЗначенияПараметров);
			
			// 2. Отборы по КФО, ИФО, Типу лицевого счета:
			ЗначенияПараметров = Новый Структура("ОтборКФО, ОтборИФО, ОтборТипЛицевогоСчета");
			ЗаполнитьЗначенияСвойств(ЗначенияПараметров, ВыборкаШапка);
			// Заполняем значения параметров выводимой области:
			ОбластьОтборКФО.Параметры.Заполнить(ЗначенияПараметров);
			ОбластьОтборИФО.Параметры.Заполнить(ЗначенияПараметров);
			ОбластьОтборТипЛицевогоСчета.Параметры.Заполнить(ЗначенияПараметров);
			
			// Выводим все области отборов:
			ТабДокумент.Вывести(ОбластьОтборКФО);
			Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
				ТабДокумент.Вывести(ОбластьОтборИФО);
			КонецЕсли;
			ТабДокумент.Вывести(ОбластьОтборСписокСчетов);
			ТабДокумент.Вывести(ОбластьОтборТипЛицевогоСчета);
			
		КонецЕсли; // ПечататьОтбор
		
		//---
		// Инвентаризационная комиссия
		//---
		// (заполняем область, но выводим не сейчас, а позже):
		ОбластьВсяКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(
			ВыборкаШапка,
			ВыборкаДокКомиссия.Выбрать(), 
			ОбластьКомиссия, 
			3);
			
		//---
		// Итого
		//---
		// (заполняем область, но выводим не сейчас, а позже):
		ОбластьИтого.Параметры.Заполнить(ВыборкаДокТаблица);
			
		//---
		// Шапка таблицы
		//---
		// Заполняем значения параметров выводимой области:
		ЗначенияПараметров = Новый Структура("ДатаТаб", Формат(ВыборкаШапка.ДатаИнвентаризации, "ДФ=dd.MM.yyyy"));
		ОбластьШапка.Параметры.Заполнить(ЗначенияПараметров);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьШапка);
		
		//---
		// Строки
		//---
		// Итоги по странице:
		ИтогоПоСтраницеСуммаРУ = 0;
		
		Если ЕстьВыборкаДокТаблица Тогда
			
			Выборка = ВыборкаДокТаблица.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				//// Если нужно, пропускаем строку:
				//Если ТолькоДетальныеЗаписи И
				//	НЕ Выборка.ТипЗаписи() = ТипЗаписиЗапроса.ДетальнаяЗапись Тогда
				//	Продолжить;
				//КонецЕсли;
				
				// Заполняем значения параметров выводимых областей.
				// Строка:
				Параметр_НаименованиеБанка = Выборка["НаименованиеБанка"];
				РазделЛицевогоСчета = Выборка["РазделЛицевогоСчета"];
				Если ЗначениеЗаполнено(РазделЛицевогоСчета) Тогда
					Параметр_НаименованиеБанка = Параметр_НаименованиеБанка + ": " + РазделЛицевогоСчета;
				КонецЕсли;
				ЗначениеПараметров = Новый Структура("НПП, НаименованиеБанка",
					НПП,
					Параметр_НаименованиеБанка);
				ОбластьСтрока.Параметры.Заполнить(Выборка);
				ОбластьСтрока.Параметры.Заполнить(ЗначениеПараметров);
				// Итого по странице:
				ЗначениеПараметров = Новый Структура("Сумма", ИтогоПоСтраницеСуммаРУ);
				ОбластьИтогоПоСтранице.Параметры.Заполнить(ЗначениеПараметров);
				
				
				// Очередная строка помещается на лист по высоте?
				МассивОбластей = Новый Массив();
				МассивОбластей.Добавить(ОбластьСтрока);
				МассивОбластей.Добавить(ОбластьИтого);
				МассивОбластей.Добавить(ОбластьЗаключение);
				МассивОбластей.Добавить(ОбластьВсяКомиссия);
				МассивОбластей.Добавить(ОбластьДатаПодписиКомиссии);			
				Если НЕ ТабДокумент.ПроверитьВывод(МассивОбластей) Тогда
					
					// Завершаем текущую страницу:
					ТабДокумент.Вывести(ОбластьИтогоПоСтранице);
					
					// Обнуляем итоги по странице:
					ИтогоПоСтраницеСуммаРУ = 0;
						
					// Начинаем новую страницу:
					ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					НомерСтраницы = НомерСтраницы + 1;
					ЗначенияПараметров = Новый Структура("НомерСтраницы", НомерСтраницы);
					ОбластьНомерСтраницы.Параметры.Заполнить(ЗначенияПараметров);
					ТабДокумент.Вывести(ОбластьНомерСтраницы);
					ТабДокумент.Вывести(ОбластьШапка);
					
				КонецЕсли;
				
				// Выводим область:
				ТабДокумент.Вывести(ОбластьСтрока);
				
				// Итоги по странице:
				ИтогоПоСтраницеСуммаРУ = ИтогоПоСтраницеСуммаРУ + Выборка["Сумма"];
				
				НПП = НПП + 1;
				
			КонецЦикла;
		КонецЕсли;
		
		//---
		// Итого
		//---
		// Выводим область:
		ТабДокумент.Вывести(ОбластьИтого);
		
		//---
		// Заключение комиссии
		//---
		ТабДокумент.Вывести(ОбластьЗаключение);
		
		ОбластьЗаключениеКомиссии = СформироватьЗаключениеКомиссии(ВыборкаШапка.ЗаключениеКомиссии, Макет);
		ТабДокумент.Вывести(ОбластьЗаключениеКомиссии);
		
		//---
		// Инвентаризационная комиссия, Подвал
		//---
		ТабДокумент.Вывести(ОбластьВсяКомиссия);
		
		КомпонентыДатыДляПодписи = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(ВыборкаШапка.ДатаПодписиКомиссии);
		
		ОбластьДатаПодписиКомиссии.Параметры.Заполнить(КомпонентыДатыДляПодписи);
		ТабДокумент.Вывести(ОбластьДатаПодписиКомиссии);
		
	КонецЦикла; // ВыборкаШапка	
	
	Возврат ТабДокумент;
	
КонецФункции

Функция СформироватьЗаключениеКомиссии(Текст, Макет)
	
	БлокиСтрок = Неопределено;
	
	// Блок 1
	ИнвентаризацияСервер.ДобавитьОписаниеБлокаСтрок(БлокиСтрок, 1, 110, "ЗаключениеКомиссииСтрока1");
	
	// Блок 2
	ИнвентаризацияСервер.ДобавитьОписаниеБлокаСтрок(БлокиСтрок, , 140, "ЗаключениеКомиссииСтрока2");
	
	МинимальноеКоличествоСтрок = 3;
	
	Возврат ИнвентаризацияСервер.РазбитьТекстНаБлокиСтрокИВывестиВТабличныйДокумент(Текст, БлокиСтрок, Макет, МинимальноеКоличествоСтрок);
	
КонецФункции

#КонецОбласти

#КонецЕсли
