&НаКлиенте
Процедура СписокСчетовПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекДанные = Элементы["СписокСчетов"].ТекущиеДанные;
	
	Если НЕ ТекДанные = Неопределено И НЕ ОтменаРедактирования Тогда
		
		ТекСчет = ТекДанные["Счет"];
		
		// В новой строке, если заполнен счет, то автоматически устанавливаем флажок "Участвует":
		Если НоваяСтрока И ЗначениеЗаполнено(ТекСчет) Тогда
			ТекДанные["УчаствуетВРасчетах"] = Истина;
		ИначеЕсли НЕ ЗначениеЗаполнено(ТекСчет) Тогда
			ТекДанные["УчаствуетВРасчетах"] = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
