&НаСервере
Процедура НастроитьФормуСервер()
	
	// Для нового документа:
	Если Объект.Ссылка.Пустая() Тогда
		
		// Этот документ создан копированием?
		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			// Это копия существующего документа.
			// Очищаем табличные части:
			Объект["Остатки"].Очистить();
			
			// Выводим сообщение:	
			ТекстСообщения = НСтр("ru='Этот документ был создан путем копирования другого документа. Поэтому некоторые табличные части и реквизиты копии были очищены.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				Объект.Ссылка);
		КонецЕсли;
		
	КонецЕсли;
	
	//---
	// Флажок <без ограничения>
	//---
	НастройкиМеханизма = Документы.ИнвентаризацияРасчетовПоПоступлениям.ФлажокБезОграничения_ПолучитьНастройкиМеханизма();
	ОбщегоНазначенияБГУ.ФлажокБезОграничения_ИнициализироватьФорму(ЭтаФорма, НастройкиМеханизма);
	
	//---
	// "Предустановленные отборы" в параметрах выбора элементов "Счет" формы
	//---
	ПредустановленныеОтборы_Инициализация();
	ВходныеДанные = Новый Структура("ТипЛицевогоСчета, ПредустановленныеОтборы_Счет", Объект.ТипЛицевогоСчета, ПредустановленныеОтборы_Счет);
	ПредустановленныеОтборы_УстановитьПараметрыВыбораЭлементаСчет(Элементы["СписокСчетовСчет"], ВходныеДанные);
	
	// Настраиваем видимость колонок блока валюты
	НастроитьВидимостьКолонокВалютыСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПоляОрганизация()
	
	// Предложим очистить табличную часть, содержащую данные.
	
	ОстаткиЗаполнены = (Объект["Остатки"].Количество() > 0);
	
	Если ОстаткиЗаполнены Тогда
		ТекстВопроса = НСтр("ru='Изменение организации вызовет очистку
			|некоторых реквизитов, а также
			|всех табличных частей документа.
			|
			|Продолжить и сменить организацию?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПриИзмененииПоляОрганизация_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 40, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПриИзмененииПоляОрганизация_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		// Очищаем реквизиты документа
		ОчищающаяСтруктура = Новый Структура("
			|ДолжностьПредседателяКомиссии,
			|ФамилияПредседателяКомиссии,
			|ИмяПредседателяКомиссии,
			|ОтчествоПредседателяКомиссии,
			|НомерПриказаИнвентаризации,
			|ДатаПриказаИнвентаризации,
			|НомерПриказаКомиссии,
			|ДатаПриказаКомиссии");
		ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
		
		// Очищаем табличные части документа
		Объект.Остатки.Очистить();
		Объект.СоставКомиссии.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКурс(Знач ВалютаДокумента,Дата)
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, Дата);
КонецФункции
&НаКлиенте
Процедура ПересчитатьСуммуСтроки(ИзмененаСуммаРУ = Ложь)
	
	ТекДанные = Элементы["Остатки"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИзмененаСуммаРУ Тогда
		// Рассчитываем СуммуВал:
		ТекВалюта = ТекДанные["Валюта"];
		УстановитьСуммуВал = (ТекВалюта = ВалютаРУ)
			ИЛИ (ЗначениеЗаполнено(ТекВалюта)
				И НЕ ЗначениеЗаполнено(ТекДанные["СуммаВал"])
				И ЗначениеЗаполнено(ТекДанные["СуммаРУ"]));
		Если УстановитьСуммуВал Тогда
			Если ТекДанные["Курс"] = 0 Тогда
				СуммаВал = 0;
			Иначе
				СуммаВал = ТекДанные["СуммаРУ"] * ТекДанные["Кратность"] / ТекДанные["Курс"];
			КонецЕсли;
			ТекДанные["СуммаВал"] = СуммаВал;
		КонецЕсли;
		
	Иначе
		// Рассчитываем СуммуРУ:
		Если ТекДанные["Кратность"] = 0 Тогда
			СуммаРУ = 0;
		Иначе;
			СуммаРУ = ТекДанные["СуммаВал"] * ТекДанные["Курс"] / ТекДанные["Кратность"];
		КонецЕсли;
		ТекДанные["СуммаРУ"] = СуммаРУ;
		
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура НастроитьТипЗначенияКассовогоОргана()
	
	ОбозначениеТипа = ПолучитьОбозначениеИзТипаЛицевогоСчета(Объект.ТипЛицевогоСчета);
	
	Если ОбозначениеТипа = "Казначейский" Тогда
		КассовыйОрган_ПустаяСсылка = ПредопределенноеЗначение("Справочник.Казначейства.ПустаяСсылка");
			
	ИначеЕсли ОбозначениеТипа = "Банковский" Тогда
		КассовыйОрган_ПустаяСсылка = ПредопределенноеЗначение("Справочник.Банки.ПустаяСсылка");
		
	Иначе
		// <без ограничения>
		КассовыйОрган_ПустаяСсылка = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает 0, 1 или 2 (соответствует списку выбора элемента ТипЛицевогоСчета).
//	ОбозначениеТипа = "Казначейский", "Банковский", <Любая другая строка>
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьТипЛицевогоСчетаИзОбозначения(ОбозначениеТипа)
	
	Если ОбозначениеТипа = "Казначейский" Тогда
		Возврат 1;
	ИначеЕсли ОбозначениеТипа = "Банковский" Тогда
		Возврат 2;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции
// Возвращает "Казначейский", "Банковский", "".
//	ТипЛицевогоСчета = 0, 1 или 2 (соответствует списку выбора элемента ТипЛицевогоСчета)
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьОбозначениеИзТипаЛицевогоСчета(ТипЛицевогоСчета)
	
	Если ТипЛицевогоСчета = 1 Тогда
		Возврат "Казначейский";
	ИначеЕсли ТипЛицевогоСчета = 2 Тогда
		Возврат "Банковский";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции


// Устанавливает значение флага "ВключитьВидимостьКолонокВалюты" (реквизит формы).
&НаСервере
Процедура ОпределитьНеобходимостьВключитьВидимостьКолонокВалютыСервер(ТекущийОбъект)
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	
	// Если в табличной части уже есть строки, в которых валюта
	// отличается от регламентированной, то колонки скрывать не нужно:
	ТаблЧасть = ТекущийОбъект["Остатки"];
	Если НЕ ИспользоватьВалютныйУчет И ТаблЧасть.Количество() > 0 Тогда
		ЗапросВалюта = Новый Запрос();
		ЗапросВалюта.УстановитьПараметр("ТЗ", ТаблЧасть.Выгрузить(, "Валюта"));
		ЗапросВалюта.УстановитьПараметр("ВалютаРУ", Константы.ВалютаРегламентированногоУчета.Получить());
		ЗапросВалюта.Текст = "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТЗ.Валюта	КАК Валюта
		|ПОМЕСТИТЬ
		|	ВалютыДокумента
		|ИЗ
		|	&ТЗ	КАК ТЗ
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТЗ.Валюта	КАК Валюта
		|ИЗ
		|	ВалютыДокумента	КАК ТЗ
		|ГДЕ
		|	НЕ ТЗ.Валюта = &ВалютаРУ
		|	И НЕ ТЗ.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|;";
		
		// Устанавливаем особый флаг:
		ЭтаФорма["ВключитьВидимостьКолонокВалюты"] = НЕ ЗапросВалюта.Выполнить().Пустой();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьКолонокВалютыСервер()
	
	ВидимостьКолонок = ВключитьВидимостьКолонокВалюты
		ИЛИ ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
		
	ИменаЭлементов = Новый Структура("
		|ОстаткиСуммаВал,
		|ОстаткиВалюта,
		|ОстаткиКурс,
		|ОстаткиКратность");
	Для Каждого Элем Из ИменаЭлементов Цикл
		Элементы[Элем.Ключ].Видимость = ВидимостьКолонок;
	КонецЦикла;
	
КонецПроцедуры

// КакоеПолеИзменилось = "ЛицевойСчет" или "РеквизитыЛицевогоСчета".
&НаКлиенте
Процедура ОбновитьПоляСвязанныеСЛицевымСчетом(КакоеПолеИзменилось)
	
	ТекДанные = Элементы["Остатки"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если КакоеПолеИзменилось = "ЛицевойСчет" Тогда
		// Обновляем значения полей:
		//	- РазделЛицевогоСчета
		//	- РеквизитыЛицевогоПоля
		//	- КассовыйОрган
		//	- НомерЛицевогоСчета
		
		ЛицевойСчет = ТекДанные["ЛицевойСчет"];

		ОбновляющаяСтруктура = Новый Структура("КассовыйОрган, НомерЛицевогоСчета");
		
		Если ЗначениеЗаполнено(ЛицевойСчет) Тогда
			ОбновляющаяСтруктура = ЗначенияСвойствЛицевогоСчета(ЛицевойСчет);
		КонецЕсли;
		
	ИначеЕсли КакоеПолеИзменилось = "РеквизитыЛицевогоСчета" Тогда
		// Обновляем значения полей:
		//	- КассовыйОрган
		
		РеквизитыЛицевогоСчета = ТекДанные["РеквизитыЛицевогоСчета"];
		
		ОбновляющаяСтруктура = Новый Структура("КассовыйОрган");
		
		Если ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
			ОбновляющаяСтруктура.Вставить("КассовыйОрган", КассовыйОрганЛицевогоСчета(РеквизитыЛицевогоСчета));
		КонецЕсли;
		
	Иначе
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ОбновляющаяСтруктура);
	
КонецПроцедуры

// Передаваемая ссылка должна быть обязательно заполнена.
&НаСервереБезКонтекста
Функция ЗначенияСвойствЛицевогоСчета(ЛицевойСчет)
	
	Результат = Новый Структура("
		|РазделЛицевогоСчета,
		|РеквизитыЛицевогоСчета,
		|КассовыйОрган,
		|НомерЛицевогоСчета");
	
	Если ЗначениеЗаполнено(ЛицевойСчет) Тогда
		ЗапросСвойства = Новый Запрос();
		ЗапросСвойства.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
		ЗапросСвойства.Текст = "
		|////////////////////////////////////////////////////////////////////////////////
		|// [0]. Искомые данные, часть 1/2
		|//
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Ссылка			КАК РеквизитыЛицевогоСчета,
		|	КассовыйОрган	КАК КассовыйОрган,
		|	Владелец.Код	КАК НомерЛицевогоСчета
		|ИЗ
		|	Справочник.РеквизитыЛицевыхСчетов
		|ГДЕ
		|	Владелец = &ЛицевойСчет
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|// [1]. Искомые данные, часть 2/2
		|//
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Ссылка			КАК РазделЛицевогоСчета
		|ИЗ
		|	Справочник.РазделыЛицевыхСчетов
		|ГДЕ
		|	Владелец = &ЛицевойСчет
		|;";
		РезультатыЗапросов = ЗапросСвойства.ВыполнитьПакет();
		Результат0 = РезультатыЗапросов[0];
		Результат1 = РезультатыЗапросов[1];
		Если НЕ Результат0.Пустой() Тогда
			Выборка = Результат0.Выбрать();
			Выборка.Следующий();
			ЗаполнитьЗначенияСвойств(Результат, Выборка);
			Результат["НомерЛицевогоСчета"] = СокрЛП(Результат["НомерЛицевогоСчета"]);
		КонецЕсли;
		Если НЕ Результат1.Пустой() Тогда
			Выборка = Результат1.Выбрать();
			Выборка.Следующий();
			ЗаполнитьЗначенияСвойств(Результат, Выборка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
// Передаваемая ссылка должна быть обязательно заполнена.
&НаСервереБезКонтекста
Функция КассовыйОрганЛицевогоСчета(РеквизитыЛицевогоСчета)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыЛицевогоСчета, "КассовыйОрган");
	
КонецФункции

//-----------------------------------------------------------------------
// "Предустановленные отборы" в параметрах выбора элементов "Счет" формы

// Заполняет используемые варианты отбора и записывает в реквизит "ПредустановленныеОтборы_Счет".
// На этой форме отбор счета однозначно определяется значением реквизита "ВидНФА".
//
// Возвращает отборы вида:
// (Группа "И")
//		*	Ссылка ВСпискеПоИерархии (СписокСчетов)
//		*	ЭлементГруппа=Ложь
//
//	Тип лицевого счета		СписокСчетов
//	------------------------------------
//	(Казначейский)			201.10, 304.05
//	(Банковский)			201.20
//	(без ограничения)		201.10, 304.05, 201.20
&НаСервере
Процедура ПредустановленныеОтборы_Инициализация()
	
	// Кодирование типа лицевого счета:
	ТипКазначейский		= ПолучитьТипЛицевогоСчетаИзОбозначения("Казначейский");
	ТипБанковский		= ПолучитьТипЛицевогоСчетаИзОбозначения("Банковский");
	ТипБезОграничения	= ПолучитьТипЛицевогоСчетаИзОбозначения("");
	
	СписокСчетовПоУмолчанию = Новый ФиксированнаяСтруктура(Документы.ИнвентаризацияОстатковНаСчетах.ПолучитьСписокСчетовПоУмолчанию());
	
	ВремСоответствие = Новый Соответствие();
	
	КлючиСоответствия = Новый Массив();
	КлючиСоответствия.Добавить(ТипКазначейский);
	КлючиСоответствия.Добавить(ТипБанковский);
	КлючиСоответствия.Добавить(ТипБезОграничения);
	
	Для Каждого КлючСоответствия Из КлючиСоответствия Цикл
		
		Если КлючСоответствия = ТипКазначейский Тогда
			СписокСчетов = СписокСчетовПоУмолчанию.Казначейские;
			
		ИначеЕсли КлючСоответствия = ТипБанковский Тогда
			СписокСчетов = СписокСчетовПоУмолчанию.Банковские;
			
		Иначе
			СписокСчетов = Новый Массив();
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокСчетов, СписокСчетовПоУмолчанию.Казначейские);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокСчетов, СписокСчетовПоУмолчанию.Банковские);
		КонецЕсли;
		
		НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных();
		Отбор = НастройкиКомпоновки.Отбор;
		
		// Группа "И":
		ГруппаИ = Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		ГруппаИ.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		// В ИЕРАРХИИ (СписокСчетов):
		НовыйЭлемент = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии;
		НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
		НовыйЭлемент.ПравоеЗначение = Новый ФиксированныйМассив(СписокСчетов);
		// ЭлементГруппа = ЛОЖЬ:
		НовыйЭлемент = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭлементГруппа");
		НовыйЭлемент.ПравоеЗначение = Ложь;
		
		// Получаем представление отбора:
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, НастройкиКомпоновки);
		ПредставлениеОтбора = ЗаписьXML.Закрыть();
		
		// Запоминаем текст отбора, соответствующий текущему ключу:
		ВремСоответствие.Вставить(КлючСоответствия, ПредставлениеОтбора);
		
	КонецЦикла;
	
	// Запоминаем подготовленные тексты отборов:
	ПредустановленныеОтборы_Счет = Новый ФиксированноеСоответствие(ВремСоответствие);
	
КонецПроцедуры
// Устанавливает параметр выбора "ПредустановленныйОтбор" указанного элемента.
&НаКлиентеНаСервереБезКонтекста
Процедура ПредустановленныеОтборы_УстановитьПараметрыВыбораЭлементаСчет(ЭлементСчет, ВходныеДанные)
	
	ПредустановленныеОтборы_Счет	= ВходныеДанные["ПредустановленныеОтборы_Счет"];
	ТипЛицевогоСчета				= ВходныеДанные["ТипЛицевогоСчета"];
	
	// Согласно ВходнымДанным получаем текст отбора:
	ТекстОтбора = ПредустановленныеОтборы_Счет.Получить(ТипЛицевогоСчета);
	Если ТекстОтбора = Неопределено Тогда
		// Такому значению ключа не соответствует никакой текст отбора.
		// Используем текст отбора для другого ключа:
		ТипЛицевогоСчета = 0; // Значение <без ограничения>
		ТекстОтбора = ПредустановленныеОтборы_Счет.Получить(ТипЛицевогоСчета);
	КонецЕсли;
	Если ТекстОтбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Устанавливаем параметр выбора:
	НовыйПараметр = Новый ПараметрВыбора("ПредустановленныйОтбор", ТекстОтбора);
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	ЭлементСчет.ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
	
КонецПроцедуры

//--------------------------------------------------------------------------------
// Заполнение таблиц

&НаКлиенте
Функция НеобходимыеРеквизитыЗаполнены()

	// Проверим корректность входных данных для заполнения.
	
	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Поле ""Огранизация"" не заполнено'"),
			Объект.Ссылка,
			"Объект.Организация");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаИнвентаризации) Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не указана дата проведения инвентаризации'"),
			Объект.Ссылка,
			"Объект.ДатаИнвентаризации");
	КонецЕсли;
		
	// Количество счетов, участвующих в расчетах, должно быть больше 0:
	ФильтрСписокСчетов = Новый Массив();
	Для Каждого СтрокаСчета Из Объект["СписокСчетов"] Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаСчета.Счет) ИЛИ СтрокаСчета.УчаствуетВРасчетах = Ложь Тогда
			Продолжить;
		Иначе
			ФильтрСписокСчетов.Добавить(СтрокаСчета.Счет);
		КонецЕсли; 
	КонецЦикла; 
	Если ФильтрСписокСчетов.Количество() = 0 Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Таблица ""Список счетов"" не содержит выбранных счетов учета остатков денежных средств'"),
			Объект.Ссылка,
			"Объект.СписокСчетов");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИЗаполнитьСписокСчетовПоУмолчанию()
	
	Если Объект["СписокСчетов"].Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru='Перед заполнением табличная часть ""Счета учета"" будет очищена. Заполнить?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьСписокСчетовПоУмолчанию_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьСписокСчетовПоУмолчаниюКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьСписокСчетовПоУмолчанию_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьСписокСчетовПоУмолчаниюКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ЗаполнитьСписокСчетовПоУмолчаниюКлиент()
	
	ЗаполнитьСписокСчетовПоУмолчаниюСервер();
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьСписокСчетовПоУмолчаниюСервер()
	
	Документы.ИнвентаризацияОстатковНаСчетах.ЗаполнитьСписокСчетовПоУмолчанию(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымУчета()
	
	Если НеобходимыеРеквизитыЗаполнены() Тогда
		Если Объект["Остатки"].Количество() > 0 Тогда
			ТекстСообщения = НСтр("ru='Перед заполнением табличная часть ""Остатки денежных средств"" будет очищена. Продолжить?'");
			
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьПоДаннымУчета_Выбор", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
		Иначе
			ЗаполнитьПоДаннымУчетаКлиент();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымУчета_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоДаннымУчетаКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ЗаполнитьПоДаннымУчетаКлиент()
	
	ЗаполнитьПоДаннымУчетаНаСервере();
	
	// Если по данным учета не было добавлено ни одной строки, выведем сообщение:
	Если Объект["Остатки"].Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Остатки денежных средств, соответствующие условиям поиска, отсутствуют.'");
		
		ПоказатьПредупреждение(Неопределено, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьПоДаннымУчетаНаСервере()
	
	Документы.ИнвентаризацияОстатковНаСчетах.ЗаполнитьПоДаннымУчета(Объект);
	
	// Настраиваем видимость колонок блока валюты
	ОпределитьНеобходимостьВключитьВидимостьКолонокВалютыСервер(Объект);
	НастроитьВидимостьКолонокВалютыСервер();
	
КонецПроцедуры

#Область ОбработчикиСобытийПроцессыОбработкиДокументов

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокумента(Команда)
	ОбщегоНазначенияБГУКлиент.ВыполнитьЗадачу(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьЗадачуПоОбработкеДокументаОповещение(Контекст, ДополнительныеПараметры) Экспорт
	ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст);
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры, Контекст);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗадачуПоОбработкеДокументаНаСервере(Контекст)
	ОбщегоНазначенияБГУ.ВыполнитьЗадачу(ЭтотОбъект, Контекст, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийНаправившегоОткрытие(Элемент, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийНаправившегоОткрытие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КомментарийСледующемуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.КомментарийСледующемуНачалоВыбора(ЭтотОбъект, Элемент, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти
	
// РешениеОПроведенииИнвентаризации
&НаКлиенте
Процедура ЗакрытаФормаВыбораДанныхИзРешенияОПроведенииИнвентаризации(РезультатВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОписьПоРешениюОПроведенииИнвентаризацииСервер(РезультатВыбора);
	
	ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент(РезультатВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписьПоРешениюОПроведенииИнвентаризацииСервер(РезультатВыбора)
	
	ИнвентаризацияСервер.ЗаполнитьОписьПоРешениюИзФормыОписи(ЭтаФорма, РезультатВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент(РезультатВыбора)
	
	ИнвентаризацияКлиент.СообщитьОЗаполненииНаОснованииРешенияОПроведенииИнвентаризации();
	
КонецПроцедуры
// Конец РешениеОПроведенииИнвентаризации

