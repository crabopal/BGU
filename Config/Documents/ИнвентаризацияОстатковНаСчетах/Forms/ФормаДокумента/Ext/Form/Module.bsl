КонецПроцедуры


// ----- Остатки . Валюта -----
&НаКлиенте
Процедура ОстаткиВалютаПриИзменении(Элемент)
	
	ТекДанные = Элементы["Остатки"].ТекущиеДанные;
	
	КурсКратность		= ПолучитьКурс(ТекДанные.Валюта, Объект.Дата);
	ТекДанные.Курс		= КурсКратность.Курс;
	ТекДанные.Кратность	= КурсКратность.Кратность;
	
	Если ЗначениеЗаполнено(ТекДанные.Валюта) Тогда
		ИзмененаСуммаРУ = ЗначениеЗаполнено(ТекДанные["СуммаРУ"]) И НЕ ЗначениеЗаполнено(ТекДанные["СуммаВал"]);
		ПересчитатьСуммуСтроки(ИзмененаСуммаРУ);
	Иначе
		// При очистке валюты очищаем и СуммуВал:
		ТекДанные["СуммаВал"] = 0;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОстаткиСуммаВалПриИзменении(Элемент)
	
	ПересчитатьСуммуСтроки();
	
КонецПроцедуры
&НаКлиенте
Процедура ОстаткиКурсПриИзменении(Элемент)
	
	ПересчитатьСуммуСтроки();
	
КонецПроцедуры
&НаКлиенте
Процедура ОстаткиКратностьПриИзменении(Элемент)
	
	ПересчитатьСуммуСтроки();
	
КонецПроцедуры

