#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	НельзяПровести = НЕ (СуммаДокумента = РасшифровкаПлатежа.Итог("Сумма"))
				 ИЛИ НЕ (СуммаДокументаВВалюте = РасшифровкаПлатежа.Итог("СуммаВал"));
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И НельзяПровести Тогда
		
		Если СуммаДокументаВВалюте = РасшифровкаПлатежа.Итог("СуммаВал") Тогда
			ИмяПоля = "СуммаДокумента";
			НераспределеннаяСумма = Формат((СуммаДокумента - РасшифровкаПлатежа.Итог("Сумма")),"ЧДЦ=2");
		Иначе
			ИмяПоля = "СуммаДокументаВВалюте";
			НераспределеннаяСумма = Формат((СуммаДокументаВВалюте - РасшифровкаПлатежа.Итог("СуммаВал")),"ЧДЦ=2");
		КонецЕсли;
		
		ТекстСообщения = НСтр("ru='Проведение невозможно. Сумма документа не равна сумме расшифровки платежа. Не распределена сумма: '") + НераспределеннаяСумма;
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ИмяПоля, "Объект");
		
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПлатежноеПоручение")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КассовоеВыбытие") Тогда
		Документы.ПоручениеНаПокупкуВалюты.ЗаполнитьПоОснованию(ДанныеЗаполнения,ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	СостояниеЗаявки = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Ссылка);
	
	Если НЕ (СостояниеЗаявки.Статус = Перечисления.СтатусыИсполненияДокумента.Исполнен
		И ЗначениеЗаполнено(СостояниеЗаявки.ДатаПроведения)) Тогда
		МассивНепроверяемыхРеквизитов.Добавить("СуммаДокументаВВалюте");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПлатежноРасчетныеДокументы.ПриЗаписиНаСервереУстановкаСтатуса(Отказ, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли