
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ОчиститьСообщения();
	
	КомпонентаПодписи = Неопределено;	
	
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ПараметрКоманды",ПараметрКоманды);
			
		Оповещение = Новый ОписаниеОповещения("ПослеПодключенияКомпоненты_Xades2AddIn", ЭтотОбъект, ДопПараметры);
		ПараметрыПодключения = ОбщегоНазначенияКлиент.ПараметрыПодключенияКомпоненты();
		ПараметрыПодключения.ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
		                                        |внешняя компонента Xades2AddIn.'");
						
		ОбщегоНазначенияКлиент.ПодключитьКомпонентуИзМакета(Оповещение, "Xades2AddIn","ОбщийМакет.Компонента_xades", ПараметрыПодключения);

		Возврат;
	КонецЕсли;
	
	ПерейтиКФормированиюФайлов(ПараметрКоманды,КомпонентаПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияКомпоненты_Xades2AddIn(Результат, ДопПараметры) Экспорт
	
	КомпонентаПодписи = Неопределено;
    Если Результат.Подключено Тогда 
        КомпонентаПодписи = Результат.ПодключаемыйМодуль;    
	Иначе
		
		ТекстОшибки = Результат.ОписаниеОшибки;
        ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
				
		Возврат;
		
	КонецЕсли;
	
	Если КомпонентаПодписи = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не удалось создать компоненту для формирования электронной подписи.'");			
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
				
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЭтоLinuxКлиент() Тогда
		
		ПерсональныеНастройки = ЭлектроннаяПодписьКлиент.ПерсональныеНастройки();
		
		ДополнительныеПараметры = Новый Структура("СоответствиеПутей",ПерсональныеНастройки.ПутиКПрограммамЭлектроннойПодписиИШифрования);
		ДополнительныеПараметры.Вставить("ПараметрКоманды",ДопПараметры.ПараметрКоманды);
		ДополнительныеПараметры.Вставить("КомпонентаПодписи",КомпонентаПодписи);
		
		ПослеСозданияМК(Неопределено,ДополнительныеПараметры);
		Возврат;	
	КонецЕсли;
	
	ПерейтиКФормированиюФайлов(ДопПараметры.ПараметрКоманды,КомпонентаПодписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияМК(Результат,ДопПараметры)Экспорт
	Если Результат = Неопределено Тогда
		Если ДопПараметры.Свойство("ТекущаяПрограмма") Тогда
			ДопПараметры.СоответствиеПутей.Удалить(ДопПараметры.ТекущаяПрограмма);
		КонецЕсли;
		Для Каждого КлючИЗначение Из ДопПараметры.СоответствиеПутей Цикл
			ДопПараметры.Вставить("ТекущаяПрограмма",КлючИЗначение.Ключ);
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСозданияМК",ЭтотОбъект,ДопПараметры);
			ЭлектроннаяПодписьКлиент.СоздатьМенеджерКриптографии(ОписаниеОповещения,"",Ложь,КлючИЗначение.Ключ);
			Возврат;
		КонецЦикла;
	Иначе
		Результат = Неопределено;
		ПутьКПрограмме = ДопПараметры.СоответствиеПутей[ДопПараметры.ТекущаяПрограмма];
		ДопПараметры.КомпонентаПодписи.Криптопровайдер = ПутьКПрограмме;
	КонецЕсли;
	
	ПерейтиКФормированиюФайлов(ДопПараметры.ПараметрКоманды,ДопПараметры.КомпонентаПодписи);
КонецПроцедуры


&НаКлиенте
Процедура ПерейтиКФормированиюФайлов(ПараметрКоманды,КомпонентаПодписи)
	
	СоответствиеРезультатов = СформироватьФайлы(ПараметрКоманды);
	
	Подписывали = Ложь;
	Для Каждого КлючИЗначение Из СоответствиеРезультатов Цикл
		Если КлючИЗначение.Значение = Ложь Тогда
			//не подписали
			Продолжить;
		КонецЕсли;
		Подписывали = Истина;
		ГосУслугиКлиент.ПодписатьНачисления(КлючИЗначение.Значение,"Charge",КомпонентаПодписи);
	КонецЦикла;
	Если Подписывали Тогда
		СохранитьПодписьВРегистре(СоответствиеРезультатов);
		Оповестить("ПодписьНачислений");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СформироватьФайлы(МассивНачислений)
	
	СоответствиеРезультатовФормирования = Документы.КвитанцияНаОплатуГосуслуг.СформироватьФайлыДляПодписиДляМассиваНачислений(МассивНачислений);
	Для Каждого КлючИЗначение Из СоответствиеРезультатовФормирования Цикл
		
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("ТаблицаЗначений") Тогда	
			СоответствиеРезультатовФормирования.Вставить(КлючИЗначение.Ключ ,ОбщегоНазначения.ТаблицаЗначенийВМассив(КлючИЗначение.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СоответствиеРезультатовФормирования;
КонецФункции

&НаСервере 
Процедура СохранитьПодписьВРегистре(СоответствиеРезультатов)
	
	Для Каждого КлючИЗначение Из СоответствиеРезультатов Цикл
		Если КлючИЗначение.Значение = Ложь Тогда
			//не подписали
			Продолжить;
		КонецЕсли;	
		Документы.КвитанцияНаОплатуГосуслуг.СохранитьПодписьВРегистре(КлючИЗначение.Ключ,КлючИЗначение.Значение);
	КонецЦикла;
		
КонецПроцедуры
