#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("НеВыполнятьДействияПередЗаписью") Тогда
		Возврат;
	КонецЕсли;
	
	Если ПометкаУдаления Тогда
		ИДСтрокиДокументаОснования = "ДокументПомеченНаУдаление";
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Если БиблиотекаФункцийОбмена.СуществуетПодписанноеНачисление(Ссылка) Тогда
			// Если начисление подписано, ничего не меняем.
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО") Тогда
		Для Каждого СтрТЧ Из ТаблицаИдентификаторов Цикл
			Если СтрТЧ.ИмяВФайле = "UnifiedPayerIdentifier" 
				И (СтрТЧ.ТипПоля = "ЕдиныйИдентификатор" ИЛИ СтрТЧ.ТипПоля = "ЕдиныйИдентификаторУчащегося") Тогда
				СтрТЧ.Значение = ЕдиныйИдентификаторПлательщика;
				СтрТЧ.ПолеИдентификатор = ЕдиныйИдентификаторПлательщика;
			КонецЕсли;
			Если СтрТЧ.ИмяВФайле = "AltPayerIdentifier" 
				И (СтрТЧ.ТипПоля = "АльтернативныйИдентификаторУчащегося" ИЛИ СтрТЧ.ТипПоля = "АльтернативныйИдентификатор") Тогда
				СтрТЧ.Значение = АльтернативныйИдентификаторПлательщика;
				СтрТЧ.ПолеИдентификатор = АльтернативныйИдентификаторПлательщика;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//Заполним реквизиты, которых нет на форме	
	 
	РеквизитыОрг = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация,"НаименованиеСокращенное,Наименование,ОГРН");
	
	НаименованиеОрганизацииПолучателя = ?(ЗначениеЗаполнено(РеквизитыОрг.НаименованиеСокращенное),РеквизитыОрг.НаименованиеСокращенное,РеквизитыОрг.Наименование);
	
	ПолучательОГРН = РеквизитыОрг.ОГРН;
	
	РеквизитыЛС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛицевойСчет,"Код,ТипЛицевогоСчета");
	НомерЛицевоСчетаВУФК = "";
	КодУФК = "";
	Если РеквизитыЛС.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Казначейский Тогда
		НомерЛицевоСчетаВУФК = РеквизитыЛС.Код;
		КодУФК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыЛицевогоСчета,"КассовыйОрган.Код");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО") 
		ИЛИ ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП") Тогда
		
		Если НЕ ЗначениеЗаполнено(УникальныйИдентификаторНачисления)
			И ПометкаУдаления Тогда
			//Включена опция обмена с ГИС ГМП/ИС РНИП/ИС УНП, но у документа не заполнен УИН и у него пометка на удаление.
			//В этих условиях не будем проверять уникальность УИН, т.к. может это документ, созданный до начала обмена с ГИС ГМП.
			
		Иначе
		
			Отказ = ПроверитьУникальностьУИН();
			Если Отказ Тогда
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не уникален уникальный идентификатор начисления! Измените реквизиты, по которым формируется идентификатор.'"));
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПлатежноРасчетныеДокументы.ПриЗаписиНаСервереУстановкаСтатуса(Отказ, ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьУникальностьУИН()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслуг.Ссылка
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.Ссылка <> &Ссылка
		|	И КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления = &УникальныйИдентификаторНачисления";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("УникальныйИдентификаторНачисления", УникальныйИдентификаторНачисления);

	РезультатЗапроса = Запрос.Выполнить().Выбрать();

	Возврат(РезультатЗапроса.Количество() > 0);	
КонецФункции

Процедура СформироватьТаблицуИдентификаторов(ЗначениеНастройки) Экспорт

	Если ТипЗнч(ЗначениеНастройки)<>Тип("ХранилищеЗначения") Тогда
		Возврат;
	КонецЕсли;
	
	//Обработать таблицу идентификаторов
	ПолученноеЗначениеНастройки = ЗначениеНастройки.Получить();
	Если ТипЗнч(ПолученноеЗначениеНастройки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаИдн = ПолученноеЗначениеНастройки.ТаблицаИдентификаторов;
	Если ТаблицаИдн.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиОрганизации = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(ЭтотОбъект.Организация);
	ИдентификаторПо_1_16 = Ложь;
	ИдентификаторПо_2_00 = Ложь;
	Если НастройкиОрганизации.ВерсияФорматов="1.16" Тогда
		ИдентификаторПо_1_16 = Истина;
	ИначеЕсли НастройкиОрганизации.ВерсияФорматов="2.00" Тогда
		ИдентификаторПо_2_00 = Истина;
	КонецЕсли;
		
	Для Каждого СтрИдн Из ТаблицаИдн Цикл
		НовСтр = ЭтотОбъект.ТаблицаИдентификаторов.Добавить();
		НовСтр.ИмяВФайле = СтрИдн.ИмяПоля;
		НовСтр.Представление = СтрИдн.Представление;
		НовСтр.ТипПоля = СтрИдн.ТипПоля;
		НовСтр.РеквизитИдентификатор = СтрИдн.РеквизитИдентификатор;
		Если НовСтр.ТипПоля = "СправочникСсылка.Дети"
			ИЛИ НовСтр.ТипПоля = "ДопАльтИдентификатор_Ребенок" Тогда
			Если Тип("СправочникСсылка.Дети") = ТипЗнч(ЭтотОбъект.Учащийся) Тогда
				НовСтр.Значение = ЭтотОбъект.Учащийся;
			Иначе
				НовСтр.Значение = Справочники.Дети.ПустаяСсылка();
			КонецЕсли;
		ИначеЕсли НовСтр.ТипПоля = "СправочникСсылка.Студенты"
			ИЛИ НовСтр.ТипПоля = "ДопАльтИдентификатор_Учащийся" Тогда
			Если Тип("СправочникСсылка.Студенты") = ТипЗнч(ЭтотОбъект.Учащийся) Тогда
				НовСтр.Значение = ЭтотОбъект.Учащийся;
			Иначе
				НовСтр.Значение = Справочники.Студенты.ПустаяСсылка();
			КонецЕсли;
		ИначеЕсли НовСтр.ТипПоля = "СправочникСсылка.Договоры" Тогда
			НовСтр.Значение = ЭтотОбъект.Договор;
		ИначеЕсли НовСтр.ТипПоля = "СправочникСсылка.Контрагенты" Тогда
			НовСтр.Значение = ЭтотОбъект.Плательщик;
		КонецЕсли;
				
		Если (НовСтр.ТипПоля = "ЕдиныйИдентификатор" ИЛИ НовСтр.ТипПоля = "АльтернативныйИдентификатор") Тогда
			ТипИдентификатора = ?(НовСтр.ТипПоля = "ЕдиныйИдентификатор",Перечисления.ТипИдентификатораПолучателяГосуслуг.Единый,Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный);
			
			Если ИдентификаторПо_2_00 Тогда
				ТекИд = ИдентификаторПлательщикаГосуслуг_2_00(ЭтотОбъект.Плательщик, ЭтотОбъект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			ИначеЕсли ИдентификаторПо_1_16 Тогда
				ТекИд = ИдентификаторПлательщикаГосуслуг_1_16(ЭтотОбъект.Плательщик, ЭтотОбъект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			Иначе
				ТекИд = ИдентификаторПлательщикаГосуслуг(ЭтотОбъект.Плательщик, ЭтотОбъект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			КонецЕсли;
			
			НовСтр.Значение = ТекИд;
			НовСтр.ПолеИдентификатор = НовСтр.Значение;
			Если ЗначениеЗаполнено(НовСтр.Значение) Тогда
				Если ИдентификаторПо_2_00 Тогда
					Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ОсновнойИдентификаторПлательщика) Тогда
						ЭтотОбъект.ОсновнойИдентификаторПлательщика = НовСтр.Значение;
					ИначеЕсли НЕ ЗначениеЗаполнено(ЭтотОбъект.ДополнительныйИдентификаторПлательщика) Тогда
						ЭтотОбъект.ДополнительныйИдентификаторПлательщика = НовСтр.Значение;
					КонецЕсли;
				Иначе
					ЭтотОбъект[?(НовСтр.ТипПоля = "ЕдиныйИдентификаторУчащегося","ЕдиныйИдентификаторПлательщика","АльтернативныйИдентификаторПлательщика")] = НовСтр.Значение;
				КонецЕсли;
			КонецЕсли;
			
			Продолжить;
			
		ИначеЕсли (НовСтр.ТипПоля = "ЕдиныйИдентификаторУчащегося" ИЛИ НовСтр.ТипПоля = "АльтернативныйИдентификаторУчащегося") Тогда
			ТипИдентификатора = ?(НовСтр.ТипПоля = "ЕдиныйИдентификаторУчащегося",Перечисления.ТипИдентификатораПолучателяГосуслуг.Единый,Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный);
			Если ЗначениеЗаполнено(ЭтотОбъект.Учащийся) Тогда
				
				Если ИдентификаторПо_2_00 Тогда
					ТекИд = ИдентификаторПлательщикаГосуслуг_2_00(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Учащийся,"Контрагент"), ЭтотОбъект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
				ИначеЕсли ИдентификаторПо_1_16 Тогда
					ТекИд = ИдентификаторПлательщикаГосуслуг_1_16(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Учащийся,"Контрагент"), ЭтотОбъект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
				Иначе
					ТекИд = ИдентификаторПлательщикаГосуслуг(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Учащийся,"Контрагент"), ЭтотОбъект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
				КонецЕсли;
				
				НовСтр.Значение = ТекИд;
			Иначе
				НовСтр.Значение = "";
			КонецЕсли;
			НовСтр.ПолеИдентификатор = НовСтр.Значение;
			Если ЗначениеЗаполнено(НовСтр.Значение) Тогда
				Если ИдентификаторПо_2_00 Тогда
					Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ОсновнойИдентификаторПлательщика) Тогда
						ЭтотОбъект.ОсновнойИдентификаторПлательщика = НовСтр.Значение;
					ИначеЕсли НЕ ЗначениеЗаполнено(ЭтотОбъект.ДополнительныйИдентификаторПлательщика) Тогда
						ЭтотОбъект.ДополнительныйИдентификаторПлательщика = НовСтр.Значение;
					КонецЕсли;
				Иначе
					ЭтотОбъект[?(НовСтр.ТипПоля = "ЕдиныйИдентификаторУчащегося","ЕдиныйИдентификаторПлательщика","АльтернативныйИдентификаторПлательщика")] = НовСтр.Значение;
				КонецЕсли;
			КонецЕсли;
			
			Продолжить;
			
		ИначеЕсли НовСтр.ТипПоля = "ДопАльтИдентификатор" Тогда
			ТипИдентификатора = Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный;
			
			Если ИдентификаторПо_2_00 Тогда
				ТекИд = ИдентификаторПлательщикаГосуслуг_2_00(ЭтотОбъект.Плательщик, ЭтотОбъект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			ИначеЕсли ИдентификаторПо_1_16 Тогда
				ТекИд = ИдентификаторПлательщикаГосуслуг_1_16(ЭтотОбъект.Плательщик, ЭтотОбъект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			Иначе
				ТекИд = ИдентификаторПлательщикаГосуслуг(ЭтотОбъект.Плательщик, ЭтотОбъект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			КонецЕсли;
			
			НовСтр.Значение = ТекИд;
			НовСтр.ПолеИдентификатор = НовСтр.Значение;
						
			Продолжить;
			
		ИначеЕсли НовСтр.ТипПоля = "ДопАльтИдентификатор_Ребенок"
			ИЛИ НовСтр.ТипПоля = "ДопАльтИдентификатор_Учащийся" Тогда
			ТипИдентификатора = Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный;
			ИспользуемыйКонтрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НовСтр.Значение,"Контрагент");
			
			Если ИдентификаторПо_2_00 Тогда
				ТекИд = ИдентификаторПлательщикаГосуслуг_2_00(ИспользуемыйКонтрагент, ЭтотОбъект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			ИначеЕсли ИдентификаторПо_1_16 Тогда
				ТекИд = ИдентификаторПлательщикаГосуслуг_1_16(ИспользуемыйКонтрагент, ЭтотОбъект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			Иначе
				ТекИд = ИдентификаторПлательщикаГосуслуг(ИспользуемыйКонтрагент, ЭтотОбъект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			КонецЕсли;
			
			НовСтр.ПолеИдентификатор = ТекИд;
						
			Продолжить;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НовСтр.РеквизитИдентификатор) И ЗначениеЗаполнено(НовСтр.Значение) Тогда
			НовСтр.ПолеИдентификатор = Документы.КвитанцияНаОплатуГосуслуг.ПолучитьЗначениеИдентификатора(НовСтр.РеквизитИдентификатор,НовСтр.Значение,ЭтотОбъект.Дата);
		Иначе
			НовСтр.ПолеИдентификатор = "";
		КонецЕсли;
	КонецЦикла;
	
	//при заполнении идентификатора по формату 2.0, заполним идентификатор по формату 1.16 - т.к. пока действуют оба формата
	Если ЗначениеЗаполнено(ЭтотОбъект.ОсновнойИдентификаторПлательщика) Тогда
			
		Если Лев(ЭтотОбъект.ОсновнойИдентификаторПлательщика,1) = "1" Тогда
			//физлица
