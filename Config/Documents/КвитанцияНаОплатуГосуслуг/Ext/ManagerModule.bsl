// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Функция ПолучитьЗначениеИдентификатора(Знач ИмяРеквизита,Знач ЗначениеРеквизита,Знач Дата) Экспорт
	Попытка
		ИмяРеквизита = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяРеквизита, ".");
		Элемент = ЗначениеРеквизита;
		
		ОбработкаДопРеквизита = Ложь;
		ОбработкаДопСведений = Ложь;
		ОбработкаХарактеристики = Ложь;
		Для каждого ТекИмяРеквизита Из ИмяРеквизита Цикл
			Если ТекИмяРеквизита = "ДополнительныеРеквизиты" Тогда
				ОбработкаДопРеквизита = Истина;
				Продолжить;
				
			ИначеЕсли ОбработкаДопРеквизита Тогда
				
				ИмяДопРеквизита = Сред(ТекИмяРеквизита,2,СтрДлина(ТекИмяРеквизита)-2);
				Элемент = БиблиотекаФункцийОбмена.ПолучитьЗначениеДополнительногоРеквизитаСправочника(Элемент,ИмяДопРеквизита);
				ОбработкаДопРеквизита = Ложь;
				
			ИначеЕсли ТекИмяРеквизита = "ДополнительныеСведения" Тогда
				ОбработкаДопСведений = Истина;
				Продолжить;
				
			ИначеЕсли ОбработкаДопСведений Тогда
				
				ИмяДопРеквизита = Сред(ТекИмяРеквизита,2,СтрДлина(ТекИмяРеквизита)-2);
				Элемент = БиблиотекаФункцийОбмена.ПолучитьЗначениеДополнительныхСведений(Элемент,ИмяДопРеквизита);
				ОбработкаДопСведений = Ложь;
				
			ИначеЕсли ТекИмяРеквизита =  "ХарактеристикиОбязательства" Тогда
				ОбработкаХарактеристики = Истина;
				Продолжить;
				
			ИначеЕсли ОбработкаХарактеристики Тогда
				
				ИмяДопРеквизита = Сред(ТекИмяРеквизита,2,СтрДлина(ТекИмяРеквизита)-2);
				Элемент = БиблиотекаФункцийОбмена.ПолучитьХарактеристикуОбязательста(Элемент,ИмяДопРеквизита,Дата);
				ОбработкаХарактеристики = Ложь;
				
			ИначеЕсли ТекИмяРеквизита = "[УчетныйНомерОбязательства]" Тогда
				Элемент = БиблиотекаФункцийОбмена.УчетныйНомерОбязательства(Элемент);
				
			Иначе
				Элемент =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент, ТекИмяРеквизита);
			КонецЕсли;
			
		КонецЦикла;
		ПолеИдентификатор = Элемент;
	Исключение
		ПолеИдентификатор = "";
	КонецПопытки;	
	Возврат ПолеИдентификатор;
КонецФункции


