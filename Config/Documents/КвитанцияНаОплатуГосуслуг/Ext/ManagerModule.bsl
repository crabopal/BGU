//Новая ПД4
Функция ПечатьПД4_20140101(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_КвитанцияНаОплатуГосуслуг_" + ИмяМакета;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет."+ИмяМакета);
	
	НужноПечататьQRКод = Прав(ИмяМакета,2)= "QR";
	
	ПечататьПоДвеКвитанцииНаЛист = Ложь;
	Попытка
		ОбластьНастроекПечати = Макет.ПолучитьОбласть("НастройкиПечати");
		ПечататьПоДвеКвитанцииНаЛист = Найти(ВРег(ОбластьНастроекПечати.Область(1,4).Текст),"ДА")>0; 
	Исключение
		ПечататьПоДвеКвитанцииНаЛист = Ложь;
	КонецПопытки;
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	КвитанцияНаОплатуГосуслуг.*,
	|	ФизическиеЛица.СтраховойНомерПФР КАК СНИЛС,
	|	КвитанцияНаОплатуГосуслуг.Плательщик.ВидКонтрагента КАК ВидКонтрагента,
	|	КвитанцияНаОплатуГосуслуг.Учащийся.Представление КАК ФИОРебенка,
	|	КвитанцияНаОплатуГосуслуг.Учащийся.Код КАК НомерЛицевогоСчетаПлательщика,
	|	КвитанцияНаОплатуГосуслуг.Договор.НомерДоговора КАК НомерДоговора,
	|	КвитанцияНаОплатуГосуслуг.КодОКАТО КАК КодОКТМО,
	|	КвитанцияНаОплатуГосуслуг.Плательщик.Представление КАК ПлательщикФИО,
	|	КвитанцияНаОплатуГосуслуг.Плательщик.ЮридическоеФизическоеЛицо.ИНН КАК ИННПлательщика,
	|	Выбор Когда КвитанцияНаОплатуГосуслуг.Плательщик.ВидКонтрагента = Значение(Перечисление.ЮрФизЛицо.ЮрЛицо) 
	|   Тогда ЮридическиеЛицаКонтактнаяИнформация.Представление
	|	Иначе ФизическиеЛицаКонтактнаяИнформация.Представление
	|	Конец КАК ПлательщикАдрес,
	|	ВЫБОР
	|   	КОГДА КвитанцияНаОплатуГосуслуг.СуммаДокумента = 0 
	|			ТОГДА 0
	|       ИНАЧЕ
	|			ВЫРАЗИТЬ(КвитанцияНаОплатуГосуслуг.СуммаДокумента - 0.5 КАК ЧИСЛО(15, 0)) 
	|	КОНЕЦ  КАК СуммаРуб,
	|	ВЫБОР
	|   	КОГДА КвитанцияНаОплатуГосуслуг.СуммаДокумента = 0 
	|			ТОГДА 0
	|       ИНАЧЕ
	|			(КвитанцияНаОплатуГосуслуг.СуммаДокумента - (ВЫРАЗИТЬ(КвитанцияНаОплатуГосуслуг.СуммаДокумента - 0.5 КАК ЧИСЛО(15, 0)))) * 100 
	|	КОНЕЦ КАК СуммаКоп,
	|	КвитанцияНаОплатуГосуслуг.ВидОбменаДляQRКода КАК ВидОбменаДляQRКода,
	|	КвитанцияНаОплатуГосуслуг.ФорматОбменаДляQRКода КАК ФорматОбменаДляQRКода
	|ИЗ
	|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	|			ПО КвитанцияНаОплатуГосуслуг.Плательщик.ЮридическоеФизическоеЛицо = ФизическиеЛицаКонтактнаяИнформация.Ссылка
	|			И ФизическиеЛицаКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|			И ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица.КонтактнаяИнформация КАК ЮридическиеЛицаКонтактнаяИнформация
	|			ПО КвитанцияНаОплатуГосуслуг.Плательщик.ЮридическоеФизическоеЛицо = ЮридическиеЛицаКонтактнаяИнформация.Ссылка
	|			И ЮридическиеЛицаКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|			И ЮридическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
	|			ПО КвитанцияНаОплатуГосуслуг.Плательщик.ЮридическоеФизическоеЛицо = ФизическиеЛица.Ссылка
	|ГДЕ
	|	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивОбъектов)
	|УПОРЯДОЧИТЬ ПО
	|	ПлательщикФИО,
	|	ФИОРебенка");
	
	
	Запрос.УстановитьПараметр("МассивОбъектов",МассивОбъектов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВыводитьРазделитель = Ложь;
	
	ЕстьГИСГМП = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
	ТонкаяЛиния = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
	НомДок = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Если ПечататьПоДвеКвитанцииНаЛист Тогда
			Если ВыводитьРазделитель И НомДок%2=0 Тогда 
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
		Иначе
			Если ВыводитьРазделитель Тогда 
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
		КонецЕсли;
		
		ВыводитьРазделитель = Истина;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Квитанция = Макет.ПолучитьОбласть("Квитанция");
		
		ЗаполнитьЗначенияСвойств(Квитанция.Параметры, Выборка);
		
		Если ЗначениеЗаполнено(Выборка.УникальныйИдентификаторНачисления) Тогда
			Для Инд = 1 По 25 Цикл
				//Кв
				ТекСимвол = Сред(Выборка.УникальныйИдентификаторНачисления,Инд,1);
				Если ЗначениеЗаполнено(ТекСимвол) И СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(ТекСимвол) Тогда				
					ТекОбласть = Квитанция.Область("С"+Инд);
					ТекОбласть.ГраницаСнизу = ТонкаяЛиния;
				КонецЕсли;
				Квитанция.Параметры.Заполнить(Новый Структура("С"+Инд,ТекСимвол));
				//ТабличныйДокумент.Присоединить(ТекОбласть);
			КонецЦикла;
		КонецЕсли;
		
		Если НужноПечататьQRКод Тогда
			
			ОшибкаЗаполнения = Ложь;
			
			QRСтрока = "";
			
			Если ЗначениеЗаполнено(Выборка.ВидОбменаДляQRКода) И  ЗначениеЗаполнено(Выборка.ФорматОбменаДляQRКода) Тогда
				QRСтрока = ПолучитьСтрокуQRПоПравилуОбмена(ОшибкаЗаполнения, Выборка);
			Иначе
				QRСтрока = ПолучитьСтрокуQRПоВстроенномуАлгоритму(ОшибкаЗаполнения, Выборка);
			КонецЕсли;
			
			Если НЕ ОшибкаЗаполнения Тогда
				
				Если НЕ ПустаяСтрока(QRСтрока) Тогда
					
					
					ДанныеQRКода = ГенерацияШтрихкода.ДанныеQRКода(QRСтрока, 1, 300);
					
					Если НЕ ТипЗнч(ДанныеQRКода) = Тип("ДвоичныеДанные") Тогда
						
						Шаблон = Нстр("ru = 'Не удалось сформировать QR-код для документа %1.
						|Технические подробности см. в журнале регистрации.'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
						Выборка.Ссылка);
						
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
						
						Продолжить;
					КонецЕсли;
					
					КартинкаQRКода = Новый Картинка(ДанныеQRКода);
					
					Квитанция.Рисунки.QRКодСправа.Картинка = КартинкаQRКода;
					
				Иначе
					//уберем QR код из макета, т.к. в нем тестовые данные
					Квитанция.Рисунки.QRКодСправа.Картинка = Новый Картинка;
				КонецЕсли;
				
			Иначе
				//уберем QR код из макета, т.к. в нем тестовые данные
				Квитанция.Рисунки.QRКодСправа.Картинка = Новый Картинка;	
			КонецЕсли;
			
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(Квитанция);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
		НомДок = НомДок + 1;
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

//Старая ПД4
Функция ПечатьПД4(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_КвитанцияНаОплатуГосуслуг_" + ИмяМакета;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет."+ИмяМакета);
	
	ПечататьПоДвеКвитанцииНаЛист = Ложь;
	Попытка
		ОбластьНастроекПечати = Макет.ПолучитьОбласть("НастройкиПечати");
		ПечататьПоДвеКвитанцииНаЛист = Найти(ВРег(ОбластьНастроекПечати.Область(1,4).Текст),"ДА")>0; 
	Исключение
		ПечататьПоДвеКвитанцииНаЛист = Ложь;
	КонецПопытки;
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	КвитанцияНаОплатуГосуслуг.*,
	|	КвитанцияНаОплатуГосуслуг.Плательщик.Представление КАК ПлательщикФИО,
	|	КвитанцияНаОплатуГосуслуг.Плательщик.ЮридическоеФизическоеЛицо.ИНН КАК ИННПлательщика,
	|   ФизическиеЛицаКонтактнаяИнформация.Представление КАК ПлательщикАдрес,
	|	ВЫБОР
	|   	КОГДА КвитанцияНаОплатуГосуслуг.СуммаДокумента = 0 
	|			ТОГДА 0
	|       ИНАЧЕ
	|			ВЫРАЗИТЬ(КвитанцияНаОплатуГосуслуг.СуммаДокумента - 0.5 КАК ЧИСЛО(15, 0)) 
	|	КОНЕЦ  КАК СуммаРуб,
	|	ВЫБОР
	|   	КОГДА КвитанцияНаОплатуГосуслуг.СуммаДокумента = 0 
	|			ТОГДА 0
	|       ИНАЧЕ
	|			(КвитанцияНаОплатуГосуслуг.СуммаДокумента - (ВЫРАЗИТЬ(КвитанцияНаОплатуГосуслуг.СуммаДокумента - 0.5 КАК ЧИСЛО(15, 0)))) * 100 
	|	КОНЕЦ КАК СуммаКоп
	|ИЗ
	|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	|	ПО КвитанцияНаОплатуГосуслуг.Плательщик.ЮридическоеФизическоеЛицо = ФизическиеЛицаКонтактнаяИнформация.Ссылка
	|	И ФизическиеЛицаКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|	И ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица)
	|ГДЕ
	|	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивОбъектов)
	|");
	
	
	Запрос.УстановитьПараметр("МассивОбъектов",МассивОбъектов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВыводитьРазделитель = Ложь;
	
	ЕстьГИСГМП = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
	
	НомДок = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Если ПечататьПоДвеКвитанцииНаЛист Тогда
			Если ВыводитьРазделитель И НомДок%2=0 Тогда 
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
		Иначе
			Если ВыводитьРазделитель Тогда 
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
		КонецЕсли;
		ВыводитьРазделитель = Истина;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Квитанция = Макет.ПолучитьОбласть("Квитанция");
		
		ЗаполнитьЗначенияСвойств(Квитанция.Параметры, Выборка);
		Если ЕстьГИСГМП Тогда
			ТекНазначениеПлатежа = Новый Структура("НазначениеПлатежа");
			ТекНазначениеПлатежа.НазначениеПлатежа = Выборка.НазначениеПлатежа+" ///УИН"+Выборка.УникальныйИдентификаторНачисления+?(ЗначениеЗаполнено(Выборка.ЕдиныйИдентификаторПлательщика),";ИП"+Выборка.ЕдиныйИдентификаторПлательщика,"");
			ЗаполнитьЗначенияСвойств(Квитанция.Параметры, ТекНазначениеПлатежа);	
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(Квитанция);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
		НомДок = НомДок + 1;
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

Функция СформироватьТаблицуНастроек(ИмяМакета)
	
	ТаблицаНастроек = Новый ТаблицаЗначений;
	ТаблицаНастроек.Колонки.Добавить("ИмяПоказателя");
	ТаблицаНастроек.Колонки.Добавить("НомерСтроки");
	ТаблицаНастроек.Колонки.Добавить("НомерГрафы");
	
	ОбластьНастройки = ПолучитьОбщийМакет(ИмяМакета).ПолучитьОбласть("Настройки");
	ВысотаОбласти    = ОбластьНастройки.ВысотаТаблицы;
	
	Для к = 1 по ВысотаОбласти Цикл
		НоваяСтрока = ТаблицаНастроек.Добавить();
		НоваяСтрока.НомерСтроки   = Число(ОбластьНастройки.ПолучитьОбласть(к,1).ТекущаяОбласть.Текст);
		НоваяСтрока.НомерГрафы    = Число(ОбластьНастройки.ПолучитьОбласть(к,2).ТекущаяОбласть.Текст);
		НоваяСтрока.ИмяПоказателя = ОбластьНастройки.ПолучитьОбласть(к,3).ТекущаяОбласть.Текст;
	КонецЦикла;
	
	Возврат ТаблицаНастроек;
	
КонецФункции

//Новое заявление
Процедура ЗаполнитьКвадратики20140101(Таблица,ТаблицаНастроек,НазвПоказателя, Значение, Длина, НомСтроки)
	ТонкаяЛиния = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
	ДлинаЗначения    = СтрДлина(Значение);
	ПоправкаВысоты   = (НомСтроки-1)*89;
	СтруктураПоиска  = Новый Структура;
	СтруктураПоиска.Вставить("ИмяПоказателя", НазвПоказателя);
	МассивСтрокНастройки = ТаблицаНастроек.НайтиСтроки(СтруктураПоиска);
	Если МассивСтрокНастройки.Количество()>0 Тогда
		СтрокаНастройки = МассивСтрокНастройки[0];
		С  = СтрокаНастройки.НомерГрафы;
		R  = СтрокаНастройки.НомерСтроки;
		ПоправкаКолонки = 0;   
		СтрокаПараметров = 0;
		Для инд = 0 По Длина-1 Цикл  
			Если инд > ДлинаЗначения Тогда
				Символ = " ";
			Иначе
				Символ = Сред(Значение,инд+1,1);
			КонецЕсли;      
			ТекКолонка =  С + ПоправкаКолонки;
			ТекСтрока  =  R + ПоправкаВысоты;
			Если С + ПоправкаКолонки > 43 Тогда
				Если СтрокаПараметров<=МассивСтрокНастройки.Количество() Тогда
					СтрокаПараметров = СтрокаПараметров+1;
					СтрокаНастройки = МассивСтрокНастройки[СтрокаПараметров];
					С  = СтрокаНастройки.НомерГрафы;
					R  = СтрокаНастройки.НомерСтроки;
					ПоправкаКолонки = 0;
					ТекКолонка =  С;
					ТекСтрока  =  R + ПоправкаВысоты;
				Иначе
					Возврат;
				КонецЕсли;
			КонецЕсли;
			Таблица.Область(ТекСтрока,ТекКолонка,ТекСтрока,ТекКолонка).Текст = Символ;
			Если НазвПоказателя = "УИН_" Тогда				
				Если ЗначениеЗаполнено(СокрЛП(Символ)) И СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(Символ) Тогда
					Таблица.Область(ТекСтрока,ТекКолонка,ТекСтрока,ТекКолонка).ГраницаСнизу = ТонкаяЛиния;	
				КонецЕсли;
			КонецЕсли;
			
			ПоправкаКолонки = ПоправкаКолонки+1;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Функция формирует табличный документ с печатными формами заявлений
// в СберБанк
// Возвращаемое значение:
//  Табличный документ - табличный документ с печатными формами квитанций
//
Функция ПечатьСбербанка20140101(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_КвитанцияНаОплатуГосуслуг_СберБанк20140101";
	//ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.СберБанк20140101");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КвитанцияНаОплатуГосуслуг.Номер,
	|	КвитанцияНаОплатуГосуслуг.Дата,
	//
	|	ФизическиеЛица.СтраховойНомерПФР КАК СНИЛС,
	|	КвитанцияНаОплатуГосуслуг.Плательщик.ВидКонтрагента КАК ВидКонтрагента,
	|	КвитанцияНаОплатуГосуслуг.Учащийся.Представление КАК ФИОРебенка,
	|	КвитанцияНаОплатуГосуслуг.Договор.НомерДоговора КАК НомерДоговора,
	|   ФизическиеЛицаКонтактнаяИнформация.Представление КАК ПлательщикАдрес,
	//
	|	КвитанцияНаОплатуГосуслуг.Организация КАК УчреждениеСсылка,
	|	КвитанцияНаОплатуГосуслуг.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	|	КвитанцияНаОплатуГосуслуг.ИННПолучателя КАК ИННПолучателя,
	|	КвитанцияНаОплатуГосуслуг.КПППолучателя КАК КПППолучателя,
	|	КвитанцияНаОплатуГосуслуг.ЛицевойСчет КАК ЛицевойСчетПолучателя,
	|	КвитанцияНаОплатуГосуслуг.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчетаПолучателя,
	|	КвитанцияНаОплатуГосуслуг.КодБКПлатежа КАК КБК,
	|	КвитанцияНаОплатуГосуслуг.КодОКАТО КАК КодОКАТО,
	|	КвитанцияНаОплатуГосуслуг.ЛицевойСчет.Код КАК ЛС,
	|	КвитанцияНаОплатуГосуслуг.ПолучательБанковскийСчет,
	|	КвитанцияНаОплатуГосуслуг.ПолучательБИКБанка,
	|	КвитанцияНаОплатуГосуслуг.ПолучательКазначейство,
	|	КвитанцияНаОплатуГосуслуг.ПолучательКорСчетБанка,
	|	КвитанцияНаОплатуГосуслуг.ПолучательНаименование,
	|	КвитанцияНаОплатуГосуслуг.ПолучательНаименованиеБанка,
	|	КвитанцияНаОплатуГосуслуг.НазначениеПлатежа,
	|	КвитанцияНаОплатуГосуслуг.СуммаДокумента,
	|	КвитанцияНаОплатуГосуслуг.Ссылка,
	|	КвитанцияНаОплатуГосуслуг.Плательщик.ЮридическоеФизическоеЛицо.ИНН КАК ПлательщикИНН,
	|	КвитанцияНаОплатуГосуслуг.Плательщик,
	|	КвитанцияНаОплатуГосуслуг.Плательщик.Представление КАК ПлательщикИмя,
	|	ВЫБОР
	|		КОГДА КвитанцияНаОплатуГосуслуг.Учащийся ССЫЛКА Справочник.Дети
	|			ТОГДА КвитанцияНаОплатуГосуслуг.Учащийся.Код
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК УчащийсяКод,
	|	КвитанцияНаОплатуГосуслуг.СтатусСоставителя,
	|	КвитанцияНаОплатуГосуслуг.ПоказательДаты,
	|	КвитанцияНаОплатуГосуслуг.ПоказательНомера,
	|	КвитанцияНаОплатуГосуслуг.ПоказательОснования,
	|	КвитанцияНаОплатуГосуслуг.ПоказательПериода,
	|	КвитанцияНаОплатуГосуслуг.ПоказательТипа,
	|	КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления
	|ИЗ
	|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	|			ПО КвитанцияНаОплатуГосуслуг.Плательщик.ЮридическоеФизическоеЛицо = ФизическиеЛицаКонтактнаяИнформация.Ссылка
	|			И ФизическиеЛицаКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|			И ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
	|			ПО КвитанцияНаОплатуГосуслуг.Плательщик.ЮридическоеФизическоеЛицо = ФизическиеЛица.Ссылка
	|ГДЕ
	|	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивОбъектов)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВыводитьРазделитель = Ложь;
	Ном = 1;
	ТаблицаНастроек  = СформироватьТаблицуНастроек("СберБанк20140101");
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.СуммаДокумента = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОшибкаЗаполнения = Ложь;
		
		Если НЕ ЗначениеЗаполнено(Выборка.ЛицевойСчетПолучателя) Тогда
			ТекстСообщения = Нстр("ru = 'Не заполнен обязательный реквизит: ""Лицевой счет""'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Выборка.Ссылка);
			ОшибкаЗаполнения = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.ПолучательНаименование) Тогда
			ТекстСообщения = Нстр("ru = 'Не заполнен обязательный реквизит получателя: ""Получатель""'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Выборка.Ссылка);
			ОшибкаЗаполнения = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.ПолучательБанковскийСчет) Тогда
			ТекстСообщения = Нстр("ru = 'Не заполнен обязательный реквизит получателя: ""Счет""'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Выборка.Ссылка);
			ОшибкаЗаполнения = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.ПолучательНаименованиеБанка) Тогда
			ТекстСообщения = Нстр("ru = 'Не заполнен обязательный реквизит получателя: ""Банк""'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Выборка.Ссылка);
			ОшибкаЗаполнения = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.ПолучательБИКБанка) Тогда
			ТекстСообщения = Нстр("ru = 'Не заполнен обязательный реквизит получателя: ""БИК""'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Выборка.Ссылка);
			ОшибкаЗаполнения = Истина;
		КонецЕсли;
		
		Если ОшибкаЗаполнения Тогда
			Продолжить;
		КонецЕсли;
		
		
		Если ВыводитьРазделитель Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ВыводитьРазделитель = Истина;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		РеквизитыПлатежа = Новый Структура("ТекстПолучателя,
		|НомерСчетаПолучателя,
		|НаименованиеБанкаПолучателя,
		|БИКБанкаПолучателя,
		|СчетБанкаПолучателя,
		|СуммаЧислом,
		|НазначениеПлатежа,
		|ИННПолучателя,
		|КПППолучателя,
		|ИННПлательщика,
		|КодБК,
		|КодОКТМО,
		|ФамилияПлательщика,
		|ИмяПлательщика,
		|ОтчествоПлательщика,
		|АдресПлательщика,
		|ФИОРебенка,
		|СНИЛС,
		|ИдентификаторНачисления,
		|НомерДоговора,
		|СтатусСоставителя,
		|ПоказательОснования,
		|ПоказательПериода,
		|ПоказательНомера,
		|ПоказательДаты,
		|ПоказательТипа,
		|ЛицевойСчетБюджетногоПолучателя,
		|НомерЛицевогоСчетаПлательщика,
		|Ссылка");
		
		РеквизитыПлатежа.Ссылка 						= Выборка.Ссылка;									
		РеквизитыПлатежа.ТекстПолучателя 				= Выборка.ПолучательНаименование;
		РеквизитыПлатежа.НомерСчетаПолучателя 			= Выборка.ПолучательБанковскийСчет;
		РеквизитыПлатежа.НаименованиеБанкаПолучателя 	= Выборка.ПолучательНаименованиеБанка;
		РеквизитыПлатежа.БИКБанкаПолучателя 			= Выборка.ПолучательБИКБанка;
		РеквизитыПлатежа.СчетБанкаПолучателя 			= Выборка.ПолучательКорСчетБанка; 
		
		РеквизитыПлатежа.СуммаЧислом 		= Выборка.СуммаДокумента;
		РеквизитыПлатежа.НазначениеПлатежа 	= Выборка.НазначениеПлатежа;
		
		РеквизитыПлатежа.ИННПолучателя  = Выборка.ИННПолучателя;
		РеквизитыПлатежа.КПППолучателя  = Выборка.КПППолучателя;
		РеквизитыПлатежа.КодБК 			= Выборка.КБК;
		РеквизитыПлатежа.КодОКТМО 		= Выборка.КодОКАТО;
		
		Если Выборка.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(Выборка.ПлательщикИмя);
			РеквизитыПлатежа.ФамилияПлательщика = ?(СтруктураФИО.Фамилия <> Неопределено, СтруктураФИО.Фамилия, "");
			РеквизитыПлатежа.ИмяПлательщика = ?(СтруктураФИО.Имя <> Неопределено, СтруктураФИО.Имя, "");
			РеквизитыПлатежа.ОтчествоПлательщика = ?(СтруктураФИО.Отчество <> Неопределено, СтруктураФИО.Отчество, "");
		КонецЕсли;
		РеквизитыПлатежа.АдресПлательщика = ?(ЗначениеЗаполнено(Выборка.ПлательщикАдрес),Выборка.ПлательщикАдрес,"");
		
		Если ЗначениеЗаполнено(Выборка.ФИОРебенка) Тогда
			РеквизитыПлатежа.ФИОРебенка = Выборка.ФИОРебенка;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.НомерДоговора) Тогда
			РеквизитыПлатежа.НомерДоговора = Выборка.НомерДоговора;	
		КонецЕсли;
		
		ТекСНИЛС = СокрЛП(Выборка.СНИЛС);
		Если СтрДлина(ТекСНИЛС)=14 Тогда
			РеквизитыПлатежа.СНИЛС = ТекСНИЛС;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.УникальныйИдентификаторНачисления) Тогда
			РеквизитыПлатежа.ИдентификаторНачисления = Выборка.УникальныйИдентификаторНачисления;	
		КонецЕсли;
		
		РеквизитыПлатежа.ИННПлательщика = Выборка.ПлательщикИНН;
		
		РеквизитыПлатежа.СтатусСоставителя   = Выборка.СтатусСоставителя;
		РеквизитыПлатежа.ПоказательОснования = Выборка.ПоказательОснования;
		РеквизитыПлатежа.ПоказательПериода   = Выборка.ПоказательПериода;
		РеквизитыПлатежа.ПоказательНомера    = Выборка.ПоказательНомера;
		РеквизитыПлатежа.ПоказательДаты   	 = Выборка.ПоказательДаты;//Посмотреть
		РеквизитыПлатежа.ПоказательТипа   	 = Выборка.ПоказательТипа;
		
		РеквизитыПлатежа.ЛицевойСчетБюджетногоПолучателя = Выборка.ЛС;
		
		РеквизитыПлатежа.НомерЛицевогоСчетаПлательщика = Выборка.УчащийсяКод;
		
		QRСтрока = УправлениеПечатью.ФорматнаяСтрокаУФЭБС(РеквизитыПлатежа);
		
		Если ПустаяСтрока(QRСтрока) Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеQRКода = ГенерацияШтрихкода.ДанныеQRКода(QRСтрока, 1, 300);
		
		Если НЕ ТипЗнч(ДанныеQRКода) = Тип("ДвоичныеДанные") Тогда
			
			Шаблон = Нстр("ru = 'Не удалось сформировать QR-код для документа %1.
			|Технические подробности см. в журнале регистрации.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
			Выборка.Ссылка);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
			Продолжить;
		КонецЕсли;
		ОбластьМакета = Макет.ПолучитьОбласть("Секция_1");
		
		КартинкаQRКода = Новый Картинка(ДанныеQRКода);
		
		ОбластьМакета.Рисунки.QRКод.Картинка = КартинкаQRКода;
		
		КодОКАТО                 = Выборка.КодОКАТО;    //Код ОКАТО и ОКТМО это одно и тоже поле в документе.
		ЛицевойСчетПолучателя    = Выборка.ЛицевойСчетПолучателя;
		РеквизитыЛицевогоСчетаПолучателя = Выборка.РеквизитыЛицевогоСчетаПолучателя;
		пКБК                     = Выборка.КБК;
		
		НаименованиеОрганизации  = Выборка.ПолучательНаименование;
		ИННПолучателя            = Выборка.ИННПолучателя;
		КПППолучателя            = Выборка.КПППолучателя;
		НомерРасчетногоСчета     = Выборка.ПолучательБанковскийСчет;
		НазваниеБанка            = Выборка.ПолучательНаименованиеБанка;
		БИК                      = Выборка.ПолучательБИКБанка;
		КоррСчет                 = СокрП(Выборка.ПолучательКорСчетБанка);
		СтрДлинаКоррСчет = СтрДлина(СокрЛП(КоррСчет));
		Для инд = СтрДлинаКоррСчет+1 По 20 Цикл
			КоррСчет = КоррСчет +"-";
		КонецЦикла;
		//ПредставлениеПериода = РаботаСДиалогами.ПолучитьПредставлениеПериодаРегистрации(КонецМесяца(Шапка.Дата))+" г.";
		//
		ЛС = Выборка.ЛС;
		СтрДлинаЛС = СтрДлина(СокрЛП(ЛС));
		Для инд = СтрДлинаЛС По 15 Цикл
			ЛС = ЛС +"-";
		КонецЦикла;
		//ДопСчет = "0000";
		
		ТипПлатежа = Выборка.ПоказательТипа;
		ОснованиеПлатежа = Выборка.ПоказательОснования;
		НалоговыйПериод = Выборка.ПоказательПериода;
		УИН = Выборка.УникальныйИдентификаторНачисления;
		Статус = Выборка.СтатусСоставителя;
		
		
		ТабличныйДокумент.Вывести(ОбластьМакета);
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"БИК_", БИК, 9,Ном);
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"КоррСчет_", КоррСчет, 20,Ном);
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"УчрБанка_", НазваниеБанка, 54,Ном);
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"РС_", НомерРасчетногоСчета, 20,Ном);
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"ОргНазв_",НаименованиеОрганизации,160,Ном);
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"ОргИНН_",ИННПолучателя,12,Ном);
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"КПП_",КПППолучателя,9,Ном);
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"ЛС_", ЛС,16,Ном);
		
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"ТипПл_", ТипПлатежа,2,Ном);
		
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"КБК_", пКБК,20,Ном);
		
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"ОснПл_", ОснованиеПлатежа,2,Ном);
		
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"ОКАТО_",КодОКАТО, 11,Ном);
		
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"НалПер_",НалоговыйПериод, 10,Ном);
		
		НазначениеПлатежа = СокрЛП(Выборка.НазначениеПлатежа);
		
		ПлательщикИмя   = "";
		ПлательщикАдрес = "";
		Плательщик         = Выборка.Плательщик;
		ПлательщикИНН      = Выборка.ПлательщикИНН;
		ДопИнф = Выборка.УчащийсяКод;
		Если ЗначениеЗаполнено(Плательщик) Тогда
			ПлательщикИмя   = Выборка.ПлательщикИмя;
			ПлательщикАдрес = Выборка.ПлательщикАдрес;
		КонецЕсли;	
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"ПлатИмя_",ПлательщикИмя,72,Ном);
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"УИН_",УИН, 36,Ном);   
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"ПлатАдр_",ПлательщикАдрес,72,Ном);  
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"ПлатИНН_",ПлательщикИНН,12,Ном);  
		
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"Статус_",Статус,2,Ном);
		
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"ДопИнф_",ДопИнф,15,Ном);
		
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"Назн_",НазначениеПлатежа,204,Ном);
		
		СуммаКОплате    = Выборка.СуммаДокумента;
		Рублей          = Цел(СуммаКОплате);
		Копеек          = (СуммаКОплате-Рублей)*100;
		Руб = Формат(Рублей,"ЧДЦ=0; ЧГ=0" );
		СтрДлинаРуб = СтрДлина(Руб);
		Для инд = СтрДлинаРуб+1 По 9 Цикл
			Руб = Руб+"-";
		КонецЦикла;
		Если Копеек <> 0 Тогда
			Коп = ?(Копеек<10,"0","")+Формат(Копеек,"ЧДЦ=0; ЧГ=0");
		Иначе
			Коп = "00";
		КонецЕсли;
		
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"Руб_",Руб,9,Ном);
		ЗаполнитьКвадратики20140101(ТабличныйДокумент,ТаблицаНастроек,"Коп_",Коп,2,Ном);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		Ном = Ном+1;
	КонецЦикла;
	
	ТабличныйДокумент.ПолеСправа          = 0;
	ТабличныйДокумент.ПолеСверху          = 0;
	ТабличныйДокумент.ПолеСнизу           = 0;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	//ТабличныйДокумент.МасштабПечати       = 70;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_КвитанцияНаОплатуГосуслуг_Сбербанк20140101";
	ТабличныйДокумент.ОриентацияСтраницы  = ОриентацияСтраницы.Портрет;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

//Старое заявление
Процедура ЗаполнитьКвадратики(Таблица,ТаблицаНастроек,НазвПоказателя, Значение, Длина, НомСтроки) 
	ДлинаЗначения    = СтрДлина(Значение);
	ПоправкаВысоты   = (НомСтроки-1)*82;
	СтруктураПоиска  = Новый Структура;
	СтруктураПоиска.Вставить("ИмяПоказателя", НазвПоказателя);
	МассивСтрокНастройки = ТаблицаНастроек.НайтиСтроки(СтруктураПоиска);
	Если МассивСтрокНастройки.Количество()>0 Тогда
		СтрокаНастройки = МассивСтрокНастройки[0];
		С  = СтрокаНастройки.НомерГрафы;
		R  = СтрокаНастройки.НомерСтроки;
		ПоправкаКолонки = 0;   
		СтрокаПараметров = 0;
		Для инд = 0 По Длина-1 Цикл  
			Если инд > ДлинаЗначения Тогда
				Символ = " ";
			Иначе
				Символ = Сред(Значение,инд+1,1);
			КонецЕсли;      
			ТекКолонка =  С + ПоправкаКолонки;
			ТекСтрока  =  R + ПоправкаВысоты;
			Если С + ПоправкаКолонки > 40 Тогда
				Если СтрокаПараметров<=МассивСтрокНастройки.Количество() Тогда
					СтрокаПараметров = СтрокаПараметров+1;
					СтрокаНастройки = МассивСтрокНастройки[СтрокаПараметров];
					С  = СтрокаНастройки.НомерГрафы;
					R  = СтрокаНастройки.НомерСтроки;
					ПоправкаКолонки = 0;
					ТекКолонка =  С;
					ТекСтрока  =  R + ПоправкаВысоты;
				Иначе
					Возврат;
				КонецЕсли;
			КонецЕсли;
			Таблица.Область(ТекСтрока,ТекКолонка,ТекСтрока,ТекКолонка).Текст = Символ;
			ПоправкаКолонки = ПоправкаКолонки+1;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Функция формирует табличный документ с печатными формами заявлений
// в СберБанк
// Возвращаемое значение:
//  Табличный документ - табличный документ с печатными формами квитанций
//
Функция ПечатьСбербанка(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_КвитанцияНаОплатуГосуслуг_СберБанк";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.СберБанк");
	
	//ТабДокумент = Новый ТабличныйДокумент;
	//Если ОплатаВКассу Тогда
	//	ОбщегоНазначения.СообщитьОбОшибке("Выбранная форма используется только при расчете через банк",,, СтатусСообщения.Внимание);
	//	Возврат ТабДокумент;
	//КонецЕсли;
	//
	//Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
	//	ОбщегоНазначения.СообщитьОбОшибке("Для печати данной формы необходимо выбрать лицевой счет",,, СтатусСообщения.Внимание);
	//	Возврат ТабДокумент;
	//КонецЕсли;
	//
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КвитанцияНаОплатуГосуслуг.Номер,
	|	КвитанцияНаОплатуГосуслуг.Дата,
	|	КвитанцияНаОплатуГосуслуг.Организация КАК УчреждениеСсылка,
	|	КвитанцияНаОплатуГосуслуг.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	|	КвитанцияНаОплатуГосуслуг.ИННПолучателя КАК ИННПолучателя,
	|	КвитанцияНаОплатуГосуслуг.КПППолучателя КАК КПППолучателя,
	|	КвитанцияНаОплатуГосуслуг.ЛицевойСчет КАК ЛицевойСчетПолучателя,
	|	КвитанцияНаОплатуГосуслуг.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчетаПолучателя,
	|	КвитанцияНаОплатуГосуслуг.КодБКПлатежа КАК КБК,
	|	КвитанцияНаОплатуГосуслуг.КодОКАТО КАК КодОКАТО,
	|	КвитанцияНаОплатуГосуслуг.ЛицевойСчет.Код КАК ЛС,
	|	КвитанцияНаОплатуГосуслуг.ПолучательБанковскийСчет,
	|	КвитанцияНаОплатуГосуслуг.ПолучательБИКБанка,
	|	КвитанцияНаОплатуГосуслуг.ПолучательКазначейство,
	|	КвитанцияНаОплатуГосуслуг.ПолучательКорСчетБанка,
	|	КвитанцияНаОплатуГосуслуг.ПолучательНаименование,
	|	КвитанцияНаОплатуГосуслуг.ПолучательНаименованиеБанка,
	|	КвитанцияНаОплатуГосуслуг.НазначениеПлатежа,
	|	КвитанцияНаОплатуГосуслуг.СуммаДокумента,
	|	КвитанцияНаОплатуГосуслуг.Ссылка,
	|	КвитанцияНаОплатуГосуслуг.Плательщик.ЮридическоеФизическоеЛицо.ИНН КАК ПлательщикИНН,
	|	КвитанцияНаОплатуГосуслуг.Плательщик,
	|	КвитанцияНаОплатуГосуслуг.Плательщик.Представление КАК ПлательщикИмя,
	|	ВЫБОР
	|		КОГДА КвитанцияНаОплатуГосуслуг.Учащийся ССЫЛКА Справочник.Дети
	|			ТОГДА КвитанцияНаОплатуГосуслуг.Учащийся.Код
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК УчащийсяКод
	|ИЗ
	|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
	|ГДЕ
	|	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивОбъектов)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВыводитьРазделитель = Ложь;
	Ном = 1;
	ТаблицаНастроек  = СформироватьТаблицуНастроек("СберБанк");
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.СуммаДокумента = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Выборка.ЛицевойСчетПолучателя) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВыводитьРазделитель Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ВыводитьРазделитель = Истина;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		КодОКАТО                 = Выборка.КодОКАТО;
		ЛицевойСчетПолучателя    = Выборка.ЛицевойСчетПолучателя;
		РеквизитыЛицевогоСчетаПолучателя = Выборка.РеквизитыЛицевогоСчетаПолучателя;
		пКБК                     = Выборка.КБК;
		
		НаименованиеОрганизации  = Выборка.ПолучательНаименование;
		ИННПолучателя            = Выборка.ИННПолучателя;
		КПППолучателя            = Выборка.КПППолучателя;
		НомерРасчетногоСчета     = Выборка.ПолучательБанковскийСчет;
		НазваниеБанка            = Выборка.ПолучательНаименованиеБанка;
		БИК                      = Выборка.ПолучательБИКБанка;
		КоррСчет                 = СокрП(Выборка.ПолучательКорСчетБанка);
		СтрДлинаКоррСчет = СтрДлина(СокрЛП(КоррСчет));
		Для инд = СтрДлинаКоррСчет+1 По 20 Цикл
			КоррСчет = КоррСчет +"-";
		КонецЦикла;
		//ПредставлениеПериода = РаботаСДиалогами.ПолучитьПредставлениеПериодаРегистрации(КонецМесяца(Шапка.Дата))+" г.";
		//
		ЛС = Выборка.ЛС;
		СтрДлинаЛС = СтрДлина(СокрЛП(ЛС));
		Для инд = СтрДлинаЛС По 15 Цикл
			ЛС = ЛС +"-";
		КонецЦикла;
		ДопСчет = "0000";
		
		ОбластьМакета = Макет.ПолучитьОбласть("Секция_1");
		ТабличныйДокумент.Вывести(ОбластьМакета);
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"БИК_", БИК, 9,Ном);
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"КоррСчет_", КоррСчет, 20,Ном);
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"УчрБанка_", НазваниеБанка, 60,Ном);
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"РС_", НомерРасчетногоСчета, 20,Ном);
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"ОргНазв_",НаименованиеОрганизации,175,Ном);
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"ОргИНН_",ИННПолучателя,12,Ном);
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"КПП_",КПППолучателя,9,Ном);
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"ЛС_", ЛС,16,Ном);
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"КБК_", пКБК,20,Ном);
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"ОКАТО_",КодОКАТО, 11,Ном);
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"ДопСчет_",ДопСчет,4,Ном);
		
		НазначениеПлатежа = СокрЛП(Выборка.НазначениеПлатежа);
		
		ПлательщикИмя   = "";
		ПлательщикАдрес = "";
		Плательщик         = Выборка.Плательщик;
		ПлательщикИНН      = Выборка.ПлательщикИНН;
		ДопИнф = Выборка.УчащийсяКод;
		Если ЗначениеЗаполнено(Плательщик) Тогда
			ПлательщикИмя   = Выборка.ПлательщикИмя;
			ПлательщикАдрес = БиблиотекаФункцийОбмена.КонтактнаяИнформацияКонтрагента(Плательщик, "Адрес");
		КонецЕсли;	
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"ПлатИмя_",ПлательщикИмя,78,Ном);
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"ПлатАдр_",ПлательщикАдрес,78,Ном);  
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"ПлатИНН_",ПлательщикИНН,12,Ном);
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"ДопИнф_",ДопИнф,15,Ном);
		
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"Назн_",НазначениеПлатежа,222,Ном);
		
		СуммаКОплате    = Выборка.СуммаДокумента;//?(Шапка.КвитанцииВЦелыхРублях, Окр(Строка.Сумма), Строка.Сумма);
		Рублей          = Цел(СуммаКОплате);
		Копеек          = (СуммаКОплате-Рублей)*100;
		Руб = Формат(Рублей,"ЧДЦ=0; ЧГ=0" );
		СтрДлинаРуб = СтрДлина(Руб);
		Для инд = СтрДлинаРуб+1 По 9 Цикл
			Руб = Руб+"-";
		КонецЦикла;
		Если Копеек <> 0 Тогда
			Коп = ?(Копеек<10,"0","")+Формат(Копеек,"ЧДЦ=0; ЧГ=0");
		Иначе
			Коп = "00";
		КонецЕсли;
		
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"Руб_",Руб,9,Ном);
		ЗаполнитьКвадратики(ТабличныйДокумент,ТаблицаНастроек,"Коп_",Коп,2,Ном);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		Ном = Ном+1;
	КонецЦикла;
	
	ТабличныйДокумент.ПолеСправа          = 0;
	ТабличныйДокумент.ПолеСверху          = 0;
	ТабличныйДокумент.ПолеСнизу           = 0;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	//ТабличныйДокумент.МасштабПечати       = 70;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_КвитанцияНаОплатуГосуслуг_Сбербанк";
	ТабличныйДокумент.ОриентацияСтраницы  = ОриентацияСтраницы.Портрет;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура СформироватьИдентификаторНачисления(Квитанция) Экспорт
	Дата = Квитанция.Дата;
	Если НЕ ЗначениеЗаполнено(Квитанция.Номер) Тогда
		Квитанция.УстановитьНовыйНомер();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.НомерСтроки КАК НомерСтроки,
	|	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.НаименованиеРеквизита КАК НаименованиеРеквизита,
	|	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.ДлинаРеквизита КАК ДлинаРеквизита,
	|	ИСТИНА КАК УдалятьПробелы,
	|	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Символ КАК Символ,
	|	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.ФиксированноеПоле КАК ФиксированноеПоле,
	|	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Значение КАК Значение,
	|	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Ссылка КАК Ссылка,
	|	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Ссылка.ДлинаИдентификатора КАК ДлинаИдентификатора,
	|	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Перевести16_10 КАК Перевести16_10
	|ИЗ
	|	Справочник.ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг.СоставШаблона КАК ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона
	|ГДЕ
	|	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Ссылка.Владелец = &Владелец
	|	И ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Ссылка.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Владелец",Квитанция.Организация);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не заполнен шаблон для формирования уникального идентификатора начисления для выбранной организации!'"));
		Возврат;		
	КонецЕсли;
	Выборка = Результат.Выбрать();
	СтрИД = "";
	Пока Выборка.Следующий() Цикл
		Если Выборка.ФиксированноеПоле Тогда
			Рез = Выборка.Значение;
			Если Выборка.УдалятьПробелы Тогда
				Рез = СтрЗаменить(Рез," ","");
			КонецЕсли;
			Если Выборка.Перевести16_10 Тогда
				Рез = XMLСтрока(БиблиотекаФункцийОбменаПовтИсп.ПеревестиИз16В10(ВРег(Рез)));				
			КонецЕсли;
			
			СтрИД = СтрИД+СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Лев(Рез,Выборка.ДлинаРеквизита), Выборка.ДлинаРеквизита);
			
		Иначе
			Если НРег(Выборка.Значение) = НРег("Алгоритм.Алгоритм12") Тогда
				Рез = "";
				Рез = Формат(Дата, "ДФ=""ддММггЧЧммсс""");
				СтрИД = СтрИД + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Лев(Рез,Выборка.ДлинаРеквизита), Выборка.ДлинаРеквизита); 
			ИначеЕсли НРег(Выборка.Значение) = НРег("Алгоритм.Алгоритм13") Тогда
				Рез = "";
				Рез = Формат(Дата, "ДФ=""ддММ0ггЧЧммсс""");
				СтрИД = СтрИД + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Лев(Рез,Выборка.ДлинаРеквизита), Выборка.ДлинаРеквизита); 
			ИначеЕсли НРег(Выборка.Значение) = НРег("ДатаДокумента.Год") Тогда
				Рез = "";
				Рез = Сред(Формат(Дата, "ДФ=""ддММггЧЧммсс"""),5,2);
				СтрИД = СтрИД + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Прав(Рез,Выборка.ДлинаРеквизита), Выборка.ДлинаРеквизита);
			ИначеЕсли НРег(Выборка.Значение) = НРег("ДатаДокумента.Месяц") Тогда
				Рез = "";
				Рез = Сред(Формат(Дата, "ДФ=""ддММггЧЧммсс"""),3,2);
				СтрИД = СтрИД + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Прав(Рез,Выборка.ДлинаРеквизита), Выборка.ДлинаРеквизита);
			ИначеЕсли НРег(Выборка.Значение) = НРег("ДатаДокумента.День") Тогда
				Рез = "";
				Рез = Сред(Формат(Дата, "ДФ=""ддММггЧЧммсс"""),1,2);
				СтрИД = СтрИД + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Прав(Рез,Выборка.ДлинаРеквизита), Выборка.ДлинаРеквизита);
			ИначеЕсли Лев(НРег(Выборка.Значение),11) = "организация" Тогда
				Рез = "";
				Попытка
					Если СокрЛП(Сред(Выборка.Значение,12)) = "" Тогда
						Рез = Строка(Выборка.Ссылка);
					Иначе
						СтрокаЗапроса = Сред(Выборка.Значение,13);
						Рез = БухгалтерскиеОперацииСервер.ЗначениеРеквизита(Квитанция.Организация,СтрокаЗапроса);
					КонецЕсли;
					Если Выборка.УдалятьПробелы Тогда
						Рез = СтрЗаменить(Рез," ","");
					КонецЕсли;
				Исключение
					Рез = "";
				КонецПопытки;
				СтрИД = СтрИД+СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Лев(Рез,Выборка.ДлинаРеквизита), Выборка.ДлинаРеквизита);
			ИначеЕсли Лев(НРег(Выборка.Значение),8) = "документ" Тогда	
				Рез = "";
				Попытка
					Если СокрЛП(Сред(Выборка.Значение,9)) = "" Тогда
						Рез = Строка(Квитанция);
					Иначе
						СтрокаЗапроса = Сред(Выборка.Значение,10);
						Если ЗначениеЗаполнено(Квитанция.Ссылка) Тогда
							Рез = БухгалтерскиеОперацииСервер.ЗначениеРеквизита(Квитанция.Ссылка,СтрокаЗапроса);
						Иначе
							ИмяРеквизита = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаЗапроса, ".");
							ИспользуемыйОбъект = Квитанция;
							ЭтоПервый = Истина;
							Для Каждого ЭлементРеквизита Из ИмяРеквизита Цикл
								Если ЭтоПервый Тогда 
									ИспользуемыйОбъект = ИспользуемыйОбъект[ЭлементРеквизита];
									ЭтоПервый = Ложь;
								Иначе
									ИспользуемыйОбъект = БухгалтерскиеОперацииСервер.ЗначениеРеквизита(ИспользуемыйОбъект,ЭлементРеквизита);
								КонецЕсли;	
							КонецЦикла;
							Рез = ИспользуемыйОбъект;
						КонецЕсли;
					КонецЕсли;
					Если Выборка.УдалятьПробелы Тогда
						Рез = СтрЗаменить(Рез," ","");
					КонецЕсли;
				Исключение
					Рез = "";
				КонецПопытки;
				Если НРег(Выборка.Значение) = "документ.номер" Тогда
					СтрИД = СтрИД+СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Прав(Рез,Выборка.ДлинаРеквизита), Выборка.ДлинаРеквизита);
				Иначе		
					СтрИД = СтрИД+СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Лев(Рез,Выборка.ДлинаРеквизита), Выборка.ДлинаРеквизита);
				КонецЕсли;
			ИначеЕсли НРег(Выборка.Значение)= НРег("КонтрольныйРазряд") Тогда
				СтрИД = ГосУслугиКлиентСервер.ПолучитьУникальныйИдентификаторНачисления(СтрИД);
			ИначеЕсли НРег(Выборка.Значение)= НРег("КонтрольныйРазряд_1_16") Тогда
				СтрИД = ГосУслугиКлиентСервер.ПолучитьУникальныйИдентификаторНачисления_1_16(СтрИД,Выборка.ДлинаИдентификатора);
			Иначе
				СтрИД = СтрИД+СтроковыеФункцииКлиентСервер.ДополнитьСтроку("",Выборка.ДлинаРеквизита);	
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	Квитанция.УникальныйИдентификаторНачисления = СтрИД;
	
КонецПроцедуры

// Заполняет реквизиты налогового платежа переданной квитанции, по характеристикам госуслуги
// Параметры:
//	Квитанция - ДокументОбъект.КвитанцияНаОплатуГосуслуг
//  ХарактеристикиГосуслуги - Структура, содержащая значения налоговых реквизитов госуслуги, обяза
//	
//   
Процедура ЗаполнитьРеквизитыНалоговоПлатежаКвитанции(Квитанция, ХарактеристикиГосуслуги = Неопределено) Экспорт
	
	// Заполним реквизиты налогового платежа
	Если Квитанция.Номенклатура.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Госуслуга Тогда
		Возврат;
	КонецЕсли;
	
	Если ХарактеристикиГосуслуги = Неопределено Тогда
		ХарактеристикиГосуслуги = Новый ФиксированнаяСтруктура(ГосУслугиПовтИсп.ВернутьХарактеристикиГосуслуги(Квитанция.Номенклатура, НачалоДня(Квитанция.Дата)));
	КонецЕсли;
	
	ПолеВводаПоказательОснования 	= ХарактеристикиГосуслуги.ПоказательОснования;
	ПолеВводаПоказательТипа 		= ХарактеристикиГосуслуги.ПоказательТипа;
	ПолеВводаСтатусСоставителя		= ХарактеристикиГосуслуги.СтатусСоставителя;
	ПолеВводаПоказательПериода		= ХарактеристикиГосуслуги.ПоказательПериода;
	ПолеВводаГодПериода  			= "";
	ПолеВводаДатаПериода 			= "";
	ПолеВводаКодТаможенногоОргана 	= "";
	ПолеВводаНомерПериода 			= 0;
	ПолеВводаПоказательДаты 		= "";
	ПолеВводаПоказательНомера		= "";
	
	ЗаполнитьЗначенияСвойств(Квитанция, БухгалтерскийУчетКлиентСервер.НалоговыеРеквизитыПлатежногоДокумента(Новый Структура("СтатусСоставителя,ПоказательОснования,ПоказательТипа,ПоказательНомера,ПоказательДаты", ПолеВводаСтатусСоставителя,ПолеВводаПоказательОснования,ПолеВводаПоказательТипа,ПолеВводаПоказательНомера,ПолеВводаПоказательДаты)));
	
	ЗначенияРеквизитов = Новый Структура("ПоказательПериода, ПолеВводаГодПериода, ПолеВводаНомерПериода, ПолеВводаДатаПериода, ПолеВводаКодТаможенногоОргана",
	Квитанция.ПоказательПериода,ПолеВводаГодПериода,ПолеВводаНомерПериода,ПолеВводаДатаПериода,ПолеВводаКодТаможенногоОргана);
	
	БухгалтерскийУчетКлиентСервер.ОпределитьРеквизитыНалоговогоПериода(ПолеВводаПоказательПериода, Ложь, Квитанция.Дата, ЗначенияРеквизитов);
	
	ЗаполнитьЗначенияСвойств(Квитанция, ЗначенияРеквизитов);
	
КонецПроцедуры

Функция ПолучитьСтрокуQRПоПравилуОбмена(ОшибкаЗаполнения, Шапка)
	
	Возврат УправлениеПечатьюБГУ.ПолучитьтекстВыгрузкиПоПравилуОбмена(
	ОшибкаЗаполнения, 
	Шапка.Ссылка, 
	Шапка.Дата, 
	Шапка.Организация, 
	Шапка.ВидОбменаДляQRКода, 
	Шапка.ФорматОбменаДляQRКода);
	
КонецФункции	

Функция ПолучитьСтрокуQRПоВстроенномуАлгоритму(ОшибкаЗаполнения, Выборка)
	
	ОшибкаЗаполнения = Ложь;
	
	Если Не ЗначениеЗаполнено(Выборка.ПолучательНаименование) Тогда
		ТекстСообщения = Нстр("ru = 'Не заполнен обязательный реквизит получателя: ""Получатель""'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Выборка.Ссылка);
		ОшибкаЗаполнения = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Выборка.ПолучательБанковскийСчет) Тогда
		ТекстСообщения = Нстр("ru = 'Не заполнен обязательный реквизит получателя: ""Счет""'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Выборка.Ссылка);
		ОшибкаЗаполнения = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Выборка.ПолучательНаименованиеБанка) Тогда
		ТекстСообщения = Нстр("ru = 'Не заполнен обязательный реквизит получателя: ""Банк""'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Выборка.Ссылка);
		ОшибкаЗаполнения = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Выборка.ПолучательБИКБанка) Тогда
		ТекстСообщения = Нстр("ru = 'Не заполнен обязательный реквизит получателя: ""БИК""'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Выборка.Ссылка);
		ОшибкаЗаполнения = Истина;
	КонецЕсли;
	
	Если НЕ ОшибкаЗаполнения Тогда
		
		РеквизитыПлатежа = Новый Структура("ТекстПолучателя,
		|НомерСчетаПолучателя,
		|НаименованиеБанкаПолучателя,
		|БИКБанкаПолучателя,
		|СчетБанкаПолучателя,
		|СуммаЧислом,
		|НазначениеПлатежа,
		|ИННПлательщика,
		|ИННПолучателя,
		|КПППолучателя,
		|КодБК,
		|КодОКТМО,
		|ФамилияПлательщика,
		|ИмяПлательщика,
		|ОтчествоПлательщика,
		|АдресПлательщика,
		|ФИОРебенка,
		|СНИЛС,
		|ИдентификаторНачисления,
		|НомерДоговора,
		|СтатусСоставителя,
		|ПоказательОснования,
		|ПоказательПериода,
		|ПоказательНомера,
		|ПоказательДаты,
		|ПоказательТипа,
		|НомерЛицевогоСчетаПлательщика,
		|Ссылка");
		
		РеквизитыПлатежа.Ссылка = Выборка.Ссылка;		
		РеквизитыПлатежа.ТекстПолучателя = Выборка.ПолучательНаименование;
		РеквизитыПлатежа.НомерСчетаПолучателя = Выборка.ПолучательБанковскийСчет;
		РеквизитыПлатежа.НаименованиеБанкаПолучателя = Выборка.ПолучательНаименованиеБанка;
		РеквизитыПлатежа.БИКБанкаПолучателя = Выборка.ПолучательБИКБанка;
		РеквизитыПлатежа.СчетБанкаПолучателя = Выборка.ПолучательКорСчетБанка; 
		
		РеквизитыПлатежа.СуммаЧислом = Выборка.СуммаДокумента;
		РеквизитыПлатежа.НазначениеПлатежа = Выборка.НазначениеПлатежа;
		
		РеквизитыПлатежа.ИННПолучателя  = Выборка.ИННПолучателя;
		РеквизитыПлатежа.КПППолучателя  = Выборка.КПППолучателя;
		РеквизитыПлатежа.КодБК 			= Выборка.КодБКПлатежа;
		РеквизитыПлатежа.КодОКТМО 		= Выборка.КодОКТМО;
		РеквизитыПлатежа.ИННПлательщика = Выборка.ИННПлательщика;
		
		Если Выборка.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			
			ФиоФизЛица = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", Выборка.Плательщик, Выборка.Дата);
			
			Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ФиоФизЛица);
			
			РеквизитыПлатежа.ФамилияПлательщика 			= ?(ЗначениеЗаполнено(ФиоФизЛица.Фамилия), 	ФиоФизЛица.Фамилия, "");
			РеквизитыПлатежа.ИмяПлательщика 				= ?(ЗначениеЗаполнено(ФиоФизЛица.Имя), 		ФиоФизЛица.Имя, "");
			РеквизитыПлатежа.ОтчествоПлательщика 			= ?(ЗначениеЗаполнено(ФиоФизЛица.Отчество), ФиоФизЛица.Отчество, "");
		КонецЕсли;
		РеквизитыПлатежа.АдресПлательщика = ?(ЗначениеЗаполнено(Выборка.ПлательщикАдрес),Выборка.ПлательщикАдрес,"");
		
		Если ЗначениеЗаполнено(Выборка.ФИОРебенка) Тогда
			РеквизитыПлатежа.ФИОРебенка = Выборка.ФИОРебенка;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.НомерДоговора) Тогда
			РеквизитыПлатежа.НомерДоговора = Выборка.НомерДоговора;	
		КонецЕсли;
		
		ТекСНИЛС = СокрЛП(Выборка.СНИЛС);
		Если СтрДлина(ТекСНИЛС)=14 Тогда
			РеквизитыПлатежа.СНИЛС = ТекСНИЛС;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.УникальныйИдентификаторНачисления) Тогда
			РеквизитыПлатежа.ИдентификаторНачисления = Выборка.УникальныйИдентификаторНачисления;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.НомерЛицевогоСчетаПлательщика) Тогда
			РеквизитыПлатежа.НомерЛицевогоСчетаПлательщика = Выборка.НомерЛицевогоСчетаПлательщика;
		КонецЕсли;
		
		РеквизитыПлатежа.СтатусСоставителя   = Выборка.СтатусСоставителя;
		РеквизитыПлатежа.ПоказательОснования = Выборка.ПоказательОснования;
		РеквизитыПлатежа.ПоказательПериода   = Выборка.ПоказательПериода;
		РеквизитыПлатежа.ПоказательНомера    = Выборка.ПоказательНомера;
		РеквизитыПлатежа.ПоказательДаты   	 = Выборка.ПоказательДаты;//Посмотреть
		РеквизитыПлатежа.ПоказательТипа   	 = Выборка.ПоказательТипа;
		
		QRСтрока = УправлениеПечатью.ФорматнаяСтрокаУФЭБС(РеквизитыПлатежа);
		
		Возврат QRСтрока;
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции	

// Переносит значение договора и учащегося из табличной части ТаблицаИдентификаторов в реквизиты документа
//
Процедура ПеренестиДанныеИзТЧвРеквизиты() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ТипПоля,
	|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.Значение,
	|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.Ссылка КАК Квитанция
	|ИЗ
	|	Документ.КвитанцияНаОплатуГосуслуг.ТаблицаИдентификаторов КАК КвитанцияНаОплатуГосуслугТаблицаИдентификаторов
	|ИТОГИ ПО
	|	Ссылка";
	
	Результат = Запрос.Выполнить();
	
	ВыборкаКвитанций = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаКвитанций.Следующий() Цикл
		КвитанцияОбъект = ВыборкаКвитанций.Квитанция.ПолучитьОбъект();
		ВыборкаДетальныеЗаписи = ВыборкаКвитанций.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.ТипПоля = "СправочникСсылка.Договоры" 
				И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Значение) 
				И НЕ ЗначениеЗаполнено(КвитанцияОбъект.Договор) Тогда
				КвитанцияОбъект.Договор = ВыборкаДетальныеЗаписи.Значение;	
			КонецЕсли;
			
			Если ВыборкаДетальныеЗаписи.ТипПоля = "СправочникСсылка.Студенты" 
				И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Значение) 
				И НЕ ЗначениеЗаполнено(КвитанцияОбъект.Учащийся) Тогда
				КвитанцияОбъект.Учащийся = ВыборкаДетальныеЗаписи.Значение;	
			КонецЕсли;
			
		КонецЦикла;
		Попытка
			КвитанцияОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения",Истина);
			КвитанцияОбъект.ДополнительныеСвойства.Вставить("НеВыполнятьДействияПередЗаписью",Истина);
			КвитанцияОбъект.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='"+ОписаниеОшибки()+"'"));
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

// Проверяет и устанваливает статус всех квитанций на "Исполнен", если сумма платежей >= суммы квитанций
Процедура ПроверитьИсполнениеКвитанций() Экспорт
	//Добавить 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументКвитанцияНаОплатуГосуслуг.Ссылка,
	|	ЕСТЬNULL(СостояниеПлатежноРасчетныхДокументов.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДокумента.ВРаботе)) КАК Статус,
	|	ДокументКвитанцияНаОплатуГосуслуг.СуммаДокумента,
	|	СУММА(ЕСТЬNULL(ПлатежВОплатуГосуслуг.СуммаДокумента, 0)) КАК СуммаПлатежа
	|ПОМЕСТИТЬ ДанныеКвитанций
	|ИЗ
	|	Документ.КвитанцияНаОплатуГосуслуг КАК ДокументКвитанцияНаОплатуГосуслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
	|		ПО (СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент = ДокументКвитанцияНаОплатуГосуслуг.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПлатежВОплатуГосуслуг КАК ПлатежВОплатуГосуслуг
	|		ПО (ПлатежВОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ)
	|			И ДокументКвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления = ПлатежВОплатуГосуслуг.УникальныйИдентификаторНачисления
	|			И (ПОДСТРОКА(ДокументКвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления, 1, 1) <> """")
	|			И (ПОДСТРОКА(ДокументКвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления, 1, 1) <> "" "")
	|ГДЕ
	|	ДокументКвитанцияНаОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ
	|	И (ДокументКвитанцияНаОплатуГосуслуг.СуммаДокумента > 0
	|			ИЛИ ДокументКвитанцияНаОплатуГосуслуг.ВидКвитанции = 3)
	|	И ЕСТЬNULL(СостояниеПлатежноРасчетныхДокументов.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДокумента.ВРаботе)) = ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДокумента.НаИсполнении)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(СостояниеПлатежноРасчетныхДокументов.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДокумента.ВРаботе)),
	|	ДокументКвитанцияНаОплатуГосуслуг.Ссылка,
	|	ДокументКвитанцияНаОплатуГосуслуг.СуммаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеКвитанций.Ссылка,
	|	ДанныеКвитанций.СуммаДокумента,
	|	ДанныеКвитанций.СуммаПлатежа,
	|	ДанныеКвитанций.Ссылка.ВидКвитанции КАК ВидКвитанции
	|ИЗ
	|	ДанныеКвитанций КАК ДанныеКвитанций
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ДанныеКвитанций.СуммаДокумента <= ДанныеКвитанций.СуммаПлатежа
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ";
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
