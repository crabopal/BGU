// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Возвращает текст запроса по контактам взаимодействий, содержащимся в документе.
//
// Возвращаемое значение:
//   Строка - 
//
Функция ТекстЗапросаПоКонтактам(ЭтоФрагментЗапроса = Ложь) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КвитанцияНаОплатуГосуслуг.Плательщик КАК Контакт
	|ИЗ
	|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
	|ГДЕ
	|	КвитанцияНаОплатуГосуслуг.Ссылка = &Предмет
	|	И НЕ КвитанцияНаОплатуГосуслуг.Плательщик = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)";
	
	Если ЭтоФрагментЗапроса Тогда
		ТекстЗапроса = "
		| ОБЪЕДИНИТЬ ВСЕ
		|" + ТекстЗапроса;
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура СоздатьШаблонСообщенияДляРассылкиКвитанций()Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		МетаданныеДокумента = Метаданные.Документы.КвитанцияНаОплатуГосуслуг;
		Назначение = МетаданныеДокумента.Представление();
		Наименование = "Для рассылки квитанций (ПД-4 с QR-кодом)";
		Тема = "Рассылка квитанций";
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ШаблоныСообщений.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ШаблоныСообщений КАК ШаблоныСообщений
		|ГДЕ
		|	ШаблоныСообщений.Наименование = &Наименование
		|	И ШаблоныСообщений.ТемаПисьма = &ТемаПисьма
		|	И ШаблоныСообщений.Назначение = &Назначение";
		
		Запрос.УстановитьПараметр("Назначение", Назначение);
		Запрос.УстановитьПараметр("Наименование", Наименование);
		Запрос.УстановитьПараметр("ТемаПисьма", Тема);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() = Ложь Тогда
			Возврат; //шаблон уже есть
		КонецЕсли;
		
		Текст = "Добрый день!
		|
		|Квитанция на оплату №[КвитанцияНаОплатуГосуслуг.Номер] от [КвитанцияНаОплатуГосуслуг.Дата] 
		|за услугу ""[КвитанцияНаОплатуГосуслуг.Номенклатура.Наименование]"" 
		|на сумму [КвитанцияНаОплатуГосуслуг.СуммаДокумента] р.
		|из организации ""[КвитанцияНаОплатуГосуслуг.Организация.НаименованиеСокращенное]"" прикреплена к письму.";
		
		ПолноеИмяТипаНазначения = "Документ.КвитанцияНаОплатуГосуслуг";
		
		ПараметрыШаблона = ШаблоныСообщений.ОписаниеПараметровШаблона();
		
		ПараметрыШаблона.Вставить("Текст",Текст);
		
		ПараметрыШаблона.Вставить("Наименование", Наименование);
		ПараметрыШаблона.Вставить("Тема", Тема);
		
		ПараметрыШаблона.Вставить("Назначение", Назначение);
		ПараметрыШаблона.Вставить("ПолноеИмяТипаНазначения", ПолноеИмяТипаНазначения);
		ПараметрыШаблона.Вставить("Наименование", Наименование);
		
		ПараметрыШаблона.ФорматыВложений.Добавить("PDF","Документ Adobe PDF (.pdf)");
		
		Шаблон = Справочники.ШаблоныСообщений.СоздатьЭлемент();
		Шаблон.УстановитьНовыйКод();
		Шаблон.Заполнить(ПараметрыШаблона);
		
		ТаблицаКомандПечати = УправлениеПечатью.КомандыПечатиОбъектаДоступныеДляВложений(МетаданныеДокумента);
		
		Для Каждого СтрТЧ Из ТаблицаКомандПечати Цикл
			Если СтрТЧ.Идентификатор = "ПФ_MXL_ПД_4_20140101_QR" Тогда
				НовСтр = Шаблон.ПечатныеФормыИВложения.Добавить();
				НовСтр.Идентификатор = СтрТЧ.УникальныйИдентификатор;
				НовСтр.Имя = "";
			КонецЕсли;
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(Шаблон, Истина);
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		//если вдруг не удалось создать пример шаблона, ничего страшного, пользователь может создать его интерактивно
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Создание шаблона сообщений для документа Квитанция на оплату",УровеньЖурналаРегистрации.Ошибка,Справочники.ШаблоныСообщений,ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры


Процедура СинхронизироватьДанныеИдентификаторов() Экспорт
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КвитанцияНаОплатуГосуслуг.Ссылка
	|ИЗ
	|	Документ.КвитанцияНаОплатуГосуслуг.ТаблицаИдентификаторов КАК КвитанцияНаОплатуГосуслугТаблицаИдентификаторов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
	|		ПО КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.Ссылка = КвитанцияНаОплатуГосуслуг.Ссылка
	|			И (КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.Значение <> КвитанцияНаОплатуГосуслуг.ЕдиныйИдентификаторПлательщика
	|					И КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ИмяВФайле = ""UnifiedPayerIdentifier""
	|				ИЛИ КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.Значение <> КвитанцияНаОплатуГосуслуг.АльтернативныйИдентификаторПлательщика
	|					И КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ИмяВФайле = ""AltPayerIdentifier"")
	|ГДЕ
	|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ТипПоля В(&ТипыПолей)
	|	И КвитанцияНаОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ";
	
	МассивТиповПолей = Новый Массив;
	МассивТиповПолей.Добавить("ЕдиныйИдентификатор");
	МассивТиповПолей.Добавить("ЕдиныйИдентификаторУчащегося");
	МассивТиповПолей.Добавить("АльтернативныйИдентификаторУчащегося");
	МассивТиповПолей.Добавить("АльтернативныйИдентификатор");
	Запрос.УстановитьПараметр("ТипыПолей", МассивТиповПолей);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДокОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения",Истина);
		ДокОбъект.ДополнительныеСвойства.Вставить("НеВыполнятьДействияПередЗаписью",Истина);
		
		Для Каждого СтрТЧ Из ДокОбъект.ТаблицаИдентификаторов Цикл
			Если СтрТЧ.ИмяВФайле = "UnifiedPayerIdentifier" 
				И (СтрТЧ.ТипПоля = "ЕдиныйИдентификатор" ИЛИ СтрТЧ.ТипПоля = "ЕдиныйИдентификаторУчащегося") Тогда
				СтрТЧ.Значение = ДокОбъект.ЕдиныйИдентификаторПлательщика;
				СтрТЧ.ПолеИдентификатор = ДокОбъект.ЕдиныйИдентификаторПлательщика;
			КонецЕсли;
			Если СтрТЧ.ИмяВФайле = "AltPayerIdentifier" 
				И (СтрТЧ.ТипПоля = "АльтернативныйИдентификаторУчащегося" ИЛИ СтрТЧ.ТипПоля = "АльтернативныйИдентификатор") Тогда
				СтрТЧ.Значение = ДокОбъект.АльтернативныйИдентификаторПлательщика;
				СтрТЧ.ПолеИдентификатор = ДокОбъект.АльтернативныйИдентификаторПлательщика;
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='"+ОписаниеОшибки()+"'"));
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

