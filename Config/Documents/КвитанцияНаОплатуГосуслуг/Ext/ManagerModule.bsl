// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	// Старые макеты
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПФ_MXL_ПД_4") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_ПД_4", "Форма № ПД-4 (старая)", ПечатьПД4(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПД_4"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПФ_MXL_ПД_4_сб_налог") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_ПД_4_сб_налог", "Форма № ПД-4 сб(налог)(старая)", ПечатьПД4(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПД_4_сб_налог"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Сбербанк") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Сбербанк", "Заявление Сбербанка (старое)", ПечатьСбербанка(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	// Новые макеты
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПФ_MXL_ПД_4_20140101") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_ПД_4_20140101", "Форма № ПД-4", ПечатьПД4_20140101(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПД_4_20140101"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПФ_MXL_ПД_4_20140101_QR") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_ПД_4_20140101_QR", "Форма № ПД-4 с QR-кодом", ПечатьПД4_20140101(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПД_4_20140101_QR"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПФ_MXL_ПД_4_сб_налог20140101") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_ПД_4_сб_налог20140101", "Форма № ПД-4 сб(налог)", ПечатьПД4_20140101(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПД_4_сб_налог20140101"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПФ_MXL_ПД_4_сб_налог20140101_QR") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_ПД_4_сб_налог20140101_QR", "Форма № ПД-4 сб(налог) с QR-кодом", ПечатьПД4_20140101(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПД_4_сб_налог20140101_QR"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Сбербанк20140101") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Сбербанк20140101", "Заявление Сбербанка", ПечатьСбербанка20140101(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
КонецПроцедуры // Печать()

Функция СформироватьФайлыДляПодписи(Организация, МассивНачислений) Экспорт
	
	НастройкиОрганизации = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОрганизации(Организация);
	
	Если НастройкиОрганизации.ВидОбмена = Неопределено Тогда
		ТекстСообщения = НСтр("ru='Для организации """+Организация+""" не заданы настройки участника обмена с системой учета начислений и платежей.
		|Подпись не возможна.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;	
	КонецЕсли;
	
	ОбработкаФормирования = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	Формат = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиОрганизации.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Экспорт,"Charge_GMP_ForSign");
	
	Если НЕ ЗначениеЗаполнено(Формат) Тогда
		ТекстСообщения = НСтр("ru='У вида обмена """+НастройкиОрганизации.ВидОбмена+""" не обнаружен формат ""Charge_GMP_ForSign"" для формирования xml файла начисления.
		|Подпись не возможна.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если НастройкиОрганизации.РежимПодписи <> "Самостоятельно" Тогда
		ТекстСообщения = НСтр("ru='Для организации """+Организация+""" в настройках указано формирование ЭП при выполнении обмена с системой учета начислений и платежей.
		|Подпись не выполнена.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;	
	КонецЕсли;
	
	СертификатНачислений = НастройкиОрганизации.СертификатЭПНачислений;
	
	Если НЕ ЗначениеЗаполнено(СертификатНачислений) Тогда
		ТекстСообщения = НСтр("ru='Для организации """+Организация+""" в настройке не задан сертификат для подписи начислений, необходимый для формирования ЭП.
		|Подпись не возможна.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	АдресTSA = НастройкиОрганизации.АдресTSA;
	
	Если НЕ ЗначениеЗаполнено(АдресTSA) Тогда
		ТекстСообщения = НСтр("ru='Для организации """+Организация+""" в настройке не задан адрес TSA сервера, необходимый для формирования ЭП.
		|Подпись не возможна.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураДляФормирования = ОбработкаФормирования.ПолучитьСтруктуруДляФормированияФайла(НастройкиОрганизации.ВидОбмена,Организация,ТекущаяДатаСеанса(),МассивНачислений,Формат,Неопределено);
	СтруктураДляФормирования.ОбъектыОбмена.Колонки.Добавить("СертификатЭПНачислений");
	СтруктураДляФормирования.ОбъектыОбмена.Колонки.Добавить("НастройкаTSA");
	СтруктураДляФормирования.ОбъектыОбмена.Колонки.Добавить("АдресTSA");
	СтруктураДляФормирования.ОбъектыОбмена.Колонки.Добавить("ТекстОшибки");
	СтруктураДляФормирования.ОбъектыОбмена.Колонки.Добавить("ПарольЭПНачисления");
	
	ДанныеТекСертификата = СертификатНачислений.ДанныеСертификата.Получить();	
	
	Хост = "";
	АдресРесурса = "";
	
	ТекАдрес = СокрЛП(АдресTSA);
	Если НРег(Лев(ТекАдрес,7)) = "http://" Тогда
		ТекАдрес = Сред(ТекАдрес,8);
	ИначеЕсли  НРег(Лев(ТекАдрес,8)) = "https://" Тогда
		ТекАдрес = Сред(ТекАдрес,9);
	КонецЕсли;
	
	Порт = Неопределено;
	
	ПозицияПортаВАдресе = Найти(ТекАдрес,":");
	
	ПозицияНачалаАдресаРесурса = Найти(ТекАдрес,"/");
	
	Если ПозицияПортаВАдресе > 0 И ПозицияНачалаАдресаРесурса> ПозицияПортаВАдресе Тогда
		Хост = Сред(ТекАдрес,1,ПозицияПортаВАдресе-1);
		Порт = Число(Сред(ТекАдрес,ПозицияПортаВАдресе+1,ПозицияНачалаАдресаРесурса-1-ПозицияПортаВАдресе)); 
	Иначе
		Хост = Сред(ТекАдрес,1,ПозицияНачалаАдресаРесурса-1);
	КонецЕсли;
	АдресРесурса = Сред(ТекАдрес,ПозицияНачалаАдресаРесурса);
	
	СтруктураНастроекТSA = Новый Структура("Хост,АдресРесурса,Порт",Хост,АдресРесурса,Порт);
	
	УстановитьПривилегированныйРежим(Истина);
	ПарольЭПНачислений = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Организация,"ПарольЭПНачислений");
	УстановитьПривилегированныйРежим(Ложь);
	Если ПарольЭПНачислений = Неопределено Тогда
		ПарольЭПНачислений = "";
	КонецЕсли;
	
	Для Каждого СтрТЧ Из СтруктураДляФормирования.ОбъектыОбмена Цикл
		СтрТЧ.СертификатЭПНачислений = Base64Строка(ДанныеТекСертификата);
		СтрТЧ.СертификатЭПНачислений = СтрЗаменить(СтрТЧ.СертификатЭПНачислений,Символы.ВК,"");
		СтрТЧ.НастройкаTSA = СтруктураНастроекТSA;
		СтрТЧ.АдресTSA = АдресTSA;
		СтрТЧ.ПарольЭПНачисления = ПарольЭПНачислений;
	КонецЦикла;
	
	ОбработкаФормирования.СформироватьФайлы(СтруктураДляФормирования);
	
	МассивКУдалению = Новый Массив;
	
	Для Каждого СтрТЧ Из СтруктураДляФормирования.ОбъектыОбмена Цикл
		Если ЗначениеЗаполнено(СтрТЧ.РезультатФормирования) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстОшибки = "";
		ТЧОписаниеОшибки = ЗначениеИзСтрокиВнутр(СтрТЧ.ОписаниеОшибки);
		Для Каждого СтрОшибки Из ТЧОписаниеОшибки Цикл
			СтрокаОшибки = ?(ЗначениеЗаполнено(СтрОшибки.ПолеФайла),"ПолеФайла: "+СтрОшибки.ПолеФайла+Символы.ПС,"")
			+?(ЗначениеЗаполнено(СтрОшибки.Ошибка),"Ошибка: "+СтрОшибки.Ошибка,"");	
			ТекстОшибки = ?(ЗначениеЗаполнено(ТекстОшибки),ТекстОшибки + Символы.ПС,"")+СтрокаОшибки;
		КонецЦикла;
		СтрТЧ.ТекстОшибки = ТекстОшибки;
		
		ТекстСообщения = НСтр("ru='Не удалось подписать начисление """+СтрТЧ.Объект+""" по причине: не удалось сформировать файл по причине: "+Символы.ПС+СтрТЧ.ТекстОшибки+"'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		МассивКУдалению.Добавить(СтрТЧ);	
	КонецЦикла;
	
	//Удалим документы, по которым не сформированы файлы.
	Для Каждого ЭлМас Из МассивКУдалению Цикл
		СтруктураДляФормирования.ОбъектыОбмена.Удалить(ЭлМас);			
	КонецЦикла;
	
	Возврат СтруктураДляФормирования.ОбъектыОбмена;
	
КонецФункции

Процедура СохранитьПодписьВРегистре(Организация,ДанныеСПодписями) Экспорт
	
	Для Каждого СтрТЧ Из ДанныеСПодписями Цикл
		Если НЕ ЗначениеЗаполнено(СтрТЧ.РезультатФормирования) Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = РегистрыСведений.ПодписанныеНачисления.СоздатьМенеджерЗаписи();
		Запись.Начисление = СтрТЧ.Объект;
		Запись.ПодписанноеНачисление = Новый ХранилищеЗначения(СтрТЧ.РезультатФормирования,Новый СжатиеДанных(9));
		Запись.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьФайлыДляПодписиДляМассиваНачислений(МассивНачислений) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивНачислений",МассивНачислений);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КвитанцияНаОплатуГосуслуг.Ссылка,
	|	КвитанцияНаОплатуГосуслуг.Организация КАК Организация
	|ИЗ
	|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
	|ГДЕ
	|	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивНачислений)
	|ИТОГИ ПО
	|	Организация";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СоответствиеРезультатов = Новый Соответствие;
	Пока ВыборкаОрганизация.Следующий() Цикл
		// Вставить обработку выборки ВыборкаОрганизация
		ТекОрганизация = ВыборкаОрганизация.Организация;
		ВыборкаДетальныеЗаписи = ВыборкаОрганизация.Выбрать();
		МассивТекНачислений = Новый Массив;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			МассивТекНачислений.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
		КонецЦикла;
		СоответствиеРезультатов.Вставить(ТекОрганизация,СформироватьФайлыДляПодписи(ТекОрганизация,МассивТекНачислений));
	КонецЦикла;
	
	Возврат СоответствиеРезультатов;	
	
КонецФункции

Процедура УдалитьЭПНачислений(Начисления) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодписанныеНачисления.Начисление
	|ИЗ
	|	РегистрСведений.ПодписанныеНачисления КАК ПодписанныеНачисления
	|ГДЕ
	|	ПодписанныеНачисления.Начисление В (&Начисления)";
	
	Запрос.УстановитьПараметр("Начисления", Начисления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Запись = РегистрыСведений.ПодписанныеНачисления.СоздатьМенеджерЗаписи();
		Запись.Начисление = ВыборкаДетальныеЗаписи.Начисление;
		Запись.Удалить();
	КонецЦикла;	
	
КонецПроцедуры

