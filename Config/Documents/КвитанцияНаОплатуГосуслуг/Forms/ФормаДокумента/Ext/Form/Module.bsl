&НаКлиенте
Процедура КодОКВЭД2НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", 				"Выбор вида деятельности по ОКВЭД");
	ПараметрыФормы.Вставить("НазваниеМакета",  			"ОКВЭД2");
	ПараметрыФормы.Вставить("Префикс",					"Классификатор");
	ПараметрыФормы.Вставить("ИмяРеквизитаКод",  		"КодОКВЭД2");
	ПараметрыФормы.Вставить("ИмяРеквизитаНаименование",	"НаименованиеОКВЭД2");
	
	ВыбратьИзКлассификатора(ПараметрыФормы);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьИзКлассификатора(ПараметрыФормы)
	
	ПараметрыФормы.Вставить("ТекущийПериод",   		?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата,ТекущаяДата()));
	ПараметрыФормы.Вставить("ТекущийКод",      		Объект[ПараметрыФормы.ИмяРеквизитаКод]);
	ПараметрыФормы.Вставить("ВернутьВсеРеквизиты",		Истина);

	ДополнительныеПараметры = Новый Структура("ИмяРеквизитаКод, ИмяРеквизитаНаименование", ПараметрыФормы.ИмяРеквизитаКод, ПараметрыФормы.ИмяРеквизитаНаименование);

	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ВыбратьИзКлассификатораЗавершение", ЭтотОбъект, ДополнительныеПараметры);

	ОткрытьФорму("ОбщаяФорма.ФормаВыбораКода", ПараметрыФормы,,,,, ОповещениеОЗакрытии);
	 
КонецПроцедуры	
 
&НаКлиенте
Процедура ВыбратьИзКлассификатораЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		
		Модифицированность = Истина;
		
		Объект[ДополнительныеПараметры.ИмяРеквизитаКод] = РезультатЗакрытия.Код;
		
		Объект[ДополнительныеПараметры.ИмяРеквизитаНаименование] = РезультатЗакрытия.Наименование;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КодОКВЭД2ПриИзменении(Элемент)
	Если НЕ ЗначениеЗаполнено(Объект.КодОКВЭД2) Тогда
		Объект.НаименованиеОКВЭД2 = "";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПредварительноеПриИзменении(Элемент)
	Если Объект.Предварительное Тогда
		Объект.СуммаПредварительная = Объект.СуммаДокумента;
		Объект.СуммаДокумента = 0;
		Объект.СуммаНДС = ПересчитатьСуммуНДС(Объект.СуммаДокумента, Объект.СтавкаНДС);
	Иначе
		Объект.СуммаДокумента = Объект.СуммаПредварительная;
		Объект.СуммаПредварительная = 0;
		Объект.СуммаНДС = ПересчитатьСуммуНДС(Объект.СуммаДокумента, Объект.СтавкаНДС);
	КонецЕсли;
	УстановитьДоступностьЭлементовСуммы(ЭтотОбъект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементовСуммы(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,"СуммаДокумента","ТолькоПросмотр",Форма.Объект.Предварительное);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,"СуммаПредварительная","ТолькоПросмотр",НЕ Форма.Объект.Предварительное);
		
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивомНаСервере(Знач Параметры) Экспорт
	ОбменСАрхивом.ВыполнитьПодключаемуюКоманду(ЭтотОбъект, Параметры);
КонецПроцедуры
