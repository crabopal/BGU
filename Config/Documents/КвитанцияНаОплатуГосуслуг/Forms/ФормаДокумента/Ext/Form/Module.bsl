&НаКлиенте
Процедура СоотнестиПлатежи(Команда)
	
	Если ЕстьПлатежи Тогда	
		ПараметрыФормы = Новый Структура("Отбор",Новый Структура("Начисление",Объект.Ссылка));
		ОткрытьФорму("РегистрСведений.СоответствиеНачисленийИПлатежей.Форма.ФормаСписка",ПараметрыФормы,ЭтотОбъект);
	Иначе
		ПараметрыФормы = Новый Структура("Участник,Начисление",Объект.Организация,Объект.Ссылка);
		ОткрытьФорму("Обработка.РаспределениеПлатежейГИСГМП.Форма.Форма",ПараметрыФормы,ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКассовыхПоступлений(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.УникальныйИдентификаторНачисления) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнен уникальный идентификатор начисления.'"));
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура;
	СтруктураОтбора = Новый Структура("Организация,ИдентификаторПлатежа",Объект.Организация,Объект.УникальныйИдентификаторНачисления);
	ПараметрыФормы.Вставить("Отбор",СтруктураОтбора);
	ОткрытьФорму("Документ.КассовоеПоступление.ФормаСписка",ПараметрыФормы,ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура Подписать(Команда)
	//Нужно:
	//1.записать документ
	//2.сформировать файл по формату, найденному по виду обмена из настройки организации
	//3.подписать сформированный файл
	//4.добавить запись в РС ПодписанныеНачисления
	//5.установить только просмотр для всего документа
	//6.добавить кнопку включения редактирования и удаления подписи.
	
	Если Модифицированность ИЛИ НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЭтаФорма.Записать();
	КонецЕсли;
	
	Результат = СформироватьФайл();
	Если Результат = Ложь Тогда
		//не подписали
		Возврат;
	КонецЕсли;
	
	МассивДанных = Результат;
	
	ПодписатьФайл(МассивДанных);
	
КонецПроцедуры

