&НаСервере
Процедура СформироватьТаблицуИдентификаторов(ТекЗначениеНастройки=Неопределено)
	
	Объект.АльтернативныйИдентификаторПлательщика = "";
	Объект.ЕдиныйИдентификаторПлательщика = "";
	Объект.ОсновнойИдентификаторПлательщика = "";
	Объект.ДополнительныйИдентификаторПлательщика = "";
	
	Если ИнтеграцияГИСГМП Тогда
		ИзменитьЗначениеРеквизитаИдентификатора("Плательщик",Объект.Плательщик);
		
		Возврат	
	КонецЕсли;
	
	Если НЕ ИспользоватьИнтеграциюСУНИФО Тогда
		Возврат;
	КонецЕсли;
				
	Элементы.АльтернативныйИдентификаторПлательщика.Видимость = Ложь;
	Элементы.ЕдиныйИдентификаторПлательщика.Видимость = Ложь;
	
	Если ТекЗначениеНастройки = Неопределено Тогда
		ЗначениеНастройки = Справочники.Номенклатура.ПолучитьХарактеристикиГосуслуги(Объект.Номенклатура, Объект.Дата).ЗначениеНастройки;
	Иначе
		ЗначениеНастройки = ТекЗначениеНастройки;
	КонецЕсли;
	Если ТипЗнч(ЗначениеНастройки)<>Тип("ХранилищеЗначения") Тогда
		Объект.ТаблицаИдентификаторов.Очистить();
		СформироватьДополнительныеРеквизиты();
		Возврат;
	КонецЕсли;
	//Обработать таблицу идентификаторов
	ПолученноеЗначениеНастройки = ЗначениеНастройки.Получить();
	Если ТипЗнч(ПолученноеЗначениеНастройки) <> Тип("Структура") Тогда
		Объект.ТаблицаИдентификаторов.Очистить();
		СформироватьДополнительныеРеквизиты();
		Возврат;
	КонецЕсли;
	
	ТаблицаИдн = ПолученноеЗначениеНастройки.ТаблицаИдентификаторов;
	Если ТаблицаИдн.Количество()=0 Тогда
		Объект.ТаблицаИдентификаторов.Очистить();
		СформироватьДополнительныеРеквизиты();
		Возврат;
	КонецЕсли;
	
	НастройкиОрганизации = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Организация);
	ИдентификаторПо_1_16 = Ложь;
	ИдентификаторПо_2_00 = Ложь;
	Если НастройкиОрганизации.ВерсияФорматов="1.16" Тогда
		ИдентификаторПо_1_16 = Истина;
	ИначеЕсли НастройкиОрганизации.ВерсияФорматов="2.00" Тогда
		ИдентификаторПо_2_00 = Истина;		
	КонецЕсли;
	
	СтараяТаблица = Объект.ТаблицаИдентификаторов.Выгрузить();
	Объект.ТаблицаИдентификаторов.Очистить();
	Для Каждого СтрИдн Из ТаблицаИдн Цикл
		НовСтр = Объект.ТаблицаИдентификаторов.Добавить();
		НовСтр.ИмяВФайле = СтрИдн.ИмяПоля;
		НовСтр.Представление = СтрИдн.Представление;
		НовСтр.ТипПоля = СтрИдн.ТипПоля;
		НовСтр.РеквизитИдентификатор = СтрИдн.РеквизитИдентификатор;
		СтруктураПоиска = Новый Структура("ИмяВФайле,ТипПоля,РеквизитИдентификатор",НовСтр.ИмяВФайле,НовСтр.ТипПоля,НовСтр.РеквизитИдентификатор);
		НайденныеСтроки = СтараяТаблица.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество()>0 Тогда
			НовСтр.Значение = НайденныеСтроки[0].Значение;
			НовСтр.ПолеИдентификатор = НайденныеСтроки[0].ПолеИдентификатор;
		КонецЕсли;
		Если НовСтр.ТипПоля = "СправочникСсылка.Дети"
			ИЛИ НовСтр.ТипПоля = "ДопАльтИдентификатор_Ребенок" Тогда
			Если Тип("СправочникСсылка.Дети") = ТипЗнч(Объект.Учащийся) Тогда
				НовСтр.Значение = Объект.Учащийся;
			Иначе
				НовСтр.Значение = Справочники.Дети.ПустаяСсылка();
			КонецЕсли;
		ИначеЕсли НовСтр.ТипПоля = "СправочникСсылка.Студенты"
			ИЛИ НовСтр.ТипПоля = "ДопАльтИдентификатор_Учащийся" Тогда
			Если Тип("СправочникСсылка.Студенты") = ТипЗнч(Объект.Учащийся) Тогда
				НовСтр.Значение = Объект.Учащийся;
			Иначе
				НовСтр.Значение = Справочники.Студенты.ПустаяСсылка();
			КонецЕсли;
		ИначеЕсли НовСтр.ТипПоля = "СправочникСсылка.Договоры" Тогда
			НовСтр.Значение = Объект.Договор;
		ИначеЕсли НовСтр.ТипПоля = "СправочникСсылка.Контрагенты" Тогда
			НовСтр.Значение = Объект.Плательщик;
		КонецЕсли;
		
		Если (НовСтр.ТипПоля = "ЕдиныйИдентификатор" ИЛИ НовСтр.ТипПоля = "АльтернативныйИдентификатор") Тогда
			ТипИдентификатора = ?(НовСтр.ТипПоля = "ЕдиныйИдентификатор",Перечисления.ТипИдентификатораПолучателяГосуслуг.Единый,Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный);
			
			Если ИдентификаторПо_2_00 Тогда
				ТекИд = ИдентификаторПлательщикаГосуслуг_2_00(Объект.Плательщик, Объект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			ИначеЕсли ИдентификаторПо_1_16 Тогда
				ТекИд = ИдентификаторПлательщикаГосуслуг_1_16(Объект.Плательщик, Объект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			Иначе			
				ТекИд = ИдентификаторПлательщикаГосуслуг(Объект.Плательщик, Объект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			КонецЕсли;
			
			НовСтр.Значение = ТекИд;			
			НовСтр.ПолеИдентификатор = НовСтр.Значение;
			
			ЗаполнитьИдентификаторПлательщика(ТипИдентификатора,ТекИд,ИдентификаторПо_2_00);
			
		ИначеЕсли (НовСтр.ТипПоля = "ЕдиныйИдентификаторУчащегося" ИЛИ НовСтр.ТипПоля = "АльтернативныйИдентификаторУчащегося") Тогда
			ТипИдентификатора = ?(НовСтр.ТипПоля = "ЕдиныйИдентификаторУчащегося",Перечисления.ТипИдентификатораПолучателяГосуслуг.Единый,Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный);
			Если ЗначениеЗаполнено(Объект.Учащийся) Тогда
				
				Если ИдентификаторПо_2_00 Тогда
					НовСтр.Значение = ИдентификаторПлательщикаГосуслуг_2_00(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Учащийся,"Контрагент"), Объект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
				ИначеЕсли ИдентификаторПо_1_16 Тогда
					НовСтр.Значение = ИдентификаторПлательщикаГосуслуг_1_16(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Учащийся,"Контрагент"), Объект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
				Иначе			
					НовСтр.Значение = ИдентификаторПлательщикаГосуслуг(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Учащийся,"Контрагент"), Объект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
				КонецЕсли;
 
			Иначе
				НовСтр.Значение = "";
			КонецЕсли;
			
			ЗаполнитьИдентификаторПлательщика(ТипИдентификатора,НовСтр.Значение,ИдентификаторПо_2_00);
			
			НовСтр.ПолеИдентификатор = НовСтр.Значение;
			
		ИначеЕсли НовСтр.ТипПоля = "ДопАльтИдентификатор" Тогда
			ТипИдентификатора = Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный;
			
			Если ИдентификаторПо_2_00 Тогда
				НовСтр.Значение = ИдентификаторПлательщикаГосуслуг_2_00(Объект.Плательщик, Объект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			ИначеЕсли ИдентификаторПо_1_16 Тогда
				НовСтр.Значение = ИдентификаторПлательщикаГосуслуг_1_16(Объект.Плательщик, Объект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			Иначе			
				НовСтр.Значение = ИдентификаторПлательщикаГосуслуг(Объект.Плательщик, Объект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			КонецЕсли;
						
			НовСтр.ПолеИдентификатор = НовСтр.Значение;
		ИначеЕсли НовСтр.ТипПоля = "ДопАльтИдентификатор_Ребенок"
			ИЛИ НовСтр.ТипПоля = "ДопАльтИдентификатор_Учащийся" Тогда
			ТипИдентификатора = Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный;
			ИспользуемыйКонтрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НовСтр.Значение,"Контрагент");
			
			Если ИдентификаторПо_2_00 Тогда
				НовСтр.ПолеИдентификатор = ИдентификаторПлательщикаГосуслуг_2_00(ИспользуемыйКонтрагент, Объект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			ИначеЕсли ИдентификаторПо_1_16 Тогда
				НовСтр.ПолеИдентификатор = ИдентификаторПлательщикаГосуслуг_1_16(ИспользуемыйКонтрагент, Объект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			Иначе			
				НовСтр.ПолеИдентификатор = ИдентификаторПлательщикаГосуслуг(ИспользуемыйКонтрагент, Объект.Дата, ТипИдентификатора, НовСтр.РеквизитИдентификатор);
			КонецЕсли;
			
		Иначе
			Если ЗначениеЗаполнено(НовСтр.РеквизитИдентификатор) И ЗначениеЗаполнено(НовСтр.Значение) Тогда
				НовСтр.ПолеИдентификатор = Документы.КвитанцияНаОплатуГосуслуг.ПолучитьЗначениеИдентификатора(НовСтр.РеквизитИдентификатор,НовСтр.Значение,Объект.Дата);
			Иначе
				НовСтр.ПолеИдентификатор = "";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
		
    СформироватьДополнительныеРеквизиты();
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииНоменклатуры()
	
	ХарактеристикиГосуслуги = Новый ФиксированнаяСтруктура(Справочники.Номенклатура.ПолучитьХарактеристикиГосуслуги(Объект.Номенклатура, Объект.Дата));
	
	СформироватьТаблицуИдентификаторов(ХарактеристикиГосуслуги.ЗначениеНастройки);	
	
	ЗаполнитьКодБКПлатежа();
	
	Объект.КодОКАТО = ХарактеристикиГосуслуги.КодОКАТО;
	Объект.КодОКВЭД2 = ХарактеристикиГосуслуги.КодОКВЭД2;
	Объект.НаименованиеОКВЭД2 = ХарактеристикиГосуслуги.НаименованиеОКВЭД2;
	
	Если Объект.Предварительное Тогда
		Если НЕ ЗначениеЗаполнено(Объект.СуммаПредварительная) Тогда
			Объект.СуммаПредварительная		= ХарактеристикиГосуслуги.Стоимость;
		КонецЕсли;
	Иначе
		Если НЕ ЗначениеЗаполнено(Объект.СуммаДокумента) Тогда
			Объект.СуммаДокумента 			= ХарактеристикиГосуслуги.Стоимость;
		КонецЕсли;
	КонецЕсли;
	
	Объект.СтавкаНДС				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Номенклатура,"СтавкаНДС");
	Объект.СуммаНДС = ПересчитатьСуммуНДС(Объект.СуммаДокумента, Объект.СтавкаНДС);
	
	
	ПолеВводаПоказательОснования 	= ХарактеристикиГосуслуги.ПоказательОснования;
	ПолеВводаПоказательТипа 		= ХарактеристикиГосуслуги.ПоказательТипа;
	ПолеВводаСтатусСоставителя		= ХарактеристикиГосуслуги.СтатусСоставителя;
	ПолеВводаПоказательПериода		= ХарактеристикиГосуслуги.ПоказательПериода;
	ПолеВводаГодПериода  			= "";
	ПолеВводаДатаПериода 			= "";
	ПолеВводаКодТаможенногоОргана 	= "";
	ПолеВводаНомерПериода 			= "";
	ПолеВводаПоказательДаты 		= "";
	ПолеВводаПоказательНомера		= "";
	
	ЗаполнитьЗначенияСвойств(Объект, БухгалтерскийУчетКлиентСервер.НалоговыеРеквизитыПлатежногоДокумента(Новый Структура("СтатусСоставителя,ПоказательОснования,ПоказательТипа,ПоказательНомера,ПоказательДаты", ПолеВводаСтатусСоставителя,ПолеВводаПоказательОснования,ПолеВводаПоказательТипа,ПолеВводаПоказательНомера,ПолеВводаПоказательДаты)));
			
	ЗначенияРеквизитов = Новый Структура("ПоказательПериода, ПолеВводаГодПериода, ПолеВводаНомерПериода, ПолеВводаДатаПериода, ПолеВводаКодТаможенногоОргана");
    ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Объект);
	ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, ЭтаФорма);
	БухгалтерскийУчетКлиентСервер.ОпределитьРеквизитыНалоговогоПериода(ПолеВводаПоказательПериода, Ложь, Объект.Дата, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитов);
	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтаФорма);	
	
	Если НЕ НужноЗаписыватьДляФормированияНП(Объект.Номенклатура) Тогда	
    	УстановитьЗначениеПлатежа(Объект.Номенклатура);
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьКодБКПлатежа()
	Если ХарактеристикиГосуслуги = Неопределено Тогда
		ХарактеристикиГосуслуги = Новый ФиксированнаяСтруктура(Справочники.Номенклатура.ПолучитьХарактеристикиГосуслуги(Объект.Номенклатура, Объект.Дата));
	КонецЕсли;
	
	Если ТипЗнч(ХарактеристикиГосУслуги.НачалоДействияКПС) = Тип("Дата") Тогда
		Объект.КодБКПлатежа = ГосУслуги.ПолучитьКодБК(Объект.Организация, ХарактеристикиГосУслуги.КПС, 
						ХарактеристикиГосУслуги.КЭК, ХарактеристикиГосУслуги.НачалоДействияКПС, Объект.ИФО, Объект.ЛицевойСчет);
	КонецЕсли;					
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДополнительныеРеквизиты()
	
	СтруктураТиповТребуемыхДанных = Новый Структура;
	СтруктураТиповТребуемыхДанных.Вставить("Договоры",Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	СтруктураТиповТребуемыхДанных.Вставить("Студенты",Новый ОписаниеТипов("СправочникСсылка.Студенты"));
	СтруктураТиповТребуемыхДанных.Вставить("Дети",Новый ОписаниеТипов("СправочникСсылка.Дети"));
	СтруктураТиповТребуемыхДанных.Вставить("Контрагенты",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	
	СтруктураТиповТребуемыхДанных.Вставить("ДопАльтИдентификатор_Ребенок",Новый ОписаниеТипов("СправочникСсылка.Дети"));	
	СтруктураТиповТребуемыхДанных.Вставить("ДопАльтИдентификатор_Учащийся",Новый ОписаниеТипов("СправочникСсылка.Студенты"));
	СтруктураТиповТребуемыхДанных.Вставить("ДопАльтИдентификатор",Новый ОписаниеТипов("Строка",Новый КвалификаторыСтроки(25)));
	
	ДобавляемыеРеквизиты = Новый Массив;											
	Результат = Новый ДеревоЗначений;
	
	// общие для группы и элемента
	
	Результат.Колонки.Добавить("ИмяДляФормулы");  
	Результат.Колонки.Добавить("Заголовок");
	Результат.Колонки.Добавить("РастягиватьПоГоризонтали");
	Результат.Колонки.Добавить("ТипЭлемента");
	Результат.Колонки.Добавить("ВидЭлемента");
	
	// реквизиты элемента
	Результат.Колонки.Добавить("ТипЗначения");
	Результат.Колонки.Добавить("Реквизит");
	Результат.Колонки.Добавить("ПоложениеЗаголовка");
	Результат.Колонки.Добавить("ШиринаЭлемента");
	Результат.Колонки.Добавить("Гиперссылка");
	
	ОписаниеБулевого = Новый ОписаниеТипов("Булево");
	
	МассивИменДопРеквизитов = Новый Массив;
	
	Для Каждого СтрокаТЧ Из Объект.ТаблицаИдентификаторов Цикл
		ТипПоля = СтрЗаменить(СтрокаТЧ.ТипПоля,"СправочникСсылка.","");
		Попытка
			ТипЗначенияЭлемента = Неопределено;
			Если НЕ СтруктураТиповТребуемыхДанных.Свойство(ТипПоля,ТипЗначенияЭлемента) Тогда
				Продолжить;	
			КонецЕсли;
			//ТипЭлемента = СтруктураТиповТребуемыхДанных[ТипПоля];
		Исключение
			Продолжить;
		КонецПопытки;
		ТекЗаголовок = СтрокаТЧ.Представление;
		
		СтрокаДерева = Результат.Строки.Добавить();
	
		СтрокаДерева.ИмяДляФормулы 	= "ИДПоле_"+СтрокаТЧ.НомерСтроки;
		СтрокаДерева.Заголовок 		= ТекЗаголовок;
		Если ТипПоля = "ЕдиныйИдентификатор" ИЛИ ТипПоля = "АльтернативныйИдентификатор" ИЛИ ТипПоля = "ДопАльтИдентификатор" Тогда
			СтрокаДерева.ВидЭлемента 	= ВидПоляФормы.ПолеВвода;
			СтрокаДерева.Гиперссылка    = Ложь;
		Иначе
		    СтрокаДерева.ВидЭлемента 	= ВидПоляФормы.ПолеНадписи;
			СтрокаДерева.Гиперссылка    = Истина;
		КонецЕсли;
		СтрокаДерева.ТипЭлемента 	= Тип("ПолеФормы");
		СтрокаДерева.РастягиватьПоГоризонтали =	Ложь;
		
		
		СтрокаДерева.ШиринаЭлемента = 30;
										 
		СтрокаДерева.ТипЗначения 	= ТипЗначенияЭлемента;
		СтрокаДерева.Реквизит 		= "ИДПоле_"+СтрокаТЧ.НомерСтроки;
		СтрокаДерева.ПоложениеЗаголовка =	ПоложениеЗаголовкаЭлементаФормы.Авто;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИДПоле_"+СтрокаТЧ.НомерСтроки,
													  ТипЗначенияЭлемента,
													  "",
													  ТекЗаголовок,
													  Ложь));
													  
       	МассивИменДопРеквизитов.Добавить("ИДПоле_"+СтрокаТЧ.НомерСтроки);
		
	КонецЦикла;	
	
	МассивУдаляемыхЭлементов = Новый Массив;
	МассивУдаляемыхРеквизитов = Новый Массив;
	
	Если ТипЗнч(ДобавленныеЭлементы) = Тип("ФиксированныйМассив") Тогда
		Для Каждого ЭлМас Из ДобавленныеРеквизиты Цикл
			МассивУдаляемыхРеквизитов.Добавить(ЭлМас);
		КонецЦикла;
		Для Каждого ЭлМас Из ДобавленныеЭлементы Цикл
			ТекЭлемент = Элементы.Найти(ЭлМас);
			Если ТекЭлемент<>Неопределено Тогда
				МассивУдаляемыхЭлементов.Добавить(ТекЭлемент);
			КонецЕсли;
		КонецЦикла;	    
	КонецЕсли;
	
	Для Каждого ТекЭлемент Из МассивУдаляемыхЭлементов Цикл
		Элементы.Удалить(ТекЭлемент);
	КонецЦикла;
	
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты,МассивУдаляемыхРеквизитов);
	
	ДобавленныеРеквизиты = Новый ФиксированныйМассив(МассивИменДопРеквизитов);
	
	ДобавитьЭлементыНаФорму(Результат.Строки);
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыНаФорму(ДеревоРеквизитов)
	ПолеДляРеквизитов = Элементы.ГруппаЗначениеИдентификаторов;
	ПолеДляНадписи    = Элементы.ГруппаНадписьИдентификаторов;
    ПрефиксЭлементовОперации = "Доп_";
	
	МассивЭлементов = Новый Массив;
	
    Для каждого НовыйРеквизит Из ДеревоРеквизитов Цикл
    	НовЭлемент = ЭтаФорма.Элементы.Найти(ПрефиксЭлементовОперации+НовыйРеквизит.ИмяДляФормулы);
    	Если НовЭлемент = Неопределено Тогда
    		НовЭлемент = ЭтаФорма.Элементы.Добавить(ПрефиксЭлементовОперации+НовыйРеквизит.ИмяДляФормулы,
    											 Тип("ПолеФормы"),
    											 ПолеДляРеквизитов);
    		НовЭлемент.ПутьКДанным = ""+НовыйРеквизит.ИмяДляФормулы;
			НовНадпись = ЭтаФорма.Элементы.Добавить("Доп_Надпись_"+НовыйРеквизит.ИмяДляФормулы,Тип("ДекорацияФормы"),ПолеДляНадписи);
			НовНадпись.Заголовок = "";
			НовНадпись.ЦветТекста = Новый Цвет(70,130,180);
			
			МассивЭлементов.Добавить(НовНадпись.Имя);
    	КонецЕсли;
    	
		НовЭлемент.Заголовок = НовыйРеквизит.Заголовок;
		НовЭлемент.Вид = НовыйРеквизит.ВидЭлемента;
		Если НовЭлемент.Вид = ВидПоляФормы.ПолеНадписи Тогда
			НовЭлемент.Гиперссылка = НовыйРеквизит.Гиперссылка;
		Иначе
			НовЭлемент.ТолькоПросмотр = ЭтаФорма.ТолькоПросмотр;
		КонецЕсли;	
		НовЭлемент.ПоложениеЗаголовка = НовыйРеквизит.ПоложениеЗаголовка;
		НовЭлемент.ЦветФона = Новый Цвет(225,225,225);
		НовЭлемент.РастягиватьПоГоризонтали = НовыйРеквизит.РастягиватьПоГоризонтали;
		НовЭлемент.Ширина	= НовыйРеквизит.ШиринаЭлемента;
		НовЭлемент.УстановитьДействие("ПриИзменении","Подключаемый_ПриИзмененииДопРеквизитаИдентификатора");
		
		МассивЭлементов.Добавить(НовЭлемент.Имя);
	КонецЦикла;
	
	ДобавленныеЭлементы = Новый ФиксированныйМассив(МассивЭлементов);
	
	Для Каждого СтрокаТЧ Из Объект.ТаблицаИдентификаторов Цикл
		Попытка
			Если Найти(СтрокаТЧ.ТипПоля, "ЕдиныйИдентификатор")=0 И  Найти(СтрокаТЧ.ТипПоля,"АльтернативныйИдентификатор")=0 Тогда
				ЭтаФорма["ИДПоле_"+СтрокаТЧ.НомерСтроки] = СтрокаТЧ.Значение;
				ЭлементНадпись = Элементы.Найти("Доп_Надпись_ИДПоле_"+СтрокаТЧ.НомерСтроки);
				Если ЭлементНадпись<>Неопределено Тогда
					ЭлементНадпись.Заголовок = СтрокаТЧ.ПолеИдентификатор;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьЗначениеИдентификатора(ИмяРеквизита,Значение)
	НомерСтроки = Число(СтрЗаменить(ИмяРеквизита,"ИДПоле_",""));
	
	Если Объект.ТаблицаИдентификаторов.Количество() < НомерСтроки Тогда
		Возврат;
	КонецЕсли;
	СтрокаТЧ = Объект.ТаблицаИдентификаторов[НомерСтроки-1];
	
	СтрокаТЧ.Значение = Значение;
	Попытка	
		Если СтрокаТЧ.ТипПоля = "ЕдиныйИдентификатор" 
			ИЛИ СтрокаТЧ.ТипПоля = "АльтернативныйИдентификатор" 
			ИЛИ СтрокаТЧ.ТипПоля = "ДопАльтИдентификатор" Тогда
			СтрокаТЧ.Значение = Значение;
			СтрокаТЧ.ПолеИдентификатор = Значение;
		ИначеЕсли ЗначениеЗаполнено(СтрокаТЧ.РеквизитИдентификатор) И ЗначениеЗаполнено(СтрокаТЧ.Значение) Тогда
			СтрокаТЧ.ПолеИдентификатор = Документы.КвитанцияНаОплатуГосуслуг.ПолучитьЗначениеИдентификатора(СтрокаТЧ.РеквизитИдентификатор, СтрокаТЧ.Значение, Объект.Дата);
		Иначе			
			СтрокаТЧ.ПолеИдентификатор = "";
		КонецЕсли;
	Исключение
		СтрокаТЧ.ПолеИдентификатор = "";
	КонецПопытки;
	
	ЭлементНадпись = Элементы.Найти("Доп_Надпись_"+ИмяРеквизита);
	Если ЭлементНадпись <> Неопределено Тогда
    	ЭлементНадпись.Заголовок = СтрокаТЧ.ПолеИдентификатор;
	КонецЕсли;
			
КонецПроцедуры

&НаСервере
Процедура ИзменитьЗначениеРеквизитаИдентификатора(ИмяРеквизита,Значение)
	
	
	Если ИнтеграцияГИСГМП И ИмяРеквизита = "Плательщик" Тогда
				
		Объект.АльтернативныйИдентификаторПлательщика = "";
		Объект.ЕдиныйИдентификаторПлательщика = "";
		Объект.ОсновнойИдентификаторПлательщика = "";
		Объект.ДополнительныйИдентификаторПлательщика = "";
		
		ПериодНастройки = ГосУслугиПовтИсп.ВернутьПериодАктуальныхНастроек(Объект.Номенклатура,НачалоДня(Объект.Дата));
		Если НЕ ЗначениеЗаполнено(ПериодНастройки) Тогда
			Возврат;
		КонецЕсли;
		
		ТаблицаНастройки = ГосУслуги.ПолучитьНастройкуИспользуемыхИдентификаторов(Объект.Номенклатура,ПериодНастройки).Выгрузить();
		
		ГосУслуги.ЗаполнитьИдентификаторПлательщикаДляГИСГМП(Объект,ТаблицаНастройки);	
		
	ИначеЕсли ИспользоватьИнтеграциюСУНИФО Тогда
		
		МассивПроверямеыхРеквизитов = Новый Массив;
	
		Если ИмяРеквизита = "Договор" Тогда
			МассивПроверямеыхРеквизитов.Добавить("СправочникСсылка.Договоры");
		ИначеЕсли ИмяРеквизита = "Учащийся" Тогда
			МассивПроверямеыхРеквизитов.Добавить("СправочникСсылка.Дети");
			МассивПроверямеыхРеквизитов.Добавить("СправочникСсылка.Студенты");
			МассивПроверямеыхРеквизитов.Добавить("ДопАльтИдентификатор_Ребенок");
			МассивПроверямеыхРеквизитов.Добавить("ДопАльтИдентификатор_Учащийся");
			МассивПроверямеыхРеквизитов.Добавить("ЕдиныйИдентификаторУчащегося");
			МассивПроверямеыхРеквизитов.Добавить("АльтернативныйИдентификаторУчащегося");
			//добавляем поля плательщика
			МассивПроверямеыхРеквизитов.Добавить("ЕдиныйИдентификатор");
			МассивПроверямеыхРеквизитов.Добавить("АльтернативныйИдентификатор");
		ИначеЕсли ИмяРеквизита = "Плательщик" Тогда
			МассивПроверямеыхРеквизитов.Добавить("СправочникСсылка.Контрагенты");
			МассивПроверямеыхРеквизитов.Добавить("ЕдиныйИдентификатор");
			МассивПроверямеыхРеквизитов.Добавить("АльтернативныйИдентификатор");
			МассивПроверямеыхРеквизитов.Добавить("ДопАльтИдентификатор");
			//добавляем поля учащегося
			МассивПроверямеыхРеквизитов.Добавить("ЕдиныйИдентификаторУчащегося");
			МассивПроверямеыхРеквизитов.Добавить("АльтернативныйИдентификаторУчащегося");
		КонецЕсли;
		
	    НастройкиОрганизации = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Организация);
		ИдентификаторПо_1_16 = Ложь;
		ИдентификаторПо_2_00 = Ложь;
		Если НастройкиОрганизации.ВерсияФорматов="1.16" Тогда
			ИдентификаторПо_1_16 = Истина;
		ИначеЕсли НастройкиОрганизации.ВерсияФорматов="2.00" Тогда
			ИдентификаторПо_2_00 = Истина;
		КонецЕсли;
		
		Для Каждого СтрокаТЧ Из Объект.ТаблицаИдентификаторов Цикл
			Если (ИмяРеквизита = "Плательщик" 
					ИЛИ ИмяРеквизита = "Учащийся") 
				И (СтрокаТЧ.ТипПоля = "ЕдиныйИдентификатор"
					ИЛИ СтрокаТЧ.ТипПоля = "ЕдиныйИдентификаторУчащегося") Тогда
				
				Объект.ЕдиныйИдентификаторПлательщика = "";
				Объект.ОсновнойИдентификаторПлательщика = "";
				Объект.ДополнительныйИдентификаторПлательщика = "";
				
			ИначеЕсли (ИмяРеквизита = "Плательщик" 
					ИЛИ ИмяРеквизита = "Учащийся") 
				И (СтрокаТЧ.ТипПоля = "АльтернативныйИдентификатор"
					ИЛИ СтрокаТЧ.ТипПоля = "АльтернативныйИдентификаторУчащегося") Тогда
					
				Объект.АльтернативныйИдентификаторПлательщика = "";
			    Объект.ОсновнойИдентификаторПлательщика = "";
				Объект.ДополнительныйИдентификаторПлательщика = "";
				
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаТЧ Из Объект.ТаблицаИдентификаторов Цикл
			Если МассивПроверямеыхРеквизитов.Найти(СтрокаТЧ.ТипПоля) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаТЧ.ТипПоля = "ДопАльтИдентификатор_Ребенок" Тогда
				Если ТипЗнч(Объект.Учащийся) = Тип("СправочникСсылка.Дети") Тогда
					СтрокаТЧ.Значение = Объект.Учащийся;
				Иначе
					СтрокаТЧ.Значение = Справочники.Дети.ПустаяСсылка();
				КонецЕсли;
			ИначеЕсли СтрокаТЧ.ТипПоля = "ДопАльтИдентификатор_Учащийся" Тогда
				Если ТипЗнч(Объект.Учащийся) = Тип("СправочникСсылка.Студенты") Тогда
					СтрокаТЧ.Значение = Объект.Учащийся;
				Иначе
					СтрокаТЧ.Значение = Справочники.Студенты.ПустаяСсылка();
				КонецЕсли;
			ИначеЕсли СтрокаТЧ.ТипПоля = "ЕдиныйИдентификатор"
				ИЛИ СтрокаТЧ.ТипПоля = "АльтернативныйИдентификатор" Тогда
				
				ТипИдентификатора = ?(СтрокаТЧ.ТипПоля = "ЕдиныйИдентификатор",Перечисления.ТипИдентификатораПолучателяГосуслуг.Единый,Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный);
				
				Если ИдентификаторПо_2_00 Тогда
					СтрокаТЧ.Значение = ИдентификаторПлательщикаГосуслуг_2_00(Объект.Плательщик, Объект.Дата, ТипИдентификатора, СтрокаТЧ.РеквизитИдентификатор);
				ИначеЕсли ИдентификаторПо_1_16 Тогда
					СтрокаТЧ.Значение = ИдентификаторПлательщикаГосуслуг_1_16(Объект.Плательщик, Объект.Дата, ТипИдентификатора, СтрокаТЧ.РеквизитИдентификатор);
				Иначе			
					СтрокаТЧ.Значение = ИдентификаторПлательщикаГосуслуг(Объект.Плательщик, Объект.Дата, ТипИдентификатора, СтрокаТЧ.РеквизитИдентификатор);
				КонецЕсли;
					
				ЗаполнитьИдентификаторПлательщика(ТипИдентификатора,СтрокаТЧ.Значение,ИдентификаторПо_2_00);
				
				СтрокаТЧ.ПолеИдентификатор = СтрокаТЧ.Значение;
				Продолжить;	
			ИначеЕсли СтрокаТЧ.ТипПоля = "ЕдиныйИдентификаторУчащегося"
				ИЛИ СтрокаТЧ.ТипПоля = "АльтернативныйИдентификаторУчащегося" Тогда
				
				ТипИдентификатора = ?(СтрокаТЧ.ТипПоля = "ЕдиныйИдентификаторУчащегося",Перечисления.ТипИдентификатораПолучателяГосуслуг.Единый,Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный);
				
				Если ЗначениеЗаполнено(Объект.Учащийся) 
					И (ТипЗнч(Объект.Учащийся) = Тип("СправочникСсылка.Студенты")
					ИЛИ ТипЗнч(Объект.Учащийся) = Тип("СправочникСсылка.Дети")) Тогда
									
					Если ИдентификаторПо_2_00 Тогда
						СтрокаТЧ.Значение = ИдентификаторПлательщикаГосуслуг_2_00(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Учащийся,"Контрагент"), Объект.Дата, ТипИдентификатора, СтрокаТЧ.РеквизитИдентификатор);
					ИначеЕсли ИдентификаторПо_1_16 Тогда
						СтрокаТЧ.Значение = ИдентификаторПлательщикаГосуслуг_1_16(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Учащийся,"Контрагент"), Объект.Дата, ТипИдентификатора, СтрокаТЧ.РеквизитИдентификатор);
					Иначе			
						СтрокаТЧ.Значение = ИдентификаторПлательщикаГосуслуг(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Учащийся,"Контрагент"), Объект.Дата, ТипИдентификатора, СтрокаТЧ.РеквизитИдентификатор);
					КонецЕсли;
					
				Иначе
					СтрокаТЧ.Значение = "";
				КонецЕсли;
				
				ЗаполнитьИдентификаторПлательщика(ТипИдентификатора,СтрокаТЧ.Значение,ИдентификаторПо_2_00);
				
				СтрокаТЧ.ПолеИдентификатор = СтрокаТЧ.Значение;
				Продолжить;
			ИначеЕсли СтрокаТЧ.ТипПоля = "ДопАльтИдентификатор" Тогда
				//Тут ничего не делаем
			ИначеЕсли ТипЗнч(Значение) = Тип(СтрокаТЧ.ТипПоля) Тогда
				СтрокаТЧ.Значение = Значение;
			Иначе
				ОписаниеТипа = Новый ОписаниеТипов(СтрокаТЧ.ТипПоля);
				СтрокаТЧ.Значение = ОписаниеТипа.ПривестиЗначение(Неопределено);
			КонецЕсли;
			
			Если СтрокаТЧ.ТипПоля = "ДопАльтИдентификатор_Ребенок" 
				ИЛИ СтрокаТЧ.ТипПоля = "ДопАльтИдентификатор_Учащийся" Тогда
				ИспользуемыйПлательщик = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Значение,"Контрагент");
				
				Если ИдентификаторПо_2_00 Тогда
					СтрокаТЧ.ПолеИдентификатор = ИдентификаторПлательщикаГосуслуг_2_00(ИспользуемыйПлательщик, Объект.Дата, Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный, СтрокаТЧ.РеквизитИдентификатор);
				ИначеЕсли ИдентификаторПо_1_16 Тогда
					СтрокаТЧ.ПолеИдентификатор = ИдентификаторПлательщикаГосуслуг_1_16(ИспользуемыйПлательщик, Объект.Дата, Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный, СтрокаТЧ.РеквизитИдентификатор);
				Иначе			
					СтрокаТЧ.ПолеИдентификатор = ИдентификаторПлательщикаГосуслуг(ИспользуемыйПлательщик, Объект.Дата, Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный, СтрокаТЧ.РеквизитИдентификатор);
				КонецЕсли;
				
			ИначеЕсли СтрокаТЧ.ТипПоля = "ДопАльтИдентификатор" Тогда
				ИспользуемыйПлательщик = Объект.Плательщик;
				
				Если ИдентификаторПо_2_00 Тогда
					СтрокаТЧ.ПолеИдентификатор = ИдентификаторПлательщикаГосуслуг_2_00(ИспользуемыйПлательщик, Объект.Дата, Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный, СтрокаТЧ.РеквизитИдентификатор);
				ИначеЕсли ИдентификаторПо_1_16 Тогда
					СтрокаТЧ.ПолеИдентификатор = ИдентификаторПлательщикаГосуслуг_1_16(ИспользуемыйПлательщик, Объект.Дата, Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный, СтрокаТЧ.РеквизитИдентификатор);
				Иначе			
					СтрокаТЧ.ПолеИдентификатор = ИдентификаторПлательщикаГосуслуг(ИспользуемыйПлательщик, Объект.Дата, Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный, СтрокаТЧ.РеквизитИдентификатор);
				КонецЕсли;
				СтрокаТЧ.Значение = СтрокаТЧ.ПолеИдентификатор;
			Иначе
				Попытка
					Если ЗначениеЗаполнено(СтрокаТЧ.РеквизитИдентификатор) И ЗначениеЗаполнено(СтрокаТЧ.Значение) Тогда
						СтрокаТЧ.ПолеИдентификатор = Документы.КвитанцияНаОплатуГосуслуг.ПолучитьЗначениеИдентификатора(СтрокаТЧ.РеквизитИдентификатор,СтрокаТЧ.Значение,Объект.Дата);	
					Иначе
						СтрокаТЧ.ПолеИдентификатор = "";
					КонецЕсли;	
				Исключение		
					СтрокаТЧ.ПолеИдентификатор = "";
				КонецПопытки;
			КонецЕсли;
			
			Попытка
				//Элемент
				ИмяРеквизита = "ИДПоле_"+СтрокаТЧ.НомерСтроки;
				ЭлементИдн = Элементы.Найти("Доп_"+ИмяРеквизита);
				Если ЭлементИдн <> Неопределено Тогда
			    	ЭтаФорма[ИмяРеквизита] = СтрокаТЧ.Значение;
				КонецЕсли;
				
				//Надпись
				ИмяРеквизита = "Доп_Надпись_ИДПоле_"+СтрокаТЧ.НомерСтроки;
				ЭлементНадпись = Элементы.Найти(ИмяРеквизита);
				Если ЭлементНадпись <> Неопределено Тогда
			    	ЭлементНадпись.Заголовок = СтрокаТЧ.ПолеИдентификатор;
				КонецЕсли;
			Исключение
			
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИдентификаторПлательщика(ТипИдентификатора,ЗначениеИдентификатора,ИдентификаторПо_2_00)
	
	Если ИдентификаторПо_2_00 = Ложь Тогда
		Если ТипИдентификатора = Перечисления.ТипИдентификатораПолучателяГосуслуг.Единый Тогда
			Элементы.ЕдиныйИдентификаторПлательщика.Видимость = Истина;
			Если ЗначениеЗаполнено(ЗначениеИдентификатора) Тогда
				Объект.ЕдиныйИдентификаторПлательщика = ЗначениеИдентификатора;
			КонецЕсли;
		Иначе
			Элементы.АльтернативныйИдентификаторПлательщика.Видимость = Истина;
			Если ЗначениеЗаполнено(ЗначениеИдентификатора) Тогда
				Объект.АльтернативныйИдентификаторПлательщика = ЗначениеИдентификатора;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(ЗначениеИдентификатора) Тогда
			Если НЕ ЗначениеЗаполнено(Объект.ОсновнойИдентификаторПлательщика) Тогда
				Объект.ОсновнойИдентификаторПлательщика = ЗначениеИдентификатора;
							
				Если Лев(Объект.ОсновнойИдентификаторПлательщика,1) = "1" Тогда
					//физлица
					Объект.АльтернативныйИдентификаторПлательщика = ГосУслуги.ПреобразоватьИдентификаторПлательщикаИз20В116(Объект.ОсновнойИдентификаторПлательщика);
				Иначе
					Объект.ЕдиныйИдентификаторПлательщика = ГосУслуги.ПреобразоватьИдентификаторПлательщикаИз20В116(Объект.ОсновнойИдентификаторПлательщика);
				КонецЕсли;			
							
			ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ДополнительныйИдентификаторПлательщика) Тогда
				Объект.ДополнительныйИдентификаторПлательщика = ЗначениеИдентификатора;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеПлатежа(Номенклатура)
	
	Если ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП Тогда
		Если НЕ ЗначениеЗаполнено(Объект.УникальныйИдентификаторНачисления) Тогда
			ТекОбъект = РеквизитФормыВЗначение("Объект");
			Документы.КвитанцияНаОплатуГосуслуг.СформироватьИдентификаторНачисления(ТекОбъект);
			ЗначениеВРеквизитФормы(ТекОбъект,"Объект");
		КонецЕсли;
	КонецЕсли;
	
	ШаблонЗаполнения = Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.ПолучитьШаблонЗаполнения(Номенклатура);
	
	Если НЕ ЗначениеЗаполнено(ШаблонЗаполнения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не установлен шаблон заполнения.'"));
		Возврат;
	КонецЕсли;	
	
	Объект.НазначениеПлатежа = Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.ПолучитьТекстПоШаблону(Объект,ШаблонЗаполнения);
	Модифицированность = Истина;	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НужноЗаписыватьДляФормированияНП(Номенклатура)
	ШаблонЗаполнения = Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.ПолучитьШаблонЗаполнения(Номенклатура);
	Если НЕ ЗначениеЗаполнено(ШаблонЗаполнения) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШаблонЗаполнения,"РасширенныйШаблон");
КонецФункции

