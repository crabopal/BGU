		Возврат "";
	КонецЕсли;
	
	ВидИдентификатора = ?(ТипИдентификатораПлательщика = Перечисления.ТипИдентификатораПолучателяГосуслуг.Единый,Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка(),ВидАльтернативногоИдентификатора);
	Если ТипИдентификатораПлательщика = Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный И НЕ ЗначениеЗаполнено(ВидАльтернативногоИдентификатора) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ГосУслуги.ЗаполнитьОдинИдентификаторПлательщика(Плательщик,ВидИдентификатора,Дата).Идентификатор;
	
