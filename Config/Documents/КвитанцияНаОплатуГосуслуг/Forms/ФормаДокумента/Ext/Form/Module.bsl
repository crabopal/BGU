//               ОБРАБОТЧИКИ СОБЫТИЙ РЕКВИЗИТОВ ИДЕНТИФИКАТОРОВ                        //

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДопРеквизитаИдентификатора(Элемент)
	
	ИмяРеквизита = СтрЗаменить(Элемент.Имя,"Доп_","");
	ИзменитьЗначениеИдентификатора(ИмяРеквизита,ЭтаФорма[ИмяРеквизита]);
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

//               ОБРАБОТЧИКИ СОБЫТИЙ РЕКВИЗИТОВ ИДЕНТИФИКАТОРОВ                        //
/////////////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ВидСкидкиПриИзменении(Элемент)
	
	Объект.ФиксированнаяСуммаСкидки = 0;
	Объект.ПроцентСкидки = 0;
	Объект.ПонижающийКоэффициент = 0;
	Объект.ДатаОкончанияДействияСкидки = Неопределено;
	Элементы.ГруппаСкидка.Видимость = (ВидСкидки <> 0);
	
	Если ВидСкидки = 1 Тогда
		Элементы.ГруппаСтраницСкидки.ТекущаяСтраница = Элементы.ГруппаПроцент;
	ИначеЕсли ВидСкидки = 2 Тогда
		Элементы.ГруппаСтраницСкидки.ТекущаяСтраница = Элементы.ГруппаКоэффициент;
	ИначеЕсли ВидСкидки = 3 Тогда
		Элементы.ГруппаСтраницСкидки.ТекущаяСтраница = Элементы.ГруппаФиксированная;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика
	 ИЛИ ТипЗнч(ХарактеристикиГосуслуги) = Тип("ФиксированнаяСтруктура") Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
	Если ТипЗнч(ХарактеристикиГосуслуги) = Тип("ФиксированнаяСтруктура") Тогда
		ПриИзмененииНоменклатуры();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	// Если обмен есть, но еще не по формату 1.16 или подпись выполняется при обмене, подписывать нельзя.
	ТекНастройки = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Организация);	 
	Если ТекНастройки.ВерсияФорматов <> "1.16" ИЛИ ТекНастройки.РежимПодписи<>"Самостоятельно" Тогда
		Элементы.ГруппаПодписи.Видимость = Ложь;
	Иначе
		Элементы.ГруппаПодписи.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура НалогСборПлатежПриИзменении(Элемент)
	
	НалогСборПлатежПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура УстановленныйСтатусДокументаНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ИзменитьСтатусДокумента();
КонецПроцедуры

&НаКлиенте
Процедура СтатусЭтогоДокументаНажатие(Элемент)
	ИзменитьСтатусДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	ДоговорПриИзмененииНаСервере();	
	
	Если ИспользоватьИнтеграциюСУНИФО Тогда
		ИзменитьЗначениеРеквизитаИдентификатора("Договор",Объект.Договор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УчащийсяПриИзменении(Элемент)
	Если НЕ ЗначениеЗаполнено(Объект.Учащийся) Тогда
		Объект.ГруппаДетскогоУчреждения = Неопределено;
	КонецЕсли;
	Если ИспользоватьИнтеграциюСУНИФО Тогда
		ИзменитьЗначениеРеквизитаИдентификатора("Учащийся",Объект.Учащийся);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)
	
	ПриИзмененииЛицевогоСчетаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("Организация, ТекущаяСтрока, НаДату", Объект.Организация, Объект.РеквизитыЛицевогоСчета, Объект.Дата);
	ОткрытьФорму("Справочник.РеквизитыЛицевыхСчетов.ФормаВыбора", ПараметрыФормы, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Объект.РеквизитыЛицевогоСчета 	= ВыбранноеЗначение;
	ЛицевойСчетОбработкаВыбораНаСервере(ВыбранноеЗначение);

КонецПроцедуры

&НаСервере
Процедура ЛицевойСчетОбработкаВыбораНаСервере(ВыбранноеЗначение)
	Объект.ЛицевойСчет 	= ПолучитьЛицевойСчет(ВыбранноеЗначение);
    ПриИзмененииЛицевогоСчетаНаСервере();	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	
	Если ХарактеристикиГосуслуги.Номенклатура = Объект.Номенклатура Тогда
		// ничего не делаем
		Возврат
	КонецЕсли;
	
	ПриИзмененииНоменклатуры();
		
КонецПроцедуры

&НаКлиенте
Процедура ПлательщикПриИзменении(Элемент)
	
	Объект.Договор = Неопределено;	
	
	Если ЗначениеЗаполнено(Объект.Номенклатура) 
		И (ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП) Тогда
		ПлательщикПриИзмененииСервер();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ПлательщикНаименование)
		И Не ЗначениеЗаполнено(Объект.Плательщик) Тогда
		//наименование плательщика может заполняться при загрузке документа из сервиса,
		//например, по подписке, при этом плательщик может быть не заполнен, 
		//если его не удалось определить по идентификатору, 
		//и чтобы проще было понять, кому это начисление, загружается наименование плательщика
		Элементы.ПлательщикНаименование.Видимость = ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП;
	Иначе
		Элементы.ПлательщикНаименование.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПлательщикПриИзмененииСервер()
		
	Если ИнтеграцияГИСГМП ИЛИ ИспользоватьИнтеграциюСУНИФО Тогда
		ИзменитьЗначениеРеквизитаИдентификатора("Договор",Объект.Договор);
		ИзменитьЗначениеРеквизитаИдентификатора("Плательщик",Объект.Плательщик);
	КонецЕсли;
	
	ВидКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Плательщик, "ВидКонтрагента");
	УстановитьВидимостьЭлементовЧековККМ(ЭтаФорма, ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо);
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура("Отбор");
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(Объект.Учащийся) И ТипЗнч(Объект.Учащийся) = Тип("СправочникСсылка.Дети") Тогда 		
		ПараметрыФормы.Отбор = Новый Структура("Контрагент",Объект.Учащийся);		
	Иначе
		ПараметрыФормы.Отбор = Новый Структура("Контрагент",Объект.Плательщик);
	КонецЕсли;
	ПараметрыФормы.Отбор.Вставить("Организация",Объект.Организация);
	ОткрытьФорму("Справочник.Договоры.ФормаВыбора",ПараметрыФормы,Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ВидКвитанцииПриИзменении(Элемент)
	
	Элементы.ПричинаАннулирования.ТолькоПросмотр = Объект.ВидКвитанции <= 1;
	
	Если Объект.ВидКвитанции >1 Тогда
		Объект.ДатаИзменения = ТекущаяДата();
	Иначе
		Объект.ДатаИзменения = "";
	КонецЕсли;
	
	Если Объект.ВидКвитанции = 3 И ЗначениеЗаполнено(Объект.СуммаДокумента) Тогда
		
		//Аннулируем
		Объект.АннулированнаяСуммаДокумента = Объект.СуммаДокумента;
						
	КонецЕсли;
	
	Если Объект.ВидКвитанции <> 3 И Объект.СуммаДокумента = 0 Тогда
		Объект.СуммаДокумента = Объект.АннулированнаяСуммаДокумента;
		Объект.АннулированнаяСуммаДокумента = 0;
	КонецЕсли;
		
	Если Объект.ВидКвитанции<=1 Тогда
		Объект.ПричинаАннулирования = "";	
	КонецЕсли;
	
КонецПроцедуры

