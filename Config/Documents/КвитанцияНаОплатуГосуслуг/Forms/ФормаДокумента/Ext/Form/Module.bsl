
&НаКлиенте
Перем КомпонентаПодписи;

&НаКлиенте
Перем ПутьКПрограмме;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ХарактеристикиГосуслуги = Новый ФиксированнаяСтруктура(Справочники.Номенклатура.ПолучитьХарактеристикиГосуслуги(Объект.Номенклатура, Объект.Дата));
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, БухгалтерскийУчетКлиентСервер.ПолучитьЗначенияНалоговыхРеквизитов(Объект));
		
	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтаФорма);
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка,
		Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			Объект.УникальныйИдентификаторНачисления = "";
			Объект.ДокументОснование = Неопределено;
			Объект.ИДСтрокиДокументаОснования = Неопределено;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.РеквизитыЛицевогоСчета) Тогда
			
			ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию();
			
		Иначе
			
			ПриИзмененииЛицевогоСчетаНаСервере();
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.ВидОбменаДляQRКода) ИЛИ НЕ ЗначениеЗаполнено(Объект.ФорматОбменаДляQRКода) Тогда
			Объект.ВидОбменаДляQRКода = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ВидОбменаДляQRКода_КвитанцияНаОплату", "");
			Объект.ФорматОбменаДляQRКода = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ФорматОбменаДляQRКода_КвитанцияНаОплату", "");
		КонецЕсли;
		
	КонецЕсли;
	
	ИспользоватьИнтеграциюСУНИФО = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО");
	ИнтеграцияГИСГМП = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
	
	Элементы.ОбновитьУИН.Доступность = Параметры.Ключ.Пустая() ИЛИ ПроверитьСтатусДокумента(Объект.Ссылка);
	Элементы.ОбновитьУИН.Видимость = ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП;
	Элементы.ФормаОбновитьИдентификаторы.Видимость = ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП;
	
	Элементы.ГруппаОКВЭД.Видимость = ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП;
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.ВидКвитанции = 1;
		Объект.ДатаИзменения = "";
		Объект.ПлательщикНаименование = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ПлательщикНаименование)
		И Не ЗначениеЗаполнено(Объект.Плательщик) Тогда
		//наименование плательщика может заполняться при загрузке документа из сервиса,
		//например, по подписке, при этом плательщик может быть не заполнен, 
		//если его не удалось определить по идентификатору, 
		//и чтобы проще было понять, кому это начисление, загружается наименование плательщика
		Элементы.ПлательщикНаименование.Видимость = ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП;
	Иначе
		Элементы.ПлательщикНаименование.Видимость = Ложь;
	КонецЕсли;
	
	ИспользоватьУчетРП = ПолучитьФункциональнуюОпцию("ИспользоватьУчетРодительскойПлаты");
	ИспользоватьУчетСтудентов = ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтудентов");
	
	Элементы.ГруппаДетскогоУчреждения.Видимость = ИспользоватьУчетРП;
	
	Если НЕ (ИспользоватьУчетРП И ИспользоватьУчетСтудентов) Тогда
		МассивТипов = Новый Массив;
		Если ИспользоватьУчетРП Тогда
			МассивТипов.Добавить(Тип("СправочникСсылка.Дети"));
		КонецЕсли;
		Если ИспользоватьУчетСтудентов Тогда
			МассивТипов.Добавить(Тип("СправочникСсылка.Студенты"));
		КонецЕсли;
		ОписаниеТиповУчащихся = Новый ОписаниеТипов(МассивТипов);
		Элементы.Учащийся.ОграничениеТипа = ОписаниеТиповУчащихся;
		Элементы.Учащийся.ДоступныеТипы = ОписаниеТиповУчащихся;
	КонецЕсли;
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	Элементы.ПричинаАннулирования.ТолькоПросмотр = Объект.ВидКвитанции <= 1;
	
	Если ИспользоватьИнтеграциюСУНИФО Тогда
		Если Объект.ТаблицаИдентификаторов.Количество()>0 Тогда
			СформироватьДополнительныеРеквизиты();
			
			Отбор = Новый Структура;
			Отбор.Вставить("ТипПоля","ЕдиныйИдентификатор");
			СтрокиИдентификатораПлательщика = Объект.ТаблицаИдентификаторов.НайтиСтроки(Отбор);
			
			Отбор.Вставить("ТипПоля","ЕдиныйИдентификаторУчащегося");
			СтрокиИдентификатораУчащегося = Объект.ТаблицаИдентификаторов.НайтиСтроки(Отбор);
			Если СтрокиИдентификатораПлательщика.Количество()>0 
				ИЛИ СтрокиИдентификатораУчащегося.Количество()>0 Тогда
				Элементы.ЕдиныйИдентификаторПлательщика.Видимость = Истина;
			КонецЕсли;
			
			Отбор = Новый Структура;
			Отбор.Вставить("ТипПоля","АльтернативныйИдентификатор");
			СтрокиИдентификатораПлательщика = Объект.ТаблицаИдентификаторов.НайтиСтроки(Отбор);
			
			Отбор.Вставить("ТипПоля","АльтернативныйИдентификаторУчащегося");
			СтрокиИдентификатораУчащегося = Объект.ТаблицаИдентификаторов.НайтиСтроки(Отбор);
			Если СтрокиИдентификатораПлательщика.Количество()>0 
				ИЛИ СтрокиИдентификатораУчащегося.Количество()>0 Тогда
				
				Элементы.АльтернативныйИдентификаторПлательщика.Видимость = Истина;
			КонецЕсли;
			
			Элементы.ОсновнойИдентификаторПлательщика.Видимость = Истина;
			Элементы.ДополнительныйИдентификаторПлательщика.Видимость = Истина;
		КонецЕсли;
	ИначеЕсли ИнтеграцияГИСГМП Тогда
		Элементы.ЕдиныйИдентификаторПлательщика.Видимость = Истина;
		Элементы.АльтернативныйИдентификаторПлательщика.Видимость = Истина;
		Элементы.ОсновнойИдентификаторПлательщика.Видимость = Истина;
		Элементы.ДополнительныйИдентификаторПлательщика.Видимость = Истина;
	КонецЕсли;
	
	Если НЕ (ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП) Тогда
		// Если нет обмена с ГИС ГМП или ИС РНИП / ИС УНП, то подписи не должно быть.
		Элементы.ГруппаПодписи.Видимость = Ложь;
		Элементы.ГруппаИнформацияОПодписи.Видимость = Ложь;
	Иначе		
		// Если обмен есть, но еще не по формату 1.16 или подпись выполняется при обмене, подписывать нельзя.
		ТекНастройки = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Организация);	 
		Если ТекНастройки.ВерсияФорматов <> "1.16" ИЛИ ТекНастройки.РежимПодписи<>"Самостоятельно" Тогда
			Элементы.ГруппаПодписи.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Дата) И Год(Объект.Дата) < 2015 Тогда
		Элементы.КодОКАТО.Заголовок = "Код ОКАТО (105)";
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Объект.ПроцентСкидки) Тогда
		ВидСкидки = 1;
	ИначеЕсли ЗначениеЗаполнено(Объект.ПонижающийКоэффициент) Тогда
		ВидСкидки = 2;
	ИначеЕсли ЗначениеЗаполнено(Объект.ФиксированнаяСуммаСкидки) Тогда
		ВидСкидки = 3;
	КонецЕсли;
	
	Элементы.ГруппаСкидка.Видимость = (ВидСкидки <> 0);
	
	Если ВидСкидки = 1 Тогда
		Элементы.ГруппаСтраницСкидки.ТекущаяСтраница = Элементы.ГруппаПроцент;
	ИначеЕсли ВидСкидки = 2 Тогда
		Элементы.ГруппаСтраницСкидки.ТекущаяСтраница = Элементы.ГруппаКоэффициент;
	ИначеЕсли ВидСкидки = 3 Тогда
		Элементы.ГруппаСтраницСкидки.ТекущаяСтраница = Элементы.ГруппаФиксированная;
	КонецЕсли;	
	
	ПлатежноРасчетныеДокументы.ПриСозданииНаСервереФормыДокумента(ЭтаФорма);
	
	ВидКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Плательщик, "ВидКонтрагента");
	УстановитьВидимостьЭлементовЧековККМ(ЭтаФорма, ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо);
	
	УстановитьДоступностьЭлементовСуммы(ЭтотОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами".
	
	НастройкаQRкода = УправлениеПечатьюБГУКлиентСервер.СформироватьНадписьНастройкаQRкода(Объект.ВидОбменаДляQRКода, Объект.ФорматОбменаДляQRКода);

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ЗаполнитьЗаголовокСоотнесенияПлатежей(ТекущийОбъект.Ссылка,ТекущийОбъект.УникальныйИдентификаторНачисления);
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект,
		Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	УстановитьДоступностьРедактированияДокумента(ТекущийОбъект.Ссылка);
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УстановитьДоступностьРеквизитов();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП Тогда
		Если НЕ ЗначениеЗаполнено(ТекущийОбъект.УникальныйИдентификаторНачисления) Тогда
			Документы.КвитанцияНаОплатуГосуслуг.СформироватьИдентификаторНачисления(ТекущийОбъект);
			Если НЕ ЗначениеЗаполнено(ТекущийОбъект.УникальныйИдентификаторНачисления) Тогда
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПлатежноРасчетныеДокументы.ПередЗаписьюНаСервереДокумента(ЭтотОбъект, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ИзменениеХарактеристикГосуслуги" И Параметр = Объект.Номенклатура И НЕ ЭтаФорма.ТолькоПросмотр Тогда
		Модифицированность = Истина;
		ПриИзмененииНоменклатуры();
				
	ИначеЕсли ИмяСобытия = "ИзмененСтатус_ПлатежноРасчетныйДокумент"
		И Объект.Ссылка = Источник Тогда
		ТекСтатус = Неопределено;
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			ТекСтатус = Неопределено;
			Параметр.Свойство("Статус",ТекСтатус);
		Иначе
			ТекСтатус = Параметр;
		КонецЕсли;
		Если ТекСтатус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Подготовлен")
			ИЛИ ТекСтатус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.ВРаботе")
			ИЛИ ТекСтатус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.ПустаяСсылка") Тогда
			Элементы.ОбновитьУИН.Доступность = Истина;
		Иначе
			Элементы.ОбновитьУИН.Доступность = Ложь;
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "ОбновитьСтатус_ПлатежноРасчетныйДокумент"
		И Объект.Ссылка = Источник Тогда
		//статус изменен вне документа, но форма документа открыта - обновим в форме
		ОбновитьСтатусПлатежноРасчетныногоДокумента();
		
	ИначеЕсли ИмяСобытия = "СоотнесениеНачисленийИПлатежей" И Параметр = Объект.Ссылка Тогда
		ЗаполнитьЗаголовокСоотнесенияПлатежей(Объект.Ссылка,Объект.УникальныйИдентификаторНачисления);		
	ИначеЕсли ИмяСобытия = "ПодписьНачисления" И Параметр = Объект.Ссылка Тогда
		Если Источник <> Объект.Ссылка Тогда
			УстановитьДоступностьРедактированияДокумента(Объект.Ссылка);
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "ПодписьНачислений" Тогда
		УстановитьДоступностьРедактированияДокумента(Объект.Ссылка);
	КонецЕсли;
	
	ПлатежноРасчетныеДокументыКлиент.ОбработатьОповещения(ЭтаФорма, ИмяСобытия, Параметр, Источник);

	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".

	КонецЕсли;

	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусПлатежноРасчетныногоДокумента()
	ПлатежноРасчетныеДокументы.ПриСозданииНаСервереФормыДокумента(ЭтаФорма);	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ВидОбменаДляQRКода_КвитанцияНаОплату", "", Объект.ВидОбменаДляQRКода);
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ФорматОбменаДляQRКода_КвитанцияНаОплату", "", Объект.ФорматОбменаДляQRКода);

	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

    ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	УправлениеПечатьюБГУКлиент.ОбработатНастройкиQRкода(ВыбранноеЗначение, ИсточникВыбора, Объект.ВидОбменаДляQRКода, Объект.ФорматОбменаДляQRКода, НастройкаQRкода);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

