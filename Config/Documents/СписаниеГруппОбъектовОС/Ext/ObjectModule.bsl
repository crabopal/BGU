#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УправлениеОсновнымиСредствами.ПроверитьЗаполнениеКПСвТЧ(
		ЭтотОбъект, "ОсновныеСредства", "Основные средства", 
		?(ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет, "ЗабалансовыйСчет", "СчетУчета"), Отказ);
	Если Отказ Тогда
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
	МассивРеквизитовКУдалению = Новый Массив;
	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС") Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("101.00");
		МассивРеквизитовКУдалению.Добавить("Контрагент");
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет") Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("21");
		МассивРеквизитовКУдалению.Добавить("Контрагент");
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование") Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("01");
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении") Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("02.1");
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений") Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("106.00");
		МассивРеквизитовКУдалению.Добавить("ЦМО");
	КонецЕсли;

	Если НЕ СвойстваСчета.УчетПоКПС Тогда
		МассивРеквизитовКУдалению.Добавить("КПС");
	КонецЕсли;
	Если НЕ (ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И СвойстваСчета.УчетПоПодразделениям) Тогда
		МассивРеквизитовКУдалению.Добавить("Подразделение");
	КонецЕсли;
	
	МассивИнвНомеров = Новый Массив;
	Для каждого ТекСтр Из ОсновныеСредства Цикл
	
		Если ЗначениеЗаполнено(ТекСтр.ИнвентарныйНомер) и ТекСтр.Количество>1 Тогда
			ТекстПредупреждения = НСтр("ru='Для объектов с присвоенным инвентарным номером не может быть количество больше 1'");
			ОбщегоНазначения.СообщитьПользователю(ТекстПредупреждения,,"Объект.ОсновныеСредства["+(ТекСтр.НомерСтроки-1)+"].Количество",,Отказ);
		КонецЕсли;			
		Если ЗначениеЗаполнено(ТекСтр.ИнвентарныйНомер) И МассивИнвНомеров.Найти(ТекСтр.ИнвентарныйНомер)<>Неопределено Тогда
			ТекстСообщения = НСтр("ru='Ошибка в строке [НомерСтроки]. Инв. номер уже встречался в данном документе ранее.'");
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстСообщения,
																	Новый Структура("НомерСтроки", ТекСтр.НомерСтроки)),,
																"Объект.ОсновныеСредства["+(ТекСтр.НомерСтроки-1)+"].ИнвентарныйНомер",,Отказ);
		Иначе
			МассивИнвНомеров.Добавить(ТекСтр.ИнвентарныйНомер);														
		КонецЕсли;
	КонецЦикла; 	
	
	Если Отказ Тогда
		ПроверяемыеРеквизиты.Очистить();
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивРеквизитовКУдалению);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ДатаСписанияСБухУчета) Тогда
		ЭтотОбъект.ДатаСписанияСБухУчета = ЭтотОбъект.Дата;
	КонецЕсли;
	
	СуммаДокумента = ОсновныеСредства.Итог("Сумма");
	
	УправлениеОсновнымиСредствами.ПроверитьОчиститьКПСвТаблицеДокумента(
		ОсновныеСредства, ?(ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет, "ЗабалансовыйСчет", "СчетУчета"), Дата);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли