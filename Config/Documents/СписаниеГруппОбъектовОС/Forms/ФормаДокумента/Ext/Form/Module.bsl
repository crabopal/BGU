#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОсновныеСредства

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(Знач ВыбранноеЗначение)
	
	ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(
		Объект.ОсновныеСредства, ВыбранноеЗначение, , "ОсновноеСредство,ИнвентарныйНомер");
	
	УстановитьДинамическиеДанныеТаблицыОсновныеСредства();
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьУстановитьКоличествоОСВСтроке(СтрокаТаблицы);
	КонецЦикла;
	
	РассчитатьСуммыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.Организация",,Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура);
	ПараметрыФормы.Отбор.Вставить("Организация", Объект.Организация);
	УправлениеОсновнымиСредствамиКлиент.ДобавитьОбщиеПараметрыВыбораОсновныхСредствПриВыбытии(
		ПараметрыФормы, Объект.ВидОперации);
	
	ПараметрыФормы.Вставить("ТекущаяСтрока",   Элементы.ОсновныеСредства.ТекущиеДанные.ОсновноеСредство);
	ПараметрыФормы.Вставить("ТребуемыеДанные", "Цена,ИнвентарныйНомер");
	
	ОткрытьФорму("Справочник.ОсновныеСредства.ФормаВыбора", ПараметрыФормы, Элемент);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Структура")
	 ИЛИ НЕ ВыбранноеЗначение.Свойство("Ссылка") Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранноеЗначение.Свойство("ИнвентарныйНомер") Тогда
		ТекущиеДанные.ИнвентарныйНомер = ВыбранноеЗначение.ИнвентарныйНомер;
	КонецЕсли;
	
	ВыбранноеЗначение = ВыбранноеЗначение.Ссылка;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	ОсновноеСредствоПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаСервере
Процедура ОсновноеСредствоПриИзмененииНаСервере(Знач ИдентификаторСтроки)

	ТекущиеДанные = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	// Заполним динамические колонки в строке таблицы "Основные средства".
	ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ТекущиеДанные.ОсновноеСредство, Объект.Ссылка);
	ДанныеОбъектаОС.Вставить("ЗабалансовыйСчет", УправлениеОсновнымиСредствамиПовтИсп.ЗабалансовыйСчетОС(ДанныеОбъектаОС.СчетУчета));
	УстановитьДинамическиеДанныеСтрокиОсновныеСредства(ТекущиеДанные, ДанныеОбъектаОС);
	
	УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьУстановитьКоличествоОСВСтроке(ТекущиеДанные);
	
	// Заполним суммы по данным бухгалтерского учета.
	ПараметрыПолученияОстатков = ПараметрыПолученияОстатков();
	ПараметрыПолученияОстатков.ОсновноеСредство = ТекущиеДанные.ОсновноеСредство;
	Если ЗначениеЗаполнено(ТекущиеДанные.ИнвентарныйНомер) Тогда
		ПараметрыПолученияОстатков.ИнвентарныйНомер = ТекущиеДанные.ИнвентарныйНомер;
	Иначе
		ПараметрыПолученияОстатков.УстанавливатьИнвентарныйНомер = Истина;
	КонецЕсли;
	ПараметрыПолученияОстатков.УстанавливатьКПС = Истина;
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаКапвложений Тогда
		ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстаткиКапВложений(ПараметрыПолученияОстатков); 
	Иначе
		ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстатки(ПараметрыПолученияОстатков); 
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ОсновноеСредство",	"ОсновноеСредство");
	ПараметрыЗаполнения.Вставить("ИнвентарныйНомер",	"ИнвентарныйНомер");
	ПараметрыЗаполнения.Вставить("Количество",			"Количество");
	ПараметрыЗаполнения.Вставить("Цена",				"Цена");
	ПараметрыЗаполнения.Вставить("Сумма",				"Сумма");
	ПараметрыЗаполнения.Вставить("КПС",					"КПС");
	ПараметрыЗаполнения.Вставить("СуммаАмортизации",	"СуммаАмортизации");
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоБиблиотечныйФонд(ТекущиеДанные.СчетУчета) Тогда
		ПараметрыЗаполнения.Вставить("ЭтоБиблиотечныйФонд", Истина);
	КонецЕсли;
	
	ПараметрыЗаполнения.Вставить("УстанавливатьИнвентарныйНомер", Истина);
	
	УправлениеОсновнымиСредствами.ЗаполнитьОбъектИзТаблицыОстатков(ТаблицаОстатков, ТекущиеДанные, ПараметрыЗаполнения);

КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоАвтоПодбор(Элемент, Текст, ДанныеВыбора, Параметры, Ожидание, СтандартнаяОбработка)
	
	Если Не ПустаяСтрока(Текст) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура("Отбор", Новый Структура);
		ПараметрыФормы.Отбор.Вставить("Организация", Объект.Организация);
		УправлениеОсновнымиСредствамиКлиент.ДобавитьОбщиеПараметрыВыбораОсновныхСредствПриВыбытии(
			ПараметрыФормы, Объект.ВидОперации);
		
		ПараметрыФормы.Вставить("СтрокаПоиска",		Текст);
		ПараметрыФормы.Вставить("ТребуемыеДанные",	"Цена,ИнвентарныйНомер");
		
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.ОсновныеСредства"), ПараметрыФормы);
		
	КонецЕсли;
	
КонецПроцедуры

