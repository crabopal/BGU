&НаКлиенте
Процедура НачисленияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СтатусОперацииДоИзменения", ТекущиеДанные.СтатусОперации);
	
	Если НоваяСтрока И НЕ Копирование Тогда
		НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПризнакиСтатусаОперации = КлассифицироватьСтатусОперацииНачисленияДоходов(Элемент.ТекущиеДанные.СтатусОперации);
	ВСтатусеОперацииЕстьНастройкиПроводок = ЗначениеЗаполнено(ПризнакиСтатусаОперации.СтатусОперацииСчетДт);
	
	ТекстПредупреждения = "";
	
	Если НЕ ВСтатусеОперацииЕстьНастройкиПроводок Тогда
		ТекстПредупреждения = ТекстПредупреждения + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='В строке %1 для статуса %2 в отсутствует настройка для отражения в учете. Проводки сформированы не будут.'"),
				Элемент.ТекущиеДанные.НомерСтроки,
				Элемент.ТекущиеДанные.СтатусОперации);
	КонецЕсли;
	
	Если (ПризнакиСтатусаОперации.ЭтоНачислениеДоходов ИЛИ ПризнакиСтатусаОперации.ЭтоДеаннулированиеДоходов)
		И (Элемент.ТекущиеДанные.Сумма < 0 Или Элемент.ТекущиеДанные.СуммаВВалюте < 0) Тогда
		ТекстПредупреждения = ТекстПредупреждения + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Проверьте сумму начисления в строке %1. Для статуса %2 сумма начисления должна быть больше нуля.'"),
				Элемент.ТекущиеДанные.НомерСтроки,
				Элемент.ТекущиеДанные.СтатусОперации);
	КонецЕсли;
	
	Если (ПризнакиСтатусаОперации.ЭтоАннулированиеДоходов)
		И (Элемент.ТекущиеДанные.Сумма > 0 Или Элемент.ТекущиеДанные.СуммаВВалюте > 0) Тогда
		ТекстПредупреждения = ТекстПредупреждения + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Проверьте сумму начисления в строке %1. Для статуса %2 сумма начисления должна быть меньше нуля.'"),
				Элемент.ТекущиеДанные.НомерСтроки,
				Элемент.ТекущиеДанные.СтатусОперации);
	КонецЕсли;
	
	Если ПризнакиСтатусаОперации.ЭтоУточнениеДоходов
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДатаПризнанияДоходов)
		И Элемент.ТекущиеДанные.ДатаПризнанияДоходов < Объект.Дата Тогда
		ТекстПредупреждения = ТекстПредупреждения + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Проверьте дату признания дохода в строке %1. Для статуса %2 дата признания дохода не может быть ранее даты формирования ведомости %3.'"),
				Элемент.ТекущиеДанные.НомерСтроки,
				Элемент.ТекущиеДанные.СтатусОперации,
				Объект.Дата);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ПредельнаяДатаИсполнения) 
		И (НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДатаПризнанияДоходов)
		ИЛИ Элемент.ТекущиеДанные.ПредельнаяДатаИсполнения < Элемент.ТекущиеДанные.ДатаПризнанияДоходов
		ИЛИ Элемент.ТекущиеДанные.ПредельнаяДатаИсполнения < Объект.Дата) Тогда
		ТекстПредупреждения = ТекстПредупреждения + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Проверьте предельную дату исполнения в строке %1. Дата исполнения не может быть ранее даты признания дохода и даты формирования ведомости.'"),
				Элемент.ТекущиеДанные.НомерСтроки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстПредупреждения) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстПредупреждения,,, "Объект"); 
	Иначе
		ТекстПредупреждения = ПроверитьНаличиеУточняемыхДоходов(Элемент.ТекущиеДанные.СтатусОперации,
			Элемент.ТекущиеДанные.Контрагент,
			Элемент.ТекущиеДанные.ДоговорКонтрагента,
			Элемент.ТекущиеДанные.КОСГУ,
			Элемент.ТекущиеДанные.КПС,
			?(ЗначениеЗаполнено(Элемент.ТекущиеДанные.КФО), Элемент.ТекущиеДанные.КФО, ПредопределенноеЗначение("Перечисление.КВД.Бюджет")),
			Объект.Дата,
			Объект.Организация);
		Если ЗначениеЗаполнено(ТекстПредупреждения) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстПредупреждения + 
				НСтр("ru=' Проверьте данные в строке %1.'"), Элемент.ТекущиеДанные.НомерСтроки) ,,,, "Объект"); 
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	ХарактеристикиГосуслуги = ПолучитьХарактеристикиГосуслуги(ТекущиеДанные.Номенклатура, Объект.Дата);
	
	ТекущиеДанные.КодОКТМО = ХарактеристикиГосуслуги.КодОКАТО;
	ТекущиеДанные.НомерРеестровойЗаписи = ХарактеристикиГосуслуги.НомерРеестровойЗаписи;
	
	// Реквизиты КОСГУ, КПС и сумма к этому моменту могут быть заполнены по данным графиков исполнения.
	Если Не (ЗначениеЗаполнено(ТекущиеДанные.КОСГУ) И ТекущиеДанные.ВестиПланГрафикИсполнения)
		И ЗначениеЗаполнено(ХарактеристикиГосуслуги.КЭК) Тогда
		ТекущиеДанные.КОСГУ = ХарактеристикиГосуслуги.КЭК;
	КонецЕсли;
	Если Не (ЗначениеЗаполнено(ТекущиеДанные.КПС) И ТекущиеДанные.ВестиПланГрафикИсполнения)
		И ЗначениеЗаполнено(ХарактеристикиГосуслуги.КПС) Тогда
		ТекущиеДанные.КПС = ХарактеристикиГосуслуги.КПС;
	КонецЕсли;
	Если Не (ЗначениеЗаполнено(ТекущиеДанные.Сумма) И ТекущиеДанные.ВестиПланГрафикИсполнения) 
		И ЗначениеЗаполнено(ХарактеристикиГосуслуги.Стоимость) Тогда
		ТекущиеДанные.Сумма = ХарактеристикиГосуслуги.Стоимость;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияКПСПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	БухгалтерскийУчетКлиент.ПроверитьОчиститьКЭК(ТекущиеДанные.КПС, ТекущиеДанные.КОСГУ); 
КонецПроцедуры

&НаКлиенте
Процедура НачисленияКонтрагентПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	ТекущиеДанные.ИдентификаторПлательщика = ИдентификаторКонтрагента(ТекущиеДанные.Контрагент, Объект.ВидДокументаФизЛиц);
	
	НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные, 
		РеквизитыДоговоров(ТекущиеДанные.ДоговорКонтрагента));
	
	// СтандартныеПодсистемы.РаботаСКонтрагентами
	ПроверкаКонтрагентовКлиент.ЗапуститьПроверкуКонтрагентовВДокументе(ЭтотОбъект, Элементы.Начисления);
	// Конец СтандартныеПодсистемы.РаботаСКонтрагентами
		
КонецПроцедуры

&НаКлиенте
Процедура НачисленияКонтрагентНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ПараметрыВыбораКонтрагента = Новый Массив;   
	
	Если Объект.Групповая Тогда
		ПараметрыВыбораКонтрагента.Добавить(Новый ПараметрВыбора("ПоказыватьУчетныеГруппы", Истина));
	КонецЕсли;  
	
	Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораКонтрагента); 
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияДоговорКонтрагентаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные; 
	РеквизитыДоговора = РеквизитыДоговоров(ТекущиеДанные.ДоговорКонтрагента); 
	ДокОснование = РеквизитыДоговора.Получить(ТекущиеДанные.ДоговорКонтрагента);
	
	Если НЕ ДокОснование = Неопределено Тогда
		ТекущиеДанные.ВидПервичногоДокумента = ДокОснование.ВидОбязательства;
		ТекущиеДанные.ДатаПервичногоДокумента = ДокОснование.ДатаДоговора;
		ТекущиеДанные.НомерПервичногоДокумента = ДокОснование.НомерДоговора;
	КонецЕсли;	
		
	НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные, РеквизитыДоговора); 
	
КонецПроцедуры  

