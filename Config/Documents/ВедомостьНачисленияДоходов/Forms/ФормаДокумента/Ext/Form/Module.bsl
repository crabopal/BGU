&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ИспользоватьКонтрольИсполненияДоговоров", ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров"));
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ИспользоватьДетализациюПоКОСГУ", ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями"));
	
	ВыборкаСтатусыОпераций = Справочники.СтатусыОперацийНачисленияДоходов.Выбрать();
	Пока ВыборкаСтатусыОпераций.Следующий() Цикл
		ПризнакиСтатусаОперации = УчетДоходовРасходов.КлассифицироватьСтатусОперацииНачисленияДоходов(ВыборкаСтатусыОпераций.Ссылка);
		Если ПризнакиСтатусаОперации.ЭтоНачислениеДоходовБудущихПериодов Тогда
			СтатусыНачислениеДоходовБудущихПериодов.Добавить(ВыборкаСтатусыОпераций.Ссылка);
		ИначеЕсли ПризнакиСтатусаОперации.ЭтоНачислениеДоходовТекущегоПериода Тогда
			СтатусыНачислениеДоходовТекущегоПериода.Добавить(ВыборкаСтатусыОпераций.Ссылка);
		ИначеЕсли ПризнакиСтатусаОперации.ЭтоПризнаниеДоходовТекущегоПериода Тогда
			СтатусыПризнаниеДоходовТекущегоПериода.Добавить(ВыборкаСтатусыОпераций.Ссылка);
		ИначеЕсли ПризнакиСтатусаОперации.ЭтоУточнениеДатыПризнанияДоходов Тогда
			СтатусыУточнениеДатыПризнанияДоходов.Добавить(ВыборкаСтатусыОпераций.Ссылка);
		ИначеЕсли ПризнакиСтатусаОперации.ЭтоУточнениеПредельнойДатыИсполнения Тогда
			СтатусыУточнениеПредельнойДатыИсполнения.Добавить(ВыборкаСтатусыОпераций.Ссылка);
		ИначеЕсли ПризнакиСтатусаОперации.ЭтоУточнениеДатИсполнения Тогда
			СтатусыУточнениеДатИсполнения.Добавить(ВыборкаСтатусыОпераций.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПредупреждениеКонтрольИсполненияДоговоров", "Заголовок",
		КонтрольИсполненияДоговоров.ТекстПредупрежденияУчетЗадолженностиВРазрезеДатИсполнения());
	
	НачисленияЗаполнитьДобавленныеКолонки();
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияПоказатьПредупреждение");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Начисления.ПоказатьПредупреждение", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияАвтоматическиОтразитьВГрафикахИсполненияДоговоров");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Начисления.ДоступностьОтразитьВГрафикахИсполненияДоговоров", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не используется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	СтатусыОперацийУточнениеДатыПризнанияДоходов = Новый СписокЗначений;
	Для Каждого ЭлементСписка Из СтатусыУточнениеДатыПризнанияДоходов Цикл
		СтатусыОперацийУточнениеДатыПризнанияДоходов.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	Для Каждого ЭлементСписка Из СтатусыУточнениеДатИсполнения Цикл
		СтатусыОперацийУточнениеДатыПризнанияДоходов.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияЗаголовокДатаПризнанияДоходовДоИзменения");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияДатаПризнанияДоходовДоИзменения");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Начисления.СтатусОперации", ВидСравненияКомпоновкиДанных.НеВСписке, СтатусыОперацийУточнениеДатыПризнанияДоходов);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	СтатусыОперацийУточнениеПредельнойДатыИсполнения = Новый СписокЗначений;
	Для Каждого ЭлементСписка Из СтатусыУточнениеПредельнойДатыИсполнения Цикл
		СтатусыОперацийУточнениеПредельнойДатыИсполнения.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	Для Каждого ЭлементСписка Из СтатусыУточнениеДатИсполнения Цикл
		СтатусыОперацийУточнениеПредельнойДатыИсполнения.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияЗаголовокПредельнаяДатаИсполненияДоИзменения");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НачисленияПредельнаяДатаИсполненияДоИзменения");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Начисления.СтатусОперации", ВидСравненияКомпоновкиДанных.НеВСписке, СтатусыОперацийУточнениеПредельнойДатыИсполнения);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	
	Объект = Форма.Объект;
	
	МассивЭлементов = Новый Массив();
	МассивЭлементов.Добавить("ВидДокументаФизЛиц");
	МассивЭлементов.Добавить("НачисленияИдентификаторПлательщика");
	МассивЭлементов.Добавить("НачисленияДатаПризнанияДоходов");
	МассивЭлементов.Добавить("НачисленияДатаПризнанияДоходовДоИзменения");
	МассивЭлементов.Добавить("НачисленияЗаголовокДатаПризнанияДоходовДоИзменения");
	МассивЭлементов.Добавить("НачисленияВидПервичногоДокумента");
	МассивЭлементов.Добавить("НачисленияДатаПервичногоДокумента");
	МассивЭлементов.Добавить("НачисленияНомерПервичногоДокумента");
	МассивЭлементов.Добавить("НачисленияПредельнаяДатаИсполнения");
	МассивЭлементов.Добавить("НачисленияПредельнаяДатаИсполненияДоИзменения");
	МассивЭлементов.Добавить("НачисленияЗаголовокПредельнаяДатаИсполненияДоИзменения");
	МассивЭлементов.Добавить("НачисленияУникальныйИдентификаторНачисления");
	МассивЭлементов.Добавить("НачисленияАвтоматическиОтразитьВГрафикахИсполненияДоговоров");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, МассивЭлементов, "Видимость", НЕ Объект.Групповая);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НачисленияКФО", "Видимость", Объект.Групповая);
	
	ПредупреждениеКонтрольИсполненияДоговоров = Новый Массив;
	ПредупреждениеКонтрольИсполненияДоговоров.Добавить("ПредупреждениеКонтрольИсполненияДоговоров");
	ПредупреждениеКонтрольИсполненияДоговоров.Добавить("ДекорацияПредупреждениеКонтрольИсполненияДоговоров");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ПредупреждениеКонтрольИсполненияДоговоров, "Видимость",
		НЕ Форма.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров И НЕ Объект.Групповая);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИдентификаторКонтрагента(Контрагент, ВидДокументаФизЛиц)
	
	Возврат БухгалтерскийУчет.ИдентификаторКонтрагента(Контрагент, ВидДокументаФизЛиц);
	
КонецФункции

&НаСервереБезКонтекста
Функция РеквизитыДоговоров(Договоры)
	
	Если ТипЗнч(Договоры) = Тип("СправочникСсылка.Договоры") Тогда
		Ссылки = Новый Массив;
		Ссылки.Добавить(Договоры);
	Иначе
		Ссылки = Договоры;
	КонецЕсли;  
	
	РеквизитыДоговора = Новый Массив;
	РеквизитыДоговора.Добавить("Ссылка");
	РеквизитыДоговора.Добавить("ВидОбязательства");
	РеквизитыДоговора.Добавить("ДатаДоговора");
	РеквизитыДоговора.Добавить("НомерДоговора");  
	РеквизитыДоговора.Добавить("ВидДоговора");
	РеквизитыДоговора.Добавить("ВестиГрафикПлатежей");
	РеквизитыДоговора.Добавить("ВестиПланГрафикИсполнения");
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Ссылки, РеквизитыДоговора);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьХарактеристикиГосуслуги(Номенклатура, НаДату)

	Возврат Справочники.Номенклатура.ПолучитьХарактеристикиГосуслуги(Номенклатура, НаДату);

КонецФункции

&НаСервереБезКонтекста
Функция КлассифицироватьСтатусОперацииНачисленияДоходов(СтатусОперации)
	Возврат УчетДоходовРасходов.КлассифицироватьСтатусОперацииНачисленияДоходов(СтатусОперации);
КонецФункции

&НаСервере
Процедура ЗаполнитьДокументПоГрафикамИсполнения(ДанныеСтроки)
	
	Если Не ЗначениеЗаполнено(ДанныеСтроки.СтатусОперации) Тогда
		Возврат;
	КонецЕсли;
	
	ПризнакиСтатусаОперации = УчетДоходовРасходов.КлассифицироватьСтатусОперацииНачисленияДоходов(ДанныеСтроки.СтатусОперации);
	
	Отбор = Новый Структура;
	Отбор.Вставить("СчетРасчетов", БухгалтерскийУчет.СписокСчетов(
		ПризнакиСтатусаОперации.СтатусОперацииСчетРасчетов, Объект.Дата,, Объект.Организация));
	
	Если СтрНайти(ПризнакиСтатусаОперации.СтатусОперацииСчетРасчетов, "207.00") > 0 Тогда
		Отбор.Вставить("ВидРасчетов", Перечисления.ВидыРасчетовПоЗаймам.Проценты);
	Иначе
		Отбор.Вставить("ВидРасчетов", Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг);
	КонецЕсли;
	
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		Отбор.Вставить("ИФО", Объект.ИФО);
	КонецЕсли;
	Отбор.Вставить("Контрагент", ДанныеСтроки.Контрагент);
	Отбор.Вставить("Договор", ДанныеСтроки.ДоговорКонтрагента);
	Отбор.Вставить("КФО", ?(Объект.Групповая, ДанныеСтроки.КФО, Перечисления.КВД.Бюджет));
	Отбор.Вставить("КПС", ДанныеСтроки.КПС);
	Если ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьДетализациюПоКОСГУ Тогда
		Отбор.Вставить("КЭК", ДанныеСтроки.КОСГУ);
	КонецЕсли;
	
	ЭтоУточнениеДатыПризнанияДоходов = СтатусыУточнениеДатыПризнанияДоходов.НайтиПоЗначению(ДанныеСтроки.СтатусОперации) <> Неопределено;
	ЭтоУточнениеПредельнойДатыИсполнения = СтатусыУточнениеПредельнойДатыИсполнения.НайтиПоЗначению(ДанныеСтроки.СтатусОперации) <> Неопределено;
	ЭтоУточнениеДатИсполнения = СтатусыУточнениеДатИсполнения.НайтиПоЗначению(ДанныеСтроки.СтатусОперации) <> Неопределено;
	
	Если ЭтоУточнениеДатыПризнанияДоходов
		И ДанныеСтроки.ВестиПланГрафикИсполнения Тогда
		
		ДоходыКПризнанию = КонтрольИсполненияДоговоров.НеисполненныеДоговораСПокупателями(Отбор, Объект.Организация);
		Если ДоходыКПризнанию.Количество() = 1 Тогда
			
			// Частный случай - одна строка доходов к признанию по договору, все доходы признаются на заданную дату ИсполнитьДо.
			ДоходКПризнанию = ДоходыКПризнанию[0];
			ЗаполнитьЗначенияСвойств(ДанныеСтроки, ДоходКПризнанию, "КФО,КПС,Валюта");
			ДанныеСтроки.КОСГУ = ДоходКПризнанию.КЭК;
			ДанныеСтроки.ДатаПризнанияДоходовДоИзменения = ДоходКПризнанию.ИсполнитьДо;
			ДанныеСтроки.ДатаПризнанияДоходов = ДанныеСтроки.ДатаПризнанияДоходовДоИзменения;
			
			Если ДоходКПризнанию.Валюта = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
				ДанныеСтроки.Сумма = ДоходКПризнанию.Сумма;
			Иначе
				ДанныеСтроки.СуммаВВалюте = ДоходКПризнанию.Сумма;
				КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДанныеСтроки.Валюта, Объект.Дата);
				ДанныеСтроки.Сумма = ДанныеСтроки.СуммаВВалюте * КурсВалюты.Курс / ?(КурсВалюты.Кратность=0, 1, КурсВалюты.Кратность);
			КонецЕсли;
			
			Если ДанныеСтроки.ВестиГрафикПлатежей Тогда
				
				// Дополним структуру отбора, определяем предельную дату исполнения по данным графика платежей (справочно).
				Отбор.Вставить("Валюта", ДоходКПризнанию.Валюта);
				Отбор.Вставить("Сумма", ДоходКПризнанию.Сумма);
				НеисполненныеПлатежи = КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(Отбор, Объект.Организация);
				Если НеисполненныеПлатежи.Количество() > 0 Тогда
					НеисполненныйПлатеж = НеисполненныеПлатежи[0];
					ДанныеСтроки.ПредельнаяДатаИсполненияДоИзменения = НеисполненныйПлатеж.ОплатитьДо;
					ДанныеСтроки.ПредельнаяДатаИсполнения = ДанныеСтроки.ПредельнаяДатаИсполненияДоИзменения;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли (ЭтоУточнениеПредельнойДатыИсполнения ИЛИ ЭтоУточнениеДатИсполнения)
		И ДанныеСтроки.ВестиГрафикПлатежей Тогда
		
		// В случае уточнения обеих дат исполнения (дата признания доходов, предельная дата исполнения) заполняем по графику платежей,
		// поскольку для доходов текущего периода движения "план" и "факт" в план-график реализации выполняются одновременно.
		
		НеисполненныеПлатежи = КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(Отбор, Объект.Организация);
		Если НеисполненныеПлатежи.Количество() = 1 Тогда
			
			// Частный случай - один планируемый платеж по договору, вся задолженность оплачивается не позднее даты ОплатитьДо.
			НеисполненныйПлатеж = НеисполненныеПлатежи[0];
			ЗаполнитьЗначенияСвойств(ДанныеСтроки, НеисполненныйПлатеж, "КФО,КПС,Валюта");
			ДанныеСтроки.КОСГУ = НеисполненныйПлатеж.КЭК;
			ДанныеСтроки.ПредельнаяДатаИсполненияДоИзменения = НеисполненныйПлатеж.ОплатитьДо;
			ДанныеСтроки.ПредельнаяДатаИсполнения = ДанныеСтроки.ПредельнаяДатаИсполненияДоИзменения;
			
			Если НеисполненныйПлатеж.Валюта = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
				ДанныеСтроки.Сумма = НеисполненныйПлатеж.Сумма;
			Иначе
				ДанныеСтроки.СуммаВВалюте = НеисполненныйПлатеж.Сумма;
				КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДанныеСтроки.Валюта, Объект.Дата);
				ДанныеСтроки.Сумма = ДанныеСтроки.СуммаВВалюте * КурсВалюты.Курс / ?(КурсВалюты.Кратность=0, 1, КурсВалюты.Кратность);
			КонецЕсли;
			
			Если ДанныеСтроки.ВестиПланГрафикИсполнения Тогда
				
				// Дополним структуру отбора, определяем дату признания дохода по данным графика платежей (справочно).
				Отбор.Вставить("Валюта", НеисполненныйПлатеж.Валюта);
				Отбор.Вставить("Сумма", НеисполненныйПлатеж.Сумма);
				ДоходыКПризнанию = КонтрольИсполненияДоговоров.НеисполненныеДоговораСПокупателями(Отбор, Объект.Организация);
				Если ДоходыКПризнанию.Количество() > 0 Тогда
					ДоходКПризнанию = ДоходыКПризнанию[0];
					ДанныеСтроки.ДатаПризнанияДоходовДоИзменения = ДоходКПризнанию.ИсполнитьДо;
					ДанныеСтроки.ДатаПризнанияДоходов = ДанныеСтроки.ДатаПризнанияДоходовДоИзменения;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуСтрокиНаКлиенте(ДанныеСтроки)
	
	Если ЭтотОбъект.КэшПараметров.ИспользоватьВалютныйУчет Тогда 
		Если НЕ ЗначениеЗаполнено(ДанныеСтроки.Валюта)
			ИЛИ ДанныеСтроки.Валюта = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
			ДанныеСтроки.СуммаВВалюте = 0;
		ИначеЕсли ДанныеСтроки.СуммаВВалюте = 0 Тогда
			ДанныеСтроки.Сумма = 0;
		Иначе
			ДатаКурса = ?(ЗначениеЗаполнено(ДанныеСтроки.ДатаПризнанияДоходов), 
			            Мин(ДанныеСтроки.ДатаПризнанияДоходов, Объект.Дата), Объект.Дата);
			КурсКратность = ПолучитьКурс(ДанныеСтроки.Валюта, ДатаКурса);
			ДанныеСтроки.Сумма 	= ДанныеСтроки.СуммаВВалюте*КурсКратность.Курс/?(КурсКратность.Кратность=0, 1, КурсКратность.Кратность);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыСтрокНаСервере()
	
	Если НЕ ЭтотОбъект.КэшПараметров.ИспользоватьВалютныйУчет Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого ДанныеСтроки Из Объект.Начисления Цикл
		
		Если НЕ ЗначениеЗаполнено(ДанныеСтроки.Валюта)
			ИЛИ ДанныеСтроки.Валюта = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
			Если НЕ ДанныеСтроки.СуммаВВалюте = 0 Тогда
				ДанныеСтроки.СуммаВВалюте = 0;
				ЭтотОбъект.КэшПараметров.Служебные.ИзмениласьДатаДляКонтроляКурса = Истина;
			КонецЕсли;	
		ИначеЕсли ДанныеСтроки.СуммаВВалюте = 0 И НЕ ДанныеСтроки.Сумма = 0 Тогда
			ДанныеСтроки.Сумма = 0;
			ЭтотОбъект.КэшПараметров.Служебные.ИзмениласьДатаДляКонтроляКурса = Истина;
		Иначе
			ДатаКурса = ?(ЗначениеЗаполнено(ДанныеСтроки.ДатаПризнанияДоходов), 
			             Мин(ДанныеСтроки.ДатаПризнанияДоходов, Объект.Дата), Объект.Дата);
			КурсКратность = ПолучитьКурс(ДанныеСтроки.Валюта, ДатаКурса);
			НоваяСумма = ДанныеСтроки.СуммаВВалюте*КурсКратность.Курс/?(КурсКратность.Кратность=0, 1, КурсКратность.Кратность);
			Если НЕ ДанныеСтроки.Сумма = НоваяСумма Тогда
				ДанныеСтроки.Сумма = НоваяСумма;
				ЭтотОбъект.КэшПараметров.Служебные.ИзмениласьДатаДляКонтроляКурса = Истина;
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервереБезКонтекста
