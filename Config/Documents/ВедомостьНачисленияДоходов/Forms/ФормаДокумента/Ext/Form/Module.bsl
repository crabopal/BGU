&НаКлиенте
Процедура НачисленияСуммаВВалютеПриИзменении(Элемент)
	РассчитатьСуммуСтрокиНаКлиенте(Элементы.Начисления.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура НачисленияВидПервичногоДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Справочник.ВидыПервичныхДокументов.ФормаВыбора", ,Элемент);
КонецПроцедуры

&НаКлиенте
Процедура НачисленияСтатусОперацииПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	Если ТекущиеДанные.СтатусОперации = ЭтотОбъект.КэшПараметров.Локальные.СтатусОперацииДоИзменения Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Проведен Тогда
		Оповещение = Новый ОписаниеОповещения("НачисленияСтатусОперацииПриИзмененииОбработкаОтвета", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Проведение документа будет отменено. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		СтатусОперацииПриИзмененииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияСтатусОперацииПриИзмененииОбработкаОтвета(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СтатусОперацииПриИзмененииНаСервере();
	Иначе
		ТекущиеДанные.СтатусОперации = ЭтотОбъект.КэшПараметров.Локальные.СтатусОперацииДоИзменения;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияСтатусОперацииНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	
	ПараметрыВыбораСтатусаОперации = Новый Структура;
	ПараметрыВыбораСтатусаОперации.Вставить("Организация", Объект.Организация);
	ПараметрыВыбораСтатусаОперации.Вставить("НаДату", Объект.Дата);
	ПараметрыВыбораСтатусаОперации.Вставить("ТекущийСтатусОперации", ТекущиеДанные.СтатусОперации);
	
	ОткрытьФорму("Справочник.СтатусыОперацийНачисленияДоходов.ФормаВыбора", ПараметрыВыбораСтатусаОперации, Элемент);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияСтатусОперацииАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыВыбораСтатусаОперации = Новый Структура("СтрокаПоиска", Текст);
	ПараметрыВыбораСтатусаОперации.Вставить("Организация", Объект.Организация);
	ПараметрыВыбораСтатусаОперации.Вставить("НаДату", Объект.Дата);
	
	ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.СтатусыОперацийНачисленияДоходов"), ПараметрыВыбораСтатусаОперации);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияСтатусОперацииОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыВыбораСтатусаОперации = Новый Структура("СтрокаПоиска", Текст);
	ПараметрыВыбораСтатусаОперации.Вставить("Организация", Объект.Организация);
	ПараметрыВыбораСтатусаОперации.Вставить("НаДату", Объект.Дата);
	
	ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.СтатусыОперацийНачисленияДоходов"), ПараметрыВыбораСтатусаОперации);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура СтатусОперацииПриИзмененииНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	ДанныеСтроки = Объект.Начисления.НайтиПоИдентификатору(Элементы.Начисления.ТекущаяСтрока);
	
	ЭтоНачислениеДоходовБудущихПериодов = СтатусыНачислениеДоходовБудущихПериодов.НайтиПоЗначению(ДанныеСтроки.СтатусОперации) <> Неопределено;
	ЭтоНачислениеДоходовТекущегоПериода = СтатусыНачислениеДоходовТекущегоПериода.НайтиПоЗначению(ДанныеСтроки.СтатусОперации) <> Неопределено;
	ЭтоПризнаниеДоходовТекущегоПериода = СтатусыПризнаниеДоходовТекущегоПериода.НайтиПоЗначению(ДанныеСтроки.СтатусОперации) <> Неопределено;
	ЭтоУточнениеДатыПризнанияДоходов = СтатусыУточнениеДатыПризнанияДоходов.НайтиПоЗначению(ДанныеСтроки.СтатусОперации) <> Неопределено;
	ЭтоУточнениеПредельнойДатыИсполнения = СтатусыУточнениеПредельнойДатыИсполнения.НайтиПоЗначению(ДанныеСтроки.СтатусОперации) <> Неопределено;
	ЭтоУточнениеДатИсполнения = СтатусыУточнениеДатИсполнения.НайтиПоЗначению(ДанныеСтроки.СтатусОперации) <> Неопределено;
	
	Если ЭтоНачислениеДоходовБудущихПериодов Тогда
		ДанныеСтроки.СчетДоходов = БухгалтерскийУчет.СчетПоКоду("401.10", Объект.Дата, Объект.Организация);
		ДанныеСтроки.АвтоматическиОтразитьВГрафикахИсполненияДоговоров = ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров;
	Иначе
		ДанныеСтроки.СчетДоходов = "";
		Если ЭтоУточнениеДатыПризнанияДоходов
			ИЛИ ЭтоУточнениеПредельнойДатыИсполнения
			ИЛИ ЭтоУточнениеДатИсполнения
			ИЛИ ЭтоНачислениеДоходовТекущегоПериода
			ИЛИ ЭтоПризнаниеДоходовТекущегоПериода Тогда
			ДанныеСтроки.АвтоматическиОтразитьВГрафикахИсполненияДоговоров = ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров;
		Иначе
			ДанныеСтроки.АвтоматическиОтразитьВГрафикахИсполненияДоговоров = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтотОбъект.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров Тогда
		ЗаполнитьДокументПоГрафикамИсполнения(ДанныеСтроки);
	КонецЕсли;
	
	РеквизитыДоговоров = РеквизитыДоговоров(Объект.Начисления.Выгрузить(,"ДоговорКонтрагента").ВыгрузитьКолонку("ДоговорКонтрагента"));
	НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ДанныеСтроки, РеквизитыДоговоров);
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("СтатусОперацииДоИзменения", ДанныеСтроки.СтатусОперации);
	
КонецПроцедуры

&НаСервере
Процедура НачисленияЗаполнитьДобавленныеКолонки()
	
	РеквизитыДоговоров = РеквизитыДоговоров(Объект.Начисления.Выгрузить(,"ДоговорКонтрагента").ВыгрузитьКолонку("ДоговорКонтрагента"));
	
	Для Каждого СтрокаТаблицы Из Объект.Начисления Цикл
		
		НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы, РеквизитыДоговоров);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НачисленияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы, РеквизитыДоговоров = Неопределено)
	
	СтрокаТаблицы.ЗаголовокДоИзменения = НСтр("ru = 'до изм.:'");
	
	Если ТипЗнч(РеквизитыДоговоров) = Тип("Соответствие")
		И РеквизитыДоговоров[СтрокаТаблицы.ДоговорКонтрагента] <> Неопределено Тогда
		СтрокаТаблицы.ВестиГрафикПлатежей = РеквизитыДоговоров[СтрокаТаблицы.ДоговорКонтрагента].ВестиГрафикПлатежей;
		СтрокаТаблицы.ВестиПланГрафикИсполнения = РеквизитыДоговоров[СтрокаТаблицы.ДоговорКонтрагента].ВестиПланГрафикИсполнения;
	Иначе
		СтрокаТаблицы.ВестиГрафикПлатежей = Ложь;
		СтрокаТаблицы.ВестиПланГрафикИсполнения = Ложь;
	КонецЕсли;
	
	ЭтоНачислениеДоходовБудущихПериодов = Форма.СтатусыНачислениеДоходовБудущихПериодов.НайтиПоЗначению(СтрокаТаблицы.СтатусОперации) <> Неопределено;
	ЭтоНачислениеДоходовТекущегоПериода = Форма.СтатусыНачислениеДоходовТекущегоПериода.НайтиПоЗначению(СтрокаТаблицы.СтатусОперации) <> Неопределено;
	ЭтоПризнаниеДоходовТекущегоПериода = Форма.СтатусыПризнаниеДоходовТекущегоПериода.НайтиПоЗначению(СтрокаТаблицы.СтатусОперации) <> Неопределено;
	ЭтоУточнениеДатыПризнанияДоходов = Форма.СтатусыУточнениеДатыПризнанияДоходов.НайтиПоЗначению(СтрокаТаблицы.СтатусОперации) <> Неопределено;
	ЭтоУточнениеПредельнойДатыИсполнения = Форма.СтатусыУточнениеПредельнойДатыИсполнения.НайтиПоЗначению(СтрокаТаблицы.СтатусОперации) <> Неопределено;
	ЭтоУточнениеДатИсполнения = Форма.СтатусыУточнениеДатИсполнения.НайтиПоЗначению(СтрокаТаблицы.СтатусОперации) <> Неопределено;
	
	СтрокаТаблицы.ПоказатьПредупреждение = Ложь;
	СтрокаТаблицы.ТекстПредупреждения = "";
	Если ЭтоНачислениеДоходовБудущихПериодов Тогда
		
		Если НЕ Форма.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров Тогда
			СтрокаТаблицы.ПоказатьПредупреждение = Истина;
			СтрокаТаблицы.ТекстПредупреждения = НСтр("ru = 'Для автоматического признания доходов текущего периода по договору необходимо включить опцию ""Вести и контролировать исполнение графиков по договорам с контрагентами"" в настройках параметров учета (закладка ""Ведение учета"" в разделе ""Администрирование - Настройка параметров учета"").'");
		ИначеЕсли Не СтрокаТаблицы.ВестиПланГрафикИсполнения Тогда
			СтрокаТаблицы.ПоказатьПредупреждение = Истина;
			СтрокаТаблицы.ТекстПредупреждения = НСтр("ru = 'Для автоматического признания доходов текущего периода следует установить признак ""Вести графики исполнения - План-график реализации"" в карточке договора.'");
		КонецЕсли;
		
	КонецЕсли;
	
	СтрокаТаблицы.ДоступностьОтразитьВГрафикахИсполненияДоговоров =
		Форма.КэшПараметров.Локальные.ИспользоватьКонтрольИсполненияДоговоров
		И Не Форма.Объект.Групповая
		И (ЭтоНачислениеДоходовБудущихПериодов
			ИЛИ ЭтоНачислениеДоходовТекущегоПериода
			ИЛИ ЭтоПризнаниеДоходовТекущегоПериода
			ИЛИ ЭтоУточнениеДатыПризнанияДоходов
			ИЛИ ЭтоУточнениеПредельнойДатыИсполнения
			ИЛИ ЭтоУточнениеДатИсполнения);
	
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
		СтрокаТаблицы, СтрокаТаблицы.СчетДоходов, НачисленияПоляАналитикиСчетаДоходов());
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НачисленияПоляАналитикиСчетаДоходов()

	// Пути к данным полей аналитики счета, выбираемого в таблице формы.
	Возврат Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
