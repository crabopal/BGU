		ТабличныйДокумент.Вывести(ОбластьМакетаЗаголовок_1);
		ТабличныйДокумент.Вывести(ОбластьМакетаЗаголовок_2);
		
		СтрокиДокумента = Начисления.НайтиСтроки(Новый Структура("Ссылка", Выборка.Ссылка));
		
