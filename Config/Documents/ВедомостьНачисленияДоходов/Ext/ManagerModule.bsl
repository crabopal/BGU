			ВыводитьСуммуВКруглыхСкобках = УчетДоходовРасходов.ВыводитьСуммуВКруглыхСкобках(СтрокаДок.СтатусОперации);
			
			Если СтрокаДок.СуммаВВалютеЧислом < 0 Тогда
				Если ВыводитьСуммуВКруглыхСкобках Тогда
					СтрокаДок.СуммаВВалюте = Формат(СтрокаДок.СуммаВВалютеЧислом, "ЧДЦ=2; ЧО=0");
				Иначе
					СтрокаДок.СуммаВВалюте = Формат(СтрокаДок.СуммаВВалютеЧислом, "ЧДЦ=2; ЧО=1");
				КонецЕсли;
			Иначе
				СтрокаДок.СуммаВВалюте = Формат(СтрокаДок.СуммаВВалютеЧислом, "ЧДЦ=2; ЧО=1");
			КонецЕсли;
			
			Если СтрокаДок.СуммаЧислом < 0 Тогда
				Если ВыводитьСуммуВКруглыхСкобках Тогда
					СтрокаДок.Сумма = Формат(СтрокаДок.СуммаЧислом, "ЧДЦ=2; ЧО=0");
				Иначе
					СтрокаДок.Сумма = Формат(СтрокаДок.СуммаЧислом, "ЧДЦ=2; ЧО=1");
				КонецЕсли;
			Иначе
				СтрокаДок.Сумма = Формат(СтрокаДок.СуммаЧислом, "ЧДЦ=2; ЧО=1");
			КонецЕсли;
			
			СтрокаДок.КБК = ?(ЗначениеЗаполнено(ОбщиеСведенияОрг.ГлаваБК), ОбщиеСведенияОрг.ГлаваБК, "000") + СтрокаДок.КПС;
			
			Если НЕ ЗначениеЗаполнено(СтрокаДок.КодОКВ) Тогда
				СтрокаДок.КодОКВ = "643";
			КонецЕсли;
			
			ОбластьМакетаСтрока = Макет.ПолучитьОбласть("Строка");
			
			ОбластьМакетаСтрока.Параметры.Заполнить(СтрокаДок);
			
			ТабличныйДокумент.Вывести(ОбластьМакетаСтрока);
			
		КонецЦикла;
		
		ТабличныйДокумент.Вывести(ОбластьМакетаПоКДЗаголовок);
		
		Если ИмяМакета = "ПФ_MXL_Форма0510431" Тогда
			
			ТабКБК = Начисления.Скопировать(СтрокиДокумента);
			ТабКБК.Свернуть("КБК,КодОКВ", "СуммаВВалютеЧислом,СуммаЧислом");
			
			ТабКФО = Начисления.Скопировать(СтрокиДокумента);
			ТабКФО.Свернуть("КБК,КФО,КодОКВ", "СуммаВВалютеЧислом,СуммаЧислом");
			
			ТабКОСГУ = Начисления.Скопировать(СтрокиДокумента);
			ТабКОСГУ.Свернуть("КБК,КФО,КОСГУ,КодОКВ", "СуммаВВалютеЧислом,СуммаЧислом");
			
			ТабОКТМО = Начисления.Скопировать(СтрокиДокумента);
			ТабОКТМО.Свернуть("КБК,КФО,КОСГУ,КодОКТМО,КодОКВ", "СуммаВВалютеЧислом,СуммаЧислом");
			
			ТабСтатус = Начисления.Скопировать(СтрокиДокумента);
			ТабСтатус.Свернуть("КБК,КФО,КОСГУ,КодОКТМО,СтатусОперации,КодОКВ", "СуммаВВалютеЧислом,СуммаЧислом");
			
			Для Каждого СтрКБК Из  ТабКБК Цикл
				ОбластьМакетаПоКД = Макет.ПолучитьОбласть("ПоКД");
				ОбластьМакетаПоКД.Параметры.Заполнить(СтрКБК);
				ТабличныйДокумент.Вывести(ОбластьМакетаПоКД);
				
				ПоКФО = ТабКФО.НайтиСтроки(Новый Структура("КБК, КодОКВ", СтрКБК.КБК, СтрКБК.КодОКВ));
				
				Для Каждого СтрКФО Из ПоКФО Цикл
					ОбластьМакетаПоКФО = Макет.ПолучитьОбласть("ПоКФО");
					ОбластьМакетаПоКФО.Параметры.Заполнить(СтрКФО);
					ТабличныйДокумент.Вывести(ОбластьМакетаПоКФО);
					
					ПоКОСГУ = ТабКОСГУ.НайтиСтроки(Новый Структура("КБК, КодОКВ", СтрКБК.КБК, СтрКБК.КодОКВ));
					
					Для Каждого СтрКОСГУ Из ПоКОСГУ Цикл
						ОбластьМакетаПоКОСГУ = Макет.ПолучитьОбласть("ПоКОСГУ");
						ОбластьМакетаПоКОСГУ.Параметры.Заполнить(СтрКОСГУ);
						ТабличныйДокумент.Вывести(ОбластьМакетаПоКОСГУ);
						
						ПоОКТМО = ТабОКТМО.НайтиСтроки(Новый Структура("КБК, КодОКВ, КОСГУ", СтрКОСГУ.КБК, СтрКОСГУ.КодОКВ, СтрКОСГУ.КОСГУ));
						
						Для Каждого СтрОКТМО Из ПоОКТМО Цикл
							ОбластьМакетаПоОКТМО = Макет.ПолучитьОбласть("ПоОКТМО");
							ОбластьМакетаПоОКТМО.Параметры.Заполнить(СтрОКТМО);
							ТабличныйДокумент.Вывести(ОбластьМакетаПоОКТМО);
							
							ПоСтатусу =  ТабСтатус.НайтиСтроки(Новый Структура("КБК, КодОКВ, КОСГУ, КодОКТМО", СтрОКТМО.КБК, СтрОКТМО.КодОКВ, СтрОКТМО.КОСГУ, СтрОКТМО.КодОКТМО));
							ТабличныйДокумент.Вывести(ОбластьМакетаПоСтатусуЗаголовок);
							
							Для Каждого СтрСтатус Из ПоСтатусу Цикл
								ОбластьМакетаПоСтатусу = Макет.ПолучитьОбласть("ПоСтатусу");
								
								Суммы = Новый Структура("СуммаВВалюте,Сумма");	
								
								ВыводитьСуммуВКруглыхСкобках = УчетДоходовРасходов.ВыводитьСуммуВКруглыхСкобках(СтрСтатус.СтатусОперации);
								
								Если СтрСтатус.СуммаЧислом < 0 Тогда
									Если ВыводитьСуммуВКруглыхСкобках Тогда
										Суммы.Сумма = Формат(СтрСтатус.СуммаЧислом, "ЧДЦ=2; ЧО=0");
									Иначе
										Суммы.Сумма = Формат(СтрСтатус.СуммаЧислом, "ЧДЦ=2; ЧО=1");
									КонецЕсли;
								Иначе
									Суммы.Сумма = Формат(СтрСтатус.СуммаЧислом, "ЧДЦ=2; ЧО=1");
								КонецЕсли;
								
								Если СтрСтатус.СуммаВВалютеЧислом < 0 Тогда
									Если ВыводитьСуммуВКруглыхСкобках Тогда
										Суммы.СуммаВВалюте = Формат(СтрСтатус.СуммаВВалютеЧислом, "ЧДЦ=2; ЧО=0");
									Иначе
										Суммы.СуммаВВалюте = Формат(СтрСтатус.СуммаВВалютеЧислом, "ЧДЦ=2; ЧО=1");
									КонецЕсли;
								Иначе
									Суммы.СуммаВВалюте = Формат(СтрСтатус.СуммаВВалютеЧислом, "ЧДЦ=2; ЧО=1");
								КонецЕсли;
								
								ОбластьМакетаПоСтатусу.Параметры.Заполнить(СтрСтатус);
								ОбластьМакетаПоСтатусу.Параметры.Заполнить(Суммы);
								ТабличныйДокумент.Вывести(ОбластьМакетаПоСтатусу);
							КонецЦикла;	
						КонецЦикла;	
					КонецЦикла;	
				КонецЦикла;	
			КонецЦикла;
		Иначе
			ТабКБК = Начисления.Скопировать(СтрокиДокумента);
			ТабКБК.Свернуть("КБК,КодОКВ", "СуммаВВалютеЧислом,СуммаЧислом");
			
			ТабКОСГУ = Начисления.Скопировать(СтрокиДокумента);
			ТабКОСГУ.Свернуть("КБК,КОСГУ,КодОКВ", "СуммаВВалютеЧислом,СуммаЧислом");
			
			ТабОКТМО = Начисления.Скопировать(СтрокиДокумента);
			ТабОКТМО.Свернуть("КБК,КОСГУ,КодОКТМО,КодОКВ", "СуммаВВалютеЧислом,СуммаЧислом");
			
			ТабСтатус = Начисления.Скопировать(СтрокиДокумента);
			ТабСтатус.Свернуть("КБК,КОСГУ,КодОКТМО,СтатусОперации,КодОКВ", "СуммаВВалютеЧислом,СуммаЧислом");
			
			Для Каждого СтрКБК Из  ТабКБК Цикл
				ОбластьМакетаПоКД = Макет.ПолучитьОбласть("ПоКД");
				ОбластьМакетаПоКД.Параметры.Заполнить(СтрКБК);
				ТабличныйДокумент.Вывести(ОбластьМакетаПоКД);
				
				ПоКОСГУ = ТабКОСГУ.НайтиСтроки(Новый Структура("КБК, КодОКВ", СтрКБК.КБК, СтрКБК.КодОКВ));
				
				Для Каждого СтрКОСГУ Из ПоКОСГУ Цикл
					ОбластьМакетаПоКОСГУ = Макет.ПолучитьОбласть("ПоКОСГУ");
					ОбластьМакетаПоКОСГУ.Параметры.Заполнить(СтрКОСГУ);
					ТабличныйДокумент.Вывести(ОбластьМакетаПоКОСГУ);
					
					ПоОКТМО = ТабОКТМО.НайтиСтроки(Новый Структура("КБК, КодОКВ, КОСГУ", СтрКОСГУ.КБК, СтрКОСГУ.КодОКВ, СтрКОСГУ.КОСГУ));
					
					Для Каждого СтрОКТМО Из ПоОКТМО Цикл
						ОбластьМакетаПоОКТМО = Макет.ПолучитьОбласть("ПоОКТМО");
						ОбластьМакетаПоОКТМО.Параметры.Заполнить(СтрОКТМО);
						ТабличныйДокумент.Вывести(ОбластьМакетаПоОКТМО);
						
						ПоСтатусу =  ТабСтатус.НайтиСтроки(Новый Структура("КБК, КодОКВ, КОСГУ, КодОКТМО", СтрОКТМО.КБК, СтрОКТМО.КодОКВ, СтрОКТМО.КОСГУ, СтрОКТМО.КодОКТМО));
						ТабличныйДокумент.Вывести(ОбластьМакетаПоСтатусуЗаголовок);
						
						Для Каждого СтрСтатус Из ПоСтатусу Цикл
							ОбластьМакетаПоСтатусу = Макет.ПолучитьОбласть("ПоСтатусу");
							ОбластьМакетаПоСтатусу.Параметры.Заполнить(СтрСтатус);
							ТабличныйДокумент.Вывести(ОбластьМакетаПоСтатусу);
						КонецЦикла;	
					КонецЦикла;	
				КонецЦикла;	
			КонецЦикла;	
		КонецЕсли;
		
		ОбластьМакетаВсего = Макет.ПолучитьОбласть("Всего");
		ОбластьМакетаВсего.Параметры.Заполнить(Новый Структура("Сумма", ТабКБК.Итог("СуммаЧислом")));
		ТабличныйДокумент.Вывести(ОбластьМакетаВсего);
		
		ОбластьМакетаПодписи = Макет.ПолучитьОбласть("Подписи");
		ОбластьМакетаПодписи.Параметры.Заполнить(ОбщиеСведенияОрг);
		ТабличныйДокумент.Вывести(ОбластьМакетаПодписи);
		
		// В табличном документе зададим имя области, в которую был выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,ИФО,Дата,Групповая,Начисления");
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ТабДокумента = ЗначенияРеквизитов.Начисления.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("Организация", ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("ИФО", ЗначенияРеквизитов.ИФО);
	Запрос.УстановитьПараметр("Дата", ЗначенияРеквизитов.Дата);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета); 
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Запрос.УстановитьПараметр("ТабДокумента", ТабДокумента);
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("СтатусыОперацийДоходов", НомераТаблиц.Количество());
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВедомостьНачисленияДоходов.Ссылка КАК Регистратор,
	|	ВедомостьНачисленияДоходов.Ссылка.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = &ПустаяДата
	|			ТОГДА ВедомостьНачисленияДоходов.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	ВедомостьНачисленияДоходов.Контрагент КАК Контрагент,
	|	ВедомостьНачисленияДоходов.ДоговорКонтрагента КАК Договор,
	|	ВедомостьНачисленияДоходов.КПС КАК КПС,
	|	ВедомостьНачисленияДоходов.КОСГУ КАК КОСГУ,
	|	ВедомостьНачисленияДоходов.СтатусОперации КАК СтатусОперации
	|ИЗ
	|	Документ.ВедомостьНачисленияДоходов.Начисления КАК ВедомостьНачисленияДоходов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ВедомостьНачисленияДоходов.Ссылка)
	|ГДЕ
	|	ВедомостьНачисленияДоходов.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Договор";
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	Если Не ЗначенияРеквизитов.Групповая Тогда
		
		ЗапросНачисления = Новый Запрос;
		ЗапросНачисления.УстановитьПараметр("Ссылка", ДокументСсылка);
		ЗапросНачисления.УстановитьПараметр("ИспользоватьУчетПоИФО", ИспользоватьУчетПоИФО);
		ЗапросНачисления.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета);
		ЗапросНачисления.Текст =
		"ВЫБРАТЬ
		|	ТаблицаНачисления.Ссылка КАК Ссылка,
		|	ТаблицаНачисления.НомерСтроки КАК НомерСтроки,
		|	ТаблицаНачисления.Ссылка.Организация КАК Организация,
		|	ТаблицаНачисления.Ссылка.Дата КАК Дата,
		|	ТаблицаНачисления.Контрагент КАК Контрагент,
		|	ТаблицаНачисления.ДоговорКонтрагента КАК Договор,
		|	ТаблицаНачисления.ДоговорКонтрагента.ВидДоговора КАК ВидДоговора,
		|	ТаблицаНачисления.ДоговорКонтрагента.ВестиГрафикПлатежей КАК ВестиГрафикПлатежей,
		|	ТаблицаНачисления.ДоговорКонтрагента.ВестиПланГрафикИсполнения КАК ВестиПланГрафикИсполнения,
		|	ВЫБОР
		|		КОГДА &ИспользоватьУчетПоИФО
		|			ТОГДА ТаблицаНачисления.Ссылка.ИФО
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
		|	КОНЕЦ КАК ИФО,
		|	ТаблицаНачисления.КФО КАК КФО,
