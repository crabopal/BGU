Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
Процедура СформироватьОписаниеДокументовСТабличнымиЧастями(Форма, Описание) Экспорт
	
	ПроверкаКонтрагентов.ДополнитьОписаниеТабличныхЧастей(
	Форма, Описание, "Начисления", "НачисленияКонтрагент", "");
	
КонецПроцедуры 
// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

Функция ПроверитьНаличиеУточняемыхДоходов(СтатусОперации, Контрагент, ДоговорКонтрагента, КОСГУ, КПС, КФО, Дата, Организация) Экспорт
	
	Результат = "";
	Шаблон = "";
	СтрокаСообщения = "";
	
	ПризнакиСтатусаОперации = УчетДоходовРасходов.КлассифицироватьСтатусОперацииНачисленияДоходов(СтатусОперации);
	Если ПризнакиСтатусаОперации.ЭтоСтарыйФорматКода Тогда
		
		Если СтрНайти("02.1=02.2=02.6=03.1=03.2=03.3", Лев(ПризнакиСтатусаОперации.СтатусОперацииКод, 4)) > 0 Тогда
			Шаблон = "01";
			СтрокаСообщения = НСтр("ru='Не найдено первичное начисление (01) для корректировки.'");
		ИначеЕсли Лев(ПризнакиСтатусаОперации.СтатусОперацииКод, 2) = "04" Тогда
			Шаблон = "03";
			СтрокаСообщения = НСтр("ru='Не найдено аннулированное начисление (03) для корректировки.'");
		Иначе
			Возврат "";
		КонецЕсли;
		
	Иначе // Код статуса операции в формате ZY.XX.
		
		Если СтрНайти("12.1=12.2=22.1=22.2=32.1=13.1=13.2=23.1=23.2=33.1", Лев(ПризнакиСтатусаОперации.СтатусОперацииКод, 4)) > 0
			И Не ПризнакиСтатусаОперации.ЭтоИсправлениеОшибокПрошлыхЛет Тогда
			Шаблон = "1";
			СтрокаСообщения = НСтр("ru='Не найдено первичное начисление (01) для корректировки.'");
		Иначе
			Возврат "";
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	СтатусыОперацийДоходов.Период КАК Период
	|ИЗ
	|	РегистрСведений.СтатусыОперацийДоходов КАК СтатусыОперацийДоходов
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Период < Дата Тогда
		// проверяем наличие статуса
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	СтатусыОперацийДоходовСрезПоследних.СтатусОперации КАК СтатусОперации
		|ИЗ
		|	РегистрСведений.СтатусыОперацийДоходов.СрезПоследних(
		|			&Дата,
		|			Договор = &Договор
		|				И Контрагент = &Контрагент
		|				И КПС = &КПС
		|				И КОСГУ = &КОСГУ
		|				И &УсловиеКодСтатусаОперации) КАК СтатусыОперацийДоходовСрезПоследних");
		Запрос.УстановитьПараметр("Договор", ДоговорКонтрагента);
		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.УстановитьПараметр("Контрагент", Контрагент);   
		Запрос.УстановитьПараметр("КПС", КПС); 
		Запрос.УстановитьПараметр("КОСГУ", КОСГУ); 
		Запрос.УстановитьПараметр("Шаблон", Шаблон);
		Если ПризнакиСтатусаОперации.ЭтоСтарыйФорматКода Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКодСтатусаОперации", "ПОДСТРОКА(СтатусОперации.Код, 1, 2) = &Шаблон");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКодСтатусаОперации", "ПОДСТРОКА(СтатусОперации.Код, 2, 1) = &Шаблон");
		КонецЕсли;
		
		Если Запрос.Выполнить().Пустой() Тогда
			Результат = СтрокаСообщения;
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ Лев(ПризнакиСтатусаОперации.СтатусОперацииКод, 2) = "04" Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОборотыДтКт.СуммаОборот КАК СуммаОборот,
		|	ЖурналПроводокЕПСБУОборотыДтКт.СчетДт,
		|	ЖурналПроводокЕПСБУОборотыДтКт.СчетКт
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Период,
		|			СчетДт В (&СчетДт),
		|			,
		|			СчетКт В (&СчетКт),
		|			,
		|			Организация = &Организация
		|				И КФО = &КФО
		|				И КПСКт = &КПСКт
		|				И КЭККт = &КЭККт
		|				И СубконтоДт1 = &СубконтоДт1
		|				И СубконтоДт2 = &СубконтоДт2) КАК ЖурналПроводокЕПСБУОборотыДтКт");
		
		Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(Дата));
		Запрос.УстановитьПараметр("КонецПериода", Новый Граница(Дата, ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("СчетДт", БухгалтерскийУчет.СписокСчетов(ПризнакиСтатусаОперации.СтатусОперацииСчетДт, Дата,, Организация));
		Запрос.УстановитьПараметр("СчетКт", БухгалтерскийУчет.СписокСчетов(ПризнакиСтатусаОперации.СтатусОперацииСчетКт, Дата,, Организация));
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("КФО", КФО);
		Запрос.УстановитьПараметр("КПСКт", КПС);
		Запрос.УстановитьПараметр("КЭККт", КОСГУ);
		Запрос.УстановитьПараметр("СубконтоДт1", Контрагент);
		Запрос.УстановитьПараметр("СубконтоДт2", ДоговорКонтрагента);
		
		Если Запрос.Выполнить().Пустой() Тогда
			Результат = Результат + ?(ЗначениеЗаполнено(Результат), Символы.ПС, "") 
			+ НСтр("ru='Не найдены бухгалтерские записи для корректировки.'");
		КонецЕсли;	
	КонецЕсли;		
	
	Возврат Результат;
	
КонецФункции	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВедомостьНачисленияДоходов";
	КомандаПечати.Идентификатор		= "Форма0510837";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость начисления доходов бюджета (ф. 0510837)'");
	КомандаПечати.Порядок			= 1;
	ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, "Групповая", ЛОЖЬ);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВедомостьНачисленияДоходов";
	КомандаПечати.Идентификатор		= "Форма0510431";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость группового начисления доходов (ф. 0510431)'");
	КомандаПечати.Порядок			= 1;
	ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, "Групповая", ИСТИНА);
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0510837") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
		"Форма0510837",
		НСтр("ru = 'Ведомость начисления доходов бюджета (ф. 0510837)'"),
		ПечатьВедомостьНачислений(МассивОбъектов, ОбъектыПечати, ПараметрыПечати, "ПФ_MXL_Форма0510837"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0510431") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
		"Форма0510431",
		НСтр("ru = 'Ведомость группового начисления доходов (ф. 0510431)'"),
		ПечатьВедомостьНачислений(МассивОбъектов, ОбъектыПечати, ПараметрыПечати, "ПФ_MXL_Форма0510431"));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьВедомостьНачислений(МассивОбъектов, ОбъектыПечати, ПараметрыПечати, ИмяМакета)
	
	ОбщиеСведения = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);

	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ВедомостьНачисленияДоходов.Ссылка КАК Ссылка,
	|	ВедомостьНачисленияДоходов.Номер КАК Номер,
	|	ВедомостьНачисленияДоходов.Дата КАК ДатаДок
	|ИЗ
	|	Документ.ВедомостьНачисленияДоходов КАК ВедомостьНачисленияДоходов
	|ГДЕ
	|	ВедомостьНачисленияДоходов.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВедомостьНачисленияДоходовНачисления.Ссылка КАК Ссылка,
	|	ВедомостьНачисленияДоходовНачисления.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА ВедомостьНачисленияДоходовНачисления.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА ВедомостьНачисленияДоходовНачисления.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|		КОГДА ВедомостьНачисленияДоходовНачисления.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|				И ВедомостьНачисленияДоходовНачисления.Контрагент.ЮридическоеФизическоеЛицо.ОГРНИП = """"
	|			ТОГДА ВедомостьНачисленияДоходовНачисления.Контрагент.ЮридическоеФизическоеЛицо.Наименование
	|		КОГДА ВедомостьНачисленияДоходовНачисления.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|				И НЕ ВедомостьНачисленияДоходовНачисления.Контрагент.ЮридическоеФизическоеЛицо.ОГРНИП = """"
	|			ТОГДА ВедомостьНачисленияДоходовНачисления.Контрагент.НаименованиеСокращенное
	|		ИНАЧЕ ВедомостьНачисленияДоходовНачисления.Контрагент.Наименование
	|	КОНЕЦ КАК Контрагент,
	|	ВедомостьНачисленияДоходовНачисления.ИдентификаторПлательщика КАК ИдентификаторПлательщика,
	|	ВедомостьНачисленияДоходовНачисления.ДоговорКонтрагента.УИН КАК УникальныйИдентификаторНачисления,
	|	ВедомостьНачисленияДоходовНачисления.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	ВедомостьНачисленияДоходовНачисления.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	ВедомостьНачисленияДоходовНачисления.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	|	ВедомостьНачисленияДоходовНачисления.НомерРеестровойЗаписи КАК НомерРеестровойЗаписи,
	|	ВедомостьНачисленияДоходовНачисления.КПС.Код КАК КПС,
	|	ВедомостьНачисленияДоходовНачисления.КФО КАК КФО,
	|	ВедомостьНачисленияДоходовНачисления.КОСГУ.Код КАК КОСГУ,
	|	ВедомостьНачисленияДоходовНачисления.КодОКТМО КАК КодОКТМО,
	|	ВедомостьНачисленияДоходовНачисления.СтатусОперации.Код КАК СтатусОперации,
	|	ВедомостьНачисленияДоходовНачисления.ДатаПризнанияДоходов КАК ДатаПризнанияДоходов,
	|	ВедомостьНачисленияДоходовНачисления.ПредельнаяДатаИсполнения КАК ПредельнаяДатаИсполнения,
	|	ВедомостьНачисленияДоходовНачисления.Валюта.Код КАК КодОКВ,
	|	ВедомостьНачисленияДоходовНачисления.СуммаВВалюте КАК СуммаВВалютеЧислом,
	|	ВедомостьНачисленияДоходовНачисления.Сумма КАК СуммаЧислом,
	|	ВедомостьНачисленияДоходовНачисления.ОсобыеОтметки КАК ОсобыеОтметки
	|ИЗ
	|	Документ.ВедомостьНачисленияДоходов.Начисления КАК ВедомостьНачисленияДоходовНачисления
	|ГДЕ
	|	ВедомостьНачисленияДоходовНачисления.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.ВыполнитьПакет();
	Выборка 	= Результат[0].Выбрать();	
	Начисления 	= Результат[1].Выгрузить();
	
	Начисления.Колонки.Добавить("КБК", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(20)));
	Начисления.Колонки.Добавить("СуммаВВалюте", Новый ОписаниеТипов("Строка"));
	Начисления.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Строка"));
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ВедомостьНачисленияДоходов_" + ИмяМакета;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ВедомостьНачисленияДоходов." + ИмяМакета);
	
	ОбластьМакетаШапка         		= Макет.ПолучитьОбласть("Шапка");
	ОбластьМакетаЗаголовок_1   		= Макет.ПолучитьОбласть("Заголовок_1");
	ОбластьМакетаЗаголовок_2   		= Макет.ПолучитьОбласть("Заголовок_2");
	ОбластьМакетаПоКДЗаголовок      = Макет.ПолучитьОбласть("ПоКДЗаголовок");
	ОбластьМакетаПоСтатусуЗаголовок	= Макет.ПолучитьОбласть("ПоСтатусуЗаголовок");
	
	ПервыйДокумент = Истина;
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;  
		
		ОбщиеСведенияОрг =  ОбщиеСведения.Получить(Выборка.Ссылка);  
		Если ОбщиеСведенияОрг = Неопределено Тогда
			ОбщиеСведенияОрг = Новый Структура; 
		КонецЕсли;	
		
		СтруктураДанных = Новый Структура;
		
		// для печати даты в виде "__" ________ 20__ г.
		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(Выборка.ДатаДок);
		СтруктураДанных.Вставить("ЧислоДаты", СтруктураДаты.Число);	
		СтруктураДанных.Вставить("МесяцДаты", СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДаты", СтруктураДаты.Год); 
		
		СтруктураДанных.Вставить("ДатаДок", Выборка.ДатаДок);  
		
		// реквизиты, требующие преобразования
		СтруктураДанных.Вставить("НомерДок", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Выборка.Ссылка, Выборка.Номер));
		
