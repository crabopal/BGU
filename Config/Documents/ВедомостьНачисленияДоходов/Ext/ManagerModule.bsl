	Если СтрНайти(НоваяСтрока.СтатусОперацииСчетРасчетов, "207.00") > 0 Тогда
		НоваяСтрока.СчетРасчетов = УчетРасчетов.СчетРасчетовПредоставленногоЗайма(НоваяСтрока.Договор, ЗначенияРеквизитов.Дата);
	Иначе
		НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(НоваяСтрока.КОСГУ, 
			НоваяСтрока.СтатусОперацииСчетРасчетов,, ЗначенияРеквизитов.Дата, ЗначенияРеквизитов.Организация, ЗначенияРеквизитов.ИФО, НоваяСтрока.КПС);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НоваяСтрока.КФО) Тогда
		НоваяСтрока.КФО = ПредопределенноеЗначение("Перечисление.КВД.Бюджет");
	КонецЕсли;
	
	НоваяСтрока.ИсправлениеОшибокПрошлыхЛет = ЭтоИсправлениеОшибокПрошлыхЛет;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Заполнение реквизита АвтоматическиОтразитьВГрафикахИсполненияДоговоров табличной части Начисления
	// при наличии движений по регистрам ОплатаОтПокупателейДебиторов, ИсполнениеДоговоровСПокупателями.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ОплатаОтПокупателейДебиторов.Регистратор КАК Документ.ВедомостьНачисленияДоходов) КАК Регистратор
	|ПОМЕСТИТЬ РегистраторыВедомостьНачисленияДоходов
	|ИЗ
	|	РегистрНакопления.ОплатаОтПокупателейДебиторов КАК ОплатаОтПокупателейДебиторов
	|ГДЕ
	|	ОплатаОтПокупателейДебиторов.Регистратор ССЫЛКА Документ.ВедомостьНачисленияДоходов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ИсполнениеДоговоровСПокупателями.Регистратор КАК Документ.ВедомостьНачисленияДоходов)
	|ИЗ
	|	РегистрНакопления.ИсполнениеДоговоровСПокупателями КАК ИсполнениеДоговоровСПокупателями
	|ГДЕ
	|	ИсполнениеДоговоровСПокупателями.Регистратор ССЫЛКА Документ.ВедомостьНачисленияДоходов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВедомостьНачисленияДоходовНачисления.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ВедомостьНачисленияДоходовНачисления.АвтоматическиОтразитьВГрафикахИсполненияДоговоров) КАК АвтоматическиОтразитьВГрафикахИсполненияДоговоров
	|ПОМЕСТИТЬ ДокументыСДвижениямиПоРегистрамГрафиковИсполнения
	|ИЗ
	|	Документ.ВедомостьНачисленияДоходов.Начисления КАК ВедомостьНачисленияДоходовНачисления
	|ГДЕ
	|	ВедомостьНачисленияДоходовНачисления.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				РегистраторыВедомостьНачисленияДоходов.Регистратор
	|			ИЗ
	|				РегистраторыВедомостьНачисленияДоходов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВедомостьНачисленияДоходовНачисления.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыСДвижениямиПоРегистрамГрафиковИсполнения.Ссылка КАК Ссылка
	|ИЗ
	|	ДокументыСДвижениямиПоРегистрамГрафиковИсполнения КАК ДокументыСДвижениямиПоРегистрамГрафиковИсполнения
	|ГДЕ
	|	ДокументыСДвижениямиПоРегистрамГрафиковИсполнения.АвтоматическиОтразитьВГрафикахИсполненияДоговоров = ЛОЖЬ";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.ВедомостьНачисленияДоходов";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл     
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Выборка.Ссылка) Тогда
			// Вероятно был удален раньше, чем обработчик дошел до него
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			// Объект не удается заблокировать - попробуем обработать его на следующей итерации.
			// Отдельно обрабатывать ошибку не требуется, т.к. в худшем случае обработчик зациклится
			// и прервется автоматически.
			ЗафиксироватьТранзакцию();
			Продолжить;
		КонецПопытки;
		
		Попытка
			
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			
			Для Каждого Начисление Из Объект.Начисления Цикл
				
				Если НЕ Начисление.АвтоматическиОтразитьВГрафикахИсполненияДоговоров
					И ЗначениеЗаполнено(Начисление.Контрагент)
					И ЗначениеЗаполнено(Начисление.ДоговорКонтрагента)
					И ЗначениеЗаполнено(Начисление.СчетДоходов) Тогда
					Начисление.АвтоматическиОтразитьВГрафикахИсполненияДоговоров = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не Объект.Модифицированность() Тогда
				
				ЗафиксироватьТранзакцию();
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
				Продолжить;
				
			КонецЕсли;
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Документы.НакладнаяНаОтпускИК,
			Выборка.Ссылка,
			ТекстСообщения);
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
	
#КонецЕсли
