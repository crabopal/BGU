&НаКлиенте
Процедура ПриИзмененииРеквизитаНаКлиенте(ИмяРеквизита, ЗначениеРеквизита)
	
	ЗаполнитьЗначенияСвойств(Объект, БухгалтерскийУчетКлиентСервер.НалоговыеРеквизитыПлатежногоДокумента(Новый Структура(ИмяРеквизита, ЗначениеРеквизита)));
    СписокРеквизитов = "ПоказательОснования,ПоказательПериода,ПоказательТипа,ПоказательНомера,ПоказательДаты,СтатусСоставителя";	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьНезаполненныеНалоговыеРеквизиты(Объект,СписокРеквизитов, ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем, Объект.Дата);

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитовПериодаНаКлиенте()
	
	ЗначенияРеквизитов = Новый Структура("ПоказательПериода, ПолеВводаГодПериода, ПолеВводаНомерПериода, ПолеВводаДатаПериода, ПолеВводаКодТаможенногоОргана");
    ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Объект);
	ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, ЭтаФорма);
	БухгалтерскийУчетКлиентСервер.ОпределитьРеквизитыНалоговогоПериода(ПолеВводаПоказательПериода, ТаможенныйПлатеж, Объект.Дата, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитов);
	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтаФорма);
    СписокРеквизитов = "ПоказательОснования,ПоказательПериода,ПоказательТипа,ПоказательНомера,ПоказательДаты,СтатусСоставителя";	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьНезаполненныеНалоговыеРеквизиты(Объект,СписокРеквизитов, ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем, Объект.Дата);

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПоказателяНаклиенте(ИмяПоказателя) 
	
	РеквизитыПлатежа = Новый Структура(ИмяПоказателя, Объект[ИмяПоказателя]);
		
	ЗаполнитьЗначенияСвойств(ЭтаФорма, БухгалтерскийУчетКлиентСервер.ПолучитьЗначенияНалоговыхРеквизитов(РеквизитыПлатежа));

	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ТекстФайла(Команда)
	ПараметрыФормы = Новый Структура("ТекстФайла",Объект.СодержимоеФайла);
	ПараметрыФормы.Вставить("Заголовок","Содержимое полученного файла, по которому сформирован данный документ");
	ОткрытьФорму("ОбщаяФорма.ФормаПросмотраXML",ПараметрыФормы,ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗаполнитьПоШаблону(Команда)
	
	Если ЗначениеЗаполнено(Объект.УникальныйИдентификаторНачисления)
		И ЗначениеЗаполнено(Объект.СуммаДокумента) Тогда
		ТекстСообщения = НСтр("ru='В документе уже заполнена сумма участником - АДБ, изменение документа посредником запрещено.'"); 
		Возврат;
	КонецЕсли;
	
	Ответ = Ждать ВопросАсинх(НСтр("ru='Заполнить документ по выбранному шаблону?'"),РежимДиалогаВопрос.ДаНет);
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоШаблонуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИдентификаторы(Команда)
	
	ЗаполнитьИдентификаторыПлательщика();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура КонтрагентПлательщикПриИзмененииНаСервере()
	
	Объект.ОсновнойИдентификаторПлательщика = "";
	Объект.ДополнительныйИдентификаторПлательщика = "";
	Объект.ПлательщикНаименование = "";
	
	Если НЕ ЗначениеЗаполнено(Объект.КонтрагентПлательщик) Тогда
		Возврат;	
	КонецЕсли;
	
	Объект.ПлательщикНаименование = БюджетнаяОтчетностьПолучениеНСИ.ОфициальноеНаименование(Объект.КонтрагентПлательщик,Истина);
	
	ЗаполнитьИдентификаторыПлательщика();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИдентификаторыПлательщика()
	
	Если НЕ ЗначениеЗаполнено(Объект.КонтрагентПлательщик) Тогда
		Возврат;
	КонецЕсли;
	
	МассивФК = Неопределено;
	Если ЗначениеЗаполнено(Объект.ШаблонНачисления) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШаблоныРеквизитовДляНачисленияПосредника.НастройкаФормированияИдентификатораКонтрагента КАК НастройкаФормированияИдентификатораКонтрагента,
		|	НастройкиФормированияИдентификаторовКонтрагентовТаблицаНастроек.НомерСтроки КАК НомерСтроки,
		|	НастройкиФормированияИдентификаторовКонтрагентовТаблицаНастроек.КодФК КАК КодФК
		|ИЗ
		|	Справочник.ШаблоныРеквизитовДляНачисленияПосредника КАК ШаблоныРеквизитовДляНачисленияПосредника
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НастройкиФормированияИдентификаторовКонтрагентов.ТаблицаНастроек КАК НастройкиФормированияИдентификаторовКонтрагентовТаблицаНастроек
		|		ПО ШаблоныРеквизитовДляНачисленияПосредника.НастройкаФормированияИдентификатораКонтрагента = НастройкиФормированияИдентификаторовКонтрагентовТаблицаНастроек.Ссылка
		|ГДЕ
		|	ШаблоныРеквизитовДляНачисленияПосредника.Ссылка = &ШаблонНачисления
		|	И НастройкиФормированияИдентификаторовКонтрагентовТаблицаНастроек.Использовать
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
		Запрос.УстановитьПараметр("ШаблонНачисления", Объект.ШаблонНачисления);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		МассивФК = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("КодФК");
		Если МассивФК.Количество() = 0 Тогда
			МассивФК = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	МассивИдентификаторов = БухгалтерскийУчет.НесколькоИдентификаторовКонтрагента(Объект.КонтрагентПлательщик,Истина,2,Неопределено,МассивФК);
	
	КоличествоИдентификаторов = МассивИдентификаторов.Количество();
	
	Если КоличествоИдентификаторов >= 1 Тогда
		Объект.ОсновнойИдентификаторПлательщика = МассивИдентификаторов[0];
	КонецЕсли;
	
	Если КоличествоИдентификаторов >= 2 Тогда
		Объект.ДополнительныйИдентификаторПлательщика = МассивИдентификаторов[1];
	КонецЕсли;

КонецПроцедуры

