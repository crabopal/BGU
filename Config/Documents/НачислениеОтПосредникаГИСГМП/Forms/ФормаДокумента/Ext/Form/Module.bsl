&НаСервере
Процедура ЗаполнитьПоШаблонуНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШаблоныРеквизитовДляНачисленияПосредника.Контрагент КАК Контрагент,
		|	ШаблоныРеквизитовДляНачисленияПосредника.ПолучательНаименование КАК ПолучательНаименование,
		|	ШаблоныРеквизитовДляНачисленияПосредника.ИННПолучателя КАК ИННПолучателя,
		|	ШаблоныРеквизитовДляНачисленияПосредника.КПППолучателя КАК КПППолучателя,
		|	ШаблоныРеквизитовДляНачисленияПосредника.УРНУчастника КАК УРНУчастника,
		|	ШаблоныРеквизитовДляНачисленияПосредника.НомерКазначейскогоСчета КАК ПолучательБанковскийСчет,
		|	ШаблоныРеквизитовДляНачисленияПосредника.БИКБанка КАК ПолучательБИКБанка,
		|	ШаблоныРеквизитовДляНачисленияПосредника.КорСчетБанка КАК ПолучательКорСчетБанка,
		|	ШаблоныРеквизитовДляНачисленияПосредника.УРНПосредника КАК УРНПосредника,
		|	ШаблоныРеквизитовДляНачисленияПосредника.КБК КАК КодБКПлатежа,
		|	ШаблоныРеквизитовДляНачисленияПосредника.ОКТМО КАК КодОКТМО,
		|	ШаблоныРеквизитовДляНачисленияПосредника.НазначениеПлатежа КАК НазначениеПлатежа,
		|	ШаблоныРеквизитовДляНачисленияПосредника.ПоказательОснования КАК ПоказательОснования,
		|	ШаблоныРеквизитовДляНачисленияПосредника.ПоказательПериода КАК ПоказательПериода,
		|	ШаблоныРеквизитовДляНачисленияПосредника.ТаможенныйПлатеж КАК ТаможенныйПлатеж,
		|	ШаблоныРеквизитовДляНачисленияПосредника.ПоказательНомера КАК ПоказательНомера,
		|	ШаблоныРеквизитовДляНачисленияПосредника.ПоказательДаты КАК ПоказательДаты
		|ИЗ
		|	Справочник.ШаблоныРеквизитовДляНачисленияПосредника КАК ШаблоныРеквизитовДляНачисленияПосредника
		|ГДЕ
		|	ШаблоныРеквизитовДляНачисленияПосредника.Ссылка = &ШаблонНачисления";
	
	Запрос.УстановитьПараметр("ШаблонНачисления", Объект.ШаблонНачисления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Объект,ВыборкаДетальныеЗаписи);
	КонецЕсли;	
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, БухгалтерскийУчетКлиентСервер.ПолучитьЗначенияНалоговыхРеквизитов(Объект));
	ТаможенныйПлатеж = Объект.ТаможенныйПлатеж;	
	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтаФорма);
	
	ЗаполнитьИдентификаторыПлательщика();
	
КонецПроцедуры

