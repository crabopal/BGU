		ЛицевойСчет = СправочникЛицевойСчет;
		
		РеквизитыЛицевогоСчета = ВыборкаЛС.Ссылка;
		РеквизитыПлательщика = Новый Структура;
		РеквизитыПлательщика.Вставить("ИННПлательщика", "ИНН");
		РеквизитыПлательщика.Вставить("КПППлательщика", "КПП");
		РеквизитыПлательщика.Вставить("ПлательщикНаименование", "Корреспондент");
		РеквизитыПлательщика.Вставить("ПлательщикБанковскийСчет", "СчетНомер");
		РеквизитыПлательщика.Вставить("ПлательщикНаименованиеБанка", "Банк");
		РеквизитыПлательщика.Вставить("ПлательщикБИКБанка", "БИК");
		РеквизитыПлательщика.Вставить("ПлательщикКорСчетБанка", "КоррСчет"); 
		
		ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыЛицевогоСчета, РеквизитыПлательщика);
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыПлательщика);
		
	Иначе
		ТекстСообщения = НСтр("ru='Не удалось автоматически определить реквизиты лицевого счета.
		|Будет выбрано значение лицевого счета по-умолчанию.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, "ЛицевойСчет");
	КонецЕсли;
	
	РасшифровкаПлатежа.Очистить();
	
	ВыборкаРасшифровка = Выборка.Выбрать();
	Пока ВыборкаРасшифровка.Следующий() Цикл
		
