		СтрРасшифровка.КФО = ВыборкаРасшифровка.КФО;
		СтрРасшифровка.КБКНазначениеПлатежа = ВыборкаРасшифровка.КПС;
		СтрРасшифровка.КОСГУНазначениеПлатежа = ВыборкаРасшифровка.КЭК;
		СтрРасшифровка.Сумма = ВыборкаРасшифровка.Сумма;
		СтрРасшифровка.ВидРасчетов = ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг");
		
