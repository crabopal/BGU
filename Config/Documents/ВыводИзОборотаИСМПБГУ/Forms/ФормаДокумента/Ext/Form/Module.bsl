#Область СлужебныеПроцедурыИФункции  

&НаКлиенте
Процедура НачатьВыполнениеДлительнойОперацииВыводИзОборота(ТипОперацииСервиса, ПараметрыВыводаИзОборота)
	
	Элементы.СтраницыДлительнаяОперация.ТекущаяСтраница = Элементы.СтраницаДлительнаяОперацияВыполняется;
	
	РезультатНачалаВыполнения = РезультатНачалаВыполненияДлительнойОперацииВыводИзОборота(ПараметрыВыводаИзОборота);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТипОперацииСервиса", ТипОперацииСервиса);
	ДополнительныеПараметры.Вставить("ПараметрыВыводаИзОборота", ПараметрыВыводаИзОборота);
	ДополнительныеПараметры.Вставить("ОперацияВыполнялась", Ложь);
	ДополнительныеПараметры.Вставить("ОперацияВыполненаСВременнойОшибкой", Ложь);
	ДополнительныеПараметры.Вставить("ДанныеНаПодпись", "");
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения(
	"ДлительнаяОперацияВыводИзОборотаЗавершение",
	ЭтотОбъект,
	ДополнительныеПараметры);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатНачалаВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры 

&НаСервере
Функция РезультатНачалаВыполненияДлительнойОперацииВыводИзОборота(ПараметрыВыводаИзОборота)
	
	Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Обмен с ИСМП'");
	
	РезультатНачалаВыполнения = ДлительныеОперации.ВыполнитьВФоне(
	"ОбменИСМПБГУВызовСервера.ВыводИзОборотаКодовМаркировкиВСервисе",
	ПараметрыВыводаИзОборота,
	ПараметрыВыполнения);
	
	Если РезультатНачалаВыполнения.Статус = "Ошибка" Тогда   
		Элементы.СтраницыДлительнаяОперация.ТекущаяСтраница = Элементы.СтраницаДлительнаяОперацияНеВыполняется;
		ВызватьИсключение РезультатНачалаВыполнения.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	ИдентификаторЗадания = РезультатНачалаВыполнения.ИдентификаторЗадания;
	
	Возврат РезультатНачалаВыполнения;
	
КонецФункции

&НаКлиенте
Процедура ДлительнаяОперацияВыводИзОборотаЗавершение(РезультатОперации, ДополнительныеПараметры) Экспорт
	
	Если РезультатОперации <> Неопределено Тогда 
		Элементы.СтраницыДлительнаяОперация.ТекущаяСтраница = Элементы.СтраницаДлительнаяОперацияНеВыполняется;
		Если РезультатОперации.Статус = "Ошибка" Тогда
			ВызватьИсключение РезультатОперации.КраткоеПредставлениеОшибки;
		ИначеЕсли РезультатОперации.Статус = "Выполнено" Тогда
			ТипОперацииСервиса = Неопределено;
			Если ДополнительныеПараметры <> Неопределено И ДополнительныеПараметры.Свойство("ТипОперацииСервиса", ТипОперацииСервиса) Тогда
				Если ТипОперацииСервиса = ТипОперацииСервисаПервичная() Тогда
					ОбработатьРезультатПервичнойОперацииВыводИзОборотаСервиса(РезультатОперации.АдресРезультата, ДополнительныеПараметры);
				ИначеЕсли ТипОперацииСервиса = ТипОперацииСервисаПовторная() Тогда
					ОбработатьРезультатПовторнойОперацииВыводИзОборотаСервиса(РезультатОперации.АдресРезультата);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыВыводаИзОборота()
	
	ПараметрыВыводаИзОборота = ОбменИСМПБГУКлиентСервер.НовыеПараметрыВыводаИзОборотаКодовМаркировки();
	
	ЗаполнитьСведенияОбОрганизации();
	
	ПараметрыВыводаИзОборота.Организация 			= Объект.Организация;
	ПараметрыВыводаИзОборота.АдресОрганизации 		= АдресОрганизации;
	ПараметрыВыводаИзОборота.ИННОрганизации 		= ИННОрганизации;
	ПараметрыВыводаИзОборота.ИННПокупателя 			= Объект.ИННПокупателя;
	ПараметрыВыводаИзОборота.КППТорговойТочки 		= Объект.КППТорговойТочки;
	ПараметрыВыводаИзОборота.ИдентификаторФИАС 		= Объект.ИдентификаторФИАС;
	ПараметрыВыводаИзОборота.ЭтоТабачнаяПродукция 	= Ложь;
	ПараметрыВыводаИзОборота.ЭтоОСУ 				= Объект.ОбъемноСортовойУчет;
	ПараметрыВыводаИзОборота.ЭтоФасовка 			= Ложь;
	ПараметрыВыводаИзОборота.ТоварнаяГруппа 		= Объект.ТипМаркировкиККТ;
	ПараметрыВыводаИзОборота.Причина 				= Объект.ПричинаВыводаИзОборота;
	ПараметрыВыводаИзОборота.ДатаДокумента 			= Объект.Дата;
	ПараметрыВыводаИзОборота.НомерДокумента 		= Объект.Номер;
	
	Для Каждого СтрокаТаблицы Из Объект.Товары Цикл
		
		Если ПараметрыВыводаИзОборота.ЭтоОСУ Тогда
			
			ДанныеТовара = ОбменИСМПБГУКлиентСервер.НовыеПараметрыТовара();
			
			ДанныеТовара.Штрихкод 		= СтрокаТаблицы.КодGTIN;
			ДанныеТовара.Количество 	= СтрокаТаблицы.Количество;  
			ДанныеТовара.Вес 			= СтрокаТаблицы.ВесИтого;
			
			ПараметрыВыводаИзОборота.Товары.Добавить(ДанныеТовара);
			
		Иначе
			
			ДанныеМарки = ОбменИСМПБГУКлиентСервер.НовыеПараметрыКодаМаркировки();
			ДанныеМарки.Штрихкод = СтрокаТаблицы.КодМаркировки;
			ПараметрыВыводаИзОборота.КодыМаркировки.Добавить(ДанныеМарки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПараметрыВыводаИзОборота;
	
КонецФункции

&НаКлиенте
Функция ТипОперацииСервисаПервичная()
	
	Возврат "Первичная";
	
КонецФункции 

&НаКлиенте
Функция ТипОперацииСервисаПовторная()
	
	Возврат "Повторная";
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьКолонокТовары()
	
	ЭтоОсу = Объект.ОбъемноСортовойУчет;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
	"ТоварыКодМаркировки", "Видимость", Не ЭтоОсу);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
	"ТоварыКодGTIN", "Видимость", ЭтоОсу);  
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
	"ТоварыКоличество", "Видимость", ЭтоОсу);  
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
	"ТоварыВес", "Видимость", ЭтоОсу); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
	"ТоварыВесИтого", "Видимость", ЭтоОсу);
	
КонецПроцедуры	

&НаКлиенте
Процедура ПоискПоШтрихкодуЗавершение(ДанныеШтрихкода) Экспорт
	
	ПараметрыОбработки = ШтрихкодированиеБГУКлиентСервер.ПараметрыОбработкиШтрихкодов();
	ПараметрыОбработки.Штрихкоды						= ДанныеШтрихкода;
	
	РезультатПоиска = ШтрихкодированиеБГУКлиент.НачатьПоискНоменклатурыПоШтрихкоду(ПараметрыОбработки);
	ОбработатьРезультатПоиска(РезультатПоиска);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатПоиска(РезультатПоиска)
	
	Если РезультатПоиска.НоменклатураПоШтрихкоду.Количество() > 0 Тогда 
		ТипМаркируемойПродукции = ПолучитьТипМаркировкиНоменклатуры(РезультатПоиска.НоменклатураПоШтрихкоду[0]);
		Если ТипМаркируемойПродукции <> СопоставитьТипыМаркировки(Объект.ТипМаркировкиККТ) Тогда 
			ТекстСообщения = НСтр("ru = 'Тип маркировки товара не совпадает с типом маркировки документа!'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, Объект.Ссылка);	  
			Возврат;
		КонецЕсли;	
	КонецЕсли;	
	
	Если Объект.ОбъемноСортовойУчет Тогда 
		ПараметрыОтбора = Новый Структура("КодGTIN", РезультатПоиска.ДанныеМаркировки.GTIN);
		НайденныеСтроки = Объект.Товары.НайтиСтроки(ПараметрыОтбора); 
		Если НайденныеСтроки.Количество() > 0 Тогда 
			ТекущиеДанные = НайденныеСтроки[0];
			ТекущиеДанные.Количество = ТекущиеДанные.Количество + 1;
		Иначе 
			ТекущиеДанные = Объект.Товары.Добавить();
			ТекущиеДанные.Количество 	= 1;  
			ТекущиеДанные.КодGTIN 		= РезультатПоиска.ДанныеМаркировки.GTIN; 
			Если РезультатПоиска.НоменклатураПоШтрихкоду.Количество() > 0 Тогда 
				ТекущиеДанные.Номенклатура = РезультатПоиска.НоменклатураПоШтрихкоду[0];
			КонецЕсли;	
		КонецЕсли;
	Иначе
		ПараметрыОтбора = Новый Структура("КодМаркировки", РезультатПоиска.КодМарки);
		НайденныеСтроки = Объект.Товары.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() > 0 Тогда 
			ТекстСообщения = НСтр("ru = 'Код маркировки уже добавлен в табличную часть!'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, Объект.Ссылка);
		Иначе
			ТекущиеДанные = Объект.Товары.Добавить(); 
			ТекущиеДанные.КодМаркировки = РезультатПоиска.КодМарки;
			Если РезультатПоиска.НоменклатураПоШтрихкоду.Количество() > 0 Тогда 
				ТекущиеДанные.Номенклатура = РезультатПоиска.НоменклатураПоШтрихкоду[0];
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработатьРезультатПервичнойОперацииВыводИзОборотаСервиса(АдресРезультата, ДополнительныеПараметры)
	
	РезультатОперации = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Если РезультатОперации.ОперацияВыполненаУспешно Тогда
		
		ОбработатьУспешноеВыполнениеОперацииВыводИзОборотаСервиса(РезультатОперации.РазобранныйОтвет);
		
	Иначе
		
		ДополнительныеПараметры.ОперацияВыполнялась = РезультатОперации.ОперацияВыполнялась;
		ДополнительныеПараметры.ОперацияВыполненаСВременнойОшибкой = РезультатОперации.ОперацияВыполненаСВременнойОшибкой;
		Если РезультатОперации.ПараметрыПодписания <> Неопределено Тогда
			ДополнительныеПараметры.ДанныеНаПодпись = РезультатОперации.ПараметрыПодписания.ДанныеНаПодпись;
		КонецЕсли;
		
		ОповещениеПриЗавершении = Новый ОписаниеОповещения(
		"ОбработатьОшибкуПервичнойОперацииВыводИзОборотаСервисаЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
		ОбменИСМПБГУКлиент.ОбработатьРезультатОперацииСервиса(РезультатОперации, Истина, ОповещениеПриЗавершении);
		
	КонецЕсли;
	
КонецПроцедуры   

&НаКлиенте
Процедура ОбработатьУспешноеВыполнениеОперацииВыводИзОборотаСервиса(РазобранныйОтвет)
	
	Объект.ИдентификаторИСМП = РазобранныйОтвет;
	
	НовоеЗначениеСтатуса = ПредопределенноеЗначение("Перечисление.СтатусыДокументовИСМПБГУ.Принят");
	УстановитьСтатусДокумента(НовоеЗначениеСтатуса);
	
	Элементы.СтраницыДлительнаяОперация.ТекущаяСтраница = Элементы.СтраницаДлительнаяОперацияВыполненаУспешно;
	ПодключитьОбработчикОжидания("НачатьОбновлениеСтатуса", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатусДокумента(НовоеЗначениеСтатуса)
	
	Если Объект.Статус <> НовоеЗначениеСтатуса Тогда
		
		Объект.Статус = НовоеЗначениеСтатуса;
		
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Проведение);
		
		Успешно = Записать(ПараметрыЗаписи);
		
		Если Успешно Тогда
			
			ОтправленоВЧестныйЗнак = ЗначениеЗаполнено(Объект.ИдентификаторИСМП);
			ТолькоПросмотр = ОтправленоВЧестныйЗнак;
			Элементы.ВывестиИзОборотаИСМП.Доступность = НЕ ОтправленоВЧестныйЗнак;
			
		Иначе
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать новый статус документа. Запишите документ вручную.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, Объект.Ссылка);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьОбновлениеСтатуса()
	
	Если ЗначениеЗаполнено(Объект.ИдентификаторИСМП) Тогда
		ПродолжитьОбновлениеСтатуса();
	Иначе
		ТекстСообщения = НСтр("ru = 'Проверка статуса возможна после отправки документа и получения идентификатора ""Честного знака""'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, "Объект.ИдентификаторИСМП");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОбновлениеСтатуса()
	
	ТипОперацииСервиса = ТипОперацииСервисаПервичная();
	ПараметрыЗапросаСодержимогоДокумента = ПараметрыЗапросаСодержимогоДокумента();
	
	НачатьВыполнениеДлительнойОперацииСодержимоеДокумента(ТипОперацииСервиса, ПараметрыЗапросаСодержимогоДокумента);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОбновлениеСтатуса()
	
	Элементы.СтраницыДлительнаяОперация.ТекущаяСтраница = Элементы.СтраницаДлительнаяОперацияНеВыполняется;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыЗапросаСодержимогоДокумента()
	
	ПараметрыЗапросаСодержимогоДокумента = ОбменИСМПБГУКлиентСервер.НовыеПараметрыЗапросаСодержимогоДокумента();
	
	ПараметрыЗапросаСодержимогоДокумента.Идентификатор 	= Объект.ИдентификаторИСМП; 
	ПараметрыЗапросаСодержимогоДокумента.Организация 	= Объект.Организация;
	
	Возврат ПараметрыЗапросаСодержимогоДокумента;
	
КонецФункции

&НаКлиенте
Процедура НачатьВыполнениеДлительнойОперацииСодержимоеДокумента(ТипОперацииСервиса, ПараметрыЗапросаСодержимогоДокумента)
	
	Элементы.СтраницыДлительнаяОперация.ТекущаяСтраница = Элементы.СтраницаДлительнаяОперацияВыполняется;
	
	РезультатНачалаВыполнения = РезультатНачалаВыполненияДлительнойОперацииСодержимоеДокумента(
	ПараметрыЗапросаСодержимогоДокумента);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТипОперацииСервиса", ТипОперацииСервиса);
	ДополнительныеПараметры.Вставить("ПараметрыЗапросаСодержимогоДокумента", ПараметрыЗапросаСодержимогоДокумента);
	ДополнительныеПараметры.Вставить("ОперацияВыполнялась", Ложь);
	ДополнительныеПараметры.Вставить("ОперацияВыполненаСВременнойОшибкой", Ложь);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения(
	"ДлительнаяОперацияСодержимоеДокументаЗавершение",
	ЭтотОбъект,
	ДополнительныеПараметры);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатНачалаВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры   

&НаСервере
Функция РезультатНачалаВыполненияДлительнойОперацииСодержимоеДокумента(ПараметрыЗапросаСодержимогоДокумента)
	
	Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Обмен с ИСМП'");
	
	РезультатНачалаВыполнения = ДлительныеОперации.ВыполнитьВФоне(
	"ОбменИСМПБГУВызовСервера.СодержимоеДокументаСервиса",
	ПараметрыЗапросаСодержимогоДокумента,
	ПараметрыВыполнения);
	
	Если РезультатНачалаВыполнения.Статус = "Ошибка" Тогда
		Элементы.СтраницыДлительнаяОперация.ТекущаяСтраница = Элементы.СтраницаДлительнаяОперацияНеВыполняется;
		ВызватьИсключение РезультатНачалаВыполнения.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	ИдентификаторЗадания = РезультатНачалаВыполнения.ИдентификаторЗадания;
	
	Возврат РезультатНачалаВыполнения;
	
КонецФункции 

&НаКлиенте
Процедура ДлительнаяОперацияСодержимоеДокументаЗавершение(РезультатОперации, ДополнительныеПараметры) Экспорт
	
	Если РезультатОперации <> Неопределено Тогда
		
		Элементы.СтраницыДлительнаяОперация.ТекущаяСтраница = Элементы.СтраницаДлительнаяОперацияНеВыполняется;
		
		Если РезультатОперации.Статус = "Ошибка" Тогда
			
			ВызватьИсключение РезультатОперации.КраткоеПредставлениеОшибки;
			
		ИначеЕсли РезультатОперации.Статус = "Выполнено" Тогда
			
			ТипОперацииСервиса = Неопределено;
			Если ДополнительныеПараметры <> Неопределено
				И ДополнительныеПараметры.Свойство("ТипОперацииСервиса", ТипОперацииСервиса) Тогда
				
				Если ТипОперацииСервиса = ТипОперацииСервисаПервичная() Тогда
					ОбработатьРезультатПервичнойОперацииСодержимоеДокументаСервиса(РезультатОперации.АдресРезультата,
					ДополнительныеПараметры);
				ИначеЕсли ТипОперацииСервиса = ТипОперацииСервисаПовторная() Тогда
					ОбработатьРезультатПовторнойОперацииСодержимоеДокументаСервиса(РезультатОперации.АдресРезультата);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры    

&НаКлиенте
Процедура ОбработатьРезультатПервичнойОперацииСодержимоеДокументаСервиса(АдресРезультата, ДополнительныеПараметры)
	
	РезультатОперации = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Если РезультатОперации.ОперацияВыполненаУспешно Тогда
		
		ОбработатьУспешноеВыполнениеОперацииСодержимоеДокументаСервиса(РезультатОперации.РазобранныйОтвет);
		
	Иначе
		
		ДополнительныеПараметры.ОперацияВыполнялась = РезультатОперации.ОперацияВыполнялась;
		ДополнительныеПараметры.ОперацияВыполненаСВременнойОшибкой = РезультатОперации.ОперацияВыполненаСВременнойОшибкой;
		
		ОповещениеПриЗавершении = Новый ОписаниеОповещения(
		"ОбработатьОшибкуПервичнойОперацииСодержимоеДокументаСервисаЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
		ОбменИСМПБГУКлиент.ОбработатьРезультатОперацииСервиса(РезультатОперации, Истина, ОповещениеПриЗавершении);
		
	КонецЕсли;
	
КонецПроцедуры     

&НаКлиенте
Процедура ОбработатьУспешноеВыполнениеОперацииСодержимоеДокументаСервиса(РазобранныйОтвет)
	
	НовоеЗначениеСтатуса = РазобранныйОтвет.Статус;
	УстановитьСтатусДокумента(НовоеЗначениеСтатуса);
	
	ОбработатьТекстОшибки(РазобранныйОтвет.ТекстОшибки);
	
	Элементы.СтраницыДлительнаяОперация.ТекущаяСтраница = Элементы.СтраницаДлительнаяОперацияВыполненаУспешно;
	ПодключитьОбработчикОжидания("ЗавершитьОбновлениеСтатуса", 1, Истина);
	
КонецПроцедуры     

&НаКлиенте
Процедура ОбработатьТекстОшибки(ОбрабатываемыйТекст)
	
	Если ЗначениеЗаполнено(ОбрабатываемыйТекст) Тогда
		ТекстОшибки = ОбрабатываемыйТекст;
		Элементы.ТекстОшибки.Видимость = Истина;
	ИначеЕсли Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыДокументовИСМПБГУ.Неизвестно") Тогда
		ТекстОшибки = НСтр("ru = 'Проверьте статус документа в личном кабинете ""Честного Знака""'");
		Элементы.ТекстОшибки.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОшибкуПервичнойОперацииВыводИзОборотаСервисаЗавершение(РезультатОбработкиОшибки, ДополнительныеПараметры) Экспорт
	
	Если ОбменИСМПБГУКлиент.КлючСессииУстановлен(РезультатОбработкиОшибки)
		Или ОбменИСМПБГУКлиент.ПодписаниеУспешно(РезультатОбработкиОшибки) Тогда
		
		ПараметрыВыводаИзОборота = Неопределено;
		Если ДополнительныеПараметры <> Неопределено
			И ДополнительныеПараметры.Свойство("ПараметрыВыводаИзОборота", ПараметрыВыводаИзОборота) Тогда
			
			ДанныеНаПодпись = Неопределено;
			Если ДополнительныеПараметры <> Неопределено
				И ДополнительныеПараметры.Свойство("ДанныеНаПодпись", ДанныеНаПодпись) Тогда
				ПараметрыВыводаИзОборота.ТелоДокумента = ДополнительныеПараметры.ДанныеНаПодпись;
				ПараметрыВыводаИзОборота.ПодписьДокумента = РезультатОбработкиОшибки.ПодписанныйДокумент;
			КонецЕсли;
			
			ТипОперацииСервиса = ТипОперацииСервисаПовторная();
			НачатьВыполнениеДлительнойОперацииВыводИзОборота(ТипОперацииСервиса, ПараметрыВыводаИзОборота);
			
		КонецЕсли;
		
	ИначеЕсли РезультатОбработкиОшибки = Неопределено И ДополнительныеПараметры <> Неопределено Тогда
		
		ОперацияВыполнялась = Неопределено;
		ДополнительныеПараметры.Свойство("ОперацияВыполнялась", ОперацияВыполнялась);
		
		ОперацияВыполненаСВременнойОшибкой = Неопределено;
		ДополнительныеПараметры.Свойство("ОперацияВыполненаСВременнойОшибкой", ОперацияВыполненаСВременнойОшибкой);
		
		Если ТипЗнч(ОперацияВыполнялась) = Тип("Булево") И ТипЗнч(ОперацияВыполненаСВременнойОшибкой) = Тип("Булево") Тогда
			
			ОбработатьОтказВВыполненииОперацииВыводИзОборотаСервиса(ОперацияВыполнялась, ОперацияВыполненаСВременнойОшибкой);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ОбработатьОтказВВыполненииОперацииВыводИзОборотаСервиса(ОперацияВыполнялась, ОперацияВыполненаСВременнойОшибкой)
	
	Если ОперацияВыполнялась И НЕ ОперацияВыполненаСВременнойОшибкой Тогда
		
		НовоеЗначениеСтатуса = ПредопределенноеЗначение("Перечисление.СтатусыДокументовИСМПБГУ.НеПринят");
		УстановитьСтатусДокумента(НовоеЗначениеСтатуса);
		
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ОбработатьРезультатПовторнойОперацииВыводИзОборотаСервиса(АдресРезультата)
	
	РезультатОперации = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Если РезультатОперации.ОперацияВыполненаУспешно Тогда
		ОбработатьУспешноеВыполнениеОперацииВыводИзОборотаСервиса(РезультатОперации.РазобранныйОтвет);
	Иначе
		ОбменИСМПБГУКлиент.ОбработатьРезультатОперацииСервиса(РезультатОперации, Ложь);
		ОбработатьОтказВВыполненииОперацииВыводИзОборотаСервиса(РезультатОперации.ОперацияВыполнялась,
		РезультатОперации.ОперацияВыполненаСВременнойОшибкой);
	КонецЕсли;
	
КонецПроцедуры      

&НаКлиенте
Процедура ОбработатьРезультатПовторнойОперацииСодержимоеДокументаСервиса(АдресРезультата)
	
	РезультатОперации = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Если РезультатОперации.ОперацияВыполненаУспешно Тогда
		ОбработатьУспешноеВыполнениеОперацииСодержимоеДокументаСервиса(РезультатОперации.РазобранныйОтвет);
	Иначе
		ОбменИСМПБГУКлиент.ОбработатьРезультатОперацииСервиса(РезультатОперации, Ложь);
		ОбработатьОтказВВыполненииОперацииСодержимоеДокументаСервиса(РезультатОперации.ОперацияВыполнялась,
		РезультатОперации.ОперацияВыполненаСВременнойОшибкой);
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ОбработатьОтказВВыполненииОперацииСодержимоеДокументаСервиса(ОперацияВыполнялась, ОперацияВыполненаСВременнойОшибкой)
	
	Если ОперацияВыполнялась И НЕ ОперацияВыполненаСВременнойОшибкой Тогда
		
		НовоеЗначениеСтатуса = ПредопределенноеЗначение("Перечисление.СтатусыДокументовИСМПБГУ.Неизвестно");
		УстановитьСтатусДокумента(НовоеЗначениеСтатуса);
		
		ОбработатьТекстОшибки("");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОшибкуПервичнойОперацииСодержимоеДокументаСервисаЗавершение(РезультатОбработкиОшибки, ДополнительныеПараметры) Экспорт
	
	Если ОбменИСМПБГУКлиент.КлючСессииУстановлен(РезультатОбработкиОшибки) Тогда
		
		ПараметрыЗапросаСодержимогоДокумента = Неопределено;
		Если ДополнительныеПараметры <> Неопределено
			И ДополнительныеПараметры.Свойство("ПараметрыЗапросаСодержимогоДокумента",
			ПараметрыЗапросаСодержимогоДокумента) Тогда
			
			ТипОперацииСервиса = ТипОперацииСервисаПовторная();
			НачатьВыполнениеДлительнойОперацииСодержимоеДокумента(ТипОперацииСервиса, ПараметрыЗапросаСодержимогоДокумента);
			
		КонецЕсли;
		
	ИначеЕсли РезультатОбработкиОшибки = Неопределено И ДополнительныеПараметры <> Неопределено Тогда
		
		ОперацияВыполнялась = Неопределено;
		ДополнительныеПараметры.Свойство("ОперацияВыполнялась", ОперацияВыполнялась);
		
		ОперацияВыполненаСВременнойОшибкой = Неопределено;
		ДополнительныеПараметры.Свойство("ОперацияВыполненаСВременнойОшибкой", ОперацияВыполненаСВременнойОшибкой);
		
		Если ТипЗнч(ОперацияВыполнялась) = Тип("Булево") И ТипЗнч(ОперацияВыполненаСВременнойОшибкой) = Тип("Булево") Тогда
			
			ОбработатьОтказВВыполненииОперацииСодержимоеДокументаСервиса(ОперацияВыполнялась, ОперацияВыполненаСВременнойОшибкой);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияОбОрганизации()
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда 
		ИННОрганизации 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ИНН");
		АдресОрганизации 	= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Объект.Организация, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);;
	КонецЕсли;	
	
КонецПроцедуры 	

&НаСервере
Процедура ЗаполнитьПричиныВыводаИзОборота()
	
	ПричиныВыводаИзОборота = Новый Массив;
	ПредставленияПричин = ОбменИСМПБГУКлиентСерверПовтИсп.ПредставленияПричинВыводаИзОборота(); 
	Для Каждого ПредставлениеПричины Из ПредставленияПричин Цикл
		ПричиныВыводаИзОборота.Добавить(ПредставлениеПричины.Значение);
	КонецЦикла;
	Элементы.ПричинаВыводаИзОборота.СписокВыбора.ЗагрузитьЗначения(ПричиныВыводаИзОборота);  
	Если Параметры.Ключ.Пустая() И Параметры.ЗначениеКопирования.Пустая() Тогда
		Объект.ПричинаВыводаИзОборота = ПричиныВыводаИзОборота[0];                 
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьТипМаркировки()
	
	Элементы.ТипМаркировкиККТ.СписокВыбора.Очистить();
	
	СписокВидовМаркировки = ОбменИСМПБГУ.СписокВидовМаркировки();
	Для Каждого ВидМаркировки Из СписокВидовМаркировки Цикл   
		Представление = ВидМаркировки;
		Элементы.ТипМаркировкиККТ.СписокВыбора.Добавить(ВидМаркировки, Представление);	
	КонецЦикла;
	
	Если Параметры.Ключ.Пустая() И Параметры.ЗначениеКопирования.Пустая() Тогда
		Объект.ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.Антисептики;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьДоступностьЭлментовФормы()
	
	ОтправленоВЧестныйЗнак = ЗначениеЗаполнено(Объект.ИдентификаторИСМП);
	ТолькоПросмотр = ОтправленоВЧестныйЗнак;
	Элементы.ВывестиИзОборотаИСМП.Доступность = НЕ ОтправленоВЧестныйЗнак;
	
КонецПроцедуры	

&НаСервере
Функция СопоставитьТипыМаркировки(ТипМаркировкиККТ)
	
	Если ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.Антисептики Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.Антисептики;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.БАДы Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.БАДы;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.Велосипеды Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.Велосипеды;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.Духи Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.Духи;	 
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.КреслаКоляски Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.КреслаКоляски;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.ЛегкаяПромышленность Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.ЛегкаяПромышленность;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.МолочнаяПродукция Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.МолочнаяПродукция;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.Морепродукты Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.Морепродукты;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.СоковаяПродукция Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.СоковаяПродукция;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.УпакованнаяВода Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.УпакованнаяВода;	
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.Фотоаппараты Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.ФотоОборудование;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.Шины Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.Шины;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.Обувь Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.Обувь;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.МедицинскиеИзделия Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.МедицинскиеИзделия;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.ПарфюмерныеИКосметическиеСредстваИБытоваяХимия Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.ПарфюмерныеИКосметическиеСредстваИБытоваяХимия;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.ТехническиеСредстваРеабилитации Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.ТехническиеСредстваРеабилитации;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.БезалкогольныеНапитки Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.БезалкогольныеНапитки;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.ВетеринарныеПрепараты Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.ВетеринарныеПрепараты;
	ИначеЕсли ТипМаркировкиККТ = Перечисления.ВидыМаркированнойПродукцииБПО.КормаДляЖивотных Тогда 
		Возврат Перечисления.ВидыМаркируемойПродукции.КормаДляЖивотных;	 
	Иначе
		Возврат Перечисления.ВидыМаркируемойПродукции.ПустаяСсылка();
	КонецЕсли;	
	
КонецФункции	

&НаСервере
Функция ПолучитьТипМаркировкиНоменклатуры(Номенклатура)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ВидМаркируемойПродукции");
	
КонецФункции	

&НаКлиенте
Процедура ТипМаркировкиККТОбработкаВыбораЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Объект.Товары.Очистить(); 
		Объект.ТипМаркировкиККТ = ДополнительныеПараметры.ВыбранноеЗначение;
		УстановитьВидимостьЭлементовФормы();  
		УстановитьВидимостьКолонокТовары();
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипМаркировкиККТПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементовФормы();  
	УстановитьВидимостьКолонокТовары();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()
	
	ВедетсяОСУПоТипуМаркировки 			= (ОбменИСМПБГУ.ВидыМаркировкиОбъемноСортовогоУчета().Найти(Объект.ТипМаркировкиККТ) <> Неопределено); 
	СписаниеНаСвоиНужды 				= ОбменИСМПБГУ.ПричинаВыводаСервисаПоПричинеВывода(Объект.ПричинаВыводаИзОборота) = "OWN_USE"
											Или ОбменИСМПБГУ.ПричинаВыводаСервисаПоПричинеВывода(Объект.ПричинаВыводаИзОборота) = "DONATION"; 
	СтрогийКонтрольМестаДеятельности 	= ОбменИСМПБГУКлиентСерверПовтИсп.ЭтоТоварнаяГруппаСоСтрогимКонтролемМестаДеятельности(Объект.ТипМаркировкиККТ);
	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОбъемноСортовойУчет", "Видимость", ВедетсяОСУПоТипуМаркировки);  
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ИННПокупателя", "Видимость", СписаниеНаСвоиНужды);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"КППТорговойТочки", "Видимость", СтрогийКонтрольМестаДеятельности);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ИдентификаторФИАС", "Видимость", СтрогийКонтрольМестаДеятельности);

	Объект.ОбъемноСортовойУчет = ВедетсяОСУПоТипуМаркировки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтоговыйВес()

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	ТекущиеДанные.ВесИтого = ТекущиеДанные.Количество * ТекущиеДанные.Вес;
	
КонецПроцедуры	 
