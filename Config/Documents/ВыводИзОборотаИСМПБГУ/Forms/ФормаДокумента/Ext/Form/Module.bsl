#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыТовары

&НаКлиенте
Процедура ТоварыКодМаркировкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда 
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораКода", ЭтотОбъект);
		Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Организация"	, Объект.Организация);
		ПараметрыФормы.Вставить("Номенклатура"	, ТекущиеДанные.Номенклатура);
		ПараметрыФормы.Вставить("ОСУ"			, Объект.ОбъемноСортовойУчет); 
		ПараметрыФормы.Вставить("ДатаОстатков"	, Объект.Дата);
		ПараметрыФормы.Вставить("Количество"	, ТекущиеДанные.Количество);
		
		ОткрытьФорму("ОбщаяФорма.ВыборКодаИСМПБГУ", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);
	КонецЕсли;	
	
КонецПроцедуры 

&НаКлиенте
Процедура ТоварыКодGTINНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда 
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораКода", ЭтотОбъект);
		Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Организация"	, Объект.Организация);
		ПараметрыФормы.Вставить("Номенклатура"	, ТекущиеДанные.Номенклатура);
		ПараметрыФормы.Вставить("ОСУ"			, Объект.ОбъемноСортовойУчет);
		ПараметрыФормы.Вставить("Количество"	, ТекущиеДанные.Количество);
		
		ОткрытьФорму("ОбщаяФорма.ВыборКодаИСМПБГУ", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка 	= Ложь;  
	ОбработчикОповещения 	= Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораНоменклатуры", ЭтотОбъект);
	ТипНоменклатуры 		= СопоставитьТипыМаркировки(Объект.ТипМаркировкиККТ);
	ПараметрыОтбора 		= Новый Структура("ВидМаркируемойПродукции", ТипНоменклатуры);
	ПараметрыФормы 			= Новый Структура("Отбор", ПараметрыОтбора);
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,, ОбработчикОповещения);
	
КонецПроцедуры

