#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры
//  Ссылка  - ДокументСсылка.ТаксировкаПутевогоЛиста - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ДобавитьДвиженияРасходОстаткиКодовИСМП(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры // ИнициализироватьДанныеДокумента()

#Область ДляВызоваИзДругихПодсистем

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
КонецПроцедуры

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

Процедура ДобавитьДвиженияРасходОстаткиКодовИСМП(ТаблицыДляДвижений, ДокументСсылка)

	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДокументСсылка"		, ДокументСсылка);
	Запрос.УстановитьПараметр("КонтрольКодовИСМП"	, ОбменИСМПБГУ.ВедетсяКонтрольОстатковКодовИСМП(ДокументСсылка.Организация));
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВыводИзОборотаИСМПТовары.Ссылка.Дата КАК Период,
	               |	ВыводИзОборотаИСМПТовары.Ссылка.Ссылка КАК Регистратор,
	               |	ВыводИзОборотаИСМПТовары.Ссылка.Организация КАК Организация,
	               |	ВыводИзОборотаИСМПТовары.Номенклатура КАК Номенклатура,
	               |	СУММА(ВыводИзОборотаИСМПТовары.Количество) КАК Количество,
	               |	ВЫБОР
	               |		КОГДА ВыводИзОборотаИСМПТовары.Ссылка.ОбъемноСортовойУчет
	               |			ТОГДА ВыводИзОборотаИСМПТовары.КодGTIN
	               |		ИНАЧЕ ВыводИзОборотаИСМПТовары.КодМаркировки
	               |	КОНЕЦ КАК КодИСМП,
	               |	ВыводИзОборотаИСМПТовары.НомерСтроки КАК НомерСтроки
	               |ПОМЕСТИТЬ ВТТовары
	               |ИЗ
	               |	Документ.ВыводИзОборотаИСМПБГУ.Товары КАК ВыводИзОборотаИСМПТовары
	               |ГДЕ
	               |	ВыводИзОборотаИСМПТовары.Ссылка = &ДокументСсылка
	               |	И &КонтрольКодовИСМП = ИСТИНА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВыводИзОборотаИСМПТовары.Ссылка.Ссылка,
	               |	ВыводИзОборотаИСМПТовары.Номенклатура,
	               |	ВыводИзОборотаИСМПТовары.Ссылка.Дата,
	               |	ВыводИзОборотаИСМПТовары.Ссылка.Организация,
	               |	ВЫБОР
	               |		КОГДА ВыводИзОборотаИСМПТовары.Ссылка.ОбъемноСортовойУчет
	               |			ТОГДА ВыводИзОборотаИСМПТовары.КодGTIN
	               |		ИНАЧЕ ВыводИзОборотаИСМПТовары.КодМаркировки
	               |	КОНЕЦ,
	               |	ВыводИзОборотаИСМПТовары.НомерСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТТовары.Период КАК Период,
	               |	ВТТовары.Регистратор КАК Регистратор,
	               |	ВТТовары.Организация КАК Организация,
	               |	ВТТовары.Номенклатура КАК Номенклатура,
	               |	ВЫБОР
	               |		КОГДА ВТТовары.Регистратор.ОбъемноСортовойУчет
	               |			ТОГДА ВТТовары.Количество
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК Количество,
	               |	ВТТовары.КодИСМП КАК КодИСМП,
	               |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	               |	ВТТовары.НомерСтроки КАК НомерСтроки
	               |ИЗ
	               |	ВТТовары КАК ВТТовары
	               |ГДЕ
	               |	ВТТовары.КодИСМП <> """"";   
	
	ТаблицаДвиженийОстаткиКодовИСМП = Запрос.Выполнить().Выгрузить();
	
	ТаблицыДляДвижений.Вставить("КодыИСМПБГУ", ТаблицаДвиженийОстаткиКодовИСМП);
	Если ТаблицаДвиженийОстаткиКодовИСМП.Количество() > 0 Тогда 
		ОбменИСМПБГУ.ПроверитьОстаткиКодовИСМП(ДокументСсылка, ТаблицаДвиженийОстаткиКодовИСМП);
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти  

#КонецЕсли
