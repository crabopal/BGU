#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ОбъемноСортовойУчет Тогда
		ПроверяемыеРеквизиты.Добавить("Товары.КодМаркировки");
	Иначе
		ПроверяемыеРеквизиты.Добавить("Товары.КодGTIN");
		ПроверяемыеРеквизиты.Добавить("Товары.Количество");
	КонецЕсли;
		
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Ответственный = Пользователи.ТекущийПользователь();
	Статус = Перечисления.СтатусыДокументовИСМПБГУ.НеОтправлен;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВедомостьНаВыдачуМЗНаНуждыУчреждения") Тогда
		
		ЗаполнитьПоВедомостиНаВыдачу(ДанныеЗаполнения, СтандартнаяОбработка);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИдентификаторИСМП = "";
	Статус = Перечисления.СтатусыДокументовИСМПБГУ.НеОтправлен;
	Ответственный = Пользователи.ТекущийПользователь();
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти 

#Область ЗаполнениеДокумента

Процедура ЗаполнитьПоВедомостиНаВыдачу(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВедомостьНаВыдачуМЗНаНуждыУчреждения.Организация КАК Организация,
	               |	ВедомостьНаВыдачуМЗНаНуждыУчреждения.Ссылка КАК ДокументОснование
	               |ИЗ
	               |	Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения КАК ВедомостьНаВыдачуМЗНаНуждыУчреждения
	               |ГДЕ
	               |	ВедомостьНаВыдачуМЗНаНуждыУчреждения.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Номенклатура КАК Номенклатура,
	               |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Количество КАК Количество
	               |ИЗ
	               |	Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения.МатериальныеЗапасы КАК ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы
	               |ГДЕ
	               |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Ссылка = &Ссылка
	               |	И ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Номенклатура.ВидМаркируемойПродукции В(&ВидыМаркируемойПродукции)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.НомерСтроки"; 
	
	ВидыМаркируемойПродукции = Новый Массив;
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.Антисептики);
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.БАДы);
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.Велосипеды);
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.Духи);
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.КреслаКоляски);
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.ЛегкаяПромышленность);
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.МолочнаяПродукция);
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.Морепродукты);
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.СоковаяПродукция);
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.УпакованнаяВода);
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.ФотоОборудование);
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.Шины); 
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.Обувь);
    ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.МедицинскиеИзделия);
    ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.ПарфюмерныеИКосметическиеСредстваИБытоваяХимия);
    ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.ТехническиеСредстваРеабилитации);
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.БезалкогольныеНапитки);
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.ВетеринарныеПрепараты);
	ВидыМаркируемойПродукции.Добавить(Перечисления.ВидыМаркируемойПродукции.КормаДляЖивотных);
	
	Запрос.УстановитьПараметр("ВидыМаркируемойПродукции", ВидыМаркируемойПродукции);                                   
	Запрос.УстановитьПараметр("Ссылка"					, ДанныеЗаполнения);                                   
	РезультатЗапроса = Запрос.ВыполнитьПакет();
			
	ДанныеШапки = РезультатЗапроса[0].Выбрать();
	ДанныеШапки.Следующий();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеШапки); 
	ОбъемноСортовойУчет = Истина;
			
	Товары.Загрузить(РезультатЗапроса[1].Выгрузить());
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли