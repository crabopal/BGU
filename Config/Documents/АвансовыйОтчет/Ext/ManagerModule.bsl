	|ВЫБРАТЬ
	|	ПоступлениеМатериалов.Ссылка КАК Ссылка,
	|	ПоступлениеМатериалов.НомерСтроки КАК НомерСтроки,
	|	ПоступлениеМатериалов.Организация КАК Организация,
	|	ПоступлениеМатериалов.НаименованиеОрганизации КАК НаименованиеОрганизации,
	|	ПоступлениеМатериалов.КодОКПО КАК КодОКПО,
	|	ПоступлениеМатериалов.ЦМО КАК ЦМО,
	|	ПоступлениеМатериалов.МОЛ КАК МОЛ,
	|	ПоступлениеМатериалов.ИФО КАК ИФО,
	|	ПоступлениеМатериалов.Дата КАК Дата,
	|	ПоступлениеМатериалов.Сотрудник КАК Сотрудник,
	|	Шапка.Поставщик КАК Поставщик,
	|	ПоступлениеМатериалов.КодПоставщика КАК КодПоставщика,
	|	ПоступлениеМатериалов.КФО КАК КФО,
	|	ПоступлениеМатериалов.КорСчетБК КАК КорСчетБК,
	|	ПоступлениеМатериалов.КорСчетКОСГУ КАК КорСчетКОСГУ,
	|	ПоступлениеМатериалов.СчетКредита КАК СчетКредита,
	|	ПоступлениеМатериалов.ДокументДата КАК ДокументДата,
	|	ПоступлениеМатериалов.ДокументНомер КАК ДокументНомер,
	|	ПоступлениеМатериалов.Номенклатура КАК Номенклатура,
	|	ПоступлениеМатериалов.НоменклатурныйНомер КАК НоменклатурныйНомер,
	|	ПоступлениеМатериалов.КодЕдИзм КАК КодЕдИзм,
	|	ПоступлениеМатериалов.ЕдИзм КАК ЕдИзм,
	|	ПоступлениеМатериалов.Количество КАК Количество,
	|	ПоступлениеМатериалов.Цена КАК Цена,
	|	ПоступлениеМатериалов.Сумма КАК Сумма,
	|	ПоступлениеМатериалов.НДС КАК НДС,
	|	ПоступлениеМатериалов.Всего КАК Всего
	|ИЗ
	|	ПоступлениеМатериалов КАК ПоступлениеМатериалов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Шапка КАК Шапка
	|		ПО ПоступлениеМатериалов.Ссылка = Шапка.Ссылка
	|			И ПоступлениеМатериалов.Поставщик = Шапка.Поставщик";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	Выборка = МассивРезультатов[2].Выбрать();
	
	ПоступленияМЗ = МассивРезультатов[3].Выгрузить();
	
	ПервыйДокумент = Истина;
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьШапка.Параметры.Заполнить(Выборка);
		
		СтруктураОбласть = Новый Структура;
		СтруктураОбласть.Вставить("КорСчет", УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета("", Выборка.КФО, Выборка.СчетКредита, ""));
		СтруктураОбласть.Вставить("КорСчетКОСГУ", БухгалтерскийУчет.КЭКСчета(Выборка.Организация, Выборка.ИФО, Выборка.КФО, Выборка.Дата, Выборка.СчетКредита, "Кт", Выборка.КорСчетКОСГУ)); 
		ОбластьШапка.Параметры.Заполнить(СтруктураОбласть);
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		СтруктураОбласть = Новый Структура("КоличествоИтог, СуммаИтог, НДСИтог, ВсегоИтог");
		СтруктураОбласть.КоличествоИтог 	= 0;
		СтруктураОбласть.СуммаИтог 			= 0;
		СтруктураОбласть.НДСИтог 			= 0;
		СтруктураОбласть.ВсегоИтог 			= 0;
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Ссылка", 			Выборка.Ссылка);
		СтруктураПоиска.Вставить("КФО", 			Выборка.КФО);
		СтруктураПоиска.Вставить("ЦМО", 			Выборка.ЦМО);
		СтруктураПоиска.Вставить("Поставщик", 		Выборка.Поставщик);
		СтруктураПоиска.Вставить("КодПоставщика", 	Выборка.КодПоставщика);
		СтруктураПоиска.Вставить("КорСчетБК", 		Выборка.КорСчетБК);
		СтруктураПоиска.Вставить("КорСчетКОСГУ", 	Выборка.КорСчетКОСГУ);
		СтруктураПоиска.Вставить("СчетКредита", 	Выборка.СчетКредита);
		СтруктураПоиска.Вставить("МОЛ", 			Выборка.МОЛ);
		
		ВыбранныеСтроки = ПоступленияМЗ.НайтиСтроки(СтруктураПоиска);
		
		Для Каждого ВыбраннаяСтрока Из ВыбранныеСтроки Цикл
			
			ОбластьСтрока.Параметры.Заполнить(ВыбраннаяСтрока);
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
			СтруктураОбласть.КоличествоИтог = СтруктураОбласть.КоличествоИтог 	+ ВыбраннаяСтрока.Количество;
			СтруктураОбласть.СуммаИтог 		= СтруктураОбласть.СуммаИтог 		+ ВыбраннаяСтрока.Сумма;
			СтруктураОбласть.НДСИтог 		= СтруктураОбласть.НДСИтог 			+ ВыбраннаяСтрока.НДС;
			СтруктураОбласть.ВсегоИтог 		= СтруктураОбласть.ВсегоИтог 		+ ВыбраннаяСтрока.Всего;
			
		КонецЦикла;
		
		ОбластьИтог.Параметры.Заполнить(СтруктураОбласть);
		ТабличныйДокумент.Вывести(ОбластьИтог);
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
		Выборка.МОЛ, Выборка.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураОбласть = Новый Структура("ДолжностьМОЛ, ФИОМол");
		СтруктураОбласть.ДолжностьМОЛ	= ДанныеСотрудника.Должность;
		СтруктураОбласть.ФИОМол			= КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		
		ОбластьПодвал.Параметры.Заполнить(СтруктураОбласть);
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область ФормированиеСчетовФактур

Функция ПолучитьИменаПолейПоискаСФвТабличнойЧасти()
	
	Возврат "Контрагент, НомерСФ, ДатаСФ, БланкСтрогойОтчетности";
	
КонецФункции

// Формирует подчиненные счета-фактуры полученные для строк Авансового отчета
// Выполняется в рамках системной транзакции, которая открыта платформой, и явно открывать новую транзакцию не требуется (вызывается из обработчика ПередЗаписью)
//
// Параметры
//   ДокументОбъект - ДокументОбъект.АвансовыйОтчет - Авансовый отчет, для которого нужно сформировать счета-фактуры.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица всех подчиненных счетов-фактур (включая неиспользуемые) с установленным признаком Использован.
//
Функция СформироватьПодчиненныеСчетаФактуры(ДокументОбъект) Экспорт
	
	Если ДокументОбъект.ЭтоНовый() Тогда
		ДокументСсылка = ДокументОбъект.ПолучитьСсылкуНового();
		Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
			ДокументСсылка = Документы.АвансовыйОтчет.ПолучитьСсылку();
			ДокументОбъект.УстановитьСсылкуНового(ДокументСсылка);
		КонецЕсли;
	Иначе
		ДокументСсылка = ДокументОбъект.Ссылка;
	КонецЕсли;
	
	ТаблицаСФ = ПолучитьТаблицуПодчиненныхСчетовФактур(ДокументОбъект);
	
	ТаблицаНФА = ДанныеСчетовФактурПоДокументу(ДокументОбъект);
	
	ТаблицаДокумента = ТаблицаНФА.Скопировать();
	ТаблицаДокумента.Свернуть(ПолучитьИменаПолейПоискаСФвТабличнойЧасти() + ", СчетФактура", "Сумма, СуммаНДС");
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокумента Цикл
		
		// Поиск существующего документа счет-фактура полученный
		СтрокаСФ = НайтиСтрокуСчетаФактуры(ТаблицаСФ, СтрокаТаблицы);
		
		Если СтрокаСФ = Неопределено Тогда
			ИспользованСуществующийДокумент = Ложь;
			
			ДокументСФ = Документы.СчетФактураПолученный.СоздатьДокумент();
			ДокументСФ.ДокументыОснования.Добавить().ДокументОснование = ДокументСсылка;
			
			ЗаполнитьСчетФактуруПоАвансовомуОтчету(ДокументСФ,
				ДокументОбъект, ДокументСсылка, СтрокаТаблицы, ТаблицаНФА);
			
			// Зафиксируем новый счет-фактуру в таблице
			СтрокаСФ = ТаблицаСФ.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСФ, СтрокаТаблицы);
			ЗаполнитьЗначенияСвойств(СтрокаСФ, ДокументСФ);
			СтрокаСФ.Использован = Истина;
			
		Иначе
			ИспользованСуществующийДокумент = Истина;
			
			ДокументСФСсылка = СтрокаСФ.Ссылка;
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Документ.СчетФактураПолученный");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ДокументСФСсылка);
			Блокировка.Заблокировать();
			
			ЗаблокироватьДанныеДляРедактирования(ДокументСФСсылка);
			
			ДокументСФ = ДокументСФСсылка.ПолучитьОбъект();
			Если ДокументСФ.ДокументыОснования.Найти(ДокументСсылка, "ДокументОснование") = Неопределено Тогда
				ДокументСФ.ДокументыОснования.Добавить().ДокументОснование = ДокументСсылка;
			КонецЕсли;
			
			ЗаполнитьСчетФактуруПоАвансовомуОтчету(ДокументСФ,
				ДокументОбъект, ДокументСсылка, СтрокаТаблицы, ТаблицаНФА);
			
			СтрокаСФ.Использован = Истина;
			
		КонецЕсли;
		
		Если ДокументСФ.Модифицированность() Тогда
			УстановитьСФТиповуюОперациюПоУмолчанию(ДокументСФ);
			Если ДокументСФ.Проведен Тогда
				ДокументСФ.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ДокументСФ.Записать();
			КонецЕсли;
		КонецЕсли;
		
		Если ИспользованСуществующийДокумент Тогда
			РазблокироватьДанныеДляРедактирования(ДокументСФСсылка);
		КонецЕсли;
		
	КонецЦикла;
	
	// Запишем ссылки на созданные счета-фактуры в строки документа
	Для Каждого СтрокаТаблицы Из ДокументОбъект["Израсходовано"] Цикл
		
		Если СтрокаТаблицы.ПредъявленСФ Тогда
			
			СтрокаСФ = НайтиСтрокуСчетаФактуры(ТаблицаСФ, СтрокаТаблицы);
			Если СтрокаСФ <> Неопределено Тогда
				Если Не СтрокаТаблицы.СчетФактура = СтрокаСФ.Ссылка Тогда
					СтрокаТаблицы.СчетФактура = СтрокаСФ.Ссылка;
				КонецЕсли;
			Иначе
				СтрокаТаблицы.СчетФактура = Документы.СчетФактураПолученный.ПустаяСсылка();
			КонецЕсли;
			
		Иначе
			
			Если ЗначениеЗаполнено(СтрокаТаблицы.СчетФактура) Тогда
				СтрокаТаблицы.СчетФактура = Документы.СчетФактураПолученный.ПустаяСсылка();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаСФ;
	
КонецФункции

// Выполняет проведение, отмену проведения, помечает на удаление подчиненные счета-фактуры Авансового отчета
//
// Параметры
//   ПодчиненныеСчетаФактуры - ТаблицаЗначений - таблица всех подчиненных счетов-фактур (включая неиспользуемые) 
//                                              с установленным признаком Использован.
//   ДокументОбъект - ДокументОбъект.АвансовыйОтчет - Авансовый отчет, для которого нужно обновить счета-фактуры.
//   РежимЗаписи - РежимЗаписиДокумента - режим записи документа Авансовый отчет.
//
Процедура ОбновитьПодчиненныеСчетаФактуры(ПодчиненныеСчетаФактуры, ДокументОбъект, РежимЗаписи) Экспорт

	Если ПодчиненныеСчетаФактуры = Неопределено Тогда
		
		// Посмотрим, какие из подчиненных счетов-фактур указаны в табличной части
		ПодчиненныеСчетаФактуры = ПолучитьТаблицуПодчиненныхСчетовФактур(ДокументОбъект);
		Для Каждого СчетФактура Из ПодчиненныеСчетаФактуры Цикл
			Если ДокументОбъект["Израсходовано"].Найти(СчетФактура.Ссылка, "СчетФактура") <> Неопределено Тогда
				СчетФактура.Использован = Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого СтрокаСФ Из ПодчиненныеСчетаФактуры Цикл
	
		Если ДокументОбъект.ПометкаУдаления ИЛИ НЕ СтрокаСФ.Использован Тогда
			Если НЕ СтрокаСФ.ПометкаУдаления Тогда
				ДокументСФ = СтрокаСФ.Ссылка.ПолучитьОбъект();
				Если ДокументСФ.ДокументыОснования.Количество() > 1 Тогда
					СтрокиТекОснования = ДокументСФ.ДокументыОснования.НайтиСтроки(Новый Структура("ДокументОснование", ДокументОбъект.Ссылка));
					Для каждого СтрокаТекОснования Из СтрокиТекОснования Цикл
						ДокументСФ.ДокументыОснования.Удалить(СтрокаТекОснования);
					КонецЦикла;
					РежимЗаписиСФ = ?(ДокументСФ.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
					УстановитьСФТиповуюОперациюПоУмолчанию(ДокументСФ);
					ДокументСФ.Записать(РежимЗаписиСФ);
				Иначе
					ДокументСФ.УстановитьПометкуУдаления(Истина);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ДокументСФ = СтрокаСФ.Ссылка.ПолучитьОбъект();
			Если ДокументСФ.ПометкаУдаления Тогда
				ДокументСФ.ПометкаУдаления = Ложь;
			КонецЕсли;
			РежимЗаписиСФ = РежимЗаписи;
			Если ДокументСФ.Проведен И РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
				РежимЗаписиСФ = РежимЗаписиДокумента.ОтменаПроведения;
			ИначеЕсли НЕ ДокументСФ.Проведен И РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
				РежимЗаписиСФ = РежимЗаписиДокумента.Проведение;
			КонецЕсли;
			УстановитьСФТиповуюОперациюПоУмолчанию(ДокументСФ);
			ДокументСФ.Записать(РежимЗаписиСФ);
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

// Возвращает таблицу подчиненных счетов-фактур для данного Авансового отчета
//
// Параметры
//   ДокументОбъект - ДокументОбъект.АвансовыйОтчет - Авансовый отчет, для которого нужно сформировать счета-фактуры.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица подчиненных счетов-фактур.
//
Функция ПолучитьТаблицуПодчиненныхСчетовФактур(ДокументОбъект)

	Если НЕ ДокументОбъект.ЭтоНовый() Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДокументОснование", ДокументОбъект.Ссылка);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СчетФактураПолученный.Ссылка КАК Ссылка,
		|	СчетФактураПолученный.Ссылка.НомерПервичногоДокумента КАК НомерСФ,
		|	СчетФактураПолученный.Ссылка.ДатаПервичногоДокумента КАК ДатаСФ,
		|	СчетФактураПолученный.Ссылка.Контрагент КАК Контрагент,
		|	СчетФактураПолученный.Ссылка.БланкСтрогойОтчетности КАК БланкСтрогойОтчетности,
		|	СчетФактураПолученный.Ссылка.Проведен,
		|	СчетФактураПолученный.Ссылка.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Документ.СчетФактураПолученный.ДокументыОснования КАК СчетФактураПолученный
		|ГДЕ
		|	СчетФактураПолученный.ДокументОснование = &ДокументОснование
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетФактураПолученный.Ссылка.Дата,
		|	ПометкаУдаления УБЫВ,
		|	Ссылка";
		ТаблицаСФ = Запрос.Выполнить().Выгрузить();
		
	Иначе // пустая таблица с аналогичными колонками
		
		ТаблицаСФ = Новый ТаблицаЗначений();
		ТаблицаСФ.Колонки.Добавить("Ссылка",          Новый ОписаниеТипов("ДокументСсылка.СчетФактураПолученный"));
		ТаблицаСФ.Колонки.Добавить("НомерСФ",         Новый ОписаниеТипов("Строка"));
		ТаблицаСФ.Колонки.Добавить("ДатаСФ",          Новый ОписаниеТипов("Дата"));
		ТаблицаСФ.Колонки.Добавить("Контрагент",      Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		ТаблицаСФ.Колонки.Добавить("БланкСтрогойОтчетности",Новый ОписаниеТипов("Булево"));
		ТаблицаСФ.Колонки.Добавить("Проведен",        Новый ОписаниеТипов("Булево"));
		ТаблицаСФ.Колонки.Добавить("ПометкаУдаления", Новый ОписаниеТипов("Булево"));
		
	КонецЕсли;
	
	ТаблицаСФ.Колонки.Добавить("Использован", Новый ОписаниеТипов("Булево"));
	Возврат ТаблицаСФ;

КонецФункции

Функция ДанныеСчетовФактурПоДокументу(ДокументОбъект)

	ДанныеСчетовФактур = ДокументОбъект.Израсходовано.ВыгрузитьКолонки(
		"Контрагент,НомерСФ,ДатаСФ,СчетФактура,БланкСтрогойОтчетности,КФО,КПС,Сумма,СтавкаНДС,СуммаНДС,НДСКРаспределению,СчетУчетаНДС,Количество,СчетКредита");
	ДанныеСчетовФактур.Колонки.Добавить("ВидЦенности", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыЦенностейНДС"));
	ДанныеСчетовФактур.Колонки.Добавить("НФА",         Новый ОписаниеТипов("СправочникСсылка.Номенклатура,СправочникСсылка.ОсновныеСредства,Строка"));
	ДанныеСчетовФактур.Колонки.Добавить("Всего",       ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 2));
	ДанныеСчетовФактур.Колонки.Добавить("ЕдиницаИзмерения",	Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ДанныеСчетовФактур.Колонки.Найти("КПС").Имя				= "КПСВычетКт";
	ДанныеСчетовФактур.Колонки.Найти("СчетУчетаНДС").Имя	= "СчетВычетКт";
	
	ЕдиницаИзмеренияШт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	
	Для каждого СтрокаТабличнойЧасти Из ДокументОбъект.Израсходовано Цикл
		
		Если НЕ СтрокаТабличнойЧасти.ПредъявленСФ Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДанныеСчетовФактур.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТабличнойЧасти);
		
		// ВидЦенности
		НоваяСтрока.ВидЦенности = ВидЦенностиПоСчетуДебета(СтрокаТабличнойЧасти.СчетДебета);
		
		// НФА
		СвойстваСчетаДебета  = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТабличнойЧасти.СчетДебета);
		АналитикаСчетаДебета = Новый Соответствие;
		АналитикаСчетаДебета.Вставить(СвойстваСчетаДебета.ВидСубконто1, СтрокаТабличнойЧасти.СубконтоДебета1);
		АналитикаСчетаДебета.Вставить(СвойстваСчетаДебета.ВидСубконто2, СтрокаТабличнойЧасти.СубконтоДебета2);
		АналитикаСчетаДебета.Вставить(СвойстваСчетаДебета.ВидСубконто3, СтрокаТабличнойЧасти.СубконтоДебета3);
		
		НФА = Неопределено;
		ЕдиницаИзмерения = ЕдиницаИзмеренияШт; // шт.
		
		Если НоваяСтрока.ВидЦенности = Перечисления.ВидыЦенностейНДС.Материалы Тогда
			
			НФА = АналитикаСчетаДебета.Получить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
			ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НФА, "ЕдиницаИзмерения");
			
		ИначеЕсли НоваяСтрока.ВидЦенности = Перечисления.ВидыЦенностейНДС.ОС Тогда
			
			НФА = АналитикаСчетаДебета.Получить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
			
		КонецЕсли;
		
		НоваяСтрока.НФА = ?(НФА = Неопределено, СтрокаТабличнойЧасти.КомуЗаЧто, НФА);
		
		НоваяСтрока["ЕдиницаИзмерения"] = ЕдиницаИзмерения;
		
		// Рассчитываем значения "Сумма без НДС", "Всего":
		Если ДокументОбъект["СуммаВключаетНДС"] Тогда
			НоваяСтрока["Сумма"] = СтрокаТабличнойЧасти["Сумма"] - СтрокаТабличнойЧасти["СуммаНДС"];
		КонецЕсли;
		
		НоваяСтрока["Всего"] = НоваяСтрока["Сумма"] + НоваяСтрока["СуммаНДС"];
		
		НоваяСтрока["СчетВычетКт"] = СтрокаТабличнойЧасти["СчетУчетаНДС"];
		НоваяСтрока["КПСВычетКт"] = СтрокаТабличнойЧасти["КПС"];
		
	КонецЦикла;
	
	Возврат ДанныеСчетовФактур;

КонецФункции

Функция НайтиСтрокуСчетаФактуры(ТаблицаСФ, СтрокаДокумента)

	СтруктураПоиска = Новый Структура(ПолучитьИменаПолейПоискаСФвТабличнойЧасти());
	
	ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаДокумента);
	
	Если ЗначениеЗаполнено(СтрокаДокумента.СчетФактура) Тогда
		СтруктураПоиска.Вставить("Ссылка", СтрокаДокумента.СчетФактура);
		
		НайденныеСтроки = ТаблицаСФ.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			Возврат НайденныеСтроки[0];
		КонецЕсли;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура(ПолучитьИменаПолейПоискаСФвТабличнойЧасти());
	
	ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаДокумента);
		
	НайденныеСтроки = ТаблицаСФ.НайтиСтроки(СтруктураПоиска);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат НайденныеСтроки[0];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ВидЦенностиПоСчетуДебета(Счет)
	
	Если НЕ ЗначениеЗаполнено(Счет) Тогда
		Возврат Перечисления.ВидыЦенностейНДС.Прочее;
	КонецЕсли;
	
	Если ТипЗнч(Счет) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		КодСчета = Лев(Счет.Код,3);
		Если КодСчета = "105" Тогда
			Возврат Перечисления.ВидыЦенностейНДС.Материалы;
		ИначеЕсли КодСчета = "106" Тогда
			Возврат Перечисления.ВидыЦенностейНДС.ОС;
		ИначеЕсли КодСчета = "206" Тогда
			Возврат Перечисления.ВидыЦенностейНДС.Аванс;
		ИначеЕсли КодСчета = "109" ИЛИ КодСчета = "401" Тогда
			Возврат Перечисления.ВидыЦенностейНДС.Услуги;
		Иначе
			Возврат Перечисления.ВидыЦенностейНДС.Прочее;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Перечисления.ВидыЦенностейНДС.Прочее;
	
КонецФункции

Функция ЗаполнитьСчетФактуруПоАвансовомуОтчету(ДокументСФ, ДокументОбъект, ДокументСсылка, СтрокаТаблицы, ТаблицаНФА)
	
	// Шапка
	ЗаполнитьЗначенияСвойств(ДокументСФ, ДокументОбъект, "Дата,Организация,Подразделение,ИФО,СуммаВключаетНДС");
	
	ДокументСФ.Контрагент               = СтрокаТаблицы.Контрагент;
	ДокументСФ.НомерПервичногоДокумента = СтрокаТаблицы.НомерСФ;
	ДокументСФ.ДатаПервичногоДокумента  = СтрокаТаблицы.ДатаСФ;
	
	ДокументСФ.БланкСтрогойОтчетности   = СтрокаТаблицы.БланкСтрогойОтчетности;
	ДокументСФ.КодСпособаВыставления    = 1;
	Если НЕ ЗначениеЗаполнено(ДокументСФ.ДатаПервичногоДокумента) ИЛИ ДокументСФ.ДатаПервичногоДокумента >= '20150101' Тогда
		ДокументСФ.КодВидаОперации        = "23";
		ДокументСФ.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Покупка;
	Иначе
		Если ДокументСФ.ВидЦенности = Перечисления.ВидыЦенностейНДС.Аванс Тогда
			ДокументСФ.КодВидаОперации        = "02";
			ДокументСФ.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансВыданный;
		Иначе
			ДокументСФ.КодВидаОперации        = "01";
			ДокументСФ.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Покупка;
		КонецЕсли;
	КонецЕсли;
	ДокументСФ.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	ДокументСФ.Комментарий     = "Создан автоматически на основании авансового отчета.";
	
	// Табличная часть "Состав НФА"
	ДокументСФ.СоставНФА.Очистить();
	
	Поиск = Новый Структура("Контрагент, НомерСФ, ДатаСФ, БланкСтрогойОтчетности");
	ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
	
	МассивСтрокНФА = ТаблицаНФА.НайтиСтроки(Поиск);
	Для Каждого СтрокаНФА Из МассивСтрокНФА Цикл
		
		НоваяСтрока = ДокументСФ.СоставНФА.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаНФА);
		НоваяСтрока.Счет30304         = ПланыСчетов.ЕПСБУ.НайтиПоКоду("303.04");
		НоваяСтрока.ДокументОснование = ДокументСсылка;
		НоваяСтрока.НДСКВычету        = Истина;
		НоваяСтрока.СчетРасчетов      = СтрокаНФА.СчетКредита;
		
		ДокументСФ.ВидЦенности = СтрокаНФА.ВидЦенности; // один вид ценности в СФ
		
	КонецЦикла;
	
	Если ДокументСФ.ЭтоНовый() Тогда
		ДокументСФ.Записать(); // запишем, чтобы можно было использовать Ссылку
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура УстановитьСФТиповуюОперациюПоУмолчанию(ДокументОбъектСФ)
	
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(ДокументОбъектСФ));
	ТиповаяОперация = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(ИдентификаторДокумента);
	Если ЗначениеЗаполнено(ТиповаяОперация) Тогда
	    ДополнительныеРеквизиты = БухгалтерскиеОперацииСервер.РеквизитыТиповойОперацииПоУмолчанию(ИдентификаторДокумента,ТиповаяОперация,ДокументОбъектСФ.Организация);
	    БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(ДокументОбъектСФ, ТиповаяОперация, ДополнительныеРеквизиты);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура ДобавитьСтрокиЗачтенныхАвансов(ТаблицаРасчетов, НераспределеннаяСумма, НераспределеннаяСуммаПоОтчету, ОстаткиАвансов, СтрокаДокумента)

	Знак = 1;
	
	Для Каждого СтрокаОстатка Из ОстаткиАвансов Цикл
		
		Если НераспределеннаяСумма <= 0 И НераспределеннаяСуммаПоОтчету <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		ЗачитываемыйАванс = Мин(НераспределеннаяСумма, Знак * СтрокаОстатка.СуммаРасчетов);
		ЗачитываемыйАвансПоОтчету = Мин(НераспределеннаяСуммаПоОтчету, Знак * СтрокаОстатка.СуммаРасчетовПоОтчету);
		Если ЗачитываемыйАванс <= 0 И ЗачитываемыйАвансПоОтчету <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРасчетов = ТаблицаРасчетов.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаДокумента);
		
		Если НераспределеннаяСумма > 0 И ЗачитываемыйАванс > 0 Тогда
			
			СтрокаРасчетов.ОстатокРасчетов = Знак * СтрокаОстатка.СуммаРасчетов;
			СтрокаРасчетов.СуммаРасчетов   = ЗачитываемыйАванс;
			
			КоэффициентКурсаАванса = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаОстатка.СуммаРасчетов = 0, 0, СтрокаОстатка.РублевыйЭквивалент / СтрокаОстатка.СуммаРасчетов));
			
			КоэффициентРуб = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаДокумента.СуммаРасчетов = 0, 0, СтрокаДокумента.РублевыйЭквивалент / СтрокаДокумента.СуммаРасчетов));
			
			СтрокаРасчетов.СуммаРубПоКурсуАванса = Окр(ЗачитываемыйАванс * КоэффициентКурсаАванса, 2);
			СтрокаРасчетов.РублевыйЭквивалент    = Окр(ЗачитываемыйАванс * КоэффициентРуб, 2);
			
			НераспределеннаяСумма = НераспределеннаяСумма - ЗачитываемыйАванс;
			
			СтрокаОстатка.СуммаРасчетов          = СтрокаОстатка.СуммаРасчетов - Знак * СтрокаРасчетов.СуммаРасчетов;
			СтрокаОстатка.РублевыйЭквивалент     = СтрокаОстатка.РублевыйЭквивалент      - Знак * СтрокаРасчетов.СуммаРубПоКурсуАванса;
			
		КонецЕсли;
		
		Если НераспределеннаяСуммаПоОтчету > 0 И ЗачитываемыйАвансПоОтчету > 0 Тогда
			
			СтрокаРасчетов.ОстатокРасчетовПоОтчету = Знак * СтрокаОстатка.СуммаРасчетовПоОтчету;
			СтрокаРасчетов.СуммаРасчетовПоОтчету   = ЗачитываемыйАвансПоОтчету;
			
			КоэффициентКурсаАванса = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаОстатка.СуммаРасчетовПоОтчету = 0, 0, СтрокаОстатка.РублевыйЭквивалентПоОтчету / СтрокаОстатка.СуммаРасчетовПоОтчету));
			
			КоэффициентРуб = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаДокумента.СуммаРасчетовПоОтчету = 0, 0, СтрокаДокумента.РублевыйЭквивалентПоОтчету / СтрокаДокумента.СуммаРасчетовПоОтчету));
			
			СтрокаРасчетов.СуммаРубПоКурсуАвансаПоОтчету = Окр(ЗачитываемыйАвансПоОтчету * КоэффициентКурсаАванса, 2);
			СтрокаРасчетов.РублевыйЭквивалентПоОтчету    = Окр(ЗачитываемыйАвансПоОтчету * КоэффициентРуб, 2);
			
			НераспределеннаяСуммаПоОтчету = НераспределеннаяСуммаПоОтчету - ЗачитываемыйАвансПоОтчету;
			
			СтрокаОстатка.СуммаРасчетовПоОтчету          = СтрокаОстатка.СуммаРасчетовПоОтчету - Знак * СтрокаРасчетов.СуммаРасчетовПоОтчету;
			СтрокаОстатка.РублевыйЭквивалентПоОтчету     = СтрокаОстатка.РублевыйЭквивалентПоОтчету      - Знак * СтрокаРасчетов.СуммаРубПоКурсуАвансаПоОтчету;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСтрокуЗадолженности(ТаблицаРасчетов, НераспределеннаяСумма, НераспределеннаяСуммаПоОтчету, СтрокаДокумента)

	Если НераспределеннаяСумма <= 0 И НераспределеннаяСуммаПоОтчету <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРасчетов = ТаблицаРасчетов.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаДокумента);
	
	Если НераспределеннаяСумма > 0 Тогда
		
		СтрокаРасчетов.СуммаРасчетов = НераспределеннаяСумма;
		
		КоэффициентРуб = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
		?(СтрокаДокумента.СуммаРасчетов = 0, 0, СтрокаДокумента.РублевыйЭквивалент / СтрокаДокумента.СуммаРасчетов));
		
		СтрокаРасчетов.РублевыйЭквивалент    = Окр(НераспределеннаяСумма * КоэффициентРуб, 2);
		СтрокаРасчетов.СуммаРубПоКурсуАванса = СтрокаРасчетов.РублевыйЭквивалент;
		
	КонецЕсли;
	
	Если НераспределеннаяСуммаПоОтчету > 0 Тогда
		
		СтрокаРасчетов.СуммаРасчетовПоОтчету = НераспределеннаяСуммаПоОтчету;
		
		КоэффициентРуб = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
		?(СтрокаДокумента.СуммаРасчетовПоОтчету = 0, 0, СтрокаДокумента.РублевыйЭквивалентПоОтчету / СтрокаДокумента.СуммаРасчетовПоОтчету));
		
		СтрокаРасчетов.РублевыйЭквивалентПоОтчету    = Окр(НераспределеннаяСуммаПоОтчету * КоэффициентРуб, 2);
		СтрокаРасчетов.СуммаРубПоКурсуАвансаПоОтчету = СтрокаРасчетов.РублевыйЭквивалентПоОтчету;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СчетаОшибокПрошлыхЛет(Организация, Дата, ПорядокИсправленияОшибок, ВыявительОшибки)
	
	ДанныеСчетов = Новый Соответствие;
	
	Если Дата < '20210101' Тогда
		
		Если ПорядокИсправленияОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода Тогда
			
			ДанныеСчетов.Вставить("401.10", "401.18");
			ДанныеСчетов.Вставить("401.20", "401.28");
			ДанныеСчетов.Вставить("304.04", "304.84");
			ДанныеСчетов.Вставить("304.06", "304.86");
			
			СчетКорКод = "304.86";
			
		ИначеЕсли ПорядокИсправленияОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода Тогда
			
			ДанныеСчетов.Вставить("401.10", "401.19");
			ДанныеСчетов.Вставить("401.20", "401.29");
			ДанныеСчетов.Вставить("304.04", "304.94");
			ДанныеСчетов.Вставить("304.06", "304.96");
			
			СчетКорКод = "304.96";
			
		Иначе
			
			Возврат Неопределено;
			
		КонецЕсли;
		
	Иначе
		
		Если ПорядокИсправленияОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода
			И ВыявительОшибки = Перечисления.ВыявительОшибокПрошлыхЛет.Самостоятельно Тогда
			
			ДанныеСчетов.Вставить("401.10", "401.18");
			ДанныеСчетов.Вставить("401.20", "401.28");
			ДанныеСчетов.Вставить("304.06", "304.86");
			
			СчетКорКод = "304.86";
			
		ИначеЕсли ПорядокИсправленияОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода
			И ВыявительОшибки = Перечисления.ВыявительОшибокПрошлыхЛет.ОрганКонтроля Тогда
			
			ДанныеСчетов.Вставить("401.10", "401.16");
			ДанныеСчетов.Вставить("401.20", "401.26");
			ДанныеСчетов.Вставить("304.06", "304.66");
			
			СчетКорКод = "304.66";
			
		ИначеЕсли ПорядокИсправленияОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода
			И ВыявительОшибки = Перечисления.ВыявительОшибокПрошлыхЛет.Самостоятельно Тогда
			
			ДанныеСчетов.Вставить("401.10", "401.19");
			ДанныеСчетов.Вставить("401.20", "401.29");
			ДанныеСчетов.Вставить("304.06", "304.96");
			
			СчетКорКод = "304.96";
			
		ИначеЕсли ПорядокИсправленияОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода
			И ВыявительОшибки = Перечисления.ВыявительОшибокПрошлыхЛет.ОрганКонтроля Тогда
			
			ДанныеСчетов.Вставить("401.10", "401.17");
			ДанныеСчетов.Вставить("401.20", "401.27");
			ДанныеСчетов.Вставить("304.06", "304.76");
			
			СчетКорКод = "304.76";
			
		Иначе
			
			Возврат Неопределено;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаменаСчетов = Новый Соответствие;
	Для Каждого СтрокаСчета Из ДанныеСчетов Цикл
		Счет1 = БухгалтерскийУчет.СчетПоКоду(СтрокаСчета.Ключ, Дата);
		Если Не ЗначениеЗаполнено(Счет1) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Счет2 = БухгалтерскийУчет.СчетПоКоду(СтрокаСчета.Значение, Дата);
		Если Не ЗначениеЗаполнено(Счет2) Тогда
			Возврат Неопределено;
		КонецЕсли;
		ЗаменаСчетов.Вставить(Счет1, Счет2);
	КонецЦикла;
	
	СчетКор = БухгалтерскийУчет.СчетПоКоду(СчетКорКод, Дата);
	Если Не ЗначениеЗаполнено(СчетКор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КодСтатьи = КодСтатьиОрганизации(Организация, Дата);
	КЭКСчетКорДт = БухгалтерскийУчетПовтИсп.КЭКПоКоду("83" + КодСтатьи);
	КЭКСчетКорКт = БухгалтерскийУчетПовтИсп.КЭКПоКоду("73" + КодСтатьи);
	
	Результат = Новый Структура;
	Результат.Вставить("ЗаменаСчетов", ЗаменаСчетов);
	Результат.Вставить("СчетКор", СчетКор);
	Результат.Вставить("КЭКСчетКорДт", КЭКСчетКорДт);
	Результат.Вставить("КЭКСчетКорКт", КЭКСчетКорКт);
	
	Возврат Результат;
	
КонецФункции

Функция КодСтатьиОрганизации(Организация, Дата)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат "0";
	КонецЕсли;
	
	ТипПланаСчетов = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Организация, Дата).СтруктураРПС.ТипПланаСчетов;
	
	Если Не ЗначениеЗаполнено(ТипПланаСчетов) Тогда
		КодСтатьи = "0";
	ИначеЕсли ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляКазенных") Тогда
		КодСтатьи = "1";
	Иначе
		КодСтатьи = "2";
	КонецЕсли;
	
	Возврат КодСтатьи;
	
КонецФункции

