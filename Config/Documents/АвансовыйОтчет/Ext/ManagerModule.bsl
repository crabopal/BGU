	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	
	Результат = Запрос.Выполнить();
	
	ВыборкаАО = Результат.Выбрать();
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаАО.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		ТабАванс.Очистить();
		ТабОстатокПерерасход.Очистить();
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка Из Результат.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, ВыборкаАО[Колонка.Имя]);
		КонецЦикла;
		
		Сотрудники = Новый Массив;
		Сотрудники.Добавить(СтруктураДанных.Сотрудник);
		Сотрудники.Добавить(СтруктураДанных.Руководитель);
		Сотрудники.Добавить(СтруктураДанных.ГлБухгалтер);
		Сотрудники.Добавить(СтруктураДанных.РуководительПодразделения);
		Сотрудники.Добавить(СтруктураДанных.Бухгалтер);
		Сотрудники.Добавить(СтруктураДанных.БухгалтерКассир);
		
		ТребуемыеДанные = Новый Массив;
		ТребуемыеДанные.Добавить("Фамилия");
		ТребуемыеДанные.Добавить("Имя");
		ТребуемыеДанные.Добавить("Отчество");
		ТребуемыеДанные.Добавить("Должность");
		
		СтруктураФИО = Новый Структура;
		СтруктураФИО.Вставить("Фамилия");
		СтруктураФИО.Вставить("Имя");
		СтруктураФИО.Вставить("Отчество");
		
		ДанныеСотрудников = Справочники.Сотрудники.ПолучитьДанныеСотрудников(Сотрудники,ТребуемыеДанные,СтруктураДанных.Дата);
		
		Если ЗначениеЗаполнено(СтруктураДанных.Сотрудник) Тогда
			ДанныеСотрудника = ДанныеСотрудников.Найти(СтруктураДанных.Сотрудник, "Ссылка");
			СтруктураФИО.Вставить("Фамилия", 	ДанныеСотрудника.Фамилия);
			СтруктураФИО.Вставить("Имя", 		ДанныеСотрудника.Имя);
			СтруктураФИО.Вставить("Отчество", 	ДанныеСотрудника.Отчество);
			СтруктураДанных.Вставить("СотрудникФамилия", 			ДанныеСотрудника.Фамилия);
			СтруктураДанных.Вставить("СотрудникИмя", 				ДанныеСотрудника.Имя);
			СтруктураДанных.Вставить("СотрудникОтчество", 			ДанныеСотрудника.Отчество);
			СтруктураДанных.Вставить("СотрудникДолжность", 			ДанныеСотрудника.Должность);
			СтруктураДанных.Вставить("СотрудникИнициалыФамилия", 	КорреспондентыКлиентСервер.ФИО(СтруктураФИО, Истина));
			
			Если НЕ ЗначениеЗаполнено(СтруктураДанных.СотрудникПринятоОт) Тогда
				СтруктураДанных.СотрудникПринятоОт = ДанныеСотрудника.Фамилия + " " + ДанныеСотрудника.Имя + " " + ДанныеСотрудника.Отчество;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураДанных.Руководитель) Тогда
			ДанныеСотрудника = ДанныеСотрудников.Найти(СтруктураДанных.Руководитель, "Ссылка");
			СтруктураФИО.Вставить("Фамилия", 	ДанныеСотрудника.Фамилия);
			СтруктураФИО.Вставить("Имя", 		ДанныеСотрудника.Имя);
			СтруктураФИО.Вставить("Отчество", 	ДанныеСотрудника.Отчество);
			СтруктураДанных.Вставить("РуководительФамилия", 		ДанныеСотрудника.Фамилия);
			СтруктураДанных.Вставить("РуководительИмя", 			ДанныеСотрудника.Имя);
			СтруктураДанных.Вставить("РуководительОтчество", 		ДанныеСотрудника.Отчество);
			СтруктураДанных.Вставить("РуководительИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(СтруктураФИО, Истина));
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураДанных.ГлБухгалтер) Тогда
			ДанныеСотрудника = ДанныеСотрудников.Найти(СтруктураДанных.ГлБухгалтер, "Ссылка");
			СтруктураФИО.Вставить("Фамилия", 	ДанныеСотрудника.Фамилия);
			СтруктураФИО.Вставить("Имя", 		ДанныеСотрудника.Имя);
			СтруктураФИО.Вставить("Отчество", 	ДанныеСотрудника.Отчество);
			СтруктураДанных.Вставить("ГлБухгалтерФамилия", 			ДанныеСотрудника.Фамилия);
			СтруктураДанных.Вставить("ГлБухгалтерИмя", 				ДанныеСотрудника.Имя);
			СтруктураДанных.Вставить("ГлБухгалтерОтчество", 		ДанныеСотрудника.Отчество);
			СтруктураДанных.Вставить("ГлБухгалтерИнициалыФамилия", 	КорреспондентыКлиентСервер.ФИО(СтруктураФИО, Истина));
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураДанных.РуководительПодразделения) Тогда
