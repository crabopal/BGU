// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_АвансовыйОтчет") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_АвансовыйОтчет",
			"Авансовый отчет (ф. 0504049)", ПечатьАвансовогоОтчета(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АвансовыйОтчет"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_АвансовыйОтчет0504505") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_АвансовыйОтчет0504505",
			"Авансовый отчет (ф. 0504505)", ПечатьАвансовогоОтчета(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АвансовыйОтчет0504505"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдерМ4") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПриходныйОрдерМ4",
			"Приходный ордер (М-4)", ПечатьПриходногоОрдераМ4(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207",
			"Приходный ордер (ф. 0504207)", ПечатьПриходногоОрдера0504207(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПриходныйОрдер0504207"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_103н",
			"Приходный ордер (ф. 0504207)", ПечатьПриходногоОрдера0504207(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПриходныйОрдер0504207_103н"));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъектов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содержащая печатные формы документов
//
Функция ПечатьАвансовогоОтчета(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_АвансовыйОтчет";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.АвансовыйОтчет." + ИмяМакета);
	
	ТабАванс = Новый ТаблицаЗначений;
	ТабАванс.Колонки.Добавить("НаименованиеПоказателя", 					Новый ОписаниеТипов("Строка"));
	ТабАванс.Колонки.Добавить("НаименованиеПоказателяПервичныйДокумент", 	Новый ОписаниеТипов("Строка"));
	ТабАванс.Колонки.Добавить("СуммаАвансаВРубляхСПокрытиемРасчетная", 		Новый ОписаниеТипов("Число"));
	ТабАванс.Колонки.Добавить("СуммаАвансаВРубляхСПокрытиемБухгалтерская", 	Новый ОписаниеТипов("Число"));
	ТабАванс.Колонки.Добавить("СуммаАвансаВРублях", 						Новый ОписаниеТипов("Число"));
	ТабАванс.Колонки.Добавить("СуммаАвансаВВалюте", 						Новый ОписаниеТипов("Число"));
	ТабАванс.Колонки.Добавить("ВыданАвансДебет", 							Новый ОписаниеТипов("Строка"));
	ТабАванс.Колонки.Добавить("ВыданАвансКредит", 							Новый ОписаниеТипов("Строка"));
	ТабАванс.Колонки.Добавить("СуммаБухгалтерскаяРасчетная", 				Новый ОписаниеТипов("Число"));
	ТабАванс.Колонки.Добавить("СуммаБухгалтерская", 							Новый ОписаниеТипов("Число"));
	ТабАванс.Колонки.Добавить("ИзрасходованоДебет",							Новый ОписаниеТипов("Строка"));
	ТабАванс.Колонки.Добавить("ИзрасходованоКредит",						Новый ОписаниеТипов("Строка"));
	ТабАванс.Колонки.Добавить("СуммаВРубляхПоКурсуАванса",					Новый ОписаниеТипов("Число"));
	
	ТабОстатокПерерасход = Новый ТаблицаЗначений;
	ТабОстатокПерерасход.Колонки.Добавить("ОстатокПерерасходНомерСчета", 			Новый ОписаниеТипов("Строка"));
	ТабОстатокПерерасход.Колонки.Добавить("ВнесенОстатокВРублях", 					Новый ОписаниеТипов("Число"));
	ТабОстатокПерерасход.Колонки.Добавить("ВнесенОстатокВВалюте", 					Новый ОписаниеТипов("Число"));
	ТабОстатокПерерасход.Колонки.Добавить("ВнесенОстатокВРубляхСПокрытиемБух", 		Новый ОписаниеТипов("Число"));
	ТабОстатокПерерасход.Колонки.Добавить("ВнесенОстатокВРубляхСПокрытиемРасч", 	Новый ОписаниеТипов("Число"));
	ТабОстатокПерерасход.Колонки.Добавить("ВыданПерерасходВРублях", 				Новый ОписаниеТипов("Число"));
	ТабОстатокПерерасход.Колонки.Добавить("ВыданПерерасходВВалюте", 				Новый ОписаниеТипов("Число"));
	ТабОстатокПерерасход.Колонки.Добавить("ВыданПерерасходВРубляхСПокрытиемБух", 	Новый ОписаниеТипов("Число"));
	ТабОстатокПерерасход.Колонки.Добавить("ВыданПерерасходВРубляхСПокрытиемРасч", 	Новый ОписаниеТипов("Число"));
	ТабОстатокПерерасход.Колонки.Добавить("НомерОрдера", 							Новый ОписаниеТипов("Строка"));
	ТабОстатокПерерасход.Колонки.Добавить("ДатаОрдера", 							Новый ОписаниеТипов("Дата"));
	ТабОстатокПерерасход.Колонки.Добавить("НомерПервичногоДокумента", 				Новый ОписаниеТипов("Строка"));
	ТабОстатокПерерасход.Колонки.Добавить("ДатаПервичногоДокумента", 				Новый ОписаниеТипов("Дата"));
	// Колонка необходима для приведения номера регистратора к выбранному виду настройки номера при печати
	ТабОстатокПерерасход.Колонки.Добавить("Регистратор");
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	Запрос.УстановитьПараметр("КодВалютыРеглУчета",
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запрос.Параметры.ВалютаРеглУчета, "Код"));
	Запрос.УстановитьПараметр("Счет208", БухгалтерскийУчет.СписокСчетов("208.00"));
	Запрос.УстановитьПараметр("СчетКор", БухгалтерскийУчет.СписокСчетов("201.00,210.00,304.00,000"));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АвансовыйОтчетИзрасходовано.Ссылка КАК Ссылка,
	|	АвансовыйОтчетИзрасходовано.НомерСтроки КАК НомерСтроки,
	|	АвансовыйОтчетИзрасходовано.ДокументДата КАК ДокументДата,
	|	АвансовыйОтчетИзрасходовано.ДокументНомер КАК ДокументНомер,
	|	АвансовыйОтчетИзрасходовано.КомуЗаЧто КАК КомуЗаЧто,
	|	АвансовыйОтчетИзрасходовано.КФО КАК КФО,
	|	АвансовыйОтчетИзрасходовано.КПС КАК КПС,
	|	ВЫБОР
	|		КОГДА АвансовыйОтчетИзрасходовано.КПСДт = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|			ТОГДА АвансовыйОтчетИзрасходовано.КПС
	|		ИНАЧЕ АвансовыйОтчетИзрасходовано.КПСДт
	|	КОНЕЦ КАК КПСДт,
	|	АвансовыйОтчетИзрасходовано.КЭК КАК КЭК,
	|	АвансовыйОтчетИзрасходовано.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ВЫБОР
	|		КОГДА АвансовыйОтчетИзрасходовано.Ссылка.СуммаВключаетНДС
	|			ТОГДА АвансовыйОтчетИзрасходовано.Сумма - АвансовыйОтчетИзрасходовано.СуммаНДС
	|		ИНАЧЕ АвансовыйОтчетИзрасходовано.Сумма
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА АвансовыйОтчетИзрасходовано.ПредъявленСФ
	|			ТОГДА АвансовыйОтчетИзрасходовано.СуммаНДС
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаНДС,
	|	АвансовыйОтчетИзрасходовано.СуммаВВалюте КАК СуммаВВалюте,
	|	АвансовыйОтчетИзрасходовано.СуммаПоОтчету КАК СуммаПоОтчету,
	|	АвансовыйОтчетИзрасходовано.СуммаВВалютеПоОтчету КАК СуммаВВалютеПоОтчету,
