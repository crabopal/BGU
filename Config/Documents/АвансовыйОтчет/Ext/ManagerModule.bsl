		Стр.СуммаАвансаВРублях 							= СтруктураДанных.ИзрасходованоРуб + СтруктураДанных.ИзрасходованоНДС;
		Стр.СуммаАвансаВВалюте 							= СтруктураДанных.ИзрасходованоВал;
		Стр.СуммаАвансаВРубляхСПокрытиемРасчетная 		= СтруктураДанных.ИзрасходованоРуб + СтруктураДанных.ИзрасходованоСуммаПокрытия + СтруктураДанных.ИзрасходованоНДС;	
		Стр.СуммаАвансаВРубляхСПокрытиемБухгалтерская 	= СтруктураДанных.ИзрасходованоРубПоКурсуАванса;
		
		СуммаРезультатРуб 							= СтруктураДанных.ОстатокПредыдущегоАванса - СтруктураДанных.ПерерасходПредыдущегоАванса + СтруктураДанных.ПолученоРуб - СтруктураДанных.ИзрасходованоРуб - СтруктураДанных.ИзрасходованоНДС;
		СуммаРезультатРубСПокрытиемРасчетная 		= СтруктураДанных.ОстатокПредыдущегоАванса - СтруктураДанных.ПерерасходПредыдущегоАванса + СтруктураДанных.ПолученоРуб + СтруктураДанных.СуммаПокрытияРасчетная - СтруктураДанных.ИзрасходованоРуб - СтруктураДанных.ИзрасходованоНДС - СтруктураДанных.ИзрасходованоСуммаПокрытия;
		СуммаРезультатРубСПокрытиемБухгалтерская 	= СтруктураДанных.ОстатокПредыдущегоАванса - СтруктураДанных.ПерерасходПредыдущегоАванса + СтруктураДанных.ПолученоРуб + СтруктураДанных.СуммаПокрытияБух - СтруктураДанных.ИзрасходованоРубПоКурсуАванса;
		
		СуммаРезультатВал = СтруктураДанных.ОстатокПредыдущегоАвансаВВалюте - СтруктураДанных.ПерерасходПредыдущегоАвансаВвалюте + СтруктураДанных.ПолученоВал - СтруктураДанных.ИзрасходованоВал;
		
		Стр = ТабАванс.Добавить();
		Стр.НаименованиеПоказателя 						= "Остаток";
		Стр.НаименованиеПоказателяПервичныйДокумент 	= "Остаток";
		Стр.СуммаАвансаВРублях 							= ?(СуммаРезультатРуб > 0, СуммаРезультатРуб, 0);
		Стр.СуммаАвансаВВалюте 							= ?(СуммаРезультатВал > 0, СуммаРезультатВал, 0);
		Стр.СуммаАвансаВРубляхСПокрытиемРасчетная 		= ?(СуммаРезультатРубСПокрытиемРасчетная > 0, СуммаРезультатРубСПокрытиемРасчетная, 0);
		Стр.СуммаАвансаВРубляхСПокрытиемБухгалтерская 	= ?(СуммаРезультатРубСПокрытиемБухгалтерская > 0, СуммаРезультатРубСПокрытиемБухгалтерская, 0);
		
		
		Стр = ТабАванс.Добавить();
		Стр.НаименованиеПоказателя 						= "Перерасход";
		Стр.НаименованиеПоказателяПервичныйДокумент 	= "Перерасход";
		Стр.СуммаАвансаВРублях 							= ?(СуммаРезультатРуб < 0, - СуммаРезультатРуб, 0);
		Стр.СуммаАвансаВВалюте 							= ?(СуммаРезультатВал < 0, - СуммаРезультатВал, 0);
		Стр.СуммаАвансаВРубляхСПокрытиемРасчетная 		= ?(СуммаРезультатРубСПокрытиемРасчетная < 0, - СуммаРезультатРубСПокрытиемРасчетная, 0);
		Стр.СуммаАвансаВРубляхСПокрытиемБухгалтерская   = ?(СуммаРезультатРубСПокрытиемБухгалтерская < 0, - СуммаРезультатРубСПокрытиемБухгалтерская, 0);
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.КФО,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СчетДт,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.КПСДт,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.КЭКДт,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СчетКт,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.КПСКт,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.КЭККт,
		|	СУММА(ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СуммаРуб) КАК СуммаРуб,
		|	СУММА(ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СуммаВал) КАК СуммаВал,
		|	СУММА(ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СуммаРуб + ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СуммаПокрытияБух) КАК СуммаПокрытияБух,
		|	СУММА(ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СуммаРуб + ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СуммаПокрытияРасчетная) КАК СуммаПокрытияРасчетная
		|ИЗ
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ КАК ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ
		|ГДЕ
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.КФО,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СчетДт,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.КПСДт,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.КЭКДт,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СчетКт,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.КПСКт,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.КЭККт";
		
		Запрос.УстановитьПараметр("Ссылка", СтруктураДанных.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Для Каждого Стр Из ТабАванс Цикл
			
			Если Выборка.Следующий() Тогда
				
				Стр.ВыданАвансДебет 			= УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(Выборка.КПСДт, Выборка.КФО, Выборка.СчетДт, Выборка.КЭКДт,, Истина);
				Стр.ВыданАвансКредит			= УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(Выборка.КПСКт, Выборка.КФО, Выборка.СчетКт, Выборка.КЭККт,, Истина);
				Стр.СуммаБухгалтерская   		= Выборка.СуммаПокрытияБух;
				Стр.СуммаБухгалтерскаяРасчетная = Выборка.СуммаПокрытияРасчетная;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Пока Выборка.Следующий() Цикл
			
			Стр = ТабАванс.Добавить();
			Стр.ВыданАвансДебет 			= УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(Выборка.КПСДт, Выборка.КФО, Выборка.СчетДт, Выборка.КЭКДт,, Истина);
			Стр.ВыданАвансКредит			= УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(Выборка.КПСКт, Выборка.КФО, Выборка.СчетКт, Выборка.КЭККт,, Истина);
			Стр.СуммаБухгалтерская   		= Выборка.СуммаПокрытияБух;
			Стр.СуммаБухгалтерскаяРасчетная = Выборка.СуммаПокрытияРасчетная;
			
		КонецЦикла;
		
		СтруктураДанных.Вставить("ИтогоСуммаБухгалтерская", ТабАванс.Итог("СуммаБухгалтерская"));
		СтруктураДанных.Вставить("ИтогоСуммаБухгалтерскаяРасчетная", ТабАванс.Итог("СуммаБухгалтерскаяРасчетная"));
		
		// Остаток/перерасход
		
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.ТипРегистратор
		|ИЗ
		|	ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ КАК ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Количество() > 0 Тогда 
			
			ДопТекстНомер 	= "
			|ВЫБОР";
			ДопТекстДата 	= "
			|ВЫБОР";
			
			Пока Выборка.Следующий() Цикл
				
				ИмяМетаданных = Метаданные.НайтиПоТипу(Выборка.ТипРегистратор).ПолноеИмя();
				
				ДопТекстНомер = ДопТекстНомер + "
				|	КОГДА ТИПЗНАЧЕНИЯ(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор) = ТИП(" + ИмяМетаданных + ")
				|		ТОГДА ВЫРАЗИТЬ(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор КАК " + ИмяМетаданных + ").Номер";
				
				ДопТекстДата = ДопТекстДата + "
				|	КОГДА ТИПЗНАЧЕНИЯ(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор) = ТИП(" + ИмяМетаданных + ")
				|		ТОГДА ВЫРАЗИТЬ(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор КАК " + ИмяМетаданных + ").Дата";
				
			КонецЦикла;
			
			ДопТекстНомер = ДопТекстНомер + "
			|	КОНЕЦ";
			
			ДопТекстДата = ДопТекстДата + "
			|	КОНЕЦ";
			
			Выборка.Сбросить();
			
			ДопТекстПервичныйНомер = "
			|ВЫБОР";
			ДопТекстПервичнаяДата = "
			|ВЫБОР";
			
			Пока Выборка.Следующий() Цикл
				
				ИмяМетаданных = Метаданные.НайтиПоТипу(Выборка.ТипРегистратор).ПолноеИмя();
				
				Если Выборка.ТипРегистратор = Тип("ДокументСсылка.КассовоеВыбытие") Тогда
					
					ДопТекстПервичныйНомер = ДопТекстПервичныйНомер + "
					|	КОГДА ТИПЗНАЧЕНИЯ(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор) = ТИП(" + ИмяМетаданных + ")
					|		ТОГДА ВЫРАЗИТЬ(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор КАК " + ИмяМетаданных + ").НомерПервичногоДокумента";
					
					ДопТекстПервичнаяДата = ДопТекстПервичнаяДата + "
					|	КОГДА ТИПЗНАЧЕНИЯ(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор) = ТИП(" + ИмяМетаданных + ")
					|		ТОГДА ВЫРАЗИТЬ(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор КАК " + ИмяМетаданных + ").ДатаПервичногоДокумента";
					
				ИначеЕсли Выборка.ТипРегистратор = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход")
					ИЛИ Выборка.ТипРегистратор = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная")
					ИЛИ Выборка.ТипРегистратор = Тип("ДокументСсылка.ПлатежноеПоручение")
					ИЛИ Выборка.ТипРегистратор = Тип("ДокументСсылка.РаспоряжениеОПеречисленииНаКартыМир") Тогда
					
					ДопТекстПервичныйНомер = ДопТекстПервичныйНомер + "
					|	КОГДА ТИПЗНАЧЕНИЯ(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор) = ТИП(" + ИмяМетаданных + ")
					|		ТОГДА СостояниеПлатежноРасчетныхДокументов.НомерПодтверждающегоДокумента";
					
					ДопТекстПервичнаяДата = ДопТекстПервичнаяДата + "
					|	КОГДА ТИПЗНАЧЕНИЯ(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор) = ТИП(" + ИмяМетаданных + ")
					|		ТОГДА СостояниеПлатежноРасчетныхДокументов.ДатаПодтверждающегоДокумента";
					
				Иначе
					
					ДопТекстПервичныйНомер = ДопТекстПервичныйНомер + "
					|	КОГДА ТИПЗНАЧЕНИЯ(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор) = ТИП(" + ИмяМетаданных + ")
					|		ТОГДА ВЫРАЗИТЬ(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор КАК " + ИмяМетаданных + ").Номер";
					
					ДопТекстПервичнаяДата = ДопТекстПервичнаяДата + "
					|	КОГДА ТИПЗНАЧЕНИЯ(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор) = ТИП(" + ИмяМетаданных + ")
					|		ТОГДА ВЫРАЗИТЬ(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор КАК " + ИмяМетаданных + ").Дата";
					
				КонецЕсли;
				
			КонецЦикла;
			
			ДопТекстПервичныйНомер = ДопТекстПервичныйНомер + "
			|	КОНЕЦ";
			
			ДопТекстПервичнаяДата = ДопТекстПервичнаяДата + "
			|	КОНЕЦ";
			
		Иначе
			ДопТекстНомер 	= "NULL";
			ДопТекстДата = "NULL";
			ДопТекстПервичныйНомер 	= "NULL";
			ДопТекстПервичнаяДата = "NULL";
		КонецЕсли;
		
		// Выдача перерасхода
		Запрос.Текст = "ВЫБРАТЬ
		|	ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.КФО,
		|	ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.СчетДт,
		|	ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.КПСДт,
		|	ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.КЭКДт,
		|	ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор КАК Регистратор,
		|   " + ДопТекстНомер + " КАК НомерОрдера,
		|   " + ДопТекстДата +  " КАК ДатаОрдера,
		|   " + ДопТекстПервичныйНомер + " КАК НомерПервичногоДокумента,
		|   " + ДопТекстПервичнаяДата +  " КАК ДатаПервичногоДокумента,
		|	СУММА(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.СуммаРуб) КАК СуммаРуб,
		|	СУММА(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.СуммаРуб + ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.СуммаПокрытияБух) КАК СуммаПокрытияБух,
		|	СУММА(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.СуммаРуб + ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.СуммаПокрытияРасчетная) КАК СуммаПокрытияРасчетная,
		|	СУММА(ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.СуммаВал) КАК СуммаВал
		|ИЗ
		|	ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ КАК ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
		|			ПО ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор = СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент
		|ГДЕ
		|	ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.КФО,
		|	ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.СчетДт,
		|	ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.КПСДт,
		|	ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.КЭКДт,
		|	ВЫДАНОПЕРЕРАСХОДАДВИЖЕНИЯ.Регистратор,
		|   " + ДопТекстНомер + ", 
		|   " + ДопТекстДата + ", 
		|   " + ДопТекстПервичныйНомер + ", 
		|   " + ДопТекстПервичнаяДата;
		
		Запрос.УстановитьПараметр("Ссылка", СтруктураДанных.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока  Выборка.Следующий() Цикл
			
			Стр = ТабОстатокПерерасход.Добавить();
			Стр.ОстатокПерерасходНомерСчета				= УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(Выборка.КПСДт, Выборка.КФО, Выборка.СчетДт, Выборка.КЭКДт,, Истина);
			Стр.НомерОрдера 							= Выборка.НомерОрдера;
			Стр.ДатаОрдера 								= Выборка.ДатаОрдера;
			Стр.НомерПервичногоДокумента 				= Выборка.НомерПервичногоДокумента;
			Стр.ДатаПервичногоДокумента 				= Выборка.ДатаПервичногоДокумента;
			Стр.ВыданПерерасходВРублях 					= Выборка.СуммаРуб;
			Стр.ВыданПерерасходВВалюте 					= Выборка.СуммаВал;
			Стр.ВыданПерерасходВРубляхСПокрытиемБух 	= Выборка.СуммаПокрытияБух;
			Стр.ВыданПерерасходВРубляхСПокрытиемРасч 	= Выборка.СуммаПокрытияРасчетная;
			Стр.Регистратор 							= Выборка.Регистратор;
			
		КонецЦикла;
		
		// Внесение остатка
		
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.ТипРегистратор
		|ИЗ
		|	ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ КАК ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Количество() > 0 Тогда 
			
			ДопТекстНомер 	= "
			|ВЫБОР";
			ДопТекстДата 	= "
			|ВЫБОР";
			
			Пока Выборка.Следующий() Цикл
				
				ИмяМетаданных = Метаданные.НайтиПоТипу(Выборка.ТипРегистратор).ПолноеИмя();
				
				ДопТекстНомер = ДопТекстНомер + "
				|	КОГДА ТИПЗНАЧЕНИЯ(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Регистратор) = ТИП(" + ИмяМетаданных + ")
				|		ТОГДА ВЫРАЗИТЬ(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Регистратор КАК " + ИмяМетаданных + ").Номер";
				
				ДопТекстДата = ДопТекстДата + "
				|	КОГДА ТИПЗНАЧЕНИЯ(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Регистратор) = ТИП(" + ИмяМетаданных + ")
				|		ТОГДА ВЫРАЗИТЬ(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Регистратор КАК " + ИмяМетаданных + ").Дата";
				
			КонецЦикла;
			
			ДопТекстНомер = ДопТекстНомер + "
			|	КОНЕЦ";
			
			ДопТекстДата = ДопТекстДата + "
			|	КОНЕЦ";
			
			Выборка.Сбросить();
			
			ДопТекстПервичныйНомер = "
			|ВЫБОР";
			ДопТекстПервичнаяДата = "
			|ВЫБОР";
			
			Пока Выборка.Следующий() Цикл
				
				ИмяМетаданных = Метаданные.НайтиПоТипу(Выборка.ТипРегистратор).ПолноеИмя();
				
				Если Выборка.ТипРегистратор = Тип("ДокументСсылка.КассовоеПоступление") Тогда
					
					ДопТекстПервичныйНомер = ДопТекстПервичныйНомер + "
					|	КОГДА ТИПЗНАЧЕНИЯ(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Регистратор) = ТИП(" + ИмяМетаданных + ")
					|		ТОГДА ВЫРАЗИТЬ(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Регистратор КАК " + ИмяМетаданных + ").НомерПервичногоДокумента";
					
					ДопТекстПервичнаяДата = ДопТекстПервичнаяДата + "
					|	КОГДА ТИПЗНАЧЕНИЯ(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Регистратор) = ТИП(" + ИмяМетаданных + ")
					|		ТОГДА ВЫРАЗИТЬ(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Регистратор КАК " + ИмяМетаданных + ").ДатаПервичногоДокумента";
					
				Иначе
					
					ДопТекстПервичныйНомер = ДопТекстПервичныйНомер + "
					|	КОГДА ТИПЗНАЧЕНИЯ(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Регистратор) = ТИП(" + ИмяМетаданных + ")
					|		ТОГДА ВЫРАЗИТЬ(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Регистратор КАК " + ИмяМетаданных + ").Номер";
					
					ДопТекстПервичнаяДата = ДопТекстПервичнаяДата + "
					|	КОГДА ТИПЗНАЧЕНИЯ(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Регистратор) = ТИП(" + ИмяМетаданных + ")
					|		ТОГДА ВЫРАЗИТЬ(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Регистратор КАК " + ИмяМетаданных + ").Дата";
					
				КонецЕсли;
				
			КонецЦикла;
			
			ДопТекстПервичныйНомер = ДопТекстПервичныйНомер + "
			|	КОНЕЦ";
			
			ДопТекстПервичнаяДата = ДопТекстПервичнаяДата + "
			|	КОНЕЦ";
			
		Иначе
			ДопТекстНомер 	= "NULL";
			ДопТекстДата = "NULL";
			ДопТекстПервичныйНомер 	= "NULL";
			ДопТекстПервичнаяДата = "NULL";
		КонецЕсли;
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.КФО,
		|	ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.СчетКт,
		|	ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.КПСКт,
		|	ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.КЭККт,
		|	ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Регистратор КАК Регистратор,
		|   " + ДопТекстНомер + " КАК НомерОрдера,
		|   " + ДопТекстДата +  " КАК ДатаОрдера,
		|   " + ДопТекстПервичныйНомер + " КАК НомерПервичногоДокумента,
		|   " + ДопТекстПервичнаяДата +  " КАК ДатаПервичногоДокумента,
		|	СУММА(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.СуммаРуб) КАК СуммаРуб,
		|	СУММА(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.СуммаВал) КАК СуммаВал,
		|	СУММА(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.СуммаРуб + ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.СуммаПокрытияБух) КАК СуммаПокрытияБух,
		|	СУММА(ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.СуммаРуб + ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.СуммаПокрытияРасчетная) КАК СуммаПокрытияРасчетная
		|ИЗ
		|	ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ КАК ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ
		|ГДЕ
		|	ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.КФО,
		|	ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.СчетКт,
		|	ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.КПСКт,
		|	ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.КЭККт,
		|	ПОЛУЧЕНОСТАТКАДВИЖЕНИЯ.Регистратор,
		|   " + ДопТекстНомер + ", 
		|   " + ДопТекстДата + ", 
		|   " + ДопТекстПервичныйНомер + ", 
		|   " + ДопТекстПервичнаяДата;
		
		Запрос.УстановитьПараметр("Ссылка", СтруктураДанных.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Стр = ТабОстатокПерерасход.Добавить();
			Стр.ОстатокПерерасходНомерСчета				= УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(
				Выборка.КПСКт, Выборка.КФО, Выборка.СчетКт, Выборка.КЭККт,, Истина);
			Стр.НомерОрдера 							= Выборка.НомерОрдера;
			Стр.ДатаОрдера 								= Выборка.ДатаОрдера;
			Стр.НомерПервичногоДокумента 				= Выборка.НомерПервичногоДокумента;
			Стр.ДатаПервичногоДокумента 				= Выборка.ДатаПервичногоДокумента;
			Стр.ВнесенОстатокВРублях 					= Выборка.СуммаРуб;
			Стр.ВнесенОстатокВВалюте 					= Выборка.СуммаВал;
			Стр.ВнесенОстатокВРубляхСПокрытиемБух	 	= Выборка.СуммаПокрытияБух;
			Стр.ВнесенОстатокВРубляхСПокрытиемРасч	 	= Выборка.СуммаПокрытияРасчетная;
			Стр.Регистратор 							= Выборка.Регистратор;
		КонецЦикла;
		
		// Исправление ошибок прошлых лет
		ИсправлениеОшибокПрошлыхЛет = ОперацииСИсправлениемОшибок.Найти(СтруктураДанных.Ссылка, "Документ");
		Если ИсправлениеОшибокПрошлыхЛет <> Неопределено Тогда
			ИсправлениеОшибокПрошлыхЛет = СчетаОшибокПрошлыхЛет(СтруктураДанных.Организация, СтруктураДанных.Дата,
				ИсправлениеОшибокПрошлыхЛет.ИсправлениеОшибки, ИсправлениеОшибокПрошлыхЛет.ВыявительОшибки);
		КонецЕсли;
		
		// Израсходовано
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ИЗРАСХОДОВАНО.НомерСтроки КАК НомерСтроки,
		|	ИЗРАСХОДОВАНО.ДокументДата КАК ДатаДокумента,
		|	ИЗРАСХОДОВАНО.ДокументНомер КАК НомерДокумента,
		|	ИЗРАСХОДОВАНО.КомуЗаЧто КАК КомуЗаЧтоУплачено,
		|	ИЗРАСХОДОВАНО.Сумма 												КАК СуммаВРублях,
		|	ИЗРАСХОДОВАНО.СуммаВВалюте 											КАК СуммаВВалюте,
		|	ИЗРАСХОДОВАНО.СуммаПоОтчету 										КАК СуммаПоОтчетуВРублях,
		|	ИЗРАСХОДОВАНО.СуммаВВалютеПоОтчету 									КАК СуммаПоОтчетуВВалюте,
		|	ИЗРАСХОДОВАНО.Сумма + ИЗРАСХОДОВАНО.СуммаПокрытия 					КАК СуммаВРубляхСПокрытием,
		|	ИЗРАСХОДОВАНО.СуммаПоОтчету + ИЗРАСХОДОВАНО.СуммаПокрытияПоОтчету 	КАК СуммаПоОтчетуВРУбляхСПокрытием,
		|	ИЗРАСХОДОВАНО.СуммаРубПоКурсуАванса - ИЗРАСХОДОВАНО.СуммаНДС		КАК СуммаВРубляхПоКурсуАванса,
		|	ИЗРАСХОДОВАНО.СуммаРубПоКурсуАвансаПоОтчету							КАК СуммаПоОтчетуВРубляхПоКурсуАванса,
		|	ИЗРАСХОДОВАНО.СуммаНДС 												КАК СуммаНДС,
		|	ИЗРАСХОДОВАНО.КФО,
		|	ИЗРАСХОДОВАНО.КПС,
		|	ИЗРАСХОДОВАНО.КПСДт,
		|	ИЗРАСХОДОВАНО.КЭК,
		|	ИЗРАСХОДОВАНО.СчетКредита,
		|	ИЗРАСХОДОВАНО.СчетДебета,
		|	ИЗРАСХОДОВАНО.СчетУчетаНДС,
		|	ИЗРАСХОДОВАНО.СубконтоДебета1,
		|	ИЗРАСХОДОВАНО.СубконтоДебета2,
		|	ИЗРАСХОДОВАНО.СубконтоДебета3,
		|	ИЗРАСХОДОВАНО.ПоДокументу
		|ИЗ
		|	ИЗРАСХОДОВАНО КАК ИЗРАСХОДОВАНО
		|ГДЕ
		|	ИЗРАСХОДОВАНО.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
		Запрос.УстановитьПараметр("Ссылка", СтруктураДанных.Ссылка);
		
		Израсходовано = Запрос.Выполнить().Выгрузить();
		
		Израсходовано.Колонки.Добавить("ИзрасходованоДебет", Новый ОписаниеТипов("Строка"));
		Израсходовано.Колонки.Добавить("ИзрасходованоКредит", Новый ОписаниеТипов("Строка"));
		Израсходовано.Колонки.Добавить("ИзрасходованоСчетНДС", Новый ОписаниеТипов("Строка"));
		
		КЭКСчета = Неопределено;
		
		Для Каждого Стр Из Израсходовано Цикл
			
			ДанныеПроводки = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
			ДанныеПроводки.Вставить("Организация", СтруктураДанных.Организация);
			ДанныеПроводки.Вставить("ИФО", СтруктураДанных.ИФО);
			ДанныеПроводки.Вставить("КФО", Стр.КФО);
			ДанныеПроводки.Вставить("Дата", СтруктураДанных.Дата);
			ДанныеПроводки.Вставить("Счет", Стр.СчетДебета);
			ДанныеПроводки.Вставить("ДтКт", "Дт");
			ДанныеПроводки.Вставить("Субконто1", Стр.СубконтоДебета1);
			ДанныеПроводки.Вставить("Субконто2", Стр.СубконтоДебета2);
			ДанныеПроводки.Вставить("Субконто3", Стр.СубконтоДебета3);
			ДанныеПроводки.Вставить("КЭКОперации", Стр.КЭК);
			КЭКСчета = БухгалтерскийУчет.КЭКПроводки(ДанныеПроводки);
			Если НЕ ЗначениеЗаполнено(КЭКСчета) Тогда
				КЭКСчета = Стр.КЭК;
			КонецЕсли;
			
			Если НЕ Стр.ПоДокументу И ИсправлениеОшибокПрошлыхЛет <> Неопределено Тогда
				СчетЗамены = ИсправлениеОшибокПрошлыхЛет.ЗаменаСчетов[Стр.СчетДебета];
				Если СчетЗамены = Неопределено Тогда
					Стр.СчетДебета = ИсправлениеОшибокПрошлыхЛет.СчетКор;
					КЭКСчета = ИсправлениеОшибокПрошлыхЛет.КЭКСчетКорДт;
				Иначе
					Стр.СчетДебета = СчетЗамены;
				КонецЕсли;
			КонецЕсли;
			
			Стр.ИзрасходованоДебет = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(Стр.КПСДт, Стр.КФО, Стр.СчетДебета, КЭКСчета,, Истина);
			
			Если ЗначениеЗаполнено(Стр.СчетУчетаНДС) Тогда
				КЭКСчета = БухгалтерскийУчет.КЭКСчета(СтруктураДанных.Организация, СтруктураДанных.ИФО, Стр.КФО, СтруктураДанных.Дата, Стр.СчетУчетаНДС, "Дт");
				Если НЕ ЗначениеЗаполнено(КЭКСчета) Тогда
					КЭКСчета = Стр.КЭК;
				КонецЕсли;
				Стр.ИзрасходованоСчетНДС = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(Стр.КПС, Стр.КФО, Стр.СчетУчетаНДС, КЭКСчета,, Истина);
			Иначе
				Стр.ИзрасходованоСчетНДС = "";
			КонецЕсли;
			
			ДанныеПроводки = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
			ДанныеПроводки.Вставить("Организация", СтруктураДанных.Организация);
			ДанныеПроводки.Вставить("ИФО", СтруктураДанных.ИФО);
			ДанныеПроводки.Вставить("КФО", Стр.КФО);
			ДанныеПроводки.Вставить("Дата", СтруктураДанных.Дата);
			ДанныеПроводки.Вставить("Счет", Стр.СчетКредита);
			ДанныеПроводки.Вставить("ДтКт", "Кт");
			ДанныеПроводки.Вставить("Субконто1", СтруктураДанных.СотрудникКонтрагент);
			КЭКСчета = БухгалтерскийУчет.КЭКПроводки(ДанныеПроводки);
			Если НЕ ЗначениеЗаполнено(КЭКСчета) Тогда
				КЭКСчета = Стр.КЭК;
			КонецЕсли;
			Стр.ИзрасходованоКредит = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(Стр.КПС, Стр.КФО, Стр.СчетКредита, КЭКСчета,, Истина);
			
		КонецЦикла;
		
		СтруктураДанных.Вставить("ИзрасходованоСуммаВРублях", 						Израсходовано.Итог("СуммаВРублях") + Израсходовано.Итог("СуммаНДС"));
		СтруктураДанных.Вставить("ИзрасходованоСуммаВВалюте", 						Израсходовано.Итог("СуммаВВалюте"));
		СтруктураДанных.Вставить("ИзрасходованоСуммаПоОтчетуВРублях", 				Израсходовано.Итог("СуммаПоОтчетуВРублях"));
		СтруктураДанных.Вставить("ИзрасходованоСуммаПоОтчетуВВалюте", 				Израсходовано.Итог("СуммаПоОтчетуВВалюте"));
		СтруктураДанных.Вставить("ИзрасходованоСуммаВРубляхСПокрытием", 			Израсходовано.Итог("СуммаВРубляхСПокрытием") + Израсходовано.Итог("СуммаНДС"));
		СтруктураДанных.Вставить("ИзрасходованоСуммаПоОтчетуВРУбляхСПокрытием", 	Израсходовано.Итог("СуммаПоОтчетуВРУбляхСПокрытием") + Израсходовано.Итог("СуммаНДС"));
		СтруктураДанных.Вставить("ИзрасходованоСуммаВРубляхПоКурсуАванса", 			Израсходовано.Итог("СуммаВРубляхПоКурсуАванса") + Израсходовано.Итог("СуммаНДС"));
		СтруктураДанных.Вставить("ИзрасходованоСуммаПоОтчетуВРубляхПоКурсуАванса",	Израсходовано.Итог("СуммаПоОтчетуВРубляхПоКурсуАванса"));
		
		СтруктураДанных.Вставить("ИзрасходованоСуммаВРубляхПрописью", 				ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СтруктураДанных.ИзрасходованоСуммаВРублях, ""));
		СтруктураДанных.Вставить("ИзрасходованоСуммаВВалютеПрописью", 				ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СтруктураДанных.ИзрасходованоСуммаВВалюте, СтруктураДанных.ВалютаДокумента));
		СтруктураДанных.Вставить("ИзрасходованоСуммаВРубляхСПокрытиемПрописью", 	ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СтруктураДанных.ИзрасходованоСуммаВРубляхСПокрытием, ""));
		СтруктураДанных.Вставить("ИзрасходованоСуммаВРубляхПоКурсуАвансаПрописью",	ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СтруктураДанных.ИзрасходованоСуммаВРубляхПоКурсуАванса, ""));
		
		ИзрасходованоБухЗаписи = Израсходовано.Скопировать(, "СуммаВРублях, СуммаВВалюте, СуммаПоОтчетуВРублях, СуммаПоОтчетуВВалюте, СуммаВРубляхСПокрытием, СуммаПоОтчетуВРУбляхСПокрытием, СуммаВРубляхПоКурсуАванса, СуммаПоОтчетуВРубляхПоКурсуАванса, ИзрасходованоДебет, ИзрасходованоКредит");
		ИзрасходованоБухЗаписи.Свернуть("ИзрасходованоДебет, ИзрасходованоКредит", "СуммаВРублях, СуммаВВалюте, СуммаПоОтчетуВРублях, СуммаПоОтчетуВВалюте, СуммаВРубляхСПокрытием, СуммаПоОтчетуВРУбляхСПокрытием, СуммаВРубляхПоКурсуАванса, СуммаПоОтчетуВРубляхПоКурсуАванса");
		
		// Записи по НДС
		ИзрасходованоБухЗаписиНДС =  Израсходовано.Скопировать(, "СуммаНДС, ИзрасходованоСчетНДС, ИзрасходованоКредит");
		ИзрасходованоБухЗаписиНДС.Свернуть("ИзрасходованоКредит, ИзрасходованоСчетНДС", "СуммаНДС");
		ИзрасходованоБухЗаписиНДС.Колонки["ИзрасходованоСчетНДС"].Имя = "ИзрасходованоДебет";
		ИзрасходованоБухЗаписиНДС.Колонки["СуммаНДС"].Имя = "СуммаВРубляхПоКурсуАванса";
		
		ЗанятоИндексов = 0;
		Для Каждого СтрИзрасходовано Из ИзрасходованоБухЗаписи Цикл
			Если ТабАванс.Количество() > ЗанятоИндексов Тогда
				СтрАванс = ТабАванс[ЗанятоИндексов];
			Иначе
				СтрАванс = ТабАванс.Добавить();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтрАванс, СтрИзрасходовано);
			ЗанятоИндексов = ЗанятоИндексов + 1;
		КонецЦикла;
		Для Каждого СтрИзрасходовано Из ИзрасходованоБухЗаписиНДС Цикл
			Если НЕ ЗначениеЗаполнено(СтрИзрасходовано.СуммаВРубляхПоКурсуАванса) Тогда
				Продолжить;
			КонецЕсли;
			Если ТабАванс.Количество() > ЗанятоИндексов Тогда
				СтрАванс = ТабАванс[ЗанятоИндексов];
			Иначе
				СтрАванс = ТабАванс.Добавить();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтрАванс, СтрИзрасходовано);
			ЗанятоИндексов = ЗанятоИндексов + 1;
		КонецЦикла;
		
		// Остаток/перерасход по текущему авансу
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.КФО КАК КФО,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.КПСДт КАК КПСДт,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СчетДт.Код КАК КодСчета,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.Валюта КАК Валюта,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СуммаРуб КАК СуммаРубПолучено,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СуммаВал КАК СуммаВалПолучено,
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СуммаРуб + ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.СуммаПокрытияБух КАК СуммаРубСПокрытиемПолучено,
		|	0 КАК СуммаРубИзрасходовано,
		|	0 КАК СуммаВалИзрасходовано,
		|	0 КАК СуммаРубСПокрытиемИзрасходовано
		|ИЗ
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ КАК ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ
		|ГДЕ
		|	ПОЛУЧЕНОАВАНСОВДВИЖЕНИЯ.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИЗРАСХОДОВАНО.КФО,
		|	ИЗРАСХОДОВАНО.КПС,
		|	ИЗРАСХОДОВАНО.СчетКредита.Код,
		|	ВЫБОР
		|		КОГДА ИЗРАСХОДОВАНО.СуммаПокрытия = 0
		|			ТОГДА """"
		|		ИНАЧЕ ИЗРАСХОДОВАНО.ВалютаДокумента
		|	КОНЕЦ,
		|	0,
		|	0,
		|	0,
		|	ИЗРАСХОДОВАНО.Сумма + ИЗРАСХОДОВАНО.СуммаНДС,
		|	ИЗРАСХОДОВАНО.СуммаВВалюте,
		|	ИЗРАСХОДОВАНО.СуммаРубПоКурсуАванса
		|ИЗ
		|	ИЗРАСХОДОВАНО КАК ИЗРАСХОДОВАНО
		|ГДЕ
		|	ИЗРАСХОДОВАНО.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", СтруктураДанных.Ссылка);
		
		ОстатокПерерасходПоТекущемуОтчету = Запрос.Выполнить().Выгрузить();
		ОстатокПерерасходПоТекущемуОтчету.Свернуть(
		"КФО, КПСДт, КодСчета, Валюта",
		"СуммаРубПолучено, СуммаВалПолучено, СуммаРубСПокрытиемПолучено, СуммаРубИзрасходовано, СуммаВалИзрасходовано, СуммаРубСПокрытиемИзрасходовано");
		
		ОстатокПерерасходПоТекущемуОтчету.Колонки.Добавить("Счет", Новый ОписаниеТипов("Строка"));
		ОстатокПерерасходПоТекущемуОтчету.Колонки.Добавить("СчетСсылка", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ОстатокПерерасходПоТекущемуОтчету.Колонки.Добавить("ОстатокСуммаРубСПокрытием", Новый ОписаниеТипов("Число"));
		ОстатокПерерасходПоТекущемуОтчету.Колонки.Добавить("ПерерасходСуммаРубСПокрытием", Новый ОписаниеТипов("Число"));
		ОстатокПерерасходПоТекущемуОтчету.Колонки.Добавить("ОстатокСуммаВал", Новый ОписаниеТипов("Число"));
		ОстатокПерерасходПоТекущемуОтчету.Колонки.Добавить("ПерерасходСуммаВал", Новый ОписаниеТипов("Число"));
		
		Для Каждого Стр Из ОстатокПерерасходПоТекущемуОтчету Цикл
			
			Если Стр.СуммаРубСПокрытиемПолучено > Стр.СуммаРубСПокрытиемИзрасходовано Тогда // остаток
				
				Стр.СчетСсылка = БухгалтерскийУчет.СчетПоКоду(Стр.КодСчета, СтруктураДанных.Дата, СтруктураДанных.Организация);
				
				Стр.ОстатокСуммаВал = Стр.СуммаВалПолучено - Стр.СуммаВалИзрасходовано;
				Стр.ОстатокСуммаРубСПокрытием = Стр.СуммаРубСПокрытиемПолучено - Стр.СуммаРубСПокрытиемИзрасходовано;
				
				ДанныеПроводки = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
				ДанныеПроводки.Вставить("Организация", СтруктураДанных.Организация);
				ДанныеПроводки.Вставить("ИФО", СтруктураДанных.ИФО);
				ДанныеПроводки.Вставить("КФО", Стр.КФО);
				ДанныеПроводки.Вставить("Дата", СтруктураДанных.Дата);
				ДанныеПроводки.Вставить("Счет", Стр.СчетСсылка);
				ДанныеПроводки.Вставить("ДтКт", "Дт");
				ДанныеПроводки.Вставить("Субконто1", СтруктураДанных.СотрудникКонтрагент);
				КЭКСчета = БухгалтерскийУчет.КЭКПроводки(ДанныеПроводки);
				
				Стр.Счет = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(Стр.КПСДт, Стр.КФО, Стр.СчетСсылка, КЭКСчета,, Истина);
				
			ИначеЕсли Стр.СуммаРубСПокрытиемПолучено < Стр.СуммаРубСПокрытиемИзрасходовано Тогда // перерасход
				
				Стр.СчетСсылка = БухгалтерскийУчет.СчетПоКоду(Стр.КодСчета, СтруктураДанных.Дата, СтруктураДанных.Организация);
				
				Стр.ПерерасходСуммаВал =  Стр.СуммаВалИзрасходовано - Стр.СуммаВалПолучено;
				Стр.ПерерасходСуммаРубСПокрытием = Стр.СуммаРубСПокрытиемИзрасходовано - Стр.СуммаРубСПокрытиемПолучено;
				
				ДанныеПроводки = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
				ДанныеПроводки.Вставить("Организация", СтруктураДанных.Организация);
				ДанныеПроводки.Вставить("ИФО", СтруктураДанных.ИФО);
				ДанныеПроводки.Вставить("КФО", Стр.КФО);
				ДанныеПроводки.Вставить("Дата", СтруктураДанных.Дата);
				ДанныеПроводки.Вставить("Счет", Стр.СчетСсылка);
				ДанныеПроводки.Вставить("ДтКт", "Кт");
				ДанныеПроводки.Вставить("Субконто1", СтруктураДанных.СотрудникКонтрагент);
				КЭКСчета = БухгалтерскийУчет.КЭКПроводки(ДанныеПроводки);
				
				Стр.Счет = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(Стр.КПСДт, Стр.КФО, Стр.СчетСсылка, КЭКСчета,, Истина);
				
			КонецЕсли;
			
		КонецЦикла;
		
		СтруктураДанных.Вставить("ОстатокПоТекущемуОтчетуРуб", ОстатокПерерасходПоТекущемуОтчету.Итог("ОстатокСуммаРубСПокрытием"));
		СтруктураДанных.Вставить("ПерерасходПоТекущемуОтчетуРуб", ОстатокПерерасходПоТекущемуОтчету.Итог("ПерерасходСуммаРубСПокрытием"));
		СтруктураДанных.Вставить("ОстатокПоТекущемуОтчетуВал", ОстатокПерерасходПоТекущемуОтчету.Итог("ОстатокСуммаВал"));
		СтруктураДанных.Вставить("ПерерасходПоТекущемуОтчетуВал", ОстатокПерерасходПоТекущемуОтчету.Итог("ПерерасходСуммаВал"));
		
		/////////////////////////////////////////////////////////////////////////////
		
		Область = Макет.ПолучитьОбласть("Заголовок");
		
		Область.Параметры.Заполнить(СтруктураДанных);
		
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(Область, "Номер", СтруктураДанных.Номер, СтруктураДанных.Ссылка, Неопределено, Истина);
		
		ТабличныйДокумент.Вывести(Область);
		
		Для Каждого Стр Из ТабАванс Цикл
			
			ОбластьСтрока = Макет.ПолучитьОбласть("СтрАванс");
			ОбластьСтрока.Параметры.Заполнить(Стр);
			
			ВсеПараметрыМакетаНеЗаполнены = Истина;
			Для Каждого Параметр Из ОбластьСтрока.Параметры Цикл
				Если ЗначениеЗаполнено(Параметр) Тогда
					ВсеПараметрыМакетаНеЗаполнены = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ВсеПараметрыМакетаНеЗаполнены Тогда
				Продолжить;
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
		КонецЦикла;
		
		Область = Макет.ПолучитьОбласть("ПодвалАванс");
		
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("ШапкаСведения");
		
		ТабличныйДокумент.Вывести(Область);
		
		Если ТабОстатокПерерасход.Количество() = 0 Тогда
			
			// две пустых строки
			ОбластьСтрока = Макет.ПолучитьОбласть("СтрСведения");
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
		Иначе
			
			Для Каждого Стр Из ТабОстатокПерерасход Цикл
				
				ОбластьСтрока = Макет.ПолучитьОбласть("СтрСведения");
				ОбластьСтрока.Параметры.Заполнить(Стр);
				РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьСтрока,"НомерОрдера", Стр.НомерОрдера, Стр.Регистратор, Неопределено, Истина);
				ТабличныйДокумент.Вывести(ОбластьСтрока);
				
			КонецЦикла;
			
			// Добавим две пустые строки
			
			ОбластьСтрока = Макет.ПолучитьОбласть("СтрСведения");
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
		КонецЕсли;
		
		Область = Макет.ПолучитьОбласть("ПодвалСведения");
		
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("Расписка");
		
		Область.Параметры.Заполнить(СтруктураДанных);
		
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(Область, "Номер", СтруктураДанных.Номер, СтруктураДанных.Ссылка, Неопределено, Истина);
		
		ТабличныйДокумент.Вывести(Область);
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		Область = Макет.ПолучитьОбласть("ШапкаИзрасходовано");
		
		ТабличныйДокумент.Вывести(Область);
		
		Для Каждого Стр Из Израсходовано Цикл
			
			ОбластьСтрока = Макет.ПолучитьОбласть("СтрИзрасходовано");
			ОбластьСтрока.Параметры.Заполнить(Стр);
			
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
			Если ЗначениеЗаполнено(Стр.ИзрасходованоСчетНДС) И ЗначениеЗаполнено(Стр.СуммаНДС) Тогда
				ОбластьСтрока = Макет.ПолучитьОбласть("СтрНДС");
				ОбластьСтрока.Параметры.Заполнить(Стр);
				ТабличныйДокумент.Вывести(ОбластьСтрока);
			КонецЕсли;
			
		КонецЦикла;
		
		Область = Макет.ПолучитьОбласть("ВсегоИзрасходовано");
		
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		Для Каждого Стр Из ИзрасходованоБухЗаписи Цикл
			
			ОбластьСтрока = Макет.ПолучитьОбласть("ВсегоИзрасходованоБухЗаписи");
			
			ОбластьСтрока.Параметры.Заполнить(Стр);
			
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
		КонецЦикла;
		
		// Бух. записи по НДС
		Для Каждого Стр Из ИзрасходованоБухЗаписиНДС Цикл
			
			Если ЗначениеЗаполнено(Стр.СуммаВРубляхПоКурсуАванса) Тогда
				
				ОбластьСтрока = Макет.ПолучитьОбласть("ВсегоИзрасходованоБухЗаписи");
				
				ОбластьСтрока.Параметры.Заполнить(Стр);
				
				ТабличныйДокумент.Вывести(ОбластьСтрока);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Область = Макет.ПолучитьОбласть("ВсегоОстаток");
		
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		Для Каждого Стр Из ОстатокПерерасходПоТекущемуОтчету Цикл
			
			Если Стр.ОстатокСуммаРубСПокрытием > 0 Тогда // остаток
				
