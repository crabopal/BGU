	ПакетЗапросов = Запрос.ВыполнитьПакет();
	ТаблицаИзрасходовано = ПакетЗапросов[0].Выгрузить();
	ОстаткиАвансов = ПакетЗапросов[2].Выгрузить();
	ОперацииСИсправлениемОшибок = ПакетЗапросов[3].Выгрузить();
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ТаблицаИзрасходовано.Колонки.Добавить("СуммаРубПоКурсуАванса", 			ОписаниеТипаСуммы);
	ТаблицаИзрасходовано.Колонки.Добавить("ОстатокРасчетов", 				ОписаниеТипаСуммы);
	ТаблицаИзрасходовано.Колонки.Добавить("СуммаРубПоКурсуАвансаПоОтчету", 	ОписаниеТипаСуммы);
	ТаблицаИзрасходовано.Колонки.Добавить("ОстатокРасчетовПоОтчету", 		ОписаниеТипаСуммы);
	
