	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ПриходныйОрдерМ4");
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока		= Макет.ПолучитьОбласть("Строка");
	ОбластьИтог			= Макет.ПолучитьОбласть("Итог");
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АвансовыйОтчетИзрасходовано.Ссылка КАК Ссылка,
	|	АвансовыйОтчетИзрасходовано.НомерСтроки КАК НомерСтроки,
	|	АвансовыйОтчетИзрасходовано.Ссылка.Организация КАК Организация,
	|	АвансовыйОтчетИзрасходовано.Ссылка.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	|	АвансовыйОтчетИзрасходовано.Ссылка.Организация.КодОКПО КАК КодОКПО,
	|	ВЫРАЗИТЬ(АвансовыйОтчетИзрасходовано.СубконтоДебета2 КАК Справочник.ЦМО) КАК ЦМО,
	|	ВЫРАЗИТЬ(АвансовыйОтчетИзрасходовано.СубконтоДебета2 КАК Справочник.ЦМО).Сотрудник КАК МОЛ,
