&НаКлиенте
Процедура ПолученоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Получено.ТекущиеДанные;
	Если НЕ ТекущиеДанные = Неопределено И НЕ ЗначениеЗаполнено(ТекущиеДанные.ДокументАванса) Тогда
		ТекущиеДанные.Сумма 	= 0;
		ТекущиеДанные.Валюта 	= "";
	КонецЕсли;
	
	ОбновитьДанныеОстаткаПерерасхода();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолученоДокументАвансаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИсключитьДокументы = Новый Массив;
	Для Каждого СтрокаПолучено Из Объект.Получено Цикл
		ИсключитьДокументы.Добавить(СтрокаПолучено.ДокументАванса);
	КонецЦикла;
	Для Каждого СтрокаОстатокПерерасход Из Объект.ОстатокПерерасход Цикл
		ИсключитьДокументы.Добавить(СтрокаОстатокПерерасход.ДокументПерерасхода);
	КонецЦикла;
	
	ПараметрыВыбораЗначения = Новый Структура("НачалоПериода, КонецПериода, ИФО, Организация, Сотрудник, Валюта, ИсключитьДокументы, АвансовыйОтчет, ЗаголовокФормы",
	ДатаПредыдущегоОтчета,
	КонецДня(Объект.Дата),
	Объект.ИФО,
	Объект.Организация,
	Объект.Сотрудник,
	Объект.ВалютаДокумента,
	ИсключитьДокументы,
	Объект.Ссылка,
	"Выберите документ выдачи аванса");
	
	ОткрытьФорму("Документ.АвансовыйОтчет.Форма.ФормаВыбораДокументаОплаты", ПараметрыВыбораЗначения, Элемент)
	
КонецПроцедуры

&НаКлиенте
Процедура ПолученоДокументАвансаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗаполнитьЗначенияСвойств(Элементы.Получено.ТекущиеДанные, ВыбранноеЗначение);
	
	ОбновитьДанныеОстаткаПерерасхода();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИзрасходовано

&НаКлиенте
Процедура ИзрасходованоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Израсходовано.ТекущиеДанные;
	
	Если ТекущиеДанные.ПоДокументу Тогда
		Если НЕ (Поле.Имя = "ИзрасходованоПоДокументу"
			ИЛИ Поле.Имя = "ИзрасходованоПриходныйДокумент"
			ИЛИ Поле.Имя = "ИзрасходованоДокументДата"
			ИЛИ Поле.Имя = "ИзрасходованоДокументНомер"
			ИЛИ Поле.Имя = "ИзрасходованоКомуЗаЧто"
			ИЛИ Поле.Имя = "ИзрасходованоСпособОбеспечения"
			ИЛИ (Поле.Имя = "ИзрасходованоКЭК" И ТекущиеДанные.УточнитьКЭК340)) Тогда
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ИзрасходованоОтражениеВУчете" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиОтраженияВУчете(ВыбраннаяСтрока);
	КонецЕсли;
	
	Если Поле.Имя = "ИзрасходованоПриходныйДокумент" Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоПриАктивизацииЯчейки(Элемент)
	
	Если Элементы.Израсходовано.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.Израсходовано.ТекущиеДанные.ПоДокументу Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНоваяСтрока Тогда
		ТекущаяКолонкаТаблицы = Элементы.Израсходовано.ТекущийЭлемент;
		Если ТекущаяКолонкаТаблицы.Имя = "ИзрасходованоОтражениеВУчете"
			И НЕ Элементы.Израсходовано.ТекущиеДанные.ОтражениеВУчетеЗаполнено Тогда
			ВыбраннаяСтрока = Элементы.Израсходовано.ТекущаяСтрока;
			ОткрытьФормуНастройкиОтраженияВУчете(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ЭтоНоваяСтрока = НоваяСтрока;
	
	РассчитатьИтогПринятоКУчету();
	
	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы = Элементы.Израсходовано.ТекущиеДанные;
	СтрокаТаблицы.ОтражениеВУчете = "<...>";
	СтрокаТаблицы.СчетУчетаНДС = СчетУчетаНДС(СтрокаТаблицы.ДатаСФ, СтрокаТаблицы.НДСКРаспределению, Объект.Дата, Объект.Организация);
	СтрокаТаблицы.СпособОбеспечения = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу");
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если ОтменаРедактирования И НоваяСтрока Тогда
		// Закроем форму настройки отражения в учете, т.к. пользователь отменяет ввод
		Оповестить("ФормаНастройкаОтраженияВУчете_Закрыть", Неопределено, ЭтаФорма);
	КонецЕсли;
	
	РассчитатьИтогПринятоКУчету();
	
	ЭтоНоваяСтрока = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоПослеУдаления(Элемент)
	РассчитатьИтогПринятоКУчету();
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоПоДокументуПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Израсходовано.ТекущиеДанные;
	
	Если ТекущиеДанные.ПоДокументу Тогда
		
		ТекущиеДанные.КФО					= "";
		ТекущиеДанные.КПС					= "";
		ТекущиеДанные.КПСДт					= "";
		ТекущиеДанные.КЭК					= "";
		ТекущиеДанные.Сумма					= "";
		ТекущиеДанные.СуммаВВалюте			= "";
		ТекущиеДанные.СуммаПоОтчету			= "";
		ТекущиеДанные.СуммаВВалютеПоОтчету	= "";
		ТекущиеДанные.Количество			= "";
		ТекущиеДанные.СтавкаНДС				= "";
		ТекущиеДанные.СуммаНДС				= "";
		ТекущиеДанные.ПредъявленСФ			= "";
		ТекущиеДанные.ДатаСФ				= "";
		ТекущиеДанные.НомерСФ				= "";
		ТекущиеДанные.Контрагент			= "";
		ТекущиеДанные.БланкСтрогойОтчетности= "";
		ТекущиеДанные.СчетФактура			= "";
		ТекущиеДанные.НДСКРаспределению		= "";
		ТекущиеДанные.СчетУчетаНДС			= "";
		ТекущиеДанные.СчетКредита			= "";
		ТекущиеДанные.СчетДебета			= "";
		ТекущиеДанные.СубконтоДебета1		= "";
		ТекущиеДанные.СубконтоДебета2		= "";
		ТекущиеДанные.СубконтоДебета3		= "";
		ТекущиеДанные.СчетНУ				= "";
		ТекущиеДанные.СубконтоНУ1			= "";
		ТекущиеДанные.СубконтоНУ2			= "";
		ТекущиеДанные.СубконтоНУ3			= "";
		ТекущиеДанные.ОтражениеВУчете		= "По приходному документу";
		
		ОтражениеВУчетеЗаполнено			= Истина;
		
	Иначе
		
		ТекущиеДанные.ПриходныйДокумент = "";
		
		ТекущиеДанные.ОтражениеВУчете	= "";
		
		ОтражениеВУчетеЗаполнено		= Ложь;
		
	КонецЕсли;
	
	ТекущиеДанные.УточнитьКЭК340		= Ложь;
	
	Элементы.Израсходовано.ЗакончитьРедактированиеСтроки(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоПриходныйДокументНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ Элементы.Израсходовано.ТекущиеДанные.ПоДокументу Тогда
		Возврат;
	КонецЕсли;
	
	МассивВыбранных = Новый Массив;
	Для Каждого Стр Из Объект.Израсходовано Цикл
		Если Стр.ПоДокументу И ЗначениеЗаполнено(Стр.ПриходныйДокумент) Тогда
			МассивВыбранных.Добавить(Стр.ПриходныйДокумент);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыВыбораЗначения = Новый Структура("НачалоПериода, КонецПериода, ИФО, Организация, Сотрудник, Валюта, МассивВыбранных, АвансовыйОтчет, ЗаголовокФормы",
	ДатаПредыдущегоОтчета,
	КонецДня(Объект.Дата),
	Объект.ИФО,
	Объект.Организация,
	Объект.Сотрудник,
	Объект.ВалютаДокумента,
	МассивВыбранных,
	Объект.Ссылка,
	"Выберите документ поступления ТМЦ");
	
	ОткрытьФорму("Документ.АвансовыйОтчет.Форма.ФормаВыбораПриходногоДокумента", ПараметрыВыбораЗначения, Элемент)

КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоПриходныйДокументОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Израсходовано.ТекущиеДанные;
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ВыбранноеЗначение);
	
	ТекущиеДанные.УточнитьКЭК340 = ТипЗнч(ТекущиеДанные.ПриходныйДокумент) = Тип("ДокументСсылка.ПриходныйОрдерФондовый");
	
	ОбновитьДанныеОстаткаПерерасхода(, Истина);
	ОстатокПерерасходТекущегоАванса = СтрокаОстатокПерерасходТекущегоАванса(НезавершенныеРасчетыПоВалютам);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоДатаСФПриИзменении(Элемент)
	
	СтрокаТаблицы = Элементы.Израсходовано.ТекущиеДанные;
	СтрокаТаблицы.СчетУчетаНДС = СчетУчетаНДС(СтрокаТаблицы.ДатаСФ, СтрокаТаблицы.НДСКРаспределению, Объект.Дата, Объект.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоСуммаПоОтчетуПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Элементы.Израсходовано.ТекущиеДанные.СуммаПоОтчету) Тогда
		
		Если ЗначениеЗаполнено(Элементы.Израсходовано.ТекущиеДанные.СуммаВВалютеПоОтчету) Тогда
			Элементы.Израсходовано.ТекущиеДанные.СуммаВВалютеПоОтчету = 0;
		КонецЕсли;
		Если ЗначениеЗаполнено(Элементы.Израсходовано.ТекущиеДанные.СуммаВВалюте) Тогда
			Элементы.Израсходовано.ТекущиеДанные.СуммаВВалюте = 0;
		КонецЕсли;
		
		Если Объект.СуммаВключаетНДС Тогда
			
			Элементы.Израсходовано.ТекущиеДанные.Сумма = Элементы.Израсходовано.ТекущиеДанные.СуммаПоОтчету;
			
		Иначе
			
			СтруктураПараметров = Новый Структура("Сумма, СтавкаНДС", Элементы.Израсходовано.ТекущиеДанные.СуммаПоОтчету, Элементы.Израсходовано.ТекущиеДанные.СтавкаНДС);
			ПредвСуммаНДС 		= УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтруктураПараметров, Истина);
			Элементы.Израсходовано.ТекущиеДанные.СуммаНДС = ПредвСуммаНДС;
			Элементы.Израсходовано.ТекущиеДанные.Сумма = Элементы.Израсходовано.ТекущиеДанные.СуммаПоОтчету - Элементы.Израсходовано.ТекущиеДанные.СуммаНДС;;
			
			РассчитатьИтогПринятоКУчету();
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	РассчитатьСтроку(Элементы.Израсходовано.ТекущиеДанные, Объект.СуммаВключаетНДС, "Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоСуммаВВалютеПоОтчетуПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Элементы.Израсходовано.ТекущиеДанные.СуммаВВалютеПоОтчету) Тогда
		
		Если ЗначениеЗаполнено(Элементы.Израсходовано.ТекущиеДанные.СуммаПоОтчету) Тогда
			Элементы.Израсходовано.ТекущиеДанные.СуммаПоОтчету = 0;
		КонецЕсли;
		Если ЗначениеЗаполнено(Элементы.Израсходовано.ТекущиеДанные.Сумма) Тогда
			Элементы.Израсходовано.ТекущиеДанные.Сумма = 0;
		КонецЕсли;
		Если ЗначениеЗаполнено(Элементы.Израсходовано.ТекущиеДанные.СтавкаНДС) Тогда
			Элементы.Израсходовано.ТекущиеДанные.СтавкаНДС = "";
		КонецЕсли;	
		Если ЗначениеЗаполнено(Элементы.Израсходовано.ТекущиеДанные.СуммаНДС) Тогда
			Элементы.Израсходовано.ТекущиеДанные.СуммаНДС = 0;
		КонецЕсли;
		
		Элементы.Израсходовано.ТекущиеДанные.СуммаВВалюте = Элементы.Израсходовано.ТекущиеДанные.СуммаВВалютеПоОтчету;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоСуммаПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Элементы.Израсходовано.ТекущиеДанные.СуммаПоОтчету) Тогда
		Элементы.Израсходовано.ТекущиеДанные.Сумма = 0;
	КонецЕсли;
	
	РассчитатьСтроку(Элементы.Израсходовано.ТекущиеДанные, Объект.СуммаВключаетНДС, "Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоСуммаВВалютеПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Элементы.Израсходовано.ТекущиеДанные.СуммаВВалютеПоОтчету) Тогда
		
		Элементы.Израсходовано.ТекущиеДанные.СуммаВВалюте = 0;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоСтавкаНДСПриИзменении(Элемент)
	
	Если НЕ Объект.СуммаВключаетНДС И Элементы.Израсходовано.ТекущиеДанные.Сумма + Элементы.Израсходовано.ТекущиеДанные.СуммаНДС = Элементы.Израсходовано.ТекущиеДанные.СуммаПоОтчету Тогда
		
		СтруктураПараметров = Новый Структура("Сумма, СтавкаНДС", Элементы.Израсходовано.ТекущиеДанные.СуммаПоОтчету, Элементы.Израсходовано.ТекущиеДанные.СтавкаНДС);
		ПредвСуммаНДС 		= УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтруктураПараметров, Истина);
		Элементы.Израсходовано.ТекущиеДанные.СуммаНДС = ПредвСуммаНДС;
		Элементы.Израсходовано.ТекущиеДанные.Сумма = Элементы.Израсходовано.ТекущиеДанные.СуммаПоОтчету - Элементы.Израсходовано.ТекущиеДанные.СуммаНДС;
		
		РассчитатьИтогПринятоКУчету();
		
		Возврат;
		
	КонецЕсли;
	
	РассчитатьСтроку(Элементы.Израсходовано.ТекущиеДанные, Объект.СуммаВключаетНДС, "СтавкаНДС");
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоСуммаНДСПриИзменении(Элемент)
	
	РассчитатьСтроку(Элементы.Израсходовано.ТекущиеДанные, Объект.СуммаВключаетНДС, "СуммаНДС");

КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоПредъявленСФПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Израсходовано.ТекущиеДанные;
	
	Если ТекущиеДанные.ПоДокументу Тогда
		ТекущиеДанные.ПредъявленСФ = Ложь;
	КонецЕсли;
	
	ТекущиеДанные.БланкСтрогойОтчетности = ТекущиеДанные.ПредъявленСФ;
	Если НЕ ТекущиеДанные.ПредъявленСФ Тогда
		ТекущиеДанные.ДатаСФ      = '00010101';
		ТекущиеДанные.НомерСФ     = "";
		ТекущиеДанные.СчетФактура = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоКФОПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Израсходовано.ТекущиеДанные;
	
	ОтражатьВНалоговомУчете = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(ТекущиеДанные.КФО);
	Если НЕ ОтражатьВНалоговомУчете Тогда
		ТекущиеДанные.СчетНУ      = Неопределено;
		ТекущиеДанные.СубконтоНУ1 = Неопределено;
		ТекущиеДанные.СубконтоНУ2 = Неопределено;
		ТекущиеДанные.СубконтоНУ3 = Неопределено;
	КонецЕсли;
	
	ОтражатьВУСНДоходыМинусРасходы = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы
		И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(ТекущиеДанные.КФО);
	Если НЕ ОтражатьВУСНДоходыМинусРасходы Тогда
		ТекущиеДанные.ОтражениеВУСН = Неопределено;
	КонецЕсли;
	
	ИзрасходованоОтражениеВУчетеОбновитьТекстВСтрокеТаблицы(ЭтотОбъект, Объект, ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоКФОНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
		
	Если Элементы.Израсходовано.ТекущиеДанные.ПоДокументу Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоКПСПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Израсходовано.ТекущиеДанные;
	БухгалтерскийУчетКлиент.ПроверитьОчиститьКЭК(ТекущиеДанные.КПС, ТекущиеДанные.КЭК); 
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоКПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Израсходовано.ТекущиеДанные;
	
	Если ТекущиеДанные.ПоДокументу Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоКЭКПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Израсходовано.ТекущиеДанные;
	
	Если НЕ ТекущиеДанные.УточнитьКЭК340 Тогда
		ТекущиеДанные.СчетКредита = СчетПоКЭК(ТекущиеДанные.КЭК, Объект.Дата, Объект.Организация, Объект.ИФО);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоКЭКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Израсходовано.ТекущиеДанные;
	
	Если ТекущиеДанные.ПоДокументу Тогда
		СтандартнаяОбработка = Ложь;
		Если ТекущиеДанные.УточнитьКЭК340 Тогда
			БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(
				Элемент, СтандартнаяОбработка, ТекущиеДанные.КЭК,,,,,,, КЭК340());
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоКЭКАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Израсходовано.ТекущиеДанные;
	Если ТекущиеДанные.УточнитьКЭК340 Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыВыбораКОСГУ = Новый Структура("СтрокаПоиска", Текст);
		ПараметрыВыбораКОСГУ.Вставить("Отбор", Новый Структура("Ссылка", КЭК340()));
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.КОСГУ"), ПараметрыВыбораКОСГУ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоКЭКОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Израсходовано.ТекущиеДанные;
	Если ТекущиеДанные.УточнитьКЭК340 Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыВыбораКОСГУ = Новый Структура("СтрокаПоиска", Текст);
		ПараметрыВыбораКОСГУ.Вставить("Отбор", Новый Структура("Ссылка", КЭК340()));
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.КОСГУ"), ПараметрыВыбораКОСГУ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоСчетКредитаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элементы.Израсходовано.ТекущиеДанные.ПоДокументу Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыСчета = Новый Структура("ОграниченияСчета, КодТекущейСтроки", "208.00", Элементы.Израсходовано.ТекущиеДанные.СчетКредита);
	
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыСчета, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзрасходованоОтражениеВУчетеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элементы.Израсходовано.ТекущиеДанные.ПоДокументу Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуНастройкиОтраженияВУчете(Элементы.Израсходовано.ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИзрасходованоОтражениеВУчетеОбновитьТекстВсехСтрок(Форма, Объект)
	
	Для каждого СтрокаТаблицы Из Объект.Израсходовано Цикл
		ИзрасходованоОтражениеВУчетеОбновитьТекстВСтрокеТаблицы(Форма, Объект, СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИзрасходованоОтражениеВУчетеОбновитьТекстВСтрокеТаблицы(Форма, Объект, СтрокаТаблицы)
	
	ПоляФормы = Новый Структура("КПС, КЭК, Подразделение, Счет, Субконто1, Субконто2, Субконто3, ОтражениеВУСН",
		"КПСДт", "КЭКДт", "ПодразделениеДт", "СчетДебета", "СубконтоДебета1", "СубконтоДебета2", "СубконтоДебета3", 
		"ОтражениеВУСН", "ОтразитьВКарточкеКапвложений", "КарточкаКапвложений");
	
	Если СтрокаТаблицы.ПоДокументу Тогда
		СтрокаТаблицы.ОтражениеВУчете = "По приходному документу";
		СтрокаТаблицы.ОтражениеВУчетеЗаполнено = Истина;
		СтрокаТаблицы.УточнитьКЭК340 = ТипЗнч(СтрокаТаблицы.ПриходныйДокумент) = Тип("ДокументСсылка.ПриходныйОрдерФондовый");
	Иначе
		
		ОтражатьВНалоговомУчете = Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
			И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаТаблицы.КФО);
		ОтражатьВУСНДоходыМинусРасходы = Форма.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы
			И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаТаблицы.КФО);
		
		ПараметрыОбъекта = Новый Структура;
		ПараметрыОбъекта.Вставить("ОтражатьВНалоговомУчете", ОтражатьВНалоговомУчете);
		ПараметрыОбъекта.Вставить("ОтражатьВУСНДоходыМинусРасходы", ОтражатьВУСНДоходыМинусРасходы);
		ПараметрыОбъекта.Вставить("ЕстьНДС", СтрокаТаблицы.ПредъявленСФ И СтрокаТаблицы.СуммаНДС > 0);
		ПараметрыОбъекта.Вставить("ЕстьКПС",
			НЕ СтрокаТаблицы.КПС = СтрокаТаблицы.КПСДт И ЗначениеЗаполнено(СтрокаТаблицы.КПСДт));
		ПараметрыОбъекта.Вставить("ЕстьКЭК",
			НЕ СтрокаТаблицы.КЭК = СтрокаТаблицы.КЭКДт И ЗначениеЗаполнено(СтрокаТаблицы.КЭКДт));
		ПараметрыОбъекта.Вставить("ЕстьПодразделение",
			НЕ Объект.Подразделение = СтрокаТаблицы.ПодразделениеДт И ЗначениеЗаполнено(СтрокаТаблицы.ПодразделениеДт));
		ПараметрыОбъекта.Вставить("ОтразитьВКарточкеКапвложений", СтрокаТаблицы.ОтразитьВКарточкеКапвложений);
		ПараметрыОбъекта.Вставить("КарточкаКапвложений", СтрокаТаблицы.КарточкаКапвложений);
		ПараметрыОбъекта.Вставить("Количество", СтрокаТаблицы.Количество);
		ПараметрыОбъекта.Вставить("ЕдиницаИзмерения", ЕдиницаИзмеренияНоменклатуры(СтрокаТаблицы.СубконтоДебета1));
		
		БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, ПараметрыОбъекта, ПоляФормы);
		
		СтрокаТаблицы.УточнитьКЭК340 = "";
		
	КонецЕсли;
	
КонецПроцедуры

