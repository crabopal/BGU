	ИзрасходованоОтражениеВУчетеОбновитьТекстВсехСтрок(ЭтотОбъект, Объект);
	
	УстановитьОтветственныхЛиц(Объект.Организация, Объект.Подразделение, Объект.Дата, Объект.Руководитель, Объект.ГлБухгалтер, Объект.БухгалтерКассир);
	
	ОбновитьДанныеОстаткаПерерасхода();
	
