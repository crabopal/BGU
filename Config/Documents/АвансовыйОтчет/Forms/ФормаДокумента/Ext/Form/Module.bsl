&НаКлиенте
Процедура РасчетыСПодотчетнымЛицом(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	//ПараметрыФормы.Вставить("ВидимостьКомандВариантовОтчетов", Ложь);
	
	ПараметрыОтчета = ПараметрыКонтекстногоОтчета();
	
	ПараметрыФормы.Вставить("Отбор", ПараметрыОтчета.Отбор);
	ПараметрыФормы.Вставить("Период", ПараметрыОтчета.Период);
	
	Если ЭтаФорма.КэшПараметров.ИспользоватьВалютныйУчет
		И ЭтаФорма.КэшПараметров.ВалютаРегламентированногоУчета <> ЭтаФорма.КэшПараметров.ВалютаДокумента Тогда
		ПараметрыФормы.Вставить("КлючВарианта", "РасчетыСПодотчетникомВалютаКонтекст");
	Иначе
		ПараметрыФормы.Вставить("КлючВарианта", "РасчетыСПодотчетникомКонтекст");
	КонецЕсли;
	
	ПараметрыФормы.Вставить("КлючНазначенияИспользования", "РасчетыСПодотчетнымЛицом");
	
	ОткрытьФорму("Отчет.ОборотнаяВедомостьПоРасчетамСПодотчетнымиЛицами.Форма", ПараметрыФормы, ЭтаФорма, Объект.Ссылка);
	
КонецПроцедуры

