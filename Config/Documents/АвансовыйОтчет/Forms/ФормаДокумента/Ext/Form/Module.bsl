&НаКлиенте
Процедура РассчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	Если ИмяРеквизита = "Сумма" ИЛИ ИмяРеквизита = "СтавкаНДС" Тогда 
		СтруктураПараметров = Новый Структура("Сумма, СтавкаНДС", СтрокаТЧ.Сумма, СтрокаТЧ.СтавкаНДС);
		СтрокаТЧ.СуммаНДС = УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтруктураПараметров, СуммаВключаетНДС);
		СтруктураПараметров.Вставить("СуммаНДС", СтрокаТЧ.СуммаНДС);
	КонецЕсли;
	
	РассчитатьИтогПринятоКУчету();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕдиницаИзмеренияНоменклатуры(Субконто)
	
	Если НЕ ЗначениеЗаполнено(Субконто)
		ИЛИ ТипЗнч(Субконто) <> Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат ПредопределенноеЗначение("Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка");
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Субконто, "ЕдиницаИзмерения");
	
КонецФункции

