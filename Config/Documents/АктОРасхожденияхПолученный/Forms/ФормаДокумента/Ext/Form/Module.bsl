	ТекущаяСтрока.ЗаголовокПоФактуКоличество = НСтр("ru = 'количество:'");
	ТекущаяСтрока.ЗаголовокПоФактуЦена = НСтр("ru = 'цена:'");
	
	ТекущаяСтрока.ЗаголовокПоФактуСумма = НСтр("ru = 'сумма:'");
	ТекущаяСтрока.ЗаголовокПоФактуВсего = НСтр("ru = 'всего:'");
	
	ТекущаяСтрока.ЗаголовокПоФактуСтавкаНДС = НСтр("ru = 'ставка НДС:'");
	ТекущаяСтрока.ЗаголовокПоФактуСуммаНДС = НСтр("ru = 'сумма НДС:'");
	
	ТекущаяСтрока.ЗаголовокПоФактуБрак = НСтр("ru = 'количество:'");
	ТекущаяСтрока.ЗаголовокПоФактуПоясненияБрак = НСтр("ru = 'пояснение:'");
	
