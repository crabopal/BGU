КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстИныеСведенияВсехСтрокТаблицыСписокНоменклатуры(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.СписокНоменклатуры	Цикл
		ОбновитьТекстИныеСведенияСтрокиТаблицыСписокНоменклатуры(Форма, ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстИныеСведенияСтрокиТаблицыСписокНоменклатуры(Форма, ТекущаяСтрока)
	ДанныеИныхСведенийОНоменклатуре = ДанныеИныхСведенийОНоменклатуре(Форма, ТекущаяСтрока);
	ТекстИныеСведения = ДанныеИныхСведенийОНоменклатуре.ТекстИныхСведений;
	ЕстьИныеСведения = ДанныеИныхСведенийОНоменклатуре.ЕстьИныеСведения;
	ОбновитьТекстИныеСведения(Форма, ТекущаяСтрока, ЕстьИныеСведения, ТекстИныеСведения);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДанныеИныхСведенийОНоменклатуре(Форма, ТекущиеИныеСведения)
	Объект = Форма.Объект;
	
	ЕстьСведения = Ложь;
	ТекстСведений = "";
	
	Если ЗначениеЗаполнено(ТекущиеИныеСведения.АртикулТовара) Тогда
		ЕстьСведения = Истина;
		ТекстСведений = ТекстСведений + "артикул: "+СокрЛП(ТекущиеИныеСведения.АртикулТовара);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекущиеИныеСведения.СортТовара) Тогда
		ЕстьСведения = Истина;
		ТекстСведений = ТекстСведений +(?(ЗначениеЗаполнено(ТекстСведений),", "," ")) + "сорт: "+СокрЛП(ТекущиеИныеСведения.СортТовара);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекущиеИныеСведения.КодТовара) Тогда
		ЕстьСведения = Истина;
		ТекстСведений = ТекстСведений +(?(ЗначениеЗаполнено(ТекстСведений),", "," "))+ "код: "+СокрЛП(ТекущиеИныеСведения.КодТовара);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекущиеИныеСведения.ПаспортТовара) Тогда
		ЕстьСведения = Истина;
		ТекстСведений = ТекстСведений +(?(ЗначениеЗаполнено(ТекстСведений),", "," "))+ "паспорт: "+СокрЛП(ТекущиеИныеСведения.ПаспортТовара);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекущиеИныеСведения.ХарактеристикаТовара) Тогда
		ЕстьСведения = Истина;
		ТекстСведений = ТекстСведений +(?(ЗначениеЗаполнено(ТекстСведений),", "," "))+ "характеристика: "+Сред(СокрЛП(ТекущиеИныеСведения.ХарактеристикаТовара),1,10)
			+ (?(СтрДлина(ТекущиеИныеСведения.ХарактеристикаТовара)>10,"...",""));
	КонецЕсли;	
	
	Результат = Новый Структура;
	Результат.Вставить("ТекстИныхСведений", ТекстСведений);
	Результат.Вставить("ЕстьИныеСведения", ЕстьСведения);
	
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстИныеСведения(Форма, ТекущаяСтрока, ЕстьИныеСведения = Ложь, ТекстИныеСведения)
	Если ЕстьИныеСведения Тогда
		ТекущаяСтрока.ИныеСведения = СокрЛП(ТекстИныеСведения);
	Иначе
		ТекущаяСтрока.ИныеСведения = НСтр("ru = 'Ввести данные'");
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ОткрытьФормуВводаДанныхОНоменклатуре(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Объект.СписокНоменклатуры.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдентификаторСтроки", ВыбранноеЗначение);
	ПараметрыФормы.Вставить("АртикулТовара", ДанныеСтроки.АртикулТовара);
	ПараметрыФормы.Вставить("СортТовара", ДанныеСтроки.СортТовара);
	ПараметрыФормы.Вставить("КодТовара", ДанныеСтроки.КодТовара);
	ПараметрыФормы.Вставить("ПаспортТовара", ДанныеСтроки.ПаспортТовара);
	ПараметрыФормы.Вставить("ХарактеристикаТовара", ДанныеСтроки.ХарактеристикаТовара);
	ПараметрыФормы.Вставить("НаименованиеТовара", ДанныеСтроки.НаименованиеТовара);
	
	ОткрытьФорму("Документ.АктОРасхождениях.Форма.ФормаВводаДанныхНоменклатурыПоставщика", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ОбработкаДобавленияДанныхОНоменклатуреНаСервере(Знач ВыбранноеЗначение)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		Если ВыбранноеЗначение.Свойство("ИдентификаторСтроки") Тогда
			ДанныеСтроки = Объект.СписокНоменклатуры.НайтиПоИдентификатору(ВыбранноеЗначение.ИдентификаторСтроки);
			
			ДанныеСтроки.АртикулТовара = ВыбранноеЗначение.АртикулТовара;
			ДанныеСтроки.СортТовара = ВыбранноеЗначение.СортТовара;
			ДанныеСтроки.КодТовара = ВыбранноеЗначение.КодТовара;
			ДанныеСтроки.ПаспортТовара = ВыбранноеЗначение.ПаспортТовара;
			ДанныеСтроки.ХарактеристикаТовара = ВыбранноеЗначение.ХарактеристикаТовара;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	РеквизитыДоговора = Новый Структура("ИдентификаторГосконтракта, КонтрактСУчастникомГОЗ",  "ГосударственныйКонтрактПоГОЗ.Код");
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, РеквизитыДоговора);
	
	Если ЗначениеЗаполнено(РеквизитыДоговора.ИдентификаторГосконтракта) Тогда
		Объект.ИдентификаторГосКонтракта = РеквизитыДоговора.ИдентификаторГосконтракта;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПоказатьОписаниеВариантаФормированияДополнительныхСведений()

	ОписаниеВариантаФормированияДополнительныхСведений = ЭлектронныеДокументыБГУ.ОписаниеВариантаФормированияДополнительныхСведений(Объект.ФормированиеДополнительныхСведений);
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыСведенияПоТранспортнымДокументам(ТекущаяСтрока)

	ТекущаяСтрока.ЗаголовокОтметкаОбОпломбировании = НСтр("ru = 'опломбирование:'");
	ТекущаяСтрока.ЗаголовокВидУпаковки = НСтр("ru = 'вид упаковки:'");
	
	ТекущаяСтрока.ЗаголовокКоличество = НСтр("ru = 'количество:'");
	ТекущаяСтрока.ЗаголовокЕдиницаИзмерения = НСтр("ru = 'ед.изм.:'");
	
	ТекущаяСтрока.ЗаголовокНоменклатураГруза = НСтр("ru = 'номенклатура:'");
	ТекущаяСтрока.ЗаголовокНаименованиеГруза = НСтр("ru = 'наименование:'");
	
	ТекущаяСтрока.ЗаголовокМассаОтправленияБрутто = НСтр("ru = 'брутто:'");
	ТекущаяСтрока.ЗаголовокМассаОтправленияНетто = НСтр("ru = 'нетто:'");
	
	ТекущаяСтрока.ЗаголовокМассаПрибытияБрутто = НСтр("ru = 'брутто:'");
	ТекущаяСтрока.ЗаголовокМассаПрибытияНетто = НСтр("ru = 'нетто:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыСведенияПоТранспортнымДокументам(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.СведенияПоТранспортнымДокументам Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыСведенияПоТранспортнымДокументам(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СведенияОКонтрагентеУчастнике(Наименование, ИНН, КПП, Телефон, ЭлектроннаяПочта)
	Результат = "";
	
	Результат = Наименование + " " + ИНН + "/" + КПП;
	КонтактнаяИнформация = "";
	Если ЗначениеЗаполнено(Телефон) Тогда
		КонтактнаяИнформация = " тел.: " + Телефон;
	КонецЕсли;	
	Если ЗначениеЗаполнено(ЭлектроннаяПочта) Тогда
		КонтактнаяИнформация = КонтактнаяИнформация + ?(ЗначениеЗаполнено(КонтактнаяИнформация),", ","") + " эл.почта: " + ЭлектроннаяПочта;
	КонецЕсли;	
	Если ЗначениеЗаполнено(КонтактнаяИнформация) Тогда
		КонтактнаяИнформация = " ("+КонтактнаяИнформация+")";
		Результат = Результат + КонтактнаяИнформация;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура СоздатьКнопкуДляСодержанияИтоговПриемки(Форма, ИмяРеквизита, ГруппаРеквизита)
	
	ИмяКоманды = "Заполнить" + ИмяРеквизита;  
	Команда = Форма.Команды.Добавить(ИмяКоманды);
	Команда.Отображение = ОтображениеКнопки.Картинка;
	Команда.Действие = "ОбработкаНажатияКнопкиЗаполненияСодержанияИтоговПриемки";
	
	Элемент = Форма.Элементы.Добавить(ИмяКоманды,Тип("КнопкаФормы"), ГруппаРеквизита);
	Элемент.ИмяКоманды = ИмяКоманды;
	
	Элемент.Заголовок = НСтр("ru = 'Заполнить'");
	Команда.Подсказка = НСтр("ru = 'Заполнить содержание итогов приемки'");
	Команда.Картинка = БиблиотекаКартинок.ПереместитьВлево;
	Команда.ИзменяетСохраняемыеДанные = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНажатияКнопкиЗаполненияСодержанияИтоговПриемки(КомандаФормы)
	
	Элемент = ЭтаФорма.Элементы.Найти(КомандаФормы.Имя);
	СписокДляСодержанияИтоговПриемки = СписокЗначенийВариантовСодержанияДополнительныхСведений();
	Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораСодержанияИтоговПриемки", ЭтотОбъект, Новый Структура);
	Оповещение.ДополнительныеПараметры.Вставить("Элемент", Элемент);
	ЭтаФорма.ПоказатьВыборИзМеню(Оповещение, СписокДляСодержанияИтоговПриемки, Элемент);
	
КонецПроцедуры

&НаКлиенте
Функция СписокЗначенийВариантовСодержанияДополнительныхСведений() Экспорт

	Результат = Новый СписокЗначений;
	Результат.Добавить("Материальные ценности приняты и оприходованы", НСтр("ru = 'Материальные ценности приняты и оприходованы'"));
	Результат.Добавить("Документ о приемке и (или) расхождениях утверждаю", НСтр("ru = 'Документ о приемке и (или) расхождениях утверждаю'"));
		
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПослеВыбораСодержанияИтоговПриемки(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита = Сред(ДополнительныеПараметры.Элемент.Имя,10);
	Объект[ИмяРеквизита] = ВыбранныйЭлемент; 
	
КонецПроцедуры

