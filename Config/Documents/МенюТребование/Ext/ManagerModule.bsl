#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ПроверитьЗаполнениеСчетаЗатрат(ТаблицаДляПроверки, Отказ) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО
	|			ТОГДА ВЫРАЗИТЬ(ТаблицаДляПроверки.ИФО КАК Справочник.ИсточникиФинансовогоОбеспечения)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ КАК ИФО,
	|	ТаблицаДляПроверки.КФО,
	|	ТаблицаДляПроверки.КатегорияДовольствующихся
	|ПОМЕСТИТЬ ТаблицаДляПроверки
	|ИЗ
	|	&ТаблицаДляПроверки КАК ТаблицаДляПроверки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КатегорииДовольствующихся.Ссылка КАК Ссылка,
	|	КатегорииДовольствующихсяИсточникиСредств.НомерСтроки,
	|	КатегорииДовольствующихсяИсточникиСредств.КФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО
	|			ТОГДА КатегорииДовольствующихсяИсточникиСредств.ИФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ КАК ИФО,
	|	КатегорииДовольствующихсяИсточникиСредств.СчетЗатрат,
	|	КатегорииДовольствующихсяИсточникиСредств.КЭКЗатрат,
	|	КатегорииДовольствующихсяИсточникиСредств.СубконтоЗатрат1,
	|	КатегорииДовольствующихсяИсточникиСредств.СубконтоЗатрат2,
	|	КатегорииДовольствующихсяИсточникиСредств.СубконтоЗатрат3,
	|	КатегорииДовольствующихся.Наименование
	|ИЗ
	|	Справочник.КатегорииДовольствующихся.ИсточникиСредств КАК КатегорииДовольствующихсяИсточникиСредств
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КатегорииДовольствующихся КАК КатегорииДовольствующихся
	|		ПО КатегорииДовольствующихсяИсточникиСредств.Ссылка = КатегорииДовольствующихся.Ссылка
	|ГДЕ
	|	КатегорииДовольствующихся.Ссылка В
	|			(ВЫБРАТЬ
	|				ТаблицаДляПроверки.КатегорияДовольствующихся
	|			ИЗ
	|				ТаблицаДляПроверки КАК ТаблицаДляПроверки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	КатегорииДовольствующихся.Ссылка,
	|	КатегорииДовольствующихсяИсточникиСредств.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаДляПроверки.КатегорияДовольствующихся,
	|	ТаблицаДляПроверки.КФО,
	|	ТаблицаДляПроверки.ИФО
	|ИЗ
	|	ТаблицаДляПроверки КАК ТаблицаДляПроверки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КатегорииДовольствующихся.ИсточникиСредств КАК КатегорииДовольствующихсяИсточникиСредств
	|		ПО ТаблицаДляПроверки.КатегорияДовольствующихся = КатегорииДовольствующихсяИсточникиСредств.Ссылка
	|			И ТаблицаДляПроверки.ИФО = КатегорииДовольствующихсяИсточникиСредств.ИФО
	|			И ТаблицаДляПроверки.КФО = КатегорииДовольствующихсяИсточникиСредств.КФО
	|ГДЕ
	|	КатегорииДовольствующихсяИсточникиСредств.Ссылка ЕСТЬ NULL 
	|	И &ИспользоватьУчетПоИФО = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаДляПроверки.КатегорияДовольствующихся,
	|	ТаблицаДляПроверки.КФО,
	|	NULL
	|ИЗ
	|	ТаблицаДляПроверки КАК ТаблицаДляПроверки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КатегорииДовольствующихся.ИсточникиСредств КАК КатегорииДовольствующихсяИсточникиСредств
	|		ПО ТаблицаДляПроверки.КатегорияДовольствующихся = КатегорииДовольствующихсяИсточникиСредств.Ссылка
	|			И ТаблицаДляПроверки.КФО = КатегорииДовольствующихсяИсточникиСредств.КФО
	|ГДЕ
	|	КатегорииДовольствующихсяИсточникиСредств.Ссылка ЕСТЬ NULL 
	|	И &ИспользоватьУчетПоИФО = ЛОЖЬ";
	ТаблицаДляПроверки.Свернуть("ИФО,КФО,КатегорияДовольствующихся");
	Запрос.УстановитьПараметр("ТаблицаДляПроверки", ТаблицаДляПроверки);
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ИспользоватьУчетПоИФО);
	ДанныеСтрок = Новый Соответствие;
	
	ОшибкаНеЗаполненоПоле = НСтр("ru = 'Ошибка заполнения источников средств. В категории довольствующихся ""%1"" в строке %2 не заполнено обязательное поле ""%3"".'");
	Если ИспользоватьУчетПоИФО Тогда
		ОшибкаУникальность = НСтр("ru = 'Ошибка заполнения источников средств. Указанное в строке %1 сочетание ИФО и КФО уже использовано ранее в строке %2.'");
	Иначе
		ОшибкаУникальность = НСтр("ru = 'Ошибка заполнения источников средств. Указанное в строке %1 значение КФО уже использовано ранее в строке %2.'");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Выборка = РезультатЗапроса[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ФлагОшибки = Ложь;
		Если ИспользоватьУчетПоИФО И НЕ ЗначениеЗаполнено(Выборка.ИФО) Тогда
			ОбщегоНазначения.СообщитьПользователю(
			    СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОшибкаНеЗаполненоПоле, Выборка.Наименование, Выборка.НомерСтроки, "ИФО"),
				Выборка.Ссылка,
				"ИсточникиСредств[" + (Выборка.НомерСтроки - 1) + "].ИФО",
				"Объект",
				Отказ);
			ФлагОшибки = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.КФО) Тогда
			ОбщегоНазначения.СообщитьПользователю(
			    СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОшибкаНеЗаполненоПоле, Выборка.Наименование, Выборка.НомерСтроки, "КФО"),
				Выборка.Ссылка,
				"ИсточникиСредств[" + (Выборка.НомерСтроки - 1) + "].КФО",
				"Объект",
				Отказ);
			ФлагОшибки = Истина;
		КонецЕсли;
		
		Если ФлагОшибки Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеПроводки = ДанныеСтрок.Получить(Выборка.Ссылка);
		Если ДанныеПроводки = Неопределено Тогда
			ДанныеСтрок.Вставить(Выборка.Ссылка, Новый Соответствие);
			ДанныеПроводки = ДанныеСтрок.Получить(Выборка.Ссылка);
		КонецЕсли;
		
		Если ИспользоватьУчетПоИФО Тогда
			ТекСтрокаИФО = ДанныеПроводки.Получить(Выборка.ИФО);
			Если ТекСтрокаИФО = Неопределено Тогда
				ДанныеПроводки.Вставить(Выборка.ИФО, Новый Соответствие);
				ТекСтрокаИФО = ДанныеПроводки.Получить(Выборка.ИФО);
			КонецЕсли;
		Иначе
			ТекСтрокаИФО = ДанныеПроводки;
		КонецЕсли;
		
		ТекСтрокаКФО = ТекСтрокаИФО.Получить(Выборка.КФО);
		Если ТекСтрокаКФО = Неопределено Тогда
			ТекСтрокаИФО.Вставить(Выборка.КФО, Выборка.НомерСтроки);
		Иначе
			ОбщегоНазначения.СообщитьПользователю(
                СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОшибкаУникальность, Выборка.НомерСтроки, ТекСтрокаКФО),
				Выборка.Ссылка,
				"ИсточникиСредств[" + (Выборка.НомерСтроки - 1) + "].КФО",
				"Объект",
				Отказ);
			ФлагОшибки = Истина;
		КонецЕсли;
		
		Если ФлагОшибки Тогда
			Продолжить;
		КонецЕсли;
	
		Если Не ЗначениеЗаполнено(Выборка.СчетЗатрат) Тогда
			ОбщегоНазначения.СообщитьПользователю(
			    СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОшибкаНеЗаполненоПоле, Выборка.Наименование, Выборка.НомерСтроки, "Счет затрат"),
				Выборка.Ссылка,
				"ИсточникиСредств[" + (Выборка.НомерСтроки - 1) + "].СчетЗатрат",
				"Объект",
				Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.КЭКЗатрат) Тогда
			ОбщегоНазначения.СообщитьПользователю(
			    СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОшибкаНеЗаполненоПоле, Выборка.Наименование, Выборка.НомерСтроки, "КЭК затрат"),
				Выборка.Ссылка,
				"ИсточникиСредств[" + (Выборка.НомерСтроки - 1) + "].КЭКЗатрат",
				"Объект",
				Отказ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.СчетЗатрат) Тогда
			
			СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Выборка.СчетЗатрат);
			Для Индекс = 1 По 3 Цикл
			
				Если ЗначениеЗаполнено(СвойстваСчета["ВидСубконто" + Индекс])
					И СвойстваСчета["ВидСубконто" + Индекс + "Обязательный"]
					И Не ЗначениеЗаполнено(Выборка["СубконтоЗатрат" + Индекс]) Тогда
					
					ОбщегоНазначения.СообщитьПользователю(
					    СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОшибкаНеЗаполненоПоле, Выборка.Наименование, Выборка.НомерСтроки, "Субконто " + Индекс),
						Выборка.Ссылка,
						"ИсточникиСредств[" + (Выборка.НомерСтроки - 1) + "].СубконтоЗатрат" + Индекс,
						"Объект",
						Отказ);
					
				КонецЕсли;
			
			КонецЦикла; 
			
		КонецЕсли;
	
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользоватьУчетПоИФО Тогда
		ОшибкаНетСчета = НСтр("ru = 'Ошибка заполнения источников средств. В категории довольствующихся ""%1"" не заполнен счет затрат для сочетания ИФО = ""%3"" и КФО=""%2"".'");
	Иначе
		ОшибкаНетСчета = НСтр("ru = 'Ошибка заполнения источников средств. В категории довольствующихся ""%1"" не заполнен счет затрат для КФО=""%2"".'");
	КонецЕсли;
	
	Выборка = РезультатЗапроса[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначения.СообщитьПользователю(
		    СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОшибкаНетСчета, Выборка.КатегорияДовольствующихся, Выборка.КФО, Выборка.ИФО),
			Выборка.КатегорияДовольствующихся,
			"ИсточникиСредств",
			"Объект",
			Отказ);
	КонецЦикла;

КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.МенюТребование";
	КомандаПечати.Идентификатор		= "МенюТребование103н";
	КомандаПечати.Представление		= НСтр("ru = 'Меню - требование (ф. 0504202), ред.103н'");
	КомандаПечати.Порядок			= 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.МенюТребование";
	КомандаПечати.Идентификатор		= "МенюТребование52н";
	КомандаПечати.Представление		= НСтр("ru = 'Меню - требование (ф. 0504202), ред.52н'");
	КомандаПечати.Порядок			= 2;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.МенюТребование";
	КомандаПечати.Идентификатор		= "МенюТребование";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Меню - требование (ф. 0504202)'");
	КомандаПечати.Порядок			= 100;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"МенюТребование103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "МенюТребование103н", "Меню-требование", ПечатьМенюТребования(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_МенюТребование0504202_103н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"МенюТребование52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "МенюТребование52н", "Меню-требование", ПечатьМенюТребования(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_МенюТребование_52н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"МенюТребование") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "МенюТребование", "Меню-требование", ПечатьМенюТребования(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_МенюТребование"));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

Функция ПечатьМенюТребования(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	ТаблицаРезультат = Новый ТабличныйДокумент;
	ТаблицаВыводШапкиМТ = Новый ТабличныйДокумент;

	ТаблицаРезультат.АвтоМасштаб = Истина;
	ТаблицаРезультат.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТаблицаРезультат.ИмяПараметровПечати = "ПараметрыПечати_МенюТребование";
	
