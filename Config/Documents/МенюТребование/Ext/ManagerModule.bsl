	|ИЗ
	|	Документ.МенюТребование.Материалы КАК МенюТребованиеМатериалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО МенюТребованиеМатериалы.Номенклатура = СправочникНоменклатура.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КатегорииДовольствующихся КАК КатегорииДовольствующихся
	|		ПО МенюТребованиеМатериалы.КатегорияДовольствующихся = КатегорииДовольствующихся.Ссылка
	|ГДЕ
	|	МенюТребованиеМатериалы.Ссылка В(&МассивОбъектов)
	|	И НЕ ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА КАК Поле1
	|				ИЗ
	|					Документ.МенюТребование.СоставБлюда КАК МенюТребованиеСоставБлюда
	|				ГДЕ
	|					МенюТребованиеСоставБлюда.Ссылка = МенюТребованиеМатериалы.Ссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	МенюТребованиеМатериалы.Ссылка,
	|	МенюТребованиеМатериалы.Номенклатура,
	|	МенюТребованиеМатериалы.Номенклатура.Наименование,
	|	МенюТребованиеМатериалы.Номенклатура.Код,
	|	МенюТребованиеМатериалы.КатегорияДовольствующихся,
	|	ВЫБОР
	|		КОГДА КатегорииДовольствующихся.ЭтоПерсонал
	|			ТОГДА ""Персонал""
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА КатегорииДовольствующихся.ЭтоПерсонал
	|			ТОГДА 999999
	|		ИНАЧЕ 999998
	|	КОНЕЦ,
	|	ПРЕДСТАВЛЕНИЕ(СправочникНоменклатура.ЕдиницаИзмерения)";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаШапка 			= Результат[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКатегории		= Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаБлюдаПрод		= Результат[5].Выгрузить();
	
	ПервыйДокумент = Истина;
	МассивПроверяемыхОбластей = Новый Массив;
	
	Пока ВыборкаШапка.Следующий() Цикл
		Если Не ПервыйДокумент Тогда
			ТаблицаРезультат.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТаблицаРезультат.ВысотаТаблицы + 1;
		
		ОбластьЗаголовок.Параметры.Заполнить(ВыборкаШапка);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьЗаголовок,"Номер",ВыборкаШапка.Номер,ВыборкаШапка.Ссылка,Неопределено, Истина);

		Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
													Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
													ВыборкаШапка.Организация,
													ВыборкаШапка.Дата);
		СтруктураЗаполнения = Новый Структура("РуководительФИО", 
											  КорреспондентыКлиентСервер.ФИО(Руководитель.ОтветственноеЛицоФИО, Истина));
		ОбластьЗаголовок.Параметры.Заполнить(СтруктураЗаполнения);
		ТаблицаРезультат.Вывести(ОбластьЗаголовок);
		
		ОбластьШапка.Параметры.Заполнить(ВыборкаШапка);
		СтруктураЗаполнения = Новый Структура("МОЛ", Справочники.Сотрудники.ФамилияИО(ВыборкаШапка.МОЛСсылка, 
																					  Истина, 
																					  ВыборкаШапка.Дата));
		ОбластьШапка.Параметры.Заполнить(СтруктураЗаполнения);
		ТаблицаРезультат.Вывести(ОбластьШапка);
		
		ТаблицаРезультат.Вывести(ОбластьШапкаКД);
		ИтогоПСНаВсех 				= 0;
		ИтогоКоличествоПерсонала	= 0;
		ИтогоФС 					= 0;
		ВыборкаКатегории.Сбросить();
		Если ВыборкаКатегории.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Тогда
			ТекВыборкаКатегории = ВыборкаКатегории.Выбрать();
			Пока ТекВыборкаКатегории.Следующий() Цикл
				ОбластьСтрокаКД.Параметры.Заполнить(ТекВыборкаКатегории);
				СтоимостиДня = РегистрыСведений.ПлановыеСтоимостиДня.СрезПоследних(ВыборкаШапка.Дата, 
													Новый Структура("Организация, КатегорияДовольствующихся",
																	ВыборкаШапка.Организация,
																	ТекВыборкаКатегории.КатегорияДовольствующихся));
				СтруктураЗаполнения = Новый Структура("ПС, ПСНаВсех");
				Если СтоимостиДня.Количество()>0 Тогда
					СтруктураЗаполнения.ПС       = СтоимостиДня[0].Стоимость;
					СтруктураЗаполнения.ПСНаВсех = СтоимостиДня[0].Стоимость * ТекВыборкаКатегории.КоличествоПоПС;
					ИтогоПСНаВсех = ИтогоПСНаВсех + СтруктураЗаполнения.ПСНаВсех; 
				КонецЕсли;
				ОбластьСтрокаКД.Параметры.Заполнить(СтруктураЗаполнения);
				ТаблицаРезультат.Вывести(ОбластьСтрокаКД);
				ИтогоКоличествоПерсонала = ИтогоКоличествоПерсонала + ТекВыборкаКатегории.КоличествоПерсонала;
				ИтогоФС = ИтогоФС + ТекВыборкаКатегории.ФС; 
			КонецЦикла;
		КонецЕсли;
		
		СтруктураЗаполнения = Новый Структура("ИтогоПСнаВсех, ИтогоКоличествоПерсонала,ИтогоФС", 
											   ИтогоПСнаВсех,ИтогоКоличествоПерсонала, ИтогоФС);
		ОбластьПодвалКД.Параметры.Заполнить(СтруктураЗаполнения);
		ТаблицаРезультат.Вывести(ОбластьПодвалКД);
		
		// выводим шапку таблицы продукты
		
		ОбластьНачалоШапки = ТаблицаВыводШапкиМТ.Вывести(ОбластьШапкаМТ1);
		ВысотаТаблицы = ТаблицаВыводШапкиМТ.ВысотаТаблицы;
		ТаблицаПродуктов = ВыборкаБлюдаПрод.Скопировать(Новый Структура("Ссылка", ВыборкаШапка.Ссылка), 
														"ПорядокПриемовПищи, ПорядокБлюд, Блюдо, ПриемПищи, ПриемПищиСсылка, "
														+"КатегорияДовольствующихся, Количество,Выход");
		ТаблицаПродуктов.Свернуть("ПорядокПриемовПищи, ПорядокБлюд, Блюдо, ПриемПищи, ПриемПищиСсылка,"
									+"КатегорияДовольствующихся, Количество, Выход");
		ТаблицаПродуктов.Сортировать("ПорядокПриемовПищи, ПриемПищи, ПорядокБлюд, Блюдо, Количество,Выход");
		КоличестваПорций = Новый Массив;
		ВыходыПорций = Новый Массив;
		Колонки = Новый Массив;
		НомерКолонки = 4;
		КоличествоСтрок = ТаблицаПродуктов.Количество()-1;
		НомерКолонкиНачалаПриемаПищи = 0;
		ТекПриемПищи = "";
		Для Счетчик=0 По КоличествоСтрок Цикл
			ТекПродукт = ТаблицаПродуктов[Счетчик];
		
			СтруктураЗаполнения = Новый Структура("Блюдо, НомерКолонки, ПриемПищи");
			СтруктураЗаполнения.Блюдо 			= ТекПродукт.Блюдо;
			СтруктураЗаполнения.НомерКолонки 	= НомерКолонки;
			СтруктураЗаполнения.ПриемПищи 		= ТекПродукт.ПриемПищи;
			ОбластьШапкаМТ1Блюд.Параметры.Заполнить(СтруктураЗаполнения);
			ТаблицаВыводШапкиМТ.Присоединить(ОбластьШапкаМТ1Блюд);
			Колонки.Добавить(""+ТекПродукт.ПриемПищи+"_"+ТекПродукт.Блюдо);
			// получим все категории довольствующихся по текущему приему пищи и блюду
			КоличПорций = ""+ТекПродукт.Количество;
			ВыходПорций = Новый Соответствие;
			ВыходПорций.Вставить(ТекПродукт.Выход);
			Счетчик2 = Счетчик;
			Пока (Счетчик2)<КоличествоСтрок Цикл
				СледПродукт = ТаблицаПродуктов[Счетчик2+1];
				Если СледПродукт.Блюдо = ТекПродукт.Блюдо И СледПродукт.ПриемПищи = ТекПродукт.ПриемПищи Тогда
					КоличПорций = КоличПорций + "/"+СледПродукт.Количество;
					ВыходПорций.Вставить(СледПродукт.Выход);
				Иначе
					Прервать;
				КонецЕсли;
				Счетчик2 = Счетчик2 + 1;
			КонецЦикла;
			Счетчик = Счетчик2;
			КоличестваПорций.Добавить(КоличПорций);
			ВыходыПорций.Добавить(ОбщегоНазначенияКлиентСервер.КлючиСтруктурыВСтроку(ВыходПорций, "/"));
			
			Если ТекПриемПищи<>ТекПродукт.ПриемПищиСсылка Тогда
				Если ТекПриемПищи <> "" И (НомерКолонки-НомерКолонкиНачалаПриемаПищи>1) Тогда
					ТаблицаВыводШапкиМТ.Область("R"+(ВысотаТаблицы-4)+"C"+НомерКолонкиНачалаПриемаПищи
											+":R"+(ВысотаТаблицы-3)+"C"+(НомерКолонки-1)).Объединить();
				КонецЕсли;
				ТекПриемПищи = ТекПродукт.ПриемПищиСсылка;
				НомерКолонкиНачалаПриемаПищи = НомерКолонки;
			КонецЕсли;
			НомерКолонки = НомерКолонки + 1;
		КонецЦикла;
		Если НомерКолонкиНачалаПриемаПищи > 0 И (НомерКолонки-НомерКолонкиНачалаПриемаПищи)>1 Тогда
			ТаблицаВыводШапкиМТ.Область("R"+(ВысотаТаблицы-4)+"C"+НомерКолонкиНачалаПриемаПищи
									+":R"+(ВысотаТаблицы-3)+"C"+(НомерКолонки-1)).Объединить();
		КонецЕсли;
		Если (НомерКолонки-4>1) Тогда
			ТаблицаВыводШапкиМТ.Область("R"+(ВысотаТаблицы-5)+"C"+4
									+":R"+(ВысотаТаблицы-5)+"C"+(НомерКолонки-1)).Объединить();
		КонецЕсли;
		
		СтруктураЗаполнения = Новый Структура("НомерКолонкиД, НомерКолонкиП", НомерКолонки, НомерКолонки+1);
		ОбластьШапкаМТ1Всего.Параметры.Заполнить(СтруктураЗаполнения);
		ТаблицаВыводШапкиМТ.Присоединить(ОбластьШапкаМТ1Всего);
		
		ТаблицаВыводШапкиМТ.Вывести(ОбластьСтрокаМТ1);
		Для Счетчик = 0 По КоличестваПорций.ВГраница() Цикл
			СтруктураЗаполнения = Новый Структура("КоличествоПорций, Выход", 
												  КоличестваПорций[Счетчик], ВыходыПорций[Счетчик]);
			ОбластьСтрокаМТ1Блюд.Параметры.Заполнить(СтруктураЗаполнения);
			ТаблицаВыводШапкиМТ.Присоединить(ОбластьСтрокаМТ1Блюд);
		КонецЦикла;
		ОбластьКонецШапки = ТаблицаВыводШапкиМТ.Присоединить(ОбластьСтрокаМТ1Всего);

		ОбластьШапкаМТ = ТаблицаВыводШапкиМТ.ПолучитьОбласть(
		ОбластьНачалоШапки.Верх,
		ОбластьНачалоШапки.Лево,
		ОбластьКонецШапки.Низ,
		ОбластьКонецШапки.Право);

		МассивПроверяемыхОбластей.Очистить();
		МассивПроверяемыхОбластей.Добавить(ОбластьШапкаМТ);
		Если Не ТаблицаРезультат.ПроверитьВывод(МассивПроверяемыхОбластей) Тогда
				ТаблицаРезультат.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ТаблицаРезультат.Вывести(ОбластьШапкаМТ);

		ТаблицаПродуктов = ВыборкаБлюдаПрод.Скопировать(Новый Структура("Ссылка", ВыборкаШапка.Ссылка),
														"ПорядокПриемовПищи, Блюдо, ПриемПищи,"
														+"Номенклатура, НоменклатураНаименование, КодПродукта,"
														+"Единица, КоличествоПродуктов");
		
		ТаблицаПродуктов.Свернуть("ПорядокПриемовПищи, Блюдо, ПриемПищи, Номенклатура, НоменклатураНаименование,"
									+"КодПродукта, Единица", "КоличествоПродуктов");
		ТаблицаПродуктов.Сортировать("НоменклатураНаименование");
		
		КоличествоКолонок = Колонки.Количество();
		Номенклатура = Новый ТаблицаЗначений;
		Номенклатура.Колонки.Добавить("Номенклатура", 				Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		Номенклатура.Колонки.Добавить("НоменклатураНаименование", 	Новый ОписаниеТипов("Строка"));
		Номенклатура.Колонки.Добавить("КодПродукта", 				Новый ОписаниеТипов("Строка"));
		Номенклатура.Колонки.Добавить("Единица", 					Новый ОписаниеТипов("Строка"));
		Номенклатура.Колонки.Добавить("КоличествоНаК",				Новый ОписаниеТипов("Число"));
		Номенклатура.Колонки.Добавить("КоличествоНаП", 				Новый ОписаниеТипов("Число"));
		Вхождения = Новый Массив;
		
		Для каждого ТекПродукт Из ТаблицаПродуктов Цикл
			СтрокаНоменклатура = Номенклатура.Найти(ТекПродукт.Номенклатура, "Номенклатура");
			Если СтрокаНоменклатура = Неопределено Тогда
				СтрокаНоменклатура = Номенклатура.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаНоменклатура, ТекПродукт);
				СтрокаНоменклатура.КоличествоНаП = 0;
				СтрокаНоменклатура.КоличествоНаК = 0;
				Вхождения.Добавить(Новый Массив(КоличествоКолонок));
			КонецЕсли;
			Индекс = Номенклатура.Индекс(СтрокаНоменклатура);
			
			ИндексКолонки = Колонки.Найти(""+ТекПродукт.ПриемПищи+"_"+ТекПродукт.Блюдо);
			Вхождения[Индекс][ИндексКолонки] = ТекПродукт.КоличествоПродуктов;
		
			Если ТекПродукт.ПорядокПриемовПищи = 999999 Тогда
				СтрокаНоменклатура.КоличествоНаП = СтрокаНоменклатура.КоличествоНаП + ТекПродукт.КоличествоПродуктов;
			Иначе
				СтрокаНоменклатура.КоличествоНаК = СтрокаНоменклатура.КоличествоНаК + ТекПродукт.КоличествоПродуктов;
			КонецЕсли;
		КонецЦикла;
		
		КоличествоСтрок = Номенклатура.Количество()-1;
		Для ИндексСтрок = 0 По КоличествоСтрок Цикл
			ТекПродукт = Номенклатура[ИндексСтрок];
			СтруктураЗаполнения = Новый Структура("Номенклатура,КодПродукта,Единица",
												  ТекПродукт.НоменклатураНаименование,
												  ТекПродукт.КодПродукта,
												  ТекПродукт.Единица);
			МассивПроверяемыхОбластей.Очистить();
			МассивПроверяемыхОбластей.Добавить(ОбластьСтрокаМТ);
			Если ИндексСтрок = КоличествоСтрок Тогда
				МассивПроверяемыхОбластей.Добавить(ОбластьПодвал);
			КонецЕсли;
			
			Если Не ТаблицаРезультат.ПроверитьВывод(МассивПроверяемыхОбластей) Тогда
				ТаблицаРезультат.ВывестиГоризонтальныйРазделительСтраниц();
				ТаблицаРезультат.Вывести(ОбластьШапкаМТ);
			КонецЕсли;
			
			ОбластьСтрокаМТ.Параметры.Заполнить(СтруктураЗаполнения);
			ТаблицаРезультат.Вывести(ОбластьСтрокаМТ);
			Для ИндексКолонок = 0 По КоличествоКолонок-1 Цикл
				СтруктураЗаполнения = Новый Структура("Количество", Вхождения[ИндексСтрок][ИндексКолонок]);
				ОбластьСтрокаМТБлюд.Параметры.Заполнить(СтруктураЗаполнения);
				ТаблицаРезультат.Присоединить(ОбластьСтрокаМТБлюд);
			КонецЦикла;
			ОбластьСтрокаМТВсего.Параметры.Заполнить(ТекПродукт);
			ТаблицаРезультат.Присоединить(ОбластьСтрокаМТВсего);
			
		КонецЦикла;
		
		СтруктураОбластьПодвал = Новый Структура("ФИОБухгалтер,ФИОПовар,ФИОВрач,ФИОКладовщик");
		СтруктураОбластьПодвал.ФИОБухгалтер 	= Справочники.Сотрудники.ФамилияИО(	ВыборкаШапка.Бухгалтер, 	
																					Истина, ВыборкаШапка.Дата);
		СтруктураОбластьПодвал.ФИОПовар	 	= Справочники.Сотрудники.ФамилияИО(ВыборкаШапка.Повар, 		
																					Истина, ВыборкаШапка.Дата);
		СтруктураОбластьПодвал.ФИОВрач	 		= Справочники.Сотрудники.ФамилияИО(ВыборкаШапка.Врач, 		
																					Истина, ВыборкаШапка.Дата);
		СтруктураОбластьПодвал.ФИОКладовщик	= Справочники.Сотрудники.ФамилияИО(ВыборкаШапка.Кладовщик,	
																					Истина, ВыборкаШапка.Дата);
		ДанныеОтветственного = УправлениеПечатьюБГУ.СведенияИсполнителяПоОтветственному(ВыборкаШапка.Ответственный,
			ВыборкаШапка.Организация, ВыборкаШапка.Дата, Истина);
		СтруктураОбластьПодвал.Вставить("ФИООтвИсполнитель",     ДанныеОтветственного.ФИО);																					
		СтруктураОбластьПодвал.Вставить("ТелефонОтвИсполнитель", ДанныеОтветственного.НомерТелефона);
		СтруктураОбластьПодвал.Вставить("ЭлАдресОтвИсполнитель", ДанныеОтветственного.ЭлектроннаяПочта);
																					
		ОбластьПодвал.Параметры.Заполнить(СтруктураОбластьПодвал);																			
		ТаблицаРезультат.Вывести(ОбластьПодвал);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТаблицаРезультат, 
		                                               НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
	Возврат ТаблицаРезультат;
	
КонецФункции

#КонецОбласти

#Область УстаревшиеПроцедурыИФункции

// Устарела. Для формирования проводок используется источник данных "Списание продуктов питания", см. функции:
// - БухгалтерскиеОперацииИсточникиДанных.СписаниеПродуктовПитания(),
// - УправлениеМатериальнымиЗапасами.ТаблицаСписаниеПродуктовПитания(),
// - УправлениеМатериальнымиЗапасами.ОтразитьСписаниеПродуктовПитанияВРегистреРасходПродуктов().
//
Функция ПодготовитьТаблицуПроводок(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ) Экспорт
	
	РасходПродуктов = ДокументОбъект.Движения.РасходПродуктов;
	РасходПродуктов.Записывать = Истина;
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	ПроверитьЗаполнениеСчетаЗатрат(ДокументОбъект.Материалы.Выгрузить(,"КатегорияДовольствующихся,ИФО,КФО"), Отказ);
	Если Отказ Тогда
		Возврат ТаблицаПроводок;
	КонецЕсли;
	
	// Списание продуктов питания по всем видам учета
	ТаблицаСписанныхМатериалов = БухгалтерскиеОперацииПовтИсп.ТаблицаСписанияНоменклатуры(ДокументОбъект.Ссылка);
	Если НЕ БухгалтерскиеОперации.НоменклатурыДостаточноДляСписания(ДокументОбъект.Ссылка, "БУ", ТиповаяОперация.УстанавливатьБлокировку) Тогда
		Отказ = Истина;
		Возврат ТаблицаПроводок;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("ТаблицаМатериалы", ТаблицаСписанныхМатериалов);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаМатериалы.ВидУчета,
	|	ТаблицаМатериалы.ИмяСписка,
	|	ТаблицаМатериалы.СинонимСписка,
	|	ТаблицаМатериалы.НомерСтроки,
	|	ТаблицаМатериалы.Номенклатура,
	|	ТаблицаМатериалы.СчетУчета,
	|	ТаблицаМатериалы.ИФО,
	|	ТаблицаМатериалы.КФО,
	|	ТаблицаМатериалы.КПС,
	|	ТаблицаМатериалы.Подразделение,
	|	ТаблицаМатериалы.ЦМО,
	|	ТаблицаМатериалы.Количество,
	|	ТаблицаМатериалы.Стоимость,
	|	ТаблицаМатериалы.СтоимостьНеУчитываетсяНУ,
	|	ТаблицаМатериалы.СтоимостьЕНВД
	|ПОМЕСТИТЬ СписанныеМатериалы
	|ИЗ
	|	&ТаблицаМатериалы КАК ТаблицаМатериалы
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТаблицаМатериалы.НомерСтроки,
	|	ТаблицаМатериалы.КФО,
	|	ТаблицаМатериалы.ИФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписанныеМатериалы.ВидУчета,
	|	СписанныеМатериалы.ИмяСписка,
	|	СписанныеМатериалы.СинонимСписка,
	|	СписанныеМатериалы.НомерСтроки,
	|	СписанныеМатериалы.Номенклатура,
	|	СписанныеМатериалы.СчетУчета,
	|	СписанныеМатериалы.ИФО,
	|	СписанныеМатериалы.КФО,
	|	СписанныеМатериалы.КПС,
	|	СписанныеМатериалы.Подразделение,
	|	СписанныеМатериалы.ЦМО,
	|	СписанныеМатериалы.Количество,
	|	СписанныеМатериалы.Стоимость,
	|	СписанныеМатериалы.СтоимостьНеУчитываетсяНУ,
	|	СписанныеМатериалы.СтоимостьЕНВД,
	|	МенюТребованиеМатериалы.КатегорияДовольствующихся
	|ПОМЕСТИТЬ СписанныеПоКатегориям
	|ИЗ
	|	СписанныеМатериалы КАК СписанныеМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.МенюТребование.Материалы КАК МенюТребованиеМатериалы
	|		ПО СписанныеМатериалы.НомерСтроки = МенюТребованиеМатериалы.НомерСтроки
	|ГДЕ
	|	МенюТребованиеМатериалы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписанныеПоКатегориям.ВидУчета,
	|	СписанныеПоКатегориям.ИмяСписка,
	|	СписанныеПоКатегориям.СинонимСписка,
	|	СписанныеПоКатегориям.НомерСтроки,
	|	СписанныеПоКатегориям.Номенклатура,
	|	СписанныеПоКатегориям.СчетУчета,
	|	СписанныеПоКатегориям.ИФО,
	|	СписанныеПоКатегориям.КФО,
	|	СписанныеПоКатегориям.КПС,
	|	СписанныеПоКатегориям.Подразделение,
	|	СписанныеПоКатегориям.ЦМО,
	|	СписанныеПоКатегориям.Количество,
	|	СписанныеПоКатегориям.Стоимость КАК СтоимостьСписания,
	|	СписанныеПоКатегориям.СтоимостьНеУчитываетсяНУ КАК СтоимостьСписанияНеУчитываетсяНУ,
	|	СписанныеПоКатегориям.СтоимостьЕНВД КАК СтоимостьСписанияЕНВД,
	|	СписанныеПоКатегориям.КатегорияДовольствующихся,
	|	КоличествоДовольствующихся.Количество КАК КоличествоДовольствующихся,
	|	ИсточникиСредств.СчетЗатрат,
	|	ИсточникиСредств.КЭКЗатрат,
	|	ИсточникиСредств.Ссылка.Подразделение КАК ПодразделениеЗатрат,
	|	ИсточникиСредств.СубконтоЗатрат1,
	|	ИсточникиСредств.СубконтоЗатрат2,
	|	ИсточникиСредств.СубконтоЗатрат3
	|ИЗ
	|	СписанныеПоКатегориям КАК СписанныеПоКатегориям
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КатегорииДовольствующихся.ИсточникиСредств КАК ИсточникиСредств
	|		ПО СписанныеПоКатегориям.ИФО = ИсточникиСредств.ИФО
	|			И СписанныеПоКатегориям.КФО = ИсточникиСредств.КФО
	|			И СписанныеПоКатегориям.КатегорияДовольствующихся = ИсточникиСредств.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.МенюТребование.КатегорииДовольствующихся КАК КоличествоДовольствующихся
	|		ПО СписанныеПоКатегориям.КатегорияДовольствующихся = КоличествоДовольствующихся.КатегорияДовольствующихся
	|			И (КоличествоДовольствующихся.Ссылка = &Ссылка)
	|ГДЕ
	|	&ИспользоватьУчетПоИФО = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СписанныеПоКатегориям.ВидУчета,
	|	СписанныеПоКатегориям.ИмяСписка,
	|	СписанныеПоКатегориям.СинонимСписка,
	|	СписанныеПоКатегориям.НомерСтроки,
	|	СписанныеПоКатегориям.Номенклатура,
	|	СписанныеПоКатегориям.СчетУчета,
	|	СписанныеПоКатегориям.ИФО,
	|	СписанныеПоКатегориям.КФО,
	|	СписанныеПоКатегориям.КПС,
	|	СписанныеПоКатегориям.Подразделение,
	|	СписанныеПоКатегориям.ЦМО,
	|	СписанныеПоКатегориям.Количество,
	|	СписанныеПоКатегориям.Стоимость,
	|	СписанныеПоКатегориям.СтоимостьНеУчитываетсяНУ,
	|	СписанныеПоКатегориям.СтоимостьЕНВД,
	|	СписанныеПоКатегориям.КатегорияДовольствующихся,
	|	КоличествоДовольствующихся.Количество,
	|	ИсточникиСредств.СчетЗатрат,
	|	ИсточникиСредств.КЭКЗатрат,
	|	ИсточникиСредств.Ссылка.Подразделение,
	|	ИсточникиСредств.СубконтоЗатрат1,
	|	ИсточникиСредств.СубконтоЗатрат2,
	|	ИсточникиСредств.СубконтоЗатрат3
	|ИЗ
	|	СписанныеПоКатегориям КАК СписанныеПоКатегориям
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КатегорииДовольствующихся.ИсточникиСредств КАК ИсточникиСредств
	|		ПО СписанныеПоКатегориям.КФО = ИсточникиСредств.КФО
	|			И СписанныеПоКатегориям.КатегорияДовольствующихся = ИсточникиСредств.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.МенюТребование.КатегорииДовольствующихся КАК КоличествоДовольствующихся
	|		ПО СписанныеПоКатегориям.КатегорияДовольствующихся = КоличествоДовольствующихся.КатегорияДовольствующихся
	|			И (КоличествоДовольствующихся.Ссылка = &Ссылка)
	|ГДЕ
	|	&ИспользоватьУчетПоИФО = ЛОЖЬ";
	
	ОбщиеРеквизитыПроводки = Новый Структура("Период, Организация, ВидПервичногоДокумента, НомерПервичногоДокумента, ДатаПервичногоДокумента, Активность",
		ДокументОбъект.Дата,
		ДокументОбъект.Организация,
		"Меню-требование",
		БухгалтерскиеОперации.ПолучитьНомерДляПечатиПоНастройке(ДокументОбъект.Ссылка, ДокументОбъект.Номер),
		ДокументОбъект.Дата,
		Истина);
		
	ТаблицаСписания = Запрос.Выполнить().Выгрузить();
	Для каждого СтрокаТаблицы Из ТаблицаСписания Цикл
		
		Проводка = ТаблицаПроводок.Добавить();
		ЗаполнитьЗначенияСвойств(Проводка, ОбщиеРеквизитыПроводки);
		
		Проводка.ИФО = СтрокаТаблицы.ИФО;
		Проводка.КФО = СтрокаТаблицы.КФО;
		
		// Дебет
		Если СтрокаТаблицы.ВидУчета = "БУ" Тогда
			
			Проводка.СчетДт          = СтрокаТаблицы.СчетЗатрат;
			Проводка.КПСДт           = СтрокаТаблицы.КПС;
			Проводка.КЭКДт           = СтрокаТаблицы.КЭКЗатрат;
			Проводка.ПодразделениеДт = СтрокаТаблицы.ПодразделениеЗатрат;
			Проводка.СубконтоДт1     = СтрокаТаблицы.СубконтоЗатрат1;
			Проводка.СубконтоДт2     = СтрокаТаблицы.СубконтоЗатрат2;
			Проводка.СубконтоДт3     = СтрокаТаблицы.СубконтоЗатрат3;
			
		ИначеЕсли СтрокаТаблицы.ВидУчета = "НУ" Тогда
			
			Если БухгалтерскиеОперации.ВидСчетаБУ(СтрокаТаблицы.СчетЗатрат) = "СчетЗатрат" Тогда
				Проводка.СчетДт      = БухгалтерскиеОперации.ПолучитьСчетРасходовНУ(
											СтрокаТаблицы.СчетЗатрат, СтрокаТаблицы.СчетУчета,
											СтрокаТаблицы.СубконтоЗатрат1, СтрокаТаблицы.СубконтоЗатрат2, СтрокаТаблицы.СубконтоЗатрат3,
											Проводка.Период, Проводка.Организация, Проводка.ИФО, Проводка.ПодразделениеДт);
				Проводка.СубконтоДт1 = СтрокаТаблицы.СубконтоЗатрат1;
				Проводка.СубконтоДт2 = СтрокаТаблицы.СубконтоЗатрат2;
				Проводка.СубконтоДт3 = СтрокаТаблицы.СубконтоЗатрат3;
			Иначе
				Проводка.СчетДт      = БухгалтерскиеОперации.ПолучитьСчетНУпоСчетуБУ(СтрокаТаблицы.СчетЗатрат, "Дт");
				Для НомерСубконто=1 По 3 Цикл
					Проводка["СубконтоДт"+НомерСубконто] =
						БухгалтерскиеОперации.ПолучитьЗначениеСубконто(Проводка.СчетДт, НомерСубконто,
							БухгалтерскиеОперации.ВидСубконтоСчета(Проводка.СчетДт, 1), СтрокаТаблицы.СубконтоЗатрат1,
							БухгалтерскиеОперации.ВидСубконтоСчета(Проводка.СчетДт, 2), СтрокаТаблицы.СубконтоЗатрат2,
							БухгалтерскиеОперации.ВидСубконтоСчета(Проводка.СчетДт, 3), СтрокаТаблицы.СубконтоЗатрат3,
							"ПрочиеДоходыИРасходы", ДополнительныеРеквизиты.СтатьяПрочихРасходов,
							"РеализуемыеАктивы", СтрокаТаблицы.Номенклатура);
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
		СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетДт);
		Проводка.ВидСубконтоДт1  = СвойстваСчетаДт.ВидСубконто1;
		Проводка.ВидСубконтоДт2  = СвойстваСчетаДт.ВидСубконто2;
		Проводка.ВидСубконтоДт3  = СвойстваСчетаДт.ВидСубконто3;
		
		// Кредит
		Если СтрокаТаблицы.ВидУчета = "БУ" Тогда
			
			Проводка.СчетКт          = СтрокаТаблицы.СчетУчета;
			Проводка.КПСКт           = СтрокаТаблицы.КПС;
			Проводка.КЭККт           = БухгалтерскийУчет.КЭКСчета(Проводка.Организация, Проводка.ИФО, Проводка.КФО, Проводка.Период, Проводка.СчетКт, "Кт");
			Проводка.ПодразделениеКт = СтрокаТаблицы.Подразделение;
			Проводка.СубконтоКт1     = СтрокаТаблицы.Номенклатура;
			Проводка.СубконтоКт2     = СтрокаТаблицы.ЦМО;
			
		ИначеЕсли СтрокаТаблицы.ВидУчета = "НУ" Тогда
			
			Проводка.СчетКт          = СтрокаТаблицы.СчетУчета;
			Проводка.СубконтоКт1     = СтрокаТаблицы.Номенклатура;
			
		КонецЕсли;
		
		СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетКт);
		Проводка.ВидСубконтоКт1  = СвойстваСчетаКт.ВидСубконто1;
		Проводка.ВидСубконтоКт2  = СвойстваСчетаКт.ВидСубконто2;
		Проводка.ВидСубконтоКт3  = СвойстваСчетаКт.ВидСубконто3;
		
		Если СвойстваСчетаКт.Количественный Тогда
			Проводка.КоличествоКт = СтрокаТаблицы.Количество;
		КонецЕсли;
		
		Проводка.Сумма                = СтрокаТаблицы.СтоимостьСписания;
		Проводка.СуммаНеУчитываетсяНУ = СтрокаТаблицы.СтоимостьСписанияНеУчитываетсяНУ;
		Проводка.СуммаЕНВД            = СтрокаТаблицы.СтоимостьСписанияЕНВД;
		
		Проводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
		Проводка.Содержание     = БухгалтерскиеОперации.СодержаниеПроводкиМПЗ("Списание", СтрокаТаблицы.Номенклатура);
		
		// Движения по регистру РасходПродуктов
		Если СтрокаТаблицы.ВидУчета = "БУ" Тогда
			Движение = РасходПродуктов.Добавить();
			Движение.Период      = ДокументОбъект.Дата;
			Движение.Организация = ДокументОбъект.Организация;
			ЗаполнитьЗначенияСвойств(Движение, СтрокаТаблицы);
			Движение.Количество                 = СтрокаТаблицы.Количество;
			Движение.Сумма                      = СтрокаТаблицы.СтоимостьСписания;
			Движение.КоличествоДовольствующихся = СтрокаТаблицы.КоличествоДовольствующихся;
		КонецЕсли;
		
	КонецЦикла;
	
	РасходПродуктов.Записать(Истина);
	
	Возврат ТаблицаПроводок;
	
КонецФункции

// Устарела. Для формирования проводок используется источник данных "Возврат продуктов питания", см. функции:
// - БухгалтерскиеОперацииИсточникиДанных.ВозвратПродуктовПитания(),
// - УправлениеМатериальнымиЗапасами.ТаблицаВозвратПродуктовПитания(),
// - УправлениеМатериальнымиЗапасами.ОтразитьВозвратПродуктовПитанияВРегистреРасходПродуктов().
//
Функция ПодготовитьТаблицуПроводокВозврат(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ) Экспорт
	
	РасходПродуктов = ДокументОбъект.Движения.РасходПродуктов;
	РасходПродуктов.Записывать = Истина;
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаМатериалы",      ДокументОбъект.Материалы.Выгрузить());
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаМатериалы.КФО,
	|	ТаблицаМатериалы.КПС,
	|	ТаблицаМатериалы.Номенклатура,
	|	ТаблицаМатериалы.Количество,
	|	ТаблицаМатериалы.КатегорияДовольствующихся,
	|	ТаблицаМатериалы.ИФО,
	|	ТаблицаМатериалы.Цена,
	|	ТаблицаМатериалы.Сумма
	|ПОМЕСТИТЬ МатериалыДокумента
	|ИЗ
	|	&ТаблицаМатериалы КАК ТаблицаМатериалы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МатериалыДокумента.КФО,
	|	МатериалыДокумента.КПС,
	|	МатериалыДокумента.Номенклатура,
	|	МатериалыДокумента.Количество,
	|	МатериалыДокумента.КатегорияДовольствующихся,
	|	МатериалыДокумента.ИФО,
	|	МатериалыДокумента.Цена,
	|	МатериалыДокумента.Сумма,
	|	КатегорииДовольствующихсяИсточникиСредств.СчетЗатрат,
	|	КатегорииДовольствующихсяИсточникиСредств.КЭКЗатрат,
	|	КатегорииДовольствующихсяИсточникиСредств.СубконтоЗатрат1,
	|	КатегорииДовольствующихсяИсточникиСредств.СубконтоЗатрат2,
	|	КатегорииДовольствующихсяИсточникиСредств.СубконтоЗатрат3,
	|	КатегорииДовольствующихсяИсточникиСредств.Ссылка.Подразделение КАК ПодразделениеЗатрат
	|ИЗ
	|	МатериалыДокумента КАК МатериалыДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КатегорииДовольствующихся.ИсточникиСредств КАК КатегорииДовольствующихсяИсточникиСредств
	|		ПО МатериалыДокумента.КатегорияДовольствующихся = КатегорииДовольствующихсяИсточникиСредств.Ссылка
	|			И МатериалыДокумента.КФО = КатегорииДовольствующихсяИсточникиСредств.КФО
	|			И (КатегорииДовольствующихсяИсточникиСредств.ИФО = МатериалыДокумента.ИФО
	|				ИЛИ НЕ &ИспользоватьУчетПоИФО)";
	
	ОбщиеРеквизитыПроводки = Новый Структура("Период, Организация, ВидПервичногоДокумента, НомерПервичногоДокумента, ДатаПервичногоДокумента, Активность",
		ДокументОбъект.Дата,
		ДокументОбъект.Организация,
		"Меню-требование",
		ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокументОбъект.Номер,Истина,Истина),
		ДокументОбъект.Дата,
		Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		// Бухгалтерский учет
		Проводка = ТаблицаПроводок.Добавить();
		ЗаполнитьЗначенияСвойств(Проводка, ОбщиеРеквизитыПроводки);
		
		Проводка.ИФО = Выборка.ИФО;
		Проводка.КФО = Выборка.КФО;
		
		Проводка.СчетДт          = Выборка.СчетЗатрат;
		Проводка.КПСДт           = Выборка.КПС;
		Проводка.КЭКДт           = Выборка.КЭКЗатрат;
		Проводка.ПодразделениеДт = Выборка.ПодразделениеЗатрат;
		Проводка.СубконтоДт1     = Выборка.СубконтоЗатрат1;
		Проводка.СубконтоДт2     = Выборка.СубконтоЗатрат2;
		Проводка.СубконтоДт3     = Выборка.СубконтоЗатрат3;
		
		СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетДт);
		Проводка.ВидСубконтоДт1  = СвойстваСчетаДт.ВидСубконто1;
		Проводка.ВидСубконтоДт2  = СвойстваСчетаДт.ВидСубконто2;
		Проводка.ВидСубконтоДт3  = СвойстваСчетаДт.ВидСубконто3;
		
		Проводка.СчетКт          = БухгалтерскиеОперацииПовтИсп.СчетУчетаСсылкаИзНоменклатуры(Выборка.Номенклатура);
		Проводка.КПСКт           = Выборка.КПС;
		Проводка.КЭККт           = БухгалтерскийУчет.КЭКСчета(Проводка.Организация, Проводка.ИФО, Проводка.КФО, Проводка.Период, Проводка.СчетКт, "Кт");
		Проводка.ПодразделениеКт = ДокументОбъект.Подразделение;
		Проводка.СубконтоКт1     = Выборка.Номенклатура;
		Проводка.СубконтоКт2     = ДокументОбъект.ЦМО;
		
		СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетКт);
		Проводка.ВидСубконтоКт1  = СвойстваСчетаКт.ВидСубконто1;
		Проводка.ВидСубконтоКт2  = СвойстваСчетаКт.ВидСубконто2;
		Проводка.ВидСубконтоКт3  = СвойстваСчетаКт.ВидСубконто3;
		
		Если СвойстваСчетаКт.Количественный Тогда
			Проводка.КоличествоКт = Выборка.Количество;
		КонецЕсли;
		
		Проводка.Сумма = Выборка.Сумма;
		
		Проводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
		Проводка.Содержание = БухгалтерскиеОперации.СодержаниеПроводкиМПЗ("Возврат", Выборка.Номенклатура);
		
		// Налоговый учет
		Если НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(ДокументОбъект.Организация, ДокументОбъект.Дата, Выборка.КФО) Тогда
			
			ПроводкаНУ = ТаблицаПроводок.Добавить();
			ЗаполнитьЗначенияСвойств(ПроводкаНУ, ОбщиеРеквизитыПроводки);
			
			ПроводкаНУ.ИФО = Проводка.ИФО;
			ПроводкаНУ.КФО = Проводка.КФО;
			
			Если БухгалтерскиеОперации.ВидСчетаБУ(Проводка.СчетДт) = "СчетЗатрат" Тогда
				ПроводкаНУ.СчетДт      = БухгалтерскиеОперации.ПолучитьСчетРасходовНУ(
											Проводка.СчетДт, Проводка.СчетКт,
											Проводка.СубконтоДт1, Проводка.СубконтоДт2, Проводка.СубконтоДт3,
											Проводка.Период, Проводка.Организация, Проводка.ИФО, Проводка.ПодразделениеДт);
				ПроводкаНУ.СубконтоДт1 = Проводка.СубконтоДт1;
				ПроводкаНУ.СубконтоДт2 = Проводка.СубконтоДт2;
				ПроводкаНУ.СубконтоДт3 = Проводка.СубконтоДт3;
			Иначе
				ПроводкаНУ.СчетДт      = БухгалтерскиеОперации.ПолучитьСчетНУпоСчетуБУ(Проводка.СчетДт, "Дт");
				Для НомерСубконто=1 По 3 Цикл
					ПроводкаНУ["СубконтоДт"+НомерСубконто] =
						БухгалтерскиеОперации.ПолучитьЗначениеСубконто(ПроводкаНУ.СчетДт, НомерСубконто,
							БухгалтерскиеОперации.ВидСубконтоСчета(Проводка.СчетДт, 1), Проводка.СубконтоДт1,
							БухгалтерскиеОперации.ВидСубконтоСчета(Проводка.СчетДт, 2), Проводка.СубконтоДт2,
							БухгалтерскиеОперации.ВидСубконтоСчета(Проводка.СчетДт, 3), Проводка.СубконтоДт3,
							"ПрочиеДоходыИРасходы", ДополнительныеРеквизиты.СтатьяПрочихРасходов,
							"РеализуемыеАктивы", Выборка.Номенклатура);
				КонецЦикла;
			КонецЕсли;
			
			СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПроводкаНУ.СчетДт);
			ПроводкаНУ.ВидСубконтоДт1  = СвойстваСчетаДт.ВидСубконто1;
			ПроводкаНУ.ВидСубконтоДт2  = СвойстваСчетаДт.ВидСубконто2;
			ПроводкаНУ.ВидСубконтоДт3  = СвойстваСчетаДт.ВидСубконто3;
			
			ПроводкаНУ.СчетКт          = БухгалтерскиеОперации.ПолучитьСчетНУпоСчетуБУ(Проводка.СчетКт, "Кт");
			ПроводкаНУ.СубконтоКт1     = Выборка.Номенклатура;
			
			СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПроводкаНУ.СчетКт);
			ПроводкаНУ.ВидСубконтоКт1  = СвойстваСчетаКт.ВидСубконто1;
			ПроводкаНУ.ВидСубконтоКт2  = СвойстваСчетаКт.ВидСубконто2;
			ПроводкаНУ.ВидСубконтоКт3  = СвойстваСчетаКт.ВидСубконто3;
			
			Если СвойстваСчетаКт.Количественный Тогда
				ПроводкаНУ.КоличествоКт = Выборка.Количество;
			КонецЕсли;
			
			ПроводкаНУ.Сумма = Выборка.Сумма;
			
			ПроводкаНУ.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
			ПроводкаНУ.Содержание = БухгалтерскиеОперации.СодержаниеПроводкиМПЗ("Возврат", Выборка.Номенклатура);
			
		КонецЕсли;
		
		// Движения по регистру РасходПродуктов
		Движение = РасходПродуктов.Добавить();
		Движение.Период      = ДокументОбъект.Дата;
		Движение.Организация = ДокументОбъект.Организация;
		ЗаполнитьЗначенияСвойств(Движение, Выборка);
		Движение.Количество  = Выборка.Количество;
		Движение.Сумма       = Выборка.Сумма;
		
	КонецЦикла;
	
	Возврат ТаблицаПроводок;
	
КонецФункции

#КонецОбласти

#КонецЕсли
