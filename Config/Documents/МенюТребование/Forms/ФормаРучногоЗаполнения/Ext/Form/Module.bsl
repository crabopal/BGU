#Область ОписаниеПеременных

&НаКлиенте
Перем РодительУдаленнойСтроки;
&НаКлиенте
Перем ПеренестиВДокумент;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	СписокКатегорий.ЗагрузитьЗначения(Параметры.КатегорииДовольствующихся);

	ДобавитьДинамическиеКолонки(СписокКатегорий);
		
	Если ЭтоАдресВременногоХранилища(Параметры.СохраненныеПродуктыАдрес) Тогда 
		СохраненныеПродуктыАдрес = Параметры.СохраненныеПродуктыАдрес;
	КонецЕсли;
	
	Если НЕ Параметры.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ОстаткиМатериалов,
			"ДатаОстатки",
			Новый Граница(Параметры.Ссылка.МоментВремени(), ВидГраницы.Исключая),
			Истина);
		Заголовок = СтрШаблон(НСтр("ru = 'Ручное заполнение: %1'"), Параметры.Ссылка);
	ИначеЕсли ЗначениеЗаполнено(Параметры.Дата) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ОстаткиМатериалов,
			"ДатаОстатки",
			Новый Граница(КонецДня(Параметры.Дата), ВидГраницы.Включая),
			Истина);
	КонецЕсли;
	
	УчетПоПодразделениям = Ложь;
	ИспользуемыеСчета = ПолучитьСписокСчетовУчетаПродуктовПитания(УчетПоПодразделениям);
	УчетПоПодразделениям = УчетПоПодразделениям И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ОстаткиМатериалов,
		"Организация",
		Параметры.Организация,
		ВидСравненияКомпоновкиДанных.Равно,
		"",
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ОстаткиМатериалов,
		"ЦМО",
		Параметры.ЦМО,
		ВидСравненияКомпоновкиДанных.Равно,
		"",
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ОстаткиМатериалов,
		"Счет",
		ИспользуемыеСчета,
		ВидСравненияКомпоновкиДанных.ВСписке,
		"",
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	Если УчетПоПодразделениям Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ОстаткиМатериалов,
			"Подразделение",
			Параметры.Подразделение,
			ВидСравненияКомпоновкиДанных.Равно,
			"",
			Истина,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	КонецЕсли;
	
	Если ИспользоватьУчетПоИФО Тогда
		МассивКлючей = Новый Массив(ОстаткиМатериалов.ПоляКлюча);
		МассивКлючей.Добавить("ИФО");
		ОстаткиМатериалов.ПоляКлюча = Новый ФиксированныйМассив(МассивКлючей);
	КонецЕсли;

	ЗаполнитьТаблицуПродуктовИзДокумента();
	УстановитьВидимостьПанелиОстатков(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность И ПеренестиВДокумент <> Истина Тогда
		Отказ = Истина;
		ТекстВопроса = НСтр("ru = 'Таблица продуктов была изменена.
			|Перенести таблицу продуктов в документ?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Перенести в документ'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Закрыть форму'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Вернуться к редактированию'"));
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, 20, КодВозвратаДиалога.Да, НСтр("ru = 'Таблица продуктов была изменена'"));
		Возврат;
		
	КонецЕсли;
	
	Если Модифицированность И ПеренестиВДокумент = Истина Тогда
		Если НЕ ПроверитьЗаполнениеРеквизитовТаблицы() Тогда
			Отказ = Истина;
			ПеренестиВДокумент = Ложь;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если ПеренестиВДокумент = Истина Тогда
		АдресВХранилище = ПоместитьВХранилищеТаблицуВДокумент();
		ОповеститьОВыборе(АдресВХранилище);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаМатериалов

&НаКлиенте
Процедура ТаблицаМатериаловПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	ТекущиеДанные = Элементы.ТаблицаМатериалов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	
	Если Копирование Тогда
		ТекущийРодитель = ТекущиеДанные.ПолучитьРодителя();
	Иначе
		ТекущийРодитель = Неопределено;
	КонецЕсли;
	
	Если ТекущийРодитель = Неопределено Тогда
		НовыйЭлемент = ТаблицаМатериалов.ПолучитьЭлементы().Добавить();
	Иначе
		НовыйЭлемент = ТекущийРодитель.ПолучитьЭлементы().Добавить();
	КонецЕсли;
	
	Если Копирование Тогда
		ЗаполнитьЗначенияСвойств(НовыйЭлемент, ТекущиеДанные);
	КонецЕсли;
	
	НовыйЭлемент.КоличествоПодчиненныхНеПравильное = Ложь;
	
	Элементы.ТаблицаМатериалов.ТекущаяСтрока = НовыйЭлемент.ПолучитьИдентификатор();
	Элементы.ТаблицаМатериалов.ИзменитьСтроку();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииКоличестваПоКатегорииДовольствующихся(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаМатериалов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьКоличествоПоСтроке(ТекущиеДанные, Неопределено, ТаблицаКатегорийДовольствующихся);
	
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		ТекущиеДанные.КоличествоПодчиненныхНеПравильное = Ложь;
	Иначе
		ПересчитатьКоличествоПоКолонкам(ТекущиеДанные.ПолучитьРодителя());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаМатериаловПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ТаблицаМатериалов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = ТекущиеДанные.ПолучитьЭлементы().Количество() > 0;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаМатериаловПослеУдаления(Элемент)
	
	Если РодительУдаленнойСтроки <> Неопределено Тогда
		
		ПересчитатьКоличествоПоКолонкам(РодительУдаленнойСтроки);
		РодительУдаленнойСтроки = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаМатериаловПередУдалением(Элемент, Отказ)
	РодительУдаленнойСтроки = Неопределено;
	ТекущиеДанные = Элементы.ТаблицаМатериалов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РодительУдаленнойСтроки = ТекущиеДанные.ПолучитьРодителя();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаМатериаловПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаМатериалов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПодбиратьВсе И МножественныйВыбор Тогда
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПоискСтрокиОстатковМатериалов", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаМатериаловНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаМатериалов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаМатериаловПриИзмененииРеквизитовКлючаПоиска(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаМатериаловКФОПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаМатериалов.ТекущиеДанные;
