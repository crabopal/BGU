&НаКлиенте
Процедура ВывестиОстатки(Команда)
	
	ТекстВопроса = "";
	Если Параметры.Ключ.Пустая() Тогда
		ТекстВопроса = НСтр("ru='Документ не записан.
								|Перед расчетом остатков необходимо записать документ.
								|Записать?'");
	ИначеЕсли Модифицированность Тогда
		ТекстВопроса = НСтр("ru='Документ изменен.
								|Перед расчетом остатков необходимо записать документ.
								|Записать?'");
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстВопроса) Тогда
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru='Записать'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='Не записывать'"));
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ВывестиОстаткиЗавершение", ЭтотОбъект),
			ТекстВопроса, Кнопки,,КодВозвратаДиалога.Да);
		Возврат;
	КонецЕсли;
	
	ВывестиОстаткиФрагмент();
	
КонецПроцедуры

