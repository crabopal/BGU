	ПараметрыФормы = Новый Структура("МенюТребование", Параметры.Ключ);
	ОткрытьФорму("Отчет.РасчетНедостающихПродуктов.Форма.ФормаОтчета", ПараметрыФормы,,УникальныйИдентификатор);
	
