&НаКлиенте
Процедура КатегорииДовольствующихсяПриАктивизацииСтроки(Элемент)
	
	УстановитьОтборСтрокМенюРаскладки();
	УстановитьОтборСоставаБлюда();
	УстановитьОтборСтрокМатериалов();
	
КонецПроцедуры

&НаКлиенте
Процедура КатегорииДовольствующихсяКатегорияДовольствующихсяПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.КатегорииДовольствующихся.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущаяКатегорияДовольствующихся) Тогда
		
		Если ТекущаяКатегорияДовольствующихся <> ТекущиеДанные.КатегорияДовольствующихся Тогда
			
			Если Объект.МенюРаскладка.Количество() Тогда
				ТекстВопроса = НСтр("ru='Перезаполнить данные во всех таблицах документа?'");
				ДопПараметры = Новый Структура ("ТекущиеДанные, ЗначениеДоИзменения, ИмяРеквизита", ТекущиеДанные, ТекущаяКатегорияДовольствующихся, "КатегорияДовольствующихся");
				ПоказатьВопрос(Новый ОписаниеОповещения("ВариантМенюКатегорияПриИзмененииЗавершение", ЭтотОбъект, ДопПараметры),
				ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			Иначе
				Если Объект.Материалы.Количество() Тогда
					ЗаменитьКатегориюВТаблицеМатериалы(ТекущиеДанные.КатегорияДовольствующихся, ТекущаяКатегорияДовольствующихся);
					УстановитьОтборСтрокМатериалов();
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		ТекущаяКатегорияДовольствующихся = Неопределено;
		
	Иначе
		
		УстановитьОтборСтрокМенюРаскладки();
		УстановитьОтборСтрокМатериалов();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КатегорииДовольствующихсяКатегорияДовольствующихсяНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.КатегорииДовольствующихся.ТекущиеДанные;
	ТребуемыеДанные = "Код";
	ПараметрыФормы = Новый Структура(	"Отбор, ТекущаяСтрока, ТребуемыеДанные",
										Новый Структура("Владелец", Объект.Организация),
										ТекущиеДанные.КатегорияДовольствующихся,
										ТребуемыеДанные);
	ОткрытьФорму("Справочник.КатегорииДовольствующихся.ФормаВыбора", ПараметрыФормы, Элемент);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура КатегорииДовольствующихсяКатегорияДовольствующихсяОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.КатегорииДовольствующихся.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяКатегорияДовольствующихся = ТекущиеДанные.КатегорияДовольствующихся;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ВыбранноеЗначение.Свойство("Код", ТекущиеДанные.КатегорияДовольствующихсяКод);
		ВыбранноеЗначениеСсылка = Неопределено;
		ВыбранноеЗначение.Свойство("Ссылка", ВыбранноеЗначениеСсылка);
		ВыбранноеЗначение = ВыбранноеЗначениеСсылка;
	КонецЕсли;
	
КонецПроцедуры

