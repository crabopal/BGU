			+ "_" + СтрокаТаблицы.ПриемПищи.Код
			+ "_" + СтрокаТаблицы.Блюдо.Код
			+ "_" + СтрокаТаблицы.Спецификация.Код;
	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УдалитьСоставБлюда(КатегорияДовольствующихся, ВариантМеню, ПриемПищи = Неопределено, Блюдо = Неопределено)

	СтруктураПоиска = Новый Структура("КатегорияДовольствующихся, ВариантМеню", КатегорияДовольствующихся, ВариантМеню);
	Если ЗначениеЗаполнено(ПриемПищи) Тогда
		СтруктураПоиска.Вставить("ПриемПищи", ПриемПищи);
	КонецЕсли;
	Если ЗначениеЗаполнено(Блюдо) Тогда
		СтруктураПоиска.Вставить("Блюдо", Блюдо);
	КонецЕсли;
		
	НайденныеСтроки = Объект.СоставБлюда.НайтиСтроки(СтруктураПоиска);
	Для каждого СтрокаКУдалению Из НайденныеСтроки Цикл
	
		Объект.СоставБлюда.Удалить(СтрокаКУдалению);
	
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюРеквизитов(Форма, Объект)

	ИменаЭлементовВозврат = Новый Массив;
	ИменаЭлементовВозврат.Добавить("МатериалыЦена");
	ИменаЭлементовВозврат.Добавить("МатериалыСумма");
	ИменаЭлементовВозврат.Добавить("ИтогоСумма");
	
	ИменаЭлементовНеВозврат = Новый Массив;
	ИменаЭлементовНеВозврат.Добавить("ЗаполнитьДокумент");
	ИменаЭлементовНеВозврат.Добавить("ЗаполнитьМенюРаскладку");
	ИменаЭлементовНеВозврат.Добавить("ЗаполнитьСоставБлюд");
	ИменаЭлементовНеВозврат.Добавить("ЗаполнитьПродуктыАвтоматически");
	ИменаЭлементовНеВозврат.Добавить("ЗаполнитьПродуктыВручную");
	ИменаЭлементовНеВозврат.Добавить("ВывестиОстатки");
	ИменаЭлементовНеВозврат.Добавить("ПереключательРезервирование");
	ИменаЭлементовНеВозврат.Добавить("Аннулирован");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементовВозврат,
		"Видимость", Объект.ЭтоВозврат);
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементовНеВозврат,
		"Видимость", НЕ Объект.ЭтоВозврат);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЭтоДополнительноеМенюТумблер",
		"Доступность", НЕ Объект.ЭтоВозврат);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДобавитьКОсновномуКонтингенту",
		"Доступность", Объект.ЭтоДополнительноеМенюТребование);

КонецПроцедуры

&НаСервере
Процедура УстановитьВыходПродукта(ТекущиеДанные, ПорядокМеню)

	Если ЗначениеЗаполнено(ТекущиеДанные.ПриемПищи)
		И ЗначениеЗаполнено(ТекущиеДанные.Блюдо)
		И ЗначениеЗаполнено(ТекущиеДанные.Спецификация)
		И ЗначениеЗаполнено(ТекущиеДанные.ВариантМеню)
		И ЗначениеЗаполнено(ПорядокМеню) Тогда
		
		СтруктураЗапроса = Новый Структура("ВариантМеню, Порядок, ПриемПищи, Блюдо, Спецификация",
			ТекущиеДанные.ВариантМеню,
			ПорядокМеню,
			ТекущиеДанные.ПриемПищи,
			ТекущиеДанные.Блюдо,
			ТекущиеДанные.Спецификация);
		
		ТекущиеДанные.Выход = ПрочитатьВыходПродукта(СтруктураЗапроса);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьВыходПродукта(СтруктураЗапроса)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТиповыеМеню.Выход КАК Выход
	|ИЗ
	|	РегистрСведений.ТиповыеМеню КАК ТиповыеМеню
	|ГДЕ
	|	ТиповыеМеню.ВариантМеню = &ВариантМеню
	|	И ТиповыеМеню.ПриемПищи = &ПриемПищи
	|	И ТиповыеМеню.Блюдо = &Блюдо
	|	И ТиповыеМеню.Спецификация = &Спецификация
	|	И ТиповыеМеню.Порядок = &Порядок";
	Запрос.УстановитьПараметр("ВариантМеню",	СтруктураЗапроса.ВариантМеню);
	Запрос.УстановитьПараметр("ПриемПищи",		СтруктураЗапроса.ПриемПищи);
	Запрос.УстановитьПараметр("Блюдо",			СтруктураЗапроса.Блюдо);
	Запрос.УстановитьПараметр("Спецификация",	СтруктураЗапроса.Спецификация);
	Запрос.УстановитьПараметр("Порядок",		СтруктураЗапроса.Порядок);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Если ЗначениеЗаполнено(СтруктураЗапроса.Спецификация) Тогда
			// Получить выход из спецификации
			Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураЗапроса.Спецификация, "Выход");
		КонецЕсли;
		Возврат 0;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Выход;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция КодПриемаПищи(Знач ПриемПищи)

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПриемПищи, "Код");

КонецФункции // КодПриемаПищи()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПереключательВидМенюТребования(Форма, Объект)

	Форма.ЭтоДополнительноеМенюТумблер = ?(Объект.ЭтоДополнительноеМенюТребование, 1, 0);

КонецПроцедуры

&НаСервере
Функция ПолучитьЦену(Номенклатура, ИФО, КФО, КатегорияДовольствующихся)
	СписокНоменклатуры = Новый СписокЗначений();
	СписокНоменклатуры.Добавить(Номенклатура);
	СписокЦен = ПолучитьЦены(СписокНоменклатуры);
	СтруктураПоиска = Новый Структура("КФО",КФО);
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда 
		СтруктураПоиска.Вставить("ИФО",ИФО);
	КонецЕсли;	
	СтруктураПоиска.Вставить("КатегорияДовольствующихся",КатегорияДовольствующихся);
	СтруктураПоиска.Вставить("Номенклатура",Номенклатура);
	НайденныеЦены = СписокЦен.НайтиСтроки(СтруктураПоиска);
	Если НайденныеЦены.Количество() <> 0 Тогда 
		Возврат НайденныеЦены[0].Цена;	
	КонецЕсли;
	Возврат 0;
КонецФункции	

&НаСервере
Функция ПолучитьЦены(СписокНоменклатуры)
	ТекстЗапроса = "ВЫБРАТЬ
	               |	РасходПродуктов.Номенклатура КАК Номенклатура,
	               |	РасходПродуктов.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
	               |	РасходПродуктов.КФО КАК КФО,
	               |	ВЫБОР
	               |		КОГДА &ВедетсяУчетПоИФО
	               |			ТОГДА РасходПродуктов.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ КАК ИФО,
	               |	СРЕДНЕЕ(ВЫБОР
	               |			КОГДА РасходПродуктов.Количество = 0
	               |				ТОГДА 0
	               |			ИНАЧЕ РасходПродуктов.Сумма / РасходПродуктов.Количество
	               |		КОНЕЦ) КАК Цена
	               |ИЗ
	               |	РегистрНакопления.РасходПродуктов КАК РасходПродуктов
	               |ГДЕ
	               |	РасходПродуктов.Сумма > 0
	               |	И РасходПродуктов.Организация = &Организация
	               |	И РасходПродуктов.Номенклатура В(&СписокНоменклатуры)
	               |	И РасходПродуктов.Период >= &НачалоПериода
	               |	И РасходПродуктов.Период <= &КонецПериода
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РасходПродуктов.Номенклатура,
	               |	РасходПродуктов.КатегорияДовольствующихся,
	               |	РасходПродуктов.КФО,
	               |	ВЫБОР
	               |		КОГДА &ВедетсяУчетПоИФО
	               |			ТОГДА РасходПродуктов.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СписокНоменклатуры",СписокНоменклатуры);
	Запрос.УстановитьПараметр("НачалоПериода",НачалоДня(Объект.Дата));
	Запрос.УстановитьПараметр("КонецПериода",КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Запрос.УстановитьПараметр("ВедетсяУчетПоИФО",ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО);
	Выборка = Запрос.Выполнить().Выгрузить();
	Возврат Выборка;
	
КонецФункции

&НаСервере
Процедура МатериалыЗаполнитьЦены()
	ВедетсяУчетПоИФО = ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО;
	ТаблицаНоменклатура = Объект.Материалы.Выгрузить(,"Номенклатура");
	СписокЦен = ПолучитьЦены(ТаблицаНоменклатура);
	СписокИндексов = "КФО,КатегорияДовольствующихся,Номенклатура";
	Если ВедетсяУчетПоИФО Тогда 
		СписокИндексов = СписокИндексов + ",ИФО";	
	КонецЕсли;	
	СписокЦен.Индексы.Добавить(СписокИндексов);
	Для Каждого СтрокаМатериалы Из Объект.Материалы Цикл  
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("КФО",СтрокаМатериалы.КФО);
		СтруктураПоиска.Вставить("КатегорияДовольствующихся",СтрокаМатериалы.КатегорияДовольствующихся);
		СтруктураПоиска.Вставить("Номенклатура",СтрокаМатериалы.Номенклатура);
		Если ВедетсяУчетПоИФО Тогда 
			СтруктураПоиска.Вставить("ИФО",СтрокаМатериалы.ИФО);
		КонецЕсли;
		НайденныеЦены = СписокЦен.НайтиСтроки(СтруктураПоиска);
		Если НайденныеЦены.Количество() <> 0 Тогда 
			СтрокаМатериалы.Цена = НайденныеЦены[0].Цена;
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры	

&НаКлиенте
Процедура МатериалыПересчитатьСумму(ТекущиеДанные)
	Если Объект.ЭтоВозврат Тогда
		ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ТекущиеДанные.Цена;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыРасчитатьЦенуСумму(ТекущиеДанные)
	ИФОЗаполнен = ?(ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО,ЗначениеЗаполнено(ТекущиеДанные.ИФО),Истина);
	Если Объект.ЭтоВозврат И ЗначениеЗаполнено(ТекущиеДанные.КФО) И ЗначениеЗаполнено(ТекущиеДанные.КатегорияДовольствующихся) И ИФОЗаполнен Тогда
		ТекущиеДанные.Цена = ПолучитьЦену(ТекущиеДанные.Номенклатура,ТекущиеДанные.ИФО,ТекущиеДанные.КФО,ТекущиеДанные.КатегорияДовольствующихся);	
		ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ТекущиеДанные.Цена;
	КонецЕсли;
КонецПроцедуры	

