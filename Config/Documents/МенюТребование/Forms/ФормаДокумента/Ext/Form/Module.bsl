#Область ОбработчикиСобытийЭлементовТаблицыФормыСоставБлюда

&НаКлиенте
Процедура СоставБлюдаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	ТекущееМеню = Элементы.МенюРаскладка.ТекущиеДанные;
	Если ТекущееМеню = Неопределено ИЛИ Не ЗначениеЗаполнено(ТекущееМеню.ПриемПищи) Тогда
		ТекстПредупреждения=НСтр("ru='Перед добавлением блюда необходимо заполнить прием пищи'");
		Отказ = Истина;
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
	ИначеЕсли Не ЗначениеЗаполнено(ТекущееМеню.Блюдо) Тогда
		ТекстПредупреждения=НСтр("ru='Перед добавлением блюда необходимо заполнить блюдо'");
		Отказ = Истина;
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
	ИначеЕсли Не ЗначениеЗаполнено(ТекущееМеню.Спецификация) Тогда
		ТекстПредупреждения=НСтр("ru='Перед добавлением блюда необходимо заполнить спецификацию'");
		Отказ = Истина;
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставБлюдаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		КатегорияНовСтроки 		= Неопределено;
		ПриемПищиНовСтроки 		= Неопределено;
		СпецификацияНовСтроки	= Неопределено;
		БлюдоНовСтроки 			= Неопределено;
		ВариантМенюНовСтроки 	= Неопределено;
		КлючОтбора 				= Неопределено;
		
		ТекОтборСтрок = Элементы.СоставБлюда.ОтборСтрок;
		Если ТекОтборСтрок <> Неопределено Тогда
			ТекОтборСтрок.Свойство("КатегорияДовольствующихся",	КатегорияНовСтроки);
			ТекОтборСтрок.Свойство("ПриемПищи", 				ПриемПищиНовСтроки);
			ТекОтборСтрок.Свойство("Блюдо", 					БлюдоНовСтроки);	
			ТекОтборСтрок.Свойство("Спецификация", 				СпецификацияНовСтроки);
			ТекОтборСтрок.Свойство("ВариантМеню", 				ВариантМенюНовСтроки);
			ТекОтборСтрок.Свойство("КлючОтбора", 				КлючОтбора);
		КонецЕсли;
		Элементы.СоставБлюда.ТекущиеДанные.КатегорияДовольствующихся	= КатегорияНовСтроки;
		Элементы.СоставБлюда.ТекущиеДанные.ПриемПищи 					= ПриемПищиНовСтроки;
		Элементы.СоставБлюда.ТекущиеДанные.Блюдо 						= БлюдоНовСтроки;
		Элементы.СоставБлюда.ТекущиеДанные.Спецификация 				= СпецификацияНовСтроки;
		Элементы.СоставБлюда.ТекущиеДанные.ВариантМеню	 				= ВариантМенюНовСтроки;
		Элементы.СоставБлюда.ТекущиеДанные.КлючОтбора	 				= КлючОтбора;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыМатериалы

&НаКлиенте
Процедура МатериалыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	ТекущиеДанные = Элементы.КатегорииДовольствующихся.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекущиеДанные.КатегорияДовольствующихся) Тогда
		Отказ = Истина;
		ТекстПредупреждения = НСтр("ru='Перед добавлением продуктов необходимо выбрать категорию довольствующихся.'");
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения, 60);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущиеДанныеМатериалы = Элементы.Материалы.ТекущиеДанные;
		ТекущиеДанныеКатегории = Элементы.КатегорииДовольствующихся.ТекущиеДанные;
		ТекущиеДанныеМатериалы.КатегорияДовольствующихся = ТекущиеДанныеКатегории.КатегорияДовольствующихся;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	УправлениеМатериальнымиЗапасамиКлиент.УстановитьСчетУчетПоНоменклатуреВСтрокеМатериалов(ТекущиеДанные, Объект,);
	МатериалыРасчитатьЦенуСумму(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	
	МатериалыПересчитатьСумму(ТекущиеДанные);
	
	Если Объект.СоставБлюда.Количество() Тогда
		ОтборСостав = Новый Структура("Номенклатура, КатегорияДовольствующихся", ТекущиеДанные.Номенклатура, ТекущиеДанные.КатегорияДовольствующихся);
		ЕстьИзмененияСостава = Ложь;
		РаспределитьКоличествоПоСоставу(ОтборСостав, ЕстьИзмененияСостава);
		Если ЕстьИзмененияСостава Тогда
			ПоказатьОповещениеПользователя("Изменение:",,"Пересчет количества в составе блюд выполнен", БиблиотекаКартинок.Информация32);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыЦенаПриИзменении(Элемент)
	
	МатериалыПересчитатьСумму(Элементы.Материалы.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыИФОПриИзменении(Элемент)
	
	МатериалыРасчитатьЦенуСумму(Элементы.Материалы.ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура МатериалыКФОПриИзменении(Элемент)
	
	МатериалыРасчитатьЦенуСумму(Элементы.Материалы.ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	
	ТекстВопроса = "";
	Если Объект.КатегорииДовольствующихся.Количество() > 0
	 ИЛИ Объект.МенюРаскладка.Количество() > 0
	 ИЛИ Объект.СоставБлюда.Количество() > 0
	 ИЛИ Объект.Материалы.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Документ будет заполнен по категориям, для которых установлено количество довольствующихся.
			|Данные документа будут очищены.
			|Продолжить?'");
	Иначе
		ТекстВопроса = НСтр("ru = 'Документ будет заполнен по категориям, для которых установлено количество довольствующихся.
			|Продолжить?'");
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьДокументЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокументЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Объект.КатегорииДовольствующихся.Очистить();
	Объект.МенюРаскладка.Очистить();
	Объект.СоставБлюда.Очистить();
	Объект.Материалы.Очистить();
	
	ЗаполнитьТЧДокумента(Новый Структура("КатегорииДовольствующихся, МенюРаскладка, СоставБлюда, Материалы"));
	
	Если Объект.КатегорииДовольствующихся.Количество() > 0 Тогда
		// Сделаем активной первую категорию довольствующихся.
		// Отборы в связанных таблицах будут установлены из обработчика ПриАктивизацииСтроки.
		Элементы.КатегорииДовольствующихся.ТекущаяСтрока = Объект.КатегорииДовольствующихся[0].ПолучитьИдентификатор();
	КонецЕсли;
	
