&НаКлиенте
Процедура КатегорииДовольствующихсяВариантМенюОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.КатегорииДовольствующихся.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийВариантМеню = ТекущиеДанные.ВариантМеню;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ВыбранноеЗначение.Свойство("Код", ТекущиеДанные.ВариантМенюКод);
		ВыбранноеЗначениеСсылка = Неопределено;
		ВыбранноеЗначение.Свойство("Ссылка", ВыбранноеЗначениеСсылка);
		ВыбранноеЗначение = ВыбранноеЗначениеСсылка;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КатегорииДовольствующихсяВариантМенюПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.КатегорииДовольствующихся.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущийВариантМеню) Тогда
		
		Если ТекущийВариантМеню <> ТекущиеДанные.ВариантМеню Тогда
			
			Если Объект.МенюРаскладка.Количество() Тогда
				ТекстВопроса = НСтр("ru='Перезаполнить данные во всех таблицах документа?'");
				ДопПараметры = Новый Структура ("ТекущиеДанные, ЗначениеДоИзменения, ИмяРеквизита", ТекущиеДанные, ТекущийВариантМеню, "ВариантМеню");
				ПоказатьВопрос(Новый ОписаниеОповещения("ВариантМенюКатегорияПриИзмененииЗавершение", ЭтотОбъект, ДопПараметры),
				ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			КонецЕсли;
			
		КонецЕсли;
		
		ТекущийВариантМеню = Неопределено;
		
	Иначе
		
		УстановитьОтборСтрокМенюРаскладки();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантМенюКатегорияПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Объект.МенюРаскладка.Очистить();
		Объект.СоставБлюда.Очистить();
		Объект.Материалы.Очистить();
		ЗаполнитьТЧДокумента(Новый Структура("МенюРаскладка, СоставБлюда, Материалы"));
	Иначе
		ТекущиеДанные[ДополнительныеПараметры.ИмяРеквизита] = ДополнительныеПараметры.ЗначениеДоИзменения;
	КонецЕсли;
	
	УстановитьОтборСтрокМенюРаскладки();
	УстановитьОтборСоставаБлюда();
	УстановитьОтборСтрокМатериалов();
	
КонецПроцедуры

&НаКлиенте
Процедура КатегорииДовольствующихсяПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекущиеДанные = Элементы.КатегорииДовольствующихся.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.КатегорияДовольствующихся) Тогда
		Если КоличествоДовольствующихся<>ТекущиеДанные.Количество И КоличествоДовольствующихся<>0 Тогда
			ТекстВопроса = НСтр("ru='Изменилось количество довольствующихся с %1 на %2.
									|Рекомендуется пересчитать меню-раскладку.
									|Пересчитать?'");
			ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, КоличествоДовольствующихся, ТекущиеДанные.Количество);
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru='Пересчитать'"));
			Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='Не пересчитывать'"));
			ПоказатьВопрос(
				Новый ОписаниеОповещения("КатегорииДовольствующихсяПриОкончанииРедактированияЗавершение", 
					ЭтотОбъект, Новый Структура("ТекущиеДанные", ТекущиеДанные)), 
				ТекстВопроса, Кнопки, ,КодВозвратаДиалога.Да);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КатегорииДовольствующихсяПриОкончанииРедактированияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Для каждого ТекСтрокаМеню Из Объект.МенюРаскладка Цикл
			
			Если ТекСтрокаМеню.КатегорияДовольствующихся = ТекущиеДанные.КатегорияДовольствующихся
				И ТекСтрокаМеню.ВариантМеню = ТекущиеДанные.ВариантМеню Тогда
				ТекСтрокаМеню.Количество = ТекущиеДанные.Количество;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КатегорииДовольствующихсяПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элементы.КатегорииДовольствующихся.ТекущиеДанные;
	КоличествоДовольствующихся = ТекущиеДанные.Количество;
КонецПроцедуры

&НаКлиенте
Процедура КатегорииДовольствующихсяПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	ТекущиеДанные = Элементы.КатегорииДовольствующихся.ТекущиеДанные;
	КатегорииДовольствующихсяПередУдалениемНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	
	УстановитьОтборСтрокМенюРаскладки();
	УстановитьОтборСоставаБлюда();
	УстановитьОтборСтрокМатериалов();
	
КонецПроцедуры

&НаСервере
Процедура КатегорииДовольствующихсяПередУдалениемНаСервере(Идентификатор)

	ТекущиеДанные = Объект.КатегорииДовольствующихся.НайтиПоИдентификатору(Идентификатор);
	НомерСтроки = ТекущиеДанные.НомерСтроки-1;
	
	МенюОбъект = РеквизитФормыВЗначение("Объект");
	ТекущаяСтрока = МенюОбъект.КатегорииДовольствующихся[НомерСтроки];
	
	СтруктураПоиска = Новый Структура("КатегорияДовольствующихся, ВариантМеню",
		ТекущаяСтрока.КатегорияДовольствующихся, ТекущаяСтрока.ВариантМеню);
	
	// Удалим связанные строки таблицы МенюРаскладка.
	НайденныеСтроки = МенюОбъект.МенюРаскладка.НайтиСтроки(СтруктураПоиска);
	Для каждого СтрокаКУдалению Из НайденныеСтроки Цикл
		МенюОбъект.МенюРаскладка.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	// Удалим связанные строки таблицы СоставБлюда.
	НайденныеСтроки = МенюОбъект.СоставБлюда.НайтиСтроки(СтруктураПоиска);
	Для каждого СтрокаКУдалению Из НайденныеСтроки Цикл
		МенюОбъект.СоставБлюда.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	// Удалим связанные строки таблицы Материалы.
	СтруктураПоиска = Новый Структура("КатегорияДовольствующихся",
		ТекущаяСтрока.КатегорияДовольствующихся);
	НайденныеСтроки = МенюОбъект.Материалы.НайтиСтроки(СтруктураПоиска);
	Для каждого СтрокаКУдалению Из НайденныеСтроки Цикл
		МенюОбъект.Материалы.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	// Теперь удалим саму строку в таблице КатегорииДовольствующихся.
	МенюОбъект.КатегорииДовольствующихся.Удалить(ТекущаяСтрока);
	
	ЗначениеВРеквизитФормы(МенюОбъект, "Объект");
	
	ЗаполнитьКодыКатегорииДовольствующихся();
	ЗаполнитьКодыМенюРаскладки();
	ЗаполнитьКодыСоставаБлюда();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыМенюРаскладка

// В табличную часть добавлена колонка КлючОтбора.
// Колонка содержит КатегорияДовольствующихся.Код+ВариантМеню.Код

&НаКлиенте
Процедура МенюРаскладкаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	ТекущаяКатегория = Элементы.КатегорииДовольствующихся.ТекущиеДанные;
	
	ТекстПредупреждения = "";
	Если ТекущаяКатегория = Неопределено Тогда
		ТекстПредупреждения=НСтр("ru='Перед добавлением блюда необходимо добавить категорию довольствующихся и вариант меню'");
	ИначеЕсли Не ЗначениеЗаполнено(ТекущаяКатегория.КатегорияДовольствующихся) Тогда
		ТекстПредупреждения=НСтр("ru='Перед добавлением блюда необходимо выбрать категорию довольствующихся'");
	ИначеЕсли Не ЗначениеЗаполнено(ТекущаяКатегория.ВариантМеню) Тогда
		ТекстПредупреждения=НСтр("ru='Перед добавлением блюда необходимо выбрать вариант меню'");
	КонецЕсли;
	Если НЕ ПустаяСтрока(ТекстПредупреждения) Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МенюРаскладкаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		КатегорияНовСтроки		= Неопределено;
		ВариантМенюНовСтроки	= Неопределено;
		КлючОтбора				= Неопределено;
		Если Элементы.МенюРаскладка.ОтборСтрок <> Неопределено Тогда
			Элементы.МенюРаскладка.ОтборСтрок.Свойство("КлючОтбора",				КлючОтбора);	
			Элементы.МенюРаскладка.ОтборСтрок.Свойство("КатегорияДовольствующихся",	КатегорияНовСтроки);	
			Элементы.МенюРаскладка.ОтборСтрок.Свойство("ВариантМеню",				ВариантМенюНовСтроки);	
		КонецЕсли;
		ТекущиеДанные = Элементы.МенюРаскладка.ТекущиеДанные;
		ТекущиеДанные.КатегорияДовольствующихся	= КатегорияНовСтроки;
		ТекущиеДанные.ВариантМеню				= ВариантМенюНовСтроки;
		ТекущиеДанные.КлючОтбора 				= КлючОтбора;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МенюРаскладкаПриАктивизацииСтроки(Элемент)
	
	УстановитьОтборСоставаБлюда();
	
КонецПроцедуры

&НаКлиенте
Процедура МенюРаскладкаПриемПищиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.МенюРаскладка.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ВыбранноеЗначение.Свойство("Код", ТекущиеДанные.ПриемПищиКод);
		ВыбранноеЗначениеСсылка = Неопределено;
		ВыбранноеЗначение.Свойство("Ссылка", ВыбранноеЗначениеСсылка);
		ВыбранноеЗначение = ВыбранноеЗначениеСсылка;
	Иначе
		ТекущиеДанные.ПриемПищиКод = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МенюРаскладкаПриемПищиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.МенюРаскладка.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущиеДанные.ПриемПищи) Тогда
		Если Не ЗначениеЗаполнено(ТекущиеДанные.ПриемПищиКод) Тогда
			ТекущиеДанные.ПриемПищиКод = КодПриемаПищи(ТекущиеДанные.ПриемПищи);
		КонецЕсли;
	Иначе
		ТекущиеДанные.ПриемПищиКод = "";
	КонецЕсли;
	УстановитьОтборСоставаБлюда();
	
КонецПроцедуры

&НаКлиенте
Процедура МенюРаскладкаБлюдоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.МенюРаскладка.ТекущиеДанные;
	
	ТребуемыеДанные = "Код";
	ПараметрыФормы = Новый Структура("ТекущаяСтрока, ТребуемыеДанные, Отбор",
		ТекущиеДанные.Блюдо,
		ТребуемыеДанные,
		Новый Структура("ТипНоменклатуры", ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Блюдо")));
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, Элемент);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

