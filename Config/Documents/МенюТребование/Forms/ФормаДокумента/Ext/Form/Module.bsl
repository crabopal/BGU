&НаСервере
Процедура ЗагрузитьТаблицуМатериаловИзХранилищаЗначений(АдресВХранилище, ЕстьИзмененияСостава)

	ТаблицаМатериалов = ПолучитьИзВременногоХранилища(АдресВХранилище);
	Если ТипЗнч(ТаблицаМатериалов) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.СоставБлюда.Количество() Тогда
		ТаблицаИзмененийМатериалы = ИзмененияТаблицыМатериалов(ТаблицаМатериалов, Объект.Материалы.Выгрузить());
		Если ТаблицаИзмененийМатериалы.Количество() Тогда
			РаспределитьКоличествоПоСоставу(ТаблицаИзмененийМатериалы, ЕстьИзмененияСостава);
		КонецЕсли;
	КонецЕсли;
	
	Объект.Материалы.Загрузить(ТаблицаМатериалов);
	
	ЗаполнитьКодыКатегорииДовольствующихся();
	ЗаполнитьКодыМенюРаскладки();
	ЗаполнитьКодыСоставаБлюда();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЗависимыхЭлементов(Форма, Объект)

	РеквизитыПоОрганизации = Новый Массив;
	РеквизитыПоОрганизации.Добавить("ЦМО");
	РеквизитыПоОрганизации.Добавить("Подразделение");
	РеквизитыПоОрганизации.Добавить("КатегорииДовольствующихся");
	РеквизитыПоОрганизации.Добавить("МенюРаскладка");
	РеквизитыПоОрганизации.Добавить("СоставБлюда");
	РеквизитыПоОрганизации.Добавить("Бухгалтер");
	РеквизитыПоОрганизации.Добавить("Врач");
	РеквизитыПоОрганизации.Добавить("Повар");
	РеквизитыПоОрганизации.Добавить("Кладовщик");

	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, РеквизитыПоОрганизации,
		"Доступность", ЗначениеЗаполнено(Объект.Организация));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧДокумента(СтруктураТЧ)

	ТекДокумент = РеквизитФормыВЗначение("Объект");
	ТекДокумент.ЗаполнитьДокумент(СтруктураТЧ);
	ЗначениеВРеквизитФормы(ТекДокумент, "Объект");
	Модифицированность = ТекДокумент.Модифицированность();
	
	ЗаполнитьКодыКатегорииДовольствующихся();
	ЗаполнитьКодыМенюРаскладки();
	ЗаполнитьКодыСоставаБлюда();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрокМенюРаскладки()
	
	ТекущиеДанные = Элементы.КатегорииДовольствующихся.ТекущиеДанные;
	КлючОтбора = "";
	Если ТекущиеДанные<>Неопределено
		И ЗначениеЗаполнено(ТекущиеДанные.КатегорияДовольствующихся)
		И ЗначениеЗаполнено(ТекущиеДанные.ВариантМеню) Тогда
		КлючОтбора = ""+ТекущиеДанные.КатегорияДовольствующихсяКод+"_"+ТекущиеДанные.ВариантМенюКод;
	КонецЕсли;
	
	Если ПустаяСтрока(КлючОтбора) Тогда
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("КлючОтбора, КатегорияДовольствующихся, ВариантМеню",
			КлючОтбора,
			ПредопределенноеЗначение("Справочник.КатегорииДовольствующихся.ПустаяСсылка"),
			ПредопределенноеЗначение("Справочник.ВариантыМеню.ПустаяСсылка"));
	Иначе
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("КлючОтбора, КатегорияДовольствующихся, ВариантМеню",
			КлючОтбора,
			ТекущиеДанные.КатегорияДовольствующихся,
			ТекущиеДанные.ВариантМеню);
	КонецЕсли;	
	
	ТекущийОтборСтрок = Элементы.МенюРаскладка.ОтборСтрок;
	
	Если ТекущийОтборСтрок = Неопределено ИЛИ ТекущийОтборСтрок.КлючОтбора <> НовыйОтборСтрок.КлючОтбора Тогда
		Элементы.МенюРаскладка.ОтборСтрок = НовыйОтборСтрок;
	КонецЕсли;
	
	УстановитьАктивнуюСтрокуСУчетомОтбора("МенюРаскладка");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСоставаБлюда()

	ТекущиеДанные = Элементы.МенюРаскладка.ТекущиеДанные;
	КлючОтбора = "";
	Если ТекущиеДанные<>Неопределено
		И ЗначениеЗаполнено(ТекущиеДанные.ПриемПищи)
		И ЗначениеЗаполнено(ТекущиеДанные.Блюдо)
		И ЗначениеЗаполнено(ТекущиеДанные.Спецификация) Тогда
		КлючОтбора = ТекущиеДанные.КлючОтбора + "_" + ТекущиеДанные.ПриемПищиКод + "_" + ТекущиеДанные.БлюдоКод + "_" + ТекущиеДанные.СпецификацияКод;
	КонецЕсли;
	
	Если ПустаяСтрока(КлючОтбора) Тогда
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("КлючОтбора, КатегорияДовольствующихся, ВариантМеню, ПриемПищи, Блюдо, Спецификация",
			КлючОтбора,
			ПредопределенноеЗначение("Справочник.КатегорииДовольствующихся.ПустаяСсылка"),
			ПредопределенноеЗначение("Справочник.ВариантыМеню.ПустаяСсылка"),
			ПредопределенноеЗначение("Справочник.ПриемыПищи.ПустаяСсылка"),
			ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"),
			ПредопределенноеЗначение("Справочник.СпецификацииНоменклатуры.ПустаяСсылка"));
	Иначе
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("КлючОтбора, КатегорияДовольствующихся, ВариантМеню, ПриемПищи, Блюдо, Спецификация",
			КлючОтбора,
			ТекущиеДанные.КатегорияДовольствующихся,
			ТекущиеДанные.ВариантМеню,
			ТекущиеДанные.ПриемПищи,
			ТекущиеДанные.Блюдо,
			ТекущиеДанные.Спецификация);
	КонецЕсли;
	
	ТекущийОтборСтрок = Элементы.СоставБлюда.ОтборСтрок;
	
	Если ТекущийОтборСтрок = Неопределено ИЛИ ТекущийОтборСтрок.КлючОтбора <> НовыйОтборСтрок.КлючОтбора Тогда
		Элементы.СоставБлюда.ОтборСтрок = НовыйОтборСтрок;
	КонецЕсли;
	
	УстановитьАктивнуюСтрокуСУчетомОтбора("СоставБлюда");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрокМатериалов()
	
	ТекущиеДанные = Элементы.КатегорииДовольствующихся.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Элементы.Материалы.ОтборСтрок =
			Новый ФиксированнаяСтруктура("КатегорияДовольствующихся", "");
	Иначе
		Элементы.Материалы.ОтборСтрок =
			Новый ФиксированнаяСтруктура("КатегорияДовольствующихся", ТекущиеДанные.КатегорияДовольствующихся);
	КонецЕсли;
	
	УстановитьАктивнуюСтрокуСУчетомОтбора("Материалы");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьАктивнуюСтрокуСУчетомОтбора(ИмяТабЧасти)
	
	Для Каждого СтрокаТаблицы Из Объект[ИмяТабЧасти] Цикл
		ИдентификаторСтроки = СтрокаТаблицы.ПолучитьИдентификатор();
		УдовлетворяетОтбору = (Элементы[ИмяТабЧасти].ПроверитьСтроку(ИдентификаторСтроки) = Истина);
		Если УдовлетворяетОтбору Тогда
			Элементы[ИмяТабЧасти].ТекущаяСтрока = ИдентификаторСтроки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

