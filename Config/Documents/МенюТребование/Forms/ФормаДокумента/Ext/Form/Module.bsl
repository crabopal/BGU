&НаКлиенте
Процедура ЗаполнитьПродуктыВручную(Команда)
	
	ПараметрыФормы = Новый Структура("ЗакрыватьПриЗакрытииВладельца", Истина);
	МассивКатегорий = Новый Массив;
	Для каждого СтрокаКД Из Объект.КатегорииДовольствующихся Цикл
		МассивКатегорий.Добавить(СтрокаКД.КатегорияДовольствующихся);
	КонецЦикла;
	МассивКатегорий = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивКатегорий);
	ПараметрыФормы.Вставить("КатегорииДовольствующихся",	МассивКатегорий);
	ПараметрыФормы.Вставить("СохраненныеПродуктыАдрес",		ПоместитьМатериалыВоВременноеХранилище());
	ПараметрыФормы.Вставить("Организация",					Объект.Организация);
	ПараметрыФормы.Вставить("Ссылка",						Объект.Ссылка);
	ПараметрыФормы.Вставить("Дата",							Объект.Дата);
	ПараметрыФормы.Вставить("ЦМО",							Объект.ЦМО);
	ПараметрыФормы.Вставить("Подразделение",				Объект.Подразделение);
	ОткрытьФорму("Документ.МенюТребование.Форма.ФормаРучногоЗаполнения", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

