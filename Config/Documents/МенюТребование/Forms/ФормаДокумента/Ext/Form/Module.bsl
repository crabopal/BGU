&НаКлиенте
Процедура МенюРаскладкаПриИзмененииРеквизитовБлюда(ЗаполнитьСпецификацию = Ложь)
	
	ТекущиеДанные = Элементы.МенюРаскладка.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеКатегорииДовольствующихся = Элементы.КатегорииДовольствующихся.ТекущиеДанные;
	Если ТекущиеДанныеКатегорииДовольствующихся = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПриИзмененииСтрокиМенюСервер(ТекущиеДанные.ПолучитьИдентификатор(), ТекущиеДанныеКатегорииДовольствующихся.ПорядокМеню, ЗаполнитьСпецификацию);
		
	УстановитьОтборСоставаБлюда();

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСтрокиМенюСервер(ИдентификаторСтроки, ПорядокМеню, ЗаполнитьСпецификацию)
	
	ТекущаяСтрока = Объект.МенюРаскладка.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если ЗаполнитьСпецификацию Тогда
		ТекущаяСтрока.Спецификация = Справочники.СпецификацииНоменклатуры.ДанныеСпецификацииБлюда(ТекущаяСтрока.Блюдо).Спецификация;
	КонецЕсли;

	УстановитьВыходПродукта(ТекущаяСтрока, ПорядокМеню);
		
	ДанныеТекущейСтроки = Новый Структура("КатегорияДовольствующихся, ВариантМеню, ПриемПищи, Блюдо, Спецификация, НомерСтроки");
	ЗаполнитьЗначенияСвойств(ДанныеТекущейСтроки, ТекущаяСтрока);

	ЗаполнитьТЧДокумента(Новый Структура("СоставБлюда, ТекущееБлюдо",
		Неопределено,
		ДанныеТекущейСтроки));

КонецПроцедуры

&НаСервере
Процедура РаспределитьКоличествоПоСоставу(ИзмененияМатериалы, ЕстьИзмененияСостава)
	
	Если ТипЗнч(ИзмененияМатериалы) = Тип("Структура") Тогда
		ТаблицаИзменений = Объект.Материалы.Выгрузить(ИзмененияМатериалы);
		ТаблицаИзменений.Свернуть("КатегорияДовольствующихся, Номенклатура", "Количество");
	Иначе
		ТаблицаИзменений = ИзмененияМатериалы;
	КонецЕсли;
	
	ТаблицаСостав = ТаблицаСоставДляРаспределения(ТаблицаИзменений);
	Если ТаблицаСостав.Количество() Тогда
		ТаблицаСостав.Индексы.Добавить("КатегорияДовольствующихся, Номенклатура");
		
		Для Каждого СтрокаИзменений Из ТаблицаИзменений Цикл
			Если СтрокаИзменений.Количество > 0 Тогда
				ОтборСостав = Новый Структура("КатегорияДовольствующихся, Номенклатура", СтрокаИзменений.КатегорияДовольствующихся, СтрокаИзменений.Номенклатура);
				ТаблицаСоставТекущийОтбор = ТаблицаСостав.Скопировать(ОтборСостав);
				МассивКоличества = ТаблицаСоставТекущийОтбор.ВыгрузитьКолонку("ВсегоРасход");
				МассивКоличества = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаИзменений.Количество, МассивКоличества, 7);
				
				ПогрешностьРаспределения = 0;
				Для Индекс =0 По ТаблицаСоставТекущийОтбор.Количество()-1 Цикл
					СтрокаСостав = ТаблицаСоставТекущийОтбор[Индекс];
					СтрокаСостав.ВсегоРасход = МассивКоличества[Индекс];
					СтрокаСостав.Количество = Окр(СтрокаСостав.ВсегоРасход/СтрокаСостав.КоличествоДовольствующихся, 6);
					ПогрешностьРаспределения = ПогрешностьРаспределения + (СтрокаСостав.ВсегоРасход - СтрокаСостав.Количество * СтрокаСостав.КоличествоДовольствующихся);
					Объект.СоставБлюда[СтрокаСостав.НомерСтроки - 1].Количество = СтрокаСостав.Количество;
				КонецЦикла;
				
				Если ПогрешностьРаспределения <> 0 Тогда
					СтрокаСоставМаксимальныйВес = ТаблицаСоставТекущийОтбор[0];
					ПогрешностьРаспределения = Окр(ПогрешностьРаспределения/СтрокаСоставМаксимальныйВес.КоличествоДовольствующихся, 6);
					СтрокаСоставМаксимальныйВес.Количество = СтрокаСоставМаксимальныйВес.Количество + ПогрешностьРаспределения;
					Объект.СоставБлюда[СтрокаСоставМаксимальныйВес.НомерСтроки - 1].Количество = СтрокаСоставМаксимальныйВес.Количество;
				КонецЕсли;
				ЕстьИзмененияСостава = Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТаблицаСоставДляРаспределения(ТаблицаИзменений)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОтбораПоИзменениям.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
	|	ТаблицаОтбораПоИзменениям.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_ОтборИзменения
	|ИЗ
	|	&ТаблицаОтбораПоИзменениям КАК ТаблицаОтбораПоИзменениям
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МенюРаскладка.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
	|	МенюРаскладка.ВариантМеню КАК ВариантМеню,
	|	МенюРаскладка.ПриемПищи КАК ПриемПищи,
	|	МенюРаскладка.Блюдо КАК Блюдо,
	|	МенюРаскладка.Спецификация КАК Спецификация,
	|	МенюРаскладка.Количество КАК КоличествоДовольствующихся
	|ПОМЕСТИТЬ ВТ_МенюРаскладка
	|ИЗ
	|	&МенюРаскладка КАК МенюРаскладка
	|ГДЕ
	|	МенюРаскладка.Количество > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоставБлюда.НомерСтроки КАК НомерСтроки,
	|	СоставБлюда.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
	|	СоставБлюда.Номенклатура КАК Номенклатура,
	|	СоставБлюда.ВариантМеню КАК ВариантМеню,
	|	СоставБлюда.ПриемПищи КАК ПриемПищи,
	|	СоставБлюда.Блюдо КАК Блюдо,
	|	СоставБлюда.Спецификация КАК Спецификация,
	|	СоставБлюда.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_СоставБлюда
	|ИЗ
	|	&СоставБлюда КАК СоставБлюда
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СоставБлюда.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
	|	ВТ_СоставБлюда.Номенклатура КАК Номенклатура,
	|	ВТ_СоставБлюда.НомерСтроки КАК НомерСтроки,
	|	ВТ_СоставБлюда.Количество КАК Количество,
	|	ВТ_МенюРаскладка.КоличествоДовольствующихся КАК КоличествоДовольствующихся,
	|	ВТ_МенюРаскладка.КоличествоДовольствующихся * ВТ_СоставБлюда.Количество КАК ВсегоРасход
	|ИЗ
	|	ВТ_СоставБлюда КАК ВТ_СоставБлюда
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МенюРаскладка КАК ВТ_МенюРаскладка
	|		ПО ВТ_СоставБлюда.ВариантМеню = ВТ_МенюРаскладка.ВариантМеню
	|			И ВТ_СоставБлюда.ПриемПищи = ВТ_МенюРаскладка.ПриемПищи
	|			И ВТ_СоставБлюда.Блюдо = ВТ_МенюРаскладка.Блюдо
	|			И ВТ_СоставБлюда.Спецификация = ВТ_МенюРаскладка.Спецификация
	|			И ВТ_СоставБлюда.КатегорияДовольствующихся = ВТ_МенюРаскладка.КатегорияДовольствующихся
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОтборИзменения КАК ВТ_ОтборИзменения
	|		ПО ВТ_СоставБлюда.КатегорияДовольствующихся = ВТ_ОтборИзменения.КатегорияДовольствующихся
	|			И ВТ_СоставБлюда.Номенклатура = ВТ_ОтборИзменения.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВсегоРасход УБЫВ";
	
	
	Если ТаблицаИзменений.Количество() = 1 Тогда
		СтрокаИзменений = ТаблицаИзменений[0];
		
		ОтборМеню = Новый Структура ("КатегорияДовольствующихся", СтрокаИзменений.КатегорияДовольствующихся);
		Запрос.УстановитьПараметр("МенюРаскладка", Объект.МенюРаскладка.Выгрузить(ОтборМеню));
		
		ОтборСостав = Новый Структура ("КатегорияДовольствующихся, Номенклатура", СтрокаИзменений.КатегорияДовольствующихся, СтрокаИзменений.Номенклатура);
		Запрос.УстановитьПараметр("СоставБлюда", Объект.СоставБлюда.Выгрузить(ОтборСостав));
		
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
		СхемаЗапроса.ПакетЗапросов[3].Операторы[0].Источники.Удалить(2);
		СхемаЗапроса.ПакетЗапросов.Удалить(0);
		Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	Иначе
		Запрос.УстановитьПараметр("МенюРаскладка", Объект.МенюРаскладка.Выгрузить());
		Запрос.УстановитьПараметр("СоставБлюда", Объект.СоставБлюда.Выгрузить());
		Запрос.УстановитьПараметр("ТаблицаОтбораПоИзменениям", ТаблицаИзменений);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Функция ИзмененияТаблицыМатериалов(ТаблицаМатериалыНовая, ТаблицаМатериалыТекущаяя)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МатериалыНовая.Количество КАК Количество,
	|	МатериалыНовая.Номенклатура КАК Номенклатура,
	|	МатериалыНовая.КатегорияДовольствующихся КАК КатегорияДовольствующихся
	|ПОМЕСТИТЬ ВТ_МатериалыНовая
	|ИЗ
	|	&МатериалыНовая КАК МатериалыНовая
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МатериалыТекущаяя.Количество КАК Количество,
	|	МатериалыТекущаяя.Номенклатура КАК Номенклатура,
	|	МатериалыТекущаяя.КатегорияДовольствующихся КАК КатегорияДовольствующихся
	|ПОМЕСТИТЬ ВТ_МатериалыТекущаяя
	|ИЗ
	|	&МатериалыТекущаяя КАК МатериалыТекущаяя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	СУММА(ВложенныйЗапрос.КоличествоНовое) КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_МатериалыНовая.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
	|		ВТ_МатериалыНовая.Номенклатура КАК Номенклатура,
	|		СУММА(ВТ_МатериалыНовая.Количество) КАК КоличествоНовое,
	|		СУММА(ВТ_МатериалыНовая.Количество) КАК Изменение
	|	ИЗ
	|		ВТ_МатериалыНовая КАК ВТ_МатериалыНовая
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВТ_МатериалыНовая.КатегорияДовольствующихся,
	|		ВТ_МатериалыНовая.Номенклатура
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТ_МатериалыТекущаяя.КатегорияДовольствующихся,
	|		ВТ_МатериалыТекущаяя.Номенклатура,
	|		СУММА(0),
	|		СУММА(-ВТ_МатериалыТекущаяя.Количество)
	|	ИЗ
	|		ВТ_МатериалыТекущаяя КАК ВТ_МатериалыТекущаяя
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВТ_МатериалыТекущаяя.КатегорияДовольствующихся,
	|		ВТ_МатериалыТекущаяя.Номенклатура) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.КатегорияДовольствующихся,
	|	ВложенныйЗапрос.Номенклатура
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВложенныйЗапрос.Изменение) <> 0";
	
	Запрос.УстановитьПараметр("МатериалыНовая", ТаблицаМатериалыНовая);
	Запрос.УстановитьПараметр("МатериалыТекущаяя", ТаблицаМатериалыТекущаяя);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Процедура ЗаменитьКатегориюВТаблицеМатериалы(НоваяКатегория, ТекущаяКатегория)
	
	СтрокиЗамены = Объект.Материалы.НайтиСтроки(Новый Структура("КатегорияДовольствующихся", ТекущаяКатегория));
	
	Для Каждого СтрокаМатериалы Из СтрокиЗамены Цикл
		СтрокаМатериалы.КатегорияДовольствующихся = НоваяКатегория;
	КонецЦикла;
	
КонецПроцедуры

