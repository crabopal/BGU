	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеТекущейСтроки = Новый Структура("КатегорияДовольствующихся, Количество, ВариантМеню, ПорядокМеню",
		ТекущиеДанные.КатегорияДовольствующихся,
		ТекущиеДанные.Количество,
		ТекущиеДанные.ВариантМеню,
		ТекущиеДанные.ПорядокМеню);
	
	ЗаполнитьТЧДокумента(Новый Структура("МенюРаскладка, ТекущаяКатегория, СоставБлюда",
		Неопределено,
		ДанныеТекущейСтроки));
	
