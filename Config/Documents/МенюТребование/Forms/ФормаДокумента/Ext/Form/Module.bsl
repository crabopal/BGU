		ВыбранноеЗначениеСсылка = Неопределено;
		ВыбранноеЗначение.Свойство("Ссылка", ВыбранноеЗначениеСсылка);
		ВыбранноеЗначение = ВыбранноеЗначениеСсылка;
	КонецЕсли;
	
КонецПроцедуры

