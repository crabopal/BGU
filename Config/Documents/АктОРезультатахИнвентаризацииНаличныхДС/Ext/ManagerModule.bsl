Функция ПолучитьДанныеДляПечати(МассивОбъектов)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивОбъектов);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные шапок
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка													КАК Ссылка,
	|	ИФО														КАК ИФО,
	|	Номер													КАК Номер,
	|	Дата													КАК Дата,
	|	Организация												КАК Организация,
	|	Организация.НаименованиеПолное							КАК НаименованиеОрганизации,
	|	Подразделение											КАК Подразделение,
	|	Подразделение.Наименование								КАК НаименованиеПодразделения,
	|	МОЛ														КАК МОЛ,
	|	ДатаНачала												КАК ДатаНачала,
	|	ДатаОкончания											КАК ДатаОкончания,
	|	МестоИнвентаризации										КАК МестоИнвентаризации,
	|	ОснованиеПроведенияИнвентаризации.НаименованиеПолное	КАК ОснованиеПроведенияИнвентаризации,
	|	Ответственный											КАК Ответственный,
	|	ОтветственныйИсполнитель								КАК ОтветственныйИсполнитель,
	|	ДатаПодписиОтветственный								КАК ДатаПодписиОтветственный,
	|	ДатаПодписиРуководитель									КАК ДатаПодписиРуководитель,
	|	Руководитель											КАК Руководитель,
	|	
	|	ДокументОписи											КАК ДокументОписи,
	|	ДокументОписи.Номер										КАК НомерОписи,
	|	ДокументОписи.Дата										КАК ДатаОписи,
	|	
	|	РешениеОПроведенииИнвентаризации						КАК РешениеОПроведенииИнвентаризации,
	|	РешениеОПроведенииИнвентаризации.Номер					КАК ОснованиеНомер,
	|	РешениеОПроведенииИнвентаризации.Дата					КАК ОснованиеДата
	|ИЗ
	|	Документ.АктОРезультатахИнвентаризацииНаличныхДС
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные табличных частей НаличныеСредства
	|//
	|ВЫБРАТЬ
	|	Ссылка							КАК Ссылка,
	|	НомерСтроки						КАК НомерСтроки,
	|	Валюта							КАК Валюта,
	|	Валюта.НаименованиеПолное		КАК ВалютаНаименование,
	|	Недостача						КАК Недостача,
	|	НедостачаРублевыйЭквивалент		КАК НедостачаРублевыйЭквивалент,
	|	Излишек							КАК Излишек,
	|	ИзлишекРублевыйЭквивалент		КАК ИзлишекРублевыйЭквивалент,
	|	РезолюцияКомиссии				КАК РезолюцияКомиссии,
	|	ИдентификаторСтроки				КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.АктОРезультатахИнвентаризацииНаличныхДС.НаличныеСредства
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|;";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	Данные = Новый Структура();
	
	// [0]. Данные шапок
	Данные.Вставить("Шапки", РезультатыЗапроса[0].Выгрузить());
	
	// [1]. Данные табличных частей НаличныеСредства
	Данные.Вставить("ТаблицыНаличныеСредства", РезультатыЗапроса[1].Выгрузить());
	
	Данные.Вставить("РезультатыГолосования", ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(МассивОбъектов));
		
	Данные.Вставить("СоставКомиссий", ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов));
	
	Данные.Вставить("СведенияУчреждений", УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов));
	
	Возврат Данные;
	
КонецФункции
	
Функция ПечатьФормы0510836(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПроверитьДостижениеКворумаПрисутствияПриПечати(МассивОбъектов);
	// Конец ИндикаторКворумаПрисутствия
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.АктОРезультатахИнвентаризацииНаличныхДС.ПФ_MXL_0510836");
	
	КлючПараметровПечати = "ПечатьФормы0510836";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ОбластиМакета = Новый Структура();
	
	ОбластиМакета.Вставить("СогласованоУтверждаю",	Макет.ПолучитьОбласть("СогласованоУтверждаю"));
	ОбластиМакета.Вставить("Заголовок",				Макет.ПолучитьОбласть("Заголовок"));
	ОбластиМакета.Вставить("ЗаголовокТаблицы",		Макет.ПолучитьОбласть("ЗаголовокТаблицы"));
	ОбластиМакета.Вставить("ШапкаТаблицы",			Макет.ПолучитьОбласть("ШапкаТаблицы"));
	ОбластиМакета.Вставить("СтрокаТаблицы",			Макет.ПолучитьОбласть("СтрокаТаблицы"));
	ОбластиМакета.Вставить("Приложение",			Макет.ПолучитьОбласть("Приложение"));
	ОбластиМакета.Вставить("ЧленКомиссии",			Макет.ПолучитьОбласть("ЧленКомиссии"));
	ОбластиМакета.Вставить("Подвал",				Макет.ПолучитьОбласть("Подвал"));
	
	Данные = ПолучитьДанныеДляПечати(МассивОбъектов);
	
	Данные.Вставить("КонтекстПечати", Новый Структура());
	Данные.КонтекстПечати.Вставить("ВалютаРУ", Константы.ВалютаРегламентированногоУчета.Получить());
	
	ПервыйДокумент = Истина;
	
	Для Каждого СтрокаШапки Из Данные["Шапки"] Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		// СОГЛАСОВАНО, УТВЕРЖДАЮ
		
		ЗначенияПараметров = Новый Структура();
		
		// Согласовано
		ДатаСогласовано = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи('00010101');
		ЗначенияПараметров.Вставить("ДняСогласовано",		ДатаСогласовано.Дня);
		ЗначенияПараметров.Вставить("МесяцаСогласовано",	ДатаСогласовано.Месяца);
		ЗначенияПараметров.Вставить("ГодаСогласовано",		ДатаСогласовано.Года);
		
		// Утверждаю
		ФИОУтверждаю = Справочники.Сотрудники.ФамилияИО(СтрокаШапки.Руководитель, Ложь, СтрокаШапки.Дата);
		
		ДанныеПодписанта = Новый Структура("СсылкаНаОбъект, Период, Должность", СтрокаШапки.Руководитель, СтрокаШапки.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеПодписанта);
		ДолжностьУтверждаю = ДанныеПодписанта.Должность;
		
		ДатаУтверждаю = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.ДатаПодписиРуководитель);
		
		ЗначенияПараметров.Вставить("ДолжностьУтверждаю",	ДолжностьУтверждаю);
		ЗначенияПараметров.Вставить("ФИОУтверждаю",			ФИОУтверждаю);
		ЗначенияПараметров.Вставить("ДняУтверждаю",			ДатаУтверждаю.Дня);
		ЗначенияПараметров.Вставить("МесяцаУтверждаю",		ДатаУтверждаю.Месяца);
		ЗначенияПараметров.Вставить("ГодаУтверждаю",		ДатаУтверждаю.Года);
		
		Область = ОбластиМакета["СогласованоУтверждаю"];
		Область.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(Область);
		
		// ЗАГОЛОВОК
		
		ЗначенияПараметров = Новый Структура();
		
		ЗаполнитьПараметрыДляМОЛ(ЗначенияПараметров, СтрокаШапки);
		
		УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, СтрокаШапки.Ссылка, Данные.СведенияУчреждений);
		
		ЗначенияПараметров.Вставить("Дата",	СтрокаШапки.Дата);
		ЗначенияПараметров.Вставить("Номер", РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
			СтрокаШапки.Ссылка,
			СтрокаШапки.Номер));
			
		ЗначенияПараметров.Вставить("ОснованиеНаименование", НСтр("ru='Решение о проведении инвентаризации'"));
		ЗначенияПараметров.Вставить("ОснованиеДата", СтрокаШапки.ОснованиеДата);
		ЗначенияПараметров.Вставить("ОснованиеНомер", РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
			СтрокаШапки.РешениеОПроведенииИнвентаризации,
			СтрокаШапки.ОснованиеНомер));
			
		ЗначенияПараметров.Вставить("ДатаОписи", СтрокаШапки.ДатаОписи);
		ЗначенияПараметров.Вставить("НомерОписи", РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
			СтрокаШапки.ДокументОписи,
			СтрокаШапки.НомерОписи));
			
		ЗначенияПараметров.Вставить("ДатаНачала", 		СтрокаШапки.ДатаНачала);
		ЗначенияПараметров.Вставить("ДатаОкончания", 	СтрокаШапки.ДатаОкончания);
			
		Область = ОбластиМакета["Заголовок"];
		Область.Параметры.Заполнить(СтрокаШапки);
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата));
		ТабДокумент.Вывести(Область);
		
		// ТАБЛИЦА
		
		ВывестиТаблицуНаличныеСредства(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
		
		// ПРИЛОЖЕНИЯ
		
		УправлениеПечатьюБГУ.ВывестиПриложенияПриПечати(ТабДокумент, СтрокаШапки.Ссылка, ОбластиМакета.Приложение);
		
		// СОСТАВ КОМИССИИ
		
		ПараметрыВывода = УправлениеПечатьюБГУ.ПараметрыВыводаСоставаКомиссииПриПечати();
		ПараметрыВывода.ЗаголовокПервогоРядовогоЧлена = НСтр("ru='Члены комиссии'");
		ПараметрыВывода.ВыводитьДополнительныеСведения = Истина;
		ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьЗамещающегоСотрудника = Истина;
		
		УправлениеПечатьюБГУ.ВывестиСоставКомиссииПриПечати(ТабДокумент, СтрокаШапки.Ссылка, ОбластиМакета.ЧленКомиссии, Данные.СоставКомиссий, ПараметрыВывода);
		
		// ПОДВАЛ
		
		ДанныеОтветственногоИсполнителя = ПолучитьДанныеОтветственногоИсполнителя(СтрокаШапки);
		
		Область = ОбластиМакета["Подвал"];
		Область.Параметры.Заполнить(ДанныеОтветственногоИсполнителя);
		Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.ДатаПодписиОтветственный));
		ТабДокумент.Вывести(Область);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			СтрокаШапки.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ЗаполнитьПараметрыДляМОЛ(ЗначенияПараметров, СтрокаШапки)
	
	Сотрудник	= СтрокаШапки.МОЛ;
	Дата		= СтрокаШапки.Дата;
	
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		
		ТребуемыеДанные = "НаименованиеПолное,ДолжностьНаименование,Подразделение";
		
		Таблица = Справочники.Сотрудники.ПолучитьДанныеСотрудников(Сотрудник, ТребуемыеДанные, Дата);
		
		Если Таблица.Количество() > 0 Тогда
			
			СтрокаДанных = Таблица[0];
			
			ЗначенияПараметров.Вставить("ФИО", СтрокаДанных.Фамилия + " " + СтрокаДанных.Имя + " " + СтрокаДанных.Отчество);
			
			ЗначенияПараметров.Вставить("Должность", СтрокаДанных.ДолжностьНаименование);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиТаблицуНаличныеСредства(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета)
	
	ТабДокумент.Вывести(ОбластиМакета["ЗаголовокТаблицы"]);
	
	ТабДокумент.Вывести(ОбластиМакета["ШапкаТаблицы"]);
	
	Область = ОбластиМакета["СтрокаТаблицы"];
	
	ДокументСсылка = СтрокаШапки.Ссылка;
	
	Поиск = Новый Структура("Ссылка", ДокументСсылка);
	
	МассивСтрокТаблицы = Данные["ТаблицыНаличныеСредства"].НайтиСтроки(Поиск);
	
	ЗначенияПараметров = Новый Структура();
	
	Для Каждого СтрокаТаблицы Из МассивСтрокТаблицы Цикл
		
		УказанаИностраннаяВалюта = (ЗначениеЗаполнено(СтрокаТаблицы.Валюта) И СтрокаТаблицы.Валюта <> Данные.КонтекстПечати.ВалютаРУ);
		
		ЗначенияПараметров.Вставить("Наименование",			СтрокаТаблицы.ВалютаНаименование);
		ЗначенияПараметров.Вставить("РезолюцияКомиссии",	СтрокаТаблицы.РезолюцияКомиссии);
		
		ЗначенияПараметров.Вставить("ИзлишкиРуб",	?(УказанаИностраннаяВалюта, 0, СтрокаТаблицы.Излишек));
		ЗначенияПараметров.Вставить("ИзлишкиВал",	?(УказанаИностраннаяВалюта, СтрокаТаблицы.Излишек, 0));
		ЗначенияПараметров.Вставить("НедостачаРуб",	?(УказанаИностраннаяВалюта, 0, СтрокаТаблицы.Недостача));
		ЗначенияПараметров.Вставить("НедостачаВал",	?(УказанаИностраннаяВалюта, СтрокаТаблицы.Недостача, 0));
		
		УправлениеПечатьюБГУ.ЗаполнитьПараметрыИтоговГолосованияПриПечати(
			ЗначенияПараметров,
			СтрокаТаблицы.ИдентификаторСтроки,
			Данные.РезультатыГолосования);
		
		Если СтрокаТаблицы.Излишек = 0 И СтрокаТаблицы.Недостача = 0 И ЗначенияПараметров.ИтогГолосования = 0 Тогда
			// Письмо Минфина от 30 июля 2024 г. N 02-06-06/70843
			// В случае отсутствия по результатам проведенной инвентаризации недостачи или излишков наличных денежных средств,
			// голосование не осуществляется (Лист голосования не формируется), графы 7 и 8 табличной части
			// Акта инвентаризации (ф. 0510836) не заполняются.
			ОчищающаяСтруктура = Новый Структура("ИтогГолосования,РезолюцияПоИтогуГолосования", "", "");
			ЗаполнитьЗначенияСвойств(ЗначенияПараметров, ОчищающаяСтруктура);
		КонецЕсли;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		
		ТабДокумент.Вывести(Область);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДанныеОтветственногоИсполнителя(СтрокаШапки)
	
	ДанныеСотрудника = Новый Структура();
	ДанныеСотрудника.Вставить("СсылкаНаОбъект",	СтрокаШапки.ОтветственныйИсполнитель);
	ДанныеСотрудника.Вставить("Период",			СтрокаШапки.Дата);
	ДанныеСотрудника.Вставить("ДолжностьНаименование");
	ДанныеСотрудника.Вставить("Фамилия");
	ДанныеСотрудника.Вставить("Имя");
	ДанныеСотрудника.Вставить("Отчество");
	
	ПолучатьКИдляПечати = Истина;
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника,, ПолучатьКИдляПечати);
	
	Результат = Новый Структура();
	Результат.Вставить("ДолжностьНаименование",	ДанныеСотрудника.ДолжностьНаименование);
	Результат.Вставить("ФИО",					КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
	Результат.Вставить("НомерТелефона",			ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
	Результат.Вставить("ЭлектроннаяПочта",		ДанныеСотрудника.EmailФизическиеЛица);
	
	Возврат Результат;

КонецФункции

#Область ЗаполнениеНаОсновании

Процедура ЗаполнитьНаОсновании_ИнвентаризацияКассы(ДокументОбъект, ОписьСсылка)
	
	Данные = ПолучитьДанныеДляЗаполненияНаОсновании_ИнвентаризацияКассы(ДокументОбъект, ОписьСсылка);
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Данные["Шапка"]);
	
	ТабличнаяЧасть = ДокументОбъект.НаличныеСредства;
	ТабличнаяЧасть.Очистить();
	ТабличнаяЧасть.Загрузить(Данные["ТаблицаНаличныеСредства"]);
	
	ОбщегоНазначенияБГУ.ЗаполнитьИдентификаторыСтрок(ТабличнаяЧасть);
	
	Если Данные.Свойство("ТаблицаСоставКомиссии") Тогда
		ТабличнаяЧасть = ДокументОбъект.СоставКомиссии;
		ТабличнаяЧасть.Очистить();
		ТабличнаяЧасть.Загрузить(Данные["ТаблицаСоставКомиссии"]);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьНаОсновании_ИнвентаризационнаяОписьНаличныхСредств(ДокументОбъект, ОписьСсылка)
	
	Данные = ПолучитьДанныеДляЗаполненияНаОсновании_ИнвентаризационнаяОписьНаличныхСредств(ДокументОбъект, ОписьСсылка);
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Данные["Шапка"]);
	
	ТабличнаяЧасть = ДокументОбъект.НаличныеСредства;
	ТабличнаяЧасть.Очистить();
	ТабличнаяЧасть.Загрузить(Данные["ТаблицаНаличныеСредства"]);
	
	ОбщегоНазначенияБГУ.ЗаполнитьИдентификаторыСтрок(ТабличнаяЧасть);
	
	Если Данные.Свойство("ТаблицаСоставКомиссии") Тогда
		ТабличнаяЧасть = ДокументОбъект.СоставКомиссии;
		ТабличнаяЧасть.Очистить();
		ТабличнаяЧасть.Загрузить(Данные["ТаблицаСоставКомиссии"]);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ИнвентаризацияКассы(ДокументОбъект, ОписьСсылка)
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ОснованиеСсылка",	ОписьСсылка);
	ЗапросПоиск.УстановитьПараметр("ВалютаРУ",			ВалютаРУ);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка								КАК ДокументОписи,
	|	Организация							КАК Организация,
	|	Подразделение						КАК Подразделение,
	|	ИФО									КАК ИФО,
	|	МОЛ									КАК МОЛ,
	|	ДатаНачала							КАК ДатаНачала,
	|	ДатаОкончания						КАК ДатаОкончания,
	|	РешениеОПроведенииИнвентаризации	КАК РешениеОПроведенииИнвентаризации,
	|	МестоИнвентаризации					КАК МестоИнвентаризации
	|ИЗ
	|	Документ.ИнвентаризацияКассы
	|ГДЕ
	|	Ссылка В(&ОснованиеСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части НаличныеСредства
	|//
	|ВЫБРАТЬ
	|	Валюта				КАК Валюта,
	|	Недостача			КАК Недостача,
	|	Излишек				КАК Излишек,
	|	ВЫБОР
	|		КОГДА Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) И Валюта <> &ВалютаРУ ТОГДА
	|			НедостачаРУ
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ	КАК 		НедостачаРублевыйЭквивалент,
	|	ВЫБОР
	|		КОГДА Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) И Валюта <> &ВалютаРУ ТОГДА
	|			ИзлишекРУ
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ				КАК ИзлишекРублевыйЭквивалент
	|ИЗ
	|	Документ.ИнвентаризацияКассы.ДенежныеСредства
	|ГДЕ
	|	Ссылка В(&ОснованиеСсылка)";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	Данные = Новый Структура();
	
	// [0]. Данные для шапки
	Данные.Вставить("Шапка", ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РезультатыЗапроса[0].Выгрузить()[0]));
	
	// [1]. Данные для табличной части НаличныеСредства
	ТаблицаНаличныеСредства = РезультатыЗапроса[1].Выгрузить();
	
	Если ТаблицаНаличныеСредства.Количество() = 0 Тогда
		НоваяСтрока = ТаблицаНаличныеСредства.Добавить();
		
		НоваяСтрока.Валюта = ВалютаРУ;
		НоваяСтрока.Недостача = 0;
		НоваяСтрока.Излишек = 0;
		НоваяСтрока.НедостачаРублевыйЭквивалент = 0;
		НоваяСтрока.ИзлишекРублевыйЭквивалент = 0;
	КонецЕсли;
	
	Данные.Вставить("ТаблицаНаличныеСредства", ТаблицаНаличныеСредства);
	
	ЗаполнитьРезолюцииКомиссии(Данные.ТаблицаНаличныеСредства);
	
	ПодходящаяКомиссия = ИнвентаризацияСервер.НайтиПодходящуюКомиссиюДляОписи52н(ОписьСсылка, Данные.Шапка.РешениеОПроведенииИнвентаризации);
	
	Если ПодходящаяКомиссия.КомиссияСсылка <> Неопределено Тогда
		Комиссия				= ПодходящаяКомиссия.КомиссияСсылка;
		НомерКомиссии			= ПодходящаяКомиссия.НомерКомиссии;
		НомерРабочейКомиссии	= ПодходящаяКомиссия.НомерРабочейКомиссии;
		ТаблицаСоставКомиссии	= ПодходящаяКомиссия.СоставКомиссии;
	Иначе
		Комиссия				= Неопределено;
		НомерКомиссии			= Неопределено;
		НомерРабочейКомиссии	= Неопределено;
		ТаблицаСоставКомиссии	= Новый ТаблицаЗначений();
	КонецЕсли;
	
	Данные.Шапка.Вставить("Комиссия",				Комиссия);
	Данные.Шапка.Вставить("НомерКомиссии",			НомерКомиссии);
	Данные.Шапка.Вставить("НомерРабочейКомиссии",	НомерРабочейКомиссии);
	
	Данные.Вставить("ТаблицаСоставКомиссии", ТаблицаСоставКомиссии);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ИнвентаризационнаяОписьНаличныхСредств(ДокументОбъект, ОписьСсылка)
	
