Процедура ЗаполнитьРезолюцииКомиссии(ТаблицаНаличныеСредства)
	
	МассивРезолюций = ОбщегоНазначенияБГУ.ПолучитьМассивРезолюцийДляВидаДокумента(
		Документы.АктОРезультатахИнвентаризацииНаличныхДС.ПустаяСсылка());
	
	ИмяПоляРезолюция = "РезолюцияКомиссии";
	
	ТаблицаНаличныеСредства.Колонки.Добавить(ИмяПоляРезолюция, Новый ОписаниеТипов("Строка"));
	
	Для Каждого СтрокаТаблицы Из ТаблицаНаличныеСредства Цикл
		
		Если СтрокаТаблицы.Недостача = 0 И СтрокаТаблицы.Излишек = 0 Тогда
			ИдентификаторРезолюции = "(0510836) Расхождения не выявлены";
			
		ИначеЕсли СтрокаТаблицы.Недостача > 0 Тогда
			ИдентификаторРезолюции = "(0510836) Установлена недостача";
			
		ИначеЕсли СтрокаТаблицы.Излишек > 0 Тогда
			ИдентификаторРезолюции = "(0510836) Установлены излишки";
			
		КонецЕсли;
		
		ТекстРезолюции = ОбщегоНазначенияБГУКлиентСервер.ПолучитьТекстРезолюцииПоИдентификатору(МассивРезолюций, ИдентификаторРезолюции);
		
		СтрокаТаблицы[ИмяПоляРезолюция] = ТекстРезолюции;
		
	КонецЦикла;
	
КонецПроцедуры

