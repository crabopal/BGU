#Область ЧтениеАктовИнвентаризации

Функция ПолучитьТаблицуАктовИнвентаризации(МассивОбъектов)
	
	ТаблицаАктов = ПолучитьПустуюТаблицуАктовИнвентаризации();
	
	Если ТипЗнч(МассивОбъектов) = Тип("Массив") Тогда
		Свойства = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОбъектов, "ДокументОписи,НаличныеСредства");
		
		Для Каждого Элемент Из Свойства Цикл
			НоваяСтрока = ТаблицаАктов.Добавить();
			НоваяСтрока.АктСсылка			= Элемент.Ключ;
			НоваяСтрока.ОписьСсылка			= Элемент.Значение.ДокументОписи;
			НоваяСтрока.НаличныеСредства	= Элемент.Значение.НаличныеСредства.Выгрузить();
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(МассивОбъектов) = Тип("ДокументСсылка.АктОРезультатахИнвентаризацииНаличныхДС") Тогда
		СвойстваАкта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(МассивОбъектов, "ДокументОписи,НаличныеСредства");
		
		НоваяСтрока = ТаблицаАктов.Добавить();
		НоваяСтрока.АктСсылка			= МассивОбъектов;
		НоваяСтрока.ОписьСсылка			= СвойстваАкта.ДокументОписи;
		НоваяСтрока.НаличныеСредства	= СвойстваАкта.НаличныеСредства.Выгрузить();
		
	ИначеЕсли ТипЗнч(МассивОбъектов) = Тип("ДанныеФормыСтруктура") Тогда
		НоваяСтрока = ТаблицаАктов.Добавить();
		НоваяСтрока.АктСсылка			= МассивОбъектов.Ссылка;
		НоваяСтрока.ОписьСсылка			= МассивОбъектов.ДокументОписи;
		НоваяСтрока.НаличныеСредства	= МассивОбъектов.НаличныеСредства.Выгрузить();
	КонецЕсли;
	
	Возврат ТаблицаАктов;
	
КонецФункции

#КонецОбласти

#Область ЧтениеОписей

Функция ПолучитьЗаполненныеОписиАктов(ТаблицаАктов)
	
	ИмяПоляОписи = "ОписьСсылка";
	
	ВремТаблица = ТаблицаАктов.Скопировать(, ИмяПоляОписи);
	
	ВремТаблица.Свернуть(ИмяПоляОписи);
	
	УдаляемыеСтроки = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ВремТаблица Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоляОписи]) Тогда
			УдаляемыеСтроки.Добавить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из УдаляемыеСтроки Цикл
		ВремТаблица.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	Возврат ВремТаблица.ВыгрузитьКолонку(ИмяПоляОписи);
	
КонецФункции

Функция РазбитьМассивПоТипамЗначений(Знач МассивЭлементов)
	
	Результат = Новый Соответствие();
	
	Для Каждого Элемент Из МассивЭлементов Цикл
		ТипЭлемента = ТипЗнч(Элемент);
		
		ПодМассив = Результат.Получить(ТипЭлемента);
		
		Если ПодМассив = Неопределено Тогда
			ПодМассив = Новый Массив();
		КонецЕсли;
		
		ПодМассив.Добавить(Элемент);
		
		Результат.Вставить(ТипЭлемента, ПодМассив);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСоответствиеТипОписиИмяДокумента(МассивПоТипам)
	
	СоответствиеТипОписиИмяДокумента = Новый Соответствие();
	
	Для Каждого Элемент Из МассивПоТипам Цикл
		ТипЗначения = Элемент.Ключ;
		
		ИмяДокумента = Метаданные.НайтиПоТипу(ТипЗначения).Имя;
		
		СоответствиеТипОписиИмяДокумента.Вставить(ТипЗначения, ИмяДокумента);
	КонецЦикла;
	
	Возврат СоответствиеТипОписиИмяДокумента;
	
КонецФункции

Функция ПолучитьТаблицыОписей(ТаблицаАктов, ДополнительныеПараметры)
	
	МассивОписей = ПолучитьЗаполненныеОписиАктов(ТаблицаАктов);
	
	МассивПоТипам = РазбитьМассивПоТипамЗначений(МассивОписей);
	
	СоответствиеТипОписиИмяДокумента = ПолучитьСоответствиеТипОписиИмяДокумента(МассивПоТипам);
	
	ТаблицыОписей = Новый Структура();
	
	Для Каждого Элемент Из МассивПоТипам Цикл
		ТипОписи	= Элемент.Ключ;
		ПодМассив	= Элемент.Значение;
		
		ИмяДокумента = СоответствиеТипОписиИмяДокумента.Получить(ТипОписи);
		
		Если ИмяДокумента = "ИнвентаризацияКассы" Тогда
			ТаблицаОписей = ПолучитьТаблицуОписей_ИнвентаризацияКассы(ПодМассив);
			
		ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьНаличныхСредств" Тогда
			ТаблицаОписей = ПолучитьТаблицуОписей_ИнвентаризационнаяОписьНаличныхСредств(ПодМассив);
			
		КонецЕсли;
		
		ТаблицыОписей.Вставить(ИмяДокумента, ТаблицаОписей);
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("СоответствиеТипОписиИмяДокумента", СоответствиеТипОписиИмяДокумента);
	
	Возврат ТаблицыОписей;
	
КонецФункции

