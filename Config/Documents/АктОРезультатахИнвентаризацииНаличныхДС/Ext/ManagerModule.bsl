	|	Ссылка В(&МассивОписей)";
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаОписей = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Для Каждого СтрокаОписи Из ТаблицаОписей Цикл
		СтрокаОписи.Раздел1.Колонки.Сумма.Имя = "СуммаУчет";
		
		СтрокаОписи.Раздел4.Колонки.СуммаИзлишки.Имя = "Излишек";
		СтрокаОписи.Раздел4.Колонки.СуммаНедостача.Имя = "Недостача";
	КонецЦикла;
	
	Возврат ТаблицаОписей;
	
КонецФункции

#КонецОбласти

#Область ЧтениеОстатков

Функция ПолучитьТаблицуОстатков(ТаблицыОписей)
	
	ТаблицаОстатков = ПолучитьПустуюТаблицуОстатков();
	
	Для Каждого Элемент Из ТаблицыОписей Цикл
		ИмяДокумента	= Элемент.Ключ;
		ТаблицаОписей	= Элемент.Значение;
		
		Для Каждого ШапкаОписи Из ТаблицаОписей Цикл
			
			Если ИмяДокумента = "ИнвентаризацияКассы" Тогда
				ТаблицаОстатковОписи = ПолучитьТаблицуОстатков_ИнвентаризацияКассы(ШапкаОписи);
				
			ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьНаличныхСредств" Тогда
				ТаблицаОстатковОписи = ПолучитьТаблицуОстатков_ИнвентаризационнаяОписьНаличныхСредств(ШапкаОписи);
				
			Иначе
				Продолжить;
			КонецЕсли;
		
			НоваяСтрока = ТаблицаОстатков.Добавить();
			НоваяСтрока.ОписьСсылка		= ШапкаОписи.ОписьСсылка;
			НоваяСтрока.ТаблицаОстатков	= ТаблицаОстатковОписи;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаОстатков;
	
КонецФункции

// 0504082
Функция ПолучитьТаблицуОстатков_ИнвентаризацияКассы(ШапкаОписи)
	
	Возврат Документы.ИнвентаризацияКассы.ПолучитьТаблицуОстатков_ДС(ШапкаОписи);
	
КонецФункции

// 0510467
Функция ПолучитьТаблицуОстатков_ИнвентаризационнаяОписьНаличныхСредств(ШапкаОписи)
	
	ДанныеБухУчета = Документы.ИнвентаризационнаяОписьНаличныхСредств.ПолучитьДанныеБухУчета(ШапкаОписи);
	
	ТаблицаОстатков = ДанныеБухУчета.ТаблицаРаздела1;
	
	ТаблицаОстатков.Колонки.Сумма.Имя = "СуммаУчет";
	
	Возврат ТаблицаОстатков;
	
КонецФункции

#КонецОбласти

#Область СопоставлениеОстатков

Процедура ДобавитьРазличияТаблицОстатковИОписей(Данные, ПараметрыРасчета)
	
	ТаблицаОстатков	= Данные.ТаблицаОстатков; // Таблица1
	ТаблицыОписей	= Данные.ТаблицыОписей; // Несколько Таблиц2
	
	ИменаКолонокСумм = Новый Массив();
	ИменаКолонокСумм.Добавить("СуммаУчет");
	
	ТаблицаРазличийОстатковИОписей = ПолучитьПустуюТаблицуРазличийОстатковИОписей();
	
	ПоискОпись = Новый Структура("ОписьСсылка");
	
	Для Каждого Элемент Из ТаблицыОписей Цикл
		ИмяДокумента	= Элемент.Ключ;
		ТаблицаОписей	= Элемент.Значение;
		
		Для Каждого СтрокаТаблицыОписей Из ТаблицаОписей Цикл
			ЗаполнитьЗначенияСвойств(ПоискОпись, СтрокаТаблицыОписей);
			
			МассивСтрокТаблицыОстатков = ТаблицаОстатков.НайтиСтроки(ПоискОпись);
			
			НоваяСтрока = ТаблицаРазличийОстатковИОписей.Добавить();
			НоваяСтрока.ОписьСсылка = СтрокаТаблицыОписей.ОписьСсылка;
			
			Если МассивСтрокТаблицыОстатков.Количество() = 0 Тогда
				ТекущаяТаблицаОстатков = Неопределено;
			Иначе
				ТекущаяТаблицаОстатков = МассивСтрокТаблицыОстатков[0].ТаблицаОстатков;
			КонецЕсли;
			
			ТекущаяТаблицаОписи = ПолучитьТаблицуОписиДляСопоставленияСОстатками(ИмяДокумента, СтрокаТаблицыОписей);
			
			ТаблицыРазличий = РассчитатьТаблицыРазличийПострочно(ТекущаяТаблицаОстатков, ТекущаяТаблицаОписи, ИменаКолонокСумм, ПараметрыРасчета);
			
			НоваяСтрока.ТаблицыРазличий = ТаблицыРазличий;
		КонецЦикла;
	КонецЦикла;
	
	Данные.Вставить("РазличияТаблицОстатковИОписи", ТаблицаРазличийОстатковИОписей);
	
КонецПроцедуры

Функция ПолучитьТаблицуОписиДляСопоставленияСОстатками(ИмяДокумента, СтрокаТаблицыОписей)
	
	Если ИмяДокумента = "ИнвентаризацияКассы" Тогда
		Возврат СтрокаТаблицыОписей.ДенежныеСредства;
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьНаличныхСредств" Тогда
		// Опись сопоставляется с бух.учетом по данным раздела 1.
		Возврат СтрокаТаблицыОписей.Раздел1;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область СопоставлениеРасхождений

Процедура ДобавитьРазличияТаблицОписиИАктаИнвентаризации(Данные, ПараметрыРасчета)
	
	ТаблицыОписей	= Данные.ТаблицыОписей; // Несколько Таблиц1
	ТаблицаАктов	= Данные.ТаблицаАктов; // Таблица2
	
	ИменаКолонокСумм = Новый Массив();
	ИменаКолонокСумм.Добавить("Недостача");
	ИменаКолонокСумм.Добавить("Излишек");
	
	ТаблицаРазличийОписейИАктаИнвентаризации = ПолучитьПустуюТаблицуРазличийОписейИАктаИнвентаризации();
	
	ПоискАкт = Новый Структура("АктСсылка");
	
	Для Каждого СтрокаТаблицыАктов Из ТаблицаАктов Цикл
		ЗаполнитьЗначенияСвойств(ПоискАкт, СтрокаТаблицыАктов);
		
		ТекущаяТаблицаОписи = ПолучитьТаблицуОписиДляСопоставленияРасхожденийСАктом(СтрокаТаблицыАктов.ОписьСсылка, ТаблицыОписей, Данные.ДополнительныеПараметры);
		
		МассивСтрокТаблицыАктов = ТаблицаАктов.НайтиСтроки(ПоискАкт);
		
		Если МассивСтрокТаблицыАктов.Количество() = 0 Тогда
			ТекущаяТаблицаАкта = Неопределено;
		Иначе
			ТекущаяТаблицаАкта = МассивСтрокТаблицыАктов[0].НаличныеСредства;
		КонецЕсли;

		ТаблицыРазличий = РассчитатьТаблицыРазличийПострочно(ТекущаяТаблицаОписи, ТекущаяТаблицаАкта, ИменаКолонокСумм, ПараметрыРасчета);
		
		НоваяСтрока = ТаблицаРазличийОписейИАктаИнвентаризации.Добавить();
		НоваяСтрока.АктСсылка		= СтрокаТаблицыАктов.АктСсылка;
		НоваяСтрока.ОписьСсылка		= СтрокаТаблицыАктов.ОписьСсылка;
		НоваяСтрока.ТаблицыРазличий	= ТаблицыРазличий;
	КонецЦикла;
	
	Данные.Вставить("РазличияТаблицОписиИАктаИнвентаризации", ТаблицаРазличийОписейИАктаИнвентаризации);
	
КонецПроцедуры

Функция ПолучитьТаблицуОписиДляСопоставленияРасхожденийСАктом(ОписьСсылка, ТаблицыОписей, ДополнительныеПараметры)
	
	ИмяДокумента = ДополнительныеПараметры.СоответствиеТипОписиИмяДокумента.Получить(ТипЗнч(ОписьСсылка));
	
	Если Не ЗначениеЗаполнено(ИмяДокумента) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаОписей = ТаблицыОписей[ИмяДокумента];
	
	ПоискОпись = Новый Структура("ОписьСсылка", ОписьСсылка);
	
	МассивСтрокТаблицыОписей = ТаблицаОписей.НайтиСтроки(ПоискОпись);
	
	Если МассивСтрокТаблицыОписей.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаТаблицыОписей = МассивСтрокТаблицыОписей[0];
	
	Если ИмяДокумента = "ИнвентаризацияКассы" Тогда
		Возврат СтрокаТаблицыОписей.ДенежныеСредства;
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьНаличныхСредств" Тогда
		// Опись сопоставляется с актом по расхождениям из раздела 4.
		Возврат СтрокаТаблицыОписей.Раздел4;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область ОбщийРасчетРасхождений

Функция РассчитатьТаблицыРазличийПострочно(Таблица1, Таблица2, ИменаКолонокСумм, ПараметрыРасчета)
	
	ТаблицыРазличий = Новый Соответствие();
	
	Если Таблица1 = Неопределено Или Таблица2 = Неопределено Тогда
		Возврат ТаблицыРазличий;
	КонецЕсли;
	
	ГруппыСопоставления = ПолучитьПредзаполненныеГруппыСопоставленияПострочно(Таблица1, Таблица2);
	
	Для Каждого ГруппаСопоставления Из ГруппыСопоставления Цикл
		ТаблицаРазличий = ПолучитьПустуюТаблицуРазличийПострочно(ИменаКолонокСумм);
		
		Валюта					= ГруппаСопоставления.Ключ;
		ТаблицаСопоставления	= ГруппаСопоставления.Значение.ТаблицаСопоставления;
		
		Для Каждого СтрокаТаблицы Из ТаблицаСопоставления Цикл
			НомерСтрокиТаблицы1 = СтрокаТаблицы.НомерСтрокиТаблицы1;
			НомерСтрокиТаблицы2 = СтрокаТаблицы.НомерСтрокиТаблицы2;
			
			ЕстьВТаблице1 = ЗначениеЗаполнено(НомерСтрокиТаблицы1);
			ЕстьВТаблице2 = ЗначениеЗаполнено(НомерСтрокиТаблицы2);
			
			НоваяСтрока = ТаблицаРазличий.Добавить();
			НоваяСтрока.Валюта = Валюта;
			
			Если ЕстьВТаблице1 Тогда
				СтрокаТаблицы1 = Таблица1[НомерСтрокиТаблицы1 - 1];
				
				ЗаполнитьКолонкиИзТаблицы(НоваяСтрока, СтрокаТаблицы1, ИменаКолонокСумм, "Таблица1", НомерСтрокиТаблицы1);
			Иначе
				СтрокаТаблицы1 = Неопределено;
			КонецЕсли;
			
			Если ЕстьВТаблице2 Тогда
				СтрокаТаблицы2 = Таблица2[НомерСтрокиТаблицы2 - 1];
				
				ЗаполнитьКолонкиИзТаблицы(НоваяСтрока, СтрокаТаблицы2, ИменаКолонокСумм, "Таблица2", НомерСтрокиТаблицы2);
			Иначе
				СтрокаТаблицы2 = Неопределено;
			КонецЕсли;
			
			ЗаполнитьКолонкиЗначенияСовпадают(НоваяСтрока, СтрокаТаблицы1, СтрокаТаблицы2, ИменаКолонокСумм,  ПараметрыРасчета);
		КонецЦикла;
		
		ТаблицыРазличий.Вставить(Валюта, ТаблицаРазличий);
	КонецЦикла;
	
	Возврат ТаблицыРазличий;
	
КонецФункции

Функция ПолучитьПредзаполненныеГруппыСопоставленияПострочно(Таблица1, Таблица2)
	
	ПолеСопоставления = "Валюта";
	
	ГруппыСопоставления = ПолучитьГруппыСопоставленияПострочно(Таблица1, Таблица2, ПолеСопоставления);	
	
	Поиск = Новый Структура();
	
	Для Каждого ГруппаСопоставления Из ГруппыСопоставления Цикл
		Поиск.Вставить(ПолеСопоставления, ГруппаСопоставления.Ключ);
		
		МассивСтрокТаблицы1 = Таблица1.НайтиСтроки(Поиск);
		МассивСтрокТаблицы2 = Таблица2.НайтиСтроки(Поиск);
		
		КоличествоСтрокТаблицы1 = МассивСтрокТаблицы1.Количество();
		КоличествоСтрокТаблицы2 = МассивСтрокТаблицы2.Количество();
		
		ТаблицаСопоставления = ПолучитьПустуюТаблицуСопоставленияПострочно();
		
		КоличествоСтрок = Макс(КоличествоСтрокТаблицы1, КоличествоСтрокТаблицы2);
		
		Для Счетчик = 1 По КоличествоСтрок Цикл
			НоваяСтрока = ТаблицаСопоставления.Добавить();
			
			ЕстьВТаблице1 = (Счетчик <= КоличествоСтрокТаблицы1);
			ЕстьВТаблице2 = (Счетчик <= КоличествоСтрокТаблицы2);
			
			Если ЕстьВТаблице1 Тогда
				СтрокаТаблицы = МассивСтрокТаблицы1[Счетчик - 1];
				
				НоваяСтрока.НомерСтрокиТаблицы1 = Таблица1.Индекс(СтрокаТаблицы) + 1;
			КонецЕсли;
			
			Если ЕстьВТаблице2 Тогда
				СтрокаТаблицы = МассивСтрокТаблицы2[Счетчик - 1];
				
				НоваяСтрока.НомерСтрокиТаблицы2 = Таблица2.Индекс(СтрокаТаблицы) + 1;
			КонецЕсли;
		КонецЦикла;
		
		ГруппаСопоставления.Значение.Вставить("ТаблицаСопоставления", ТаблицаСопоставления);
	КонецЦикла;
	
	Возврат ГруппыСопоставления;
	
КонецФункции

Процедура ЗаполнитьКолонкиЗначенияСовпадают(СтрокаТаблицыСопоставления, СтрокаТаблицы1, СтрокаТаблицы2, ИменаКолонокСумм, ПараметрыРасчета)
	
	СчитатьСуммуНулевой = ПараметрыРасчета.СчитатьСуммуНулевойЕслиСтрокаСВалютойОтсутствуетВТабличнойЧасти;
	
	ЗначенияСовпадают = Истина;
	
	Для Каждого ИмяКолонкиСуммы Из ИменаКолонокСумм Цикл
		
		Если СтрокаТаблицы1 <> Неопределено Тогда
			Значение1 = СтрокаТаблицы1[ИмяКолонкиСуммы];
		ИначеЕсли СчитатьСуммуНулевой Тогда
			Значение1 = 0;
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы2 <> Неопределено Тогда
			Значение2 = СтрокаТаблицы2[ИмяКолонкиСуммы];
		ИначеЕсли СчитатьСуммуНулевой Тогда
			Значение2 = 0;
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если Значение1 <> Значение2 Тогда
			ЗначенияСовпадают = Ложь;
			
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицыСопоставления[ИмяКолонкиСуммы + "ЗначенияСовпадают"] = Истина;
	КонецЦикла;
	
	СтрокаТаблицыСопоставления.ЗначенияСовпадают = ЗначенияСовпадают;
	
КонецПроцедуры

Процедура ЗаполнитьКолонкиИзТаблицы(СтрокаТаблицыСопоставления, СтрокаТаблицы, ИменаКолонокСумм, ОбозначениеТаблицы, НомерСтроки)
	
	СтрокаТаблицыСопоставления["НомерСтроки" + ОбозначениеТаблицы] = НомерСтроки;
	
	Для Каждого ИмяКолонкиСуммы Из ИменаКолонокСумм Цикл
		СтрокаТаблицыСопоставления[ИмяКолонкиСуммы + ОбозначениеТаблицы] = СтрокаТаблицы[ИмяКолонкиСуммы];
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьГруппыСопоставленияПострочно(Таблица1, Таблица2, ПолеСопоставления)
	
	ГруппыСопоставления = Новый Соответствие();
	
	ВремТаблица = Таблица1.Скопировать(, ПолеСопоставления);
	ВремТаблица.Свернуть(ПолеСопоставления);
	Таблица1Свернутая = ВремТаблица;
	
	ВремТаблица = Таблица2.Скопировать(, ПолеСопоставления);
	ВремТаблица.Свернуть(ПолеСопоставления);
	Таблица2Свернутая = ВремТаблица;
	
	Для Каждого СтрокаСвернутая Из Таблица1Свернутая Цикл
		ЗначениеПоля = СтрокаСвернутая[ПолеСопоставления];
		
		Если ГруппыСопоставления.Получить(ЗначениеПоля) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ГруппаСопоставления = Новый Структура();
		
		ГруппыСопоставления.Вставить(ЗначениеПоля, ГруппаСопоставления);
	КонецЦикла;
	
	Для Каждого СтрокаСвернутая Из Таблица2Свернутая Цикл
		ЗначениеПоля = СтрокаСвернутая[ПолеСопоставления];
		
		Если ГруппыСопоставления.Получить(ЗначениеПоля) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ГруппаСопоставления = Новый Структура();
		
		ГруппыСопоставления.Вставить(ЗначениеПоля, ГруппаСопоставления);
	КонецЦикла;
	
	Возврат ГруппыСопоставления;
	
КонецФункции

#КонецОбласти

#Область ИтогиПроверки

Процедура ДобавитьИтогПроверкиАктовИнвентаризации(Данные)
	
	ТаблицаАктов							= Данные.ТаблицаАктов;
	РазличияТаблицОстатковИОписи			= Данные.РазличияТаблицОстатковИОписи;
	РазличияТаблицОписиИАктаИнвентаризации	= Данные.РазличияТаблицОписиИАктаИнвентаризации;
	
	ДиагностироватьСовпадениеЗначений(РазличияТаблицОстатковИОписи);
	ДиагностироватьСовпадениеЗначений(РазличияТаблицОписиИАктаИнвентаризации);
	
	ТаблицаИтоговПроверки = ПолучитьПустуюТаблицуИтоговПроверкиАктовИнвентаризации();
	
	ПоискОпись	= Новый Структура("ОписьСсылка");
	ПоискАкт	= Новый Структура("АктСсылка");
	
	Для Каждого СтрокаТаблицыАктов Из ТаблицаАктов Цикл
		ЗаполнитьЗначенияСвойств(ПоискОпись, СтрокаТаблицыАктов);
		ЗаполнитьЗначенияСвойств(ПоискАкт, СтрокаТаблицыАктов);
		
		МассивСтрокОстатковИОписи			= РазличияТаблицОстатковИОписи.НайтиСтроки(ПоискОпись);
		МассивСтрокОписиИАктаИнвентаризации	= РазличияТаблицОписиИАктаИнвентаризации.НайтиСтроки(ПоискАкт);
		
		ТекущиеРазличияОстатковИОписи			= Новый Соответствие();
		ТекущиеРазличияОписиИАктаИнвентаризации	= Новый Соответствие();
		
		СтрокаТаблицыРазличияОстатковИОписи				= Неопределено;
		СтрокаТаблицыРазличияОписиИАктаИнвентаризации	= Неопределено;
		
		Если МассивСтрокОстатковИОписи.Количество() > 0 Тогда
			СтрокаТаблицыРазличияОстатковИОписи = МассивСтрокОстатковИОписи[0];
		КонецЕсли;
		
		Если МассивСтрокОписиИАктаИнвентаризации.Количество() > 0 Тогда
			СтрокаТаблицыРазличияОписиИАктаИнвентаризации = МассивСтрокОписиИАктаИнвентаризации[0];
		КонецЕсли;
		
		ЗначенияСовпадаютВЦеломПоАктуИнвентаризации = ?(СтрокаТаблицыРазличияОстатковИОписи <> Неопределено, СтрокаТаблицыРазличияОстатковИОписи.ЗначенияСовпадают, Ложь)
			И ?(СтрокаТаблицыРазличияОписиИАктаИнвентаризации <> Неопределено, СтрокаТаблицыРазличияОписиИАктаИнвентаризации.ЗначенияСовпадают, Ложь);
			
		Если Не ЗначенияСовпадаютВЦеломПоАктуИнвентаризации Тогда
			Если СтрокаТаблицыРазличияОстатковИОписи <> Неопределено Тогда
				ОставитьТолькоСтрокиСРазличиями(СтрокаТаблицыРазличияОстатковИОписи.ТаблицыРазличий);
			КонецЕсли;
			
			Если СтрокаТаблицыРазличияОписиИАктаИнвентаризации <> Неопределено Тогда
				ОставитьТолькоСтрокиСРазличиями(СтрокаТаблицыРазличияОписиИАктаИнвентаризации.ТаблицыРазличий);
			КонецЕсли;
		КонецЕсли;
		
		РазличияТаблиц = Новый Структура();
		РазличияТаблиц.Вставить("ОстатковИОписи",			?(СтрокаТаблицыРазличияОстатковИОписи <> Неопределено, СтрокаТаблицыРазличияОстатковИОписи.ТаблицыРазличий, Неопределено));
		РазличияТаблиц.Вставить("ОписиИАктаИнвентаризации",	?(СтрокаТаблицыРазличияОписиИАктаИнвентаризации <> Неопределено, СтрокаТаблицыРазличияОписиИАктаИнвентаризации.ТаблицыРазличий, Неопределено));
		
		НоваяСтрока = ТаблицаИтоговПроверки.Добавить();
		НоваяСтрока.АктСсылка			= СтрокаТаблицыАктов.АктСсылка;
		НоваяСтрока.ОписьСсылка			= СтрокаТаблицыАктов.ОписьСсылка;
		НоваяСтрока.ЗначенияСовпадают	= ЗначенияСовпадаютВЦеломПоАктуИнвентаризации;
		НоваяСтрока.РазличияТаблиц		= РазличияТаблиц;
		НоваяСтрока.ТекстСообщения		= ПолучитьПредставлениеРезультатаСопоставления(
			СтрокаТаблицыРазличияОстатковИОписи,
			СтрокаТаблицыРазличияОписиИАктаИнвентаризации,
			ЗначенияСовпадаютВЦеломПоАктуИнвентаризации);
	КонецЦикла;
	
	Данные.Вставить("ТаблицаИтоговПроверки", ТаблицаИтоговПроверки);
	
КонецПроцедуры

Процедура ДиагностироватьСовпадениеЗначений(РазличияТаблиц)
	
	Поиск = Новый Структура("ЗначенияСовпадают", Ложь);
	
	Для Каждого СтрокаТаблицы Из РазличияТаблиц Цикл
		ЗначенияСовпадают = Истина;
		
		ТаблицыРазличий = СтрокаТаблицы.ТаблицыРазличий;
		
		Для Каждого Элемент Из ТаблицыРазличий Цикл
			ТаблицаРазличий = Элемент.Значение;
			
			МассивСтрок = ТаблицаРазличий.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() > 0 Тогда
				ЗначенияСовпадают = Ложь;
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		СтрокаТаблицы.ЗначенияСовпадают = ЗначенияСовпадают;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПредставлениеРезультатаСопоставления(СтрокаТаблицыРазличияОстатковИОписи, СтрокаТаблицыРазличияОписиИАктаИнвентаризации, ЗначенияСовпадаютВЦеломПоАктуИнвентаризации)
	
	Если СтрокаТаблицыРазличияОстатковИОписи = Неопределено Или СтрокаТаблицыРазличияОписиИАктаИнвентаризации = Неопределено Тогда
		Возврат НСтр("ru = 'Поле ""Опись"" не заполнено'");
	КонецЕсли;
	
	Если ТипЗнч(СтрокаТаблицыРазличияОстатковИОписи.ОписьСсылка) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНаличныхСредств") Тогда
		КодФормыОписи = "0510467";
	Иначе
		КодФормыОписи = "0504088";
	КонецЕсли;
	
	РазличияТаблицОстатковИОписи			= СтрокаТаблицыРазличияОстатковИОписи.ТаблицыРазличий;
	РазличияТаблицОписиИАктаИнвентаризации	= СтрокаТаблицыРазличияОписиИАктаИнвентаризации.ТаблицыРазличий;
	
	ОбщийСписокВалют = ПолучитьОбщийСписокВалют(РазличияТаблицОстатковИОписи, РазличияТаблицОписиИАктаИнвентаризации);
	
	ДокументыЗаполнены = (ОбщийСписокВалют.Количество() > 0);
	
	Тексты = Новый Структура();
	
	Тексты.Вставить("РазделительВалют", "
		|");
	
	Тексты.Вставить("ЗначенияСовпадаютВЦеломДокументыПустые", СтрШаблон(НСтр("ru = 'Сумма остатка в учете неизменна, различия не обнаружены.
		|
		|Документы описи ф.%1 и акта ф.0510836 не заполнены.
		|'"), КодФормыОписи));
		
	Тексты.Вставить("ЗначенияСовпадаютВЦеломДокументыЗаполнены", НСтр("ru = 'Сумма остатка в учете неизменна, различия не обнаружены.
		|
		|Успешно пройдены проверки:
		|'"));
	
	Тексты.Вставить("ЗначенияРазличаютсяВЦелом", НСтр("ru = 'Сумма остатка в учете отличается, обнаружены различия.
		|
		|Выявлены следующие различия:
		|'"));
	
	Тексты.Вставить("ОстаткиСовпадаютЗаголовок", НСтр("ru = '  Совпадают остатки:
		|'"));
	
	Тексты.Вставить("ОстаткиРазличаютсяЗаголовок", НСтр("ru = '  Различаются остатки:
		|'"));
	
	Тексты.Вставить("НедостачиСовпадаютЗаголовок", НСтр("ru = '  Совпадают недостачи:
		|'"));
	
	Тексты.Вставить("НедостачиРазличаютсяЗаголовок", НСтр("ru = '  Различаются недостачи:
		|'"));
	
	Тексты.Вставить("ИзлишкиСовпадаютЗаголовок", НСтр("ru = '  Совпадают излишки:
		|'"));
	
	Тексты.Вставить("ИзлишкиРазличаютсяЗаголовок", НСтр("ru = '  Различаются излишки:
		|'"));
	
	Шаблоны = Новый Структура();
	
	Шаблоны.Вставить("ВалютаЗаголовок", НСтр("ru = 'Валюта %1
		|'"));
	
	Шаблоны.Вставить("ОстаткиСтрокаОстатка", НСтр("ru = '    по данным бух.учета: %1
		|'"));
	
	Шаблоны.Вставить("ОстаткиСтрокаОписи", НСтр("ru = '    в описи ф.%1: %2 (%3)
		|'"));
	
	Шаблоны.Вставить("НедостачаСтрокаОписи", НСтр("ru = '    в описи ф.%1: %2 (%3)
		|'"));
	
	Шаблоны.Вставить("НедостачаСтрокаАкта", НСтр("ru = '    в акте ф.0510836: %1 (%2)
		|'"));
	
	Шаблоны.Вставить("ИзлишекСтрокаОписи", НСтр("ru = '    в описи ф.%1: %2 (%3)
		|'"));
	
	Шаблоны.Вставить("ИзлишекСтрокаАкта", НСтр("ru = '    в акте ф.0510836: %1 (%2)
		|'"));
	
	//
	// Заголовок
	//
	
	Если ЗначенияСовпадаютВЦеломПоАктуИнвентаризации Тогда
		Представление = ?(ДокументыЗаполнены, Тексты.ЗначенияСовпадаютВЦеломДокументыЗаполнены, Тексты.ЗначенияСовпадаютВЦеломДокументыПустые);
	Иначе
		Представление = Тексты.ЗначенияРазличаютсяВЦелом;
	КонецЕсли;
	
	//
	// Результаты сопоставления по каждой валюте
	//
	
	ПредставлениеВалют = "";
	
	ФорматСуммы = "ЧЦ=15; ЧДЦ=2; ЧН=0";
	
	ФорматНомераСтроки = "ЧЦ=6; ЧДЦ=0; ЧН=""отсутствует строка с валютой""; ЧФ=""строка Ч""";
	
	Для Каждого Валюта Из ОбщийСписокВалют Цикл
		
		ПредставлениеВалют = ПредставлениеВалют
			+ ?(ПредставлениеВалют = "", "", Тексты.РазделительВалют)
			+ СтрШаблон(Шаблоны.ВалютаЗаголовок, Валюта);
		
		//
		// Различия остатков и описи
		//
		
		ТаблицаРазличий = РазличияТаблицОстатковИОписи.Получить(Валюта);
		
		Если ТаблицаРазличий <> Неопределено Тогда
			Для Каждого СтрокаТаблицы Из ТаблицаРазличий Цикл
				ЗначенияСовпадают = СтрокаТаблицы.ЗначенияСовпадают;
				
				ПредставлениеВалют = ПредставлениеВалют
					+ ?(ЗначенияСовпадают, Тексты.ОстаткиСовпадаютЗаголовок, Тексты.ОстаткиРазличаютсяЗаголовок)
					+ СтрШаблон(Шаблоны.ОстаткиСтрокаОстатка, Формат(СтрокаТаблицы.СуммаУчетТаблица1, ФорматСуммы))
					+ СтрШаблон(Шаблоны.ОстаткиСтрокаОписи, КодФормыОписи, Формат(СтрокаТаблицы.СуммаУчетТаблица2, ФорматСуммы), Формат(СтрокаТаблицы.НомерСтрокиТаблица2, ФорматНомераСтроки));
			КонецЦикла;
		КонецЕсли;
		
		//
		// Различия описи и акта инвентаризации
		//
		
		ТаблицаРазличий = РазличияТаблицОписиИАктаИнвентаризации.Получить(Валюта);
		
		Если ТаблицаРазличий <> Неопределено Тогда
			Для Каждого СтрокаТаблицы Из ТаблицаРазличий Цикл
				ЗначенияСовпадают = СтрокаТаблицы.ЗначенияСовпадают;
				
				ОписатьНедостачу = ?(ЗначенияСовпадаютВЦеломПоАктуИнвентаризации, Истина, Не СтрокаТаблицы.НедостачаЗначенияСовпадают);
				
				Если ОписатьНедостачу Тогда
					ПредставлениеВалют = ПредставлениеВалют
						+ ?(ЗначенияСовпадают, Тексты.НедостачиСовпадаютЗаголовок, Тексты.НедостачиРазличаютсяЗаголовок)
						+ СтрШаблон(Шаблоны.НедостачаСтрокаОписи, КодФормыОписи, Формат(СтрокаТаблицы.НедостачаТаблица1, ФорматСуммы), Формат(СтрокаТаблицы.НомерСтрокиТаблица1, ФорматНомераСтроки))
						+ СтрШаблон(Шаблоны.НедостачаСтрокаАкта, Формат(СтрокаТаблицы.НедостачаТаблица2, ФорматСуммы), Формат(СтрокаТаблицы.НомерСтрокиТаблица2, ФорматНомераСтроки));
				КонецЕсли;
				
				ОписатьИзлишек = ?(ЗначенияСовпадаютВЦеломПоАктуИнвентаризации, Истина, Не СтрокаТаблицы.ИзлишекЗначенияСовпадают);
				
				Если ОписатьИзлишек Тогда
					ПредставлениеВалют = ПредставлениеВалют
						+ ?(ЗначенияСовпадают, Тексты.ИзлишкиСовпадаютЗаголовок, Тексты.ИзлишкиРазличаютсяЗаголовок)
						+ СтрШаблон(Шаблоны.ИзлишекСтрокаОписи, КодФормыОписи, Формат(СтрокаТаблицы.ИзлишекТаблица1, ФорматСуммы), Формат(СтрокаТаблицы.НомерСтрокиТаблица1, ФорматНомераСтроки))
						+ СтрШаблон(Шаблоны.ИзлишекСтрокаАкта, Формат(СтрокаТаблицы.ИзлишекТаблица2, ФорматСуммы), Формат(СтрокаТаблицы.НомерСтрокиТаблица2, ФорматНомераСтроки));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Представление = Представление + ПредставлениеВалют;
	
	Возврат Представление;
	
КонецФункции

Функция ПолучитьОбщийСписокВалют(РазличияТаблицОстатковИОписи, РазличияТаблицОписиИАктаИнвентаризации)
	
	ОбщийСписокВалют = Новый Массив();
	
	Для Каждого Элемент Из РазличияТаблицОстатковИОписи Цикл
		Валюта = Элемент.Ключ;
		
		Если ОбщийСписокВалют.Найти(Валюта) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОбщийСписокВалют.Добавить(Валюта);
	КонецЦикла;
	
	Для Каждого Элемент Из РазличияТаблицОписиИАктаИнвентаризации Цикл
		Валюта = Элемент.Ключ;
		
		Если ОбщийСписокВалют.Найти(Валюта) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОбщийСписокВалют.Добавить(Валюта);
	КонецЦикла;
	
	Возврат ОбщийСписокВалют;
	
КонецФункции

Процедура ОставитьТолькоСтрокиСРазличиями(РазличияТаблиц)
	
	НовоеРазличияТаблиц = Новый Соответствие();
	
	ЗначенияСовпадают = Истина;
	
	Поиск = Новый Структура("ЗначенияСовпадают", Ложь);
	
	Для Каждого Элемент Из РазличияТаблиц Цикл
		Валюта			= Элемент.Ключ;
		ТаблицаРазличий	= Элемент.Значение;
		
		ТаблицаРазличий = ТаблицаРазличий.Скопировать(Поиск);
		
		Если ТаблицаРазличий.Количество() > 0 Тогда
			НовоеРазличияТаблиц.Вставить(Валюта, ТаблицаРазличий);
		КонецЕсли;
	КонецЦикла;
	
	РазличияТаблиц = НовоеРазличияТаблиц;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

#Область ОбработчикОбновления_2_0_87_24_РеквизитРуководитель

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию_2_0_87_24(Параметры) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	Документ.АктОРезультатахИнвентаризацииНаличныхДС
	|ГДЕ
	|	Руководитель = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|	И НЕ Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию_2_0_87_24(Параметры) Экспорт
	
	ПолноеИмяОбъекта = "Документ.АктОРезультатахИнвентаризацииНаличныхДС";
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(
		Параметры.Очередь,
		ПолноеИмяОбъекта,
		МенеджерВременныхТаблиц,
		ДополнительныеПараметры);
	
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	Документ.АктОРезультатахИнвентаризацииНаличныхДС
	|ГДЕ
	|	Ссылка В(ВЫБРАТЬ Ссылка ИЗ ВТДляОбработки)";
	
	Результат = Запрос.Выполнить();
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Если Результат.Пустой() Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	СтатистикаДокументов = Новый Структура();
	СтатистикаДокументов.Вставить("КоличествоОшибок",	0);
	СтатистикаДокументов.Вставить("Обработано",			0);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ПолноеИмяОбъекта",		ПолноеИмяОбъекта);
	ДополнительныеПараметры.Вставить("СтатистикаДокументов",	СтатистикаДокументов);
	
	Выборка = Результат.Выбрать();
	
	ОбработатьДокументыДляПереходаНаНовуюВерсию_2_0_87_24(Выборка, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.СтатистикаДокументов.Обработано = 0 Тогда
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Не удалось обработать всю очередную порцию объектов %1 (пропущены): %2 шт.'"),
			ПолноеИмяОбъекта,
			ДополнительныеПараметры.СтатистикаДокументов.КоличествоОшибок);
			
		ВызватьИсключение ТекстСообщения;
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.СтатистикаДокументов.Обработано > 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Успешно установлен реквизит Руководитель в очередной порции документов %1: %2 шт.'"),
			ПолноеИмяОбъекта,
			ДополнительныеПараметры.СтатистикаДокументов.Обработано);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
	КонецЕсли;
	
	Если ДополнительныеПараметры.СтатистикаДокументов.КоличествоОшибок > 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Не удалось установить реквизит Руководитель в очередной порции документов %1: %2 шт.'"),
			ПолноеИмяОбъекта,
			ДополнительныеПараметры.СтатистикаДокументов.КоличествоОшибок);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДокументыДляПереходаНаНовуюВерсию_2_0_87_24(Выборка, ДополнительныеПараметры)
	
	СтатистикаДокументов = ДополнительныеПараметры.СтатистикаДокументов;
	
	Пока Выборка.Следующий() Цикл
		
		ДокументСсылка = Выборка.Ссылка;
		
		Попытка
			
			ОбработатьДокументДляПереходаНаНовуюВерсию_2_0_87_24(ДокументСсылка, ДополнительныеПараметры);
			
			СтатистикаДокументов.Обработано = СтатистикаДокументов.Обработано + 1;
			
		Исключение
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Не удалось установить реквизит Руководитель документа %1 по причине %2'"), 
				ДокументСсылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				ДокументСсылка.Метаданные(),
				ДокументСсылка,
				ТекстСообщения);
				
			СтатистикаДокументов.КоличествоОшибок = СтатистикаДокументов.КоличествоОшибок + 1;
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьДокументДляПереходаНаНовуюВерсию_2_0_87_24(ДокументСсылка, ДополнительныеПараметры)
	
	ПолноеИмяОбъекта = ДополнительныеПараметры["ПолноеИмяОбъекта"];
	
	Попытка
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", ДокументСсылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Блокировка.Заблокировать();
		
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		
		Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"),
			ДокОбъект.Организация, ДокОбъект.Дата, ДокОбъект.Подразделение);
			
		РуководительСсылка = Руководитель.ОтветственноеЛицоСсылка;
		
		Если ЗначениеЗаполнено(ДокОбъект.Руководитель) Или Не ЗначениеЗаполнено(РуководительСсылка) Тогда
			ОтменитьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ДокументСсылка);
			Возврат;
		КонецЕсли;
		
		ДокОбъект.Руководитель = РуководительСсылка;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

