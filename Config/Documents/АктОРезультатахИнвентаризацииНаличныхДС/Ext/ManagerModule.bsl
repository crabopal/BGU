	ЗапросПоиск.УстановитьПараметр("ОснованиеСсылка",	ОписьСсылка);
	ЗапросПоиск.УстановитьПараметр("ВалютаРУ",			ВалютаРУ);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для шапки
	|//
	|ВЫБРАТЬ
	|	Ссылка											КАК ДокументОписи,
	|	Организация										КАК Организация,
	|	Подразделение									КАК Подразделение,
	|	ИФО												КАК ИФО,
	|	МОЛ												КАК МОЛ,
	|	МестоИнвентаризации								КАК МестоИнвентаризации,
	|	РешениеОПроведенииИнвентаризации				КАК РешениеОПроведенииИнвентаризации,
	|	Комиссия										КАК Комиссия,
	|	ДатаНачала										КАК ДатаНачала,
	|	ДатаОкончания									КАК ДатаОкончания,
	|	Ответственный									КАК Ответственный,
	|	ОтветственныйИсполнитель						КАК ОтветственныйИсполнитель,
	|	ДатаИнвентаризации								КАК ДатаИнвентаризации,
	|	ОтветственныйИсполнительБухгалтерскойСлужбы		КАК ОтветственныйИсполнительБухгалтерскойСлужбы,
	|	НомерКомиссии									КАК НомерКомиссии,
	|	НомерРабочейКомиссии							КАК НомерРабочейКомиссии,
	|	ПоследнийПКО									КАК ПоследнийПКО,
	|	ПоследнийРКО									КАК ПоследнийРКО,
	|	ПоследнийНомерПКО								КАК ПоследнийНомерПКО,
	|	ПоследнийНомерРКО								КАК ПоследнийНомерРКО
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьНаличныхСредств
	|ГДЕ
	|	Ссылка В(&ОснованиеСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части НаличныеСредства
	|//
	|ВЫБРАТЬ
	|	Валюта			КАК Валюта,
	|	СуммаИзлишки	КАК Излишек,
	|	СуммаНедостача	КАК Недостача	
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьНаличныхСредств.Раздел4
	|ГДЕ
	|	Ссылка В(&ОснованиеСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Данные для табличной части СоставКомиссии
	|//
	|ВЫБРАТЬ
	|	Сотрудник	КАК Сотрудник
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьНаличныхСредств.СоставКомиссииРаздел4
	|ГДЕ
	|	Ссылка В(&ОснованиеСсылка)";
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	Данные = Новый Структура();
	
	// [0]. Данные для шапки
	Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РезультатыЗапроса[0].Выгрузить()[0]);
	
	Данные.Вставить("Шапка", Шапка);
	
	// [1]. Данные для табличной части НаличныеСредства
	ТаблицаНаличныеСредства = РезультатыЗапроса[1].Выгрузить();
	
	// [2]. Данные для табличной части СоставКомиссии
	ТаблицаСоставКомиссии = РезультатыЗапроса[2].Выгрузить();
	
	Если ТаблицаНаличныеСредства.Количество() = 0 Тогда
		НулеваяСтрока = Новый Структура();
		
		НулеваяСтрока.Вставить("Валюта",	ВалютаРУ);
		НулеваяСтрока.Вставить("Недостача",	0);
		НулеваяСтрока.Вставить("Излишек",	0);
		
		НоваяСтрока = ТаблицаНаличныеСредства.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, НулеваяСтрока);
	КонецЕсли;
	
	ЗаполнитьРублевыеЭквиваленты(ТаблицаНаличныеСредства, Шапка, ВалютаРУ);
	
	Данные.Вставить("ТаблицаНаличныеСредства", ТаблицаНаличныеСредства);
	
	ЗаполнитьРезолюцииКомиссии(Данные.ТаблицаНаличныеСредства);
	
	Данные.Вставить("ТаблицаСоставКомиссии", ТаблицаСоставКомиссии);
	
	Возврат Данные;
	
КонецФункции

Процедура ЗаполнитьРублевыеЭквиваленты(ТаблицаНаличныеСредства, Шапка, ВалютаРУ)
	
	// Курсы валют определяются на дату окончания инвентаризации.
	
	ТипСумма = ОбщегоНазначения.ОписаниеТипаЧисло(15,2,ДопустимыйЗнак.Неотрицательный);
	
	ИмяКолонки = "НедостачаРублевыйЭквивалент";
	
	Если ТаблицаНаличныеСредства.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		ТаблицаНаличныеСредства.Колонки.Добавить(ИмяКолонки, ТипСумма);
	КонецЕсли;
	
	ИмяКолонки = "ИзлишекРублевыйЭквивалент";
	
	Если ТаблицаНаличныеСредства.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		ТаблицаНаличныеСредства.Колонки.Добавить(ИмяКолонки, ТипСумма);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаНаличныеСредства Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Валюта) Или СтрокаТаблицы.Валюта = ВалютаРУ Тогда
			Продолжить;
		КонецЕсли;
		
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтрокаТаблицы.Валюта, Шапка.ДатаОкончания);
		
		Если КурсКратность.Кратность = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Множитель = КурсКратность.Курс / КурсКратность.Кратность;
		
		СтрокаТаблицы.НедостачаРублевыйЭквивалент	= СтрокаТаблицы.Недостача * Множитель;
		СтрокаТаблицы.ИзлишекРублевыйЭквивалент		= СтрокаТаблицы.Излишек * Множитель;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПроверкаНеизменностиОстатка

Функция ПолучитьДанныеДляСопоставления(МассивОбъектов)
	
	Перем ДополнительныеПараметры;
	
	ТаблицаАктов = ПолучитьТаблицуАктовИнвентаризации(МассивОбъектов);
	
	ТаблицыОписей = ПолучитьТаблицыОписей(ТаблицаАктов, ДополнительныеПараметры);
	
	ТаблицаОстатков = ПолучитьТаблицуОстатков(ТаблицыОписей);
	
	Данные = Новый Структура();
	Данные.Вставить("ТаблицаОстатков",	ТаблицаОстатков);
	Данные.Вставить("ТаблицыОписей",	ТаблицыОписей);
	Данные.Вставить("ТаблицаАктов",		ТаблицаАктов);
	
	Данные.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	Возврат Данные;
	
КонецФункции

