#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьНаОсновании(Объект, ДанныеЗаполнения) Экспорт

	Если Не ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИнвентаризацияКассы") Тогда
		ЗаполнитьНаОсновании_ИнвентаризацияКассы(Объект, ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНаличныхСредств") Тогда
		ЗаполнитьНаОсновании_ИнвентаризационнаяОписьНаличныхСредств(Объект, ДанныеЗаполнения);
	КонецЕсли;
	
	УстановитьВыявленыОтклонения(Объект);
	
КонецПроцедуры

Процедура УстановитьВыявленыОтклонения(ДокументОбъект) Экспорт
	
	ВыявленыОтклонения = Ложь;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.НаличныеСредства Цикл
		Если СтрокаТаблицы.Недостача <> 0 Или СтрокаТаблицы.Излишек <> 0 Тогда
			ВыявленыОтклонения = Истина;
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ДокументОбъект.ВыявленыОтклонения = ВыявленыОтклонения;
	
КонецПроцедуры

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Форма 0510836
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0510836";
	КомандаПечати.Представление = НСтр("ru='Акт о результатах инвентаризации наличных денежных средств (ф. 0510836)'");
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0510836") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"Форма0510836",
			"ф.0510836",
			ПечатьФормы0510836(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода));
			
	КонецЕсли;
														
КонецПроцедуры

#Область ПроверкаНеизменностиОстатка

// Проверка неизменности остатка ф.0510836 (тройное сопоставление Акт-Остаток, Акт-Опись)
//
// Параметры:
//	МассивОбъектов - ДанныеФормыСтруктура, ДокументСсылка.АктОРезультатахИнвентаризацииНаличныхДС, Массив (ссылок)	-
//						Проверяемые документы АктОРезультатахИнвентаризацииНаличныхДС.
//						Поддерживается несколько типов значений этого параметра для документа АктОРезультатахИнвентаризацииНаличныхДС
//
// Возвращаемое значение:
//	ТаблицаЗначений, каждая строка которой содержит результат проверки отдельного документа акта инвентаризации.
//	Таблица имеет колонки:
//		АктСсылка			- ДокументСсылка.АктОРезультатахИнвентаризацииНаличныхДС	- Проверенный документ акта инвентаризации
//		ЗначенияСовпадают	- Булево	- Результат проверки в целом по документу акта инвентаризации
//		РазличияТаблиц		- Структура	- Содержит детальные таблицы, составленные в процессе проверки.
//								Может быть использована для формирования иного (альтернативного) представления результата проведенной проверки.
//								Структура содержит два ключа:
//								 * ОстатковИОписи			- Соответствие	- Соответствие Валюта -> ТаблицаЗначений с разельтатом сравнения таблиц остатков и описи
//								 * ОписиИАктаИнвентаризации	- Соответствие	- Соответствие Валюта -> ТаблицаЗначений с разельтатом сравнения таблиц описи и акта инвентаризации
//		ТекстСообщения		- Строка	- Текстовое представление результата проведенной проверки.
//								Может быть использовано для вывода на экран.
Функция ПроверитьНеизменностьОстатка(МассивОбъектов) Экспорт
	
	Данные = ПолучитьДанныеДляСопоставления(МассивОбъектов);
	
	ПараметрыРасчета = Новый Структура();
	ПараметрыРасчета.Вставить("СчитатьСуммуНулевойЕслиСтрокаСВалютойОтсутствуетВТабличнойЧасти", Истина);
	
	ДобавитьРазличияТаблицОстатковИОписей(Данные, ПараметрыРасчета);
	
	ДобавитьРазличияТаблицОписиИАктаИнвентаризации(Данные, ПараметрыРасчета);
	
	ДобавитьИтогПроверкиАктовИнвентаризации(Данные);
	
	Возврат Данные.ТаблицаИтоговПроверки;
	
КонецФункции

#КонецОбласти

#Область ВводНаОсновании

Функция ВводНаОсновании_НастройкиМеханизма(ПараметрыВводаНаОсновании = Неопределено) Экспорт
	
	Перем	НастройкиМеханизма,
			СвязиРеквизитов,
			ТиповаяОперацияСсылка,
			РеквизитыТиповойОперации,
			КолонкиТаблицыОтметки;
	
	ИспользоватьУчетПоИФО				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	//////////////////////////////////////////////////////////////////////////////
	ВидДокумента = "РасходныйКассовыйОрдер";
	//
	// Настройки разбивки данных
	//															Реквизит документа-основания	Реквизит нового документа
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Дата",							"Дата");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Организация",					"Организация");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Ссылка",						"ДокументОснование");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"НаличныеСредства.Валюта",		"ВалютаДокумента");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"НаличныеСредства.Недостача",	"СуммаДокумента,РасшифровкаПлатежа.Сумма");
	Если ИспользоватьУчетПоИФО Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,"ИФО",		"ИФО");
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,"Подразделение",	"Подразделение");
	КонецЕсли;
	//
	// Настройки таблицы "Отметки"
	//																		Колонка таблицы			Реквизит шапки нового документа
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"Валюта",				"ВалютаДокумента");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"Сумма",				"СуммаДокумента");
	Если ИспользоватьУчетПоИФО Тогда
		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,"ИФО",					"ИФО");
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям Тогда
		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,"Подразделение",		"Подразделение");
	КонецЕсли;
	ВводНаОсновании.ДобавитьНастройкиМеханизмаДляВидаДокументов(НастройкиМеханизма, ВидДокумента,
		СвязиРеквизитов,
		ТиповаяОперацияСсылка,
		РеквизитыТиповойОперации,
		КолонкиТаблицыОтметки);
		
		
	//////////////////////////////////////////////////////////////////////////////
	ВидДокумента = "ПриходныйКассовыйОрдер";
	//
	// Настройки разбивки данных
	//															Реквизит документа-основания			Реквизит нового документа
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Дата",									"Дата");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Организация",							"Организация");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Ссылка",								"ДокументОснование");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"НаличныеСредства.Валюта",		"ВалютаДокумента");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"НаличныеСредства.Излишек",		"СуммаДокумента,РасшифровкаПлатежа.Сумма");
	Если ИспользоватьУчетПоИФО Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,"ИФО",			"ИФО");
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,"Подразделение",	"Подразделение");
	КонецЕсли;
	//
	// Настройки таблицы "Отметки"
	//																		Колонка таблицы			Реквизит шапки нового документа
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"Валюта",				"ВалютаДокумента");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"Сумма",				"СуммаДокумента");
	Если ИспользоватьУчетПоИФО Тогда
		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,"ИФО",					"ИФО");
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям Тогда
		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,"Подразделение",		"Подразделение");
	КонецЕсли;
	ВводНаОсновании.ДобавитьНастройкиМеханизмаДляВидаДокументов(НастройкиМеханизма, ВидДокумента,
		СвязиРеквизитов,
		ТиповаяОперацияСсылка,
		РеквизитыТиповойОперации,
		КолонкиТаблицыОтметки);
	
	
		
		
	//////////////////////////////////////////////////////////////////////////////
	// Общие настройки механизма (для всех видов документов)
	//
	РеквизитыТиповойОперацииОснование = Новый Массив();
	ЗаголовкиКолонокТаблицыОтметки = Новый Структура();
	ВводНаОсновании.ДобавитьОбщиеНастройкиМеханизма(НастройкиМеханизма, РеквизитыТиповойОперацииОснование, ЗаголовкиКолонокТаблицыОтметки);
	
	Возврат НастройкиМеханизма;
	
КонецФункции

Функция ВводНаОсновании_НастройкиФормыСпискаДокументовВведенныхНаОсновании(ДополнительныйПараметр = Неопределено) Экспорт
	
	Перем	Таблица,
			МассивФлажков;
	
	ВидыДокументовСписание		= Новый Массив();
	ВидыДокументовПоступление	= Новый Массив();
	
	ВидДокумента = "РасходныйКассовыйОрдер";
	ВидыДокументовСписание.Добавить(ВидДокумента);
	ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
	ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Валюта",	,			"ВалютаДокумента");
	ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Сумма",		,			"СуммаДокумента");
	
	ВидДокумента = "ПриходныйКассовыйОрдер";
	ВидыДокументовПоступление.Добавить(ВидДокумента);
	ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
	ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Валюта",	,			"ВалютаДокумента");
	ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Сумма",		,			"СуммаДокумента");
	
	ЗаголовокФлажка = "Списания недостач";
	ВводНаОсновании.ДобавитьФлажок(МассивФлажков, ВидыДокументовСписание, ЗаголовокФлажка);
	
	ЗаголовокФлажка = "Оприходования излишков";
	ВводНаОсновании.ДобавитьФлажок(МассивФлажков, ВидыДокументовПоступление, ЗаголовокФлажка);
	
	
	НастройкиФормыСписка = Новый Структура();
	НастройкиФормыСписка.Вставить("ТаблицаОписаниеКолонок",	Таблица);
	НастройкиФормыСписка.Вставить("МассивФлажков",			МассивФлажков);
	
	Возврат НастройкиФормыСписка;
	
КонецФункции

// Позволяет переопределить имена колонок, определенные автоматически из настроек механизма.
Процедура ВводНаОсновании_Переопределяемый_КолонкиТаблицыОтметки(ПараметрыВводаНаОсновании, АвтоопределенныеИменаКолонок) Экспорт
	
КонецПроцедуры

Процедура ВводНаОсновании_ЗаполнитьДокумент(ЗаполняемыйДокумент, ДанныеЗаполнения) Экспорт
	
	ВводНаОсновании.ЗаполнитьНовыйДокумент(ЗаполняемыйДокумент, ДанныеЗаполнения);
	
	// Продолжаем заполнение нового документа
	
	ВидДокумента			= ДанныеЗаполнения["ДанныеМеханизмаВводаНаОсновании"]["ВидДокумента"];
	ДокументОснованиеСсылка	= ДанныеЗаполнения["Основание"];
	
	Если ВидДокумента = "РасходныйКассовыйОрдер" ИЛИ ВидДокумента = "ПриходныйКассовыйОрдер" Тогда
		ЗаполняемыйДокумент["Счет"]				= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("201.34");
		ЗаполняемыйДокумент["СуммаДокумента"]	= ЗаполняемыйДокумент["РасшифровкаПлатежа"].Итог("Сумма");
		ЗаполняемыйДокумент["ДокументОснование"]= ДокументОснованиеСсылка;
		
		РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснованиеСсылка, "Номер,Дата");
		
		НомерОснованияДляПечати = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(ДокументОснованиеСсылка, РеквизитыОснования.Номер);
		
		ПредставлениеОснования = СтрШаблон("%1 №%2 от %3",
			ДокументОснованиеСсылка.Метаданные().Синоним,
			НомерОснованияДляПечати,
			Формат(РеквизитыОснования.Дата, "ДФ=dd.MM.yyyy"));
		
		ЗаполняемыйДокумент["Основание"]= ПредставлениеОснования;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ДляВызоваИзДругихПодсистем

#Область ГолосованиеКомиссии

Процедура ЗаполнитьРезультатГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	ЗаполнитьРезультатыГолосования = Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	Если ЗаполнитьРезультатыГолосования Тогда
		РезультатГолосованияСотрудника = ОбщегоНазначенияБГУ.РезультатыГолосованияСотрудникаПоДокументу(
			Форма.Сотрудник, Объект.Ссылка, Объект.Комиссия, Объект.Организация);
		РезультатГолосованияКомиссии = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(
			Объект.Ссылка, Объект.Комиссия, Объект.Организация);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.НаличныеСредства Цикл
		
		СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Неопределено;
		СтрокаТаблицы.ИтогГолосования = 0;
		СтрокаТаблицы.РезолюцияКомиссииОдобрена = Ложь;
		Если ЗаполнитьРезультатыГолосования Тогда
			
			Если РезультатГолосованияСотрудника.Количество() > 0 Тогда
				Результаты = РезультатГолосованияСотрудника.Найти(СтрокаТаблицы.ИдентификаторСтроки, "ИдентификаторСтроки");
				Если Результаты <> Неопределено Тогда
					СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Результаты.РезультатГолосования;
				КонецЕсли;
			КонецЕсли;
			
			Если РезультатГолосованияКомиссии.Количество() > 0 Тогда
				ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки",
					Объект.Ссылка, СтрокаТаблицы.ИдентификаторСтроки);
				РезультатыГолосованияПоСтроке = РезультатГолосованияКомиссии.НайтиСтроки(ОтборПоИдентификаторуСтроки);
				Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
					СтрокаТаблицы.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
					СтрокаТаблицы.РезолюцияКомиссииОдобрена = РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УправлениеЭлементамиГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	// Письмо Минфина от 30 июля 2024 г. N 02-06-06/70843
	// В случае отсутствия по результатам проведенной инвентаризации недостачи или излишков наличных денежных средств,
	// голосование не осуществляется (Лист голосования не формируется), графы 7 и 8 табличной части
	// Акта инвентаризации (ф. 0510836) не заполняются.
	ДоступностьГолосования = Не Объект.Ссылка.Пустая() И Не Объект.Проведен
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация)
		И Объект.НаличныеСредства.Количество() > 0
		И Объект.ВыявленыОтклонения;
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("ГруппаГолосование");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Доступность", ДоступностьГолосования);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("НаличныеСредстваИтогГолосования");
	ЭлементыГолосование.Добавить("НаличныеСредстваРезолюцияКомиссииОдобрена");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования ИЛИ Объект.Проведен);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("НаличныеСредстваУстановитьРешениеЕдиногласноЗаВоВсехСтроках");
	ЭлементыГолосование.Добавить("НаличныеСредстваУстановитьРешениеЕдиногласноПротивВоВсехСтроках");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И Не ЗначениеЗаполнено(Форма.Сотрудник));
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("НаличныеСредстваУстановитьРешениеЗаВоВсехСтроках");
	ЭлементыГолосование.Добавить("НаличныеСредстваУстановитьРешениеПротивВоВсехСтроках");
	ЭлементыГолосование.Добавить("НаличныеСредстваУстановитьРешениеЗаВВыделенныхСтроках");
	ЭлементыГолосование.Добавить("НаличныеСредстваУстановитьРешениеПротивВВыделенныхСтроках");
	ЭлементыГолосование.Добавить("НаличныеСредстваРешениеСотрудникаПоРезолюции");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СохранитьРезультатыГолосования", "Доступность",
			ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник) И Форма.РешениеСотрудникаМодифицированность);
	
КонецПроцедуры

