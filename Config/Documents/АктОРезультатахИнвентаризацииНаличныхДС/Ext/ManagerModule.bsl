Функция ПолучитьПустуюТаблицуРазличийПострочно(ИменаКолонокСумм)
	
	ОписаниеТипаНомерСтроки	= ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный);
	ОписаниеТипаСумма		= ОбщегоНазначения.ОписаниеТипаЧисло(15, 2, ДопустимыйЗнак.Любой);
	
	ТаблицаРазличий = Новый ТаблицаЗначений();
	ТаблицаРазличий.Колонки.Добавить("Валюта",				Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаРазличий.Колонки.Добавить("НомерСтрокиТаблица1",	ОписаниеТипаНомерСтроки);
	ТаблицаРазличий.Колонки.Добавить("НомерСтрокиТаблица2",	ОписаниеТипаНомерСтроки);
	ТаблицаРазличий.Колонки.Добавить("ЗначенияСовпадают",	Новый ОписаниеТипов("Булево"));
	
	Для Каждого ИмяКолонкиСуммы Из ИменаКолонокСумм Цикл
		ТаблицаРазличий.Колонки.Добавить(ИмяКолонкиСуммы + "Таблица1", ОписаниеТипаСумма);
		ТаблицаРазличий.Колонки.Добавить(ИмяКолонкиСуммы + "Таблица2", ОписаниеТипаСумма);
		ТаблицаРазличий.Колонки.Добавить(ИмяКолонкиСуммы + "ЗначенияСовпадают", Новый ОписаниеТипов("Булево"));
	КонецЦикла;
	
	Возврат ТаблицаРазличий;
	
КонецФункции

