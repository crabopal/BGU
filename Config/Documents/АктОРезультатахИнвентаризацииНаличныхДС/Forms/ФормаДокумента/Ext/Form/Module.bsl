Процедура ПроверитьНеизменностьОстаткаКлиент()
	
	РезультатПроверки = ПроверитьНеизменностьОстаткаСервер();
	
	ЗначенияСовпадают	= РезультатПроверки.ЗначенияСовпадают;
	ТекстСообщения		= РезультатПроверки.ТекстСообщения;
	ОписьСсылка 		= РезультатПроверки.ОписьСсылка;
	
	Если ЗначенияСовпадают Тогда
		КартинкаВопроса = БиблиотекаКартинок.Информация32;
		
		ЗаголовокВопроса = НСтр("ru = 'Проверка неизменности остатка (успешно)'");
	Иначе
		КартинкаВопроса = БиблиотекаКартинок.Предупреждение32;
		
		ЗаголовокВопроса = НСтр("ru = 'Проверка неизменности остатка (есть различия)'");
		
		Если Не ЗначениеЗаполнено(ОписьСсылка) Тогда
			ЗаголовокВопроса = НСтр("ru = 'Проверка неизменности остатка'");
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Ложь;
	ПараметрыВопроса.Картинка = КартинкаВопроса;
	ПараметрыВопроса.Заголовок = ЗаголовокВопроса;
	
	СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(
			Неопределено,
			ТекстСообщения,
			РежимДиалогаВопрос.ОК,
			ПараметрыВопроса);
	
КонецПроцедуры

