&НаСервере
Процедура ИнициализироватьФорму()
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если Параметры.Ключ.Пустая() Тогда
		УстановитьРуководителя(Объект);
	КонецЕсли;
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ИнициализироватьФормуДокументаЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	ОбщегоНазначенияБГУ.ИнициализироватьФормуДляВыбораРезолюций(
		ЭтотОбъект,
		Элементы.НаличныеСредстваРезолюцияКомиссии);
	
	НастроитьНедоступностьИзмененияКолонок();
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриЧтенииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ЗаполнитьСлужебныеКолонкиЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	НастроитьФормуСерверПоВалюте();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьНедоступностьИзмененияКолонок()
	
	НедоступныеКолонки = Новый Массив();
	НедоступныеКолонки.Добавить("СоставКомиссииСотрудник");
	
	ИнвентаризацияСервер.НастроитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтотОбъект, НедоступныеКолонки, Ложь);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСерверПоВалюте()
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	
	Элементы.НаличныеСредстваНадписьРублевыйЭквивалент.Видимость	= ИспользоватьВалютныйУчет;
	Элементы.НаличныеСредстваНадписьВВалюте.Видимость				= ИспользоватьВалютныйУчет;
	
	Если Не ИспользоватьВалютныйУчет Тогда
		НовыйПараметр = Новый ПараметрВыбора("Отбор.Ссылка", ВалютаРУ);
		
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(НовыйПараметр);
		
		НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
		
		Элементы.НаличныеСредстваВалюта.ПараметрыВыбора = НовыеПараметры;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВключитьДоступностьРедактированияСоставаКомиссии()
	
	Элементы.ФормаРазрешитьРедактированиеСоставаКомиссии.Пометка = Истина;
	
	Элементы.СоставКомиссии.ИзменятьСоставСтрок = Истина;
	Элементы.СоставКомиссии.ИзменятьПорядокСтрок = Истина;
	
	Элементы.СоставКомиссии.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Верх;
	
	НедоступныеКолонки = Новый Массив();
	НедоступныеКолонки.Добавить("СоставКомиссииСотрудник");
	
	ИнвентаризацияСервер.ОтключитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтотОбъект, НедоступныеКолонки);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ИнвентаризацияСервер.ДобавитьУсловноеОформлениеСоставКомиссииПричинаОтсутствия(ЭтотОбъект);
	
	ДобавитьУсловноеОформление_НадписиВалютныхСтрок();
	
	ДобавитьУсловноеОформление_СкрытьПоляДляРублей();
	
	ДобавитьУсловноеОформление_БлокироватьПоляПриЗаполненнойОписи();
	
	ДобавитьУсловноеОформление_РешениеСотрудника();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_НадписиВалютныхСтрок()
	
	//
	// Таблица ""Наличные средства"" - надпись ""в валюте""
	//
	ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Таблица ""Наличные средства"" - надпись ""в валюте""'");
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='в валюте'"));
	
	// Условие
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("Объект.НаличныеСредства.Валюта");
	Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.Заполнено;
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("Объект.НаличныеСредства.Валюта");
	Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.НеРавно;
	Условие.ПравоеЗначение	= ВалютаРУ;
	
	// Оформляемые поля
	ИмяЭлемента = "НаличныеСредстваНадписьВВалюте";
	ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
	ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	
	
	//
	// Таблица ""Наличные средства"" - надпись ""рублевый эквивалент""
	//
	ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Таблица ""Наличные средства"" - надпись ""рублевый эквивалент""'");
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='рублевый эквивалент'"));
	
	// Условие
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("Объект.НаличныеСредства.Валюта");
	Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.Заполнено;
	
