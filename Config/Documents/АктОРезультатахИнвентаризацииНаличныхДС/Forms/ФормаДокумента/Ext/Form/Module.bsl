&НаКлиенте
Процедура ПересчитатьСуммыВСтроке(Элемент)
	
	ТекДанные = Элементы.НаличныеСредства.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УказанаИностраннаяВалюта = ЗначениеЗаполнено(ТекДанные.Валюта) И ТекДанные.Валюта <> ВалютаРУ;
	
	
	ИмяПоля = СтрЗаменить(Элемент.Имя, "НаличныеСредства", "");
	
	ИзмененаВалюта = (ИмяПоля = "Валюта");
	
	ИзмененаЛюбаяНедостача = СтрНайти(ИмяПоля, "Недостача") > 0;
	
	ИзмененЛюбойИзлишек = СтрНайти(ИмяПоля, "Излишек") > 0;
	
	ИзмененаВалютнаяНедостача = УказанаИностраннаяВалюта И ИмяПоля = "Недостача";
	
	ИзмененВалютныйИзлишек = УказанаИностраннаяВалюта И ИмяПоля = "Излишек";
	
	
	ОбновитьРублевыйЭквивалент = УказанаИностраннаяВалюта И (ИзмененаВалюта ИЛИ ИзмененаВалютнаяНедостача ИЛИ ИзмененВалютныйИзлишек);
	
	
	ЗначенияПараметров = Новый Структура();
	
	// Очищаем противоположный вид расхождения
	
	Если ИзмененаЛюбаяНедостача Тогда
		ЗначенияПараметров.Вставить("Излишек");
		ЗначенияПараметров.Вставить("ИзлишекРублевыйЭквивалент");
		
	ИначеЕсли ИзмененЛюбойИзлишек Тогда
		ЗначенияПараметров.Вставить("Недостача");
		ЗначенияПараметров.Вставить("НедостачаРублевыйЭквивалент");
	КонецЕсли;
	
	// Обновляем рублевый эквивалент
	
	Если НЕ УказанаИностраннаяВалюта Тогда
		ЗначенияПараметров.Вставить("ИзлишекРублевыйЭквивалент");
		ЗначенияПараметров.Вставить("НедостачаРублевыйЭквивалент");
	КонецЕсли;
	
	Если ОбновитьРублевыйЭквивалент Тогда
		КурсВалюты = ПолучитьКурсВалюты(ТекДанные.Валюта, Объект.ДатаОкончания);
		
		МассивПолей = Новый Массив();
		
		Если ИзмененаВалюта Тогда
			МассивПолей.Добавить(Новый Структура("Источник,Приемник", "Недостача", "НедостачаРублевыйЭквивалент"));
			МассивПолей.Добавить(Новый Структура("Источник,Приемник", "Излишек", "ИзлишекРублевыйЭквивалент"));
			
		ИначеЕсли ИзмененаВалютнаяНедостача Тогда
			МассивПолей.Добавить(Новый Структура("Источник,Приемник", "Недостача", "НедостачаРублевыйЭквивалент"));
			
		ИначеЕсли ИзмененВалютныйИзлишек Тогда
			МассивПолей.Добавить(Новый Структура("Источник,Приемник", "Излишек", "ИзлишекРублевыйЭквивалент"));
		КонецЕсли;
		
		Для Каждого ОписаниеПолей Из МассивПолей Цикл
			Если ЗначениеЗаполнено(КурсВалюты.Кратность) Тогда
				РублевыйЭквивалент = Окр(ТекДанные[ОписаниеПолей.Источник] * КурсВалюты.Курс / КурсВалюты.Кратность, 2);
			Иначе
				РублевыйЭквивалент = 0;
			КонецЕсли;
			
			ЗначенияПараметров.Вставить(ОписаниеПолей.Приемник, РублевыйЭквивалент);
		КонецЦикла;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ЗначенияПараметров);
	
	УстановитьРезолюциюКомиссииВСтроке(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРезолюциюКомиссииВСтроке(ТекДанные)
	
	Если ТекДанные.Недостача = 0 И ТекДанные.Излишек = 0 Тогда
		ИдентификаторРезолюции = "(0510836) Расхождения не выявлены";
		
	ИначеЕсли ТекДанные.Недостача > 0 Тогда
		ИдентификаторРезолюции = "(0510836) Установлена недостача";
		
	ИначеЕсли ТекДанные.Излишек > 0 Тогда
		ИдентификаторРезолюции = "(0510836) Установлены излишки";
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.УстановитьРезолюциюПоИдентификаторуВСтроке(ЭтаФорма, ТекДанные, ИдентификаторРезолюции);
	
КонецПроцедуры

