#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ИдентификаторЗначенияПараметра = Параметры.ИдентификаторЗначенияПараметра;
	Если ИдентификаторЗначенияПараметра = 1 Тогда
		ЭтаФорма.Заголовок = НСтр("ru = 'Пересчет времени в часы'");
	ИначеЕсли ИдентификаторЗначенияПараметра = 2 Тогда
		ЭтаФорма.Заголовок = НСтр("ru = 'Расчет объема транспортной работы (т.км)'");
	КонецЕсли;
	
	УстановитьВидимостьЭлементов(ЭтаФорма);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПриЗакрытии()
	Если ПеренестиВДокумент Тогда
		Результат = Новый Структура("ИдентификаторЗначенияПараметра, ПродолжительностьРаботы, ОбъемТранспортнойРаботы");
		ЗаполнитьЗначенияСвойств(Результат, ЭтаФорма);
			
		ОповеститьОВыборе(Результат);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если Модифицированность И НЕ ПеренестиВДокумент Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
			НСтр("ru = 'Данные были изменены. Сохранить изменения?'"),
			РежимДиалогаВопрос.ДаНетОтмена, ,КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ФормаВводЗначенияПоказателя_Закрыть" И Источник = ВладелецФормы Тогда
		// Сообщение от основной формы документа при нажатии там Esc.
		// Сбрасываем флаг модифицированности и закрываем форму редактирования строки без вопросов.
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПродолжительностьРаботыСтрПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура МассаГрузаПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура РасстояниеПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	ПеренестиВДокумент = Истина;
	ЗавершитьРедактирование();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗавершитьРедактирование()
	
	Если Модифицированность = Истина Тогда
		
		Модифицированность = Ложь;
		
		Если ИдентификаторЗначенияПараметра = 1 Тогда
			ПродолжительностьРаботы = УчетВремениКлиентСервер.ЧислоИзСтроки(ПродолжительностьРаботыСтр);
			ОбъемТранспортнойРаботы = 0;
		ИначеЕсли ИдентификаторЗначенияПараметра = 2 Тогда	
			ОбъемТранспортнойРаботы = МассаГруза * Расстояние;
			ПродолжительностьРаботы = 0;
		КонецЕсли;	
			
		Результат = Новый Структура("ИдентификаторЗначенияПараметра, ПродолжительностьРаботы, ОбъемТранспортнойРаботы");
		ЗаполнитьЗначенияСвойств(Результат, ЭтаФорма);
		ПеренестиВДокумент = Истина;		
		Закрыть(Результат);
	Иначе
		ПеренестиВДокумент = Ложь;		
		Закрыть();
	КонецЕсли;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Идентификатор = Форма.ИдентификаторЗначенияПараметра;	
	
	Если Идентификатор = 1 Тогда
			
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаДанныхВремя", "Видимость", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаДанныхТонноКилометры", "Видимость", Ложь);
	ИначеЕсли Идентификатор = 2 Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаДанныхВремя", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаДанныхТонноКилометры", "Видимость", Истина);
	КонецЕсли;	
		
КонецПроцедуры	

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗавершитьРедактирование();
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

