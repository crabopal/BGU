			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ТаксировкаПутевогоЛиста.Ссылка КАК Ссылка,
	ТаксировкаПутевогоЛиста.ВерсияДанных КАК ВерсияДанных,
	ТаксировкаПутевогоЛиста.ПометкаУдаления КАК ПометкаУдаления,
	ТаксировкаПутевогоЛиста.Номер КАК Номер,
	ТаксировкаПутевогоЛиста.Дата КАК Дата,
	ТаксировкаПутевогоЛиста.Проведен КАК Проведен,
	ТаксировкаПутевогоЛиста.ВидТаксировки КАК ВидТаксировки,
	ТаксировкаПутевогоЛиста.ТранспортноеСредство КАК ТранспортноеСредство,
	ТаксировкаПутевогоЛиста.МОЛ КАК МОЛ,
	ТаксировкаПутевогоЛиста.НомерСмены КАК НомерСмены,
	ТаксировкаПутевогоЛиста.ПутевойЛист КАК ПутевойЛист,
	ТаксировкаПутевогоЛиста.ПробегОбщий КАК ПробегОбщий,
	ТаксировкаПутевогоЛиста.СерияПутевогоЛиста КАК СерияПутевогоЛиста,
	ТаксировкаПутевогоЛиста.НомерПутевогоЛиста КАК НомерПутевогоЛиста,
	ТаксировкаПутевогоЛиста.ДатаПутевогоЛиста КАК ДатаПутевогоЛиста,
	ТаксировкаПутевогоЛиста.Организация КАК Организация,
	ТаксировкаПутевогоЛиста.Комментарий КАК Комментарий,
	ТаксировкаПутевогоЛиста.ПервичныйДокумент КАК ПервичныйДокумент,
	ОперацииДокументов.Операция КАК Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
