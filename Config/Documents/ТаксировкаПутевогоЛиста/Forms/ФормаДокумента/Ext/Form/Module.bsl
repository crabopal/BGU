Процедура ФактическийРасходГСМЗаправкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуДанныхОЗаправках(Элементы.ФактическийРасходГСМ.ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура ФактическийРасходГСМВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ФактическийРасходГСМЗаправки" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуДанныхОЗаправках(ВыбраннаяСтрока);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФактическийРасходГСМПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Если ОтменаРедактирования И НоваяСтрока Тогда
		// Закроем форму настройки отражения в учете, т.к. пользователь отменяет ввод
		Оповестить("ФормаНастройкаОтраженияВУчете_Закрыть", Неопределено, ЭтаФорма);
	КонецЕсли;

	ЭтоНоваяСтрока = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ФактическийРасходГСМНормативныйРасходГорючегоПриИзменении(Элемент)
	ПерерасчетЭкономииПерерасхода();
КонецПроцедуры

&НаКлиенте
Процедура ФактическийРасходГСМПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекущиеДанные = Элементы.ФактическийРасходГСМ.ТекущиеДанные;
		ОбновитьТекстЗаголовковВСтрокеТаблицыФактическийРасход(ТекущиеДанные);
		ОбновитьТекстДанныеОЗаправкеСтрокиТаблицыФактическийРасход(ЭтаФорма, ТекущиеДанные); 
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура ФактическийРасходГСМПередУдалением(Элемент, Отказ)
	ПараметрыОтбора = Новый Структура("ВидГСМ", Элемент.ТекущиеДанные.ВидГСМ); 	
	//удаление заправок
	МассивКУдалению = Объект.ЗаправкиГСМ.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
		Объект.ЗаправкиГСМ.Удалить(СтрокаКУдалению);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ФактическийРасходГСМПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	ЭтоНоваяСтрока = Истина;
КонецПроцедуры

#КонецОбласти

