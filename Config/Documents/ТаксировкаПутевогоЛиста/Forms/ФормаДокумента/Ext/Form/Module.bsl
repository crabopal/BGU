&НаКлиенте
Процедура МатериалыПричинаСписанияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОткрытьФорму("Справочник.НаправленияРасходаМПЗ.Форма.ФормаВыбора",,Элемент);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПричинаСписанияАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	Если СтрДлина(Текст) > 0 Тогда
		ПараметрыВыбораЗначения = Новый Структура("СтрокаПоиска", Текст);
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.НаправленияРасходаМПЗ"), ПараметрыВыбораЗначения);
		Если ДанныеВыбора.Количество() > 0 Тогда
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.НаправленияРасходаМПЗ") Тогда
		МассивСтрок = Элементы.Материалы.ВыделенныеСтроки;
		Для Каждого ЭлМас Из МассивСтрок Цикл
			ТекСтр = Объект.Материалы.НайтиПоИдентификатору(ЭлМас);
			Если ТекСтр <> Неопределено Тогда
				ТекСтр.ПричинаСписания = ВыбранноеЗначение;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ПричиныСписанияНФА") Тогда
		МассивСтрок = Элементы.Материалы.ВыделенныеСтроки;
		Для Каждого ЭлМас Из МассивСтрок Цикл
			ТекСтр = Объект.Материалы.НайтиПоИдентификатору(ЭлМас);
			Если ТекСтр <> Неопределено Тогда
				ТекСтр.ПричинаСписанияСсылка = ВыбранноеЗначение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыСчетУчетаПриИзменении(Элемент)
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТекущейСтрокиМатериалов(Объект, Элементы.Материалы.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыНоменклатураПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	УправлениеМатериальнымиЗапасамиКлиент.УстановитьСчетУчетПоНоменклатуреВСтрокеМатериалов(ТекущиеДанные, Объект, );
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТекущейСтрокиМатериалов(Объект, ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыСчетУчетаАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	ПараметрыАвтоПодбора = Новый Структура("СтрокаПоиска", Текст);
	ПараметрыАвтоПодбора.Вставить("Отбор", Новый Структура("ЭлементГруппа", Ложь));
	ПараметрыАвтоПодбора.Вставить("ОграниченияСписокСчетов", Счета105);
	ПараметрыАвтоПодбора.Вставить("ВидСравненияВСписке", Истина);
	
	ДанныеВыбора = ПолучитьДанныеВыбора(Тип("ПланСчетовСсылка.ЕПСБУ"), ПараметрыАвтоПодбора);
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыСчетУчетаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, Параметры, СтандартнаяОбработка)
	УправлениеМатериальнымиЗапасамиКлиент.ОкончаниеВводаТекстаСчетаМатериалаВТаблицеДокумента(ЭтаФорма,, Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "МатериалыОтражениеВУчете" Тогда
		ОткрытьФормуНастройкиОтраженияВУчете(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	ОбщегоНазначенияБГУКлиент.РешениеСотрудникаПоРезолюцииВыбор(ЭтотОбъект, Поле, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПриАктивизацииЯчейки(Элемент)
	Если Элементы.Материалы.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоНоваяСтрока Тогда
		ТекущаяКолонкаТаблицы = Элементы.Материалы.ТекущийЭлемент;
		Если ТекущаяКолонкаТаблицы.Имя = "МатериалыОтражениеВУчете"
			И НЕ Элементы.Материалы.ТекущиеДанные.ОтражениеВУчетеЗаполнено Тогда
			ВыбраннаяСтрока = Элементы.Материалы.ТекущаяСтрока;
			ОткрытьФормуНастройкиОтраженияВУчете(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ЭтоНоваяСтрока = НоваяСтрока;
	СтрокаТаблицы = Элементы.Материалы.ТекущиеДанные;
 	Если НоваяСтрока Тогда
		СтрокаТаблицы.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТекущейСтрокиМатериалов(Объект, Элементы.Материалы.ТекущиеДанные);
		ТекНомерСтроки = СтрокаТаблицы.НомерСтроки;
		Если ТекНомерСтроки >1 Тогда
			Элементы.Материалы.ТекущиеДанные.ПричинаСписания = Объект.Материалы[ТекНомерСтроки-2].ПричинаСписания;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		Возврат;
	КонецЕсли;

	СтрокаТаблицы.ОтражениеВУчете = "<...>";
	
	ОбновитьТекстЗаголовковВСтрокеТаблицыМатериалы(СтрокаТаблицы);

КонецПроцедуры                 

&НаКлиенте
Процедура МатериалыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Если ОтменаРедактирования И НоваяСтрока Тогда
		// Закроем форму настройки отражения в учете, т.к. пользователь отменяет ввод
		Оповестить("ФормаНастройкаОтраженияВУчете_Закрыть", Неопределено, ЭтаФорма);
	КонецЕсли;

	ЭтоНоваяСтрока = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыОтражениеВУчетеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуНастройкиОтраженияВУчете(Элементы.Материалы.ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыКФОПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, ТекущиеДанные.КФО);
	Если НЕ ОтражатьВНалоговомУчете Тогда
		ТекущиеДанные.СчетНУ      = Неопределено;
		ТекущиеДанные.СубконтоНУ1 = Неопределено;
		ТекущиеДанные.СубконтоНУ2 = Неопределено;
		ТекущиеДанные.СубконтоНУ3 = Неопределено;
	КонецЕсли;
	
	ПоляФормы = Новый Структура("Счет, Субконто1, Субконто2, Субконто3, КПС, Подразделение",
		"СчетДт", "СубконтоДт1", "СубконтоДт2", "СубконтоДт3", "КПСДт", "ПодразделениеДт");
	ПараметрыОбъекта = Новый Структура("ОтражатьВНалоговомУчете, ОтражатьВНалоговомУчетеУСН, ЕстьНДС, ЕстьКПС, ЕстьПодразделение",
		ОтражатьВНалоговомУчете,
		Ложь,
		Ложь,
		НЕ ТекущиеДанные.КПС = ТекущиеДанные.КПСДт И ЗначениеЗаполнено(ТекущиеДанные.КПСДт),
		НЕ ТекущиеДанные.Подразделение = ТекущиеДанные.ПодразделениеДт И ЗначениеЗаполнено(ТекущиеДанные.ПодразделениеДт));
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(ТекущиеДанные, ПараметрыОбъекта, ПоляФормы);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыРешениеСотрудникаПоРезолюцииОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	ТекущиеДанные.РешениеСотрудникаПоРезолюции = ВыбранноеЗначение;
	
	РешениеСотрудникаМодифицированность = Истина;
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
КонецПроцедуры

