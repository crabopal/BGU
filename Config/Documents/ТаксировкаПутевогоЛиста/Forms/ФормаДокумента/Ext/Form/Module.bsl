&НаСервере
Функция	СезонныеНастройкиСоответствуютДате(НастройкиСезона,ДатаРасчета)	
	Результат = Истина;
	Если НастройкиСезона.МесяцНачалаСезона > НастройкиСезона.МесяцОкончанияСезона Тогда
		//с конца на начало года	
		НачалоПервогоПериодаСезона = Дата(Год(ДатаРасчета),1,1);
		
		ЧислоМесяцаОкончанияСезона = НастройкиСезона.ЧислоМесяцаОкончанияСезона;
		
		ГодВисокосный = УчетГСМ.ЭтоВисокосныйГод(ДатаРасчета);
		Если НастройкиСезона.МесяцОкончанияСезона = 2 Тогда
			Если ГодВисокосный Тогда
				ЧислоМесяцаОкончанияСезона = 29;
			Иначе	
				ЧислоМесяцаОкончанияСезона = 28;
			КонецЕсли;	
		КонецЕсли;	
		
		КонецПервогоПериодаСезона = Конецдня(Дата(Год(ДатаРасчета), НастройкиСезона.МесяцОкончанияСезона, ЧислоМесяцаОкончанияСезона));
		
		НачалоВторогоПериодаСезона = Дата(Год(ДатаРасчета), НастройкиСезона.МесяцНачалаСезона, НастройкиСезона.ЧислоМесяцаНачалаСезона);
		КонецВторогоПериодаСезона = Конецдня(Дата(Год(ДатаРасчета),12,31));
		
		Если (НачалоПервогоПериодаСезона <= НачалоДня(ДатаРасчета))И(КонецПервогоПериодаСезона>=НачалоДня(ДатаРасчета)) Тогда
			Результат = Истина;
		Иначе
			Если (НачалоВторогоПериодаСезона <= НачалоДня(ДатаРасчета))И(КонецВторогоПериодаСезона>=НачалоДня(ДатаРасчета)) Тогда
				Результат = Истина;
			Иначе
				Результат = Ложь;
			КонецЕсли;	
		КонецЕсли;	
	Иначе
		//в середине года
		НачалоПериодаСезона = Дата(Год(ДатаРасчета),НастройкиСезона.МесяцНачалаСезона,НастройкиСезона.ЧислоМесяцаНачалаСезона);
		КонецПериодаСезона = КонецДня(Дата(Год(ДатаРасчета),НастройкиСезона.МесяцОкончанияСезона,НастройкиСезона.ЧислоМесяцаОкончанияСезона));
		Если (НачалоПериодаСезона <= НачалоДня(ДатаРасчета))И(КонецПериодаСезона>=НачалоДня(ДатаРасчета)) Тогда
			Результат = Истина;
		Иначе
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;
	Возврат Результат;
КонецФункции	

