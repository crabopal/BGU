			НоваяСтрока.НаименованиеЗначения = Выборка.НазваниеНастройки;
			НоваяСтрока.ПоправочноеЗначение = Выборка.Настройка;
			НоваяСтрока.Значение = Выборка.Настройка.Значение;
			НоваяСтрока.ЕдиницаИзмерения = Выборка.Настройка.ЕдиницаИзмерения;
			НоваяСтрока.ЗначениеОсновногоПараметраРасчета = Выборка.Настройка.ЗначениеОсновногоПараметраРасчета;
			НоваяСтрока.ЕдиницаИзмеренияПараметра = Выборка.Настройка.ЕдиницаИзмеренияПараметра;
			НоваяСтрока.КлючСтроки = Ключ;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьНастройкиРасчетаГСМДляТСНаСервере()
	МожноЗаполнятьНастройки = МожноЗаполнитьНастройкиРасчета();
	
	Если МожноЗаполнятьНастройки Тогда
		Объект.НормыРасхода.Очистить();
		Объект.ПоправочныеКоэффициенты.Очистить();
		Объект.ПоправочныеЗначения.Очистить();
		
		ТекущаяСуммаПробега = 0;
		Для Каждого ТекущийМаршрут Из Объект.ДанныеМаршрута Цикл
			ДобавитьНастройкиПоКлючу(ТекущийМаршрут.КлючСтроки, ТекущийМаршрут.ВидГСМ, ТекущийМаршрут.Пробег, ТекущаяСуммаПробега, 
				ТекущийМаршрут.НомерСтроки, ТекущийМаршрут.ПродолжительностьПростоя);
			ДобавитьНастройкиДляМаршрутаДвижения(ТекущийМаршрут.КлючСтроки, ТекущийМаршрут.МаршрутДвижения);
			ТекущаяСуммаПробега = ТекущаяСуммаПробега + ТекущийМаршрут.Пробег;
		КонецЦикла;
		
		Объект.НормыРасхода.Сортировать("Значение Убыв");
		Объект.ПоправочныеЗначения.Сортировать("Значение  Убыв");
		Объект.ПоправочныеКоэффициенты.Сортировать("Значение  Убыв");
		
		РассчитатьИЗаписатьОбщийПробегПоМаршрутам();
		
		ПробегОбщийПриИзмененииНаСервере();		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.Материалы.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Дата, Организация, Подразделение, ИФО,
		|КФО, КПС, КЭК, Количество");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.КПС = ДанныеСтроки.КПСДт;
	ПараметрыФормы.Подразделение = ДанныеСтроки.ПодразделениеДт;
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	// КФО, КПС и КЭК изменять не нужно
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО", 		Истина);
	ПараметрыФормы.Вставить("ТолькоПросмотрКЭК", 		Истина);
	ПараметрыФормы.Вставить("ВидимостьКПС", 			Истина);
	ПараметрыФормы.Вставить("ВидимостьКЭК", 			Ложь);
	ПараметрыФормы.Вставить("ВидимостьПодразделение", 	Истина);
	ПараметрыФормы.Вставить("ВидимостьКоличество", 		Ложь);
	
	// Бухгалтерский учет
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.СчетДт);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.СубконтоДт1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.СубконтоДт2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.СубконтоДт3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", 			НСтр("ru = 'Настройка отражения расходов в учете'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет", 			НСтр("ru = 'Счет дебета'"));
	ПараметрыФормы.Вставить("ЗаголовокПодразделение", 	НСтр("ru = 'Подразделение дебета'"));
	
	ПараметрыСчета = Новый Структура("ОграниченияСписокСчетов",
	
	БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов("106.00,109.00,401.20"));
	
	ПараметрыФормы.Вставить("ПараметрыСчета", ПараметрыСчета);
	// Налоговый учет
	ПараметрыФормы.Вставить("СчетНУ",      ДанныеСтроки.СчетНУ);
	ПараметрыФормы.Вставить("СубконтоНУ1", ДанныеСтроки.СубконтоНУ1);
	ПараметрыФормы.Вставить("СубконтоНУ2", ДанныеСтроки.СубконтоНУ2);
	ПараметрыФормы.Вставить("СубконтоНУ3", ДанныеСтроки.СубконтоНУ3);
	
	ПараметрыСчетаНУ = Новый Структура("ОграниченияСписокСчетов",
		БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов("Н08,Н15,Н20,Н25,Н26,Н44,Н91.02"));
	ПараметрыФормы.Вставить("ПараметрыСчетаНУ", ПараметрыСчетаНУ);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияВУчетеНаКлиенте(СтруктураОтражениеВУчете)

	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураОтражениеВУчете,,"Количество,КПС,Подразделение"); // КФО, КПС, КЭК и пр.
	
	ТекущиеДанные.КПСДт = СтруктураОтражениеВУчете.КПС;
	ТекущиеДанные.ПодразделениеДт = СтруктураОтражениеВУчете.Подразделение;
	
	ТекущиеДанные.СчетДт      = СтруктураОтражениеВУчете.Счет;
	ТекущиеДанные.СубконтоДт1 = СтруктураОтражениеВУчете.Субконто1;
	ТекущиеДанные.СубконтоДт2 = СтруктураОтражениеВУчете.Субконто2;
	ТекущиеДанные.СубконтоДт3 = СтруктураОтражениеВУчете.Субконто3;
	
	ТекущиеДанные.СчетНУ          = СтруктураОтражениеВУчете.СчетНУ;
	ТекущиеДанные.СубконтоНУ1     = СтруктураОтражениеВУчете.СубконтоНУ1;
	ТекущиеДанные.СубконтоНУ2     = СтруктураОтражениеВУчете.СубконтоНУ2;
	ТекущиеДанные.СубконтоНУ3     = СтруктураОтражениеВУчете.СубконтоНУ3;
	
	ПоляФормы = Новый Структура("Счет, Субконто1, Субконто2, Субконто3, КПС, Подразделение",
		"СчетДт", "СубконтоДт1", "СубконтоДт2", "СубконтоДт3", "КПСДт", "ПодразделениеДт");
	ПараметрыОбъекта = Новый Структура("ОтражатьВНалоговомУчете, ОтражатьВНалоговомУчетеУСН, ЕстьНДС, ЕстьКПС, ЕстьПодразделение",
		НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, ТекущиеДанные.КФО),
		Ложь,
		Ложь,
		НЕ ТекущиеДанные.КПС = ТекущиеДанные.КПСДт И ЗначениеЗаполнено(ТекущиеДанные.КПСДт),
		НЕ ТекущиеДанные.Подразделение = ТекущиеДанные.ПодразделениеДт И ЗначениеЗаполнено(ТекущиеДанные.ПодразделениеДт));
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(ТекущиеДанные, ПараметрыОбъекта, ПоляФормы);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()
	
	// Колонки ОтражениеВУчете
	ПоляФормы = Новый Структура("Счет, Субконто1, Субконто2, Субконто3, КПС, Подразделение",
