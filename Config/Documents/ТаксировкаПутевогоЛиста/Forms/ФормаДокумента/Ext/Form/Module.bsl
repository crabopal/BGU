&НаКлиенте
Процедура ПоказатьФормулуРасчета(Команда)
	ТекущаяСтрока = Элементы.ДанныеМаршрута.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		Если ТекущаяСтрока.Пробег = 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для маршрута номер %1 не указано значение пробега'"),ТекущаяСтрока.НомерСтроки);
			Сообщение.Сообщить();
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ВидГСМ)  Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для маршрута номер %1 не указано значение вида ГСМ'"),ТекущаяСтрока.НомерСтроки);
			Сообщение.Сообщить();
		КонецЕсли;
		
		ПараметрыРасчета = Новый Структура("Пробег, ВидГСМ, ЕдиницаИзмерения, РасшифровкаРасчетаНормативногоРасходаГСМ, НормативРасходаГСМ, КлючСтроки");
		ЗаполнитьЗначенияСвойств(ПараметрыРасчета, ТекущаяСтрока);
		ОткрытьФорму("Документ.ТаксировкаПутевогоЛиста.Форма.ФормаРасшифровкиФормулыРасчета", ПараметрыРасчета, ЭтаФорма);
    КонецЕсли;
КонецПроцедуры

