КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Функция ДанныеЗаправокДляВидаГСМ(Форма, ВидГСМ, ЕдиницаИзмерения)
	Объект = Форма.Объект;
	
	Результат = Истина;
	ПараметрыОтбораЗаправок = Новый Структура;
	ПараметрыОтбораЗаправок.Вставить("ВидГСМ", ВидГСМ);
	НайденныеСтроки = Объект.ЗаправкиГСМ.НайтиСтроки(ПараметрыОтбораЗаправок);
	ИтогКоличество = 0;
	ИтогСумма = 0;
	Для Каждого ТекСтрока Из НайденныеСтроки Цикл
		ИтогКоличество = ИтогКоличество + ТекСтрока.Количество;
		ИтогСумма = ИтогСумма + ТекСтрока.Сумма;
	КонецЦикла;	
	
	ТекстЗаправок = Формат(ИтогКоличество, "ЧЦ=17; ЧДЦ=3; ЧН=0")+" "+Строка(ЕдиницаИзмерения)+", "+Формат(ИтогСумма, "ЧЦ=17; ЧДЦ=2; ЧН=0")+" "+Строка(Форма.ВалютаРубли);
	
	Результат = Новый Структура;
	Результат.Вставить("ТекстЗаправок", ТекстЗаправок);
	Результат.Вставить("ЕстьЗаправки", ?(НайденныеСтроки.Количество()=0, Ложь, Истина));
	
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура ОткрытьФормуДанныхОЗаправках(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.ФактическийРасходГСМ.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ВидГСМ) Тогда
		ИмяСписка = НСтр("ru = 'Движение горючего и расчет фактического расхода ГСМ'");
		Префикс = "Объект.ФактическийРасходГСМ[" + Формат(ВыбранноеЗначение, "ЧН=0; ЧГ=") + "].";
		
		Поле = Префикс + "ВидГСМ";
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Вид ГСМ'"));
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , Поле, ,);
		
		Возврат;
	КонецЕсли;	
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыОтбораЗаправок = Новый Структура;
	ПараметрыОтбораЗаправок.Вставить("ВидГСМ", ДанныеСтроки.ВидГСМ);
	
	АдресДанныхЗаправкиВХранилище = ПоместитьТаблицуЗаправкиГСМВХранилище(ПараметрыОтбораЗаправок);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("МОЛ", Объект.МОЛ);
	ПараметрыФормы.Вставить("ДатаЛистаУчета", Объект.ДатаПутевогоЛиста);
	ПараметрыФормы.Вставить("ВидГСМ", ДанныеСтроки.ВидГСМ);
	ПараметрыФормы.Вставить("ЕдиницаИзмерения", ДанныеСтроки.ЕдиницаИзмерения);
	ПараметрыФормы.Вставить("ВсегоВыданоЗаправлено", ДанныеСтроки.ВыданоГорючее);
	ПараметрыФормы.Вставить("АдресДанныхЗаправкиВХранилище", АдресДанныхЗаправкиВХранилище);
	
	ОткрытьФорму("Обработка.ДанныеОЗаправкахГСМ.Форма", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаСервере
Функция ПоместитьТаблицуЗаправкиГСМВХранилище(ПараметрыОтбораЗаправок)
	
	СтрокиТаблицыЗаправкиГСМ = Объект.ЗаправкиГСМ.Выгрузить(ПараметрыОтбораЗаправок); 
	
	Возврат ПоместитьВоВременноеХранилище(СтрокиТаблицыЗаправкиГСМ);

КонецФункции

&НаСервере
Процедура ОбработкаДобавленияДанныхЗаправкиНаСервере(Знач ВыбранноеЗначение)
	
	УчетГСМ.ОбработатьДобавлениеЗакупокДляВидаГСМ(Объект.ЗаправкиГСМ, ВыбранноеЗначение);
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение.ВидГСМ) Тогда
		ОбщееКоличествоГСМ = ВыбранноеЗначение.ОбщееКоличествоГСМ;
		
		СтруктураПоискаГСМ = Новый Структура("ВидГСМ");
		СтруктураПоискаГСМ.ВидГСМ = ВыбранноеЗначение.ВидГСМ;
		
		СтрокиИсходныхДанных = Объект.ФактическийРасходГСМ.НайтиСтроки(СтруктураПоискаГСМ);
		Для Каждого	ТекСтрока Из СтрокиИсходныхДанных Цикл
			Если ТекСтрока.ВыданоГорючее = 0 Тогда
				ТекСтрока.ВыданоГорючее = ОбщееКоличествоГСМ;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоСводныйРасчет = ?(Объект.ВидТаксировки = ПредопределенноеЗначение("Перечисление.ВидыТаксировкиДокументовУчетаГСМ.СводныйРасчетРасходаГСМПоТаксировкам"), Истина, Ложь);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ГруппаДанныеПутевогоЛиста", "Видимость", НЕ ЭтоСводныйРасчет);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ГруппаСтраницаИсходныеДанныеРасчета", "Видимость", НЕ ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ФактическийРасходГСМОстатокГорючегоПриВыезде", "Видимость", НЕ ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ФактическийРасходГСМОстатокГорючегоПриВозвращении", "Видимость", НЕ ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"РассчитатьНормативныйРасходГСМ", "Видимость", НЕ ЭтоСводныйРасчет);
	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ГруппаТаксировкиПутевыхЛистов", "Видимость", ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"РассчитатьСводныйРасходГСМ", "Видимость", ЭтоСводныйРасчет);
	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ГруппаУправлениеРасчетФактическогоРасходаГСМ", "Видимость", НЕ ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"РассчитатьФактическийРасходаСМ", "Видимость", НЕ ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"РезультатРасходГСМОстатокГорючегоПриВозвращении", "Видимость", НЕ ЭтоСводныйРасчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"МатериалыЗаголовокПодразделение", "Видимость", Форма.УчетПоПодразделениямДляСчетовУчета);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"МатериалыПодразделение", "Видимость", Форма.УчетПоПодразделениямДляСчетовУчета);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"Подразделение", "Видимость", НЕ Форма.УчетПоПодразделениямДляСчетовУчета);
	
	ПутевойЛистЭлектронный = Объект.ПутевойЛистЭлектронный;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
	"ДанныеМаршрутаЗаполнитьМаршрутыСписком", "Видимость", НЕ ПутевойЛистЭлектронный);
	
	ЭтоАктОСписании0510460 = ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
		Объект.ПервичныйДокумент, "АктОСписанииМЗ0510460_157н");
	ОдинАктОСписании = Объект.ОдинАктОСписании;

	// Элементы только акта списания 0510460
	Элементы61н = Новый Массив;
	Элементы61н.Добавить("НадписьГолосование");
	Элементы61н.Добавить("Сотрудник");
	Элементы61н.Добавить("СохранитьРезультатыГолосования");
	Элементы61н.Добавить("НадписьФайл");
	Элементы61н.Добавить("МатериалыПричинаСписанияСсылка");
	Элементы61н.Добавить("МатериалыУстановитьПричинуСписания");
	Элементы61н.Добавить("МатериалыГруппаПроцентГолосовЗа");
	Элементы61н.Добавить("МатериалыПодменюУстановитьРешение");
	Элементы61н.Добавить("МатериалыПодменюУстановитьРешениеЕдиногласно");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, Элементы61н,
		"Видимость", ЭтоАктОСписании0510460 И ОдинАктОСписании);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФайлСотрудника",
		"Видимость", ЭтоАктОСписании0510460 И ОдинАктОСписании И ЗначениеЗаполнено(Форма.ФайлСотрудника));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьУдалитьФайл",
		"Видимость", ЭтоАктОСписании0510460 И ОдинАктОСписании И ЗначениеЗаполнено(Форма.ФайлСотрудника));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьФайлНеВыбран",
		"Видимость", ЭтоАктОСписании0510460 И ОдинАктОСписании И Не ЗначениеЗаполнено(Форма.ФайлСотрудника));
	
	НесколькоАктов = Объект.АналитикаАктовОСписании.Количество() > 0;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаАктыОСписании",
		"Видимость", ЭтоАктОСписании0510460 И НесколькоАктов);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"Комиссия", "Видимость", ЭтоАктОСписании0510460);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаИндикаторКворумаПрисутствия", "Видимость", ЭтоАктОСписании0510460);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СоставКомиссии1", "Видимость", ЭтоАктОСписании0510460);
	
	
	// Элементы акта списания 0504230
	Элементы52н = Новый Массив;
	Элементы52н.Добавить("СоставКомиссии");
	Элементы52н.Добавить("НомерПриказа");
	Элементы52н.Добавить("ДатаПриказа");
	Элементы52н.Добавить("ДекорацияВыбратьКомиссию");
	Элементы52н.Добавить("ДолжностьПредседательКомиссии");
	Элементы52н.Добавить("ФамилияПредседательКомиссии");
	Элементы52н.Добавить("ИмяПредседательКомиссии");
	Элементы52н.Добавить("ОтчествоПредседательКомиссии");
	Элементы52н.Добавить("ВыбратьПредседателяКомиссии");
	Элементы52н.Добавить("ЗаключениеКомиссии");
	Элементы52н.Добавить("МатериалыПричинаСписания");
	Элементы52н.Добавить("МатериалыУстановитьНаправлениеРасхода");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, Элементы52н,
		"Видимость", Не ЭтоАктОСписании0510460);

КонецПроцедуры	

&Насервере
Процедура ЗаполнитьСписокДокументовТаксировкиНаСервере()
	Если Объект.ТаксировкиПутевыхЛистов.Количество()>0 Тогда
	 	Объект.ТаксировкиПутевыхЛистов.Очистить();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ОперацииДокументов.Операция ЕСТЬ NULL
	               |				И ЖурналПроводокЕПСБУ.Регистратор ЕСТЬ NULL
	               |			ТОГДА 0
	               |		КОГДА НЕ ОперацииДокументов.Операция ЕСТЬ NULL
	               |				И ЖурналПроводокЕПСБУ.Регистратор ЕСТЬ NULL
	               |			ТОГДА 1
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК ЕстьОперация,
	               |	ТаксировкаПутевогоЛиста.Ссылка КАК Ссылка,
	               |	ТаксировкаПутевогоЛиста.Проведен КАК Проведен
	               |ИЗ
	               |	Документ.ТаксировкаПутевогоЛиста КАК ТаксировкаПутевогоЛиста
	               |		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	               |		ПО ТаксировкаПутевогоЛиста.Ссылка = ОперацииДокументов.Документ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	               |		ПО ТаксировкаПутевогоЛиста.Ссылка = ЖурналПроводокЕПСБУ.Регистратор
	               |			И (ЖурналПроводокЕПСБУ.НомерСтроки = 1)}
	               |ГДЕ
	               |	ТаксировкаПутевогоЛиста.Дата МЕЖДУ &ДатаНачалаПериода И &ДатаКонцаПериода
	               |	И НЕ ТаксировкаПутевогоЛиста.ВидТаксировки В (&ВидТаксировки)
	               |	И ТаксировкаПутевогоЛиста.ПометкаУдаления = ЛОЖЬ
	               |	И &ОтборПоТранспортномуСредству = ЛОЖЬ
	               |	И &ОтборПоВодителю = ЛОЖЬ
	               |	И &ОтборПоПодразделению = ЛОЖЬ
	               |	И ТаксировкаПутевогоЛиста.Организация = &Организация";
				   
	Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда 			   
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоТранспортномуСредству = ЛОЖЬ", "ТаксировкаПутевогоЛиста.ТранспортноеСредство = &ТранспортноеСредство");
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Объект.МОЛ) Тогда 			   
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоВодителю = ЛОЖЬ", "ТаксировкаПутевогоЛиста.МОЛ = &МОЛ");
	КонецЕсли;	

	Если ЗначениеЗаполнено(Объект.Подразделение) Тогда 			   
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоПодразделению = ЛОЖЬ", "ТаксировкаПутевогоЛиста.Подразделение = &Подразделение");
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаНачалаПериода", НачалоДня(Объект.ДатаНачалаПериода));			   
	Запрос.УстановитьПараметр("ДатаКонцаПериода", КонецДня(Объект.ДатаКонцаПериода));			   
	Запрос.УстановитьПараметр("ВидТаксировки", Перечисления.ВидыТаксировкиДокументовУчетаГСМ.СводныйРасчетРасходаГСМПоТаксировкам);			   
	Запрос.УстановитьПараметр("ОтборПоТранспортномуСредству", ЛОЖЬ);			   
	Запрос.УстановитьПараметр("ОтборПоВодителю", ЛОЖЬ);			   
	Запрос.УстановитьПараметр("ОтборПоПодразделению", ЛОЖЬ);			   
	Запрос.УстановитьПараметр("ТранспортноеСредство", Объект.ТранспортноеСредство);			   
	Запрос.УстановитьПараметр("МОЛ", Объект.МОЛ);	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);	
	Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);	
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Проведен Тогда
			НоваяСтрока = Объект.ТаксировкиПутевыхЛистов.Добавить();
			НоваяСтрока.ТаксировкаПутевогоЛиста = Выборка.Ссылка;
			Если Выборка.ЕстьОперация = 2 Тогда
				ТекстОшибки = НСтр("ru='У документа ""%1"" уже есть операция списания ГСМ!'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.Ссылка);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ,"ТаксировкиПутевыхЛистов");
			КонецЕсли;
		Иначе
			ТекстОшибки = НСтр("ru='Документ ""%1"" не проведен и не включен в список таксировок для расчета общего расхода ГСМ!'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.Ссылка);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ,"ТаксировкиПутевыхЛистов");
		КонецЕсли;
	КонецЦикла;	
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыТаксировки();
	
КонецПроцедуры

&Насервере
Процедура РассчитатьСводныйРасходГСМНаСервере()
	
	МассивТаксировок = Новый Массив;
	
	Для Каждого ТекСтрока Из Объект.ТаксировкиПутевыхЛистов Цикл
		МассивТаксировок.Добавить(ТекСтрока.ТаксировкаПутевогоЛиста);
	КонецЦикла;	
	
	ОбъединенныеДанные = ТаблицаЗначенийОбъединенияРасходаГСМ(МассивТаксировок);
	
	Объект.ФактическийРасходГСМ.Очистить();
	Для Каждого ТекСтрока Из ОбъединенныеДанные Цикл
		НоваяСтрока = Объект.ФактическийРасходГСМ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.ЕдиницаИзмерения = ТекСтрока.ВидГСМ.ЕдиницаИзмерения;
		Если ТекСтрока.НормативныйРасходГорючего > ТекСтрока.ФактическийРасходГорючего Тогда
			НоваяСтрока.Экономия = ТекСтрока.НормативныйРасходГорючего - ТекСтрока.ФактическийРасходГорючего;
			НоваяСтрока.Перерасход = 0;
		Иначе
			НоваяСтрока.Перерасход = ТекСтрока.ФактическийРасходГорючего - ТекСтрока.НормативныйРасходГорючего;
			НоваяСтрока.Экономия = 0;
		КонецЕсли;	
	КонецЦикла;	
	
	ОбъединенныеЗаправки = ТаблицаЗначенийОбъединенияЗаправокГСМ(МассивТаксировок);
	
	Объект.ЗаправкиГСМ.Очистить();
	Для Каждого ТекСтрока Из ОбъединенныеЗаправки Цикл
		НоваяСтрока = Объект.ЗаправкиГСМ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;	
	
КонецПроцедуры

&Насервере
Функция ТаблицаЗначенийОбъединенияРасходаГСМ(МассивТаксировок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаксировкаПутевогоЛистаФактическийРасходГСМ.ВидГСМ,
	               |	ТаксировкаПутевогоЛистаФактическийРасходГСМ.ЕдиницаИзмерения,
	               |	ТаксировкаПутевогоЛистаФактическийРасходГСМ.ОстатокГорючегоПриВыезде,
	               |	ТаксировкаПутевогоЛистаФактическийРасходГСМ.ВыданоГорючее,
	               |	ТаксировкаПутевогоЛистаФактическийРасходГСМ.ОстатокГорючегоПриВозвращении,
	               |	ТаксировкаПутевогоЛистаФактическийРасходГСМ.ФактическийРасходГорючего,
	               |	ТаксировкаПутевогоЛистаФактическийРасходГСМ.НормативныйРасходГорючего,
	               |	ТаксировкаПутевогоЛистаФактическийРасходГСМ.Экономия,
	               |	ТаксировкаПутевогоЛистаФактическийРасходГСМ.Перерасход
	               |ИЗ
	               |	Документ.ТаксировкаПутевогоЛиста.ФактическийРасходГСМ КАК ТаксировкаПутевогоЛистаФактическийРасходГСМ
	               |ГДЕ
	               |	ТаксировкаПутевогоЛистаФактическийРасходГСМ.Ссылка В(&МассивТаксировок)";
				   
	Запрос.УстановитьПараметр("МассивТаксировок", МассивТаксировок);
	ТаблицаРасходаГСМ = Запрос.Выполнить().Выгрузить();
	ТаблицаРасходаГСМ.Свернуть("ВидГСМ", "ОстатокГорючегоПриВыезде, ВыданоГорючее, ВыданоГорючее, 
								|ОстатокГорючегоПриВозвращении, ФактическийРасходГорючего, НормативныйРасходГорючего, Экономия, Перерасход");
	
	Возврат ТаблицаРасходаГСМ;
КонецФункции

&Насервере
Функция ТаблицаЗначенийОбъединенияЗаправокГСМ(МассивТаксировок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.ДатаЗаправки,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.НомерДокументаОснования,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.ВидГСМ,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.ЕдиницаИзмерения,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.Количество,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.Сумма,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.ТопливнаяКарта,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.СерияТопливнойКарты,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.НомерТопливнойКарты,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.ТалонНаТопливо,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.КоличествоТалонов,
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.Контрагент
	               |ИЗ
	               |	Документ.ТаксировкаПутевогоЛиста.ЗаправкиГСМ КАК ТаксировкаПутевогоЛистаЗаправкиГСМ
	               |ГДЕ
	               |	ТаксировкаПутевогоЛистаЗаправкиГСМ.Ссылка В(&МассивТаксировок)
	               |	И НЕ ТаксировкаПутевогоЛистаЗаправкиГСМ.ВидГСМ В (&НеЗаполненВидГСМ)";
				   
	Запрос.УстановитьПараметр("МассивТаксировок", МассивТаксировок);
	Запрос.УстановитьПараметр("НеЗаполненВидГСМ", Справочники.ВидыГСМ.ПустаяСсылка());
	ТаблицаЗаправокГСМ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаЗаправокГСМ;
КонецФункции

&Насервере
Функция ПровестиУточняющийРасчетФактическогоРасходаСМ()
	
	ДатаРасчета = Объект.ДатаПутевогоЛиста;
	
	//Расчет общего количества расхода по нормам для СМ
	ТаблицаНормативныйРасход = Объект.ФактическийРасходГСМ.Выгрузить(,"ВидГСМ, НормативныйРасходГорючего, ФактическийРасходГорючего");
	ТаблицаНормативныйРасход.Свернуть("ВидГСМ","НормативныйРасходГорючего, ФактическийРасходГорючего");
	
	ТаблицаГорючее = Новый ТаблицаЗначений;
	ТаблицаГорючее.Колонки.Добавить("ВидГСМ", Новый ОписаниеТипов("СправочникСсылка.ВидыГСМ"));
	ТаблицаГорючее.Колонки.Добавить("НормативныйРасходГорючего",  Новый ОписаниеТипов("Число"));
	ТаблицаГорючее.Колонки.Добавить("ФактическийРасходГорючего",  Новый ОписаниеТипов("Число"));
	
	ТаблицаСМ = Новый ТаблицаЗначений;
	ТаблицаСМ.Колонки.Добавить("ВидГСМ", Новый ОписаниеТипов("СправочникСсылка.ВидыГСМ"));
	ТаблицаСМ.Колонки.Добавить("ФактическийРасходГорючего",  Новый ОписаниеТипов("Число"));
	
	Для Каждого ТекСтрока Из ТаблицаНормативныйРасход Цикл
		Если (ТекСтрока.ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.Горючее) Тогда
			НоваяСтрока = ТаблицаГорючее.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока); 
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого ТекСтрока Из Объект.ДанныеМаршрута Цикл
		Если (ТекСтрока.ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.Горючее) Тогда
			СтруктураПоискаГСМ = Новый Структура("ВидГСМ");
			СтруктураПоискаГСМ.ВидГСМ = ТекСтрока.ВидГСМ;
			
			СтрокиИсходныхДанных = ТаблицаГорючее.НайтиСтроки(СтруктураПоискаГСМ);
			Для Каждого	ТекГСМ Из СтрокиИсходныхДанных Цикл
				НастройкиОкругленияГСМ = УчетГСМ.ПолучитьПараметрыОкругленияРасчетаНормГСМ(Объект.Организация, ТекСтрока.ВидГСМ, ДатаРасчета);
				Если ТекГСМ.НормативныйРасходГорючего = 0 Тогда
					ЗначениеФактическогоРасходаТоплива = 0;
				Иначе	
					ЗначениеФактическогоРасходаТоплива = Окр(ТекГСМ.ФактическийРасходГорючего * (ТекСтрока.НормативРасходаГСМ/ТекГСМ.НормативныйРасходГорючего),
															НастройкиОкругленияГСМ.КоличествоЗнаковДробнойЧасти, НастройкиОкругленияГСМ.РежимОкругления);
				КонецЕсли;											
				//расчет для каждого СМ из НормативныйРасходСМ
				СтруктураПоискаНормСМ = Новый Структура("ВидГСМ, КлючСтроки");
				СтруктураПоискаНормСМ.ВидГСМ = ТекСтрока.ВидГСМ;
				СтруктураПоискаНормСМ.КлючСтроки = ТекСтрока.КлючСтроки;
				
				СтрокиИсходныхДанныхНормСМ = Объект.НормативныйРасходСМ.НайтиСтроки(СтруктураПоискаНормСМ);
				Для Каждого	ТекСМ Из СтрокиИсходныхДанныхНормСМ Цикл
					ФормулаДляРасчетаФактаСМ = ТекСМ.РасшифровкаРасчетаСМФакт;
					
					ТекстФормулы = СтрЗаменить(ФормулаДляРасчетаФактаСМ,"ЗначениеРасходаГСМ",ЗначениеФактическогоРасходаТоплива);
						
					НастройкиОкругленияСМ = УчетГСМ.ПолучитьПараметрыОкругленияРасчетаНормГСМ(Объект.Организация, ТекСМ.ВидСМ, ДатаРасчета);
					
					ФактическийРасходСМ = Окр(Число(ОбщегоНазначения.ВычислитьВБезопасномРежиме(СтрЗаменить(ТекстФормулы,",","."))),НастройкиОкругленияСМ.КоличествоЗнаковДробнойЧасти, НастройкиОкругленияСМ.РежимОкругления);
					
					НоваяСтрока = ТаблицаСМ.Добавить();
					НоваяСтрока.ВидГСМ = ТекСМ.ВидСМ;
					НоваяСтрока.ФактическийРасходГорючего = ФактическийРасходСМ;
				КонецЦикла;
				
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;		
	
	ТаблицаСМ.Свернуть("ВидГСМ", "ФактическийРасходГорючего");
	
	//Уточняющий расчет фактического расхода СМ
	Для Каждого ТекСтрока Из Объект.ФактическийРасходГСМ Цикл
		Если (ТекСтрока.ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.СмазочныеМатериалы) ИЛИ  
			(ТекСтрока.ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.СпециальныеЖидкости) Тогда
			СтруктураПоискаНормСМ = Новый Структура("ВидГСМ");
			СтруктураПоискаНормСМ.ВидГСМ = ТекСтрока.ВидГСМ;
			
			СтрокиИсходныхДанныхНормСМ = ТаблицаСМ.НайтиСтроки(СтруктураПоискаНормСМ);
			Для Каждого	ТекСМ Из СтрокиИсходныхДанныхНормСМ Цикл
				ТекСтрока.ФактическийРасходГорючего = ТекСМ.ФактическийРасходГорючего;
				Если ТекСтрока.ФактическийРасходГорючего = 0 Тогда
					ТекСтрока.ФактическийРасходГорючего = ТекСтрока.НормативныйРасходГорючего;
				КонецЕсли;	
				РезультатРасчета = ТекСтрока.ФактическийРасходГорючего - ТекСтрока.НормативныйРасходГорючего;
				Если РезультатРасчета > 0 Тогда
					ТекСтрока.Перерасход = РезультатРасчета;
					ТекСтрока.Экономия = 0;
				Иначе
					ТекСтрока.Перерасход = 0;
					ТекСтрока.Экономия = (-1)*РезультатРасчета;
				КонецЕсли;	
				Если (ТекСтрока.ОстатокГорючегоПриВыезде + ТекСтрока.ВыданоГорючее)>0 Тогда
					ТекСтрока.ОстатокГорючегоПриВозвращении = ТекСтрока.ОстатокГорючегоПриВыезде + ТекСтрока.ВыданоГорючее - ТекСтрока.ФактическийРасходГорючего;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого ТекСтрока Из Объект.ФактическийРасходГСМ Цикл
		Если (ТекСтрока.ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.СмазочныеМатериалы) ИЛИ  
			(ТекСтрока.ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.СпециальныеЖидкости) Тогда
			Если (ТекСтрока.ФактическийРасходГорючего = 0) И (ТекСтрока.НормативныйРасходГорючего > 0) Тогда
				ТекСтрока.ФактическийРасходГорючего = ТекСтрока.НормативныйРасходГорючего;
				ТекСтрока.Экономия = 0;
				ТекСтрока.Перерасход = 0;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
КонецФункции

&НаКлиенте
Процедура УстановитьПериод_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Объект["ДатаНачалаПериода"]	= РезультатВыбора["НачалоПериода"];
		Объект["ДатаКонцаПериода"]	= РезультатВыбора["КонецПериода"];
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьСтрокиТаблицНормПриАктивизацииМаршрута()
	Элемент = Элементы.ДанныеМаршрута;
	
	ОтборДляНормПараметровРасчета(Элемент.ТекущиеДанные.КлючСтроки);
	ОтборДляЗначенийПараметровРасчета(Элемент.ТекущиеДанные.КлючСтроки);
	ОтборДляКоэффициентовПараметровРасчета(Элемент.ТекущиеДанные.КлючСтроки);
КонецПроцедуры	

