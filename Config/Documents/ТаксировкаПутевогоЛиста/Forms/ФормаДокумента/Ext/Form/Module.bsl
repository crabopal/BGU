&НаСервере
Процедура УстановитьРеквизитыИзПутевогоЛиста() 
	Если ЗначениеЗаполнено(Объект.ПутевойЛист) Тогда
		Если ТипЗнч(Объект.ПутевойЛист) = Тип("ДокументСсылка.ЭлектронныйПутевойЛист") Тогда
			ДанныеПутевогоЛиста = ПолучитьДанныеЭлектронногоПутевогоЛиста(Объект.ПутевойЛист, Объект.Ссылка);
		Иначе	
			ДанныеПутевогоЛиста = ПолучитьДанныеПутевогоЛиста(Объект.ПутевойЛист);
		КонецЕсли;
		
		Объект.ТранспортноеСредство = ДанныеПутевогоЛиста.ТранспортноеСредство;
		Объект.МОЛ = ДанныеПутевогоЛиста.Водитель;
		Объект.НомерПутевогоЛиста = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Объект.ПутевойЛист.Ссылка,ДанныеПутевогоЛиста.Номер);
		Объект.СерияПутевогоЛиста = ДанныеПутевогоЛиста.СерияПутевогоЛиста;
		Объект.СрокДействия = ДанныеПутевогоЛиста.СрокДействия;
		Объект.ДатаПутевогоЛиста = ДанныеПутевогоЛиста.Дата;
		Объект.НомерСмены = ДанныеПутевогоЛиста.НомерСмены;
		Объект.РегистрационныйНомернойЗнак = ДанныеПутевогоЛиста.РегистрационныйНомернойЗнак;
		Объект.ГаражныйНомер = ДанныеПутевогоЛиста.ГаражныйНомер;
		
		Элементы.ДекорацияДанныеТС.Заголовок = ПолучитьГосНомерГаражныйНомерТС();
		
		ПоказатьЗначениеОдометраПриВозвращенииИзПредыдущегоРейса();
	Иначе	
		Объект.ТранспортноеСредство = Справочники.ОсновныеСредства.ПустаяСсылка();
		Объект.МОЛ = Справочники.Сотрудники.ПустаяСсылка();
		Объект.НомерПутевогоЛиста = "";
		Объект.СерияПутевогоЛиста = "";
		Объект.ДатаПутевогоЛиста = Дата(1,1,1);
		Объект.СрокДействия = Дата(1,1,1);
		Объект.НомерСмены = 1;
		Объект.РегистрационныйНомернойЗнак = "";
		Объект.ГаражныйНомер = "";
		
		Элементы.ДекорацияДанныеТС.Заголовок = "";
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьСтрокуДляРасчета(ФормулаРасчета)
	Возврат СтрЗаменить(Строка(ФормулаРасчета),Символы.НПП,"");
КонецФункции	

&НаСервере
Процедура РассчитатьНормативПоКлючу(НомерМаршрута, Ключ, Пробег, ВидГСМ, РаботаБезПробега)

	ТекстФормулыРасчетаГСМДляАвтомобиля = "(0.01*(Hs*S+Hw*W)+Hт*T)*(1+0.01*D)+Hz*m+Hот*T+Hplus";
	
	ТекстФормулы = ТекстФормулыРасчетаГСМДляАвтомобиля;
	
	S = Пробег;
	
	//Контроль заполнения основного показателя расчета
	Если (S = 0) И НЕ РаботаБезПробега Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для строки маршрута транспортного средства номер %1 не указано значение пробега.'"),НомерМаршрута);
		Сообщение.Сообщить();
	КонецЕсли;
	
	Hот = 0;
	T = 0;
	
	D = 0;
	РасшифровкаD = "";
	Для Каждого ТекСтрока Из Объект.ПоправочныеКоэффициенты Цикл
		Если (ТекСтрока.КлючСтроки = Ключ) И (ПоправкаАктуальнаДляВидаГСМ(ВидГСМ, ТекСтрока.ПоправочныйКоэффициент.ВидГСМ)) Тогда     
			D = D + ТекСтрока.Значение;	
			РасшифровкаD = РасшифровкаD + ?(РасшифровкаD="",""," + ") + ПолучитьСтрокуДляРасчета(ТекСтрока.Значение);
			//контроль заполнения значений
			Если ТекСтрока.Значение = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для маршрута номер %1 у поправочного коэффициента ""%2"" не указано значение в строке %3.'"),НомерМаршрута,ТекСтрока.НаименованиеКоэффициента,ТекСтрока.НомерСтроки);
				Сообщение.Сообщить();
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	Если Найти(РасшифровкаD,"+")>0 Тогда
		РасшифровкаD = "(" + РасшифровкаD + ")";
	ИначеЕсли РасшифровкаD = "" Тогда 
		РасшифровкаD = "0";
	КонецЕсли;
	
	//транспортная норма
	Hs = 0;
	РасшифровкаHs = "";
	Для Каждого ТекСтрока Из Объект.НормыРасхода Цикл
		Если ТекСтрока.КлючСтроки = Ключ Тогда
			//контроль заполнения значений
			Если ТекСтрока.Значение = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для маршрута номер %1 у нормы расхода ""%2"" не указано значение в строке %3.'"),НомерМаршрута,ТекСтрока.НаименованиеНормы,ТекСтрока.НомерСтроки);
				Сообщение.Сообщить();
			КонецЕсли;	
			
			//контроль заполнения значений
			Если ЗначениеЗаполнено(ТекСтрока.Параметр) Тогда
				Если ТекСтрока.ЗначениеПараметра = 0 Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для маршрута номер %1 у нормы расхода ""%2"" не указано значение параметра в строке %3.'"),НомерМаршрута,ТекСтрока.НаименованиеНормы,ТекСтрока.НомерСтроки);
					Сообщение.Сообщить();
				КонецЕсли;	
			КонецЕсли;
			
			Если ТекСтрока.Норма.ВидНормы = Перечисления.ВидыНормРасходаГСМ.БазоваяНормаРасхода Тогда
				Hs = Hs + ТекСтрока.Значение;	
				РасшифровкаHs = РасшифровкаHs + ?(РасшифровкаHs="",""," + ") + ПолучитьСтрокуДляРасчета(ТекСтрока.Значение);
			ИначеЕсли ТекСтрока.Норма.ВидНормы = Перечисления.ВидыНормРасходаГСМ.ТранспортнаяНормаНаПробег Тогда
				Hs = Hs + ТекСтрока.Значение;	
				РасшифровкаHs = РасшифровкаHs + ?(РасшифровкаHs="",""," + ") + ПолучитьСтрокуДляРасчета(ТекСтрока.Значение);
			ИначеЕсли (ТекСтрока.Норма.ВидНормы = Перечисления.ВидыНормРасходаГСМ.НормаНаДополнительнуюМассуПрицепа)И(ТекСтрока.Параметр = Перечисления.ВидыПараметровДляНормРасходаГСМ.МассаСнаряженногоПрицепа) Тогда
				Hs = Hs + ТекСтрока.Значение * ТекСтрока.ЗначениеПараметра;	
				РасшифровкаHs = РасшифровкаHs + ?(РасшифровкаHs="",""," + ") + ПолучитьСтрокуДляРасчета(ТекСтрока.Значение)+" * "+ПолучитьСтрокуДляРасчета(ТекСтрока.ЗначениеПараметра);
			Конецесли;	
		КонецЕсли;
		
	КонецЦикла;
	
	Если (Найти(РасшифровкаHs,"+")>0)ИЛИ(Найти(РасшифровкаHs,"*")>0) Тогда
		РасшифровкаHs = "(" + РасшифровкаHs + ")";
	ИначеЕсли РасшифровкаHs = "" Тогда 
		РасшифровкаHs = "0";
	КонецЕсли;
	
	//норма всех отопителей
	HотxT = 0;
	РасшифровкаHотxT = "";
	Для Каждого ТекСтрока Из Объект.НормыРасхода Цикл
		Если ТекСтрока.КлючСтроки = Ключ Тогда
			Если ТекСтрока.Норма.ВидНормы = Перечисления.ВидыНормРасходаГСМ.НормаДляОтопителя Тогда
				Если ТекСтрока.Параметр = Перечисления.ВидыПараметровДляНормРасходаГСМ.ВремяРаботыОтопителя
					ИЛИ ТекСтрока.Параметр = Перечисления.ВидыПараметровДляНормРасходаГСМ.ВремяПростоя
					ИЛИ ТекСтрока.Параметр = Перечисления.ВидыПараметровДляНормРасходаГСМ.ВремяПрогрева	Тогда
					HотxT = HотxT + ТекСтрока.Значение*ТекСтрока.ЗначениеПараметра;	
					РасшифровкаHотxT = РасшифровкаHотxT + ?(РасшифровкаHотxT="",""," + ") + ПолучитьСтрокуДляРасчета(ТекСтрока.Значение)+" * "+ПолучитьСтрокуДляРасчета(ТекСтрока.ЗначениеПараметра);
				КонецЕсли;
			Конецесли;	
		КонецЕсли;
	КонецЦикла;
	
	Если (Найти(РасшифровкаHотxT,"+")>0)ИЛИ(Найти(РасшифровкаHотxT,"*")>0) Тогда
		РасшифровкаHотxT = "(" + РасшифровкаHотxT + ")";
	ИначеЕсли РасшифровкаHотxT = "" Тогда 
		РасшифровкаHотxT = "0";
	КонецЕсли;
	
	//норма работы спец.оборудования
	HтxT = 0;
	РасшифровкаHтxT = "";
	Для Каждого ТекСтрока Из Объект.НормыРасхода Цикл
		Если ТекСтрока.КлючСтроки = Ключ Тогда
			Если ТекСтрока.Норма.ВидНормы = Перечисления.ВидыНормРасходаГСМ.НормаРасходаНаРаботуСпецоборудования Тогда
				Если ТекСтрока.Параметр = Перечисления.ВидыПараметровДляНормРасходаГСМ.ВремяРаботыСпецоборудования
					ИЛИ ТекСтрока.Параметр = Перечисления.ВидыПараметровДляНормРасходаГСМ.КоличествоОпераций Тогда
					HтxT = HтxT + ТекСтрока.Значение*ТекСтрока.ЗначениеПараметра;	
					РасшифровкаHтxT = РасшифровкаHтxT + ?(РасшифровкаHтxT="",""," + ") + ПолучитьСтрокуДляРасчета(ТекСтрока.Значение)+" * "+ПолучитьСтрокуДляРасчета(ТекСтрока.ЗначениеПараметра);
				КонецЕсли;
			Конецесли;	
		КонецЕсли;	
	КонецЦикла;
	
	Если (Найти(РасшифровкаHтxT,"+")>0)ИЛИ(Найти(РасшифровкаHтxT,"*")>0) Тогда
		РасшифровкаHтxT = "(" + РасшифровкаHтxT + ")";
	ИначеЕсли РасшифровкаHтxT = "" Тогда 
		РасшифровкаHтxT = "0";
	КонецЕсли;
	
	//норма на транспортную работу
	HwxW = 0;
	РасшифровкаHwxW = "";
	Для Каждого ТекСтрока Из Объект.НормыРасхода Цикл
		Если ТекСтрока.КлючСтроки = Ключ Тогда
			Если (ТекСтрока.Норма.ВидНормы = Перечисления.ВидыНормРасходаГСМ.ТранспортнаяНормаНаПеревозкуГруза) Тогда
				Если ТекСтрока.Параметр = Перечисления.ВидыПараметровДляНормРасходаГСМ.ОбъемТранспортнойРаботы Тогда
					HwxW = HwxW + ТекСтрока.Значение*ТекСтрока.ЗначениеПараметра;	
					РасшифровкаHwxW = РасшифровкаHwxW + ?(РасшифровкаHwxW="",""," + ") + ПолучитьСтрокуДляРасчета(ТекСтрока.Значение)+" * "+ПолучитьСтрокуДляРасчета(ТекСтрока.ЗначениеПараметра);
				Конецесли;
			Конецесли;	
		КонецЕсли;	
	КонецЦикла;
	
	Если (Найти(РасшифровкаHwxW,"+")>0)ИЛИ(Найти(РасшифровкаHwxW,"*")>0) Тогда
		РасшифровкаHwxW = "(" + РасшифровкаHwxW + ")";
	ИначеЕсли РасшифровкаHwxW = "" Тогда 
		РасшифровкаHwxW = "0";
	КонецЕсли;
	
	//ездки самосвала
	Hzxm = 0;
	РасшифровкаHzxm = "";
	Для Каждого ТекСтрока Из Объект.НормыРасхода Цикл
		Если ТекСтрока.КлючСтроки = Ключ Тогда
			Если (ТекСтрока.Норма.ВидНормы = Перечисления.ВидыНормРасходаГСМ.ТранспортнаяНормаСамосвалаНаЕздку) Тогда
				Если ТекСтрока.Параметр = Перечисления.ВидыПараметровДляНормРасходаГСМ.КоличествоЕздок Тогда
					Hzxm = Hzxm + ТекСтрока.Значение*ТекСтрока.ЗначениеПараметра;	
					РасшифровкаHzxm = РасшифровкаHzxm + ?(РасшифровкаHzxm="",""," + ") + ПолучитьСтрокуДляРасчета(ТекСтрока.Значение)+" * "+ПолучитьСтрокуДляРасчета(ТекСтрока.ЗначениеПараметра);
				КонецЕсли;
			КонецЕсли;
		Конецесли;	
	КонецЦикла;
	
	Если (Найти(РасшифровкаHzxm,"+")>0)ИЛИ(Найти(РасшифровкаHzxm,"*")>0) Тогда
		РасшифровкаHzxm = "(" + РасшифровкаHzxm + ")";
	ИначеЕсли РасшифровкаHzxm = "" Тогда 
		РасшифровкаHzxm = "0";
	КонецЕсли;
	
	//Поправочные значения расхода литров на каждые 100 км пробега
	Hplus = 0;
	РасшифровкаHplus = "";
	Для Каждого ТекСтрока Из Объект.ПоправочныеЗначения Цикл
		Если (ТекСтрока.КлючСтроки = Ключ) И (ПоправкаАктуальнаДляВидаГСМ(ВидГСМ, ТекСтрока.ПоправочноеЗначение.ВидГСМ)) Тогда
			Если ТекСтрока.ЗначениеОсновногоПараметраРасчета = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для маршрута номер %1 у поправочного значения ""%2"" не указано значение основного параметра расчета в строке %3. Поправочное значение не учтено в расчете.'"),НомерМаршрута,ТекСтрока.НаименованиеЗначения,ТекСтрока.НомерСтроки);
				Сообщение.Сообщить();
			Иначе	
				Hplus = Hplus + (S/ТекСтрока.ЗначениеОсновногоПараметраРасчета)*ТекСтрока.Значение;
				РасшифровкаHplus = РасшифровкаHplus + ?(РасшифровкаHplus="",""," + ") + "("+ПолучитьСтрокуДляРасчета(S)+" / "+ПолучитьСтрокуДляРасчета(ТекСтрока.ЗначениеОсновногоПараметраРасчета)+") * "+ПолучитьСтрокуДляРасчета(ТекСтрока.Значение);
			КонецЕсли;
			
			//контроль заполнения значений
			Если ТекСтрока.Значение = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для маршрута номер %1 у поправочного значения ""%2"" не указано значение в строке %3.'"),НомерМаршрута,ТекСтрока.НаименованиеЗначения,ТекСтрока.НомерСтроки);
				Сообщение.Сообщить();
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	Если (Найти(РасшифровкаHplus,"+")>0)ИЛИ(Найти(РасшифровкаHplus,"*")>0) Тогда
		РасшифровкаHplus = "(" + РасшифровкаHplus + ")";
	ИначеЕсли РасшифровкаHplus = "" Тогда 
		РасшифровкаHplus = "0";
	КонецЕсли;
	
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"S",ПолучитьСтрокуДляРасчета(S));
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"D",ПолучитьСтрокуДляРасчета(D));
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Hs",ПолучитьСтрокуДляРасчета(Hs));
	
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Hот*T",ПолучитьСтрокуДляРасчета(HотxT));
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Hw*W",ПолучитьСтрокуДляРасчета(HwxW));
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Hz*m",ПолучитьСтрокуДляРасчета(Hzxm));
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Hот*T",ПолучитьСтрокуДляРасчета(HотxT));
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Hт*T",ПолучитьСтрокуДляРасчета(HтxT));
	
	ТекстФормулы = СтрЗаменить(ТекстФормулы,"Hplus",ПолучитьСтрокуДляРасчета(Hplus));
	
	НастройкиОкругленияГСМ = УчетГСМ.ПолучитьПараметрыОкругленияРасчетаНормГСМ(Объект.Организация, ВидГСМ, Объект.ДатаПутевогоЛиста);
	
	НормативныйРасходГСМ = Окр(Число(ОбщегоНазначения.ВычислитьВБезопасномРежиме(СтрЗаменить(ТекстФормулы,",","."))),НастройкиОкругленияГСМ.КоличествоЗнаковДробнойЧасти, НастройкиОкругленияГСМ.РежимОкругления);
	
	//детальная расшифровка
	ТекстРасшифровкиФормулы = ТекстФормулыРасчетаГСМДляАвтомобиля;
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"S",СокрЛП(S));
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"D",РасшифровкаD);
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Hs",РасшифровкаHs);
	
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Hот*T",РасшифровкаHотxT);
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Hw*W",РасшифровкаHwxW);
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Hz*m",РасшифровкаHzxm);
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Hот*T",РасшифровкаHотxT);
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Hт*T",РасшифровкаHтxT);
	
	ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Hplus",РасшифровкаHplus);
	
	
	ПараметрыОтбора = Новый Структура("КлючСтроки", Ключ); 	
	МассивОтбора = Объект.ДанныеМаршрута.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаОтбора Из МассивОтбора Цикл
		СтрокаОтбора.РасшифровкаРасчетаНормативногоРасходаГСМ = ТекстРасшифровкиФормулы;
		СтрокаОтбора.НормативРасходаГСМ = НормативныйРасходГСМ;
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Функция ПоправкаАктуальнаДляВидаГСМ(ТекущийВидГСМ, ВидГСМПоправки)
	Результат = Ложь;
	Если ТекущийВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.Горючее Тогда
		Если НЕ ЗначениеЗаполнено(ВидГСМПоправки) Тогда
			Результат = Истина;
		Иначе
			Если ТекущийВидГСМ = ВидГСМПоправки Тогда
				Результат = Истина;
			Иначе
				Результат = Ложь;
			КонецЕсли;	
		КонецЕсли;	
	Иначе
		Если ТекущийВидГСМ = ВидГСМПоправки Тогда
			Результат = Истина;
		Иначе
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура РассчитатьНормативСмазочныхМатериаловПоКлючу(НомерМаршрута,Ключ,Пробег,ВидГСМ)
	ТекстФормулыРасчетаСМДляАвтомобиля = "(0.01*ЗначениеРасходаГСМ*ЗначениеНормы)*(1+0.01*D)+Hplus";
	
	ЗначениеНормативногоРасходаТоплива = ПолучитьСтрокуДляРасчета(Объект.ДанныеМаршрута[НомерМаршрута-1].НормативРасходаГСМ);
	
	Для Каждого ТекСтрока Из Объект.НормыРасхода Цикл
		Если (ТекСтрока.КлючСтроки = Ключ) И (ЗначениеЗаполнено(ТекСтрока.Норма)) Тогда
			//контроль заполнения значений
			Если ТекСтрока.Значение = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для маршрута номер %1 у нормы расхода ""%2"" не указано значение в строке %3.'"),НомерМаршрута,ТекСтрока.НаименованиеНормы,ТекСтрока.НомерСтроки);
				Сообщение.Сообщить();
			КонецЕсли;	
			Если (ТекСтрока.Норма.ВидНормы = Перечисления.ВидыНормРасходаГСМ.НормаРасходаСмазочныхМатериалов) Тогда
				ТекстФормулы = ТекстФормулыРасчетаСМДляАвтомобиля;
				ТекстФормулыФакт = ТекстФормулыРасчетаСМДляАвтомобиля;

				ВидСМ = ТекСтрока.Норма.ВидСМ;
				
				//поправочные коэффициенты на каждые 100 единиц топлива
				D = 0;
				РасшифровкаD = "";
				Для Каждого ТекСтрокаПК Из Объект.ПоправочныеКоэффициенты Цикл
					Если (ТекСтрокаПК.КлючСтроки = Ключ) И (ПоправкаАктуальнаДляВидаГСМ(ВидСМ, ТекСтрокаПК.ПоправочныйКоэффициент.ВидГСМ)) Тогда     
						D = D + ТекСтрокаПК.Значение;	
						РасшифровкаD = РасшифровкаD + ?(РасшифровкаD="",""," + ") + ПолучитьСтрокуДляРасчета(ТекСтрокаПК.Значение);
						//контроль заполнения значений
						Если ТекСтрокаПК.Значение = 0 Тогда
							Сообщение = Новый СообщениеПользователю;
							Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для маршрута номер %1 у поправочного коэффициента ""%2"" не указано значение в строке %3.'"),НомерМаршрута,ТекСтрокаПК.НаименованиеКоэффициента,ТекСтрокаПК.НомерСтроки);
							Сообщение.Сообщить();
						КонецЕсли;	
					КонецЕсли;	
				КонецЦикла;
				
				Если Найти(РасшифровкаD,"+")>0 Тогда
					РасшифровкаD = "(" + РасшифровкаD + ")";
				ИначеЕсли РасшифровкаD = "" Тогда 
					РасшифровкаD = "0";
				КонецЕсли;
				
				//Поправочные значения расхода литров на каждые 100 единиц топлива
				Hplus = 0;
				РасшифровкаHplus = "";
				Для Каждого ТекСтрокаПЗ Из Объект.ПоправочныеЗначения Цикл
					Если (ТекСтрокаПЗ.КлючСтроки = Ключ) И (ПоправкаАктуальнаДляВидаГСМ(ВидСМ, ТекСтрокаПЗ.ПоправочноеЗначение.ВидГСМ)) Тогда
						Если ТекСтрокаПЗ.ЗначениеОсновногоПараметраРасчета = 0 Тогда
							Сообщение = Новый СообщениеПользователю;
							Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для маршрута номер %1 у поправочного значения ""%2"" не указано значение основного параметра расчета в строке %3. Поправочное значение не учтено в расчете.'"),НомерМаршрута,ТекСтрокаПЗ.НаименованиеЗначения,ТекСтрокаПЗ.НомерСтроки);
							Сообщение.Сообщить();
						Иначе	
							Hplus = Hplus + (ЗначениеНормативногоРасходаТоплива/ТекСтрокаПЗ.ЗначениеОсновногоПараметраРасчета)*ТекСтрокаПЗ.Значение;
							РасшифровкаHplus = РасшифровкаHplus + ?(РасшифровкаHplus="",""," + ") + "("+ПолучитьСтрокуДляРасчета(ЗначениеНормативногоРасходаТоплива)+" / "+ПолучитьСтрокуДляРасчета(ТекСтрокаПЗ.ЗначениеОсновногоПараметраРасчета)+") * "+ПолучитьСтрокуДляРасчета(ТекСтрокаПЗ.Значение);
						КонецЕсли;
						
						//контроль заполнения значений
						Если ТекСтрокаПЗ.Значение = 0 Тогда
							Сообщение = Новый СообщениеПользователю;
							Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для маршрута номер %1 у поправочного значения ""%2"" не указано значение в строке %3.'"),НомерМаршрута,ТекСтрокаПЗ.НаименованиеЗначения,ТекСтрокаПЗ.НомерСтроки);
							Сообщение.Сообщить();
						КонецЕсли;	
					КонецЕсли;	
				КонецЦикла;
				
				Если (Найти(РасшифровкаHplus,"+")>0)ИЛИ(Найти(РасшифровкаHplus,"*")>0) Тогда
					РасшифровкаHplus = "(" + РасшифровкаHplus + ")";
				ИначеЕсли РасшифровкаHplus = "" Тогда 
					РасшифровкаHplus = "0";
				КонецЕсли;
				
				
				ТекстФормулы = СтрЗаменить(ТекстФормулы,"ЗначениеНормы",ПолучитьСтрокуДляРасчета(ТекСтрока.Значение));
				ТекстФормулы = СтрЗаменить(ТекстФормулы,"D",ПолучитьСтрокуДляРасчета(D));
				ТекстФормулы = СтрЗаменить(ТекстФормулы,"Hplus",ПолучитьСтрокуДляРасчета(Hplus));
				ТекстФормулыФакт = ТекстФормулы;
				ТекстФормулы = СтрЗаменить(ТекстФормулы,"ЗначениеРасходаГСМ", ЗначениеНормативногоРасходаТоплива);
				
				НастройкиОкругленияГСМ = УчетГСМ.ПолучитьПараметрыОкругленияРасчетаНормГСМ(Объект.Организация, ВидСМ, Объект.ДатаПутевогоЛиста);
				
				НормативныйРасходСМ = Окр(Число(ОбщегоНазначения.ВычислитьВБезопасномРежиме(СтрЗаменить(ТекстФормулы,",","."))),НастройкиОкругленияГСМ.КоличествоЗнаковДробнойЧасти, НастройкиОкругленияГСМ.РежимОкругления);
				
				//детальная расшифровка
				ТекстРасшифровкиФормулы = ТекстФормулыРасчетаСМДляАвтомобиля;
				ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"ЗначениеРасходаГСМ",ПолучитьСтрокуДляРасчета(Объект.ДанныеМаршрута[НомерМаршрута-1].НормативРасходаГСМ));
				ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"ЗначениеНормы",ПолучитьСтрокуДляРасчета(ТекСтрока.Значение));
				ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"D",РасшифровкаD);
				ТекстРасшифровкиФормулы = СтрЗаменить(ТекстРасшифровкиФормулы,"Hplus",РасшифровкаHplus);
				
				НоваяСтрока = Объект.НормативныйРасходСМ.Добавить();
				НоваяСтрока.НомерМаршрута = НомерМаршрута;
				НоваяСтрока.ВидГСМ = ВидГСМ;
				НоваяСтрока.ВидСМ = ТекСтрока.Норма.ВидСМ;
				НоваяСтрока.ЕдиницаИзмерения = ТекСтрока.Норма.ЕдиницаИзмерения;
				НоваяСтрока.ЗначениеРасходаСМ = НормативныйРасходСМ;
				НоваяСтрока.РасшифровкаРасчетаСМ = ТекстРасшифровкиФормулы;
				НоваяСтрока.КлючСтроки = Ключ;
				
				НоваяСтрока.РасшифровкаРасчетаСМФакт = ТекстФормулыФакт;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТекущуюСтрокуФактическогоРасхода()
	Возврат Элементы.ФактическийРасходГСМ.ТекущиеДанные;
КонецФункции

&НаКлиенте
Процедура ПерерасчетЭкономииПерерасхода()
	Стр = ПолучитьТекущуюСтрокуФактическогоРасхода();
	
	РасходГорючегоПоФакту = Стр.ОстатокГорючегоПриВыезде - Стр.ОстатокГорючегоПриВозвращении + Стр.ВыданоГорючее;
	Если РасходГорючегоПоФакту < 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Фактический расход для строки %1 отрицательный. Возможно, неверно указано заправленное (выданное) количество ГСМ!'"),Стр.НомерСтроки);
		Сообщение.Сообщить();
	КонецЕсли;	
	
	Стр.ФактическийРасходГорючего = РасходГорючегоПоФакту;
	
	ИтогоРасходГорючего = Стр.НормативныйРасходГорючего - Стр.ФактическийРасходГорючего;
	Стр.Экономия = 0;
	Стр.Перерасход = 0;
	Если ИтогоРасходГорючего > 0 Тогда
		Стр.Экономия = ИтогоРасходГорючего;
	ИначеЕсли ИтогоРасходГорючего < 0 Тогда
		Стр.Перерасход = (-1)*ИтогоРасходГорючего;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура РассчитатьНормативныйРасходГСМНаСервере()
	Для Каждого ТекущийМаршрут Из Объект.ДанныеМаршрута Цикл
		РассчитатьНормативПоКлючу(ТекущийМаршрут.НомерСтроки, ТекущийМаршрут.КлючСтроки, ТекущийМаршрут.Пробег, ТекущийМаршрут.ВидГСМ, ТекущийМаршрут.РаботаБезПробега);			
	КонецЦикла;	
	
	//свертка для итоговой таблицы и заполнение результатов расчета
	ИтоговаяТаблицаНормативногоРасхода = Объект.ДанныеМаршрута.Выгрузить(,"ВидГСМ, НормативРасходаГСМ");	
	ИтоговаяТаблицаНормативногоРасхода.Свернуть("ВидГСМ","НормативРасходаГСМ");
	
	ДанныеОбОстаткахГСМ = УчетГСМ.ДанныеФактическогоОстаткаГСМПоследнегоПутевогоЛиста(Объект);
	
	//Заполнение нормативного расхода
	Объект.ФактическийРасходГСМ.Очистить();	
	Для Каждого ТекущийНормативныйРасход Из ИтоговаяТаблицаНормативногоРасхода Цикл
		НоваяСтрока = Объект.ФактическийРасходГСМ.Добавить();
		НоваяСтрока.ВидГСМ = ТекущийНормативныйРасход.ВидГСМ;
		НоваяСтрока.НормативныйРасходГорючего = ТекущийНормативныйРасход.НормативРасходаГСМ;
		НоваяСтрока.ЕдиницаИзмерения = ТекущийНормативныйРасход.ВидГСМ.ЕдиницаИзмерения;	
		ОстатокГорючегоПриВыезде = УчетГСМ.ОстатокГСМПоТаблицеОстатков(ТекущийНормативныйРасход.ВидГСМ, ДанныеОбОстаткахГСМ); 
		НоваяСтрока.ОстатокГорючегоПриВыезде = ?(ОстатокГорючегоПриВыезде < 0, 0, ОстатокГорючегоПриВыезде);
	КонецЦикла;	
	
	//Расчет расхода смазочных материалов и специальных жидкостей
	Объект.НормативныйРасходСМ.Очистить();
	Для Каждого ТекущийМаршрут Из Объект.ДанныеМаршрута Цикл
		РассчитатьНормативСмазочныхМатериаловПоКлючу(ТекущийМаршрут.НомерСтроки,ТекущийМаршрут.КлючСтроки,ТекущийМаршрут.Пробег,ТекущийМаршрут.ВидГСМ);			
	КонецЦикла;	
	
	ИтоговаяТаблицаНормативногоРасходаСМ = Объект.НормативныйРасходСМ.Выгрузить(,"ВидСМ, ЗначениеРасходаСМ");	
	ИтоговаяТаблицаНормативногоРасходаСМ.Свернуть("ВидСМ","ЗначениеРасходаСМ");
	
	Для Каждого ТекущийНормативныйРасход Из ИтоговаяТаблицаНормативногоРасходаСМ Цикл
		НоваяСтрока = Объект.ФактическийРасходГСМ.Добавить();
		НоваяСтрока.ВидГСМ = ТекущийНормативныйРасход.ВидСМ;
		НоваяСтрока.НормативныйРасходГорючего = ТекущийНормативныйРасход.ЗначениеРасходаСМ;
		НоваяСтрока.ЕдиницаИзмерения = ТекущийНормативныйРасход.ВидСМ.ЕдиницаИзмерения;		
		НоваяСтрока.НормативныйРасходГорючего = ТекущийНормативныйРасход.ЗначениеРасходаСМ;
		НоваяСтрока.ФактическийРасходГорючего = ТекущийНормативныйРасход.ЗначениеРасходаСМ;
		ОстатокГорючегоПриВыезде = УчетГСМ.ОстатокГСМПоТаблицеОстатков(ТекущийНормативныйРасход.ВидСМ, ДанныеОбОстаткахГСМ); 
		НоваяСтрока.ОстатокГорючегоПриВыезде = ?(ОстатокГорючегоПриВыезде < 0, 0, ОстатокГорючегоПриВыезде); 
		ОстатокГорючегоПриВозвращении = НоваяСтрока.ОстатокГорючегоПриВыезде - ТекущийНормативныйРасход.ЗначениеРасходаСМ;
		НоваяСтрока.ОстатокГорючегоПриВозвращении = ?(ОстатокГорючегоПриВозвращении < 0, 0, ОстатокГорючегоПриВозвращении);
	КонецЦикла;	
	
	//Расчет экономии/перерасхода горючего
	Для Каждого ТекущийРасход Из Объект.ФактическийРасходГСМ Цикл
		ИтогоРасходГорючего = ТекущийРасход.НормативныйРасходГорючего - ТекущийРасход.ФактическийРасходГорючего;
		ТекущийРасход.Экономия = 0;
		ТекущийРасход.Перерасход = 0;
		Если ИтогоРасходГорючего > 0 Тогда
			ТекущийРасход.Экономия = ИтогоРасходГорючего;
		ИначеЕсли ИтогоРасходГорючего < 0 Тогда
			ТекущийРасход.Перерасход = (-1)*ИтогоРасходГорючего;
		КонецЕсли;	
	КонецЦикла;	
	
	//Добавим строки с остатками для тех видов ГСМ, которые отсутствуют в ТЧ "Фактический расход ГСМ", но есть в остатках таксировки предыдущего путевого листа
	Для Каждого ТекСтрока Из ДанныеОбОстаткахГСМ Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ВидГСМ", ТекСтрока.ВидГСМ);
		НайденныеСтроки = Объект.ФактическийРасходГСМ.НайтиСтроки(ПараметрыОтбора); 		
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = Объект.ФактическийРасходГСМ.Добавить();
			НоваяСтрока.ВидГСМ = ТекСтрока.ВидГСМ;
			НоваяСтрока.НормативныйРасходГорючего = 0;
			НоваяСтрока.ЕдиницаИзмерения = ТекСтрока.ЕдиницаИзмерения;	
			НоваяСтрока.ОстатокГорючегоПриВыезде = ТекСтрока.ОстатокГорючегоПриВозвращении; 
			НоваяСтрока.ОстатокГорючегоПриВозвращении = ТекСтрока.ОстатокГорючегоПриВозвращении; 
		КонецЕсли;	
	КонецЦикла;	
	
	Объект.ФактическийРасходГСМ.Сортировать("ВидГСМ Возр"); 
	
	//Заполнение данных о выданных ГСМ и остатках при возвращении по путевому листу
	ЗаполнитьДанныеОДвиженииГорючегоПоПутевомуЛисту();
	
	РассчитатьИЗаписатьОбщийПробегПоМаршрутам();
	
	
	//Сообщение о необходимости перезаполнения ТЧ Материалы
	Если Объект.Материалы.Количество() > 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Выполнен перерасчет нормативного расхода ГСМ. Следует перезаполнить табличную часть ""Списываемые материалы ГСМ"".'");
		Сообщение.Сообщить();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьНастройкиПоКлючу(Ключ, ВидГСММаршрута, ПробегМаршрута, ТекущаяСуммаПробега, НомерМаршрута, ПродолжительностьПростоя)
	//Заполнение норм расхода
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не указана организация. Укажите организацию в поле ""Организация"" и повторите заполнение.'");
		Сообщение.Сообщить();
	КонецЕсли;	
	
	Если Объект.ДатаПутевогоЛиста = Дата(1,1,1) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не указана дата путевого листа. Укажите дату в поле ""от"" и повторите заполнение.'");
		Сообщение.Сообщить();
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.ТранспортноеСредство) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не указано транспортное средство. Укажите транспортное средство в поле ""Транспортное средство"" и повторите заполнение.'");
		Сообщение.Сообщить();
	КонецЕсли;	
	
	СписокВидовГСМ = Новый СписокЗначений;
	СписокВидовГСМ.Добавить(ВидГСММаршрута);	
	
	НастройкиРасчета = УчетГСМ.ПолучитьНормыРасходаТС(Объект.Организация,Перечисления.ВидыОбъектовРасходаГСМ.ТранспортныеСредства,Объект.ТранспортноеСредство,Справочники.НормыРасходаГСМ.ПустаяСсылка(),ВидГСММаршрута,КонецДня(Объект.ДатаПутевогоЛиста));
	
	Выборка = НастройкиРасчета.Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='В организации %1 по виду ГСМ %2 на %3 для транспортного средства нет актуальных настроек в регистре ""Настройки норм расхода ГСМ для транспортных средств и агрегатов"".'"),Объект.Организация,ВидГСММаршрута,Формат(КонецДня(Объект.ДатаПутевогоЛиста),"ДЛФ=Д"));
		Сообщение.Сообщить();
	КонецЕсли;	
	
	Пока Выборка.Следующий() Цикл
		ДобавитьНастройки = Истина;
		//Контроль сезонности параметра расчета
		Если Выборка.Настройка.СезонныйПараметр Тогда
			//контроль даты путевого листа и сезона
			ДобавитьНастройки = СезонныеНастройкиСоответствуютДате(Выборка.Настройка,КонецДня(Объект.ДатаПутевогоЛиста));
		КонецЕсли;
		
		#Область Нормы_КонтрольПробега
		//Контроль действия настройки пока не превышен предельный пробег
		Если Выборка.ДействуетДоПревышенияПробега Тогда
			ДатаДоПЛ = НачалоДня(Объект.ДатаПутевогоЛиста)-1;
			ПробегДоТаксировки = УчетГСМ.ПробегДоТаксировки(Объект.ТранспортноеСредство, Выборка.НачалоПериодаКонтроляПробега, ДатаДоПЛ, Объект.ПоказанияСпидометраПриВыезде);
			Если (ПробегДоТаксировки+ТекущаяСуммаПробега)>Выборка.ПредельныйПробег Тогда
				ДобавитьНастройки = Ложь;
			ИначеЕсли (ПробегДоТаксировки+ТекущаяСуммаПробега+ПробегМаршрута)>Выборка.ПредельныйПробег Тогда
				ПревышениеПробега = (ПробегДоТаксировки+ТекущаяСуммаПробега+ПробегМаршрута) - Выборка.ПредельныйПробег ;
				Если ПревышениеПробега < ПробегМаршрута Тогда 
					ВтораяЧастьПробегаМаршрута = ПревышениеПробега;
					ПерваяЧастьПробегаМаршрута = ПробегМаршрута - ВтораяЧастьПробегаМаршрута;
					
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для заполнения настройки ""%4"" требуется разбить маршрут № %1 на два маршрута (%2 и %3 км) и перезаполнить параметры расчета ТС, т.к. для транспортного средства превышен контрольный пробег согласно настройкам в регистре ""Настройки норм расхода ГСМ для транспортных средств и агрегатов"".'"),
						НомерМаршрута, ПерваяЧастьПробегаМаршрута, ВтораяЧастьПробегаМаршрута, Выборка.НазваниеНастройки);
					Сообщение.Сообщить();
				КонецЕсли;	
				ДобавитьНастройки = Ложь;
			КонецЕсли;
			
		//Контроль действия настройки, если превышен предельный пробег или срок эксплуатации
		ИначеЕсли Выборка.ДействуетПослеПревышенияПробегаИлиПредельногоСрокаЭксплуатации Тогда
			ДобавитьНастройки = Ложь;
			ПерваяЧастьПробегаМаршрута = 0;
			ВтораяЧастьПробегаМаршрута = 0;
			
			ДатаДоПЛ = НачалоДня(Объект.ДатаПутевогоЛиста)-1;
			ПробегДоТаксировки = УчетГСМ.ПробегДоТаксировки(Объект.ТранспортноеСредство, Выборка.НачалоПериодаКонтроляПробега, ДатаДоПЛ, Объект.ПоказанияСпидометраПриВыезде);
			
			НастройкаНеПрименяется = Ложь;
			ПробегУдовлетворяетУсловиям = Ложь;
			ЕстьСообщениеОПробеге = Ложь;
			Если Выборка.ПредельныйПробегОкончанияДействия = 0 Тогда
				Если ((ПробегДоТаксировки+ТекущаяСуммаПробега)>Выборка.ПредельныйПробег) Тогда
					ПробегУдовлетворяетУсловиям = Истина;
				ИначеЕсли ((ПробегДоТаксировки+ТекущаяСуммаПробега+ПробегМаршрута)>Выборка.ПредельныйПробег) Тогда
					ПревышениеПробега = (ПробегДоТаксировки+ТекущаяСуммаПробега+ПробегМаршрута) - Выборка.ПредельныйПробег;
					Если ПревышениеПробега < ПробегМаршрута Тогда 
						ВтораяЧастьПробегаМаршрута = ПревышениеПробега;
						ПерваяЧастьПробегаМаршрута = ПробегМаршрута - ВтораяЧастьПробегаМаршрута;
						
						ЕстьСообщениеОПробеге = Истина;
					ИначеЕсли ПревышениеПробега = ПробегМаршрута Тогда
						ПробегУдовлетворяетУсловиям = Истина;
					КонецЕсли;	
				КонецЕсли;	
				
			Иначе
				Если ((ПробегДоТаксировки+ТекущаяСуммаПробега)>Выборка.ПредельныйПробег)
					И ((ПробегДоТаксировки+ТекущаяСуммаПробега)<=Выборка.ПредельныйПробегОкончанияДействия) Тогда
					ПробегУдовлетворяетУсловиям = Истина;
				Иначе
					Если ((ПробегДоТаксировки+ТекущаяСуммаПробега+ПробегМаршрута)>Выборка.ПредельныйПробег)
						И ((ПробегДоТаксировки+ТекущаяСуммаПробега+ПробегМаршрута)<=Выборка.ПредельныйПробегОкончанияДействия) Тогда
						ПревышениеПробега = Выборка.ПредельныйПробег - (ПробегДоТаксировки+ТекущаяСуммаПробега+ПробегМаршрута);
						Если ПревышениеПробега < ПробегМаршрута Тогда 
							ВтораяЧастьПробегаМаршрута = ПревышениеПробега;
							ПерваяЧастьПробегаМаршрута = ПробегМаршрута - ВтораяЧастьПробегаМаршрута;
					
							ЕстьСообщениеОПробеге = Истина;
						ИначеЕсли ПревышениеПробега = ПробегМаршрута Тогда
							ПробегУдовлетворяетУсловиям = Ложь;
						КонецЕсли;	
					КонецЕсли;
				КонецЕсли;	
				
				Если ((ПробегДоТаксировки+ТекущаяСуммаПробега+ПробегМаршрута)>Выборка.ПредельныйПробегОкончанияДействия) Тогда
					НастройкаНеПрименяется = Истина;
				КонецЕсли;	
			КонецЕсли;
			
			СрокЭксплуатацииУдовлетворяетУсловиям = Ложь;
			Если Выборка.ПредельнаяДатаОкончанияДействия = Дата(1,1,1) Тогда
				Если НачалоДня(Объект.СрокДействия) >= НачалоДня(Выборка.ПредельнаяДата) Тогда
					СрокЭксплуатацииУдовлетворяетУсловиям = Истина;
				КонецЕсли;	
			Иначе
				Если (НачалоДня(Объект.СрокДействия) >= НачалоДня(Выборка.ПредельнаяДата)) И (НачалоДня(Объект.СрокДействия) <= НачалоДня(Выборка.ПредельнаяДатаОкончанияДействия)) Тогда
					СрокЭксплуатацииУдовлетворяетУсловиям = Истина;
				КонецЕсли;
				
				Если (НачалоДня(Объект.СрокДействия) > НачалоДня(Выборка.ПредельнаяДатаОкончанияДействия)) Тогда
					НастройкаНеПрименяется = Истина;
				КонецЕсли;	
			КонецЕсли;	
			
			Если НЕ НастройкаНеПрименяется Тогда
				Если СрокЭксплуатацииУдовлетворяетУсловиям Тогда
					ДобавитьНастройки = Истина;
				Иначе
					Если ПробегУдовлетворяетУсловиям Тогда
						ДобавитьНастройки = Истина;
					Иначе
						Если ЕстьСообщениеОПробеге Тогда
							Сообщение = Новый СообщениеПользователю;
							Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для заполнения настройки ""%4"" требуется разбить маршрут № %1 на два маршрута (%2 и %3 км) и перезаполнить параметры расчета ТС, т.к. для транспортного средства превышен контрольный пробег согласно настройкам в регистре ""Настройки норм расхода ГСМ для транспортных средств и агрегатов"".'"),
								НомерМаршрута, ПерваяЧастьПробегаМаршрута, ВтораяЧастьПробегаМаршрута, Выборка.НазваниеНастройки);
							Сообщение.Сообщить();
						КонецЕсли;	
					Конецесли;	
				КонецЕсли;	
			КонецЕсли; 
		КонецЕсли;	
		#КонецОбласти
		
		Если ДобавитьНастройки Тогда
			НоваяСтрока = Объект.НормыРасхода.Добавить();
			НоваяСтрока.НаименованиеНормы = Выборка.НазваниеНастройки;
			НоваяСтрока.Норма = Выборка.Настройка;
			НоваяСтрока.Значение = Выборка.Настройка.Значение;
			НоваяСтрока.ЕдиницаИзмерения = Выборка.Настройка.ЕдиницаИзмерения;
			НоваяСтрока.Параметр = Выборка.Настройка.ОсновнойПараметрРасчета;
			НоваяСтрока.ЗначениеПараметра = Выборка.Настройка.ЗначениеОсновногоПараметраРасчета;
			//Продолжительность простоя из маршрута
			Если ЗначениеЗаполнено(Выборка.Настройка.ОсновнойПараметрРасчета) И ПродолжительностьПростоя > 0 Тогда
				Если Выборка.Настройка.ОсновнойПараметрРасчета = Перечисления.ВидыПараметровДляНормРасходаГСМ.ВремяПростоя Тогда
					НоваяСтрока.ЗначениеПараметра = Окр(ПродолжительностьПростоя/3600, 2);	
				КонецЕсли;	
			КонецЕсли;	
			НоваяСтрока.ЕдиницаИзмеренияПараметра = Выборка.Настройка.ЕдиницаИзмеренияПараметра;
			НоваяСтрока.КлючСтроки = Ключ;
			
			Если Выборка.Настройка.ВидНормы = Перечисления.ВидыНормРасходаГСМ.НормаРасходаСмазочныхМатериалов Тогда
				СписокВидовГСМ.Добавить(Выборка.Настройка.ВидСМ);	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	//Заполнение поправочных коэффициентов расхода
