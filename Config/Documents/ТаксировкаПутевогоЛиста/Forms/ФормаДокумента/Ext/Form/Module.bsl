&НаСервере
Функция ПолучитьДанныеТаксировкиПутевогоЛиста(Таксировка)
	Возврат УчетГСМ.ПолучитьДанныеТаксировкиПутевогоЛиста(Таксировка);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРуководителя(Знач Организация, Знач Подразделение, Знач Дата, Руководитель)

	НовыйРуководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Руководитель", Организация, Дата, Подразделение);
	
	Если ЗначениеЗаполнено(НовыйРуководитель.ОтветственноеЛицоСсылка) 
		И Руководитель <> НовыйРуководитель.ОтветственноеЛицоСсылка Тогда
		Руководитель = НовыйРуководитель.ОтветственноеЛицоСсылка;
		#Если Клиент Тогда
		ПоказатьОповещениеПользователя(,,НСтр("ru = 'Установлено новое значение поля ""Руководитель"" на закладке ""Заключение комиссии""'"));			
		#КонецЕсли
	КонецЕсли;

КонецПроцедуры // УстановитьРуководителя()

&НаКлиенте
Процедура ОбработкаДобавленияДокументаТаксировкиНаКлиенте(ДокументТаксировки)
	
	ТекущиеДанные = Элементы.ТаксировкиПутевыхЛистов.ТекущиеДанные;
	ТекущиеДанные.ТаксировкаПутевогоЛиста = ДокументТаксировки;
	
КонецПроцедуры

&НаСервере
Функция НетВСпискеТаксировок(ДокументТаксировки)
	Результат = Истина;
	
	НайденныеСтроки = Объект.ТаксировкиПутевыхЛистов.НайтиСтроки(Новый Структура("ТаксировкаПутевогоЛиста", ДокументТаксировки));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Результат = Ложь;
		
		ТекстОшибки = НСтр("ru = 'Выбранный документ уже присутствует в %1 строке списка.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, НайденныеСтроки[0].НомерСтроки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , "ТаксировкаПутевогоЛиста", "ТаксировкиПутевыхЛистов");
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ПоказатьДанныеСпидометраПриИзменении()
	ПоказанияСпидометраПриВозвращении = Объект.ПоказанияСпидометраПриВыезде + Объект.ПробегОбщий;
	Элементы.ПоказанияСпидометраПриВозвращенииРасчетные.Заголовок = НСтр("ru='при возвращении: '") + ПоказанияСпидометраПриВозвращении + НСтр("ru=' км'");
КонецПроцедуры

&НаСервере
Процедура ПробегОбщийПриИзмененииНаСервере()
	ПоказатьДанныеСпидометраПриИзменении();
	ПоказатьРазницуПробегов();
КонецПроцедуры

&НаСервере
Процедура ПоказатьРазницуПробегов()
	Если Объект.ПробегОбщий <> 0 Тогда
		РазницаПробегов = Объект.ПробегОбщий - Объект.ДанныеМаршрута.Итог("Пробег");
		Если РазницаПробегов < 0 Тогда
			РазницаПробегов = РазницаПробегов * (-1);
			ТекстСообщения = НСтр("ru='меньше суммарного на '") + РазницаПробегов + НСтр("ru=' км'")
		ИначеЕсли РазницаПробегов > 0 Тогда
			ТекстСообщения = НСтр("ru='больше суммарного на '") + РазницаПробегов + НСтр("ru=' км'")
		Иначе
			ТекстСообщения = "";
		КонецЕсли;
		Элементы.РазницаПробегов.Заголовок = ТекстСообщения;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПроверитьПоказанияСпидометра()
	
	Если Объект.ВидТаксировки <> Перечисления.ВидыТаксировкиДокументовУчетаГСМ.СводныйРасчетРасходаГСМПоТаксировкам Тогда 
		Если НЕ Объект.ПерваяТаксировкаПослеСбросаСчетчикаПробега Тогда
			ДатаПоследнегоСбросаСчетчика = УчетГСМ.ДатаПоследнегоСбросаСчетчикаПробега(Объект.ТранспортноеСредство, Объект.Дата, Объект.Ссылка);
			
			НачалоПериода = ДатаПоследнегоСбросаСчетчика;
			КонецПериода = Объект.ДатаПутевогоЛиста;
			
			ПоказанияСпидометраПредыдущегоПутевогоЛиста = УчетГСМ.ПробегТСНаКонецПериода(Объект.ТранспортноеСредство, НачалоПериода, КонецПериода, Объект.Ссылка);	
			
			Если ПоказанияСпидометраПредыдущегоПутевогоЛиста > Объект.ПоказанияСпидометраПриВыезде Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Пробег транспортного средства по данным таксировки предыдущего путевого листа (%1 км) больше показаний спидометра при выезде данной таксировки (%2 км). Если была произведена замена устройства контроля пробега или сброс счетчика пробега следует включить флажок ""Первая таксировка после сброса (замены) счетчика пробега"" на закладке ""Данные путевого листа"".'"),
						Формат(ПоказанияСпидометраПредыдущегоПутевогоЛиста, "ЧЦ=17; ЧДЦ=2"), Формат(Объект.ПоказанияСпидометраПриВыезде, "ЧЦ=17; ЧДЦ=2"));
					Сообщение.Сообщить();
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Функция МожноЗаполнитьНастройкиРасчета();
	Результат = Истина;
	
	Если Объект.СрокДействия = Дата(1,1,1) Тогда
		ТекстСообщения = НСтр("ru='Срок действия путевого листа не заполнен! Заполнение настроек расчета не выполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.СрокДействия");
		Результат = Ложь;
	КонецЕсли;	
	
	Если Объект.ДатаПутевогоЛиста = Дата(1,1,1) Тогда
		ТекстСообщения = НСтр("ru='Дата путевого листа не заполнена! Заполнение настроек расчета не выполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ДатаПутевогоЛиста");
		Результат = Ложь;
	КонецЕсли;	
	
	Если Объект.ПоказанияСпидометраПриВыезде = 0 Тогда
		ТекстСообщения = НСтр("ru='Возможно показания спидометра при выезде не заполнены! Это может привести к неверному заполнению настроек расчета!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ДатаПутевогоЛиста");
	КонецЕсли;	
	
	Если Объект.СрокДействия < Объект.ДатаПутевогоЛиста Тогда
		ТекстСообщения = НСтр("ru='Срок действия путевого листа меньше даты путевого листа! Заполнение настроек расчета не выполнено.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.СрокДействия");
		Результат = Ложь;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ПоказатьЗначениеОдометраПриВозвращенииИзПредыдущегоРейса()
	Если Объект.ВидТаксировки <> Перечисления.ВидыТаксировкиДокументовУчетаГСМ.СводныйРасчетРасходаГСМПоТаксировкам Тогда 
		Если ЗначениеЗаполнено(Объект.ТранспортноеСредство) И НЕ(Объект.ДатаПутевогоЛиста = Дата(1,1,1)) Тогда 
			ДатаДоПЛ = НачалоДня(Объект.ДатаПутевогоЛиста)-1;
			
			Если Объект.НомерСмены > 1 Тогда
				ПоказанияСпидометраПоПредыдущейТаксировке = УчетГСМ.ПоказанияСпидометраПоследнейСмены(Объект.НомерСмены, Объект.ТранспортноеСредство, Объект.ДатаПутевогоЛиста);  
			Иначе
				ПоказанияСпидометраПоПредыдущейТаксировке = УчетГСМ.ПробегТСНаКонецПериода(Объект.ТранспортноеСредство, Дата(1,1,1), ДатаДоПЛ, Объект.Ссылка);
			КонецЕсли;	
			Элементы.ПоказанияСпидометрПриВозвращенииПоПоследнейТаксировке.Заголовок = НСтр("ru='Спидометр на конец последнего рейса: '") + ПоказанияСпидометраПоПредыдущейТаксировке + НСтр("ru=' км'");
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ДатаПутевогоЛистаПриИзмененииНаСервере()
	ПоказатьЗначениеОдометраПриВозвращенииИзПредыдущегоРейса();
	Если Объект.СрокДействия = Дата(1,1,1) Тогда
		Объект.СрокДействия = Объект.ДатаПутевогоЛиста;
	ИначеЕсли Объект.СрокДействия < Объект.ДатаПутевогоЛиста Тогда
		Объект.СрокДействия = Объект.ДатаПутевогоЛиста;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеДанныхПриЗаписи()

	Если Объект.ВидТаксировки = Перечисления.ВидыТаксировкиДокументовУчетаГСМ.СводныйРасчетРасходаГСМПоТаксировкам Тогда
		Объект.ПутевойЛист = "";
		Объект.СерияПутевогоЛиста = "";
		Объект.НомерПутевогоЛиста = "";
		Объект.ДатаПутевогоЛиста = Дата(1,1,1);
		Объект.СрокДействия = Дата(1,1,1);
	Иначе
		Если Объект.ПробегОбщий = 0 Тогда
			РассчитатьИЗаписатьОбщийПробегПоМаршрутам();
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеОДвиженииГорючегоПоПутевомуЛисту()
	Если ЗначениеЗаполнено(Объект.ПутевойЛист) Тогда	
		ТаблицаГорючего = УчетГСМ.ДанныеДвиженияГорючегоИзПутевогоЛиста(Объект.ПутевойЛист);
		ТаблицаГорючего.Свернуть("ВидГСМ", "ВыданоГорючее, ОстатокГорючегоПриВозвращении");
		
		Для Каждого ТекСтрока Из Объект.ФактическийРасходГСМ Цикл
			ПараметрыОтбора = Новый Структура("ВидГСМ", ТекСтрока.ВидГСМ); 	
			МассивНайденныхСтрок = ТаблицаГорючего.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаРедактирования Из МассивНайденныхСтрок Цикл
				ТекСтрока.ВыданоГорючее = СтрокаРедактирования.ВыданоГорючее;
				ТекСтрока.ОстатокГорючегоПриВозвращении = СтрокаРедактирования.ОстатокГорючегоПриВозвращении;
				
				РасходГорючегоПоФакту = ТекСтрока.ОстатокГорючегоПриВыезде - ТекСтрока.ОстатокГорючегоПриВозвращении + ТекСтрока.ВыданоГорючее;
				ТекСтрока.ФактическийРасходГорючего = РасходГорючегоПоФакту;
				
				РезультатРасчета = ТекСтрока.ФактическийРасходГорючего - ТекСтрока.НормативныйРасходГорючего;
				Если РезультатРасчета > 0 Тогда
					ТекСтрока.Перерасход = РезультатРасчета;
					ТекСтрока.Экономия = 0;
				Иначе
					ТекСтрока.Перерасход = 0;
					ТекСтрока.Экономия = (-1)*РезультатРасчета;
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЦикла;
		
		//Уточняющий расчет СМ
		ПровестиУточняющийРасчетФактическогоРасходаСМ();
		
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМаршрутыОбщимПробегомНаСервере()
	Объект.ДанныеМаршрута.Очистить();
	Если ЗначениеЗаполнено(Объект.ПутевойЛист) Тогда
		Если Объект.ПутевойЛистЭлектронный Тогда
			ОбщийПробег = УчетГСМ.ПробегПоЭлектронномуПутевомуЛисту(Объект.ПутевойЛист, Объект.Организация);
			Если ОбщийПробег > 0 Тогда
				НоваяСтрока = Объект.ДанныеМаршрута.Добавить();
				НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор;
				НоваяСтрока.Пробег = ОбщийПробег;
				НоваяСтрока.ПродолжительностьПростоя = 0;
				
				Объект.ПробегОбщий = ОбщийПробег;
			КонецЕсли;
		Иначе	
			ДанныеИзПутевогоЛиста = УчетГСМ.МаршрутыОбщимПробегомИВидыГСМИзПутевогоЛиста(Объект.ПутевойЛист);
			
			Если ДанныеИзПутевогоЛиста.ЗаполнениеВозможно Тогда
				КоличествоВидовГСМ = ДанныеИзПутевогоЛиста.ВидыГСМ.Количество();
				Для Каждого ТекСтрока Из ДанныеИзПутевогоЛиста.Маршруты Цикл
					Если КоличествоВидовГСМ > 0 Тогда
						Для каждого ТекВидГСМ Из ДанныеИзПутевогоЛиста.ВидыГСМ Цикл
							НоваяСтрока = Объект.ДанныеМаршрута.Добавить();
							НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор;
							НоваяСтрока.Пробег = ТекСтрока.Пробег;
							НоваяСтрока.ВидГСМ = ТекВидГСМ.ВидГСМ;
							НоваяСтрока.ПродолжительностьПростоя = ТекСтрока.Простой;
						КонецЦикла;
					Иначе
						НоваяСтрока = Объект.ДанныеМаршрута.Добавить();
						НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор;
						НоваяСтрока.Пробег = ТекСтрока.Пробег;
						НоваяСтрока.ПродолжительностьПростоя = ТекСтрока.Простой;
					КонецЕсли;
				КонецЦикла;
				
				Объект.ПробегОбщий = ДанныеИзПутевогоЛиста.ОбщийПробег;
				ПоказатьДанныеСпидометраПриИзменении();
				ПоказатьРазницуПробегов();
				ПоказатьКоличествоВремени();
			Иначе
				ТекстСообщения = ДанныеИзПутевогоЛиста.СообщениеПользователю;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ДанныеМаршрута");
			КонецЕсли;
		КонецЕсли;	
	Иначе
		ТекстСообщения = НСтр("ru='Не заполнен реквизит ""Путевой лист"" на закладке ""Данные путевого листа""! Следует добавить маршруты вручную.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ДанныеМаршрута");
	Конецесли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМаршрутыСпискомНаСервере()
	Объект.ДанныеМаршрута.Очистить();
	Если ЗначениеЗаполнено(Объект.ПутевойЛист) Тогда	
		ДанныеИзПутевогоЛиста = УчетГСМ.МаршрутыСпискомИВидыГСМИзПутевогоЛиста(Объект.ПутевойЛист);
		
		Если ДанныеИзПутевогоЛиста.ЗаполнениеВозможно Тогда
			КоличествоВидовГСМ = ДанныеИзПутевогоЛиста.ВидыГСМ.Количество();
			Для Каждого ТекСтрока Из ДанныеИзПутевогоЛиста.Маршруты Цикл
				Если КоличествоВидовГСМ > 0 Тогда
					Для каждого ТекВидГСМ Из ДанныеИзПутевогоЛиста.ВидыГСМ Цикл
						Если ТекСтрока.Пробег = 0 Тогда
							НоваяСтрока = Объект.ДанныеМаршрута.Добавить();
							НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор;
							НоваяСтрока.Пробег = ТекСтрока.Пробег;
							НоваяСтрока.ВидГСМ = ТекВидГСМ.ВидГСМ;
							НоваяСтрока.МаршрутДвижения = ТекСтрока.МаршрутДвижения;
							НоваяСтрока.Примечание = СокрЛП(ТекСтрока.МаршрутДвижения);
							НоваяСтрока.РаботаБезПробега = Истина;
							НоваяСтрока.ПродолжительностьПростоя = ТекСтрока.Простой;
						Иначе
							НоваяСтрока = Объект.ДанныеМаршрута.Добавить();
							НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор;
							НоваяСтрока.Пробег = ТекСтрока.Пробег;
							НоваяСтрока.ВидГСМ = ТекВидГСМ.ВидГСМ;
							НоваяСтрока.МаршрутДвижения = ТекСтрока.МаршрутДвижения;
							НоваяСтрока.Примечание = СокрЛП(ТекСтрока.МаршрутДвижения);
							НоваяСтрока.ПродолжительностьПростоя = ТекСтрока.Простой;
						КонецЕсли;
					КонецЦикла;
				Иначе
					Если ТекСтрока.Пробег = 0 Тогда
						НоваяСтрока = Объект.ДанныеМаршрута.Добавить();
						НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор;
						НоваяСтрока.Пробег = ТекСтрока.Пробег;
						НоваяСтрока.МаршрутДвижения = ТекСтрока.МаршрутДвижения;
						НоваяСтрока.Примечание = СокрЛП(ТекСтрока.МаршрутДвижения);
						НоваяСтрока.РаботаБезПробега = Истина;
						НоваяСтрока.ПродолжительностьПростоя = ТекСтрока.Простой;
					Иначе	
						НоваяСтрока = Объект.ДанныеМаршрута.Добавить();
						НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор;
						НоваяСтрока.Пробег = ТекСтрока.Пробег;
						НоваяСтрока.МаршрутДвижения = ТекСтрока.МаршрутДвижения;
						НоваяСтрока.Примечание = СокрЛП(ТекСтрока.МаршрутДвижения);
						НоваяСтрока.ПродолжительностьПростоя = ТекСтрока.Простой;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
			
			Объект.ПробегОбщий = ДанныеИзПутевогоЛиста.ОбщийПробег;
			ПоказатьДанныеСпидометраПриИзменении();
			ПоказатьРазницуПробегов();
			ПоказатьКоличествоВремени();
			
			Если ЗначениеЗаполнено(ДанныеИзПутевогоЛиста.СообщениеПользователю) Тогда
				ТекстСообщения = ДанныеИзПутевогоЛиста.СообщениеПользователю;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ДанныеМаршрута");
			КонецЕсли;	
			
			Если ДанныеИзПутевогоЛиста.ЕстьПредупреждения Тогда
				ТекстСообщения = ДанныеИзПутевогоЛиста.СообщениеПользователюПоМаршрутам;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ДанныеМаршрута");
			КонецЕсли;	
		Иначе
			ТекстСообщения = ДанныеИзПутевогоЛиста.СообщениеПользователю;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ДанныеМаршрута");
		КонецЕсли;	
	Иначе
		ТекстСообщения = НСтр("ru='Не заполнен реквизит ""Путевой лист"" на закладке ""Данные путевого листа""! Следует добавить маршруты вручную.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ДанныеМаршрута");
	Конецесли;
КонецПроцедуры

&НаКлиенте
Процедура ВводРасчетногоЗначенияПараметраНаКлиенте()
	ДанныеСтроки = Элементы.НормыРасхода.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.Параметр)
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеСтроки.Норма) Тогда
		Возврат;
	КонецЕсли;	
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ИдентификаторЗначенияПараметра, ПродолжительностьРаботы");
	
	ИдентификаторЗначенияПараметра = ИдентификаторЗначенияПараметраПоНормеРасхода(ДанныеСтроки.Норма);
	Если ИдентификаторЗначенияПараметра = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ИдентификаторЗначенияПараметра", ИдентификаторЗначенияПараметра);
	ПараметрыФормы.Вставить("ПродолжительностьРаботы", ДанныеСтроки.ЗначениеПараметра);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("Документ.ТаксировкаПутевогоЛиста.Форма.ФормаВводаЗначенияПараметраРасчетаНормы", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервере 
Функция ИдентификаторЗначенияПараметраПоНормеРасхода(НормаРасхода)
	Результат = 0;
	
	Если НормаРасхода.ВидНормы = Перечисления.ВидыНормРасходаГСМ.НормаДляОтопителя 
		ИЛИ НормаРасхода.ВидНормы = Перечисления.ВидыНормРасходаГСМ.НормаРасходаНаРаботуСпецоборудования Тогда
		Результат = 1;
	ИначеЕсли НормаРасхода.ВидНормы = Перечисления.ВидыНормРасходаГСМ.ТранспортнаяНормаНаПеревозкуГруза 
		ИЛИ НормаРасхода.ВидНормы = Перечисления.ВидыНормРасходаГСМ.НормаНаДополнительнуюМассуПрицепа Тогда
		Результат = 2;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура ОбработкаВыбораЗначенияПараметраНаКлиенте(СтруктураПоказателейРасчета)

	ТекущиеДанные = Элементы.НормыРасхода.ТекущиеДанные;
	Если СтруктураПоказателейРасчета.ИдентификаторЗначенияПараметра = 1 Тогда
		ТекущиеДанные.ЗначениеПараметра = (СтруктураПоказателейРасчета.ПродолжительностьРаботы/60)/60;
	ИначеЕсли СтруктураПоказателейРасчета.ИдентификаторЗначенияПараметра = 2 Тогда 
		ТекущиеДанные.ЗначениеПараметра = СтруктураПоказателейРасчета.ОбъемТранспортнойРаботы;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеМаршрутаДвижения(МаршрутДвижения)
	Результат = Новый Структура;
	
	Результат = УчетГСМ.ПолучитьДанныеМаршрутаДвижения(МаршрутДвижения);	
	
	ВидГСМ = Справочники.ВидыГСМ.ПустаяСсылка();
	
	ГорючееТС = УчетГСМ.ДанныеНастроекГорючегоТС(Объект.Организация, Объект.ТранспортноеСредство);
	Если ГорючееТС.Количество() > 0 Тогда
		ВидГСМ = ГорючееТС[0].МаркаГорючего;
	КонецЕсли;
	Результат.Вставить("ВидГСМ", ВидГСМ);
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ДобавитьНастройкиДляМаршрутаДвижения(Ключ, МаршрутДвижения)
	Если ЗначениеЗаполнено(МаршрутДвижения)	Тогда
		Для каждого ТекСтрока Из МаршрутДвижения.ПоправочныеКоэффициенты Цикл
			НоваяСтрока = Объект.ПоправочныеКоэффициенты.Добавить();
			НоваяСтрока.НаименованиеКоэффициента = ТекСтрока.ПоправочныйКоэффициент.Наименование;
			НоваяСтрока.ПоправочныйКоэффициент = ТекСтрока.ПоправочныйКоэффициент;
			НоваяСтрока.Значение = ТекСтрока.ПоправочныйКоэффициент.ЗначениеВПроцентах;
			НоваяСтрока.КлючСтроки = Ключ;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ТранспортноеСредствоПриИзмененииНаСервере()
	ПоказатьЗначениеОдометраПриВозвращенииИзПредыдущегоРейса();
	УстановитьНомераТС();
КонецПроцедуры	

&НаСервере
Процедура УстановитьНомераТС()
	Объект.РегистрационныйНомернойЗнак = УчетГСМ.ПолучитьГосударственныйНомернойЗнакТС(Объект.ТранспортноеСредство); 
	Объект.ГаражныйНомер = УчетГСМ.ПолучитьГаражныйНомерТС(Объект.ТранспортноеСредство);
КонецПроцедуры	

&НаСервере
Процедура УстановитьФактическийРасходГорючегоПоНормативномуРасходуНаСервере()
	Для каждого ТекСтрока Из Объект.ФактическийРасходГСМ Цикл
		ВидГСМ = ТекСтрока.ВидГСМ;
		Если ВидГСМ.ТипГСМ = Перечисления.ТипыГСМ.Горючее Тогда
			ТекСтрока.ФактическийРасходГорючего = ТекСтрока.НормативныйРасходГорючего;
			ТекСтрока.ОстатокГорючегоПриВозвращении = ТекСтрока.ОстатокГорючегоПриВыезде + ТекСтрока.ВыданоГорючее - ТекСтрока.ФактическийРасходГорючего;
			ТекСтрока.Экономия = 0;
			ТекСтрока.Перерасход = 0;
		КонецЕсли;	
	КонецЦикла;
	ПровестиУточняющийРасчетФактическогоРасходаСМ();
КонецПроцедуры


