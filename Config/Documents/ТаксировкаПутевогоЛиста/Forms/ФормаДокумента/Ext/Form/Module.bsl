&НаСервере
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыАктыОСписании()
	Если Объект.АналитикаАктовОСписании.Количество() > 0 Тогда
		ПараметрыАналитикиАктов = Объект.АналитикаАктовОСписании.Выгрузить();
		ПараметрыАналитикиАктов.Свернуть("ИФО, ЦМО, Подразделение");
		ЗаполнитьДанныеОбАктахОСписанииМЗ(ПараметрыАналитикиАктов);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеОбАктахОСписанииМЗ(АналитикаАктов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Таб.ИФО КАК ИФО,
	               |	Таб.Подразделение КАК Подразделение,
	               |	Таб.ЦМО КАК ЦМО
	               |ПОМЕСТИТЬ ВТДанные
	               |ИЗ
	               |	&Данные КАК Таб
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	АктСписанияМЗ.Ссылка КАК Ссылка,
	               |	АктСписанияМЗ.ИФО КАК ИФО,
	               |	АктСписанияМЗ.ПодразделениеОтправитель КАК Подразделение,
	               |	АктСписанияМЗ.ЦМООтправитель КАК ЦМО
	               |ПОМЕСТИТЬ АктыТаксировки
	               |ИЗ
	               |	Документ.АктСписанияМЗ КАК АктСписанияМЗ
	               |ГДЕ
	               |	АктСписанияМЗ.ДокументОснование = &ДокументОснование
	               |	И АктСписанияМЗ.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТДанные.ИФО КАК ИФО,
	               |	ВТДанные.Подразделение КАК Подразделение,
	               |	ВТДанные.ЦМО КАК ЦМО,
	               |	АктыТаксировки.Ссылка КАК АктОСписанииМЗ,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(АктыТаксировки.Ссылка, 0) = 0
	               |			ТОГДА ""Создать новый акт""
	               |		ИНАЧЕ АктыТаксировки.Ссылка
	               |	КОНЕЦ КАК АктОСписанииМЗИнфо
	               |ИЗ
	               |	ВТДанные КАК ВТДанные
	               |		ЛЕВОЕ СОЕДИНЕНИЕ АктыТаксировки КАК АктыТаксировки
	               |		ПО ВТДанные.ИФО = АктыТаксировки.ИФО
	               |			И ВТДанные.Подразделение = АктыТаксировки.Подразделение
	               |			И ВТДанные.ЦМО = АктыТаксировки.ЦМО";
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	Запрос.УстановитьПараметр("Данные", АналитикаАктов);
	ДанныеАктов = Запрос.Выполнить().Выгрузить();
	
	АктыОСписанииМЗ.Загрузить(ДанныеАктов);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыТаксировки(ТекущаяСтрока)

	ДанныеТаксировки = ПолучитьДанныеТаксировкиПутевогоЛиста(ТекущаяСтрока.ТаксировкаПутевогоЛиста);
	
	ТекущаяСтрока.ПутевойЛистТаксировки = ДанныеТаксировки.НаименованиеДокумента;
	ТекущаяСтрока.ЕстьОперацияТаксировки = ДанныеТаксировки.НомерКартинки;
	
КонецПроцедуры

