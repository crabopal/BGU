&НаКлиенте
Процедура ЗаполнитьНастройкиРасчетаГСМДляТС(Команда)
	//Сообщение о необходимости заполнения ТЧ ДанныеМаршрута
	Если Объект.ДанныеМаршрута.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не добавлено ни одного маршрута в табличную часть ""Маршруты с различными параметрами расчета нормативного расхода ГСМ"". Повторите заполнение параметров расчета после добавления маршрута.'");
		Сообщение.Сообщить();
	Иначе
		ЗаполнитьНастройкиРасчетаГСМДляТСНаСервере();
		
		ОбновитьТекстЗаголовковВсехСтрокТаблицыНормыРасхода(ЭтаФорма);
		ОбновитьТекстЗаголовковВсехСтрокТаблицыПоправочныеЗначенияРасхода(ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

