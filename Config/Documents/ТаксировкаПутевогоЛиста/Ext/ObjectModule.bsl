#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ЭтотОбъект.ВидТаксировки = Перечисления.ВидыТаксировкиДокументовУчетаГСМ.СводныйРасчетРасходаГСМПоТаксировкам Тогда
		ЗаполнитьРегистрационныйИГаражныйНомераДляСводнойТаксировки();	
	КонецЕсли;
	
	ПодразделениеДляАктаОСписании = Справочники.Подразделения.ПустаяСсылка();
	ЦМОДляАктаОСписании = Справочники.ЦМО.ПустаяСсылка();
	ИФОДляАктаОСписании = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
	ОдинАктОСписании = Ложь;
	
	АналитикаАктовОСписании.Очистить();
	СписываемыеМатериалы = ЭтотОбъект.Материалы.Выгрузить();
	СписываемыеМатериалы.Свернуть("Подразделение, ЦМО, ИФО","Количество");
	Если СписываемыеМатериалы.Количество() = 0 Тогда
		ОдинАктОСписании = Истина;
	ИначеЕсли СписываемыеМатериалы.Количество() = 1 Тогда
		ПодразделениеДляАктаОСписании = СписываемыеМатериалы[0].Подразделение;
		ЦМОДляАктаОСписании = СписываемыеМатериалы[0].ЦМО;
		ИФОДляАктаОСписании = СписываемыеМатериалы[0].ИФО;
		ОдинАктОСписании = Истина;
	ИначеЕсли СписываемыеМатериалы.Количество() > 1 Тогда
		ОдинАктОСписании = Ложь;
		АналитикаАктовОСписании.Загрузить(СписываемыеМатериалы);
	КонецЕсли;	
	
	СписаниеМатериаловАктомСписанияМЗ = Ложь;
	Если ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(ПервичныйДокумент,
			"АктОСписанииМЗ0510460_157н") Тогда
		Если НЕ ОдинАктОСписании Тогда
			СписаниеМатериаловАктомСписанияМЗ = Истина;
		КонецЕсли;
	КонецЕсли;	
	
	УдалитьЗаправкиДляОтсутствующихВидовГСМ();
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	ТаксировкаСсылка = УчетГСМ.НайтиТаксировкиПоДокументу(ДанныеЗаполнения);
	Если ЗначениеЗаполнено(ТаксировкаСсылка) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для документа уже введена %1.'"),ТаксировкаСсылка);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;	
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПутевойЛист3") ИЛИ
	ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПутевойЛист4П") ИЛИ
	ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПутевойЛист4С") ИЛИ
	ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПутевойЛист6спец") ИЛИ
	ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПутевойЛист3спец") ИЛИ
	ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПутевойЛист412АПК") ИЛИ
	ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПутевойЛист6") Тогда
		ЗаполнитьПоПутевомуЛисту(ДанныеЗаполнения);	
		ЗаполнитьПоказанияСпидометраПоПутевомуЛисту(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПутевойЛистЭСМ2") Тогда
		ЗаполнитьПоПутевомуЛисту(ДанныеЗаполнения);	
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.ТаксировкаПутевогоЛиста.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

    // Движения по учету ГСМ.
	Если ВидТаксировки <> Перечисления.ВидыТаксировкиДокументовУчетаГСМ.СводныйРасчетРасходаГСМПоТаксировкам Тогда
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "РасходГСМ");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ЗаправкиГСМПоТопливнымКартам");
	КонецЕсли;

	ИзменениеСтатусаОбработкиЭлектронногоПутевогоЛиста();	
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ЭтотОбъект.ДатаПутевогоЛиста = Дата(1,1,1);
	ЭтотОбъект.СрокДействия = Дата(1,1,1);
	ЭтотОбъект.НомерПутевогоЛиста = "";
	ЭтотОбъект.ПутевойЛист = Неопределено;
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	МассивНепроверяемыхРеквизитов = Новый Массив();
	
	Если СрокДействия < ДатаПутевогоЛиста Тогда
		ТекстСообщения = НСтр("ru='Срок действия путевого листа меньше даты путевого листа!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.СрокДействия");
	КонецЕсли;
	
	Для каждого ТекСтрока Из ДанныеМаршрута Цикл
		ИмяСписка = НСтр("ru = 'Маршруты транспортного средства'");
		Префикс = "ДанныеМаршрута[" + Формат(ТекСтрока.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].";
		Если НЕ ТекСтрока.РаботаБезПробега Тогда
			Если ТекСтрока.Пробег = 0 Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Пробег для расчета (км)'"),
					ТекСтрока.НомерСтроки, ИмяСписка);
				Поле = Префикс + "Пробег";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ПризнакиУчетаСчетов105ГСМ = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("105.23,105.33", , Дата);
	
	Для каждого СтрокаТаблицы Из Материалы Цикл
		Префикс = "Материалы[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].";
		ИмяСписка = НСтр("ru = 'Списываемые материалы ГСМ'");
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Номенклатура'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "Номенклатура";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.КФО) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'КФО'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "КФО";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.КПС) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'КПС'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "КПС";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если ИспользоватьУчетПоПодразделениям И ПризнакиУчетаСчетов105ГСМ.УчетПоПодразделениям И НЕ ПризнакиУчетаСчетов105ГСМ.РазрешитьНеУказыватьПодразделение
			И НЕ ЗначениеЗаполнено(СтрокаТаблицы.Подразделение) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Подразделение'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "Подразделение";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетУчета) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Счет учета'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "СчетУчета";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ЦМО) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'МОЛ/Место хранения'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "ЦМО";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетДт) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Дебет'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "СчетДт";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если НЕ (СтрокаТаблицы.Количество > 0) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Количество'"),
				СтрокаТаблицы.НомерСтроки, ИмяСписка);
			Поле = Префикс + "Количество";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект", Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВидТаксировки = Перечисления.ВидыТаксировкиДокументовУчетаГСМ.СводныйРасчетРасходаГСМПоТаксировкам Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ТранспортноеСредство");
		МассивНепроверяемыхРеквизитов.Добавить("МОЛ");
	КонецЕсли;	
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоПутевомуЛисту(ДокументОснование)
	ЗаполняемыеДанные = "Организация, СерияПутевогоЛиста, ТранспортноеСредство, Водитель";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	
	ЭтотОбъект.МОЛ = ДокументОснование.Водитель;
	ЭтотОбъект.СерияПутевогоЛиста = ДокументОснование.СерияПутевогоЛиста;
	ЭтотОбъект.ДатаПутевогоЛиста = ДокументОснование.Дата;
	ЭтотОбъект.НомерПутевогоЛиста = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументОснование.Ссылка,ДокументОснование.Номер);
	ЭтотОбъект.СрокДействия = ДокументОснование.СрокДействия;
	ЭтотОбъект.ПутевойЛист = ДокументОснование;
	ЭтотОбъект.НомерСмены = ДокументОснование.НомерСмены;
	ЭтотОбъект.РегистрационныйНомернойЗнак = ДокументОснование.РегистрационныйНомернойЗнак;
	ЭтотОбъект.ГаражныйНомер = ДокументОснование.ГаражныйНомер;
КонецПроцедуры

Процедура ЗаполнитьПоказанияСпидометраПоПутевомуЛисту(ДокументОснование)
	ЭтотОбъект.ПоказанияСпидометраПриВыезде = ДокументОснование.ПоказанияСпидометраПриВыезде;
КонецПроцедуры

Процедура ЗаполнитьРегистрационныйИГаражныйНомераДляСводнойТаксировки()
	ЭтотОбъект.ТранспортноеСредство = "";
	ЭтотОбъект.РегистрационныйНомернойЗнак = "";
	ЭтотОбъект.ГаражныйНомер = "";
	ЭтотОбъект.НомерСмены = 0;
	
	ТаблицаТаксировок = ЭтотОбъект.ТаксировкиПутевыхЛистов.Выгрузить();
	ТаблицаТаксировок.Колонки.Добавить("ОС", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	Для каждого ТекСтрока Из ТаблицаТаксировок Цикл
		ТекСтрока.ОС = ТекСтрока.ТаксировкаПутевогоЛиста.ТранспортноеСредство;
	КонецЦикла;	
	ТаблицаТаксировок.Свернуть("ОС");
	
	Если ТаблицаТаксировок.Количество()=1 Тогда
		ОС = ТаблицаТаксировок[0].ОС;
		Если ЗначениеЗаполнено(ОС) Тогда
			ПТС = УчетГСМ.ПолучитьПаспортТранспортногоСредства(ОС, Дата);
			
			ЭтотОбъект.ТранспортноеСредство = ОС;
			ЭтотОбъект.РегистрационныйНомернойЗнак = ПТС.РегистрационныйЗнак; 
			ЭтотОбъект.ГаражныйНомер = ПТС.ГаражныйНомер;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	

Процедура УдалитьЗаправкиДляОтсутствующихВидовГСМ()
	ВидыГСМИзРасчета = ФактическийРасходГСМ.Выгрузить();
	ВидыГСМИзРасчета.Свернуть("ВидГСМ", "ОстатокГорючегоПриВыезде, ВыданоГорючее, ОстатокГорючегоПриВозвращении");
	
	СтараяТаблицаЗаправок = ЗаправкиГСМ.Выгрузить();
	ЗаправкиГСМ.Очистить();
	
	Для Каждого ТекСтрока Из СтараяТаблицаЗаправок Цикл
		ВидГСМ = ТекСтрока.ВидГСМ;
		ПараметрыПоискаСтрок = Новый Структура;
		ПараметрыПоискаСтрок.Вставить("ВидГСМ", ВидГСМ);
		НайденныеСтроки = ВидыГСМИзРасчета.НайтиСтроки(ПараметрыПоискаСтрок);
		Если НайденныеСтроки.Количество() > 0 Тогда
			НоваяСтрока = ЗаправкиГСМ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры	

