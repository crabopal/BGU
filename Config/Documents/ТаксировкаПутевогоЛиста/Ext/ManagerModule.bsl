// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// СтандартныеПодсистемы.Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ТаксировкаПутевогоЛиста";
	КомандаПечати.Идентификатор		= "АктОСписанииМЗ0510460_157н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о списании МЗ'"), "0510460", "61н", "157н");
	КомандаПечати.Порядок			= 1;
	ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(КомандаПечати, "СписаниеМатериаловАктомСписанияМЗ", Ложь);
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ТаксировкаПутевогоЛиста";
	КомандаПечати.Идентификатор		= "АктСписанияМЗ0504230_103н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Акт о списании МЗ'"), "0504230", "52н", "103н", Истина);
	КомандаПечати.Порядок			= 2;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ТаксировкаПутевогоЛиста";
	КомандаПечати.Идентификатор		= "АктСписанияМЗ0504230_52н";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Акт о списании МЗ'"), "0504230", "52н", , Истина);
	КомандаПечати.Порядок			= 3;
	ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати);
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ТаксировкаПутевогоЛиста";
	КомандаПечати.Идентификатор		= "ПФ_MXL_СправкаРасчетКПутевомуЛисту";
	КомандаПечати.Представление		= НСтр("ru = 'Справка-расчет расхода ГСМ'");
	КомандаПечати.Порядок			= 4;
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "АктОСписанииМЗ0510460_157н");
	Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = УправлениеПечатьюБГУ.НапечататьАктОСписанииМЗ0510460(МассивОбъектов,
			ОбъектыПечати,
			ДанныеДляПечатиАктаОСписанииМЗ0510460(МассивОбъектов));
		ПечатнаяФорма.СинонимМакета = УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Акт о списании МЗ'"), "0510460", "61н", "157н");
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСписанияМЗ0504230_103н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"АктСписанияМЗ0504230_103н",
		"Списание материалов",
		ПечатьАкта230(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияМЗ0504230_103н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСписанияМЗ0504230_52н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"АктСписанияМЗ0504230_52н",
		"Списание материалов",
		ПечатьАкта230(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_АктСписанияМЗ0504230_52н"));
	
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_СправкаРасчетКПутевомуЛисту") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_СправкаРасчетКПутевомуЛисту", "Справка-расчет расхода ГСМ", ПечатьСправкиРасчета(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

// Конец СтандартныеПодсистемы.Печать


// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
	
#Область ПечатьДокумента

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьСправкиРасчета(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_СправкаРасчетТаксировкиПутевогоЛиста";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ТаксировкаПутевогоЛиста.ПФ_MXL_СправкаРасчетКПутевомуЛисту");
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ТаксировкаПутевогоЛиста.Ссылка КАК Ссылка,
	|	ТаксировкаПутевогоЛиста.Дата,
	|	ТаксировкаПутевогоЛиста.ВидТаксировки,
	|	ТаксировкаПутевогоЛиста.ПутевойЛист,
	|	ТаксировкаПутевогоЛиста.НомерПутевогоЛиста КАК НомерПутевогоЛиста,
	|	ТаксировкаПутевогоЛиста.ДатаПутевогоЛиста КАК ДатаПутевогоЛиста,
	|	ТаксировкаПутевогоЛиста.Организация,
	|	ТаксировкаПутевогоЛиста.ТранспортноеСредство,
	|	ВЫРАЗИТЬ(ТаксировкаПутевогоЛиста.ТранспортноеСредство КАК Справочник.ОсновныеСредства).НаименованиеПолное КАК НаименованиеТранспортногоСредства,
	|	ВЫРАЗИТЬ(ТаксировкаПутевогоЛиста.Организация КАК Справочник.Организации).НаименованиеПолное КАК НаименованиеОрганизации,
	|	ТаксировкаПутевогоЛиста.СерияПутевогоЛиста КАК СерияПутевогоЛиста,
	|	ТаксировкаПутевогоЛиста.РасчетПроизвел,
	|	ТаксировкаПутевогоЛиста.ПробегОбщий,
	|	ТаксировкаПутевогоЛиста.СрокДействия,
	|	ТаксировкаПутевогоЛиста.НормыРасхода.(
	|		Ссылка,
	|		НомерСтроки,
	|		НаименованиеНормы,
	|		Норма,
	|		Значение,
	|		ЕдиницаИзмерения,
	|		Параметр,
	|		ЗначениеПараметра,
	|		ЕдиницаИзмеренияПараметра,
	|		КлючСтроки
	|	),
	|	ТаксировкаПутевогоЛиста.ПоправочныеЗначения.(
	|		Ссылка,
	|		НомерСтроки,
	|		НаименованиеЗначения,
	|		ПоправочноеЗначение,
	|		Значение,
	|		ЕдиницаИзмерения,
	|		КлючСтроки,
	|		ЗначениеОсновногоПараметраРасчета,
	|		ЕдиницаИзмеренияПараметра
	|	),
	|	ТаксировкаПутевогоЛиста.ПоправочныеКоэффициенты.(
	|		Ссылка,
	|		НомерСтроки,
	|		НаименованиеКоэффициента,
	|		ПоправочныйКоэффициент,
	|		Значение,
	|		КлючСтроки
	|	),
	|	ТаксировкаПутевогоЛиста.ДанныеМаршрута.(
	|		Ссылка,
	|		НомерСтроки,
	|		КлючСтроки,
	|		Пробег,
	|		ВидГСМ,
	|		РасшифровкаРасчетаНормативногоРасходаГСМ,
	|		НормативРасходаГСМ,
	|		ЕдиницаИзмерения,
	|		Примечание
	|	),
	|	ТаксировкаПутевогоЛиста.ФактическийРасходГСМ.(
	|		Ссылка,
	|		НомерСтроки,
	|		ВидГСМ,
	|		ЕдиницаИзмерения,
	|		ОстатокГорючегоПриВыезде,
	|		ВыданоГорючее,
	|		ОстатокГорючегоПриВозвращении,
	|		ФактическийРасходГорючего,
	|		НормативныйРасходГорючего,
	|		Экономия,
	|		Перерасход,
	|		Примечание
	|	),
	|	ТаксировкаПутевогоЛиста.НормативныйРасходСМ.(
	|		Ссылка,
	|		НомерСтроки,
	|		НомерМаршрута,
	|		ВидГСМ,
	|		ВидСМ,
	|		РасшифровкаРасчетаСМ,
	|		ЗначениеРасходаСМ,
	|		КлючСтроки,
	|		ЕдиницаИзмерения
	|	),
	|	ТаксировкаПутевогоЛиста.ЗаправкиГСМ.(
	|		Ссылка,
	|		НомерСтроки,
	|		ДатаЗаправки,
	|		НомерДокументаОснования,
	|		ВидГСМ,
	|		ЕдиницаИзмерения,
	|		Количество,
	|		Сумма,
	|		ТопливнаяКарта,
	|		СерияТопливнойКарты,
	|		НомерТопливнойКарты,
	|		ТалонНаТопливо,
	|		КоличествоТалонов,
	|		Контрагент
	|	),
	|	ТаксировкаПутевогоЛиста.ТаксировкиПутевыхЛистов.(
	|		Ссылка,
	|		НомерСтроки,
	|		ТаксировкаПутевогоЛиста
	|	)
	|ИЗ
	|	Документ.ТаксировкаПутевогоЛиста КАК ТаксировкаПутевогоЛиста
	|ГДЕ
	|	ТаксировкаПутевогоЛиста.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПутевогоЛиста,
	|	НомерПутевогоЛиста,
	|	СерияПутевогоЛиста";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДокументов = Результат.Выбрать();

	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПФ_MXL_СправкаРасчетКПутевомуЛисту";
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СводныйРасчет = Ложь;
		Если ВыборкаДокументов.ВидТаксировки = Перечисления.ВидыТаксировкиДокументовУчетаГСМ.СводныйРасчетРасходаГСМПоТаксировкам Тогда
			СводныйРасчет = Истина;
		КонецЕсли;
		
		ЗаправкиТК = Новый ТаблицаЗначений;
		ЗаправкиТК.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		ЗаправкиТК.Колонки.Добавить("Карта", Новый ОписаниеТипов("Строка"));
		ЗаправкиТК.Колонки.Добавить("ВидГСМ", Новый ОписаниеТипов("СправочникСсылка.ВидыГСМ"));
		ЗаправкиТК.Колонки.Добавить("Количество",  Новый ОписаниеТипов("Число"));
		ЗаправкиТК.Колонки.Добавить("Сумма",  Новый ОписаниеТипов("Число"));
		
		ЗаправкиТТ = Новый ТаблицаЗначений;
		ЗаправкиТТ.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		ЗаправкиТТ.Колонки.Добавить("ВидГСМ", Новый ОписаниеТипов("СправочникСсылка.ВидыГСМ"));
		ЗаправкиТТ.Колонки.Добавить("Количество",  Новый ОписаниеТипов("Число"));
		ЗаправкиТТ.Колонки.Добавить("Сумма",  Новый ОписаниеТипов("Число"));
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;

		ПервыйДокумент = Ложь;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, ВыборкаДокументов[Колонка.Имя]);	
		КонецЦикла;
		
		Если СводныйРасчет Тогда
			СтруктураДанных.Вставить("ДатаСоставления", 	Формат(ВыборкаДокументов.Дата,"ДЛФ=Д"));	
			
			Область = Макет.ПолучитьОбласть("ЗаголовокСводнойСправки");
			Область.Параметры.Заполнить(СтруктураДанных);
			
			ТабличныйДокумент.Вывести(Область);
			
			//Сводный список путевых листов
			Область = Макет.ПолучитьОбласть("ЗаголовокСпискаЛистов");
			ТабличныйДокумент.Вывести(Область);
			
			Область = Макет.ПолучитьОбласть("СтрокаСпискаЛистов");
			ВыборкаЛистовСводная = ВыборкаДокументов.ТаксировкиПутевыхЛистов.Выбрать();
			Пока ВыборкаЛистовСводная.Следующий() Цикл
				
				ТаксировкаЛиста = ВыборкаЛистовСводная.ТаксировкаПутевогоЛиста;
		    	ГосНомерЗнак = УчетГСМ.ПолучитьГосударственныйНомернойЗнакТС(ТаксировкаЛиста.ТранспортноеСредство);	
		    	ГаражныйНомер =	УчетГСМ.ПолучитьГаражныйНомерТС(ТаксировкаЛиста.ТранспортноеСредство);
				
				СтруктураДанныхСтроки = Новый Структура;
				СтруктураДанныхСтроки.Вставить("НомПП", 	ВыборкаЛистовСводная.НомерСтроки);
				СтруктураДанныхСтроки.Вставить("ДатаЛиста", 	Формат(ТаксировкаЛиста.ДатаПутевогоЛиста,"ДФ=dd.MM.yyyy"));
				СтруктураДанныхСтроки.Вставить("СерияЛиста", 	ТаксировкаЛиста.СерияПутевогоЛиста);
				СтруктураДанныхСтроки.Вставить("НомерЛиста", 	ТаксировкаЛиста.НомерПутевогоЛиста);
				СтруктураДанныхСтроки.Вставить("ОсновноеСредство", 	ТаксировкаЛиста.ТранспортноеСредство);
				СтруктураДанныхСтроки.Вставить("ГосНомер", 	ГосНомерЗнак);
				СтруктураДанныхСтроки.Вставить("ГаражныйНомер", 	ГаражныйНомер);
				СтруктураДанныхСтроки.Вставить("МОЛ", 	ТаксировкаЛиста.МОЛ);
				
				Область.Параметры.Заполнить(СтруктураДанныхСтроки);
				
				ТабличныйДокумент.Вывести(Область);
			КонецЦикла;	
			
			//итоги расхода
			Область = Макет.ПолучитьОбласть("ИтогиСводногоФактическогоРасхода");
			ТабличныйДокумент.Вывести(Область);
		Иначе
			//---изменение представления данных в печатной форме----------------
			
			СтруктураДанных.Вставить("ДатаСоставления", 	Формат(ВыборкаДокументов.Дата,"ДЛФ=Д"));	
			
			Если ЗначениеЗаполнено(ВыборкаДокументов.ПутевойЛист) Тогда
				Если ТипЗнч(ВыборкаДокументов.ПутевойЛист) = Тип("ДокументСсылка.ЭлектронныйПутевойЛист") Тогда
					СтруктураДанныхПутевогоЛиста = УчетГСМ.ПолучитьДанныеЭлектронногоПутевогоЛиста(ВыборкаДокументов.ПутевойЛист, ВыборкаДокументов.Ссылка);
				Иначе	
					СтруктураДанныхПутевогоЛиста = УчетГСМ.ПолучитьДанныеПутевогоЛиста(ВыборкаДокументов.ПутевойЛист);
				КонецЕсли;	
				ГосНомерЗнак = СокрЛП(СтруктураДанныхПутевогоЛиста.РегистрационныйНомернойЗнак);
				ГаражныйНомер = СокрЛП(СтруктураДанныхПутевогоЛиста.ГаражныйНомер);
				Если НЕ ЗначениеЗаполнено(ГосНомерЗнак) Тогда
					ГосНомерЗнак = УчетГСМ.ПолучитьГосударственныйНомернойЗнакТС(ВыборкаДокументов.ТранспортноеСредство);
				Конецесли;	
				Если НЕ ЗначениеЗаполнено(ГаражныйНомер) Тогда
					ГаражныйНомер = УчетГСМ.ПолучитьГаражныйНомерТС(ВыборкаДокументов.ТранспортноеСредство);
				Конецесли;	
			Иначе
		    	ГосНомерЗнак = УчетГСМ.ПолучитьГосударственныйНомернойЗнакТС(ВыборкаДокументов.ТранспортноеСредство);	
		    	ГаражныйНомер =	УчетГСМ.ПолучитьГаражныйНомерТС(ВыборкаДокументов.ТранспортноеСредство);
			КонецЕсли;	
			
			СтруктураДанных.Вставить("ГосНомерЗнак", 	ГосНомерЗнак);	
	  		СтруктураДанных.Вставить("ГаражныйНомер", 	ГаражныйНомер);	
			
			СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(СтруктураДанных.ДатаПутевогоЛиста);
	    	СтруктураДанных.Вставить("ЧислоДаты", 	СтруктураДаты.Число);	
	    	СтруктураДанных.Вставить("МесяцДаты", 	СтруктураДаты.Месяц);
			СтруктураДанных.Вставить("ГодДаты", 	СтруктураДаты.Год);
			
			СтруктураДанных.Вставить("ОтСрокДействияПутевогоЛиста", 	УчетГСМ.СрокДействияПутевогоЛиста(СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия, Истина));
			
			//вывод областей табличного документа
			Область = Макет.ПолучитьОбласть("Заголовок");
			Область.Параметры.Заполнить(СтруктураДанных);
			РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(Область, "НомерПутевогоЛиста", СтруктураДанных.НомерПутевогоЛиста, СтруктураДанных.Ссылка, Неопределено, Истина);
			
			ТабличныйДокумент.Вывести(Область);
			
			//Маршруты и расчет нормативного расхода (топливо)
			Область = Макет.ПолучитьОбласть("ЗаголовокНормативногоРасхода");
			ДанныеФормулы = УчетГСМ.ПолучитьФормулуДляТС();
			Область.Параметры.ФормулаРасчета = ДанныеФормулы.Формула+Символы.ПС+ДанныеФормулы.Пояснение;
			ТабличныйДокумент.Вывести(Область);
			
			ВыборкаМаршрутов = ВыборкаДокументов.ДанныеМаршрута.Выбрать();
			Пока ВыборкаМаршрутов.Следующий() Цикл
				ВыборкаНорм = ВыборкаДокументов.НормыРасхода.Выбрать();
				ВыборкаПоправочныхЗначений = ВыборкаДокументов.ПоправочныеЗначения.Выбрать();
				ВыборкаПоправочныхКоэффициентов = ВыборкаДокументов.ПоправочныеКоэффициенты.Выбрать();
			
				СтруктураДанныхСтроки = Новый Структура;
				СтруктураДанныхСтроки.Вставить("НомерМаршрута", 	ВыборкаМаршрутов.НомерСтроки);
				СтруктураДанныхСтроки.Вставить("ПробегМаршрута", 	ВыборкаМаршрутов.Пробег);
				СтруктураДанныхСтроки.Вставить("ВидГСМ", 	ВыборкаМаршрутов.ВидГСМ);
				СтруктураДанныхСтроки.Вставить("ЕдИзм", 	ВыборкаМаршрутов.ЕдиницаИзмерения);
				СтруктураДанныхСтроки.Вставить("ИсходныеДанныеРасчета", 	ПолучитьИсходныеДанныеПоКлючу(ВыборкаМаршрутов.ВидГСМ, ВыборкаНорм,ВыборкаПоправочныхЗначений,ВыборкаПоправочныхКоэффициентов,ВыборкаМаршрутов.КлючСтроки));
				СтруктураДанныхСтроки.Вставить("РасшифровкаРасчета", 	ВыборкаМаршрутов.РасшифровкаРасчетаНормативногоРасходаГСМ);
				СтруктураДанныхСтроки.Вставить("РезультатНорма", 	ВыборкаМаршрутов.НормативРасходаГСМ);
				СтруктураДанныхСтроки.Вставить("Примечание", 	ВыборкаМаршрутов.Примечание);

				Область = Макет.ПолучитьОбласть("СтрокаНормативногоРасхода");
				Область.Параметры.Заполнить(СтруктураДанныхСтроки);
				
				ТабличныйДокумент.Вывести(Область);
				
			КонецЦикла;
			
			//Маршруты и расчет нормативного расхода (смазочные материалы и специальные жидкости)
			ВыборкаРасходаСМ = ВыборкаДокументов.НормативныйРасходСМ.Выбрать();
			КоличествоСтрокСМ = ВыборкаДокументов.НормативныйРасходСМ.Выгрузить().Количество();
			
			Если КоличествоСтрокСМ > 0 Тогда
				Область = Макет.ПолучитьОбласть("ЗаголовокНормативногоРасходаСМ");
				ДанныеФормулы = УчетГСМ.ПолучитьФормулуДляСМ();
				Область.Параметры.ФормулаРасчета = ДанныеФормулы.Формула+Символы.ПС+ДанныеФормулы.Пояснение;
				ТабличныйДокумент.Вывести(Область);
				
				Пока ВыборкаРасходаСМ.Следующий() Цикл
					ВыборкаМаршрутов = ВыборкаДокументов.ДанныеМаршрута.Выбрать();
					
					ВыборкаНорм = ВыборкаДокументов.НормыРасхода.Выбрать();
					ВыборкаПоправочныхЗначений = ВыборкаДокументов.ПоправочныеЗначения.Выбрать();
					ВыборкаПоправочныхКоэффициентов = ВыборкаДокументов.ПоправочныеКоэффициенты.Выбрать();
				
					СтруктураДанныхСтроки = Новый Структура;
					СтруктураДанныхСтроки.Вставить("НомерМаршрута", 	ВыборкаРасходаСМ.НомерСтроки);
					СтруктураДанныхСтроки.Вставить("РасходТоплива", 	ПолучитьНормативныйРасходМаршрутаПоКлючу(ВыборкаМаршрутов, ВыборкаРасходаСМ.КлючСтроки));
					СтруктураДанныхСтроки.Вставить("ВидГСМ", 	ВыборкаРасходаСМ.ВидСМ);
					СтруктураДанныхСтроки.Вставить("ЕдИзм", 	ВыборкаРасходаСМ.ЕдиницаИзмерения);
					СтруктураДанныхСтроки.Вставить("ИсходныеДанныеРасчета", 	ПолучитьИсходныеДанныеПоКлючу(ВыборкаРасходаСМ.ВидСМ, ВыборкаНорм,ВыборкаПоправочныхЗначений,ВыборкаПоправочныхКоэффициентов, ВыборкаРасходаСМ.КлючСтроки, Ложь));
					СтруктураДанныхСтроки.Вставить("РасшифровкаРасчета", 	ВыборкаРасходаСМ.РасшифровкаРасчетаСМ);
					СтруктураДанныхСтроки.Вставить("РезультатНорма", 	ВыборкаРасходаСМ.ЗначениеРасходаСМ);
					СтруктураДанныхСтроки.Вставить("Примечание", 	"");

					Область = Макет.ПолучитьОбласть("СтрокаНормативногоРасходаСМ");
					Область.Параметры.Заполнить(СтруктураДанныхСтроки);
					
					ТабличныйДокумент.Вывести(Область);
				КонецЦикла;
			КонецЕсли;
			
			//Расчет фактического расхода
			Область = Макет.ПолучитьОбласть("ЗаголовокФактическогоРасхода");
			ТабличныйДокумент.Вывести(Область);
			
			Область = Макет.ПолучитьОбласть("СтрокаФактическогоРасхода");
			ВыборкаФактическогоРасхода = ВыборкаДокументов.ФактическийРасходГСМ.Выбрать();
			Пока ВыборкаФактическогоРасхода.Следующий() Цикл
				СтруктураДанныхСтроки = Новый Структура;
				СтруктураДанныхСтроки.Вставить("НомПП", 	ВыборкаФактическогоРасхода.НомерСтроки);
				СтруктураДанныхСтроки.Вставить("ВидГСМ", 	ВыборкаФактическогоРасхода.ВидГСМ);
				СтруктураДанныхСтроки.Вставить("ЕдИзм", 	ВыборкаФактическогоРасхода.ЕдиницаИзмерения);
				СтруктураДанныхСтроки.Вставить("ОстатокПриВыезде", 	ВыборкаФактическогоРасхода.ОстатокГорючегоПриВыезде);
				СтруктураДанныхСтроки.Вставить("ЗаправленоПолучено", 	ВыборкаФактическогоРасхода.ВыданоГорючее);
				СтруктураДанныхСтроки.Вставить("ОстатокПриВозвращении", 	ВыборкаФактическогоРасхода.ОстатокГорючегоПриВозвращении);
				СтруктураДанныхСтроки.Вставить("РезультатФакт", 	ВыборкаФактическогоРасхода.ФактическийРасходГорючего);
				СтруктураДанныхСтроки.Вставить("Примечание", 	ВыборкаФактическогоРасхода.Примечание);

				Область.Параметры.Заполнить(СтруктураДанныхСтроки);
				
				ТабличныйДокумент.Вывести(Область);
			КонецЦикла;
			
			//итоги расхода
			Область = Макет.ПолучитьОбласть("ИтогиФактическогоРасхода");
			Область.Параметры.ОбщийПробег = ВыборкаДокументов.ПробегОбщий; 
			ТабличныйДокумент.Вывести(Область);
		КонецЕсли;
		
		Область = Макет.ПолучитьОбласть("ЗаголовокРасхода");
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("СтрокаРасхода");
		ВыборкаИтогиРасхода = ВыборкаДокументов.ФактическийРасходГСМ.Выбрать();
		Пока ВыборкаИтогиРасхода.Следующий() Цикл
			СтруктураДанныхСтроки = Новый Структура;
			СтруктураДанныхСтроки.Вставить("НомПП", 	ВыборкаИтогиРасхода.НомерСтроки);
			СтруктураДанныхСтроки.Вставить("ВидГСМ", 	ВыборкаИтогиРасхода.ВидГСМ);
			СтруктураДанныхСтроки.Вставить("ЕдИзм", 	ВыборкаИтогиРасхода.ЕдиницаИзмерения);
			СтруктураДанныхСтроки.Вставить("РасходПоНормам", 	ВыборкаИтогиРасхода.НормативныйРасходГорючего);
			СтруктураДанныхСтроки.Вставить("ФактическийРасход", 	ВыборкаИтогиРасхода.ФактическийРасходГорючего);
			СтруктураДанныхСтроки.Вставить("Экономия", 	ВыборкаИтогиРасхода.Экономия);
			СтруктураДанныхСтроки.Вставить("Перерасход", 	ВыборкаИтогиРасхода.Перерасход);
			
			Область.Параметры.Заполнить(СтруктураДанныхСтроки);
			
			ТабличныйДокумент.Вывести(Область);
		КонецЦикла;	
		
		//Заправки топливными картами и талонами
		ЕстьЗаправкиТопливнымиКартами = Ложь;
		ЕстьЗаправкиТалоныНаТопливо = Ложь;
		КоличествоСтрокТК = 0;
		КоличествоСтрокТТ = 0;
		
		//ТК
		ВыборкаЗаправки = ВыборкаДокументов.ЗаправкиГСМ.Выбрать();
		Пока ВыборкаЗаправки.Следующий() Цикл
			СтруктураДанныхСтроки = Новый Структура;
			СтруктураДанныхСтроки.Вставить("ВидГСМ", 	ВыборкаЗаправки.ВидГСМ);
			СтруктураДанныхСтроки.Вставить("ЕдИзм", 	ВыборкаЗаправки.ЕдиницаИзмерения);
			СтруктураДанныхСтроки.Вставить("НомерЧека", 	ВыборкаЗаправки.НомерДокументаОснования);
			СтруктураДанныхСтроки.Вставить("ДатаЗаправки", 	Формат(ВыборкаЗаправки.ДатаЗаправки, "ДФ=dd.MM.yyyy"));
			СтруктураДанныхСтроки.Вставить("Сумма", 	ВыборкаЗаправки.Сумма);
			СтруктураДанныхСтроки.Вставить("Заправлено", 	ВыборкаЗаправки.Количество);
			Если ЗначениеЗаполнено(ВыборкаЗаправки.Контрагент) Тогда
				Контрагент = ВыборкаЗаправки.Контрагент;
				Если ЗначениеЗаполнено(Контрагент.НаименованиеСокращенное) Тогда
					СтруктураДанныхСтроки.Вставить("Поставщик", 	Контрагент.НаименованиеСокращенное);
				Иначе
					СтруктураДанныхСтроки.Вставить("Поставщик", 	Контрагент.Наименование);
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ВыборкаЗаправки.ТалонНаТопливо) Тогда
				Область = Макет.ПолучитьОбласть("СтрокаТК");
				Если НЕ ЕстьЗаправкиТопливнымиКартами Тогда
					
					ОбластьЗаголовкаЗаправки = Макет.ПолучитьОбласть("ЗаголовокТК");
					ТабличныйДокумент.Вывести(ОбластьЗаголовкаЗаправки);
					
					ЕстьЗаправкиТопливнымиКартами = Истина;
				КонецЕсли;	
				
				КоличествоСтрокТК = КоличествоСтрокТК + 1;
				СтруктураДанныхСтроки.Вставить("НомПП", 	КоличествоСтрокТК);
				НаименованиеТК = Строка(ВыборкаЗаправки.ТопливнаяКарта)+?(ЗначениеЗаполнено(ВыборкаЗаправки.СерияТопливнойКарты)," ","")+СокрЛП(ВыборкаЗаправки.СерияТопливнойКарты)+НСтр("ru = ' № '")+СокрЛП(ВыборкаЗаправки.НомерТопливнойКарты);
				СтруктураДанныхСтроки.Вставить("Карта", 	НаименованиеТК);
				
				НоваяСтрока = ЗаправкиТК.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаЗаправки);
				НоваяСтрока.Карта = НаименованиеТК;
				
				Область.Параметры.Заполнить(СтруктураДанныхСтроки);
				ТабличныйДокумент.Вывести(Область);
			КонецЕсли;
			
		КонецЦикла;	
		
		//ТТ
		ВыборкаЗаправки = ВыборкаДокументов.ЗаправкиГСМ.Выбрать();
		Пока ВыборкаЗаправки.Следующий() Цикл
			СтруктураДанныхСтроки = Новый Структура;
			СтруктураДанныхСтроки.Вставить("ВидГСМ", 	ВыборкаЗаправки.ВидГСМ);
			СтруктураДанныхСтроки.Вставить("ЕдИзм", 	ВыборкаЗаправки.ЕдиницаИзмерения);
			СтруктураДанныхСтроки.Вставить("НомерЧека", 	ВыборкаЗаправки.НомерДокументаОснования);
			СтруктураДанныхСтроки.Вставить("ДатаЗаправки", 	Формат(ВыборкаЗаправки.ДатаЗаправки, "ДФ=dd.MM.yyyy"));
			СтруктураДанныхСтроки.Вставить("Сумма", 	ВыборкаЗаправки.Сумма);
			СтруктураДанныхСтроки.Вставить("Заправлено", 	ВыборкаЗаправки.Количество);
			Если ЗначениеЗаполнено(ВыборкаЗаправки.Контрагент) Тогда
				Контрагент = ВыборкаЗаправки.Контрагент;
				Если ЗначениеЗаполнено(Контрагент.НаименованиеСокращенное) Тогда
					СтруктураДанныхСтроки.Вставить("Поставщик", 	Контрагент.НаименованиеСокращенное);
				Иначе
					СтруктураДанныхСтроки.Вставить("Поставщик", 	Контрагент.Наименование);
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаЗаправки.ТалонНаТопливо) Тогда
				Область = Макет.ПолучитьОбласть("СтрокаТТ");
				Если НЕ ЕстьЗаправкиТалоныНаТопливо Тогда
					
					ОбластьЗаголовкаЗаправки = Макет.ПолучитьОбласть("ЗаголовокТТ");
					ТабличныйДокумент.Вывести(ОбластьЗаголовкаЗаправки);
					
					ЕстьЗаправкиТалоныНаТопливо = Истина;
				КонецЕсли;	
				
				КоличествоСтрокТТ = КоличествоСтрокТТ + 1;
				
				СтруктураДанныхСтроки.Вставить("НомПП", 	КоличествоСтрокТТ);
				КоличествоТалоновСтр = "";
				Если ВыборкаЗаправки.Количество>1 Тогда
					КоличествоТалоновСтр = НСтр("ru = ' ('")+СокрЛП(ВыборкаЗаправки.Количество)+НСтр("ru = ' шт.)'");
				КонецЕсли;	
				
				НаименованиеТТ = Строка(ВыборкаЗаправки.ТалонНаТопливо)+?(ЗначениеЗаполнено(ВыборкаЗаправки.ТалонНаТопливо.Серия)," ","")+СокрЛП(ВыборкаЗаправки.ТалонНаТопливо.Серия)+НСтр("ru = ' № '")+СокрЛП(ВыборкаЗаправки.ТалонНаТопливо.Номер)+КоличествоТалоновСтр;
				СтруктураДанныхСтроки.Вставить("Талон", 	НаименованиеТТ);
				
				НоваяСтрока = ЗаправкиТТ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаЗаправки);
				
				Область.Параметры.Заполнить(СтруктураДанныхСтроки);
				ТабличныйДокумент.Вывести(Область);
			КонецЕсли;
			
		КонецЦикла;	
		
		Если СводныйРасчет Тогда
			//Итоги по заправкам
			ЗаправкиТК.Свернуть("Контрагент, Карта, ВидГСМ", "Количество, Сумма");
			ЗаправкиТК.Сортировать("Контрагент, Карта, ВидГСМ");
			
			//Итоги по картам
			
			НомерСтроки = 0;
			Если ЗаправкиТК.Количество()>0 Тогда
				Область = Макет.ПолучитьОбласть("ИтогиЗаправкиТК");
				ТабличныйДокумент.Вывести(Область);
				Область = Макет.ПолучитьОбласть("ШапкаТаблицыИтоговЗаправкиТК");
				ТабличныйДокумент.Вывести(Область);
				
				Область = Макет.ПолучитьОбласть("СтрокаТаблицыИтоговЗаправкиТК");
				Для Каждого ТекСтрока Из ЗаправкиТК Цикл
					НомерСтроки = НомерСтроки + 1;
					
					СтруктураДанныхСтроки = Новый Структура;
					СтруктураДанныхСтроки.Вставить("НомПП", НомерСтроки);
					СтруктураДанныхСтроки.Вставить("Поставщик", ТекСтрока.Контрагент);
					СтруктураДанныхСтроки.Вставить("Карта", ТекСтрока.Карта);
					СтруктураДанныхСтроки.Вставить("ВидГСМ", 	ТекСтрока.ВидГСМ);
					СтруктураДанныхСтроки.Вставить("ЕдИзм", 	ТекСтрока.ВидГСМ.ЕдиницаИзмерения);
					СтруктураДанныхСтроки.Вставить("Сумма", 	ТекСтрока.Сумма);
					СтруктураДанныхСтроки.Вставить("Заправлено", 	ТекСтрока.Количество);
					
					Область.Параметры.Заполнить(СтруктураДанныхСтроки);
					ТабличныйДокумент.Вывести(Область);
				КонецЦикла;	
				
				Область = Макет.ПолучитьОбласть("ПустаяСтрока");
				ТабличныйДокумент.Вывести(Область);
			КонецЕсли;
			
			
			ЗаправкиТК.Свернуть("Контрагент, ВидГСМ", "Количество, Сумма");
			ЗаправкиТК.Сортировать("Контрагент, ВидГСМ");
			
			НомерСтроки = 0;
			Если ЗаправкиТК.Количество()>0 Тогда
				Область = Макет.ПолучитьОбласть("ШапкаТаблицыИтоговЗаправки");
				ТабличныйДокумент.Вывести(Область);
				
				Область = Макет.ПолучитьОбласть("СтрокаТаблицыИтоговЗаправки");
				Для Каждого ТекСтрока Из ЗаправкиТК Цикл
					НомерСтроки = НомерСтроки + 1;
					
					СтруктураДанныхСтроки = Новый Структура;
					СтруктураДанныхСтроки.Вставить("НомПП", НомерСтроки);
					СтруктураДанныхСтроки.Вставить("Поставщик", ТекСтрока.Контрагент);
					СтруктураДанныхСтроки.Вставить("ВидГСМ", 	ТекСтрока.ВидГСМ);
					СтруктураДанныхСтроки.Вставить("ЕдИзм", 	ТекСтрока.ВидГСМ.ЕдиницаИзмерения);
					СтруктураДанныхСтроки.Вставить("Сумма", 	ТекСтрока.Сумма);
					СтруктураДанныхСтроки.Вставить("Заправлено", 	ТекСтрока.Количество);
					
					Область.Параметры.Заполнить(СтруктураДанныхСтроки);
					ТабличныйДокумент.Вывести(Область);
				КонецЦикла;	
			КонецЕсли;
			
			ЗаправкиТТ.Свернуть("Контрагент, ВидГСМ", "Количество, Сумма");
			ЗаправкиТТ.Сортировать("Контрагент, ВидГСМ");
			
			НомерСтроки = 0;
			Если ЗаправкиТТ.Количество()>0 Тогда
				Область = Макет.ПолучитьОбласть("ИтогиЗаправкиТТ");
				ТабличныйДокумент.Вывести(Область);
				Область = Макет.ПолучитьОбласть("ШапкаТаблицыИтоговЗаправки");
				ТабличныйДокумент.Вывести(Область);
				
				Область = Макет.ПолучитьОбласть("СтрокаТаблицыИтоговЗаправки");
				Для Каждого ТекСтрока Из ЗаправкиТТ Цикл
					НомерСтроки = НомерСтроки + 1;
					
					СтруктураДанныхСтроки = Новый Структура;
					СтруктураДанныхСтроки.Вставить("НомПП", НомерСтроки);
					СтруктураДанныхСтроки.Вставить("Поставщик", ТекСтрока.Контрагент);
					СтруктураДанныхСтроки.Вставить("ВидГСМ", 	ТекСтрока.ВидГСМ);
					СтруктураДанныхСтроки.Вставить("ЕдИзм", 	ТекСтрока.ВидГСМ.ЕдиницаИзмерения);
					СтруктураДанныхСтроки.Вставить("Сумма", 	ТекСтрока.Сумма);
					СтруктураДанныхСтроки.Вставить("Заправлено", 	ТекСтрока.Количество);
					
					Область.Параметры.Заполнить(СтруктураДанныхСтроки);
					ТабличныйДокумент.Вывести(Область);
				КонецЦикла;	
			КонецЕсли;
		КонецЕсли;
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", СтруктураДанных.РасчетПроизвел, СтруктураДанных.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("Должность", ДанныеСотрудника.Должность);
		СтруктураДанных.Вставить("ФамилияИнициалы", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь));
		
		Область = Макет.ПолучитьОбласть("Подвал");
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);		
	КонецЦикла;	

	Возврат ТабличныйДокумент;
КонецФункции	

// Функция формирует табличный документ Акт списания материалов (ф.0504230)
