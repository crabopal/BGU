	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТаксировкаПутевогоЛистаМатериалы.Ссылка КАК Регистратор,
	|	ТаксировкаПутевогоЛистаМатериалы.Подразделение КАК Подразделение,
	|	ТаксировкаПутевогоЛистаМатериалы.ЦМО КАК ЦМО,
	|	ТаксировкаПутевогоЛистаМатериалы.Количество КАК Количество
	|ИЗ
	|	Документ.ТаксировкаПутевогоЛиста.Материалы КАК ТаксировкаПутевогоЛистаМатериалы
	|
	|УПОРЯДОЧИТЬ ПО
	|	Регистратор";
	
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДвиженияДокументов = РезультатЗапроса[2].Выгрузить();
	ДвиженияПоПодразделениюМОЛ = РезультатЗапроса[2].Выгрузить();
	Если ДвиженияПоПодразделениюМОЛ.Количество() = 0 Тогда
		ДвиженияПоПодразделениюМОЛ = РезультатЗапроса[4].Выгрузить();
	КонецЕсли;
	
	ДвиженияПоПодразделениюМОЛ.Колонки.Добавить("МОЛ");
	Для Каждого ТекДвижение Из ДвиженияПоПодразделениюМОЛ Цикл
		Если ЗначениеЗаполнено(ТекДвижение.ЦМО) Тогда
			Если ЗначениеЗаполнено(ТекДвижение.ЦМО) Тогда
				Если ЗначениеЗаполнено(ТекДвижение.ЦМО.Сотрудник) Тогда 
					ТекДвижение.МОЛ = ТекДвижение.ЦМО.Сотрудник.Контрагент;
				КонецЕсли;	
			Иначе
				ТекДвижение.МОЛ = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	ДвиженияПоПодразделениюМОЛ.Свернуть("Регистратор, Подразделение, МОЛ", "Количество");
	ВыборкаДокументы = РезультатЗапроса[3].Выбрать();
	
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.Автомасштаб = Истина;
	ТабДокумент.ПолеСлева  = 5;
	ТабДокумент.ПолеСправа = 0;
	ТабДокумент.ИмяПараметровПечати = "ПараметрыПечати_АктСписанияМЗ_0504230";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.АктСписанияМЗ." + ИмяМакета);
	
	ОбластьМакетаЗаголовок  = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакетаШапка      = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакетаСтрока     = Макет.ПолучитьОбласть("Строка");
	ОбластьМакетаИтого      = Макет.ПолучитьОбласть("Итого");
	ОбластьМакетаПодвал     = Макет.ПолучитьОбласть("Подвал");
	ОбластьМакетаКомиссия   = Макет.ПолучитьОбласть("Комиссия");
	ОбластьМакетаДата       = Макет.ПолучитьОбласть("Дата");
	
	ОбластьМакетаЗаключение1 = Макет.ПолучитьОбласть("Заключение1");
	ОбластьМакетаЗаключение2 = Макет.ПолучитьОбласть("Заключение2");
	
	ЕстьДопОбластиКомиссия = Макет.Области.Найти("Комиссия1") <> Неопределено;
	МассивДопОбластейКомиссия = Новый Массив;
	Если ЕстьДопОбластиКомиссия Тогда
		МассивДопОбластейКомиссия.Добавить(Макет.ПолучитьОбласть("Комиссия1"));
		МассивДопОбластейКомиссия.Добавить(Макет.ПолучитьОбласть("Комиссия2"));
		МассивДопОбластейКомиссия.Добавить(Макет.ПолучитьОбласть("Комиссия3"));
		МассивДопОбластейКомиссия.Добавить(Макет.ПолучитьОбласть("Комиссия4"));
		МассивДопОбластейКомиссия.Добавить(ОбластьМакетаКомиссия);
	Иначе
		МассивДопОбластейКомиссия.Добавить(ОбластьМакетаКомиссия);
	КонецЕсли;
	
	ПервыйДокумент = Истина;
	СтруктураОтбора = Новый Структура("Номенклатура, СчетКт, КПСКт, КФО, Подразделение, ЦМО, СчетДт, КПСДт, СубконтоДт1, СубконтоДт2, СубконтоДт3");
	
	Пока ВыборкаДокументы.Следующий() Цикл
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ДвиженияПоПодразделениюМОЛПоРегистратору = Новый ТаблицаЗначений;
		ДвиженияПоПодразделениюМОЛПоРегистратору.Колонки.Вставить(1, "Регистратор");
		ДвиженияПоПодразделениюМОЛПоРегистратору.Колонки.Вставить(2, "МОЛ");
		ДвиженияПоПодразделениюМОЛПоРегистратору.Колонки.Вставить(3, "Подразделение");
		
		СтрокиПоРегистратору = ДвиженияПоПодразделениюМОЛ.НайтиСтроки(Новый Структура("Регистратор", ВыборкаДокументы.Ссылка));
		Если СтрокиПоРегистратору.Количество() = 0 Тогда
			НоваяСтрока = ДвиженияПоПодразделениюМОЛПоРегистратору.Добавить();
			НоваяСтрока.Регистратор = ВыборкаДокументы.Ссылка;
			НоваяСтрока.МОЛ = Справочники.Контрагенты.ПустаяСсылка();
			НоваяСтрока.Подразделение = Справочники.Подразделения.ПустаяСсылка();
			НеУказанЦМО = Истина;
		Иначе
			ДвиженияПоПодразделениюМОЛПоРегистратору = ДвиженияПоПодразделениюМОЛ.Скопировать(СтрокиПоРегистратору, "Регистратор, МОЛ, Подразделение");
			НеУказанЦМО = Ложь;
		КонецЕсли;	
		
		ДокументИсправлениеОшибки = ИсправлениеОшибки(ВыборкаДокументы.Ссылка);
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ДанныеДиректора = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество",
			ВыборкаДокументы.ДиректорСсылка, ВыборкаДокументы.ТекстДата);
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеДиректора, Истина);
		
		НомерАкта = 1;
		Для Каждого ТекЗаголовок Из ДвиженияПоПодразделениюМОЛПоРегистратору Цикл
			Если НомерАкта > 1 Тогда	
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;	
			
			ДанныеЦМО = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество",
				ТекЗаголовок.МОЛ, ВыборкаДокументы.ТекстДата);
			Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеЦМО, Истина);
			
			ГлавныйБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
				Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер, ВыборкаДокументы.Организация,
				ВыборкаДокументы.ТекстДата, ТекЗаголовок.Подразделение);
			ДанныеГлБухгалтера = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество",
				ГлавныйБухгалтер.ОтветственноеЛицоСсылка, ВыборкаДокументы.ТекстДата);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеГлБухгалтера, Истина);
			ПараметрыОтметкиБухгалтерии = Новый Структура;
			ПараметрыОтметкиБухгалтерии.Вставить("Дата", Формат(ВыборкаДокументы.ТекстДата,"ДФ='MMMM yyyy'"));
			ПараметрыОтметкиБухгалтерии.Вставить("ФИОГлавныйБухгалтер",
				КорреспондентыКлиентСервер.ФИО(ДанныеГлБухгалтера));
			Для каждого ТекОбластьКомиссия Из МассивДопОбластейКомиссия Цикл
			
				ТекОбластьКомиссия.Параметры.Заполнить(ПараметрыОтметкиБухгалтерии);
			
			КонецЦикла;
			
			ОбластьМакетаЗаголовок.Параметры.Заполнить(ВыборкаДокументы);
			
			СтрокаКомиссия = "";
			ВыборкаКомиссия = ВыборкаДокументы.СоставКомиссии.Выбрать();
			ОбластьКомиссия = СформироватьОбластьКомиссия(
				ВыборкаДокументы, ВыборкаКомиссия, МассивДопОбластейКомиссия, 3, СтрокаКомиссия, Истина);
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Директор", 		КорреспондентыКлиентСервер.ФИО(ДанныеДиректора, Истина));
			СтруктураПараметров.Вставить("Подразделение",	ТекЗаголовок.Подразделение);
			СтруктураПараметров.Вставить("МОЛ", 			"" + ДанныеЦМО.Фамилия + " " + ДанныеЦМО.Имя + " "
															+ ДанныеЦМО.Отчество);
			СтруктураПараметров.Вставить("ДатаПриказа", 	?(ЗначениеЗаполнено(ВыборкаДокументы.ТекстДатаПриказа),
															Формат(ВыборкаДокументы.ТекстДатаПриказа, "ДЛФ=DD"),
															"_______________"));
			СтруктураПараметров.Вставить("НомерПриказа", 	?(ЗначениеЗаполнено(ВыборкаДокументы.ТекстНомерПриказа),
															СокрЛП(ВыборкаДокументы.ТекстНомерПриказа),
															"_______________"));
			СтруктураПараметров.Вставить("Номер", 			РегистрыСведений.НастройкиПечатиПрефиксаНомера
															.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
															"ТаксировкаПутевогоЛиста", ВыборкаДокументы.ТекстНомер));
			СтруктураПараметров.Вставить("Дата", 			Формат(ВыборкаДокументы.ТекстДата, "ДЛФ=D"));
			СтруктураПараметров.Вставить("ДатаЗаголовка",	Формат(ВыборкаДокументы.ТекстДата, "ДЛФ=DD"));
			СтруктураПараметров.Вставить("ЧленыКомиссии",	СтрокаКомиссия);
			
			ОбластьМакетаЗаголовок.Параметры.Заполнить(СтруктураПараметров);
			
			Если ЗначениеЗаполнено(ВыборкаДокументы.Подразделение) И (НЕ ЗначениеЗаполнено(ОбластьМакетаЗаголовок.Параметры.Подразделение)) Тогда
				ОбластьМакетаЗаголовок.Параметры.Подразделение = ?(ЗначениеЗаполнено(ВыборкаДокументы.Подразделение.НаименованиеПолное),
					ВыборкаДокументы.Подразделение.НаименованиеПолное, ВыборкаДокументы.Подразделение.Наименование);
			КонецЕсли;	
			
			ТабДокумент.Вывести(ОбластьМакетаЗаголовок);
			ТабДокумент.Вывести(ОбластьМакетаШапка);
			
			ОбластьЗаключение = Новый ТабличныйДокумент;
			ВыведеноСтрокЗаключения = ВывестиДлиннуюСтроку(ВыборкаДокументы.ЗаключениеКомиссии,
															 ОбластьЗаключение, 
															 ОбластьМакетаЗаключение1,
															 ОбластьМакетаЗаключение2,
															 "ЗаключениеЯчейка1",
															 "ЗаключениеЯчейка2");
			Для Счетчик = ВыведеноСтрокЗаключения + 1 По 3 Цикл
				
				ПустаяОбластьМакетаЗаключение2 = Макет.ПолучитьОбласть("Заключение2");
				ОбластьЗаключение.Вывести(ПустаяОбластьМакетаЗаключение2);
			
			КонецЦикла;
			
			СтрокиДвижений = ДвиженияДокументов.НайтиСтроки(Новый Структура("Регистратор", ВыборкаДокументы.Ссылка));
			ТаблицаВсехДвижений = ДвиженияДокументов.Скопировать(СтрокиДвижений);
			
			Для Каждого ТекДвижение Из ТаблицаВсехДвижений Цикл
				Если НЕ ЗначениеЗаполнено(ТекДвижение.СубконтоДт1) Тогда
					ТекДвижение.СубконтоДт1 = 0;
				Иначе
					Если ЭтоОшибкаПрошлыхЛет(ДокументИсправлениеОшибки) Тогда
						ТекДвижение.СубконтоДт1 = 0;
					КонецЕсли;	
				КонецЕсли;	
				Если НЕ ЗначениеЗаполнено(ТекДвижение.СубконтоДт2) Тогда
					ТекДвижение.СубконтоДт2 = 0;
				Иначе
					Если ЭтоОшибкаПрошлыхЛет(ДокументИсправлениеОшибки) Тогда
						ТекДвижение.СубконтоДт2 = 0;
					КонецЕсли;	
				КонецЕсли;	
				Если НЕ ЗначениеЗаполнено(ТекДвижение.СубконтоДт3) Тогда
					ТекДвижение.СубконтоДт3 = 0;
				Иначе
					Если ЭтоОшибкаПрошлыхЛет(ДокументИсправлениеОшибки) Тогда
						ТекДвижение.СубконтоДт3 = 0;
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;	
			
			ВыборкаМатериалы = ВыборкаДокументы.Материалы.Выбрать();
			СуммаИтого 		= 0;
			КоличествоИтого	= 0;
			КоличествоСтрок = ВыборкаМатериалы.Количество();
			Пока ВыборкаМатериалы.Следующий() Цикл
				ВыводитьСтрокуМатериалов = Истина;
				Если НЕ НеУказанЦМО Тогда
					Если ВыборкаМатериалы.МОЛ = ТекЗаголовок.МОЛ Тогда
						ВыводитьСтрокуМатериалов = Истина;
					Иначе
						ВыводитьСтрокуМатериалов = Ложь;
					КонецЕсли;
				КонецЕсли;
				
				//Контроль подразделения
				Если УчетПоПодразделениям Тогда
					Если ВыводитьСтрокуМатериалов И ЗначениеЗаполнено(ВыборкаМатериалы.Подразделение) Тогда
						Если ВыборкаМатериалы.Подразделение = ТекЗаголовок.Подразделение Тогда
							ВыводитьСтрокуМатериалов = Истина;
						Иначе
							ВыводитьСтрокуМатериалов = Ложь;
						КонецЕсли;	
					КонецЕсли;
				КонецЕсли;
						
				Если ВыводитьСтрокуМатериалов Тогда
					ОбластьМакетаСтрока.Параметры.Заполнить(ВыборкаМатериалы);
					
					СтруктураПараметров = Новый Структура("Цена, Сумма, Количество, СчетДебета, СчетКредита");
					Цена = 0;
					Сумма = 0;
					
					ЗаполнитьЗначенияСвойств(СтруктураОтбора, ВыборкаМатериалы);
					
					СтруктураОтбора.Номенклатура = ВыборкаМатериалы.НоменклатураСсылка;
					СтруктураОтбора.СчетКт = ВыборкаМатериалы.СчетУчета;
					СтруктураОтбора.СчетДт = ВыборкаМатериалы.СчетДт;
					
					СчетИсправленияОшибок = СчетИсправленияОшибки(ТекЗаголовок.Регистратор, ВыборкаМатериалы.СчетДт, ВыборкаДокументы.ТекстДата, ВыборкаДокументы.Организация, ДокументИсправлениеОшибки);
					Если ЗначениеЗаполнено(СчетИсправленияОшибок) Тогда
						СтруктураОтбора.СчетДт = СчетИсправленияОшибок;
					КонецЕсли;	
					
					СтруктураОтбора.КПСКт = ВыборкаМатериалы.КПС;
					СтруктураОтбора.КПСДт = ?(ЗначениеЗаполнено(ВыборкаМатериалы.КПСДт), ВыборкаМатериалы.КПСДт, ВыборкаМатериалы.КПС);
					СтруктураОтбора.КФО = ВыборкаМатериалы.КФО;
					СтруктураОтбора.Подразделение = ВыборкаМатериалы.Подразделение;
					
					СтруктураОтбора.ЦМО = ВыборкаМатериалы.ЦМО;
					СтруктураОтбора.СубконтоДт1 = ?(ВыборкаМатериалы.СубконтоДт1 = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ВыборкаМатериалы.СубконтоДт1), 0, ВыборкаМатериалы.СубконтоДт1);
					СтруктураОтбора.СубконтоДт2 = ?(ВыборкаМатериалы.СубконтоДт2 = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ВыборкаМатериалы.СубконтоДт2), 0, ВыборкаМатериалы.СубконтоДт2);
					СтруктураОтбора.СубконтоДт3 = ?(ВыборкаМатериалы.СубконтоДт3 = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ВыборкаМатериалы.СубконтоДт3), 0, ВыборкаМатериалы.СубконтоДт3);
					
					Если ЗначениеЗаполнено(СчетИсправленияОшибок) Тогда
						СтруктураОтбора.СубконтоДт1 = 0;
						СтруктураОтбора.СубконтоДт2 = 0;
						СтруктураОтбора.СубконтоДт3 = 0;
					Конецесли;	
					
					ТекущиеДвижения = ТаблицаВсехДвижений.НайтиСтроки(СтруктураОтбора);
					Если ТекущиеДвижения.Количество() > 0 Тогда
						ТекущееДвижение = ТекущиеДвижения[0];
						
						Если ТекущееДвижение.Количество <> 0 Тогда
							Цена = Окр(ТекущееДвижение.Сумма / ТекущееДвижение.Количество, 2);
						Иначе
							Цена = 0;
						КонецЕсли;
						Если ВыборкаМатериалы.Количество = ТекущееДвижение.Количество Тогда
							Сумма = ТекущееДвижение.Сумма;
						ИначеЕсли ВыборкаМатериалы.Количество < ТекущееДвижение.Количество Тогда
							Сумма = ВыборкаМатериалы.Количество * Цена;
						Иначе
							Сумма = 0;
						КонецЕсли;
						
						УчтенноеКоличество = Мин(ТекущееДвижение.Количество, ВыборкаМатериалы.Количество);
						ТекущееДвижение.Количество = ТекущееДвижение.Количество - УчтенноеКоличество;
						ТекущееДвижение.Сумма = ТекущееДвижение.Сумма - Сумма;
						
						СтруктураПараметров.Количество = ВыборкаМатериалы.Количество;
						СтруктураПараметров.Цена	= Формат(Цена, "ЧДЦ=2");
						СтруктураПараметров.Сумма	= Формат(Сумма, "ЧДЦ=2");
						
						Если ЗначениеЗаполнено(ТекущееДвижение.СчетДт) Тогда
							СтруктураПараметров.СчетДебета = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета
							(ТекущееДвижение.КПСДт, ТекущееДвижение.КФО, ТекущееДвижение.СчетДт, ТекущееДвижение.КЭКДт);
						КонецЕсли;
						СтруктураПараметров.СчетКредита = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета
							(ТекущееДвижение.КПСКт, ТекущееДвижение.КФО, ТекущееДвижение.СчетКт, ТекущееДвижение.КЭККт);
					Иначе
						СтруктураПараметров.Количество = ВыборкаМатериалы.Количество;
					КонецЕсли;
					
					СтруктураПараметров.Цена	= Формат(Цена, "ЧДЦ=2");
					СтруктураПараметров.Сумма	= Формат(Сумма, "ЧДЦ=2");
					ОбластьМакетаСтрока.Параметры.Заполнить(СтруктураПараметров);
						
					Если ВыборкаМатериалы.НомерСтроки <> КоличествоСтрок Тогда
						Если Не ТабДокумент.ПроверитьВывод(ОбластьМакетаСтрока) Тогда
							ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
							ТабДокумент.Вывести(ОбластьМакетаШапка);
						КонецЕсли;
					Иначе
						Области = Новый Массив;
						Области.Добавить(ОбластьМакетаСтрока);
						Области.Добавить(ОбластьМакетаИтого);
						Области.Добавить(ОбластьМакетаПодвал);
						Области.Добавить(ОбластьЗаключение);
						Области.Добавить(ОбластьКомиссия);
						Области.Добавить(ОбластьМакетаДата);
						Если Не ТабДокумент.ПроверитьВывод(ОбластьМакетаСтрока) Тогда
							ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
							ТабДокумент.Вывести(ОбластьМакетаШапка);
						КонецЕсли;
					КонецЕсли;
					
					СуммаИтого 		= СуммаИтого		+ Сумма;
					КоличествоИтого	= КоличествоИтого	+ ВыборкаМатериалы.Количество;
					
					ТабДокумент.Вывести(ОбластьМакетаСтрока);
				КонецЕсли;
			КонецЦикла;
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("КоличествоИтого", КоличествоИтого);
			СтруктураПараметров.Вставить("СуммаИтого", Формат(СуммаИтого, "ЧДЦ=2"));
			СтруктураПараметров.Вставить("СуммаИтогоПрописью",
				ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СуммаИтого, Неопределено));
			ОбластьМакетаИтого.Параметры.Заполнить(СтруктураПараметров);
			ТабДокумент.Вывести(ОбластьМакетаИтого);
			ОбластьМакетаПодвал.Параметры.Заполнить(СтруктураПараметров);
			ТабДокумент.Вывести(ОбластьМакетаПодвал);
			ТабДокумент.Вывести(ОбластьЗаключение);
			МассивОбластейПроверки = Новый Массив;
			МассивОбластейПроверки.Добавить(ОбластьКомиссия);
			МассивОбластейПроверки.Добавить(ОбластьМакетаДата);
			Если Не ТабДокумент.ПроверитьВывод(МассивОбластейПроверки) Тогда
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			ТабДокумент.Вывести(ОбластьКомиссия);
			ТабДокумент.Вывести(ОбластьМакетаДата);
			
			// В табличном документе зададим имя области, в которую был 
			// выведен объект. Нужно для возможности печати покомплектно.
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент,
				НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументы.Ссылка);
			
			НомерАкта = НомерАкта + 1;
		КонецЦикла;
		
		Для каждого ТекДвижение Из СтрокиДвижений Цикл
			
			ДвиженияДокументов.Удалить(ТекДвижение);
			
		КонецЦикла; 
	КонецЦикла;
	
	Возврат ТабДокумент;

КонецФункции

Функция ЭтоОшибкаПрошлыхЛет(ИсправлениеОшибки)
	Результат = Истина;
	Если ИсправлениеОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка ИЛИ НЕ ЗначениеЗаполнено(ИсправлениеОшибки) Тогда
		Результат = Ложь;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ИсправлениеОшибки(РегистраторСсылка)
	ИсправлениеОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОперацииДокументов.ИсправлениеОшибки КАК ИсправлениеОшибки
	               |ИЗ
	               |	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	               |ГДЕ
	               |	ОперацииДокументов.Документ = &РегистраторСсылка";
	Запрос.УстановитьПараметр("РегистраторСсылка", РегистраторСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ИсправлениеОшибки = Выборка.ИсправлениеОшибки;
	КонецЕсли;
	
	Возврат ИсправлениеОшибки
КонецФункции	

Функция СчетИсправленияОшибки(РегистраторСсылка, СчетУчета, ДатаСведений, Организация, ИсправлениеОшибки)
	Результат = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	
	СтруктураДанныхСчетаУчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетУчета, "Код");
	
	Если ИсправлениеОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода Тогда
		Если СтруктураДанныхСчетаУчета.Код = "401.20" Тогда
			Результат = БухгалтерскийУчет.СчетПоКоду("401.28", ДатаСведений, Организация);			
		Иначе
			Результат = БухгалтерскийУчет.СчетПоКоду("304.86", ДатаСведений, Организация);
		КонецЕсли;	
	ИначеЕсли ИсправлениеОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода Тогда
		Если СтруктураДанныхСчетаУчета.Код = "401.20" Тогда
			Результат = БухгалтерскийУчет.СчетПоКоду("401.29", ДатаСведений, Организация);
		Иначе
			Результат = БухгалтерскийУчет.СчетПоКоду("304.96", ДатаСведений, Организация);
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

// Выводит длинные строки в многострочные части печатных форм. 
//
// Строка вывода - строка, которую будем выводить
// Область1 - ОбластьЯчеекТабличногоДокумента. Укороченная строка, с которой начинается вывод
// Область2 - ОбластьЯчеекТабличногоДокумента. Полная строка, котороя будет множиться
// НаименованиеЯчейкиОбласть1 - Наименование области Область1
// НаименованиеЯчейкиОбласть2 - Наименование области Область2
//
// Возвращает количество выведенных строк
Функция ВывестиДлиннуюСтроку(СтрокаВывода, ТабДокумент, Область1, Область2, НаименованиеЯчейкиОбласть1,
	НаименованиеЯчейкиОбласть2)
	
	МассивСтрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаВывода, Символы.ПС);
	МассивСлов = Новый Массив;
	Для каждого ТекСтрока Из МассивСтрок Цикл
		
		МассивСловТекущейСтроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекСтрока, " ");
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСлов, МассивСловТекущейСтроки);
		МассивСлов.Добавить(Символы.ПС);
	
	КонецЦикла;
	Если МассивСлов.Количество() > 0 Тогда
		МассивСлов.Удалить(МассивСлов.ВГраница());
	КонецЕсли;
	
	ЯчейкаОбласть1 = Область1.Область(НаименованиеЯчейкиОбласть1);
	ЯчейкаОбласть2 = Область2.Область(НаименованиеЯчейкиОбласть2);
	
	ЧислоСимволов1 = ЯчейкаОбласть1.ШиринаКолонки * (ЯчейкаОбласть1.Право - ЯчейкаОбласть1.Лево + 1);
	ЧислоСимволов2 = ЯчейкаОбласть2.ШиринаКолонки * (ЯчейкаОбласть2.Право - ЯчейкаОбласть2.Лево + 1);
	
	ТекИндекс = 0;
	Область1.Параметры.Установить(0, СобратьСтрокуИзМассиваДляОбласти(МассивСлов, ТекИндекс, ЧислоСимволов1));
	ТабДокумент.Вывести(Область1);
	КолВыведенныхСтрок = 1;
	Пока ТекИндекс <= МассивСлов.Количество() - 1 Цикл
		Область2.Параметры.Установить(0, СобратьСтрокуИзМассиваДляОбласти(МассивСлов, ТекИндекс, ЧислоСимволов2));
		ТабДокумент.Вывести(Область2);
		КолВыведенныхСтрок = КолВыведенныхСтрок + 1;
	КонецЦикла;
	
	Возврат КолВыведенныхСтрок;
	
КонецФункции

// Формирует строку из массива слов, которая помещается в область шириной "ШиринаВСимволах".
// Выбор слов из массива начинается с индекса "ТекИндекс"
Функция СобратьСтрокуИзМассиваДляОбласти(МассивСлов, ТекИндекс, ШиринаВСимволах) Экспорт
	ТекСтрока = "";
	ВсегоСимволов = 0;
	Для к = ТекИндекс по МассивСлов.Количество()-1 Цикл
		ТекСлово = МассивСлов[к];
		Если ТекСлово = Символы.ПС Тогда
			ТекИндекс = ТекИндекс  + 1;
			Прервать;
		КонецЕсли;			
		ВсегоСимволов = ВсегоСимволов + СтрДлина(" " + ТекСлово);
		Если ВсегоСимволов < ШиринаВСимволах Тогда
			ТекСтрока = ТекСтрока + " " + ТекСлово;
			ТекИндекс = ТекИндекс  + 1;
		ИначеЕсли ВсегоСимволов = ШиринаВСимволах Тогда
			ТекСтрока = ТекСтрока + " " + ТекСлово;
			ТекИндекс = ТекИндекс  + 1;
			Прервать;
		Иначе
			Прервать
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат ТекСтрока;
КонецФункции	

Функция СформироватьОбластьКомиссия(ВыборкаШапка, ВыборкаКомиссия, МассивОбластейКомиссия, КоличествоСтрокКомиссии=3, СтрокаКомиссия = "", ВписыватьДолжности = Ложь) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	СтрокаКомиссия = "";
	ИндексОбластиКомиссия = 0;
	
	пСтатусЧленаКомиссии	= "Председатель комиссии";
	пДолжностьЧленаКомиссии = ВыборкаШапка.ДолжностьПредседателяКомиссии;
	Если ЗначениеЗаполнено(ВыборкаШапка.ФамилияПредседателяКомиссии) Тогда
		пЧленКомиссии			= КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																	ВыборкаШапка.ФамилияПредседателяКомиссии,
																	ВыборкаШапка.ИмяПредседателяКомиссии,
																	ВыборкаШапка.ОтчествоПредседателяКомиссии));
		Если ВписыватьДолжности И НЕ ПустаяСтрока(ВыборкаШапка.ДолжностьПредседателяКомиссии) Тогда
			СтрокаКомиссия = СтрокаКомиссия + НРег(СокрЛП(ВыборкаШапка.ДолжностьПредседателяКомиссии))+ " ";
		КонецЕсли;
		СтрокаКомиссия = СтрокаКомиссия+пЧленКомиссии+", ";
	Иначе
		пЧленКомиссии			= "";
	КонецЕсли;
	СтруктураОбластьКомиссия = Новый Структура("пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии",пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии);
	
	ОбластьКомиссия = МассивОбластейКомиссия[Мин(ИндексОбластиКомиссия, МассивОбластейКомиссия.ВГраница())];
	ИндексОбластиКомиссия = ИндексОбластиКомиссия + 1;
	ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);
	ТабличныйДокумент.Вывести(ОбластьКомиссия);
	
	пСтатусЧленаКомиссии = "Члены комиссии:";
	ВывелиСтрок = 1;    // председатель комиссии это была первая выведеная строка
	Если ТипЗнч(ВыборкаКомиссия)=Тип("ВыборкаИзРезультатаЗапроса") Тогда
		Пока ВыборкаКомиссия.Следующий() Цикл
			ВывелиСтрок = ВывелиСтрок + 1;
			пДолжностьЧленаКомиссии = ВыборкаКомиссия.ДолжностьЧленаКомиссии;
			пЧленКомиссии			= КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																			ВыборкаКомиссия.ФамилияЧленаКомиссии,
																			ВыборкаКомиссия.ИмяЧленаКомиссии,
																			ВыборкаКомиссия.ОтчествоЧленаКомиссии));
			СтруктураОбластьКомиссия = Новый Структура("пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии",пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии);

			ОбластьКомиссия = МассивОбластейКомиссия[Мин(ИндексОбластиКомиссия, МассивОбластейКомиссия.ВГраница())];
			ИндексОбластиКомиссия = ИндексОбластиКомиссия + 1;
			ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);
			
			ТабличныйДокумент.Вывести(ОбластьКомиссия);
			
			пСтатусЧленаКомиссии = "";
			Если ВписыватьДолжности И НЕ ПустаяСтрока(ВыборкаКомиссия.ДолжностьЧленаКомиссии) Тогда
				СтрокаКомиссия = СтрокаКомиссия + НРег(СокрЛП(ВыборкаКомиссия.ДолжностьЧленаКомиссии))+ " ";
			КонецЕсли;
			
			СтрокаКомиссия = СтрокаКомиссия+пЧленКомиссии+", ";
		КонецЦикла;
	КонецЕсли;
		
	Для Счетчик=ВывелиСтрок По КоличествоСтрокКомиссии Цикл
		СтруктураОбластьКомиссия = Новый Структура("пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии",пСтатусЧленаКомиссии,"","");

		ОбластьКомиссия = МассивОбластейКомиссия[Мин(ИндексОбластиКомиссия, МассивОбластейКомиссия.ВГраница())];
		ИндексОбластиКомиссия = ИндексОбластиКомиссия + 1;
		ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);
		ТабличныйДокумент.Вывести(ОбластьКомиссия);
		
		пСтатусЧленаКомиссии = "";
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(СтрокаКомиссия) Тогда
		СтрокаКомиссия = Лев(СтрокаКомиссия, СтрДлина(СтрокаКомиссия)-2);
	КонецЕсли;

	Возврат ТабличныйДокумент;
	
КонецФункции // СформироватьОбластьКомиссия()

Функция ТекстЗапросаШапкиДляПечатиАктаОСписанииМЗ0510460()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АктСписанияМЗ.Ссылка КАК Ссылка,
	|	АктСписанияМЗ.ЦМОДляАктаОСписании КАК ЦМООтправитель,
	|	АктСписанияМЗ.ПодразделениеДляАктаОСписании КАК ПодразделениеОтправитель,
	|	АктСписанияМЗ.Комиссия.НаименованиеПриказа КАК НаименованиеПриказа,
	|	АктСписанияМЗ.Комиссия.НомерПриказа КАК НомерПриказа,
	|	АктСписанияМЗ.Комиссия.ДатаПриказа КАК ДатаПриказа,
	|	ЕСТЬNULL(АктСписанияМЗ.ЦМОДляАктаОСписании.Сотрудник.Код, """") КАК УчетныйНомерОтправитель,
	|	ЕСТЬNULL(АктСписанияМЗ.ЦМОДляАктаОСписании.Сотрудник, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК Сотрудник,
	|	ЛОЖЬ КАК НеобходимостьУничтожения,
	|	АктСписанияМЗ.ЦМОДляАктаОСписании.МестоХранения.Наименование КАК МестонахождениеОбъектов,
	|	АктСписанияМЗ.РасчетПроизвел КАК ОтветственныйИсполнитель,
	|	АктСписанияМЗ.Руководитель КАК УполномоченноеЛицо,
	|	АктСписанияМЗ.Дата КАК Дата,
	|	АктСписанияМЗ.Номер КАК Номер,
	|	АктСписанияМЗ.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка) КАК КФО,
	|	АктСписанияМЗ.ИФОДляАктаОСписании КАК ИФО,
	|	АктСписанияМЗ.ДолжностьПредседательКомиссии КАК ДолжностьПредседательКомиссии,
	|	АктСписанияМЗ.ФамилияПредседательКомиссии КАК ФамилияПредседательКомиссии,
	|	АктСписанияМЗ.ИмяПредседательКомиссии КАК ИмяПредседательКомиссии,
	|	АктСписанияМЗ.ОтчествоПредседательКомиссии КАК ОтчествоПредседательКомиссии,
	|	АктСписанияМЗ.Комиссия КАК Комиссия
	|ИЗ
	|	Документ.ТаксировкаПутевогоЛиста КАК АктСписанияМЗ
	|ГДЕ
	|	АктСписанияМЗ.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер";
КонецФункции

Функция ТекстЗапросаТаблицыМатериалыДляПечатиАктаОСписанииМЗ0510460()
	Возврат
	"ВЫБРАТЬ
	|	АктСписанияМЗМатериалы.Ссылка КАК Ссылка,
	|	АктСписанияМЗМатериалы.НомерСтроки КАК НомерСтроки,
	|	АктСписанияМЗМатериалы.Номенклатура КАК Номенклатура,
	|	АктСписанияМЗМатериалы.Количество КАК Количество,
	|	АктСписанияМЗМатериалы.Номенклатура.ЕдиницаИзмерения.Код КАК ЕдИзмКод,
	|	АктСписанияМЗМатериалы.Номенклатура.ЕдиницаИзмерения.Наименование КАК ЕдИзмНаименование,
	|	ВЫБОР
	|		КОГДА АктСписанияМЗМатериалы.Номенклатура.НаименованиеПолное = """"
	|			ТОГДА АктСписанияМЗМатериалы.Номенклатура.Наименование
	|		ИНАЧЕ АктСписанияМЗМатериалы.Номенклатура.НаименованиеПолное
	|	КОНЕЦ КАК НФАНаименование,
	|	АктСписанияМЗМатериалы.Номенклатура.НаименованиеДополнительное КАК НФАДопНаименование,
	|	АктСписанияМЗМатериалы.Номенклатура.НоменклатурныйНомер КАК НомерНоменклатурный,
	|	АктСписанияМЗМатериалы.Номенклатура.Код КАК НоменклатураКод,
	|	АктСписанияМЗМатериалы.КоличествоНорма КАК НормаРасхода,
	|	0 КАК СрокВЭксплуатации,
	|	АктСписанияМЗМатериалы.КПС КАК КПС,
	|	АктСписанияМЗМатериалы.ДополнительнаяАналитикаСчета КАК ДополнительнаяАналитикаСчета,
	|	АктСписанияМЗМатериалы.СчетУчета КАК СчетУчета,
	|	(&КЭКДляГСМ) КАК КЭК,
	|	АктСписанияМЗМатериалы.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ЕСТЬNULL(АктСписанияМЗМатериалы.Номенклатура.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПустаяСсылка)) КАК ТипНоменклатуры,
	|	"""" КАК СерияБСО,
	|	"""" КАК НачальныйНомерБСО,
	|	"""" КАК КонечныйНомерБСО,
	|	АктСписанияМЗМатериалы.ПричинаСписанияСсылка.Код КАК ПричинаСписанияКод,
	|	АктСписанияМЗМатериалы.ПричинаСписанияСсылка.Наименование КАК ПричинаСписанияНаименование,
	|	АктСписанияМЗМатериалы.КФО КАК КФО
	|ИЗ
	|	Документ.ТаксировкаПутевогоЛиста.Материалы КАК АктСписанияМЗМатериалы
	|ГДЕ
	|	АктСписанияМЗМатериалы.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|ИТОГИ ПО
	|	Ссылка";
КонецФункции

Функция ТекстЗапросаФайлыДляПечатиАктаОСписанииМЗ0510460()
	
	Возврат
	"ВЫБРАТЬ
	|	Файлы.ВладелецФайла КАК Ссылка,
	|	Файлы.Ссылка КАК Файл,
	|	Файлы.Наименование КАК ИмяФайла,
	|	Файлы.Описание КАК Описание
	|ИЗ
	|	Справочник.Файлы КАК Файлы
	|ГДЕ
	|	Файлы.ВладелецФайла В(&МассивОбъектов)
	|	И НЕ Файлы.Служебный
	|	И НЕ Файлы.ПометкаУдаления";

