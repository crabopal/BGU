Функция ТекстЗапросаКомиссииДляПечатиАктаОСписанииМЗ0510460()
	Возврат
	"ВЫБРАТЬ
	|	АктСписанияМЗСоставКомиссии.Ссылка КАК Ссылка,
	|	АктСписанияМЗСоставКомиссии.ДолжностьЧленаКомиссии,
	|	АктСписанияМЗСоставКомиссии.ФамилияЧленаКомиссии,
	|	АктСписанияМЗСоставКомиссии.ИмяЧленаКомиссии,
	|	АктСписанияМЗСоставКомиссии.ОтчествоЧленаКомиссии,
	|	АктСписанияМЗСоставКомиссии.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.ТаксировкаПутевогоЛиста.СоставКомиссии КАК АктСписанияМЗСоставКомиссии
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктСписанияМЗ КАК АктСписанияМЗ
	|		ПО АктСписанияМЗСоставКомиссии.Ссылка = АктСписанияМЗ.Ссылка
	|ГДЕ
	|	АктСписанияМЗ.Ссылка В(&МассивОбъектов)
	|	И АктСписанияМЗСоставКомиссии.Ссылка В(&МассивОбъектов)
	|	И АктСписанияМЗ.Комиссия = ЗНАЧЕНИЕ(Справочник.ПостоянноДействующиеКомиссии.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
КонецФункции

Функция ТекстЗапросаДвиженияДляПечатиТребованияНакладной0510460()
	Возврат
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Ссылка,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетУчета,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК Справочник.Номенклатура)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	КОНЕЦ КАК НоменклатураСсылка,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В (&Счета106хП)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА НЕ ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО))
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1
	|		КОГДА НЕ ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО))
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2
	|		КОГДА НЕ ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3 В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО))
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	КОНЕЦ КАК ДопСубконто,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт КАК Количество,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК Сумма,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт КАК КоличествоОстаток,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК СуммаОстаток,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПССсылка,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭКСсылка,
	|	0 КАК НомерСтрокиДокумента,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В (&МассивОбъектов)
	|				И (ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|					ИЛИ ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|					ИЛИ ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)),
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто";

КонецФункции

// Данные для печати акта о списании МЗ 0510460.
// 
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.АктСписанияМЗ
// 
// Возвращаемое значение:
//  Структура:
//   * ДанныеШапки - см. ТаблицаШапкиДляПечатиАктаОСписанииМЗ0510460
//   * ТабличнаяЧасть - Соответствие из Массив см. ЗаголовокТабличнойЧастиДляПечатиАктаОСписанииМЗ0510460
//   * Комиссия - см. ТаблицаКомиссияДляПечатиАктаОСписанииМЗ0510460
//   * Приложения - см. ТаблицаФайлыДляПечатиАктаОСписанииМЗ0510460
//   
Функция ДанныеДляПечатиАктаОСписанииМЗ0510460(МассивОбъектов)
	
	ДанныеОрганизацийПечати = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	ДанныеГруппНФА = УправлениеПечатьюБГУ.ГруппыОбъектовНФА();
	РезультатыГолосования = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(МассивОбъектов);
	СоставКомиссий = ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов);

	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ТекстЗапросаШапкиДляПечатиАктаОСписанииМЗ0510460());
	ЧастиЗапроса.Добавить(ТекстЗапросаТаблицыМатериалыДляПечатиАктаОСписанииМЗ0510460());
	ЧастиЗапроса.Добавить(ТекстЗапросаДвиженияДляПечатиТребованияНакладной0510460());
	ЧастиЗапроса.Добавить(ТекстЗапросаФайлыДляПечатиАктаОСписанииМЗ0510460());
	ЧастиЗапроса.Добавить(ТекстЗапросаКомиссииДляПечатиАктаОСписанииМЗ0510460());
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ДатаСчетов106БезПартии = '20210101';
	Запрос.УстановитьПараметр("Счета106хП", БухгалтерскийУчет.СписокСчетов("106.2П,106.3П", ДатаСчетов106БезПартии));
	
	КЭКДляГСМ = БухгалтерскийУчет.КЭКНоменклатуры(,,,ТекущаяДатаСеанса(),,Перечисления.ТипыНоменклатуры.ГСМ,);
	
	Запрос.УстановитьПараметр("КЭКДляГСМ", КЭКДляГСМ);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаШапка = РезультатЗапроса[0].Выбрать();
	ТабличныеЧасти = РезультатЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТаблицаДвижений = РезультатЗапроса[2].Выгрузить();
	ВыборкаФайлы = РезультатЗапроса[3].Выбрать();
	ВыборкаКомиссииСтарые = РезультатЗапроса[4].Выбрать();

	ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки", Неопределено, "");
	
	Результат = УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктаОСписанииМЗ0510460();
	Пока ВыборкаШапка.Следующий() Цикл
		СтрокаШапки = Результат.Добавить();
		СтрокаШапки.СоставКомиссии = УправлениеПечатьюБГУ.ТаблицаКомиссияДляПечатиАктаОСписанииМЗ0510460();
		СтрокаШапки.Файлы = УправлениеПечатьюБГУ.ТаблицаФайлыДляПечатиАктаОСписанииМЗ0510460();
		
		ЗаполнитьЗначенияСвойств(СтрокаШапки, ВыборкаШапка);
		СтрокаШапки.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка, ВыборкаШапка.Номер);
		
		ДанныеОрганизации = ДанныеОрганизацийПечати.Получить(ВыборкаШапка.Ссылка);
		СтрокаШапки.НаименованиеОрганизации = ДанныеОрганизации.НаименованиеОрганизации;
		СтрокаШапки.НаименованиеОбособленногоПодразделения = ДанныеОрганизации.НаименованиеОбособленногоПодразделения;
		СтрокаШапки.Учредитель = ДанныеОрганизации.Учредитель;
		СтрокаШапки.БюджетНаименование = ДанныеОрганизации.БюджетНаименование;
		СтрокаШапки.КодРПБС = ДанныеОрганизации.КодРПБС;
		СтрокаШапки.КодРПБСПодр = ДанныеОрганизации.КодРПБСОбособленногоПодразделения;
		СтрокаШапки.ГлаваБК = ДанныеОрганизации.ГлаваБК;
		СтрокаШапки.ОКТМО = ДанныеОрганизации.ОКТМО;
		СтрокаШапки.НаименованиеСтруктурногоПодразделения = ДанныеОрганизации.СтруктурноеПодразделение;
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
			ВыборкаШапка.УполномоченноеЛицо, ВыборкаШапка.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтрокаШапки.УполномоченноеЛицоДолжность = ДанныеСотрудника.Должность;
		СтрокаШапки.УполномоченноеЛицоФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);

		СтрокаШапки.ОтветственныйДолжность = ДанныеОрганизации.ОтветственныйДолжность;
		СтрокаШапки.ОтветственныйФИО = КорреспондентыКлиентСервер.ФИО(ДанныеОрганизации.ОтветственныйФИО, Истина);
		СтрокаШапки.ОтветственныйТелефон = ДанныеОрганизации.ОтветственныйТелефон;
		СтрокаШапки.ОтветственныйЭлПочта = ДанныеОрганизации.ОтветственныйЭлПочта;
		
		ПараметрыРаспределенияДвижений = УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти_Параметры();
		ПараметрыРаспределенияДвижений.КФОВТаблице             = Истина;
		ПараметрыРаспределенияДвижений.ТипНоменклатурыВТаблице = Истина;
		ПараметрыРаспределенияДвижений.ИмяКолонкиКЭК           = "КЭКСсылка";
		ПараметрыРаспределенияДвижений.ИмяКолонкиНоменклатура  = "Номенклатура";
		ПараметрыРаспределенияДвижений.ИменаСуммируемыхКолонок = "Количество,Сумма,КоличествоОстаток,СуммаОстаток";
		ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("НоменклатураСсылка", "Номенклатура");
		ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("СчетУчета",          "СчетУчета");
		ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("КПССсылка",          "КПС");
		ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("КФО",                "КФО");
		ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("Количество",         "Количество");
		ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("КЭКСсылка",          "КЭК");
		ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("ДопСубконто",        "ДополнительнаяАналитикаСчета");
	
		ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("НоменклатураСсылка", "Номенклатура");
		ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("СчетУчета",          "СчетУчета");
		ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("КПССсылка",          "КПС");
		ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("КФО",                "КФО");
		
		ТабличныеЧасти.Сбросить();
		Если ТабличныеЧасти.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Тогда
			СтрокиДокумента = ТабличныеЧасти.Выбрать();
			ТаблицаДвиженийДокумента = ТаблицаДвижений.Скопировать(Новый Структура("Ссылка", ВыборкаШапка.Ссылка));
			Если ТаблицаДвиженийДокумента.Количество() > 0 Тогда
				ПараметрыРаспределенияДвижений.Организация = ВыборкаШапка.Организация;
				ПараметрыРаспределенияДвижений.ИФО = ВыборкаШапка.ИФО;
				ПараметрыРаспределенияДвижений.Дата = ВыборкаШапка.Дата;
				ПараметрыРаспределенияДвижений.ВыборкаМатериалы = СтрокиДокумента;
				ПараметрыРаспределенияДвижений.ТаблицаДвижений = ТаблицаДвиженийДокумента;
				УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти(ПараметрыРаспределенияДвижений);
				СтрокиДокумента.Сбросить();
			КонецЕсли;
		Иначе
			СтрокиДокумента = Неопределено;
		КонецЕсли;
	
		СтрокиНФАПоГруппам = Новый Соответствие;
		ИспользуемыеГруппы = Новый ТаблицаЗначений;
		ИспользуемыеГруппы.Колонки.Добавить("КодГруппы", Новый ОписаниеТипов("Строка"));
		ИспользуемыеГруппы.Колонки.Добавить("ПорядокСчета", Новый ОписаниеТипов("Строка"));
		
		ДанныеТабличныхЧастейДокумента = Новый Массив;
		Пока СтрокиДокумента <> Неопределено И СтрокиДокумента.Следующий() Цикл
			
			КодГрупповогоСчета = Строка(СтрокиДокумента.КФО);
			ТекущаяГруппаНФА = ДанныеГруппНФА.Получить(СтрокиДокумента.СчетУчета);
			Если ТекущаяГруппаНФА <> Неопределено Тогда
				КодГрупповогоСчета = КодГрупповогоСчета + "." + ТекущаяГруппаНФА.Код;
			КонецЕсли;
			ГруппировочнаяСтрока = СтрокиНФАПоГруппам.Получить(КодГрупповогоСчета);
			Если ГруппировочнаяСтрока = Неопределено Тогда
				ЗаголовокТабличнойЧасти = УправлениеПечатьюБГУ.ЗаголовокТабличнойЧастиДляПечатиАктаОСписанииМЗ0510460();
				СтрокаИспользуемыхГрупп = ИспользуемыеГруппы.Добавить();
				СтрокаИспользуемыхГрупп.КодГруппы = КодГрупповогоСчета;
				Если ТекущаяГруппаНФА <> Неопределено Тогда
					ЗаголовокТабличнойЧасти.КодГруппыНФА = КодГрупповогоСчета;
					ЗаголовокТабличнойЧасти.ГруппаНФА    = ТекущаяГруппаНФА.Наименование;
					СтрокаИспользуемыхГрупп.ПорядокСчета = Строка(СтрокиДокумента.КФО) + ТекущаяГруппаНФА.Порядок;
				КонецЕсли;
				СоставТабличнойЧасти = ЗаголовокТабличнойЧасти.Состав;
				СтрокиНФАПоГруппам.Вставить(КодГрупповогоСчета, ЗаголовокТабличнойЧасти);
			Иначе
				СоставТабличнойЧасти = ГруппировочнаяСтрока.Состав;
			КонецЕсли;
	
			НоваяСтрокаСостава = СоставТабличнойЧасти.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСостава, СтрокиДокумента);
			НоваяСтрокаСостава.КодСтроки = СтрокиДокумента.НомерСтроки;
			ОтборСтрокиДокумента = Новый Структура("НомерСтрокиДокумента", СтрокиДокумента.НомерСтроки);
			СтрокиДвижений = ТаблицаДвиженийДокумента.НайтиСтроки(ОтборСтрокиДокумента);
			Если СтрокиДвижений.Количество() > 0 Тогда
				СтрокаСебестоимости = СтрокиДвижений[0];
				НоваяСтрокаСостава.Сумма = СтрокаСебестоимости.СуммаОстаток;
				Если СтрокаСебестоимости.КоличествоОстаток <> 0 Тогда
					НоваяСтрокаСостава.Цена = СтрокаСебестоимости.СуммаОстаток / СтрокаСебестоимости.КоличествоОстаток;
				КонецЕсли;
				СтрокаСебестоимости.КоличествоОстаток = СтрокаСебестоимости.КоличествоОстаток - НоваяСтрокаСостава.Количество;
				СтрокаСебестоимости.СуммаОстаток = СтрокаСебестоимости.СуммаОстаток - НоваяСтрокаСостава.Сумма;
			Иначе
				Если НоваяСтрокаСостава.Цена = 0 И НоваяСтрокаСостава.Количество <> 0 Тогда
					НоваяСтрокаСостава.Цена = НоваяСтрокаСостава.Сумма / НоваяСтрокаСостава.Количество;
				КонецЕсли;
			КонецЕсли;
			ОтборПоИдентификаторуСтроки.Документ = ВыборкаШапка.Ссылка;
			ОтборПоИдентификаторуСтроки.ИдентификаторСтроки = СтрокиДокумента.ИдентификаторСтроки;
			РезультатыГолосованияПоСтроке = РезультатыГолосования.НайтиСтроки(ОтборПоИдентификаторуСтроки);
			Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрокаСостава, РезультатыГолосованияПоСтроке[0],
					"ИтогГолосования,РезолюцияКомиссииОдобрена,ГолосованиеПоСтрокеЗавершено");
			КонецЕсли;
			
		КонецЦикла;
		
		ДанныеТабличныхЧастейДокумента = СтрокаШапки.ГруппыНФА;
		ИспользуемыеГруппы.Сортировать("ПорядокСчета");
		Для Каждого ИспользуемаяГруппа Из ИспользуемыеГруппы Цикл
			СтрокиГруппы = СтрокиНФАПоГруппам.Получить(ИспользуемаяГруппа.КодГруппы);
			ДанныеТабличныхЧастейДокумента.Добавить(СтрокиГруппы);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ВыборкаШапка.Комиссия) Тогда
			// Председатель
			Отбор = Новый Структура("Ссылка,Председатель", ВыборкаШапка.Ссылка, Истина);
			СтрокиПредседатель = СоставКомиссий.НайтиСтроки(Отбор);
			Для Каждого Председатель Из СтрокиПредседатель Цикл
				СтрокаКомиссия = СтрокаШапки.СоставКомиссии.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаКомиссия, Председатель);
				СтрокаКомиссия.Председатель = Истина;
				СтрокаКомиссия.ФИО = КорреспондентыКлиентСервер.ФИО(Председатель);
				СтрокаКомиссия.ИмяФайла = Председатель.ОсобыеОтметки;
			КонецЦикла;
		
			// Члены комиссии
			Отбор = Новый Структура("Ссылка,Председатель", ВыборкаШапка.Ссылка, Ложь);
			СтрокиЧленыКомиссии = СоставКомиссий.НайтиСтроки(Отбор);
			Для Каждого ЧленКомиссии Из СтрокиЧленыКомиссии Цикл
				СтрокаКомиссия = СтрокаШапки.СоставКомиссии.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаКомиссия, ЧленКомиссии);
				СтрокаКомиссия.ФИО = КорреспондентыКлиентСервер.ФИО(ЧленКомиссии);
				СтрокаКомиссия.ИмяФайла = ЧленКомиссии.ОсобыеОтметки;
			КонецЦикла;
		Иначе
			// Председатель
			Если ЗначениеЗаполнено(ВыборкаШапка.ФамилияПредседательКомиссии) Тогда
				СтрокаКомиссия = СтрокаШапки.СоставКомиссии.Добавить();
				СтрокаКомиссия.Председатель = Истина;
				ФИОПредседателя = Новый Структура;
				ФИОПредседателя.Вставить("Фамилия", ВыборкаШапка.ФамилияПредседательКомиссии);
				ФИОПредседателя.Вставить("Имя", ВыборкаШапка.ИмяПредседательКомиссии);
				ФИОПредседателя.Вставить("Отчество", ВыборкаШапка.ОтчествоПредседательКомиссии);
				СтрокаКомиссия.ФИО = КорреспондентыКлиентСервер.ФИО(ФИОПредседателя);
				СтрокаКомиссия.НаименованиеДолжности = ВыборкаШапка.ДолжностьПредседательКомиссии;
			КонецЕсли;
			// Члены комиссии
			ВыборкаКомиссииСтарые.Сбросить();
			Пока ВыборкаКомиссииСтарые.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Цикл
				СтрокаКомиссия = СтрокаШапки.СоставКомиссии.Добавить();
				ФИОЧленаКомиссии = Новый Структура;
				ФИОЧленаКомиссии.Вставить("Фамилия", ВыборкаКомиссииСтарые.ФамилияЧленаКомиссии);
				ФИОЧленаКомиссии.Вставить("Имя", ВыборкаКомиссииСтарые.ИмяЧленаКомиссии);
				ФИОЧленаКомиссии.Вставить("Отчество", ВыборкаКомиссииСтарые.ОтчествоЧленаКомиссии);
				СтрокаКомиссия.ФИО = КорреспондентыКлиентСервер.ФИО(ФИОЧленаКомиссии);
				СтрокаКомиссия.НаименованиеДолжности = ВыборкаКомиссииСтарые.ДолжностьЧленаКомиссии;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Пока ВыборкаФайлы.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СтрокаШапки.Файлы.Добавить(), ВыборкаФайлы);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры
//  Ссылка  - ДокументСсылка.ТаксировкаПутевогоЛиста - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	ПустаяТопливнаяКарта = Справочники.БСО.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ПустаяТопливнаяКарта", ПустаяТопливнаяКарта);
	
	НомераТаблиц = Новый Структура;
	
	ИнициализироватьЗапросыРасходГСМ(Запрос, НомераТаблиц);
	ИнициализироватьЗапросыЗаправкиГСМПоТопливнымКартам(Запрос, НомераТаблиц);
	
	Результат = Запрос.ВыполнитьПакет();

	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
КонецПроцедуры // ИнициализироватьДанныеДокумента()

Функция ПолучитьИсходныеДанныеПоКлючу(ВидГСМ, ВыборкаДанныхНорм,ВыборкаДанныхПоправочныхЗначений,ВыборкаДанныхПоправочныхКоэффициентов, Ключ, Топливо = Истина)
	Результат = "";
	
	Пока ВыборкаДанныхНорм.Следующий() Цикл
		Если ВыборкаДанныхНорм.КлючСтроки = Ключ Тогда
			Если НЕ Топливо Тогда
				Если (ВыборкаДанныхНорм.Норма.ВидНормы = Перечисления.ВидыНормРасходаГСМ.НормаРасходаСмазочныхМатериалов) И 
					(ВыборкаДанныхНорм.Норма.ВидСМ = ВидГСМ) Тогда
					Результат = Результат+Символы.ПС+"Норма расхода: "+ ВыборкаДанныхНорм.НаименованиеНормы +" = "+СокрЛП(ВыборкаДанныхНорм.Значение)+" "+СокрЛП(ВыборкаДанныхНорм.ЕдиницаИзмерения);
					Результат = Результат + ?(ЗначениеЗаполнено(ВыборкаДанныхНорм.Параметр),Символы.ПС+"Основной параметр расчета: "+ ВыборкаДанныхНорм.Параметр +" = "+СокрЛП(ВыборкаДанныхНорм.ЗначениеПараметра)+" "+СокрЛП(ВыборкаДанныхНорм.ЕдиницаИзмеренияПараметра),"");
				Конецесли;
			Иначе
				Если (ВыборкаДанныхНорм.Норма.ВидНормы <> Перечисления.ВидыНормРасходаГСМ.НормаРасходаСмазочныхМатериалов) Тогда
					Результат = Результат+Символы.ПС+"Норма расхода: "+ ВыборкаДанныхНорм.НаименованиеНормы +" = "+СокрЛП(ВыборкаДанныхНорм.Значение)+" "+СокрЛП(ВыборкаДанныхНорм.ЕдиницаИзмерения);
					Результат = Результат + ?(ЗначениеЗаполнено(ВыборкаДанныхНорм.Параметр),Символы.ПС+"Основной параметр расчета: "+ ВыборкаДанныхНорм.Параметр +" = "+СокрЛП(ВыборкаДанныхНорм.ЗначениеПараметра)+" "+СокрЛП(ВыборкаДанныхНорм.ЕдиницаИзмеренияПараметра),"");
				Конецесли;
			Конецесли;
		КонецЕсли;
	КонецЦикла;	
	
	Пока ВыборкаДанныхПоправочныхЗначений.Следующий() Цикл
		Если ВыборкаДанныхПоправочныхЗначений.КлючСтроки = Ключ Тогда
			Если НЕ Топливо Тогда
				Если ВыборкаДанныхПоправочныхЗначений.ПоправочноеЗначение.ВидГСМ = ВидГСМ Тогда
					Результат = Результат+Символы.ПС+"Поправочное значение: "+ ВыборкаДанныхПоправочныхЗначений.НаименованиеЗначения +" = "+СокрЛП(ВыборкаДанныхПоправочныхЗначений.Значение)+" "+СокрЛП(ВыборкаДанныхПоправочныхЗначений.ЕдиницаИзмерения);
					Результат = Результат + " на " +СокрЛП(ВыборкаДанныхПоправочныхЗначений.ЗначениеОсновногоПараметраРасчета)+" "+СокрЛП(ВыборкаДанныхПоправочныхЗначений.ЕдиницаИзмеренияПараметра);
				КонецЕсли;
			Иначе
				Если ВыборкаДанныхПоправочныхЗначений.ПоправочноеЗначение.ВидГСМ = ВидГСМ Тогда
					Результат = Результат+Символы.ПС+"Поправочное значение: "+ ВыборкаДанныхПоправочныхЗначений.НаименованиеЗначения +" = "+СокрЛП(ВыборкаДанныхПоправочныхЗначений.Значение)+" "+СокрЛП(ВыборкаДанныхПоправочныхЗначений.ЕдиницаИзмерения);
					Результат = Результат + " на " +СокрЛП(ВыборкаДанныхПоправочныхЗначений.ЗначениеОсновногоПараметраРасчета)+" "+СокрЛП(ВыборкаДанныхПоправочныхЗначений.ЕдиницаИзмеренияПараметра);
				КонецЕсли;	
			КонецЕсли;		
		КонецЕсли;
	КонецЦикла;	
	
	Пока ВыборкаДанныхПоправочныхКоэффициентов.Следующий() Цикл
		Если ВыборкаДанныхПоправочныхКоэффициентов.КлючСтроки = Ключ Тогда
			Если НЕ Топливо Тогда
				Если ВыборкаДанныхПоправочныхКоэффициентов.ПоправочныйКоэффициент.ВидГСМ = ВидГСМ Тогда
					Результат = Результат+Символы.ПС+"Поправочный коэффициент: "+ ВыборкаДанныхПоправочныхКоэффициентов.НаименованиеКоэффициента +" = "+СокрЛП(ВыборкаДанныхПоправочныхКоэффициентов.Значение)+" %";
					Результат = Результат + " на 100 ед. топлива";
				КонецЕсли;
			Иначе
				Если ВыборкаДанныхПоправочныхКоэффициентов.ПоправочныйКоэффициент.ВидГСМ = ВидГСМ Тогда
					Результат = Результат+Символы.ПС+"Поправочный коэффициент: "+ ВыборкаДанныхПоправочныхКоэффициентов.НаименованиеКоэффициента +" = "+СокрЛП(ВыборкаДанныхПоправочныхКоэффициентов.Значение)+" %";
					Результат = Результат + " на 100 км";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Результат = СокрЛП(Результат);
	
	Возврат Результат;
КонецФункции	

Функция ПолучитьНормативныйРасходМаршрутаПоКлючу(ВыборкаМаршрутов, Ключ)
	Результат = 0;
	
