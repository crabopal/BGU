Процедура ИнициализироватьЗапросыНУ_Модернизация(Запрос, НомераТаблиц)
	НомераТаблиц.Вставить("ПервоначальныеСведенияОСНУ", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	
	"ВЫБРАТЬ
	|	ПервоначальныеСведенияОСНУ.ОсновноеСредство,
	|	ПервоначальныеСведенияОСНУ.ПорядокВключенияСтоимостиВСоставРасходов
	|ПОМЕСТИТЬ ПервоначальныеСведенияОСНУ
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСНалоговыйУчет.СрезПоследних(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ОСДокумента.ОсновноеСредство
	|					ИЗ
	|						ОСДокумента КАК ОСДокумента)) КАК ПервоначальныеСведенияОСНУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПервоначальныеСведенияОСНУ.ОсновноеСредство";
	
	НомераТаблиц.Вставить("ПараметрыАмортизацииОСНалоговыйУчет", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ДанныеДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.СрокПолезногоИспользованияПослеМодернизацииНУ КАК СрокПолезногоИспользования,
	|	ДанныеДокумента.Дата КАК Период
	|ИЗ
	|	ДанныеДокумента КАК ДанныеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПервоначальныеСведенияОСНУ КАК ПервоначальныеСведенияОСНУ
	|		ПО ДанныеДокумента.ОсновноеСредство = ПервоначальныеСведенияОСНУ.ОсновноеСредство
	|ГДЕ
	|	ПервоначальныеСведенияОСНУ.ПорядокВключенияСтоимостиВСоставРасходов 
	|		= ЗНАЧЕНИЕ(Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеДокумента.НомерСтроки";
	
	НомераТаблиц.Вставить("ПараметрыАмортизационнойПремииНалоговыйУчет", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ДанныеДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.СчетУчетаЗатратПоАмортизационнойПремии КАК СчетУчетаРасходов,
	|	ДанныеДокумента.СубконтоПоАмортизационнойПремии1 КАК СубконтоРасходов1,
	|	ДанныеДокумента.СубконтоПоАмортизационнойПремии2 КАК СубконтоРасходов2,
	|	ДанныеДокумента.СубконтоПоАмортизационнойПремии3 КАК СубконтоРасходов3,
	|	ДанныеДокумента.Подразделение КАК ПодразделениеРасходов,
	|	ДанныеДокумента.Дата КАК Период
	|ИЗ
	|	ДанныеДокумента КАК ДанныеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПервоначальныеСведенияОСНУ КАК ПервоначальныеСведенияОСНУ
	|		ПО ДанныеДокумента.ОсновноеСредство = ПервоначальныеСведенияОСНУ.ОсновноеСредство
	|ГДЕ
	|	ПервоначальныеСведенияОСНУ.ПорядокВключенияСтоимостиВСоставРасходов 
	|	= ЗНАЧЕНИЕ(Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации)
	|	И ДанныеДокумента.СуммаКапитальныхВложенийВключаемыхВРасходыНУ > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеДокумента.НомерСтроки";
		
