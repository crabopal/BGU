	|	ТаблицаНУ.Дата КАК Период,
	|	ТаблицаНУ.Организация КАК Организация,
	|	ТаблицаНУ.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаНУ.СрокПолезногоИспользованияНУ КАК СрокПолезногоИспользования
	|ИЗ
	|	ТаблицаНУ КАК ТаблицаНУ
	|ГДЕ
	|	ТаблицаНУ.ПорядокНачислениеАмортизации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаНУ.Дата КАК Период,
	|	ТаблицаНУ.Организация КАК Организация,
	|	ТаблицаНУ.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаНУ.СчетУчетаЗатратПоАмортизационнойПремии КАК СчетУчетаРасходов,
	|	ТаблицаНУ.СубконтоПоАмортизационнойПремии1 КАК СубконтоРасходов1,
	|	ТаблицаНУ.СубконтоПоАмортизационнойПремии2 КАК СубконтоРасходов2,
	|	ТаблицаНУ.СубконтоПоАмортизационнойПремии3 КАК СубконтоРасходов3,
	|	ТаблицаНУ.ПодразделениеПоАмортизационнойПремии КАК ПодразделениеРасходов
	|ИЗ
	|	ТаблицаНУ КАК ТаблицаНУ
	|ГДЕ
	|	ТаблицаНУ.ПорядокНачислениеАмортизации
	|	И ТаблицаНУ.ПроцентКапитальныхВложенийВключаемыхВРасходыНУ > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаНУ.Дата КАК Период,
	|	ТаблицаНУ.Организация КАК Организация,
	|	ТаблицаНУ.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаНУ.СпециальныйКоэффициентНУ КАК СпециальныйКоэффициент
	|ИЗ
	|	ТаблицаНУ КАК ТаблицаНУ
	|ГДЕ
	|	ТаблицаНУ.ПорядокНачислениеАмортизации";
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыУСН(Запрос, ТаблицыЗапроса)
	
	ТаблицыЗапроса.Добавить("ПервоначальныеСведенияОСНалоговыйУчетУСН");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ОсновныеСредства.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ПорядокВключенияСтоимостиВСоставРасходовУСН КАК ПорядокВключенияСтоимостиВСоставРасходовУСН,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ПорядокВключенияСтоимостиВСоставРасходовУСН = ЗНАЧЕНИЕ(Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА)
	|			ТОГДА ОсновныеСредства.СрокПолезногоИспользованияУСН
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СрокПолезногоИспользованияУСН
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ОсновныеСредства.Ссылка)
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И ОсновныеСредства.ИдентификаторСтроки В(&Одобренные)";
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, ТаблицыЗапроса)
	
	ТаблицыЗапроса.Добавить("ВТ_ОстаткиМЦКапвложения");
		ТаблицыЗапроса.Добавить("ВТ_ОстаткиМЦНаСчетах");
		ТаблицыЗапроса.Добавить("ВТ_ОстаткиМЦВсего");
		ТаблицыЗапроса.Добавить("НаличиеДрагМатериаловВОбъектахНФА");
		
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МЦСДрагоценнымиМатериалами.Ссылка КАК ДокументСсылка,
		|	МЦСДрагоценнымиМатериалами.ОбъектМЦ КАК ОбъектМЦ,
		|	МЦСДрагоценнымиМатериалами.Количество КАК КоличествоМЦ,
		|	ВЫРАЗИТЬ(МЦСДрагоценнымиМатериалами.Ссылка КАК Документ.РешениеОПризнанииОбъектовОС).Организация КАК Организация
		|ПОМЕСТИТЬ ОстаткиМЦКапвложения
		|ИЗ
		|	Документ.РешениеОПризнанииОбъектовОС.МЦСДрагоценнымиМатериалами КАК МЦСДрагоценнымиМатериалами
		|ГДЕ
		|	МЦСДрагоценнымиМатериалами.Ссылка = &Ссылка
		|	И МЦСДрагоценнымиМатериалами.Количество > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектМЦ,
		|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстаток
		|ПОМЕСТИТЬ ОстаткиМЦНаСчетах
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			Счет В (&МассивСчетовМЦ),
		|			&МассивСубконтоМЦ,
		|			Организация = &Организация
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						ОстаткиМЦКапвложения.ОбъектМЦ
		|					ИЗ
		|						ОстаткиМЦКапвложения КАК ОстаткиМЦКапвложения)) КАК ЖурналПроводокЕПСБУОстатки
		|ГДЕ
		|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОстатки.Субконто1,
		|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			Счет В (&МассивСчетовМЦ),
		|			&МассивСубконтоМЗ,
		|			Организация = &Организация
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						ОстаткиМЦКапвложения.ОбъектМЦ
		|					ИЗ
		|						ОстаткиМЦКапвложения КАК ОстаткиМЦКапвложения)) КАК ЖурналПроводокЕПСБУОстатки
		|ГДЕ
		|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
		|
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ 
		|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
		|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
		|			&Период,
		|			Организация = &Организация 
		|				И ИнвентарныйНомер = Значение(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) 
		|				И ОсновноеСредство В (ВЫБРАТЬ
		|						ОстаткиМЦКапвложения.ОбъектМЦ
		|					ИЗ
		|						ОстаткиМЦКапвложения КАК ОстаткиМЦКапвложения)) КАК СтоимостьОбъектовОСОстатки 
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство,
		|	СтоимостьОбъектовОСПоКонтрагентамОстатки.КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И ОсновноеСредство В (ВЫБРАТЬ
		|						ОстаткиМЦКапвложения.ОбъектМЦ
		|					ИЗ
		|						ОстаткиМЦКапвложения КАК ОстаткиМЦКапвложения)
		|               И ИнвентарныйНомер = Значение(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
		|				И (ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПолученоВПользование)
		|					ИЛИ ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении))) КАК СтоимостьОбъектовОСПоКонтрагентамОстатки
		|
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиМЦНаСчетах.ОбъектМЦ КАК ОбъектМЦ,
		|	СУММА(ОстаткиМЦНаСчетах.КоличествоОстаток) КАК КоличествоОстатокВсего
		|ПОМЕСТИТЬ ОстаткиМЦВсего
		|ИЗ
		|	ОстаткиМЦНаСчетах КАК ОстаткиМЦНаСчетах
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиМЦНаСчетах.ОбъектМЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
		|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.Ссылка.Дата
		|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
		|	КОНЕЦ КАК Период,
		|	РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.Ссылка КАК Регистратор,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
		|	РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
		|	РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.ОсновноеСредство КАК ОбъектНФА,
		|	РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.ИнвентарныйНомер КАК ИнвНомер,
		|	РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
		|	РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
		|	РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
		|	&ИмяДокумента КАК Основание,
		|	&НомерДокумента КАК НомерОснования,
		|	РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
		|	РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм
		|ИЗ
		|	Документ.РешениеОПризнанииОбъектовОС.ДрагоценныеМатериалы КАК РешениеОПризнанииОбъектовОСДрагоценныеМатериалы
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиМЦКапвложения КАК ОстаткиМЦКапвложения
		|		ПО (ОстаткиМЦКапвложения.ДокументСсылка = РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.Ссылка)
		|			И (ОстаткиМЦКапвложения.ОбъектМЦ = РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.ОсновноеСредство)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
		|		ПО (ДатыПроведенияДокументов.Документ = РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.Ссылка)
		|ГДЕ
		|	РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.Ссылка = &Ссылка
		|	И РешениеОПризнанииОбъектовОСДрагоценныеМатериалы.МассаДМ > 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
		|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА ОстаткиМЦКапвложения.ДокументСсылка.Дата
		|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
		|	КОНЕЦ,
		|	ОстаткиМЦКапвложения.ДокументСсылка,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
		|	0,
		|	ОстаткиМЦКапвложения.Организация,
		|	ОстаткиМЦКапвложения.ОбъектМЦ,
		|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
		|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала,
		|	ВЫБОР
		|		КОГДА ОстаткиМЦКапвложения.КоличествоМЦ = ОстаткиМЦВсего.КоличествоОстатокВсего
		|			ТОГДА НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток
		|		ИНАЧЕ НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток * ОстаткиМЦКапвложения.КоличествоМЦ / ОстаткиМЦВсего.КоличествоОстатокВсего
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ОстаткиМЦКапвложения.КоличествоМЦ = ОстаткиМЦВсего.КоличествоОстатокВсего
		|			ТОГДА НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток
		|		ИНАЧЕ НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток * ОстаткиМЦКапвложения.КоличествоМЦ / ОстаткиМЦВсего.КоличествоОстатокВсего
		|	КОНЕЦ,
		|	&ИмяДокумента,
		|	&НомерДокумента,
		|	ОстаткиМЦКапвложения.ДокументСсылка.Дата,
		|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм
		|ИЗ
		|	ОстаткиМЦКапвложения КАК ОстаткиМЦКапвложения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&Период, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
		|		ПО ОстаткиМЦКапвложения.ОбъектМЦ = НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА
		|			И (НаличиеДрагМатериаловВОбъектахНФАОстатки.Организация = ОстаткиМЦКапвложения.Организация)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиМЦВсего КАК ОстаткиМЦВсего
		|		ПО (ОстаткиМЦВсего.ОбъектМЦ = ОстаткиМЦКапвложения.ОбъектМЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
		|		ПО (ДатыПроведенияДокументов.Документ = ОстаткиМЦКапвложения.ДокументСсылка)
		|ГДЕ
		|	ОстаткиМЦКапвложения.ДокументСсылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки"; 
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, ТаблицыЗапроса)
	
	ТаблицыЗапроса.Добавить("ОтражениеЭДВУчете");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	РегистрыНакопления.ОтражениеЭДВУчете.ТекстЗапросаПоОтражениюЭДВУчете(Запрос.Параметры.Ссылка);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПрослеживаемости(Запрос, ТаблицыЗапроса, ЗначенияРеквизитов)
	
	Если ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийПризнанияОС.Приобретение
		Или ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийПризнанияОС.Изготовление Тогда
		ИнициализироватьЗапросыПрослеживаемыеОС(Запрос, ТаблицыЗапроса);
	Иначе
		ИнициализироватьЗапросыПрослеживаемыеОСПоТаблице(Запрос, ТаблицыЗапроса);
	КонецЕсли;
	
	ТаблицыЗапроса.Добавить("ТаблицаРНПТ");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СведенияПрослеживаемости.Ссылка.Организация КАК Организация,
	|	СведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	СведенияПрослеживаемости.Ссылка.Дата КАК ДатаПоступления
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.СведенияПрослеживаемости КАК СведенияПрослеживаемости
	|ГДЕ
	|	СведенияПрослеживаемости.Ссылка = &Ссылка";
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПрослеживаемыеОСПоТаблице(Запрос, ТаблицыЗапроса)
	
	ТаблицыЗапроса.Добавить("ПрослеживаемыеОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	РешениеОПризнанииОбъектовОСОсновныеСредства.Ссылка.Дата КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	РешениеОПризнанииОбъектовОСОсновныеСредства.Ссылка.Организация КАК Организация,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	РешениеОПризнанииОбъектовОСОсновныеСредства.СтранаПроисхождения КАК СтранаПроисхождения,
	|	РешениеОПризнанииОбъектовОСОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Количество КАК Количество,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Количество * РешениеОПризнанииОбъектовОСОсновныеСредства.Сумма / РешениеОПризнанииОбъектовОСОсновныеСредства.Количество КАК СуммаБезНДС
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.ОсновныеСредства КАК РешениеОПризнанииОбъектовОСОсновныеСредства
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОПризнанииОбъектовОС.СведенияПрослеживаемости КАК РешениеОПризнанииОбъектовОССведенияПрослеживаемости
	|		ПО РешениеОПризнанииОбъектовОСОсновныеСредства.ИдентификаторСтроки = РешениеОПризнанииОбъектовОССведенияПрослеживаемости.ИдентификаторСтроки
	|ГДЕ
	|	РешениеОПризнанииОбъектовОСОсновныеСредства.Ссылка = &Ссылка
	|	И РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка = &Ссылка";
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПрослеживаемыеОС(Запрос, ТаблицыЗапроса)
	
	ТаблицыЗапроса.Добавить("ВТ_ОстаткиСоСтраной");
	ТаблицыЗапроса.Добавить("ПрослеживаемыеОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПрослеживаемыеОСОстатки.РНПТ КАК РНПТ,
	|	ПрослеживаемыеОСОстатки.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПрослеживаемыеОСОстатки.Комплектующее КАК Комплектующее,
	|	ПрослеживаемыеОСОстатки.СуммаБезНДСОстаток КАК СуммаБезНДСОстаток,
	|	ПрослеживаемыеОСОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ ОстаткиСоСтраной
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеОС.Остатки(
	|			&ГраницаДокумента,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ВнеоборотныйАктив) КАК ПрослеживаемыеОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка.Дата КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка.Организация КАК Организация,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	ОстаткиСоСтраной.СтранаПроисхождения КАК СтранаПроисхождения,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка.КапитальноеВложение КАК ОсновноеСредство,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Комплектующее КАК Комплектующее,
	|	СУММА(РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Количество) КАК Количество,
	|	СУММА(РешениеОПризнанииОбъектовОССведенияПрослеживаемости.КоличествоПрослеживаемости) КАК КоличествоПрослеживаемости,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(ОстаткиСоСтраной.КоличествоОстаток, 0) = 0
	|				ТОГДА 0
	|			ИНАЧЕ РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Количество * ОстаткиСоСтраной.СуммаБезНДСОстаток / ОстаткиСоСтраной.КоличествоОстаток
	|		КОНЕЦ) КАК СуммаБезНДС
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.СведенияПрослеживаемости КАК РешениеОПризнанииОбъектовОССведенияПрослеживаемости
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОПризнанииОбъектовОС.ОсновныеСредства КАК РешениеОПризнанииОбъектовОСОсновныеСредства
	|		ПО РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка = РешениеОПризнанииОбъектовОСОсновныеСредства.Ссылка
	|			И РешениеОПризнанииОбъектовОССведенияПрослеживаемости.ИдентификаторСтроки = РешениеОПризнанииОбъектовОСОсновныеСредства.ИдентификаторСтроки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиСоСтраной КАК ОстаткиСоСтраной
	|		ПО РешениеОПризнанииОбъектовОССведенияПрослеживаемости.РНПТ = ОстаткиСоСтраной.РНПТ
	|			И РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Комплектующее = ОстаткиСоСтраной.Комплектующее
	|ГДЕ
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка.Дата,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка.Организация,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.РНПТ,
	|	ОстаткиСоСтраной.СтранаПроисхождения,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка.КапитальноеВложение,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Комплектующее
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка.Дата,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка.Организация,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.РНПТ,
	|	ОстаткиСоСтраной.СтранаПроисхождения,
	|	РешениеОПризнанииОбъектовОСОсновныеСредства.ОсновноеСредство,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Комплектующее,
	|	СУММА(РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Количество),
	|	СУММА(РешениеОПризнанииОбъектовОССведенияПрослеживаемости.КоличествоПрослеживаемости),
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(ОстаткиСоСтраной.КоличествоОстаток, 0) = 0
	|				ТОГДА 0
	|			ИНАЧЕ РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Количество * ОстаткиСоСтраной.СуммаБезНДСОстаток / ОстаткиСоСтраной.КоличествоОстаток
	|		КОНЕЦ)
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.СведенияПрослеживаемости КАК РешениеОПризнанииОбъектовОССведенияПрослеживаемости
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОПризнанииОбъектовОС.ОсновныеСредства КАК РешениеОПризнанииОбъектовОСОсновныеСредства
	|		ПО РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка = РешениеОПризнанииОбъектовОСОсновныеСредства.Ссылка
	|			И РешениеОПризнанииОбъектовОССведенияПрослеживаемости.ИдентификаторСтроки = РешениеОПризнанииОбъектовОСОсновныеСредства.ИдентификаторСтроки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиСоСтраной КАК ОстаткиСоСтраной
	|		ПО РешениеОПризнанииОбъектовОССведенияПрослеживаемости.РНПТ = ОстаткиСоСтраной.РНПТ
	|			И РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Комплектующее = ОстаткиСоСтраной.Комплектующее
	|ГДЕ
	|	РешениеОПризнанииОбъектовОСОсновныеСредства.Ссылка = &Ссылка
	|	И РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка.Дата,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Ссылка.Организация,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.РНПТ,
	|	ОстаткиСоСтраной.СтранаПроисхождения,
	|	РешениеОПризнанииОбъектовОСОсновныеСредства.ОсновноеСредство,
	|	РешениеОПризнанииОбъектовОССведенияПрослеживаемости.Комплектующее";
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация_Модернизация

Процедура ИнициализироватьДанныеДокумента_Модернизация(
	ДокументСсылка, СтруктураДополнительныеСвойства, ЗначенияРеквизитов)

	// Делать движения по регистру сведений "Учетные данные ОС" при отражении операции модернизиции не надо
	СтруктураДополнительныеСвойства.Вставить("НеФормироватьУчетныеДанныеИзПроводок");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("Организация", ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("УчетПоПодразделениям", 
		УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям());
	Запрос.УстановитьПараметр("ВозможныГарантийныеОбязательства", 
		ВозможныГарантийныеОбязательства(ЗначенияРеквизитов.ВидОперации));
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("ОСДокумента", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ ОСДокумента
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.ОсновныеСредства КАК ТЧОсновныеСредства
	|ГДЕ
	|	ТЧОсновныеСредства.Ссылка = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство";
	
	НомераТаблиц.Вставить("ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ПорядокПогашенияСтоимости,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации
	|ПОМЕСТИТЬ ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ОСДокумента.ОсновноеСредство
	|					ИЗ
	|						ОСДокумента КАК ОСДокумента)) КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство";
	
	НомераТаблиц.Вставить("СобытияОССрезПоследних", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер,
	|	СобытияОССрезПоследних.ДатаСобытия КАК ДатаВводаВЭксплуатацию
	|ПОМЕСТИТЬ СобытияОССрезПоследних
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ОСДокумента.ОсновноеСредство
	|					ИЗ
	|						ОСДокумента КАК ОСДокумента)
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)) КАК СобытияОССрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СобытияОССрезПоследних.ОсновноеСредство";
	
	НомераТаблиц.Вставить("РасчетАмортизацииОССрезПоследних", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	РасчетАмортизацииОССрезПоследних.ОсновноеСредство,
	|	РасчетАмортизацииОССрезПоследних.КоэффициентУскорения,
	|	РасчетАмортизацииОССрезПоследних.ПараметрВыработки
	|ПОМЕСТИТЬ РасчетАмортизацииОССрезПоследних
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ОСДокумента.ОсновноеСредство
	|					ИЗ
	|						ОСДокумента КАК ОСДокумента)) КАК РасчетАмортизацииОССрезПоследних";
	
	НомераТаблиц.Вставить("СтоимостьОстатки", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.Договор КАК Договор
	|ПОМЕСТИТЬ СтоимостьОстатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ОСДокумента.ОсновноеСредство
	|					ИЗ
	|						ОСДокумента КАК ОСДокумента)
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки";
	
	НомераТаблиц.Вставить("ВидыРабот", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ТЧВидыРабот.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧВидыРабот.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТЧВидыРабот.ВидРаботы КАК ВидРаботы,
	|	СУММА(ТЧВидыРабот.СуммаМодернизации + ТЧВидыРабот.СуммаДемонтажа + ТЧВидыРабот.СуммаТранспортировки) КАК
	|		СуммаМодернизации
	|ПОМЕСТИТЬ ВидыРабот
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.СведенияОВидахРабот КАК ТЧВидыРабот
	|ГДЕ
	|	ТЧВидыРабот.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ТЧВидыРабот.ОсновноеСредство,
	|	ТЧВидыРабот.ИнвентарныйНомер,
	|	ТЧВидыРабот.ВидРаботы";
	
	НомераТаблиц.Вставить("ДанныеДокумента", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ТЧОсновныеСредства.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Дата,
	|	ТЧОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ТЧОсновныеСредства.Ссылка.Подразделение КАК Подразделение,
	|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТЧОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА ТЧОсновныеСредства.Ссылка.ДокументОснование ССЫЛКА Документ.РеконструкцияОС
	|		И ТЧОсновныеСредства.Ссылка.ДокументОснование <> Значение(Документ.РеконструкцияОС.ПустаяСсылка)
	|			ТОГДА ТЧОсновныеСредства.Ссылка.ДокументОснование.ВидПервичногоДокумента
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НазваниеДокумента,
	|	ВЫБОР
	|		КОГДА ТЧОсновныеСредства.Ссылка.ДокументОснование ССЫЛКА Документ.РеконструкцияОС
	|		И ТЧОсновныеСредства.Ссылка.ДокументОснование <> Значение(Документ.РеконструкцияОС.ПустаяСсылка)
	|			ТОГДА ТЧОсновныеСредства.Ссылка.ДокументОснование.НомерПервичногоДокумента
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НомерДокумента,
	|	ВЫБОР
	|		КОГДА ТЧОсновныеСредства.Ссылка.ДокументОснование ССЫЛКА Документ.РеконструкцияОС
	|		И ТЧОсновныеСредства.Ссылка.ДокументОснование <> Значение(Документ.РеконструкцияОС.ПустаяСсылка)
	|			ТОГДА ТЧОсновныеСредства.Ссылка.ДокументОснование.ДатаПервичногоДокумента
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ДатаДокумента,
	|	ВЫБОР
	|		КОГДА &ВозможныГарантийныеОбязательства
	|			ТОГДА ТЧОсновныеСредства.НаименованиеГТ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НаименованиеГТ,
	|	ВЫБОР
	|		КОГДА &ВозможныГарантийныеОбязательства
	|			ТОГДА ТЧОсновныеСредства.НомерГТ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НомерГТ,
	|	ВЫБОР
	|		КОГДА &ВозможныГарантийныеОбязательства
	|			ТОГДА ТЧОсновныеСредства.ДатаГТ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ДатаГТ,
	|	ВЫБОР
	|		КОГДА &ВозможныГарантийныеОбязательства
	|			ТОГДА ТЧОсновныеСредства.СрокДействияГТ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК СрокДействияГТ,
	|	ТЧОсновныеСредства.Ссылка.Договор КАК ДоговорИсполнителя,
	|	ЕстьNULL(ВидыРабот.ВидРаботы, """") КАК ВидРаботы,
	|	ТЧОсновныеСредства.Ссылка.ЦМО КАК ЦМО,
	|	ТЧОсновныеСредства.ОстаточнаяСтоимость КАК ОстаточнаяСтоимость,
	|	ТЧОсновныеСредства.ФактическийСрокЭксплуатации КАК СрокЭксплуатацииФакт,
	|	ТЧОсновныеСредства.СрокПолезногоИспользования КАК СрокПолезногоИспользованияПослеМодернизации,
	|	ТЧОсновныеСредства.СрокПолезногоИспользованияНУ КАК СрокПолезногоИспользованияПослеМодернизацииНУ,
	|	ТЧОсновныеСредства.ПредполагаемыйОбъемВыработки КАК ПредполагаемыйОбъемВыработкиПослеМодернизации,
	|	ТЧОсновныеСредства.СчетУчетаЗатратПоАмортизационнойПремии КАК СчетУчетаЗатратПоАмортизационнойПремии,
	|	ТЧОсновныеСредства.СубконтоПоАмортизационнойПремии1 КАК СубконтоПоАмортизационнойПремии1,
	|	ТЧОсновныеСредства.СубконтоПоАмортизационнойПремии2 КАК СубконтоПоАмортизационнойПремии2,
	|	ТЧОсновныеСредства.СубконтоПоАмортизационнойПремии3 КАК СубконтоПоАмортизационнойПремии3,
	|	ТЧОсновныеСредства.СуммаКапитальныхВложенийВключаемыхВРасходыНУ КАК СуммаКапитальныхВложенийВключаемыхВРасходыНУ,
	|	ТЧОсновныеСредства.Сумма КАК СуммаМодернизации,
	|	ТЧОсновныеСредства.Сумма1 КАК Сумма1,
	|	ТЧОсновныеСредства.Сумма2 КАК Сумма2,
	|	ТЧОсновныеСредства.Сумма4 КАК Сумма4,
	|	ТЧОсновныеСредства.Сумма5 КАК Сумма5,
	|	ТЧОсновныеСредства.Сумма6 КАК Сумма6,
	|	ТЧОсновныеСредства.Сумма7 КАК Сумма7,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
	|	ЕСТЬNULL(СобытияОССрезПоследних.ДатаВводаВЭксплуатацию, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВводаВЭксплуатацию,
	|	РасчетАмортизацииОССрезПоследних.КоэффициентУскорения КАК КоэффициентУскорения,
	|	РасчетАмортизацииОССрезПоследних.ПараметрВыработки КАК ПараметрВыработки,
	|	СтоимостьОстатки.Договор КАК Договор
	|ПОМЕСТИТЬ ДанныеДокумента
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.ОсновныеСредства КАК ТЧОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних КАК
	|			ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	|		ПО ТЧОсновныеСредства.ОсновноеСредство = ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ СобытияОССрезПоследних КАК СобытияОССрезПоследних
	|		ПО ТЧОсновныеСредства.ОсновноеСредство = СобытияОССрезПоследних.ОсновноеСредство
	|		И ТЧОсновныеСредства.ИнвентарныйНомер = СобытияОССрезПоследних.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ РасчетАмортизацииОССрезПоследних КАК РасчетАмортизацииОССрезПоследних
	|		ПО ТЧОсновныеСредства.ОсновноеСредство = РасчетАмортизацииОССрезПоследних.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтоимостьОстатки КАК СтоимостьОстатки
	|		ПО ТЧОсновныеСредства.ОсновноеСредство = СтоимостьОстатки.ОсновноеСредство
	|		И ТЧОсновныеСредства.ИнвентарныйНомер = СтоимостьОстатки.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВидыРабот КАК ВидыРабот
	|		ПО ТЧОсновныеСредства.ОсновноеСредство = ВидыРабот.ОсновноеСредство
	|		И ТЧОсновныеСредства.ИнвентарныйНомер = ВидыРабот.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ТЧОсновныеСредства.Ссылка)
	|ГДЕ
	|	ТЧОсновныеСредства.Ссылка = &Ссылка";
	
	ИнициализироватьЗапросыБУ_Модернизация(Запрос, НомераТаблиц);
	
	#Область НалоговыйУчет
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВНалоговомУчетеМодернизацию(ЗначенияРеквизитов) Тогда
		ИнициализироватьЗапросыНУ_Модернизация(Запрос, НомераТаблиц);
	КонецЕсли;

	#КонецОбласти
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
	
КонецПроцедуры	

Процедура ИнициализироватьЗапросыБУ_Модернизация(Запрос, НомераТаблиц)
	НомераТаблиц.Вставить("СтоимостьОбъектовОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе) КАК ВидРаспоряжения,
	|	ДанныеДокумента.Дата КАК Период,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ДанныеДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ДанныеДокумента.ЦМО КАК ЦМО,
	|	ДанныеДокумента.Договор КАК Договор,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ДанныеДокумента.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ДанныеДокумента.СуммаМодернизации КАК Стоимость,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Реконструкция) КАК Событие,
	|	ДанныеДокумента.НазваниеДокумента КАК НазваниеДокумента,
	|	ДанныеДокумента.НомерДокумента КАК НомерДокумента,
	|	ДанныеДокумента.ДатаДокумента КАК ДатаДокумента,
	|	ДанныеДокумента.ДоговорИсполнителя КАК ДоговорИсполнителя,
	|	ДанныеДокумента.ВидРаботы КАК ВидРаботы
	|ИЗ
	|	ДанныеДокумента КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.СуммаМодернизации <> 0";
	
	НомераТаблиц.Вставить("АмортизацияОбъектовОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ДанныеДокумента.Дата КАК Период,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ДанныеДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ДанныеДокумента.СуммаМодернизации КАК СуммаАмортизации
	|ИЗ
	|	ДанныеДокумента КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|	И ДанныеДокумента.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию)
	|	И ДанныеДокумента.ДатаВводаВЭксплуатацию <> ДАТАВРЕМЯ(1, 1, 1)
	|	И ДанныеДокумента.СуммаМодернизации <> 0";
	
	НомераТаблиц.Вставить("РасчетАмортизацииОС", НомераТаблиц.Количество());              
	// группировка в запросе, на случай, если модернизируются ОС с групповым инвентарным учетом,
	// тогда в ДанныеДокумента будет столько строк, сколько инвентарных номеров, но в регистре "РасчетАмортизацииОС"
	// данные хранятся для объекта в целом, без инвентарных номеров.
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ДанныеДокумента.Дата КАК Период,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	МАКСИМУМ(ДанныеДокумента.СрокПолезногоИспользованияПослеМодернизации) КАК СрокПолезногоИспользования,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ДанныеДокумента.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)
	|					ИЛИ ДанныеДокумента.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка)
	|				ТОГДА ВЫБОР
	|						КОГДА ДанныеДокумента.СрокПолезногоИспользованияПослеМодернизации > ДанныеДокумента.СрокЭксплуатацииФакт
	|							ТОГДА ДанныеДокумента.СрокПолезногоИспользованияПослеМодернизации - ДанныеДокумента.СрокЭксплуатацииФакт
	|						ИНАЧЕ 1
	|					КОНЕЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СрокИспользованияДляВычисленияАмортизации,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ДанныеДокумента.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)
	|					ИЛИ ДанныеДокумента.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка)
	|					ИЛИ ДанныеДокумента.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции)
	|				ТОГДА ДанныеДокумента.ОстаточнаяСтоимость + ДанныеДокумента.СуммаМодернизации
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СтоимостьДляВычисленияАмортизации,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ДанныеДокумента.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка)
	|				ТОГДА ДанныеДокумента.КоэффициентУскорения
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоэффициентУскорения,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ДанныеДокумента.СпособНачисленияАмортизации 
	|				= ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции)
	|				ТОГДА ДанныеДокумента.ПараметрВыработки
	|			ИНАЧЕ NULL
	|		КОНЕЦ) КАК ПараметрВыработки,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ДанныеДокумента.СпособНачисленияАмортизации 
	|				= ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции)
	|				ТОГДА ДанныеДокумента.ПредполагаемыйОбъемВыработкиПослеМодернизации
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ПредполагаемыйОбъемВыработки,
	|	МИНИМУМ(ДанныеДокумента.НомерСтроки) КАК НомерСтроки
	|ИЗ
	|	ДанныеДокумента КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.Дата,
	|	ДанныеДокумента.Организация,
	|	ДанныеДокумента.ОсновноеСредство
	|
	|УПОРЯДОЧИТЬ ПО
	|	МИНИМУМ(ДанныеДокумента.НомерСтроки)";

	НомераТаблиц.Вставить("КапРемонтОС", НомераТаблиц.Количество());
