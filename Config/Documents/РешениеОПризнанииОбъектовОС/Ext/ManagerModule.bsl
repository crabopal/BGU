	// Бухгалтерский учет
	ИнициализироватьЗапросыБУ(Запрос, ТаблицыЗапроса, ЗначенияРеквизитов, СтруктураДополнительныеСвойства);
	
	// Налоговый учет
	Если НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(ЗначенияРеквизитов.Организация, ЗначенияРеквизитов.Дата, ЗначенияРеквизитов.КФО) Тогда
		ИнициализироватьЗапросыНУ(Запрос, ТаблицыЗапроса);
	КонецЕсли;
	
	// Упрощенная система налогообложения
