	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПараметрыАмортизацииОСБухгалтерскийУчет.Организация КАК Организация,
	|	ПараметрыАмортизацииОСБухгалтерскийУчет.ОсновноеСредство КАК ОсновноеСредство,
	|	ПараметрыАмортизацииОСБухгалтерскийУчет.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации
	|ПОМЕСТИТЬ ПараметрыАмортизацииСрез
	|ИЗ
	|	ДатыПараметровАмортизации КАК ДатыПараметровАмортизации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет КАК
	|			ПараметрыАмортизацииОСБухгалтерскийУчет
	|		ПО ДатыПараметровАмортизации.Организация = ПараметрыАмортизацииОСБухгалтерскийУчет.Организация
	|		И ДатыПараметровАмортизации.ОсновноеСредство = ПараметрыАмортизацииОСБухгалтерскийУчет.ОсновноеСредство
	|		И ДатыПараметровАмортизации.Период = ПараметрыАмортизацииОСБухгалтерскийУчет.Период
	|СГРУППИРОВАТЬ ПО
	|	ПараметрыАмортизацииОСБухгалтерскийУчет.Организация,
	|	ПараметрыАмортизацииОСБухгалтерскийУчет.ОсновноеСредство,
	|	ПараметрыАмортизацииОСБухгалтерскийУчет.СпособНачисленияАмортизации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧОС1.Ссылка КАК Ссылка,
	|	ТЧОС1.НомерСтроки КАК НомерСтроки,
	|	ТЧОС1.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧОС1.НаименованиеОС КАК НаименованиеОС,
	|	ТЧОС1.КодОбъекта КАК КодОбъекта,
	|	ТЧОС1.Сведения КАК Сведения,
	|	ТЧОС1.МожетСодержатьДрагМатериалы КАК МожетСодержатьДрагМатериалы,
	|	ТЧОС1.АмортизационнаяГруппа КАК АмортизационнаяГруппа,
	|	ТЧОС1.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТЧОС1.ДатаВыпуска КАК ДатаВыпуска,
	|	ТЧОС1.РеестровыйНомер КАК РеестровыйНомер,
	|	ТЧОС1.ЗаводскойНомер КАК ЗаводскойНомер,
	|	ТЧОС1.ИнойНомер КАК ИнойНомер,
	|	ВЫБОР
	|		КОГДА ТЧОС1.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПризнанияОС.Модернизация)
	|			ТОГДА ТЧОС1.СтоимостьБалансовая
	|		ИНАЧЕ ТЧОС1.Сумма
	|	КОНЕЦ КАК Сумма,
	|	ТЧОС1.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ТЧОС1.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПризнанияОС.Модернизация)
	|			ТОГДА ВЫБОР
	|				КОГДА ТЧОС1.Количество <> 0
	|					ТОГДА ТЧОС1.СтоимостьБалансовая / ТЧОС1.Количество
	|				ИНАЧЕ ТЧОС1.СтоимостьБалансовая
	|			КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|			КОГДА ТЧОС1.Количество <> 0
	|				ТОГДА ТЧОС1.Сумма / ТЧОС1.Количество
	|			ИНАЧЕ ТЧОС1.Сумма
	|		КОНЕЦ
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА ТЧОС1.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПризнанияОС.Модернизация)
	|			ТОГДА ЕСТЬNULL(СуммыАмортизации.СуммаАмортизацииПриход, 0) - ЕСТЬNULL(СуммыАмортизации.СуммаАмортизацииРасход, 0)
	|		ИНАЧЕ ТЧОС1.СуммаАмортизации
	|	КОНЕЦ КАК СуммаАмортизации,
	|	ТЧОС1.СуммаОбесценения КАК СуммаОбесценения,
	|	ВЫБОР
	|		КОГДА ТЧОС1.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПризнанияОС.Модернизация)
	|			ТОГДА ЕСТЬNULL(ДатыСобытий.ДатаВводаВЭксплуатацию, ДАТАВРЕМЯ(1, 1, 1))
	|		ИНАЧЕ ТЧОС1.ДатаВводаВЭксплуатацию
	|	КОНЕЦ КАК ДатаВводаВЭксплуатацию,
	|	ТЧОС1.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
	|	ВЫБОР
	|		КОГДА ТЧОС1.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПризнанияОС.Модернизация)
	|		И НЕ ПараметрыАмортизацииСрез.СпособНачисленияАмортизации ЕСТЬ NULL
	|			ТОГДА ПараметрыАмортизацииСрез.СпособНачисленияАмортизации
	|		ИНАЧЕ ТЧОС1.СпособНачисленияАмортизации
	|	КОНЕЦ КАК СпособНачисленияАмортизации,
	|	ТЧОС1.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТЧОС1.РезолюцияКомиссии КАК РезолюцияКомиссии,
	|	ТЧОС1.Местонахождение КАК Местонахождение,
	|	ТЧОС1.МестонахождениеОС КАК МестонахождениеОС,
	|	ВЫБОР
	|		КОГДА ТЧОС1.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПризнанияОС.Модернизация)
	|			ТОГДА ВЫБОР
	|					КОГДА ПараметрыАмортизацииСрез.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)
	|							И НЕ ДатыСобытий.ДатаПринятияКУчету ЕСТЬ NULL
	|						ТОГДА ВЫБОР
	|								КОГДА НЕ ДатыСобытий.ДатаВводаВЭксплуатацию ЕСТЬ NULL
	|										И ДатыСобытий.ДатаПринятияКУчету > ДатыСобытий.ДатаВводаВЭксплуатацию
	|									ТОГДА ВЫБОР
	|											КОГДА УчетнаяПолитика.НачислятьАмортизациюПервымЧислом
	|												ТОГДА НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(ДатыСобытий.ДатаВводаВЭксплуатацию, МЕСЯЦ, ТЧОС1.СрокПолезногоИспользования), МЕСЯЦ)
	|											ИНАЧЕ КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(ДатыСобытий.ДатаВводаВЭксплуатацию, МЕСЯЦ, ТЧОС1.СрокПолезногоИспользования), МЕСЯЦ)
	|										КОНЕЦ
	|								ИНАЧЕ ВЫБОР
	|										КОГДА УчетнаяПолитика.НачислятьАмортизациюПервымЧислом
	|											ТОГДА НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(ДатыСобытий.ДатаПринятияКУчету, МЕСЯЦ, ТЧОС1.СрокПолезногоИспользования), МЕСЯЦ)
	|										ИНАЧЕ КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(ДатыСобытий.ДатаПринятияКУчету, МЕСЯЦ, ТЧОС1.СрокПолезногоИспользования), МЕСЯЦ)
	|									КОНЕЦ
	|							КОНЕЦ
	|					ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|				КОНЕЦ
	|		ИНАЧЕ ТЧОС1.ДатаОкончанияАмортизации
	|	КОНЕЦ КАК ДатаОкончанияАмортизации
	|ПОМЕСТИТЬ ТЧОС
	|ИЗ
	|	ТЧОС1 КАК ТЧОС1
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДатыСобытий КАК ДатыСобытий
	|		ПО ТЧОС1.ОсновноеСредство = ДатыСобытий.ОсновноеСредство
	|		И ТЧОС1.ИнвентарныйНомер = ДатыСобытий.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ СуммыАмортизации КАК СуммыАмортизации
	|		ПО ТЧОС1.ОсновноеСредство = СуммыАмортизации.ОсновноеСредство
	|		И ТЧОС1.ИнвентарныйНомер = СуммыАмортизации.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПараметрыАмортизацииСрез КАК ПараметрыАмортизацииСрез
	|		ПО ТЧОС1.ОсновноеСредство = ПараметрыАмортизацииСрез.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетнаяПолитика КАК УчетнаяПолитика
	|		ПО (ТЧОС1.Организация = УчетнаяПолитика.Организация)";
	
	ИмяДокумента = Метаданные.НайтиПоТипу(ТипДокумента.Ключ).Имя;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.РешениеОПризнанииОбъектовОС", "Документ." + ИмяДокумента); 

	СтрокаПринятиеКУчетуОдновременноСВводомВЭксплуатацию = "ОсновныеСредства.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию"; 
	Если ИмяДокумента = "РешениеОПризнанииОбъектовОСИК" Тогда
		СтрокаПринятиеКУчетуОдновременноСВводомВЭксплуатацию = "ЛОЖЬ"; 
	КонецЕсли;	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПринятиеКУчетуОдновременноСВводомВЭксплуатацию", СтрокаПринятиеКУчетуОдновременноСВводомВЭксплуатацию); 
	
КонецПроцедуры

Процедура СформироватьТекстЗапросаТЧДрагМатериалы(ТипДокумента, ТекстЗапроса)
	ДобавитьОбъединениеВТекстЗапроса(ТекстЗапроса);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДрагоценныеМатериалы.ОсновноеСредство КАК ОсновноеСредство,
	|	ДрагоценныеМатериалы.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ДрагоценныеМатериалы.ВидДрагМатериала КАК Драгметалл,
	|	ДрагоценныеМатериалы.ЕдИзм КАК НаименованиеЕИ,
	|	ДрагоценныеМатериалы.ЕдИзм.Код КАК КодЕИ,
	|	ДрагоценныеМатериалы.МассаДМ КАК Количество
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.ДрагоценныеМатериалы КАК ДрагоценныеМатериалы
	|ГДЕ
	|	ДрагоценныеМатериалы.Ссылка В (&МассивОбъектов)";
	
	ИмяДокумента = Метаданные.НайтиПоТипу(ТипДокумента.Ключ).Имя;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.РешениеОПризнанииОбъектовОС", "Документ." + ИмяДокумента); 
	
КонецПроцедуры

Процедура СформироватьТекстЗапросаТЧСведенияОРаботах(ТипДокумента, ТекстЗапроса)
	ДобавитьОбъединениеВТекстЗапроса(ТекстЗапроса);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.Ссылка КАК Ссылка,
	|	РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.ОсновноеСредство.Наименование
	|		ИНАЧЕ РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОС,
	|	РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.ОсновноеСредство.АмортизационнаяГруппа.Порядок + 1 КАК
	|		АмортизационнаяГруппа,
	|	РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.ВидРаботы КАК ВидРаботы,
	|	РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.СуммаДемонтажа КАК Демонтаж,
	|	РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.СуммаТранспортировки КАК Транспортировка,
	|	РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.СуммаРемонта КАК Ремонт,
	|	РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.СуммаМодернизации КАК Модернизация,
	|	РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.СтоимостьПоОкончанииРабот КАК Стоимость,
	|	ТЧОС.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(ТЧОС.СрокПолезногоИспользования, 0) КАК СрокПолезногоИспользования,
	|	ЕСТЬNULL(ТЧОС.СпособНачисленияАмортизации, """") КАК СпособНачисленияАмортизации,
	|	ЕСТЬNULL(ТЧОС.ДатаОкончанияАмортизации, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОкончанияАмортизации,
	|	РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.НомерСтроки КАК НомерСтрокиПорядок
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.СведенияОВидахРабот КАК РешениеОПризнанииОбъектовНФАСведенияОВидахРабот
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТЧОС КАК ТЧОС
	|		ПО РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.Ссылка = ТЧОС.Ссылка
	|		И РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.ОсновноеСредство = ТЧОС.ОсновноеСредство
	|		И РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.ИнвентарныйНомер = ТЧОС.ИнвентарныйНомер
	|ГДЕ
	|	РешениеОПризнанииОбъектовНФАСведенияОВидахРабот.Ссылка В (&МассивОбъектов)";
	
	ИмяДокумента = Метаданные.НайтиПоТипу(ТипДокумента.Ключ).Имя;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.РешениеОПризнанииОбъектовОС", "Документ." + ИмяДокумента); 
	
КонецПроцедуры

Функция ДанныеДляПечати(МассивОбъектов)

	Запрос = Новый Запрос;
	ТекстШапки = "";                                        
	ТекстТЧОС = "";
	ТекстТЧДрагМатериалы = "";
	ТекстТЧСведенияОРаботах = "";
	Для Каждого ТипДокумента Из ОбщегоНазначенияБГУ.ДокументыПоТипам(МассивОбъектов) Цикл
		СформироватьТекстЗапросаШапка(ТипДокумента, ТекстШапки);
		СформироватьТекстЗапросаТЧОС(ТипДокумента, ТекстТЧОС);
		СформироватьТекстЗапросаТЧДрагМатериалы(ТипДокумента, ТекстТЧДрагМатериалы);
		СформироватьТекстЗапросаТЧСведенияОРаботах(ТипДокумента, ТекстТЧСведенияОРаботах);
	КонецЦикла;

	ТекстШапки = ТекстШапки + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документ.Дата,
	|	Документ.Номер";                     

	ТекстТЧДрагМатериалы = ТекстТЧДрагМатериалы + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДрагоценныеМатериалы.НомерСтроки
	|ИТОГИ
	|ПО
	|	ОсновноеСредство";
	
	ТекстТЧСведенияОРаботах = ТекстТЧСведенияОРаботах + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки,
	|	НомерСтрокиПорядок";
	
	ТекстЗапроса = ТекстШапки 
	+ ОбщегоНазначения.РазделительПакетаЗапросов()
	+ ТекстТЧОС
	+ ОбщегоНазначения.РазделительПакетаЗапросов()  
	+ "
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.НаименованиеОС КАК НаименованиеОС,
	|	ОсновныеСредства.КодОбъекта КАК КодОбъекта,
	|	ОсновныеСредства.Сведения КАК Сведения,
	|	ОсновныеСредства.МожетСодержатьДрагМатериалы КАК МожетСодержатьДрагМатериалы,
	|	ОсновныеСредства.АмортизационнаяГруппа КАК АмортизационнаяГруппа,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.ДатаВыпуска КАК ДатаВыпуска,
	|	ОсновныеСредства.РеестровыйНомер КАК РеестровыйНомер,
	|	ОсновныеСредства.ЗаводскойНомер КАК ЗаводскойНомер,
	|	ОсновныеСредства.ИнойНомер КАК ИнойНомер,
	|	ОсновныеСредства.Сумма КАК Сумма,
	|	ОсновныеСредства.Количество КАК Количество,
	|	ОсновныеСредства.Цена КАК Цена,
	|	ОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения,
