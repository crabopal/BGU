Процедура ДобавитьОбъединениеВТекстЗапроса(ТекстЗапроса)
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|";
	КонецЕсли;	
КонецПроцедуры	

Процедура СформироватьТекстЗапросаШапка(ТипДокумента, ТекстЗапроса)
	ДобавитьОбъединениеВТекстЗапроса(ТекстЗапроса);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.Номер КАК Номер,
	|	Документ.Дата КАК ДатаАкта,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА Документ.Организация
	|		ИНАЧЕ Документ.Организация.ГоловнаяОрганизация
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА ВЫБОР
	|				КОГДА Документ.Организация.НаименованиеПолное = """"
	|					ТОГДА Документ.Организация.Наименование
	|				ИНАЧЕ Документ.Организация.НаименованиеПолное
	|			КОНЕЦ
	|		ИНАЧЕ Документ.Организация.ГоловнаяОрганизация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОрганизации,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА Документ.Организация.КодПоРПБС
	|		ИНАЧЕ Документ.Организация.ГоловнаяОрганизация.КодПоРПБС
	|	КОНЕЦ КАК КодРПБС,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|		ИНАЧЕ Документ.Организация
	|	КОНЕЦ КАК ОбособленноеПодразделение,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА """"
	|		ИНАЧЕ Документ.Организация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОбособленногоПодразделения,
	|	ВЫБОР
	|		КОГДА Документ.Организация.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА """"
	|		ИНАЧЕ Документ.Организация.КодПоРПБС
	|	КОНЕЦ КАК КодРПБСПодр,
	|	Документ.Подразделение КАК СтруктурноеПодразделение,
	|	ВЫБОР
	|		КОГДА Документ.Подразделение.НаименованиеПолное = """"
	|			ТОГДА Документ.Подразделение.Наименование
	|		ИНАЧЕ Документ.Подразделение.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеСтруктурногоПодразделения,
	|	Документ.Организация.КодПоППП.НаименованиеПолное КАК Учредитель,
	|	Документ.Организация.КодПоППП.Код КАК ГлаваБК,
	|	Документ.Организация.Бюджет.НаименованиеПолное КАК БюджетНаименование,
	|	Документ.Организация.Бюджет.Код КАК ОКТМО,
	|	ПРЕДСТАВЛЕНИЕ(Документ.ВидОперации) КАК ТипРешения,
	|	Документ.ВидОперации.Порядок + 1 КАК КодТипаРешения,
	|	Документ.ЦМО КАК ЦМО,
	|	Документ.ЦМО.Сотрудник КАК Сотрудник,
	|	Документ.СчетУчета КАК СчетУчета,
	|	Документ.СчетУчета.Наименование КАК ВидОбъекта,
	|	ПОДСТРОКА(Документ.СчетУчета.Код, 5, 1) + ""0"" КАК СчетГруппа,
	|	ПОДСТРОКА(Документ.СчетУчета.Код, 6, 1) КАК СчетВид,
	|	Документ.Комиссия.НаименованиеПриказа КАК НаименованиеПриказа,
	|	Документ.Комиссия.НомерПриказа КАК НомерПриказа,
	|	Документ.Комиссия.ДатаПриказа КАК ДатаПриказа,
	|	Документ.Ответственный КАК Ответственный
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС КАК Документ
	|ГДЕ
	|	Документ.Ссылка В (&МассивОбъектов)";
	
	ИмяДокумента = Метаданные.НайтиПоТипу(ТипДокумента.Ключ).Имя;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.РешениеОПризнанииОбъектовОС", "Документ." + ИмяДокумента); 
	
КонецПроцедуры

Процедура СформироватьТекстЗапросаТЧОС(ТипДокумента, ТекстЗапроса)
	ДобавитьОбъединениеВТекстЗапроса(ТекстЗапроса);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.Ссылка.Дата КАК ДатаДокумента,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.Ссылка.ВидОперации КАК ВидОперации,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА ОсновныеСредства.ОсновноеСредство.Наименование
	|		ИНАЧЕ ОсновныеСредства.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОС,
	|	ОсновныеСредства.ОсновноеСредство.Код КАК КодОбъекта,
	|	ОсновныеСредства.ОсновноеСредство.Сведения КАК Сведения,
	|	ЕСТЬNULL(ОсновныеСредства.ОсновноеСредство.МожетСодержатьДрагМатериалы, ЛОЖЬ) КАК МожетСодержатьДрагМатериалы,
	|	ОсновныеСредства.ОсновноеСредство.АмортизационнаяГруппа.Порядок + 1 КАК АмортизационнаяГруппа,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.ИнвентарныйНомер.ДатаВыпуска КАК ДатаВыпуска,
	|	ОсновныеСредства.ИнвентарныйНомер.РеестровыйНомер КАК РеестровыйНомер,
	|	ОсновныеСредства.ИнвентарныйНомер.ЗаводскойНомер КАК ЗаводскойНомер,
	|	ОсновныеСредства.ИнвентарныйНомер.ИнойНомер КАК ИнойНомер,
	|	ОсновныеСредства.Количество КАК Количество,
	|	ОсновныеСредства.СтоимостьБалансовая КАК СтоимостьБалансовая,
	|	ОсновныеСредства.Сумма КАК Сумма,
	|	ОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения,
	|	ОсновныеСредства.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
	|	&ПринятиеКУчетуОдновременноСВводомВЭксплуатацию КАК ПринятиеКУчетуОдновременноСВводомВЭксплуатацию,
	|	ЕСТЬNULL(ДатыПроведенияДокументов.ДатаПроведения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПроведения,
	|	ОсновныеСредства.ОставшийсяСрокПолезногоИспользования КАК ОставшийсяСрокПолезногоИспользования,
	|	ОсновныеСредства.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
	|	ОсновныеСредства.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
	|	ОсновныеСредства.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ОсновныеСредства.РезолюцияКомиссии КАК РезолюцияКомиссии,
	|	ОсновныеСредстваКонтактнаяИнформация.Представление КАК Местонахождение,
	|	ОсновныеСредства.ОсновноеСредство.Местонахождение КАК МестонахождениеОС
	|ПОМЕСТИТЬ ТЧОС2
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства.КонтактнаяИнформация КАК ОсновныеСредстваКонтактнаяИнформация
	|		ПО ОсновныеСредства.ОсновноеСредство = ОсновныеСредстваКонтактнаяИнформация.Ссылка
	|			И (ОсновныеСредстваКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресМестонахожденияОбъектаОС))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
