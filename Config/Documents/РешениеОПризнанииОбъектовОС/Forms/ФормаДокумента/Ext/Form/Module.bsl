&НаКлиенте
Процедура ОсновныеСредстваПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр)
	Если ОбщегоНазначенияБГУКлиентСервер.ЗапрещеноДобавлениеСтрокВДокументыНФА(ЭтотОбъект) Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	СтрокаТЧДоРедактирования = СтруктураРеквизитовСтрокиТЧ(ЭтотОбъект);         
	ЗаполнитьЗначенияСвойств(СтрокаТЧДоРедактирования, ТекущиеДанные);
	
	Если НоваяСтрока Тогда
		ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор); // Новый GUID для каждой строки
		ТекущиеДанные.РНПТ = "";
		ТекущиеДанные.РезолюцияКомиссии = 
			УправлениеНФАКлиентСервер.ТекстРезолюцииКомиссииПоУмолчанию("РешениеОПризнанииОбъектовОС");
		
		Если Не Копирование Тогда
			Если НЕ Объект.ПоступлениеБиблиотечногоФонда Тогда
				ТекущиеДанные.Количество = 1;
			КонецЕсли;

			ПересчитатьСуммыТекущейСтроки(ТекущиеДанные, ЭтотОбъект);
			УправлениеОсновнымиСредствамиКлиентСервер.РаспределитьЗатратыПоСуммамХвТЧ(ЭтотОбъект);
			ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущиеДанные, ЭтотОбъект);
			ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущиеДанные);
			
			АвтоЗначениеКПС = ?(АвтоЗначениеКПС = Неопределено, ЗначениеАвтоКПСПоСчету(ЭтотОбъект), АвтоЗначениеКПС);
			Если ЗначениеЗаполнено(АвтоЗначениеКПС) Тогда
				ТекущиеДанные.КПС = АвтоЗначениеКПС;
			КонецЕсли;
			
		Иначе
			УправлениеОсновнымиСредствамиКлиентСервер.ОбнулитьСуммыХвСтрокеТЧ(Элементы.ОсновныеСредства.ТекущиеДанные);
			ТекущиеДанные.СоздатьИнвентарнуюКарточку = Ложь;
			ТекущиеДанные.НомерИнвентарнойКарточки = "";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;	     
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	СтрокаТЧПослеРедактирования = СтруктураРеквизитовСтрокиТЧ(ЭтотОбъект);         
	ЗаполнитьЗначенияСвойств(СтрокаТЧПослеРедактирования, ТекущиеДанные);  
	
	Если ДанныеСтруктурРавны(СтрокаТЧДоРедактирования, СтрокаТЧПослеРедактирования) Тогда
		// Если данные строки не изменились, то не будем обрабатывать связанные строки
		Возврат;
	КонецЕсли;	
	
	УстановитьПараметрыСтрокиВоВсеСвязанныеСтроки(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОсновноеСредство", ТекущиеДанные.ОсновноеСредство);
	ПараметрыОтбора.Вставить("ИнвентарныйНомер", ТекущиеДанные.ИнвентарныйНомер);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество()<>0 Тогда
		ПараметрыОповещения = Новый Структура("НайденныеСтроки", НайденныеСтроки);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДрагМатериалах", ЭтаФорма, ПараметрыОповещения);
		ТекстВопроса = НСтр("ru = 'Удалить данные о содержании драгоценных материалов в удаленном объекте НФА ("+
			СокрЛП(ТекущиеДанные.ОсновноеСредство)+") на закладке ""Драгоценные материалы""?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваРешениеСотрудникаПоРезолюцииОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ТекущиеДанные.РешениеСотрудникаПоРезолюции = ВыбранноеЗначение;
	
	РешениеСотрудникаМодифицированность = Истина;
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОтражениеВУчетеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуНастройкиОтраженияВУчете();
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ОсновныеСредстваОтражениеВУчете"
		Или Поле.Имя = "ОсновныеСредстваОтражениеВУчетеЕстьОшибка"Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиОтраженияВУчете();
	ИначеЕсли Поле.Имя = "ОсновныеСредстваОтражениеВУчетеМодернизация" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиОтраженияВУчетеМодернизация(ВыбраннаяСтрока);
	ИначеЕсли Поле.Имя = "ОсновныеСредстваСуммыПоКФО" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуРаспределениеПоКФО();
	КонецЕсли;
	ПрослеживаемостьФормыБГУКлиент.ОсновныеСредстваВыбор(ЭтотОбъект, Поле, СтандартнаяОбработка);
	
	ОбщегоНазначенияБГУКлиент.РешениеСотрудникаПоРезолюцииВыбор(ЭтотОбъект, Поле, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ЭтоПервый = Истина;
	
	Для Каждого ИнвентарныйНомер Из ВыбранноеЗначение Цикл
		Если ЭтоПервый Тогда
			ЗаполняемаяСтрока = ТекущиеДанные;
			ЭтоПервый = Ложь;
		Иначе
			ЗаполняемаяСтрока = Объект.ОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаполняемаяСтрока, ТекущиеДанные,, "ИдентификаторСтроки");
			ЗаполняемаяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор); // Новый GUID для каждой строки
			ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ЗаполняемаяСтрока);
		КонецЕсли;
		ЗаполняемаяСтрока.ИнвентарныйНомер	= ИнвентарныйНомер;
		ЗаполняемаяСтрока.Количество		= 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ОсновныеСредстваОсновноеСредствоПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
	ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущиеДанные, ЭтотОбъект);
	
	УправлениеОсновнымиСредствамиКлиентСервер.СформироватьЗаголовокСуммыПоКФОвТЧ(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, ТекущиеДанные);
	ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущиеДанные, ЭтотОбъект);
	УправлениеОсновнымиСредствамиКлиентСервер.РаспределитьЗатратыПоСуммамХвТЧ(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, ТекущиеДанные);
	ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущиеДанные, ЭтотОбъект);
	ПересчитатьСуммыТекущейСтроки(ТекущиеДанные, ЭтотОбъект);
	УправлениеОсновнымиСредствамиКлиентСервер.РаспределитьЗатратыПоСуммамХвТЧ(ЭтотОбъект);
		
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСумма1ПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущиеДанные.СтоимостьПоОкончанииРабот = ТекущиеДанные.СтоимостьБалансовая + ТекущиеДанные.Сумма;
	УправлениеОсновнымиСредствамиКлиентСервер.РаспределитьЗатратыПоСуммамХвТЧ(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСтоимостьПоОкончанииРаботПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущиеДанные.Сумма = ТекущиеДанные.СтоимостьПоОкончанииРабот - ТекущиеДанные.СтоимостьБалансовая;
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваРНПТНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыПодбора = ПрослеживаемостьФормыБГУКлиент.ПараметрыОткрытияФормыПодбораРНПТ("ОсновныеСредства");
	ПараметрыПодбора.ЭтоПоступление = Ложь;
	ПараметрыПодбора.ТекущийДокумент = Объект.Ссылка;
	ПараметрыПодбора.Период = Объект.Дата;
	ПараметрыПодбора.ВнеоборотныйАктив = Объект.КапитальноеВложение;
	ПараметрыПодбора.Организация = Объект.Организация;
	ПараметрыПодбора.ИмяКолонкиНоменклатура = "ОсновноеСредство";
	ПараметрыПодбора.ПредставлениеКолонкиНоменклатура = НСтр("ru = 'Основное средство'");
	ПараметрыПодбора.ИмяФормыПодбора = "ФормаПодбораРНПТДляОС";

	ПрослеживаемостьФормыБГУКлиент.ОткрытьФормуПодбораРНПТ(ЭтотОбъект, ПараметрыПодбора);
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваРНПТОчистка(Элемент, СтандартнаяОбработка)
	СтрокаТабличнойЧасти = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если СтрокаТабличнойЧасти.ПрослеживаемыйТовар Тогда
		УдалитьСтрокиРНПТ(СтрокаТабличнойЧасти.ИдентификаторСтроки);
	КонецЕсли;
	
	ПрослеживаемостьФормыБГУКлиентСервер.ОчиститьПредставлениеРНПТ(ЭтотОбъект, СтрокаТабличнойЧасти);

КонецПроцедуры

