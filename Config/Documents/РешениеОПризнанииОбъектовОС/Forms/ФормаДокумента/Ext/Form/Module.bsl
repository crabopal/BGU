&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидОперацииПриИзмененииОснования(Форма)
	Объект = Форма.Объект;
	ВидОперацииМодернизация = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Модернизация");
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование)
		И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.РеконструкцияОС")
		И ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "ТолькоРегистрацияАкта") Тогда
			
		Объект.ФормироватьДвиженияПоМодернизации = Истина;
		Если Объект.ВидОперации <> ВидОперацииМодернизация Тогда
			Объект.ВидОперации = ВидОперацииМодернизация;
		КонецЕсли;
	Иначе				 
		Объект.ФормироватьДвиженияПоМодернизации = Ложь;
	КонецЕсли;	

//	ЗаполнитьСпискиВидовОпераций(Форма);
