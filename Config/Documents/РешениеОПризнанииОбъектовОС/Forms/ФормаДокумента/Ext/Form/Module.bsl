Функция ВидДокумента()
	Возврат ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС"));
КонецФункции	

&НаСервере
Процедура ВвестиНаОснованииПоступленияОС(ДанныеОснования)
	ТекОбъект = РеквизитФормыВЗначение("Объект", Тип("ДокументОбъект.РешениеОПризнанииОбъектовОС"));
	ТекОбъект.Заполнить(ДанныеОснования);
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");

	ОбъектыОС = Объект.ОсновныеСредства.Выгрузить(, "ОсновноеСредство");
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство,
	|	ОсновныеСредства.ВидНФА,
	|	ОсновныеСредства.ТипНФА
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В (&ОбъектыОС)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ОбъектыОС", ОбъектыОС);
	ДанныеОС = Запрос.Выполнить().Выгрузить();
	Для каждого ТекСтр Из Объект.ОсновныеСредства Цикл
		СтрокаОС = ДанныеОС.Найти(ТекСтр.ОсновноеСредство, "ОсновноеСредство");
		Если СтрокаОС <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ТекСтр, СтрокаОС, "ВидНФА,ТипНФА");
		КонецЕсли;
	КонецЦикла;	
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
КонецПроцедуры	

