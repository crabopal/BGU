&НаСервере
Процедура УстановитьПризнакиНалоговогоУчета()
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, Объект.КФО);
	ОтражатьВУСНДоходыМинусРасходы = УчетУСНКлиентСервер.ОтражатьВУСНДоходыМинусРасходы(Объект.Организация, Объект.Дата, Объект.КФО);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете()
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИменаРеквизитов = "ПорядокПогашенияСтоимости"
		+ ",СпособНачисленияАмортизации"
		+ ",СрокПолезногоИспользования"
		+ ",ПринятиеКУчетуОдновременноСВводомВЭксплуатацию"
		+ ",СчетУчетаЗатрат"
		+ ",КЭКЗатрат"
		+ ",КПСЗатрат"
		+ ",ПодразделениеЗатрат"
		+ ",СубконтоЗатрат1"
		+ ",СубконтоЗатрат2"
		+ ",СубконтоЗатрат3"
		+ ",ПорядокВключенияСтоимостиВСоставРасходовНУ"
		+ ",НачислятьАмортизациюНУ"
		+ ",СрокПолезногоИспользованияНУ"
		+ ",СпециальныйКоэффициентНУ"
		+ ",ПроцентКапитальныхВложенийВключаемыхВРасходыНУ"
		+ ",СчетУчетаЗатратПоАмортизационнойПремии"
		+ ",СубконтоПоАмортизационнойПремии1"
		+ ",СубконтоПоАмортизационнойПремии2"
		+ ",СубконтоПоАмортизационнойПремии3"
		+ ",ПодразделениеПоАмортизационнойПремии"
		+ ",СтатьяПрочихРасходов"
		+ ",ПорядокВключенияСтоимостиВСоставРасходовУСН"
		+ ",СрокПолезногоИспользованияУСН"
		+ ",КоэффициентУскорения"
		+ ",ПараметрВыработки"
		+ ",ПредполагаемыйОбъемВыработки";
	
	ДанныеТекущейСтроки = Новый Структура(ИменаРеквизитов);
	ДанныеТекущейСтроки.Вставить("СчетУчетаОС", Объект.СчетУчета);
	ЗаполнитьЗначенияСвойств(ДанныеТекущейСтроки, ТекущиеДанные);
	
	ПараметрыТекущейСтроки = Новый Структура;
	ПараметрыТекущейСтроки.Вставить("СписокРеквизитовСтрокиДокумента"		, ИменаРеквизитов);
	ПараметрыТекущейСтроки.Вставить("ОсновноеСредство"						, ТекущиеДанные.ОсновноеСредство);
	ПараметрыТекущейСтроки.Вставить("ИнвентарныйНомер"						, ТекущиеДанные.ИнвентарныйНомер);
	ПараметрыТекущейСтроки.Вставить("ПараметрыСтроки"						, ДанныеТекущейСтроки);
	ПараметрыТекущейСтроки.Вставить("ИспользоватьУчетПоПодразделениям"		, ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям);
	ПараметрыТекущейСтроки.Вставить("Дата"									, Объект.Дата);
	ПараметрыТекущейСтроки.Вставить("Организация"							, Объект.Организация);
	ПараметрыТекущейСтроки.Вставить("ИФО"									, Объект.ИФО);
	ПараметрыТекущейСтроки.Вставить("ОтражатьВНалоговомУчете"				, ОтражатьВНалоговомУчете);
	ПараметрыТекущейСтроки.Вставить("ОтражатьВУСНДоходыМинусРасходы"		, ОтражатьВУСНДоходыМинусРасходы);
	ПараметрыТекущейСтроки.Вставить("ПроверятьЗаполнениеСчетаУчетаЗатрат"	, Истина);
	
	ОткрытьФорму("Документ.ПринятиеКУчетуОбъектовОС.Форма.ФормаНастройкаОтраженияВУчете",
		ПараметрыТекущейСтроки,
		ЭтотОбъект,,,,Новый ОписаниеОповещения("ОкончаниеНастройкиОтраженияВУчете", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчетеМодернизация(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.ОсновныеСредства.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Дата, Организация, Подразделение, ИФО, КФО");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	// КФО, КПС и КЭК изменять не нужно
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО", Истина);
	ПараметрыФормы.Вставить("ВидимостьКПС",      Ложь);
	ПараметрыФормы.Вставить("ВидимостьКЭК",      Ложь);
	ПараметрыФормы.Вставить("ВидимостьКФО",      Ложь);
	ПараметрыФормы.Вставить("ВидимостьКоличество",Ложь);
	ПараметрыФормы.Вставить("ЕстьНалоговыйУчет",  Ложь); // Выбирается только счет НУ, не нужно показывать отдельно еще один.
	
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.СчетУчетаЗатратПоАмортизационнойПремии);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.СубконтоПоАмортизационнойПремии1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.СубконтоПоАмортизационнойПремии2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.СубконтоПоАмортизационнойПремии3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Настройка отражения амортизационной премии в учете'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет",  НСтр("ru = 'Счет учета затрат'"));
	
	ПараметрыСчета = Новый Структура;
	ПараметрыСчета.Вставить("ОграниченияСписокСчетов",
		НалоговыйУчетКлиентСервер.ВозможныеСчетаУчетаЗатратПоАмортизационнойПремии());
	
	ОтборСчета = Новый Структура("ЗапретитьИспользоватьВПроводках", Ложь);
	ПараметрыСчета.Вставить("Отбор", ОтборСчета);
	
	ПараметрыФормы.Вставить("ПараметрыСчета", ПараметрыСчета);
	ПараметрыФормы.Вставить("ОтключитьПроверкуЗаполненияСчета", Истина);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтотОбъект,,,,
	Новый ОписаниеОповещения("ОкончаниеНастройкиОтраженияВУчетеМодернизация", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеНастройкиОтраженияВУчете(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТолькоПросмотр = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		Для Каждого ИдентификаторСтроки Из Элементы.ОсновныеСредства.ВыделенныеСтроки Цикл
			
			ТекущиеДанные = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
			
			Если ТекущиеДанные <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТекущиеДанные, Результат);
				УстановитьОставшийсяСрокИспользования(ТекущиеДанные);
			КонецЕсли;
			
			ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущиеДанные, ЭтотОбъект);
			
			УстановитьПараметрыСтрокиВоВсеСвязанныеСтроки(ТекущиеДанные);
			
		КонецЦикла;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеНастройкиОтраженияВУчетеМодернизация(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТолькоПросмотр = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат) Тогда
		Для Каждого ИдентификаторСтроки Из Элементы.ОсновныеСредства.ВыделенныеСтроки Цикл
			ТекущиеДанные = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
			Если ТекущиеДанные <> Неопределено Тогда
				ТекущиеДанные.СчетУчетаЗатратПоАмортизационнойПремии = Результат.Счет;
				ТекущиеДанные.СубконтоПоАмортизационнойПремии1 = Результат.Субконто1;
				ТекущиеДанные.СубконтоПоАмортизационнойПремии2 = Результат.Субконто2;
				ТекущиеДанные.СубконтоПоАмортизационнойПремии3 = Результат.Субконто3;
			КонецЕсли;
			
			ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущиеДанные, ЭтотОбъект);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчетеВсехСтрокТаблицыОС(Форма)
	
	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущаяСтрока, Форма);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущаяСтрока, Форма)
	
	Перем ПогашениеСтоимостиНУ;
	Перем ПогашениеСтоимостиУСН;
	
	Если Форма.Объект.ВидОперации = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Модернизация") 
		И Форма.Объект.ФормироватьДвиженияПоМодернизации Тогда
	
		ОбновитьТекстОтражениеВУчетеМодернизация(ТекущаяСтрока, Форма);
		
	Иначе		
		Если ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
			"Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается") Тогда
			ПогашениеСтоимостиБУ = НСтр("ru= 'Стоимость не погашается'");
		ИначеЕсли ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
			"Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию") Тогда
			ПогашениеСтоимостиБУ = НСтр("ru= 'Списание при вводе в эксплуатацию'");
		ИначеЕсли ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
			"Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
			Если ТекущаяСтрока.СпособНачисленияАмортизации = ПредопределенноеЗначение(
				"Перечисление.СпособНачисленияАмортизации.Линейный") Тогда
				ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление амортизации линейным методом'");
			ИначеЕсли ТекущаяСтрока.СпособНачисленияАмортизации = ПредопределенноеЗначение(
				"Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию") Тогда
				ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление 100% амортизации при вводе в эксплуатацию'");
			ИначеЕсли ТекущаяСтрока.СпособНачисленияАмортизации = ПредопределенноеЗначение(
				"Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка") Тогда
				ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление амортизации методом уменьшаемого остатка'");
			ИначеЕсли ТекущаяСтрока.СпособНачисленияАмортизации = ПредопределенноеЗначение(
				"Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции") Тогда
				ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление амортизации пропорционально объему продукции (работ)'");
			Иначе
				ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление амортизации'");
			КонецЕсли;
		Иначе
			ПогашениеСтоимостиБУ = НСтр("ru = '<...>'");
		КонецЕсли;
		
		ПогашениеСтоимостиНУ = НСтр("ru = '<...>'");
		Если ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
			"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы") Тогда
			ПогашениеСтоимостиНУ = НСтр("ru = 'Не включать в расходы'");
		ИначеЕсли ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
			"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету") Тогда
			ПогашениеСтоимостиНУ = НСтр("ru = 'Включить в расходы при вводе в эксплуатацию'");
		ИначеЕсли ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
			"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации") Тогда
			ПогашениеСтоимостиНУ = НСтр("ru = 'Начисление амортизации'");
		КонецЕсли;
		
		ПогашениеСтоимостиУСН = НСтр("ru = '<...>'");
		Если ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовУСН = ПредопределенноеЗначение(
			"Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.НеВключатьВСоставРасходов") Тогда
			ПогашениеСтоимостиУСН = НСтр("ru = 'Не включать в расходы'");
		ИначеЕсли ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовУСН = ПредопределенноеЗначение(
			"Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставМатериальныхРасходов") Тогда
			ПогашениеСтоимостиУСН = НСтр("ru = 'Включить в материальные расходы'");
		ИначеЕсли ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовУСН = ПредопределенноеЗначение(
			"Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА") Тогда
			ПогашениеСтоимостиУСН = НСтр("ru = 'Включить в расходы на ОС (НМА)'");
		КонецЕсли;
		
		Если Форма.ОтражатьВНалоговомУчете Тогда
			
			ШаблонСтроки = НСтр("ru = 'БУ: %1
			|НУ: %2'");
			
			ТекущаяСтрока.ОтражениеВУчете = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонСтроки, ПогашениеСтоимостиБУ, ПогашениеСтоимостиНУ);
			
		ИначеЕсли Форма.ОтражатьВУСНДоходыМинусРасходы Тогда
			
			ШаблонСтроки = НСтр("ru = 'БУ: %1
			|УСН: %2'");
			
			ТекущаяСтрока.ОтражениеВУчете = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонСтроки, ПогашениеСтоимостиБУ, ПогашениеСтоимостиУСН);
			
		Иначе
			
			ШаблонСтроки = НСтр("ru = '%1'");
			
			ТекущаяСтрока.ОтражениеВУчете = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонСтроки, ПогашениеСтоимостиБУ);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.ОсновноеСредство) Тогда
			ПроверитьЗаполнениеСтроки(ТекущаяСтрока, Форма);
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчетеМодернизация(ТекущаяСтрока, Форма)
	Текст = "";
	Если ЗначениеЗаполнено(ТекущаяСтрока.СчетУчетаЗатратПоАмортизационнойПремии) Тогда
		Текст = Строка(ТекущаяСтрока.СчетУчетаЗатратПоАмортизационнойПремии);
	КонецЕсли;	

	Для к = 1 по 3 Цикл
		ЗначениеСубконто = ТекущаяСтрока["СубконтоПоАмортизационнойПремии" + к];
		Если ЗначениеЗаполнено(ЗначениеСубконто) Тогда
			Текст = Текст + ?(ЗначениеЗаполнено(Текст), "; ", "") + Строка(ЗначениеСубконто);
		КонецЕсли;	
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Текст = "<...>";
	КонецЕсли;	
	
	ТекущаяСтрока.ОтражениеВУчете = Текст;
КонецПроцедуры	

&НаСервере
Процедура ПриИзмененииКапитальногоВложенияСервер()
	
	ДанныеОбъектаВложений = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(Объект.КапитальноеВложение, Объект.Ссылка);
	Объект.СчетВложений = ДанныеОбъектаВложений.СчетВложений; 
	Если ДанныеОбъектаВложений.Свойство("ЕдинственнаяКарточкаКапвложений")
		И ЗначениеЗаполнено(ДанныеОбъектаВложений.ЕдинственнаяКарточкаКапвложений) Тогда
		Объект.КарточкаКапвложений = ДанныеОбъектаВложений.ЕдинственнаяКарточкаКапвложений; 
	КонецЕсли;	
	
	Если ЗаполненыОбязательныеРеквизитыДляРасчетаСуммыВложений(ЭтаФорма) Тогда
		РассчитатьСуммуВложенийНаСервере();
	КонецЕсли;
	УстановитьЕстьПрослеживаемыеТовары();
	Для каждого СтрокаДокумента Из Объект.ОсновныеСредства Цикл
	
	СтрокаДокумента.ПрослеживаемыйТовар = ЕстьПрослеживаемыеТовары;
	
	КонецЦикла; 
    ЗаполнитьМЦКапвложенияСДрагМатериалами(Истина);
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьНаличиеДоговораУСчетаУчета()
	
	ЕстьДоговорУСчетаУчета = ?(ЗначениеЗаполнено(Объект.СчетУчета),
		БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Объект.СчетУчета, ПланыВидовХарактеристик.ВидыСубконто.Договоры),
		Ложь);
		
КонецПроцедуры

&НаСервере
Процедура ОпределитьНаличиеДоговораВложения()
	
	Элементы.КапитальныеВложенияДоговор.Видимость = ?(ЗначениеЗаполнено(Объект.СчетВложений),
		БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Объект.СчетВложений, ПланыВидовХарактеристик.ВидыСубконто.Договоры),
		Ложь);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьЦенуЕдиницыВложений(Форма)
	
	Объект = Форма.Объект;
	
	Форма.ПервоначальнаяСтоимостьЕдиницы = Объект.СуммаВложений /
		?(Объект.КоличествоВложений = 0, 1, Объект.КоличествоВложений);
	Форма.ПервоначальнаяСтоимостьЕдиницыНУ = Объект.СуммаВложенийНУ /
		?(Объект.КоличествоВложений = 0, 1, Объект.КоличествоВложений);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыТекущейСтроки(ТекущиеДанные, Форма)
	Объект = Форма.Объект;
	
	Если Объект.КоличествоВложений <> 0 И ТекущиеДанные.Количество = Объект.КоличествоВложений Тогда
		ТекущиеДанные.Сумма					= Объект.СуммаВложений;
		ТекущиеДанные.СуммаАмортизации		= Объект.СуммаАмортизацииВложений;
		ТекущиеДанные.СуммаОбесценения 		= Объект.СуммаОбесцененияВложений;
		
		ТекущиеДанные.СуммаНУ				= Объект.СуммаВложенийНУ;
		ТекущиеДанные.СуммаНеУчитываетсяНУ	= Объект.РасходыНеУчитываетсяНУ;
		ТекущиеДанные.СуммаЕНВД				= Объект.РасходыЕНВД;
	ИначеЕсли Объект.КоличествоВложений <> 0 Тогда
		ТекущиеДанные.Сумма            = ТекущиеДанные.Количество * Форма.ПервоначальнаяСтоимостьЕдиницы;
		ТекущиеДанные.СуммаАмортизации = ТекущиеДанные.Количество * Объект.СуммаАмортизацииВложений / Объект.КоличествоВложений;
		ТекущиеДанные.СуммаОбесценения = ТекущиеДанные.Количество * Объект.СуммаОбесцененияВложений / Объект.КоличествоВложений;
		
		ТекущиеДанные.СуммаНУ = ТекущиеДанные.Количество * Форма.ПервоначальнаяСтоимостьЕдиницыНУ;
		ТекущиеДанные.СуммаНеУчитываетсяНУ = ТекущиеДанные.Количество * Объект.РасходыНеУчитываетсяНУ / Объект.КоличествоВложений;
		ТекущиеДанные.СуммаЕНВД = ТекущиеДанные.Количество * Объект.РасходыЕНВД / Объект.КоличествоВложений;
	Иначе
		Если Объект.ОсновныеСредства.Количество() = 1 Тогда
			ТекущиеДанные.Сумма = Объект.СуммаВложений;
			ТекущиеДанные.СуммаНУ = Объект.СуммаВложенийНУ;
		КонецЕсли;	
		ТекущиеДанные.СуммаАмортизации = 0;
		ТекущиеДанные.СуммаОбесценения = 0;
	КонецЕсли;
	
	//ПересчитатьВалютнуюСуммуВСтроке(Форма, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбнулитьСуммыВложений()
	
	Объект.СуммаВложений				= 0;
	Объект.СуммаВложенийНУ				= 0;
	Объект.РасходыНеУчитываетсяНУ		= 0;
	Объект.РасходыЕНВД					= 0;
	Объект.КоличествоВложений			= 0;
	
	ПервоначальнаяСтоимостьЕдиницы		= 0;
	ПервоначальнаяСтоимостьЕдиницыНУ	= 0;
	
	Объект.КапитальныеВложения.Очистить();
	УправлениеОсновнымиСредствамиКлиентСервер.ЗаполнитьСуммыХПоСуммеДокумента(ЭтотОбъект);	
	
КонецПроцедуры

&НаСервере
Процедура ОсновныеСредстваОсновноеСредствоПриИзмененииНаСервере(Знач ИдентификаторСтроки, ДанныеОС = Неопределено)
	
	ТекущаяСтрока = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.СрокПолезногоИспользования) Тогда
		УстановитьСрокПолезногоИспользования(ТекущаяСтрока);
	КонецЕсли;
	
	Если ДанныеОС <> Неопределено Тогда
		СтрокаОС = ДанныеОС.Найти(ТекущаяСтрока.ОсновноеСредство, "ОсновноеСредство");
		ДанныеОбъектаОС = СтрокаОС;
	Иначе	
		ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ТекущаяСтрока.ОсновноеСредство, Объект.Ссылка);
	КонецЕсли;	
	
	ТекущаяСтрока.ВидНФА = ДанныеОбъектаОС.ВидНФА;
	ТекущаяСтрока.ТипНФА = ДанныеОбъектаОС.ТипНФА;
	УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, ТекущаяСтрока);
	
	ТекущаяСтрока.ПрослеживаемыйТовар = ЕстьПрослеживаемыеТовары;
	ТекущаяСтрока.СтранаПроисхождения = ДанныеОбъектаОС.СтранаПроисхождения;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьРНПТВХранилище(Адрес, ДополнительныеПараметры) Экспорт
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ПоместитьРНПТВХранилищеНаСервере(Адрес, ДополнительныеПараметры.ИдентификаторСтроки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПоместитьРНПТВХранилищеНаСервере(Адрес, ИдентификаторСтроки)

	ТаблицаРНПТ = Объект.СведенияПрослеживаемости.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	ПоместитьВоВременноеХранилище(ТаблицаРНПТ, Адрес);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораРНПТННаКлиенте(ВыбранноеЗначение)
	
	СтрокаТабличнойЧасти = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
			СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		ОбработкаВыбораРНПТННаСервере(СтрокаТабличнойЧасти.ИдентификаторСтроки, ВыбранноеЗначение, СтрокаТабличнойЧасти.ПолучитьИдентификатор());
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораРНПТННаСервере(Знач ИдентификаторСтроки, Знач ВыбранноеЗначение, Знач ИдентификаторСтрокиВнутр)
	
	СтрокаТабличнойЧасти = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтрокиВнутр);
	ПрослеживаемостьФормыБГУ.ОбработкаВыбораРНПТН(ЭтотОбъект, ИдентификаторСтроки, ВыбранноеЗначение);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТ(ЭтаФорма, СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиРНПТ(Знач ИдентификаторСтроки)
	ПрослеживаемостьБГУ.УдалитьСтрокиРНПТ(Объект, ИдентификаторСтроки);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_Прослеживаемость(Форма)

	ВидимостьПрослеживаемыйТовар = Ложь;
	ВидимостьСтранаПроисхождения = Ложь;
	ВидимостьРНПТ = Ложь;
	Если Форма.ВедетсяУчетПрослеживаемыхТоваров И Форма.ПоДокументуВозможенУчетПрослеживаемыхТоваров И Форма.ЕстьПрослеживаемыеТовары Тогда
		ВидимостьПрослеживаемыйТовар = Истина;
		ВидимостьСтранаПроисхождения = Истина;
		ВидимостьРНПТ = Истина;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ПрослеживаемыйТовар",
		"Видимость", ВидимостьПрослеживаемыйТовар);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ОсновныеСредстваПрослеживаемыйТовар",
		"Видимость", ВидимостьПрослеживаемыйТовар);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ОсновныеСредстваСтранаПроисхождения",
		"Видимость", ВидимостьСтранаПроисхождения);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ОсновныеСредстваРНПТ",
		"Видимость", ВидимостьРНПТ);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПоДокументуВозможенУчетПрослеживаемыхТоваров(Форма)

	Форма.ПоДокументуВозможенУчетПрослеживаемыхТоваров = Истина;

КонецПроцедуры

&НаСервере
Функция УстановитьЕстьПрослеживаемыеТовары()

	ЕстьПрослеживаемыеТовары = ПрослеживаемостьБГУ.ПрослеживаемоеОсновноеСредство(Объект.КапитальноеВложение, Объект);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполненыОбязательныеРеквизитыДляРасчетаСуммыВложений(Форма, Ошибки = Неопределено)
	
	Объект = Форма.Объект;
	
	РеквизитыДляПроверки = Новый Структура;
	РеквизитыДляПроверки.Вставить("Организация", "Организация");
	Если Форма.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		РеквизитыДляПроверки.Вставить("ИФО", "ИФО");
	КонецЕсли;
	РеквизитыДляПроверки.Вставить("КФО", "КФО");
	РеквизитыДляПроверки.Вставить("КапитальноеВложение", "Объект вложений");
	
	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(РеквизитыДляПроверки, Объект, Ложь, Ошибки);
	Возврат Не Отказ;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоДокументуОснованию(ДокументОснование)
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда 
		Если (Объект.ОсновныеСредства.Количество() > 0) Тогда
			Возврат;
		КонецЕсли;	
		
		ДокументОбъект = РеквизитФормыВЗначение("Объект");
		ДокументОбъект.ЗаполнитьПоЭлектронномуДокументуПоставщика(ДокументОснование);
		ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеконструкцияОС") Тогда 
		ДокументОбъект = РеквизитФормыВЗначение("Объект");
		ДокументОбъект.Заполнить(ДокументОснование);
		ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
		УстановитьОтразитьВКарточкеКапвложений(ЭтотОбъект);
		УстановитьПризнакиНалоговогоУчета();
		УправлениеОсновнымиСредствами.ЗаполнитьКапитальныеВложенияПоОстаткам(Объект, "РешениеОПризнанииОбъектовОС", Ложь);
		УправлениеОсновнымиСредствамиКлиентСервер.ЗаполнитьСуммыХПоСуммеДокумента(ЭтотОбъект);
		ПересчитатьСтрокиТЧ_ОсновныеСредства(ЭтотОбъект);
		РассчитатьСтоимостиТЧ();
		ПриИзмененииКлючевогоРеквизитаТиповойОперацииНаСервере();
	КонецЕсли;
КонецПроцедуры // ЗаполнитьПоДокументуОснованию()

&НаСервере
Процедура УстановитьСрокПолезногоИспользования(ТекущаяСтрока)
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.ОсновноеСредство) Тогда
		Возврат;
	КонецЕсли;
	
	СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.ОсновноеСредство, "АмортизационнаяГруппа"));
	
	Если Не ЗначениеЗаполнено(СрокПолезногоИспользования) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока.СрокПолезногоИспользования = СрокПолезногоИспользования;
	ТекущаяСтрока.СрокПолезногоИспользованияНУ = СрокПолезногоИспользования;
	ТекущаяСтрока.СрокПолезногоИспользованияУСН = СрокПолезногоИспользования;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРекомедуемыеОтражениеВУчетеВСтроке(Форма, ТекущаяСтрока)
	
	Если ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = 0 И ЗначениеЗаполнено(ТекущаяСтрока.ОсновноеСредство) Тогда
	
		ДанныеРасчета = Новый Структура("Дата,СчетУчета,ОсновноеСредство,Сумма,Количество,СрокПолезногоИспользования,ВидНФА,ТипНФА",
			Форма.Объект.Дата, Форма.Объект.СчетУчета, ТекущаяСтрока.ОсновноеСредство, ТекущаяСтрока.Сумма,
			ТекущаяСтрока.Количество, ТекущаяСтрока.СрокПолезногоИспользования, ТекущаяСтрока.ВидНФА, ТекущаяСтрока.ТипНФА);
		
		РекомендуемыйПорядок = РекомендуемыйПорядокПогашенияСтоимости(ДанныеРасчета);
		
		ТекущаяСтрока.ПорядокПогашенияСтоимости = РекомендуемыйПорядок.ПорядокПогашенияСтоимости;
		ТекущаяСтрока.СпособНачисленияАмортизации = РекомендуемыйПорядок.СпособНачисленияАмортизации;
		
		ВвестиВЭксплуатацию = РекомендуемыйПорядок.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию;
		Если ВвестиВЭксплуатацию <> Неопределено Тогда
			ТекущаяСтрока.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию = ВвестиВЭксплуатацию;
		КонецЕсли;
		
		Если РекомендуемыйПорядок.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации")
			И РекомендуемыйПорядок.СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный") Тогда
			ТекущаяСтрока.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию = Истина;
			//ТекущаяСтрока.НачислятьАмортизацию = Истина;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РекомендуемыйПорядокПогашенияСтоимости(ДанныеРасчета)
	
	ВидИмущества = УправлениеОсновнымиСредствамиКлиентСервер.ВидИмуществаПоСчетуУчета(ДанныеРасчета.СчетУчета);
	
	Возврат УправлениеОсновнымиСредствамиКлиентСервер.РекомендуемыйПорядокПогашенияСтоимости(
		ДанныеРасчета.ВидНФА, ДанныеРасчета.ТипНФА,
		?(ДанныеРасчета.Количество = 0, 0, ДанныеРасчета.Сумма / ДанныеРасчета.Количество),
		ДанныеРасчета.Дата, ВидИмущества, ДанныеРасчета.СрокПолезногоИспользования);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТипИВидНФАвТЧ()
	МассивОС = Объект.ОсновныеСредства.Выгрузить(, "ОсновноеСредство").ВыгрузитьКолонку("ОсновноеСредство");
	РеквизитыОС = "ВидНФА, ТипНФА";
	ДанныеОбъектовОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОС, РеквизитыОС);
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		СтрокаОС = ДанныеОбъектовОС.Получить(СтрокаТЧ.ОсновноеСредство);
		Если СтрокаОС = Неопределено Тогда
			Продолжить;
		КонецЕсли;	   
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаОС, РеквизитыОС); 
	КонецЦикла;	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьВыбранныйСпособПогашенияСтоимости(Форма, ТекущаяСтрока, Ошибки = Неопределено)
	
	ДанныеРасчета = Новый Структура("Дата,СчетУчета,ОсновноеСредство,Сумма,Количество,СрокПолезногоИспользования,ВидНФА,ТипНФА",
		Форма.Объект.Дата, Форма.Объект.СчетУчета, ТекущаяСтрока.ОсновноеСредство, ТекущаяСтрока.Сумма,
		ТекущаяСтрока.Количество, ТекущаяСтрока.СрокПолезногоИспользования, ТекущаяСтрока.ВидНФА, ТекущаяСтрока.ТипНФА);
	РекомендуемыйПорядок = РекомендуемыйПорядокПогашенияСтоимости(ДанныеРасчета);
	
	Если РекомендуемыйПорядок.ПорядокПогашенияСтоимости = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РекомендуемыйПорядок.ПорядокПогашенияСтоимости <> ТекущаяСтрока.ПорядокПогашенияСтоимости
		Или РекомендуемыйПорядок.ДопустимыеСпособыНачисленияАмортизации.Найти(ТекущаяСтрока.СпособНачисленияАмортизации) = Неопределено
		Или (РекомендуемыйПорядок.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию <> Неопределено
			И РекомендуемыйПорядок.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию
			<> ТекущаяСтрока.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию) Тогда
		
		ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = 0;
		
		ИндексСтроки = ТекущаяСтрока.НомерСтроки - 1;
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
			"Объект.ОсновныеСредства[%1].ОтражениеВУчетеЕстьОшибка",
			РекомендуемыйПорядок.ПояснениеУказанногоПорядка,"Объект.ОсновныеСредства",
			ИндексСтроки, РекомендуемыйПорядок.ПояснениеУказанногоПорядка);
	Иначе
		ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = -1;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаГрупповогоВводаОССервер(ВыбранноеЗначение)
	
	ТаблицаСозданныхОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение);
	ДобавленныеОС = ТаблицаСозданныхОС.ВыгрузитьКолонку("ОсновноеСредство");
	ДанныеПрослеживаемостиОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДобавленныеОС, "ПрослеживаемыйТовар, СтранаПроисхождения");
	ПерваяДобавленнаяСтрока = Неопределено;
	Для Каждого Строка Из ТаблицаСозданныхОС Цикл
		Для каждого НовыйИнвНомер из Строка.ИнвентарныйНомер Цикл
			НоваяСтрока = Объект.ОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,, "ИнвентарныйНомер");
			НоваяСтрока.ИнвентарныйНомер = НовыйИнвНомер;
			НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор); // Новый GUID для каждой строки
			НоваяСтрока.Сумма = Строка.ПервоначальнаяСтоимость;
			НоваяСтрока.Количество = 1;
			НоваяСтрока.РезолюцияКомиссии = 
				УправлениеНФАКлиентСервер.ТекстРезолюцииКомиссииПоУмолчанию("РешениеОПризнанииОбъектовОС");
			
			ДанныеПрослеживаемости = ДанныеПрослеживаемостиОС.Получить(Строка.ОсновноеСредство);
			Если ДанныеПрослеживаемости <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеПрослеживаемости);
			КонецЕсли;
			
			Если ПерваяДобавленнаяСтрока = Неопределено Тогда
				ПерваяДобавленнаяСтрока = НоваяСтрока;
			КонецЕсли;
			
			УстановитьСрокПолезногоИспользования(НоваяСтрока);
			УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, НоваяСтрока);
			ОбновитьТекстЗаголовковВСтрокеТаблицыОС(НоваяСтрока);
		КонецЦикла;	
	КонецЦикла;
	
	УстановитьЕстьПрослеживаемыеТовары();
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоОперацияСКапвложением(Форма)
	ТекОперация = Форма.Объект.ВидОперации;
	ТекФормироватьДвиженияПоМодернизации = Форма.Объект.ФормироватьДвиженияПоМодернизации;
	
	МассивОперацийКапвложений = Новый Массив;
	МассивОперацийКапвложений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Изготовление"));
	МассивОперацийКапвложений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Приобретение"));
	Возврат (МассивОперацийКапвложений.Найти(ТекОперация) <> Неопределено
		ИЛИ ТекОперация = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Модернизация")
		И ТекФормироватьДвиженияПоМодернизации);
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_КарточкаКапвложений(Форма)
	ВидимостьГруппы = ЭтоОперацияСКапвложением(Форма); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаКарточкаКапвложений",
		"Видимость", ВидимостьГруппы);

	Если ВидимостьГруппы Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КарточкаКапвложений",
			"Видимость", Форма.Объект.ОтразитьВКарточкеКапвложений);
	КонецЕсли;		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыСтрокиВоВсеСвязанныеСтроки(ТекущиеДанные)
	
	ИндексТекСтроки = Объект.ОсновныеСредства.Индекс(ТекущиеДанные);
	УстановитьПараметрыСтрокиВоВсеСвязанныеСтрокиНаСервере(ИндексТекСтроки);
	
КонецПроцедуры
                                                                                  	
&НаСервере
Процедура УстановитьПараметрыСтрокиВоВсеСвязанныеСтрокиНаСервере(ИндексТекСтроки)
	
	ТекущиеДанные = Объект.ОсновныеСредства.Получить(ИндексТекСтроки);
	Для Каждого ТекСтрока Из Объект.ОсновныеСредства Цикл           
		Если ТекСтрока <> ТекущиеДанные
			И ТекСтрока.ОсновноеСредство = ТекущиеДанные.ОсновноеСредство И ЗначениеЗаполнено(ТекСтрока.ОсновноеСредство) Тогда
			
			ЗаполнитьСтрокуИзДругойСтроки(ТекСтрока, ТекущиеДанные, ОтражатьВНалоговомУчете, ОтражатьВУСНДоходыМинусРасходы);
			ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущиеДанные, ЭтотОбъект);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСтрокуИзДругойСтроки(Получатель, Источник, НУ, УСН)
	ЗаполнитьЗначенияСвойств(Получатель, Источник, РеквизитыСтрокиТЧ("БУ"));
		
	Если НУ Тогда
		ЗаполнитьЗначенияСвойств(Получатель, Источник, РеквизитыСтрокиТЧ("НУ"));
	КонецЕсли;
	
	Если УСН Тогда
		ЗаполнитьЗначенияСвойств(Получатель, Источник, РеквизитыСтрокиТЧ("УСН"));
	КонецЕсли;
	
КонецПроцедуры

// Формирует строку реквизитов, данные которых копируются в связанные строки
//
// Параметры:
//  Режим - Строка - определяет состав реквизитов. Возможные значения: БУ, НУ, УСН. 
//      Если не указан формирует строку для всех режимов
//
// Возвращаемое значение:
//  - Строка - строка имен реквизитов
&НаКлиентеНаСервереБезКонтекста    
Функция РеквизитыСтрокиТЧ(Режим = "")
	Результат = "";
	Если Режим = "" Тогда
		Результат = 
		РеквизитыСтрокиТЧ("БУ") + "," + РеквизитыСтрокиТЧ("НУ") + "," + РеквизитыСтрокиТЧ("УСН");
	ИначеЕсли Режим = "БУ" Тогда
		Результат = Результат + "Сумма," 
		+ "КПС,СрокПолезногоИспользования,ПорядокПогашенияСтоимости," 
		+ "СпособНачисленияАмортизации,СчетУчетаЗатрат," 
		+ "КПСЗатрат,КЭКЗатрат,ПодразделениеЗатрат,СубконтоЗатрат1,СубконтоЗатрат2,СубконтоЗатрат3," 
		+ "ОтражениеВУчете,НомерИнвентарнойКарточки,СоздатьИнвентарнуюКарточку,ВидНФА,ТипНФА,"
		+ "НаименованиеГТ, НомерГТ, ДатаГТ, СрокДействияГТ";
	ИначеЕсли Режим = "НУ" Тогда
		Результат = Результат +  "СуммаНУ," 
		+ "ПорядокВключенияСтоимостиВСоставРасходовНУ,НачислятьАмортизациюНУ,СрокПолезногоИспользованияНУ," 
		+ "СпециальныйКоэффициентНУ,ПроцентКапитальныхВложенийВключаемыхВРасходыНУ," 
		+ "СчетУчетаЗатратПоАмортизационнойПремии,СубконтоПоАмортизационнойПремии1," 
		+ "СубконтоПоАмортизационнойПремии2,СубконтоПоАмортизационнойПремии3," 
		+ "ПодразделениеПоАмортизационнойПремии,СтатьяПрочихРасходов";
	ИначеЕсли Режим = "УСН" Тогда
		Результат = Результат 
		+ "ПорядокВключенияСтоимостиВСоставРасходовУСН,СрокПолезногоИспользованияУСН";
	КонецЕсли;	      
	
	Возврат Результат;
КонецФункции	

// Формирует строку реквизитов, данные которых копируются в связанные строки
//
// Параметры:
//  Режим - Строка - определяет состав реквизитов. Возможные значения: БУ, НУ, УСН. 
//      Если не указан формирует строку для всех режимов
//
// Возвращаемое значение:
//  - Структура - в качестве ключенй содержит имена реквизитов строки
&НаКлиентеНаСервереБезКонтекста    
Функция СтруктураРеквизитовСтрокиТЧ(Форма)
	РеквизитыТЧ = РеквизитыСтрокиТЧ("БУ");
	
	Если Форма.ОтражатьВНалоговомУчете Тогда;
		РеквизитыТЧ = РеквизитыТЧ + "," + РеквизитыСтрокиТЧ("НУ");
	КонецЕсли;	

	Если Форма.ОтражатьВУСНДоходыМинусРасходы Тогда;
		РеквизитыТЧ = РеквизитыТЧ + "," + РеквизитыСтрокиТЧ("УСН");
	КонецЕсли;	                         
	
	Возврат(Новый Структура(РеквизитыТЧ));         
КонецФункции	     

// Проверяет равенство значений элементов структуры.
// По ключам структуры должны быть идентичны
//
// Параметры:
//  Структура1 - Структура
//  Структура2 - Структура
//
// Возвращаемое значение:
//  - Булево - Истна, если данные структур равны
&НаКлиентеНаСервереБезКонтекста    
Функция ДанныеСтруктурРавны(Структура1, Структура2)
	Результат = Истина;
	Для каждого Элемент1 из Структура1 Цикл
		Если Элемент1.Значение <> Структура2[Элемент1.Ключ] Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
		
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура ПересчитатьОставшийсяСрокИспользованияПриИзмененииДаты()
	
	ЗаданаДатаВводаВЭксплуатацию = Ложь;
	Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		Если ЗначениеЗаполнено(ТекущаяСтрока.ДатаВводаВЭксплуатацию) Тогда
			ЗаданаДатаВводаВЭксплуатацию = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗаданаДатаВводаВЭксплуатацию Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'В некоторых строках документа указана ""Дата ввода в эксплуатацию"".
                         |После изменения даты рекомендуется пересчитать оставшийся срок полезного использования
                         |в строках документа.
                         |Пересчитать оставшийся срок полезного использования?'");
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения(
		"ПересчитатьОставшийсяСрокИспользованияПриИзмененииДатыЗавершение", ЭтотОбъект);
	
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьОставшийсяСрокИспользованияПриИзмененииДатыЗавершение(РезультатВопроса,
	ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
			УстановитьОставшийсяСрокИспользования(ТекущаяСтрока);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОставшийсяСрокИспользования(ТекущиеДанные)
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.ОставшийсяСрокПолезногоИспользования =
		УправлениеОсновнымиСредствамиКлиентСервер.ОставшийсяСрокПолезногоИспользования(
			ТекущиеДанные.ДатаВводаВЭксплуатацию,
			ТекущиеДанные.СрокПолезногоИспользования,
			Объект.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзменении_Завершение(Результат, Параметры) Экспорт
	ВвестиНаОснованииПоступленияОС(Результат);
	РассчитатьЦенуЕдиницыВложений(ЭтотОбъект);
	Для каждого ТекущиеДанные из Объект.ОсновныеСредства Цикл
		ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущиеДанные, ЭтотОбъект);
		ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущиеДанные);
	КонецЦикла;	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	ОбщегоНазначенияБГУКлиент.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект);
	УстановитьВидимостьЭлементовФормы_КарточкаКапвложений(ЭтотОбъект);
	УстановитьДоступностьРедактированияСтрок(ЭтотОбъект);
	УстановитьПризнакиНалоговогоУчета();
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	ЗаполнитьСчетаУчетаНаименование(ЭтотОбъект);
КонецПроцедуры	 

