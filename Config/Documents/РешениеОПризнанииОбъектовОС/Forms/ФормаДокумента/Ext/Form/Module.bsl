&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммы_СведенияОВР(Форма, ТекСтрока)     
	Отбор = Новый Структура("ОсновноеСредство, ИнвентарныйНомер",
		ТекСтрока.ОсновноеСредство, ТекСтрока.ИнвентарныйНомер);
	Строки = Форма.Объект.ОсновныеСредства.НайтиСтроки(Отбор);
	Если Строки.Количество() > 0 Тогда
		ТекСтрока.СуммаМодернизации = Строки[0].Сумма
			- (ТекСтрока.СуммаРемонта
			+ ТекСтрока.СуммаТранспортировки
			+ ТекСтрока.СуммаДемонтажа);
	КонецЕсли;		
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьЗаполнениеСтроки(ТекущаяСтрока, Форма, Ошибки = Неопределено, НеЗаполнятьОшибки = Истина)
	
	Объект = Форма.Объект;
	
	// Подготовка параметров проверки строки
	ПараметрыПроверки = УправлениеОсновнымиСредствамиКлиентСервер.ПараметрыПроверкиДанныхСтрокиПринятияКУчету();
	ПараметрыПроверки.НеЗаполнятьОшибки = НеЗаполнятьОшибки;
	ПараметрыПроверки.Объект = Объект;
	ПараметрыПроверки.УчетПоПодразделениям = Форма.КэшПараметров.ИспользоватьУчетПоПодразделениям;
	ПараметрыПроверки.ИндексСтроки = ТекущаяСтрока.НомерСтроки - 1;
	ПараметрыПроверки.НомерСтроки = ТекущаяСтрока.НомерСтроки;
	ПараметрыПроверки.ПроверятьЗаполнениеСчетаУчетаЗатрат = ПроверятьЗаполнениеСчетаУчетаЗатрат(Объект.ВидОперации);
	ПараметрыПроверки.ОтражатьВНалоговомУчете = Форма.ОтражатьВНалоговомУчете;
	ПараметрыПроверки.ОтражатьВУСНДоходыМинусРасходы = Форма.ОтражатьВУСНДоходыМинусРасходы;
	
	// проверка строки
	Отказ = Не УправлениеОсновнымиСредствамиКлиентСервер.ДанныеСтрокиПринятияКУчетуЗаполненыКорректно(ТекущаяСтрока,
		ПараметрыПроверки, Ошибки);
	
	// обработка результатов проверки
	
	ТекущаяСтрока.ОтражениеВУчетеБУЗаполненоНекорректно  = ПараметрыПроверки.ОтражениеВУчетеБУЗаполненоНекорректно;
	ТекущаяСтрока.ОтражениеВУчетеНУЗаполненоНекорректно  = ПараметрыПроверки.ОтражениеВУчетеНУЗаполненоНекорректно;
	ТекущаяСтрока.ОтражениеВУчетеУСНЗаполненоНекорректно = ПараметрыПроверки.ОтражениеВУчетеУСНЗаполненоНекорректно;
	
	Если Отказ Тогда
		ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = -1;
	Иначе
		ПроверитьВыбранныйСпособПогашенияСтоимости(Форма, ТекущаяСтрока);
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверятьЗаполнениеСчетаУчетаЗатрат(ВидОперации)
	Возврат(
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.БезвозмездноеПоступление")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.ВозмещениеУщерба")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Изготовление")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Приобретение")
		);
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыОС(Форма)
	
	Объект = Форма.Объект;
	Для Каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущаяСтрока);
		ОбновитьТекстОтражениеВУчетеМодернизация(ТекущаяСтрока, Форма);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущаяСтрока)
	
	ТекущаяСтрока.ЗаголовокСуммаНУ              = НСтр("ru = 'Сумма:'");
	ТекущаяСтрока.ЗаголовокСуммаНеУчитываетсяНУ = НСтр("ru = 'Не уч.:'");
	ТекущаяСтрока.ЗаголовокСуммаЕНВД            = НСтр("ru = 'ЕНВД:'");
	
	ТекущаяСтрока.ЗаголовокСуммаАмортизации						= НСтр("ru = 'сумма амортизации:'");
	ТекущаяСтрока.ЗаголовокСуммаОбесценения						= НСтр("ru = 'сумма обесценения:'");
	ТекущаяСтрока.ЗаголовокДатаВводаВЭксплуатацию				= НСтр("ru = 'дата ввода в экспл.:'");
	ТекущаяСтрока.ЗаголовокОставшийсяСрокПолезногоИспользования	= НСтр("ru = 'оставшийся срок исп.:'");
	
	ТекущаяСтрока.НадписьВвестиВЭксплуатацию = НСтр("ru = ' ввести в эксплуатацию'");
	ТекущаяСтрока.НадписьСоздатьИнвКарточку = НСтр("ru =' создать'");
	
	ТекущаяСтрока.ЗаголовокСрокПолезногоИспользования1 = НСтр("ru = 'после модернизации:'");
	ТекущаяСтрока.ЗаголовокОставшийсяСрокПолезногоИспользования1 = НСтр("ru = 'оставшийся:'");
	ТекущаяСтрока.ЗаголовокФактическийСрокЭксплуатации = НСтр("ru = 'факт. срок использования:'");

	ТекущаяСтрока.ЗаголовокСрокПолезногоИспользованияНУ = НСтр("ru = 'НУ:'");
	ТекущаяСтрока.ЗаголовокОставшийсяСрокПолезногоИспользованияНУ = НСтр("ru = 'НУ:'");

	ТекущаяСтрока.ЗаголовокСтоимостьБалансовая = НСтр("ru = 'восстановительная:'");
	ТекущаяСтрока.ЗаголовокОстаточнаяСтоимость = НСтр("ru = 'остаточная:'");
	ТекущаяСтрока.ЗаголовокСтоимостьПоОкончанииРабот = НСтр("ru = 'по окончании работ:'");

	ТекущаяСтрока.ЗаголовокСтоимостьБалансоваяНУ = НСтр("ru = 'НУ:'");
	ТекущаяСтрока.ЗаголовокОстаточнаяСтоимостьНУ = НСтр("ru = 'НУ:'");
	ТекущаяСтрока.ЗаголовокСтоимостьПоОкончанииРаботНУ = НСтр("ru = 'НУ:'");

	ТекущаяСтрока.ЗаголовокВидГТ = НСтр("ru = 'вид документа:'");
	ТекущаяСтрока.ЗаголовокНомерДатаГТ = НСтр("ru = 'номер / дата / срок действия:'");

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьРедактированияСтрок(Форма)
	Если ЗначениеКонстанты("ЗапретитьИнтерактивныйВводСтрокВДокументахСписанияНФА") Тогда
		УстановитьДоступностьРедактированияСтрокНаСервере();
	КонецЕсли;	
КонецПроцедуры	     

&НаСервере
Процедура УстановитьДоступностьРедактированияСтрокНаСервере()
	ФлагНедоступности = НЕ (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.БезвозмездноеПоступление"));
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПризнакЗапрещеноДобавлениеСтрокВДокументыНФА(ЭтотОбъект, ФлагНедоступности);
	ОбщегоНазначенияБГУ.УстановитьНастройкуДоступностиРедактированияСтрокВДокументахНФА(ЭтотОбъект);
	ОбщегоНазначенияБГУКлиентСервер.ИзменитьДоступностьРедактированияСтрок(ЭтотОбъект);
КонецПроцедуры	     

&НаСервереБезКонтекста
Функция ЗначениеКонстанты(ИмяКонстанты)
	Возврат(Константы[ИмяКонстанты].Получить());
КонецФункции	

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	ВедетсяУчетДрагМатериаловВКапвожениях = 
		УчетДрагМатериалов.ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() ИЛИ Объект.МЦСДрагоценнымиМатериалами.Количество() > 0;
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	УстановитьПоДокументуВозможенУчетПрослеживаемыхТоваров(ЭтотОбъект);
	УстановитьЕстьПрослеживаемыеТовары();
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТВоВсехСтроках(ЭтотОбъект, "ОсновныеСредства");
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	РассчитатьЦенуЕдиницыВложений(ЭтотОбъект);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОС(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваОтражениеВУчете.Имя);
	ГруппаИли = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЭлементУО.Отбор,, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИли,
		"Объект.ОсновныеСредства.ОтражениеВУчетеБУЗаполненоНекорректно", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИли,
		"Объект.ОсновныеСредства.ОтражениеВУчетеНУЗаполненоНекорректно", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИли,
		"Объект.ОсновныеСредства.ОтражениеВУчетеУСНЗаполненоНекорректно", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НезаполненныйРеквизит);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваОтражениеВУчетеЕстьОшибка.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ОтражениеВУчетеЕстьОшибка", ВидСравненияКомпоновкиДанных.Равно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Отображать", Истина);
	
	// Решение сотрудника.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваРешениеСотрудникаПоРезолюции.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.РешениеСотрудникаПоРезолюции", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.За);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаПоложительногоВыполненияЗадачи);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваРешениеСотрудникаПоРезолюции.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.РешениеСотрудникаПоРезолюции", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.Против);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаОтрицательногоВыполненияЗадачи);
	
	ПрослеживаемостьФормыБГУ.УстановитьУсловноеОформление(ЭтотОбъект);
	
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваНомерИнвентарнойКарточки.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.СоздатьИнвентарнуюКарточку", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.НомерИнвентарнойКарточки", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.ОсновныеСредстваНомерИнвентарнойКарточки.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.СоздатьИнвентарнуюКарточку", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;
	
	Приобретение = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Приобретение"));
	Изготовление = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Изготовление"));
	Модернизация = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Модернизация"));
	
	Элементы.СтраницаКапитальныеВложения.Видимость = (Приобретение Или Изготовление Или Модернизация);
	Элементы.КоличествоВложений.Видимость = Не Модернизация И НЕ Объект.ПоступлениеБиблиотечногоФонда;
	Элементы.КоличествоВложений.ТолькоПросмотр = Приобретение;
	Элементы.КоличествоВложений.АвтоОтметкаНезаполненного = НЕ (Изготовление ИЛИ Модернизация);
	Элементы.КоличествоВложений.ОтметкаНезаполненного = НЕ (Изготовление ИЛИ Модернизация) И НЕ ЗначениеЗаполнено(Объект.КоличествоВложений);

	ДоступнаПереданныаяАмортизация = ДоступнаПереданнаяАмортизация(Форма);
	Элементы.ОсновныеСредстваГруппаПараметрыПереданныхОбъектов.Видимость = ДоступнаПереданныаяАмортизация;
	
	Элементы.ПервоначальнаяСтоимостьЕдиницы.Видимость          = НЕ Модернизация;
	Элементы.СуммаАмортизацииВложений.Видимость                = НЕ Модернизация;
	Элементы.СуммаОбесцененияВложений.Видимость                = НЕ Модернизация;
	Элементы.ОсновныеСредстваГруппаНоваяИнвКарточка.Видимость  = НЕ Модернизация;
	Элементы.ОсновныеСредстваГруппаСрокИспользования.Видимость = НЕ Модернизация;
	Элементы.ОсновныеСредстваКоличество.Видимость              = НЕ Модернизация И НЕ Объект.ПоступлениеБиблиотечногоФонда;
	Элементы.ОсновныеСредстваСумма.Видимость                   = НЕ Модернизация;
	Элементы.СтраницаДрагМатериалы.Видимость                   = НЕ Модернизация;
	
	Элементы.ОсновныеСредстваИтогКоличество.Видимость = НЕ Модернизация;
	Элементы.ОсновныеСредстваИтогСуммаАмортизации.Видимость = НЕ Модернизация;
	Элементы.ОсновныеСредстваИтогСуммаОбесценения.Видимость = НЕ Модернизация;
	
	МодернизацияСДвижением  = Модернизация И Объект.ФормироватьДвиженияПоМодернизации;
	МодернизацияБезДвижения = Модернизация И НЕ Объект.ФормироватьДвиженияПоМодернизации;
	
	Элементы.ОССрокПолезногоИспользованияМодернизация.Видимость = МодернизацияСДвижением;
	Элементы.ОсновныеСредстваСтоимостьМодернизация.Видимость = МодернизацияСДвижением;
	Элементы.ДекорацияСуммыПоКФО.Видимость = МодернизацияСДвижением;
	Элементы.ОсновныеСредстваСуммыПоКФО.Видимость = МодернизацияСДвижением;

	Элементы.ОсновныеСредстваСрокПолезногоИспользования1.Видимость = МодернизацияБезДвижения;
	Элементы.ОсновныеСредстваСтоимостьБалансовая1.Видимость        = МодернизацияБезДвижения;
	Элементы.ОсновныеСредстваСтоимостьПоОкончанииРабот1.Видимость  = МодернизацияБезДвижения;
	Элементы.ОсновныеСредстваСумма1.Видимость                      = Модернизация;
	
	Элементы.ОсновныеСредстваРассчитатьСтоимости.Видимость = Модернизация;
	Элементы.ФормироватьДвиженияПоМодернизации.Видимость = Модернизация;
	
	Элементы.СтраницаРаботы.Видимость = Модернизация;
	
	ВидмостьКонтрагента = ЗначениеЗаполнено(Объект.ДокументОснование) ИЛИ Форма.ЕстьДоговорУСчетаУчета
		ИЛИ Модернизация И Объект.ФормироватьДвиженияПоМодернизации; 
	Элементы.Контрагент.Видимость = ВидмостьКонтрагента;
	Элементы.Договор.Видимость = ВидмостьКонтрагента;

	ЕстьВидимостьОтражениеВУчете = Объект.ВидОперации <> 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Модернизация");
	ЭлементыФормы = Новый Массив;
	ЭлементыФормы.Добавить("ОсновныеСредстваГруппаОтражениеВУчете");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыФормы, "Видимость", ЕстьВидимостьОтражениеВУчете);

	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("ОсновныеСредстваГТ");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		МассивЭлементов, "Видимость", ВозможныГарантийныеОбязательства(Объект.ВидОперации)); 
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыГруппаКомандыЗаполнить", "Видимость", Форма.ВедетсяУчетДрагМатериаловВКапвожениях);                 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыЗаполнитьСписокДрагМатериалыПоТехДокументации", "Видимость", НЕ Форма.ВедетсяУчетДрагМатериаловВКапвожениях);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаСписанияМЦСДрагМатериалами", "Видимость", Форма.ВедетсяУчетДрагМатериаловВКапвожениях);	

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДоступнаПереданнаяАмортизация(Форма)
	ОперацииБезПереданнойАмортизации = Новый Массив;
	ОперацииБезПереданнойАмортизации.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Изготовление"));
	ОперацииБезПереданнойАмортизации.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Модернизация"));
	
	Возврат(ОперацииБезПереданнойАмортизации.Найти(Форма.Объект.ВидОперации) = Неопределено);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма)
	
	Объект = Форма.Объект;
	
	Модернизация = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Модернизация"));

	РеквизитыНУ = Новый Массив;
	РеквизитыНУ.Добавить("СуммаВложенийНУ");
	РеквизитыНУ.Добавить("РасходыНеУчитываетсяНУ");
	РеквизитыНУ.Добавить("РасходыЕНВД");
	
	РеквизитыНУ.Добавить("ОсновныеСредстваСуммаНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваСуммаНеУчитываетсяНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваСуммаЕНВД");
	РеквизитыНУ.Добавить("ОсновныеСредстваСуммыНУЗаголовки");

	РеквизитыНУ.Добавить("ОсновныеСредстваСтоимостьНУМодернизацияЗаголовки");
	РеквизитыНУ.Добавить("ОсновныеСредстваСтоимостьНУМодернизацияЗначения");
	РеквизитыНУ.Добавить("ОССрокПолезногоИспользованияНУМодернизацияЗаголовки");
	РеквизитыНУ.Добавить("ОССрокПолезногоИспользованияНУМодернизацияЗначения");
	РеквизитыНУ.Добавить("ОсновныеСредстваАмортизационнаяПремияМодернизация");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		РеквизитыНУ, "Видимость", Форма.ОтражатьВНалоговомУчете 
		И (НЕ Модернизация ИЛИ Объект.ФормироватьДвиженияПоМодернизации));
		
	Форма.Элементы.ПервоначальнаяСтоимостьЕдиницыНУ.Видимость = НЕ Модернизация;	
	
	// Таблица кап.вложений.
	РеквизитыНУ = Новый Массив;
	РеквизитыНУ.Добавить("КапитальныеВложенияСуммаНУ");
	РеквизитыНУ.Добавить("КапитальныеВложенияСуммаНеУчитываетсяНУ");
	РеквизитыНУ.Добавить("КапитальныеВложенияСуммаЕНВД");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		РеквизитыНУ, "Видимость", Форма.ОтражатьВНалоговомУчете 
			И (НЕ Модернизация ИЛИ Объект.ФормироватьДвиженияПоМодернизации)
			И (НалоговыйУчетПовтИспВызовСервера.ВедетсяУчетКапВложенийНУПоКПС(Объект.Дата)
			ИЛИ НалоговыйУчетПовтИспВызовСервера.ВедетсяУчетКапВложенийНУПоЦМО(Объект.Дата)));
	
	//ОбновитьТекстОтражениеВУчетеВсехСтрокТаблицыОС();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСтрокиТЧ_ОсновныеСредства(Форма)
	
	РассчитатьЦенуЕдиницыВложений(Форма);
	
	Для Каждого СтрокаТабЧасти Из Форма.Объект.ОсновныеСредства Цикл
		ПересчитатьСуммыТекущейСтроки(СтрокаТабЧасти, Форма);
	КонецЦикла;
	УправлениеОсновнымиСредствамиКлиентСервер.РаспределитьЗатратыПоСуммамХвТЧ(Форма);
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуВложенийНаСервере()
	
	УправлениеОсновнымиСредствами.ЗаполнитьКапитальныеВложенияПоОстаткам(Объект, "РешениеОПризнанииОбъектовОС");
	УправлениеОсновнымиСредствамиКлиентСервер.ЗаполнитьСуммыХПоСуммеДокумента(ЭтотОбъект);
	УправлениеОсновнымиСредствамиКлиентСервер.РаспределитьЗатратыПоСуммамХвТЧ(ЭтотОбъект);
	
	ОпределитьНаличиеДоговораВложения();
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ВидОперации", "Вид операции");
	СтруктураРеквизитов.Вставить("Организация", "Организация");
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		СтруктураРеквизитов.Вставить("ИФО", "ИФО");
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	//ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	//ПараметрыПодбора.Отбор.Вставить("Подразделение"	, Объект.Подразделение);
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения", "ПринятиеКУчету");
	ПараметрыПодбора.Отбор.Вставить("Счет", "101.00,102.00,111.60");
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Модернизация") Тогда
		ПараметрыПодбора.Вставить("ЭтоМодернизация", Истина);
	КонецЕсли;	
	
	Если ПараметрыПодбора.ВидРаспоряжения = "ПринятиеКУчету" Тогда
		СписокНФА = Новый Массив;
		СписокНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС"));
		СписокНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА"));
		СписокНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА"));
		ПараметрыПодбора.Отбор.Вставить("ВидНФА", СписокНФА);
	КонецЕсли;

	//ПараметрыПодбора.Вставить("ВидРаспоряжения", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе"));
	//ПараметрыПодбора.Вставить("НужнаАмортизация", Истина);
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
	//ПараметрыПодбора.Вставить("СкрытьКолонки", "КФО,КПС,СчетУчета,ЦМО");
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, ПараметрыПодбора) Экспорт

	Если Результат <> Неопределено Тогда
		ЭтоПодборКапвложения = Ложь;
		Если ПараметрыПодбора.Свойство("ЭтоПодборКапвложения", ЭтоПодборКапвложения) И ЭтоПодборКапвложения Тогда
			ОбработкаВыбораПодбораОсновныхСредствНаСервере(Результат, Истина);
			
			Если ЗначениеЗаполнено(Объект.КапитальноеВложение) Тогда
				ПриИзмененииКапитальногоВложенияСервер();
				ПересчитатьСтрокиТЧ_ОсновныеСредства(ЭтотОбъект);
			КонецЕсли;	
		Иначе	 	
			ОбработкаВыбораПодбораОсновныхСредствНаСервере(Результат);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыПодбораКапвложения() Экспорт
	
	ПараметрыПодбора = Новый Структура("Отбор", Новый Структура);
	ПараметрыПодбора.Отбор.Вставить("Организация", Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО", Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("КФО", Объект.КФО);
	ПараметрыПодбора.Отбор.Вставить("Счет", КодыСчетовКапвложений());

	ПараметрыПодбора.Вставить("ВидРаспоряжения", "Вложения");
	ПараметрыПодбора.Вставить("КолонкиКорзины", Новый Структура("Цена", "СтоимостьЕдиницы"));
	ПараметрыПодбора.Вставить("ЭтоПодборКапвложения", Истина);
	
	Возврат ПараметрыПодбора;
КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(Знач ВыбранноеЗначение, ЭтоПодборКапвложения = Ложь)
	
	Если ЭтоПодборКапвложения Тогда
		ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
		КолСтрок = ТаблицаОС.Количество();
		Если КолСтрок = 0 Тогда
			Возврат;
		ИначеЕсли КолСтрок > 1 Тогда
			ТекстСообщения = НСтр(
				"ru = 'В подборе выбрано больше одного объекта капвложений. Подбирать следует один объект.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;	
		
		Объект.КапитальноеВложение = ТаблицаОС[0].ОсновноеСредство;
		
	Иначе	
		ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(
			Объект.ОсновныеСредства, ВыбранноеЗначение, , "ОсновноеСредство,ИнвентарныйНомер");

		ЗаполнятьКПС = Ложь;

		Для Каждого НоваяСтрока Из ДобавленныеСтроки Цикл
			НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.РезолюцияКомиссии) Тогда
				НоваяСтрока.РезолюцияКомиссии = 
					УправлениеНФАКлиентСервер.ТекстРезолюцииКомиссииПоУмолчанию("РешениеОПризнанииОбъектовОС");
			КонецЕсли;
			
			ЗаполнятьКПС = ?(ЗаполнятьКПС, Истина, Не ЗначениеЗаполнено(НоваяСтрока.КПС));
		КонецЦикла;

		МассивОС = Объект.ОсновныеСредства.Выгрузить(, "ОсновноеСредство").ВыгрузитьКолонку("ОсновноеСредство");
		ДанныеОС = УправлениеОсновнымиСредствами.ДанныеОбъектовОС(МассивОС, Объект.Ссылка);
		ДанныеОС.Индексы.Добавить("ОсновноеСредство");
		
		Если ЗаполнятьКПС Тогда
			АвтоЗначениеКПС = ?(АвтоЗначениеКПС = Неопределено, ЗначениеАвтоКПСПоСчету(ЭтотОбъект), АвтоЗначениеКПС);
		КонецЕсли;
		
		Для каждого ТекущиеДанные из Объект.ОсновныеСредства Цикл
			ТекущиеДанные.Количество = ?(ТекущиеДанные.Количество = 0, 1, ТекущиеДанные.Количество);
			ПересчитатьСуммыТекущейСтроки(ТекущиеДанные, ЭтотОбъект);
			Если Не ЗначениеЗаполнено(ТекущиеДанные.КПС) И ЗначениеЗаполнено(АвтоЗначениеКПС) Тогда
				ТекущиеДанные.КПС = АвтоЗначениеКПС;
			КонецЕсли;
			ОсновныеСредстваОсновноеСредствоПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор(), ДанныеОС);
			ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущиеДанные);
			ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ТекущиеДанные, ЭтотОбъект);
		КонецЦикла;
		РассчитатьСтоимостиТЧ();
		УправлениеОсновнымиСредствамиКлиентСервер.РаспределитьЗатратыПоСуммамХвТЧ(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()
	
	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);
	
КонецФункции

#Область ГолосованиеКомиссии

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СохранитьРезультатыГолосования", "Доступность",
			ЗначениеЗаполнено(Форма.Сотрудник) И Форма.РешениеСотрудникаМодифицированность);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РезультатыГолосованияСотрудника(ТаблицаДокумента)
	
	РезультатыГолосования = Новый Массив;
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		Если ЗначениеЗаполнено(СтрокаДокумента.РешениеСотрудникаПоРезолюции) Тогда
			РезультатГолосования = Новый Структура("ИдентификаторСтроки,РешениеСотрудникаПоРезолюции",
				СтрокаДокумента.ИдентификаторСтроки, СтрокаДокумента.РешениеСотрудникаПоРезолюции);
			РезультатыГолосования.Добавить(РезультатГолосования);
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатыГолосования;
	
КонецФункции

&НаКлиенте
Процедура УстановитьРешениеВСтрокахДокумента(РешениеСотрудника, ВоВсехСтроках = Истина)
	
	РешениеСотрудникаПоРезолюции = ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.ПустаяСсылка");
	Если РешениеСотрудника = "За" Тогда
		РешениеСотрудникаПоРезолюции = ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.За");
	ИначеЕсли РешениеСотрудника = "Против" Тогда
		РешениеСотрудникаПоРезолюции = ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.Против");
	КонецЕсли;
	
	Если ВоВсехСтроках Тогда
		Для Каждого СтрокаДокумента Из Объект.ОсновныеСредства Цикл
			СтрокаДокумента.РешениеСотрудникаПоРезолюции = РешениеСотрудникаПоРезолюции;
		КонецЦикла;
	Иначе
		Для Каждого ИдентификаторВыделеннойСтроки Из Элементы.ОсновныеСредства.ВыделенныеСтроки Цикл
			СтрокаДокумента = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторВыделеннойСтроки);
			СтрокаДокумента.РешениеСотрудникаПоРезолюции = РешениеСотрудникаПоРезолюции;
		КонецЦикла;
	КонецЕсли;
	
	РешениеСотрудникаМодифицированность = Истина;
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСохранитьРезультатыГолосованияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СохранитьРезультатыГолосованияНаСервере(ДополнительныеПараметры.Сотрудник, ДополнительныеПараметры.РезультатыГолосования);
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
	
	РешениеСотрудникаМодифицированность = Ложь; // При любом ответе сбрасываем признак модифицированности.
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьРезультатыГолосованияНаСервере(ЧленКомиссии, РезультатыГолосования)
	
	ОбщегоНазначенияБГУ.СохранитьРезультатыГолосованияНаСервере(Объект, ЧленКомиссии, РезультатыГолосования);
	РешениеСотрудникаМодифицированность = Ложь;
	
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросУстановитьРешениеЕдиногласноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		УстановитьРешениеЕдиногласноНаСервере(ДополнительныеПараметры);
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
	
	РешениеСотрудникаМодифицированность = Ложь; // При любом ответе сбрасываем признак модифицированности.
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРешениеЕдиногласноНаСервере(РезультатГолосования)
	
	ОбщегоНазначенияБГУ.УстановитьРешениеЕдиногласноНаСервере(Объект, "ОсновныеСредства", РезультатГолосования);
	РешениеСотрудникаМодифицированность = Ложь;
	
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	
КонецПроцедуры

