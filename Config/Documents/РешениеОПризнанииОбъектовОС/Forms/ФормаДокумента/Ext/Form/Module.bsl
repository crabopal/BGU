&НаКлиенте
Процедура ИзменитьРеквизитыСтрок(Команда)
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("РезолюцияКомиссии");
	Реквизиты.Вставить("КПС", Новый Структура);
	Реквизиты.КПС.Вставить("Дата", Объект.Дата);
	Реквизиты.КПС.Вставить("Организация", Объект.Организация);
	Реквизиты.КПС.Вставить("ИФО", Объект.ИФО);

	ВидыПоказателей = Новый Массив;
	ВидыПоказателей.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный"));
	ВидыПоказателей.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
	ВидыПоказателей.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ"));
	Реквизиты.КПС.Вставить("ВидПоказателя", ВидыПоказателей);
	УточненияПоказателя = Новый Массив;
	УточненияПоказателя.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
	УточненияПоказателя.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.ПустаяСсылка"));
	Реквизиты.КПС.Вставить("УточнениеПоказателя", УточненияПоказателя);
	Реквизиты.КПС.Вставить("НаДату", Объект.Дата);

	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Модернизация") Тогда
		Реквизиты.Вставить("Сумма", Новый Структура("СинонимДляВыбора", "Стоимость вложений"));
	Иначе	
		Реквизиты.Вставить("Количество");
		Реквизиты.Вставить("Сумма");

		Если Элементы.ОсновныеСредстваСуммаАмортизации.Видимость Тогда
			Реквизиты.Вставить("СуммаАмортизации");
		КонецЕсли;	
		Если Элементы.ОсновныеСредстваДатаВводаВЭксплуатацию.Видимость Тогда
			Реквизиты.Вставить("ДатаВводаВЭксплуатацию");
		КонецЕсли;	
		Если Элементы.ОсновныеСредстваПринятиеКУчетуОдновременноСВводомВЭксплуатацию.Видимость Тогда
			Реквизиты.Вставить("ПринятиеКУчетуОдновременноСВводомВЭксплуатацию");
		КонецЕсли;	
		Реквизиты.Вставить("СоздатьИнвентарнуюКарточку");
	КонецЕсли;
		
	Реквизиты.Вставить("СрокПолезногоИспользования");
	Если Элементы.ОсновныеСредстваСуммаНУ.Видимость Тогда
		Реквизиты.Вставить("СуммаНУ");
	КонецЕсли;	
	Если Элементы.ОсновныеСредстваСуммаНеУчитываетсяНУ.Видимость Тогда
		Реквизиты.Вставить("СуммаНеУчитываетсяНУ");
	КонецЕсли;	
	Если Элементы.ОсновныеСредстваСуммаЕНВД.Видимость Тогда
		Реквизиты.Вставить("СуммаЕНВД");
	КонецЕсли;	
	
	Если ВозможныГарантийныеОбязательства(Объект.ВидОперации) Тогда
		Реквизиты.Вставить("НаименованиеГТ", Новый Структура);
		Реквизиты.НаименованиеГТ.Вставить("ТипыДляВыбора", 
			Новый ОписаниеТипов("Строка, СправочникСсылка.ВидыПервичныхДокументов"));
		Реквизиты.НаименованиеГТ.Вставить("СинонимДляВыбора", НСтр("ru = 'Вид документа гарантии'")); 

		Реквизиты.Вставить("НомерГТ");
		Реквизиты.Вставить("ДатаГТ");
		Реквизиты.Вставить("СрокДействияГТ");
	КонецЕсли;	
	
	ОповещениеОЗаверщенииИзменения = Новый ОписаниеОповещения("ИзменитьРеквизитыСтрок_Завершение", ЭтотОбъект);
	
	УправлениеНФАКлиент.ИзменитьРеквизитыСтрокТЧ(ЭтотОбъект, 
	"РешениеОПризнанииОбъектовОС", "ОсновныеСредства", "ОсновныеСредства", Реквизиты, ОповещениеОЗаверщенииИзменения);
КонецПроцедуры

