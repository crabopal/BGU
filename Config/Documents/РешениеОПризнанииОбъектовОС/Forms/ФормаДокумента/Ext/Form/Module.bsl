// Заполняет дополнительные данные табличной части "Основные средства",
// получаемые из учетных регистров
&НаСервере
Процедура РассчитатьСтоимостиТЧ()
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.ПустаяСтруктураПараметровПолученияОстатков();
	ПараметрыПолученияОстатков.ПолучатьАмортизацию = Истина;
	ПараметрыПолученияОстатков.ПолучатьОбесценение = Истина;
	ПараметрыПолученияОстатков.УстанавливатьКПС = Истина;
	Если Объект.Ссылка.Пустая() Тогда
		ПараметрыПолученияОстатков.Период = КонецДня(Объект.Дата);
	Иначе
		ПараметрыПолученияОстатков.Ссылка = Объект.Ссылка;
		ПараметрыПолученияОстатков.Период = Объект.Дата;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ПараметрыПолученияОстатков, Объект, "Организация, ИФО, КФО, Подразделение, ЦМО");
	
	ТаблицаОС = ПараметрыПолученияОстатков.ТаблицаОС;
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		СтрокаТабОС = ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТабОС, СтрокаТаблицы, "ОсновноеСредство, ИнвентарныйНомер");
	КонецЦикла;	
	ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстатки(ПараметрыПолученияОстатков);

	ПериодПолученияОстатков = ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Ссылка.МоментВремени());
	Если ОтражатьВНалоговомУчете Тогда
		ДанныеОС = Новый Структура("СобытияОС, ПараметрыАмортизацииНУ");
	Иначе
		ДанныеОС = Новый Структура("СобытияОС");
	КонецЕсли;	
	ДанныеПоОС(Объект.Организация, ТаблицаОС, ПериодПолученияОстатков, ДанныеОС);
	
	СтруктураПоиска = Новый Структура("ОсновноеСредство, ИнвентарныйНомер");
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТаблицы);
		СтрокиОстатков = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
		Если СтрокиОстатков.Количество() > 0 Тогда
			СтрокаТаблицы.СтоимостьБалансовая = СтрокиОстатков[0].БалансоваяСтоимость;
			СтрокаТаблицы.КПС = СтрокиОстатков[0].КПСОстатков;
			СтрокаТаблицы.СтоимостьПоОкончанииРабот = СтрокаТаблицы.СтоимостьБалансовая + СтрокаТаблицы.Сумма;
			СтрокаТаблицы.ОстаточнаяСтоимость = СтрокаТаблицы.СтоимостьБалансовая 
				- СтрокиОстатков[0].Амортизация - СтрокиОстатков[0].СуммаОбесценения;
		КонецЕсли;	
		
		СтрокиДатыОС = ДанныеОС.СобытияОС.НайтиСтроки(СтруктураПоиска);
		Если СтрокиДатыОС.Количество() > 0 Тогда
			СтрокаТаблицы.ФактическийСрокЭксплуатации = УправлениеОсновнымиСредствами.ФактическийСрокЭксплуатацииРасчет(
				СтрокиДатыОС[0].ДатаПринятиеКУчету, 
				СтрокиДатыОС[0].ДатаВводВЭксплуатацию, 
				Объект.Организация, Объект.Дата, 
				ЭтотОбъект.КэшПараметров.УчетнаяПолитика.НачислятьАмортизациюПервымЧислом);
		Иначе
			СтрокаТаблицы.ФактическийСрокЭксплуатации = 0; 
		КонецЕсли;
		
		СтрокаТаблицы.ОставшийсяСрокПолезногоИспользования = РассчитатьОставшийсяСПИ(
			СтрокаТаблицы.СрокПолезногоИспользования, СтрокаТаблицы.ФактическийСрокЭксплуатации);
	КонецЦикла;	

	Если ОтражатьВНалоговомУчете  Тогда
		СписокОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
		
		ТаблицаОС = НалоговыйУчет.ОпределитьСтоимостьСпискаОС(СписокОС, Объект, Ложь, ПериодПолученияОстатков);
		
		Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
			НайденнаяСтрока = ?(ТаблицаОС.Количество() = 1, ТаблицаОС[0],
				ТаблицаОС.Найти(СтрокаТаблицы.ОсновноеСредство, "ОсновноеСредство"));
			
			СтоимостьБалансоваяНУ = ?(НайденнаяСтрока <> Неопределено, НайденнаяСтрока.ВосстановительнаяСтоимость, 0);
			СуммаАмортизацииНУ = ?(НайденнаяСтрока <> Неопределено, НайденнаяСтрока.СуммаНачисленнойАмортизации, 0);
			
			СтрокаТаблицы.СтоимостьБалансоваяНУ = СтоимостьБалансоваяНУ;
			СтрокаТаблицы.СтоимостьПоОкончанииРаботНУ = СтрокаТаблицы.СтоимостьБалансоваяНУ + СтрокаТаблицы.СуммаНУ;
			СтрокаТаблицы.ОстаточнаяСтоимостьНУ = СтрокаТаблицы.СтоимостьБалансоваяНУ - СуммаАмортизацииНУ;
			
			// Заполним СПИ для НУ значением для БУ
			НайденнаяСтрока = ДанныеОС.ПараметрыАмортизацииНУ.Найти(СтрокаТаблицы.ОсновноеСредство, "ОсновноеСредство");
			Если НайденнаяСтрока <> Неопределено Тогда
				СтрокаТаблицы.СрокПолезногоИспользованияНУ = НайденнаяСтрока.СрокПолезногоИспользованияНУ;
			Иначе
				СтрокаТаблицы.СрокПолезногоИспользованияНУ = СтрокаТаблицы.СрокПолезногоИспользования;
			КонецЕсли;		
			РассчитатьОставшийсяСПИвСтроке(ЭтотОбъект, СтрокаТаблицы,"НУ");
		КонецЦикла;
	Иначе
		Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
			СтрокаТаблицы.СтоимостьБалансоваяНУ = 0;
			СтрокаТаблицы.СтоимостьПоОкончанииРаботНУ = 0;
			СтрокаТаблицы.ОстаточнаяСтоимостьНУ = 0;
		КонецЦикла;
	КонецЕсли;
	
	УправлениеОсновнымиСредствамиКлиентСервер.РаспределитьЗатратыПоСуммамХвТЧ(ЭтотОбъект);
КонецПроцедуры	

// Получает дополнительные данные по ОС.
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//  ТаблицаОС - ТаблицаЗНачений - содержит две колонки:
//    * ОсновноеСредство - СправочникСсылка.ОсновныеСредства
//    * ИнвентарныйНомер - СправочникСсылка.ИнвентарныеНомераОС
//  ДатаДанных - Дата - дата получения данных
//  Данные - Структура - содержит ключи двнных, которые нужно получить.
//    На входе содержит ключи, получаемых данных. На выходе для этих ключей будут заполнены значения 
//    с типом "ТаблицаЗначений", содержацие запрашиваемые данные
//    Возможные ключи: "СобытияОС", "ПараметрыАмортизацииНУ"
&НаСервере
Процедура ДанныеПоОС(Организация, ТаблицаОС, ДатаДанных, Данные)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период" , ДатаДанных);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ТаблицаОС", ТаблицаОС);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОС.ИнвентарныйНомер КАК ИнвентарныйНомер
	|Поместить ТабОС
	|ИЗ
	|	&ТаблицаОС КАК ТаблицаОС";
	
	ТекИндексЗапросов = 0;
	
	Если Данные.Свойство("СобытияОС") Тогда
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
		|	СобытияОС.ИнвНомер КАК ИнвентарныйНомер,
		|	МАКСИМУМ(выбор
		|		когда СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
		|			Тогда СобытияОС.ДатаСобытия
		|		иначе ДАТАВРЕМЯ(1, 1, 1)
		|	конец) КАК ДатаПринятиеКУчету,
		|	МАКСИМУМ(выбор
		|		когда СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)
		|			Тогда СобытияОС.ДатаСобытия
		|		иначе ДАТАВРЕМЯ(1, 1, 1)
		|	конец) КАК ДатаВводВЭксплуатацию
		|ИЗ
		|	РегистрСведений.СобытияОС.СрезПоследних(&Период, Организация = &Организация
		|	И (ОсновноеСредство, ИнвНомер) В
		|		(Выбрать
		|			ТабОС.ОсновноеСредство,
		|			ТабОС.ИнвентарныйНомер
		|		ИЗ
		|			ТабОС)
		|	И (Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
		|	ИЛИ Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию))) КАК СобытияОС
		|СГРУППИРОВАТЬ ПО
		|	СобытияОС.ОсновноеСредство,
		|	СобытияОС.ИнвНомер";

		ТекИндексЗапросов = ТекИндексЗапросов + 1;
		Данные.Вставить("СобытияОС", ТекИндексЗапросов);
	КонецЕсли;	
	
	Если Данные.Свойство("ПараметрыАмортизацииНУ") Тогда
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПараметрыАмортизацииОСНУ.ОсновноеСредство КАК ОсновноеСредство,
		|	ПараметрыАмортизацииОСНУ.СрокПолезногоИспользования КАК СрокПолезногоИспользованияНУ
		|ИЗ
		|	РегистрСведений.ПараметрыАмортизацииОСНалоговыйУчет.СрезПоследних(
		|		&Период, ОсновноеСредство В (ВЫБРАТЬ ТабОС.ОсновноеСредство ИЗ ТабОС)) КАК ПараметрыАмортизацииОСНУ";

		ТекИндексЗапросов = ТекИндексЗапросов + 1;
		Данные.Вставить("ПараметрыАмортизацииНУ", ТекИндексЗапросов);
	КонецЕсли;	
	
	Результат = Запрос.ВыполнитьПакет();
	Для каждого ТекДанные из Данные Цикл
		Данные.Вставить(ТекДанные.Ключ, Результат[ТекДанные.Значение].Выгрузить());
	КонецЦикла;	 
КонецПроцедуры

// Рассчитывает оставшийся срок полезного использования (СПИ) по налоговому учету во всех строках табличной части,
// т.к. это реквизит формы, а не объекта. 
&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьОставшийсяСПИпоТЧ_НУ(Форма)
	Объект = Форма.Объект;

	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПризнанияОС.Модернизация") 
		И Объект.ФормироватьДвиженияПоМодернизации
		И Форма.ОтражатьВНалоговомУчете Тогда
			
		Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
			РассчитатьОставшийсяСПИвСтроке(Форма, СтрокаТаблицы, "НУ");
		КонецЦикла;
	КонецЕсли;		
КонецПроцедуры		

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьОставшийсяСПИвСтроке(Форма, ТекущаяСтрока = Неопределено, Постфикс = "")
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Элементы.ОсновныеСредства.ТекущиеДанные;
	КонецЕсли;
		
	ТекСтрока = Объект.ОсновныеСредства.НайтиПоИдентификатору(ТекущаяСтрока.ПолучитьИдентификатор());
	ТекСтрока["ОставшийсяСрокПолезногоИспользования" + Постфикс] = РассчитатьОставшийсяСПИ(
		ТекСтрока["СрокПолезногоИспользования" + Постфикс], ТекСтрока.ФактическийСрокЭксплуатации);		
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьОставшийсяСПИ(СПИ, ФактическийСрокЭксплуатации)
	ОставшийсяСПИ = СПИ - ФактическийСрокЭксплуатации;
	Возврат ?(ОставшийсяСПИ < 0, 0, ОставшийсяСПИ);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтразитьВКарточкеКапвложений(Форма)
	Объект = Форма.Объект;
	
	ЭтоКапвложение = ЭтоОперацияСКапвложением(Форма);
	Если НЕ ЭтоКапвложение И Объект.ОтразитьВКарточкеКапвложений Тогда
		Объект.ОтразитьВКарточкеКапвложений = Ложь;
	ИначеЕсли ЭтоКапвложение И НЕ Объект.ОтразитьВКарточкеКапвложений Тогда
		Объект.ОтразитьВКарточкеКапвложений = Истина;
	КонецЕсли;	
КонецПроцедуры	                                  

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСчетаУчетаНаименование(Форма)
	Объект = Форма.Объект;
	Если ЗначениеЗаполнено(Объект.СчетУчета) Тогда
		Текст = НаименованиеСчета(Объект.СчетУчета);
	Иначе	
		Текст = "";
	КонецЕсли;	
	Форма.СчетУчетаНаименование = Текст;
КонецПроцедуры	

&НаСервереБезКонтекста
Функция НаименованиеСчета(Счет)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "Наименование");
КонецФункции	

&НаСервереБезКонтекста
Функция КодыСчетовКапвложений()
	Возврат ПланыСчетов.ЕПСБУ.КодыСчетовПоМаскеИСубконто("ОсновныеСредства", "106%", "106.5%");
КонецФункции	

#Область РаспределениеСуммПоКФО

&НаКлиенте
Процедура ОткрытьФормуРаспределениеПоКФО(ЭтоШапка = Ложь)
	
	ДопПараметры = Новый Структура;
	ПараметрыОповещения = Новый Структура;
	Если ЭтоШапка Тогда
		ДопПараметры.Вставить("Сумма", Объект["СуммаВложений"]);
		Для к = 1 по 7 Цикл
			Если к = 3 Тогда
				Продолжить;
			КонецЕсли;	
			
			ДопПараметры.Вставить("Сумма" + к, Объект["Сумма" + к]);
		КонецЦикла;	 
	Иначе	
		ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
		
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ДопПараметры.Вставить("Сумма", ТекущиеДанные["Сумма"]);
		Для к = 1 по 7 Цикл
			Если к = 3 Тогда
				Продолжить;
			КонецЕсли;	
			
			ДопПараметры.Вставить("Сумма" + к, ТекущиеДанные["Сумма" + к]);
		КонецЦикла;	 
	КонецЕсли;
			
	ДопПараметры.Вставить("РедактированиеРазрешено", ЭтоШапка);
	УправлениеОсновнымиСредствамиКлиент.ОткрытьФормуРаспределениеПоКФО(ЭтотОбъект, ДопПараметры, ЭтоШапка);
КонецПроцедуры

#КонецОбласти

&НаСервереБезКонтекста
Функция ВозможныГарантийныеОбязательства(ВидОперации)
	Возврат Документы.РешениеОПризнанииОбъектовОС.ВозможныГарантийныеОбязательства(ВидОперации);
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеАвтоКПСПоСчету(Форма)
	
	КПС = ПредопределенноеЗначение("Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка");
	
	Если Форма.КэшПараметров.КонтролироватьОперацииНаСоответствиеРПС
		И ЗначениеЗаполнено(Форма.Объект.СчетУчета) Тогда
		
		ЗначенияАвтозаполнения = УправлениеНФАВызовСервера.ЗначенияКПСКФОПоУмолчаниюДляСчета(
		Форма.Объект.Организация,
		Форма.Объект.ИФО,
		Форма.Объект.СчетУчета,
		Форма.Объект.Дата,
		Форма.Объект.КФО);
		
		Если ЗначенияАвтозаполнения <> Неопределено Тогда
			КПС = ЗначенияАвтозаполнения.КПС;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат КПС;
	
КонецФункции

