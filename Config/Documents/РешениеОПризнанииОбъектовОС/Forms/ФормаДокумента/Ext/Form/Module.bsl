&НаКлиенте
Процедура ПеренестиИзТЧ_ОС(Команда)
	Объект.СведенияОВидахРабот.Очистить();
	Для каждого СтрокаОС из Объект.ОсновныеСредства Цикл
		СтрокаРабот = Объект.СведенияОВидахРабот.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРабот, СтрокаОС, 
			"ОсновноеСредство, ИнвентарныйНомер, СтоимостьПоОкончанииРабот"); 
		СтрокаРабот.СуммаМодернизации = СтрокаОС.Сумма;
	КонецЦикла;	
КонецПроцедуры

