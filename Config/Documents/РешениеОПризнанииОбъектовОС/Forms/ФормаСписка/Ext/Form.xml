				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	РешениеОПризнанииОбъектовОС.Ссылка КАК Ссылка,
	РешениеОПризнанииОбъектовОС.ПометкаУдаления КАК ПометкаУдаления,
	РешениеОПризнанииОбъектовОС.Номер КАК Номер,
	РешениеОПризнанииОбъектовОС.Дата КАК Дата,
	ВЫБОР
		КОГДА РешениеОПризнанииОбъектовОС.Проведен
			ТОГДА ВЫБОР
					КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
							ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
						ТОГДА РешениеОПризнанииОбъектовОС.Дата
					ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
				КОНЕЦ
		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	КОНЕЦ КАК ДатаПроведения,
	РешениеОПризнанииОбъектовОС.Проведен КАК Проведен,
	РешениеОПризнанииОбъектовОС.Организация КАК Организация,
	РешениеОПризнанииОбъектовОС.ИФО КАК ИФО,
	РешениеОПризнанииОбъектовОС.Подразделение КАК Подразделение,
	РешениеОПризнанииОбъектовОС.СчетУчета КАК СчетУчета,
	РешениеОПризнанииОбъектовОС.ВидОперации КАК ВидОперации,
	РешениеОПризнанииОбъектовОС.Комиссия КАК Комиссия,
	РешениеОПризнанииОбъектовОС.Комментарий КАК Комментарий,
	РешениеОПризнанииОбъектовОС.Ответственный КАК Ответственный,
	ОсновноеСредствоДокумента.ОсновноеСредство КАК ОсновноеСредство,
	ОсновноеСредствоДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
	ВЫБОР
		КОГДА ОсновноеСредствоДокумента.ОсновноеСредство ЕСТЬ NULL
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК СписокОС,
	ВЫБОР
		КОГДА ОсновноеСредствоДокумента.ИнвентарныйНомер ЕСТЬ NULL
			ТОГДА ИСТИНА
		КОГДА ОсновноеСредствоДокумента.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
			ТОГДА ЕСТЬNULL(ОсновноеСредствоДокумента.ОсновноеСредство.ГрупповойУчет, ЛОЖЬ)
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК СписокИнвНомеров,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
	СостоянияЭД.ПредставлениеСостояния КАК СостояниеЭДО,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	NULL КАК СостояниеОригиналаПервичногоДокумента,
	ИСТИНА КАК ОбщееСостояние,
	0 КАК СостояниеОригиналПолучен
ИЗ
	Документ.РешениеОПризнанииОбъектовОС КАК РешениеОПризнанииОбъектовОС
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		ПО РешениеОПризнанииОбъектовОС.Ссылка = ОперацииДокументов.Документ}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияЭД
		ПО РешениеОПризнанииОбъектовОС.Ссылка = СостоянияЭД.СсылкаНаОбъект}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО РешениеОПризнанииОбъектовОС.Ссылка = НаличиеФайлов.ОбъектСФайлами}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновноеСредствоДокумента КАК ОсновноеСредствоДокумента
		ПО РешениеОПризнанииОбъектовОС.Ссылка = ОсновноеСредствоДокумента.Документ}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
		ПО РешениеОПризнанииОбъектовОС.Ссылка = ДатыПроведенияДокументов.Документ}</QueryText>
