&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()
	
	СписокКодов = ОбщегоНазначения.ВыгрузитьКолонку(Объект.НДФЛ, "КодНалоговогоОргана", Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РегистрацииВНалоговомОргане.Ссылка КАК Ссылка,
		|	РегистрацииВНалоговомОргане.Код КАК Код,
		|	РегистрацииВНалоговомОргане.КодПоОКТМО КАК КодПоОКТМО,
		|	РегистрацииВНалоговомОргане.КПП КАК КПП
		|ИЗ
		|	Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
		|ГДЕ
		|	РегистрацииВНалоговомОргане.Владелец = &Организация
		|	И РегистрацииВНалоговомОргане.Код В(&СписокКодов)
		|	И НЕ РегистрацииВНалоговомОргане.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("СписокКодов", СписокКодов);
	
	ДействующиеРегистрации = Запрос.Выполнить().Выгрузить();
	Для каждого Строка Из ДействующиеРегистрации Цикл
		Строка.КодПоОКТМО = СокрЛП(Строка.КодПоОКТМО);
	КонецЦикла;
	
    Отбор = Новый Структура("Код,КодПоОКТМО,КПП");
	
	Для каждого СтрокаНДФЛ Из Объект.НДФЛ Цикл
		
		Отбор.Код 		 = СтрокаНДФЛ.КодНалоговогоОргана;
		Отбор.КодПоОКТМО = СокрЛП(СтрокаНДФЛ.КодПоОКТМО);
		Отбор.КПП 		 = СтрокаНДФЛ.КПП;
		НашлиСтроки 	 = ДействующиеРегистрации.НайтиСтроки(Отбор);
		
		Если НашлиСтроки.Количество() > 0 Тогда
			СтрокаНДФЛ.РегистрацияВНалоговомОргане = НашлиСтроки[0].Ссылка;		
		КонецЕсли;

		ОбновитьТекстОтражениеВУчете(СтрокаНДФЛ);
		
	КонецЦикла;

КонецПроцедуры

