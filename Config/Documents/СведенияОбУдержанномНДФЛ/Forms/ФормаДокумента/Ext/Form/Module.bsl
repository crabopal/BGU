&НаСервереБезКонтекста
Функция ДанныеСтрокиНДФЛПриИзмененииСтатьяФинансированияЗарплата(Знач ДанныеСтроки)

	Результат = Новый Структура;
	Если Не ЗначениеЗаполнено(ДанныеСтроки.СтатьяФинансированияЗарплата) Тогда
		Возврат Результат;	
	КонецЕсли;
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкаСтатейФинансированияЗарплатаСрезПоследних.ИФО КАК ИФО,
		|	НастройкаСтатейФинансированияЗарплатаСрезПоследних.КФО КАК КФО,
		|	НастройкаСтатейФинансированияЗарплатаСрезПоследних.КПС КАК КПС,
		|	ВЫБОР
		|		КОГДА НастройкаСтатейФинансированияЗарплатаСрезПоследних.ВидОперации = &ВидОперации
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ПриоритетВидаОперации,
		|	ВЫБОР
		|		КОГДА НастройкаСтатейФинансированияЗарплатаСрезПоследних.КЭК = &КЭК
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ПриоритетКЭК
		|ИЗ
		|	РегистрСведений.НастройкаСтатейФинансированияЗарплата.СрезПоследних(
		|			&Период,
		|			СтатьяФинансированияЗарплата = &СтатьяФинансированияЗарплата
		|				И Организация = &Организация
		|				И ВидОперации В (&ВидОперации, ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоЗарплате.ПустаяСсылка))
		|				И КЭК В (&КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка))) КАК НастройкаСтатейФинансированияЗарплатаСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПриоритетВидаОперации,
		|	ПриоритетКЭК";
	
	Запрос.УстановитьПараметр("Период", 					  ДанныеСтроки.Дата);
	Запрос.УстановитьПараметр("ВидОперации", 				  ДанныеСтроки.ВидОперацииПоЗарплате);
	Запрос.УстановитьПараметр("КЭК", 						  ДанныеСтроки.КЭК);
	Запрос.УстановитьПараметр("Организация", 				  ДанныеСтроки.Организация);
	Запрос.УстановитьПараметр("СтатьяФинансированияЗарплата", ДанныеСтроки.СтатьяФинансированияЗарплата);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
	    Выборка.Следующий();
		
		Если ИспользоватьУчетПоИФО Тогда
			Результат.Вставить("ИФО", Выборка.ИФО);
		КонецЕсли;

		Результат.Вставить("КФО", Выборка.КФО);
		Результат.Вставить("КПС", Выборка.КПС);
		
		Если Не ЗначениеЗаполнено(ДанныеСтроки.КЭК) Тогда
			Результат.Вставить("КЭК", БухгалтерскийУчетПовтИсп.КЭКПоКоду("211"));
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ДанныеСтроки)
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Дата", Объект.Дата);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("ИФО", ДанныеСтроки.ИФО);
	ПараметрыФормы.Вставить("КФО", ДанныеСтроки.КФО);
	ПараметрыФормы.Вставить("КПС", ДанныеСтроки.КПС);
	
	ПараметрыФормы.Вставить("Подразделение", ДанныеСтроки.Подразделение);
	ПараметрыФормы.Вставить("РежимОбязательноУказатьПодразделение", Истина);
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО", 		Истина);
	ПараметрыФормы.Вставить("ТолькоПросмотрКПС", 		Ложь);
	ПараметрыФормы.Вставить("ВидимостьКФО", 			Истина);
	ПараметрыФормы.Вставить("ВидимостьКПС", 			Истина);
	ПараметрыФормы.Вставить("ОбязательностьКПС", 		Ложь);
	ПараметрыФормы.Вставить("ВидимостьКЭК", 			Ложь);
	ПараметрыФормы.Вставить("ВидимостьПодразделение", 	Истина);
	ПараметрыФормы.Вставить("ВидимостьКоличество", 		Ложь);
	
	// Бухгалтерский учет
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.Счет);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.Субконто1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.Субконто2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.Субконто3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", 			НСтр("ru = 'Счет учета НДФЛ'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет", 			НСтр("ru = 'Счет'"));
	ПараметрыФормы.Вставить("ЗаголовокПодразделение", 	НСтр("ru = 'Подразделение'"));
	
	ПараметрыСчета = Новый Структура;
	ПараметрыСчета.Вставить("ОграниченияСписокСчетов", СписокСчетов("303.01", Объект.Дата, Объект.Организация));
	ПараметрыСчета.Вставить("ВидСравненияВСписке", 	Истина);
	ПараметрыСчета.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
	ПараметрыСчета.Вставить("Организация", 			Объект.Организация);
	ПараметрыСчета.Вставить("ИФО", 					ДанныеСтроки.ИФО);
	ПараметрыСчета.Вставить("НаДату",				Объект.Дата);
	ПараметрыФормы.Вставить("ПараметрыСчета", 		ПараметрыСчета);
	
	ПараметрыФормы.Вставить("ЕстьНДС", Ложь);
	ПараметрыФормы.Вставить("НДСКРаспределению", Ложь);
	ПараметрыФормы.Вставить("СчетУчетаНДС", Неопределено);

	ПараметрыФормы.Вставить("Валюта", ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	ПараметрыФормы.Вставить("ЕстьНалоговыйУчет", Ложь);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

