#Область ОписаниеПеременных

&НаКлиенте
Перем РежимРедактированияСтроки;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка,
		Элементы.БухгалтерскаяОперация);
	// Конец Типовые операции и дополнительные табличные части

	Если Параметры.Ключ.Пустая() Тогда
		Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.Месяц) Тогда
			Объект.Месяц = НачалоМесяца(Объект.Дата);
		КонецЕсли;
	
		ПодготовитьФормуНаСервере();
	КонецЕсли;

	УстановитьУсловноеОформление();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ВерсионированиеОбъектов

	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	РежимРедактированияСтроки = Ложь;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект,
		Элементы.БухгалтерскаяОперация);
	// Конец Типовые операции и дополнительные табличные части

	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.НастройкаОтраженияВУчете" Тогда
		
		ОбработкаВыбораОтраженияВУчетеНаКлиенте(ВыбранноеЗначение);
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ЗаполнитьДобавленныеКолонкиТаблиц();

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	
	Если Не ЗначениеЗаполнено(Объект.Месяц) Тогда
		Объект.Месяц = НачалоМесяца(Объект.Дата);
		МесяцСтрокой = ПолучитьПредставлениеМесяца(Объект.Месяц);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МесяцСтрокойПриИзменении(Элемент)
	
	МесяцСтрокой = ПолучитьПредставлениеМесяца(Объект.Месяц);
	
КонецПроцедуры

&НаКлиенте
Процедура МесяцСтрокойНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыВыбораПериода = Новый Структура("НачалоПериода, КонецПериода", НачалоМесяца(Объект.Месяц), КонецМесяца(Объект.Месяц));
	ОписаниеОповещения     = Новый ОписаниеОповещения("МесяцСтрокойНачалоВыбораЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериодаМесяц",
		ПараметрыВыбораПериода,
		Элементы.МесяцСтрокой,
		,
		,
		,
		ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура МесяцСтрокойРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	Объект.Месяц = ДобавитьМесяц(Объект.Месяц, Направление);
	МесяцСтрокой   = ПолучитьПредставлениеМесяца(Объект.Месяц);
	
КонецПроцедуры

&НаКлиенте
Процедура МесяцСтрокойОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНДФЛ

&НаКлиенте
Процедура НДФЛВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "НДФЛОтражениеВУчете" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиОтраженияВУчете(Элемент.ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НДФЛПриАктивизацииЯчейки(Элемент)

	ТекущиеДанные = Элементы.НДФЛ.ТекущиеДанные;
	
	Если Элемент.ТекущийЭлемент = Элементы.НДФЛОтражениеВУчете
		И РежимРедактированияСтроки И Не ТекущиеДанные.ОтражениеВУчетеЗаполнено Тогда
		
			ОткрытьФормуНастройкиОтраженияВУчете(ТекущиеДанные);
			
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НДФЛПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	ТекущиеДанные = Элементы.НДФЛ.ТекущиеДанные;
	РежимРедактированияСтроки = Истина;
	
	Если НоваяСтрока И Не Копирование Тогда
		ТекущиеДанные.РегистрацияВНалоговомОргане = РегистрацияВНалоговомОргане;
		ТекущиеДанные.КодНалоговогоОргана = КодНалоговогоОргана;
		ТекущиеДанные.КПП                 = КППОрганизации;
		ТекущиеДанные.КодПоОКТМО          = КодПоОКТМО;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НДФЛПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	РежимРедактированияСтроки = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура НДФЛСтатьяФинансированияЗарплатаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.НДФЛ.ТекущиеДанные;
    ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("СтатьяФинансированияЗарплата", 	ТекущиеДанные.СтатьяФинансированияЗарплата);
	ДанныеСтроки.Вставить("ВидОперацииПоЗарплате", 			ТекущиеДанные.ВидОперацииПоЗарплате);
	ДанныеСтроки.Вставить("КЭК", 							ТекущиеДанные.КЭК);
	ДанныеСтроки.Вставить("Организация", 					Объект.Организация);
	ДанныеСтроки.Вставить("Дата", 							Объект.Дата);
	
	НовыеДанныеСтроки = ДанныеСтрокиНДФЛПриИзмененииСтатьяФинансированияЗарплата(ДанныеСтроки); 
    ЗаполнитьЗначенияСвойств(ТекущиеДанные, НовыеДанныеСтроки);

КонецПроцедуры

&НаКлиенте
Процедура НДФЛВидНалогаИлиПлатежаПриИзменении(Элемент)

	ТекущиеДанные 		= Элементы.НДФЛ.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ВидНалогаИлиПлатежа) Тогда
		Возврат;	
	КонецЕсли;
	
	ТекущиеДанные.КодБК = КБКВидаНалога(ТекущиеДанные.ВидНалогаИлиПлатежа);
	
КонецПроцедуры

&НаКлиенте
Процедура НДФЛНалогСборПлатежПриИзменении(Элемент)

	ТекущиеДанные 	 = Элементы.НДФЛ.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.НалогСборПлатеж) Тогда
		Возврат;	
	КонецЕсли;
	
	КодПоОКТМОНалога = КодПоОКТМОНалога(ТекущиеДанные.НалогСборПлатеж);
	Если ЗначениеЗаполнено(КодПоОКТМОНалога)
		И СокрЛП(КодПоОКТМОНалога) <> СокрЛП(ТекущиеДанные.КодПоОКТМО) Тогда
			ТекущиеДанные.РегистрацияВНалоговомОргане = Неопределено;
			ТекущиеДанные.КодНалоговогоОргана = "";
			ТекущиеДанные.КПП 				  = "";
			ТекущиеДанные.КодПоОКТМО 		  = КодПоОКТМОНалога;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НДФЛКодБКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок"		, "Выбор кода");
	ПараметрыФормы.Вставить("Префикс"		, "СписокКодов");
	ПараметрыФормы.Вставить("ИмяМакета"		, "КодыКБК");
	ПараметрыФормы.Вставить("ТекущийПериод"	, Объект.Дата);
	ПараметрыФормы.Вставить("ТекущийКод"	, Элемент.ТекстРедактирования);
	
	ОткрытьФорму("ОбщаяФорма.ФормаВыбораКода", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура НДФЛРегистрацияВНалоговомОрганеПриИзменении(Элемент)
	ТекущиеДанные = Элементы.НДФЛ.ТекущиеДанные;
	РеквизитыНалоговогоОргана         = РеквизитыНалоговогоОргана(ТекущиеДанные.РегистрацияВНалоговомОргане);
	ТекущиеДанные.КодНалоговогоОргана = РеквизитыНалоговогоОргана.Код;
	ТекущиеДанные.КПП 		 		  = РеквизитыНалоговогоОргана.КПП;
	ТекущиеДанные.КодПоОКТМО          = РеквизитыНалоговогоОргана.КодПоОКТМО;
КонецПроцедуры

&НаКлиенте
Процедура НДФЛОтражениеВУчетеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ОткрытьФормуНастройкиОтраженияВУчете(Элементы.НДФЛ.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура НДФЛОтражениеВУчетеОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка    = Ложь;
	ТекущиеДанные           = Элементы.НДФЛ.ТекущиеДанные;
	ТекущиеДанные.Счет      = Неопределено;
	ТекущиеДанные.Субконто1 = Неопределено;
	ТекущиеДанные.Субконто2 = Неопределено;
	ТекущиеДанные.Субконто3 = Неопределено;
	ОбновитьТекстОтражениеВУчете(ТекущиеДанные);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом(Команда)
	ОбменСАрхивомКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Объект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти
#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ИнициализироватьРеквизитыОрганизации();
	МесяцСтрокой = ПолучитьПредставлениеМесяца(Объект.Месяц);
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	ИнициализироватьРеквизитыОрганизации();
	ОчиститьСубконтоПриИзмененииОрганизации();
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьРеквизитыОрганизации()
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Организация,
		"РегистрацияВНалоговомОргане,КодНалоговогоОргана,КПП,КодОКТМО");
	
	РегистрацияВНалоговомОргане = РеквизитыОрганизации.РегистрацияВНалоговомОргане;
	КодНалоговогоОргана = РеквизитыОрганизации.КодНалоговогоОргана;
	КППОрганизации 		= РеквизитыОрганизации.КПП;
	КодПоОКТМО 			= РеквизитыОрганизации.КодОКТМО;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьСубконтоПриИзмененииОрганизации()

	ПараметрыУстановки = БухгалтерскийУчетКлиентСервер.ПараметрыУстановкиСвойствСубконтоПоШаблону("Субконто", "Субконто", "Счет");
	
	Для каждого СтрокаТаблицы Из Объект.НДФЛ Цикл
		БухгалтерскийУчетКлиентСервер.ОчиститьСубконтоПриИзмененииОрганизации(СтрокаТаблицы, ПараметрыУстановки);
	КонецЦикла;	
		
КонецПроцедуры

&НаКлиенте
Процедура МесяцСтрокойНачалоВыбораЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт 
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
