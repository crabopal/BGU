#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.СведенияОбУдержанномНДФЛ";
	КомандаПечати.Идентификатор  = "СведенияОбУдержанномНДФЛ";
	КомандаПечати.Представление  = НСтр("ru = 'Сведения об удержанном НДФЛ'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - Массив - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр)
//  ОбъектыПечати - СписокЗначений - значение - ссылка на объект;
//                                            представление - имя области, в которой был выведен объект (выходной параметр);
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СведенияОбУдержанномНДФЛ") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"СведенияОбУдержанномНДФЛ", НСтр("ru = 'Сведения об удержанном НДФЛ'"),
			ПечатьСведенияОбУдержанномНДФЛ(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьСведенияОбУдержанномНДФЛ(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы   = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб          = Истина;
	ТабличныйДокумент.ТолькоПросмотр	   = Истина;
	ТабличныйДокумент.КлючПараметровПечати = "ПараметрыПечати_СведенияОбУдержанномНДФЛ";

	УчетПоИФО 			 = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.СведенияОбУдержанномНДФЛ.ПФ_MXL_СведенияОбУдержанномНДФЛ");
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	
	Если УчетПоИФО Или УчетПоПодразделениям Тогда
		ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	Иначе
		ОбластьШапка  = Макет.ПолучитьОбласть("ШапкаБезИФО");
		ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаБезИФО");
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура("ЗаголовокИФОПодразделение");
	СоставЗаголовкаИФОПодразделение = Новый Массив;
	Если УчетПоИФО Тогда
		СоставЗаголовкаИФОПодразделение.Добавить(НСтр("ru = 'ИФО'"));
	КонецЕсли;
	Если УчетПоПодразделениям Тогда
		СоставЗаголовкаИФОПодразделение.Добавить(НСтр("ru = 'Подразделение'"));
	КонецЕсли;
	ПараметрыЗаполнения.ЗаголовокИФОПодразделение = СтрСоединить(СоставЗаголовкаИФОПодразделение, ", ");
	ОбластьШапка.Параметры.Заполнить(ПараметрыЗаполнения);
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");

	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УдержанныйНДФЛ.Ссылка.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	|	УдержанныйНДФЛ.Ссылка.Месяц КАК Месяц,
	|	УдержанныйНДФЛ.Ссылка.Дата КАК Дата,
	|	УдержанныйНДФЛ.Ссылка.Номер КАК Номер,
	|	УдержанныйНДФЛ.Ссылка КАК Ссылка,
	|	УдержанныйНДФЛ.НомерСтроки КАК НомерСтроки,
	|	УдержанныйНДФЛ.КодБК КАК КодБК,
	|	УдержанныйНДФЛ.КПП КАК КПП,
	|	УдержанныйНДФЛ.КодПоОКТМО КАК КодПоОКТМО,
	|	УдержанныйНДФЛ.КодНалоговогоОргана КАК КодНалоговогоОргана,
	|	УдержанныйНДФЛ.ДатаУдержания КАК ДатаУдержания,
	|	УдержанныйНДФЛ.СрокУплаты КАК СрокУплаты,
	|	УдержанныйНДФЛ.ИФО КАК ИФО,
	|	УдержанныйНДФЛ.ИФО.Наименование КАК НаименованиеИФО,
	|	УдержанныйНДФЛ.КФО КАК КФО,
	|	УдержанныйНДФЛ.КПС КАК КПС,
	|	УдержанныйНДФЛ.КЭК КАК КЭК,
	|	УдержанныйНДФЛ.Сумма КАК Сумма,
	|	УдержанныйНДФЛ.Подразделение КАК Подразделение,
	|	УдержанныйНДФЛ.Подразделение.Наименование КАК НаименованиеПодразделения,
	|	УдержанныйНДФЛ.Счет КАК Счет,
	|	УдержанныйНДФЛ.Субконто1 КАК Субконто1,
	|	УдержанныйНДФЛ.Субконто2 КАК Субконто2,
	|	УдержанныйНДФЛ.Субконто3 КАК Субконто3
	|ИЗ
	|	Документ.СведенияОбУдержанномНДФЛ.НДФЛ КАК УдержанныйНДФЛ
	|ГДЕ
	|	УдержанныйНДФЛ.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	УдержанныйНДФЛ.НомерСтроки";

	Выборка = Запрос.Выполнить().Выбрать();
	
	ПервыйДокумент = Истина;
	
	ПараметрыШапки  = Новый Структура("НаименованиеОрганизации,Месяц,ДатаДокумента,НомерДокумента");
	ПараметрыСтроки = Новый Структура("НомерСтроки,КодБК,КПП,КодПоОКТМО,ДатаУдержания,
		|СрокУплаты,Сумма,ИФОПодразделение,КФО,КПС,КЭК,ПредставлениеСчета");
	
	Пока Выборка.СледующийПоЗначениюПоля("Ссылка") Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ПараметрыШапки.НаименованиеОрганизации = Выборка.НаименованиеОрганизации;
		ПараметрыШапки.Месяц 		  = Формат(Выборка.Месяц,"ДФ='ММMM yyyy'");
		ПараметрыШапки.ДатаДокумента  = Формат(Выборка.Дата, "ДЛФ=D");
		ПараметрыШапки.НомерДокумента = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Выборка.Номер, Истина, Истина);
		
		ОбластьЗаголовок.Параметры.Заполнить(ПараметрыШапки);

		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		Итог = 0;
		Пока Выборка.СледующийПоЗначениюПоля("НомерСтроки") Цикл
			
			ЗаполнитьЗначенияСвойств(ПараметрыСтроки, Выборка);
			
			ПараметрыСтроки.ДатаУдержания = Формат(Выборка.ДатаУдержания, "ДФ=dd.MM.yyyy");
			ПараметрыСтроки.СрокУплаты 	  = Формат(Выборка.СрокУплаты, "ДФ=dd.MM.yyyy");
			ПараметрыСтроки.Сумма 		  = Формат(Выборка.Сумма, "ЧЦ=15; ЧДЦ=2");
			
			ИФОПодразделение = Новый Массив;
			Если УчетПоИФО Тогда
				ИФОПодразделение.Добавить(Выборка.НаименованиеИФО);
			КонецЕсли;
			Если УчетПоПодразделениям И ЗначениеЗаполнено(Выборка.Подразделение) Тогда
				ИФОПодразделение.Добавить(Выборка.НаименованиеПодразделения);
			КонецЕсли;
			ПараметрыСтроки.ИФОПодразделение   = СтрСоединить(ИФОПодразделение, ", ");
			ПараметрыСтроки.ПредставлениеСчета = ПредставлениеСчетаНаПечать(Выборка);
			
			ОбластьСтрока.Параметры.Заполнить(ПараметрыСтроки);
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			Итог = Итог + Выборка.Сумма;
		КонецЦикла;
		ОбластьПодвал.Параметры.Сумма = Формат(Итог, "ЧЦ=15; ЧДЦ=2");
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПредставлениеСчетаНаПечать(Выборка)
	
	Если Не ЗначениеЗаполнено(Выборка.Счет) Тогда
		Возврат НСтр("ru = '<авто>'");	
	КонецЕсли;
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("Счет", Выборка.Счет);
	ДанныеСтроки.Вставить("Субконто1", Выборка.Субконто1);
	ДанныеСтроки.Вставить("Субконто2", Выборка.Субконто2);
	ДанныеСтроки.Вставить("Субконто3", Выборка.Субконто3);
	ДанныеСтроки.Вставить("ОтражениеВУчете", "");
	ДанныеСтроки.Вставить("ОтражениеВУчетеЗаполнено");

	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(ДанныеСтроки);
	
	Возврат ДанныеСтроки.ОтражениеВУчете;

КонецФункции


#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация, Дата");
	
	СчетНДФЛ      = БухгалтерскийУчет.СчетПоКоду("303.01", РеквизитыДокумента.Дата, РеквизитыДокумента.Организация);
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетНДФЛ);
	
	ЗаполнятьСубконто1 = СвойстваСчета.КоличествоСубконто > 0  
		И СвойстваСчета.ВидСубконто1ТипЗначения.СодержитТип(Тип("СправочникСсылка.ВидыНалоговИПлатежей"));
	
	ЗаполнятьСубконто2 = СвойстваСчета.КоличествоСубконто > 1  
		И СвойстваСчета.ВидСубконто2ТипЗначения.СодержитТип(Тип("СправочникСсылка.НалогиИПлатежиОрганизации"));
		
	ВидНалогаАвто = Справочники.ВидыНалоговИПлатежей.НДФЛ;
	НалогАвто     = Справочники.НалогиИПлатежиОрганизации.НалогСборПлатежПоУмолчанию(РеквизитыДокумента.Организация, ВидНалогаАвто);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СведенияОбУдержанномНДФЛНДФЛ.ДатаУдержания КАК Период,
		|	СведенияОбУдержанномНДФЛНДФЛ.Ссылка.Организация КАК Организация,
		|	ЕСТЬNULL(ВидыНалоговИПлатежей.Ссылка, &ВидНалогаАвто) КАК ВидНалогаИлиПлатежа,
		|	СведенияОбУдержанномНДФЛНДФЛ.Сумма КАК Сумма,
		|	ЕСТЬNULL(НалогиИПлатежиОрганизации.Ссылка, ЗНАЧЕНИЕ(Справочник.НалогиИПлатежиОрганизации.ПустаяСсылка)) КАК НалогСборПлатеж,
		|	СведенияОбУдержанномНДФЛНДФЛ.КодБК КАК КодБК,
		|	СведенияОбУдержанномНДФЛНДФЛ.КПП КАК КПП,
		|	СведенияОбУдержанномНДФЛНДФЛ.КодПоОКТМО КАК КодПоОКТМО,
		|	СведенияОбУдержанномНДФЛНДФЛ.СрокУплаты КАК СрокУплаты,
		|	ВЫБОР
		|		КОГДА &УчетПоИФО
		|			ТОГДА СведенияОбУдержанномНДФЛНДФЛ.ИФО
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
		|	КОНЕЦ КАК ИФО,
		|	СведенияОбУдержанномНДФЛНДФЛ.КФО КАК КФО,
		|	СведенияОбУдержанномНДФЛНДФЛ.КПС КАК КПС,
		|	СведенияОбУдержанномНДФЛНДФЛ.КЭК КАК КЭК,
		|	ВЫБОР
		|		КОГДА &УчетПоПодразделениям
		|			ТОГДА СведенияОбУдержанномНДФЛНДФЛ.Подразделение
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ КАК Подразделение,
		|	ЕСТЬNULL(ЕПСБУ.Ссылка, &СчетНДФЛ) КАК Счет,
		|	ВЫБОР
		|		КОГДА ЕПСБУ.Ссылка ЕСТЬ NULL
		|				И &ЗаполнятьСубконто1
		|			ТОГДА &ВидНалогаАвто
		|		ИНАЧЕ СведенияОбУдержанномНДФЛНДФЛ.Субконто1
		|	КОНЕЦ КАК Субконто1,
		|	ВЫБОР
		|		КОГДА ЕПСБУ.Ссылка ЕСТЬ NULL
		|				И &ЗаполнятьСубконто2
		|			ТОГДА &НалогАвто
		|		ИНАЧЕ СведенияОбУдержанномНДФЛНДФЛ.Субконто2
		|	КОНЕЦ КАК Субконто2,
		|	СведенияОбУдержанномНДФЛНДФЛ.Субконто3 КАК Субконто3,
		|	СведенияОбУдержанномНДФЛНДФЛ.КодНалоговогоОргана КАК КодНалоговогоОргана
		|ИЗ
		|	Документ.СведенияОбУдержанномНДФЛ.НДФЛ КАК СведенияОбУдержанномНДФЛНДФЛ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ПО СведенияОбУдержанномНДФЛНДФЛ.Счет = ЕПСБУ.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНалоговИПлатежей КАК ВидыНалоговИПлатежей
		|		ПО СведенияОбУдержанномНДФЛНДФЛ.Субконто1 = ВидыНалоговИПлатежей.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НалогиИПлатежиОрганизации КАК НалогиИПлатежиОрганизации
		|		ПО СведенияОбУдержанномНДФЛНДФЛ.Субконто2 = НалогиИПлатежиОрганизации.Ссылка
		|ГДЕ
		|	СведенияОбУдержанномНДФЛНДФЛ.Ссылка = &Ссылка";
		
	Запрос.УстановитьПараметр("Ссылка",               ДокументСсылка);
	Запрос.УстановитьПараметр("УчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запрос.УстановитьПараметр("СчетНДФЛ",             СчетНДФЛ);
	Запрос.УстановитьПараметр("ЗаполнятьСубконто1",   ЗаполнятьСубконто1);
	Запрос.УстановитьПараметр("ЗаполнятьСубконто2",   ЗаполнятьСубконто2);
	Запрос.УстановитьПараметр("ВидНалогаАвто",        ВидНалогаАвто);
	Запрос.УстановитьПараметр("НалогАвто",            НалогАвто);
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("СведенияОбУдержанномНДФЛ",
		Запрос.Выполнить().Выгрузить());	
	
КонецПроцедуры

#КонецОбласти

// Возвращает соответствие вида налога НДФЛ видам операции по зарплате
// определенное по данным справочника ВидыОперацийОтраженияЗарплаты
// и регистра сведений СоответствиеОперацийУчетаЗарплаты
//
// Параметры:
//  ОперацияЗГУ - ПеречислениеСсылка.ВидыОперацийПоЗарплате - если заполнено,
//                будет подготовлено соответствие только для переданного параметра
// 
// Возвращаемое значение:
//   Соответствие:
//            * Ключ - ПеречислениеСсылка.ВидыОперацийПоЗарплате
//            * Значение - СправочникСсылка.ВидыНалоговИПлатежей
//
Функция ВидыНалогаПоВидуОперацииЗГУНастраиваемые(ОперацияЗГУ = Неопределено) Экспорт
	
	ОперацииЗГУ = Новый Массив;

	Если Не ЗначениеЗаполнено(ОперацияЗГУ) Тогда
		ОперацииЗГУ.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛ);
	Иначе	
		ОперацииЗГУ.Добавить(ОперацияЗГУ);
	КонецЕсли;
	
	ВидыНалогаПоВидуОперацииЗГУНастраиваемые = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СоответствиеОперацийУчетаЗарплаты.ОперацияЗГУ КАК ОперацияЗГУ,
		|	СоответствиеОперацийУчетаЗарплаты.ОперацияБГУ.ВидНалога КАК ВидНалогаИлиПлатежа
		|ИЗ
		|	РегистрСведений.СоответствиеОперацийУчетаЗарплаты КАК СоответствиеОперацийУчетаЗарплаты
		|ГДЕ
		|	СоответствиеОперацийУчетаЗарплаты.ОперацияЗГУ В(&ОперацииЗГУ)";
	
	Запрос.УстановитьПараметр("ОперацииЗГУ", ОперацииЗГУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ВидыНалогаПоВидуОперацииЗГУНастраиваемые.Вставить(Выборка.ОперацияЗГУ, Выборка.ВидНалогаИлиПлатежа);	
	КонецЦикла;
	
	Возврат ВидыНалогаПоВидуОперацииЗГУНастраиваемые;
	
КонецФункции

// Возвращает соответствие вида налога НДФЛ видам операции по зарплате по умолчанию
//
// Возвращаемое значение:
//   Соответствие:
//            * Ключ - ПеречислениеСсылка.ВидыОперацийПоЗарплате
//            * Значение - СправочникСсылка.ВидыНалоговИПлатежей
//
Функция ВидыНалогаПоВидуОперацииЗГУ() Экспорт

	ВидыНалогаПоВидуОперацииЗГУ = Новый Соответствие;
	
	ВидыНалогаПоВидуОперацииЗГУ.Вставить(Перечисления.ВидыОперацийПоЗарплате.НДФЛ, 
		Справочники.ВидыНалоговИПлатежей.НДФЛ);
		
    Возврат ВидыНалогаПоВидуОперацииЗГУ;
	
КонецФункции


#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СведенияОбУдержанномНДФЛНДФЛ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СведенияОбУдержанномНДФЛ.НДФЛ КАК СведенияОбУдержанномНДФЛНДФЛ
	|ГДЕ
	|	СведенияОбУдержанномНДФЛНДФЛ.Счет = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.СведенияОбУдержанномНДФЛ";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			
			Если Объект = Неопределено Тогда
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьСчетИПеренестиСубконтоВТабличнойЧасти_2_0_102(Объект);
		
			Если Объект.Модифицированность() Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.СведенияОбУдержанномНДФЛ,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

Процедура ЗаполнитьСчетИПеренестиСубконтоВТабличнойЧасти_2_0_102(Объект)
	
	СчетНДФЛ      = БухгалтерскийУчет.СчетПоКоду("303.01", Объект.Дата, Объект.Организация);
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетНДФЛ);
	
	Для каждого Строка Из Объект.НДФЛ Цикл
		Если ЗначениеЗаполнено(Строка.Счет)
			Или Не ЗначениеЗаполнено(Строка.ВидНалогаИлиПлатежа) Тогда
			Продолжить;		
		КонецЕсли;
		
		Строка.Счет = СчетНДФЛ;
		
		Если СвойстваСчета.КоличествоСубконто > 0
			И СвойстваСчета.ВидСубконто1ТипЗначения.СодержитТип(Тип("СправочникСсылка.ВидыНалоговИПлатежей")) Тогда
			
			Строка.Субконто1 = Строка.ВидНалогаИлиПлатежа;
		
		КонецЕсли;
	
		Если СвойстваСчета.КоличествоСубконто > 1
			И СвойстваСчета.ВидСубконто2ТипЗначения.СодержитТип(Тип("СправочникСсылка.НалогиИПлатежиОрганизации")) Тогда
			
			Строка.Субконто2 = Строка.НалогСборПлатеж;
		
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
