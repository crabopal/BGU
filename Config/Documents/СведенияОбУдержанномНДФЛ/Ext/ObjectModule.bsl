#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

// Дополняет данные табличной части при обмене с зарплатным решением
// Заполняет следующие реквизиты: 
// ВидОперацииПоЗарплате, ИФО, КФО, КПС, Счет, Субконто1, Субконто2, Субконто3
//
Процедура ДополнитьДанныеТабличнойЧасти() Экспорт
	
	ЗаполнитьВидОперацииИВидНалога();
	ЗаполнитьОтражениеВУчетеПоСтатьеФинансирования();
	Записать();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СуммаДокумента  = НДФЛ.Итог("Сумма");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьВидОперацииИВидНалога()
	
	НастройкаСпособовОтраженияНДФЛ      = НастройкаСпособовОтраженияНДФЛ();
	ПараметрыЗаполненияСчетаПоУмолчанию = НовыеПараметрыЗаполненияСчетаПоУмолчанию();

	Для каждого СтрокаНДФЛ Из НДФЛ Цикл
		
		СтрокаНДФЛ.ВидОперацииПоЗарплате = Перечисления.ВидыОперацийПоЗарплате.НДФЛ;
		
		ЗаполнитьСтрокуНДФЛПоСпособуОтражения(СтрокаНДФЛ, НастройкаСпособовОтраженияНДФЛ);
		ЗаполнитьСтрокуНДФЛПоУмолчанию(СтрокаНДФЛ, ПараметрыЗаполненияСчетаПоУмолчанию);
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСтрокуНДФЛПоСпособуОтражения(СтрокаНДФЛ, НастройкаСпособовОтраженияНДФЛ)

	Отбор = Новый Структура("ВидОперации, КодНалоговогоОргана");
	Отбор.ВидОперации 		  = СтрокаНДФЛ.ВидОперацииПоЗарплате;
	Отбор.КодНалоговогоОргана = СтрокаНДФЛ.КодНалоговогоОргана;
	
	ПодходящиеСпособыОтражения = НастройкаСпособовОтраженияНДФЛ.НайтиСтроки(Отбор);
	Если ПодходящиеСпособыОтражения.Количество() = 0 Тогда
		Отбор.КодНалоговогоОргана = "";
		ПодходящиеСпособыОтражения = НастройкаСпособовОтраженияНДФЛ.НайтиСтроки(Отбор);
	КонецЕсли;
	
	Если ПодходящиеСпособыОтражения.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	СпособОтражения = ПодходящиеСпособыОтражения[0];
	
	Если ЗначениеЗаполнено(СтрокаНДФЛ.Счет)
		И Не СпособОтражения.НеИспользоватьВходящиеДанныеЗГУ Тогда
		    Возврат;
	КонецЕсли;
	
	СтрокаНДФЛ.Счет 	 = СпособОтражения.Счет;
	СтрокаНДФЛ.Субконто1 = СпособОтражения.Субконто1;
	СтрокаНДФЛ.Субконто2 = СпособОтражения.Субконто2;
	СтрокаНДФЛ.Субконто3 = СпособОтражения.Субконто3;

КонецПроцедуры

Процедура ЗаполнитьСтрокуНДФЛПоУмолчанию(СтрокаНДФЛ, ПараметрыЗаполнения)
	
	Если ЗначениеЗаполнено(СтрокаНДФЛ.Счет)
		И ЗначениеЗаполнено(СтрокаНДФЛ.Субконто1)
		И ЗначениеЗаполнено(СтрокаНДФЛ.Субконто2) Тогда
			Возврат;	
	КонецЕсли;
	
	Если Не ПараметрыЗаполнения.Инициализированы Тогда
		ИнициализироватьПараметрыЗаполненияСчетаПоУмолчанию(ПараметрыЗаполнения);	
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтрокаНДФЛ.Счет) Тогда
		СтрокаНДФЛ.Счет = ПараметрыЗаполнения.СчетНДФЛ;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаНДФЛ.Субконто1)
		И ПараметрыЗаполнения.ЗаполнятьСубконто1 Тогда
		СтрокаНДФЛ.Субконто1 = ПараметрыЗаполнения.ВидыНалогаПоВидуОперацииЗГУНастраиваемые[СтрокаНДФЛ.ВидОперацииПоЗарплате];
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаНДФЛ.Субконто1)
		И ПараметрыЗаполнения.ЗаполнятьСубконто1 Тогда
		СтрокаНДФЛ.Субконто1 = ПараметрыЗаполнения.ВидыНалогаПоВидуОперацииЗГУ[СтрокаНДФЛ.ВидОперацииПоЗарплате];
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаНДФЛ.Субконто2)
		И ПараметрыЗаполнения.ЗаполнятьСубконто2 Тогда
		СтрокаНДФЛ.Субконто2 = Справочники.НалогиИПлатежиОрганизации.НалогСборПлатежПоУмолчанию(Организация, СтрокаНДФЛ.Субконто1);
	КонецЕсли;

КонецПроцедуры

Функция НовыеПараметрыЗаполненияСчетаПоУмолчанию()
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Инициализированы", Ложь);
	ПараметрыЗаполнения.Вставить("ВидыНалогаПоВидуОперацииЗГУНастраиваемые");
	ПараметрыЗаполнения.Вставить("ВидыНалогаПоВидуОперацииЗГУ");
	ПараметрыЗаполнения.Вставить("СчетНДФЛ");
	ПараметрыЗаполнения.Вставить("ЗаполнятьСубконто1");
	ПараметрыЗаполнения.Вставить("ЗаполнятьСубконто2");
	
	Возврат ПараметрыЗаполнения;

КонецФункции

Процедура ИнициализироватьПараметрыЗаполненияСчетаПоУмолчанию(ПараметрыЗаполнения)

	ПараметрыЗаполнения.Инициализированы = Истина;	

	ПараметрыЗаполнения.ВидыНалогаПоВидуОперацииЗГУНастраиваемые = 
		Документы.СведенияОбУдержанномНДФЛ.ВидыНалогаПоВидуОперацииЗГУНастраиваемые();
	
	ПараметрыЗаполнения.ВидыНалогаПоВидуОперацииЗГУ = Документы.СведенияОбУдержанномНДФЛ.ВидыНалогаПоВидуОперацииЗГУ();
	
	ПараметрыЗаполнения.СчетНДФЛ  = БухгалтерскийУчет.СчетПоКоду("303.01", Дата, Организация);
	СвойстваСчета                 = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПараметрыЗаполнения.СчетНДФЛ);
	
	ПараметрыЗаполнения.ЗаполнятьСубконто1 = СвойстваСчета.КоличествоСубконто > 0  
		И СвойстваСчета.ВидСубконто1ТипЗначения.СодержитТип(Тип("СправочникСсылка.ВидыНалоговИПлатежей"));
	
	ПараметрыЗаполнения.ЗаполнятьСубконто2 = СвойстваСчета.КоличествоСубконто > 1  
		И СвойстваСчета.ВидСубконто2ТипЗначения.СодержитТип(Тип("СправочникСсылка.НалогиИПлатежиОрганизации"));
	
КонецПроцедуры

Функция НастройкаСпособовОтраженияНДФЛ()
	
	Запрос = Новый Запрос;

	ВидыОперацийНДФЛ = Новый Массив;
	ВидыОперацийНДФЛ.Добавить(Перечисления.ВидыОперацийПоЗарплате.НДФЛ);

	Запрос.УстановитьПараметр("Период", 		     НачалоМесяца(Дата));
	Запрос.УстановитьПараметр("СпособОтраженияНДФЛ", Справочники.СпособыОтраженияЗарплатыВБухУчете.НДФЛ);
	Запрос.УстановитьПараметр("Организация",         Организация);
	Запрос.УстановитьПараметр("ВидыОперацийНДФЛ",    ВидыОперацийНДФЛ);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкаСпособовОтражения.ВидОперации КАК ВидОперации,
		|	НастройкаСпособовОтражения.КодНалоговогоОргана КАК КодНалоговогоОргана,
		|	НастройкаСпособовОтражения.СчетДт КАК Счет,
		|	НастройкаСпособовОтражения.Субконто1 КАК Субконто1,
		|	НастройкаСпособовОтражения.Субконто2 КАК Субконто2,
		|	НастройкаСпособовОтражения.Субконто3 КАК Субконто3,
		|	НастройкаСпособовОтражения.НеИспользоватьВходящиеДанныеЗГУ КАК НеИспользоватьВходящиеДанныеЗГУ
		|ИЗ
		|	РегистрСведений.НастройкаСпособовОтраженияЗарплатыВБухУчете.СрезПоследних(
		|			&Период,
		|			СпособОтраженияЗарплатыВБухУчете = &СпособОтраженияНДФЛ
		|				И Организация = &Организация
		|				И ВидОперации В (&ВидыОперацийНДФЛ)) КАК НастройкаСпособовОтражения";
	
	НастройкаСпособовОтраженияНДФЛ = Запрос.Выполнить().Выгрузить();
	
	Для каждого Строка Из НастройкаСпособовОтраженияНДФЛ Цикл
		Строка.КодНалоговогоОргана = СокрЛП(Строка.КодНалоговогоОргана);
	КонецЦикла;
	
    Возврат НастройкаСпособовОтраженияНДФЛ;
	
КонецФункции

Процедура ЗаполнитьОтражениеВУчетеПоСтатьеФинансирования()

	УчетПоИФО 						= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	НастройкиСтатейФинансирования 	= НастройкиСтатейФинансирования();
	ПоляПоиска 						= "СтатьяФинансированияЗарплата,ВидОперацииПоЗарплате,КЭК";
	ОтборНастроекФинансирования 	= Новый Структура(ПоляПоиска);
	НастройкиСтатейФинансирования.Индексы.Добавить(ПоляПоиска);
	ЗаполняемыеПоляИзНастроекФинансирования = ?(УчетПоИФО, "ИФО,КФО,КПС", "КФО,КПС");

	Для каждого СтрокаНДФЛ Из НДФЛ Цикл
		ЗаполнитьЗначенияСвойств(ОтборНастроекФинансирования, СтрокаНДФЛ);
		НастройкиТекущейСтатьи = НастройкиСтатейФинансирования.Скопировать(ОтборНастроекФинансирования);
		Если НастройкиТекущейСтатьи.Количество() > 0 Тогда
			НастройкиТекущейСтатьи.Сортировать("ПриоритетВидаОперации,ПриоритетКЭК");
			ЗаполнитьЗначенияСвойств(СтрокаНДФЛ, НастройкиТекущейСтатьи[0], ЗаполняемыеПоляИзНастроекФинансирования);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция НастройкиСтатейФинансирования()

	ТаблицаДокумента = НДФЛ.Выгрузить(, "ВидОперацииПоЗарплате,СтатьяФинансированияЗарплата,КЭК");
	ТаблицаДокумента.Свернуть("ВидОперацииПоЗарплате,СтатьяФинансированияЗарплата,КЭК");
	
	ДанныеДляПодбора = ТаблицаДокумента.СкопироватьКолонки();
	ДанныеДляПодбора.Колонки.Добавить("Организация", 			Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ДанныеДляПодбора.Колонки.Добавить("ВидОперацииПодбор", 		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийПоЗарплате"));
	ДанныеДляПодбора.Колонки.Добавить("КЭКПодбор", 				Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ДанныеДляПодбора.Колонки.Добавить("ПриоритетВидаОперации", 	ОбщегоНазначения.ОписаниеТипаЧисло(1));
	ДанныеДляПодбора.Колонки.Добавить("ПриоритетКЭК", 			ОбщегоНазначения.ОписаниеТипаЧисло(1));
	
	Для каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		ДобавитьДанныеДляПодбора(ДанныеДляПодбора, СтрокаДокумента, 0, 0);
		ДобавитьДанныеДляПодбора(ДанныеДляПодбора, СтрокаДокумента, 0, 1);
		ДобавитьДанныеДляПодбора(ДанныеДляПодбора, СтрокаДокумента, 1, 0);
		ДобавитьДанныеДляПодбора(ДанныеДляПодбора, СтрокаДокумента, 1, 1);		
	КонецЦикла;
	
	ДанныеДляПодбора.ЗаполнитьЗначения(Организация, "Организация");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", 		  НачалоМесяца(Дата));
	Запрос.УстановитьПараметр("ДанныеДляПодбора", ДанныеДляПодбора);

	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеДляПодбора.СтатьяФинансированияЗарплата КАК СтатьяФинансированияЗарплата,
		|	ДанныеДляПодбора.Организация КАК Организация,
		|	ДанныеДляПодбора.ВидОперацииПоЗарплате КАК ВидОперацииПоЗарплате,
		|	ДанныеДляПодбора.ВидОперацииПодбор КАК ВидОперацииПодбор,
		|	ДанныеДляПодбора.КЭК КАК КЭК,
		|	ДанныеДляПодбора.КЭКПодбор КАК КЭКПодбор,
		|	ДанныеДляПодбора.ПриоритетВидаОперации КАК ПриоритетВидаОперации,
		|	ДанныеДляПодбора.ПриоритетКЭК КАК ПриоритетКЭК
		|ПОМЕСТИТЬ ВТДанныеДляПодбора
		|ИЗ
		|	&ДанныеДляПодбора КАК ДанныеДляПодбора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НастройкаСтатей.СтатьяФинансированияЗарплата КАК СтатьяФинансированияЗарплата,
		|	НастройкаСтатей.Организация КАК Организация,
		|	НастройкаСтатей.ВидОперации КАК ВидОперации,
		|	НастройкаСтатей.КЭК КАК КЭК,
		|	НастройкаСтатей.ИФО КАК ИФО,
		|	НастройкаСтатей.КФО КАК КФО,
		|	НастройкаСтатей.КПС КАК КПС
		|ПОМЕСТИТЬ ВТНастройкаСтатей
		|ИЗ
		|	РегистрСведений.НастройкаСтатейФинансированияЗарплата.СрезПоследних(
		|			&Период,
		|			(СтатьяФинансированияЗарплата, Организация, ВидОперации, КЭК) В
		|				(ВЫБРАТЬ
		|					ВТДанныеДляПодбора.СтатьяФинансированияЗарплата КАК СтатьяФинансированияЗарплата,
		|					ВТДанныеДляПодбора.Организация КАК Организация,
		|					ВТДанныеДляПодбора.ВидОперацииПодбор КАК ВидОперацииПодбор,
		|					ВТДанныеДляПодбора.КЭКПодбор КАК КЭКПодбор
		|				ИЗ
		|					ВТДанныеДляПодбора КАК ВТДанныеДляПодбора)) КАК НастройкаСтатей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТДанныеДляПодбора.СтатьяФинансированияЗарплата КАК СтатьяФинансированияЗарплата,
		|	ВТДанныеДляПодбора.ВидОперацииПоЗарплате КАК ВидОперацииПоЗарплате,
		|	ВТДанныеДляПодбора.КЭК КАК КЭК,
		|	ВТДанныеДляПодбора.ПриоритетВидаОперации КАК ПриоритетВидаОперации,
		|	ВТДанныеДляПодбора.ПриоритетКЭК КАК ПриоритетКЭК,
		|	ВТНастройкаСтатей.ИФО КАК ИФО,
		|	ВТНастройкаСтатей.КФО КАК КФО,
		|	ВТНастройкаСтатей.КПС КАК КПС
		|ИЗ
		|	ВТНастройкаСтатей КАК ВТНастройкаСтатей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДанныеДляПодбора КАК ВТДанныеДляПодбора
		|		ПО ВТНастройкаСтатей.СтатьяФинансированияЗарплата = ВТДанныеДляПодбора.СтатьяФинансированияЗарплата
		|			И ВТНастройкаСтатей.ВидОперации = ВТДанныеДляПодбора.ВидОперацииПодбор
		|			И ВТНастройкаСтатей.КЭК = ВТДанныеДляПодбора.КЭКПодбор";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ДобавитьДанныеДляПодбора(ДанныеДляПодбора, СтрокаДокумента, ПриоритетВидаОперации, ПриоритетКЭК)
	
	СтрокаДляПодбора = ДанныеДляПодбора.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаДляПодбора, СтрокаДокумента);
	
	СтрокаДляПодбора.ПриоритетВидаОперации 	= ПриоритетВидаОперации;
	СтрокаДляПодбора.ПриоритетКЭК 			= ПриоритетКЭК;
	
	Если ПриоритетВидаОперации = 0 Тогда
		СтрокаДляПодбора.ВидОперацииПодбор = СтрокаДляПодбора.ВидОперацииПоЗарплате;
	КонецЕсли;
	
	Если ПриоритетКЭК = 0 Тогда
		СтрокаДляПодбора.КЭКПодбор = СтрокаДляПодбора.КЭК;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецЕсли