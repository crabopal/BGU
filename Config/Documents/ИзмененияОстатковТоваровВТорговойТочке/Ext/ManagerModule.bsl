// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
//
// Параметры
//  Ссылка  - ДокументСсылка.ТаксировкаПутевогоЛиста - ссылка на текущий документ
//  ДополнительныеСвойства  - Структура - Структура данных для подсистемы печати
//
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	НомераТаблиц = Новый Структура;
	
	ИнициализироватьЗапросыПоОстаткамТоваров(Запрос, НомераТаблиц);
	
	Результат = Запрос.ВыполнитьПакет();

	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
КонецПроцедуры // ИнициализироватьДанныеДокумента()

Процедура ИнициализироватьЗапросыПоОстаткамТоваров(Запрос, НомераТаблиц)

	НомераТаблиц.Вставить("ТоварыВТорговыхТочках", НомераТаблиц.Количество()+1);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Дата КАК Период,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка КАК Регистратор,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Организация КАК Организация,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.ЦМО КАК ЦМО,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ИзмененияОстатковТоваровВТорговойТочкеТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ ДвиженияТоваров
	|ИЗ
	|	Документ.ИзмененияОстатковТоваровВТорговойТочке.Товары КАК ИзмененияОстатковТоваровВТорговойТочкеТовары
	|ГДЕ
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Номенклатура,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.ЦМО,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Организация,
	|	ИзмененияОстатковТоваровВТорговойТочкеТовары.Ссылка.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДвиженияТоваров.Регистратор.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженияНоменклатурыПрейскуранта.Поступление)
	|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	КОНЕЦ КАК ВидДвижения,
	|	ДвиженияТоваров.Период КАК Период,
	|	ДвиженияТоваров.Регистратор КАК Регистратор,
	|	ДвиженияТоваров.Организация КАК Организация,
	|	ДвиженияТоваров.ЦМО КАК ЦМО,
	|	ДвиженияТоваров.Номенклатура КАК Номенклатура,
	|	ДвиженияТоваров.Количество КАК Количество
	|ИЗ
	|	ДвиженияТоваров КАК ДвиженияТоваров";
	
КонецПроцедуры

Процедура ЗаполнитьПоДаннымУчета(ДокументОбъект) Экспорт 
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВЫБОР
	               |		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ЦМО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1
	               |		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ЦМО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто2
	               |		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.ЦМО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто3
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	               |	КОНЕЦ КАК ЦМО,
	               |	ВЫБОР
	               |		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Номенклатура
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1
	               |		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.Номенклатура
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто2
	               |		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.Номенклатура
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто3
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |	КОНЕЦ КАК Номенклатура,
	               |	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстаток) КАК Количество
	               |ПОМЕСТИТЬ ВТОстатки
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&СчетаОстатков), , Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВЫБОР
	               |		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ЦМО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1
	               |		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ЦМО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто2
	               |		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.ЦМО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто3
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Номенклатура
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1
	               |		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.Номенклатура
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто2
	               |		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.Номенклатура
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто3
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |	КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТОстатки.Номенклатура КАК Номенклатура,
	               |	ВТОстатки.Количество КАК Количество
	               |ИЗ
	               |	ВТОстатки КАК ВТОстатки
	               |ГДЕ
	               |	ВТОстатки.ЦМО = &ЦМО
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номенклатура";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период"			, ДокументОбъект.Дата);
	Запрос.УстановитьПараметр("Организация"		, ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("СчетаОстатков"	, БухгалтерскийУчет.СписокСчетов("105.00", ДокументОбъект.Дата,, ДокументОбъект.Организация));
	Запрос.УстановитьПараметр("ЦМО"				, ДокументОбъект.ЦМО);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	ДокументОбъект.Товары.Загрузить(РезультатЗапроса);

КонецПроцедуры	

