#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.ИзмененияОстатковТоваровВТорговойТочке.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

    // Движения по учету остатков
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ТоварыВТорговыхТочках");
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.АктПриемкиМ7") Тогда
		ПроверитьНеобходимостьДокументаИзмененияОстатковТоваров(ДанныеЗаполнения);
		
		ЗаполнитьПоАктуПриемкиМ7(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		ПроверитьНеобходимостьДокументаИзмененияОстатковТоваров(ДанныеЗаполнения);
		
		ЗаполнитьПоПоступлениюМЗ(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ТребованиеНакладная0315006") Тогда
		ПроверитьНеобходимостьДокументаИзмененияОстатковТоваров(ДанныеЗаполнения);
		
		ЗаполнитьПоТребованиюНакладной0315006(ДанныеЗаполнения);
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьНеобходимостьДокументаИзмененияОстатковТоваров(ДокументОснование)
	
	Если ДокументОснование.ПоступлениеТоваровНаСкладТорговойТочки Тогда
		ТекстСообщения = НСтр("ru = 'Изменения остатков товаров в торговой точке можно ввести 
		|только для документа без включенного флага ""Оформить поступление товаров в торговую точку"",  
		|который не формирует движений для поступления товаров на склад торговой точки.'");
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьПоАктуПриемкиМ7(ДанныеЗаполнения)
	
	ДокументОснование = ДанныеЗаполнения;
	ВидДвижения = Перечисления.ВидыДвиженияНоменклатурыПрейскуранта.Поступление; 
	
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, "Организация, Подразделение, ЦМО");
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыОснования, "Организация, Подразделение, ЦМО");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", ДанныеЗаполнения);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АктПриемкиМ7Материалы.Номенклатура КАК Номенклатура,
	|	АктПриемкиМ7Материалы.Количество КАК Количество
	|ИЗ
	|	Документ.АктПриемкиМ7.Материалы КАК АктПриемкиМ7Материалы
	|ГДЕ
	|	АктПриемкиМ7Материалы.Ссылка = &Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	АктПриемкиМ7Материалы.НомерСтроки";
	
	Товары.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура ЗаполнитьПоПоступлениюМЗ(ДанныеЗаполнения)
	
	ДокументОснование = ДанныеЗаполнения;
	ВидДвижения = Перечисления.ВидыДвиженияНоменклатурыПрейскуранта.Поступление; 
	
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, "Организация, Подразделение, ЦМО");
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыОснования, "Организация, Подразделение, ЦМО");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", ДанныеЗаполнения);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеМЗМатериалы.Номенклатура КАК Номенклатура,
	|	ПоступлениеМЗМатериалы.Количество КАК Количество
	|ИЗ
	|	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	|ГДЕ
	|	ПоступлениеМЗМатериалы.Ссылка = &Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПоступлениеМЗМатериалы.НомерСтроки";
	
	Товары.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура ЗаполнитьПоТребованиюНакладной0315006(ДанныеЗаполнения)
	
	ДокументОснование = ДанныеЗаполнения;
	ВидДвижения = Перечисления.ВидыДвиженияНоменклатурыПрейскуранта.Поступление; 
	
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения, "Организация, ПодразделениеПолучатель, ЦМОПолучатель");
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыОснования, "Организация");
	ЦМО = РеквизитыОснования.ЦМОПолучатель;
	Подразделение = РеквизитыОснования.ПодразделениеПолучатель;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", ДанныеЗаполнения);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТребованиеНакладная0315006Материалы.Номенклатура КАК Номенклатура,
	|	ТребованиеНакладная0315006Материалы.Количество КАК Количество
	|ИЗ
	|	Документ.ТребованиеНакладная0315006.Материалы КАК ТребованиеНакладная0315006Материалы
	|ГДЕ
	|	ТребованиеНакладная0315006Материалы.Ссылка = &Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТребованиеНакладная0315006Материалы.НомерСтроки";
	
	Товары.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

#КонецОбласти

