Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
 
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация, Группа, Дата");  
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("Организация", РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("Группа", РеквизитыДокумента.Группа);
	Запрос.УстановитьПараметр("Дата", РеквизитыДокумента.Дата);
	
	Если ДокументСсылка.ВидТабеля = 0 Тогда
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	&Организация КАК Организация,
		               |	&Группа КАК Группа,
		               |	Док.Ребенок КАК Ребенок,
		               |	Док.ДатаНевыхода КАК ДатаНевыхода,
		               |	1 КАК ФактНевыхода,
		               |	&Дата КАК Период,
		               |	Док.ВидНевыхода,
		               |	Док.Ссылка.РодительскаяПлатаДопУслуги,
		               |	Непосещения.Причина КАК ПричиныНепосещения
		               |ИЗ
		               |	Документ.ТабельУчетаПосещаемостиДетей.Невыходы КАК Док
		               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		               |			Док.Ребенок КАК Ребенок,
		               |			МАКСИМУМ(Док.ПричиныНепосещения) КАК Причина
		               |		ИЗ
		               |			Документ.ТабельУчетаПосещаемостиДетей.Невыходы КАК Док
		               |		ГДЕ
		               |			Док.Ссылка = &Ссылка
		               |			И Док.ПричиныНепосещения <> """"
		               |		СГРУППИРОВАТЬ ПО
		               |			Док.Ребенок) КАК Непосещения
		               |		ПО Док.Ребенок = Непосещения.Ребенок
		               |ГДЕ
		               |	Док.Ссылка = &Ссылка";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	&Ссылка КАК Регистратор,
		               |	&Организация КАК Организация,
		               |	&Группа КАК Группа,
		               |	Док.Ребенок КАК Ребенок,
		               |	&Дата КАК Период,
					   |	ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(Док.Ссылка.КонецПериода, ДЕНЬ), СЕКУНДА, -1) КАК ДатаНевыхода,
		               |	Док.Ссылка.РодительскаяПлатаДопУслуги,
					   |	Док.Ссылка.ВидТабеля КАК ВидТабеля,
		               |	Док.ОплНевыходы КАК ОплСводно,
		               |	Док.НеоплНевыходы КАК НеоплСводно,
		               |	Док.ПричиныНепосещения КАК ПричиныНепосещения
		               |ИЗ
		               |	Документ.ТабельУчетаПосещаемостиДетей.НевыходыСводно КАК Док
		               |ГДЕ
		               |	Док.Ссылка = &Ссылка";
	КонецЕсли;			   
	
	Результат = Запрос.Выполнить().Выгрузить();			   
				   
	ТаблицыДляДвижений.Вставить("ТабельУчетаПосещаемостиДетей", Результат);

КонецПроцедуры

Функция ДниМесяца(ПараметрыДокумента) Экспорт
	ДниМесяца = Новый Структура;
	
	Запрос = Новый Запрос;
	
	
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ПараметрыДокумента.Дата));
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(ПараметрыДокумента.Дата));
	
	Если ТипЗнч(ПараметрыДокумента.ПроизводственныйКалендарь) = Тип("СправочникСсылка.ПроизводственныеКалендари") Тогда
		Запрос.УстановитьПараметр("ПроизводственныйКалендарь",	ПараметрыДокумента.ПроизводственныйКалендарь);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДанныеПроизводственногоКалендаря.Дата,
		|	ДанныеПроизводственногоКалендаря.ВидДня
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
		|ГДЕ
		|	ДанныеПроизводственногоКалендаря.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
		|ГДЕ
		|	ДанныеПроизводственногоКалендаря.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
		|	И ДанныеПроизводственногоКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*)
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
		|ГДЕ
		|	ДанныеПроизводственногоКалендаря.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь = &ПроизводственныйКалендарь";
	ИначеЕсли ТипЗнч(ПараметрыДокумента.ПроизводственныйКалендарь) = Тип("СправочникСсылка.Календари") Тогда
		Запрос.УстановитьПараметр("ПроизводственныйКалендарь",	ПараметрыДокумента.ПроизводственныйКалендарь.ПроизводственныйКалендарь);
		Запрос.УстановитьПараметр("Календарь", ПараметрыДокумента.ПроизводственныйКалендарь);
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	График.ДатаГрафика КАК Дата,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий) КАК ВидДня
		|ИЗ
		|	РегистрСведений.КалендарныеГрафики КАК График
		|ГДЕ
		|	График.Календарь = &Календарь
		|	И График.ДатаГрафика МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И График.ДеньВключенВГрафик
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	Календарь.Дата,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Воскресенье)
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК Календарь
		|ГДЕ
		|	Календарь.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
		|	И Календарь.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И НЕ Календарь.Дата В
		|				(ВЫБРАТЬ
		|					График.ДатаГрафика
		|				ИЗ
		|					РегистрСведений.КалендарныеГрафики КАК График
		|				ГДЕ
		|					График.Календарь = &Календарь
		|					И График.ДатаГрафика МЕЖДУ &НачалоМесяца И &КонецМесяца
		|					И График.ДеньВключенВГрафик)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.КалендарныеГрафики КАК График
		|ГДЕ
		|	График.Календарь = &Календарь
		|	И График.ДатаГрафика МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И График.ДеньВключенВГрафик
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*)
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК Календарь
		|ГДЕ
		|	Календарь.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
		|	И Календарь.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	Если Результат.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДниМесяца.Вставить("ДнейВМесяце", Результат[1].Выгрузить()[1].Количество);
	ДниМесяца.Вставить("РабочихДней", Результат[1].Выгрузить()[0].Количество);
	ДниМесяца.Вставить("ВидыДней", Результат[0].Выгрузить());
	
	Возврат ДниМесяца;
КонецФункции

Процедура ОбработатьДубли(ТаблицаДетей, УчитыватьПериод = Ложь)  Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
					|	Таблица.Ребенок КАК Ребенок";
					
	Если УчитыватьПериод Тогда
		Запрос.Текст = Запрос.Текст + ",
						|Таблица.НачалоПериода КАК НачалоПериода,
						|Таблица.ОкончаниеПериода КАК ОкончаниеПериода";
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
					|ПОМЕСТИТЬ втДети
					|ИЗ
					|	&Таблица КАК Таблица;
					|
					|ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	втДети.Ребенок";
					
	Если УчитыватьПериод Тогда
		Запрос.Текст = Запрос.Текст + ",
						|втДети.НачалоПериода КАК НачалоПериода,
						|втДети.ОкончаниеПериода КАК ОкончаниеПериода";
	КонецЕсли;					
	
	Запрос.Текст = Запрос.Текст + "
					|ИЗ
					|	втДети
					|УПОРЯДОЧИТЬ ПО
					|	втДети.Ребенок.Наименование;";
	Запрос.УстановитьПараметр("Таблица", ТаблицаДетей);
	
	ТаблицаДетей = Запрос.Выполнить().Выгрузить();
КонецПроцедуры

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ТабельУчетаПосещаемостиДетей";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0504608_103н";
	КомандаПечати.Представление		= НСтр("ru = 'Табель учета посещаемости детей (ф. 0504608), ред.103н'");
	КомандаПечати.Порядок			= 1;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ТабельУчетаПосещаемостиДетей";
	КомандаПечати.Идентификатор		= "ПФ_MXL_ТабельУчетаПосещаемостиДетейСводно";
	КомандаПечати.Представление		= НСтр("ru = 'Табель учета посещаемости детей (сводно)'");
	КомандаПечати.Порядок			= 2;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ТабельУчетаПосещаемостиДетей";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0504608_52н";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Табель учета посещаемости детей (ф. 0504608), ред.52н'");
	КомандаПечати.Порядок			= 97;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ТабельУчетаПосещаемостиДетей";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0504608";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Табель учета посещаемости детей (ф. 0504608)'");
	КомандаПечати.Порядок			= 98;

	
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0504608_103н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПФ_MXL_Форма0504608_103н",
		"Табель учета посещаемости детей (ф.0504608), ред.103н",
		ПечатьТабеля(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Форма0504608_103н"));
	КонецЕсли;	
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0504608_52н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПФ_MXL_Форма0504608_52н",
		"Табель учета посещаемости детей (ф.0504608), ред.52н",
		ПечатьТабеля(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Форма0504608_52н"));
	КонецЕсли;	
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0504608") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПФ_MXL_Форма0504608",
		"Табель учета посещаемости детей (ф.0504608)",
		ПечатьТабеля(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Форма0504608"));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ТабельУчетаПосещаемостиДетейСводно") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_ТабельУчетаПосещаемостиДетейСводно",
			"Табель учета посещаемости детей (сводно)",
			ПечатьТабеляСводно(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ТабельУчетаПосещаемостиДетейСводно"));
	КонецЕсли;
		
КонецПроцедуры // Печать()

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

