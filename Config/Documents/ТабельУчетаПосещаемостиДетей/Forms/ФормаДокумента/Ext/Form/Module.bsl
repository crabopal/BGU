КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	Для К = 1 По 31 Цикл
		ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		
		Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Табель.День"+К);
		Отбор.ПравоеЗначение = "-";
		Отбор.Использование = Истина;
		
		Оформление = ЭлементОформления.Оформление.Элементы;
		ЦветФона = Оформление.Найти("ЦветФона");
		ЦветФона.Значение =	ЦветаСтиля.ДатаГрафикаИзмененнаяФон;
		ЦветФона.Использование = Истина;
		
		Шрифт = Оформление.Найти("Шрифт");
		Шрифт.Значение = Новый Шрифт(,,Истина);
		Шрифт.Использование = Истина;
		
		Поля = ЭлементОформления.Поля.Элементы.Добавить();
		Поля.Использование = Истина;
		Поля.Поле = Новый ПолеКомпоновкиДанных("ТабельДень"+К);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПересчитатьИтоги()
	Если Объект.ВидТабеля = 0 Тогда
		Таблица = РеквизитФормыВЗначение("Табель"); 
		
		ИтогОпл = 0;
		ИтогНеопл = 0;
		ИтогНеВГруппе = 0;
		
		Для Каждого Стр Из Таблица Цикл
			Для К = 1 По 31 Цикл
				Если К > Объект.КоличествоДнейВМесяце Тогда
					Продолжить;
				КонецЕсли;
				
				ИтогОпл = ИтогОпл + ?(Стр["День"+К]="Но", 1, 0);
				ИтогНеопл = ИтогНеопл + ?(Стр["День"+К]="Нн", 1, 0);
				ИтогНеВГруппе = ИтогНеВГруппе + ?(Стр["День"+К]="-", 1, 0);
			КонецЦикла;
		КонецЦикла;
		
		ВсегоПропущеноДней = ИтогОпл + ИтогНеопл;
		ПропущеноОплачиваемых = ИтогОпл;
		ВсегоДнейКОплате = Таблица.Количество() * Объект.КоличествоРабочихДней - ИтогНеопл - ИтогНеВГруппе;
		
		ВсегоЗаписейТабеля = Таблица.Количество();
	Иначе
		Таблица = РеквизитФормыВЗначение("Объект").НевыходыСводно;
		
		ИтогОпл = Таблица.Итог("ОплНевыходы");
		ИтогНеопл = Таблица.Итог("НеоплНевыходы");
		
		ВсегоПропущеноДней = ИтогОпл + ИтогНеопл;
		ПропущеноОплачиваемых = ИтогОпл;
		ВсегоДнейКОплате = Таблица.Количество() * Объект.КоличествоРабочихДней - ИтогНеопл;
		
		ВсегоЗаписейТабеля = Таблица.Количество();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборРебенкаСервер(Выбор, Элемент, ТекстСообщения, НомерСтроки)
	Таблица = ?(Объект.ВидТабеля = 0, РеквизитФормыВЗначение(Элемент), Объект.НевыходыСводно);
	
	СтрокиТЧ = Таблица.НайтиСтроки(Новый Структура("Ребенок", Выбор));
	Если СтрокиТЧ.Количество() > 0 Тогда
		СтрокаТЧ = СтрокиТЧ[0];
		
		НомерСтроки = Таблица.Индекс(СтрокаТЧ);
		
		ТекстСообщения = НСтр("ru='Выбранный ребенок ""%1"" дублирует ребенка в строке %2 табличной части!'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Выбор, (НомерСтроки+1));
		
		Возврат;
	КонецЕсли;
	
	Стр = Таблица.Добавить();
	Стр.Ребенок = Выбор;
	
	Если Объект.ВидТабеля = 0 Тогда
		ТаблицаДней = Документы.ТабельУчетаПосещаемостиДетей.ПолучитьТаблицуДнейМесяца(Объект);
		
		Если ТаблицаДней.Количество() > 0 Тогда
			СтрокаДней = ТаблицаДней[0];
			
			Для К = 1 По 31 Цикл
				Стр["День"+К] = СтрокаДней["День"+К];
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ВидТабеля = 0 Тогда
		ЗначениеВРеквизитФормы(Таблица, Элемент);
	КонецЕсли;
	
	Модифицированность = Истина;
КонецПроцедуры

