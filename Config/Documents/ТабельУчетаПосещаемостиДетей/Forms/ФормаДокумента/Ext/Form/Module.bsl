&НаКлиенте
Процедура ТабельНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	#Если ВебКлиент Тогда
	Выполнение = Ложь;
	#КонецЕсли

    ТекКолонка = Элемент.ТекущийЭлемент;
	
	Если ТекКолонка.Имя = "ТабельРебенок" Или ТекКолонка.Имя = "ТабельПричиныНепосещения" Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	
	ИндексДня = Число(ТекКолонка.Заголовок);
	
	Если Элемент.ТекущиеДанные["День"+ИндексДня] = "" Или Элемент.ТекущиеДанные["День"+ИндексДня] = "В" Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	
	ТекущийРебенок = Элемент.ТекущиеДанные.Ребенок;
	
    ЗначениеЗаполнения = ПолучитьЗначениеЗаполнения(ТекКолонка.Заголовок);
КонецПроцедуры

&НаКлиенте
Процедура ТабельПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	Если Поле.Имя = "ТабельРебенок" Или Поле.Имя = "ТабельПричиныНепосещения" Тогда
		Возврат;
	КонецЕсли;
	
	ИндексДня = Число(Поле.Заголовок);
	
	Если ВидыДней[0]["ВидДня"+ИндексДня] = ПредопределенноеЗначение("Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий") Или
		ВидыДней[0]["ВидДня"+ИндексДня] = ПредопределенноеЗначение("Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный") Тогда
		
		ДатаНевыхода = Дата(Год(Объект.НачалоПериода), Месяц(Объект.НачалоПериода), ИндексДня);
		
		Элемент.ТекущиеДанные["День"+ИндексДня] = ?(ЗначениеЗаполнения = 0, "Но", "Нн");
		
		Если МассивДней.НайтиПоЗначению(ДатаНевыхода) = Неопределено Тогда
			МассивДней.Добавить(ДатаНевыхода);
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТабельПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	Если МассивДней.Количество() > 0 И (ЗначениеЗаполнения <> -1) И ЗначениеЗаполнено(ТекущийРебенок) Тогда
		ЗаполнитьНепосещения();
	КонецЕсли;
	
	ЗначениеЗаполнения = -1;
	ТекущийРебенок = ПредопределенноеЗначение("Справочник.Дети.ПустаяСсылка");
	МассивДней.Очистить();
	
	ПересчитатьИтоги();
КонецПроцедуры

