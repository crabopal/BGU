&НаКлиенте
Процедура ТабельПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Для К = 1 По Объект.КоличествоДнейВМесяце Цикл
		Если Строка(ВидыДней[0]["ВидДня"+К]) <> "Рабочий"
		 	И Строка(ВидыДней[0]["ВидДня"+К]) <> "Предпраздничный" Тогда
			ТекущиеДанные["День"+К] = "В";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТабельПриИзменении(Элемент)
	Если Элемент.ТекущийЭлемент.Имя = "ТабельРебенок" ИЛИ Элемент.ТекущийЭлемент.Имя = "ТабельПричиныНепосещения" Тогда
		Возврат;
	Иначе
		ТекущийДень = Число(Элемент.ТекущийЭлемент.Заголовок);
		ТекущиеДанные = Элемент.ТекущиеДанные;
		
		Если ТекущиеДанные = Неопределено Тогда
			ПересчитатьИтоги();
			Возврат;
		КонецЕсли;
		
		Строки = Объект.Невыходы.НайтиСтроки(Новый Структура("Ребенок, ДатаНевыхода", ТекущиеДанные.Ребенок, Дата(Год(Объект.НачалоПериода), Месяц(Объект.НачалоПериода), ТекущийДень)));
		
		Если ТекущиеДанные["День"+ТекущийДень] = "Но" ИЛИ ТекущиеДанные["День"+ТекущийДень] = "Нн" Тогда
			Если Строки.Количество() > 0 Тогда
				Строка = Строки[0];
			Иначе
				Строка = Объект.Невыходы.Добавить();
			КонецЕсли;
			
			Строка.Ребенок = ТекущиеДанные.Ребенок;
			Строка.ДатаНевыхода = Дата(Год(Объект.НачалоПериода), Месяц(Объект.НачалоПериода), ТекущийДень);
			Строка.ВидНевыхода = ?(ТекущиеДанные["День"+ТекущийДень] = "Но", 0, 1);
		Иначе
			Если Строки.Количество() > 0 Тогда
				Объект.Невыходы.Удалить(Строки[0]);
			КонецЕсли;
		КонецЕсли;
		
		ПересчитатьИтоги();
	КонецЕсли;
КонецПроцедуры

