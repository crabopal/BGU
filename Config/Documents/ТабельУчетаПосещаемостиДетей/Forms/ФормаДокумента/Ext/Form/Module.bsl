&НаКлиенте
Процедура ОбработатьВыборРебенка(Выбор, ДопПараметры) Экспорт
	Если Выбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элемент = Неопределено;
	ДопПараметры.Свойство("Элемент", Элемент);
	
	Ребенок = Неопределено;
	
	Если ТипЗнч(Выбор) = Тип("Структура") Тогда
		Ребенок = Выбор.Ребенок;
	ИначеЕсли ТипЗнч(Выбор) = Тип("СправочникСсылка.Дети") Тогда
		Ребенок = Выбор;
	КонецЕсли;
	
	ТекстСообщения = "";
	НомерСтроки = 0;
	
	ОбработатьВыборРебенкаСервер(Ребенок, Элемент.Имя, ТекстСообщения, НомерСтроки);
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , Элемент.Имя + "[" + НомерСтроки + "].Ребенок");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьИзменениеПериода(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Действие = "";
	Элемент = Неопределено;
	СтандартнаяОбработка = Истина;
	Направление = 0;
	
	ДопПараметры.Свойство("Действие", Действие);
	ДопПараметры.Свойство("Элемент", Элемент);
	ДопПараметры.Свойство("СтандартнаяОбработка", СтандартнаяОбработка);
	
	Если Объект.ВидТабеля = 0 Тогда
		Табель.Очистить();
		Объект.Невыходы.Очистить();
	Иначе
		Объект.НевыходыСводно.Очистить();
	КонецЕсли;
	
	Если Действие = "НачалоВыбора" Тогда
		НачалоВыбораПериода(Элемент, СтандартнаяОбработка);
	ИначеЕсли Действие = "Регулирование" Тогда
		ДопПараметры.Свойство("Направление", Направление);
		РегулированиеПериода(Элемент, СтандартнаяОбработка, Направление);
	КонецЕсли;	
	
	ПересчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьОчисткуСводногоТабеля(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Объект.ВидТабеля = 1;
	Иначе
		Если Табель.Количество() = 0 Тогда
			ЗаполнитьТаблицу();
		КонецЕсли;
		Объект.НевыходыСводно.Очистить();
		УстановитьВидТабеля();
	КонецЕсли;
	
	ПересчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьИзменениеОрганизации(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Выбор = Ложь;
	ДопПараметры.Свойство("Выбор", Выбор);
	
	Если Выбор Тогда
		ОткрытьФорму("Справочник.Организации.ФормаВыбора", , Элементы.Организация);
	КонецЕсли;
	
	Если Объект.ВидТабеля = 0 Тогда
		Табель.Очистить();
		Объект.Невыходы.Очистить();
	Иначе
		Объект.НевыходыСводно.Очистить();
	КонецЕсли;
	
	ПересчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьИзменениеГруппы(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Объект.Группа = ПредЗначениеГруппа;
	Иначе	
		Выбор = Ложь;
		ДопПараметры.Свойство("Выбор", Выбор);
		
		Если Выбор Тогда
			ПараметрыФормы = Новый Структура("Владелец", Объект.Организация);
			ОткрытьФорму("Справочник.ГруппыДетскогоУчреждения.Форма.ФормаВыбора", ПараметрыФормы, Элементы.Группа);
		КонецЕсли;
		
		Если Объект.ВидТабеля = 0 Тогда
			Табель.Очистить();
			Объект.Невыходы.Очистить();
		Иначе
			Объект.НевыходыСводно.Очистить();
		КонецЕсли;
		
		ГруппаПриИзмененииСервер();
		
		ПересчитатьИтоги();
		
		ПредЗначениеГруппа = Объект.Группа;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросОбОчисткеТЧ(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ВидТабеля = 0 Тогда
		Табель.Очистить();
		Объект.Невыходы.Очистить();
		ЗаполнитьТаблицу();
	Иначе
		Объект.НевыходыСводно.Очистить();
		ЗаполнитьСводнуюТаблицу();
	КонецЕсли;
	
	ПересчитатьИтоги();
	Модифицированность = ИСТИНА;
КонецПроцедуры

&НаКлиенте
Процедура ВведенТекстПричинНепосещения(Результат, ДопПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Причины = "";
	ДопПараметры.Свойство("Причины", Причины);
	
	ТекТаблица = ?(Объект.ВидТабеля = 0, "Табель", "НевыходыСводно");
	ТекТабЧасть = ?(Объект.ВидТабеля = 0, "Невыходы", "НевыходыСводно");
	
	ТекущиеДанные = Элементы[ТекТаблица].ТекущиеДанные;
	
	Если Причины <> Результат Тогда
		
		Строки = Объект[ТекТабЧасть].НайтиСтроки(Новый Структура("Ребенок", ТекущиеДанные.Ребенок));
		
		Если Строки.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru='Нет данных о непосещениях ребенком занятий!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			Возврат;
		КонецЕсли;
		
		Для Каждого Строка Из Строки Цикл
			Строка.ПричиныНепосещения = "";
		КонецЦикла;
		
		Строки[0].ПричиныНепосещения = СокрЛП(Результат);
		
		ТекущиеДанные.ПричиныНепосещения = СокрЛП(Результат);
		
		Модифицированность = ИСТИНА;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПереключателяРодПлатаДопУслуги(Ответ, ДопПараметры) Экспорт
	ТекЗначениеПереключателя = 0;
	ДопПараметры.Свойство("ТекущееЗначениеПереключателя", ТекЗначениеПереключателя);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Табель.Очистить();
		Объект.Невыходы.Очистить();
		Объект.НевыходыСводно.Очистить();
		ТекущееЗначениеПереключателя = Объект.РодительскаяПлатаДопУслуги;
	Иначе
		Объект.РодительскаяПлатаДопУслуги = ТекЗначениеПереключателя;
	КонецЕсли;
	
	ПересчитатьИтоги();
КонецПроцедуры

#КонецОбласти

