#КонецОбласти

&НаКлиенте
Процедура ВидТабеляПриИзменении(Элемент)
	Если Объект.ВидТабеля = 0 И Объект.НевыходыСводно.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ЗапроситьОчисткуСводногоТабеля", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru='Сводный табель будет очищен. Продолжить?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	ИначеЕсли Объект.ВидТабеля = 1 И Объект.Невыходы.Количество() > 0 Тогда
		СвернутьТабель();
		УстановитьВидТабеля();
	Иначе
		УстановитьВидТабеля();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекТаблица = ?(Объект.ВидТабеля = 0, Табель, Объект.НевыходыСводно);
	
	Если ТекТаблица.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
		
		ДопПараметры = Новый Структура("Выбор", Истина);
		Оповещение = Новый ОписаниеОповещения("ЗапроситьИзменениеОрганизации", ЭтотОбъект, ДопПараметры);
		ПоказатьВопрос(Оповещение, НСтр("ru='Табель будет очищен. Продолжить?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);	
	КонецЕсли;
КонецПроцедуры

