&НаСервере
Процедура КоличествоДнейМесяца()

	КалендарныйГрафикГруппы = РасчетыПоРодительскойПлате.ПолучитьКалендарныйГрафикГруппы(Объект.Группа, Объект.НачалоПериода);
	
	График = ?(ЗначениеЗаполнено(КалендарныйГрафикГруппы), КалендарныйГрафикГруппы, Объект.ГрафикРаботы);
		
	Если График = Неопределено Тогда
		График = Справочники.ПроизводственныеКалендари.НайтиПоКоду("РФ");
	КонецЕсли;
	
	ПараметрыДокумента = Новый Структура("ПроизводственныйКалендарь, Дата", График, Объект.НачалоПериода);
	
	ДниМесяца = Документы.ТабельУчетаПосещаемостиДетей.ДниМесяца(ПараметрыДокумента);
	
	Объект.КоличествоДнейВМесяце = ДниМесяца.ДнейВМесяце;
	Объект.КоличествоРабочихДней = ДниМесяца.РабочихДней;
	
	ВидыДней.Добавить();
	
	Для К = 1 По 31 Цикл
		Если К > Объект.КоличествоДнейВМесяце Тогда
			Элементы.Табель.ПодчиненныеЭлементы["ТабельДень"+К].Видимость = ЛОЖЬ;
		Иначе
			Элементы.Табель.ПодчиненныеЭлементы["ТабельДень"+К].Видимость = ИСТИНА;
			
			ВидыДней[0]["ВидДня"+К] = ДниМесяца.ВидыДней[К-1].ВидДня;
			
			Если ВидыДней[0]["ВидДня"+К] = Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий
				 ИЛИ ВидыДней[0]["ВидДня"+К] = Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный Тогда
				Элементы["ТабельДень"+К].Доступность = ИСТИНА;
				Элементы["ТабельДень"+К].ЦветТекстаЗаголовка = ЦветаСтиля.ЦветТекстаПоля;
				Элементы["ТабельДень"+К].СписокВыбора.Очистить();
				Элементы["ТабельДень"+К].СписокВыбора.Вставить(0, "Но", "Н (опл)");
				Элементы["ТабельДень"+К].СписокВыбора.Вставить(1, "Нн", "Н (неопл)");
				Элементы["ТабельДень"+К].СписокВыбора.Вставить(2, ""  , "посещение");
				Элементы["ТабельДень"+К].ЦветТекста = ЦветаСтиля.ЦветТекстаПоля;
			Иначе
				Элементы["ТабельДень"+К].Доступность = ЛОЖЬ;
				Элементы["ТабельДень"+К].ЦветТекстаЗаголовка = ЦветаСтиля.ВидДняПроизводственногоКалендаряВоскресеньеЦвет;
				Элементы["ТабельДень"+К].СписокВыбора.Очистить();
				Элементы["ТабельДень"+К].СписокВыбора.Вставить(0, "В", "В");
				Элементы["ТабельДень"+К].ЦветТекста = ЦветаСтиля.ВидДняПроизводственногоКалендаряВоскресеньеЦвет;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеНачалаПериода(Элемент)
	
	Объект.КонецПериода = КонецМесяца(Объект.НачалоПериода);
	
	КоличествоДнейМесяца();
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьПредупреждение()
	
	Если Табель.Количество() > 0 Тогда
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании 				= ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.Группа.ОтображениеПредупрежденияПриРедактировании 						= ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.НачалоПериодаСтрокой.ОтображениеПредупрежденияПриРедактировании 		= ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.Дата.ОтображениеПредупрежденияПриРедактировании 						= ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.РодительскаяПлатаДопУслуги.ОтображениеПредупрежденияПриРедактировании	= ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.ВидТабеля.ОтображениеПредупрежденияПриРедактировании					= ОтображениеПредупрежденияПриРедактировании.Отображать;
	Иначе
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании 				= ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		Элементы.Группа.ОтображениеПредупрежденияПриРедактировании 						= ОтображениеПредупрежденияПриРедактировании.НеОтображать;	
		Элементы.НачалоПериодаСтрокой.ОтображениеПредупрежденияПриРедактировании 		= ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		Элементы.Дата.ОтображениеПредупрежденияПриРедактировании 						= ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		Элементы.РодительскаяПлатаДопУслуги.ОтображениеПредупрежденияПриРедактировании	= ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		Элементы.ВидТабеля.ОтображениеПредупрежденияПриРедактировании					= ОтображениеПредупрежденияПриРедактировании.НеОтображать;
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ГруппаПриИзмененииСервер()
	
	КалендарныйГрафикГруппы = Неопределено;
	Если ЗначениеЗаполнено(Объект.Группа) Тогда
		КалендарныйГрафикГруппы = РасчетыПоРодительскойПлате.ПолучитьКалендарныйГрафикГруппы(Объект.Группа, Объект.НачалоПериода);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(КалендарныйГрафикГруппы) Тогда
		Объект.ГрафикРаботы = КалендарныйГрафикГруппы;
	Иначе
		Объект.ГрафикРаботы = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
	КонецЕсли;
	
	КоличествоДнейМесяца();
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииСервер()
	Объект.Группа = Справочники.ГруппыДетскогоУчреждения.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.ГрафикРаботы = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
	Иначе
		Объект.ГрафикРаботы = Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСводнуюТаблицу()
	КоличествоДнейМесяца();
	
	Если Объект.РодительскаяПлатаДопУслуги = 0 Тогда
		ТаблицаДетей = РодительскаяПлата.СоставитьСписокДетейГруппыОсновнойОбразовательнойПрограммы(НачалоМесяца(Объект.НачалоПериода), 
																									КонецМесяца(Объект.КонецПериода), 
																									?(ЗначениеЗаполнено(Объект.Группа), Объект.Группа, Объект.Организация));
	Иначе
		ТаблицаДетей = РодительскаяПлата.СоставитьСписокДетейГруппыДополнительнойОбразовательнойПрограммы(НачалоМесяца(Объект.НачалоПериода), 
																									КонецМесяца(Объект.КонецПериода), 
																									?(ЗначениеЗаполнено(Объект.Группа), Объект.Группа, Объект.Организация));																								
	КонецЕсли;
																								
	Документы.ТабельУчетаПосещаемостиДетей.ОбработатьДубли(ТаблицаДетей);
	
	Объект.НевыходыСводно.Загрузить(ТаблицаДетей);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицу()
	КоличествоДнейМесяца();
	
	ТаблицаПосещений = Документы.ТабельУчетаПосещаемостиДетей.ЗаполнитьТаблицуПосещений(Объект);
	
	ЗначениеВРеквизитФормы(ТаблицаПосещений, "Табель");
КонецПроцедуры

&НаСервере
Функция ПолучитьЗначениеЗаполнения(ТекДень)
	Отбор = Новый Структура;
	Отбор.Вставить("Ребенок", ТекущийРебенок);
	Отбор.Вставить("ДатаНевыхода", Дата(Год(Объект.НачалоПериода), Месяц(Объект.НачалоПериода), Число(ТекДень)));
	
	Строки = Объект.Невыходы.НайтиСтроки(Отбор);
	
	Если Строки.Количество() > 0 Тогда
		Возврат Строки[0].ВидНевыхода;
	Иначе
		Возврат -1;
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ЗаполнитьНепосещения()
	Отбор = Новый Структура("Ребенок, ДатаНевыхода");
	Отбор.Ребенок = ТекущийРебенок;
	
	Для Каждого День Из МассивДней Цикл
		Отбор.ДатаНевыхода = День.Значение;
		
		Строки = Объект.Невыходы.НайтиСтроки(Отбор);
		
		Если Строки.Количество() > 0 Тогда
			Строка = Строки[0];
		Иначе
			Строка = Объект.Невыходы.Добавить();
			Строка.Ребенок = ТекущийРебенок;
			Строка.ДатаНевыхода = День.Значение;
		КонецЕсли;
		
		Строка.ВидНевыхода = ЗначениеЗаполнения;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПервыйРабочийДень(ИндексДня)
	Если ВидыДней[0]["ВидДня"+ИндексДня] = ПредопределенноеЗначение("Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий") Или
		ВидыДней[0]["ВидДня"+ИндексДня] = ПредопределенноеЗначение("Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный") Тогда
		
		Возврат;
	КонецЕсли;
	
	Пока ИндексДня <= Объект.КоличествоДнейВМесяце Цикл
		Если ВидыДней[0]["ВидДня"+ИндексДня] = ПредопределенноеЗначение("Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий") Или
			ВидыДней[0]["ВидДня"+ИндексДня] = ПредопределенноеЗначение("Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный") Тогда
			
			Прервать;
		Иначе
			ИндексДня = ИндексДня + 1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидТабеля()
	Если Объект.ВидТабеля = 0 Тогда
		Элементы.ГруппаТабличныеЧасти.ТекущаяСтраница = Элементы.СтраницаПоДням;
	Иначе
		Элементы.ГруппаТабличныеЧасти.ТекущаяСтраница = Элементы.СтраницаСводно;
	КонецЕсли;
	
	ПересчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКоличествоДней(Реквизит)
	ТекущиеДанные = Элементы.НевыходыСводно.ТекущиеДанные;
	НомерСтроки = Элементы.НевыходыСводно.ТекущаяСтрока;
	ИтогПоСтроке = (ТекущиеДанные.НеоплНевыходы + ТекущиеДанные.ОплНевыходы);
	
	ТекущиеДанные.СуммаНевыходов = ИтогПоСтроке;
	
	Если Объект.КоличествоРабочихДней < ИтогПоСтроке Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru='Суммарное количество непосещений (%1) превышает количество рабочих дней в месяце (%2)!'"), 
							ИтогПоСтроке, Объект.КоличествоРабочихДней);
							
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "НевыходыСводно[" + НомерСтроки + "]." + Реквизит, "Объект");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СвернутьТабель()
	ТабНевыходы = Объект.Невыходы.Выгрузить(, "Ребенок, ВидНевыхода, ПричиныНепосещения");
	
	Если Объект.РодительскаяПлатаДопУслуги = 0 Тогда
		ТаблицаДетей = РодительскаяПлата.СоставитьСписокДетейГруппыОсновнойОбразовательнойПрограммы(НачалоМесяца(Объект.НачалоПериода), 
																									КонецМесяца(Объект.КонецПериода), 
																									?(ЗначениеЗаполнено(Объект.Группа), Объект.Группа, Объект.Организация));
	Иначе
		ТаблицаДетей = РодительскаяПлата.СоставитьСписокДетейГруппыДополнительнойОбразовательнойПрограммы(НачалоМесяца(Объект.НачалоПериода), 
																									КонецМесяца(Объект.КонецПериода), 
																									?(ЗначениеЗаполнено(Объект.Группа), Объект.Группа, Объект.Организация));																								
	КонецЕсли;

	Документы.ТабельУчетаПосещаемостиДетей.ОбработатьДубли(ТаблицаДетей);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабНевыходы.Ребенок КАК Ребенок,
	               |	ТабНевыходы.ВидНевыхода КАК ВидНевыхода,
	               |	ТабНевыходы.ПричиныНепосещения КАК ПричиныНепосещения
	               |ПОМЕСТИТЬ втТабНевыходы
	               |ИЗ
	               |	&ТабНевыходы КАК ТабНевыходы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТабДетей.Ребенок КАК Ребенок
	               |ПОМЕСТИТЬ втТабДетей
	               |ИЗ
	               |	&ТабДетей КАК ТабДетей
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТабДетей.Ребенок КАК Ребенок,
	               |	Невыходы.НеоплНевыходы КАК НеоплНевыходы,
	               |	Невыходы.ОплНевыходы КАК ОплНевыходы,
	               |	Причины.ПричиныНепосещения КАК ПричиныНепосещения
	               |ИЗ
	               |	втТабДетей КАК ТабДетей
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ТабНевыходы.Ребенок КАК Ребенок,
	               |			КОЛИЧЕСТВО(*) КАК НеоплНевыходы,
	               |			0 КАК ОплНевыходы
	               |		ИЗ
	               |			втТабНевыходы КАК ТабНевыходы
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ТабНевыходы.Ребенок,
	               |			ТабНевыходы.ВидНевыхода
	               |		
	               |		ИМЕЮЩИЕ
	               |			ТабНевыходы.ВидНевыхода = 1
	               |		
	               |		ОБЪЕДИНИТЬ
	               |		
	               |		ВЫБРАТЬ
	               |			ТабНевыходы.Ребенок,
	               |			0,
	               |			КОЛИЧЕСТВО(*)
	               |		ИЗ
	               |			втТабНевыходы КАК ТабНевыходы
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ТабНевыходы.Ребенок,
	               |			ТабНевыходы.ВидНевыхода
	               |		
	               |		ИМЕЮЩИЕ
	               |			ТабНевыходы.ВидНевыхода = 0) КАК Невыходы
	               |		ПО ТабДетей.Ребенок = Невыходы.Ребенок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ТабНевыходы.Ребенок КАК Ребенок,
	               |			ТабНевыходы.ПричиныНепосещения КАК ПричиныНепосещения
	               |		ИЗ
	               |			втТабНевыходы КАК ТабНевыходы
	               |		ГДЕ
	               |			ТабНевыходы.ПричиныНепосещения <> """") КАК Причины
	               |		ПО ТабДетей.Ребенок = Причины.Ребенок
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТабДетей.Ребенок";
	Запрос.УстановитьПараметр("ТабДетей", ТаблицаДетей);
	Запрос.УстановитьПараметр("ТабНевыходы", ТабНевыходы);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Свернуть("Ребенок, ПричиныНепосещения", "ОплНевыходы, НеоплНевыходы");
	
	Объект.НевыходыСводно.Загрузить(Результат);
	Объект.НевыходыСводно.Сортировать("Ребенок");
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораПериода(Элемент, СтандартнаяОбработка)
	СтароеЗначение = Объект.НачалоПериода;
		
	РаботаСоСтудентамиКлиент.ПериодРегистрацииНачалоВыбора(ЭтаФорма, "Объект.НачалоПериода", "НачалоПериодаСтрокой", Элемент, СтандартнаяОбработка);
		
	Если Объект.НачалоПериода <> СтароеЗначение Тогда
			
		ОбработатьИзменениеНачалаПериода(Элемент);
			
	КонецЕсли; 
КонецПроцедуры

