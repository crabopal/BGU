Процедура ТабельПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	
	Форма = ?(Объект.РодительскаяПлатаДопУслуги = 0, "Справочник.Дети.Форма.ФормаВыбора", "Справочник.Дети.Форма.ФормаВыбораДопУслуги");
	
	Отбор = Новый Структура;
	Отбор.Вставить("НаДату", Объект.НачалоПериода);
	Отбор.Вставить("ГруппаДетскогоУчреждения", Объект.Группа);
	Отбор.Вставить("Организация", Объект.Организация);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Элемент", Элемент);
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьВыборРебенка", ЭтотОбъект, ДопПараметры);
	ОткрытьФорму(Форма, ПараметрыФормы, Элемент, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ТабельВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ЗначениеЯчейки = Неопределено;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ТекущиеДанные.Свойство(Прав(Поле.Имя, СтрДлина(Поле.Имя) - 6), ЗначениеЯчейки);
	
	Если ЗначениеЯчейки = "-" Тогда
		СтандартнаяОбработка = Ложь;
		
		ДеньЯчейки = Число(Прав(Поле.Имя, СтрДлина(Поле.Имя) - 10));
		МесяцЯчейки = Месяц(Объект.НачалоПериода);
		ГодЯчейки = Год(Объект.НачалоПериода);
		
		ДатаЯчейки = Дата(ГодЯчейки, МесяцЯчейки, ДеньЯчейки);
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
										НСтр("ru='По состоянию на %1 г. ребенок ""%2"" не значится в списочном составе группы ""%3""'"),
										Формат(ДатаЯчейки, "ДЛФ=D"),
										ТекущиеДанные.Ребенок,
										Объект.Группа);
										
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Поле = "Табель";
		Сообщение.Сообщить();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьТабель(Команда)
	Если Объект.КонецПериода <> КонецМесяца(Объект.НачалоПериода) Тогда
		Объект.КонецПериода = КонецМесяца(Объект.НачалоПериода);
		КоличествоДнейМесяца();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Текст = НСтр("ru = 'Не указана организация, заполнение невозможно!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, , "Организация", "Объект");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Группа) Тогда
		Текст = Нстр("ru='Не указана группа по услуге, заполнение невозможно!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст, , "Группа", "Объект");
		Возврат;
	КонецЕсли;
	
	ТекТаблица = ?(Объект.ВидТабеля = 0, Табель, Объект.НевыходыСводно);
		
	Если ТекТаблица.Количество() > 0 Тогда 
		Оповещение = Новый ОписаниеОповещения("ВопросОбОчисткеТЧ", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru='Табель будет очищен. Продолжить?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	Иначе
		Если Объект.ВидТабеля = 0 Тогда
			ЗаполнитьТаблицу();
		Иначе
			ЗаполнитьСводнуюТаблицу();
		КонецЕсли;
		
		Модифицированность = Истина;
	КонецЕсли;
	
	ПересчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ОплачиваемоеНепосещение(Команда)
	ТекущаяСтрока = Элементы.Табель.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяКолонка = Элементы.Табель.ТекущийЭлемент;
	Если ТекущаяКолонка = Неопределено Или ТекущаяКолонка.Имя = "ТабельПричиныНепосещения" Тогда
		Возврат;
	КонецЕсли;
	
	Если  ТекущаяКолонка.Имя = "ТабельРебенок" Тогда
		ТекущаяКолонка = Элементы.ТабельДень1;
	КонецЕсли;
	
	ИндексДня = Число(ТекущаяКолонка.Заголовок);
	
	ПервыйРабочийДень(ИндексДня);
	
	ТекДата = Дата(Год(Объект.НачалоПериода), Месяц(Объект.НачалоПериода), ИндексДня);
	ТекРебенок = Элементы.Табель.ТекущиеДанные.Ребенок;
	ТекНевыход = 0;
	
	Если Элементы.Табель.ТекущиеДанные["День"+ИндексДня] = "-" Тогда
		ТекущиеДанные = Элементы.Табель.ТекущиеДанные;
		
		ДеньЯчейки = 1;
		МесяцЯчейки = Месяц(Объект.НачалоПериода);
		ГодЯчейки = Год(Объект.НачалоПериода);
		
		ДатаЯчейки = Дата(ГодЯчейки, МесяцЯчейки, ДеньЯчейки);
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
										НСтр("ru='По состоянию на %1 г. ребенок ""%2"" не значится в списочном составе группы ""%3""'"),
										Формат(ДатаЯчейки, "ДЛФ=D"),
										ТекущиеДанные.Ребенок,
										Объект.Группа);
										
		Сообщение = Новый СообщениеПользователю; 
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Поле = "Табель";
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;
	
	Элементы.Табель.ТекущиеДанные["День"+ИндексДня] = "Но";
	
	Отбор = Новый Структура("Ребенок, ДатаНевыхода");
	Отбор.Ребенок = ТекРебенок;
	
	Отбор.ДатаНевыхода = ТекДата;
		
	Строки = Объект.Невыходы.НайтиСтроки(Отбор);
		
	Если Строки.Количество() > 0 Тогда
		Строка = Строки[0];
	Иначе
		Строка = Объект.Невыходы.Добавить();
		Строка.Ребенок = ТекРебенок;
		Строка.ДатаНевыхода = ТекДата;
	КонецЕсли;
		
	Строка.ВидНевыхода = ТекНевыход;
	
	Модифицированность = Истина;
	
	Если ИндексДня < Объект.КоличествоДнейВМесяце Тогда
		Элементы.Табель.ТекущийЭлемент = Элементы["ТабельДень"+(ИндексДня+1)];
	КонецЕсли;
	
	ПересчитатьИтоги();
КонецПроцедуры

