Процедура ВывестиРазделВТомЧисле(ТабДокумент, ВыборкаВТомЧисле, ВыборкаПоГруппе, ОбластьВТомЧисле,
	ОбластьВТомЧислеСтрока, ОбластьПодвал, КлючНабораПолей = "", ПрочеркиПустыхПолей = Неопределено)

	ВыборкаВТомЧисле.Сбросить();
	Если ВыборкаВТомЧисле.НайтиСледующий(ВыборкаПоГруппе.Подраздел, "Подраздел") Тогда
		ОбластьВТомЧисле.Параметры.Заполнить(ВыборкаВТомЧисле);
		ЗаполнитьОбластьСтрокаТаблицы(ОбластьВТомЧисле, ВыборкаВТомЧисле);
	Иначе
		УправлениеПечатьюБГУ.ОчиститьПараметрыОбласти(ОбластьВТомЧисле);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КлючНабораПолей) И ЗначениеЗаполнено(ПрочеркиПустыхПолей) Тогда
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьВТомЧисле, Неопределено, ПрочеркиПустыхПолей, КлючНабораПолей);
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьВТомЧисле);

	Пока ВыборкаВТомЧисле.Следующий() Цикл
		Если ВыборкаВТомЧисле.Подраздел <> ВыборкаПоГруппе.Подраздел Тогда
			Прервать;			
		КонецЕсли;
		ОбластьВТомЧислеСтрока.Параметры.Заполнить(ВыборкаВТомЧисле);
		ЗаполнитьОбластьСтрокаТаблицы(ОбластьВТомЧислеСтрока, ВыборкаВТомЧисле);
		ТабДокумент.Вывести(ОбластьВТомЧислеСтрока);
	КонецЦикла;
	
	ТабДокумент.Вывести(ОбластьПодвал);

КонецПроцедуры

Процедура ВывестиПодписьИсполнителяРаздела1(ТабДокумент, ВыборкаШапка, ОбластиМакета)
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(
		ВыборкаШапка.ОтветственныйИсполнительБухгалтерскойСлужбы, ВыборкаШапка.Дата);

	ОбластьОтветственныйИсполнитель = ОбластиМакета.ОтветственныйИсполнительРаздела1;
	ОбластьДатаПодписи = ОбластиМакета.ДатаПодписиРаздела1;
	
	ОбластьОтветственныйИсполнитель.Параметры.Заполнить(ЗначенияПараметров);
	
	ОформляющиеОбласти = Новый Массив;
	ОформляющиеОбласти.Добавить(ОбластьОтветственныйИсполнитель);
	ОформляющиеОбласти.Добавить(ОбластьДатаПодписи);
	Если Не ТабДокумент.ПроверитьВывод(ОформляющиеОбласти) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;

	ТабДокумент.Вывести(ОбластьОтветственныйИсполнитель);
	ТабДокумент.Вывести(ОбластьДатаПодписи);
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода = Неопределено,
	ДополнительныеПараметры = Неопределено) Экспорт
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("НомерСчета", ИнвентаризацияКлиентСервер.ПолучитьПолныйНомерСчета(
		Выборка.КПСКод, Выборка.КФО, Выборка.СчетКод));
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	Если ДополнительныеПараметры <> Неопределено И ЗначениеЗаполнено(ДополнительныеПараметры.ИмяНабораКолонок) Тогда
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка,
			ДополнительныеПараметры.ПрочеркиПустыхПолей, ДополнительныеПараметры.ИмяНабораКолонок);
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеДляПечати0510473(МассивОбъектов)
	
	НомераТаблиц = Новый Структура;
	ТекстЗапроса = ТекстЗапросаПечать0510473(НомераТаблиц); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = ТекстЗапроса;
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	ДанныеДляПечати = Новый Структура;
	ДанныеДляПечати.Вставить("СоставКомиссий", ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов));
	ДанныеДляПечати.Вставить("СведенияУчреждений", 
		УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов));

	ДанныеДляПечати.Вставить("Выборки", Новый Структура);

	Выборки = ДанныеДляПечати.Выборки;
	Выборки.Вставить("Шапка", РезультатЗапроса[НомераТаблиц.Шапка].Выбрать());

	Выборки.Вставить("Раздел1", РезультатЗапроса[НомераТаблиц.Раздел1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Выборки.Вставить("Раздел1ВТомЧисле", РезультатЗапроса[НомераТаблиц.Раздел1ВТомЧисле].Выбрать(
		ОбходРезультатаЗапроса.ПоГруппировкам));
	Выборки.Вставить("Раздел2", РезультатЗапроса[НомераТаблиц.Раздел2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Выборки.Вставить("Раздел2ВТомЧисле", РезультатЗапроса[НомераТаблиц.Раздел2ВТомЧисле].Выбрать(
		ОбходРезультатаЗапроса.ПоГруппировкам));
	Выборки.Вставить("Раздел31", РезультатЗапроса[НомераТаблиц.Раздел31].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Выборки.Вставить("Раздел31ВТомЧисле", РезультатЗапроса[НомераТаблиц.Раздел31ВТомЧисле].Выбрать(
		ОбходРезультатаЗапроса.ПоГруппировкам));
	Выборки.Вставить("Раздел32", РезультатЗапроса[НомераТаблиц.Раздел32].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Выборки.Вставить("Раздел32ВТомЧисле", РезультатЗапроса[НомераТаблиц.Раздел32ВТомЧисле].Выбрать(
		ОбходРезультатаЗапроса.ПоГруппировкам));
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция ТекстЗапросаПечать0510473(НомераТаблиц)
	
	НомераТаблиц.Вставить("ВТКредиторы", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВТПодразделы", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Шапка", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Раздел1", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Раздел1ВТомЧисле", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Раздел2", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Раздел2ВТомЧисле", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Раздел31", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Раздел31ВТомЧисле", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Раздел32", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Раздел32ВТомЧисле", НомераТаблиц.Количество());
	
	Возврат	
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА Контрагенты.НаименованиеСокращенное <> """"
		|			ТОГДА Контрагенты.НаименованиеСокращенное
		|		КОГДА ЕСТЬNULL(ЮридическиеЛица.НаименованиеПолное, """") <> """"
		|			ТОГДА ВЫРАЗИТЬ(ЮридическиеЛица.НаименованиеПолное КАК СТРОКА(1000))
		|		ИНАЧЕ Контрагенты.Наименование
		|	КОНЕЦ КАК НаименованиеКредитора
		|ПОМЕСТИТЬ ВТКредиторы
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК ЮридическиеЛица
		|		ПО Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
		|		И Контрагенты.ЮридическоеФизическоеЛицо = ЮридическиеЛица.Ссылка
		|ГДЕ
		|	Контрагенты.Ссылка В
		|		(ВЫБРАТЬ
		|			Раздел1.Контрагент
		|		ИЗ
		|			Документ.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.Раздел1 КАК Раздел1
		|		ГДЕ
		|			Раздел1.Ссылка В (&МассивОбъектов)
		|
		|		ОБЪЕДИНИТЬ ВСЕ
		|
		|		ВЫБРАТЬ
		|			Раздел2.Контрагент
		|		ИЗ
		|			Документ.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.Раздел2 КАК Раздел2
		|		ГДЕ
		|			Раздел2.Ссылка В (&МассивОбъектов)
		|
		|		ОБЪЕДИНИТЬ ВСЕ
		|
		|		ВЫБРАТЬ
		|			Раздел1.ГруппаКредиторов
		|		ИЗ
		|			Документ.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.Раздел1 КАК Раздел1
		|		ГДЕ
		|			Раздел1.Ссылка В (&МассивОбъектов)
		|
		|		ОБЪЕДИНИТЬ ВСЕ
		|
		|		ВЫБРАТЬ
		|			Раздел2.ГруппаКредиторов
		|		ИЗ
		|			Документ.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.Раздел2 КАК Раздел2
		|		ГДЕ
		|			Раздел2.Ссылка В (&МассивОбъектов))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Раздел1.Ссылка КАК Ссылка,
		|	Раздел1.Подраздел КАК Подраздел,
		|	ЕСТЬNULL(ВТКредиторы.НаименованиеКредитора, """") КАК НаименованиеГруппыКредиторов,
		|	НЕ Раздел2.Подраздел ЕСТЬ NULL КАК ЕстьВРазделе2
		|ПОМЕСТИТЬ ВТПодразделы
		|ИЗ
		|	Документ.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.Раздел1 КАК Раздел1
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.Раздел2 КАК Раздел2
		|		ПО Раздел1.Ссылка = Раздел2.Ссылка
		|		И Раздел1.Подраздел = Раздел2.Подраздел
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКредиторы КАК ВТКредиторы
		|		ПО Раздел1.ГруппаКредиторов = ВТКредиторы.Ссылка
		|ГДЕ
		|	Раздел1.Ссылка В (&МассивОбъектов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Шапка.Ссылка КАК Ссылка,
		|	Шапка.Номер КАК Номер,
		|	Шапка.Дата КАК Дата,
		|	Шапка.Организация КАК Организация,
		|	Шапка.Подразделение КАК Подразделение,
		|	Шапка.ДатаНачала КАК ДатаНачала,
		|	Шапка.ДатаОкончания КАК ДатаОкончания,
