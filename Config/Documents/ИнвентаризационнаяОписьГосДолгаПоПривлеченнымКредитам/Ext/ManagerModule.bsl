		|	ЕСТЬNULL(Раздел2.КПС.Код, ""00000000000000000"") КАК КПСКод,
		|	Раздел2.КодСрокаКредита КАК КодСрокаКредита,
		|	Раздел2.Валюта.Код КАК ВалютаКод,
		|	Раздел2.СуммаДолгаВал КАК СуммаДолгаВал,
		|	Раздел2.СуммаДолгаРуб КАК СуммаДолгаРуб,
		|	Раздел2.НачисленныеПроцентыВал КАК НачисленныеПроцентыВал,
		|	Раздел2.НачисленныеПроцентыРуб КАК НачисленныеПроцентыРуб,
		|	Раздел2.СуммаДолгаВал + Раздел2.НачисленныеПроцентыВал КАК СуммаИтогоВал,
