#Область Печать

Функция СформироватьПечатнуюФорму0510473(МассивОбъектов, ОбъектыПечати)

	КлючПараметровПечати = "ПечатьФормы0510473";
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ДанныеДляПечати = ДанныеДляПечати0510473(МассивОбъектов);
	ОбластиМакета = ОбластиМакета0510473();
	
	ВыборкаШапка = ДанныеДляПечати.Выборки.Шапка;

	Пока ВыборкаШапка.Следующий() Цикл
			
		Если ТабДокумент.ВысотаТаблицы > 0 Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НомерПервойСтроки = ТабДокумент.ВысотаТаблицы + 1;
	
		// ЗАГОЛОВОК
		
		ЗначенияПараметров = Новый Структура;
		
		УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, ВыборкаШапка.Ссылка, 
			ДанныеДляПечати.СведенияУчреждений);
		
		НомерДокументаДляПечати = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаШапка.Ссылка, 
			ВыборкаШапка.Номер);
			
		НомерРешенияОПроведенииИнвентаризации = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаШапка.РешениеОПроведенииИнвентаризации,
			ВыборкаШапка.НомерРешенияОПроведенииИнвентаризации);
		
		ЗначенияПараметров.Вставить("Дата",	ВыборкаШапка.Дата);
		ЗначенияПараметров.Вставить("Номер", НомерДокументаДляПечати);
		ЗначенияПараметров.Вставить("НомерРешения", НомерРешенияОПроведенииИнвентаризации);
		ЗначенияПараметров.Вставить("ДатаРешения", ВыборкаШапка.ДатаРешенияОПроведенииИнвентаризации);
		ЗначенияПараметров.Вставить("НомерКомиссии", ИнвентаризацияКлиентСервер.ФорматироватьПолныйНомерКомиссии(
			ВыборкаШапка.НомерКомиссии, ВыборкаШапка.НомерРабочейКомиссии, Истина));
		
		Область = ОбластиМакета.Заголовок;
		Область.Параметры.Заполнить(ВыборкаШапка);
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(ВыборкаШапка.Дата, Истина));
		
		ТабДокумент.Вывести(Область);
		
		// РАЗДЕЛЫ ОПИСИ
		
		ВывестиРазделы(ТабДокумент, ДанныеДляПечати, ВыборкаШапка, ОбластиМакета);
		
		// КОМИССИЯ
		
		ПараметрыВывода = УправлениеПечатьюБГУ.ПараметрыВыводаСоставаКомиссииПриПечати();
		ПараметрыВывода.ЗаголовокПредседателя = НСтр("ru='Председатель комиссии'");
		ПараметрыВывода.ЗаголовокПервогоРядовогоЧлена = НСтр("ru='Члены комиссии:'");
		ПараметрыВывода.ПризнакРабочейКомиссии = ЗначениеЗаполнено(ВыборкаШапка.НомерРабочейКомиссии);
		ПараметрыВывода.ВыводитьДополнительныеСведения = Истина;
		ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьПричинуОтсутствия = Истина;
		ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьЗамещающегоСотрудника = Истина;
		
		УправлениеПечатьюБГУ.ВывестиСоставКомиссииПриПечати(ТабДокумент, ВыборкаШапка.Ссылка, 
			ОбластиМакета.ЧленКомиссии, ДанныеДляПечати.СоставКомиссий, ПараметрыВывода);
		
		ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(
			ВыборкаШапка.ОтветственныйИсполнитель, ВыборкаШапка.Дата);
		
		Область = ОбластиМакета.ОтветственныйИсполнитель;
		Область.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(Область);

		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерПервойСтроки, ОбъектыПечати, 
			ВыборкаШапка.Ссылка);
			
	КонецЦикла;
	
	// Колонтитулы
	ТабДокумент.ВерхнийКолонтитул.Выводить = Истина;
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница	= 2;
	ТабДокумент.ВерхнийКолонтитул.ТекстСправа = НСтр("ru='Форма 0510473 с.[&НомерСтраницы]'");
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиРазделы(ТабДокумент, ДанныеДляПечати, ВыборкаШапка, ОбластиМакета)
	
	ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
	
	ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Истина;
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;

	ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = 
		"Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ЗаполнитьОбластьСтрокаТаблицы";
	
	ПрочеркиПустыхПолей = ПолучитьНастройкиПрочерковПустыхПолей();
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ПрочеркиПустыхПолей", ПрочеркиПустыхПолей);
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ИмяНабораКолонок", "");
	
	ДанныеПечатиГруппаКредиторов = Новый Структура;
	ДанныеПечатиГруппаКредиторов.Вставить("ЗаголовокПодраздела");
	ДанныеПечатиГруппаКредиторов.Вставить("НаименованиеГруппыКредиторов");
	
	// РАЗДЕЛ 1

	ТабДокумент.Вывести(ОбластиМакета.Раздел1Заголовок);
	
	ВыборкаРаздел1 = ДанныеДляПечати.Выборки.Раздел1;
	ВыборкаРаздел1.Сбросить();
	ВыборкаРаздел1.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка");

	ВыборкаРаздел1ВТомЧисле = ДанныеДляПечати.Выборки.Раздел1ВТомЧисле;
	ВыборкаРаздел1ВТомЧисле.Сбросить();
	ВыборкаРаздел1ВТомЧисле.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка");
	
	ВыборкаВТомЧисле = ВыборкаРаздел1ВТомЧисле.Выбрать();

	ПараметрыВыводаТаблицы.Области.Заголовок = ОбластиМакета.Раздел1ГруппаКредиторов;
	ПараметрыВыводаТаблицы.Области.ШапкаТаблицы = ОбластиМакета.Раздел1Шапка;
	ПараметрыВыводаТаблицы.Области.СтрокаТаблицы = ОбластиМакета.Раздел1Строка;
	ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами = ОбластиМакета.Раздел1Итого;
	
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.ИмяНабораКолонок = "Раздел1";
	
	ВыборкаРаздел1ПоГруппе = ВыборкаРаздел1.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРаздел1ПоГруппе.Следующий() Цикл
		
		ДанныеПечатиГруппаКредиторов.ЗаголовокПодраздела = ЗаголовокПодразделаПоГруппеКредиторов("1",
			ВыборкаРаздел1ПоГруппе.Подраздел); 
		ДанныеПечатиГруппаКредиторов.НаименованиеГруппыКредиторов = ВыборкаРаздел1ПоГруппе.НаименованиеГруппыКредиторов; 
		ПараметрыВыводаТаблицы.Области.Заголовок.Параметры.Заполнить(ДанныеПечатиГруппаКредиторов);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ПараметрыВыводаТаблицы.Области.Заголовок, Неопределено,
			ПрочеркиПустыхПолей, "Раздел1_ЗаголовокПодраздела");
		
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ВыборкаРаздел1ПоГруппе;
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = ВыборкаРаздел1ПоГруппе.Выбрать();
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ВывестиРазделВТомЧисле(ТабДокумент,
		 	ВыборкаВТомЧисле, 
		 	ВыборкаРаздел1ПоГруппе,
			ОбластиМакета.Раздел1ВТомЧисле, 
			ОбластиМакета.Раздел1ВТомЧислеСтрока, 
			ОбластиМакета.Раздел1Подвал,
			"Раздел1_ВТомЧисле", ПрочеркиПустыхПолей);
		
	КонецЦикла;
	
	Если ВыборкаРаздел1ПоГруппе.Количество() = 0 Тогда
		ВывестиПустуюТаблицуРаздела1(ТабДокумент, ОбластиМакета, ПрочеркиПустыхПолей);
	КонецЕсли;

	ВывестиПодписьИсполнителяРаздела1(ТабДокумент, ВыборкаШапка, ОбластиМакета);
	
	// РАЗДЕЛ 2

	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	ТабДокумент.Вывести(ОбластиМакета.Раздел2Заголовок);
	
	ВыборкаРаздел2 = ДанныеДляПечати.Выборки.Раздел2;
	ВыборкаРаздел2.Сбросить();
	ВыборкаРаздел2.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка");

	ВыборкаРаздел2ВТомЧисле = ДанныеДляПечати.Выборки.Раздел2ВТомЧисле;
	ВыборкаРаздел2ВТомЧисле.Сбросить();
	ВыборкаРаздел2ВТомЧисле.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка");
	
	ВыборкаВТомЧисле = ВыборкаРаздел2ВТомЧисле.Выбрать();
	
	ВыборкаРаздел2ПоГруппе = ВыборкаРаздел2.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРаздел2ПоГруппе.Следующий() Цикл
		
		Если ВыборкаРаздел2ПоГруппе.ПустойПодраздел Тогда
			ВывестиПустуюТаблицуРаздела2(ТабДокумент, ОбластиМакета, ВыборкаРаздел2ПоГруппе.Подраздел,
				ВыборкаРаздел2ПоГруппе.НаименованиеГруппыКредиторов, ПрочеркиПустыхПолей);
			Продолжить;
		КонецЕсли;

		// РАЗДЕЛ 2 Таблица 1
		
		ПараметрыВыводаТаблицы.Области.Заголовок = ОбластиМакета.Раздел2ГруппаКредиторов;
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы = ОбластиМакета.Раздел2Шапка;
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы = ОбластиМакета.Раздел2Строка;
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами = ОбластиМакета.Раздел2Итого;

		ДанныеПечатиГруппаКредиторов.ЗаголовокПодраздела = ЗаголовокПодразделаПоГруппеКредиторов("2",
			ВыборкаРаздел2ПоГруппе.Подраздел); 
		ДанныеПечатиГруппаКредиторов.НаименованиеГруппыКредиторов = ВыборкаРаздел2ПоГруппе.НаименованиеГруппыКредиторов; 
		ПараметрыВыводаТаблицы.Области.Заголовок.Параметры.Заполнить(ДанныеПечатиГруппаКредиторов);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ПараметрыВыводаТаблицы.Области.Заголовок, Неопределено,
			ПрочеркиПустыхПолей, "Раздел2_ЗаголовокПодраздела");
		
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ВыборкаРаздел2ПоГруппе;
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = ВыборкаРаздел2ПоГруппе.Выбрать();
		
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.ИмяНабораКолонок = "Раздел2_НаборКолонок1";
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ВывестиРазделВТомЧисле(ТабДокумент,
		 	ВыборкаВТомЧисле, 
		 	ВыборкаРаздел2ПоГруппе,
			ОбластиМакета.Раздел2ВТомЧисле, 
			ОбластиМакета.Раздел2ВТомЧислеСтрока, 
			ОбластиМакета.Раздел2Подвал,
			"Раздел2_НаборКолонок1_ВТомЧисле", ПрочеркиПустыхПолей);
	
		// РАЗДЕЛ 2 Таблица 2
		
		ПараметрыВыводаТаблицы.Области.Заголовок = Неопределено;
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы = ОбластиМакета.Раздел2Шапка2;
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы = ОбластиМакета.Раздел2Строка2;
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами = ОбластиМакета.Раздел2Итого2;
	
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи.Сбросить();
		
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.ИмяНабораКолонок = "Раздел2_НаборКолонок2";
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ВывестиРазделВТомЧисле(ТабДокумент,
		 	ВыборкаВТомЧисле, 
		 	ВыборкаРаздел2ПоГруппе,
			ОбластиМакета.Раздел2ВТомЧисле2, 
			ОбластиМакета.Раздел2ВТомЧислеСтрока2, 
			ОбластиМакета.Раздел2Подвал2,
			"Раздел2_НаборКолонок2_ВТомЧисле", ПрочеркиПустыхПолей);
			
		// РАЗДЕЛ 2 Таблица 3
	
		ПараметрыВыводаТаблицы.Области.Заголовок = Неопределено;
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы = ОбластиМакета.Раздел2Шапка3;
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы = ОбластиМакета.Раздел2Строка3;
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами = ОбластиМакета.Раздел2Итого3;
	
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи.Сбросить();
		
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.ИмяНабораКолонок = "";
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ВывестиРазделВТомЧисле(ТабДокумент,
		 	ВыборкаВТомЧисле, 
		 	ВыборкаРаздел2ПоГруппе,
			ОбластиМакета.Раздел2ВТомЧисле3, 
			ОбластиМакета.Раздел2ВТомЧислеСтрока3, 
			ОбластиМакета.Раздел2Подвал3,
			"Раздел2_НаборКолонок3_ВТомЧисле", ПрочеркиПустыхПолей);
			
	КонецЦикла;
	
	Если ВыборкаРаздел2ПоГруппе.Количество() = 0 Тогда
		ВывестиПустуюТаблицуРаздела2(ТабДокумент, ОбластиМакета,,, ПрочеркиПустыхПолей);
	КонецЕсли;

	// РАЗДЕЛ 3
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	ТабДокумент.Вывести(ОбластиМакета.Раздел3Заголовок);
	
	// РАЗДЕЛ 3.1

	ТабДокумент.Вывести(ОбластиМакета.Раздел31Заголовок);
	
	ВыборкаРаздел31 = ДанныеДляПечати.Выборки.Раздел31;
	ВыборкаРаздел31.Сбросить();
	ВыборкаРаздел31.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка");
	
	ВыборкаРаздел31ВТомЧисле = ДанныеДляПечати.Выборки.Раздел31ВТомЧисле;
	ВыборкаРаздел31ВТомЧисле.Сбросить();
	ВыборкаРаздел31ВТомЧисле.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка");

	ВыборкаВТомЧисле = ВыборкаРаздел31ВТомЧисле.Выбрать();
	
	ВыборкаРаздел31ПоГруппе = ВыборкаРаздел31.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРаздел31ПоГруппе.Следующий() Цикл

		// РАЗДЕЛ 3.1 Таблица 1
	
		ПараметрыВыводаТаблицы.Области.Заголовок = ОбластиМакета.Раздел31ГруппаКредиторов;
