		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы = ?(ВыборкаРаздел31ПоГруппе.ВыявленыОтклонения,
			ОбластиМакета.Раздел31Строка,
			ОбластиМакета.Раздел31СтрокаНетОтклонений);
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами = ОбластиМакета.Раздел31Итого;

		ДанныеПечатиГруппаКредиторов.ЗаголовокПодраздела = ЗаголовокПодразделаПоГруппеКредиторов("3.1",
			ВыборкаРаздел31ПоГруппе.Подраздел); 
		ДанныеПечатиГруппаКредиторов.НаименованиеГруппыКредиторов = 
			ВыборкаРаздел31ПоГруппе.НаименованиеГруппыКредиторов; 
		ПараметрыВыводаТаблицы.Области.Заголовок.Параметры.Заполнить(ДанныеПечатиГруппаКредиторов);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ПараметрыВыводаТаблицы.Области.Заголовок, Неопределено,
			ПрочеркиПустыхПолей, "Раздел31_ЗаголовокПодраздела");
	
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ВыборкаРаздел31ПоГруппе;
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = ВыборкаРаздел31ПоГруппе.Выбрать();
		
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.ИмяНабораКолонок = "Раздел31_НаборКолонок1";
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ВывестиРазделВТомЧисле(ТабДокумент,
		 	ВыборкаВТомЧисле, 
		 	ВыборкаРаздел31ПоГруппе,
			ОбластиМакета.Раздел31ВТомЧисле, 
			ОбластиМакета.Раздел31ВТомЧислеСтрока, 
			ОбластиМакета.Раздел31Подвал,
			"Раздел31_НаборКолонок1_ВТомЧисле", ПрочеркиПустыхПолей);
		
		// РАЗДЕЛ 3.1 Таблица 2
	
		ПараметрыВыводаТаблицы.Области.Заголовок = Неопределено;
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы = ОбластиМакета.Раздел31Шапка2;
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы = ?(ВыборкаРаздел31ПоГруппе.ВыявленыОтклонения,
			ОбластиМакета.Раздел31Строка2,
			ОбластиМакета.Раздел31СтрокаНетОтклонений2);
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами = ОбластиМакета.Раздел31Итого2;
	
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи.Сбросить();
		
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.ИмяНабораКолонок = "Раздел31_НаборКолонок2";
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
