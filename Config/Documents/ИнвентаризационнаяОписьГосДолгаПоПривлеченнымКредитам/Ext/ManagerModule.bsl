	ВыборкаРаздел32.Сбросить();
	ВыборкаРаздел32.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка");
	
	ВыборкаРаздел32ВТомЧисле = ДанныеДляПечати.Выборки.Раздел32ВТомЧисле;
	ВыборкаРаздел32ВТомЧисле.Сбросить();
	ВыборкаРаздел32ВТомЧисле.НайтиСледующий(ВыборкаШапка.Ссылка, "Ссылка");
	
	ВыборкаВТомЧисле = ВыборкаРаздел32ВТомЧисле.Выбрать();
	
	ВыборкаРаздел32ПоГруппе = ВыборкаРаздел32.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРаздел32ПоГруппе.Следующий() Цикл
	
		// РАЗДЕЛ 3.2 Таблица 1
	
		ПараметрыВыводаТаблицы.Области.Заголовок = ОбластиМакета.Раздел32ГруппаКредиторов;
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы = ОбластиМакета.Раздел32Шапка;
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы = 
			?(ВыборкаРаздел32ПоГруппе.ВыявленаНеСогласованнаяЗадолженность
			Или ВыборкаРаздел32ПоГруппе.ВыявленаПросроченнаяЗадолженность,
			ОбластиМакета.Раздел32Строка,
			ОбластиМакета.Раздел32СтрокаНетОтклонений);
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами = ОбластиМакета.Раздел32Итого;

		ДанныеПечатиГруппаКредиторов.ЗаголовокПодраздела = ЗаголовокПодразделаПоГруппеКредиторов("3.2",
			ВыборкаРаздел32ПоГруппе.Подраздел); 
		ДанныеПечатиГруппаКредиторов.НаименованиеГруппыКредиторов = 
			ВыборкаРаздел32ПоГруппе.НаименованиеГруппыКредиторов; 
		ПараметрыВыводаТаблицы.Области.Заголовок.Параметры.Заполнить(ДанныеПечатиГруппаКредиторов);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ПараметрыВыводаТаблицы.Области.Заголовок, Неопределено,
			ПрочеркиПустыхПолей, "Раздел32_ЗаголовокПодраздела");
		
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ВыборкаРаздел32ПоГруппе;
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = ВыборкаРаздел32ПоГруппе.Выбрать();
		
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.ИмяНабораКолонок = "Раздел32_НаборКолонок1";
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ВывестиРазделВТомЧисле(ТабДокумент,
		 	ВыборкаВТомЧисле, 
		 	ВыборкаРаздел32ПоГруппе,
			ОбластиМакета.Раздел32ВТомЧисле, 
			ОбластиМакета.Раздел32ВТомЧислеСтрока, 
			ОбластиМакета.Раздел32Подвал,
			"Раздел32_НаборКолонок1_ВТомЧисле", ПрочеркиПустыхПолей);
		
		// РАЗДЕЛ 3.2 Таблица 2
		
		ПараметрыВыводаТаблицы.Области.Заголовок = Неопределено;
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы = ОбластиМакета.Раздел32Шапка2;
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы = 
			?(ВыборкаРаздел32ПоГруппе.ВыявленаНеСогласованнаяЗадолженность
			Или ВыборкаРаздел32ПоГруппе.ВыявленаПросроченнаяЗадолженность,
			ОбластиМакета.Раздел32Строка2,
			ОбластиМакета.Раздел32СтрокаНетОтклонений2);
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами = ОбластиМакета.Раздел32Итого2;
		
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи.Сбросить();
		
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.ИмяНабораКолонок = "Раздел32_НаборКолонок2";
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ВывестиРазделВТомЧисле(ТабДокумент,
		 	ВыборкаВТомЧисле, 
		 	ВыборкаРаздел32ПоГруппе,
			ОбластиМакета.Раздел32ВТомЧисле2, 
			ОбластиМакета.Раздел32ВТомЧислеСтрока2, 
			ОбластиМакета.Раздел32Подвал2,
			"Раздел32_НаборКолонок2_ВТомЧисле", ПрочеркиПустыхПолей);

	КонецЦикла;
	
	Если ВыборкаРаздел32ПоГруппе.Количество() = 0 Тогда
		ВывестиПустуюТаблицуРаздела32(ТабДокумент, ОбластиМакета, ПрочеркиПустыхПолей);
	КонецЕсли;
	 
КонецПроцедуры

Процедура ВывестиПустуюТаблицуРаздела1(ТабДокумент, ОбластиМакета, ПрочеркиПустыхПолей)
	
	ВыводимыеОбласти = Новый Массив;
	ВыводимыеОбласти.Добавить(ОбластиМакета.Раздел1ГруппаКредиторов);
	ВыводимыеОбласти.Добавить(ОбластиМакета.Раздел1Шапка);
	ВыводимыеОбласти.Добавить(ОбластиМакета.Раздел1Итого);
	ВыводимыеОбласти.Добавить(ОбластиМакета.Раздел1ВТомЧисле);
	ВыводимыеОбласти.Добавить(ОбластиМакета.Раздел1Подвал);
	
	ПерваяСтрока = Истина;
	Для Каждого Область Из ВыводимыеОбласти Цикл
		
		УправлениеПечатьюБГУ.ОчиститьПараметрыОбласти(Область);
		
		Если ПерваяСтрока Тогда
			Область.Параметры.Заполнить(Новый Структура("ЗаголовокПодраздела",
				ЗаголовокПодразделаПоГруппеКредиторов("1", 1)));
			ПерваяСтрока = Ложь;
		КонецЕсли;
		
		Если Область = ОбластиМакета.Раздел1ГруппаКредиторов Тогда
			КлючНабораПолей = "Раздел1_ЗаголовокПодраздела";
			
		ИначеЕсли Область = ОбластиМакета.Раздел1Итого Тогда
			КлючНабораПолей = "Раздел1_Итого";
			
		ИначеЕсли Область = ОбластиМакета.Раздел1ВТомЧисле Тогда
			КлючНабораПолей = "Раздел1_ВТомЧисле";
		Иначе
