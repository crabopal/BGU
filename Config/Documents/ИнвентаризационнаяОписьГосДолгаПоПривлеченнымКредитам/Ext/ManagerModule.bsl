#Область ПрограммныйИнтерфейс

Процедура ПроверитьПередЗаполнениемРаздела1(Знач ДокументОбъект, Отказ) Экспорт
	
	Отказ = Ложь;
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, Отказ);

КонецПроцедуры

// Заполняет список команд печати.
// 
// Параметры:
//  КомандыПечати - см. УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0510473";
	КомандаПечати.Представление = НСтр(
		"ru='Инвентаризационная опись состояния государственного (муниципального) долга по привлеченным кредитам (ф. 0510473)'");
	КомандаПечати.Порядок = 1;
	
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов - см. УправлениеПечатьюПереопределяемый.ПриПечати.МассивОбъектов
//  ПараметрыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыПечати
//  КоллекцияПечатныхФорм - см. УправлениеПечатьюПереопределяемый.ПриПечати.КоллекцияПечатныхФорм
//  ОбъектыПечати - см. УправлениеПечатьюПереопределяемый.ПриПечати.ОбъектыПечати
//  ПараметрыВывода - см. УправлениеПечатьюПереопределяемый.ПриПечати.ПараметрыВывода
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	// печать формы 0510473

	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "Форма0510473");
	Если ПечатнаяФорма <> Неопределено Тогда
		
		// ИндикаторКворумаПрисутствия
		ИндикаторКворумаПрисутствия.ПроверитьДостижениеКворумаПрисутствияПриПечати(МассивОбъектов);
		// Конец ИндикаторКворумаПрисутствия

		ПечатнаяФорма.ТабличныйДокумент = СформироватьПечатнуюФорму0510473(МассивОбъектов, ОбъектыПечати);
		ПечатнаяФорма.СинонимМакета = НСтр(
			"ru = 'Инвентаризационная опись состояния государственного (муниципального) долга по привлеченным кредитам (ф. 0510473)'");
		ПечатнаяФорма.ПолныйПутьКМакету = "Документ.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ПФ_MXL_Ф0510473";

	КонецЕсли;
	
КонецПроцедуры

// СтандартныеПодсистемы.ВерсионированиеОбъектов

// Определяет настройки объекта для подсистемы ВерсионированиеОбъектов.
//
// Параметры:
//  Настройки - Структура - настройки подсистемы.
//
Процедура ПриОпределенииНастроекВерсионированияОбъектов(Настройки) Экспорт

КонецПроцедуры

// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов

// Возвращаемое значение:
//   см. ЗапретРедактированияРеквизитовОбъектовПереопределяемый.ПриОпределенииЗаблокированныхРеквизитов.ЗаблокированныеРеквизиты
//
Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	Результат = Новый Массив;
	Результат.Добавить("Организация");
	Результат.Добавить("ВидЗадолженности");
	Результат.Добавить("РешениеОПроведенииИнвентаризации");
	Результат.Добавить("ОтветственноеЛицоУправленческогоУчета");
	Результат.Добавить("Подразделение");
	Результат.Добавить("ИФО");
	Возврат Результат;
КонецФункции

// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов

// СтандартныеПодсистемы.УправлениеДоступом

// Параметры:
//   Ограничение - см. УправлениеДоступомПереопределяемый.ПриЗаполненииОграниченияДоступа.Ограничение.
//
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗаполнениеРаздела1(ДокументОбъектИлиФорма, Отказ, НепроверяемыеРеквизиты,
	ПроверкаИзФормы = Ложь) Экспорт

	ИмяТабличнойЧасти = "Раздел1";
	ИмяСписка = НСтр("ru = 'Раздел 1'");

	ПроверитьЗаполнениеРаздела(ДокументОбъектИлиФорма, ИмяТабличнойЧасти, ИмяСписка, Отказ,
		НепроверяемыеРеквизиты, ПроверкаИзФормы);
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеРаздела2(ДокументОбъектИлиФорма, Отказ, НепроверяемыеРеквизиты,
	ПроверкаИзФормы = Ложь) Экспорт

	ИмяТабличнойЧасти = "Раздел2";
	ИмяСписка = НСтр("ru = 'Раздел 2'");

	ПроверитьЗаполнениеРаздела(ДокументОбъектИлиФорма, ИмяТабличнойЧасти, ИмяСписка, Отказ,
		НепроверяемыеРеквизиты, ПроверкаИзФормы);
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеРаздела31(ДокументОбъектИлиФорма, Отказ, НепроверяемыеРеквизиты,
	ПроверкаИзФормы = Ложь) Экспорт

	ИмяТабличнойЧасти = "Раздел31";
	ИмяСписка = НСтр("ru = 'Раздел 3.1'");

	ПроверитьЗаполнениеРаздела(ДокументОбъектИлиФорма, ИмяТабличнойЧасти, ИмяСписка, Отказ,
		НепроверяемыеРеквизиты, ПроверкаИзФормы);
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеРаздела32(ДокументОбъектИлиФорма, Отказ, НепроверяемыеРеквизиты,
	ПроверкаИзФормы = Ложь) Экспорт

	ИмяТабличнойЧасти = "Раздел32";
	ИмяСписка = НСтр("ru = 'Раздел 3.2'");

	ПроверитьЗаполнениеРаздела(ДокументОбъектИлиФорма, ИмяТабличнойЧасти, ИмяСписка, Отказ,
		НепроверяемыеРеквизиты, ПроверкаИзФормы);
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеРаздела(ДокументОбъектИлиФорма, ИмяТабличнойЧасти, ИмяСписка, Отказ,
	НепроверяемыеРеквизиты, ПроверкаИзФормы)
	
	Если ПроверкаИзФормы Тогда
		Объект = ДокументОбъектИлиФорма.Объект;
		Форма = ДокументОбъектИлиФорма;
	Иначе
		Объект = ДокументОбъектИлиФорма;
	КонецЕсли;
	
	НепроверямыеРеквизитыДляГруппыКонтрагентов = Новый Соответствие;
	Если ИмяТабличнойЧасти = "Раздел1"
		Или ИмяТабличнойЧасти = "Раздел2"
		Или ИмяТабличнойЧасти = "Раздел31"
		Или ИмяТабличнойЧасти = "Раздел32" Тогда
		НепроверямыеРеквизитыДляГруппыКонтрагентов["НаименованиеДокумента"] = Истина;
		НепроверямыеРеквизитыДляГруппыКонтрагентов["НомерДокумента"] = Истина;
		НепроверямыеРеквизитыДляГруппыКонтрагентов["ДатаДокумента"] = Истина;
		НепроверямыеРеквизитыДляГруппыКонтрагентов["ДатаПогашения"] = Истина;
		НепроверямыеРеквизитыДляГруппыКонтрагентов["Контрагент"] = Истина;
		НепроверямыеРеквизитыДляГруппыКонтрагентов["КодСрокаКредита"] = Истина;
	КонецЕсли;
	
	Таблица = Объект[ИмяТабличнойЧасти];
	МетаданныеРеквизитов = Метаданные.Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам
		.ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты;
	
	ИменаРеквизитов = Новый Массив;
	СинонимыРеквизитов = Новый Структура;
	Для Каждого Реквизит Из МетаданныеРеквизитов Цикл
		Если Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку Тогда
			НепроверяемыеРеквизиты.Добавить(СтрШаблон("%1.%2", ИмяТабличнойЧасти, Реквизит.Имя));	
			ИменаРеквизитов.Добавить(Реквизит.Имя);
			СинонимыРеквизитов.Вставить(Реквизит.Имя, МетаданныеРеквизитов[Реквизит.Имя].Синоним);
		КонецЕсли;
	КонецЦикла;
	
	ВидСообщения = "";
	Для каждого СтрокаТаблицы Из Таблица Цикл
		
		ПроверитьТолькоЗаключениеКомиссии = (ИмяТабличнойЧасти = "Раздел31" И Не СтрокаТаблицы.ВыявленыОтклонения)
			Или (ИмяТабличнойЧасти = "Раздел32" И Не СтрокаТаблицы.ВыявленаНеСогласованнаяЗадолженность
			И Не СтрокаТаблицы.ВыявленаПросроченнаяЗадолженность);
		
		НеПроверятьЗаключениеКомиссии = ПроверкаИзФормы 
			И (ИмяТабличнойЧасти = "Раздел31" Или ИмяТабличнойЧасти = "Раздел32");
		
		Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы.ГруппаКредиторов)
				И НепроверямыеРеквизитыДляГруппыКонтрагентов[ИмяРеквизита] = Истина Тогда
				Продолжить;
			КонецЕсли;
			
			Если ПроверитьТолькоЗаключениеКомиссии И ИмяРеквизита <> "ЗаключениеКомиссии" Тогда
				Продолжить;
			КонецЕсли;
			
			Если НеПроверятьЗаключениеКомиссии И ИмяРеквизита = "ЗаключениеКомиссии" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяРеквизита]) Тогда
				Если ИмяРеквизита = "Подраздел" Тогда
					ИмяРеквизита = "КодПодраздела";
					СинонимРеквизита = НСтр("ru = 'Код подраздела'");
					ВидСообщения = "Корректность";
				Иначе
					СинонимРеквизита = СинонимыРеквизитов[ИмяРеквизита];
					ВидСообщения = "Заполнение";
				КонецЕсли;
				
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", ВидСообщения,
					СинонимРеквизита, СтрокаТаблицы.НомерСтроки, ИмяСписка);
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки,
					ИмяРеквизита);
				Если ПроверкаИзФормы Тогда
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Форма.РеквизитФормыВЗначение("Объект"),
						Поле, "Объект", Отказ);
				Иначе
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект, Поле, "Объект", Отказ);
				КонецЕсли;		
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#Область ЗаполнениеРаздела1

Функция ПараметрыЗаполненияРаздел1() Экспорт
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("ВидЗадолженности", Перечисления.ВидыЗадолженностиПоГосДолгу.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("ДатаИнвентаризации", Дата(1,1,1));
	ПараметрыЗаполнения.Вставить("ТаблицаСчетов", Неопределено);
	ПараметрыЗаполнения.Вставить("ИФО", Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("Подразделение", Справочники.Подразделения.ПустаяСсылка());
	Возврат ПараметрыЗаполнения;
КонецФункции

// Формирует таблицу с данными раздела 1 по данным бухучета
//
// Параметры:
//  ПараметрыЗаполнения - Структура - см. ПараметрыЗаполненияРаздел1() 
//
// Возвращаемое значение:
//   ТаблицаЗначений
//
Функция ТаблицаРаздела1(ПараметрыЗаполнения) Экспорт
	
	ТаблицаРаздела1 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(
		Метаданные.Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ТабличныеЧасти.Раздел1);
		
	ТаблицаРаздела1.Колонки.Добавить("НачалоДействия", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	
	ГраницаОстатка = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков(ПараметрыЗаполнения.ДатаИнвентаризации);
	ДатаСреза = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(
		ПараметрыЗаполнения.ДатаИнвентаризации);
	
	ТаблицаСчетов = РазвернутьТаблицуСчетов(ПараметрыЗаполнения.ТаблицаСчетов, ДатаСреза,
		ПараметрыЗаполнения.Организация);
	
	Если ТаблицаСчетов.Количество() = 0 Тогда
		Возврат ТаблицаРаздела1;		
	КонецЕсли;	

	СписокКФО = ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаСчетов, "КФО", Истина);
	ЕстьОтборКФО = СписокКФО.Найти(Перечисления.КВД.ПустаяСсылка()) = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГраницаОстатка", ГраницаОстатка);
	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
	Запрос.УстановитьПараметр("Организация", ПараметрыЗаполнения.Организация);
	Запрос.УстановитьПараметр("ТаблицаСчетов", ТаблицаСчетов);
	Запрос.УстановитьПараметр("ВалютаРуб", ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета());
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыРасчетовПоЗаймам);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	ВидыРасчетовПоЗаймам = Новый Массив;
	ВидыРасчетовПоЗаймам.Добавить(Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг);
	ВидыРасчетовПоЗаймам.Добавить(Перечисления.ВидыРасчетовПоЗаймам.Проценты);
	Запрос.УстановитьПараметр("ВидыРасчетовПоЗаймам", ВидыРасчетовПоЗаймам);
	
	ТекстЗапроса = ТекстЗапросаТаблицаРаздела1();
	
	Если ЕстьОтборКФО Тогда
		УсловиеКФО = "КФО В (&СписокКФО)";
		Запрос.УстановитьПараметр("СписокКФО", СписокКФО);
	Иначе
		УсловиеКФО = "ИСТИНА";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеКФО", УсловиеКФО);
	
	ЕстьОтборПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ПараметрыЗаполнения.ИФО);
	Если ЕстьОтборПоИФО Тогда
		УсловиеИФО = "ИФО = &ИФО";
		Запрос.УстановитьПараметр("ИФО", ПараметрыЗаполнения.ИФО);
	Иначе
		УсловиеИФО = "ИСТИНА";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеИФО", УсловиеИФО);
	
	ЕстьОтборПодразделения = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И ЗначениеЗаполнено(ПараметрыЗаполнения.Подразделение);
	Если ЕстьОтборПодразделения Тогда
		УсловиеПодразделения = "ЕСТЬNULL(Подразделения.Ссылка, &Подразделение) = &Подразделение";
		Запрос.УстановитьПараметр("Подразделение", ПараметрыЗаполнения.Подразделение);
	Иначе
		УсловиеПодразделения = "ИСТИНА";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПодразделения", УсловиеПодразделения);
	
	Если ПараметрыЗаполнения.ВидЗадолженности = Перечисления.ВидыЗадолженностиПоГосДолгу.ВнутреннийДолг Тогда
		УсловиеВидЗадолженности = "ЕСТЬNULL(Валюты.Ссылка, &ВалютаРуб) = &ВалютаРуб";
	Иначе
		УсловиеВидЗадолженности = "ЕСТЬNULL(Валюты.Ссылка, &ВалютаРуб) <> &ВалютаРуб";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеВидЗадолженности", УсловиеВидЗадолженности);

	Запрос.Текст = ТекстЗапроса;
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Подраздел = 0;
	КодСтроки = 0;
	ГруппаКредиторов = Неопределено;
	Пока Выборка.Следующий() Цикл
		
		Если ГруппаКредиторов <> Выборка.ГруппаКредиторов Тогда
			Подраздел = Подраздел + 1;
			КодСтроки = 0;
			ГруппаКредиторов = Выборка.ГруппаКредиторов;
		КонецЕсли;
		
		КодСтроки = КодСтроки + 1;
		
		СтрокаРаздела1 = ТаблицаРаздела1.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела1, Выборка);
		СтрокаРаздела1.Подраздел = Подраздел;
		СтрокаРаздела1.КодСтроки = КодСтроки;
	КонецЦикла;
	
	АнализЗадолженности = АнализЗадолженности(ТаблицаРаздела1, ПараметрыЗаполнения);
	ЗаполнитьДатуПогашения(ТаблицаРаздела1, АнализЗадолженности, ПараметрыЗаполнения);
	
	ЗаполнитьКодСрокаКредита(ТаблицаРаздела1);
	ТаблицаРаздела1.Колонки.Удалить("НачалоДействия");
	
	Возврат ТаблицаРаздела1;
КонецФункции

Процедура ЗаполнитьДатуПогашения(ТаблицаРаздела1, АнализЗадолженности, ПараметрыЗаполнения)
	
	Для Каждого СтрокаРаздела1 Из ТаблицаРаздела1 Цикл
		
		Если ЗначениеЗаполнено(СтрокаРаздела1.ГруппаКредиторов) Тогда
			Продолжить;
		КонецЕсли;
		
		ОтборЗадолженности = Новый Структура;
		ОтборЗадолженности.Вставить("Контрагент", СтрокаРаздела1.Контрагент);
		ОтборЗадолженности.Вставить("Договор", СтрокаРаздела1.Договор);
		ОтборЗадолженности.Вставить("СчетРасчетов", СтрокаРаздела1.Счет);
		ОтборЗадолженности.Вставить("Валюта", СтрокаРаздела1.Валюта);
		ОтборЗадолженности.Вставить("КФО", СтрокаРаздела1.КФО);
		ОтборЗадолженности.Вставить("КПС", СтрокаРаздела1.КПС);
		СрокиИсполнения = АнализЗадолженности.Скопировать(ОтборЗадолженности, "СрокИсполнения");

		СтрокаРаздела1.ДатаПогашения = МаксимальныйСрокИсполненияПоГрафику(СрокиИсполнения);
				
	КонецЦикла;
	
	ИнвентаризацияСервер.ЗаполнитьПустуюДатуПогашенияПоДатеОкончанияДоговора(ТаблицаРаздела1,
		ПараметрыЗаполнения.ДатаИнвентаризации);
	
КонецПроцедуры

Функция МаксимальныйСрокИсполненияПоГрафику(ТаблицаЗадолженности)
	СрокИсполнения = Дата(1,1,1);
	Для Каждого Строка Из ТаблицаЗадолженности Цикл
		СрокИсполнения = Макс(СрокИсполнения, Строка.СрокИсполнения);		
	КонецЦикла;
	Возврат СрокИсполнения;
КонецФункции

Функция ТекстЗапросаТаблицаРаздела1()

	Возврат
		"ВЫБРАТЬ
		|	ТаблицаСчетов.КФО КАК КФО,
		|	ТаблицаСчетов.Счет КАК Счет
		|ПОМЕСТИТЬ ВТТаблицаСчетов
		|ИЗ
		|	&ТаблицаСчетов КАК ТаблицаСчетов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТТаблицаСчетов.КФО КАК КФО,
		|	ВТТаблицаСчетов.Счет КАК Счет
		|ПОМЕСТИТЬ ВТТаблицаСчетовБезДублей
		|ИЗ
		|	ВТТаблицаСчетов КАК ВТТаблицаСчетов
		|ГДЕ
		|	ВТТаблицаСчетов.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТТаблицаСчетов.КФО,
		|	ВТТаблицаСчетов.Счет
		|ИЗ
		|	ВТТаблицаСчетов КАК ВТТаблицаСчетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТТаблицаСчетов КАК ВТТаблицаСчетовНетКФО
		|		ПО ВТТаблицаСчетов.Счет = ВТТаблицаСчетовНетКФО.Счет
		|		И ВТТаблицаСчетовНетКФО.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)
		|ГДЕ
		|	ВТТаблицаСчетовНетКФО.Счет ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУОстатки.КФО КАК КФО,
		|	ЕПСБУОстатки.Счет КАК Счет,
		|	ЕПСБУОстатки.КПС КАК КПС,
		|	ЕСТЬNULL(Валюты.Ссылка, &ВалютаРуб) КАК Валюта,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(Валюты.Ссылка, &ВалютаРуб) = &ВалютаРуб
		|			ТОГДА 0
		|		КОГДА ЕПСБУОстатки.Субконто1 = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг)
		|			ТОГДА -ЕСТЬNULL(ЕПСБУОстатки.ВалютнаяСуммаОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаДолгаВал,
		|	ВЫБОР
		|		КОГДА ЕПСБУОстатки.Субконто1 = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг)
		|			ТОГДА -ЕПСБУОстатки.СуммаОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаДолгаРуб,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(Валюты.Ссылка, &ВалютаРуб) = &ВалютаРуб
		|			ТОГДА 0
		|		КОГДА ЕПСБУОстатки.Субконто1 = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.Проценты)
		|			ТОГДА -ЕСТЬNULL(ЕПСБУОстатки.ВалютнаяСуммаОстаток, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НачисленныеПроцентыВал,
		|	ВЫБОР
		|		КОГДА ЕПСБУОстатки.Субконто1 = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.Проценты)
		|			ТОГДА -ЕПСБУОстатки.СуммаОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НачисленныеПроцентыРуб,
		|	ВЫБОР
		|		КОГДА ЕПСБУОстатки.Субконто1 = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг)
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ПорядокСортировкиПоВидуРасчетов,
		|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
		|	ЕСТЬNULL(Контрагенты.Ссылка, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
		|	ЕСТЬNULL(Контрагенты.ВидКонтрагента, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.УчетнаяГруппа) КАК
		|		УчетнаяГруппа,
		|	ЕСТЬNULL(Контрагенты.Наименование, """") КАК НаименованиеКонтрагента
		|ПОМЕСТИТЬ ВТОстатки
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ГраницаОстатка, Счет В
		|		(ВЫБРАТЬ
		|			ВТТаблицаСчетовБезДублей.Счет
		|		ИЗ
		|			ВТТаблицаСчетовБезДублей КАК ВТТаблицаСчетовБезДублей), &ВидыСубконто, Организация = &Организация
		|	И &УсловиеИФО
		|	И &УсловиеКФО
		|	И Субконто1 В (&ВидыРасчетовПоЗаймам)) КАК ЕПСБУОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТТаблицаСчетовБезДублей КАК ВТТаблицаСчетовБезДублей
		|		ПО ЕПСБУОстатки.Счет = ВТТаблицаСчетовБезДублей.Счет
		|		И ВЫБОР
		|			КОГДА ВТТаблицаСчетовБезДублей.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЕПСБУОстатки.КФО = ВТТаблицаСчетовБезДублей.КФО
		|		КОНЕЦ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
		|		ПО ЕПСБУОстатки.Валюта = Валюты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Подразделения КАК Подразделения
		|		ПО ЕПСБУОстатки.Подразделение = Подразделения.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО ЕПСБУОстатки.Субконто3 = Контрагенты.Ссылка
		|ГДЕ
		|	&УсловиеВидЗадолженности
		|	И &УсловиеПодразделения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТОстатки.Договор КАК Договор
		|ПОМЕСТИТЬ ВТДоговораКонтрагентов
		|ИЗ
		|	ВТОстатки КАК ВТОстатки
		|ГДЕ
		|	НЕ ВТОстатки.УчетнаяГруппа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Обязательство КАК Договор,
		|	СрокиИсполненияИСуммыОбязательствСрезПоследних.НачалоДействия КАК НачалоДействия,
		|	СрокиИсполненияИСуммыОбязательствСрезПоследних.СрокИсполнения КАК СрокИсполнения
		|ПОМЕСТИТЬ ВТСведенияПоДоговору
		|ИЗ
		|	РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(&ДатаСреза, Обязательство В
		|		(ВЫБРАТЬ
		|			ВТДоговораКонтрагентов.Договор
		|		ИЗ
		|			ВТДоговораКонтрагентов)) КАК СрокиИсполненияИСуммыОбязательствСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТОстатки.УчетнаяГруппа КАК УчетнаяГруппа,
		|	ВЫБОР
		|		КОГДА ВТОстатки.УчетнаяГруппа
		|			ТОГДА ВТОстатки.Контрагент
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|	КОНЕЦ КАК ГруппаКредиторов,
		|	ВЫБОР
		|		КОГДА ВТОстатки.УчетнаяГруппа
		|			ТОГДА ВТОстатки.НаименованиеКонтрагента
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК НаименованиеГруппаКредиторов,
		|	ЕСТЬNULL(Договоры.Ссылка, ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)) КАК Договор,
		|	ЕСТЬNULL(Договоры.ВидОбязательства, """") КАК НаименованиеДокумента,
		|	ЕСТЬNULL(Договоры.НомерДоговора, """") КАК НомерДокумента,
		|	ЕСТЬNULL(Договоры.ДатаДоговора, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаДокумента,
		|	ЕСТЬNULL(ВТСведенияПоДоговору.НачалоДействия, ДАТАВРЕМЯ(1, 1, 1)) КАК НачалоДействия,
		|	ЕСТЬNULL(ВТСведенияПоДоговору.СрокИсполнения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПогашения,
		|	ВЫБОР
		|		КОГДА ВТОстатки.УчетнаяГруппа
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|		ИНАЧЕ ВТОстатки.Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	ВТОстатки.КФО КАК КФО,
		|	ВТОстатки.Счет КАК Счет,
		|	ВТОстатки.КПС КАК КПС,
		|	ВТОстатки.Валюта КАК Валюта,
		|	СУММА(ВТОстатки.СуммаДолгаВал) КАК СуммаДолгаВал,
		|	СУММА(ВТОстатки.СуммаДолгаРуб) КАК СуммаДолгаРуб,
		|	СУММА(ВТОстатки.НачисленныеПроцентыВал) КАК НачисленныеПроцентыВал,
		|	СУММА(ВТОстатки.НачисленныеПроцентыРуб) КАК НачисленныеПроцентыРуб,
		|	МИНИМУМ(ВТОстатки.ПорядокСортировкиПоВидуРасчетов) КАК ПорядокСортировкиПоВидуРасчетов
		|ИЗ
		|	ВТОстатки КАК ВТОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
		|		ПО ВТОстатки.Договор = Договоры.Ссылка
		|		И НЕ ВТОстатки.УчетнаяГруппа
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСведенияПоДоговору КАК ВТСведенияПоДоговору
		|		ПО ВТОстатки.Договор = ВТСведенияПоДоговору.Договор
		|		И НЕ ВТОстатки.УчетнаяГруппа
		|СГРУППИРОВАТЬ ПО
		|	ВТОстатки.КФО,
		|	ВТОстатки.Счет,
		|	ВТОстатки.КПС,
		|	ВТОстатки.Валюта,
		|	ЕСТЬNULL(Договоры.Ссылка, ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)),
		|	ЕСТЬNULL(Договоры.ВидОбязательства, """"),
		|	ЕСТЬNULL(Договоры.НомерДоговора, """"),
		|	ЕСТЬNULL(Договоры.ДатаДоговора, ДАТАВРЕМЯ(1, 1, 1)),
		|	ВЫБОР
		|		КОГДА ВТОстатки.УчетнаяГруппа
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|		ИНАЧЕ ВТОстатки.Контрагент
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ВТОстатки.УчетнаяГруппа
		|			ТОГДА ВТОстатки.Контрагент
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ВТОстатки.УчетнаяГруппа
		|			ТОГДА ВТОстатки.НаименованиеКонтрагента
		|		ИНАЧЕ """"
		|	КОНЕЦ,
		|	ВТОстатки.УчетнаяГруппа,
		|	ЕСТЬNULL(ВТСведенияПоДоговору.СрокИсполнения, ДАТАВРЕМЯ(1, 1, 1)),
		|	ЕСТЬNULL(ВТСведенияПоДоговору.НачалоДействия, ДАТАВРЕМЯ(1, 1, 1))
		|
		|УПОРЯДОЧИТЬ ПО
		|	УчетнаяГруппа,
		|	НаименованиеГруппаКредиторов,
		|	ДатаДокумента,
		|	НомерДокумента,
		|	Договор,
		|	ПорядокСортировкиПоВидуРасчетов";
	
КонецФункции

Процедура ЗаполнитьКодСрокаКредита(ТаблицаОписи)
	
	Для Каждого СтрокаТаблицы Из ТаблицаОписи Цикл
		
		НачалоДействия = ?(ЗначениеЗаполнено(СтрокаТаблицы.НачалоДействия),
			СтрокаТаблицы.НачалоДействия,
			СтрокаТаблицы.ДатаДокумента);
		ДатаПогашения = СтрокаТаблицы.ДатаПогашения;	
		СтрокаТаблицы.КодСрокаКредита = КодСрокаКредита(НачалоДействия, ДатаПогашения);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРаздела2

Функция ПараметрыЗаполненияРаздел2() Экспорт
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("ВидЗадолженности", Перечисления.ВидыЗадолженностиПоГосДолгу.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("ДатаИнвентаризации", Дата(1,1,1));
	ПараметрыЗаполнения.Вставить("ДатаОкончания", Дата(1,1,1));
	ПараметрыЗаполнения.Вставить("ИФО", Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	ПараметрыЗаполнения.Вставить("ТаблицаРаздела2", Неопределено);
	ПараметрыЗаполнения.Вставить("ЗаполнитьПросроченнуюЗадолженность", Ложь);
	Возврат ПараметрыЗаполнения;
КонецФункции

// Собирает документы согласования и просроченную задолженность по данным бух.учета
//
// Параметры:
//  ПараметрыЗаполнения - Структура - см. ПараметрыЗаполненияРаздел2() 
//
// Возвращаемое значение:
//   ТаблицаЗначений
//
Функция ДополнитьТаблицуРаздела2(ПараметрыЗаполнения) Экспорт
	
	ТаблицаРаздела2 = ПараметрыЗаполнения.ТаблицаРаздела2;
	
	Если ПараметрыЗаполнения.ЗаполнитьПросроченнуюЗадолженность Тогда
		ЗаполнитьПросроченнуюЗадолженностьРаздела2(ТаблицаРаздела2, ПараметрыЗаполнения);		
	КонецЕсли;
	
	Возврат ТаблицаРаздела2;
КонецФункции

Процедура ЗаполнитьПросроченнуюЗадолженностьРаздела2(ТаблицаРаздела2, ПараметрыЗаполнения)
	
	АнализЗадолженности = АнализЗадолженности(ТаблицаРаздела2, ПараметрыЗаполнения);
	
	ВнешнийДолг = ПараметрыЗаполнения.ВидЗадолженности = Перечисления.ВидыЗадолженностиПоГосДолгу.ВнешнийДолг;
	
	Для Каждого СтрокаРаздела2 Из ТаблицаРаздела2 Цикл
		
		ПоГруппеКредиторов = ЗначениеЗаполнено(СтрокаРаздела2.ГруппаКредиторов) 
			И Не ЗначениеЗаполнено(СтрокаРаздела2.Контрагент);
		
		Контрагент = ?(ПоГруппеКредиторов, СтрокаРаздела2.ГруппаКредиторов, СтрокаРаздела2.Контрагент);

		СуммаДолга = ?(ВнешнийДолг, СтрокаРаздела2.СуммаДолгаВал, СтрокаРаздела2.СуммаДолгаРуб);
		НачисленныеПроценты = ?(ВнешнийДолг,
			СтрокаРаздела2.НачисленныеПроцентыВал,
			СтрокаРаздела2.НачисленныеПроцентыРуб);
		
		ОтборОсновнойДолг = Новый Структура;
		ОтборОсновнойДолг.Вставить("ВидРасчетов", Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг);
		ОтборОсновнойДолг.Вставить("Контрагент", Контрагент);
		Если Не ПоГруппеКредиторов Тогда
			ОтборОсновнойДолг.Вставить("Договор", СтрокаРаздела2.Договор);
		КонецЕсли;
		ОтборОсновнойДолг.Вставить("СчетРасчетов", СтрокаРаздела2.Счет);
		ОтборОсновнойДолг.Вставить("Валюта", СтрокаРаздела2.Валюта);
		ОтборОсновнойДолг.Вставить("КФО", СтрокаРаздела2.КФО);
		ОтборОсновнойДолг.Вставить("КПС", СтрокаРаздела2.КПС);
		ОтборОсновнойДолг.Вставить("ЭтоНераспределенныйОстаток", Ложь);
		
		ОсновнойДолгПоГрафику = АнализЗадолженности.Скопировать(ОтборОсновнойДолг, "Просроченная");
		
		ОтборПроценты = Новый Структура;
		ОтборПроценты.Вставить("ВидРасчетов", Перечисления.ВидыРасчетовПоЗаймам.Проценты);
		ОтборПроценты.Вставить("Контрагент", Контрагент);
		Если Не ПоГруппеКредиторов Тогда
			ОтборПроценты.Вставить("Договор", СтрокаРаздела2.Договор);
		КонецЕсли;
		ОтборПроценты.Вставить("СчетРасчетов", СтрокаРаздела2.Счет);
		ОтборПроценты.Вставить("Валюта", СтрокаРаздела2.Валюта);
		ОтборПроценты.Вставить("КФО", СтрокаРаздела2.КФО);
		ОтборПроценты.Вставить("КПС", СтрокаРаздела2.КПС);
		ОтборПроценты.Вставить("ЭтоНераспределенныйОстаток", Ложь);
		
		ПроцентыПоГрафику = АнализЗадолженности.Скопировать(ОтборПроценты, "Просроченная");
		
		ОтборНеРаспределено = Новый Структура;
		ОтборНеРаспределено.Вставить("ЭтоНераспределенныйОстаток", Истина);
		ОтборНеРаспределено.Вставить("Контрагент", Контрагент);
		Если Не ПоГруппеКредиторов Тогда
			ОтборНеРаспределено.Вставить("Договор", СтрокаРаздела2.Договор);
		КонецЕсли;
		ОтборНеРаспределено.Вставить("СчетРасчетов", СтрокаРаздела2.Счет);
		ОтборНеРаспределено.Вставить("Валюта", СтрокаРаздела2.Валюта);
		ОтборНеРаспределено.Вставить("КФО", СтрокаРаздела2.КФО);
		ОтборНеРаспределено.Вставить("КПС", СтрокаРаздела2.КПС);
		
		НеРаспределено = АнализЗадолженности.Скопировать(ОтборНеРаспределено, "Просроченная");
		
		ОсновнойДолгПросроченоПоГрафику = ОсновнойДолгПоГрафику.Итог("Просроченная");
		ПроцентыПросроченоПоГрафику = ПроцентыПоГрафику.Итог("Просроченная");
		НеРаспределеноПросрочено = НеРаспределено.Итог("Просроченная");
		
		ОсновнойДолгПросрочено = Мин(СуммаДолга, ОсновнойДолгПросроченоПоГрафику + НеРаспределеноПросрочено);
		НеРаспределеноПросрочено = ОсновнойДолгПросроченоПоГрафику + НеРаспределеноПросрочено - ОсновнойДолгПросрочено;			
		ПроцентыПросрочено = Мин(НачисленныеПроценты, ПроцентыПросроченоПоГрафику + НеРаспределеноПросрочено);
		
		Если ОсновнойДолгПросрочено > 0 Или ПроцентыПросрочено > 0 Тогда
			
			Если ВнешнийДолг Тогда
				
				СтрокаРаздела2.СуммаДолгаВалПросроченная = ОсновнойДолгПросрочено;
				СтрокаРаздела2.СуммаДолгаРубПросроченная = ПросроченнаяЗадолженностьРуб(
					СтрокаРаздела2.СуммаДолгаВал,
					СтрокаРаздела2.СуммаДолгаРуб,
					СтрокаРаздела2.СуммаДолгаВалПросроченная);
				
				СтрокаРаздела2.НачисленныеПроцентыВалПросроченная = ПроцентыПросрочено;
				СтрокаРаздела2.НачисленныеПроцентыРубПросроченная = ПросроченнаяЗадолженностьРуб(
					СтрокаРаздела2.НачисленныеПроцентыВал,
					СтрокаРаздела2.НачисленныеПроцентыРуб,
					СтрокаРаздела2.НачисленныеПроцентыВалПросроченная);
			Иначе
				
				СтрокаРаздела2.СуммаДолгаРубПросроченная = ОсновнойДолгПросрочено;
				СтрокаРаздела2.НачисленныеПроцентыРубПросроченная = ПроцентыПросрочено;
					
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПросроченнаяЗадолженностьРуб(СуммаВал, СуммаРуб, ПросроченнаяВал)
	
	Если СуммаВал = 0 Тогда
		Возврат 0;		
	КонецЕсли;
	
	Возврат	?(СуммаВал = ПросроченнаяВал, СуммаРуб,	ПросроченнаяВал * СуммаРуб / СуммаВал);
	
КонецФункции

#КонецОбласти

Функция АнализЗадолженности(ТаблицаРаздела, ПараметрыЗаполнения)

	ЕстьОтборПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ПараметрыЗаполнения.ИФО);
	
	ОтборЗадолженности = Новый Структура;
	ОтборЗадолженности.Вставить("Контрагент", ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаРаздела, "Контрагент",
		Истина));
	ОтборЗадолженности.Вставить("Договор", ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаРаздела, "Договор", Истина));	
	ОтборЗадолженности.Вставить("СчетРасчетов", ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаРаздела, "Счет", Истина));	
	ОтборЗадолженности.Вставить("КПС", ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаРаздела, "КПС", Истина));	
	ОтборЗадолженности.Вставить("Валюта", ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаРаздела, "Валюта", Истина));	
	ОтборЗадолженности.Вставить("КФО", ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаРаздела, "КФО", Истина));

	ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ОтборЗадолженности.Контрагент, 
		Справочники.Контрагенты.ПустаяСсылка());	
	ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ОтборЗадолженности.Договор, 
		Справочники.Договоры.ПустаяСсылка());	
	
	Если ЕстьОтборПоИФО Тогда
		ОтборЗадолженности.Вставить("ИФО", ПараметрыЗаполнения.ИФО);
	КонецЕсли;	

	НаДату = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(
		ПараметрыЗаполнения.ДатаИнвентаризации);	
	
	АнализЗадолженности = КонтрольИсполненияДоговоров.АнализЗадолженности(
		ПараметрыЗаполнения.Организация,
		НаДату,
		ОтборЗадолженности,
		Перечисления.ВидыЗадолженности.Кредиторская,
		"Кт301");
	
	Возврат АнализЗадолженности;
КонецФункции

// Код срока кредита принимает одно из значений:
// "1" - если срок кредита до 1 года,
// "2" - если срок кредита от 1 года до 5 лет,
// "3" - если срок кредита от 5 до 30 лет;
// 
// Используется следующий алгоритм:
// период с 01.06.2025 по 31.05.2026 считается равным 1 году
// период с 01.06.2025 по 01.06.2026 считается равным 1 году и 1 дню
// "1" - период менее года. Период с 01.06.2025 по 31.06.2025 это уже код "2"
// "2" - перод от года но менее 5 лет
// "3" - период от 5 лет до 30 лет вклюительно
//
// Параметры:
//  НачалоДействия - Дата
//  ДатаПогашения - Дата
// 
// Возвращаемое значение:
//  Строка - "1" - если срок кредита до 1 года,
//           "2" - если срок кредита от 1 года до 5 лет,
//           "3" - если срок кредита от 5 до 30 лет,
//           ""  - если срок кредита не определен.
//  
Функция КодСрокаКредита(Знач НачалоДействия, Знач ДатаПогашения) Экспорт
	
	КодСрокаКредита = "";
	
	Если Не ЗначениеЗаполнено(НачалоДействия) Или Не ЗначениеЗаполнено(ДатаПогашения) Тогда
		Возврат КодСрокаКредита;
	КонецЕсли;
	
	НачалоДействия = НачалоДня(НачалоДействия);
	ДатаПогашения = КонецДня(ДатаПогашения);
	
	Если ДобавитьМесяц(НачалоДействия, 12) - 1 > ДатаПогашения Тогда
		КодСрокаКредита = "1";
	ИначеЕсли ДобавитьМесяц(НачалоДействия, 12 * 5) - 1 > ДатаПогашения Тогда
		КодСрокаКредита = "2";
	ИначеЕсли ДобавитьМесяц(НачалоДействия, 12 * 30) - 1 >= ДатаПогашения Тогда
		КодСрокаКредита = "3";		
	КонецЕсли;
	
	Возврат КодСрокаКредита;
		
КонецФункции

// Разворачивает таблицу счетов по субсчетам.
// Ограничивает список счетов допустимыми счетами
// 
// Параметры:
//  ТаблицаСчетов - ТаблицаЗначений:
//  				* КФО - ПеречислениеСсылка.КВД
//  				* Счет - ПланСчетовСсылка.ЕПСБУ
//  НаДату - Дата
//  Организация - СправочникСсылка.Организации
// 
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * КФО - ПеречислениеСсылка.КВД
//   * Счет - ПланСчетовСсылка.ЕПСБУ
//  
Функция РазвернутьТаблицуСчетов(ТаблицаСчетов, НаДату, Организация)

	НоваяТаблицаСчетов = ТаблицаСчетов.СкопироватьКолонки();

	ДопустимыеСчетаСтрокой = "301.11,301.13,301.21,301.23,301.43";
	ДопустимыеСчета = БухгалтерскийУчет.СписокСчетов(ДопустимыеСчетаСтрокой, НаДату, , Организация);

	ПроверкаСчетов = Новый Соответствие;
	Для Каждого Счет Из ДопустимыеСчета Цикл
		ПроверкаСчетов.Вставить(Счет, Истина);		
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ТаблицаСчетов Цикл
		СчетаСписка = БухгалтерскийУчет.СписокСчетов(СтрокаТаблицы.Счет, НаДату, , Организация);
		Для Каждого СчетСписка Из СчетаСписка Цикл
			Если ПроверкаСчетов[СчетСписка] = Неопределено Тогда
				Продолжить;				
			КонецЕсли;
			НоваяСтрока = НоваяТаблицаСчетов.Добавить();
			НоваяСтрока.КФО = СтрокаТаблицы.КФО;
			НоваяСтрока.Счет = СчетСписка;
		КонецЦикла;
	КонецЦикла;	

	Возврат НоваяТаблицаСчетов;
КонецФункции

#Область УсловноеОформление

Процедура УстановитьУсловноеОформления(Форма) Экспорт
	
	УсловноеОформление = Форма.УсловноеОформление;
	
	УстановитьУсловноеОформлениеРаздел1(УсловноеОформление);
	УстановитьУсловноеОформлениеРаздел2(УсловноеОформление);
	УстановитьУсловноеОформлениеРаздел31(УсловноеОформление);
	УстановитьУсловноеОформлениеРаздел32(УсловноеОформление);
	УстановитьУсловноеОформлениеОтборСчетов(УсловноеОформление);

	ИнвентаризацияСервер.ДобавитьУсловноеОформлениеСоставКомиссииПричинаОтсутствия(Форма);
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеРаздел1(УсловноеОформление)

	// отметка незаполненного
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел1НаименованиеДокумента");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел1ДатаДокумента");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел1НомерДокумента");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел1ДатаПогашения");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел1Контрагент");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел1КодСрокаКредита");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	
		"Объект.Раздел1.ГруппаКредиторов", ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеРаздел2(УсловноеОформление)

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел2Валюта");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел2СуммаДолгаВал");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел2НачисленныеПроцентыВал");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел2СуммаДолгаВалСогласовано");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел2НачисленныеПроцентыВалСогласовано");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел2СуммаДолгаВалПросроченная");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Раздел2НачисленныеПроцентыВалПросроченная");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	
		"Объект.ВидЗадолженности", ВидСравненияКомпоновкиДанных.Равно,
		Перечисления.ВидыЗадолженностиПоГосДолгу.ВнутреннийДолг);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

	// данные раздела 1
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
