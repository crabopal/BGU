#Область РешениеОПроведенииИнвентаризации

&НаСервереБезКонтекста
Функция ПараметрыФормыВыборДанныхИзРешения(Знач Ссылка, Знач РешениеОПроведенииИнвентаризации,
	Знач УникальныйИдентификатор)
	
	Возврат ИнвентаризацияСервер.ПолучитьПараметрыФормыВыбораДанныхИзРешения(
		Ссылка,
		РешениеОПроведенииИнвентаризации,
		УникальныйИдентификатор);	
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьОписьПослеВыбораДанныхИзРешения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Раздел1.Количество() > 0
		Или Объект.Раздел2.Количество() > 0 Тогда
			ЗадатьВопросОбОчисткеПриВыбореРешенияАсинх(Результат, ДополнительныеПараметры);
	Иначе
		ЗаполнитьОписьПоРешению(Результат, ДополнительныеПараметры);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗадатьВопросОбОчисткеПриВыбореРешенияАсинх(Результат, ДополнительныеПараметры)
	
	ТекстВопроса = НСтр("ru='Табличные части всех подразделов раздела 1, 2 и 3 будут очищены. Продолжить?'");
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,
		ТекстЗаголовкаСообщений);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОчиститьРаздел1(ЭтотОбъект);
		ОчиститьРаздел2(ЭтотОбъект);
		ОчиститьРаздел3(ЭтотОбъект);
		ЗаполнитьОписьПоРешению(Результат, ДополнительныеПараметры);
	Иначе
		ПредупреждениеАсинх(НСтр("ru='Заполнение описи по Решению не выполнено'"));
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОписьПоРешению(Результат, ДополнительныеПараметры)

	Модифицированность = Истина;
	Объект.РешениеОПроведенииИнвентаризации = ДополнительныеПараметры.Решение;
	
	ЗаполнитьОписьПоРешениюНаСервере(Результат);
	ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписьПоРешениюНаСервере(РезультатВыбора)
	
	ИнвентаризацияСервер.ЗаполнитьОписьПоРешениюИзФормыОписи(ЭтотОбъект, РезультатВыбора);
	ЗаполнитьВидЗадолженностиПоСчету();
	УправлениеКомандойПересчетРублевогоЭквивалента(ЭтотОбъект);
	
	УстановитьПредставлениеНомераКомиссии();
	УстановитьПредставлениеМестаПроведения();
	УстановитьПредставлениеСпискаСчетов();
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ПриИзмененииКомиссииЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	РаботаСКомиссиями.ЗаполнитьОтветственногоИсполнителяКомиссииВДокументеОписи(ЭтотОбъект);
	
	НастроитьОтборПоПодразделению();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент()
	
	ИнвентаризацияКлиент.СообщитьОЗаполненииНаОснованииРешенияОПроведенииИнвентаризации();
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ЗаполнитьВидЗадолженностиПоСчету()
	
	НаДату = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(Объект.ДатаИнвентаризации);
	СчетаЗадолженности = ОбщегоНазначения.ВыгрузитьКолонку(Объект.СписокСчетов, "Счет");
	ДопустимыеВидыЗадолженности = Перечисления.ВидыЗадолженностиПоГосДолгу.ДопустимыеВидыЗадолженностиПоСчету(
		СчетаЗадолженности, Объект.Организация, НаДату);
		
	Если ДопустимыеВидыЗадолженности.Количество() = 1 Тогда
		Объект.ВидЗадолженности = ДопустимыеВидыЗадолженности[0];
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеНомераКомиссии()

	ПредставлениеНомераКомиссии = "";

	Если ЗначениеЗаполнено(Объект.НомерКомиссии) Или ЗначениеЗаполнено(Объект.НомерРабочейКомиссии) Тогда
		ПредставлениеНомераКомиссии = ИнвентаризацияКлиентСервер.ФорматироватьПолныйНомерКомиссии(Объект.НомерКомиссии,
			Объект.НомерРабочейКомиссии);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеМестаПроведения()
	
	ИнвентаризацияКлиентСервер.УстановитьПредставлениеМестаПроведения(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеСпискаСчетов()
	
	МаксимальнаяДлинаСтроки = 50;
	МассивСтрок = Новый Массив();

	Для Каждого СтрокаТаблицы Из Объект.СписокСчетов Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Счет) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрок.Добавить(СтрШаблон("%1.%2",
			?(ЗначениеЗаполнено(СтрокаТаблицы.КФО), СтрокаТаблицы.КФО, "0"),
			СтрокаТаблицы.Счет));
	
	КонецЦикла;
	
	Если МассивСтрок.Количество() = 0 Тогда
		МассивСтрок.Добавить(НСтр("ru='<отсутствует>'"));
	КонецЕсли;

	ПредставлениеСпискаСчетов = ИнвентаризацияКлиентСервер.СократитьСтроку(СтрСоединить(МассивСтрок, ", "),
		МаксимальнаяДлинаСтроки);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеКомандойПересчетРублевогоЭквивалента(Форма)
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	ДоступностьКомандыПересчет = Объект.ВидЗадолженности = ПредопределенноеЗначение(
		"Перечисление.ВидыЗадолженностиПоГосДолгу.ВнешнийДолг");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"Раздел2ПересчетРублевогоЭквивалентаВРазделе2", "Доступность", ДоступностьКомандыПересчет);
КонецПроцедуры

#Область ПанельРасписки

&НаСервере
Процедура НастроитьФормуПоРасписке()
	
	НастроитьПанельРаспискиИнвентаризацииСервер();
	НастроитьДоступностьРазделов();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПанельРаспискиИнвентаризацииСервер()
	
	ИнвентаризацияСервер.НастроитьПанельРаспискиНаФормеОписи(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьНадписьРасписки()
	Если Не ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка) Тогда
		Элементы.ДекорацияРаспискаНадпись.Заголовок = НСтр("ru='Создать расписку'");		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура НастроитьДоступностьРазделов()

	Если ТолькоПросмотр Тогда
		Возврат;	
	КонецЕсли;
	
	ДоступностьРазделов = ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка) И ДанныеПанелиРасписки.РаспискаПроведена;

	Элементы.ГруппаРаздел1Заголовок.Доступность = ДоступностьРазделов;
	Элементы.ГруппаРаздел2Заголовок.Доступность = ДоступностьРазделов;
	Элементы.ГруппаРаздел31Заголовок.Доступность = ДоступностьРазделов;
	Элементы.ГруппаРаздел32Заголовок.Доступность = ДоступностьРазделов;
	
КонецПроцедуры

&НаСервере
Процедура ЗаблокироватьРеквизитыПриНаличииРасписки()

	Если ТолькоПросмотр Тогда
		Возврат;	
	КонецЕсли;

	Если ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка) Тогда
		// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
		ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
		// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура СоздатьРаспискуАсинх()
	
	Если Не ПроверитьЗаполнениеПередФормированиемРасписки() Тогда
		Возврат;		
	КонецЕсли;
	
	ДокументЗаписан = ЗначениеЗаполнено(Параметры.Ключ) И Не Модифицированность;
	
	Если Не ДокументЗаписан Тогда
		
		Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
			ТекстВопроса = НСтр("ru = 'Документ изменен. Перед формированием расписки необходимо записать документ.'");
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Записать и продолжить'"));
			Кнопки.Добавить(КодВозвратаДиалога.Отмена);
			Ответ = Ждать ВопросАсинх(ТекстВопроса, Кнопки, , КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
			Если Ответ <> КодВозвратаДиалога.Да Тогда
				Возврат;
			КонецЕсли;		
		КонецЕсли;
		
		ДокументЗаписан = Записать();
	КонецЕсли;
	
	Если ДокументЗаписан Тогда
		ИнвентаризацияКлиент.СоздатьДокументРасписки(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеПередФормированиемРасписки()
	
	Отказ = Ложь;
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.Организация",, Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.РешениеОПроведенииИнвентаризации) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Решение о проведении инвентаризации'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.РешениеОПроведенииИнвентаризации",, Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ВидЗадолженности) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Вид задолженности'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.ВидЗадолженности",, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ОтветственноеЛицоУправленческогоУчета) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Ответственное лицо'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.ОтветственноеЛицоУправленческогоУчета",,
			Отказ);
	КонецЕсли;
	
	Возврат Не Отказ;
КонецФункции

#КонецОбласти

#Область ЗаполнениеРазделов

#Область Раздел1

&НаСервере
Процедура ПроверитьПередЗаполнениемРаздела1Сервер(Отказ)
	
	Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ПроверитьПередЗаполнениемРаздела1(Объект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел1Клиент()
	
	ДлительнаяОперация = НачатьЗаполнениеРаздела1НаСервере();
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаполнитьРаздел1Завершение", ЭтотОбъект);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция НачатьЗаполнениеРаздела1НаСервере()
	
	ОчиститьРаздел1(ЭтотОбъект);
	ОчиститьРаздел2(ЭтотОбъект);
	ОчиститьРаздел3(ЭтотОбъект);	
	
	ПараметрыЗаполнения = Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ПараметрыЗаполненияРаздел1();
	ПараметрыЗаполнения.Организация = Объект.Организация;
	ПараметрыЗаполнения.ВидЗадолженности = Объект.ВидЗадолженности;
	ПараметрыЗаполнения.ДатаИнвентаризации = Объект.ДатаИнвентаризации;
	ПараметрыЗаполнения.ТаблицаСчетов = Объект.СписокСчетов.Выгрузить();
	ПараметрыЗаполнения.ИФО = Объект.ИФО;
	ПараметрыЗаполнения.Подразделение = Объект.Подразделение;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр(
		"ru = 'Заполнение раздела 1 инвентаризационной описи 0510473'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	Возврат 
		ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ТаблицаРаздела1", ПараметрыЗаполнения);
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьРаздел1Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ИнформацияОбОшибке = Результат.ИнформацияОбОшибке;
		Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке,
			НСтр("ru = 'При заполнении раздела 1 возникла ошибка:'"));
		ОбработкаОшибок.ПоказатьИнформациюОбОшибке(ИнформацияОбОшибке, Уточнение.Текст);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел1ЗавершениеНаСервере(Результат.АдресРезультата);
	
	ТекстЗаголовкаОповещения = НСтр("ru = 'Заполнить по данным учета'");
	ТекстСообщения = НСтр("ru = 'Раздел 1 заполнен'");
	ПоказатьОповещениеПользователя(ТекстЗаголовкаОповещения, , ТекстСообщения, БиблиотекаКартинок.Информация32);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаздел1ЗавершениеНаСервере(Знач АдресРезультата)
	
	ТаблицаРаздела1 = ПолучитьИзВременногоХранилища(АдресРезультата);	
	Объект.Раздел1.Загрузить(ТаблицаРаздела1);
	ЗаполнитьДобавленныеКолонкиРаздел1();
	УдалитьИзВременногоХранилища(АдресРезультата);
	Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ПроверитьЗаполнениеРаздела1(ЭтотОбъект, Ложь,
		Новый Массив, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область Раздел2

&НаКлиенте
Процедура НачатьЗаполнениеРаздела2НаКлиенте(ВключаяСумму)

	Если ВключаяСумму Тогда
		ОткрытьФормуНастройкиЗаполненияРаздела2();
	Иначе
		НастройкаЗаполненияРаздела2 = НоваяНастройкаЗаполненияРаздела2(); 
		ЗаполнитьРаздел2Клиент(НастройкаЗаполненияРаздела2, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиЗаполненияРаздела2()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("Организация", Объект.Организация);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ЗаполнитьРаздел2Клиент", ЭтотОбъект);
	
	ОткрытьФорму("Документ.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.Форма.ЗаполнениеРаздела2",
		ПараметрыОткрытияФормы, , , , ,
		ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗаполнитьРаздел2Клиент(НастройкаЗаполнения, ПараметрыЗакрытияФормы) Экспорт
	
	Если НастройкаЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Раздел2.Количество() > 0
		Или Объект.Раздел31.Количество() > 0
		Или Объект.Раздел32.Количество() > 0 Тогда
			
		ТекстВопроса = НСтр(
			"ru='Табличная часть раздела 2 будет перезаполнена по данным раздела 1, разделы 3.1, 3.2 очищены. Продолжить?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;		
		
	КонецЕсли;

	ОчиститьСообщения();
	ОчиститьРаздел2(ЭтотОбъект);
	ОчиститьРаздел3(ЭтотОбъект);
	
	Модифицированность = Истина;
	
	НастройкаЗаполненияРаздела2 = НоваяНастройкаЗаполненияРаздела2();
	ЗаполнитьЗначенияСвойств(НастройкаЗаполненияРаздела2, НастройкаЗаполнения);
	
	ДлительнаяОперация = НачатьЗаполнениеРаздела2НаСервере(НастройкаЗаполненияРаздела2);
	Если ДлительнаяОперация <> Неопределено Тогда
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаполнитьРаздел2Завершение", ЭтотОбъект);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьСообщения = Истина;
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	Иначе
		ТекстЗаголовкаОповещения = НСтр("ru = 'Заполнить по данным раздела 1'");
		ТекстСообщения = НСтр("ru = 'Раздел 2 заполнен'");
		ПоказатьОповещениеПользователя(ТекстЗаголовкаОповещения, , ТекстСообщения, БиблиотекаКартинок.Информация32);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция НачатьЗаполнениеРаздела2НаСервере(НастройкаЗаполненияРаздела2)
	
	ТаблицаРаздела2 = ТаблицаРаздела2ПоДаннымРаздела1(НастройкаЗаполненияРаздела2);
	
	Если Не ТребуетсяПолучитьДанныеУчетаДляРаздела2(НастройкаЗаполненияРаздела2) Тогда
		
		Объект.Раздел2.Загрузить(ТаблицаРаздела2);
		ЗаполнитьДобавленныеКолонкиРаздел2();
		Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ПроверитьЗаполнениеРаздела2(ЭтотОбъект, Ложь,
			Новый Массив, Истина);
		
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыЗаполнения = Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ПараметрыЗаполненияРаздел2();
	ПараметрыЗаполнения.Организация = Объект.Организация;
	ПараметрыЗаполнения.ВидЗадолженности = Объект.ВидЗадолженности;
	ПараметрыЗаполнения.ДатаИнвентаризации = Объект.ДатаИнвентаризации;
	ПараметрыЗаполнения.ДатаОкончания = Объект.ДатаОкончания;
	ПараметрыЗаполнения.ИФО = Объект.ИФО;
	ПараметрыЗаполнения.ТаблицаРаздела2 = ТаблицаРаздела2;
	ПараметрыЗаполнения.ЗаполнитьПросроченнуюЗадолженность = 
		НастройкаЗаполненияРаздела2.ЗаполнитьПросроченнуюЗадолженность;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр(
		"ru = 'Заполнение раздела 2 инвентаризационной описи 0510473'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	Возврат 
		ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ДополнитьТаблицуРаздела2",
			ПараметрыЗаполнения);
	
КонецФункции

&НаСервере
Функция ТребуетсяПолучитьДанныеУчетаДляРаздела2(НастройкаЗаполненияРаздела2)
	
	Возврат	НастройкаЗаполненияРаздела2.ЗаполнитьПросроченнуюЗадолженность;		
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьРаздел2Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ИнформацияОбОшибке = Результат.ИнформацияОбОшибке;
		Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке,
			НСтр("ru = 'При заполнении раздела 2 возникла ошибка:'"));
		ОбработкаОшибок.ПоказатьИнформациюОбОшибке(ИнформацияОбОшибке, Уточнение.Текст);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел2ЗавершениеНаСервере(Результат.АдресРезультата);
	
	ТекстЗаголовкаОповещения = НСтр("ru = 'Заполнить по данным раздела 1'");
	ТекстСообщения = НСтр("ru = 'Раздел 2 заполнен'");
	ПоказатьОповещениеПользователя(ТекстЗаголовкаОповещения, , ТекстСообщения, БиблиотекаКартинок.Информация32);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаздел2ЗавершениеНаСервере(Знач АдресРезультата)
	
	ТаблицаРаздела2 = ПолучитьИзВременногоХранилища(АдресРезультата);
	Объект.Раздел2.Загрузить(ТаблицаРаздела2);
	ЗаполнитьДобавленныеКолонкиРаздел2();

	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ПроверитьЗаполнениеРаздела2(ЭтотОбъект, Ложь,
		Новый Массив, Истина);
	
КонецПроцедуры

&НаСервере
Функция ТаблицаРаздела2ПоДаннымРаздела1(НастройкаЗаполненияРаздела2)
	
	ТаблицаРаздела2 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(
		Метаданные.Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ТабличныеЧасти.Раздел2);

	ТаблицаРаздела2.Колонки.Добавить("НомерСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(6));
	
	СписокСвойств = СписокСвойствДляЗаполненияРаздела2(НастройкаЗаполненияРаздела2.ЗаполнитьСуммуДолга);
	
	Для Каждого СтрокаРаздела1 Из Объект.Раздел1 Цикл
		
		СтрокаРаздела2 = ТаблицаРаздела2.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела2, СтрокаРаздела1, СписокСвойств);
		СтрокаРаздела2.НомерСтроки = СтрокаРаздела1.НомерСтроки;
		
		Если НастройкаЗаполненияРаздела2.ВсяЗадолженностьСогласована Тогда
			СтрокаРаздела2.СуммаДолгаВалСогласовано = СтрокаРаздела2.СуммаДолгаВал;
			СтрокаРаздела2.СуммаДолгаРубСогласовано = СтрокаРаздела2.СуммаДолгаРуб;
			СтрокаРаздела2.НачисленныеПроцентыВалСогласовано = СтрокаРаздела2.НачисленныеПроцентыВал;
			СтрокаРаздела2.НачисленныеПроцентыРубСогласовано = СтрокаРаздела2.НачисленныеПроцентыРуб;
		КонецЕсли;
		
		Если НастройкаЗаполненияРаздела2.ДокументОснованиеОсновногоДолга
			И (СтрокаРаздела2.СуммаДолгаВалСогласовано > 0 
			Или СтрокаРаздела2.СуммаДолгаРубСогласовано > 0) Тогда
			ПоляЗаполнения = "СуммаДолгаНаименованиеДокумента,СуммаДолгаДатаДокумента,СуммаДолгаНомерДокумента";
			ЗаполнитьЗначенияСвойств(СтрокаРаздела2, НастройкаЗаполненияРаздела2, ПоляЗаполнения);	
		КонецЕсли;
		
		Если НастройкаЗаполненияРаздела2.ДокументОснованиеПроценты
			И (СтрокаРаздела2.НачисленныеПроцентыВалСогласовано > 0 
			Или СтрокаРаздела2.НачисленныеПроцентыРубСогласовано > 0) Тогда
			ПоляЗаполнения = "НачисленныеПроцентыНаименованиеДокумента,НачисленныеПроцентыДатаДокумента,НачисленныеПроцентыНомерДокумента";
			ЗаполнитьЗначенияСвойств(СтрокаРаздела2, НастройкаЗаполненияРаздела2, ПоляЗаполнения);	
		КонецЕсли;
		
		СтрокаРаздела2.ДанныеРаздела1 = Не ЗначениеЗаполнено(СтрокаРаздела1.ГруппаКредиторов);
		
	КонецЦикла;
	
	Возврат ТаблицаРаздела2;
КонецФункции

&НаСервере
Функция СписокСвойствДляЗаполненияРаздела2(ВключаяСумму = Ложь)
	Возврат 
		"Подраздел,ГруппаКредиторов,КодСтроки,"
			+ "Договор,НаименованиеДокумента,ДатаДокумента,НомерДокумента,ДатаПогашения,Контрагент,"
			+ "КФО,Счет,КПС,КодСрокаКредита,Валюта"
			+ ?(ВключаяСумму, ",СуммаДолгаВал,СуммаДолгаРуб,НачисленныеПроцентыВал,НачисленныеПроцентыРуб", "");
КонецФункции

&НаКлиенте
Функция НоваяНастройкаЗаполненияРаздела2()
	НастройкаЗаполненияРаздела2 = Новый Структура;
	НастройкаЗаполненияРаздела2.Вставить("ЗаполнитьСуммуДолга", Ложь);
	НастройкаЗаполненияРаздела2.Вставить("ВсяЗадолженностьСогласована", Ложь);
	НастройкаЗаполненияРаздела2.Вставить("ДокументОснованиеОсновногоДолга", Ложь);
	НастройкаЗаполненияРаздела2.Вставить("СуммаДолгаНаименованиеДокумента", "");
	НастройкаЗаполненияРаздела2.Вставить("СуммаДолгаДатаДокумента", Дата(1,1,1));
	НастройкаЗаполненияРаздела2.Вставить("СуммаДолгаНомерДокумента", "");
	НастройкаЗаполненияРаздела2.Вставить("ДокументОснованиеПроценты", Ложь);
	НастройкаЗаполненияРаздела2.Вставить("НачисленныеПроцентыНаименованиеДокумента", "");
	НастройкаЗаполненияРаздела2.Вставить("НачисленныеПроцентыДатаДокумента", Дата(1,1,1));
	НастройкаЗаполненияРаздела2.Вставить("НачисленныеПроцентыНомерДокумента", "");
	НастройкаЗаполненияРаздела2.Вставить("ЗаполнитьПросроченнуюЗадолженность", Ложь);
	Возврат НастройкаЗаполненияРаздела2;
КонецФункции

&НаКлиенте
Асинх Процедура ВопросПередНачаломДобавленияСтрокРаздела2Асинх(Копирование)
	
	ТекстВопроса = НСтр("ru = 'Табличные части раздела 3.1 и раздела 3.2 будут очищены. Продолжить?'");
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ОчиститьРаздел3(ЭтотОбъект);		
	Модифицированность = Истина;
	
	Если Копирование Тогда
		ДобавитьСтрокуРаздела2Копированием();
	Иначе
		ВыбратьПодразделПередНачаломДобавленияСтрокиАсинх();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуРаздела2Копированием()
	
	ТекущиеДанные = Элементы.Раздел2.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ГруппаКредиторов) Тогда
		ПоказатьПредупреждениеНельзяДобавлятьСтроки();
		Возврат;
	КонецЕсли;
	
	Подраздел = ТекущиеДанные.Подраздел;
	НовыйКодСтрокиПодраздела2 = НовыйКодСтрокиПодраздела2(Подраздел);

	ПропуститьОбработчикРаздел2ПередНачаломДобавления = Истина;
	Элементы.Раздел2.СкопироватьСтроку();
	ПропуститьОбработчикРаздел2ПередНачаломДобавления = Ложь;

	Модифицированность = Истина;
		
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьПодразделПередНачаломДобавленияСтрокиАсинх()
	
	Раздел2ТребуетЗаполнения = Объект.Раздел2.Количество() = 0 И ЕстьДанныеКДобавлению();
	
	Если Раздел2ТребуетЗаполнения Тогда
		
		ТекстВопроса = НСтр("ru = 'Раздел 2 заполняется по данным раздела 1.
			|Заполнить раздел 2 по данным раздела 1?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("ЗаполнитьРаздел2БезСумм", НСтр("ru = 'Заполнить без сумм'"));
		Кнопки.Добавить("ЗаполнитьРаздел2ВключаяСумму", НСтр("ru = 'Заполнить, включая сумму'"));
		Кнопки.Добавить("Отмена", НСтр("ru = 'Отмена'"));
		Ответ = Ждать ВопросАсинх(ТекстВопроса, Кнопки, ,"ЗаполнитьРаздел2БезСумм", ТекстЗаголовкаСообщений);
		Если Ответ = "ЗаполнитьРаздел2БезСумм" Тогда
			НачатьЗаполнениеРаздела2НаКлиенте(Ложь);
		ИначеЕсли Ответ = "ЗаполнитьРаздел2ВключаяСумму" Тогда
			НачатьЗаполнениеРаздела2НаКлиенте(Истина);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;

	СписокПодразделовРаздела2 = СписокПодразделовРаздела2();
	
	Если СписокПодразделовРаздела2.Количество() = 0 Тогда
		ПоказатьПредупреждениеНельзяДобавлятьСтроки();
		Возврат;		
	ИначеЕсли СписокПодразделовРаздела2.Количество() = 1 Тогда
		ЗначениеПодраздела = СписокПодразделовРаздела2[0].Значение;
	Иначе
		ТекущиеДанные = Элементы.Раздел2.ТекущиеДанные;
		Заголовок = НСтр("ru = 'Выберите подраздел'");
		Для Каждого ЭлементСписка Из СписокПодразделовРаздела2 Цикл
			Если ТекущиеДанные = Неопределено
				Или ЭлементСписка.Значение.Подраздел = ТекущиеДанные.Подраздел Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		ЭлементСписка = Ждать СписокПодразделовРаздела2.ВыбратьЭлементАсинх(Заголовок, ЭлементСписка);
		Если ЭлементСписка = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ЗначениеПодраздела = ЭлементСписка.Значение;
	КонецЕсли;
	
	НовыйПодразделРаздела2 = ЗначениеПодраздела.Подраздел;
	НоваяГруппаКредиторовРаздела2 = ЗначениеПодраздела.ГруппаКредиторов;
	НовыйКодСтрокиПодраздела2 = НовыйКодСтрокиПодраздела2(НовыйПодразделРаздела2);

	ПропуститьОбработчикРаздел2ПередНачаломДобавления = Истина;
	Элементы.Раздел2.ДобавитьСтроку();
	ПропуститьОбработчикРаздел2ПередНачаломДобавления = Ложь;

	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Функция ЕстьДанныеКДобавлению()
	ЕстьДанныеКДобавлению = Ложь;
	Для Каждого Строка Из Объект.Раздел1 Цикл
		Если Не ЗначениеЗаполнено(Строка.ГруппаКредиторов) Тогда
			ЕстьДанныеКДобавлению = Истина;
			Прервать;
		КонецЕсли
	КонецЦикла;
	Возврат ЕстьДанныеКДобавлению;	
КонецФункции

&НаКлиенте
Процедура ПоказатьПредупреждениеНельзяДобавлятьСтроки()
	
	ТекстПредупреждения = НСтр("ru = 'При инвентаризации долговых обязательств в разрезе кредиторов добавление строк раздела 2 не предусмотрено.'");
	ПоказатьПредупреждение(, ТекстПредупреждения);
	
КонецПроцедуры

&НаСервере
Функция СписокПодразделовРаздела2()
	СписокПодразделов = Новый СписокЗначений();
	ПодразделДобавлен = Новый Соответствие;
	Для Каждого Строка Из Объект.Раздел1 Цикл
		Если Не ЗначениеЗаполнено(Строка.ГруппаКредиторов) Тогда
			Продолжить;
		КонецЕсли;
		Если ПодразделДобавлен[Строка.Подраздел] = Неопределено Тогда
			ПодразделДобавлен[Строка.Подраздел] = Истина;
			ЗначениеПодраздела = НовыйЗначениеПодразделаРаздела2();
			ЗначениеПодраздела.Подраздел = Строка.Подраздел;
			ЗначениеПодраздела.ГруппаКредиторов = Строка.ГруппаКредиторов;
			ПредставлениеПодраздела = СтрШаблон("2.%1. %2", Строка.Подраздел, Строка.ГруппаКредиторов);
			СписокПодразделов.Добавить(ЗначениеПодраздела, ПредставлениеПодраздела);
		КонецЕсли;
	КонецЦикла;
	Возврат СписокПодразделов;	
КонецФункции

&НаСервере
Функция НовыйКодСтрокиПодраздела2(Знач Подраздел)
	КодСтроки = 0;
	Для Каждого Строка Из Объект.Раздел2 Цикл
		Если Строка.Подраздел = Подраздел Тогда
			КодСтроки = Макс(КодСтроки, Строка.КодСтроки);
		КонецЕсли;
	КонецЦикла;
	КодСтроки = КодСтроки + 1;
	Возврат КодСтроки;	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НовыйЗначениеПодразделаРаздела2()
	ЗначениеПодраздела = Новый Структура;
	ЗначениеПодраздела.Вставить("Подраздел", 1);
	ЗначениеПодраздела.Вставить("ГруппаКредиторов", ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
	Возврат ЗначениеПодраздела;
КонецФункции

&НаКлиенте
Функция ЕстьДанныеРаздела1()
	ЕстьДанныеРаздела1 = Ложь;
	ВыделенныеСтроки = Элементы.Раздел2.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 1 Тогда
		ЕстьДанныеРаздела1 = Элементы.Раздел2.ТекущиеДанные.ДанныеРаздела1;
	Иначе
		Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
			Строка = Объект.Раздел2.НайтиПоИдентификатору(ИдентификаторСтроки);
			Если Строка.ДанныеРаздела1 Тогда
				ЕстьДанныеРаздела1 = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ЕстьДанныеРаздела1;
КонецФункции

&НаКлиенте
Асинх Процедура ВопросПередУдалениемСтрокРаздела2Асинх(ЕстьДанныеРаздела1, ТребуетОчистки)

	Если ТребуетОчистки Тогда
		ТекстВопроса = НСтр("ru = 'Табличные части раздела 3.1 и раздела 3.2 будут очищены. Продолжить?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		ОчиститьРаздел3(ЭтотОбъект);
		Модифицированность = Истина;
	КонецЕсли;

	ВыделенныеСтроки = Элементы.Раздел2.ВыделенныеСтроки;
	ОчиститьРаздел2 = ВыделенныеСтроки.Количество() = Объект.Раздел2.Количество();

	Если ЕстьДанныеРаздела1 И Не ОчиститьРаздел2 Тогда
		ТекстВопроса = НСтр("ru = 'Не предусмотрено удаление строк, заполненных по данным раздела 1.
			|Очистить сумму задолженности в выделенных строках?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если ОчиститьРаздел2 Тогда
		ОчиститьРаздел2(ЭтотОбъект);
	Иначе
		УдалитьВыделенныеСтрокиРаздела2НаСервере(ВыделенныеСтроки);
	КонецЕсли;

	ОбновитьИтогиРаздела2(ЭтотОбъект);
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура УдалитьВыделенныеСтрокиРаздела2НаСервере(Знач ВыделенныеСтроки)
	
	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		Строка = Объект.Раздел2.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если Строка.ДанныеРаздела1 Тогда
			ОчиститьДанныеСтрокиРаздела2(Строка);
		Иначе
			Объект.Раздел2.Удалить(Строка);
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьКодСтрокиРаздела2();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьДанныеСтрокиРаздела2(Строка)
	
	ФиксированныеДанные = Новый Структура(СписокСвойствДляЗаполненияРаздела2());
	ФиксированныеДанные.Вставить("ДанныеРаздела1");
	
	Реквизиты = Метаданные.Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ТабличныеЧасти
				.Раздел2.Реквизиты;
	
	Для Каждого Реквизит Из Реквизиты Цикл
		Если ФиксированныеДанные.Свойство(Реквизит.Имя) Тогда
			Продолжить;			
		КонецЕсли;
		Строка[Реквизит.Имя] = ОбщегоНазначенияБГУКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(Строка[Реквизит.Имя]));
	КонецЦикла;

	РасчетСуммИтогоВСтрокеРаздела2(Строка);				
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКодСтрокиРаздела2()
	
	КодСтрокиПодраздела = Новый Соответствие;
	
	Для Каждого Строка Из Объект.Раздел2 Цикл
		Если КодСтрокиПодраздела[Строка.Подраздел] = Неопределено Тогда
			КодСтрокиПодраздела[Строка.Подраздел] = 0;
		КонеЦесли;
		 
		Если Строка.ДанныеРаздела1 Тогда
			КодСтрокиПодраздела[Строка.Подраздел] = Строка.КодСтроки;
		Иначе
			КодСтрокиПодраздела[Строка.Подраздел] = КодСтрокиПодраздела[Строка.Подраздел] + 1;
			Строка.КодСтроки = КодСтрокиПодраздела[Строка.Подраздел];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВопросПередИзменениямСтрокРаздела2Асинх()
	
	ТекстВопроса = НСтр("ru = 'Табличные части раздела 3.1 и раздела 3.2 будут очищены. Продолжить?'");
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ОчиститьРаздел3(ЭтотОбъект);		
	
	Элементы.Раздел2.ИзменитьСтроку();

	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеСтрокиРаздела2ПриИзмененииДоговора(Знач ПараметрыЗаполнения)

	ДанныеСтроки = НовыеДаныеСтрокиРаздела2();
	Если Не ЗначениеЗаполнено(ПараметрыЗаполнения.Договор) Тогда
		Возврат ДанныеСтроки;	
	КонецЕсли;
	
	СписокРеквизитов = "ВидОбязательства,НомерДоговора,ДатаДоговора,Контрагент";
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыЗаполнения.Договор, СписокРеквизитов);
	
	ДанныеСтроки.НаименованиеДокумента = РеквизитыДоговора.ВидОбязательства;
	ДанныеСтроки.ДатаДокумента = РеквизитыДоговора.ДатаДоговора;
	ДанныеСтроки.НомерДокумента = РеквизитыДоговора.НомерДоговора;
	ДанныеСтроки.Контрагент = РеквизитыДоговора.Контрагент;
	
	Если ПараметрыЗаполнения.ВидЗадолженности = Перечисления.ВидыЗадолженностиПоГосДолгу.ВнутреннийДолг Тогда
		ДанныеСтроки.Валюта = ПараметрыЗаполнения.ВалютаРегламентированногоУчета;
	КонецЕсли;

	НаДату = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(
		ПараметрыЗаполнения.ДатаИнвентаризации);	
	
	СвойстваДоговоров = УчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам(ПараметрыЗаполнения.Договор, НаДату);
	Если СвойстваДоговоров.Количество() = 1 Тогда
		РеквизитыДоговора = СвойстваДоговоров[0];
		
		ДанныеСтроки.ДатаПогашения = РеквизитыДоговора.СрокИсполнения;
		ДанныеСтроки.КодСрокаКредита = Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.КодСрокаКредита(
			РеквизитыДоговора.НачалоДействия, РеквизитыДоговора.СрокИсполнения);
		
		Если ПараметрыЗаполнения.ВидЗадолженности = Перечисления.ВидыЗадолженностиПоГосДолгу.ВнешнийДолг Тогда
			ДанныеСтроки.Валюта = РеквизитыДоговора.ВалютаРасчетов;
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат ДанныеСтроки;
	
КонецФункции

&НаКлиенте
Асинх Процедура РедактироватьНаименованиеДокументаАсинх(ТекущиеДанные, ИмяРеквизита, Подсказка)
	ДлинаНаименования = 255;
	Результат = Ждать ВвестиСтрокуАсинх(ТекущиеДанные[ИмяРеквизита], Подсказка, ДлинаНаименования, Ложь);
	Если Результат <> Неопределено Тогда
		ТекущиеДанные[ИмяРеквизита] = Результат;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция НовыеДаныеСтрокиРаздела2()
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("НаименованиеДокумента", "");
	ДанныеСтроки.Вставить("ДатаДокумента", Дата(1,1,1));
	ДанныеСтроки.Вставить("НомерДокумента", "");
	ДанныеСтроки.Вставить("ДатаПогашения", Дата(1,1,1));
	ДанныеСтроки.Вставить("Контрагент", Неопределено);
	ДанныеСтроки.Вставить("Валюта", Неопределено);
	ДанныеСтроки.Вставить("КодСрокаКредита", "");
	Возврат ДанныеСтроки; 	
КонецФункции

#КонецОбласти

#Область Раздел31

&НаСервере
Процедура ЗаполнитьРаздел31НаСервере()
	
	Объект.Раздел31.Очистить();
	
	ТаблицаРаздела31 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(
		Метаданные.Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ТабличныеЧасти.Раздел31);
	
	СписокСвойств = "Подраздел,ГруппаКредиторов,"
		+ "Договор,НаименованиеДокумента,НомерДокумента,ДатаДокумента,ДатаПогашения,Контрагент,"
		+ "КФО,Счет,КПС,КодСрокаКредита,Валюта";
	
	СписокСвойствПоГруппеКредиторов = "Подраздел,ГруппаКредиторов,КФО,Счет,КПС,Валюта";	
	
	ДанныеИнвентаризации = Объект.Раздел1.Выгрузить();
	Для Каждого СтрокаРаздела2 Из Объект.Раздел2 Цикл
		Строка = ДанныеИнвентаризации.Добавить();
		СписокСвойствИсточника = ?(ЗначениеЗаполнено(СтрокаРаздела2.ГруппаКредиторов), СписокСвойствПоГруппеКредиторов,
			СписокСвойств);
		ЗаполнитьЗначенияСвойств(Строка, СтрокаРаздела2, СписокСвойствИсточника);
		Строка.СуммаДолгаВал = - СтрокаРаздела2.СуммаДолгаВал;
		Строка.СуммаДолгаРуб = - СтрокаРаздела2.СуммаДолгаРуб;
		Строка.НачисленныеПроцентыВал = - СтрокаРаздела2.НачисленныеПроцентыВал;
		Строка.НачисленныеПроцентыРуб = - СтрокаРаздела2.НачисленныеПроцентыРуб;
	КонецЦикла;
	ДанныеИнвентаризации.Свернуть(СписокСвойств, 
		"СуммаДолгаВал,СуммаДолгаРуб,НачисленныеПроцентыВал,НачисленныеПроцентыРуб,КодСтроки");
	
	Если Объект.ВидЗадолженности = Перечисления.ВидыЗадолженностиПоГосДолгу.ВнутреннийДолг Тогда
		ИмяПоляСумма = "СуммаДолгаРуб";
		ИмяПоляПроценты = "НачисленныеПроцентыРуб";
	Иначе
		ИмяПоляСумма = "СуммаДолгаВал";
		ИмяПоляПроценты = "НачисленныеПроцентыВал";
	КонецЕсли;
	
	Подразделы = Новый Соответствие;
	Для Каждого Строка Из ДанныеИнвентаризации Цикл
		Если Строка[ИмяПоляСумма] = 0 И Строка[ИмяПоляПроценты] = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРаздела31 = ТаблицаРаздела31.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела31, Строка);
		СтрокаРаздела31.ВыявленыОтклонения = Истина;
		Подразделы.Вставить(СтрокаРаздела31.Подраздел, Истина);
	КонецЦикла;

	Объект.ВыявленыОтклонения = ТаблицаРаздела31.Количество() > 0;
	
	Для Каждого Строка Из ДанныеИнвентаризации Цикл
		Если Подразделы[Строка.Подраздел] = Истина Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРаздела31 = ТаблицаРаздела31.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела31, Строка, "Подраздел,ГруппаКредиторов");
		СтрокаРаздела31.ЗаключениеКомиссии = 
			ИнвентаризацияСервер.ПолучитьТекстЗаключенияКомиссииОтклоненияНеВыявлены(Объект.Ссылка);
		Подразделы.Вставить(СтрокаРаздела31.Подраздел, Истина);
	КонецЦикла;
	
	ТаблицаРаздела31.Сортировать("Подраздел,КодСтроки");
	Объект.Раздел31.Загрузить(ТаблицаРаздела31);

	ЗаполнитьДобавленныеКолонкиРаздел31();	

	Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ПроверитьЗаполнениеРаздела31(ЭтотОбъект, Ложь,
		Новый Массив, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область Раздел32

&НаСервере
Процедура ЗаполнитьРаздел32НаСервере()
	
	Объект.Раздел32.Очистить();
	
	ТаблицаРаздела32 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(
		Метаданные.Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ТабличныеЧасти.Раздел32);
	
	ВыявленаНеСогласованнаяЗадолженность = Ложь;
	ВыявленаПросроченнаяЗадолженность = Ложь;
	Подразделы = Новый Соответствие;
	
	Для Каждого СтрокаРаздела2 Из Объект.Раздел2 Цикл
		
		Если СтрокаРаздела2.СуммаДолгаВал = СтрокаРаздела2.СуммаДолгаВалСогласовано
			И СтрокаРаздела2.СуммаДолгаРуб = СтрокаРаздела2.СуммаДолгаРубСогласовано
			И СтрокаРаздела2.НачисленныеПроцентыВал = СтрокаРаздела2.НачисленныеПроцентыВалСогласовано
			И СтрокаРаздела2.НачисленныеПроцентыРуб = СтрокаРаздела2.НачисленныеПроцентыРубСогласовано
			И СтрокаРаздела2.СуммаДолгаВалПросроченная = 0
			И СтрокаРаздела2.СуммаДолгаРубПросроченная = 0
			И СтрокаРаздела2.НачисленныеПроцентыВалПросроченная = 0
			И СтрокаРаздела2.НачисленныеПроцентыРубПросроченная = 0 Тогда
				
				Продолжить;
				
		КонецЕсли;

		СтрокаРаздела32 = ТаблицаРаздела32.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела32, СтрокаРаздела2);
		СтрокаРаздела32.СуммаДолгаВалНеСогласовано =
			СтрокаРаздела2.СуммаДолгаВал - СтрокаРаздела2.СуммаДолгаВалСогласовано;
		СтрокаРаздела32.СуммаДолгаРубНеСогласовано =
			СтрокаРаздела2.СуммаДолгаРуб - СтрокаРаздела2.СуммаДолгаРубСогласовано;
		СтрокаРаздела32.НачисленныеПроцентыВалНеСогласовано =
			СтрокаРаздела2.НачисленныеПроцентыВал - СтрокаРаздела2.НачисленныеПроцентыВалСогласовано;
		СтрокаРаздела32.НачисленныеПроцентыРубНеСогласовано =
			СтрокаРаздела2.НачисленныеПроцентыРуб - СтрокаРаздела2.НачисленныеПроцентыРубСогласовано;
		
		СтрокаРаздела32.ВыявленаНеСогласованнаяЗадолженность = 
			СтрокаРаздела32.СуммаДолгаВалНеСогласовано <> 0
			Или СтрокаРаздела32.СуммаДолгаРубНеСогласовано <> 0
			Или СтрокаРаздела32.НачисленныеПроцентыВалНеСогласовано <> 0
			Или СтрокаРаздела32.НачисленныеПроцентыРубНеСогласовано <> 0;
			
		СтрокаРаздела32.ВыявленаПросроченнаяЗадолженность = 
			СтрокаРаздела32.СуммаДолгаВалПросроченная <> 0
			Или СтрокаРаздела32.СуммаДолгаРубПросроченная <> 0
			Или СтрокаРаздела32.НачисленныеПроцентыВалПросроченная <> 0
			Или СтрокаРаздела32.НачисленныеПроцентыРубПросроченная <> 0;
		
		ВыявленаНеСогласованнаяЗадолженность = ВыявленаНеСогласованнаяЗадолженность
			Или СтрокаРаздела32.ВыявленаНеСогласованнаяЗадолженность;
		
		ВыявленаПросроченнаяЗадолженность = ВыявленаПросроченнаяЗадолженность
			Или СтрокаРаздела32.ВыявленаПросроченнаяЗадолженность;

		Подразделы.Вставить(СтрокаРаздела32.Подраздел, Истина);
	КонецЦикла;
	
	Объект.ВыявленаНеСогласованнаяЗадолженность = ВыявленаНеСогласованнаяЗадолженность;
	Объект.ВыявленаПросроченнаяЗадолженность = ВыявленаПросроченнаяЗадолженность;
	
	Для Каждого СтрокаРаздела2 Из Объект.Раздел2 Цикл
		Если Подразделы[СтрокаРаздела2.Подраздел] = Истина Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРаздела32 = ТаблицаРаздела32.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела32, СтрокаРаздела2, "Подраздел,ГруппаКредиторов");
		СтрокаРаздела32.ЗаключениеКомиссии = 
			НСтр("ru='Просроченная задолженность и задолженность, не согласованная с кредиторами, отсутствует'");
		Подразделы.Вставить(СтрокаРаздела32.Подраздел, Истина);
	КонецЦикла;
	Для Каждого СтрокаРаздела1 Из Объект.Раздел1 Цикл
		Если Подразделы[СтрокаРаздела1.Подраздел] = Истина Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРаздела32 = ТаблицаРаздела32.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела32, СтрокаРаздела1, "Подраздел,ГруппаКредиторов");
		СтрокаРаздела32.ЗаключениеКомиссии = 
			НСтр("ru='Просроченная задолженность и задолженность, не согласованная с кредиторами, отсутствует'");
		Подразделы.Вставить(СтрокаРаздела32.Подраздел, Истина);
	КонецЦикла;
	
	ТаблицаРаздела32.Сортировать("Подраздел,КодСтроки");
	Объект.Раздел32.Загрузить(ТаблицаРаздела32);

	ЗаполнитьДобавленныеКолонкиРаздел32();
	
	Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.ПроверитьЗаполнениеРаздела32(ЭтотОбъект, Ложь,
		Новый Массив, Истина);
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ВыполнитьПересчетРублевогоЭквивалентаВРазеделе2()
	КурсыВалют = Новый Соответствие;
	Для Каждого СтрокаРаздела Из Объект.Раздел2 Цикл
		ПересчетРублевогоЭквивалентаВСтроке(СтрокаРаздела, КурсыВалют, Объект.ДатаИнвентаризации,
			ВалютаРегламентированногоУчета);
		РасчетСуммИтогоВСтрокеРаздела2(СтрокаРаздела);
	КонецЦикла;
	ОбновитьИтогиРаздела2(ЭтотОбъект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчетРублевогоЭквивалентаВСтроке(СтрокаРаздела, КурсыВалют, ДатаИнвентаризации,
	ВалютаРегламентированногоУчета, СуммаВал = "", СуммаРуб = "", Постфикс = "")

	Если СуммаВал = "" Тогда
		
		ПересчетРублевогоЭквивалентаВСтроке(СтрокаРаздела, КурсыВалют, ДатаИнвентаризации,
			ВалютаРегламентированногоУчета, "СуммаДолгаВал", "СуммаДолгаРуб", "");
		ПересчетРублевогоЭквивалентаВСтроке(СтрокаРаздела, КурсыВалют, ДатаИнвентаризации,
			ВалютаРегламентированногоУчета,	"НачисленныеПроцентыВал", "НачисленныеПроцентыРуб",	"");
		ПересчетРублевогоЭквивалентаВСтроке(СтрокаРаздела, КурсыВалют, ДатаИнвентаризации,
			ВалютаРегламентированногоУчета,	"СуммаДолгаВал", "СуммаДолгаРуб", "Согласовано");
		ПересчетРублевогоЭквивалентаВСтроке(СтрокаРаздела, КурсыВалют, ДатаИнвентаризации,
			ВалютаРегламентированногоУчета, "НачисленныеПроцентыВал", "НачисленныеПроцентыРуб", "Согласовано");
		ПересчетРублевогоЭквивалентаВСтроке(СтрокаРаздела, КурсыВалют, ДатаИнвентаризации,
			ВалютаРегламентированногоУчета, "СуммаДолгаВал", "СуммаДолгаРуб", "Просроченная");
		ПересчетРублевогоЭквивалентаВСтроке(СтрокаРаздела, КурсыВалют, ДатаИнвентаризации,
			ВалютаРегламентированногоУчета, "НачисленныеПроцентыВал", "НачисленныеПроцентыРуб", "Просроченная");
		
	ИначеЕсли Постфикс = "Согласовано" Или Постфикс = "Просроченная" Тогда
		
		СтрокаРаздела[СуммаРуб + Постфикс] = СтрокаРаздела[СуммаРуб] * ?(СтрокаРаздела[СуммаВал] = 0, 0,
			СтрокаРаздела[СуммаВал + Постфикс] / СтрокаРаздела[СуммаВал]);

	Иначе
		
		Если КурсыВалют = Неопределено Тогда
			КурсыВалют = Новый Соответствие;
		КонецЕсли;
		
		КурсВалюты = КурсыВалют[СтрокаРаздела.Валюта];
		Если КурсВалюты = Неопределено Тогда
			КурсВалюты = КурсВалюты(СтрокаРаздела.Валюта, ДатаКурса(ДатаИнвентаризации));
			КурсыВалют.Вставить(СтрокаРаздела.Валюта, КурсВалюты);
		КонецЕсли;
	
		СтрокаРаздела[СуммаРуб] = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(СтрокаРаздела[СуммаВал],
			Новый Структура("Валюта,Курс,Кратность", СтрокаРаздела.Валюта, КурсВалюты.Курс, КурсВалюты.Кратность),
			Новый Структура("Валюта,Курс,Кратность", ВалютаРегламентированногоУчета, 1, 1));
			
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция КурсВалюты(Знач Валюта, Знач ДатаКурса)
	Возврат 
		РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, ДатаКурса);	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДатаКурса(ДатаИнвентаризации)
	Возврат
		ИнвентаризацияКлиентСервер.ДатаКурсаПересчетаРублевогоЭквивалента(ДатаИнвентаризации);
КонецФункции

#КонецОбласти

&НаКлиенте
Функция ДанныеСтрокиДляРасшифровки()
	
	ДанныеСтрокиДляРасшифровки = Новый Структура;
	ДанныеСтрокиДляРасшифровки.Вставить("Контрагент");
	ДанныеСтрокиДляРасшифровки.Вставить("Договор");
	ДанныеСтрокиДляРасшифровки.Вставить("Счет");
	ДанныеСтрокиДляРасшифровки.Вставить("КПС");
	ДанныеСтрокиДляРасшифровки.Вставить("КФО");
	
	Возврат ДанныеСтрокиДляРасшифровки;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьРасшифровкуСтрокиРаздела(ДанныеСтрокиДляРасшифровки)
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ДатаОтчета", 
		ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(Объект.ДатаИнвентаризации));

	ПараметрыФормы.Вставить("ВидЗадолженности",	
		 ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Кредиторская"));

	ПараметрыФормы.Вставить("ТипЗадолженности",	"Кт301");
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	
	Если ЗначениеЗаполнено(ДанныеСтрокиДляРасшифровки.Договор) Тогда
		ПараметрыФормы.Вставить("Договор", ДанныеСтрокиДляРасшифровки.Договор);
	КонецЕсли;

	ПараметрыФормы.Вставить("Контрагент", ДанныеСтрокиДляРасшифровки.Контрагент);
	
	ПараметрыФормы.Вставить("Расшифровка", Новый Структура);
	ПараметрыФормы.Расшифровка.Вставить("СпособРасшифровки", "ПоСрокамИсполнения");
	ПараметрыФормы.Расшифровка.Вставить("СчетРасчетов", ДанныеСтрокиДляРасшифровки.Счет);
	ПараметрыФормы.Расшифровка.Вставить("КПС", ДанныеСтрокиДляРасшифровки.КПС);
	ПараметрыФормы.Расшифровка.Вставить("КФО", ДанныеСтрокиДляРасшифровки.КФО);
	
	Если ЗначениеЗаполнено(Объект.ИФО) Тогда
		ПараметрыФормы.Расшифровка.Вставить("ИФО", Объект.ИФО);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("ВидимостьКомандВариантовОтчетов", Ложь);
	ПараметрыФормы.Вставить("КлючВарианта", "Основной");
	ПараметрыФормы.Вставить("КлючНазначенияИспользования", "Основной");
	
	ОткрытьФорму("Отчет.АнализЗадолженности.Форма", ПараметрыФормы, ЭтотОбъект, Истина);
	
КонецПроцедуры

