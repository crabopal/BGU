	Для Каждого Строка Из Объект.Раздел1 Цикл
		Строка.КодПодраздела = КодПодраздела("1", Строка.Подраздел);
		Строка.СуммаИтогоВал = Строка.СуммаДолгаВал + Строка.НачисленныеПроцентыВал;
		Строка.СуммаИтогоРуб = Строка.СуммаДолгаРуб + Строка.НачисленныеПроцентыРуб;				
	КонецЦикла;
	Раздел1ИтогСуммаИтогоРуб = Объект.Раздел1.Итог("СуммаИтогоРуб");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиРаздел2()
	Для Каждого Строка Из Объект.Раздел2 Цикл
		Строка.КодПодраздела = КодПодраздела("2", Строка.Подраздел);
		ОбновитьТекстЗаголовкаВСтрокеРаздела2(Строка);
		РасчетСуммИтогоВСтрокеРаздела2(Строка);				
	КонецЦикла;
	ОбновитьИтогиРаздела2(ЭтотОбъект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовкаВСтрокеРаздела2(ДанныеСтроки)
	
	ДанныеСтроки.ЗаголовокСуммаДолга = НСтр("ru = 'Сумма долга:'");
	ДанныеСтроки.ЗаголовокСогласовано = НСтр("ru = 'Согласованная задолженность:'");
	ДанныеСтроки.ЗаголовокНеСогласовано = НСтр("ru = 'Не согласованная задолженность:'");
	ДанныеСтроки.ЗаголовокПросрочено = НСтр("ru = 'Просроченная задолженность:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РасчетСуммИтогоВСтрокеРаздела2(Строка)

	Строка.СуммаИтогоВал = Строка.СуммаДолгаВал + Строка.НачисленныеПроцентыВал;
	Строка.СуммаИтогоРуб = Строка.СуммаДолгаРуб + Строка.НачисленныеПроцентыРуб;				

	Строка.СогласованоИтогоВал = Строка.СуммаДолгаВалСогласовано + Строка.НачисленныеПроцентыВалСогласовано;
	Строка.СогласованоИтогоРуб = Строка.СуммаДолгаРубСогласовано + Строка.НачисленныеПроцентыРубСогласовано;
	
	Строка.СуммаДолгаВалНеСогласовано = Строка.СуммаДолгаВал - Строка.СуммаДолгаВалСогласовано;
	Строка.СуммаДолгаРубНеСогласовано = Строка.СуммаДолгаРуб - Строка.СуммаДолгаРубСогласовано;
	
	Строка.НачисленныеПроцентыВалНеСогласовано = Строка.НачисленныеПроцентыВал
		- Строка.НачисленныеПроцентыВалСогласовано;
	Строка.НачисленныеПроцентыРубНеСогласовано = Строка.НачисленныеПроцентыРуб 
		- Строка.НачисленныеПроцентыРубСогласовано;
	
	Строка.НеСогласованоИтогоВал = Строка.СуммаДолгаВалНеСогласовано + Строка.НачисленныеПроцентыВалНеСогласовано;
	Строка.НеСогласованоИтогоРуб = Строка.СуммаДолгаРубНеСогласовано + Строка.НачисленныеПроцентыРубНеСогласовано;
					
	Строка.ПросроченоИтогоВал = Строка.СуммаДолгаВалПросроченная + Строка.НачисленныеПроцентыВалПросроченная;
	Строка.ПросроченоИтогоРуб = Строка.СуммаДолгаРубПросроченная + Строка.НачисленныеПроцентыРубПросроченная;
					
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьРаздел1(Форма)
	Объект = Форма.Объект;
	Объект.Раздел1.Очистить();
	Форма.Раздел1ИтогСуммаИтогоРуб = 0;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьРаздел2(Форма)
	Объект = Форма.Объект;
	Объект.Раздел2.Очистить();
	ОбновитьИтогиРаздела2(Форма);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтогиРаздела2(Форма)
	
	Объект = Форма.Объект;

	Форма.Раздел2ИтогСуммаИтогоРуб = Объект.Раздел2.Итог("СуммаИтогоРуб");
	Форма.Раздел2ИтогСогласованоИтогоРуб = Объект.Раздел2.Итог("СогласованоИтогоРуб");
	Форма.Раздел2ИтогСуммаДолгаРубНеСогласовано = Объект.Раздел2.Итог("СуммаДолгаРубНеСогласовано");
	Форма.Раздел2ИтогНачисленныеПроцентыРубНеСогласовано = Объект.Раздел2.Итог("НачисленныеПроцентыРубНеСогласовано");
	Форма.Раздел2ИтогНеСогласованоИтогоРуб = Объект.Раздел2.Итог("НеСогласованоИтогоРуб");
	Форма.Раздел2ИтогПросроченоИтогоРуб = Объект.Раздел2.Итог("ПросроченоИтогоРуб");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьРаздел3(Форма)

	Объект = Форма.Объект;

	Объект.Раздел31.Очистить();
	Объект.Раздел32.Очистить();
	Объект.ВыявленыОтклонения = Ложь;
	Объект.ВыявленаНеСогласованнаяЗадолженность = Ложь;
	Объект.ВыявленаПросроченнаяЗадолженность = Ложь;
	
	Форма.Раздел31ИтогСуммаИтогоРуб = 0;
	Форма.Раздел32ИтогНеСогласованоИтогоРуб = 0;
	Форма.Раздел32ИтогПросроченоИтогоРуб = 0;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиРаздел31()
	Для Каждого Строка Из Объект.Раздел31 Цикл
		Строка.КодПодраздела = КодПодраздела("3.1", Строка.Подраздел);
		Строка.СуммаИтогоВал = Строка.СуммаДолгаВал + Строка.НачисленныеПроцентыВал;
		Строка.СуммаИтогоРуб = Строка.СуммаДолгаРуб + Строка.НачисленныеПроцентыРуб;				
	КонецЦикла;
	Раздел31ИтогСуммаИтогоРуб = Объект.Раздел31.Итог("СуммаИтогоРуб");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиРаздел32()
	Для Каждого Строка Из Объект.Раздел32 Цикл
		Строка.КодПодраздела = КодПодраздела("3.2", Строка.Подраздел);
		Строка.НеСогласованоИтогоВал = Строка.СуммаДолгаВалНеСогласовано + Строка.НачисленныеПроцентыВалНеСогласовано;
		Строка.НеСогласованоИтогоРуб = Строка.СуммаДолгаРубНеСогласовано + Строка.НачисленныеПроцентыРубНеСогласовано;
		Строка.ПросроченоИтогоВал = Строка.СуммаДолгаВалПросроченная + Строка.НачисленныеПроцентыВалПросроченная;
		Строка.ПросроченоИтогоРуб = Строка.СуммаДолгаРубПросроченная + Строка.НачисленныеПроцентыРубПросроченная;				
	КонецЦикла;
	Раздел32ИтогНеСогласованоИтогоРуб = Объект.Раздел32.Итог("НеСогласованоИтогоРуб");
	Раздел32ИтогПросроченоИтогоРуб = Объект.Раздел32.Итог("ПросроченоИтогоРуб");
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПревышение(ТекущиеДанные, ПолеКПроверке, ИсходноеПоле, ТекстСообщения = "")
	
	Если ТекущиеДанные[ПолеКПроверке] > ТекущиеДанные[ИсходноеПоле] Тогда
		ТекущиеДанные[ПолеКПроверке] = ТекущиеДанные[ИсходноеПоле];
		Если ЗначениеЗаполнено(ТекстСообщения) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция КодПодраздела(Раздел, Подраздел)
	Возврат	СтрШаблон("%1.%2", Раздел, Формат(Подраздел, "ЧГ=;"));
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам.УстановитьУсловноеОформления(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВопросПриВыбореВидаЗадолженностиАсинх(ВыбранноеЗначение)

	ТекстВопроса = НСтр("ru = 'Вид задолженности изменен.
		|Табличные части всех подразделов раздела 1, 2 и 3 будут очищены. Продолжить?'");
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;		
	
	Объект.ВидЗадолженности = ВыбранноеЗначение;
	ОчиститьРаздел1(ЭтотОбъект);
	ОчиститьРаздел2(ЭтотОбъект);
	ОчиститьРаздел3(ЭтотОбъект);
	УправлениеКомандойПересчетРублевогоЭквивалента(ЭтотОбъект);
	
	Модифицированность = Истина;
		
КонецПроцедуры

&НаСервере
Процедура НастроитьНедоступностьИзмененияКолонок()
	
	НедоступныеКолонки = Новый Массив();

	НедоступныеКолонки.Добавить("СписокСчетовКФО");
	НедоступныеКолонки.Добавить("СписокСчетовСчет");

	НедоступныеКолонки.Добавить("Раздел1НомерСтроки");
	НедоступныеКолонки.Добавить("Раздел1КодПодраздела");
	НедоступныеКолонки.Добавить("Раздел1ГруппаКредиторов");
	НедоступныеКолонки.Добавить("Раздел1КодСтроки");
	НедоступныеКолонки.Добавить("Раздел1Договор");
	НедоступныеКолонки.Добавить("Раздел1НаименованиеДокумента");
	НедоступныеКолонки.Добавить("Раздел1НомерДокумента");
	НедоступныеКолонки.Добавить("Раздел1ДатаДокумента");
	НедоступныеКолонки.Добавить("Раздел1ДатаПогашения");
	НедоступныеКолонки.Добавить("Раздел1Контрагент");
	НедоступныеКолонки.Добавить("Раздел1КФО");
	НедоступныеКолонки.Добавить("Раздел1Счет");
	НедоступныеКолонки.Добавить("Раздел1КПС");
	НедоступныеКолонки.Добавить("Раздел1КодСрокаКредита");
	НедоступныеКолонки.Добавить("Раздел1Валюта");
	НедоступныеКолонки.Добавить("Раздел1СуммаДолгаВал");
	НедоступныеКолонки.Добавить("Раздел1СуммаДолгаРуб");
	НедоступныеКолонки.Добавить("Раздел1НачисленныеПроцентыВал");
	НедоступныеКолонки.Добавить("Раздел1НачисленныеПроцентыРуб");
	НедоступныеКолонки.Добавить("Раздел1СуммаИтогоВал");
	НедоступныеКолонки.Добавить("Раздел1СуммаИтогоРуб");

	ИнвентаризацияСервер.НастроитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтотОбъект, НедоступныеКолонки);
	
	НедоступныеКолонки = Новый Массив();
	НедоступныеКолонки.Добавить("СоставКомиссииСотрудник");
	
	ИнвентаризацияСервер.НастроитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтотОбъект, НедоступныеКолонки, Ложь);
	
КонецПроцедуры

