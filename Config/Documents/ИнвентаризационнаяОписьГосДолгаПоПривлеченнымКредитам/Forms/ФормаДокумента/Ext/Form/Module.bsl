#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРаздел2

&НаКлиенте
Процедура Раздел2ПослеУдаления(Элемент)
	ОбновитьКодСтрокиРаздела2();
	ОбновитьИтогиРаздела2(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Раздел2ПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр)

	Если ПропуститьОбработчикРаздел2ПередНачаломДобавления = Истина Тогда
		Возврат;
	КонецЕсли;		

	Отказ = Истина;
	
	Если Объект.Раздел31.Количество() > 0 Или Объект.Раздел32.Количество() > 0 Тогда
		ВопросПередНачаломДобавленияСтрокРаздела2Асинх(Копирование);
	ИначеЕсли Копирование Тогда
		ПодключитьОбработчикОжидания("ДобавитьСтрокуРаздела2Копированием", 0.1, Истина);
	Иначе	
		ПодключитьОбработчикОжидания("ВыбратьПодразделПередНачаломДобавленияСтрокиАсинх", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Раздел2ПередУдалением(Элемент, Отказ)

	ЕстьДанныеРаздела1 = ЕстьДанныеРаздела1();
	ТребуетОчистки = Объект.Раздел31.Количество() > 0 Или Объект.Раздел32.Количество() > 0;
	Если ЕстьДанныеРаздела1 Или ТребуетОчистки Тогда
		Отказ = Истина;
		ВопросПередУдалениемСтрокРаздела2Асинх(ЕстьДанныеРаздела1, ТребуетОчистки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Раздел2ПередНачаломИзменения(Элемент, Отказ)

	Если Объект.Раздел31.Количество() > 0 Или Объект.Раздел32.Количество() > 0 Тогда
		Отказ = Истина;
		ВопросПередИзменениямСтрокРаздела2Асинх();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Раздел2ПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НоваяСтрока И ОтменаРедактирования Тогда
		ОбновитьИтогиРаздела2(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Раздел2ПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.Раздел2.ТекущиеДанные;

	Если НоваяСтрока Тогда
		ТекущиеДанные.КодСтроки = НовыйКодСтрокиПодраздела2;
	КонецЕсли;

	Если НоваяСтрока И Не Копирование Тогда
		ТекущиеДанные.Подраздел = НовыйПодразделРаздела2;
		ТекущиеДанные.ГруппаКредиторов = НоваяГруппаКредиторовРаздела2;
		ТекущиеДанные.КодПодраздела = КодПодраздела("2", ТекущиеДанные.Подраздел);
		ТекущиеДанные.КФО = ПредопределенноеЗначение("Перечисление.КВД.Бюджет");
		Если Объект.ВидЗадолженности = ПредопределенноеЗначение(
			"Перечисление.ВидыЗадолженностиПоГосДолгу.ВнутреннийДолг") Тогда
			ТекущиеДанные.Валюта = ВалютаРегламентированногоУчета;
		КонецЕсли;
		ОбновитьТекстЗаголовкаВСтрокеРаздела2(ТекущиеДанные);
	КонецЕсли;

	Если Копирование Тогда
		ТекущиеДанные.ДанныеРаздела1 = Ложь;
		ОбновитьИтогиРаздела2(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Раздел2ДоговорПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Раздел2.ТекущиеДанные;

	Если ЗначениеЗаполнено(ТекущиеДанные.Договор) Тогда
		
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("Договор", ТекущиеДанные.Договор);
		ПараметрыЗаполнения.Вставить("ВалютаРегламентированногоУчета", ВалютаРегламентированногоУчета);
		ПараметрыЗаполнения.Вставить("ВидЗадолженности", Объект.ВидЗадолженности);
		ПараметрыЗаполнения.Вставить("ДатаИнвентаризации", Объект.ДатаИнвентаризации);
		ДанныеСтроки = ДанныеСтрокиРаздела2ПриИзмененииДоговора(ПараметрыЗаполнения);
		ВалютаБыла = ТекущиеДанные.Валюта;
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеСтроки);
		Если Объект.ВидЗадолженности = ПредопределенноеЗначение("Перечисление.ВидыЗадолженностиПоГосДолгу.ВнешнийДолг")
			И ВалютаБыла <> ТекущиеДанные.Валюта Тогда
			ПересчетРублевогоЭквивалентаВСтроке(ТекущиеДанные, КурсыВалют, Объект.ДатаИнвентаризации,
				ВалютаРегламентированногоУчета);
			РасчетСуммИтогоВСтрокеРаздела2(ТекущиеДанные);
			ОбновитьИтогиРаздела2(ЭтотОбъект);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Раздел2НаименованиеДокументаОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Раздел2.ТекущиеДанные;
	РедактироватьНаименованиеДокументаАсинх(ТекущиеДанные, "НаименованиеДокумента",
		НСтр("ru='Наименование документа-основания'"));
КонецПроцедуры

