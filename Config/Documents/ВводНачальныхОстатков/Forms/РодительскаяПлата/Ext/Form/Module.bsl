КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСведенияТекущегоРебенкаВОстальныхСтрокахКлиент()
	// Максимальное количество строк для выполнения обработки на клиенте:
	Перем МаксКолвоСтрок;
	
	МаксКолвоСтрок = 40;
	
	// Входная проверка:
	ИмяТаблЧасти = "РодительскаяПлата";
	ТекДанные = Элементы[ИмяТаблЧасти].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	Иначе
		РебенокСсылка = ТекДанные["Ребенок"];
		Если НЕ ЗначениеЗаполнено(РебенокСсылка) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ТиражируемыеКолонки = Новый Структура("СтавкаОплаты, Льгота, ДатаВключения");
	ЗаполнитьЗначенияСвойств(ТиражируемыеКолонки, ТекДанные);
	Если Объект[ИмяТаблЧасти].Количество() > МаксКолвоСтрок Тогда
		// Выполняем обработку на сервере.
		ОбновитьСведенияТекущегоРебенкаВОстальныхСтрокахСервер(ИмяТаблЧасти, РебенокСсылка, ТиражируемыеКолонки);
	Иначе
		// Выполняем обработку на клиенте.
		Поиск = Новый Структура("Ребенок", РебенокСсылка);
		МассивСтрок = Объект[ИмяТаблЧасти].НайтиСтроки(Поиск);
		Для Каждого СтрокаТЧ Из МассивСтрок Цикл
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, ТиражируемыеКолонки);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура ОбновитьСведенияТекущегоРебенкаВОстальныхСтрокахСервер(ИмяТаблЧасти, РебенокСсылка, ТиражируемыеКолонки);
	
	Поиск = Новый Структура("Ребенок", РебенокСсылка);
	МассивСтрок = Объект[ИмяТаблЧасти].НайтиСтроки(Поиск);
	Для Каждого СтрокаТЧ Из МассивСтрок Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ТиражируемыеКолонки);
	КонецЦикла;
	
КонецПроцедуры

