&НаКлиенте
Функция НеобходимыеРеквизитыЗаполнены()
	
	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""Организация"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.Организация");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""Дата"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.Дата");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПодтвердитьИзменениеТабличнойЧасти(ИмяТЧ, СинонимТЧ, ТекстВопроса = "", ИмяКоманды = "")
	
	// Есть ли в проверяемой табл.части строки?
	ТаблЧасть = Объект[ИмяТЧ];
	Если ТаблЧасть.Количество() = 0 Тогда
		Результат = Истина;
		
	Иначе
		Результат = Ложь;
		Если ПустаяСтрока(ТекстВопроса) Тогда
			ТекстВопроса = НСтр("ru='Очистить табличную часть %1?'");
		КонецЕсли;
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, СинонимТЧ);
		
		ПараметрыОповещения = Новый Структура();
		ПараметрыОповещения.Вставить("ИмяКоманды", ИмяКоманды);
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПодтвердитьИзменениеТабличнойЧасти_Ответ", ЭтотОбъект, ПараметрыОповещения);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
&НаКлиенте
Процедура ПодтвердитьИзменениеТабличнойЧасти_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Если ПараметрыОповещения["ИмяКоманды"] = "ЗаполнитьСпискомДетейИзГруппы" Тогда
			ЗаполнитьСпискомДетейИзГруппыКлиент();
			
		ИначеЕсли ПараметрыОповещения["ИмяКоманды"] = "ЗаполнитьСпискомДетейЕщеНеЗачисленныхВГруппы" Тогда
			ЗаполнитьСпискомДетейЕщеНеЗачисленныхВГруппыКлиент();
			
		ИначеЕсли ПараметрыОповещения["ИмяКоманды"] = "ЗаполнитьСпискомВсехДетей" Тогда
			ЗаполнитьСпискомВсехДетейКлиент();
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

