КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ЗаголовокФормы = "Ввод начальных остатков по БСО ";
	Если Объект.Ссылка.Пустая() Тогда
		ЗаголовокФормы = ЗаголовокФормы + "(создание)";
	Иначе
		ЗаголовокФормы = ЗаголовокФормы + Объект.Номер + " от " + Объект.Дата;
	КонецЕсли;
	ЭтаФорма.Заголовок = ЗаголовокФормы;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	// Заполняем по возможности пустые поля формы:
	Если Объект.Ссылка.Пустая() Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Счет) Тогда
			Объект.Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("03.1");
		КонецЕсли;
		
		Объект.ВидПервичногоДокумента = НСтр("ru='Инвентаризационная опись'");

		Попытка
			ЭтаФорма.ТиповаяОперация = Справочники.ТиповыеОперации.ВводНачальныхОстатков_БСО;
		Исключение
		КонецПопытки;
		
		Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьЗаголовокФормы();
	
	
	Если ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента") Тогда
		Элементы.ГруппаСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;
	ЗаполнитьДлиныНомеров();
	
	Элементы["ПодразделениеОрганизации"].Видимость = Документы.ВводНачальныхОстатков.ПодразделениеОбязательноКЗаполнению(Объект);
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()

	Элементы.ЦМО.Доступность						= ЗначениеЗаполнено(Объект.Организация);
	Элементы.ПодразделениеОрганизации.Доступность	= ЗначениеЗаполнено(Объект.Организация);

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()

&НаКлиенте
Процедура УстановитьМаскуПолейПорядковогоНомера(ДлинаНомера)

	#Если НЕ ВебКлиент Тогда
	УправлениеМатериальнымиЗапасамиКлиент.УстановитьМаскуПолейПорядковогоНомера(ДлинаНомера,
																				Элементы.СоставБСОНомерНачальный,
																				Элементы.СоставБСОНомерКонечный);
	#КонецЕсли
																				
КонецПроцедуры // УстановитьМаскуПолейПорядковогоНомера()
 
&НаСервере
Процедура ЗаполнитьДлиныНомеров()

	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Объект.СоставБСО.Выгрузить().ВыгрузитьКолонку("БСО"), "ДлинаНомера");
	Для каждого ТекСтр Из Объект.СоставБСО Цикл
	
		Попытка
			ДлинаНомера = ЗначенияРеквизитов[ТекСтр.БСО].ДлинаНомера;
		Исключение
			ДлинаНомера = 0;
		КонецПопытки;
		ТекСтр.ДлинаНомера = ДлинаНомера;
	
	КонецЦикла; 	

КонецПроцедуры // ЗаполнитьДлиныНомеров()

&НаСервереБезКонтекста
Функция ПолучитьДлинуНомера(БСОСсылка)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(БСОСсылка, "ДлинаНомера");
	
КонецФункции

