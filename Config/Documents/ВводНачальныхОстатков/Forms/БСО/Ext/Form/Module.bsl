#Область ОбработчикиСобытийЭлементовТаблицыФормы_СоставБСО

&НаКлиенте
Процедура СоставБСОПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элемент.ТекущиеДанные;
	УстановитьМаскуПолейПорядковогоНомера(ТекущиеДанные.ДлинаНомера);
КонецПроцедуры

&НаКлиенте
Процедура СоставБСОНомерНачальныйПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СоставБСО.ТекущиеДанные;
	УправлениеМатериальнымиЗапасамиКлиент.ОтформатироватьВведенныйНомерБСО(ТекущиеДанные, "НомерНачальный", Истина);
КонецПроцедуры

&НаКлиенте
Процедура СоставБСОНомерКонечныйПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СоставБСО.ТекущиеДанные;
	УправлениеМатериальнымиЗапасамиКлиент.ОтформатироватьВведенныйНомерБСО(ТекущиеДанные, "НомерКонечный", Истина);
КонецПроцедуры

&НаКлиенте
Процедура СоставБСОКоличествоПриИзменении(Элемент)
	ТекущиеДанные = Элементы.СоставБСО.ТекущиеДанные;
	УправлениеМатериальнымиЗапасамиКлиент.ЗаполнитьНомерКонечныйПоНомеруНачальномуИКоличеству(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура СоставБСОБСОНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОткрытьФорму("Справочник.БСО.ФормаВыбора", Новый Структура("ТребуемыеДанные", "ДлинаНомера"), Элемент);
	СтандартнаяОбработка = 0;
КонецПроцедуры

&НаКлиенте
Процедура СоставБСОБСОПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СоставБСО.ТекущиеДанные;
	Если Не ВыборБСООбработан Тогда
		ТекущиеДанные.ДлинаНомера = ПолучитьДлинуНомера(ТекущиеДанные.БСО);
	КонецЕсли;
	УстановитьМаскуПолейПорядковогоНомера(ТекущиеДанные.ДлинаНомера);
	ВыборБСООбработан = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставБСОБСООбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	УправлениеМатериальнымиЗапасамиКлиент.ОбработатьВыборБСО(ВыбранноеЗначение, Элементы.СоставБСО.ТекущиеДанные, ВыборБСООбработан);
КонецПроцедуры

#КонецОбласти

