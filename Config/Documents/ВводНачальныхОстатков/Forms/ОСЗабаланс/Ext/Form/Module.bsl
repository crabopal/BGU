&НаКлиенте
Перем ТекстЗаголовкаСообщений;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Ввод начальных остатков ОС забаланс'");
	
	НастроитьФормуКлиент();
	
	ВводНачальныхОстатковКлиент.ПриОткрытии(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если Не ИнициализацияВыполнена Тогда
		ИнициализацияФормы();
	КонецЕсли;
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	УстановитьЗаголовокФормы();
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	// Оповещаем форму Помощника ввода начальных остатков:
	ИмяСобытия = "ЗаписанДокументВводНачальныхОстатков";
	Параметр = Объект["Организация"];
	Оповестить(ИмяСобытия, Параметр);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаВводаОстатковПриИзменении(Элемент)
	
	// Необходимый код следует размещать в следующих процедурах:
	//	- ДатаДокументаПриИзменении_ПодтвержденоИзменениеСоставаГруппСчетов
	//	- ДатаДокументаПриИзменении_ИзменениеСоставаГруппСчетовНеТребуется
	
	// Эти процедуры вызываются далее автоматически, после анализа данных и ответа пользователя.
	
	ВводНачальныхОстатковКлиент.ДатаДокументаПриИзменении_ПроверитьНеобходимостьИзмененияСоставаГруппСчетов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	БухгалтерскийУчетКлиент.ОбработатьВыборКФО(Объект.Организация,
											   Объект.ИФО,
											   Объект.КФО,
											   ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(Объект["Дата"]));
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаКлиенте
Процедура СчетПриИзменении(Элемент)
	
	ОбновитьВидУчетаНФА();
	
	ОграничитьСписокВыбораСчета(ЭтаФорма);
	
	СчетПриИзмененииСервер();
	
	НастроитьФормуКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		
		// Кэшируем свойства счета:
		ОбновитьКэшФормыСервер(ВыбранноеЗначение);
		
	Иначе
		
		БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(ВыбранноеЗначение,
			Объект.КПС, Объект.КФО, Объект.КЭК);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидУчетаПриИзменении(Элемент)
	
	ОчиститьСчет();
	
	УстановитьСчетЕслиОнЕдинственный();
	
	ОбновитьКэшФормыСервер();
	
	ОграничитьСписокВыбораСчета(ЭтаФорма);
	
	НастроитьФормуКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидУчетаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВидУчетаНФА = ВыбранноеЗначение Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ОСОсновная

&НаКлиенте
Процедура ОС_ОсновнаяКоличествоПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РасчетСуммы(ТекДанные, "Количество");
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяПервоначальнаяСтоимостьПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РасчетСуммы(ТекДанные, "ПервоначальнаяСтоимость");
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяСуммаПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РасчетСуммы(ТекДанные, "Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяСостояниеОСПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	СостояниеОС = ТекДанные["СостояниеОС"];
	
	Если НЕ СостояниеОС = ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию") Тогда
		ТекДанные["ВводВЭксплуатациюОдновременноСПринятиемКУчету"] = Ложь;
		
		Если НЕ ЗначениеЗаполнено(СостояниеОС) Тогда
			ТекДанные["ДатаВводаВЭксплуатацию"]					= Дата(1,1,1);
			ТекДанные["НазваниеДокументаВводаВЭксплуатацию"]	= "";
			ТекДанные["НомерДокументаВводаВЭксплуатацию"]		= "";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОС_ОсновнаяСостояниеОСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеВыбора = Новый СписокЗначений();
	ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию"));
	ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияОС.ПринятоКУчету"));
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяВводВЭксплуатациюОдновременноСПринятиемКУчетуПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	
	Если ТекДанные["ВводВЭксплуатациюОдновременноСПринятиемКУчету"] Тогда
		ТекДанные["ДатаВводаВЭксплуатацию"]					= ТекДанные["ДатаПринятияКУчету"];
		ТекДанные["НазваниеДокументаВводаВЭксплуатацию"]	= ТекДанные["НазваниеДокументаПринятияКУчету"];
		ТекДанные["НомерДокументаВводаВЭксплуатацию"]		= ТекДанные["НомерДокументаПринятияКУчету"];
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СнятьПризнакАгрегатора(Команда)
	
	ВводНачальныхОстатковКлиент.СнятьПризнакАгрегатора(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуБГУ(Команда)
	
	ОбщегоНазначенияБГУКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Объект);
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализацияФормы()
	
	Если ИнициализацияВыполнена Тогда
		Возврат;
	КонецЕсли;
	
	ПравоДоступаИзменение = ПравоДоступа("Изменение", Объект.Ссылка.Метаданные());
	
	//---
	// КЭК0
	//---
	КЭК0 = БухгалтерскийУчетПовтИсп.КЭК0();
	УстановитьЗначениеКЭК = Ложь;
	
	// Заполняем по возможности пустые поля формы:
	Если Объект.Ссылка.Пустая() Тогда
		
		Попытка
			ЭтаФорма.ТиповаяОперация = Справочники.ТиповыеОперации.ВводНачальныхОстатков_ОСВОперУчете;
		Исключение
		КонецПопытки;
		
		Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
		КонецЕсли;
		
		УстановитьЗначениеКЭК = (НЕ ЗначениеЗаполнено(Объект.КЭК));
		
	КонецЕсли;
	
	ПроконтролироватьЗначениеКЭКСервер(УстановитьЗначениеКЭК);
	
	НастроитьФормуСервер_ПоГруппеСчетов();
	
	ИнициализацияВыполнена = Истина;
	
	ДатыИзмененияСоставаГруппСчетов = ВводНачальныхОстатковКлиентСервер.ПолучитьДатыИзмененияСоставаГруппСчетов_ОСЗабаланс();
	ВводНачальныхОстатковКлиентСервер.ОбновитьКэшДатаДокумента(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ЗаголовокФормы = "Ввод начальных остатков ОС на забалансовых счетах";
	Если Объект.Ссылка.Пустая() Тогда
		ЗаголовокФормы = ЗаголовокФормы + " (создание)";
	Иначе
		ЗаголовокФормы = ЗаголовокФормы + " " + Объект.Номер + " от " + Объект.Дата;
	КонецЕсли;
	ЭтаФорма.Заголовок = ЗаголовокФормы;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьЗаголовокФормы();
	
	Если Не ИнициализацияВыполнена Тогда
		ИнициализацияФормы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент()
	
	РазрешитьРаботуСФормой = ЗначениеЗаполнено(Объект.Организация)
		И ЗначениеЗаполнено(Объект.Счет)
		И ПравоДоступаИзменение;
	
	Элементы["ОС_Основная"].ТолькоПросмотр = Не РазрешитьРаботуСФормой;
	
	НастроитьФормуКлиент_ПоСчету();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОграничитьСписокВыбораСчета(Форма)
	
	ВидУчетаНФА		= Форма["ВидУчетаНФА"];
	ТаблицаСчетов	= Форма["ТаблицаСчетов"];
	Элементы		= Форма.Элементы;
	
	ЗаполненВидУчетаНФА = ЗначениеЗаполнено(ВидУчетаНФА);
	
	МассивСчетов = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСчетов Цикл
		Если ЗаполненВидУчетаНФА Тогда
			Если НЕ ВидУчетаНФА = СтрокаТаблицы["ВидУчетаНФА"] Тогда
				Продолжить;
			КонецЕсли;
			
			МассивСчетов = СтрокаТаблицы["МассивСчетов"];
		Иначе
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСчетов, СтрокаТаблицы["МассивСчетов"]);
		КонецЕсли;
	КонецЦикла;
	
	НовыйМассив = Новый Массив();
	
	НовыйПараметр = Новый ПараметрВыбора("ОграниченияСписокСчетов", МассивСчетов);
	НовыйМассив.Добавить(НовыйПараметр);
	
	НовыйПараметр = Новый ПараметрВыбора("НаДату", ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(Форма.Объект["Дата"]));
	НовыйМассив.Добавить(НовыйПараметр);
	
	Элементы["Счет"].ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСчет()
	
	ОчищающаяСтруктура = Новый Структура("Счет, КПС, КЭК");
	
	ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСчетЕслиОнЕдинственный()
	
	ТекущаяСтрока = ПолучитьТекущуюСтрокуТаблицыСчетов();
	
	Если ТекущаяСтрока <> Неопределено Тогда
		МассивСчетов = ТекущаяСтрока["МассивСчетов"];
		
		Если МассивСчетов.Количество() = 1 Тогда
			Объект["Счет"] = МассивСчетов[0];
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТекущуюСтрокуТаблицыСчетов()
	
	Для Каждого СтрокаТаблицы Из ТаблицаСчетов Цикл
		Если СтрокаТаблицы["ВидУчетаНФА"] = ВидУчетаНФА Тогда
			Возврат СтрокаТаблицы;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОпределитьВидУчетаНФАПоСчету(Форма)
	
	Счет			= Форма.Объект["Счет"];
	ТаблицаСчетов	= Форма["ТаблицаСчетов"];
	
	Если ЗначениеЗаполнено(Счет) Тогда
		// Ищем среди допустимых видов учета
		
		Для Каждого СтрокаТаблицы Из ТаблицаСчетов Цикл
			
			СчетНайден = (СтрокаТаблицы["МассивСчетов"].Найти(Счет) <> Неопределено);
			
			Если СчетНайден Тогда
				Возврат СтрокаТаблицы["ВидУчетаНФА"];
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Берем жестко вид учета, если он допустим всего один
	Если ТаблицаСчетов.Количество() = 1 Тогда
		Возврат ТаблицаСчетов[0]["ВидУчетаНФА"];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ОбновитьКэшФормыСервер(Знач СчетСсылка = Неопределено)
	
	Если СчетСсылка = Неопределено Тогда
		СчетСсылка = Объект["Счет"];
	КонецЕсли;
	
	КэшФормы = ПолучитьКэшФормы(СчетСсылка);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, КэшФормы);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКэшФормы(СчетСсылка)
	
	УчетПоПодразделениям			= Ложь;
	УчетПоКПС						= Ложь;
	УчетПоКЭК						= Ложь;
	ЕстьСубконтоКонтрагент			= Ложь;
	ВводПустыхСубконтоКонтрагент	= Ложь;
	ЕстьСубконтоДоговоры			= Ложь;
	ВводПустыхСубконтоДоговоры		= Ложь;
		
	Если ЗначениеЗаполнено(СчетСсылка) Тогда
		СвойстваСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетСсылка, "УчетПоПодразделениям,УчетПоКПС,УчетПоКЭК");
		
		УчетПоПодразделениям = СвойстваСчета["УчетПоПодразделениям"];
		УчетПоКПС = СвойстваСчета["УчетПоКПС"];
		УчетПоКЭК = СвойстваСчета["УчетПоКЭК"];
		СубконтоКонтрагент = СчетСсылка.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
		СубконтоДоговоры = СчетСсылка.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
		
		Если СубконтоКонтрагент = Неопределено Тогда
			ЕстьСубконтоКонтрагент			= Ложь;
			ВводПустыхСубконтоКонтрагент	= Ложь;
		Иначе
			ЕстьСубконтоКонтрагент			= Истина;
			ВводПустыхСубконтоКонтрагент	= НЕ СубконтоКонтрагент.Обязательный;
		КонецЕсли;
		
		Если СубконтоДоговоры = Неопределено Тогда
			ЕстьСубконтоДоговоры		= Ложь;
			ВводПустыхСубконтоДоговоры	= Ложь;
		Иначе
			ЕстьСубконтоДоговоры		= Истина;
			ВводПустыхСубконтоДоговоры	= НЕ СубконтоДоговоры.Обязательный;
		КонецЕсли;
	КонецЕсли;
	
	КэшФормы = Новый Структура;
	КэшФормы.Вставить("Счет_УчетПоПодразделениям",		УчетПоПодразделениям);
	КэшФормы.Вставить("Счет_УчетПоКПС",					УчетПоКПС);
	КэшФормы.Вставить("Счет_УчетПоКЭК",					УчетПоКЭК);
	КэшФормы.Вставить("Счет_ЕстьСубконтоКонтрагент",	ЕстьСубконтоКонтрагент);
	КэшФормы.Вставить("ВводПустыхСубконтоКонтрагент",	ВводПустыхСубконтоКонтрагент);
	КэшФормы.Вставить("Счет_ЕстьСубконтоДоговоры",		ЕстьСубконтоДоговоры);
	КэшФормы.Вставить("ВводПустыхСубконтоДоговоры",		ВводПустыхСубконтоДоговоры);
	
	Возврат КэшФормы;
	
КонецФункции

// ЧтоИзменилось - одна из строк "Количество", "Цена", "Сумма".
&НаКлиенте
Процедура РасчетСуммы(ТекДанные, ЧтоИзменилось)
	
	Если ЧтоИзменилось = "Количество" ИЛИ ЧтоИзменилось = "ПервоначальнаяСтоимость" Тогда
		ТекДанные.Сумма = ТекДанные.Количество * ТекДанные.ПервоначальнаяСтоимость;
		
	ИначеЕсли ЧтоИзменилось = "Сумма" Тогда
		ТекДанные.ПервоначальнаяСтоимость = ?(ТекДанные.Количество = 0,
			0,
			ТекДанные.Сумма / ТекДанные.Количество);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаДокументаПриИзменении_ИзменениеСоставаГруппСчетовНеТребуется(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	ДатаПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаДокументаПриИзменении_ПодтвержденоИзменениеСоставаГруппСчетов(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора <> КодВозвратаДиалога.Да Тогда
		ВводНачальныхОстатковКлиентСервер.ВосстановитьИзКэшаДатаДокумента(ЭтаФорма);
		
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Истина;
	
	ВводНачальныхОстатковКлиентСервер.ОбновитьКэшДатаДокумента(ЭтаФорма);
	
	ДатаПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииСервер()
	
	НастроитьФормуСервер_ПоГруппеСчетов();
	
	Если НЕ ЗначениеЗаполнено(ВидУчетаНФА) Тогда
		Объект["Счет"] = Неопределено;
	
		СчетПриИзмененииСервер();
	КонецЕсли;
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ПоГруппеСчетов()
	
	ТаблицаСчетов.Загрузить(Документы.ВводНачальныхОстатков.ОСНаЗабалансовыхСчетах_ПолучитьТаблицуСчетов(Объект));
	
	ВидУчетаНФА = ОпределитьВидУчетаНФАПоСчету(ЭтаФорма);
	
	ОграничитьСписокВыбораСчета(ЭтаФорма);
	
	НастроитьФормуСервер_ПоСчету();
	
КонецПроцедуры

//---
// Обработчики событий элементов формы

&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение = Неопределено)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОрганизацияПередИзменениемКлиент_Ответ", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении,
		НСтр("ru='Изменение организации вызовет очистку
		|некоторых полей шапки и табличной части документа.
		|
		|Продолжить и сменить организацию?'"),
		РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Объект["Организация"] = ПараметрыОповещения["ВыбранноеЗначение"];
		ЭтаФорма.Модифицированность = Истина;
		ОрганизацияПриИзмененииКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПриИзмененииКлиент()
	
	ОрганизацияПриИзмененииСервер();
	
	НастроитьФормуКлиент();
	
КонецПроцедуры
&НаСервере
Процедура ОрганизацияПриИзмененииСервер()
	
	ОчиститьРеквизитыТабличнойЧастиНесоответствующиеОрганизации();
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры
&НаСервере
Процедура ОчиститьРеквизитыТабличнойЧастиНесоответствующиеОрганизации()
	
	// Очищаем полностью ТЧ "ОС Основная":
	Объект.ОС_Основная.Очистить();
	
	// Устанавливаем новую дату документа:
	Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьНеиспользуемуюАналитику()
	
	Если НЕ Счет_ЕстьСубконтоКонтрагент Тогда
		Объект.Контрагент = Неопределено;
	КонецЕсли;
	
	Если НЕ Счет_ЕстьСубконтоДоговоры Тогда
		Объект.Договор = Неопределено;
	КонецЕсли;
	
	Если НЕ Счет_УчетПоКПС Тогда
		Объект.КПС = Неопределено;
	КонецЕсли;
	
	Если НЕ Счет_УчетПоКЭК Тогда
		Объект.КЭК = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент_ПоСчету()
	
	Элементы["Контрагент"].Доступность = Счет_ЕстьСубконтоКонтрагент ИЛИ Счет_ЕстьСубконтоДоговоры;
	Элементы["Договор"].Доступность = Счет_ЕстьСубконтоДоговоры;
	Элементы["КПС"].Доступность = Счет_УчетПоКПС;
	Элементы["КЭК"].Доступность = Счет_УчетПоКЭК;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ПоСчету()
	
	ОбновитьКэшФормыСервер();
	
	Элементы["ПодразделениеОрганизации"].АвтоОтметкаНезаполненного = Документы.ВводНачальныхОстатков.ПодразделениеОбязательноКЗаполнению(Объект);
	
	Элементы["Контрагент"].АвтоОтметкаНезаполненного = Счет_ЕстьСубконтоКонтрагент И НЕ ВводПустыхСубконтоКонтрагент;
	Элементы["Договор"].АвтоОтметкаНезаполненного = Счет_ЕстьСубконтоДоговоры И НЕ ВводПустыхСубконтоДоговоры;
	
КонецПроцедуры

&НаСервере
Процедура СчетПриИзмененииСервер()
	
	НастроитьФормуСервер_ПоСчету();
	
	ОчиститьНеиспользуемуюАналитику();
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидУчетаНФА()
	
	НовоеЗначение = ОпределитьВидУчетаНФАПоСчету(ЭтаФорма);
	
	ИзменилосьЗначение = (ВидУчетаНФА <> НовоеЗначение);
	
	Если ИзменилосьЗначение Тогда
		ВидУчетаНФА = НовоеЗначение;
	КонецЕсли;
	
КонецПроцедуры

//---
// КЭК0
//---

&НаСервере
Процедура ПроконтролироватьЗначениеКЭКСервер(УстановитьНовоеЗначение = Ложь)
	
	Перем НовоеЗначениеКЭК;
	
	НеобходимоИзменитьЗначениеКЭК = Документы.ВводНачальныхОстатков.НеобходимоИзменитьЗначениеКЭК(
		Объект["Организация"],
		Объект["ИФО"],
		Объект["КФО"],
		Объект["Дата"],
		Объект["Счет"],
		Объект["КЭК"],
		"Дт",
		ЭтаФорма["ИспользоватьКЭК0"],
		НовоеЗначениеКЭК);
		
	Если НЕ НеобходимоИзменитьЗначениеКЭК ИЛИ НЕ УстановитьНовоеЗначение Тогда
		Возврат;
	КонецЕсли;
	
	Объект["КЭК"] = НовоеЗначениеКЭК;
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТиповыхОпераций

