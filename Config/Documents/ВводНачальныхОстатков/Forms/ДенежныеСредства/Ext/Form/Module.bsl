Процедура СчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
															Объект.КПС,
															Объект.КФО,
															Объект.КЭК);
															
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	БухгалтерскийУчетКлиент.ОбработатьВыборКФО(Объект.Организация,
											   Объект.ИФО,
											   Объект.КФО,
											   ПолучитьДату());
											   
	КФОПриИзмененииКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура КПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													Объект.КПС, 
													Объект.Организация,
													Объект.ИФО,
													Объект.КФО,
													Объект.Счет,
													ПолучитьДату());
													
КонецПроцедуры

&НаКлиенте
Процедура КЭКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.Счет) Тогда
		ТекстСообщения = НСтр("ru='Не заполнен счет.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.Счет");
		Возврат;
	КонецЕсли;
	
	Если ИспользоватьКЭК0 Тогда
		//---
		// КЭК0
		//---
		ОграниченияКЭК = Новый Массив();
		ОграниченияКЭК.Добавить(КЭК0);
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент,
								СтандартнаяОбработка,
								,//КЭК,
								,//Организация,
								,//ИФО,
								,//КФО,
								,//Счет,
								,//Дата,
								,//"Дт",
								ОграниченияКЭК);
	Иначе
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент,
									СтандартнаяОбработка,
									Объект.КЭК,
									Объект.Организация,
									Объект.ИФО,
									Объект.КФО,
	                                Объект.Счет,
									ПолучитьДату(),
									"Дт");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	
	ВалютаПриИзмененииСервер();
	
	СравнитьСуммыШапкиИТаблицы();
	
