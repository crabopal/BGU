&НаКлиенте
Процедура ДенежныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ЗаполнитьСуммыВСтроке();
		
		СравнитьСуммыШапкиИТаблицы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДенежныеСредстваВалютнаяСуммаПриИзменении(Элемент)
	
	ТекДанные = Элементы["ДенежныеСредства"].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные["Сумма"] = ПолучитьРублевуюСумму(
							ТекДанные["ВалютнаяСумма"],
							ИспользоватьВалютныйУчет,
							Объект["Курс"],
							Объект["Кратность"]);
	
КонецПроцедуры

