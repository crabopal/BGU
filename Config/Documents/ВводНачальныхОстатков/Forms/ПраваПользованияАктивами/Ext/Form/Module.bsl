&НаСервере
Процедура ИнициализироватьФормуСервер()
	
	КонтролироватьВводимыеСуммы = Истина;
	
	ИменаПараметровАмортизацииПоДоговоруВЦелом = Документы.ВводНачальныхОстатков.ПолучитьИменаПараметровАмортизацииПоДоговоруВЦелом();
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если Объект.Ссылка.Пустая() И НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
			// Для нового документа заполняем дату.
			Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
		КонецЕсли;
		
		Объект.ПараметрыАмортизацииУстановленыПоДоговоруВЦелом = Истина;
		
		Объект.КЭКДоходов = БухгалтерскийУчетПовтИсп.КЭКПоКоду("182");
		
		КЭКРасходов = БухгалтерскийУчетПовтИсп.КЭКПоКоду("224");
		
	КонецЕсли;
	
	Если Объект.ПараметрыАмортизацииУстановленыПоДоговоруВЦелом Тогда
		
		ИнициализироватьОбщиеПараметрыАмортизацииПоДоговоруВЦелом();
		
	Иначе
		
		ИнициализироватьКолонкиДоступностиАналитикиСчетРасходов();
		
	КонецЕсли;
	
	Если НЕ УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетПравПользованияПоПодразделениям() Тогда
		
		Элементы["ПраваПользованияПодразделение"].Видимость = Ложь;
		
	КонецЕсли;
	
	НастроитьФормуСервер_ПоВидуОперации();
	
	НастроитьФормуСервер_ПоРежимуУказанияАмортизации();
	
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	
	УстановитьУсловноеОформление();
	
	УстановитьЗаголовокФормы();
	
	ИнициализацияВыполнена = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	Если Объект.Ссылка.Пустая() Тогда
		
		Параметр1 = "(создание)";
		
	Иначе
		
		Параметр1 = Объект.Номер + " от " + Объект.Дата;
		
	КонецЕсли;
	
	ЭтаФорма.Заголовок = СтрШаблон("Ввод остатков прав пользования ОС, НПА %1", Параметр1);
	
КонецПроцедуры

