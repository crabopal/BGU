	Элементы["ФормаКонтролироватьВводимыеСуммы"].Пометка = КонтролироватьВводимыеСуммы;
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ВидНФА"		, ПредопределенноеЗначение("Перечисление.ВидыНФА.ПраваПользованияИмуществом"));
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения"	, "ПринятиеКУчету");
	ПараметрыПодбора.Вставить("СкрытьКолонки"	, "ГрупповойУчет,ИнвентарныйНомер,Количество");
	
	Если Объект.ПраваПользования.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОССервер(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()

	ТаблицаОС = Объект.ПраваПользования.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);

КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОССервер(Знач ВыбранноеЗначение)
	
	ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
	
	ИсходныеДанные = Объект.ПраваПользования.Выгрузить();
	ИсходныеДанные.Индексы.Добавить("ОсновноеСредство");
	
	Объект.ПраваПользования.Очистить();
	
	Для Каждого СтрокаТаблицыОС Из ТаблицаОС Цикл
		
		ЭлементКоллекции = Объект.ПраваПользования.Добавить();
		
		СтрокаИсходныхДанных = ИсходныеДанные.Найти(СтрокаТаблицыОС.ОсновноеСредство, "ОсновноеСредство");
		
		Если СтрокаИсходныхДанных <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаИсходныхДанных);
		КонецЕсли;
			
		ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаТаблицыОС);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПоляАналитикиСчетаРасходов()
	
	ПоляАналитики = Новый Структура();
	ПоляАналитики.Вставить("Счет",			"Объект.ПраваПользования.СчетРасходов");
	ПоляАналитики.Вставить("Субконто1",		"Объект.ПраваПользования.СубконтоРасходов1");
	ПоляАналитики.Вставить("Субконто2",		"Объект.ПраваПользования.СубконтоРасходов2");
	ПоляАналитики.Вставить("Субконто3",		"Объект.ПраваПользования.СубконтоРасходов3");
	ПоляАналитики.Вставить("КПС",			"Объект.ПраваПользования.КПСРасходов");
	ПоляАналитики.Вставить("КЭК",			"Объект.ПраваПользования.КЭКРасходов");
	ПоляАналитики.Вставить("Подразделение",	"Объект.ПраваПользования.ПодразделениеРасходов");
	
	Возврат ПоляАналитики;
	
КонецФункции

&НаСервере
Процедура ВидОперацииПриИзмененииСервер()
	
	ИнициализироватьОтложенныеДоходы();
	
	НастроитьФормуСервер_ПоВидуОперации();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьОтложенныеДоходы()
	
	ЭтоПоступлениеВАренду = (Объект.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду);
	
	ЭтоПоступлениеВБезвозмездноеПользование = (Объект.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
	
	// Шапка
	
	Если ЭтоПоступлениеВАренду Тогда
		
		ОчищающаяСтруктура = Новый Структура("
			|СчетДБП,
			|КПСДоходов,
			|КЭКДоходов,
			|Номенклатура,
			|СчетДоходов,
			|СубконтоДоходов1,
			|СубконтоДоходов2,
			|СубконтоДоходов3,
			|ВидДеятельностиНУ,
			|СчетДоходовНУ,
			|СтатьяПрочихДоходовНУ");
		
		ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
		
	КонецЕсли;
	
	// Табличная часть
	
	Для Каждого СтрокаТаблицы Из Объект.ПраваПользования Цикл
		
		Если ЭтоПоступлениеВАренду Тогда
			
			СтрокаТаблицы.ОтложенныйДоход = 0;
			
		ИначеЕсли ЭтоПоступлениеВБезвозмездноеПользование Тогда
			
			СтрокаТаблицы.ОтложенныйДоход = СтрокаТаблицы.БалансоваяСтоимость;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ПоВидуОперации()
	
	ЭтоПоступлениеВАренду					= (Объект.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду);
	ЭтоПоступлениеВАрендуНаЛьготныхУсловиях	= (Объект.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях);
	ЭтоПоступлениеВБезвозмездноеПользование	= (Объект.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
	
	ВидимостьОтложенныхДоходов	= (ЭтоПоступлениеВАрендуНаЛьготныхУсловиях ИЛИ ЭтоПоступлениеВБезвозмездноеПользование);
	ВидимостьСчетаРасчетов		= (ЭтоПоступлениеВАренду ИЛИ ЭтоПоступлениеВАрендуНаЛьготныхУсловиях);
	
	Элементы["ПраваПользованияНадписьОтложенныйДоход"].Видимость	= ВидимостьОтложенныхДоходов;
	Элементы["ПраваПользованияОтложенныйДоход"].Видимость			= ВидимостьОтложенныхДоходов;
	Элементы["ПраваПользованияКПСДоходов"].Видимость				= ВидимостьОтложенныхДоходов;
	Элементы["ПраваПользованияКФОДоходов"].Видимость				= ВидимостьОтложенныхДоходов;
	Элементы["ПраваПользованияСчетДБП"].Видимость					= ВидимостьОтложенныхДоходов;
	Элементы["ПраваПользованияКЭКДоходов"].Видимость				= ВидимостьОтложенныхДоходов;
	
	Элементы["ГруппаОтложенныеДоходы"].Видимость					= ВидимостьОтложенныхДоходов;
	
	Элементы["ПраваПользованияИтогОтложенныеДоходы"].Видимость		= ВидимостьОтложенныхДоходов;
	
	
	Элементы["ПраваПользованияСчетРасчетов"].Видимость	= ВидимостьСчетаРасчетов;
	Элементы["ПраваПользованияКПСРасчетов"].Видимость	= ВидимостьСчетаРасчетов;
	
	Элементы.СпособПризнанияРасходов.ПараметрыВыбора =
		Перечисления.СпособыПризнанияРасходов.ПараметрыВыбораСпособаПризнанияРасходов(Объект.ВидОперации);
	
	// Доходы от предоставления прав пользования на льготных условиях для целей НУ являются прочими (Н91.01).
	ОграниченияСписокСчетов = Новый Массив;
	ОграниченияСписокСчетов.Добавить(БухгалтерскийУчет.СчетПоКоду("Н91.01", Объект.Дата));
	ПараметрыВыбораСчета = Новый Массив;
	ПараметрыВыбораСчета.Добавить(Новый Параметрвыбора("Отбор.Ссылка", Новый ФиксированныйМассив(ОграниченияСписокСчетов)));
	Элементы.СчетДоходовНУ.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораСчета);
	
	Если ВидимостьОтложенныхДоходов Тогда
		УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект, Объект, "СчетДоходов");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИДоступностьСубконто(Форма, Объект, ИмяРеквизитаСчет)
	
	Перем МассивПолей;
	
	Если ИмяРеквизитаСчет = "СчетРасходов" Тогда
		
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Подразделение", "ПодразделениеРасходов", "ПодразделениеРасходов", Истина, "ПодразделениеРасходов", Истина, Истина, Истина);
		
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоРасходов1", "СубконтоРасходов1", Истина, "СубконтоРасходов1", Истина, Истина, Истина);
		
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоРасходов2", "СубконтоРасходов2", Истина, "СубконтоРасходов2", Истина, Истина, Истина);
		
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоРасходов3", "СубконтоРасходов3", Истина, "СубконтоРасходов3", Истина, Истина, Истина);
		
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Форма.СчетРасходов, Форма, Форма, МассивПолей);
		
	ИначеЕсли ИмяРеквизитаСчет = "СчетДоходов" Тогда
		
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоДоходов1", "СубконтоДоходов1", Истина, "СубконтоДоходов1", Истина, Истина, Истина);
		
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоДоходов2", "СубконтоДоходов2", Истина, "СубконтоДоходов2", Истина, Истина, Истина);
		
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоДоходов3", "СубконтоДоходов3", Истина, "СубконтоДоходов3", Истина, Истина, Истина);
		
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетДоходов, Форма, Объект, МассивПолей);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ОтражатьВНалоговомУчете = Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаНалоговыйУчет", "Видимость", ОтражатьВНалоговомУчете);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаБухгалтерскийУчет", "ОтображатьЗаголовок", ОтражатьВНалоговомУчете);
	
	ЭтоПрочиеДоходы = БухгалтерскийУчетКлиентСервер.СчетВИерархии(Объект.СчетДоходовНУ, "Н91.01");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтатьяПрочихДоходовНУ", "Видимость", ЗначениеЗаполнено(Объект.СчетДоходовНУ) И ЭтоПрочиеДоходы);
	
	// Статья прочих расходов (НУ)
	
	СчетРасходовНУравенН9102 = БухгалтерскийУчетКлиентСервер.СчетВИерархии(Форма.СчетРасходов, "401.20");
	
	ВидимостьСтатьяПрочихРасходовНУ = ОтражатьВНалоговомУчете И СчетРасходовНУравенН9102;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтатьяПрочихРасходовНУ", "Видимость", ВидимостьСтатьяПрочихРасходовНУ);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПараметрыАмортизацииСтатьяПрочихРасходовНУ", "Видимость", ОтражатьВНалоговомУчете);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСчетаПоУмолчанию(СчетУчета, Дата, Организация)
	
	СчетаПоУмолчанию = Новый Структура();
	СчетаПоУмолчанию.Вставить("СчетАмортизации",	БухгалтерскиеОперации.СчетАмортизацииОС(СчетУчета));
	СчетаПоУмолчанию.Вставить("СчетРасчетов",		УчетРасчетов.СчетРасчетовПоАренднойПлате(СчетУчета, Дата, Организация));
	
	Возврат СчетаПоУмолчанию;
	
КонецФункции

&НаКлиенте
Процедура ПроконтролироватьСуммыВСтроке()
	
	Если НЕ КонтролироватьВводимыеСуммы Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОтложенныеДоходы = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование"));
	
	Если НЕ ЕстьОтложенныеДоходы Тогда
		
		ТекДанные["ОтложенныйДоход"] = 0;
		
	КонецЕсли;
	
	Если ТекДанные["ОтложенныйДоход"] > ТекДанные["БалансоваяСтоимость"] Тогда
		
		ТекДанные["ОтложенныйДоход"] = ТекДанные["БалансоваяСтоимость"];
		
	КонецЕсли;
	
	Если ТекДанные["НакопленнаяАмортизация"] > ТекДанные["БалансоваяСтоимость"] Тогда
		
		ТекДанные["НакопленнаяАмортизация"] = ТекДанные["БалансоваяСтоимость"];
		
	КонецЕсли;
	
КонецПроцедуры

