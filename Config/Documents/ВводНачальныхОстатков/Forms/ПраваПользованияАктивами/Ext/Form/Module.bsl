&НаСервере
Процедура ИнициализироватьКолонкиДоступностиАналитикиСчетРасходов()
	
	// Необходима регулярная инициализация этих колонок,
	// т.к. эти колонки являются колонками реквизита формы,
	// и очищаются платформой при сохранении или перечитывании документа
	
	ПоляАналитики = ПолучитьПоляАналитикиСчетаРасходов();
	
	Для Каждого СтрокаТаблицы Из Объект.ПраваПользования Цикл
		
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаТаблицы,
			СтрокаТаблицы.СчетРасходов,
			ПоляАналитики);
			
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ИнициализироватьОбщиеПараметрыАмортизацииПоДоговоруВЦелом()
	
	ОбщиеПараметры = Документы.ВводНачальныхОстатков.ПолучитьОбщиеПараметрыНачисленияАмортизации(Объект);
	
	Если ОбщиеПараметры = Неопределено Тогда
		
		Объект.ПараметрыАмортизацииУстановленыПоДоговоруВЦелом = Ложь;
		
		Модифицированность = Истина;
		
		ТекстСообщения = НСтр("ru='Обнаружены несогласованные между собой настройки параметров амортизации в разных строках таблицы.
			|Режим указания параметров амортизации принудительно переключен в значение ""По каждому объекту отдельно"".'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстСообщения,
			Объект.Ссылка,
			"Объект.ПараметрыАмортизацииУстановленыПоДоговоруВЦелом");
		
	Иначе
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ОбщиеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОбщиеПараметрыНачисленияАмортизации()
	
	Возврат Документы.ВводНачальныхОстатков.ПолучитьОбщиеПараметрыНачисленияАмортизации(Объект);
	
КонецФункции

&НаСервере
Процедура ПереключитьсяВРежимПоДоговоруВЦелом(ОбщиеПараметрыАмортизации)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ОбщиеПараметрыАмортизации, ИменаПараметровАмортизацииПоДоговоруВЦелом);
	
	НастроитьФормуСервер_ПоРежимуУказанияАмортизации();
	
КонецПроцедуры

&НаСервере
Процедура ПереключитьсяВРежимПоКаждомуОбъектуОтдельно()
	
	ПрименитьОбщиеПараметрыАмортизацииПоДоговоруВЦеломСервер();
	
	ИнициализироватьКолонкиДоступностиАналитикиСчетРасходов();
	
	НастроитьФормуСервер_ПоРежимуУказанияАмортизации();
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьОбщиеПараметрыАмортизацииПоДоговоруВЦеломСервер()
	
	Для Каждого СтрокаТаблицы Из Объект.ПраваПользования Цикл
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЭтаФорма, ИменаПараметровАмортизацииПоДоговоруВЦелом);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ПоРежимуУказанияАмортизации()
	
	ПоДоговоруВЦелом = Объект.ПараметрыАмортизацииУстановленыПоДоговоруВЦелом;
	
	Элементы["ПараметрыАмортизацииПоКаждомуОбъекту"].Видимость	= НЕ ПоДоговоруВЦелом;
	
	Элементы["ПараметрыАмортизацииПоДоговоруВЦелом"].Видимость	= ПоДоговоруВЦелом;
	
	// Порядок и сроки списания ДБП показываем информационно,
	// только если параметры амортизации установлены для договора в целом.
	Элементы["СпособПризнанияДоходов"].Видимость	= ПоДоговоруВЦелом;
	Элементы["ДатаНачалаСписания"].Видимость		= ПоДоговоруВЦелом;
	Элементы["ДатаОкончанияСписания"].Видимость		= ПоДоговоруВЦелом;
	
	Если ПоДоговоруВЦелом Тогда
		УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект, Этаформа, "СчетРасходов");
	КонецЕсли;
	
КонецПроцедуры

