&НаКлиенте
Процедура ДоговорНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОтборВидДоговора = Новый СписокЗначений;
	ОтборВидДоговора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком"));
	
	ПараметрыВыбораКЭК = Новый Массив();
	ПараметрыВыбораКЭК.Добавить(Новый ПараметрВыбора("Отбор.ПометкаУдаления", Ложь));
	ПараметрыВыбораКЭК.Добавить(Новый ПараметрВыбора("Отбор.ВидДоговора", ОтборВидДоговора));
	
	Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораКЭК);
	
КонецПроцедуры

