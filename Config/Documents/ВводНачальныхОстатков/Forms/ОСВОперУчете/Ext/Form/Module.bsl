&НаКлиенте
Перем ТекстЗаголовкаСообщений;

//---
// Механизм отбора строк табличной части (v2)
//---
&НаКлиенте
Перем ОтборСтрок_ПрименяемыйОтбор;
&НаКлиенте
Перем ОтборСтрок_ВыбранаНоваяСтрока;
&НаКлиенте
Перем ОтборСтрок_ТекДанные; // активизированная строка а таблице "Основные средства"

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Ввод начальных остатков ОС забаланс'");
	
	РедактированиеВДиалоге_НастроитьФормуПоПометке(Истина); // Пометка
	
	НастроитьФормуКлиент();
	
	ВводНачальныхОстатковКлиент.ПриОткрытии(ЭтаФорма);
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ОтборСтрок_ИнициализироватьНаКлиенте();
	
	ВводНачальныхОстатковКлиент.СпроситьИОткрытьФормуВводаНачальныхОстатковОС(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	Если НЕ ИнициализацияВыполнена Тогда
		ИнициализацияФормы();
	КонецЕсли;
	
	//---
	// Полная табличная часть ОС
	//---
	ПолнаяТабличнаяЧастьОС_ОбновитьСервер();
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ОтборСтрок_ПередЗаписьюНаСервере(ТекущийОбъект);
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	УстановитьЗаголовокФормы();
	
	//---
	// Полная табличная часть ОС
	//---
	ПолнаяТабличнаяЧастьОС_ОбновитьСервер();
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ОтборСтрок_ПослеЗаписиНаСервере();
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	// Оповещаем форму Помощника ввода начальных остатков:
	ИмяСобытия = "ЗаписанДокументВводНачальныхОстатков";
	Параметр = Объект["Организация"];
	Оповестить(ИмяСобытия, Параметр);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаВводаОстатковПриИзменении(Элемент)
	
	ДатаПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	БухгалтерскийУчетКлиент.ОбработатьВыборКФО(Объект.Организация,
											   Объект.ИФО,
											   Объект.КФО,
											   ПолучитьДату());
											   
	КФОПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетПриИзменении(Элемент)
	
	Если Счет_УчетПоКПС Тогда
		
		БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(Объект.Счет, 
															Объект.КПС,
															Объект.КФО,
															Объект.КЭК);
		
	КонецЕсли;
	
	ОбновитьВидУчетаНФА();
	
	ОграничитьСписокВыбораСчета(ЭтаФорма);
	
	СчетПриИзмененииСервер();
	
	НастроитьФормуКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		
		// Кэшируем свойства счета:
		ОбновитьКэшФормыСервер(ВыбранноеЗначение);
		
		Если Счет_УчетПоКПС Тогда
			
			// Открываем снова форму выбора счета, но теперь полную версию:
			СчетаОСДляОтбора = ВыбранноеЗначение;
			БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
																	, //СтандартнаяОбработка, 
																	Новый Структура("Счет, КПС, КФО", 
																					ВыбранноеЗначение, 
																					Объект.КПС, 
																					Объект.КФО), 
																	Объект.Организация,
																	Объект.ИФО,
																	СчетаОСДляОтбора,
																	Объект.КФО,
																	,
																	ПолучитьДату());
			
		КонецЕсли;
		
	Иначе
		
		БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
															Объект.КПС,
															Объект.КФО,
															Объект.КЭК);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КПССчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													Объект.КПС, 
													Объект.Организация,
													Объект.ИФО,
													Объект.КФО,
													Объект.Счет,
													ПолучитьДату());
													
КонецПроцедуры
&НаКлиенте
Процедура КЭКСчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.Счет) Тогда
		ТекстСообщения = НСтр("ru='Не заполнен счет.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.Счет");
		Возврат;
	КонецЕсли;
	
	Если ИспользоватьКЭК0 Тогда
		//---
		// КЭК0
		//---
		ОграниченияКЭК = Новый Массив();
		ОграниченияКЭК.Добавить(КЭК0);
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент,
								СтандартнаяОбработка,
								,//КЭК,
								,//Организация,
								,//ИФО,
								,//КФО,
								,//Счет,
								,//Дата,
								,//"Дт",
								ОграниченияКЭК);
	Иначе
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент,
									СтандартнаяОбработка,
									Объект.КЭК,
									Объект.Организация,
									Объект.ИФО,
									Объект.КФО,
	                                Объект.Счет,
									ПолучитьДату(),
									"Дт");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидУчетаПриИзменении(Элемент)
	
	ОчиститьСчет();
	
	УстановитьСчетЕслиОнЕдинственный();
	
	ОбновитьКэшФормыСервер();
	
	ОграничитьСписокВыбораСчета(ЭтаФорма);
	
	// Обновляем форму
	НастроитьФормуКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидУчетаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВидУчетаНФА = ВыбранноеЗначение Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя = "СтраницаКапремонт" Тогда
		//---
		// Механизм отбора строк табличной части (v2)
		//---
		ОтборСтрок_ОбработатьВозможноеИзменениеОтбора();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборКапремонтУстанавливатьОтборПриИзменении(Элемент)
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ОтборСтрок_УстанавливатьОтборПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборКапремонтОСПриИзменении(Элемент)
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ОтборСтрок_ПолеОтбораПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборКапремонтИнвНомерПриИзменении(Элемент)
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ОтборСтрок_ПолеОтбораПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ОСОсновная

&НаКлиенте
Процедура ОС_ОсновнаяВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	РедактированиеВДиалоге_ПроверитьИОткрытьДиалог(СтандартнаяОбработка, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяПриАктивизацииСтроки(Элемент)
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ОтборСтрок_ВыбранаНоваяСтрока = ОтборСтрок_ВыбранаНоваяСтрокаВТаблицеОС();
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяОСПриИзменении(Элемент)
	
	//---
	// Полная табличная часть ОС
	//---
	ПолнаяТабличнаяЧастьОС_ЗаполнитьСтрокуДаннымиИзОСАмортизацияСервер(Элементы["ОС_Основная"].ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяКоличествоПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РасчетСуммы(ТекДанные, "Количество");
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяПервоначальнаяСтоимостьПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РасчетСуммы(ТекДанные, "ПервоначальнаяСтоимость");
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяСуммаПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РасчетСуммы(ТекДанные, "Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяСостояниеОСПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	СостояниеОС = ТекДанные["СостояниеОС"];
	
	Если НЕ СостояниеОС = ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию") Тогда
		ТекДанные["ВводВЭксплуатациюОдновременноСПринятиемКУчету"] = Ложь;
		
		Если НЕ ЗначениеЗаполнено(СостояниеОС) Тогда
			ТекДанные["ДатаВводаВЭксплуатацию"]					= Дата(1,1,1);
			ТекДанные["НазваниеДокументаВводаВЭксплуатацию"]	= "";
			ТекДанные["НомерДокументаВводаВЭксплуатацию"]		= "";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОС_ОсновнаяСостояниеОСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
