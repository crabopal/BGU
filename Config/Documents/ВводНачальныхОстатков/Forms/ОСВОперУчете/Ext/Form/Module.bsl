&НаСервере
Процедура ИнициализацияФормы()
	
	Если ИнициализацияВыполнена Тогда
		Возврат;
	КонецЕсли;
	
	ПравоДоступаИзменение	= ПравоДоступа("Изменение", Объект.Ссылка.Метаданные());
	БалансовыйСчетУчета 	= УправлениеОсновнымиСредствамиКлиентСервер.ОпределитьБалансовыйСчетДляЗабалансового(Объект.Счет);
	Элементы["ПодразделениеОрганизации"].АвтоОтметкаНезаполненного = Документы.ВводНачальныхОстатков.ПодразделениеОбязательноКЗаполнению(Объект);
	
	// Запомним имена используемых колонок таблиц ОС
	ТекущийРазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете;
	ПустаяСтрокаТаблицыОСОсновная		= Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ИменаИспользуемыхКолонокОСОсновная(ТекущийРазделУчета);
	ПустаяСтрокаТаблицыОСАмортизация	= Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ИменаИспользуемыхКолонокОСАмортизация(ТекущийРазделУчета);
	ПолнаяТабличнаяЧастьОС_ИменаРедактируемыхВТаблицеКолонокОСАмортизация = Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ИменаРедактируемыхВТаблицеКолонокОСАмортизация(ТекущийРазделУчета);
	
	// Кэшируем свойства счета:
	ОбновитьКэшФормыСервер();
	
	НастроитьФормуСервер_ПоРазделуУчета();
	
	Документы.ВводНачальныхОстатков.НастроитьФормуДокументаДляУстаревшегоРазделаУчета(ЭтаФорма);
	
	ВидУчетаНФА	= ОпределитьВидУчетаНФАПоСчету(ЭтаФорма);
	
	ОграничитьСписокВыбораСчета(ЭтаФорма);
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ОтборСтрок_ИнициализироватьНаСервере();
	
	УстановитьУсловноеОформление();
	
	ИнициализацияВыполнена = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ЗаголовокФормы = "Ввод начальных остатков ОС на забалансовых счетах";
	Если Объект.Ссылка.Пустая() Тогда
		ЗаголовокФормы = ЗаголовокФормы + " (создание)";
	Иначе
		ЗаголовокФормы = ЗаголовокФормы + " " + Объект.Номер + " от " + Объект.Дата;
	КонецЕсли;
	ЭтаФорма.Заголовок = ЗаголовокФормы;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьЗаголовокФормы();
	
	Если НЕ ИнициализацияВыполнена Тогда
		ИнициализацияФормы();
		
		//---
		// Полная табличная часть ОС
		//---
		ПолнаяТабличнаяЧастьОС_ОбновитьСервер();
	КонецЕсли;
	
	//---
	// КЭК0
	//---
	УстановитьНовоеЗначениеКЭК = Ложь;
	
	// Заполняем по возможности пустые поля формы:
	Если Объект.Ссылка.Пустая() Тогда
		
		Попытка
			ЭтаФорма.ТиповаяОперация = Справочники.ТиповыеОперации.ВводНачальныхОстатков_ОСВОперУчете;
		Исключение
		КонецПопытки;
		
		Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
		КонецЕсли;
		
		//---
		// КЭК0
		//---
		УстановитьНовоеЗначениеКЭК = Истина;
		
	КонецЕсли;
	
	//---
	// КЭК0
	//---
	КЭК0 = БухгалтерскийУчетПовтИсп.КЭК0();
	ПроконтролироватьЗначениеКЭКСервер(УстановитьНовоеЗначениеКЭК);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент()
	
	РазрешитьРаботуСФормой = ЗначениеЗаполнено(Объект.Организация)
		И ЗначениеЗаполнено(Объект.Счет)
		И ПравоДоступаИзменение;
	
	Элементы["ОС_Основная"].ТолькоПросмотр			= НЕ РазрешитьРаботуСФормой;
	Элементы["РедактированиеВДиалоге"].Доступность	= РазрешитьРаботуСФормой;
	Элементы["ОткрытьВДиалогеКМ"].Доступность		= РазрешитьРаботуСФормой;
	
	Элементы["КПССчета"].Доступность				= Счет_УчетПоКПС;
	Элементы["КЭКСчета"].Доступность				= Счет_УчетПоКЭК;
	
	Элементы["Контрагент"].Доступность = Счет_ЕстьСубконтоКонтрагент;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОграничитьСписокВыбораСчета(Форма)
	
	ВидУчетаНФА		= Форма["ВидУчетаНФА"];
	ТаблицаСчетов	= Форма["ТаблицаСчетов"];
	Элементы		= Форма.Элементы;
	
	ЗаполненВидУчетаНФА = ЗначениеЗаполнено(ВидУчетаНФА);
	
	МассивСчетов = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСчетов Цикл
		Если ЗаполненВидУчетаНФА Тогда
			Если НЕ ВидУчетаНФА = СтрокаТаблицы["ВидУчетаНФА"] Тогда
				Продолжить;
			КонецЕсли;
			
			МассивСчетов = СтрокаТаблицы["МассивСчетов"];
		Иначе
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСчетов, СтрокаТаблицы["МассивСчетов"]);
		КонецЕсли;
	КонецЦикла;
	
	НовыйПараметр = Новый ПараметрВыбора("ОграниченияСписокСчетов", МассивСчетов);
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	Элементы["Счет"].ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСчет()
	
	ОчищающаяСтруктура = Новый Структура("Счет, КПС, КЭК");
	
	ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСчетЕслиОнЕдинственный()
	
	ТекущаяСтрока = ПолучитьТекущуюСтрокуТаблицыСчетов();
	
	Если ТекущаяСтрока <> Неопределено Тогда
		МассивСчетов = ТекущаяСтрока["МассивСчетов"];
		
		Если МассивСчетов.Количество() = 1 Тогда
			Объект["Счет"] = МассивСчетов[0];
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТекущуюСтрокуТаблицыСчетов()
	
	Для Каждого СтрокаТаблицы Из ТаблицаСчетов Цикл
		Если СтрокаТаблицы["ВидУчетаНФА"] = ВидУчетаНФА Тогда
			Возврат СтрокаТаблицы;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура НастроитьФормуСервер_ПоРазделуУчета()
	
	ТаблицаСчетов.Загрузить(Документы.ВводНачальныхОстатков.ОСНаЗабалансовыхСчетах_ПолучитьТаблицуСчетов(Объект));
	
	Если ТаблицаСчетов.Количество() = 1 Тогда
		Элементы["ВидУчета"].ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Документы.ВводНачальныхОстатков.УстановитьУсловноеОформление_КолонкиОСПринятиеКУчету(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДату()
	
	Возврат КонецГода(Объект.Дата) + 1;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОпределитьВидУчетаНФАПоСчету(Форма)
	
	Счет			= Форма.Объект["Счет"];
	ТаблицаСчетов	= Форма["ТаблицаСчетов"];
	
	Если ЗначениеЗаполнено(Счет) Тогда
		// Ищем среди допустимых видов учета
		
		Для Каждого СтрокаТаблицы Из ТаблицаСчетов Цикл
			
			СчетНайден = (СтрокаТаблицы["МассивСчетов"].Найти(Счет) <> Неопределено);
			
			Если СчетНайден Тогда
				Возврат СтрокаТаблицы["ВидУчетаНФА"];
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Берем жестко вид учета, если он допустим всего один
	Если ТаблицаСчетов.Количество() = 1 Тогда
		Возврат ТаблицаСчетов[0]["ВидУчетаНФА"];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ОбновитьКэшФормыСервер(СчетСсылка = Неопределено)
	
	Если СчетСсылка = Неопределено Тогда
		СчетСсылка = Объект["Счет"];
	КонецЕсли;
	
	КэшФормы = ПолучитьКэшФормы(СчетСсылка);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, КэшФормы);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКэшФормы(СчетСсылка)
	
	Если ЗначениеЗаполнено(СчетСсылка) Тогда
		СвойстваСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетСсылка,
			"УчетПоКПС, УчетПоКЭК, УчетПоПодразделениям");
			
		УчетПоКПС						= СвойстваСчета["УчетПоКПС"];
		УчетПоКЭК						= СвойстваСчета["УчетПоКЭК"];
		УчетПоПодразделениям			= СвойстваСчета["УчетПоПодразделениям"];
		
		СубконтоКонтрагент = СчетСсылка.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
		
		Если СубконтоКонтрагент = Неопределено Тогда
			ЕстьСубконтоКонтрагент			= Ложь;
			ВводПустыхСубконтоКонтрагент	= Ложь;
		Иначе
			ЕстьСубконтоКонтрагент			= Истина;
			ВводПустыхСубконтоКонтрагент	= НЕ СубконтоКонтрагент.Обязательный;
		КонецЕсли;
	Иначе
		УчетПоКПС						= Ложь;
		УчетПоКЭК						= Ложь;
		УчетПоПодразделениям			= Ложь;
		ЕстьСубконтоКонтрагент			= Ложь;
		ВводПустыхСубконтоКонтрагент	= Ложь;
	КонецЕсли;
	
	КэшФормы = Новый Структура();
	КэшФормы.Вставить("Счет_УчетПоКПС",					УчетПоКПС);
	КэшФормы.Вставить("Счет_УчетПоКЭК",					УчетПоКЭК);
	КэшФормы.Вставить("Счет_УчетПоПодразделениям",		УчетПоПодразделениям);
	КэшФормы.Вставить("Счет_ЕстьСубконтоКонтрагент",	ЕстьСубконтоКонтрагент);
	КэшФормы.Вставить("ВводПустыхСубконтоКонтрагент",	ВводПустыхСубконтоКонтрагент);
	
	Возврат КэшФормы;
	
КонецФункции

// ЧтоИзменилось - одна из строк "Количество", "Цена", "Сумма".
&НаКлиенте
Процедура РасчетСуммы(ТекДанные, ЧтоИзменилось)
	
	Если ЧтоИзменилось = "Количество" ИЛИ ЧтоИзменилось = "ПервоначальнаяСтоимость" Тогда
		ТекДанные.Сумма = ТекДанные.Количество * ТекДанные.ПервоначальнаяСтоимость;
		
	ИначеЕсли ЧтоИзменилось = "Сумма" Тогда
		ТекДанные.ПервоначальнаяСтоимость = ?(ТекДанные.Количество = 0,
			0,
			ТекДанные.Сумма / ТекДанные.Количество);
		
	КонецЕсли;
	
КонецПроцедуры

