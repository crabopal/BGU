#Область ОбработчикиСобытийЭлементовТаблицыФормы_ДвиженияЖурналПроводок

&НаКлиенте
Процедура ДвиженияЖурналПроводокПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекДанные = Элементы["ДвиженияЖурналПроводок"].ТекущиеДанные;
		ТекДанные.Активность = Объект.Проведен;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияЖурналПроводокКФОПриИзменении(Элемент)
	
	ТекущиеДанные	= Элементы["ДвиженияЖурналПроводок"].ТекущиеДанные;
	ТекСтрока		= Элементы["ДвиженияЖурналПроводок"].ТекущаяСтрока;
	
	БухгалтерскийУчетКлиент.ОбработатьВыборКФО(Объект.Организация,
											   Объект.ИФО,
											   ТекущиеДанные.КФО,
											   ПолучитьДату(),
											   ТекущиеДанные.КПСДт,
											   ТекущиеДанные.КПСКт);
	//---
	// КЭК0
	//---
	КФОПриИзмененииСервер(ТекСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияЖурналПроводокВидПервичногоДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Справочник.ВидыПервичныхДокументов.ФормаВыбора", ,Элемент);
КонецПроцедуры

// ДЕБЕТ

&НаКлиенте
Процедура ДвиженияЖурналПроводокСчетДтПриИзменении(Элемент)
	
	ТекСтрока = Элементы["ДвиженияЖурналПроводок"].ТекущаяСтрока; 
	ТекДанные = Элементы["ДвиженияЖурналПроводок"].ТекущиеДанные;
	Если НЕ СчетаРасчетовКИСЕ.НайтиПоЗначению(ТекДанные.СчетДт) = Неопределено Тогда
		БухгалтерскиеОперацииКлиент.СубконтоПриИзменении(Элементы.ДвиженияЖурналПроводокСубконтоДт1,,, Истина, Истина);  
	КонецЕсли;
	
	СчетДтПриИзмененииСервер(ТекСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияЖурналПроводокСчетДтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДвиженияЖурналПроводок.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			ТекущиеДанные.СчетДт, 
																			ТекущиеДанные.КПСДт, 
																			ТекущиеДанные.КФО), 
															Объект.Организация,
															Объект.ИФО,
															,
															ТекущиеДанные.КФО,
															,
															ПолучитьДату());
КонецПроцедуры

