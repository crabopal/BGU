	ТекущиеДанные.ЖурналОпераций = БухгалтерскиеОперации.НомерЖурнала(ТекущиеДанные.СчетДт, ТекущиеДанные.СчетКт);
	
	ПроконтролироватьЗначениеКЭКСервер_ВТекущейСтроке(ТекущаяСтрока, Истина, "Кт"); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаСервере
Процедура ПроконтролироватьЗначениеКЭКСервер_ВТекущейСтроке(Знач СтрокаТаблицы, УстановитьНовоеЗначение, СторонаДтКт = "")
	
	Перем НовоеЗначениеКЭК;
	
	Если ТипЗнч(СтрокаТаблицы) = Тип("Число") Тогда
		СтрокаТаблицы = Объект.Движения.ЖурналПроводокЕПСБУ.НайтиПоИдентификатору(СтрокаТаблицы);
	КонецЕсли;
	
	ОбработатьСторонуДт = (ВРег(СторонаДтКт) = "ДТ" ИЛИ НЕ ЗначениеЗаполнено(СторонаДтКт));
	ОбработатьСторонуКт = (ВРег(СторонаДтКт) = "КТ" ИЛИ НЕ ЗначениеЗаполнено(СторонаДтКт));
	
	Если ОбработатьСторонуДт И СчетаРасчетовКИСЕ.НайтиПоЗначению(СтрокаТаблицы.СчетДт) = Неопределено Тогда
		Если Документы.ВводНачальныхОстатков.НеобходимоИзменитьЗначениеКЭК(
			Объект["Организация"],
			Объект["ИФО"],
			СтрокаТаблицы["КФО"],
			Объект["Дата"],
			СтрокаТаблицы["СчетДт"],
			СтрокаТаблицы["КЭКДт"],
			"Дт",
			СтрокаТаблицы["ИспользоватьКЭК0Дт"],
			НовоеЗначениеКЭК) Тогда
			Если УстановитьНовоеЗначение = Истина Тогда
				СтрокаТаблицы["КЭКДт"] = НовоеЗначениеКЭК;
				Модифицированность = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбработатьСторонуКт И СчетаРасчетовКИСЕ.НайтиПоЗначению(СтрокаТаблицы.СчетКт) = Неопределено Тогда
		Если Документы.ВводНачальныхОстатков.НеобходимоИзменитьЗначениеКЭК(
			Объект["Организация"],
			Объект["ИФО"],
			СтрокаТаблицы["КФО"],
			Объект["Дата"],
			СтрокаТаблицы["СчетКт"],
			СтрокаТаблицы["КЭККт"],
			"Кт",
			СтрокаТаблицы["ИспользоватьКЭК0Кт"],
			НовоеЗначениеКЭК) Тогда
			Если УстановитьНовоеЗначение = Истина Тогда
				СтрокаТаблицы["КЭККт"] = НовоеЗначениеКЭК;
				Модифицированность = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроконтролироватьЗначениеКЭКСервер_ВоВсейТаблице(УстановитьНовоеЗначение, СторонаДтКт = "")
	
	Перем НовоеЗначениеКЭК;
	
	Для Каждого СтрокаТаблицы Из Объект.Движения.ЖурналПроводокЕПСБУ Цикл
		ПроконтролироватьЗначениеКЭКСервер_ВТекущейСтроке(СтрокаТаблицы, УстановитьНовоеЗначение, СторонаДтКт);
	КонецЦикла;
	
КонецПроцедуры

