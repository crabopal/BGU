&НаКлиенте
Процедура ДвиженияЖурналПроводокКЭКДтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДвиженияЖурналПроводок.ТекущиеДанные;
	
	Если ТекущиеДанные["ИспользоватьКЭК0Дт"] Тогда
		ОграниченияКЭК = Новый Массив();
		ОграниченияКЭК.Добавить(КЭК0);
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент,
								СтандартнаяОбработка,
								,// КЭК,
								,// Организация,
								,// ИФО,
								,// КФО,
								,// Счет,
								,// Дата,
								,// "Дт",
								ОграниченияКЭК);
	Иначе
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент, 
									СтандартнаяОбработка,
									ТекущиеДанные.КЭКДт,
									Объект.Организация, 
									Объект.ИФО,
									ТекущиеДанные.КФО, 
	                                ТекущиеДанные.СчетДт,
									ПолучитьДату(),
									"Дт");
	КонецЕсли;
	
КонецПроцедуры
							
