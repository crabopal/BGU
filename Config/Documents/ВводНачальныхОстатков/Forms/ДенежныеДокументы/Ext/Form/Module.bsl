&НаКлиенте
Процедура СчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СчетДляОтбора = Счет20135;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			Объект.Счет, 
																			Объект.КПС, 
																			Объект.КФО), 
															Объект.Организация,
															Объект.ИФО,
															СчетДляОтбора,
															Объект.КФО,
															,
															ПолучитьДату());
КонецПроцедуры
