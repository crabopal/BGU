&НаКлиенте
Перем ТекстЗаголовкаСообщений;

//	----------------------------------+-----------------------+-----------------------------------+--------------------------
//									  |						  |									  |	Нужен отбор по факультету
//		Ситуация					  |	ПринятьДетейВГруппу   |	Комментарий						  |	при выборе студента
//	----------------------------------+-----------------------+-----------------------------------+--------------------------
//	1) Вводим только суммы остатков,  |	Ложь				  |	Состав групп уже сформирован	  |	Да
//	в группу не зачисляем			  |						  |	другими средствами программы	  |
//	----------------------------------+-----------------------+-----------------------------------+--------------------------
//	2) И вводим суммы,				  |	Истина				  |	Состав групп еще не сформирован,  |	Нет
//	и зачисляем в группу			  |						  |	и будет формироваться этим док-ом |
//	----------------------------------+-----------------------+-----------------------------------+--------------------------

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	ПодготовитьФормуНаСервере();
	
	УстановитьУсловноеОформление();
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Инициализация
	ТекстЗаголовкаСообщений = НСтр("ru='Ввод начальных остатков по учащимся'");
	
	НастроитьФормуКлиент();
	
	ВводНачальныхОстатковКлиент.ПриОткрытии(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	УстановитьЗаголовокФормы();
	СтудентыЗаполнитьДобавленныеКолонки();
	ПорядокОплатыЗаполнитьДобавленныеКолонки();
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	// Оповещаем форму Помощника ввода начальных остатков:
	ИмяСобытия = "ЗаписанДокументВводНачальныхОстатков";
	Параметр = Объект["Организация"];
	Оповестить(ИмяСобытия, Параметр);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.НастройкаОтраженияВУчете" Тогда
		
		Если ВыбранноеЗначение.ИмяРеквизитаСчет = "СчетДоходов" Тогда
			ОбработкаВыбораОтраженияДоходовВУчетеНаКлиенте(ВыбранноеЗначение);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаВводаОстатковПриИзменении(Элемент)
	
	ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
	// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
	// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если НЕ ЭтотОбъект.КэшПараметров.ИзмениласьДатаВПределахДня Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
	// Заполняем список выбора "КФО" значениями из уч.пол., плюс доп.ограничения:
	ЗаполнитьСписокВыбораКФО();
	
	СтудентыЗаполнитьДобавленныеКолонки();
	ПорядокОплатыЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	// Заполняем список выбора "КФО" значениями из уч.пол., плюс доп.ограничения:
	ЗаполнитьСписокВыбораКФО();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидУслугПриИзменении(Элемент)
	
	Если ВидУслуг = 0 Тогда
		Объект.НачислениеУчащимсяЗаПрочиеУслуги = Ложь;
	Иначе
		Объект.НачислениеУчащимсяЗаПрочиеУслуги = Истина;
		Объект.ПринятьДетейВГруппу = Ложь;
	КонецЕсли;
	
	НастроитьДоступностьГруппыИКурса();
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииНачисленияУчащимсяПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	СтудентыЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПринятьДетейВГруппуПриИзменении(Элемент)
	
	НастроитьДоступностьГруппыИКурса();
	
	УстановитьПараметрыВыбораСтудентаСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	
	КурсВалюты = ПолучитьКурсВалюты(Объект.ВалютаДокумента, Объект.Дата);
	Объект.Курс			= КурсВалюты.Курс;
	Объект.Кратность	= КурсВалюты.Кратность;
	
	НастроитьДоступностьЭлементовБлокаВалюты();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Студенты

&НаКлиенте
Процедура СтудентыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если Новаястрока Тогда
		
		ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор); // Новый GUID для каждой строки.
		ТекущиеДанные.СостояниеСтудента = СостояниеСтудентаЗачислен;
		
		Если НЕ Копирование Тогда
			
			ТекущиеДанные.ВидДеятельностиНУ = ПредопределенноеЗначение("Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения");
			ТекущиеДанные.СчетДоходовНУ = БухгалтерскийУчетВызовСервера.СчетПоКоду("Н90.01", Объект.Дата, Объект.Организация);
			
			ТекущиеДанные.ПорядокВыпискиСФ = ПредопределенноеЗначение("Перечисление.ПорядокВыпискиСФЗаУслуги.НаПлательщика");
			
			ТекущиеДанные.ДоляОплаты = 100; // По умолчанию 100%.
			
			СтудентыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// ----- Студенты . Договор -----
&НаКлиенте
Процедура СтудентыДоговорПриИзменении(Элемент)
	
	ТекДанные = Элементы["Студенты"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Обновляем поле "Контрагент" значением из текущего договора:
	ИмяПоляДоговор		= "Договор";
	ИмяПоляКонтрагент	= "Контрагент";
	Если ЗначениеЗаполнено(ТекДанные[ИмяПоляДоговор])
		И НЕ ЗначениеЗаполнено(ТекДанные[ИмяПоляКонтрагент]) Тогда
	
		КонтрагентСсылкаНов = ПолучитьКонтрагента(ТекДанные[ИмяПоляДоговор]);
		
		ТекДанные[ИмяПоляКонтрагент] = КонтрагентСсылкаНов;
		
	КонецЕсли;
	
КонецПроцедуры

// ----- Студенты . Задолженность -----
&НаКлиенте
Процедура СтудентыСуммаЗадолженностьПриИзменении(Элемент)
	
	ОчиститьЗависимоеПолеСуммы(Элементы.Студенты.ТекущиеДанные, "СуммаЗадолженность");
	
КонецПроцедуры

// ----- Студенты . Переплата -----
&НаКлиенте
Процедура СтудентыСуммаПереплатаПриИзменении(Элемент)
	
	ОчиститьЗависимоеПолеСуммы(Элементы.Студенты.ТекущиеДанные, "СуммаПереплата");
	
КонецПроцедуры

&НаКлиенте
Процедура СтудентыОстатокРасчетовПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Студенты.ТекущиеДанные;
	РассчитатьСуммыЗадолженностиПереплатыПоДолгосрочномуДоговору(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура СтудентыОстатокДБППриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Студенты.ТекущиеДанные;
	РассчитатьСуммыЗадолженностиПереплатыПоДолгосрочномуДоговору(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура СтудентыОтражениеДоходовВУчетеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуНастройкиОтраженияДоходовВУчете(Элементы.Студенты.ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура СтудентыЗаполнитьДобавленныеКолонки()
	
	Для Каждого СтрокаТаблицы Из Объект.Студенты Цикл
		
		СтудентыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СтудентыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокНачалоНачисления    = НСтр("ru = 'с:'");
	СтрокаТаблицы.ЗаголовокОкончаниеНачисления = НСтр("ru = 'по:'");
	
	СтрокаТаблицы.ЗаголовокОстатокРасчетов = НСтр("ru = 'Не оплачено (205.00):'");
	СтрокаТаблицы.ЗаголовокОстатокДБП      = НСтр("ru = 'Не исполнено (401.40):'");
	
	ЗаполнитьДобавленныеКолонкиОтраженияДоходовВУчете(Форма, СтрокаТаблицы);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Плательщики

&НаКлиенте
Процедура ПлательщикиПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Поиск = Новый Структура("Контрагент", ТекДанные.Контрагент);
	СтрокиТЗ = Плательщики.НайтиСтроки(Поиск);
	
	ИтогоЗадолженность = 0;
	ИтогоПереплата = 0;
	Для Каждого СтрокаТЗ Из СтрокиТЗ Цикл
		ИтогоЗадолженность = ИтогоЗадолженность + СтрокаТЗ.Задолженность;
		ИтогоПереплата = ИтогоПереплата + СтрокаТЗ.Переплата;
	КонецЦикла;
	
	// Обновляем итоговые поля таблицы:
	ПлательщикЗадолженность = ИтогоЗадолженность;
	ПлательщикПереплата = ИтогоПереплата;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ПорядокОплаты

&НаКлиенте
Процедура ПорядокОплатыСтудентыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ПорядокОплатыСтуденты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.УчащийсяПредставление.Заголовок =
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1, %2 (%3)'"),
			ТекущиеДанные.Студент,
			ТекущиеДанные.Договор,
			ТекущиеДанные.Контрагент);
	
	ИтогСуммаОплатыПоГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект, ТекущиеДанные.ИдентификаторСтроки);
	
	ПодключитьОбработчикОжидания("ПорядокОплатыУстановитьОтборВТаблице", 0.2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокОплатыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Новаястрока И НЕ Копирование Тогда
		
		ТекущийСтудент = Элементы.ПорядокОплатыСтуденты.ТекущиеДанные;
		Если ТекущийСтудент = Неопределено Тогда
			Отказ = Истина;
		Иначе
			ТекущиеДанные = Элементы.ПорядокОплаты.ТекущиеДанные;
			ТекущиеДанные.ИдентификаторСтроки = ТекущийСтудент.ИдентификаторСтроки;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокОплатыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ТекущиеДанные = Элементы.ПорядокОплаты.ТекущиеДанные;
	
	Если ТекущиеДанные.НачалоПериода > ТекущиеДанные.КонецПериода Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Дата начала периода превышает дату окончания!'"));
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокОплатыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Объект.ПорядокОплатыОбразование.Сортировать("ИдентификаторСтроки,ОплатитьДо,НачалоПериода,КонецПериода");
	
	ТекущиеДанные = Элементы.ПорядокОплатыСтуденты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИтогСуммаОплатыПоГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект, ТекущиеДанные.ИдентификаторСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокОплатыПослеУдаления(Элемент)
	
	ТекущиеДанные = Элементы.ПорядокОплатыСтуденты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИтогСуммаОплатыПоГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект, ТекущиеДанные.ИдентификаторСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокОплатыКонецПериодаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПорядокОплаты.ТекущиеДанные;
	ПорядокОплатыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ТекущиеДанные, Объект.Дата);
	
КонецПроцедуры

&НаСервере
Процедура ПорядокОплатыЗаполнитьДобавленныеКолонки()
	
	Для Каждого СтрокаТаблицы Из Объект.ПорядокОплатыОбразование Цикл
		
		ПорядокОплатыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(СтрокаТаблицы, Объект.Дата);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПорядокОплатыЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(СтрокаТаблицы, ДатаДокумента)
	
	СтрокаТаблицы.ПериодЗавершен = ( КонецДня(СтрокаТаблицы.КонецПериода) <= КонецДня(ДатаДокумента) );
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОбновитьТаблицу(Команда)
	
	ОбновитьТаблицуПлательщикиСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьПризнакАгрегатора(Команда)
	
	ВводНачальныхОстатковКлиент.СнятьПризнакАгрегатора(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьОстаткиПоГрафикамОплаты(Команда)
	
	Оповещение = Новый ОписаниеОповещения("РассчитатьОстаткиПоГрафикамОплатыЗавершение", ЭтотОбъект);
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Рассчитать остатки по долгосрочным договорам по данным на закладке ""Порядок оплаты""?
			|Значения в колонке ""%1"" будут очищены.'"),
				Элементы.СтудентыГруппаОстаток.Заголовок);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПорядокОплатыИзШаблона(Команда)
	
	ТекущиеДанные = Элементы.ПорядокОплатыСтуденты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки);
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьШаблонГрафикаОплатыЗавершение", ЭтотОбъект, ДопПараметры);
	ПоказатьВводЗначения(Оповещение, Неопределено, "Выберите график оплаты", Тип("СправочникСсылка.ГрафикиОплатыОбразование"));
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПорядокОплатыВШаблон(Команда)
	
	ТекущиеДанные = Элементы.ПорядокОплатыСтуденты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки);
	
	Оповещение = Новый ОписаниеОповещения("СохранитьШаблонГрафикаОплатыЗавершение", ЭтотОбъект, ДопПараметры);
	ПоказатьВводЗначения(Оповещение, Неопределено, "Введите наименование графика оплаты", Тип("Строка"));
	
КонецПроцедуры

