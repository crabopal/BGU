#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НастроитьФормуКлиент()
	
	Если НЕ РазрешитьРаботуСФормой Тогда
		Возврат;
	КонецЕсли;
	
	НовДоступность = ЗначениеЗаполнено(Объект["Организация"]);
	Элементы["Факультет"].Доступность					= НовДоступность;
	Элементы["Студенты"].ТолькоПросмотр					= НЕ НовДоступность;
	Элементы["ГруппаКоманднаяПанельВЦелом"].Доступность	= НовДоступность;
	
	НастроитьДоступностьЭлементовБлокаВалюты();
	
	НастроитьДоступностьГруппыИКурса();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбораСтудентаСервер()
	
	МассивСвязиПараметровВыбора = Новый Массив();
	
	МассивПараметровВыбора = Новый Массив();
	
	НовыйПараметр = Новый СвязьПараметраВыбора("Отбор.Организация", "Объект.Организация", РежимИзмененияСвязанногоЗначения.Очищать);
	МассивСвязиПараметровВыбора.Добавить(НовыйПараметр);
	
	НуженОтборПоФакультету = (НЕ Объект["ПринятьДетейВГруппу"]);
	
	Если НуженОтборПоФакультету Тогда
		НовыйПараметр = Новый СвязьПараметраВыбора("Отбор.Факультет", "Объект.Факультет", РежимИзмененияСвязанногоЗначения.НеИзменять);
		МассивСвязиПараметровВыбора.Добавить(НовыйПараметр);
		
		НовыйПараметр = Новый ПараметрВыбора("РазрешитьИзменениеФакультета", Истина);
		МассивПараметровВыбора.Добавить(НовыйПараметр);
	КонецЕсли;
	
	// Доступно для записи только на сервере
	Элементы["СтудентыСтудент"].СвязиПараметровВыбора = Новый ФиксированныйМассив(МассивСвязиПараметровВыбора);
	
	Элементы["СтудентыСтудент"].ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ЗаголовокФормы = "Ввод начальных остатков по учащимся ";
	Если Объект.Ссылка.Пустая() Тогда
		ЗаголовокФормы = ЗаголовокФормы + "(создание)";
	Иначе
		ЗаголовокФормы = ЗаголовокФормы + Объект.Номер + " от " + Объект.Дата;
	КонецЕсли;
	ЭтаФорма.Заголовок = ЗаголовокФормы;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	// Инициализация:
	ФО_ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет")
		И ЗначениеЗаполнено(Объект.ВалютаДокумента)
		И НЕ Объект.ВалютаДокумента = ВалютаРУ Тогда
		// Использование валюты отключено, а валюта документа отличается от валюты регл.учета.
		// Покажем используемую валюту:
		Элементы.СтудентыСуммаЗадолженность.Заголовок = Элементы.СтудентыСуммаЗадолженность.Заголовок
			+ ", " + Объект.ВалютаДокумента;
		Элементы.СтудентыСуммаПереплата.Заголовок = Элементы.СтудентыСуммаПереплата.Заголовок
			+ ", " + Объект.ВалютаДокумента;
	КонецЕсли;
	
	// Заполним список выбора "Вид первичного документа" (начало).
	// Его состав - текущее значение реквизита объекта
	// и наименования печатных форм, если они отличаются между собой.
	СписокПечатныхФорм = Новый Массив();
	СписокПечатныхФорм.Добавить("Бухгалтерская справка");
	
	// Заполняем по возможности пустые поля формы:
	Если Объект.Ссылка.Пустая() Тогда
		
		Объект.ВидПервичногоДокумента = СписокПечатныхФорм[0];
		
		Объект.ВалютаДокумента = ВалютаРУ;
		
		//Попытка
		//	
		//	ЭтаФорма.ТиповаяОперация = Справочники.ТиповыеОперации.ВводНачальныхОстатков_Студенты;
		//	
		//	ПодключаемыйСервер_ПриИзмененииТиповойОперации("ТиповыеОперации_ТиповаяОперацияДокумента");
		//	
		//Исключение
		//КонецПопытки;
		
		Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.РазделУчета) Тогда
			Объект.РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Студенты;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.КФО) Тогда
			Объект.КФО = Перечисления.КВД.Внебюджет;
		КонецЕсли;
		
	КонецЕсли;
	
	// Заполним список выбора "Вид первичного документа" (окончание).
	ТекВид = Объект.ВидПервичногоДокумента;
	СписокВыбора = Элементы.ВидПервичногоДокумента.СписокВыбора;
	Если НЕ ПустаяСтрока(ТекВид) Тогда
		СписокВыбора.Добавить(ТекВид);
	КонецЕсли;
	Для Каждого ИмяПечФормы Из СписокПечатныхФорм Цикл
		Если НЕ ИмяПечФормы = ТекВид Тогда
			СписокВыбора.Добавить(ИмяПечФормы);
		КонецЕсли;
	КонецЦикла;
	
	УстановитьЗаголовокФормы();
	
	// Настраиваем форму, учитывая, ведется ли учет студентов вообще в программе:
	НастроитьФормуСогласноНастройкамВеденияУчетаСтудентов();
	
	// Заполняем список выбора "КФО" значениями из уч.пол., плюс доп.ограничения:
	ЗаполнитьСписокВыбораКФО();
	
	// Заполняем список выбора полей приказов.
	ЗаполнитьСписокВыбораПолейПриказов();
	
	УстановитьПараметрыВыбораСтудентаСервер();
	
	// Если нет прав на изменение документа, то дополнительно отключаем еще элементы:
	ОбщегоНазначенияБГУ.УстановитьНедоступныеЭлементыФормы(Элементы, Объект,
		"ГруппаКоманднаяПанельВЦелом, СтудентыКоманднаяПанель");
	
	СостояниеСтудентаЗачислен = Справочники.СостоянияСтудентов.НайтиПоНаименованию(НСтр("ru='Зачислен'"));
	ВидУслуг = ?(Объект.НачислениеУчащимсяЗаПрочиеУслуги, 1, 0);
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	СтудентыЗаполнитьДобавленныеКолонки();
	ПорядокОплатыЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект = Форма.Объект;
	
	ЭтоНачислениеПоДолгосрочнымДоговорам =
		(Объект.ВидОперацииНачисленияУчащимся = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам"));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СтраницаПорядокОплаты", "Видимость", ЭтоНачислениеПоДолгосрочнымДоговорам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СтраницаСведенияОбУчащихся", "Видимость", НЕ Объект.НачислениеУчащимсяЗаПрочиеУслуги);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СтудентыДоляОплаты", "Видимость", НЕ Объект.НачислениеУчащимсяЗаПрочиеУслуги);
	
	ЭлементыЗачислитьУчащихся = Новый Массив;
	ЭлементыЗачислитьУчащихся.Добавить("ПринятьДетейВГруппу");
	ЭлементыЗачислитьУчащихся.Добавить("ГруппаСтудентов");
	ЭлементыЗачислитьУчащихся.Добавить("КурсОбучения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ЭлементыЗачислитьУчащихся, "Видимость", НЕ Объект.НачислениеУчащимсяЗаПрочиеУслуги);
	
	ЭлементыНачисленийЗаУслугиОбразования = Новый Массив;
	ЭлементыНачисленийЗаУслугиОбразования.Добавить("СтудентыСтавкаОплаты");
	ЭлементыНачисленийЗаУслугиОбразования.Добавить("СтудентыЛьгота");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ЭлементыНачисленийЗаУслугиОбразования, "Видимость", НЕ Объект.НачислениеУчащимсяЗаПрочиеУслуги И НЕ ЭтоНачислениеПоДолгосрочнымДоговорам);
	
	ЭлементыНачисленийЗаПрочиеУслуги = Новый Массив;
	ЭлементыНачисленийЗаПрочиеУслуги.Добавить("СтудентыНачислениеЗаУслугу");
	ЭлементыНачисленийЗаПрочиеУслуги.Добавить("СтудентыЗаголовокНачалоНачисления");
	ЭлементыНачисленийЗаПрочиеУслуги.Добавить("СтудентыЗаголовокОкончаниеНачисления");
	ЭлементыНачисленийЗаПрочиеУслуги.Добавить("СтудентыНачалоНачисления");
	ЭлементыНачисленийЗаПрочиеУслуги.Добавить("СтудентыОкончаниеНачисления");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ЭлементыНачисленийЗаПрочиеУслуги, "Видимость", Объект.НачислениеУчащимсяЗаПрочиеУслуги);
	
	ЭлементыКраткосрочныеПрочиеУслуги = Новый Массив;
	ЭлементыКраткосрочныеПрочиеУслуги.Добавить("СтудентыЛьготаПрочиеУслуги");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ЭлементыКраткосрочныеПрочиеУслуги, "Видимость", Объект.НачислениеУчащимсяЗаПрочиеУслуги И НЕ ЭтоНачислениеПоДолгосрочнымДоговорам);
	
	ЭлементыДолгосрочныеДоговоры = Новый Массив;
	ЭлементыДолгосрочныеДоговоры.Добавить("СтудентыЗаголовокОстатокРасчетов");
	ЭлементыДолгосрочныеДоговоры.Добавить("СтудентыЗаголовокОстатокДБП");
	ЭлементыДолгосрочныеДоговоры.Добавить("СтудентыОстатокРасчетов");
	ЭлементыДолгосрочныеДоговоры.Добавить("СтудентыОстатокДБП");
	ЭлементыДолгосрочныеДоговоры.Добавить("СтудентыРассчитатьОстаткиПоГрафикамОплаты");
	ЭлементыДолгосрочныеДоговоры.Добавить("СтудентыСпособПризнанияДоходов");
	ЭлементыДолгосрочныеДоговоры.Добавить("СтудентыДатаНачалаСписания");
	ЭлементыДолгосрочныеДоговоры.Добавить("СтудентыДатаОкончанияСписания");
	ЭлементыДолгосрочныеДоговоры.Добавить("СтудентыОтражениеДоходовВУчете");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ЭлементыДолгосрочныеДоговоры, "Видимость", ЭтоНачислениеПоДолгосрочнымДоговорам);
	
	ЭлементыРасчеты = Новый Массив;
	ЭлементыРасчеты.Добавить("СтудентыСчетРасчетов");
	ЭлементыРасчеты.Добавить("СтудентыКПС");
	ЭлементыРасчеты.Добавить("СтудентыДопСубконтоРасчетов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ЭлементыРасчеты, "Видимость", ЗначениеЗаполнено(Объект.ВидОперацииНачисленияУчащимся) );
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Отражение доходов в учете.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СтудентыОтражениеДоходовВУчете");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Студенты.ОтражениеДоходовВУчетеЗаполнено", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НезаполненныйРеквизит);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СтудентыОтражениеДоходовВУчете");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Студенты.ОтражениеДоходовВУчетеЗаполнено", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ГиперссылкаЦвет);
	
	// Параметры списания ДБП.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СтудентыДатаНачалаСписания");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СтудентыДатаОкончанияСписания");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Студенты.СпособПризнанияДоходов",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.СпособыПризнанияРасходов.ПоГрафику);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокОплатыУстановитьОтборВТаблице()
	
	ТекущиеДанные = Элементы.ПорядокОплатыСтуденты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки",
			Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Иначе
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки",
			ТекущиеДанные.ИдентификаторСтроки);
	КонецЕсли;
	
	ТекущийОтборСтрок = Элементы.ПорядокОплаты.ОтборСтрок;
	Если ТекущийОтборСтрок = Неопределено
	 ИЛИ ТекущийОтборСтрок.ИдентификаторСтроки <> НовыйОтборСтрок.ИдентификаторСтроки Тогда
		Элементы.ПорядокОплаты.ОтборСтрок = НовыйОтборСтрок;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьШаблонГрафикаОплатыЗавершение(ВыбранныйГрафикОплат, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранныйГрафикОплат) Тогда
		
		ИтоговаяСуммаПоГрафику = ЗагрузитьШаблонГрафикаОплатыНаСервере(ВыбранныйГрафикОплат, ДопПараметры.ИдентификаторСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьШаблонГрафикаОплатыНаСервере(ВыбранныйГрафикОплат, ИдентификаторСтроки)
	
	// Удаляем строки по выбранному идентификатору из табличной части.
	ОтборПоИдентификатору = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	СтрокиПоИдентификатору = Объект.ПорядокОплатыОбразование.НайтиСтроки(ОтборПоИдентификатору);
	Для Каждого СтрокаГрафика Из СтрокиПоИдентификатору Цикл
		Объект.ПорядокОплатыОбразование.Удалить(Объект.ПорядокОплатыОбразование.Индекс(СтрокаГрафика));
	КонецЦикла;
	
	// Заполняем график оплат по выбранному графику оплат.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГрафикиОплатыОбразование.Ссылка КАК Ссылка,
	|	ГрафикиОплатыОбразование.Валюта КАК Валюта,
	|	ГрафикиОплатыОбразование.РежимВводаГрафикаОплаты КАК РежимВводаГрафикаОплаты,
	|	ГрафикиОплатыОбразование.ПорядокОплаты.(
	|		НомерСтроки КАК НомерСтроки,
	|		ОплатитьДо КАК ОплатитьДо,
	|		СуммаПроцент КАК СуммаВВалюте,
	|		НачалоПериода КАК НачалоПериода,
	|		КонецПериода КАК КонецПериода,
	|		Примечание КАК Примечание
	|	) КАК ПорядокОплаты
	|ИЗ
	|	Справочник.ГрафикиОплатыОбразование КАК ГрафикиОплатыОбразование
	|ГДЕ
	|	ГрафикиОплатыОбразование.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОплатитьДо,
	|	НачалоПериода,
	|	КонецПериода";
	Запрос.УстановитьПараметр("Ссылка", ВыбранныйГрафикОплат);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ВыборкаПорядокОплаты = Выборка.ПорядокОплаты.Выбрать();
		Пока ВыборкаПорядокОплаты.Следующий() Цикл
			НоваяСтрока = Объект.ПорядокОплатыОбразование.Добавить();
			НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПорядокОплаты,
				"ОплатитьДо,СуммаВВалюте,НачалоПериода,КонецПериода,Примечание");
		КонецЦикла;
		
	КонецЦикла;
	
	ПорядокОплатыЗаполнитьДобавленныеКолонки();
	
	ИтогСуммаОплатыПоГрафику = РассчитатьИтоговуюСуммуОплатыПоГрафику(ЭтотОбъект, ИдентификаторСтроки);
	Возврат ИтогСуммаОплатыПоГрафику;
	
КонецФункции

&НаКлиенте
Процедура СохранитьШаблонГрафикаОплатыЗавершение(НаименованиеГрафикаОплаты, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(НаименованиеГрафикаОплаты) Тогда
		
		СохранитьШаблонГрафикаОплатыНаСервере(НаименованиеГрафикаОплаты, ДопПараметры.ИдентификаторСтроки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьШаблонГрафикаОплатыНаСервере(НаименованиеГрафикаОплаты, ИдентификаторСтроки)
	
	ОсобыйПорядокОплаты = ЗначениеЗаполнено(ИдентификаторСтроки);
	
	ГрафикОплатОбъект = Справочники.ГрафикиОплатыОбразование.СоздатьЭлемент();
	ГрафикОплатОбъект.Наименование = НаименованиеГрафикаОплаты;
	
	ГрафикОплатОбъект.Валюта = Объект.ВалютаДокумента;
	
	// Сохраняем строки по выбранному идентификатору из табличной части.
	ОтборПоИдентификатору = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	СтрокиПоИдентификатору = Объект.ПорядокОплатыОбразование.НайтиСтроки(ОтборПоИдентификатору);
	Для Каждого СтрокаГрафика Из СтрокиПоИдентификатору Цикл
		НоваяСтрока = ГрафикОплатОбъект.ПорядокОплаты.Добавить();
		НоваяСтрока.СуммаПроцент = СтрокаГрафика.СуммаВВалюте;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика,
			"ОплатитьДо,НачалоПериода,КонецПериода,Примечание");
	КонецЦикла;
	
	Попытка
		ГрафикОплатОбъект.Записать();
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Записан новый элемент ""%1"" справочника ""Графики оплат"" в разделе ""Платное обучение - Долгосрочные договоры"".'"), НаименованиеГрафикаОплаты);
	Исключение
		ТекстСообщения = НСтр("ru='Не удалось записать новый элемент справочника ""Графики оплат (образование)"".'")
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьИтоговуюСуммуОплатыПоГрафику(Форма, ИдентификаторСтроки)
	
	Объект = Форма.Объект;
	
	ОтборСтрок = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	ГрафикОплаты = Объект.ПорядокОплатыОбразование.НайтиСтроки(ОтборСтрок);
	
	ИтогСуммаОплатыПоГрафику = 0;
	Для Каждого СтрокаГрафика Из ГрафикОплаты Цикл
		ИтогСуммаОплатыПоГрафику = ИтогСуммаОплатыПоГрафику + СтрокаГрафика.СуммаВВалюте;
	КонецЦикла;
	
	Возврат ИтогСуммаОплатыПоГрафику;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьОстаткиПоГрафикамОплатыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьОстаткиПоГрафикамОплатыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьОстаткиПоГрафикамОплатыНаСервере();
	
	Документы.ВводНачальныхОстатков.РассчитатьПоГрафикамОплаты_Студенты(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыЗадолженностиПереплатыПоДолгосрочномуДоговору(СтрокаСтуденты)
	
	СтрокаСтуденты.СуммаЗадолженность = ?(СтрокаСтуденты.ОстатокРасчетов > СтрокаСтуденты.ОстатокДБП, СтрокаСтуденты.ОстатокРасчетов - СтрокаСтуденты.ОстатокДБП, 0);
	СтрокаСтуденты.СуммаПереплата     = ?(СтрокаСтуденты.ОстатокРасчетов < СтрокаСтуденты.ОстатокДБП, СтрокаСтуденты.ОстатокДБП - СтрокаСтуденты.ОстатокРасчетов, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияДоходовВУчете(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.Студенты.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Организация, ИФО, КФО, КПС");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	ПараметрыФормы.Вставить("Дата", ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(Объект.Дата));
	ПараметрыФормы.Вставить("Подразделение", Объект.Факультет);
	
	ПараметрыФормы.Вставить("РежимДоходы", Истина);
	ПараметрыФормы.Вставить("ИмяРеквизитаСчет", "СчетДоходов");
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	ПараметрыФормы.Вставить("ЕстьНалоговыйУчет", Истина);
	
	// КФО, КПС и КЭК устанавливаются в шапке, изменять их не нужно.
	ПараметрыФормы.Вставить("ВидимостьКФО",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКПС",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКЭК",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКоличество",Ложь);
	
	// Подразделение определяется по остаткам 401.40 при признании доходов текущего периода.
	ПараметрыФормы.Вставить("ВидимостьПодразделение", Ложь);
	
	// Бухгалтерский учет.
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.СчетДоходов);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.СубконтоДоходов1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.СубконтоДоходов2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.СубконтоДоходов3);
	
	ПараметрыСчета = Новый Структура;
	ПараметрыСчета.Вставить("ОграниченияСчета", "401.10");
	ПараметрыСчета.Вставить("ВыбиратьЗапрещенныеВПроводках", Ложь);
	ПараметрыФормы.Вставить("ПараметрыСчета", ПараметрыСчета);
	
	// Налоговый учет.
	ПараметрыФормы.Вставить("ВидДеятельностиНУ",      ДанныеСтроки.ВидДеятельностиНУ);
	ПараметрыФормы.Вставить("СчетНУ",                 ДанныеСтроки.СчетДоходовНУ);
	ПараметрыФормы.Вставить("СтатьяПрочихДоходовНУ",  ДанныеСтроки.СтатьяПрочихДоходовНУ);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Настройка отражения в учете доходов текущего периода'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет",  НСтр("ru = 'Счет доходов'"));
	
	ПараметрыСчетаНУ = Новый Структура;
	ПараметрыСчетаНУ.Вставить("ОграниченияСчета", "Н90.01,Н91.01");
	ПараметрыСчетаНУ.Вставить("ВыбиратьЗапрещенныеВПроводках", Ложь);
	ПараметрыФормы.Вставить("ПараметрыСчетаНУ", ПараметрыСчетаНУ);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияДоходовВУчетеНаКлиенте(СтруктураОтражениеВУчете)

	ТекущиеДанные = Элементы.Студенты.ТекущиеДанные;
	
	// Бухгалтерский учет.
	ТекущиеДанные.СчетДоходов      = СтруктураОтражениеВУчете.Счет;
	ТекущиеДанные.СубконтоДоходов1 = СтруктураОтражениеВУчете.Субконто1;
	ТекущиеДанные.СубконтоДоходов2 = СтруктураОтражениеВУчете.Субконто2;
	ТекущиеДанные.СубконтоДоходов3 = СтруктураОтражениеВУчете.Субконто3;
	
	// Налоговый учет.
	ТекущиеДанные.ВидДеятельностиНУ     = СтруктураОтражениеВУчете.ВидДеятельностиНУ;
	ТекущиеДанные.СчетДоходовНУ         = СтруктураОтражениеВУчете.СчетНУ;
	ТекущиеДанные.СтатьяПрочихДоходовНУ = СтруктураОтражениеВУчете.СтатьяПрочихДоходовНУ;
	
	ЗаполнитьДобавленныеКолонкиОтраженияДоходовВУчете(ЭтотОбъект, ТекущиеДанные);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДобавленныеКолонкиОтраженияДоходовВУчете(Форма, СтрокаТаблицы)
	
	Объект = Форма.Объект;
	
	Параметры = Новый Структура;
	Параметры.Вставить("РежимДоходы", Истина);
	Параметры.Вставить("ОтражатьВНалоговомУчете", Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(Объект.КФО));
	
	ПоляФормы = Новый Структура("Счет,Субконто1,Субконто2,Субконто3,СчетНУ,ВидДеятельностиНУ,СтатьяПрочихДоходовНУ,ОтражениеВУчете",
		"СчетДоходов",
		"СубконтоДоходов1",
		"СубконтоДоходов2",
		"СубконтоДоходов3",
		"СчетДоходовНУ",
		"ВидДеятельностиНУ",
		"СтатьяПрочихДоходовНУ",
		"ОтражениеДоходовВУчете");
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, Параметры, ПоляФормы);
	
КонецПроцедуры


&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение = Неопределено)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОрганизацияПередИзменениемКлиент_Ответ", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении,
		НСтр("ru='Изменение организации вызовет очистку
		|табличной части документа.
		|
		|Продолжить и сменить организацию?'"),
		РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Объект["Организация"] = ПараметрыОповещения["ВыбранноеЗначение"];
		ЭтаФорма.Модифицированность = Истина;
		ОрганизацияПриИзмененииКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПриИзмененииКлиент()
	
	ОрганизацияПриИзмененииСервер();
	
	НастроитьФормуКлиент();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры
&НаСервере
Процедура ОрганизацияПриИзмененииСервер()
	
	ОчиститьРеквизитыТабличнойЧастиНесоответствующиеОрганизации();
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьРеквизитыТабличнойЧастиНесоответствующиеОрганизации()
	
	// Очищаем табличную часть документа:
	Объект["Студенты"].Очистить();
	ЭтаФорма["Плательщики"].Очистить();
	ЭтаФорма["ПлательщикиКоличествоСтрок"] = 0;
	
	// Устанавливаем новую дату документа:
	Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
	
	// Заполняем список выбора "КФО" значениями из уч.пол., плюс доп.ограничения:
	ЗаполнитьСписокВыбораКФО();
	
КонецПроцедуры

// Очищает зависимое поле суммы. ИмяРедактируемогоПоля="СуммаЗадолженность" или "СуммаПереплата".
&НаКлиенте
Процедура ОчиститьЗависимоеПолеСуммы(ТекДанные, ИмяРедактируемогоПоля)
	
	ИмяЗависимогоПоля = ?(ИмяРедактируемогоПоля = "СуммаЗадолженность", "СуммаПереплата", "СуммаЗадолженность");
	
	Если НЕ ТекДанные[ИмяРедактируемогоПоля] = 0 Тогда
		
		ТекДанные[ИмяЗависимогоПоля] = 0;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКурсВалюты(Валюта, Дата)
	
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, Дата);
	
КонецФункции

&НаКлиенте
Процедура НастроитьДоступностьЭлементовБлокаВалюты()
	
	// Настраиваем форму, только если она вообще в рабочем режиме:
	Если РазрешитьРаботуСФормой Тогда
		ВалютаУказана = НЕ (Объект.ВалютаДокумента = ВалютаРУ);
		
		// Шапка:
		Элементы.КурсВзаиморасчетов.Доступность			= ВалютаУказана;
		Элементы.КратностьВзаиморасчетов.Доступность	= ВалютаУказана;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуПлательщикиСервер()
	
	ЗапросПлательщики = Новый Запрос("
	|ВЫБРАТЬ
	|	ТЗ.Контрагент,
	|	ТЗ.Договор,
	|	ТЗ.СуммаЗадолженность,
	|	ТЗ.СуммаПереплата
	|
	|ПОМЕСТИТЬ
	|	Студенты
	|ИЗ
	|	&ТЗ	КАК ТЗ
	|;
	|
	|ВЫБРАТЬ
	|	Контрагент,
	|	Договор,
	|	СУММА(СуммаЗадолженность)	КАК Задолженность,
	|	СУММА(СуммаПереплата)		КАК Переплата
	|
	|ИЗ
	|	Студенты
	|
	|СГРУППИРОВАТЬ ПО
	|	Контрагент,
	|	Договор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент.Наименование,
	|	Договор.Наименование
	|;");
	
	ЗапросПлательщики.УстановитьПараметр("ТЗ", Объект.Студенты.Выгрузить(, "Контрагент, Договор, СуммаЗадолженность, СуммаПереплата"));
	
	Плательщики.Загрузить(ЗапросПлательщики.Выполнить().Выгрузить());
	ПлательщикиКоличествоСтрок = Плательщики.Количество();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСогласноНастройкамВеденияУчетаСтудентов()
	
	ИспользоватьУчетСтудентов = ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтудентов");
	
	РазрешитьРаботуСФормой = ИспользоватьУчетСтудентов
		И ПравоДоступа("Изменение", Объект.Ссылка.Метаданные());
	
	Если НЕ ИспользоватьУчетСтудентов Тогда
		
		// В программе не ведется учет студентов.
		ТекстСообщения = НСтр("ru='В программе не ведется учет расчетов по образовательным услугам. Документ не предназначен для работы в таком режиме.
			|Включить учет расчетов по образовательным услугам можно в разделе «Учет расчетов по образовательные услуги» в настройках параметров учета (по гиперссылке «Специализированные подсистемы» в разделе «Администрирование - Настройка параметров учета»).'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Объект.Ссылка);
		
		ИменаДоступность = "
			// Командные панели:
			|ФормаКоманднаяПанель,
			|СтудентыКоманднаяПанель,
			|ГруппаКоманднаяПанельВЦелом,
			// Отдельные элементы:
			|ГруппаШапка,
			|Комментарий";
		// Все элементы на вкладке "Бухгалтерская операция":	
		Для Каждого Элем Из Элементы.БухгалтерскаяОперация.ПодчиненныеЭлементы Цикл
			ИменаДоступность = ИменаДоступность + "," + Элем.Имя;
		КонецЦикла;
		ИменаДоступность = Новый Структура(ИменаДоступность);
		
		ИменаТолькоПросмотр = Новый Структура("
			|Студенты,
			|Плательщики");
		
		Для Каждого Элем Из ИменаДоступность Цикл
			Элементы[Элем.Ключ].Доступность = Ложь;
		КонецЦикла;
		
		Для Каждого Элем Из ИменаТолькоПросмотр Цикл
			Элементы[Элем.Ключ].ТолькоПросмотр = Истина;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоступностьГруппыИКурса()
	
	ГруппаКурс = Новый Массив;
	ГруппаКурс.Добавить("ГруппаСтудентов");
	ГруппаКурс.Добавить("КурсОбучения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ГруппаКурс, "Доступность", Объект.ПринятьДетейВГруппу);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтудентыСостояниеСтудента", "Видимость", Объект.ПринятьДетейВГруппу И НЕ Объект.НачислениеУчащимсяЗаПрочиеУслуги);
	
КонецПроцедуры

// Заполняет список выбора "КФО" значениями из уч.пол., плюс доп.ограничения (КФО=2 или 4).
&НаСервере
Процедура ЗаполнитьСписокВыбораКФО()
	
	СписокЗначенийКФО = Новый СписокЗначений;
	
	БухгалтерскийУчет.ЗаполнитьСписокКФО(
		СписокЗначенийКФО,
		Объект.КФО,
		ПолучитьМассивКФОНаСервере(),
		"КФО",
		"",
		Новый Структура("Организация, ИФО, Дата, НаНачалоСледующегоГода", Объект.Организация, Объект.ИФО, Объект.Дата, Истина));
		
	Элементы.КФО.СписокВыбора.ЗагрузитьЗначения(СписокЗначенийКФО.ВыгрузитьЗначения());
	Элементы.КФО.РежимВыбораИзСписка = Истина;
	
КонецПроцедуры
&НаСервереБезКонтекста
Функция ПолучитьМассивКФОНаСервере()
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.КВД.Бюджет);
	Результат.Добавить(Перечисления.КВД.Внебюджет);
	Результат.Добавить(Перечисления.КВД.СубсидииНаГосзадание);
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКонтрагента(ДоговорСсылка)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "Контрагент");
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокВыбораПолейПриказов()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИсключаемыеПоляПриказов",
		Документы.ВводНачальныхОстатков.ИсключаемыеПоляПриказовОбразование());
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоляПриказовОбразование.Ссылка КАК Поле
	|ИЗ
	|	ПланВидовХарактеристик.ПоляПриказовОбразование КАК ПоляПриказовОбразование
	|ГДЕ
	|	НЕ ПоляПриказовОбразование.Ссылка В (&ИсключаемыеПоляПриказов)
	|	И НЕ ПоляПриказовОбразование.ПометкаУдаления";
	СписокПолей = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Поле");
	
	Элементы.СведенияОСтудентахПоле.СписокВыбора.ЗагрузитьЗначения(СписокПолей);
	Элементы.СведенияОСтудентахПоле.РежимВыбораИзСписка = Истина;
	
КонецПроцедуры

