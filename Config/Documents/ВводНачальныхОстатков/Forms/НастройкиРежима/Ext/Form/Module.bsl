&НаКлиенте
Перем ТекстЗаголовкаСообщений;

&НаКлиенте
Перем ЗакрытьФормуБезусловно;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВстроеннаяСправка = ПолучитьТекстВстроеннойСправки();
	
	ОтражатьВБухгалтерскомУчете	= Параметры.ОтражатьВБухгалтерскомУчете;
	ОтражатьВНалоговомУчете		= Параметры.ОтражатьВНалоговомУчете;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Режим ввода остатков'");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗакрытьФормуБезусловно = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.Модифицированность Тогда
		Отказ = Истина;
		
		Если ЗавершениеРаботы Тогда
			ТекстПредупреждения = НСтр("ru='Изменения режима ввода остатков будут потеряны'");
			Возврат;
		КонецЕсли;
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
		
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, НСтр("ru='Данные были изменены. Сохранить изменения?'"),
			РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьИЗакрытьФорму();
		
	ИначеЕсли РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		ЗакрытьФормуБезусловно = Истина;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ПроверитьИЗакрытьФорму();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьТекстВстроеннойСправки()
	
	ИдКартинки		= "2889ef9d-5091-4de3-bbcc-62e307ab7cad"; // БиблиотекаКартинок.ПодатьИдею
	
	ВставляемыеЗначения = Новый Структура();
	ВставляемыеЗначения.Вставить("ИдКартинки", ИдКартинки);
	
	АдресШаблон = "v8config://v8cfgHelp/mdpicture/id[ИдКартинки]/00000000-0000-0000-0000-000000000000";
	
	АдресКартинки = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(АдресШаблон, ВставляемыеЗначения);
	
	ТекстHtml = "
		|<HTML>
		|	<HEAD>
		|		<META http-equiv=Content-Type content=""text/html; charset=utf-8"">
		|		<STYLE type=text/css>
		|			H6 {
		|				font-size: 10pt;
		|			}
		|			IMG {
		|				margin-right: 5px;
		|				vertical-align: middle;
		|			}
		|			P {
		|				margin: 0px 0px 4px 5px;
		|			}
		|			UL {
		|				margin-top: 5px;
		|			}
		|			LI {
		|				margin: 0px 0px 4px 0px;
		|			}
		|			BODY {
		|				margin: 10px;
		|				font-size: 10pt;
		|				font-family: ""MS Sans Serif"";
		|				color: #333333;
		|			}		
		|		</STYLE>
		|	</HEAD>
		|	<BODY>
		|		<H6><IMG src=" + АдресКартинки + " /> Режим ввода остатков</H6>
		|		<P>Настройка режима ввода остатков может применяться, например, в следующих случаях:</P>
		|		<UL>
		|			<LI>при начале ведения налогового учета, если в информационной базе уже ведется бухгалтерский учет (ввод остатков по бухгалтерскому учету не нужен, остатки вводятся только по налоговому учету);</LI>
		|			<LI>при смене системы налогообложения (остатки вводятся только по налоговому учету);</LI>
		|			<LI>при отражении прочих ситуаций, когда требуется доввести или скорректировать входящие остатки.</LI>
		|		</UL>
		|		<P>При вводе начальных остатков в новой информационной базе режим ввода остатков настраивать не нужно, оба флага должны быть установлены.</P>
		|	</BODY>
		|</HTML>";
	
	Возврат ТекстHtml;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИЗакрытьФорму()
	
	// Флажки установлены корректно?
	ТекстСообщения = "";
	Если ФлагиОтраженияВУчетеЗаполненыКорректно(ТекстСообщения) Тогда
		// Да, корректно.
		ПараметрЗакрытия = Новый Структура;
		ПараметрЗакрытия.Вставить("ОтражатьВБухгалтерскомУчете",	ОтражатьВБухгалтерскомУчете);
		ПараметрЗакрытия.Вставить("ОтражатьВНалоговомУчете",		ОтражатьВНалоговомУчете);
		
		ЭтаФорма.Модифицированность = Ложь;
		
		Закрыть(ПараметрЗакрытия);
	Иначе
		// Нет, с ошибками.
		ТекстСообщения = ТекстСообщения
			+ НСтр("ru='
			|
			|Измените состояние флажков.'");
		ПоказатьПредупреждение(, ТекстСообщения, 40, ТекстЗаголовкаСообщений);
	КонецЕсли
	
КонецПроцедуры

&НаСервере
Функция ФлагиОтраженияВУчетеЗаполненыКорректно(ТекстСообщения)
	
	Перем РезультатПроверки;
	
	ИсхДанные = Документы.ВводНачальныхОстатков.РежимВводаОстатков_СтруктураШапкиДокумента();
	ЗаполнитьЗначенияСвойств(ИсхДанные, Параметры);
	ЗаполнитьЗначенияСвойств(ИсхДанные, ЭтаФорма);
	
	Результат = Документы.ВводНачальныхОстатков.РежимВводаОстатков_ПроверитьЗаполнение(ИсхДанные, РезультатПроверки);
	ТекстСообщения = РезультатПроверки["ТекстСообщения"];
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
