&НаКлиенте
Перем ТекстЗаголовкаСообщений;

&НаКлиенте
Перем СледуетЗакрытьФорму;

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Инициализация:
	// Проверим права пользователя:
	ПравоДоступаИзменение = ПравоДоступа("Изменение", Объект.Ссылка.Метаданные());
	ПрефиксИмениСвойстваОС = "ОС_";
	ИспользоватьУчетПоИФО				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	НастройкаФормы_Счет40120 = ПланыСчетов.ЕПСБУ.НайтиПоКоду("401.20");
	
	// Заполняем реквизиты этой формы значениями, переданными из основной формы:
	ЗаполнитьПереданнойИнформацией();
			
	// Настраиваем элементы формы в зависимости от счета, учетной политики и реквизитов формы:
	НастроитьФормуПриСтарте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Ввод начальных остатков ОС'");
	
	ОбновитьКомментарийСрокаПолезногоИспользования();
	
	УстановитьДоступностьСобытийОС();
	НастроитьФормуВЗависимостиОтВидаНФА();
	
	// Налоговый учет (ОСН)
	НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовНУ();
	НастроитьФормуВЗависимостиОтМетодНачисленияАмортизацииНУ();
	НастроитьДоступностьСтатьяПрочихРасходовНУОСН();
	
	// Налоговый учет (УСН)
	НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовУСН();
	
	РассчитатьАмортизациюАвтоматически();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если НЕ СледуетЗакрытьФорму = Истина Тогда
		Если Модифицированность Тогда
			Отказ = Истина;
			
			ТекстВопроса = НСтр("ru='Данные были изменены. Сохранить изменения?'");
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПередЗакрытием_Ответ", ЭтотОбъект);
			
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Отмена);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПередЗакрытием_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		СохранитьИЗакрыть();
		
	ИначеЕсли РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		СледуетЗакрытьФорму = Истина;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Очистить();
	
	// Реквизиты с обязательным заполнением
	ШапкаДокумента = Документы.ВводНачальныхОстатков.РежимВводаОстатков_СтруктураШапкиДокумента();
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, ЭтаФорма);
	ПрименяемыйРежимВводаОстатков = Неопределено;
	Документы.ВводНачальныхОстатков.ЗаполнитьСписокПроверяемыхОбязательныхРеквизитов_ОС(
		ШапкаДокумента,
		ПроверяемыеРеквизиты,
		Неопределено, // ПроверяемыеСубконто,
		Неопределено, // ПроверяемыеПризнакиУчета,
		Неопределено, // ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
		Неопределено, // ПеренаправлениеВыводаСообщений_Реквизиты,
		Неопределено, // ИсключаемыеРеквизиты,
		Истина,	// ЭтоПроверкаВФормеРедактированияСтроки
		ПрименяемыйРежимВводаОстатков);
		
	// Исключаем из проверки реквизиты, недоступные для редактирования на этой форме (только просмотр)
	Документы.ВводНачальныхОстатков.УдалитьПроверяемыйРеквизит("ИФО",	ПроверяемыеРеквизиты);
	Документы.ВводНачальныхОстатков.УдалитьПроверяемыйРеквизит("КФО",	ПроверяемыеРеквизиты);
	Документы.ВводНачальныхОстатков.УдалитьПроверяемыйРеквизит("КПС",	ПроверяемыеРеквизиты);
	Документы.ВводНачальныхОстатков.УдалитьПроверяемыйРеквизит("КЭК",	ПроверяемыеРеквизиты);
	Документы.ВводНачальныхОстатков.УдалитьПроверяемыйРеквизит("Счет",	ПроверяемыеРеквизиты);
		
	// Проверяем взаимосвязанные значения реквизитов
	ПараметрыПроверкиПоСтроке = Документы.ВводНачальныхОстатков.ПолучитьПараметрыПроверкиПоСтроке_ОС(ЭтаФорма);
	ПараметрыПроверкиПоСтроке.Вставить("ПрименяемыеПределыСтоимостиОС", Документы.ВводНачальныхОстатков.ОпределитьПрименяемыеПределыСтоимостиОС(ЭтаФорма));
	СтруктураОшибок = Документы.ВводНачальныхОстатков.ПроверкаПоСтроке_ОС(ЭтаФорма, ПараметрыПроверкиПоСтроке, ПрименяемыйРежимВводаОстатков);
	Если СтруктураОшибок.Количество() > 0 Тогда
		// Выявлены ошибки.
		Отказ = Истина;
		// Выводим сообщения:
		Для Каждого Элем Из СтруктураОшибок Цикл
			ИмяПоляДляВыводаСообщений	= Элем.Ключ;
			ТекстСообщения				= Элем.Значение;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстСообщения,
				,
				ИмяПоляДляВыводаСообщений);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ОСОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("Ключ", ОС);
	ОписаниеОповещения_Закрытие = Новый ОписаниеОповещения("ОСОткрытие_Закрытие", ЭтотОбъект);
	ОткрытьФорму("Справочник.ОсновныеСредства.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения_Закрытие, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
&НаКлиенте
Процедура ОСОткрытие_Закрытие(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	КэшироватьСвойстваОСНаФорму();
	
КонецПроцедуры

// ----- Страница "Общие сведения" -----

&НаКлиенте
Процедура ОСКодПоОКОФПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(КодПоОКОФ) Тогда
		
		
		УправлениеОсновнымиСредствамиКлиент.НачалоВыбораАмортизационнойГруппы(Элементы.ОС_АмортизационнаяГруппа, Неопределено, Ложь, КодПоОКОФ, АмортизационнаяГруппа, Ложь);
		
		
		СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(
		АмортизационнаяГруппа);
		
		Если СрокПолезногоИспользованияНУ = 0 Тогда
			СрокПолезногоИспользованияНУ = СрокПолезногоИспользования;
		КонецЕсли;
		
		ОбновитьКомментарийСрокаПолезногоИспользования();
		
	Иначе
		АмортизационнаяГруппа = ПредопределенноеЗначение("Перечисление.АмортизационныеГруппы.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОСКодПоОКОФНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("КодТекущейСтроки", Элемент.ТекстРедактирования);
	ОткрытьФорму("Справочник.ОбщероссийскийКлассификаторОсновныхФондов.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_АмортизационнаяГруппаПриИзменении(Элемент)
	
	СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(
		АмортизационнаяГруппа);
		
	Если СрокПолезногоИспользованияНУ = 0 Тогда
		СрокПолезногоИспользованияНУ = СрокПолезногоИспользования;
	КонецЕсли;
	
	ОбновитьКомментарийСрокаПолезногоИспользования();
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_АмортизационнаяГруппаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	УправлениеОсновнымиСредствамиКлиент.НачалоВыбораАмортизационнойГруппы(Элемент, ДанныеВыбора, СтандартнаяОбработка, КодПоОКОФ, АмортизационнаяГруппа);

КонецПроцедуры

&НаКлиенте
Процедура ОС_АмортизационнаяГруппаНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	УправлениеОсновнымиСредствамиКлиент.НачалоВыбораАмортизационнойГруппы(Элемент, Неопределено, СтандартнаяОбработка, КодПоОКОФ, АмортизационнаяГруппа);
	
КонецПроцедуры


&НаКлиенте
Процедура ПервоначальнаяСтоимостьПриИзменении(Элемент)
	
	Если Сумма = 0 Тогда
		Сумма = ПервоначальнаяСтоимость;
	КонецЕсли;
	
	Если ПервоначальнаяСтоимостьНУ = 0 Тогда
		ПервоначальнаяСтоимостьНУ = ПервоначальнаяСтоимость;
		
		Если СуммаНУ = 0 Тогда
			СуммаНУ = ПервоначальнаяСтоимостьНУ;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура СуммаПриИзменении(Элемент)
	
	ПервоначальнаяСтоимость = ?(Количество>0, Сумма/Количество, 0);
	
	РассчитатьАмортизациюАвтоматически();
	
КонецПроцедуры
&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)
	
	ПервоначальнаяСтоимость		= ?(Количество>0, Сумма/Количество, 0);
	ПервоначальнаяСтоимостьНУ	= ?(Количество>0, СуммаНУ/Количество, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаАмортизацииПриИзменении(Элемент)
	
	Если СуммаАмортизацииНУ = 0 Тогда
		СуммаАмортизацииНУ = СуммаАмортизации;
	КонецЕсли;
	
	РассчитатьАмортизациюАвтоматически();
	
КонецПроцедуры

// ----- Страница "События" -----

&НаКлиенте
Процедура СостояниеОСПриИзменении(Элемент)
	
	УстановитьДоступностьСобытийОС();
	
	Если НЕ ЗначениеЗаполнено(СостояниеОС) Тогда
		ДатаВводаВЭксплуатацию		= Дата(1,1,1);
		ДатаПринятияКУчету			= Дата(1,1,1);
		НазваниеДокументаВводаВЭксплуатацию	= "";
		НазваниеДокументаПринятияКУчету		= "";
		НомерДокументаВводаВЭксплуатацию	= "";
		НомерДокументаПринятияКУчету		= "";
	КонецЕсли;
	
	РассчитатьАмортизациюАвтоматически();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПринятияКУчетуПриИзменении(Элемент)
	
	Если ВводВЭксплуатациюОдновременноСПринятиемКУчету Тогда
		ДатаВводаВЭксплуатацию = ДатаПринятияКУчету;
	КонецЕсли;
	
	РассчитатьАмортизациюАвтоматически();
	
КонецПроцедуры
&НаКлиенте
Процедура НазваниеДокументаПринятияКУчетуПриИзменении(Элемент)
	
	Если ВводВЭксплуатациюОдновременноСПринятиемКУчету Тогда
		НазваниеДокументаВводаВЭксплуатацию = НазваниеДокументаПринятияКУчету;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура НомерДокументаПринятияКУчетуПриИзменении(Элемент)

	Если ВводВЭксплуатациюОдновременноСПринятиемКУчету Тогда
		НомерДокументаВводаВЭксплуатацию = НомерДокументаПринятияКУчету;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОдновременноСПринятиемКУчетуПриИзменении(Элемент)
	
	ОбработатьИзменениеОдновременноСПринятиемКУчетуПриИзменении();
	
	РассчитатьАмортизациюАвтоматически();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаВводаВЭксплуатациюПриИзменении(Элемент)
	
	РассчитатьАмортизациюАвтоматически();
	
КонецПроцедуры

// ----- Страница "Амортизация" -----

&НаКлиенте
Процедура СрокПолезногоИспользованияПриИзменении(Элемент)
	
	ОбновитьКомментарийСрокаПолезногоИспользования("БУ");
	
	Если СрокПолезногоИспользованияНУ = 0 Тогда
		СрокПолезногоИспользованияНУ = СрокПолезногоИспользования;
		ОбновитьКомментарийСрокаПолезногоИспользования("НУ");
	КонецЕсли;
	
	РассчитатьАмортизациюАвтоматически();
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокПогашенияСтоимостиПриИзменении(Элемент)
	
	// Подготовка:
	Если НЕ ЗначениеЗаполнено(ДатаПринятияКУчету) ИЛИ НЕ ЗначениеЗаполнено(ДатаВводаВЭксплуатацию) Тогда
		ДатаВвода = Макс(ДатаПринятияКУчету, ДатаВводаВЭксплуатацию);
	Иначе
		ДатаВвода = Мин(ДатаПринятияКУчету, ДатаВводаВЭксплуатацию);
	КонецЕсли;
	Цена = ?(Количество = 0, 0, Сумма / Количество);
	
	ПараметрыВыбора = УправлениеОсновнымиСредствамиКлиент.ПараметрыВыбораПараметровНачисленияАмортизации();
	ПараметрыВыбора.ПорядокПогашенияСтоимости	= ПорядокПогашенияСтоимости;
	ПараметрыВыбора.ДатаВвода					= ДатаВвода;
	ПараметрыВыбора.ВидНФА						= ВидНФА; 
	ПараметрыВыбора.СтоимостьНФА				= Цена;
	ПараметрыВыбора.СчетУчетаЗабалансовый		= ОС_СчетУчета_Забалансовый;
	
	УправлениеОсновнымиСредствамиКлиент.ПорядокПогашенияСтоимостиПриИзменении(	
					СпособНачисленияАмортизации,
					НачислятьАмортизацию,
					ПараметрыВыбора);
					
	УстановитьДоступностьПараметровАмортизации();
	
	РассчитатьАмортизациюАвтоматически();
	
КонецПроцедуры
&НаКлиенте
Процедура ПорядокПогашенияСтоимостиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	// Подготовка:
	Если НЕ ЗначениеЗаполнено(ДатаПринятияКУчету) ИЛИ НЕ ЗначениеЗаполнено(ДатаВводаВЭксплуатацию) Тогда
		ДатаВвода = Макс(ДатаПринятияКУчету, ДатаВводаВЭксплуатацию);
	Иначе
		ДатаВвода = Мин(ДатаПринятияКУчету, ДатаВводаВЭксплуатацию);
	КонецЕсли;
	Цена = ?(Количество = 0, 0, Сумма / Количество);
	
	ПараметрыВыбора = УправлениеОсновнымиСредствамиКлиент.ПараметрыВыбораПараметровНачисленияАмортизации();
	ПараметрыВыбора.ПорядокПогашенияСтоимости	= ПорядокПогашенияСтоимости;
	ПараметрыВыбора.ДатаВвода					= ДатаВвода;
	ПараметрыВыбора.ВидНФА						= ВидНФА; 
	ПараметрыВыбора.СтоимостьНФА				= Цена;
	ПараметрыВыбора.БиблФонд					= УправлениеОсновнымиСредствамиКлиентСервер.ЭтоБиблиотечныйФонд(Счет);
	ПараметрыВыбора.Здание						= УправлениеОсновнымиСредствамиКлиентСервер.ЭтоЗданиеСооружение(Счет);
	УправлениеОсновнымиСредствамиКлиент.ПорядокПогашенияСтоимостиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, ПараметрыВыбора); 
	
КонецПроцедуры

&НаКлиенте
Процедура СпособНачисленияАмортизацииПриИзменении(Элемент)
	
	УстановитьДоступностьПараметровАмортизации();			
	
	РассчитатьАмортизациюАвтоматически();
	
КонецПроцедуры
&НаКлиенте
Процедура СпособНачисленияАмортизацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	// Подготовка:
	Если НЕ ЗначениеЗаполнено(ДатаПринятияКУчету) ИЛИ НЕ ЗначениеЗаполнено(ДатаВводаВЭксплуатацию) Тогда
		ДатаВвода = Макс(ДатаПринятияКУчету, ДатаВводаВЭксплуатацию);
	Иначе
		ДатаВвода = Мин(ДатаПринятияКУчету, ДатаВводаВЭксплуатацию);
	КонецЕсли;
	Дата2009 = '20090101';
	Если ДатаВвода < Дата2009 Тогда
		ДатаВвода = Дата2009;
	КонецЕсли;
	
	Цена = ?(Количество = 0, 0, Сумма / Количество);
	
	ПараметрыВыбора = УправлениеОсновнымиСредствамиКлиент.ПараметрыВыбораПараметровНачисленияАмортизации();
	ПараметрыВыбора.ПорядокПогашенияСтоимости	= ПорядокПогашенияСтоимости;
	ПараметрыВыбора.ДатаВвода					= ДатаВвода;
	ПараметрыВыбора.ВидНФА						= ВидНФА; 
	ПараметрыВыбора.СтоимостьНФА				= Цена;
	УправлениеОсновнымиСредствамиКлиент.СпособНачисленияАмортизацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, ПараметрыВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаЗатратПриИзменении(Элемент)
	
	УправлениеОсновнымиСредствамиКлиент.СчетУчетаЗатратПриИзменении(Элемент, СчетУчетаЗатрат, КЭКЗатрат);
	
	СтруктураИменЭлементов = Новый Структура();
	СтруктураИменЭлементов.Вставить("СчетФормы",						"СчетУчетаЗатрат");
	СтруктураИменЭлементов.Вставить("Субконто1",						"СубконтоЗатрат1");
	СтруктураИменЭлементов.Вставить("Субконто2",						"СубконтоЗатрат2");
	СтруктураИменЭлементов.Вставить("Субконто3",						"СубконтоЗатрат3");
	СтруктураИменЭлементов.Вставить("Подразделение",					"ПодразделениеЗатрат");
	СтруктураИменЭлементов.Вставить("ОчищатьОтстуствующие",				Истина);
	СтруктураИменЭлементов.Вставить("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	СтруктураИменЭлементов.Вставить("СубконтоФормы1",					"СубконтоЗатрат1");
	СтруктураИменЭлементов.Вставить("СубконтоФормы2",					"СубконтоЗатрат2");
	СтруктураИменЭлементов.Вставить("СубконтоФормы3",					"СубконтоЗатрат3");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьЗаголовкиСубконто(ЭтаФорма, Объект, СтруктураИменЭлементов);
	
	НастроитьДоступностьСтатьяПрочихРасходовНУОСН();
	
КонецПроцедуры
&НаКлиенте
Процедура СчетУчетаЗатратНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	УправлениеОсновнымиСредствамиКлиент.СчетУчетаЗатратНачалоВыбора(Элемент, 
																	ДанныеВыбора, 
																	СтандартнаяОбработка,
																	Новый Структура("Счет, КПС, КФО, Организация, ИФО, Дата",
																					СчетУчетаЗатрат,
																					КПСЗатрат,
																					КФО,
																					Организация,
																					ИФО,
																					ПолучитьДатуКлиентСервер(Дата)));
КонецПроцедуры
&НаКлиенте
Процедура СчетУчетаЗатратОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
															КПСЗатрат,
															,
															,);
															
КонецПроцедуры

&НаКлиенте
Процедура КЭКСчетаУчетаЗатратНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(СчетУчетаЗатрат) Тогда
		ТекстСообщения = НСтр("ru='Не заполнен счет затрат'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"СчетУчетаЗатрат");
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	ДанныеВыбора = Новый СписокЗначений;
	Если Лев(Строка(СчетУчетаЗатрат), 3) = "106" Тогда
		ДанныеВыбора.Добавить(БухгалтерскийУчетВызовСервераПовтИсп.КЭКПоКоду("340"));
	Иначе		
		ДанныеВыбора.Добавить(БухгалтерскийУчетВызовСервераПовтИсп.КЭКПоКоду("271"));
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
КонецПроцедуры
