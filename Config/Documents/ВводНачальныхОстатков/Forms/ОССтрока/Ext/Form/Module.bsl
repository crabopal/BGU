&НаКлиенте
Процедура МетодНачисленияАмортизацииНУПриИзменении(Элемент)
	
	Если МетодНачисленияАмортизацииНУ = ПредопределенноеЗначение("Перечисление.МетодыНачисленияАмортизации.Линейный") Тогда
		АмортизацияДо2009 = 0;
		ФактическийСрокИспользованияДо2009 = 0;		
		КоэффициентАмортизацииНУ = 0;
	КонецЕсли;
	
	НастроитьФормуВЗависимостиОтМетодНачисленияАмортизацииНУ();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовНУ()
	
	Если ПорядокВключенияСтоимостиВСоставРасходовНУ =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации") Тогда
		
		Элементы["ГруппаПорядокВключенияСтоимостиВСоставРасходовНУ"].ТекущаяСтраница =
			Элементы["СтраницаОСННачислениеАмортизацииНУ"];
		
	ИначеЕсли ПорядокВключенияСтоимостиВСоставРасходовНУ =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету") Тогда
		
		Элементы["ГруппаПорядокВключенияСтоимостиВСоставРасходовНУ"].ТекущаяСтраница =
			Элементы["СтраницаОСНВключениеВРасходыПриПринятииКУчету"];
		
	Иначе
		Элементы["ГруппаПорядокВключенияСтоимостиВСоставРасходовНУ"].ТекущаяСтраница =
			Элементы["СтраницаОСНСтоимостьНеВключаетсяВРасходы"];
			
	КонецЕсли;
	
	НастроитьДоступностьСтатьяПрочихРасходовНУОСН();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуВЗависимостиОтМетодНачисленияАмортизацииНУ()
	
	НовДоступность = НЕ (МетодНачисленияАмортизацииНУ = ПредопределенноеЗначение("Перечисление.МетодыНачисленияАмортизации.Линейный"));
	Элементы["АмортизацияДо2009"].Доступность = НовДоступность;
	Элементы["ФактическийСрокИспользованияДо2009"].Доступность = НовДоступность;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоступностьСтатьяПрочихРасходовНУОСН()
	
	// Если нет прав на редактирование, то доступность элементов не меняем:
	Если НЕ ПравоДоступаИзменение Тогда
		Возврат;
	КонецЕсли;
	
	НовДоступность = (СчетУчетаЗатрат = НастройкаФормы_Счет40120
		И	(ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации")
			ИЛИ ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету")));
	
	Элементы["СтатьяПрочихРасходов"].Доступность = НовДоступность;
	
КонецПроцедуры

// ----- Страница "Налоговый учет (УСН)" -----

&НаКлиенте
Процедура ПорядокВключенияСтоимостиВСоставРасходовУСНПриИзменении(Элемент)
	
	НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовУСН();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуВЗависимостиОтПорядокВключенияСтоимостиВСоставРасходовУСН()
	
	Если ПорядокВключенияСтоимостиВСоставРасходовУСН =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА") Тогда
		
		Элементы["ГруппаСтраницыВключениеСтоимостиВСоставРасходовУСН"].ТекущаяСтраница =
			Элементы["ГруппаВключитьВСоставРасходовНаОСиНМАприУСН"];
		Элементы["ГруппаРасходыУСН"].Видимость = Истина;
		Элементы["РасходыУСНРасходыПроизведеныДоПереходаНаУСН"].Видимость = Истина;
		
	ИначеЕсли ПорядокВключенияСтоимостиВСоставРасходовУСН =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставМатериальныхРасходов") Тогда
		
		Элементы["ГруппаСтраницыВключениеСтоимостиВСоставРасходовУСН"].ТекущаяСтраница =
			Элементы["ГруппаВключитьВСоставМатериальныхРасходовУСН"];
		Элементы["ГруппаРасходыУСН"].Видимость = Истина;
		Элементы["РасходыУСНРасходыПроизведеныДоПереходаНаУСН"].Видимость = Ложь;
		
	ИначеЕсли ПорядокВключенияСтоимостиВСоставРасходовУСН =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.НеВключатьВСоставРасходов") Тогда
		
		Элементы["ГруппаСтраницыВключениеСтоимостиВСоставРасходовУСН"].ТекущаяСтраница =
			Элементы["ГруппаНеВключатьВСоставРасходовУСН"];
		Элементы["ГруппаРасходыУСН"].Видимость = Ложь;
		
	Иначе
		Элементы["ГруппаСтраницыВключениеСтоимостиВСоставРасходовУСН"].ТекущаяСтраница =
			Элементы["ГруппаПорядокВключенияСтоимостиВСоставРасходовНеУказанУСН"];
		Элементы["ГруппаРасходыУСН"].Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасходыУСНПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекущиеДанные = Элементы.РасходыУСН.ТекущиеДанные;
		ТекущиеДанные.Валюта       = БухгалтерскийУчетВызовСервераПовтИсп.ВалютаРегламентированногоУчета();
		ТекущиеДанные.СчетРасчетов = БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("302.31");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасходыУСНСуммаНеоплаченныхРасходовРубПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.РасходыУСН.ТекущиеДанные;
	Если ТекущиеДанные.Валюта = БухгалтерскийУчетВызовСервераПовтИсп.ВалютаРегламентированногоУчета() Тогда
		ТекущиеДанные.СуммаНеоплаченныхРасходовВал = ТекущиеДанные.СуммаНеоплаченныхРасходовРуб;
	КонецЕсли;
	
КонецПроцедуры

