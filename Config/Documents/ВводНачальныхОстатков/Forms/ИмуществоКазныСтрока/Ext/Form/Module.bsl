&НаКлиенте
Процедура СчетУчетаЗатратПриИзменении(Элемент)
	
	УправлениеОсновнымиСредствамиКлиент.СчетУчетаЗатратПриИзменении(Элемент, СчетУчетаЗатрат, КЭКЗатрат);
	
	СтруктураИменЭлементов = Новый Структура();
	СтруктураИменЭлементов.Вставить("СчетФормы",						"СчетУчетаЗатрат");
	СтруктураИменЭлементов.Вставить("Субконто1",						"СубконтоЗатрат1");
	СтруктураИменЭлементов.Вставить("Субконто2",						"СубконтоЗатрат2");
	СтруктураИменЭлементов.Вставить("Субконто3",						"СубконтоЗатрат3");
	СтруктураИменЭлементов.Вставить("Подразделение",					"ПодразделениеЗатрат");
	СтруктураИменЭлементов.Вставить("ОчищатьОтстуствующие",				Истина);
	СтруктураИменЭлементов.Вставить("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	СтруктураИменЭлементов.Вставить("СубконтоФормы1",					"СубконтоЗатрат1");
	СтруктураИменЭлементов.Вставить("СубконтоФормы2",					"СубконтоЗатрат2");
	СтруктураИменЭлементов.Вставить("СубконтоФормы3",					"СубконтоЗатрат3");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьЗаголовкиСубконто(ЭтаФорма, Объект, СтруктураИменЭлементов);
	
КонецПроцедуры

&НаКлиенте
Процедура КЭКЗатратНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(СчетУчетаЗатрат) Тогда
		ТекстСообщения = НСтр("ru='Не заполнен счет затрат'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"СчетУчетаЗатрат");
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	ДанныеВыбора = Новый СписокЗначений;
	Если Лев(Строка(СчетУчетаЗатрат), 3) = "106" Тогда
		ДанныеВыбора.Добавить(БухгалтерскийУчетВызовСервераПовтИсп.КЭКПоКоду("340"));
	Иначе		
		ДанныеВыбора.Добавить(БухгалтерскийУчетВызовСервераПовтИсп.КЭКПоКоду("271"));
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
КонецПроцедуры
