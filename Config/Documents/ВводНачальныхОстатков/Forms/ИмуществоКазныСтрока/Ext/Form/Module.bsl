&НаКлиенте
Функция СохранитьИЗакрыть()
	
	Если НастройкаФормы_ИгнорироватьОшибкиЗаполнения Тогда
		ФормаЗаполненаКорректно = Истина;
	Иначе	
		ФормаЗаполненаКорректно = ЭтаФорма.ПроверитьЗаполнение();
	КонецЕсли;
	
	Если ФормаЗаполненаКорректно Тогда
		СледуетЗакрытьФорму	= Истина;
		Модифицированность	= Ложь;
		
		ЗавершитьРедактированиеСтрокиКлиент();
		
		ПараметрЗакрытия = Новый Структура;
		ПараметрЗакрытия.Вставить("АдресДанных",	Параметры["АдресДанных"]);
		Закрыть(ПараметрЗакрытия);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьРедактированиеСтрокиКлиент()
	
	ПоместитьТекущиеДанныеВХранилище();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПереданнойИнформацией()
	
	ВходящиеДанные = ПолучитьИзВременногоХранилища(Параметры.АдресДанных);
	
	НомерСтроки = ВходящиеДанные.ИндексТекСтроки + 1;
	ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " - строка " + Строка(НомерСтроки);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ВходящиеДанные.ТекДанные_Основная);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ВходящиеДанные.ТекДанные_Амортизация);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ВходящиеДанные.ТекДанные_Документ);
	
	// Инверсия флага "Расчет амортизации вручную":
	РасчетАмортизацииАвтоматически = НЕ РасчетАмортизацииВручную;
	
	//// Заполняем оставшиеся пустыми поля формы значениями заполнения (по умолчанию):
	//Если НЕ ЗначениеЗаполнено(ПервоначальнаяСтоимость) И НЕ Количество = 0 Тогда
	//	ПрежнееЗначение = ПервоначальнаяСтоимость;
	//	ПервоначальнаяСтоимость = Сумма / Количество;
	//	Если НЕ ПервоначальнаяСтоимость = ПрежнееЗначение Тогда
	//		ЭтаФорма.Модифицированность = Истина;
	//	КонецЕсли;
	//КонецЕсли;
	
	// Запоминаем переданные поля обоих ТЧ (для возврата значений из этой формы):
	Параметры.ТекущиеДанные = Новый Структура();
	Для Каждого Элем Из ВходящиеДанные.ТекДанные_Основная Цикл
		Параметры.ТекущиеДанные.Вставить(Элем.Ключ);
	КонецЦикла;
	Для Каждого Элем Из ВходящиеДанные.ТекДанные_Амортизация Цикл
		Параметры.ТекущиеДанные.Вставить(Элем.Ключ);
	КонецЦикла;
	
	КэшироватьСвойстваОСНаФорму();
	
	Счет_УчетПоПодразделениям = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "УчетПоПодразделениям");
	
	// Имя поля для активизации при открытии этой формы:
	НастройкаФормы_ИмяАктивногоПоля = ВходящиеДанные.ИмяАктивногоПоля;
			
КонецПроцедуры

&НаСервере
Процедура КэшироватьСвойстваОСНаФорму()
	
	МодифицируемыеРеквизитыОС = Документы.ВводНачальныхОстатков.ПолучитьЗначенияМодифицируемыхРеквизитовОС(РазделУчета, ОС);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, МодифицируемыеРеквизитыОС);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКомментарийСрокаПолезногоИспользования()
	
	СрокПолезногоИспользованияКомментарий = УправлениеОсновнымиСредствамиКлиентСервер.РасшифровкаСрокаПолезногоИспользования(СрокПолезногоИспользования);
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьТекущиеДанныеВХранилище()
	
	ВозвращаемыеДанные = Новый Структура();
	
	ЗаполнитьЗначенияСвойств(Параметры.ТекущиеДанные, ЭтаФорма);
	ВозвращаемыеДанные.Вставить("ТекущиеДанные", Параметры.ТекущиеДанные);
	
	ИменаРеквизитов		= Документы.ВводНачальныхОстатков.ПолучитьИменаМодифицируемыхРеквизитовОС(РазделУчета);
	РеквизитыОСНаФорме	= Новый Структура(ИменаРеквизитов);
	ЗаполнитьЗначенияСвойств(РеквизитыОСНаФорме, ЭтаФорма);
	ВозвращаемыеДанные.Вставить("РеквизитыОСНаФорме", РеквизитыОСНаФорме);
	
	Параметры.АдресДанных = ПоместитьВоВременноеХранилище(ВозвращаемыеДанные, Параметры["АдресДанных"]);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеСубконто(Элемент, НомерСубконто)
	
	СтрокаДанных = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
									СчетУчетаЗатрат,
									СубконтоЗатрат1,
									СубконтоЗатрат2,
									СубконтоЗатрат3);
	УправлениеОсновнымиСредствамиКлиент.ОбработатьИзменениеСубконто(Элемент, ЭтаФорма, СтрокаДанных, НомерСубконто)									

КонецПроцедуры // ОбработатьИзменениеСубконто()

&НаКлиенте
Процедура ОбработатьВыборСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, ТекНомерСубконто)

	СтрокаДанных = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
									СчетУчетаЗатрат,
									СубконтоЗатрат1,
									СубконтоЗатрат2,
									СубконтоЗатрат3);
	
	
	БухгалтерскиеОперацииКлиент.СубконтоНачалоВыбораСпр(Элемент, ДанныеВыбора, СтандартнаяОбработка, Организация,
													СтрокаДанных, ТекНомерСубконто);
	
КонецПроцедуры // ОбработатьВыборСубконто()

&НаКлиенте
Процедура УстановитьДоступностьПараметровАмортизации()
	
	// Если нет прав на редактирование, то доступность элементов не меняем:
	Если НЕ ПравоДоступаИзменение Тогда
		Возврат;
	КонецЕсли;

	НовДоступностьСчетАмортизации =
		(ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации"));
	
	НовДоступностьСчетЗатрат =
		(ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации")
		ИЛИ ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию"));
		
	ЭтоЛинейный = (СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный"));
		
    Элементы["ГруппаСчетАмортизации"].Доступность				= НовДоступностьСчетАмортизации;
	Элементы["ГруппаСрокПолезногоИспользования"].Доступность	= НовДоступностьСчетАмортизации;
	Элементы["НачислятьАмортизацию"].Доступность				= ЭтоЛинейный;
	Элементы["ГруппаРасчетАмортизации"].Доступность				= ЭтоЛинейный;
	
	ДополнительныйЗаголовок_СчетАмортизации = ?(НовДоступностьСчетАмортизации,
		"",
		НСтр("ru='не начисляется'"));
	ДополнительныйЗаголовок_РасчетАмортизации = ?(ЭтоЛинейный,
		"",
		НСтр("ru='не используется'"));
	
	НастроитьФормуКлиент_ПриИзмененииРасчетАмортизацииАвтоматически();
	
	УправлениеОсновнымиСредствамиКлиентСервер.ИзменитьДоступностьВариантыВыбораПараметровАмортизации(ПорядокПогашенияСтоимости,
																								Элементы["СпособНачисленияАмортизации"],
																								ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию"));
	
	// Настраиваем блок "Счет затрат":
	ОбщегоНазначенияБГУКлиентСервер.УстановитьЗаголовкиСубконто(ЭтаФорма, Объект,
		Новый Структура("
			|СчетФормы,
			|Субконто1,
			|Субконто2,
			|Субконто3,
			|Подразделение,
			|ИспользоватьУчетПоПодразделениям",
				"СчетУчетаЗатрат",
				"СубконтоЗатрат1",
				"СубконтоЗатрат2",
				"СубконтоЗатрат3",
				"ПодразделениеЗатрат",
				ИспользоватьУчетПоПодразделениям));
	Элементы["ГруппаСчетЗатрат"].Доступность = НовДоступностьСчетЗатрат;
	
КонецПроцедуры // УстановитьДоступностьПараметровАмортизации()

&НаКлиенте
Процедура УстановитьДоступностьСобытийОС()
	
	// Принятие к учету:
	НовДоступность = ПравоДоступаИзменение
		И	(СостояниеОС = ПредопределенноеЗначение("Перечисление.СостоянияОС.ПринятоКУчету")
			ИЛИ (СостояниеОС = ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию")));
	Элементы["ГруппаПринятиеКУчету"].Доступность = НовДоступность;
		
	// Ввод в эксплуатацию:
	НовДоступность = ПравоДоступаИзменение
		И (СостояниеОС = ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию"));
	Элементы["ГруппаВводВЭксплуатацию"].Доступность				= НовДоступность;
	Элементы["ГруппаДокументВводаВЭксплуатацию"].Доступность	= НовДоступность И НЕ ВводВЭксплуатациюОдновременноСПринятиемКУчету;
	Если ПравоДоступаИзменение
		И НЕ НовДоступность И ВводВЭксплуатациюОдновременноСПринятиемКУчету = Истина Тогда
		ВводВЭксплуатациюОдновременноСПринятиемКУчету = Ложь;
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеОдновременноСПринятиемКУчетуПриИзменении()
	
	Если ВводВЭксплуатациюОдновременноСПринятиемКУчету Тогда
		
		ДатаВводаВЭксплуатацию = ДатаПринятияКУчету;
		НазваниеДокументаВводаВЭксплуатацию = НазваниеДокументаПринятияКУчету;
		НомерДокументаВводаВЭксплуатацию = НомерДокументаПринятияКУчету;
		
		Элементы.ГруппаДокументВводаВЭксплуатацию.Доступность = Ложь;
		
	Иначе
		
		Элементы.ГруппаДокументВводаВЭксплуатацию.Доступность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

//---------------------------
// Настройка элементов формы

&НаСервере
Процедура НастроитьФормуПриСтарте()
	
	// Отключим видимость тех полей, которые на используются при текущем режиме работы.
	ШапкаДокумента = Документы.ВводНачальныхОстатков.РежимВводаОстатков_СтруктураШапкиДокумента();
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, ЭтаФорма);
	РезультатПроверки = Неопределено;
	НеиспользуемыеПоля = Документы.ВводНачальныхОстатков.РежимВводаОстатков_ИменаПолейВсехРежимов(ШапкаДокумента,
		Истина,	// ТолькоНеиспользуемые
		РезультатПроверки);
		
	РежимВводаОстатков_Кэш = Новый ФиксированнаяСтруктура(РезультатПроверки["Кэш"]);
	
	Для Каждого СтрокаТЗ Из НеиспользуемыеПоля Цикл
		// На этой форме редактируем поля только этих 2 табл.частей:
		ИмяТаблЧасти = ВРег(СтрокаТЗ["ТаблЧасть"]);
		Если НЕ ИмяТаблЧасти = "ОС_ОСНОВНАЯ" И НЕ ИмяТаблЧасти = "ОС_АМОРТИЗАЦИЯ" Тогда
			Продолжить;
		КонецЕсли;
		
		Имя = СтрокаТЗ["Поле"];
		
		// (дополнительно настраиваемые элементы)
		Если Имя = "ИнвНомерОС" Тогда
			// Помимо этого реквизита настраиваем и другие элементы (зависимые):
			Элементы["ГрупповойУчет"].Видимость = Ложь;
			
			Элементы["ДекорацияДляОсновногоСредстваВЦелом"].Видимость = Ложь;
			Элементы["ДекорацияДляОсновногоСредстваВЦелом1"].Видимость = Ложь;
			Элементы["ДекорацияДляИнвНомера"].Видимость = Ложь;
			Элементы["ДекорацияДляИнвНомера1"].Видимость = Ложь;
			
		ИначеЕсли Имя = "СрокПолезногоИспользования" Тогда
			// Вместо одного реквизита настраиваем группу:
			Имя = "ГруппаСрокПолезногоИспользования";
			
		ИначеЕсли Имя = "РасчетАмортизацииВручную" Тогда
			// Вместо одного реквизита настраиваем другой элемент:
			Имя = "РасчетАмортизацииАвтоматически";
			
		ИначеЕсли Имя = "РасчетАмортизацииСрокИспользования" Тогда
			// Вместо одного реквизита настраиваем группу:
			Имя = "ГруппаРасчетАмортизацииСрокИспользования";
			
		КонецЕсли;
		
		Элементы[Имя].Видимость = Ложь;
	КонецЦикла;
	
	// Устанавливаем текущий элемент:
	УстановитьТекущийЭлементФормы();
	
	// Сброс размеров и положения формы:
	ОчиститьНастройкиФормы();
	
	// Отключаем доступность элементов формы, если нет прав на редактирование документа:
	ОбщегоНазначенияБГУ.УстановитьНедоступныеЭлементыФормы(Элементы, Объект,
		"КомандаОК,КПССчетаОС,СчетОС,КЭКСчетаОС,ОС_КодПоОКОФ,ОС_АмортизационнаяГруппа,"
		+ "ГрупповойУчет,КЭКЗатрат,ОдновременноСПринятиемКУчету");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекущийЭлементФормы()
	
	Если ЗначениеЗаполнено(НастройкаФормы_ИмяАктивногоПоля) Тогда
		
		Попытка
			АктивныйЭлемент = Элементы[НастройкаФормы_ИмяАктивногоПоля];
			
			// Активизируем все страницы по иерархии, на которых расположен этот активный элемент:
			ТекущийРодитель = АктивныйЭлемент.Родитель;
			Пока НЕ ТипЗнч(ТекущийРодитель) = Тип("ФормаКлиентскогоПриложения") Цикл
				
				Если ТипЗнч(ТекущийРодитель) = Тип("ГруппаФормы") Тогда
					Если ТекущийРодитель.Вид = ВидГруппыФормы.Страница Тогда
						ТекущийРодитель.Родитель.ТекущаяСтраница = ТекущийРодитель;
						ТекущийРодитель = ТекущийРодитель.Родитель;
					КонецЕсли;
				КонецЕсли;
				
				ТекущийРодитель = ТекущийРодитель.Родитель;
				
			КонецЦикла;
			
			ЭтаФорма.ТекущийЭлемент = АктивныйЭлемент;
			
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьНастройкиФормы()

	ИмяПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Если ПравоДоступа("СохранениеДанныхПользователя", Метаданные) Тогда
		ХранилищеСистемныхНастроек.Удалить("Документ.ВводНачальныхОстатков.Форма.ОССтрока", "", ИмяПользователя);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьДатуКлиентСервер(Дата)
	
	Возврат КонецГода(Дата) + 1;
	
КонецФункции

//---
// Расчет амортизации

&НаКлиенте
Процедура НастроитьФормуКлиент_ПриИзмененииРасчетАмортизацииАвтоматически()
	
	НовДоступность = НЕ РасчетАмортизацииАвтоматически;
	
	Элементы["РасчетАмортизацииСтоимость"].Доступность					= НовДоступность;
	Элементы["ГруппаРасчетАмортизацииСрокИспользования"].Доступность	= НовДоступность;
	Элементы["РасчетАмортизацииПериод"].Доступность						= НовДоступность;
	
КонецПроцедуры
&НаКлиенте
Процедура РассчитатьАмортизациюАвтоматически()
	
	Если РасчетАмортизацииАвтоматически Тогда
		НоваяСтоимость			= 0;
		НовыйСрокИспользования	= 0;
		НовыйПериод				= Неопределено;
		ВеличинаНесущественнойРазницы = 1;
		
		Если ЗначениеЗаполнено(СостояниеОС)
			И ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации")
			И СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный") Тогда
			
			НовыйПериод = Дата;
			
			ОставшаясяСтоимость = Сумма - СуммаАмортизации;
			Если ОставшаясяСтоимость > 0 Тогда
				СрокЭксплуатацииВМесяцах = РассчитатьМесяцыЭксплуатации(ДатаПринятияКУчету, ДатаВводаВЭксплуатацию, КонецМесяца(Дата));
				Если СрокЭксплуатацииВМесяцах >= СрокПолезногоИспользования Тогда
					ОставшийсяСрок = 1;
				Иначе
					ОставшийсяСрок = СрокПолезногоИспользования - СрокЭксплуатацииВМесяцах;
				КонецЕсли;
				
				Если СрокПолезногоИспользования > 0 Тогда
					ПрежняяМесячнаяАмортизация = Сумма / СрокПолезногоИспользования;
				Иначе
					ПрежняяМесячнаяАмортизация = Сумма;
				КонецЕсли;
				НоваяМесячнаяАмортизация = ОставшаясяСтоимость / ОставшийсяСрок;
				РазностьАмортизаций = НоваяМесячнаяАмортизация - ПрежняяМесячнаяАмортизация;
				Если	РазностьАмортизаций > ВеличинаНесущественнойРазницы
					ИЛИ	РазностьАмортизаций < -ВеличинаНесущественнойРазницы Тогда
					НоваяСтоимость			= ОставшаясяСтоимость;
					НовыйСрокИспользования	= ОставшийсяСрок;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// Обновляем значения:
		РасчетАмортизацииСтоимость			= НоваяСтоимость;
		РасчетАмортизацииСрокИспользования	= НовыйСрокИспользования;
		РасчетАмортизацииПериод				= НовыйПериод;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Функция РассчитатьМесяцыЭксплуатации(ДатаПринятияКУчету, ДатаВводаВЭксплуатацию, ТекДата)
	
	// Возвращаемое значение:
	Результат = 0;
	
	Если (ДатаПринятияКУчету='00010101') ИЛИ (ДатаВводаВЭксплуатацию='00010101') Тогда
		ДатаВвода = Макс(ДатаПринятияКУчету, ДатаВводаВЭксплуатацию);
	Иначе
		ДатаВвода = Мин(ДатаПринятияКУчету, ДатаВводаВЭксплуатацию);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаВвода) Тогда
		Если НачалоМесяца(ДатаВвода) <= НачалоМесяца(ТекДата) Тогда
			КоличествоЛет		= Год(ТекДата) - Год(ДатаВвода);
			КоличествоМесяцев	= Месяц(ТекДата) - Месяц(ДатаВвода);
			Результат = КоличествоЛет * 12 + КоличествоМесяцев;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
