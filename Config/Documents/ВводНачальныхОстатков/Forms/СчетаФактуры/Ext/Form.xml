			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>	////////////////////////////////////////////////////////////////////////
	// Счета-фактуры выданные
	//
	ВЫБРАТЬ
		Док.Ссылка					КАК Ссылка,
		"Счет-фактура выданный"		КАК Представление,
		Док.Дата					КАК Дата,
		Док.Номер					КАК Номер,
		Док.Дата					КАК ДатаПервичногоДокумента,
		Док.Номер					КАК НомерПервичногоДокумента,
		
		Док.Контрагент				КАК Контрагент,
		Док.Договор					КАК Договор,
		
		ВЫБОР
			КОГДА Док.ПометкаУдаления ТОГДА
				1	// картинка "Документ помечен на удаление"
			ИНАЧЕ
				ВЫБОР
					КОГДА Док.Проведен ТОГДА
						0	// картинка "Документ проведен"
					ИНАЧЕ
						2	// картинка "Документ не проведен"
				КОНЕЦ
			
		КОНЕЦ					КАК ИндексКартинки,
		
		ВЫРАЗИТЬ(Док.Комментарий	КАК СТРОКА(200))	КАК Комментарий,
		
		Док.СуммаНДС			КАК СуммаНДС,
		
		ВЫБОР
			КОГДА Док.СуммаВключаетНДС ТОГДА
				Док.СуммаДокумента - Док.СуммаНДС
			ИНАЧЕ
				Док.СуммаДокумента
		КОНЕЦ					КАК СуммаБезНДС,
		
		ВЫБОР
			КОГДА Док.СуммаВключаетНДС ТОГДА
				Док.СуммаДокумента
			ИНАЧЕ
				Док.СуммаДокумента + Док.СуммаНДС
		КОНЕЦ					КАК СуммаСНДС
		
	ИЗ
		Документ.СчетФактураВыданный	КАК Док
	ГДЕ
		Док.ДокументОснование = &amp;ДокСсылка


	ОБЪЕДИНИТЬ ВСЕ

	////////////////////////////////////////////////////////////////////////
	// Счета-фактуры полученные
	//
	ВЫБРАТЬ РАЗЛИЧНЫЕ
		Основания.Ссылка							КАК Ссылка,
		"Счет-фактура полученный"					КАК Представление,
		Основания.Ссылка.Дата						КАК Дата,
		Основания.Ссылка.Номер						КАК Номер,
		Основания.Ссылка.ДатаПервичногоДокумента	КАК ДатаПервичногоДокумента,
		Основания.Ссылка.НомерПервичногоДокумента	КАК НомерПервичногоДокумента,
		
		Основания.Ссылка.Контрагент.Наименование	КАК Контрагент,
		Основания.Ссылка.Договор.Наименование		КАК Договор,
		
		ВЫБОР
			КОГДА Основания.Ссылка.ПометкаУдаления ТОГДА
				1	// картинка "Документ помечен на удаление"
			ИНАЧЕ
				ВЫБОР
					КОГДА Основания.Ссылка.Проведен ТОГДА
						0	// картинка "Документ проведен"
					ИНАЧЕ
						2	// картинка "Документ не проведен"
				КОНЕЦ
			
		КОНЕЦ								КАК ИндексКартинки,
		
		
		ВЫРАЗИТЬ(Основания.Ссылка.Комментарий	КАК СТРОКА(200))	КАК Комментарий,
		
		Основания.Ссылка.СуммаНДС		КАК СуммаНДС,
		
		ВЫБОР
			КОГДА Основания.Ссылка.СуммаВключаетНДС ТОГДА
				Основания.Ссылка.СуммаДокумента - Основания.Ссылка.СуммаНДС
			ИНАЧЕ
				Основания.Ссылка.СуммаДокумента
		КОНЕЦ								КАК СуммаБезНДС,
		
		ВЫБОР
			КОГДА Основания.Ссылка.СуммаВключаетНДС ТОГДА
				Основания.Ссылка.СуммаДокумента
			ИНАЧЕ
				Основания.Ссылка.СуммаДокумента + Основания.Ссылка.СуммаНДС
		КОНЕЦ								КАК СуммаСНДС
		
	ИЗ
		Документ.СчетФактураПолученный.ДокументыОснования	КАК Основания
	ГДЕ
		Основания.ДокументОснование = &amp;ДокСсылка
</QueryText>
