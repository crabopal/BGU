&НаКлиенте
Перем ТекстЗаголовкаСообщений;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПодготовитьФормуНаСервере();
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Ввод начальных остатков НДС'");
	
	ВводНачальныхОстатковКлиент.ПриОткрытии(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Добавляем надпись (программно) на страницу "Бухгалтерская операция":
	ДобавитьНадписьНаЗакладкуБухОперация();
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	// Очищаем колонки ТЧ, которые не используются для текущего выбранного Вида НДС:
	ИменаОчищаемыхПолей = ?(Объект.ВходящийНДС,
		ИменаКолонокДляИсходящегоНДС, // при Входящем очищаем Исходящий
		ИменаКолонокДляВходящегоНДС); // при Исходящем очищаем Входящий
		
	ОчищающаяСтруктура = Новый Структура();
	Для Каждого ИмяПоля Из ИменаОчищаемыхПолей Цикл
		ОчищающаяСтруктура.Вставить(ИмяПоля, Неопределено);
	КонецЦикла;
	
	ТЧ = ТекущийОбъект.НДС;
	Для Каждого СтрокаТЧ Из ТЧ Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ОчищающаяСтруктура);
	КонецЦикла;
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	УстановитьЗаголовокФормы();
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// Заново считываем данные документа,
	// т.к. при его проведении мы обновили колонку "Счет-фактура" табличной части:
	ЭтаФорма.Прочитать();
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	// Оповещаем форму Помощника ввода начальных остатков:
	ИмяСобытия = "ЗаписанДокументВводНачальныхОстатков";
	Параметр = Объект["Организация"];
	Оповестить(ИмяСобытия, Параметр);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаВводаОстатковПриИзменении(Элемент)
	
	ЗаполнитьСоответствиеПНСчет();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидНДСПриИзменении(Элемент)
	
	// Трансформируем реквизиты формы в реквизиты объекта
	Объект.ВходящийНДС = Булево(ВидНДС);
	
	Если Объект.НДС.Количество() = 0 Тогда
		
		ВидНДСПриИзмененииКлиент();
		
	Иначе
		// Уточним желание сменить Вид НДС
		ТекстСообщения = НСтр("ru='Изменение Вида НДС вызовет очистку некоторых полей
			|в табличной части документа.
			|
			|Продолжить и сменить вид НДС?'");
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ВидНДСПриИзменении_Ответ", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ВидНДСПриИзменении_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ВидНДСПриИзмененииКлиент();
	Иначе
		// Отменяем уже произведенное изменение
		Объект.ВходящийНДС = НЕ Объект.ВходящийНДС;
		
		// Трансформируем реквизиты объекта в реквизиты формы
		ВидНДС = Число(Объект.ВходящийНДС);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_НДС

&НаКлиенте
Процедура НДСПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	// Устанавливаем значения полей по умолчанию в новой строке:
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекДанные = Элементы.НДС.ТекущиеДанные;
		
		// 1 - бумажный, 2 - электронный
		ТекДанные["КодСпособаВыставления"] = 1;
		
	КонецЕсли;
	
	НастроитьТипЗначенияСчетФактуры();
	
	НастроитьДоступностьСубконто();
	
	ПрименяемаяИнструкция_ОбновитьСтруктуруДляВводаОстатков();
	
КонецПроцедуры

&НаКлиенте
Процедура НДСДатаСчетаФактурыПриИзменении(Элемент)
	
	ПрименяемаяИнструкция_ОбновитьСтруктуруДляВводаОстатков();
	
КонецПроцедуры

&НаКлиенте
Процедура НДССчетФактураПриИзменении(Элемент)
	
	ОбновитьРеквизитыСчетаФактурыВТекущейСтроке();
	
КонецПроцедуры

&НаКлиенте
Процедура НДССчетФактураОчистка(Элемент, СтандартнаяОбработка)
	
	//***
	//// Настраивает выбор типа колонки "Счет фактура":
	//Элементы["НДССчетФактура"].ВыбиратьТип = Истина;
	
	ОбновитьРеквизитыСчетаФактурыВТекущейСтроке();
	
КонецПроцедуры

&НаКлиенте
Процедура НДССчетФактураОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Перем ВидДокумента;
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Тип") Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.НДС.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	// Перечисляем все типы поля СчетФактура
	
	Если ВыбранноеЗначение = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ВидДокумента = "СчетФактураВыданный";
		
	ИначеЕсли ВыбранноеЗначение = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
		ВидДокумента = "СчетФактураПолученный";
		
	ИначеЕсли ВыбранноеЗначение = Тип("ДокументСсылка.ГТДИмпорт") Тогда
		ВидДокумента = "ГТДИмпорт";
		
	ИначеЕсли ВыбранноеЗначение = Тип("ДокументСсылка.РегистрацияСтрокиКнигиПродаж") Тогда
		ВидДокумента = "РегистрацияСтрокиКнигиПродаж";
		
	Иначе
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура();
	Отбор.Вставить("Организация", Объект.Организация);
	
	Если ЗначениеЗаполнено(ТекДанные.Контрагент) Тогда
		Отбор.Вставить("Контрагент", ТекДанные.Контрагент);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.Договор) Тогда
		Отбор.Вставить("Договор", ТекДанные.Договор);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОткрытьФорму("Документ." + ВидДокумента + ".ФормаВыбора", ПараметрыФормы, Элементы["НДССчетФактура"],,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура НДССтавкаНДСПриИзменении(Элемент)
	
	ПересчитатьСуммуНДС();
	
КонецПроцедуры

&НаКлиенте
Процедура НДССуммаБезНДСПриИзменении(Элемент)
	
	ПересчитатьСуммуНДС();
	
КонецПроцедуры

// При очистке (СчетКредита) также очищает КПССчетРасчетов.
&НаКлиенте
Процедура НДССчетКредитаПриИзменении(Элемент)
	
	ТекДанные = Элементы.НДС.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекДанные.СчетКредита) Тогда
		ТекДанные.КПССчетРасчетов = Неопределено;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура НДССчетКредитаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекДанные = Элементы.НДС.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка,
															Новый Структура("Счет, КПС, КФО",
																			ТекДанные.СчетКредита,
																			ТекДанные.КПССчетРасчетов,
																			ТекДанные.КФО),
															Объект.Организация,
															Объект.ИФО,
															ТекДанные["ПрименяемаяИнструкция_СтруктураДляВводаОстатков"]["ДоступныеСчетаВычетаКт"],
															ТекДанные.КФО,
															,
															ПолучитьДату(Объект["Дата"]));
	
КонецПроцедуры
&НаКлиенте
Процедура НДССчетКредитаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекДанные = Элементы.НДС.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
															ТекДанные.КПССчетРасчетов,
															ТекДанные.КФО);
КонецПроцедуры

&НаКлиенте
Процедура НДССчетРасчетовПриИзменении(Элемент)
	
	ТекДанные = Элементы.НДС.ТекущиеДанные;
	
	Если НЕ Объект.ВходящийНДС
		И НЕ ЗначениеЗаполнено(ТекДанные.СчетРасчетов) Тогда
		// Для исходящего НДС используется "длинный" Счет Расчетов.
		
		ТекДанные.КПССчетРасчетов = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура НДССчетРасчетовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Перем СпСчетов, СчетПоУмолчанию;
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.НДС.ТекущиеДанные;
	
	Если ТекДанные.ПричинаНалогообложения = ПредопределенноеЗначение("Перечисление.ПричиныНалогообложенияНДС.СМРХозяйственнымСпособом") Тогда
		ТекстСообщения = НСтр("ru='Для причины налогообложения ""СМР хозяйственным способом"" счет расчетов заполнять не надо.'");
		ПоказатьПредупреждение(, ТекстСообщения, 60, ТекстЗаголовкаСообщений);
		Возврат;
	КонецЕсли;	
	
	ПолучитьСчетаРасчетов(СпСчетов, СчетПоУмолчанию);
	
	Если Объект.ВходящийНДС Тогда
		// Для входящего НДС выбираем "короткий" Счет Расчетов.
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("ОграниченияСписокСчетов", СпСчетов);
		ПараметрыФормы.Вставить("КодТекущейСтроки", СчетПоУмолчанию);
		ПараметрыФормы.Вставить("НаДату", ПолучитьДату(Объект["Дата"]));
		
		ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Элемент);
		
	Иначе
		// Для исходящего НДС выбираем "длинный" Счет Расчетов.
		
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
																СтандартнаяОбработка,
																Новый Структура("Счет, КПС, КФО",
																				СчетПоУмолчанию,
																				ТекДанные.КПССчетРасчетов,
																				ТекДанные.КФО),
																Объект.Организация,
																Объект.ИФО,
																СпСчетов,
																ТекДанные.КФО,
																,
																ПолучитьДату(Объект["Дата"]));
	КонецЕсли
	
КонецПроцедуры
