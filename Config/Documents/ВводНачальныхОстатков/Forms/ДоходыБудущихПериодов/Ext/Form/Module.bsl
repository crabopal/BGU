#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьФормуСервер()
	
	ЗапомнитьПараметрыДоговораВКэшеФормы();
	
	КонтролироватьВводимыеСуммы = Истина;
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если Объект.Ссылка.Пустая() И НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
			// Для нового документа заполняем дату.
			Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
		КонецЕсли;
		
		Если Параметры.ЗначенияЗаполнения.Свойство("Счет")
			И ЗначениеЗаполнено(Параметры.ЗначенияЗаполнения.Счет) Тогда
			Объект.Счет = Параметры.ЗначенияЗаполнения.Счет;
		Иначе
			Объект.Счет = БухгалтерскийУчет.СчетПоКоду("401.40");
		КонецЕсли;
		
		Объект.СчетДоходов = БухгалтерскийУчет.СчетПоКоду("401.10");
		
	КонецЕсли;
	
	НастроитьФормуСервер_ПоВидуОперации();
	
	УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект);
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	УстановитьДоступностьЭлементовБлокаВалюта(ЭтотОбъект);
	
	УстановитьУсловноеОформление();
	
	УстановитьЗаголовокФормы();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ПоВидуОперации()

	ВидимостьУпущеннойВыгоды = (Объект.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях
							ИЛИ Объект.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование);
	
	Элементы["ДоходыБудущихПериодовНадписьОтложенныйДоход"].Видимость	= ВидимостьУпущеннойВыгоды;
	Элементы["ДоходыБудущихПериодовНадписьУпущеннаяВыгода"].Видимость	= ВидимостьУпущеннойВыгоды;
	Элементы["ДоходыБудущихПериодовУпущеннаяВыгода"].Видимость			= ВидимостьУпущеннойВыгоды;
	Элементы["ДоходыБудущихПериодовИтогУпущеннаяВыгода"].Видимость		= ВидимостьУпущеннойВыгоды;
	
	Элементы["ГруппаУпущеннаяВыгода"].Видимость = ВидимостьУпущеннойВыгоды;
	
	СвойстваСчетаДБП = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Объект.Счет);
	Элементы["ДоходыБудущихПериодовПодразделение"].Видимость = СвойстваСчетаДБП.УчетПоПодразделениям;
	Элементы["ДоходыБудущихПериодовПодразделение"].АвтоОтметкаНезаполненного = НЕ СвойстваСчетаДБП.РазрешитьНеУказыватьПодразделение;
	
	Элементы.СпособПризнанияДоходов.ПараметрыВыбора =
		Перечисления.СпособыПризнанияРасходов.ПараметрыВыбораСпособаПризнанияДоходов(Объект.ВидОперацииДБП);
	
	// Доходы от предоставления имущества в аренду для целей НУ являются прочими (Н91.01).
	ОграниченияСписокСчетов = Новый Массив;
	Если Объект.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПрочиеДоходыБудущихПериодов Тогда
		ОграниченияСписокСчетов.Добавить(БухгалтерскийУчет.СчетПоКоду("Н90.01", Объект.Дата));
	КонецЕсли;
	ОграниченияСписокСчетов.Добавить(БухгалтерскийУчет.СчетПоКоду("Н91.01", Объект.Дата));
	ПараметрыВыбораСчета = Новый Массив;
	ПараметрыВыбораСчета.Добавить(Новый Параметрвыбора("Отбор.Ссылка", Новый ФиксированныйМассив(ОграниченияСписокСчетов)));
	Элементы.СчетДоходовНУ.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораСчета);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент_ПоКонтролюВводимыхСумм()
	
	Элементы["ФормаКонтролироватьВводимыеСуммы"].Пометка = КонтролироватьВводимыеСуммы;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	////////////////////////////////////////////////////////////////////////////////
	// Надпись "Отложенный доход"
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = "Надпись ""Доходы будущих периодов""";
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ДоходыБудущихПериодов.НомерСтроки");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='Доходы будущих периодов:'"));
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДоходыБудущихПериодовНадписьОтложенныйДоход");
	
	
	////////////////////////////////////////////////////////////////////////////////
	// Надпись "Упущенная выгода"
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = "Надпись ""Упущенная выгода""";
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ДоходыБудущихПериодов.НомерСтроки");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='Упущенная выгода:'"));
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДоходыБудущихПериодовНадписьУпущеннаяВыгода");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	Если Объект.Ссылка.Пустая() Тогда
		
		Параметр1 = "(создание)";
		
	Иначе
		
		Параметр1 = Объект.Номер + " от " + Объект.Дата;
		
	КонецЕсли;
	
	ЭтаФорма.Заголовок = СтрШаблон(НСтр("ru='Ввод остатков доходов будущих периодов %1'"), Параметр1);
	
КонецПроцедуры

&НаСервере
Процедура ВидОперацииПриИзмененииСервер()
	
	ЭтоПередачаВАренду =
		(Объект.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАренду);
	ЭтоПередачаВАрендуНаЛьготныхУсловиях =
		(Объект.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях);
	ЭтоПередачаВБезвозмездноеПользование =
		(Объект.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование);
	
	Если ЭтоПередачаВАренду ИЛИ ЭтоПередачаВАрендуНаЛьготныхУсловиях ИЛИ ЭтоПередачаВБезвозмездноеПользование Тогда
		
		Объект.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам;
		Объект.СчетДоходовНУ = БухгалтерскийУчет.СчетПоКоду("Н91.01", Объект.Дата);
		
	Иначе
		
		Объект.СчетДоходовНУ = БухгалтерскийУчет.СчетПоКоду("Н90.01", Объект.Дата);
		
	КонецЕсли;
	
	ИнициализироватьУпущеннуюВыгоду();
	
	НастроитьФормуСервер_ПоВидуОперации();
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроконтролироватьСуммыВСтроке()
	
	Если НЕ КонтролироватьВводимыеСуммы Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.ДоходыБудущихПериодов.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьУпущеннаяВыгода = (Объект.ВидОперацииДБП = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях")
		ИЛИ Объект.ВидОперацииДБП = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование"));
	
	Если НЕ ЕстьУпущеннаяВыгода Тогда
		
		ТекДанные["УпущеннаяВыгода"] = 0;
		
	КонецЕсли;
	
	Если ТекДанные["УпущеннаяВыгода"] > ТекДанные["ОтложенныйДоход"] Тогда
		
		ТекДанные["УпущеннаяВыгода"] = ТекДанные["ОтложенныйДоход"];
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьУпущеннуюВыгоду()
	
	ЭтоПередачаВАренду = (Объект.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАренду);
	
	ЭтоПередачаВБезвозмездноеПользование = (Объект.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование);
	
	// Шапка
	
	Если ЭтоПередачаВАренду Тогда
		
		ОчищающаяСтруктура = Новый Структура("
			|СчетРБП,
			|СтатьяРБП,
			|КЭКРБП,
			|КПСРБП");
		
		ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
		
	КонецЕсли;
	
	// Табличная часть
	
	Для Каждого СтрокаТаблицы Из Объект.ДоходыБудущихПериодов Цикл
		
		Если ЭтоПередачаВАренду Тогда
			
			СтрокаТаблицы.УпущеннаяВыгода = 0;
			
		ИначеЕсли ЭтоПередачаВБезвозмездноеПользование Тогда
			
			СтрокаТаблицы.УпущеннаяВыгода = СтрокаТаблицы.ОтложенныйДоход;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИДоступностьСубконто(Форма)
	
	Перем МассивПолей;
	
	Объект = Форма.Объект;
	
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоДоходов1", "СубконтоДоходов1", Истина, "СубконтоДоходов1", Истина, Истина, Истина);
	
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоДоходов2", "СубконтоДоходов2", Истина, "СубконтоДоходов2", Истина, Истина, Истина);
	
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоДоходов3", "СубконтоДоходов3", Истина, "СубконтоДоходов3", Истина, Истина, Истина);
	
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетДоходов, Форма, Объект, МассивПолей);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоПередачаВАрендуПользование =
		(Объект.ВидОперацииДБП = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАренду")
	 ИЛИ Объект.ВидОперацииДБП = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях")
	 ИЛИ Объект.ВидОперацииДБП = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование"));
	
	ОсобыйПорядокПризнанияДоходовТекущегоПериода =
		(Объект.СпособПризнанияДоходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ВОсобомПорядке"));
	ПризнаниеДоходовТекущегоПериодаПоГрафику =
		(Объект.СпособПризнанияДоходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоГрафику"));
	
	ВедетсяГрафикПоДоговору = Форма.КэшПараметров.Локальные.Свойство("ВедетсяГрафикПоДоговору")
		И Форма.КэшПараметров.Локальные.ВедетсяГрафикПоДоговору;
	ЕстьГрафикПоДоговору = Форма.КэшПараметров.Локальные.Свойство("ЕстьГрафикПоДоговору")
		И Форма.КэшПараметров.Локальные.ЕстьГрафикПоДоговору;
	
	СрокСписания = Новый Массив;
	СрокСписания.Добавить("ДатаНачалаСписания");
	СрокСписания.Добавить("ДатаОкончанияСписания");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		СрокСписания, "Видимость", НЕ ПризнаниеДоходовТекущегоПериодаПоГрафику);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаГрафикПризнанияДоходов",
		"Видимость", ПризнаниеДоходовТекущегоПериодаПоГрафику И ВедетсяГрафикПоДоговору);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаГрафикПризнанияДоходовПредупреждение",
		"Видимость", ПризнаниеДоходовТекущегоПериодаПоГрафику И НЕ ВедетсяГрафикПоДоговору);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ВвестиГрафикПризнанияДоходов", "Видимость", ПризнаниеДоходовТекущегоПериодаПоГрафику И НЕ ЕстьГрафикПоДоговору);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОткрытьГрафикПризнанияДоходов", "Видимость", ПризнаниеДоходовТекущегоПериодаПоГрафику И ЕстьГрафикПоДоговору);
	
	Если ОсобыйПорядокПризнанияДоходовТекущегоПериода Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "АвтоОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "ОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "АвтоОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "ОтметкаНезаполненного", Ложь);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "АвтоОтметкаНезаполненного", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаНачалаСписания", "ОтметкаНезаполненного", Не ЗначениеЗаполнено(Объект.ДатаНачалаСписания));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "АвтоОтметкаНезаполненного", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ДатаОкончанияСписания", "ОтметкаНезаполненного", Не ЗначениеЗаполнено(Объект.ДатаОкончанияСписания));
	КонецЕсли;
	
	Если ПризнаниеДоходовТекущегоПериодаПоГрафику Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыСписания", "Подсказка",
			НСтр("ru = 'Доходы будущих периодов относятся на финансовый результат текущего периода согласно графику, установленному договором.'"));
	ИначеЕсли ОсобыйПорядокПризнанияДоходовТекущегоПериода Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыСписания", "Подсказка",
			НСтр("ru = 'Суммы списания доходов будущих периодов указываются вручную в регламентном документе ""Списание доходов будущих периодов"".'"));
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПараметрыСписания", "Подсказка",
			НСтр("ru = 'В течение указанного срока доходы будущих периодов относятся на финансовый результат текущего периода.'"));
	КонецЕсли;
	
	ПредупреждениеДолгосрочныйДоговорОбразование = Новый Массив;
	ПредупреждениеДолгосрочныйДоговорОбразование.Добавить("ПредупреждениеДолгосрочныйДоговорОбразованиеКартинка");
	ПредупреждениеДолгосрочныйДоговорОбразование.Добавить("ПредупреждениеДолгосрочныйДоговорОбразованиеНадпись");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ПредупреждениеДолгосрочныйДоговорОбразование, "Видимость",
		Объект.ВидОперацииДБП = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ДолгосрочныйДоговорОбразование"));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоПередачаВБезвозмездноеПользование =
		(Объект.ВидОперацииДБП = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование"));
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(Объект.КФО)
		И Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НЕ ЭтоПередачаВБезвозмездноеПользование;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаНалоговыйУчет", "Видимость", ОтражатьВНалоговомУчете);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаБухгалтерскийУчет", "ОтображатьЗаголовок", ОтражатьВНалоговомУчете);
	
	ЭтоПрочиеДоходы = БухгалтерскийУчетКлиентСервер.СчетВИерархии(Объект.СчетДоходовНУ, "Н91.01");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтатьяПрочихДоходовНУ", "Видимость", ЗначениеЗаполнено(Объект.СчетДоходовНУ) И ЭтоПрочиеДоходы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементовБлокаВалюта(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭлементыКурсИКратность = Новый Массив;
	ЭлементыКурсИКратность.Добавить("Курс");
	ЭлементыКурсИКратность.Добавить("Кратность");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыКурсИКратность, "Доступность", Объект.ВалютаДокумента <> Форма.КэшПараметров.ВалютаРегламентированногоУчета);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКурсВалюты(Валюта, Дата)
	
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, Дата);
	
КонецФункции

&НаСервере
Процедура ЗапомнитьПараметрыДоговораВКэшеФормы()
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВедетсяГрафикПоДоговору", Ложь);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ЕстьГрафикПоДоговору", Ложь);
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		ВестиПланГрафикИсполнения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Договор, "ВестиПланГрафикИсполнения");
		ЭтотОбъект.КэшПараметров.Локальные.ВедетсяГрафикПоДоговору = 
			?(ВестиПланГрафикИсполнения = Неопределено, Ложь, ВестиПланГрафикИсполнения);
		ЭтотОбъект.КэшПараметров.Локальные.ЕстьГрафикПоДоговору = 
			КонтрольИсполненияДоговоров.ЕстьГрафикПоДоговору(Объект.Договор, "ПланГрафикИсполнения");
	КонецЕсли;
	
КонецПроцедуры

