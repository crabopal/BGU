#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СнятьПризнакАгрегатора(Команда)	
	
	ВводНачальныхОстатковКлиент.СнятьПризнакАгрегатора(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаКонтролироватьВводимыеСуммы(Команда)
	
	КонтролироватьВводимыеСуммы = НЕ КонтролироватьВводимыеСуммы;
	
	НастроитьФормуКлиент_ПоКонтролюВводимыхСумм();
	
	Если КонтролироватьВводимыеСуммы Тогда
		
		ТекстСообщения = НСтр("ru='Включен контроль вводимых сумм
			|
			|(упущенная выгода должна быть меньше отложенного дохода)'");
		
	Иначе
		
		ТекстСообщения = НСтр("ru='Отключен контроль вводимых сумм'");
		
	КонецЕсли;
	
	ПоказатьПредупреждение(, ТекстСообщения, 10);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиГрафикПризнанияДоходов(Команда)
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("ДокументОснование", Объект.Ссылка);
	ПараметрыВызова.Вставить("Организация", Объект.Организация);
	ПараметрыВызова.Вставить("ИФО", Объект.ИФО);
	ПараметрыВызова.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыВызова.Вставить("ВалютаДокумента", Объект.ВалютаДокумента);
	
	КонтрольИсполненияДоговоровКлиент.ВвестиИзменитьГрафикПоДоговору(Объект.Договор, "ПланГрафикИсполнения",
		ПараметрыВызова, ЭтотОбъект, Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьГрафикПризнанияДоходов(Команда)
	
	КонтрольИсполненияДоговоровКлиент.ОткрытьГрафикИсполненияДоговора(
		Объект.Договор, , , ЭтотОбъект, Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
