// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализацияФормы()
	
	Если ИнициализацияВыполнена Тогда
		Возврат;
	КонецЕсли;
	
	ОС_ВидНФА		= Перечисления.ВидыНФА.НПА;
	ОС_ВидУчета		= Перечисления.ВидыУчетаНФА.НаБалансе;
	ОС_ВидИмущества	= Перечисления.ВидыИмущества.НедвижимоеИмущество;
	Элементы["ПодразделениеОрганизации"].АвтоОтметкаНезаполненного = Документы.ВводНачальныхОстатков.ПодразделениеОбязательноКЗаполнению(Объект);
	
	// Запомним имена используемых колонок таблиц ОС
	ТекущийРазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НПА;
	ПустаяСтрокаТаблицыОСОсновная		= Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ИменаИспользуемыхКолонокОСОсновная(ТекущийРазделУчета);
	ПустаяСтрокаТаблицыОСАмортизация	= Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ИменаИспользуемыхКолонокОСАмортизация(ТекущийРазделУчета);
	ПолнаяТабличнаяЧастьОС_ИменаРедактируемыхВТаблицеКолонокОСАмортизация = Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ИменаРедактируемыхВТаблицеКолонокОСАмортизация(ТекущийРазделУчета);
	
	УстановитьУсловноеОформление();
	
	НастроитьФормуСервер_ПриИзмененииСчета();
	
	Документы.ВводНачальныхОстатков.НастроитьФормуДокументаДляУстаревшегоРазделаУчета(ЭтаФорма);
	
	ИнициализацияВыполнена = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ЗаголовокФормы = "(устарел) Ввод начальных остатков по НПА ";
	Если Объект.Ссылка.Пустая() Тогда
		ЗаголовокФормы = ЗаголовокФормы + "(создание)";
	Иначе
		ЗаголовокФормы = ЗаголовокФормы + Объект.Номер + " от " + Объект.Дата;
	КонецЕсли;
	ЭтаФорма.Заголовок = ЗаголовокФормы;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьЗаголовокФормы();
	
	Если НЕ ИнициализацияВыполнена Тогда
		ИнициализацияФормы();
		
		//---
		// Полная табличная часть ОС
		//---
		ПолнаяТабличнаяЧастьОС_ОбновитьСервер();
	КонецЕсли;
	
	//---
	// КЭК0
	//---
	УстановитьНовоеЗначениеКЭК = Ложь;
		
	// Заполняем по возможности пустые поля формы:
	Если Объект.Ссылка.Пустая() Тогда
		
		Попытка
			ЭтаФорма.ТиповаяОперация = Справочники.ТиповыеОперации.ВводНачальныхОстатков_НПА;
		Исключение
		КонецПопытки;
		
		Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
		КонецЕсли;
		
		//---
		// КЭК0
		//---
		УстановитьНовоеЗначениеКЭК = Истина;
		
	КонецЕсли;
	
	//---
	// КЭК0
	//---
	КЭК0 = БухгалтерскийУчетПовтИсп.КЭК0();
	ПроконтролироватьЗначениеКЭКСервер(УстановитьНовоеЗначениеКЭК);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент()
	
	РазрешитьРаботуСФормой = ЗначениеЗаполнено(Объект.Организация)
		И ЗначениеЗаполнено(Объект.Счет);
	
	Элементы["ОС_Основная"].ТолькоПросмотр			= НЕ РазрешитьРаботуСФормой;
	Элементы["РедактированиеВДиалоге"].Доступность	= РазрешитьРаботуСФормой;
	Элементы["ОткрытьВДиалогеКМ"].Доступность		= РазрешитьРаботуСФормой;
	
	НастроитьФормуКлиент_ПриИзмененииСчета();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Документы.ВводНачальныхОстатков.УстановитьУсловноеОформление_КолонкиОСПринятиеКУчету(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДату()
	
	Возврат КонецГода(Объект.Дата) + 1;
	
КонецФункции

&НаСервере
Процедура НастроитьФормуСервер_ПриИзмененииСчета()
	
	// Кэшируем свойства счета и значения функц.опций:
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ОбновитьКэшФормы(Объект["Счет"]));

КонецПроцедуры
&НаКлиенте
Процедура НастроитьФормуКлиент_ПриИзмененииСчета()
	
	// Кэшируем свойства счета и значения функц.опций:
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ОбновитьКэшФормы(Объект["Счет"]));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбновитьКэшФормы(СчетСсылка)
	
	СвойстваСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетСсылка,
		"УчетПоКПС, УчетПоКЭК, УчетПоПодразделениям");
	
	Возврат Новый Структура("
		|Счет_УчетПоКПС,
		|Счет_УчетПоКЭК,
		|Счет_УчетПоПодразделениям",
		?(ЗначениеЗаполнено(СчетСсылка), СвойстваСчета.УчетПоКПС,				Ложь),
		?(ЗначениеЗаполнено(СчетСсылка), СвойстваСчета.УчетПоКЭК,				Ложь),
		?(ЗначениеЗаполнено(СчетСсылка), СвойстваСчета.УчетПоПодразделениям,	Ложь));
	
КонецФункции

//---
// Полная табличная часть ОС
//---

&НаСервере
Процедура ПолнаяТабличнаяЧастьОС_ОбновитьСервер()
	
	Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ОбновитьСервер(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПолнаяТабличнаяЧастьОС_ЗаполнитьСтрокуДаннымиИзОСАмортизацияСервер(ИдТекСтроки)
	
	Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ЗаполнитьСтрокуДаннымиИзОСАмортизацияСервер(ЭтаФорма, ИдТекСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолнаяТабличнаяЧастьОС_ПриИзмененииПоляТаблицыОСАмортизацияКлиент(Элемент)
	
	ТекДанные	= Элементы["ОС_Основная"].ТекущиеДанные;
	ОС			= ТекДанные["ОС"];
	
	Если ЗначениеЗаполнено(ОС) Тогда
		ИдТекСтроки = Элементы["ОС_Основная"].ТекущаяСтрока;
		
		ПолнаяТабличнаяЧастьОС_ПриИзмененииПоляТаблицыОСАмортизацияСервер(ИдТекСтроки, Элемент.Имя);
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолнаяТабличнаяЧастьОС_ПриИзмененииПоляТаблицыОСАмортизацияСервер(ИдТекСтроки, ИмяЭлемента)
	
	Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ПриИзмененииПоляТаблицыОСАмортизацияСервер(ЭтаФорма, ИдТекСтроки, ИмяЭлемента);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонок(НоваяДоступность)
	
	Для Каждого Элем Из ПустаяСтрокаТаблицыОСОсновная Цикл
		ИмяКолонки = Элем.Ключ;
		ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонки(ИмяКолонки, НоваяДоступность, Ложь);
	КонецЦикла;
	
	Для Каждого Элем Из ПустаяСтрокаТаблицыОСАмортизация Цикл
		ИмяКолонки = Элем.Ключ;
		ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонки(ИмяКолонки, НоваяДоступность, Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонки(ИмяКолонки, НоваяДоступность, ЭтоКолонкаОСАмортизация)
	
	Если ВРег(ИмяКолонки) = "ОС" Тогда
		Возврат;
	КонецЕсли;
	
	КолонкаРедактируетсяВТаблице = ?(ЭтоКолонкаОСАмортизация,
		ПолнаяТабличнаяЧастьОС_ИменаРедактируемыхВТаблицеКолонокОСАмортизация.Свойство(ИмяКолонки),
		Истина);
	
	Если КолонкаРедактируетсяВТаблице Тогда
		ИмяЭлемента	= "ОС_Основная" + ИмяКолонки;
		
		Попытка
			Элементы[ИмяЭлемента].ТолькоПросмотр = НЕ НоваяДоступность;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

//---
// Редактирование в диалоге
//---

&НаКлиенте
Процедура РедактированиеВДиалоге_НастроитьФормуПоПометке(ПометкаНовая = Ложь)
	
	Элементы["РедактированиеВДиалоге"].Пометка = ПометкаНовая;
	
	Элементы["ОС_Основная"].РежимВыделенияСтроки = ?(ПометкаНовая,
		РежимВыделенияСтрокиТаблицы.Строка,
		РежимВыделенияСтрокиТаблицы.Ячейка);
		
	//---
	// Полная табличная часть ОС
	//---
	ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонок(НЕ ПометкаНовая);
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеВДиалоге_ПроверитьИОткрытьДиалог(СтандартнаяОбработка = Неопределено, ПроверятьУстановленностьРежимаДиалога = Ложь)
	
	Перем ОткрытьФормуДиалога;
	
	Если НЕ РазрешитьРаботуСФормой Тогда
		// Выходим
		Возврат;
	КонецЕсли;
	
	ЭлементТаблицыОС = Элементы["ОС_Основная"];
	
	Если ПроверятьУстановленностьРежимаДиалога = Истина Тогда
		// Определяем, установлен ли режим редактирования в диалоге
		Если ЭлементТаблицыОС.ТекущийЭлемент.ТолькоПросмотр Тогда
			РежимДиалогаУстановлен = Истина;
		Иначе
			ИмяКолонки = Сред(ЭлементТаблицыОС.ТекущийЭлемент.Имя, 12);
			Если ВРег(ИмяКолонки) = "ОС" ИЛИ ВРег(ИмяКолонки) = "ОСПРЕДСТАВЛЕНИЕ" Тогда
				// Редактируем все равно в строке.
				РежимДиалогаУстановлен = Ложь;
			Иначе
				РежимДиалогаУстановлен = Элементы["РедактированиеВДиалоге"].Пометка;
			КонецЕсли;
		КонецЕсли;
	Иначе
		РежимДиалогаУстановлен = Истина;
	КонецЕсли;
	
	Если РежимДиалогаУстановлен = Истина Тогда
		ТекДанные = ЭлементТаблицыОС.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			// Выходим
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные["ОС"]) Тогда
			ОткрытьФормуДиалога = Истина;
		Иначе
			
			ТекстСообщения	= НСтр("ru='Укажите основное средство'");
			ИндексСтроки	= ТекДанные.НомерСтроки - 1;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				Объект.Ссылка,
				"ОС_Основная[" + ИндексСтрокиТекст + "].ОС",
				"Объект");
		КонецЕсли;
	КонецЕсли;
	
	Если ОткрытьФормуДиалога = Истина Тогда
		СтандартнаяОбработка = Ложь;
		РедактированиеВДиалоге_ОткрытьДиалог(ИмяКолонки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеВДиалоге_ОткрытьДиалог(ИмяПоля = Неопределено)
	
	ИдСтроки		= Элементы["ОС_Основная"].ТекущаяСтрока;
	ТекДанные		= Элементы["ОС_Основная"].ТекущиеДанные;
	ИндексСтроки	= ТекДанные.НомерСтроки - 1;
	
	АдресДанных			= ПоместитьТекущиеДанныеВХранилище(ИдСтроки, ИндексСтроки, ИмяПоля, ТекстЗаголовкаСообщений);
	ПараметрыФормы		= Новый Структура("АдресДанных", АдресДанных);
	ПараметрыОповещения	= Новый Структура();
	ПараметрыОповещения.Вставить("АдресДанных",	АдресДанных);
	ПараметрыОповещения.Вставить("ТекДанные",	ТекДанные);
	
	ОписаниеОповещения_Закрытие = Новый ОписаниеОповещения("ЗавершитьРедактированиеТекСтрокиОСКлиент", ЭтотОбъект, ПараметрыОповещения);
	ОткрытьФорму("Документ.ВводНачальныхОстатков.Форма.ОССобытияСтрока", ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещения_Закрытие, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьТекущиеДанныеВХранилище(ИдТекСтроки, ИндексТекСтроки, ИмяАктивногоПоля, ТекстЗаголовкаСообщений = Неопределено)
	
	// Текущие данные в ТЧ ОС_Основная
	ТекДанныеОСОсновная = Объект["ОС_Основная"].НайтиПоИдентификатору(ИдТекСтроки);
	
	// Текущие данные в ТЧ ОС_Амортизация
	ОССсылка = ТекДанныеОСОсновная.ОС;
	Отбор = Новый Структура("ОС", ОССсылка);
	МассивСтрок = Объект["ОС_Амортизация"].НайтиСтроки(Отбор);
	Если МассивСтрок.Количество() > 0 Тогда
		ТекДанныеОСАмортизация = МассивСтрок[0];
	Иначе
		ТекДанныеОСАмортизация = Объект["ОС_Амортизация"].Добавить();
		ТекДанныеОСАмортизация.ОС = ОССсылка;
	КонецЕсли;
	
	// Запоминаем идентификаторы текущих строк
	ИдТекСтроки_ОСОсновная		= ИдТекСтроки;
	ИдТекСтроки_ОСАмортизация	= ТекДанныеОСАмортизация.ПолучитьИдентификатор();
	
	
	// Данные шапки документа
	ТекДанные_Документ = Новый Структура("
		|Дата,
		|Организация,
		|РазделУчета,
		|КФО,
		|ИФО,
		|Счет,
		|КПС,
		|КЭК");
	ЗаполнитьЗначенияСвойств(ТекДанные_Документ, Объект);
	
	// Данные текущей строки ОС_Основная
	ТекДанные_Основная = Новый Структура("НомерСтроки");
	Для Каждого Элем Из ПустаяСтрокаТаблицыОСОсновная Цикл
		ТекДанные_Основная.Вставить(Элем.Ключ);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(ТекДанные_Основная, ТекДанныеОСОсновная);
	
	// Данные текущей строки ОС_Амортизация
	ТекДанные_Амортизация = Новый Структура();
	Для Каждого Элем Из ПустаяСтрокаТаблицыОСАмортизация Цикл
		ТекДанные_Амортизация.Вставить(Элем.Ключ);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(ТекДанные_Амортизация, ТекДанныеОСАмортизация);
	
	ПередаваемыеДанные = Новый Структура();
	ПередаваемыеДанные.Вставить("ТекДанные_Документ",		ТекДанные_Документ);
	ПередаваемыеДанные.Вставить("ТекДанные_Основная",		ТекДанные_Основная);
	ПередаваемыеДанные.Вставить("ТекДанные_Амортизация",	ТекДанные_Амортизация);
	ПередаваемыеДанные.Вставить("ИндексТекСтроки",			ИндексТекСтроки);
	ПередаваемыеДанные.Вставить("ИмяАктивногоПоля",			ИмяАктивногоПоля);
	ПередаваемыеДанные.Вставить("ТекстЗаголовкаСообщений",	ТекстЗаголовкаСообщений);
	
	Возврат ПоместитьВоВременноеХранилище(ПередаваемыеДанные, ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

// Вызывается при закрытии формы редактирования строки ОС для применения сделанных изменений.
&НаКлиенте
Процедура ЗавершитьРедактированиеТекСтрокиОСКлиент(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		
		ЗавершитьРедактированиеТекСтрокиОССервер(ПараметрыОповещения["АдресДанных"]);
		
		ТекДанные = ПараметрыОповещения["ТекДанные"];
		
		ОповеститьОбИзменении(ТекДанные.ОС);
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьРедактированиеТекСтрокиОССервер(АдресДанных)
	
	ВходящиеДанные = ПолучитьИзВременногоХранилища(АдресДанных);
	
	// Обновляем в ТЧ "ОС Основная" поля текущей строки
	ТекДанные = Объект["ОС_Основная"].НайтиПоИдентификатору(ИдТекСтроки_ОСОсновная);
	Если НЕ ТекДанные = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ТекДанные, ВходящиеДанные.ТекущиеДанные);
	КонецЕсли;
	
	// Обновляем в ТЧ "ОС Амортизация" поля текущей строки
	ТекДанные = Объект["ОС_Амортизация"].НайтиПоИдентификатору(ИдТекСтроки_ОСАмортизация);
	Если НЕ ТекДанные = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ТекДанные, ВходящиеДанные.ТекущиеДанные);
	КонецЕсли;
	
	// Обновляем модифицируемые свойства ОС
	ОССсылка = ТекДанные["ОС"];
	ТекущиеСвойстваОС = Документы.ВводНачальныхОстатков.ПолучитьЗначенияМодифицируемыхРеквизитовОС(
		Объект["РазделУчета"],
		ОССсылка);
	Документы.ВводНачальныхОстатков.ОбновитьИзмененныеРеквизитыОС(
		ОССсылка,
		ТекущиеСвойстваОС,
		ВходящиеДанные["РеквизитыОСНаФорме"]);
	
	//---
	// Полная табличная часть ОС
	//---
	ПолнаяТабличнаяЧастьОС_ОбновитьСервер();
	
	// Восстанавливаем положение текущей строки
	ИндексТекущейСтроки = ВходящиеДанные.ТекущиеДанные.НомерСтроки - 1;
	Элементы["ОС_Основная"].ТекущаяСтрока = Объект["ОС_Основная"][ИндексТекущейСтроки].ПолучитьИдентификатор();
	
КонецПроцедуры

