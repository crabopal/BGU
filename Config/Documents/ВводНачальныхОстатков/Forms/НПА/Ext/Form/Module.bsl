&НаКлиенте
Процедура ОС_ОсновнаяВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	РедактированиеВДиалоге_ПроверитьИОткрытьДиалог(СтандартнаяОбработка, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяОСПриИзменении(Элемент)
	
	ПолнаяТабличнаяЧастьОС_ЗаполнитьСтрокуДаннымиИзОСАмортизацияСервер(Элементы["ОС_Основная"].ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяСуммаПриИзменении(Элемент)
	
	ТекДанные = Элементы.ОС_Основная.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		ТекДанные.ПервоначальнаяСтоимость = ТекДанные.Сумма;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяСостояниеОСПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	СостояниеОС = ТекДанные["СостояниеОС"];
	
	Если НЕ СостояниеОС = ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию") Тогда
		ТекДанные["ВводВЭксплуатациюОдновременноСПринятиемКУчету"] = Ложь;
		
		Если НЕ ЗначениеЗаполнено(СостояниеОС) Тогда
			ТекДанные["ДатаВводаВЭксплуатацию"]					= Дата(1,1,1);
			ТекДанные["НазваниеДокументаВводаВЭксплуатацию"]	= "";
			ТекДанные["НомерДокументаВводаВЭксплуатацию"]		= "";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяВводВЭксплуатациюОдновременноСПринятиемКУчетуПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	
	Если ТекДанные["ВводВЭксплуатациюОдновременноСПринятиемКУчету"] Тогда
		ТекДанные["ДатаВводаВЭксплуатацию"]					= ТекДанные["ДатаПринятияКУчету"];
		ТекДанные["НазваниеДокументаВводаВЭксплуатацию"]	= ТекДанные["НазваниеДокументаПринятияКУчету"];
		ТекДанные["НомерДокументаВводаВЭксплуатацию"]		= ТекДанные["НомерДокументаПринятияКУчету"];
	КонецЕсли;
	
КонецПроцедуры

