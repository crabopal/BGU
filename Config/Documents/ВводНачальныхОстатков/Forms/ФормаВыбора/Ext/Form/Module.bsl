
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не Параметры.Свойство("Отбор") Или Параметры.Отбор.Количество() = 0 Тогда
		Организация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Организация", Справочники.Организации.ПустаяСсылка());
		Если ЗначениеЗаполнено(Организация) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Организация", Организация);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
