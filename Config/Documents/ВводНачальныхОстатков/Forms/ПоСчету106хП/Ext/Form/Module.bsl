&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	АвтоматическиРассчитыватьИтоги = Истина;
	
	//---
	// КЭК0
	//---
	УстановитьНовоеЗначениеКЭК = Ложь;
	
	// Заполняем по возможности пустые поля формы:
	Если Объект.Ссылка.Пустая() Тогда
		
		Попытка
			ЭтаФорма.ТиповаяОперация = Справочники.ТиповыеОперации.ВводНачальныхОстатков_Счет106хП;
		Исключение
		КонецПопытки;
		
		Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.Счет) Тогда
			НаДату = ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(Объект.Дата);
			
			Объект.Счет = БухгалтерскийУчет.СчетПоКоду("106.00", НаДату);
		КонецЕсли;
		
		//---
		// КЭК0
		//---
		УстановитьНовоеЗначениеКЭК = Истина;
		
	КонецЕсли;
	
	МассивКФОдляНалоговогоУчета = Новый ФиксированныйМассив(НалоговыйУчетКлиентСервер.ПолучитьМассивКФОдляНалоговогоУчета());
	
	ОпределитьСчета106хП();
	
	ПодразделениеИспользуетсяНаСчетах106хП		= Документы.ВводНачальныхОстатков.ПодразделениеИспользуетсяНаСчетах106хП(Объект.Дата);
	ПодразделениеНеИспользуетсяНаСчетах106хП	= НЕ ПодразделениеИспользуетсяНаСчетах106хП;
	
	Элементы["ПодразделениеОрганизации"].Видимость = ПодразделениеИспользуетсяНаСчетах106хП;
	
	//---
	// КЭК0
	//---
	КЭК0 = БухгалтерскийУчетПовтИсп.КЭК0();
	ПроконтролироватьЗначениеКЭКСервер_ВоВсейТаблице(УстановитьНовоеЗначениеКЭК);
	
	УстановитьЗаголовокФормы();
	
	// Обновляем значения параметров ведения налогового учета и настраиваем форму:
	НастроитьФормуСерверСогласноРежимуВводаОстатков();
	
	НастроитьВидимостьЭлементовСервер();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ЗаголовокФормы = "Ввод начальных остатков по счету 106.хП ";
	Если Объект.Ссылка.Пустая() Тогда
		ЗаголовокФормы = ЗаголовокФормы + "(создание)";
	Иначе
		ЗаголовокФормы = ЗаголовокФормы + Объект.Номер + " от " + Объект.Дата;
	КонецЕсли;
	ЭтаФорма.Заголовок = ЗаголовокФормы;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборЗатрат()
	
	ТекДанныеМатериалы = Элементы.Материалы106хП.ТекущиеДанные;
	
	Если ТекДанныеМатериалы = Неопределено Тогда
		НовыйОтборСтрок = Неопределено;
	Иначе
		ВремСтруктура = ПолучитьСтруктуруКлючаСвязи(Объект); //Новый Структура("Номенклатура, КПС, Счет");
		ЗаполнитьЗначенияСвойств(ВремСтруктура, ТекДанныеМатериалы);
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура(ВремСтруктура);
	КонецЕсли;
	
	Элементы.Затраты106хП.ОтборСтрок = НовыйОтборСтрок;
	
	// Обновляем итоги по номенклатуре на форме:
	УстановитьЗначенияПолейИтого();
	
КонецПроцедуры

&НаСервере
Процедура УдалитьЗатратыПоСтрокеМатериалыСервер(КлючЗаписи)
	
	// Удаляем строку в таблице "Затраты" только если в основной таблице
	// больше не осталось строк с указанным ключом:
	Если Объект["Материалы106хП"].НайтиСтроки(КлючЗаписи).Количество() = 0 Тогда
		
		ТаблЧасть = Объект["Затраты106хП"];
		СтрокиТЧ = ТаблЧасть.НайтиСтроки(КлючЗаписи);
		Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
			ТаблЧасть.Удалить(СтрокаТЧ);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаменитьПоляСвязиВТЧЗатратыСервер(Знач ПоляСвязиПред, ПоляСвязиНов)
	
	ОсталисьСтрокиСПрежнимиПолямиСвязи = (Объект["Материалы106хП"].НайтиСтроки(ПоляСвязиПред).Количество() >= 1);
	
	// Заменяем поля связи в таблице "Затраты":
	ТаблЧастьЗатраты106хП = Объект["Затраты106хП"];
	СтрокиТЧ = ТаблЧастьЗатраты106хП.НайтиСтроки(ПоляСвязиПред);
	Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
		Если ОсталисьСтрокиСПрежнимиПолямиСвязи Тогда
			НоваяСтрока = ТаблЧастьЗатраты106хП.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПоляСвязиНов);
		Иначе	
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, ПоляСвязиНов);
		КонецЕсли;
	КонецЦикла;
	
	Если АвтоматическиРассчитыватьИтоги Тогда
		РассчитатьИтогиСервер(ПоляСвязиНов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиТекущуюНоменклатуру()
	
	ТекДанныеМатериалы = Элементы.Материалы106хП.ТекущиеДанные;
	
	Ссылка = ?(ТекДанныеМатериалы = Неопределено, Неопределено, ТекДанныеМатериалы.Номенклатура);
	ТекущаяНоменклатура = ?(ЗначениеЗаполнено(Ссылка), Строка(Ссылка), НСтр("ru='номенклатура не выбрана'"));
	
КонецПроцедуры

// Сравнивает поля структур и возвращает признак отличия определенных полей.
&НаКлиенте
Функция ПолеСвязиИзменено(ТекДанные, ПрежнийКлючСвязи, ВозвратНовыйКлючСвязи)
	
	ВозвратНовыйКлючСвязи = Новый Структура();
	
	Результат = Ложь;
	
	Для Каждого Элем Из ПрежнийКлючСвязи Цикл
		ИмяПоля				= Элем.Ключ;
		ПрежнееЗначениеПоля	= Элем.Значение;
		НовоеЗначениеПоля	= ТекДанные[ИмяПоля];
		Если НЕ ПрежнееЗначениеПоля = НовоеЗначениеПоля Тогда
			// Обнаружили отличие.
			Результат = Истина;
		КонецЕсли;
		ВозвратНовыйКлючСвязи.Вставить(ИмяПоля, НовоеЗначениеПоля);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПолучитьДату()
	
	Возврат КонецГода(Объект.Дата) + 1;
	
КонецФункции

&НаСервере
Процедура РассчитатьИтогиСервер(КлючЗаписи = Неопределено)
	
	Перем КлючНоменклатура, КлючСчет, КлючКПС;
	
	// Входная проверка:
	Если КлючЗаписи = Неопределено Тогда
		// Рассчитываем итоги для каждой строки таблицы "Материалы".
		КлючЗаписи = ПолучитьСтруктуруКлючаСвязи(Объект); //Новый Структура("Номенклатура, КПС, Счет");
		КлючЗаписиУстановлен = Ложь;
	Иначе
		КлючЗаписиУстановлен = Истина;
	КонецЕсли;
	КлючСодержитНоменклатура	= КлючЗаписи.Свойство("Номенклатура",	КлючНоменклатура);
	КлючСодержитСчет			= КлючЗаписи.Свойство("Счет",			КлючСчет);
	КлючСодержитКПС				= КлючЗаписи.Свойство("КПС",			КлючКПС);
	
	// Настраиваем запрос:
	ЗапросИтоги = Новый Запрос();
	ЗапросИтоги.УстановитьПараметр("ТЧМатериалы106хП",			Объект["Материалы106хП"].Выгрузить());
	ЗапросИтоги.УстановитьПараметр("ТЧЗатраты106хП",			Объект["Затраты106хП"].Выгрузить());
	ЗапросИтоги.УстановитьПараметр("Номенклатура",				КлючНоменклатура);
	ЗапросИтоги.УстановитьПараметр("Счет",						КлючСчет);
	ЗапросИтоги.УстановитьПараметр("КПС",						КлючКПС);
	ЗапросИтоги.УстановитьПараметр("КлючЗаписиУстановлен",		КлючЗаписиУстановлен);
	ЗапросИтоги.УстановитьПараметр("КлючСодержитКПС",			КлючСодержитКПС);
	
	ЗапросИтоги.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Исходные данные табличной части документа
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	// Поля, по которым рассчитываются итоги:
	|	ТЧ.Сумма		КАК Сумма,
	|	ТЧ.СуммаНУ		КАК СуммаНУ,
	|	
	|	// Все допустимые поля связи:
	|	ТЧ.Номенклатура	КАК Номенклатура,
	|	ТЧ.КПС			КАК КПС,
	|	ТЧ.Счет			КАК Счет
	|ПОМЕСТИТЬ
	|	ТаблЧасть_Затраты106хП
	|ИЗ
	|	&ТЧЗатраты106хП	КАК ТЧ
	|ИНДЕКСИРОВАТЬ ПО
	|	// Все допустимые поля связи:
	|	Номенклатура,
	|	КПС,
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Исходные данные табличной части документа
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.НомерСтроки	КАК НомерСтроки,
	|	
	|	// Все допустимые поля связи:
	|	ТЧ.Номенклатура	КАК Номенклатура,
	|	ТЧ.КПС			КАК КПС,
	|	ТЧ.Счет			КАК Счет
	|ПОМЕСТИТЬ
	|	ТаблЧасть_Материалы106хП
	|ИЗ
	|	&ТЧМатериалы106хП	КАК ТЧ
	|ИНДЕКСИРОВАТЬ ПО
	|	// Все допустимые поля связи:
	|	Номенклатура,
	|	КПС,
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Расчет итогов по таблице ""Затраты""
	|//		(Финальная таблица)
	|ВЫБРАТЬ
	|	Материалы.НомерСтроки	КАК НомерСтрокиМатериалы,
	|	
	|	// Поля, по которым рассчитываются итоги:
	|	СУММА(Затраты.Сумма)	КАК ИтогоСумма,
	|	СУММА(Затраты.СуммаНУ)	КАК ИтогоСуммаНУ
	|ИЗ
	|	ТаблЧасть_Материалы106хП	КАК Материалы
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ТаблЧасть_Затраты106хП	КАК Затраты
	|		// Поля связи:
	|		ПО	Затраты.Номенклатура	= Материалы.Номенклатура
	|		И	Затраты.Счет			= Материалы.Счет
	|		И ВЫБОР
	|			КОГДА &КлючСодержитКПС ТОГДА
	|				Затраты.КПС			= Материалы.КПС
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|ГДЕ
	|	ВЫБОР
	|		КОГДА &КлючЗаписиУстановлен ТОГДА
	|			// Отбор по ключу задан, рассчитываем итоги только для строк с указанным ключом.
	|			Материалы.Номенклатура	= &Номенклатура
	|			И Материалы.Счет		= &Счет
	|			И ВЫБОР
	|				КОГДА &КлючСодержитКПС ТОГДА
	|					Материалы.КПС	= &КПС
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ
	|		ИНАЧЕ
	|			// Отбор по ключу не задан, рассчитываем итоги для всей таблицы.
	|			ИСТИНА
	|	КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	Материалы.НомерСтроки
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";
	
	// Выполняем запрос:
	ТЗИтоги = ЗапросИтоги.Выполнить().Выгрузить();
	
	// Обновляем таблицу "Материалы":
	ТаблЧасть = Объект["Материалы106хП"];
	Для Каждого СтрокаИтоги Из ТЗИтоги Цикл
		ИндексСтроки = СтрокаИтоги["НомерСтрокиМатериалы"] - 1;
		
		ЗаполнитьЗначенияСвойств(ТаблЧасть[ИндексСтроки], СтрокаИтоги);
	КонецЦикла;
	
	// Сбрасываем флаг необходимости расчета итогов:
	РассчитатьИтоги = Ложь;
	
КонецПроцедуры

&НаКлиенте
Функция УстановитьЗначенияПолейИтого()
	
	ТекДанные = Элементы["Материалы106хП"].ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		
		ИтогоЗатратыСумма = ?(РассчитатьИтоги,
			НСтр("ru='<не рассчитано>'"),
			Формат(ТекДанные["ИтогоСумма"], "ЧДЦ=2"));
		ИтогоЗатратыСуммаНУ = ?(РассчитатьИтоги,
			НСтр("ru='<не рассчитано>'"),
			Формат(ТекДанные["ИтогоСуммаНУ"], "ЧДЦ=2"));
			
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСтруктуруКлючаСвязи(ДокументОбъект)
	
	Результат = Новый Структура("Номенклатура, Счет");
	
	Если ДокументОбъект["ОтражатьВБухгалтерскомУчете"] Тогда
		Результат.Вставить("КПС");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


// --- Режим ввода остатков ---
&НаСервере
Процедура НастроитьФормуСерверСогласноРежимуВводаОстатков()
	
	// Колонки, зависимые только от режима ввода остатков:
	ШапкаДокумента = Документы.ВводНачальныхОстатков.РежимВводаОстатков_СтруктураШапкиДокумента();
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, Объект);
	РезультатПроверки = Неопределено;
	ТаблицаПолейРежимов = Документы.ВводНачальныхОстатков.РежимВводаОстатков_ИменаПолейВсехРежимов(
		ШапкаДокумента,
		,	// ТолькоНеиспользуемые
		РезультатПроверки);
	
	// Параметры ведения налогового учета:
	ОбновитьПараметрыВеденияНалоговогоУчетаСервер(РезультатПроверки);
	
	Для Каждого СтрокаТЗ Из ТаблицаПолейРежимов Цикл
		
		НовВидимость	= СтрокаТЗ["Видимость"];
		
		// Новый цвет заголовка колонки:
		НовЦветЗаголовка = ?(СтрокаТЗ["Видимость"] И СтрокаТЗ["Используется"],
			ЦветаСтиля.ЦветТекстаФормы,	// корректно
			ЦветаСтиля.НепринятаяВерсия);	// не корректно
		
		// Задаем новую видимость колонки:
		Колонка = Элементы[СтрокаТЗ["Элемент"]];
		Колонка.Видимость = НовВидимость;
		Колонка.ЦветТекстаЗаголовка = НовЦветЗаголовка;
		
	КонецЦикла;
	
	
	// Особые настройки при исключительно нал.режиме ввода остатков.
	ТолькоНалУчет = Объект["ОтражатьВНалоговомУчете"] И НЕ Объект["ОтражатьВБухгалтерскомУчете"];
	// Ограничение выбора КФО:
	ЭлементКФО = Элементы["КФО"];
	Если ТолькоНалУчет Тогда
		ЭлементКФО.СписокВыбора.ЗагрузитьЗначения(НалоговыйУчетКлиентСервер.ПолучитьМассивКФОдляНалоговогоУчета());
		ЭлементКФО.РежимВыбораИзСписка = Истина;
	Иначе
		ЭлементКФО.РежимВыбораИзСписка = Ложь;
	КонецЕсли;
	// Кнопка "Заполнить по данным бух.учета":
	КФОСоответствует = НЕ (МассивКФОдляНалоговогоУчета.Найти(Объект["КФО"]) = Неопределено);
	Элементы["МатериалыЗаполнить"].Доступность = ТолькоНалУчет И КФОСоответствует;
	
	Если АвтоматическиРассчитыватьИтоги Тогда
		// Рассчитываем итоги для всей таблицы:
		РассчитатьИтогиСервер();
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура ОбновитьПараметрыВеденияНалоговогоУчетаСервер(РезультатПроверки)
	
	РежимВводаОстатковКорректный = НЕ ЗначениеЗаполнено(РезультатПроверки["ТекстСообщения"]);
	Если НЕ РежимВводаОстатковКорректный Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РезультатПроверки["ТекстСообщения"],
			Объект.Ссылка,
			РезультатПроверки["ИмяПоляДляВыводаСообщения"]);
	КонецЕсли;
	
	// Обновляем соответствующие реквизиты формы:
	НалУчет_УстановленКорректно = Объект["ОтражатьВНалоговомУчете"] И РежимВводаОстатковКорректный;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РежимВводаОстатков_СтруктураШапкиДокумента()
	
	Возврат Документы.ВводНачальныхОстатков.РежимВводаОстатков_СтруктураШапкиДокумента();
	
КонецФункции

//---
// Обработчики событий элементов формы

&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение = Неопределено)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОрганизацияПередИзменениемКлиент_Ответ", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении,
		НСтр("ru='Изменение организации вызовет полную очистку
		|табличной части документа и некоторых полей шапки.
		|
		|Продолжить и сменить организацию?'"),
		РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Объект["Организация"] = ПараметрыОповещения["ВыбранноеЗначение"];
		ЭтаФорма.Модифицированность = Истина;
		ОрганизацияПриИзмененииКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПриИзмененииКлиент()
	
	ОрганизацияПриИзмененииСервер();
	
КонецПроцедуры
&НаСервере
Процедура ОрганизацияПриИзмененииСервер()
	
	ОчиститьРеквизитыТабличнойЧастиНесоответствующиеОрганизации();
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер_ВоВсейТаблице(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры
&НаСервере
Процедура ОчиститьРеквизитыТабличнойЧастиНесоответствующиеОрганизации()
	
	// Очищаем некоторые поля в ТЧ "Материалы 106":
	ОчищающаяСтруктура = Новый Структура("
		|КПС,
		|ИтогоСумма,
		|ИтогоСуммаНУ");
	Для Каждого СтрокаТЧ Из Объект.Материалы106хП Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ОчищающаяСтруктура);
	КонецЦикла;
	
	// Устанавливаем новую дату документа:
	Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
	
	// Обновляем значения параметров ведения налогового учета и настраиваем форму:
	НастроитьФормуСерверСогласноРежимуВводаОстатков();
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииСервер()
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер_ВоВсейТаблице(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаСервере
Процедура КФОПриИзмененииСервер()
	
	// Обновляем значения параметров ведения налогового учета и настраиваем форму:
	НастроитьФормуСерверСогласноРежимуВводаОстатков();
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер_ВоВсейТаблице(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииСервер()
	
	// Обновляем значения параметров ведения налогового учета и настраиваем форму:
	НастроитьФормуСерверСогласноРежимуВводаОстатков();
	
	ОпределитьСчета106хП();
	
	НастроитьВидимостьЭлементовСервер();
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер_ВоВсейТаблице(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СчетПриИзмененииСервер_ОбновитьСтруктуруСтрокиТаблицы(СтруктураОбъект, СтруктураСтрокаТаблицы, МассивКФОдляНалоговогоУчета)
	
	//---
	// КЭК0
	//---
	СтруктураОбъектКЭК0			= КЭК0_ПолучитьПустуюСтруктуруОбъекта();
	СтруктураСтрокаТаблицыКЭК0	= КЭК0_ПолучитьПустуюСтруктуруСтрокиТаблицы();
	ЗаполнитьЗначенияСвойств(СтруктураОбъектКЭК0, СтруктураОбъект);
	ЗаполнитьЗначенияСвойств(СтруктураСтрокаТаблицыКЭК0, СтруктураСтрокаТаблицы);
	Если НеобходимоИзменитьЗначениеКЭК_ВТекущейСтроке(СтруктураОбъектКЭК0, СтруктураСтрокаТаблицыКЭК0, Истина) Тогда
		СтруктураСтрокаТаблицы["КЭК"] = СтруктураСтрокаТаблицыКЭК0["КЭК"];
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьСчета106хП()
	
	Счета106хП = Документы.ВводНачальныхОстатков.ПолучитьСписокСчетов106хП(Объект.Дата);
	
	МассивСчетов106хП = Новый ФиксированныйМассив(Счета106хП);
	
	СписокВыбора = Элементы.Материалы106хПСчет.СписокВыбора;
	СписокВыбора.Очистить();
	СписокВыбора.ЗагрузитьЗначения(Счета106хП);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьЭлементовСервер()
	
	НаличиеСубконто = БухгалтерскийУчет.ЕстьСубконтоСписокСчетов(МассивСчетов106хП, "ЦМО");
	
	СвойстваСубконтоЦМО = НаличиеСубконто["ЦМО"];
	
	Элементы.Затраты106хПЦМО.Видимость					= СвойстваСубконтоЦМО.ЕстьСубконто;
	Элементы.Затраты106хПЦМО.АвтоОтметкаНезаполненного	= СвойстваСубконтоЦМО.ПризнакиУчетаСубконто.Обязательный;
	
КонецПроцедуры

//---
// Заполнение табличных частей

&НаКлиенте
Процедура ПроверитьИОчиститьМатериалыКлиент()
	
	Если Объект["Материалы106хП"].Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru='Очистить табличные части ""Материалы"" и ""Затраты""?'");
			
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИОчиститьМатериалыКлиент_Ответ", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ОчиститьМатериалыКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИОчиститьМатериалыКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ОчиститьМатериалыКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьМатериалыКлиент()
	
	Объект["Материалы106хП"].Очистить();
	Объект["Затраты106хП"].Очистить();
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымБухУчетаКлиент()
	
	ТолькоНалУчет = Объект["ОтражатьВНалоговомУчете"] И НЕ Объект["ОтражатьВБухгалтерскомУчете"];
	КФОСоответствует = НЕ (МассивКФОдляНалоговогоУчета.Найти(Объект["КФО"]) = Неопределено);
	
	НужноЗаполнить = ТолькоНалУчет И КФОСоответствует;
	
	Если НЕ НужноЗаполнить Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Заполнение остатков вложений в материалы по данным бух.учета производится при условии:
				|	- режим ввода остатков: только налоговый учет
				|	- КФО=%1'"),
			СтрСоединить(МассивКФОдляНалоговогоУчета, ", "));
			
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
		Возврат;
	КонецЕсли;
	
	Если Объект["Материалы106хП"].Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru='Перед заполнением остатков материалов по данным бух.учета
			|будет очищена табличная часть ""Материалы""
			|
			|Продолжить и заполнить по данным бух.учета?'");
			
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьПоДаннымБухУчетаКлиент_Ответ", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьПоДаннымБухУчетаКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымБухУчетаКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоДаннымБухУчетаКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДаннымБухУчетаКлиент()
	
	ЗаполнитьПоДаннымБухУчетаСервер();
	
	// Если по данным учета не было добавлено ни одной строки, выведем сообщение:
	Если Объект["Материалы106хП"].Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Остатки вложений в материалы по данным бух.учета отсутствуют'");
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
	УстановитьЗначенияПолейИтого();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДаннымБухУчетаСервер()
	
	// Подготовка:
	ВидыСубконтоНоменклатураВидЗатрат = Новый Массив();
	ВидыСубконтоНоменклатураВидЗатрат.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ВидыСубконтоНоменклатураВидЗатрат.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат);
	
	// Настраиваем запрос:
	ЗапросОстатки = Новый Запрос();
	ЗапросОстатки.УстановитьПараметр("ДатаСреза",	Новый Граница(КонецДня(Объект["Дата"]), ВидГраницы.Включая));
	ЗапросОстатки.УстановитьПараметр("Организация",	Объект["Организация"]);
	ЗапросОстатки.УстановитьПараметр("ИФО",			?(ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"),
														Объект["ИФО"],
														Неопределено));
	ЗапросОстатки.УстановитьПараметр("МассивКФО",	МассивКФОдляНалоговогоУчета);
	ЗапросОстатки.УстановитьПараметр("Счета106хП",	МассивСчетов106хП);
	ЗапросОстатки.УстановитьПараметр("ВидыСубконтоНоменклатураВидЗатрат",	ВидыСубконтоНоменклатураВидЗатрат);
	ЗапросОстатки.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Остатки вложений в материалы по данным бух.учета,
	|//		одной общей таблицей.
	|//		
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Счет				КАК Счет,
	|	Субконто1			КАК Номенклатура,
	|	Субконто2			КАК ВидЗатрат,
	|	КоличествоОстаток	КАК Количество,
	|	СуммаОстаток		КАК Сумма
	|ПОМЕСТИТЬ
	|	Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ДатаСреза,
	|		Счет В ИЕРАРХИИ (&Счета106хП),
	|		
	|		&ВидыСубконтоНоменклатураВидЗатрат,
	|		
	|		Организация = &Организация
	|		И ВЫБОР
	|			КОГДА &ИФО = НЕОПРЕДЕЛЕНО ТОГДА
	|				ИСТИНА
	|			ИНАЧЕ
	|				(ИФО = &ИФО)
	|		КОНЕЦ
	|		И	КФО В (&МассивКФО))	КАК ЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Остатки вложений в материалы по данным бух.учета
	|//		(Финальная таблица ""Материалы106хП"")
	|ВЫБРАТЬ
	|	// Поля связи:
	|	Номенклатура		КАК Номенклатура,
	|	Счет				КАК Счет,
	|	НЕОПРЕДЕЛЕНО		КАК КПС,
	|	
	|	Номенклатура.Наименование	КАК НоменклатураПредставление,
	|	СУММА(Количество)	КАК Количество
	|ИЗ
	|	Остатки
	|СГРУППИРОВАТЬ ПО
	|	// Поля связи:
	|	Счет,
	|	Номенклатура,
	|	НЕОПРЕДЕЛЕНО,
	|	Номенклатура.Наименование
	|УПОРЯДОЧИТЬ ПО
	|	Счет.Порядок,
	|	Номенклатура.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Остатки вложений в материалы по данным бух.учета
	|//		(Финальная таблица ""Затраты106хП"")
	|ВЫБРАТЬ
	|	// Поля связи:
	|	Номенклатура	КАК Номенклатура,
	|	Счет			КАК Счет,
	|	НЕОПРЕДЕЛЕНО	КАК КПС,
	|	
	|	ВидЗатрат		КАК ВидЗатрат,
	|	Сумма			КАК Сумма,
	|    Сумма			КАК СуммаНУ
	|ИЗ
	|	Остатки
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	Счет,
	|	ВидЗатрат.Наименование
	|;";
	
	РезультатыОстатки = ЗапросОстатки.ВыполнитьПакет();
	
	НовМатериалы = РезультатыОстатки[1].Выгрузить();
	НовЗатраты = РезультатыОстатки[2].Выгрузить();
	
	// МАТЕРИАЛЫ: заполняем колонку СчетНУ:
	НовМатериалы.Колонки.Добавить("СчетНУ", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Для Каждого СтрокаТЗ Из НовМатериалы Цикл
		СтрокаТЗ["СчетНУ"] = НалоговыйУчетКлиентСервер.СчетНУпоСчетуБУ(СтрокаТЗ["Счет"], Объект.Дата);
	КонецЦикла;
	// заготовка
	//НовМатериалы.Свернуть("Номенклатура,НоменклатураПредставление,СчетНУ", "Количество");

	// ЗАТРАТЫ: заполняем колонку СчетНУ:
	НовЗатраты.Колонки.Добавить("СчетНУ", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Для Каждого СтрокаТЗ Из НовЗатраты Цикл
		СтрокаТЗ["СчетНУ"] = НалоговыйУчетКлиентСервер.СчетНУпоСчетуБУ(СтрокаТЗ["Счет"], Объект.Дата);
	КонецЦикла;
	// заготовка
	//НовЗатраты.Свернуть("Номенклатура,СчетНУ,ВидЗатрат", "Сумма,СуммаНУ");
	
	Объект["Материалы106хП"].Загрузить(НовМатериалы);
	Объект["Затраты106хП"].Загрузить(НовЗатраты);
	
	РассчитатьИтогиСервер();
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

