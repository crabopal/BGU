&НаКлиенте
Перем ТекстЗаголовкаСообщений;

&НаКлиенте
Перем	Материалы_КлючСвязи_ПриНачалеРедактирования,
		Материалы_УдаленнаяСтрока,
		Материалы_Подключаемый_ПрежнийКлючСвязи,
		Материалы_Подключаемый_ТекущийКлючСвязи;

&НаКлиенте
Перем	Затраты_ТекущиеДанные_ПриНачалеРедактирования,
		Затраты_УдаленнаяСтрока;

// Структура реквизитов, используемых при анализе режима ввода остатков.
&НаКлиенте
Перем ШапкаДокументаКлиент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПодготовитьФормуНаСервере();
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Ввод начальных остатков по счету 106.хП'");
	
	ВводНачальныхОстатковКлиент.ПриОткрытии(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Подсчитываем итоги затрат для каждой номенклатуры:
	РассчитатьИтогиСервер();
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	УстановитьЗаголовокФормы();
	
	// Подсчитываем итоги затрат для каждой номенклатуры:
	РассчитатьИтогиСервер();
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	// Оповещаем форму Помощника ввода начальных остатков:
	ИмяСобытия = "ЗаписанДокументВводНачальныхОстатков";
	Параметр = Объект["Организация"];
	Оповестить(ИмяСобытия, Параметр);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаВводаОстатковПриИзменении(Элемент)
	
	ДатаПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	БухгалтерскийУчетКлиент.ОбработатьВыборКФО(Объект.Организация,
											   Объект.ИФО,
											   Объект.КФО,
											   ПолучитьДату());
											   
	КФОПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПервичногоДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФорму("Справочник.ВидыПервичныхДокументов.ФормаВыбора", , Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура АвтоматическиРассчитыватьИтогиПриИзменении(Элемент)
	
	Если АвтоматическиРассчитыватьИтоги Тогда
		// Рассчитываем итоги для всей таблицы:
		РассчитатьИтогиСервер();
	КонецЕсли;
		
	// Обновляем поля, выводимые в подвал таблицы "Затраты":
	УстановитьЗначенияПолейИтого();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимВводаОстатковНажатие(Элемент)
	
	Если НЕ ТипЗнч(ШапкаДокументаКлиент) = Тип("Структура") Тогда
		ШапкаДокументаКлиент = РежимВводаОстатков_СтруктураШапкиДокумента();
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ШапкаДокументаКлиент, Объект);
	
	ОписаниеОповещения_Закрытие = Новый ОписаниеОповещения("РежимВводаОстатков_ВыборСделан", ЭтотОбъект);
	Результат = ОткрытьФорму("Документ.ВводНачальныхОстатков.Форма.НастройкиРежима", ШапкаДокументаКлиент, ЭтаФорма,,,,ОписаниеОповещения_Закрытие, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РежимВводаОстатков_ВыборСделан(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		ДанныеИзменены = (НЕ Объект.ОтражатьВБухгалтерскомУчете = РезультатВыбора.ОтражатьВБухгалтерскомУчете)
			ИЛИ (НЕ Объект.ОтражатьВНалоговомУчете = РезультатВыбора.ОтражатьВНалоговомУчете);
		Если ДанныеИзменены Тогда
			ЗаполнитьЗначенияСвойств(Объект, РезультатВыбора);
			ЭтаФорма.Модифицированность = Истина;
			
			// Обновляем значения параметров ведения налогового учета и настраиваем форму:
			НастроитьФормуСерверСогласноРежимуВводаОстатков();
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Материалы106хП

&НаКлиенте
Процедура Материалы106хППриАктивизацииСтроки(Элемент)
	
	УстановитьОтборЗатрат();
	
	// Подсказка о текущей выбранной номенклатуре:
	ВывестиТекущуюНоменклатуру();
	
КонецПроцедуры

&НаКлиенте
Процедура Материалы106хППередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы["Материалы106хП"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Запоминаем ключ удаляемой строки:
	Материалы_УдаленнаяСтрока = ПолучитьСтруктуруКлючаСвязи(Объект); //Новый Структура("Номенклатура, КПС, Счет");
	ЗаполнитьЗначенияСвойств(Материалы_УдаленнаяСтрока, ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура Материалы106хППриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы.Материалы106хП.ТекущиеДанные;
	
	// Запоминаем значения полей строки в начале ее редактирования:
	//Материалы_КлючСвязи_ПриНачалеРедактирования = Новый Структура("Номенклатура, КПС, Счет, КЭК");
	Материалы_КлючСвязи_ПриНачалеРедактирования = ПолучитьСтруктуруКлючаСвязи(Объект); //Новый Структура("Номенклатура, КПС, Счет");
	ЗаполнитьЗначенияСвойств(Материалы_КлючСвязи_ПриНачалеРедактирования, ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура Материалы106хППередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если ОтменаРедактирования И НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТаблЧасти = "Материалы106хП";
	ТекДанные = Элементы[ИмяТаблЧасти].ТекущиеДанные;
	
	Если ОтменаРедактирования И НЕ НоваяСтрока Тогда
		// Восстанавливаем начальные значения строки,
		// включая ссылочное и комбинированное поля "Номенклатура":
		ЗаполнитьЗначенияСвойств(ТекДанные, Материалы_КлючСвязи_ПриНачалеРедактирования);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Материалы106хППриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	// Подсказка о текущей выбранной номенклатуре:
	ВывестиТекущуюНоменклатуру();
	
	ИмяТаблЧасти = "Материалы106хП";
	ТекДанные = Элементы[ИмяТаблЧасти].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Материалы_Подключаемый_ПрежнийКлючСвязи = Материалы_КлючСвязи_ПриНачалеРедактирования;
		
	// Если изменили какое-либо поле связи двух табличных частей,
	// то это нужно учесть в ТЧ Затраты:
	Если ПолеСвязиИзменено(ТекДанные,
		Материалы_Подключаемый_ПрежнийКлючСвязи,
		Материалы_Подключаемый_ТекущийКлючСвязи) Тогда
		
		ПодключитьОбработчикОжидания("Подключаемый_Материалы106хППриОкончанииРедактирования", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_Материалы106хППриОкончанииРедактирования()
	
	// Настраиваем ТЧ "Затраты" для новой номенклатуры:
	ЗаменитьПоляСвязиВТЧЗатратыСервер(
		Материалы_Подключаемый_ПрежнийКлючСвязи,
		Материалы_Подключаемый_ТекущийКлючСвязи);
	
	УстановитьОтборЗатрат();
	
	РассчитатьИтоги = Истина;
	Если АвтоматическиРассчитыватьИтоги Тогда
		// Рассчитываем итоги для всей таблицы:
		РассчитатьИтогиСервер();
	КонецЕсли;
	
	// Обновляем поля, выводимые в подвал таблицы "Затраты":
	УстановитьЗначенияПолейИтого();
	
КонецПроцедуры

&НаКлиенте
Процедура Материалы106хППослеУдаления(Элемент)
	
	// Удаляем связанные строки ТЧ "Затраты":
	УдалитьЗатратыПоСтрокеМатериалыСервер(Материалы_УдаленнаяСтрока);
	
	// Подсказка о текущей выбранной номенклатуре:
	ВывестиТекущуюНоменклатуру();
	
КонецПроцедуры

// ----- Материалы . Счет -----
&НаКлиенте
Процедура Материалы106хПСчетПриИзменении(Элемент)
	
	ТекДанные = Элементы["Материалы106хП"].ТекущиеДанные;
	
	// Обновляем в текущей строке поля СчетНУ и прочие:
	СтруктураОбъект = КЭК0_ПолучитьПустуюСтруктуруОбъекта();
	СтруктураОбъект.Вставить("ОтражатьВНалоговомУчете");
	СтруктураОбъект.Вставить("КФО");
	СтруктураСтрокаТаблицы	= КЭК0_ПолучитьПустуюСтруктуруСтрокиТаблицы();
	СтруктураСтрокаТаблицы.Вставить("СчетНУ");
	ЗаполнитьЗначенияСвойств(СтруктураОбъект, Объект);
	ЗаполнитьЗначенияСвойств(СтруктураСтрокаТаблицы, ТекДанные);
	СчетПриИзмененииСервер_ОбновитьСтруктуруСтрокиТаблицы(СтруктураОбъект, СтруктураСтрокаТаблицы, МассивКФОдляНалоговогоУчета);
	ЗаполнитьЗначенияСвойств(ТекДанные, СтруктураСтрокаТаблицы);
	
	ОбновитьСчетНУ = СтруктураОбъект["ОтражатьВНалоговомУчете"]
		И НЕ (МассивКФОдляНалоговогоУчета.Найти(СтруктураОбъект["КФО"]) = Неопределено);
	Если ОбновитьСчетНУ Тогда
		СтруктураСтрокаТаблицы["СчетНУ"] = НалоговыйУчетКлиентСервер.СчетНУпоСчетуБУ(СтруктураСтрокаТаблицы["Счет"], Объект.Дата);
	КонецЕсли;
	
КонецПроцедуры

