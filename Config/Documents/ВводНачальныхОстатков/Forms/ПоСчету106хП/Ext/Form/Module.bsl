&НаКлиенте
Процедура Материалы106хПКЭКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИмяТаблЧасти = "Материалы106хП";
	ТекДанные = Элементы[ИмяТаблЧасти].ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекДанные.Счет) Тогда
		ИмяПоляДляОшибки = "Счет";
		Текст = НСтр("ru='Не заполнен счет.'");
		ИндексСтроки = Объект[ИмяТаблЧасти].Индекс(ТекДанные);
		
		ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст,
			Объект.Ссылка,
			ИмяТаблЧасти + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляОшибки,
			"Объект");

		Возврат;
	КонецЕсли;
	
	Если ТекДанные["ИспользоватьКЭК0"] Тогда
		//---
		// КЭК0
		//---
		ОграниченияКЭК = Новый Массив();
		ОграниченияКЭК.Добавить(КЭК0);
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент,
								СтандартнаяОбработка,
								,//КЭК,
								,//Организация,
								,//ИФО,
								,//КФО,
								,//Счет,
								,//Дата,
								,//"Дт",
								ОграниченияКЭК);
	Иначе
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент,
									СтандартнаяОбработка,
									ТекДанные["КЭК"],
									Объект["Организация"],
									Объект["ИФО"],
									Объект["КФО"],
	                                ТекДанные["Счет"],
									ПолучитьДату(),
									"Дт");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Затраты106хПСуммаПриИзменении(Элемент)
	
	ТекДанные = Элементы["Затраты106хП"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект["ОтражатьВНалоговомУчете"]
		И НЕ (МассивКФОдляНалоговогоУчета.Найти(Объект["КФО"]) = Неопределено) Тогда
		НовоеЗначение = ТекДанные["Сумма"];
	Иначе
		НовоеЗначение = 0;
	КонецЕсли;
	
	ТекДанные["СуммаНУ"] = НовоеЗначение;
	
КонецПроцедуры

