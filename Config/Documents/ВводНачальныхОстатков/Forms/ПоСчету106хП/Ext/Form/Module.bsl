&НаКлиенте
Процедура Затраты106хППриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанныеМатериалы = Элементы.Материалы106хП.ТекущиеДанные;
	ТекДанныеЗатраты = Элементы.Затраты106хП.ТекущиеДанные;
	
	Если ТекДанныеМатериалы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		// Заполняем поля связи двух ТЧ:
		ЗаполнитьЗначенияСвойств(ТекДанныеЗатраты, ТекДанныеМатериалы);
	КонецЕсли;
	
	// Запоминаем значения полей строки в начале ее редактирования:
	Затраты_ТекущиеДанные_ПриНачалеРедактирования = Новый Структура("ВидЗатрат, Сумма, СуммаНУ");
	ЗаполнитьЗначенияСвойств(Затраты_ТекущиеДанные_ПриНачалеРедактирования, ТекДанныеЗатраты);
	
КонецПроцедуры

&НаКлиенте
Процедура Затраты106хППередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если ОтменаРедактирования И НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	Если ОтменаРедактирования И НЕ НоваяСтрока Тогда
		// Восстанавливаем начальное значение поля "ВидЗатрат":
		ТекДанные = Элементы["Затраты106хП"].ТекущиеДанные;
		ТекДанные["ВидЗатрат"] = Затраты_ТекущиеДанные_ПриНачалеРедактирования.ВидЗатрат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Затраты106хППриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НоваяСтрока И ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьИтоги = Истина;
	Если АвтоматическиРассчитыватьИтоги Тогда
		// Рассчитываем итоги только для строк с определенным ключом:
		ТекДанные = Элементы["Затраты106хП"].ТекущиеДанные;
		КлючСтроки = ПолучитьСтруктуруКлючаСвязи(Объект); //Новый Структура("Номенклатура, КПС, Счет");
		ЗаполнитьЗначенияСвойств(КлючСтроки, ТекДанные);
		
		РассчитатьИтогиСервер(КлючСтроки);
	КонецЕсли;
	
	// Обновляем поля, выводимые в подвал таблицы "Затраты":
	УстановитьЗначенияПолейИтого();
	
КонецПроцедуры

&НаКлиенте
Процедура Затраты106хППослеУдаления(Элемент)
	
	РассчитатьИтоги = Истина;
	Если АвтоматическиРассчитыватьИтоги Тогда
		// Рассчитываем итоги только для строк с определенным ключом:
		РассчитатьИтогиСервер(Затраты_УдаленнаяСтрока);
	КонецЕсли;
	
	// Обновляем поля, выводимые в подвал таблицы "Затраты":
	УстановитьЗначенияПолейИтого();
	
КонецПроцедуры

