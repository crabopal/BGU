&НаСервере
Процедура ЗаполнитьДанныеПрослеживаемостиНоменклатуры()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмеренияНоменклатуры,
	|	Номенклатура.ВесПоСертификатуТовара КАК КоэффициентПересчета,
	|	ЕСТЬNULL(Номенклатура.КодТНВЭД.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмеренияПрослеживаемости
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&Номенклатура)";
	Запрос.УстановитьПараметр("Номенклатура", Объект.СведенияПрослеживаемости.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура"));
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	РезультатЗапроса.Индексы.Добавить("Ссылка");
	
	Отбор = Новый Структура("Ссылка", Справочники.Номенклатура.ПустаяСсылка());
	Для Каждого Строка Из Объект.СведенияПрослеживаемости Цикл
		Отбор.Ссылка = Строка.Номенклатура;
		ДанныеНоменклатуры = РезультатЗапроса.НайтиСтроки(Отбор);
		Если ДанныеНоменклатуры.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(Строка, ДанныеНоменклатуры[0]);
			Строка.РазныеЕдиницыИзмерения = Строка.ЕдиницаИзмеренияНоменклатуры <> Строка.ЕдиницаИзмеренияПрослеживаемости;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеПрослеживаемостиНоменклатуры(Знач Номенклатура)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмеренияНоменклатуры,
	|	Номенклатура.ВесПоСертификатуТовара КАК КоэффициентПересчета,
	|	ЕСТЬNULL(Номенклатура.КодТНВЭД.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмеренияПрослеживаемости
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Номенклатура);
	
	Результат = Новый Структура("ЕдиницаИзмеренияНоменклатуры, КоэффициентПересчета, ЕдиницаИзмеренияПрослеживаемости",
		Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка(),
		0,
		Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьКоличествоПрослеживаемости(ТекущиеДанные)
	Если ТекущиеДанные.РазныеЕдиницыИзмерения Тогда
		ТекущиеДанные.КоличествоПрослеживаемости = ТекущиеДанные.Количество * ТекущиеДанные.КоэффициентПересчета;
	Иначе
		ТекущиеДанные.КоличествоПрослеживаемости = ТекущиеДанные.Количество;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПрослеживаемыеМЗНаСервере()
	
	ВведенныеПрослеживаемыеМЗ = Объект.СведенияПрослеживаемости.Выгрузить();
	ВведенныеПрослеживаемыеМЗ.Индексы.Добавить("Номенклатура");
	
	ПрослеживаемыеМЗ = Объект.Материалы.Выгрузить(, "Номенклатура, Количество");
	ПрослеживаемыеМЗ.Свернуть("Номенклатура", "Количество");
	УдаляемыеСтроки = ПрослеживаемыеМЗ.НайтиСтроки(Новый Структура("Номенклатура", Справочники.Номенклатура.ПустаяСсылка()));
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		ПрослеживаемыеМЗ.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
	Если ПрослеживаемыеМЗ.Количество() = 0 Тогда
		Возврат; 
	КонецЕсли;
	
	НоменклатураДокумента = ПрослеживаемыеМЗ.ВыгрузитьКолонку("Номенклатура"); // Массив из СправочникСсылка.Номенклатура
	ДанныеМЗ = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(НоменклатураДокумента, "ПрослеживаемыйТовар");
	
	УдаляемыеСтроки = Новый Массив;
	Для Каждого СтрокаМЗ Из ПрослеживаемыеМЗ Цикл
		Если ДанныеМЗ.Получить(СтрокаМЗ.Номенклатура) <> Истина Тогда
			УдаляемыеСтроки.Добавить(СтрокаМЗ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		ПрослеживаемыеМЗ.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
	Отбор = Новый Структура("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
	Для Каждого СтрокаМЗ Из ПрослеживаемыеМЗ Цикл
		
		СтрокаБезРНПТ = Неопределено;
		КоличествоНеОтражено = СтрокаМЗ.Количество;
		Отбор.Номенклатура = СтрокаМЗ.Номенклатура;
		ВведенныеСтроки = ВведенныеПрослеживаемыеМЗ.НайтиСтроки(Отбор);
		Для Каждого ВведеннаяСтрока Из ВведенныеСтроки Цикл
			Если Не ЗначениеЗаполнено(ВведеннаяСтрока.РНПТ) Тогда
				СтрокаБезРНПТ = ВведеннаяСтрока;
			КонецЕсли;
			КоличествоНеОтражено = КоличествоНеОтражено - ВведеннаяСтрока.Количество; 
		КонецЦикла;
		Если КоличествоНеОтражено <> 0 Тогда
			Если СтрокаБезРНПТ = Неопределено Тогда
				СтрокаБезРНПТ = ВведенныеПрослеживаемыеМЗ.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаБезРНПТ, Отбор);
			КонецЕсли;
			СтрокаБезРНПТ.Количество = СтрокаБезРНПТ.Количество + КоличествоНеОтражено;
		КонецЕсли;
		
	КонецЦикла;
	ВведенныеПрослеживаемыеМЗ.Сортировать("Номенклатура");
	
	Объект.СведенияПрослеживаемости.Загрузить(ВведенныеПрослеживаемыеМЗ);
	ЗаполнитьДанныеПрослеживаемостиНоменклатуры();
	Для Каждого Строка Из Объект.СведенияПрослеживаемости Цикл
		Если Строка.КоличествоПрослеживаемости = 0 Тогда
			ПересчитатьКоличествоПрослеживаемости(Строка);
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаДокументаПриИзменении_ИзменениеСоставаГруппСчетовНеТребуется(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	ДатаПриИзмененииСервер();
	
	ПрежняяВыбраннаяПозицияСпискаВыбора = ВыбраннаяПозицияСпискаВыбора;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаДокументаПриИзменении_ПодтвержденоИзменениеСоставаГруппСчетов(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		
		ЭтаФорма.Модифицированность = Истина;
		
		ВводНачальныхОстатковКлиентСервер.ОбновитьКэшДатаДокумента(ЭтаФорма);
		
		ДатаПриИзмененииСервер();
		
		ПрежняяВыбраннаяПозицияСпискаВыбора = ВыбраннаяПозицияСпискаВыбора;
		
	Иначе
		
		ВводНачальныхОстатковКлиентСервер.ВосстановитьИзКэшаДатаДокумента(ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьНеиспользуемыеКолонки(ТекущийОбъект)
	
	Если НЕ ЗначениеЗаполнено(ТекущийОбъект["Счет"]) Тогда
		Возврат;
	КонецЕсли;
	
	ИспользуемыеКолонки = Новый Массив();
	СвойстваСчета = ТабСвойстваСчетов[Число(ВыбраннаяПозицияСпискаВыбора)];
	СписокВС = СвойстваСчета.ВидыСубконто;
	Для Каждого Элем Из СписокВС Цикл
		ИспользуемыеКолонки.Добавить(СоответствиеСубконтоКолонка.Получить(Элем.Значение));
	КонецЦикла;
	
	ОчищающаяСтруктура = Новый Структура();
	
	КолонкиСоответствующиеСубконто = Новый Структура("
		|ОС,
		|ЦМО,
		|Номенклатура,
		|Контрагент,
		|ВидДенежныхДокументов,
		|ДенежныйДокумент");
		
	Для Каждого ЭлементКолонка Из КолонкиСоответствующиеСубконто Цикл
		ИмяКолонки = ЭлементКолонка.Ключ;
		
		КолонкаИспользуется = НЕ (ИспользуемыеКолонки.Найти(ИмяКолонки) = Неопределено);
		
		Если НЕ КолонкаИспользуется Тогда
			ОчищающаяСтруктура.Вставить(ИмяКолонки, Неопределено);
		КонецЕсли;
	КонецЦикла;
	
	ТЧМатериалы = ТекущийОбъект["Материалы"];
	
	Для Каждого СтрокаТЧ Из ТЧМатериалы Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ОчищающаяСтруктура);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ЗаголовокФормы = "Ввод начальных остатков материалов (а также счет 08) ";
	Если Объект.Ссылка.Пустая() Тогда
		ЗаголовокФормы = ЗаголовокФормы + "(создание)";
	Иначе
		ЗаголовокФормы = ЗаголовокФормы + Объект.Номер + " от " + Объект.Дата;
	КонецЕсли;
	ЭтаФорма.Заголовок = ЗаголовокФормы;
	
КонецПроцедуры
&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	// Инициализация:
	ФО_ИспользоватьУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	СоответствиеСубконтоКолонка = Новый ФиксированноеСоответствие(
		Документы.ВводНачальныхОстатков.ПолучитьСоответствиеСубконтоКолонка());
	Если Объект.Ссылка.Пустая() И НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
		// Для нового документа заполняем дату.
		// Блок вынесен отдельно для инициализации даты ДО заполнения списка допустимых счетов методом:
		Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
	КонецЕсли;
	
	ДатыИзмененияСоставаГруппСчетов = Документы.ИнвентаризацияМЗ.ПолучитьДатыИзмененияСоставаГруппСчетов();
	ВводНачальныхОстатковКлиентСервер.ОбновитьКэшДатаДокумента(ЭтаФорма);
	
	//-----------
	// Инициализация:
	ЗаполнитьСписокВыбораСчета();
	//-----------
	
	УстановитьЗаголовокФормы();
	
	//---
	// КЭК0
	//---
	УстановитьНовоеЗначениеКЭК = Ложь;
	
	Если Объект.Ссылка.Пустая() Тогда
		// Для нового документа заполняем по возможности пустые поля.
		
		ИнициализироватьСчет = Ложь;
		Если ЗначениеЗаполнено(Объект.Счет) Тогда
			// Устанавливаем только флаг "ОсобыеСчета10500".
			
			СчетГруппа = ОпределитьСчетГруппуПоСчету();
			Если ЗначениеЗаполнено(СчетГруппа) Тогда
				// Удалось определить группу, к которой относится счет объекта.
				
				// 1) сначала настраиваем флаг:
				ОсобыеСчета105 = Документы.ВводНачальныхОстатков.ПолучитьОсобыеСчета10500();
				Объект.ОсобыеСчета10500 = НЕ (ОсобыеСчета105.Найти(Объект.Счет) = Неопределено);
				// 2) теперь устанавливаем счет:
				Объект.Счет = СчетГруппа;
				
			Иначе
				ИнициализироватьСчет = Истина;
			КонецЕсли;
			
		Иначе
			ИнициализироватьСчет = Истина;
		КонецЕсли;
		
		Если ИнициализироватьСчет Тогда
			// Сбрасываем флаг:
			Объект.ОсобыеСчета10500 = Ложь;
			// Устанавливаем счет:
			Объект.Счет = ТабСвойстваСчетов[0].СчетГруппа;
		КонецЕсли;
		
		Попытка
			ЭтаФорма.ТиповаяОперация = Справочники.ТиповыеОперации.ВводНачальныхОстатков_Материалы;
		Исключение
		КонецПопытки;
		
		//---
		// КЭК0
		//---
		Если Не ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			УстановитьНовоеЗначениеКЭК = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// Обновляем доступность полей, зависящих от свойств счета:
	ОбновитьПризнакиУчетаСчетовВТаблице();
	МатериалыОбновитьТекстЗаголовковВсехСтрокТаблицы(ЭтотОбъект);
	
	//---
	// КЭК0
	//---
	КЭК0 = БухгалтерскийУчетПовтИсп.КЭК0();
	
	// Устанавливаем выбранную позицию в списке выбора "Счет":
	УстановитьВыбраннуюПозициюСпискаВыбора();
	
	// Ид текущей строки таблицы свойств счетов:
	ИдСтроки = ТабСвойстваСчетов[Число(ВыбраннаяПозицияСпискаВыбора)].ПолучитьИдентификатор();
	
	// Настраиваем видимость и состав колонок ТЧ:
	НастроитьФормуСервер_ПриИзмененииГруппыСчетов(ИдСтроки, УстановитьНовоеЗначениеКЭК);
	
	// Отключаем доступность элементов формы, если нет прав на редактирование документа:
	МассивИмен = "Счет";
	ОбщегоНазначенияБГУ.УстановитьНедоступныеЭлементыФормы(Элементы, Объект, МассивИмен);
	
	ЗаполнитьДанныеПрослеживаемостиНоменклатуры();
	
	УстановитьУсловноеОформление();

КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент()
	
	НовДоступность = ЗначениеЗаполнено(Объект["Организация"]) И ЗначениеЗаполнено(Объект["Счет"]);
	
	Элементы["Материалы"].ТолькоПросмотр = НЕ НовДоступность;
	
	СообщитьСтатусПоддержкиГруппыСчетов();
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьСтатусПоддержкиГруппыСчетов()
	
	Поиск = Новый Структура("Ключ", ВыбраннаяПозицияСпискаВыбора);
	
	МассивСтрок = ТабСвойстваСчетов.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() < 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если МассивСтрок[0]["Недействующий"] Тогда
		ТекстСообщения = НСтр("ru='Указанная группа счетов устарела или не действует на дату ввода остатков.
			|Не рекомендуется вводить остатки по таким счетам.'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			,
			,
			"ВыбраннаяПозицияСпискаВыбора");
			
	ИначеЕсли МассивСтрок[0]["НеПредусмотрен"] Тогда
		ТекстСообщения = НСтр("ru='Не предусмотрен ввод остатков материалов по указанной группе счетов'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			,
			,
			"ВыбраннаяПозицияСпискаВыбора");
	КонецЕсли;
	
КонецПроцедуры

