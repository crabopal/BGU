Функция ПолучитьВидДенежногоДокумента(ДенежныйДокумент)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДенежныйДокумент, "Владелец");
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСуммуНУ()
	
	ТекДанные = Элементы["Материалы"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект["ОтражатьВНалоговомУчете"]
		И НЕ (МассивКФОдляНалоговогоУчета.Найти(ТекДанные["КФО"]) = Неопределено) Тогда
		НовоеЗначение = ТекДанные["Сумма"];
	Иначе
		НовоеЗначение = 0;
	КонецЕсли;
	
	ТекДанные["СуммаНУ"] = НовоеЗначение;
	
КонецПроцедуры

