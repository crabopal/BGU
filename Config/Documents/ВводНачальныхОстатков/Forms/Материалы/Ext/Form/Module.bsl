Процедура НастроитьФормуСерверСогласноРежимуВводаОстатков()
	
	// Задаваемые цвета текста заголовка колонок таблицы.
	// При корректном отображении:
	ЦветТекстаЗаголовка_Корректно				= ЦветаСтиля.ЦветТекстаФормы;
	// При некорректном:
	ЦветТекстаЗаголовка_Некорректно				= ЦветаСтиля.НепринятаяВерсия;
	
	ИмяТаблицыФормы = "Материалы";
	
	СтрокаТаблицыСчетов = ТабСвойстваСчетов[Число(ВыбраннаяПозицияСпискаВыбора)];
	ГруппаСчетов_УчетПоКПС				= СтрокаТаблицыСчетов["УчетПоКПС"];
	ГруппаСчетов_УчетПоКЭК				= СтрокаТаблицыСчетов["УчетПоКЭК"];
	ГруппаСчетов_УчетПоПодразделениям	= СтрокаТаблицыСчетов["УчетПоПодразделениям"];
	ГруппаСчетов_Количественный			= СтрокаТаблицыСчетов["Количественный"];
	ГруппаСчетов_Забалансовый			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект["Счет"], "Забалансовый");
	ГруппаСчетов_ДопустимыеСчета		= Новый ФиксированныйМассив(СтрокаТаблицыСчетов["ДопустимыеСчета"].Выгрузить(,"Счет").ВыгрузитьКолонку("Счет"));
	
	// Все колонки, настраиваемые в зависимосит от используемых субконто:
	ВсеКолонкиГруппСчетов = Новый Массив();
	Для Каждого Элем Из СоответствиеСубконтоКолонка Цикл
		ВсеКолонкиГруппСчетов.Добавить(Элем.Значение);
	КонецЦикла;
	
	// Колонки, используемые текущей группой счетов:
	ГруппаСчетов_ЕстьСубконтоКонтрагенты = Ложь;
	ИспользуемыеКолонкиГруппыСчетов = Новый Массив();
	Для Каждого Элем Из СтрокаТаблицыСчетов["ВидыСубконто"] Цикл
		ИмяПоля = СоответствиеСубконтоКолонка.Получить(Элем.Значение);
		
		ИспользуемыеКолонкиГруппыСчетов.Добавить(ИмяПоля);
		
		// Для настройки видимости кнопки "Настройки справочников" (далее):
		Если ИмяПоля = "Контрагент" Тогда
			ГруппаСчетов_ЕстьСубконтоКонтрагенты = Истина;
		КонецЕсли;
		
	КонецЦикла;

	//
	// 1. Колонки, зависимые только от текущей группы счетов
	//	  (каждая из них используются во всех режимах ввода остатков)
	//
	Для Каждого ИмяПоля Из ВсеКолонкиГруппСчетов Цикл
		
		НовВидимость = НЕ (ИспользуемыеКолонкиГруппыСчетов.Найти(ИмяПоля) = Неопределено);
		
		ИмяЭлемента = ИмяТаблицыФормы + ИмяПоля;
		
		Элементы[ИмяЭлемента].Видимость = НовВидимость;
		
		// Для номенклатуры выводится дополнительная колонка "Ед.Изм":
		Если ВРег(ИмяПоля) = "НОМЕНКЛАТУРА" Тогда
			Элементы[ИмяТаблицыФормы + ИмяПоля + "ЕдИзм"].Видимость = НовВидимость;
		КонецЕсли;
		
	КонецЦикла;
	// Колонки, зависящие от свойств счета:
	Элементы["МатериалыПодразделение"].Видимость	= ФО_ИспользоватьУчетПоПодразделениям И ГруппаСчетов_УчетПоПодразделениям;
	Элементы["МатериалыКоличествоМест"].Видимость	= ГруппаСчетов_Количественный;
	Элементы["МатериалыКоличество"].Видимость		= ГруппаСчетов_Количественный;
	Элементы["МатериалыКоэффициент"].Видимость		= ГруппаСчетов_Количественный;
	
	//
	// 2. Колонки, зависимые только от режима ввода остатков
	//
	ШапкаДокумента = Документы.ВводНачальныхОстатков.РежимВводаОстатков_СтруктураШапкиДокумента();
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, Объект);
	РезультатПроверки = Неопределено;
	ТаблицаПолейРежимов = Документы.ВводНачальныхОстатков.РежимВводаОстатков_ИменаПолейВсехРежимов(
		ШапкаДокумента,
		,	// ТолькоНеиспользуемые
		РезультатПроверки);
	
	// Параметры ведения налогового учета:
	ОбновитьПараметрыВеденияНалоговогоУчетаСервер(РезультатПроверки);
	
	Для Каждого СтрокаТЗ Из ТаблицаПолейРежимов Цикл
		
		ИмяПоля			= СтрокаТЗ["Поле"];
		НовВидимость	= СтрокаТЗ["Видимость"];
		ИмяЭлемента		= СтрокаТЗ["Элемент"];
		
		ЦветКорректно = ЦветТекстаЗаголовка_Корректно;
		
		// Видимость колонок, зависящих от свойств счета:
		Если ВРег(ИмяПоля) = "КПС" Тогда
			НовВидимость = НовВидимость И ГруппаСчетов_УчетПоКПС;
			
		ИначеЕсли ВРег(ИмяПоля) = "КЭК" Тогда
			НовВидимость = НовВидимость И ГруппаСчетов_УчетПоКЭК;
			
		КонецЕсли;
		
		// Новый цвет заголовка колонки:
		НовЦветЗаголовка = ?(СтрокаТЗ["Видимость"] И СтрокаТЗ["Используется"],
			ЦветКорректно,	// корректно
			ЦветТекстаЗаголовка_Некорректно);	// не корректно
		
		// Задаем новую видимость колонки:
		Колонка = Элементы[ИмяЭлемента];
		Колонка.Видимость = НовВидимость;
		Колонка.ЦветТекстаЗаголовка = НовЦветЗаголовка;
		
	КонецЦикла;
	
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрОрганизацияФункциональныхОпцийФормы(ЭтотОбъект,
		Объект.Организация,
		ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(Объект.Дата));
	
	ПлательщикНалогаНаПрибыль = ПолучитьФункциональнуюОпциюФормы("ПлательщикНалогаНаПрибыль");
	ПрименяетсяУСНДоходыМинусРасходы = ПолучитьФункциональнуюОпциюФормы("ПрименяетсяУСНДоходыМинусРасходы");
	
	Если ПлательщикНалогаНаПрибыль Тогда
		МассивКФОдляНалоговогоУчета = Новый ФиксированныйМассив(НалоговыйУчетКлиентСервер.ПолучитьМассивКФОдляНалоговогоУчета());
	ИначеЕсли ПрименяетсяУСНДоходыМинусРасходы Тогда
		МассивКФОдляНалоговогоУчета = Новый ФиксированныйМассив(УчетУСНКлиентСервер.МассивКФОдляНалоговогоУчетаУСН());
	КонецЕсли;
	
	// Особые настройки при исключительно нал.режиме ввода остатков.
	ТолькоНалУчет = Объект["ОтражатьВНалоговомУчете"] И НЕ Объект["ОтражатьВБухгалтерскомУчете"];
	// Ограничение выбора КФО:
	ЭлементКФО = Элементы["МатериалыКФО"];
	Если ТолькоНалУчет Тогда
		ЭлементКФО.СписокВыбора.ЗагрузитьЗначения(Новый Массив(МассивКФОдляНалоговогоУчета));
		ЭлементКФО.РежимВыбораИзСписка = Истина;
	Иначе
		ЭлементКФО.РежимВыбораИзСписка = Ложь;
	КонецЕсли;
	
	// Налоговый учет по налогу на прибыль.
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "МатериалыЗаполнитьПоДаннымБУ", "Доступность",
			ТолькоНалУчет И НЕ ГруппаСчетов_Забалансовый И НЕ Объект["ОсобыеСчета10500"]);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "МатериалыГруппаСуммыНУ", "Видимость",
			Объект["ОтражатьВНалоговомУчете"] И ПлательщикНалогаНаПрибыль);
	
	// Налоговый учет при УСН.
	РеквизитыУСН = Новый Массив;
	РеквизитыУСН.Добавить("МатериалыСчетУСН");
	РеквизитыУСН.Добавить("МатериалыСчетРасчетов");
	РеквизитыУСН.Добавить("МатериалыОтражениеВУСН");
	РеквизитыУСН.Добавить("МатериалыКонтрагентРасчетов");
	РеквизитыУСН.Добавить("МатериалыДоговорРасчетов");
	РеквизитыУСН.Добавить("МатериалыСуммаНДС");
	РеквизитыУСН.Добавить("МатериалыВалюта");
	РеквизитыУСН.Добавить("МатериалыВалютнаяСумма");
	РеквизитыУСН.Добавить("МатериалыВалютнаяСуммаНДС");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		РеквизитыУСН, "Видимость", Объект["ОтражатьВНалоговомУчете"] И ПрименяетсяУСНДоходыМинусРасходы
			И НЕ Объект["ОсобыеСчета10500"]); // Только для 105.00, исключая розницу.
	
	// Автозаполнение полей при добавлении новой строки таблицы "Материалы":
	ИменаПризнаков = "УчетПоКПС, УчетПоКЭК, УчетПоПодразделениям, Количественный";
	ВремСтруктура = Новый Структура(ИменаПризнаков, Ложь, Ложь, Ложь, Ложь);
	Автоподстановка_Счет = ?(ГруппаСчетов_ДопустимыеСчета.Количество() = 1,
		ГруппаСчетов_ДопустимыеСчета[0],
		Неопределено);
	Если ЗначениеЗаполнено(Автоподстановка_Счет) Тогда
		ВремСтруктура = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Автоподстановка_Счет, ИменаПризнаков);
	КонецЕсли;
	ИспользоватьАвтоподстановку_КФО = (ЭлементКФО.СписокВыбора.Количество() = 1
		И ЭлементКФО.РежимВыбораИзСписка = Истина);
	Автоподстановка_КФО = ?(ИспользоватьАвтоподстановку_КФО,
		ЭлементКФО.СписокВыбора[0].Значение,
		Неопределено);
	ВремСтруктура.Вставить("Счет",			Автоподстановка_Счет);
	ВремСтруктура.Вставить("КФО",			Автоподстановка_КФО);
	ВремСтруктура.Вставить("Коэффициент",	1);
	АвтозаполнениеНовойСтроки = Новый ФиксированнаяСтруктура(ВремСтруктура);
	
КонецПроцедуры
&НаСервере
Процедура ОбновитьПараметрыВеденияНалоговогоУчетаСервер(РезультатПроверки)
	
	РежимВводаОстатковКорректный = НЕ ЗначениеЗаполнено(РезультатПроверки["ТекстСообщения"]);
	Если НЕ РежимВводаОстатковКорректный Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РезультатПроверки["ТекстСообщения"],
			Объект.Ссылка,
			РезультатПроверки["ИмяПоляДляВыводаСообщения"]);
	КонецЕсли;
	
	// Обновляем соответствующие реквизиты формы:
	НалУчет_УстановленКорректно = Объект["ОтражатьВНалоговомУчете"] И РежимВводаОстатковКорректный;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РежимВводаОстатков_СтруктураШапкиДокумента()
	
	Возврат Документы.ВводНачальныхОстатков.РежимВводаОстатков_СтруктураШапкиДокумента();
	
КонецФункции

// ----- Список группы счетов, таблица допустимых счетов -----

&НаСервере
Процедура ЗаполнитьСписокВыбораСчета()
	
	ВремТаблица = Документы.ВводНачальныхОстатков.ПолучитьТаблицуСчетов_Материалы(Объект, Элементы["Счет"].СписокВыбора);
	
	ТабСвойстваСчетов.Очистить();
	
	Для Каждого СтрокаТаблицы Из ВремТаблица Цикл
		НоваяСтрока = ТабСвойстваСчетов.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы,, "ДопустимыеСчета");
		
		НоваяСтрока.ДопустимыеСчета.Загрузить(СтрокаТаблицы.ДопустимыеСчета);
	КонецЦикла;
	
КонецПроцедуры
&НаСервере
Функция ОпределитьСчетГруппуПоСчету()
	
	Поиск = Новый Структура("Счет", Объект.Счет);
	
	Для Каждого СтрокаТЗ Из ТабСвойстваСчетов Цикл
		МассивСтрок = СтрокаТЗ.ДопустимыеСчета.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Возврат СтрокаТЗ.СчетГруппа;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции
&НаСервере
Процедура УстановитьВыбраннуюПозициюСпискаВыбора()
	
	Поиск = Новый Структура("СчетГруппа", Объект.Счет);
	СтрокиТЗ = ТабСвойстваСчетов.НайтиСтроки(Поиск);
	КолвоСтрок = СтрокиТЗ.Количество();
	Если КолвоСтрок = 1 Тогда
		// Счета, присутствующие в списке по 1 разу.
		ВыбраннаяПозицияСпискаВыбора = СтрокиТЗ[0].Ключ;
		
	ИначеЕсли КолвоСтрок > 1 Тогда
		// Счета, присутствующие в списке более 1 раза.
		Если Объект.ОсобыеСчета10500 Тогда
			ВыбраннаяПозицияСпискаВыбора = "1";
		Иначе
			ВыбраннаяПозицияСпискаВыбора = "0";
		КонецЕсли;
		
	Иначе
		ВыбраннаяПозицияСпискаВыбора = "0";
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура НастроитьФормуСервер_ПриИзмененииГруппыСчетов(ИдСтроки, ИзмененаГруппаСчетов=Ложь)
	
	НастроитьФормуСерверСогласноРежимуВводаОстатков();
	
	СвойстваСчета = ТабСвойстваСчетов.НайтиПоИдентификатору(ИдСтроки);
	
	Если ИзмененаГруппаСчетов Тогда
		ОчищающаяСтруктура = Новый Структура("
			|Счет,
			|КПС,
			|КЭК,
			|УчетПоКПС,
			|УчетПоКЭК,
			|УчетПоПодразделениям,
			|Количественный");
		
		Если ГруппаСчетов_ДопустимыеСчета.Количество() = 1 Тогда
			// Если к выбору доступен лишь единственный счет, проставляем его во всех строках табл.части
			ОчищающаяСтруктура.Вставить("Счет", ГруппаСчетов_ДопустимыеСчета[0]);
		КонецЕсли;
		
		ТЧМатериалы = Объект.Материалы;
		Для Каждого СтрокаТЧ Из ТЧМатериалы Цикл
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, ОчищающаяСтруктура);
		КонецЦикла;
		
		ОбновитьПризнакиУчетаСчетовВТаблице();
	КонецЕсли;
	
	// Устанавливаем параметр выбора поля "Счет":
	
	НовыйМассив = Новый Массив();
	
	НовыйПараметр = Новый ПараметрВыбора("НаДату", ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(Объект["Дата"]));
	НовыйМассив.Добавить(НовыйПараметр);
	
	Если ГруппаСчетов_ДопустимыеСчета.Количество() > 0 Тогда
		// Найден хотя бы один допустимый счет.
		НовыйПараметр = Новый ПараметрВыбора("ОграниченияСписокСчетов", ГруппаСчетов_ДопустимыеСчета);
		НовыйМассив.Добавить(НовыйПараметр);
	Иначе
		// Допустимые счета отсутствуют.
		НовыйПараметр = Новый ПараметрВыбора("ОграниченияСчета", СвойстваСчета.СчетГруппа);
		НовыйМассив.Добавить(НовыйПараметр);
		
		Если НЕ СвойстваСчета.НеПредусмотрен Тогда
			Текст = НСтр("ru='В группе счетов %1 отсутствуют счета, имеющие одновременно следующие субконто: %2. Возможны проблемы при проведении этого документа.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
				СвойстваСчета.СчетГруппа,
				СтрСоединить(СвойстваСчета.ВидыСубконто.ВыгрузитьЗначения(), ", "));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				,
				"ВыбраннаяПозицияСпискаВыбора");
		КонецЕсли;
	КонецЕсли;
	Элементы["МатериалыСчет"].ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер_ВоВсейТаблице(ИзмененаГруппаСчетов); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПризнакиУчетаСчетовВТаблице()
	
	Если Объект.ОтражатьВБухгалтерскомУчете Тогда
		// Если вводим остатки в БУ, то признаки учета заполняем по реквизиту Счет,
		// т.к. учет материальных запасов в НУ, не может вестись более детально, чем БУ.
		ТЗСчета = Объект.Материалы.Выгрузить(, "НомерСтроки, Счет");
		ИмяРеквизитаСчет = "Счет";
	ИначеЕсли ПолучитьФункциональнуюОпциюФормы("ПлательщикНалогаНаПрибыль") Тогда
		// Если вводим остатки только в НУ, признаки учета заполняем по соответствующему реквизиту СчетНУ.
		ТЗСчета = Объект.Материалы.Выгрузить(, "НомерСтроки, СчетНУ");
		ИмяРеквизитаСчет = "СчетНУ";
	ИначеЕсли ПолучитьФункциональнуюОпциюФормы("ПрименяетсяУСНДоходыМинусРасходы") Тогда
		// Если вводим остатки только в УСН, то признаки учета заполняем по реквизиту Счет,
		// т.к. в любом случае нужны реквизиты КПС и КЭК для формирования проводок по расчетам.
		ТЗСчета = Объект.Материалы.Выгрузить(, "НомерСтроки, Счет");
		ИмяРеквизитаСчет = "Счет";
	Иначе
		Возврат;
	КонецЕсли;
	
	ЗапросСвойства = Новый Запрос();
	ЗапросСвойства.УстановитьПараметр("ТЗСчета", ТЗСчета);
	ЗапросСвойства.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0].
	|//
	|ВЫБРАТЬ
	|	ТЗ.НомерСтроки	КАК НомерСтроки,
	|	ТЗ."+ИмяРеквизитаСчет+"			КАК Счет
	|ПОМЕСТИТЬ
	|	Счета
	|ИЗ
	|	&ТЗСчета	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1].
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Счет.УчетПоКПС				КАК УчетПоКПС,
	|	Счет.УчетПоКЭК				КАК УчетПоКЭК,
	|	Счет.УчетПоПодразделениям	КАК УчетПоПодразделениям,
	|	Счет.Количественный			КАК Количественный
	|ИЗ
	|	Счета
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";
	ТЗ = ЗапросСвойства.Выполнить().Выгрузить();
	
	МаксИндекс = Объект.Материалы.Количество() - 1;
	Для Инд = 0 По МаксИндекс Цикл
		ЗаполнитьЗначенияСвойств(Объект.Материалы[Инд], ТЗ[Инд]);
	КонецЦикла;
	
КонецПроцедуры

//---
// Обработчики событий элементов формы

&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение = Неопределено)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОрганизацияПередИзменениемКлиент_Ответ", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении,
		НСтр("ru='Изменение организации вызовет очистку
		|некоторых полей шапки и табличной части документа.
		|
		|Продолжить и сменить организацию?'"),
		РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Объект["Организация"] = ПараметрыОповещения["ВыбранноеЗначение"];
		ЭтаФорма.Модифицированность = Истина;
		ОрганизацияПриИзмененииКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПриИзмененииКлиент()
	
	ОрганизацияПриИзмененииСервер();
	
	НастроитьФормуКлиент();
	
КонецПроцедуры
&НаСервере
Процедура ОрганизацияПриИзмененииСервер()
	
	ОчиститьРеквизитыТабличнойЧастиНесоответствующиеОрганизации();
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер_ВоВсейТаблице(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры
&НаСервере
Процедура ОчиститьРеквизитыТабличнойЧастиНесоответствующиеОрганизации()
	
	// Очищаем некоторые поля в ТЧ "Материалы":
	ОчищающаяСтруктура = Новый Структура("
		|ОС,
		|ЦМО,
		|Подразделение");
	Для Каждого СтрокаТЧ Из Объект.Материалы Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ОчищающаяСтруктура);
	КонецЦикла;
	
	// Устанавливаем новую дату документа:
	Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
	
	// Обновляем значения параметров ведения налогового учета и настраиваем форму:
	НастроитьФормуСерверСогласноРежимуВводаОстатков();
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииСервер()
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер_ВоВсейТаблице(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаСервере
Процедура КФОПриИзмененииСервер(ТекущаяСтрока)
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер_ВТекущейСтроке(ТекущаяСтрока, Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииСервер()
	
	ЗаполнитьСписокВыбораСчета();
	
	УстановитьВыбраннуюПозициюСпискаВыбора();
	
	ИдСтроки = ТабСвойстваСчетов[Число(ВыбраннаяПозицияСпискаВыбора)].ПолучитьИдентификатор();
	
	НастроитьФормуСервер_ПриИзмененииГруппыСчетов(ИдСтроки, Истина);
	
	// Обновляем значения параметров ведения налогового учета и настраиваем форму:
	НастроитьФормуСерверСогласноРежимуВводаОстатков();
	
КонецПроцедуры

//---
// Заполнение табличных частей

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымБухУчетаКлиент()
	
	ТолькоНалУчет = Объект["ОтражатьВНалоговомУчете"] И НЕ Объект["ОтражатьВБухгалтерскомУчете"];
	
	НужноЗаполнить = ТолькоНалУчет И НЕ ГруппаСчетов_Забалансовый И НЕ Объект["ОсобыеСчета10500"];
	
	Если НЕ НужноЗаполнить Тогда
		ТекстСообщения = НСтр("ru='Заполнение остатков материалов по данным бух.учета производится при условии:
			|	- режим ввода остатков: только налоговый учет
			|	- выбрана балансовая группа счетов 105.00'");
			
		ПоказатьПредупреждение(Неопределено, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
		Возврат;
	КонецЕсли;
	
	Если Объект["Материалы"].Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru='Перед заполнением остатков материалов по данным бух.учета
			|будет очищена табличная часть ""Материалы""
			|
			|Продолжить и заполнить по данным бух.учета?'");
			
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьПоДаннымБухУчетаКлиент_Ответ", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьПоДаннымБухУчетаКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымБухУчетаКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоДаннымБухУчетаКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДаннымБухУчетаКлиент()
	
	ЗаполнитьПоДаннымБухУчетаСервер();
	
	// Если по данным учета не было добавлено ни одной строки, выведем сообщение:
	Если Объект["Материалы"].Количество() = 0 Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru='Остатки материалов по данным бух.учета отсутствуют'"), 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДаннымБухУчетаСервер()
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(
		Объект.Организация,
		ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(Объект.Дата));
	
	// Остатки материальных запасов будем получать в два этапа:
	// 1. Остатки в разрезе МОЛ только по количеству, т.к. стоимость в разрезе МОЛ не хранится.
	ЗапросОстатки = Новый Запрос();
	ЗапросОстатки.УстановитьПараметр("ДатаСреза",		Новый Граница(КонецДня(Объект["Дата"]), ВидГраницы.Включая));
	ЗапросОстатки.УстановитьПараметр("Организация",		Объект["Организация"]);
	ЗапросОстатки.УстановитьПараметр("ИФО",				Объект["ИФО"]);
	ЗапросОстатки.УстановитьПараметр("Счет105",			БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("105.00"));
	ЗапросОстатки.УстановитьПараметр("ОсобыеСчета105",	Документы.ВводНачальныхОстатков.ПолучитьОсобыеСчета10500());
	ЗапросОстатки.УстановитьПараметр("МассивКФО",		МассивКФОдляНалоговогоУчета);
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	ЗапросОстатки.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	
	ЗапросОстатки.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУОстатки.ИФО КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЕПСБУОстатки.Счет КАК СчетУчета,
	|	ЕПСБУОстатки.Субконто1 КАК Номенклатура,
	|	ЕПСБУОстатки.Субконто2 КАК ЦМО,
	|	ЕПСБУОстатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаСреза,
	|			Счет В (&Счет105)
	|				И НЕ Счет В (&ОсобыеСчета105),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И &УсловиеПоИФО
	|				И КФО В (&МассивКФО)) КАК ЕПСБУОстатки";
	
	ЗапросОстатки.Текст = СтрЗаменить(ЗапросОстатки.Текст, "&УсловиеПоИФО",
		?(ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"), "ИФО В (&ИФО)", "ИСТИНА") );
	
	ОстаткиКоличество = ЗапросОстатки.Выполнить().Выгрузить();
	
	// 2. Остатки со средней стоимостью получим типовой процедурой .
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Организация",                      Объект.Организация);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ПлательщикНалогаНаПрибыль",        УчетнаяПолитика.ПлательщикНалогаНаПрибыль);
	ОстаткиКоличествоИСтоимость = УправлениеМатериальнымиЗапасами.ОстаткиМатериальныхЗапасов(
		ЗапросОстатки.Параметры.ДатаСреза,
		ТаблицаДляРасчетаОстатковМатериальныхЗапасов(ОстаткиКоличество),
		Реквизиты);
	
	// Заполним табличную часть документа.
	Объект.Материалы.Очистить();
	Для Каждого СтрокаОстатков Из ОстаткиКоличествоИСтоимость Цикл
		
		НоваяСтрока = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОстатков,
			"КФО, КПС, Подразделение, Номенклатура, Количество, УчетПоПодразделениям, УчетПоКПС");
		НоваяСтрока.НоменклатураПредставление = Строка(НоваяСтрока.Номенклатура);
		НоваяСтрока.ЦМО = СтрокаОстатков.ДопИзмерение;
		
		НоваяСтрока.Счет = СтрокаОстатков.СчетУчета;
		
		НоваяСтрока.Количественный = Истина;
		НоваяСтрока.Коэффициент = 1;
		НоваяСтрока.КоличествоМест = НоваяСтрока.Количество;
		
		Если УчетнаяПолитика.ПлательщикНалогаНаПрибыль Тогда
			
			НоваяСтрока.СчетНУ = НалоговыйУчетКлиентСервер.СчетНУпоСчетуБУ(НоваяСтрока.Счет, Объект.Дата);
			
			МатериалыОбновитьТекстЗаголовковВСтрокеТаблицы(НоваяСтрока);
			
		ИначеЕсли УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
			
			// Значения по умолчанию.
			НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.КЭК0();
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("302.34");
			НоваяСтрока.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Принимаются;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Поскольку при расчете средней стоимости по каждой строке могут остаться "копейки" при округлении,
	// распределим всю стоимость по Номенклатуре по всем строкам в табличной части документа.
	ОстаткиКоличествоИСтоимость.Свернуть("СчетУчета, КФО, КПС, Подразделение, Номенклатура, СтоимостьВсего");
	ОстаткиКоличествоИСтоимость.Индексы.Добавить("СчетУчета, КФО, КПС, Подразделение, Номенклатура");
	Для Каждого СтрокаСтоимость Из ОстаткиКоличествоИСтоимость Цикл
		
		Отбор = Новый Структура("Счет, КФО, КПС, Подразделение, Номенклатура",
			СтрокаСтоимость.СчетУчета,
			СтрокаСтоимость.КФО,
			СтрокаСтоимость.КПС,
			СтрокаСтоимость.Подразделение,
			СтрокаСтоимость.Номенклатура);
		СтрокиТаблицы = Объект.Материалы.НайтиСтроки(Отбор);
		
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаСтоимость.СтоимостьВсего, СтрокиТаблицы, "Сумма", "Количество");
		
		Если УчетнаяПолитика.ПлательщикНалогаНаПрибыль Тогда
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаСтоимость.СтоимостьВсего, СтрокиТаблицы, "СуммаНУ", "Количество");
		КонецЕсли;
		
	КонецЦикла;
	
	Объект.Материалы.Сортировать("Счет, НоменклатураПредставление, Подразделение, ЦМО, КПС");
	
КонецПроцедуры
&НаСервере
Функция ТаблицаДляРасчетаОстатковМатериальныхЗапасов(ТаблицаОстатков)
	
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ТаблицаДокумента = Новый ТаблицаЗначений;
	// Общие разрезы учета.
	ТаблицаДокумента.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДокумента.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДокумента.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДокумента.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета материальных запасов.
	ТаблицаДокумента.Колонки.Добавить("СчетУчета",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаДокумента.Колонки.Добавить("ДопАналитикаВидСубконто", ОписаниеТиповВидСубконто);
	ТаблицаДокумента.Колонки.Добавить("ДопАналитика",            ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	ТаблицаДокумента.Колонки.Добавить("ДопИзмерениеВидСубконто", ОписаниеТиповВидСубконто);
	ТаблицаДокумента.Колонки.Добавить("ДопИзмерение",            ОписаниеТиповСубконто); // ЦМО, Контрагент, ВидЗатрат и пр.
	// Количество единиц номенклатуры.
	ТаблицаДокумента.Колонки.Добавить("Количество", ОписаниеТипаКоличества);
	
	Для Каждого СтрокаОстатков Из ТаблицаОстатков Цикл
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОстатков);
		
		НоваяСтрока.ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
		НоваяСтрока.ДопИзмерение = СтрокаОстатков.ЦМО;
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

