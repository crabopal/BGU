		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент,
								СтандартнаяОбработка,
								,//КЭК,
								,//Организация,
								,//ИФО,
								,//КФО,
								,//Счет,
								,//Дата,
								,//"Дт",
								ОграниченияКЭК);
	Иначе
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент,
									СтандартнаяОбработка,
									ТекДанные["КЭК"],
									Объект["Организация"],
									Объект["ИФО"],
									ТекДанные["КФО"],
	                                ТекДанные["Счет"],
									ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(Объект["Дата"]),
									"Дт");
	КонецЕсли;
