&НаКлиенте
Перем ТекстЗаголовкаСообщений;

// Прежнее выбранное значение списка "Счет":
&НаКлиенте
Перем ПрежняяВыбраннаяПозицияСпискаВыбора;

// Ид строки таблицы ТабСвойстваСчета, соответствующей текущей строке списка Счет.
&НаКлиенте
Перем ИдСтрокиСвойствСчета;

// Структура реквизитов, используемых при анализе режима ввода остатков.
&НаКлиенте
Перем ШапкаДокументаКлиент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	Если Параметры.Ключ.Пустая() Тогда
		ПодготовитьФормуНаСервере();
	КонецЕсли;
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Ввод начальных остатков материалов'");
	
	// Запоминаем текущее значение переменной:
	ПрежняяВыбраннаяПозицияСпискаВыбора = ВыбраннаяПозицияСпискаВыбора;
	
	НастроитьФормуКлиент();
	
	ВводНачальныхОстатковКлиент.ПриОткрытии(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОчиститьНеиспользуемыеКолонки(ТекущийОбъект);
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	УстановитьЗаголовокФормы();
	
	ОбновитьПризнакиУчетаСчетовВТаблице();
	МатериалыОбновитьТекстЗаголовковВсехСтрокТаблицы(ЭтотОбъект);
	ЗаполнитьДанныеПрослеживаемостиНоменклатуры();
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	// Оповещаем форму Помощника ввода начальных остатков:
	ИмяСобытия = "ЗаписанДокументВводНачальныхОстатков";
	Параметр = Объект["Организация"];
	Оповестить(ИмяСобытия, Параметр);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаВводаОстатковПриИзменении(Элемент)
	
	// Необходимый код следует размещать в следующих процедурах:
	//	- ДатаДокументаПриИзменении_ПодтвержденоИзменениеСоставаГруппСчетов
	//	- ДатаДокументаПриИзменении_ИзменениеСоставаГруппСчетовНеТребуется
	
	// Эти процедуры вызываются далее автоматически, после анализа данных и ответа пользователя.
	
	ВводНачальныхОстатковКлиент.ДатаДокументаПриИзменении_ПроверитьНеобходимостьИзмененияСоставаГруппСчетов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетПриИзменении(Элемент)
	
	ЭтаФорма.Модифицированность = Истина;
	
	// При очистке поля автоматически выбираем самый первый элемент списка:
	Если ПустаяСтрока(ВыбраннаяПозицияСпискаВыбора) Тогда
		ВыбраннаяПозицияСпискаВыбора = "0";
	КонецЕсли;
	
	Если ВыбраннаяПозицияСпискаВыбора = ПрежняяВыбраннаяПозицияСпискаВыбора Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Материалы.Количество() = 0 Тогда
		СчетПриИзмененииКлиент();
	Иначе
		// Уточним желание сменить счет
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("СчетПриИзменении_Ответ", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении,
			НСтр("ru='Изменение счета вызовет очистку полей
			|""Счет"", ""КПС"" и ""КЭК"" в табличной части документа.
			|
			|Продолжить и сменить счет?'"),
			РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура СчетПриИзменении_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		СчетПриИзмененииКлиент();
	Иначе
		// Восстанавливаем предыдущее значение
		ВыбраннаяПозицияСпискаВыбора = ПрежняяВыбраннаяПозицияСпискаВыбора;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура СчетПриИзмененииКлиент()
	
	// Запоминаем текущее значение переменной:
	ПрежняяВыбраннаяПозицияСпискаВыбора = ВыбраннаяПозицияСпискаВыбора;
	
	Поиск = Новый Структура("Ключ", ВыбраннаяПозицияСпискаВыбора);
	СтрокиТЗ				= ТабСвойстваСчетов.НайтиСтроки(Поиск);
	СвойстваСчета			= СтрокиТЗ[0];
	Объект.Счет				= СвойстваСчета.СчетГруппа;
	ИдСтрокиСвойствСчета	= СвойстваСчета.ПолучитьИдентификатор();
	
	// Обрабатываем особые счета 105.00:
	Если ВыбраннаяПозицияСпискаВыбора = "1" Тогда
		Объект.ОсобыеСчета10500 = Истина;
	Иначе
		Объект.ОсобыеСчета10500 = Ложь;
	КонецЕсли;
	
	Если Объект.Счет <> БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("105.00") Тогда
		Объект.ОтражатьВБухгалтерскомУчете = Истина;
		Объект.ОтражатьВНалоговомУчете = Ложь;
	КонецЕсли;
	
	НастроитьФормуСервер_ПриИзмененииГруппыСчетов(ИдСтрокиСвойствСчета, Истина); // ИзмененаГруппаСчетов
	
	НастроитьФормуКлиент();
	
КонецПроцедуры


&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимВводаОстатковНажатие(Элемент)
	
	Если НЕ ТипЗнч(ШапкаДокументаКлиент) = Тип("Структура") Тогда
		ШапкаДокументаКлиент = РежимВводаОстатков_СтруктураШапкиДокумента();
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ШапкаДокументаКлиент, Объект);
	
	ОписаниеОповещения_Закрытие = Новый ОписаниеОповещения("РежимВводаОстатков_ВыборСделан", ЭтотОбъект);
	Результат = ОткрытьФорму("Документ.ВводНачальныхОстатков.Форма.НастройкиРежима", ШапкаДокументаКлиент, ЭтаФорма,,,,ОписаниеОповещения_Закрытие, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РежимВводаОстатков_ВыборСделан(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		
		ДанныеИзменены = (НЕ Объект.ОтражатьВБухгалтерскомУчете = РезультатВыбора.ОтражатьВБухгалтерскомУчете)
			ИЛИ (НЕ Объект.ОтражатьВНалоговомУчете = РезультатВыбора.ОтражатьВНалоговомУчете);
		Если ДанныеИзменены Тогда
			ЗаполнитьЗначенияСвойств(Объект, РезультатВыбора);
			ЭтаФорма.Модифицированность = Истина;
			
			// Обновляем значения параметров ведения налогового учета и настраиваем форму:
			НастроитьФормуСерверСогласноРежимуВводаОстатков();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Материалы

&НаКлиенте
Процедура МатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы["Материалы"].ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, АвтозаполнениеНовойСтроки);
		
		МатериалыОбновитьТекстЗаголовковВСтрокеТаблицы(ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыКоличествоМестПриИзменении(Элемент)
	
	РассчитатьКоличество();
	
КонецПроцедуры
&НаКлиенте
Процедура МатериалыКоэффициентПриИзменении(Элемент)
	
	РассчитатьКоличество();
	
КонецПроцедуры

// ----- Материалы . Счет -----

&НаКлиенте
Процедура МатериалыСчетПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	
	МатериалыСчетПриИзмененииСервер(ТекущиеДанные.ПолучитьИдентификатор());
	
КонецПроцедуры
&НаСервере
Процедура МатериалыСчетПриИзмененииСервер(Знач ИдентификаторСтроки)
	
	ТекущаяСтрока = Объект.Материалы.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ПлательщикНалогаНаПрибыль = ПолучитьФункциональнуюОпциюФормы("ПлательщикНалогаНаПрибыль");
	ПрименяетсяУСНДоходыМинусРасходы = ПолучитьФункциональнуюОпциюФормы("ПрименяетсяУСНДоходыМинусРасходы");
	
	Если Объект["ОтражатьВНалоговомУчете"] И ПлательщикНалогаНаПрибыль
		И ЗначениеЗаполнено(ТекущаяСтрока.Счет) Тогда
		ТекущаяСтрока.СчетНУ = НалоговыйУчетКлиентСервер.СчетНУпоСчетуБУ(ТекущаяСтрока.Счет, Объект.Дата);
	КонецЕсли;
	
	Если НЕ Объект.ОтражатьВБухгалтерскомУчете И ПлательщикНалогаНаПрибыль Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекущаяСтрока.СчетНУ);
	Иначе
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекущаяСтрока.Счет);
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СвойстваСчета, "УчетПоКПС, УчетПоКЭК, УчетПоПодразделениям, Количественный");
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер_ВТекущейСтроке(ТекущаяСтрока, Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры
&НаКлиенте
Процедура МатериалыСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СвойстваГруппыСчетов = ТабСвойстваСчетов.Получить(Число(ВыбраннаяПозицияСпискаВыбора));
	
	Если СвойстваГруппыСчетов["УчетПоКПС"] Тогда
		ТекДанные = Элементы["Материалы"].ТекущиеДанные;
		
		НачальноеЗначениеВыбора = Новый Структура("Счет, КПС, КФО",
			ТекДанные["Счет"],
			ТекДанные["КПС"],
			ТекДанные["КФО"]);
			
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(
			Элемент,
			СтандартнаяОбработка,
			НачальноеЗначениеВыбора,
			Объект["Организация"],
			Объект["ИФО"],
			Новый Массив(ГруппаСчетов_ДопустимыеСчета),
			ТекДанные["КФО"],
			, // ОграниченияКПС
			ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(Объект["Дата"]));
	КонецЕсли;
	
КонецПроцедуры
