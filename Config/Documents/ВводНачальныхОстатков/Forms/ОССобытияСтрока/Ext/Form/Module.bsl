&НаКлиенте
Перем СледуетЗакрытьФорму;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Инициализация
	ПравоДоступаИзменение = ПравоДоступа("Изменение", Объект.Ссылка.Метаданные());
	ВидНФА = Перечисления.ВидыНФА.ОС;
	
	ЗаполнитьПереданнойИнформацией();
	
	НастроитьФормуПриСтарте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступностьСобытийОС();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если НЕ СледуетЗакрытьФорму = Истина Тогда
		Если Модифицированность Тогда
			Отказ = Истина;
			
			ТекстВопроса = НСтр("ru='Данные были изменены. Сохранить изменения?'");
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПередЗакрытием_Ответ", ЭтотОбъект);
			
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Отмена);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПередЗакрытием_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		СохранитьИЗакрыть();
		
	ИначеЕсли РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		СледуетЗакрытьФорму = Истина;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Очистить();
	
	// Реквизиты с обязательным заполнением
	ШапкаДокумента = Документы.ВводНачальныхОстатков.РежимВводаОстатков_СтруктураШапкиДокумента();
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, ЭтаФорма);
	Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете
		ИЛИ РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе
		Тогда
		Документы.ВводНачальныхОстатков.ЗаполнитьСписокПроверяемыхОбязательныхРеквизитов_ОСВОперУчете(
			ШапкаДокумента,
			ПроверяемыеРеквизиты,
			Неопределено,	// ПроверяемыеСубконто,
			Неопределено,	// ПроверяемыеПризнакиУчета,
			Неопределено,	// ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
			Неопределено,	// ПеренаправлениеВыводаСообщений_Реквизиты,
			Неопределено,	// ИсключаемыеРеквизиты,
			Истина);		// ЭтоПроверкаВФормеРедактированияСтроки
			
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НПА Тогда
		Документы.ВводНачальныхОстатков.ЗаполнитьСписокПроверяемыхОбязательныхРеквизитов_НПА(
			ШапкаДокумента,
			ПроверяемыеРеквизиты,
			Неопределено,	// ПроверяемыеСубконто,
			Неопределено,	// ПроверяемыеПризнакиУчета,
			Неопределено,	// ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
			Неопределено,	// ПеренаправлениеВыводаСообщений_Реквизиты,
			Неопределено,	// ИсключаемыеРеквизиты,
			Истина);		// ЭтоПроверкаВФормеРедактированияСтроки
		
	КонецЕсли;
	
	// Исключаем из проверки реквизиты, недоступные для редактирования на этой форме (только просмотр)
	Документы.ВводНачальныхОстатков.УдалитьПроверяемыйРеквизит("ИФО",	ПроверяемыеРеквизиты);
	Документы.ВводНачальныхОстатков.УдалитьПроверяемыйРеквизит("КФО",	ПроверяемыеРеквизиты);
	Документы.ВводНачальныхОстатков.УдалитьПроверяемыйРеквизит("КПС",	ПроверяемыеРеквизиты);
	Документы.ВводНачальныхОстатков.УдалитьПроверяемыйРеквизит("КЭК",	ПроверяемыеРеквизиты);
	Документы.ВводНачальныхОстатков.УдалитьПроверяемыйРеквизит("Счет",	ПроверяемыеРеквизиты);
	
	// Проверяем взаимосвязанные значения реквизитов
	Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете
		ИЛИ РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе
		Тогда
    	ПараметрыПроверкиПоСтроке = Документы.ВводНачальныхОстатков.ПолучитьПараметрыПроверкиПоСтроке_ОСВОперУчете(ЭтаФорма);
		ПараметрыПроверкиПоСтроке.Вставить("ПрименяемыеПределыСтоимостиОС", Документы.ВводНачальныхОстатков.ОпределитьПрименяемыеПределыСтоимостиОС(ЭтаФорма));
		СтруктураОшибок = Документы.ВводНачальныхОстатков.ПроверкаПоСтроке_ОСВОперУчете(ЭтаФорма, ПараметрыПроверкиПоСтроке);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НПА Тогда
		ПараметрыПроверкиПоСтроке = Документы.ВводНачальныхОстатков.ПолучитьПараметрыПроверкиПоСтроке_НПА(ЭтаФорма);
		СтруктураОшибок = Документы.ВводНачальныхОстатков.ПроверкаПоСтроке_НПА(ЭтаФорма, ПараметрыПроверкиПоСтроке);
		
	КонецЕсли;
	
	Если СтруктураОшибок.Количество() > 0 Тогда
		// Выявлены ошибки.
		Отказ = Истина;
		// Выводим сообщения
		Для Каждого Элем Из СтруктураОшибок Цикл
			ИмяПоляДляВыводаСообщений	= Элем.Ключ;
			ТекстСообщения				= Элем.Значение;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстСообщения,
				,
				ИмяПоляДляВыводаСообщений);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОСОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("Ключ", ОС);
	ОписаниеОповещения_Закрытие = Новый ОписаниеОповещения("ОСОткрытие_Закрытие", ЭтотОбъект);
	ОткрытьФорму("Справочник.ОсновныеСредства.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещения_Закрытие, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
&НаКлиенте
Процедура ОСОткрытие_Закрытие(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	КэшироватьСвойстваОСНаФорму();
	
КонецПроцедуры

// ----- Страница "Общие сведения" -----

&НаКлиенте
Процедура ПервоначальнаяСтоимостьПриИзменении(Элемент)
	
	Если Сумма = 0 Тогда
		Сумма = ПервоначальнаяСтоимость;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура СуммаПриИзменении(Элемент)
	
	ПервоначальнаяСтоимость = ?(Количество>0, Сумма/Количество, Сумма);
	
КонецПроцедуры
&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)
	
	ПервоначальнаяСтоимость		= ?(Количество>0, Сумма/Количество, 0);
	
КонецПроцедуры

// ----- Страница "События" -----

&НаКлиенте
Процедура СостояниеОСПриИзменении(Элемент)
	
	УстановитьДоступностьСобытийОС();
	
	Если НЕ ЗначениеЗаполнено(СостояниеОС) Тогда
		ДатаВводаВЭксплуатацию		= Дата(1,1,1);
		ДатаПринятияКУчету			= Дата(1,1,1);
		НазваниеДокументаВводаВЭксплуатацию	= "";
		НазваниеДокументаПринятияКУчету		= "";
		НомерДокументаВводаВЭксплуатацию	= "";
		НомерДокументаПринятияКУчету		= "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПринятияКУчетуПриИзменении(Элемент)
	
	Если ВводВЭксплуатациюОдновременноСПринятиемКУчету Тогда
		ДатаВводаВЭксплуатацию = ДатаПринятияКУчету;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура НазваниеДокументаПринятияКУчетуПриИзменении(Элемент)
	
	Если ВводВЭксплуатациюОдновременноСПринятиемКУчету Тогда
		НазваниеДокументаВводаВЭксплуатацию = НазваниеДокументаПринятияКУчету;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура НомерДокументаПринятияКУчетуПриИзменении(Элемент)

	Если ВводВЭксплуатациюОдновременноСПринятиемКУчету Тогда
		НомерДокументаВводаВЭксплуатацию = НомерДокументаПринятияКУчету;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОдновременноСПринятиемКУчетуПриИзменении(Элемент)
	
	ОбработатьИзменениеОдновременноСПринятиемКУчетуПриИзменении();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	СохранитьИЗакрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СохранитьИЗакрыть()
	
	Если НастройкаФормы_ИгнорироватьОшибкиЗаполнения Тогда
		ФормаЗаполненаКорректно = Истина;
	Иначе	
		ФормаЗаполненаКорректно = ЭтаФорма.ПроверитьЗаполнение();
	КонецЕсли;
	
	Если ФормаЗаполненаКорректно Тогда
		СледуетЗакрытьФорму	= Истина;
		Модифицированность	= Ложь;
		
		ЗавершитьРедактированиеСтрокиКлиент();
		
		ПараметрЗакрытия = Новый Структура;
		ПараметрЗакрытия.Вставить("АдресДанных",	Параметры["АдресДанных"]);
		Закрыть(ПараметрЗакрытия);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПереданнойИнформацией()
	
	ВходящиеДанные = ПолучитьИзВременногоХранилища(Параметры.АдресДанных);
	
	НомерСтроки = ВходящиеДанные.ИндексТекСтроки + 1;
	ЭтаФорма.Заголовок = ВходящиеДанные.ТекстЗаголовкаСообщений + " - строка " + Строка(НомерСтроки);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ВходящиеДанные.ТекДанные_Основная);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ВходящиеДанные.ТекДанные_Амортизация);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ВходящиеДанные.ТекДанные_Документ);
	
	// Запоминаем переданные поля обоих ТЧ (для возврата значений из этой формы)
	Параметры.ТекущиеДанные = Новый Структура();
	Для Каждого Элем Из ВходящиеДанные.ТекДанные_Основная Цикл
		Параметры.ТекущиеДанные.Вставить(Элем.Ключ);
	КонецЦикла;
	Для Каждого Элем Из ВходящиеДанные.ТекДанные_Амортизация Цикл
		Параметры.ТекущиеДанные.Вставить(Элем.Ключ);
	КонецЦикла;
	
	КэшироватьСвойстваОСНаФорму();
	
	Счет_УчетПоПодразделениям = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "УчетПоПодразделениям");
	
	// Имя поля для активизации при открытии этой формы
	НастройкаФормы_ИмяАктивногоПоля = ВходящиеДанные.ИмяАктивногоПоля;
	
КонецПроцедуры

&НаСервере
Процедура КэшироватьСвойстваОСНаФорму()
	
	МодифицируемыеРеквизитыОС = Документы.ВводНачальныхОстатков.ПолучитьЗначенияМодифицируемыхРеквизитовОС(РазделУчета, ОС);
	
	Если ЗначениеЗаполнено(МодифицируемыеРеквизитыОС) Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, МодифицируемыеРеквизитыОС);
	КонецЕсли;
	
КонецПроцедуры

	
&НаСервере
Процедура НастроитьФормуПриСтарте()
	
	// Сброс размеров и положения формы
	ОчиститьНастройкиФормы();
	
	// Отключаем неиспользуемые элементы
	Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НПА Тогда
		Элементы["Количество"].Видимость	= Ложь;
		Элементы["ГрупповойУчет"].Видимость	= Ложь;
	КонецЕсли;
	
	// Отключаем доступность элементов формы, если нет прав на редактирование документа
	ОбщегоНазначенияБГУ.УстановитьНедоступныеЭлементыФормы(Элементы, Объект,
		"КомандаОК,КПССчетаОС,СчетОС,КЭКСчетаОС,ГрупповойУчет");
	
	УстановитьТекущийЭлементФормы();
	
КонецПроцедуры
		
&НаСервере
Процедура УстановитьТекущийЭлементФормы()
	
	Если ЗначениеЗаполнено(НастройкаФормы_ИмяАктивногоПоля) Тогда
		
		Попытка
			АктивныйЭлемент = Элементы[НастройкаФормы_ИмяАктивногоПоля];
			
			// Активизируем все страницы по иерархии, на которых расположен этот активный элемент
			ТекущийРодитель = АктивныйЭлемент.Родитель;
			Пока НЕ ТипЗнч(ТекущийРодитель) = Тип("ФормаКлиентскогоПриложения") Цикл
				
				Если ТипЗнч(ТекущийРодитель) = Тип("ГруппаФормы") Тогда
					Если ТекущийРодитель.Вид = ВидГруппыФормы.Страница Тогда
						ТекущийРодитель.Родитель.ТекущаяСтраница = ТекущийРодитель;
						ТекущийРодитель = ТекущийРодитель.Родитель;
					КонецЕсли;
				КонецЕсли;
				
				ТекущийРодитель = ТекущийРодитель.Родитель;
				
			КонецЦикла;
			
			ЭтаФорма.ТекущийЭлемент = АктивныйЭлемент;
			
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьНастройкиФормы()

	ИмяПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Если ПравоДоступа("СохранениеДанныхПользователя", Метаданные) Тогда
		ХранилищеСистемныхНастроек.Удалить("Документ.ВводНачальныхОстатков.Форма.ОСВОперУчетеСтрока", "", ИмяПользователя);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьТекущиеДанныеВХранилище()
	
	ВозвращаемыеДанные = Новый Структура();
	
	ЗаполнитьЗначенияСвойств(Параметры.ТекущиеДанные, ЭтаФорма);
	ВозвращаемыеДанные.Вставить("ТекущиеДанные", Параметры.ТекущиеДанные);
	
	ИменаРеквизитов		= Документы.ВводНачальныхОстатков.ПолучитьИменаМодифицируемыхРеквизитовОС(РазделУчета);
	РеквизитыОСНаФорме	= Новый Структура(ИменаРеквизитов);
	ЗаполнитьЗначенияСвойств(РеквизитыОСНаФорме, ЭтаФорма);
	ВозвращаемыеДанные.Вставить("РеквизитыОСНаФорме", РеквизитыОСНаФорме);
	
	ПоместитьВоВременноеХранилище(ВозвращаемыеДанные, Параметры["АдресДанных"]);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРедактированиеСтрокиКлиент()
	
	ПоместитьТекущиеДанныеВХранилище();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьСобытийОС()
	
	// Принятие к учету
	НовДоступность = ПравоДоступаИзменение
		И	(СостояниеОС = ПредопределенноеЗначение("Перечисление.СостоянияОС.ПринятоКУчету")
			ИЛИ (СостояниеОС = ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию")));
	Элементы["ГруппаПринятиеКУчету"].Доступность = НовДоступность;
		
	// Ввод в эксплуатацию
	НовДоступность = ПравоДоступаИзменение
		И (СостояниеОС = ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию"));
	Элементы["ГруппаВводВЭксплуатацию"].Доступность				= НовДоступность;
	Элементы["ГруппаДокументВводаВЭксплуатацию"].Доступность	= НовДоступность И НЕ ВводВЭксплуатациюОдновременноСПринятиемКУчету;
	Если ПравоДоступаИзменение
		И НЕ НовДоступность И ВводВЭксплуатациюОдновременноСПринятиемКУчету = Истина Тогда
		ВводВЭксплуатациюОдновременноСПринятиемКУчету = Ложь;
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеОдновременноСПринятиемКУчетуПриИзменении()
	
	Если ВводВЭксплуатациюОдновременноСПринятиемКУчету Тогда
		
		ДатаВводаВЭксплуатацию = ДатаПринятияКУчету;
		НазваниеДокументаВводаВЭксплуатацию = НазваниеДокументаПринятияКУчету;
		НомерДокументаВводаВЭксплуатацию = НомерДокументаПринятияКУчету;
		
		Элементы.ГруппаДокументВводаВЭксплуатацию.Доступность = Ложь;
		
	Иначе
		
		Элементы.ГруппаДокументВводаВЭксплуатацию.Доступность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
