&НаСервере
Процедура ИнициализацияФормы()
	
	Если ИнициализацияВыполнена Тогда
		Возврат;
	КонецЕсли;
	
	// Проверим права пользователя:
	ПравоДоступаИзменение = ПравоДоступа("Изменение", Объект.Ссылка.Метаданные());
	
	НастроитьФормуСервер_ПоРазделуУчета();
	
	Документы.ВводНачальныхОстатков.НастроитьФормуДокументаДляУстаревшегоРазделаУчета(ЭтаФорма);
	
	УстановитьУсловноеОформление();
	
	ИнициализацияВыполнена = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	Если Объект.РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны Тогда
		ЗаголовокФормы = "(устарел) Ввод начальных остатков по имуществу казны (ОС, НМА, НПА) ";	
	Иначе
		ЗаголовокФормы = "Ввод начальных остатков по имуществу казны (МЗ) ";
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ЗаголовокФормы = ЗаголовокФормы + "(создание)";
	Иначе
		ЗаголовокФормы = ЗаголовокФормы + Объект.Номер + " от " + Объект.Дата;
	КонецЕсли;
	ЭтаФорма.Заголовок = ЗаголовокФормы;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьЗаголовокФормы();
	
	Если НЕ ИнициализацияВыполнена Тогда
		ИнициализацияФормы();
		
		//---
		// Полная табличная часть ОС
		//---
		Если ИспользуетсяСтраницаОС Тогда
			ПолнаяТабличнаяЧастьОС_ОбновитьСервер();
		КонецЕсли;
	КонецЕсли;
	
	//---
	// КЭК0
	//---
	УстановитьНовоеЗначениеКЭК = Ложь;
	
	// Заполняем по возможности пустые поля формы:
	Если Объект.Ссылка.Пустая() Тогда
		
		Объект.КФО          = Перечисления.КВД.Бюджет;
		//Объект.ВидНФА     = Перечисления.ВидыНФА.Казна;
		Объект.ВидИмущества = УправлениеОсновнымиСредствамиПовтИсп.ВидИмуществаПоСчетуУчета(Объект.Счет);
		
		Попытка
			ЭтаФорма.ТиповаяОперация = Справочники.ТиповыеОперации.ВводНачальныхОстатков_ИмуществоКазны;
		Исключение
		КонецПопытки;
		
		Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
		КонецЕсли;
		
		//---
		// КЭК0
		//---
		УстановитьНовоеЗначениеКЭК = Истина;
		
	КонецЕсли;
	
	//---
	// КЭК0
	//---
	КЭК0 = БухгалтерскийУчетПовтИсп.КЭК0();
	ПроконтролироватьЗначениеКЭКСервер(УстановитьНовоеЗначениеКЭК);
	
	// Значения заполнения (при добавлении новой строки) ТЧ "ОС Основная":
	ЗначенияЗаполнения_ОСОсновная = Новый ФиксированнаяСтруктура(
		Документы.ВводНачальныхОстатков.ПолучитьЗначенияЗаполнения_ОС(Объект.Счет));
	
	НастроитьФормуСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент()
	
	РазрешитьРаботуСТаблицей = РазрешитьРаботуСФормой
		И ЗначениеЗаполнено(Объект.Организация)
		И ЗначениеЗаполнено(Объект.Счет);
	
	Элементы["ГруппаШапка"].ТолькоПросмотр			= НЕ РазрешитьРаботуСШапкой;
	
	Элементы["ОС_Основная"].ТолькоПросмотр			= НЕ РазрешитьРаботуСТаблицей;
	Элементы["Материалы"].ТолькоПросмотр			= НЕ РазрешитьРаботуСТаблицей;
	Элементы["РедактированиеВДиалоге"].Доступность	= РазрешитьРаботуСТаблицей;
	Элементы["ОткрытьВДиалогеКМ"].Доступность		= РазрешитьРаботуСТаблицей;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер()
	
	// Задаваемые цвета текста заголовка колонок таблицы.
	// При корректном отображении:
	ЦветТекстаЗаголовка_Корректно				= ЦветаСтиля.ЦветТекстаФормы;
	// При некорректном:
	ЦветТекстаЗаголовка_Некорректно				= ЦветаСтиля.НепринятаяВерсия;
	
	// Колонки, зависимые от режима ввода остатков и учетной политики:
	ШапкаДокумента = Документы.ВводНачальныхОстатков.РежимВводаОстатков_СтруктураШапкиДокумента();
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, Объект);
	РезультатПроверки = Неопределено;
	ТаблицаПолейРежимов = Документы.ВводНачальныхОстатков.РежимВводаОстатков_ИменаПолейВсехРежимов(
		ШапкаДокумента,
		,	// ТолькоНеиспользуемые
		РезультатПроверки);
	
	// Параметры ведения налогового учета и учетной политики:
	ОбновитьПараметрыВеденияНалоговогоУчетаСервер(РезультатПроверки);
	
	НастроитьТекстПодсказкиОбОтключенныхКолонках();
	
	Для Каждого СтрокаТЗ Из ТаблицаПолейРежимов Цикл
		
		ПомечатьВыводимыеПринудительно = СтрокаТЗ["ПомечатьВыводимыеПринудительно"];
		ИмяПоля			= СтрокаТЗ["Поле"];
		НовВидимость	= СтрокаТЗ["Видимость"];
		ИмяТаблЧасти	= ВРег(СтрокаТЗ["ТаблЧасть"]);
		Если ИмяТаблЧасти = "ОС_ОСНОВНАЯ" ИЛИ ИмяТаблЧасти = "ОС_АМОРТИЗАЦИЯ" Тогда
			ИмяЭлемента	= "ОС_Основная" + ИмяПоля;
		Иначе	
			ИмяЭлемента	= СтрокаТЗ["Элемент"];
		КонецЕсли;
		
		ЦветКорр	= ЦветТекстаЗаголовка_Корректно;
		
		// Новый цвет заголовка колонки:
		НовЦветЗаголовка = ?(СтрокаТЗ["Видимость"] И СтрокаТЗ["Используется"],
			ЦветКорр,	// корректно
			ЦветТекстаЗаголовка_Некорректно);	// не корректно
		
		// Задаем новую видимость колонки:
		Колонка = Элементы[ИмяЭлемента];
		Колонка.Видимость = НовВидимость;
		Если ПомечатьВыводимыеПринудительно Тогда
			Колонка.ЦветТекстаЗаголовка = НовЦветЗаголовка;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ПоРазделуУчета()
	
	Если Объект["РазделУчета"] = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны Тогда
		
		ИспользуетсяСтраницаОС	= Истина;
		ВидимаяСтраница			= "СтраницаОС";
		НедоступнаяСтраница		= "СтраницаМЗ";
		
		КодыСчетов = "108.51, 108.52, 108.53, 108.54, 108.55";
		
		// Запомним имена используемых колонок таблиц ОС
		ПустаяСтрокаТаблицыОСОсновная		= Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ИменаИспользуемыхКолонокОСОсновная(Объект["РазделУчета"]);
		ПустаяСтрокаТаблицыОСАмортизация	= Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ИменаИспользуемыхКолонокОСАмортизация(Объект["РазделУчета"]);
		ПолнаяТабличнаяЧастьОС_ИменаРедактируемыхВТаблицеКолонокОСАмортизация = Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ИменаРедактируемыхВТаблицеКолонокОСАмортизация(Объект["РазделУчета"]);
		
	ИначеЕсли Объект["РазделУчета"] = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазныМЗ Тогда
		
		ИспользуетсяСтраницаОС	= Ложь;
		ВидимаяСтраница			= "СтраницаМЗ";
		НедоступнаяСтраница		= "СтраницаОС";
		
		КодыСчетов = "108.56";
		
	Иначе
		Возврат;
	КонецЕсли;
	
	Элементы["ДекорацияКраткоеОписание"].Видимость = Ложь;
	
	ЭтаФорма.Элементы["Страницы"].ТекущаяСтраница = ЭтаФорма.Элементы[ВидимаяСтраница];
	Элементы[ВидимаяСтраница].Видимость		= Истина;
	Элементы[НедоступнаяСтраница].Видимость	= Ложь;
	
	МассивСчетов = БухгалтерскиеОперации.ПолучитьМассивСчетов(КодыСчетов);
	СписокДопустимыхСчетов.ЗагрузитьЗначения(МассивСчетов);
	НовыйПараметр = Новый ПараметрВыбора("ОграниченияСписокСчетов", СписокДопустимыхСчетов);
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	Элементы["Счет"].ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
			
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Документы.ВводНачальныхОстатков.УстановитьУсловноеОформление_КолонкиОСПринятиеКУчету(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПараметрыВеденияНалоговогоУчетаСервер(РезультатПроверки)
	
	РежимВводаОстатковКорректный = НЕ ЗначениеЗаполнено(РезультатПроверки["ТекстСообщения"]);
	Если НЕ РежимВводаОстатковКорректный Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РезультатПроверки["ТекстСообщения"],
			Объект.Ссылка,
			РезультатПроверки["ИмяПоляДляВыводаСообщения"]);
	КонецЕсли;
	
	Если РезультатПроверки["КодОшибки"] = "УчетИмуществаКазныНеВедется" Тогда
		РазрешитьРаботуСШапкой = Ложь;
	Иначе
		РазрешитьРаботуСШапкой = ПравоДоступаИзменение;
	КонецЕсли;
	РазрешитьРаботуСФормой = ПравоДоступаИзменение И РежимВводаОстатковКорректный;
	
	// Обновляем кэш формы:
	СвойстваСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект["Счет"], "УчетПоКПС, УчетПоКЭК, УчетПоПодразделениям");
	ЭтаФорма["Счет_УчетПоКПС"]				= ?(ЗначениеЗаполнено(Объект["Счет"]), СвойстваСчета.УчетПоКПС, Ложь);
	ЭтаФорма["Счет_УчетПоКЭК"]				= ?(ЗначениеЗаполнено(Объект["Счет"]), СвойстваСчета.УчетПоКЭК, Ложь);
	ЭтаФорма["Счет_УчетПоПодразделениям"]	= ?(ЗначениеЗаполнено(Объект["Счет"]), СвойстваСчета.УчетПоПодразделениям, Ложь);
	ЭтаФорма["Кэш_ВестиПоАналитике"]		= РезультатПроверки["Кэш"]["ВестиПоАналитике"];
	ЭтаФорма["Кэш_НачислятьАмортизацию"]	= РезультатПроверки["Кэш"]["НачислятьАмортизацию"];
	ЭтаФорма["Кэш_ЭтоСчетМЗ"]				= РезультатПроверки["Кэш"]["ЭтоСчетМЗ"];
	
КонецПроцедуры

&НаСервере
Процедура НастроитьТекстПодсказкиОбОтключенныхКолонках()
	
	Тексты = Новый Массив();
	
	Если НЕ Кэш_ВестиПоАналитике Тогда
		Тексты.Добавить(НСтр("ru='Аналитический и инвентарный учет не ведется'"));
	КонецЕсли;
	
	Если НЕ Кэш_НачислятьАмортизацию Тогда
		Тексты.Добавить(НСтр("ru='Амортизация имущества казны не начисляется'"));
	КонецЕсли;
	
	ЭтаФорма.Элементы["ОС_ОсновнаяСумма"].Подсказка = СтрСоединить(Тексты, "," + Символы.ПС);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДату()
	
	Возврат КонецГода(Объект.Дата) + 1;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьКоличество()
	
	ТекДанные = Элементы.Материалы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.Количество = ТекДанные.КоличествоМест * ТекДанные.Коэффициент;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначенияЗаполнения_ОС(Счет)
	Возврат Документы.ВводНачальныхОстатков.ПолучитьЗначенияЗаполнения_ОС(Счет);
КонецФункции
&НаКлиенте
Процедура ЗаполнитьПоляНовойСтроки_ОС_Основная()
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ЗначенияЗаполнения_ОСОсновная);
	
КонецПроцедуры

//---
// Полная табличная часть ОС
//---

&НаСервере
Процедура ПолнаяТабличнаяЧастьОС_ОбновитьСервер()
	
	Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ОбновитьСервер(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПолнаяТабличнаяЧастьОС_ЗаполнитьСтрокуДаннымиИзОСАмортизацияСервер(ИдТекСтроки)
	
	Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ЗаполнитьСтрокуДаннымиИзОСАмортизацияСервер(ЭтаФорма, ИдТекСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолнаяТабличнаяЧастьОС_ПриИзмененииПоляТаблицыОСАмортизацияКлиент(Элемент)
	
	ТекДанные	= Элементы["ОС_Основная"].ТекущиеДанные;
	ОС			= ТекДанные["ОС"];
	
	Если ЗначениеЗаполнено(ОС) Тогда
		ИдТекСтроки = Элементы["ОС_Основная"].ТекущаяСтрока;
		
		ПолнаяТабличнаяЧастьОС_ПриИзмененииПоляТаблицыОСАмортизацияСервер(ИдТекСтроки, Элемент.Имя);
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолнаяТабличнаяЧастьОС_ПриИзмененииПоляТаблицыОСАмортизацияСервер(ИдТекСтроки, ИмяЭлемента)
	
	Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ПриИзмененииПоляТаблицыОСАмортизацияСервер(ЭтаФорма, ИдТекСтроки, ИмяЭлемента);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонок(НоваяДоступность)
	
	Для Каждого Элем Из ПустаяСтрокаТаблицыОСОсновная Цикл
		ИмяКолонки = Элем.Ключ;
		ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонки(ИмяКолонки, НоваяДоступность, Ложь);
	КонецЦикла;
	
	Для Каждого Элем Из ПустаяСтрокаТаблицыОСАмортизация Цикл
		ИмяКолонки = Элем.Ключ;
		ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонки(ИмяКолонки, НоваяДоступность, Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонки(ИмяКолонки, НоваяДоступность, ЭтоКолонкаОСАмортизация)
	
	Если ВРег(ИмяКолонки) = "ОС" Тогда
		Возврат;
	КонецЕсли;
	
	КолонкаРедактируетсяВТаблице = ?(ЭтоКолонкаОСАмортизация,
		ПолнаяТабличнаяЧастьОС_ИменаРедактируемыхВТаблицеКолонокОСАмортизация.Свойство(ИмяКолонки),
		Истина);
	
	Если КолонкаРедактируетсяВТаблице Тогда
		ИмяЭлемента	= "ОС_Основная" + ИмяКолонки;
		
		Попытка
			Элементы[ИмяЭлемента].ТолькоПросмотр = НЕ НоваяДоступность;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

//---
// Редактирование в диалоге
//---

&НаКлиенте
Процедура РедактированиеВДиалоге_НастроитьФормуПоПометке(ПометкаНовая = Ложь)
	
	Элементы["РедактированиеВДиалоге"].Пометка = ПометкаНовая;
	
	Элементы["ОС_Основная"].РежимВыделенияСтроки = ?(ПометкаНовая,
		РежимВыделенияСтрокиТаблицы.Строка,
		РежимВыделенияСтрокиТаблицы.Ячейка);
		
	//---
	// Полная табличная часть ОС
	//---
	Если ИспользуетсяСтраницаОС Тогда
		ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонок(НЕ ПометкаНовая);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеВДиалоге_ПроверитьИОткрытьДиалог(СтандартнаяОбработка = Неопределено, ПроверятьУстановленностьРежимаДиалога = Ложь)
	
	Перем ОткрытьФормуДиалога;
	
	Если НЕ РазрешитьРаботуСТаблицей Тогда
		// Выходим
		Возврат;
	КонецЕсли;
	
	ЭлементТаблицыОС = Элементы["ОС_Основная"];
	
	Если ПроверятьУстановленностьРежимаДиалога = Истина Тогда
		// Определяем, установлен ли режим редактирования в диалоге
		Если ЭлементТаблицыОС.ТекущийЭлемент.ТолькоПросмотр Тогда
			РежимДиалогаУстановлен = Истина;
		Иначе
			ИмяКолонки = Сред(ЭлементТаблицыОС.ТекущийЭлемент.Имя, 12);
			Если ВРег(ИмяКолонки) = "ОС" Тогда
				// Редактируем все равно в строке.
				РежимДиалогаУстановлен = Ложь;
			Иначе
				РежимДиалогаУстановлен = Элементы["РедактированиеВДиалоге"].Пометка;
			КонецЕсли;
		КонецЕсли;
	Иначе
		РежимДиалогаУстановлен = Истина;
	КонецЕсли;
	
	Если РежимДиалогаУстановлен = Истина Тогда
		ТекДанные = ЭлементТаблицыОС.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			// Выходим
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные["ОС"]) Тогда
			ОткрытьФормуДиалога = Истина;
		Иначе
			
			ТекстСообщения	= НСтр("ru='Укажите основное средство'");
			ИндексСтроки	= ТекДанные.НомерСтроки - 1;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				Объект.Ссылка,
				"ОС_Основная[" + ИндексСтрокиТекст + "].ОС",
				"Объект");
		КонецЕсли;
	КонецЕсли;
	
	Если ОткрытьФормуДиалога = Истина Тогда
		СтандартнаяОбработка = Ложь;
		РедактированиеВДиалоге_ОткрытьДиалог(ИмяКолонки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеВДиалоге_ОткрытьДиалог(ИмяПоля = Неопределено)
	
	ИдСтроки		= Элементы["ОС_Основная"].ТекущаяСтрока;
	ТекДанные		= Элементы["ОС_Основная"].ТекущиеДанные;
	ИндексСтроки	= ТекДанные.НомерСтроки - 1;
	
	АдресДанных			= ПоместитьТекущиеДанныеВХранилище(ИдСтроки, ИндексСтроки, ИмяПоля, ТекстЗаголовкаСообщений);
	ПараметрыФормы		= Новый Структура("АдресДанных", АдресДанных);
	ПараметрыОповещения	= Новый Структура();
	ПараметрыОповещения.Вставить("АдресДанных",	АдресДанных);
	ПараметрыОповещения.Вставить("ТекДанные",	ТекДанные);
	
	ОписаниеОповещения_Закрытие = Новый ОписаниеОповещения("ЗавершитьРедактированиеТекСтрокиОСКлиент", ЭтотОбъект, ПараметрыОповещения);
	ОткрытьФорму("Документ.ВводНачальныхОстатков.Форма.ИмуществоКазныСтрока", ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещения_Закрытие, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьТекущиеДанныеВХранилище(ИдТекСтроки, ИндексТекСтроки, ИмяАктивногоПоля, ТекстЗаголовкаСообщений = Неопределено)
	
	// Текущие данные в обеих табличных частях:
	ТекДанные_ОСОсновная = Объект.ОС_Основная.НайтиПоИдентификатору(ИдТекСтроки);
	
	ОССсылка = ТекДанные_ОСОсновная.ОС;
	Отбор = Новый Структура("ОС", ОССсылка);
	Строки = Объект.ОС_Амортизация.НайтиСтроки(Отбор);
	Если Строки.Количество() > 0 Тогда
		ТекДанные_ОСАмортизация = Строки[0];
	Иначе
		ТекДанные_ОСАмортизация = Объект.ОС_Амортизация.Добавить();
		ТекДанные_ОСАмортизация.ОС = ОССсылка;
	КонецЕсли;
	ИдТекСтроки_ОСОсновная		= ИдТекСтроки;
	ИдТекСтроки_ОСАмортизация	= ТекДанные_ОСАмортизация.ПолучитьИдентификатор();
	
	// Структуры с текущими данными, передаваемые в открываемую форму.
	
	// Данные строки ОС Основная:
	ТекДанные_Основная = Новый Структура("НомерСтроки");
	Для Каждого Элем Из ПустаяСтрокаТаблицыОСОсновная Цикл
		ТекДанные_Основная.Вставить(Элем.Ключ);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(ТекДанные_Основная, ТекДанные_ОСОсновная);
	
	// Данные строки ОС Амортизация:
	ТекДанные_Амортизация = Новый Структура();
	Для Каждого Элем Из ПустаяСтрокаТаблицыОСАмортизация Цикл
		ТекДанные_Амортизация.Вставить(Элем.Ключ);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(ТекДанные_Амортизация, ТекДанные_ОСАмортизация);
	
	// Данные документа:
	ТекДанные_Документ = Новый Структура("
		|Дата,
		|Организация,
		|РазделУчета,
		|КФО,
		|ИФО,
		|Счет,
		|КПС,
		|КЭК,
		|ВидНФА,
		|ВидИмущества,
		|ОтражатьВБухгалтерскомУчете,
		|ОтражатьВНалоговомУчете");
	ЗаполнитьЗначенияСвойств(ТекДанные_Документ, Объект);
	
	ПередаваемыеДанные = Новый Структура();
	ПередаваемыеДанные.Вставить("ТекДанные_Основная",		ТекДанные_Основная);
	ПередаваемыеДанные.Вставить("ТекДанные_Амортизация",	ТекДанные_Амортизация);
	ПередаваемыеДанные.Вставить("ТекДанные_Документ",		ТекДанные_Документ);
	ПередаваемыеДанные.Вставить("ИндексТекСтроки",			ИндексТекСтроки);
	ПередаваемыеДанные.Вставить("ИмяАктивногоПоля",			ИмяАктивногоПоля);
	ПередаваемыеДанные.Вставить("ТекстЗаголовкаСообщений",	ТекстЗаголовкаСообщений);
	
	Возврат ПоместитьВоВременноеХранилище(ПередаваемыеДанные, ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

// Вызывается при закрытии формы редактирования строки ОС для применения сделанных изменений.
&НаКлиенте
Процедура ЗавершитьРедактированиеТекСтрокиОСКлиент(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		
		ЗавершитьРедактированиеТекСтрокиОССервер(ПараметрыОповещения["АдресДанных"]);
		
		ТекДанные = ПараметрыОповещения["ТекДанные"];
		
		ОповеститьОбИзменении(ТекДанные.ОС);
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗавершитьРедактированиеТекСтрокиОССервер(АдресДанных)
	
	ВходящиеДанные = ПолучитьИзВременногоХранилища(АдресДанных);
	
	ИндексТекущейСтроки = ВходящиеДанные.ТекущиеДанные.НомерСтроки - 1;
	
	// Обновляем в ТЧ "ОС Основная" поля текущей строки:
	ТекДанные = Объект["ОС_Основная"].НайтиПоИдентификатору(ИдТекСтроки_ОСОсновная);
	Если НЕ ТекДанные = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ТекДанные, ВходящиеДанные.ТекущиеДанные);
	КонецЕсли;
	
	// Обновляем в ТЧ "ОС Амортизация" поля текущей строки:
	ТекДанные = Объект["ОС_Амортизация"].НайтиПоИдентификатору(ИдТекСтроки_ОСАмортизация);
	Если НЕ ТекДанные = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ТекДанные, ВходящиеДанные.ТекущиеДанные);
	КонецЕсли;
	
	// Обновляем модифицируемые свойства ОС
	ОССсылка = ТекДанные["ОС"];
	ТекущиеСвойстваОС = Документы.ВводНачальныхОстатков.ПолучитьЗначенияМодифицируемыхРеквизитовОС(
		Объект["РазделУчета"],
		ОССсылка);
	Документы.ВводНачальныхОстатков.ОбновитьИзмененныеРеквизитыОС(
		ОССсылка,
		ТекущиеСвойстваОС,
		ВходящиеДанные["РеквизитыОСНаФорме"]);
		
	//---
	// Полная табличная часть ОС
	//---
	Если ИспользуетсяСтраницаОС Тогда
		ПолнаяТабличнаяЧастьОС_ОбновитьСервер();
	КонецЕсли;
	
	Элементы["ОС_Основная"].ТекущаяСтрока = Объект["ОС_Основная"][ИндексТекущейСтроки].ПолучитьИдентификатор();
	
КонецФункции

//---
// Обработчики событий элементов формы

&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение = Неопределено)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОрганизацияПередИзменениемКлиент_Ответ", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении,
		НСтр("ru='Изменение организации вызовет полную очистку
		|табличной части документа и некоторых полей шапки.
		|
		|Продолжить и сменить организацию?'"),
		РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Объект["Организация"] = ПараметрыОповещения["ВыбранноеЗначение"];
		ЭтаФорма.Модифицированность = Истина;
		ОрганизацияПриИзмененииКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПриИзмененииКлиент()
	
	ОрганизацияПриИзмененииСервер();
	
	НастроитьФормуКлиент();
	
КонецПроцедуры
&НаСервере
Процедура ОрганизацияПриИзмененииСервер()
	
	ОчиститьРеквизитыТабличнойЧастиНесоответствующиеОрганизации();
	
	// Обновляем значения параметров ведения налогового учета и настраиваем форму:
	НастроитьФормуСервер();
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры	

&НаСервере
Процедура ОчиститьРеквизитыТабличнойЧастиНесоответствующиеОрганизации()
	
	// Очищаем целиком табличные части:
	Объект["ОС_Основная"].Очистить();
	Объект["ОС_Амортизация"].Очистить();
	Объект["Материалы"].Очистить();
	
	// Устанавливаем новую дату документа:
	Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииСервер()
	
	// Применим новую текущую учетную политику:
	НастроитьФормуСервер();
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииСервер()
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаСервере
Процедура КФОПриИзмененииСервер()
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры
	
&НаСервере
Процедура СчетПриИзмененииСервер()
	
	// Обновляем значения заполнения:
	ЗначенияЗаполнения_ОСОсновная = Новый ФиксированнаяСтруктура(ПолучитьЗначенияЗаполнения_ОС(Объект.Счет));
	
	НастроитьФормуСервер();
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

