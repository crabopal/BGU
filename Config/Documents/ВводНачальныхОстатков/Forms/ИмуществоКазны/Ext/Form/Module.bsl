&НаКлиенте
Перем ТекстЗаголовкаСообщений;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Ввод начальных остатков ИК'");
	
	РедактированиеВДиалоге_НастроитьФормуПоПометке(Истина); // Пометка
	
	НастроитьФормуКлиент();
	
	ВводНачальныхОстатковКлиент.ПриОткрытии(ЭтаФорма);
	
	ВводНачальныхОстатковКлиент.СпроситьИОткрытьФормуВводаНачальныхОстатковОС(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	Если НЕ ИнициализацияВыполнена Тогда
		ИнициализацияФормы();
	КонецЕсли;
	
	//---
	// Полная табличная часть ОС
	//---
	Если ИспользуетсяСтраницаОС Тогда
		ПолнаяТабличнаяЧастьОС_ОбновитьСервер();
	КонецЕсли;
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	УстановитьЗаголовокФормы();
	
	//---
	// Полная табличная часть ОС
	//---
	Если ИспользуетсяСтраницаОС Тогда
		ПолнаяТабличнаяЧастьОС_ОбновитьСервер();
	КонецЕсли;
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	// Оповещаем форму Помощника ввода начальных остатков:
	ИмяСобытия = "ЗаписанДокументВводНачальныхОстатков";
	Параметр = Объект["Организация"];
	Оповестить(ИмяСобытия, Параметр);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаВводаОстатковПриИзменении(Элемент)
	
	ДатаПриИзмененииСервер();
	
	НастроитьФормуКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	БухгалтерскийУчетКлиент.ОбработатьВыборКФО(Объект.Организация,
											   Объект.ИФО,
											   Объект.КФО,
											   ПолучитьДату(),
											   Объект.КПС);
											   
	КФОПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетПриИзменении(Элемент)
	
	СчетПриИзмененииСервер();
	
	НастроитьФормуКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура СчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОграниченияКПС = Новый Массив;
	ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.гКБК"));
	ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			Объект.Счет, 
																			Объект.КПС, 
																			Объект.КФО), 
															Объект.Организация,
															Объект.ИФО,
															СписокДопустимыхСчетов,
															Объект.КФО,
															ОграниченияКПС,
															ПолучитьДату());
КонецПроцедуры
&НаКлиенте
Процедура СчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
															Объект.КПС,
															Объект.КФО,
															Объект.КЭК);
	
	Объект.ВидНФА       = УправлениеОсновнымиСредствамиВызовСервераПовтИсп.ВидНФАпоСчетуУчета(ВыбранноеЗначение);
	Объект.ВидИмущества = УправлениеОсновнымиСредствамиВызовСервераПовтИсп.ВидИмуществаПоСчетуУчета(ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура КПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОграниченияКПС = Новый Массив;
	ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.гКБК"));
	ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													Объект.КПС, 
													Объект.Организация,
													Объект.ИФО,
													Объект.КФО,
													ОграниченияКПС,
													ПолучитьДату()
													);
													
КонецПроцедуры

&НаКлиенте
Процедура КЭКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ИспользоватьКЭК0 Тогда
		//---
		// КЭК0
		//---
		ОграниченияКЭК = Новый Массив();
		ОграниченияКЭК.Добавить(КЭК0);
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент,
								СтандартнаяОбработка,
								,//КЭК,
								,//Организация,
								,//ИФО,
								,//КФО,
								,//Счет,
								,//Дата,
								,//"Дт",
								ОграниченияКЭК);
	Иначе
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент,
									СтандартнаяОбработка,
									Объект.КЭК,
									Объект.Организация,
									Объект.ИФО,
									Объект.КФО,
	                                Объект.Счет,
									ПолучитьДату(),
									"Дт");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

//---
// Обработчики, аналогичные обработчикам в форме редактирования строки.

&НаКлиенте
Процедура ОС_ОсновнаяКоличествоПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	
	ТекДанные["ПервоначальнаяСтоимость"] = ?(ТекДанные["Количество"]>0,
		ТекДанные["Сумма"]/ТекДанные["Количество"],
		0);
	
КонецПроцедуры
&НаКлиенте
Процедура ОС_ОсновнаяСуммаПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	
	ТекДанные["ПервоначальнаяСтоимость"] = ?(ТекДанные["Количество"]>0,
		ТекДанные["Сумма"]/ТекДанные["Количество"],
		0);
	
КонецПроцедуры
&НаКлиенте
Процедура ОС_ОсновнаяПервоначальнаяСтоимостьПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	
	Если ТекДанные["Сумма"] = 0 Тогда
		ТекДанные["Сумма"] = ТекДанные["ПервоначальнаяСтоимость"];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяСостояниеОСПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	СостояниеОС = ТекДанные["СостояниеОС"];
	
	Если НЕ СостояниеОС = ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию") Тогда
		ТекДанные["ВводВЭксплуатациюОдновременноСПринятиемКУчету"] = Ложь;
		
		Если НЕ ЗначениеЗаполнено(СостояниеОС) Тогда
			ТекДанные["ДатаВводаВЭксплуатацию"]					= Дата(1,1,1);
			ТекДанные["НазваниеДокументаВводаВЭксплуатацию"]	= "";
			ТекДанные["НомерДокументаВводаВЭксплуатацию"]		= "";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОС_ОсновнаяСостояниеОСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеВыбора = Новый СписокЗначений();
	ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияОС.ВведеноВЭксплуатацию"));
	ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.СостоянияОС.ПринятоКУчету"));
	
КонецПроцедуры
&НаКлиенте
Процедура ОС_ОсновнаяВводВЭксплуатациюОдновременноСПринятиемКУчетуПриИзменении(Элемент)
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	
	Если ТекДанные["ВводВЭксплуатациюОдновременноСПринятиемКУчету"] Тогда
		ТекДанные["ДатаВводаВЭксплуатацию"]					= ТекДанные["ДатаПринятияКУчету"];
		ТекДанные["НазваниеДокументаВводаВЭксплуатацию"]	= ТекДанные["НазваниеДокументаПринятияКУчету"];
		ТекДанные["НомерДокументаВводаВЭксплуатацию"]		= ТекДанные["НомерДокументаПринятияКУчету"];
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОСОсновная

&НаКлиенте
Процедура ОС_ОсновнаяВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	РедактированиеВДиалоге_ПроверитьИОткрытьДиалог(СтандартнаяОбработка, Истина);
	
КонецПроцедуры

// При добавлении новой строки и отключенном ВеденииУчетаПоАналитике, устанавливаем Количество=1.
&НаКлиенте
Процедура ОС_ОсновнаяПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		ЗаполнитьПоляНовойСтроки_ОС_Основная();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяОСПриИзменении(Элемент)
	
	//---
	// Полная табличная часть ОС
	//---
	Если ИспользуетсяСтраницаОС Тогда
		ПолнаяТабличнаяЧастьОС_ЗаполнитьСтрокуДаннымиИзОСАмортизацияСервер(Элементы["ОС_Основная"].ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяДатаПринятияКУчетуПриИзменении(Элемент)
	
	//---
	// Полная табличная часть ОС
	//---
	Если ИспользуетсяСтраницаОС Тогда
		ПолнаяТабличнаяЧастьОС_ПриИзмененииПоляТаблицыОСАмортизацияКлиент(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОС_ОсновнаяНазваниеДокументаПринятияКУчетуПриИзменении(Элемент)
	
	//---
	// Полная табличная часть ОС
	//---
