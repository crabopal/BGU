&НаКлиенте
Процедура Заполнить(Команда)
	
	ТолькоНалУчет = Объект["ОтражатьВНалоговомУчете"] И НЕ Объект["ОтражатьВБухгалтерскомУчете"];
	КФОСоответствует = НЕ (МассивКФОдляНалоговогоУчета.Найти(Объект["КФО"]) = Неопределено);
	
	Если ТолькоНалУчет И КФОСоответствует Тогда
		
		Если НеобходимыеРеквизитыЗаполнены() Тогда
			ТекстСообщения = НСтр("ru='Перед заполнением остатков ОС по данным бух.учета
				|табличная часть %1 будет очищена.	
				|
				|Продолжить и очистить?'");
			Если ПодтвердитьИзменениеТабличнойЧасти(
				"ОС_Основная",						// имя
				НСтр("ru='""Основные средства""'"),	// представление
				ТекстСообщения)	Тогда
				
				ЗаполнитьПоДаннымБухУчетаКлиент();
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		Текст = НСтр("ru='Заполнение остатков ОС по данным бух.учета производится при условии:
		|	- режим ввода остатков: только налоговый учет
		|	- КФО=%1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
			СтрСоединить(МассивКФОдляНалоговогоУчета, ", "));
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

