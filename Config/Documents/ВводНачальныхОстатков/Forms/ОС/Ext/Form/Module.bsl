&НаКлиенте
Перем ТекстЗаголовкаСообщений;

&НаКлиенте
Перем ШапкаДокументаКлиент;

//---
// Механизм отбора строк табличной части (v2)
//---
&НаКлиенте
Перем ОтборСтрок_ПрименяемыйОтбор;
&НаКлиенте
Перем ОтборСтрок_ВыбранаНоваяСтрока;
&НаКлиенте
Перем ОтборСтрок_ТекДанные; // активизированная строка а таблице "Основные средства"

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриСозданииНаСервере(Отказ, СтандартнаяОбработка, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Ввод начальных остатков ОС'");
	
	РедактированиеВДиалоге_НастроитьФормуПоПометке(Истина); // Пометка
	
	НастроитьФормуКлиент();
	
	ВводНачальныхОстатковКлиент.ПриОткрытии(ЭтаФорма);
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ОтборСтрок_ИнициализироватьНаКлиенте();
	
	ВводНачальныхОстатковКлиент.СпроситьИОткрытьФормуВводаНачальныхОстатковОС(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	Если НЕ ИнициализацияВыполнена Тогда
		ИнициализацияФормы();
	КонецЕсли;
	
	//---
	// Полная табличная часть ОС
	//---
	ПолнаяТабличнаяЧастьОС_ОбновитьСервер();
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект, Элементы.БухгалтерскаяОперация, Элементы.ДополнительныеТабличныеЧасти);
	// Конец Типовые операции и дополнительные табличные части
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПередЗаписью(Отказ, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ОтборСтрок_ПередЗаписьюНаСервере(ТекущийОбъект);
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	УстановитьЗаголовокФормы();
	
	//---
	// Полная табличная часть ОС
	//---
	ПолнаяТабличнаяЧастьОС_ОбновитьСервер();
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ОтборСтрок_ПослеЗаписиНаСервере();
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииСервер.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец Типовые операции и дополнительные табличные части
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// Типовые операции и дополнительные табличные части
	БухгалтерскиеОперацииКлиент.ПослеЗаписи(ПараметрыЗаписи, ЭтаФорма);
	// Конец Типовые операции и дополнительные табличные части
	
	// Оповещаем форму Помощника ввода начальных остатков:
	ИмяСобытия = "ЗаписанДокументВводНачальныхОстатков";
	Параметр = Объект["Организация"];
	Оповестить(ИмяСобытия, Параметр);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаВводаОстатковПриИзменении(Элемент)
	
	ДатаПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	ИФОПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	БухгалтерскийУчетКлиент.ОбработатьВыборКФО(Объект.Организация,
											   Объект.ИФО,
											   Объект.КФО,
											   ПолучитьДату(),
											   Объект.КПС);
	
	КФОПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетОСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Объект.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС") Тогда
		СчетаОСДляОтбора = ОС_Счет101;
	ИначеЕсли Объект.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА") Тогда
		СчетаОСДляОтбора = ОС_Счет102;
	Иначе
		СчетаОСДляОтбора = Новый Массив;
		СчетаОСДляОтбора.Добавить(ОС_Счет101);
		СчетаОСДляОтбора.Добавить(ОС_Счет102);
	КонецЕсли;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			Объект.Счет, 
																			Объект.КПС, 
																			Объект.КФО), 
															Объект.Организация,
															Объект.ИФО,
															СчетаОСДляОтбора,
															Объект.КФО,
															,
															ПолучитьДату());
															
КонецПроцедуры
&НаКлиенте
Процедура СчетОСПриИзменении(Элемент)
	
	СчетПриИзмененииСервер();
	
	НастроитьФормуКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура СчетОСОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
															Объект.КПС,
															Объект.КФО,
															Объект.КЭК);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидНФАПриИзменении(Элемент)
	
	Объект.ВидИмущества = УправлениеОсновнымиСредствамиВызовСервераПовтИсп.ВидИмуществаПоСчетуУчета(Объект.Счет);
	
	// Очищаем поля счета:
	Объект.Счет = Неопределено;
	Объект.КПС = Неопределено;
	Объект.КЭК = Неопределено;
	
	//---
	// "Предустановленные отборы" в параметрах выбора элементов "Счет" формы
	//---
	ВходныеДанные = Новый Структура("ВидНФА, ПредустановленныеОтборы_Счет",
		Объект.ВидНФА,
		ПредустановленныеОтборы_Счет);
	ПредустановленныеОтборы_УстановитьПараметрыВыбораЭлементаСчет(Элементы["СчетОС"], ВходныеДанные);
	
	НастроитьФормуКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура ВидНФАОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Объект.ВидНФА = ВыбранноеЗначение Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КЭКСчетаОСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.Счет) Тогда
		ТекстСообщения = НСтр("ru='Не заполнен счет.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.Счет");
		Возврат;
	КонецЕсли;
	
	Если ИспользоватьКЭК0 Тогда
		//---
		// КЭК0
		//---
		ОграниченияКЭК = Новый Массив();
		ОграниченияКЭК.Добавить(КЭК0);
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент,
								СтандартнаяОбработка,
								,//КЭК,
								,//Организация,
								,//ИФО,
								,//КФО,
								,//Счет,
								,//Дата,
								,//"Дт",
								ОграниченияКЭК);
	Иначе
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент,
									СтандартнаяОбработка,
									Объект.КЭК,
									Объект.Организация,
									Объект.ИФО,
									Объект.КФО,
	                                Объект.Счет,
									ПолучитьДату(),
									"Дт");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КПССчетаОСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													Объект.КПС, 
													Объект.Организация,
													Объект.ИФО,
													Объект.КФО,
													Объект.Счет,
													ПолучитьДату());
													
КонецПроцедуры

&НаКлиенте
Процедура РежимВводаОстатковНажатие(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект["Организация"]) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Для редактирования режима ввода остатков сначала укажите организацию.'"),
			Объект.Ссылка,
			"Объект.Организация");
		// Выходим:
		Возврат;
	КонецЕсли;
	
	Если НЕ ТипЗнч(ШапкаДокументаКлиент) = Тип("Структура") Тогда
		ШапкаДокументаКлиент = РежимВводаОстатков_СтруктураШапкиДокумента();
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ШапкаДокументаКлиент, Объект);
	
	ОписаниеОповещения_Закрытие = Новый ОписаниеОповещения("РежимВводаОстатков_ВыборСделан", ЭтотОбъект);
	Результат = ОткрытьФорму("Документ.ВводНачальныхОстатков.Форма.НастройкиРежима", ШапкаДокументаКлиент, ЭтаФорма,,,,ОписаниеОповещения_Закрытие, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РежимВводаОстатков_ВыборСделан(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		ДанныеИзменены = (НЕ Объект.ОтражатьВБухгалтерскомУчете = РезультатВыбора.ОтражатьВБухгалтерскомУчете)
			ИЛИ (НЕ Объект.ОтражатьВНалоговомУчете = РезультатВыбора.ОтражатьВНалоговомУчете);
		Если ДанныеИзменены Тогда
			ЗаполнитьЗначенияСвойств(Объект, РезультатВыбора);
			ЭтаФорма.Модифицированность = Истина;
			
			// Обновляем значения параметров ведения налогового учета и настраиваем форму:
			НастроитьФормуСерверСогласноРежимуВводаОстатков();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

// ----- Смена страницы  -----
&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя = "СтраницаКапремонт"
		ИЛИ ТекущаяСтраница.Имя = "СтраницаМодернизация"
		ИЛИ ТекущаяСтраница.Имя = "СтраницаПереоценка"
		Тогда
		
		//---
		// Механизм отбора строк табличной части (v2)
		//---
		ОтборСтрок_ОбработатьВозможноеИзменениеОтбора();
	КонецЕсли;
	
КонецПроцедуры


// ----- Страница "Капитальный ремонт" -----

&НаКлиенте
Процедура ОтборКапремонтУстанавливатьОтборПриИзменении(Элемент)
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ОтборСтрок_УстанавливатьОтборПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборКапремонтОСПриИзменении(Элемент)
	
	//---
