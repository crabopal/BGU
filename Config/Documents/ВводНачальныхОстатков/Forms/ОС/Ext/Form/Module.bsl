&НаСервере
Процедура ИнициализацияФормы()
	
	Если ИнициализацияВыполнена Тогда
		Возврат;
	КонецЕсли;
	
	Элементы["ОС_ОсновнаяПодразделение"].АвтоОтметкаНезаполненного = Документы.ВводНачальныхОстатков.ПодразделениеОбязательноКЗаполнению(Объект);
	
	// Проверим права пользователя:
	ПравоДоступаИзменение = ПравоДоступа("Изменение", Объект.Ссылка.Метаданные());
	МассивКФОдляНалоговогоУчета = Новый ФиксированныйМассив(
		НалоговыйУчетКлиентСервер.ПолучитьМассивКФОдляНалоговогоУчета());
		
	// Запомним имена используемых колонок таблиц ОС
	ТекущийРазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства;
	ПустаяСтрокаТаблицыОСОсновная		= Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ИменаИспользуемыхКолонокОСОсновная(ТекущийРазделУчета);
	ПустаяСтрокаТаблицыОСАмортизация	= Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ИменаИспользуемыхКолонокОСАмортизация(ТекущийРазделУчета);
	ПолнаяТабличнаяЧастьОС_ИменаРедактируемыхВТаблицеКолонокОСАмортизация = Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ИменаРедактируемыхВТаблицеКолонокОСАмортизация(ТекущийРазделУчета);
	
	// Ограничение выбора счета учета:
	ОС_Счет101 = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.00");
	ОС_Счет102 = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("102.00");
	
	//---
	// "Предустановленные отборы" в параметрах выбора элементов "Счет" формы
	//---
	ПредустановленныеОтборы_Инициализация();
	ВходныеДанные = Новый Структура("ВидНФА, ПредустановленныеОтборы_Счет",
		Объект.ВидНФА,
		ПредустановленныеОтборы_Счет);
	ПредустановленныеОтборы_УстановитьПараметрыВыбораЭлементаСчет(Элементы["СчетОС"], ВходныеДанные);
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ОтборСтрок_ИнициализироватьНаСервере();
	
	УстановитьУсловноеОформление();
	
	ИнициализацияВыполнена = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ЗаголовокФормы = "(устарел) Ввод начальных остатков по ОС и НМА ";
	Если Объект.Ссылка.Пустая() Тогда
		ЗаголовокФормы = ЗаголовокФормы + "(создание)";
	Иначе
		ЗаголовокФормы = ЗаголовокФормы + Объект.Номер + " от " + Объект.Дата;
	КонецЕсли;
	ЭтаФорма.Заголовок = ЗаголовокФормы;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьЗаголовокФормы();
	
	Если НЕ ИнициализацияВыполнена Тогда
		ИнициализацияФормы();
		
		//---
		// Полная табличная часть ОС
		//---
		ПолнаяТабличнаяЧастьОС_ОбновитьСервер();
	КонецЕсли;
	
	//---
	// КЭК0
	//---
	УстановитьНовоеЗначениеКЭК = Ложь;
	
	// Заполняем по возможности пустые поля формы:
	Если Объект.Ссылка.Пустая() Тогда
		
		Объект.ВидНФА       = УправлениеОсновнымиСредствамиПовтИсп.ВидНФАпоСчетуУчета(Объект.Счет);
		Объект.ВидИмущества = УправлениеОсновнымиСредствамиПовтИсп.ВидИмуществаПоСчетуУчета(Объект.Счет);
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Объект.Счет);
		Если СвойстваСчета.ЗапретитьИспользоватьВПроводках ИЛИ СвойстваСчета.ЭлементГруппа Тогда
			Объект.Счет = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		КонецЕсли;
		
		Попытка
			ЭтаФорма.ТиповаяОперация = Справочники.ТиповыеОперации.ВводНачальныхОстатков_ОСИНМА;
		Исключение
		КонецПопытки;
		
		Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
		КонецЕсли;
		
		Объект.ОтражатьВБухгалтерскомУчете	= Ложь;		// сразу устанавливаем режим НУ,
		Объект.ОтражатьВНалоговомУчете		= Истина;	// т.к. в других режимах документ устарел
		Объект.КФО							= Перечисления.КВД.Внебюджет;
		
		//---
		// КЭК0
		//---
		УстановитьНовоеЗначениеКЭК = Истина;
		
	КонецЕсли;
	
	//---
	// КЭК0
	//---
	КЭК0 = БухгалтерскийУчетПовтИсп.КЭК0();
	ПроконтролироватьЗначениеКЭКСервер(УстановитьНовоеЗначениеКЭК);
	
	ОбновитьПоляИтогоСервер();
	
	// Значения заполнения (при добавлении новой строки) ТЧ "ОС Основная":
	ЗначенияЗаполнения_ОСОсновная = Новый ФиксированнаяСтруктура(
		Документы.ВводНачальныхОстатков.ПолучитьЗначенияЗаполнения_ОС(Объект.Счет));
	
	// Обновляем значения параметров ведения налогового учета и настраиваем форму:
	НастроитьФормуСерверСогласноРежимуВводаОстатков();
	
	// Если нет прав на изменение документа, то дополнительно отключаем еще элементы:
	ОбщегоНазначенияБГУ.УстановитьНедоступныеЭлементыФормы(Элементы, Объект,
		"ОтражатьВБухгалтерскомУчете,ОтражатьВНалоговомУчете,"
		+ "ОтборКапремонтУстанавливатьОтбор,ОтборКапремонтОС,ОтборКапремонтИнвНомер,"
		+ "ОтборМодернизацияУстанавливатьОтбор,ОтборМодернизацияОС,ОтборМодернизацияИнвНомер,"
		+ "ОтборПереоценкаУстанавливатьОтбор,ОтборПереоценкаНФА");
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент()
	
	РазрешитьРаботуСФормой = ЗначениеЗаполнено(Объект.Организация)
		И ЗначениеЗаполнено(Объект.ВидНФА)
		И ЗначениеЗаполнено(Объект.Счет)
		И ПравоДоступаИзменение;
		
	Элементы["ОС_Основная"].ТолькоПросмотр			= НЕ РазрешитьРаботуСФормой;
	Элементы["РедактированиеВДиалоге"].Доступность	= РазрешитьРаботуСФормой;
	Элементы["ОткрытьВДиалогеКМ"].Доступность		= РазрешитьРаботуСФормой;
	
	Элементы["КапРемонтОСОтбор"].ТолькоПросмотр		= НЕ РазрешитьРаботуСФормой;
	Элементы["МодернизацияОСОтбор"].ТолькоПросмотр	= НЕ РазрешитьРаботуСФормой;
	Элементы["ПереоценкаНФАОтбор"].ТолькоПросмотр	= НЕ РазрешитьРаботуСФормой;
	
	Элементы["ГруппаКапремонтОтбор"].Доступность	= РазрешитьРаботуСФормой;
	Элементы["ГруппаМодернизацияОтбор"].Доступность	= РазрешитьРаботуСФормой;
	Элементы["ГруппаПереоценкаОтбор"].Доступность	= РазрешитьРаботуСФормой;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Документы.ВводНачальныхОстатков.УстановитьУсловноеОформление_КолонкиОСПринятиеКУчету(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДату()
	
	Возврат КонецГода(Объект.Дата) + 1;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗначенияЗаполнения_ОС(Счет)
	Возврат Документы.ВводНачальныхОстатков.ПолучитьЗначенияЗаполнения_ОС(Счет);
КонецФункции
&НаКлиенте
Процедура ЗаполнитьПоляНовойСтроки_ОС_Основная()
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ЗначенияЗаполнения_ОСОсновная);
	
КонецПроцедуры

//---
// Полная табличная часть ОС
//---

&НаСервере
Процедура ПолнаяТабличнаяЧастьОС_ОбновитьСервер()
	
	Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ОбновитьСервер(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПолнаяТабличнаяЧастьОС_ЗаполнитьСтрокуДаннымиИзОСАмортизацияСервер(ИдТекСтроки)
	
	Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ЗаполнитьСтрокуДаннымиИзОСАмортизацияСервер(ЭтаФорма, ИдТекСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолнаяТабличнаяЧастьОС_ПриИзмененииПоляТаблицыОСАмортизацияКлиент(Элемент)
	
	ТекДанные	= Элементы["ОС_Основная"].ТекущиеДанные;
	ОС			= ТекДанные["ОС"];
	
	Если ЗначениеЗаполнено(ОС) Тогда
		ИдТекСтроки = Элементы["ОС_Основная"].ТекущаяСтрока;
		
		ПолнаяТабличнаяЧастьОС_ПриИзмененииПоляТаблицыОСАмортизацияСервер(ИдТекСтроки, Элемент.Имя);
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолнаяТабличнаяЧастьОС_ПриИзмененииПоляТаблицыОСАмортизацияСервер(ИдТекСтроки, ИмяЭлемента)
	
	Документы.ВводНачальныхОстатков.ПолнаяТабличнаяЧастьОС_ПриИзмененииПоляТаблицыОСАмортизацияСервер(ЭтаФорма, ИдТекСтроки, ИмяЭлемента);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонок(НоваяДоступность)
	
	Для Каждого Элем Из ПустаяСтрокаТаблицыОСОсновная Цикл
		ИмяКолонки = Элем.Ключ;
		ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонки(ИмяКолонки, НоваяДоступность, Ложь);
	КонецЦикла;
	
	Для Каждого Элем Из ПустаяСтрокаТаблицыОСАмортизация Цикл
		ИмяКолонки = Элем.Ключ;
		ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонки(ИмяКолонки, НоваяДоступность, Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонки(ИмяКолонки, НоваяДоступность, ЭтоКолонкаОСАмортизация)
	
	Если ВРег(ИмяКолонки) = "ОС" Тогда
		Возврат;
	КонецЕсли;
	
	КолонкаРедактируетсяВТаблице = ?(ЭтоКолонкаОСАмортизация,
		ПолнаяТабличнаяЧастьОС_ИменаРедактируемыхВТаблицеКолонокОСАмортизация.Свойство(ИмяКолонки),
		Истина);
	
	Если КолонкаРедактируетсяВТаблице Тогда
		ИмяЭлемента	= "ОС_Основная" + ИмяКолонки;
		
		Попытка
			Элементы[ИмяЭлемента].ТолькоПросмотр = НЕ НоваяДоступность;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоляИтогоКлиент()
	
	Итого_СуммаНУ = Объект.ОС_Основная.Итог("СуммаНУ");
	Итого_СуммаАмортизацииНУ = Объект.ОС_Основная.Итог("СуммаАмортизацииНУ");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоляИтогоСервер()
	
	Итого_СуммаНУ = Объект.ОС_Основная.Итог("СуммаНУ");
	Итого_СуммаАмортизацииНУ = Объект.ОС_Основная.Итог("СуммаАмортизацииНУ");
	
КонецПроцедуры

//---
// Редактирование в диалоге
//---

&НаКлиенте
Процедура РедактированиеВДиалоге_НастроитьФормуПоПометке(ПометкаНовая = Ложь)
	
	Элементы["РедактированиеВДиалоге"].Пометка = ПометкаНовая;
	
	Элементы["ОС_Основная"].РежимВыделенияСтроки = ?(ПометкаНовая,
		РежимВыделенияСтрокиТаблицы.Строка,
		РежимВыделенияСтрокиТаблицы.Ячейка);
		
	//---
	// Полная табличная часть ОС
	//---
	ПолнаяТабличнаяЧастьОС_УстановитьДоступностьКолонок(НЕ ПометкаНовая);
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеВДиалоге_ПроверитьИОткрытьДиалог(СтандартнаяОбработка = Неопределено, ПроверятьУстановленностьРежимаДиалога = Ложь)
	
	Перем ОткрытьФормуДиалога;
	
	Если НЕ РазрешитьРаботуСФормой Тогда
		// Выходим
		Возврат;
	КонецЕсли;
	
	ЭлементТаблицыОС = Элементы["ОС_Основная"];
	
	Если ПроверятьУстановленностьРежимаДиалога = Истина Тогда
		// Определяем, установлен ли режим редактирования в диалоге
		Если ЭлементТаблицыОС.ТекущийЭлемент.ТолькоПросмотр Тогда
			РежимДиалогаУстановлен = Истина;
		Иначе
			ИмяКолонки = Сред(ЭлементТаблицыОС.ТекущийЭлемент.Имя, 12);
			Если ВРег(ИмяКолонки) = "ОС" ИЛИ ВРег(ИмяКолонки) = "ОСПРЕДСТАВЛЕНИЕ" Тогда
				// Редактируем все равно в строке.
				РежимДиалогаУстановлен = Ложь;
			Иначе
				РежимДиалогаУстановлен = Элементы["РедактированиеВДиалоге"].Пометка;
			КонецЕсли;
		КонецЕсли;
	Иначе
		РежимДиалогаУстановлен = Истина;
	КонецЕсли;
	
	Если РежимДиалогаУстановлен = Истина Тогда
		ТекДанные = ЭлементТаблицыОС.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			// Выходим
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные["ОС"]) Тогда
			ОткрытьФормуДиалога = Истина;
		Иначе
			
			ТекстСообщения	= НСтр("ru='Укажите основное средство'");
			ИндексСтроки	= ТекДанные.НомерСтроки - 1;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				Объект.Ссылка,
				"ОС_Основная[" + ИндексСтрокиТекст + "].ОС",
				"Объект");
		КонецЕсли;
	КонецЕсли;
	
	Если ОткрытьФормуДиалога = Истина Тогда
		СтандартнаяОбработка = Ложь;
		РедактированиеВДиалоге_ОткрытьДиалог(ИмяКолонки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеВДиалоге_ОткрытьДиалог(ИмяПоля = Неопределено)
	
	ИдСтроки		= Элементы["ОС_Основная"].ТекущаяСтрока;
	ТекДанные		= Элементы["ОС_Основная"].ТекущиеДанные;
	ИндексСтроки	= ТекДанные.НомерСтроки - 1;
	
	АдресДанных			= ПоместитьТекущиеДанныеВХранилище(ИдСтроки, ИндексСтроки, ИмяПоля);
	ПараметрыФормы		= Новый Структура("АдресДанных", АдресДанных);
	ПараметрыОповещения	= Новый Структура();
	ПараметрыОповещения.Вставить("АдресДанных",	АдресДанных);
	ПараметрыОповещения.Вставить("ТекДанные",	ТекДанные);
	
	ОписаниеОповещения_Закрытие = Новый ОписаниеОповещения("ЗавершитьРедактированиеТекСтрокиОСКлиент", ЭтотОбъект, ПараметрыОповещения);
	ОткрытьФорму("Документ.ВводНачальныхОстатков.Форма.ОССтрока", ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещения_Закрытие, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьТекущиеДанныеВХранилище(ИдТекСтроки, ИндексТекСтроки, ИмяАктивногоПоля, ТекстЗаголовкаСообщений = Неопределено)

	// Текущие данные в обеих табличных частях:
	ТекДанные_ОСОсновная = Объект.ОС_Основная.НайтиПоИдентификатору(ИдТекСтроки);
	
	ОССсылка = ТекДанные_ОСОсновная.ОС;
	Отбор = Новый Структура("ОС", ОССсылка);
	Строки = Объект.ОС_Амортизация.НайтиСтроки(Отбор);
	Если Строки.Количество() > 0 Тогда
		ТекДанные_ОСАмортизация = Строки[0];
	Иначе
		ТекДанные_ОСАмортизация = Объект.ОС_Амортизация.Добавить();
		ТекДанные_ОСАмортизация.ОС = ОССсылка;
	КонецЕсли;
	ИдТекСтроки_ОСОсновная		= ИдТекСтроки;
	ИдТекСтроки_ОСАмортизация	= ТекДанные_ОСАмортизация.ПолучитьИдентификатор();
	
	// Структуры с текущими данными, передаваемые в открываемую форму.
	
	// Данные строки ОС Основная:
	ТекДанные_Основная = Новый Структура("НомерСтроки");
	Для Каждого Элем Из ПустаяСтрокаТаблицыОСОсновная Цикл
		ТекДанные_Основная.Вставить(Элем.Ключ);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(ТекДанные_Основная, ТекДанные_ОСОсновная);
	
	// Данные строки ОС Амортизация:
	ТекДанные_Амортизация = Новый Структура();
	Для Каждого Элем Из ПустаяСтрокаТаблицыОСАмортизация Цикл
		ТекДанные_Амортизация.Вставить(Элем.Ключ);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(ТекДанные_Амортизация, ТекДанные_ОСАмортизация);
	
	// Данные документа:
	ТекДанные_Документ = Новый Структура("
		|Дата,
		|Организация,
		|РазделУчета,
		|КФО,
		|ИФО,
		|Счет,
		|КПС,
		|КЭК,
		|ВидНФА,
		|ВидУчета,
		|ВидИмущества,
		|ОтражатьВБухгалтерскомУчете,
		|ОтражатьВНалоговомУчете");
	ЗаполнитьЗначенияСвойств(ТекДанные_Документ, Объект);
	
	// Реквизиты формы - параметры ведения налогового учета:
	ПараметрыВеденияНалоговогоУчета = Новый Структура("
		|НалУчет_ОСН,
		|НалУчет_УСН,
		|НалУчет_УстановленКорректно");
	ЗаполнитьЗначенияСвойств(ПараметрыВеденияНалоговогоУчета, ЭтаФорма);
	
	РасходыУСН = Объект.ОС_РасходыУСН.Выгрузить(Новый Структура("ОС", ОССсылка));
	
	ПередаваемыеДанные = Новый Структура();
	ПередаваемыеДанные.Вставить("ТекДанные_Основная",				ТекДанные_Основная);
	ПередаваемыеДанные.Вставить("ТекДанные_Амортизация",			ТекДанные_Амортизация);
	ПередаваемыеДанные.Вставить("ТекДанные_Документ",				ТекДанные_Документ);
	ПередаваемыеДанные.Вставить("ИндексТекСтроки",					ИндексТекСтроки);
	ПередаваемыеДанные.Вставить("ПараметрыВеденияНалоговогоУчета",	ПараметрыВеденияНалоговогоУчета);
	ПередаваемыеДанные.Вставить("РасходыУСН",						РасходыУСН);
	ПередаваемыеДанные.Вставить("ИмяАктивногоПоля",					ИмяАктивногоПоля);
	ПередаваемыеДанные.Вставить("ТекстЗаголовкаСообщений",			ТекстЗаголовкаСообщений);
	
	Возврат ПоместитьВоВременноеХранилище(ПередаваемыеДанные, ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

// Вызывается при закрытии формы редактирования строки ОС для применения сделанных изменений.
&НаКлиенте
Процедура ЗавершитьРедактированиеТекСтрокиОСКлиент(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		
		ЗавершитьРедактированиеТекСтрокиОССервер(ПараметрыОповещения["АдресДанных"]);
		
		ТекДанные = ПараметрыОповещения["ТекДанные"];
		
		ОповеститьОбИзменении(ТекДанные.ОС);
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьРедактированиеТекСтрокиОССервер(АдресДанных)
	
	ВходящиеДанные = ПолучитьИзВременногоХранилища(АдресДанных);
	
	ИндексТекущейСтроки = ВходящиеДанные.ТекущиеДанные.НомерСтроки - 1;
	
	// Обновляем в ТЧ "ОС Основная" поля текущей строки:
	ТекДанные = Объект["ОС_Основная"].НайтиПоИдентификатору(ИдТекСтроки_ОСОсновная);
	Если НЕ ТекДанные = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ТекДанные, ВходящиеДанные.ТекущиеДанные);
	КонецЕсли;
	
	// Обновляем в ТЧ "ОС Амортизация" поля текущей строки:
	ТекДанные = Объект["ОС_Амортизация"].НайтиПоИдентификатору(ИдТекСтроки_ОСАмортизация);
	Если НЕ ТекДанные = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ТекДанные, ВходящиеДанные.ТекущиеДанные);
	КонецЕсли;
	
	// Обновляем модифицируемые свойства ОС
	ОССсылка = ТекДанные["ОС"];
	ТекущиеСвойстваОС = Документы.ВводНачальныхОстатков.ПолучитьЗначенияМодифицируемыхРеквизитовОС(
		Объект["РазделУчета"],
		ОССсылка);
	Документы.ВводНачальныхОстатков.ОбновитьИзмененныеРеквизитыОС(
		ОССсылка,
		ТекущиеСвойстваОС,
		ВходящиеДанные["РеквизитыОСНаФорме"]);
		
	//---
	// Полная табличная часть ОС
	//---
	ПолнаяТабличнаяЧастьОС_ОбновитьСервер();
	ОбновитьПоляИтогоСервер();
	
	Элементы["ОС_Основная"].ТекущаяСтрока = Объект["ОС_Основная"][ИндексТекущейСтроки].ПолучитьИдентификатор();
	
	// Записываем РасходыУСН.
	Если ВходящиеДанные.Свойство("РасходыУСН") Тогда
		
		// Удаляем строки расходов по выбранному объекту ОС.
		СтрокиКУдалению = Объект.ОС_РасходыУСН.НайтиСтроки(Новый Структура("ОС", ОССсылка));
		Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			Объект.ОС_РасходыУСН.Удалить(Объект.ОС_РасходыУСН.Индекс(СтрокаКУдалению));
		КонецЦикла;
		
		// Записываем новые строки расходов по выбранному объекту ОС.
		Для Каждого СтрокаРасходовУСН Из ВходящиеДанные.РасходыУСН Цикл
			НоваяСтрока = Объект.ОС_РасходыУСН.Добавить();
			НоваяСтрока.ОС = ОССсылка;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасходовУСН);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

//---
// Обработчики событий элементов формы

&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение = Неопределено)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОрганизацияПередИзменениемКлиент_Ответ", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении,
		НСтр("ru='Изменение организации вызовет полную очистку
		|табличной части документа и некоторых полей шапки.
		|
		|Продолжить и сменить организацию?'"),
		РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Объект["Организация"] = ПараметрыОповещения["ВыбранноеЗначение"];
		ЭтаФорма.Модифицированность = Истина;
		ОрганизацияПриИзмененииКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПриИзмененииКлиент()
	
	ОрганизацияПриИзмененииСервер();
	
	НастроитьФормуКлиент();
	
КонецПроцедуры
&НаСервере
Процедура ОрганизацияПриИзмененииСервер()
	
	ОчиститьРеквизитыТабличнойЧастиНесоответствующиеОрганизации();
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьРеквизитыТабличнойЧастиНесоответствующиеОрганизации()
	
	// Очищаем табл.части:
	Объект["ОС_Основная"].Очистить();
	Объект["ОС_Амортизация"].Очистить();
	Объект["ОС_РасходыУСН"].Очистить();
	
	Объект["КапРемонтОС"].Очистить();
	Объект["КапРемонтОСОтбор"].Очистить();
	Объект["МодернизацияОС"].Очистить();
	Объект["МодернизацияОСОтбор"].Очистить();
	Объект["ПереоценкаНФА"].Очистить();
	Объект["ПереоценкаНФАОтбор"].Очистить();
	
	ОбновитьПоляИтогоСервер();
	
	// Устанавливаем новую дату документа:
	Объект.Дата = Документы.ВводНачальныхОстатков.ПолучитьДатуНовогоДокумента(Объект.Организация);
	
	// Обновляем значения параметров ведения налогового учета и настраиваем форму:
	НастроитьФормуСерверСогласноРежимуВводаОстатков();
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииСервер()
	
	// Обновляем значения параметров ведения налогового учета и настраиваем форму:
	НастроитьФормуСерверСогласноРежимуВводаОстатков();
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииСервер()
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаСервере
Процедура КФОПриИзмененииСервер()
	
	// Обновляем значения параметров ведения налогового учета и настраиваем форму:
	НастроитьФормуСерверСогласноРежимуВводаОстатков();
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение
	
КонецПроцедуры

&НаСервере
Процедура СчетПриИзмененииСервер()
	
	// Обновляем значения заполнения:
	ВремСтруктура = ПолучитьЗначенияЗаполнения_ОС(Объект.Счет);
	ЗаполнитьЗначенияСвойств(Объект, ВремСтруктура, "ВидНФА,ВидИмущества,ВидУчета");
	ВремСтруктура.Удалить("ВидНФА");
	ВремСтруктура.Удалить("ВидИмущества");
	ВремСтруктура.Удалить("ВидУчета");
	ЗначенияЗаполнения_ОСОсновная = Новый ФиксированнаяСтруктура(ВремСтруктура);
	
	Элементы["ОС_ОсновнаяПодразделение"].АвтоОтметкаНезаполненного = Документы.ВводНачальныхОстатков.ПодразделениеОбязательноКЗаполнению(Объект);
	
	//---
	// "Предустановленные отборы" в параметрах выбора элементов "Счет" формы
	//---
	ВходныеДанные = Новый Структура("ВидНФА, ПредустановленныеОтборы_Счет",
		Объект.ВидНФА,
		ПредустановленныеОтборы_Счет);
	ПредустановленныеОтборы_УстановитьПараметрыВыбораЭлементаСчет(Элементы["СчетОС"], ВходныеДанные);
	
	//---
	// КЭК0
	//---
	ПроконтролироватьЗначениеКЭКСервер(Истина); // УстановитьНовоеЗначение

КонецПроцедуры


// --- Режим ввода остатков ---
&НаСервере
Процедура НастроитьФормуСерверСогласноРежимуВводаОстатков()
	
	// Задаваемые цвета текста заголовка колонок таблицы.
	// При корректном отображении:
	ЦветТекстаЗаголовка_Корректно				= ЦветаСтиля.ЦветТекстаФормы;
	// При некорректном:
	ЦветТекстаЗаголовка_Некорректно				= ЦветаСтиля.НепринятаяВерсия;
	
	// Колонки, зависимые от режима ввода остатков:
	ШапкаДокумента = Документы.ВводНачальныхОстатков.РежимВводаОстатков_СтруктураШапкиДокумента();
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, Объект);
	РезультатПроверки = Неопределено;
	ТаблицаПолейРежимов = Документы.ВводНачальныхОстатков.РежимВводаОстатков_ИменаПолейВсехРежимов(
		ШапкаДокумента,
		,	// ТолькоНеиспользуемые
		РезультатПроверки);
	
	// Параметры ведения налогового учета:
	ОбновитьПараметрыВеденияНалоговогоУчетаСервер(РезультатПроверки);

	Для Каждого СтрокаТЗ Из ТаблицаПолейРежимов Цикл
		
		ПомечатьВыводимыеПринудительно = СтрокаТЗ["ПомечатьВыводимыеПринудительно"];
		ИмяПоля			= СтрокаТЗ["Поле"];
		НовВидимость	= СтрокаТЗ["Видимость"];
		ИмяТаблЧасти	= ВРег(СтрокаТЗ["ТаблЧасть"]);
		Если ИмяТаблЧасти = "ОС_ОСНОВНАЯ" ИЛИ ИмяТаблЧасти = "ОС_АМОРТИЗАЦИЯ" Тогда
			ИмяЭлемента	= "ОС_Основная" + ИмяПоля;
		ИначеЕсли ИмяТаблЧасти = "КАПРЕМОНТОС" Тогда
			ИмяЭлемента	= "КапРемонтОСОтбор" + ИмяПоля;
		ИначеЕсли ИмяТаблЧасти = "МОДЕРНИЗАЦИЯОС" Тогда
			ИмяЭлемента	= "МодернизацияОСОтбор" + ИмяПоля;
		ИначеЕсли ИмяТаблЧасти = "ПЕРЕОЦЕНКАНФА" Тогда
			ИмяЭлемента	= "ПереоценкаНФАОтбор" + ИмяПоля;
		Иначе	
			ИмяЭлемента	= СтрокаТЗ["Элемент"];
		КонецЕсли;
		
		ЦветКорр	= ЦветТекстаЗаголовка_Корректно;
		
		// Новый цвет заголовка колонки:
		НовЦветЗаголовка = ?(СтрокаТЗ["Видимость"] И СтрокаТЗ["Используется"],
			ЦветКорр,	// корректно
			ЦветТекстаЗаголовка_Некорректно);	// не корректно
		
		// Задаем новую видимость колонки:
		Колонка = Элементы[ИмяЭлемента];
		Колонка.Видимость = НовВидимость;
		Если ПомечатьВыводимыеПринудительно Тогда
			Колонка.ЦветТекстаЗаголовка = НовЦветЗаголовка;
		КонецЕсли;
		
	КонецЦикла;
	
	// Особые настройки при исключительно нал.режиме ввода остатков.
	// Страницы истории капремонта, модернизации, переоценки:
	ТолькоНалУчет = НЕ Объект["ОтражатьВБухгалтерскомУчете"] И Объект["ОтражатьВНалоговомУчете"];
	Если ТолькоНалУчет Тогда
		ОтборСтрок_УстанавливатьОтбор = Ложь;
	КонецЕсли;
	Элементы["ДекорацияКапремонт"].Видимость					= НЕ ТолькоНалУчет;
	Элементы["ДекорацияМодернизация"].Видимость					= НЕ ТолькоНалУчет;
	Элементы["ДекорацияПереоценка"].Видимость					= НЕ ТолькоНалУчет;
	Элементы["ДекорацияКапремонтНеИспользуется"].Видимость		= ТолькоНалУчет;
	Элементы["ДекорацияМодернизацияНеИспользуется"].Видимость	= ТолькоНалУчет;
	Элементы["ДекорацияПереоценкаНеИспользуется"].Видимость		= ТолькоНалУчет;
	Элементы["СтраницаКапремонт"].ТолькоПросмотр		= ТолькоНалУчет;
	Элементы["СтраницаМодернизация"].ТолькоПросмотр		= ТолькоНалУчет;
	Элементы["СтраницаПереоценка"].ТолькоПросмотр		= ТолькоНалУчет;
	// Кнопка "Заполнить по данным бух.учета":
	КФОСоответствует = НЕ (МассивКФОдляНалоговогоУчета.Найти(Объект["КФО"]) = Неопределено);
	Элементы["ОС_ОсновнаяЗаполнить"].Доступность = ТолькоНалУчет И КФОСоответствует;
	
	Документы.ВводНачальныхОстатков.НастроитьФормуДокументаДляУстаревшегоРазделаУчета(ЭтаФорма);

КонецПроцедуры
&НаСервере
Процедура ОбновитьПараметрыВеденияНалоговогоУчетаСервер(РезультатПроверки)
	
	РежимВводаОстатковКорректный = НЕ ЗначениеЗаполнено(РезультатПроверки["ТекстСообщения"]);
	Если НЕ РежимВводаОстатковКорректный Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РезультатПроверки["ТекстСообщения"],
			Объект.Ссылка,
			РезультатПроверки["ИмяПоляДляВыводаСообщения"]);
	КонецЕсли;
	
	// Обновляем соответствующие реквизиты формы:
	НалУчет_ОСН = РезультатПроверки["Кэш"]["ПлательщикНалогаНаПрибыль"];
	НалУчет_УСН = РезультатПроверки["Кэш"]["ПрименяетсяУСНДоходыМинусРасходы"];
	НалУчет_УстановленКорректно = Объект.ОтражатьВНалоговомУчете И РежимВводаОстатковКорректный;
	
КонецПроцедуры
&НаСервереБезКонтекста
Функция РежимВводаОстатков_СтруктураШапкиДокумента()
	
	Возврат Документы.ВводНачальныхОстатков.РежимВводаОстатков_СтруктураШапкиДокумента();
	
КонецФункции

//---
// Механизм отбора строк табличной части (v2)
//---

&НаКлиенте
Процедура ОтборСтрок_ИнициализироватьНаКлиенте()
	
	ОтборСтрок_ВыбранаНоваяСтрока = Ложь;
	
	ОтборСтрок_ПрименяемыйОтбор = ОтборСтрок_ПрочитатьРеквизитыОтбора();
	
	ОтборСтрок_НастроитьФормуПоляОтбора();
	
КонецПроцедуры

&НаСервере
Процедура ОтборСтрок_ИнициализироватьНаСервере()
	
	ОтборСтрок_ЗаполнитьТаблицыОтборов();

КонецПроцедуры

&НаСервере
Процедура ОтборСтрок_ПередЗаписьюНаСервере(ДокументОбъект)
	
	Документы.ВводНачальныхОстатков.ОтборСтрок_ОбработатьРеквизитыПередЗаписью(ДокументОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОтборСтрок_ПослеЗаписиНаСервере()
	
	// Восстанавливаем несохраняемые реквизиты механизма (очищенные ранее перед записью объекта)
	ОтборСтрок_ТрансформироватьРеквизитыФормыВРеквизитыОбъекта(Объект, ЭтаФорма);
	
	ОтборСтрок_ЗаполнитьТаблицыОтборов();
	
КонецПроцедуры

&НаСервере
Процедура ОтборСтрок_ЗаполнитьТаблицыОтборов()
	
	НаличиеНеотображаемыхСтрок = Документы.ВводНачальныхОстатков.ОтборСтрок_ЗаполнитьТаблицыОтборов(Объект);
	
	Документы.ВводНачальныхОстатков.ОтборСтрок_НастроитьФормуПоРезультатамОтбора(ЭтаФорма, НаличиеНеотображаемыхСтрок);
	
КонецПроцедуры

&НаКлиенте
Функция ОтборСтрок_ПрочитатьРеквизитыОтбора()
	
	РеквизитыОтбора = Новый Структура();
	РеквизитыОтбора.Вставить("ОС",			Объект["ОтборСтрокОС"]);
	РеквизитыОтбора.Вставить("ИнвНомер",	Объект["ОтборСтрокИнвНомер"]);
	
	ОтборСтрок_ТрансформироватьРеквизитыОбъектаВРеквизитыФормы(Объект, ЭтаФорма);
	
	Возврат РеквизитыОтбора;
	
КонецФункции

&НаКлиенте
Функция ОтборСтрок_УстановитьРеквизитыОтбора(СтруктураОтбора)
	
	Объект["ОтборСтрокОС"]			= СтруктураОтбора["ОС"];
	Объект["ОтборСтрокИнвНомер"]	= СтруктураОтбора["ИнвНомер"];
	
	Объект["ОтборСтрокУстанавливатьОтбор"]	= ЭтаФорма["ОтборСтрок_УстанавливатьОтбор"];
	
	ОтборСтрок_ТрансформироватьРеквизитыОбъектаВРеквизитыФормы(Объект, ЭтаФорма);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОтборСтрок_ТрансформироватьРеквизитыОбъектаВРеквизитыФормы(Объект, Форма)
	
	Форма["ОтборСтрок_УстанавливатьОтбор"]	= Объект["ОтборСтрокУстанавливатьОтбор"];
	Форма["ОтборСтрок_ОС"]					= Объект["ОтборСтрокОС"];
	Форма["ОтборСтрок_ИнвНомер"]			= Объект["ОтборСтрокИнвНомер"];
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОтборСтрок_ТрансформироватьРеквизитыФормыВРеквизитыОбъекта(Объект, Форма)
	
	Объект["ОтборСтрокУстанавливатьОтбор"]	= Форма["ОтборСтрок_УстанавливатьОтбор"];
	Объект["ОтборСтрокОС"]					= Форма["ОтборСтрок_ОС"];
	Объект["ОтборСтрокИнвНомер"]			= Форма["ОтборСтрок_ИнвНомер"];
	
КонецПроцедуры

&НаКлиенте
Функция ОтборСтрок_ОтборИзменен(ВозвратОтборНовый)
	
	// Определяем новый отбор
	Если ОтборСтрок_ВыбранаНоваяСтрока И Объект["ОтборСтрокУстанавливатьОтбор"] Тогда
		// В таблице "ОС" выбрана новая строка, и включена автоматическая установка отбора
		
		ОтборСтрок_ВыбранаНоваяСтрока = Ложь;
		
		ВозвратОтборНовый = ОтборСтрок_ПолучитьСтруктуруОтбораИзТекДанных();
		
		ОтборСтрок_УстановитьРеквизитыОтбора(ВозвратОтборНовый);
	Иначе
		// Изменено значение одного из полей отбора строк
		
		ВозвратОтборНовый = ОтборСтрок_ПрочитатьРеквизитыОтбора();
	КонецЕсли;
	
	// Сравниваем прежний и новый отборы
	Для Каждого ЭлемПрежний Из ОтборСтрок_ПрименяемыйОтбор Цикл
		ИмяРеквизита	= ЭлемПрежний.Ключ;
		ПрежнееЗначение	= ЭлемПрежний.Значение;
		НовоеЗначение	= ВозвратОтборНовый[ИмяРеквизита];
		Если НЕ НовоеЗначение = ПрежнееЗначение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ОтборСтрок_ПолучитьСтруктуруОтбораИзТекДанных()
	
	СтруктураОтбора = Новый Структура("ОС, ИнвНомер");
	
	ТекДанные = Элементы["ОС_Основная"].ТекущиеДанные;
	
	Если ТекДанные = Неопределено И Объект["ОС_Основная"].Количество() > 0 Тогда
		ТекДанные = Объект["ОС_Основная"][0];
	КонецЕсли;
	
	Если НЕ ТекДанные = Неопределено Тогда
		СтруктураОтбора.Вставить("ОС",			ТекДанные["ОС"]);
		СтруктураОтбора.Вставить("ИнвНомер",	ТекДанные["ИнвНомерОС"]);
	КонецЕсли;
	
	Возврат СтруктураОтбора;
	
КонецФункции

&НаКлиенте
Процедура ОтборСтрок_ОбработатьВозможноеИзменениеОтбора()
	
	Перем ОтборНовый;
	
	Если ОтборСтрок_ОтборИзменен(ОтборНовый) Тогда
		ОтборСтрок_ОбработатьИзменениеОтбора(ОтборСтрок_ПрименяемыйОтбор, ОтборНовый);
		
		ЗаполнитьЗначенияСвойств(ОтборСтрок_ПрименяемыйОтбор, ОтборНовый);
		
		ОтборСтрок_НастроитьФормуПоляОтбора();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтборСтрок_ОбработатьИзменениеОтбора(ОтборПрежний, ОтборНовый)
	
	ВозвращенныеДанные = Документы.ВводНачальныхОстатков.ОтборСтрок_ОбработатьИзменениеОтбора(Объект, ОтборПрежний, ОтборНовый);
	
	Документы.ВводНачальныхОстатков.ОтборСтрок_НастроитьФормуПоРезультатамОтбора(ЭтаФорма,
		ВозвращенныеДанные["НаличиеНеотображаемыхСтрок"],
		ВозвращенныеДанные["ВидимостьКолонок"]);
	
КонецПроцедуры

// Обработчики событий элементов механизма

&НаКлиенте
Процедура ОтборСтрок_УстанавливатьОтборПриИзменении()
	
	ОтборСтрок_ТрансформироватьРеквизитыФормыВРеквизитыОбъекта(Объект, ЭтаФорма);
	
	Если Объект["ОтборСтрокУстанавливатьОтбор"] Тогда
		НовыйОтбор = ОтборСтрок_ПолучитьСтруктуруОтбораИзТекДанных();
		ОтборСтрок_УстановитьРеквизитыОтбора(НовыйОтбор);
		
		ОтборСтрок_ОбработатьВозможноеИзменениеОтбора();	
	КонецЕсли;
	
	ОтборСтрок_НастроитьФормуПоляОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборСтрок_ПолеОтбораПриИзменении()
	
	ОтборСтрок_ТрансформироватьРеквизитыФормыВРеквизитыОбъекта(Объект, ЭтаФорма);
	
	ОтборСтрок_ОбработатьВозможноеИзменениеОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборСтрок_ОчиститьОтборСтрок()
	
	ЭтаФорма["ОтборСтрок_ОС"]					= Неопределено;
	ЭтаФорма["ОтборСтрок_ИнвНомер"]				= Неопределено;
	ЭтаФорма["ОтборСтрок_УстанавливатьОтбор"]	= Неопределено;
	
	ОтборСтрок_ПолеОтбораПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборСтрок_НадписьОтборУстановленНажатие()
	
	ТекстСообщения = НСтр("ru='Отбор установлен (часть строк не показана).
		|
		|Чтобы увидеть все строки этой таблицы,
		|отключите отбор по основному средству (Х)'");
	
	ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	
КонецПроцедуры

// Используется из-за неоднократного вызова платформой обработчика ПриАктивизацииСтроки
// таблицы "ОС" при установке видимости элементов.
// Поэтому считать, один лишь факт активизации строки означает,
// что пользователь лично выбрал какую-то строку, неправильно.
&НаКлиенте
Функция ОтборСтрок_ВыбранаНоваяСтрокаВТаблицеОС()
	
	ТекДанные			= Элементы["ОС_Основная"].ТекущиеДанные;
	ВыбранаНоваяСтрока	= НЕ (ТекДанные = ОтборСтрок_ТекДанные);
	
	// Запоминаем активизированную строку
	ОтборСтрок_ТекДанные = ТекДанные;
	
	Возврат ВыбранаНоваяСтрока;
	
КонецФункции

&НаКлиенте
Процедура ОтборСтрок_НастроитьФормуПоляОтбора()
	
	ДоступностьОС		= НЕ Объект["ОтборСтрокУстанавливатьОтбор"];
	ДоступностьИнвНомер	= ДоступностьОС И ЗначениеЗаполнено(ОтборСтрок_ПрименяемыйОтбор["ОС"]);
	
	Элементы["ОтборКапремонтОС"].Доступность			= ДоступностьОС;
	Элементы["ОтборКапремонтИнвНомер"].Доступность		= ДоступностьИнвНомер;
	
	Элементы["ОтборМодернизацияОС"].Доступность			= ДоступностьОС;
	Элементы["ОтборМодернизацияИнвНомер"].Доступность	= ДоступностьИнвНомер;
	
	Элементы["ОтборПереоценкаНФА"].Доступность			= ДоступностьОС;
	
КонецПроцедуры

//-----------------------------------------------------------------------
// "Предустановленные отборы" в параметрах выбора элементов "Счет" формы

// Заполняет используемые варианты отбора для полей "Счет" и "Счет амортизации".
// Отборы счетов однозначно определяются значением реквизита "ВидНФА".
&НаСервере
Процедура ПредустановленныеОтборы_Инициализация()
	
	Документы.ВводНачальныхОстатков.ИнициализироватьПредустановленныеОтборы_ОС(ПредустановленныеОтборы_Счет);
	
КонецПроцедуры
// Устанавливает параметр выбора "ПредустановленныйОтбор" указанного элемента.
&НаКлиентеНаСервереБезКонтекста
Процедура ПредустановленныеОтборы_УстановитьПараметрыВыбораЭлементаСчет(ЭлементСчет, ВходныеДанные)
	
	ПредустановленныеОтборы_Счет	= ВходныеДанные["ПредустановленныеОтборы_Счет"];
	ВидНФА							= ВходныеДанные["ВидНФА"];
	
	// Согласно ВходнымДанным получаем текст отбора:
	ТекстОтбора = ПредустановленныеОтборы_Счет.Получить(ВидНФА);
	Если ТекстОтбора = Неопределено Тогда
		// Такому значению ключа не соответствует никакой текст отбора.
		// Используем текст отбора для другого ключа:
		ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ПустаяСсылка");
		ТекстОтбора = ПредустановленныеОтборы_Счет.Получить(ВидНФА);
	КонецЕсли;
	Если ТекстОтбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Устанавливаем параметр выбора:
	НовыйПараметр = Новый ПараметрВыбора("ПредустановленныйОтбор", ТекстОтбора);
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	ЭлементСчет.ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
	
КонецПроцедуры

//---
// Заполнение табличных частей

// Вызывается перед заполнением по данным учета, чтобы убедиться в заполненности отбора.
&НаКлиенте
Функция НеобходимыеРеквизитыЗаполнены()
	
	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект["Дата"]) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""Дата"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.Дата");
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Объект["Организация"]) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""Организация"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.Организация");
	КонецЕсли;
		
	Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО")
		И НЕ ЗначениеЗаполнено(Объект["ИФО"]) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""ИФО"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.ИФО");
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Объект["Счет"]) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""Счет"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.Счет");
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Объект["КФО"]) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""КФО"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.КФО");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПодтвердитьИзменениеТабличнойЧасти(ИмяТЧ, СинонимТЧ, ТекстВопроса = "")
	
	// Есть ли в проверяемой табл.части строки?
	ТаблЧасть = Объект[ИмяТЧ];
	Если ТаблЧасть.Количество() = 0 Тогда
		Результат = Истина;
		
	Иначе
		Результат = Ложь;
		Если ПустаяСтрока(ТекстВопроса) Тогда
			ТекстВопроса = НСтр("ru='Очистить табличную часть %1?'");
		КонецЕсли;
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, СинонимТЧ);
			
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПодтвердитьИзменениеТабличнойЧасти_Ответ", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
&НаКлиенте
Процедура ПодтвердитьИзменениеТабличнойЧасти_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоДаннымБухУчетаКлиент();
	КонецЕсли;
	
КонецПроцедуры
			
&НаКлиенте
Процедура ЗаполнитьПоДаннымБухУчетаКлиент()
	
	ЗаполнитьПоДаннымБухУчетаСервер();
	
	// Если по данным учета не было добавлено ни одной строки, выведем сообщение:
	Если Объект["ОС_Основная"].Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Остатки ОС по данным бух.учета отсутствуют'"), 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьПоДаннымБухУчетаСервер()
	
	ЗапросОстатки = Новый Запрос;
	ЗапросОстатки.УстановитьПараметр("ДатаОстатков", Новый Граница(КонецДня(Объект["Дата"]), ВидГраницы.Включая));
	ЗапросОстатки.УстановитьПараметр("Организация",  Объект.Организация);
	ЗапросОстатки.УстановитьПараметр("ИФО",          Объект.ИФО);
	ЗапросОстатки.УстановитьПараметр("КПС",          Объект.КПС);
	ЗапросОстатки.УстановитьПараметр("МассивКФО",    МассивКФОдляНалоговогоУчета);
	
	ЗапросОстатки.УстановитьПараметр("СчетаОстатки",     БухгалтерскийУчет.СписокСчетов(Объект.Счет.Код));
	ЗапросОстатки.УстановитьПараметр("СчетаАмортизация", БухгалтерскийУчет.СписокСчетов("104.00"));
	
	ЗапросОстатки.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОС
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаОстатков,
	|			Счет В (&СчетаОстатки, &СчетаАмортизация),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И КПС = &КПС
	|				И КФО В (&МассивКФО)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Остатки.ОС КАК ОС,
	|	Остатки.ОС.Наименование КАК ОСПредставление,
	|	ЕСТЬNULL(ПервоначальныеСведенияОСБухгалтерскийУчет.ПервоначальнаяСтоимость, 0) КАК ПервоначальнаяСтоимость,
	|	ПараметрыАмортизацииОСБухгалтерскийУчет.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ПараметрыАмортизацииОСБухгалтерскийУчет.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
	|	НачислениеАмортизацииОСБухгалтерскийУчет.НачислятьАмортизацию КАК НачислятьАмортизацию,
	|	АмортизацияОС.СчетУчетаЗатрат КАК СчетУчетаЗатрат,
	|	АмортизацияОС.КПС КАК КПСЗатрат,
	|	АмортизацияОС.КЭК КАК КЭКЗатрат,
	|	АмортизацияОС.Субконто1 КАК СубконтоЗатрат1,
	|	АмортизацияОС.Субконто2 КАК СубконтоЗатрат2,
	|	АмортизацияОС.Субконто3 КАК СубконтоЗатрат3,
	|	АмортизацияОС.СубконтоНУ КАК СтатьяПрочихРасходов,
	|	РасчетАмортизацииОС.СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|ИЗ
	|	Остатки КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(
	|				&ДатаОстатков,
	|				Организация = &Организация
	|					И ОсновноеСредство В
	|						(ВЫБРАТЬ
	|							Остатки.ОС
	|						ИЗ
	|							Остатки)) КАК ПервоначальныеСведенияОСБухгалтерскийУчет
	|		ПО Остатки.ОС = ПервоначальныеСведенияОСБухгалтерскийУчет.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	|				&ДатаОстатков,
	|				Организация = &Организация
	|					И ОсновноеСредство В
	|						(ВЫБРАТЬ
	|							Остатки.ОС
	|						ИЗ
	|							Остатки)) КАК ПараметрыАмортизацииОСБухгалтерскийУчет
	|		ПО Остатки.ОС = ПараметрыАмортизацииОСБухгалтерскийУчет.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НачислениеАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	|				&ДатаОстатков,
	|				Организация = &Организация
	|					И ОсновноеСредство В
	|						(ВЫБРАТЬ
	|							Остатки.ОС
	|						ИЗ
	|							Остатки)) КАК НачислениеАмортизацииОСБухгалтерскийУчет
	|		ПО Остатки.ОС = НачислениеАмортизацииОСБухгалтерскийУчет.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АмортизацияОС.СрезПоследних(
	|				&ДатаОстатков,
	|				Организация = &Организация
	|					И ОсновноеСредство В
	|						(ВЫБРАТЬ
	|							Остатки.ОС
	|						ИЗ
	|							Остатки)) КАК АмортизацияОС
	|		ПО Остатки.ОС = АмортизацияОС.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	|				&ДатаОстатков,
	|				Организация = &Организация
	|					И ОсновноеСредство В
	|						(ВЫБРАТЬ
	|							Остатки.ОС
	|						ИЗ
	|							Остатки)) КАК РасчетАмортизацииОС
	|		ПО Остатки.ОС = РасчетАмортизацииОС.ОсновноеСредство
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОСПредставление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОС,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвНомерОС,
	|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	СобытиеПринятиеКУчету.ДатаСобытия КАК ДатаПринятияКУчету,
	|	СобытиеПринятиеКУчету.НазваниеДокумента КАК НазваниеДокументаПринятияКУчету,
	|	СобытиеПринятиеКУчету.НомерДокумента КАК НомерДокументаПринятияКУчету,
	|	СобытиеВводВЭксплуатацию.ДатаСобытия КАК ДатаВводаВЭксплуатацию,
	|	СобытиеВводВЭксплуатацию.НазваниеДокумента КАК НазваниеДокументаВводаВЭксплуатацию,
	|	СобытиеВводВЭксплуатацию.НомерДокумента КАК НомерДокументаВводаВЭксплуатацию,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СобытиеВводВЭксплуатацию.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
	|		КОГДА ЕСТЬNULL(СобытиеПринятиеКУчету.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОС.пустаяСсылка)
	|	КОНЕЦ КАК СостояниеОС,
	|	СУММА(СтоимостьОбъектовОСОстатки.КоличествоОстаток) КАК Количество,
	|	СУММА(СтоимостьОбъектовОСОстатки.СтоимостьОстаток) КАК Сумма,
	|	СУММА(ЕСТЬNULL(АмортизацияОбъектовОСОстатки.СуммаАмортизацииОстаток, 0)) КАК СуммаАмортизации
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&ДатаОстатков,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						Остатки.ОС
	|					ИЗ
	|						Остатки)
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС.СрезПоследних(
	|				&ДатаОстатков,
	|				Организация = &Организация
	|					И ОсновноеСредство В
	|						(ВЫБРАТЬ
	|							Остатки.ОС
	|						ИЗ
	|							Остатки)
	|					И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытиеПринятиеКУчету
	|		ПО СтоимостьОбъектовОСОстатки.ОсновноеСредство = СобытиеПринятиеКУчету.ОсновноеСредство
	|			И СтоимостьОбъектовОСОстатки.ИнвентарныйНомер = СобытиеПринятиеКУчету.ИнвНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС.СрезПоследних(
	|				&ДатаОстатков,
	|				Организация = &Организация
	|					И ОсновноеСредство В
	|						(ВЫБРАТЬ
	|							Остатки.ОС
	|						ИЗ
	|							Остатки)
	|					И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)) КАК СобытиеВводВЭксплуатацию
	|		ПО СтоимостьОбъектовОСОстатки.ОсновноеСредство = СобытиеВводВЭксплуатацию.ОсновноеСредство
	|			И СтоимостьОбъектовОСОстатки.ИнвентарныйНомер = СобытиеВводВЭксплуатацию.ИнвНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.АмортизацияОбъектовОС.Остатки(
	|				&ДатаОстатков,
	|				Организация = &Организация
	|					И ОсновноеСредство В
	|						(ВЫБРАТЬ
	|							Остатки.ОС
	|						ИЗ
	|							Остатки)) КАК АмортизацияОбъектовОСОстатки
	|		ПО СтоимостьОбъектовОСОстатки.ОсновноеСредство = АмортизацияОбъектовОСОстатки.ОсновноеСредство
	|			И СтоимостьОбъектовОСОстатки.ИнвентарныйНомер = АмортизацияОбъектовОСОстатки.ИнвентарныйНомер
	|
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.Подразделение,
	|	СтоимостьОбъектовОСОстатки.ЦМО,
	|	СобытиеПринятиеКУчету.ДатаСобытия,
	|	СобытиеПринятиеКУчету.НазваниеДокумента,
	|	СобытиеПринятиеКУчету.НомерДокумента,
	|	СобытиеВводВЭксплуатацию.ДатаСобытия,
	|	СобытиеВводВЭксплуатацию.НазваниеДокумента,
	|	СобытиеВводВЭксплуатацию.НомерДокумента,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СобытиеВводВЭксплуатацию.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
	|		КОГДА ЕСТЬNULL(СобытиеПринятиеКУчету.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОС.пустаяСсылка)
	|	КОНЕЦ";
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ЗапросОстатки.Текст = СтрЗаменить(ЗапросОстатки.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО, "ИФО = &ИФО", "ИСТИНА"));
	
	Объект["ОС_Основная"].Очистить();
	Объект["ОС_Амортизация"].Очистить();
	Объект["ОС_РасходыУСН"].Очистить();
	
	Результат = ЗапросОстатки.ВыполнитьПакет();
	
	ТабОстатковБУ = Результат[1].Выгрузить();
	ТабСведений   = Результат[2].Выгрузить();
	
	Для Каждого СтрокаОстатков Из ТабОстатковБУ Цикл
		
		// Распределяем остатки по инвентарным номерам.
		НайденныеСтроки = ТабСведений.НайтиСтроки(Новый Структура("ОС", СтрокаОстатков.ОС));
		
		Для Инд = 0 По НайденныеСтроки.Количество() - 1 Цикл
			
			СтрокаСведений = НайденныеСтроки[Инд];
			
			Если ( СтрокаОстатков.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию
			  ИЛИ (СтрокаОстатков.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
			     И СтрокаОстатков.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию) )
			И СтрокаСведений.СостояниеОС = Перечисления.СостоянияОС.ВведеноВЭксплуатацию Тогда
				Продолжить; // Уже списано в налоговом учете.
			КонецЕсли;
			
			СтрокаОсновная    = Объект["ОС_Основная"].Добавить(); // Для каждого инвентарного номера.
			ЗаполнитьЗначенияСвойств(СтрокаОсновная, СтрокаОстатков);
			ЗаполнитьЗначенияСвойств(СтрокаОсновная, СтрокаСведений);
			
			Если Инд = 0 Тогда // Для основного средства в целом.
				
				СтрокаАмортизация = Объект["ОС_Амортизация"].Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаАмортизация, СтрокаОстатков);
				ЗаполнитьЗначенияСвойств(СтрокаАмортизация, СтрокаСведений);
				
				Если НалУчет_ОСН Тогда
					
					// Заполняем реквизиты НУ по данным БУ - другой информации нет, т.к. НУ ранее не велся.
					СтрокаАмортизация.ПервоначальнаяСтоимостьНУ = СтрокаОстатков.ПервоначальнаяСтоимость;
					СтрокаАмортизация.СуммаНУ                   = СтрокаСведений.Сумма;
					СтрокаАмортизация.СуммаАмортизацииНУ        = СтрокаСведений.СуммаАмортизации;
					
					Если СтрокаОстатков.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
					   И СтрокаОстатков.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.Линейный Тогда
					
						СтрокаАмортизация.ПорядокВключенияСтоимостиВСоставРасходовНУ =
							Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации;
						
						СтрокаАмортизация.СрокПолезногоИспользованияНУ = СтрокаОстатков.СрокПолезногоИспользования;
						СтрокаАмортизация.НачислятьАмортизациюНУ       = СтрокаОстатков.НачислятьАмортизацию;
						СтрокаАмортизация.СпециальныйКоэффициентНУ     = 1;
						
					ИначеЕсли СтрокаОстатков.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию
					ИЛИ (СтрокаОстатков.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
					   И СтрокаОстатков.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию) Тогда
					
						СтрокаАмортизация.ПорядокВключенияСтоимостиВСоставРасходовНУ =
							Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету;
						
					Иначе
						
						СтрокаАмортизация.ПорядокВключенияСтоимостиВСоставРасходовНУ =
							Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если НалУчет_УСН Тогда
					
					Если СтрокаОстатков.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
					   И СтрокаОстатков.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.Линейный Тогда
					
						СтрокаАмортизация.ПорядокВключенияСтоимостиВСоставРасходовУСН =
							Перечисления.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА;
						
						СтрокаАмортизация.СрокПолезногоИспользованияУСН = СтрокаОстатков.СрокПолезногоИспользования;
						
					ИначеЕсли СтрокаОстатков.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию
					ИЛИ (СтрокаОстатков.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
					   И СтрокаОстатков.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию) Тогда
					
						СтрокаАмортизация.ПорядокВключенияСтоимостиВСоставРасходовУСН =
							Перечисления.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставМатериальныхРасходов;
						
					Иначе
						
						СтрокаАмортизация.ПорядокВключенияСтоимостиВСоставРасходовУСН =
							Перечисления.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.НеВключатьВСоставРасходов;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	//---
	// Полная табличная часть ОС
	//---
	ПолнаяТабличнаяЧастьОС_ОбновитьСервер();
	ОбновитьПоляИтогоСервер();
	
КонецПроцедуры

