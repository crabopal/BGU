Процедура ЗаполнитьРеквизитыПринятияКУчету_2_0_37_ОтложенныйОбработчик(Параметры) Экспорт
	
	ЗаполнитьРеквизитыПринятияКУчету_2_0_37(Параметры);
	
КонецПроцедуры
Процедура ЗаполнитьРеквизитыПринятияКУчету_2_0_37(ПараметрыОтложенногоОбработчика = Неопределено)
	
	Перем УжеОбработанныеДокументы;
	
	// Настройки массовой обработки документов
	КоличествоДокументовОбрабатываемыхМонопольноСтрока			= "50";
	КоличествоДокументовОбрабатываемыхВИтерацииОтложенноСтрока	= "50";
	
	ЭтоОтложенноеВыполнение = (ТипЗнч(ПараметрыОтложенногоОбработчика) = Тип("Структура"));
	
	Если ЭтоОтложенноеВыполнение Тогда
		РежимЗапускаСтрока	= "(отложенный запуск)";
	Иначе
		РежимЗапускаСтрока	= "(монопольный запуск)";
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыОтложенногоОбработчика) = Тип("Структура") Тогда
    	Если НЕ ПараметрыОтложенногоОбработчика.Свойство("УжеОбработанныеДокументы", УжеОбработанныеДокументы) Тогда
			УжеОбработанныеДокументы = Новый Массив();
		КонецЕсли;
	Иначе
		УжеОбработанныеДокументы = Новый Массив();
	КонецЕсли;
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("УжеОбработанныеДокументы",	УжеОбработанныеДокументы);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Документы, исключаемые из обработки (с непустой табл.частью ОС_Амортизация)
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ДокументыИсключаемыеИзОбработки
	|ИЗ
	|	Документ.ВводНачальныхОстатков.ОС_Амортизация	КАК ОС_Амортизация
	|ГДЕ
	|	// Одинаковые условия отбора
	|	НЕ	Ссылка.ПометкаУдаления
	|	И	(Ссылка.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете)
	|		ИЛИ	Ссылка.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.НПА))
	|;		
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Документы, подлежащие обработке (с непустой табл.частью ОС_Основная)
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ " + ?(ЭтоОтложенноеВыполнение,
										КоличествоДокументовОбрабатываемыхВИтерацииОтложенноСтрока,
										КоличествоДокументовОбрабатываемыхМонопольноСтрока) + "
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ДокументыПодлежащиеОбработке
	|ИЗ
	|	Документ.ВводНачальныхОстатков.ОС_Основная	КАК ОС_Основная
	|ГДЕ
	|	НЕ	Ссылка В (ВЫБРАТЬ Ссылка ИЗ ДокументыИсключаемыеИзОбработки)
	|	И	НЕ Ссылка В (&УжеОбработанныеДокументы)
	|	// Одинаковые условия отбора
	|	И	НЕ	Ссылка.ПометкаУдаления
	|	И	(Ссылка.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете)
	|		ИЛИ	Ссылка.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.НПА))
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|///////////////////////////////////////////////////////////////////////////////
	|// [2]. Необходимые сведения из документов, подлежащих обработке
	|//
	|ВЫБРАТЬ
	|	Ссылка									КАК Ссылка,
	|	ОС										КАК ОС,
	|	НомерСтроки								КАК НомерСтроки,
	|	ДатаВводаВЭксплуатацию					КАК ДатаВводаВЭксплуатацию,
	|	НомерДокументаВводаВЭксплуатацию		КАК НомерДокументаВводаВЭксплуатацию,
	|	НазваниеДокументаВводаВЭксплуатацию		КАК НазваниеДокументаВводаВЭксплуатацию
	|ПОМЕСТИТЬ
	|	ДанныеДокументов
	|ИЗ
	|	Документ.ВводНачальныхОстатков.ОС_Основная	КАК ОС_Основная
	|ГДЕ
	|	Ссылка В (ВЫБРАТЬ Ссылка ИЗ ДокументыПодлежащиеОбработке)
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	ОС,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Номера строк, из которых будут выбираться
	|//		реквизиты принятия к учету для каждого ОС
	|//
	|ВЫБРАТЬ
	|	Ссылка					КАК Ссылка,
	|	ОС						КАК ОС,
	|	МИНИМУМ(НомерСтроки)	КАК НомерСтроки
	|ПОМЕСТИТЬ
	|	НомераСтрок
	|ИЗ
	|	ДанныеДокументов
	|СГРУППИРОВАТЬ ПО
	|	Ссылка,
	|	ОС
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	ОС,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Реквизиты принятия к учету - копируем из реквизитов ввода в эксплуатацию
	|//		(Финальная таблица для дальнейшей обработки)
	|//
	|ВЫБРАТЬ
	|	ДанныеДокументов.Ссылка									КАК Ссылка,
	|	ДанныеДокументов.ОС										КАК ОС,
	|	ДанныеДокументов.ДатаВводаВЭксплуатацию					КАК ДатаПринятияКУчету,
	|	ДанныеДокументов.НомерДокументаВводаВЭксплуатацию		КАК НомерДокументаПринятияКУчету,
	|	ДанныеДокументов.НазваниеДокументаВводаВЭксплуатацию	КАК НазваниеДокументаПринятияКУчету
	|ИЗ
	|	ДанныеДокументов	КАК ДанныеДокументов
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	НомераСтрок	КАК НомераСтрок
	|		ПО	ДанныеДокументов.Ссылка			= НомераСтрок.Ссылка
	|		И	ДанныеДокументов.ОС				= НомераСтрок.ОС
	|		И	ДанныеДокументов.НомерСтроки	= НомераСтрок.НомерСтроки
	|ИТОГИ
	|ПО
	|	Ссылка
	|;";

	РезультатОбрабатываемыеДокументы	= ЗапросЗаполнение.Выполнить();
	ВыборкаДокумент						= РезультатОбрабатываемыеДокументы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Сведения для вывода в журнал регистрации
	ИмяСобытия					= НСтр("ru='Данные. Изменение'");
	КомментарийОК 				= НСтр("ru='Успешно обработано документов: %1 - Инициализация реквизитов принятия к учету в документах Ввод начальных остатков ОС забаланс, НПА'");
	КомментарийОшибка			= НСтр("ru='Ошибок при обработке документов: %1 - Инициализация реквизитов принятия к учету в документах Ввод начальных остатков ОС забаланс, НПА'");
	КомментарийПропуск			= НСтр("ru='Документов, подлежащих обработке, не обнаружено - Инициализация реквизитов принятия к учету в документах Ввод начальных остатков ОС забаланс, НПА'");
	КомментарийБлокировка		= НСтр("ru='Не удалось заблокировать документы для модификации - Инициализация реквизитов принятия к учету в документах Ввод начальных остатков ОС забаланс, НПА'");
	КомментарийОшибкаДокумент	= НСтр("ru='Ошибка при обработке документа (%1) - Инициализация реквизитов принятия к учету в документах Ввод начальных остатков ОС забаланс, НПА'");
	
	СчетчикДокументовВсего	= ВыборкаДокумент.Количество();
	СчетчикДокументовОК		= 0;
	СчетчикДокументовОшибка	= 0;
	
	Если ЭтоОтложенноеВыполнение Тогда
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Документ.ВводНачальныхОстатков");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.ИсточникДанных = РезультатОбрабатываемыеДокументы;
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
			Блокировка.Заблокировать();
		Исключение
			// Не удалось заблокировать необходимые документы
			ОтменитьТранзакцию();
			Комментарий = КомментарийБлокировка + ". " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + РежимЗапускаСтрока;
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				,									// объект метаданных
				,									// данные
				Комментарий);						// комментарий
			// Выходим
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	
	Пока ВыборкаДокумент.Следующий() Цикл
		Попытка
			ДокументОбъект = ВыборкаДокумент["Ссылка"].ПолучитьОбъект();
			Если ДокументОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Выборка = ВыборкаДокумент.Выбрать();
			Пока Выборка.Следующий() Цикл
				НоваяСтрока = ДокументОбъект["ОС_Амортизация"].Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			
			СчетчикДокументовОК = СчетчикДокументовОК + 1;
			
			УжеОбработанныеДокументы.Добавить(ВыборкаДокумент["Ссылка"]);
			Если ТипЗнч(ПараметрыОтложенногоОбработчика) = Тип("Структура") Тогда
				ПараметрыОтложенногоОбработчика.Вставить("УжеОбработанныеДокументы", УжеОбработанныеДокументы);
			КонецЕсли;
			
		Исключение
			СчетчикДокументовОшибка = СчетчикДокументовОшибка + 1;
			ПоследняяОшибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			Если ЭтоОтложенноеВыполнение Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			
			Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(КомментарийОшибкаДокумент,
				Строка(ВыборкаДокумент["Ссылка"])) + ". " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
				+ РежимЗапускаСтрока;
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				,									// объект метаданных
				,									// данные
				Комментарий);						// комментарий
				
			УжеОбработанныеДокументы.Добавить(ВыборкаДокумент["Ссылка"]);
			Если ТипЗнч(ПараметрыОтложенногоОбработчика) = Тип("Структура") Тогда
				ПараметрыОтложенногоОбработчика.Вставить("УжеОбработанныеДокументы", УжеОбработанныеДокументы);
			КонецЕсли;
			
			// Выходим
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
	Если ЭтоОтложенноеВыполнение Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
	Если ЭтоОтложенноеВыполнение Тогда
		ОбработкаЗавершена = (СчетчикДокументовВсего = 0);
		ПараметрыОтложенногоОбработчика.Вставить("ОбработкаЗавершена", ОбработкаЗавершена);
	КонецЕсли;
	
	// Сообщения в журнале регистрации
	
	Если СчетчикДокументовВсего = 0 Тогда
		Комментарий = КомментарийПропуск + РежимЗапускаСтрока;
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если СчетчикДокументовОК > 0 Тогда
		Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(КомментарийОК, Строка(СчетчикДокументовОК))
			+ РежимЗапускаСтрока;
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если СчетчикДокументовОшибка > 0 Тогда
		Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(КомментарийОшибка, Строка(СчетчикДокументовОшибка))
			+ ". Последняя ошибка: " + ПоследняяОшибка + РежимЗапускаСтрока;
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Ошибка,		// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыПринятияКУчету_2_0_39_МонопольныйОбработчик() Экспорт
	
	ЗаполнитьРеквизитыПринятияКУчету_2_0_39();
	
КонецПроцедуры
Процедура ЗаполнитьРеквизитыПринятияКУчету_2_0_39_ОтложенныйОбработчик(Параметры) Экспорт
	
	ЗаполнитьРеквизитыПринятияКУчету_2_0_39(Параметры);
	
КонецПроцедуры
Процедура ЗаполнитьРеквизитыПринятияКУчету_2_0_39(ПараметрыОтложенногоОбработчика = Неопределено)
	
	Перем	ЭтоОтложенноеВыполнение,
			ЭтоПервоеОтложенноеВыполнение,
			
			// Статистика обработки
			СчетчикДокументовОК,
			СчетчикДокументовОшибка;
	
	// Настройки массовой обработки документов (каждого вида)
	КоличествоДокументовОбрабатываемыхМонопольноСтрока			= "50";
	КоличествоДокументовОбрабатываемыхВИтерацииОтложенноСтрока	= "50";
	
	// Обрабатываем один вид документов
	ИмяДокумента		= "ВводНачальныхОстатков";
	СинонимДокумента	= НСтр("ru='Ввод начальных остатков на забалансовых счетах'");
	
	// Тексты сообщений для вывода в журнал регистрации
	ОбозначениеОбработки				= "#ЗаполнениеСостоянияОС";
	ИмяСобытия							= НСтр("ru='Данные. Изменение'");
	ШаблонДокументОшибка				= НСтр("ru='[ОбозначениеОбработки] - Ошибка при обработке документа [ДокументСсылка] ([ОписаниеОшибки]) [РежимЗапуска]'");
	ШаблонОбщийОтсутствуютДанные		= НСтр("ru='[ОбозначениеОбработки] - Отсутствуют документы [СинонимДокумента], подлежащие обработке [РежимЗапуска]'");
	ШаблонОбщийОшибкаБлокировки			= НСтр("ru='[ОбозначениеОбработки] - Не удалось заблокировать документы [СинонимДокумента] для модификации ([ОписаниеОшибки]) [РежимЗапуска]'");
	ШаблонОбщийКоличествоУспехов		= НСтр("ru='[ОбозначениеОбработки] - Успешно обработано [Количество] документов [СинонимДокумента] [РежимЗапуска]'");
	ШаблонОбщийКоличествоНеобработанных	= НСтр("ru='[ОбозначениеОбработки] - Осталось [Количество] необработанных документов [СинонимДокумента] [РежимЗапуска]'");
	
	// Используемые вставляемые значения
	//	[ДокументСсылка]
	//	[Количество]
	//	[ОбозначениеОбработки]
	//	[ОписаниеОшибки]
	//	[РежимЗапуска]
	//	[СинонимДокумента]
	
	// Статистика обработки
	СчетчикДокументовОК					= 0;
	СчетчикДокументовОшибка				= 0;
	
	ЭтоОтложенноеВыполнение = (ТипЗнч(ПараметрыОтложенногоОбработчика) = Тип("Структура"));
	
	ЭтоПервоеОтложенноеВыполнение = (ЭтоОтложенноеВыполнение И ПараметрыОтложенногоОбработчика.Количество() = 0);
	
	Если ЭтоОтложенноеВыполнение Тогда
		// Свойства от БСП
		Если НЕ ПараметрыОтложенногоОбработчика.Свойство("ПрогрессВыполнения") Тогда
			ПараметрыОтложенногоОбработчика.Вставить("ПрогрессВыполнения", Новый Структура());
			ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"].Вставить("ВсегоОбъектов",			0);
			ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"].Вставить("ОбработаноОбъектов",	0);
		КонецЕсли;
		
		// Свойства этого обработчика
		Если НЕ ПараметрыОтложенногоОбработчика.Свойство("НомерЗапуска") Тогда
			ПараметрыОтложенногоОбработчика.Вставить("НомерЗапуска", 1);
		Иначе
			ПараметрыОтложенногоОбработчика["НомерЗапуска"] = ПараметрыОтложенногоОбработчика["НомерЗапуска"] + 1;
		КонецЕсли;
		Если НЕ ПараметрыОтложенногоОбработчика.Свойство("УспешноОбработанныеДокументы") Тогда
			ПараметрыОтложенногоОбработчика.Вставить("УспешноОбработанныеДокументы", Новый Массив());
		КонецЕсли;
		
		РежимЗапускаСтрока = "(отложенный запуск, "
			+ Строка(ПараметрыОтложенногоОбработчика["НомерЗапуска"]) + ")";
		
		ТекстПервыеN		= КоличествоДокументовОбрабатываемыхВИтерацииОтложенноСтрока;
		ТекстУпорядочить	= "";
	Иначе
		РежимЗапускаСтрока = "(монопольный запуск)";
		
		ТекстПервыеN		= КоличествоДокументовОбрабатываемыхМонопольноСтрока;
		ТекстУпорядочить	= "
			|УПОРЯДОЧИТЬ ПО
			|	Ссылка.Дата УБЫВ";
	КонецЕсли;
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ВалютаРубль", Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Все документы ввода остатков, требующие обработки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка		КАК Ссылка,
	|	Ссылка.Дата	КАК Дата
	|ПОМЕСТИТЬ
	|	ВсеДокументы
	|ИЗ
	|	Документ.ВводНачальныхОстатков.ОС_Основная	КАК ОС_Основная
	|ГДЕ
	|	// Первая часть признака необработанного документа:
	|	Ссылка.Проведен
	|	И	Ссылка.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете)
	|СГРУППИРОВАТЬ ПО
	|	Ссылка
	|ИМЕЮЩИЕ
	|	// Вторая часть признака необработанного документа:
	|	// (поле СостояниеОС не заполнено во всей таблице)
	|	СУММА(ВЫБОР
	|		КОГДА СостояниеОС = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка) ТОГДА
	|			0
	|		ИНАЧЕ
	|			1
	|	КОНЕЦ) = 0
	|;		
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Документы ввода остатков, требующие обработки
	|//		при очередном запуске обработчика обновления
	|//		(Финальная таблица для дальнейшей обработки)
	|//
	|ВЫБРАТЬ ПЕРВЫЕ " + ТекстПервыеN + "
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	ВсеДокументы
	|" + ТекстУпорядочить + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Общее количество документов, подлежащих обработке
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ
	|	ЕСТЬNULL(КОЛИЧЕСТВО(*), 0)	КАК КоличествоДокументов
	|ИЗ
	|	ВсеДокументы
	|;";
	
	Результаты = ЗапросЗаполнение.ВыполнитьПакет();
	
	// [2]. Общее количество документов, подлежащих обработке
	Выборка = Результаты[2].Выбрать();
	КоличествоДокументов = 0;
	Пока Выборка.Следующий() Цикл
		КоличествоДокументов = Выборка["КоличествоДокументов"];
		Прервать;
	КонецЦикла;
	
	Если КоличествоДокументов = 0 Тогда
		// Отсутствуют объекты для обработки
		
		Если ЭтоОтложенноеВыполнение Тогда
			// Свойства от БСП
			ПараметрыОтложенногоОбработчика.Вставить("ОбработкаЗавершена", Истина);
		КонецЕсли;
		
		// Сообщение "Документов, подлежащих обработке, не обнаружено"
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
		ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
		ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийОтсутствуютДанные, ВставляемыеЗначения);
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
		
		// Выходим
		Возврат;
	КонецЕсли;
	
	Если ЭтоПервоеОтложенноеВыполнение Тогда
		ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ВсегоОбъектов"] = КоличествоДокументов;
	КонецЕсли;
	
	// [1]. Документы ввода остатков, требующие обработки
	РезультатЗапроса = Результаты[1];
	
	// Блокировка данных (только при отложенной обработке)
	Если ЭтоОтложенноеВыполнение Тогда
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		
		ЭлементБлокировки					= Блокировка.Добавить("Документ." + ИмяДокумента);
		ЭлементБлокировки.Режим				= РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных	= РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			// Не удалось заблокировать необходимые документы
			ОтменитьТранзакцию();
			
			// Сообщение "Ошибка блокировки"
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
			ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
			ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
			ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийОшибкаБлокировки, ВставляемыеЗначения);
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				,									// объект метаданных
				,									// данные
				Комментарий);						// комментарий
				
			// Сообщение "Осталось N необработанных документов"
			Количество = ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ВсегоОбъектов"]
				- ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"];
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
			ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
			ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
			ВставляемыеЗначения.Вставить("Количество",				Количество);
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийКоличествоНеобработанных, ВставляемыеЗначения);
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,								// имя события
				УровеньЖурналаРегистрации.Информация,	// уровень
				,										// объект метаданных
				,										// данные
				Комментарий);							// комментарий
				
			// Выходим
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	
	// Собственно заполнение реквизитов
	ВыборкаДокумент = РезультатЗапроса.Выбрать();
	
	// Устанавливаемые значения в строках табличной части ОС_Основная
	ЗначенияЗаполнения = Новый Структура();
	ЗначенияЗаполнения.Вставить("СостояниеОС", Перечисления.СостоянияОС.ВведеноВЭксплуатацию);
	
	Пока ВыборкаДокумент.Следующий() Цикл
		Попытка
			ДокументОбъект = ВыборкаДокумент["Ссылка"].ПолучитьОбъект();
			Если ДокументОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого СтрокаТЧ Из ДокументОбъект["ОС_Основная"] Цикл
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, ЗначенияЗаполнения);
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			
			// Статистика обработки
			СчетчикДокументовОК				= СчетчикДокументовОК + 1;
			
			Если ЭтоОтложенноеВыполнение Тогда
				ПараметрыОтложенногоОбработчика["УспешноОбработанныеДокументы"].Добавить(ВыборкаДокумент["Ссылка"]);
				ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"] =
					ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"] + 1;
			КонецЕсли;
			
		Исключение
			ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			// Статистика обработки
			СчетчикДокументовОшибка				= СчетчикДокументовОшибка + 1;
			
			// Сообщение "Ошибка при обработке документа D"
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
			ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
			ВставляемыеЗначения.Вставить("ДокументСсылка",			ВыборкаДокумент["Ссылка"]);
			ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
			ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ОписаниеОшибки);
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонДокументОшибка, ВставляемыеЗначения);
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				,									// объект метаданных
				,									// данные
				Комментарий);						// комментарий
				
			Если ЭтоОтложенноеВыполнение Тогда
				ОтменитьТранзакцию();
				
				// Сообщение "Осталось N необработанных документов"
				Количество = ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ВсегоОбъектов"]
					- ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"];
				ВставляемыеЗначения = Новый Структура();
				ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
				ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
				ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
				ВставляемыеЗначения.Вставить("Количество",				Количество);
				Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийКоличествоНеобработанных, ВставляемыеЗначения);
				ЗаписьЖурналаРегистрации(
					ИмяСобытия,								// имя события
					УровеньЖурналаРегистрации.Информация,	// уровень
					,										// объект метаданных
					,										// данные
					Комментарий);							// комментарий
				
				// Выходим
				ВызватьИсключение;
			КонецЕсли;
		КонецПопытки;
		
	КонецЦикла;
	
	// Итоговые сообщения в журнале регистрации по каждому виду документов
	
	Если СчетчикДокументовОК > 0 Тогда
		// Сообщение "Количество успешно обработанных документов вида V: N"
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
		ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
		ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
		ВставляемыеЗначения.Вставить("Количество",				Строка(СчетчикДокументовОК));
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийКоличествоУспехов, ВставляемыеЗначения);
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если СчетчикДокументовОшибка > 0 Тогда
		// Сообщение "Количество необработанных документов вида V: N"
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
		ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
		ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
		ВставляемыеЗначения.Вставить("Количество",				Строка(СчетчикДокументовОшибка));
		ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ОписаниеОшибки);
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийКоличествоНеобработанных, ВставляемыеЗначения);
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если ЭтоОтложенноеВыполнение Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры

// Очищает поле ПервоначальнаяСуммаАмортизации в движениях по рег.свед. ПервоначальныеСведенияОСБухгалтерскийУчет
Процедура ОчиститьВДвиженияхПервоначальнуюСуммуАмортизации_2_0_37() Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Документы, чьи движения нуждаются в корректировке
	|//		(Финальная таблица для дальнейшей обработки)
	|//
	|ВЫБРАТЬ
	|	Регистратор
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет
	|ГДЕ
	|	Активность
	|	И	ТИПЗНАЧЕНИЯ(Регистратор) = ТИП(Документ.ВводНачальныхОстатков)
	|СГРУППИРОВАТЬ ПО
	|	Регистратор
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ПервоначальнаяСуммаАмортизации) > 0
	|;";
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	ИмяСобытия = НСтр("ru='Данные. Изменение'");
	
	ТекстыСообщений = Новый Структура();
	ТекстыСообщений.Вставить("ТекстОшибки",							НСтр("ru='Ошибка при обработке движений (%1) - Очистка поля ПервоначальнаяСуммаАмортизации в движениях по рег.свед. ПервоначальныеСведенияОСБухгалтерскийУчет'"));
	ТекстыСообщений.Вставить("ИтогоОбъектовОбработаноУспешно",		НСтр("ru='Итого успешно обработаны движения %1 документа(ов) - Очистка поля ПервоначальнаяСуммаАмортизации в движениях по рег.свед. ПервоначальныеСведенияОСБухгалтерскийУчет'"));
	ТекстыСообщений.Вставить("ИтогоОбъектовОбработаноСОшибкой",		НСтр("ru='Итого ошибок при обработке движений: %1 - Очистка поля ПервоначальнаяСуммаАмортизации в движениях по рег.свед. ПервоначальныеСведенияОСБухгалтерскийУчет'"));
	ТекстыСообщений.Вставить("ИтогоОбъектыОбработкиОтсутствуют",	НСтр("ru='Движений, подлежащих обработке, не обнаружено - Очистка поля ПервоначальнаяСуммаАмортизации в движениях по рег.свед. ПервоначальныеСведенияОСБухгалтерскийУчет'"));
	
	Статистика = Новый Структура();
	Статистика.Вставить("ОбъектовВсего",				Выборка.Количество());
	Статистика.Вставить("ОбъектовОбработаноУспешно",	0);
	Статистика.Вставить("ОбъектовОбработаноСОшибкой",	0);
	
	ОчищающаяСтруктура = Новый Структура();
	ОчищающаяСтруктура.Вставить("ПервоначальнаяСуммаАмортизации", 0);
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			НаборЗаписей = РегистрыСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор["Регистратор"].Значение = Выборка["Регистратор"];
			НаборЗаписей.Прочитать();
			
			Для Каждого Запись Из НаборЗаписей Цикл
				ЗаполнитьЗначенияСвойств(Запись, ОчищающаяСтруктура);
			КонецЦикла;
			
			НаборЗаписей.Записать();
			
			Статистика["ОбъектовОбработаноУспешно"] = Статистика["ОбъектовОбработаноУспешно"] + 1;
		Исключение
			Статистика["ОбъектовОбработаноСОшибкой"] = Статистика["ОбъектовОбработаноСОшибкой"] + 1;
			
			ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстыСообщений["ТекстОшибки"],
				Строка(Выборка["Регистратор"]) + ". " + ИнформацияОбОшибке);
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				,									// объект метаданных
				,									// данные
				Комментарий);						// комментарий
		КонецПопытки;
		
	КонецЦикла;
	
	// Итоговые сообщения в журнале регистрации
	
	Если Статистика["ОбъектовВсего"] = 0 Тогда
		Комментарий = ТекстыСообщений["ИтогоОбъектыОбработкиОтсутствуют"];
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если Статистика["ОбъектовОбработаноУспешно"] > 0 Тогда
		Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ТекстыСообщений["ИтогоОбъектовОбработаноУспешно"],
			Строка(Статистика["ОбъектовОбработаноУспешно"]));
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если Статистика["ОбъектовОбработаноСОшибкой"] > 0 Тогда
		Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ТекстыСообщений["ИтогоОбъектовОбработаноСОшибкой"],
			Строка(Статистика["ОбъектовОбработаноСОшибкой"]));
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Ошибка,		// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
КонецПроцедуры

Процедура ИсправитьДвиженияПоРегиструРасчетыСоСтудентами_2_0_44(ПараметрыОтложенногоОбработчика = Неопределено) Экспорт
	
	Перем ОписаниеПоследнейОшибки;
	
	//	----------------+-------------------+-----------------------
	//	Что отражаем	|Сейчас				|Должно быть
	//					|(до исправления)	|(после исправления)
	//	----------------+-------------------+-----------------------
	//	Задолженность	|Приход -Сумма		|Приход +Сумма
	//	----------------+-------------------+-----------------------
	//	Переплата		|Приход +Сумма		|Расход +Сумма
	//	----------------+-------------------+-----------------------
	
	ЭтоОтложенноеВыполнение = (ТипЗнч(ПараметрыОтложенногоОбработчика) = Тип("Структура"));
	
	НаименованиеОбработки	= НСтр("ru='Исправление движений документов ВводНачальныхОстатков по регистру РасчетыСоСтудентами'");
	РегистрироватьВсеОшибки	= Истина; // Регистрируем либо все ошибки, либо только одну, последнюю, чтобы не раздувать журнал регистрации
	
	ИмяСобытия				= НСтр("ru='Данные. Изменение'");
	ШаблонОшибкаБлокировки	= НСтр("ru='Не удалось заблокировать данные - [НаименованиеОбработки]. [ОписаниеОшибки]'");
	ШаблонОшибкаЗаписи		= НСтр("ru='Ошибка при записи движений для документа [ПредставлениеДокумента]: [ОписаниеОшибки] - [НаименованиеОбработки]'");
	ШаблонПоследняяОшибка	= НСтр("ru='Последняя возникшая ошибка: [ОписаниеОшибки] - [НаименованиеОбработки]'");
	ШаблонИтогоНеТребуется	= НСтр("ru='Не требуется обработка - [НаименованиеОбработки]'");
	ШаблонИтогоУспехов		= НСтр("ru='Итого успешно создано движений документов: [КоличествоДокументов] - [НаименованиеОбработки]'");
	ШаблонИтогоОшибок		= НСтр("ru='Итого ошибок при обработке документов: [КоличествоДокументов] - [НаименованиеОбработки]'");
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Краткая характеристика потенциальных документов
	|//
	|ВЫБРАТЬ
	|	Ссылка										КАК Ссылка,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА СуммаЗадолженность > 0 ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ)										КАК ИмеетсяЗадолженность,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА СуммаПереплата > 0 ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ)										КАК ИмеетсяПереплата
	|ПОМЕСТИТЬ
	|	ПотенциальныеДокументы
	|ИЗ
	|	Документ.ВводНачальныхОстатков.Студенты	КАК Студенты
	|ГДЕ
	|	Ссылка.Проведен
	|	И	Ссылка.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.Студенты)
	|СГРУППИРОВАТЬ ПО
	|	Ссылка
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Краткая характеристика движений потенциальных документов
	|//
	|ВЫБРАТЬ
	|	Регистратор									КАК Регистратор,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			И СуммаВзаиморасчетов > 0 ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ)										ОтраженоНечто,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			И СуммаВзаиморасчетов < 0 ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ)										ОтраженаЗадолженностьПоСтарому,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|			И СуммаВзаиморасчетов > 0 ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ)										ОтраженаПереплатаПоНовому
	|ПОМЕСТИТЬ
	|	ДвиженияПотенциальныхДокументов
	|ИЗ
	|	РегистрНакопления.РасчетыСоСтудентами
	|ГДЕ
	|	Регистратор В (ВЫБРАТЬ	Ссылка	ИЗ	ПотенциальныеДокументы)
	|СГРУППИРОВАТЬ ПО
	|	Регистратор
	|ИНДЕКСИРОВАТЬ ПО
	|	Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Документы, требующие корректировки движений
	|//
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ДокументыТребующиеКорректировки
	|ИЗ
	|	ПотенциальныеДокументы
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ДвиженияПотенциальныхДокументов
	|		ПО	ПотенциальныеДокументы.Ссылка = ДвиженияПотенциальныхДокументов.Регистратор
	|ГДЕ
	|	ПотенциальныеДокументы.ИмеетсяЗадолженность И ДвиженияПотенциальныхДокументов.ОтраженаЗадолженностьПоСтарому
	|	И НЕ (ПотенциальныеДокументы.ИмеетсяПереплата И ДвиженияПотенциальныхДокументов.ОтраженаПереплатаПоНовому)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	ПотенциальныеДокументы
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ДвиженияПотенциальныхДокументов
	|		ПО	ПотенциальныеДокументы.Ссылка = ДвиженияПотенциальныхДокументов.Регистратор
	|ГДЕ
	|	ПотенциальныеДокументы.ИмеетсяПереплата И ДвиженияПотенциальныхДокументов.ОтраженоНечто
	|	И НЕ (ПотенциальныеДокументы.ИмеетсяПереплата И ДвиженияПотенциальныхДокументов.ОтраженаПереплатаПоНовому)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Новые движения по регистру РасчетыСоСтудентами
	|//		Эти движения идентичны движениям, формируемым при проведении документа,
	|//		см. Документ.ВводНачальныхОстатков.ИнициализироватьДанныеДокумента_Студенты
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ
	|	Ссылка							КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(Ссылка)			КАК ПредставлениеДокумента,
	|	ВЫБОР
	|		КОГДА СуммаПереплата > 0 ТОГДА
	|			ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|		КОГДА СуммаЗадолженность > 0 ТОГДА
	|			ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	КОНЕЦ							КАК ВидДвижения,
	|	Ссылка.Дата						КАК Период,
	|	Ссылка.Организация				КАК Организация,
	|	Ссылка.Факультет				КАК Факультет,
	|	Студент							КАК Студент,
	|	Контрагент						КАК Контрагент,
	|	Договор							КАК	ДоговорКонтрагента,
	|	Ссылка.ВалютаДокумента			КАК ВалютаВзаиморасчетов,
	|	ВЫБОР
	|		КОГДА СуммаПереплата > 0 ТОГДА
	|			СуммаПереплата
	|		КОГДА СуммаЗадолженность > 0 ТОГДА
	|			СуммаЗадолженность
	|	КОНЕЦ							КАК СуммаВзаиморасчетов,
	|	ВЫБОР
	|		КОГДА СуммаПереплата > 0 ТОГДА
	|			СуммаПереплата		* ВЫБОР КОГДА Ссылка.Кратность = 0 ТОГДА 0 ИНАЧЕ Ссылка.Курс/Ссылка.Кратность КОНЕЦ
	|		КОГДА СуммаЗадолженность > 0 ТОГДА
	|			СуммаЗадолженность	* ВЫБОР КОГДА Ссылка.Кратность = 0 ТОГДА 0 ИНАЧЕ Ссылка.Курс/Ссылка.Кратность КОНЕЦ
	|	КОНЕЦ							КАК СуммаРегл,
	|	Ссылка.ВидПервичногоДокумента	КАК ВидПервичногоДокумента,
	|	Ссылка.Дата						КАК ДатаПервичногоДокумента,
	|	Ссылка.Номер					КАК НомерПервичногоДокумента
	|ИЗ
	|	Документ.ВводНачальныхОстатков.Студенты	КАК Студенты
	|ГДЕ
	|	Ссылка В (ВЫБРАТЬ	Ссылка	ИЗ ДокументыТребующиеКорректировки)
	|	И	(СуммаЗадолженность > 0 ИЛИ СуммаПереплата > 0)
	|ИТОГИ ПО
	|	Ссылка
	|;";
	
	РезультатПоиска = ЗапросПоиск.Выполнить();
	
	ВыборкаГруппировкаПоСсылка = РезультатПоиска.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СчетчикИтогоКоличество	= ВыборкаГруппировкаПоСсылка.Количество();
	СчетчикИтогоУспехов		= 0;
	СчетчикИтогоОшибок		= 0;
	
	Если СчетчикИтогоКоличество = 0 Тогда
		Если ЭтоОтложенноеВыполнение Тогда
			ПараметрыОтложенногоОбработчика.Вставить("ОбработкаЗавершена", Истина);
		КонецЕсли;
		
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("НаименованиеОбработки",	НаименованиеОбработки);
		
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонИтогоНеТребуется, ВставляемыеЗначения);
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
			
		// Выходим
		Возврат;
	КонецЕсли;
	
	Если ЭтоОтложенноеВыполнение Тогда
		
		НачатьТранзакцию();
		
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.РасчетыСоСтудентами.НаборЗаписей");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.ИсточникДанных = РезультатПоиска;
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Регистратор", "Ссылка");
			Блокировка.Заблокировать();
		Исключение
			// Не удалось заблокировать необходимые данные
			
			ОтменитьТранзакцию();
			
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("НаименованиеОбработки",	НаименованиеОбработки);
			ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОшибкаБлокировки, ВставляемыеЗначения);
			
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				,									// объект метаданных
				,									// данные
				Комментарий);						// комментарий
				
			// Выходим
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	
	// Формируем заново движения по регистру для выбранных документов
	Пока ВыборкаГруппировкаПоСсылка.Следующий() Цикл
		
		ДокументСсылка = ВыборкаГруппировкаПоСсылка["Ссылка"];
		
		НаборЗаписей = РегистрыНакопления.РасчетыСоСтудентами.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ДокументСсылка);
		НаборЗаписей.Записывать = Истина;
		
		Выборка = ВыборкаГруппировкаПоСсылка.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НовоеДвижение = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(НовоеДвижение, Выборка);
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
			
			СчетчикИтогоУспехов = СчетчикИтогоУспехов + 1;
		Исключение
			СчетчикИтогоОшибок = СчетчикИтогоОшибок + 1;
			
			ОписаниеПоследнейОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			Если РегистрироватьВсеОшибки Тогда
				ВставляемыеЗначения = Новый Структура();
				ВставляемыеЗначения.Вставить("НаименованиеОбработки",	НаименованиеОбработки);
				ВставляемыеЗначения.Вставить("ПредставлениеДокумента",	ВыборкаГруппировкаПоСсылка["ПредставлениеДокумента"]);
				ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ОписаниеПоследнейОшибки);
				
				Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОшибкаЗаписи, ВставляемыеЗначения);
				
				ЗаписьЖурналаРегистрации(
					ИмяСобытия,								// имя события
					УровеньЖурналаРегистрации.Ошибка,		// уровень
					,										// объект метаданных
					,										// данные
					Комментарий);							// комментарий
			КонецЕсли;
			
			Если ЭтоОтложенноеВыполнение Тогда
				ОтменитьТранзакцию();
				
				// Регистрируем последнюю ошибку (перед выходом)
				Если НЕ РегистрироватьВсеОшибки Тогда
					ВставляемыеЗначения = Новый Структура();
					ВставляемыеЗначения.Вставить("НаименованиеОбработки",	НаименованиеОбработки);
					ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ОписаниеПоследнейОшибки);
					
					Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонПоследняяОшибка, ВставляемыеЗначения);
					
					ЗаписьЖурналаРегистрации(
						ИмяСобытия,								// имя события
						УровеньЖурналаРегистрации.Ошибка,		// уровень
						,										// объект метаданных
						,										// данные
						Комментарий);							// комментарий
				КонецЕсли;
				
				// Выходим
				ВызватьИсключение;
			КонецЕсли;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Если ЭтоОтложенноеВыполнение Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
	Если СчетчикИтогоУспехов > 0 Тогда
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("НаименованиеОбработки",	НаименованиеОбработки);
		ВставляемыеЗначения.Вставить("КоличествоДокументов",	СчетчикИтогоУспехов);
		
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонИтогоУспехов, ВставляемыеЗначения);
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если СчетчикИтогоОшибок > 0 Тогда
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("НаименованиеОбработки",	НаименованиеОбработки);
		ВставляемыеЗначения.Вставить("КоличествоДокументов",	СчетчикИтогоОшибок);
		
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонИтогоОшибок, ВставляемыеЗначения);
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Ошибка,		// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
			
		// Регистрируем последнюю ошибку (перед выходом)
		Если НЕ РегистрироватьВсеОшибки Тогда
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("НаименованиеОбработки",	НаименованиеОбработки);
			ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ОписаниеПоследнейОшибки);
			
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонПоследняяОшибка, ВставляемыеЗначения);
			
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,								// имя события
				УровеньЖурналаРегистрации.Ошибка,		// уровень
				,										// объект метаданных
				,										// данные
				Комментарий);							// комментарий
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Заменяет раздел учета в документах в связи с добавлением нового документа ввода остатков ОС.
Процедура ЗаменитьРазделУчета_2_0_48(ПараметрыОтложенногоОбработчика = Неопределено) Экспорт
	
	Перем	ЭтоОтложенноеВыполнение,
			ЭтоПервоеОтложенноеВыполнение,
			
			// Статистика обработки
			СчетчикДокументовОК,
			СчетчикДокументовОшибка;
	
	// Настройки массовой обработки документов (каждого вида)
	КоличествоДокументовОбрабатываемыхМонопольноСтрока			= "500";
	КоличествоДокументовОбрабатываемыхВИтерацииОтложенноСтрока	= "500";
	
	// Обрабатываем один вид документов
	ИмяДокумента		= "ВводНачальныхОстатков";
	СинонимДокумента	= НСтр("ru='Ввод начальных остатков ОС, НМА, НПА, ИК, на забалансовых счетах'");
	
	// Тексты сообщений для вывода в журнал регистрации
	ОбозначениеОбработки				= "#ЗаменаРазделаУчета";
	ИмяСобытия							= НСтр("ru='Данные. Изменение'");
	ШаблонДокументОшибка				= НСтр("ru='[ОбозначениеОбработки] - Ошибка при обработке документа [ДокументСсылка] ([ОписаниеОшибки]) [РежимЗапуска]'");
	ШаблонОбщийОтсутствуютСчета			= НСтр("ru='[ОбозначениеОбработки] - В плане счетов отсутствуют счета [СписокСчетов] [РежимЗапуска]'");
	ШаблонОбщийОтсутствуютДанные		= НСтр("ru='[ОбозначениеОбработки] - Отсутствуют документы [СинонимДокумента], подлежащие обработке [РежимЗапуска]'");
	ШаблонОбщийОшибкаБлокировки			= НСтр("ru='[ОбозначениеОбработки] - Не удалось заблокировать документы [СинонимДокумента] для модификации ([ОписаниеОшибки]) [РежимЗапуска]'");
	ШаблонОбщийКоличествоУспехов		= НСтр("ru='[ОбозначениеОбработки] - Успешно обработано [Количество] документов [СинонимДокумента] [РежимЗапуска]'");
	ШаблонОбщийКоличествоНеобработанных	= НСтр("ru='[ОбозначениеОбработки] - Осталось [Количество] необработанных документов [СинонимДокумента] [РежимЗапуска]'");
	
	// Используемые вставляемые значения
	//	[ДокументСсылка]
	//	[Количество]
	//	[ОбозначениеОбработки]
	//	[ОписаниеОшибки]
	//	[РежимЗапуска]
	//	[СинонимДокумента]
	
	// Статистика обработки
	СчетчикДокументовОК					= 0;
	СчетчикДокументовОшибка				= 0;
	
	ЭтоОтложенноеВыполнение = (ТипЗнч(ПараметрыОтложенногоОбработчика) = Тип("Структура"));
	
	ЭтоПервоеОтложенноеВыполнение = (ЭтоОтложенноеВыполнение И ПараметрыОтложенногоОбработчика.Количество() = 0);
	
	Если ЭтоОтложенноеВыполнение Тогда
		// Свойства от БСП
		Если НЕ ПараметрыОтложенногоОбработчика.Свойство("ПрогрессВыполнения") Тогда
			ПараметрыОтложенногоОбработчика.Вставить("ПрогрессВыполнения", Новый Структура());
			ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"].Вставить("ВсегоОбъектов",			0);
			ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"].Вставить("ОбработаноОбъектов",	0);
		КонецЕсли;
		
		// Свойства этого обработчика
		Если НЕ ПараметрыОтложенногоОбработчика.Свойство("НомерЗапуска") Тогда
			ПараметрыОтложенногоОбработчика.Вставить("НомерЗапуска", 1);
		Иначе
			ПараметрыОтложенногоОбработчика["НомерЗапуска"] = ПараметрыОтложенногоОбработчика["НомерЗапуска"] + 1;
		КонецЕсли;
		Если НЕ ПараметрыОтложенногоОбработчика.Свойство("УспешноОбработанныеДокументы") Тогда
			ПараметрыОтложенногоОбработчика.Вставить("УспешноОбработанныеДокументы", Новый Массив());
		КонецЕсли;
		
		РежимЗапускаСтрока = СтрЗаменить("(отложенный запуск, [НомерЗапуска])",
			"[НомерЗапуска]",
			Строка(ПараметрыОтложенногоОбработчика["НомерЗапуска"]));
		
		ТекстПервыеN = КоличествоДокументовОбрабатываемыхВИтерацииОтложенноСтрока;
	Иначе
		РежимЗапускаСтрока = "(монопольный запуск)";
		
		ТекстПервыеN = КоличествоДокументовОбрабатываемыхМонопольноСтрока;
	КонецЕсли;
	
	// Требуется наличие некоторых счетов в плане счетов.
	// Если такие счета не найдены, прерываем эту обработку.
	КодыСчетов = Новый Массив();
	КодыСчетов.Добавить("108.56");
	КодыСчетов.Добавить("01");
	КодыСчетов.Добавить("02.1");
	КодыСчетов.Добавить("22.1");
	ЗапросСчета = Новый Запрос();
	ЗапросСчета.УстановитьПараметр("КодыСчетов", КодыСчетов);
	ЗапросСчета.Текст = "
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Код = ""108.56"" ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ	КАК ДляИмуществаКазныМЗ,
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Код В(&КодыСчетов)";
	ТаблицаСчетов = ЗапросСчета.Выполнить().Выгрузить();
	
	Поиск = Новый Структура("ДляИмуществаКазныМЗ", Истина);
	СчетаДляРазделаУчетаИмуществоКазныМЗ = ТаблицаСчетов.Скопировать(Поиск).ВыгрузитьКолонку("Ссылка");
	ИскатьДокументыИмуществоКазны = (СчетаДляРазделаУчетаИмуществоКазныМЗ.Количество() > 0);
	
	Поиск = Новый Структура("ДляИмуществаКазныМЗ", Ложь);
	СчетаДляРазделаУчетаОсновныеСредстваНаЗабалансе = ТаблицаСчетов.Скопировать(Поиск).ВыгрузитьКолонку("Ссылка");
	ИскатьДокументыОсновныеСредстваВОперативномУчете = (СчетаДляРазделаУчетаОсновныеСредстваНаЗабалансе.Количество() > 0);
	
	Если НЕ ИскатьДокументыИмуществоКазны И НЕ ИскатьДокументыОсновныеСредстваВОперативномУчете Тогда
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
		ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
		ВставляемыеЗначения.Вставить("СписокСчетов",			СтрСоединить(КодыСчетов, ", "));
		
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийОтсутствуютСчета, ВставляемыеЗначения);
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
		
		// Выходим
		Возврат;
	КонецЕсли;
	
	// Здесь все входные проверки выполнены успешно
	// Выполняем замену разделов учета
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("СчетаДляРазделаУчетаИмуществоКазныМЗ",				СчетаДляРазделаУчетаИмуществоКазныМЗ);
	ЗапросЗаполнение.УстановитьПараметр("СчетаДляРазделаУчетаОсновныеСредстваНаЗабалансе",	СчетаДляРазделаУчетаОсновныеСредстваНаЗабалансе);
	ЗапросЗаполнение.УстановитьПараметр("ИскатьДокументыИмуществоКазны",					ИскатьДокументыИмуществоКазны);
	ЗапросЗаполнение.УстановитьПараметр("ИскатьДокументыОсновныеСредстваВОперативномУчете",	ИскатьДокументыОсновныеСредстваВОперативномУчете);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Все документы ввода остатков, требующие обработки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка																	КАК Ссылка,
	|	Дата																	КАК Дата,
	|	ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.ИмуществоКазныМЗ)	КАК НовоеЗначениеРазделаУчета
	|ПОМЕСТИТЬ
	|	ВсеДокументы
	|ИЗ
	|	Документ.ВводНачальныхОстатков	КАК Док
	|ГДЕ
	|	&ИскатьДокументыИмуществоКазны
	|	И	НЕ ПометкаУдаления
	|	И	РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.ИмуществоКазны)
	|	И	Счет В ИЕРАРХИИ(&СчетаДляРазделаУчетаИмуществоКазныМЗ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Ссылка																			КАК Ссылка,
	|	Дата																			КАК Дата,
	|	ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе)	КАК НовоеЗначениеРазделаУчета
	|ИЗ
	|	Документ.ВводНачальныхОстатков	КАК Док
	|ГДЕ
	|	&ИскатьДокументыОсновныеСредстваВОперативномУчете
	|	И	НЕ ПометкаУдаления
	|	И	РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете)
	|	И	Счет В ИЕРАРХИИ(&СчетаДляРазделаУчетаОсновныеСредстваНаЗабалансе)
	|;		
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Документы ввода остатков, требующие обработки
	|//		при очередном запуске обработчика обновления
	|//		(Финальная таблица для дальнейшей обработки)
	|//
	|ВЫБРАТЬ ПЕРВЫЕ " + ТекстПервыеN + "
	|	Ссылка						КАК Ссылка,
	|	НовоеЗначениеРазделаУчета	КАК НовоеЗначениеРазделаУчета
	|ИЗ
	|	ВсеДокументы
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Общее количество документов, подлежащих обработке
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ
	|	ЕСТЬNULL(КОЛИЧЕСТВО(*), 0)	КАК КоличествоДокументов
	|ИЗ
	|	ВсеДокументы
	|;";
	
	Результаты = ЗапросЗаполнение.ВыполнитьПакет();
	
	// [2]. Общее количество документов, подлежащих обработке
	Выборка = Результаты[2].Выбрать();
	КоличествоДокументов = 0;
	Пока Выборка.Следующий() Цикл
		КоличествоДокументов = Выборка["КоличествоДокументов"];
		Прервать;
	КонецЦикла;
	
	Если КоличествоДокументов = 0 Тогда
		// Отсутствуют объекты для обработки
		
		Если ЭтоОтложенноеВыполнение Тогда
			// Свойства от БСП
			ПараметрыОтложенногоОбработчика.Вставить("ОбработкаЗавершена", Истина);
		КонецЕсли;
		
		// Сообщение "Документов, подлежащих обработке, не обнаружено"
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
		ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
		ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийОтсутствуютДанные, ВставляемыеЗначения);
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
		
		// Выходим
		Возврат;
	КонецЕсли;
	
	Если ЭтоПервоеОтложенноеВыполнение Тогда
		ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ВсегоОбъектов"] = КоличествоДокументов;
	КонецЕсли;
	
	// [1]. Документы ввода остатков, требующие обработки
	РезультатЗапроса = Результаты[1];
	
	// Блокировка данных (только при отложенной обработке)
	Если ЭтоОтложенноеВыполнение Тогда
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		
		ЭлементБлокировки					= Блокировка.Добавить("Документ." + ИмяДокумента);
		ЭлементБлокировки.Режим				= РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных	= РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			// Не удалось заблокировать необходимые документы
			ОтменитьТранзакцию();
			
			// Сообщение "Ошибка блокировки"
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
			ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
			ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
			ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийОшибкаБлокировки, ВставляемыеЗначения);
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				,									// объект метаданных
				,									// данные
				Комментарий);						// комментарий
				
			// Сообщение "Осталось N необработанных документов"
			Количество = ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ВсегоОбъектов"]
				- ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"];
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
			ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
			ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
			ВставляемыеЗначения.Вставить("Количество",				Количество);
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийКоличествоНеобработанных, ВставляемыеЗначения);
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,								// имя события
				УровеньЖурналаРегистрации.Информация,	// уровень
				,										// объект метаданных
				,										// данные
				Комментарий);							// комментарий
				
			// Выходим
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	
	// Собственно заполнение реквизитов
	ВыборкаДокумент = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДокумент.Следующий() Цикл
		Попытка
			ДокументОбъект = ВыборкаДокумент["Ссылка"].ПолучитьОбъект();
			Если ДокументОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			// Заменяем раздел учета в документе
			ДокументОбъект["РазделУчета"] = ВыборкаДокумент["НовоеЗначениеРазделаУчета"];
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			
			// Статистика обработки
			СчетчикДокументовОК				= СчетчикДокументовОК + 1;
			
			Если ЭтоОтложенноеВыполнение Тогда
				ПараметрыОтложенногоОбработчика["УспешноОбработанныеДокументы"].Добавить(ВыборкаДокумент["Ссылка"]);
				ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"] =
					ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"] + 1;
			КонецЕсли;
			
		Исключение
			ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			// Статистика обработки
			СчетчикДокументовОшибка				= СчетчикДокументовОшибка + 1;
			
			// Сообщение "Ошибка при обработке документа D"
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
			ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
			ВставляемыеЗначения.Вставить("ДокументСсылка",			ВыборкаДокумент["Ссылка"]);
			ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
			ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ОписаниеОшибки);
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонДокументОшибка, ВставляемыеЗначения);
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				,									// объект метаданных
				,									// данные
				Комментарий);						// комментарий
				
			Если ЭтоОтложенноеВыполнение Тогда
				ОтменитьТранзакцию();
				
				// Сообщение "Осталось N необработанных документов"
				Количество = ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ВсегоОбъектов"]
					- ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"];
				ВставляемыеЗначения = Новый Структура();
				ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
				ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
				ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
				ВставляемыеЗначения.Вставить("Количество",				Количество);
				Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийКоличествоНеобработанных, ВставляемыеЗначения);
				ЗаписьЖурналаРегистрации(
					ИмяСобытия,								// имя события
					УровеньЖурналаРегистрации.Информация,	// уровень
					,										// объект метаданных
					,										// данные
					Комментарий);							// комментарий
				
				// Выходим
				ВызватьИсключение;
			КонецЕсли;
		КонецПопытки;
		
	КонецЦикла;
	
	// Итоговые сообщения в журнале регистрации по каждому виду документов
	
	Если СчетчикДокументовОК > 0 Тогда
		// Сообщение "Количество успешно обработанных документов вида V: N"
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
		ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
		ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
		ВставляемыеЗначения.Вставить("Количество",				Строка(СчетчикДокументовОК));
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийКоличествоУспехов, ВставляемыеЗначения);
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если СчетчикДокументовОшибка > 0 Тогда
		// Сообщение "Количество необработанных документов вида V: N"
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
		ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
		ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
		ВставляемыеЗначения.Вставить("Количество",				Строка(СчетчикДокументовОшибка));
		ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ОписаниеОшибки);
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийКоличествоНеобработанных, ВставляемыеЗначения);
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если ЭтоОтложенноеВыполнение Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры

// Заменяет раздел учета ОСВОперУчете -> ОСНаЗабалансе, если счет 01, 02.1, 22.1 (исправление прежней ошибки выгрузки)
Процедура ЗаменитьРазделУчетаОСВОперативномУчете_2_0_52(ПараметрыОтложенногоОбработчика = Неопределено) Экспорт
	
	Перем	ЭтоОтложенноеВыполнение,
			ЭтоПервоеОтложенноеВыполнение,
			
			// Статистика обработки
			СчетчикДокументовОК,
			СчетчикДокументовОшибка;
	
	// Настройки массовой обработки документов (каждого вида)
	КоличествоДокументовОбрабатываемыхМонопольноСтрока			= "500";
	КоличествоДокументовОбрабатываемыхВИтерацииОтложенноСтрока	= "500";
	
	// Обрабатываем один вид документов
	ИмяДокумента		= "ВводНачальныхОстатков";
	СинонимДокумента	= НСтр("ru='Ввод начальных остатков ОС'");
	
	// Тексты сообщений для вывода в журнал регистрации
	ОбозначениеОбработки				= "#ЗаменаРазделаУчета  (опер.учет -> забаланс)";
	ИмяСобытия							= НСтр("ru='Данные. Изменение'");
	ШаблонДокументОшибка				= НСтр("ru='[ОбозначениеОбработки] - Ошибка при обработке документа [ДокументСсылка] ([ОписаниеОшибки]) [РежимЗапуска]'");
	ШаблонОбщийОтсутствуютДанные		= НСтр("ru='[ОбозначениеОбработки] - Отсутствуют документы [СинонимДокумента], подлежащие обработке [РежимЗапуска]'");
	ШаблонОбщийОшибкаБлокировки			= НСтр("ru='[ОбозначениеОбработки] - Не удалось заблокировать документы [СинонимДокумента] для модификации ([ОписаниеОшибки]) [РежимЗапуска]'");
	ШаблонОбщийКоличествоУспехов		= НСтр("ru='[ОбозначениеОбработки] - Успешно обработано [Количество] документов [СинонимДокумента] [РежимЗапуска]'");
	ШаблонОбщийКоличествоНеобработанных	= НСтр("ru='[ОбозначениеОбработки] - Осталось [Количество] необработанных документов [СинонимДокумента] [РежимЗапуска]'");
	
	// Используемые вставляемые значения
	//	[ДокументСсылка]
	//	[Количество]
	//	[ОбозначениеОбработки]
	//	[ОписаниеОшибки]
	//	[РежимЗапуска]
	//	[СинонимДокумента]
	
	// Статистика обработки
	СчетчикДокументовОК					= 0;
	СчетчикДокументовОшибка				= 0;
	
	ЭтоОтложенноеВыполнение = (ТипЗнч(ПараметрыОтложенногоОбработчика) = Тип("Структура"));
	
	ЭтоПервоеОтложенноеВыполнение = (ЭтоОтложенноеВыполнение И ПараметрыОтложенногоОбработчика.Количество() = 0);
	
	Если ЭтоОтложенноеВыполнение Тогда
		// Свойства от БСП
		Если НЕ ПараметрыОтложенногоОбработчика.Свойство("ПрогрессВыполнения") Тогда
			ПараметрыОтложенногоОбработчика.Вставить("ПрогрессВыполнения", Новый Структура());
			ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"].Вставить("ВсегоОбъектов",			0);
			ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"].Вставить("ОбработаноОбъектов",	0);
		КонецЕсли;
		
		// Свойства этого обработчика
		Если НЕ ПараметрыОтложенногоОбработчика.Свойство("НомерЗапуска") Тогда
			ПараметрыОтложенногоОбработчика.Вставить("НомерЗапуска", 1);
		Иначе
			ПараметрыОтложенногоОбработчика["НомерЗапуска"] = ПараметрыОтложенногоОбработчика["НомерЗапуска"] + 1;
		КонецЕсли;
		Если НЕ ПараметрыОтложенногоОбработчика.Свойство("УспешноОбработанныеДокументы") Тогда
			ПараметрыОтложенногоОбработчика.Вставить("УспешноОбработанныеДокументы", Новый Массив());
		КонецЕсли;
		
		РежимЗапускаСтрока = СтрЗаменить("(отложенный запуск, [НомерЗапуска])",
			"[НомерЗапуска]",
			Строка(ПараметрыОтложенногоОбработчика["НомерЗапуска"]));
		
		ТекстПервыеN = КоличествоДокументовОбрабатываемыхВИтерацииОтложенноСтрока;
	Иначе
		РежимЗапускаСтрока = "(монопольный запуск)";
		
		ТекстПервыеN = КоличествоДокументовОбрабатываемыхМонопольноСтрока;
	КонецЕсли;
	
	МассивСчетов = БухгалтерскийУчет.СписокСчетов("01,02.1,22.1", Ложь); // с учетом иерархии
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("МассивСчетов", МассивСчетов);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Все документы ввода остатков, требующие обработки
	|//
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка,
	|	Дата	КАК Дата
	|ПОМЕСТИТЬ
	|	ВсеДокументы
	|ИЗ
	|	Документ.ВводНачальныхОстатков	КАК Док
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И	РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете)
	|	И	Счет В (&МассивСчетов)
	|;		
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Документы ввода остатков, требующие обработки
	|//		при очередном запуске обработчика обновления
	|//		(Финальная таблица для дальнейшей обработки)
	|//
	|ВЫБРАТЬ ПЕРВЫЕ " + ТекстПервыеN + "
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	ВсеДокументы
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Общее количество документов, подлежащих обработке
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ
	|	ЕСТЬNULL(КОЛИЧЕСТВО(*), 0)	КАК КоличествоДокументов
	|ИЗ
	|	ВсеДокументы
	|;";
	
	Результаты = ЗапросЗаполнение.ВыполнитьПакет();
	
	// [2]. Общее количество документов, подлежащих обработке
	Выборка = Результаты[2].Выбрать();
	КоличествоДокументов = 0;
	Пока Выборка.Следующий() Цикл
		КоличествоДокументов = Выборка["КоличествоДокументов"];
		Прервать;
	КонецЦикла;
	
	Если КоличествоДокументов = 0 Тогда
		// Отсутствуют объекты для обработки
		
		// Сообщение "Документов, подлежащих обработке, не обнаружено"
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
		ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
		ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
		
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийОтсутствуютДанные, ВставляемыеЗначения);
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
		
		// Выходим
		Возврат;
		
	Иначе
		// Есть документы для обработки
		
		// Свойства от БСП
		Если ЭтоОтложенноеВыполнение Тогда
			ПараметрыОтложенногоОбработчика.Вставить("ОбработкаЗавершена", Ложь);
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоПервоеОтложенноеВыполнение Тогда
		ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ВсегоОбъектов"] = КоличествоДокументов;
	КонецЕсли;
	
	// [1]. Документы ввода остатков, требующие обработки
	РезультатЗапроса = Результаты[1];
	
	// Блокировка данных (только при отложенной обработке)
	Если ЭтоОтложенноеВыполнение Тогда
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		
		ЭлементБлокировки					= Блокировка.Добавить("Документ." + ИмяДокумента);
		ЭлементБлокировки.Режим				= РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных	= РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			// Не удалось заблокировать необходимые документы
			ОтменитьТранзакцию();
			
			// Сообщение "Ошибка блокировки"
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
			ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
			ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
			ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийОшибкаБлокировки, ВставляемыеЗначения);
			
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				,									// объект метаданных
				,									// данные
				Комментарий);						// комментарий
				
			// Сообщение "Осталось N необработанных документов"
			Количество = ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ВсегоОбъектов"]
				- ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"];
				
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
			ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
			ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
			ВставляемыеЗначения.Вставить("Количество",				Количество);
			
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийКоличествоНеобработанных, ВставляемыеЗначения);
			
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,								// имя события
				УровеньЖурналаРегистрации.Информация,	// уровень
				,										// объект метаданных
				,										// данные
				Комментарий);							// комментарий
				
			// Выходим
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	
	// Собственно заполнение реквизитов
	ВыборкаДокумент = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДокумент.Следующий() Цикл
		Попытка
			ДокументОбъект = ВыборкаДокумент["Ссылка"].ПолучитьОбъект();
			Если ДокументОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			// Заменяем раздел учета в документе
			ДокументОбъект["РазделУчета"] = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе;
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			
			// Статистика обработки
			СчетчикДокументовОК				= СчетчикДокументовОК + 1;
			
			Если ЭтоОтложенноеВыполнение Тогда
				ПараметрыОтложенногоОбработчика["УспешноОбработанныеДокументы"].Добавить(ВыборкаДокумент["Ссылка"]);
				ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"] =
					ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"] + 1;
			КонецЕсли;
			
		Исключение
			ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			// Статистика обработки
			СчетчикДокументовОшибка				= СчетчикДокументовОшибка + 1;
			
			// Сообщение "Ошибка при обработке документа D"
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
			ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
			ВставляемыеЗначения.Вставить("ДокументСсылка",			ВыборкаДокумент["Ссылка"]);
			ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
			ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ОписаниеОшибки);
			
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонДокументОшибка, ВставляемыеЗначения);
			
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				,									// объект метаданных
				,									// данные
				Комментарий);						// комментарий
				
			Если ЭтоОтложенноеВыполнение Тогда
				ОтменитьТранзакцию();
				
				// Сообщение "Осталось N необработанных документов"
				Количество = ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ВсегоОбъектов"]
					- ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"];
				ВставляемыеЗначения = Новый Структура();
				ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
				ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
				ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
				ВставляемыеЗначения.Вставить("Количество",				Количество);
				
				Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийКоличествоНеобработанных, ВставляемыеЗначения);
				
				ЗаписьЖурналаРегистрации(
					ИмяСобытия,								// имя события
					УровеньЖурналаРегистрации.Информация,	// уровень
					,										// объект метаданных
					,										// данные
					Комментарий);							// комментарий
				
				// Выходим
				ВызватьИсключение;
			КонецЕсли;
		КонецПопытки;
		
	КонецЦикла;
	
	// Итоговые сообщения в журнале регистрации по каждому виду документов
	
	Если СчетчикДокументовОК > 0 Тогда
		// Сообщение "Количество успешно обработанных документов вида V: N"
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
		ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
		ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
		ВставляемыеЗначения.Вставить("Количество",				Строка(СчетчикДокументовОК));
		
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийКоличествоУспехов, ВставляемыеЗначения);
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если СчетчикДокументовОшибка > 0 Тогда
		// Сообщение "Количество необработанных документов вида V: N"
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
		ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
		ВставляемыеЗначения.Вставить("СинонимДокумента",		СинонимДокумента);
		ВставляемыеЗначения.Вставить("Количество",				Строка(СчетчикДокументовОшибка));
		ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ОписаниеОшибки);
		
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийКоличествоНеобработанных, ВставляемыеЗначения);
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если ЭтоОтложенноеВыполнение Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры

//---
// КЭК0
//---

Функция НеобходимоИзменитьЗначениеКЭК(Организация, ИФО, КФО, ДатаДокумента, Счет, ТекущееЗначениеКЭК, ДтКт = "Дт", ВозвратИспользоватьКЭК0 = Неопределено, ВозвратНовоеЗначениеКЭК = Неопределено) Экспорт
	
	ВозвратИспользоватьКЭК0 = ИспользоватьКЭК0(Организация, ИФО, КФО, ДатаДокумента, Счет);
	
	Если ВозвратИспользоватьКЭК0 Тогда
		ВозвратНовоеЗначениеКЭК = БухгалтерскийУчетПовтИсп.КЭК0();
	Иначе
		ВозвратНовоеЗначениеКЭК = ПолучитьКОСГУПоУмолчанию(Счет, ДтКт, ТекущееЗначениеКЭК);
	КонецЕсли;
	
	Возврат НЕ (ТекущееЗначениеКЭК = ВозвратНовоеЗначениеКЭК);
	
КонецФункции
Функция ИспользоватьКЭК0(Организация, ИФО, КФО, ДатаДокумента, Счет) Экспорт
	
	ТипКЭКПоУчетнойПолитике = БухгалтерскийУчетПовтИсп.ТипКЭКПоУчетнойПолитике(Организация, ИФО, КФО, ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(ДатаДокумента));
	
	Если	ТипКЭКПоУчетнойПолитике = Перечисления.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация
		ИЛИ	ТипКЭКПоУчетнойПолитике = Перечисления.ТипыАналитическихПризнаков.КлассификацияАУБУ
		Тогда
		Результат = Истина;
	Иначе
		ЭтоКонецГода = ((Месяц(ДатаДокумента) = 12) И (День(ДатаДокумента) = 31));
		Результат = (ЭтоКонецГода И ЭтоСчетСОборотнымКЭК(Счет));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
Функция ЭтоСчетСОборотнымКЭК(СчетСсылка)
	
	Возврат НЕ (БухгалтерскийУчетПовтИсп.СчетаСОборотнымКЭК().Найти(СчетСсылка) = Неопределено);
	
КонецФункции

//---
// Проверка заполнения
//---

Функция ДанныеДокументаКорректны(ДокументОбъект) Экспорт
	
	// Сведения о пакете проверок, выполняемом после проверки заполненности обязательных реквизитов:
	Перем ПакетПроверок;
	Перем ЗапросПакетПроверок;
	Перем ИндексПоследнегоЗапроса;
	
	Перем	РезультатПроверкиРежимВводаОстатков,
			РезультатПроверкиОбязательныеРеквизитыЗаполнены;
	
	// Общая статистика:
	СтатистикаОбщая = Новый Структура();
	СтатистикаОбщая.Вставить("КоличествоОшибок",			0);
	СтатистикаОбщая.Вставить("КоличествоСообщенныхОшибок",	0);
	СтатистикаОбщая.Вставить("КоличествоОшибокИзвестно",	Истина); // может быть Ложь при пропуске длительных ручных проверок
	СтатистикаОбщая.Вставить("СчетчикСообщений",			0);
	СтатистикаОбщая.Вставить("ОтказОтЗаписи",				Ложь);
	СтатистикаОбщая.Вставить("ОтказОтВыводаСообщений",		Ложь);
	
	МаксКолвоСообщений	= 20;
	МаксДлинаСообщения	= 200;
	ДокСсылка	= ДокументОбъект["Ссылка"];
	РазделУчета	= ДокументОбъект["РазделУчета"];
	
	// Сначала - корректность режима ввода остатков:
	Если	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства
		ИЛИ	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Материалы
		ИЛИ	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны
		Тогда
		
		Если НЕ РежимВводаОстатков_ОбработкаПроверкиЗаполнения(ДокументОбъект, РезультатПроверкиРежимВводаОстатков) Тогда
			// Выходим:
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	// Заполненность обязательных реквизитов:
	Если НЕ ОбязательныеРеквизитыЗаполнены(ДокументОбъект, МаксКолвоСообщений, РезультатПроверкиОбязательныеРеквизитыЗаполнены) Тогда
		СтатистикаОбщая["КоличествоОшибок"] = СтатистикаОбщая["КоличествоОшибок"] + РезультатПроверкиОбязательныеРеквизитыЗаполнены["КоличествоОшибок"];
		СтатистикаОбщая["СчетчикСообщений"] = СтатистикаОбщая["СчетчикСообщений"] + РезультатПроверкиОбязательныеРеквизитыЗаполнены["СчетчикСообщений"];
		
		ТекстСообщения = НСтр("ru='Дальнейшие обязательные проверки данных документа не выполнялись из-за наличия незаполненных реквизитов документа'");
		
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			ДокСсылка);
			
		// Выходим:
		Возврат Ложь;
		
	КонецЕсли;
	
	// Здесь обязательные реквизиты заполнены.
	// Выполняем прочие проверки данных документа.
	
	Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства Тогда
		//
		// Раздел учета "Основные средства"
		//
		
		РезультатПроверки = Неопределено;
		РежимВводаОстатков_ПроверитьЗаполнение(ДокументОбъект, РезультатПроверки);
		Режим = РезультатПроверки["ПрименяемыйРежимВводаОстатков"];
		ОтражатьВБухУчете		= Режим["ОтражатьВБухУчете"];
		ОтражатьВНалУчетеОСН	= Режим["ОтражатьВНалУчетеОСН"];
		
		// Инициализируем пакет проверок:
		ИменаТаблЧастей = Новый Массив();
		ИменаТаблЧастей.Добавить("ОС_Основная");
		ИменаТаблЧастей.Добавить("ОС_Амортизация");
		ИменаТаблЧастей.Добавить("ОС_Общая");
		ИменаТаблЧастей.Добавить("КапРемонтОС");
		ИменаТаблЧастей.Добавить("МодернизацияОС");
		ИменаТаблЧастей.Добавить("ПереоценкаНФА");
		ПакетПроверок_Инициализировать(ДокументОбъект, ИменаТаблЧастей, ЗапросПакетПроверок, ПакетПроверок, ИндексПоследнегоЗапроса);
		
		//
		// Проверки, выполняемые при любом состоянии флажков режима ввода остатков.
		//
		
		// Дубли ОС:
		ПакетПроверок_ДобавитьПакетнуюПроверку("ОсновныеСредства.Дубли ОС",
			ТекстЗапроса_ПроверкаЗаполнения_ДублиОС(),
			ПакетПроверок,
			ЗапросПакетПроверок,
			ИндексПоследнегоЗапроса,
			Истина,	// Отказ от записи
			Ложь);	// Отказ от вывода сообщений следующих проверок
		
		// Различные ручные проверки по каждой строке таблицы "ОС Общая":
		ПакетПроверок_ДобавитьПакетнуюПроверку("ОсновныеСредства.Проверка по строке ОС",
			ТекстЗапроса_ПроверкаЗаполнения_ПроверкаПоСтрокеОС(),
			ПакетПроверок,
			ЗапросПакетПроверок,
			ИндексПоследнегоЗапроса,
			Истина,	// Отказ от записи
			Ложь);	// Отказ от вывода сообщений следующих проверок
		
		
		//
		// Проверки, выполняемые только при установленном флажке "Бух.Учет"
		//
		Если ОтражатьВБухУчете Тогда
			
			// Наличие счета и КЭК амортизации:
			ПакетПроверок_ДобавитьПакетнуюПроверку("ОсновныеСредства.Наличие счета и КЭК амортизации",
				ТекстЗапроса_ПроверкаЗаполнения_НаличиеСчетаИКЭКАмортизации(),
				ПакетПроверок,
				ЗапросПакетПроверок,
				ИндексПоследнегоЗапроса,
				Истина,	// Отказ от записи
				Ложь);	// Отказ от вывода сообщений следующих проверок
			
			// Дубли ИнвНомеров:
			ПакетПроверок_ДобавитьПакетнуюПроверку("ОсновныеСредства.Дубли ИнвНомеров",
				ТекстЗапроса_ПроверкаЗаполнения_ДублиИнвНомеров(),
				ПакетПроверок,
				ЗапросПакетПроверок,
				ИндексПоследнегоЗапроса,
				Истина,	// Отказ от записи
				Ложь);	// Отказ от вывода сообщений следующих проверок
			
			// Различные первоначальные стоимости (БУ):
			ПакетПроверок_ДобавитьПакетнуюПроверку("ОсновныеСредства.Различные первоначальные стоимости",
				ТекстЗапроса_ПроверкаЗаполнения_РазличныеПервоначальныеСтоимости(),
				ПакетПроверок,
				ЗапросПакетПроверок,
				ИндексПоследнегоЗапроса,
				Истина,	// Отказ от записи
				Ложь);	// Отказ от вывода сообщений следующих проверок
			
			// Наличие уже введенных остатков по ОС:
			// Дополнительно настроим общий пакет запросов:
			ПараметрыЗапроса = Новый Структура("ТекДата, СчетОС, Организация",
				ДокументОбъект.МоментВремени(),
				ДокументОбъект["Счет"],
				ДокументОбъект["Организация"]);
			Для Каждого Элем Из ПараметрыЗапроса Цикл
				ЗапросПакетПроверок.УстановитьПараметр(Элем.Ключ, Элем.Значение);
			КонецЦикла;
			ПакетПроверок_ДобавитьПакетнуюПроверку("ОсновныеСредства.Наличие уже введенных остатков по ОС",
				ТекстЗапроса_ПроверкаЗаполнения_НаличиеОстатковПоОС(ДокументОбъект),
				ПакетПроверок,
				ЗапросПакетПроверок,
				ИндексПоследнегоЗапроса,
				Истина,	// Отказ от записи
				Истина);// Отказ от вывода сообщений следующих проверок
				
				
			// Табличные части "Капремонт", "Модернизация", "Переоценка"
			
			// Капремонт: Дубли строк:
			ПакетПроверок_ДобавитьПакетнуюПроверку("ОсновныеСредства.Капремонт.Дубли строк",
				ТекстЗапроса_ПроверкаЗаполнения_Капремонт_ДублиСтрок(),
				ПакетПроверок,
				ЗапросПакетПроверок,
				ИндексПоследнегоЗапроса,
				Истина,	// Отказ от записи
				Ложь);	// Отказ от вывода сообщений следующих проверок
			// Капремонт: ОС с групповым учетом:
			ПакетПроверок_ДобавитьПакетнуюПроверку("ОсновныеСредства.Капремонт.ОС с групповым учетом",
				ТекстЗапроса_ПроверкаЗаполнения_Капремонт_ОССГрупповымУчетом(),
				ПакетПроверок,
				ЗапросПакетПроверок,
				ИндексПоследнегоЗапроса,
				Истина,	// Отказ от записи
				Ложь);	// Отказ от вывода сообщений следующих проверок
			// Капремонт: ОС, отсутствующие в таблице "ОС Основная":
			ПакетПроверок_ДобавитьПакетнуюПроверку("ОсновныеСредства.Капремонт.ОС, отсутствующие в основной таблице",
				ТекстЗапроса_ПроверкаЗаполнения_Капремонт_ОСОтсутствуютВОсновнойТаблице(),
				ПакетПроверок,
				ЗапросПакетПроверок,
				ИндексПоследнегоЗапроса,
				Истина,	// Отказ от записи
				Ложь);	// Отказ от вывода сообщений следующих проверок
			
			// Модернизация: Дубли строк:
			ПакетПроверок_ДобавитьПакетнуюПроверку("ОсновныеСредства.Модернизация.Дубли строк",
				ТекстЗапроса_ПроверкаЗаполнения_Модернизация_ДублиСтрок(),
				ПакетПроверок,
				ЗапросПакетПроверок,
				ИндексПоследнегоЗапроса,
				Истина,	// Отказ от записи
				Ложь);	// Отказ от вывода сообщений следующих проверок
			// Модернизация: ОС, отсутствующие в таблице "ОС Основная":
			ПакетПроверок_ДобавитьПакетнуюПроверку("ОсновныеСредства.Модернизация.ОС, отсутствующие в основной таблице",
				ТекстЗапроса_ПроверкаЗаполнения_Модернизация_ОСОтсутствуютВОсновнойТаблице(),
				ПакетПроверок,
				ЗапросПакетПроверок,
				ИндексПоследнегоЗапроса,
				Истина,	// Отказ от записи
				Ложь);	// Отказ от вывода сообщений следующих проверок
			// Модернизация: ОС с групповым учетом:
			ПакетПроверок_ДобавитьПакетнуюПроверку("ОсновныеСредства.Модернизация.ОС с групповым учетом",
