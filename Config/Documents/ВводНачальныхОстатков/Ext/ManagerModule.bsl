Функция ЕстьОшибкиЗаполнения_Студенты(ДокументОбъект) Экспорт
	
	МаксДлинаСообщения = 200;
	ЕстьОшибкиЗаполнения = Ложь;
	
	ТабЧастьСтуденты = ДокументОбъект["Студенты"].Выгрузить();
	
	// Настраиваем запрос:
	ЗапросПроверка = Новый Запрос();
	ЗапросПроверка.УстановитьПараметр("ТЧ",			ТабЧастьСтуденты);
	ЗапросПроверка.УстановитьПараметр("ДокСсылка",	ДокументОбъект["Ссылка"]); // для исключения возможных движений самого этого документа при определении зачисления студентов.
	ЗапросПроверка.УстановитьПараметр("ТекДата",	ДокументОбъект["Дата"]);
	ЗапросПроверка.УстановитьПараметр("Факультет",	ДокументОбъект["Факультет"]);
	ЗапросПроверка.УстановитьПараметр("ГруппаСтудентов",	ДокументОбъект["ГруппаСтудентов"]);
	ЗапросПроверка.УстановитьПараметр("КурсОбучения",		ДокументОбъект["КурсОбучения"]);
	ЗапросПроверка.УстановитьПараметр("СостояниеСтудента",	РаботаСоСтудентамиПовтИсп.ПолучитьСостоянияПоВидуДействия(Истина));
	
	ЗапросПроверка.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// Комментарий
	|//	Проверка заполнения таблицы ""Студенты"", документ ""Ввод начальных остатков по студентам"".
	|//
	|//	Индекс		Выполняемая
	|//	результата	проверка
	|//	1			Незаполненные поля
	|//	3			Дубли строк по студенту и договору
	|//	5			Уже зачисленные в Факультет, Курс, Группу на дату документа студенты
	|//
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Исходные проверяемые данные табличной части документа
	|//		!!! При переносе в код, заменить на загрузку из таблицы значений !!!
	|ВЫБРАТЬ
	|	ТЧ.НомерСтроки			КАК НомерСтроки,
	|	ТЧ.Студент				КАК Студент,
	|	ТЧ.Контрагент			КАК Контрагент,
	|	ТЧ.Договор				КАК Договор,
	|	ТЧ.СуммаЗадолженность	КАК СуммаЗадолженность,
	|	ТЧ.СуммаПереплата		КАК СуммаПереплата
	|ПОМЕСТИТЬ
	|	ТаблЧасть_Студенты
	|ИЗ
	|	&ТЧ	КАК ТЧ
	//|ИЗ
	//|	Документ.ВводНачальныхОстатков.Студенты	КАК ТЧ
	//|ГДЕ
	//|	Ссылка = &ДокСсылка
	|ИНДЕКСИРОВАТЬ ПО
	|	Студент,
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Незаполненные поля
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	""Студент""		КАК ИмяПоляДляВыводаСообщений,
	|	НомерСтроки		КАК НомерСтроки
	|ИЗ
	|	ТаблЧасть_Студенты
	|ГДЕ
	|	Студент = ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Контрагент""	КАК ИмяПоляДляВыводаСообщений,
	|	НомерСтроки		КАК НомерСтроки
	|ИЗ
	|	ТаблЧасть_Студенты
	|ГДЕ
	|	Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Договор""		КАК ИмяПоляДляВыводаСообщений,
	|	НомерСтроки		КАК НомерСтроки
	|ИЗ
	|	ТаблЧасть_Студенты
	|ГДЕ
	|	Договор = ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. (Подготовка) Количество дублей строк
	|//		(Дубли строк по студенту и договору)
	|ВЫБРАТЬ
	|	Студент					КАК Студент,
	|	Контрагент				КАК Контрагент,
	|	Договор					КАК Договор,
	|	Количество(НомерСтроки)	КАК КолвоДублей
	|ПОМЕСТИТЬ
	|	ДублиСтрок
	|ИЗ
	|	ТаблЧасть_Студенты
	|ГДЕ
	|	НЕ Студент = ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка)
	|	И НЕ Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	И НЕ Договор = ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО
	|	Студент,
	|	Контрагент,
	|	Договор
	|ИМЕЮЩИЕ
	|	Количество(НомерСтроки) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Дубли строк по студенту и договору
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	ДублиСтрок.Студент		КАК Студент,
	|	ДублиСтрок.Контрагент	КАК Контрагент,
	|	ДублиСтрок.Договор		КАК Договор,
	|	Студенты.НомерСтроки	КАК НомерСтроки
	|ИЗ
	|	ДублиСтрок
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ТаблЧасть_Студенты	КАК Студенты
	|		ПО	Студенты.Студент = ДублиСтрок.Студент
	|		И	Студенты.Контрагент = ДублиСтрок.Контрагент
	|		И	Студенты.Договор = ДублиСтрок.Договор
	|УПОРЯДОЧИТЬ ПО
	|	Студенты.НомерСтроки
	|ИТОГИ
	|	МИНИМУМ(НомерСтроки)	КАК НомерСтроки
	|ПО
	|	ДублиСтрок.Студент,
	|	ДублиСтрок.Контрагент,
	|	ДублиСтрок.Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. (Подготовка) Уже имеющиеся остатки по указанным студентам
	|//		(Уже зачисленные в Факультет, Курс, Группу на дату документа студенты)
	|ВЫБРАТЬ
	|	СведенияОСтудентах.Студент			КАК Студент,
	|	СведенияОСтудентах.Регистратор		КАК СуществующийДокумент,
	|	
	|	СУММА(ВЫБОР
	|		КОГДА СведенияОСтудентах.Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.Курс)
	|			И СведенияОСтудентах.Значение = &КурсОбучения ТОГДА
	|			1
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)						КАК КоличествоСовпавших_КурсОбучения, // 1
	|	СУММА(ВЫБОР
	|		КОГДА СведенияОСтудентах.Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.Группа)
	|			И СведенияОСтудентах.Значение = &ГруппаСтудентов ТОГДА
	|			1
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)						КАК КоличествоСовпавших_ГруппаОбучения, // 2
	|	СУММА(ВЫБОР
	|		КОГДА СведенияОСтудентах.Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СостояниеСтудента)
	|			И СведенияОСтудентах.Значение В (&СостояниеСтудента) ТОГДА
	|			1
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)						КАК КоличествоСовпавших_СостояниеСтудента // 3
	|ПОМЕСТИТЬ
	|	ТекущиеОстатки
	|ИЗ
	|	РегистрСведений.СведенияОСтудентах.СрезПоследних(
	|		&ТекДата,
	|		Факультет = &Факультет
	|		И НЕ Регистратор = &ДокСсылка
	|		И Студент В
	|			(ВЫБРАТЬ
	|				Студент
	|			ИЗ
	|				ТаблЧасть_Студенты)
	|		) КАК СведенияОСтудентах
	|СГРУППИРОВАТЬ ПО
	|	СведенияОСтудентах.Студент,
	|	СведенияОСтудентах.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Уже зачисленные в Факультет, Курс, Группу на дату документа студенты
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	ТаблЧасть_Студенты.НомерСтроки								КАК НомерСтроки,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ТекущиеОстатки.СуществующийДокумент)	КАК СуществующийДокумент
	|	
	|ИЗ
	|	ТекущиеОстатки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ТаблЧасть_Студенты
	|		ПО	ТекущиеОстатки.Студент = ТаблЧасть_Студенты.Студент
	|		И	(ТекущиеОстатки.КоличествоСовпавших_КурсОбучения
	|			+ ТекущиеОстатки.КоличествоСовпавших_ГруппаОбучения
	|			+ ТекущиеОстатки.КоличествоСовпавших_СостояниеСтудента = 3)
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";
	
	// Выполняем запросы:
	РезультатыПроверок = ЗапросПроверка.ВыполнитьПакет();
	
	// Выводим сообщения:
	ИмяТаблЧастиДляВыводаСообщений = "Студенты";
	Реквизиты = ДокументОбъект.Метаданные().ТабличныеЧасти[ИмяТаблЧастиДляВыводаСообщений].Реквизиты;
	СинонимыПолей = Новый Соответствие();
	Для Каждого Реквизит Из Реквизиты Цикл
		СинонимыПолей.Вставить(Реквизит.Имя, Реквизит.Синоним);
	КонецЦикла;
	
	// 1. Незаполненные поля.
	РезультатПроверки = РезультатыПроверок[1];
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		Текст = НСтр("ru='Поле ""%1"" не заполнено (таблица ""Учащиеся"", строка %2)'");
		ТЗРезультат = РезультатПроверки.Выгрузить();
		Для Каждого СтрокаТЗ Из ТЗРезультат Цикл
			
			НомерСтроки = СтрокаТЗ["НомерСтроки"];
			ИмяПоля = СтрокаТЗ["ИмяПоляДляВыводаСообщений"];
			ИмяПоляДляВыводаСообщений = ИмяПоля;
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
				СинонимыПолей.Получить(ИмяПоля),
				НомерСтроки);
				
			ИндексСтроки = НомерСтроки - 1;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
		КонецЦикла;
	КонецЕсли;
	
	// 2. % оплаты.
	Если Не ДокументОбъект.НачислениеУчащимсяЗаПрочиеУслуги Тогда
		
		Для Каждого СтрокаСтуденты Из ТабЧастьСтуденты Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаСтуденты.ДоляОплаты) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Поле ""% оплаты"" не заполнено (таблица ""Учащиеся"", строка %1). Начисления за услуги образования (доходы текущего периода) по данному договору (плательщику) рассчитываться не будут.'"),
						СтрокаСтуденты.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект["Ссылка"],
					"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + Формат(СтрокаСтуденты.НомерСтроки - 1, "ЧГ=0") + "].ДоляОплаты");
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// 3. Дубли строк по студенту, контрагенту и договору.
	РезультатПроверки = РезультатыПроверок[3];
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		Текст = НСтр("ru='Дубли строк по учащемуся, контрагенту (плательщику) и договору (таблица ""Учащиеся"", строки %1)'");
		ИмяПоляДляВыводаСообщений = "НомерСтроки";
		ДЗРезультат = РезультатПроверки.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		// Обход по Студенту:
		Для Каждого СтрокаСтудент Из ДЗРезультат.Строки Цикл
			// Обход по Контрагенту:
			Для Каждого СтрокаКонтрагент Из СтрокаСтудент.Строки Цикл
			// Обход по Договору:
			Для Каждого СтрокаДоговор Из СтрокаКонтрагент.Строки Цикл
				НомераСтрок = СтрокаДоговор.Строки.ВыгрузитьКолонку("НомерСтроки");
				ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(Текст, НомераСтрок, МаксДлинаСообщения, "%1");
				
				ИндексСтроки = СтрокаДоговор["НомерСтроки"] - 1;
				
				ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
				
				ОбщегоНазначения.СообщитьПользователю(
					ТекстСообщения,
					ДокументОбъект["Ссылка"],
					"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
				
			КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	// 4. Уже зачисленные в Факультет, Курс, Группу на дату документа студенты.
	Если ДокументОбъект["ПринятьДетейВГруппу"] Тогда
		РезультатПроверки = РезультатыПроверок[5];
		Если НЕ РезультатПроверки.Пустой() Тогда
			ЕстьОшибкиЗаполнения = Истина;
			Текст = НСтр("ru='Учащийся уже зачислен на факультет, курс и в группу документом ""%1"" (таблица ""Учащиеся"", строка %2)'");
			ИмяПоляДляВыводаСообщений = "Студент";
			
			ТЗРезультат = РезультатПроверки.Выгрузить();
			Для Каждого СтрокаТЗ Из ТЗРезультат Цикл
				
				НомерСтроки = СтрокаТЗ["НомерСтроки"];
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
					СтрокаТЗ["СуществующийДокумент"],
					НомерСтроки);
				
				ИндексСтроки = НомерСтроки - 1;
				
				ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
				
				ОбщегоНазначения.СообщитьПользователю(
					ТекстСообщения,
					ДокументОбъект["Ссылка"],
					"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ДатаСрезаУчетнойПолитики = ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(ДокументОбъект.Дата);
	ПлательщикНалогаНаПрибыль = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(
		ДокументОбъект.Организация, ДатаСрезаУчетнойПолитики);
	
	ЭтоНачислениеПоДолгосрочнымДоговорам =
		(ДокументОбъект.ВидОперацииНачисленияУчащимся = ПредопределенноеЗначение("Перечисление.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам"));
	
	Если ЭтоНачислениеПоДолгосрочнымДоговорам Тогда
		
		// Проверка заполнения порядка учета доходов.
		Для Каждого СтрокаТаблицы Из ТабЧастьСтуденты Цикл
			
			// Параметры списания доходов будущих периодов.
			Если СтрокаТаблицы.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам
			 ИЛИ СтрокаТаблицы.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаНачалаСписания) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Дата начала списания'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Учащиеся'"));
					ПолеОшибки = ИмяТаблЧастиДляВыводаСообщений + "[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДатаНачалаСписания";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, ПолеОшибки, "Объект", ЕстьОшибкиЗаполнения);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаОкончанияСписания) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Дата окончания списания'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Учащиеся'"));
					ПолеОшибки = ИмяТаблЧастиДляВыводаСообщений + "[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДатаОкончанияСписания";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, ПолеОшибки, "Объект", ЕстьОшибкиЗаполнения);
				КонецЕсли;
				
				Если НЕ ЕстьОшибкиЗаполнения И СтрокаТаблицы.ДатаОкончанияСписания < СтрокаТаблицы.ДатаНачалаСписания Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
						НСтр("ru = 'Дата окончания списания'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Учащиеся'"),
						НСтр("ru = 'Дата начала списания превышает дату окончания.'"));
					ПолеОшибки = ИмяТаблЧастиДляВыводаСообщений + "[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДатаОкончанияСписания";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, ПолеОшибки, "Объект", ЕстьОшибкиЗаполнения);
				КонецЕсли;
				
			КонецЕсли;
			
			// Проверим счет и аналитику доходов будущих периодов.
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетДоходов) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru = 'Счет доходов'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Счет доходов'"));
				ПолеОшибки = ИмяТаблЧастиДляВыводаСообщений + "[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СчетДоходов";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, ПолеОшибки, "Объект", ЕстьОшибкиЗаполнения);
			Иначе
				РеквизитыСчетаДоходов = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
					"СчетДоходов", "СубконтоДоходов1", "СубконтоДоходов2", "СубконтоДоходов3");
				БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитикиВСтрокеТабЧасти(СтрокаТаблицы, РеквизитыСчетаДоходов,
					ДокументОбъект, "Студенты", ЕстьОшибкиЗаполнения);
			КонецЕсли;
			
			Если ПлательщикНалогаНаПрибыль Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ВидДеятельностиНУ) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Вид деятельности (НУ)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Учащиеся'"));
					ПолеОшибки = ИмяТаблЧастиДляВыводаСообщений + "[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ВидДеятельностиНУ";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, ПолеОшибки, "Объект", ЕстьОшибкиЗаполнения);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетДоходовНУ) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Счет доходов (НУ)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Учащиеся'"));
					ПолеОшибки = ИмяТаблЧастиДляВыводаСообщений + "[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СчетДоходовНУ";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, ПолеОшибки, "Объект", ЕстьОшибкиЗаполнения);
					Продолжить;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СтатьяПрочихДоходовНУ)
					И БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.СчетДоходовНУ, "Н91.01") Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Статья прочих доходов (НУ)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Учащиеся'"));
					ПолеОшибки = ИмяТаблЧастиДляВыводаСообщений + "[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СтатьяПрочихДоходовНУ";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, ПолеОшибки, "Объект", ЕстьОшибкиЗаполнения);
				КонецЕсли;
				
			КонецЕсли;
			
			// Проверим корректность заполнения таблицы "Порядок оплаты".
			ОтборПоИдентификатору = Новый Структура("ИдентификаторСтроки", СтрокаТаблицы.ИдентификаторСтроки);
			ПорядокОплатыПоСтуденту = ДокументОбъект.ПорядокОплатыОбразование.Выгрузить(ДокументОбъект.ПорядокОплатыОбразование.НайтиСтроки(ОтборПоИдентификатору));
			ПорядокОплатыПоСтуденту.Сортировать("ОплатитьДо,НачалоПериода,КонецПериода");
			ЕстьНеоплаченныеЗавершенныеПериоды = Ложь;
			Для Каждого СтрокаПорядокОплаты Из ПорядокОплатыПоСтуденту Цикл
				
				ПериодЗавершен = ( КонецДня(СтрокаПорядокОплаты.КонецПериода) <= КонецДня(ДокументОбъект.Дата) );
				ЕстьНеоплаченныеЗавершенныеПериоды = ЕстьНеоплаченныеЗавершенныеПериоды ИЛИ (ПериодЗавершен И Не СтрокаПорядокОплаты.Оплачено);
				ЕстьОплаченныеНезавершенныеПериоды = Не ПериодЗавершен И СтрокаПорядокОплаты.Оплачено;
				Если ЕстьНеоплаченныеЗавершенныеПериоды И ЕстьОплаченныеНезавершенныеПериоды Тогда
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Некорректно заполнена таблица ""Порядок оплаты"" (колонка ""Оплачено"") по учащемуся ""%1"".
						|Не допускается наличие завершенных неоплаченных периодов обучения, при наличии незавершенных оплаченных периодов. Скорректируйте порядок оплаты.'"),
						СтрокаТаблицы.Студент);
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект.Ссылка, "ПорядокОплаты", "Объект", ЕстьОшибкиЗаполнения);
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		// Разный порядок учета доходов в строках по одному договору.
		КолонкиСвертки = "Договор, СпособПризнанияДоходов,ДатаНачалаСписания,ДатаОкончанияСписания,
			|СчетДоходов,СубконтоДоходов1,СубконтоДоходов2,СубконтоДоходов3,ВидДеятельностиНУ,СчетДоходовНУ,СтатьяПрочихДоходовНУ";
		ДублиТабЧастьСтуденты = ТабЧастьСтуденты.Скопировать(, КолонкиСвертки);
		ДублиТабЧастьСтуденты.Свернуть(КолонкиСвертки);
		ДублиТабЧастьСтуденты.Колонки.Добавить("КоличествоСтрок", Новый ОписаниеТипов("Число"));
		ДублиТабЧастьСтуденты.ЗаполнитьЗначения(1, "КоличествоСтрок");
		ДублиТабЧастьСтуденты.Свернуть("Договор", "КоличествоСтрок");
		Для Каждого СтрокаДоговор Из ДублиТабЧастьСтуденты Цикл
			Если ЗначениеЗаполнено(СтрокаДоговор.Договор) И СтрокаДоговор.КоличествоСтрок > 1 Тогда
				ЕстьОшибкиЗаполнения = Истина;
				Отбор = Новый Структура("Договор", СтрокаДоговор.Договор);
				НайденныеСтроки = ТабЧастьСтуденты.НайтиСтроки(Отбор);
				ИндексСтрокиТекст = "0";
				НомераСтрок = "";
				Для Каждого СтрокаСОшибкой Из НайденныеСтроки Цикл
					ИндексСтрокиТекст = ?(ИндексСтрокиТекст = "0", Формат(СтрокаСОшибкой.НомерСтроки - 1, "ЧГ=0"), ИндексСтрокиТекст);
					НомераСтрок = НомераСтрок + ?(СтрДлина(НомераСтрок)>0, ",", "") + СтрокаСОшибкой.НомерСтроки;
				КонецЦикла;
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='По договору ""%1"" в нескольких строках установлен разный порядок учета доходов (таблица ""Учащиеся"", строки %2)'"),
						СтрокаДоговор.Договор, НомераСтрок);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,
					"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "].Договор");
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// Разные ставки оплаты, льготы в строках по одному студенту и договору.
	Если НЕ ДокументОбъект.НачислениеУчащимсяЗаПрочиеУслуги И НЕ ЭтоНачислениеПоДолгосрочнымДоговорам Тогда
		
		КолонкиСвертки = "Студент,Договор,СтавкаОплаты,Льгота";
		ДублиТабЧастьСтуденты = ТабЧастьСтуденты.Скопировать(, КолонкиСвертки);
		ДублиТабЧастьСтуденты.Свернуть(КолонкиСвертки);
		ДублиТабЧастьСтуденты.Колонки.Добавить("КоличествоСтрок", Новый ОписаниеТипов("Число"));
		ДублиТабЧастьСтуденты.ЗаполнитьЗначения(1, "КоличествоСтрок");
		ДублиТабЧастьСтуденты.Свернуть("Студент,Договор", "КоличествоСтрок");
		Для Каждого СтрокаСтудентДоговор Из ДублиТабЧастьСтуденты Цикл
			Если ЗначениеЗаполнено(СтрокаСтудентДоговор.Студент) И ЗначениеЗаполнено(СтрокаСтудентДоговор.Договор) И СтрокаСтудентДоговор.КоличествоСтрок > 1 Тогда
				ЕстьОшибкиЗаполнения = Истина;
				Отбор = Новый Структура("Студент,Договор", СтрокаСтудентДоговор.Студент, СтрокаСтудентДоговор.Договор);
				НайденныеСтроки = ТабЧастьСтуденты.НайтиСтроки(Отбор);
				ИндексСтрокиТекст = "0";
				НомераСтрок = "";
				Для Каждого СтрокаСОшибкой Из НайденныеСтроки Цикл
					ИндексСтрокиТекст = ?(ИндексСтрокиТекст = "0", Формат(СтрокаСОшибкой.НомерСтроки - 1, "ЧГ=0"), ИндексСтрокиТекст);
					НомераСтрок = НомераСтрок + ?(СтрДлина(НомераСтрок)>0, ",", "") + СтрокаСОшибкой.НомерСтроки;
				КонецЦикла;
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='По студенту ""%1"" и договору ""%2"" в нескольких строках установлены разные ставки оплаты и(или) льготы (таблица ""Учащиеся"", строки %3)'"),
						СтрокаСтудентДоговор.Студент, СтрокаСтудентДоговор.Договор, НомераСтрок);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,
					"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "].Студент");
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// Дубли строк в таблице "Поля приказов".
	Если НЕ ДокументОбъект.НачислениеУчащимсяЗаПрочиеУслуги И ДокументОбъект.СведенияОСтудентах.Количество() > 0 Тогда
		
		ТабЧастьПоляПриказов = ДокументОбъект.СведенияОСтудентах.Выгрузить();
		
		КолонкиСвертки = "Поле,Значение";
		ДублиТабЧастьПоляПриказов = ТабЧастьПоляПриказов.Скопировать(, КолонкиСвертки);
		ДублиТабЧастьПоляПриказов.Свернуть(КолонкиСвертки);
		ДублиТабЧастьПоляПриказов.Колонки.Добавить("КоличествоСтрок", Новый ОписаниеТипов("Число"));
		ДублиТабЧастьПоляПриказов.ЗаполнитьЗначения(1, "КоличествоСтрок");
		ДублиТабЧастьПоляПриказов.Свернуть("Поле", "КоличествоСтрок");
		Для Каждого СтрокаПолеПриказа Из ДублиТабЧастьПоляПриказов Цикл
			Если СтрокаПолеПриказа.КоличествоСтрок > 1 Тогда
				ЕстьОшибкиЗаполнения = Истина;
				Отбор = Новый Структура("Поле", СтрокаПолеПриказа.Поле);
				НайденныеСтроки = ТабЧастьПоляПриказов.НайтиСтроки(Отбор);
				ИндексСтрокиТекст = "0";
				НомераСтрок = "";
				Для Каждого СтрокаСОшибкой Из НайденныеСтроки Цикл
					ИндексСтрокиТекст = ?(ИндексСтрокиТекст = "0", Формат(СтрокаСОшибкой.НомерСтроки - 1, "ЧГ=0"), ИндексСтрокиТекст);
					НомераСтрок = НомераСтрок + ?(СтрДлина(НомераСтрок)>0, ",", "") + СтрокаСОшибкой.НомерСтроки;
				КонецЦикла;
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Для поля ""%1"" в нескольких строках установлены разные значения (таблица ""Сведения об учащихся"", строки %2)'"),
						СтрокаПолеПриказа.Поле, НомераСтрок);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,
					"Объект.СведенияОСтудентах[" + ИндексСтрокиТекст + "].Поле");
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента_Студенты(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	
	// Подготовка:
	ШапкаДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"ВидОперацииНачисленияУчащимся,НачислениеУчащимсяЗаПрочиеУслуги,ВалютаДокумента,Курс,Кратность,КурсОбучения,ГруппаСтудентов");
	Если НЕ ЗначениеЗаполнено(ШапкаДокумента["ВалютаДокумента"])
		ИЛИ ШапкаДокумента["ВалютаДокумента"] = Константы.ВалютаРегламентированногоУчета.Получить() Тогда
		Курс		= 1;
		Кратность	= 1;
	Иначе
		Курс		= ШапкаДокумента["Курс"];
		Кратность	= ШапкаДокумента["Кратность"];
	КонецЕсли;
	
	// Настраиваем запрос:
	Запросы = Новый Запрос;
	Запросы.УстановитьПараметр("Ссылка",			ДокументСсылка);
	Запросы.УстановитьПараметр("КурсОбучения",		ШапкаДокумента.КурсОбучения);
	Запросы.УстановитьПараметр("Группа",			ШапкаДокумента.ГруппаСтудентов);
	Запросы.УстановитьПараметр("Курс",				Курс);
	Запросы.УстановитьПараметр("Кратность",			Кратность);
	Запросы.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Устанавливаемые этим документом значения полей
	|// Поле Курс:
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Студенты.Студент															КАК Студент,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.Курс)				КАК Поле,
	|	&КурсОбучения																КАК Значение
	|ПОМЕСТИТЬ
	|	ЗначенияПолей
	|ИЗ
	|	Документ.ВводНачальныхОстатков.Студенты	КАК Студенты
	|ГДЕ
	|	Студенты.Ссылка = &Ссылка
	|	И Студенты.Ссылка.ПринятьДетейВГруппу = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Поле Группа:
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Студенты.Студент															КАК Студент,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.Группа)				КАК Поле,
	|	&Группа																		КАК Значение
	|ИЗ
	|	Документ.ВводНачальныхОстатков.Студенты	КАК Студенты
	|ГДЕ
	|	Студенты.Ссылка = &Ссылка
	|	И Студенты.Ссылка.ПринятьДетейВГруппу = ИСТИНА
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Поле Состояние студента:
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Студенты.Студент															КАК Студент,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СостояниеСтудента)	КАК Поле,
	|	Студенты.СостояниеСтудента													КАК Значение
	|ИЗ
	|	Документ.ВводНачальныхОстатков.Студенты	КАК Студенты
	|ГДЕ
	|	Студенты.Ссылка = &Ссылка
	|	И Студенты.Ссылка.ПринятьДетейВГруппу = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Поле Ставка оплаты:
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Студенты.Студент															КАК Студент,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СтавкаОплаты)		КАК Поле,
	|	Студенты.СтавкаОплаты														КАК Значение
	|ИЗ
	|	Документ.ВводНачальныхОстатков.Студенты	КАК Студенты
	|ГДЕ
	|	Студенты.Ссылка = &Ссылка
	|	И НЕ &ЭтоДолгосрочныйДоговор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Поле Льгота:
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Студенты.Студент															КАК Студент,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.Льгота)				КАК Поле,
	|	Студенты.Льгота																КАК Значение
	|ИЗ
	|	Документ.ВводНачальныхОстатков.Студенты	КАК Студенты
	|ГДЕ
	|	Студенты.Ссылка = &Ссылка
	|	И НЕ &ЭтоДолгосрочныйДоговор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Поля приказов, установленные на отдельной закладке:
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Студенты.Студент КАК Студент,
	|	СведенияОСтудентах.Поле КАК Поле,
	|	СведенияОСтудентах.Значение КАК Значение
	|ИЗ
	|	Документ.ВводНачальныхОстатков.Студенты	КАК Студенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводНачальныхОстатков.СведенияОСтудентах КАК СведенияОСтудентах
	|		ПО Студенты.Ссылка = СведенияОСтудентах.Ссылка
	|ГДЕ
	|	Студенты.Ссылка = &Ссылка
	|	И СведенияОСтудентах.Ссылка = &Ссылка
	|	И НЕ СведенияОСтудентах.Поле В (&ИсключаемыеПоляПриказов)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Студент
	|;	
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные табличной части для движений по рег.свед. СведенияОСтудентах
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Студенты.Ссылка.Дата						КАК Период,
	|	Студенты.Студент							КАК Студент,
	|	Студенты.Договор							КАК Договор,
	|	Студенты.Ссылка.Факультет					КАК Факультет,
	|	ЗначенияПолей.Поле							КАК Поле,
	|	ЗначенияПолей.Значение						КАК Значение
	|	
	|ИЗ
	|	Документ.ВводНачальныхОстатков.Студенты	КАК Студенты
