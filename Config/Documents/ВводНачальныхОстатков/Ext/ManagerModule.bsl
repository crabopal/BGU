Функция ПроверитьНаличиеДокументовВводаОстатков_ПраваПользованияАктивами(ДокументОбъект)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументСсылка",	ДокументОбъект.Ссылка);
	ЗапросПоиск.УстановитьПараметр("Договор",			ДокументОбъект.Договор);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Уже существующие документы ввода остатков прав пользования активами
	|//		по такому договору
	|//
	|ВЫБРАТЬ
	|	Номер	КАК Номер,
	|	Дата	КАК Дата
	|ИЗ
	|	Документ.ВводНачальныхОстатков
	|ГДЕ
	|	РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.ПраваПользованияАктивами)
	|	И Договор = &Договор
	|	И Ссылка <> &ДокументСсылка
	|	И Проведен
	|УПОРЯДОЧИТЬ ПО
	|	Дата
	|;";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаполнитьИзДвиженийПраваПользованияАктивами(ДокументОбъект) Экспорт
	
	Перем АналитикаОстатка40140Кт;
	
	ДокументОбъект["РазделУчета"] = Перечисления.РазделыУчетаДляВводаОстатков.ПраваПользованияАктивами;
	
	НаДату = '20190101';
	
	КЭК0 = БухгалтерскийУчетПовтИсп.КЭК0();
	
	Счета10440 = БухгалтерскийУчет.СписокСчетов("104.40", НаДату);
	Счета11140 = БухгалтерскийУчет.СписокСчетов("111.40", НаДату);
	Счета40140 = БухгалтерскийУчет.СписокСчетов("401.40", НаДату);
	
	// На примере полей КФО и подразделение.
	//
	// КФО и подразделение указываются в каждой строке табличной части для конкретного ОС.
	// Эти данные берутся из проводок регистра бухгалтерии, в которых по одному ОС
	// могут быть две проводки (по счетам 104.40, 111.40).
	//
	// Аналитика КФО и Подразделения в таких проводках по одному и тому же ОС могут различаться.
	// Например, из-за различных настроек самих счетов, либо таковы остатки в информационной базе.
	//
	// Принцип установки значений полей, указываемых в нескольких движениях и проводках:
	//		-----------------------------------------------------
	//		|  Выбираем первое обнаруженное значение			|
	//		|													|
	//		|	 - заполненное (для КФО)						|
	//		|	 - произвольное, кроме Null (для подразделения)	|
	//		-----------------------------------------------------
	
	ПервыеОбнаруженныеЗначения = Новый Структура();
	ПервыеОбнаруженныеЗначения.Вставить("Шапка",			Новый Структура());
	ПервыеОбнаруженныеЗначения.Вставить("ТабличнаяЧасть",	Новый Соответствие());
	
	РазличныеЗначения = Новый Структура();
	
	//
	// Табличная часть
	//
	
	ТаблицаПараметрыАмортизацииПравПользованияОС = ДокументОбъект.Движения.ПараметрыАмортизацииПравПользованияОС.Выгрузить();
	
	Поиск = Новый Структура("ОсновноеСредство");
	
	ПраваПользования = ДокументОбъект.ПраваПользования;
	
	АналитикаОстатка = Новый Структура("ИФО,КФО,Организация");
	
	Для Каждого Проводка Из ДокументОбъект.Движения.ЖурналПроводокЕПСБУ Цикл
		
		ЭтоОстаток11140Дт = (Счета11140.Найти(Проводка.СчетДт) <> Неопределено);
		
		ЭтоОстаток10440Кт = (Счета10440.Найти(Проводка.СчетКт) <> Неопределено);
		
		ЭтоОстаток40140Кт = (Счета40140.Найти(Проводка.СчетКт) <> Неопределено);
		
		ЗаполнитьЗначенияСвойств(АналитикаОстатка, Проводка, "ИФО,КФО,Организация");
		
		Если ЭтоОстаток11140Дт Тогда
			
			ОсновноеСредство = Проводка.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства];
			
		ИначеЕсли ЭтоОстаток10440Кт Тогда
			
			ОсновноеСредство = Проводка.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства];
			
		ИначеЕсли ЭтоОстаток40140Кт Тогда
			
			АналитикаОстатка40140Кт = Новый Структура(Новый ФиксированнаяСтруктура(АналитикаОстатка));
			
			Договор			= Проводка.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Договоры];
			Номенклатура	= Проводка.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура];
			
			АналитикаОстатка40140Кт.Вставить("Подразделение",	Проводка.ПодразделениеКт);
			АналитикаОстатка40140Кт.Вставить("Договор",			Договор);
			АналитикаОстатка40140Кт.Вставить("Сумма",			Проводка.Сумма);
			
			ДокументОбъект["КПСДоходов"]	= Проводка.КПСКт;
			ДокументОбъект["КЭКДоходов"]	= КЭК0;
			ДокументОбъект["СчетДБП"]		= Проводка.СчетКт;
			ДокументОбъект["Номенклатура"]	= Номенклатура;
			
			
			ПараметрыСписанияДоходовБудущихПериодов = ДокументОбъект.Движения.ПараметрыСписанияДоходовБудущихПериодов;
			
			Если ПараметрыСписанияДоходовБудущихПериодов.Количество() >= 1 Тогда
				
				Движение = ПараметрыСписанияДоходовБудущихПериодов[0];
				
				ЗаполнитьЗначенияСвойств(ДокументОбъект, Движение,
					"СчетДоходов,
					|СубконтоДоходов1,
					|СубконтоДоходов2,
					|СубконтоДоходов3,
					|СчетДоходовНУ,
					|ВидДеятельностиНУ,
					|СтатьяПрочихДоходовНУ");
				
				ДобавитьКРазличнымЗначениям("ВидОперации", Движение.ВидОперации, РазличныеЗначения);
				
			КонецЕсли;
			
			Продолжить;
			
		Иначе
			// Неожидаемая аналитика остатка
			
			Продолжить;
		КонецЕсли;
		
		Поиск.Вставить("ОсновноеСредство", ОсновноеСредство);
		
		
		МассивСтрок = ПраваПользования.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			СтрокаТабличнойЧасти = ПраваПользования.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, Поиск);
		Иначе
			СтрокаТабличнойЧасти = МассивСтрок[0];
		КонецЕсли;
		
		
		ОбластьЗначенийТабличнаяЧасть = ПервыеОбнаруженныеЗначения.ТабличнаяЧасть.Получить(ОсновноеСредство);
		
		Если ОбластьЗначенийТабличнаяЧасть = Неопределено Тогда
			
			ОбластьЗначенийТабличнаяЧасть = Новый Структура();
			
			ПервыеОбнаруженныеЗначения.ТабличнаяЧасть.Вставить(ОсновноеСредство, ОбластьЗначенийТабличнаяЧасть);
			
		КонецЕсли;
		
		
		Если ЭтоОстаток11140Дт Тогда
			// Проводка "Балансовая стоимость"
			
			Договор	= Проводка.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Договоры];
			ЦМО		= Проводка.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.ЦМО];
			
			АналитикаОстатка.Вставить("Подразделение",	Проводка.ПодразделениеДт);
			АналитикаОстатка.Вставить("Договор",		Договор);
			АналитикаОстатка.Вставить("КПС",			Проводка.КПСДт);
			
			СтрокаТабличнойЧасти["ЦМО"]					= ЦМО;
			СтрокаТабличнойЧасти["СчетУчета"]			= Проводка.СчетДт;
			СтрокаТабличнойЧасти["БалансоваяСтоимость"]	= Проводка.Сумма;
			
		ИначеЕсли ЭтоОстаток10440Кт Тогда
			// Проводка "Накопленная амортизация"
			
			Договор = Проводка.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Договоры];
			
			АналитикаОстатка.Вставить("Подразделение",	Проводка.ПодразделениеКт);
			АналитикаОстатка.Вставить("Договор",		Договор);
			АналитикаОстатка.Вставить("КПС",			Проводка.КПСКт);
			
			СтрокаТабличнойЧасти["СчетАмортизации"]			= Проводка.СчетКт;
			СтрокаТабличнойЧасти["НакопленнаяАмортизация"]	= Проводка.Сумма;
			
		КонецЕсли;
		
		// Для шапки
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("Организация", АналитикаОстатка.Организация, ПервыеОбнаруженныеЗначения.Шапка);
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("Договор", АналитикаОстатка.Договор, ПервыеОбнаруженныеЗначения.Шапка);
		ДобавитьКПервымОбнаруженнымЗначениям("ИФО", АналитикаОстатка.ИФО, ПервыеОбнаруженныеЗначения.Шапка);
		
		// Для текущей строки табличной части
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("КФО", АналитикаОстатка.КФО, ОбластьЗначенийТабличнаяЧасть);
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("КПС", АналитикаОстатка.КПС, ОбластьЗначенийТабличнаяЧасть);
		ДобавитьКПервымОбнаруженнымЗначениям("Подразделение", АналитикаОстатка.Подразделение, ОбластьЗначенийТабличнаяЧасть);
		
		
		МассивСтрок = ТаблицаПараметрыАмортизацииПравПользованияОС.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Движение = МассивСтрок[0];
			
			// Совпадающие имена полей
			ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, Движение,
				"СпособПризнанияРасходов,
				|ДатаНачалаАмортизации,
				|ДатаОкончанияАмортизации,
				|СчетРасходов,
				|КПСРасходов,
				|КЭКРасходов,
				|ПодразделениеРасходов,
				|СубконтоРасходов1,
				|СубконтоРасходов2,
				|СубконтоРасходов3,
				|СтатьяПрочихРасходовНУ,
				|СчетРасчетов,
				|КПСРасчетов");
			
			// Различающиеся имена полей
			СтрокаТабличнойЧасти.НДСКВычету = Движение.ПринятьНДСКВычету;
			
			ДобавитьКРазличнымЗначениям("ВидОперации", Движение.ВидОперации, РазличныеЗначения);
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, ОбластьЗначенийТабличнаяЧасть);
		
	КонецЦикла;
	
	// Так как сумма отложенных доходов для всего документа указывается одной суммой,
	// то принимаем решение размещать эту сумму целиком в самой первой строке табличной части.
	Если АналитикаОстатка40140Кт <> Неопределено Тогда
		
		ОбластьЗначенийПервойСтроки = Новый Структура("КФО,Подразделение");
		
		Если ПраваПользования.Количество() = 0 Тогда
			
			СтрокаТабличнойЧасти = ПраваПользования.Добавить();
			
		Иначе
			
			СтрокаТабличнойЧасти = ПраваПользования[0];
			
			ОбластьЗначенийТабличнаяЧасть = ПервыеОбнаруженныеЗначения.ТабличнаяЧасть.Получить(СтрокаТабличнойЧасти["ОсновноеСредство"]);
			
			ЗаполнитьЗначенияСвойств(ОбластьЗначенийПервойСтроки, ОбластьЗначенийТабличнаяЧасть);
			
		КонецЕсли;
		
		// Для шапки
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("Организация", АналитикаОстатка40140Кт.Организация, ПервыеОбнаруженныеЗначения.Шапка);
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("Договор", АналитикаОстатка40140Кт.Договор, ПервыеОбнаруженныеЗначения.Шапка);
		ДобавитьКПервымОбнаруженнымЗначениям("ИФО", АналитикаОстатка40140Кт.ИФО, ПервыеОбнаруженныеЗначения.Шапка);
		
		// Для самой первой строки табличной части
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("КФО", АналитикаОстатка40140Кт.КФО, ОбластьЗначенийПервойСтроки);
		ДобавитьКПервымОбнаруженнымЗначениям("Подразделение", АналитикаОстатка40140Кт.Подразделение, ОбластьЗначенийПервойСтроки);
		
		
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, ОбластьЗначенийПервойСтроки);
		
		СтрокаТабличнойЧасти["ОтложенныйДоход"] = АналитикаОстатка40140Кт.Сумма;
		
	КонецЕсли;
	
	// Дозаполняем счет амортизации в табличной части
	Для Каждого СтрокаТаблицы Из ПраваПользования Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы["СчетАмортизации"]) Тогда
			
			СтрокаТаблицы["СчетАмортизации"] = БухгалтерскиеОперации.СчетАмортизацииОС(СтрокаТаблицы["СчетУчета"]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	//
	// Шапка
	//
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ПервыеОбнаруженныеЗначения.Шапка);
	
	Если ЗначениеЗаполнено(ДокументОбъект.Договор) Тогда
		Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Договор, "Контрагент");
		
		ДокументОбъект["Контрагент"] = Контрагент;
	КонецЕсли;
	
	// В документе вид операции указывается в шапке.
	// То есть, одно единственное значение применяется для каждой строки табличной части.
	//
	// Но вид операции указан в движениях регистров сведений с детализацией по ОС.
	// То есть, в табличной части могут оказаться различные виды операций в разных строках,
	// так как строка табличной части дозаполняется напрямую из соответвующего движения регистра сведений.
	//
	// Необходимо установить такое одно значение вида операции в шапке, которое будет совместимо
	// с (возможно, различными) видами операций, соответствующими каждой строки табличной части.
	
	ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях;
	
	Значения = Неопределено;
	
	Если РазличныеЗначения.Свойство("ВидОперации", Значения) Тогда
		
		Если Значения.Количество() = 1 И ЗначениеЗаполнено(Значения[0]) Тогда
			
			ВидОперации = Значения[0];
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДокументОбъект["ВидОперации"] = ВидОперации;
	
	ОбщиеПараметрыНачисленияАмортизации = Документы.ВводНачальныхОстатков.ПолучитьОбщиеПараметрыНачисленияАмортизации(ДокументОбъект);
	
	ДокументОбъект["ПараметрыАмортизацииУстановленыПоДоговоруВЦелом"] = (ОбщиеПараметрыНачисленияАмортизации <> Неопределено);
	
	
	// Дублируем действия, выполняемые при записи документа
	
	ДокументОбъект["СуммаДокумента"] = ПраваПользования.Итог("БалансоваяСтоимость");
	
	СчетДляШапкиДокумента = Документы.ВводНачальныхОстатков.ОпределитьСчетДляШапкиДокумента_ПраваПользования(ДокументОбъект);
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, СчетДляШапкиДокумента, "Счет,КФО,КПС");
	
КонецПроцедуры

//---
// Раздел учета "Доходы будущих периодов"
//---

Функция ЕстьОшибкиЗаполнения_ДоходыБудущихПериодов(ДокументОбъект) Экспорт
	
	ЕстьОшибкиЗаполнения = Ложь;
	
	//
	// Заполненность обязательных реквизитов
	//
	
	ПроверитьЗаполненностьРеквизитов_ДоходыБудущихПериодов(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	//
	// Наличие уже существующих документов по таком договору
	//
	
	ТаблицаДокументов = ПроверитьНаличиеДокументовВводаОстатков_ДоходыБудущихПериодов(ДокументОбъект);
	
	Если ТаблицаДокументов.Количество() > 0 Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ТекстШаблон = НСтр("ru='По договору ""%1"" остатки уже введены документами: %2'");
		
		СписокДокументов = "";
		
		Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
			ПредставлениеДокумента = СтрокаТаблицы.Номер + " от " + СтрокаТаблицы.Дата;
			
			СписокДокументов = СписокДокументов
				+ ?(СписокДокументов = "", "", "; ")
				+ ПредставлениеДокумента;
		КонецЦикла;
		
		ТекстСообщения = СтрШаблон(ТекстШаблон, ДокументОбъект.Договор, СписокДокументов);
		
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			ДокументОбъект.Ссылка,
			"Объект.Договор");
	КонецЕсли;
	
	//
	// Дубли строк
	//
	
	КлючСвязи = "Номенклатура,Подразделение";
	
	ПараметрыВывода = Новый Структура();
	ПараметрыВывода.Вставить("ТаблицаИмя",				"ДоходыБудущихПериодов");
	ПараметрыВывода.Вставить("ТаблицаПредставление",	НСтр("ru='Услуги, работы'"));
	ПараметрыВывода.Вставить("ОбъектСсылка",			ДокументОбъект["Ссылка"]);
	ПараметрыВывода.Вставить("ШаблонСтроки",			НСтр("ru='Обнаружены дубли строк по колонкам ""Номенклатура"" и ""Подразделение"" (таблица ""[ТаблицаПредставление]"", строки [НомераСтрок])'"));
	
	ТаблицаДублиСтрок = УчетНДС.НайтиДублиСтрок(ДокументОбъект["ПраваПользования"], КлючСвязи);
	
	Если ТаблицаДублиСтрок.Количество() > 0 Тогда
		ЕстьОшибкиЗаполнения = Истина;
		УчетНДС.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	КонецЕсли;
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Процедура ПроверитьЗаполненностьРеквизитов_ДоходыБудущихПериодов(ДокументОбъект, ЕстьОшибкиЗаполнения)
	
	Перем РезультатПроверки;
	
	ПроверяемыеРеквизиты = Новый Массив();
	ПроверяемыеРеквизиты.Добавить("СпособПризнанияДоходов");
	
	Если ДокументОбъект.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам
	 ИЛИ ДокументОбъект.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням Тогда
		
		ПроверяемыеРеквизиты.Добавить("ДатаНачалаСписания");
		ПроверяемыеРеквизиты.Добавить("ДатаОкончанияСписания");
		
		Если ЗначениеЗаполнено(ДокументОбъект.ДатаНачалаСписания) И ЗначениеЗаполнено(ДокументОбъект.ДатаОкончанияСписания)
			И (ДокументОбъект.ДатаОкончанияСписания < ДокументОбъект.ДатаНачалаСписания) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность",
				НСтр("ru = 'Дата окончания списания'"),,,
				НСтр("ru = 'Дата начала списания превышает дату окончания.'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, "ДатаОкончанияСписания", "Объект", ЕстьОшибкиЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
	ПроверяемыеРеквизиты.Добавить("Организация");
	ПроверяемыеРеквизиты.Добавить("Дата");
	ПроверяемыеРеквизиты.Добавить("Контрагент");
	ПроверяемыеРеквизиты.Добавить("Договор");
	ПроверяемыеРеквизиты.Добавить("ВидОперацииДБП");
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ПроверяемыеРеквизиты.Добавить("ИФО");
	КонецЕсли;
	
	ПроверяемыеРеквизиты.Добавить("ДоходыБудущихПериодов.Номенклатура");
	
	ПроверяемыеРеквизиты.Добавить("СчетДоходов");
	
	СвойстваСчетаДБП = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ДокументОбъект.Счет);
	Если СвойстваСчетаДБП.УчетПоПодразделениям И НЕ СвойстваСчетаДБП.РазрешитьНеУказыватьПодразделение Тогда
		ПроверяемыеРеквизиты.Добавить("ДоходыБудущихПериодов.Подразделение");
	КонецЕсли;
	
	Если ДокументОбъект.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях
	 ИЛИ ДокументОбъект.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование Тогда
		ПроверяемыеРеквизиты.Добавить("СчетРБП");
		ПроверяемыеРеквизиты.Добавить("КПСРБП");
		ПроверяемыеРеквизиты.Добавить("КЭКРБП");
		ПроверяемыеРеквизиты.Добавить("СтатьяРБП");
	КонецЕсли;
	
	// Налоговый учет.
	ДатаУчетнойПолитики = ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(ДокументОбъект.Дата);
	Если НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(ДокументОбъект.Организация, ДатаУчетнойПолитики, ДокументОбъект.КФО)
		И НЕ ДокументОбъект.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование Тогда
		
		ПроверяемыеРеквизиты.Добавить("ВидДеятельностиНУ");
		
		ЭтоПрочиеДоходы = БухгалтерскийУчет.СчетВИерархии(ДокументОбъект.СчетДоходовНУ, "Н91.01");
		Если ЭтоПрочиеДоходы Тогда
			ПроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыПроверки = Новый Структура();
	ПараметрыПроверки.Вставить("ВыводитьСообщения",				Истина);
	ПараметрыПроверки.Вставить("ПроверяемыеРеквизиты",			ПроверяемыеРеквизиты);
	
	РеквизитыЗаполнены = ОбщегоНазначенияБГУ.УказанныеРеквизитыЗаполнены(ДокументОбъект, ПараметрыПроверки, РезультатПроверки);
	
	Если НЕ РеквизитыЗаполнены Тогда
		ЕстьОшибкиЗаполнения = Истина;
	КонецЕсли;
	
	// Счет доходов в шапке документа
	РеквизитыСчетаДоходов = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
		"СчетДоходов", "СубконтоДоходов1", "СубконтоДоходов2", "СубконтоДоходов3");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаДоходов,
		ДокументОбъект, , ЕстьОшибкиЗаполнения);
	
	// Способ признания расходов "По графику" нельзя использовать при безвозмездном поступлении имущества.
	Если ДокументОбъект.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование
		И ДокументОбъект.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоГрафику Тогда
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
			НСтр("ru = 'Способ признания доходов'"), , ,
			НСтр("ru='Способ ""По графику"" нельзя использовать по договорам безвозмездного пользования.'"));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, "СпособПризнанияДоходов", "Объект", ЕстьОшибкиЗаполнения);
		
	КонецЕсли;
	
	// Контроль ведения расчетов в иностранной валюте.
	Если ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента)
		И ДокументОбъект.ВалютаДокумента <> Константы.ВалютаРегламентированногоУчета.Получить()
		И  (ДокументОбъект.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях
		ИЛИ ДокументОбъект.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование) Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru='Учет в иностранной валюте не поддерживается для вида операции ""%1"".'"), ДокументОбъект.ВидОперацииДБП);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, "ВидОперацииДБП", "Объект", ЕстьОшибкиЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьНаличиеДокументовВводаОстатков_ДоходыБудущихПериодов(ДокументОбъект)
	
	Возврат Новый ТаблицаЗначений();
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента_ДоходыБудущихПериодов(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,Дата,ВидОперацииДБП,КФО,СчетДоходовНУ");
	
	ДатаУчетнойПолитики = ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(ЗначенияРеквизитов.Дата);
	
	ЗапросДвижения = Новый Запрос();
	ЗапросДвижения.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	ЗапросДвижения.УстановитьПараметр("ОтражатьВНалоговомУчете",
		НалоговыйУчет.ОтражатьВНалоговомУчете(ЗначенияРеквизитов.Организация, ДатаУчетнойПолитики, ЗначенияРеквизитов.КФО)
		И НЕ ЗначенияРеквизитов.ВидОперацииДБП = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование);
	ЗапросДвижения.УстановитьПараметр("ЭтоПрочиеДоходы",
		БухгалтерскийУчет.СчетВИерархии(ЗначенияРеквизитов.СчетДоходовНУ, "Н91.01"));
	ЗапросДвижения.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Движения по регистру сведений ПараметрыСписанияДоходовБудущихПериодов
	|//
	|ВЫБРАТЬ
	|	ВводНачальныхОстатков.Дата КАК Период,
	|	ВводНачальныхОстатков.Договор КАК Договор,
	|	ВводНачальныхОстатков.Организация КАК Организация,
	|	ВводНачальныхОстатков.ВидОперацииДБП КАК ВидОперации,
	|	ВводНачальныхОстатков.СпособПризнанияДоходов КАК СпособПризнанияДоходов,
	|	ВводНачальныхОстатков.ДатаНачалаСписания КАК ДатаНачалаСписания,
	|	ВводНачальныхОстатков.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
	|	ВводНачальныхОстатков.СчетДоходов КАК СчетДоходов,
	|	ВводНачальныхОстатков.СубконтоДоходов1 КАК СубконтоДоходов1,
	|	ВводНачальныхОстатков.СубконтоДоходов2 КАК СубконтоДоходов2,
	|	ВводНачальныхОстатков.СубконтоДоходов3 КАК СубконтоДоходов3,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|			ТОГДА ВводНачальныхОстатков.ВидДеятельностиНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ПустаяСсылка)
	|	КОНЕЦ КАК ВидДеятельностиНУ,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|			ТОГДА ВводНачальныхОстатков.СчетДоходовНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	КОНЕЦ КАК СчетДоходовНУ,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|				И &ЭтоПрочиеДоходы
	|			ТОГДА ВводНачальныхОстатков.СтатьяПрочихДоходовНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|	КОНЕЦ КАК СтатьяПрочихДоходовНУ
	|ИЗ
	|	Документ.ВводНачальныхОстатков КАК ВводНачальныхОстатков
	|ГДЕ
	|	ВводНачальныхОстатков.Ссылка = &ДокументСсылка";
	
	// [0]. Движения по регистру сведений ПараметрыСписанияДоходовБудущихПериодов
	ТаблицаПараметрыСписанияДоходовБудущихПериодов = ЗапросДвижения.Выполнить().Выгрузить();
	
	ТаблицыДляДвижений.Вставить("ПараметрыСписанияДоходовБудущихПериодов", ТаблицаПараметрыСписанияДоходовБудущихПериодов);
	
КонецПроцедуры

Процедура ЗаполнитьИзДвиженийДБП(ДокументОбъект) Экспорт
	
	ДокументОбъект["РазделУчета"] = Перечисления.РазделыУчетаДляВводаОстатков.ДоходыБудущихПериодов;
	
	КЭК0 = БухгалтерскийУчетПовтИсп.КЭК0();
	
	ПустоеПодразделение = Справочники.Подразделения.ПустаяСсылка();
	
	НаДату = '20190101';
	
	Счета40140 = БухгалтерскийУчет.СписокСчетов("401.40", НаДату);
	Счета40150 = БухгалтерскийУчет.СписокСчетов("401.50", НаДату);
	
	ПервыеОбнаруженныеЗначения = Новый Структура();
	
	РазличныеЗначения = Новый Структура();
	
	ТаблицаУпущеннаяВыгода = Новый ТаблицаЗначений();
	ТаблицаУпущеннаяВыгода.Колонки.Добавить("Подразделение",	Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаУпущеннаяВыгода.Колонки.Добавить("УпущеннаяВыгода",	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2)));
	
	Поиск = Новый Структура();
	
	Если ДокументОбъект.Движения.ПараметрыСписанияДоходовБудущихПериодов.Количество() >= 1 Тогда
		
		Движение = ДокументОбъект.Движения.ПараметрыСписанияДоходовБудущихПериодов[0];
		
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("Организация",				Движение.Организация,			ПервыеОбнаруженныеЗначения);
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("Договор",					Движение.Договор,				ПервыеОбнаруженныеЗначения);
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("СчетДоходов",				Движение.СчетДоходов,			ПервыеОбнаруженныеЗначения);
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("СубконтоДоходов1",			Движение.СубконтоДоходов1,		ПервыеОбнаруженныеЗначения);
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("СубконтоДоходов2",			Движение.СубконтоДоходов2,		ПервыеОбнаруженныеЗначения);
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("СубконтоДоходов3",			Движение.СубконтоДоходов3,		ПервыеОбнаруженныеЗначения);
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("СчетДоходовНУ",			Движение.СчетДоходовНУ,			ПервыеОбнаруженныеЗначения);
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("ВидДеятельностиНУ",		Движение.ВидДеятельностиНУ,		ПервыеОбнаруженныеЗначения);
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("СтатьяПрочихДоходовНУ",	Движение.СтатьяПрочихДоходовНУ,	ПервыеОбнаруженныеЗначения);
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("СпособПризнанияДоходов",	Движение.СпособПризнанияДоходов,ПервыеОбнаруженныеЗначения);
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("ДатаНачалаСписания",		Движение.ДатаНачалаСписания,	ПервыеОбнаруженныеЗначения);
		ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("ДатаОкончанияСписания",	Движение.ДатаОкончанияСписания,	ПервыеОбнаруженныеЗначения);
		
		ДобавитьКРазличнымЗначениям("ВидОперации", Движение.ВидОперации, РазличныеЗначения);
		
	КонецЕсли;
	
	Для Каждого Проводка Из ДокументОбъект.Движения.ЖурналПроводокЕПСБУ Цикл
		
		ЭтоОстаток40140Кт = (Счета40140.Найти(Проводка.СчетКт) <> Неопределено);
		
		ЭтоОстаток40150Дт = (Счета40150.Найти(Проводка.СчетДт) <> Неопределено);
		
		Если ЭтоОстаток40140Кт Тогда
			
			Номенклатура	= Проводка.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура];
			Договор			= Проводка.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Договоры];
			
			Подразделение = ?(ЗначениеЗаполнено(Проводка.ПодразделениеКт), Проводка.ПодразделениеКт, ПустоеПодразделение);
			
			ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("Организация",	Проводка.Организация,	ПервыеОбнаруженныеЗначения);
			ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("КФО",			Проводка.КФО,			ПервыеОбнаруженныеЗначения);
			ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("ИФО",			Проводка.ИФО,			ПервыеОбнаруженныеЗначения);
			ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("Счет",			Проводка.СчетКт,		ПервыеОбнаруженныеЗначения);
			ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("КПС",			Проводка.КПСКт,			ПервыеОбнаруженныеЗначения);
			ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("КЭК",			Проводка.КЭККт,			ПервыеОбнаруженныеЗначения);
			ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("Договор",		Договор,				ПервыеОбнаруженныеЗначения);
			
			Поиск.Вставить("Номенклатура", Номенклатура);
			Поиск.Вставить("Подразделение", Подразделение);
			
			МассивСтрок = ДокументОбъект.ДоходыБудущихПериодов.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() = 0 Тогда
				СтрокаТабличнойЧасти = ДокументОбъект.ДоходыБудущихПериодов.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, Поиск);
			Иначе
				СтрокаТабличнойЧасти = МассивСтрок[0];
			КонецЕсли;
			
			СтрокаТабличнойЧасти["ОтложенныйДоход"]	= Проводка.Сумма;
			
		ИначеЕсли ЭтоОстаток40150Дт Тогда
			
			СтатьяРБП = Проводка.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.РасходыБудущихПериодов];
			
			ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("Организация",	Проводка.Организация,	ПервыеОбнаруженныеЗначения);
			ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("КФО",			Проводка.КФО,			ПервыеОбнаруженныеЗначения);
			ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("ИФО",			Проводка.ИФО,			ПервыеОбнаруженныеЗначения);
			ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("СчетРБП",		Проводка.СчетДт,		ПервыеОбнаруженныеЗначения);
			ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("КПСРБП",		Проводка.КПСДт,			ПервыеОбнаруженныеЗначения);
			ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("КЭКРБП",		Проводка.КЭКДт,			ПервыеОбнаруженныеЗначения);
			ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям("СтатьяРБП",	СтатьяРБП,				ПервыеОбнаруженныеЗначения);
			
			НоваяСтрока = ТаблицаУпущеннаяВыгода.Добавить();
			НоваяСтрока["Подразделение"]	= Проводка.ПодразделениеДт;
			НоваяСтрока["УпущеннаяВыгода"]	= Проводка.Сумма;
			
		КонецЕсли;
		
	КонецЦикла;
	
	//
	// Шапка
	//
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ПервыеОбнаруженныеЗначения);
	
	Если ЗначениеЗаполнено(ДокументОбъект.Договор) Тогда
		Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Договор, "Контрагент");
		
		ДокументОбъект["Контрагент"] = Контрагент;
	КонецЕсли;
	
	// В документе вид операции указывается в шапке.
	// То есть, одно единственное значение применяется для каждой строки табличной части.
	//
	// Но вид операции указан в движениях регистров сведений с детализацией по ОС.
	// То есть, в табличной части могут оказаться различные виды операций в разных строках,
	// так как строка табличной части дозаполняется напрямую из соответвующего движения регистра сведений.
	//
	// Необходимо установить такое одно значение вида операции в шапке, которое будет совместимо
	// с (возможно, различными) видами операций, соответствующими каждой строки табличной части.
	
	ВидОперации = Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях;
	
	Значения = Неопределено;
	
	Если РазличныеЗначения.Свойство("ВидОперации", Значения) Тогда
		
		Если Значения.Количество() = 1 И ЗначениеЗаполнено(Значения[0]) Тогда
			
			ВидОперации = Значения[0];
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДокументОбъект["ВидОперацииДБП"] = ВидОперации;
	
	//
	// Дозаполняем табличную часть
	//
	
	Если ТаблицаУпущеннаяВыгода.Количество() > 0 Тогда
		
		ТаблицаПриемник = ДокументОбъект.ДоходыБудущихПериодов.Выгрузить();
		
		ДобавитьСуммыВПорядкеСледованияСтрокТаблиц(ТаблицаПриемник, ТаблицаУпущеннаяВыгода, "Подразделение", "УпущеннаяВыгода");
		
		ДокументОбъект.ДоходыБудущихПериодов.Загрузить(ТаблицаПриемник);
		
	КонецЕсли;
	
	// Дублируем действия, выполняемые при записи документа
	
	ДокументОбъект["СуммаДокумента"] = ДокументОбъект.ДоходыБудущихПериодов.Итог("ОтложенныйДоход");
	
КонецПроцедуры

//---
// Раздел учета "Основные средства"
//---

Функция ПолучитьЗначенияЗаполнения_ОС(Счет) Экспорт
	
	Результат = Новый Структура();
	
	// Для шапки документа
	Результат.Вставить("ВидНФА",		УправлениеОсновнымиСредствамиПовтИсп.ВидНФАпоСчетуУчета(Счет));
	Результат.Вставить("ВидИмущества",	УправлениеОсновнымиСредствамиПовтИсп.ВидИмуществаПоСчетуУчета(Счет));
	Результат.Вставить("ВидУчета",		УправлениеОсновнымиСредствамиПовтИсп.ВидУчетаПоСчетуУчета(Счет));
	
	// Для новой строки ТЧ "ОС Основная"
	Результат.Вставить("СостояниеОС",	Перечисления.СостоянияОС.ПринятоКУчету);
	
	Возврат Результат;
	
КонецФункции

// Заполняет используемые варианты отбора для поля "Счет".
// Отборы счета однозначно определяются значением реквизита "ВидНФА".
//
// Возвращает отбор вида (для поля "Счет"):
// (Группа "И")
//		*	Ссылка ВСпискеПоИерархии (СписокСчетов)
//		*	ЭлементГруппа=Ложь
//
//	ВидНФА					СписокСчетов
//	------------------------------------
//	ОС						Счет101
//	НМА						Счет102
//	ПустаяСсылка,			Счет101, Счет102
//	а также все остальные
Процедура ИнициализироватьПредустановленныеОтборы_ОС(ПредустановленныеОтборы_Счет, ПредустановленныеОтборы_СчетАмортизации = Неопределено) Экспорт
	
	Счет101 = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101.00");
	Счет102 = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("102.00");
	Счет104 = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("104.00");
	Счета104НМА = Новый СписокЗначений();
	Счета104НМА.Добавить(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("104.29"));
	Счета104НМА.Добавить(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("104.39"));
	Счета104НМА.Добавить(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("104.49"));
	Счет10450 = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("104.50");
	
	ВремСоответствие = Новый Соответствие();
	ВремСоответствие_СчетАмортизации = Новый Соответствие();
	
	КлючиСоответствия = Новый Массив();
	КлючиСоответствия.Добавить(Перечисления.ВидыНФА.ОС);
	КлючиСоответствия.Добавить(Перечисления.ВидыНФА.НМА);
	КлючиСоответствия.Добавить(Перечисления.ВидыНФА.ПустаяСсылка());
	
	Для Каждого КлючСоответствия Из КлючиСоответствия Цикл
		
		СписокСчетов = Новый Массив();
		СписокСчетов_СчетАмортизации = Новый Массив();
		СписокСчетовИсключений_СчетАмортизации = Новый Массив();
		
		Если КлючСоответствия = Перечисления.ВидыНФА.ОС Тогда
			СписокСчетов.Добавить(Счет101);
			
			СписокСчетов_СчетАмортизации.Добавить(Счет104);
			СписокСчетовИсключений_СчетАмортизации = Счета104НМА.ВыгрузитьЗначения();
			СписокСчетовИсключений_СчетАмортизации.Добавить(Счет10450);
			
		ИначеЕсли КлючСоответствия = Перечисления.ВидыНФА.НМА Тогда
			СписокСчетов.Добавить(Счет102);
			
			СписокСчетов_СчетАмортизации = Счета104НМА.ВыгрузитьЗначения();
			
		Иначе
			// ВидНФА не заполнен.
			СписокСчетов.Добавить(Счет101);
			СписокСчетов.Добавить(Счет102);
			
		КонецЕсли;
		
		//
		// 1) Отбор для поля "Счет"
		//
		НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных();
		Отбор = НастройкиКомпоновки.Отбор;
		// Группа "И":
		ГруппаИ = Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		ГруппаИ.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		// В ИЕРАРХИИ (СписокСчетов):
		НовыйЭлемент = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии;
		НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
		НовыйЭлемент.ПравоеЗначение = Новый ФиксированныйМассив(СписокСчетов);
		// ЭлементГруппа = ЛОЖЬ:
		НовыйЭлемент = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭлементГруппа");
		НовыйЭлемент.ПравоеЗначение = Ложь;
		
		// Получаем представление отбора:
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, НастройкиКомпоновки);
		ПредставлениеОтбора = ЗаписьXML.Закрыть();
		
		// Запоминаем текст отбора, соответствующий текущему ключу:
		ВремСоответствие.Вставить(КлючСоответствия, ПредставлениеОтбора);
		
		//
		// 2) Отбор для поля "Счет амортизации"
		//
		НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных();
		Отбор = НастройкиКомпоновки.Отбор;
		// Группа "И":
		ГруппаИ = Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		ГруппаИ.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		// В ИЕРАРХИИ (СписокСчетов):
		НовыйЭлемент = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии;
		НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
		НовыйЭлемент.ПравоеЗначение = Новый ФиксированныйМассив(СписокСчетов_СчетАмортизации);
		// НЕ В ИЕРАРХИИ (СписокСчетовИсключений):
		НовыйЭлемент = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии;
		НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
		НовыйЭлемент.ПравоеЗначение = Новый ФиксированныйМассив(СписокСчетовИсключений_СчетАмортизации);
		// ЭлементГруппа = ЛОЖЬ:
		НовыйЭлемент = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭлементГруппа");
		НовыйЭлемент.ПравоеЗначение = Ложь;
		
		// Получаем представление отбора:
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, НастройкиКомпоновки);
		ПредставлениеОтбора = ЗаписьXML.Закрыть();
		
		// Запоминаем текст отбора, соответствующий текущему ключу:
		ВремСоответствие_СчетАмортизации.Вставить(КлючСоответствия, ПредставлениеОтбора);
		
	КонецЦикла;
	
	// Запоминаем подготовленные тексты отборов:
	ПредустановленныеОтборы_Счет = Новый ФиксированноеСоответствие(ВремСоответствие);
	ПредустановленныеОтборы_СчетАмортизации = Новый ФиксированноеСоответствие(ВремСоответствие_СчетАмортизации);
	
КонецПроцедуры

Процедура ЗаполнитьСписокПроверяемыхОбязательныхРеквизитов_ОС(
			ШапкаДокумента,
			ПроверяемыеРеквизиты,
			ПроверяемыеСубконто,
			ПроверяемыеПризнакиУчета,
			ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
			ПеренаправлениеВыводаСообщений_Реквизиты,
			ИсключаемыеРеквизиты,
			ЭтоПроверкаВФормеРедактированияСтроки = Ложь,
			ПрименяемыйРежимВводаОстатков = Неопределено) Экспорт
	
	// Инициализация:
	Если ПроверяемыеРеквизиты = Неопределено Тогда
		ПроверяемыеРеквизиты = Новый Массив();
	КонецЕсли;
	ИсключаемыеРеквизиты			= Новый Массив();
	ПрименяемыйРежимВводаОстатков	= Новый Структура();
	
	// Подготовка:
	СвойстваСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШапкаДокумента["Счет"],
		"УчетПоКПС, УчетПоКЭК, УчетПоПодразделениям");
		
	// Реквизиты шапки:
	ПроверяемыеРеквизиты.Добавить("Организация");
	ПроверяемыеРеквизиты.Добавить("КФО");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ПроверяемыеРеквизиты.Добавить("ИФО");
	КонецЕсли;
	ПроверяемыеРеквизиты.Добавить("Счет");
	Если СвойстваСчета["УчетПоКПС"] = Истина Тогда
		ПроверяемыеРеквизиты.Добавить("КПС");
	КонецЕсли;
	Если СвойстваСчета["УчетПоКЭК"] = Истина Тогда
		ПроверяемыеРеквизиты.Добавить("КЭК");
	КонецЕсли;
	Если ПодразделениеОбязательноКЗаполнению(ШапкаДокумента, СвойстваСчета) Тогда
		ПроверяемыеРеквизиты.Добавить("ОС_Основная.Подразделение");
	КонецЕсли;
	
	// Реквизиты табличных частей:
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.ОС");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.Количество");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.Сумма");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.ЦМО");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.СостояниеОС");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.ПервоначальнаяСтоимость");
	
	// Сейчас пока проверяются в ПроверкаПоСтроке:
	ПроверяемыеРеквизиты.Добавить("ОС_Амортизация.ПорядокПогашенияСтоимости");
	ПроверяемыеРеквизиты.Добавить("ОС_Амортизация.ДатаПринятияКУчету");
	ПроверяемыеРеквизиты.Добавить("ОС_Амортизация.ПорядокВключенияСтоимостиВСоставРасходовНУ");
	ПроверяемыеРеквизиты.Добавить("ОС_Амортизация.ПорядокВключенияСтоимостиВСоставРасходовУСН");
	
	// Реквизиты табл.части "Кап.ремонт ОС":
	ПроверяемыеРеквизиты.Добавить("КапРемонтОС.ОС");
	ПроверяемыеРеквизиты.Добавить("КапРемонтОС.Дата");
	ПроверяемыеРеквизиты.Добавить("КапРемонтОС.Сумма");
	// Реквизиты табл.части "Модернизация ОС":
	ПроверяемыеРеквизиты.Добавить("МодернизацияОС.ОС");
	ПроверяемыеРеквизиты.Добавить("МодернизацияОС.Дата");
	ПроверяемыеРеквизиты.Добавить("МодернизацияОС.Сумма");
	// Реквизиты табл.части "Переоценка НФА":
	ПроверяемыеРеквизиты.Добавить("ПереоценкаНФА.НФА");
	ПроверяемыеРеквизиты.Добавить("ПереоценкаНФА.Дата");
	
	ПеренаправлениеВыводаСообщений_ТабличныеЧасти = Новый Структура();
	ПеренаправлениеВыводаСообщений_ТабличныеЧасти.Вставить("ОС_Амортизация",	"ОС_Основная");
	ПеренаправлениеВыводаСообщений_ТабличныеЧасти.Вставить("КапРемонтОС",		"КапРемонтОСОтбор");
	ПеренаправлениеВыводаСообщений_ТабличныеЧасти.Вставить("МодернизацияОС",	"МодернизацияОСОтбор");
	ПеренаправлениеВыводаСообщений_ТабличныеЧасти.Вставить("ПереоценкаНФА",		"ПереоценкаНФАОтбор");
	
	
	
	// Исключаем из проверки реквизиты, не используемые в текущем режиме ввода остатков:
	РезультатПроверки = Неопределено;
	ИсключаемыеПоля = РежимВводаОстатков_ИменаПолейВсехРежимов(
		ШапкаДокумента,
		Истина, // ТолькоНеиспользуемые
		РезультатПроверки);
	ПрименяемыйРежимВводаОстатков = РезультатПроверки["ПрименяемыйРежимВводаОстатков"];
	
	Если ЭтоПроверкаВФормеРедактированияСтроки = Истина Тогда
		ИсключитьИзПроверяемыхРеквизитов(ПроверяемыеРеквизиты, ИсключаемыеПоля);
	Иначе
		// Явно заполняем список исключаемых реквизитов
		Для Каждого СтрокаТЗ Из ИсключаемыеПоля Цикл
			ИсключаемыеРеквизиты.Добавить(СтрокаТЗ["ПолноеИмя"]);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПараметрыПроверкиПоСтроке_ОС(ШапкаДокумента) Экспорт
	
	ЭтоСчетБиблФонда					= УправлениеОсновнымиСредствамиКлиентСервер.ЭтоБиблиотечныйФонд(ШапкаДокумента["Счет"]);
	ИспользоватьУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Результат = Новый Структура();
	Результат.Вставить("ЭтоСчетБиблФонда",					ЭтоСчетБиблФонда);
	Результат.Вставить("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	
	Возврат Результат;
	
КонецФункции

Функция ПроверкаПоСтроке_ОС(СтрокаОС, ПараметрыПроверкиПоСтроке, РежимВводаОстатков) Экспорт
	
	// Возвращаемое значение:
	Результат = Новый Структура();
	
	ОтражатьВБухУчете		= РежимВводаОстатков["ОтражатьВБухУчете"];
	ОтражатьВНалУчетеОСН	= РежимВводаОстатков["ОтражатьВНалУчетеОСН"];
	ОтражатьВНалУчетеУСН	= РежимВводаОстатков["ОтражатьВНалУчетеУСН"];
	
	ОС									= СтрокаОС.ОС;
	ГрупповойУчет						= СтрокаОС.ГрупповойУчет;
	Количество							= СтрокаОС.Количество;
	Сумма								= СтрокаОС.Сумма;
	НачисленнаяАмортизация				= СтрокаОС.СуммаАмортизации;
	ИнвНомер							= СокрП(СтрокаОС.ИнвНомерОС);
	ДатаПринятияКУчету					= СтрокаОС.ДатаПринятияКУчету;
	СостояниеОС							= СтрокаОС.СостояниеОС;
	НазваниеДокументаПринятияКУчету		= СтрокаОС.НазваниеДокументаПринятияКУчету;
	НомерДокументаПринятияКУчету		= СтрокаОС.НомерДокументаПринятияКУчету;
	
	ДатаВводаВЭксплуатацию				= СтрокаОС.ДатаВводаВЭксплуатацию;
	НазваниеДокументаВводаВЭксплуатацию	= СтрокаОС.НазваниеДокументаВводаВЭксплуатацию;
	НомерДокументаВводаВЭксплуатацию	= СтрокаОС.НомерДокументаВводаВЭксплуатацию;
	
	ПорядокПогашенияСтоимости			= СтрокаОС.ПорядокПогашенияСтоимости;
	СпособНачисленияАмортизации			= СтрокаОС.СпособНачисленияАмортизации;
	СрокПолезногоИспользования			= СтрокаОС.СрокПолезногоИспользования;
	СчетУчетаЗатрат						= СтрокаОС.СчетУчетаЗатрат;
	КОСГУСчетаЗатрат					= СтрокаОС.КЭКЗатрат;
	
	// Поля нал.учета "ОСН":
	ПорядокВключенияСтоимостиВСоставРасходовНУ	= СтрокаОС.ПорядокВключенияСтоимостиВСоставРасходовНУ;
	СрокПолезногоИспользованияНУ				= СтрокаОС.СрокПолезногоИспользованияНУ;
	МетодНачисленияАмортизацииНУ				= СтрокаОС.МетодНачисленияАмортизацииНУ;
	ПервоначальнаяСтоимостьНУ					= СтрокаОС.ПервоначальнаяСтоимостьНУ;
	СтатьяПрочихРасходов						= СтрокаОС.СтатьяПрочихРасходов;
	
	РасчетАмортизацииВручную			= СтрокаОС.РасчетАмортизацииВручную;
	РасчетАмортизацииСрокИспользования	= СтрокаОС.РасчетАмортизацииСрокИспользования;
	
	ЭтоСчетБиблФонда					= ПараметрыПроверкиПоСтроке["ЭтоСчетБиблФонда"];
	ПервыйПределОС						= ПараметрыПроверкиПоСтроке["ПрименяемыеПределыСтоимостиОС"]["ПервыйПределОС"];
	ВторойПределОС						= ПараметрыПроверкиПоСтроке["ПрименяемыеПределыСтоимостиОС"]["ВторойПределОС"];
	ИспользуемаяДатаПределовОС			= ПараметрыПроверкиПоСтроке["ПрименяемыеПределыСтоимостиОС"]["ИспользуемаяДата"];
	
	Если НЕ ЗначениеЗаполнено(ВторойПределОС) Тогда
		Текст = НСтр("ru='Не заданы пределы стоимости ОС на дату %1 (см. регистр сведений ""Параметры учета ОС"")'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
			Формат(ИспользуемаяДатаПределовОС, "ДЛФ=Д"));
		ИмяПоляДляВыводаСообщения = "ДатаПринятияКУчету";
		Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
		Возврат Результат;
	КонецЕсли;
	
	//
	// НАЛ.УЧЕТ
	//
	Если ОтражатьВНалУчетеОСН Тогда
		
		Если НЕ ЗначениеЗаполнено(ПервоначальнаяСтоимостьНУ) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru = 'Первоначальная стоимость (НУ)'"));
			ИмяПоляДляВыводаСообщения = "ПервоначальнаяСтоимостьНУ";
			Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
		КонецЕсли;
		
		Если ПорядокВключенияСтоимостиВСоставРасходовНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации Тогда
			
			Если НЕ ЗначениеЗаполнено(СрокПолезногоИспользованияНУ) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
					"Поле", "Заполнение", НСтр("ru = 'Срок полезного использования (НУ)'"));
				ИмяПоляДляВыводаСообщения = "СрокПолезногоИспользованияНУ";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДатаВводаВЭксплуатацию) И ДатаВводаВЭксплуатацию < Дата(2009, 1, 1)
				И НЕ ЗначениеЗаполнено(МетодНачисленияАмортизацииНУ) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
					"Поле", "Заполнение", НСтр("ru = 'Метод начисления амортизации (НУ)'"));
				ИмяПоляДляВыводаСообщения = "МетодНачисленияАмортизацииНУ";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
			КонецЕсли;
			
		КонецЕсли;
		
		ВыбранСчетПрочихРасходов = БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетУчетаЗатрат, "401.20");
		Если НЕ ЗначениеЗаполнено(СтатьяПрочихРасходов)	И ВыбранСчетПрочихРасходов И
			(ПорядокВключенияСтоимостиВСоставРасходовНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации
			ИЛИ ПорядокВключенияСтоимостиВСоставРасходовНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету
			)	Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru = 'Статья прочих расходов'"));
			ИмяПоляДляВыводаСообщения = "СтатьяПрочихРасходов";
			Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	
	//
	// БУХ.УЧЕТ
	//
	Если ОтражатьВБухУчете Тогда
		
		Если СостояниеОС = Перечисления.СостоянияОС.ВведеноВЭксплуатацию
			И НЕ ЗначениеЗаполнено(ДатаВводаВЭксплуатацию) Тогда
			
			ТекстСообщения = НСтр("ru='Не задана дата ввода ОС в эксплуатацию'");
			ИмяПоляДляВыводаСообщения = "ДатаВводаВЭксплуатацию";
			Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
			
			Возврат Результат;
		КонецЕсли;
		
		Цена = ?(Количество=0,0,Сумма/Количество);
		Если Цена > 0 И Цена < 0.01 Тогда
			ТекстСообщения = НСтр("ru='Цена ОС менее одной копейки'");
			ИмяПоляДляВыводаСообщения = "Сумма";
			Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
		КонецЕсли;
		
		Если НЕ ГрупповойУчет Тогда
			Если Количество>1 Тогда
				ТекстСообщения = НСтр("ru='Количество ОС больше 1 для ОС, по которому не ведется групповой учет'");
				ИмяПоляДляВыводаСообщения = "Количество";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ИнвНомер) И Цена > ПервыйПределОС Тогда
				ТекстСообщения = НСтр("ru='Не задан инвентарный номер для ОС, по которому ведется индивидуальный учет'");
				ИмяПоляДляВыводаСообщения = "ИнвНомерОС";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
			КонецЕсли;
			
		Иначе
			Если ЗначениеЗаполнено(ИнвНомер) Тогда 
				Если Количество>1 Тогда
					ТекстСообщения = НСтр("ru='Количество ОС больше 1 для ОС, по которому введен инвентарный номер. Для каждого инвентарного номера нужно ввести свою строку с количеством, равным 1'");
					ИмяПоляДляВыводаСообщения = "Количество";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				КонецЕсли;
				
			Иначе
				Если ЭтоСчетБиблФонда Тогда
					Если  Цена > ВторойПределОС Тогда
						Текст = НСтр("ru='Для библиотечного фонда стоимостью более %1 руб. должен быть задан инвентарный номер'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ВторойПределОС);
						ИмяПоляДляВыводаСообщения = "Сумма";
						Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					КонецЕсли;
					
				Иначе
					Если  Цена > ПервыйПределОС Тогда
						Текст = НСтр("ru='Для ОС стоимостью более %1 руб. должен быть задан инвентарный номер'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ПервыйПределОС);
						ИмяПоляДляВыводаСообщения = "Сумма";
						Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		Если ГрупповойУчет И (Цена > ВторойПределОС) Тогда
			Текст = НСтр("ru='Цена ОС более %1 руб. Групповой учет не возможен'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ВторойПределОС);
			ИмяПоляДляВыводаСообщения = "Сумма";
			Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
		КонецЕсли;
		
		Если ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
			ИЛИ	ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию Тогда
			
			Если ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации Тогда
				Если НачисленнаяАмортизация > Сумма Тогда 
					ТекстСообщения = НСтр("ru='Сумма амортизации больше стоимости'");
					ИмяПоляДляВыводаСообщения = "СуммаАмортизации";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					
				ИначеЕсли (НачисленнаяАмортизация < Сумма) И (НачисленнаяАмортизация > 0) Тогда 
					Если ГрупповойУчет Тогда
						ТекстСообщения = НСтр("ru='Сумма амортизации больше 0 и не равна стоимости ОС. Групповой учет таких ОС запрещен'");
						ИмяПоляДляВыводаСообщения = "СуммаАмортизации";
						Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СчетУчетаЗатрат) Тогда
				Если СчетУчетаЗатрат.УчетПоКЭК И НЕ ЗначениеЗаполнено(КОСГУСчетаЗатрат) Тогда
					ТекстСообщения = НСтр("ru='Не выбран КЭК счета для отнесения затрат'");
					ИмяПоляДляВыводаСообщения = "КЭКЗатрат";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				КонецЕсли;
			Иначе
				ТекстСообщения = НСтр("ru='Не выбран счет для отнесения затрат'");
				ИмяПоляДляВыводаСообщения = "СчетУчетаЗатрат";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
			КонецЕсли;
			
			Если ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации Тогда
				
				Если НЕ ЗначениеЗаполнено(СпособНачисленияАмортизации) Тогда
					ТекстСообщения = НСтр("ru='Не определен способ начисления амортизации'");
					ИмяПоляДляВыводаСообщения = "СпособНачисленияАмортизации";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(ИнвНомер)
					И НЕ ЭтоСчетБиблФонда Тогда
					
					ТекстСообщения = НСтр("ru='Не задан инвентарный номер для ОС, по которому будет начисляться амортизация'");
					ИмяПоляДляВыводаСообщения = "ИнвНомерОС";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				КонецЕсли;
				
				Если Цена <= ПервыйПределОС
					И СпособНачисленияАмортизации <> Перечисления.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию Тогда
					
					Текст = НСтр("ru='Цена ОС менее %1 руб., поэтому возможно только начисление 100% амортизации при вводе в эксплуатацию'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ПервыйПределОС);
					ИмяПоляДляВыводаСообщения = "СпособНачисленияАмортизации";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				КонецЕсли;
				
				Если СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.Линейный Тогда
					Если Цена <= ВторойПределОС Тогда
						Текст = НСтр("ru='Цена ОС менее %1 руб., линейный способ начисления амортизации не применяется'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ВторойПределОС);
						ИмяПоляДляВыводаСообщения = "СпособНачисленияАмортизации";
						Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					КонецЕсли;
					
					Если СрокПолезногоИспользования = 0 Тогда
						ТекстСообщения = НСтр("ru='Не задан срок полезного использования ОС'");
						ИмяПоляДляВыводаСообщения = "СрокПолезногоИспользования";
						Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					КонецЕсли;
					
					Если РасчетАмортизацииВручную И РасчетАмортизацииСрокИспользования > СрокПолезногоИспользования Тогда
						ТекстСообщения = НСтр("ru='Оставшийся срок использования не может быть больше срока полезного использования'");
						ИмяПоляДляВыводаСообщения = "РасчетАмортизацииСрокИспользования";
						Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					КонецЕсли;
					
				Иначе
					Если Цена > ВторойПределОС Тогда
						Текст = НСтр("ru='Цена ОС более %1 руб., начисление амортизации должно производиться линейно'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ВторойПределОС);
						ИмяПоляДляВыводаСообщения = "СпособНачисленияАмортизации";
						Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					КонецЕсли;
					
				КонецЕсли;
			Иначе // ПорядокПогашенияСтоимости = "Списание при вводе в эксплуатацию"
				
				Если ЗначениеЗаполнено(СпособНачисленияАмортизации) Тогда
					ТекстСообщения = НСтр("ru='Способ начисления амортизации задается только в случае выбора способа погашения стоимости ""Начисление амортизации""'");
					ИмяПоляДляВыводаСообщения = "СпособНачисленияАмортизации";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				КонецЕсли;
				
				Если Цена > ПервыйПределОС Тогда
					Текст = НСтр("ru='Не списываются с учета ОС дороже %1 руб.'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ПервыйПределОС);
					ИмяПоляДляВыводаСообщения = "ПорядокПогашенияСтоимости";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				КонецЕсли;
				
			КонецЕсли;
		Иначе // ПорядокПогашенияСтоимости = "Стоимость не погашается"
			
			Если ЗначениеЗаполнено(СпособНачисленияАмортизации) Тогда
				ТекстСообщения = НСтр("ru='Способ начисления амортизации задается только в случае выбора способа погашения стоимости ""Начисление амортизации""'");
				ИмяПоляДляВыводаСообщения = "СпособНачисленияАмортизации";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
			КонецЕсли;
			
			Если ЭтоСчетБиблФонда Тогда
				ТекстСообщения = НСтр("ru='Порядок погашения стоимости (для библиотечного фонда) должен быть ""Начисление амортизации""'");
				ИмяПоляДляВыводаСообщения = "ПорядокПогашенияСтоимости";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				
			ИначеЕсли (Цена > ПервыйПределОС) Тогда
				ТекстСообщения = НСтр("ru='Порядок погашения стоимости должен быть ""Начисление амортизации""'");
				ИмяПоляДляВыводаСообщения = "ПорядокПогашенияСтоимости";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Печать_ОС_Ведомость(МассивОбъектов, ОбъектыПечати)
	
	// Свойства реквизитов, выводимых в каждой строке ведомости, не заполняем.
	// Они заполнятся автоматически по всем полям табличных частей "ОС Основная" и "ОС Амортизация".
	СвойстваРеквизитов = Новый Структура();
	
	// Список полей, по которым нужно выводить итоги:
	ИменаИтоговыхПолей = Новый Массив();
	ИменаИтоговыхПолей.Добавить("Сумма");
	ИменаИтоговыхПолей.Добавить("Количество");
	ИменаИтоговыхПолей.Добавить("СуммаАмортизации");
	
	ТабДокумент = Получить_Ведомость_ОС(
		МассивОбъектов,
		ОбъектыПечати,
		Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства,
		СвойстваРеквизитов,
		ИменаИтоговыхПолей);
	
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента_ОС(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	РезультатПроверки = Неопределено;
	РежимВводаОстатков_ПроверитьЗаполнение(ДокументСсылка, РезультатПроверки);
	
	НомераТаблиц = Новый Структура;
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДокСсылка",						ДокументСсылка);
	Запрос.УстановитьПараметр("ОтражатьВНалоговомУчете",		ДокументСсылка.ОтражатьВНалоговомУчете);
	Запрос.УстановитьПараметр("Организация",					ДокументСсылка["Организация"]);
	Запрос.УстановитьПараметр("ВеличинаНесущественнойРазницы",	1);
	Запрос.УстановитьПараметр("ПустаяДата",						'00010101');
	Запрос.УстановитьПараметр("ВалютаРУ",						Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("УчетПоПодразделениям",			УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям());
	
	Если ДокументСсылка.ОтражатьВБухгалтерскомУчете Тогда
		// Нужно использовать временные таблицы с табличными частями
		ДобавитьПриНеобходимостиВременнуюТаблицу("ОС_Основная",				Запрос, НомераТаблиц);
		ДобавитьПриНеобходимостиВременнуюТаблицу("ОС_Амортизация",			Запрос, НомераТаблиц);
		ДобавитьПриНеобходимостиВременнуюТаблицу("ПолнаяТабличнаяЧастьОС",	Запрос, НомераТаблиц);
		
		НомераТаблиц.Вставить("СобытияОС",									НомераТаблиц.Количество());
		НомераТаблиц.Вставить("НачислениеАмортизацииОСБухгалтерскийУчет",	НомераТаблиц.Количество());
		НомераТаблиц.Вставить("АмортизацияОС",								НомераТаблиц.Количество());
		НомераТаблиц.Вставить("ВременнаяТаблицаЛинейный",					НомераТаблиц.Количество());
		НомераТаблиц.Вставить("ВременнаяТаблицаЛинейный2",					НомераТаблиц.Количество());
		НомераТаблиц.Вставить("РасчетАмортизацииОС",						НомераТаблиц.Количество());
		НомераТаблиц.Вставить("АмортизацияОбъектовОС",						НомераТаблиц.Количество());
		НомераТаблиц.Вставить("КапРемонтОС",								НомераТаблиц.Количество());
		НомераТаблиц.Вставить("ПереоценкаНФА",								НомераТаблиц.Количество());
		НомераТаблиц.Вставить("ПараметрыАмортизацииОСБухгалтерскийУчет",	НомераТаблиц.Количество());
		НомераТаблиц.Вставить("НомераИнвентарныхКарточек",					НомераТаблиц.Количество());
		НомераТаблиц.Вставить("ПервоначальныеСведенияОСБухгалтерскийУчет",	НомераТаблиц.Количество());
		НомераТаблиц.Вставить("СтоимостьОбъектовОС",						НомераТаблиц.Количество());
		
		ДобавитьТекстЗапроса(Запрос.Текст, "
		|////////////////////////////////////////////////////////////////////////////////
		|// [3]. Движения по рег.свед. СобытияОС
		|//
		|// События 'Принятие к учету':
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Ссылка.Организация										КАК Организация,
		|	Ссылка.Дата												КАК Период,
		|	ОС														КАК ОсновноеСредство,
		|	ИнвНомерОС												КАК ИнвНомер,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)		КАК Событие,
		|	ВЫБОР
		|		КОГДА ДатаПринятияКУчету = &ПустаяДата ТОГДА
		|			Ссылка.Дата
		|		ИНАЧЕ
		|			ДатаПринятияКУчету
		|	КОНЕЦ													КАК ДатаСобытия,
		|	НазваниеДокументаПринятияКУчету							КАК НазваниеДокумента,
		|	НомерДокументаПринятияКУчету							КАК НомерДокумента,
		|	ДатаПринятияКУчету										КАК	ДатаДокумента
		|ИЗ
		|	ПолнаяТабличнаяЧастьОС
		|ГДЕ
		|	НЕ СостояниеОС = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|// События 'Ввод в эксплуатацию':
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Ссылка.Организация										КАК Организация,
		|	Ссылка.Дата												КАК Период,
		|	ОС														КАК ОсновноеСредство,
		|	ИнвНомерОС												КАК ИнвНомер,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)	КАК Событие,
		|	ВЫБОР
		|		КОГДА ДатаВводаВЭксплуатацию = &ПустаяДата ТОГДА
		|			Ссылка.Дата
		|		ИНАЧЕ
		|			ДатаВводаВЭксплуатацию
		|	КОНЕЦ													КАК ДатаСобытия,
		|	НазваниеДокументаВводаВЭксплуатацию						КАК НазваниеДокумента,
		|	НомерДокументаВводаВЭксплуатацию						КАК НомерДокумента,
		|	ДатаВводаВЭксплуатацию									КАК	ДатаДокумента
		|ИЗ
		|	ПолнаяТабличнаяЧастьОС
		|ГДЕ
		|	СостояниеОС = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
		|УПОРЯДОЧИТЬ ПО
		|	ОсновноеСредство
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// [4]. Движения по рег.свед. НачислениеАмортизацииОСБухгалтерскийУчет
		|//
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Ссылка.Организация			КАК Организация,
		|	Ссылка.Дата					КАК Период,
		|	ОС							КАК ОсновноеСредство,
		|	НачислятьАмортизацию		КАК НачислятьАмортизацию
		|ИЗ
		|	ОС_Амортизация	КАК ОС_Амортизация
		|ГДЕ
		|	СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный) 
		|	И	ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации) 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// [5]. Движения по рег.свед. АмортизацияОС
		|//
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Ссылка.Организация			КАК Организация,
		|	Ссылка.Дата					КАК Период,
		|	ОС							КАК ОсновноеСредство,
		|	СчетУчетаЗатрат				КАК СчетУчетаЗатрат,
		|	КЭКЗатрат					КАК КЭК,
		|	СубконтоЗатрат1				КАК Субконто1,
		|	СубконтоЗатрат2				КАК Субконто2,
		|	СубконтоЗатрат3				КАК Субконто3,
		|	КПСЗатрат					КАК КПС,
		|	ПодразделениеЗатрат			КАК Подразделение,
		|	ВЫБОР
		|		КОГДА &ОтражатьВНалоговомУчете = ИСТИНА ТОГДА
		|			СтатьяПрочихРасходов
		|		ИНАЧЕ
		|			НЕОПРЕДЕЛЕНО
		|	КОНЕЦ						КАК СубконтоНУ
		|ИЗ
		|	ОС_Амортизация	КАК ОС_Амортизация
		|ГДЕ
		|	ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
		|	ИЛИ	ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// [6]. (Подготовка) Строки с линейным начислением амортизации, для которых
		|//		будет рассчитываться оставшийся срок полезного использования и стоимость.
		|//		(Движения по регистру ""РасчетАмортизацииОС"")
		|ВЫБРАТЬ
		|	ПериодПринятиеКУчету				КАК Период,
		|	ОС									КАК ОсновноеСредство,
		|	СрокПолезногоИспользования			КАК СрокПолезногоИспользования,
		|	РАЗНОСТЬДАТ(
		|		ВЫБОР
		|			КОГДА СостояниеОС = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету) ТОГДА
		|				КОНЕЦПЕРИОДА(ДатаПринятияКУчету, МЕСЯЦ)
		|			ИНАЧЕ
		|				// ВведеноВЭксплуатацию
		|				ВЫБОР
		|					КОГДА ДатаПринятияКУчету <= ДатаВводаВЭксплуатацию ТОГДА
		|						КОНЕЦПЕРИОДА(ДатаПринятияКУчету, МЕСЯЦ)
		|					ИНАЧЕ
		|						КОНЕЦПЕРИОДА(ДатаВводаВЭксплуатацию, МЕСЯЦ)
		|				КОНЕЦ
		|		КОНЕЦ,
		|		КОНЕЦПЕРИОДА(Ссылка.Дата, МЕСЯЦ),
		|		МЕСЯЦ
		|	)									КАК СрокФактическогоИспользования,
		|	Сумма - СуммаАмортизации			КАК ОстаточнаяСтоимость,
		|	ВЫБОР
		|		КОГДА СрокПолезногоИспользования = 0 ТОГДА
		|			0
		|		ИНАЧЕ
		|			Сумма / СрокПолезногоИспользования
		|	КОНЕЦ								КАК ПрежняяМесячнаяАмортизация,
		|	
		|	РасчетАмортизацииВручную			КАК РасчетАмортизацииВручную,
		|	РасчетАмортизацииСрокИспользования	КАК РасчетАмортизацииСрокИспользования,
		|	РасчетАмортизацииСтоимость			КАК РасчетАмортизацииСтоимость,
		|	РасчетАмортизацииПериод				КАК РасчетАмортизацииПериод
		|ПОМЕСТИТЬ
		|	Линейный
		|ИЗ
		|	ПолнаяТабличнаяЧастьОС
		|ГДЕ		
		|	НЕ	СостояниеОС					= ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
		|	И	ПорядокПогашенияСтоимости	= ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
		|	И	СпособНачисленияАмортизации	= ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// [7]. (Подготовка) Строки с линейным начислением амортизации, а также
		|//		разность месячных амортизаций.
		|//		(Движения по регистру ""РасчетАмортизацииОС"")
		|ВЫБРАТЬ
		|	Линейный.Период						КАК Период,
		|	Линейный.ОсновноеСредство			КАК ОсновноеСредство,
		|	Линейный.СрокПолезногоИспользования	КАК СрокПолезногоИспользования,
		|	Линейный.ОстаточнаяСтоимость		КАК ОстаточнаяСтоимость,
		|	
		|	ВЫБОР
		|		КОГДА Линейный.СрокПолезногоИспользования <= Линейный.СрокФактическогоИспользования ТОГДА
		|			1
		|		ИНАЧЕ
		|			Линейный.СрокПолезногоИспользования - Линейный.СрокФактическогоИспользования
		|	КОНЕЦ								КАК СрокИспользованияДляВычисленияАмортизации,
		|	
		|	Линейный.ПрежняяМесячнаяАмортизация -
		|		// Новая месячная амортизация:
		|		(Линейный.ОстаточнаяСтоимость /
		|			// Срок использования для вычисления амортизации:
		|			ВЫБОР
		|				КОГДА Линейный.СрокПолезногоИспользования <= Линейный.СрокФактическогоИспользования ТОГДА
		|					1
		|				ИНАЧЕ
		|					Линейный.СрокПолезногоИспользования - Линейный.СрокФактическогоИспользования
		|			КОНЕЦ)						КАК РазностьАмортизаций,
		|	
		|	РасчетАмортизацииВручную			КАК РасчетАмортизацииВручную,
		|	РасчетАмортизацииСрокИспользования	КАК РасчетАмортизацииСрокИспользования,
		|	РасчетАмортизацииСтоимость			КАК РасчетАмортизацииСтоимость,
		|	РасчетАмортизацииПериод				КАК РасчетАмортизацииПериод
		|ПОМЕСТИТЬ
		|	Линейный2
		|ИЗ
		|	Линейный	
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// [8]. Движения по рег.свед. РасчетАмортизацииОС
		|//
		|// Строки с линейным начислением амортизации:
		|ВЫБРАТЬ
		|	&Организация							КАК Организация,
		|	ВЫБОР
		|		КОГДА Линейный2.РасчетАмортизацииВручную ТОГДА
		|			Линейный2.РасчетАмортизацииПериод
		|		ИНАЧЕ
		|			Линейный2.Период
		|	КОНЕЦ									КАК Период,
		|	Линейный2.ОсновноеСредство				КАК ОсновноеСредство,
		|	Линейный2.СрокПолезногоИспользования	КАК СрокПолезногоИспользования,
		|	
		|	ВЫБОР
		|		КОГДА Линейный2.РасчетАмортизацииВручную ТОГДА
		|			Линейный2.РасчетАмортизацииСрокИспользования
		|		ИНАЧЕ
		|			ВЫБОР
		|				КОГДА Линейный2.ОстаточнаяСтоимость > 0
		|					И	(	Линейный2.РазностьАмортизаций > &ВеличинаНесущественнойРазницы
		|						ИЛИ	Линейный2.РазностьАмортизаций < -&ВеличинаНесущественнойРазницы) ТОГДА
		|					Линейный2.СрокИспользованияДляВычисленияАмортизации
		|				ИНАЧЕ
		|					0
		|			КОНЕЦ
		|	КОНЕЦ									КАК СрокИспользованияДляВычисленияАмортизации,
