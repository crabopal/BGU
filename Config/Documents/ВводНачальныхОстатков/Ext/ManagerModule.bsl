Функция ПолучитьСоответствиеСубконтоКолонка() Экспорт
	
	ВремСоотв = Новый Соответствие();
	
	ВремСоотв.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства,		"ОС");
	ВремСоотв.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО,					"ЦМО");
	ВремСоотв.Вставить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура,			"Номенклатура");
	ВремСоотв.Вставить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты,			"Контрагент");
	ВремСоотв.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ВидыДенежныхДокументов,	"ВидДенежныхДокументов");
	ВремСоотв.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ДенежныеДокументы,		"ДенежныйДокумент");
	ВремСоотв.Вставить(ПланыВидовХарактеристик.ВидыСубконто.Договоры,				"Договор");
	
	Возврат ВремСоотв;
	
КонецФункции

Функция ПолучитьТаблицуСчетов_Материалы_Общая(ДатаДокумента = Неопределено)
	
	Перем ТаблицаНастроекИнвентаризации;
	
	// Ожидается, что в полученной таблице счет 105.00 находится в самой первой строке.
	// Необходимо оставить это в неприкосновенности, т.к. в дальнейшем логика работы
	// ожидает именно счета 105.00 в первых двух строках таблицы.
	//
	// Для ввода остатков требуется немного изменить состав используемых счетов
	// в сравнении с инвентаризацией.
	//
	// Добавить счета:
	//	105.00 (розница, наценка)
	//	08
	//
	// Удалить счета:
	//	106.00
	
	ДляСвертки = (ДатаДокумента = Неопределено);
	
	Если ДляСвертки Тогда
		// Заполняем для свертки остатками
		// Получаем таблицы настроек на все даты изменения счетов учета
		
		МассивСчетов = Новый Массив();
		
		МассивДат = Новый Массив(Документы.ИнвентаризацияМЗ.ПолучитьДатыИзмененияСоставаГруппСчетов());
		
		СамаяПерваяДата = НачалоДня(МассивДат[0] - 1);
		
		МассивДат.Вставить(0, СамаяПерваяДата);
		
		Поиск = Новый Структура("ОсновнойСчетГруппы");
		
		Для Каждого НаДату Из МассивДат Цикл
			ВремТаблица = Документы.ИнвентаризацияМЗ.ПолучитьТаблицуНастроекГруппСчетовДляВводаОстатковМЗ(НаДату);
			
			Если ТаблицаНастроекИнвентаризации = Неопределено Тогда
				ТаблицаНастроекИнвентаризации = ВремТаблица;
			Иначе
				Для Каждого СтрокаТаблицы Из ВремТаблица Цикл
					ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
					
					МассивСтрок = ТаблицаНастроекИнвентаризации.НайтиСтроки(Поиск);
					
					Если МассивСтрок.Количество() = 0 Тогда
						НоваяСтрока = ТаблицаНастроекИнвентаризации.Добавить();
						
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		// Заполняем для одного документа ввода остатков
		// Получаем таблицу настроек на одну определенную дату
		
		НаДату = ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(ДатаДокумента);
		
		ТаблицаНастроекИнвентаризации = Документы.ИнвентаризацияМЗ.ПолучитьТаблицуНастроекГруппСчетовДляВводаОстатковМЗ(НаДату);
	КонецЕсли;
	
	ТабСвойстваСчетов = Новый ТаблицаЗначений();
	ТабСвойстваСчетов.Колонки.Добавить("Ключ",					Новый ОписаниеТипов("Строка"));
	ТабСвойстваСчетов.Колонки.Добавить("СчетГруппа",			Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТабСвойстваСчетов.Колонки.Добавить("ДопустимыеСчета",		Новый ОписаниеТипов("ТаблицаЗначений"));
	ТабСвойстваСчетов.Колонки.Добавить("ВидСубконто1",			Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ТабСвойстваСчетов.Колонки.Добавить("ВидСубконто2",			Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ТабСвойстваСчетов.Колонки.Добавить("ВидСубконто3",			Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ТабСвойстваСчетов.Колонки.Добавить("ВидыСубконто",			Новый ОписаниеТипов("СписокЗначений"));
	ТабСвойстваСчетов.Колонки.Добавить("Недействующий",			Новый ОписаниеТипов("Булево"));
	ТабСвойстваСчетов.Колонки.Добавить("НеПредусмотрен",		Новый ОписаниеТипов("Булево"));
	
	// Истина, если хотя бы у одного счета из группы этот признак=Истина:
	ТабСвойстваСчетов.Колонки.Добавить("УчетПоКПС",				Новый ОписаниеТипов("Булево"));
	ТабСвойстваСчетов.Колонки.Добавить("УчетПоКЭК",				Новый ОписаниеТипов("Булево"));
	ТабСвойстваСчетов.Колонки.Добавить("УчетПоПодразделениям",	Новый ОписаниеТипов("Булево"));
	ТабСвойстваСчетов.Колонки.Добавить("Количественный",		Новый ОписаниеТипов("Булево"));
	
	ТабСвойстваСчетов.Колонки.Добавить("НаДату",				Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	
	ИсключаемыеСчета = Новый Массив();
	ИсключаемыеСчета.Добавить(БухгалтерскийУчет.СчетПоКоду("106.00", '20210101'));
	
	ОсобыеСчета105 = Документы.ВводНачальныхОстатков.ПолучитьОсобыеСчета10500();
	
	Ключ = -1;
	
	Для Каждого СтрокаТаблицы Из ТаблицаНастроекИнвентаризации Цикл
		Если ИсключаемыеСчета.Найти(СтрокаТаблицы["ОсновнойСчетГруппы"]) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = Ключ + 1;
		КлючСтрокой = Формат(Ключ, "ЧН=;ЧГ=0");
		
		НоваяСтрока = ТабСвойстваСчетов.Добавить();
		НоваяСтрока["Ключ"]	= КлючСтрокой;
		НоваяСтрока["СчетГруппа"]	= СтрокаТаблицы["ОсновнойСчетГруппы"];
		НоваяСтрока["ВидСубконто1"]	= ПланыВидовХарактеристик.ВидыСубконто.Номенклатура;
		НоваяСтрока["ВидСубконто2"]	= СтрокаТаблицы["СубконтоДляМОЛ"];
		
		Если СтрокаТаблицы["ИспользуетсяДополнительноеСубконто"] Тогда
			НоваяСтрока["ВидСубконто3"]	= СтрокаТаблицы["ДополнительноеСубконто"];
		КонецЕсли;
		
		НоваяСтрока["ДопустимыеСчета"] = ПолучитьПустуюТаблицуДопустимыхСчетов();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "НаДату");
		
		Если Ключ = 0 Тогда
			Ключ = Ключ + 1;
			КлючСтрокой = Формат(Ключ, "ЧН=;ЧГ=0");
			
			НоваяСтрока = ТабСвойстваСчетов.Добавить();
			НоваяСтрока["Ключ"]	= КлючСтрокой;
			НоваяСтрока["СчетГруппа"]	= СтрокаТаблицы["ОсновнойСчетГруппы"];
			НоваяСтрока["ВидСубконто1"]	= СтрокаТаблицы["СубконтоДляМОЛ"];
			
			НоваяСтрока["ДопустимыеСчета"] = ПолучитьПустуюТаблицуДопустимыхСчетов();
			Для Каждого Счет Из ОсобыеСчета105 Цикл
				НоваяСтрокаДопустимыйСчет = НоваяСтрока["ДопустимыеСчета"].Добавить();
				НоваяСтрокаДопустимыйСчет.Счет = Счет;
			КонецЦикла;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "НаДату");
		КонецЕсли;
	КонецЦикла;
	
	Счет08 = БухгалтерскийУчет.СчетПоКоду("08", НаДату);
	
	Если ЗначениеЗаполнено(Счет08) Тогда
		Ключ = Ключ + 1;
		КлючСтрокой = Формат(Ключ, "ЧГ=0");
		
		НоваяСтрока = ТабСвойстваСчетов.Добавить();
		НоваяСтрока["Ключ"]	= КлючСтрокой;
		НоваяСтрока["СчетГруппа"]	= Счет08;
		НоваяСтрока["ВидСубконто1"]	= ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
		НоваяСтрока["ВидСубконто2"]	= ПланыВидовХарактеристик.ВидыСубконто.ДенежныеДокументы;
		НоваяСтрока["ВидСубконто3"]	= ПланыВидовХарактеристик.ВидыСубконто.ВидыДенежныхДокументов;
		
		НоваяСтрока["ДопустимыеСчета"] = ПолучитьПустуюТаблицуДопустимыхСчетов();
		
		НоваяСтрока["НаДату"] = НаДату;
	КонецЕсли;
	
	Возврат ТабСвойстваСчетов;
	
КонецФункции

// Возвращает заполненную таблицу счетов допустимых счетов, а также СписокВыбора.
// Параметры:
//	Организация, ИФО, Дата	- используются для дополнительного отбора счетов,
//							которые соответствуют учетной политике организации
//							на указанную дату.
Функция ПолучитьТаблицуСчетов_Материалы(ДокументОбъект, СписокВыбора) Экспорт
	
	Дата = ДокументОбъект.Дата;
	
	ТабСвойстваСчетов = ПолучитьТаблицуСчетов_Материалы_Общая(Дата);
	
	Материалы_ЗаполнитьДетальныеСчета(ДокументОбъект, СписокВыбора, ТабСвойстваСчетов);
	
	СостоянияПоддержки = Материалы_СостоянияПоддержкиСчетаГруппы();
	
	СчетГруппа = Материалы_ОпределитьСчетГруппу(ДокументОбъект, ТабСвойстваСчетов);
	
	Если СчетГруппа.СостояниеПоддержки = СостоянияПоддержки.Недействующий ИЛИ СчетГруппа.СостояниеПоддержки = СостоянияПоддержки.НеПредусмотрен Тогда
		Материалы_ДобавитьНеподдерживаемыйСчетГруппу(ДокументОбъект, СчетГруппа, ТабСвойстваСчетов, СписокВыбора, СостоянияПоддержки);
	КонецЕсли;
	
	Возврат ТабСвойстваСчетов;
	
КонецФункции

Функция ПолучитьТаблицуСчетов_Материалы_ДляСвертки(ДатаВводаОстатков = Неопределено) Экспорт
	
	ТабСвойстваСчетов = ПолучитьТаблицуСчетов_Материалы_Общая(ДатаВводаОстатков);
	
	ШапкаДокумента = Новый Структура("Организация,ИФО,Дата");
	
	ВремСписок = Новый СписокЗначений();
	
	Материалы_ЗаполнитьДетальныеСчета(ШапкаДокумента, ВремСписок, ТабСвойстваСчетов);
	
	Возврат ТабСвойстваСчетов;
	
КонецФункции

Функция ПолучитьМассивСчетов_Материалы_ДляСвертки(ДатаВводаОстатков = Неопределено, Знач ТабСвойстваСчетов = Неопределено) Экспорт
	
	Если ТабСвойстваСчетов = Неопределено Тогда
		ТабСвойстваСчетов = ПолучитьТаблицуСчетов_Материалы_ДляСвертки(ДатаВводаОстатков);
	КонецЕсли;
	
	МассивСчетов = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТабСвойстваСчетов Цикл
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСчетов, СтрокаТаблицы["ДопустимыеСчета"].ВыгрузитьКолонку("Счет"), Истина);
	КонецЦикла;
	
	Возврат МассивСчетов;
	
КонецФункции

Функция ПолучитьСписокВидовСубконто(ДокументОбъект)
	
	ВремСписок = Новый СписокЗначений();
	
	ТабСвойстваСчетов = ПолучитьТаблицуСчетов_Материалы(ДокументОбъект, ВремСписок);
	
	Поиск = Новый Структура("СчетГруппа", ДокументОбъект["Счет"]);
	СтрокиТЗ = ТабСвойстваСчетов.НайтиСтроки(Поиск);
	КолвоСтрок = СтрокиТЗ.Количество();
	
	Если КолвоСтрок = 0 Тогда
		Возврат Неопределено;
		
	ИначеЕсли КолвоСтрок = 1 Тогда
		СвойстваСчета = СтрокиТЗ[0];
		
	Иначе
		// КолвоСтрок > 1
		// Счета, присутствующие в списке более 1 раза.
		Если ДокументОбъект.ОсобыеСчета10500 Тогда
			СвойстваСчета = СтрокиТЗ[1];
		Иначе
			СвойстваСчета = СтрокиТЗ[0];
		КонецЕсли;
	КонецЕсли;
	
	Если СвойстваСчета.НеПредусмотрен Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СвойстваСчета.ВидыСубконто;
	
КонецФункции

Функция ПолучитьОсобыеСчета10500() Экспорт
	
	Результат = Новый Массив();
	
	Результат.Добавить(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.Б8"));
	Результат.Добавить(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.29"));
	Результат.Добавить(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.Г8"));
	Результат.Добавить(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.39"));
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПустуюТаблицуДопустимыхСчетов()
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	ПустаяТаблица = Новый ТаблицаЗначений();
	
	ПустаяТаблица.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("УчетПоКПС", ТипБулево);
	ПустаяТаблица.Колонки.Добавить("УчетПоКЭК", ТипБулево);
	ПустаяТаблица.Колонки.Добавить("УчетПоПодразделениям", ТипБулево);
	ПустаяТаблица.Колонки.Добавить("Количественный", ТипБулево);
	
	Возврат ПустаяТаблица;
	
КонецФункции

Функция Материалы_ОпределитьСчетГруппу(ДокументОбъект, ТабСвойстваСчетов)
	
	СчетГруппа = Новый Структура("Счет,СостояниеПоддержки,СтрокаТаблицыСчетов");
	
	ПроверяемыйСчет = ДокументОбъект.Счет;
	
	Если НЕ ЗначениеЗаполнено(ПроверяемыйСчет) Тогда
		Возврат СчетГруппа;
	КонецЕсли;
	
	СостоянияПоддержки = Материалы_СостоянияПоддержкиСчетаГруппы();
	
	Для Каждого СтрокаТаблицы Из ТабСвойстваСчетов Цикл
		Если СтрокаТаблицы["СчетГруппа"] = ПроверяемыйСчет ИЛИ СтрокаТаблицы["ДопустимыеСчета"].Найти(ПроверяемыйСчет, "Счет") <> Неопределено Тогда
			СчетГруппа.Вставить("Счет",					СтрокаТаблицы["СчетГруппа"]);
			СчетГруппа.Вставить("СостояниеПоддержки",	СостоянияПоддержки.Действующий);
			
			Возврат СчетГруппа;
		КонецЕсли;
	КонецЦикла;
	
	ПолнаяТаблицаСчетов = ПолучитьТаблицуСчетов_Материалы_Общая();
	
	Для Каждого СтрокаТаблицы Из ПолнаяТаблицаСчетов Цикл
		Если СтрокаТаблицы["СчетГруппа"] = ПроверяемыйСчет ИЛИ СтрокаТаблицы["ДопустимыеСчета"].Найти(ПроверяемыйСчет, "Счет") <> Неопределено Тогда
			СчетГруппа.Вставить("Счет",					СтрокаТаблицы["СчетГруппа"]);
			СчетГруппа.Вставить("СостояниеПоддержки",	СостоянияПоддержки.Недействующий);
			СчетГруппа.Вставить("СтрокаТаблицыСчетов",	СтрокаТаблицы);
			
			Возврат СчетГруппа;
		КонецЕсли;
	КонецЦикла;
	
	СчетГруппа.Вставить("Счет",					ПроверяемыйСчет);
	СчетГруппа.Вставить("СостояниеПоддержки",	СостоянияПоддержки.НеПредусмотрен);
	СчетГруппа.Вставить("СтрокаТаблицыСчетов",	СтрокаТаблицы);
	
	Возврат СчетГруппа
	
КонецФункции

Функция Материалы_СостоянияПоддержкиСчетаГруппы()
	
	СостоянияПоддержки = Новый Структура();
	СостоянияПоддержки.Вставить("Действующий",		"Действующий");		// счета группы действуют на дату
	СостоянияПоддержки.Вставить("Недействующий",	"Недействующий");	// счета группы не действуют на дату (устарели)
	СостоянияПоддержки.Вставить("НеПредусмотрен",	"Не предусмотрен");	// ввод остатков по счету не предусмотрен
	
	Возврат СостоянияПоддержки;
	
КонецФункции

Процедура Материалы_ДобавитьНеподдерживаемыйСчетГруппу(ДокументОбъект, СчетГруппа, ТабСвойстваСчетов, СписокВыбора, СостоянияПоддержки)
	
	СвойстваСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетГруппа.Счет, "Код,Наименование");
	
	ПредставлениеГруппы = СтрШаблон(НСтр("ru='(%1) %2: %3'"),
		СчетГруппа.СостояниеПоддержки,
		СвойстваСчета.Код,
		СвойстваСчета.Наименование);
	
	// Добавляем строку в список выбора счета
	
	ПоследнийКлючСтрокой = СписокВыбора.Получить(СписокВыбора.Количество() - 1).Значение;
	
	НовыйКлючСтрокой = Строка(Число(ПоследнийКлючСтрокой) + 1);
	
	СписокВыбора.Добавить(НовыйКлючСтрокой, ПредставлениеГруппы);
	
	// Добавляем строку в таблицу счетов
	
	ВремТаблица = ТабСвойстваСчетов.СкопироватьКолонки();
	
	НоваяСтрока = ВремТаблица.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СчетГруппа.СтрокаТаблицыСчетов);
	
	НоваяСтрока["Ключ"] = НовыйКлючСтрокой;
	
	Если СчетГруппа.СостояниеПоддержки = СостоянияПоддержки.Недействующий Тогда
		НоваяСтрока["Недействующий"] = Истина;
	ИначеЕсли СчетГруппа.СостояниеПоддержки = СостоянияПоддержки.Непредусмотрен Тогда
		НоваяСтрока["НеПредусмотрен"] = Истина;
	КонецЕсли;
	
	ВремСписокВыбора = Новый СписокЗначений();
	
	Материалы_ЗаполнитьДетальныеСчета(ДокументОбъект, ВремСписокВыбора, ВремТаблица);
	
	НоваяСтрока = ТабСвойстваСчетов.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ВремТаблица[0]);
	
КонецПроцедуры

Процедура Материалы_ЗаполнитьДетальныеСчета(ДокументОбъект, СписокВыбора, ТабСвойстваСчетов)
	
	Организация	= ДокументОбъект.Организация;
	ИФО			= ДокументОбъект.ИФО;
	Дата		= ДокументОбъект.Дата;
	
	ОсобыеСчета105 = Документы.ВводНачальныхОстатков.ПолучитьОсобыеСчета10500();
	
	ЗапросСчета = Новый Запрос();
	
	////////////////////////////////////////////////////////////////////////////////
	//	Комментарий
	//	Составляет список счетов (в иерархии указанного), имеющих указанные виды субконто.
	//
	//	Параметры:	&Счет
	//				&СписокСчетовИсключений
	//				&ВидСубконтоА
	//				&ВидСубконтоБ
	//				&ВидСубконтоВ
	//
	//	Чтобы счет был выбран, он должен иметь КАК МИНИМУМ все указанные виды субконто (А, Б, В).
	//	
	
	// Составляем текст запроса:
	Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Все конечные счета (не группы) в иерархии указанного
	|//		и без счетов-исключений.
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыСубконто.Ссылка		КАК Счет,
	|	
	|	СУММА(ВЫБОР
	|		КОГДА ВидыСубконто.ВидСубконто = &ВидСубконтоА<1...N>
	|			ИЛИ ВидыСубконто.ВидСубконто = &ВидСубконтоБ<1...N>
	|			ИЛИ ВидыСубконто.ВидСубконто = &ВидСубконтоВ<1...N>
	|			ТОГДА
	|			1
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)					КАК КолвоИскомыхВидовСубконто,
	|	
	|	КОЛИЧЕСТВО(ВидыСубконто.ВидСубконто)	КАК КолвоВидовСубконто,
	|	
	|	СРЕДНЕЕ(ВЫБОР
	|		КОГДА &ВидСубконтоА<1...N> = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка) ТОГДА
	|			0
	|		ИНАЧЕ
	|			1
	|	КОНЕЦ
	|	+ ВЫБОР
	|		КОГДА &ВидСубконтоБ<1...N> = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка) ТОГДА
	|			0
	|		ИНАЧЕ
	|			1
	|	КОНЕЦ
	|	+ ВЫБОР
	|		КОГДА &ВидСубконтоВ<1...N> = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка) ТОГДА
	|			0
	|		ИНАЧЕ
	|			1
	|	КОНЕЦ)					КАК КоличествоЗаданныхСубконто
	|
	|ПОМЕСТИТЬ
	|	ВсеСчета<1...N>
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто	КАК ВидыСубконто
	|ГДЕ
	|	ВидыСубконто.Ссылка В ИЕРАРХИИ(&Счет<1...N>)
	|	И	НЕ ВидыСубконто.Ссылка В ИЕРАРХИИ(&СписокСчетовИсключений<1...N>)
	|	И	ВидыСубконто.Ссылка.ЭлементГруппа = ЛОЖЬ
	|СГРУППИРОВАТЬ ПО
	|	ВидыСубконто.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Искомые счета
	|//		(Финальная таблица)
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Счет						КАК Счет,
	|	Счет.Количественный			КАК Количественный,
	|	Счет.УчетПоКПС				КАК УчетПоКПС,
	|	Счет.УчетПоКЭК				КАК УчетПоКЭК,
	|	Счет.УчетПоПодразделениям	КАК УчетПоПодразделениям
	|ИЗ
	|	ВсеСчета<1...N>
	|ГДЕ
	|	КолвоИскомыхВидовСубконто = КоличествоЗаданныхСубконто
	|УПОРЯДОЧИТЬ ПО
	|	Счет.Порядок
	|ИТОГИ
	|	МАКСИМУМ(Счет.Количественный)		КАК Количественный,
	|	МАКСИМУМ(Счет.УчетПоКПС)			КАК УчетПоКПС,
	|	МАКСИМУМ(Счет.УчетПоКЭК)			КАК УчетПоКЭК,
	|	МАКСИМУМ(Счет.УчетПоПодразделениям)	КАК УчетПоПодразделениям
	|ПО
	|	ОБЩИЕ
	|;";
	
	сч = 0;
	ТекстЗапроса = "";
	Для Каждого СтрокаТЗ Из ТабСвойстваСчетов Цикл
		
		Заменитель_1_N = Строка(сч);
		ТекстЗапроса = ТекстЗапроса + СтрЗаменить(Текст, "<1...N>", Заменитель_1_N);
		
		Если СтрокаТЗ["ДопустимыеСчета"].Количество() > 0 Тогда
			СчетГруппа = СтрокаТЗ["ДопустимыеСчета"].ВыгрузитьКолонку("Счет");
		Иначе
			СчетГруппа = СтрокаТЗ["СчетГруппа"];
		КонецЕсли;
		
		СписокСчетовИсключений = Новый Массив();
		
		ЗапросСчета.УстановитьПараметр("Счет" + Заменитель_1_N,						СчетГруппа);
		ЗапросСчета.УстановитьПараметр("СписокСчетовИсключений" + Заменитель_1_N,	СписокСчетовИсключений);
		
		ЗапросСчета.УстановитьПараметр("ВидСубконтоА" + Заменитель_1_N,	СтрокаТЗ.ВидСубконто1);
		ЗапросСчета.УстановитьПараметр("ВидСубконтоБ" + Заменитель_1_N,	СтрокаТЗ.ВидСубконто2);
		ЗапросСчета.УстановитьПараметр("ВидСубконтоВ" + Заменитель_1_N,	СтрокаТЗ.ВидСубконто3);
		
		сч = сч + 1;
	КонецЦикла;
	
	ТекстОграниченияНаТипСчетов = "";
	
	Если ЗначениеЗаполнено(Организация) Тогда
		СтруктураРПС = БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(Организация, ИФО, Дата);
		
		Если ТипЗнч(СтруктураРПС) = Тип("СправочникСсылка.СтруктурыРПС") Тогда
			ТипПланаСчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураРПС, "ТипПланаСчетов");
			
			Если ЗначениеЗаполнено(ТипПланаСчетов) Тогда
				Если ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляАвтономных") Тогда
					ТекстОграниченияНаТипСчетов = "ДляАвтономных";
					
				ИначеЕсли ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляБюджетных") Тогда
					ТекстОграниченияНаТипСчетов = "ДляБюджетных";
					
				ИначеЕсли ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляКазенных") Тогда
					ТекстОграниченияНаТипСчетов = "ДляКазенных";
					
				КонецЕсли;
				
				ТекстОграниченияНаТипСчетов = "	И ВидыСубконто.Ссылка." + ТекстОграниченияНаТипСчетов + "=ИСТИНА";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Окончательная настройка текста запроса:
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ТекстОграниченияНаТипСчетов>", ТекстОграниченияНаТипСчетов);
	
	// Выполняем пакет запросов:
	ЗапросСчета.Текст = ТекстЗапроса;
	РезультатыЗапросов = ЗапросСчета.ВыполнитьПакет();
	
	ИндексРезультата = 0;
	ИндексРезультатаПодзапроса = 1; // [1].
	ПервыйПодзапрос = Истина;
	
    СписокВыбора.Очистить();
	
	Для Каждого СтрокаТЗ Из ТабСвойстваСчетов Цикл
		
		// Заполняем список видов субконто:
		СтрокаТЗ.ВидыСубконто = Новый СписокЗначений();
		Если ЗначениеЗаполнено(СтрокаТЗ.ВидСубконто1) Тогда
			СтрокаТЗ.ВидыСубконто.Добавить(СтрокаТЗ.ВидСубконто1);
		КонецЕсли;	
		Если ЗначениеЗаполнено(СтрокаТЗ.ВидСубконто2) Тогда
			СтрокаТЗ.ВидыСубконто.Добавить(СтрокаТЗ.ВидСубконто2);
		КонецЕсли;	
		Если ЗначениеЗаполнено(СтрокаТЗ.ВидСубконто3) Тогда
			СтрокаТЗ.ВидыСубконто.Добавить(СтрокаТЗ.ВидСубконто3);
		КонецЕсли;
		
		// Добавляем элемент в список выбора счета:
		ДопСтрока = "";
		Код = СтрокаТЗ.СчетГруппа.Код;
		Для к = СтрДлина(Код) по 4 Цикл
			ДопСтрока = ДопСтрока + " ";
		КонецЦикла;
		НаименованиеСчета = СтрокаТЗ.СчетГруппа.Наименование;
		Если СтрокаТЗ.Ключ = "1" Тогда
			НаименованиеСчета = НаименованиеСчета + " (товары в рознице, наценка)";
		КонецЕсли;
		СписокВыбора.Добавить(СтрокаТЗ.Ключ, "" + Код + ": " + ДопСтрока + НаименованиеСчета);
		
		// Заполняем строку таблицы "Свойства счетов":
		ИндексРезультата = ИндексРезультата + ИндексРезультатаПодзапроса + ?(ПервыйПодзапрос, 0, 1);
		ДЗСчета = РезультатыЗапросов[ИндексРезультата].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		// Есть вообще допустимые счета?
		Если ДЗСчета.Строки.Количество() > 0 Тогда
			СтрокаТЗ.ДопустимыеСчета.Очистить();
			
			// Общие (итоговые) признаки в целом по допустимым счетам:
			СтрокаИтого = ДЗСчета.Строки[0];
			ЗаполнитьЗначенияСвойств(СтрокаТЗ, СтрокаИтого);
			
			// Сами допустимые счета с признаками:
			Для Каждого СтрокаДЗ Из СтрокаИтого.Строки Цикл
				НоваяСтрока = СтрокаТЗ.ДопустимыеСчета.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДЗ);
			КонецЦикла;
		КонецЕсли;
		
		ПервыйПодзапрос = Ложь;
	КонецЦикла;
	
КонецПроцедуры

