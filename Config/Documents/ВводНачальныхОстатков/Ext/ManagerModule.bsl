	//	8			Строки основной таблицы (Материалы), для которых отсутствуют строки в зависимой (Затраты).
	РезультатПроверки = РезультатыПроверок[8];
	ИмяТаблЧастиДляВыводаСообщений = "Материалы106хП";
	ИмяПоляДляВыводаСообщений = "НомерСтроки";
	Текст = НСтр("ru='Отсутствуют затраты по номенклатуре и счету (таблица ""Материалы"" строка %1)'");
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		Выборка = РезультатПроверки.Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, Выборка["НомерСтроки"]);
			
			ИндексСтроки = Выборка["НомерСтроки"] - 1;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
		КонецЦикла;
	КонецЕсли;
	
	//	5			Незаполненные поля в зависимой табл.части ""Затраты 106.хП""
	РезультатПроверки = РезультатыПроверок[5];
	ИмяТаблЧастиДляВыводаСообщений = "Затраты106хП";
	// Проверяемые на заполненность поля и их синонимы:
	ПроверяемыеПоля = Новый Соответствие();
	ПроверяемыеПоля.Вставить("ВидЗатрат",	ДокументОбъект.Метаданные().ТабличныеЧасти["Затраты106хП"].Реквизиты.Найти("ВидЗатрат").Синоним);
	ПроверяемыеПоля.Вставить("Сумма",		ДокументОбъект.Метаданные().ТабличныеЧасти["Затраты106хП"].Реквизиты.Найти("Сумма").Синоним);
	ПроверяемыеПоля.Вставить("СуммаНУ",		ДокументОбъект.Метаданные().ТабличныеЧасти["Затраты106хП"].Реквизиты.Найти("СуммаНУ").Синоним);
	ПрефиксИмениНезаполненногоПоля = "НеЗаполненоПоле_";
	Текст = НСтр("ru='Не заполнено поле ""%1"" (таблица ""Материалы"" строка %2; таблица ""Затраты"" строка %3)'");
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		ТЗРезультат = РезультатПроверки.Выгрузить();
		Для Каждого СтрокаТЗ Из ТЗРезультат Цикл
			
			Для Каждого Поле Из ПроверяемыеПоля Цикл
				ИмяПоля				= Поле.Ключ;
				ПредставлениеПоля	= Поле.Значение;
				
				ИмяПоляДляВыводаСообщений = ИмяПоля;
				Если СтрокаТЗ[ПрефиксИмениНезаполненногоПоля + ИмяПоля] Тогда
					// Текущее поле не заполнено.
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
						ПредставлениеПоля,
						СтрокаТЗ["НомерСтрокиМатериалы"],
						СтрокаТЗ["НомерСтрокиЗатратыУсловный"]);

					ИндексСтроки = СтрокаТЗ["НомерСтрокиЗатраты"] - 1;
					
					ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
					
					ОбщегоНазначения.СообщитьПользователю(
						ТекстСообщения,
						ДокументОбъект["Ссылка"],
						"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	//	7			Дубли строк по колонкам Номенклатура, Счет, КПС
	РезультатПроверки = РезультатыПроверок[7];
	ИмяТаблЧастиДляВыводаСообщений	= "Материалы106хП";
	ИмяПоляДляВыводаСообщений		= "НомерСтроки";
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		ДЗРезультат = РезультатПроверки.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		Для Каждого СтрокаИтого Из ДЗРезультат.Строки Цикл
			Текст = НСтр("ru='Дубли строк по номенклатуре, счету и КПС (таблица ""Материалы"", строки %1)'");
			
			НомераСтрок = СтрокаИтого.Строки.ВыгрузитьКолонку("НомерСтроки");
			ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(Текст, НомераСтрок, МаксДлинаСообщения, "%1");
			
			ИндексСтроки = НомераСтрок[0] - 1;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
		КонецЦикла;
	КонецЕсли;
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Функция ПолучитьСписокСчетов106хП(ДатаДокумента) Экспорт
	
	НаДату = ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(ДатаДокумента);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ПустаяДата",	'00010101');
	ЗапросПоиск.УстановитьПараметр("НаДату",		НаДату);
	
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Код ПОДОБНО ""106._П""
	|	И (ДатаНачалаДействия = &ПустаяДата ИЛИ ДатаНачалаДействия <= &НаДату)
	|	И (ДатаОкончанияДействия = &ПустаяДата ИЛИ ДатаОкончанияДействия >= &НаДату)
	|;";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПодразделениеИспользуетсяНаСчетах106хП(ДатаДокумента) Экспорт
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		ЗапросПоиск = Новый Запрос();
		ЗапросПоиск.УстановитьПараметр("Счета106хП", ПолучитьСписокСчетов106хП(ДатаДокумента));
		ЗапросПоиск.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(МАКСИМУМ(Ссылка.УчетПоПодразделениям), ЛОЖЬ)	КАК УчетПоПодразделениям
		|ИЗ
		|	ПланСчетов.ЕПСБУ
		|ГДЕ
		|	Ссылка В (&Счета106хП)
		|;";
		
		Выборка = ЗапросПоиск.Выполнить().Выбрать();
		Выборка.Следующий();
		
		УчетПоПодразделениям = Выборка["УчетПоПодразделениям"];
	Иначе
		УчетПоПодразделениям = Ложь;
	КонецЕсли;
	
	Возврат УчетПоПодразделениям;
	
КонецФункции

Функция Печать_ПоСчету106хП_Ведомость(МассивОбъектов, ОбъектыПечати)
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	ЗапросПечать = Новый Запрос("
	|///////////////////////////////////////////////
	|// [0]. Данные из шапок документов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка						КАК ДокСсылка,
	|	Док.Номер						КАК ДокНомер,
	|	ПРЕДСТАВЛЕНИЕ(Док.Организация)	КАК Организация,
	|	ПРЕДСТАВЛЕНИЕ(Док.РазделУчета)	КАК РазделУчета,
	|	ПРЕДСТАВЛЕНИЕ(Док.КФО)			КАК КФО
	|
	|ИЗ
	|	Документ.ВводНачальныхОстатков	КАК Док
	|
	|ГДЕ
	|	Док.Ссылка В (&МассивОбъектов)
	|	И Док.РазделУчета = &РазделУчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокСсылка
	|;
	|
	|///////////////////////////////////////////////
	|// [1]. Данные из табличных частей документов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Материалы.Ссылка										КАК ДокСсылка,
	|	Материалы.НомерСтроки									КАК НПП,
	|	ПРЕДСТАВЛЕНИЕ(Материалы.КПС)							КАК КПС,
	|	ПРЕДСТАВЛЕНИЕ(Материалы.Счет)							КАК Счет,
	|	ПРЕДСТАВЛЕНИЕ(Материалы.КЭК)							КАК КЭК,
	|	ПРЕДСТАВЛЕНИЕ(Материалы.Номенклатура)					КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(Материалы.Номенклатура.ЕдиницаИзмерения)	КАК ЕдИзм,
	|	ПРЕДСТАВЛЕНИЕ(Затраты.ВидЗатрат)						КАК ВидЗатрат,
	|	Материалы.Количество									КАК Количество,
	|	Затраты.Сумма											КАК Сумма
	|
	|ИЗ
	|	Документ.ВводНачальныхОстатков.Материалы106хП	КАК Материалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводНачальныхОстатков.Затраты106хП	КАК Затраты
	|		ПО Материалы.Номенклатура = Затраты.Номенклатура
	|			И Материалы.Ссылка = Затраты.Ссылка
	|			И Материалы.КПС = Затраты.КПС
	|			И Материалы.Счет = Затраты.Счет
	|ГДЕ
	|	Материалы.Ссылка В (&МассивОбъектов)
	|	И Материалы.Ссылка.РазделУчета = &РазделУчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокСсылка, НПП
	|
	|ИТОГИ
	|	ЕСТЬNULL(СУММА(Сумма), 0)	КАК Сумма
	|ПО
	|	ДокСсылка, НПП
	|;");
	ЗапросПечать.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ЗапросПечать.УстановитьПараметр("РазделУчета", Перечисления.РазделыУчетаДляВводаОстатков.ПоСчету106хП);
	РезультатПакетаЗапросов = ЗапросПечать.ВыполнитьПакет();
	ШапкиДокументов		= РезультатПакетаЗапросов[0];
	ДанныеДокументов	= РезультатПакетаЗапросов[1];
	
	Макет = ПолучитьМакет("ПФ_MXL_ПоСчету106хП_Ведомость");
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьНоменклатура	= Макет.ПолучитьОбласть("Номенклатура");
	ОбластьЗатрата		= Макет.ПолучитьОбласть("Затрата");
	ОбластьИтог			= Макет.ПолучитьОбласть("Итог");
	
	// Цикл по печатаемым документам:
	ВыборкаДокШапка	= ШапкиДокументов.Выбрать();
	ВыборкаДок		= ДанныеДокументов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ПервыйДокумент = Истина;
	Пока ВыборкаДокШапка.Следующий() Цикл
		
		ВыборкаДок.НайтиСледующий(ВыборкаДокШапка.ДокСсылка, "ДокСсылка");
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		//-----------
		// ЗАГОЛОВОК
		//-----------
		ОбластьЗаголовок.Параметры.Заполнить(ВыборкаДокШапка);
		
		НомерДляПечати = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаДокШапка.ДокСсылка,ВыборкаДокШапка.ДокНомер);
		ПредставлениеСсылки = Строка(ВыборкаДокШапка.ДокСсылка);
		ПредставлениеДляПечати = СтрЗаменить(ПредставлениеСсылки,СокрЛП(ВыборкаДокШапка.ДокНомер),НомерДляПечати);
		СтруктураОбластьЗаголовок = Новый Структура("ДокСсылка",ПредставлениеДляПечати);
		ОбластьЗаголовок.Параметры.Заполнить(СтруктураОбластьЗаголовок);
		
		ТабДокумент.Вывести(ОбластьЗаголовок);
		ТабДокумент.Вывести(ОбластьШапка);
		
		// Цикл по номенклатуре текущего документа:
		ВыборкаИтогПоНоменклатуре = ВыборкаДок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаИтогПоНоменклатуре.Следующий() Цикл
			
			ВывелиНоменклатуру = Ложь;
			
			// Цикл по затратам текущей номенклатуры:
			Выборка = ВыборкаИтогПоНоменклатуре.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				Если НЕ ВывелиНоменклатуру Тогда
					ВывелиНоменклатуру = Истина;
					
					//--------------
					// НОМЕНКЛАТУРА
					//--------------
					ОбластьНоменклатура.Параметры.Заполнить(Выборка);
					СтруктураОбластьНоменклатура = Новый Структура("КФО,Сумма",ВыборкаДокШапка.КФО,ВыборкаИтогПоНоменклатуре.Сумма);
					ОбластьНоменклатура.Параметры.Заполнить(СтруктураОбластьНоменклатура);
					ТабДокумент.Вывести(ОбластьНоменклатура);
				КонецЕсли;
				
				//---------
				// ЗАТРАТА
				//---------
				ОбластьЗатрата.Параметры.Заполнить(Выборка);
				ТабДокумент.Вывести(ОбластьЗатрата);
				
			КонецЦикла;
			
		КонецЦикла;
		
		//------
		// ИТОГ
		//------
		ОбластьИтог.Параметры.Заполнить(ВыборкаДок);
		ТабДокумент.Вывести(ОбластьИтог);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаДок.ДокСсылка);
		
	КонецЦикла;
	
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабДокумент.ОтображатьСетку     = Ложь;
	ТабДокумент.ТолькоПросмотр      = Истина;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПодготовитьТаблицуПроводок_Счет106хП(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ) Экспорт
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	// Подготовка:
	ОтражатьВБухгалтерскомУчете	= ДокументОбъект["ОтражатьВБухгалтерскомУчете"];
	ОтражатьВНалоговомУчетеОСН	= ДокументОбъект["ОтражатьВНалоговомУчете"];
	
	// Настраиваем запрос:
	ЗапросДвижения = Новый Запрос();
	ЗапросДвижения.УстановитьПараметр("ДокСсылка",					ДокументОбъект["Ссылка"]);
	ЗапросДвижения.УстановитьПараметр("Содержание",					НСтр("ru='Ввод остатков партий материалов'"));
	ЗапросДвижения.УстановитьПараметр("ВидСубконтоВидыЗатрат",		ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат);
	ЗапросДвижения.УстановитьПараметр("ВидСубконтоНоменклатура",	ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ЗапросДвижения.УстановитьПараметр("ВидСубконтоПартии",			ПланыВидовХарактеристик.ВидыСубконто.Партии);
	ЗапросДвижения.УстановитьПараметр("ОтражатьВБухУчете",		ОтражатьВБухгалтерскомУчете);
	ЗапросДвижения.УстановитьПараметр("ОтражатьВНалУчетеОСН",	ОтражатьВНалоговомУчетеОСН);
	ЗапросДвижения.УстановитьПараметр("ШапкаДокумента_Дата",					ДокументОбъект["Дата"]);
	ЗапросДвижения.УстановитьПараметр("ШапкаДокумента_Организация",				ДокументОбъект["Организация"]);
	ЗапросДвижения.УстановитьПараметр("ШапкаДокумента_ИФО",						ДокументОбъект["ИФО"]);
	ЗапросДвижения.УстановитьПараметр("ШапкаДокумента_КФО",						ДокументОбъект["КФО"]);
	ЗапросДвижения.УстановитьПараметр("ШапкаДокумента_ПодразделениеОрганизации",ДокументОбъект["ПодразделениеОрганизации"]);
	ЗапросДвижения.УстановитьПараметр("ШапкаДокумента_ВидПервичногоДокумента",	ДокументОбъект["ВидПервичногоДокумента"]);
	ЗапросДвижения.УстановитьПараметр("ШапкаДокумента_ДатаПервичногоДокумента",	ДокументОбъект["ДатаПервичногоДокумента"]);
	ЗапросДвижения.УстановитьПараметр("ШапкаДокумента_НомерПервичногоДокумента",ДокументОбъект["НомерПервичногоДокумента"]);
	ЗапросДвижения.УстановитьПараметр("Счет000", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("000"));
	
	ТекстЗапроса = "";
	ИндексРезультата_База		= 3; // кол-во подзапросов общей части текста.
	ИндексРезультата_БухУчет	= 0;
	ИндексРезультата_НалУчетОСН	= 0;
	
	// Общий текст запроса, используемый при любом режиме ввода остатков:
	ТекстЗапроса = "
	|//------------------------------------------------------------------------------
	|// 0) Исходные данные проводимого документа.
	|//	  Используются далее во всех режимах ввода остатков.
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Табличная часть ""Материалы106хП""
	|//		(Исходные данные)
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки		КАК НомерСтроки,
	|	КЭК				КАК КЭК,
	|	Количество		КАК Количество,
	|	// Поля связи:
	|	Номенклатура	КАК Номенклатура,
	|	Счет			КАК Счет,
	|	КПС				КАК КПС
	|ПОМЕСТИТЬ
	|	ТаблЧастьМатериалы106хП
	|ИЗ
	|	Документ.ВводНачальныхОстатков.Материалы106хП
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|ИНДЕКСИРОВАТЬ ПО
	|	// Поля связи:
	|	Номенклатура,
	|	Счет,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Табличная часть ""Затраты106хП""
	|//		(Исходные данные)
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки		КАК НомерСтроки,
	|	ВидЗатрат		КАК ВидЗатрат,
	|	Сумма			КАК Сумма,
	|	СуммаНУ			КАК СуммаНУ,
	|	// Поля связи:
	|	Номенклатура	КАК Номенклатура,
	|	Счет			КАК Счет,
	|	КПС				КАК КПС
	|ПОМЕСТИТЬ
	|	ТаблЧастьЗатраты106хП
	|ИЗ
	|	Документ.ВводНачальныхОстатков.Затраты106хП
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|ИНДЕКСИРОВАТЬ ПО
	|	// Поля связи:
	|	Номенклатура,
	|	Счет,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Номера первых строк табличной части ""Затраты106хП""
	|//		для каждого ключа связи обеих таблиц.
	|//		Используется для использования поля ""Количество"" основной таблицы
	|//		в проводках только 1 раз, а не по количеству строк зависимой таблицы.
	|//		(Исходные данные)
	|ВЫБРАТЬ
	|	МИНИМУМ(НомерСтроки)	КАК НомерСтроки
	|ПОМЕСТИТЬ
	|	ТаблЧастьЗатраты106хП_НомераПервыхСтрок
	|ИЗ
	|	ТаблЧастьЗатраты106хП	КАК Затраты
	|СГРУППИРОВАТЬ ПО
	|	// Поля связи:
	|	Номенклатура,
	|	Счет,
	|	// Поле ""КПС"" используется только при бух.учете:
	|	ВЫБОР
	|		КОГДА &ОтражатьВБухУчете = ИСТИНА ТОГДА
	|			КПС
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерСтроки
	|;";
	
	Если ОтражатьВБухгалтерскомУчете Тогда
		ИндексРезультата_БухУчет = ИндексРезультата_База + 1; // индекс результата
		ИндексРезультата_База = ИндексРезультата_База + 2; // количество подзапросов
		
		ТекстЗапроса = ТекстЗапроса + "
		|//------------------------------------------------------------------------------
		|// а) Бухгалтерский учет
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// [а0]. (Подготовка) Реальные номера условных видов субконто используемых счетов.
		|//		(Движения по вводу остатков, бухгалтерский учет)
		|//
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Материалы106хП.Счет			КАК Счет,
		|	
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА ВидыСубконто.ВидСубконто = &ВидСубконтоПартии ТОГДА
		|			ВидыСубконто.НомерСтроки
		|		ИНАЧЕ
		|			НЕОПРЕДЕЛЕНО
		|	КОНЕЦ)						КАК НомерВидаСубконтоПартии,
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА ВидыСубконто.ВидСубконто = &ВидСубконтоНоменклатура ТОГДА
		|			ВидыСубконто.НомерСтроки
		|		ИНАЧЕ
		|			НЕОПРЕДЕЛЕНО
		|	КОНЕЦ)						КАК НомерВидаСубконтоНоменклатура,
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА ВидыСубконто.ВидСубконто = &ВидСубконтоВидыЗатрат ТОГДА
		|			ВидыСубконто.НомерСтроки
