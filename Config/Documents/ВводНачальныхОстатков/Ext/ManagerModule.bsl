			,									// данные
			КомментарийОшибка + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	// комментарий
		//ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры
// Выбирает все документы "Ввод остатков ОС и НМА" и устанавливает флаг "ОтражатьВБухгалтерскомУчете".
