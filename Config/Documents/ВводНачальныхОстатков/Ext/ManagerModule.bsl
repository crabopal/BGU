Функция ПолнаяТабличнаяЧастьОС_ИменаИспользуемыхКолонокОСОсновная(РазделУчета) Экспорт
	
	ИменаКолонок = Новый Структура();
	
	Если	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства
		ИЛИ РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны	Тогда
		// Используются все поля
		ИменаКолонок = Новый Структура("
			|ОС,
			|ЦМО,
			|ИнвНомерОС,
			|Количество,
			|Сумма,
			|СуммаАмортизации,
			|Подразделение,
			|СостояниеОС,
			|ВводВЭксплуатациюОдновременноСПринятиемКУчету,
			|ДатаВводаВЭксплуатацию,
			|НазваниеДокументаВводаВЭксплуатацию,
			|НомерДокументаВводаВЭксплуатацию,
			|ПервоначальнаяСтоимость,
			|СтавкаНалогаНаИмущество");
			
	ИначеЕсли	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете
			ИЛИ РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе
			Тогда
		// Не используются поля СуммаАмортизации, СтавкаНалогаНаИмущество
		ИменаКолонок = Новый Структура("
			|ОС,
			|ЦМО,
			|ИнвНомерОС,
			|Количество,
			|Сумма,
			|Подразделение,
			|СостояниеОС,
			|ВводВЭксплуатациюОдновременноСПринятиемКУчету,
			|ДатаВводаВЭксплуатацию,
			|НазваниеДокументаВводаВЭксплуатацию,
			|НомерДокументаВводаВЭксплуатацию,
			|ПервоначальнаяСтоимость");
			
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НПА Тогда
		// Не используются поля Количество, СуммаАмортизации, СтавкаНалогаНаИмущество
		ИменаКолонок = Новый Структура("
			|ОС,
			|ЦМО,
			|ИнвНомерОС,
			|Сумма,
			|Подразделение,
			|СостояниеОС,
			|ВводВЭксплуатациюОдновременноСПринятиемКУчету,
			|ДатаВводаВЭксплуатацию,
			|НазваниеДокументаВводаВЭксплуатацию,
			|НомерДокументаВводаВЭксплуатацию,
			|ПервоначальнаяСтоимость");
			
	КонецЕсли;
	
	Возврат Новый ФиксированнаяСтруктура(ИменаКолонок);
	
КонецФункции

