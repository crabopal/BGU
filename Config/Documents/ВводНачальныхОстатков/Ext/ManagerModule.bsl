	|;");
	
КонецФункции

Функция ТекстЗапроса_ПроверкаЗаполнения_ОтборПоВидуРаспоряжения(ДокументОбъект)
	
	РазделУчета	= ДокументОбъект.РазделУчета;
	Счет		= ДокументОбъект.Счет;
	
	Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства
		ИЛИ РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НПА Тогда
		
		// Счета 101, 102, 103, 108
		Возврат "ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)";
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете Тогда
		
		// Счета 21
		Возврат "ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ОперативныйУчет)";
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе Тогда
		
		Если БухгалтерскийУчет.СчетВИерархии(Счет, "01") Тогда
			// Счета 01
			Возврат "ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПолученоВПользование)";
		
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Счет, "02") Тогда
			// Счета 02
			Возврат "ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении)";
			
		//ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Счет, "22") Тогда
		
		КонецЕсли;
		
	КонецЕсли;
	
	// Остатки выбираться не будут.
	// Проверка наличия уже имеющихся остатков покажет, что остатков нет.
	// Одобрен ввод такого остатка.
	Возврат "ЛОЖЬ";
	
КонецФункции

// Возвращаемые значения:
//	ЗапросПакетПроверок	- пакет запросов, содержит текст запроса и значения параметров;
//	ПакетПроверок		- таблица значений, пустая, для добавления в нее описаний выполняемых проверок;
//	ИндексПоследнегоЗапроса - индекс последнего запроса (=общее количество запросов - 1).
Процедура ПакетПроверок_Инициализировать(Объект, ИменаТаблЧастей, ЗапросПакетПроверок, ПакетПроверок, ИндексПоследнегоЗапроса)
	
	ТипСтрока		= Новый ОписаниеТипов("Строка");
	ТипЧислоИндекс	= Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(2, 0, ДопустимыйЗнак.Неотрицательный));
	ТипБулево		= Новый ОписаниеТипов("Булево");
	
	// Инициализация
	ЗапросПакетПроверок		= Новый Запрос();
	ИндексПоследнегоЗапроса	= 0;
	ТекстЗапроса			= "";
	
	// Таблица "Пакет проверок"
	ПакетПроверок = Новый ТаблицаЗначений();
	ПакетПроверок.Колонки.Добавить("Имя",										ТипСтрока);
	ПакетПроверок.Колонки.Добавить("ИндексРезультатаВПакетеЗапросов",			ТипЧислоИндекс);
	ПакетПроверок.Колонки.Добавить("ОтказОтЗаписи",								ТипБулево);
	ПакетПроверок.Колонки.Добавить("ОтказОтВыводаСообщенийСледующихПроверок",	ТипБулево);
	
	ПакетПроверок.Колонки.Добавить("ПараметрыВыводаСообщений",					Новый ОписаниеТипов("ФиксированнаяСтруктура"));
	ПакетПроверок.Колонки.Добавить("ИменаПолей",								ТипСтрока);
	ПакетПроверок.Колонки.Добавить("ИспользуетсяГруппировкаРезультата",			ТипБулево);
	ПакетПроверок.Колонки.Добавить("ИмяСвойстваОтборСтрокУстановлен",			ТипСтрока);	// опционально
	
	//
	// 1. Загружаем во временную таблицу значения реквизитов шапки
	//
	// Получим имена реквизитов шапки документа:
	ИменаРеквизитов = Новый Массив();
	ИменаИсключаемыхРеквизитов = Новый Массив();
	ИменаИсключаемыхРеквизитов.Добавить("ИДИсточника");
	ЗначениеПараметраЗапроса = Новый ТаблицаЗначений();
	Для Каждого Реквизит Из Объект.Метаданные().Реквизиты Цикл
		ИмяРеквизита = Реквизит.Имя;
		
		Если ИменаИсключаемыхРеквизитов.Найти(ИмяРеквизита) = Неопределено Тогда
			// Такой реквизит используем.
			
			ИменаРеквизитов.Добавить(ИмяРеквизита);
			
			// Параметр запроса:
			ЗначениеПараметраЗапроса.Колонки.Добавить(ИмяРеквизита, Новый ОписаниеТипов(Реквизит.Тип.Типы()));
		КонецЕсли;
		
	КонецЦикла;
	
	// Текст запроса для выбора реквизитов шапки во временную таблицу:
	ИндексПоследнегоЗапросаЛокальный = 0;
	ТекстЗапроса = ТекстЗапроса + ТекстЗапроса_РеквизитыШапки(ИменаРеквизитов, ИндексПоследнегоЗапросаЛокальный);
	ИндексПоследнегоЗапроса = ИндексПоследнегоЗапросаЛокальный;
	
	// Параметр запроса:
	СтрокаТЗ = ЗначениеПараметраЗапроса.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаТЗ, Объект);
	ЗапросПакетПроверок.УстановитьПараметр("ШапкаДокумента", ЗначениеПараметраЗапроса);
	
	//
	// 2. Загружаем во временные таблицы значения реквизитов указанных табличных частей
	//
	Для Каждого ИмяТаблЧасти Из ИменаТаблЧастей Цикл
		
		Если ИмяТаблЧасти = "ОС_Общая" Тогда
			// Виртуальная табл.часть
			
			// Текст запроса для выбора реквизитов текущей табличной части во временную таблицу:
			ИндексПоследнегоЗапросаЛокальный = 0;
			ТекстЗапроса = ТекстЗапроса + ТекстЗапроса_ТабличнаяЧастьОСОбщая(ИмяТаблЧасти, ИндексПоследнегоЗапросаЛокальный);
			ИндексПоследнегоЗапроса = ИндексПоследнегоЗапроса + (ИндексПоследнегоЗапросаЛокальный + 1);
			
		Иначе
			// Обычная табл.часть
			
			// Получим имена колонок текущей табл.части:
			ТЗКолонки = Объект[ИмяТаблЧасти].ВыгрузитьКолонки();
			ИменаКолонок = Новый Массив();
			Для Каждого Колонка Из ТЗКолонки.Колонки Цикл
				ИменаКолонок.Добавить(Колонка.Имя);
			КонецЦикла;
			
			// Текст запроса для выбора реквизитов текущей табличной части во временную таблицу:
			ИндексПоследнегоЗапросаЛокальный = 0;
			ТекстЗапроса = ТекстЗапроса + ТекстЗапроса_ИсходнаяТабличнаяЧасть(ИмяТаблЧасти, ИменаКолонок, ИндексПоследнегоЗапросаЛокальный);
			ИндексПоследнегоЗапроса = ИндексПоследнегоЗапроса + (ИндексПоследнегоЗапросаЛокальный + 1);
			
			// Параметр запроса:
			ЗначениеПараметраЗапроса = Объект[ИмяТаблЧасти].Выгрузить();
			ЗапросПакетПроверок.УстановитьПараметр("ТаблЧасть_" + ИмяТаблЧасти, ЗначениеПараметраЗапроса);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗапросПакетПроверок.УстановитьПараметр("ПроводимыйДокументСсылка", Объект["Ссылка"]);
	
	// Текст запроса:
	ЗапросПакетПроверок.Текст = ТекстЗапроса;
	
КонецПроцедуры
Процедура ПакетПроверок_ДобавитьПакетнуюПроверку(ИмяПроверки, Проверка, ПакетПроверок, ЗапросПакетПроверок, ИндексПоследнегоЗапроса, ОтказОтЗаписи, ОтказОтВыводаСообщенийСледующихПроверок)
	
	// Обновляем текст пакета запросов:
	ЗапросПакетПроверок.Текст = ЗапросПакетПроверок.Текст + Проверка["ТекстЗапроса"];
	
	// Добавляем строку сведений об этой проверке:
	НоваяСтрока = ПакетПроверок.Добавить();
	НоваяСтрока["Имя"]										= ИмяПроверки;
	НоваяСтрока["ИндексРезультатаВПакетеЗапросов"]			= ИндексПоследнегоЗапроса + (Проверка["ИндексРезультата"]+1);
	НоваяСтрока["ОтказОтЗаписи"]							= ОтказОтЗаписи;
	НоваяСтрока["ОтказОтВыводаСообщенийСледующихПроверок"]	= ОтказОтВыводаСообщенийСледующихПроверок;
	
	Если Проверка.Свойство("ОписаниеПроверки") Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Проверка["ОписаниеПроверки"]);
	КонецЕсли;
	
	// Обновляем индекс последнего запроса:
	ИндексПоследнегоЗапроса = ИндексПоследнегоЗапроса + (Проверка["ИндексПоследнегоЗапроса"]+1);
	
КонецПроцедуры

Функция МассивИлиСтруктуруВСтроку(МассивИлиСтруктура, СимволРазделитель = ",", КлючИлиЗначение = "Ключ")
	
	Результат = "";
	
	// Входная проверка:
	Если ТипЗнч(МассивИлиСтруктура) = Тип("Массив") Тогда
		ЭтоМассив = Истина;
		
	ИначеЕсли ТипЗнч(МассивИлиСтруктура) = Тип("Структура") Тогда
		ЭтоМассив = Ложь;
		Если НЕ КлючИлиЗначение = "Ключ" Тогда
			КлючИлиЗначение = "Значение";
		КонецЕсли;
		
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	ПервыйЭлемент = Истина;
	Для Каждого Элем Из МассивИлиСтруктура Цикл
		
		Если ЭтоМассив Тогда
			Результат = Результат + ?(ПервыйЭлемент, "", СимволРазделитель) + Элем;
		Иначе
			// Это структура.
			Результат = Результат + ?(ПервыйЭлемент, "", СимволРазделитель) + Элем[КлючИлиЗначение];
		КонецЕсли;
		
		ПервыйЭлемент = Ложь;
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОписаниеПроверки(
			ТекстСообщения,
			ТекстСообщенияВыводСообщенийПрерван,
			ИмяТаблЧастиДляВыводаСообщений,
			ИмяПоляДляВыводаСообщений,
			
			ИменаПолейСтрока,
			ИспользуетсяГруппировкаРезультата,
			ИмяСвойстваОтборСтрокУстановлен = "")
	
	ПараметрыВыводаСообщений = Новый Структура();
	ПараметрыВыводаСообщений.Вставить("ТекстСообщения",							ТекстСообщения);
	ПараметрыВыводаСообщений.Вставить("ТекстСообщенияВыводСообщенийПрерван",	ТекстСообщенияВыводСообщенийПрерван);
	ПараметрыВыводаСообщений.Вставить("ИмяТаблЧасти",							ИмяТаблЧастиДляВыводаСообщений);
	ПараметрыВыводаСообщений.Вставить("ИмяПоля",								ИмяПоляДляВыводаСообщений);
	
	ОписаниеПроверки = Новый Структура();
	ОписаниеПроверки.Вставить("ПараметрыВыводаСообщений",			Новый ФиксированнаяСтруктура(ПараметрыВыводаСообщений));
	ОписаниеПроверки.Вставить("ИменаПолей",							ИменаПолейСтрока);
	ОписаниеПроверки.Вставить("ИспользуетсяГруппировкаРезультата",	ИспользуетсяГруппировкаРезультата);
	ОписаниеПроверки.Вставить("ИмяСвойстваОтборСтрокУстановлен",	ИмяСвойстваОтборСтрокУстановлен);
	
	Возврат ОписаниеПроверки;
	
КонецФункции


Функция СообщитьОВыявленныхОшибках(ТекущаяПроверка, РезультатПроверки, СтатистикаОбщая, ДополнительныеПараметры)
	
	Перем	ИспользуетсяГруппировкаРезультата,
			ОтборСтрокУстановлен,
			НомераСтрок;
	
	// Возвращаемое значение
	СтатистикаПроверки = ИнициализироватьСтатистикуПроверки();
	
	Если РезультатПроверки.Пустой() Тогда
		// Проверка не выявила ошибок
		// Переходим к следующей проверке
		Возврат СтатистикаПроверки;
	КонецЕсли;
	
	// Здесь проверка выявила ошибку
	
	ОтразитьВСтатистикеВозможныйОтказОтЗаписи(ТекущаяПроверка, СтатистикаОбщая);
	
	// Количество ошибок текущей проверки
	ИспользуетсяГруппировкаРезультата = ТекущаяПроверка["ИспользуетсяГруппировкаРезультата"];
	Если ИспользуетсяГруппировкаРезультата Тогда
		Выборка = РезультатПроверки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Иначе
		Выборка = РезультатПроверки.Выбрать();
	КонецЕсли;
	КоличествоОшибокТекущейПроверки = Выборка.Количество();
	ОтразитьВСтатистикеОбщееКоличествоОшибокТекущейПроверки(КоличествоОшибокТекущейПроверки, СтатистикаПроверки, СтатистикаОбщая);
	
	// Если ранее уже отказались от дальнейшего вывода сообщений,
	// то переходим к следующей проверке
	Если СтатистикаОбщая["ОтказОтВыводаСообщений"] Тогда
		Возврат СтатистикаПроверки;
	КонецЕсли;
	
	
	// Параметры вывода сообщений
	ПараметрыВыводаСообщений					= ТекущаяПроверка["ПараметрыВыводаСообщений"];
	ИмяТаблЧастиДляВыводаСообщений				= ПараметрыВыводаСообщений["ИмяТаблЧасти"];
	ИмяПоляДляВыводаСообщений					= ПараметрыВыводаСообщений["ИмяПоля"];
	ТекстСообщенияШаблон						= ПараметрыВыводаСообщений["ТекстСообщения"];
	ТекстСообщенияВыводСообщенийПрерванШаблон	= ПараметрыВыводаСообщений["ТекстСообщенияВыводСообщенийПрерван"];
	ТекстСообщенияОтборСтрокУстановлен			= НСтр("ru='Очистите отбор строк, чтобы увидеть'");
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	Если ЗначениеЗаполнено(ТекущаяПроверка["ИмяСвойстваОтборСтрокУстановлен"]) Тогда
		ПризнакиОтбораСтрок		= ДополнительныеПараметры["ДокументОбъект"].ДополнительныеСвойства["ОтборСтрокУстановлен"];
		ОтборСтрокУстановлен	= ПризнакиОтбораСтрок[ТекущаяПроверка["ИмяСвойстваОтборСтрокУстановлен"]];
	Иначе
		ОтборСтрокУстановлен	= Ложь;
	КонецЕсли;
	ДополнительныеПараметры.Вставить("ОтборСтрокУстановлен",				ОтборСтрокУстановлен);
	ДополнительныеПараметры.Вставить("ТекстСообщенияОтборСтрокУстановлен",	ТекстСообщенияОтборСтрокУстановлен);
	
	
	// Обходим результаты текущей проверки
	
	Если ИспользуетсяГруппировкаРезультата Тогда
		КоллекцияСтрокРезультата = РезультатПроверки.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам).Строки
	Иначе
		КоллекцияСтрокРезультата = РезультатПроверки.Выгрузить();
	КонецЕсли;
	Для Каждого СтрокаРезультата Из КоллекцияСтрокРезультата Цикл
		
		Если СтатистикаОбщая["СчетчикСообщений"] < ДополнительныеПараметры["МаксКолвоСообщений"] Тогда
			// Допустимое количество выведенных сообщений об ошибках не превышено
			
			// Выводим все параметры, кроме номеров строк (для контроля длины текста всего сообщения)
			ВставляемыеЗначения = Новый Структура(ТекущаяПроверка["ИменаПолей"]);
			ЗаполнитьЗначенияСвойств(ВставляемыеЗначения, СтрокаРезультата);
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстСообщенияШаблон, ВставляемыеЗначения);
			
			// Теперь выводим номера строк (для контроля длины текста всего сообщения)
			Если ИспользуетсяГруппировкаРезультата Тогда
				НомераСтрок		= СтрокаРезультата.Строки.ВыгрузитьКолонку("НомерСтроки");
				ИндексСтроки	= НомераСтрок[0] - 1;
				ТекстСообщения	= ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(
									ТекстСообщения,
									НомераСтрок,
									ДополнительныеПараметры["МаксДлинаСообщения"],
									"[НомераСтрок]");
			Иначе
				ИндексСтроки	= СтрокаРезультата["НомерСтроки"] - 1;
			КонецЕсли;
			
			//---
			// Механизм отбора строк табличной части (v2)
			//---
			Если ОтборСтрокУстановлен Тогда
				ТекстСообщения = ТекстСообщения + " " + ТекстСообщенияОтборСтрокУстановлен;
				ИндексСтроки = -1;
			КонецЕсли;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДополнительныеПараметры["ДокументОбъект"].Ссылка,
				"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
				
			ОтразитьВСтатистикеВыведенноеСообщение(СтатистикаПроверки, СтатистикаОбщая);
			
		Иначе
			// Превышено допустимое количество выведенных сообщений
			
			СтатистикаПроверки["ВыводСообщенийПрерван"] = Истина;
			Прервать;
			
		КонецЕсли;

	КонецЦикла;
	
	Если СтатистикаПроверки["ВыводСообщенийПрерван"] Тогда
		СообщитьКоличествоНепоказанныхСообщений(ТекущаяПроверка, СтатистикаПроверки, ДополнительныеПараметры);
	КонецЕсли;
	
	ОтразитьВСтатистикеЗавершениеТекущейПроверки(ТекущаяПроверка, СтатистикаОбщая);
	
	Возврат СтатистикаПроверки;
	
КонецФункции

Процедура СообщитьКоличествоНепоказанныхСообщений(ТекущаяПроверка, СтатистикаПроверки, ДополнительныеПараметры)
	
	Перем	ОтборСтрокУстановлен,
			ТекстСообщенияОтборСтрокУстановлен;
	
	// Параметры вывода сообщений
	ПараметрыВыводаСообщений			= ТекущаяПроверка["ПараметрыВыводаСообщений"];
	ИмяТаблЧастиДляВыводаСообщений		= ПараметрыВыводаСообщений["ИмяТаблЧасти"];
	ТекстСообщенияВыводСообщенийПрерван	= ПараметрыВыводаСообщений["ТекстСообщенияВыводСообщенийПрерван"];
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ДополнительныеПараметры.Свойство("ОтборСтрокУстановлен",				ОтборСтрокУстановлен);
	ДополнительныеПараметры.Свойство("ТекстСообщенияОтборСтрокУстановлен",	ТекстСообщенияОтборСтрокУстановлен);
	Если НЕ ОтборСтрокУстановлен = Истина Тогда
		ОтборСтрокУстановлен = Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекстСообщенияОтборСтрокУстановлен) Тогда
		ТекстСообщенияОтборСтрокУстановлен = "";
	КонецЕсли;
	
	КоличествоНесообщенныхОшибок = СтатистикаПроверки["КоличествоОшибок"] - СтатистикаПроверки["КоличествоСообщенныхОшибок"];
	
	ВставляемыеЗначения = Новый Структура("КоличествоНесообщенныхОшибок", КоличествоНесообщенныхОшибок);
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстСообщенияВыводСообщенийПрерван, ВставляемыеЗначения);
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	Если ОтборСтрокУстановлен Тогда
		ТекстСообщения = ТекстСообщения + " " + ТекстСообщенияОтборСтрокУстановлен;
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьПользователю(
		ТекстСообщения,
		ДополнительныеПараметры["ДокументОбъект"].Ссылка,
		"Объект." + ИмяТаблЧастиДляВыводаСообщений);
	
КонецПроцедуры

Функция ВыполнитьПроверкуВсейТаблицыПоСтрокеОС(ТекущаяПроверка, РезультатПроверки, СтатистикаОбщая, ДополнительныеПараметры)
	
	Перем РежимВводаОстатков;
	
	// Возвращаемое значение
	СтатистикаПроверки = ИнициализироватьСтатистикуПроверки();
	
	Если СтатистикаОбщая["ОтказОтВыводаСообщений"] Тогда
		// Здесь мы проверку еще не выполняли,
		// поэтому количество обнаруженных здесь ошибок неизвестно
		СтатистикаОбщая["КоличествоОшибокИзвестно"] = Ложь;
		
		// Переходим к следующей проверке
		Возврат СтатистикаПроверки;
	КонецЕсли;
	
	ИмяТаблЧастиДляВыводаСообщений	= "ОС_Основная";
	ИмяПоляДляВыводаСообщений		= ""; // определяется далее программно
	
	// Раздел учета
	ЭтоРазделУчетаОС			= (ДополнительныеПараметры["ДокументОбъект"].РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства);
	ЭтоРазделУчетаОСвОперУчете	= (		ДополнительныеПараметры["ДокументОбъект"].РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете
									ИЛИ	ДополнительныеПараметры["ДокументОбъект"].РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе);
	ЭтоРазделУчетаНПА			= (ДополнительныеПараметры["ДокументОбъект"].РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НПА);
	ЭтоРазделУчетаИК			= (ДополнительныеПараметры["ДокументОбъект"].РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны);
	
	Если ЭтоРазделУчетаОС Тогда
		ПараметрыПроверкиПоСтроке = ПолучитьПараметрыПроверкиПоСтроке_ОС(ДополнительныеПараметры["ДокументОбъект"]);
		
		РезультатПроверкиРВО = Неопределено;
		РежимВводаОстатков_ПроверитьЗаполнение(ДополнительныеПараметры["ДокументОбъект"], РезультатПроверкиРВО);
		РежимВводаОстатков = РезультатПроверкиРВО["ПрименяемыйРежимВводаОстатков"];
		
	ИначеЕсли ЭтоРазделУчетаОСвОперУчете Тогда
		ПараметрыПроверкиПоСтроке = ПолучитьПараметрыПроверкиПоСтроке_ОСВОперУчете(ДополнительныеПараметры["ДокументОбъект"]);
		
	ИначеЕсли ЭтоРазделУчетаНПА Тогда
		ПараметрыПроверкиПоСтроке = ПолучитьПараметрыПроверкиПоСтроке_НПА(ДополнительныеПараметры["ДокументОбъект"]);
		
	ИначеЕсли ЭтоРазделУчетаИК Тогда
		ПараметрыПроверкиПоСтроке = ПолучитьПараметрыПроверкиПоСтроке_ИмуществоКазны(ДополнительныеПараметры["ДокументОбъект"]);
		
	Иначе
		// Переданы некорректные параметры
		ВызватьИсключение "Переданы некорректные параметры в функцию проверки по строке ОС";
	КонецЕсли;
	
	// Таблица для ручной проверки
	ОбщаяТаблица = РезультатПроверки.Выгрузить();
	
	// Кэшируем все пределы стоимости ОС
	ПолнаяТаблицаПределовСтоимостиОС = ПолучитьПолнуюТаблицуПределовСтоимостиОС();
	
	// Проверяем каждую строку таблицы
	Для Каждого СтрокаТЗ Из ОбщаяТаблица Цикл
		
		Если ЭтоРазделУчетаОС Тогда
			ПараметрыПроверкиПоСтроке.Вставить("ПрименяемыеПределыСтоимостиОС", ОпределитьПрименяемыеПределыСтоимостиОС(СтрокаТЗ, ПолнаяТаблицаПределовСтоимостиОС));
			СтруктураОшибок = ПроверкаПоСтроке_ОС(СтрокаТЗ, ПараметрыПроверкиПоСтроке, РежимВводаОстатков);
			
		ИначеЕсли ЭтоРазделУчетаОСвОперУчете Тогда
			ПараметрыПроверкиПоСтроке.Вставить("ПрименяемыеПределыСтоимостиОС", ОпределитьПрименяемыеПределыСтоимостиОС(СтрокаТЗ, ПолнаяТаблицаПределовСтоимостиОС));
			СтруктураОшибок = ПроверкаПоСтроке_ОСВОперУчете(СтрокаТЗ, ПараметрыПроверкиПоСтроке);
			
		ИначеЕсли ЭтоРазделУчетаНПА Тогда
			СтруктураОшибок = ПроверкаПоСтроке_НПА(СтрокаТЗ, ПараметрыПроверкиПоСтроке);
			
		ИначеЕсли ЭтоРазделУчетаИК Тогда
			ПараметрыПроверкиПоСтроке.Вставить("ПрименяемыеПределыСтоимостиОС", ОпределитьПрименяемыеПределыСтоимостиОС(СтрокаТЗ, ПолнаяТаблицаПределовСтоимостиОС));
			СтруктураОшибок = ПроверкаПоСтроке_ИмуществоКазны(СтрокаТЗ, ПараметрыПроверкиПоСтроке);
		
		КонецЕсли;
		
		КоличествоОшибокТекущейСтрокиОС = СтруктураОшибок.Количество();
		Если КоличествоОшибокТекущейСтрокиОС = 0 Тогда
			// Ошибок в текущей строке не обнаружено
			// Переходим к проверке следующей строки
			Продолжить;
		КонецЕсли;
		
		
		// Здесь проверка выявила ошибку
		
		ОтразитьВСтатистикеВозможныйОтказОтЗаписи(ТекущаяПроверка, СтатистикаОбщая);
		
		ОтразитьВСтатистикеДобавитьКоличествоОшибок(КоличествоОшибокТекущейСтрокиОС, СтатистикаПроверки, СтатистикаОбщая);
		
		// Имя поля для вывода сообщений
		// (выбираем по полю первой ошибки)
		Для Каждого ЭлементОшибки Из СтруктураОшибок Цикл
			Прервать;
		КонецЦикла;
		ИмяПоляДляВыводаСообщений = ЭлементОшибки.Ключ;
		
		Если СтатистикаОбщая["СчетчикСообщений"] < ДополнительныеПараметры["МаксКолвоСообщений"] Тогда
			// Допустимое количество выведенных сообщений об ошибках не превышено
			
			НомерСтроки = СтрокаТЗ["НомерСтроки"];
			ИндексСтроки = НомерСтроки - 1;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			ТекстСообщения = МассивИлиСтруктуруВСтроку(СтруктураОшибок, "; ", "Значение")
				+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru=' (таблица ""Основные средства"", строка %1)'"),
					НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДополнительныеПараметры["ДокументОбъект"].Ссылка,
				"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
				
			ОтразитьВСтатистикеВыведенноеСообщение(СтатистикаПроверки, СтатистикаОбщая);
			
		Иначе
			// Превышено допустимое количество выведенных сообщений
			СтатистикаПроверки["ВыводСообщенийПрерван"] = Истина;
			Прервать;
			
		КонецЕсли;

	КонецЦикла;
	
	// Вывели все планируемые сообщения проверки?
	Если СтатистикаПроверки["ВыводСообщенийПрерван"] Тогда
		// Количество обнаруженных здесь ошибок неизвестно,
		// т.к. для этого нужно обойти всю таблицу, а мы прервались
		СтатистикаОбщая["КоличествоОшибокИзвестно"]	= Ложь;
		
		// Сообщим о количестве невыведенных сообщений
		ТекстСообщения = НСтр("ru='Также обнаружены еще ошибки заполнения таблицы ""Основные средства""'");
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			ДополнительныеПараметры["ДокументОбъект"].Ссылка,
			"Объект." + ИмяТаблЧастиДляВыводаСообщений);
	КонецЕсли;
	
	Возврат СтатистикаПроверки;
	
КонецФункции


Процедура ОтразитьВСтатистикеВыведенноеСообщение(СтатистикаПроверки, СтатистикаОбщая)
	
	СтатистикаПроверки["СчетчикСообщений"]				= СтатистикаПроверки["СчетчикСообщений"]			+ 1;
	СтатистикаПроверки["КоличествоСообщенныхОшибок"]	= СтатистикаПроверки["КоличествоСообщенныхОшибок"]	+ 1;
	
	СтатистикаОбщая["СчетчикСообщений"]					= СтатистикаОбщая["СчетчикСообщений"]				+ 1;
	СтатистикаОбщая["КоличествоСообщенныхОшибок"]		= СтатистикаОбщая["КоличествоСообщенныхОшибок"]		+ 1;
	
КонецПроцедуры

Процедура ОтразитьВСтатистикеОбщееКоличествоОшибокТекущейПроверки(КоличествоОшибокТекущейПроверки, СтатистикаПроверки, СтатистикаОбщая)
	
	СтатистикаПроверки["КоличествоОшибок"]	= КоличествоОшибокТекущейПроверки;
	
	СтатистикаОбщая["КоличествоОшибок"]		= СтатистикаОбщая["КоличествоОшибок"] + СтатистикаПроверки["КоличествоОшибок"];
	
КонецПроцедуры

Процедура ОтразитьВСтатистикеДобавитьКоличествоОшибок(КоличествоОшибокТекущейСтрокиОС, СтатистикаПроверки, СтатистикаОбщая)
	
	СтатистикаПроверки["КоличествоОшибок"]	= СтатистикаПроверки["КоличествоОшибок"] + КоличествоОшибокТекущейСтрокиОС;
	
	СтатистикаОбщая["КоличествоОшибок"]		= СтатистикаОбщая["КоличествоОшибок"] + СтатистикаПроверки["КоличествоОшибок"];
	
КонецПроцедуры

Процедура ОтразитьВСтатистикеЗавершениеТекущейПроверки(ТекущаяПроверка, СтатистикаОбщая)
	
	Если ТекущаяПроверка["ОтказОтВыводаСообщенийСледующихПроверок"] И СтатистикаОбщая["ОтказОтЗаписи"] Тогда
		СтатистикаОбщая["ОтказОтВыводаСообщений"] = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтразитьВСтатистикеВозможныйОтказОтЗаписи(ТекущаяПроверка, СтатистикаОбщая)
	
	Если ТекущаяПроверка["ОтказОтЗаписи"] Тогда
		СтатистикаОбщая["ОтказОтЗаписи"] = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область УстаревшиеПроцедурыИФункции

// Устарела. Настройка отражения в учете ввода начальных остатков по материалам перенесена в типовую операцию ВводНачальныхОстатков_Материалы.
// см. также БухгалтерскиеОперацииИсточникиДанных.ВводОстатковРасходовУСН(...).
//
Функция ПодготовитьТаблицуПроводок_Материалы(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ) Экспорт
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	// Получим виды субконто, которые используются в документе.
	// Этот список точно заполнен (уже убедились при проверке заполнения).
	ВидыСубконто = ПолучитьСписокВидовСубконто(ДокументОбъект).ВыгрузитьЗначения();
	КоличествоСубконто = ВидыСубконто.Количество();
	СоответствиеСубконтоКолонка = ПолучитьСоответствиеСубконтоКолонка();
	
	// Составим текст выборки полей субконто текущих счетов.
	// Пример получаемого выражения, при количестве видов субконто равным 2:
	//|	ВЫБОР
	//|		КОГДА НомераВидовСубконто.НомерВидаСубконто1 = 1 ТОГДА
	//|			Материалы.ЦМО // Поле, соответствующее виду субконто 1
	//|		КОГДА НомераВидовСубконто.НомерВидаСубконто2 = 1 ТОГДА
	//|			Материалы.Номенклатура // Поле, соответствующее виду субконто 2
	//|	КОНЕЦ							КАК СубконтоДт1,
	//|	ВЫБОР
