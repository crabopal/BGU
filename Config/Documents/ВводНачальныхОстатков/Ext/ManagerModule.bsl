Функция ПодготовитьТаблицуПроводок_ДенежныеДокументы(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ) Экспорт
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Запросы = Новый Запрос("
	|ВЫБРАТЬ
	|	ИСТИНА									КАК Активность,
	|	ДенежныеДокументы.Ссылка.Дата			КАК Период,
	|	ДенежныеДокументы.Ссылка.Организация	КАК Организация,
	|	ДенежныеДокументы.Ссылка.КФО			КАК КФО,
	|	ДенежныеДокументы.Ссылка.ИФО			КАК ИФО,
	|	&ВидПервичногоДокумента					КАК ВидПервичногоДокумента,
	|	&ДатаПервичногоДокумента				КАК ДатаПервичногоДокумента,
	|	&НомерПервичногоДокумента				КАК НомерПервичногоДокумента,
	|	
	|	ДенежныеДокументы.Ссылка.Счет						КАК СчетДт,
	|	ДенежныеДокументы.Ссылка.КПС						КАК КПСДт,
	|	ДенежныеДокументы.Ссылка.КЭК						КАК КЭКДт,
	|	ДенежныеДокументы.ВидДенежногоДокумента				КАК СубконтоДт1,
	|	ДенежныеДокументы.ДенежныйДокумент					КАК СубконтоДт2,
	|	ДенежныеДокументы.Ссылка.ПодразделениеОрганизации	КАК ПодразделениеДт,	
	|	
	|	&Счет000											КАК СчетКт,
	|	
	|	СУММА(ДенежныеДокументы.Сумма)						КАК Сумма,
	|	
	|	СУММА(ДенежныеДокументы.Количество)					КАК КоличествоДт
	|
	|ИЗ
	|	Документ.ВводНачальныхОстатков.ДенежныеДокументы	КАК ДенежныеДокументы
	|
	|ГДЕ
	|	ДенежныеДокументы.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ИСТИНА,
	|	ДенежныеДокументы.Ссылка.Дата,
	|	ДенежныеДокументы.Ссылка.Организация,
	|	ДенежныеДокументы.Ссылка.КФО,
	|	ДенежныеДокументы.Ссылка.ИФО,
	|	&ВидПервичногоДокумента,
	|	&ДатаПервичногоДокумента,
	|	&НомерПервичногоДокумента,
	|	
	|	ДенежныеДокументы.Ссылка.Счет,
	|	ДенежныеДокументы.Ссылка.КПС,
	|	ДенежныеДокументы.Ссылка.КЭК,
	|	ДенежныеДокументы.ВидДенежногоДокумента,
	|	ДенежныеДокументы.ДенежныйДокумент,
	|	ДенежныеДокументы.Ссылка.ПодразделениеОрганизации,
	|	
	|	&Счет000
	|;");
	Запросы.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	
	Запросы.УстановитьПараметр("ВидПервичногоДокумента",	"Бухгалтерская справка 0504833");
	Запросы.УстановитьПараметр("ДатаПервичногоДокумента",	ДокументОбъект.Дата);
	Запросы.УстановитьПараметр("НомерПервичногоДокумента",	ДокументОбъект.Номер);
	Запросы.УстановитьПараметр("Счет000", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("000"));
	
	Выборка = Запросы.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокаТЗ = ТаблицаПроводок.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТЗ, Выборка);
		
		СтрокаТЗ.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(СтрокаТЗ.СчетДт, СтрокаТЗ.СчетКт);
		
		СтрокаТЗ.Содержание	= "В/" + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокументОбъект.Номер)
							+ "@" + СокрЛП(ДокументОбъект.Комментарий);
		
	КонецЦикла;
	
	Возврат ТаблицаПроводок;

КонецФункции

//---
// Раздел учета "НДС"
//---

// Проверяет корректность значений полей, зависимых от ключа поиска Счетов-фактур
// в строках табличной части "НДС".
// Поля ключа поиска Счетов-фактур:
//	Контрагент, Договор, НомерПервичногоДокумента, ДатаПервичногоДокумента.
//
// Зависимые поля (должны быть заполнены одинаково в различных строках табл.части,
// содержащих один и тот же ключ поиска):
//	ПричинаНалогообложения, ВидЦенности, КодСпособаВыставления.
Функция ЕстьОшибкиЗаполнения_НДС(ДокументОбъект, МаксДлинаСообщения)
	
	// Возвращаемое значение:
	ЕстьОшибкиЗаполнения = Ложь;
	
	// Настраиваем запрос:
	ЗапросПроверки = Новый Запрос();
	ЗапросПроверки.УстановитьПараметр("Организация",								ДокументОбъект["Организация"]);
	ЗапросПроверки.УстановитьПараметр("ПричиныНалогообложенияДляВыданногоСЧФ",		УчетНДСПовтИсп.ПолучитьПричиныНалогообложенияДляСчетаФактурыВыданного());
	ЗапросПроверки.УстановитьПараметр("ПричиныНалогообложенияДляПолученногоСЧФ",	УчетНДСПовтИсп.ПолучитьПричиныНалогообложенияДляСчетаФактурыПолученного());
	ЗапросПроверки.УстановитьПараметр("ТЗ_НДС",										ДокументОбъект["НДС"].Выгрузить());
	ЗапросПроверки.УстановитьПараметр("ВалютаДокумента",							ДокументОбъект["ВалютаДокумента"]);
	ЗапросПроверки.УстановитьПараметр("ИспользоватьВалютныйУчет",					ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	ЗапросПроверки.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Исходные данные табличной части НДС.
	|//
	|ВЫБРАТЬ
	|	ТЧ.НомерСтроки						КАК НомерСтроки,
	|	ТЧ.НомерСчетаФактуры				КАК НомерСчетаФактуры,
	|	ТЧ.ДатаСчетаФактуры					КАК ДатаСчетаФактуры,
	|	ТЧ.Контрагент						КАК Контрагент,
	|	ТЧ.Договор							КАК Договор,
	|	ТЧ.ПричинаНалогообложения			КАК ПричинаНалогообложения,
	|	ТЧ.ВидЦенности						КАК ВидЦенности,
	|	ТЧ.КодСпособаВыставления			КАК КодСпособаВыставления,
	|	ТЧ.КФО								КАК КФО,
	|	ТЧ.СчетФактура						КАК СЧФСсылка
	|ПОМЕСТИТЬ
	|	ИсходнаяТаблЧастьНДС
	|ИЗ
	|	&ТЗ_НДС	КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Исходные данные табличной части НДС, плюс служебные поля.
	|//
	|ВЫБРАТЬ
	|	*,
	|	
	|	// Служебные колонки:
	|	(ПричинаНалогообложения В (&ПричиныНалогообложенияДляВыданногоСЧФ))		КАК ЭтоДляВыданногоСЧФ,
	|	(ПричинаНалогообложения В (&ПричиныНалогообложенияДляПолученногоСЧФ))	КАК ЭтоДляПолученногоСЧФ,
	|	ВЫБОР
	|		КОГДА ПричинаНалогообложения В (&ПричиныНалогообложенияДляВыданногоСЧФ) ТОГДА
	|			// Это строка для Выданного сч.-ф.
	|			(ТИПЗНАЧЕНИЯ(СЧФСсылка) = ТИП(Документ.СчетФактураВыданный))
	|			
	|		КОГДА ПричинаНалогообложения В (&ПричиныНалогообложенияДляПолученногоСЧФ) ТОГДА
	|			// Это строка для Полученного сч.-ф.
	|			(ТИПЗНАЧЕНИЯ(СЧФСсылка) = ТИП(Документ.СчетФактураПолученный))
	|		
	|		ИНАЧЕ
	|			(ТИПЗНАЧЕНИЯ(СЧФСсылка) <> ТИП(Документ.СчетФактураВыданный)
	|			И ТИПЗНАЧЕНИЯ(СЧФСсылка) <> ТИП(Документ.СчетФактураПолученный))
	|	КОНЕЦ																	КАК ТипДокументаКорректный,
	|	&ВалютаДокумента														КАК ВалютаДокумента
	|ПОМЕСТИТЬ
	|	ТаблЧастьНДС
	|ИЗ
	|	ИсходнаяТаблЧастьНДС
	|ГДЕ
	|	ПричинаНалогообложения <> ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.ПустаяСсылка)
	|	И СЧФСсылка <> НЕОПРЕДЕЛЕНО // из-за составного типа
	|	И СЧФСсылка <> ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)
	|	И СЧФСсылка <> ЗНАЧЕНИЕ(Документ.СчетФактураПолученный.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. (Подготовка) Все строки с полями, отличающимися от соответствующих полей
	|//		указанного документа счет-фактура.
	|//
	|// Некорректный тип документа:
	|ВЫБРАТЬ
	|	НомерСтроки				КАК НомерСтроки,
	|	1						КАК ОбозначениеОшибки,
	|	ЭтоДляВыданногоСЧФ		КАК ЭтоДляВыданногоСЧФ,
	|	ЭтоДляПолученногоСЧФ	КАК ЭтоДляПолученногоСЧФ
	|ПОМЕСТИТЬ
	|	НекорректныеСЧФ
	|ИЗ
	|	ТаблЧастьНДС
	|ГДЕ
	|	НЕ ТипДокументаКорректный
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Отличающееся поле ""Дата"":
	|ВЫБРАТЬ
	|	НомерСтроки				КАК НомерСтроки,
	|	2						КАК ОбозначениеОшибки,
	|	ЭтоДляВыданногоСЧФ		КАК ЭтоДляВыданногоСЧФ,
	|	ЭтоДляПолученногоСЧФ	КАК ЭтоДляПолученногоСЧФ
	|ИЗ
	|	ТаблЧастьНДС
	|ГДЕ
	|	ТипДокументаКорректный
	|	И ВЫБОР
	|		КОГДА ЭтоДляВыданногоСЧФ ТОГДА
	|			// Это строка для Выданного сч.-ф.
	|			(ГОД(СЧФСсылка.Дата) <> ГОД(ДатаСчетаФактуры)
	|				ИЛИ МЕСЯЦ(СЧФСсылка.Дата) <> МЕСЯЦ(ДатаСчетаФактуры)
	|				ИЛИ ДЕНЬ(СЧФСсылка.Дата) <> ДЕНЬ(ДатаСчетаФактуры))
	|			
	|		КОГДА ЭтоДляПолученногоСЧФ ТОГДА
	|			// Это строка для Полученного сч.-ф.
	|			(СЧФСсылка.ДатаПервичногоДокумента <> ДатаСчетаФактуры)
	|			
	|		ИНАЧЕ
	|			// Иной документ, например, ГТДИмпорт
	|			(ГОД(СЧФСсылка.Дата) <> ГОД(ДатаСчетаФактуры)
	|				ИЛИ МЕСЯЦ(СЧФСсылка.Дата) <> МЕСЯЦ(ДатаСчетаФактуры)
	|				ИЛИ ДЕНЬ(СЧФСсылка.Дата) <> ДЕНЬ(ДатаСчетаФактуры))
	|	КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Отличающееся поле ""Номер"":
	|ВЫБРАТЬ
	|	НомерСтроки				КАК НомерСтроки,
	|	3						КАК ОбозначениеОшибки,
	|	ЭтоДляВыданногоСЧФ		КАК ЭтоДляВыданногоСЧФ,
	|	ЭтоДляПолученногоСЧФ	КАК ЭтоДляПолученногоСЧФ
	|ИЗ
	|	ТаблЧастьНДС
	|ГДЕ
	|	ТипДокументаКорректный
	|	И ВЫБОР
	|		КОГДА ЭтоДляВыданногоСЧФ ТОГДА
	|			// Это строка для Выданного сч.-ф.
	|			(СЧФСсылка.Номер <> НомерСчетаФактуры)
	|			
	|		КОГДА ЭтоДляПолученногоСЧФ ТОГДА
	|			// Это строка для Полученного сч.-ф.
	|			(СЧФСсылка.НомерПервичногоДокумента <> НомерСчетаФактуры)
	|			
	|		ИНАЧЕ
	|			// Иной документ, например, ГТДИмпорт
	|			(СЧФСсылка.Номер <> НомерСчетаФактуры)
	|	КОНЕЦ
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Отличающееся поле ""Контрагент"":
	|ВЫБРАТЬ
	|	НомерСтроки				КАК НомерСтроки,
	|	4						КАК ОбозначениеОшибки,
	|	ЭтоДляВыданногоСЧФ		КАК ЭтоДляВыданногоСЧФ,
	|	ЭтоДляПолученногоСЧФ	КАК ЭтоДляПолученногоСЧФ
	|ИЗ
	|	ТаблЧастьНДС
	|ГДЕ
	|	ТипДокументаКорректный И СЧФСсылка.Контрагент <> Контрагент
	|		
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Отличающееся поле ""Договор"":
	|ВЫБРАТЬ
	|	НомерСтроки				КАК НомерСтроки,
	|	5						КАК ОбозначениеОшибки,
	|	ЭтоДляВыданногоСЧФ		КАК ЭтоДляВыданногоСЧФ,
	|	ЭтоДляПолученногоСЧФ	КАК ЭтоДляПолученногоСЧФ
	|ИЗ
	|	ТаблЧастьНДС
	|ГДЕ
	|	ТипДокументаКорректный И СЧФСсылка.Договор <> Договор
	|		
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Отличающееся поле ""ПричинаНалогообложения"":
	|ВЫБРАТЬ
	|	НомерСтроки				КАК НомерСтроки,
	|	6						КАК ОбозначениеОшибки,
	|	ЭтоДляВыданногоСЧФ		КАК ЭтоДляВыданногоСЧФ,
	|	ЭтоДляПолученногоСЧФ	КАК ЭтоДляПолученногоСЧФ
	|ИЗ
	|	ТаблЧастьНДС
	|ГДЕ
	|	ТипДокументаКорректный
	|	И (ЭтоДляВыданногоСЧФ ИЛИ ЭтоДляПолученногоСЧФ)
	|	И СЧФСсылка.ПричинаНалогообложения <> ПричинаНалогообложения
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Отличающееся поле ""КодСпособаВыставления"":
	|ВЫБРАТЬ
	|	НомерСтроки				КАК НомерСтроки,
	|	8						КАК ОбозначениеОшибки,
	|	ЭтоДляВыданногоСЧФ		КАК ЭтоДляВыданногоСЧФ,
	|	ЭтоДляПолученногоСЧФ	КАК ЭтоДляПолученногоСЧФ
	|ИЗ
	|	ТаблЧастьНДС
	|ГДЕ
	|	ТипДокументаКорректный
	|	И (ЭтоДляВыданногоСЧФ ИЛИ ЭтоДляПолученногоСЧФ)
	|	И СЧФСсылка.КодСпособаВыставления <> КодСпособаВыставления
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Отличающееся поле ""КФО"" (только для Сч-Ф. Выданного):
	|ВЫБРАТЬ
	|	НомерСтроки				КАК НомерСтроки,
	|	9						КАК ОбозначениеОшибки,
	|	ЭтоДляВыданногоСЧФ		КАК ЭтоДляВыданногоСЧФ,
	|	ЭтоДляПолученногоСЧФ	КАК ЭтоДляПолученногоСЧФ
	|ИЗ
	|	ТаблЧастьНДС
	|ГДЕ
	|	// Это строка для Выданного сч.-ф.
	|	ТипДокументаКорректный И ЭтоДляВыданногоСЧФ И СЧФСсылка.КФО <> КФО
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Отличающееся поле ""ВалютаДокумента"":
	|ВЫБРАТЬ
	|	НомерСтроки				КАК НомерСтроки,
	|	10						КАК ОбозначениеОшибки,
	|	ЭтоДляВыданногоСЧФ		КАК ЭтоДляВыданногоСЧФ,
	|	ЭтоДляПолученногоСЧФ	КАК ЭтоДляПолученногоСЧФ
	|ИЗ
	|	ТаблЧастьНДС
	|ГДЕ
	|	ТипДокументаКорректный И
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет ТОГДА
	|			НЕ СЧФСсылка.ВалютаДокумента = ВалютаДокумента
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ
	|;	
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Различающиеся значения полей строки ТЧ и указанного документа счета-фактуры.
	|//		(Финальная таблица для вывода сообщений)
	|//
	|ВЫБРАТЬ
	|	НомерСтроки						КАК НомерСтроки,
	|	МИНИМУМ(ОбозначениеОшибки)		КАК ОбозначениеОшибки,
	|	МИНИМУМ(ЭтоДляВыданногоСЧФ)		КАК ЭтоДляВыданногоСЧФ,
	|	МИНИМУМ(ЭтоДляПолученногоСЧФ)	КАК ЭтоДляПолученногоСЧФ
	|ИЗ
	|	НекорректныеСЧФ
	|СГРУППИРОВАТЬ ПО
	|	НомерСтроки
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";
	
	РезультатПроверки = ЗапросПроверки.Выполнить();
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ИмяПоляДляВыводаСообщений = "СчетФактура";
		ИмяТаблЧастиДляВыводаСообщений = "НДС";
		
		ТекстНекорректныйТип = НСтр("ru='Указан документ счета-фактуры некорректного типа (указан ""%1"", а ожидается ""%2"". Таблица ""НДС"", строка%3)'");
		ТекстНекорректныйТип_Выданный = НСтр("ru='выданный'");
		ТекстНекорректныйТип_Полученный = НСтр("ru='полученный'");
		ТекстНекорректныйТип_Иной = НСтр("ru='не счет-фактура'");

		ТекстРазличноеПоле_ТаблЧасть = НСтр("ru='Указан несоответствующий документ счета-фактуры (значения колонки ""%1"" в строке таблицы и реквизита ""%2"" выбранного документа счета-фактуры различаются. Таблица ""НДС"", строка%3)'");
		ТекстРазличноеПоле_Шапка = НСтр("ru='Указан несоответствующий документ счета-фактуры (значения реквизита ""%1"" шапки и реквизита ""%2"" выбранного документа счета-фактуры различаются. Таблица ""НДС"", строка%3)'");
	
		Выборка = РезультатПроверки.Выбрать();
		Пока Выборка.Следующий() Цикл
			ИндексСтроки = Выборка["НомерСтроки"] - 1;
			НомерСтроки = Символы.НПП + Выборка["НомерСтроки"]; // переводим в строку
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			Если Выборка["ОбозначениеОшибки"] = 1 Тогда
				// Некорректный тип документа
				ИмяПоляДляВыводаСообщений = "СчетФактура";
				
				Если Выборка["ЭтоДляВыданногоСЧФ"] Тогда
					ОжидаемыйТип = ТекстНекорректныйТип_Выданный;
					УказанныйТип = ?(Выборка["ЭтоДляПолученногоСЧФ"], ТекстНекорректныйТип_Полученный, ТекстНекорректныйТип_Иной);
					
				ИначеЕсли Выборка["ЭтоДляПолученногоСЧФ"] Тогда
					ОжидаемыйТип = ТекстНекорректныйТип_Полученный;
					УказанныйТип = ?(Выборка["ЭтоДляВыданногоСЧФ"], ТекстНекорректныйТип_Выданный, ТекстНекорректныйТип_Иной);
					
				Иначе
					ОжидаемыйТип = ТекстНекорректныйТип_Иной;
					УказанныйТип = ТипЗнч(ДокументОбъект["НДС"][Выборка.НомерСтроки - 1].СчетФактура);
				КонецЕсли;
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстНекорректныйТип,
					УказанныйТип,
					ОжидаемыйТип,
					НомерСтроки);
				
			ИначеЕсли Выборка["ОбозначениеОшибки"] = 2 Тогда
				// Отличающееся поле ""Дата""
				
				ПредставлениеКолонки = НСтр("ru='Дата счета-фактуры'");
				ПредставлениеРеквизита = ?(Выборка["ЭтоДляПолученногоСЧФ"], НСтр("ru='Дата первичного документа'"), НСтр("ru='Дата'"));
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстРазличноеПоле_ТаблЧасть,
					ПредставлениеКолонки,
					ПредставлениеРеквизита,
					НомерСтроки);
	
			ИначеЕсли Выборка["ОбозначениеОшибки"] = 3 Тогда
				// Отличающееся поле ""Номер""
				
				ПредставлениеКолонки = НСтр("ru='Номер счета-фактуры'");
				ПредставлениеРеквизита = ?(Выборка["ЭтоДляПолученногоСЧФ"], НСтр("ru='Номер первичного документа'"), НСтр("ru='Номер'"));
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстРазличноеПоле_ТаблЧасть,
					ПредставлениеКолонки,
					ПредставлениеРеквизита,
					НомерСтроки);
				
			ИначеЕсли Выборка["ОбозначениеОшибки"] = 4 Тогда
				// Отличающееся поле ""Контрагент""
				ИмяКолонки = НСтр("ru='Контрагент'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстРазличноеПоле_ТаблЧасть,
					ИмяКолонки,
					ИмяКолонки,
					НомерСтроки);
				
			ИначеЕсли Выборка["ОбозначениеОшибки"] = 5 Тогда
				// Отличающееся поле ""Договор""
				ИмяКолонки = НСтр("ru='Договор'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстРазличноеПоле_ТаблЧасть,
					ИмяКолонки,
					ИмяКолонки,
					НомерСтроки);
	
			ИначеЕсли Выборка["ОбозначениеОшибки"] = 6 Тогда
				// Отличающееся поле ""ПричинаНалогообложения""
				ИмяКолонки = НСтр("ru='Причина налогообложения'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстРазличноеПоле_ТаблЧасть,
					ИмяКолонки,
					ИмяКолонки,
					НомерСтроки);
	
			ИначеЕсли Выборка["ОбозначениеОшибки"] = 8 Тогда
				// Отличающееся поле ""КодСпособаВыставления""
				ИмяКолонки = НСтр("ru='Код способа выставления'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстРазличноеПоле_ТаблЧасть,
					ИмяКолонки,
					ИмяКолонки,
					НомерСтроки);
				
			ИначеЕсли Выборка["ОбозначениеОшибки"] = 9 Тогда
				// Отличающееся поле ""КФО"" (только для Сч-Ф. Выданного)
				ИмяКолонки = НСтр("ru='КФО'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстРазличноеПоле_ТаблЧасть,
					ИмяКолонки,
					ИмяКолонки,
					НомерСтроки);
					
			ИначеЕсли Выборка["ОбозначениеОшибки"] = 10 Тогда
				// Отличающееся поле ""ВалютаДокумента""
				ИмяКолонки = НСтр("ru='ВалютаДокумента'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстРазличноеПоле_Шапка,
					НСтр("ru='Валюта'"),
					НСтр("ru='Валюта'"),
					НомерСтроки);
					
			Иначе
				// Неизвестная ошибка
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Отличаются значения колонки и указанного документа счета-фактуры (Таблица ""НДС"", строка%1)'"),
					НомерСтроки);
			КонецЕсли;
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
				
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента_НДС(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	
	ЗапросДвижения = Новый Запрос();
	ЗапросДвижения.УстановитьПараметр("Ссылка",					ДокументСсылка);
	ЗапросДвижения.УстановитьПараметр("ЗаполнитьВалютныеСуммы",	УчетНДС.СледуетЗаполнитьВалютныеСуммы());
	ЗапросДвижения.Текст = "
	
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Движения по регистру ВходящийНДС
	|//
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)					КАК ВидДвижения,
	|	&Ссылка													КАК Регистратор,
	|	Ссылка.Дата												КАК Период,
	|	ИСТИНА													КАК Активность,
	|	
	|	Ссылка.Организация										КАК Организация,
	|	СчетФактура												КАК СчетФактура,
	|	ПричинаНалогообложения									КАК ПричинаНалогообложения,
	|	ВидЦенности												КАК ВидЦенности,
	|	КФО														КАК КФО,
	|	СчетРасчетов											КАК СчетРасчетов,
	|	КПССчетРасчетов											КАК КПССчетРасчетов,
	|	СчетКредита												КАК СчетКредита,
	|	ВЫБОР
	|		КОГДА ОбъектНалогообложения <> НЕОПРЕДЕЛЕНО ТОГДА
	|			ОбъектНалогообложения
	|		ИНАЧЕ
	|			СчетФактура
	|	КОНЕЦ													КАК ОбъектНалогообложения,
	|	СтавкаНДС												КАК СтавкаНДС,
	|	СуммаБезНДСРублевая										КАК СуммаБезНДС,
	|	СуммаНДСРублевая										КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			СуммаБезНДС
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ													КАК СуммаБезНДСВалютная,
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			СуммаНДС
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ													КАК СуммаНДСВалютная
	|ИЗ
	|	Документ.ВводНачальныхОстатков.НДС
	|ГДЕ
	|	Ссылка = &Ссылка
	|	И Ссылка.ВходящийНДС = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Движения по регистру ИсходящийНДС
	|//
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)					КАК ВидДвижения,
	|	&Ссылка													КАК Регистратор,
	|	Ссылка.Дата												КАК Период,
	|	ИСТИНА													КАК Активность,
	|	
	|	Ссылка.Организация										КАК Организация,
	|	СчетФактура												КАК СчетФактура,
	|	ПричинаНалогообложения									КАК ПричинаНалогообложения,
	|	КФО														КАК КФО,
	|	СчетРасчетов											КАК СчетРасчетов,
	|	КПССчетРасчетов											КАК КПССчетРасчетов,
	|	СчетДебета												КАК СчетДебета,
	|	КЭКСчетДебета											КАК КОСГУСчетДебета,
	|	ВЫБОР
	|		КОГДА ОбъектНалогообложения <> НЕОПРЕДЕЛЕНО ТОГДА
	|			ОбъектНалогообложения
	|		ИНАЧЕ
	|			СчетФактура
	|	КОНЕЦ													КАК ОбъектНалогообложения,
	|	СтавкаНДС												КАК СтавкаНДС,
	|	СуммаБезНДСРублевая										КАК СуммаБезНДС,
	|	СуммаНДСРублевая										КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			СуммаБезНДС
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ													КАК СуммаБезНДСВалютная,
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			СуммаНДС
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ													КАК СуммаНДСВалютная
	|ИЗ
	|	Документ.ВводНачальныхОстатков.НДС
	|ГДЕ
	|	Ссылка = &Ссылка
	|	И Ссылка.ВходящийНДС = ЛОЖЬ
	|;";
	
	РезультатыЗапросов = ЗапросДвижения.ВыполнитьПакет();
	
	// [0]. Движения по регистру ВходящийНДС
	ТаблицаВходящийНДС	= РезультатыЗапросов[0].Выгрузить();
	
	// [1]. Движения по регистру ИсходящийНДС
	ТаблицаИсходящийНДС	= РезультатыЗапросов[1].Выгрузить();
	
	ТаблицыДляДвижений.Вставить("ВходящийНДС",	ТаблицаВходящийНДС);
	ТаблицыДляДвижений.Вставить("ИсходящийНДС",	ТаблицаИсходящийНДС);
	
	ИмяРегистраНДС = ?(ДокументСсылка.ВходящийНДС,
		"ВходящийНДС",
		"ИсходящийНДС");
	ДополнительныеСвойства.Вставить("ИмяРегистраНДС", ИмяРегистраНДС);
	
КонецПроцедуры

Функция ПодготовитьТаблицуПроводок_ВходящийНДС(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ) Экспорт
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	// Подготовка:
	ИФО = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"),
		ДокументОбъект["ИФО"],
		Неопределено);
	НаДату = ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(ДокументОбъект["Дата"]);
	СтруктураРПС = БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(ДокументОбъект["Организация"], ИФО, НаДату);
	
	ОжидаемыеДополнительныеРеквизиты = Новый Структура("
		|КорСчет,
		|КПСКорСчет,
		|КЭККорСчет,
		|СубконтоКорСчет1,
		|СубконтоКорСчет2,
		|СубконтоКорСчет3");
	ЗаполнитьЗначенияСвойств(ОжидаемыеДополнительныеРеквизиты, ДополнительныеРеквизиты);
	ИспользоватьКорСчет = (ЗначениеЗаполнено(ОжидаемыеДополнительныеРеквизиты["КорСчет"])
		И НЕ ОжидаемыеДополнительныеРеквизиты["КорСчет"] = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("000"));
	
	ЗапросДвижения = Новый Запрос();
	ЗапросДвижения.УстановитьПараметр("Ссылка",					ДокументОбъект["Ссылка"]);
	ЗапросДвижения.УстановитьПараметр("СтруктураРПС",			СтруктураРПС);
	ЗапросДвижения.УстановитьПараметр("КЭК000",					БухгалтерскийУчетПовтИсп.КЭК0());
	ЗапросДвижения.УстановитьПараметр("Содержание",				НСтр("ru='Формирование остатков на счете 210.01'"));
	ЗапросДвижения.УстановитьПараметр("ЗаполнитьВалютныеСуммы",	УчетНДС.СледуетЗаполнитьВалютныеСуммы());
	
	ЗапросДвижения.УстановитьПараметр("ИспользоватьКорСчет",	ИспользоватьКорСчет);
	ЗапросДвижения.УстановитьПараметр("КорСчет",				ОжидаемыеДополнительныеРеквизиты["КорСчет"]);
	ЗапросДвижения.УстановитьПараметр("КПСКорСчет",				ОжидаемыеДополнительныеРеквизиты["КПСКорСчет"]);
	ЗапросДвижения.УстановитьПараметр("КЭККорСчет",				ОжидаемыеДополнительныеРеквизиты["КЭККорСчет"]);
	ЗапросДвижения.УстановитьПараметр("СубконтоКорСчет1",		ОжидаемыеДополнительныеРеквизиты["СубконтоКорСчет1"]);
	ЗапросДвижения.УстановитьПараметр("СубконтоКорСчет2",		ОжидаемыеДополнительныеРеквизиты["СубконтоКорСчет2"]);
	ЗапросДвижения.УстановитьПараметр("СубконтоКорСчет3",		ОжидаемыеДополнительныеРеквизиты["СубконтоКорСчет3"]);
	ЗапросДвижения.УстановитьПараметр("Счет000",				БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("000"));
	
	ЗапросДвижения.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Признаки использования произвольной классификации КЭК.
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ
	|	КФО											КАК КФО,
	|	ВЫБОР
	|		КОГДА	ТипКЭК = ЗНАЧЕНИЕ(Перечисление.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация)
	|			ИЛИ ТипКЭК = ЗНАЧЕНИЕ(Перечисление.ТипыАналитическихПризнаков.КлассификацияАУБУ)
	|			ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ										КАК ИспользоватьКЭК0
	|ПОМЕСТИТЬ
	|	КлассификацияКЭК
	|ИЗ
	|	РегистрСведений.НастройкиСтруктурРПС
	|ГДЕ
	|	СтруктураРПС = &СтруктураРПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Частично заполненные (по дебету) движения по регистру бухгалтерии
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИСТИНА													КАК Активность,
	|	&Ссылка													КАК Регистратор,
	|	НДС.Ссылка.Организация									КАК Организация,
	|	НДС.Ссылка.Дата											КАК Период,
	|	НДС.Ссылка.ИФО											КАК ИФО,
	|	НДС.КФО													КАК КФО,
	|	НДС.Ссылка.ВидПервичногоДокумента						КАК ВидПервичногоДокумента,
	|	ВЫБОР
	|		КОГДА НДС.Ссылка.ВидПервичногоДокумента = """" ТОГДА
	|			ДАТАВРЕМЯ(1,1,1)
	|		ИНАЧЕ
	|			НДС.Ссылка.Дата
	|	КОНЕЦ													КАК ДатаПервичногоДокумента,
	|	ВЫБОР
	|		КОГДА НДС.Ссылка.ВидПервичногоДокумента = """" ТОГДА
	|			""""
	|		ИНАЧЕ
	|			НДС.Ссылка.Номер
	|	КОНЕЦ													КАК НомерПервичногоДокумента,
	|	&Содержание												КАК Содержание,
	|	НДС.СуммаНДСРублевая									КАК Сумма,
	|	
	|	// Дебет
	|	НДС.СчетКредита											КАК СчетДт,
	|	НДС.СчетКредита.Забалансовый							КАК СчетДтЗабалансовый,
	|	НДС.СчетКредита.НомерЖурнала							КАК СчетДтНомерЖурнала,
	|	НДС.СчетКредита.НомерЖурнала.Приоритет					КАК СчетДтПриоритет,
	|	НДС.КПССчетРасчетов										КАК КПСДт,
	|	ВЫБОР
	|		КОГДА КлассификацияКЭК.ИспользоватьКЭК0 ТОГДА
	|			&КЭК000
	|		ИНАЧЕ
	|			НДС.СчетКредита.КОСГУДт
	|	КОНЕЦ													КАК КЭКДт,
	|	НДС.Контрагент											КАК СубконтоДт1,
	|	ВЫБОР
	|		КОГДА НЕ НДС.ОбъектНалогообложения = НЕОПРЕДЕЛЕНО ТОГДА
	|			НДС.ОбъектНалогообложения
	|		ИНАЧЕ
	|			НДС.СчетФактура
	|	КОНЕЦ													КАК СубконтоДт2,
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы И НДС.СчетКредита.Валютный ТОГДА
	|			НДС.Ссылка.ВалютаДокумента
	|	КОНЕЦ													КАК ВалютаДт,
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы И НДС.СчетКредита.Валютный ТОГДА
	|			НДС.СуммаНДС
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ													КАК ВалютнаяСуммаДт,
	|	ВЫБОР
	|		КОГДА НДС.СчетКредита.УчетПоПодразделениям ТОГДА
	|			НДС.Ссылка.ПодразделениеОрганизации
	|	КОНЕЦ													КАК ПодразделениеДт,
	|	
	|	КлассификацияКЭК.ИспользоватьКЭК0						КАК ИспользоватьКЭК0,
	|	
	|	// Значения, необходимые для заполнения стороны кредита (далее)
	|	ВЫБОР
	|		КОГДА &ИспользоватьКорСчет ТОГДА
	|			ВЫРАЗИТЬ(&КорСчет	КАК ПланСчетов.ЕПСБУ)
	|		ИНАЧЕ
	|			&Счет000
	|	КОНЕЦ													КАК СчетКт,
	|	НДС.Ссылка.ПодразделениеОрганизации						КАК СлужебнаяКолонка_ПодразделениеОрганизации,
	|	НДС.Ссылка.ВалютаДокумента								КАК СлужебнаяКолонка_ВалютаДокумента,
	|	НДС.СуммаНДС											КАК СлужебнаяКолонка_СуммаНДС,
	|	ВЫБОР
	|		КОГДА НДС.КПССчетРасчетов.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КДБ) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ													КАК СлужебнаяКолонка_КПСДтДоходный
	|ПОМЕСТИТЬ
	|	Движения
	|ИЗ
	|	Документ.ВводНачальныхОстатков.НДС	КАК НДС
	|	ЛЕВОЕ СОЕДИНЕНИЕ	КлассификацияКЭК
	|		ПО	НДС.КФО = КлассификацияКЭК.КФО
	|ГДЕ
	|	НДС.Ссылка = &Ссылка
	|	И НДС.Ссылка.ВходящийНДС = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Движения по регистру бухгалтерии
	|//		(Финальная таблица для дальнейшей обработки)
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	// Дебет, Сумма, Содержение
	|	*,
	|	
	|	// Кредит
	|	СчетКт													КАК СчетКт,
	|	СчетКт.Забалансовый										КАК СчетКтЗабалансовый,
	|	СчетКт.НомерЖурнала										КАК СчетКтНомерЖурнала,
	|	СчетКт.НомерЖурнала.Приоритет							КАК СчетКтПриоритет,
	|	ВЫБОР
	|		КОГДА СчетКт.УчетПоКПС И &ИспользоватьКорСчет И СлужебнаяКолонка_КПСДтДоходный ТОГДА
	|			ВЫРАЗИТЬ(&КПСКорСчет	КАК Справочник.КлассификационныеПризнакиСчетов)
	|		КОГДА СчетКт.УчетПоКПС ТОГДА
	|			КПСДт
	|	КОНЕЦ													КАК КПСКт,
	|	ВЫБОР
	|		КОГДА СчетКт.УчетПоКЭК И ИспользоватьКЭК0 ТОГДА
	|			&КЭК000
	|		КОГДА СчетКт.УчетПоКЭК И &ИспользоватьКорСчет ТОГДА
	|			&КЭККорСчет
	|	КОНЕЦ													КАК КЭККт,
	|	ВЫБОР
	|		КОГДА &ИспользоватьКорСчет ТОГДА
	|			&СубконтоКорСчет1
	|	КОНЕЦ													КАК СубконтоКт1,
	|	ВЫБОР
	|		КОГДА &ИспользоватьКорСчет ТОГДА
	|			&СубконтоКорСчет2
	|	КОНЕЦ													КАК СубконтоКт2,
	|	ВЫБОР
	|		КОГДА &ИспользоватьКорСчет ТОГДА
	|			&СубконтоКорСчет3
	|	КОНЕЦ													КАК СубконтоКт3,
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы И СчетКт.Валютный ТОГДА
	|			СлужебнаяКолонка_ВалютаДокумента
	|	КОНЕЦ													КАК ВалютаКт,
	|	ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы И СчетКт.Валютный ТОГДА
	|			СлужебнаяКолонка_СуммаНДС
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ													КАК ВалютнаяСуммаКт,
	|	ВЫБОР
	|		КОГДА СчетКт.УчетПоПодразделениям ТОГДА
	|			СлужебнаяКолонка_ПодразделениеОрганизации
	|	КОНЕЦ													КАК ПодразделениеКт
	|ИЗ
	|	Движения
	|;";
	
	ВыборкаДвижения = ЗапросДвижения.Выполнить().Выбрать();
	
	Пока ВыборкаДвижения.Следующий() Цикл
		СтрокаТЗ = ТаблицаПроводок.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТЗ, ВыборкаДвижения);
		
		СтрокаТЗ.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(СтрокаТЗ.СчетДт, СтрокаТЗ.СчетКт);
	КонецЦикла;
	
	Возврат ТаблицаПроводок;
	
КонецФункции


// Создает документы счетов-фактур на основании содержимого табличной части "НДС" указанного документа.
// При успешной настройке документов счетов-фактур заполняется колонка "СчетФактура".
Функция СоздатьДокументыСчетовФактур(ДокументОбъект, ПодставлятьУжеСозданныеПодходящие = Истина) Экспорт
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	ТаблицаОшибок = Новый ТаблицаЗначений();
	ТаблицаОшибок.Колонки.Добавить("ИндексСтроки",				Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(6,0,ДопустимыйЗнак.Неотрицательный)));
	ТаблицаОшибок.Колонки.Добавить("НомерСтрокиПредставление",	ТипСтрока);
	ТаблицаОшибок.Колонки.Добавить("ВидСчетаФактуры",			ТипСтрока);
	ТаблицаОшибок.Колонки.Добавить("Описание",					ТипСтрока);
	
	КоличествоДокументов = Новый Структура();
	КоличествоДокументов.Вставить("Выданный",		Новый Структура("Создано,Ошибок", 0,0));
	КоличествоДокументов.Вставить("Полученный",		Новый Структура("Создано,Ошибок", 0,0));
	КоличествоДокументов.Вставить("ПодставленоРаз",	0);
	
	// Возвращаемая статистика работы
	Статистика = Новый Структура();
	Статистика.Вставить("КоличествоДокументов",	КоличествоДокументов);
	Статистика.Вставить("ТаблицаОшибок",		ТаблицаОшибок);
	
	КоличествоСтрокКОбработке = 0;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект["НДС"] Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы["СчетФактура"]) Тогда
			КоличествоСтрокКОбработке = КоличествоСтрокКОбработке + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Статистика.Вставить("КоличествоСтрокКОбработке", КоличествоСтрокКОбработке);
	
	Если КоличествоСтрокКОбработке = 0 Тогда
		Возврат Статистика;
	КонецЕсли;
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	
	РезультатыПоиска = НайтиСчетаФактуры(ДокументОбъект, ИспользоватьВалютныйУчет);
	
	МаксДлинаСообщения = 50;
	
	ВидСчетаФактурыВыданный = НСтр("ru='Выданный'");
	ВидСчетаФактурыПолученный = НСтр("ru='Полученный'");
	
	
	// [19]. Данные для создания новых документов сч.ф. (и модификации подобранных)
	//		и для заполнения их табл.частей ""СоставНФА""
	РезультатПоиска = РезультатыПоиска[19];
	
	ОбщееКоличествоГруппировок = 8; // см.запрос, раздел ИТОГИ ПО
	
	КоличествоСоздано		= 0;
	КоличествоНЕСоздано		= 0;
	КоличествоИзменено		= 0;
	КоличествоНЕИзменено	= 0;
	
	// Имена устанавливаемых реквизитов шапки:
	РеквизитыШапкиСчетФактураВыданный	= "Организация, Контрагент, Договор, ПричинаНалогообложения, КодСпособаВыставления, КФО";
	РеквизитыШапкиСчетФактураПолученный	= "Организация, Контрагент, Договор, ПричинаНалогообложения, КодСпособаВыставления";
	
	Если ИспользоватьВалютныйУчет Тогда
		РеквизитыШапкиСчетФактураВыданный	= РеквизитыШапкиСчетФактураВыданный + ", ВалютаДокумента";
		РеквизитыШапкиСчетФактураПолученный	= РеквизитыШапкиСчетФактураПолученный + ", ВалютаДокумента";
	КонецЕсли;
	
	Выборки = Новый Массив(ОбщееКоличествоГруппировок);
	
	инд = 0;
	
	Выборки[инд] = РезультатПоиска.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока инд >= 0 Цикл
		Пока Выборки[инд].Следующий() Цикл
			
			Если инд = ОбщееКоличествоГруппировок - 1 Тогда
				// Самая глубокая группировка
				
				ВыборкаШапка = Выборки[инд];
				
				ВыборкаТаблЧасть = ВыборкаШапка.Выбрать();
				
				Если НЕ ВыборкаШапка["СоздатьДокумент"] Тогда
					// Выполняем только создание новых документов.
					// Модификацию уже существующих документов не выполняем.
					Продолжить;
				КонецЕсли;
				
				ЭтоДляВыданногоСЧФ = ВыборкаШапка["ЭтоДляВыданногоСЧФ"];
				
				Попытка
					
					Если ЭтоДляВыданногоСЧФ Тогда
						СчетФактураОбъект = Документы.СчетФактураВыданный.СоздатьДокумент();
					Иначе
						СчетФактураОбъект = Документы.СчетФактураПолученный.СоздатьДокумент();
					КонецЕсли;
					
					СчетФактураОбъект["ВводНачальныхОстатков"] = Истина;
					
					СчетФактураОбъект["Организация"]	= ДокументОбъект["Организация"];
					
					ЗаполнитьЗначенияСвойств(СчетФактураОбъект, ВыборкаШапка,
						?(ЭтоДляВыданногоСЧФ, РеквизитыШапкиСчетФактураВыданный, РеквизитыШапкиСчетФактураПолученный));
						
					Если ЭтоДляВыданногоСЧФ Тогда
						// Для Выданного
						СчетФактураОбъект["Дата"]	= ВыборкаШапка["ДатаСчетаФактуры"];
						СчетФактураОбъект["Номер"]	= ВыборкаШапка["НомерСчетаФактуры"];
					Иначе
						// Для Полученного
						СчетФактураОбъект["Дата"]						= ВыборкаШапка["ДатаСчетаФактуры"];
						СчетФактураОбъект["ДатаПервичногоДокумента"]	= ВыборкаШапка["ДатаСчетаФактуры"];
						СчетФактураОбъект["НомерПервичногоДокумента"]	= ВыборкаШапка["НомерСчетаФактуры"];
					КонецЕсли;
					
					// Документ-основание
					Если ЭтоДляВыданногоСЧФ Тогда
						СчетФактураОбъект["ДокументОснование"] = ДокументОбъект["Ссылка"];
					Иначе
						НоваяСтрокаТЧ = СчетФактураОбъект["ДокументыОснования"].Добавить();
						НоваяСтрокаТЧ["ДокументОснование"] = ДокументОбъект["Ссылка"];
					КонецЕсли;
					
					
					// Табличная часть СоставНФА
					Пока ВыборкаТаблЧасть.Следующий() Цикл
						НоваяСтрокаТЧ = СчетФактураОбъект["СоставНФА"].Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, ВыборкаТаблЧасть);
					КонецЦикла;
					
					СчетФактураОбъект.Комментарий = НСтр("ru='#Создан автоматически из документа ""Ввод начальных остатков""#'");
					
					СчетФактураОбъект.Записать(РежимЗаписиДокумента.Запись);
					
					
					// Здесь документ успешно записан.
					
					СчетФактураСсылка = СчетФактураОбъект["Ссылка"];
					
					// Прописываем ссылку на созданный документ в табличную часть ввода остатков
					ВыборкаТаблЧасть.Сбросить();
					Пока ВыборкаТаблЧасть.Следующий() Цикл
						ИндексСтроки = ВыборкаТаблЧасть["НомерСтроки"] - 1;
						
						СтрокаТЧ = ДокументОбъект["НДС"][ИндексСтроки];
						
						СтрокаТЧ["СчетФактура"] = СчетФактураСсылка;
					КонецЦикла;
					
					// Обновляем статистику
					СтруктураКоличество = Статистика["КоличествоДокументов"][?(ЭтоДляВыданногоСЧФ, "Выданный", "Полученный")];
					СтруктураКоличество["Создано"] = СтруктураКоличество["Создано"] + 1;
					
				Исключение
					
					// Обновляем статистику
					
					НомераСтрок = Новый Массив();
					
					ВыборкаТаблЧасть.Сбросить();
					
					Пока ВыборкаТаблЧасть.Следующий() Цикл
						НомераСтрок.Добавить(ВыборкаТаблЧасть["НомерСтроки"]);
					КонецЦикла;
					
					ИндексСтроки = НомераСтрок[0] - 1;
					
					НомерСтрокиПредставление = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения("%1", НомераСтрок, МаксДлинаСообщения, "%1");
					
					СтрокаОшибки = ТаблицаОшибок.Добавить();
					
					СтрокаОшибки["ИндексСтроки"]				= ИндексСтроки;
					СтрокаОшибки["НомерСтрокиПредставление"]	= НомерСтрокиПредставление;
					СтрокаОшибки["ВидСчетаФактуры"]				= ?(ЭтоДляВыданногоСЧФ, ВидСчетаФактурыВыданный, ВидСчетаФактурыПолученный);
					СтрокаОшибки["Описание"]					= НСтр("ru='Ошибка при создании документа. '") + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					
					СтруктураКоличество = Статистика["КоличествоДокументов"][?(ЭтоДляВыданногоСЧФ, "Выданный", "Полученный")];
					СтруктураКоличество["Ошибок"] = СтруктураКоличество["Ошибок"] + 1;
					
				КонецПопытки;
				
				инд = инд - 1;
				
			Иначе
				// Не самая глубокая группировка. Шагаем еще ниже:
				Выборки[инд+1] = Выборки[инд].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				инд = инд + 1;
			КонецЕсли;
			
		КонецЦикла;
		
		инд = инд - 1;
		
	КонецЦикла;
	
	
	Если ПодставлятьУжеСозданныеПодходящие Тогда
		
		// [20]. Уже существующие счета-фактуры, полностью подходящие
		//		для строк табл.части, в которых не заполнен документ счета-фактуры.
		РезультатПоиска = РезультатыПоиска[20];
		
		Выборка = РезультатПоиска.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ИндексСтроки = Выборка["НомерСтроки"] - 1;
			
			СтрокаТЧ = ДокументОбъект["НДС"][ИндексСтроки];
			
			СтрокаТЧ["СчетФактура"] = Выборка["Ссылка"];
			
			КоличествоДокументов["ПодставленоРаз"] = КоличествоДокументов["ПодставленоРаз"] + 1;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// [21]. Строки табл.части, в которых не заполнен документ счета-фактуры, и
	//		- подобрать существующий сч.ф. не удалось
	//		- создать новый сч.ф. не получится, т.к. планируемые Номер и Дата
	//			уже заняты существующим сч.ф. (который не подошел сюда полностью)
	РезультатПоиска = РезультатыПоиска[21];
	
	Выборка = РезультатПоиска.Выбрать();
	
	ТекстШаблон = НСтр("ru='Уже существует документ с такими номером и датой (%1). Счет-фактура не был выбран в данную строку, так как его содержимое отличается от планируемого к созданию.'");
	
	Пока Выборка.Следующий() Цикл
		
		НомерСтроки = Выборка["НомерСтроки"];
		
		СтрокаОшибки = ТаблицаОшибок.Добавить();
		
		СтрокаОшибки["ИндексСтроки"]				= НомерСтроки - 1;
		СтрокаОшибки["НомерСтрокиПредставление"]	= Формат(НомерСтроки, "ЧГ=0");
		СтрокаОшибки["ВидСчетаФактуры"]				= ?(Выборка["ЭтоДляВыданногоСЧФ"], ВидСчетаФактурыВыданный, ВидСчетаФактурыПолученный);
		СтрокаОшибки["Описание"]					= СтрШаблон(ТекстШаблон, Выборка["Ссылка"]);
		
	КонецЦикла;
	
	
	// [22]. Определение строк, по которым не удастся создать новые документы.
	РезультатПоиска = РезультатыПоиска[22];
	
	ТекстСообщения = НСтр("ru='Различаются значения в строках, планируемых к включению в один документ'");
	
	ДеревоВыборка = РезультатПоиска.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для Каждого СтрокаИтого Из ДеревоВыборка.Строки Цикл
		
		НомераСтрок = СтрокаИтого.Строки.ВыгрузитьКолонку("НомерСтроки");
		
		НомерСтрокиПредставление = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения("%1", НомераСтрок, МаксДлинаСообщения, "%1");
		
		СтрокаОшибки = ТаблицаОшибок.Добавить();
		
		СтрокаОшибки["ИндексСтроки"]				= НомераСтрок[0] - 1;
		СтрокаОшибки["НомерСтрокиПредставление"]	= НомерСтрокиПредставление;
		СтрокаОшибки["ВидСчетаФактуры"]				= ?(Выборка["ЭтоДляВыданногоСЧФ"], ВидСчетаФактурыВыданный, ВидСчетаФактурыПолученный);
		СтрокаОшибки["Описание"]					= ТекстСообщения;
		
	КонецЦикла;
	
	Возврат Статистика;
	
КонецФункции

Функция НайтиСчетаФактуры(ДокументОбъект, ИспользоватьВалютныйУчет)
	
	// Ключевые поля для поиска и создания документов счетов-фактур
	//
	//	Полученный
	//		Контрагент
	//		Договор
	//		НомерПервичногоДокумента
	//		ДатаПервичногоДокумента
	//
	//	Выданный
	//		Номер
	//		Дата
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект["Ссылка"]) Тогда
		
		ВызватьИсключение НСтр("ru='Для возможности поиска счетов-фактур редактируемый документ ввода начальных остатков должен быть записан (иметь ссылку)'"); 
		
	КонецЕсли;
	
	ПричиныНалогообложенияДляВыданногоСЧФ = УчетНДСПовтИсп.ПолучитьПричиныНалогообложенияДляСчетаФактурыВыданного();
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Организация",							ДокументОбъект["Организация"]);
	ЗапросПоиск.УстановитьПараметр("ДокСсылка",								ДокументОбъект["Ссылка"]);
	ЗапросПоиск.УстановитьПараметр("ПричиныНалогообложенияДляВыданногоСЧФ", ПричиныНалогообложенияДляВыданногоСЧФ);
	ЗапросПоиск.УстановитьПараметр("ТЗ_НДС",								ДокументОбъект["НДС"].Выгрузить());
	ЗапросПоиск.УстановитьПараметр("ВалютаДокумента",						ДокументОбъект["ВалютаДокумента"]);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьВалютныйУчет",				ИспользоватьВалютныйУчет);
	ЗапросПоиск.УстановитьПараметр("Счет30304",								БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("303.04"));
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходные данные табличной части НДС.
	|//
	|ВЫБРАТЬ
	|	ТЧ.НомерСтроки					КАК НомерСтроки,
	|	
	|	ТЧ.НомерСчетаФактуры			КАК НомерСчетаФактуры,
	|	ТЧ.ДатаСчетаФактуры				КАК ДатаСчетаФактуры,
	|	ТЧ.Контрагент					КАК Контрагент,
	|	ТЧ.Договор						КАК Договор,
	|	
	|	ТЧ.ПричинаНалогообложения		КАК ПричинаНалогообложения,
	|	ТЧ.КФО							КАК КФО,
	|	ТЧ.КодСпособаВыставления		КАК КодСпособаВыставления,
	|	ТЧ.СчетФактура					КАК СЧФСсылка,
	|	
	|	ТЧ.СчетКредита					КАК СчетКредита,
	|	ТЧ.СчетДебета					КАК СчетДебета,
	|	ТЧ.КЭКСчетДебета				КАК КЭКСчетДебета,
	|	ТЧ.СубконтоСчетДебета1			КАК СубконтоСчетДебета1,
	|	ТЧ.СубконтоСчетДебета2			КАК СубконтоСчетДебета2,
	|	ТЧ.СубконтоСчетДебета3			КАК СубконтоСчетДебета3,
	|	ТЧ.СчетРасчетов					КАК СчетРасчетов,
	|	ТЧ.КПССчетРасчетов				КАК КПССчетРасчетов,
	|	
	|	ТЧ.СтавкаНДС					КАК СтавкаНДС,
	|	ТЧ.СуммаБезНДС					КАК СуммаБезНДСВалютная,
	|	ТЧ.СуммаНДС						КАК СуммаНДСВалютная,
	|	ТЧ.СуммаБезНДСРублевая			КАК СуммаБезНДСРублевая,
	|	ТЧ.СуммаНДСРублевая				КАК СуммаНДСРублевая
	|ПОМЕСТИТЬ
	|	ИсходнаяТаблЧастьНДС
	|ИЗ
	|	&ТЗ_НДС	КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Исходные данные табличной части НДС, плюс служебные поля.
	|//
	|ВЫБРАТЬ
	|	*,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет ТОГДА
	|			СуммаБезНДСВалютная
	|		ИНАЧЕ
	|			СуммаБезНДСРублевая
	|	КОНЕЦ								КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет ТОГДА
	|			СуммаНДСВалютная
	|		ИНАЧЕ
	|			СуммаНДСРублевая
	|	КОНЕЦ								КАК СуммаНДС,
	|	
	|	// Служебные колонки:
	|	ВЫБОР
	|		КОГДА ПричинаНалогообложения В (&ПричиныНалогообложенияДляВыданногоСЧФ) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ								КАК ЭтоДляВыданногоСЧФ,
	|	ВЫБОР
	|		КОГДА ПричинаНалогообложения В (&ПричиныНалогообложенияДляВыданногоСЧФ) ТОГДА
	|			// Это строка для Выданного сч.-ф.
	|			ВЫБОР
	|				КОГДА ТИПЗНАЧЕНИЯ(СЧФСсылка) = ТИП(Документ.СчетФактураВыданный) ИЛИ СЧФСсылка = НЕОПРЕДЕЛЕНО ТОГДА
	|					ИСТИНА
	|				ИНАЧЕ
	|					ЛОЖЬ
	|			КОНЕЦ
	|		ИНАЧЕ
	|			// Это строка для Полученного сч.-ф.
	|			ВЫБОР
	|				КОГДА ТИПЗНАЧЕНИЯ(СЧФСсылка) = ТИП(Документ.СчетФактураПолученный) ИЛИ СЧФСсылка = НЕОПРЕДЕЛЕНО ТОГДА
	|					ИСТИНА
	|				ИНАЧЕ
	|					ЛОЖЬ
	|			КОНЕЦ
	|	КОНЕЦ								КАК ТипДокументаКорректный,
	|	ВЫБОР
	|		КОГДА СЧФСсылка = НЕОПРЕДЕЛЕНО // из-за составного типа
	|			ИЛИ СЧФСсылка = ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)
	|			ИЛИ СЧФСсылка = ЗНАЧЕНИЕ(Документ.СчетФактураПолученный.ПустаяСсылка)
	|			ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ								КАК СЧФСсылкаУказан
	|ПОМЕСТИТЬ
	|	ТаблЧастьНДС
	|ИЗ
	|	ИсходнаяТаблЧастьНДС
	|ГДЕ
	|	НЕ ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.ПустаяСсылка)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерСтроки,
	|	Контрагент,
	|	Договор,
	|	НомерСчетаФактуры,
	|	ДатаСчетаФактуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Удаляем неиспользуемую далее временную таблицу.
	|//
	|УНИЧТОЖИТЬ	ИсходнаяТаблЧастьНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. (Подготовка) Полученные счета-фактуры, введенные на основании ДокСсылка.
	|//		(Все счета фактуры, введенные на основании ДокСсылка)
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ВсеСчетаФактурыПолученныеНаОсновании
	|ИЗ
	|	Документ.СчетФактураПолученный.ДокументыОснования	КАК ДокументыОснования
	|ГДЕ
	|	ДокументОснование = &ДокСсылка
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Все счета фактуры (полученные и выданные), введенные на основании ДокСсылка.
	|//
	|// Счета-фактуры Полученные, введенные на основании этого документа:
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка				КАК Ссылка,
	|	ЛОЖЬ				КАК ЭтоДляВыданногоСЧФ,
	|	МИНИМУМ(ВЫБОР
	|		КОГДА НЕ ДокументОснование = &ДокСсылка ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ)				КАК ДокСсылкаЯвляетсяИсключительнымОснованием
	|ПОМЕСТИТЬ
	|	ВсеСчетаФактурыВведенныеНаОснованииДокСсылка
	|ИЗ
	|	Документ.СчетФактураПолученный.ДокументыОснования	КАК ДокументыОснования
	|ГДЕ
	|	Ссылка В (ВЫБРАТЬ Ссылка ИЗ ВсеСчетаФактурыПолученныеНаОсновании)
	|СГРУППИРОВАТЬ ПО
	|	Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Счета-фактуры Выданные, введенные на основании этого документа:
	|ВЫБРАТЬ
	|	Ссылка				КАК Ссылка,
	|	ИСТИНА				КАК ЭтоДляВыданногоСЧФ,
	|	ИСТИНА				КАК ДокСсылкаЯвляетсяИсключительнымОснованием
	|ИЗ
	|	Документ.СчетФактураВыданный
	|ГДЕ
	|	ДокументОснование = &ДокСсылка
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. (Подготовка) Уже существующие счета-фактуры с подходящими номерами и датами
	|//		для строк табл.части, в которых не заполнен документ счета-фактуры.
	|//		
	|// Документы """"Счет-фактура Полученный"""":
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СФ.Ссылка					КАК Ссылка,
	|	ЛОЖЬ						КАК ЭтоДляВыданногоСЧФ,
	|	ТаблЧастьНДС.НомерСтроки	КАК НомерСтроки,
	|	
	|	СФ.Контрагент				КАК Контрагент,
	|	СФ.Договор					КАК Договор,
	|	СФ.ПричинаНалогообложения	КАК ПричинаНалогообложения,
	|	СФ.КодСпособаВыставления	КАК КодСпособаВыставления,
	|	НЕОПРЕДЕЛЕНО				КАК КФО,
	|	СФ.ВалютаДокумента			КАК ВалютаДокумента
	|ПОМЕСТИТЬ
	|	ВсеПодходящиеПоНомеруИДатеСчетаФактуры
	|ИЗ
	|	Документ.СчетФактураПолученный	КАК СФ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ТаблЧастьНДС
	|		ПО	ТаблЧастьНДС.ЭтоДляВыданногоСЧФ = ЛОЖЬ
	|		И	ТаблЧастьНДС.СЧФСсылкаУказан = ЛОЖЬ
	|		И	СФ.Организация = &Организация
	|		И	СФ.НомерПервичногоДокумента = ТаблЧастьНДС.НомерСчетаФактуры
	|		И	СФ.ДатаПервичногоДокумента  = ТаблЧастьНДС.ДатаСчетаФактуры
	|		
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Документы """"Счет-фактура Выданный"""":
	|ВЫБРАТЬ
	|	СФ.Ссылка					КАК Ссылка,
	|	ИСТИНА						КАК ЭтоДляВыданногоСЧФ,
