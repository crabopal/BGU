	Возврат Новый ФиксированнаяСтруктура(ИменаКолонок);
	
КонецФункции

Процедура ПолнаяТабличнаяЧастьОС_ОбновитьСервер(Форма) Экспорт
	
	ДокументОбъект = Форма.Объект;
	
	ПоляОСПолная = "";
	
	// Колонки табл.части "ОС Основная"
	ИменаКолонок		= ПолнаяТабличнаяЧастьОС_ИменаИспользуемыхКолонокОСОсновная(ДокументОбъект["РазделУчета"]);
	ПоляОСОсновная		= "";
	Для Каждого Элем Из ИменаКолонок Цикл
		ИмяКолонки = Элем.Ключ;
		ПоляОСОсновная = ПоляОСОсновная + ?(ПоляОСОсновная = "", "", ",
			|	") + "ТЗ." + ИмяКолонки + "	КАК " + ИмяКолонки;
			
		ПоляОСПолная = ПоляОСПолная + ?(ПоляОСПолная = "", "", ",
			|	") + "ОС_Основная." + ИмяКолонки + "	КАК " + ИмяКолонки;
	КонецЦикла;
	
	// Колонки табл.части "ОС Амортизация"
	ИменаКолонок		= ПолнаяТабличнаяЧастьОС_ИменаИспользуемыхКолонокОСАмортизация(ДокументОбъект["РазделУчета"]);
	ПоляОСАмортизация	= "";
	Для Каждого Элем Из ИменаКолонок Цикл
		ИмяКолонки = Элем.Ключ;
		ПоляОСАмортизация = ПоляОСАмортизация + ?(ПоляОСАмортизация = "", "", ",
			|	") + "ТЗ." + ИмяКолонки + "	КАК " + ИмяКолонки;
			
		Если НЕ ИмяКолонки = "ОС" Тогда
			ПоляОСПолная = ПоляОСПолная + ?(ПоляОСПолная = "", "", ",
			|	") + "ОС_Амортизация." + ИмяКолонки + "	КАК " + ИмяКолонки;
		КонецЕсли;
	КонецЦикла;
	
	ЗапросПолнаяТаблЧасть = Новый Запрос();
	ЗапросПолнаяТаблЧасть.УстановитьПараметр("ТЧ_ОС_Основная",		ДокументОбъект["ОС_Основная"].Выгрузить());
	ЗапросПолнаяТаблЧасть.УстановитьПараметр("ТЧ_ОС_Амортизация",	ДокументОбъект["ОС_Амортизация"].Выгрузить());
	ЗапросПолнаяТаблЧасть.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходная табличная часть ""ОС Основная""
	|//
	|ВЫБРАТЬ
	|	" + ПоляОСОсновная + "
	|ПОМЕСТИТЬ
	|	ТЧ_ОС_Основная
	|ИЗ
	|	&ТЧ_ОС_Основная	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Исходная табличная часть ""ОС Амортизация""
	|//
	|ВЫБРАТЬ
	|	" + ПоляОСАмортизация + "
	|ПОМЕСТИТЬ
	|	ТЧ_ОС_Амортизация
	|ИЗ
	|	&ТЧ_ОС_Амортизация	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Финальная искомая таблица
	|//
	|ВЫБРАТЬ
	|	" + ПоляОСПолная + "
	|ИЗ
	|	ТЧ_ОС_Основная	КАК ОС_Основная
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ТЧ_ОС_Амортизация	КАК ОС_Амортизация
	|		ПО	ОС_Основная.ОС = ОС_Амортизация.ОС
	|;";
	
	ДокументОбъект["ОС_Основная"].Загрузить(ЗапросПолнаяТаблЧасть.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура ПолнаяТабличнаяЧастьОС_ЗаполнитьСтрокуДаннымиИзОСАмортизацияСервер(Форма, ИдТекСтроки) Экспорт
	
	ДокументОбъект = Форма.Объект;
	
	ТекДанные = ДокументОбъект["ОС_Основная"].НайтиПоИдентификатору(ИдТекСтроки);
	
	Поиск = Новый Структура("ОС", ТекДанные["ОС"]);
	
	МассивСтрок = ДокументОбъект["ОС_Амортизация"].НайтиСтроки(Поиск);
	Если МассивСтрок.Количество() = 0 Тогда
		// Такое ОС не найдено.
		// Очищаем все поля текущей строки, кроме поля связи
		ИменаКолонок = ПолнаяТабличнаяЧастьОС_ИменаИспользуемыхКолонокОСАмортизация(ДокументОбъект["РазделУчета"]);
		ЗаполнитьЗначенияСвойств(ТекДанные, ИменаКолонок, , "ОС");
		
	ИначеЕсли МассивСтрок.Количество() >= 1 Тогда
		// Такое ОС найдено.
		СтрокаТЧ = МассивСтрок[0];
		ЗаполнитьЗначенияСвойств(ТекДанные, СтрокаТЧ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолнаяТабличнаяЧастьОС_ПриИзмененииПоляТаблицыОСАмортизацияСервер(Форма, ИдТекСтроки, ИмяЭлемента) Экспорт
	
	ДокументОбъект = Форма.Объект;
	
	ТекДанные = ДокументОбъект["ОС_Основная"].НайтиПоИдентификатору(ИдТекСтроки);
	ОС = ТекДанные["ОС"];
	
	// Ожидается, что имя элемента имеет вид ОС_Основная<ИмяПоля>
	ИмяПоля			= Сред(ИмяЭлемента, 12);
	ЗначениеПоля	= ТекДанные[ИмяПоля];
	

	ЗаполняющаяСтруктура = Новый Структура();
	ЗаполняющаяСтруктура.Вставить(ИмяПоля, ЗначениеПоля);
	
	Поиск = Новый Структура("ОС", ОС); // поле связи табличных частей
	
	// Дополнительная обработка (подготовка)
	ПоляПринятияКУчету = Новый Структура();
	ПоляПринятияКУчету.Вставить("ДатаПринятияКУчету",				"ДатаВводаВЭксплуатацию");
	ПоляПринятияКУчету.Вставить("НазваниеДокументаПринятияКУчету",	"НазваниеДокументаВводаВЭксплуатацию");
	ПоляПринятияКУчету.Вставить("НомерДокументаПринятияКУчету",		"НомерДокументаВводаВЭксплуатацию");
	
	// Дублируем изменения (реквизита формы) по всем подходящим строкам
	МассивСтрок = ДокументОбъект["ОС_Основная"].НайтиСтроки(Поиск);
	Для Каждого СтрокаТЧ Из МассивСтрок Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ЗаполняющаяСтруктура);
		
		// Дополнительная обработка
		ИмяПоляВводВЭксплуатацию = "";
		Если СтрокаТЧ["ВводВЭксплуатациюОдновременноСПринятиемКУчету"] И ПоляПринятияКУчету.Свойство(ИмяПоля, ИмяПоляВводВЭксплуатацию) Тогда
			СтрокаТЧ[ИмяПоляВводВЭксплуатацию] = СтрокаТЧ[ИмяПоля];
		КонецЕсли;
	КонецЦикла;
	
	// Изменяем значение поля в табличной части
	МассивСтрок = ДокументОбъект["ОС_Амортизация"].НайтиСтроки(Поиск);
	Если МассивСтрок.Количество() = 0 Тогда
		НоваяСтрока = ДокументОбъект["ОС_Амортизация"].Добавить();
		НоваяСтрока["ОС"] = ОС;
		МассивСтрок.Добавить(НоваяСтрока);
	КонецЕсли;
	Для Каждого СтрокаТЧ Из МассивСтрок Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ЗаполняющаяСтруктура);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолнаяТабличнаяЧастьОС_ПолучитьТаблицуОСАмортизацияДляПроверкиЗаполнения(ДокументОбъект, ПроверяемыеРеквизиты, ИсключаемыеРеквизиты)
	
	// Выделим из всех проверяемых реквизитов те, которые находятся в ОС_Амортизация
	// чтобы не тратить память на неиспользуемые реквизиты
	ПризнакПринадлежностиТЧ = "ОС_АМОРТИЗАЦИЯ.";
	ДлинаПризнака = СтрДлина(ПризнакПринадлежностиТЧ);
	ИменаКолонок = "ОС";
	Для Каждого ПолноеИмяРеквизита Из ПроверяемыеРеквизиты Цикл
		ЭтоРеквизитОСАмортизация = (ВРег(Лев(ПолноеИмяРеквизита, ДлинаПризнака)) = ПризнакПринадлежностиТЧ);
		Если ЭтоРеквизитОСАмортизация Тогда
			Если ИсключаемыеРеквизиты.Найти(ПолноеИмяРеквизита) = Неопределено Тогда
				ИмяРеквизита = Сред(ПолноеИмяРеквизита, ДлинаПризнака + 1);
				ИменаКолонок = ИменаКолонок + "," + ИмяРеквизита;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Формируем ТЗ
	ЗапросНоваяТаблица = Новый Запрос();
	ЗапросНоваяТаблица.УстановитьПараметр("ТЗ_Основная",	ДокументОбъект["ОС_Основная"].Выгрузить(, "НомерСтроки,ОС"));
	ЗапросНоваяТаблица.УстановитьПараметр("ТЗ_Амортизация",	ДокументОбъект["ОС_Амортизация"].Выгрузить(, ИменаКолонок));
	ЗапросНоваяТаблица.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Часть колонок исходной табл.части ""ОС_Основная"".
	|ВЫБРАТЬ
	|	ТЗ.НомерСтроки	КАК НомерСтроки,
	|	ТЗ.ОС			КАК ОС
	|ПОМЕСТИТЬ
	|	ОС_Основная
	|ИЗ
	|	&ТЗ_Основная	КАК ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	ТЗ.ОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Часть колонок исходной табл.части ""ОС_Амортизация"".
	|ВЫБРАТЬ
	|	ТЗ.ОС	КАК ОС,
	|	ТЗ.*
	|ПОМЕСТИТЬ
	|	ОС_Амортизация
	|ИЗ
	|	&ТЗ_Амортизация	КАК ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	ТЗ.ОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Модифицированная, проверяемая ""ОС_Амортизация"".
	|ВЫБРАТЬ
	|	ОС_Основная.НомерСтроки	КАК НомерСтроки,
	|	ОС_Амортизация.*
	|ИЗ
	|	ОС_Основная
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ОС_Амортизация
	|		ПО	ОС_Амортизация.ОС = ОС_Основная.ОС
	|;";
	
	ТаблицаДанные = ЗапросНоваяТаблица.Выполнить().Выгрузить();
	
	// Удаляем лишние колонки (дубли)
	Если НЕ ТаблицаДанные.Колонки.Найти("ОС1") = Неопределено Тогда
		ТаблицаДанные.Колонки.Удалить("ОС1");
	КонецЕсли;
	
	Возврат ТаблицаДанные;
	
КонецФункции

