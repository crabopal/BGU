	Результаты = Запросы.ВыполнитьПакет();
	
	ТаблицыДляДвижений.Вставить("СведенияОСтудентах", Результаты[НомераТаблиц.СведенияОСтудентах].Выгрузить());
	ТаблицыДляДвижений.Вставить("НачисленияОбразованиеПоследовательность", Результаты[НомераТаблиц.ПоследовательностьНачисленияОбразование].Выгрузить());
	
	ИмяРегистраРасчеты = ?(ШапкаДокумента.НачислениеУчащимсяЗаПрочиеУслуги, "РасчетыСоСтудентамиДопУслуги", "РасчетыСоСтудентами");
	ТаблицыДляДвижений.Вставить(ИмяРегистраРасчеты, Результаты[НомераТаблиц.РасчетыСоСтудентами].Выгрузить());
	
	ТаблицыДляДвижений.Вставить("ПлательщикиПоДоговоруОбразование", Результаты[НомераТаблиц.ПлательщикиПоДоговоруОбразование].Выгрузить());
	ТаблицыДляДвижений.Вставить("СведенияОПрочихУслугахСтудентам", Результаты[НомераТаблиц.СведенияОПрочихУслугахСтудентам].Выгрузить());
	ТаблицыДляДвижений.Вставить("ПорядокОплатыОбразование", Результаты[НомераТаблиц.ПорядокОплатыОбразование].Выгрузить());
	ТаблицыДляДвижений.Вставить("ПараметрыСписанияДоходовБудущихПериодов", Результаты[НомераТаблиц.ПараметрыСписанияДоходовБудущихПериодов].Выгрузить());
	
	Если ИспользоватьКонтрольИсполненияДоговоров Тогда
		
		ИсполнениеДоговоровСПокупателями = Результаты[НомераТаблиц.ИсполнениеДоговоровСПокупателями].Выгрузить();
		Для Каждого Строка Из ИсполнениеДоговоровСПокупателями Цикл
			Строка.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(Строка.СчетРасчетов);
		КонецЦикла;
		ТаблицыДляДвижений.Вставить("ИсполнениеДоговоровСПокупателями", ИсполнениеДоговоровСПокупателями);
		
		ОплатаОтПокупателейДебиторов = Результаты[НомераТаблиц.ОплатаОтПокупателейДебиторов].Выгрузить();
		Для Каждого Строка Из ОплатаОтПокупателейДебиторов Цикл
			Строка.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(Строка.СчетРасчетов);
		КонецЦикла;
		ТаблицыДляДвижений.Вставить("ОплатаОтПокупателейДебиторов", ОплатаОтПокупателейДебиторов);
		
	КонецЕсли;
	
	// При формировании движений по регистру ПлановыеДатыОплатыОбразование сворачиваем порядок оплаты по колонке "Оплатить до",
	// чтобы избежать дублирования записей по значениям измерений.
	ПлановыеДатыОплатыОбразование = РегистрыСведений.ПлановыеДатыОплатыОбразование.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	ПлановыеДатыОплаты = ТаблицыДляДвижений.ПорядокОплатыОбразование.Скопировать();
	ПлановыеДатыОплаты.Свернуть("Период,Учащийся,Факультет,Валюта,Договор,ОплатитьДо", "СуммаВВалюте");
	ПлановыеДатыОплаты.Сортировать("Период,Учащийся,Факультет,Валюта,Договор,ОплатитьДо");
	Для Каждого ПлановаяДатаОплаты Из ПлановыеДатыОплаты Цикл
		
		ОтборПоДатеОплаты = Новый Структура("Период,Учащийся,Факультет,Валюта,Договор,ОплатитьДо");
		ЗаполнитьЗначенияСвойств(ОтборПоДатеОплаты, ПлановаяДатаОплаты);
		НайденныеСтроки = ТаблицыДляДвижений.ПорядокОплатыОбразование.НайтиСтроки(ОтборПоДатеОплаты);
		
		Если НайденныеСтроки.Количество() > 1 Тогда
			
			ИтогСуммаВВалюте = 0;
			МинНачалоПериода = '00010101';
			МаксКонецПериода = '00010101';
			Для Каждого СтрокаГрафика Из НайденныеСтроки Цикл
				ИтогСуммаВВалюте = ИтогСуммаВВалюте + СтрокаГрафика.СуммаВВалюте;
				МинНачалоПериода = ?(НЕ ЗначениеЗаполнено(МинНачалоПериода), СтрокаГрафика.НачалоПериода,
					Мин(МинНачалоПериода, СтрокаГрафика.НачалоПериода) );
				МаксКонецПериода = ?(НЕ ЗначениеЗаполнено(МаксКонецПериода), СтрокаГрафика.КонецПериода,
					Макс(МаксКонецПериода, СтрокаГрафика.КонецПериода) );
			КонецЦикла;
			
			НоваяЗапись = ПлановыеДатыОплатыОбразование.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, ПлановаяДатаОплаты, "Период,Учащийся,Факультет,Договор,Валюта");
			НоваяЗапись.ДатаОплаты    = СтрокаГрафика.ОплатитьДо;
			НоваяЗапись.Сумма         = ИтогСуммаВВалюте;
			НоваяЗапись.АвтоРасчет    = Ложь;
			НоваяЗапись.НачалоПериода = МинНачалоПериода;
			НоваяЗапись.КонецПериода  = МаксКонецПериода;
			
		ИначеЕсли НайденныеСтроки.Количество() = 1 Тогда
			
			СтрокаГрафика = НайденныеСтроки[0];
			
			НоваяЗапись = ПлановыеДатыОплатыОбразование.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, ПлановаяДатаОплаты, "Период,Учащийся,Факультет,Договор,Валюта");
			НоваяЗапись.ДатаОплаты    = СтрокаГрафика.ОплатитьДо;
			НоваяЗапись.Сумма         = СтрокаГрафика.СуммаВВалюте;
			НоваяЗапись.АвтоРасчет    = Ложь;
			НоваяЗапись.НачалоПериода = СтрокаГрафика.НачалоПериода;
			НоваяЗапись.КонецПериода  = СтрокаГрафика.КонецПериода;
			НоваяЗапись.Примечание    = СтрокаГрафика.Примечание;
			
		КонецЕсли;
		
	КонецЦикла;
	ПлановыеДатыОплатыОбразование.ЗаполнитьЗначения(Истина, "Активность");
	ТаблицыДляДвижений.Вставить("ПлановыеДатыОплатыОбразование", ПлановыеДатыОплатыОбразование);
	
КонецПроцедуры

Процедура РассчитатьПоГрафикамОплаты_Студенты(ДокументОбъект) Экспорт
	
	Для Каждого СтрокаСтуденты Из ДокументОбъект.Студенты Цикл
		
		СтрокаСтуденты.ОстатокРасчетов = 0;
		СтрокаСтуденты.ОстатокДБП = 0;
		
		// Расчитываем начальные остатки по данным таблицы "Порядок оплаты".
		ОтборПоИдентификаторуСтроки = Новый Структура("ИдентификаторСтроки", СтрокаСтуденты.ИдентификаторСтроки);
		СтрокиПорядокОплаты = ДокументОбъект.ПорядокОплатыОбразование.НайтиСтроки(ОтборПоИдентификаторуСтроки);
		Для Каждого СтрокаПорядокОплаты Из СтрокиПорядокОплаты Цикл
			
			СтрокаСтуденты.ОстатокРасчетов = СтрокаСтуденты.ОстатокРасчетов +
				?(СтрокаПорядокОплаты.Оплачено, 0, СтрокаПорядокОплаты.СуммаВВалюте);
			
			ПериодЗавершен = ( КонецДня(СтрокаПорядокОплаты.КонецПериода) <= КонецДня(ДокументОбъект.Дата) );
			СтрокаСтуденты.ОстатокДБП = СтрокаСтуденты.ОстатокДБП +
				?(ПериодЗавершен, 0, СтрокаПорядокОплаты.СуммаВВалюте);
			
		КонецЦикла;
		
		// Сумму задолженности и переплаты вычисляем как разницу между значениями ОстатокРасчетов и ОстатокДБП.
		СтрокаСтуденты.СуммаЗадолженность = ?(СтрокаСтуденты.ОстатокРасчетов > СтрокаСтуденты.ОстатокДБП, СтрокаСтуденты.ОстатокРасчетов - СтрокаСтуденты.ОстатокДБП, 0);
		СтрокаСтуденты.СуммаПереплата     = ?(СтрокаСтуденты.ОстатокРасчетов < СтрокаСтуденты.ОстатокДБП, СтрокаСтуденты.ОстатокДБП - СтрокаСтуденты.ОстатокРасчетов, 0);
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает массив полей приказов, которые устанавливаются не на закладке "Поля приказов",
// а в других полях формы документа ввода начальных остатков.
// 
Функция ИсключаемыеПоляПриказовОбразование() Экспорт
	
	ИсключаемыеПоляПриказов = Новый Массив;
	ИсключаемыеПоляПриказов.Добавить(ПланыВидовХарактеристик.ПоляПриказовОбразование.Курс);
	ИсключаемыеПоляПриказов.Добавить(ПланыВидовХарактеристик.ПоляПриказовОбразование.Группа);
	ИсключаемыеПоляПриказов.Добавить(ПланыВидовХарактеристик.ПоляПриказовОбразование.СостояниеСтудента);
	ИсключаемыеПоляПриказов.Добавить(ПланыВидовХарактеристик.ПоляПриказовОбразование.СтавкаОплаты);
	ИсключаемыеПоляПриказов.Добавить(ПланыВидовХарактеристик.ПоляПриказовОбразование.Льгота);
	ИсключаемыеПоляПриказов.Добавить(ПланыВидовХарактеристик.ПоляПриказовОбразование.ДополнительнаяУслуга);
	
	Возврат ИсключаемыеПоляПриказов;
	
КонецФункции

//---
// Раздел учета "Имущество казны"
//---

// Возвращает применяемые параметры учетной политики имущества казны для указанного док-та.
//
// Параметры:
//	Параметры	- Структура	- Содержит поля документа Организация, Дата, Счет;
//							Дата - уже обработанная дата документа.
// Возврат:
//	Структура с полями:
//	- ВестиУчетИмуществаКазны
//	- ЭтоСчетОС
//	- ЭтоСчетНМА
//	- ЭтоСчетМЗ
//	- УчетПоПодразделениям
//		(сведения из учетной политики)
//	- УП_Задана
//	- УП_ТипПланаСчетов
//	- УП_ВестиПоАналитике
//	- УП_НачислятьАмортизацию
//		(действующие значения, учитывающие счет документа)
//	- ВестиПоАналитике
//	- НачислятьАмортизацию
Функция ПолучитьПараметрыУчетаИмуществаКазныНаДату(Параметры)
	
	// Искомые параметры учетной политики:	
	Перем	ВестиПоАналитике,
			НачислятьАмортизацию,
			ТипПланаСчетов;
		
	// Анализ функц.опции:
	ВестиУчетИмуществаКазны = ПолучитьФункциональнуюОпцию("ВестиУчетИмуществаКазны");
	
	// Анализ счета документа:
	Счета = ПлатежноРасчетныеДокументыПовтИсп.СформироватьСписокСсылокПоКодуОбъекта("ПланСчетов.ЕПСБУ",
		// --ОС---	   НМА     МЗ
		// 0	 1		2		3
		"108.51,108.52,108.54,108.56");
	ЭтоСчетОС	=  (Параметры["Счет"] = Счета[0].Значение
				ИЛИ Параметры["Счет"] = Счета[1].Значение);
	ЭтоСчетНМА	=  (Параметры["Счет"] = Счета[2].Значение);
	ЭтоСчетМЗ	=  (Параметры["Счет"] = Счета[3].Значение);
	Если ЗначениеЗаполнено(Параметры["Счет"]) Тогда
		УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры["Счет"], "УчетПоПодразделениям");
	Иначе
		УчетПоПодразделениям = Ложь;
	КонецЕсли;

	// Анали учетной политики:
	УП_Задана = Ложь;
	Организация = Параметры["Организация"];
	Если ЗначениеЗаполнено(Организация) Тогда
		УчетнаяПолитика = БухгалтерскийУчетПовтИсп.УчетнаяПолитикаОрганизации(
			Организация,
			Параметры["Дата"]);
			
		ВестиПоАналитике		= УчетнаяПолитика["ВедениеАналитическогоУчетаИмуществаКазны"];
		НачислятьАмортизацию	= УчетнаяПолитика["НачислятьАмортизациюИмуществаКазны"];
		СтруктураРПС			= УчетнаяПолитика["СтруктураРПС"];
		Если ЗначениеЗаполнено(СтруктураРПС) Тогда
			ТипПланаСчетов = ОбщегоНазначенияБГУ.ПолучитьЗначениеРеквизита(СтруктураРПС, "ТипПланаСчетов");
		КонецЕсли;
		
		УП_Задана = НЕ (
			ВестиПоАналитике = Неопределено
			И НачислятьАмортизацию = Неопределено
			И СтруктураРПС = Неопределено);
	КонецЕсли;
	Если НЕ УП_Задана Тогда
		ВестиПоАналитике = Ложь;
		НачислятьАмортизацию = Ложь;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("ВестиУчетИмуществаКазны",	ВестиУчетИмуществаКазны);
	Результат.Вставить("ЭтоСчетОС",					ЭтоСчетОС);
	Результат.Вставить("ЭтоСчетНМА",				ЭтоСчетНМА);
	Результат.Вставить("ЭтоСчетМЗ",					ЭтоСчетМЗ);
	Результат.Вставить("УчетПоПодразделениям",		УчетПоПодразделениям);
	Результат.Вставить("УП_Задана",					УП_Задана);
	Результат.Вставить("УП_ТипПланаСчетов",			ТипПланаСчетов);
	Результат.Вставить("УП_ВестиПоАналитике",		ВестиПоАналитике);
	Результат.Вставить("УП_НачислятьАмортизацию",	НачислятьАмортизацию);
	Результат.Вставить("ВестиПоАналитике",			ВестиУчетИмуществаКазны И ВестиПоАналитике И НЕ ЭтоСчетМЗ);
	Результат.Вставить("НачислятьАмортизацию",		ВестиУчетИмуществаКазны И НачислятьАмортизацию И (ЭтоСчетОС ИЛИ ЭтоСчетНМА));
	
	Возврат Результат;
	
КонецФункции

// Заполняет тексты предопределенного отбора для полей "Счет" и "Счет амортизации" (без вариантов).
Процедура ИнициализироватьПредустановленныеОтборы_ИмуществоКазны(ТекстОтбора_Счет, ТекстОтбора_СчетАмортизации) Экспорт
	
	Счет10450 = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("104.50");
	Счет10850 = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("108.50");
	
	ВремСоответствие = Новый Соответствие();
	ВремСоответствие_СчетАмортизации = Новый Соответствие();
	
	СписокСчетов = Новый Массив();
	СписокСчетов.Добавить(Счет10850);
	
	СписокСчетов_СчетАмортизации = Новый Массив();
	СписокСчетов_СчетАмортизации.Добавить(Счет10450);
	
	//
	// 1) Отбор для поля "Счет"
	//
	НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных();
	Отбор = НастройкиКомпоновки.Отбор;
	// Группа "И":
	ГруппаИ = Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	ГруппаИ.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
	// В ИЕРАРХИИ (СписокСчетов):
	НовыйЭлемент = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии;
	НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	НовыйЭлемент.ПравоеЗначение = Новый ФиксированныйМассив(СписокСчетов);
	// ЭлементГруппа = ЛОЖЬ:
	НовыйЭлемент = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭлементГруппа");
	НовыйЭлемент.ПравоеЗначение = Ложь;
	
	// Получаем представление отбора:
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, НастройкиКомпоновки);
	ТекстОтбора_Счет = ЗаписьXML.Закрыть();
	
	//
	// 2) Отбор для поля "Счет амортизации"
	//
	НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных();
	Отбор = НастройкиКомпоновки.Отбор;
	// Группа "И":
	ГруппаИ = Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	ГруппаИ.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
	// В ИЕРАРХИИ (СписокСчетов):
	НовыйЭлемент = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии;
	НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	НовыйЭлемент.ПравоеЗначение = Новый ФиксированныйМассив(СписокСчетов_СчетАмортизации);
	// ЭлементГруппа = ЛОЖЬ:
	НовыйЭлемент = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭлементГруппа");
	НовыйЭлемент.ПравоеЗначение = Ложь;
	
	// Получаем представление отбора:
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, НастройкиКомпоновки);
	ТекстОтбора_СчетАмортизации = ЗаписьXML.Закрыть();
	
КонецПроцедуры

Процедура ЗаполнитьСписокПроверяемыхОбязательныхРеквизитов_ИмуществоКазны(
			ШапкаДокумента,
			ПроверяемыеРеквизиты,
			ПроверяемыеСубконто,
			ПроверяемыеПризнакиУчета,
			ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
			ПеренаправлениеВыводаСообщений_Реквизиты,
			ИсключаемыеРеквизиты,
			ЭтоПроверкаВФормеРедактированияСтроки = Ложь,
			ПрименяемыйРежимВводаОстатков = Неопределено) Экспорт
	
	// Инициализация:
	Если ПроверяемыеРеквизиты = Неопределено Тогда
		ПроверяемыеРеквизиты = Новый Массив();
	КонецЕсли;
	ИсключаемыеРеквизиты			= Новый Массив();
	ПрименяемыйРежимВводаОстатков	= Новый Структура();
	
	// Подготовка:
	СвойстваСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШапкаДокумента["Счет"],
		"УчетПоКПС, УчетПоКЭК, УчетПоПодразделениям");
	
	// Реквизиты шапки:
	ПроверяемыеРеквизиты.Добавить("Организация");
	ПроверяемыеРеквизиты.Добавить("КФО");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ПроверяемыеРеквизиты.Добавить("ИФО");
	КонецЕсли;
	ПроверяемыеРеквизиты.Добавить("Счет");
	Если СвойстваСчета["УчетПоКПС"] = Истина Тогда
		ПроверяемыеРеквизиты.Добавить("КПС");
	КонецЕсли;
	Если СвойстваСчета["УчетПоКЭК"] = Истина Тогда
		ПроверяемыеРеквизиты.Добавить("КЭК");
	КонецЕсли;
	
	// Реквизиты табличных частей - зависят от режима документа - ОС или МЗ.
	// Исключаем из проверки реквизиты, не используемые в текущем режиме ввода остатков:
	РезультатПроверки = Неопределено;
	ИсключаемыеПоля = РежимВводаОстатков_ИменаПолейВсехРежимов(
		ШапкаДокумента,
		Истина,	// ТолькоНеиспользуемые
		РезультатПроверки);
	ПрименяемыйРежимВводаОстатков = РезультатПроверки["ПрименяемыйРежимВводаОстатков"];
	
	Если РезультатПроверки["Кэш"]["ЭтоСчетМЗ"] Тогда
		// МЗ
		
		ПроверяемыеРеквизиты.Добавить("Материалы.Номенклатура");
		ПроверяемыеРеквизиты.Добавить("Материалы.Количество");
		ПроверяемыеРеквизиты.Добавить("Материалы.Сумма");
		Если ПодразделениеОбязательноКЗаполнению(ШапкаДокумента, СвойстваСчета) Тогда
			ПроверяемыеРеквизиты.Добавить("Материалы.Подразделение");
		КонецЕсли;
	Иначе
		// ОС, НМА, НПА
		
		Если ПодразделениеОбязательноКЗаполнению(ШапкаДокумента, СвойстваСчета) Тогда
			ПроверяемыеРеквизиты.Добавить("ОС_Основная.Подразделение");
		КонецЕсли;
		
		ПроверяемыеРеквизиты.Добавить("ОС_Основная.ОС");
		ПроверяемыеРеквизиты.Добавить("ОС_Основная.Количество");
		ПроверяемыеРеквизиты.Добавить("ОС_Основная.Сумма");
		ПроверяемыеРеквизиты.Добавить("ОС_Основная.СостояниеОС");
		ПроверяемыеРеквизиты.Добавить("ОС_Основная.ПервоначальнаяСтоимость");
		
		ПроверяемыеРеквизиты.Добавить("ОС_Амортизация.ПорядокПогашенияСтоимости");
		ПроверяемыеРеквизиты.Добавить("ОС_Амортизация.ДатаПринятияКУчету");
		
		ПеренаправлениеВыводаСообщений_ТабличныеЧасти = Новый Структура();
		ПеренаправлениеВыводаСообщений_ТабличныеЧасти.Вставить("ОС_Амортизация",	"ОС_Основная");
	КонецЕсли;
	
	Если ЭтоПроверкаВФормеРедактированияСтроки = Истина Тогда
		ИсключитьИзПроверяемыхРеквизитов(ПроверяемыеРеквизиты, ИсключаемыеПоля);
	Иначе
		// Явно заполняем список исключаемых реквизитов
		Для Каждого СтрокаТЗ Из ИсключаемыеПоля Цикл
			ИсключаемыеРеквизиты.Добавить(СтрокаТЗ["ПолноеИмя"]);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПараметрыПроверкиПоСтроке_ИмуществоКазны(ШапкаДокумента) Экспорт
	
	ЭтоСчетБиблФонда					= УправлениеОсновнымиСредствамиКлиентСервер.ЭтоБиблиотечныйФонд(ШапкаДокумента["Счет"]);
	ИспользоватьУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	// Параметры учета ИК
	РезультатПроверкиРВО = Неопределено;
	РежимВводаОстатков_ПроверитьЗаполнение(ШапкаДокумента, РезультатПроверкиРВО);
	РежимВводаОстатков_Кэш = РезультатПроверкиРВО["Кэш"];
	ПараметрыУчетаИК = Новый Структура();
	ПараметрыУчетаИК.Вставить("ВестиПоАналитике",		РежимВводаОстатков_Кэш["ВестиПоАналитике"]);
	ПараметрыУчетаИК.Вставить("НачислятьАмортизацию",	РежимВводаОстатков_Кэш["НачислятьАмортизацию"]);
	
	Результат = Новый Структура();
	Результат.Вставить("ЭтоСчетБиблФонда",					ЭтоСчетБиблФонда);
	Результат.Вставить("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	Результат.Вставить("ПараметрыУчетаИК",					ПараметрыУчетаИК);
	
	Возврат Результат;
	
КонецФункции

Функция ПроверкаПоСтроке_ИмуществоКазны(СтрокаОС, ПараметрыПроверкиПоСтроке) Экспорт
	
	// Возвращаемое значение:
	Результат = Новый Структура();
	
	ОС									= СтрокаОС.ОС;
	ГрупповойУчет						= СтрокаОС.ГрупповойУчет;
	Количество							= СтрокаОС.Количество;
	Сумма								= СтрокаОС.Сумма;
	НачисленнаяАмортизация				= СтрокаОС.СуммаАмортизации;
	ИнвНомер							= СокрЛП(СтрокаОС.ИнвНомерОС);
	ДатаПринятияКУчету					= СтрокаОС.ДатаПринятияКУчету;
	СостояниеОС							= СтрокаОС.СостояниеОС;
	
	ПорядокПогашенияСтоимости			= СтрокаОС.ПорядокПогашенияСтоимости;
	СпособНачисленияАмортизации 		= СтрокаОС.СпособНачисленияАмортизации;
	СрокПолезногоИспользования			= СтрокаОС.СрокПолезногоИспользования;
	СчетУчетаЗатрат						= СтрокаОС.СчетУчетаЗатрат;
	КОСГУСчетаЗатрат					= СтрокаОС.КЭКЗатрат;
	
	РасчетАмортизацииВручную			= СтрокаОС.РасчетАмортизацииВручную;
	РасчетАмортизацииСрокИспользования	= СтрокаОС.РасчетАмортизацииСрокИспользования;
	
	ЭтоСчетБиблФонда					= ПараметрыПроверкиПоСтроке["ЭтоСчетБиблФонда"];
	
	ПервыйПределОС						= ПараметрыПроверкиПоСтроке["ПрименяемыеПределыСтоимостиОС"]["ПервыйПределОС"];
	ВторойПределОС						= ПараметрыПроверкиПоСтроке["ПрименяемыеПределыСтоимостиОС"]["ВторойПределОС"];
	ИспользуемаяДатаПределовОС			= ПараметрыПроверкиПоСтроке["ПрименяемыеПределыСтоимостиОС"]["ИспользуемаяДата"];
	
	ПараметрыУчета_ВестиПоАналитике		= ПараметрыПроверкиПоСтроке["ПараметрыУчетаИК"]["ВестиПоАналитике"];
	ПараметрыУчета_НачислятьАмортизацию	= ПараметрыПроверкиПоСтроке["ПараметрыУчетаИК"]["НачислятьАмортизацию"];
	
	Если НЕ ЗначениеЗаполнено(ВторойПределОС) Тогда
		Текст = НСтр("ru='Не заданы пределы стоимости ОС на дату %1 (см. регистр сведений ""Параметры учета ОС"")'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
			Формат(ИспользуемаяДатаПределовОС, "ДЛФ=Д"));
		ИмяПоляДляВыводаСообщения = "ДатаПринятияКУчету";
		Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
		// Выходим:
		Возврат Результат;
	КонецЕсли;
	
	//Если ПараметрыУчета_ВестиПоАналитике Тогда // Добавлено это дополнительное внешнее условие.
	//	Если СостояниеОС = Перечисления.СостоянияОС.ПринятоКУчету Тогда
	//		Если ДатаПринятияКУчету = Дата(1,1,1) Тогда
	//			ТекстСообщения = ТекстСообщения + "Не задана дата принятия к учету ОС """+ОС+""" в строке "+НомерСтроки+Символы.ПС;
	//			Отказ = Истина;
	//			Возврат;
	//		КонецЕсли;
	//	КонецЕсли;
	//КонецЕсли;
	
	Если ПараметрыУчета_ВестиПоАналитике Тогда
		Цена = ?(Количество=0,0,Сумма/Количество);
	Иначе
		Цена = Сумма;
	КонецЕсли;
	Если Цена < 0.01 Тогда
		ТекстСообщения = НСтр("ru='Цена ОС менее одной копейки'");
		ИмяПоляДляВыводаСообщения = "Сумма";
		Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
	КонецЕсли;
	
	Если ПараметрыУчета_ВестиПоАналитике Тогда
		Если НЕ ГрупповойУчет Тогда
			Если Количество>1 Тогда
				ТекстСообщения = НСтр("ru='Количество ОС больше 1 для ОС, по которому не ведется групповой учет'");
				ИмяПоляДляВыводаСообщения = "Количество";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ИнвНомер) И Цена > ПервыйПределОС Тогда
				ТекстСообщения = НСтр("ru='Не задан инвентарный номер для ОС, по которому ведется индивидуальный учет'");
				ИмяПоляДляВыводаСообщения = "ИнвНомерОС";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
			КонецЕсли;
			
		Иначе
			Если ЗначениеЗаполнено(ИнвНомер) Тогда 
				Если Количество>1 Тогда
					ТекстСообщения = НСтр("ru='Количество ОС больше 1 для ОС, по которому введен инвентарный номер. Для каждого инвентарного номера нужно ввести свою строку с количеством, равным 1'");
					ИмяПоляДляВыводаСообщения = "Количество";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				КонецЕсли;
				
			Иначе
				Если ЭтоСчетБиблФонда Тогда
					Если  Цена > ВторойПределОС Тогда
						Текст = НСтр("ru='Для библиотечного фонда стоимостью более %1 руб. должен быть задан инвентарный номер'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ВторойПределОС);
						ИмяПоляДляВыводаСообщения = "Сумма";
						Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					КонецЕсли;
					
				Иначе
					Если  Цена > ПервыйПределОС Тогда
						Текст = НСтр("ru='Для ОС стоимостью более %1 руб. должен быть задан инвентарный номер'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ПервыйПределОС);
						ИмяПоляДляВыводаСообщения = "Сумма";
						Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		Если ГрупповойУчет И (Цена > ВторойПределОС) Тогда
			Текст = НСтр("ru='Цена ОС более %1 руб. Групповой учет не возможен'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ВторойПределОС);
			ИмяПоляДляВыводаСообщения = "Сумма";
			Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПараметрыУчета_НачислятьАмортизацию Тогда
		
		Если ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
			ИЛИ	ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию Тогда
			
			Если ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации Тогда
				Если НачисленнаяАмортизация > Сумма Тогда 
					ТекстСообщения = НСтр("ru='Сумма амортизации больше стоимости'");
					ИмяПоляДляВыводаСообщения = "СуммаАмортизации";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					
				ИначеЕсли (НачисленнаяАмортизация < Сумма) И (НачисленнаяАмортизация > 0) Тогда 
					Если ГрупповойУчет Тогда
						ТекстСообщения = НСтр("ru='Сумма амортизации больше 0 и не равна стоимости ОС. Групповой учет таких ОС запрещен'");
						ИмяПоляДляВыводаСообщения = "СуммаАмортизации";
						Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СчетУчетаЗатрат) Тогда
				Если СчетУчетаЗатрат.УчетПоКЭК И НЕ ЗначениеЗаполнено(КОСГУСчетаЗатрат) Тогда
					ТекстСообщения = НСтр("ru='Не выбран КЭК счета для отнесения затрат'");
					ИмяПоляДляВыводаСообщения = "КЭКЗатрат";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				КонецЕсли;
			Иначе
				ТекстСообщения = НСтр("ru='Не выбран счет для отнесения затрат'");
				ИмяПоляДляВыводаСообщения = "СчетУчетаЗатрат";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
			КонецЕсли;
			
			Если ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации Тогда
				// ПорядокПогашенияСтоимости = "Начисление амортизации"
				
				Если НЕ ЗначениеЗаполнено(СпособНачисленияАмортизации) Тогда
					ТекстСообщения = НСтр("ru='Не определен способ начисления амортизации'");
					ИмяПоляДляВыводаСообщения = "СпособНачисленияАмортизации";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(ИнвНомер)
					И НЕ ЭтоСчетБиблФонда Тогда
					
					ТекстСообщения = НСтр("ru='Не задан инвентарный номер для ОС, по которому будет начисляться амортизация'");
					ИмяПоляДляВыводаСообщения = "ИнвНомерОС";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				КонецЕсли;
				
				Если Цена <= ПервыйПределОС
					И СпособНачисленияАмортизации <> Перечисления.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию Тогда
					
					Текст = НСтр("ru='Цена ОС менее %1 руб., поэтому возможно только начисление 100% амортизации при вводе в эксплуатацию'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ПервыйПределОС);
					ИмяПоляДляВыводаСообщения = "СпособНачисленияАмортизации";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				КонецЕсли;
				
				Если СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.Линейный Тогда
					Если Цена <= ВторойПределОС Тогда
						Текст = НСтр("ru='Цена ОС менее %1 руб., линейный способ начисления амортизации не применяется'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ВторойПределОС);
						ИмяПоляДляВыводаСообщения = "СпособНачисленияАмортизации";
						Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					КонецЕсли;
					
					Если СрокПолезногоИспользования = 0 Тогда
						ТекстСообщения = НСтр("ru='Не задан срок полезного использования ОС'");
						ИмяПоляДляВыводаСообщения = "СрокПолезногоИспользования";
						Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					КонецЕсли;
					
					Если РасчетАмортизацииВручную И РасчетАмортизацииСрокИспользования > СрокПолезногоИспользования Тогда
						ТекстСообщения = НСтр("ru='Оставшийся срок использования не может быть больше срока полезного использования'");
						ИмяПоляДляВыводаСообщения = "РасчетАмортизацииСрокИспользования";
						Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					КонецЕсли;
					
				Иначе
					Если Цена > ВторойПределОС Тогда
						Текст = НСтр("ru='Цена ОС более %1 руб., начисление амортизации должно производиться линейно'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ВторойПределОС);
						ИмяПоляДляВыводаСообщения = "СпособНачисленияАмортизации";
						Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
					КонецЕсли;
					
				КонецЕсли;
			Иначе
				// ПорядокПогашенияСтоимости = "Списание при вводе в эксплуатацию"
				
				Если ЗначениеЗаполнено(СпособНачисленияАмортизации) Тогда
					ТекстСообщения = НСтр("ru='Способ начисления амортизации задается только в случае выбора способа погашения стоимости ""Начисление амортизации""'");
					ИмяПоляДляВыводаСообщения = "СпособНачисленияАмортизации";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				КонецЕсли;
				
				Если Цена > ПервыйПределОС Тогда
					Текст = НСтр("ru='Не списываются с учета ОС дороже %1 руб.'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ПервыйПределОС);
					ИмяПоляДляВыводаСообщения = "ПорядокПогашенияСтоимости";
					Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				КонецЕсли;
				
			КонецЕсли;
		Иначе 
			// ПорядокПогашенияСтоимости = "Стоимость не погашается"
			
			Если ЗначениеЗаполнено(СпособНачисленияАмортизации) Тогда
				ТекстСообщения = НСтр("ru='Способ начисления амортизации задается только в случае выбора способа погашения стоимости ""Начисление амортизации""'");
				ИмяПоляДляВыводаСообщения = "СпособНачисленияАмортизации";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
			КонецЕсли;
			
			Если ЭтоСчетБиблФонда Тогда
				ТекстСообщения = НСтр("ru='Порядок погашения стоимости (для библиотечного фонда) должен быть ""Начисление амортизации""'");
				ИмяПоляДляВыводаСообщения = "ПорядокПогашенияСтоимости";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				
			ИначеЕсли (Цена > ПервыйПределОС) Тогда
				ТекстСообщения = НСтр("ru='Порядок погашения стоимости должен быть ""Начисление амортизации""'");
				ИмяПоляДляВыводаСообщения = "ПорядокПогашенияСтоимости";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента_ИмуществоКазны(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	//---
	// Учтем особенности операции "Имущество казны" в отличие от операции "ОС".
	//
	РезультатПроверки = Неопределено;
	РежимВводаОстатков_ПроверитьЗаполнение(ДокументСсылка, РезультатПроверки);
	ПараметрыУчета = РезультатПроверки["Кэш"];
	//ВестиПоАналитике		= ПараметрыУчета["ВестиПоАналитике"];
	НачислятьАмортизацию	= ПараметрыУчета["НачислятьАмортизацию"];
	ЭтоСчетМЗ				= ПараметрыУчета["ЭтоСчетМЗ"];
	
	ДополнительныеСвойства.Вставить("УчетИмуществаКазны", ПараметрыУчета);
	
	// Если учет материалов, то никаких движений не делаем:
	Если ЭтоСчетМЗ Тогда
		Возврат;
	КонецЕсли;
	//---
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокСсылка",						ДокументСсылка);
	Запрос.УстановитьПараметр("Организация",					ДокументСсылка["Организация"]);
	Запрос.УстановитьПараметр("ВеличинаНесущественнойРазницы",	1);
	Запрос.УстановитьПараметр("ПустаяДата",						'00010101');
	Запрос.УстановитьПараметр("ВалютаРУ",						Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("УчетПоПодразделениям",			УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетИКПоПодразделениям());

	НомераТаблиц = Новый Структура;
	
	// Нужно использовать временные таблицы с табличными частями
	ДобавитьПриНеобходимостиВременнуюТаблицу("ОС_Основная",				Запрос, НомераТаблиц);
	ДобавитьПриНеобходимостиВременнуюТаблицу("ОС_Амортизация",			Запрос, НомераТаблиц);
	ДобавитьПриНеобходимостиВременнуюТаблицу("ПолнаяТабличнаяЧастьОС",	Запрос, НомераТаблиц);
	
	НомераТаблиц.Вставить("СобытияОС",									НомераТаблиц.Количество());
	НомераТаблиц.Вставить("НачислениеАмортизацииОСБухгалтерскийУчет",	НомераТаблиц.Количество());
	НомераТаблиц.Вставить("АмортизацияОС",								НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВременнаяТаблицаЛинейный",					НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВременнаяТаблицаЛинейный2",					НомераТаблиц.Количество());
	НомераТаблиц.Вставить("РасчетАмортизацииОС",						НомераТаблиц.Количество());
	НомераТаблиц.Вставить("АмортизацияОбъектовОС",						НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПараметрыАмортизацииОСБухгалтерскийУчет",	НомераТаблиц.Количество());
	НомераТаблиц.Вставить("НомераИнвентарныхКарточек",					НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПервоначальныеСведенияОСБухгалтерскийУчет",	НомераТаблиц.Количество());
	НомераТаблиц.Вставить("СтоимостьОбъектовОС",						НомераТаблиц.Количество());
	
	ДобавитьТекстЗапроса(Запрос.Текст, "
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Движения по рег.свед. СобытияОС
	|//
	|// События 'Принятие к учету':
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация										КАК Организация,
	|	Ссылка.Дата												КАК Период,
	|	ОС														КАК ОсновноеСредство,
	|	ИнвНомерОС												КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)		КАК Событие,
	|	ВЫБОР
	|		КОГДА ДатаПринятияКУчету = &ПустаяДата ТОГДА
	|			Ссылка.Дата
	|		ИНАЧЕ
	|			ДатаПринятияКУчету
	|	КОНЕЦ													КАК ДатаСобытия,
	|	НазваниеДокументаПринятияКУчету							КАК НазваниеДокумента,
	|	НомерДокументаПринятияКУчету							КАК НомерДокумента,
	|	ДатаПринятияКУчету										КАК	ДатаДокумента
	|ИЗ
	|	ПолнаяТабличнаяЧастьОС
	|ГДЕ
	|	НЕ СостояниеОС = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// События 'Ввод в эксплуатацию':
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация										КАК Организация,
	|	Ссылка.Дата												КАК Период,
	|	ОС														КАК ОсновноеСредство,
	|	ИнвНомерОС												КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)	КАК Событие,
	|	ВЫБОР
	|		КОГДА ДатаВводаВЭксплуатацию = &ПустаяДата ТОГДА
	|			Ссылка.Дата
	|		ИНАЧЕ
	|			ДатаВводаВЭксплуатацию
	|	КОНЕЦ													КАК ДатаСобытия,
	|	НазваниеДокументаВводаВЭксплуатацию						КАК НазваниеДокумента,
	|	НомерДокументаВводаВЭксплуатацию						КАК НомерДокумента,
	|	ДатаВводаВЭксплуатацию									КАК	ДатаДокумента
	|ИЗ
	|	ПолнаяТабличнаяЧастьОС
	|ГДЕ
	|	СостояниеОС = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
	|УПОРЯДОЧИТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Движения по рег.свед. НачислениеАмортизацииОСБухгалтерскийУчет
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация			КАК Организация,
	|	Ссылка.Дата					КАК Период,
	|	ОС							КАК ОсновноеСредство,
	|	НачислятьАмортизацию		КАК НачислятьАмортизацию
	|ИЗ
	|	ОС_Амортизация	КАК ОС_Амортизация
	|ГДЕ
	|	СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный) 
	|	И	ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации) 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Движения по рег.свед. АмортизацияОС
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация			КАК Организация,
	|	Ссылка.Дата					КАК Период,
	|	ОС							КАК ОсновноеСредство,
	|	СчетУчетаЗатрат				КАК СчетУчетаЗатрат,
	|	КЭКЗатрат					КАК КЭК,
	|	СубконтоЗатрат1				КАК Субконто1,
	|	СубконтоЗатрат2				КАК Субконто2,
	|	СубконтоЗатрат3				КАК Субконто3,
	|	КПСЗатрат					КАК КПС,
	|	ПодразделениеЗатрат			КАК Подразделение
	|ИЗ
	|	ОС_Амортизация	КАК ОС_Амортизация
	|ГДЕ
	|	ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|	ИЛИ	ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [6]. (Подготовка) Строки с линейным начислением амортизации, для которых
	|//		будет рассчитываться оставшийся срок полезного использования и стоимость.
	|//		(Движения по регистру ""РасчетАмортизацииОС"")
	|ВЫБРАТЬ
	|	ПериодПринятиеКУчету				КАК Период,
	|	ОС									КАК ОсновноеСредство,
	|	СрокПолезногоИспользования			КАК СрокПолезногоИспользования,
	|	РАЗНОСТЬДАТ(
	|		ВЫБОР
	|			КОГДА СостояниеОС = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету) ТОГДА
	|				КОНЕЦПЕРИОДА(ДатаПринятияКУчету, МЕСЯЦ)
	|			ИНАЧЕ
	|				// ВведеноВЭксплуатацию
	|				ВЫБОР
	|					КОГДА ДатаПринятияКУчету <= ДатаВводаВЭксплуатацию ТОГДА
	|						КОНЕЦПЕРИОДА(ДатаПринятияКУчету, МЕСЯЦ)
	|					ИНАЧЕ
	|						КОНЕЦПЕРИОДА(ДатаВводаВЭксплуатацию, МЕСЯЦ)
	|				КОНЕЦ
	|		КОНЕЦ,
	|		КОНЕЦПЕРИОДА(Ссылка.Дата, МЕСЯЦ),
	|		МЕСЯЦ
	|	)									КАК СрокФактическогоИспользования,
	|	Сумма - СуммаАмортизации			КАК ОстаточнаяСтоимость,
	|	ВЫБОР
	|		КОГДА СрокПолезногоИспользования = 0 ТОГДА
	|			0
	|		ИНАЧЕ
	|			Сумма / СрокПолезногоИспользования
	|	КОНЕЦ								КАК ПрежняяМесячнаяАмортизация,
	|	
	|	РасчетАмортизацииВручную			КАК РасчетАмортизацииВручную,
	|	РасчетАмортизацииСрокИспользования	КАК РасчетАмортизацииСрокИспользования,
	|	РасчетАмортизацииСтоимость			КАК РасчетАмортизацииСтоимость,
	|	РасчетАмортизацииПериод				КАК РасчетАмортизацииПериод
	|ПОМЕСТИТЬ
	|	Линейный
	|ИЗ
	|	ПолнаяТабличнаяЧастьОС
	|ГДЕ		
	|	НЕ	СостояниеОС					= ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
	|	И	ПорядокПогашенияСтоимости	= ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|	И	СпособНачисленияАмортизации	= ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [7]. (Подготовка) Строки с линейным начислением амортизации, а также
	|//		разность месячных амортизаций.
	|//		(Движения по регистру ""РасчетАмортизацииОС"")
	|ВЫБРАТЬ
	|	Линейный.Период						КАК Период,
	|	Линейный.ОсновноеСредство			КАК ОсновноеСредство,
	|	Линейный.СрокПолезногоИспользования	КАК СрокПолезногоИспользования,
	|	Линейный.ОстаточнаяСтоимость		КАК ОстаточнаяСтоимость,
	|	
	|	ВЫБОР
	|		КОГДА Линейный.СрокПолезногоИспользования <= Линейный.СрокФактическогоИспользования ТОГДА
	|			1
	|		ИНАЧЕ
	|			Линейный.СрокПолезногоИспользования - Линейный.СрокФактическогоИспользования
	|	КОНЕЦ								КАК СрокИспользованияДляВычисленияАмортизации,
	|	
	|	Линейный.ПрежняяМесячнаяАмортизация -
	|		// Новая месячная амортизация:
	|		(Линейный.ОстаточнаяСтоимость /
	|			// Срок использования для вычисления амортизации:
	|			ВЫБОР
	|				КОГДА Линейный.СрокПолезногоИспользования <= Линейный.СрокФактическогоИспользования ТОГДА
	|					1
	|				ИНАЧЕ
	|					Линейный.СрокПолезногоИспользования - Линейный.СрокФактическогоИспользования
	|			КОНЕЦ)						КАК РазностьАмортизаций,
	|	
	|	РасчетАмортизацииВручную			КАК РасчетАмортизацииВручную,
	|	РасчетАмортизацииСрокИспользования	КАК РасчетАмортизацииСрокИспользования,
	|	РасчетАмортизацииСтоимость			КАК РасчетАмортизацииСтоимость,
	|	РасчетАмортизацииПериод				КАК РасчетАмортизацииПериод
	|ПОМЕСТИТЬ
	|	Линейный2
	|ИЗ
	|	Линейный	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [8]. Движения по рег.свед. РасчетАмортизацииОС
	|//
	|// Строки с линейным начислением амортизации:
	|ВЫБРАТЬ
	|	&Организация							КАК Организация,
	|	ВЫБОР
	|		КОГДА Линейный2.РасчетАмортизацииВручную ТОГДА
	|			Линейный2.РасчетАмортизацииПериод
	|		ИНАЧЕ
	|			Линейный2.Период
	|	КОНЕЦ									КАК Период,
	|	Линейный2.ОсновноеСредство				КАК ОсновноеСредство,
	|	Линейный2.СрокПолезногоИспользования	КАК СрокПолезногоИспользования,
	|	
	|	ВЫБОР
	|		КОГДА Линейный2.РасчетАмортизацииВручную ТОГДА
	|			Линейный2.РасчетАмортизацииСрокИспользования
	|		ИНАЧЕ
	|			ВЫБОР
	|				КОГДА Линейный2.ОстаточнаяСтоимость > 0
	|					И	(	Линейный2.РазностьАмортизаций > &ВеличинаНесущественнойРазницы
	|						ИЛИ	Линейный2.РазностьАмортизаций < -&ВеличинаНесущественнойРазницы) ТОГДА
	|					Линейный2.СрокИспользованияДляВычисленияАмортизации
	|				ИНАЧЕ
	|					0
	|			КОНЕЦ
	|	КОНЕЦ									КАК СрокИспользованияДляВычисленияАмортизации,
	|	ВЫБОР
	|		КОГДА Линейный2.РасчетАмортизацииВручную ТОГДА
	|			Линейный2.РасчетАмортизацииСтоимость
	|		ИНАЧЕ
	|			ВЫБОР
	|				КОГДА Линейный2.ОстаточнаяСтоимость > 0
	|					И	(	Линейный2.РазностьАмортизаций > &ВеличинаНесущественнойРазницы
	|						ИЛИ	Линейный2.РазностьАмортизаций < -&ВеличинаНесущественнойРазницы) ТОГДА
	|					Линейный2.ОстаточнаяСтоимость
	|				ИНАЧЕ
	|					0
	|			КОНЕЦ
	|	КОНЕЦ									КАК СтоимостьДляВычисленияАмортизации
	|ИЗ
	|	Линейный2
	|	
	|ОБЪЕДИНИТЬ
	|
	|// Строки с любым другим способом начисления амортизации:
	|ВЫБРАТЬ
	|	Ссылка.Организация						КАК Организация,
	|	ПериодПринятиеКУчету					КАК Период,
	|	ОС										КАК ОсновноеСредство,
	|	СрокПолезногоИспользования				КАК СрокПолезногоИспользования,
	|	0										КАК СрокИспользованияДляВычисленияАмортизации,
	|	0										КАК СтоимостьДляВычисленияАмортизации
	|ИЗ
	|	ПолнаяТабличнаяЧастьОС
	|ГДЕ
	|	НЕ	СостояниеОС = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
	|	И	(	(ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|			И СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию))
	|		ИЛИ
	|			ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию)
	|	)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [9]. Движения по рег.накопл. АмортизацияОбъектовОС
	|//
	|ВЫБРАТЬ
	|	Ссылка.Организация						КАК Организация,
	|	ПериодАмортизация						КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)	КАК ВидДвижения,
	|	ОС										КАК ОсновноеСредство,
	|	ИнвНомерОС								КАК ИнвентарныйНомер,
	|	СуммаАмортизации						КАК СуммаАмортизации
	|ИЗ
	|	ПолнаяТабличнаяЧастьОС	КАК ПолнаяТабличнаяЧастьОС
	|ГДЕ
	|	НЕ	СуммаАмортизации = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [10]. Движения по рег.свед. ПараметрыАмортизацииОСБухгалтерскийУчет
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация			КАК Организация,
	|	ПериодПринятиеКУчету		КАК Период,
	|	ОС							КАК ОсновноеСредство,
	|	СпособНачисленияАмортизации	КАК СпособНачисленияАмортизации,
	|	ПорядокПогашенияСтоимости	КАК ПорядокПогашенияСтоимости
	|ИЗ
	|	ОС_Амортизация	КАК ОС_Амортизация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [11]. Движения по рег.свед. НомераИнвентарныхКарточек
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация			КАК Организация,
	|	Ссылка.Дата					КАК Период,
	|	ОС							КАК ОсновноеСредство,
	|	НомерИнвентарнойКарточки	КАК НомерИнвентарнойКарточки,
	|	ДатаПринятияКУчету			КАК ДатаИнвентарнойКарточки
	|ИЗ
	|	ОС_Амортизация	КАК ОС_Амортизация
	|ГДЕ
	|	НомерИнвентарнойКарточки <> """"	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [12]. Движения по рег.свед. ПервоначальныеСведенияОСБухгалтерскийУчет
	|//
	|ВЫБРАТЬ
	|	Ссылка.Организация						КАК Организация,
	|	Ссылка.Дата								КАК Период,
	|	ОС										КАК ОсновноеСредство,
	|	&ВалютаРУ								КАК ВалютаПоступления,
	|	1										КАК Курс,
	|	1										КАК Кратность,
	|	МИНИМУМ(ПервоначальнаяСтоимость)		КАК ПервоначальнаяСтоимость, // одинаковая стоимость гарантируется в проверке заполнения
	|	МИНИМУМ(ПервоначальнаяСтоимость)		КАК ПервоначальнаяСтоимостьВВалюте, // =ПервоначальнаяСтоимость
	|	СУММА(ПервоначальнаяСуммаАмортизации)	КАК ПервоначальнаяСуммаАмортизации,
	|	СУММА(Количество)						КАК Количество
	|ИЗ
	|	ПолнаяТабличнаяЧастьОС	КАК ПолнаяТабличнаяЧастьОС
	|СГРУППИРОВАТЬ ПО
	|	Ссылка.Организация,
	|	Ссылка.Дата,
	|	ОС,
	|	&ВалютаРУ,
	|	1,
	|	1;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [13]. Движения по рег.накопл. СтоимостьОбъектовОС
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация						КАК Организация,
	|	Ссылка.Дата								КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)	КАК ВидДвижения,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе) КАК ВидРаспоряжения,	
	|	ОС										КАК ОсновноеСредство,
	|	ИнвНомерОС								КАК ИнвентарныйНомер,
	|	ЦМО										КАК ЦМО,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям ТОГДА
	|			Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ 									КАК Подразделение,
	|	Сумма									КАК Стоимость,
	|	Количество								КАК Количество
	|ИЗ
	|	ПолнаяТабличнаяЧастьОС КАК ПолнаяТабличнаяЧастьОС
	|ГДЕ
	|	Сумма <> 0 ИЛИ Количество <> 0");
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ТаблицыДляДвижений, Результат, НомераТаблиц);
	
	// Гарантируем уникальность движений по колонкам измерений путем модификации периода:
	Если ТаблицыДляДвижений.СобытияОС.Количество() > 0 Тогда
		МодифицироватьПериодВСтрокахДублей(ТаблицыДляДвижений.СобытияОС,
			"ОсновноеСредство,ИнвНомер,Событие",
			"Период");
	КонецЕсли;
	
КонецПроцедуры

Функция ПодготовитьТаблицуПроводок_ИмуществоКазны(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ) Экспорт
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	// Определим, по какой табличной части будем делать проводки:
	РезультатПроверки = Неопределено;
	РежимВводаОстатков_ПроверитьЗаполнение(ДокументОбъект, РезультатПроверки);
	ПараметрыУчета = РезультатПроверки["Кэш"];
	ВестиПоАналитике		= ПараметрыУчета["ВестиПоАналитике"];
	НачислятьАмортизацию	= ПараметрыУчета["НачислятьАмортизацию"];
	ЭтоСчетМЗ				= ПараметрыУчета["ЭтоСчетМЗ"];
	
	Если ЭтоСчетМЗ Тогда
		// Учитываем материальные запасы.
		
		ЗапросДвижения = Новый Запрос();
		ЗапросДвижения.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
		ЗапросДвижения.УстановитьПараметр("ВидПервичногоДокумента",	"Бухгалтерская справка 0504833"); //Метаданные.ОбщиеКоманды.ПечатьСправки0504833_173.Комментарий);
		ЗапросДвижения.УстановитьПараметр("ДатаПервичногоДокумента",	ДокументОбъект.Дата);
		ЗапросДвижения.УстановитьПараметр("НомерПервичногоДокумента",	ДокументОбъект.Номер);
		ЗапросДвижения.УстановитьПараметр("Счет000", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("000"));
		ЗапросДвижения.Текст = "
		|////////////////////////////////////////////////////////////////////////////////
		|// [0]. Движения по вводу остатков МЗ (Имущество казны)
		|//
		|ВЫБРАТЬ
		|	ИСТИНА							КАК Активность,
		|	Ссылка.Дата						КАК Период,
		|	Ссылка.Организация				КАК Организация,
		|	Ссылка.ИФО						КАК ИФО,
		|	Ссылка.КФО						КАК КФО,
		|	
		|	&ВидПервичногоДокумента			КАК ВидПервичногоДокумента,
		|	&ДатаПервичногоДокумента		КАК ДатаПервичногоДокумента,
		|	&НомерПервичногоДокумента		КАК НомерПервичногоДокумента,
		|	
		|	// Дебет:
		|	Ссылка.Счет						КАК СчетДт,
		|	Ссылка.КПС						КАК КПСДт,
		|	Ссылка.КЭК						КАК КЭКДт,
		|	Номенклатура					КАК СубконтоДт1,
		|	Количество						КАК КоличествоДт,
		|	ВЫБОР
		|		КОГДА Ссылка.Счет.УчетПоПодразделениям ТОГДА
		|			Подразделение
		|	КОНЕЦ							КАК ПодразделениеДт,
		|
		|	// Кредит:
		|	&Счет000						КАК СчетКт,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(&Счет000 КАК ПланСчетов.ЕПСБУ).Количественный ТОГДА
		|			Количество
		|	КОНЕЦ							КАК КоличествоКт,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(&Счет000 КАК ПланСчетов.ЕПСБУ).УчетПоПодразделениям ТОГДА
		|			Подразделение
		|	КОНЕЦ							КАК ПодразделениеКт,
		|	
		|	Сумма							КАК Сумма,
		|	
		|	""Ввод остатков по "" + Номенклатура.Наименование	КАК Содержание
		|ИЗ
		|	Документ.ВводНачальныхОстатков.Материалы	КАК Материалы
		|ГДЕ
		|	Материалы.Ссылка = &Ссылка
		|;";
		
		Выборка = ЗапросДвижения.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			СтрокаТЗ = ТаблицаПроводок.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаТЗ, Выборка);
			
			СтрокаТЗ.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(СтрокаТЗ.СчетДт, СтрокаТЗ.СчетКт);
			
		КонецЦикла;
		
	Иначе
		// Учитываем ОС, НМА, НПА.
		
		// Прочтем учетную политику по ведению учета казны:
		РезультатПроверки = Неопределено;
		РежимВводаОстатков_ПроверитьЗаполнение(ДокументОбъект, РезультатПроверки);
		ВестиПоАналитике		= РезультатПроверки["Кэш"]["ВестиПоАналитике"];
		НачислятьАмортизацию	= РезультатПроверки["Кэш"]["НачислятьАмортизацию"];
		
		СчетИКЭКАмортизации = ПолучитьСчетИКЭКАмортизации(ДокументОбъект);
		//---
		// КЭК0
		//---
		Если ИспользоватьКЭК0(
			ДокументОбъект["Организация"],
			ДокументОбъект["ИФО"],
			ДокументОбъект["КФО"],
			ДокументОбъект["Дата"],
			СчетИКЭКАмортизации["Счет"]) Тогда
			СчетИКЭКАмортизации.Вставить("КЭК", БухгалтерскийУчетПовтИсп.КЭК0());
		КонецЕсли;
		
		// Настраиваем запрос:
		ЗапросДвижения = Новый Запрос();
		ЗапросДвижения.УстановитьПараметр("Ссылка",					ДокументОбъект.Ссылка);
		ЗапросДвижения.УстановитьПараметр("Период",					ДокументОбъект.Дата);
		ЗапросДвижения.УстановитьПараметр("Организация",			ДокументОбъект.Организация);
		ЗапросДвижения.УстановитьПараметр("КФО",					ДокументОбъект.КФО);
		ЗапросДвижения.УстановитьПараметр("ИФО",					ДокументОбъект.ИФО);
		ЗапросДвижения.УстановитьПараметр("Счет",					ДокументОбъект.Счет);
		ЗапросДвижения.УстановитьПараметр("КПС",					ДокументОбъект.КПС);
		ЗапросДвижения.УстановитьПараметр("КЭК",					ДокументОбъект.КЭК);
		
		ЗапросДвижения.УстановитьПараметр("ВестиПоАналитике",			ВестиПоАналитике);
		ЗапросДвижения.УстановитьПараметр("ВидПервичногоДокумента",		"Бухгалтерская справка 0504833"); //Метаданные.ОбщиеКоманды.ПечатьСправки0504833_173.Комментарий);
		ЗапросДвижения.УстановитьПараметр("ДатаПервичногоДокумента",	ДокументОбъект.Дата);
		ЗапросДвижения.УстановитьПараметр("НомерПервичногоДокумента",	ДокументОбъект.Номер);
		
		ЗапросДвижения.УстановитьПараметр("СчетАмортизации",	СчетИКЭКАмортизации["Счет"]);
		ЗапросДвижения.УстановитьПараметр("КЭКАмортизации",		СчетИКЭКАмортизации["КЭК"]);
		
		ЗапросДвижения.УстановитьПараметр("Счет000", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("000"));
		
		ЗапросДвижения.Текст = "
		|////////////////////////////////////////////////////////////////////////////////
		|// [0]. (Подготовка) Данные табличной части
		|//
		|ВЫБРАТЬ	
		|	ОС						КАК ОС,
		|	ИнвНомерОС				КАК ИнвНомер,
		|	&СчетАмортизации		КАК СчетАмортизации,
		|	&КЭКАмортизации			КАК КЭКАмортизации,
		|	Подразделение			КАК Подразделение,
		|	
		|	СУММА(Сумма)			КАК Сумма,
		|	СУММА(Количество)		КАК Количество,
		|	СУММА(СуммаАмортизации)	КАК СуммаАмортизации
		|ПОМЕСТИТЬ
		|	ДанныеБух
		|ИЗ
		|	Документ.ВводНачальныхОстатков.ОС_Основная	КАК ОС_Основная
		|ГДЕ
		|	ОС_Основная.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ОС,
		|	ИнвНомерОС,
		|	&СчетАмортизации,
		|	&КЭКАмортизации,
		|	Подразделение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// [1]. Движения по вводу остатков (Имущество казны)
		|//		(Финальная таблица)
		|ВЫБРАТЬ
		|	ИСТИНА						КАК Активность,
		|	&Период						КАК Период,
		|	&Организация				КАК Организация,
		|	&КФО						КАК КФО,
		|	&ИФО						КАК ИФО,
		|	&ВидПервичногоДокумента		КАК ВидПервичногоДокумента,
		|	&ДатаПервичногоДокумента	КАК ДатаПервичногоДокумента,
		|	&НомерПервичногоДокумента	КАК НомерПервичногоДокумента,
		|	
		|	// Дебет:
		|	&Счет						КАК СчетДт,
		|	&КПС						КАК КПСДт,
		|	&КЭК						КАК КЭКДт,
		|	ДанныеБух.ОС				КАК СубконтоДт1,
		|	ДанныеБух.Подразделение		КАК ПодразделениеДт,
		|	ВЫБОР
		|		КОГДА &ВестиПоАналитике ТОГДА
		|			ДанныеБух.Количество
		|	КОНЕЦ						КАК КоличествоДт,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.ВводОстатков)	КАК ХарактеристикаДвиженияДт,
		|	
		|	// Кредит:
		|	&Счет000					КАК СчетКт,
		|	
		|	ДанныеБух.Сумма				КАК Сумма,
		|	
		|	ВЫБОР
		|		КОГДА &ВестиПоАналитике ТОГДА
		|			ВЫБОР
		|				КОГДА ДанныеБух.ИнвНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) ТОГДА
		|					""Ввод остатков по "" + ДанныеБух.ОС.Наименование
		|				ИНАЧЕ
		|					""Ввод остатков по инв.№"" + ДанныеБух.ИнвНомер.Код
		|			КОНЕЦ
		|		ИНАЧЕ
		|			""Ввод остатков по "" + ДанныеБух.ОС.Наименование
		|	КОНЕЦ						КАК Содержание
		|ИЗ
		|	ДанныеБух
		|ГДЕ
		|	НЕ ДанныеБух.Сумма = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// [2]. Движения по вводу остатков амортизации (Имущество казны)
		|//		(Финальная таблица)
		|ВЫБРАТЬ
		|	ИСТИНА								КАК Активность,
		|	&Период								КАК Период,
		|	&Организация						КАК Организация,
		|	&КФО								КАК КФО,
		|	&ИФО								КАК ИФО,
		|	
		|	&ВидПервичногоДокумента				КАК ВидПервичногоДокумента,
		|	&ДатаПервичногоДокумента			КАК ДатаПервичногоДокумента,
		|	&НомерПервичногоДокумента			КАК НомерПервичногоДокумента,
		|	
		|	// Дебет:
		|	&Счет000							КАК СчетДт,
		|	
		|	// Кредит:
		|	ДанныеБух.СчетАмортизации			КАК СчетКт,
		|	ДанныеБух.КЭКАмортизации			КАК КЭККт,
		|	&КПС								КАК КПСКт,
		|	ДанныеБух.ОС						КАК СубконтоКт1,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.ВводОстатков)	КАК ХарактеристикаДвиженияКт,
		|	ДанныеБух.Подразделение				КАК ПодразделениеКт,
		|	
		|	ДанныеБух.СуммаАмортизации			КАК Сумма,
		|	
		|	ВЫБОР
		|		КОГДА ДанныеБух.ИнвНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) ТОГДА
		|			""Ввод остатков амортизации по "" + ДанныеБух.ОС.Наименование
		|		ИНАЧЕ
		|			""Ввод остатков амортизации по инв.№"" + ДанныеБух.ИнвНомер.Код
		|	КОНЕЦ								КАК Содержание
		|ИЗ
		|	ДанныеБух
		|ГДЕ
		|	НЕ ДанныеБух.СуммаАмортизации = 0
		|;";
		
		РезультатыЗапроса = ЗапросДвижения.ВыполнитьПакет();
		
		// 1. Проводки по вводу остатков - обязательные:
		Выборка = РезультатыЗапроса[1].Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаТЗ = ТаблицаПроводок.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЗ, Выборка);
			
			СтрокаТЗ.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(СтрокаТЗ.СчетДт, СтрокаТЗ.СчетКт);
		КонецЦикла;
		
		// 2. Проводки начисления амортизации - опциональные:
		Если НачислятьАмортизацию Тогда
			Выборка = РезультатыЗапроса[2].Выбрать();
			Пока Выборка.Следующий() Цикл
				СтрокаТЗ = ТаблицаПроводок.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТЗ, Выборка);
				
				СтрокаТЗ.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(СтрокаТЗ.СчетДт, СтрокаТЗ.СчетКт);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТаблицаПроводок;
	
КонецФункции

//---
// Раздел учета "БСО"
//---

Функция ЕстьОшибкиЗаполнения_БСО(ДокументОбъект) Экспорт
	
	МаксДлинаСообщения = 200;
	ЕстьОшибкиЗаполнения = Ложь;
	
	// Составим проверяемую таблицу:
	ТаблицаБСО = Новый ТаблицаЗначений;
	ТипЧисло = Новый ОписаниеТипов("Число");
	ТаблицаБСО.Колонки.Добавить("НомерСтроки",		ТипЧисло);
	ТаблицаБСО.Колонки.Добавить("БСО",				Новый ОписаниеТипов("СправочникСсылка.БСО"));
	ТаблицаБСО.Колонки.Добавить("СерияБСО",			Новый ОписаниеТипов("СправочникСсылка.СерииБСО"));
	ТаблицаБСО.Колонки.Добавить("НомерНачальный",	ТипЧисло);
	ТаблицаБСО.Колонки.Добавить("НомерКонечный",	ТипЧисло);
	ТаблицаБСО.Колонки.Добавить("Количество",		ТипЧисло);
	ТаблЧасть = ДокументОбъект["СоставБСО"];
	Для Каждого СтрокаТЧ Из ТаблЧасть Цикл
		СтрокаТЗ = ТаблицаБСО.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЗ, СтрокаТЧ, "БСО, СерияБСО, НомерСтроки, Количество");
		СтрокаТЗ["НомерНачальный"] = ?(ЗначениеЗаполнено(СтрокаТЧ["НомерНачальный"]),
			Число(СтрокаТЧ["НомерНачальный"]),
			0);
		СтрокаТЗ["НомерКонечный"] = ?(ЗначениеЗаполнено(СтрокаТЧ["НомерКонечный"]),
			Число(СтрокаТЧ["НомерКонечный"]),
			0);
	КонецЦикла;
	
	Попытка
		СчетУчетПоПодразделениям = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ДокументОбъект["Счет"])["УчетПоПодразделениям"];
	Исключение
		СчетУчетПоПодразделениям = Ложь;
	КонецПопытки;
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И СчетУчетПоПодразделениям;
	
	// Настраиваем запрос:
	ЗапросПроверка = Новый Запрос();
	ЗапросПроверка.УстановитьПараметр("ДокСсылка",				ДокументОбъект["Ссылка"]);
	ЗапросПроверка.УстановитьПараметр("ТЗСоставБСО",			ТаблицаБСО);
	ЗапросПроверка.УстановитьПараметр("Организация",			ДокументОбъект["Организация"]);
	ЗапросПроверка.УстановитьПараметр("КонецПериода",			ДокументОбъект["Дата"]);
	ЗапросПроверка.УстановитьПараметр("ИФО",					ДокументОбъект["ИФО"]);
	ЗапросПроверка.УстановитьПараметр("ИспользоватьУчетПоИФО",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ЗапросПроверка.УстановитьПараметр("ЦМО",					ДокументОбъект["ЦМО"]);
	ЗапросПроверка.УстановитьПараметр("Подразделение",						ДокументОбъект["ПодразделениеОрганизации"]);
	ЗапросПроверка.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	ЗапросПроверка.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходные проверяемые данные табличной части документа.
	|//
	|ВЫБРАТЬ
	|	ТЗ.НомерСтроки		КАК НомерСтроки,
	|	ТЗ.БСО				КАК БСО,
	|	ТЗ.СерияБСО			КАК СерияБСО,
	|	ТЗ.НомерНачальный	КАК НомерНачальный,
	|	ТЗ.НомерКонечный	КАК НомерКонечный,
	|	ТЗ.Количество		КАК Количество
	|ПОМЕСТИТЬ
	|	Данные
	|ИЗ
	|	&ТЗСоставБСО КАК ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	БСО,
	|	СерияБСО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка)
	|//		(Проверка на заполненность номеров в табличной части)
	|
	|ВЫБРАТЬ
	|	// Пустое поле ""БСО"":
	|	1				КАК Приоритет,
	|	НомерСтроки		КАК НомерСтроки
	|ПОМЕСТИТЬ Ошибки
	|ИЗ
	|	Данные
	|ГДЕ
	|	БСО = ЗНАЧЕНИЕ(Справочник.БСО.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	// Пустое поле ""НомерНачальный"":
	|	3				КАК Приоритет,
	|	НомерСтроки		КАК НомерСтроки
	|ИЗ
	|	Данные
	|ГДЕ
	|	Данные.НомерНачальный = 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	// Пустое поле ""Количество"":
	|	4				КАК Приоритет,
	|	НомерСтроки		КАК НомерСтроки
	|ИЗ
	|	Данные
	|ГДЕ
	|	Данные.Количество = 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	// Пустое поле ""НомерКонечный"":
	|	5				КАК Приоритет,
	|	НомерСтроки		КАК НомерСтроки
	|ИЗ
	|	Данные
	|ГДЕ
	|	Данные.НомерКонечный = 0
	|	И Данные.Количество > 1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	// Начальный номер больше конечного:
	|	6				КАК Приоритет,
	|	НомерСтроки		КАК НомерСтроки
	|ИЗ
	|	Данные
	|ГДЕ
	|	Данные.НомерНачальный > Данные.НомерКонечный 
	|	И Данные.НомерНачальный > 0
	|	И Данные.НомерКонечный > 0 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Проверка на заполненность номеров в табличной части
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	НомерСтроки			КАК НомерСтроки,
	|	МИНИМУМ(Приоритет)	КАК Приоритет
	|ИЗ
	|	Ошибки
	|СГРУППИРОВАТЬ ПО
	|	НомерСтроки
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. (Подготовка)
	|//		(Пересекающиеся интервалы номеров одной и той же серии)
	|//		Подразумевается, что в каждой строке гарантированно НомерКонечный >= НомерНачальный.
	|ВЫБРАТЬ
	|	Д1.НомерСтроки	КАК НомерСтроки,
	|	Д2.НомерСтроки	КАК ПересекаетсяСНомерСтроки
	|
	|ПОМЕСТИТЬ
	|	ПересекающиесяНомера
	|	
	|ИЗ
	|	Данные	КАК Д1
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	Данные	КАК Д2
	|		ПО	НЕ Д2.НомерСтроки = Д1.НомерСтроки
	|		И Д2.БСО	= Д1.БСО
	|		И Д2.СерияБСО = Д1.СерияБСО
	|		И (
	|			(Д2.НомерНачальный <= Д1.НомерКонечный
	|			И Д2.НомерКонечный >= Д1.НомерКонечный)
	|			
	|			ИЛИ
	|			
	|			(Д2.НомерНачальный <= Д1.НомерНачальный
	|			И Д2.НомерКонечный >= Д1.НомерНачальный)
	|		)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Пересекающиеся интервалы номеров одной и той же серии
	|//		(Финальная таблица для вывода сообщений)
	|//		
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НомерСтроки					КАК НомерСтроки,
	|	ПересекаетсяСНомерСтроки	КАК ПересекаетсяСНомерСтроки
	|
	|ИЗ
	|	(
	|	ВЫБРАТЬ
	|		НомерСтроки					КАК НомерСтроки,
	|		ПересекаетсяСНомерСтроки	КАК ПересекаетсяСНомерСтроки
	|	ИЗ
	|		ПересекающиесяНомера
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПересекаетсяСНомерСтроки	КАК НомерСтроки,
	|		НомерСтроки					КАК ПересекаетсяСНомерСтроки
	|		
	|	ИЗ
	|		ПересекающиесяНомера
	|	)	КАК ВложенныйЗапрос
	|	
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки,
	|	ПересекаетсяСНомерСтроки
	|	
	|ИТОГИ
	|ПО
	|	// Итоги рассчитываются только для удобства дальнейшего вывода сообщений:
	|	НомерСтроки	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. (Подготовка) Исходные движения по регистру накопления БСО.
	|//		Исключены возможные движения самого этого документа.
	|//		(Остатки БСО на указанную дату)
	|ВЫБРАТЬ
	|	ДвиженияБСО.БСО								КАК БСО,
	|	ДвиженияБСО.СерияБСО						КАК СерияБСО,
	|	ДвиженияБСО.НомерНачальный					КАК НомерНачальный,
	|	ДвиженияБСО.НомерКонечный					КАК НомерКонечный,
	|	ВЫБОР
	|		КОГДА ДвиженияБСО.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА
	|			1
	|		ИНАЧЕ
	|			-1
	|	КОНЕЦ										КАК ДельтаКоличество
	|ПОМЕСТИТЬ
	|	ДвиженияБСО
	|ИЗ
	|	РегистрНакопления.ДвиженияБСО	КАК ДвиженияБСО
	|ГДЕ
	|	ДвиженияБСО.Организация = &Организация
	|	// Отбор по ИФО:
	|	И ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ДвиженияБСО.ИФО = &ИФО
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	// Отбор по подразделению:
	|	И ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			ДвиженияБСО.Подразделение = &Подразделение
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ЦМО = НЕОПРЕДЕЛЕНО ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ДвиженияБСО.ЦМО = &ЦМО
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &КонецПериода = НЕОПРЕДЕЛЕНО ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ДвиженияБСО.Период <= &КонецПериода
	|	КОНЕЦ
	|	И ДвиженияБСО.НомерНачальный > 0
	|	И ДвиженияБСО.НомерКонечный > 0
	|	И НЕ ДвиженияБСО.Регистратор = &ДокСсылка
	|	// =IF EXIST
	|	И (БСО, СерияБСО) В (
	|		ВЫБРАТЬ
	|			БСО,
	|			СерияБСО
	|		ИЗ
	|			Данные)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [6]. (Подготовка) Все границы диапазонов номеров, а также дельты,
	|//		действующие, начиная с соответствующей границы, включая ее.
	|//		Возможны повторяющиеся границы диапазонов (если они присутствовали
	|//		из-за наличия нескольких движений по одному и тому же номеру)
	|//		(Остатки БСО на указанную дату)
	|ВЫБРАТЬ
	|	БСО,
	|	СерияБСО,
	|	
	|	НомерНачальный	КАК Граница,
	|	ДельтаКоличество
	|
	|ПОМЕСТИТЬ
	|	ВсеГраницы
	|ИЗ
	|	ДвиженияБСО
	|		
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	БСО,
	|	СерияБСО,
	|	
	|	НомерКонечный+1	КАК Граница,
	|	-ДельтаКоличество
	|ИЗ
	|	ДвиженияБСО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [7]. (Подготовка) Уникальные границы диапазонов номеров, а также дельты.
	|//		Исключены повторяющиеся границы диапазонов.
	|//		(Остатки БСО на указанную дату)
	|ВЫБРАТЬ
	|	БСО,
	|	СерияБСО,
	|	
	|	Граница,
	|	СУММА(ДельтаКоличество)	КАК ДельтаКоличество
	|ПОМЕСТИТЬ
	|	УникальныеГраницы
	|ИЗ
	|	ВсеГраницы
	|
	|СГРУППИРОВАТЬ ПО
	|	БСО,
	|	СерияБСО,
	|	Граница
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	БСО,
	|	СерияБСО,
	|	Граница
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [8]. (Подготовка) Уникальные границы диапазонов номеров, НПП и искомый
	|//		множитель количества.
	|//		Практически искомый результат.
	|//		Возможно наличие смежных диапазонов номеров с одинаковым значением
	|//		множителя количества, которые можно объединить в один диапазон.
	|//		(Остатки БСО на указанную дату)
	|ВЫБРАТЬ
	|	Т1.БСО,
	|	Т1.СерияБСО,
	|	Т1.Граница,
	|	
	|	КОЛИЧЕСТВО(Т2.Граница)		КАК НПП,
	|	СУММА(Т2.ДельтаКоличество)	КАК МножительКоличество
	|	
	|ПОМЕСТИТЬ
	|	УникальныеГраницыНПП
	|	
	|ИЗ
	|	УникальныеГраницы	КАК Т1
	|	ЛЕВОЕ СОЕДИНЕНИЕ	УникальныеГраницы	КАК Т2
	|		ПО	Т2.БСО = Т1.БСО
	|		И	Т2.СерияБСО = Т1.СерияБСО
	|		И	Т2.Граница <= Т1.Граница
	|		
	|СГРУППИРОВАТЬ ПО
	|	Т1.БСО,
	|	Т1.СерияБСО,
	|	Т1.Граница
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Т1.БСО,
	|	Т1.СерияБСО,
	|	НПП
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [9]. (Подготовка) Все смежные диапазоны номеров объединены в один.
	|//		Практически искомый результат, но в виде списка границ.
	|//		(Остатки БСО на указанную дату)
	|ВЫБРАТЬ
	|	БСО						КАК БСО,
	|	СерияБСО				КАК Серия,
	|	Граница					КАК НачальныйНомерУчет,
	|	// Множитель количества, больший 1, учитываем как 1
	|	// (для определения наличия остатков конкретная величина множителя не важна):
	|	ВЫБОР
	|		КОГДА МножительКоличество > 0 ТОГДА
	|			1
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ					КАК МножительКоличество
	|ПОМЕСТИТЬ
	|	ОстаткиБСО
	|ИЗ
	|	УникальныеГраницыНПП	КАК Т1
	|ГДЕ
	|	// =IF NOT EXIST(...):
	|	(БСО, СерияБСО, МножительКоличество) НЕ В (
	|		ВЫБРАТЬ
	|			БСО,
	|			СерияБСО,
	|			МножительКоличество
	|		ИЗ
	|			УникальныеГраницыНПП	КАК Т2
	|			
	|		ГДЕ
	|			Т2.БСО = Т1.БСО
	|			И	Т2.СерияБСО = Т1.СерияБСО
	|			И	Т2.НПП = Т1.НПП - 1
	|			И	Т2.МножительКоличество = Т1.МножительКоличество
	|	)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [10]. Остатки БСО на указанную дату
	|//		(Финальная таблица)
	|ВЫБРАТЬ
	|	Т1.БСО						КАК БСО,
	|	Т1.Серия					КАК Серия,
	|	Т1.НачальныйНомерУчет		КАК НачальныйНомер,
	|	Т2.НачальныйНомерУчет - 1	КАК КонечныйНомер
	|ПОМЕСТИТЬ
	|	ТекущиеОстаткиБСО
	|ИЗ
	|	ОстаткиБСО	КАК Т1
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ОстаткиБСО	КАК Т2
	|		ПО	Т2.БСО = Т1.БСО
	|		И	Т2.Серия = Т1.Серия
	|		И	Т1.МножительКоличество > 0
	|		И	Т2.НачальныйНомерУчет В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				НачальныйНомерУчет
	|			ИЗ
	|				ОстаткиБСО
	|			ГДЕ
	|				МножительКоличество = 0
	|				И	НачальныйНомерУчет > Т1.НачальныйНомерУчет
	|				И	БСО = Т1.БСО
	|				И	Серия = Т1.Серия
	|			УПОРЯДОЧИТЬ ПО
	|				НачальныйНомерУчет)
	|ИНДЕКСИРОВАТЬ ПО
	|	Т1.БСО,
	|	Т1.Серия
	|;	
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [11]. Уже введенные остатки по номерам БСО
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	Данные.НомерСтроки		КАК НомерСтроки,
	|	(ВЫРАЗИТЬ(Данные.БСО КАК Справочник.БСО)).ДлинаНомера	КАК ДлинаНомера,
	|	
	|	ВЫБОР
	|		КОГДА	(Данные.НомерНачальный >= ТекущиеОстаткиБСО.НачальныйНомер
	|			И Данные.НомерНачальный <= ТекущиеОстаткиБСО.КонечныйНомер) ТОГДА
	|			Данные.НомерНачальный
	|		ИНАЧЕ
	|			ТекущиеОстаткиБСО.НачальныйНомер
	|	КОНЕЦ					КАК НачальныйНомерПересечения,
	|	ВЫБОР
	|		КОГДА	(Данные.НомерКонечный >= ТекущиеОстаткиБСО.НачальныйНомер
	|			И Данные.НомерКонечный <= ТекущиеОстаткиБСО.КонечныйНомер) ТОГДА
	|			Данные.НомерКонечный
	|		ИНАЧЕ
	|			ТекущиеОстаткиБСО.КонечныйНомер
	|	КОНЕЦ					КАК КонечныйНомерПересечения
	|	
	|ИЗ
	|	Данные
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ТекущиеОстаткиБСО
	|		ПО	Данные.БСО = ТекущиеОстаткиБСО.БСО
	|		И	Данные.СерияБСО = ТекущиеОстаткиБСО.Серия
	|		И	((Данные.НомерНачальный >= ТекущиеОстаткиБСО.НачальныйНомер
	|			И Данные.НомерНачальный <= ТекущиеОстаткиБСО.КонечныйНомер)
	|			ИЛИ
	|			(Данные.НомерКонечный >= ТекущиеОстаткиБСО.НачальныйНомер
	|			И Данные.НомерКонечный <= ТекущиеОстаткиБСО.КонечныйНомер))
	|		// Повторное условие на корректные значения номеров исходной таблицы:
	|		И	Данные.НомерКонечный >= Данные.НомерНачальный
	|		И	Данные.НомерНачальный > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";
	
	// Выполняем запросы:
	РезультатыПроверок = ЗапросПроверка.ВыполнитьПакет();
	
	// Выводим сообщения:
	ИмяТаблЧастиДляВыводаСообщений = "СоставБСО";
	Реквизиты = ДокументОбъект.Метаданные().ТабличныеЧасти[ИмяТаблЧастиДляВыводаСообщений].Реквизиты;
	СинонимыПолей = Новый Соответствие();
	Для Каждого Реквизит Из Реквизиты Цикл
		СинонимыПолей.Вставить(Реквизит.Имя, Реквизит.Синоним);
	КонецЦикла;
	
	//	[2]		Проверка на заполненность номеров в табличной части
	РезультатПроверки = РезультатыПроверок[2];
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		ТЗРезультат = РезультатПроверки.Выгрузить();
		Для Каждого СтрокаТЗ Из ТЗРезультат Цикл
			
			НомерСтроки = СтрокаТЗ["НомерСтроки"];
			Приоритет = СтрокаТЗ["Приоритет"];
			
			Если Приоритет = 6 Тогда
				// Начальный номер больше конечного
				ИмяПоляДляВыводаСообщений = "НомерКонечный";
				Текст = НСтр("ru='Конечный номер меньше начального номера (таблица ""БСО"", строка %1)'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
					НомерСтроки);
				
			Иначе
				Текст = НСтр("ru='Поле ""%1"" не заполнено (таблица ""БСО"", строка %2)'");
				
				Если Приоритет = 1 Тогда
					// Пустое поле "БСО"
					ИмяПоляДляВыводаСообщений = "БСО";
			
				ИначеЕсли Приоритет = 2 Тогда
					// Пустое поле "СерияБСО"
					ИмяПоляДляВыводаСообщений = "СерияБСО";
		
				ИначеЕсли Приоритет = 3 Тогда
					// Пустое поле "НомерНачальный"
					ИмяПоляДляВыводаСообщений = "НомерНачальный";
						
				ИначеЕсли Приоритет = 4 Тогда
					// Пустое поле "Количество"
					ИмяПоляДляВыводаСообщений = "Количество";
					
				ИначеЕсли Приоритет = 5 Тогда
					// Пустое поле "НомерКонечный"
					ИмяПоляДляВыводаСообщений = "НомерКонечный";
					
				Иначе
					Продолжить;
					
				КонецЕсли;
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
					СинонимыПолей.Получить(ИмяПоляДляВыводаСообщений),
					НомерСтроки);
				
			КонецЕсли;
			
			ИндексСтроки = НомерСтроки - 1;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
		КонецЦикла;
	КонецЕсли;
	
	//	[4]		Пересекающиеся интервалы номеров одной и той же серии
	РезультатПроверки = РезультатыПроверок[4];
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		ИмяПоляДляВыводаСообщений = "НомерНачальный";
		Текст = НСтр("ru='Пересекающиеся интервалы номеров одной и той же серии (таблица ""БСО"", строка %1 со строками %2)'");
		ДЗРезультат = РезультатПроверки.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		Для Каждого СтрокаИтого Из ДЗРезультат.Строки Цикл
			
			НомераСтрок = СтрокаИтого.Строки.ВыгрузитьКолонку("ПересекаетсяСНомерСтроки");
			ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(Текст, НомераСтрок, МаксДлинаСообщения, "%2");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
				СтрокаИтого["НомерСтроки"]);
			
			ИндексСтроки = СтрокаИтого["НомерСтроки"] - 1;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
		КонецЦикла;
	КонецЕсли;
	
	//	[11]		Уже введенные остатки по номерам БСО
	РезультатПроверки = РезультатыПроверок[11];
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		ИмяПоляДляВыводаСообщений = "НомерНачальный";
		Текст = НСтр("ru='Для некоторых из указанных номеров начальные остатки бланков уже введены (таблица ""БСО"", строка %1, номера бланков с %2 по %3)'");
		ТЗРезультат = РезультатПроверки.Выгрузить();
		Для Каждого СтрокаТЗ Из ТЗРезультат Цикл
			
			НомерСтроки = СтрокаТЗ["НомерСтроки"];
			ДлинаНомера = СтрокаТЗ["ДлинаНомера"];
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
				НомерСтроки,
				ПолучитьПредставлениеНомераБСО(СтрокаТЗ["НачальныйНомерПересечения"], ДлинаНомера),
				ПолучитьПредставлениеНомераБСО(СтрокаТЗ["КонечныйНомерПересечения"], ДлинаНомера));
			
			ИндексСтроки = НомерСтроки - 1;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
		КонецЦикла;
	КонецЕсли;
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Функция ПолучитьПредставлениеНомераБСО(НомерЧисло, ДлинаПредставления)
	
	Если НомерЧисло = 0 Тогда
		НомерСтрокой = "";
		
	Иначе
		
		Если НЕ ЗначениеЗаполнено(ДлинаПредставления) Тогда
			ДлинаПредставления = ОбщегоНазначенияБГУКлиентСервер.МаксимальнаяДлинаНомераБСО();
		КонецЕсли;
		
		НомерСтрокой = Формат(Число(НомерЧисло), "ЧГ=0");
		ТекущаяДлинаНомера = СтрДлина(НомерСтрокой);
		
		КоличествоСимволов = ДлинаПредставления - ТекущаяДлинаНомера;
		Для сч = 1 по КоличествоСимволов Цикл 
			НомерСтрокой = "0" + НомерСтрокой;
		КонецЦикла;
		
	КонецЕсли;
	
	
	Возврат НомерСтрокой;
	
КонецФункции	

Процедура ИнициализироватьДанныеДокумента_БСО(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	// Подготовка:
	СчетСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Счет");
	Попытка
		СчетУчетПоПодразделениям = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетСсылка)["УчетПоПодразделениям"];
	Исключение
		СчетУчетПоПодразделениям = Ложь;
	КонецПопытки;
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И СчетУчетПоПодразделениям;
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ЗапросБСО = Новый Запрос();
	ЗапросБСО.УстановитьПараметр("ДокСсылка", 							ДокументСсылка);
	ЗапросБСО.УстановитьПараметр("ИспользоватьУчетПоИФО",				ИспользоватьУчетПоИФО);
	ЗапросБСО.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	ЗапросБСО.УстановитьПараметр("СчетУчета", 							СчетСсылка);
	
	ЗапросБСО.Текст = "
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)	КАК ВидДвижения,
	|	СоставБСО.Ссылка.Организация			КАК Организация,
	|	СоставБСО.Ссылка.Дата					КАК Период,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			СоставБСО.Ссылка.ИФО
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ									КАК ИФО,
	|	СоставБСО.Ссылка.КФО					КАК КФО,
	|	СоставБСО.Ссылка.ЦМО					КАК ЦМО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			СоставБСО.Ссылка.ПодразделениеОрганизации
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ									КАК Подразделение,
	|	СоставБСО.БСО							КАК БСО,
	|	СоставБСО.СерияБСО						КАК СерияБСО,
	|	СоставБСО.НомерНачальный				КАК НомерНачальный,
	|	СоставБСО.НомерКонечный					КАК НомерКонечный,
	|	СоставБСО.Количество					КАК Количество,
	|	&СчетУчета								КАК СчетУчета
	|ИЗ
	|	Документ.ВводНачальныхОстатков.СоставБСО КАК СоставБСО
	|ГДЕ
	|	СоставБСО.Ссылка = &ДокСсылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	СоставБСО.НомерСтроки";
	
	ДвиженияБСО = ЗапросБСО.Выполнить().Выгрузить();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("ДвиженияБСО", ДвиженияБСО);
		
КонецПроцедуры // ИнициализироватьДанныеДокумента()

//---
// Раздел учета "Родительская плата"
//---

Функция ЕстьОшибкиЗаполнения_РодительскаяПлата(ДокументОбъект) Экспорт
	
	МаксДлинаСообщения = 200;
	ЕстьОшибкиЗаполнения = Ложь;
	
	// Входная проверка.
	// Учтем значения функциональных опций (для поиска уже введенных остатков):
	Подразделение = Неопределено;
	ПодразделениеЗаполнено = Истина;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Подразделение = ДокументОбъект["ПодразделениеОрганизации"];
		ПодразделениеЗаполнено = ЗначениеЗаполнено(Подразделение);
	КонецЕсли;
	ИФО = Неопределено;
	ИФОЗаполнено = Истина;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ИФО = ДокументОбъект["ИФО"];
		ИФОЗаполнено = ЗначениеЗаполнено(ИФО);
	КонецЕсли;
	// Если не заполнены обязательные реквизиты шапки,
	// то мы не можем полноценно выполнить планируемые проверки заполнения.
	Если	НЕ ЗначениеЗаполнено(ДокументОбъект["Организация"])
		ИЛИ	НЕ ЗначениеЗаполнено(ДокументОбъект["Дата"])
		ИЛИ	НЕ ПодразделениеЗаполнено
		ИЛИ	НЕ ИФОЗаполнено
		Тогда
		// Выходим:
		Возврат Истина;
	КонецЕсли;
	ПринятьДетейВГруппу = ДокументОбъект["ПринятьДетейВГруппу"];
	
	
	// Настраиваем запрос:
	ЗапросПроверка = Новый Запрос();
	ЗапросПроверка.УстановитьПараметр("ТЧ",	ДокументОбъект["РодительскаяПлата"].Выгрузить());
	ЗапросПроверка.УстановитьПараметр("Организация",			ДокументОбъект["Организация"]);
	ЗапросПроверка.УстановитьПараметр("Подразделение",			Подразделение);
	ЗапросПроверка.УстановитьПараметр("ИФО",					ИФО);
	ЗапросПроверка.УстановитьПараметр("Счет",					ДокументОбъект["Счет"]);
	ЗапросПроверка.УстановитьПараметр("ТекДата",				ДокументОбъект["Дата"]);
	ЗапросПроверка.УстановитьПараметр("ПринятьДетейВГруппу",	ПринятьДетейВГруппу);
	ЗапросПроверка.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Исходные проверяемые данные табличной части документа
	|//
	|ВЫБРАТЬ
	|	ТЧ.НомерСтроки		КАК НомерСтроки,
	|	ТЧ.Ребенок			КАК Ребенок,
	|	ТЧ.Договор			КАК Договор,
	|	ТЧ.СтавкаОплаты		КАК СтавкаОплаты,
	|	ТЧ.Льгота			КАК Льгота,
	|	ТЧ.ДатаВключения	КАК ДатаВключения
	|ПОМЕСТИТЬ
	|	ТаблЧасть_РодительскаяПлата
	|ИЗ
	|	&ТЧ	КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Количество дублей целых строк
	|//		(Номера одинаковых строк)
	|ВЫБРАТЬ
	|	// Все поля, по которым ищем дубли:
	|	Ребенок,
	|	Договор,
	|	
	|	КОЛИЧЕСТВО(НомерСтроки)	КАК КолвоДублей
	|ПОМЕСТИТЬ
	|	ВТ_КолвоДублейСтрок
	|ИЗ
	|	ТаблЧасть_РодительскаяПлата	КАК РодительскаяПлата
	|ГДЕ
	|	НЕ Ребенок = ЗНАЧЕНИЕ(Справочник.Дети.ПустаяСсылка)
	|	И НЕ Договор = ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО
	|	// Все поля, по которым ищем дубли:
	|	Ребенок,
	|	Договор
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(НомерСтроки) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Номера одинаковых строк
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	РодительскаяПлата.НомерСтроки	КАК НомерСтроки
	|ИЗ
	|	ВТ_КолвоДублейСтрок	КАК КолвоДублейСтрок
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ТаблЧасть_РодительскаяПлата	КАК РодительскаяПлата
	|		// Все поля, по которым ищем дубли:
	|		ПО	КолвоДублейСтрок.Ребенок = РодительскаяПлата.Ребенок
	|		И	КолвоДублейСтрок.Договор = РодительскаяПлата.Договор
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ
	|	МИНИМУМ(РодительскаяПлата.НомерСтроки)
	|ПО
	|	РодительскаяПлата.Ребенок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. (Подготовка) Указанные в документе контрагенты и договоры
	|// 		(Поиск уже введенных остатков на счетах по указанным детям и договорам)
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки			КАК НомерСтроки,
	|	Ребенок				КАК Ребенок,
	|	Ребенок.Контрагент	КАК Контрагент,
	|	Договор				КАК Договор
	|ПОМЕСТИТЬ
	|	ВТ_КонтрагентыДоговоры
	|ИЗ
	|	ТаблЧасть_РодительскаяПлата
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент,
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. (Подготовка) Уже введенные остатки по указанным детям и договорам
	|// 		(Поиск уже введенных остатков на счетах по указанным детям и договорам)
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Контрагенты) ТОГДА
	|			Субконто1
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Контрагенты) ТОГДА
	|			Субконто2
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Контрагенты) ТОГДА
	|			Субконто3
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ							КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Договоры) ТОГДА
	|			Субконто1
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Договоры) ТОГДА
	|			Субконто2
	|		КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Договоры) ТОГДА
	|			Субконто3
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ							КАК Договор
	|ПОМЕСТИТЬ
	|	ВТ_ВсеОстатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ТекДата,
	|		Счет.Ссылка В ИЕРАРХИИ (&Счет),
	|		,
	|		Организация = &Организация
	|		
	|		И ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Контрагенты) ТОГДА
	|				Субконто1 В (ВЫБРАТЬ Контрагент ИЗ ВТ_КонтрагентыДоговоры)
	|			КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Контрагенты) ТОГДА
	|				Субконто2 В (ВЫБРАТЬ Контрагент ИЗ ВТ_КонтрагентыДоговоры)
	|			КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Контрагенты) ТОГДА
	|				Субконто3 В (ВЫБРАТЬ Контрагент ИЗ ВТ_КонтрагентыДоговоры)
	|			ИНАЧЕ
	|				Ложь
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.Договоры) ТОГДА
	|				Субконто1 В (ВЫБРАТЬ Договор ИЗ ВТ_КонтрагентыДоговоры)
	|			КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.Договоры) ТОГДА
	|				Субконто2 В (ВЫБРАТЬ Договор ИЗ ВТ_КонтрагентыДоговоры)
	|			КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.Договоры) ТОГДА
	|				Субконто3 В (ВЫБРАТЬ Договор ИЗ ВТ_КонтрагентыДоговоры)
	|			ИНАЧЕ
	|				Ложь
	|		КОНЕЦ
	|		
	|		// Учет функциональных опций:
	|		И ВЫБОР
	|			КОГДА &Подразделение = НЕОПРЕДЕЛЕНО ТОГДА
	|				ИСТИНА
	|			ИНАЧЕ
	|				Подразделение = &Подразделение
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИФО = НЕОПРЕДЕЛЕНО ТОГДА
	|				ИСТИНА
	|			ИНАЧЕ
	|				ИФО = &ИФО
	|		КОНЕЦ
	|	) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Поиск уже введенных остатков на счетах по указанным детям и договорам
	|// 		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	ВТ_КонтрагентыДоговоры.НомерСтроки	КАК НомерСтроки
	|ИЗ
	|	ВТ_ВсеОстатки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ВТ_КонтрагентыДоговоры
	|		ПО	ВТ_ВсеОстатки.Контрагент = ВТ_КонтрагентыДоговоры.Контрагент
	|		И	ВТ_ВсеОстатки.Договор = ВТ_КонтрагентыДоговоры.Договор
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_КонтрагентыДоговоры.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [6]. (Подготовка) Количество различных значений в используемых колонках.
	|// 		(Различающиеся сведения об одном и том же ребенке)
	|ВЫБРАТЬ
	|	Ребенок								КАК Ребенок,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СтавкаОплаты)	КАК КоличествоРазличныхСтавкаОплаты,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Льгота)		КАК КоличествоРазличныхЛьгота,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДатаВключения)	КАК КоличествоРазличныхДатаВключения
	|ПОМЕСТИТЬ
	|	ВТ_КоличествоРазличныхЗначений
	|ИЗ
	|	ТаблЧасть_РодительскаяПлата
	|СГРУППИРОВАТЬ ПО
	|	Ребенок
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СтавкаОплаты) > 1
	|	ИЛИ	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Льгота) > 1
	|	ИЛИ	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДатаВключения) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [7]. (Подготовка) Определяем наиболее разнообразно-заполненные колонки.
	|// 		(Различающиеся сведения об одном и том же ребенке)
	|ВЫБРАТЬ
	|	Ребенок	КАК Ребенок,
	|	ВЫБОР
	|		КОГДА КоличествоРазличныхСтавкаОплаты >= КоличествоРазличныхЛьгота
	|			И КоличествоРазличныхСтавкаОплаты >= КоличествоРазличныхДатаВключения
	|			ТОГДА
	|			""СтавкаОплаты""
	|		КОГДА КоличествоРазличныхЛьгота >= КоличествоРазличныхСтавкаОплаты
	|			И КоличествоРазличныхЛьгота >= КоличествоРазличныхДатаВключения
	|			ТОГДА
	|			""Льгота""
	|		КОГДА КоличествоРазличныхДатаВключения >= КоличествоРазличныхСтавкаОплаты
	|			И КоличествоРазличныхДатаВключения >= КоличествоРазличныхЛьгота
	|			ТОГДА
	|			""ДатаВключения""
	|	КОНЕЦ	КАК ИмяПоляСМаксимальнымКоличествомРазличныхЗначений
	|ПОМЕСТИТЬ
	|	ВТ_РазличающиесяСведенияОдногоРебенка
	|ИЗ
	|	ВТ_КоличествоРазличныхЗначений
	|ИНДЕКСИРОВАТЬ ПО
	|	Ребенок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [8]. Различающиеся сведения об одном и том же ребенке
	|// 		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	ТЧ.НомерСтроки															КАК НомерСтроки,
	|	РазличающиесяСведения.ИмяПоляСМаксимальнымКоличествомРазличныхЗначений	КАК ИмяПоляДляВыводаСообщений
	|ИЗ
	|	ТаблЧасть_РодительскаяПлата	КАК ТЧ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ВТ_РазличающиесяСведенияОдногоРебенка	КАК РазличающиесяСведения
	|		ПО	ТЧ.Ребенок = РазличающиесяСведения.Ребенок
	|УПОРЯДОЧИТЬ ПО
	|	ТЧ.НомерСтроки
	|ИТОГИ
	|	МИНИМУМ(ТЧ.НомерСтроки)																КАК НомерСтроки,
	|	МАКСИМУМ(РазличающиесяСведения.ИмяПоляСМаксимальнымКоличествомРазличныхЗначений)	КАК ИмяПоляДляВыводаСообщений
	|ПО
	|	ТЧ.Ребенок
	|;";

	// Выполняем запросы:
	РезультатыПроверок = ЗапросПроверка.ВыполнитьПакет();
	
	// Выводим сообщения:
	ИмяТаблЧастиДляВыводаСообщений = "РодительскаяПлата";
	
	//	[2]			Дубли строк по колонкам Ребенок, Договор
	РезультатПроверки = РезультатыПроверок[2];
	ИмяПоляДляВыводаСообщений = "Ребенок";
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		ДЗРезультат = РезультатПроверки.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		Для Каждого СтрокаИтого Из ДЗРезультат.Строки Цикл
			Текст = НСтр("ru='Дубли строк по ребенку и договору (таблица ""Родительская плата"", строки %1)'");
			
			НомераСтрок = СтрокаИтого.Строки.ВыгрузитьКолонку("НомерСтроки");
			ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(Текст, НомераСтрок, МаксДлинаСообщения, "%1");
			
			ИндексСтроки = НомераСтрок[0] - 1;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
		КонецЦикла;
	КонецЕсли;
	
	//	[5]			Уже введенные остатки по ребенку и договору
	РезультатПроверки = РезультатыПроверок[5];
	ИмяПоляДляВыводаСообщений = "Ребенок";
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		ТЗРезультат = РезультатПроверки.Выгрузить();
		Для Каждого СтрокаТЗ Из ТЗРезультат Цикл
			Текст = НСтр("ru='Уже введены начальные остатки по ребенку и договору (таблица ""Родительская плата"", строка %1)'");
			
			НомерСтроки = СтрокаТЗ["НомерСтроки"];
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, НомерСтроки);
			
			ИндексСтроки = НомерСтроки - 1;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
		КонецЦикла;
	КонецЕсли;
	
	//	Дополнительные проверки, выполняемые если установлен флаг ""Включать детей в группу"":
	Если ПринятьДетейВГруппу Тогда
		//	[8]		Различающиеся сведения об одном и том же ребенке
		//				(колонки СтавкаОплаты, Льгота, ДатаВключения)
		РезультатПроверки = РезультатыПроверок[8];
		Если НЕ РезультатПроверки.Пустой() Тогда
			ЕстьОшибкиЗаполнения = Истина;
			ДЗРезультат = РезультатПроверки.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
			Для Каждого СтрокаИтого Из ДЗРезультат.Строки Цикл
				Текст = НСтр("ru='Для одного ребенка указаны различающиеся значения в колонках ""Прием ребенка в группу"" (таблица ""Родительская плата"", строки %1)'");
				
				НомераСтрок = СтрокаИтого.Строки.ВыгрузитьКолонку("НомерСтроки");
				ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(Текст, НомераСтрок, МаксДлинаСообщения, "%1");
				
				ИндексСтроки = СтрокаИтого["НомерСтроки"] - 1;
				
				ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
				
				ИмяПоляДляВыводаСообщений = СтрокаИтого["ИмяПоляДляВыводаСообщений"];
				ОбщегоНазначения.СообщитьПользователю(
					ТекстСообщения,
					ДокументОбъект["Ссылка"],
					"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Функция Печать_РодительскаяПлата_Ведомость(МассивОбъектов, ОбъектыПечати)
	
	// Возвращаемый табличный документ:
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.ИмяПараметровПечати = "ВводНачальныхОстатковПоРодительскойПлате_Ведомость";
	ТабДокумент.АвтоМасштаб = Истина;
	
	// Используемый макет:
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ВводНачальныхОстатков.ПФ_MXL_РодительскаяПлата_Ведомость");
	
	// Настраиваем запрос:
	ЗапросПечать = Новый Запрос();
	ЗапросПечать.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ЗапросПечать.УстановитьПараметр("РазделУчета", Перечисления.РазделыУчетаДляВводаОстатков.РодительскаяПлата);
	
	ЗапросПечать.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Шапки документов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка							КАК ДокСсылка,
	|	Номер							КАК Номер,
	|	Дата							КАК Дата,
	|	Организация.НаименованиеПолное	КАК НаименованиеОрганизации,
	|	Организация.ИНН					КАК ИНН,
	|	Организация.КПП					КАК КПП,
	|	НаправлениеДеятельности			КАК НаправлениеДеятельности,
	|	ГруппаДетскогоУчреждения		КАК ГруппаДетскогоУчреждения
	|ИЗ
	|	Документ.ВводНачальныхОстатков	КАК Док
	|ГДЕ
	|	Ссылка В (&МассивОбъектов)
	|	И РазделУчета = &РазделУчета
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Табличные части документов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка					КАК ДокСсылка,
	|	НомерСтроки				КАК НомерСтроки,
	|	Ребенок.Представление	КАК Имя,
	|	Ребенок.Код				КАК ЛицевойСчет,
	|	Договор					КАК Договор,
	|	СтавкаОплаты			КАК СтавкаОплаты,
	|	Задолженность			КАК Задолженность,
	|	Переплата				КАК Переплата
	|ИЗ
	|	Документ.ВводНачальныхОстатков.РодительскаяПлата	КАК ТЧ
	|ГДЕ
	|	Ссылка В (&МассивОбъектов)
	|	И Ссылка.РазделУчета = &РазделУчета
	|УПОРЯДОЧИТЬ ПО
	|	ДокСсылка,
	|	НомерСтроки
	|ИТОГИ
	|	ЕСТЬNULL(СУММА(Задолженность), 0)	КАК Задолженность,
	|	ЕСТЬNULL(СУММА(Переплата), 0)		КАК Переплата
	|ПО
	|	// Обязательно первые итоги по ссылке на документ:
	|	ДокСсылка
	|;";
	
	РезультатПечать = ЗапросПечать.ВыполнитьПакет();
	
	ВыборкаШапка		= РезультатПечать[0].Выбрать();
	ВыборкаДокТаблица	= РезультатПечать[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Выборки по документам:
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		// Используемые области макета:
		ОбластьЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
		ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока		= Макет.ПолучитьОбласть("Строка");
		ОбластьИтого		= Макет.ПолучитьОбласть("Итого");
		
		// Продвигаемся в остальных выборках до текущего документа:
		ПоискТекущегоДокумента = Новый Структура("ДокСсылка", ВыборкаШапка["ДокСсылка"]);
		ВыборкаДокТаблица.Сбросить();
		ЕстьВыборкаДокТаблица	= ВыборкаДокТаблица.НайтиСледующий(ПоискТекущегоДокумента);
		
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		НомерСтраницы  = 1;
		
		//---
		// Заголовок
		//---
		// Заполняем значения параметров выводимой области:
		ЗначенияПараметров = Новый Структура("ДатаПрописью", Формат(ВыборкаШапка.Дата, "ДЛФ=DD"));
		ОбластьЗаголовок.Параметры.Заполнить(ВыборкаШапка);
		ОбластьЗаголовок.Параметры.Заполнить(ЗначенияПараметров);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(
			ОбластьЗаголовок,
			"Номер",
			ВыборкаШапка.Номер,
			ВыборкаШапка.ДокСсылка,
			Неопределено,
			Истина);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьЗаголовок);
		
		//---
		// Таблица документа
		//---
		ТабДокумент.Вывести(ОбластьШапка);
		
		Если ЕстьВыборкаДокТаблица Тогда
			
			ВыборкаТаблица = ВыборкаДокТаблица.Выбрать();
			Пока ВыборкаТаблица.Следующий() Цикл
				//---
				// Строка
				//---
				// Заполняем значения параметров выводимой области:
				ОбластьСтрока.Параметры.Заполнить(ВыборкаТаблица);
				//ЗначенияПараметров = Новый Структура("СтавкаОплаты", "представление ставки оплаты");
				//ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);
				// Выводим область:
				ТабДокумент.Вывести(ОбластьСтрока);
			КонецЦикла;
			
		КонецЕсли;
		
		//---
		// Итого
		//---
		// Заполняем значения параметров выводимой области:
		ОбластьИтого.Параметры.Заполнить(ВыборкаДокТаблица);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьИтого);
		
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.ДокСсылка);
	
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура Заполнить_СпискомДетейИзУказанойГруппы_РодительскаяПлата(ДокументОбъект) Экспорт
	
	// Настраиваем запрос:
	ЗапросТаблица = Новый Запрос();
	ЗапросТаблица.УстановитьПараметр("Организация",					ДокументОбъект["Организация"]);
	ЗапросТаблица.УстановитьПараметр("Дата",						ДокументОбъект["Дата"]);
	ЗапросТаблица.УстановитьПараметр("ГруппаДетскогоУчреждения",	ДокументОбъект["ГруппаДетскогоУчреждения"]);
	ЗапросТаблица.УстановитьПараметр("ЭтоОсновнаяГруппа",			(ДокументОбъект["РодительскаяПлатаДопУслуги"] = ЛОЖЬ));
	ЗапросТаблица.УстановитьПараметр("ПустаяДата",					'00010101');
	ЗапросТаблица.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Все необходимые сведения о детях, кроме договора
	|//		(Заполнение списком детей)
	|//
	|// Поиск в основных группах:
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Дети.Ссылка										КАК Ребенок,
	|	Дети.Контрагент									КАК Контрагент,
	|	СоставГрупп.СтавкаОплаты						КАК СтавкаОплаты,
	|	СоставГрупп.Льгота								КАК Льгота,
	|	СоставГрупп.Период								КАК ДатаВключения,
	|	&ПустаяДата										КАК ДатаВыбытия
	|ПОМЕСТИТЬ
	|	ВТ_Дети
	|ИЗ
	|	Справочник.Дети	КАК Дети
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	РегистрСведений.СоставГруппДДУ	КАК СоставГрупп
	|		ПО	Дети.Ссылка = СоставГрупп.Ребенок
	|		И	СоставГрупп.ГруппаДетскогоУчреждения = &ГруппаДетскогоУчреждения
	|ГДЕ
	|	&ЭтоОсновнаяГруппа
	|	И	Дети.ПометкаУдаления = ЛОЖЬ
	|	И	Дети.ЭтоГруппа = ЛОЖЬ
	|	И	Дети.ДатаВыбытия = &ПустаяДата
	|	И	Дети.Организация = &Организация
	|	И	СоставГрупп.Период <= &Дата // выбираем ребенка, только если он еще не выбыл из группы
	|
	|ОБЪЕДИНИТЬ
	|
	|// Поиск в дополнительных группах:
	|ВЫБРАТЬ
	|	Дети.Ссылка										КАК Ребенок,
	|	Дети.Контрагент									КАК Контрагент,
	|	СоставГруппДДУДополнительныеУслуги.СтавкаОплаты	КАК СтавкаОплаты,
	|	СоставГруппДДУДополнительныеУслуги.Льгота		КАК Льгота,
	|	СоставГруппДДУДополнительныеУслуги.Период		КАК ДатаВключения,
	|	&ПустаяДата										КАК ДатаВыбытия
	|ИЗ
	|	Справочник.Дети	КАК Дети
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	РегистрСведений.СоставГруппДДУДополнительныеУслуги	КАК СоставГруппДДУДополнительныеУслуги
	|		ПО	Дети.Ссылка = СоставГруппДДУДополнительныеУслуги.Ребенок
	|		И	СоставГруппДДУДополнительныеУслуги.ГруппаДетскогоУчреждения = &ГруппаДетскогоУчреждения
	|ГДЕ
	|	НЕ &ЭтоОсновнаяГруппа
	|	И	Дети.ПометкаУдаления = ЛОЖЬ
	|	И	Дети.ЭтоГруппа = ЛОЖЬ
	|	И	Дети.ДатаВыбытия = &ПустаяДата
	|	И	Дети.Организация = &Организация
	|	И	СоставГруппДДУДополнительныеУслуги.Период <= &Дата // выбираем ребенка, только если он еще не выбыл из группы
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Единственные договоры уже выбранных детей
	|//		(Заполнение списком детей)
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Договоры.Контрагент			КАК Контрагент,
	|	МАКСИМУМ(Договоры.Ссылка)	КАК Договор
	|ПОМЕСТИТЬ
	|	ВТ_Договоры
	|ИЗ
	|	ВТ_Дети	КАК Дети
	|	ЛЕВОЕ СОЕДИНЕНИЕ	Справочник.Договоры КАК Договоры
	|		ПО	Дети.Контрагент = Договоры.Контрагент
	|ГДЕ
	|	Договоры.ПометкаУдаления = ЛОЖЬ
	|	И Договоры.Организация = &Организация
	|СГРУППИРОВАТЬ ПО
	|	Договоры.Контрагент
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(Договоры.Ссылка) = 1
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Заполнение списком детей
	|//		(Финальная таблица для вывода результата)
	|//
	|ВЫБРАТЬ
	|	Дети.Ребенок		КАК Ребенок,
	|	Дети.СтавкаОплаты	КАК СтавкаОплаты,
	|	Дети.Льгота			КАК Льгота,
	|	Дети.ДатаВключения	КАК ДатаВключения,
	|	Дети.ДатаВыбытия	КАК ДатаВыбытия,
	|	Договоры.Договор	КАК Договор
	|ИЗ
	|	ВТ_Дети	КАК Дети
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ВТ_Договоры	КАК Договоры
	|		ПО Дети.Контрагент = Договоры.Контрагент
	|;";
	
	// Выполняем запрос:
	ТЗ = ЗапросТаблица.Выполнить().Выгрузить();
	
	ДокументОбъект["РодительскаяПлата"].Загрузить(ТЗ);
	
КонецПроцедуры

Процедура Заполнить_СпискомДетейЕщеНеЗачисленныхВГруппы_РодительскаяПлата(ДокументОбъект) Экспорт
	
	// Настраиваем запрос:
	ЗапросТаблица = Новый Запрос();
	ЗапросТаблица.УстановитьПараметр("Организация",					ДокументОбъект["Организация"]);
	ЗапросТаблица.УстановитьПараметр("Дата",						ДокументОбъект["Дата"]);
	ЗапросТаблица.УстановитьПараметр("ЭтоОсновнаяГруппа",			(ДокументОбъект["РодительскаяПлатаДопУслуги"] = ЛОЖЬ));
	ЗапросТаблица.УстановитьПараметр("ПустаяДата",					'00010101');
	ЗапросТаблица.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Дети, уже зачисленные хотя бы в одну группу.
	|//		(Заполнение списком детей)
	|//
	|// Поиск в основных группах:
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Дети.Ссылка			КАК Ребенок
	|ПОМЕСТИТЬ
	|	ВТ_ДетиЗачисленныеВГруппы
	|ИЗ
	|	Справочник.Дети	КАК Дети
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	РегистрСведений.СоставГруппДДУ	КАК СоставГрупп
	|		ПО	Дети.Ссылка = СоставГрупп.Ребенок
	|ГДЕ
	|	&ЭтоОсновнаяГруппа
	|	И	Дети.ПометкаУдаления = ЛОЖЬ
	|	И	Дети.ЭтоГруппа = ЛОЖЬ
	|	И	Дети.Организация = &Организация
	|	И	Дети.ДатаВыбытия = &ПустаяДата
	|	И	СоставГрупп.Период <= &Дата // выбираем ребенка, только если он еще не выбыл из группы
	|
	|ОБЪЕДИНИТЬ
	|
	|// Поиск в дополнительных группах:
	|ВЫБРАТЬ
	|	Дети.Ссылка			КАК Ребенок
	|ИЗ
	|	Справочник.Дети	КАК Дети
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	РегистрСведений.СоставГруппДДУДополнительныеУслуги	КАК СоставГруппДДУДополнительныеУслуги
	|		ПО	Дети.Ссылка = СоставГруппДДУДополнительныеУслуги.Ребенок
	|ГДЕ
	|	НЕ &ЭтоОсновнаяГруппа
	|	И	Дети.ПометкаУдаления = ЛОЖЬ
	|	И	Дети.ЭтоГруппа = ЛОЖЬ
	|	И	Дети.Организация = &Организация
	|	И	Дети.ДатаВыбытия = &ПустаяДата
	|	И	СоставГруппДДУДополнительныеУслуги.Период <= &Дата // выбираем ребенка, только если он еще не выбыл из группы
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ребенок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Все необходимые сведения о детях, кроме договора
	|//		(Заполнение списком детей)
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Дети.Ссылка										КАК Ребенок,
	|	Дети.Контрагент									КАК Контрагент
	|ПОМЕСТИТЬ
	|	ВТ_Дети
	|ИЗ
	|	Справочник.Дети	КАК Дети
	|ГДЕ
	|	Дети.ПометкаУдаления = ЛОЖЬ
	|	И	Дети.ЭтоГруппа = ЛОЖЬ
	|	И	Дети.Организация = &Организация
	|	И	НЕ Ссылка В(ВЫБРАТЬ Ребенок ИЗ ВТ_ДетиЗачисленныеВГруппы)
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. (Подготовка) Единственные договоры уже выбранных детей
	|//		(Заполнение списком детей)
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Договоры.Контрагент			КАК Контрагент,
	|	МАКСИМУМ(Договоры.Ссылка)	КАК Договор
	|ПОМЕСТИТЬ
	|	ВТ_Договоры
	|ИЗ
	|	ВТ_Дети	КАК Дети
	|	ЛЕВОЕ СОЕДИНЕНИЕ	Справочник.Договоры КАК Договоры
	|		ПО	Дети.Контрагент = Договоры.Контрагент
	|ГДЕ
	|	Договоры.ПометкаУдаления = ЛОЖЬ
	|	И Договоры.Организация = &Организация
	|СГРУППИРОВАТЬ ПО
	|	Договоры.Контрагент
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(Договоры.Ссылка) = 1
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Заполнение списком детей
	|//		(Финальная таблица для вывода результата)
	|//
	|ВЫБРАТЬ
	|	Дети.Ребенок		КАК Ребенок,
	|	Дети.Контрагент		КАК Контрагент,
	|	Договоры.Договор	КАК Договор
	|ИЗ
	|	ВТ_Дети	КАК Дети
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ВТ_Договоры	КАК Договоры
	|		ПО Дети.Контрагент = Договоры.Контрагент
	|;";
	
	// Выполняем запрос:
	ТЗ = ЗапросТаблица.Выполнить().Выгрузить();
	
	ДокументОбъект["РодительскаяПлата"].Загрузить(ТЗ);
	
КонецПроцедуры

Процедура Заполнить_СпискомВсехДетей_РодительскаяПлата(ДокументОбъект) Экспорт
	
	// Настраиваем запрос:
	ЗапросТаблица = Новый Запрос();
	ЗапросТаблица.УстановитьПараметр("Организация",					ДокументОбъект["Организация"]);
	ЗапросТаблица.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Все необходимые сведения о детях, кроме договора
	|//		(Заполнение списком детей)
