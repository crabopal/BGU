	Результат.Колонки.Добавить("ПолноеИмя",		Новый ОписаниеТипов("Строка"));
	Для Каждого СтрокаТЗ Из Результат Цикл
		ТаблЧасть = СтрокаТЗ["ТаблЧасть"];
		СтрокаТЗ["Элемент"] = ТаблЧасть + СтрокаТЗ["Поле"];
		СтрокаТЗ["ПолноеИмя"] = ?(ЗначениеЗаполнено(ТаблЧасть),
			ТаблЧасть + ".",
			"")
			+ СтрокаТЗ["Поле"];
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает признак корректности установленного режима вв.ост., а также РезультатПроверки.
Функция РежимВводаОстатков_ПроверитьЗаполнение(ДокументСсылка, РезультатПроверки = Неопределено) Экспорт
	
	// Исходные проверяемые данные:
	ШапкаДокумента = РежимВводаОстатков_СтруктураШапкиДокумента();
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументСсылка);
	// Заменяем дату:
	ШапкаДокумента.Вставить("Дата", ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(ДокументСсылка["Дата"]));
	
	РезультатПроверки = Неопределено;
	
	Возврат РежимВводаОстатков_ПроверитьЗаполнение_Служебный(ШапкаДокумента, РезультатПроверки);
	
КонецФункции

// Служебный метод. Проверяет корректность установки флажков "Режим ввода остатков"
// на соответствие учетной политике и остальным реквизитам документа.
Функция РежимВводаОстатков_ПроверитьЗаполнение_Служебный(Параметры, РезультатПроверки = Неопределено)
	
	Перем КодОшибки;
	
	// Диагностируемые ошибки:
	//	- ОрганизацияНеЗаполнена
	//	- ОбаФлагаНеУстановлены
	//	- НалоговыйУчетНеВедется
	//	- НалоговыйУчетПоКФОНеВедется
	//	- НалоговыйУчетНаЗабалансовыхСчетахНеВедется
	//	(только имущество казны):
	//	- УчетИмуществаКазныНеВедется
	//	- ПланСчетовНеЗадан
	//	- ПланСчетовНеКазенный
	
	// Возвращаемое значение:
	РезультатПроверки = Новый Структура("
		|ВсеОшибки,
		|КодОшибки,
		|ТекстСообщения,
		|ИмяПоляДляВыводаСообщения,
		|Кэш,
		|ПрименяемыйРежимВводаОстатков");
		
	// Обнаруженные ошибки:
	ТЗОшибки = Новый ТаблицаЗначений();
	КС50 = Новый КвалификаторыСтроки(50);
	ВремМассив = Новый Массив;
	ВремМассив.Добавить(Тип("Строка"));
	ОписаниеТиповСтрока50 = Новый ОписаниеТипов(ВремМассив, , КС50);
	ТЗОшибки.Колонки.Добавить("КодОшибки",					ОписаниеТиповСтрока50);
	ТЗОшибки.Колонки.Добавить("ТекстСообщения",				Новый ОписаниеТипов("Строка"));
	ТЗОшибки.Колонки.Добавить("ИмяПоляДляВыводаСообщения",	ОписаниеТиповСтрока50);
	
	// Входная проверка:
	РезультатПроверки.Вставить("ВсеОшибки",					ТЗОшибки);
	РезультатПроверки.Вставить("КодОшибки",					"");
	РезультатПроверки.Вставить("ТекстСообщения",			"");
	РезультатПроверки.Вставить("ИмяПоляДляВыводаСообщения",	"");
	РезультатПроверки.Вставить("Кэш",						Новый Структура());
	Если НЕ ТипЗнч(Параметры) = Тип("Структура") Тогда
		// Выходим:
		ТекстСообщения = НСтр("ru='Не переданы обязательные параметры для проверки'");
		Возврат Ложь;
	КонецЕсли;
	
	// Исходные данные:
	Организация					= Параметры["Организация"];
	Дата						= Параметры["Дата"];
	ДатаПредставление			= Формат(Дата, "ДЛФ=Д");
	РазделУчета					= Параметры["РазделУчета"];
	Счет						= Параметры["Счет"];
	ОтражатьВБухгалтерскомУчете	= Параметры["ОтражатьВБухгалтерскомУчете"];
	ОтражатьВНалоговомУчете		= Параметры["ОтражатьВНалоговомУчете"];
	
	Это_ИмуществоКазны		= (РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны
								ИЛИ РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазныМЗ);
	Это_ОсновныеСредства	= (РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства);
	Это_Материалы			= (РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Материалы);
	Это_Счет106хП			= (РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПоСчету106хП);
	
	// Применяемый режим (инициализация):
	ПрименяемыйРежимВводаОстатков = Новый Структура;
	ПрименяемыйРежимВводаОстатков.Вставить("ОтражатьВБухУчете",		ОтражатьВБухгалтерскомУчете);
	ПрименяемыйРежимВводаОстатков.Вставить("ОтражатьВНалУчетеОСН",	Ложь);
	ПрименяемыйРежимВводаОстатков.Вставить("ОтражатьВНалУчетеУСН",	Ложь);
	
	// Кэшируем параметры учетной политики.
	РезультатПроверки["Кэш"].Вставить("ВедетсяНалоговыйУчетПоКФО",			Ложь);
	РезультатПроверки["Кэш"].Вставить("ПлательщикНалогаНаПрибыль",			Ложь);
	РезультатПроверки["Кэш"].Вставить("ПрименяетсяУСНДоходы",				Ложь);
	РезультатПроверки["Кэш"].Вставить("ПрименяетсяУСНДоходыМинусРасходы",	Ложь);
	
	Если Это_ИмуществоКазны Тогда
		// Для имущества казны проверяем только учетную политику.
		
		ПараметрыУчетаИК = ПолучитьПараметрыУчетаИмуществаКазныНаДату(Параметры);
		Если ПараметрыУчетаИК["ВестиУчетИмуществаКазны"] Тогда
			// В программе ведется учет имущества казны.
			// Применим учетную политику организации.
			
			Если ЗначениеЗаполнено(Организация) Тогда
				ТипПланаСчетов = ПараметрыУчетаИК["УП_ТипПланаСчетов"];
				
				Если НЕ ЗначениеЗаполнено(ТипПланаСчетов) Тогда
					КодОшибки = "ПланСчетовНеЗадан";
					Текст = НСтр("ru='Не указан используемый план счетов (см. учетную политику организации на дату %1).
						|Документ предназначен для работы только при использовании казенного плана счетов.'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ДатаПредставление);
					ИмяПоляДляВыводаСообщения = "Объект.Организация";
					
					НС = ТЗОшибки.Добавить(); НС["КодОшибки"] = КодОшибки; НС["ТекстСообщения"] = ТекстСообщения; НС["ИмяПоляДляВыводаСообщения"] = ИмяПоляДляВыводаСообщения;
					
				ИначеЕсли НЕ ТипПланаСчетов = Перечисления.ТипыПлановСчетов.ДляКазенных Тогда
					КодОшибки = "ПланСчетовНеКазенный";
					ТипПланаСчетов = НРег(Строка(ТипПланаСчетов)) + НСтр("ru=' учреждений'");
					Текст = НСтр("ru='Используется план счетов %2 (см. учетную политику организации на дату %1).
						|Документ предназначен для работы только при использовании казенного плана счетов.'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ДатаПредставление, ТипПланаСчетов);
					ИмяПоляДляВыводаСообщения = "Объект.Организация";
					
					НС = ТЗОшибки.Добавить(); НС["КодОшибки"] = КодОшибки; НС["ТекстСообщения"] = ТекстСообщения; НС["ИмяПоляДляВыводаСообщения"] = ИмяПоляДляВыводаСообщения;
					
				КонецЕсли;
				
			Иначе
				КодОшибки = "ОрганизацияНеЗаполнена";
				ТекстСообщения = НСтр("ru='Организация не выбрана. Укажите организацию, использующую план счетов для казенных учреждений.'");
				ИмяПоляДляВыводаСообщения = "Объект.Организация";
				
				НС = ТЗОшибки.Добавить(); НС["КодОшибки"] = КодОшибки; НС["ТекстСообщения"] = ТекстСообщения; НС["ИмяПоляДляВыводаСообщения"] = ИмяПоляДляВыводаСообщения;
				
			КонецЕсли;
			
		Иначе
			// В программе не ведется учет имущества казны.
			
			КодОшибки = "УчетИмуществаКазныНеВедется";
			ТекстСообщения = НСтр("ru='В программе не ведется учет имущества казны. Документ не предназначен для работы в таком режиме.'");
			ИмяПоляДляВыводаСообщения = "";
			
			НС = ТЗОшибки.Добавить(); НС["КодОшибки"] = КодОшибки; НС["ТекстСообщения"] = ТекстСообщения; НС["ИмяПоляДляВыводаСообщения"] = ИмяПоляДляВыводаСообщения;
		КонецЕсли;
		
		// Кэшируем полученные параметры учетной политики:
		Для Каждого Элем Из ПараметрыУчетаИК Цикл
			РезультатПроверки["Кэш"].Вставить(Элем.Ключ, Элем.Значение);
		КонецЦикла;
		
	Иначе
		// Для всех остальных операций проверяем режим ввода остатков.
		
		Если ЗначениеЗаполнено(Организация) Тогда
			
			Если Это_Материалы Тогда
				СчетЗабалансовый = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "Забалансовый");
				ОсобыеСчета10500 = Параметры["ОсобыеСчета10500"];
			ИначеЕсли Это_ОсновныеСредства ИЛИ Это_Счет106хП Тогда
				КФО = Параметры["КФО"];
			КонецЕсли;
			
			ПлательщикНалогаНаПрибыль        = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Организация, Дата);
			ПрименяетсяУСНДоходы             = УчетУСНВызовСервера.ПрименяетсяУСНДоходы(Организация, Дата);
			ПрименяетсяУСНДоходыМинусРасходы = УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Организация, Дата);
			
			Если НЕ ОтражатьВБухгалтерскомУчете И НЕ ОтражатьВНалоговомУчете Тогда
				
				КодОшибки = "ОбаФлагаНеУстановлены";
				ТекстСообщения = НСтр("ru='Режим ввода остатков установлен некорректно.
					|Необходимо установить отражение документа хотя бы по одному виду учета.'");
				ИмяПоляДляВыводаСообщения = "Объект.ОтражатьВБухгалтерскомУчете";
				
				НС = ТЗОшибки.Добавить(); НС["КодОшибки"] = КодОшибки; НС["ТекстСообщения"] = ТекстСообщения; НС["ИмяПоляДляВыводаСообщения"] = ИмяПоляДляВыводаСообщения;
				
			ИначеЕсли ОтражатьВНалоговомУчете Тогда
				
				Если ПлательщикНалогаНаПрибыль ИЛИ ПрименяетсяУСНДоходыМинусРасходы Тогда
					
					Если Это_Материалы Тогда
						ВедетсяНалоговыйУчетПоКФО = Истина; // КФО находится в таб.части.
					ИначеЕсли ПлательщикНалогаНаПрибыль Тогда
						ВедетсяНалоговыйУчетПоКФО = НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(КФО);
					ИначеЕсли ПрименяетсяУСНДоходыМинусРасходы Тогда
						ВедетсяНалоговыйУчетПоКФО = УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(КФО);
					Иначе
						ВедетсяНалоговыйУчетПоКФО = Ложь;
					КонецЕсли;
					
					Если НЕ ВедетсяНалоговыйУчетПоКФО Тогда
						
						КодОшибки = "НалоговыйУчетПоКФОНеВедется";
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru='Налоговый учет по КФО %1 не ведется.'"),
								КФО);
						ИмяПоляДляВыводаСообщения = "Объект.ОтражатьВНалоговомУчете";
						
						НС = ТЗОшибки.Добавить(); НС["КодОшибки"] = КодОшибки; НС["ТекстСообщения"] = ТекстСообщения; НС["ИмяПоляДляВыводаСообщения"] = ИмяПоляДляВыводаСообщения;
						
					КонецЕсли;
					
					Если Это_Материалы Тогда
						
						Если СчетЗабалансовый Тогда
							
							КодОшибки = "НалоговыйУчетНаЗабалансовыхСчетахНеВедется";
							ТекстСообщения = НСтр("ru='Остатки материальных запасов на забалансовых счетах не нужно отражать в налоговом учете.'");
							ИмяПоляДляВыводаСообщения = "Объект.ОтражатьВНалоговомУчете";
							
							НС = ТЗОшибки.Добавить(); НС["КодОшибки"] = КодОшибки; НС["ТекстСообщения"] = ТекстСообщения; НС["ИмяПоляДляВыводаСообщения"] = ИмяПоляДляВыводаСообщения;
							
						КонецЕсли;
						
					КонецЕсли;
					
					ПрименяемыйРежимВводаОстатков.Вставить("ОтражатьВНалУчетеОСН",	ПлательщикНалогаНаПрибыль И ВедетсяНалоговыйУчетПоКФО);
					ПрименяемыйРежимВводаОстатков.Вставить("ОтражатьВНалУчетеУСН",	ПрименяетсяУСНДоходыМинусРасходы И ВедетсяНалоговыйУчетПоКФО);
					
					РезультатПроверки["Кэш"].Вставить("ВедетсяНалоговыйУчетПоКФО",			ВедетсяНалоговыйУчетПоКФО);
					РезультатПроверки["Кэш"].Вставить("ПлательщикНалогаНаПрибыль",			ПлательщикНалогаНаПрибыль);
					РезультатПроверки["Кэш"].Вставить("ПрименяетсяУСНДоходы",				ПрименяетсяУСНДоходы);
					РезультатПроверки["Кэш"].Вставить("ПрименяетсяУСНДоходыМинусРасходы",	ПрименяетсяУСНДоходыМинусРасходы);
					
				Иначе
					
					КодОшибки = "НалоговыйУчетНеВедется";
					
					Если Это_ОсновныеСредства Тогда
						ТекстРазделУчета = НСтр("ru=' по основным средствам'");
					ИначеЕсли Это_Материалы Тогда
						ТекстРазделУчета = НСтр("ru=' по материальным запасам'");
					ИначеЕсли Это_Счет106хП Тогда
						ТекстРазделУчета = НСтр("ru=' по вложениям в материальные запасы'");
					Иначе
						ТекстРазделУчета = НСтр("ru=''");
					КонецЕсли;
					
					Если ПрименяетсяУСНДоходы Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru='Организация применяет УСН с объектом налогообложения ""Доходы"" (см. учетную политику на дату %1).
							|В этом случае начальные остатки%2 для целей налогового учета не вводятся.'"),
								ДатаПредставление,
								ТекстРазделУчета)
					Иначе
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru='Организация не ведет налоговый учет по общей или упрощенной системе налогообложения (см. учетную политику на дату %1).
							|В этом случае начальные остатки%2 для целей налогового учета не вводятся.'"),
								ДатаПредставление,
								ТекстРазделУчета)
					КонецЕсли;
					ИмяПоляДляВыводаСообщения = "Объект.ОтражатьВНалоговомУчете";
					
					НС = ТЗОшибки.Добавить(); НС["КодОшибки"] = КодОшибки; НС["ТекстСообщения"] = ТекстСообщения; НС["ИмяПоляДляВыводаСообщения"] = ИмяПоляДляВыводаСообщения;
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			КодОшибки = "ОрганизацияНеЗаполнена";
			ТекстСообщения = НСтр("ru='Поле ""Организация"" не заполнено.'");
			ИмяПоляДляВыводаСообщения = "Объект.Организация";
			
			НС = ТЗОшибки.Добавить(); НС["КодОшибки"] = КодОшибки; НС["ТекстСообщения"] = ТекстСообщения; НС["ИмяПоляДляВыводаСообщения"] = ИмяПоляДляВыводаСообщения;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТЗОшибки.Количество() > 0 Тогда
		РезультатПроверки.Вставить("ВсеОшибки",	ТЗОшибки);
		
		Ошибка0 = ТЗОшибки[0];
		РезультатПроверки.Вставить("КодОшибки",					Ошибка0["КодОшибки"]);
		РезультатПроверки.Вставить("ТекстСообщения",			Ошибка0["ТекстСообщения"]);
		РезультатПроверки.Вставить("ИмяПоляДляВыводаСообщения",	Ошибка0["ИмяПоляДляВыводаСообщения"]);
	КонецЕсли;
	
	РезультатПроверки.Вставить("ПрименяемыйРежимВводаОстатков", ПрименяемыйРежимВводаОстатков);
	
	Возврат НЕ ЗначениеЗаполнено(КодОшибки);
	
КонецФункции

Функция РежимВводаОстатков_ОбработкаПроверкиЗаполнения(ДокументОбъект, РезультатПроверки = Неопределено)
	
	ДокСсылка	= ДокументОбъект["Ссылка"];
	
	
	ШапкаДокумента = РежимВводаОстатков_СтруктураШапкиДокумента();
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);
	
	// Корректность текущих флажков "Режим ввода остатков":
	Если НЕ РежимВводаОстатков_ПроверитьЗаполнение(ШапкаДокумента, РезультатПроверки) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			РезультатПроверки["ТекстСообщения"],
			ДокСсылка,
			РезультатПроверки["ИмяПоляДляВыводаСообщения"]);
		
		ТекстСообщения = НСтр("ru='Дальнейшие обязательные проверки данных документа не выполнялись'");
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			ДокСсылка);
		
		// Выходим:
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

//---
// Механизм отбора строк табличной части (v2)
//---

Функция ОтборСтрок_ИменаИспользуемыхТабличныхЧастей(ДокументОбъект) Экспорт
	
	ИменаТЧ = Новый Массив();
	
	РазделУчета	= ДокументОбъект["РазделУчета"];
	
	Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства Тогда
		ИменаТЧ.Добавить("КапРемонтОС");
		ИменаТЧ.Добавить("МодернизацияОС");
		ИменаТЧ.Добавить("ПереоценкаНФА");
		
	ИначеЕсли	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете
			ИЛИ	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе
			Тогда
		ИменаТЧ.Добавить("КапРемонтОС");
		
	КонецЕсли;
	
	Возврат ИменаТЧ;
	
КонецФункции

Функция ОтборСтрок_ИменаКолонокТабличныхЧастей() Экспорт
	
	ТабличныеЧасти = Новый Структура();
	
	ИменаКолонок = Новый Структура();
	//						Реквизит механизма	Колонка таблицы
	ИменаКолонок.Вставить(	"ОС",				"ОС");
	ИменаКолонок.Вставить(	"ИнвНомер",			"ИнвНомер");
	ТабличныеЧасти.Вставить("КапРемонтОС",		ИменаКолонок);
	
	ИменаКолонок = Новый Структура();
	ИменаКолонок.Вставить(	"ОС",				"ОС");
	ИменаКолонок.Вставить(	"ИнвНомер",			"ИнвНомер");
	ТабличныеЧасти.Вставить("МодернизацияОС",	ИменаКолонок);
	
	ИменаКолонок = Новый Структура();
	ИменаКолонок.Вставить(	"ОС",				"НФА");
	ТабличныеЧасти.Вставить("ПереоценкаНФА",	ИменаКолонок);
	
	Возврат ТабличныеЧасти;
	
КонецФункции

Функция ОтборСтрок_ПрочитатьРеквизитыОтбора(ДокументОбъект) Экспорт
	
	РеквизитыОтбора = Новый Структура();
	РеквизитыОтбора.Вставить("ОС",			ДокументОбъект["ОтборСтрокОС"]);
	РеквизитыОтбора.Вставить("ИнвНомер",	ДокументОбъект["ОтборСтрокИнвНомер"]);
	
	Возврат РеквизитыОтбора;
	
КонецФункции

Функция ОтборСтрок_ПолучитьДействующийОтбор(ДокументОбъект, РеквизитыОтбора = Неопределено) Экспорт
	
	Если РеквизитыОтбора = Неопределено Тогда
		РеквизитыОтбора = ОтборСтрок_ПрочитатьРеквизитыОтбора(ДокументОбъект);
	КонецЕсли;
	
	// Оставляем только заполненные реквизиты отбора
	ЗаполненныеРеквизитыОтбора = Новый Структура();
	Для Каждого ЭлементОтбора Из РеквизитыОтбора Цикл
		ИмяРеквизита		= ЭлементОтбора.Ключ;
		ЗначениеРеквизита	= ЭлементОтбора.Значение;
		Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			ЗаполненныеРеквизитыОтбора.Вставить(ИмяРеквизита, ЗначениеРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	// Получаем отбор в терминах колонок табличных частей
	ДействующийОтбор	= Новый Структура();
	ИменаТаблЧастей		= ОтборСтрок_ИменаИспользуемыхТабличныхЧастей(ДокументОбъект);
	ИменаКолонок		= ОтборСтрок_ИменаКолонокТабличныхЧастей();
	Для Каждого ИмяТаблЧасти Из ИменаТаблЧастей Цикл
		ДействующийОтборТаблЧасти = Новый Структура();
		Для Каждого ЭлементОтбора Из ЗаполненныеРеквизитыОтбора Цикл
			ИмяРеквизитаМеханизма = ЭлементОтбора.Ключ;
			РеквизитаМеханизмаИспользуется = ИменаКолонок[ИмяТаблЧасти].Свойство(ИмяРеквизитаМеханизма);
			Если РеквизитаМеханизмаИспользуется Тогда
				ИмяКолонкиТаблЧасти = ИменаКолонок[ИмяТаблЧасти][ИмяРеквизитаМеханизма];
				ДействующийОтборТаблЧасти.Вставить(ИмяКолонкиТаблЧасти, ЭлементОтбора.Значение);
			КонецЕсли;
		КонецЦикла;
		
		ДействующийОтбор.Вставить(ИмяТаблЧасти, ДействующийОтборТаблЧасти);
	КонецЦикла;
	
	Возврат ДействующийОтбор;
	
КонецФункции

Функция ОтборСтрок_ЗаполнитьТаблицыОтборов(ДокументОбъект) Экспорт
	
	Перем ЕстьНеотображаемыеСтроки;
	
	НаличиеНеотображаемыхСтрок = Новый Структура();
	
	ИменаТаблЧастей		= ОтборСтрок_ИменаИспользуемыхТабличныхЧастей(ДокументОбъект);
	ДействующийОтбор	= ОтборСтрок_ПолучитьДействующийОтбор(ДокументОбъект);
	
	Для Каждого ИмяТаблЧасти Из ИменаТаблЧастей Цикл
		ДействующийОтборТаблЧасти = ДействующийОтбор[ИмяТаблЧасти];
		
		ОтборСтрок_ПрочитатьИзОбщейТабличнойЧастиВОтбор(ДокументОбъект, ИмяТаблЧасти, ДействующийОтборТаблЧасти, ЕстьНеотображаемыеСтроки);
		
		НаличиеНеотображаемыхСтрок.Вставить(ИмяТаблЧасти, ЕстьНеотображаемыеСтроки);
	КонецЦикла;
	
	Возврат НаличиеНеотображаемыхСтрок;
	
КонецФункции

Функция ОтборСтрок_ОбработатьИзменениеОтбора(ДокументОбъект, ОтборПрежний, ОтборНовый) Экспорт
	
	Перем ЕстьНеотображаемыеСтроки;
	
	Результат = Новый Структура();
	
	НаличиеНеотображаемыхСтрок	= Новый Структура();
	ВидимостьКолонок			= Новый Структура();
	
	ИменаТаблЧастей			= ОтборСтрок_ИменаИспользуемыхТабличныхЧастей(ДокументОбъект);
	ИменаКолонок			= ОтборСтрок_ИменаКолонокТабличныхЧастей();
	ДействующийОтборПрежний	= ОтборСтрок_ПолучитьДействующийОтбор(ДокументОбъект, ОтборПрежний);
	ДействующийОтборНовый	= ОтборСтрок_ПолучитьДействующийОтбор(ДокументОбъект, ОтборНовый);
	
	Для Каждого ИмяТаблЧасти Из ИменаТаблЧастей Цикл
		ИмяТаблЧастиОтбор		= ИмяТаблЧасти + "Отбор";
		ОбщаяТаблЧасть			= ДокументОбъект[ИмяТаблЧасти];
		ТаблЧастьОтбор			= ДокументОбъект[ИмяТаблЧастиОтбор];
		ИменаКолонокТаблЧасти	= ИменаКолонок[ИмяТаблЧасти];
		
		ДействующийОтборТаблЧастиПрежний	= ДействующийОтборПрежний[ИмяТаблЧасти];
		ДействующийОтборТаблЧастиНовый		= ДействующийОтборНовый[ИмяТаблЧасти];
		
		// Записываем в общую таблицу из таблицы прежнего отбора
		ОтборСтрок_ЗаписатьВОбщуюТабличнуюЧастьИзОтбора(ОбщаяТаблЧасть, ТаблЧастьОтбор, ДействующийОтборТаблЧастиПрежний);
		
		// Читаем из общей таблицы по новому отбору
		ОтборСтрок_ПрочитатьИзОбщейТабличнойЧастиВОтбор(ДокументОбъект, ИмяТаблЧасти, ДействующийОтборТаблЧастиНовый, ЕстьНеотображаемыеСтроки);
		
		НаличиеНеотображаемыхСтрок.Вставить(ИмяТаблЧасти, ЕстьНеотображаемыеСтроки);
		
		// Определяем видимость колонок в таблицах отбора.
		// Если поле отбора установлено, то колонка скрыта.
		Для Каждого Элем Из ОтборНовый Цикл
			ИмяРеквизитаМеханизма	= Элем.Ключ;
			РеквизитаМеханизмаИспользуется = ИменаКолонокТаблЧасти.Свойство(ИмяРеквизитаМеханизма);
			Если РеквизитаМеханизмаИспользуется Тогда
				ИмяКолонкиТаблЧасти		= ИменаКолонокТаблЧасти[ИмяРеквизитаМеханизма];
				ИмяЭлементаКолонки		= ИмяТаблЧастиОтбор + ИмяКолонкиТаблЧасти;
				ПолеОтбораУстановлено	= ЗначениеЗаполнено(Элем.Значение);
				
				ВидимостьКолонок.Вставить(ИмяЭлементаКолонки, НЕ ПолеОтбораУстановлено);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("НаличиеНеотображаемыхСтрок",	НаличиеНеотображаемыхСтрок);
	Результат.Вставить("ВидимостьКолонок",				ВидимостьКолонок);
	
	Возврат Результат;
	
КонецФункции

Процедура ОтборСтрок_ОбработатьРеквизитыПередЗаписью(ДокументОбъект) Экспорт
	
	Перем ОтборСтрокУстановлен;
	
	РеквизитыУжеОбработаны = ДокументОбъект.ДополнительныеСвойства.Свойство("ОтборСтрокУстановлен");
	
	Если РеквизитыУжеОбработаны Тогда
		// Возникает при проведении из формы, а реквизиты уже были обработаны ранее в проверке заполнения
		Возврат;
	КонецЕсли;
	
	ИменаТаблЧастей			= ОтборСтрок_ИменаИспользуемыхТабличныхЧастей(ДокументОбъект);
	ДействующийОтбор		= ОтборСтрок_ПолучитьДействующийОтбор(ДокументОбъект);
	ОтборСтрокУстановлен	= Новый Структура();
	
	Для Каждого ИмяТаблЧасти Из ИменаТаблЧастей Цикл
		ОбщаяТаблЧасть = ДокументОбъект[ИмяТаблЧасти];
		ТаблЧастьОтбор = ДокументОбъект[ИмяТаблЧасти + "Отбор"];
		
		ДействующийОтборТаблЧасти = ДействующийОтбор[ИмяТаблЧасти];
		
		ОтборСтрок_ЗаписатьВОбщуюТабличнуюЧастьИзОтбора(ОбщаяТаблЧасть, ТаблЧастьОтбор, ДействующийОтборТаблЧасти);
			
		ОтборСтрокТаблЧастиУстановлен = НЕ (ОбщаяТаблЧасть.Количество() = ТаблЧастьОтбор.Количество());
		
		ТаблЧастьОтбор.Очистить();
		
		ОтборСтрокУстановлен.Вставить(ИмяТаблЧасти, ОтборСтрокТаблЧастиУстановлен);
	КонецЦикла;
	
	// Очищаем несохраняемые реквизиты механизма
	ДокументОбъект["ОтборСтрокОС"]					= Неопределено;
	ДокументОбъект["ОтборСтрокИнвНомер"]			= Неопределено;
	ДокументОбъект["ОтборСтрокУстанавливатьОтбор"]	= Неопределено;
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("ОтборСтрокУстановлен", ОтборСтрокУстановлен);
	
КонецПроцедуры

Процедура ОтборСтрок_НастроитьФормуПоРезультатамОтбора(Форма, НаличиеНеотображаемыхСтрок, ВидимостьКолонок = Неопределено) Экспорт
	
	Для Каждого Элем Из НаличиеНеотображаемыхСтрок Цикл
		ИмяТаблЧасти				= Элем.Ключ;
		ЕстьНеотображаемыеСтроки	= Элем.Значение;
		
		// Кнопка "Есть скрытые строки"
		ИмяКнопки = ИмяТаблЧасти + "ОтборОчиститьОтборСтрок";
		Форма.Элементы[ИмяКнопки].Видимость	= ЕстьНеотображаемыеСтроки;
		
		// Признак наличия скрытых строк
		ИмяРеквизита = "ОтборСтрок_ЕстьНеотображаемыеСтроки_" + ИмяТаблЧасти;
		Форма[ИмяРеквизита] = ЕстьНеотображаемыеСтроки;
		
		// Картинка шапки колонки N
		ИмяЭлементаКолонки			= ИмяТаблЧасти + "ОтборНомерСтроки";
		Если ЕстьНеотображаемыеСтроки Тогда
			КартинкаКолонки				= БиблиотекаКартинок.ПрименитьПравилаОбработкиПисем;
			ЦветФонаЗаголовкаКолонки	= ЦветаСтиля.ЦветФонаВыделения;
		Иначе
			КартинкаКолонки				= Новый Картинка();
			ЦветФонаЗаголовкаКолонки	= Новый Цвет();
		КонецЕсли;
		Форма.Элементы[ИмяЭлементаКолонки].КартинкаШапки		= КартинкаКолонки;
		Форма.Элементы[ИмяЭлементаКолонки].ЦветФонаЗаголовка	= ЦветФонаЗаголовкаКолонки;
	КонецЦикла;
	
	Если НЕ ВидимостьКолонок = Неопределено Тогда
		Для Каждого Элем Из ВидимостьКолонок Цикл
			Форма.Элементы[Элем.Ключ].Видимость = Элем.Значение;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтборСтрок_ПрочитатьИзОбщейТабличнойЧастиВОтбор(ДокументОбъект, ИмяТаблЧасти, ДействующийОтбор, ВозвратЕстьНеотображаемыеСтроки)
	
	ИмяТаблЧастиОтбор	= ИмяТаблЧасти + "Отбор";
	ОбщаяТаблЧасть		= ДокументОбъект[ИмяТаблЧасти];
	ТаблЧастьОтбор		= ДокументОбъект[ИмяТаблЧастиОтбор];
	
	ТЗОтбор = ОбщаяТаблЧасть.Выгрузить(ДействующийОтбор);
	ТаблЧастьОтбор.Загрузить(ТЗОтбор);
	
	ВозвратЕстьНеотображаемыеСтроки = (ОбщаяТаблЧасть.Количество() > ТЗОтбор.Количество());
	
КонецПроцедуры

Процедура ОтборСтрок_ЗаписатьВОбщуюТабличнуюЧастьИзОтбора(ОбщаяТаблЧасть, ТаблЧастьОтбор, ДействующийОтбор)
	
	// Очищаем все строки общей табл.части, соответствующие указанному отбору
	Если ДействующийОтбор.Количество() > 0 Тогда
		СтрокиТЧ = ОбщаяТаблЧасть.НайтиСтроки(ДействующийОтбор);
		Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
			ОбщаяТаблЧасть.Удалить(СтрокаТЧ);
		КонецЦикла;
	КонецЕсли;
	
	// Добавляем все строки из табл.части отбора в общую табл.часть
	Если ДействующийОтбор.Количество() > 0 Тогда
		// Если задан отбор, то соответствующие поля добавляемых строк устанавливаем по отбору
		
		Для Каждого СтрокаТЧОтбор Из ТаблЧастьОтбор Цикл
			СтрокаОбщейТЧ = ОбщаяТаблЧасть.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОбщейТЧ, СтрокаТЧОтбор);
			ЗаполнитьЗначенияСвойств(СтрокаОбщейТЧ, ДействующийОтбор);
		КонецЦикла;
		
		// Сортировать по ОС, ИнвНомер
		КолонкиСортировки = "";
		Для Каждого ЭлемОтбора Из ДействующийОтбор Цикл
			КолонкиСортировки = КолонкиСортировки
				+ ?(КолонкиСортировки = "", "", ", ")
				+ ЭлемОтбора.Ключ;
		КонецЦикла;
		ОбщаяТаблЧасть.Сортировать(КолонкиСортировки);
		
	Иначе
		// Если отбор не задан, то загружаем табличную часть целиком
		
		ОбщаяТаблЧасть.Загрузить(ТаблЧастьОтбор.Выгрузить());
	КонецЕсли;
	
КонецПроцедуры

