	|	ВЫБРАТЬ
	|		*
	|	ИЗ
	|		ПоляУчетнойПолитики)	КАК ВложенныйЗапрос
	|СГРУППИРОВАТЬ ПО
	|	ТаблЧасть,
	|	Поле
	|;";
	
	РезультатыПоиска = ЗапросПоля.ВыполнитьПакет();
	
	// Получим искомые строки общей таблицы:
	Если ТолькоНеиспользуемые Тогда
		Результат = РезультатыПоиска[1].Выгрузить();
	Иначе
		Результат = РезультатыПоиска[4].Выгрузить();
	КонецЕсли;
	
	// Дополним результат дополнительной служебной информацией:
