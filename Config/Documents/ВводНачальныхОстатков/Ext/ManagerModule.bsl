// Заполняет новую добавленную колонку СчетНУ в документах "Ввод остатков" (материалы и 106.хП)
Процедура ПриОбновлении_2_0_9_7_МатериалыИСчет106хП_ЗаполнитьСчетНУ() Экспорт
	
	Попытка
		ОбъектМетаданных	= Метаданные.Документы.ВводНачальныхОстатков;
		РазделУчетаМатериалы= Перечисления.РазделыУчетаДляВводаОстатков.Материалы;
		РазделУчетаСчет106хП= Перечисления.РазделыУчетаДляВводаОстатков.ПоСчету106хП;
		
		// Сведения для вывода в журнал регистрации:
		ИмяСобытия			= НСтр("ru='Данные. Изменение'");
		КомментарийОК 		= НСтр("ru='Групповая обработка документов ""Ввод начальных остатков"": успешно обработано документов: '");
		КомментарийОшибка	= НСтр("ru='Ошибка при групповой обработке документов ""Ввод начальных остатков"": '");
		
		// Получим список документов, которые необходимо обработать:
		ЗапросДокументы = Новый Запрос();
		ЗапросДокументы.УстановитьПараметр("РазделУчетаМатериалы", РазделУчетаМатериалы);
		ЗапросДокументы.УстановитьПараметр("РазделУчетаСчет106хП", РазделУчетаСчет106хП);
		ЗапросДокументы.Текст = "
		|////////////////////////////////////////////////////////////////////////////////
		|// [0]. Документы ""Ввод остатков материалов"" и номера строк табл.части ""Материалы""
		|//		(для дальнейшей обработки)
		|ВЫБРАТЬ
		|	ТЗ.Ссылка		КАК ДокСсылка,
		|	ТЗ.Счет			КАК Счет,
		|	ТЗ.НомерСтроки	КАК НомерСтроки
		|ИЗ
		|	Документ.ВводНачальныхОстатков.Материалы	КАК ТЗ
		|ГДЕ
		|	ТЗ.Ссылка.РазделУчета = &РазделУчетаМатериалы
		|	И	ТЗ.Ссылка.ОтражатьВНалоговомУчете = ИСТИНА
		|	И	ТЗ.СчетНУ = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
		|ИТОГИ
		|ПО
		|	ДокСсылка	
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// [1]. Документы ""Ввод остатков по счету 106.хП""
		|//		и номера строк каждой из 2 используемых табл.частей.
		|//		(для дальнейшей обработки)
		|// Номера строк табл.части ""Материалы106хП"":
		|ВЫБРАТЬ
		|	ТЗ.Ссылка		КАК ДокСсылка,
		|	1				КАК НомерТабличнойЧасти,
		|	ТЗ.Счет			КАК Счет,
		|	ТЗ.НомерСтроки	КАК НомерСтроки
		|ИЗ
		|	Документ.ВводНачальныхОстатков.Материалы106хП	КАК ТЗ
		|ГДЕ
		|	ТЗ.Ссылка.РазделУчета = &РазделУчетаСчет106хП
		|	И	ТЗ.Ссылка.ОтражатьВНалоговомУчете = ИСТИНА
		|	И	ТЗ.СчетНУ = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|// Номера строк табл.части ""Затраты106хП"":
		|ВЫБРАТЬ
		|	ТЗ.Ссылка		КАК ДокСсылка,
		|	2				КАК НомерТабличнойЧасти,
		|	ТЗ.Счет			КАК Счет,
		|	ТЗ.НомерСтроки	КАК НомерСтроки
		|ИЗ
		|	Документ.ВводНачальныхОстатков.Затраты106хП	КАК ТЗ
		|ГДЕ
		|	ТЗ.Ссылка.РазделУчета = &РазделУчетаСчет106хП
		|	И	ТЗ.Ссылка.ОтражатьВНалоговомУчете = ИСТИНА
		|	И	ТЗ.СчетНУ = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
		|ИТОГИ
		|ПО
		|	ДокСсылка	
		|;";
		
		РезультатыПоиска = ЗапросДокументы.ВыполнитьПакет();
		
		// Обрабатываем найденные документы.
		КолвоДок = 0;
		
		// [0]. Документы ""Ввод остатков материалов""
		ДЗРезультат = РезультатыПоиска[0].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		КолвоДок = КолвоДок + ДЗРезультат.Строки.Количество();
		ИмяТаблЧасти = "Материалы";
		Для Каждого СтрокаИтого Из ДЗРезультат.Строки Цикл // по документам
			ДокОбъект = СтрокаИтого["ДокСсылка"].ПолучитьОбъект();
			ТаблЧасть = ДокОбъект[ИмяТаблЧасти];
			
			// Заполняем поле СчетНУ:
			Для Каждого ВремСтрока Из СтрокаИтого.Строки Цикл
				ИндексСтрокиТЧ = ВремСтрока["НомерСтроки"] - 1;
				ТаблЧасть[ИндексСтрокиТЧ]["СчетНУ"] = БухгалтерскиеОперации.ПолучитьСчетНУпоСчетуБУ(ВремСтрока["Счет"]);
			КонецЦикла;
			
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЦикла;
		
		// [1]. Документы ""Ввод остатков по счету 106.хП""
		ДЗРезультат = РезультатыПоиска[1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		КолвоДок = КолвоДок + ДЗРезультат.Строки.Количество();
		Для Каждого СтрокаИтого Из ДЗРезультат.Строки Цикл // по документам
			ДокОбъект = СтрокаИтого["ДокСсылка"].ПолучитьОбъект();
			
			// Заполняем поле СчетНУ:
			Для Каждого ВремСтрока Из СтрокаИтого.Строки Цикл
				Если ВремСтрока["НомерТабличнойЧасти"] = 1 Тогда
					ИмяТаблЧасти = "Материалы106хП";
				Иначе
					ИмяТаблЧасти = "Затраты106хП";
				КонецЕсли;
				
				ИндексСтрокиТЧ = ВремСтрока["НомерСтроки"] - 1;
				ДокОбъект[ИмяТаблЧасти][ИндексСтрокиТЧ]["СчетНУ"] = БухгалтерскиеОперации.ПолучитьСчетНУпоСчетуБУ(ВремСтрока["Счет"]);
			КонецЦикла;
			
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЦикла;
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			ОбъектМетаданных,						// объект метаданных
			,										// данные
			КомментарийОК + КолвоДок);				// комментарий
		
	Исключение
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,							// имя события
			УровеньЖурналаРегистрации.Ошибка,	// уровень
			ОбъектМетаданных,					// объект метаданных
			,									// данные
			КомментарийОшибка + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	// комментарий
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

