		|	Материалы.КЭК								КАК КЭКДт,
		|	ВЫБОР
		|		КОГДА НомераСубконто.НомерВидаСубконтоПартии = 1 ТОГДА
		|			&ДокСсылка
		|		КОГДА НомераСубконто.НомерВидаСубконтоНоменклатура = 1 ТОГДА
		|			Материалы.Номенклатура
		|		КОГДА НомераСубконто.НомерВидаСубконтоВидыЗатрат = 1 ТОГДА
		|			Затраты.ВидЗатрат
		|	КОНЕЦ										КАК СубконтоДт1,
		|	ВЫБОР
		|		КОГДА НомераСубконто.НомерВидаСубконтоПартии = 2 ТОГДА
		|			&ДокСсылка
		|		КОГДА НомераСубконто.НомерВидаСубконтоНоменклатура = 2 ТОГДА
		|			Материалы.Номенклатура
		|		КОГДА НомераСубконто.НомерВидаСубконтоВидыЗатрат = 2 ТОГДА
		|			Затраты.ВидЗатрат
		|	КОНЕЦ										КАК СубконтоДт2,
		|	ВЫБОР
		|		КОГДА НомераСубконто.НомерВидаСубконтоПартии = 3 ТОГДА
		|			&ДокСсылка
		|		КОГДА НомераСубконто.НомерВидаСубконтоНоменклатура = 3 ТОГДА
		|			Материалы.Номенклатура
		|		КОГДА НомераСубконто.НомерВидаСубконтоВидыЗатрат = 3 ТОГДА
		|			Затраты.ВидЗатрат
		|	КОНЕЦ										КАК СубконтоДт3,
		|	
		|	// Устанавливаем поле ""Количество"" только для первых строк зависимой таблицы ""Затраты"":
		|	ВЫБОР
		|		КОГДА НомераПервыхСтрок.НомерСтроки ЕСТЬ NULL ТОГДА
		|			0
		|		ИНАЧЕ
		|			Материалы.Количество			
		|	КОНЕЦ										КАК КоличествоДт,
		|	&ШапкаДокумента_ПодразделениеОрганизации	КАК ПодразделениеДт,
		|
		|	// Кредит:
		|	&Счет000									КАК СчетКт,
		|
		|	Затраты.Сумма								КАК Сумма,
		|	&Содержание									КАК Содержание,
		|	&ШапкаДокумента_ВидПервичногоДокумента		КАК ВидПервичногоДокумента,
		|	&ШапкаДокумента_ДатаПервичногоДокумента		КАК ДатаПервичногоДокумента,
		|	&ШапкаДокумента_НомерПервичногоДокумента	КАК НомерПервичногоДокумента
		|
		|ИЗ
		|	ТаблЧастьМатериалы106хП КАК Материалы
		|	ЛЕВОЕ СОЕДИНЕНИЕ ТаблЧастьЗатраты106хП КАК Затраты
		|		// Поля связи:
		|		ПО	Материалы.Номенклатура = Затраты.Номенклатура
		|		И	Материалы.Счет = Затраты.Счет
		|		И	Материалы.КПС = Затраты.КПС
		|		// Требование заполненных значений:
		|		И	НЕ (Затраты.Сумма = 0)
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	НомераВидовСубконто_СчетаБУ	КАК НомераСубконто
		|		ПО	Материалы.Счет = НомераСубконто.Счет
		|	ЛЕВОЕ СОЕДИНЕНИЕ	ТаблЧастьЗатраты106хП_НомераПервыхСтрок	КАК НомераПервыхСтрок
		|		ПО	Затраты.НомерСтроки = НомераПервыхСтрок.НомерСтроки
		|УПОРЯДОЧИТЬ ПО
		|	Материалы.НомерСтроки
		|;";
	КонецЕсли;
	
	Если ОтражатьВНалоговомУчетеОСН Тогда
		// Сначала подготовим таблицу соответствия счетов БУ и НУ, используемых в документе.
		// 1) Используемые счета БУ:
		ЗапросПоиск = Новый Запрос();
		ЗапросПоиск.УстановитьПараметр("ДокСсылка", ДокументОбъект.Ссылка);
		ЗапросПоиск.Текст = "
		|////////////////////////////////////////////////////////////////////////////////
		|// [б-]. (Подготовка) Используемые счета БУ.
		|//		Используется для предварительного определения соответствующих счетов НУ.
		|//		(Движения по вводу остатков, налоговый учет ОСН)
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Счет	КАК СчетБУ
		|ИЗ
		|	Документ.ВводНачальныхОстатков.Материалы106хП	КАК Материалы106хП
		|ГДЕ
		|	Ссылка = &ДокСсылка
		|;";
		ТЗСчета = ЗапросПоиск.Выполнить().Выгрузить();
		// 2) Соответствующие им счета НУ:
		ТЗСчета.Колонки.Добавить("СчетНУ", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		Для Каждого СтрокаТЗ Из ТЗСчета Цикл
			СтрокаТЗ["СчетНУ"] = НалоговыйУчетКлиентСервер.СчетНУпоСчетуБУ(СтрокаТЗ["СчетБУ"], ДокументОбъект.Дата);
		КонецЦикла;
		
		ЗапросДвижения.УстановитьПараметр("ТЗСчета", ТЗСчета);
		
		
		ИндексРезультата_НалУчетОСН = ИндексРезультата_База + 2; // индекс результата
		ИндексРезультата_База = ИндексРезультата_База + 3; // количество подзапросов
		
		ТекстЗапроса = ТекстЗапроса + "
		|//------------------------------------------------------------------------------
		|// б) Налоговый учет ""ОСН""
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// [б0]. (Подготовка) Соответствие используемых счетов БУ и НУ.
		|//		(Движения по вводу остатков, налоговый учет ОСН)
		|ВЫБРАТЬ
		|	ТЗ.СчетБУ	КАК СчетБУ,
		|	ТЗ.СчетНУ	КАК СчетНУ
		|ПОМЕСТИТЬ
		|	СоответствиеСчетов
		|ИЗ
		|	&ТЗСчета	КАК ТЗ
		|;	
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// [б1]. (Подготовка) Реальные номера условных видов субконто используемых счетов НУ.
		|//		(Движения по вводу остатков, налоговый учет ОСН)
		|//
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоответствиеСчетов.СчетНУ 	КАК Счет,
		|	
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА ВидыСубконто.ВидСубконто = &ВидСубконтоПартии ТОГДА
		|			ВидыСубконто.НомерСтроки
		|		ИНАЧЕ
		|			НЕОПРЕДЕЛЕНО
		|	КОНЕЦ)						КАК НомерВидаСубконтоПартии,
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА ВидыСубконто.ВидСубконто = &ВидСубконтоНоменклатура ТОГДА
		|			ВидыСубконто.НомерСтроки
		|		ИНАЧЕ
		|			НЕОПРЕДЕЛЕНО
		|	КОНЕЦ)						КАК НомерВидаСубконтоНоменклатура,
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА ВидыСубконто.ВидСубконто = &ВидСубконтоВидыЗатрат ТОГДА
		|			ВидыСубконто.НомерСтроки
