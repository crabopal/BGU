Функция ОпределитьСчетДляШапкиДокумента_ПраваПользования(ДокументОбъект) Экспорт
	
	// -------------------------------------------------------------
	// Показатель	Если во всех строках табличной части указано...
	//				Одинаковое значение		Различные значения
	// -------------------------------------------------------------
	// Счет			из табличной части		ближайший общий родитель
	// КФО			из табличной части		пустая ссылка
	// КПС			из табличной части		пустая ссылка
	
	Если ТипЗнч(ДокументОбъект["ПраваПользования"]) = Тип("ТаблицаЗначений") Тогда
		ТаблицаПраваПользования = ДокументОбъект["ПраваПользования"];
	Иначе
		ТаблицаПраваПользования = ДокументОбъект["ПраваПользования"].Выгрузить();
	КонецЕсли;
		
	
	//
	// Счет
	//
	СписокСчетов = ТаблицаПраваПользования.ВыгрузитьКолонку("СчетУчета");
	
	СтатистикаСчетов = ПолучитьСтатистикуСчетовПоУровнямИерархии(СписокСчетов);
	
	МаксимальныйУровеньСчета = СтатистикаСчетов["МаксимальныйУровеньСчета"];
	
	Итоги = СтатистикаСчетов["Итоги"];
	
	Счет = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	
	Для Счетчик = 1 По МаксимальныйУровеньСчета Цикл
		
		ПроверяемыйУровеньСтрокой = Строка(МаксимальныйУровеньСчета - Счетчик + 1);
		
		КолвоРазличных = Итоги["КоличествоРазличных" + ПроверяемыйУровеньСтрокой];
		
		Если КолвоРазличных = 1 Тогда
			Счет = Итоги["ПроизвольнаяСсылка" + ПроверяемыйУровеньСтрокой];
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	//
	// КФО, КПС
	//
	ВремТаблица = ТаблицаПраваПользования.Скопировать(,"КФО,КПС");
	
	ВремТаблицаКФО = ВремТаблица.Скопировать(,"КФО");
	ВремТаблицаКФО.Свернуть("КФО");
	Если ВремТаблицаКФО.Количество() = 1 Тогда
		КФО = ВремТаблицаКФО[0]["КФО"];
	Иначе
		КФО = Перечисления.КВД.ПустаяСсылка();
	КонецЕсли;
	
	ВремТаблицаКПС = ВремТаблица.Скопировать(,"КПС");
	ВремТаблицаКПС.Свернуть("КПС");
	Если ВремТаблицаКПС.Количество() = 1 Тогда
		КПС = ВремТаблицаКПС[0]["КПС"];
	Иначе
		КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	КонецЕсли;
	
	СчетДляШапкиДокумента = Новый Структура();
	СчетДляШапкиДокумента.Вставить("Счет",	Счет);
	СчетДляШапкиДокумента.Вставить("КФО",	КФО);
	СчетДляШапкиДокумента.Вставить("КПС",	КПС);
	
	Возврат СчетДляШапкиДокумента;
	
КонецФункции

// Возвращаемое значение:
//	Неопределено	- если невозможно определить общие параметры,
//					  т.к. в табличной части строки заполнены различным способом,
//					  а не одним общим;
//	<Структура>		- если удалось определить общие параметры, или таблица пустая.
Функция ПолучитьОбщиеПараметрыНачисленияАмортизации(ДокументОбъект) Экспорт
	
	ИменаПолей = ПолучитьИменаПараметровАмортизацииПоДоговоруВЦелом();
	
	Источник = ДокументОбъект.ПраваПользования;
	
	Если ТипЗнч(Источник) = Тип("ТаблицаЗначений") Тогда
		
		ВременнаяТаблица = Источник.Скопировать(, ИменаПолей);
		
	Иначе
		
		ВременнаяТаблица = Источник.Выгрузить(, ИменаПолей);
		
	КонецЕсли;
	
	ВременнаяТаблица.Свернуть(ИменаПолей);
	
	ОбщиеПараметры = Неопределено;
	
	Если ВременнаяТаблица.Количество() <= 1 Тогда
		
		ОбщиеПараметры = Новый Структура(ИменаПолей);
		
		Если ВременнаяТаблица.Количество() = 1 Тогда
			
			ЗаполнитьЗначенияСвойств(ОбщиеПараметры, ВременнаяТаблица[0]);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОбщиеПараметры;
	
КонецФункции

Функция ПолучитьИменаПараметровАмортизацииПоДоговоруВЦелом() Экспорт
	
	Возврат "СпособПризнанияРасходов,"
		+ "ДатаНачалаАмортизации,"
		+ "ДатаОкончанияАмортизации,"
		+ "СчетРасходов,"
		+ "КПСРасходов,"
		+ "КЭКРасходов,"
		+ "ПодразделениеРасходов,"
		+ "СубконтоРасходов1,"
		+ "СубконтоРасходов2,"
		+ "СубконтоРасходов3,"
		+ "СтатьяПрочихРасходовНУ";
	
КонецФункции

