КонецПроцедуры

Процедура НастроитьФормуДокументаДляУстаревшегоРазделаУчета(Форма) Экспорт
	
	ДокументОбъект = Форма.Объект;
	
	ДанныеПеренесеныИзДокумента = НЕ ДокументОбъект.Проведен;
	
	РазделУчета = ДокументОбъект["РазделУчета"];
	
	РазделУчетаУстарел = ВводНачальныхОстатковКлиентСервер.РазделУчетаДляВводаОстатковУстарел(РазделУчета)
		И (ДокументОбъект.ОтражатьВБухгалтерскомУчете Или Не ДокументОбъект.ОтражатьВНалоговомУчете);
			
	Если РазделУчетаУстарел Тогда
		ЗапретитьПроведение = ВводНачальныхОстатковКлиентСервер.ЗапретитьПроведениеДокументовСУстаревшимРазделомУчета();
	Иначе
		ЗапретитьПроведение = Ложь;
	КонецЕсли;
	
	Если ЗапретитьПроведение Тогда
		
		НаименованиеРаздела	= Сред(Строка(РазделУчета),11); // убираем текст "(устарел)" в начале		
		ТекстШаблон			= НСтр("ru = 'Внимание! Раздел учета ""%1"" устарел. Проведение запрещено.'");
		ТекстСообщения		= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстШаблон, НаименованиеРаздела);

		ЧастиЗаголовка = Новый Массив;
		ЧастиЗаголовка.Добавить(ТекстСообщения);
		ЧастиЗаголовка.Добавить(Символы.ПС);
		
		Если ДанныеПеренесеныИзДокумента Тогда
			ЧастиЗаголовка.Добавить(НСтр("ru = 'Воспользуйтесь документом '"));
			ЧастиЗаголовка.Добавить(Новый ФорматированнаяСтрока("Ввод начальных остатков ОС, НМА, НПА",,,, "e1cib/app/Документ.ВводНачальныхОстатковОС.Форма.ФормаДокумента"));
		Иначе
			ЧастиЗаголовка.Добавить(НСтр("ru = 'Данные из этого документа необходимо '"));
			ЧастиЗаголовка.Добавить(Новый ФорматированнаяСтрока("перенести",,,, "e1cib/app/Документ.ВводНачальныхОстатковОС.Форма.ПомощникПереноса"));
			ЧастиЗаголовка.Добавить(НСтр("ru=' в документы ""Ввод начальных остатков ОС, НМА, НПА""'"));
		КонецЕсли;
		
		Форма.Элементы["ДекорацияВниманиеТекст"].Заголовок = Новый ФорматированнаяСтрока(ЧастиЗаголовка);

	КонецЕсли;
	
	Форма.Элементы["ГруппаУстаревшийДокумент"].Видимость = ЗапретитьПроведение;
	
КонецПроцедуры

// Проверяет заполненность аналитики счета в произвольной структуре данных (не обязательно передавать документ-объект)
Процедура ПроверитьЗаполнениеСчетаИАналитики(ПроверяемаяСтруктура, ПараметрыПроверки, ДокументСсылка, ЕстьОшибкиЗаполнения)
	
	Перем	РеквизитыАналитики,
			ПредставленияПолей,
			ПривязкаСообщений,
			ПривязкаСообщенийПоУмолчаниюКДокументу,
			ПолучатьПредставлениеИзМетаданных,
			МетаданныеРеквизитов,
			ИмяПоля;
	
	// Входная проверка
	ПараметрыПроверки.Свойство("РеквизитыАналитики", РеквизитыАналитики);
	Если НЕ ТипЗнч(РеквизитыАналитики) = Тип("Структура") Тогда
		РеквизитыАналитики = Новый Структура();
	КонецЕсли;
	
	ПараметрыПроверки.Свойство("ПредставленияПолей", ПредставленияПолей);
	Если НЕ ТипЗнч(ПредставленияПолей) = Тип("Структура") Тогда
		ПредставленияПолей = Новый Структура();
	КонецЕсли;
	
	ПараметрыПроверки.Свойство("ПривязкаСообщений", ПривязкаСообщений);
	Если НЕ ТипЗнч(ПривязкаСообщений) = Тип("Структура") Тогда
		ПривязкаСообщений = Новый Структура();
	КонецЕсли;
	
	УказанДокумент = Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ПроверяемаяСтруктура));
	
	ПривязкаСообщенийПоУмолчаниюКДокументу = УказанДокумент;
	
	ПараметрыПроверки.Свойство("МетаданныеРеквизитов", МетаданныеРеквизитов);
	Если МетаданныеРеквизитов <> Неопределено Тогда
		// Явно указали метаданные.
		// Используем их.
		
		ПолучатьПредставлениеИзМетаданных = Истина;
	Иначе
		// Метаданные не указывали.
		
		ПолучатьПредставлениеИзМетаданных = УказанДокумент;
		
		Если ПолучатьПредставлениеИзМетаданных Тогда
			МетаданныеРеквизитов = ПроверяемаяСтруктура.Метаданные();
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ РеквизитыАналитики.Свойство("Счет") Тогда
		ВызватьИсключение НСтр("ru = 'Не задано имя реквизита Счет в ПроверитьЗаполнениеСчетаИАналитики'");
	КонецЕсли;
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	// Счет
	ИмяПоля = РеквизитыАналитики.Счет;
	Счет = ПроверяемаяСтруктура[ИмяПоля];
	Если НЕ ЗначениеЗаполнено(Счет) Тогда
		
		ЕстьОшибкиЗаполнения = Истина;
		
		ПроверитьЗаполнениеСчетаИАналитики_ВывестиСообщение(
			ИмяПоля,
			ПредставленияПолей,
			ПривязкаСообщений,
			ПривязкаСообщенийПоУмолчаниюКДокументу,
			ПолучатьПредставлениеИзМетаданных,
			МетаданныеРеквизитов,
			ДокументСсылка);
		
		// Далее нет смысла проверять аналитику счета, поэтому выходим
		Возврат; 
	КонецЕсли;
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);
	
	// КПС
	Если РеквизитыАналитики.Свойство("КПС") Тогда
		ИмяПоля = РеквизитыАналитики.КПС;
		Если СвойстваСчета.УчетПоКПС
			И НЕ ЗначениеЗаполнено(ПроверяемаяСтруктура[ИмяПоля]) Тогда
			
			ЕстьОшибкиЗаполнения = Истина;
			
			ПроверитьЗаполнениеСчетаИАналитики_ВывестиСообщение(
				ИмяПоля,
				ПредставленияПолей,
				ПривязкаСообщений,
				ПривязкаСообщенийПоУмолчаниюКДокументу,
				ПолучатьПредставлениеИзМетаданных,
				МетаданныеРеквизитов,
				ДокументСсылка);
		КонецЕсли;
	КонецЕсли;
	
	// КЭК
	Если РеквизитыАналитики.Свойство("КЭК") Тогда
		ИмяПоля = РеквизитыАналитики.КЭК;
		Если СвойстваСчета.УчетПоКЭК
			И НЕ ЗначениеЗаполнено(ПроверяемаяСтруктура[ИмяПоля]) Тогда
			
			ЕстьОшибкиЗаполнения = Истина;
			
			ПроверитьЗаполнениеСчетаИАналитики_ВывестиСообщение(
				ИмяПоля,
				ПредставленияПолей,
				ПривязкаСообщений,
				ПривязкаСообщенийПоУмолчаниюКДокументу,
				ПолучатьПредставлениеИзМетаданных,
				МетаданныеРеквизитов,
				ДокументСсылка);
		КонецЕсли;
	КонецЕсли;
	
	// Подразделение
	Если РеквизитыАналитики.Свойство("Подразделение") Тогда
		ИмяПоля = РеквизитыАналитики.Подразделение;
		Если ИспользоватьУчетПоПодразделениям
			И СвойстваСчета.УчетПоПодразделениям
			И НЕ СвойстваСчета.РазрешитьНеУказыватьПодразделение
			И НЕ ЗначениеЗаполнено(ПроверяемаяСтруктура[ИмяПоля]) Тогда
			
			ЕстьОшибкиЗаполнения = Истина;
			
			ПроверитьЗаполнениеСчетаИАналитики_ВывестиСообщение(
				ИмяПоля,
				ПредставленияПолей,
				ПривязкаСообщений,
				ПривязкаСообщенийПоУмолчаниюКДокументу,
				ПолучатьПредставлениеИзМетаданных,
				МетаданныеРеквизитов,
				ДокументСсылка);
		КонецЕсли;
	КонецЕсли;
	
	// Субконто
	Для НомерСубконто = 1 По СвойстваСчета.КоличествоСубконто Цикл
		
		Если РеквизитыАналитики.Свойство("Субконто" + НомерСубконто) Тогда
			ИмяПоля = РеквизитыАналитики["Субконто" + НомерСубконто];
			Если СвойстваСчета["ВидСубконто" + НомерСубконто + "Обязательный"]
				И НЕ ЗначениеЗаполнено(ПроверяемаяСтруктура[ИмяПоля]) Тогда
				
				ЕстьОшибкиЗаполнения = Истина;
				
				Если НЕ ПредставленияПолей.Свойство(ИмяПоля) Тогда
					ПредставленияПолей.Вставить(ИмяПоля, СвойстваСчета["ВидСубконто" + НомерСубконто + "Наименование"]);
				КонецЕсли;
				
				ПроверитьЗаполнениеСчетаИАналитики_ВывестиСообщение(
					ИмяПоля,
					ПредставленияПолей,
					ПривязкаСообщений,
					ПривязкаСообщенийПоУмолчаниюКДокументу,
					ПолучатьПредставлениеИзМетаданных,
					МетаданныеРеквизитов,
					ДокументСсылка);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеСчетаИАналитики_ВывестиСообщение(
			ИмяПоля,
			ПредставленияПолей,
			ПривязкаСообщений,
			ПривязкаСообщенийПоУмолчаниюКДокументу,
			ПолучатьПредставлениеИзМетаданных,
			МетаданныеРеквизитов,
			ДокументСсылка)
			
	Если ПредставленияПолей.Свойство(ИмяПоля) Тогда
		
		Представление = ПредставленияПолей[ИмяПоля];
		
	ИначеЕсли ПолучатьПредставлениеИзМетаданных Тогда
		
		Представление = МетаданныеРеквизитов[ИмяПоля].Синоним;
		
	Иначе
		
		Представление = ИмяПоля;
		
	КонецЕсли;
	
	Если ПривязкаСообщений.Свойство(ИмяПоля) Тогда
		
		ПривязкаСообщения = ПривязкаСообщений[ИмяПоля];
		
	ИначеЕсли ПривязкаСообщенийПоУмолчаниюКДокументу Тогда
		
		ПривязкаСообщения = "Объект." + ИмяПоля; // Реквизит объекта
		
	Иначе
		
		ПривязкаСообщения = ИмяПоля; // Реквизит формы
		
	КонецЕсли;
	
	ТекстШаблон = НСтр("ru='Поле ""%1"" не заполнено'");
	
	ТекстСообщения = СтрШаблон(ТекстШаблон, Представление);
	
	ОбщегоНазначения.СообщитьПользователю(
		ТекстСообщения,
		ДокументСсылка,
		ПривязкаСообщения);
	
КонецПроцедуры

