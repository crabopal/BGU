	Возврат Новый Структура("ИндексПоследнегоЗапроса, ИндексРезультата, ОписаниеПроверки, ТекстЗапроса",
		2,
		1,
		ОписаниеПроверки,
	"
	|////////////////////////////////////////////////////////////////////////////////
	|// Комментарий
	|//	Определяет номера одинаковых строк в табл.части ""Кап.ремонт""
	|//	(строк с одинаковым значением всех полей, кроме НомерСтроки)
	|//
	|//	Индекс последнего запроса:	2
	|//	Индекс результата:			1
	|//	(для вывода сообщений)
	|//	Структура результата:	Итоги - ""НомерСтроки""=пусто;
	|//							Дет.записи - ""НомерСтроки""=Номер строки дубля.
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Количество дублей целых строк
	|//		(Номера одинаковых строк)
	|ВЫБРАТЬ
	|	// Все поля, по которым ищем дубли:
	|	ОС,
	|	Дата,
	|	ИнвНомер,
	|	
	|	КОЛИЧЕСТВО(НомерСтроки)	КАК КолвоДублей
	|ПОМЕСТИТЬ
	|	ВТ_Капремонт_КолвоДублейСтрок
	|ИЗ
	|	ТаблЧасть_КапРемонтОС	КАК КапРемонтОС
	|СГРУППИРОВАТЬ ПО
	|	// Все поля, по которым ищем дубли:
	|	ОС,
	|	Дата,
	|	ИнвНомер
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(НомерСтроки) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Номера одинаковых строк
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	КапРемонтОС.НомерСтроки	КАК НомерСтроки
	|ИЗ
	|	ВТ_Капремонт_КолвоДублейСтрок
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ТаблЧасть_КапРемонтОС	КАК КапРемонтОС
	|		// Все поля, по которым ищем дубли:
	|		ПО	ВТ_Капремонт_КолвоДублейСтрок.ОС = КапРемонтОС.ОС
