КонецФункции
Функция ТекстЗапроса_ПроверкаЗаполнения_НаличиеОстатковПоОС(ДокументОбъект)
	
	ТекстОтборВидРаспоряжения = ТекстЗапроса_ПроверкаЗаполнения_ОтборПоВидуРаспоряжения(ДокументОбъект);
	
	ОписаниеПроверки = ПолучитьОписаниеПроверки(
		НСтр("ru='Для указанного ОС начальные остатки уже введены (таблица ""Основные средства"", строка [НомерСтроки]) см. [Регистратор])'"),
		НСтр("ru='Также обнаружены еще ОС в таблице ""Основные средства"", по которым начальные остатки уже введены (всего [КоличествоНесообщенныхОшибок] шт)'"),
		"ОС_Основная",
		"ОС",
		
		"Регистратор, НомерСтроки",	// ИменаПолей
		Ложь,						// ИспользуетсяГруппировкаРезультата
		"");						// ИмяСвойстваОтборСтрокУстановлен
		
	// Необходимо наличие временных таблиц:
	//	- ТаблЧасть_ОС_Основная
	
	ТекстШаблон = "
	|////////////////////////////////////////////////////////////////////////////////
	|// Комментарий
	|//	Наименование запроса:		Наличие уже введенных остатков по ОС
	|//	Индекс последнего запроса:	4
	|//	Индекс результата:			2
	|//	(для вывода сообщений)
	|//	Структура результата:	Дет.записи - ""НомерСтроки"", ""Регистратор"".
	|//	Используемые параметры запроса:		&ТекДата
	|//										&Организация
	|//										&ПроводимыйДокументСсылка
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Различные ОС, используемые в документе.
	|//		(Наличие уже введенных остатков по ОС)
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОС_Основная.ОС			КАК ОС,
	|	ВЫБОР
	|		КОГДА ОС_Основная.ОС.ГрупповойУчет ТОГДА
	|			ОС_Основная.ИнвНомерОС
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ					КАК ИнвНомерОС
	|ПОМЕСТИТЬ
	|	ВТ_СписокОС
	|ИЗ
	|	ТаблЧасть_ОС_Основная	КАК ОС_Основная
	|ГДЕ
	|	НЕ ОС_Основная.ОС.ГрупповойУчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) ОС, по которым обнаружены уже введенные нач.остатки.
	|//		(Наличие уже введенных остатков по ОС)
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ОсновноеСредство				КАК ОС,
	|	ОсновноеСредство.ГрупповойУчет	КАК ГрупповойУчет,
	|	ВЫБОР
	|		КОГДА ОсновноеСредство.ГрупповойУчет ТОГДА
	|			ИнвентарныйНомер
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ							КАК ИнвНомерОС,
	|	МИНИМУМ(Регистратор)			КАК Регистратор
	|ПОМЕСТИТЬ
	|	ВТ_СписокОС_Остатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.ОстаткиИОбороты(
	|		&ТекДата,
	|		&ТекДата,
	|		Регистратор,
	|		,
	|		Организация = &Организация
	|		И	ОсновноеСредство В (
	|			ВЫБРАТЬ
	|				ОС
	|			ИЗ
	|				ВТ_СписокОС
	|		)
	|		И %1
	|	) КАК Остатки
	|ГДЕ
	|	СтоимостьНачальныйОстаток <> 0
	|	И Регистратор <> &ПроводимыйДокументСсылка
	|	И ВЫБОР
	|		КОГДА ОсновноеСредство.ГрупповойУчет ТОГДА
	|			ИнвентарныйНомер В (
	|				ВЫБРАТЬ
	|					ИнвНомерОС
	|				ИЗ
	|					ВТ_СписокОС
	|				)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ОсновноеСредство.ГрупповойУчет,
	|	ВЫБОР
	|		КОГДА ОсновноеСредство.ГрупповойУчет ТОГДА
	|			ИнвентарныйНомер
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Наличие уже введенных остатков по ОС
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	ОС_Основная.НомерСтроки							КАК НомерСтроки,
	|	ПРЕДСТАВЛЕНИЕ(ВТ_СписокОС_Остатки.Регистратор)	КАК Регистратор
	|ИЗ
	|	ВТ_СписокОС_Остатки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ТаблЧасть_ОС_Основная	КАК ОС_Основная
	|		ПО	ВТ_СписокОС_Остатки.ОС = ОС_Основная.ОС
	|		И	ВТ_СписокОС_Остатки.ИнвНомерОС = ВЫБОР
	|			КОГДА ВТ_СписокОС_Остатки.ГрупповойУчет ТОГДА
	|				ОС_Основная.ИнвНомерОС
	|			ИНАЧЕ
	|				НЕОПРЕДЕЛЕНО
	|		КОНЕЦ
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Уничтожение временной таблицы
	|УНИЧТОЖИТЬ	ВТ_СписокОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Уничтожение временной таблицы
	|УНИЧТОЖИТЬ	ВТ_СписокОС_Остатки
	|;";
	
	ТекстЗапроса = СтрШаблон(ТекстШаблон, ТекстОтборВидРаспоряжения);
	
	Возврат Новый Структура("ИндексПоследнегоЗапроса, ИндексРезультата, ОписаниеПроверки, ТекстЗапроса",
		4,
		2,
		ОписаниеПроверки,
		ТекстЗапроса);
	
КонецФункции
Функция ТекстЗапроса_ПроверкаЗаполнения_Капремонт_ДублиСтрок()
	
