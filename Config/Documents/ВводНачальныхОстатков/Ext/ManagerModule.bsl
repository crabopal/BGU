// Выбирает документы "Ввод остатков по студентам" с незаполненным полем "Факультет"
// и заполняет значением из поля "Подразделение организации".
// Метод добавлен из-за введения нового реквизита "Факультет",
// вместо которого ранее использовался реквизит "Подразделение организации".
Процедура ПриОбновлении_2_0_5_6_Студенты_ЗаполнитьПолеФакультет() Экспорт
	//// Начинаем транзакцию:
	//НачатьТранзакцию();
	
	Попытка
		// Сведения для вывода в журнал регистрации:
		ОбъектМетаданных = Метаданные.Документы.ВводНачальныхОстатков;
		ИмяСобытия			= НСтр("ru='Данные. Изменение'");
		КомментарийОК		= НСтр("ru='Групповая обработка документов ""%1"": успешно обработано документов: '");
		КомментарийОК 		= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(КомментарийОК, Перечисления.РазделыУчетаДляВводаОстатков.Студенты);
		КомментарийОшибка	= НСтр("ru='Ошибка при групповой обработке документов ""%1"": '");
		КомментарийОшибка	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(КомментарийОшибка, Перечисления.РазделыУчетаДляВводаОстатков.Студенты);
		
		// Получим список документов, которые необходимо обработать:
		ЗапросДокументы = Новый Запрос("
		|////////////////////////////////////////////////////////////////////////////////
		|// [0]. Документы ""Ввод остатков по учащимся"" с незаполненным полем ""Факультет"".
		|//
		|ВЫБРАТЬ
		|	Док.Ссылка						КАК ДокСсылка,
		|	Док.ПодразделениеОрганизации	КАК НовыйФакультет
		|ИЗ
		|	Документ.ВводНачальныхОстатков	КАК Док
		|ГДЕ
		|	Док.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.Студенты)
		|	И Док.Факультет = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|;");
		РезультатЗапросаДокументы = ЗапросДокументы.Выполнить();
		
		//// Устанавливаем исключительную блокировку на интересующие нас документы:
		//БлокировкаДанных = Новый БлокировкаДанных();
		//ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Документ.ВводНачальныхОстатков");
		//ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		//ЭлементБлокировкиДанных.ИсточникДанных = РезультатЗапросаДокументы;
		//ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("Ссылка", "ДокСсылка");
		//БлокировкаДанных.Заблокировать();
		
		// Обрабатываем найденные документы (записываем новые значения реквизитов):
		Выборка = РезультатЗапросаДокументы.Выбрать();
		КолвоДок = Выборка.Количество();
		Пока Выборка.Следующий() Цикл
			ДокОбъект = Выборка["ДокСсылка"].ПолучитьОбъект();
			ДокОбъект["Факультет"] = Выборка["НовыйФакультет"];
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЦикла;
		
		//// Фиксируем транзакцию:
		//ЗафиксироватьТранзакцию();
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			ОбъектМетаданных,						// объект метаданных
