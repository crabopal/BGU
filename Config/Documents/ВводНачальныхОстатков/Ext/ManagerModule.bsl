		|		КОГДА НомераСубконто.НомерВидаСубконтоПартии = 2 ТОГДА
		|			&ДокСсылка
		|		КОГДА НомераСубконто.НомерВидаСубконтоНоменклатура = 2 ТОГДА
		|			Материалы.Номенклатура
		|		КОГДА НомераСубконто.НомерВидаСубконтоВидыЗатрат = 2 ТОГДА
		|			Затраты.ВидЗатрат
		|	КОНЕЦ										КАК СубконтоДт2,
		|	ВЫБОР
		|		КОГДА НомераСубконто.НомерВидаСубконтоПартии = 3 ТОГДА
		|			&ДокСсылка
		|		КОГДА НомераСубконто.НомерВидаСубконтоНоменклатура = 3 ТОГДА
		|			Материалы.Номенклатура
		|		КОГДА НомераСубконто.НомерВидаСубконтоВидыЗатрат = 3 ТОГДА
		|			Затраты.ВидЗатрат
		|	КОНЕЦ										КАК СубконтоДт3,
		|	
		|	// Устанавливаем поле ""Количество"" только для первых строк зависимой таблицы ""Затраты"":
		|	ВЫБОР
		|		КОГДА НомераПервыхСтрок.НомерСтроки ЕСТЬ NULL ТОГДА
		|			0
		|		ИНАЧЕ
		|			Материалы.Количество			
		|	КОНЕЦ										КАК КоличествоДт,
		|	&ШапкаДокумента_ПодразделениеОрганизации	КАК ПодразделениеДт,
		|
		|	// Кредит: (пусто)
		|
		|	Затраты.СуммаНУ								КАК Сумма,
		|	&Содержание									КАК Содержание,
		|	&ШапкаДокумента_ВидПервичногоДокумента		КАК ВидПервичногоДокумента,
		|	&ШапкаДокумента_ДатаПервичногоДокумента		КАК ДатаПервичногоДокумента,
		|	&ШапкаДокумента_НомерПервичногоДокумента	КАК НомерПервичногоДокумента
		|
		|ИЗ
		|	ТаблЧастьМатериалы106хП КАК Материалы
		|	ЛЕВОЕ СОЕДИНЕНИЕ ТаблЧастьЗатраты106хП КАК Затраты
		|		// Поля связи:
		|		ПО	Материалы.Номенклатура = Затраты.Номенклатура
		|		И	Материалы.Счет = Затраты.Счет
		|		И	Материалы.КПС = Затраты.КПС
		|		// Требование заполненных значений:
		|		И	НЕ (Затраты.СуммаНУ = 0)
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	СоответствиеСчетов
		|		ПО	Материалы.Счет = СоответствиеСчетов.СчетБУ
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	НомераВидовСубконто_СчетаНУ	КАК НомераСубконто
		|		ПО	СоответствиеСчетов.СчетНУ = НомераСубконто.Счет
		|	ЛЕВОЕ СОЕДИНЕНИЕ	ТаблЧастьЗатраты106хП_НомераПервыхСтрок	КАК НомераПервыхСтрок
		|		ПО	Затраты.НомерСтроки = НомераПервыхСтрок.НомерСтроки
		|УПОРЯДОЧИТЬ ПО
		|	Материалы.НомерСтроки
		|;";
	КонецЕсли;
	
	// Окончательная настройка текста запроса:
	ЗапросДвижения.Текст = ТекстЗапроса;
	
	// Выполняем запросы:
	РезультатыДвижения = ЗапросДвижения.ВыполнитьПакет();
	
	// Сначала бух.учет:
	Если ОтражатьВБухгалтерскомУчете Тогда
		Выборка = РезультатыДвижения[ИндексРезультата_БухУчет].Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяПроводка = ТаблицаПроводок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяПроводка, Выборка);
			НоваяПроводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяПроводка.СчетДт, НоваяПроводка.СчетКт);
		КонецЦикла;
	КонецЕсли;
	
	// Теперь нал.учет ОСН:
	Если ОтражатьВНалоговомУчетеОСН Тогда
		Выборка = РезультатыДвижения[ИндексРезультата_НалУчетОСН].Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяПроводка = ТаблицаПроводок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяПроводка, Выборка);
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТаблицаПроводок;
	
КонецФункции

