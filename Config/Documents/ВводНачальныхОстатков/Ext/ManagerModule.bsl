КонецФункции

Процедура ДобавитьВПротоколРаботы(Статистика, ПротоколРаботы) Экспорт
	
	ТекстСообщения = "";
	
	ТекстНовойЗаписи = "" + ТекущаяДатаСеанса() + Символы.ПС;
	
	Если Статистика["КоличествоСтрокКОбработке"] = 0 Тогда
		
		ТекстСообщения = НСтр("ru='Новые документы не создавались, потому что отсутствуют строки с незаполненным документом счета-фактуры.'");
		
		ТекстНовойЗаписи = ТекстНовойЗаписи
			+ ТекстСообщения
		 	+ Символы.ПС
		 	+ Символы.ПС;
			
	Иначе
		
		КоличествоСозданоВыданный	= Статистика["КоличествоДокументов"]["Выданный"]["Создано"];
		КоличествоСозданоПолученный	= Статистика["КоличествоДокументов"]["Полученный"]["Создано"];
		КоличествоСозданоВсего		= КоличествоСозданоВыданный + КоличествоСозданоПолученный;
		
		Если КоличествоСозданоВсего > 0 Тогда
			
			ТекстНовойЗаписи = ТекстНовойЗаписи
