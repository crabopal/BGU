Функция ДокументыОстатковНДС_НайтиДокументыВводаОстатков(СчетФактураСсылка) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СчетФактураСсылка", СчетФактураСсылка);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ
	|	Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(Ссылка) КАК Представление
	|ИЗ
	|	Документ.ВводНачальныхОстатков.НДС
	|ГДЕ
	|	(СчетФактура = &СчетФактураСсылка ИЛИ ДокументКорректировки = &СчетФактураСсылка)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка.Дата";
	
	Список = Новый СписокЗначений();
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Список.Добавить(Выборка.Ссылка, Выборка.Представление + "          "); // Пробелы добавляются для компенсации недостаточной автоматической ширины списка выбора
		
	КонецЦикла;
	
	Возврат Список;
	
КонецФункции


Процедура ДокументыОстатковНДС_НастроитьПризнак(ВводОстатковСсылка, ВыполняетсяПроведение) Экспорт
	
	СпискиДокументов = ДокументыОстатковНДС_ПолучитьСписки(ВводОстатковСсылка, ВыполняетсяПроведение);
	
	СписокПоТипам = СпискиДокументов["СброситьПризнак"];
	
	Если СписокПоТипам.Количество() > 0 Тогда
		
		ДокументыОстатковНДС_УстановитьЗначениеПризнака(ВводОстатковСсылка, СписокПоТипам, Ложь);
		
	КонецЕсли;
	
	СписокПоТипам = СпискиДокументов["УстановитьПризнак"];
	
	Если СписокПоТипам.Количество() > 0 Тогда
		
		ДокументыОстатковНДС_УстановитьЗначениеПризнака(ВводОстатковСсылка, СписокПоТипам, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДокументыОстатковНДС_УстановитьЗначениеПризнака(ВводОстатковСсылка, СписокПоТипам, ЗначениеПризнака)
	
	// В это время уже открыта системная транзакция.
	// Т.к. эта процедура вызывается из обработчика события ПередЗаписью модуля документа ВводНачальныхОстатков.
	
	Блокировка = Новый БлокировкаДанных;
	
	Для Каждого Элемент Из СписокПоТипам Цикл
		
		ЭлементБлокировки = Блокировка.Добавить("Документ." + Элемент.Ключ);
		ЭлементБлокировки.ИсточникДанных = Элемент.Значение;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
		
	КонецЦикла;
	
	Попытка
		Блокировка.Заблокировать();
	Исключение
		
		ТекстСообщения = СтрШаблон(НСтр("ru='Ошибка установки управляемой блокировки на документы остатков НДС.
			|
			|%1'"),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ЗаписьЖурналаРегистрации(
			НСтр("ru='Данные. Изменение'"),				// имя события
			УровеньЖурналаРегистрации.Ошибка,			// уровень
			Метаданные.Документы.ВводНачальныхОстатков,	// объект метаданных
			ВводОстатковСсылка,							// данные
			ТекстСообщения);							// комментарий
			
		ВызватьИсключение ТекстСообщения;
		
	КонецПопытки;
	
	ТекстДействие = ?(ЗначениеПризнака,
		НСтр("ru='установки'"),
		НСтр("ru='сброса'"));
		
	СчетчикДокументов = 0;
	
	Для Каждого Элемент Из СписокПоТипам Цикл
		
		ИмяДокумента = Элемент.Ключ;
		
		Для Каждого СтрокаТаблицы Из Элемент.Значение Цикл
			
			ДокументСсылка = СтрокаТаблицы["Ссылка"];
			
			ПредставлениеСсылки = Строка(ДокументСсылка);
			
			ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
			
			Попытка
				ДокументОбъект.Заблокировать();
			Исключение
				
				ТекстСообщения = СтрШаблон(НСтр("ru='Не удалось заблокировать документ %1 для %2 признака ВводНачальныхОстатков.
					|
					|%3'"),
					ПредставлениеСсылки,
					ТекстДействие,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ЗаписьЖурналаРегистрации(
					НСтр("ru='Данные. Изменение'"),		// имя события
					УровеньЖурналаРегистрации.Ошибка,	// уровень
					Метаданные.Документы[ИмяДокумента],	// объект метаданных
					ДокументСсылка,						// данные
					ТекстСообщения);					// комментарий
					
				ВызватьИсключение ТекстСообщения;
				
			КонецПопытки;
			
			ДокументОбъект["ВводНачальныхОстатков"] = ЗначениеПризнака;
			
			Попытка
				
				Если ЗначениеПризнака = Истина Тогда
					
					РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
						
				Иначе
					
					ДокументОбъект.ОбменДанными.Загрузка = Истина;
					
					РежимЗаписи = РежимЗаписиДокумента.Запись;
					
				КонецЕсли;
				
				ДокументОбъект.Записать(РежимЗаписи);
				
				СчетчикДокументов = СчетчикДокументов + 1;
				
			Исключение
				
				ТекстСообщения = СтрШаблон(НСтр("ru='Не удалось записать документ %1 после %2 признака ВводНачальныхОстатков.
					|
					|%3'"),
					ПредставлениеСсылки,
					ТекстДействие,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ЗаписьЖурналаРегистрации(
					НСтр("ru='Данные. Изменение'"),		// имя события
					УровеньЖурналаРегистрации.Ошибка,	// уровень
					Метаданные.Документы[ИмяДокумента],	// объект метаданных
					ДокументСсылка,						// данные
					ТекстСообщения);					// комментарий
					
				ВызватьИсключение ТекстСообщения;
				
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если СчетчикДокументов > 0 Тогда
		
		ТекстДействие = ?(ЗначениеПризнака,
			НСтр("ru='установлен'"),
			НСтр("ru='сброшен'"));
			
		ТекстСообщения = СтрШаблон(НСтр("ru='Успешно %1 признак ВводНачальныхОстатков в документах остатков НДС: %2'"),
			ТекстДействие,
			Формат(СчетчикДокументов, "ЧГ=0"));
		
		ЗаписьЖурналаРегистрации(
			НСтр("ru='Данные. Изменение'"),				// имя события
			УровеньЖурналаРегистрации.Информация,		// уровень
			Метаданные.Документы.ВводНачальныхОстатков,	// объект метаданных
			ВводОстатковСсылка,							// данные
			ТекстСообщения);							// комментарий
			
	КонецЕсли;
	
КонецПроцедуры


Функция ДокументыОстатковНДС_ПолучитьСписки(ВводОстатковСсылка, ВыполняетсяПроведение)
	
	ВведенныеНаОсновании = ДокументыОстатковНДС_ВведенныеНаОсновании(ВводОстатковСсылка);
	
	УказанныеВоВводеОстатков = ДокументыОстатковНДС_УказанныеВоВводеОстатков(ВводОстатковСсылка);
	
	Список = ВведенныеНаОсновании;
	
	Для Каждого Ссылка Из УказанныеВоВводеОстатков Цикл
		
		Индекс = Список.Найти(Ссылка);
		
		УжеЕсть = (Индекс <> Неопределено);
		
		Если ВыполняетсяПроведение Тогда
			// Выполняется проведение
			
			// Необходимо сбросить признак у такого множества документов:
			// Основание "-" Указанные
			
			Если УжеЕсть Тогда
				Список.Удалить(Индекс);
			КонецЕсли;
			
		Иначе
			// Отменяется проведение
			
			// Необходимо сбросить признак у такого множества документов:
			// Основание "+" Указанные
			
			Если НЕ УжеЕсть Тогда
				Список.Добавить(Ссылка);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СброситьПризнак = ДокументыОстатковНДС_СгруппироватьПоТипу(Список);
	
	Если НЕ ВыполняетсяПроведение Тогда
		УказанныеВоВводеОстатков.Очистить();
	КонецЕсли;
	
	УстановитьПризнак = ДокументыОстатковНДС_СгруппироватьПоТипу(УказанныеВоВводеОстатков);
	
	СпискиДокументов = Новый Структура();
	СпискиДокументов.Вставить("СброситьПризнак",	СброситьПризнак);
	СпискиДокументов.Вставить("УстановитьПризнак",	УстановитьПризнак);
	
	Возврат СпискиДокументов;
	
КонецФункции

Функция ДокументыОстатковНДС_ВведенныеНаОсновании(ВводОстатковСсылка)
	
	// Автоматически могут формироваться следующие документы из ввода остатков:
	//  - СчетФактураВыданный
	//  - СчетФактураПолученный
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ВводОстатковСсылка", ВводОстатковСсылка);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный
	|ГДЕ
	|	ДокументОснование = &ВводОстатковСсылка
	|
	|ОБЪЕДИНИТЬ ВСЕ	
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураПолученный.ДокументыОснования
	|ГДЕ
	|	ДокументОснование = &ВводОстатковСсылка";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ДокументыОстатковНДС_УказанныеВоВводеОстатков(ВводОстатковСсылка)
	
	// В табличной части ввода остатков такие документы указываются в колонках:
	//  - СчетФактура
	//  - ДокументКорректировки
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ВводОстатковСсылка", ВводОстатковСсылка);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ
	|	СчетФактура	КАК Ссылка
	|ИЗ
	|	Документ.ВводНачальныхОстатков.НДС
	|ГДЕ
	|	Ссылка = &ВводОстатковСсылка
	|	И СчетФактура <> НЕОПРЕДЕЛЕНО
	|	// Документы остатков НДС (8 типов)
	|	И СчетФактура <> ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)
	|	И СчетФактура <> ЗНАЧЕНИЕ(Документ.СчетФактураПолученный.ПустаяСсылка)
	|	И СчетФактура <> ЗНАЧЕНИЕ(Документ.ИсправительныйСчетФактураВыданный.ПустаяСсылка)
	|	И СчетФактура <> ЗНАЧЕНИЕ(Документ.ИсправительныйСчетФактураПолученный.ПустаяСсылка)
	|	И СчетФактура <> ЗНАЧЕНИЕ(Документ.КорректировочныйСчетФактураВыданный.ПустаяСсылка)
	|	И СчетФактура <> ЗНАЧЕНИЕ(Документ.КорректировочныйСчетФактураПолученный.ПустаяСсылка)
	|	И СчетФактура <> ЗНАЧЕНИЕ(Документ.ГТДИмпорт.ПустаяСсылка)
	|	И СчетФактура <> ЗНАЧЕНИЕ(Документ.РегистрацияСтрокиКнигиПродаж.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДокументКорректировки	КАК Ссылка
	|ИЗ
	|	Документ.ВводНачальныхОстатков.НДС
	|ГДЕ
	|	Ссылка = &ВводОстатковСсылка
	|	И ДокументКорректировки <> НЕОПРЕДЕЛЕНО
	|	// Документы остатков НДС (8 типов)
	|	И ДокументКорректировки <> ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)
	|	И ДокументКорректировки <> ЗНАЧЕНИЕ(Документ.СчетФактураПолученный.ПустаяСсылка)
	|	И ДокументКорректировки <> ЗНАЧЕНИЕ(Документ.ИсправительныйСчетФактураВыданный.ПустаяСсылка)
	|	И ДокументКорректировки <> ЗНАЧЕНИЕ(Документ.ИсправительныйСчетФактураПолученный.ПустаяСсылка)
	|	И ДокументКорректировки <> ЗНАЧЕНИЕ(Документ.КорректировочныйСчетФактураВыданный.ПустаяСсылка)
	|	И ДокументКорректировки <> ЗНАЧЕНИЕ(Документ.КорректировочныйСчетФактураПолученный.ПустаяСсылка)
	|	И ДокументКорректировки <> ЗНАЧЕНИЕ(Документ.ГТДИмпорт.ПустаяСсылка)
	|	И ДокументКорректировки <> ЗНАЧЕНИЕ(Документ.РегистрацияСтрокиКнигиПродаж.ПустаяСсылка)";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции


Функция ДокументыОстатковНДС_СгруппироватьПоТипу(Список)
	
	ВидыДокументов = ДокументыОстатковНДС_ВидыДокументов();
	
	ВремСоответствие = Новый Соответствие;
	
	Для Каждого ВидДокумента Из ВидыДокументов Цикл
		
		ТипДокумента = Тип("ДокументСсылка." + ВидДокумента);
		
		ТаблицаСписок = Новый ТаблицаЗначений();
		ТаблицаСписок.Колонки.Добавить("Ссылка");
		
		Значение = Новый Структура();
		Значение.Вставить("ВидДокумента",	ВидДокумента);
		Значение.Вставить("ТаблицаСписок",	ТаблицаСписок);
		
		ВремСоответствие.Вставить(ТипДокумента, Значение);
		
	КонецЦикла;
	
	Для Каждого Ссылка Из Список Цикл
		
		Значение = ВремСоответствие.Получить(ТипЗнч(Ссылка));
		
		НоваяСтрока = Значение["ТаблицаСписок"].Добавить();
		НоваяСтрока["Ссылка"] = Ссылка;
		
	КонецЦикла;
	
	СписокПоТипам = Новый Структура();
	
	Для Каждого Элемент Из ВремСоответствие Цикл
		
		Значение = Элемент.Значение;
		
		Если Значение["ТаблицаСписок"].Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СписокПоТипам.Вставить(Значение["ВидДокумента"], Значение["ТаблицаСписок"]);
		
	КонецЦикла;
	
	Возврат СписокПоТипам;
	
КонецФункции

Функция ДокументыОстатковНДС_ВидыДокументов()
	
	ВидыДокументов = Новый Массив();
	
	ВидыДокументов.Добавить("СчетФактураВыданный");
	ВидыДокументов.Добавить("СчетФактураПолученный");
	ВидыДокументов.Добавить("ИсправительныйСчетФактураВыданный");
	ВидыДокументов.Добавить("ИсправительныйСчетФактураПолученный");
	ВидыДокументов.Добавить("КорректировочныйСчетФактураВыданный");
	ВидыДокументов.Добавить("КорректировочныйСчетФактураПолученный");
	ВидыДокументов.Добавить("ГТДИмпорт");
	ВидыДокументов.Добавить("РегистрацияСтрокиКнигиПродаж");
	
	Возврат ВидыДокументов;
	
КонецФункции


Функция ПолучитьКурсыВалютыНаДаты(Валюта, ТаблицаДат) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Валюта",		Валюта);
	ЗапросПоиск.УстановитьПараметр("ТаблицаДат",	ТаблицаДат);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Таблица указанных дат
	|//
	|ВЫБРАТЬ
	|	ТЗ.Дата	КАК Дата
	|ПОМЕСТИТЬ
	|	ТаблицаДат
	|ИЗ
	|	&ТаблицаДат	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Курсы валюты на указанные даты
	|//
	|ВЫБРАТЬ
	|	ТаблицаДат.Дата								КАК Дата,
	|	ЕСТЬNULL(КурсыВалют.Курс, 1)				КАК Курс,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КурсыВалют.Кратность, 1) = 0 ТОГДА
	|			1
	|		ИНАЧЕ
	|			ЕСТЬNULL(КурсыВалют.Кратность, 1)
	|	КОНЕЦ										КАК Кратность
	|ИЗ
	|	ТаблицаДат
	|	ЛЕВОЕ СОЕДИНЕНИЕ	(
	|		ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		    ТаблицаДат.Дата				КАК Дата,
	|		    МАКСИМУМ(КурсыВалют.Период)	КАК ДатаКурса
	|		ИЗ
	|			ТаблицаДат
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
	|				ПО	КурсыВалют.Валюта = &Валюта
	|				И	КурсыВалют.Период <= ТаблицаДат.Дата
	|		СГРУППИРОВАТЬ ПО
	|			ТаблицаДат.Дата
	|		)	КАК ДатыКурсовВалюты
	|	    ПО	ТаблицаДат.Дата = ДатыКурсовВалюты.Дата
	|	ЛЕВОЕ СОЕДИНЕНИЕ	РегистрСведений.КурсыВалют КАК КурсыВалют
	|    	ПО	КурсыВалют.Валюта = &Валюта
	|    	И	КурсыВалют.Период = ДатыКурсовВалюты.ДатаКурса
	|;";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

