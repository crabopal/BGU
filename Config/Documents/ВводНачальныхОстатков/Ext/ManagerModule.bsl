	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Дети.Ссылка										КАК Ребенок,
	|	Дети.Контрагент									КАК Контрагент
	|ПОМЕСТИТЬ
	|	ВТ_Дети
	|ИЗ
	|	Справочник.Дети	КАК Дети
	|ГДЕ
	|	Дети.ПометкаУдаления = ЛОЖЬ
	|	И	Дети.ЭтоГруппа = ЛОЖЬ
	|	И	Дети.Организация = &Организация
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Единственные договоры уже выбранных детей
	|//		(Заполнение списком детей)
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Договоры.Контрагент			КАК Контрагент,
	|	МАКСИМУМ(Договоры.Ссылка)	КАК Договор
	|ПОМЕСТИТЬ
	|	ВТ_Договоры
	|ИЗ
	|	ВТ_Дети	КАК Дети
	|	ЛЕВОЕ СОЕДИНЕНИЕ	Справочник.Договоры КАК Договоры
	|		ПО	Дети.Контрагент = Договоры.Контрагент
	|ГДЕ
	|	Договоры.ПометкаУдаления = ЛОЖЬ
	|	И Договоры.Организация = &Организация
	|СГРУППИРОВАТЬ ПО
	|	Договоры.Контрагент
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(Договоры.Ссылка) = 1
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Заполнение списком детей
	|//		(Финальная таблица для вывода результата)
	|//
	|ВЫБРАТЬ
	|	Дети.Ребенок		КАК Ребенок,
	|	Дети.Контрагент		КАК Контрагент,
	|	Договоры.Договор	КАК Договор
	|ИЗ
	|	ВТ_Дети	КАК Дети
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ВТ_Договоры	КАК Договоры
	|		ПО Дети.Контрагент = Договоры.Контрагент
	|;";
	
	// Выполняем запрос:
	ТЗ = ЗапросТаблица.Выполнить().Выгрузить();
	
	ДокументОбъект["РодительскаяПлата"].Загрузить(ТЗ);
	
КонецПроцедуры

Процедура ИнициализироватьДанныеДокумента_РодительскаяПлата(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	
	// Настраиваем запрос:
	ЗапросДвижения = Новый Запрос();
	ЗапросДвижения.УстановитьПараметр("ДокСсылка",		ДокументСсылка);
	ЗапросДвижения.УстановитьПараметр("ПустаяДата",		Дата('00010101'));
	ЗапросДвижения.УстановитьПараметр("ПустаяСтавка",	Справочники.СтавкиОплатыОбразование.ПустаяСсылка());
	ЗапросДвижения.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Движения по регистру сведений ""СоставГруппДДУ""
	|//
	|ВЫБРАТЬ
	|	ИСТИНА							КАК Активность,
	|	ДатаВключения					КАК Период,
	|	Ребенок							КАК Ребенок,
	|	
	|	Ссылка.ГруппаДетскогоУчреждения	КАК ГруппаДетскогоУчреждения,
	|	Льгота							КАК Льгота,
	|	СтавкаОплаты					КАК СтавкаОплаты,
	|	Договор							КАК Договор
	|ИЗ
	|	Документ.ВводНачальныхОстатков.РодительскаяПлата	КАК ТЧ
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|	И	Ссылка.РодительскаяПлатаДопУслуги = 0
	|	И	Ссылка.ПринятьДетейВГруппу = ИСТИНА
	|	И	НЕ ДатаВключения = &ПустаяДата
	|	И	НЕ СтавкаОплаты = &ПустаяСтавка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Движения по регистру сведений ""СоставГруппДДУДополнительныеУслуги""
	|//
	|ВЫБРАТЬ
	|	ИСТИНА							КАК Активность,
	|	ДатаВключения					КАК Период,
	|	Ребенок							КАК Ребенок,
	|	Ссылка.ГруппаДетскогоУчреждения	КАК ГруппаДетскогоУчреждения,
	|	
	|	Льгота							КАК Льгота,
	|	СтавкаОплаты					КАК СтавкаОплаты,
	|	Договор							КАК Договор,
	|	ИСТИНА							КАК Актуальность
	|ИЗ
	|	Документ.ВводНачальныхОстатков.РодительскаяПлата	КАК ТЧ
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|	И	Ссылка.РодительскаяПлатаДопУслуги = 1
	|	И	Ссылка.ПринятьДетейВГруппу = ИСТИНА
	|	И	НЕ ДатаВключения = &ПустаяДата
	|	И	НЕ СтавкаОплаты = &ПустаяСтавка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";
	
	РезультатыДвижения = ЗапросДвижения.ВыполнитьПакет();
	
	ТаблицаСоставГруппДДУ						= РезультатыДвижения[0].Выгрузить();
	ТаблицаСоставГруппДДУДополнительныеУслуги	= РезультатыДвижения[1].Выгрузить();
	
	ТаблицыДляДвижений.Вставить("СоставГруппДДУ",						ТаблицаСоставГруппДДУ);
	ТаблицыДляДвижений.Вставить("СоставГруппДДУДополнительныеУслуги",	ТаблицаСоставГруппДДУДополнительныеУслуги);
	
КонецПроцедуры // ИнициализироватьДанныеДокумента()


//---
// Проверка заполнения
//---

// Проверка заполненности обязательных реквизитов
Функция ОбязательныеРеквизитыЗаполнены(ДокументОбъект, МаксКолвоСообщений, ВозвратРезультатПроверки)
	
	Перем	ПроверяемыеРеквизиты,
			ПроверяемыеСубконто,
			ПроверяемыеПризнакиУчета,
			ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
			ПеренаправлениеВыводаСообщений_Реквизиты,
			ИсключаемыеРеквизиты,
			ПереопределяемыеТабличныеЧасти;
	
	ПроверяемыеРеквизиты = Новый Массив();
	ИсключаемыеРеквизиты = Новый Массив();
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Если ДокументОбъект.РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства Тогда
		//
		// Раздел учета "Основные средства"
		//
		ШапкаДокумента = РежимВводаОстатков_СтруктураШапкиДокумента();
		ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);
		
		ЗаполнитьСписокПроверяемыхОбязательныхРеквизитов_ОС(
			ШапкаДокумента,
			ПроверяемыеРеквизиты,
			ПроверяемыеСубконто,
			ПроверяемыеПризнакиУчета,
			ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
			ПеренаправлениеВыводаСообщений_Реквизиты,
			ИсключаемыеРеквизиты);
			
		// Переопределяем номера строк в ОС_Амортизация для корректного вывода сообщений
		ПереопределеннаяОСАмортизация = ПолнаяТабличнаяЧастьОС_ПолучитьТаблицуОСАмортизацияДляПроверкиЗаполнения(
			ДокументОбъект,
			ПроверяемыеРеквизиты,
			ИсключаемыеРеквизиты);
		ПереопределяемыеТабличныеЧасти = Новый Структура();
		ПереопределяемыеТабличныеЧасти.Вставить("ОС_Амортизация", ПереопределеннаяОСАмортизация);
		
	ИначеЕсли ДокументОбъект.РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете Тогда
		//
		// Раздел учета "Основные средства на забалансовых счетах"
		//
		ШапкаДокумента = РежимВводаОстатков_СтруктураШапкиДокумента();
		ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);
		
		ЗаполнитьСписокПроверяемыхОбязательныхРеквизитов_ОСВОперУчете(
			ШапкаДокумента,
			ПроверяемыеРеквизиты,
			ПроверяемыеСубконто,
			ПроверяемыеПризнакиУчета,
			ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
			ПеренаправлениеВыводаСообщений_Реквизиты,
			ИсключаемыеРеквизиты);
		
		// Переопределяем номера строк в ОС_Амортизация для корректного вывода сообщений
		ПереопределеннаяОСАмортизация = ПолнаяТабличнаяЧастьОС_ПолучитьТаблицуОСАмортизацияДляПроверкиЗаполнения(
			ДокументОбъект,
			ПроверяемыеРеквизиты,
			ИсключаемыеРеквизиты);
		ПереопределяемыеТабличныеЧасти = Новый Структура();
		ПереопределяемыеТабличныеЧасти.Вставить("ОС_Амортизация", ПереопределеннаяОСАмортизация);
		
	ИначеЕсли ДокументОбъект.РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе Тогда
		//
		// Раздел учета "Ввод остатков ОС на забалансовых счетах"
		//
		ШапкаДокумента = РежимВводаОстатков_СтруктураШапкиДокумента();
		ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);
		
		ЗаполнитьСписокПроверяемыхОбязательныхРеквизитов_ОСЗабаланс(
			ШапкаДокумента,
			ПроверяемыеРеквизиты,
			ПроверяемыеСубконто,
			ПроверяемыеПризнакиУчета,
			ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
			ПеренаправлениеВыводаСообщений_Реквизиты,
			ИсключаемыеРеквизиты);
		
	ИначеЕсли ДокументОбъект.РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НПА Тогда
		//
		// Раздел учета "НПА"
		//
		ШапкаДокумента = РежимВводаОстатков_СтруктураШапкиДокумента();
		ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);
		
		ЗаполнитьСписокПроверяемыхОбязательныхРеквизитов_НПА(
			ШапкаДокумента,
			ПроверяемыеРеквизиты,
			ПроверяемыеСубконто,
			ПроверяемыеПризнакиУчета,
			ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
			ПеренаправлениеВыводаСообщений_Реквизиты,
			ИсключаемыеРеквизиты);
		
		// Переопределяем номера строк в ОС_Амортизация для корректного вывода сообщений
		ПереопределеннаяОСАмортизация = ПолнаяТабличнаяЧастьОС_ПолучитьТаблицуОСАмортизацияДляПроверкиЗаполнения(
			ДокументОбъект,
			ПроверяемыеРеквизиты,
			ИсключаемыеРеквизиты);
		ПереопределяемыеТабличныеЧасти = Новый Структура();
		ПереопределяемыеТабличныеЧасти.Вставить("ОС_Амортизация", ПереопределеннаяОСАмортизация);
		
	ИначеЕсли ДокументОбъект.РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Материалы Тогда
		//
		// Раздел учета "Материалы"
		//
		
		ДатаСрезаУчетнойПолитики = ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(ДокументОбъект.Дата);
		ПлательщикНалогаНаПрибыль = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(
			ДокументОбъект.Организация, ДатаСрезаУчетнойПолитики);
		ПрименяетсяУСНДоходыМинусРасходы = УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(
			ДокументОбъект.Организация, ДатаСрезаУчетнойПолитики);
		
		ТолькоБухУчет = ДокументОбъект["ОтражатьВБухгалтерскомУчете"] И НЕ ДокументОбъект["ОтражатьВНалоговомУчете"];
		ТолькоНалУчет = НЕ ДокументОбъект["ОтражатьВБухгалтерскомУчете"] И ДокументОбъект["ОтражатьВНалоговомУчете"];
		
		// Реквизиты шапки:
		ПроверяемыеРеквизиты.Добавить("Организация");
		ПроверяемыеРеквизиты.Добавить("Дата");
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			ПроверяемыеРеквизиты.Добавить("ИФО");
		КонецЕсли;
	
		// Реквизиты табл.части "Материалы":
		ПроверяемыеРеквизиты.Добавить("Материалы.КФО");
		Если ДокументОбъект.ОтражатьВБухгалтерскомУчете
		 ИЛИ ДокументОбъект.ОтражатьВНалоговомУчете И ПрименяетсяУСНДоходыМинусРасходы Тогда
			ПроверяемыеРеквизиты.Добавить("Материалы.Счет");
		КонецЕсли;
		
		// Реквизиты субконто, зависящие от счета в табл.части "Материалы".
		// 1) Сначала определим имена проверяемых колонок и виды субконто:
		ВремСписок = Новый СписокЗначений();
		
		ТабСвойстваСчетов = ПолучитьТаблицуСчетов_Материалы(ДокументОбъект, ВремСписок);
		
		Поиск = Новый Структура("СчетГруппа", ДокументОбъект.Счет);
		СтрокиТЗ = ТабСвойстваСчетов.НайтиСтроки(Поиск);
		КолвоСтрок = СтрокиТЗ.Количество();
		
		Если КолвоСтрок > 0 Тогда
			Если КолвоСтрок = 1 Тогда
				СвойстваСчета = СтрокиТЗ[0];
			Иначе
				// КолвоСтрок > 1
				// Счета, присутствующие в списке более 1 раза.
				Если ДокументОбъект.ОсобыеСчета10500 Тогда
					СвойстваСчета = СтрокиТЗ[1];
				Иначе
					СвойстваСчета = СтрокиТЗ[0];
				КонецЕсли;
			КонецЕсли;
			СоответствиеСубконтоКолонка = ПолучитьСоответствиеСубконтоКолонка();
			КолонкиСубконто = Новый Соответствие();
			КолонкиСубконто.Вставить("Счет", "Счет");
			Для Каждого Элем Из СвойстваСчета.ВидыСубконто Цикл
				ВидСубконто = Элем.Значение;
				ИмяКолонки = СоответствиеСубконтоКолонка.Получить(ВидСубконто);
				
				Если ТолькоНалУчет И ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
					Продолжить;
				КонецЕсли;
				
				// На счетах 105.00 по ЦМО ведется лишь количественный учет.
				// Суммовой учет по ЦМО не ведется.
				//
				// Необходимо разрешить такие строки табличной части, получающиеся в результате свертки:
				//  - заполнены ЦМО и Количество, а Сумма пустая;
				//  - пустые ЦМО и Количество, а Сумма заполнена.
				//
				// Отключаем проверку заполнения ЦМО.
				Если ДокументОбъект["Счет"] = БухгалтерскийУчет.СчетПоКоду("105.00")
					И НЕ ДокументОбъект["ОсобыеСчета10500"]
					И ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
					
					Продолжить;
				КонецЕсли;
				
				КолонкиСубконто.Вставить(ВидСубконто, ИмяКолонки);
			КонецЦикла;
			// 2) Указываем обнаруженные имена колонок:
			ПроверяемыеСубконто = Новый Структура();
			ПроверяемыеСубконто.Вставить("Материалы", КолонкиСубконто);
		КонецЕсли;
		
		// Реквизиты, зависящие от признаков учета счета в табл.части "Материалы":
		ПроверяемыеПризнакиУчета = Новый Структура();
		ПризнакиУчета = Новый Структура("Счет, УчетПоКПС, УчетПоКЭК",
			"Счет",
			"КПС",
			"КЭК");
		Если ИспользоватьУчетПоПодразделениям Тогда
			ПризнакиУчета.Вставить("УчетПоПодразделениям", "Подразделение");
		КонецЕсли;
		
		ПроверяемыеПризнакиУчета.Вставить("Материалы", ПризнакиУчета);
		
		// Исключаем из проверки реквизиты, не используемые в текущем режиме ввода остатков:
		ШапкаДокумента = РежимВводаОстатков_СтруктураШапкиДокумента();
		ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);
		ИсключаемыеПоля = РежимВводаОстатков_ИменаПолейВсехРежимов(ШапкаДокумента, Истина); // ТолькоНеиспользуемые
		Для Каждого СтрокаТЗ Из ИсключаемыеПоля Цикл
			ИсключаемыеРеквизиты.Добавить(СтрокаТЗ["ПолноеИмя"]);
		КонецЦикла;
		
		
	ИначеЕсли ДокументОбъект.РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НДС Тогда
		//
		// Раздел учета "НДС"
		//
		// Реквизиты шапки:
		ПроверяемыеРеквизиты.Добавить("Организация");
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			ПроверяемыеРеквизиты.Добавить("ИФО");
		КонецЕсли;
		Если ПодразделениеОбязательноКЗаполнению(ДокументОбъект) Тогда
			ПроверяемыеРеквизиты.Добавить("ПодразделениеОрганизации");
		КонецЕсли;
		
		// Табл.часть НДС:
		ПроверяемыеРеквизиты.Добавить("НДС.СчетФактура");
		ПроверяемыеРеквизиты.Добавить("НДС.НомерСчетаФактуры");
		ПроверяемыеРеквизиты.Добавить("НДС.ДатаСчетаФактуры");
		ПроверяемыеРеквизиты.Добавить("НДС.Контрагент");
		//ПроверяемыеРеквизиты.Добавить("НДС.Договор");
		ПроверяемыеРеквизиты.Добавить("НДС.ПричинаНалогообложения");
		ПроверяемыеРеквизиты.Добавить("НДС.КФО");
		ПроверяемыеРеквизиты.Добавить("НДС.СтавкаНДС");
		ПроверяемыеРеквизиты.Добавить("НДС.КодСпособаВыставления");
		ПроверяемыеРеквизиты.Добавить("НДС.ВидЦенности");
		ПроверяемыеРеквизиты.Добавить("НДС.СчетРасчетов");
		
		ПроверяемыеПризнакиУчета = Новый Структура();
		ПроверяемыеПризнакиУчета.Вставить("НДС", Новый Структура("Счет, УчетПоКПС",
			"СчетРасчетов",
			"КПССчетРасчетов"));
		
		Если ДокументОбъект["ВходящийНДС"] Тогда
			ПроверяемыеРеквизиты.Добавить("НДС.СчетКредита");
		Иначе
			ПроверяемыеРеквизиты.Добавить("НДС.СчетДебета");
			ПроверяемыеРеквизиты.Добавить("НДС.КЭКСчетДебета");
			
			КолонкиСубконто = Новый Соответствие();
			КолонкиСубконто.Вставить("Счет", "СчетДебета");
			КолонкиСубконто.Вставить("Субконто1", "СубконтоСчетДебета1");
			КолонкиСубконто.Вставить("Субконто2", "СубконтоСчетДебета2");
			КолонкиСубконто.Вставить("Субконто3", "СубконтоСчетДебета3");
			ПроверяемыеСубконто = Новый Структура("НДС", КолонкиСубконто);
		КонецЕсли;
		
		
	ИначеЕсли ДокументОбъект.РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны Тогда
		//
		// Раздел учета "Имущество казны"
		//
		ШапкаДокумента = РежимВводаОстатков_СтруктураШапкиДокумента();
		ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);

		ЗаполнитьСписокПроверяемыхОбязательныхРеквизитов_ИмуществоКазны(
			ШапкаДокумента,
			ПроверяемыеРеквизиты,
			ПроверяемыеСубконто,
			ПроверяемыеПризнакиУчета,
			ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
			ПеренаправлениеВыводаСообщений_Реквизиты,
			ИсключаемыеРеквизиты);
		
		// Переопределяем номера строк в ОС_Амортизация для корректного вывода сообщений
		ПереопределеннаяОСАмортизация = ПолнаяТабличнаяЧастьОС_ПолучитьТаблицуОСАмортизацияДляПроверкиЗаполнения(
			ДокументОбъект,
			ПроверяемыеРеквизиты,
			ИсключаемыеРеквизиты);
		ПереопределяемыеТабличныеЧасти = Новый Структура();
		ПереопределяемыеТабличныеЧасти.Вставить("ОС_Амортизация", ПереопределеннаяОСАмортизация);
		
	КонецЕсли;
	
	ПараметрыПроверки = Новый Структура();
	ПараметрыПроверки.Вставить("ПроверяемыеРеквизиты",							ПроверяемыеРеквизиты);
	ПараметрыПроверки.Вставить("ИсключаемыеРеквизиты",							ИсключаемыеРеквизиты);
	ПараметрыПроверки.Вставить("ПроверяемыеСубконто",							ПроверяемыеСубконто);
	ПараметрыПроверки.Вставить("ПроверяемыеПризнакиУчета",						ПроверяемыеПризнакиУчета);
	ПараметрыПроверки.Вставить("ПеренаправлениеВыводаСообщений_ТабличныеЧасти",	ПеренаправлениеВыводаСообщений_ТабличныеЧасти);
	ПараметрыПроверки.Вставить("ПеренаправлениеВыводаСообщений_Реквизиты",		ПеренаправлениеВыводаСообщений_Реквизиты);
	ПараметрыПроверки.Вставить("ПереопределяемыеТабличныеЧасти",				ПереопределяемыеТабличныеЧасти);
	ПараметрыПроверки.Вставить("МаксКолвоСообщений",							МаксКолвоСообщений);
	ПараметрыПроверки.Вставить("ВыводитьСообщения",								Истина);
	
	РеквизитыЗаполнены = ОбщегоНазначенияБГУ.УказанныеРеквизитыЗаполнены(ДокументОбъект, ПараметрыПроверки, ВозвратРезультатПроверки);
	
    Возврат РеквизитыЗаполнены;
	
КонецФункции

Процедура ИсключитьИзПроверяемыхРеквизитов(ПроверяемыеРеквизиты, ИсключаемыеПоля = Неопределено)
	
	// Удаляем из проверяемых те реквизиты, которые явно указаны в ИсключаемыеПоля,
	// а также находящиеся вне таблиц ОС_Основная и ОС_Амортизация
	
	ПроверятьИсключаемыеПоля = НЕ (ИсключаемыеПоля = Неопределено);
	
	Количество = ПроверяемыеРеквизиты.Количество();
	
	Для сч = 1 По Количество Цикл
		Индекс = Количество - сч;
		ПолноеИмяРеквизита = ПроверяемыеРеквизиты[Индекс];
		
		ВремИндекс = Найти(ПолноеИмяРеквизита, ".");
		Если ВремИндекс > 0 Тогда
			ИмяТаблЧасти = ВРЕГ(Лев(ПолноеИмяРеквизита, ВремИндекс - 1));
			ИмяРеквизита = Сред(ПолноеИмяРеквизита, ВремИндекс + 1);
		Иначе
			ИмяТаблЧасти = "";
			ИмяРеквизита = ПолноеИмяРеквизита;
		КонецЕсли;
		
		// Причина исключения №1
		ИсключитьИзЗаТаблЧасти = НЕ ИмяТаблЧасти = ""
			И НЕ ИмяТаблЧасти = "ОС_ОСНОВНАЯ"
			И НЕ ИмяТаблЧасти = "ОС_АМОРТИЗАЦИЯ";
		
		// Причина исключения №2
		Если ПроверятьИсключаемыеПоля Тогда
			Поиск = Новый Структура("ПолноеИмя", ПолноеИмяРеквизита);
			ИсключитьИзЗаЯвногоУказания = ИсключаемыеПоля.НайтиСтроки(Поиск).Количество() > 0;
		Иначе
			ИсключитьИзЗаЯвногоУказания = Ложь;
		КонецЕсли;
		
		ИсключитьРеквизит = ИсключитьИзЗаТаблЧасти ИЛИ ИсключитьИзЗаЯвногоУказания;
		
		Если ИсключитьРеквизит Тогда
			ПроверяемыеРеквизиты.Удалить(Индекс);
		Иначе
			// Убираем имя табл.части из полных имен оставшихся проверяемых реквизитов:
			ПроверяемыеРеквизиты[Индекс] = ИмяРеквизита;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Заполнение временных таблиц
Функция ТекстЗапроса_РеквизитыШапки(ИменаРеквизитов, ИндексПоследнегоЗапроса)
	
	ИндексПоследнегоЗапроса	= 0;
	
	// Имя временной таблицы, в которую будут загружены указанные реквизиты шапки документа:
	ИмяВременнойТаблицы = "ШапкаДокумента";
	// Имя параметра запроса, в котором хранится таблица значений для загрузки в эту врем.таблицу:
	ИмяПараметраЗапроса = ИмяВременнойТаблицы;
	
	ИмяТаблицы = "ТЗ";
	ТекстВыбрать = "";
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		ТекстВыбрать = ТекстВыбрать + ?(ТекстВыбрать="", "", ",
			|	") + ИмяТаблицы + "." + ИмяРеквизита + "	КАК " + ИмяРеквизита;
	КонецЦикла;
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Реквизиты шапки документа
	|//
	|ВЫБРАТЬ
	|	" + ТекстВыбрать + "
	|ПОМЕСТИТЬ
	|	" + ИмяВременнойТаблицы + "
	|ИЗ
	|	&" + ИмяПараметраЗапроса + "	КАК " + ИмяТаблицы + "
	|;";
	
КонецФункции
Функция ТекстЗапроса_ИсходнаяТабличнаяЧасть(ИмяТаблЧасти, ИменаКолонок, ИндексПоследнегоЗапроса)
	
	ИндексПоследнегоЗапроса	= 0;
	
	// Имя временной таблицы, в которую будут загружены указанные колонки табличной части:
	ИмяВременнойТаблицы = "ТаблЧасть_" + ИмяТаблЧасти;
	// Имя параметра запроса, в котором хранится таблица значений для загрузки в эту врем.таблицу:
	ИмяПараметраЗапроса = ИмяВременнойТаблицы;
	
	ИмяТаблицы = "ТЗ";
	ТекстВыбрать = "";
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		ТекстВыбрать = ТекстВыбрать + ?(ТекстВыбрать="", "", ",
			|	") + ИмяТаблицы + "." + ИмяКолонки + "	КАК " + ИмяКолонки;
	КонецЦикла;
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходная табличная часть
	|//
	|ВЫБРАТЬ
	|	" + ТекстВыбрать + "
	|ПОМЕСТИТЬ
	|	" + ИмяВременнойТаблицы + "
	|ИЗ
	|	&" + ИмяПараметраЗапроса + "	КАК " + ИмяТаблицы + "
	|;";
	
КонецФункции
Функция ТекстЗапроса_ТабличнаяЧастьОСОбщая(ИмяТаблЧасти, ИндексПоследнегоЗапроса)
	
	ИндексПоследнегоЗапроса	= 0;
	
	// Имя временной таблицы, в которую будут загружены указанные колонки табличной части:
	ИмяВременнойТаблицы = "ТаблЧасть_" + ИмяТаблЧасти;
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
