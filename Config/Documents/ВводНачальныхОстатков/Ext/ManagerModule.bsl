		|ИЗ
		|	Документ.ВводНачальныхОстатков.Материалы	КАК Материалы
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	НомераВидовСубконто_СчетаНУ
		|		ПО	Материалы.СчетНУ = НомераВидовСубконто_СчетаНУ.Счет
		|ГДЕ
		|	Материалы.Ссылка = &Ссылка
		|	И	НЕ Материалы.СуммаНУ = 0
		|	И	Материалы.КФО В(&МассивКФОдляНалоговогоУчета)
		|УПОРЯДОЧИТЬ ПО
		|	Материалы.НомерСтроки
		|;";
	КонецЕсли;
	
	// Окончательная настройка текста запроса:
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ВыборПолейСубконто_СчетаБУ>", ВыборПолейСубконто_СчетаБУ);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ВыборПолейСубконто_СчетаНУ>", ВыборПолейСубконто_СчетаНУ);
	ЗапросДвижения.Текст = ТекстЗапроса;
	
	// Выполняем запросы:
	РезультатыДвижения = ЗапросДвижения.ВыполнитьПакет();
	
	// Сначала бух.учет:
	Если ОтражатьВБухгалтерскомУчете Тогда
		Выборка = РезультатыДвижения[ИндексРезультата_БухУчет].Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяПроводка = ТаблицаПроводок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяПроводка, Выборка);
			НоваяПроводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяПроводка.СчетДт, НоваяПроводка.СчетКт);
		КонецЦикла;
	КонецЕсли;
	
	// Теперь нал.учет ОСН:
	Если ОтражатьВНалоговомУчетеОСН Тогда
		Выборка = РезультатыДвижения[ИндексРезультата_НалУчетОСН].Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяПроводка = ТаблицаПроводок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяПроводка, Выборка);
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТаблицаПроводок;

КонецФункции

// Устарела. Для отражения в учете ввода начальных остатков ОС предусмотрен источник данных ВводОстатковОсновныхСредств
// см. БухгалтерскиеОперацииИсточникиДанных.ВводОстатковОсновныхСредств(...),
// см. БухгалтерскиеОперацииИсточникиДанных.ВводОстатковОсновныхСредствУСН(...).
//
Функция ПодготовитьТаблицуПроводок_ОС(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ) Экспорт
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	РезультатПроверки = Неопределено;
	РежимВводаОстатков_ПроверитьЗаполнение(ДокументОбъект, РезультатПроверки);
	
	НомераТаблиц = Новый Структура;
	Запрос = Новый Запрос;
	
	Если ДокументОбъект.ОтражатьВБухгалтерскомУчете Тогда
		
		НомераТаблиц.Вставить("ВременнаяТаблицаДанныеБУ", НомераТаблиц.Количество());
		НомераТаблиц.Вставить("ТаблицаВводОстатковБУ", НомераТаблиц.Количество());
		НомераТаблиц.Вставить("ТаблицаВводОстатковАмортизацииБУ", НомераТаблиц.Количество());
		
		СчетИКЭКАмортизации = ПолучитьСчетИКЭКАмортизации(ДокументОбъект);
		//---
		// КЭК0
		//---
		Если ИспользоватьКЭК0(
			ДокументОбъект["Организация"],
			ДокументОбъект["ИФО"],
			ДокументОбъект["КФО"],
			ДокументОбъект["Дата"],
			СчетИКЭКАмортизации["Счет"]) Тогда
			СчетИКЭКАмортизации.Вставить("КЭК", БухгалтерскийУчетПовтИсп.КЭК0());
		КонецЕсли;
		
		Запрос.УстановитьПараметр("СчетАмортизации",	СчетИКЭКАмортизации["Счет"]);
		Запрос.УстановитьПараметр("КЭКАмортизации",		СчетИКЭКАмортизации["КЭК"]);
		Запрос.УстановитьПараметр("Счет000",			БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("000"));
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОС_Основная.ОС КАК ОС,
		|	ОС_Основная.ЦМО КАК ЦМО,
		|	ОС_Основная.ИнвНомерОС КАК ИнвНомер,
		|	&СчетАмортизации КАК СчетАмортизации,
		|	&КЭКАмортизации КАК КЭКАмортизации,
		|	ОС_Основная.Подразделение КАК Подразделение,
		|	СУММА(ОС_Основная.Сумма) КАК Сумма,
		|	СУММА(ОС_Основная.Количество) КАК Количество,
		|	СУММА(ОС_Основная.СуммаАмортизации) КАК СуммаАмортизации
		|ПОМЕСТИТЬ ВременнаяТаблицаДанныеБУ
		|ИЗ
		|	Документ.ВводНачальныхОстатков.ОС_Основная КАК ОС_Основная
		|ГДЕ
		|	ОС_Основная.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ОС_Основная.ОС,
		|	ОС_Основная.ЦМО,
		|	ОС_Основная.ИнвНомерОС,
		|	&СчетАмортизации,
		|	&КЭКАмортизации,
		|	ОС_Основная.Подразделение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&Период КАК Период,
		|	&Организация КАК Организация,
		|	&КФО КАК КФО,
		|	&ИФО КАК ИФО,
		|	&ВидПервичногоДокумента КАК ВидПервичногоДокумента,
		|	&ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
		|	&НомерПервичногоДокумента КАК НомерПервичногоДокумента,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.ВводОстатков) КАК ХарактеристикаДвиженияДт,
		|	&Счет000 КАК СчетКт,
		|	&СчетОС КАК СчетДт,
		|	&КПССчетаОС КАК КПСДт,
		|	&КЭКСчетаОС КАК КЭКДт,
		|	ДанныеБух.Количество КАК КоличествоДт,
		|	ДанныеБух.ОС КАК СубконтоДт1,
		|	ДанныеБух.ЦМО КАК СубконтоДт2,
		|	ДанныеБух.Подразделение КАК ПодразделениеДт,
		|	ДанныеБух.Сумма КАК Сумма,
		|	ДанныеБух.ОС КАК ОС,
		|	ДанныеБух.ИнвНомер КАК ИнвНомер,
		|	ИСТИНА КАК Активность
		|ИЗ
		|	ВременнаяТаблицаДанныеБУ КАК ДанныеБух
		|ГДЕ
		|	НЕ ДанныеБух.Сумма = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&Период КАК Период,
		|	&Организация КАК Организация,
		|	&КФО КАК КФО,
		|	&ИФО КАК ИФО,
		|	&ВидПервичногоДокумента КАК ВидПервичногоДокумента,
		|	&ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
		|	&НомерПервичногоДокумента КАК НомерПервичногоДокумента,
		|	&Счет000 КАК СчетДт,
		|	ДанныеБух.СчетАмортизации КАК СчетКт,
		|	ДанныеБух.КЭКАмортизации КАК КЭККт,
		|	&КПССчетаОС КАК КПСКт,
		|	ДанныеБух.ОС КАК СубконтоКт1,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.ВводОстатков) КАК ХарактеристикаДвиженияКт,
		|	ДанныеБух.Подразделение КАК ПодразделениеКт,
		|	ДанныеБух.СуммаАмортизации КАК Сумма,
		|	ДанныеБух.ОС КАК ОС,
		|	ДанныеБух.ИнвНомер КАК ИнвНомер,
		|	ИСТИНА КАК Активность
		|ИЗ
		|	ВременнаяТаблицаДанныеБУ КАК ДанныеБух
		|ГДЕ
		|	НЕ ДанныеБух.СуммаАмортизации = 0";
		
	КонецЕсли;
	
	Если ДокументОбъект.ОтражатьВНалоговомУчете Тогда
		
		НомераТаблиц.Вставить("ВременнаяТаблицаДанныеНУ", НомераТаблиц.Количество());
		НомераТаблиц.Вставить("ТаблицаВводОстатковНУ", НомераТаблиц.Количество());
		НомераТаблиц.Вставить("ТаблицаВводОстатковАмортизацииНУ", НомераТаблиц.Количество());
		
		Запрос.Текст = ?(ЗначениеЗаполнено(Запрос.Текст), Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета(), "") +
		"ВЫБРАТЬ
		|	ОС_Амортизация.ОС КАК ОС,
		|	ОС_Амортизация.ПорядокВключенияСтоимостиВСоставРасходовНУ КАК ПорядокВключенияСтоимостиВСоставРасходовНУ,
		|	ОС_Амортизация.НачислятьАмортизациюНУ КАК НачислятьАмортизациюНУ,
		|	ОС_Амортизация.ПервоначальнаяСтоимостьНУ КАК ПервоначальнаяСтоимостьНУ,
		|	ОС_Амортизация.СуммаНУ КАК СуммаНУ,
		|	ОС_Амортизация.СуммаНеУчитываетсяНУ КАК СуммаНеУчитываетсяНУ,
		|	ОС_Амортизация.СуммаЕНВД КАК СуммаЕНВД,
		|	ОС_Амортизация.СуммаАмортизацииНУ КАК СуммаАмортизацииНУ,
		|	ОС_Амортизация.СуммаАмортизацииНеУчитываетсяНУ КАК СуммаАмортизацииНеУчитываетсяНУ,
		|	ОС_Амортизация.СуммаАмортизацииЕНВД КАК СуммаАмортизацииЕНВД
		|ПОМЕСТИТЬ ВременнаяТаблицаДанныеНУ
		|ИЗ
		|	Документ.ВводНачальныхОстатков.ОС_Амортизация КАК ОС_Амортизация
		|ГДЕ
		|	ОС_Амортизация.Ссылка = &Ссылка
		|	И НЕ ОС_Амортизация.ОС = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОС_Амортизация.ОС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&Период КАК Период,
		|	&Организация КАК Организация,
		|	&КФО КАК КФО,
		|	&ИФО КАК ИФО,
		|	&ВидПервичногоДокумента КАК ВидПервичногоДокумента,
		|	&ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
		|	&НомерПервичногоДокумента КАК НомерПервичногоДокумента,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.ВводОстатков) КАК ХарактеристикаДвиженияДт,
		|	ВЫБОР
		|		КОГДА &СчетОС В (&Счет101)
		|			ТОГДА &СчетОсновныеСредстваНУ
		|		КОГДА &СчетОС В (&Счет102)
		|			ТОГДА &СчетНематериальныеАктивыНУ
		|		ИНАЧЕ &Счет00
		|	КОНЕЦ КАК СчетДт,
		|	ДанныеНал.ОС КАК СубконтоДт1,
		|	&Счет00 КАК СчетКт,
		|	ДанныеНал.СуммаНУ КАК Сумма,
		|	ДанныеНал.СуммаНеУчитываетсяНУ КАК СуммаНеУчитываетсяНУ,
		|	ДанныеНал.СуммаЕНВД КАК СуммаЕНВД,
		|	ДанныеНал.ОС КАК ОС,
		|	ОС_Основная.ИнвНомерОС КАК ИнвНомер,
		|	ИСТИНА КАК Активность
		|ИЗ
		|	ВременнаяТаблицаДанныеНУ КАК ДанныеНал
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводНачальныхОстатков.ОС_Основная КАК ОС_Основная
		|		ПО (ОС_Основная.Ссылка = &Ссылка)
		|			И (ОС_Основная.ОС = ДанныеНал.ОС)
		|ГДЕ
		|	НЕ(ДанныеНал.ПорядокВключенияСтоимостиВСоставРасходовНУ = ЗНАЧЕНИЕ(Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету)
		|				И ОС_Основная.СостояниеОС = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&Период КАК Период,
		|	&Организация КАК Организация,
		|	&КФО КАК КФО,
		|	&ИФО КАК ИФО,
		|	&ВидПервичногоДокумента КАК ВидПервичногоДокумента,
		|	&ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
		|	&НомерПервичногоДокумента КАК НомерПервичногоДокумента,
		|	&Счет00 КАК СчетДт,
		|	ВЫБОР
		|		КОГДА &СчетОС В (&Счет101)
		|			ТОГДА &СчетАмортизацияОсновныхСредствНУ
		|		КОГДА &СчетОС В (&Счет102)
		|			ТОГДА &СчетАмортизацияНематериальныхАктивовНУ
		|		ИНАЧЕ &Счет00
		|	КОНЕЦ КАК СчетКт,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.ВводОстатков) КАК ХарактеристикаДвиженияКт,
		|	ДанныеНал.ОС КАК СубконтоКт1,
		|	ДанныеНал.СуммаАмортизацииНУ КАК Сумма,
		|	ДанныеНал.СуммаАмортизацииНеУчитываетсяНУ КАК СуммаНеУчитываетсяНУ,
		|	ДанныеНал.СуммаАмортизацииЕНВД КАК СуммаЕНВД,
		|	ДанныеНал.ОС КАК ОС,
		|	ОС_Основная.ИнвНомерОС КАК ИнвНомер,
		|	ИСТИНА КАК Активность
		|ИЗ
		|	ВременнаяТаблицаДанныеНУ КАК ДанныеНал
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводНачальныхОстатков.ОС_Основная КАК ОС_Основная
		|		ПО (ОС_Основная.Ссылка = &Ссылка)
		|			И (ОС_Основная.ОС = ДанныеНал.ОС)
		|ГДЕ
		|	ДанныеНал.ПорядокВключенияСтоимостиВСоставРасходовНУ = ЗНАЧЕНИЕ(Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации)
		|	И НЕ(ДанныеНал.СуммаАмортизацииНУ = 0
		|				И ДанныеНал.СуммаАмортизацииНеУчитываетсяНУ = 0
		|				И ДанныеНал.СуммаАмортизацииЕНВД = 0)";
		
		Запрос.УстановитьПараметр("Счет101"									, БухгалтерскийУчет.СписокСчетов("101.00"));
		Запрос.УстановитьПараметр("Счет102"									, БухгалтерскийУчет.СписокСчетов("102.00"));
		Запрос.УстановитьПараметр("Счет00"									, БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("00"));
		Запрос.УстановитьПараметр("СчетОсновныеСредстваНУ"					, БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н01"));
		Запрос.УстановитьПараметр("СчетНематериальныеАктивыНУ"				, БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н04"));
		Запрос.УстановитьПараметр("СчетАмортизацияОсновныхСредствНУ"		, БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н02"));
		Запрос.УстановитьПараметр("СчетАмортизацияНематериальныхАктивовНУ"	, БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н05"));
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка",			ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Период",			ДокументОбъект.Дата);
	Запрос.УстановитьПараметр("Организация",	ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("КФО",			ДокументОбъект.КФО);
	Запрос.УстановитьПараметр("ИФО",			ДокументОбъект.ИФО);
	Запрос.УстановитьПараметр("СчетОС",			ДокументОбъект.Счет);
	Запрос.УстановитьПараметр("КПССчетаОС",		ДокументОбъект.КПС);
	Запрос.УстановитьПараметр("КЭКСчетаОС",		ДокументОбъект.КЭК);
	
	Запрос.УстановитьПараметр("ВидПервичногоДокумента",		"Бухгалтерская справка 0504833");
	Запрос.УстановитьПараметр("ДатаПервичногоДокумента",	ДокументОбъект.Дата);
	Запрос.УстановитьПараметр("НомерПервичногоДокумента",	ДокументОбъект.Номер);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Если ДокументОбъект.ОтражатьВБухгалтерскомУчете Тогда
		
		// 1. Остатки
		Выборка = Результат[НомераТаблиц.ТаблицаВводОстатковБУ].Выбрать();
		Пока Выборка.Следующий() Цикл
			ПроводкаБУ = ТаблицаПроводок.Добавить();
