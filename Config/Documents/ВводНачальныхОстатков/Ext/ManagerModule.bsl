Функция ПустаяТаблицаВводОстатковОсновныхСредств() Экспорт

	ОписаниеТипаСубконто   = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счета и аналитика учета основных средств.
	ПустаяТаблица.Колонки.Добавить("ОсновноеСредство",  Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ПустаяТаблица.Колонки.Добавить("ИнвентарныйНомер",  Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ПустаяТаблица.Колонки.Добавить("ЦМО",               Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	ПустаяТаблица.Колонки.Добавить("СчетУчетаОС",       Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КЭК",               Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("СчетАмортизацииОС", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КЭКАмортизации",    Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	// Дополнительные реквизиты.
	ПустаяТаблица.Колонки.Добавить("ПорядокПогашенияСтоимости",
		Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокПогашенияСтоимостиОС")); // БУ
	ПустаяТаблица.Колонки.Добавить("ПорядокВключенияСтоимостиВСоставРасходовНУ",
		Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокВключенияСтоимостиОСВСоставРасходовНУ")); // НУ
	ПустаяТаблица.Колонки.Добавить("ПорядокВключенияСтоимостиВСоставРасходовУСН",
		Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН")); // УСН
	ПустаяТаблица.Колонки.Добавить("СостояниеОС",             Новый ОписаниеТипов("ПеречислениеСсылка.СостоянияОС"));
	ПустаяТаблица.Колонки.Добавить("ДатаПринятияКУчету",      Новый ОписаниеТипов("Дата"));
	ПустаяТаблица.Колонки.Добавить("ДатаВводаВЭксплуатацию",  Новый ОписаниеТипов("Дата"));
	// Бухгалтерский учет.
	ПустаяТаблица.Колонки.Добавить("Количество",              ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("Сумма",                   ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаАмортизации",        ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("ПервоначальнаяСтоимость", ОписаниеТипаСуммы);
	// Налоговый учет по налогу на прибыль.
	ПустаяТаблица.Колонки.Добавить("СуммаНУ",                         ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУ",            ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВД",                       ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаАмортизацииНУ",              ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаАмортизацииНеУчитываетсяНУ", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаАмортизацииЕНВД",            ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("ПервоначальнаяСтоимостьНУ",       ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Ввод остатков основных средств".
//
Функция ТаблицаВводОстатковОсновныхСредств(ДокументСсылка, Реквизиты, Отказ) Экспорт
	
	ТаблицаВводОстатков = ПустаяТаблицаВводОстатковОсновныхСредств();
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат ТаблицаВводОстатков;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДетальноПоИнвНомерам.Ссылка,
	|	""ОС_Основная"" КАК ИмяСписка,
	|	""Основные средства"" КАК СинонимСписка,
	|	ДетальноПоИнвНомерам.НомерСтроки КАК НомерСтроки,
	|	ДетальноПоИнвНомерам.Ссылка.ИФО КАК ИФО,
	|	ДетальноПоИнвНомерам.Ссылка.КФО КАК КФО,
	|	ДетальноПоИнвНомерам.Ссылка.КПС КАК КПС,
	|	ДетальноПоИнвНомерам.Подразделение КАК Подразделение,
	|	ДетальноПоИнвНомерам.ОС КАК ОсновноеСредство,
	|	ДетальноПоИнвНомерам.ИнвНомерОС КАК ИнвентарныйНомер,
	|	ДетальноПоИнвНомерам.ЦМО КАК ЦМО,
	|	ДетальноПоИнвНомерам.Ссылка.Счет КАК СчетУчетаОС,
	|	ДетальноПоИнвНомерам.Ссылка.КЭК КАК КЭК,
	|	ДетальноПоИнвНомерам.СостояниеОС КАК СостояниеОС,
	|	СводноПоОбъектам.ДатаПринятияКУчету,
	|	ДетальноПоИнвНомерам.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
	|	СводноПоОбъектам.ПорядокПогашенияСтоимости,
	|	СводноПоОбъектам.ПорядокВключенияСтоимостиВСоставРасходовНУ,
	|	СводноПоОбъектам.ПорядокВключенияСтоимостиВСоставРасходовУСН,
	|	ДетальноПоИнвНомерам.Количество,
	|	ДетальноПоИнвНомерам.Сумма,
	|	ДетальноПоИнвНомерам.СуммаАмортизации,
	|	ДетальноПоИнвНомерам.ПервоначальнаяСтоимость,
	|	СводноПоОбъектам.СуммаНУ,
	|	СводноПоОбъектам.СуммаНеУчитываетсяНУ,
	|	СводноПоОбъектам.СуммаЕНВД,
	|	СводноПоОбъектам.СуммаАмортизацииНУ,
	|	СводноПоОбъектам.СуммаАмортизацииНеУчитываетсяНУ,
	|	СводноПоОбъектам.СуммаАмортизацииЕНВД,
	|	СводноПоОбъектам.ПервоначальнаяСтоимостьНУ
	|ИЗ
	|	Документ.ВводНачальныхОстатков.ОС_Основная КАК ДетальноПоИнвНомерам
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводНачальныхОстатков.ОС_Амортизация КАК СводноПоОбъектам
	|		ПО (ДетальноПоИнвНомерам.Ссылка = &Ссылка)
	|			И (СводноПоОбъектам.Ссылка = &Ссылка)
	|			И ДетальноПоИнвНомерам.ОС = СводноПоОбъектам.ОС
	|ГДЕ
	|	ДетальноПоИнвНомерам.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДетальноПоИнвНомерам.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	СчетИКЭКАмортизации = ПолучитьСчетИКЭКАмортизации(ДокументСсылка);
	Если ИспользоватьКЭК0(ДокументСсылка.Организация, ДокументСсылка.ИФО, ДокументСсылка.КФО, ДокументСсылка.Дата,
		СчетИКЭКАмортизации.Счет) Тогда
		СчетИКЭКАмортизации.Вставить("КЭК", БухгалтерскийУчетПовтИсп.КЭК0());
	КонецЕсли;
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаТаблицы Из ТаблицаРезультат Цикл
		
		НоваяСтрока = ТаблицаВводОстатков.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		
		НоваяСтрока.СчетАмортизацииОС = СчетИКЭКАмортизации.Счет;
		НоваяСтрока.КЭКАмортизации    = СчетИКЭКАмортизации.КЭК;
		
	КонецЦикла;
	
	Возврат ТаблицаВводОстатков;
	
КонецФункции

Процедура ДобавитьПриНеобходимостиВременнуюТаблицу(ИмяВременнойТаблицы, Запрос, НомераТаблиц)
	
	Если ИмяВременнойТаблицы = "ОС_Основная" Тогда
		
		ИмяВременнойТаблицы = "ВременнаяТаблицаОС_Основная";
			
		Если НЕ НомераТаблиц.Свойство(ИмяВременнойТаблицы) Тогда
			ДобавитьТекстЗапроса(Запрос.Текст, "
			|////////////////////////////////////////////////////////////////////////////////
			|// Табличная часть ОС_Основная
			|// (подготовка к дальнейшим движениям)
			|ВЫБРАТЬ
			|	*
			|ПОМЕСТИТЬ
			|	ОС_Основная
			|ИЗ
			|	Документ.ВводНачальныхОстатков.ОС_Основная КАК ОС_Основная
			|ГДЕ
			|	ОС_Основная.Ссылка = &ДокСсылка
			|;");
				
			НомераТаблиц.Вставить(ИмяВременнойТаблицы, НомераТаблиц.Количество());
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяВременнойТаблицы = "ОС_Амортизация" Тогда
		
		ИмяВременнойТаблицы = "ВременнаяТаблицаОС_Амортизация";
			
		Если НЕ НомераТаблиц.Свойство(ИмяВременнойТаблицы) Тогда
			ДобавитьТекстЗапроса(Запрос.Текст, "
			|////////////////////////////////////////////////////////////////////////////////
			|// Табличная часть ОС_Амортизация
			|// (подготовка к дальнейшим движениям)
			|ВЫБРАТЬ
			|	*,
			|	ВЫБОР
			|		КОГДА ОС_Амортизация.ДатаПринятияКУчету = &ПустаяДата ТОГДА
			|			ОС_Амортизация.Ссылка.Дата
			|		ИНАЧЕ
			|			ОС_Амортизация.ДатаПринятияКУчету
			|	КОНЕЦ	КАК ПериодПринятиеКУчету			
			|ПОМЕСТИТЬ
			|	ОС_Амортизация
			|ИЗ
			|	Документ.ВводНачальныхОстатков.ОС_Амортизация КАК ОС_Амортизация
			|ГДЕ
			|	ОС_Амортизация.Ссылка = &ДокСсылка
			|;");
				
			НомераТаблиц.Вставить(ИмяВременнойТаблицы, НомераТаблиц.Количество());
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяВременнойТаблицы = "ПолнаяТабличнаяЧастьОС" Тогда
		
		ИмяВременнойТаблицы = "ВременнаяТаблицаПолнаяТабличнаяЧастьОС";
			
		Если НЕ НомераТаблиц.Свойство(ИмяВременнойТаблицы) Тогда
			ДобавитьТекстЗапроса(Запрос.Текст, "
			|////////////////////////////////////////////////////////////////////////////////
			|// Полная табличная часть ОС
			|// (подготовка к дальнейшим движениям)
			|ВЫБРАТЬ
			|	*,
			|	ВЫБОР
			|		КОГДА ОС_Амортизация.ДатаПринятияКУчету = &ПустаяДата ТОГДА
			|			ОС_Амортизация.Ссылка.Дата
			|		ИНАЧЕ
			|			ОС_Амортизация.ДатаПринятияКУчету
			|	КОНЕЦ	КАК ПериодПринятиеКУчету,			
			|	ВЫБОР
			|		КОГДА ОС_Амортизация.ДатаПринятияКУчету = &ПустаяДата
			|			ТОГДА ОС_Амортизация.Ссылка.Дата
			|		ИНАЧЕ ВЫБОР
			|				КОГДА НАЧАЛОПЕРИОДА(ОС_Основная.ДатаВводаВЭксплуатацию, МЕСЯЦ) >= НАЧАЛОПЕРИОДА(ОС_Амортизация.ДатаПринятияКУчету, МЕСЯЦ)
			|					ТОГДА ВЫБОР
			|							КОГДА ОС_Амортизация.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)
			|								ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(ОС_Амортизация.ДатаПринятияКУчету, МЕСЯЦ, 1), МЕСЯЦ)
			|							ИНАЧЕ ОС_Основная.ДатаВводаВЭксплуатацию
			|						КОНЕЦ
			|				ИНАЧЕ ОС_Амортизация.ДатаПринятияКУчету
			|			КОНЕЦ
			|	КОНЕЦ КАК ПериодАмортизация			
			|ПОМЕСТИТЬ
			|	ПолнаяТабличнаяЧастьОС
			|ИЗ
			|	Документ.ВводНачальныхОстатков.ОС_Основная	КАК ОС_Основная
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	Документ.ВводНачальныхОстатков.ОС_Амортизация	КАК ОС_Амортизация
			|		ПО	ОС_Основная.Ссылка	= &ДокСсылка
			|		И	ОС_Основная.Ссылка	= ОС_Амортизация.Ссылка
			|		И	ОС_Основная.ОС		= ОС_Амортизация.ОС
			|;");
				
			НомераТаблиц.Вставить(ИмяВременнойТаблицы, НомераТаблиц.Количество());
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьТекстЗапроса(ПолныйТекстЗапроса, Знач ДобавляемыйТекст) Экспорт
	
	ДобавляемыйСокр	= СокрЛП(ДобавляемыйТекст);
	ПолныйСокр		= СокрП(ПолныйТекстЗапроса);
	
	ЕстьРазделительВНачалеДобавляемогоТекста	= (Лев(ДобавляемыйСокр, 1) = ";");
	ЕстьКомментарийВНачалеДобавляемогоТекста	= (Лев(ДобавляемыйСокр, 2) = "//");
	ЕстьРазделительВКонцеПолногоТекста			= (Прав(ПолныйСокр, 1) = ";");
	
	// Добавляем разделитель
	Если НЕ ПустаяСтрока(ПолныйСокр) И НЕ ЕстьРазделительВНачалеДобавляемогоТекста И НЕ ЕстьРазделительВКонцеПолногоТекста Тогда
		ПолныйТекстЗапроса = ПолныйТекстЗапроса + "
			|;
			|";
	КонецЕсли;
	
	// Добавляем визуальную разбивку
	Если НЕ ЕстьКомментарийВНачалеДобавляемогоТекста Тогда
		ПолныйТекстЗапроса = ПолныйТекстЗапроса + "
			|////////////////////////////////////////////////////////////////////////////////
			|";
	КонецЕсли;
	
	ПолныйТекстЗапроса = ПолныйТекстЗапроса + ДобавляемыйТекст;
	
КонецПроцедуры

//---
// Раздел учета "Основные средства в оперативном учете"
//---

Процедура ЗаполнитьСписокПроверяемыхОбязательныхРеквизитов_ОСВОперУчете(
			ШапкаДокумента,
			ПроверяемыеРеквизиты,
			ПроверяемыеСубконто,
			ПроверяемыеПризнакиУчета,
			ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
			ПеренаправлениеВыводаСообщений_Реквизиты,
			ИсключаемыеРеквизиты,
			ЭтоПроверкаВФормеРедактированияСтроки = Ложь) Экспорт
			
	// Инициализация
	Если ПроверяемыеРеквизиты = Неопределено Тогда
		ПроверяемыеРеквизиты = Новый Массив();
	КонецЕсли;
	ИсключаемыеРеквизиты			= Новый Массив();
	ПрименяемыйРежимВводаОстатков	= Новый Структура();
	
	// Подготовка
	СвойстваСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШапкаДокумента["Счет"],
		"УчетПоПодразделениям, УчетПоКПС, УчетПоКЭК");
	
	ОбязательноУказатьКонтрагента = ОбязательноУказатьКонтрагента_ОСВОперУчете(ШапкаДокумента);
	
	// Реквизиты шапки
	ПроверяемыеРеквизиты.Добавить("Организация");
	ПроверяемыеРеквизиты.Добавить("Счет");
	ПроверяемыеРеквизиты.Добавить("КФО");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ПроверяемыеРеквизиты.Добавить("ИФО");
	КонецЕсли;
	Если СвойстваСчета["УчетПоКПС"] = Истина Тогда
		ПроверяемыеРеквизиты.Добавить("КПС");
	КонецЕсли;
	Если СвойстваСчета["УчетПоКЭК"] = Истина Тогда
		ПроверяемыеРеквизиты.Добавить("КЭК");
	КонецЕсли;
	Если ПодразделениеОбязательноКЗаполнению(ШапкаДокумента, СвойстваСчета) Тогда
		ПроверяемыеРеквизиты.Добавить("ПодразделениеОрганизации");
	КонецЕсли;
	Если ОбязательноУказатьКонтрагента Тогда
		ПроверяемыеРеквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	// Реквизиты табличный частей
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.ОС");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.Количество");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.Сумма");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.ЦМО");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.СостояниеОС");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.ПервоначальнаяСтоимость");
	
	ПроверяемыеРеквизиты.Добавить("ОС_Амортизация.ДатаПринятияКУчету");
	
	ПроверяемыеРеквизиты.Добавить("КапРемонтОС.ОС");
	ПроверяемыеРеквизиты.Добавить("КапРемонтОС.Дата");
	ПроверяемыеРеквизиты.Добавить("КапРемонтОС.Сумма");
	
	ПеренаправлениеВыводаСообщений_ТабличныеЧасти = Новый Структура();
	ПеренаправлениеВыводаСообщений_ТабличныеЧасти.Вставить("ОС_Амортизация",	"ОС_Основная");
	ПеренаправлениеВыводаСообщений_ТабличныеЧасти.Вставить("КапРемонтОС",		"КапРемонтОСОтбор");
	
	Если ЭтоПроверкаВФормеРедактированияСтроки = Истина Тогда
		ИсключитьИзПроверяемыхРеквизитов(ПроверяемыеРеквизиты);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПараметрыПроверкиПоСтроке_ОСВОперУчете(ШапкаДокумента) Экспорт
	
	СчетДокумента		= ШапкаДокумента["Счет"];
	ЭтоСчет21			= БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетДокумента, "21");
	ЭтоСчетБиблФонда	= УправлениеОсновнымиСредствамиКлиентСервер.ЭтоБиблиотечныйФонд(СчетДокумента);
	
	Результат = Новый Структура();
	Результат.Вставить("ЭтоСчет21",			ЭтоСчет21);
	Результат.Вставить("ЭтоСчетБиблФонда",	ЭтоСчетБиблФонда);
	
	Возврат Результат;
	
КонецФункции

Функция ПроверкаПоСтроке_ОСВОперУчете(СтрокаОС, ПараметрыПроверкиПоСтроке) Экспорт
	
	// Возвращаемое значение
	Результат = Новый Структура();
	
	ОС							= СтрокаОС.ОС;
	Количество					= СтрокаОС.Количество;
	Сумма						= СтрокаОС.Сумма;
	ИнвНомерОС					= СтрокаОС.ИнвНомерОС;
	ГрупповойУчет				= СтрокаОС.ГрупповойУчет;
	СостояниеОС					= СтрокаОС.СостояниеОС;
	ДатаВводаВЭксплуатацию		= СтрокаОС.ДатаВводаВЭксплуатацию;
	
	ЭтоСчет21					= ПараметрыПроверкиПоСтроке["ЭтоСчет21"];
	ЭтоСчетБиблФонда			= ПараметрыПроверкиПоСтроке["ЭтоСчетБиблФонда"];
	
	ПервыйПределОС				= ПараметрыПроверкиПоСтроке["ПрименяемыеПределыСтоимостиОС"]["ПервыйПределОС"];
	ВторойПределОС				= ПараметрыПроверкиПоСтроке["ПрименяемыеПределыСтоимостиОС"]["ВторойПределОС"];
	ИспользуемаяДатаПределовОС	= ПараметрыПроверкиПоСтроке["ПрименяемыеПределыСтоимостиОС"]["ИспользуемаяДата"];
	
	Если НЕ ЗначениеЗаполнено(ВторойПределОС) Тогда
		Текст = НСтр("ru='Не заданы пределы стоимости ОС на дату %1 (см. регистр сведений ""Параметры учета ОС"")'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
			Формат(ИспользуемаяДатаПределовОС, "ДЛФ=Д"));
		ИмяПоляДляВыводаСообщения = "ДатаПринятияКУчету";
		Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
		Возврат Результат;
	КонецЕсли;
	
	Если СостояниеОС = Перечисления.СостоянияОС.ВведеноВЭксплуатацию
		И НЕ ЗначениеЗаполнено(ДатаВводаВЭксплуатацию) Тогда
		
		ТекстСообщения = НСтр("ru='Не задана дата ввода ОС в эксплуатацию'");
		ИмяПоляДляВыводаСообщения = "ДатаВводаВЭксплуатацию";
		Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
		
		Возврат Результат;
	КонецЕсли;
	
	Цена = ?(Количество = 0, 0, Сумма/Количество);
	Если Цена < 0.01 Тогда
		ТекстСообщения = НСтр("ru='Цена ОС менее одной копейки'");
		ИмяПоляДляВыводаСообщения = "Сумма";
		Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
	КонецЕсли;
	
	Если ЭтоСчет21 Тогда
		Если Цена > ПервыйПределОС Тогда
			Текст = НСтр("ru='Цена ОС более %1 рублей, а на счете 21 учитываются ОС стоимостью до %1 рублей включительно'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ПервыйПределОС);
			ИмяПоляДляВыводаСообщения = "ПервоначальнаяСтоимость";
			Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
		КонецЕсли;
	КонецЕсли;
	
	Если ГрупповойУчет Тогда
		Если ЗначениеЗаполнено(ИнвНомерОС) Тогда 
			Если Количество > 1 Тогда
				ТекстСообщения = НСтр("ru='Количество ОС больше 1 для ОС, по которому введен инвентарный номер. Для каждого инвентарного номера нужно ввести свою строку с количеством, равным 1'");
				ИмяПоляДляВыводаСообщения = "Количество";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
			КонецЕсли;
			
		Иначе
			Если ЭтоСчетБиблФонда И Цена > ВторойПределОС Тогда
				Текст = НСтр("ru='Для библиотечного фонда стоимостью более %1 руб. должен быть задан инвентарный номер'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ВторойПределОС);
				ИмяПоляДляВыводаСообщения = "Сумма";
				Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
			КонецЕсли;
		
		КонецЕсли;
		
		Если Цена > ВторойПределОС И ЭтоСчет21 Тогда
			Текст = НСтр("ru='Цена ОС более %1 руб. Групповой учет не возможен'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ВторойПределОС);
			ИмяПоляДляВыводаСообщения = "Сумма";
			Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
		КонецЕсли;
			
	Иначе
		Если Количество > 1 Тогда
			ТекстСообщения = НСтр("ru='Количество ОС больше 1 для ОС, по которому не ведется групповой учет'");
			ИмяПоляДляВыводаСообщения = "Количество";
			Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Печать_ОСВОперУчете_Ведомость(МассивОбъектов, ОбъектыПечати)
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	// Укажем имена реквизитов ТЧ "ОС Основная", выводимых в каждой строке ведомости.
	// Это только часть полей ТЧ.
	СвойстваРеквизитов = Новый Структура("
		|ИнвНомерОС,
		|Количество,
		|ПервоначальнаяСтоимость,
		|Сумма,
		|ЦМО,
		|ДатаВводаВЭксплуатацию");
		
	// Список полей, по которым нужно выводить итоги:
	ИменаИтоговыхПолей = Новый Массив();
	ИменаИтоговыхПолей.Добавить("Сумма");
	ИменаИтоговыхПолей.Добавить("Количество");
	
	ТабДокумент = Получить_Ведомость_ОС(
		МассивОбъектов,
		ОбъектыПечати,
		Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете,
		СвойстваРеквизитов,
		ИменаИтоговыхПолей);
	
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента_ОСВОперУчете(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ЗапросДвижения = Новый Запрос;
	ЗапросДвижения.УстановитьПараметр("ДокСсылка",				ДокументСсылка);
	ЗапросДвижения.УстановитьПараметр("ВалютаРУ",				Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросДвижения.УстановитьПараметр("ПустаяДата",				'00010101');
	ЗапросДвижения.УстановитьПараметр("УчетПоПодразделениям",	УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям());
	
	НомераТаблиц = Новый Структура;
	
	// Нужно использовать временные таблицы с табличными частями
	ДобавитьПриНеобходимостиВременнуюТаблицу("ОС_Основная",				ЗапросДвижения, НомераТаблиц);
	ДобавитьПриНеобходимостиВременнуюТаблицу("ОС_Амортизация",			ЗапросДвижения, НомераТаблиц);
	ДобавитьПриНеобходимостиВременнуюТаблицу("ПолнаяТабличнаяЧастьОС",	ЗапросДвижения, НомераТаблиц);
	
	НомераТаблиц.Вставить("СобытияОС",									НомераТаблиц.Количество());
	НомераТаблиц.Вставить("КапРемонтОС",								НомераТаблиц.Количество());
	НомераТаблиц.Вставить("НомераИнвентарныхКарточек",					НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПервоначальныеСведенияОСБухгалтерскийУчет",	НомераТаблиц.Количество());
	
	ДобавитьТекстЗапроса(ЗапросДвижения.Текст, "
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Движения по рег.свед. СобытияОС
	|//
	|// События 'Принятие к учету':
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация										КАК Организация,
	|	Ссылка.Дата												КАК Период,
	|	ОС														КАК ОсновноеСредство,
	|	ИнвНомерОС												КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)		КАК Событие,
	|	ВЫБОР
	|		КОГДА ДатаПринятияКУчету = &ПустаяДата ТОГДА
	|			Ссылка.Дата
	|		ИНАЧЕ
	|			ДатаПринятияКУчету
	|	КОНЕЦ													КАК ДатаСобытия,
	|	НазваниеДокументаПринятияКУчету							КАК НазваниеДокумента,
	|	НомерДокументаПринятияКУчету							КАК НомерДокумента,
	|	ДатаПринятияКУчету										КАК	ДатаДокумента
	|ИЗ
	|	ПолнаяТабличнаяЧастьОС
	|ГДЕ
	|	НЕ СостояниеОС = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// События 'Ввод в эксплуатацию':
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация										КАК Организация,
	|	Ссылка.Дата												КАК Период,
	|	ОС														КАК ОсновноеСредство,
	|	ИнвНомерОС												КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)	КАК Событие,
	|	ВЫБОР
	|		КОГДА ДатаВводаВЭксплуатацию = &ПустаяДата ТОГДА
	|			Ссылка.Дата
	|		ИНАЧЕ
	|			ДатаВводаВЭксплуатацию
	|	КОНЕЦ													КАК ДатаСобытия,
	|	НазваниеДокументаВводаВЭксплуатацию						КАК НазваниеДокумента,
	|	НомерДокументаВводаВЭксплуатацию						КАК НомерДокумента,
	|	ДатаВводаВЭксплуатацию									КАК	ДатаДокумента
	|ИЗ
	|	ПолнаяТабличнаяЧастьОС
	|ГДЕ
	|	СостояниеОС = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
	|УПОРЯДОЧИТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Движения по рег.свед. КапРемонтОС
	|//
	|ВЫБРАТЬ
	|	Ссылка.Организация	КАК Организация,
	|	Дата				КАК Период,
	|	ОС					КАК ОС,
	|	ИнвНомер			КАК ИнвНомер,
	|	Сумма				КАК СуммаНаКапРемонт,
	|	НомерДокумента		КАК НомерДокумента,
	|	НазваниеДокумента	КАК НазваниеДокумента,
	|	
	|	// Сведения о гарантийном талоне заполняем только для негрупповых ОС
	|	ВЫБОР
	|		КОГДА ОС.ГрупповойУчет ТОГДА
	|			""""
	|		ИНАЧЕ
	|			НомерГТ
	|	КОНЕЦ				КАК НомерГТ,
	|	ВЫБОР
	|		КОГДА ОС.ГрупповойУчет ТОГДА
	|			&ПустаяДата
	|		ИНАЧЕ
	|			ДатаГТ
	|	КОНЕЦ				КАК ДатаГТ,
	|	ВЫБОР
	|		КОГДА ОС.ГрупповойУчет ТОГДА
	|			&ПустаяДата
	|		ИНАЧЕ
	|			СрокДействияГТ
	|	КОНЕЦ				КАК СрокДействияГТ
	|ИЗ
	|	Документ.ВводНачальныхОстатков.КапРемонтОС	КАК ТЧ
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|УПОРЯДОЧИТЬ ПО
	|	ОС,
	|	ИнвНомер,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Движения по рег.свед. НомераИнвентарныхКарточек
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация			КАК Организация,
	|	Ссылка.Дата					КАК Период,
	|	ОС							КАК ОсновноеСредство,
	|	НомерИнвентарнойКарточки	КАК НомерИнвентарнойКарточки,
	|	ДатаПринятияКУчету			КАК ДатаИнвентарнойКарточки
	|ИЗ
	|	ОС_Амортизация	КАК ОС_Амортизация
	|ГДЕ
	|	НомерИнвентарнойКарточки <> """"	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [6]. Движения по рег.свед. ПервоначальныеСведенияОСБухгалтерскийУчет
	|//
	|ВЫБРАТЬ
	|	Ссылка.Организация					КАК Организация,
	|	Ссылка.Дата							КАК Период,
	|	ОС									КАК ОсновноеСредство,
	|	&ВалютаРУ							КАК ВалютаПоступления,
	|	1									КАК Курс,
	|	1									КАК Кратность,
	|	0									КАК ПервоначальнаяСуммаАмортизации,
	|	МИНИМУМ(ПервоначальнаяСтоимость)	КАК ПервоначальнаяСтоимость, // одинаковая стоимость гарантируется в проверке заполнения
	|	МИНИМУМ(ПервоначальнаяСтоимость)	КАК ПервоначальнаяСтоимостьВВалюте, // =ПервоначальнаяСтоимость
	|	СУММА(Количество)					КАК Количество
	|ИЗ
	|	ОС_Основная	КАК ОС_Основная
	|СГРУППИРОВАТЬ ПО
	|	Ссылка.Организация,
	|	Ссылка.Дата,
	|	ОС,
	|	&ВалютаРУ,
	|	1,
	|	1,
	|	0");
	
	Результат = ЗапросДвижения.ВыполнитьПакет();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ТаблицыДляДвижений, Результат, НомераТаблиц);
	
	// Гарантируем уникальность движений по колонкам измерений путем модификации периода:
	Если ТаблицыДляДвижений.СобытияОС.Количество() > 0 Тогда
		МодифицироватьПериодВСтрокахДублей(ТаблицыДляДвижений.СобытияОС,
			"ОсновноеСредство,ИнвНомер,Событие",
			"Период");
	КонецЕсли;
	
КонецПроцедуры

Функция ОСНаЗабалансовыхСчетах_ПолучитьТаблицуСчетов(ДокументОбъект) Экспорт
	
	Перем ДатаДокумента;
	
	Если ДокументОбъект <> Неопределено И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "Дата") Тогда
		ДатаДокумента = ДокументОбъект["Дата"];
	КонецЕсли;
	
	НаДату = ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(ДатаДокумента);
	
	ТаблицаСчетов = Новый ТаблицаЗначений();
	
	ТаблицаСчетов.Колонки.Добавить("ВидУчетаНФА",	Новый ОписаниеТипов("ПеречислениеСсылка.ВидыУчетаНФА"));
	ТаблицаСчетов.Колонки.Добавить("МассивСчетов",	Новый ОписаниеТипов("Массив"));
	
	Если ДокументОбъект["РазделУчета"] = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете Тогда
		
		НоваяСтрока = ТаблицаСчетов.Добавить();
		НоваяСтрока["ВидУчетаНФА"]	= Перечисления.ВидыУчетаНФА.НаБалансе;
		НоваяСтрока["МассивСчетов"]	= БухгалтерскийУчет.СписокСчетов("21");
		
	ИначеЕсли ДокументОбъект["РазделУчета"] = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе Тогда
		
		НоваяСтрока = ТаблицаСчетов.Добавить();
		НоваяСтрока["ВидУчетаНФА"]	= Перечисления.ВидыУчетаНФА.Арендованные;
		НоваяСтрока["МассивСчетов"]	= БухгалтерскийУчет.СписокСчетов("01", НаДату);
		
		НоваяСтрока = ТаблицаСчетов.Добавить();
		НоваяСтрока["ВидУчетаНФА"] = Перечисления.ВидыУчетаНФА.НаОтветственномХранении;
		Если НаДату >= '20210101' Тогда
			// Указываем конкретные счета, чтобы исключить счета учета МЗ.
			МассивСчетов = БухгалтерскийУчет.СписокСчетов("02.11,02.21,02.31,02.3,02.5,02.51,02.52", НаДату);
		Иначе
			МассивСчетов = БухгалтерскийУчет.СписокСчетов("02.1,02.3", НаДату);
		КонецЕсли;
		НоваяСтрока["МассивСчетов"] = МассивСчетов;
		
		НоваяСтрока = ТаблицаСчетов.Добавить();
		НоваяСтрока["ВидУчетаНФА"]	= Перечисления.ВидыУчетаНФА.НаБалансе;
		НоваяСтрока["МассивСчетов"]	= БухгалтерскийУчет.СписокСчетов("22.1", НаДату);
		
	КонецЕсли;
	
	Возврат ТаблицаСчетов;
	
КонецФункции

Функция ОбязательноУказатьКонтрагента_ОСВОперУчете(ДокументОбъект)
	
	Счет = ДокументОбъект["Счет"];
	
	Если НЕ ЗначениеЗаполнено(Счет) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СубконтоКонтрагент = Счет.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	
	Если СубконтоКонтрагент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СубконтоКонтрагент.Обязательный;
	
КонецФункции

//---
// Раздел учета "Ввод остатков ОС на забалансовых счетах"
//---

Процедура ЗаполнитьСписокПроверяемыхОбязательныхРеквизитов_ОСЗабаланс(
			ШапкаДокумента,
			ПроверяемыеРеквизиты,
			ПроверяемыеСубконто,
			ПроверяемыеПризнакиУчета,
			ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
			ПеренаправлениеВыводаСообщений_Реквизиты,
			ИсключаемыеРеквизиты,
			ЭтоПроверкаВФормеРедактированияСтроки = Ложь) Экспорт
			
	// Инициализация
	Если ПроверяемыеРеквизиты = Неопределено Тогда
		ПроверяемыеРеквизиты = Новый Массив();
	КонецЕсли;
	ИсключаемыеРеквизиты			= Новый Массив();
	ПрименяемыйРежимВводаОстатков	= Новый Структура();
	
	// Подготовка
	СвойстваСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШапкаДокумента["Счет"], "УчетПоПодразделениям");
	
	ОбязательноУказатьКонтрагента = ОбязательноУказатьКонтрагента_ОСВОперУчете(ШапкаДокумента);
	
	// Реквизиты шапки
	ПроверяемыеРеквизиты.Добавить("Организация");
	ПроверяемыеРеквизиты.Добавить("Счет");
	ПроверяемыеРеквизиты.Добавить("КФО");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ПроверяемыеРеквизиты.Добавить("ИФО");
	КонецЕсли;
	Если ПодразделениеОбязательноКЗаполнению(ШапкаДокумента, СвойстваСчета) Тогда
		ПроверяемыеРеквизиты.Добавить("ПодразделениеОрганизации");
	КонецЕсли;
	Если ОбязательноУказатьКонтрагента Тогда
		ПроверяемыеРеквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	// Реквизиты табличный частей
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.ОС");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.Количество");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.Сумма");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.ЦМО");
	
КонецПроцедуры

Процедура ИнициализироватьДанныеДокумента_ОСЗабаланс(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Счет.УчетПоПодразделениям");
	
	ЗапросДвижения = Новый Запрос;
	ЗапросДвижения.УстановитьПараметр("ДокСсылка"				, ДокументСсылка);
	ЗапросДвижения.УстановитьПараметр("УчетПоПодразделениям"	, УчетПоПодразделениям);
	ЗапросДвижения.УстановитьПараметр("Счет01"					, БухгалтерскийУчет.СписокСчетов("01"));
	ЗапросДвижения.УстановитьПараметр("Счет02"					, БухгалтерскийУчет.СписокСчетов("02"));
	
	НомераТаблиц = Новый Структура;
	
	ДобавитьПриНеобходимостиВременнуюТаблицу("ОС_Основная", ЗапросДвижения, НомераТаблиц);
	
	НомераТаблиц.Вставить("СтоимостьОбъектовОСПоКонтрагентам", НомераТаблиц.Количество());
	
	ДобавитьТекстЗапроса(ЗапросДвижения.Текст, "
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Движения по рег.накопл. СтоимостьОбъектовОСПоКонтрагентам
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)	КАК ВидДвижения,
	|	Ссылка.Дата								КАК Период,
	|	Ссылка.Организация						КАК Организация,
	|	ЦМО										КАК ЦМО,
	|	Ссылка.Контрагент						КАК Контрагент,
	|	Ссылка.Договор							КАК Договор,
	|	ОС										КАК ОсновноеСредство,
	|	ИнвНомерОС								КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА Ссылка.Счет В (&Счет01)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПолученоВПользование)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении)
	|	КОНЕЦ 									КАК ВидРаспоряжения,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА Ссылка.ПодразделениеОрганизации
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ 									КАК Подразделение,
	|	Сумма									КАК Стоимость,
	|	Количество								КАК Количество
	|ИЗ
	|	ОС_Основная КАК ОС_Основная
	|ГДЕ
	|	(Ссылка.Счет В (&Счет01) ИЛИ Ссылка.Счет В (&Счет02))
	|	И (Сумма <> 0 ИЛИ Количество <> 0)");
	
	Результат = ЗапросДвижения.ВыполнитьПакет();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ТаблицыДляДвижений, Результат, НомераТаблиц);
	
КонецПроцедуры

Процедура ЗаполнитьИзДвиженийОСЗабаланс(ДокументОбъект) Экспорт
	
	Если ДокументОбъект.Движения.ЖурналПроводокЕПСБУ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПерваяПроводка					= ДокументОбъект.Движения.ЖурналПроводокЕПСБУ[0];
	ДокументОбъект.Организация		= ПерваяПроводка.Организация;
	ДокументОбъект.ИФО				= ПерваяПроводка.ИФО;
	ДокументОбъект.КФО				= ПерваяПроводка.КФО;
	ДокументОбъект.Счет				= ПерваяПроводка.СчетДт;
	ДокументОбъект.КЭК				= ПерваяПроводка.КЭКДт;
	ДокументОбъект.Договор			= ПерваяПроводка.СубконтоДт.Договоры;
	
	Если ЗначениеЗаполнено(ПерваяПроводка.СубконтоДт.Контрагенты) Тогда
		ДокументОбъект.Контрагент = ПерваяПроводка.СубконтоДт.Контрагенты;
	ИначеЕсли ЗначениеЗаполнено(ПерваяПроводка.СубконтоДт.Договоры) Тогда
		ДокументОбъект.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПерваяПроводка.СубконтоДт.Договоры, "Контрагент");
	КонецЕсли;
	
	Если ДокументОбъект.Движения.СтоимостьОбъектовОСПоКонтрагентам.Количество() = 0 Тогда
		
		// Заполняем из проводок
		
		Для Каждого Проводка Из ДокументОбъект.Движения.ЖурналПроводокЕПСБУ Цикл
			
			НоваяСтрока				= ДокументОбъект.ОС_Основная.Добавить();
			НоваяСтрока.ОС			= Проводка.СубконтоДт.ОсновныеСредства;;
			НоваяСтрока.ИнвНомерОС	= Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
			НоваяСтрока.Сумма		= Проводка.Сумма;
			НоваяСтрока.Количество	= Проводка.КоличествоДт;
			НоваяСтрока.ЦМО			= Проводка.СубконтоДт.ЦМО;
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого СтрокаДвижения Из ДокументОбъект.Движения.СтоимостьОбъектовОСПоКонтрагентам Цикл
			
			НоваяСтрока							= ДокументОбъект.ОС_Основная.Добавить();
			НоваяСтрока.ОС						= СтрокаДвижения.ОсновноеСредство;
			НоваяСтрока.ИнвНомерОС				= СтрокаДвижения.ИнвентарныйНомер;
			НоваяСтрока.ЦМО						= СтрокаДвижения.ЦМО;
			НоваяСтрока.Сумма					= СтрокаДвижения.Стоимость;
			НоваяСтрока.Количество				= СтрокаДвижения.Количество;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ДокументОбъект.ОС_Основная.Сортировать("ОС,ИнвНомерОС");
	
	ДокументОбъект.ОтражатьВБухгалтерскомУчете = Истина;
	ДокументОбъект.СуммаДокумента = ДокументОбъект.ОС_Основная.Итог("Сумма");
	
КонецПроцедуры

//---
// Раздел учета "НПА"
//---

Процедура ЗаполнитьСписокПроверяемыхОбязательныхРеквизитов_НПА(
			ШапкаДокумента,
			ПроверяемыеРеквизиты,
			ПроверяемыеСубконто,
			ПроверяемыеПризнакиУчета,
			ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
			ПеренаправлениеВыводаСообщений_Реквизиты,
			ИсключаемыеРеквизиты,
			ЭтоПроверкаВФормеРедактированияСтроки = Ложь) Экспорт
			
	// Инициализация
	Если ПроверяемыеРеквизиты = Неопределено Тогда
		ПроверяемыеРеквизиты = Новый Массив();
	КонецЕсли;
	ИсключаемыеРеквизиты			= Новый Массив();
	ПрименяемыйРежимВводаОстатков	= Новый Структура();
	
	// Подготовка
	СвойстваСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШапкаДокумента["Счет"],
		"УчетПоПодразделениям, УчетПоКПС, УчетПоКЭК");
	
	// Реквизиты шапки
	ПроверяемыеРеквизиты.Добавить("Организация");
	ПроверяемыеРеквизиты.Добавить("Счет");
	ПроверяемыеРеквизиты.Добавить("КФО");
	Если СвойстваСчета["УчетПоКПС"] = Истина Тогда
		ПроверяемыеРеквизиты.Добавить("КПС");
	КонецЕсли;
	Если СвойстваСчета["УчетПоКЭК"] = Истина Тогда
		ПроверяемыеРеквизиты.Добавить("КЭК");
	КонецЕсли;
	Если ПодразделениеОбязательноКЗаполнению(ШапкаДокумента, СвойстваСчета) Тогда
		ПроверяемыеРеквизиты.Добавить("ПодразделениеОрганизации");
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ПроверяемыеРеквизиты.Добавить("ИФО");
	КонецЕсли;
	
	// Реквизиты табл.части "Основные средства"
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.ОС");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.ИнвНомерОС");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.ЦМО");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.Сумма");
	ПроверяемыеРеквизиты.Добавить("ОС_Основная.СостояниеОС");
	
	ПроверяемыеРеквизиты.Добавить("ОС_Амортизация.ДатаПринятияКУчету");
	
	Если ЭтоПроверкаВФормеРедактированияСтроки = Истина Тогда
		ИсключитьИзПроверяемыхРеквизитов(ПроверяемыеРеквизиты);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПараметрыПроверкиПоСтроке_НПА(ШапкаДокумента) Экспорт
	
	Результат = Новый Структура();
	
	Возврат Результат;
	
КонецФункции

Функция ПроверкаПоСтроке_НПА(СтрокаОС, ПараметрыПроверкиПоСтроке) Экспорт
	
	// Возвращаемое значение
	Результат = Новый Структура();
	
	ОС							= СтрокаОС.ОС;
	Сумма						= СтрокаОС.Сумма;
	ИнвНомерОС					= СтрокаОС.ИнвНомерОС;
	ГрупповойУчет				= СтрокаОС.ГрупповойУчет;
	СостояниеОС					= СтрокаОС.СостояниеОС;
	ДатаВводаВЭксплуатацию		= СтрокаОС.ДатаВводаВЭксплуатацию;
	
	Если СостояниеОС = Перечисления.СостоянияОС.ВведеноВЭксплуатацию
		И НЕ ЗначениеЗаполнено(ДатаВводаВЭксплуатацию) Тогда
		
		ТекстСообщения = НСтр("ru='Не задана дата ввода ОС в эксплуатацию'");
		ИмяПоляДляВыводаСообщения = "ДатаВводаВЭксплуатацию";
		Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
		
		Возврат Результат;
	КонецЕсли;
	
	Если ГрупповойУчет Тогда
		ТекстСообщения = НСтр("ru='Указан НПА с групповым учетом. Групповой учет НПА невозможен'");
		ИмяПоляДляВыводаСообщения = "НПА";
		Результат.Вставить(ИмяПоляДляВыводаСообщения, ТекстСообщения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента_НПА(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ЗапросДвижения = Новый Запрос();
	ЗапросДвижения.УстановитьПараметр("ДокСсылка",				ДокументСсылка);
	ЗапросДвижения.УстановитьПараметр("ВалютаРУ",				Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросДвижения.УстановитьПараметр("ПустаяДата",				'00010101');
	ЗапросДвижения.УстановитьПараметр("УчетПоПодразделениям",	УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям());
	
	НомераТаблиц = Новый Структура;
	
	// Нужно использовать временные таблицы с табличными частями
	ДобавитьПриНеобходимостиВременнуюТаблицу("ОС_Основная",				ЗапросДвижения, НомераТаблиц);
	ДобавитьПриНеобходимостиВременнуюТаблицу("ОС_Амортизация",			ЗапросДвижения, НомераТаблиц);
	ДобавитьПриНеобходимостиВременнуюТаблицу("ПолнаяТабличнаяЧастьОС",	ЗапросДвижения, НомераТаблиц);
	
	НомераТаблиц.Вставить("СобытияОС",									НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПараметрыАмортизацииОСБухгалтерскийУчет",	НомераТаблиц.Количество());
	НомераТаблиц.Вставить("НомераИнвентарныхКарточек",					НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПервоначальныеСведенияОСБухгалтерскийУчет",	НомераТаблиц.Количество());
	НомераТаблиц.Вставить("СтоимостьОбъектовОС",						НомераТаблиц.Количество());
	
	ДобавитьТекстЗапроса(ЗапросДвижения.Текст, "
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Движения по рег.свед. СобытияОС
	|//
	|// События 'Принятие к учету':
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация										КАК Организация,
	|	Ссылка.Дата												КАК Период,
	|	ОС														КАК ОсновноеСредство,
	|	ИнвНомерОС												КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)		КАК Событие,
	|	ВЫБОР
	|		КОГДА ДатаПринятияКУчету = &ПустаяДата ТОГДА
	|			Ссылка.Дата
	|		ИНАЧЕ
	|			ДатаПринятияКУчету
	|	КОНЕЦ													КАК ДатаСобытия,
	|	НазваниеДокументаПринятияКУчету							КАК НазваниеДокумента,
	|	НомерДокументаПринятияКУчету							КАК НомерДокумента,
	|	ДатаПринятияКУчету										КАК	ДатаДокумента
	|ИЗ
	|	ПолнаяТабличнаяЧастьОС
	|ГДЕ
	|	НЕ СостояниеОС = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// События 'Ввод в эксплуатацию':
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация										КАК Организация,
	|	Ссылка.Дата												КАК Период,
	|	ОС														КАК ОсновноеСредство,
	|	ИнвНомерОС												КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)	КАК Событие,
	|	ВЫБОР
	|		КОГДА ДатаВводаВЭксплуатацию = &ПустаяДата ТОГДА
	|			Ссылка.Дата
	|		ИНАЧЕ
	|			ДатаВводаВЭксплуатацию
	|	КОНЕЦ													КАК ДатаСобытия,
	|	НазваниеДокументаВводаВЭксплуатацию						КАК НазваниеДокумента,
	|	НомерДокументаВводаВЭксплуатацию						КАК НомерДокумента,
	|	ДатаВводаВЭксплуатацию									КАК	ДатаДокумента
	|ИЗ
	|	ПолнаяТабличнаяЧастьОС
	|ГДЕ
	|	СостояниеОС = ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
	|УПОРЯДОЧИТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Движения по рег.свед. ПараметрыАмортизацииОСБухгалтерскийУчет
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация			КАК Организация,
	|	ПериодПринятиеКУчету		КАК Период,
	|	ОС							КАК ОсновноеСредство,
	|	ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается) КАК ПорядокПогашенияСтоимости,
	|	ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПустаяСсылка) КАК СпособНачисленияАмортизации
	|ИЗ
	|	ОС_Амортизация КАК ОС_Амортизация
	|;	
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Движения по рег.свед. НомераИнвентарныхКарточек
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация			КАК Организация,
	|	Ссылка.Дата					КАК Период,
	|	ОС							КАК ОсновноеСредство,
	|	НомерИнвентарнойКарточки	КАК НомерИнвентарнойКарточки,
	|	ДатаПринятияКУчету			КАК ДатаИнвентарнойКарточки
	|ИЗ
	|	ОС_Амортизация	КАК ОС_Амортизация
	|ГДЕ
	|	НомерИнвентарнойКарточки <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [6]. Движения по рег.свед. ПервоначальныеСведенияОСБухгалтерскийУчет
	|//
	|ВЫБРАТЬ
	|	Ссылка.Организация					КАК Организация,
	|	Ссылка.Дата							КАК Период,
	|	ОС									КАК ОсновноеСредство,
	|	&ВалютаРУ							КАК ВалютаПоступления,
	|	1									КАК Курс,
	|	1									КАК Кратность,
	|	0									КАК ПервоначальнаяСуммаАмортизации,
	|	МИНИМУМ(ПервоначальнаяСтоимость)	КАК ПервоначальнаяСтоимость, // одинаковая стоимость гарантируется в проверке заполнения
	|	МИНИМУМ(ПервоначальнаяСтоимость)	КАК ПервоначальнаяСтоимостьВВалюте, // =ПервоначальнаяСтоимость
	|	1									КАК Количество
	|ИЗ
	|	ОС_Основная	КАК ОС_Основная
	|
	|СГРУППИРОВАТЬ ПО
	|	Ссылка.Организация,
	|	Ссылка.Дата,
	|	ОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [7]. Движения по рег.накопл. СтоимостьОбъектовОС
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Организация						КАК Организация,
	|	Ссылка.Дата								КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)	КАК ВидДвижения,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе) КАК ВидРаспоряжения,	
	|	ОС										КАК ОсновноеСредство,
	|	ИнвНомерОС								КАК ИнвентарныйНомер,
	|	ЦМО										КАК ЦМО,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ 									КАК Подразделение,
	|	Сумма									КАК Стоимость,
	|	1										КАК Количество
	|ИЗ
	|	ПолнаяТабличнаяЧастьОС КАК ПолнаяТабличнаяЧастьОС
	|ГДЕ
	|	(Сумма <> 0 ИЛИ Количество <> 0)");
	
	Результат = ЗапросДвижения.ВыполнитьПакет();
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(ТаблицыДляДвижений, Результат, НомераТаблиц);
	
КонецПроцедуры

Функция Печать_НПА_Ведомость(МассивОбъектов, ОбъектыПечати)
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	// Получим свойства реквизитов ТЧ, выводимых в каждой строке ведомости.
	// Это только часть полей ТЧ "ОС Основная".
	СвойстваРеквизитов = Новый Структура("
		|ИнвНомерОС,
		|Количество,
		|ПервоначальнаяСтоимость,
		|Сумма,
		|ЦМО,
		|ДатаВводаВЭксплуатацию,
		|НазваниеДокументаВводаВЭксплуатацию,
		|НомерДокументаВводаВЭксплуатацию,
		|СостояниеОС");
		
	// Список полей, по которым нужно выводить итоги:
	ИменаИтоговыхПолей = Новый Массив();
	ИменаИтоговыхПолей.Добавить("Сумма");
	ИменаИтоговыхПолей.Добавить("Количество");
	
	ТабДокумент = Получить_Ведомость_ОС(
		МассивОбъектов,
		ОбъектыПечати,
		Перечисления.РазделыУчетаДляВводаОстатков.НПА,
		СвойстваРеквизитов,
		ИменаИтоговыхПолей);
	
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	
	Возврат ТабДокумент;
	
КонецФункции

