КонецФункции

Процедура ОбновитьРублевыеСуммы_ДенежныеСредства(ДокументОбъект) Экспорт
	
	ИспользоватьВалютныйУчет	= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаДокумента				= ДокументОбъект["ВалютаДокумента"];
	ВалютаРУ					= Константы.ВалютаРегламентированногоУчета.Получить();
	
	ОчиститьВалюту	= (НЕ ИспользоватьВалютныйУчет И ЗначениеЗаполнено(ВалютаДокумента) И НЕ ВалютаДокумента = ВалютаРУ);
	
	Если ИспользоватьВалютныйУчет Тогда
		РублевыеСуммыДолжныСовпадатьСВалютными = (ВалютаДокумента = ВалютаРУ);
	Иначе
		РублевыеСуммыДолжныСовпадатьСВалютными = Истина;
	КонецЕсли;
	
	Если ОчиститьВалюту Тогда
		ДокументОбъект["ВалютаДокумента"]	= Справочники.Валюты.ПустаяСсылка();
		ДокументОбъект["Курс"]				= 0;
		ДокументОбъект["Кратность"]			= 0;
	КонецЕсли;
	
	Если РублевыеСуммыДолжныСовпадатьСВалютными Тогда
		СуммыВШапкеСовпадают	= (ДокументОбъект["СуммаДокумента"] = ДокументОбъект["ВалютнаяСуммаДокумента"]);
		СуммыВТаблицеСовпадают	= (ДокументОбъект["ДенежныеСредства"].Итог("Сумма") = ДокументОбъект["ДенежныеСредства"].Итог("ВалютнаяСумма"));
		
		Если НЕ СуммыВШапкеСовпадают Тогда
			// Требуется корректировка реквизита шапки
			ДокументОбъект["СуммаДокумента"] = ДокументОбъект["ВалютнаяСуммаДокумента"];
		КонецЕсли;
		
		Если НЕ СуммыВТаблицеСовпадают Тогда
			// Требуется корректировка колонки таблицы
			Для Каждого СтрокаТаблицы Из ДокументОбъект["ДенежныеСредства"] Цикл
				СтрокаТаблицы["Сумма"] = СтрокаТаблицы["ВалютнаяСумма"];
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьДанныеДокумента_ДенежныеСредства(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	Запросы = Новый Запрос;
	Запросы.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Запросы.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Движения по регистру накопления НаличныеДенежныеСредства
	|//
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)	КАК ВидДвижения,
	|	&Ссылка									КАК Регистратор,
	|	Док.Дата								КАК Период,
	|	Док.Организация							КАК Организация,
	|	ВЫБОР
	|		КОГДА Док.ПодразделениеОрганизации.ВедетсяКассоваяКнига ТОГДА
	|			Док.ПодразделениеОрганизации
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.Пустаяссылка)
	|	КОНЕЦ									КАК Подразделение,
	|	Док.ВалютаДокумента						КАК Валюта,
	|	Док.КФО									КАК КФО,
	|	Док.ВалютнаяСуммаДокумента				КАК Сумма
	|ИЗ
	|	Документ.ВводНачальныхОстатков	КАК Док
	|ГДЕ
	|	Док.Ссылка = &Ссылка
	|;";

	Результат = Запросы.Выполнить();
	НаличныеДенежныеСредства = Результат.Выгрузить();
	
	ТаблицыДляДвижений.Вставить("НаличныеДенежныеСредства", НаличныеДенежныеСредства);
	
КонецПроцедуры

Функция ПодразделениеОбязательноКЗаполнению_ДенежныеСредства(ДокументОбъект)
	
	// Обязательно к заполнению, если включена функц.опция,
	// а также на любом из этих 2 счетов ведется учет по подразделениям
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СчетДокумента	= ДокументОбъект["Счет"];
	СчетНД			= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("НД");
	
	МассивСчетов= Новый Массив();
	
	Если ЗначениеЗаполнено(СчетДокумента) Тогда
		МассивСчетов.Добавить(СчетДокумента);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетНД) Тогда
		МассивСчетов.Добавить(СчетНД);
	КонецЕсли;
	
	Если МассивСчетов.Количество() > 0 Тогда
		СвойстваСчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивСчетов, "УчетПоПодразделениям");
		
		Для Каждого Элемент Из СвойстваСчетов Цикл
			УчетПоПодразделениям = Элемент.Значение;
			
			Если УчетПоПодразделениям Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

