Функция РежимВводаОстатков_СтруктураШапкиДокумента() Экспорт
	
	Возврат Новый Структура("
		|ОтражатьВБухгалтерскомУчете,
		|ОтражатьВНалоговомУчете,
		|РазделУчета,
		|Организация,
		|Дата,
		|КФО,
		|Счет,
		|ОсобыеСчета10500");
	
КонецФункции

// Определяет Использование и Видимость полей, зависящих от режима вв.ост. и уч.пол.
//	ШапкаДокумента.Дата	- дата документа, без какой-либо обработки.
//
// Схема расчета колонки "ИСПОЛЬЗУЕТСЯ" для каждого поля
//
//	Режим ввода остатков:
//		Используется (БухУчет) ------> |-----|
//		Используется (НалУчет_ОСН) --> |     |
//		Используется (...) ----------> |     |     |-----------------------|
//									   | ИЛИ | --> |Колонка "Используется" |
//	Учетная политика:				   |     |     |-----------------------|
//		Используется (...) ----------> |-----|
//
//
// Схема расчета колонки "ВИДИМОСТЬ" для каждого поля
//	              /-----------\        |-----------|
//	          Да /    Режим    \  Нет  | ИСТИНА    |
//	   ---<-----/ ввода остатков\----> | (БухУчет) |
//	   |||      \  установлен?  /      |-----------|
//	   |||       \-------------/             |
//	   |||                                   |
//	   VVV                                   |
//	Режим ввода остатков:                    |
//	Используется (БухУчет) ------> |-----|   V
//	Используется (НалУчет_ОСН) --> | ИЛИ |----
//	Используется (...) ----------> |-----|   |
//											 V
//	Учетная политика:                      |---|    |--------------------|
//	Используется (...) ------------------->| И |--> |Колонка "Видимость" |
//										   |---|    |--------------------|
