			Истина,	// Отказ от записи
			Ложь);	// Отказ от вывода сообщений следующих проверок
		
		// Различные первоначальные стоимости (БУ):
		ПакетПроверок_ДобавитьПакетнуюПроверку("ОсновныеСредства.Различные первоначальные стоимости",
			ТекстЗапроса_ПроверкаЗаполнения_РазличныеПервоначальныеСтоимости(),
			ПакетПроверок,
			ЗапросПакетПроверок,
			ИндексПоследнегоЗапроса,
			Истина,	// Отказ от записи
			Ложь);	// Отказ от вывода сообщений следующих проверок
			
		// Различные ручные проверки по каждой строке таблицы "ОС Общая":
		ПакетПроверок_ДобавитьПакетнуюПроверку("ОсновныеСредства.Проверка по строке ОС",
			ТекстЗапроса_ПроверкаЗаполнения_ПроверкаПоСтрокеОС(),
			ПакетПроверок,
			ЗапросПакетПроверок,
			ИндексПоследнегоЗапроса,
			Истина,	// Отказ от записи
			Ложь);	// Отказ от вывода сообщений следующих проверок
			
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазныМЗ Тогда
		//
		// Раздел учета "Имущество казны МЗ"
		//
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.БСО Тогда
		//
		// Раздел учета "БСО"
		//
		
	КонецЕсли;
	
	
	// Нужно дополнительно выполнять пакет проверок?
	Если НЕ ЗначениеЗаполнено(ПакетПроверок) Тогда
		Возврат НЕ СтатистикаОбщая["ОтказОтЗаписи"];
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ДокументОбъект",						ДокументОбъект);
	ДополнительныеПараметры.Вставить("МаксКолвоСообщений",					МаксКолвоСообщений);
	ДополнительныеПараметры.Вставить("МаксДлинаСообщения",					МаксДлинаСообщения);
	
	// Выполняем пакет запросов и получаем результаты всех проверок пакета:
	РезультатыВсехПроверок = ЗапросПакетПроверок.ВыполнитьПакет();
	
	// Обходим результаты каждой проверки последовательно:
	Для Каждого ТекущаяПроверка Из ПакетПроверок Цикл
		
		ИмяПроверки			= ТекущаяПроверка["Имя"];
		РезультатПроверки	= РезультатыВсехПроверок[ТекущаяПроверка["ИндексРезультатаВПакетеЗапросов"]];
		
		//------------------------------------------------------------------------------
		Если ИмяПроверки = "ОсновныеСредства.Наличие счета и КЭК амортизации" Тогда
		//------------------------------------------------------------------------------
			
			СтатистикаПроверки	= ИнициализироватьСтатистикуПроверки();
			
			ОбнаруженаОшибка = Ложь;
			
			Если НЕ РезультатПроверки.Пустой() Тогда
				СчетИКЭКАмортизации = ПолучитьСчетИКЭКАмортизации(ДокументОбъект);
				СчетАмортизации	= СчетИКЭКАмортизации["Счет"];
				КЭКАмортизации	= СчетИКЭКАмортизации["КЭК"];
				СчетСсылка		= ДокументОбъект["Счет"];
				
				Если ЗначениеЗаполнено(СчетАмортизации) Тогда
					Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетАмортизации, "УчетПоКЭК") Тогда
						Если ЗначениеЗаполнено(КЭКАмортизации) Тогда
							ОбнаруженаОшибка = Ложь;
						Иначе
							ОбнаруженаОшибка = Истина;
							ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru='Не удалось определить КОСГУ по кредиту для счета амортизации %1'"),
								Строка(СчетАмортизации));
						КонецЕсли;
					КонецЕсли;
				Иначе
					ОбнаруженаОшибка = Истина;
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='Не удалось определить счет амортизации, соответствующий счету %1'"),
						Строка(СчетСсылка));
				КонецЕсли;
			КонецЕсли;
			
			Если ОбнаруженаОшибка Тогда
				ОтразитьВСтатистикеВозможныйОтказОтЗаписи(ТекущаяПроверка, СтатистикаОбщая);
				
				ОтразитьВСтатистикеДобавитьКоличествоОшибок(1, СтатистикаПроверки, СтатистикаОбщая);
				
				Если СтатистикаОбщая["ОтказОтВыводаСообщений"] Тогда
					// Переходим к следующей проверке
					Продолжить;
				КонецЕсли;
				
				ОбщегоНазначения.СообщитьПользователю(
					ТекстСообщения,
					ДокСсылка,
					"Объект.Счет");
					
				ОтразитьВСтатистикеВыведенноеСообщение(СтатистикаПроверки, СтатистикаОбщая);
			КонецЕсли;
			
			
		//------------------------------------------------------------------------------
		ИначеЕсли ИмяПроверки = "ОсновныеСредства.Проверка по строке ОС" Тогда
		//------------------------------------------------------------------------------
			
			СтатистикаПроверки = ВыполнитьПроверкуВсейТаблицыПоСтрокеОС(ТекущаяПроверка, РезультатПроверки, СтатистикаОбщая, ДополнительныеПараметры);
			
			
		//------------------------------------------------------------------------------
		Иначе // Все остальные проверки
		//------------------------------------------------------------------------------
			
			СтатистикаПроверки = СообщитьОВыявленныхОшибках(ТекущаяПроверка, РезультатПроверки, СтатистикаОбщая, ДополнительныеПараметры);
			
			
		КонецЕсли; // Имя проверки
		
		ОтразитьВСтатистикеЗавершениеТекущейПроверки(ТекущаяПроверка, СтатистикаОбщая);
		
	КонецЦикла; // Обход Пакета Проверок.
	
	
	//
	// Выведем общее кол-во ошибок, которые не были показаны:
	// (после всех-всех-всех проверок)
	//
	Если СтатистикаОбщая["ОтказОтВыводаСообщений"] Тогда
		
		КоличествоНесообщенныхОшибок = СтатистикаОбщая["КоличествоОшибок"] - СтатистикаОбщая["КоличествоСообщенныхОшибок"];
		
		Если СтатистикаОбщая["КоличествоОшибокИзвестно"] Тогда
			// Количество ошибок точно известно
			
			ТекстШаблон = НСтр("ru='Также обнаружены еще %1 ошибок заполнения документа (но они не были показаны на экране)'");
			ВывестиСообщение = (КоличествоНесообщенныхОшибок > 0);
			
		Иначе
			// Точно не известно из-за прерванных ручных проверок
			
			Если КоличествоНесообщенныхОшибок = 0 Тогда
				// Не известен даже минимум
				ТекстШаблон = НСтр("ru='Возможно, существуют еще ошибки заполнения документа (некоторые проверки не были проведены)'");
			Иначе
				// Известен определенный минимум
				ТекстШаблон = НСтр("ru='Также обнаружены еще как минимум %1 ошибок заполнения документа (но они не были показаны на экране; также некоторые проверки не были проведены)'");
			КонецЕсли;
			ВывестиСообщение = Истина;
			
		КонецЕсли;
		
		Если ВывестиСообщение Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстШаблон,
				КоличествоНесообщенныхОшибок);
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокСсылка);
		КонецЕсли;
		
	КонецЕсли;
	
	// Возвращаем результат всех проведенных проверок
	Возврат НЕ СтатистикаОбщая["ОтказОтЗаписи"];
	
КонецФункции

// Подразделение из шапки или табличной части, определяется разделом учета
Функция ПодразделениеОбязательноКЗаполнению(ДокументОбъект, СвойстваСчета = Неопределено) Экспорт
	
	РазделУчета	= ДокументОбъект["РазделУчета"];
	
	Если	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства
		ИЛИ РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете
		ИЛИ РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе
		ИЛИ РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НПА
		ИЛИ РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны
		ИЛИ РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазныМЗ
		ИЛИ	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеДокументы
		ИЛИ	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.БСО
		Тогда
		
		Если СвойстваСчета = Неопределено Тогда
			СвойстваСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОбъект["Счет"], "УчетПоПодразделениям");
		КонецЕсли;
		Возврат ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И СвойстваСчета["УчетПоПодразделениям"] = Истина;
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПоСчету106хП Тогда
		Возврат ПодразделениеИспользуетсяНаСчетах106хП(ДокументОбъект.Дата);
		
	ИначеЕсли	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НДС
		ИЛИ		РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.РодительскаяПлата
		Тогда
		
		Возврат ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
		
	ИначеЕсли	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеСредства Тогда
		Возврат ПодразделениеОбязательноКЗаполнению_ДенежныеСредства(ДокументОбъект);
		
	// Для следующих разделов учета эта функция не применяется
	
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Материалы Тогда
		// Используемый реквизит подразделения включен в состав функц.опции, поведение стандартное
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПрочиеСчетаБухгалтерскогоУчета Тогда
		// Используемые реквизиты подразделения включены в состав функц.опции, поведение стандартное
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Студенты Тогда
		// Используемый реквизит подразделения называется Факультет и уже обрабатывается по-своему
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьПолнуюТаблицуПределовСтоимостиОС() Экспорт
	
	ЗапросПределыСтоимостиОС = Новый Запрос();
	ЗапросПределыСтоимостиОС.УстановитьПараметр("Дата2009", '20090101');
	ЗапросПределыСтоимостиОС.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Период			КАК Период,
	|	ПервыйПределОС	КАК ПервыйПределОС,
	|	ВторойПределОС	КАК ВторойПределОС
	|ИЗ
	|	РегистрСведений.ПараметрыУчетаОС
	|ГДЕ
	|	Период >= &Дата2009
	|УПОРЯДОЧИТЬ ПО
	|	Период
	|;";
	
	Возврат ЗапросПределыСтоимостиОС.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьДатуДляОпределенияПределовСтоимостиОС(СтруктураСостояниеОС) Экспорт
	
	СостояниеОС				= СтруктураСостояниеОС["СостояниеОС"];
	ДатаПринятияКУчету		= СтруктураСостояниеОС["ДатаПринятияКУчету"];
	ДатаВводаВЭксплуатацию	= СтруктураСостояниеОС["ДатаВводаВЭксплуатацию"];
	Дата2009				= '20090101';
	
	Если СостояниеОС = Перечисления.СостоянияОС.ВведеноВЭксплуатацию Тогда
		Если НЕ ЗначениеЗаполнено(ДатаПринятияКУчету) ИЛИ НЕ ЗначениеЗаполнено(ДатаВводаВЭксплуатацию) Тогда
			ДатаПроверки = Макс(ДатаПринятияКУчету, ДатаВводаВЭксплуатацию);
		Иначе
			ДатаПроверки = Мин(ДатаПринятияКУчету, ДатаВводаВЭксплуатацию);
		КонецЕсли;
	Иначе
		ДатаПроверки = ДатаПринятияКУчету;
	КонецЕсли;
	
	Если ДатаПроверки < Дата2009 Тогда
		ДатаПроверки = Дата2009;
	КонецЕсли;
	
	Возврат ДатаПроверки;
	
КонецФункции

Функция ОпределитьПрименяемыеПределыСтоимостиОС(СтруктураСостояниеОС, ПолнаяТаблицаПределовСтоимостиОС = Неопределено) Экспорт
	
	ДатаПроверки = ПолучитьДатуДляОпределенияПределовСтоимостиОС(СтруктураСостояниеОС);
	
	Если ПолнаяТаблицаПределовСтоимостиОС = Неопределено Тогда
		// Пределы стоимости считываем из регистра
		Пределы = УправлениеОсновнымиСредствамиПовтИсп.ПолучитьПределыОС(ДатаПроверки);
		
		ПервыйПределОС	= Пределы["ПервыйПределОС"];
		ВторойПределОС	= Пределы["ВторойПределОС"];
	Иначе
		// Пределы стоимости определяем из переданной таблицы
		ПервыйПределОС	= 0; // Значения для даты, более ранней, чем первая запись.
		ВторойПределОС	= 0;
		
		ИнтервалНайден = Ложь;
		КоличествоСтрок = ПолнаяТаблицаПределовСтоимостиОС.Количество();
		Для ИндексСтроки = 0 По КоличествоСтрок - 1 Цикл
			ТекущаяСтрокаКэша = ПолнаяТаблицаПределовСтоимостиОС[ИндексСтроки];
			Если ДатаПроверки < ТекущаяСтрокаКэша["Период"] Тогда
				ИнтервалНайден = Истина;
				Если ИндексСтроки > 0 Тогда
					// Берем значения из предыдущей строки:
					ПервыйПределОС = ПолнаяТаблицаПределовСтоимостиОС[ИндексСтроки - 1]["ПервыйПределОС"];
					ВторойПределОС = ПолнаяТаблицаПределовСтоимостиОС[ИндексСтроки - 1]["ВторойПределОС"];
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ИнтервалНайден И КоличествоСтрок > 0 Тогда
			// Берем данные из самой последней записи:
			ПервыйПределОС = ПолнаяТаблицаПределовСтоимостиОС[КоличествоСтрок - 1]["ПервыйПределОС"];
			ВторойПределОС = ПолнаяТаблицаПределовСтоимостиОС[КоличествоСтрок - 1]["ВторойПределОС"];
		КонецЕсли;
	КонецЕсли;
	
	ПределыСтоимостиОС = Новый Структура();
	ПределыСтоимостиОС.Вставить("ПервыйПределОС",	ПервыйПределОС);
	ПределыСтоимостиОС.Вставить("ВторойПределОС",	ВторойПределОС);
	ПределыСтоимостиОС.Вставить("ИспользуемаяДата",	ДатаПроверки);
	
	Возврат ПределыСтоимостиОС;
	
КонецФункции

Процедура УдалитьПроверяемыйРеквизит(ИмяРеквизита, ПроверяемыеРеквизиты) Экспорт
	
	ВремИнд = ПроверяемыеРеквизиты.Найти(ИмяРеквизита);
	
	Если НЕ ВремИнд = Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(ВремИнд);
	КонецЕсли;
	
КонецПроцедуры

