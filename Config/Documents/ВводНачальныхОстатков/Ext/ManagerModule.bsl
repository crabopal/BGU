#Область ПрограммныйИнтерфейс

Процедура ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = Неопределено;
	
	Если Не ДополнительныеСвойства.Свойство("ПлательщикНалогаНаПрибыль") Тогда
		Организация = ПолучитьЗначениеРеквизита(ЗначенияРеквизитов, "Организация", Ссылка);
		ДатаДокумента = ПолучитьЗначениеРеквизита(ЗначенияРеквизитов, "Дата", Ссылка);
		ПлательщикНалогаНаПрибыль = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Организация, ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(ДатаДокумента));
		ДополнительныеСвойства.Вставить("ПлательщикНалогаНаПрибыль", ПлательщикНалогаНаПрибыль);
	КонецЕсли;
	
	Если Не ДополнительныеСвойства.Свойство("ПрименяетсяУСНДоходыМинусРасходы") Тогда
		Организация = ПолучитьЗначениеРеквизита(ЗначенияРеквизитов, "Организация", Ссылка);
		ДатаДокумента = ПолучитьЗначениеРеквизита(ЗначенияРеквизитов, "Дата", Ссылка);
		ПрименяетсяУСНДоходыМинусРасходы = УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Организация, ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(ДатаДокумента));
		ДополнительныеСвойства.Вставить("ПрименяетсяУСНДоходыМинусРасходы", ПрименяетсяУСНДоходыМинусРасходы);
	КонецЕсли;
	
	РазделУчета = Неопределено;
	Если Не ДополнительныеСвойства.Свойство("РазделУчета", РазделУчета) Тогда
		РазделУчета = ПолучитьЗначениеРеквизита(ЗначенияРеквизитов, "РазделУчета", Ссылка);
	КонецЕсли;
	
	Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства Тогда
		ИнициализироватьДанныеДокумента_ОС(Ссылка, ДополнительныеСвойства);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете Тогда
		ИнициализироватьДанныеДокумента_ОСВОперУчете(Ссылка, ДополнительныеСвойства);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе Тогда
		ИнициализироватьДанныеДокумента_ОСЗабаланс(Ссылка, ДополнительныеСвойства);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НПА Тогда
		ИнициализироватьДанныеДокумента_НПА(Ссылка, ДополнительныеСвойства);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеСредства Тогда
		ИнициализироватьДанныеДокумента_ДенежныеСредства(Ссылка, ДополнительныеСвойства);

	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеДокументы Тогда
		ИнициализироватьДанныеДокумента_ДенежныеДокументы(Ссылка, ДополнительныеСвойства);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НДС Тогда
		ИнициализироватьДанныеДокумента_НДС(Ссылка, ДополнительныеСвойства);

	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Материалы Тогда
		ИнициализироватьДанныеДокумента_Материалы(Ссылка, ДополнительныеСвойства);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Студенты Тогда
		ИнициализироватьДанныеДокумента_Студенты(Ссылка, ДополнительныеСвойства);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны Тогда
		ИнициализироватьДанныеДокумента_ИмуществоКазны(Ссылка, ДополнительныеСвойства);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.БСО Тогда
		ИнициализироватьДанныеДокумента_БСО(Ссылка, ДополнительныеСвойства);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.РодительскаяПлата Тогда
		ИнициализироватьДанныеДокумента_РодительскаяПлата(Ссылка, ДополнительныеСвойства);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПраваПользованияАктивами Тогда
		ИнициализироватьДанныеДокумента_ПраваПользованияАктивами(Ссылка, ДополнительныеСвойства);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДоходыБудущихПериодов Тогда
		ИнициализироватьДанныеДокумента_ДоходыБудущихПериодов(Ссылка, ДополнительныеСвойства);
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьЗначениеРеквизита(ЗначенияРеквизитов, ИмяРеквизита, Ссылка)
	
	Если ЗначенияРеквизитов = Неопределено Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Дата,Организация,РазделУчета");
	КонецЕсли;	
	
	Возврат ЗначенияРеквизитов[ИмяРеквизита];
	
КонецФункции

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	ФормыСписка = "ФормаСписка,Обработка.ПомощникВводаНачальныхОстатков.Форма.Форма";
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВводНачальныхОстатков";
	КомандаПечати.Идентификатор		= "ПФ_MXL_ОС_Ведомость";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость (ОС)'");
	КомандаПечати.Порядок			= 1;
	КомандаПечати.СписокФорм		= ФормыСписка + ",ОС";
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВводНачальныхОстатков";
	КомандаПечати.Идентификатор		= "ОСВОперУчете_Ведомость";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость (ОС в опер. учете)'");
	КомандаПечати.Порядок			= 2;
	КомандаПечати.СписокФорм		= ФормыСписка + ",ОСВОперУчете";
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВводНачальныхОстатков";
	КомандаПечати.Идентификатор		= "НПА_Ведомость";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость (НПА)'");
	КомандаПечати.Порядок			= 3;
	КомандаПечати.СписокФорм		= ФормыСписка + ",НПА";
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВводНачальныхОстатков";
	КомандаПечати.Идентификатор		= "ПФ_MXL_ПоСчету106хП_Ведомость";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость (счет 106.хП)'");
	КомандаПечати.Порядок			= 4;
	КомандаПечати.СписокФорм		= ФормыСписка + ",ПоСчету106хП";
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ВводНачальныхОстатков";
	КомандаПечати.Идентификатор		= "РодительскаяПлата_Ведомость";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость (родительская плата)'");
	КомандаПечати.Порядок			= 5;
	КомандаПечати.СписокФорм		= ФормыСписка + ",РодительскаяПлата";
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ОС_Ведомость") Тогда
		//
		// Раздел учета "ОС"
		//
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_ОС_Ведомость",
			"Ведомость введенных остатков",
			Печать_ОС_Ведомость(МассивОбъектов, ОбъектыПечати));
			
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ОСВОперУчете_Ведомость") Тогда
		//
		// Раздел учета "ОС в оперативном учете"
		//
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ОСВОперУчете_Ведомость",
			"Ведомость введенных остатков",
			Печать_ОСВОперУчете_Ведомость(МассивОбъектов, ОбъектыПечати));
			
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "НПА_Ведомость") Тогда
		//
		// Раздел учета "НПА"
		//
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"НПА_Ведомость",
			"Ведомость введенных остатков",
			Печать_НПА_Ведомость(МассивОбъектов, ОбъектыПечати));
			
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ПоСчету106хП_Ведомость") Тогда
		//
		// Раздел учета "По счету 106.хП"
		//
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_ПоСчету106хП_Ведомость",
			"Ведомость введенных остатков",
			Печать_ПоСчету106хП_Ведомость(МассивОбъектов, ОбъектыПечати));
			
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "РодительскаяПлата_Ведомость") Тогда
		//
		// Раздел учета "Родительская плата"
		//
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"РодительскаяПлата_Ведомость",
			"Ведомость введенных остатков",
			Печать_РодительскаяПлата_Ведомость(МассивОбъектов, ОбъектыПечати));
			
	КонецЕсли;
	
КонецПроцедуры // Печать()

// Возвращает дату ввода нач.ост. для Организации. Если не задана, то возвращает конец пред.года.
Функция ПолучитьДатуНовогоДокумента(Знач Организация) Экспорт
	
	ЗапросДата = Новый Запрос("
	|ВЫБРАТЬ
	|	ДатаВводаНачальныхОстатков	КАК Дата
	|ИЗ
	|	РегистрСведений.ДатыВводаНачальныхОстатков
	|ГДЕ
	|	Организация = &Организация
	|;");
	ЗапросДата.УстановитьПараметр("Организация", Организация);
	РезультатЗапроса = ЗапросДата.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Результат = НачалоГода(ТекущаяДатаСеанса()) - 24*60*60;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Дата;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Процедура УстановитьПараметрыФункциональныхОпцийФормыДокумента(Форма) Экспорт

	ПараметрыФО = Новый Структура("Организация, Период",
		ОбщегоНазначенияБГУ.ГоловнаяОрганизация(Форма.Объект.Организация), Форма.Объект.Дата + 86400);

	Форма.УстановитьПараметрыФункциональныхОпцийФормы(ПараметрыФО);

КонецПроцедуры

Функция ПолучитьИменаМодифицируемыхРеквизитовОС(РазделУчета) Экспорт
	
	Перем ИменаРеквизитов;
	
	Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства Тогда
		ИменаРеквизитов = "ГрупповойУчет, ВидНФА, КодОКОФ, АмортизационнаяГруппа";
		
	ИначеЕсли	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете
			ИЛИ	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе
			Тогда
		ИменаРеквизитов = "ГрупповойУчет";
		
	ИначеЕсли	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны Тогда
		ИменаРеквизитов = "ГрупповойУчет, КодОКОФ, АмортизационнаяГруппа";
		
	КонецЕсли;
	
	Возврат ИменаРеквизитов;
	
КонецФункции

Функция ПолучитьЗначенияМодифицируемыхРеквизитовОС(РазделУчета, ОССсылка) Экспорт
	
	Перем РеквизитыОС;
	
	РеквизитыОС = Новый Структура();
	
	ИменаРеквизитов = ПолучитьИменаМодифицируемыхРеквизитовОС(РазделУчета);
	
	Если ЗначениеЗаполнено(ИменаРеквизитов) Тогда
		Если ЗначениеЗаполнено(ОССсылка) Тогда
			РеквизитыОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОССсылка, ИменаРеквизитов);
		Иначе
			РеквизитыОС = Новый Структура(ИменаРеквизитов);
		КонецЕсли;
	КонецЕсли;
	
	Возврат РеквизитыОС;
	
КонецФункции

Процедура ОбновитьИзмененныеРеквизитыОС(ОССсылка, ПрежниеРеквизитыОС, НовыеРеквизитыОС) Экспорт
	
	Перем	ЕстьИзмененныеРеквизиты,
			НовоеЗначениеРеквизита;
			
	Если ПрежниеРеквизитыОС.Количество() = НовыеРеквизитыОС.Количество() Тогда
		Для Каждого Элем Из ПрежниеРеквизитыОС Цикл
			ИмяРеквизита				= Элем.Ключ;
			ПрежнееЗначениеРеквизита	= Элем.Значение;
			
			Если НовыеРеквизитыОС.Свойство(ИмяРеквизита, НовоеЗначениеРеквизита) Тогда
				Если НЕ ПрежнееЗначениеРеквизита = НовоеЗначениеРеквизита Тогда
					ЕстьИзмененныеРеквизиты = Истина;
					Прервать;
				КонецЕсли;
			Иначе
				ЕстьИзмененныеРеквизиты = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ЕстьИзмененныеРеквизиты = Истина;
	КонецЕсли;
	
	Если ЕстьИзмененныеРеквизиты = Истина Тогда
		Попытка
			ОСОбъект = ОССсылка.ПолучитьОбъект();
			
			ЗаполнитьЗначенияСвойств(ОСОбъект, НовыеРеквизитыОС);
			
			ОСОбъект.Записать();
		Исключение
			ИмяСобытия			= НСтр("ru='Данные. Изменение'");
			КомментарийШаблон	= НСтр("ru='Ошибка при записи обновленных свойств основного средства %1. %2'");
			
			Комментарий			= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				КомментарийШаблон,
				Строка(ОССсылка),
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,									// имя события
				УровеньЖурналаРегистрации.Предупреждение,	// уровень
				,											// объект метаданных
				,											// данные
				Комментарий);								// комментарий
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьУсловноеОформление_КолонкиОСПринятиеКУчету(Форма) Экспорт
	
	// 1. Таблица "ОС" - только просмотр полей "Ввод в эксплуатацию", в зав-ти от "Состояние ОС"
	НовыйЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = "Таблица ""ОС"" - только просмотр полей ""Ввод в эксплуатацию"", в зав-ти от ""Состояние ОС""";
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
