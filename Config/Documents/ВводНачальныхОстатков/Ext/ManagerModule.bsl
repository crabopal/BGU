КонецФункции

Функция ПолучитьСоответствиеРазделовФормам()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства,					"ОС");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете,	"ОСВОперУчете");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе,		"ОСЗабаланс");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.НПА,								"НПА");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.Материалы,							"Материалы");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ПоСчету106хП,						"ПоСчету106хП");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеСредства,					"ДенежныеСредства");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеДокументы,					"ДенежныеДокументы");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.НДС,								"НДС");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ПрочиеСчетаБухгалтерскогоУчета,	"ПрочиеСчета");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.Студенты,							"Студенты");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны,					"ИмуществоКазны");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазныМЗ,					"ИмуществоКазны");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.БСО,								"БСО");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.РодительскаяПлата,					"РодительскаяПлата");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ПраваПользованияАктивами,			"ПраваПользованияАктивами");
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ДоходыБудущихПериодов,				"ДоходыБудущихПериодов");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОперацииРазделовУчетаПоУмолчанию() Экспорт
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства					, Справочники.ТиповыеОперации.ВводНачальныхОстатков_ОСИНМА);
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.НПА								, Справочники.ТиповыеОперации.ВводНачальныхОстатков_НПА);
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны						, Справочники.ТиповыеОперации.ВводНачальныхОстатков_ИмуществоКазны);	
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазныМЗ					, Справочники.ТиповыеОперации.ВводНачальныхОстатков_ИмуществоКазны);	
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете	, Справочники.ТиповыеОперации.ВводНачальныхОстатков_ОСВОперУчете);
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе		, Справочники.ТиповыеОперации.ВводНачальныхОстатков_ОСВОперУчете);
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеСредства					, Справочники.ТиповыеОперации.ВводНачальныхОстатков_ДенежныеСредства);
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.Материалы							, Справочники.ТиповыеОперации.ВводНачальныхОстатков_Материалы);
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ПоСчету106хП						, Справочники.ТиповыеОперации.ВводНачальныхОстатков_Счет106хП);
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеДокументы					, Справочники.ТиповыеОперации.ВводНачальныхОстатков_ДенежныеДокументы);	
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.БСО								, Справочники.ТиповыеОперации.ВводНачальныхОстатков_БСО);
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.НДС								, Справочники.ТиповыеОперации.ВводНачальныхОстатков_ВходящийНДС);
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.РодительскаяПлата					, Справочники.ТиповыеОперации.ВводНачальныхОстатков_РодительскаяПлата);
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ПраваПользованияАктивами			, Справочники.ТиповыеОперации.ВводНачальныхОстатков_ПраваПользованияАктивами);
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.ПрочиеСчетаБухгалтерскогоУчета		, Справочники.ТиповыеОперации.ПустаяСсылка());
	
	СписокОпераций = Новый Массив();
	СписокОпераций.Добавить(Справочники.ТиповыеОперации.ВводНачальныхОстатков_ПоДолгосрочнымДоговорамСтудентов);
	СписокОпераций.Добавить(Справочники.ТиповыеОперации.ВводНачальныхОстатков_ПоКраткосрочнымДоговорамСтудентов);
	
	Результат.Вставить(Перечисления.РазделыУчетаДляВводаОстатков.Студенты							, СписокОпераций);	
	
	Возврат Результат;
	
КонецФункции

Функция ИнициализироватьСтатистикуПроверки()
	
	СтатистикаПроверки = Новый Структура();
	СтатистикаПроверки.Вставить("КоличествоОшибок",					0);
	СтатистикаПроверки.Вставить("КоличествоСообщенныхОшибок",		0);
	СтатистикаПроверки.Вставить("СчетчикСообщений",					0);
	СтатистикаПроверки.Вставить("ВыводСообщенийПрерван",			Ложь);
	
	Возврат СтатистикаПроверки;
	
КонецФункции

// Возвращает табл.док. "Ведомость ОС" для разделов учета "ОС", "ОС в опер.учете", "НПА".
Функция Получить_Ведомость_ОС(МассивОбъектов, ОбъектыПечати, РазделУчета, СвойстваРеквизитов, ИменаИтоговыхПолей)
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	ЭтоРазделУчетаОС = (РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства);
	
	ИмяПоляСвязиТЧ = "ОС";
	
	Текст = "
	|///////////////////////////////////////////////
	|// [0]. Данные из шапок документов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка						КАК ДокСсылка,
	|	Док.Номер						КАК ДокНомер,
	|	ПРЕДСТАВЛЕНИЕ(Док.Организация)	КАК Организация,
	|	ПРЕДСТАВЛЕНИЕ(Док.РазделУчета)	КАК РазделУчета,
	|	ПРЕДСТАВЛЕНИЕ(Док.ВидНФА)		КАК ВидНФА,
	|	ПРЕДСТАВЛЕНИЕ(Док.КПС)			КАК КПС,
	|	ПРЕДСТАВЛЕНИЕ(Док.КФО)			КАК КФО,
	|	ПРЕДСТАВЛЕНИЕ(Док.Счет)			КАК Счет,
	|	ПРЕДСТАВЛЕНИЕ(Док.КЭК)			КАК КЭК
	|
	|ИЗ
	|	Документ.ВводНачальныхОстатков	КАК Док
	|
	|ГДЕ
	|	Док.Ссылка В (&МассивОбъектов)
	//|	И Док.РазделУчета = &РазделУчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокСсылка
	|;
	|
	|///////////////////////////////////////////////
	|// [1]. Данные из табличных частей документов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОС_Основная.Ссылка				КАК ДокСсылка,
	|	ОС_Основная.НомерСтроки			КАК НПП,
	|	ОС_Основная." + ИмяПоляСвязиТЧ + "	КАК " + ИмяПоляСвязиТЧ + ",
	|	ОС_Основная." + ИмяПоляСвязиТЧ + ".ГрупповойУчет	КАК ГрупповойУчет,";
	
	
	// Для раздела учета "Основные средства" запрашиваем все реквизиты обеих табличных частей.
	// Для остальных разделов учета необходимые реквизиты ТЧ "ОС Основная" уже указаны (переданы).
	
	// Реквизиты ТЧ "ОС Основная":
	РеквизитыТЧ = Метаданные.Документы.ВводНачальныхОстатков.ТабличныеЧасти.ОС_Основная.Реквизиты;
	КоллекцияЭлементов = ?(ЭтоРазделУчетаОС, РеквизитыТЧ, СвойстваРеквизитов);
	Для Каждого Элем Из КоллекцияЭлементов Цикл
		
		ИмяРеквизита = ?(ЭтоРазделУчетаОС, Элем.Имя, Элем.Ключ);
		Реквизит = ?(ЭтоРазделУчетаОС, Элем, РеквизитыТЧ[ИмяРеквизита]);
		
		// Поле "ОС" пропускаем:
		Если ИмяРеквизита = ИмяПоляСвязиТЧ Тогда
			Продолжить;
		КонецЕсли;
		
		ТипРеквизита = Реквизит.Тип;
		
		СвойстваРеквизита = Новый Структура("Синоним, Тип");
		ЗаполнитьЗначенияСвойств(СвойстваРеквизита, Реквизит);
		СвойстваРеквизитов.Вставить(ИмяРеквизита, СвойстваРеквизита);
		
		НужноПредставление = НЕ (ТипРеквизита.СодержитТип(Тип("Число")) ИЛИ ТипРеквизита.СодержитТип(Тип("Булево")) ИЛИ ТипРеквизита.СодержитТип(Тип("Дата")));
		Текст = Текст + "
			|	"
			+ ?(НужноПредставление, "ПРЕДСТАВЛЕНИЕ(", "")
			+ "ОС_Основная." + ИмяРеквизита
			+ ?(НужноПредставление, ")", "")
			+ "	КАК " + ИмяРеквизита
			+ ",";

	КонецЦикла;
	
	Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства Тогда
		// Для раздела учета "Основные средства" запрашиваем все реквизиты обеих табличных частей.
		
		// Реквизиты ТЧ "ОС Амортизация":
		РеквизитыТЧ = Метаданные.Документы.ВводНачальныхОстатков.ТабличныеЧасти.ОС_Амортизация.Реквизиты;
		Для Каждого Реквизит Из РеквизитыТЧ Цикл
			
			ИмяРеквизита = Реквизит.Имя;
			
			// Поле "ОС" пропускаем:
			Если ИмяРеквизита = ИмяПоляСвязиТЧ Тогда
				Продолжить;
			КонецЕсли;
			
			СвойстваРеквизита = Новый Структура("Синоним, Тип");
			ЗаполнитьЗначенияСвойств(СвойстваРеквизита, Реквизит);
			СвойстваРеквизитов.Вставить(ИмяРеквизита, СвойстваРеквизита);
			
			НужноПредставление = НЕ (ТипРеквизита.СодержитТип(Тип("Число")) ИЛИ ТипРеквизита.СодержитТип(Тип("Булево")) ИЛИ ТипРеквизита.СодержитТип(Тип("Дата")));
			Текст = Текст + "
				|	"
				+ ?(НужноПредставление, "ПРЕДСТАВЛЕНИЕ(", "")
				+ "ОС_Амортизация." + ИмяРеквизита
				+ ?(НужноПредставление, ")", "")
				+ "	КАК " + ИмяРеквизита
				+ ",";
				
		КонецЦикла;
			
	КонецЕсли;
	
	// Удаляем последнюю запятую:
	Текст = Лев(Текст, СтрДлина(Текст) - 1);
	
	Текст = Текст + "
	|ИЗ
	|	Документ.ВводНачальныхОстатков.ОС_Основная	КАК ОС_Основная";
	
	Если ЭтоРазделУчетаОС Тогда
		Текст = Текст + "
		|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводНачальныхОстатков.ОС_Амортизация	КАК ОС_Амортизация
		|		ПО ОС_Основная.ОС = ОС_Амортизация.ОС
		|		И ОС_Основная.Ссылка = ОС_Амортизация.Ссылка";
	КонецЕсли;
	
	Текст = Текст + "
	|ГДЕ
	|	ОС_Основная.Ссылка В (&МассивОбъектов)
	//|	И ОС_Основная.Ссылка.РазделУчета = &РазделУчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокСсылка, НПП
	|
	|ИТОГИ";
	
	// Итоги:
	Для Каждого ИмяПоля Из ИменаИтоговыхПолей Цикл
		Текст = Текст + "
		|	СУММА(" + ИмяПоля + ")	КАК " + ИмяПоля + ",";
	КонецЦикла;
	
	// Удаляем последнюю запятую:
	Текст = Лев(Текст, СтрДлина(Текст) - 1);
	
	Текст = Текст + "
	|ПО
	|	ДокСсылка
	|;";
	
	// Здесь список реквизитов составлен.
	// Получим новую структуру с такими же ключами, по которой будем заполнять составляемый документ.
	// Копируем имена полей из ТЧ:
	ПоляСтроки = Новый Структура();
	Для Каждого Элем Из СвойстваРеквизитов Цикл
		ПоляСтроки.Вставить(Элем.Ключ);
	КонецЦикла;
	// Добавляем имена полей, указанных в запросе вручную:
	ПоляСтроки.Вставить("ОС");
	ПоляСтроки.Вставить("ГрупповойУчет");

	
	ЗапросПечать = Новый Запрос(Текст);
	ЗапросПечать.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ЗапросПечать.УстановитьПараметр("РазделУчета", РазделУчета);
	РезультатПакетаЗапросов = ЗапросПечать.ВыполнитьПакет();
	ШапкиДокументов		= РезультатПакетаЗапросов[0];
	ДанныеДокументов	= РезультатПакетаЗапросов[1];
	
	Макет = ПолучитьМакет("ПФ_MXL_ОС_Ведомость");
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапкаЛЧ		= Макет.ПолучитьОбласть("Шапка|ЛеваяЧасть");
	ОбластьШапкаКолонка	= Макет.ПолучитьОбласть("Шапка|Колонка");
	ОбластьСтрокаЛЧ		= Макет.ПолучитьОбласть("Строка|ЛеваяЧасть");
	ОбластьСтрокаКолонка= Макет.ПолучитьОбласть("Строка|Колонка");
	ОбластьИтогЛЧ		= Макет.ПолучитьОбласть("Итог|ЛеваяЧасть");
	ОбластьИтогКолонка	= Макет.ПолучитьОбласть("Итог|Колонка");
	
	// Цикл по печатаемым документам:
	ВыборкаДокШапка	= ШапкиДокументов.Выбрать();
	ВыборкаДок		= ДанныеДокументов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ПервыйДокумент = Истина;
	Пока ВыборкаДокШапка.Следующий() Цикл
		
		ВыборкаДок.НайтиСледующий(ВыборкаДокШапка.ДокСсылка, "ДокСсылка");
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		//-----------
		// ЗАГОЛОВОК
		//-----------
		ОбластьЗаголовок.Параметры.Заполнить(ВыборкаДокШапка);
		СтруктураОбластьЗаголовок = Новый Структура;
		СтруктураОбластьЗаголовок.Вставить("СчетУчета",ВыборкаДокШапка.КПС + "."
			+ ВыборкаДокШапка.КФО + "."
			+ ВыборкаДокШапка.Счет + "."
			+ ВыборкаДокШапка.КЭК);
			
        НомерДляПечати = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаДокШапка.ДокСсылка,ВыборкаДокШапка.ДокНомер);
		ПредставлениеСсылки = Строка(ВыборкаДокШапка.ДокСсылка);
		ПредставлениеДляПечати = СтрЗаменить(ПредставлениеСсылки,СокрЛП(ВыборкаДокШапка.ДокНомер),НомерДляПечати);
		СтруктураОбластьЗаголовок.Вставить("ДокСсылка",ПредставлениеДляПечати);
		ОбластьЗаголовок.Параметры.Заполнить(СтруктураОбластьЗаголовок);
		ТабДокумент.Вывести(ОбластьЗаголовок);
		
		//-------
		// ШАПКА
		//-------
		ТабДокумент.Вывести(ОбластьШапкаЛЧ);
		Для Каждого ИмяРеквизита Из СвойстваРеквизитов Цикл
			ОбластьШапкаКолонка.Параметры.Заголовок = ИмяРеквизита.Значение.Синоним;
			ТабДокумент.Присоединить(ОбластьШапкаКолонка);
		КонецЦикла;
		
		// Цикл по строкам очередного документа:
		Выборка = ВыборкаДок.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ЗаполнитьЗначенияСвойств(ПоляСтроки, Выборка);
			
			//--------
			// СТРОКА
			//--------
			ОбластьСтрокаЛЧ.Параметры.Заполнить(Выборка);
			ТабДокумент.Вывести(ОбластьСтрокаЛЧ);
			Для Каждого Элем Из СвойстваРеквизитов Цикл
				
				ИмяПоля = Элем.Ключ;
				ТипПоля = Элем.Значение.Тип;
				
				// Выводимое значение:
				ОбластьСтрокаКолонка.Параметры.Заполнить(Новый Структура("Данные", ПоляСтроки[ИмяПоля]));
				
				// Формат ячейки:
				Если ТипПоля.СодержитТип(Тип("Булево")) Тогда
					
					ОбластьСтрокаКолонка.ТекущаяОбласть.Формат = "БЛ=Нет; БИ=Да";
					
				ИначеЕсли ТипПоля.СодержитТип(Тип("Дата")) Тогда
					
					ОбластьСтрокаКолонка.ТекущаяОбласть.Формат = "ДЛФ=DD";
					
				ИначеЕсли ТипПоля.СодержитТип(Тип("Число")) Тогда
					
					Разрядность = ТипПоля.КвалификаторыЧисла.Разрядность;
					РазрядностьДробнойЧасти = ТипПоля.КвалификаторыЧисла.РазрядностьДробнойЧасти;
					СтрокаФормата = ?(Разрядность=0,"","ЧЦ="+Разрядность+";")+?(РазрядностьДробнойЧасти=0,"","ЧДЦ="+РазрядностьДробнойЧасти);				
					
					ОбластьСтрокаКолонка.ТекущаяОбласть.Формат = СтрокаФормата;
					
				КонецЕсли;
				
				ТабДокумент.Присоединить(ОбластьСтрокаКолонка);
				
			КонецЦикла;
			
		КонецЦикла;
		
		//------
		// ИТОГ
		//------
		ЗаполнитьЗначенияСвойств(ПоляСтроки, ВыборкаДок);
		ТабДокумент.Вывести(ОбластьИтогЛЧ);
		Для Каждого Элем Из СвойстваРеквизитов Цикл
			ИмяПоля = Элем.Ключ;
			ТипПоля = Элем.Значение.Тип;
			
			// Выводимое значение:
			ОбластьИтогКолонка.Параметры.Заполнить(Новый Структура("Данные", ПоляСтроки[ИмяПоля]));
			
			// Формат ячейки:
			Если НЕ ИменаИтоговыхПолей.Найти(ИмяПоля) = Неопределено Тогда
				РазрядностьДробнойЧасти = ТипПоля.КвалификаторыЧисла.РазрядностьДробнойЧасти;
				СтрокаФормата = ?(РазрядностьДробнойЧасти=0,"","ЧДЦ="+РазрядностьДробнойЧасти+";");				
				ОбластьИтогКолонка.ТекущаяОбласть.Формат = СтрокаФормата+"ЧРД=,; ЧРГ=; ЧГ=3,0";
			КонецЕсли;
			
			ТабДокумент.Присоединить(ОбластьИтогКолонка);
			
		КонецЦикла;
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаДок.ДокСсылка);
			
	КонецЦикла;
	
	ТабДокумент.ОтображатьСетку     = Ложь;
	ТабДокумент.ТолькоПросмотр      = Истина;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура МодифицироватьПериодВСтрокахДублей(ТаблицаДвижений, ИменаКолонокИзмерений, ИмяКолонкиПериод)
	
	МассивКолонокИзмерений = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаКолонокИзмерений, ",");
	
	// Пронумеруем строки таблицы:
	КЧ = Новый КвалификаторыЧисла(12,0);
	ТЗ = ТаблицаДвижений.Скопировать(, ИменаКолонокИзмерений + "," + ИмяКолонкиПериод);
	ТЗ.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число",,,КЧ));
	НомерСтроки = 1;
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		СтрокаТЗ["НомерСтроки"] = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	// Подставим имена колонок-измерений:
	ВыборИзмерений_0 = "";
	ИндексированиеИзмерений_0 = "";
	ВыборИзмерений_1 = "";
	ГруппировкаИзмерений_1 = "";
	СоединениеПоИзмерениям_2 = "";
	ВыборИзмерений_3 = "";
	НомерИзмерения = 1;
	Для Каждого ИмяКолонки Из МассивКолонокИзмерений Цикл
		ВыборИзмерений_0 = ВыборИзмерений_0 + "ТЗ." + ИмяКолонки + "	КАК Измерение" + НомерИзмерения + ",
			|	";
		ИндексированиеИзмерений_0 = ИндексированиеИзмерений_0 + "Измерение" + НомерИзмерения + ",
			|	";
			
		ВыборИзмерений_1 = ВыборИзмерений_1 + "Измерение" + НомерИзмерения + ",
			|	";
		ГруппировкаИзмерений_1 = ГруппировкаИзмерений_1 + "Измерение" + НомерИзмерения + ",
			|	";
			
		СоединениеПоИзмерениям_2 = СоединениеПоИзмерениям_2 + "И	ДублиСтрок.Измерение" + НомерИзмерения
			+ " = ИсходнаяТаблица.Измерение" + НомерИзмерения + "
			|		";
			
		ВыборИзмерений_3 = ВыборИзмерений_3 + "ДублиСтрок.Измерение" + НомерИзмерения + "	КАК " + ИмяКолонки + ",
			|	";
			
		НомерИзмерения = НомерИзмерения + 1;
	КонецЦикла;
	
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Исходная таблица
	|//		(Строки движений по рег.свед., в которых необходимо увеличить поле ""Период"")
	|ВЫБРАТЬ
	|	ТЗ.НомерСтроки			КАК НомерСтроки,
	|	<ВыборИзмерений_0>
	|	ТЗ.<ИмяКолонкиПериод>	КАК Период
	|ПОМЕСТИТЬ
	|	ИсходнаяТаблица
	|ИЗ
	|	&ТЗ	КАК	ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	<ИндексированиеИзмерений_0>
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Первые строки дублей.
	|//		(Строки движений по рег.свед., в которых необходимо увеличить поле ""Период"")
	|ВЫБРАТЬ
	|	МИНИМУМ(НомерСтроки)	КАК НомерСтроки,
	|	<ВыборИзмерений_1>
	|	Период					КАК Период
	|ПОМЕСТИТЬ
	|	ДублиСтрок
	|ИЗ
	|	ИсходнаяТаблица
	|СГРУППИРОВАТЬ ПО
	|	<ГруппировкаИзмерений_1>
	|	Период
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Строки движений по рег.свед., в которых необходимо увеличить поле ""Период"".
	|//		(Финальная таблица для дальнейшей обработки)
	|ВЫБРАТЬ
	|	ИсходнаяТаблица.НомерСтроки	КАК НомерМодифицируемойСтроки,
	|	ДублиСтрок.НомерСтроки		КАК НомерИсходнойСтроки
	|ИЗ
	|	ДублиСтрок
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ИсходнаяТаблица
	|		ПО	ДублиСтрок.Период = ИсходнаяТаблица.Период
	|		И	НЕ ДублиСтрок.НомерСтроки = ИсходнаяТаблица.НомерСтроки
	|		<СоединениеПоИзмерениям_2>
	|УПОРЯДОЧИТЬ ПО
	|	НомерИсходнойСтроки, // первое упорядочивание обязательно как в [3]
	|	НомерМодифицируемойСтроки
	|ИТОГИ
	|ПО
	|	НомерИсходнойСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Все уже используемые периоды в найденных строках дублей по измерениям.
	|//		(Финальная таблица для дальнейшей обработки)
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	<ВыборИзмерений_3>
	|	ИсходнаяТаблица.Период	КАК <ИмяКолонкиПериод>
	|ИЗ
	|	ДублиСтрок
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ИсходнаяТаблица
	|		ПО	НЕ ДублиСтрок.НомерСтроки = ИсходнаяТаблица.НомерСтроки
	|		<СоединениеПоИзмерениям_2>
	|;";
	
	// Окончательная настройка текста запроса:
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ИмяКолонкиПериод>",			ИмяКолонкиПериод);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ВыборИзмерений_0>",			ВыборИзмерений_0);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ИндексированиеИзмерений_0>",	ИндексированиеИзмерений_0);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ВыборИзмерений_1>",			ВыборИзмерений_1);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ГруппировкаИзмерений_1>",	ГруппировкаИзмерений_1);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<СоединениеПоИзмерениям_2>",	СоединениеПоИзмерениям_2);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ВыборИзмерений_3>",			ВыборИзмерений_3);

	// Выполняем запросы:
	ЗапросВыбор = Новый Запрос(ТекстЗапроса);
	ЗапросВыбор.УстановитьПараметр("ТЗ", ТЗ);
	РезультатыЗапросов = ЗапросВыбор.ВыполнитьПакет();
	
	ДЗНомераСтрок = РезультатыЗапросов[2].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТЗИспользуемыеПериоды = РезультатыЗапросов[3].Выгрузить();
	ПоискПериодов = Новый Структура(ИменаКолонокИзмерений);
	
	Для Каждого СтрокаИтого Из ДЗНомераСтрок.Строки Цикл
		НомерИсходнойСтроки = СтрокаИтого["НомерИсходнойСтроки"];
		ИндексИсходнойСтроки = НомерИсходнойСтроки - 1;
		
		// Строка исходной таблицы движений:
		ИсходнаяСтрока = ТаблицаДвижений[ИндексИсходнойСтроки];
		ИсходныйПериод = ИсходнаяСтрока[ИмяКолонкиПериод];
		
		ЗаполнитьЗначенияСвойств(ПоискПериодов, ИсходнаяСтрока);
		
		// Обходим и модифицируем выявленные строки:
		НомераМодифицируемыхСтрок = СтрокаИтого.Строки.ВыгрузитьКолонку("НомерМодифицируемойСтроки");
		Дельта = 1;
		Для Каждого НомерСтроки Из НомераМодифицируемыхСтрок Цикл
			
			// Планируемое к установке значение поля "Период":
			НовПериод = ИсходныйПериод + Дельта;
			
			// Проверим, не используется ли уже такой период?
			ПоискПериодов.Вставить(ИмяКолонкиПериод, НовПериод);
			СтрокиПериодов = ТЗИспользуемыеПериоды.НайтиСтроки(ПоискПериодов);
			Пока (СтрокиПериодов.Количество() > 0) Цикл
				Дельта = Дельта + 1;
				НовПериод = ИсходныйПериод + Дельта;
				
				ПоискПериодов.Вставить(ИмяКолонкиПериод, НовПериод);
				СтрокиПериодов = ТЗИспользуемыеПериоды.НайтиСтроки(ПоискПериодов);
			КонецЦикла;
			НоваяСтрокаПериода = ТЗИспользуемыеПериоды.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаПериода, ПоискПериодов);
			
			// Заменяем поле "Период" в исходной таблице движений:
			МодифицируемаяСтрока = ТаблицаДвижений[НомерСтроки - 1];
			МодифицируемаяСтрока[ИмяКолонкиПериод] = НовПериод;
			
			Дельта = Дельта + 1;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСчетИКЭКАмортизации(ДокументОбъект)
	
	СчетАмортизации	= УправлениеОсновнымиСредствамиПовтИсп.СчетАмортизацииОС(ДокументОбъект["Счет"]);
	КЭКАмортизации	= ПолучитьКОСГУПоУмолчанию(СчетАмортизации, "Кт");
	
	Результат = Новый Структура();
	Результат.Вставить("Счет",	СчетАмортизации);
	Результат.Вставить("КЭК",	КЭКАмортизации);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКОСГУПоУмолчанию(СчетСсылка, ДК, ЖелаемыйКЭК = Неопределено)
	
	Результат = Справочники.КОСГУ.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(СчетСсылка) Тогда
		// Выходим
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетСсылка", СчетСсылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕПСБУ.КОСГУ" + ДК + " КАК КОСГУ
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |ГДЕ
	               |	ЕПСБУ.Ссылка = &СчетСсылка";
				   
	Выборка = Запрос.Выполнить().Выбрать();			   
	Если Выборка.Следующий() Тогда
		Результат = Выборка.КОСГУ;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Результат) И ЗначениеЗаполнено(ЖелаемыйКЭК) Тогда
		Если ТипЗнч(ЖелаемыйКЭК) = Тип("Строка") Тогда
			// Указан код
			УказанКод		= Истина;
			УказанаСсылка	= Ложь;
		ИначеЕсли ТипЗнч(ЖелаемыйКЭК) = Тип("СправочникСсылка.КОСГУ") Тогда
			// Указана ссылка
			УказанКод		= Ложь;
			УказанаСсылка	= Истина;
		КонецЕсли;
		
		Если УказанКод ИЛИ УказанаСсылка Тогда
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("СчетСсылка",		СчетСсылка);
			Запрос.УстановитьПараметр("ЖелаемыйКЭК",	ЖелаемыйКЭК);
			Запрос.УстановитьПараметр("УказанКод",		УказанКод);
			Запрос.УстановитьПараметр("УказанаСсылка",	УказанаСсылка);
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	КЭКСчетов.КЭК
			|ИЗ
			|	РегистрСведений.КЭКСчетов КАК КЭКСчетов
			|ГДЕ
			|	КЭКСчетов.Счет = &СчетСсылка
			|	И КЭКСчетов.Использовать = ИСТИНА
			|	И ВЫБОР
			|		КОГДА &УказанКод ТОГДА
			|			КЭКСчетов.КЭК.Код = &ЖелаемыйКЭК
			|		КОГДА &УказанаСсылка ТОГДА
			|			КЭКСчетов.КЭК = &ЖелаемыйКЭК
			|		ИНАЧЕ
			|			ЛОЖЬ
			|	КОНЕЦ
			|;";
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Результат = Выборка.КЭК;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции	

Процедура ПерезаполнитьДокументАгрегатор(ДокументСсылка, НеТолькоАгрегаторы = Ложь, ПерезаполнятьРазделУчета = Ложь) Экспорт
	
	ДокОбъект = ДокументСсылка.ПолучитьОбъект();
	
	Если Не НеТолькоАгрегаторы И Не ДокОбъект.ЭтоАгрегаторДвижений Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Таблица Из ДокОбъект.Движения Цикл
		Таблица.Прочитать();
	КонецЦикла;
	
	Если Не ПерезаполнятьРазделУчета Тогда
		ДокОбъект.ДополнительныеСвойства.Вставить("РазделУчета", ДокОбъект.РазделУчета);
	КонецЕсли;
	
	ДокОбъект.Заполнить("ИзДвиженийДокумента");
	
	ДокОбъект.ОбменДанными.Загрузка = Истина;
	ДокОбъект.Записать();
	
КонецПроцедуры

//---
// Заполнение из движений
//---

Процедура ДобавитьКПервымОбнаруженнымЗначениям(ИмяПоля, Значение, ОбластьЗначений)
	
	// Добавляем любое значение, кроме Null (пустую ссылку добавляем)
	
	Если ОбластьЗначений.Свойство(ИмяПоля) Тогда
		Возврат;
	КонецЕсли;
	
	Если Значение <> Null Тогда
		ОбластьЗначений.Вставить(ИмяПоля, Значение);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКПервымОбнаруженнымЗаполненнымЗначениям(ИмяПоля, Значение, ОбластьЗначений)
	
	// Добавляем только заполненное значение (пустую ссылку не добавляем)
	
	Если ОбластьЗначений.Свойство(ИмяПоля) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Значение) Тогда
		ОбластьЗначений.Вставить(ИмяПоля, Значение);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКРазличнымЗначениям(ИмяПоля, Значение, ОбластьЗначений)
	
	Перем МассивЗначений;
	
	Если ОбластьЗначений.Свойство(ИмяПоля, МассивЗначений) Тогда
		
		ЕстьТакоеЗначение = (МассивЗначений.Найти(Значение) <> Неопределено);
		
		Если ЕстьТакоеЗначение Тогда
			
			Возврат;
			
		КонецЕсли;
		
	Иначе
		
		МассивЗначений = Новый Массив();
		
	КонецЕсли;
	
	МассивЗначений.Добавить(Значение);
	
	ОбластьЗначений.Вставить(ИмяПоля, МассивЗначений);
	
КонецПроцедуры

Процедура ДобавитьСуммыВПорядкеСледованияСтрокТаблиц(ТаблицаПриемник, ТаблицаИсточник, ПоляКлючаСвязиСтрокой, ПоляСуммСтрокой)
	
	ПоляСуммМассив = СтрРазделить(ПоляСуммСтрокой, ",");
	
	КопияТаблицаПриемник = ТаблицаПриемник.Скопировать();
	КопияТаблицаПриемник.Свернуть(ПоляКлючаСвязиСтрокой);
	
	КопияТаблицаИсточник = ТаблицаИсточник.Скопировать();
	КопияТаблицаИсточник.Свернуть(ПоляКлючаСвязиСтрокой);
	
	Поиск = Новый Структура(ПоляКлючаСвязиСтрокой);
	
	Для Каждого СтрокаКлючСвязиТаблицаИсточник Из КопияТаблицаИсточник Цикл
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаКлючСвязиТаблицаИсточник);
		
		МассивСтрокПриемник = ТаблицаПриемник.НайтиСтроки(Поиск);
		
		КоличествоСтрокПоискПриемник = МассивСтрокПриемник.Количество();
		
		МассивСтрокИсточник = ТаблицаИсточник.НайтиСтроки(Поиск);
		
		КоличествоСтрокПоискИсточник = МассивСтрокИсточник.Количество();
		
		Если КоличествоСтрокПоискПриемник = 0 Тогда
			
			// В таблице-приемнике нет строки с таким ключом связи.
			// В таком случае создаем одну единственную новую строку,
			// и в нее добавляем суммы из всех строк таблицы-источника.
			
			СтрокаПриемник = ТаблицаПриемник.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаПриемник, Поиск);
			
			Для Каждого СтрокаИсточник Из МассивСтрокИсточник Цикл
				Для Каждого ИмяПоляСумма Из ПоляСуммМассив Цикл
					СтрокаПриемник[ИмяПоляСумма] = СтрокаПриемник[ИмяПоляСумма] + СтрокаИсточник[ИмяПоляСумма];
				КонецЦикла;
			КонецЦикла;
			
		Иначе
			
			// Продвигаемся по одной строке синхронно сразу в обеих таблицах.
			// Если таблица-приемник закончится раньше, чем таблица-источник,
			// то будем продолжать заполнять (накапливать) в последней строке.
			
			Для НомерСтрокиПоискИсточник = 1 По КоличествоСтрокПоискИсточник Цикл
				
				НомерСтрокиПоискПриемник = ?(НомерСтрокиПоискИсточник <= КоличествоСтрокПоискПриемник,
					НомерСтрокиПоискИсточник,
					КоличествоСтрокПоискПриемник);
				
				СтрокаИсточник = МассивСтрокИсточник[НомерСтрокиПоискИсточник - 1];
				
				СтрокаПриемник = МассивСтрокПриемник[НомерСтрокиПоискПриемник - 1];
				
				Для Каждого ИмяПоляСумма Из ПоляСуммМассив Цикл
					СтрокаПриемник[ИмяПоляСумма] = СтрокаПриемник[ИмяПоляСумма] + СтрокаИсточник[ИмяПоляСумма];
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

//---
// Раздел учета "Права пользования активами"
//---

Функция ЕстьОшибкиЗаполнения_ПраваПользованияАктивами(ДокументОбъект) Экспорт
	
	Перем ОбщиеПараметрыАмортизации;
	
	ЕстьОшибкиЗаполнения = Ложь;
	
	ПоДоговоруВЦелом = ДокументОбъект.ПараметрыАмортизацииУстановленыПоДоговоруВЦелом;
	
	Если ПоДоговоруВЦелом Тогда
		
		ОбщиеПараметрыАмортизации = Документы.ВводНачальныхОстатков.ПолучитьОбщиеПараметрыНачисленияАмортизации(ДокументОбъект);
		
		Если ОбщиеПараметрыАмортизации = Неопределено Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			ТекстСообщения = НСтр("ru='Обнаружены несогласованные между собой настройки параметров амортизации в разных строках таблицы.
				|
				|Для исправления рассогласования данных либо запишите документ, либо переключите
				|режим указания параметров амортизации в значение ""По каждому объекту отдельно"",
				|и устраните различия вручную.'");
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект.Ссылка,
				"Объект.ПараметрыАмортизацииУстановленыПоДоговоруВЦелом");
				
			// Это критическая ошибка, сразу выходим
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	//
	// Заполненность обязательных реквизитов
	//
	
	ПроверитьЗаполненностьРеквизитов_ПраваПользованияАктивами(
		ДокументОбъект,
		ЕстьОшибкиЗаполнения,
		ПоДоговоруВЦелом,
		ОбщиеПараметрыАмортизации);
	
	//
	// Наличие уже существующих документов по таком договору
	//
	
	ТаблицаДокументов = ПроверитьНаличиеДокументовВводаОстатков_ПраваПользованияАктивами(ДокументОбъект);
	
	Если ТаблицаДокументов.Количество() > 0 Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ТекстШаблон = НСтр("ru='По договору ""%1"" остатки уже введены документами: %2'");
		
		СписокДокументов = "";
		
		Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
			ПредставлениеДокумента = СтрокаТаблицы.Номер + " от " + СтрокаТаблицы.Дата;
			
			СписокДокументов = СписокДокументов
				+ ?(СписокДокументов = "", "", "; ")
				+ ПредставлениеДокумента;
		КонецЦикла;
		
		ТекстСообщения = СтрШаблон(ТекстШаблон, ДокументОбъект.Договор, СписокДокументов);
		
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			ДокументОбъект.Ссылка,
			"Объект.Договор");
	КонецЕсли;
	
	//
	// Дубли строк
	//
	
	КлючСвязи = "ОсновноеСредство";
	
	ПараметрыВывода = Новый Структура();
	ПараметрыВывода.Вставить("ТаблицаИмя",				"ПраваПользования");
	ПараметрыВывода.Вставить("ТаблицаПредставление",	НСтр("ru='Права пользования'"));
	ПараметрыВывода.Вставить("ОбъектСсылка",			ДокументОбъект["Ссылка"]);
	ПараметрыВывода.Вставить("ШаблонСтроки",			НСтр("ru='Обнаружены дубли строк по колонке ""Право пользования"" (таблица ""[ТаблицаПредставление]"", строки [НомераСтрок])'"));
	
	ТаблицаДублиСтрок = УчетНДС.НайтиДублиСтрок(ДокументОбъект["ПраваПользования"], КлючСвязи);
	
	Если ТаблицаДублиСтрок.Количество() > 0 Тогда
		ЕстьОшибкиЗаполнения = Истина;
		УчетНДС.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	КонецЕсли;
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Процедура ПроверитьЗаполненностьРеквизитов_ПраваПользованияАктивами(ДокументОбъект, ЕстьОшибкиЗаполнения, ПоДоговоруВЦелом, ОбщиеПараметрыАмортизации)
	
	Перем РезультатПроверки;
	
	ПроверяемыеРеквизиты = Новый Массив();
	
	ПроверяемыеСубконто = Новый Структура();
	
	ПроверяемыеПризнакиУчета = Новый Структура();
	
	ПроверяемыеРеквизитыУсловия_ПраваПользования = Новый Структура();
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(
		ДокументОбъект.Организация, ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(ДокументОбъект.Дата));
	
	// Параметры амортизации
	//
	// В зависимости от исходных данных, на форме документа информация выводится
	// или в отдельных полях, или в табличной части.
	//
	// Это определяет адресацию выводимых сообщений.
	
	Если ПоДоговоруВЦелом Тогда
		// Параметры амортизации выводятся в отдельных полях
		
		ТекстШаблон = НСтр("ru='Поле ""%1"" не заполнено'");
		
		СпособТребуетДат = (ОбщиеПараметрыАмортизации.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням
			ИЛИ ОбщиеПараметрыАмортизации.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам);
			
		Если НЕ ЗначениеЗаполнено(ОбщиеПараметрыАмортизации.СпособПризнанияРасходов) Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			ТекстСообщения = СтрШаблон(ТекстШаблон, НСтр("ru='Способ признания расходов'"));
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"СпособПризнанияРасходов");
		КонецЕсли;
		
		Если СпособТребуетДат И НЕ ЗначениеЗаполнено(ОбщиеПараметрыАмортизации.ДатаНачалаАмортизации) Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			ТекстСообщения = СтрШаблон(ТекстШаблон, НСтр("ru='Дата начала амортизации'"));
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"ДатаНачалаАмортизации");
		КонецЕсли;
		
		Если СпособТребуетДат И НЕ ЗначениеЗаполнено(ОбщиеПараметрыАмортизации.ДатаОкончанияАмортизации) Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			ТекстСообщения = СтрШаблон(ТекстШаблон, НСтр("ru='Дата окончания амортизации'"));
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"ДатаОкончанияАмортизации");
		КонецЕсли;
	
	Иначе
		// Параметры амортизации выводятся в табличной части
		
		ПроверяемыеРеквизиты.Добавить("ПраваПользования.СпособПризнанияРасходов");
		ПроверяемыеРеквизиты.Добавить("ПраваПользования.ДатаНачалаАмортизации");
		ПроверяемыеРеквизиты.Добавить("ПраваПользования.ДатаОкончанияАмортизации");
		
		УсловиеДаты = "(СпособПризнанияРасходов = ЗНАЧЕНИЕ(Перечисление.СпособыПризнанияРасходов.ПоКалендарнымДням) ИЛИ СпособПризнанияРасходов = ЗНАЧЕНИЕ(Перечисление.СпособыПризнанияРасходов.ПоМесяцам))";
		
		ПроверяемыеРеквизитыУсловия_ПраваПользования.Вставить("ДатаНачалаАмортизации", УсловиеДаты);
		ПроверяемыеРеквизитыУсловия_ПраваПользования.Вставить("ДатаОкончанияАмортизации", УсловиеДаты);
	КонецЕсли;
	
	// Счет расходов в табличной части
	Если НЕ ПоДоговоруВЦелом Тогда
		
		ПроверяемыеРеквизиты.Добавить("ПраваПользования.СчетРасходов");
		
		КолонкиПризнаков = Новый Структура();
		КолонкиПризнаков.Вставить("Счет",					"СчетРасходов");
		КолонкиПризнаков.Вставить("УчетПоПодразделениям",	"ПодразделениеРасходов");
		КолонкиПризнаков.Вставить("УчетПоКПС",				"КПСРасходов");
		КолонкиПризнаков.Вставить("УчетПоКЭК",				"КЭКРасходов");
		
		ПроверяемыеПризнакиУчета.Вставить("ПраваПользования", КолонкиПризнаков);
		
		КолонкиСубконто = Новый Соответствие();
		КолонкиСубконто.Вставить("Счет",		"СчетРасходов");
		КолонкиСубконто.Вставить("Субконто1",	"СубконтоРасходов1");
		КолонкиСубконто.Вставить("Субконто2",	"СубконтоРасходов2");
		КолонкиСубконто.Вставить("Субконто3",	"СубконтоРасходов3");
		
		ПроверяемыеСубконто.Вставить("ПраваПользования", КолонкиСубконто);
		
	КонецЕсли;
	
	ВыполняетсяОплата = (
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду
		ИЛИ ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях);
	
	ЕстьОтложенныеДоходы = (
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях
		ИЛИ ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
		
	
	ПроверяемыеРеквизиты.Добавить("Организация");
	ПроверяемыеРеквизиты.Добавить("Дата");
	ПроверяемыеРеквизиты.Добавить("Контрагент");
	ПроверяемыеРеквизиты.Добавить("Договор");
	ПроверяемыеРеквизиты.Добавить("ВидОперации");
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ПроверяемыеРеквизиты.Добавить("ИФО");
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетПравПользованияПоПодразделениям() Тогда
		ПроверяемыеРеквизиты.Добавить("ПраваПользования.Подразделение");
	КонецЕсли;
	
	Если ВыполняетсяОплата Тогда
		ПроверяемыеРеквизиты.Добавить("ПраваПользования.СчетРасчетов");
		ПроверяемыеРеквизиты.Добавить("ПраваПользования.КПСРасчетов");
	КонецЕсли;
	
	Если ЕстьОтложенныеДоходы Тогда
		ПроверяемыеРеквизиты.Добавить("СчетДБП");
		ПроверяемыеРеквизиты.Добавить("КПСДоходов");
		ПроверяемыеРеквизиты.Добавить("КЭКДоходов");
		
		Если УчетнаяПолитика.ПлательщикНалогаНаПрибыль Тогда
			ПроверяемыеРеквизиты.Добавить("ВидДеятельностиНУ");
			ПроверяемыеРеквизиты.Добавить("СчетДоходовНУ");
			ПроверяемыеРеквизиты.Добавить("СтатьяПрочихДоходовНУ");
		КонецЕсли;
	КонецЕсли;
	
	ПроверяемыеРеквизитыУсловия = Новый Структура();
	ПроверяемыеРеквизитыУсловия.Вставить("ПраваПользования", ПроверяемыеРеквизитыУсловия_ПраваПользования);
	
	ПараметрыПроверки = Новый Структура();
	ПараметрыПроверки.Вставить("ВыводитьСообщения",				Истина);
	ПараметрыПроверки.Вставить("ПроверяемыеРеквизиты",			ПроверяемыеРеквизиты);
	ПараметрыПроверки.Вставить("ПроверяемыеСубконто",			ПроверяемыеСубконто);
	ПараметрыПроверки.Вставить("ПроверяемыеПризнакиУчета",		ПроверяемыеПризнакиУчета);
	ПараметрыПроверки.Вставить("ПроверяемыеРеквизитыУсловия",	ПроверяемыеРеквизитыУсловия);
	
	РеквизитыЗаполнены = ОбщегоНазначенияБГУ.УказанныеРеквизитыЗаполнены(ДокументОбъект, ПараметрыПроверки, РезультатПроверки);
	
	ЕстьОшибкиЗаполнения = НЕ РеквизитыЗаполнены;
	
	// Проверка счетов из шапки документа
	
	// Счет расходов в шапке документа
	Если ПоДоговоруВЦелом Тогда
		
		РеквизитыАналитики = Новый Структура();
		РеквизитыАналитики.Вставить("Счет",				"СчетРасходов");
		РеквизитыАналитики.Вставить("КПС",				"КПСРасходов");
		РеквизитыАналитики.Вставить("КЭК",				"КЭКРасходов");
		РеквизитыАналитики.Вставить("Субконто1",		"СубконтоРасходов1");
		РеквизитыАналитики.Вставить("Субконто2",		"СубконтоРасходов2");
		РеквизитыАналитики.Вставить("Субконто3",		"СубконтоРасходов3");
		РеквизитыАналитики.Вставить("Подразделение",	"ПодразделениеРасходов");
		
		ПараметрыПроверки = Новый Структура();
		ПараметрыПроверки.Вставить("РеквизитыАналитики",	РеквизитыАналитики);
		ПараметрыПроверки.Вставить("МетаданныеРеквизитов",	ДокументОбъект.Метаданные().ТабличныеЧасти["ПраваПользования"].Реквизиты);
		
		ПроверитьЗаполнениеСчетаИАналитики(
			ОбщиеПараметрыАмортизации,
			ПараметрыПроверки,
			ДокументОбъект["Ссылка"],
			ЕстьОшибкиЗаполнения);
			
	КонецЕсли;
	
	// Счет доходов в шапке документа
	Если ЕстьОтложенныеДоходы Тогда
		
		РеквизитыАналитики = Новый Структура();
		РеквизитыАналитики.Вставить("Счет",			"СчетДоходов");
		РеквизитыАналитики.Вставить("Субконто1",	"СубконтоДоходов1");
		РеквизитыАналитики.Вставить("Субконто2",	"СубконтоДоходов2");
		РеквизитыАналитики.Вставить("Субконто3",	"СубконтоДоходов3");
		
		ПараметрыПроверки = Новый Структура();
		ПараметрыПроверки.Вставить("РеквизитыАналитики", РеквизитыАналитики);
		
		ПроверитьЗаполнениеСчетаИАналитики(
			ДокументОбъект,
			ПараметрыПроверки,
			ДокументОбъект["Ссылка"],
			ЕстьОшибкиЗаполнения);
			
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьДанныеДокумента_ПраваПользованияАктивами(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	СпособПризнанияДоходов	= Перечисления.СпособыПризнанияРасходов.ПустаяСсылка();
	ДатаНачалаСписания		= '00010101';
	ДатаОкончанияСписания	= '00010101';
	
	ПоДоговоруВЦелом = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ПараметрыАмортизацииУстановленыПоДоговоруВЦелом");
	
	Если ПоДоговоруВЦелом Тогда
		
		ЗапросТЧ = Новый Запрос();
		ЗапросТЧ.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
		ЗапросТЧ.Текст = "
		|ВЫБРАТЬ
		|	*
		|ИЗ
		|	Документ.ВводНачальныхОстатков.ПраваПользования
		|ГДЕ
		|	Ссылка = &ДокументСсылка";
		
		ТаблицаПраваПользования = ЗапросТЧ.Выполнить().Выгрузить();
		
		ДокументСтруктура = Новый Структура();
		ДокументСтруктура.Вставить("ПраваПользования", ТаблицаПраваПользования);
		
		ОбщиеПараметрыАмортизации = Документы.ВводНачальныхОстатков.ПолучитьОбщиеПараметрыНачисленияАмортизации(ДокументСтруктура);
		
		Если ОбщиеПараметрыАмортизации <> Неопределено Тогда
			СпособПризнанияДоходов	= ОбщиеПараметрыАмортизации["СпособПризнанияРасходов"];
			ДатаНачалаСписания		= ОбщиеПараметрыАмортизации["ДатаНачалаАмортизации"];
			ДатаОкончанияСписания	= ОбщиеПараметрыАмортизации["ДатаОкончанияАмортизации"];
		КонецЕсли;
		
	КонецЕсли;
	
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	
	ЗапросДвижения = Новый Запрос();
	ЗапросДвижения.УстановитьПараметр("ДокументСсылка",			ДокументСсылка);
	ЗапросДвижения.УстановитьПараметр("СпособПризнанияДоходов",	СпособПризнанияДоходов);
	ЗапросДвижения.УстановитьПараметр("ДатаНачалаСписания",		ДатаНачалаСписания);
	ЗапросДвижения.УстановитьПараметр("ДатаОкончанияСписания",	ДатаОкончанияСписания);
	ЗапросДвижения.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Движения по регистру сведений ПараметрыАмортизацииПравПользованияОС
	|//
	|ВЫБРАТЬ
	|	Ссылка.Дата					КАК Период,
	|	Ссылка.Договор				КАК Договор,
	|	Ссылка.Организация			КАК Организация,
	|	ОсновноеСредство			КАК ОсновноеСредство,
	|	Ссылка.ВидОперации			КАК ВидОперации,
	|	СпособПризнанияРасходов		КАК СпособПризнанияРасходов,
	|	ДатаНачалаАмортизации		КАК ДатаНачалаАмортизации,
	|	ДатаОкончанияАмортизации	КАК ДатаОкончанияАмортизации,
	|	СчетРасходов				КАК СчетРасходов,
	|	КПСРасходов					КАК КПСРасходов,
	|	КЭКРасходов					КАК КЭКРасходов,
	|	ПодразделениеРасходов		КАК ПодразделениеРасходов,
