#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтоАгрегаторДвижений Тогда
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
	//---
	// Механизм отбора строк табличной части (v2)
	//---
	ИменаТЧ = Документы.ВводНачальныхОстатков.ОтборСтрок_ИменаИспользуемыхТабличныхЧастей(ЭтотОбъект);
	ИспользуетсяМеханизмОтбораСтрок = (ИменаТЧ.Количество() > 0);
	Если ИспользуетсяМеханизмОтбораСтрок Тогда
		Документы.ВводНачальныхОстатков.ОтборСтрок_ОбработатьРеквизитыПередЗаписью(ЭтотОбъект);
	КонецЕсли;
	
	ПроверяемыеРеквизиты.Очистить();
	
	РазделУчета = ЭтотОбъект.РазделУчета;
	
	Если ВводНачальныхОстатковКлиентСервер.РазделУчетаДляВводаОстатковУстарел(РазделУчета)
		И (ОтражатьВБухгалтерскомУчете Или Не ОтражатьВНалоговомУчете) Тогда
		ЗапретитьПроведение = ВводНачальныхОстатковКлиентСервер.ЗапретитьПроведениеДокументовСУстаревшимРазделомУчета();
	Иначе
		ЗапретитьПроведение = Ложь;
	КонецЕсли;
	
	Если ЗапретитьПроведение Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка количества прослеживаемых товаров
	Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Материалы Тогда
		ПроверитьЗаполнениеПрослеживаемыхТоваров(Отказ);
	КонецЕсли;
	
	//---
	// Эти операции проверяются новым механизмом
	// (с ограничением количества выводимых сообщений):
	//---
	Если	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства
		ИЛИ	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете
		ИЛИ	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе
		ИЛИ	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НПА
		ИЛИ	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Материалы
		ИЛИ	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НДС
		ИЛИ	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны
		Тогда
		
		// Проверка данных документа:
		Если НЕ Документы.ВводНачальныхОстатков.ДанныеДокументаКорректны(ЭтотОбъект) Тогда
			Отказ = Истина;
		КонецЕсли;
		
	//---
	// Эти операции проверяются стандартным механизмом
	// (без ограничения количества выводимых сообщений):
	//---
	
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазныМЗ Тогда
		
		СвойстваСчета	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Счет, "Валютный, УчетПоКПС, УчетПоКЭК, УчетПоПодразделениям");
		
		// Реквизиты шапки
		ПроверяемыеРеквизиты.Добавить("Организация");
		ПроверяемыеРеквизиты.Добавить("Дата");
		ПроверяемыеРеквизиты.Добавить("Счет");
		ПроверяемыеРеквизиты.Добавить("КФО");
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			ПроверяемыеРеквизиты.Добавить("ИФО");
		КонецЕсли;
		Если СвойстваСчета["УчетПоКПС"] = Истина Тогда
			ПроверяемыеРеквизиты.Добавить("КПС");
		КонецЕсли;
		Если СвойстваСчета["УчетПоКЭК"] = Истина Тогда
			ПроверяемыеРеквизиты.Добавить("КЭК");
		КонецЕсли;
		
		// Реквизиты табличной части Материалы
		ПроверяемыеРеквизиты.Добавить("Материалы.Номенклатура");
		ПроверяемыеРеквизиты.Добавить("Материалы.Сумма");
		Если Документы.ВводНачальныхОстатков.ПодразделениеОбязательноКЗаполнению(ЭтотОбъект) Тогда
			ПроверяемыеРеквизиты.Добавить("Материалы.Подразделение");
		КонецЕсли;

	ИначеЕсли	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПоСчету106хП Тогда
		// Реквизиты шапки:
		ПроверяемыеРеквизиты.Добавить("Организация");
		ПроверяемыеРеквизиты.Добавить("Дата");
		Если Документы.ВводНачальныхОстатков.ПодразделениеОбязательноКЗаполнению(ЭтотОбъект) Тогда
			ПроверяемыеРеквизиты.Добавить("ПодразделениеОрганизации");
		КонецЕсли;
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			ПроверяемыеРеквизиты.Добавить("ИФО");
		КонецЕсли;
		ПроверяемыеРеквизиты.Добавить("КФО");
		
		// Реквизиты табличных частей:
		ПроверяемыеРеквизиты.Добавить("Материалы106хП.Счет");
		ПроверяемыеРеквизиты.Добавить("Материалы106хП.СчетНУ");
		ПроверяемыеРеквизиты.Добавить("Материалы106хП.КПС");
		ПроверяемыеРеквизиты.Добавить("Материалы106хП.КЭК");
		ПроверяемыеРеквизиты.Добавить("Материалы106хП.Номенклатура");
		ПроверяемыеРеквизиты.Добавить("Материалы106хП.Количество");
		
		// Исключаем из проверки поля, неиспользуемые в текущем режиме ввода остатков:
		ТЗНеиспользуемыеПоля = Документы.ВводНачальныхОстатков.РежимВводаОстатков_ИменаПолейВсехРежимов(ЭтотОбъект,
			Истина); // ТолькоНеиспользуемые
		Для Каждого СтрокаПоля Из ТЗНеиспользуемыеПоля Цикл
			инд = ПроверяемыеРеквизиты.Найти(СтрокаПоля["ПолноеИмя"]);
			Если НЕ инд = Неопределено Тогда
				ПроверяемыеРеквизиты.Удалить(инд);
			КонецЕсли;
		КонецЦикла;
		
		Счета106хП = Документы.ВводНачальныхОстатков.ПолучитьСписокСчетов106хП(ЭтотОбъект.Дата);
		НаличиеСубконто = БухгалтерскийУчет.ЕстьСубконтоСписокСчетов(Счета106хП, "ЦМО");
		СвойстваСубконтоЦМО = НаличиеСубконто["ЦМО"];
		ЦМООбязательное = СвойстваСубконтоЦМО.ЕстьСубконто И СвойстваСубконтоЦМО.ПризнакиУчетаСубконто.Обязательный;
		Если ЦМООбязательное Тогда
			ПроверяемыеРеквизиты.Добавить("Затраты106хП.ЦМО");
		КонецЕсли;
	
		// Проверки режима ввода остатков и обеих табл.частей:
		Если Документы.ВводНачальныхОстатков.ЕстьОшибкиЗаполнения_Счет106хП(ЭтотОбъект) Тогда
			Отказ = Истина;
		КонецЕсли;
		
		
	ИначеЕсли	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеСредства Тогда
		ИспользоватьВалютныйУчет	= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
		ВалютаРУ					= Константы.ВалютаРегламентированногоУчета.Получить();
		
		СвойстваСчета	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Счет, "Валютный, УчетПоКПС, УчетПоКЭК, УчетПоПодразделениям");
		
		СчетВалютный	= СвойстваСчета["Валютный"];
		УчетПоКПС		= СвойстваСчета["УчетПоКПС"];
		УчетПоКЭК		= СвойстваСчета["УчетПоКЭК"];
		
		ПолеСуммаВидимое = Документы.ВводНачальныхОстатков.ПолеСуммаВидимое_ДенежныеСредства(ВалютаДокумента, ИспользоватьВалютныйУчет, ВалютаРУ);
		
		// Реквизиты шапки
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			ПроверяемыеРеквизиты.Добавить("ИФО");
		КонецЕсли;
		ПроверяемыеРеквизиты.Добавить("Дата");
		ПроверяемыеРеквизиты.Добавить("Организация");
		ПроверяемыеРеквизиты.Добавить("КФО");
		ПроверяемыеРеквизиты.Добавить("Счет");
		Если УчетПоКПС = Истина Тогда
			ПроверяемыеРеквизиты.Добавить("КПС");
		КонецЕсли;
		Если УчетПоКЭК = Истина Тогда
			ПроверяемыеРеквизиты.Добавить("КЭК");
		КонецЕсли;
		ПроверяемыеРеквизиты.Добавить("ВалютнаяСуммаДокумента");
		Если ИспользоватьВалютныйУчет Тогда
			ПроверяемыеРеквизиты.Добавить("ВалютаДокумента");
		КонецЕсли;
		Если ПолеСуммаВидимое Тогда
			ПроверяемыеРеквизиты.Добавить("СуммаДокумента");
		КонецЕсли;
		Если Документы.ВводНачальныхОстатков.ПодразделениеОбязательноКЗаполнению(ЭтотОбъект, СвойстваСчета) Тогда
			ПроверяемыеРеквизиты.Добавить("ПодразделениеОрганизации");
		КонецЕсли;
		
		// Реквизиты табличных частей
		Если УчетПоКПС = Истина Тогда
			ПроверяемыеРеквизиты.Добавить("ДенежныеСредства.КПС");
		КонецЕсли;
		Если УчетПоКЭК = Истина Тогда
			ПроверяемыеРеквизиты.Добавить("ДенежныеСредства.КЭК");
		КонецЕсли;
		ПроверяемыеРеквизиты.Добавить("ДенежныеСредства.ВалютнаяСумма");
		Если ПолеСуммаВидимое Тогда
			ПроверяемыеРеквизиты.Добавить("ДенежныеСредства.Сумма");
		КонецЕсли;
		
		Если Документы.ВводНачальныхОстатков.ЕстьОшибкиЗаполнения_ДенежныеСредства(ЭтотОбъект) Тогда
			Отказ = Истина;
		КонецЕсли;
		
		
	ИначеЕсли	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеДокументы Тогда
		// Подготовка:
		СвойстваСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект["Счет"],
			"УчетПоПодразделениям, УчетПоКПС, УчетПоКЭК");
		УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
			И ?(ЗначениеЗаполнено(ЭтотОбъект["Счет"]),
				СвойстваСчета["УчетПоПодразделениям"],
				Ложь);
		УчетПоКПС = СвойстваСчета["УчетПоКПС"];
		УчетПоКЭК = СвойстваСчета["УчетПоКЭК"];
		
		// Реквизиты шапки:
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			ПроверяемыеРеквизиты.Добавить("ИФО");
		КонецЕсли;
		ПроверяемыеРеквизиты.Добавить("Дата");
		ПроверяемыеРеквизиты.Добавить("Организация");
		ПроверяемыеРеквизиты.Добавить("КФО");
		ПроверяемыеРеквизиты.Добавить("Счет");
		Если УчетПоКПС = Истина Тогда
			ПроверяемыеРеквизиты.Добавить("КПС");
		КонецЕсли;
		Если УчетПоКЭК = Истина Тогда
			ПроверяемыеРеквизиты.Добавить("КЭК");
		КонецЕсли;
		Если Документы.ВводНачальныхОстатков.ПодразделениеОбязательноКЗаполнению(ЭтотОбъект, СвойстваСчета) Тогда
			ПроверяемыеРеквизиты.Добавить("ПодразделениеОрганизации");
		КонецЕсли;
		
		// Реквизиты табличной части:
		ПроверяемыеРеквизиты.Добавить("ДенежныеДокументы.ВидДенежногоДокумента");
		ПроверяемыеРеквизиты.Добавить("ДенежныеДокументы.ДенежныйДокумент");
		ПроверяемыеРеквизиты.Добавить("ДенежныеДокументы.Сумма");
		Если ПолучитьФункциональнуюОпцию("ВестиКоличественныйУчетДенежныхДокументов") Тогда
			ПроверяемыеРеквизиты.Добавить("ДенежныеДокументы.Количество");
		КонецЕсли;
		
		
	ИначеЕсли	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Студенты Тогда
		
		// Проверим функциональную опцию.
		Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтудентов") Тогда
			ТекстСообщения = НСтр("ru='В программе не ведется учет расчетов по образовательным услугам. Документ не предназначен для работы в таком режиме.
				|Включить учет расчетов по образовательным услугам можно в разделе «Учет расчетов по образовательные услуги» в настройках параметров учета (по гиперссылке «Специализированные подсистемы» в разделе «Администрирование - Настройка параметров учета»).'");
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ЭтотОбъект.Ссылка);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		// Реквизиты шапки:
		ПроверяемыеРеквизиты.Добавить("Организация");
		ПроверяемыеРеквизиты.Добавить("Дата");
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
			И ?(ЗначениеЗаполнено(ЭтотОбъект.Счет),
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Счет, "УчетПоПодразделениям"),
				Ложь) Тогда
			ПроверяемыеРеквизиты.Добавить("Факультет");
		КонецЕсли;
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			ПроверяемыеРеквизиты.Добавить("ИФО");
		КонецЕсли;
		Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
			ПроверяемыеРеквизиты.Добавить("ВалютаДокумента");
		КонецЕсли;
		ПроверяемыеРеквизиты.Добавить("КФО");
		Если ЭтотОбъект["ПринятьДетейВГруппу"] Тогда
			ПроверяемыеРеквизиты.Добавить("ГруппаСтудентов");
			ПроверяемыеРеквизиты.Добавить("КурсОбучения");
			ПроверяемыеРеквизиты.Добавить("Студенты.СостояниеСтудента");
		КонецЕсли;
		
		// Реквизиты табличной части - проверяем вручную далее.
		
		// Проверки табл.части:
		Если Документы.ВводНачальныхОстатков.ЕстьОшибкиЗаполнения_Студенты(ЭтотОбъект) Тогда
			Отказ = Истина;
		КонецЕсли;
		
		
	ИначеЕсли	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.БСО Тогда
		// Реквизиты шапки:
		ПроверяемыеРеквизиты.Добавить("Организация");
		ПроверяемыеРеквизиты.Добавить("Дата");
		Если Документы.ВводНачальныхОстатков.ПодразделениеОбязательноКЗаполнению(ЭтотОбъект, СвойстваСчета) Тогда
			ПроверяемыеРеквизиты.Добавить("ПодразделениеОрганизации");
		КонецЕсли;
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			ПроверяемыеРеквизиты.Добавить("ИФО");
		КонецЕсли;
		ПроверяемыеРеквизиты.Добавить("Счет");
		ПроверяемыеРеквизиты.Добавить("КФО");
		ПроверяемыеРеквизиты.Добавить("ЦМО");
		
		// Реквизиты табличной части - проверяем вручную далее.
		
		// Проверки табл.части:
		Если Документы.ВводНачальныхОстатков.ЕстьОшибкиЗаполнения_БСО(ЭтотОбъект) Тогда
			Отказ = Истина;
		КонецЕсли;
		
		
	ИначеЕсли	РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.РодительскаяПлата Тогда
		
		// Сначала проверим, следует ли вообще проводить этот документ.
		Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетРодительскойПлаты") Тогда
			ТекстСообщения = НСтр("ru='В программе не ведется учет расчетов за содержание детей в ДДУ (родительская плата). Документ не предназначен для работы в таком режиме.
				|Включить учет расчетов за содержание детей в ДДУ можно в разделе «Учет расчетов за содержание детей в ДДУ» в настройках параметров учета (по гиперссылке «Специализированные подсистемы» в разделе «Администрирование - Настройка параметров учета»).'");
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ЭтотОбъект.Ссылка);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		СвойстваСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект["Счет"],
			"УчетПоПодразделениям, УчетПоКПС");
		
		// Реквизиты шапки:
		ПроверяемыеРеквизиты.Добавить("Организация");
		ПроверяемыеРеквизиты.Добавить("Дата");
		Если Документы.ВводНачальныхОстатков.ПодразделениеОбязательноКЗаполнению(ЭтотОбъект, СвойстваСчета) Тогда
			ПроверяемыеРеквизиты.Добавить("ПодразделениеОрганизации");
		КонецЕсли;
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			ПроверяемыеРеквизиты.Добавить("ИФО");
		КонецЕсли;
		Если ЭтотОбъект["ПринятьДетейВГруппу"] Тогда
			ПроверяемыеРеквизиты.Добавить("ГруппаДетскогоУчреждения");
		КонецЕсли;
		ПроверяемыеРеквизиты.Добавить("КФО");
		ПроверяемыеРеквизиты.Добавить("Счет");
		Если СвойстваСчета["УчетПоКПС"] = Истина Тогда
			ПроверяемыеРеквизиты.Добавить("КПС");
		КонецЕсли;
		
		// Реквизиты табл.части "Родительская плата":
		ПроверяемыеРеквизиты.Добавить("РодительскаяПлата.Ребенок");
		ПроверяемыеРеквизиты.Добавить("РодительскаяПлата.Договор");
		Если ЭтотОбъект["ПринятьДетейВГруппу"] Тогда
			ПроверяемыеРеквизиты.Добавить("РодительскаяПлата.ДатаВключения");
		КонецЕсли;
		
		// Проверки всей табл.части "Родительская плата":
		Если Документы.ВводНачальныхОстатков.ЕстьОшибкиЗаполнения_РодительскаяПлата(ЭтотОбъект) Тогда
			Отказ = Истина;
		КонецЕсли;
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПраваПользованияАктивами Тогда
		
		ПроверяемыеРеквизиты.Очистить(); // проверка выполняется далее самостоятельно
		
		Если Документы.ВводНачальныхОстатков.ЕстьОшибкиЗаполнения_ПраваПользованияАктивами(ЭтотОбъект) Тогда
			Отказ = Истина;
		КонецЕсли;
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДоходыБудущихПериодов Тогда
		
		Если Документы.ВводНачальныхОстатков.ЕстьОшибкиЗаполнения_ДоходыБудущихПериодов(ЭтотОбъект) Тогда
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если ЭтоАгрегаторДвижений Тогда
		ИзменитьАктивностьДвиженийДокумента(Ссылка, Истина);
		Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Материалы Тогда
			// Инициализация дополнительных свойств для проведения документа
			ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
			// Инициализация данных документа	
			Документы.ВводНачальныхОстатков.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
			ПрослеживаемостьБГУ.СформироватьДвижения(ЭтотОбъект);
		КонецЕсли;
		Возврат;
	КонецЕсли;	
	
	Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПрочиеСчетаБухгалтерскогоУчета Тогда
		// Для этой операции используется особый режим проведения.
		
		НоваяАктивностьЗаписей = Истина;
		
		ЗаписатьДвиженияПоПрочимСчетамБухгалтерскогоУчета(НоваяАктивностьЗаписей);
		
		// Выходим:
		Возврат;
	КонецЕсли;
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	ДатаСрезаУчетнойПолитики = ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(Дата);
	ДополнительныеСвойства.Вставить("ПлательщикНалогаНаПрибыль",
		НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Организация, ДатаСрезаУчетнойПолитики));
	ДополнительныеСвойства.Вставить("ПрименяетсяУСНДоходыМинусРасходы",
		УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Организация, ДатаСрезаУчетнойПолитики));
	ДополнительныеСвойства.Вставить("РазделУчета", РазделУчета);
	
	// Инициализация данных документа	
	Документы.ВводНачальныхОстатков.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

	// Движения по регистрам сведений
	Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства Тогда
		
		Если ОтражатьВБухгалтерскомУчете Тогда
			
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СобытияОС");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "АмортизацияОС");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "НачислениеАмортизацииОСБухгалтерскийУчет");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПараметрыАмортизацииОСБухгалтерскийУчет");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "РасчетАмортизацииОС");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СтоимостьОбъектовОС");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "АмортизацияОбъектовОС");
			
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "КапРемонтОС");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПереоценкаНФА");
			
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "НомераИнвентарныхКарточек");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПервоначальныеСведенияОСБухгалтерскийУчет");
			
		КонецЕсли;
		
		Если ОтражатьВНалоговомУчете Тогда
			
			Если ДополнительныеСвойства.ПлательщикНалогаНаПрибыль Тогда
				ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "НачислениеАмортизацииОСНалоговыйУчет");
				ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПараметрыАмортизацииОСНалоговыйУчет");
				ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПервоначальныеСведенияОСНалоговыйУчет");
				ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "НачислениеАмортизацииОССпециальныйКоэффициентНалоговыйУчет");
			КонецЕсли;
			
			Если ДополнительныеСвойства.ПрименяетсяУСНДоходыМинусРасходы Тогда
				ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПервоначальныеСведенияОСНалоговыйУчетУСН");
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете Тогда
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СобытияОС");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "КапРемонтОС");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "НомераИнвентарныхКарточек");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПервоначальныеСведенияОСБухгалтерскийУчет");
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе Тогда
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СтоимостьОбъектовОСПоКонтрагентам");
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НПА Тогда
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СобытияОС");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПараметрыАмортизацииОСБухгалтерскийУчет");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "НомераИнвентарныхКарточек");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПервоначальныеСведенияОСБухгалтерскийУчет");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СтоимостьОбъектовОС");
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеСредства Тогда
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "НаличныеДенежныеСредства");
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеДокументы Тогда
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ДенежныеДокументы");
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НДС Тогда
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, ДополнительныеСвойства.ИмяРегистраНДС);

	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Материалы Тогда
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПрослеживаемыеТовары");
		ПрослеживаемостьБГУ.СформироватьДвижения(ЭтотОбъект);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Студенты Тогда
		
		Если НачислениеУчащимсяЗаПрочиеУслуги Тогда
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "РасчетыСоСтудентамиДопУслуги");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СведенияОПрочихУслугахСтудентам");
		Иначе
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "РасчетыСоСтудентами");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПлательщикиПоДоговоруОбразование");
		КонецЕсли;
		
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СведенияОСтудентах");
		РаботаСоСтудентами.ОтразитьНачисленияОбразованиеПоследовательность(ДополнительныеСвойства, ПринадлежностьПоследовательностям, Отказ);
		
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПорядокОплатыОбразование");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПлановыеДатыОплатыОбразование");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПараметрыСписанияДоходовБудущихПериодов");
		Если ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров") Тогда
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ИсполнениеДоговоровСПокупателями");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ОплатаОтПокупателейДебиторов");
		КонецЕсли;
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны Тогда
		
		// Учтем особенности операции "Имущество казны" в отличие от операции "ОС":
		ЭтоСчетМЗ				= ДополнительныеСвойства.УчетИмуществаКазны.ЭтоСчетМЗ;
		//ВестиПоАналитике		= ДополнительныеСвойства.УчетИмуществаКазны.ВестиПоАналитике;
		//НачислятьАмортизацию	= ДополнительныеСвойства.УчетИмуществаКазны.НачислятьАмортизацию;
		
		Если ЭтоСчетМЗ Тогда
			// Материальные запасы имущества казны.
			
			// Никакие движения не делаем.
			
		Иначе
			// Основные средства имущества казны.
			
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СобытияОС");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СтоимостьОбъектовОС");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "АмортизацияОбъектовОС");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "НомераИнвентарныхКарточек");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПервоначальныеСведенияОСБухгалтерскийУчет");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "АмортизацияОС");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "НачислениеАмортизацииОСБухгалтерскийУчет");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПараметрыАмортизацииОСБухгалтерскийУчет");
			ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "РасчетАмортизацииОС");
			
		КонецЕсли; // Если УчетМЗ
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.БСО Тогда
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ДвиженияБСО");
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.РодительскаяПлата Тогда
		// Движения по регистрам сведений:
		ЗаписатьВРегистрСведений(ДополнительныеСвойства, "СоставГруппДДУ",						"СоставГруппДДУ");
		ЗаписатьВРегистрСведений(ДополнительныеСвойства, "СоставГруппДДУДополнительныеУслуги",	"СоставГруппДДУДополнительныеУслуги");
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПраваПользованияАктивами Тогда
		
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПараметрыАмортизацииПравПользованияОС");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПараметрыСписанияДоходовБудущихПериодов");
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДоходыБудущихПериодов Тогда
		
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПараметрыСписанияДоходовБудущихПериодов");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Если ЭтоАгрегаторДвижений Тогда
		ИзменитьАктивностьДвиженийДокумента(Ссылка, Ложь);
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПрочиеСчетаБухгалтерскогоУчета Тогда
		// Для этой операции используется особый режим отмены проведения.
		
		НоваяАктивностьЗаписей = Ложь;
		
		ЗаписатьДвиженияПоПрочимСчетамБухгалтерскогоУчета(НоваяАктивностьЗаписей);
		
		// Выходим:
		Возврат;
	КонецЕсли;
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
		
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения = "ИзДвиженийДокумента" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ОчиститьДокумент();
		ЗаполнитьИзДвижений();
		
		ДанныеЗаполнения = Новый Структура("ВводНаОсновании");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если (РежимЗаписи = РежимЗаписиДокумента.Проведение Или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения)
		И ВводНачальныхОстатковКлиентСервер.РазделУчетаДляВводаОстатковУстарел(РазделУчета)
		И (ОтражатьВБухгалтерскомУчете Или Не ОтражатьВНалоговомУчете) Тогда
		ЗапретитьЗапись = ВводНачальныхОстатковКлиентСервер.ЗапретитьПроведениеДокументовСУстаревшимРазделомУчета();
	Иначе
		ЗапретитьЗапись = Ложь;
	КонецЕсли;
	
	Если ЗапретитьЗапись Тогда	
		
		Отказ = Истина;
		
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			Шаблон = НСтр("ru = 'Раздел учета ""%1"" устарел, проведение запрещено. Для ввода остатков используйте документ ""Ввод начальных остатков ОС, НМА, НПА""'");
		Иначе
			Шаблон = НСтр("ru = 'Раздел учета ""%1"" устарел, отмена проведения запрещена. Для редактирования данные необходимо перенести в документ ""Ввод начальных остатков ОС, НМА, НПА""'");
		КонецЕсли;
		
		НаименованиеРаздела = Сред(Строка(РазделУчета), 11); // убираем текст "(устарел)" в начале	
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, НаименованиеРаздела);		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект["Ссылка"]);
			
		Возврат;
		
	КонецЕсли;
	
	Если ЭтоАгрегаторДвижений Тогда
		// Проводки не будут переформировываться
		ДополнительныеСвойства.Вставить("РучнаяКорректировка", Истина);
	КонецЕсли;
	
	Если Не ЭтоАгрегаторДвижений И Не Проведен
		И РазделУчета <> Перечисления.РазделыУчетаДляВводаОстатков.ПрочиеСчетаБухгалтерскогоУчета
		И РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		
		Для Каждого НаборЗаписей Из Движения Цикл
			НаборЗаписей.Очистить();
			НаборЗаписей.Записывать = Истина;
		КонецЦикла;
		
	КонецЕсли;
	
	Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПрочиеСчетаБухгалтерскогоУчета Тогда
		
		ПроводкиДокумента = Движения.ЖурналПроводокЕПСБУ;
		
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ЭтоЗаписьИзФормыДокумента") Тогда
			// Это запись из формы документа
			НеобходимоПрочитатьПроводки = Ложь;
		Иначе
			// Это запись из формы списка
			НеобходимоПрочитатьПроводки = Истина;
		КонецЕсли;
		
		Если НеобходимоПрочитатьПроводки Тогда
			ПроводкиДокумента.Прочитать();
		КонецЕсли;
		
		// Устанавливаем во всех проводках одинаковые значения (берем из шапки):
		//	Период
		//	Организация
		//	ИФО
		ТаблицаДвижений = ПроводкиДокумента.Выгрузить();
		
		ТаблицаДвижений.ЗаполнитьЗначения(Дата,			"Период");
		ТаблицаДвижений.ЗаполнитьЗначения(Организация,	"Организация");
		Если ТаблицаДвижений.Колонки.Найти("ИФО") <> Неопределено Тогда
			ТаблицаДвижений.ЗаполнитьЗначения(ИФО,		"ИФО");
		КонецЕсли;
		
		ПроводкиДокумента.Загрузить(ТаблицаДвижений);
		
		СуммаДокумента = ТаблицаДвижений.Итог("Сумма");
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства
		ИЛИ РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НПА
		ИЛИ РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете
		ИЛИ РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе
		Тогда
		
		УдалитьНеиспользуемыеСтрокиОС_Амортизация();
		УдалитьНеиспользуемыеСтрокиОС_РасходыУСН();
		
		СуммаДокумента = ОС_Основная.Итог("Сумма");
		
		Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства Тогда
			ТолькоНалУчетОСН = НЕ ЭтотОбъект["ОтражатьВБухгалтерскомУчете"] И ЭтотОбъект["ОтражатьВНалоговомУчете"];
			Если ТолькоНалУчетОСН Тогда
				СуммаДокумента = ОС_Амортизация.Итог("СуммаНУ");
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Материалы Тогда
		
		ТолькоНалУчетОСН = НЕ ЭтотОбъект["ОтражатьВБухгалтерскомУчете"] И ЭтотОбъект["ОтражатьВНалоговомУчете"];
		Если ТолькоНалУчетОСН Тогда
			СуммаДокумента = Материалы.Итог("СуммаНУ");
		Иначе
			СуммаДокумента = Материалы.Итог("Сумма");
		КонецЕсли;
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПоСчету106хП Тогда
		
		ТолькоНалУчетОСН = НЕ ЭтотОбъект["ОтражатьВБухгалтерскомУчете"] И ЭтотОбъект["ОтражатьВНалоговомУчете"];
		Если ТолькоНалУчетОСН Тогда
			СуммаДокумента = Затраты106хП.Итог("СуммаНУ");
		Иначе
			СуммаДокумента = Затраты106хП.Итог("Сумма");
		КонецЕсли;
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеСредства Тогда
		
		Документы.ВводНачальныхОстатков.ОбновитьРублевыеСуммы_ДенежныеСредства(ЭтотОбъект);
		
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеДокументы Тогда
		
		СуммаДокумента = ДенежныеДокументы.Итог("Сумма");
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НДС Тогда
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
			СуммаДокумента = НДС.Итог("СуммаНДС");
		Иначе
			СуммаДокумента = НДС.Итог("СуммаНДСРублевая");
		КонецЕсли;
		
		//---
		// Документы остатков НДС
		//---
		ВыполняетсяПроведение = (РежимЗаписи = РежимЗаписиДокумента.Проведение);
		Документы.ВводНачальныхОстатков.ДокументыОстатковНДС_НастроитьПризнак(ЭтотОбъект.Ссылка, ВыполняетсяПроведение);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Студенты Тогда
		
		Если НачислениеУчащимсяЗаПрочиеУслуги Тогда
			ПринятьДетейВГруппу = Ложь; // Флаг недоступен при вводе остатков по прочим услугам.
			ГруппаСтудентов = Неопределено;
			КурсОбучения = Неопределено;
		КонецЕсли;
		
		ОчищающаяСтруктура = Новый Структура("ДатаНачалаСписания,ДатаОкончанияСписания");
		Для Каждого СтрокаТаблицы Из Студенты Цикл
			Если СтрокаТаблицы.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоГрафику Тогда
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны Тогда
		// Учитываем ОС
		
		СуммаДокумента = ОС_Основная.Итог("Сумма");
		
		УдалитьНеиспользуемыеСтрокиОС_Амортизация();
		
		// Очищаем неиспользуемые табличные части
		Материалы.Очистить();
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазныМЗ Тогда
		// Учитываем МЗ
		
		СуммаДокумента = Материалы.Итог("Сумма");
		
		// Очищаем неиспользуемые табличные части
		ОС_Основная.Очистить();
		ОС_Амортизация.Очистить();
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.БСО Тогда
		
		СуммаДокумента = СоставБСО.Итог("Количество");
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПраваПользованияАктивами Тогда
		
		СуммаДокумента = ПраваПользования.Итог("БалансоваяСтоимость");
		
		СчетДляШапкиДокумента = Документы.ВводНачальныхОстатков.ОпределитьСчетДляШапкиДокумента_ПраваПользования(ЭтотОбъект);
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, СчетДляШапкиДокумента, "Счет,КФО,КПС");
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДоходыБудущихПериодов Тогда
		
		СуммаДокумента = ДоходыБудущихПериодов.Итог("ОтложенныйДоход");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ЭтоАгрегаторДвижений = Ложь;
	
	Если ОбъектКопирования["РазделУчета"] = Перечисления.РазделыУчетаДляВводаОстатков.ПрочиеСчетаБухгалтерскогоУчета Тогда
		// Для этой операции копируем сами движения.
		
		НоваяСсылка = Документы.ВводНачальныхОстатков.ПолучитьСсылку();
		ЭтотОбъект.УстановитьСсылкуНового(НоваяСсылка);
		
		ПроводкиДокумента = Движения.ЖурналПроводокЕПСБУ;
		
		ПроводкиОбъектаКопирования = ОбъектКопирования.Движения.ЖурналПроводокЕПСБУ;
		ПроводкиОбъектаКопирования.Прочитать();
		
		ПроводкиКопирования = ПроводкиОбъектаКопирования.Выгрузить();
		ПроводкиКопирования.ЗаполнитьЗначения(НоваяСсылка, "Регистратор");
		
		ПроводкиДокумента.Загрузить(ПроводкиКопирования);
		ПроводкиДокумента.УстановитьАктивность(Ложь);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗаполнениеПрослеживаемыхТоваров(Отказ)
	Если СведенияПрослеживаемости.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ОтражатьВБухгалтерскомУчете Тогда
		ТекстОшибки = НСтр("ru = 'Введены сведения прослеживаемости в документе, который не отражается в бухгалтерском учете'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Ссылка, , , Отказ);
		Возврат;
	КонецЕсли;
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	НоменклатураДокумента = Новый Соответствие;
	Для Каждого Строка Из Материалы Цикл
		Если ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			НоменклатураДокумента.Вставить(Строка.Номенклатура, 
				ТипЧисло.ПривестиЗначение(НоменклатураДокумента.Получить(Строка.Номенклатура)) + Строка.Количество);
		КонецЕсли;	
	КонецЦикла;
	ПроверяемыеЭлементы = СведенияПрослеживаемости.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура"); // Массив из СправочникСсылка.Номенклатура
	Для Каждого СтрокаНоменклатуры Из НоменклатураДокумента Цикл
		ПроверяемыеЭлементы.Добавить(СтрокаНоменклатуры.Ключ);
	КонецЦикла;
	ДанныеНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ПроверяемыеЭлементы, "ПрослеживаемыйТовар");
	
	КоличествоОшибок = 0;
	Для Каждого СтрокаПрослеживаемости Из СведенияПрослеживаемости Цикл
		Если КоличествоОшибок = 50 Тогда
			Возврат;
		КонецЕсли;
		
		КоличествоНоменклатуры = НоменклатураДокумента.Получить(СтрокаПрослеживаемости.Номенклатура);
		Если КоличествоНоменклатуры = Неопределено Тогда
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Колонка",
				"Корректность",
				НСтр("ru = 'Номенклатура'"),
				СтрокаПрослеживаемости.НомерСтроки,
				НСтр("ru = 'Сведения прослеживаемости'"),
				НСтр("ru = 'В этом документе нет остатков по выбранной номенклатуре.'"));
			ПутьКЭлементу = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СведенияПрослеживаемости", СтрокаПрослеживаемости.НомерСтроки, "Номенклатура");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Ссылка, ПутьКЭлементу, "Объект", Отказ);
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
			
		ПрослеживаемыйТовар = ДанныеНоменклатуры.Получить(СтрокаПрослеживаемости.Номенклатура);
		Если ПрослеживаемыйТовар <> Истина Тогда
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Колонка",
				"Корректность",
				НСтр("ru = 'Номенклатура'"),
				СтрокаПрослеживаемости.НомерСтроки,
				НСтр("ru = 'Сведения прослеживаемости'"),
				НСтр("ru = 'Материал не подлежит прослеживаемости.'"));
			ПутьКЭлементу = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СведенияПрослеживаемости", СтрокаПрослеживаемости.НомерСтроки, "Номенклатура");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Ссылка, ПутьКЭлементу, "Объект", Отказ);
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
		
		Если КоличествоНоменклатуры < СтрокаПрослеживаемости.Количество Тогда
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Колонка",
				"Корректность",
				НСтр("ru = 'Количество'"),
				СтрокаПрослеживаемости.НомерСтроки,
				НСтр("ru = 'Сведения прослеживаемости'"),
				НСтр("ru = 'Остатки в прослеживаемости больше, чем остатки в бухгалтерском учете.'"));
			ПутьКЭлементу = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СведенияПрослеживаемости", СтрокаПрослеживаемости.НомерСтроки, "Количество");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Ссылка, ПутьКЭлементу, "Объект", Отказ);
			КоличествоОшибок = КоличествоОшибок + 1;
			Продолжить;
		КонецЕсли;
		НоменклатураДокумента.Вставить(СтрокаПрослеживаемости.Номенклатура, КоличествоНоменклатуры - СтрокаПрослеживаемости.Количество);
		
	КонецЦикла;
	
КонецПроцедуры

// Используется только для операции "Прочие счета бух.учета". Записывает движения и настраивает активность записей.
Процедура ЗаписатьДвиженияПоПрочимСчетамБухгалтерскогоУчета(НоваяАктивностьЗаписей)
	
	Перем ДанныеАвтоПроведения;
	
	ПроводкиДокумента = Движения.ЖурналПроводокЕПСБУ;
	ПроводкиДокумента.Записывать = Истина;
	ПроводкиДокумента.УстановитьАктивность(НоваяАктивностьЗаписей);
	
	Если НоваяАктивностьЗаписей Тогда
		// Проводим документ
		// Сейчас проводки не записываем, а передаем таблицу проводок далее
		
		ТаблицаПроводок = ПроводкиДокумента.Выгрузить();
		
		БухгалтерскиеОперацииСервер.ИнициализироватьБухгалтерскиеОперации(ЭтотОбъект);
		
		ЭтотОбъект.ДополнительныеСвойства.ДанныеАвтоПроведения.Вставить("ТаблицаПроводок", ТаблицаПроводок);
	Иначе
		// Отменяем проведение документа
		// Записываем проводки сейчас
		
		ПроводкиДокумента.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьВРегистрСведений(ДополнительныеСвойства, ИмяТаблицы, ИмяРегистра)
	
	ТаблицаЗаписей = ДополнительныеСвойства.ТаблицыДляДвижений[ИмяТаблицы];
	
	Для Каждого СтрокаТЗ Из ТаблицаЗаписей Цикл
		
		МенЗаписи = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		
		ЗаполнитьЗначенияСвойств(МенЗаписи, СтрокаТЗ);
		
		МенЗаписи.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьНеиспользуемыеСтрокиОС_Амортизация()
	
	ЗапросВыборка = Новый Запрос();
	ЗапросВыборка.УстановитьПараметр("ТЗОсновная",		ЭтотОбъект["ОС_Основная"].Выгрузить(, "ОС"));
	ЗапросВыборка.УстановитьПараметр("ТЗАмортизация",	ЭтотОбъект["ОС_Амортизация"].Выгрузить(, "НомерСтроки,ОС"));
	ЗапросВыборка.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Исходная табл.часть ОС_Основная.
	|//		(Настройка табл.части ОС_Амортизация перед записью)
	|ВЫБРАТЬ
	|	ТЗ.ОС
	|ПОМЕСТИТЬ
	|	ОС_Основная
	|ИЗ
	|	&ТЗОсновная	КАК ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	ТЗ.ОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Исходная табл.часть ОС_Амортизация.
	|//		(Настройка табл.части ОС_Амортизация перед записью)
	|ВЫБРАТЬ
	|	ТЗ.НомерСтроки	КАК НомерСтроки,
	|	ТЗ.ОС			КАК ОС
	|ПОМЕСТИТЬ
	|	ОС_Амортизация
	|ИЗ
	|	&ТЗАмортизация	КАК ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	ТЗ.ОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Номера некорректных строк табл.части ОС_Амортизация.
	|//		(Финальная таблица для дальнейшей обработки)
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НомерСтроки	КАК НомерСтроки
	|ИЗ
	|	(ВЫБРАТЬ
	|		НомерСтроки	КАК НомерСтроки
	|	ИЗ
	|		ОС_Амортизация
	|	ГДЕ
	|		НЕ	ОС В (ВЫБРАТЬ ОС ИЗ ОС_Основная)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Т2.НомерСтроки	КАК НомерСтроки
	|	ИЗ
	|		ОС_Амортизация	КАК Т1
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ОС_Амортизация	КАК Т2
	|			ПО	Т1.ОС = Т2.ОС
	|			И	Т1.НомерСтроки < Т2.НомерСтроки
	|	)	КАК НомераНекорректныхСтрок
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки	УБЫВ
	|;";
	
	Выборка = ЗапросВыборка.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ИндексУдаляемойСтроки = Выборка["НомерСтроки"] - 1;
		ОС_Амортизация.Удалить(ИндексУдаляемойСтроки);
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьНеиспользуемыеСтрокиОС_РасходыУСН()
	
	ЗапросВыборка = Новый Запрос();
