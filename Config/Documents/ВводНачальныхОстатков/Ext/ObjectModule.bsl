Процедура ЗаполнитьИзДвиженийМатериалы()
	
	Если Движения.ЖурналПроводокЕПСБУ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПерваяПроводка = Движения.ЖурналПроводокЕПСБУ[0];
	
	Организация = ПерваяПроводка.Организация;
	ИФО			= ПерваяПроводка.ИФО;
	
	Счет000 = БухгалтерскийУчет.СчетПоКоду("000");
	Счет00 = БухгалтерскийУчет.СчетПоКоду("00");
	
	ВремСчет = ПерваяПроводка.СчетДт;
	
	Если ВремСчет = Счет000 ИЛИ ВремСчет = Счет00 Тогда
		СторонаПроводки = "Кт";
	Иначе
		СторонаПроводки = "Дт";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
		СчетПервойПроводки = ПерваяПроводка["Счет" + СторонаПроводки];
		
		ОсобыеСчета105 = Документы.ВводНачальныхОстатков.ПолучитьОсобыеСчета10500();
		
		ОтражатьВБухгалтерскомУчете = Истина;
		
		ТабСвойстваСчетов = ЭтотОбъект.ДополнительныеСвойства["ДополнительныеПараметры"]["ТаблицаСчетов"];
		
		Для Каждого СтрокаТаблицы Из ТабСвойстваСчетов Цикл
			Если СтрокаТаблицы["ДопустимыеСчета"].Найти(СчетПервойПроводки, "Счет") = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Счет = СтрокаТаблицы["СчетГруппа"];
			
			Если ОсобыеСчета105.Найти(СчетПервойПроводки) <> Неопределено Тогда
				ОсобыеСчета10500 = Истина;
			КонецЕсли;
			
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого Проводка Из Движения.ЖурналПроводокЕПСБУ Цикл
		
		Если Проводка["Счет" + СторонаПроводки].ТипСчета = Перечисления.ТипыСчетов.Налоговый Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Материалы.Добавить();
		НоваяСтрока.ВидДенежныхДокументов	= Проводка["Субконто" + СторонаПроводки].ВидыДенежныхДокументов;
		НоваяСтрока.ДенежныйДокумент		= Проводка["Субконто" + СторонаПроводки].ДенежныеДокументы;
		НоваяСтрока.КоличествоМест			= Проводка["Количество" + СторонаПроводки];
		НоваяСтрока.Количество				= Проводка["Количество" + СторонаПроводки];
		НоваяСтрока.Контрагент				= Проводка["Субконто" + СторонаПроводки].Контрагенты;
		НоваяСтрока.Договор					= Проводка["Субконто" + СторонаПроводки].Договоры;
		
		НоваяСтрока.Коэффициент				= ?(Проводка["Количество" + СторонаПроводки] = 0, 0, 1);
		НоваяСтрока.КПС						= Проводка["КПС" + СторонаПроводки];
		НоваяСтрока.КФО						= Проводка.КФО;
		НоваяСтрока.КЭК						= Проводка["КЭК" + СторонаПроводки];
		НоваяСтрока.Номенклатура			= Проводка["Субконто" + СторонаПроводки].Номенклатура;
		НоваяСтрока.Подразделение			= Проводка["Подразделение" + СторонаПроводки];
		НоваяСтрока.Сумма					= Проводка.Сумма;
		НоваяСтрока.ОС						= Проводка["Субконто" + СторонаПроводки].ОсновныеСредства;
		НоваяСтрока.Счет					= Проводка["Счет" + СторонаПроводки];
		НоваяСтрока.ЦМО						= Проводка["Субконто" + СторонаПроводки].ЦМО;
		
	КонецЦикла;
	
	Для Каждого Проводка Из Движения.ЖурналПроводокЕПСБУ Цикл
		
		Если Проводка["Счет" + СторонаПроводки].ТипСчета <> Перечисления.ТипыСчетов.Налоговый Тогда
			Продолжить;
		КонецЕсли;
		
		ОтражатьВНалоговомУчете = Истина;
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("КФО",				Проводка.КФО);
		СтруктураОтбора.Вставить("Номенклатура",	Проводка["Субконто" + СторонаПроводки].Номенклатура);
		СтруктураОтбора.Вставить("Количество",		Проводка["Количество" + СторонаПроводки]);
		НайденныеСтроки = Материалы.НайтиСтроки(СтруктураОтбора);
		
		Если НайденныеСтроки.Количество() <> 0 Тогда
			НайденаяСтрока = НайденныеСтроки[0]; 
			НайденаяСтрока.СчетНУ	= Проводка["Счет" + СторонаПроводки];
			НайденаяСтрока.СуммаНУ	= Проводка.Сумма;
		ИначеЕсли Не ОтражатьВБухгалтерскомУчете Тогда
			НоваяСтрока = Материалы.Добавить();
			НоваяСтрока.СчетНУ			= Проводка["Счет" + СторонаПроводки];
			НоваяСтрока.СуммаНУ			= Проводка.Сумма;
			НоваяСтрока.КоличествоМест	= Проводка["Количество" + СторонаПроводки];
			НоваяСтрока.Количество		= Проводка["Количество" + СторонаПроводки];
		КонецЕсли;
	КонецЦикла;
	
	ТолькоНалУчетОСН = Не ОтражатьВБухгалтерскомУчете И ОтражатьВНалоговомУчете;
	Если ТолькоНалУчетОСН Тогда
		СуммаДокумента = Материалы.Итог("СуммаНУ");
	Иначе
		СуммаДокумента = Материалы.Итог("Сумма");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьИзДвиженийПоСчету106хП()
	
	Если Движения.ЖурналПроводокЕПСБУ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПерваяПроводка = Движения.ЖурналПроводокЕПСБУ[0];
	
	Организация = ПерваяПроводка.Организация;
	ИФО			= ПерваяПроводка.ИФО;
	КФО			= ПерваяПроводка.КФО;
	
	ОтражатьВБухгалтерскомУчете	= Истина;
	ОтражатьВНалоговомУчете		= Ложь;

	Затраты106хП.Очистить();
	Материалы106хП.Очистить();
	
	Для Каждого Проводка Из Движения.ЖурналПроводокЕПСБУ Цикл
		
		Если Проводка.СчетДт.ТипСчета = Перечисления.ТипыСчетов.Налоговый Тогда
			Продолжить;
		КонецЕсли;
		
		НоавяСтрока = Материалы106хП.Добавить();
		НоавяСтрока.Количество		= Проводка.КоличествоДт;
		НоавяСтрока.КПС				= Проводка.КПСДт;
		НоавяСтрока.КЭК				= Проводка.КЭКДт;
		НоавяСтрока.Номенклатура	= Проводка.СубконтоДт.Номенклатура;
		НоавяСтрока.Счет			= Проводка.СчетДт;
		
		НоваяСтрока = Затраты106хП.Добавить();
		НоваяСтрока.ВидЗатрат		= Проводка.СубконтоДт.ВидыЗатрат;
		НоваяСтрока.КПС				= Проводка.КПСДт;
		НоваяСтрока.Номенклатура	= Проводка.СубконтоДт.Номенклатура;
		НоваяСтрока.Счет			= Проводка.СчетДт;
		НоваяСтрока.Сумма			= Проводка.Сумма;
		НоваяСтрока.ЦМО				= Проводка.СубконтоДт.ЦМО;
		
	КонецЦикла;
	
	Для Каждого Проводка Из Движения.ЖурналПроводокЕПСБУ Цикл
		
		Если Проводка.СчетДт.ТипСчета <> Перечисления.ТипыСчетов.Налоговый Тогда
			Продолжить;
		КонецЕсли;

		СтруктураОтбора = Новый Структура("Номенклатура,КПС,КЭК", Проводка.СубконтоДт.Номенклатура,Проводка.КПСДт,Проводка.КЭКДт);
			
		НайденныеСтроки = Материалы106хП.НайтиСтроки(СтруктураОтбора);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
			ТекущаяСтрока.СчетНУ = Проводка.СчетДт;
		КонецЦикла;
		
		СтруктураОтбора = Новый Структура("Номенклатура,ВидЗатрат,КПС", Проводка.СубконтоДт.Номенклатура,Проводка.СубконтоДт.ВидыЗатрат,Проводка.КПСДт);
		
		НайденныеСтроки = Затраты106хП.НайтиСтроки(СтруктураОтбора);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = Затраты106хП.Добавить();
			НоваяСтрока.ВидЗатрат		= Проводка.СубконтоДт.ВидыЗатрат;
			НоваяСтрока.КПС				= Проводка.КПСДт;
			НоваяСтрока.Номенклатура	= Проводка.СубконтоДт.Номенклатура;
			НоваяСтрока.СчетНУ			= Проводка.СчетДт;
			НоваяСтрока.СуммаНУ			= Проводка.Сумма;
			НоваяСтрока.ЦМО				= Проводка.СубконтоДт.ЦМО;
		Иначе
			Для Каждого ТекущаяСтрока Из НайденныеСтроки Цикл
				ТекущаяСтрока.СчетНУ	= Проводка.СчетДт;
				ТекущаяСтрока.СуммаНУ	= Проводка.Сумма;
			КонецЦикла;
		КонецЕсли;
		
		ОтражатьВНалоговомУчете = Истина;
		
	КонецЦикла;
	
	ТолькоНалУчетОСН = Не ОтражатьВБухгалтерскомУчете И ОтражатьВНалоговомУчете;
	Если ТолькоНалУчетОСН Тогда
		СуммаДокумента = Затраты106хП.Итог("СуммаНУ");
	Иначе
		СуммаДокумента = Затраты106хП.Итог("Сумма");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьИзДвиженийДенежныеДокументы()
	
	Если Движения.ЖурналПроводокЕПСБУ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОтражатьВБухгалтерскомУчете = Истина;
	
	ПерваяПроводка = Движения.ЖурналПроводокЕПСБУ[0];
	
	КурсКратность = БухгалтерскиеОперацииВызовСервера.ПолучитьКурсВалюты(ПерваяПроводка.ВалютаДт, ПерваяПроводка.Период);
	
	Организация		= ПерваяПроводка.Организация;
	Счет			= ПерваяПроводка.СчетДт;
	ИФО				= ПерваяПроводка.ИФО;
	КФО				= ПерваяПроводка.КФО;
	КПС				= ПерваяПроводка.КПСДт;
	КЭК				= ПерваяПроводка.КЭКДт;
	Курс			= КурсКратность.Курс;
	Кратность		= КурсКратность.Кратность;
	ВалютаДокумента	= ПерваяПроводка.ВалютаДт;
	//СуммаДокумента				= Движения.ЖурналПроводокЕПСБУ.Итог("Сумма");
	//ВалютнаяСуммаДокумента		= Движения.ЖурналПроводокЕПСБУ.Итог("ВалютнаяСуммаДт");
		
	Для Каждого СтрокаДвижения Из Движения.ДенежныеДокументы Цикл
		НоваяСтрока = ДенежныеДокументы.Добавить();
		НоваяСтрока.ВидДенежногоДокумента	= СтрокаДвижения.ВидДенежногоДокумента;
		НоваяСтрока.ДенежныйДокумент		= СтрокаДвижения.ДенежныйДокумент;
		НоваяСтрока.Количество				= СтрокаДвижения.Количество;
		НоваяСтрока.Сумма					= СтрокаДвижения.Сумма;
	КонецЦикла;
	
	СуммаДокумента = ДенежныеДокументы.Итог("Сумма");
	
КонецПроцедуры

Процедура ЗаполнитьИзДвиженийБСО()
	
	Если Движения.ДвиженияБСО.Количество() > 0 Тогда
		
		МаксимальнаяДлина = ОбщегоНазначенияБГУКлиентСервер.МаксимальнаяДлинаНомераБСО();
		ДлиныНомеровБСО = Новый Соответствие;
		
		// Заполняем по регистру накопления
		
		ПерваяСтрокаДвижения		= Движения.ДвиженияБСО[0];
		Организация					= ПерваяСтрокаДвижения.Организация;
		Счет						= ПерваяСтрокаДвижения.СчетУчета;
		ИФО							= ПерваяСтрокаДвижения.ИФО;
		КФО							= ПерваяСтрокаДвижения.КФО;
		ЦМО							= ПерваяСтрокаДвижения.ЦМО;
		ПодразделениеОрганизации	= ПерваяСтрокаДвижения.Подразделение;
		ОтражатьВБухгалтерскомУчете	= Истина;
		
		Для Каждого СтрокаДвижения Из Движения.ДвиженияБСО Цикл
			
			ДлинаНомера = ДлиныНомеровБСО[СтрокаДвижения.БСО];
			
			Если ДлинаНомера = Неопределено Тогда
				ДлинаНомера = ?(ЗначениеЗаполнено(СтрокаДвижения.БСО),
					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДвижения.БСО, "ДлинаНомера"), 0);
				ДлинаНомера = ?(ДлинаНомера = 0, МаксимальнаяДлина, Мин(ДлинаНомера, МаксимальнаяДлина));
				ДлиныНомеровБСО.Вставить(СтрокаДвижения.БСО, ДлинаНомера);
			КонецЕсли;
			
			НоваяСтрока					= СоставБСО.Добавить();
			НоваяСтрока.БСО				= СтрокаДвижения.БСО;
			НоваяСтрока.СерияБСО		= СтрокаДвижения.СерияБСО;
			НоваяСтрока.НомерНачальный	= НомерБСОПоФормату(СтрокаДвижения.НомерНачальный, ДлинаНомера);
			НоваяСтрока.НомерКонечный	= НомерБСОПоФормату(СтрокаДвижения.НомерКонечный, ДлинаНомера);
			НоваяСтрока.Количество		= ?(СтрокаДвижения.ВидДвижения = ВидДвиженияНакопления.Расход,
				- СтрокаДвижения.Количество, СтрокаДвижения.Количество);
			
		КонецЦикла;
		
		СоставБСО.Сортировать("БСО,СерияБСО,НомерНачальный");
		
	ИначеЕсли Движения.ЖурналПроводокЕПСБУ.Количество() > 0 Тогда
		
		// Если данных в регистре накопления нет, то заполняем по проводкам
		
		ПерваяПроводка				= Движения.ЖурналПроводокЕПСБУ[0];
		Организация					= ПерваяПроводка.Организация;
		Счет						= ПерваяПроводка.СчетДт;
		ИФО							= ПерваяПроводка.ИФО;
		КФО							= ПерваяПроводка.КФО;
		ЦМО							= ПерваяПроводка.СубконтоДт.ЦМО;
		ПодразделениеОрганизации	= ПерваяПроводка.ПодразделениеДт;
		ОтражатьВБухгалтерскомУчете	= Истина;
		
		Для Каждого СтрокаДвижения Из Движения.ЖурналПроводокЕПСБУ Цикл
			НоваяСтрока					= СоставБСО.Добавить();
			НоваяСтрока.БСО				= СтрокаДвижения.СубконтоДт.БСО;
			НоваяСтрока.СерияБСО		= Справочники.СерииБСО.ПустаяСсылка();
			НоваяСтрока.НомерНачальный	= "";
			НоваяСтрока.НомерКонечный	= "";
			НоваяСтрока.Количество		= СтрокаДвижения.КоличествоДт;
		КонецЦикла;
		
		СоставБСО.Сортировать("БСО");
		
	КонецЕсли;
	
	СуммаДокумента = СоставБСО.Итог("Количество");
	
КонецПроцедуры

Процедура ЗаполнитьИзДвиженийНДС()
	
	Если Движения.ВходящийНДС.Количество() <> 0 Тогда
		ДвиженияНДС = Движения.ВходящийНДС;
		ВходящийНДС	= Истина;
		ВидНДС		= 1;
	ИначеЕсли Движения.ИсходящийНДС.Количество() <> 0 Тогда
		ДвиженияНДС = Движения.ИсходящийНДС;
		ВходящийНДС	= Ложь;
		ВидНДС		= 0;
	Иначе
		Возврат;
	КонецЕсли;
	
	ОтражатьВБухгалтерскомУчете = Истина;
		
	Если Движения.ЖурналПроводокЕПСБУ.Количество() <> 0 Тогда
		ПерваяПроводка = Движения.ЖурналПроводокЕПСБУ[0];
		
		Организация					= ПерваяПроводка.Организация;
		ПодразделениеОрганизации    = ПерваяПроводка.ПодразделениеДт;
		ИФО							= ПерваяПроводка.ИФО;
		ВалютаДокумента				= ПерваяПроводка.ВалютаДт;
	Иначе
		ПерваяСтрокаДвижения = ДвиженияНДС[0];
		
		Организация = ПерваяСтрокаДвижения.Организация;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВалютаДокумента) Тогда
		ВалютаДокумента	= Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	Для Каждого СтрокаДвижения Из ДвиженияНДС Цикл
		НоваяСтрока = НДС.Добавить();
			
		Если ВходящийНДС Тогда
			НоваяСтрока.СчетКредита		= СтрокаДвижения.СчетКредита;
			НоваяСтрока.ВидЦенности		= СтрокаДвижения.ВидЦенности;	
		Иначе
			НоваяСтрока.СчетДебета		= СтрокаДвижения.СчетДебета;
			НоваяСтрока.КЭКСчетДебета	= СтрокаДвижения.КОСГУСчетДебета;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДвижения.СчетФактура) Тогда
			НоваяСтрока.Договор					= СтрокаДвижения.СчетФактура.Договор;
			НоваяСтрока.Контрагент				= СтрокаДвижения.СчетФактура.Контрагент;
			
			Если ТипЗнч(СтрокаДвижения.СчетФактура) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				НоваяСтрока.НомерСчетаФактуры	= СтрокаДвижения.СчетФактура.НомерПервичногоДокумента;
				НоваяСтрока.ДатаСчетаФактуры	= СтрокаДвижения.СчетФактура.ДатаПервичногоДокумента;
			Иначе
				НоваяСтрока.НомерСчетаФактуры	= СтрокаДвижения.СчетФактура.Номер;
				НоваяСтрока.ДатаСчетаФактуры	= СтрокаДвижения.СчетФактура.Дата;
			КонецЕсли;
			
			Если ТипЗнч(СтрокаДвижения.СчетФактура) = Тип("ДокументСсылка.СчетФактураПолученный")
				ИЛИ ТипЗнч(СтрокаДвижения.СчетФактура) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
				НоваяСтрока.КодСпособаВыставления	= СтрокаДвижения.СчетФактура.КодСпособаВыставления;
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДвижения,
			"СтавкаНДС,
			|СчетРасчетов,
			|КПССчетРасчетов,
			|КФО,
			|ПричинаНалогообложения,
			|СчетФактура,
			|ОбъектНалогообложения,
			|ДокументКорректировки,
			|МестоРегистрации,
			|Сторно");
		
		НоваяСтрока.СуммаНДС	= СтрокаДвижения.СуммаНДСВалютная;
		НоваяСтрока.СуммаБезНДС	= СтрокаДвижения.СуммаБезНДСВалютная;
		
		НоваяСтрока.СуммаБезНДСРублевая	= СтрокаДвижения.СуммаБезНДС;
		НоваяСтрока.СуммаНДСРублевая	= СтрокаДвижения.СуммаНДС;
		
	КонецЦикла;
	
	СуммаДокумента = НДС.Итог("СуммаНДС");
	
КонецПроцедуры

Процедура ЗаполнитьИзДвиженийСтуденты()
	
	Если Движения.ЖурналПроводокЕПСБУ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПерваяПроводка = Движения.ЖурналПроводокЕПСБУ[0];
	
	Организация = ПерваяПроводка.Организация;
	ИФО			= ПерваяПроводка.ИФО;
	КФО			= ПерваяПроводка.КФО;
	
	Если Движения.СведенияОСтудентах.Количество() <> 0 Тогда
		СтруктураОтбора = Новый Структура("Поле", ПланыВидовХарактеристик.ПоляПриказовОбразование.Группа);
		
		ТЗСведенияОСтудентах = Движения.СведенияОСтудентах.Выгрузить();
		ТЗСведенияОСтудентах.НайтиСтроки(СтруктураОтбора);
		Если ТЗСведенияОСтудентах.Количество() <> 0 Тогда
			ПринятьДетейВГруппу	= Истина;
			ГруппаСтудентов		= ТЗСведенияОСтудентах[0].Значение;
		КонецЕсли;
	КонецЕсли;
	
	Студенты.Очистить();
	
	ПерваяСтрока = Истина;
	Для Каждого СтрокаДвижения Из Движения.РасчетыСоСтудентами Цикл
		Если ПерваяСтрока Тогда
			КурсКратность = БухгалтерскиеОперацииВызовСервера.ПолучитьКурсВалюты(СтрокаДвижения.ВалютаВзаиморасчетов, СтрокаДвижения.Период);
		
			ВалютаДокумента			= СтрокаДвижения.ВалютаВзаиморасчетов;
			Курс					= КурсКратность.Курс;
			Кратность				= КурсКратность.Кратность;
			Факультет				= СтрокаДвижения.Факультет;
			ВидПервичногоДокумента	= СтрокаДвижения.ВидПервичногоДокумента;
			
			ПерваяСтрока = Ложь;
		КонецЕсли;
		
		НоваяСтрока = Студенты.Добавить();
		НоваяСтрока.Договор				= СтрокаДвижения.ДоговорКонтрагента;
		НоваяСтрока.Контрагент			= СтрокаДвижения.Контрагент;
		НоваяСтрока.ПорядокВыпискиСФ	= СтрокаДвижения.Студент;
		НоваяСтрока.Студент				= СтрокаДвижения.Студент;
		Если СтрокаДвижения.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
			НоваяСтрока.СуммаЗадолженность = СтрокаДвижения.СуммаВзаиморасчетов;
		Иначе
			НоваяСтрока.СуммаПереплата = СтрокаДвижения.СуммаВзаиморасчетов;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьИзДвиженийРодительскаяПлата()
	
	Если Движения.ЖурналПроводокЕПСБУ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПерваяПроводка = Движения.ЖурналПроводокЕПСБУ[0];
	
	Организация = ПерваяПроводка.Организация;
	ИФО			= ПерваяПроводка.ИФО;
	КФО			= ПерваяПроводка.КФО;

	РодительскаяПлата.Очистить();
	
	Для Каждого Проводка Из Движения.ЖурналПроводокЕПСБУ Цикл
		
		НоваяСтрока = РодительскаяПлата.Добавить();
		
		Если Проводка.СчетДт.ТипСчета = Перечисления.ТипыСчетов.Вспомогательный Тогда
			НоваяСтрока.Ребенок			= Справочники.Дети.НайтиПоРеквизиту("Контрагент", Проводка.СубконтоДт.Контрагенты);
			НоваяСтрока.Договор			= Проводка.СубконтоДт.Договоры;
			НоваяСтрока.Задолженность	= Проводка.Сумма;
		Иначе
			НоваяСтрока.Ребенок		= Справочники.Дети.НайтиПоРеквизиту("Контрагент", Проводка.СубконтоДт.Контрагенты);
			НоваяСтрока.Договор		= Проводка.СубконтоКт.Договоры;
			НоваяСтрока.Переплата	= Проводка.Сумма;
		КонецЕсли;

	КонецЦикла;
	
	ЗаполнитьСоставГруппДДУ();
	
КонецПроцедуры

Процедура ЗаполнитьИзДвиженийПрочиеСчетаБухгалтерскогоУчета()
	
	Если Движения.ЖурналПроводокЕПСБУ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПерваяПроводка = Движения.ЖурналПроводокЕПСБУ[0];
	
	Организация = ПерваяПроводка.Организация;
	ИФО = ПерваяПроводка.ИФО;
	
	ОтражатьВБухгалтерскомУчете = Истина;
	
	СуммаДокумента = Движения.ЖурналПроводокЕПСБУ.Итог("Сумма");
	
КонецПроцедуры


Процедура ОчиститьДокумент()
	
	Для Каждого Реквизит Из Метаданные().Реквизиты Цикл
		ЭтотОбъект[Реквизит.Имя] = Неопределено;
	КонецЦикла;
	
	Для Каждого ТабличнаяЧасть Из Метаданные().ТабличныеЧасти Цикл
		ЭтотОбъект[ТабличнаяЧасть.Имя].Очистить();
	КонецЦикла;
	
КонецПроцедуры

Процедура ОпределитьРазделУчета()
	
	Если Движения.ЖурналПроводокЕПСБУ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Счет = Движения.ЖурналПроводокЕПСБУ[0].СчетДт;
	
	Если БухгалтерскийУчет.СчетВИерархии(Счет, "01,02,22") Тогда
		РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Счет, "03") Тогда
		РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.БСО;
	// Для других разделов тоже прописать
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСоставГруппДДУ()
	
	ТЗРодительскаяПлата = РодительскаяПлата.Выгрузить(,"НомерСтроки, Ребенок, Договор");
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	ЗапросРП = Новый Запрос;
	ЗапросРП.МенеджерВременныхТаблиц = МенеджерВТ;
	ЗапросРП.УстановитьПараметр("РодительскаяПлата", ТЗРодительскаяПлата);
	ЗапросРП.Текст =
	"ВЫБРАТЬ
	|	РодительскаяПлата.НомерСтроки КАК НомерСтроки,
	|	РодительскаяПлата.Ребенок КАК Ребенок,
	|	РодительскаяПлата.Договор КАК Договор
	|ПОМЕСТИТЬ ВТРодительскаяПлата
	|ИЗ
	|	&РодительскаяПлата КАК ВТРодительскаяПлата";
	
	ЗапросРП.Выполнить();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоставГруппДДУСрезПоследних.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	СоставГруппДДУСрезПоследних.Льгота КАК Льгота,
	|	СоставГруппДДУСрезПоследних.Период КАК ДатаВключения,
	|	СоставГруппДДУСрезПоследних.СтавкаОплаты КАК СтавкаОплаты,
	|	СоставГруппДДУСрезПоследних.Ребенок КАК Ребенок,
	|	СоставГруппДДУСрезПоследних.Договор КАК Договор
	|ПОМЕСТИТЬ ВТСоставГруппДДУ
	|ИЗ
	|	РегистрСведений.СоставГруппДДУ.СрезПоследних(
	|			&Период,
	|			(Ребенок, Договор) В
	|				(ВЫБРАТЬ
	|					ВТРодительскаяПлата.Ребенок КАК Ребенок,
	|					ВТРодительскаяПлата.Договор КАК Договор
	|				ИЗ
	|					ВТРодительскаяПлата КАК ВТРодительскаяПлата)) КАК СоставГруппДДУСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоставГруппДДУДополнительныеУслугиСрезПоследних.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	СоставГруппДДУДополнительныеУслугиСрезПоследних.Льгота КАК Льгота,
	|	СоставГруппДДУДополнительныеУслугиСрезПоследних.Период КАК ДатаВключения,
	|	СоставГруппДДУДополнительныеУслугиСрезПоследних.СтавкаОплаты КАК СтавкаОплаты,
	|	СоставГруппДДУДополнительныеУслугиСрезПоследних.Ребенок КАК Ребенок,
	|	СоставГруппДДУДополнительныеУслугиСрезПоследних.Договор КАК Договор
	|ПОМЕСТИТЬ ВТСоставГруппДДУДопУслуги
	|ИЗ
	|	РегистрСведений.СоставГруппДДУДополнительныеУслуги.СрезПоследних(
	|			&Период,
	|			(Ребенок, Договор) В
	|				(ВЫБРАТЬ
	|					ВТРодительскаяПлата.Ребенок КАК Ребенок,
	|					ВТРодительскаяПлата.Договор КАК Договор
	|				ИЗ
	|					ВТРодительскаяПлата КАК ВТРодительскаяПлата)) КАК СоставГруппДДУДополнительныеУслугиСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСоставГруппДДУ.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	ВТСоставГруппДДУ.Льгота КАК Льгота,
	|	ВТСоставГруппДДУ.СтавкаОплаты КАК СтавкаОплаты,
	|	ВТРодительскаяПлата.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ВТРодительскаяПлата КАК ВТРодительскаяПлата
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСоставГруппДДУ КАК ВТСоставГруппДДУ
	|		ПО ВТРодительскаяПлата.Ребенок = ВТСоставГруппДДУ.Ребенок
	|			И ВТРодительскаяПлата.Договор = ВТСоставГруппДДУ.Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСоставГруппДДУДопУслуги.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	ВТСоставГруппДДУДопУслуги.Льгота КАК Льгота,
	|	ВТСоставГруппДДУДопУслуги.СтавкаОплаты КАК СтавкаОплаты,
	|	ВТРодительскаяПлата.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ВТРодительскаяПлата КАК ВТРодительскаяПлата
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСоставГруппДДУДопУслуги КАК ВТСоставГруппДДУДопУслуги
	|		ПО ВТРодительскаяПлата.Ребенок = ВТСоставГруппДДУДопУслуги.Ребенок
	|			И ВТРодительскаяПлата.Договор = ВТСоставГруппДДУДопУслуги.Договор";
	
	Результат = Запрос.ВыполнитьПакет();
	
	СоставГруппДДУ = Результат[2].Выгрузить();
	РодительскаяПлатаДопУслуги = 0;
	Если СоставГруппДДУ.Количество() = 0 Тогда
		СоставГруппДДУ = Результат[3].Выгрузить();
		РодительскаяПлатаДопУслуги = 1;
	КонецЕсли;
	
	Для Каждого СтрокаСоставГруппДДУ Из СоставГруппДДУ Цикл
		Если Не ЗначениеЗаполнено(ГруппаДетскогоУчреждения) Тогда
			ГруппаДетскогоУчреждения	= СтрокаСоставГруппДДУ.ГруппаДетскогоУчреждения;
			ПринятьДетейВГруппу			= Истина;
		КонецЕсли;
		
		ТекущаяСтрока = РодительскаяПлата.Индекс(СтрокаСоставГруппДДУ.НомерСтроки);
		ТекущаяСтрока.СтавкаОплаты	= СтрокаСоставГруппДДУ.СтавкаОплаты;
		ТекущаяСтрока.ДатаВключения	= СтрокаСоставГруппДДУ.ДатаВключения;
		ТекущаяСтрока.Льгота		= СтрокаСоставГруппДДУ.Льгота;
	КонецЦикла;
	
КонецПроцедуры

Функция НомерБСОПоФормату(Номер, ДлинаНомера)
	
	Если Не ЗначениеЗаполнено(Номер) Тогда
		Возврат "";
	КонецЕсли;	
	
	НомерСтрокой = Формат(Номер, "ЧГ=0");										// преобразуем число в строку
	НомерСтрокой = Лев(НомерСтрокой, ДлинаНомера);  							// обрезаем лишние символы справа
	НомерСтрокой = Прав("00000000000000000000" + НомерСтрокой, ДлинаНомера);	// дополняем до нужной длинны нулями слева
	
	Возврат НомерСтрокой;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли