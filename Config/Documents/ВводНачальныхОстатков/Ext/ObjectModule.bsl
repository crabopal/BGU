Процедура ИзменитьАктивностьДвиженийДокумента(ДокументСсылка, Активность)
	
	МенеджерыРегистров = Новый Массив;
		
	ДвиженияДокумента = Метаданные.Документы.ВводНачальныхОстатков.Движения;
	Для Каждого Регистр Из ДвиженияДокумента Цикл
		МенеджерыРегистров.Добавить(ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(Регистр.ПолноеИмя()));
	КонецЦикла;
	
	Для Каждого Менеджер Из МенеджерыРегистров Цикл
		
		НаборЗаписей = Менеджер.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ДокументСсылка);
		НаборЗаписей.Прочитать(); 
		
		НаборЗаписей.УстановитьАктивность(Активность);
		
		НаборЗаписей.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения");
		НаборЗаписей.Записывать = Истина;
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать();
		
		Если ТипЗнч(Менеджер) = Тип("РегистрБухгалтерииМенеджер.ЖурналПроводокЕПСБУ") Тогда
			
			Запись = РегистрыСведений.ОперацииДокументов.СоздатьМенеджерЗаписи();
			Запись.Документ = ДокументСсылка;
			Запись.Прочитать();
			Если Запись.Выбран() Тогда
				Запись.ЕстьПроводки = Активность И НаборЗаписей.Количество() > 0;
				Запись.Записать();
			КонецЕсли;

		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#Область ЗаполнитьИзДвиженийРазделУчета

Процедура ЗаполнитьИзДвижений()
	
	ЭтоАгрегаторДвижений = Истина;
	
	Если ДополнительныеСвойства.Свойство("РазделУчета") Тогда
		РазделУчета = ДополнительныеСвойства["РазделУчета"];
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РазделУчета) Тогда
		ОпределитьРазделУчета();
	КонецЕсли;
	
	Если РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазныМЗ Тогда
		ЗаполнитьИзДвиженийИмуществоКазныМЗ();
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе Тогда
		Документы.ВводНачальныхОстатков.ЗаполнитьИзДвиженийОСЗабаланс(ЭтотОбъект);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеСредства Тогда
		ЗаполнитьИзДвиженийДенежныеСредства();
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Материалы Тогда
		ЗаполнитьИзДвиженийМатериалы();
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПоСчету106хП Тогда
		ЗаполнитьИзДвиженийПоСчету106хП();
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеДокументы Тогда
		ЗаполнитьИзДвиженийДенежныеДокументы();
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.БСО Тогда
		ЗаполнитьИзДвиженийБСО();
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.НДС Тогда
		ЗаполнитьИзДвиженийНДС();
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Студенты Тогда
		ЗаполнитьИзДвиженийСтуденты();
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.РодительскаяПлата Тогда
		ЗаполнитьИзДвиженийРодительскаяПлата();
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПрочиеСчетаБухгалтерскогоУчета Тогда
		ЗаполнитьИзДвиженийПрочиеСчетаБухгалтерскогоУчета();
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ПраваПользованияАктивами Тогда
		Документы.ВводНачальныхОстатков.ЗаполнитьИзДвиженийПраваПользованияАктивами(ЭтотОбъект);
		
	ИначеЕсли РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.ДоходыБудущихПериодов Тогда
		Документы.ВводНачальныхОстатков.ЗаполнитьИзДвиженийДБП(ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьИзДвиженийИмуществоКазныМЗ()
	
	Если Движения.ЖурналПроводокЕПСБУ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПерваяПроводка	= Движения.ЖурналПроводокЕПСБУ[0];
	Организация		= ПерваяПроводка.Организация;
