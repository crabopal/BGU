&НаСервере
Процедура ЗаполнитьПоОстаткам()

	Объект.РасчетДолейСписания.Очистить();
	Объект.ДопРасходыУСН.Очистить();

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	ПараметрыЗаполнения = Новый Структура;
	
	Если ЭтаФорма.Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		ПараметрыЗаполнения.Вставить("ПериодОстатков",
			Новый Граница(КонецКвартала(ДокументОбъект.Дата), ВидГраницы.Включая) );
	Иначе
		ПараметрыЗаполнения.Вставить("ПериодОстатков",
			Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая) );
	КонецЕсли;
	
	ДокументОбъект.ЗаполнитьДокумент(ПараметрыЗаполнения);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ЭтаФорма.Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Функция ПолучитьНовыйИдСтроки()

	КолонкаИД = Объект.РасчетДолейСписания.Выгрузить(,"ИдСтроки");
	КолонкаИД.Сортировать("ИдСтроки Убыв");
	Если КолонкаИД.Количество() = 0 Тогда
		Возврат 1;
	Иначе
		Возврат КолонкаИД[0].ИдСтроки + 1;
	КонецЕсли;

КонецФункции // ПолучитьНовыйИдСтроки()

&НаСервере
Процедура УдалитьДопРасходыУСН(ИдСтроки)

	СтрокиКУдалению = Объект.ДопРасходыУСН.НайтиСтроки(Новый Структура("ИдСтроки", ИдСтроки));
	Для каждого Строка Из СтрокиКУдалению Цикл
		Объект.ДопРасходыУСН.Удалить(Строка);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияТекущейСтроки()
	
	ТекущиеДанные = Элементы.РасчетДолейСписания.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПозицияСтрокиИзменилась = ИдентификаторТекущейСтроки <> Неопределено;
	Иначе
		ПозицияСтрокиИзменилась = ТекущиеДанные.ПолучитьИдентификатор() <> ИдентификаторТекущейСтроки;
	КонецЕсли;
	
	Если НЕ ПозицияСтрокиИзменилась Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		НовыйОтбор = Новый Структура("ИдСтроки", -1);
	Иначе
		НовыйОтбор = Новый Структура("ИдСтроки", ТекущиеДанные.ИдСтроки);
	КонецЕсли;
	
	Элементы.ДопРасходыУСН.ОтборСтрок = Новый ФиксированнаяСтруктура(НовыйОтбор);
	
КонецПроцедуры

