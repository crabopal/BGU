#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьПоДаннымУчета(ДокументОбъект) Экспорт
	
	// Подготовка
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.СпособыСтроительства);
	
	// Настраиваем запрос
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДатаНачала",						НачалоКвартала(ДокументОбъект["Дата"]));
	ЗапросЗаполнение.УстановитьПараметр("ДатаОкончания",					КонецКвартала(ДокументОбъект["Дата"]));
	ЗапросЗаполнение.УстановитьПараметр("Организация",						ДокументОбъект["Организация"]);
	ЗапросЗаполнение.УстановитьПараметр("ВидыСубконто",						ВидыСубконто);
	ЗапросЗаполнение.УстановитьПараметр("ИФО",								ДокументОбъект["ИФО"]);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьУчетПоИФО",			ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ЗапросЗаполнение.УстановитьПараметр("Подразделение",					ДокументОбъект["Подразделение"]);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ЗапросЗаполнение.УстановитьПараметр("КФО",								ДокументОбъект["КФО"]);
	ЗапросЗаполнение.УстановитьПараметр("СчетКС",							БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("106.КС"));
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Суммы вложений в объекты строительства за период
	|//		(Финальная таблица)
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства)	КАК ОбъектСтроительства,
	|	КПС													КАК КПС,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18)				КАК СтавкаНДС,
	|	СУММА(СуммаОборотДт)								КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|		&ДатаНачала,				// 1
	|		&ДатаОкончания,				// 2
	|		,							// 3
	|		Счет В ИЕРАРХИИ (&СчетКС),	// 4
	|		&ВидыСубконто,				// 5
	|		Организация = &Организация
	|		И ВЫБОР
	|			КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И	КФО В(&КФО)
	|		И	Субконто2 = ЗНАЧЕНИЕ(Перечисление.СпособыСтроительства.Хозспособ)
	|	)	КАК ЕПСБУОбороты
	|ГДЕ
	|	// Отбор по подразделению
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И Счет.УчетПоПодразделениям ТОГДА
	|			Подразделение = &Подразделение
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства),
	|	КПС,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18)
	|;";
	
	ДокументОбъект["СМРХозспособом"].Загрузить(ЗапросЗаполнение.Выполнить().Выгрузить());
	
	Для Каждого СтрокаТЧ Из ДокументОбъект["СМРХозспособом"] Цикл
		СтрокаТЧ["СуммаНДС"] = СтрокаТЧ["Сумма"] * 0.18;
	КонецЦикла;
	
КонецПроцедуры

