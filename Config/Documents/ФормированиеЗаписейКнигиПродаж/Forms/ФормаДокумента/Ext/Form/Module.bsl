&НаКлиенте
Процедура ПроверитьИЗаполнить(ИмяКоманды)
	
	Если ИмяКоманды = "ЗаполнитьВсе" Тогда
		// Заполняем все табл.части
		ЗаполняемыеТабличныеЧасти = Новый Структура("Реализация,Реализация0,АвансыВыданные,АвансыВыданныеПредъявленныеКомиссионером");
		ЗаполняемыеТабличныеЧастиЗаполнены = (Объект["Реализация"].Количество() > 0
			ИЛИ Объект["Реализация0"].Количество() > 0
			ИЛИ Объект["АвансыВыданныеПредъявленныеКомиссионером"].Количество() > 0
			ИЛИ Объект["АвансыВыданные"].Количество() > 0);
		ТекстСообщения = НСтр("ru='Перед заполнением по данным учета
			|все табличные части будут очищены.
			|
			|Продолжить и очистить?'");
	Иначе
		// Заполняем только одну табл.часть
		ЗаполняемыеТабличныеЧасти = Новый Структура(ИмяКоманды);
		ЗаполняемыеТабличныеЧастиЗаполнены = (Объект[ИмяКоманды].Количество() > 0);
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Перед заполнением по данным учета
				|табличная часть ""%1""
				|будет очищена.
				|
				|Продолжить и очистить?'"),
			ИмяКоманды);
	КонецЕсли;
	
	Если ЗаполняемыеТабличныеЧастиЗаполнены Тогда
		ПараметрыОповещения = Новый Структура("ЗаполняемыеТабличныеЧасти", ЗаполняемыеТабличныеЧасти);
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнить_Выбор", ЭтотОбъект, ПараметрыОповещения);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьНаСервере(ЗаполняемыеТабличныеЧасти);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнить_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьНаСервере(ПараметрыОповещения["ЗаполняемыеТабличныеЧасти"]);
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Функция ЗаполнитьНаСервере(ЗаполняемыеТабличныеЧасти)
	
	Документы.ФормированиеЗаписейКнигиПродаж.ЗаполнитьПоДаннымУчета(Объект, ЗаполняемыеТабличныеЧасти);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция КонтрагентСчетФактуры(СчетФактура);
	Сведения = Новый Структура;
	Сведения.Вставить("Контрагент",СчетФактура.Контрагент);
	Сведения.Вставить("Договор",СчетФактура.Договор);
	Возврат 	Сведения;
КонецФункции

&НаКлиенте
Процедура РассчитатьСуммыВСтроке(ИмяТаблЧасти, Элемент)
	
	ТекДанные = Элементы[ИмяТаблЧасти].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяИзмененногоПоля = Сред(Элемент.Имя, СтрДлина(ИмяТаблЧасти) + 1);
	
	Если ВРег(ИмяТаблЧасти) = ВРег("Реализация") Тогда
		
		Если ИмяИзмененногоПоля = "Сумма22" ИЛИ ИмяИзмененногоПоля = "Сумма22Валютная"
			ИЛИ ИмяИзмененногоПоля = "СуммаНДС22" ИЛИ ИмяИзмененногоПоля = "СуммаНДС22Валютная"
			ИЛИ ИмяИзмененногоПоля = "СтавкаНДС22" Тогда
			СтруктураИменПолей = Новый Структура();
			СтруктураИменПолей.Вставить("Сумма",			"Сумма22");
			СтруктураИменПолей.Вставить("СуммаНДС",			"СуммаНДС22");
			СтруктураИменПолей.Вставить("Всего",			"Всего");
			СтруктураИменПолей.Вставить("СтавкаНДС",		"СтавкаНДС22");
			СтруктураИменПолей.Вставить("СуммаВалютная",	"Сумма22Валютная");
			СтруктураИменПолей.Вставить("СуммаНДСВалютная",	"СуммаНДС22Валютная");
			СтруктураИменПолей.Вставить("ВсегоВалютная",	"ВсегоВалютная");
			УчетНДСКлиентСервер.РассчитатьСуммы(ТекДанные, ИмяИзмененногоПоля, СтруктураИменПолей);
			
		ИначеЕсли ИмяИзмененногоПоля = "Сумма18" ИЛИ ИмяИзмененногоПоля = "Сумма18Валютная"
			ИЛИ ИмяИзмененногоПоля = "СуммаНДС18" ИЛИ ИмяИзмененногоПоля = "СуммаНДС18Валютная"
			ИЛИ ИмяИзмененногоПоля = "СтавкаНДС18" Тогда
			СтруктураИменПолей = Новый Структура();
			СтруктураИменПолей.Вставить("Сумма",			"Сумма18");
			СтруктураИменПолей.Вставить("СуммаНДС",			"СуммаНДС18");
			СтруктураИменПолей.Вставить("Всего",			"Всего");
			СтруктураИменПолей.Вставить("СтавкаНДС",		"СтавкаНДС18");
			СтруктураИменПолей.Вставить("СуммаВалютная",	"Сумма18Валютная");
			СтруктураИменПолей.Вставить("СуммаНДСВалютная",	"СуммаНДС18Валютная");
			СтруктураИменПолей.Вставить("ВсегоВалютная",	"ВсегоВалютная");
			УчетНДСКлиентСервер.РассчитатьСуммы(ТекДанные, ИмяИзмененногоПоля, СтруктураИменПолей);
			
		ИначеЕсли ИмяИзмененногоПоля = "Сумма10" ИЛИ ИмяИзмененногоПоля = "Сумма10Валютная"
			ИЛИ ИмяИзмененногоПоля = "СуммаНДС10" ИЛИ ИмяИзмененногоПоля = "СуммаНДС10Валютная"
			ИЛИ ИмяИзмененногоПоля = "СтавкаНДС10" Тогда
			СтруктураИменПолей = Новый Структура();
			СтруктураИменПолей.Вставить("Сумма",			"Сумма10");
			СтруктураИменПолей.Вставить("СуммаНДС",			"СуммаНДС10");
			СтруктураИменПолей.Вставить("Всего",			"Всего");
			СтруктураИменПолей.Вставить("СтавкаНДС",		"СтавкаНДС10");
			СтруктураИменПолей.Вставить("СуммаВалютная",	"Сумма10Валютная");
			СтруктураИменПолей.Вставить("СуммаНДСВалютная",	"СуммаНДС10Валютная");
			СтруктураИменПолей.Вставить("ВсегоВалютная",	"ВсегоВалютная");
			УчетНДСКлиентСервер.РассчитатьСуммы(ТекДанные, ИмяИзмененногоПоля, СтруктураИменПолей);
			
		ИначеЕсли ИмяИзмененногоПоля = "Сумма7" ИЛИ ИмяИзмененногоПоля = "Сумма7Валютная"
			ИЛИ ИмяИзмененногоПоля = "СуммаНДС7" ИЛИ ИмяИзмененногоПоля = "СуммаНДС7Валютная"
			ИЛИ ИмяИзмененногоПоля = "СтавкаНДС7" Тогда
			СтруктураИменПолей = Новый Структура();
			СтруктураИменПолей.Вставить("Сумма",			"Сумма7");
			СтруктураИменПолей.Вставить("СуммаНДС",			"СуммаНДС7");
			СтруктураИменПолей.Вставить("Всего",			"Всего");
			СтруктураИменПолей.Вставить("СтавкаНДС",		"СтавкаНДС7");
			СтруктураИменПолей.Вставить("СуммаВалютная",	"Сумма7Валютная");
			СтруктураИменПолей.Вставить("СуммаНДСВалютная",	"СуммаНДС7Валютная");
			СтруктураИменПолей.Вставить("ВсегоВалютная",	"ВсегоВалютная");
			УчетНДСКлиентСервер.РассчитатьСуммы(ТекДанные, ИмяИзмененногоПоля, СтруктураИменПолей);
			
		ИначеЕсли ИмяИзмененногоПоля = "Сумма5" ИЛИ ИмяИзмененногоПоля = "Сумма5Валютная"
			ИЛИ ИмяИзмененногоПоля = "СуммаНДС5" ИЛИ ИмяИзмененногоПоля = "СуммаНДС5Валютная"
			ИЛИ ИмяИзмененногоПоля = "СтавкаНДС5" Тогда
			СтруктураИменПолей = Новый Структура();
			СтруктураИменПолей.Вставить("Сумма",			"Сумма5");
			СтруктураИменПолей.Вставить("СуммаНДС",			"СуммаНДС5");
			СтруктураИменПолей.Вставить("Всего",			"Всего");
			СтруктураИменПолей.Вставить("СтавкаНДС",		"СтавкаНДС5");
			СтруктураИменПолей.Вставить("СуммаВалютная",	"Сумма5Валютная");
			СтруктураИменПолей.Вставить("СуммаНДСВалютная",	"СуммаНДС5Валютная");
			СтруктураИменПолей.Вставить("ВсегоВалютная",	"ВсегоВалютная");
			УчетНДСКлиентСервер.РассчитатьСуммы(ТекДанные, ИмяИзмененногоПоля, СтруктураИменПолей);
		КонецЕсли;
		
		ТекДанные["Всего"] = ТекДанные["Сумма22"] + ТекДанные["СуммаНДС22"]
			+ ТекДанные["Сумма18"] + ТекДанные["СуммаНДС18"]
			+ ТекДанные["Сумма10"] + ТекДанные["СуммаНДС10"]
			+ ТекДанные["Сумма7"] + ТекДанные["СуммаНДС7"]
			+ ТекДанные["Сумма5"] + ТекДанные["СуммаНДС5"]
			+ ТекДанные["Сумма0"] + ТекДанные["СуммаБН"];
			
		ТекДанные["ВсегоВалютная"] = ТекДанные["Сумма22Валютная"] + ТекДанные["СуммаНДС22Валютная"]
			+ ТекДанные["Сумма18Валютная"] + ТекДанные["СуммаНДС18Валютная"]
			+ ТекДанные["Сумма10Валютная"] + ТекДанные["СуммаНДС10Валютная"]
			+ ТекДанные["Сумма7Валютная"] + ТекДанные["СуммаНДС7Валютная"]
			+ ТекДанные["Сумма5Валютная"] + ТекДанные["СуммаНДС5Валютная"]
			+ ТекДанные["Сумма0Валютная"] + ТекДанные["СуммаБНВалютная"];
		
	ИначеЕсли ВРег(ИмяТаблЧасти) = ВРег("АвансыВыданные") Тогда
		СтруктураИменПолей = Новый Структура();
		СтруктураИменПолей.Вставить("СуммаНДС",			"СуммаНДС");
		СтруктураИменПолей.Вставить("Всего",			"Всего");
		СтруктураИменПолей.Вставить("СтавкаНДС",		"СтавкаНДС");
		СтруктураИменПолей.Вставить("СуммаНДСВалютная",	"СуммаНДСВалютная");
		СтруктураИменПолей.Вставить("ВсегоВалютная",	"ВсегоВалютная");
		УчетНДСКлиентСервер.РассчитатьСуммы(ТекДанные, ИмяИзмененногоПоля, СтруктураИменПолей, Истина);
		
	ИначеЕсли ВРег(ИмяТаблЧасти) = ВРег("АвансыВыданныеПредъявленныеКомиссионером") Тогда
		СтруктураИменПолей = Новый Структура();
		СтруктураИменПолей.Вставить("СуммаНДС",			"СуммаНДС");
		СтруктураИменПолей.Вставить("Всего",			"Всего");
		СтруктураИменПолей.Вставить("СтавкаНДС",		"СтавкаНДС");
		СтруктураИменПолей.Вставить("СуммаНДСВалютная",	"СуммаНДСВалютная");
		СтруктураИменПолей.Вставить("ВсегоВалютная",	"ВсегоВалютная");
		УчетНДСКлиентСервер.РассчитатьСуммы(ТекДанные, ИмяИзмененногоПоля, СтруктураИменПолей, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

