		|РеализацияКОСГУСчетДебета");
	НастройкиТаблиц.Вставить("Реализация", НастройкиОднойТаблицы);
	
	НастройкиОднойТаблицы = Новый Структура();
	НастройкиОднойТаблицы.Вставить("ИмяФлажкаПоДаннымУчета", "ПоУчету");
	НастройкиОднойТаблицы.Вставить("ИменаЭлементов",
		"Реализация0СчетФактура,
		|Реализация0ОбъектНалогообложения,
		|Реализация0Контрагент,
		|Реализация0СчетРасчетов,
		|Реализация0КПС,
		|Реализация0КФО");
	НастройкиТаблиц.Вставить("Реализация0", НастройкиОднойТаблицы);
	
	НастройкиОднойТаблицы = Новый Структура();
	НастройкиОднойТаблицы.Вставить("ИмяФлажкаПоДаннымУчета", "ПоУчету");
	НастройкиОднойТаблицы.Вставить("ИменаЭлементов",
		"АвансыВыданныеСчетФактура,
		|АвансыВыданныеОбъектНалогообложения,
		|АвансыВыданныеКонтрагент,
		|АвансыВыданныеДоговор,
		|АвансыВыданныеСчетРасчетов,
		|АвансыВыданныеКПССчетРасчетов,
		|АвансыВыданныеКФО,
		|АвансыВыданныеДатаЗачета,
		|АвансыВыданныеСчетДебета,
		|АвансыВыданныеКОСГУСчетДебета");
	НастройкиТаблиц.Вставить("АвансыВыданные", НастройкиОднойТаблицы);
	
	НастройкиОднойТаблицы = Новый Структура();
	НастройкиОднойТаблицы.Вставить("ИмяФлажкаПоДаннымУчета", "ПоУчету");
	НастройкиОднойТаблицы.Вставить("ИменаЭлементов",
		"АвансыВыданныеПредъявленныеКомиссионеромСчетФактура,
		|АвансыВыданныеПредъявленныеКомиссионеромОбъектНалогообложения,
		|АвансыВыданныеПредъявленныеКомиссионеромКонтрагент,
		|АвансыВыданныеПредъявленныеКомиссионеромДоговор,
		|АвансыВыданныеПредъявленныеКомиссионеромСчетРасчетов,
		|АвансыВыданныеПредъявленныеКомиссионеромКПССчетРасчетов,
		|АвансыВыданныеПредъявленныеКомиссионеромКФО,
		|АвансыВыданныеПредъявленныеКомиссионеромДатаЗачета,
		|АвансыВыданныеПредъявленныеКомиссионеромСчетДебета,
		|АвансыВыданныеПредъявленныеКомиссионеромКОСГУСчетДебета");
	НастройкиТаблиц.Вставить("АвансыВыданныеПредъявленныеКомиссионером", НастройкиОднойТаблицы);
	
	УчетНДС.ТолькоПросмотр_ПоДаннымУчета_Инициализация(ЭтаФорма, НастройкиТаблиц);
	
