	ТекущиеДанные = Элементы.Реализация.ТекущиеДанные;
	Сведения = КонтрагентСчетФактуры(ТекущиеДанные.СчетФактура);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные,Сведения);
