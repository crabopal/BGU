#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьПоДаннымУчета(Объект, ИменаЗаполняемыхТабличныхЧастей) Экспорт
	
	// Подготовка:
	ИмяЗакладкиРеализация		= "Реализация";
	ИмяЗакладкиРеализация0		= "Реализация0";
	ИмяЗакладкиАвансыВыданные	= "АвансыВыданные";
	ИмяЗакладкиАвансыВыданныеПредъявленныеКомиссионером = "АвансыВыданныеПредъявленныеКомиссионером";
	
	ЗаполнитьЗакладкуРеализация		= ИменаЗаполняемыхТабличныхЧастей.Свойство(ИмяЗакладкиРеализация);
	ЗаполнитьЗакладкуРеализация0	= ИменаЗаполняемыхТабличныхЧастей.Свойство(ИмяЗакладкиРеализация0);
	ЗаполнитьЗакладкуАвансыВыданные	= ИменаЗаполняемыхТабличныхЧастей.Свойство(ИмяЗакладкиАвансыВыданные);
	ЗаполнитьЗакладкуАвансыВыданныеПредъявленныеКомиссионером = ИменаЗаполняемыхТабличныхЧастей.Свойство(ИмяЗакладкиАвансыВыданныеПредъявленныеКомиссионером);
	
	ДатаОстатков = Новый Граница(КонецДня(Объект["Дата"]), ВидГраницы.Включая);
	
	// Настраиваем запрос:
	ЗапросОстатки = ИнициализироватьЗапрос_Остатки_ИсходящийНДС(Объект, ДатаОстатков,
		ЗаполнитьЗакладкуРеализация,
		ЗаполнитьЗакладкуРеализация0,
		ЗаполнитьЗакладкуАвансыВыданныеПредъявленныеКомиссионером,
		ЗаполнитьЗакладкуАвансыВыданные);
		
	ЗапросОстатки.УстановитьПараметр("ДатаОкончанияИгнорированияДокументовРасчетов",
		УчетНДС.ПолучитьДатуОкончанияИгнорированияДокументовРасчетов(Объект["Организация"]));
		
	ЗапросОстатки.Текст = ЗапросОстатки.Текст + "
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Остатки для закладки ""Реализация""
	|//
	|ВЫБРАТЬ
	|	СчетФактура,
	|	ДатаСчетаФактуры,
	|	Контрагент,
	|	ОбъектНалогообложения,
	|	ДатаРеализации,
	|	СчетРасчетов,
	|	КПССчетРасчетов,
	|	СчетДебета,
	|	КОСГУСчетДебета,
	|	СтавкаНДС,
	|	КФО,
	|	ИСТИНА						КАК ПоУчету,
	|	СУММА(СуммаБезНДС)			КАК СуммаБезНДС,
	|	СУММА(СуммаНДС)				КАК СуммаНДС,
	|	СУММА(Всего)				КАК Всего,
	|	СУММА(СуммаБезНДСВалютная)	КАК СуммаБезНДСВалютная,
	|	СУММА(СуммаНДСВалютная)		КАК СуммаНДСВалютная,
	|	СУММА(ВсегоВалютная)		КАК ВсегоВалютная
	|ИЗ
	|	ВсеОстатки
	|ГДЕ
	|	ЭтоЗакладкаРеализация
	|СГРУППИРОВАТЬ ПО
	|	СчетФактура,
	|	ДатаСчетаФактуры,
	|	Контрагент,
	|	ОбъектНалогообложения,
	|	ДатаРеализации,
	|	СчетРасчетов,
	|	КПССчетРасчетов,
	|	СчетДебета,
	|	КОСГУСчетДебета,
	|	СтавкаНДС,
	|	КФО,
	|	ИСТИНА
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСчетаФактуры,
	|	СчетФактура,
	|	ДатаРеализации,
	|	ОбъектНалогообложения,
	|	СчетРасчетов,
	|	КПССчетРасчетов,
	|	КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Остатки для закладки ""Реализация0""
	|//
	|ВЫБРАТЬ
	|	СчетФактура,
	|	ДатаСчетаФактуры,
	|	Контрагент,
	|	ОбъектНалогообложения,
	|	ДатаРеализации,
	|	СчетРасчетов,
	|	КПССчетРасчетов,
	|	СтавкаНДС,
	|	КФО,
	|	ИСТИНА						КАК ПоУчету,
	|	СУММА(СуммаБезНДС)			КАК СуммаБезНДС,
	|	СУММА(СуммаНДС)				КАК СуммаНДС,
	|	СУММА(Всего)				КАК Всего,
	|	СУММА(СуммаБезНДСВалютная)	КАК СуммаБезНДСВалютная,
	|	СУММА(СуммаНДСВалютная)		КАК СуммаНДСВалютная,
	|	СУММА(ВсегоВалютная)		КАК ВсегоВалютная
	|ИЗ
	|	ВсеОстатки
	|ГДЕ
	|	ЭтоЗакладкаРеализация0
	|СГРУППИРОВАТЬ ПО
	|	СчетФактура,
	|	ДатаСчетаФактуры,
	|	Контрагент,
	|	ОбъектНалогообложения,
	|	ДатаРеализации,
	|	СчетРасчетов,
	|	КПССчетРасчетов,
	|	СтавкаНДС,
	|	КФО,
	|	ИСТИНА
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСчетаФактуры,
	|	СчетФактура,
	|	ДатаРеализации,
	|	ОбъектНалогообложения,
	|	СчетРасчетов,
	|	КПССчетРасчетов,
	|	КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Остатки для закладки ""АвансыВыданные""
	|//
	|ВЫБРАТЬ
	|	СчетФактура,
	|	ДатаСчетаФактуры,
	|	Контрагент,
	|	Договор,
	|	СчетРасчетов,
	|	КПССчетРасчетов,
	|	СчетДебета,
	|	КОСГУСчетДебета,
	|	ОбъектНалогообложения,
	|	ДатаРеализации,
	|	СтавкаНДС,
	|	КФО,
	|	(ЕСТЬNULL(ОбъектНалогообложения.Дата, &ПустаяДата) <
	|		&ДатаОкончанияИгнорированияДокументовРасчетов)	КАК ВозможноПотребуетсяОчисткаДокументаРасчетов,
	|	ИСТИНА						КАК ПоУчету,
	|	СУММА(СуммаБезНДС)			КАК СуммаБезНДС,
	|	СУММА(СуммаНДС)				КАК СуммаНДС,
	|	СУММА(Всего)				КАК Всего,
	|	СУММА(СуммаБезНДСВалютная)	КАК СуммаБезНДСВалютная,
	|	СУММА(СуммаНДСВалютная)		КАК СуммаНДСВалютная,
	|	СУММА(ВсегоВалютная)		КАК ВсегоВалютная
	|ИЗ
	|	ВсеОстатки
	|ГДЕ
	|	ЭтоЗакладкаАвансыВыданные
	|СГРУППИРОВАТЬ ПО
	|	СчетФактура,
	|	ДатаСчетаФактуры,
	|	Контрагент,
	|	Договор,
	|	СчетРасчетов,
	|	КПССчетРасчетов,
	|	СчетДебета,
	|	КОСГУСчетДебета,
	|	ОбъектНалогообложения,
	|	ДатаРеализации,
	|	СтавкаНДС,
	|	КФО,
	|	(ЕСТЬNULL(ОбъектНалогообложения.Дата, &ПустаяДата) <
	|		&ДатаОкончанияИгнорированияДокументовРасчетов),
	|	ИСТИНА
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСчетаФактуры,
	|	СчетФактура
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Остатки для закладки ""АвансыВыданныеПредъявленныеКомиссионером""
	|//
	|ВЫБРАТЬ
	|	СчетФактура,
	|	ДатаСчетаФактуры,
	|	Контрагент,
	|	Договор,
	|	СчетРасчетов,
	|	КПССчетРасчетов,
	|	СчетДебета,
	|	КОСГУСчетДебета,
	|	ОбъектНалогообложения,
	|	ДатаРеализации,
	|	СтавкаНДС,
	|	КФО,
	|	(ЕСТЬNULL(ОбъектНалогообложения.Дата, &ПустаяДата) <
	|		&ДатаОкончанияИгнорированияДокументовРасчетов)	КАК ВозможноПотребуетсяОчисткаДокументаРасчетов,
	|	ИСТИНА						КАК ПоУчету,
	|	СУММА(СуммаБезНДС)			КАК СуммаБезНДС,
	|	СУММА(СуммаНДС)				КАК СуммаНДС,
	|	СУММА(Всего)				КАК Всего,
	|	СУММА(СуммаБезНДСВалютная)	КАК СуммаБезНДСВалютная,
	|	СУММА(СуммаНДСВалютная)		КАК СуммаНДСВалютная,
	|	СУММА(ВсегоВалютная)		КАК ВсегоВалютная
	|ИЗ
	|	ВсеОстатки
	|ГДЕ
	|	ЭтоЗакладкаАвансыВыданныеПредъявленныеКомиссионером
	|СГРУППИРОВАТЬ ПО
	|	СчетФактура,
	|	ДатаСчетаФактуры,
	|	Контрагент,
	|	Договор,
	|	СчетРасчетов,
	|	КПССчетРасчетов,
	|	СчетДебета,
	|	КОСГУСчетДебета,
	|	ОбъектНалогообложения,
	|	ДатаРеализации,
	|	СтавкаНДС,
	|	КФО,
	|	(ЕСТЬNULL(ОбъектНалогообложения.Дата, &ПустаяДата) <
	|		&ДатаОкончанияИгнорированияДокументовРасчетов),
	|	ИСТИНА
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСчетаФактуры,
	|	СчетФактура
	|;";
	
	РезультатыОстатки = ЗапросОстатки.ВыполнитьПакет();
	
	ТаблицаРеализация		= РезультатыОстатки[1].Выгрузить();
	ТаблицаРеализация0		= РезультатыОстатки[2].Выгрузить();
	ТаблицаАвансыВыданные	= РезультатыОстатки[3].Выгрузить();
	ТаблицаАвансыВыданныеПредъявленныеКомиссионером = РезультатыОстатки[4].Выгрузить();
	
	СписокСчетовФактур = Новый Массив();
	
	Если ЗаполнитьЗакладкуРеализация Тогда
		ТаблицаРеализацияИндивидуальныеКолонкиНДС = УчетНДС.ТрансформироватьТаблицуСКолонкамиНДС_ИзОбщих_ВИндивидуальные(ТаблицаРеализация);
		
		ДополнитьСписокСчетовФактур(СписокСчетовФактур, ТаблицаРеализацияИндивидуальныеКолонкиНДС);
	КонецЕсли;
	
	Если ЗаполнитьЗакладкуРеализация0 Тогда
		ДополнитьСписокСчетовФактур(СписокСчетовФактур, ТаблицаРеализация0);
	КонецЕсли;
	
	Если ЗаполнитьЗакладкуАвансыВыданные Тогда
		ТаблицаЗачтенныеАвансы = УчетНДС.РазбитьПоДатамЗачетаАвансаВыданного(ТаблицаАвансыВыданные, Объект);
		
		Если ТаблицаЗачтенныеАвансы.Количество() > 0 Тогда
			ДополнитьСписокСчетовФактур(СписокСчетовФактур, ТаблицаЗачтенныеАвансы);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаполнитьЗакладкуАвансыВыданныеПредъявленныеКомиссионером И ПолучитьФункциональнуюОпцию("ВестиУчетПоЗакупкеТоваровУслугЧерезКомиссионеров") Тогда
		
		АвансыКомиссионера = Истина;
		ТаблицаЗачтенныеАвансыВыданныеПредъявленныеКомиссионером = УчетНДС.РазбитьПоДатамЗачетаАвансаВыданного(ТаблицаАвансыВыданныеПредъявленныеКомиссионером, Объект);
		
		Если ТаблицаЗачтенныеАвансыВыданныеПредъявленныеКомиссионером.Количество() > 0 Тогда
			ДополнитьСписокСчетовФактур(СписокСчетовФактур, ТаблицаЗачтенныеАвансыВыданныеПредъявленныеКомиссионером);
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	СвойстваСчетовФактур = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(СписокСчетовФактур, "КодВидаОперации,РегистрацияВДопЛисте,КорректируемыйПериод");
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ЗаполнитьЗакладкуРеализация Тогда
		УчетНДС.ЗаполнитьКолонкиРегистрацииВКнигах(ТаблицаРеализацияИндивидуальныеКолонкиНДС, СвойстваСчетовФактур);
		
		Объект.Реализация.Загрузить(ТаблицаРеализацияИндивидуальныеКолонкиНДС);
	КонецЕсли;
	
	Если ЗаполнитьЗакладкуРеализация0 Тогда
		УчетНДС.ЗаполнитьКолонкиРегистрацииВКнигах(ТаблицаРеализация0, СвойстваСчетовФактур);
		
		Объект.Реализация0.Загрузить(ТаблицаРеализация0);
	КонецЕсли;
	
	Если ЗаполнитьЗакладкуАвансыВыданные Тогда
		УчетНДС.ЗаполнитьКолонкиРегистрацииВКнигах(ТаблицаЗачтенныеАвансы, СвойстваСчетовФактур);
		
		ТаблицаЗачтенныеАвансы.ЗаполнитьЗначения("21", "КодВидаОперации");
		
		Объект.АвансыВыданные.Загрузить(ТаблицаЗачтенныеАвансы);
	КонецЕсли;
	
	Если ЗаполнитьЗакладкуАвансыВыданныеПредъявленныеКомиссионером И ПолучитьФункциональнуюОпцию("ВестиУчетПоЗакупкеТоваровУслугЧерезКомиссионеров") Тогда
		УчетНДС.ЗаполнитьКолонкиРегистрацииВКнигах(ТаблицаЗачтенныеАвансыВыданныеПредъявленныеКомиссионером, СвойстваСчетовФактур);
		
		ТаблицаЗачтенныеАвансыВыданныеПредъявленныеКомиссионером.ЗаполнитьЗначения("21", "КодВидаОперации");
		
		Объект.АвансыВыданныеПредъявленныеКомиссионером.Загрузить(ТаблицаЗачтенныеАвансыВыданныеПредъявленныеКомиссионером);
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	// Инициализация:
	ЕстьОшибкиЗаполнения = Ложь;
	
	// Подготовка:
	ИмяТаблицыРеализация		= "Реализация";
	ИмяТаблицыРеализация0		= "Реализация0";
	ИмяТаблицыАвансыВыданные	= "АвансыВыданные";
	ИмяТаблицыАвансыВыданныеПредъявленныеКомиссионером	= "АвансыВыданныеПредъявленныеКомиссионером";
	ЗаполнитьВалютныеСуммы		= УчетНДС.СледуетЗаполнитьВалютныеСуммы();
	
	ИспользоватьЗакладкуРеализация		= (ДокументОбъект[ИмяТаблицыРеализация].Количество() > 0);
	ИспользоватьЗакладкуРеализация0		= (ДокументОбъект[ИмяТаблицыРеализация0].Количество() > 0);
	ИспользоватьЗакладкуАвансыВыданные	= (ДокументОбъект[ИмяТаблицыАвансыВыданные].Количество() > 0);
	ИспользоватьЗакладкуАвансыВыданныеПредъявленныеКомиссионером = (ДокументОбъект[ИмяТаблицыАвансыВыданныеПредъявленныеКомиссионером].Количество() > 0);
	
	ДатаОстатков = Новый Граница(КонецДня(ДокументОбъект["Дата"]), ВидГраницы.Включая);
	
	// Дополнительные отборы при определении текущих остатков:
	ОтборСчетФактура = Новый Массив();
	УчетНДС.ДобавитьВМассив(ОтборСчетФактура, ДокументОбъект[ИмяТаблицыРеализация].ВыгрузитьКолонку("СчетФактура"));
	УчетНДС.ДобавитьВМассив(ОтборСчетФактура, ДокументОбъект[ИмяТаблицыРеализация0].ВыгрузитьКолонку("СчетФактура"));
	УчетНДС.ДобавитьВМассив(ОтборСчетФактура, ДокументОбъект[ИмяТаблицыАвансыВыданные].ВыгрузитьКолонку("СчетФактура"));
	УчетНДС.ДобавитьВМассив(ОтборСчетФактура, ДокументОбъект[ИмяТаблицыАвансыВыданныеПредъявленныеКомиссионером].ВыгрузитьКолонку("СчетФактура"));
	ОтборОбъектНалогообложения = Новый Массив();
	ОтборОбъектНалогообложения.Добавить(Неопределено);
	УчетНДС.ДобавитьВМассив(ОтборОбъектНалогообложения, ДокументОбъект[ИмяТаблицыРеализация].ВыгрузитьКолонку("ОбъектНалогообложения"));
	УчетНДС.ДобавитьВМассив(ОтборОбъектНалогообложения, ДокументОбъект[ИмяТаблицыРеализация0].ВыгрузитьКолонку("ОбъектНалогообложения"));
	УчетНДС.ДобавитьВМассив(ОтборОбъектНалогообложения, ДокументОбъект[ИмяТаблицыАвансыВыданные].ВыгрузитьКолонку("ОбъектНалогообложения"));
	УчетНДС.ДобавитьВМассив(ОтборОбъектНалогообложения, ДокументОбъект[ИмяТаблицыАвансыВыданныеПредъявленныеКомиссионером].ВыгрузитьКолонку("ОбъектНалогообложения"));
	ОтборКФО = Новый Массив();
	УчетНДС.ДобавитьВМассив(ОтборКФО, ДокументОбъект[ИмяТаблицыРеализация].ВыгрузитьКолонку("КФО"));
	УчетНДС.ДобавитьВМассив(ОтборКФО, ДокументОбъект[ИмяТаблицыРеализация0].ВыгрузитьКолонку("КФО"));
	УчетНДС.ДобавитьВМассив(ОтборКФО, ДокументОбъект[ИмяТаблицыАвансыВыданные].ВыгрузитьКолонку("КФО"));
