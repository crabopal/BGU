		Если ЗаполнитьВалютныеСуммы Тогда
			МассивИменКолонокПоказателей.Добавить("СуммаНДСВалютная");
			МассивИменКолонокПоказателей.Добавить("ВсегоВалютная");
		КонецЕсли;
		ТаблицаПревышения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
			ТаблицаАвансыВыданныеПредъявленныеКомиссионером,
			ТаблицаОстаткиАвансыВыданныеПредъявленныеКомиссионером,
			КоллекцияИменКолонокСвязи,
			МассивИменКолонокПоказателей,
			"ПревышенияТаблицы1НадТаблицей2")["ПревышенияТаблицы1НадТаблицей2"];
		Если ТаблицаПревышения.Количество() > 0 Тогда
			ЕстьОшибкиЗаполнения = Истина;
			УчетНДС.ВывестиСообщенияОПревышенииОстатков(ТаблицаПревышения, ПараметрыВывода)			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента(ДокументОбъект, СтруктураДополнительныеСвойства) Экспорт
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("ИсходящийНДС",						ДокументОбъект.Движения["ИсходящийНДС"].Выгрузить());
	ТаблицыДляДвижений.Вставить("КнигаПокупок",						ДокументОбъект.Движения["КнигаПокупок"].Выгрузить());
	ТаблицыДляДвижений.Вставить("ДополнительныеЛистыКнигиПокупок",	ДокументОбъект.Движения["ДополнительныеЛистыКнигиПокупок"].Выгрузить());
	ТаблицыДляДвижений.Вставить("КнигаПродаж",						ДокументОбъект.Движения["КнигаПродаж"].Выгрузить());
	ТаблицыДляДвижений.Вставить("ДополнительныеЛистыКнигиПродаж",	ДокументОбъект.Движения["ДополнительныеЛистыКнигиПродаж"].Выгрузить());
	
	// Подготовка:
	ИмяТаблицыРеализация		= "Реализация";
	ИмяТаблицыРеализация0		= "Реализация0";
	ИмяТаблицыАвансыВыданные	= "АвансыВыданные";
	ИмяТаблицыАвансыВыданныеПредъявленныеКомиссионером	= "АвансыВыданныеПредъявленныеКомиссионером";
	
	ИспользоватьЗакладкуРеализация		= (ДокументОбъект[ИмяТаблицыРеализация].Количество() > 0);
	ИспользоватьЗакладкуРеализация0		= (ДокументОбъект[ИмяТаблицыРеализация0].Количество() > 0);
	ИспользоватьЗакладкуАвансыВыданные	= (ДокументОбъект[ИмяТаблицыАвансыВыданные].Количество() > 0);
	ИспользоватьЗакладкуАвансыВыданныеПредъявленныеКомиссионером	= (ДокументОбъект[ИмяТаблицыАвансыВыданныеПредъявленныеКомиссионером].Количество() > 0);
	ЗаполнитьВалютныеСуммы				= УчетНДС.СледуетЗаполнитьВалютныеСуммы();
	
	ДатаОстатков = Новый Граница(КонецДня(ДокументОбъект["Дата"]), ВидГраницы.Включая);
	
	// Дополнительные отборы при определении текущих остатков:
	ОтборСчетФактура = Новый Массив();
	УчетНДС.ДобавитьВМассив(ОтборСчетФактура, ДокументОбъект[ИмяТаблицыРеализация].ВыгрузитьКолонку("СчетФактура"));
	УчетНДС.ДобавитьВМассив(ОтборСчетФактура, ДокументОбъект[ИмяТаблицыРеализация0].ВыгрузитьКолонку("СчетФактура"));
	УчетНДС.ДобавитьВМассив(ОтборСчетФактура, ДокументОбъект[ИмяТаблицыАвансыВыданные].ВыгрузитьКолонку("СчетФактура"));
	УчетНДС.ДобавитьВМассив(ОтборСчетФактура, ДокументОбъект[ИмяТаблицыАвансыВыданныеПредъявленныеКомиссионером].ВыгрузитьКолонку("СчетФактура"));
	ОтборОбъектНалогообложения = Новый Массив();
	ОтборОбъектНалогообложения.Добавить(Неопределено);
	УчетНДС.ДобавитьВМассив(ОтборОбъектНалогообложения, ДокументОбъект[ИмяТаблицыРеализация].ВыгрузитьКолонку("ОбъектНалогообложения"));
	УчетНДС.ДобавитьВМассив(ОтборОбъектНалогообложения, ДокументОбъект[ИмяТаблицыРеализация0].ВыгрузитьКолонку("ОбъектНалогообложения"));
	УчетНДС.ДобавитьВМассив(ОтборОбъектНалогообложения, ДокументОбъект[ИмяТаблицыАвансыВыданные].ВыгрузитьКолонку("ОбъектНалогообложения"));
	УчетНДС.ДобавитьВМассив(ОтборОбъектНалогообложения, ДокументОбъект[ИмяТаблицыАвансыВыданныеПредъявленныеКомиссионером].ВыгрузитьКолонку("ОбъектНалогообложения"));
	ОтборКФО = Новый Массив();
	УчетНДС.ДобавитьВМассив(ОтборКФО, ДокументОбъект[ИмяТаблицыРеализация].ВыгрузитьКолонку("КФО"));
	УчетНДС.ДобавитьВМассив(ОтборКФО, ДокументОбъект[ИмяТаблицыРеализация0].ВыгрузитьКолонку("КФО"));
	УчетНДС.ДобавитьВМассив(ОтборКФО, ДокументОбъект[ИмяТаблицыАвансыВыданные].ВыгрузитьКолонку("КФО"));
	УчетНДС.ДобавитьВМассив(ОтборКФО, ДокументОбъект[ИмяТаблицыАвансыВыданныеПредъявленныеКомиссионером].ВыгрузитьКолонку("КФО"));
	
	// Получим текущие остатки:
	ЗапросОстатки = ИнициализироватьЗапрос_Остатки_ИсходящийНДС(ДокументОбъект, ДатаОстатков,
		ИспользоватьЗакладкуРеализация,
		ИспользоватьЗакладкуРеализация0,
		ИспользоватьЗакладкуАвансыВыданныеПредъявленныеКомиссионером,
		ИспользоватьЗакладкуАвансыВыданные);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборСчетФактура",			(ОтборСчетФактура.Количество() > 0));
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборОбъектНалогообложения",	(ОтборОбъектНалогообложения.Количество() > 0));
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборКФО",					(ОтборКФО.Количество() > 0));
	ЗапросОстатки.УстановитьПараметр("ОтборСчетФактура",						ОтборСчетФактура);
	ЗапросОстатки.УстановитьПараметр("ОтборОбъектНалогообложения",				ОтборОбъектНалогообложения);
	ЗапросОстатки.УстановитьПараметр("ОтборКФО",								ОтборКФО);
	ЗапросОстатки.Текст = ЗапросОстатки.Текст + "
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Все остатки
	|//
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	ВсеОстатки
	|;";
	ОбщаяТаблицаОстатки = ЗапросОстатки.Выполнить().Выгрузить();
	
	ПоискОсновнойРазделКниги		= Новый Структура("ЗаписьДопЛиста", Ложь);
	ПоискДополнительныеЛистыКниги	= Новый Структура("ЗаписьДопЛиста", Истина);
	
	Если ИспользоватьЗакладкуРеализация Тогда
		ТаблицаТЧ = УчетНДС.ТрансформироватьТаблицуСКолонкамиНДС_ИзИндивидуальных_ВОбщие(ДокументОбъект[ИмяТаблицыРеализация].Выгрузить());
		
		ДобавитьДвиженияПоТабличнойЧасти(ИмяТаблицыРеализация, ТаблицаТЧ, ОбщаяТаблицаОстатки, ТаблицыДляДвижений, ЗаполнитьВалютныеСуммы);
	КонецЕсли;
	
	Если ИспользоватьЗакладкуРеализация0 Тогда
		ТаблицаТЧ = ДокументОбъект[ИмяТаблицыРеализация0].Выгрузить();
		
		ДобавитьДвиженияПоТабличнойЧасти(ИмяТаблицыРеализация0, ТаблицаТЧ, ОбщаяТаблицаОстатки, ТаблицыДляДвижений, ЗаполнитьВалютныеСуммы);
	КонецЕсли;
	
	Если ИспользоватьЗакладкуАвансыВыданные Тогда
		ТаблицаТЧ = ДокументОбъект[ИмяТаблицыАвансыВыданные].Выгрузить();
		
		ДобавитьДвиженияПоТабличнойЧасти(ИмяТаблицыАвансыВыданные, ТаблицаТЧ, ОбщаяТаблицаОстатки, ТаблицыДляДвижений, ЗаполнитьВалютныеСуммы);
	КонецЕсли;
	
	Если ИспользоватьЗакладкуАвансыВыданныеПредъявленныеКомиссионером Тогда
		ТаблицаТЧ = ДокументОбъект[ИмяТаблицыАвансыВыданныеПредъявленныеКомиссионером].Выгрузить();
		
		ДобавитьДвиженияПоТабличнойЧасти(ИмяТаблицыАвансыВыданныеПредъявленныеКомиссионером, ТаблицаТЧ, ОбщаяТаблицаОстатки, ТаблицыДляДвижений, ЗаполнитьВалютныеСуммы);
	КонецЕсли;
	
	// Дозаполняем таблицы движений
	ТаблицыДляДвижений["ИсходящийНДС"].ЗаполнитьЗначения(ВидДвиженияНакопления.Расход,				"ВидДвижения");
	ТаблицыДляДвижений["ИсходящийНДС"].ЗаполнитьЗначения(ДокументОбъект["Дата"],					"Период");
	ТаблицыДляДвижений["ИсходящийНДС"].ЗаполнитьЗначения(Истина,									"Активность");
	
	ТаблицыДляДвижений["КнигаПокупок"].ЗаполнитьЗначения(ДокументОбъект["Дата"],					"Период");
	ТаблицыДляДвижений["КнигаПокупок"].ЗаполнитьЗначения(Истина,									"Активность");
	
	ТаблицыДляДвижений["ДополнительныеЛистыКнигиПокупок"].ЗаполнитьЗначения(ДокументОбъект["Дата"],	"Период");
	ТаблицыДляДвижений["ДополнительныеЛистыКнигиПокупок"].ЗаполнитьЗначения(Истина,					"Активность");
	
	ТаблицыДляДвижений["КнигаПродаж"].ЗаполнитьЗначения(ДокументОбъект["Дата"],						"Период");
	ТаблицыДляДвижений["КнигаПродаж"].ЗаполнитьЗначения(Истина,										"Активность");
	
	ТаблицыДляДвижений["ДополнительныеЛистыКнигиПродаж"].ЗаполнитьЗначения(ДокументОбъект["Дата"],	"Период");
	ТаблицыДляДвижений["ДополнительныеЛистыКнигиПродаж"].ЗаполнитьЗначения(Истина,					"Активность");
	
КонецПроцедуры

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//	Создает временную таблицу "ВсеОстатки".
Функция ИнициализироватьЗапрос_Остатки_ИсходящийНДС(Объект, ДатаОстатков,
	ИспользоватьЗакладкуРеализация,
	ИспользоватьЗакладкуРеализация0,
	ИспользоватьЗакладкуАвансыВыданныеПредъявленныеКомиссионером,
	ИспользоватьЗакладкуАвансыВыданные)
	
	ПричиныНалогообложенияЗакладкиРеализация = Новый Массив();
	ПричиныНалогообложенияЗакладкиРеализация.Добавить(Перечисления.ПричиныНалогообложенияНДС.Реализация);
	
	ПричиныНалогообложенияЗакладкиРеализация0 = Новый Массив();
	ПричиныНалогообложенияЗакладкиРеализация0.Добавить(Перечисления.ПричиныНалогообложенияНДС.Реализация0);
	ПричиныНалогообложенияЗакладкиРеализация0.Добавить(Перечисления.ПричиныНалогообложенияНДС.Реализация);
	
	ПричиныНалогообложенияЗакладкиАвансыВыданныеПредъявленныеКомиссионером = Новый Массив();
	ПричиныНалогообложенияЗакладкиАвансыВыданныеПредъявленныеКомиссионером.Добавить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера);
	
	ПричиныНалогообложенияЗакладкиАвансыВыданные = Новый Массив();
	ПричиныНалогообложенияЗакладкиАвансыВыданные.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансВыданный);
	
	ПричиныНалогообложения = Новый Массив();
	Если ИспользоватьЗакладкуРеализация Тогда
		УчетНДС.ДобавитьВМассив(ПричиныНалогообложения, ПричиныНалогообложенияЗакладкиРеализация);
	КонецЕсли;
	Если ИспользоватьЗакладкуРеализация0 Тогда
		УчетНДС.ДобавитьВМассив(ПричиныНалогообложения, ПричиныНалогообложенияЗакладкиРеализация0);
	КонецЕсли;
	Если ИспользоватьЗакладкуАвансыВыданные Тогда
		УчетНДС.ДобавитьВМассив(ПричиныНалогообложения, ПричиныНалогообложенияЗакладкиАвансыВыданные);
	КонецЕсли;
	Если ИспользоватьЗакладкуАвансыВыданныеПредъявленныеКомиссионером Тогда
		УчетНДС.ДобавитьВМассив(ПричиныНалогообложения, ПричиныНалогообложенияЗакладкиАвансыВыданныеПредъявленныеКомиссионером);
	КонецЕсли;
	
	ИспользоватьОтборПодразделение	= (ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ЗначениеЗаполнено(Объект["Подразделение"]));
	ИспользоватьОтборИФО			= (ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(Объект["ИФО"]));
	
	// Настраиваем запрос:
	ЗапросОстатки = Новый Запрос();
	ЗапросОстатки.УстановитьПараметр("ДатаОстатков",									ДатаОстатков);
	
	ЗапросОстатки.УстановитьПараметр("ПустаяДата",										'00010101');
	
	ЗапросОстатки.УстановитьПараметр("Организация",										Объект["Организация"]);
	ЗапросОстатки.УстановитьПараметр("ПричиныНалогообложенияЗакладкиРеализация",		ПричиныНалогообложенияЗакладкиРеализация);
	ЗапросОстатки.УстановитьПараметр("ПричиныНалогообложенияЗакладкиРеализация0",		ПричиныНалогообложенияЗакладкиРеализация0);
	ЗапросОстатки.УстановитьПараметр("ПричиныНалогообложенияЗакладкиАвансыВыданные",	ПричиныНалогообложенияЗакладкиАвансыВыданные);
	ЗапросОстатки.УстановитьПараметр("ПричиныНалогообложенияЗакладкиАвансыВыданныеПредъявленныеКомиссионером",	ПричиныНалогообложенияЗакладкиАвансыВыданныеПредъявленныеКомиссионером);
	ЗапросОстатки.УстановитьПараметр("ПричиныНалогообложения",							ПричиныНалогообложения);
	ЗапросОстатки.УстановитьПараметр("ДокументСсылка",									Объект["Ссылка"]);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборОбъектНалогообложения",			Ложь);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборСчетФактура",					Ложь);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборКФО",							Ложь);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборПодразделение",					ИспользоватьОтборПодразделение);
	ЗапросОстатки.УстановитьПараметр("ИспользоватьОтборИФО",							ИспользоватьОтборИФО);
	ЗапросОстатки.УстановитьПараметр("ОтборОбъектНалогообложения",						Неопределено);
	ЗапросОстатки.УстановитьПараметр("ОтборСчетФактура",								Неопределено);
	ЗапросОстатки.УстановитьПараметр("ОтборКФО",										Неопределено);
	ЗапросОстатки.УстановитьПараметр("ОтборПодразделение",								Объект["Подразделение"]);
	ЗапросОстатки.УстановитьПараметр("ОтборИФО",										Объект["ИФО"]);
	ЗапросОстатки.УстановитьПараметр("ЗаполнитьВалютныеСуммы",							УчетНДС.СледуетЗаполнитьВалютныеСуммы());
	ЗапросОстатки.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Все остатки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	// Все измерения:
	|	Организация						КАК Организация,
	|	СчетФактура						КАК СчетФактура,
	|	ПричинаНалогообложения			КАК ПричинаНалогообложения,
	|	КФО								КАК КФО,
	|	СчетРасчетов					КАК СчетРасчетов,
	|	КПССчетРасчетов					КАК КПССчетРасчетов,
	|	СчетДебета						КАК СчетДебета,
	|	КОСГУСчетДебета					КАК КОСГУСчетДебета,
	|	ОбъектНалогообложения			КАК ОбъектНалогообложения,
	|	СтавкаНДС						КАК СтавкаНДС,
	|	ДокументКорректировки			КАК ДокументКорректировки,
	|	МестоРегистрации				КАК МестоРегистрации,
	|	Сторно							КАК Сторно,
	|	
	|	// Дополнительные поля:
	|	СчетФактура.Дата				КАК ДатаСчетаФактуры,
	|	СчетФактура.Контрагент			КАК Контрагент,
	|	СчетФактура.Договор				КАК Договор,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СчетФактура) = ТИП(Документ.ВводНачальныхОстатков) ТОГДА
	|			СчетФактура.Дата
	|		ИНАЧЕ
	|			ОбъектНалогообложения.Дата
	|	КОНЕЦ							КАК ДатаРеализации,
	|	ПричинаНалогообложения В(&ПричиныНалогообложенияЗакладкиРеализация)
	|		И СтавкаНДС <> ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0)				КАК ЭтоЗакладкаРеализация,
	|	ПричинаНалогообложения В(&ПричиныНалогообложенияЗакладкиРеализация0)
	|		И СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0)					КАК ЭтоЗакладкаРеализация0,
	|	ПричинаНалогообложения В(&ПричиныНалогообложенияЗакладкиАвансыВыданные)	КАК ЭтоЗакладкаАвансыВыданные,
	|	ПричинаНалогообложения В(&ПричиныНалогообложенияЗакладкиАвансыВыданныеПредъявленныеКомиссионером)	КАК ЭтоЗакладкаАвансыВыданныеПредъявленныеКомиссионером,
	|	(МестоРегистрации = ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПродаж)
	|		ИЛИ МестоРегистрации = ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.ПустаяСсылка))	КАК ОтразитьВКнигеПродаж,
	|	
	|	// Ресурсы:
	|	СУММА(СуммаБезНДС)				КАК СуммаБезНДС,
	|	СУММА(СуммаНДС)					КАК СуммаНДС,
	|	СУММА(СуммаБезНДС + СуммаНДС)	КАК Всего,
	|	СУММА(ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			СуммаБезНДСВалютная
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)							КАК СуммаБезНДСВалютная,
	|	СУММА(ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			СуммаНДСВалютная
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)							КАК СуммаНДСВалютная,
	|	СУММА(ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			СуммаБезНДСВалютная + СуммаНДСВалютная
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)							КАК ВсегоВалютная
	|ПОМЕСТИТЬ
	|	ВсеОстатки
	|ИЗ
	|	(
	|	// Текущие остатки, включая возможные движения самого документа:
	|	ВЫБРАТЬ
	|		// Все измерения:
	|		Организация,
	|		СчетФактура,
	|		ПричинаНалогообложения,
	|		КФО,
	|		СчетРасчетов,
	|		КПССчетРасчетов,
	|		СчетДебета,
	|		КОСГУСчетДебета,
	|		ОбъектНалогообложения,
	|		СтавкаНДС,
	|		ДокументКорректировки,
	|		МестоРегистрации,
	|		Сторно,
	|		// Ресурсы:
	|		СуммаБезНДСОстаток			КАК СуммаБезНДС,
	|		СуммаНДСОстаток				КАК СуммаНДС,
	|		СуммаБезНДСВалютнаяОстаток	КАК СуммаБезНДСВалютная,
	|		СуммаНДСВалютнаяОстаток		КАК СуммаНДСВалютная
	|	ИЗ
	|		РегистрНакопления.ИсходящийНДС.Остатки(
	|			&ДатаОстатков,
	|			Организация = &Организация
	|			И	ПричинаНалогообложения В(&ПричиныНалогообложения)
	|		)	КАК ИсходящийНДСОстатки
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	// ""Вычитаем"" движения самого документа:
	|	ВЫБРАТЬ
	|		// Все измерения:
	|		Организация,
	|		СчетФактура,
	|		ПричинаНалогообложения,
	|		КФО,
	|		СчетРасчетов,
	|		КПССчетРасчетов,
	|		СчетДебета,
	|		КОСГУСчетДебета,
	|		ОбъектНалогообложения,
	|		СтавкаНДС,
	|		ДокументКорректировки,
	|		МестоРегистрации,
	|		Сторно,
	|		// Ресурсы:
	|		ВЫБОР
	|			КОГДА ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА
	|				-(ИсходящийНДС.СуммаБезНДС)
	|			ИНАЧЕ
	|				(ИсходящийНДС.СуммаБезНДС)
	|		КОНЕЦ									КАК СуммаБезНДС,
	|		ВЫБОР
	|			КОГДА ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА
	|				-(ИсходящийНДС.СуммаНДС)
	|			ИНАЧЕ
	|				(ИсходящийНДС.СуммаНДС)
	|		КОНЕЦ									КАК СуммаНДС,
	|		ВЫБОР
	|			КОГДА ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА
	|				-(ИсходящийНДС.СуммаБезНДСВалютная)
	|			ИНАЧЕ
	|				(ИсходящийНДС.СуммаБезНДСВалютная)
	|		КОНЕЦ									КАК СуммаБезНДСВалютная,
	|		ВЫБОР
	|			КОГДА ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) ТОГДА
	|				-(ИсходящийНДС.СуммаНДСВалютная)
	|			ИНАЧЕ
	|				(ИсходящийНДС.СуммаНДСВалютная)
	|		КОНЕЦ									КАК СуммаНДСВалютная
	|	ИЗ
	|		РегистрНакопления.ИсходящийНДС	КАК ИсходящийНДС
	|	ГДЕ
	|		Регистратор = &ДокументСсылка
	|	)	КАК Остатки
	|ГДЕ
	|	ВЫБОР
	|		КОГДА &ИспользоватьОтборСчетФактура ТОГДА
	|			СчетФактура В (&ОтборСчетФактура)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборОбъектНалогообложения ТОГДА
	|			ОбъектНалогообложения В (&ОтборОбъектНалогообложения)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборКФО ТОГДА
	|			КФО В (&ОтборКФО)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПодразделение ТОГДА
	|			ВЫБОР
	|				КОГДА ТИПЗНАЧЕНИЯ(СчетФактура) = ТИП(Документ.ВводНачальныхОстатков) ТОГДА
	|					СчетФактура.ПодразделениеОрганизации
	|				ИНАЧЕ
	|					СчетФактура.Подразделение
	|			КОНЕЦ В (&ОтборПодразделение)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборИФО ТОГДА
	|			СчетФактура.ИФО В (&ОтборИФО)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	Организация,
	|	СчетФактура,
	|	ПричинаНалогообложения,
	|	КФО,
	|	СчетРасчетов,
	|	КПССчетРасчетов,
	|	СчетДебета,
	|	КОСГУСчетДебета,
	|	ОбъектНалогообложения,
	|	СтавкаНДС,
	|	ДокументКорректировки,
	|	МестоРегистрации,
	|	Сторно,
	|	СчетФактура.Дата,
	|	СчетФактура.Контрагент,
	|	СчетФактура.Договор,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СчетФактура) = ТИП(Документ.ВводНачальныхОстатков) ТОГДА
	|			СчетФактура.Дата
	|		ИНАЧЕ
	|			ОбъектНалогообложения.Дата
	|	КОНЕЦ,
	|	ПричинаНалогообложения В(&ПричиныНалогообложенияЗакладкиРеализация)
	|		И СтавкаНДС <> ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0),
	|	ПричинаНалогообложения В(&ПричиныНалогообложенияЗакладкиРеализация0)
	|		И СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0),
	|	ПричинаНалогообложения В(&ПричиныНалогообложенияЗакладкиАвансыВыданные),
	|	ПричинаНалогообложения В(&ПричиныНалогообложенияЗакладкиАвансыВыданныеПредъявленныеКомиссионером),
	|	(МестоРегистрации = ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.КнигаПродаж)
	|		ИЛИ МестоРегистрации = ЗНАЧЕНИЕ(Перечисление.МестаРегистрацииСчетовФактур.ПустаяСсылка))
	|ИМЕЮЩИЕ
	|	НЕ (СУММА(СуммаБезНДС) = 0 И СУММА(СуммаНДС) = 0)
	|;";
	
	Возврат ЗапросОстатки;
	
КонецФункции

Процедура ДобавитьДвиженияПоТабличнойЧасти(ИмяТЧ, ТаблицаТЧ, ОбщаяТаблицаОстатки, ТаблицыДляДвижений, ЗаполнитьВалютныеСуммы)
	
	ПоискОсновнойРазделКниги			= Новый Структура("ЗаписьДопЛиста", Ложь);
	ПоискДополнительныеЛистыКниги		= Новый Структура("ЗаписьДопЛиста", Истина);
	
	ТаблицаТЧ_ОсновнойРазделКниги		= ТаблицаТЧ.Скопировать(ПоискОсновнойРазделКниги);
	ТаблицаТЧ_ДополнительныеЛистыКниги	= ТаблицаТЧ.Скопировать(ПоискДополнительныеЛистыКниги);
	
	ТаблицаОстатки						= ОбщаяТаблицаОстатки.Скопировать(Новый Структура("ЭтоЗакладка" + ИмяТЧ, Истина));
	ТаблицаОстатки_ДляКнигиПокупок		= ТаблицаОстатки.Скопировать(Новый Структура("ОтразитьВКнигеПродаж", Ложь));
	ТаблицаОстатки_ДляКнигиПродаж		= ТаблицаОстатки.Скопировать(Новый Структура("ОтразитьВКнигеПродаж", Истина));
	
	Если ИмяТЧ = "Реализация" Тогда
		КоллекцияИменКолонокСвязи = Новый Структура("
			|СчетФактура,
			|ОбъектНалогообложения,
			|СчетРасчетов,
			|КПССчетРасчетов,
			|КФО,
			|СчетДебета,
			|СтавкаНДС");
			
		МассивИменКолонокПоказателей = Новый Массив();
		МассивИменКолонокПоказателей.Добавить("СуммаБезНДС");
		МассивИменКолонокПоказателей.Добавить("СуммаНДС");
		Если ЗаполнитьВалютныеСуммы Тогда
			МассивИменКолонокПоказателей.Добавить("СуммаБезНДСВалютная");
			МассивИменКолонокПоказателей.Добавить("СуммаНДСВалютная");
		КонецЕсли;
		
		//ИмяКолонкиДляПереименования = "ДатаПринятияКУчету";
		
	ИначеЕсли ИмяТЧ = "Реализация0" Тогда
		КоллекцияИменКолонокСвязи = Новый Структура("
			|СчетФактура,
			|ОбъектНалогообложения,
			|СчетРасчетов,
			|КПССчетРасчетов,
			|КФО");
			
		МассивИменКолонокПоказателей = Новый Массив();
		МассивИменКолонокПоказателей.Добавить("Всего");
		Если ЗаполнитьВалютныеСуммы Тогда
			МассивИменКолонокПоказателей.Добавить("ВсегоВалютная");
		КонецЕсли;
		
		//ИмяКолонкиДляПереименования = "ДатаЗачета";
		
	ИначеЕсли ИмяТЧ = "АвансыВыданные" Тогда
		КоллекцияИменКолонокСвязи = Новый Структура("
			|СчетФактура,
			|ОбъектНалогообложения,
			|СчетРасчетов,
			|КПССчетРасчетов,
			|КФО,
			|СчетДебета,
			|СтавкаНДС");
			
		МассивИменКолонокПоказателей = Новый Массив();
		МассивИменКолонокПоказателей.Добавить("СуммаНДС");
		МассивИменКолонокПоказателей.Добавить("Всего");
		Если ЗаполнитьВалютныеСуммы Тогда
			МассивИменКолонокПоказателей.Добавить("СуммаНДСВалютная");
			МассивИменКолонокПоказателей.Добавить("ВсегоВалютная");
		КонецЕсли;
		
	ИначеЕсли ИмяТЧ = "АвансыВыданныеПредъявленныеКомиссионером" Тогда
		КоллекцияИменКолонокСвязи = Новый Структура("
			|СчетФактура,
			|ОбъектНалогообложения,
			|СчетРасчетов,
			|КПССчетРасчетов,
			|КФО,
			|СчетДебета,
			|СтавкаНДС");
			
		МассивИменКолонокПоказателей = Новый Массив();
		МассивИменКолонокПоказателей.Добавить("СуммаНДС");
		МассивИменКолонокПоказателей.Добавить("Всего");
		Если ЗаполнитьВалютныеСуммы Тогда
			МассивИменКолонокПоказателей.Добавить("СуммаНДСВалютная");
			МассивИменКолонокПоказателей.Добавить("ВсегоВалютная");
		КонецЕсли;
		
	КонецЕсли;
	
	//---
	// ИсходящийНДС
	//---
	ТаблицаДвижений = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
		ТаблицаТЧ,
		ТаблицаОстатки,
		КоллекцияИменКолонокСвязи,
		МассивИменКолонокПоказателей,
		"СписанияВТаблице2ВРазмереТаблицы1")["СписанияВТаблице2ВРазмереТаблицы1"];
	Если ИмяТЧ = "Реализация0" ИЛИ ИмяТЧ = "АвансыВыданные" ИЛИ ИмяТЧ = "АвансыВыданныеПредъявленныеКомиссионером" Тогда
		УчетНДС.РассчитатьКолонкуСуммаБезНДС(ТаблицаДвижений);
	КонецЕсли;
	УчетНДС.ДобавитьВТаблицу(ТаблицыДляДвижений["ИсходящийНДС"], ТаблицаДвижений);
	
	//---
	// КнигаПокупок
	//---
	Если ТаблицаТЧ_ОсновнойРазделКниги.Количество() > 0 Тогда
		ТаблицаДвижений = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
			ТаблицаТЧ_ОсновнойРазделКниги,
			ТаблицаОстатки_ДляКнигиПокупок,
			КоллекцияИменКолонокСвязи,
			МассивИменКолонокПоказателей,
			"СписанияВОбеихТаблицахВРазмереСоответствия")["СписанияВОбеихТаблицахВРазмереСоответствия"];
		Если ИмяТЧ = "Реализация0" ИЛИ ИмяТЧ = "АвансыВыданные" ИЛИ ИмяТЧ = "АвансыВыданныеПредъявленныеКомиссионером" Тогда
			УчетНДС.РассчитатьКолонкуСуммаБезНДС(ТаблицаДвижений);
		КонецЕсли;
		// Заменяем имя колонки ТЧ, т.к. в регистрах книги покупок она называется по-другому
		Если ИмяТЧ = "АвансыВыданные" Тогда
			ТаблицаДвижений.Колонки["ДатаЗачета"].Имя = "ДатаСобытия";
		КонецЕсли;
		Если ИмяТЧ = "АвансыВыданныеПредъявленныеКомиссионером" Тогда
			ТаблицаДвижений.Колонки["ДатаЗачета"].Имя = "ДатаСобытия";
		КонецЕсли;
			
		УчетНДС.ДобавитьВТаблицу(ТаблицыДляДвижений["КнигаПокупок"], ТаблицаДвижений);
	КонецЕсли;
	
	//---
	// ДополнительныеЛистыКнигиПокупок
	//---
	Если ТаблицаТЧ_ДополнительныеЛистыКниги.Количество() > 0 Тогда
		ТаблицаДвижений = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
			ТаблицаТЧ_ДополнительныеЛистыКниги,
			ТаблицаОстатки_ДляКнигиПокупок,
			КоллекцияИменКолонокСвязи,
			МассивИменКолонокПоказателей,
			"СписанияВОбеихТаблицахВРазмереСоответствия")["СписанияВОбеихТаблицахВРазмереСоответствия"];
		Если ИмяТЧ = "Реализация0" ИЛИ ИмяТЧ = "АвансыВыданные" ИЛИ ИмяТЧ = "АвансыВыданныеПредъявленныеКомиссионером" Тогда
			УчетНДС.РассчитатьКолонкуСуммаБезНДС(ТаблицаДвижений);
		КонецЕсли;
		// Заменяем имя колонки ТЧ, т.к. в регистрах книги покупок она называется по-другому
		Если ИмяТЧ = "АвансыВыданные" Тогда
			ТаблицаДвижений.Колонки["ДатаЗачета"].Имя = "ДатаСобытия";
		КонецЕсли;
		Если ИмяТЧ = "АвансыВыданныеПредъявленныеКомиссионером" Тогда
			ТаблицаДвижений.Колонки["ДатаЗачета"].Имя = "ДатаСобытия";
		КонецЕсли;
		
		УчетНДС.ДобавитьВТаблицу(ТаблицыДляДвижений["ДополнительныеЛистыКнигиПокупок"], ТаблицаДвижений);
	КонецЕсли;
	
	//---
	// КнигаПродаж
	//---
	Если ТаблицаТЧ_ОсновнойРазделКниги.Количество() > 0 Тогда
		ТаблицаДвижений = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
			ТаблицаТЧ_ОсновнойРазделКниги,
			ТаблицаОстатки_ДляКнигиПродаж,
			КоллекцияИменКолонокСвязи,
			МассивИменКолонокПоказателей,
			"СписанияВОбеихТаблицахВРазмереСоответствия")["СписанияВОбеихТаблицахВРазмереСоответствия"];
		Если ИмяТЧ = "Реализация0" ИЛИ ИмяТЧ = "АвансыВыданные" ИЛИ ИмяТЧ = "АвансыВыданныеПредъявленныеКомиссионером" Тогда
			УчетНДС.РассчитатьКолонкуСуммаБезНДС(ТаблицаДвижений);
		КонецЕсли;
		УчетНДС.ДобавитьВТаблицу(ТаблицыДляДвижений["КнигаПродаж"], ТаблицаДвижений);
	КонецЕсли;
	
	//---
	// ДополнительныеЛистыКнигиПродаж
	//---
	Если ТаблицаТЧ_ДополнительныеЛистыКниги.Количество() > 0 Тогда
		ТаблицаДвижений = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
			ТаблицаТЧ_ДополнительныеЛистыКниги,
			ТаблицаОстатки_ДляКнигиПродаж,
			КоллекцияИменКолонокСвязи,
			МассивИменКолонокПоказателей,
			"СписанияВОбеихТаблицахВРазмереСоответствия")["СписанияВОбеихТаблицахВРазмереСоответствия"];
		Если ИмяТЧ = "Реализация0" ИЛИ ИмяТЧ = "АвансыВыданные" ИЛИ ИмяТЧ = "АвансыВыданныеПредъявленныеКомиссионером" Тогда
			УчетНДС.РассчитатьКолонкуСуммаБезНДС(ТаблицаДвижений);
		КонецЕсли;
		УчетНДС.ДобавитьВТаблицу(ТаблицыДляДвижений["ДополнительныеЛистыКнигиПродаж"], ТаблицаДвижений);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьСписокСчетовФактур(СписокСчетовФактур, Таблица)
	
	ИмяКолонки = "СчетФактура";
	
	ВремТаблица = Таблица.Скопировать(, ИмяКолонки);
	ВремТаблица.Свернуть(ИмяКолонки);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокСчетовФактур, ВремТаблица.ВыгрузитьКолонку(ИмяКолонки));
	
КонецПроцедуры

