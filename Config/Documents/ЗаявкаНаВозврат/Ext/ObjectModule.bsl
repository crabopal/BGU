#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
	
// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	GUID = Строка(Новый УникальныйИдентификатор());
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КассовоеПоступление") Тогда
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	КассовоеПоступление.ВалютаДокумента 						 КАК ВалютаДокумента,
		|	КассовоеПоступление.Курс            						 КАК Курс,
		|	КассовоеПоступление.Кратность       						 КАК Кратность,
		|	КассовоеПоступление.ВидПервичногоДокумента 					 КАК ДокументОснованиеВид,
		|	КассовоеПоступление.ДатаПервичногоДокумента 				 КАК ДокументОснованиеДата,
		|	КассовоеПоступление.ИдентификаторПлатежа 					 КАК ИдентификаторПлатежа,
		|	КассовоеПоступление.ИФО 									 КАК ИФО,
		|	КассовоеПоступление.Контрагент 								 КАК Контрагент,
		|	КассовоеПоступление.ЛицевойСчет 							 КАК ЛицевойСчет,
		|	КассовоеПоступление.НалогСборПлатеж 						 КАК НалогСборПлатеж,
		|	КассовоеПоступление.НомерПервичногоДокумента 				 КАК ДокументОснованиеНомер,
		|	КассовоеПоступление.Организация 							 КАК Организация,
		|	КассовоеПоступление.Подразделение 							 КАК Подразделение,
		|	КассовоеПоступление.СчетКонтрагента 						 КАК СчетКонтрагента,
		|	ЕСТЬNULL(СостояниеПлатежноРасчетныхДокументов.GUIDКО, """")  КАК GUIDРасчетногоДокумента,
		|	КассовоеПоступлениеРасшифровкаПлатежа.ДопКлассификация 		 КАК ДопКлассификация,
		|	КассовоеПоступлениеРасшифровкаПлатежа.ИсточникСредств 		 КАК ИсточникСредств,
		|	КассовоеПоступлениеРасшифровкаПлатежа.КБКНазначениеПлатежа 	 КАК КБКНазначениеПлатежа,
		|	КассовоеПоступлениеРасшифровкаПлатежа.КодМероприятия 		 КАК КодМероприятия,
		|	КассовоеПоступлениеРасшифровкаПлатежа.КодЦели 				 КАК КодЦели,
		|	КассовоеПоступлениеРасшифровкаПлатежа.КОСГУНазначениеПлатежа КАК КОСГУНазначениеПлатежа,
		|	КассовоеПоступлениеРасшифровкаПлатежа.КФО 					 КАК КФО,
		|	СУММА(КассовоеПоступлениеРасшифровкаПлатежа.Сумма)           КАК СуммаДокумента,
		|	СУММА(КассовоеПоступлениеРасшифровкаПлатежа.СуммаВал)        КАК СуммаДокументаВВалюте,
		|	КассовоеПоступлениеРасшифровкаПлатежа.Договор 				 КАК Договор
		|ИЗ
		|	Документ.КассовоеПоступление КАК КассовоеПоступление
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
		|		ПО КассовоеПоступление.Ссылка = СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КассовоеПоступление.РасшифровкаПлатежа КАК КассовоеПоступлениеРасшифровкаПлатежа
		|		ПО КассовоеПоступление.Ссылка = КассовоеПоступлениеРасшифровкаПлатежа.Ссылка
		|ГДЕ
		|	КассовоеПоступление.Проведен = ИСТИНА
		|	И КассовоеПоступление.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	КассовоеПоступление.ВалютаДокумента,
		|	КассовоеПоступление.Курс,
		|	КассовоеПоступление.Кратность,
		|	КассовоеПоступление.ВидПервичногоДокумента,
		|	КассовоеПоступление.ДатаПервичногоДокумента,
		|	КассовоеПоступление.ИдентификаторПлатежа,
		|	КассовоеПоступление.ИФО,
		|	КассовоеПоступление.Контрагент,
		|	КассовоеПоступление.ЛицевойСчет,
		|	КассовоеПоступление.НалогСборПлатеж,
		|	КассовоеПоступление.НомерПервичногоДокумента,
		|	КассовоеПоступление.Организация,
		|	КассовоеПоступление.Подразделение,
		|	КассовоеПоступление.СчетКонтрагента,
		|	ЕСТЬNULL(СостояниеПлатежноРасчетныхДокументов.GUIDКО, """"),
		|	КассовоеПоступлениеРасшифровкаПлатежа.ДопКлассификация,
		|	КассовоеПоступлениеРасшифровкаПлатежа.ИсточникСредств,
		|	КассовоеПоступлениеРасшифровкаПлатежа.КБКНазначениеПлатежа,
		|	КассовоеПоступлениеРасшифровкаПлатежа.КодМероприятия,
		|	КассовоеПоступлениеРасшифровкаПлатежа.КодЦели,
		|	КассовоеПоступлениеРасшифровкаПлатежа.КОСГУНазначениеПлатежа,
		|	КассовоеПоступлениеРасшифровкаПлатежа.КФО,
		|	КассовоеПоступлениеРасшифровкаПлатежа.Договор");
		
		Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru = 'Ввод на основании не выполнен. Возможно документ не проведен.'");
			ВызватьИсключение ТекстСообщения;
			Возврат;
		КонецЕсли;
		
		Выборка.Следующий();
		
		ДанныеШапки = Новый Структура("
		|ВалютаДокумента,
		|Курс,
		|Кратность,
		|ДокументОснованиеВид,
		|ДокументОснованиеДата,
		|ДокументОснованиеНомер,
		|ИФО,
		|Контрагент,
		|СчетКонтрагента,
		|ЛицевойСчет,
		|Организация,
		|Подразделение,
		|GUIDРасчетногоДокумента");
		
		ЗаполнитьЗначенияСвойств(ДанныеШапки, Выборка);
		
		ДанныеПлатежа = Новый Структура("
		|Договор,
		|ДопКлассификация,
		|ИсточникСредств,
		|КБКНазначениеПлатежа,
		|КодМероприятия,
		|КодЦели,
		|КОСГУНазначениеПлатежа,	
		|СуммаДокумента,
		|СуммаДокументаВВалюте,
		|КФО");
		
		Если Выборка.Количество() = 1 Тогда
			ЗаполнитьЗначенияСвойств(ДанныеПлатежа, Выборка);
		Конецесли;
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	РеквизитыЛицевыхСчетов.Ссылка КАК Ссылка,
		|	РеквизитыЛицевыхСчетов.КассовыйОрган КАК КассовыйОрган
		|ИЗ
		|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
		|ГДЕ
		|	РеквизитыЛицевыхСчетов.Владелец = &Владелец");
		
		
		Запрос.УстановитьПараметр("Владелец", ДанныеШапки.ЛицевойСчет);
		
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ДанныеШапки.Вставить("РеквизитыЛицевогоСчета", Выборка.Ссылка);
			ДанныеШапки.Вставить("ОрганКазначейства", Выборка.КассовыйОрган);
		КонецЕсли;	
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеШапки);
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеПлатежа);
		
		ДокументОснование = ДанныеЗаполнения;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Отказ = ПлатежноРасчетныеДокументы.ВыполнитьДвиженияПлатежноРасчетногоДокумента(ЭтотОбъект);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
		
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПлатежноРасчетныеДокументы.ПриЗаписиНаСервереУстановкаСтатуса(Отказ, ЭтотОбъект);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	// Очистим поле "Оплатить до", т.к. данный платеж, скорее всего, уже был оплачен в документе, который копируем.
	ОплатитьДо = Дата("00010101");
	
	// Очистим документ - основание, объект копирования ранее мог быть введен на основании
	ДокументОснование = Неопределено;

	GUID = Строка(Новый УникальныйИдентификатор());
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли