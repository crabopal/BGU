#Область СлужебныеПроцедурыИФункции

//  Возвращает сведения о записи в регистре сведенеий "СостояниеПлатежноРасчетныхДокументов"
//    Входящие параметры: Ссылка - тип ссылка на документ "Уведомление об уточнении операции клиента"
//    Исходящие параметры: 
Функция ПолучитьСостояниеДокумента(Ссылка) экспорт
	СтруктураРеквизитов = Новый Структура;
	ПоляВыборки = "";
	//  Струкутра реквизитов динамическая, т.к. со временем может понадобится новый ресурс в регистр
	//  что-бы его не забыть будем каждый раз перебирать ресурсы регистра
	Для каждого Ресурс из Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Ресурсы цикл
		СтруктураРеквизитов.Вставить(Ресурс.Имя);
		ПоляВыборки = ПоляВыборки + "
		|	Состояние." + Ресурс.Имя + " КАК " + Ресурс.Имя + ", "
	КонецЦикла;	
	//  Добавка ввиде реквизита "ПервичныйОбразИРеквизиты"
	СтруктураРеквизитов.Вставить("ПервичныйОбразИРеквизиты");		
	ПоляВыборки = ПоляВыборки + "
	|	Состояние.ПервичныйОбразИРеквизиты КАК ПервичныйОбразИРеквизиты ";
	
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.ЗаявкаНаВозврат") тогда
		Возврат СтруктураРеквизитов;
	КонецЕсли;	
		
	ТекстЗапроса = "ВЫБРАТЬ " + ПоляВыборки + "
					|ИЗ	
					|	РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК Состояние
					|ГДЕ 
					|	Состояние.ПлатежноРасчетныйДокумент = &Ссылка";
						
	Запрос = Новый Запрос(ТекстЗапроса);				
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
		
	Для каждого КлючЗначение из СтруктураРеквизитов Цикл
		ТекРеквизит = КлючЗначение.Ключ;
		СтруктураРеквизитов[ТекРеквизит] = Выборка[ТекРеквизит];
	КонецЦикла;	
		
	Возврат СтруктураРеквизитов;
КонецФункции	

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗаявкаНаВозврат";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0531803_21н";
	КомандаПечати.Представление		= НСтр("ru = 'Заявка на возврат (ф. 0531803)'");
	КомандаПечати.Порядок			= 1;
		
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗаявкаНаВозврат";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0531803_16н";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Заявка на возврат (пр. 16н)'");
	КомандаПечати.Порядок			= 100;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗаявкаНаВозврат";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0531803";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Заявка на возврат (пр. 8н)'");
	КомандаПечати.Порядок			= 200;

	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "РасчетныйДокументБезККТ", 5);
    	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531803") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_Форма0531803",
			"Заявка на возврат",
			ПечатьЗаявкаНаВозврат(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531803_16н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_Форма0531803_16н",
			"Заявка на возврат (в ред. приказа 16н)",
			ПечатьЗаявкаНаВозврат16н(МассивОбъектов, ОбъектыПечати, "_16н"));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531803_21н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_Форма0531803_21н",
			"Заявка на возврат (в ред. приказа 21н)",
			ПечатьЗаявкаНаВозврат16н(МассивОбъектов, ОбъектыПечати, "_21н"));
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, Область, ИсточникПараметров, ПоляПодвала, Шапка = Неопределено, ШапкаРаздела = Неопределено)  
		
	ВыводимыеОбласти = Новый Массив();
	ВыводимыеОбласти.Добавить(Макет.ПолучитьОбласть(Область));
    ВыводимыеОбласти.Добавить(Макет.ПолучитьОбласть("Подвал"));
	ВыводимыеОбласти[0].Параметры.Заполнить(ИсточникПараметров);
	ВыводимыеОбласти[1].Параметры.Заполнить(ПоляПодвала);

	Если НЕ ТабДокумент.ПроверитьВывод(ВыводимыеОбласти) Тогда
		ТабДокумент.Вывести(ВыводимыеОбласти[1]);
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		Если НЕ ШапкаРаздела = Неопределено Тогда
			 ТабДокумент.Вывести(ШапкаРаздела);	
		КонецЕсли;	
		Если НЕ Шапка = Неопределено Тогда
			ТабДокумент.Вывести(Макет.ПолучитьОбласть(Шапка));	
		КонецЕсли;	
	КонецЕсли;
	ТабДокумент.Вывести(ВыводимыеОбласти[0]);
	
КонецПроцедуры

// Функция формирует табличный документ Заявка на возврат (ф. 0531803)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция ПечатьЗаявкаНаВозврат(МассивОбъектов, ОбъектыПечати)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы 					= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб 						= Истина; 
	ТабДокумент.ВерхнийКолонтитул.Выводить 			= Истина;
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница = 2; 
	ТабДокумент.НижнийКолонтитул.Выводить 			= Истина;
	ТабДокумент.ПолеСверху 							= 10;
	ТабДокумент.ПолеСнизу 							= 12;
	ТабДокумент.РазмерКолонтитулаСверху 			= 10;
	ТабДокумент.РазмерКолонтитулаСнизу 				= 12;
	ТабДокумент.ИмяПараметровПечати 				= "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаявкаНаВозврат_ЗаявкаНаВозврат";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявкаНаВозврат.ПФ_MXL_Форма0531803");
	
	ДанныеДляПечатиМассив = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовЗаявкаНаВозврат(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДанныеДляПечати Из ДанныеДляПечатиМассив Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ОбластьВывода = Макет.ПолучитьОбласть("Заголовок");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		
		ТабДокумент.Вывести(ОбластьВывода);
		
		// дальше надо смотреть, умещается ли на страницу
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_1", ДанныеДляПечати, ДанныеДляПечати); 
		
		ШапкаРаздела 			= Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "1");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		Если ДанныеДляПечати.ВыводитьРаздел_2 Тогда
			ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_2", ДанныеДляПечати, ДанныеДляПечати, ,ШапкаРаздела); 
		КонецЕсли;
		
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ШапкаРаздела 			= Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "2");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ШапкаРаздела);
		
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_3", ДанныеДляПечати, ДанныеДляПечати, ,ШапкаРаздела); 
		
		// последняя подпись ответственного исполнителя 
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("ОтметкаФК"));
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДляПечати.Ссылка);
		
	КонецЦикла;	
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция формирует табличный документ Заявка на возврат (ф. 0531803) (в ред. приказа 16н)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция ПечатьЗаявкаНаВозврат16н(МассивОбъектов, ОбъектыПечати, Постфикс)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы 					= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб 						= Истина; 
	ТабДокумент.ВерхнийКолонтитул.Выводить 			= Истина;
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница = 2; 
	ТабДокумент.НижнийКолонтитул.Выводить 			= Истина;
	ТабДокумент.ПолеСверху 							= 10;
	ТабДокумент.ПолеСнизу 							= 12;
	ТабДокумент.РазмерКолонтитулаСверху 			= 10;
	ТабДокумент.РазмерКолонтитулаСнизу 				= 12;
	ТабДокумент.ИмяПараметровПечати 				= "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаявкаНаВозврат_ЗаявкаНаВозврат";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявкаНаВозврат.ПФ_MXL_Форма0531803" + Постфикс);
	
	ДанныеДляПечатиМассив = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовЗаявкаНаВозврат(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДанныеДляПечати Из ДанныеДляПечатиМассив Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ОбластьВывода = Макет.ПолучитьОбласть("Заголовок");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		
		ТабДокумент.Вывести(ОбластьВывода);
		
		// дальше надо смотреть, умещается ли на страницу
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_1", ДанныеДляПечати, ДанныеДляПечати); 
		
		ШапкаРаздела 			= Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "1");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		
		Если ДанныеДляПечати.ВыводитьРаздел_2 Или ДанныеДляПечати.ВыводитьРаздел_2_Таб Тогда
			
			ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_2_Шапка", ДанныеДляПечати, ДанныеДляПечати, ,ШапкаРаздела);
			
			Если НЕ ДанныеДляПечати.ВыводитьРаздел_2_Таб Тогда
				ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_2_Строка", ДанныеДляПечати, ДанныеДляПечати, "Раздел_2_Шапка" ,ШапкаРаздела); 
			Иначе
				Для Каждого СтрДок ИЗ ДанныеДляПечати.ДокументыОснования Цикл
					ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_2_Строка", СтрДок, ДанныеДляПечати, "Раздел_2_Шапка" ,ШапкаРаздела);	
				КонецЦикла;
			КонецЕсли;	
			
			ТабДокумент.Вывести(Макет.ПолучитьОбласть("Раздел_2_Подвал"));
			
		КонецЕсли;
		
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ШапкаРаздела 			= Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "2");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ШапкаРаздела);
		
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_3", ДанныеДляПечати, ДанныеДляПечати, ,ШапкаРаздела); 
		
		// последняя подпись ответственного исполнителя 
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("ОтметкаФК"));
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДляПечати.Ссылка);
		
	КонецЦикла;	
	
	Возврат ТабДокумент;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
