#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРеквизитыПлатежногоДокумента

&НаКлиенте
Процедура РеквизитыПлатежногоДокументаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока тогда
		Элементы.РеквизитыПлатежногоДокумента.ТекущиеДанные.КлючСтроки = Новый УникальныйИдентификатор;
		ОтборДляИзмененныеРеквизиты(Элементы.РеквизитыПлатежногоДокумента.ТекущиеДанные.КлючСтроки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыПлатежногоДокументаПередУдалением(Элемент, Отказ)
	ПараметрыОтбора = Новый Структура("КлючСтроки", Элемент.ТекущиеДанные.КлючСтроки); 	
	МассивКУдалению = Объект.ИзмененныеРеквизиты.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
		Объект.ИзмененныеРеквизиты.Удалить(СтрокаКУдалению);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыПлатежногоДокументаПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено тогда
		ОтборДляИзмененныеРеквизиты(Элемент.ТекущиеДанные.КлючСтроки);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИзмененныеРеквизиты


&НаКлиенте
Процедура ИзмененныеРеквизитыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока и Элементы.РеквизитыПлатежногоДокумента.ТекущиеДанные <> Неопределено тогда
		Элементы.ИзмененныеРеквизиты.ТекущиеДанные.КлючСтроки = Элементы.РеквизитыПлатежногоДокумента.ТекущиеДанные.КлючСтроки;		
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ИзмененныеРеквизитыКБКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ИзмененныеРеквизиты.ТекущиеДанные;

	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													ТекущиеДанные.КПС, 
													Объект.Организация,
													Объект.ИФО,
													,
													,
													Объект.Дата);
	
КонецПроцедуры

