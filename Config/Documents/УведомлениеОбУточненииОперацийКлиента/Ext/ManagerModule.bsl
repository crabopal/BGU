Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531852") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531852",
			"Уведомление об уточнении операций клиента", ПечатьУведомления(МассивОбъектов, ОбъектыПечати, ""));
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531852_21н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531852_21н",
			"Уведомление об уточнении операций клиента", ПечатьУведомления(МассивОбъектов, ОбъектыПечати, "_21н"));
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, Область, ИсточникПараметров, ПоляПодвала, Шапка = Неопределено, ШапкаРаздела = Неопределено, ЛокальныйПодвал = Неопределено)  
		
	ВыводимыеОбласти = Новый Массив();
	ВыводимыеОбласти.Добавить(Макет.ПолучитьОбласть(Область));
	ВыводимыеОбласти[0].Параметры.Заполнить(ИсточникПараметров);
	Если НЕ ЛокальныйПодвал = Неопределено Тогда
		ВыводимыеОбласти.Добавить(ЛокальныйПодвал);
	КонецЕсли;
	
	Попытка
		Если НЕ ТабДокумент.ПроверитьВывод(ВыводимыеОбласти) Тогда
			Если НЕ ЛокальныйПодвал = Неопределено Тогда
				ТабДокумент.Вывести(ЛокальныйПодвал);
			КонецЕсли;
			
			//ТабДокумент.Вывести(ВыводимыеОбласти[1]);
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			Если НЕ ШапкаРаздела = Неопределено Тогда
				ТабДокумент.Вывести(ШапкаРаздела);	
			КонецЕсли;	
			Если НЕ Шапка = Неопределено Тогда
				ТабДокумент.Вывести(Макет.ПолучитьОбласть(Шапка));	
			КонецЕсли;	
		КонецЕсли;
		ТабДокумент.Вывести(ВыводимыеОбласти[0]);
	Исключение
//		Сообщить("В системе не установлено ни одного принтера.");
	КонецПопытки;

КонецПроцедуры

// Функция формирует табличный документ Уведомление об уточнении вида и принадлежности платежа (ф.0531809)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция ПечатьУведомления(МассивОбъектов, ОбъектыПечати, Постфикс)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы 					= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб 						= Истина; 
    ТабДокумент.ВерхнийКолонтитул.Выводить 			= Истина;
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница = 2; 
	ТабДокумент.НижнийКолонтитул.Выводить 			= Истина;
	ТабДокумент.ПолеСверху 							= 10;
	ТабДокумент.ПолеСнизу 							= 12;
    ТабДокумент.РазмерКолонтитулаСверху 			= 0;
	ТабДокумент.РазмерКолонтитулаСнизу 				= 12;
    ТабДокумент.ИмяПараметровПечати 				= "ПАРАМЕТРЫ_ПЕЧАТИ_Уведомление0531852_Уведомление0531852";

	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.УведомлениеОбУточненииОперацийКлиента.ПФ_MXL_Форма0531852" + Постфикс);
	
	ДанныеДляПечатиМассив = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовУведомлениеОбУточненииОперацийКлиента(МассивОбъектов);	
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДанныеДляПечати Из ДанныеДляПечатиМассив Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ОблЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		ОблЗаголовок.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОблЗаголовок);
		
		// дальше надо смотреть, умещается ли на страницу
		// Раздел 1
		ШапкаРаздела = Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "1");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел1_Ш", Новый Структура(), ДанныеДляПечати, ,ШапкаРаздела); 
		
		ЛокальныйПодвал = Макет.ПолучитьОбласть("Раздел1_П");
		
		Для Каждого СтрВыборка Из ДанныеДляПечати.РеквизитыПлатежногоДокумента Цикл 
			ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел1_С", СтрВыборка, ДанныеДляПечати, "Раздел1_Ш", ШапкаРаздела, ЛокальныйПодвал);  
		КонецЦикла;
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Раздел1_П"));
		
		// Раздел 2
		//ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ШапкаРаздела = Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "2");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Раздел2_Ш"));
		ЛокальныйПодвал = Макет.ПолучитьОбласть("Раздел2_П");
		
		Для Каждого СтрВыборка Из ДанныеДляПечати.ИзмененныеРеквизиты Цикл
			ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел2_С", СтрВыборка, ДанныеДляПечати, "Раздел2_Ш", ШапкаРаздела, ЛокальныйПодвал);  
		КонецЦикла;
		
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Раздел2_П"));
		ОблПодвал = Макет.ПолучитьОбласть("Подвал");
		ОблПодвал.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОблПодвал);
		
		Если Постфикс = "_21н" Тогда
			ОблПодвал = Макет.ПолучитьОбласть("Отметки");
			ТабДокумент.Вывести(ОблПодвал);
		КонецЕсли;
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДляПечати.Ссылка);
		
	КонецЦикла;	
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура УдалениеСтрокСоответвуюшихОснованию(Основание, Объект) 
	ПараметрыОтбора = Новый Структура("ЗаявкаНаКассовыйРасход", Основание); 	
	МассивКУдалению = Объект.РеквизитыПлатежногоДокумента.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
		ПараметрыОтбора 	= Новый Структура("КлючСтроки", СтрокаКУдалению.КлючСтроки); 	
		МассивКУдалениюИзм  = Объект.ИзмененныеРеквизиты.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаКУдалениюИзм Из МассивКУдалениюИзм Цикл
			Объект.ИзмененныеРеквизиты.Удалить(СтрокаКУдалениюИзм);
		КонецЦикла;	
		Объект.РеквизитыПлатежногоДокумента.Удалить(СтрокаКУдалению);
	КонецЦикла;	
КонецПроцедуры

Процедура ЗаполнитьШапкуДокумента(Основание, Объект, Дополнительно = "")
	РеквизитыШапки = Новый Структура("Организация,ЛицевойСчет,ИФО,РеквизитыЛицевогоСчета,Подразделение"+Дополнительно);
	Для каждого КлючЗначение из РеквизитыШапки цикл
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта(КлючЗначение.Ключ, Основание.Метаданные()) Тогда
			Объект[КлючЗначение.Ключ] = ?(ЗначениеЗаполнено(Объект[КлючЗначение.Ключ]),Объект[КлючЗначение.Ключ],Основание[КлючЗначение.Ключ]);
		КонецЕсли;
	КонецЦикла;
	Объект.ОрганКазначейства = Объект.РеквизитыЛицевогоСчета.КассовыйОрган;
КонецПроцедуры	

Функция ЗаполнитьНаОснованииРаспоряженияОПеречисленииНаКартыМир(Основание, Объект, ОписаниеОшибки)
	
	УдалениеСтрокСоответвуюшихОснованию(Основание, Объект);	
	ЗаполнитьШапкуДокумента(Основание, Объект, ", ПерваяПодпись, ВтораяПодпись, ВтораяПодписьПечататьДолжность, ВтораяПодписьДолжность");
	
	Объект.ЗапросНаВыяснениеПринадлежностиПлатежа 	= "";
	Объект.НомерЗапроса 							= "";
	Объект.ДатаЗапроса 								= "";    
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Основание", Основание);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.ИдентификаторСтроки КАК ИдентификаторСтроки, 
	|	ВЫБОР
	|		КОГДА РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.Ссылка.СотрудникКонтрагент = 0
	|			ТОГДА  РаспоряжениеОПеречисленииНаКартыМирСостав.Сотрудник.Контрагент.Наименование
	|		ИНАЧЕ РаспоряжениеОПеречисленииНаКартыМирСостав.Контрагент.Наименование
	|	КОНЕЦ КАК НаименованиеКонтрагента,   
	|	ВЫБОР
	|		КОГДА РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.Ссылка.СотрудникКонтрагент = 0
	|			ТОГДА  РаспоряжениеОПеречисленииНаКартыМирСостав.Сотрудник.Контрагент.ИНН
	|		ИНАЧЕ РаспоряжениеОПеречисленииНаКартыМирСостав.Контрагент.ИНН
	|	КОНЕЦ КАК ИННКонтрагента,
    |	ВЫБОР
	|		КОГДА РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.Ссылка.СотрудникКонтрагент = 0
	|			ТОГДА  РаспоряжениеОПеречисленииНаКартыМирСостав.Сотрудник.Контрагент.КПП
	|		ИНАЧЕ РаспоряжениеОПеречисленииНаКартыМирСостав.Контрагент.КПП
	|	КОНЕЦ КАК КППКонтрагента,
	|	ВЫБОР
	|		КОГДА РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.Ссылка.ЛицевойСчет.НеВыводитьКБК
	|			ТОГДА """"
	|		КОГДА РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КПС.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.АУИБУ)
	|			ТОГДА ВЫБОР
	|					КОГДА РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.Ссылка.ЛицевойСчет.НеВыводитьРазделПодраздел
	|						ТОГДА ""0000""
	|					ИНАЧЕ ПОДСТРОКА(РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КПС.Код, 1, 4)
	|				КОНЕЦ
	|		ИНАЧЕ РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КПС.Код
	|	КОНЕЦ КАК КодКПС,
	|	ВЫБОР
	|		КОГДА РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КПС.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.АУИБУ) И НЕ РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.Ссылка.ЛицевойСчет.НеВыводитьКБК 
	|			ТОГДА ВЫБОР
	|					КОГДА РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.Ссылка.ЛицевойСчет.НеВыводитьАналитическийКод
	|                    	ТОГДА ""0000000000"" + ПОДСТРОКА(РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КПС.Код, 15, 3)
	|                   ИНАЧЕ ПОДСТРОКА(РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КПС.Код, 5, 13)
	|				КОНЕЦ
	|		ИНАЧЕ """"	
	|	КОНЕЦ КАК КодАналитикиКПС,
	|	""000"" + РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КПС.Код КАК КодБК,
	|	РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.Сумма КАК Сумма,
	|	РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КодЦели КАК КодЦели   
	|ПОМЕСТИТЬ РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа
	|ИЗ
	|	Документ.РаспоряжениеОПеречисленииНаКартыМир.РасшифровкаПлатежа КАК РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа
	|   ЛЕВОЕ СОЕДИНЕНИЕ Документ.РаспоряжениеОПеречисленииНаКартыМир.Состав КАК РаспоряжениеОПеречисленииНаКартыМирСостав
	|   ПО РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.ИдентификаторСтроки = РаспоряжениеОПеречисленииНаКартыМирСостав.ИдентификаторСтроки
	|ГДЕ
	|	РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.Ссылка = &Основание     
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ 
	|	РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.ИдентификаторСтроки,  
	|	РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.НаименованиеКонтрагента,
	|	РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.ИННКонтрагента,
	|	РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КППКонтрагента,
	|	""000"" + РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КодКПС + РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КодАналитикиКПС КАК КодБК,  
    |	СУММА(РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.Сумма) КАК Сумма,
	|	РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КодЦели КАК КодЦели  
	|
	|СГРУППИРОВАТЬ ПО
	|	РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.ИдентификаторСтроки, 
	|	РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.НаименованиеКонтрагента,
	|	РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.ИННКонтрагента,
	|	РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КППКонтрагента,
	|	""000"" + РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КодКПС + РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КодАналитикиКПС,
	|	РаспоряжениеОПеречисленииНаКартыМирРасшифровкаПлатежа.КодЦели";
	
	МассивРезультатов  = Запрос.ВыполнитьПакет();
	РасшифровкаПлатежа = МассивРезультатов[1].Выгрузить();
	
	Для Каждого СтрДок Из РасшифровкаПлатежа Цикл
		НоваяСтрока = Объект.РеквизитыПлатежногоДокумента.Добавить();
		НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор; 
		
		НоваяСтрока.НаименованиеПлатежногоДокумента = "Распоряжение о перечислении на карты МИР";
		НоваяСтрока.НомерПлатежногоДокумента		= ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Основание,Основание.Номер);
		НоваяСтрока.ДатаПлатежногоДокумента			= Основание.Дата;
		НоваяСтрока.ИННПолучателя			 		= СтрДок.ИННКонтрагента;
		НоваяСтрока.КПППолучателя			 		= СтрДок.КППКонтрагента;
		НоваяСтрока.КодКО			 				= СтрДок.КодБК;
		НоваяСтрока.КодЦели			 				= СтрДок.КодЦели;
		НоваяСтрока.Сумма			 				= СтрДок.Сумма;
		НоваяСтрока.GUIDФК 							= Документы.РаспоряжениеОПеречисленииНаКартыМир.ПолучитьСостояниеДокумента(Основание).GUIDКО;
		НоваяСтрока.НаименованиеПолучателя 			= СтрДок.НаименованиеКонтрагента;
		НоваяСтрока.ЗаявкаНаКассовыйРасход          = Основание;

	КонецЦикла;
	
	Если РасшифровкаПлатежа.Количество() = 0 Тогда		
		ОписаниеОшибки = НСтр("ru='Для ввода на основании необходимо заполнить расшифровку платежа.'");
	КонецЕсли;
	
	Возврат Объект.РеквизитыПлатежногоДокумента.Количество() - 1;
	
КонецФункции

//    Функция создает строку в таблице "РеквизитыПлатежногоДокумента"
//		Входяящие параметры :   Основание - Документ ссылка "ЗаявкаНаКассовыйРасход"
//		Возвращает количество строк в табличной части "РеквизитыПлатежногоДокумента"
//		Количество строк нужно для установки текущей строки после добавления.
//		Для того что бы правильно работала связь между двемя таблицами.
Функция ЗаполнитьНаОснованииЗаявкиНаКассовыйРасход(Основание, Объект, ОписаниеОшибки)
	
	УдалениеСтрокСоответвуюшихОснованию(Основание, Объект);	
	ЗаполнитьШапкуДокумента(Основание, Объект, ",ПерваяПодпись,ВтораяПодпись,ВтораяПодписьПечататьДолжность,ВтораяПодписьДолжность");
	
	Объект.ЗапросНаВыяснениеПринадлежностиПлатежа 	= "";
	Объект.НомерЗапроса 							= "";
	Объект.ДатаЗапроса 								= "";
	Для Каждого СтрДок Из Основание.РасшифровкаПлатежа Цикл
		НоваяСтрока = Объект.РеквизитыПлатежногоДокумента.Добавить();
		НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор; 
		
		НоваяСтрока.НаименованиеПлатежногоДокумента = "Заявка на кассовый расход";
		НоваяСтрока.НомерПлатежногоДокумента		= ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Основание,Основание.Номер);
		НоваяСтрока.ДатаПлатежногоДокумента			= Основание.Дата;
		НоваяСтрока.ИННПолучателя			 		= Основание.КонтрагентИНН;
		НоваяСтрока.КПППолучателя			 		= Основание.КонтрагентКПП;
		НоваяСтрока.КодКО			 				= "000" + СтрДок.КБКНазначениеПлатежа.Код;
		НоваяСтрока.КодЦели			 				= СтрДок.КодЦели;
		НоваяСтрока.Сумма			 				= СтрДок.Сумма;
		НоваяСтрока.НазначениеПлатежа			 	= СтрДок.СтрокаНазначениеПлатежа;
		НоваяСтрока.GUIDФК 							= Документы.ЗаявкаНаКассовыйРасход.ПолучитьСостояниеДокумента(Основание).GUIDКО;
		НоваяСтрока.НаименованиеПолучателя 			= Основание.КонтрагентНаименование;
		НоваяСтрока.Примечание		                = "(" + СокрЛП(НоваяСтрока.НомерПлатежногоДокумента) + ")" + СтрДок.Примечание;
		НоваяСтрока.ЗаявкаНаКассовыйРасход          = Основание;

	КонецЦикла;
	
	Если Объект.РеквизитыПлатежногоДокумента.Количество() = 0 Тогда		
		ОписаниеОшибки = НСтр("ru='Для ввода на основании необходимо заполнить расшифровку платежа.'");
	КонецЕсли;
	
	Возврат Объект.РеквизитыПлатежногоДокумента.Количество() - 1;
	
КонецФункции

Функция ЗаполнитьНаОснованииЗаявкиНаКассовыйРасходСокращенной(Основание, Объект, ОписаниеОшибки)
	
	УдалениеСтрокСоответвуюшихОснованию(Основание, Объект);	
	
	ЗаполнитьШапкуДокумента(Основание, Объект, ",ПерваяПодпись,ВтораяПодпись");
	
	Объект.ЗапросНаВыяснениеПринадлежностиПлатежа 	= "";
	Объект.НомерЗапроса 							= "";
	Объект.ДатаЗапроса 								= "";
	
	НоваяСтрока = Объект.РеквизитыПлатежногоДокумента.Добавить();
	НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор; 
	
	НоваяСтрока.НаименованиеПлатежногоДокумента = "Заявка на кассовый расход";
	НоваяСтрока.НомерПлатежногоДокумента		= ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Основание,Основание.Номер);
	НоваяСтрока.ДатаПлатежногоДокумента			= Основание.Дата;
	НоваяСтрока.ИННПолучателя			 		= Основание.КонтрагентИНН;
	НоваяСтрока.КПППолучателя			 		= Основание.КонтрагентКПП;
	НоваяСтрока.КодКО			 				= "000" + Основание.КБКНазначениеПлатежа.Код;
	НоваяСтрока.КодЦели			 				= Основание.КодЦели;
	НоваяСтрока.Сумма			 				= Основание.СуммаДокумента;
	НоваяСтрока.НазначениеПлатежа			 	= Основание.НазначениеПлатежа;
	НоваяСтрока.GUIDФК 							= Документы.ЗаявкаНаКассовыйРасходСокращенная.ПолучитьСостояниеДокумента(Основание).GUIDКО;
	НоваяСтрока.НаименованиеПолучателя 			= Основание.КонтрагентНаименование;
	НоваяСтрока.Примечание		                = "(" + СокрЛП(НоваяСтрока.НомерПлатежногоДокумента) + ")" ;
	НоваяСтрока.ЗаявкаНаКассовыйРасход          = Основание;

	Возврат Объект.РеквизитыПлатежногоДокумента.Количество() - 1;
	
КонецФункции

Функция ЗаполнитьНаОснованииЗаявкиНаНаличные(Основание, Объект, ОписаниеОшибки)
	
	УдалениеСтрокСоответвуюшихОснованию(Основание, Объект);	
	
	ЗаполнитьШапкуДокумента(Основание, Объект, ",ПерваяПодпись,ВтораяПодпись,ВтораяПодписьПечататьДолжность,ВтораяПодписьДолжность");
	
	Объект.ЗапросНаВыяснениеПринадлежностиПлатежа 	= "";
	Объект.НомерЗапроса 							= "";
	Объект.ДатаЗапроса 								= "";
	
	Для Каждого СтрДок Из Основание.РасшифровкаПлатежа Цикл
		НоваяСтрока = Объект.РеквизитыПлатежногоДокумента.Добавить();
		НоваяСтрока.КлючСтроки = Новый УникальныйИдентификатор; 
		
		НоваяСтрока.НаименованиеПлатежногоДокумента = "Заявка на получение наличных денег";
		НоваяСтрока.НомерПлатежногоДокумента		= ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Основание,Основание.Номер);
		НоваяСтрока.ДатаПлатежногоДокумента			= Основание.Дата;
		НоваяСтрока.ИННПолучателя			 		= "";
