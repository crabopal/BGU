// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции  

// Возвращает массив структур, содержащих значения реквизитов документа для выгрузки
//
// Параметры:
// МассивОбъектов               - Массив объектов данного вида
// ИспользоватьДопКл            - Признак применения доп. классификации и указании ее значений в структурах реквизитов документов
// ИспользоватьКодМероприятия   - Признак применения кодов мероприятий
// ИспользоватьКЭК              - Признак использования КЭК
// ИспользоватьАналитическийКод - Признак использования аналитического кода
// ИспользоватьКФО              - Признак применения КФО и указания значений КФО в структурах реквизитов документа
// ИспользоватьКОСГУПолучателя  - Признак использования КОСГУПолучателя
Функция ЗначенияРеквизитовДокумента(МассивОбъектов, ИспользоватьДопКл = Ложь, ИспользоватьКодМероприятия = Ложь, ИспользоватьКЭК = Ложь, ИспользоватьАналитическийКод = Ложь, ИспользоватьКФО = Ложь, ИспользоватьКОСГУПолучателя = Ложь) Экспорт  
	
	Возврат ПлатежноРасчетныеДокументы.ЗначенияРеквизитовУведомлениеОбУточненииОперацийКлиента(МассивОбъектов, ИспользоватьДопКл, ИспользоватьКодМероприятия, ИспользоватьКЭК, ИспользоватьАналитическийКод, ИспользоватьКФО, ИспользоватьКОСГУПолучателя);
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//  Возвращает сведения о записи в регистре сведенеий "СостояниеПлатежноРасчетныхДокументов"
//    Входящие параметры: Ссылка - тип ссылка на документ "Уведомление об уточнении операции клиента"
//    Исходящие параметры: 
Функция ПолучитьСостояниеДокумента(Ссылка) экспорт
	СтруктураРеквизитов = Новый Структура;
	ПоляВыборки = "";
	//  Струкутра реквизитов динамическая, т.к. со временем может понадобится новый ресурс в регистр
	//  что-бы его не забыть будем каждый раз перебирать ресурсы регистра
	Для каждого Ресурс из Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Ресурсы цикл
		СтруктураРеквизитов.Вставить(Ресурс.Имя);
		ПоляВыборки = ПоляВыборки + "
		|	Состояние." + Ресурс.Имя + " КАК " + Ресурс.Имя + ", "
	КонецЦикла;	
	//  Добавка ввиде реквизита "ПервичныйОбразИРеквизиты"
	СтруктураРеквизитов.Вставить("ПервичныйОбразИРеквизиты");		
	ПоляВыборки = ПоляВыборки + "
	|	Состояние.ПервичныйОбразИРеквизиты КАК ПервичныйОбразИРеквизиты ";
	
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.УведомлениеОбУточненииОперацийКлиента") тогда
		Возврат СтруктураРеквизитов;
	КонецЕсли;	
		
	ТекстЗапроса = "ВЫБРАТЬ " + ПоляВыборки + "
					|ИЗ	
					|	РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК Состояние
					|ГДЕ 
					|	Состояние.ПлатежноРасчетныйДокумент = &Ссылка";
						
	Запрос = Новый Запрос(ТекстЗапроса);				
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
		
	Для каждого КлючЗначение из СтруктураРеквизитов Цикл
		ТекРеквизит = КлючЗначение.Ключ;
		СтруктураРеквизитов[ТекРеквизит] = Выборка[ТекРеквизит];
	КонецЦикла;	
		
	Возврат СтруктураРеквизитов;
КонецФункции	

Функция ЗаполнитьНаОсновании(Знач Основание, Объект, ОписаниеОшибки = "") Экспорт
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен документ основания.'");
		Возврат -1;
	КонецЕсли;
	СтатусОснования = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Основание).Статус;
	Если СтатусОснования = Перечисления.СтатусыИсполненияДокумента.ВРаботе и  ТипЗнч(Основание) = Тип("ДокументСсылка.ЗапросНаВыяснениеПринадлежностиПлатежа") Тогда
		Возврат ЗаполнитьНаОснованииЗапросаНаВыяснение(Основание, Объект, ОписаниеОшибки);
	ИначеЕсли СтатусОснования = Перечисления.СтатусыИсполненияДокумента.Исполнен или СтатусОснования = Перечисления.СтатусыИсполненияДокумента.НаИсполнении тогда
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход") Тогда
			Возврат ЗаполнитьНаОснованииЗаявкиНаКассовыйРасход(Основание, Объект, ОписаниеОшибки);
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная") Тогда
			Возврат ЗаполнитьНаОснованииЗаявкиНаКассовыйРасходСокращенной(Основание, Объект, ОписаниеОшибки);
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаНаличные") Тогда
			Возврат ЗаполнитьНаОснованииЗаявкиНаНаличные(Основание, Объект, ОписаниеОшибки);
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаНаличныеБанковскаяКарта") Тогда
			Возврат ЗаполнитьНаОснованииЗаявкиНаНаличныеБанковскаяКарта(Основание, Объект, ОписаниеОшибки);
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаВозврат") Тогда
			Возврат ЗаполнитьНаОснованииЗаявкиНаВозврат(Основание, Объект, ОписаниеОшибки);
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ПлатежноеПоручение") Тогда
			Возврат ЗаполнитьНаОснованииПлатежноеПоручение(Основание, Объект, ОписаниеОшибки);
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.КассовоеПоступление") Тогда
			Возврат ЗаполнитьНаОснованииКассовоеПоступление(Основание, Объект, ОписаниеОшибки);
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.УведомлениеОбУточненииОперацийКлиента") Тогда
			Возврат ЗаполнитьНаОснованииУведомленияОбУточнении(Основание, Объект, ОписаниеОшибки);  
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.РаспоряжениеОПеречисленииНаКартыМир") Тогда
			Возврат ЗаполнитьНаОснованииРаспоряженияОПеречисленииНаКартыМир(Основание, Объект, ОписаниеОшибки);	
		КонецЕсли;
	КонецЕсли;
	ОписаниеОшибки = НСтр("ru='Статус документа не соответствует типу документа.'");
	Возврат -1;
КонецФункции

