#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокумента

Процедура ОтразитьРезультатОбработкиДокументаЕБП(ДокументСсылка, ДанныеКОбработке, ИнформацияОбОшибке = "", ЕстьВложения) Экспорт
	
	ТекстСтатусаЕБП = "";
	Если НЕ ДанныеКОбработке.Свойство("СтатусРСКП", ТекстСтатусаЕБП) Тогда
		ИнформацияОбОшибке = НСтр("ru = 'Не указан статус РСКП, присвоенный в ЕБП, обработка невозможна.'"); 
		Возврат;
	КонецЕсли;
	
	НовыйСтатусДокумента = ПлатежноРасчетныеДокументы.СтатусДокументаЕБП(ТекстСтатусаЕБП); 
	Если НовыйСтатусДокумента = Неопределено Тогда
		ИнформацияОбОшибке = НСтр("ru = 'Не удалось определить статус РСКП, присвоенный в ЕБП (%1), обработка невозможна.'");
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, ТекстСтатусаЕБП);
		Возврат;
	КонецЕсли;

	ТекущийСтатусДокумента = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ДокументСсылка);  
	
	Если ТекущийСтатусДокумента.Статус = НовыйСтатусДокумента Тогда
		Возврат;
	КонецЕсли;
   	
	НачатьТранзакцию();
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Документ.РСКППеречислениеМир");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ДокументСсылка); 
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СостояниеПлатежноРасчетныхДокументов");
		ЭлементБлокировки.УстановитьЗначение("ПлатежноРасчетныйДокумент", ДокументСсылка); 
		Блокировка.Заблокировать();  
		
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		ДанныеКОбработке.Свойство("НомерРСКП", ДокументОбъект.НомерРСКП);
		ДанныеКОбработке.Свойство("ДатаРСКП", ДокументОбъект.ДатаРСКП); 
		ДанныеКОбработке.Свойство("ПредельнаяДатаИсполнения", ДокументОбъект.ПредельнаяДатаИсполнения);  
		ДокументОбъект.Записать();	
		
		НаборЗаписей = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ПлатежноРасчетныйДокумент.Установить(ДокументСсылка);
		НаборЗаписей.Прочитать(); 
		Если НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей.Добавить();
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;
		Запись.ПлатежноРасчетныйДокумент = ДокументСсылка; 
		Если ДанныеКОбработке.Свойство("ПричинаОтказа", Запись.КомментарийОбработки) Тогда 
			Запись.КомментарийОбработки = ТекстСтатусаЕБП + ": " + Запись.КомментарийОбработки; 
		Иначе
			Запись.КомментарийОбработки = ТекстСтатусаЕБП;
		КонецЕсли;	
		Запись.Статус = НовыйСтатусДокумента; 
		Если Запись.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Исполнен")
			ИЛИ Запись.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.ИсполненЧастично")
			Тогда  
			ДатаИсполнения = Неопределено;
			ДанныеКОбработке.Свойство("ДатаИсполненияРСКП", ДатаИсполнения); 
			Если Не ЗначениеЗаполнено(ДатаИсполнения) И НЕ ЕстьВложения Тогда
				ДатаИсполнения = ТекущаяДатаСеанса();  
			КонецЕсли;
			Запись.ДатаПроведения = ДатаИсполнения;
		КонецЕсли;	
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию(); 
		ИнформацияОбОшибке = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Обмен ЕБП", УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура СоздатьНовыйРСКППоДаннымЕБП(ДанныеКОбработке, Организация, ИнформацияОбОшибке = "", РСКПСсылка, ЕстьВложения) Экспорт  
	
	ТекстСтатусаЕБП = "";
	Если НЕ ДанныеКОбработке.Свойство("СтатусРСКП", ТекстСтатусаЕБП) Тогда
		ИнформацияОбОшибке = НСтр("ru = 'Не указан статус РСКП, присвоенный в ЕБП, обработка невозможна.'"); 
	Иначе
		НовыйСтатусДокумента = ПлатежноРасчетныеДокументы.СтатусДокументаЕБП(ТекстСтатусаЕБП); 
		Если НовыйСтатусДокумента = Неопределено Тогда
			ИнформацияОбОшибке = НСтр("ru = 'Не удалось определить статус РСКП, присвоенный в ЕБП (%1), обработка невозможна.'");
			ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, ТекстСтатусаЕБП); 
		ИначеЕсли НЕ (НовыйСтатусДокумента = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Исполнен")
			ИЛИ НовыйСтатусДокумента = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.ИсполненЧастично")) Тогда
			ИнформацияОбОшибке = НСтр("ru = 'Документ может быть загружен только в статусе ""Исполнен"" или ""Исполнен частично"". Текущий статус: ""%1"".'");
			ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, ТекстСтатусаЕБП); 
		КонецЕсли;  
	КонецЕсли;
	Если ЗначениеЗаполнено(ИнформацияОбОшибке) Тогда
		ИнформацияОбОшибке = ИнформацияОбОшибке + "
		|" + НСтр("ru = 'Не удалось создать РСКП по переданным данным'"); 
		Возврат;
	КонецЕсли; 
	
	НачатьТранзакцию();
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		
		НовыйДокумент = Документы.РСКППеречислениеМир.СоздатьДокумент(); 
		НовыйДокумент.УстановитьСсылкуНового(РСКПСсылка); 
		НовыйДокумент.Заблокировать();  
		
		НовыйДокумент.Внешнее = Истина;
		НовыйДокумент.Организация = Организация;
		НовыйДокумент.МодульИнтеграции = ДанныеКОбработке.МодульИнтеграции;
		
		//ЛицевойСчет   
		НовыйДокумент.ЛицевойСчет = Справочники.ЛицевыеСчета.ЛицевойСчетПоНомеру(ДанныеКОбработке.ЛицевойСчет, Организация); 
		Если Не ЗначениеЗаполнено(НовыйДокумент.ЛицевойСчет) Тогда
			ИнформацияОбОшибке = ИнформацияОбОшибке + "
			|" + НСтр("ru = 'Не найден лицевой счет № %1'");
			ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, ДанныеКОбработке.ЛицевойСчет); 
		КонецЕсли;
		
		НовыйДокумент.Дата = ТекущаяДатаСеанса(); 
		НовыйДокумент.ДатаРСКП = ДанныеКОбработке.ДатаРСКП; 
		НовыйДокумент.НомерРСКП = ДанныеКОбработке.НомерРСКП;  
		
		НовыйДокумент.СуммаДокумента = ДанныеКОбработке.ИтогоПоДокументу;
				
		ДанныеКОбработке.Свойство("ПредельнаяДатаИсполнения", НовыйДокумент.ПредельнаяДатаИсполнения);
		
		ЭтоКазенное = БухгалтерскийУчетПовтИсп.УчетнаяПолитикаОрганизации(Организация, НовыйДокумент.Дата).ЭтоКазенноеУчреждение; 
		
		// Документы - основания
		Для Каждого СтрокаОснования Из ДанныеКОбработке.РЕКВИЗИТЫДОКУМЕНТАОСНОВАНИЯ Цикл  
			СтрДок = НовыйДокумент.РеквизитыДокументаОснования.Добавить();
			
			СтрДок.ДокументОснованиеВид = СтрокаОснования.ДокументОснованиеВид;  
			СтрДок.ДокументОснованиеНомер = СтрокаОснования.ДокументОснованиеНомер;
			СтрДок.ДокументОснованиеДата = СтрокаОснования.ДокументОснованиеДата;
			
		КонецЦикла;	  
				
		// Расшифровка платежа    
		ДанныеКОбработке.РАСШИФРОВКАПЛАТЕЖА.Сортировать("НомерСтроки");
		Для Каждого СтрокаРасшифровки Из ДанныеКОбработке.РАСШИФРОВКАПЛАТЕЖА Цикл 
			СтрДок = НовыйДокумент.РасшифровкаПлатежа.Добавить();
			СтрДок.ИдентификаторСтроки = Новый УникальныйИдентификатор();    
			
			СтрДок.НомерПлатежнойКарты = СтрокаРасшифровки.НомерПлатежнойКарты; 
			СтрДок.ДатаРожденияПолучателя = СтрокаРасшифровки.ДатаРожденияПолучателя;
			
			// КПС
			ТипКБК = БюджетнаяКлассификация.ВидКБКПоАналитическомуКоду(Прав(СтрокаРасшифровки.КБКНазначениеПлатежа, 3));
			Если НЕ ЗначениеЗаполнено(ТипКБК) Тогда
				ТипКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ");   
			КонецЕсли;	
			Если ЭтоКазенное Тогда
				СтрДок.КБКНазначениеПлатежа = БиблиотекаФункцийОбмена.КПСПоТекстовомуКодуБК(СтрокаРасшифровки.КБКНазначениеПлатежа, ТипКБК,, НовыйДокумент.Дата, ИнформацияОбОшибке);
			Иначе
				СтрДок.КБКНазначениеПлатежа = БиблиотекаФункцийОбмена.КПСПоТекстовомуКодуБК(СтрокаРасшифровки.КБКНазначениеПлатежа, Перечисления.ВидыКБК.АУИБУ, ТипКБК, НовыйДокумент.Дата, ИнформацияОбОшибке); 
			КонецЕсли;	 
			
			// Раздел лицевого счета   
			Если ЗначениеЗаполнено(НовыйДокумент.ЛицевойСчет) Тогда 
				СтрДок.РазделЛС = Справочники.РазделыЛицевыхСчетов.РазделЛСПоКодуПоступленияЕБП(НовыйДокумент.ЛицевойСчет, СтрокаРасшифровки.РазделЛСКод, ИнформацияОбОшибке, Истина); 
			КонецЕсли;  
			
			СтрДок.КодЦели = Справочники.ВидыЦелевыхСредств.ВидЦелевыхТекстовомуКоду(СтрокаРасшифровки.КодЦели); 
			СтрДок.КодПрослеживаемости = СтрокаРасшифровки.КодПрослеживаемости;
			СтрДок.КодВидаДохода = СтрокаРасшифровки.КодВидаДохода;
			СтрДок.Взыскано = СтрокаРасшифровки.Взыскано; 
			СтрДок.ВидВыплатНаКартуМИР = Справочники.ВидыВыплатНаКартыМИР.НайтиПоКоду(СтрокаРасшифровки.ВидВыплатНаКартуМИРКод);
			
			СтрДок.Сумма = СтрокаРасшифровки.Сумма;
		КонецЦикла;	
		
		Если ЗначениеЗаполнено(ИнформацияОбОшибке) Тогда
			ОтменитьТранзакцию(); 
			ЗаписьЖурналаРегистрации("Обмен ЕБП", УровеньЖурналаРегистрации.Ошибка,,, ИнформацияОбОшибке);
		Иначе
			
			НовыйДокумент.Записать(); 
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СостояниеПлатежноРасчетныхДокументов");
			ЭлементБлокировки.УстановитьЗначение("ПлатежноРасчетныйДокумент", НовыйДокумент.Ссылка); 
			Блокировка.Заблокировать();  
			
			НаборЗаписей = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ПлатежноРасчетныйДокумент.Установить(НовыйДокумент.Ссылка);
			НаборЗаписей.Прочитать(); 
			Если НаборЗаписей.Количество() =0 Тогда
				Запись = НаборЗаписей.Добавить();
			Иначе
				Запись = НаборЗаписей[0];
			КонецЕсли;
			Запись.ПлатежноРасчетныйДокумент = НовыйДокумент.Ссылка; 
			Запись.Статус = НовыйСтатусДокумента; 
			ДатаИсполнения = Неопределено;
			ДанныеКОбработке.Свойство("ДатаИсполненияРСКП", ДатаИсполнения); 
			Если Не ЗначениеЗаполнено(ДатаИсполнения) И НЕ ЕстьВложения Тогда
				ДатаИсполнения = ТекущаяДатаСеанса();  
			КонецЕсли;
			Запись.ДатаПроведения = ДатаИсполнения;
			НаборЗаписей.Записать();
			
			ЗафиксироватьТранзакцию(); 
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию(); 
		ИнформацияОбОшибке = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Обмен ЕБП", УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры	

Процедура ОтразитьРезультатОбработкиРеестраНСПК(ДанныеКОбработке, РСКПСсылка, ИнформацияОбОшибке) Экспорт
	
	ТекущийРСКП = РСКПСсылка;
	
	НачатьТранзакцию();
	Попытка   
		УстановитьПривилегированныйРежим(Истина);
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Документ.РСКППеречислениеМир");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ТекущийРСКП); 
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СостояниеПлатежноРасчетныхДокументов");
		ЭлементБлокировки.УстановитьЗначение("ПлатежноРасчетныйДокумент", ТекущийРСКП); 
		Блокировка.Заблокировать();  
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ДанныеРеестра.НомерПлатежнойКарты КАК НомерПлатежнойКарты,
		|	ДанныеРеестра.ДатаРожденияПолучателя КАК ДатаРожденияПолучателя,
		|	ДанныеРеестра.ВидВыплатНаКартуМИРКод КАК ВидВыплатНаКартуМИРКод,
		|	ДанныеРеестра.КодВидаДохода КАК КодВидаДохода,
		|	ДанныеРеестра.КодОшибки КАК КодОшибки
		|ПОМЕСТИТЬ ДанныеРеестра
		|ИЗ
		|	&ДанныеРеестра КАК ДанныеРеестра
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РСКППеречислениеМирРасшифровкаПлатежа.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ДанныеРеестра.КодОшибки КАК КодОшибки
		|ИЗ
		|	ДанныеРеестра КАК ДанныеРеестра
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РСКППеречислениеМир.РасшифровкаПлатежа КАК РСКППеречислениеМирРасшифровкаПлатежа
		|		ПО ДанныеРеестра.НомерПлатежнойКарты = РСКППеречислениеМирРасшифровкаПлатежа.НомерПлатежнойКарты
		|			И ДанныеРеестра.ДатаРожденияПолучателя = РСКППеречислениеМирРасшифровкаПлатежа.ДатаРожденияПолучателя
		|			И ДанныеРеестра.ВидВыплатНаКартуМИРКод = РСКППеречислениеМирРасшифровкаПлатежа.ВидВыплатНаКартуМИР.Код
		|			И ДанныеРеестра.КодВидаДохода = РСКППеречислениеМирРасшифровкаПлатежа.КодВидаДохода
		|ГДЕ
		|	НЕ ДанныеРеестра.НомерПлатежнойКарты ЕСТЬ NULL
		|	И РСКППеречислениеМирРасшифровкаПлатежа.Ссылка = &Ссылка");   
		
		Запрос.УстановитьПараметр("ДанныеРеестра", ДанныеКОбработке.ВХОДЯЩИЙРЕЕСТР);
		Запрос.УстановитьПараметр("Ссылка", ТекущийРСКП);
		
		Выборка = Запрос.Выполнить().Выбрать();
		ДокументОбъект = ТекущийРСКП.ПолучитьОбъект(); 
		ОшибкиНСПК = ПлатежноРасчетныеДокументыКлиентСервер.СписокОшибокНСПК();
		
		Пока Выборка.Следующий() Цикл
			СтрокиОтказанные = ДокументОбъект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Выборка.ИдентификаторСтроки));
			Для Каждого СтрокаОтказ Из СтрокиОтказанные Цикл 
				СтрокаОтказ.Отказано = Истина;
				КодыОшибок = СтрРазделить(Выборка.КодОшибки, ",");
				Для Каждого КодОшибки Из КодыОшибок Цикл
					ОписаниеОшибки = ОшибкиНСПК.Получить(КодОшибки);
					Если НЕ ОписаниеОшибки = Неопределено Тогда
						СтрокаОтказ.ИнформацияОбОшибке = СтрокаОтказ.ИнформацияОбОшибке + КодОшибки + ": " + ОписаниеОшибки + Символы.ПС;
					КонецЕсли;	
				КонецЦикла;	
			КонецЦикла;	
		КонецЦикла;	
		
		ДанныеКОбработке.Свойство("СуммаНепринятая", ДокументОбъект.СуммаНевыплаченная);
		ДанныеКОбработке.Свойство("СуммаПринятая", ДокументОбъект.СуммаВыплаченная);
		
		ДокументОбъект.Записать();
		
		НаборЗаписей = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ПлатежноРасчетныйДокумент.Установить(ТекущийРСКП);
		НаборЗаписей.Прочитать(); 
		Если НаборЗаписей.Количество() =0 Тогда
			Запись = НаборЗаписей.Добавить();
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;
		Запись.ПлатежноРасчетныйДокумент = ТекущийРСКП;       
		Запись.НомерПодтверждающегоДокумента = ДанныеКОбработке.НомерРеестра;
		Запись.ДатаПодтверждающегоДокумента = ДанныеКОбработке.ДатаФайла;
		ВидДокумента = "";
		ДанныеКОбработке.Свойство("НаименованиеРаспоряжения", ВидДокумента);
		Если НЕ ЗначениеЗаполнено(ВидДокумента) Тогда
			ВидДокумента = "Входящий реестр НСПК";  
		КонецЕсли;	
		Запись.ВидПодтверждающегоДокумента = ВидДокумента; 
		
		ПодтверждающиеДокументы = Запись.ПервичныйОбразИРеквизиты.Получить();
		Если НЕ ТипЗнч(ПодтверждающиеДокументы) = Тип("Массив") Тогда
			ПодтверждающиеДокументы = Новый Массив;
		КонецЕсли;
		ПодтверждающиеДокументы.Добавить(ДанныеКОбработке);
		Запись.ПервичныйОбразИРеквизиты = Новый ХранилищеЗначения(ПодтверждающиеДокументы, Новый СжатиеДанных(9)); 
		
		Если НЕ ЗначениеЗаполнено(Запись.ДатаПроведения) Тогда
			Запись.ДатаПроведения = ДанныеКОбработке.ДатаФайла;  
		КонецЕсли;
		
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию(); 
		ИнформацияОбОшибке = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Обмен ЕБП", УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры	

Процедура ЗаполнитьПоРееструВедомостейНаВыплатуЗарплаты(ОбъектЗаполнения, ДанныеЗаполнения, СтандартнаяОбработка) Экспорт 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	РеестрВедомостейНаВыплатуЗарплаты.Ссылка КАК Ссылка,
	|	РеестрВедомостейНаВыплатуЗарплаты.ПометкаУдаления КАК ПометкаУдаления,
	|	РеестрВедомостейНаВыплатуЗарплаты.Номер КАК Номер,
	|	РеестрВедомостейНаВыплатуЗарплаты.Дата КАК Дата,
	|	РеестрВедомостейНаВыплатуЗарплаты.Организация КАК Организация,
	|	РеестрВедомостейНаВыплатуЗарплаты.Ответственный КАК Ответственный
	|ИЗ
	|	Документ.РеестрВедомостейНаВыплатуЗарплаты КАК РеестрВедомостейНаВыплатуЗарплаты
	|ГДЕ
	|	РеестрВедомостейНаВыплатуЗарплаты.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.ВидВыплатНаКартуМИР КАК ВидВыплатНаКартуМИР,
	|	РеестрВедомостейНаВыплатуЗарплатыСостав.ДатаРожденияДержателяКарты КАК ДатаРожденияПолучателя,
	|	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КПС КАК КБКНазначениеПлатежа,
	|	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КодВидаДохода КАК КодВидаДохода,
	|	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КодЦели КАК КодЦели,
	|	РеестрВедомостейНаВыплатуЗарплатыСостав.НомерПлатежнойКарты КАК НомерПлатежнойКарты,
	|	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КФО КАК КФО,
	|	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
	|	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
	|	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.Контрагент КАК Контрагент,
	|	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.КЭК КАК КОСГУНазначениеПлатежа,
	|	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.Подразделение КАК Подразделение,
	|	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.ИФО КАК ИФО,
	|	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.Сумма КАК Сумма,
	|	РеестрВедомостейНаВыплатуЗарплатыСостав.Взыскано КАК Взыскано
	|ИЗ
	|	Документ.РеестрВедомостейНаВыплатуЗарплаты.РасшифровкаПлатежа КАК РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеестрВедомостейНаВыплатуЗарплаты.Состав КАК РеестрВедомостейНаВыплатуЗарплатыСостав
	|		ПО РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.ИдентификаторСтроки = РеестрВедомостейНаВыплатуЗарплатыСостав.ИдентификаторСтроки
	|ГДЕ
	|	РеестрВедомостейНаВыплатуЗарплатыРасшифровкаПлатежа.Ссылка = &Ссылка
	|	И РеестрВедомостейНаВыплатуЗарплатыСостав.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);   
	
	МассивРезультатов = Запрос.ВыполнитьПакет();

	Шапка = МассивРезультатов[0].Выбрать();
	
	Если Шапка.Следующий() Тогда 
		ПараметрыСчета = Справочники.ЛицевыеСчета.ЛицевойСчетСМодулемИнтеграции(Шапка.Организация); 
		Если НЕ ЗначениеЗаполнено(ПараметрыСчета.ЛицевойСчет) Тогда
			ИнформацияОбОшибке = НСтр("ru = 'Учреждение %1 не может применять документ """"РСКП (перечисление на карты Мир)""""'");
			ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, Шапка.Организация);
			ОбщегоНазначения.СообщитьПользователю(ИнформацияОбОшибке);
			СтандартнаяОбработка = Ложь;
			Возврат; 
		КонецЕсли;	
	Иначе
		СтандартнаяОбработка = Ложь;
		Возврат; 
	КонецЕсли;
	
	ОбъектЗаполнения.Организация = Шапка.Организация;
	ОбъектЗаполнения.ЛицевойСчет = ПараметрыСчета.ЛицевойСчет;
	ОбъектЗаполнения.МодульИнтеграции = ПараметрыСчета.МодульИнтеграции; 
	
	ОбъектЗаполнения.РасшифровкаПлатежа.Очистить();
	ОбъектЗаполнения.ДетализацияПлатежа.Очистить();
	ОбъектЗаполнения.РасшифровкаКБК.Очистить();
	
	ТаблицаДанных = МассивРезультатов[1].Выгрузить();
	ТаблицаДанных.Колонки.Добавить("РазделЛС", Новый ОписаниеТипов("СправочникСсылка.РазделыЛицевыхСчетов")); 
	Для Каждого Стр Из ТаблицаДанных Цикл
		Стр.РазделЛС = ПлатежноРасчетныеДокументы.РазделЛСПоКодуПоступленияИлиКФО(ОбъектЗаполнения.ЛицевойСчет,,, Стр.КФО);
	КонецЦикла;
		
	ТаблицаРасшифровки = ТаблицаДанных.Скопировать(, 
	"Взыскано,ВидВыплатНаКартуМИР,ДатаРожденияПолучателя,КБКНазначениеПлатежа,КодВидаДохода,КодЦели,НомерПлатежнойКарты,РазделЛС,Сумма");
	ТаблицаРасшифровки.Свернуть("Взыскано,ВидВыплатНаКартуМИР,ДатаРожденияПолучателя,КБКНазначениеПлатежа,КодВидаДохода,КодЦели,НомерПлатежнойКарты,РазделЛС", "Сумма");
	
	ПараметрОтбора = Новый Структура("Взыскано,ВидВыплатНаКартуМИР,ДатаРожденияПолучателя,КБКНазначениеПлатежа,КодВидаДохода,КодЦели,НомерПлатежнойКарты,РазделЛС");
	
	Для Каждого СтрРасшифровка Из ТаблицаРасшифровки Цикл
		ДокРасшифровка = ОбъектЗаполнения.РасшифровкаПлатежа.Добавить();
		ЗаполнитьЗначенияСвойств(ДокРасшифровка, СтрРасшифровка,, "Взыскано");
		ДокРасшифровка.Взыскано = Формат(СтрРасшифровка.Взыскано, "ЧДЦ=2; ЧРД=-; ЧГ=0");
		ДокРасшифровка.ИдентификаторСтроки = Новый УникальныйИдентификатор(); 
		КодСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрРасшифровка.ВидВыплатНаКартуМИР, "КодСчета");
		Если НЕ ЗначениеЗаполнено(КодСчета) Тогда
			КодСчета = "302.00";
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ПараметрОтбора, СтрРасшифровка);
		ТаблицаДетализация = ТаблицаДанных.НайтиСтроки(ПараметрОтбора);  
		Для Каждого СтрДетализация Из ТаблицаДетализация Цикл 
			ДокДетализация = ОбъектЗаполнения.ДетализацияПлатежа.Добавить();	
			ЗаполнитьЗначенияСвойств(ДокДетализация, СтрДетализация); 
			ДокДетализация.ИдентификаторСтроки = ДокРасшифровка.ИдентификаторСтроки;
			ДокДетализация.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(ДокДетализация.КОСГУНазначениеПлатежа, КодСчета,, ТекущаяДатаСеанса(), ОбъектЗаполнения.Организация, ДокДетализация.ИФО);
		КонецЦикла;		
	КонецЦикла;	  
	
	Если ОбъектЗаполнения.ДетализацияПлатежа.Количество() > 0 Тогда
		ОбъектЗаполнения.ИФО = ОбъектЗаполнения.ДетализацияПлатежа[0].ИФО;
	КонецЕсли;	
	
	ОбъектЗаполнения.СуммаДокумента = ОбъектЗаполнения.РасшифровкаПлатежа.Итог("Сумма");
    ОбъектЗаполнения.ДокументОснование = ДанныеЗаполнения; 
	
КонецПроцедуры	
	
#КонецОбласти

 #Область ПечатьДокумента

