&НаКлиенте
Процедура РасшифровкаПлатежаМаскированныйНомерКартыОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	НомерПлатежнойКартыОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаКБКНазначениеПлатежаПриИзменении(Элемент)
	Детализация = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Элементы.РасшифровкаПлатежа.ТекущиеДанные.ИдентификаторСтроки));
	Для Каждого Стр Из Детализация Цикл 
		Стр.КБКНазначениеПлатежа = Элементы.РасшифровкаПлатежа.ТекущиеДанные.КБКНазначениеПлатежа; 
		БухгалтерскийУчетКлиент.ПроверитьОчиститьКЭК(Стр.КБКНазначениеПлатежа, Стр.КОСГУНазначениеПлатежа); 
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаКодЦелиПриИзменении(Элемент)
	Детализация = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Элементы.РасшифровкаПлатежа.ТекущиеДанные.ИдентификаторСтроки));
	Для Каждого Стр Из Детализация Цикл 
		Стр.КодЦели = Элементы.РасшифровкаПлатежа.ТекущиеДанные.КодЦели;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаРазделЛСПриИзменении(Элемент) 
	СтрокаРасшифровки = Элементы.РасшифровкаПлатежа.ТекущиеДанные;  
	
	Детализация = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаРасшифровки.ИдентификаторСтроки));
	Для Каждого Стр Из Детализация Цикл 
		Стр.РазделЛС = СтрокаРасшифровки.РазделЛС;    
		Стр.КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(ПолучитьКодПоступленияЕБП(Стр.РазделЛС));
	КонецЦикла;		
КонецПроцедуры 

&НаКлиенте
Процедура РасшифровкаПлатежаСуммаПриИзменении(Элемент)
	СтрокаРасшифровки = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	Детализация = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаРасшифровки.ИдентификаторСтроки)); 
	Если Детализация.Количество() = 1 Тогда
		Детализация[0].Сумма = СтрокаРасшифровки.Сумма;	
	КонецЕсли;	
	РассчитатьРазницуШапкиИИтогаТЧ(ЭтотОбъект);
	ОтклонениеДетализации(Элементы.РасшифровкаПлатежа.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаВзысканоНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Если Элементы.РасшифровкаПлатежа.ТекущиеДанные <> Неопределено Тогда 
		Оповещение = Новый ОписаниеОповещения("ОбработатьЗначениеВзыскано", ЭтотОбъект);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("СтрокаВзыскано", Элементы.РасшифровкаПлатежа.ТекущиеДанные.Взыскано);
		
		ОткрытьФорму("Документ.РСКППеречислениеМир.Форма.ФормаВводаВзыскано", 
		ПараметрыФормы, 
		ЭтаФорма, 
		, , , 
		Оповещение, 
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	КонецЕсли;
			
КонецПроцедуры   

&НаКлиенте
Процедура ОбработатьЗначениеВзыскано(Результат, ДопПараметры) Экспорт 
	Если НЕ Результат = Неопределено И НЕ Результат = КодВозвратаДиалога.Отмена Тогда
		Элементы.РасшифровкаПлатежа.ТекущиеДанные.Взыскано = Результат;	   
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаВидВыплатНаКартуМИРПриИзменении(Элемент)
	СтрокаРасшифровки = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	Если ЗначениеЗаполнено(СтрокаРасшифровки.ВидВыплатНаКартуМИР) Тогда
		ВидВыплатНаКартуМИРПриИзмененииНаСервере(СтрокаРасшифровки.ИдентификаторСтроки);
	КонецЕсли;	
КонецПроцедуры  

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДетализацияПлатежа

&НаКлиенте
Процедура ДетализацияПлатежаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Элементы.РасшифровкаПлатежа.ТекущиеДанные = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не выбраны детализируемые данные!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, , , "Объект", Отказ);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда 
		ДетализацияПлатежаТекущиеДанные = Элемент.ТекущиеДанные;
		РодительскаяСтрока = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
		ЗаполнитьЗначенияСвойств(ДетализацияПлатежаТекущиеДанные, РодительскаяСтрока,, "Сумма");   
		
		Если ЗначениеЗаполнено(РодительскаяСтрока.ПлатежнаяКарта) Тогда
			ДетализацияПлатежаТекущиеДанные.Контрагент = КонтрагентПлатежнойКарты(РодительскаяСтрока.ПлатежнаяКарта);
		КонецЕсли;	
		
		ВведеноРанее = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", РодительскаяСтрока.ИдентификаторСтроки)); 
		СуммаРанее = 0;
		Для Каждого Стр Из ВведеноРанее Цикл  
			Если НЕ ДетализацияПлатежаТекущиеДанные = Стр Тогда
				СуммаРанее = СуммаРанее + Стр.Сумма; 
			КонецЕсли;
		КонецЦикла;	
		ДетализацияПлатежаТекущиеДанные.Сумма = РодительскаяСтрока.Сумма - СуммаРанее;
		Если НЕ Копирование Тогда
			ДетализацияПлатежаТекущиеДанные.КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(ПолучитьКодПоступленияЕБП(ДетализацияПлатежаТекущиеДанные.РазделЛС)); 
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	РодительскаяСтрока = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	Если НЕ РодительскаяСтрока = Неопределено Тогда  
		ОтклонениеДетализации(РодительскаяСтрока);  
	КонецЕсли;
	РассчитатьРазницуШапкиИИтогаТЧ(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаПослеУдаления(Элемент)
	РодительскаяСтрока = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	Если НЕ РодительскаяСтрока = Неопределено Тогда  
		ОтклонениеДетализации(РодительскаяСтрока);  
	КонецЕсли;
	РассчитатьРазницуШапкиИИтогаТЧ(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаКБКНазначениеПлатежаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ТекИдентификатор = Элементы.ДетализацияПлатежа.ТекущиеДанные.ИдентификаторСтроки;
	РодительскаяСтрока = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекИдентификатор));  
	ДетализацияКБКНазначениеПлатежаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка, РодительскаяСтрока[0]);
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияПлатежаКФОНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	Элемент.СписокВыбора.Очистить();
	СоотвествиеКодов = ПлатежноРасчетныеДокументыКлиентСервер.СоответствиеКФОКодамПоступленийЕБП(Объект.Дата);
	ТекущийКодПоступления = КодПоступленияСтроки(Элементы.ДетализацияПлатежа.ТекущиеДанные.РазделЛС);
	Для Каждого КлючИЗначение Из СоотвествиеКодов Цикл 
		Если КлючИЗначение.Значение = ТекущийКодПоступления Тогда
			Элемент.СписокВыбора.Добавить(КлючИЗначение.Ключ);	
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры   

&НаКлиенте
Процедура ДетализацияПлатежаКОСГУПриИзменении(Элемент)  
	ТекДанные = Элементы.ДетализацияПлатежа.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	РодительскаяСтрока = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ТекДанные.ИдентификаторСтроки)); 
	Если РодительскаяСтрока.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	Если ЗначениеЗаполнено(ТекДанные.КОСГУНазначениеПлатежа) И ЗначениеЗаполнено(РодительскаяСтрока[0].ВидВыплатНаКартуМИР)Тогда
		УстановитьСчетРасчетов(
		ТекДанные.СчетРасчетов, 
		ТекДанные.КОСГУНазначениеПлатежа, 
		ТекДанные.КБКНазначениеПлатежа, 
		РодительскаяСтрока[0].ВидВыплатНаКартуМИР,
		Объект.Дата,
		Объект.Организация,
		Объект.ИФО); 
	Иначе
		ТекДанные.СчетРасчетов = ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
	КонецЕсли;
КонецПроцедуры   

#КонецОбласти

