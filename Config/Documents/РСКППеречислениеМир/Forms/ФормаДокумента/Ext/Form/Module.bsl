#Область СлужебныеПроцедурыИФункции    

&НаСервере  
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()  
	
	Для Каждого Стр Из Объект.РасшифровкаПлатежа Цикл
		Стр.МаскированныйНомерКарты = МаскированныйНомерКарты(Стр.НомерПлатежнойКарты);
	КонецЦикла;	
	
КонецПроцедуры	 

&НаКлиентеНаСервереБезКонтекста
Функция МаскированныйНомерКарты(НомерКартыПолный)
	ОсновнойНомерДержателяКарты = БанковскиеКартыСлужебныйКлиентСервер.СкопироватьЦифры(НомерКартыПолный);
	Возврат БанковскиеКартыСлужебныйКлиентСервер.МаскированныйНомер(ОсновнойНомерДержателяКарты); 
КонецФункции	

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	УчетПоИФО = ОбщегоНазначенияБГУПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО");
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДетализацияПлатежаИФО",
		"Видимость", (ЗначениеЗаполнено(Объект.ДокументОснование) И УчетПоИФО));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИФО",
		"Видимость", НЕ ЗначениеЗаполнено(Объект.ДокументОснование));  
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РасшифровкаПлатежаПоказатьНомераКарт",
		"Видимость", БанковскиеКарты.РазрешенПросмотрПолногоНомераКарты()); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РасшифровкаПлатежаПодобрать",
		"Видимость", НЕ (ЗначениеЗаполнено(Объект.ДокументОснование) ИЛИ Объект.Внешнее));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РасшифровкаПлатежаНомерПлатежнойКарты",
		"КнопкаВыбора", НЕ (ЗначениеЗаполнено(Объект.ДокументОснование) ИЛИ Объект.Внешнее));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РасшифровкаПлатежаМаскированныйНомерКарты",
		"КнопкаВыбора", НЕ (ЗначениеЗаполнено(Объект.ДокументОснование) ИЛИ Объект.Внешнее));

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РасшифровкаПлатежа",
		"ИзменятьСоставСтрок", НЕ (ЗначениеЗаполнено(Объект.ДокументОснование) ИЛИ Объект.Внешнее));
				
КонецПроцедуры  

&НаКлиенте
Процедура НомерПлатежнойКартыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь; 
	Если ЗначениеЗаполнено(Объект.ДокументОснование) ИЛИ Объект.Внешнее Тогда
		Возврат;
	КонецЕсли;	
	ПараметрыВыбораКарты = Новый Структура;  
	ПараметрыВыбораКарты.Вставить("РежимВыбора", Истина);
	ПараметрыВыбораКарты.Вставить("ТекущаяСтрока", Элементы.РасшифровкаПлатежа.ТекущиеДанные.ПлатежнаяКарта);
	ОткрытьФорму("Справочник.БанковскиеКартыКонтрагентов.ФормаВыбора", ПараметрыВыбораКарты, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура НомерПлатежнойКартыОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;  
	Если ЗначениеЗаполнено(Объект.ДокументОснование) ИЛИ Объект.Внешнее Тогда
		Возврат;
	КонецЕсли;    
	ОбработатьВыборКартыНаСервере(Элементы.РасшифровкаПлатежа.ТекущаяСтрока, ВыбранноеЗначение);
КонецПроцедуры   

&НаСервере
Процедура ПоместитьКартыВХранилищеНаСервере(ПараметрыПодбора)
	
	ПараметрыПодбора.Вставить("АдресХранилища");
	ВыбранныеКарты = Объект.РасшифровкаПлатежа.Выгрузить(, "ПлатежнаяКарта");
	ПараметрыПодбора.АдресХранилища = ПоместитьВоВременноеХранилище(ВыбранныеКарты, ЭтотОбъект.УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборКартыНаСервере(ИдентификаторСтроки, ПлатежнаяКарта)
	
	Если НЕ ЗначениеЗаполнено(ПлатежнаяКарта) Тогда
		Возврат;
	КонецЕсли;	
		
	ДанныеСтроки = Объект.РасшифровкаПлатежа.НайтиПоИдентификатору(ИдентификаторСтроки);  
	ДанныеДляЗаполнения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПлатежнаяКарта, 
	         Новый Структура("МаскированныйНомерКарты,Контрагент,ДатаРожденияПолучателя, ОсновнойНомерДержателяКарты", 
			 "Код", "Владелец", "Владелец.ЮридическоеФизическоеЛицо.ДатаРождения", "ОсновнойНомерДержателяКарты"));
			 
	ДанныеДляЗаполнения.Вставить("НомерПлатежнойКарты", ?(ЗначениеЗаполнено(ДанныеДляЗаполнения.ОсновнойНомерДержателяКарты),
			ДанныеДляЗаполнения.ОсновнойНомерДержателяКарты.Получить(), "") ); 
			
	ДанныеДляЗаполнения.Вставить("ПлатежнаяКарта", ПлатежнаяКарта);  
	
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, ДанныеДляЗаполнения);
	
	Детализация = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ДанныеСтроки.ИдентификаторСтроки)); 
	
	Для Каждого Стр Из Детализация Цикл  
		Если НЕ Стр.Контрагент = ДанныеДляЗаполнения.Контрагент Тогда
			Стр.Контрагент = ДанныеДляЗаполнения.Контрагент;
			Стр.Договор = "";
		КонецЕсли; 
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ОбработатьПодборКартНаСервере(ВыбранныеКарты)  
	
	  ТабВыбранных = ПолучитьИзВременногоХранилища(ВыбранныеКарты.АдресВХранилище);
	  
	  // Удаление отсутствующих в подборе 
	  Для Каждого СтрРасшифровки Из Объект.РасшифровкаПлатежа Цикл
		  Если ТабВыбранных.Найти(СтрРасшифровки.ПлатежнаяКарта, "ПлатежнаяКарта") = Неопределено Тогда
			  // Нет в подборе
			  СтрокиДетализации = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрРасшифровки.ИдентификаторСтроки)); 
			  Для Каждого СтрокаДетализации Из СтрокиДетализации Цикл
				  Объект.ДетализацияПлатежа.Удалить(СтрокаДетализации);
			  КонецЦикла;
			  Объект.РасшифровкаПлатежа.Удалить(СтрРасшифровки); 
		  КонецЕсли;
	  КонецЦикла;   
	  
	  // Добавление отсутствущих в таблице документа
	  МассивСуществующих = Объект.РасшифровкаПлатежа.Выгрузить(, "ПлатежнаяКарта").ВыгрузитьКолонку("ПлатежнаяКарта");
	  МассивВыбранных = ТабВыбранных.ВыгрузитьКолонку("ПлатежнаяКарта");
	  МассивДобавленных = ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивВыбранных, МассивСуществующих);
				  
	  РеквизитыКарт = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивДобавленных, "Код, Владелец, ОсновнойНомерДержателяКарты");
	  
	  Для Каждого ДанныеКарты Из РеквизитыКарт Цикл  
		  НовСтрокаРасшифровки = Объект.РасшифровкаПлатежа.Добавить();
		  НовСтрокаРасшифровки.ИдентификаторСтроки = Новый УникальныйИдентификатор;  
		  НовСтрокаРасшифровки.ПлатежнаяКарта = ДанныеКарты.Ключ; 
		  НовСтрокаРасшифровки.МаскированныйНомерКарты = ДанныеКарты.Значение.Код; 
		  НовСтрокаРасшифровки.НомерПлатежнойКарты = ?(ЗначениеЗаполнено(ДанныеКарты.Значение.ОсновнойНомерДержателяКарты),
		  											ДанныеКарты.Значение.ОсновнойНомерДержателяКарты.Получить(), "");
		  НовСтрокаРасшифровки.ДатаРожденияПолучателя = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеКарты.Значение.Владелец, "ЮридическоеФизическоеЛицо.ДатаРождения");
		  НовСтрокаДетализации = Объект.ДетализацияПлатежа.Добавить();
		  НовСтрокаДетализации.ИдентификаторСтроки = НовСтрокаРасшифровки.ИдентификаторСтроки;
		  НовСтрокаДетализации.Контрагент = ДанныеКарты.Значение.Владелец;
	  КонецЦикла;	  
	  
КонецПроцедуры	

&НаСервере
Процедура ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию()
	
	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.ЗаявкаНаКассовыйРасход", 
	Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский,,, Неопределено);
	
	Объект.ЛицевойСчет = Умолчания.ЛицевойСчет;
	
	ПриИзмененииЛицевогоСчетаНаСервере();
	
КонецПроцедуры	

&НаСервере
Процедура ПриИзмененииЛицевогоСчетаНаСервере()
	СвойстваЛицевогоСчета = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет, Объект.Дата);
	ЗаполнитьЗначенияСвойств(Объект, СвойстваЛицевогоСчета);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьРазницуШапкиИИтогаТЧ(Форма)
	Объект = Форма.Объект;
	Форма.ИтогПоТЧ = Объект.РасшифровкаПлатежа.Итог("Сумма") - Объект.СуммаДокумента;
КонецПроцедуры  

&НаСервереБезКонтекста 
Функция ПолучитьКодПоступленияЕБП(РазделЛС)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РазделЛС, "КодПоступленияЕБП");
КонецФункции  

&НаСервереБезКонтекста 
Функция КонтрагентПлатежнойКарты(ПлатежнаяКарта)
    Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежнаяКарта, "Владелец");
КонецФункции   

&НаКлиенте
Процедура ОтклонениеДетализации(РодительТекущиеДанные)
	Детализация = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", РодительТекущиеДанные.ИдентификаторСтроки)); 
	РазницаДетализацииРасшифровки = - РодительТекущиеДанные.Сумма;
	Для Каждого Стр Из Детализация Цикл 
		РазницаДетализацииРасшифровки = РазницаДетализацииРасшифровки + Стр.Сумма;	
	КонецЦикла;	  
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокиДетализаци(ВыделенныеСтроки)
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		Строка = Объект.РасшифровкаПлатежа.НайтиПоИдентификатору(ВыделеннаяСтрока);
		Если Строка <> Неопределено Тогда
			ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", Строка.ИдентификаторСтроки);
			МассивКУдалению = Объект.ДетализацияПлатежа.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
				Объект.ДетализацияПлатежа.Удалить(СтрокаКУдалению);
			КонецЦикла;
		КонецЕсли
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОтборДляРасшифровкиПлатежа(ИдентификаторСтроки)
	
	ОтборСтрок = Элементы.ДетализацияПлатежа.ОтборСтрок;
	
	Если ОтборСтрок = Неопределено
		ИЛИ НЕ (ОтборСтрок.Свойство("ИдентификаторСтроки")
				И ОтборСтрок.ИдентификаторСтроки = ИдентификаторСтроки) Тогда
		
		Элементы.ДетализацияПлатежа.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ИдентификаторСтроки",ИдентификаторСтроки));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСтатусДокумента()
	
	ПлатежноРасчетныеДокументыКлиент.ОткрытьФормуИзмененияСтатусаДокумента(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДетализацияКБКНазначениеПлатежаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка, РодительскаяСтрока);
	 
	СтандартнаяОбработка = Ложь;
	
	ОтборКБК = Новый Структура;
	
	ЗаполнитьОтборКБК(РодительскаяСтрока.КБКНазначениеПлатежа, ОтборКБК);   
	
	ОтборКБК.Вставить("НаДату", Объект.Дата);
	ОтборКБК.Вставить("Организация", Объект.Организация);
    ОтборКБК.Вставить("ИФО", Объект.ИФО);
	
	ПараметрыКБК = Новый Структура("Отбор", ОтборКБК);
	
	ОткрытьФорму("Справочник.КлассификационныеПризнакиСчетов.ФормаВыбора", ПараметрыКБК, Элемент); 
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьОтборКБК(КБКИсходный, ОтборКБК)
	
	РеквизитыКБК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КБКИсходный, "ВидПоказателя,УточнениеПоказателя,Код"); 
	
	ОтборКБК.Вставить("ВидПоказателя", РеквизитыКБК.ВидПоказателя);
	ОтборКБК.Вставить("УточнениеПоказателя", РеквизитыКБК.УточнениеПоказателя);
	ОтборКБК.Вставить("КодАналитическойГруппы", ПРАВ(РеквизитыКБК.Код, 3));    
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция КодПоступленияСтроки(РазделЛС)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РазделЛС, "КодПоступленияЕБП");
КонецФункции	

&НаСервере
Процедура ВидВыплатНаКартуМИРПриИзмененииНаСервере(ИдентификаторРасшифровки) 
	Детализация = Объект.ДетализацияПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторРасшифровки));  
	СтрокаРасшифровки = Объект.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторРасшифровки)); 
	Если СтрокаРасшифровки.Количество() > 0 Тогда
		Для Каждого СтрДетализация Из Детализация Цикл
			Если ЗначениеЗаполнено(СтрДетализация.КОСГУНазначениеПлатежа) Тогда
				УстановитьСчетРасчетов(
				СтрДетализация.СчетРасчетов, 
				СтрДетализация.КОСГУНазначениеПлатежа, 
				СтрДетализация.КБКНазначениеПлатежа, 
				СтрокаРасшифровки[0].ВидВыплатНаКартуМИР,
				Объект.Дата,
				Объект.Организация,
				Объект.ИФО); 
			Иначе
				СтрДетализация.СчетРасчетов = ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьСчетРасчетов(СчетРасчетов, КОСГУ, КБК, ВидВыплатНаКартуМИР, НаДату, Организация, ИФО)
	КодСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидВыплатНаКартуМИР, "КодСчета");
	Если НЕ ЗначениеЗаполнено(КодСчета) И НЕ ЗначениеЗаполнено(СчетРасчетов) Тогда
		КодСчета = "302.00";
	КонецЕсли;
	Если ЗначениеЗаполнено(КодСчета) Тогда
		СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(КОСГУ, КодСчета,, НаДату, Организация, ИФО, КБК); 
	КонецЕсли;
КонецПроцедуры	

