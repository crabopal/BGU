&НаКлиенте
Процедура ЗаполнитьСумму(Команда)
	
	Если Объект.СуммаДокумента <> Объект.РасшифровкаПлатежа.Итог("Сумма") Тогда
		Объект.СуммаДокумента = Объект.РасшифровкаПлатежа.Итог("Сумма");
		РассчитатьРазницуШапкиИИтогаТЧ(ЭтаФорма);
		Модифицированность = Истина;
	Иначе
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьКонтрагентов(Команда)  
	Если ЗначениеЗаполнено(Объект.ДокументОснование) ИЛИ Объект.Внешнее Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПодбора = Новый Структура;
	ПоместитьКартыВХранилищеНаСервере(ПараметрыПодбора);
	
	ОткрытьФорму("Справочник.БанковскиеКартыКонтрагентов.Форма.ФормаПодбораПоКонтрагентам", ПараметрыПодбора, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);    
	
КонецПроцедуры 

&НаКлиенте
Процедура ПодобратьСотрудников(Команда)
	Если ЗначениеЗаполнено(Объект.ДокументОснование) ИЛИ Объект.Внешнее Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПодбора = Новый Структура;
	ПоместитьКартыВХранилищеНаСервере(ПараметрыПодбора); 
	ПараметрыПодбора.Вставить("Организация", Объект.Организация);
	
	ОткрытьФорму("Справочник.БанковскиеКартыКонтрагентов.Форма.ФормаПодбораПоСотрудникам", ПараметрыПодбора, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);    

КонецПроцедуры  

&НаКлиенте
Процедура ПоказатьНомераКарт(Команда)  
	
	НовааяПометка = НЕ Элементы.РасшифровкаПлатежаПоказатьНомераКарт.Пометка;
	
	Элементы.РасшифровкаПлатежаМаскированныйНомерКарты.Видимость = НЕ НовааяПометка; 
	Элементы.РасшифровкаПлатежаНомерПлатежнойКарты.Видимость = НовааяПометка;
	Элементы.РасшифровкаПлатежаПоказатьНомераКарт.Пометка = НовааяПометка;
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
