#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  
	
	МассивВзыскано = СтрРазделить(Параметры.СтрокаВзыскано, ";", Ложь);
	
	Для Каждого Взыскано Из МассивВзыскано Цикл   
		Сумма = СтрЗаменить(СтрЗаменить(Взыскано, " ", ""), "-", ".");
		Если  ОбщегоНазначенияКлиентСервер.ЭтоЧисло(Сумма) Тогда
			НовСтр = ТаблицаСумм.Добавить();
			НовСтр.Взыскано = Число(СтрЗаменить(СтрЗаменить(Взыскано, " ", ""), "-", ".")); 
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	Закрыть(РезультатВвода());
КонецПроцедуры

#КонецОбласти  

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция РезультатВвода()  
	
	МассивРезультат = Новый Массив;
	
	Для Каждого СтрВзыскано Из ТаблицаСумм Цикл   
		Если ЗначениеЗаполнено(СтрВзыскано.Взыскано) Тогда
			МассивРезультат.Добавить(Формат(СтрВзыскано.Взыскано, "ЧДЦ=2; ЧРД=-; ЧГ=0"));
		КонецЕсли;
	КонецЦикла;	
	
	Возврат (СтрСоединить(МассивРезультат, ";"));

КонецФункции	

#КонецОбласти 