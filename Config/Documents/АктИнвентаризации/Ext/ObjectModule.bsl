#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСлужебныеКолонки_Приложение8кРазделу2();
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат;
	КонецЕсли;
	
	Документы.АктИнвентаризации.ЗаполнитьНаОсновании(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив();
	НепроверяемыеРеквизиты.Добавить("Раздел2.Счет");
	НепроверяемыеРеквизиты.Добавить("Раздел3.Счет");
	НепроверяемыеРеквизиты.Добавить("Приложение7кРазделу2.Счет");
	НепроверяемыеРеквизиты.Добавить("Приложение4кРазделу3.Счет");
	НепроверяемыеРеквизиты.Добавить("СоставКомиссии.ПричинаОтсутствия");
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	Если Документы.АктИнвентаризации.ЕстьОшибкиЗаполнения(ЭтотОбъект) Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьСлужебныеКолонки_Приложение8кРазделу2()
	
	Дебиторская = Перечисления.ВидыЗадолженности.Дебиторская;
	Кредиторская = Перечисления.ВидыЗадолженности.Кредиторская;
	
	Для Каждого СтрокаТаблицы Из Приложение8кРазделу2 Цикл
		
		Если СтрокаТаблицы.ВидЗадолженности = Дебиторская Тогда
			СтрокаТаблицы.СуммаОтклоненийДЗ = СтрокаТаблицы.СуммаОтклонений;
			СтрокаТаблицы.СуммаОтклоненийКЗ = 0;
			
		ИначеЕсли СтрокаТаблицы.ВидЗадолженности = Кредиторская Тогда
			СтрокаТаблицы.СуммаОтклоненийДЗ = 0;
			СтрокаТаблицы.СуммаОтклоненийКЗ = СтрокаТаблицы.СуммаОтклонений;
			
		Иначе
			СтрокаТаблицы.СуммаОтклоненийДЗ = 0;
			СтрокаТаблицы.СуммаОтклоненийКЗ = 0;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли