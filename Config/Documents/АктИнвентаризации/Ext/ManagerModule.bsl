		+ ?(ЗначениеЗаполнено(Выборка.ДоговорНаименование), ", " + Выборка.ДоговорНаименование, "");
	
	ЗначенияПараметров.Вставить("НаименованиеКонтрагента",	НаименованиеКонтрагента);
	ЗначенияПараметров.Вставить("НомерСчета",				ПолучитьПолныйНомерСчета(Выборка.КПС, Выборка.КФО, Выборка.Счет, Выборка.КЭК));
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
КонецПроцедуры

Процедура ДобавитьКодНаименованиеТипаКачественнойХарактеристики(ЗначенияПараметров, Выборка, ДополнительныеПараметры)
	
	ЗначенияСвойств = Перечисления.ТипыКачественныхХарактеристик.ПолучитьКодНаименованиеПредставление(Выборка.ТипКачественнойХарактеристики);
	
	ЗначенияПараметров.Вставить("КодХарактеристики", ЗначенияСвойств.Код);
	ЗначенияПараметров.Вставить("НаименованиеХарактеристики", ЗначенияСвойств.Наименование);
	
КонецПроцедуры

Функция ПолучитьПолныйНомерСчета(Знач КПС = Неопределено, Знач КФО = Неопределено, Знач Счет = Неопределено, Знач КЭК = Неопределено,
	Знач ВыводитьНулиПриДляПустогоЗначения = Истина, Знач СчетУчетПоКПС = Истина, Знач СчетУчетПоКЭК = Истина)
	
	Если ВыводитьНулиПриДляПустогоЗначения Тогда
		Если Не ЗначениеЗаполнено(КПС) Тогда
			КПС = "00000000000000000";
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(КФО) Тогда
			КФО = "0";
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Счет) Тогда
			Счет = "000.00";
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(КЭК) Тогда
			КЭК = "000";
		КонецЕсли;
	КонецЕсли;
	
	Если СчетУчетПоКПС И СчетУчетПоКЭК Тогда
		Возврат СтрШаблон("%1.%2.%3.%4", КПС, КФО, Счет, КЭК);
		
	ИначеЕсли СчетУчетПоКПС И Не СчетУчетПоКЭК Тогда
		Возврат СтрШаблон("%1.%2.%3", КПС, КФО, Счет);
		
	ИначеЕсли Не СчетУчетПоКПС И СчетУчетПоКЭК Тогда
		Возврат СтрШаблон("%1.%2.%3", КФО, Счет, КЭК);
	Иначе
		Возврат СтрШаблон("%1.%2", КФО, Счет);
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецОбласти

