#Область ОпределениеМестРегистрацииОписи

Функция ПолучитьПустуюТаблицуМестаРегистрацииОписей()
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Опись");
	Таблица.Колонки.Добавить("ДатаОписи",					ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	Таблица.Колонки.Добавить("НомерОписи",					Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Раздел1",						ТипБулево);
	Таблица.Колонки.Добавить("Раздел2",						ТипБулево);
	Таблица.Колонки.Добавить("Раздел3",						ТипБулево);
	Таблица.Колонки.Добавить("ТаблицаПриложений",			Новый ОписаниеТипов("ТаблицаЗначений"));
	Таблица.Колонки.Добавить("МассивСтрокТаблицыОбъекты",	Новый ОписаниеТипов("Массив"));
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьПустуюТаблицуПриложений()
	
	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный);
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	ТаблицаПриложений = Новый ТаблицаЗначений();
	ТаблицаПриложений.Колонки.Добавить("СтрокаТаблицыОбъекты");
	ТаблицаПриложений.Колонки.Добавить("СтрокаОписи");
	ТаблицаПриложений.Колонки.Добавить("НомерПриложенияРаздела2",	ТипЧисло);
	ТаблицаПриложений.Колонки.Добавить("НомерПриложенияРаздела3",	ТипЧисло);
	
	Возврат ТаблицаПриложений;
	
КонецФункции

Процедура ИсключитьНекорректныеНастройкиМестРегистрации(ТаблицаМестаРегистрации)
	
	Поиск = Новый Структура("Раздел2,Раздел3", Ложь, Ложь);
	
	МассивСтрок = ТаблицаМестаРегистрации.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СтрокаТаблицы.Раздел1 = Истина;
	КонецЦикла;
	
	Поиск = Новый Структура("Раздел1", Истина);
	
	МассивСтрок = ТаблицаМестаРегистрации.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Если СтрокаТаблицы.Раздел2 Или СтрокаТаблицы.Раздел3 Тогда
			СтрокаТаблицы.Раздел1 = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция УпорядочитьНомераСтрок(НомераСтрок)
	
	ВремСписок = Новый СписокЗначений();
	
	Для Каждого Элемент Из НомераСтрок Цикл
		ВремСписок.Добавить(Элемент.Ключ);
	КонецЦикла;
	
	ВремСписок.СортироватьПоЗначению();
	
	Возврат ВремСписок.ВыгрузитьЗначения();
	
КонецФункции

#Область Описи52н

Процедура ДобавитьМестаРегистрацииОписей(ТаблицаОбъекты, ДополнительныеПараметры)
	
	Перем ДобавитьВРаздел2, ДобавитьВРаздел3;
	
	ТаблицыОписей = ДополнительныеПараметры.ТаблицыОписей;
	
	ТаблицаМестаРегистрации = ПолучитьПустуюТаблицуМестаРегистрацииОписей();
	
	ПоискОписьСсылка= Новый Структура("Опись");
	
	ПоискОписьНомерСтроки = Новый Структура("Опись,ИмяТабличнойЧасти,НомерСтроки");
	
	Для Каждого СтрокаТаблицыОбъекты Из ТаблицаОбъекты Цикл
		
		Для Каждого СтрокаСопоставления Из СтрокаТаблицыОбъекты.ТаблицаСопоставленияОписей Цикл
			
			Опись = СтрокаСопоставления.Опись;
			
			ИмяДокумента = ПолучитьИмяДокумента(Опись, ДополнительныеПараметры);
			
			ДополнительныеПараметры.Вставить("ИмяДокумента", ИмяДокумента);
			
			ТаблицаОписей = ТаблицыОписей[ИмяДокумента];
			
			ПоискОписьСсылка.Опись = Опись;
			
			МассивСтрок = ТаблицаМестаРегистрации.НайтиСтроки(ПоискОписьСсылка);
			
			Если МассивСтрок.Количество() = 0 Тогда
				СтрокаМестаРегистрации = ТаблицаМестаРегистрации.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаМестаРегистрации, СтрокаСопоставления, "Опись,НомерОписи,ДатаОписи");
				
				СтрокаМестаРегистрации.ТаблицаПриложений = ПолучитьПустуюТаблицуПриложений();
				
				СтрокаМестаРегистрации.МассивСтрокТаблицыОбъекты = Новый Массив();
			Иначе
				СтрокаМестаРегистрации = МассивСтрок[0];
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ПоискОписьНомерСтроки, СтрокаСопоставления, "Опись,ИмяТабличнойЧасти");
			
			Если СтрокаМестаРегистрации.МассивСтрокТаблицыОбъекты.Найти(СтрокаТаблицыОбъекты) = Неопределено Тогда
				СтрокаМестаРегистрации.МассивСтрокТаблицыОбъекты.Добавить(СтрокаТаблицыОбъекты);
			КонецЕсли;
			
			НомераСтрок = УпорядочитьНомераСтрок(СтрокаСопоставления.НомераСтрок);
			
			Для Каждого НомерСтроки Из НомераСтрок Цикл
				ПоискОписьНомерСтроки.НомерСтроки = НомерСтроки;
				
				МассивСтрок = ТаблицаОписей.НайтиСтроки(ПоискОписьНомерСтроки);
				
				СтрокаОписи = МассивСтрок[0];
				
				ОпределитьМестоРегистрацииСтрокиОписи(ИмяДокумента, СтрокаТаблицыОбъекты, СтрокаОписи, СтрокаМестаРегистрации);
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ИсключитьНекорректныеНастройкиМестРегистрации(ТаблицаМестаРегистрации);
	
	ДополнительныеПараметры.Вставить("МестаРегистрацииОписей", ТаблицаМестаРегистрации);
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрацииСтрокиОписи(ИмяДокумента, СтрокаТаблицыОбъекты, СтрокаОписи, СтрокаМестаРегистрации)

	Перем НомерПриложенияРаздела2, НомерПриложенияРаздела3;
	
	Если ИмяДокумента = "ИнвентаризацияЦенныхБумаг" Тогда
		ОпределитьМестоРегистрации_ИнвентаризацияЦенныхБумаг(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризацияОстатковНаСчетах" Тогда
		ОпределитьМестоРегистрации_ИнвентаризацияОстатковНаСчетах(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризацияКредитовИЗаймов" Тогда
		ОпределитьМестоРегистрации_ИнвентаризацияКредитовИЗаймов(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризацияГосдолгаВЦенныхБумагах" Тогда
		ОпределитьМестоРегистрации_ИнвентаризацияГосдолгаВЦенныхБумагах(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризацияГосдолгаПоКредитамИГарантиям" Тогда
		ОпределитьМестоРегистрации_ИнвентаризацияГосдолгаПоКредитамИГарантиям(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризацияКассы" Тогда
		ОпределитьМестоРегистрации_ИнвентаризацияКассы(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризацияИК" Тогда
		ОпределитьМестоРегистрации_ИнвентаризацияИК(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризацияМЗ" Тогда
		ОпределитьМестоРегистрации_ИнвентаризацияМЗ(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризацияОС" Тогда
		ОпределитьМестоРегистрации_ИнвентаризацияОС(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризацияРасчетовСКонтрагентами" Тогда
		ОпределитьМестоРегистрации_ИнвентаризацияРасчетовСКонтрагентами(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризацияРасчетовПоПоступлениям" Тогда
		ОпределитьМестоРегистрации_ИнвентаризацияРасчетовПоПоступлениям(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НомерПриложенияРаздела2) И Не ЗначениеЗаполнено(НомерПриложенияРаздела3) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаПриложения = СтрокаМестаРегистрации.ТаблицаПриложений.Добавить();
	СтрокаПриложения.СтрокаТаблицыОбъекты = СтрокаТаблицыОбъекты;
	СтрокаПриложения.СтрокаОписи = СтрокаОписи;
	
	Если ЗначениеЗаполнено(НомерПриложенияРаздела2) Тогда
		СтрокаМестаРегистрации.Раздел2 = Истина;
		
		СтрокаПриложения.НомерПриложенияРаздела2 = НомерПриложенияРаздела2;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерПриложенияРаздела3) Тогда
		СтрокаМестаРегистрации.Раздел3 = Истина;
		
		СтрокаПриложения.НомерПриложенияРаздела3 = НомерПриложенияРаздела3;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризацияЦенныхБумаг(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3)
	
	Если СтрокаОписи.КоличествоНедостача <> 0
		Или СтрокаОписи.КоличествоИзлишки <> 0
		Или СтрокаОписи.НоминальнаяСтоимостьНедостача <> 0
		Или СтрокаОписи.НоминальнаяСтоимостьВалютнаяНедостача <> 0
		Или СтрокаОписи.НоминальнаяСтоимостьИзлишки <> 0
		Или СтрокаОписи.НоминальнаяСтоимостьВалютнаяИзлишки <> 0 Тогда
		
		НомерПриложенияРаздела2 = 1;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризацияОстатковНаСчетах(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3)
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризацияКредитовИЗаймов(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3)
	
	Если СтрокаОписи.СуммаОДНеподтвержденнаяВалютная <> 0
		Или СтрокаОписи.СуммаОДНеподтвержденная <> 0
		Или СтрокаОписи.СуммаПроцентовНеподтвержденнаяВалютная <> 0
		Или СтрокаОписи.СуммаПроцентовНеподтвержденная <> 0
		Или СтрокаОписи.СуммаШтрафовНеподтвержденнаяВалютная <> 0
		Или СтрокаОписи.СуммаШтрафовНеподтвержденная <> 0
		Или СтрокаОписи.СуммаПенейНеподтвержденнаяВалютная <> 0
		Или СтрокаОписи.СуммаПенейНеподтвержденная <> 0 Тогда
		
		НомерПриложенияРаздела2 = 3;
	КонецЕсли;
	
	Если СтрокаОписи.СуммаОДПросроченнаяВалютная <> 0
		Или СтрокаОписи.СуммаОДПросроченная <> 0
		Или СтрокаОписи.СуммаПроцентовПросроченнаяВалютная <> 0
		Или СтрокаОписи.СуммаПроцентовПросроченная <> 0
		Или СтрокаОписи.СуммаШтрафовПросроченнаяВалютная <> 0
		Или СтрокаОписи.СуммаШтрафовПросроченная <> 0
		Или СтрокаОписи.СуммаПенейПросроченнаяВалютная <> 0
		Или СтрокаОписи.СуммаПенейПросроченная <> 0 Тогда
		
		НомерПриложенияРаздела3 = 1;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризацияГосдолгаВЦенныхБумагах(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3)
	
