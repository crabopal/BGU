	Таблица.Колонки.Добавить("ТипДокумента",				Новый ОписаниеТипов("Тип"));
	Таблица.Колонки.Добавить("УказываетсяВРазделе2",		Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("УказываетсяВРазделе3",		Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("НомераПриложенийКРазделу2",	Новый ОписаниеТипов("Массив"));
	Таблица.Колонки.Добавить("НомераПриложенийКРазделу3",	Новый ОписаниеТипов("Массив"));
	
	ТабличныеЧасти = Метаданные.Документы.АктИнвентаризации.ТабличныеЧасти;
	
	// Раздел 2
	УстановитьИспользованиеТиповОписейВРазделе(2, Таблица, ТабличныеЧасти);
	
	// Раздел 3
	УстановитьИспользованиеТиповОписейВРазделе(3, Таблица, ТабличныеЧасти);
	
	// Приложения к разделу 2
	УстановитьИспользованиеТиповОписейВПриложенияхКРазделу(2, Таблица, ТабличныеЧасти);
	
	// Приложения к разделу 3
	УстановитьИспользованиеТиповОписейВПриложенияхКРазделу(3, Таблица, ТабличныеЧасти);
	
	Возврат Таблица;
	
КонецФункции

Процедура УстановитьИспользованиеТиповОписейВРазделе(НомерРаздела, Таблица, ТабличныеЧасти)
	
	ИмяТабличнойЧасти = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
	
	ИмяКолонки = "УказываетсяВРазделе" + Формат(НомерРаздела, "ЧГ=0");
	
	Типы = ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты.Опись.Тип.Типы();
	
	Поиск = Новый Структура();
	
	Для Каждого Тип Из Типы Цикл
		Поиск.Вставить("ТипДокумента", Тип);
		
		МассивСтрок = Таблица.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			МетаданныеОписи = Метаданные.НайтиПоТипу(Тип);
			
			СтрокаТаблицы = Таблица.Добавить();
			СтрокаТаблицы.ИмяДокумента = МетаданныеОписи.Имя;
			СтрокаТаблицы.ТипДокумента = Тип;
			СтрокаТаблицы.НомераПриложенийКРазделу2 = Новый Массив();
			СтрокаТаблицы.НомераПриложенийКРазделу3 = Новый Массив();
		Иначе
			СтрокаТаблицы = МассивСтрок[0];
		КонецЕсли;
		
		СтрокаТаблицы[ИмяКолонки] = Истина;
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьИспользованиеТиповОписейВПриложенияхКРазделу(НомерРаздела, Таблица, ТабличныеЧасти)
	
	ИмяКолонки = "НомераПриложенийКРазделу" + Формат(НомерРаздела, "ЧГ=0");
	
	Поиск = Новый Структура();
	
	Для НомерПриложения = 1 По ПолучитьКоличествоПриложенийКРазделу(НомерРаздела) Цикл
		ИмяТабличнойЧасти = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
		
		Реквизиты = ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты;
		
		Если Реквизиты.Найти("Опись") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Типы = Реквизиты.Опись.Тип.Типы();
		
		Для Каждого Тип Из Типы Цикл
			Поиск.Вставить("ТипДокумента", Тип);
			
			МассивСтрок = Таблица.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТаблицы = МассивСтрок[0];
			
			СтрокаТаблицы[ИмяКолонки].Добавить(НомерПриложения);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#Область ПолучениеНастроек

Функция НомераРазделовСПриложениями()
	
	НомераРазделов = Новый Массив();
	
	Для НомерРаздела = 1 По КоличествоРазделов() Цикл
		
		Если ПолучитьКоличествоПриложенийКРазделу(НомерРаздела) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НомераРазделов.Добавить(НомерРаздела);
		
	КонецЦикла;
	
	Возврат НомераРазделов;
	
КонецФункции

Функция ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела)
	
	Возврат СтрШаблон("Раздел%1", Формат(НомерРаздела, "ЧГ=0"));
	
КонецФункции

Функция ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела)
	
	Возврат СтрШаблон("Приложение%1кРазделу%2", Формат(НомерПриложения, "ЧГ=0"), Формат(НомерРаздела, "ЧГ=0"));
	
КонецФункции

Функция ПолучитьКоличествоПриложенийКРазделу(НомерРаздела)
	
	Если НомерРаздела = 2 Тогда
		Возврат КоличествоПриложенийКРазделу2();
		
	ИначеЕсли НомерРаздела = 3 Тогда
		Возврат КоличествоПриложенийКРазделу3();
		
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьНомерПриложенияПоКодуФормы(ИмяДокумента, НомерРаздела, ДополнительныеПараметры)
	
	КодФормы = ОпределитьКодФормыОписи(ИмяДокумента, ДополнительныеПараметры);
	
	ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
	
	КодыФормРаздела = ДополнительныеПараметры.КодыФорм[ИмяТЧРаздела];
	
	НомераПриложений = Новый Массив();
	
	Для Каждого Элемент Из КодыФормРаздела Цикл
		Если СтрРазделить(Элемент.Значение, ", ", Ложь).Найти(КодФормы) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НомераПриложений.Добавить(Элемент.Ключ);
	КонецЦикла;
	
	Если НомераПриложений.Количество() = 1 Тогда
		Возврат НомераПриложений[0];
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьКодФормыОписи(ИмяДокумента, ДополнительныеПараметры)
	
	Если ЗначениеЗаполнено(ИмяДокумента) Тогда
		Возврат ДополнительныеПараметры.КодыФорм.ДокументыОписей[ИмяДокумента];
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ПолучитьИмяДокумента(ОписьСсылка, ДополнительныеПараметры)
	
	СтрокаТаблицы = ДополнительныеПараметры.ТаблицаНастроек.Найти(ТипЗнч(ОписьСсылка), "ТипДокумента");
	
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СтрокаТаблицы.ИмяДокумента;
	
КонецФункции

