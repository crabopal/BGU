Процедура УдалитьНесопоставленныеСтрокиПриложенийРаздела(ДокументОбъект, НомерРаздела)
	
	Поиск = Новый Структура("ИдентификаторСтроки");
	
	ТЧРаздела = ДокументОбъект[ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела)];
	
	Для НомерПриложения = 1 По ПолучитьКоличествоПриложенийКРазделу(НомерРаздела) Цикл
		
		ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
		
		ТЧ = ДокументОбъект[ИмяТЧПриложения];
		
		КоличествоСтрок = ТЧ.Количество();
		
		Для Счетчик = 1 По КоличествоСтрок Цикл
			Индекс = КоличествоСтрок - Счетчик;
			
			СтрокаТаблицы = ТЧ[Индекс];
			
			ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
			
			МассивСтрок = ТЧРаздела.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() = 0 Тогда
				ТЧ.Удалить(СтрокаТаблицы);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область КодСтрокиПриложений

Функция ПолучитьМаксимальныеПорядковыеНомера(ТЧПриложения, ИсключитьСтрокуПриложения = Неопределено)
	
	СчетчикиПорядковыхНомеров = Новый Соответствие();
	
	Для Каждого СтрокаПриложения Из ТЧПриложения Цикл
		
		Если СтрокаПриложения = ИсключитьСтрокуПриложения Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтрокиРаздела = СтрокаПриложения.НомерСтрокиРаздела;
		
		Счетчик = СчетчикиПорядковыхНомеров.Получить(НомерСтрокиРаздела);
		
		Если Счетчик = Неопределено Тогда
			Счетчик = 0;
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
		
		СчетчикиПорядковыхНомеров.Вставить(НомерСтрокиРаздела, Счетчик);
		
	КонецЦикла;
	
	Возврат СчетчикиПорядковыхНомеров;
	
КонецФункции

Процедура РассчитатьПеремещенияСтрокПриложения(ФормаДокумента, ИмяТЧПриложения, ПараметрыУпорядочивания)
	
	Перем ТекущаяСтрокаПриложения;
	
	ПеремещениеСтрокПриложения = ФормаДокумента.ПеремещениеСтрокПриложения;
	
	ПеремещениеСтрокПриложения.Очистить();
	
	СчетчикиПорядковыхНомеров = Новый Соответствие();
	
	ЗаменыПорядковыхНомеров = Новый Массив();
	
	ТЧПриложения = ФормаДокумента.Объект[ИмяТЧПриложения];
	
	Если ПараметрыУпорядочивания <> Неопределено Тогда
		ТекущаяСтрокаПриложения = ТЧПриложения.НайтиПоИдентификатору(ПараметрыУпорядочивания.ИдТекущейСтрокиПриложения);
	КонецЕсли;
	
	Для Каждого СтрокаПриложения Из ТЧПриложения Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаПриложения.НомерСтрокиРаздела) Или Не ЗначениеЗаполнено(СтрокаПриложения.ПорядковыйНомер) Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтрокиРаздела	= СтрокаПриложения.НомерСтрокиРаздела;
		ПорядковыйНомер		= СтрокаПриложения.ПорядковыйНомер;
		
		Счетчик = СчетчикиПорядковыхНомеров.Получить(НомерСтрокиРаздела);
		
		Если Счетчик = Неопределено Тогда
			Счетчик = 0;
		КонецЕсли;
		
		Если ПараметрыУпорядочивания <> Неопределено И ПараметрыУпорядочивания.ДобавленаНоваяСтрокаПриложения
			И СтрокаПриложения = ТекущаяСтрокаПриложения Тогда
			// Новую строку добавляем только в конец таблицы.
			
			МаксимальныйПорядковыйНомер = ФормаДокумента.КэшКодыСтрокПриложений.МаксимальныеПорядковыеНомера[ИмяТЧПриложения].Получить(НомерСтрокиРаздела);
			
			Если МаксимальныйПорядковыйНомер = Неопределено Тогда
				МаксимальныйПорядковыйНомер = 1;
			КонецЕсли;
			
			НовыйПорядковыйНомер = МаксимальныйПорядковыйНомер;// + 1;
		Иначе
			Счетчик = Счетчик + 1;
			
			СчетчикиПорядковыхНомеров.Вставить(НомерСтрокиРаздела, Счетчик);
			
			НовыйПорядковыйНомер = Счетчик;
		КонецЕсли;
		
		НоваяСтрока = ПеремещениеСтрокПриложения.Добавить();
		НоваяСтрока.НомерСтроки				= СтрокаПриложения.НомерСтроки;
		НоваяСтрока.НомерСтрокиРаздела		= НомерСтрокиРаздела;
		НоваяСтрока.ПорядковыйНомер			= ПорядковыйНомер;
		НоваяСтрока.НовыйПорядковыйНомер	= НовыйПорядковыйНомер;
		НоваяСтрока.ИдСтроки				= СтрокаПриложения.ПолучитьИдентификатор();
		
		Если ПараметрыУпорядочивания <> Неопределено И Не ПараметрыУпорядочивания.ДобавленаНоваяСтрокаПриложения
			И СтрокаПриложения = ТекущаяСтрокаПриложения
			И ПорядковыйНомер <> НовыйПорядковыйНомер Тогда
			// Изменение положения строки внутри группы строк для текущей строки раздела.
			
			ЗаменыПорядковыхНомеров.Добавить(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	ПеремещениеСтрокПриложения.Сортировать("НомерСтрокиРаздела,НовыйПорядковыйНомер");
	
	Если ЗаменыПорядковыхНомеров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаПеремещенияТекущая = ЗаменыПорядковыхНомеров[0];
	
	// Если есть строки с такими же номерами, то меняем местами текущую строку с первой найденной строкой
	
	Поиск = Новый Структура("НомерСтрокиРаздела, ПорядковыйНомер");
	
	ЗаполнитьЗначенияСвойств(Поиск, СтрокаПеремещенияТекущая);
	
	МассивСтрок = ПеремещениеСтрокПриложения.НайтиСтроки(Поиск);
	
	СтрокаПеремещенияНовоеПоложение = Неопределено;
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл 
		Если СтрокаТаблицы = СтрокаПеремещенияТекущая Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПеремещенияНовоеПоложение = СтрокаТаблицы;
		
		Прервать;
	КонецЦикла;
	
	Если СтрокаПеремещенияНовоеПоложение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Перемещаем текущую строку
	
	ИндексПеремещенияТекущая		= ПеремещениеСтрокПриложения.Индекс(СтрокаПеремещенияТекущая);
	ИндексПеремещенияНовоеПоложение	= ПеремещениеСтрокПриложения.Индекс(СтрокаПеремещенияНовоеПоложение);
	
	Сдвиг = ИндексПеремещенияНовоеПоложение - ИндексПеремещенияТекущая;
	
	ПеремещениеСтрокПриложения.Сдвинуть(ИндексПеремещенияТекущая, Сдвиг);
	
	// Пересчитываем новые порядковые номера у всех последующих строк
	
	НачальныйИндексПересчета = Мин(ИндексПеремещенияТекущая, ИндексПеремещенияНовоеПоложение);
	
	НовыйПорядковыйНомер = Мин(СтрокаПеремещенияТекущая.НовыйПорядковыйНомер, СтрокаПеремещенияНовоеПоложение.НовыйПорядковыйНомер) - 1;
	
	НомерСтрокиРаздела = СтрокаПеремещенияТекущая.НомерСтрокиРаздела;
	
	Для Индекс = НачальныйИндексПересчета По ПеремещениеСтрокПриложения.Количество() - 1 Цикл
		НовыйПорядковыйНомер = НовыйПорядковыйНомер + 1;
		
		СтрокаПеремещения = ПеремещениеСтрокПриложения[Индекс];
		
		Если СтрокаПеремещения.НомерСтрокиРаздела <> НомерСтрокиРаздела Тогда
			Прервать;
		КонецЕсли;
		
		СтрокаПеремещения.НовыйПорядковыйНомер = НовыйПорядковыйНомер;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПереместитьСтрокиПриложения(ФормаДокумента, ИмяТЧПриложения, ПараметрыУпорядочивания = Неопределено)
	
	ПеремещениеСтрокПриложения = ФормаДокумента.ПеремещениеСтрокПриложения;
	
	ТЧПриложения = ФормаДокумента.Объект[ИмяТЧПриложения];

	Счетчик = 0;
	
	ПредыдущаяСтрокаТаблицы = Неопределено;
	
	Для Каждого СтрокаТаблицы Из ПеремещениеСтрокПриложения Цикл
		
		Счетчик = Счетчик + 1;
		
		СтрокаПриложения = ТЧПриложения.НайтиПоИдентификатору(СтрокаТаблицы.ИдСтроки);
		
		ИндексСтрокиПриложения = ТЧПриложения.Индекс(СтрокаПриложения);
		
		// Новый порядковый номер
		Если СтрокаТаблицы.ПорядковыйНомер <> СтрокаТаблицы.НовыйПорядковыйНомер Тогда
			НовыйКодСтроки = ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(СтрокаТаблицы.НомерСтрокиРаздела, СтрокаТаблицы.НовыйПорядковыйНомер);
			
			СтрокаПриложения.КодСтроки			= НовыйКодСтроки;
			СтрокаПриложения.НомерСтрокиРаздела	= СтрокаТаблицы.НомерСтрокиРаздела;
			СтрокаПриложения.ПорядковыйНомер	= СтрокаТаблицы.НовыйПорядковыйНомер;
		КонецЕсли;
		
		Сдвиг = Счетчик - (ИндексСтрокиПриложения + 1);
		
		Если Сдвиг = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТЧПриложения.Сдвинуть(ИндексСтрокиПриложения, Сдвиг);
		
		ПредыдущаяСтрокаТаблицы = СтрокаТаблицы;
		
	КонецЦикла;
	
	ПеремещениеСтрокПриложения.Очистить();
	
КонецПроцедуры

#КонецОбласти

