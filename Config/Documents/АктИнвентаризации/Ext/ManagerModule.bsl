Функция ПрочитатьТаблицуОбъектыРешения(РешениеСсылка, ПараметрыПроцедуры)
	
	ДанныеРешения = Документы.ИзменениеРешенияОПроведенииИнвентаризации.ПолучитьДанныеДляЗаполненияНаОсновании(РешениеСсылка, Неопределено);
	
	ТаблицаОбъекты = ДанныеРешения.ТаблицаОбъекты;
	
	Если ТаблицаОбъекты.Колонки.Найти("ТипИзменения") <> Неопределено Тогда
		УдалитьОтмененныеСтроки(ТаблицаОбъекты);
	КонецЕсли;
	
	КоличествоСтрок = ТаблицаОбъекты.Количество();
	
	// Отбор по дате инвентаризации и номеру комиссии.
	Для Счетчик = 1 По КоличествоСтрок Цикл
		Индекс = КоличествоСтрок - Счетчик;
		
		СтрокаТаблицы = ТаблицаОбъекты[Индекс];
		
		Если СтрокаТаблицы.ДатаИнвентаризации = ПараметрыПроцедуры.ШапкаДокумента.ДатаИнвентаризации
			И СтрокаТаблицы.НомерКомиссии = ПараметрыПроцедуры.ШапкаДокумента.НомерКомиссии Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаОбъекты.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	Возврат ТаблицаОбъекты;
	
КонецФункции

Процедура УдалитьОтмененныеСтроки(ТаблицаОбъекты)
	
	ТипИзмененияОтмена = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена;
	
	КоличествоСтрок = ТаблицаОбъекты.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		Индекс = КоличествоСтрок - Счетчик;
		
		СтрокаТаблицы = ТаблицаОбъекты[Индекс];
		
		Если СтрокаТаблицы.ТипИзменения = ТипИзмененияОтмена Тогда
			ТаблицаОбъекты.Удалить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПустуюСтруктуруДанныхДляЗаполненияПоОписям()
	
	Данные = Новый Структура();
	Данные.Вставить("ТабличныеЧасти", Новый Структура());
	Данные.Вставить("НесопоставленныеСтрокиОписей");
	
	// Разделы 1, 2, 3
	
	Для НомерРаздела = 1 По КоличествоРазделов() Цикл
		ИмяТабличнойЧасти = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
		
		Данные.ТабличныеЧасти.Вставить(ИмяТабличнойЧасти, ПолучитьПустуюТаблицуТабличнойЧасти(ИмяТабличнойЧасти));
	КонецЦикла;
	
	// Приложения к разделу 2
	
	НомерРаздела = 2;

	Для НомерПриложения = 1 По ПолучитьКоличествоПриложенийКРазделу(НомерРаздела) Цикл
		ИмяТабличнойЧасти = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
		
		ПустаяТаблица = ПолучитьПустуюТаблицуТабличнойЧасти(ИмяТабличнойЧасти);
		
		ПустаяТаблица.Колонки.Добавить("КодСтроки", Новый ОписаниеТипов("Строка"));
		
		Данные.ТабличныеЧасти.Вставить(ИмяТабличнойЧасти, ПустаяТаблица);
	КонецЦикла;
	
	// Приложения к разделу 3
	
	НомерРаздела = 3;
	
	Для НомерПриложения = 1 По ПолучитьКоличествоПриложенийКРазделу(НомерРаздела) Цикл
		ИмяТабличнойЧасти = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
		
		ПустаяТаблица = ПолучитьПустуюТаблицуТабличнойЧасти(ИмяТабличнойЧасти);
		
		ПустаяТаблица.Колонки.Добавить("КодСтроки", Новый ОписаниеТипов("Строка"));
		
		Данные.ТабличныеЧасти.Вставить(ИмяТабличнойЧасти, ПустаяТаблица);
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьПустуюТаблицуТабличнойЧасти(ИмяТабличнойЧасти)
	
	РеквизитыТЧ = Метаданные.Документы.АктИнвентаризации.ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты;
	
	Таблица = Новый ТаблицаЗначений();
	
	Для Каждого Реквизит Из РеквизитыТЧ Цикл
		Таблица.Колонки.Добавить(Реквизит.Имя, Новый ОписаниеТипов(Реквизит.Тип.Типы()));
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьДополнительныеПараметрыДляЗаполненияПоОписям()
	
	// Используется при добавлении строк в приложения
	ДобавленныеСтрокиОписей = Новый Соответствие();
	ДобавленныеСтрокиОписей.Вставить(2, Новый Массив());
	ДобавленныеСтрокиОписей.Вставить(3, Новый Массив());
	
	// Используется при добавлении строк в приложения
	СтрокиРазделовБезПриложения = Новый Соответствие();
	СтрокиРазделовБезПриложения.Вставить(2, Новый Массив());
	СтрокиРазделовБезПриложения.Вставить(3, Новый Массив());
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("КодыФорм", КодыФорм());
	ДополнительныеПараметры.Вставить("НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению", ПодготовитьНастройкиИзТаблицыНастроекЗаполненияОписейПоРешению());
	
	ДополнительныеПараметры.Вставить("ДобавленныеСтрокиОписей",		ДобавленныеСтрокиОписей);
	ДополнительныеПараметры.Вставить("СтрокиРазделовБезПриложения",	СтрокиРазделовБезПриложения);
	
	ДополнительныеПараметры.Вставить("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ДополнительныеПараметры.Вставить("ИспользоватьУчетПоИФО",				ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

Процедура ИсключитьСопоставленныеНомераСтрок(НесопоставленныеСтрокиОписей, ТаблицаОбъекты, Поиск)
	
	Для Каждого СтрокаТаблицыОбъекты Из ТаблицаОбъекты Цикл
		
		ТаблицаСопоставленияОписей = СтрокаТаблицыОбъекты.ТаблицаСопоставленияОписей;
		
		Для Каждого СопоставленнаяСтрока Из ТаблицаСопоставленияОписей Цикл
			ЗаполнитьЗначенияСвойств(Поиск, СопоставленнаяСтрока);
			
			МассивСтрок = НесопоставленныеСтрокиОписей.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого Элемент Из СопоставленнаяСтрока.НомераСтрок Цикл
				НомерСтроки = Элемент.Ключ;
				
				Для Каждого НесопоставленнаяСтрока Из МассивСтрок Цикл
					Если НесопоставленнаяСтрока.НомераСтрок.Получить(НомерСтроки) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					НесопоставленнаяСтрока.НомераСтрок.Удалить(НомерСтроки);
				КонецЦикла;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьДанныеОписей(Данные, ТаблицыОписей, МестаРегистрацииОписей, ДополнительныеПараметры)
	
	Параметры = ПолучитьПараметрыДобавленияОписиВПриложение();
	
	Для Каждого МестоРегистрацииОписи Из МестаРегистрацииОписей Цикл
		
		Опись = МестоРегистрацииОписи.Опись;
		
		ИмяДокумента = ОпределитьИмяДокумента(Опись, ДополнительныеПараметры);
		
		Для НомерРаздела = 1 По КоличествоРазделов() Цикл
			
			ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
			
			Если Не МестоРегистрацииОписи[ИмяТЧРаздела] Тогда
				Продолжить;
			КонецЕсли;
			
			// Для раздела 1 отсутствуют приложения.
			
			Если НомерРаздела = 1 Тогда
				Для Каждого СтрокаТаблицыОбъекты Из МестоРегистрацииОписи.МассивСтрокТаблицыОбъекты Цикл
					НоваяСтрокаРаздела = ДобавитьСтрокуОписиВРаздел(Данные, ИмяТЧРаздела, СтрокаТаблицыОбъекты, МестоРегистрацииОписи, ИмяДокумента, ДополнительныеПараметры);
				КонецЦикла;
				
				Продолжить;
			КонецЕсли;
			
			// Для разделов 2, 3 предусмотрены приложения.
			// Если одна строка Решения сопоставлена с несколькими строками описей из нескольких различных приложений,
			// то в раздел по такой строке Решения добавляется столько строк, сколько определено различных приложений.
			
			ИмяКолонки = ПолучитьИмяКолонкиНомерПриложенияРаздела(НомерРаздела);
			
			СтрокиТаблицыПриложений = ОпределитьСтрокиТаблицыПриложений(МестоРегистрацииОписи, ИмяКолонки);
			
			Для Каждого СтрокаТаблицыПриложений Из СтрокиТаблицыПриложений Цикл
				
				СтрокаТаблицыОбъекты = СтрокаТаблицыПриложений.СтрокаТаблицыОбъекты;
				
				// Добавляем строку в раздел
				
				НоваяСтрокаРаздела = ДобавитьСтрокуОписиВРаздел(Данные, ИмяТЧРаздела, СтрокаТаблицыОбъекты, МестоРегистрацииОписи, ИмяДокумента, ДополнительныеПараметры);
				
				// Добавляем строки в соответствующее приложение
				
				НомерПриложения = СтрокаТаблицыПриложений[ИмяКолонки];
				
				НоваяСтрокаРаздела.НомерПриложения = НомерПриложения;
				
				Параметры.ИмяДокумента			= ИмяДокумента;
				Параметры.ТаблицаОписей			= ТаблицыОписей[ИмяДокумента];
				Параметры.НомерРаздела			= НомерРаздела;
				Параметры.НомерПриложения		= НомерПриложения;
				Параметры.СтрокаРаздела			= НоваяСтрокаРаздела;
				Параметры.МестоРегистрацииОписи	= МестоРегистрацииОписи;
				Параметры.СтрокаТаблицыОбъекты	= СтрокаТаблицыОбъекты;
				
				ДобавитьСтрокиОписиВПриложение(Данные.ТабличныеЧасти, Параметры, ДополнительныеПараметры);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УпорядочитьРазделыАкта(Данные)
	
	ПоляСортировки = "КодФормы,ДатаОписи,НомерОписи";
	
	Для НомерРаздела = 1 По КоличествоРазделов() Цикл
		Данные.ТабличныеЧасти[ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела)].Сортировать(ПоляСортировки);
	КонецЦикла;
	
КонецПроцедуры

Процедура УпорядочитьПриложенияАкта(Данные)
	
	ПоляСортировки = "НомерСтрокиРаздела,ПорядковыйНомер";
	
	Для НомерПриложения = 1 По КоличествоПриложенийКРазделу2() Цикл
		Данные.ТабличныеЧасти[ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, 2)].Сортировать(ПоляСортировки);
	КонецЦикла;
	
	Для НомерПриложения = 1 По КоличествоПриложенийКРазделу3() Цикл
		Данные.ТабличныеЧасти[ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, 3)].Сортировать(ПоляСортировки);
	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьСтрокиТаблицыПриложений(МестоРегистрацииОписи, ИмяКолонки)
	
	КолонкиГруппировки = "СтрокаТаблицыОбъекты," + ИмяКолонки;
	
	ВремТаблица = МестоРегистрацииОписи.ТаблицаПриложений.Скопировать(, КолонкиГруппировки);
	ВремТаблица.Свернуть(КолонкиГруппировки);
	
	Поиск = Новый Структура(ИмяКолонки, 0);
	
	Пока Истина Цикл
		МассивСтрок = ВремТаблица.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ВремТаблица.Удалить(МассивСтрок[0]);
	КонецЦикла;
	
	Возврат ВремТаблица;
	
КонецФункции

Функция ПолучитьИмяКолонкиНомерПриложенияРаздела(НомерРаздела)
	
	Возврат СтрШаблон("НомерПриложенияРаздела%1", Формат(НомерРаздела, "ЧГ=0"));
	
КонецФункции

Функция ДобавитьСтрокуОписиВРаздел(Данные, ИмяТЧРаздела, СтрокаТаблицыОбъекты, МестоРегистрацииОписи, ИмяДокумента, ДополнительныеПараметры)
	
	КолонкиРешения = "КФО,Счет,ДатаИнвентаризации,ДатаНачала,ДатаОкончания,МестоИнвентаризации,Примечание";
	
	НоваяСтрокаРаздела = Данные.ТабличныеЧасти[ИмяТЧРаздела].Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрокаРаздела, СтрокаТаблицыОбъекты, КолонкиРешения);
	
	НоваяСтрокаРаздела.ОтветственноеЛицо = СтрокаТаблицыОбъекты.Сотрудник;
	
	ЗаполнитьЗначенияСвойств(НоваяСтрокаРаздела, МестоРегистрацииОписи, "Опись,ДатаОписи");
	
	НомерОписи = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		МестоРегистрацииОписи.Опись,
		МестоРегистрацииОписи.НомерОписи);

	НоваяСтрокаРаздела.НомерОписи = НомерОписи;
	
	НоваяСтрокаРаздела.КодФормы = ОпределитьКодФормыОписи(ИмяДокумента, ДополнительныеПараметры);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрокаРаздела, "ИдентификаторСтроки") Тогда
		НоваяСтрокаРаздела.ИдентификаторСтроки = Новый УникальныйИдентификатор();
	КонецЕсли;
	
	Возврат НоваяСтрокаРаздела;
	
КонецФункции

Функция ПолучитьПараметрыДобавленияОписиВПриложение()
	
	Возврат Новый Структура("
		|ИмяДокумента,
		|ТаблицаОписей,
		|НомерРаздела,
		|НомерПриложения,
		|СтрокаРаздела,
		|МестоРегистрацииОписи,
		|СтрокаТаблицыОбъекты");
	
КонецФункции

Процедура ДобавитьСтрокиОписиВПриложение(ТабличныеЧасти, Параметры, ДополнительныеПараметры)
	
	ИмяДокумента			= Параметры.ИмяДокумента;
	ТаблицаОписей			= Параметры.ТаблицаОписей;
	НомерРаздела			= Параметры.НомерРаздела;
	НомерПриложения			= Параметры.НомерПриложения;
	СтрокаРаздела			= Параметры.СтрокаРаздела;
	МестоРегистрацииОписи	= Параметры.МестоРегистрацииОписи;
	СтрокаТаблицыОбъекты	= Параметры.СтрокаТаблицыОбъекты;
	
	ДобавленныеСтрокиОписейРаздела		= ДополнительныеПараметры.ДобавленныеСтрокиОписей.Получить(НомерРаздела);
	СтрокиРазделовБезПриложенияРаздела	= ДополнительныеПараметры.СтрокиРазделовБезПриложения.Получить(НомерРаздела);
	
	ИмяТабличнойЧастиПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ИмяКолонкиНомерПриложенияРаздела = ПолучитьИмяКолонкиНомерПриложенияРаздела(НомерРаздела);
	
	Поиск = Новый Структура(ИмяКолонкиНомерПриложенияРаздела, НомерПриложения);
	
	МассивСтрокРегистрации = МестоРегистрацииОписи.ТаблицаПриложений.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаРегистрации Из МассивСтрокРегистрации Цикл
		
		Если СтрокаТаблицыОбъекты <> Неопределено И СтрокаРегистрации.СтрокаТаблицыОбъекты <> СтрокаТаблицыОбъекты Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаОписи = СтрокаРегистрации.СтрокаОписи;
		
		Если ДобавленныеСтрокиОписейРаздела.Найти(СтрокаОписи) <> Неопределено Тогда
			Если СтрокиРазделовБезПриложенияРаздела.Найти(СтрокаРаздела) = Неопределено Тогда
				СтрокиРазделовБезПриложенияРаздела.Добавить(СтрокаРаздела);
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		ДобавленныеСтрокиОписейРаздела.Добавить(СтрокаОписи);
		
		НоваяСтрокаПриложения = ТабличныеЧасти[ИмяТабличнойЧастиПриложения].Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПриложения, СтрокаОписи);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПриложения, СтрокаРаздела, "Опись,НомерОписи,ДатаОписи,ИдентификаторСтроки");
		
		ЗаполнитьНовуюСтрокуПриложения(НоваяСтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры);
		
	КонецЦикла;
	
	ДополнительныеПараметры.ДобавленныеСтрокиОписей.Вставить(НомерРаздела, ДобавленныеСтрокиОписейРаздела);
	ДополнительныеПараметры.СтрокиРазделовБезПриложения.Вставить(НомерРаздела, СтрокиРазделовБезПриложенияРаздела);
	
КонецПроцедуры

Процедура УдалитьСтрокиРазделовБезПриложений(Данные, ДополнительныеПараметры)
	
	СтрокиРазделовБезПриложения = ДополнительныеПараметры.СтрокиРазделовБезПриложения;
	
	Для Каждого НомерРаздела Из НомераРазделовСПриложениями() Цикл
		
		СтрокиРазделовБезПриложенияРаздела = СтрокиРазделовБезПриложения.Получить(НомерРаздела);
		
		ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
		
		ТЧРаздела = Данные.ТабличныеЧасти[ИмяТЧРаздела];
		
		Количество = ТЧРаздела.Количество();
		
		Для Счетчик = 1 По Количество Цикл
			СтрокаРаздела = ТЧРаздела[Количество - Счетчик];
			
			Если СтрокиРазделовБезПриложенияРаздела.Найти(СтрокаРаздела) <> Неопределено Тогда
				ТЧРаздела.Удалить(СтрокаРаздела);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНастройкиВключенияОписейВАвтозаполнениеАкта(ДополнительныеПараметры, ВключатьОписи52н = Истина, ВключатьОписи61н = Истина)
	
	ПринадлежностьИменДокументовПриказам = ДополнительныеПараметры.НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению.ПринадлежностьИменДокументовПриказам;
	
	ДокументыОписей = КодыФорм().ДокументыОписей;
	
	ИменаДокументов = Новый Структура();
	
	ВключатьДокументыПриказа52н = Ложь;
	ВключатьДокументыПриказа61н = Ложь;
	
	Для Каждого Элемент Из ДокументыОписей Цикл
		ИмяДокумента = Элемент.Ключ;
		
		Если ПринадлежностьИменДокументовПриказам.Приказ52н.Найти(ИмяДокумента) <> Неопределено И ВключатьОписи52н Тогда
			ИменаДокументов.Вставить(ИмяДокумента, Истина);
			
			ВключатьДокументыПриказа52н = Истина;
		КонецЕсли;
		
		Если ПринадлежностьИменДокументовПриказам.Приказ61н.Найти(ИмяДокумента) <> Неопределено И ВключатьОписи61н Тогда
			ИменаДокументов.Вставить(ИмяДокумента, Истина);
			
			ВключатьДокументыПриказа61н = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Настройки = Новый Структура();
	Настройки.Вставить("ИменаДокументов", ИменаДокументов);
	Настройки.Вставить("ВключатьДокументыПриказа52н", ВключатьДокументыПриказа52н);
	Настройки.Вставить("ВключатьДокументыПриказа61н", ВключатьДокументыПриказа61н);
	
	Возврат Настройки;
	
КонецФункции

#Область Описи52н

Процедура ОпределитьМестаРегистрацииОписей52н(ШапкаДокумента, ТаблицаОбъекты, ДополнительныеПараметры, ОтборПоОписям = Неопределено, НастройкиВключенияОписей = Неопределено)
	
	ДобавитьТаблицыОписей52н(ШапкаДокумента, ДополнительныеПараметры, ОтборПоОписям, НастройкиВключенияОписей);
	
	СопоставитьСтрокиРешенияСОписями(ТаблицаОбъекты, ДополнительныеПараметры.Описи52н);
	
	ДобавитьМестаРегистрацииОписей(ТаблицаОбъекты, ДополнительныеПараметры.Описи52н);
	
КонецПроцедуры

Процедура ДобавитьТаблицыОписей52н(ШапкаДокумента, ДополнительныеПараметры, ОтборПоОписям = Неопределено, НастройкиВключенияОписей = Неопределено)
	
	Перем ДополнительныеТаблицы;
	
	ТаблицыОписей = ПрочитатьТаблицыОписей(ШапкаДокумента, ДополнительныеТаблицы, ДополнительныеПараметры, ОтборПоОписям, НастройкиВключенияОписей);
	
	ДобавитьДополнительныеПараметрыДляЗаполненияПоОписям52н(ДополнительныеПараметры, ТаблицыОписей, ШапкаДокумента.Организация);
	
	ОпределитьРодителейСчетовВТаблицах(ТаблицыОписей, ДополнительныеТаблицы);
	
	ДобавитьДополнительныеТаблицы(ДополнительныеПараметры.Описи52н, ДополнительныеТаблицы);

КонецПроцедуры

Процедура ДобавитьДополнительныеПараметрыДляЗаполненияПоОписям52н(ДополнительныеПараметры, ТаблицыОписей, Организация)
	
	ТаблицаНастроекЗаполненияОписейПоРешению = ИнвентаризацияСервер.ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(, Истина);
	
	ТаблицаНастроекЗаполненияОписейПоРешению.Индексы.Добавить("ИмяДокумента");
	ТаблицаНастроекЗаполненияОписейПоРешению.Индексы.Добавить("ТипОписи");
	
	Описи52н = Новый Структура();
	Описи52н.Вставить("ТаблицыОписей",								ТаблицыОписей);
	Описи52н.Вставить("ТаблицаНастроек",							ТаблицаТиповОписейПоРазделам());
	Описи52н.Вставить("СоответствиеСотрудников",					ПолучитьСоответствующихСотрудников(ТаблицыОписей, Организация));
	Описи52н.Вставить("ТаблицаНастроекЗаполненияОписейПоРешению",	ТаблицаНастроекЗаполненияОписейПоРешению);
	
	Макет0504087 = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ИнвентаризационнаяОписьНФА_0504087_194н");
	
	Описи52н.Вставить("Графа3_ВыводитьКодОС", ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет0504087, "Графа3_ВыводитьКодОС", Ложь));
	Описи52н.Вставить("Графа3_ВыводитьКодМЗ", ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет0504087, "Графа3_ВыводитьКодМЗ", Истина));
	
	// ИнвентаризацияГосдолгаВЦенныхБумагах
	Описи52н.Вставить("НастройкиВидЗадолженности0504084", НастройкиВидЗадолженности0504084());
	
	Поиск = Новый Структура();
	Поиск.Вставить("ИмяДокумента",	Новый Структура("ИмяДокумента"));
	Поиск.Вставить("ТипОписи",		Новый Структура("ТипОписи"));
	
	Описи52н.Вставить("Поиск", Поиск);
	Описи52н.Вставить("ТипыОписей", ПолучитьТипыОписей(ТаблицыОписей));
	
	ДополнительныеПараметры.Вставить("Описи52н", Описи52н);
	
КонецПроцедуры

Функция ПолучитьТипыОписей(ТаблицыОписей)
	
	ТипыОписей = Новый Соответствие();
	
	Для Каждого Элемент Из ТаблицыОписей Цикл
		
		ИмяДокумента	= Элемент.Ключ;
		ТаблицаОписей	= Элемент.Значение;
		
		ВремТаблица = ТаблицаОписей.Скопировать(, "Опись");
		ВремТаблица.Свернуть("Опись");
		
		Для Каждого СтрокаТаблицы Из ВремТаблица Цикл
			ТипыОписей.Вставить(СтрокаТаблицы.Опись, ТипЗнч(СтрокаТаблицы.Опись));
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТипыОписей;
	
КонецФункции

Функция ПолучитьСоответствующихСотрудников(ТаблицыОписей, Организация)
	
	Сотрудники = Новый Соответствие();
	
	ТипЦМО			= Тип("СправочникСсылка.ЦМО");
	ТипКонтрагент	= Тип("СправочникСсылка.Контрагенты");
	
	ЗначенияТипаЦМО			= Новый Массив();
	ЗначенияТипаКонтрагент	= Новый Массив();
	
	Для Каждого Элемент Из ТаблицыОписей Цикл
		ИмяДокумента = Элемент.Ключ;
		
		Таблица = Элемент.Значение;
		
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			ОтветственноеЛицо = СтрокаТаблицы.ОтветственноеЛицо;
			
			Если Не ЗначениеЗаполнено(ОтветственноеЛицо) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(ОтветственноеЛицо) = ТипЦМО И ЗначенияТипаЦМО.Найти(ОтветственноеЛицо) = Неопределено Тогда
				ЗначенияТипаЦМО.Добавить(ОтветственноеЛицо);
				
			ИначеЕсли ТипЗнч(ОтветственноеЛицо) = ТипКонтрагент И ЗначенияТипаКонтрагент.Найти(ОтветственноеЛицо) = Неопределено Тогда
				ЗначенияТипаКонтрагент.Добавить(ОтветственноеЛицо);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ЗначенияТипаЦМО.Количество() = 0 И ЗначенияТипаКонтрагент.Количество() = 0 Тогда
		Возврат Сотрудники;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Организация",				Организация);
	ЗапросПоиск.УстановитьПараметр("ЗначенияТипаЦМО",			ЗначенияТипаЦМО);
	ЗапросПоиск.УстановитьПараметр("ЗначенияТипаКонтрагент",	ЗначенияТипаКонтрагент);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Ссылка		КАК ТекущееЗначение,
	|	Сотрудник	КАК НовоеЗначение
	|ИЗ
	|	Справочник.ЦМО
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И Ссылка В(&ЗначенияТипаЦМО)
	|	И Владелец = &Организация
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Контрагент		КАК ТекущееЗначение,
	|	МИНИМУМ(Ссылка)	КАК НовоеЗначение
	|ИЗ
	|	Справочник.Сотрудники
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И Контрагент В(&ЗначенияТипаКонтрагент)
	|	И Владелец = &Организация
	|СГРУППИРОВАТЬ ПО
	|	Контрагент";	
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Сотрудники.Вставить(Выборка.ТекущееЗначение, Выборка.НовоеЗначение);
	КонецЦикла;
	
	Возврат Сотрудники;
	
КонецФункции

Процедура ОпределитьРодителейСчетовВТаблицах(ТаблицыОписей, ДополнительныеТаблицы)
	
	ОпределитьРодителейСчетов(ТаблицыОписей);
	
	ОпределитьРодителейСчетов(ДополнительныеТаблицы.ИнвентаризацияКассы,			"СписокСчетов");
	ОпределитьРодителейСчетов(ДополнительныеТаблицы.ИнвентаризацияОстатковНаСчетах,	"СписокСчетов");
	
КонецПроцедуры
	
Процедура ОпределитьРодителейСчетов(ТаблицыОписей, ИмяКлюча = Неопределено)
	
	МассивСчетов = ПолучитьСчетаИзОписей(ТаблицыОписей);
	
	КоличествоРодителейСчетов = 4;
	
	РодителиСчетов = ИнвентаризацияСервер.ПолучитьРодителейСчетов(МассивСчетов, КоличествоРодителейСчетов);
	
	Для Каждого Элемент Из ТаблицыОписей Цикл
		ИмяДокумента	= Элемент.Ключ;
		ТаблицаОписей	= Элемент.Значение;
		
		Если ИмяКлюча <> Неопределено И ИмяДокумента <> ИмяКлюча Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаОписей.Колонки.Добавить("СсылкиРодителейСчета", Новый ОписаниеТипов("Массив"));
		
		Поиск = Новый Структура();
		
		Для Каждого СтрокаТаблицы Из ТаблицаОписей Цикл
			
			Счет = СтрокаТаблицы.Счет;
			
			Если Не ЗначениеЗаполнено(Счет) Или ТипЗнч(Счет) <> Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
				Продолжить;
			КонецЕсли;
			
			Поиск.Вставить("Ссылка", Счет);
			
			МассивСтрок = РодителиСчетов.НайтиСтроки(Поиск);
			
			СвойстваСчета = МассивСтрок[0];
			
			МассивСсылок = Новый Массив();
			
			Для УровеньРодителя = 1 По КоличествоРодителейСчетов Цикл
				
				УровеньРодителяСтрокой = Формат(УровеньРодителя, "ЧГ=0");
				
				ИмяПоляСсылка = "Родитель" + УровеньРодителяСтрокой + "Ссылка";
				
				Ссылка = СвойстваСчета[ИмяПоляСсылка];
				
				Если Не ЗначениеЗаполнено(Ссылка) Тогда
					Продолжить;
				КонецЕсли;
				
				МассивСсылок.Добавить(Ссылка);
				
			КонецЦикла;
			
			СтрокаТаблицы["СсылкиРодителейСчета"] = МассивСсылок;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСчетаИзОписей(ТаблицыОписей)
	
	МассивСчетов = Новый Массив();
	
	Для Каждого Элемент Из ТаблицыОписей Цикл
		ИмяДокумента	= Элемент.Ключ;
		ТаблицаОписей	= Элемент.Значение;
		
		СчетаОписи = ТаблицаОписей.ВыгрузитьКолонку("Счет");
		
		Для Каждого Счет Из СчетаОписи Цикл
			Если Не ЗначениеЗаполнено(Счет) Или ТипЗнч(Счет) <> Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
				Продолжить;
			КонецЕсли;
			
			Если МассивСчетов.Найти(Счет) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			МассивСчетов.Добавить(Счет);
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивСчетов;
	
КонецФункции

Процедура СопоставитьСтрокиРешенияСОписями(ТаблицаОбъекты, ДополнительныеПараметры)
	
	ТаблицыОписей = ДополнительныеПараметры.ТаблицыОписей;
	
	ИмяКолонки = "ТаблицаСопоставленияОписей";
	
	Если ТаблицаОбъекты.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		ТаблицаОбъекты.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("ТаблицаЗначений"));
	КонецЕсли;
	
	Поиск = Новый Структура("Опись,ИмяТабличнойЧасти");
	
	НесопоставленныеСтрокиОписей = ПолучитьПустуюТаблицуСопоставленияОписей();
	
	Для Каждого СтрокаТаблицыОбъекты Из ТаблицаОбъекты Цикл
		
		ТаблицаСопоставленияОписей = ПолучитьПустуюТаблицуСопоставленияОписей();
		
		Для Каждого Элемент Из ТаблицыОписей Цикл
			
			ИмяДокумента	= Элемент.Ключ;
			ТаблицаОписей	= Элемент.Значение;
			
			Если СтрокаТаблицыОбъекты.ИменаДокументов.Количество() > 0
				И СтрокаТаблицыОбъекты.ИменаДокументов.Найти(ИмяДокумента) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого СтрокаТаблицыОписей Из ТаблицаОписей Цикл
				
				Если СтрокаТаблицыОбъекты.МестоИнвентаризации = СтрокаТаблицыОписей.МестоИнвентаризации
					И СопоставленСчет(СтрокаТаблицыОбъекты, СтрокаТаблицыОписей, ИмяДокумента, ДополнительныеПараметры)
					И СопоставленСотрудник(СтрокаТаблицыОбъекты, СтрокаТаблицыОписей, ДополнительныеПараметры)
					И СопоставленКФО(СтрокаТаблицыОбъекты, СтрокаТаблицыОписей) Тогда
					
					ДобавитьНомерСтрокиОписи(ТаблицаСопоставленияОписей, СтрокаТаблицыОписей, Поиск);
				Иначе
					ДобавитьНомерСтрокиОписи(НесопоставленныеСтрокиОписей, СтрокаТаблицыОписей, Поиск);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		СтрокаТаблицыОбъекты.ТаблицаСопоставленияОписей = ТаблицаСопоставленияОписей;
		
	КонецЦикла;
	
	ИсключитьСопоставленныеНомераСтрок(НесопоставленныеСтрокиОписей, ТаблицаОбъекты, Поиск);
	
	ДополнительныеПараметры.Вставить("НесопоставленныеСтрокиОписей", НесопоставленныеСтрокиОписей);
	
КонецПроцедуры

Функция ПолучитьПустуюТаблицуСопоставленияОписей()
	
	ТаблицаСопоставления = Новый ТаблицаЗначений();
	ТаблицаСопоставления.Колонки.Добавить("Опись");
	ТаблицаСопоставления.Колонки.Добавить("ДатаОписи",			ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	ТаблицаСопоставления.Колонки.Добавить("НомерОписи",			Новый ОписаниеТипов("Строка"));
	ТаблицаСопоставления.Колонки.Добавить("ИмяТабличнойЧасти",	Новый ОписаниеТипов("Строка"));
	ТаблицаСопоставления.Колонки.Добавить("НомераСтрок",		Новый ОписаниеТипов("Соответствие"));
	
	ТаблицаСопоставления.Колонки.Добавить("СопоставленыОтклонения",	Новый ОписаниеТипов("Булево"));
	ТаблицаСопоставления.Колонки.Добавить("СопоставленОтбор",		Новый ОписаниеТипов("Булево"));
	
	ТаблицаСопоставления.Индексы.Добавить("Опись,ИмяТабличнойЧасти");
	
	Возврат ТаблицаСопоставления;
	
КонецФункции

Функция СопоставленКФО(СтрокаТаблицыОбъекты, СтрокаТаблицыОписей)
	
	Если СтрокаТаблицыОписей.КФО = Неопределено Тогда
		// В описи не указывается КФО.
		// Считаем, что в таком случае сопоставление успешно выполнено.
		Возврат Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицыОбъекты.КФО) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат (СтрокаТаблицыОбъекты.КФО = СтрокаТаблицыОписей.КФО);
	
КонецФункции

Функция СопоставленСчет(СтрокаТаблицыОбъекты, СтрокаТаблицыОписей, ИмяДокумента, ДополнительныеПараметры)
	
	Если СтрокаТаблицыОписей.Счет = Неопределено Тогда
		// В описи не указывается счет.
		// Определяем соответствие вида документа описи и настройки счетов для такого вида документа описи.
		Возврат ДокументОписиСоответствуетСчетуИзРешения(СтрокаТаблицыОбъекты.Счет, ИмяДокумента, ДополнительныеПараметры);
	КонецЕсли;
	
	Если СтрокаТаблицыОписей.Счет = "Дополнительная таблица" Тогда
		// В описи счет указывается в отдельной табличной части.
		Возврат СписокСчетовОписиСоответствуетСчетуИзРешения(СтрокаТаблицыОбъекты, СтрокаТаблицыОписей, ИмяДокумента, ДополнительныеПараметры);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицыОбъекты.Счет) Или Не ЗначениеЗаполнено(СтрокаТаблицыОписей.Счет) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СтрокаТаблицыОбъекты.Счет = СтрокаТаблицыОписей.Счет Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрокаТаблицыОписей.СсылкиРодителейСчета.Количество() > 0
		И СтрокаТаблицыОписей.СсылкиРодителейСчета.Найти(СтрокаТаблицыОбъекты.Счет) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ДокументОписиСоответствуетСчетуИзРешения(СчетИзРешения, ИмяДокумента, ДополнительныеПараметры)
	
	ДополнительныеПараметры.Поиск.ИмяДокумента.ИмяДокумента = ИмяДокумента;
	
	МассивСтрок = ДополнительныеПараметры.ТаблицаНастроекЗаполненияОписейПоРешению.НайтиСтроки(ДополнительныеПараметры.Поиск.ИмяДокумента);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаКодовСчетов = МассивСтрок[0].ТаблицаКодовСчетов;
	
	// Сопоставление счета выполняется по аналогии с ИнвентаризацияСервер.СопоставитьТаблицыОбъектовИНастроек
	Для Каждого СтрокаТаблицыКодов Из ТаблицаКодовСчетов Цикл
		
		Если СтрокаТаблицыКодов.СсылкиСчетов.Найти(СчетИзРешения) <> Неопределено
			Или СтрокаТаблицыКодов.СсылкиРодителейСчетов.Найти(СчетИзРешения) <> Неопределено Тогда
			
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция СписокСчетовОписиСоответствуетСчетуИзРешения(СтрокаТаблицыОбъекты, СтрокаТаблицыОписей, ИмяДокумента, ДополнительныеПараметры)
	
	СчетИзРешения = СтрокаТаблицыОбъекты.Счет;
	
	Поиск = Новый Структура("Опись", СтрокаТаблицыОписей.Опись);
	
	МассивСтрок = ДополнительныеПараметры.ДополнительныеТаблицы[ИмяДокумента].СписокСчетов.НайтиСтроки(Поиск);
	
	// Сопоставление счета выполняется по аналогии с ИнвентаризацияСервер.СопоставитьТаблицыОбъектовИНастроек
	Для Каждого СтрокаСпискаСчетов Из МассивСтрок Цикл
		
		Если СтрокаСпискаСчетов.Счет = СчетИзРешения
			Или СтрокаСпискаСчетов.СсылкиРодителейСчета.Найти(СчетИзРешения) <> Неопределено Тогда
			
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция СопоставленСотрудник(СтрокаТаблицыОбъекты, СтрокаТаблицыОписей, ДополнительныеПараметры)
	
	Если Не ЕстьРеквизитМОЛ(СтрокаТаблицыОписей, ДополнительныеПараметры) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицыОбъекты.Сотрудник) И Не ЗначениеЗаполнено(СтрокаТаблицыОписей.ОтветственноеЛицо) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицыОбъекты.Сотрудник) Или Не ЗначениеЗаполнено(СтрокаТаблицыОписей.ОтветственноеЛицо) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СтрокаТаблицыОбъекты.Сотрудник = СтрокаТаблицыОписей.ОтветственноеЛицо Тогда
		Возврат Истина;
	КонецЕсли;
	
	Сотрудник = ДополнительныеПараметры.СоответствиеСотрудников.Получить(СтрокаТаблицыОписей.ОтветственноеЛицо);
	
	Если СтрокаТаблицыОбъекты.Сотрудник = Сотрудник Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЕстьРеквизитМОЛ(СтрокаТаблицыОписей, ДополнительныеПараметры)
	
	ДополнительныеПараметры.Поиск.ТипОписи.ТипОписи = ДополнительныеПараметры.ТипыОписей.Получить(СтрокаТаблицыОписей.Опись);
	
	МассивСтрок = ДополнительныеПараметры.ТаблицаНастроекЗаполненияОписейПоРешению.НайтиСтроки(ДополнительныеПараметры.Поиск.ТипОписи);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НастройкаОписи = МассивСтрок[0];
	
	Возврат ЗначениеЗаполнено(НастройкаОписи.ИмяРеквизитаМОЛ);
	
КонецФункции	

Процедура ДобавитьНомерСтрокиОписи(ТаблицаСопоставленияОписей, СтрокаТаблицыОписей, Поиск)
	
	Если ТаблицаСопоставленияОписей.Количество() = 0 Тогда
		СтрокаТаблицы = ТаблицаСопоставленияОписей.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаТаблицыОписей);
		
		СтрокаТаблицы.НомераСтрок = Новый Соответствие();
	Иначе
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицыОписей);
		
		МассивСтрок = ТаблицаСопоставленияОписей.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			СтрокаТаблицы = ТаблицаСопоставленияОписей.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаТаблицыОписей);
			
			СтрокаТаблицы.НомераСтрок = Новый Соответствие();
		Иначе
			СтрокаТаблицы = МассивСтрок[0];
		КонецЕсли;
	КонецЕсли;
	
	НомерСтроки = СтрокаТаблицыОписей.НомерСтроки;
	
	СтрокаТаблицы.НомераСтрок.Вставить(НомерСтроки);
		
КонецПроцедуры

Функция ПрочитатьТаблицыОписей(ДокументОбъект, ДополнительныеТаблицы, ДополнительныеПараметры, ОтборПоОписям = Неопределено, НастройкиВключенияОписей = Неопределено)
	
	Перем ЭлементыИмени, ДополнительноеЗначение;
	
	ПрименитьОтборПоОписям = (ОтборПоОписям <> Неопределено);
	
	ДополнительныеТаблицы = Новый Структура();
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаРУКод = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВалютаРУ, "Код");
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Решение",						ДокументОбъект.РешениеОПроведенииИнвентаризации);
	ЗапросПоиск.УстановитьПараметр("ДатаИнвентаризации",			ДокументОбъект.ДатаИнвентаризации);
	ЗапросПоиск.УстановитьПараметр("ПрименитьОтборПоОписям",		ПрименитьОтборПоОписям);
	ЗапросПоиск.УстановитьПараметр("ОтборПоОписям",					ОтборПоОписям);
	ЗапросПоиск.УстановитьПараметр("ПрименитьОтборПоПодразделению",	ДополнительныеПараметры.ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(ДокументОбъект.Подразделение));
	ЗапросПоиск.УстановитьПараметр("Подразделение",					ДокументОбъект.Подразделение);
	
	// ИнвентаризацияОС, ИнвентаризацияИК
	ЗапросПоиск.УстановитьПараметр("ЕдИзмШт",	Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	ЗапросПоиск.УстановитьПараметр("СчетаМЗ",	Документы.ИнвентаризацияИК.ПолучитьСчетаУчетаМЗ());
	
	ЗапросПоиск.УстановитьПараметр("ВалютаРУ",		ВалютаРУ);
	ЗапросПоиск.УстановитьПараметр("ВалютаРУКод",	ВалютаРУКод);
	
	// ИнвентаризацияГосдолгаВЦенныхБумагах
	Настройки = НастройкиВидЗадолженности0504084();
	ЗапросПоиск.УстановитьПараметр("СчетаВнутреннийДолг0504084",	Настройки.Счета.ВнутреннийДолг);
	ЗапросПоиск.УстановитьПараметр("СчетаВнешнийДолг0504084",		Настройки.Счета.ВнешнийДолг);
	
	// ИнвентаризацияГосдолгаПоКредитамИГарантиям
	Настройки = НастройкиВидЗадолженности0504085();
	ЗапросПоиск.УстановитьПараметр("СчетаВнутреннийДолг0504085",	Настройки.Счета.ВнутреннийДолг);
	
	// ИнвентаризацияКассы
	ЗапросПоиск.УстановитьПараметр("Счет03",	БухгалтерскийУчет.СчетПоКоду("03"));
	ЗапросПоиск.УстановитьПараметр("Счет20135",	БухгалтерскийУчет.СчетПоКоду("201.35"));
	ЗапросПоиск.УстановитьПараметр("Счет08",	БухгалтерскийУчет.СчетПоКоду("08"));
	
	ИндексыТаблиц = Новый Структура();
	
	ИндексыТаблиц.Вставить("ПоследнийДобавленныйИндекс", -1);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаПоискОписей52н(ИндексыТаблиц, НастройкиВключенияОписей);
	
	УпорядочитьИндексыПодзапросов(ЗапросПоиск.Текст);
	
	ИндексыТаблиц.Удалить("ПоследнийДобавленныйИндекс");
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	ТаблицыОписей = Новый Структура();
	
	Для Каждого Элемент Из ИндексыТаблиц Цикл
		ИмяДокумента	= Элемент.Ключ;
		ИндексТаблицы	= Элемент.Значение;
		
		Таблица = РезультатыЗапроса[ИндексТаблицы].Выгрузить();
		
		Если ЭтоОбозначениеДополнительнойТаблицы(ИмяДокумента, ЭлементыИмени) Тогда
			
			ДополнительныеТаблицы.Свойство(ЭлементыИмени.ИмяДокумента, ДополнительноеЗначение);
			
			Если ДополнительноеЗначение = Неопределено Тогда
				ДополнительноеЗначение = Новый Структура();
			КонецЕсли;
			
			ДополнительноеЗначение.Вставить(ЭлементыИмени.ИмяТаблицы, Таблица);
			
			ДополнительныеТаблицы.Вставить(ЭлементыИмени.ИмяДокумента, ДополнительноеЗначение);
		Иначе
			ТаблицыОписей.Вставить(ИмяДокумента, Таблица);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицыОписей;
	
КонецФункции

Функция ПолучитьТекстЗапросаПоискОписей52н(ИндексыТаблиц, НастройкиВключенияОписей = Неопределено)
	
	ВключатьВсеОписи = (НастройкиВключенияОписей = Неопределено);
	
	Тексты = Новый Массив();
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризацияЦенныхБумаг") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризацияЦенныхБумаг(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризацияОстатковНаСчетах") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризацияОстатковНаСчетах(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризацияКредитовИЗаймов") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризацияКредитовИЗаймов(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризацияГосдолгаВЦенныхБумагах") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризацияГосдолгаВЦенныхБумагах(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризацияГосдолгаПоКредитамИГарантиям") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризацияГосдолгаПоКредитамИГарантиям(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризацияКассы") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризацияКассы(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризацияИК") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризацияИК(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризацияМЗ") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризацияМЗ(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризацияОС") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризацияОС(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризацияРасчетовСКонтрагентами") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризацияРасчетовСКонтрагентами(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризацияРасчетовПоПоступлениям") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризацияРасчетовПоПоступлениям(ИндексыТаблиц));
	КонецЕсли;
	
	Возврат СтрСоединить(Тексты, "");
	
КонецФункции

Функция ЭтоОбозначениеДополнительнойТаблицы(ИмяКлюча, ЭлементыИмени = Неопределено)
	
	МассивИмен = СтрРазделить(ИмяКлюча, "_");
	
	Если МассивИмен.Количество() <> 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЭлементыИмени = Новый Структура();
	ЭлементыИмени.Вставить("ИмяДокумента", МассивИмен[0]);
	ЭлементыИмени.Вставить("ИмяТаблицы", МассивИмен[1]);
	
	Возврат Истина;
	
КонецФункции

Процедура ДобавитьДополнительныеТаблицы(ДополнительныеПараметры, ДополнительныеТаблицы)
	
	ДополнительныеПараметры.Вставить("ДополнительныеТаблицы", Новый Структура());
	
	Для Каждого Элемент Из ДополнительныеТаблицы Цикл
		ДополнительныеПараметры.ДополнительныеТаблицы.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Описи61н

Процедура ОпределитьМестаРегистрацииОписей61н(ШапкаДокумента, ТаблицаОбъекты, ДополнительныеПараметры, ОтборПоОписям = Неопределено, НастройкиВключенияОписей = Неопределено)
	
	ДобавитьТаблицыОписей61н(ШапкаДокумента, ДополнительныеПараметры, ОтборПоОписям, НастройкиВключенияОписей);
	
	СопоставитьСтрокиРешенияСОписями61н(ТаблицаОбъекты, ДополнительныеПараметры);
	
	ДобавитьМестаРегистрацииОписей61н(ТаблицаОбъекты, ДополнительныеПараметры);
	
КонецПроцедуры

Процедура ДобавитьТаблицыОписей61н(ШапкаДокумента, ДополнительныеПараметры, ОтборПоОписям = Неопределено, НастройкиВключенияОписей = Неопределено)
	
	ТаблицыОписей = ПрочитатьТаблицыОписей61н(ШапкаДокумента, ДополнительныеПараметры, ОтборПоОписям, НастройкиВключенияОписей);
	
	ДобавитьДополнительныеПараметрыДляЗаполненияПоОписям61н(ДополнительныеПараметры, ТаблицыОписей);
	
	ЗаполнитьРодителейСчетовВТаблицахВыявленныхОтклоненийОписей61н(ТаблицыОписей);
	
КонецПроцедуры

Функция ПрочитатьТаблицыОписей61н(ДокументОбъект, ДополнительныеПараметры, ОтборПоОписям = Неопределено, НастройкиВключенияОписей = Неопределено)
	
	//Перем ЭлементыИмени, ДополнительноеЗначение;
	Перем ТаблицыДокумента;
	
	ПрименитьОтборПоОписям = (ОтборПоОписям <> Неопределено);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Решение",						ДокументОбъект.РешениеОПроведенииИнвентаризации);
	ЗапросПоиск.УстановитьПараметр("ДатаИнвентаризации",			ДокументОбъект.ДатаИнвентаризации);
	ЗапросПоиск.УстановитьПараметр("НомерКомиссии",					ДокументОбъект.НомерКомиссии);
	ЗапросПоиск.УстановитьПараметр("ПрименитьОтборПоОписям",		ПрименитьОтборПоОписям);
	ЗапросПоиск.УстановитьПараметр("ОтборПоОписям",					ОтборПоОписям);
	ЗапросПоиск.УстановитьПараметр("ПрименитьОтборПоПодразделению",	ДополнительныеПараметры.ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(ДокументОбъект.Подразделение));
	ЗапросПоиск.УстановитьПараметр("Подразделение",					ДокументОбъект.Подразделение);
	
	// 0510468
	ЗапросПоиск.УстановитьПараметр("СтатусыЗадолженностиНеАктив", ПолучитьСтатусыЗадолженностиНеАктив0510468());
	
	ИндексыТаблиц = Новый Структура();
	
	ИндексыТаблиц.Вставить("ПоследнийДобавленныйИндекс", -1);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаПоискОписей61н(ИндексыТаблиц, НастройкиВключенияОписей);
	
	УпорядочитьИндексыПодзапросов(ЗапросПоиск.Текст);
	
	ИндексыТаблиц.Удалить("ПоследнийДобавленныйИндекс");
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	ТаблицыОписей = Новый Структура();
	
	Для Каждого Элемент Из ИндексыТаблиц Цикл
		МассивИмен = СтрРазделить(Элемент.Ключ, "_");
		
		ИмяДокумента	= МассивИмен[0];
		ИмяТаблицы		= МассивИмен[1];
		ИндексТаблицы	= Элемент.Значение;
		
		Таблица = РезультатыЗапроса[ИндексТаблицы].Выгрузить();
		
		Таблица.Индексы.Добавить("Ссылка");
		
		Если Не ТаблицыОписей.Свойство(ИмяДокумента, ТаблицыДокумента) Тогда
			ТаблицыДокумента = Новый Структура();
			
			ТаблицыОписей.Вставить(ИмяДокумента, ТаблицыДокумента);
		КонецЕсли;
		
		ТаблицыДокумента.Вставить(ИмяТаблицы, Таблица);
	КонецЦикла;
	
	Возврат ТаблицыОписей;
	
КонецФункции

Функция ПолучитьТекстЗапросаПоискОписей61н(ИндексыТаблиц, НастройкиВключенияОписей = Неопределено)
	
	ВключатьВсеОписи = (НастройкиВключенияОписей = Неопределено);
	
	Тексты = Новый Массив();
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризационнаяОписьБСО") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьБСО(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризационнаяОписьНФА") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьНФА(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризационнаяОписьОстатковНаСчетах") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьОстатковНаСчетах(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризационнаяОписьРасчетовПоПоступлениям") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьРасчетовПоПоступлениям(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям(ИндексыТаблиц));
	КонецЕсли;
	
	Возврат СтрСоединить(Тексты, "");
	
КонецФункции

Процедура ЗаполнитьРодителейСчетовВТаблицахВыявленныхОтклоненийОписей61н(ТаблицыОписей)
	
	ОбщийМассивСчетов = ПолучитьСчетаВыявленныхОтклоненийИзВсехОписей61н(ТаблицыОписей);
	
	Для Каждого Элемент Из ТаблицыОписей Цикл
		ИмяДокумента		= Элемент.Ключ;
		ТаблицыДокумента	= Элемент.Значение;
		
		Если ИмяДокумента = "ИнвентаризационнаяОписьНФА" Тогда
			ЗаполнитьРодителейСчетов61н(ТаблицыДокумента.ВыявленныеОтклонения, ОбщийМассивСчетов);
			
		ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
			ЗаполнитьРодителейСчетов61н(ТаблицыДокумента.ВыявленныеОтклоненияРаздел21, ОбщийМассивСчетов);
			ЗаполнитьРодителейСчетов61н(ТаблицыДокумента.ВыявленныеОтклоненияРаздел22, ОбщийМассивСчетов);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
	
Процедура ЗаполнитьРодителейСчетов61н(Таблица, ОбщийМассивСчетов)
	
	Таблица.Колонки.Добавить("СсылкиРодителейСчета", Новый ОписаниеТипов("Массив"));
	
	КоличествоРодителейСчетов = 4;
	
	РодителиСчетов = ИнвентаризацияСервер.ПолучитьРодителейСчетов(ОбщийМассивСчетов, КоличествоРодителейСчетов);
	
	Поиск = Новый Структура("Ссылка");
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Счет = СтрокаТаблицы.Счет;
		
		Если Не ЗначениеЗаполнено(Счет) Или ТипЗнч(Счет) <> Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
			Продолжить;
		КонецЕсли;
		
		Поиск.Ссылка = Счет;
		
		МассивСтрок = РодителиСчетов.НайтиСтроки(Поиск);
		
		СвойстваСчета = МассивСтрок[0];
		
		МассивСсылок = Новый Массив();
		
		Для УровеньРодителя = 1 По КоличествоРодителейСчетов Цикл
			УровеньРодителяСтрокой = Формат(УровеньРодителя, "ЧГ=0");
			
			ИмяПоляСсылка = "Родитель" + УровеньРодителяСтрокой + "Ссылка";
			
			Ссылка = СвойстваСчета[ИмяПоляСсылка];
			
			Если Не ЗначениеЗаполнено(Ссылка) Тогда
				Продолжить;
			КонецЕсли;
			
			МассивСсылок.Добавить(Ссылка);
		КонецЦикла;
		
		СтрокаТаблицы.СсылкиРодителейСчета = МассивСсылок;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСчетаВыявленныхОтклоненийИзВсехОписей61н(ТаблицыОписей)
	
	МассивСчетов = Новый Массив();
	
	Для Каждого Элемент Из ТаблицыОписей Цикл
		ИмяДокумента		= Элемент.Ключ;
		ТаблицыДокумента	= Элемент.Значение;
		
		Если ИмяДокумента = "ИнвентаризационнаяОписьНФА" Тогда
			СчетаОписи = ТаблицыДокумента.ВыявленныеОтклонения.ВыгрузитьКолонку("Счет");
			
		ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
			СчетаОписи = ТаблицыДокумента.ВыявленныеОтклоненияРаздел21.ВыгрузитьКолонку("Счет");
			
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаОписи, ТаблицыДокумента.ВыявленныеОтклоненияРаздел22.ВыгрузитьКолонку("Счет"));
		Иначе
			Продолжить;
		КонецЕсли;
		
		Для Каждого Счет Из СчетаОписи Цикл
			Если Не ЗначениеЗаполнено(Счет) Или ТипЗнч(Счет) <> Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
				Продолжить;
			КонецЕсли;
			
			Если МассивСчетов.Найти(Счет) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			МассивСчетов.Добавить(Счет);
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивСчетов;
	
КонецФункции

Процедура ДобавитьНомерСтрокиОписи61н(ТаблицаСопоставленияОписей, СтрокаТаблицыОписи, ШапкаОписи, РезультатыСопоставления, ИмяТаблицыОтклонений = Неопределено, СопоставленыОтклонения = Ложь, СопоставленОтбор = Ложь)

	Если ТаблицаСопоставленияОписей.Количество() = 0 Тогда
		СтрокаТаблицы = ТаблицаСопоставленияОписей.Добавить();
		
		СтрокаТаблицы.Опись			= ШапкаОписи.Ссылка;
		СтрокаТаблицы.ДатаОписи		= ШапкаОписи.Дата;
		СтрокаТаблицы.НомерОписи	= ШапкаОписи.Номер;
		
		СтрокаТаблицы.НомераСтрок = Новый Соответствие();
	Иначе
		РезультатыСопоставления.ПоискОписиВТаблицеСопоставления.Опись = ШапкаОписи.Ссылка;
		РезультатыСопоставления.ПоискОписиВТаблицеСопоставления.ИмяТабличнойЧасти = ?(ЗначениеЗаполнено(ИмяТаблицыОтклонений), ИмяТаблицыОтклонений, "");
		
		МассивСтрок = ТаблицаСопоставленияОписей.НайтиСтроки(РезультатыСопоставления.ПоискОписиВТаблицеСопоставления);
		
		Если МассивСтрок.Количество() = 0 Тогда
			СтрокаТаблицы = ТаблицаСопоставленияОписей.Добавить();
			
			СтрокаТаблицы.Опись			= ШапкаОписи.Ссылка;
			СтрокаТаблицы.ДатаОписи		= ШапкаОписи.Дата;
			СтрокаТаблицы.НомерОписи	= ШапкаОписи.Номер;
			
			СтрокаТаблицы.НомераСтрок = Новый Соответствие();
		Иначе
			СтрокаТаблицы = МассивСтрок[0];
		КонецЕсли;
	КонецЕсли;
	
	СтрокаТаблицы.ИмяТабличнойЧасти = ?(ЗначениеЗаполнено(ИмяТаблицыОтклонений), ИмяТаблицыОтклонений, "");
	
	НомерСтроки = СтрокаТаблицыОписи.НомерСтроки;
	
	СтрокаТаблицы.НомераСтрок.Вставить(НомерСтроки);
	
	Если СопоставленыОтклонения Тогда
		СтрокаТаблицы.СопоставленыОтклонения = Истина;
	КонецЕсли;
	
	Если СопоставленОтбор Тогда
		СтрокаТаблицы.СопоставленОтбор = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьШапкуОписи61нПриЗаполненииСтрокиПриложения(СтрокаОписи, Параметры, ДополнительныеПараметры)
	
	Поиск = ДополнительныеПараметры.Описи61н.РезультатыРасчета.РезультатыСопоставления.ПоискОписиВДанныхОписей;
	
	Поиск.Ссылка = СтрокаОписи.Ссылка;
	
	Возврат Параметры.ТаблицаОписей.Шапки.НайтиСтроки(Поиск)[0];
	
КонецФункции

Процедура СопоставитьСтрокиРешенияСОписями61н(ТаблицаОбъекты, ДополнительныеПараметры)
	
	ТаблицыОписей = ДополнительныеПараметры.Описи61н.ТаблицыОписей;
	
	ИмяКолонки = "ТаблицаСопоставленияОписей";
	
	Если ТаблицаОбъекты.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		ТаблицаОбъекты.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("ТаблицаЗначений"));
	КонецЕсли;
	
	РезультатыСопоставления = Новый Структура();
	РезультатыСопоставления.Вставить("СопоставленныеСтрокеРешения",		ПолучитьПустуюТаблицуСопоставленияОписей());
	РезультатыСопоставления.Вставить("Несопоставленные",				ПолучитьПустуюТаблицуСопоставленияОписей());
	РезультатыСопоставления.Вставить("ПоискОписиВТаблицеСопоставления",	Новый Структура("Опись,ИмяТабличнойЧасти"));
	РезультатыСопоставления.Вставить("ПоискОписиВДанныхОписей",			Новый Структура("Ссылка"));
	
	Для Каждого СтрокаТаблицыОбъекты Из ТаблицаОбъекты Цикл
		
		Для Каждого ЭлементТаблицыОписей Из ТаблицыОписей Цикл
			ИмяДокумента		= ЭлементТаблицыОписей.Ключ;
			ТаблицыДокумента	= ЭлементТаблицыОписей.Значение;
			
			Если СтрокаТаблицыОбъекты.ИменаДокументов.Количество() > 0
				И СтрокаТаблицыОбъекты.ИменаДокументов.Найти(ИмяДокумента) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ИменаПрочитанныхТаблицВыявленныхОтклонений = ДополнительныеПараметры.НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению.СоответствиеИмяДокументаИменаПрочитанныхТаблицВыявленныхОтклонений.Получить(ИмяДокумента);
			
			Для Каждого ИмяТаблицыОтклонений Из ИменаПрочитанныхТаблицВыявленныхОтклонений Цикл
				Если ТаблицыДокумента[ИмяТаблицыОтклонений].Количество() > 0 Тогда
					СопоставитьВыявленныеОтклоненияОписей61н(СтрокаТаблицыОбъекты, ТаблицыДокумента, ИмяДокумента, ИмяТаблицыОтклонений, РезультатыСопоставления);
				КонецЕсли;
			КонецЦикла;
			
			СопоставитьОтборыОписей61н(СтрокаТаблицыОбъекты, ТаблицыДокумента, ИмяДокумента, РезультатыСопоставления, ДополнительныеПараметры);
		КонецЦикла;
		
		СтрокаТаблицыОбъекты.ТаблицаСопоставленияОписей = РезультатыСопоставления.СопоставленныеСтрокеРешения;
		
		РезультатыСопоставления.Вставить("СопоставленныеСтрокеРешения", ПолучитьПустуюТаблицуСопоставленияОписей());
		
	КонецЦикла;
	
	ПоискОписи = Новый Структура("Опись");
	
	ИсключитьСопоставленныеНомераСтрок(РезультатыСопоставления.Несопоставленные, ТаблицаОбъекты, ПоискОписи);
	
	ДополнительныеПараметры.Описи61н.РезультатыРасчета.Вставить("РезультатыСопоставления", РезультатыСопоставления);
	
КонецПроцедуры

Функция ПолучитьИменаПрочитанныхТаблицВыявленныхОтклоненийОписи61н(ИмяДокумента)
	
	ИменаТаблиц = Новый Массив();
	
	Если ИмяДокумента = "ИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
		ИменаТаблиц.Добавить("ВыявленныеОтклоненияРаздел21");
		ИменаТаблиц.Добавить("ВыявленныеОтклоненияРаздел22");
		
	ИначеЕсли ИмяДокумента = "УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
		ИменаТаблиц.Добавить("ВыявленныеОтклоненияРаздел21");
		ИменаТаблиц.Добавить("ВыявленныеОтклоненияРаздел22");
		
	Иначе
		ИменаТаблиц.Добавить("ВыявленныеОтклонения");
	КонецЕсли;
	
	Возврат ИменаТаблиц;
	
КонецФункции

Функция ПолучитьСтатусыЗадолженностиНеАктив0510468()
	
	СтатусыЗадолженностиНеАктив = Новый Массив();
	
	СтатусыЗадолженностиНеАктив.Добавить(Перечисления.СтатусыЗадолженности.СИстекшимСрокомДавности);
	
	Возврат СтатусыЗадолженностиНеАктив;
	
КонецФункции

// Сопоставление выявленных отклонений описей

Процедура СопоставитьВыявленныеОтклоненияОписей61н(СтрокаТаблицыОбъекты, ТаблицыДокумента, ИмяДокумента, ИмяТаблицыОтклонений, РезультатыСопоставления)
	
	ТекущаяОпись = Неопределено;
	
	ШапкаОписи = Неопределено;
	
	Для Каждого СтрокаОтклоненийОписей Из ТаблицыДокумента[ИмяТаблицыОтклонений] Цикл
		
		Если ТекущаяОпись <> СтрокаОтклоненийОписей.Ссылка Тогда
			ТекущаяОпись = СтрокаОтклоненийОписей.Ссылка;
			
			РезультатыСопоставления.ПоискОписиВДанныхОписей.Ссылка = ТекущаяОпись;
			
			ШапкаОписи = ТаблицыДокумента.Шапки.НайтиСтроки(РезультатыСопоставления.ПоискОписиВДанныхОписей)[0];
		КонецЕсли;
		
		Если СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н(ИмяДокумента, СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи) Тогда
			ДобавитьНомерСтрокиОписи61н(РезультатыСопоставления.СопоставленныеСтрокеРешения, СтрокаОтклоненийОписей, ШапкаОписи, РезультатыСопоставления, ИмяТаблицыОтклонений, Истина);
		Иначе
			ДобавитьНомерСтрокиОписи61н(РезультатыСопоставления.Несопоставленные, СтрокаОтклоненийОписей, ШапкаОписи, РезультатыСопоставления, ИмяТаблицыОтклонений);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н(ИмяДокумента, СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Если ИмяДокумента = "ИнвентаризационнаяОписьБСО" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьБСО(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьНФА" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьНФА(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьОстатковНаСчетах" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьОстатковНаСчетах(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
		
	ИначеЕсли ИмяДокумента = "УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьБСО(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СтрокаТаблицыОбъекты.Сотрудник = ШапкаОписи.МОЛ
		И СтрокаТаблицыОбъекты.МестоИнвентаризации = ШапкаОписи.МестоИнвентаризации
		И СтрокаТаблицыОбъекты.Счет = ШапкаОписи.Счет
		И СтрокаТаблицыОбъекты.КФО = ШапкаОписи.КФО;
	
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьНФА(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СтрокаТаблицыОбъекты.Сотрудник = ШапкаОписи.МОЛ
		И СтрокаТаблицыОбъекты.МестоИнвентаризации = СтрокаОтклоненийОписей.МестоИнвентаризации
		И СопоставленСчетВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей)
		И СопоставленКФОВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей);
	
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьОстатковНаСчетах(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СтрокаТаблицыОбъекты.МестоИнвентаризации = ШапкаОписи.МестоИнвентаризации
		И СтрокаТаблицыОбъекты.КФО = ШапкаОписи.КФО
		И СтрокаТаблицыОбъекты.Счет = ШапкаОписи.Счет;
	
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СтрокаТаблицыОбъекты.МестоИнвентаризации = ШапкаОписи.МестоИнвентаризации
		И СопоставленСчетВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей)
		И СопоставленКФОВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей);
	
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СтрокаТаблицыОбъекты.МестоИнвентаризации = ШапкаОписи.МестоИнвентаризации
		И СтрокаТаблицыОбъекты.КФО = СтрокаТаблицыОбъекты.КФО
		И СтрокаТаблицыОбъекты.Счет = СтрокаТаблицыОбъекты.Счет;
	
КонецФункции

// Сопоставление отборов описей

Процедура СопоставитьОтборыОписей61н(СтрокаТаблицыОбъекты, ТаблицыДокумента, ИмяДокумента, РезультатыСопоставления, ДополнительныеПараметры)
	
	ФиктивнаяСтрокаОписи = Новый Структура("НомерСтроки", 0);
	
	Для Каждого ШапкаОписи Из ТаблицыДокумента.Шапки Цикл
		Если СтрокаРешенияСопоставленаСОтборомОписи61н(ИмяДокумента, СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыДокумента, ДополнительныеПараметры) Тогда
			ДобавитьНомерСтрокиОписи61н(РезультатыСопоставления.СопоставленныеСтрокеРешения, ФиктивнаяСтрокаОписи, ШапкаОписи, РезультатыСопоставления,,, Истина);
		Иначе
			ДобавитьНомерСтрокиОписи61н(РезультатыСопоставления.Несопоставленные, ФиктивнаяСтрокаОписи, ШапкаОписи, РезультатыСопоставления,,, Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция СтрокаРешенияСопоставленаСОтборомОписи61н(ИмяДокумента, СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыДокумента, ДополнительныеПараметры)
	
	// Опись считается сопоставленной, если поля связи в точности совпадают с полями строки Решения.
	// Если в описи поля связи указываются в табличной части, то сопоставление определяется
	// по наличию в табличной части значения из строки Решения.
	
	ТаблицыОтбораОписи = ПолучитьТаблицыОтбораОписи61н(ИмяДокумента, ШапкаОписи, ТаблицыДокумента, ДополнительныеПараметры);
	
	РасположенияРеквизитовОписи = ДополнительныеПараметры.НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению.СоответствиеИмяДокументаОписаниеРасположенияРеквизитовОписи.Получить(ИмяДокумента);
	
	Успех = СопоставленРеквизитОписи61н("Счет", СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыОтбораОписи, РасположенияРеквизитовОписи)
		И СопоставленРеквизитОписи61н("КФО", СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыОтбораОписи, РасположенияРеквизитовОписи)
		И СопоставленРеквизитОписи61н("Сотрудник", СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыОтбораОписи, РасположенияРеквизитовОписи)
		И СопоставленРеквизитОписи61н("МестоИнвентаризации", СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыОтбораОписи, РасположенияРеквизитовОписи);
	
	Если ИмяДокумента = "ИнвентаризационнаяОписьНФА" Тогда
		СтрокаРешенияСопоставленаСОтборомОписи61н_ИнвентаризационнаяОписьНФА(СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыДокумента, ДополнительныеПараметры, Успех);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
		СтрокаРешенияСопоставленаСОтборомОписи61н_ИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыДокумента, ДополнительныеПараметры, Успех);
		
	ИначеЕсли ИмяДокумента = "УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
		СтрокаРешенияСопоставленаСОтборомОписи61н_УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыДокумента, ДополнительныеПараметры, Успех);
	КонецЕсли;
	
	Возврат Успех;
	
КонецФункции

Процедура СтрокаРешенияСопоставленаСОтборомОписи61н_ИнвентаризационнаяОписьНФА(СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыДокумента, ДополнительныеПараметры, Успех)
	
	// Заголовочные документы серии в акт инвентаризации не включаем.
	
	Если ЗначениеЗаполнено(ШапкаОписи.ИдентификаторСерииДокументов) И ШапкаОписи.ЭтоЗаголовочныйДокумент Тогда
		Успех = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Процедура СтрокаРешенияСопоставленаСОтборомОписи61н_ИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыДокумента, ДополнительныеПараметры, Успех)
	
	// Заголовочные документы серии в акт инвентаризации не включаем.
	
	Если ЗначениеЗаполнено(ШапкаОписи.ИдентификаторСерииДокументов) И ШапкаОписи.ЭтоЗаголовочныйДокумент Тогда
		Успех = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Процедура СтрокаРешенияСопоставленаСОтборомОписи61н_УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыДокумента, ДополнительныеПараметры, Успех)
	
	// Заголовочные документы серии в акт инвентаризации не включаем.
	
	Если ЗначениеЗаполнено(ШапкаОписи.ИдентификаторСерииДокументов) И ШапкаОписи.ЭтоЗаголовочныйДокумент Тогда
		Успех = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТаблицыОтбораОписи61н(ИмяДокумента, ШапкаОписи, ТаблицыДокумента, ДополнительныеПараметры)
	
	ИменаТаблицОтбора = ДополнительныеПараметры.НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению.СоответствиеИмяДокументаИменаТаблицОтбора.Получить(ИмяДокумента);
	
	Поиск = Новый Структура("Ссылка", ШапкаОписи.Ссылка);
	
	ТаблицыОтбораОписи = Новый Структура();
	
	Для Каждого ИмяТаблицы Из ИменаТаблицОтбора Цикл
		ТаблицыОтбораОписи.Вставить(ИмяТаблицы, ТаблицыДокумента[ИмяТаблицы].Скопировать(Поиск));
	КонецЦикла;
	
	Возврат ТаблицыОтбораОписи;
	
КонецФункции

Функция СопоставленРеквизитОписи61н(ИмяРеквизита, СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыОтбораОписи, РасположенияРеквизитовОписи)
	
	ЗначениеРеквизитаВРешении = СтрокаТаблицыОбъекты[ИмяРеквизита];
	
	РасположениеРеквизита = РасположенияРеквизитовОписи[ИмяРеквизита];
	
	Если РасположениеРеквизита.РасположенВШапке Тогда
		Возврат ЗначениеРеквизитаВРешении = ШапкаОписи[РасположениеРеквизита.ИмяПоля];
		
	ИначеЕсли РасположениеРеквизита.РасположенВТабличнойЧасти Тогда
		Поиск = Новый Структура(РасположениеРеквизита.ИмяКолонки, ЗначениеРеквизитаВРешении);
		
		Если ЗначениеЗаполнено(РасположениеРеквизита.ИмяКолонкиПризнакИспользования) Тогда
			Поиск.Вставить(РасположениеРеквизита.ИмяКолонкиПризнакИспользования, "Истина");
		КонецЕсли;
		
		МассивСтрок = ТаблицыОтбораОписи[РасположениеРеквизита.ИмяТабличнойЧасти].НайтиСтроки(Поиск);
		
		Возврат (МассивСтрок.Количество() > 0);
		
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция СопоставленСчетВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей)
	
	Если СтрокаТаблицыОбъекты.Счет = СтрокаОтклоненийОписей.Счет Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрокаОтклоненийОписей.СсылкиРодителейСчета.Количество() > 0
		И СтрокаОтклоненийОписей.СсылкиРодителейСчета.Найти(СтрокаТаблицыОбъекты.Счет) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция СопоставленКФОВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей)
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицыОбъекты.КФО) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат (СтрокаТаблицыОбъекты.КФО = СтрокаОтклоненийОписей.КФО);
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ЗаполнениеПоОднойОписи

// Заполнение одного приложения по одной выбранной описи (при перемещении описи из раздела 1 в разделы 2, 3)

Функция ПолучитьДанныеЗаполненияПоОднойОписи(ДокументОбъект, Параметры)
	
	Перем ДополнительныеТаблицы;
	
	ОтборПоОписям = Новый Массив();
	ОтборПоОписям.Добавить(Параметры.Опись);
	
	ТЧРаздела = ДокументОбъект[ПолучитьИмяТабличнойЧастиРаздел(Параметры.НомерРаздела)];
	
	СтрокаРаздела = ТЧРаздела[Параметры.НомерСтрокиРаздела - 1];
	
	ТаблицаОбъекты = ПолучитьТаблицуОбъектыПриЗаполненииПоОднойОписи(СтрокаРаздела, ТЧРаздела);
	
	ДополнительныеПараметры = ПолучитьДополнительныеПараметрыДляЗаполненияПоОписям();
	
	ИмяДокумента = ОпределитьИмяДокумента(Параметры.Опись, ДополнительныеПараметры);
	
	ПринадлежностьОписиПриказам = ОпределитьПринадлежностьОписиПриказам(Параметры.Опись, ДополнительныеПараметры);
	
	Если ПринадлежностьОписиПриказам.Приказ52н Тогда
		ОпределитьМестаРегистрацииОписей52н(ДокументОбъект, ТаблицаОбъекты, ДополнительныеПараметры, ОтборПоОписям);
		
		МестаРегистрацииОписей = ДополнительныеПараметры.Описи52н.МестаРегистрацииОписей;
		
		ТаблицаОписей = ДополнительныеПараметры.Описи52н.ТаблицыОписей[ИмяДокумента];
		
	ИначеЕсли ПринадлежностьОписиПриказам.Приказ61н Тогда
		ОпределитьМестаРегистрацииОписей61н(ДокументОбъект, ТаблицаОбъекты, ДополнительныеПараметры, ОтборПоОписям);
		
		МестаРегистрацииОписей = ДополнительныеПараметры.Описи61н.РезультатыРасчета.МестаРегистрацииОписей;
		
		ТаблицаОписей = ДополнительныеПараметры.Описи61н.ТаблицыОписей[ИмяДокумента];
	КонецЕсли;
	
	УдалитьМестаРегистрацииОписейНеСоответствующиеНомеруПриложения(МестаРегистрацииОписей, Параметры.НомерРаздела, Параметры.НомерПриложения);
	
	ПараметрыДобавления = ПолучитьПараметрыДобавленияОписиВПриложение();
	
	ПараметрыДобавления.ИмяДокумента	= ИмяДокумента;
	ПараметрыДобавления.ТаблицаОписей	= ТаблицаОписей;
	ПараметрыДобавления.НомерРаздела	= Параметры.НомерРаздела;
	ПараметрыДобавления.НомерПриложения	= Параметры.НомерПриложения;
	ПараметрыДобавления.СтрокаРаздела	= СтрокаРаздела;
	
	Данные = ПолучитьПустуюСтруктуруДанныхДляЗаполненияПоОписям();
	
	Для Каждого МестоРегистрацииОписи Из МестаРегистрацииОписей Цикл
		ИмяКолонки = ПолучитьИмяКолонкиНомерПриложенияРаздела(Параметры.НомерРаздела);
		
		СтрокиТаблицыПриложений = ОпределитьСтрокиТаблицыПриложений(МестоРегистрацииОписи, ИмяКолонки);
		
		Для Каждого СтрокаТаблицыПриложений Из СтрокиТаблицыПриложений Цикл
			СтрокаТаблицыОбъекты = СтрокаТаблицыПриложений.СтрокаТаблицыОбъекты;
			
			// Добавляем строки в соответствующее приложение
			ПараметрыДобавления.МестоРегистрацииОписи	= МестоРегистрацииОписи;
			ПараметрыДобавления.СтрокаТаблицыОбъекты	= СтрокаТаблицыОбъекты;
			
			ДобавитьСтрокиОписиВПриложение(Данные.ТабличныеЧасти, ПараметрыДобавления, ДополнительныеПараметры);
		КонецЦикла;
	КонецЦикла;
	
	ЗаполнитьКодыСтрокДобавленныхСтрок(Данные.ТабличныеЧасти, СтрокаРаздела, Параметры.НомерРаздела, Параметры.НомерПриложения);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьТаблицуОбъектыПриЗаполненииПоОднойОписи(СтрокаРаздела, ТЧРаздела)
	
	// При заполнении по одной описи считаем, что Решение представлено одной строкой.
	// Это текущая строка раздела. Считывать полность документ Решения не требуется.
	
	МассивСтрок = Новый Массив();
	МассивСтрок.Добавить(СтрокаРаздела);
	
	ТаблицаОбъекты = ТЧРаздела.Выгрузить(МассивСтрок);
	
	ТаблицаОбъекты.Колонки.ОтветственноеЛицо.Имя = "Сотрудник";
	
	ИнвентаризацияСервер.ЗаполнитьИменаДокументовВТаблицеОбъектыРешения(ТаблицаОбъекты);
	
	Возврат ТаблицаОбъекты;
	
КонецФункции

Функция ОпределитьПринадлежностьОписиПриказам(Опись, ДополнительныеПараметры)
	
	ИмяДокумента = ОпределитьИмяДокумента(Опись, ДополнительныеПараметры);
	
	ПринадлежностьИменДокументовПриказам = ДополнительныеПараметры.НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению.ПринадлежностьИменДокументовПриказам;
	
	ПринадлежностьОписиПриказам = Новый Структура();
	ПринадлежностьОписиПриказам.Вставить("Приказ52н",	ПринадлежностьИменДокументовПриказам.Приказ52н.Найти(ИмяДокумента) <> Неопределено);
	ПринадлежностьОписиПриказам.Вставить("Приказ61н",	ПринадлежностьИменДокументовПриказам.Приказ61н.Найти(ИмяДокумента) <> Неопределено);
	
	Возврат ПринадлежностьОписиПриказам;
	
КонецФункции

Процедура УдалитьМестаРегистрацииОписейНеСоответствующиеНомеруПриложения(МестаРегистрацииОписей, НомерРаздела, НомерПриложения)
	
	Поиск = Новый Структура(ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела), Ложь);
	
	МассивСтрок = МестаРегистрацииОписей.НайтиСтроки(Поиск);
	
	Для Каждого УдаляемаяСтрока Из МассивСтрок Цикл
		МестаРегистрацииОписей.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
	Поиск = Новый Структура("НомерПриложенияРаздела" + НомерРаздела, НомерПриложения);
	
	Для Каждого СтрокаТаблицы Из МестаРегистрацииОписей Цикл
		СтрокаТаблицы.ТаблицаПриложений = СтрокаТаблицы.ТаблицаПриложений.Скопировать(Поиск);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКодыСтрокДобавленныхСтрок(ДокументОбъект, СтрокаРаздела, НомерРаздела, НомерПриложения)
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ТЧПриложения = ДокументОбъект[ИмяТЧПриложения];
	
	МаксимальныеПорядковыеНомера = ПолучитьМаксимальныеПорядковыеНомера(ТЧПриложения);
	
	МаксНомер = МаксимальныеПорядковыеНомера.Получить(СтрокаРаздела.НомерСтроки);
	
	Если МаксНомер = Неопределено Тогда
		МаксНомер = 0;
	КонецЕсли;
	
	ПорядковыйНомер = МаксНомер;
	
	Поиск = Новый Структура("ИдентификаторСтроки,ПорядковыйНомер",
		СтрокаРаздела.ИдентификаторСтроки,
		0);
	
	МассивСтрок = ТЧПриложения.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ПорядковыйНомер = ПорядковыйНомер + 1;
		
		СтрокаТаблицы.КодСтроки				= ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(СтрокаРаздела.НомерСтроки, ПорядковыйНомер);
		СтрокаТаблицы.НомерСтрокиРаздела	= СтрокаРаздела.НомерСтроки;
		СтрокаТаблицы.ПорядковыйНомер		= ПорядковыйНомер;
	КонецЦикла;
	
КонецПроцедуры

