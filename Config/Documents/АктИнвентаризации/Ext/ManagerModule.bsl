Процедура ЗаполнитьКодыСтрокПриложенийРазделаПоИдентификатору(ДокументОбъект, НомерРаздела)
	
	Поиск = Новый Структура("ИдентификаторСтроки");
	
	ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
	
	ТЧРаздела = ДокументОбъект[ИмяТЧРаздела];
	
	НомерСтрокиРаздела = 0;
	
	Для Каждого СтрокаРаздела Из ТЧРаздела Цикл
		НомерСтрокиРаздела = НомерСтрокиРаздела + 1;
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаРаздела);
		
		Для НомерПриложения = 1 По ПолучитьКоличествоПриложенийКРазделу(НомерРаздела) Цикл
			
			ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
			
			ТЧПриложения = ДокументОбъект[ИмяТЧПриложения];
			
			МассивСтрок = ТЧПриложения.НайтиСтроки(Поиск);
			
			Счетчик = 0;
			
			Для Каждого СтрокаПриложения Из МассивСтрок Цикл
				Счетчик = Счетчик + 1;
				
				СтрокаПриложения.КодСтроки			= ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(НомерСтрокиРаздела, Счетчик);
				СтрокаПриложения.НомерСтрокиРаздела	= НомерСтрокиРаздела;
				СтрокаПриложения.ПорядковыйНомер	= Счетчик;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьРеквизитыОписи(ОписьСсылка)
	
	РеквизитыОписи = Новый Структура("
		|Опись,
		|НомерОписи,
		|ДатаОписи,
		|ОтветственноеЛицо,
		|КФО,
		|Счет,
		|ДатаИнвентаризации,
		|ДатаНачала,
		|ДатаОкончания,
		|МестоИнвентаризации");
	
	РеквизитыОписи.Опись = ОписьСсылка;
	
	Если Не ЗначениеЗаполнено(ОписьСсылка) Тогда
		Возврат РеквизитыОписи;
	КонецЕсли;
	
	ИменаРеквизитов = СтрРазделить("Номер,Дата,ДатаИнвентаризации,ДатаНачала,ДатаОкончания", ", ", Ложь);
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(ТипЗнч(ОписьСсылка));
	
	СтрокаТаблицыНастроек = ТаблицаНастроек[0];
	
	ОписаниеРеквизитов = ИнвентаризацияСервер.ПолучитьОписаниеРасположенияРеквизитовОписи(СтрокаТаблицыНастроек);
	
	Если ОписаниеРеквизитов.Счет.РасположенВШапке Тогда
		ИменаРеквизитов.Добавить(ОписаниеРеквизитов.Счет.ИмяПоля);
	КонецЕсли;
	
	Если ОписаниеРеквизитов.КФО.РасположенВШапке Тогда
		ИменаРеквизитов.Добавить(ОписаниеРеквизитов.КФО.ИмяПоля);
	КонецЕсли;
	
	Если ОписаниеРеквизитов.Сотрудник.РасположенВШапке Тогда
		ИменаРеквизитов.Добавить(ОписаниеРеквизитов.Сотрудник.ИмяПоля);
	КонецЕсли;
	
	Если ОписаниеРеквизитов.МестоИнвентаризации.РасположенВШапке Тогда
		ИменаРеквизитов.Добавить(ОписаниеРеквизитов.МестоИнвентаризации.ИмяПоля);
	КонецЕсли;
	
	Свойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОписьСсылка, СтрСоединить(ИменаРеквизитов, ","));
	
	ЗаполнитьЗначенияСвойств(РеквизитыОписи, Свойства);
	
	РеквизитыОписи.НомерОписи = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		ОписьСсылка,
		Свойства.Номер);
		
	РеквизитыОписи.ДатаОписи = Свойства.Дата;
	
	Если ОписаниеРеквизитов.Счет.РасположенВШапке Тогда
		РеквизитыОписи.Счет = Свойства[ОписаниеРеквизитов.Счет.ИмяПоля];
	КонецЕсли;
	
	Если ОписаниеРеквизитов.КФО.РасположенВШапке Тогда
		РеквизитыОписи.КФО = Свойства[ОписаниеРеквизитов.КФО.ИмяПоля];
	КонецЕсли;
	
	Если ОписаниеРеквизитов.Сотрудник.РасположенВШапке Тогда
		РеквизитыОписи.ОтветственноеЛицо = Свойства[ОписаниеРеквизитов.Сотрудник.ИмяПоля];
	КонецЕсли;
	
	Если ОписаниеРеквизитов.МестоИнвентаризации.РасположенВШапке Тогда
		РеквизитыОписи.МестоИнвентаризации = Свойства[ОписаниеРеквизитов.МестоИнвентаризации.ИмяПоля];
	КонецЕсли;
	
	Возврат РеквизитыОписи;
	
КонецФункции

Процедура ОбновитьСведенияОбОписиВПриложениях(ДокументОбъект, НомерРаздела, ИдентификаторСтроки, РеквизитыОписи)
	
	Поиск = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	
	Для НомерПриложения = 1 По ПолучитьКоличествоПриложенийКРазделу(НомерРаздела) Цикл
		
		ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
		
		ТЧПриложения = ДокументОбъект[ИмяТЧПриложения];
		
		МассивСтрок = ТЧПриложения.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаПриложения Из МассивСтрок Цикл
			ЗаполнитьЗначенияСвойств(СтрокаПриложения, РеквизитыОписи);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьКодФормыИНомерПриложения(ОписьСсылка, НомерРаздела, ДополнительныеПараметры)
	
	Результат = Новый Структура("КодФормы,НомерПриложения");
	
	ИмяДокумента = ПолучитьИмяДокумента(ОписьСсылка, ДополнительныеПараметры);
	
	Результат.КодФормы = ОпределитьКодФормыОписи(ИмяДокумента, ДополнительныеПараметры);
	
	Если ПолучитьКоличествоПриложенийКРазделу(НомерРаздела) > 0 Тогда
		Результат.НомерПриложения = ОпределитьНомерПриложенияПоКодуФормы(ИмяДокумента, НомерРаздела, ДополнительныеПараметры);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьИндексТаблицы(НомераТаблиц, ИмяТаблицы, СдвигОтносительноПервогоПодзапроса = 0)
	
	ИндексТаблицы = НомераТаблиц.ПоследнийДобавленныйИндекс + 1 + СдвигОтносительноПервогоПодзапроса;
	
	НомераТаблиц.Вставить(ИмяТаблицы, ИндексТаблицы);
	
	НомераТаблиц.ПоследнийДобавленныйИндекс = ИндексТаблицы;
	
КонецПроцедуры

Процедура УпорядочитьИндексыПодзапросов(ТекстЗапроса)
	
	МаксимальнаяДлинаИндекса = 3; // в символах строки
	
	НачалоПоиска = "// [";
	ОкончаниеПоиска = "].";
	
	ДлинаНачалаПоиска = СтрДлина(НачалоПоиска);
	ДлинаОкончанияПоиска = СтрДлина(ОкончаниеПоиска);
	
	ТекущийИндекс = 0;
	
	Пока Истина Цикл
		ПозицияНачалаПоиска = СтрНайти(ТекстЗапроса, НачалоПоиска,,, ТекущийИндекс + 1);
		
		Если ПозицияНачалаПоиска = 0 Тогда
			// Завершились искомые символы
			Прервать;
		КонецЕсли;
		
		ПозицияОкончанияПоиска = СтрНайти(ТекстЗапроса, ОкончаниеПоиска,, ПозицияНачалаПоиска);
		
		Если ПозицияОкончанияПоиска = 0 Тогда
			// Ошибка форматирования исходной строки
			Прервать;
		КонецЕсли;
		
		ПозицияНачалаИндекса = ПозицияНачалаПоиска + ДлинаНачалаПоиска;
		ПозицияОкончанияИндекса = ПозицияОкончанияПоиска - 1;
		
		ДлинаИндекса = ПозицияОкончанияИндекса - ПозицияНачалаИндекса + 1;
		
		Если ДлинаИндекса > МаксимальнаяДлинаИндекса Тогда
			// Ошибка форматирования исходной строки
			Прервать;
		КонецЕсли;
		
		ТекстИндекса = Сред(ТекстЗапроса, ПозицияНачалаИндекса, ДлинаИндекса);
		
		Если Не ОбщегоНазначенияКлиентСервер.ЭтоЧисло(ТекстИндекса) Тогда
			// Ошибка форматирования исходной строки
			Прервать;
		КонецЕсли;
		
		ТекстЗапроса = Лев(ТекстЗапроса, ПозицияНачалаИндекса - 1) + Формат(ТекущийИндекс, "ЧГ=;ЧН=") + Сред(ТекстЗапроса, ПозицияОкончанияИндекса + 1);
		
		ТекущийИндекс = ТекущийИндекс + 1;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьДополнительныеПараметрыДляЗаполненияПоОписям61н(ДополнительныеПараметры, ТаблицыОписей)
	
	РезультатыРасчета = Новый Структура();
	
	Описи61н = Новый Структура();
	Описи61н.Вставить("ТаблицыОписей",					ТаблицыОписей);
	Описи61н.Вставить("РезультатыРасчета",				РезультатыРасчета);
	Описи61н.Вставить("СтатусыЗадолженностиНеАктив",	ПолучитьСтатусыЗадолженностиНеАктив0510468());
	
	ДополнительныеПараметры.Вставить("Описи61н", Описи61н);
	
КонецПроцедуры

Функция ОпределитьИмяДокумента(Опись, ДополнительныеПараметры)
	
	Возврат ДополнительныеПараметры.НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению.СоответствиеТипДокументаИмяДокумента.Получить(ТипЗнч(Опись));
	
КонецФункции

Функция ПодготовитьНастройкиИзТаблицыНастроекЗаполненияОписейПоРешению()
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекЗаполненияОписейПоРешению();
	
	Приказ52н = Новый Массив();
	Приказ61н = Новый Массив();
	СоответствиеТипДокументаИмяДокумента = Новый Соответствие();
	СоответствиеИмяДокументаОписаниеРасположенияРеквизитовОписи = Новый Соответствие();
	СоответствиеИмяДокументаИменаТаблицОтбора = Новый Соответствие();
	СоответствиеИмяДокументаИменаПрочитанныхТаблицВыявленныхОтклонений = Новый Соответствие();
	
	Для Каждого СтрокаТаблицыНастроек Из ТаблицаНастроек Цикл
		ИмяДокумента = СтрокаТаблицыНастроек.ИмяДокумента;
		
		Если СтрокаТаблицыНастроек.Приказ52н Тогда
			Приказ52н.Добавить(ИмяДокумента);
		КонецЕсли;
		
		Если СтрокаТаблицыНастроек.Приказ61н Тогда
			Приказ61н.Добавить(ИмяДокумента);
		КонецЕсли;
		
		СоответствиеТипДокументаИмяДокумента.Вставить(СтрокаТаблицыНастроек.ТипОписи, ИмяДокумента);
		
		ОписаниеРасположенияРеквизитовОписи = ИнвентаризацияСервер.ПолучитьОписаниеРасположенияРеквизитовОписи(СтрокаТаблицыНастроек);
		
		СоответствиеИмяДокументаОписаниеРасположенияРеквизитовОписи.Вставить(ИмяДокумента, ОписаниеРасположенияРеквизитовОписи);
		
		ИменаТаблицОтбора = Новый Массив();
		
		Для Каждого Элемент Из ОписаниеРасположенияРеквизитовОписи Цикл
			ИмяПоля			= Элемент.Ключ;
			ОписаниеПоля	= Элемент.Значение;
			
			Если ОписаниеПоля.РасположенВТабличнойЧасти И ИменаТаблицОтбора.Найти(ОписаниеПоля.ИмяТабличнойЧасти) = Неопределено Тогда
				ИменаТаблицОтбора.Добавить(ОписаниеПоля.ИмяТабличнойЧасти);
			КонецЕсли;
		КонецЦикла;
		
		СоответствиеИмяДокументаИменаТаблицОтбора.Вставить(ИмяДокумента, ИменаТаблицОтбора);
		
		СоответствиеИмяДокументаИменаПрочитанныхТаблицВыявленныхОтклонений.Вставить(ИмяДокумента, ПолучитьИменаПрочитанныхТаблицВыявленныхОтклоненийОписи61н(ИмяДокумента));
	КонецЦикла;
	
	ПринадлежностьИменДокументовПриказам = Новый Структура();
	ПринадлежностьИменДокументовПриказам.Вставить("Приказ52н", Приказ52н);
	ПринадлежностьИменДокументовПриказам.Вставить("Приказ61н", Приказ61н);
	
	Результат = Новый Структура();
	Результат.Вставить("ПринадлежностьИменДокументовПриказам", ПринадлежностьИменДокументовПриказам);
	Результат.Вставить("СоответствиеТипДокументаИмяДокумента", СоответствиеТипДокументаИмяДокумента);
	Результат.Вставить("СоответствиеИмяДокументаОписаниеРасположенияРеквизитовОписи", СоответствиеИмяДокументаОписаниеРасположенияРеквизитовОписи);
	Результат.Вставить("СоответствиеИмяДокументаИменаТаблицОтбора", СоответствиеИмяДокументаИменаТаблицОтбора);
	Результат.Вставить("СоответствиеИмяДокументаИменаПрочитанныхТаблицВыявленныхОтклонений", СоответствиеИмяДокументаИменаПрочитанныхТаблицВыявленныхОтклонений);
	
	Возврат Результат;
	
КонецФункции

#Область ЗаполнениеНаОсновании

Процедура ЗаполнитьНаОсновании_РешениеОПроведенииИнвентаризации(ДокументОбъект, ОснованиеСсылка)
	
	ОбобщенныеДанныеРешения = Документы.АктИнвентаризации.ПолучитьОбобщенныеДанныеРешения(ОснованиеСсылка);
	
	ТекстОшибки = ОбобщенныеДанныеРешения.ТекстОшибки;
	
	ЗначенияПараметров = Новый Структура("РешениеОПроведенииИнвентаризации,Организация,ДатаИнвентаризации,НомерКомиссии,Комиссия,ИФО,Подразделение");
	
	ЗначенияПараметров.РешениеОПроведенииИнвентаризации = ОбобщенныеДанныеРешения.Шапка.Решение;
	
	ЗаполнитьЗначенияСвойств(ЗначенияПараметров, ОбобщенныеДанныеРешения.Шапка, "Организация,ИФО,Подразделение");
	
	Если ОбобщенныеДанныеРешения.ЕдинственноеЗначение <> Неопределено Тогда
		Если ЗначениеЗаполнено(ОбобщенныеДанныеРешения.ЕдинственноеЗначение.ДатаИнвентаризации) Тогда
			ЗаполнитьЗначенияСвойств(ЗначенияПараметров, ОбобщенныеДанныеРешения.ЕдинственноеЗначение, "ДатаИнвентаризации");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОбобщенныеДанныеРешения.ЕдинственноеЗначение.НомерКомиссии) Тогда
			ЗаполнитьЗначенияСвойств(ЗначенияПараметров, ОбобщенныеДанныеРешения.ЕдинственноеЗначение, "НомерКомиссии,Комиссия");
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияПараметров);
	
	Если ЗначениеЗаполнено(ЗначенияПараметров.Комиссия) Тогда
		ТаблицаСостава = ОбщегоНазначенияБГУ.ПрочитатьТаблицуСоставаКомиссии(ЗначенияПараметров.Комиссия, Истина);
		
		ДокументОбъект.СоставКомиссии.Загрузить(ТаблицаСостава);
		
		ДокументОбъект.ОтветственныйИсполнитель = РаботаСКомиссиями.ПолучитьОтветственногоИсполнителяКомиссии(
			ЗначенияПараметров.Комиссия,, ЗначенияПараметров.ДатаИнвентаризации);
	КонецЕсли;
	
КонецПроцедуры

