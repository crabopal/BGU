Процедура ДобавитьУсловноеОформление_БлокировкаКолонокРазделов(ФормаДокумента)
	
	УсловноеОформление = ФормаДокумента.УсловноеОформление;
	
	ПредставлениеШаблон = НСтр("ru='Блокировка колонок раздела (для автоматически добавленных строк) (%1)'");
	
	ИменаЭлементов = ПолучитьИменаЭлементовБлокируемыхКолонокРазделов();
	
	Для Каждого ЭлементТЧ Из ИменаЭлементов Цикл
		
		ИмяТЧ			= ЭлементТЧ.Ключ;
		СтруктураИмен	= ЭлементТЧ.Значение;
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблон, ИмяТЧ);

		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТЧ + ".ДобавленоВручную");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Ложь;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

		// Оформляемые поля
		Для Каждого Элемент Из СтруктураИмен Цикл
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + Элемент.Ключ);
		КонецЦикла;
		
