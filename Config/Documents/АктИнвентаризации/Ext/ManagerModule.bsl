		НомерПриложенияРаздела2 = 7;
	КонецЕсли;
	
	Если СтрокаОписи.КоличествоНеСоответствует > 0 Или СтрокаОписи.СуммаНеСоответствует > 0 Тогда
		НомерПриложенияРаздела3 = 4;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризацияМЗ(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3)
	
	Если СтрокаОписи.НедостачаКоличество > 0 Или СтрокаОписи.ИзлишекКоличество > 0 Тогда
		НомерПриложенияРаздела2 = 7;
	КонецЕсли;
	
	Если СтрокаОписи.КоличествоНеСоответствует > 0 Или СтрокаОписи.СуммаНеСоответствует > 0 Тогда
		НомерПриложенияРаздела3 = 4;
	КонецЕсли;
	
