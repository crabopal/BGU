Процедура ИнициализироватьДопустимостьДобавленияСтрокТабличныхЧастей(ФормаДокумента)
	
	Элементы = ФормаДокумента.Элементы;
	
	ДопустимостьДобавленияСтрок = ДопустимостьДобавленияСтрок();
	
	Для Каждого Элемент Из ДопустимостьДобавленияСтрок Цикл
		
		ИмяТЧ = Элемент.Ключ;
		Допустимость = Элемент.Значение;
		
		ЭлементТаблицы = Элементы[ИмяТЧ];
		
		ЭлементТаблицы.ИзменятьСоставСтрок		= Допустимость;
		ЭлементТаблицы.ИзменятьПорядокСтрок		= Ложь;
		ЭлементТаблицы.ПоложениеКоманднойПанели	= ?(Допустимость, ПоложениеКоманднойПанелиЭлементаФормы.Авто, ПоложениеКоманднойПанелиЭлементаФормы.Нет);
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура ИнициализироватьСписокВыбораКодФормы(ФормаДокумента)
	
	ШаблонПредставления = "%1 (%2)";
	
	НаименованияОписей = НаименованияОписей();
	
	КодыФорм = КодыФорм();
	
	Для НомерРаздела = 1 По КоличествоРазделов() Цикл
		
		ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
		
		ЭлементФормы = ФормаДокумента.Элементы[ИмяТЧРаздела + "КодФормы"];
		
		ЭлементФормы.СписокВыбора.Очистить();
		
		СписокКодов = КодыФорм[ИмяТЧРаздела];
		
		Для Каждого Элемент Из СписокКодов Цикл
			
			Если ТипЗнч(Элемент) = Тип("Строка") Тогда
				КодФормы = Элемент;
			Иначе
				КодФормы = Элемент.Значение;
			КонецЕсли;
			
			МассивКодов = СтрРазделить(КодФормы, ", ", Ложь);
			
			Для Каждого КодФормы Из МассивКодов Цикл
				Если ЭлементФормы.СписокВыбора.НайтиПоЗначению(КодФормы) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				НаименованиеФормы = НаименованияОписей.Получить(КодФормы);
				
				Если НаименованиеФормы = Неопределено Тогда
					НаименованиеФормы = "";
				КонецЕсли;
				
				ЭлементФормы.СписокВыбора.Добавить(КодФормы, СтрШаблон(ШаблонПредставления, КодФормы, НаименованиеФормы));
			КонецЦикла;
			
		КонецЦикла;
		
		ЭлементФормы.СписокВыбора.СортироватьПоПредставлению();
		
	КонецЦикла;
	
КонецПроцедуры

