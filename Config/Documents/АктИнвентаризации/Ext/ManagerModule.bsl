Процедура ОпределитьМестоРегистрации_ИнвентаризацияРасчетовПоПоступлениям(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3)
	
	Если СтрокаОписи.НеПодтверждено <> 0 Тогда
		НомерПриложенияРаздела2 = 9;
	КонецЕсли;
	
	Если СтрокаОписи.ИстекСрокДавности <> 0 Тогда
		НомерПриложенияРаздела3 = 7;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Описи61н

Процедура ДобавитьМестаРегистрацииОписей61н(ТаблицаОбъекты, ДополнительныеПараметры)
	
	Перем ДобавитьВРаздел2, ДобавитьВРаздел3;
	
	ТаблицыОписей = ДополнительныеПараметры.Описи61н.ТаблицыОписей;
	
	РезультатыРасчета = ДополнительныеПараметры.Описи61н.РезультатыРасчета;
	
	ТаблицаМестаРегистрации = ПолучитьПустуюТаблицуМестаРегистрацииОписей();
	
	ПоискРегистрацииОпиcи = Новый Структура("Опись");
	
	ПоискВыявленногоОтклонения = Новый Структура("Ссылка,НомерСтроки");
	
	Для Каждого СтрокаТаблицыОбъекты Из ТаблицаОбъекты Цикл
		
		Для Каждого СтрокаСопоставления Из СтрокаТаблицыОбъекты.ТаблицаСопоставленияОписей Цикл
			
			Опись = СтрокаСопоставления.Опись;
			
			ПоискРегистрацииОпиcи.Опись = Опись;
			
			МассивСтрок = ТаблицаМестаРегистрации.НайтиСтроки(ПоискРегистрацииОпиcи);
			
			Если МассивСтрок.Количество() = 0 Тогда
				СтрокаМестаРегистрации = ТаблицаМестаРегистрации.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаМестаРегистрации, СтрокаСопоставления, "Опись,НомерОписи,ДатаОписи");
				
				СтрокаМестаРегистрации.ТаблицаПриложений = ПолучитьПустуюТаблицуПриложений();
				
				СтрокаМестаРегистрации.МассивСтрокТаблицыОбъекты = Новый Массив();
			Иначе
				СтрокаМестаРегистрации = МассивСтрок[0];
			КонецЕсли;
			
			Если СтрокаМестаРегистрации.МассивСтрокТаблицыОбъекты.Найти(СтрокаТаблицыОбъекты) = Неопределено Тогда
				СтрокаМестаРегистрации.МассивСтрокТаблицыОбъекты.Добавить(СтрокаТаблицыОбъекты);
			КонецЕсли;
			
			Если СтрокаСопоставления.СопоставленыОтклонения Тогда
				// Имеются сопоставленные отклонения, необходимо определить место их отражения.
				ИмяДокумента = ОпределитьИмяДокумента(Опись, ДополнительныеПараметры);
				
				ТаблицыДокумента = ТаблицыОписей[ИмяДокумента];
				
				ТаблицаОтклоненийОписей = ТаблицыДокумента[СтрокаСопоставления.ИмяТабличнойЧасти];
				
				ПоискВыявленногоОтклонения.Ссылка = СтрокаСопоставления.Опись;
				
				РезультатыРасчета.РезультатыСопоставления.ПоискОписиВДанныхОписей.Ссылка = Опись;
				
				ШапкаОписи = ТаблицыДокумента.Шапки.НайтиСтроки(РезультатыРасчета.РезультатыСопоставления.ПоискОписиВДанныхОписей)[0];
				
				НомераСтрок = УпорядочитьНомераСтрок(СтрокаСопоставления.НомераСтрок);
				
				Для Каждого НомерСтроки Из НомераСтрок Цикл
					Если НомерСтроки = 0 Тогда
						// Это строка не сопоставленного отклонения, а сопоставленного отбора.
						Продолжить;
					КонецЕсли;
					
					ПоискВыявленногоОтклонения.НомерСтроки = НомерСтроки;
					
					МассивСтрок = ТаблицаОтклоненийОписей.НайтиСтроки(ПоискВыявленногоОтклонения);
					
					СтрокаОписи = МассивСтрок[0];
					
					ОпределитьМестоРегистрацииСтрокиОписи61н(ИмяДокумента, СтрокаТаблицыОбъекты, СтрокаОписи, ШапкаОписи, СтрокаМестаРегистрации, ДополнительныеПараметры);
				КонецЦикла;
				
			ИначеЕсли СтрокаСопоставления.СопоставленОтбор Тогда
				// Отсутствуют выявленные отклонения, но опись сопоставлена строке Решения по отбору.
				СтрокаМестаРегистрации.Раздел1 = Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ИсключитьНекорректныеНастройкиМестРегистрации(ТаблицаМестаРегистрации);
	
	РезультатыРасчета.Вставить("МестаРегистрацииОписей", ТаблицаМестаРегистрации);
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрацииСтрокиОписи61н(ИмяДокумента, СтрокаТаблицыОбъекты, СтрокаОписи, ШапкаОписи, СтрокаМестаРегистрации, ДополнительныеПараметры)

	Перем НомерПриложенияРаздела2, НомерПриложенияРаздела3;
	
	Если ИмяДокумента = "ИнвентаризационнаяОписьБСО" Тогда
		ОпределитьМестоРегистрации_ИнвентаризационнаяОписьБСО(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьНФА" Тогда
		ОпределитьМестоРегистрации_ИнвентаризационнаяОписьНФА(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьОстатковНаСчетах" Тогда
		ОпределитьМестоРегистрации_ИнвентаризационнаяОписьОстатковНаСчетах(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
		ОпределитьМестоРегистрации_ИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры);
		
	ИначеЕсли ИмяДокумента = "УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
		ОпределитьМестоРегистрации_УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НомерПриложенияРаздела2) И Не ЗначениеЗаполнено(НомерПриложенияРаздела3) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаПриложения = СтрокаМестаРегистрации.ТаблицаПриложений.Добавить();
	СтрокаПриложения.СтрокаТаблицыОбъекты = СтрокаТаблицыОбъекты;
	СтрокаПриложения.СтрокаОписи = СтрокаОписи;
	
	Если ЗначениеЗаполнено(НомерПриложенияРаздела2) Тогда
		СтрокаМестаРегистрации.Раздел2 = Истина;
		
		СтрокаПриложения.НомерПриложенияРаздела2 = НомерПриложенияРаздела2;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерПриложенияРаздела3) Тогда
		СтрокаМестаРегистрации.Раздел3 = Истина;
		
		СтрокаПриложения.НомерПриложенияРаздела3 = НомерПриложенияРаздела3;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризационнаяОписьБСО(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры)
	
	Если СтрокаОписи.КоличествоИзлишкиНеПодтверждено <> 0
		Или СтрокаОписи.СуммаИзлишкиНеПодтверждено <> 0
		Или СтрокаОписи.КоличествоНедостачаНеПодтверждено <> 0
		Или СтрокаОписи.СуммаНедостачаНеПодтверждено <> 0 Тогда
		
		НомерПриложенияРаздела2 = 6;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризационнаяОписьНФА(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры)
	
	Если СтрокаОписи.КоличествоНедостачаНеПодтверждено <> 0
		Или СтрокаОписи.СуммаНедостачаНеПодтверждено <> 0
		Или СтрокаОписи.КоличествоИзлишкиНеПодтверждено <> 0 Тогда
		
		НомерПриложенияРаздела2 = 7;
	КонецЕсли;
	
	Если СтрокаОписи.КоличествоНеСоответствует <> 0
		Или СтрокаОписи.СуммаНеСоответствует <> 0
		Или СтрокаОписи.КоличествоОбесценение <> 0
		Или СтрокаОписи.СуммаОбесценение <> 0 Тогда
		
		НомерПриложенияРаздела3 = 4;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризационнаяОписьОстатковНаСчетах(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры)
	
	Если СтрокаОписи.СуммаОтклоненийВал <> 0 Или СтрокаОписи.СуммаОтклоненийРуб <> 0 Тогда
		НомерПриложенияРаздела2 = 2;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры)
	
	Если СтрокаОписи.СуммаНеПодтвержденаАктомСверкиРуб <> 0
		Или СтрокаОписи.СуммаНеПодтвержденаАктомСверкиВал <> 0 Тогда
		
		НомерПриложенияРаздела2 = 9;
	КонецЕсли;
	
	Если СтрокаОписи.СуммаРубСИстекшимСрокомДавности <> 0
		Или СтрокаОписи.СуммаВалСИстекшимСрокомДавности <> 0 Тогда
		
		НомерПриложенияРаздела3 = 7;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаОписи, ШапкаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3, ДополнительныеПараметры)
	
	Если СтрокаОписи.СуммаНеПодтвержденаАктомСверкиРуб <> 0
		Или СтрокаОписи.СуммаНеПодтвержденаАктомСверкиВал <> 0 Тогда
		
		НомерПриложенияРаздела2 = 9;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Описи61н.СтатусыЗадолженностиНеАктив.Найти(СтрокаОписи.СтатусЗадолженности) <> Неопределено
		И (СтрокаОписи.СуммаРуб <> 0 Или СтрокаОписи.СуммаВал <> 0) Тогда
		
		НомерПриложенияРаздела3 = 7;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ЗаполнениеПриложений

Процедура ЗаполнитьНовуюСтрокуПриложения(НоваяСтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры)
	
	НомерРаздела	= Параметры.НомерРаздела;
	НомерПриложения	= Параметры.НомерПриложения;
	
	Если НомерРаздела = 2 Тогда
		
		// Приложения к разделу 2
		
		Если НомерПриложения = 2 Тогда
			ЗаполнитьНовуюСтроку_Приложение2кРазделу2(НоваяСтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры);
			
		ИначеЕсли НомерПриложения = 6 Тогда
			ЗаполнитьНовуюСтроку_Приложение6кРазделу2(НоваяСтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры);
			
		ИначеЕсли НомерПриложения = 7 Тогда
			ЗаполнитьНовуюСтроку_Приложение7кРазделу2(НоваяСтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры);
			
		ИначеЕсли НомерПриложения = 8 Тогда
			ЗаполнитьНовуюСтроку_Приложение8кРазделу2(НоваяСтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры);
			
		ИначеЕсли НомерПриложения = 9 Тогда
			ЗаполнитьНовуюСтроку_Приложение9кРазделу2(НоваяСтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры);
		КонецЕсли;
		
	ИначеЕсли НомерРаздела = 3 Тогда
		
		// Приложения к разделу 3
		
		Если НомерПриложения = 4 Тогда
			ЗаполнитьНовуюСтроку_Приложение4кРазделу3(НоваяСтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры);
			
		ИначеЕсли НомерПриложения = 5 Тогда
			ЗаполнитьНовуюСтроку_Приложение5кРазделу3(НоваяСтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры);
			
		ИначеЕсли НомерПриложения = 6 Тогда
			ЗаполнитьНовуюСтроку_Приложение6кРазделу3(НоваяСтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры);
			
		ИначеЕсли НомерПриложения = 7 Тогда
			ЗаполнитьНовуюСтроку_Приложение7кРазделу3(НоваяСтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьНовуюСтроку_Приложение2кРазделу2(СтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры)
	
	Если Параметры.ИмяДокумента = "ИнвентаризацияОстатковНаСчетах" Тогда
		СписокСчетов = ДополнительныеПараметры.ДополнительныеТаблицы.ИнвентаризацияОстатковНаСчетах.СписокСчетов;
		
		Поиск = Новый Структура("Опись", СтрокаОписи.Опись);
		
		МассивСтрок = СписокСчетов.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 1 Тогда
			Счет = МассивСтрок[0].Счет;
		Иначе
			Счет = Параметры.СтрокаРаздела.Счет;//ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		КонецЕсли;
		
		СтрокаПриложения.Счет = Счет;
		
	ИначеЕсли Параметры.ИмяДокумента = "ИнвентаризационнаяОписьОстатковНаСчетах" Тогда
		ШапкаОписи = ПолучитьШапкуОписи61нПриЗаполненииСтрокиПриложения(СтрокаОписи, Параметры, ДополнительныеПараметры);
		
		СтрокаПриложения.КФО						= ШапкаОписи.КФО;
		СтрокаПриложения.Счет						= ШапкаОписи.Счет;
		СтрокаПриложения.Валюта						= СтрокаОписи.ВалютаСчета;
		СтрокаПриложения.СуммаОтклоненийВалютная	= СтрокаОписи.СуммаОтклоненийВал;
		СтрокаПриложения.СуммаОтклонений			= СтрокаОписи.СуммаОтклоненийРуб;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьНовуюСтроку_Приложение6кРазделу2(СтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры)
	
	Если Параметры.ИмяДокумента = "ИнвентаризационнаяОписьБСО" Тогда
		ШапкаОписи = ПолучитьШапкуОписи61нПриЗаполненииСтрокиПриложения(СтрокаОписи, Параметры, ДополнительныеПараметры);
		
		Если ШапкаОписи.ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.БСО Тогда
			ВидДокумента = 1;
		ИначеЕсли ШапкаОписи.ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы Тогда
			ВидДокумента = 2;
		Иначе
			ВидДокумента = 0;
		КонецЕсли;
		
		СтрокаПриложения.ВидДокумента			= ВидДокумента;
		СтрокаПриложения.ВидДенежногоДокумента	= СтрокаОписи.ВидДенежногоДокумента;
		СтрокаПриложения.ДенежныйДокумент		= СтрокаОписи.ДенежныйДокумент;
		СтрокаПриложения.БСО					= СтрокаОписи.БСО;
		СтрокаПриложения.Серия					= СтрокаОписи.Серия;
		
		СтрокаПриложения.НедостачаНачальныйНомер	= СтрокаОписи.НачальныйНомерНедостачаНеПодтверждено;
		СтрокаПриложения.НедостачаКонечныйНомер		= СтрокаОписи.КонечныйНомерНедостачаНеПодтверждено;
		СтрокаПриложения.НедостачаКоличество		= СтрокаОписи.КоличествоНедостачаНеПодтверждено;
		СтрокаПриложения.НедостачаСумма				= СтрокаОписи.СуммаНедостачаНеПодтверждено;
		
		СтрокаПриложения.ИзлишекНачальныйНомер	= СтрокаОписи.НачальныйНомерИзлишкиНеПодтверждено;
		СтрокаПриложения.ИзлишекКонечныйНомер	= СтрокаОписи.КонечныйНомерИзлишкиНеПодтверждено;
		СтрокаПриложения.ИзлишекКоличество		= СтрокаОписи.КоличествоИзлишкиНеПодтверждено;
		СтрокаПриложения.ИзлишекСумма			= СтрокаОписи.СуммаИзлишкиНеПодтверждено;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьНовуюСтроку_Приложение7кРазделу2(СтрокаПриложения, СтрокаОписи, Параметры, ДополнительныеПараметры)
	
