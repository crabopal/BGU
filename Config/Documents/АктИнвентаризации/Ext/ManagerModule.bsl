Процедура ЗаполнитьОбластьСтрокаТаблицы_Разделы123(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("НаименованиеОписи",	ПолучитьНаименованиеОписи(Выборка.КодФормы, ДополнительныеПараметры.НаименованияОписей));
	ЗначенияПараметров.Вставить("Наименование",			Выборка.СчетНаименование);
	
	ПредставлениеСчета = ИнвентаризацияСервер.ПолучитьПредставлениеСчетаДляРешения(Выборка);
	
	Если ЗначениеЗаполнено(Выборка.ОтветственноеЛицо) Тогда
		ДанныеСотрудника = ПолучитьДанныеСотрудника(
			ДополнительныеПараметры.ДанныеСотрудников,
			Выборка.ОтветственноеЛицо,
			ДополнительныеПараметры.СтрокаШапки.Дата,
			Истина); // ПолучитьДолжность
	Иначе
		ДанныеСотрудника = Новый Структура("ФИО,Должность", "х", "х");
	КонецЕсли;
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ПредставлениеСчета);
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ДанныеСотрудника);
	
КонецПроцедуры

