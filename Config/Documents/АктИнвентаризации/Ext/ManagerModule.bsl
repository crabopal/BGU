Функция ПрочитатьСведенияБСОиДД(ТЧПриложения)
	
	СписокБСО = Новый Массив();
	СписокДД = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТЧПриложения Цикл
		БСО = СтрокаТаблицы.БСО;
		ДД = СтрокаТаблицы.ДенежныйДокумент;
		
		Если ЗначениеЗаполнено(БСО) И СписокБСО.Найти(БСО) = Неопределено Тогда
			СписокБСО.Добавить(БСО);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДД) И СписокДД.Найти(ДД) = Неопределено Тогда
			СписокДД.Добавить(ДД);
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("ДлиныНомеровБСО", ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СписокБСО, "ДлинаНомера"));
	Результат.Вставить("СведенияДенежныхДокументов", ОбщегоНазначения.ЗначенияРеквизитовОбъектов(СписокДД, "Номер,НомСтоимость"));
	
	Возврат Результат;
	
КонецФункции

