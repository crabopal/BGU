	УсловноеОформление = ФормаДокумента.УсловноеОформление;
	
	//---
	// надпись "не применяется" для инвентарного номера
	//---
	ПредставлениеШаблон = НСтр("ru='Надпись ""не применяется"" колонки Инвентарный номер для номенклатуры (%1)'");
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблон, ИмяТЧ);

