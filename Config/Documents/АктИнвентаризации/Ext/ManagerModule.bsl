Процедура ПроверитьКорректностьКодовСтрокПриложений(ДокументОбъект, ЕстьОшибкиЗаполнения, ДополнительныеПараметры)
	
	Для НомерРаздела = 1 По КоличествоРазделов() Цикл
		
		ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
		
		ТЧРаздела = ДокументОбъект[ИмяТЧРаздела];
		
		Для НомерПриложения = 1 По ПолучитьКоличествоПриложенийКРазделу(НомерРаздела) Цикл
			
			ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
			
			ТЧПриложения = ДокументОбъект[ИмяТЧПриложения];
			
			СинонимТЧПриложения = ДополнительныеПараметры.МетаданныеТабличныхЧастей[ИмяТЧПриложения].Синоним;
			
			Для Каждого СтрокаПриложения Из ТЧПриложения Цикл
				
				НомерСтроки = СтрокаПриложения.НомерСтроки;
				
				ИндексСтроки = ИнвентаризацияСервер.ФорматироватьИндексСтрокиТаблицыДляВыводаСообщения(НомерСтроки - 1);
				
				Если Не ЗначениеЗаполнено(СтрокаПриложения.НомерСтрокиРаздела) Или Не ЗначениеЗаполнено(СтрокаПриложения.ПорядковыйНомер) Тогда
					// Код строки незаполнен
					
					ЕстьОшибкиЗаполнения = Истина;
					
					ОбщегоНазначения.СообщитьПользователю(
						ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность", "Код cтроки", НомерСтроки, СинонимТЧПриложения),
						ДокументОбъект.Ссылка,
						"Объект." + ИмяТЧПриложения + "[" + ИндексСтроки + "].КодСтроки");
						
					Продолжить;
				КонецЕсли;
				
				ДобавитьЭлементыКодаСтроки(СтрокаПриложения, НомерРаздела, НомерПриложения, ДополнительныеПараметры);
				
				Если СтрокаПриложения.НомерСтрокиРаздела > ТЧРаздела.Количество() Тогда
					
					ЕстьОшибкиЗаполнения = Истина;
					
					ТекстШаблон = НСтр("ru='Код строки раздела превышает количество строк раздела %1 в строке %2 списка ""%3""'");
					
					ОбщегоНазначения.СообщитьПользователю(
						СтрШаблон(ТекстШаблон, НомерРаздела, НомерСтроки, СинонимТЧПриложения),
						ДокументОбъект.Ссылка,
						"Объект." + ИмяТЧПриложения + "[" + ИндексСтроки + "].КодСтроки");
						
					Продолжить;
				КонецЕсли;
				
				НомерПриложенияВРазделе = ТЧРаздела[СтрокаПриложения.НомерСтрокиРаздела - 1].НомерПриложения;
				
				Если НомерПриложения <> НомерПриложенияВРазделе Тогда
					
					ЕстьОшибкиЗаполнения = Истина;
					
					ТекстШаблон = НСтр("ru='Строка %1 списка ""%2"" ошибочно расположена в приложении №%3. Ожидается отражение этой строки в приложении №%4'");
					
					ОбщегоНазначения.СообщитьПользователю(
						СтрШаблон(ТекстШаблон, НомерСтроки, СинонимТЧПриложения, НомерПриложения, НомерПриложенияВРазделе),
						ДокументОбъект.Ссылка,
						"Объект." + ИмяТЧПриложения + "[" + ИндексСтроки + "].КодСтроки");
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьЭлементыКодаСтроки(СтрокаПриложения, НомерРаздела, НомерПриложения, ДополнительныеПараметры)
	
	// ДополнительныеПараметры.КодыСтрокПриложений - соответствие
	//	* НомерРаздела					- ключ	- соответствие
	//		** НомерПриложения			- ключ	- соответствие
	//			*** КодСтрокиРаздела	- ключ	- соответствие
	//				<Порядковые номера>	- значение	- массив чисел
	
	КодыСтрокПриложений = ДополнительныеПараметры.КодыСтрокПриложений;
	
	КодыСтрокПриложенийРаздела = КодыСтрокПриложений.Получить(НомерРаздела);
	
	Если КодыСтрокПриложенийРаздела = Неопределено Тогда
		КодыСтрокПриложенийРаздела = Новый Соответствие();
	КонецЕсли;
	
	КодыСтрокПриложения = КодыСтрокПриложенийРаздела.Получить(НомерПриложения);
	
	Если КодыСтрокПриложения = Неопределено Тогда
		КодыСтрокПриложения = Новый Соответствие();
	КонецЕсли;
	
	ПорядковыеНомера = КодыСтрокПриложения.Получить(СтрокаПриложения.НомерСтрокиРаздела);
	
	Если ПорядковыеНомера = Неопределено Тогда
		ПорядковыеНомера = Новый Массив();
	КонецЕсли;
	
	ПорядковыеНомера.Добавить(СтрокаПриложения.ПорядковыйНомер);
	
	КодыСтрокПриложения.Вставить(СтрокаПриложения.НомерСтрокиРаздела, ПорядковыеНомера);
	
	КодыСтрокПриложенийРаздела.Вставить(НомерПриложения, КодыСтрокПриложения);
	
	КодыСтрокПриложений.Вставить(НомерРаздела, КодыСтрокПриложенийРаздела);
	
КонецПроцедуры

Процедура ПроверитьНаличиеСтрокПриложений(ДокументОбъект, ЕстьОшибкиЗаполнения, ДополнительныеПараметры)
	
	КодыСтрокПриложений = ДополнительныеПараметры.КодыСтрокПриложений;
	
	СинонимыТЧРазделов = Новый Соответствие();
	СинонимыТЧРазделов.Вставить(1, НСтр("ru='Раздел 1'"));
	СинонимыТЧРазделов.Вставить(2, НСтр("ru='Раздел 2'"));
	СинонимыТЧРазделов.Вставить(3, НСтр("ru='Раздел 3'"));
	
	НомераРазделов = НомераРазделовСПриложениями();
	
	Для Каждого НомерРаздела Из НомераРазделов Цикл
		
		ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
		
		ТЧРаздела = ДокументОбъект[ИмяТЧРаздела];
		
		СинонимТЧРаздела = СинонимыТЧРазделов.Получить(НомерРаздела);
		
		Для Каждого СтрокаРаздела Из ТЧРаздела Цикл
			
			НомерПриложения = СтрокаРаздела.НомерПриложения;
			
			Если Не ЗначениеЗаполнено(НомерПриложения) Тогда
				Продолжить;
			КонецЕсли;
			
			КодСтрокиРаздела = СтрокаРаздела.НомерСтроки;
			
			Если КодыСтрокПриложений.Получить(НомерРаздела) <> Неопределено
				И КодыСтрокПриложений.Получить(НомерРаздела).Получить(НомерПриложения) <> Неопределено
				И КодыСтрокПриложений.Получить(НомерРаздела).Получить(НомерПриложения).Получить(КодСтрокиРаздела) <> Неопределено Тогда
				
				Продолжить;
			КонецЕсли;
			
			Если НомерРаздела = 2 И НомерПриложения = 1 Тогда
				ТекстШаблон = НСтр("ru='Справочно: В приложении №%1 отсутствует строка с соответствующим кодом строки (строка %2 списка ""%3"")'");
			Иначе
