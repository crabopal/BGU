Процедура ОпределитьМестоРегистрации_ИнвентаризацияОС(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3)
	
	Если СтрокаОписи.НедостачаКоличество > 0 Или СтрокаОписи.ИзлишекКоличество > 0 Тогда
		НомерПриложенияРаздела2 = 7;
	КонецЕсли;
	
	Если СтрокаОписи.КоличествоНеСоответствует > 0 Или СтрокаОписи.СуммаНеСоответствует > 0 Тогда
		НомерПриложенияРаздела3 = 4;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризацияРасчетовСКонтрагентами(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3)
	
	Если СтрокаОписи.НеПодтверждено <> 0 Тогда
		НомерПриложенияРаздела2 = 8;
	КонецЕсли;
	
	Если СтрокаОписи.ИстекСрокДавности <> 0 Тогда
		Если СтрокаОписи.ИмяТабличнойЧасти = "ДебиторскаяЗадолженность" Тогда
			НомерПриложенияРаздела3 = 5;
		ИначеЕсли СтрокаОписи.ИмяТабличнойЧасти = "КредиторскаяЗадолженность" Тогда
			НомерПриложенияРаздела3 = 6;
		КонецЕсли;
	КонецЕсли;
	
