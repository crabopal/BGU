Функция ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьНФА(ИндексыТаблиц)
	
	ПрефиксИмениТаблицы = "ИнвентаризационнаяОписьНФА_";
	
	ДобавитьИндексТаблицы(ИндексыТаблиц, ПрефиксИмениТаблицы + "Шапки", 2);				// [2].
