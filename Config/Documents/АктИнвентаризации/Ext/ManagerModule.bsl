	Результат = Новый Структура();
	
	ДопустимоДобавлениеСтрок = Новый Массив();
	
	ДопустимоДобавлениеСтрок.Добавить("Раздел1");
	ДопустимоДобавлениеСтрок.Добавить("Раздел2");
	ДопустимоДобавлениеСтрок.Добавить("Раздел3");
	
	ДопустимоДобавлениеСтрок.Добавить("Приложение1кРазделу2");
	ДопустимоДобавлениеСтрок.Добавить("Приложение2кРазделу2");
	ДопустимоДобавлениеСтрок.Добавить("Приложение3кРазделу2");
	ДопустимоДобавлениеСтрок.Добавить("Приложение4кРазделу2");
	ДопустимоДобавлениеСтрок.Добавить("Приложение5кРазделу2");
	ДопустимоДобавлениеСтрок.Добавить("Приложение6кРазделу2");
	ДопустимоДобавлениеСтрок.Добавить("Приложение7кРазделу2");
	ДопустимоДобавлениеСтрок.Добавить("Приложение8кРазделу2");
	ДопустимоДобавлениеСтрок.Добавить("Приложение9кРазделу2");
	ДопустимоДобавлениеСтрок.Добавить("Приложение10кРазделу2");
	
	ДопустимоДобавлениеСтрок.Добавить("Приложение1кРазделу3");
	ДопустимоДобавлениеСтрок.Добавить("Приложение2кРазделу3");
	ДопустимоДобавлениеСтрок.Добавить("Приложение3кРазделу3");
	ДопустимоДобавлениеСтрок.Добавить("Приложение4кРазделу3");
	ДопустимоДобавлениеСтрок.Добавить("Приложение5кРазделу3");
	ДопустимоДобавлениеСтрок.Добавить("Приложение6кРазделу3");
	ДопустимоДобавлениеСтрок.Добавить("Приложение7кРазделу3");
	
	Для НомерРаздела = 1 По КоличествоРазделов() Цикл
		
		ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
		
		ДопустимоДобавление = (ДопустимоДобавлениеСтрок.Найти(ИмяТЧРаздела) <> Неопределено);
		
		Результат.Вставить(ИмяТЧРаздела, ДопустимоДобавление);
		
		Для НомерПриложения = 1 По ПолучитьКоличествоПриложенийКРазделу(НомерРаздела) Цикл
			
			ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
			
			ДопустимоДобавление = (ДопустимоДобавлениеСтрок.Найти(ИмяТЧПриложения) <> Неопределено);
			
			Результат.Вставить(ИмяТЧПриложения, ДопустимоДобавление);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

