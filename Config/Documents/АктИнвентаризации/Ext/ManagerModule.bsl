Процедура ПроверитьДублиКодовСтрокПриложений(ДокументОбъект, ЕстьОшибкиЗаполнения, ДополнительныеПараметры)
	
	ПараметрыВывода = Новый Структура();
	ПараметрыВывода.Вставить("ОбъектСсылка", ДокументОбъект["Ссылка"]);
	ПараметрыВывода.Вставить("ИмяПоляДляВыводаСообщений", "КодСтроки");
	
	ШаблонСинонимТЧ = НСтр("ru='Приложение %1 к разделу %2'");
	
	НомераРазделов = НомераРазделовСПриложениями();
	
	Для Каждого НомерРаздела Из НомераРазделов Цикл
		
		Для НомерПриложения = 1 По ПолучитьКоличествоПриложенийКРазделу(НомерРаздела) Цикл
			
			ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
			
			СинонимТЧПриложения = ДополнительныеПараметры.МетаданныеТабличныхЧастей[ИмяТЧПриложения].Синоним;
			
			ТЧПриложения = ДокументОбъект[ИмяТЧПриложения];
			
			КолонкиДублей = "НомерСтрокиРаздела,ПорядковыйНомер";
			
			ТаблицаДублиСтрок = ОбщегоНазначенияБГУ.НайтиДублиСтрок(ТЧПриложения, КолонкиДублей);
			
			Если ТаблицаДублиСтрок.Количество() > 0 Тогда
				ЕстьОшибкиЗаполнения = Истина;
				
				ПараметрыВывода.Вставить("ТаблицаИмя",				ИмяТЧПриложения);
				ПараметрыВывода.Вставить("ТаблицаПредставление",	СинонимТЧПриложения);
				
				ОбщегоНазначенияБГУ.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЗаполненностьКодовФормВРазделах(ДокументОбъект, ЕстьОшибкиЗаполнения)
	
	СписокСчетовБезКодаФормы = БухгалтерскийУчет.СписокСчетов("401.50,401.60", ДокументОбъект.ДатаИнвентаризации);
	
	СинонимыТЧРазделов = Новый Соответствие();
	СинонимыТЧРазделов.Вставить(1, НСтр("ru='Раздел 1'"));
	СинонимыТЧРазделов.Вставить(2, НСтр("ru='Раздел 2'"));
	СинонимыТЧРазделов.Вставить(3, НСтр("ru='Раздел 3'"));

	Для НомерРаздела = 1 По КоличествоРазделов() Цикл
 		
		ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
		
		ТЧРаздела = ДокументОбъект[ИмяТЧРаздела];
		
		СинонимТЧРаздела = СинонимыТЧРазделов.Получить(НомерРаздела);
		
		Для Каждого СтрокаРаздела Из ТЧРаздела Цикл
			
			Если ЗначениеЗаполнено(СтрокаРаздела.КодФормы) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаРаздела.Счет) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СписокСчетовБезКодаФормы.Найти(СтрокаРаздела.Счет) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ЕстьОшибкиЗаполнения = Истина;
			
			ИндексСтроки = ИнвентаризацияСервер.ФорматироватьИндексСтрокиТаблицыДляВыводаСообщения(СтрокаРаздела.НомерСтроки - 1);
			
			ОбщегоНазначения.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение", НСтр("ru='Код формы'"), СтрокаРаздела.НомерСтроки, СинонимТЧРаздела),
				ДокументОбъект.Ссылка,
				"Объект." + ИмяТЧРаздела + "[" + ИндексСтроки + "].КодФормы");
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры


