КонецПроцедуры

#КонецОбласти

#Область Печать

#Область ПечатнаяФорма0510463

Функция ПечатьФормы0510463(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПроверитьДостижениеКворумаПрисутствияПриПечати(МассивОбъектов);
	// Конец ИндикаторКворумаПрисутствия
	
	КлючПараметровПечати = "ПечатьФормы0510463";
	
	ОбщийТабДокумент = Новый ТабличныйДокумент();
	ОбщийТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ОбщийТабДокумент.Автомасштаб = Истина;
	ОбщийТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ТиповыеПараметры = Новый Структура();
	ТиповыеПараметры.Вставить("МассивОбъектов",			МассивОбъектов);
	ТиповыеПараметры.Вставить("ПараметрыПечати",		ПараметрыПечати);
	ТиповыеПараметры.Вставить("КоллекцияПечатныхФорм",	КоллекцияПечатныхФорм);
	ТиповыеПараметры.Вставить("ОбъектыПечати",			ОбъектыПечати);
	ТиповыеПараметры.Вставить("ПараметрыВывода",		ПараметрыВывода);
	
	Данные = ПолучитьДанныеДляПечати(МассивОбъектов);
	
	Данные.Вставить("ДополнительныеПараметры",	ПолучитьДополнительныеПараметрыДляПечатиФормы0510463(КлючПараметровПечати));
	
	ОбластиМакетов = ПолучитьОбластиМакетов();
	
	ПервыйДокумент = Истина;
	
	ВыборкаШапка = Данные.Выборки.Шапки;
	
	Пока ВыборкаШапка.Следующий() Цикл
		ТабДокумент = Новый ТабличныйДокумент();
		ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		ТабДокумент.Автомасштаб = Истина;
		ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
		
		ПечатьФормы0510463_Титул(ТабДокумент, Данные, ВыборкаШапка, ОбластиМакетов, ТиповыеПараметры);
		
		ПечатьФормы0510463_Приложения(ТабДокумент, Данные, ВыборкаШапка, ОбластиМакетов, ТиповыеПараметры);
		
		Если Не ПервыйДокумент Тогда
			ОбщийТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НомерСтрокиНачало = ОбщийТабДокумент.ВысотаТаблицы + 1;
		
		ОбщийТабДокумент.Вывести(ТабДокумент);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ОбщийТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.Ссылка);
			
		ПервыйДокумент = Ложь;
	КонецЦикла;
	
	// Колонтитулы
	ОбщийТабДокумент.ВерхнийКолонтитул.Выводить				= Истина;
	ОбщийТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница	= 2;
	ОбщийТабДокумент.ВерхнийКолонтитул.ТекстСправа			= НСтр("ru='Форма 0510463 с.[&НомерСтраницы]'");
	
	Возврат ОбщийТабДокумент;
	
КонецФункции

Функция ПолучитьДанныеДляПечати(МассивОбъектов)
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаРУКод = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВалютаРУ, "Код");
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивОбъектов);
	
	ЗапросПоиск.УстановитьПараметр("ВалютаРУ",		ВалютаРУ);
	ЗапросПоиск.УстановитьПараметр("ВалютаРУКод",	ВалютаРУКод);
	ЗапросПоиск.УстановитьПараметр("ЕдИзмШт",		Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());

	Настройки = НастройкиВидЗадолженности0504084();
	ЗапросПоиск.УстановитьПараметр("ВидЗадолженности0504084ВнутреннийДолг",	Настройки.Представления.Получить(1));
	ЗапросПоиск.УстановитьПараметр("ВидЗадолженности0504084ВнешнийДолг",	Настройки.Представления.Получить(2));
	ЗапросПоиск.УстановитьПараметр("ВидЗадолженности0504084Пустой",			Настройки.Представления.Получить(0));
	
	Настройки = НастройкиВидЗадолженности0504085();
	ЗапросПоиск.УстановитьПараметр("ВидЗадолженности0504085ВнутреннийДолг",	Настройки.Представления.Получить(1));
	ЗапросПоиск.УстановитьПараметр("ВидЗадолженности0504085ВнешнийДолг",	Настройки.Представления.Получить(2));
	ЗапросПоиск.УстановитьПараметр("ВидЗадолженности0504085Пустой",			Настройки.Представления.Получить(0));
	
	ИндексыТаблиц = Новый Структура();
	
	ИндексыТаблиц.Вставить("ПоследнийДобавленныйИндекс", -1);
	
	ЗапросПоиск.Текст = ""
		+ ПолучитьТекстЗапросаПечать_Титул(ИндексыТаблиц)
		
		+ ПолучитьТекстЗапросаПечать_Приложение1кРазделу2(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение2кРазделу2(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение3кРазделу2(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение4кРазделу2(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение5кРазделу2(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение6кРазделу2(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение7кРазделу2(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение8кРазделу2(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение9кРазделу2(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение10кРазделу2(ИндексыТаблиц)
		
		+ ПолучитьТекстЗапросаПечать_Приложение1кРазделу3(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение2кРазделу3(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение3кРазделу3(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение4кРазделу3(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение5кРазделу3(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение6кРазделу3(ИндексыТаблиц)
		+ ПолучитьТекстЗапросаПечать_Приложение7кРазделу3(ИндексыТаблиц)
	;
	
	УпорядочитьИндексыПодзапросов(ЗапросПоиск.Текст);
	
	ИндексыТаблиц.Удалить("ПоследнийДобавленныйИндекс");
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	Данные = Новый Структура();
	Данные.Вставить("Выборки", Новый Структура());
	
	Для Каждого Элемент Из ИндексыТаблиц Цикл
		ОбозначениеВыборки	= Элемент.Ключ;
		ИндексТаблицы		= Элемент.Значение;
		
		Если ОбозначениеВыборки = "Шапки" Тогда
			ОбходРезультата = ОбходРезультатаЗапроса.Прямой;
		Иначе
			ОбходРезультата = ОбходРезультатаЗапроса.ПоГруппировкам;
		КонецЕсли;
		
		Данные.Выборки.Вставить(ОбозначениеВыборки, РезультатыЗапроса[ИндексТаблицы].Выбрать(ОбходРезультата));
	КонецЦикла;
	
	Данные.Вставить("СоставКомиссий", ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов));
	Данные.Вставить("ДанныеСотрудников", ПолучитьДанныеСотрудников(МассивОбъектов, "Объекты,Комиссии"));
	Данные.Вставить("СведенияУчреждений", УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов));
	Данные.Вставить("НаименованияОписей", НаименованияОписей());
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьДополнительныеПараметрыДляПечатиФормы0510463(КлючПараметровПечати)
	
	Макет0504087 = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ИнвентаризационнаяОписьНФА_0504087_194н");
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("КлючПараметровПечати", КлючПараметровПечати);
	
	ДополнительныеПараметры.Вставить("НастройкиВидДокумента0504086", НастройкиВидДокумента0504086());
	
	ДополнительныеПараметры.Вставить("Графа3_ВыводитьКодОС",		ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет0504087, "Графа3_ВыводитьКодОС", Ложь));
	ДополнительныеПараметры.Вставить("Графа3_ВыводитьКодМЗ",		ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет0504087, "Графа3_ВыводитьКодМЗ", Истина));
	ДополнительныеПараметры.Вставить("Графа2_ВыводитьСубконто3",	ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет0504087, "Графа2_ВыводитьСубконто3", Истина));
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

Процедура ПечатьФормы0510463_Титул(ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов, ТиповыеПараметры)
	
	ОбластиМакета = ОбластиМакетов.Титул;
	
	// УТВЕРЖДАЮ
	
	ЗначенияПараметров = Новый Структура();
	
	ЗаполнитьПараметрыТитулУтверждаю(ЗначенияПараметров, СтрокаШапки);
	
	Область = ОбластиМакетов.Титул.Утверждаю;
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	// ЗАГОЛОВОК
	
	ЗначенияПараметров = Новый Структура();
	
	УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, СтрокаШапки.Ссылка, Данные.СведенияУчреждений);
	
	НомерАкта = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.Ссылка,
		СтрокаШапки.Номер);
		
	Данные.ДополнительныеПараметры.Вставить("НомерАкта", НомерАкта);
	
	ЗначенияПараметров.Вставить("Дата",	СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Номер", Данные.ДополнительныеПараметры.НомерАкта);
	
	Область = ОбластиМакета["Заголовок"];
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛЫ 1, 2, 3
	
	ВывестиРаздел("1", ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов);
	
	ВывестиРаздел("2", ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов);
	
	ВывестиРаздел("3", ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов);
	
	// КОМИССИЯ
	
	ПараметрыВывода = УправлениеПечатьюБГУ.ПараметрыВыводаСоставаКомиссииПриПечати();
	ПараметрыВывода.ЗаголовокПервогоРядовогоЧлена = НСтр("ru='Член комиссии'");
	ПараметрыВывода.ЗаголовокПоследующихРядовыхЧленов = НСтр("ru='Член комиссии'");
	ПараметрыВывода.ВыводитьДополнительныеСведения = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьПричинуОтсутствия = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьЗамещающегоСотрудника = Истина;
	
	УправлениеПечатьюБГУ.ВывестиСоставКомиссииПриПечати(ТабДокумент, СтрокаШапки.Ссылка, ОбластиМакетов.Титул.ЧленКомиссии, Данные.СоставКомиссий, ПараметрыВывода);
	
	// ПОДВАЛ
	
	ЗначенияПараметров = Новый Структура();
	
	ЗаполнитьПараметрыОтветственногоИсполнителя(ЗначенияПараметров, СтрокаШапки);
	
	ОбластьПодвал = ОбластиМакетов.Титул.Подвал;
	ОбластьПодвал.Параметры.Заполнить(ЗначенияПараметров);
	
	Если Не ТабДокумент.ПроверитьВывод(ОбластьПодвал) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьПодвал);	
	
КонецПроцедуры

Процедура ПечатьФормы0510463_Приложения(ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов, ТиповыеПараметры)
	
	// Приложения к разделу 2
	
	НомераРазделов = НомераРазделовСПриложениями();
	
	Для Каждого НомерРаздела Из НомераРазделов Цикл
		
		Для НомерПриложения = 1 По ПолучитьКоличествоПриложенийКРазделу(НомерРаздела) Цикл
			
			ИмяТЧ = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
			
			ОбщаяВыборка = Данные.Выборки[ИмяТЧ];
			
			Выборка = ПолучитьВыборкуПоДокументу(ОбщаяВыборка, СтрокаШапки.Ссылка);
			
			Если Выборка.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если НомерРаздела = 2 И НомерПриложения = 10 Тогда
				ТабДокументПриложение = ВывестиПриложение10кРазделу2(Данные, СтрокаШапки, ОбластиМакетов);
			Иначе
				ТабДокументПриложение = ВывестиПриложение(НомерПриложения, НомерРаздела, Данные, СтрокаШапки, ОбластиМакетов);
			КонецЕсли;
			
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			ТабДокумент.Вывести(ТабДокументПриложение);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиРаздел(НомерРазделаСтрокой, ТабДокумент, Данные, СтрокаШапки, ОбластиМакетов)
	
	ОбщаяВыборка = Данные.Выборки["Раздел" + НомерРазделаСтрокой];
	
	Выборка = ПолучитьВыборкуПоДокументу(ОбщаяВыборка, СтрокаШапки.Ссылка);
	
	// В случае отсутствия информации по разделам 2 и 3 указанные разделы не формируются
	Если Выборка.Количество() = 0 И (НомерРазделаСтрокой = "2" Или НомерРазделаСтрокой = "3") Тогда
		Возврат;
	КонецЕсли;
	
	// ЗАГОЛОВОК И ТАБЛИЦА
	
	ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
	
	ПараметрыВыводаТаблицы.Области.Заголовок		= ОбластиМакетов.Титул["Раздел" + НомерРазделаСтрокой + "Заголовок"];
	ПараметрыВыводаТаблицы.Области.ШапкаТаблицы		= ОбластиМакетов.Титул["Раздел" + НомерРазделаСтрокой + "Шапка"];
	ПараметрыВыводаТаблицы.Области.СтрокаТаблицы	= ОбластиМакетов.Титул["Раздел" + НомерРазделаСтрокой + "Строка"];
	
	ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Разделы123";
	
	ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
	
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Ложь;
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
	
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("НаименованияОписей", Данные.НаименованияОписей);
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("СтрокаШапки", СтрокаШапки);
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ДанныеСотрудников", Данные.ДанныеСотрудников);
	
	ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
	
	ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
	
	НастроитьНижнююГраницу(ТабДокумент, ОбластиМакетов.Титул["Раздел" + НомерРазделаСтрокой + "Строка"]);

КонецПроцедуры

Функция ВывестиПриложение(НомерПриложения, НомерРаздела, Данные, СтрокаШапки, ОбластиМакетов)
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = Данные.ДополнительныеПараметры.КлючПараметровПечати;
	
	ИмяТЧ = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	// ОПИСАНИЕ
	
	Область = ОбластиМакетов[ИмяТЧ].Описание;
	
	ЗначенияПараметров = Новый Структура("Номер", Данные.ДополнительныеПараметры.НомерАкта);
	
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	
	ТабДокумент.Вывести(Область);
	
	// ЗАГОЛОВОК
	
	ТабДокумент.Вывести(ОбластиМакетов[ИмяТЧ].Заголовок);
	
	// ТАБЛИЦА
	
	ОбщаяВыборка = Данные.Выборки[ИмяТЧ];
	
	ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
	
	ПараметрыВыводаТаблицы.ДополнительныеПараметры = Данные.ДополнительныеПараметры;
	
	// Шапка таблицы
	
	Если НомерПриложения = 2 И НомерРаздела = 2 Тогда
		
		ЗначенияПараметров = Новый Структура();
		
		ЗначенияПараметров.Вставить("ДатаТаб", Формат(СтрокаШапки.ДатаИнвентаризации, "ДФ=dd.MM.yyyy"));

		ОбластиМакетов[ИмяТЧ].Шапка.Параметры.Заполнить(ЗначенияПараметров);
		
	ИначеЕсли НомерПриложения = 4 И НомерРаздела = 2
		Или НомерПриложения = 5 И НомерРаздела = 2
		Или НомерПриложения = 1 И НомерРаздела = 3
		Или НомерПриложения = 2 И НомерРаздела = 3
		Или НомерПриложения = 3 И НомерРаздела = 3 Тогда
		
		ЗначенияПараметров = Новый Структура();
		
		ЗначенияПараметров.Вставить("ДатаТаб", Формат(СтрокаШапки.ДатаИнвентаризации, "ДФ=dd.MM.yyyy"));

		ОбластиМакетов[ИмяТЧ].Шапка2.Параметры.Заполнить(ЗначенияПараметров);
	КонецЕсли;
	
	// Обработчики заполнения строки макета
	
	Если НомерПриложения = 1 И НомерРаздела = 2 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение1кРазделу2";
		
	ИначеЕсли НомерПриложения = 2 И НомерРаздела = 2 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение2кРазделу2";
		
	ИначеЕсли НомерПриложения = 3 И НомерРаздела = 2 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение3кРазделу2";
		
	ИначеЕсли НомерПриложения = 4 И НомерРаздела = 2 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение4кРазделу2";
		
	ИначеЕсли НомерПриложения = 5 И НомерРаздела = 2 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение5кРазделу2";
		
	ИначеЕсли НомерПриложения = 6 И НомерРаздела = 2 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение6кРазделу2";
		
	ИначеЕсли НомерПриложения = 7 И НомерРаздела = 2 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение7кРазделу2";
		
	ИначеЕсли НомерПриложения = 8 И НомерРаздела = 2 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение8кРазделу2";
		
	ИначеЕсли НомерПриложения = 9 И НомерРаздела = 2 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение9кРазделу2";
		
	ИначеЕсли НомерПриложения = 1 И НомерРаздела = 3 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение1кРазделу3";
		
	ИначеЕсли НомерПриложения = 2 И НомерРаздела = 3 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение2кРазделу3";
		
	ИначеЕсли НомерПриложения = 3 И НомерРаздела = 3 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение3кРазделу3";
		
	ИначеЕсли НомерПриложения = 4 И НомерРаздела = 3 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение4кРазделу3";
		
	ИначеЕсли НомерПриложения = 5 И НомерРаздела = 3 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение5кРазделу3";
		
	ИначеЕсли НомерПриложения = 6 И НомерРаздела = 3 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение6кРазделу3";
		
	ИначеЕсли НомерПриложения = 7 И НомерРаздела = 3 Тогда
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение7кРазделу3";
	КонецЕсли;
	
	// Формирование табличного документа
	
	Если НомерПриложения = 3 И НомерРаздела = 2
		Или НомерПриложения = 4 И НомерРаздела = 2
		Или НомерПриложения = 5 И НомерРаздела = 2
		Или НомерПриложения = 1 И НомерРаздела = 3
		Или НомерПриложения = 2 И НомерРаздела = 3
		Или НомерПриложения = 3 И НомерРаздела = 3 Тогда
		
		// Два набора колонок
		
		// Набор колонок №1
		
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы				= ОбластиМакетов[ИмяТЧ].Шапка1;
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы			= ОбластиМакетов[ИмяТЧ].Строка1;
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами	= ОбластиМакетов[ИмяТЧ].Итого1;
		
		ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
		
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Истина;
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
		
		Выборка = ПолучитьВыборкуПоДокументу(ОбщаяВыборка, СтрокаШапки.Ссылка);
		
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ОбщаяВыборка;
		
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		// Набор колонок №2
		
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы				= ОбластиМакетов[ИмяТЧ].Шапка2;
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы			= ОбластиМакетов[ИмяТЧ].Строка2;
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами	= ОбластиМакетов[ИмяТЧ].Итого2;
		
		ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
		
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
		
		Выборка = ПолучитьВыборкуПоДокументу(ОбщаяВыборка, СтрокаШапки.Ссылка);
		
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ОбщаяВыборка;
		
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
	Иначе
		
		// Всего один-единственный набор колонок
		
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы				= ОбластиМакетов[ИмяТЧ].Шапка;
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы			= ОбластиМакетов[ИмяТЧ].Строка;
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами	= ОбластиМакетов[ИмяТЧ].Итого;
		//ПараметрыВыводаТаблицы.Области.ИтогиПоСтраницеЧислами	= ОбластиМакетов[ИмяТЧ].ИтогоПоСтранице;
		
		ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
		
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
		
		Выборка = ПолучитьВыборкуПоДокументу(ОбщаяВыборка, СтрокаШапки.Ссылка);
		
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ОбщаяВыборка;

		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции


Функция ПолучитьОбластиМакетов()
	
	Результат = Новый Структура();
	
	// Титул и разделы
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.АктИнвентаризации.ПФ_MXL_Ф0510463_Титул");
	ОбластиМакета = Новый Структура();
	ОбластиМакета.Вставить("Утверждаю",				Макет.ПолучитьОбласть("Утверждаю"));
	ОбластиМакета.Вставить("Заголовок",				Макет.ПолучитьОбласть("Заголовок"));
	ОбластиМакета.Вставить("Раздел1Заголовок",		Макет.ПолучитьОбласть("Раздел1Заголовок"));
	ОбластиМакета.Вставить("Раздел1Шапка",			Макет.ПолучитьОбласть("Раздел1Шапка"));
	ОбластиМакета.Вставить("Раздел1Строка",			Макет.ПолучитьОбласть("Раздел1Строка"));
	ОбластиМакета.Вставить("Раздел2Заголовок",		Макет.ПолучитьОбласть("Раздел2Заголовок"));
	ОбластиМакета.Вставить("Раздел2Шапка",			Макет.ПолучитьОбласть("Раздел2Шапка"));
	ОбластиМакета.Вставить("Раздел2Строка",			Макет.ПолучитьОбласть("Раздел2Строка"));
	ОбластиМакета.Вставить("Раздел3Заголовок",		Макет.ПолучитьОбласть("Раздел3Заголовок"));
	ОбластиМакета.Вставить("Раздел3Шапка",			Макет.ПолучитьОбласть("Раздел3Шапка"));
	ОбластиМакета.Вставить("Раздел3Строка",			Макет.ПолучитьОбласть("Раздел3Строка"));
	ОбластиМакета.Вставить("ЧленКомиссии",			Макет.ПолучитьОбласть("ЧленКомиссии"));
	ОбластиМакета.Вставить("Подвал",				Макет.ПолучитьОбласть("Подвал"));
	Результат.Вставить("Титул", ОбластиМакета);
	
	// Приложения
	
	НомераРазделов = НомераРазделовСПриложениями();
	
	Для Каждого НомерРаздела Из НомераРазделов Цикл
		
		Для НомерПриложения = 1 По ПолучитьКоличествоПриложенийКРазделу(НомерРаздела) Цикл
			
			ДобавитьОбластиМакетаПриложения(Результат, НомерПриложения, НомерРаздела);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьОбластиМакетаПриложения(Приемник, НомерПриложения, НомерРаздела)
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.АктИнвентаризации.ПФ_MXL_Ф0510463_" + ИмяТЧПриложения);
	
	ОбластиМакета = Новый Структура();
	
	ОбластиМакета.Вставить("Описание",	Макет.ПолучитьОбласть("Описание"));
	ОбластиМакета.Вставить("Заголовок",	Макет.ПолучитьОбласть("Заголовок"));
	
	Если НомерПриложения = 3 И НомерРаздела = 2
		Или НомерПриложения = 4 И НомерРаздела = 2
		Или НомерПриложения = 5 И НомерРаздела = 2
		Или НомерПриложения = 1 И НомерРаздела = 3
		Или НомерПриложения = 2 И НомерРаздела = 3
		Или НомерПриложения = 3 И НомерРаздела = 3 Тогда
		
		// Набор колонок №1
		ОбластиМакета.Вставить("Шапка1",			Макет.ПолучитьОбласть("Шапка1"));
		ОбластиМакета.Вставить("Строка1",			Макет.ПолучитьОбласть("Строка1"));
		ОбластиМакета.Вставить("Итого1",			Макет.ПолучитьОбласть("Итого1"));
		
		// Набор колонок №2
		ОбластиМакета.Вставить("Шапка2",			Макет.ПолучитьОбласть("Шапка2"));
		ОбластиМакета.Вставить("Строка2",			Макет.ПолучитьОбласть("Строка2"));
		ОбластиМакета.Вставить("Итого2",			Макет.ПолучитьОбласть("Итого2"));
		
	ИначеЕсли НомерПриложения = 10 И НомерРаздела = 2 Тогда
		ОбластиМакета.Вставить("Шапка",						Макет.ПолучитьОбласть("Шапка"));
		ОбластиМакета.Вставить("Строка",					Макет.ПолучитьОбласть("Строка"));
		ОбластиМакета.Вставить("ИтогоЕдинственнаяСтрока",	Макет.ПолучитьОбласть("ИтогоЕдинственнаяСтрока"));
		ОбластиМакета.Вставить("ИтогоПерваяСтрока",			Макет.ПолучитьОбласть("ИтогоПерваяСтрока"));
		ОбластиМакета.Вставить("ИтогоОчереднаяСтрока",		Макет.ПолучитьОбласть("ИтогоОчереднаяСтрока"));
		ОбластиМакета.Вставить("ИтогоПоследняяСтрока",		Макет.ПолучитьОбласть("ИтогоПоследняяСтрока"));
		
	Иначе
		ОбластиМакета.Вставить("Шапка",				Макет.ПолучитьОбласть("Шапка"));
		ОбластиМакета.Вставить("Строка",			Макет.ПолучитьОбласть("Строка"));
		ОбластиМакета.Вставить("Итого",				Макет.ПолучитьОбласть("Итого"));
	КонецЕсли;
	
	Приемник.Вставить(ИмяТЧПриложения, ОбластиМакета);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыТитулУтверждаю(ЗначенияПараметров, СтрокаШапки)
	
	ДанныеПодписанта = Новый Структура("СсылкаНаОбъект, Период, Должность", СтрокаШапки.Руководитель, СтрокаШапки.Дата);
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеПодписанта);
	
	ДолжностьУтверждаю = ДанныеПодписанта.Должность;
	
	ФИОУтверждаю = Справочники.Сотрудники.ФамилияИО(СтрокаШапки.Руководитель, Ложь, СтрокаШапки.Дата);
	
	ЗначенияПараметров.Вставить("Должность",	ДолжностьУтверждаю);
	ЗначенияПараметров.Вставить("ФИО",			ФИОУтверждаю);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыОтветственногоИсполнителя(ЗначенияПараметров, СтрокаШапки)
	
	ДанныеСотрудника = Новый Структура();
	ДанныеСотрудника.Вставить("СсылкаНаОбъект",	СтрокаШапки.ОтветственныйИсполнитель);
	ДанныеСотрудника.Вставить("Период",			СтрокаШапки.Дата);
	ДанныеСотрудника.Вставить("ДолжностьНаименование");
	ДанныеСотрудника.Вставить("Фамилия");
	ДанныеСотрудника.Вставить("Имя");
	ДанныеСотрудника.Вставить("Отчество");
	
	ПолучатьКИдляПечати = Истина;
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника,, ПолучатьКИдляПечати);
	
	ЗначенияПараметров.Вставить("ДолжностьНаименование",	ДанныеСотрудника.ДолжностьНаименование);
	ЗначенияПараметров.Вставить("ФИО",						КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
	ЗначенияПараметров.Вставить("НомерТелефона",			ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
	ЗначенияПараметров.Вставить("ЭлектроннаяПочта",			ДанныеСотрудника.EmailФизическиеЛица);
	
КонецПроцедуры

Функция ПолучитьНаименованиеОписи(КодОписи, НаименованияОписей)

	НаименованиеОписи = НаименованияОписей.Получить(КодОписи);
	
	Если НаименованиеОписи = Неопределено Тогда
		НаименованиеОписи = "";
	КонецЕсли;
	
	Возврат НаименованиеОписи;
	
КонецФункции

Процедура НастроитьНижнююГраницу(ТабДокумент, ОбластьСтрокаТаблицы)
	
	// За образец линии берем левую границу самой первой ячейки указанной области
	
	ОбразецЛинии = ОбластьСтрокаТаблицы.Область(1, 1, 1, 1).ГраницаСлева;
	
	НомерПоследнейСтроки = ТабДокумент.ВысотаТаблицы;
	
	НомерПоследнейКолонки = ОбластьСтрокаТаблицы.ШиринаТаблицы;
	
	ТабДокумент.Область(НомерПоследнейСтроки, 1, НомерПоследнейСтроки, НомерПоследнейКолонки).ГраницаСнизу = ОбразецЛинии;
	
КонецПроцедуры

Функция ПолучитьВыборкуПоДокументу(ОбщаяВыборка, ДокументСсылка)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", ДокументСсылка);
	
	ОбщаяВыборка.Сбросить();
	
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Возврат ОбщаяВыборка.Выбрать();
	
КонецФункции

Функция ПолучитьДанныеСотрудников(МассивДокументов, ИменаТабличныхЧастей)
	
	СписокСотрудников = ПолучитьСписокСотрудников(МассивДокументов);
	
	Результат = Новый Соответствие();
	
	Поиск = Новый Структура();
	
	ТребуемыеДанные = "НаименованиеПолное,ДолжностьНаименование,Подразделение";
	
	Для Каждого Дата Из СписокСотрудников["ДатыОпределенияСведений"] Цикл
		ПорцияСведений = ИнвентаризацияСервер.ПолучитьПорциюСведенийСотрудниковНаДату(СписокСотрудников["ТаблицаСотрудников"], Дата);
		
		Результат.Вставить(Дата, ПорцияСведений);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокСотрудников(МассивДокументов)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивДокументов);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Полный список всех ответственных лиц из разделов 1, 2, 3
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	ТЧ.ОтветственноеЛицо		КАК Сотрудник
	|ИЗ
	|	Документ.АктИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктИнвентаризации.Раздел1 КАК ТЧ
	|		ПО Док.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	ТЧ.ОтветственноеЛицо		КАК Сотрудник
	|ИЗ
	|	Документ.АктИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктИнвентаризации.Раздел2 КАК ТЧ
	|		ПО Док.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	ТЧ.ОтветственноеЛицо		КАК Сотрудник
	|ИЗ
	|	Документ.АктИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктИнвентаризации.Раздел3 КАК ТЧ
	|		ПО Док.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|;";
	
	ТаблицаСотрудников = ЗапросПоиск.Выполнить().Выгрузить();
	
	ВремТаблица = ТаблицаСотрудников.Скопировать(, "ДатаОпределенияСведений");
	ВремТаблица.Свернуть("ДатаОпределенияСведений");
	
	ДатыОпределенияСведений = ВремТаблица.ВыгрузитьКолонку("ДатаОпределенияСведений");
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаСотрудников",		ТаблицаСотрудников);
	Результат.Вставить("ДатыОпределенияСведений",	ДатыОпределенияСведений);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеСотрудника(ДанныеСотрудников, Сотрудник, Дата, ПолучитьДолжность = Ложь, ПолучитьПодразделение = Ложь)
	
	Перем Должность, ФИО, Подразделение;
	
	ТаблицаДанныеСотрудников = ДанныеСотрудников.Получить(Дата);
	
	Если ЗначениеЗаполнено(Сотрудник) И ТаблицаДанныеСотрудников <> Неопределено Тогда
		
		Поиск = Новый Структура("Ссылка", Сотрудник);
		
		МассивСтрок = ТаблицаДанныеСотрудников.НайтиСтроки(Поиск);
		
		СтрокаДанных = МассивСтрок[0];
		
		ФИО = СтрокаДанных.Фамилия + " " + СтрокаДанных.Имя + " " + СтрокаДанных.Отчество;
		
		Если ПолучитьДолжность Тогда
			Должность = СтрокаДанных.ДолжностьНаименование;
		КонецЕсли;
		
		Если ПолучитьПодразделение Тогда
			Подразделение = СтрокаДанных.Подразделение;
		КонецЕсли;
		
		Если ПолучитьДолжность ИЛИ ПолучитьПодразделение Тогда
			ДолжностьПодразделение = Должность + ?(ЗначениеЗаполнено(Подразделение), ", " + Подразделение,	"");
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый Структура();
	
	Результат.Вставить("ФИО", ФИО);
	
	Если ПолучитьДолжность Тогда
		Результат.Вставить("Должность", Должность);
	КонецЕсли;
	
	Если ПолучитьПодразделение Тогда
		Результат.Вставить("Подразделение", Подразделение);
	КонецЕсли;
	
	Если ПолучитьДолжность ИЛИ ПолучитьПодразделение Тогда
		Результат.Вставить("ДолжностьПодразделение", ДолжностьПодразделение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Печать приложение №10 к разделу 2

Функция ВывестиПриложение10кРазделу2(Данные, СтрокаШапки, ОбластиМакетов)
	
	Перем ПревышенРазмерСтраницы;
	
	КлючПараметровПечати = Данные.ДополнительныеПараметры.КлючПараметровПечати;
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ИмяТЧ = "Приложение10кРазделу2";
	
	// Расчет итогов
	
	ОбщаяВыборка = Данные.Выборки[ИмяТЧ];
	
	ОбщаяТаблицаИтогов = ПолучитьТаблицуИтоговПриложение10кРазделу2(ОбщаяВыборка);
	
	ТабДокументИтогов = ПолучитьТабДокументИтоговПриложение10кРазделу2(ОбщаяТаблицаИтогов, СтрокаШапки, ОбластиМакетов, КлючПараметровПечати, ПревышенРазмерСтраницы);
	
	// Вывод печатной формы
	
	// ОПИСАНИЕ
	
	Область = ОбластиМакетов[ИмяТЧ].Описание;
	
	ЗначенияПараметров = Новый Структура("Номер", Данные.ДополнительныеПараметры.НомерАкта);
	
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	
	ТабДокумент.Вывести(Область);
	
	// ЗАГОЛОВОК
	
	ТабДокумент.Вывести(ОбластиМакетов[ИмяТЧ].Заголовок);
	
	// ТАБЛИЦА
	
	ОбщаяВыборка = Данные.Выборки[ИмяТЧ];
	
	ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
	
	ПараметрыВыводаТаблицы.ДополнительныеПараметры = Данные.ДополнительныеПараметры;
	
	ПараметрыВыводаТаблицы.Области.ШапкаТаблицы		= ОбластиМакетов[ИмяТЧ].Шапка;
	ПараметрыВыводаТаблицы.Области.СтрокаТаблицы	= ОбластиМакетов[ИмяТЧ].Строка;
	
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
	
	Если ПревышенРазмерСтраницы Тогда
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Ложь;
	Иначе
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами = ТабДокументИтогов;
		
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Истина;
	КонецЕсли;
	
	ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение10кРазделу2";
	
	ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
	
	Выборка = ПолучитьВыборкуПоДокументу(ОбщаяВыборка, СтрокаШапки.Ссылка);
	
	ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
	ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ОбщаяВыборка;

	ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
	
	Если ПревышенРазмерСтраницы Тогда
		ТабДокумент.Вывести(ТабДокументИтогов);
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПолучитьТаблицуИтоговПриложение10кРазделу2(ОбщаяВыборка)
	
	ОчищающаяСтруктура = Новый Структура("КПС,КФО,КЭК");
	
	ОбщаяТаблица = Новый ТаблицаЗначений();
	ОбщаяТаблица.Колонки.Добавить("Ссылка",				Новый ОписаниеТипов("ДокументСсылка.АктИнвентаризации"));
	ОбщаяТаблица.Колонки.Добавить("СуммаОтклонений",	ОбщегоНазначения.ОписаниеТипаЧисло(18,2,ДопустимыйЗнак.Любой));
	ОбщаяТаблица.Колонки.Добавить("ТаблицаИтогов",		Новый ОписаниеТипов("ТаблицаЗначений"));
	
	Поиск = Новый Структура("Ссылка");
	
	ОбщаяВыборка.Сбросить();
	
	Пока ОбщаяВыборка.Следующий() Цикл
		
		Ссылка = ОбщаяВыборка.Ссылка;
		
		Поиск.Ссылка = Ссылка;
		
		МассивСтрок = ОбщаяТаблица.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			СтрокаОбщейТаблицы = ОбщаяТаблица.Добавить();
			СтрокаОбщейТаблицы.Ссылка = Ссылка;
			
			ТаблицаИтогов = ПолучитьПустуюТаблицуИтоговОписиПриложение10кРазделу2();
		Иначе
			СтрокаОбщейТаблицы = МассивСтрок[0];
			
			ТаблицаИтогов = СтрокаОбщейТаблицы.ТаблицаИтогов;
		КонецЕсли;
		
		Выборка = ОбщаяВыборка.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаИтогов.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОчищающаяСтруктура);
		КонецЦикла;
		
		ТаблицаИтогов.Свернуть("КПС,КФО,Счет,КЭК", "СуммаОтклонений");
		
		СтрокаОбщейТаблицы.ТаблицаИтогов = ТаблицаИтогов;
		СтрокаОбщейТаблицы.СуммаОтклонений = ТаблицаИтогов.Итог("СуммаОтклонений");
	КонецЦикла;
	
	ОбщаяВыборка.Сбросить();
	
	Возврат ОбщаяТаблица;
	
КонецФункции

Функция ПолучитьПустуюТаблицуИтоговОписиПриложение10кРазделу2()
	
	ТаблицаИтогов = Новый ТаблицаЗначений();
	ТаблицаИтогов.Колонки.Добавить("КПС",				Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаИтогов.Колонки.Добавить("КФО",				Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаИтогов.Колонки.Добавить("Счет",				Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаИтогов.Колонки.Добавить("КЭК",				Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаИтогов.Колонки.Добавить("СуммаОтклонений",	ОбщегоНазначения.ОписаниеТипаЧисло(18,2,ДопустимыйЗнак.Любой));
	
	Возврат ТаблицаИтогов;
	
КонецФункции

Функция ПолучитьТабДокументИтоговПриложение10кРазделу2(ОбщаяТаблицаИтогов, СтрокаШапки, ОбластиМакетов, КлючПараметровПечати, ПревышенРазмерСтраницы)
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ПревышенРазмерСтраницы = Ложь;
	
	Области = ОбластиМакетов.Приложение10кРазделу2;
	
	Поиск = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	МассивСтрок = ОбщаяТаблицаИтогов.НайтиСтроки(Поиск);
	
	СтрокаИтоговОписи = МассивСтрок[0];
	
	ТаблицаИтогов = СтрокаИтоговОписи.ТаблицаИтогов;
	
	КоличествоСтрок = ТаблицаИтогов.Количество();
	
	ЗначенияПараметров = Новый Структура("НомерСчета");
	
	Если КоличествоСтрок = 1 Тогда
		СтрокаИтогов = ТаблицаИтогов[0];
		ЗначенияПараметров.НомерСчета = ПолучитьПолныйНомерСчета(СтрокаИтогов.КПС, СтрокаИтогов.КФО, СтрокаИтогов.Счет, СтрокаИтогов.КЭК);
		Область = Области.ИтогоЕдинственнаяСтрока;
		Область.Параметры.Заполнить(СтрокаИтогов);
		Область.Параметры.Заполнить(ЗначенияПараметров);
		
		ТабДокумент.Вывести(Область);
		
	ИначеЕсли КоличествоСтрок = 2 Тогда
		СтрокаИтогов = ТаблицаИтогов[0];
		ЗначенияПараметров.НомерСчета = ПолучитьПолныйНомерСчета(СтрокаИтогов.КПС, СтрокаИтогов.КФО, СтрокаИтогов.Счет, СтрокаИтогов.КЭК);
		Область = Области.ИтогоПерваяСтрока;
		Область.Параметры.Заполнить(СтрокаИтогов);
		Область.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(Область);
		
		СтрокаИтогов = ТаблицаИтогов[1];
		ЗначенияПараметров.НомерСчета = ПолучитьПолныйНомерСчета(СтрокаИтогов.КПС, СтрокаИтогов.КФО, СтрокаИтогов.Счет, СтрокаИтогов.КЭК);
		Область = Области.ИтогоПоследняяСтрока;
		Область.Параметры.Заполнить(СтрокаИтогов);
		Область.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(Область);
		
	ИначеЕсли КоличествоСтрок > 2 Тогда
		СтрокаИтогов = ТаблицаИтогов[0];
		ЗначенияПараметров.НомерСчета = ПолучитьПолныйНомерСчета(СтрокаИтогов.КПС, СтрокаИтогов.КФО, СтрокаИтогов.Счет, СтрокаИтогов.КЭК);
		Область = Области.ИтогоПерваяСтрока;
		Область.Параметры.Заполнить(СтрокаИтогов);
		Область.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(Область);
		
		// Заполняем, но не выводим. Нужно для дальнейшей проверки вывода. Выводим позже.
		СтрокаИтогов = ТаблицаИтогов[КоличествоСтрок - 1];
		ЗначенияПараметров.НомерСчета = ПолучитьПолныйНомерСчета(СтрокаИтогов.КПС, СтрокаИтогов.КФО, СтрокаИтогов.Счет, СтрокаИтогов.КЭК);
		ОбластьПоследняяСтрока = Области.ИтогоПоследняяСтрока;
		ОбластьПоследняяСтрока.Параметры.Заполнить(СтрокаИтогов);
		ОбластьПоследняяСтрока.Параметры.Заполнить(ЗначенияПараметров);
		
		ОбластиПроверкиВывода = Новый Массив();
		ОбластиПроверкиВывода.Добавить(Неопределено);
		ОбластиПроверкиВывода.Добавить(ОбластьПоследняяСтрока);
		
		Для Счетчик = 1 По КоличествоСтрок - 2 Цикл
			СтрокаИтогов = ТаблицаИтогов[Счетчик];
			ЗначенияПараметров.НомерСчета = ПолучитьПолныйНомерСчета(СтрокаИтогов.КПС, СтрокаИтогов.КФО, СтрокаИтогов.Счет, СтрокаИтогов.КЭК);
			Область = Области.ИтогоОчереднаяСтрока;
			Область.Параметры.Заполнить(СтрокаИтогов);
			Область.Параметры.Заполнить(ЗначенияПараметров);
			
			ОбластиПроверкиВывода[0] = Область;
			
			Если Не ТабДокумент.ПроверитьВывод(ОбластиПроверкиВывода) Тогда
				ПревышенРазмерСтраницы = Истина;
			КонецЕсли;
			
			ТабДокумент.Вывести(Область);
		КонецЦикла;
		
		ТабДокумент.Вывести(ОбластьПоследняяСтрока);
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

