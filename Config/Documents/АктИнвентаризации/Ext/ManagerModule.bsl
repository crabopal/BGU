	// Проверки аналогичные ОпределитьМестоРегистрации_ИнвентаризацияГосдолгаВЦенныхБумагах
	
	ИмяТЧПриложения = "Приложение2кРазделу3";
	
	ТекстШаблон = НСтр("ru='Некорректно заполнена строка %1 списка ""%2"". Все суммы качественных характеристик нулевые'");
	
	СинонимТЧПриложения = ДополнительныеПараметры.МетаданныеТабличныхЧастей[ИмяТЧПриложения].Синоним;
				
	Для Каждого СтрокаПриложения Из ДокументОбъект[ИмяТЧПриложения] Цикл
		
		Если СтрокаПриложения.СуммаОДПросроченнаяВалютная <> 0
			Или СтрокаПриложения.СуммаОДПросроченная <> 0
			Или СтрокаПриложения.СуммаПроцентовПросроченнаяВалютная <> 0
			Или СтрокаПриложения.СуммаПроцентовПросроченная <> 0 Тогда
			
			Продолжить;
		КонецЕсли;
		
		ЕстьОшибкиЗаполнения = Истина;
		
		НомерСтроки = СтрокаПриложения.НомерСтроки;
		ИндексСтроки = ИнвентаризацияСервер.ФорматироватьИндексСтрокиТаблицыДляВыводаСообщения(НомерСтроки - 1);
		
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон(ТекстШаблон, НомерСтроки, СинонимТЧПриложения),
			ДокументОбъект.Ссылка,
			"Объект." + ИмяТЧПриложения + "[" + ИндексСтроки + "].СуммаОДПросроченная");
			
	КонецЦикла;
	
КонецПроцедуры

