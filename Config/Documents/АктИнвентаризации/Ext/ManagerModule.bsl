Процедура ЗаполнитьОбластьСтрокаТаблицы_Приложение6кРазделу2(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗначенияПараметров = Новый Структура("
		|ВидДокумента,
		|НаименованиеДокумента,
		|КодДокумента,
		|ЕдИзм,
		|НедостачаСерия,
		|НедостачаНомер,
		|НедостачаЦена,
		|ИзлишекСерия,
		|ИзлишекНомер,
		|ИзлишекЦена");
	
	ЗначенияПараметров.Вставить("КодСтроки", ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(Выборка.НомерСтрокиРаздела, Выборка.ПорядковыйНомер));
	ЗначенияПараметров.ВидДокумента = ДополнительныеПараметры.НастройкиВидДокумента0504086.Представления.Получить(Выборка.ВидДокумента);
	
	ЗаполнитьНедостачу	= (Выборка.НедостачаКоличество <> 0 Или Выборка.НедостачаСумма <> 0);
	ЗаполнитьИзлишек	= (Выборка.ИзлишекКоличество <> 0 Или Выборка.ИзлишекСумма <> 0);
	
	Если Выборка.ВидДокумента = 1 Тогда
		// БСО
		
		ЗначенияПараметров.НаименованиеДокумента	= Выборка.БСОНаименование;
		ЗначенияПараметров.КодДокумента				= Выборка.БСОКод;
		ЗначенияПараметров.ЕдИзм					= Выборка.БСОЕдИзм;
		
		Цена = 1;
		Серия = Выборка.БСОСерия;
		ДлинаНомера = Выборка.БСОДлинаНомера;
		
		Если ЗаполнитьНедостачу Тогда
			ЗначенияПараметров.НедостачаЦена = Цена;
			ЗначенияПараметров.НедостачаСерия = Серия;
			ЗначенияПараметров.НедостачаНомер = ПолучитьПредставлениеДиапазонаНомеровБСО(Выборка.НедостачаНачальныйНомер, Выборка.НедостачаКонечныйНомер, ДлинаНомера);
		КонецЕсли;
		
		Если ЗаполнитьИзлишек Тогда
			ЗначенияПараметров.ИзлишекЦена = Цена;
			ЗначенияПараметров.ИзлишекСерия = Серия;
			ЗначенияПараметров.ИзлишекНомер = ПолучитьПредставлениеДиапазонаНомеровБСО(Выборка.ИзлишекНачальныйНомер, Выборка.ИзлишекКонечныйНомер, ДлинаНомера);
		КонецЕсли;
		
	ИначеЕсли Выборка.ВидДокумента = 2 Тогда
		// Денежный документ
		
		ЗначенияПараметров.НаименованиеДокумента	= Выборка.ДенежныйДокументНаименование;
		ЗначенияПараметров.КодДокумента				= Выборка.ДенежныйДокументКод;
		ЗначенияПараметров.ЕдИзм					= Выборка.ДенежныйДокументЕдИзм;
		
		НомСтоимость = Выборка.ДенежныйДокументНомСтоимость;
		Серия = Выборка.ДенежныйДокументСерия;
		Номер = Выборка.ДенежныйДокументНомер;
		
		Если ЗаполнитьНедостачу Тогда
			
			Если ЗначениеЗаполнено(Выборка.ДенежныйДокументНаименование) Тогда
				Цена = НомСтоимость;
			ИначеЕсли Выборка.НедостачаКоличество <> 0 Тогда
				Цена = Окр(Выборка.НедостачаСумма/Выборка.НедостачаКоличество, 2);
			Иначе
				Цена = 0;
			КонецЕсли;
			
			ЗначенияПараметров.НедостачаЦена = Цена;
			ЗначенияПараметров.НедостачаСерия = Серия;
			ЗначенияПараметров.НедостачаНомер = Номер;
			
		КонецЕсли;
		
		Если ЗаполнитьИзлишек Тогда
			
			Если ЗначениеЗаполнено(Выборка.ДенежныйДокументНаименование) Тогда
				Цена = НомСтоимость;
			ИначеЕсли Выборка.ИзлишекКоличество <> 0 Тогда
				Цена = Окр(Выборка.ИзлишекСумма/Выборка.ИзлишекКоличество, 2);
			Иначе
				Цена = 0;
			КонецЕсли;
			
			ЗначенияПараметров.ИзлишекЦена = Цена;
			ЗначенияПараметров.ИзлишекСерия = Серия;
			ЗначенияПараметров.ИзлишекНомер = Номер;
			
		КонецЕсли;
		
	Иначе
		// Ошибка данных
		
		ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
		
		Возврат;
	КонецЕсли;
	
	СимволПрочерка = НСтр("ru='—'");
	
	Если Не ЗначениеЗаполнено(ЗначенияПараметров.НедостачаСерия) Тогда
		ЗначенияПараметров.НедостачаСерия = СимволПрочерка;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЗначенияПараметров.НедостачаНомер) Тогда
		ЗначенияПараметров.НедостачаНомер = СимволПрочерка;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЗначенияПараметров.НедостачаЦена) Тогда
		ЗначенияПараметров.НедостачаЦена = СимволПрочерка;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗначенияПараметров.ИзлишекСерия) Тогда
		ЗначенияПараметров.ИзлишекСерия = СимволПрочерка;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЗначенияПараметров.ИзлишекНомер) Тогда
		ЗначенияПараметров.ИзлишекНомер = СимволПрочерка;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЗначенияПараметров.ИзлишекЦена) Тогда
		ЗначенияПараметров.ИзлишекЦена = СимволПрочерка;
	КонецЕсли;
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
КонецПроцедуры

Функция ПолучитьПредставлениеДиапазонаНомеровБСО(НомерНач, НомерКон, ДлинаНомера)
	
	СимволПрочерка = НСтр("ru='—'");
	
	Если НомерНач > 0 И НомерКон > 0 И НомерНач = НомерКон Тогда
		
		Возврат ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(НомерНач, ДлинаНомера);
		
	ИначеЕсли НомерНач > 0 И НомерКон > 0 Тогда
		
		Возврат ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(НомерНач, ДлинаНомера) + СимволПрочерка + ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(НомерКон, ДлинаНомера);
		
	ИначеЕсли НомерНач > 0 Тогда
		
		Возврат ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(НомерНач, ДлинаНомера);
		
	ИначеЕсли НомерКон > 0 Тогда
		
		Возврат ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(НомерКон, ДлинаНомера);
		
	КонецЕсли;
	
	Возврат СимволПрочерка;
	
КонецФункции

Процедура ЗаполнитьОбластьСтрокаТаблицы_Приложение7кРазделу2(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("КодСтроки", ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(Выборка.НомерСтрокиРаздела, Выборка.ПорядковыйНомер));
	ЗначенияПараметров.Вставить("НомерСчета", ПолучитьПолныйНомерСчета(Выборка.КПС, Выборка.КФО, Выборка.Счет,,,Выборка.СчетУчетПоКПС, Выборка.СчетУчетПоКЭК));
	
	Если ТипЗнч(Выборка.НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
		КоличествоЗнаковПослеЗапятойДляКоличества = 3;
	Иначе
		КоличествоЗнаковПослеЗапятойДляКоличества = 0;
	КонецЕсли;
		
	ФорматнаяСтрока = СтрШаблон(НСтр("ru='ЧЦ=15; ЧДЦ=%1; ЧН=—'"), КоличествоЗнаковПослеЗапятойДляКоличества);
	
	ЗначенияПараметров.Вставить("НедостачаКоличество", Формат(Выборка.НедостачаКоличество, ФорматнаяСтрока));
	ЗначенияПараметров.Вставить("ИзлишекКоличество", Формат(Выборка.ИзлишекКоличество, ФорматнаяСтрока));
	
	ЗначенияПараметров.Вставить("НаименованиеНФА",	ИнвентаризацияСервер.ПолучитьНаименованиеНФА(Выборка, ДополнительныеПараметры));
