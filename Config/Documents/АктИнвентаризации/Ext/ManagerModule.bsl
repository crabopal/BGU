		Или СтрокаОписи.СуммаПроцентовНеподтвержденнаяВалютная <> 0
		Или СтрокаОписи.СуммаПроцентовНеподтвержденная <> 0 Тогда
		
		НомерПриложенияРаздела2 = 4;
	КонецЕсли;
	
	Если СтрокаОписи.СуммаОДПросроченнаяВалютная <> 0
		Или СтрокаОписи.СуммаОДПросроченная <> 0
		Или СтрокаОписи.СуммаПроцентовПросроченнаяВалютная <> 0
		Или СтрокаОписи.СуммаПроцентовПросроченная <> 0 Тогда
		
		НомерПриложенияРаздела3 = 2;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризацияГосдолгаПоКредитамИГарантиям(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3)
	
	Если СтрокаОписи.СуммаОДНеподтвержденнаяВалютная <> 0
		Или СтрокаОписи.СуммаОДНеподтвержденная <> 0
		Или СтрокаОписи.СуммаПроцентовНеподтвержденнаяВалютная <> 0
		Или СтрокаОписи.СуммаПроцентовНеподтвержденная <> 0 Тогда
		
		НомерПриложенияРаздела2 = 5;
	КонецЕсли;
	
	Если СтрокаОписи.СуммаОДПросроченнаяВалютная <> 0
		Или СтрокаОписи.СуммаОДПросроченная <> 0
		Или СтрокаОписи.СуммаПроцентовПросроченнаяВалютная <> 0
		Или СтрокаОписи.СуммаПроцентовПросроченная <> 0 Тогда
		
		НомерПриложенияРаздела3 = 3;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризацияКассы(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3)
	
	Если СтрокаОписи.НедостачаКоличество <> 0
		Или СтрокаОписи.НедостачаСумма <> 0
		Или СтрокаОписи.ИзлишекКоличество <> 0
		Или СтрокаОписи.ИзлишекСумма <> 0 Тогда
		
		НомерПриложенияРаздела2 = 6;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьМестоРегистрации_ИнвентаризацияИК(СтрокаОписи, НомерПриложенияРаздела2, НомерПриложенияРаздела3)
	
