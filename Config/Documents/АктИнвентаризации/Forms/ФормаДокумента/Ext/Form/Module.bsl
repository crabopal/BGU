КонецПроцедуры

&НаКлиенте
Процедура Приложение6кРазделу2ДокументПодчиненныйНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.Приложение6кРазделу2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.ВидДокумента = 1 Тогда
		ИмяОткрываемойФормы = "Справочник.СерииБСО.ФормаВыбора";
		
	ИначеЕсли ТекДанные.ВидДокумента = 2 Тогда
		ИмяОткрываемойФормы = "Справочник.ДенежныеДокументы.ФормаВыбора";
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура());
	ПараметрыФормы.Отбор.Вставить("Владелец", ТекДанные.ДокументВладелец);
	
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы, Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


