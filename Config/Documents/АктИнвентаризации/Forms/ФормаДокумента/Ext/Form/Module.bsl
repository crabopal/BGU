Процедура НастроитьПоясненияПриНаличииРабочихКомиссий()
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("НадписьПоясненияПриНаличииРабочихКомиссий");
	
	НовВидимость = Ложь;
	
	Если ЗначениеЗаполнено(Объект.Комиссия) Тогда
		НовВидимость = ЕстьРабочиеКомиссии(Объект.Комиссия);
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементов, "Видимость", НовВидимость);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьРабочиеКомиссии(Комиссия)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Комиссия", Комиссия);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК СоставКомиссии
	|ГДЕ
	|	Ссылка = &Комиссия
	|	И НомерРабочейКомиссии > 0";
	
	Возврат Не ЗапросПоиск.Выполнить().Пустой();
	
КонецФункции

