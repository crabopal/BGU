#Область Приложение7кРазделу2

&НаКлиенте
Процедура ПриИзмененииНФА(НомерПриложения, НомерРаздела, Элемент)
	
	ИменаПолей = ПолучитьИменаПолейПриложения(НомерПриложения, НомерРаздела);
	
	СтрокаПриложения = Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущиеДанные;
	
	НФА = СтрокаПриложения.НФА;
	
	СтрокаПриложения.ТипНфаОС			= (ТипЗнч(НФА) = Тип("СправочникСсылка.ОсновныеСредства"));
	СтрокаПриложения.ТипНфаНоменклатура	= (ТипЗнч(НФА) = Тип("СправочникСсылка.Номенклатура"));
	
	Если ЗначениеЗаполнено(НФА) И СтрокаПриложения.ТипНфаОС Тогда
		СтрокаПриложения.ИнвентарныйНомер = ПолучитьИнвентарныйНомер(НФА);
	КонецЕсли;
	
	СтрокаПриложения.ЕдИзм = Неопределено;
	
	НастроитьПризнакЭтоСчетУстановкиКоличестваПоУмолчанию(СтрокаПриложения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИнвентарныйНомер(ОсновноеСредство)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	ЗапросПоиск.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИнвентарныеНомераОС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.ОС = &ОсновноеСредство
	|	И НЕ ИнвентарныеНомераОС.ОС.ГрупповойУчет
	|	И НЕ ИнвентарныеНомераОС.ПометкаУдаления";
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииСчетаНФА(НомерПриложения, НомерРаздела)
	
	ИменаПолей = ПолучитьИменаПолейПриложения(НомерПриложения, НомерРаздела);
	
	СтрокаПриложения = Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущиеДанные;
	
	СтрокаПриложения.ЕдИзм = Неопределено;
	
	НастроитьПризнакЭтоСчетУстановкиКоличестваПоУмолчанию(СтрокаПриложения);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьПризнакЭтоСчетУстановкиКоличестваПоУмолчанию(СтрокаПриложения)
	
	СтрокаПриложения.ЭтоСчетУстановкиКоличестваПоУмолчанию =
		СтрокаПриложения.ТипНфаОС
		И (СчетаУстановкиКоличестваПоУмолчанию.Найти(СтрокаПриложения.Счет) <> Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область Приложение8кРазделу2

&НаКлиенте
Процедура Приложение8кРазделу2РассчитатьИтогиСтроки(Элемент)
	
	ТекДанные = Элементы.Приложение8кРазделу2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("СуммаОтклоненийДЗ", 0);
	ЗначенияПараметров.Вставить("СуммаОтклоненийКЗ", 0);
	
	Если ТекДанные.ВидЗадолженности = ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Дебиторская") Тогда
		ЗначенияПараметров.СуммаОтклоненийДЗ = ТекДанные.СуммаОтклонений;
		
	ИначеЕсли ТекДанные.ВидЗадолженности = ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Кредиторская") Тогда
		ЗначенияПараметров.СуммаОтклоненийКЗ = ТекДанные.СуммаОтклонений;
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ЗначенияПараметров);
	
КонецПроцедуры

#КонецОбласти

#Область Приложение10кРазделу2

&НаКлиенте
Процедура УстановитьКонтрагентаПоДоговору()
	
	ТекДанные = Элементы.Приложение10кРазделу2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекДанные.Договор) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыДоговора = ПрочитатьРеквизитыДоговора(ТекДанные.Договор);
	
	ТекДанные.Контрагент = РеквизитыДоговора.Контрагент;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьРеквизитыДоговора(Договор)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "Контрагент");
	
КонецФункции





