&НаКлиенте
Процедура Приложение6кРазделу2ВидДокументаПриИзменении(Элемент)
	
	ТекДанные = Элементы.Приложение6кРазделу2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДокументВладелецСовместимыйТип(ТекДанные) Тогда
		УстановитьТипДокументВладелец(ТекДанные);
		
		ОчиститьНедостачу_Приложение6кРазделу2(ТекДанные);
		ОчиститьИзлишек_Приложение6кРазделу2(ТекДанные);
	КонецЕсли;
	
	Если Не ДокументПодчиненныйСовместимыйТип(ТекДанные) Тогда
		УстановитьТипДокументПодчиненный(ТекДанные);
	КонецЕсли;
	
	ОбновитьПоляБСОиДДВСтроке(ТекДанные);
	
КонецПроцедуры


&НаКлиенте
Процедура Приложение6кРазделу2ДокументВладелецПриИзменении(Элемент)
	
	ТекДанные = Элементы.Приложение6кРазделу2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.ДокументПодчиненный = Неопределено;
	
	ОбновитьПоляБСОиДДВСтроке(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура Приложение6кРазделу2ДокументВладелецНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.Приложение6кРазделу2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.ВидДокумента = 1 Тогда
		ИмяОткрываемойФормы = "Справочник.БСО.ФормаВыбора";
		
	ИначеЕсли ТекДанные.ВидДокумента = 2 Тогда
		ИмяОткрываемойФормы = "Справочник.ВидыДенежныхДокументов.ФормаВыбора";
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму(ИмяОткрываемойФормы,, Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаКлиенте
Процедура Приложение6кРазделу2ДокументПодчиненныйПриИзменении(Элемент)
	
	ТекДанные = Элементы.Приложение6кРазделу2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
