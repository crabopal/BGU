&НаКлиенте
Функция ПолучитьИменаПолейРаздела(НомерРаздела, ИмяКолонки = "")
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("НомерРаздела",			НомерРаздела);
	ИменаПолей.Вставить("ИмяКолонки",			ИмяКолонки);
	ИменаПолей.Вставить("ИмяТабличнойЧасти",	ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела));
	
	Возврат ИменаПолей;
	
КонецФункции

&НаКлиенте
Функция ПолучитьИменаПолейПриложения(НомерПриложения, НомерРаздела, ИмяКолонки = "")
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("НомерРаздела",			НомерРаздела);
	ИменаПолей.Вставить("НомерПриложения",		НомерПриложения);
	ИменаПолей.Вставить("ИмяТабличнойЧасти",	ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела));
	ИменаПолей.Вставить("ИмяКолонки",			ИмяКолонки);
	
	Возврат ИменаПолей;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокВыбораНомерПриложения(НомерРаздела, КодФормы)
	
	Если НомерРаздела = 2 Тогда
		Возврат ПолучитьСписокВыбораНомерПриложенияРаздела2(КодФормы);
		
	ИначеЕсли НомерРаздела = 3 Тогда
		Возврат ПолучитьСписокВыбораНомерПриложенияРаздела3(КодФормы);
	КонецЕсли;
	
	Возврат Новый СписокЗначений();
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокВыбораНомерПриложенияРаздела2(КодФормы)
	
	ДобавитьВсе = Не ЗначениеЗаполнено(КодФормы);
	
	Если ДобавитьВсе Тогда
		СписокВыбора = Новый СписокЗначений();
		
		СписокВыбора.Добавить(1);
		СписокВыбора.Добавить(2);
		СписокВыбора.Добавить(3);
		СписокВыбора.Добавить(4);
		СписокВыбора.Добавить(5);
		СписокВыбора.Добавить(6);
		СписокВыбора.Добавить(7);
		СписокВыбора.Добавить(8);
		СписокВыбора.Добавить(9);
		СписокВыбора.Добавить(10);
		
		Возврат СписокВыбора;
	КонецЕсли;
	
	СписокВыбора = НастройкиКодовФорм.НомераПриложенийРаздела2.Получить(КодФормы);
	
	Если СписокВыбора = Неопределено Тогда
		СписокВыбора = Новый СписокЗначений();
		
		СписокВыбора.Добавить(10);
    КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокВыбораНомерПриложенияРаздела3(КодФормы)
	
	ДобавитьВсе = Не ЗначениеЗаполнено(КодФормы);
	
	Если ДобавитьВсе Тогда
		СписокВыбора = Новый СписокЗначений();
		
		СписокВыбора.Добавить(1);
		СписокВыбора.Добавить(2);
		СписокВыбора.Добавить(3);
		СписокВыбора.Добавить(4);
		СписокВыбора.Добавить(5);
		СписокВыбора.Добавить(6);
		СписокВыбора.Добавить(7);
		
		Возврат СписокВыбора;
	КонецЕсли;
	
	СписокВыбора = НастройкиКодовФорм.НомераПриложенийРаздела3.Получить(КодФормы);
	
	Если СписокВыбора = Неопределено Тогда
		СписокВыбора = Новый СписокЗначений();
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаКлиенте
Функция ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела)
	
	Возврат СтрШаблон("Раздел%1", Формат(НомерРаздела, "ЧГ=0"));
	
