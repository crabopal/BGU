КонецПроцедуры

&НаКлиенте
Процедура РешениеОПроведенииИнвентаризацииПриИзменении(Элемент)
	
	НастроитьДоступностьПолейЗависящихОтРешения();
	
	Если Не ЗначениеЗаполнено(Объект.РешениеОПроведенииИнвентаризации) Тогда
		ОбработатьОчисткуРешения();
		
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	РешениеОПроведенииИнвентаризацииПриИзмененииСервер(ТекстОшибки);
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, СтрШаблон("%1
			|%2",
			ТекстОшибки,
			НСтр("ru='Выбор данных из таких Решений не предусмотрен.'")), 20);
	КонецЕсли;
	
КонецПроцедуры

