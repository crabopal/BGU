&НаКлиенте
Процедура ОбновитьПоляБСОиДДВСтроке(ТекДанные)
	
	ЗначенияПараметров = Новый Структура("
		|ВидДенежногоДокумента,
		|ДенежныйДокумент,
		|БСО,
		|Серия,
		|ДлинаНомера,
		|НомерДенежногоДокумента,
		|НомСтоимость,
		|НедостачаНачальныйНомер,
		|НедостачаКонечныйНомер,
		|НедостачаНачальныйНомерПредставление,
		|НедостачаКонечныйНомерПредставление,
		|НедостачаКоличество,
		|НедостачаСумма,
		|ИзлишекНачальныйНомер,
		|ИзлишекКонечныйНомер,
		|ИзлишекНачальныйНомерПредставление,
		|ИзлишекКонечныйНомерПредставление,
		|ИзлишекКоличество,
		|ИзлишекСумма");
	
	ЗначенияПараметров.НедостачаНачальныйНомер = 0;
	ЗначенияПараметров.НедостачаКонечныйНомер = 0;
	ЗначенияПараметров.НедостачаКоличество = 0;
	ЗначенияПараметров.НедостачаСумма = 0;
	ЗначенияПараметров.ИзлишекНачальныйНомер = 0;
	ЗначенияПараметров.ИзлишекКонечныйНомер = 0;
	ЗначенияПараметров.ИзлишекКоличество = 0;
	ЗначенияПараметров.ИзлишекСумма = 0;
	
	Если ТекДанные.ВидДокумента = 1 Тогда
		БСО = ТекДанные.ДокументВладелец;
		
		ЗначенияПараметров.БСО = БСО;
		ЗначенияПараметров.Серия = ТекДанные.ДокументПодчиненный;
		
		Если ЗначениеЗаполнено(БСО) Тогда
			ДлинаНомера = ПолучитьДлинуНомераБСО(БСО);
		Иначе
			ДлинаНомера = 0;
		КонецЕсли;
		
		ЗначенияПараметров.ДлинаНомера = ДлинаНомера;
		
		ЗначенияПараметров.НедостачаНачальныйНомерПредставление = "";
		ЗначенияПараметров.НедостачаКонечныйНомерПредставление = "";
		ЗначенияПараметров.ИзлишекНачальныйНомерПредставление = "";
		ЗначенияПараметров.ИзлишекКонечныйНомерПредставление = "";
		
	ИначеЕсли ТекДанные.ВидДокумента = 2 Тогда
		ДенежныйДокумент = ТекДанные.ДокументПодчиненный;
		
		ЗначенияПараметров.ВидДенежногоДокумента = ТекДанные.ДокументВладелец;
		ЗначенияПараметров.ДенежныйДокумент = ДенежныйДокумент;
		
		Если ЗначениеЗаполнено(ДенежныйДокумент) Тогда
			Сведения = ПолучитьСведенияДенежногоДокумента(ДенежныйДокумент);
			
			НомерДенежногоДокумента = Сведения.Номер;
			НомСтоимость = Сведения.НомСтоимость;
		Иначе
			НомерДенежногоДокумента = "";
			НомСтоимость = 0;
		КонецЕсли;
		
		ЗначенияПараметров.НомерДенежногоДокумента = НомерДенежногоДокумента;
		ЗначенияПараметров.НомСтоимость = НомСтоимость;
		
		НедостачаНомерПредставление = ?(ТекДанные.НедостачаКоличество = 0 И ТекДанные.НедостачаСумма = 0, "", НомерДенежногоДокумента);
		ИзлишекНомерПредставление = ?(ТекДанные.ИзлишекКоличество = 0 И ТекДанные.ИзлишекСумма = 0, "", НомерДенежногоДокумента);
		
		ЗначенияПараметров.НедостачаНачальныйНомерПредставление = НедостачаНомерПредставление;
		ЗначенияПараметров.НедостачаКонечныйНомерПредставление = НедостачаНомерПредставление;
		ЗначенияПараметров.ИзлишекНачальныйНомерПредставление = ИзлишекНомерПредставление;
		ЗначенияПараметров.ИзлишекКонечныйНомерПредставление = ИзлишекНомерПредставление;
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ЗначенияПараметров);
	
КонецПроцедуры

