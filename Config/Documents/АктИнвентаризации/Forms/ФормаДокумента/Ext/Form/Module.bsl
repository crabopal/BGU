&НаСервере
Процедура ИнициализироватьФорму()
	
	Если Параметры.Ключ.Пустая() Тогда
		УстановитьРуководителя(Объект);
	КонецЕсли;
	
	Документы.АктИнвентаризации.ИнициализироватьФормуДокумента(ЭтотОбъект);
	
	ИнициализацияФормыВыполнена = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	НастроитьПоясненияПриНаличииРабочихКомиссий();
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриЧтенииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ЗаполнитьСлужебныеКолонкиЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	Документы.АктИнвентаризации.ЗаполнитьСлужебныеКолонки(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоступностьПолейЗависящихОтРешения()
	
	НовТолькоПросмотр = Не ЗначениеЗаполнено(Объект.РешениеОПроведенииИнвентаризации);
	
	Элементы.ДатаИнвентаризации.ТолькоПросмотр	= НовТолькоПросмотр;
	Элементы.НомерКомиссии.ТолькоПросмотр		= НовТолькоПросмотр;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьОчисткуРешения()
	
	ОчиститьРеквизитыЗависящиеОтРешения();
	
	КомиссияПриИзмененииСервер();
	
	НастроитьПоясненияПриНаличииРабочихКомиссий();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьРеквизитыЗависящиеОтРешения()
	
	ОчищающаяСтруктура = Новый Структура("ДатаИнвентаризации,НомерКомиссии,Комиссия");
	
	ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
	
	Объект.Раздел1.Очистить();
	Объект.Раздел2.Очистить();
	Объект.Раздел3.Очистить();
	
	Объект.Приложение1кРазделу2.Очистить();
	Объект.Приложение2кРазделу2.Очистить();
	Объект.Приложение3кРазделу2.Очистить();
	Объект.Приложение4кРазделу2.Очистить();
	Объект.Приложение5кРазделу2.Очистить();
	Объект.Приложение6кРазделу2.Очистить();
	Объект.Приложение7кРазделу2.Очистить();
