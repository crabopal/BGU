#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбобщенныеДанныеРешения = Документы.АктИнвентаризации.ПолучитьОбобщенныеДанныеРешения(Параметры.РешениеОПроведенииИнвентаризации);
	
	Решение				= Параметры.РешениеОПроведенииИнвентаризации;
	ПоследнееИзменение	= ОбобщенныеДанныеРешения.ПоследнееИзменение;
	
	Если ЗначениеЗаполнено(ОбобщенныеДанныеРешения.ТекстОшибки) Тогда
		ТекстОшибки = ОбобщенныеДанныеРешения.ТекстОшибки;
		
		Возврат;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ОбобщенныеДанныеРешения.ДеревоДатИКомиссий, "Дерево");
	
	УстановитьТекущуюСтрокуДерева(ОбобщенныеДанныеРешения.ДеревоДатИКомиссий);
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		НастроитьФормуПриБлокировке();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Дерево

&НаКлиенте
Процедура ДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ДеревоКомиссия" Тогда
		ТекДанные = Элементы.Дерево.ТекущиеДанные;
		
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ПоказатьЗначение(, ТекДанные.Комиссия);
		
		Возврат;
	КонецЕсли;
	
	ЗакрытьФормуВернутьЗначение();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаВыбрать(Команда)
	
	ЗакрытьФормуВернутьЗначение();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Оформление строк-групп'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дерево.ЭтоГруппа");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстИнформационнойНадписи);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДеревоДатаИнвентаризации");

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуВернутьЗначение()
	
	ТекДанные = Элементы.Дерево.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите необходимую строку'"));
		
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.ЭтоГруппа Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите строку с номером комиссии'"));
		
		Возврат;
	КонецЕсли;
	
	ВозвращаемоеЗначение = Новый Структура("
		|ДатаИнвентаризации,
		|НомерКомиссии,
		|Комиссия");
	
	ЗаполнитьЗначенияСвойств(ВозвращаемоеЗначение, ТекДанные);
	
	Закрыть(ВозвращаемоеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуПриБлокировке()
	
	Элементы.КомандаВыбрать.Доступность = Ложь;
	
	ПоказатьПредупреждение(, СтрШаблон("%1
			|%2",
		ТекстОшибки,
		НСтр("ru='Выбор данных из таких Решений не предусмотрен.'")));
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекущуюСтрокуДерева(ОбъектДереваЗначений)
	
	Поиск = Новый Структура("ДатаИнвентаризации,НомерКомиссии");
	
    ЗаполнитьЗначенияСвойств(Поиск, Параметры);
	
	МассивСтрок = ОбъектДереваЗначений.Строки.НайтиСтроки(Поиск, Истина);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КоординатыСтроки = ИнвентаризацияСервер.ОпределитьКоординатыСтрокиДереваЗначений(ОбъектДереваЗначений, МассивСтрок[0]);
	
	ИдСтроки = ИнвентаризацияСервер.ПолучитьИдентификаторСтрокиДереваПоКоординатам(Дерево, КоординатыСтроки);
	
	Элементы.Дерево.ТекущаяСтрока = ИдСтроки;
	
КонецПроцедуры

#КонецОбласти
