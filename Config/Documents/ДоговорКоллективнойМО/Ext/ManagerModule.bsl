#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ДоговорКоллективнойМО";
	КомандаПечати.Идентификатор = "Приложение";
	КомандаПечати.Представление = НСтр("ru = 'Договор о полной коллективной материальной ответственности'");
	КомандаПечати.Порядок		= 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Приложение") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,	"Приложение","Договор о полной коллективной (бригадной) материальной ответственности",ПечатьПриложение(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
КонецПроцедуры		

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

Функция ДанныеПрекращенияДоговора(Договор, Проведен = Ложь) Экспорт
	
	СтруктураВозврата = Новый Структура("ДокументСсылка", Неопределено);
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПрекращениеДоговорКоллективнойМО.Ссылка КАК ДокументСсылка
	|ИЗ
	|	Документ.ПрекращениеДоговорКоллективнойМО КАК ПрекращениеДоговорКоллективнойМО
	|ГДЕ
	|	ПрекращениеДоговорКоллективнойМО.ДоговорОснование = &ДоговорОснование");
	
	Запрос.УстановитьПараметр("ДоговорОснование", Договор);
	
	Если Проведен Тогда
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
		
		ОператорыВыбора = СхемаЗапроса.ПакетЗапросов[0].Операторы[0];
		ПолеДата = ОператорыВыбора.ВыбираемыеПоля.Добавить("ПрекращениеДоговорКоллективнойМО.Дата");
		СхемаЗапроса.ПакетЗапросов[0].Колонки.Найти(ПолеДата).Псевдоним = "ДатаПрекращения";
		ОператорыВыбора.Отбор.Добавить("ПрекращениеДоговорКоллективнойМО.Проведен");
		
		Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
		СтруктураВозврата.Вставить("ДатаПрекращения", Дата(1,1,1));
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, Выборка);
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьТабличныйДокумент85_251(ТабДокумент, Макет, Шапка, ТаблицаТЧ, ПриказНомер)
	
	ОбШапка = Макет.ПолучитьОбласть("Шапка");
	ОбСтрока = Макет.ПолучитьОбласть("Строка");
	ОбПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ОбШапка.Параметры.Заполнить(Шапка);
	СтруктураОбШапка = Новый Структура("ДоговорНомер");
	СтруктураОбШапка.ДоговорНомер = "ДОГОВОР № " + ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Шапка.Ссылка, Шапка.Номер);
	
	Если ЗначениеЗаполнено(Шапка.РуководительЗаместитель) И ПриказНомер = "85" Тогда
		Если (Шапка.ЭтоРуководитель) Тогда
			ИмяПараметра = "РуководительИмя";
		Иначе
			ИмяПараметра = "ЗаместительИмя";
		КонецЕсли;
		СтруктураОбШапка.Вставить(ИмяПараметра, Шапка.РуководительНаименование);
	КонецЕсли;
	
	ОбШапка.Параметры.Заполнить(СтруктураОбШапка);
	ТабДокумент.Вывести(ОбШапка);

	Для Каждого Стр Из ТаблицаТЧ Цикл	
		ОбСтрока.Параметры.Заполнить(Стр);
		ТабДокумент.Вывести(ОбСтрока);
	КонецЦикла;

	ОбПодвал.Параметры.Заполнить(Шапка);
	ТабДокумент.Вывести(обПодвал);
	
КонецПроцедуры

// Функция формирует табличный документ Договор о полной коллективной (бригадной) материальной ответственности
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция ПечатьПриложение(МассивОбъектов, ОбъектыПечати)
		
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ДоговорКоллективнойМО";
	ТабДокумент.АвтоМасштаб = Истина;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорКоллективнойМО.Ссылка КАК Ссылка,
		|	ДоговорКоллективнойМО.Номер КАК Номер,
		|	ДоговорКоллективнойМО.Дата КАК Дата,
		|	ДоговорКоллективнойМО.ДатаВступленияВСилу КАК ДатаВступленияВСилу,
		|	ДоговорКоллективнойМО.Работа КАК Работа,
		|	ВЫБОР
		|		КОГДА СОКРЛП(ДоговорКоллективнойМО.Организация.НаименованиеПолное) = """"
		|			ТОГДА ДоговорКоллективнойМО.Организация.Наименование
		|		ИНАЧЕ ДоговорКоллективнойМО.Организация.НаименованиеПолное
		|	КОНЕЦ КАК ОрганизацияНаименование,
		|	ДоговорКоллективнойМО.ЭтоРуководитель КАК ЭтоРуководитель,
		|	ДоговорКоллективнойМО.РуководительЗаместитель КАК РуководительЗаместитель,
		|	ДоговорКоллективнойМО.Устав КАК Устав,
		|	ДоговорКоллективнойМО.РуководительКоллектива КАК РуководительКоллектива,
		|	ВЫБОР
		|		КОГДА ДоговорКоллективнойМО.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|			ТОГДА """"
		|		ИНАЧЕ ДоговорКоллективнойМО.Подразделение.Наименование
		|	КОНЕЦ КАК Подразделение,
		|	ВЫБОР
		|		КОГДА ДоговорКоллективнойМО.ДолжностьРуководитель = ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
		|			ТОГДА """"
		|		КОГДА СОКРЛП(ВЫРАЗИТЬ(ДоговорКоллективнойМО.ДолжностьРуководитель.НаименованиеПолное КАК СТРОКА(5))) = """"
		|			ТОГДА ДоговорКоллективнойМО.ДолжностьРуководитель.Наименование
		|		ИНАЧЕ ДоговорКоллективнойМО.ДолжностьРуководитель.НаименованиеПолное
		|	КОНЕЦ КАК РуководительДолжность,
		|	ВЫБОР
		|		КОГДА ДоговорКоллективнойМО.Должность = ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
		|			ТОГДА """"
		|		КОГДА СОКРЛП(ВЫРАЗИТЬ(ДоговорКоллективнойМО.Должность.НаименованиеПолное КАК СТРОКА(5))) = """"
		|			ТОГДА ДоговорКоллективнойМО.Должность.Наименование
		|		ИНАЧЕ ДоговорКоллективнойМО.Должность.НаименованиеПолное
		|	КОНЕЦ КАК РуководительКоллективаДолжность,
		|	ЕСТЬNULL(ОрганизацииКонтактнаяИнформация.Представление, """") КАК ЮрАдресОрганизации,
		|	ВЫБОР
		|		КОГДА ДоговорКоллективнойМО.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|				ИЛИ ДоговорКоллективнойМО.РуководительКоллектива = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОтказПечати
		|ИЗ
		|	Документ.ДоговорКоллективнойМО КАК ДоговорКоллективнойМО
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации.КонтактнаяИнформация КАК ОрганизацииКонтактнаяИнформация
		|		ПО ДоговорКоллективнойМО.Организация = ОрганизацииКонтактнаяИнформация.Ссылка
		|			И (ОрганизацииКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
		|			И (ОрганизацииКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮрАдресОрганизации))
		|ГДЕ
		|	ДоговорКоллективнойМО.Ссылка В(&МассивОбъектов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоговорКоллективнойМОСотрудники.Ссылка КАК Ссылка,
		|	ЕСТЬNULL(ДоговорКоллективнойМОСотрудники.Сотрудник, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК Сотрудник
		|ИЗ
		|	Документ.ДоговорКоллективнойМО.Сотрудники КАК ДоговорКоллективнойМОСотрудники
		|ГДЕ
		|	ДоговорКоллективнойМОСотрудники.Ссылка В(&МассивОбъектов)
		|	И НЕ ДоговорКоллективнойМОСотрудники.Сотрудник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
		|	И НЕ ДоговорКоллективнойМОСотрудники.Сотрудник ЕСТЬ NULL
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка,
		|	ДоговорКоллективнойМОСотрудники.НомерСтроки";
	
	ПервыйДокумент = Истина;
	МассивРезультатов = Запрос.ВыполнитьПакет();
	Шапка = МассивРезультатов[0].Выбрать();
	Сотрудники = МассивРезультатов[1].Выгрузить(); //Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ПервыйДокумент = Истина;
	
	Пока Шапка.Следующий() Цикл
		// Если не заполнена Организация, либо РуководительЗаместитель, либо Сотрудник, тогда не печатаем договор.
		Если Шапка.ОтказПечати Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПервыйДокумент Тогда
			// Все документы нужно выводить на разных страницах.
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;    
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ МассивРезультатов[0].Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, Шапка[Колонка.Имя]);
		КонецЦикла;  
		ТаблицаТЧ = Сотрудники.Скопировать(Новый Структура("Ссылка", Шапка.Ссылка)); 
		ТаблицаТЧ.Колонки.Добавить("СотрудникИмяАдрес", Новый ОписаниеТипов("Строка"));
		
		МассивСотрудников = ТаблицаТЧ.ВыгрузитьКолонку("Сотрудник");
		МассивСотрудников.Добавить(Шапка.РуководительЗаместитель);
		МассивСотрудников.Добавить(Шапка.РуководительКоллектива);
		ДанныеСотрудников = Справочники.Сотрудники.ДанныеСотрудников(МассивСотрудников, "НаименованиеПолное,АдресПоПропискеФизическиеЛица", Шапка.Дата, Истина); 
		
		ДанныеСотрудника = ДанныеСотрудников.Получить(Шапка.РуководительЗаместитель);
		Если НЕ ДанныеСотрудника = Неопределено Тогда
			СтруктураДанных.Вставить("РуководительНаименование", ДанныеСотрудника.НаименованиеПолное);
		КонецЕсли;
		ДанныеСотрудника = ДанныеСотрудников.Получить(Шапка.РуководительКоллектива);
		Если НЕ ДанныеСотрудника = Неопределено Тогда
			СтруктураДанных.Вставить("РуководительКоллективаНаименование", ДанныеСотрудника.НаименованиеПолное); 
			СтруктураДанных.Вставить("АдресФизЛица", ДанныеСотрудника.АдресПоПропискеФизическиеЛица);
		КонецЕсли;  
		Для Каждого Стр Из ТаблицаТЧ Цикл 
			ДанныеСотрудника = ДанныеСотрудников.Получить(Стр.Сотрудник);
			Если НЕ ДанныеСотрудника = Неопределено Тогда
				Параметр_1 = ДанныеСотрудника.НаименованиеПолное;
				Параметр_2 = ""; 
				Параметр_3 = "";
				Если ЗначениеЗаполнено(ДанныеСотрудника.АдресПоПропискеФизическиеЛица) Тогда    
					Параметр_2 = ", "; 
					Параметр_3 = ДанныеСотрудника.АдресПоПропискеФизическиеЛица;
				КонецЕсли;	
				Стр.СотрудникИмяАдрес = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1%2%3'"), Параметр_1, Параметр_2, Параметр_3);
			КонецЕсли;	
		КонецЦикла;	
		
		Если Шапка.Дата < '20250901' Тогда
			Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ДоговорКоллективнойМО.ПФ_MXL_Приложение4");
			ЗаполнитьТабличныйДокумент85_251(ТабДокумент, Макет, СтруктураДанных, ТаблицаТЧ, "85");
		Иначе
			Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ДоговорКоллективнойМО.ПФ_MXL_Приложение4_251н");
			ЗаполнитьТабличныйДокумент85_251(ТабДокумент, Макет, СтруктураДанных, ТаблицаТЧ, "251")
		КонецЕсли;
			
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно. 
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
		
КонецФункции

#КонецОбласти

#КонецЕсли
