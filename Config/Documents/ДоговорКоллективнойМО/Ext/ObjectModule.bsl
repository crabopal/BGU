#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс
	
// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ДанныеПрекращенияДоговора = ОбщегоНазначенияБГУ.ДанныеПрекращенияДоговораСМОЛ(Ссылка, Истина);
	Если ДанныеПрекращенияДоговора.ДокументСсылка <> Неопределено Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Действие прекращено %1 запись невозможна'"), ДанныеПрекращенияДоговора.ДокументСсылка);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,,Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения = Неопределено Тогда
		ДанныеЗаполнения = Новый Структура;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ОрганизацияЗаполнения = Неопределено;
		Если Не ДанныеЗаполнения.Свойство("Организация", ОрганизацияЗаполнения) Тогда
			ОрганизацияЗаполнения = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
		КонецЕсли;
		ДанныеЗаполнения.Вставить("РуководительЗаместитель",
		                            ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ОрганизацияЗаполнения, 
																								Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, 
																								ТекущаяДатаСеанса()).ОтветственноеЛицоСсылка);
		ДанныеЗаполнения.Вставить("ДатаВступленияВСилу", ТекущаяДатаСеанса());
		
		РуководительЗаместитель = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "РуководительЗаместитель");
		
		Если РуководительЗаместитель <> Неопределено Тогда
			ТребуемыеДанные = Новый Структура("СсылкаНаОбъект, Период, Должность", РуководительЗаместитель, ТекущаяДатаСеанса());
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ТребуемыеДанные);
			
			ДолжностьРуководитель = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ТребуемыеДанные, "Должность");
			Если ДолжностьРуководитель <> Неопределено Тогда
				ДанныеЗаполнения.Вставить("ДолжностьРуководитель", ДолжностьРуководитель);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	НеАктуален = Ложь;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли