&НаСервере
Процедура ОбновитьРуководителя()
	Объект.РуководительЗаместитель = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(Объект.Организация,Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,Объект.Дата).ОтветственноеЛицоСсылка;
	ОбновитьДанныеСотрудника(Объект.Подразделение,Объект.ДолжностьРуководитель, Объект.Дата, Объект.РуководительЗаместитель);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовПерекращенияДействия(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	Форма.Элементы,
	"НеАктуален",
	"Видимость",
	Форма.Объект.НеАктуален);
	
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	Форма.Элементы,
	"ИнформацияОПрекращенииДоговора",
	"Видимость",
	Форма.ПризнакПрекращенияДоговора);

КонецПроцедуры

&НаСервере
Процедура ОбработатьДанныеПрекращенияДоговора()
	
	ДанныеПрекращенияДоговора = ОбщегоНазначенияБГУ.ДанныеПрекращенияДоговораСМОЛ(Объект.Ссылка, Истина);
	
	Если ДанныеПрекращенияДоговора.ДокументСсылка <> Неопределено Тогда
		
		ПризнакПрекращенияДоговора = Истина;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ИнформацияОПрекращенииДоговора",
		"Заголовок",
		"Не действует с " + Формат(ДанныеПрекращенияДоговора.ДатаПрекращения, "ДЛФ=D"));
		
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьДанныеСотрудника(Подразделение,Должность,Дата,Сотрудник)
	ТребуемыеДанные = Новый Структура("СсылкаНаОбъект, Период, Должность, Подразделение",Сотрудник,Дата);
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ТребуемыеДанные);
	Подразделение = ТребуемыеДанные.Подразделение;
	Должность = ТребуемыеДанные.Должность;
КонецПроцедуры

