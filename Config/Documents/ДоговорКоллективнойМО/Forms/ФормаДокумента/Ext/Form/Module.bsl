&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	Объект.ЭтоРуководитель = Истина;
	Объект.Должность = "";
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбновитьРуководителя();
	Иначе
		Объект.РуководительЗаместитель = "";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РуководительКоллективаПриИзменении(Элемент)
	ОбновитьДанныеСотрудника(Объект.Подразделение,Объект.Должность,Объект.Дата, Объект.РуководительКоллектива);
КонецПроцедуры

&НаКлиенте
Процедура РуководительЗаместительПриИзменении(Элемент)
	ОбновитьДанныеСотрудника(Объект.Подразделение,Объект.ДолжностьРуководитель, Объект.Дата, Объект.РуководительЗаместитель);
КонецПроцедуры

