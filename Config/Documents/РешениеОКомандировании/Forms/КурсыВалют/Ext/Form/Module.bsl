
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для Каждого Строка Из Параметры.КурсыВалют Цикл
		ЗаполнитьЗначенияСвойств(КурсыВалют.Добавить(), Строка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	Результат = Новый Массив;
	Для Каждого Строка Из КурсыВалют Цикл
		Результат.Добавить(Новый Структура("Валюта, Курс, Кратность", Строка.Валюта, Строка.Курс, Строка.Кратность));
	КонецЦикла;
	
	Закрыть(Результат);
	
КонецПроцедуры

#КонецОбласти
