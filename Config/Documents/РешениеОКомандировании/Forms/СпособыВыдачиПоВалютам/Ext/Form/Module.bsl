
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для Каждого Строка Из Параметры.СпособыВыдачи Цикл
		ЗаполнитьЗначенияСвойств(СпособыВыдачиДенежныхСредств.Добавить(), Строка);
	КонецЦикла;
	
	ТолькоПросмотр = Параметры.ТолькоПросмотр;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	Результат = Новый Массив;
	Для Каждого Строка Из СпособыВыдачиДенежныхСредств Цикл
		Результат.Добавить(Новый Структура("Валюта, СпособВыдачи", Строка.Валюта, Строка.СпособВыдачи));
	КонецЦикла;
	
	Закрыть(Результат);
	
КонецПроцедуры

#КонецОбласти
