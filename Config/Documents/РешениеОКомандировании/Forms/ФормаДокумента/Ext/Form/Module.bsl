	Если СтрДлина(Текст) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.УсловияПроезда.ТекущиеДанные;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидТранспорта", ТекущаяСтрока.ВидТранспорта);
	Если ЗначениеЗаполнено(ТекущаяСтрока.СтранаОтправления) Тогда
		Отбор.Вставить("Страна", ТекущаяСтрока.СтранаОтправления);
	КонецЕсли;
	
	ПараметрыВыбораЗначения = Новый Структура;
	ПараметрыВыбораЗначения.Вставить("СтрокаПоиска", Текст);
	ПараметрыВыбораЗначения.Вставить("Отбор", Отбор);
	ПараметрыВыбораЗначения.Вставить("СпособПоискаСтроки", СпособПоискаСтрокиПриВводеПоСтроке.ЛюбаяЧасть);
	
	ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.ПунктыОтправленийПрибытий"), ПараметрыВыбораЗначения);
	Если ДанныеВыбора.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

