КонецПроцедуры

&НаКлиенте
Процедура КлассификацияРасходовНаОтдельнойЗакладке(Команда)
	
	Пометка = Элементы.ФормаКлассификацияРасходовНаОтдельнойЗакладке.Пометка;
	
	ПометкаНовая = НЕ Пометка;
	
	УправлениеВидимостьюКлассификацииРасходов(Элементы, ПометкаНовая);
	
	Элементы.ФормаКлассификацияРасходовНаОтдельнойЗакладке.Пометка = ПометкаНовая;
	
	Если ПометкаНовая Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаКлассификацияРасходов;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаличиеЛБО(Команда)
	
	Если НеЗаполненРеквзитВТаблицеОбъекта("ФинансовоеОбеспечение", "ФинансовыйГод", НСтр("ru = 'финансовый год'")) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаличиеЛБОНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОбратныйПроезд(Команда)
	
	ТекущиеДанные = Элементы.УсловияПроезда.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура("ВидТранспорта, КатегорияПоНормативу, КатегорияФактическая, Валюта,
		|КПС, КЭК, КФО, КодЦели, КодМероприятия, ДопКлассификация, СпособОбеспечения");
	ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, ТекущиеДанные);
	
	НоваяСтрока = Объект.УсловияПроезда.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураРеквизитов);
	
	НоваяСтрока.ПунктОтправления 	= ТекущиеДанные.ПунктПрибытия;
	НоваяСтрока.ПунктПрибытия 		= ТекущиеДанные.ПунктОтправления;
	Новаястрока.СтранаПрибытия 		= ТекущиеДанные.СтранаОтправления;
	НоваяСтрока.СтранаОтправления	= ТекущиеДанные.СтранаПрибытия;
	
	ЗаполнитьНаименованиеРасходаПроезд(НоваяСтрока);
	
	ОбновитьТекстЗаголовковВСтрокеТаблицыУсловияПроезда(НоваяСтрока);
	
	Элементы.УсловияПроезда.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Процедура РазрешитьРедактированиеСуточных(Команда)
	
	Если Объект.РучноеРедактированиеСуточных Тогда
		ТекстВопроса = НСтр("ru = 'Суточные будут рассчитаны автоматически. Продложить?'");
	Иначе
		ТекстВопроса = НСтр("ru = 'Будет отключен автоматический расчет суточных. Продложить?'");
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОРедактированииСуточных", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОРедактированииСуточных(Результат, Параметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Объект.РучноеРедактированиеСуточных = НЕ Объект.РучноеРедактированиеСуточных;
	
	УстановитьДоступностьРедактированияСуточных(ЭтотОбъект);
	
	УстановитьПометкуКнопкиРедактированияСуточных(ЭтотОбъект);
	
	Если НЕ Объект.РучноеРедактированиеСуточных Тогда
		
		ОбновитьТаблицуСуточные();
		
		ОбновитьТаблицуФинансовоеОбеспечение();
		
		ОбновитьТаблицыСпособыВыдачиИКурсыВалют(ЭтотОбъект);
		
		ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
		
		ОбновитьИтогиПоСпособамОбеспечения(ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыСтрок(Команда)
	
	ОбработкаЗавершения = Новый ОписаниеОповещения("ВыполнитьИзменениеРеквизитовСтрок", ЭтотОбъект);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("ИФО", Объект.ИФО);
	ПараметрыФормы.Вставить("Дата", Объект.Дата);
	
	ПараметрыФормы.Вставить("ДопустимыеКОСГУ", ДопустимыеКОСГУ);
	
	ТекущиеДанные = Элементы.КлассификацияРасходов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		НачальныеЗначения = Новый СписокЗначений;
		НачальныеЗначения.Добавить(ТекущиеДанные.КФО, "КФО");
		НачальныеЗначения.Добавить(ТекущиеДанные.КПС, "КПС");
		НачальныеЗначения.Добавить(ТекущиеДанные.КЭК, "КЭК");
		НачальныеЗначения.Добавить(ТекущиеДанные.КодЦели, "КодЦели");
		НачальныеЗначения.Добавить(ТекущиеДанные.КодМероприятия, "КодМероприятия");
		НачальныеЗначения.Добавить(ТекущиеДанные.ДопКлассификация, "ДопКлассификация");
		ПараметрыФормы.Вставить("НачальныеЗначения", НачальныеЗначения);
	КонецЕсли;
	
	ОткрытьФорму("Документ.РешениеОКомандировании.Форма.ФормаГрупповогоИзмененияРеквизитов",
		ПараметрыФормы, ЭтотОбъект,,,, ОбработкаЗавершения);
	
КонецПроцедуры

