КонецПроцедуры

&НаКлиенте
Процедура ТипРешенияПриИзменении(Элемент)
	УстановитьДоступностьРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ТипРешенияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Объект.ТипРешения Тогда
		
		СтандартнаяОбработка = Ложь;
		
	ИначеЕсли ВыбранноеЗначение = ПредопределенноеЗначение("Перечисление.ТипыРешенийОКомандировании.ИзменениеАннулирующее")
		ИЛИ ВыбранноеЗначение = ПредопределенноеЗначение("Перечисление.ТипыРешенийОКомандировании.ИзменениеФинансовое")
		ИЛИ Объект.ТипРешения = ПредопределенноеЗначение("Перечисление.ТипыРешенийОКомандировании.ИзменениеАннулирующее") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Оповещение = Новый ОписаниеОповещения("ОтветНаВопросПередИзменениемТипаРешения", ЭтотОбъект, ВыбранноеЗначение);
		ПоказатьВопрос(Оповещение, НСтр("ru='Документ будет перезаполнен данными последнего Решения / Изменения. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветНаВопросПередИзменениемТипаРешения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьИзменениеПоОснованию(ДополнительныеПараметры);
	
	Объект.ТипРешения = ДополнительныеПараметры;
	
	УстановитьДоступностьРеквизитов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаУтвержденияПриИзменении(Элемент)
	
	Если НачалоДня(Объект.Дата) = НачалоДня(Объект.ДатаУтверждения)
		И Объект.ДатаУтверждения < Объект.Дата Тогда
		Объект.ДатаУтверждения = Объект.Дата;
	КонецЕсли;
	
	Если Объект.ТипРешения = ПредопределенноеЗначение("Перечисление.ТипыРешенийОКомандировании.ИзменениеАннулирующее") Тогда
		Для Каждого Строка Из Объект.ФинансовоеОбеспечение Цикл
			Строка.ФинансовыйГод = Год(Объект.ДатаУтверждения);
		КонецЦикла;
	КонецЕсли;
	
	ПриИзмененииДатыУтвержденияНаСервере();
	
КонецПроцедуры

