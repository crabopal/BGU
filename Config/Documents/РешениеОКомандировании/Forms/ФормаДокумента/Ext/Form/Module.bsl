#Область ОбработчикиСобытийЭлементовТаблицыМестоИСроки

&НаКлиенте
Процедура МестоИСрокиПунктНазначенияАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.МестоИСроки.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.Страна)
		И ТекущиеДанные.Страна <> ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.АвтоПодборНаселенногоПункта(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура МестоИСрокиПунктНазначенияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.МестоИСроки.ТекущиеДанные.ПунктНазначения = ВыбранноеЗначение.Представление;
	
КонецПроцедуры

&НаКлиенте
Процедура МестоИСрокиОрганизацияНазначенияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ОткрытьФорму("Справочник.ЮридическиеЛица.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура МестоИСрокиОрганизацияНазначенияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
		ПолноеНаименованиеЮрЛица = ПолноеНаименованиеЮридическогоЛица(ВыбранноеЗначение);
		Если НЕ ПустаяСтрока(ПолноеНаименованиеЮрЛица) Тогда
			ВыбранноеЗначение = ПолноеНаименованиеЮрЛица;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МестоИСрокиПриИзменении(Элемент)
	
	ПеречитатьНормативыСуточных();
	
	ОбновитьТаблицуСуточные();
	
	ОбновитьТаблицуФинансовоеОбеспечение();
	
	ОбновитьТаблицыСпособыВыдачиИКурсыВалют(ЭтотОбъект);
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
	ОбновитьИтогиПоСпособамОбеспечения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура МестоИСрокиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Объект.КомандировкаЗаГраницу Тогда
		Элементы.МестоИСроки.ТекущиеДанные.Страна = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МестоИСрокиТерриторияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.МестоИСроки.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Новый Структура("Владелец", ?(ЗначениеЗаполнено(ТекущиеДанные.Страна),
		ТекущиеДанные.Страна, ПредопределенноеЗначение("Справочник.СтраныМира.Россия"))));
	ОткрытьФорму("Справочник.ТерриторииСОтдельнымиНормативами.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыУсловияПроезда

&НаКлиенте
Процедура УсловияПроездаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	Если Копирование Тогда
		
		ОбновитьТаблицуФинансовоеОбеспечение();
		
		ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
		
		ОбновитьИтогиПоСпособамОбеспечения(ЭтотОбъект);
		
		Возврат;
		
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.УсловияПроезда.ТекущиеДанные;
	
	ОбновитьТекстЗаголовковВСтрокеТаблицыУсловияПроезда(ТекущаяСтрока);
	
	ТекущаяСтрока.СпособОбеспечения = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу");
	
	ОбновитьТаблицыСпособыВыдачиИКурсыВалют(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияПроездаПослеУдаления(Элемент)
	
	ОбновитьТаблицуФинансовоеОбеспечение();
	
	ОбновитьТаблицыСпособыВыдачиИКурсыВалют(ЭтотОбъект);
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
	ОбновитьИтогиПоСпособамОбеспечения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияПроездаВидТранспортногоСредстваПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.УсловияПроезда.ТекущиеДанные;
	
	ПересчитатьНормативыПроездаВСтроке(ЭтотОбъект, Объект, ТекущаяСтрока);
	
	ЗаполнитьНаименованиеРасходаПроезд(ТекущаяСтрока);
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияПроездаПунктОтправленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.УсловияПроезда.ТекущиеДанные;
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	Отбор = Новый Структура;
	Отбор.Вставить("ВидТранспорта", ТекущаяСтрока.ВидТранспорта);
	Если ЗначениеЗаполнено(ТекущаяСтрока.СтранаОтправления) Тогда
		Отбор.Вставить("Страна", ТекущаяСтрока.СтранаОтправления);
	КонецЕсли;
	ПараметрыФормы.Вставить("Отбор", Отбор);
	ОткрытьФорму("Справочник.ПунктыОтправленийПрибытий.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияПроездаПунктОтправленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("ДанныеФормыСтруктура") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Модифицированность = Истина;
	
