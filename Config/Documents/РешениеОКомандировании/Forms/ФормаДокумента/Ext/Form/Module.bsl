// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ДанныеСотрудника                        = ОписаниеДанныхСотрудника(Объект.Сотрудник, Объект.Дата);
	
	ВидДоговора                             = ДанныеСотрудника.ВидДоговора;
	КатегорияДолжностиГосударственнойСлужбы = ДанныеСотрудника.КатегорияДолжностиГосударственнойСлужбы;
	ГруппаДолжностиГосударственнойСлужбы    = ДанныеСотрудника.ГруппаДолжностиГосударственнойСлужбы;
	
	ЭтоДействующийДокумент = Документы.РешениеОКомандировании.ЭтоПоследнийДействующийДокумент(Объект.Ссылка);
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
	ОбновитьИтогиПоСпособамОбеспечения(ЭтотОбъект);
	
	УстановитьВидимостьРеквизитов(ЭтотОбъект);
	
	УстановитьДоступностьРеквизитов(ЭтотОбъект);
	
	УстановитьПометкуКнопкиРедактированияСуточных(ЭтотОбъект);
	
	УстановитьПредставлениеСтрокиСпособВыдачиДС(ЭтотОбъект);
	
	УстановитьПредставлениеСтрокиКурсыВалют(ЭтотОбъект);
	
	ТерриторияКомандированияРФ = НЕ Объект.КомандировкаЗаГраницу;
	
	Если Объект.СпособыВыдачи.Количество() > 0 Тогда
		СпособВыдачиДенежныхСредств = Объект.СпособыВыдачи[0].СпособВыдачи;
	КонецЕсли;
		
	ОрганизацииСовпадают = Не ЗначениеЗаполнено(Объект.ОрганизацияОсуществляющаяОбеспечение)
		ИЛИ Объект.Организация = Объект.ОрганизацияОсуществляющаяОбеспечение;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьЗадолженностьНаСервере()
	
	Объект.Задолженность.Очистить();
	
	ВыборкаЗадолженностьПоВалютам = РасчетыСПодотчетнымиЛицами.ЗадолженностьСотрудникаНаДатуПоВалютам(
		Объект.Организация, Объект.ИФО, Объект.Сотрудник, Объект.Дата);
	
	Пока ВыборкаЗадолженностьПоВалютам.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Объект.Задолженность.Добавить(), ВыборкаЗадолженностьПоВалютам);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	УстановитьОтветственныхЛиц(Объект.Руководитель, Объект.РуководительФинЭкономПодразделения,
		Объект.ОтветственныйИсполнительКадры, Объект.Организация, Объект.Дата, Объект.Подразделение);
	
	Если Объект.Организация = Объект.ОрганизацияОсуществляющаяОбеспечение Тогда
		ОрганизацииСовпадают = Истина;
	ИначеЕсли ОрганизацииСовпадают Тогда
		Объект.ОрганизацияОсуществляющаяОбеспечение = Объект.Организация;
		УстановитьОтветственныхЛицОбеспечение(Объект.РуководительОрганизацииОсуществляющейОбеспечение,
			Объект.ОрганизацияОсуществляющаяОбеспечение, Объект.Дата);
	КонецЕсли;
	
	ОбновитьДанныеСотрудника();
	
	ПересчитатьЗадолженностьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
	ПересчитатьЗадолженностьНаСервере();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДатыОбратнойДороги(ТекущаяСтрока)
	
	Если НЕ ТекущаяСтрока.ТарифТудаОбратно Тогда
		ТекущаяСтрока.ДатаОтправленияОбратно        = "";
		ТекущаяСтрока.ДатаПрибытияОбратно           = ""; 
		ТекущаяСтрока.ДатаПересеченияГраницыОбратно = "";
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтветственныхЛиц(Руководитель, РуководительФЭП, ОтветственныйКадры, Организация, Дата, Подразделение)
	
	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"),
		Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	
	РуководительФЭП = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.РуководительПФС"),
		Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	
	ОтветственныйКадры = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.ОтветственныйИсполнительКадры"),
		Организация, Дата, Подразделение).ОтветственноеЛицоСсылка;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтветственныхЛицОбеспечение(Руководитель, Организация, Дата)
	
	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		"Руководитель", Организация, Дата).ОтветственноеЛицоСсылка;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()
	
	ОбновитьДанныеСтрокТаблицыУсловияПроезда();
	
	ОбновитьДанныеСтрокТаблицыСуточные();
	
	ОбновитьДанныеСтрокТаблицыУсловияПроживания();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеСтрокТаблицыУсловияПроезда()
	
	Для Каждого ТекущаяСтрока Из Объект.УсловияПроезда Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыУсловияПроезда(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыУсловияПроезда(ТекущаяСтрока)
	
	ТекущаяСтрока.ЗаголовокСтранаОтправления 	= НСтр("ru = 'Страна:'");
	ТекущаяСтрока.ЗаголовокПунктОтправления 	= НСтр("ru = 'Пункт:'");
	ТекущаяСтрока.ЗаголовокДатаОтправления 		= НСтр("ru = 'Дата:'");
	ТекущаяСтрока.ЗаголовокСтранаПрибытия 		= НСтр("ru = 'Страна:'");
	ТекущаяСтрока.ЗаголовокПунктПрибытия 		= НСтр("ru = 'Пункт:'");
	ТекущаяСтрока.ЗаголовокДатаПрибытия 		= НСтр("ru = 'Дата:'");  
	ТекущаяСтрока.ЗаголовокЭтоБилетТудаОбатно   = НСтр("ru = 'Выбран тариф:'");
	ТекущаяСтрока.ЗаголовокДатаОтправленияОбр   = НСтр("ru = 'Дата отправления:'");  
	ТекущаяСтрока.ЗаголовокДатаПрибытияОбр      = НСтр("ru = 'Дата прибытия:'");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеСтрокТаблицыСуточные()
	
	Если Объект.РучноеРедактированиеСуточных Тогда
		Для каждого СтрокаСуточные Из Объект.Суточные Цикл
			СтрокаСуточные.Норматив = ?(СтрокаСуточные.КоличествоДней = 0, 0, СтрокаСуточные.Сумма / СтрокаСуточные.КоличествоДней);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	СтранаРоссия = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
	ОтборСуточные = Документы.РешениеОКомандировании.ТаблицаОтборовСуточных();
	
	Для Каждого СтрокаСуточные Из Объект.Суточные Цикл
		
		СтрокаСуточные.Норматив = 0;
		
		Для Каждого СтрокаМестоИСроки Из Объект.МестоИСроки Цикл
			
			СтранаМестоСроки = ?(ЗначениеЗаполнено(СтрокаМестоИСроки.Страна), СтрокаМестоИСроки.Страна, СтранаРоссия);
			
			Если СтрокаСуточные.Страна = СтранаМестоСроки
				И СтрокаСуточные.Территория = СтрокаМестоИСроки.Территория Тогда
				СтрокаСуточные.Норматив = СтрокаМестоИСроки.Норматив;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаСуточные.Норматив = 0 И СтрокаСуточные.Страна = ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда
			
			НоваяСтрокаОтбора = ОтборСуточные.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаОтбора, СтрокаСуточные);
			НоваяСтрокаОтбора.ДополнительноеУсловие = Справочники.ДополнительныеУсловияКомандирования.ПустаяСсылка();
			
		КонецЕсли;
	КонецЦикла;
	
	Если ОтборСуточные.Количество() > 0 Тогда
		
		ОтборОсновныеРеквизиты = Новый Структура; 
		
		ОтборОсновныеРеквизиты.Вставить("Период",       ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата));
		ОтборОсновныеРеквизиты.Вставить("Организация",  Объект.Организация);
		ОтборОсновныеРеквизиты.Вставить("ОсобыйСтатус", Объект.ОсобыйСтатус);
		ОтборОсновныеРеквизиты.Вставить("ВидДоговора",  ВидДоговора);
		
		НормативыСуточных = Документы.РешениеОКомандировании.СуточныеПоНормативуСтранИТерриторий(ОтборОсновныеРеквизиты, ОтборСуточные); 
		Отбор = Новый Структура("Страна, Территория, ВидДоговора");
		
		Для Каждого ТекущаяСтрока Из Объект.Суточные Цикл 
			
			Отбор.Страна      = ТекущаяСтрока.Страна;
			Отбор.Территория  = ТекущаяСтрока.Территория; 
			Отбор.ВидДоговора = ВидДоговора;
			СтрокиНормативов  = НормативыСуточных.НайтиСтроки(Отбор);   
			
			Если СтрокиНормативов.Количество() > 0 Тогда
				ТекущаяСтрока.Норматив = СтрокиНормативов[0].Норматив;
				ТекущаяСтрока.Валюта   = СтрокиНормативов[0].Валюта;
			КонецЕсли;    
			
		КонецЦикла;   
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеСтрокТаблицыУсловияПроживания()
	
	Для Каждого ТекущаяСтрока Из Объект.УсловияПроживания Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыУсловияПроживания(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыУсловияПроживания(ТекущаяСтрока)
	
	ТекущаяСтрока.ЗаголовокВСутки = НСтр("ru = 'в сутки'");
	
КонецПроцедуры

&НаСервере
Процедура ПеречитатьНормативыСуточных()
	
	ОтборОсновныеРеквизиты = Новый Структура; 
	
	ОтборОсновныеРеквизиты.Вставить("Период",       ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата));
	ОтборОсновныеРеквизиты.Вставить("Организация",  Объект.Организация);
	ОтборОсновныеРеквизиты.Вставить("ОсобыйСтатус", Объект.ОсобыйСтатус);   
	ОтборОсновныеРеквизиты.Вставить("ВидДоговора",  ВидДоговора);
	
	ОтборМестоИСроки = Документы.РешениеОКомандировании.ТаблицаОтборовСуточных();
	Для Каждого ТекущаяСтрока Из Объект.МестоИСроки Цикл
		НоваяСтрокаОтбора = ОтборМестоИСроки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаОтбора, ТекущаяСтрока);
	КонецЦикла;
	
	НормативыСуточных = Документы.РешениеОКомандировании.СуточныеПоНормативуСтранИТерриторий(ОтборОсновныеРеквизиты, ОтборМестоИСроки); 
	
	Объект.НормативыСуточных.Загрузить(НормативыСуточных);
	
	НормативыСуточных.Свернуть("Страна, Территория, ДополнительноеУсловие, ОплачиваютсяОднодневныеКомандировки, Валюта", "Норматив");
	
	Отбор             = Новый Структура("Страна, Территория, ДополнительноеУсловие");
	
	Для Каждого ТекущаяСтрока Из Объект.МестоИСроки Цикл    
		
		Отбор.Страна                 = ТекущаяСтрока.Страна;
		Отбор.Территория             = ТекущаяСтрока.Территория;
		Отбор.ДополнительноеУсловие  = ТекущаяСтрока.ДополнительноеУсловие;  
				
		СтрокиНормативов             = НормативыСуточных.НайтиСтроки(Отбор);  
		
		Если СтрокиНормативов.Количество() > 0 Тогда
			ТекущаяСтрока.Норматив = ?(ТекущаяСтрока.ДатаНачала = ТекущаяСтрока.ДатаОкончания И НЕ СтрокиНормативов[0].ОплачиваютсяОднодневныеКомандировки, 0, СтрокиНормативов[0].Норматив);
			ТекущаяСтрока.Валюта   = СтрокиНормативов[0].Валюта;
		Иначе	
			Отбор.Страна           = ТекущаяСтрока.Страна;
			Отбор.Территория       = ТекущаяСтрока.Территория;	
			
			Если СтрокиНормативов.Количество() > 0 Тогда
				ТекущаяСтрока.Норматив = ?(ТекущаяСтрока.ДатаНачала = ТекущаяСтрока.ДатаОкончания И НЕ СтрокиНормативов[0].ОплачиваютсяОднодневныеКомандировки, 0, СтрокиНормативов[0].Норматив);
				ТекущаяСтрока.Валюта   = СтрокиНормативов[0].Валюта;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПеречитатьНормативыПроезда()
	
	Для Каждого ТекущаяСтрока Из Объект.УсловияПроезда Цикл
		ПересчитатьНормативыПроездаВСтроке(ЭтотОбъект, Объект, ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьНормативыПроездаВСтроке(Форма, Объект, ТекущаяСтрока)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Период",                                  ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата));
	Отбор.Вставить("Организация",                             Объект.Организация);
	Отбор.Вставить("ВидТранспорта",                           ТекущаяСтрока.ВидТранспорта);
	Отбор.Вставить("ВидДоговора",                             Форма.ВидДоговора);
	Отбор.Вставить("КатегорияДолжностиГосударственнойСлужбы", Форма.КатегорияДолжностиГосударственнойСлужбы);
	Отбор.Вставить("ГруппаДолжностиГосударственнойСлужбы",    Форма.ГруппаДолжностиГосударственнойСлужбы);
	Отбор.Вставить("ОсобыйСтатус",                            Объект.ОсобыйСтатус);
	
	ТекущаяСтрока.КатегорияПоНормативу = УсловиеПроездаПоНормативу(Отбор);	
	ТекущаяСтрока.КатегорияФактическая = ТекущаяСтрока.КатегорияПоНормативу;
	
КонецПроцедуры

&НаСервере
Процедура ПеречитатьНормативыПроживания()
	
	Для Каждого ТекущаяСтрока Из Объект.УсловияПроживания Цикл
		ПересчитатьНормативыПроживанияВСтроке(ЭтотОбъект, Объект, ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьНормативыПроживанияВСтроке(Форма, Объект, ТекущаяСтрока)
	
	Страна = ?(ЗначениеЗаполнено(ТекущаяСтрока.Страна), ТекущаяСтрока.Страна, ПредопределенноеЗначение("Справочник.СтраныМира.Россия"));
	
	Отбор = Новый Структура;
	Отбор.Вставить("Период",            ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата));
	Отбор.Вставить("Организация",       Объект.Организация);
	Отбор.Вставить("ВидДоговора",       Форма.ВидДоговора);
	Отбор.Вставить("УсловиеПроживания", ТекущаяСтрока.УсловиеПроживания);
	
	Если Страна = ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда
		Отбор.Вставить("КатегорияДолжностиГосударственнойСлужбы", Форма.КатегорияДолжностиГосударственнойСлужбы);
		Отбор.Вставить("ГруппаДолжностиГосударственнойСлужбы", Форма.ГруппаДолжностиГосударственнойСлужбы);
	Иначе
		Отбор.Вставить("КатегорияДолжностиГосударственнойСлужбы", ПредопределенноеЗначение("Перечисление.КатегорииДолжностейГосударственнойСлужбы.ПустаяСсылка"));
		Отбор.Вставить("ГруппаДолжностиГосударственнойСлужбы", ПредопределенноеЗначение("Перечисление.ГруппыДолжностейГосударственнойСлужбы.ПустаяСсылка"));
	КонецЕсли;     
	
	Отбор.Вставить("Страна", Страна);
	Отбор.Вставить("Территория", ТекущаяСтрока.ТерриторияСНадбавками);
	Отбор.Вставить("ОсобыйСтатус", Объект.ОсобыйСтатус);
	
	НормативПроживания                 = УсловиеПроживанияПоНормативу(Отбор);
	
	ТекущаяСтрока.КатегорияПоНормативу = НормативПроживания.Категория;
	ТекущаяСтрока.СуммаПоНормативу     = НормативПроживания.Сумма;
	ТекущаяСтрока.ВалютаПоНормативу    = НормативПроживания.Валюта;
	
	ТекущаяСтрока.КатегорияФактическая = ТекущаяСтрока.КатегорияПоНормативу;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Валюта) Тогда
		ТекущаяСтрока.Валюта = ТекущаяСтрока.ВалютаПоНормативу;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитов(Форма)
	
	УстановитьВидимостьРеквизитовИзменение(Форма);
	
	УстановитьВидимостьРеквизитовЗаГраницы(Форма);
	
	УстановитьВидимостьРеквизитовСпособВыдачиДС(Форма);
	
	УстановитьВидимостьСтрокиКурсыВалют(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСтрокиКурсыВалют(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НадписьКурсыВалют", "Видимость",
		Форма.Объект.КурсыВалют.Количество() > 0);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитовЗаГраницы(Форма)
	
	Элементы = Форма.Элементы;
	
	КомандировкаЗаГраницу = Форма.Объект.КомандировкаЗаГраницу;
	
	РеквизитыДляКомандировкиПоРФ = Новый Массив;
	РеквизитыДляКомандировкиПоРФ.Добавить("ГруппаИтоги");
	РеквизитыДляКомандировкиПоРФ.Добавить("ПодсказкаОднодневныеКомандировки");
	РеквизитыДляКомандировкиПоРФ.Добавить("УсловияПроживанияТерриторияСНадбавкамиРФ");
	
	Для Каждого Реквизит Из РеквизитыДляКомандировкиПоРФ Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, Реквизит, "Видимость", НЕ КомандировкаЗаГраницу);
	КонецЦикла;
	
	РеквизитыДляКомандировкиЗаГраницу = Новый Массив;
	РеквизитыДляКомандировкиЗаГраницу.Добавить("МестоИСрокиСтрана");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("МестоИСрокиВалюта");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("УсловияПроездаЗаголовокСтранаОтправления");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("УсловияПроездаСтранаОтправления");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("УсловияПроездаДатаПересеченияГраницы"); 
	РеквизитыДляКомандировкиЗаГраницу.Добавить("УсловияПроездаДатаПересеченияГраницыОбратно");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("УсловияПроездаЗаголовокСтранаПрибытия");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("УсловияПроездаСтранаПрибытия");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("УсловияПроездаВалюта");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("СуточныеСтрана");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("СуточныеВалюта");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("УсловияПроживанияСтрана");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("УсловияПроживанияНаселенныйПункт");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("УсловияПроживанияТерриторияСНадбавками");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("УсловияПроживанияВалютаПоНормативу");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("УсловияПроживанияВалютаФактическая");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("УсловияПроживанияВалюта");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("ПрочиеРасходыВалюта");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("КлассификацияРасходовВалюта");
	РеквизитыДляКомандировкиЗаГраницу.Добавить("НадписьКурсыВалют");
	
	Для Каждого Реквизит Из РеквизитыДляКомандировкиЗаГраницу Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, Реквизит, "Видимость", КомандировкаЗаГраницу);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитовСпособВыдачиДС(Форма)
	
	Элементы = Форма.Элементы;
	
	МассивСпособовВыдачи = Новый Массив;
	МассивВалют = Новый Массив;
	
	Для Каждого Строка Из Форма.Объект.СпособыВыдачи Цикл
		Если МассивСпособовВыдачи.Найти(Строка.СпособВыдачи) = Неопределено Тогда
			МассивСпособовВыдачи.Добавить(Строка.СпособВыдачи);
		КонецЕсли;
		Если МассивВалют.Найти(Строка.Валюта) = Неопределено Тогда
			МассивВалют.Добавить(Строка.Валюта);
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СпособВыдачиДенежныхСредств", "Видимость",
		МассивСпособовВыдачи.Количество() < 2);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РазбитьПоВалютам", "Видимость",
		МассивСпособовВыдачи.Количество() < 2 И МассивВалют.Количество() > 1);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьСпособВыдачиДенежныхСредств", "Видимость",
		МассивСпособовВыдачи.Количество() > 1 И МассивВалют.Количество() > 1);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитовИзменение(Форма)
	
	ЭтоИзменение = ЗначениеЗаполнено(Форма.Объект.ДокументОснование);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ПредыдущийДокумент", "Видимость", ЭтоИзменение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Изменение", "Видимость", ЭтоИзменение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ФинансовоеОбеспечениеИзменение", "Видимость", ЭтоИзменение);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ФинансовоеОбеспечениеИзменениеАванса", "Видимость", ЭтоИзменение);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьРеквизитов(Форма)
	
	ЭтоИзменение = ЗначениеЗаполнено(Форма.Объект.ТипРешения)
		И Форма.Объект.ТипРешения <> ПредопределенноеЗначение("Перечисление.ТипыРешенийОКомандировании.Первичное");
	
	НедоступныеПриИзмененииРеквизиты = Новый Массив;
	НедоступныеПриИзмененииРеквизиты.Добавить("Сотрудник");
	НедоступныеПриИзмененииРеквизиты.Добавить("Должность");
	НедоступныеПриИзмененииРеквизиты.Добавить("Подразделение");
	НедоступныеПриИзмененииРеквизиты.Добавить("ОсобыйСтатус");
	НедоступныеПриИзмененииРеквизиты.Добавить("ТерриторияКомандирования");
	НедоступныеПриИзмененииРеквизиты.Добавить("Организация");
	НедоступныеПриИзмененииРеквизиты.Добавить("ИФО");
	
	Для Каждого Реквизит Из НедоступныеПриИзмененииРеквизиты Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, Реквизит, "ТолькоПросмотр", ЭтоИзменение);
	КонецЦикла;
	
	ЭтоАннулирующееИзменение = Форма.Объект.ТипРешения = ПредопределенноеЗначение("Перечисление.ТипыРешенийОКомандировании.ИзменениеАннулирующее");
	
	НедоступныеПриАннулированииРеквизиты = Новый Массив;
	НедоступныеПриАннулированииРеквизиты.Добавить("МестоИСроки");
	НедоступныеПриАннулированииРеквизиты.Добавить("СодержаниеЗадания");
	НедоступныеПриАннулированииРеквизиты.Добавить("УсловияПроезда");
	НедоступныеПриАннулированииРеквизиты.Добавить("Суточные");
	НедоступныеПриАннулированииРеквизиты.Добавить("УсловияПроживания");
	НедоступныеПриАннулированииРеквизиты.Добавить("ПрочиеРасходы");
	НедоступныеПриАннулированииРеквизиты.Добавить("НадписьСпособВыдачиДенежныхСредств");
	НедоступныеПриАннулированииРеквизиты.Добавить("СпособВыдачиДенежныхСредств");
	НедоступныеПриАннулированииРеквизиты.Добавить("Задолженность");
	НедоступныеПриАннулированииРеквизиты.Добавить("КлассификацияРасходов");
	НедоступныеПриАннулированииРеквизиты.Добавить("ОснованиеПринятияОбязательства");
	НедоступныеПриАннулированииРеквизиты.Добавить("РазделЛицевогоСчета");
	НедоступныеПриАннулированииРеквизиты.Добавить("ФинансовоеОбеспечение");
	НедоступныеПриАннулированииРеквизиты.Добавить("ОрганизацияОсуществляющаяОбеспечение");
	
	Для Каждого Реквизит Из НедоступныеПриАннулированииРеквизиты Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, Реквизит, "ТолькоПросмотр", ЭтоАннулирующееИзменение);
	КонецЦикла;
	
	НедоступныеПриАннулированииРеквизиты = Новый Массив;
	НедоступныеПриАннулированииРеквизиты.Добавить("УсловияПроездаДобавитьОбратныйПроезд");
	НедоступныеПриАннулированииРеквизиты.Добавить("РазбитьПоВалютам");
	НедоступныеПриАннулированииРеквизиты.Добавить("ФинансовоеОбеспечениеПроверитьНаличиеЛБО");
	НедоступныеПриАннулированииРеквизиты.Добавить("НадписьКурсыВалют");
	НедоступныеПриАннулированииРеквизиты.Добавить("РазрешитьРедактированиеСуточных");
	
	Для Каждого Реквизит Из НедоступныеПриАннулированииРеквизиты Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Форма.Элементы, Реквизит, "Доступность", НЕ ЭтоАннулирующееИзменение И Форма.ЭтоДействующийДокумент);
	КонецЦикла;
	
	ЭтоФинансовоеИзменение = Форма.Объект.ТипРешения = ПредопределенноеЗначение("Перечисление.ТипыРешенийОКомандировании.ИзменениеФинансовое");
	
	НедоступныеПриФинансовомИзмененииРеквизиты = Новый Массив;
	НедоступныеПриФинансовомИзмененииРеквизиты.Добавить("МестоИСроки");
	
	Для Каждого Реквизит Из НедоступныеПриФинансовомИзмененииРеквизиты Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Форма.Элементы, Реквизит, "ТолькоПросмотр", ЭтоФинансовоеИзменение ИЛИ ЭтоАннулирующееИзменение);
	КонецЦикла;
	
	Форма.ТолькоПросмотр = НЕ Форма.ЭтоДействующийДокумент;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьРедактированияСуточных(Форма)
	
	РучноеРедактированиеСуточных = Форма.Объект.РучноеРедактированиеСуточных;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Суточные", "ИзменятьСоставСтрок", РучноеРедактированиеСуточных);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Суточные", "ИзменятьПорядокСтрок", РучноеРедактированиеСуточных);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СуточныеСтрана", "ТолькоПросмотр", НЕ РучноеРедактированиеСуточных);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СуточныеТерритория", "ТолькоПросмотр", НЕ РучноеРедактированиеСуточных);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СуточныеНорматив", "ТолькоПросмотр", НЕ РучноеРедактированиеСуточных);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СуточныеКоличествоДней", "ТолькоПросмотр", НЕ РучноеРедактированиеСуточных);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СуточныеСумма", "ТолькоПросмотр", НЕ РучноеРедактированиеСуточных);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СуточныеВалюта", "ТолькоПросмотр", НЕ РучноеРедактированиеСуточных);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "СуточныеДополнительноеУсловие", "ТолькоПросмотр", НЕ РучноеРедактированиеСуточных);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "МестоИСрокиНорматив", "ТолькоПросмотр", НЕ РучноеРедактированиеСуточных);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПометкуКнопкиРедактированияСуточных(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "РазрешитьРедактированиеСуточных", "Пометка", Форма.Объект.РучноеРедактированиеСуточных);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ГруппаСуточные", "Картинка",
		?(Форма.Объект.РучноеРедактированиеСуточных, БиблиотекаКартинок.Изменить, Новый Картинка));
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеСотрудника()
	
	ДанныеСотрудника = ОписаниеДанныхСотрудника(Объект.Сотрудник, Объект.Дата);
	
	ЭтоИзменение = ЗначениеЗаполнено(Объект.ТипРешения)
		И Объект.ТипРешения <> ПредопределенноеЗначение("Перечисление.ТипыРешенийОКомандировании.Первичное");
	
	Если НЕ ЭтоИзменение Тогда
		Объект.Подразделение = ДанныеСотрудника.Подразделение;
	КонецЕсли;
	
	Объект.Должность                        = ДанныеСотрудника.Должность;
	ВидДоговора                             = ДанныеСотрудника.ВидДоговора;
	КатегорияДолжностиГосударственнойСлужбы = ДанныеСотрудника.КатегорияДолжностиГосударственнойСлужбы;
	ГруппаДолжностиГосударственнойСлужбы    = ДанныеСотрудника.ГруппаДолжностиГосударственнойСлужбы;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОписаниеДанныхСотрудника(Сотрудник, Дата)
	
	ТребуемыеДанные = Новый Структура;
	ТребуемыеДанные.Вставить("СсылкаНаОбъект", Сотрудник);
	ТребуемыеДанные.Вставить("Период", Дата);
	ТребуемыеДанные.Вставить("Подразделение");
	ТребуемыеДанные.Вставить("Должность");
	ТребуемыеДанные.Вставить("ВидДоговора");
	ТребуемыеДанные.Вставить("КатегорияДолжностиГосударственнойСлужбы");
	ТребуемыеДанные.Вставить("ГруппаДолжностиГосударственнойСлужбы");
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ТребуемыеДанные, Истина);
	
	Возврат ТребуемыеДанные;
	
КонецФункции

&НаСервере
Процедура ПриИзмененииСотрудникаНаСервере()
	
	ОбновитьДанныеСотрудника();
	
	ПеречитатьНормативыСуточных();
	
	ПеречитатьНормативыПроезда();
	
	ПеречитатьНормативыПроживания();
	
	ОбновитьТаблицуСуточные();
	
	ОбновитьТаблицуФинансовоеОбеспечение();
	
	ОбновитьТаблицыСпособыВыдачиИКурсыВалют(ЭтотОбъект);
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
	ОбновитьИтогиПоСпособамОбеспечения(ЭтотОбъект);
	
	ПересчитатьЗадолженностьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииДолжностиНаСервере()
	
	СвойстваДолжности = СвойстваДолжности(Объект.Должность);
	КатегорияДолжностиГосударственнойСлужбы = СвойстваДолжности.КатегорияДолжностиГосударственнойСлужбы;
	ГруппаДолжностиГосударственнойСлужбы = СвойстваДолжности.ГруппаДолжностиГосударственнойСлужбы;
	
	ПеречитатьНормативыПроезда();
	
	ПеречитатьНормативыПроживания();
	
	ОбновитьТаблицуСуточные();
	
	ОбновитьТаблицуФинансовоеОбеспечение();
	
	ОбновитьТаблицыСпособыВыдачиИКурсыВалют(ЭтотОбъект);
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
	ОбновитьИтогиПоСпособамОбеспечения(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииОсобогоСтатусаНаСервере()
	
	ПеречитатьНормативыСуточных();
	
	ПеречитатьНормативыПроезда();
	
	ПеречитатьНормативыПроживания();
	
	ОбновитьТаблицуСуточные();
	
	ОбновитьТаблицуФинансовоеОбеспечение();
	
	ОбновитьТаблицыСпособыВыдачиИКурсыВалют(ЭтотОбъект);
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
	ОбновитьИтогиПоСпособамОбеспечения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьДлительностьИФактическуюСтоимостьПроживания(ТекущаяСтрока)
	
	Если ТекущаяСтрока = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(ТекущаяСтрока.ДатаЗаезда)
		ИЛИ НЕ ЗначениеЗаполнено(ТекущаяСтрока.ДатаВыезда)
		ИЛИ ТекущаяСтрока.ДатаЗаезда > ТекущаяСтрока.ДатаВыезда Тогда
		ТекущаяСтрока.КоличествоДней = 0;
	ИначеЕсли ТекущаяСтрока.ДатаЗаезда = ТекущаяСтрока.ДатаВыезда Тогда
		ТекущаяСтрока.КоличествоДней = 1;
	Иначе
		ТекущаяСтрока.КоличествоДней = (ТекущаяСтрока.ДатаВыезда - ТекущаяСтрока.ДатаЗаезда)/86400;
	КонецЕсли;
	
	Если ТекущаяСтрока.КоличествоДней > 0 Тогда
		ТекущаяСтрока.СуммаФактическая = ТекущаяСтрока.Сумма / ТекущаяСтрока.КоличествоДней;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуСуточные()
	
	Если Объект.РучноеРедактированиеСуточных Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.МестоИСроки.Количество() > 0 Тогда
		ОбновитьТаблицуСуточныеНаСервере();
	Иначе
		Объект.Суточные.Очистить();
	КонецЕсли;
	
	// Удаление строк нормативов, для которых нет соответствия в местах и сроках,
	УдалитьНеиспользуемыеНормативыСуточных();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуСуточныеНаСервере()
	
	СтранаРоссия = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
	
	ТекущаяТаблицаСуточных = Объект.Суточные.Выгрузить();
	
	Объект.Суточные.Очистить();
	
	Страны         = Новый Массив;
	Нормативы      = Новый Соответствие;
	СтраныИПериоды = Новый Соответствие;
	
	НормативыСДопУсловиями = Объект.МестоИСроки.Выгрузить(, "Страна, Территория, ДополнительноеУсловие, Норматив, Валюта");
	НормативыСДопУсловиями.Колонки.Добавить("КоличествоДней",                      ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(3));
	НормативыСДопУсловиями.Колонки.Добавить("КФО",                                 Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	НормативыСДопУсловиями.Колонки.Добавить("ОплачиваютсяОднодневныеКомандировки", Новый ОписаниеТипов("Булево"));  
	НормативыСДопУсловиями.Колонки.Добавить("ВидДоговора",                         Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровССотрудниками"));
	НормативыСДопУсловиями.Очистить();
	
	// крайние даты командировки в целом
	ДатаНачалаКомандировки = Дата(3999,1,1);
	ДатаОкончанияКомандировки = Дата(1,1,1);
	
	// Для расчета суточных требуется определить крайние даты в таблице МестоИСроки в разрезе стран
	// для расчета длительности нахождения в командировке. Список стран и нормативы получим из таблицы МестоИСроки.
	// Если страна не заполнена, считаем, что это - Россия
	Для Каждого Строка Из Объект.МестоИСроки Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(Строка.ДатаОкончания) Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаНачалаКомандировки    = Мин(ДатаНачалаКомандировки, Строка.ДатаНачала);
		ДатаОкончанияКомандировки = Макс(ДатаОкончанияКомандировки, Строка.ДатаОкончания);
		
		Страна = ?(ЗначениеЗаполнено(Строка.Страна), Строка.Страна, СтранаРоссия);
		Страны.Добавить(Страна);
		
		Периоды = СтраныИПериоды.Получить(Страна);
		Если Периоды = Неопределено Тогда
			Даты = Новый Структура("ДатыНачал, ДатыОкончаний", Новый Массив, Новый Массив);
			СтраныИПериоды.Вставить(Страна, Даты);
		КонецЕсли;
		СтраныИПериоды[Страна].ДатыНачал.Добавить(Строка.ДатаНачала);
		СтраныИПериоды[Страна].ДатыОкончаний.Добавить(Строка.ДатаОкончания);
		
		// Сохранение базового норматива по стране (без доп. условий и территории)
		Если (НЕ ЗначениеЗаполнено(Строка.ДополнительноеУсловие)
				И НЕ ЗначениеЗаполнено(Строка.Территория))
			ИЛИ Нормативы.Получить(Страна) = Неопределено Тогда
			
			ТаблицаНормативов = Новый ТаблицаЗначений;
			ТаблицаНормативов.Колонки.Добавить("Территория",                          Новый ОписаниеТипов("СправочникСсылка.ТерриторииСОтдельнымиНормативами"));
			ТаблицаНормативов.Колонки.Добавить("ДополнительноеУсловие",               Новый ОписаниеТипов("СправочникСсылка.ДополнительныеУсловияКомандирования"));
			ТаблицаНормативов.Колонки.Добавить("КФО",                                 Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
			ТаблицаНормативов.Колонки.Добавить("Норматив",                            ОбщегоНазначения.ОписаниеТипаЧисло(15, 2, ДопустимыйЗнак.Неотрицательный));
			ТаблицаНормативов.Колонки.Добавить("Валюта",                              Новый ОписаниеТипов("СправочникСсылка.Валюты"));
			ТаблицаНормативов.Колонки.Добавить("ОплачиваютсяОднодневныеКомандировки", Новый ОписаниеТипов("Булево"));      
		    ТаблицаНормативов.Колонки.Добавить("ВидДоговора",                         Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровССотрудниками"));	
			
			НайденНормативСуточныхВТаблице = Ложь;
			Для Каждого СтрокаНорматив Из Объект.НормативыСуточных Цикл
				Если СтрокаНорматив.Страна = Страна
					И СтрокаНорматив.Территория = Строка.Территория
					И СтрокаНорматив.ДополнительноеУсловие = Строка.ДополнительноеУсловие Тогда
					ЗаполнитьЗначенияСвойств(ТаблицаНормативов.Добавить(), СтрокаНорматив);
					НайденНормативСуточныхВТаблице = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ НайденНормативСуточныхВТаблице Тогда  
				НоваяСтрока                                     = ТаблицаНормативов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);  
				НоваяСтрока.ОплачиваютсяОднодневныеКомандировки = ?(Строка.ДатаНачала = Строка.ДатаОкончания И ЗначениеЗаполнено(Строка.Норматив), Истина, Ложь);
				НоваяСтрока.ВидДоговора                         = ВидДоговора;
			КонецЕсли;
			
			Нормативы.Вставить(Страна, ТаблицаНормативов);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.ДополнительноеУсловие) ИЛИ ЗначениеЗаполнено(Строка.Территория) Тогда
			
			НайденНормативСуточныхВТаблице = Ложь;
			Для Каждого СтрокаНорматив Из Объект.НормативыСуточных Цикл
				Если СтрокаНорматив.Страна = Страна
					И СтрокаНорматив.Территория = Строка.Территория
					И СтрокаНорматив.ДополнительноеУсловие = Строка.ДополнительноеУсловие Тогда
					НоваяСтрока = НормативыСДопУсловиями.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНорматив);
					НоваяСтрока.КоличествоДней = (Строка.ДатаОкончания - Строка.ДатаНачала)/86400 + 1;
					НайденНормативСуточныхВТаблице = Истина;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ НайденНормативСуточныхВТаблице Тогда
				НоваяСтрока                = НормативыСДопУсловиями.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				НоваяСтрока.Страна         = Страна;
				НоваяСтрока.КоличествоДней = (Строка.ДатаОкончания - Строка.ДатаНачала)/86400 + 1;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	НормативыСДопУсловиями.Свернуть("Страна, Территория, ДополнительноеУсловие, Норматив, Валюта, КФО, ОплачиваютсяОднодневныеКомандировки", "КоличествоДней");
	
	// Для загранкомандировок надо добавить Россию в список стран принудительно для расчета суточных
	Если Страны.Найти(СтранаРоссия) = Неопределено
			ИЛИ Нормативы.Получить(СтранаРоссия) = Неопределено Тогда
		
		Страны.Добавить(СтранаРоссия);
		
		Отбор = Новый Структура;
		Отбор.Вставить("Период",                ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата));
		Отбор.Вставить("Организация",           Объект.Организация);
		Отбор.Вставить("ВидДоговора",           ВидДоговора);
		Отбор.Вставить("Страна",                СтранаРоссия);
		Отбор.Вставить("Территория",            Неопределено);
		Отбор.Вставить("ОсобыйСтатус",          Объект.ОсобыйСтатус);
		Отбор.Вставить("ДополнительноеУсловие", Неопределено);
		
		НормативыСуточных = СуточныеПоНормативу(Отбор);
		
		Если НормативыСуточных.Сумма = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Для страны Россия не задан норматив суточных (без указания территории), суточные не будут рассчитаны'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
		ТаблицаНормативов = Новый ТаблицаЗначений;
		ТаблицаНормативов.Колонки.Добавить("Территория", Новый ОписаниеТипов("СправочникСсылка.ТерриторииСОтдельнымиНормативами"));
		ТаблицаНормативов.Колонки.Добавить("ДополнительноеУсловие", Новый ОписаниеТипов("СправочникСсылка.ДополнительныеУсловияКомандирования"));
		ТаблицаНормативов.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ТаблицаНормативов.Колонки.Добавить("Норматив", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2, ДопустимыйЗнак.Неотрицательный));
		ТаблицаНормативов.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
		ТаблицаНормативов.Колонки.Добавить("ОплачиваютсяОднодневныеКомандировки", Новый ОписаниеТипов("Булево"));
		
		Для Каждого СтрокаНорматив Из НормативыСуточных Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаНормативов.Добавить(), СтрокаНорматив);
		КонецЦикла;
		
		Нормативы.Вставить(СтранаРоссия, ТаблицаНормативов);
		
	КонецЕсли;
	
	Страны = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Страны);
	
	СтраныИДлительность = Новый Соответствие;
	
	ДниИСтраны = Новый Соответствие;
	
	СтраныСНормативом50Процентов = Новый Соответствие;
	
	Для Каждого Страна Из Страны Цикл
		
		МассивДатНачалРасчетаСуточных = Новый Массив;
		МассивДатОкончанийРасчетаСуточных = Новый Массив;
		ДатаНачалаПребывания = Дата(2999,12,31);
		ДатаОкончанияПребывания = Дата(2999,12,31);
		
		Если СтраныИПериоды.Получить(Страна) <> Неопределено Тогда
			Для Каждого ДатаНачала Из СтраныИПериоды[Страна].ДатыНачал Цикл
				МассивДатНачалРасчетаСуточных.Добавить(ДатаНачала);
			КонецЦикла;
			Для Каждого ДатаОкончания Из СтраныИПериоды[Страна].ДатыОкончаний Цикл
				МассивДатОкончанийРасчетаСуточных.Добавить(ДатаОкончания);
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого Строка Из Объект.УсловияПроезда Цикл
			СтранаОтправления = ?(ЗначениеЗаполнено(Строка.СтранаОтправления), Строка.СтранаОтправления, СтранаРоссия);
			СтранаПрибытия = ?(ЗначениеЗаполнено(Строка.СтранаПрибытия), Строка.СтранаПрибытия, СтранаРоссия);
			Если СтранаОтправления = Страна И СтранаПрибытия = Страна Тогда
				
			ИначеЕсли СтранаОтправления = Страна Тогда
				// День пересечения границы учитывается по нормативу страны прибытия
				Если ЗначениеЗаполнено(Строка.ДатаПересеченияГраницы) Тогда
					МассивДатОкончанийРасчетаСуточных.Добавить(Строка.ДатаПересеченияГраницы - 86400);
					ДатаОкончанияПребывания = Мин(ДатаОкончанияПребывания, Строка.ДатаПересеченияГраницы - 86400)
				КонецЕсли;
				// Если день вылета равен дню пересечения границы, то этот день следует исключить из расчета суточных страны вылета
				Если МассивДатОкончанийРасчетаСуточных[0] = Строка.ДатаПересеченияГраницы
					И МассивДатОкончанийРасчетаСуточных[0] = Строка.ДатаОтправления Тогда
					МассивДатОкончанийРасчетаСуточных.Удалить(0);
				КонецЕсли;
			ИначеЕсли СтранаПрибытия = Страна Тогда
				// День пересечения границы учитывается по нормативу страны прибытия
				Если ЗначениеЗаполнено(Строка.ДатаПересеченияГраницы) Тогда
					МассивДатНачалРасчетаСуточных.Добавить(Строка.ДатаПересеченияГраницы);
					ДатаНачалаПребывания = Мин(ДатаНачалаПребывания, Строка.ДатаПересеченияГраницы)
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЦикла;
		
		// Когда дата начала командировки совпадает с датой окончания командировки и это не Россия, то этот день оплачивается как загран
		Если ДатаНачалаПребывания = ДатаОкончанияПребывания + 86400
			И Страна <> СтранаРоссия
			И Страны.Количество() = 2 Тогда
			МассивДатОкончанийРасчетаСуточных.Добавить(ДатаОкончанияПребывания + 86400);
			СтраныСНормативом50Процентов.Вставить(Страна, Истина);
		КонецЕсли;
		
		Список = Новый СписокЗначений;
		Список.ЗагрузитьЗначения(МассивДатНачалРасчетаСуточных);
		Список.СортироватьПоЗначению();
		МассивДатНачалРасчетаСуточных = Список.ВыгрузитьЗначения();
		
		Список = Новый СписокЗначений;
		Список.ЗагрузитьЗначения(МассивДатОкончанийРасчетаСуточных);
		Список.СортироватьПоЗначению();
		МассивДатОкончанийРасчетаСуточных = Список.ВыгрузитьЗначения();
		
		ДниПребыванияВСтране = Новый Соответствие;
		
		ДатаОкончания = Дата(1,1,1);
		ИндексДатыОкончания = 0;
		
		Для ИндексДатыНачала = 0 По МассивДатНачалРасчетаСуточных.ВГраница() Цикл
			ДатаНачала = МассивДатНачалРасчетаСуточных[ИндексДатыНачала];
			Если ДатаНачала < ДатаОкончания Тогда
				Продолжить;
			КонецЕсли;
			ДатаОкончания = Дата(1,1,1);
			Пока ИндексДатыОкончания <= МассивДатОкончанийРасчетаСуточных.ВГраница() Цикл
				Если МассивДатОкончанийРасчетаСуточных[ИндексДатыОкончания] >= ДатаНачала Тогда
					ДатаОкончания = МассивДатОкончанийРасчетаСуточных[ИндексДатыОкончания];
					ИндексДатыОкончания = ИндексДатыОкончания + 1;
					Прервать;
				КонецЕсли;
				ИндексДатыОкончания = ИндексДатыОкончания + 1;
			КонецЦикла;
			Если ДатаНачала = Дата(1,1,1) ИЛИ ДатаОкончания = Дата(1,1,1) Тогда
				Прервать;
			КонецЕсли;
			ДеньПребывания = ДатаНачала;
			Пока ДеньПребывания <= ДатаОкончания Цикл
				Если ДниПребыванияВСтране[ДеньПребывания] = Неопределено Тогда
					ДниПребыванияВСтране.Вставить(ДеньПребывания, Истина);
					Если ДниИСтраны[ДеньПребывания] = Неопределено Тогда
						ДниИСтраны.Вставить(ДеньПребывания,
							ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Страна));
					Иначе
						ТекущиеСтраны = ДниИСтраны[ДеньПребывания];
						ТекущиеСтраны.Добавить(Страна);
						ДниИСтраны.Вставить(ДеньПребывания, ТекущиеСтраны);
					КонецЕсли;
				КонецЕсли;
				ДеньПребывания = ДеньПребывания + 86400;
			КонецЦикла;
		КонецЦикла;
		
		Если ИндексДатыОкончания <= МассивДатОкончанийРасчетаСуточных.ВГраница() И ДниПребыванияВСтране.Количество() > 0 Тогда
			ДатаОкончания = МассивДатОкончанийРасчетаСуточных[МассивДатОкончанийРасчетаСуточных.ВГраница()];
			Пока ДеньПребывания <= ДатаОкончания Цикл
				Если ДниПребыванияВСтране[ДеньПребывания] = Неопределено Тогда
					ДниПребыванияВСтране.Вставить(ДеньПребывания, Истина);
					Если ДниИСтраны[ДеньПребывания] = Неопределено Тогда
						ДниИСтраны.Вставить(ДеньПребывания,
							ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Страна));
					Иначе
						ТекущиеСтраны = ДниИСтраны[ДеньПребывания];
						ТекущиеСтраны.Добавить(Страна);
						ДниИСтраны.Вставить(ДеньПребывания, ТекущиеСтраны);
					КонецЕсли;
				КонецЕсли;
				ДеньПребывания = ДеньПребывания + 86400;
			КонецЦикла;
		КонецЕсли;
		
		КоличествоДней = ДниПребыванияВСтране.Количество();
		
		СтраныИДлительность.Вставить(Страна, КоличествоДней);
		
	КонецЦикла;
	
	// Если один из дней пребывания встречается в нескольких странах, то при однодневных командировках заграницу
	// приоритет имеет иностранное государство
	Для Каждого ДеньИСтраны Из ДниИСтраны Цикл
		Если ДеньИСтраны.Значение.Количество() = 1 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Страна Из ДеньИСтраны.Значение Цикл
			Если Страна = СтранаРоссия Тогда
				СтраныИДлительность.Вставить(Страна, СтраныИДлительность[Страна] - 1);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого СтранаДлительность Из СтраныИДлительность Цикл
		
		КоличествоДнейБезУсловий = СтранаДлительность.Значение;
		
		НормативыПоСтране = Нормативы.Получить(СтранаДлительность.Ключ);
		
		Для Каждого НормативПоСтране Из НормативыПоСтране Цикл
			
			Если НормативПоСтране.Норматив = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			// При однодневных командировках по России суточные не выплачиваются
			Если НЕ Объект.КомандировкаЗаГраницу
				И СтранаДлительность.Ключ = СтранаРоссия
				И СтранаДлительность.Значение = 1
				И НЕ НормативПоСтране.ОплачиваютсяОднодневныеКомандировки Тогда
				Продолжить;
			КонецЕсли;
			
			// При однодневных командировках заграницу суточные выплачиваются в размере 50%
			Если Объект.КомандировкаЗаГраницу И СтранаДлительность.Ключ <> СтранаРоссия И СтранаДлительность.Значение = 1
				И СтраныИДлительность.Количество() = 2 И СтраныСНормативом50Процентов[СтранаДлительность.Ключ] <> Неопределено Тогда
				НормативПоСтране.Норматив = НормативПоСтране.Норматив / 2;
			КонецЕсли;
			
			// Необходимо узнать, сколько дней в этой стране действовали дополнительные условия / особые территории
			// Дни со специальными условиями / территориями вытесняют базовые нормативы, то есть имеют больший приоритет
			Если НЕ ЗначениеЗаполнено(НормативПоСтране.ДополнительноеУсловие)
				ИЛИ НЕ ЗначениеЗаполнено(НормативПоСтране.Территория) Тогда
				
				НормативыСДопУсловием = НормативыСДопУсловиями.НайтиСтроки(Новый Структура("Страна", СтранаДлительность.Ключ));
				
				// необходимо исключить многократное уменьшение дней, если есть несколько нормативов доп. условий, отличающихся только КФО
				ВстречающиесяКлючи = Новый ТаблицаЗначений;
				ВстречающиесяКлючи.Колонки.Добавить("Территория", Новый ОписаниеТипов("СправочникСсылка.ТерриторииСОтдельнымиНормативами"));
				ВстречающиесяКлючи.Колонки.Добавить("ДополнительноеУсловие", Новый ОписаниеТипов("СправочникСсылка.ДополнительныеУсловияКомандирования"));
				
				Для Каждого НормативСДопУсловием Из НормативыСДопУсловием Цикл
					
					Отбор = Новый Структура;
					Отбор.Вставить("Территория", НормативСДопУсловием.Территория);
					Отбор.Вставить("ДополнительноеУсловие", НормативСДопУсловием.ДополнительноеУсловие);
					
					Если ВстречающиесяКлючи.НайтиСтроки(Отбор).Количество() = 0 Тогда
						
						ЗаполнитьЗначенияСвойств(ВстречающиесяКлючи.Добавить(), Отбор);
						
						КоличествоДнейБезУсловий = КоличествоДнейБезУсловий - НормативСДопУсловием.КоличествоДней;
						
					КонецЕсли;
					
					Если НормативСДопУсловием.Норматив = 0 Тогда
						Продолжить;
					КонецЕсли;
					
					НоваяСтрока = Объект.Суточные.Добавить();
					
					Если ЗначениеЗаполнено(НормативСДопУсловием.КФО) Тогда
						ПараметрыОтбора = Новый Структура;
						ПараметрыОтбора.Вставить("Страна", СтранаДлительность.Ключ);
						ПараметрыОтбора.Вставить("КФО",    НормативСДопУсловием.КФО);
						ИмеющиесяСтроки = ТекущаяТаблицаСуточных.НайтиСтроки(ПараметрыОтбора);
						Если ИмеющиесяСтроки.Количество() = 0 Тогда
							НоваяСтрока.Страна = СтранаДлительность.Ключ;
							НоваяСтрока.КФО = НормативСДопУсловием.КФО;
						Иначе
							ЗаполнитьЗначенияСвойств(НоваяСтрока, ИмеющиесяСтроки[0]);
						КонецЕсли;
					Иначе
						ИмеющаясяСтрока = ТекущаяТаблицаСуточных.Найти(СтранаДлительность.Ключ, "Страна");
						Если ИмеющаясяСтрока = Неопределено Тогда
							НоваяСтрока.Страна = СтранаДлительность.Ключ;
						Иначе
							ЗаполнитьЗначенияСвойств(НоваяСтрока, ИмеющаясяСтрока);
						КонецЕсли;
					КонецЕсли;
					
					НоваяСтрока.КоличествоДней        = НормативСДопУсловием.КоличествоДней;
					НоваяСтрока.Сумма                 = НормативСДопУсловием.Норматив * НоваяСтрока.КоличествоДней;
					НоваяСтрока.Валюта                = НормативСДопУсловием.Валюта;
					НоваяСтрока.Норматив              = НормативСДопУсловием.Норматив;
					НоваяСтрока.ДополнительноеУсловие = НормативСДопУсловием.ДополнительноеУсловие;
					НоваяСтрока.Территория            = НормативСДопУсловием.Территория;
					
					Если НЕ ЗначениеЗаполнено(НоваяСтрока.СпособОбеспечения) Тогда
						НоваяСтрока.СпособОбеспечения = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу");
					КонецЕсли;
					
					ЗаполнитьНаименованиеРасходаСуточные(НоваяСтрока);
					
					// обнуление количества дней в строке таблицы НормативыСДопУсловием для исключения повторного учета
					НормативСДопУсловием.КоличествоДней = 0;
					НормативСДопУсловием.Норматив = 0
					
				КонецЦикла;
			КонецЕсли;
			
			Если КоличествоДнейБезУсловий <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Объект.Суточные.Добавить();
			
			Если ЗначениеЗаполнено(НормативПоСтране.КФО) Тогда
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Страна", СтранаДлительность.Ключ);
				ПараметрыОтбора.Вставить("КФО", НормативПоСтране.КФО);
				ИмеющиесяСтроки = ТекущаяТаблицаСуточных.НайтиСтроки(ПараметрыОтбора);
				Если ИмеющиесяСтроки.Количество() = 0 Тогда
					НоваяСтрока.Страна = СтранаДлительность.Ключ;
					НоваяСтрока.КФО = НормативПоСтране.КФО;
				Иначе
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ИмеющиесяСтроки[0]);
				КонецЕсли;
			Иначе
				ИмеющаясяСтрока = ТекущаяТаблицаСуточных.Найти(СтранаДлительность.Ключ, "Страна");
				Если ИмеющаясяСтрока = Неопределено Тогда
					НоваяСтрока.Страна = СтранаДлительность.Ключ;
				Иначе
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ИмеющаясяСтрока);
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока.КоличествоДней        = КоличествоДнейБезУсловий;
			НоваяСтрока.Сумма                 = НормативПоСтране.Норматив * НоваяСтрока.КоличествоДней;
			НоваяСтрока.Валюта                = НормативПоСтране.Валюта;
			НоваяСтрока.Норматив              = НормативПоСтране.Норматив;
			НоваяСтрока.ДополнительноеУсловие = НормативПоСтране.ДополнительноеУсловие;
			НоваяСтрока.Территория            = НормативПоСтране.Территория;
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.СпособОбеспечения) Тогда
				НоваяСтрока.СпособОбеспечения = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу");
			КонецЕсли;
			
			ЗаполнитьНаименованиеРасходаСуточные(НоваяСтрока);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Суточные = Объект.Суточные.Выгрузить();
	Суточные.Свернуть("ИдентификаторСтроки, Норматив, Страна, Территория, ДополнительноеУсловие, СпособОбеспечения,
		|Валюта, КФО, КПС, КЭК, НаименованиеРасхода, КодЦели, КодМероприятия, ДопКлассификация",
		"КоличествоДней, Сумма");
	Объект.Суточные.Загрузить(Суточные);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуФинансовоеОбеспечение()
	
	ЭтоИзменение = ЗначениеЗаполнено(Объект.ДокументОснование);
	
	ТекущаяТаблицаФО = Объект.ФинансовоеОбеспечение.Выгрузить();
	
	НоваяТаблицаФО = ТекущаяТаблицаФО.Скопировать();
	НоваяТаблицаФО.Очистить();
	
	Объект.ФинансовоеОбеспечение.Очистить();
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("УсловияПроезда");
	МассивТЧ.Добавить("УсловияПроживания");
	МассивТЧ.Добавить("Суточные");
	МассивТЧ.Добавить("ПрочиеРасходы");
	
	Для Каждого ТЧ Из МассивТЧ Цикл
		Для Каждого СтрокаТЧ Из Объект[ТЧ] Цикл
			Если СтрокаТЧ.СпособОбеспечения <> ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу")
				И СтрокаТЧ.СпособОбеспечения <> ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.ВозмещениеПоФакту") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрокаФО = НоваяТаблицаФО.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаФО, СтрокаТЧ);
			НоваяСтрокаФО.Сумма = Документы.РешениеОКомандировании.СуммаВРублевомЭквиваленте(СтрокаТЧ.Сумма, СтрокаТЧ.Валюта, Объект.КурсыВалют);
			Если СтрокаТЧ.СпособОбеспечения = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу") Тогда
				НоваяСтрокаФО.СуммаАванса = НоваяСтрокаФО.Сумма;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	НоваяТаблицаФО.Свернуть("КФО, КПС, КЭК, КодЦели, КодМероприятия, ДопКлассификация", "Сумма, СуммаАванса");
	
	Для Каждого СтрокаФО Из НоваяТаблицаФО Цикл
		
		НоваяСтрока = Объект.ФинансовоеОбеспечение.Добавить();
		
		Отбор = Новый Структура("КФО, КПС, КЭК, КодЦели, КодМероприятия, ДопКлассификация",
			СтрокаФО.КФО, СтрокаФО.КПС, СтрокаФО.КЭК, СтрокаФО.КодЦели, СтрокаФО.КодМероприятия, СтрокаФО.ДопКлассификация);
		ИмеющиесяСтроки = ТекущаяТаблицаФО.НайтиСтроки(Отбор);
		Если ИмеющиесяСтроки.Количество() = 1 Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ИмеющиесяСтроки[0]);
			ИсходнаяСумма = ИмеющиесяСтроки[0].Сумма - ИмеющиесяСтроки[0].Изменение;
			ИсходнаяСуммаАванса = ИмеющиесяСтроки[0].СуммаАванса - ИмеющиесяСтроки[0].ИзменениеАванса;
			ТекущаяТаблицаФО.Удалить(ИмеющиесяСтроки[0]);
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаФО);
			НоваяСтрока.ФинансовыйГод = Год(Объект.Дата);
			ИсходнаяСумма = 0;
			ИсходнаяСуммаАванса = 0;
		КонецЕсли;
		
		НоваяСтрока.Сумма = СтрокаФО.Сумма;
		НоваяСтрока.Изменение = ?(ЭтоИзменение, СтрокаФО.Сумма - ИсходнаяСумма, 0);
		НоваяСтрока.СуммаАванса = СтрокаФО.СуммаАванса;
		НоваяСтрока.ИзменениеАванса = ?(ЭтоИзменение, СтрокаФО.СуммаАванса - ИсходнаяСуммаАванса, 0);
		
	КонецЦикла;
	
	// Если в исходной таблице остались строки, то значит, этой классификации больше нет - всю сумму записывем в изменение
	Если ЭтоИзменение Тогда
		Для Каждого СтрокаФО Из ТекущаяТаблицаФО Цикл
			Если СтрокаФО.Сумма = СтрокаФО.Изменение Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = Объект.ФинансовоеОбеспечение.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаФО);
			НоваяСтрока.Сумма = 0;
			НоваяСтрока.Изменение = - СтрокаФО.Сумма + СтрокаФО.Изменение;
			НоваяСтрока.СуммаАванса = 0;
			НоваяСтрока.ИзменениеАванса = - СтрокаФО.СуммаАванса + СтрокаФО.ИзменениеАванса;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТаблицыСпособыВыдачиИКурсыВалют(Форма)
	
	// Если появилась (исчезла) новая валюта, необходимо ее добавить (удалить) в ТЧ "Способы выдачи" и "Курсы валют"
	МассивВалют = Новый Массив;
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("УсловияПроезда");
	МассивТЧ.Добавить("УсловияПроживания");
	МассивТЧ.Добавить("Суточные");
	МассивТЧ.Добавить("ПрочиеРасходы");
	
	Для Каждого ТЧ Из МассивТЧ Цикл
		Для Каждого СтрокаТЧ Из Форма.Объект[ТЧ] Цикл
			Валюта = ?(ЗначениеЗаполнено(СтрокаТЧ.Валюта), СтрокаТЧ.Валюта, ОбщегоНазначенияБГУВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета());
			МассивВалют.Добавить(Валюта);
		КонецЦикла
	КонецЦикла;
	
	МассивВалют = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивВалют);
	
	Для Каждого Валюта Из МассивВалют Цикл
		
		ВалютаНайдена = Ложь;
		Для Каждого СтрокаСпособВыдачи Из Форма.Объект.СпособыВыдачи Цикл
			Если СтрокаСпособВыдачи.Валюта = Валюта Тогда
				ВалютаНайдена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ВалютаНайдена Тогда
			Строка = Форма.Объект.СпособыВыдачи.Добавить();
			Строка.Валюта = Валюта;
			Строка.СпособВыдачи = Форма.СпособВыдачиДенежныхСредств;
		КонецЕсли;
		
		//// В таблицу "Курсы валют" не нужно добавлять валюту рег. учета
		//Если Валюта = ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета() Тогда
		//	Продолжить;
		//КонецЕсли;
		
		ВалютаНайдена = Ложь;
		Для Каждого СтрокаКурсыВалют Из Форма.Объект.КурсыВалют Цикл
			Если СтрокаКурсыВалют.Валюта = Валюта Тогда
				ВалютаНайдена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ВалютаНайдена Тогда
			Строка = Форма.Объект.КурсыВалют.Добавить();
			Строка.Валюта = Валюта;
			КурсКратность = ПолучитьКурс(Строка.Валюта, Форма.Объект.ДатаУтверждения);
			Строка.Курс = КурсКратность.Курс;
			Строка.Кратность = КурсКратность.Кратность;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Строка Из Форма.Объект.СпособыВыдачи Цикл
		Если МассивВалют.Найти(Строка.Валюта) = Неопределено Тогда
			Форма.Объект.СпособыВыдачи.Удалить(Форма.Объект.СпособыВыдачи.Индекс(Строка));
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из Форма.Объект.КурсыВалют Цикл
		Если МассивВалют.Найти(Строка.Валюта) = Неопределено Тогда
			Форма.Объект.КурсыВалют.Удалить(Форма.Объект.КурсыВалют.Индекс(Строка));
		КонецЕсли;
	КонецЦикла;
	
	УстановитьВидимостьРеквизитовСпособВыдачиДС(Форма);
	УстановитьПредставлениеСтрокиСпособВыдачиДС(Форма);
	
	УстановитьВидимостьСтрокиКурсыВалют(Форма);
	УстановитьПредставлениеСтрокиКурсыВалют(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТаблицуКлассификацияРасходов(Форма)
	
	Форма.КлассификацияРасходов.Очистить();
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("Суточные");
	МассивТЧ.Добавить("УсловияПроезда");
	МассивТЧ.Добавить("УсловияПроживания");
	МассивТЧ.Добавить("ПрочиеРасходы");
	
	НомерСтроки = 1;
	Для Каждого ТЧ Из МассивТЧ Цикл
		Для Каждого СтрокаТЧ Из Форма.Объект[ТЧ] Цикл
			Если СтрокаТЧ.СпособОбеспечения <> ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу")
				И СтрокаТЧ.СпособОбеспечения <> ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.ВозмещениеПоФакту") Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТЧ.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			НоваяСтрока = Форма.КлассификацияРасходов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			НоваяСтрока.НомерСтроки = НомерСтроки;
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтогиПоСпособамОбеспечения(Форма)
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("Суточные");
	МассивТЧ.Добавить("УсловияПроезда");
	МассивТЧ.Добавить("УсловияПроживания");
	МассивТЧ.Добавить("ПрочиеРасходы");
	
	Аванс = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.АвансПодотчетномуЛицу");
	ДенежныеДокументы = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.ВыдачаДенежныхДокументов");
	Возмещение = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.ВозмещениеПоФакту");
	Закупка = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.Закупка");
	ЗаСчетПринимающейСтороны = ПредопределенноеЗначение("Перечисление.СпособыОбеспеченияКомандировки.ЗаСчетПринимающейСтороны");
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить(Аванс, 0);
	Соответствие.Вставить(ДенежныеДокументы, 0);
	Соответствие.Вставить(Возмещение, 0);
	Соответствие.Вставить(Закупка, 0);
	Соответствие.Вставить(ЗаСчетПринимающейСтороны, 0);
	
	НомерСтроки = 1;
	Для Каждого ТЧ Из МассивТЧ Цикл
		Для Каждого СтрокаТЧ Из Форма.Объект[ТЧ] Цикл
			Если Соответствие[СтрокаТЧ.СпособОбеспечения] <> Неопределено Тогда
				Соответствие[СтрокаТЧ.СпособОбеспечения] = Соответствие[СтрокаТЧ.СпособОбеспечения] + СтрокаТЧ.Сумма;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Форма.ИтогоАванс = Соответствие[Аванс] + Соответствие[Возмещение];
	Форма.ИтогоДенежныеДокументы = Соответствие[ДенежныеДокументы];
	Форма.ИтогоЗакупка = Соответствие[Закупка];
	Форма.ИтогоЗаСчетПринимающейСтороны = Соответствие[ЗаСчетПринимающейСтороны];
	Форма.Итого = Форма.ИтогоАванс + Форма.ИтогоДенежныеДокументы + Форма.ИтогоЗакупка + Форма.ИтогоЗаСчетПринимающейСтороны;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолноеНаименованиеЮридическогоЛица(ЮрЛицо)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЮрЛицо, "НаименованиеПолное");
КонецФункции

&НаСервере
Процедура УдалитьНеиспользуемыеНормативыСуточных()
	
	ПоследнийИндекс = Объект.НормативыСуточных.Количество() - 1;
	Для Индекс = 0 По ПоследнийИндекс Цикл
		ОбратныйИндекс = ПоследнийИндекс - Индекс;
		СтрокаНорматив = Объект.НормативыСуточных[ОбратныйИндекс];
		ПараметрыОтбора = Новый Структура;
		Если Объект.КомандировкаЗаГраницу Тогда
			ПараметрыОтбора.Вставить("Страна", СтрокаНорматив.Страна);
		КонецЕсли;
		ПараметрыОтбора.Вставить("Территория", СтрокаНорматив.Территория);
		ПараметрыОтбора.Вставить("ДополнительноеУсловие", СтрокаНорматив.ДополнительноеУсловие);
		НайденныеСтроки = Объект.МестоИСроки.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Объект.НормативыСуточных.Удалить(ОбратныйИндекс);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

