&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьНаименованиеРасходаСуточные(ТекущаяСтрока)
	Если ТекущаяСтрока.Страна <> ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда
		ТекущаяСтрока.НаименованиеРасхода = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Суточные по командировкам на территории иностранного государства (%1)'"),
			ТекущаяСтрока.Страна)
	Иначе
		ТекущаяСтрока.НаименованиеРасхода = НСтр("ru = 'Суточные по командировкам на территории Российской Федерации'");
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьНаименованиеРасходаПроезд(ТекущаяСтрока)
	ТекущаяСтрока.НаименованиеРасхода =
		НСтр("ru = 'Расходы по проезду: '")
		+ НРег(Строка(ТекущаяСтрока.ВидТранспорта))
		+ НСтр("ru = ' транспорт, '")
		+ ТекущаяСтрока.ПунктОтправления + " - " + ТекущаяСтрока.ПунктПрибытия
		+ ?(ТекущаяСтрока.ТарифТудаОбратно, " - " + ТекущаяСтрока.ПунктОтправления, "");
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьНаименованиеРасходаПроживание(ТекущаяСтрока)
	ТекущаяСтрока.НаименованиеРасхода = НСтр("ru = 'Расходы по найму жилого помещения'");
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКурс(Знач Валюта, Дата)
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, Дата);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюКлассификацииРасходов(Элементы, Пометка)
	
	РеквизитыКлассификацииДетально = Новый Массив;
	РеквизитыКлассификацииДетально.Добавить("СуточныеКФО");
	РеквизитыКлассификацииДетально.Добавить("СуточныеКПС");
	РеквизитыКлассификацииДетально.Добавить("СуточныеКЭК");
	РеквизитыКлассификацииДетально.Добавить("СуточныеКодЦели");
	РеквизитыКлассификацииДетально.Добавить("СуточныеКодМероприятия");
	РеквизитыКлассификацииДетально.Добавить("СуточныеДопКлассификация");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроездаКФО");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроездаКПС");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроездаКЭК");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроездаКодЦели");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроездаКодМероприятия");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроездаДопКлассификация");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроживанияКФО");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроживанияКПС");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроживанияКЭК");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроживанияКодЦели");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроживанияКодМероприятия");
	РеквизитыКлассификацииДетально.Добавить("УсловияПроживанияДопКлассификация");
	РеквизитыКлассификацииДетально.Добавить("ПрочиеРасходыКФО");
	РеквизитыКлассификацииДетально.Добавить("ПрочиеРасходыКПС");
	РеквизитыКлассификацииДетально.Добавить("ПрочиеРасходыКЭК");
	РеквизитыКлассификацииДетально.Добавить("ПрочиеРасходыКодЦели");
	РеквизитыКлассификацииДетально.Добавить("ПрочиеРасходыКодМероприятия");
	РеквизитыКлассификацииДетально.Добавить("ПрочиеРасходыДопКлассификация");
	
	Для Каждого Реквизит Из РеквизитыКлассификацииДетально Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, Реквизит, "Видимость", НЕ Пометка);
	КонецЦикла;
	
	РеквизитыКлассификацииСводно = Новый Массив;
	РеквизитыКлассификацииСводно.Добавить("ГруппаКлассификацияРасходов");
	
	Для Каждого Реквизит Из РеквизитыКлассификацииСводно Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, Реквизит, "Видимость", Пометка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаличиеЛБОНаСервере()
	
	ЭтоИзменение = ЗначениеЗаполнено(Объект.ДокументОснование);
	
	ЭтоКазенноеУчреждение = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ЭтоКазенноеУчреждение;
	
	Для Каждого СтрокаФО Из Объект.ФинансовоеОбеспечение Цикл
		СтрокаФО.НаличиеЛБО = Ложь;
	КонецЦикла;
	
	// По каждому финансовому году будет выполнен отдельный запрос
	Года = Объект.ФинансовоеОбеспечение.Выгрузить().ВыгрузитьКолонку("ФинансовыйГод");
	Года = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Года);
	
	Для Каждого Год Из Года Цикл
		
		Если Не ЗначениеЗаполнено(Год) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Год < Год(Объект.Дата) Тогда
			Продолжить;
		КонецЕсли;
		
		КодСчета = Строка(Год - Год(Объект.Дата) + 1);
		Если ЭтоКазенноеУчреждение Тогда
			СчетаФинансирование = БухгалтерскийУчет.СписокСчетов("501."+КодСчета+"3");
		Иначе
			СчетаФинансирование = БухгалтерскийУчет.СписокСчетов("506."+КодСчета+"0");
		КонецЕсли;
		
		Запрос = Новый Запрос;
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЖурналПроводокЕПСБУОстатки.КЭК) КАК КоличествоКЭК,
		|	МАКСИМУМ(ЖурналПроводокЕПСБУОстатки.КЭК) КАК КЭК,
		|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт) КАК ОстатокЛБО
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&ДатаОстатков,
		|			Счет В (&СчетЛБО),
		|			,
		|			Организация = &Организация
		|				И ИФО = &ИФО
		|				И Подразделение = &Подразделение
		|				И (ВЫРАЗИТЬ(Субконто1 КАК Справочник.РазделыЛицевыхСчетов)) = &РазделЛицевогоСчета) КАК ЖурналПроводокЕПСБУОстатки
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЖурналПроводокЕПСБУОстатки.КЭК) = 1 И
		|	МАКСИМУМ(ЖурналПроводокЕПСБУОстатки.КЭК) = &КЭК000";
		
		Запрос.УстановитьПараметр("ДатаОстатков",
			?(Объект.Ссылка.Пустая(), ТекущаяДатаСеанса(), Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая)));
		Запрос.УстановитьПараметр("СчетЛБО", СчетаФинансирование);
		Запрос.УстановитьПараметр("Организация",
			?(ЗначениеЗаполнено(Объект.ОрганизацияОсуществляющаяОбеспечение), Объект.ОрганизацияОсуществляющаяОбеспечение, Объект.Организация));
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
		КонецЕсли;
		Если БухгалтерскийУчет.ВедетсяУчетПоПодразделениям(СчетаФинансирование)
			И (НЕ ЗначениеЗаполнено(Объект.ОрганизацияОсуществляющаяОбеспечение)
			ИЛИ Объект.ОрганизацияОсуществляющаяОбеспечение = Объект.Организация) Тогда
			Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение = &Подразделение", "");
		КонецЕсли;
		Запрос.УстановитьПараметр("РазделЛицевогоСчета", Объект.РазделЛицевогоСчета);
		Запрос.УстановитьПараметр("КЭК000", БухгалтерскийУчетПовтИсп.КЭКПоКоду("000"));
		
		ЛБОсДетализациейПоКЭК = Запрос.Выполнить().Пустой();
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
		|	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.ДополнительнаяБюджетнаяКлассификация)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ДополнительнаяБюджетнаяКлассификация)
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.ДополнительнаяБюджетнаяКлассификация)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ДополнительнаяБюджетнаяКлассификация)
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.ДополнительнаяБюджетнаяКлассификация)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ДополнительнаяБюджетнаяКлассификация)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДополнительнаяБюджетнаяКлассификация.ПустаяСсылка)
		|	КОНЕЦ КАК ДопКлассификация,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.ВидыЦелевыхСредств)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ВидыЦелевыхСредств)
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.ВидыЦелевыхСредств)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЦелевыхСредств)
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.ВидыЦелевыхСредств)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ВидыЦелевыхСредств)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЦелевыхСредств.ПустаяСсылка)
		|	КОНЕЦ КАК КодЦели,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.Мероприятия)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Мероприятия)
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.Мероприятия)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Мероприятия)
		|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.Мероприятия)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Мероприятия)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Мероприятия.ПустаяСсылка)
		|	КОНЕЦ КАК КодМероприятия,
		|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт КАК ОстатокЛБО
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&ДатаОстатков,
		|			Счет В (&СчетЛБО),
		|			,
		|			Организация = &Организация
		|				И ИФО = &ИФО
		|				И Подразделение = &Подразделение
		|				И (ВЫРАЗИТЬ(Субконто1 КАК Справочник.РазделыЛицевыхСчетов)) = &РазделЛицевогоСчета) КАК ЖурналПроводокЕПСБУОстатки";
		
		Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
		КонецЕсли;
		Если НЕ (БухгалтерскийУчет.ВедетсяУчетПоПодразделениям(СчетаФинансирование)
			И (НЕ ЗначениеЗаполнено(Объект.ОрганизацияОсуществляющаяОбеспечение)
			ИЛИ Объект.ОрганизацияОсуществляющаяОбеспечение = Объект.Организация)) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение = &Подразделение", "");
		КонецЕсли;
		Если НЕ ЛБОсДетализациейПоКЭК Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "
			|	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.ДополнительнаяБюджетнаяКлассификация)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ДополнительнаяБюджетнаяКлассификация)
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.ДополнительнаяБюджетнаяКлассификация)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ДополнительнаяБюджетнаяКлассификация)
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.ДополнительнаяБюджетнаяКлассификация)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ДополнительнаяБюджетнаяКлассификация)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДополнительнаяБюджетнаяКлассификация.ПустаяСсылка)
			|	КОНЕЦ КАК ДопКлассификация,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.ВидыЦелевыхСредств)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ВидыЦелевыхСредств)
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.ВидыЦелевыхСредств)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЦелевыхСредств)
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.ВидыЦелевыхСредств)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ВидыЦелевыхСредств)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЦелевыхСредств.ПустаяСсылка)
			|	КОНЕЦ КАК КодЦели,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто1) = ТИП(Справочник.Мероприятия)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Мероприятия)
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.Мероприятия)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Мероприятия)
			|		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто3) = ТИП(Справочник.Мероприятия)
			|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Мероприятия)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Мероприятия.ПустаяСсылка)
			|	КОНЕЦ КАК КодМероприятия,", "");
		КонецЕсли;
		
		Результат = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрокаФО Из Объект.ФинансовоеОбеспечение Цикл
			
			Если СтрокаФО.ФинансовыйГод <> Год Тогда
				Продолжить;
			КонецЕсли;
			
			Сумма = ?(ЭтоИзменение, СтрокаФО.Изменение, СтрокаФО.Сумма);
			
			Если ЛБОсДетализациейПоКЭК Тогда
				Отбор = Новый Структура("КФО, КПС, КЭК, КодЦели, КодМероприятия, ДопКлассификация",
					СтрокаФО.КФО, СтрокаФО.КПС, СтрокаФО.КЭК, СтрокаФО.КодЦели, СтрокаФО.КодМероприятия, СтрокаФО.ДопКлассификация);
			Иначе
				Отбор = Новый Структура("КФО, КПС", СтрокаФО.КФО, СтрокаФО.КПС);
			КонецЕсли;
			
			Строки = Результат.НайтиСтроки(Отбор);
			Если Строки.Количество() > 0 Тогда
				Если Строки[0].ОстатокЛБО >= Сумма Тогда
					СтрокаФО.НаличиеЛБО = Истина;
				КонецЕсли;
				Строки[0].ОстатокЛБО = Строки[0].ОстатокЛБО - Сумма;
			ИначеЕсли Сумма <= 0 Тогда
				СтрокаФО.НаличиеЛБО = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СвойстваДолжности(Должность)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Должность, "КатегорияДолжностиГосударственнойСлужбы, ГруппаДолжностиГосударственнойСлужбы");
	
КонецФункции

&НаСервере
Процедура ЗаполнитьИзменениеПоОснованию(ТипРешения)
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Заполнить(Объект.ДокументОснование);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	// Обнуление сумм в табличных частях при аннулирующем изменении
	Если ТипРешения = ПредопределенноеЗначение("Перечисление.ТипыРешенийОКомандировании.ИзменениеАннулирующее") Тогда
		
		МассивТЧ = Новый Массив;
		МассивТЧ.Добавить("Суточные");
		МассивТЧ.Добавить("УсловияПроезда");
		МассивТЧ.Добавить("УсловияПроживания");
		МассивТЧ.Добавить("ПрочиеРасходы");
		
		Для Каждого ТЧ Из МассивТЧ Цикл
			Для Каждого СтрокаТЧ Из Объект[ТЧ] Цикл
				СтрокаТЧ.Сумма = 0;
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	ЗаполнитьДополнительныеКолонкиТаблиц();
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
	ОбновитьТаблицуФинансовоеОбеспечение();
	
	ОбновитьТаблицыСпособыВыдачиИКурсыВалют(ЭтотОбъект);
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
	ОбновитьИтогиПоСпособамОбеспечения(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеКолонкиТаблиц()
	
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	Идентификатор = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект.ДокументОснование));
	
	УстановитьПривилегированныйРежим(Истина);
	ЗначенияДопКолонок = Справочники.ДополнительныеТабличныеЧастиДокументов.ДанныеДополнительныхТабличныхЧастей(
		Идентификатор, Объект.ДокументОснование);
	УстановитьПривилегированныйРежим(Ложь);
	
	БухгалтерскиеОперацииСервер.ЗаполнитьЗначенияДобавленныхРеквизитов(ЭтотОбъект, Объект, ЗначенияДопКолонок);
	
КонецПроцедуры

&НаКлиенте
Функция НеЗаполненРеквзитВТаблицеОбъекта(ИмяТЧ, ИмяРеквизита, ПредставлениеРеквизита)
	
	Отказ = Ложь;
	
	Для Каждого Строка Из Объект[ИмяТЧ] Цикл
		
		Если Не ЗначениеЗаполнено(Строка[ИмяРеквизита]) Тогда
			
			ИндексСтроки = Объект[ИмяТЧ].Индекс(Строка);
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'В строке %1 не заполнен %2'"),
								ИндексСтроки + 1, ПредставлениеРеквизита);
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,
														,
														"Объект."+ИмяТЧ+"["+ИндексСтроки+"]."+ИмяРеквизита,
														,
														Отказ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Отказ;
	
КонецФункции

&НаСервере
Процедура ПриИзмененииДатыУтвержденияНаСервере()
	
	Для Каждого Строка Из Объект.КурсыВалют Цикл
		
		КурсКратность = ПолучитьКурс(Строка.Валюта, Объект.ДатаУтверждения);
		Строка.Курс = КурсКратность.Курс;
		Строка.Кратность = КурсКратность.Кратность;
		
	КонецЦикла;
	
	УстановитьПредставлениеСтрокиКурсыВалют(ЭтотОбъект);
	
	ОбновитьКПССУчетомПереноса();
	
	ОбновитьТаблицуФинансовоеОбеспечение();
	
	ОбновитьТаблицуКлассификацияРасходов(ЭтотОбъект);
	
	ОбновитьИтогиПоСпособамОбеспечения(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКПССУчетомПереноса()
	
	ТабличныеЧастиСКПС = Новый Массив;
	ТабличныеЧастиСКПС.Добавить("Суточные");
	ТабличныеЧастиСКПС.Добавить("УсловияПроезда");
	ТабличныеЧастиСКПС.Добавить("УсловияПроживания");
	ТабличныеЧастиСКПС.Добавить("ПрочиеРасходы");
	ТабличныеЧастиСКПС.Добавить("ФинансовоеОбеспечение");
	
	Для Каждого ТабличнаяЧасть Из ТабличныеЧастиСКПС Цикл
		Для Каждого Строка Из Объект[ТабличнаяЧасть] Цикл
			Для Каждого СоответствиеКПС Из СоответствиеКПСПриПереносеОстатков Цикл
				Если Строка.КПС = СоответствиеКПС.СтарыйКПС
					И Объект.ДатаУтверждения >= СоответствиеКПС.ДатаЗамены Тогда
					Строка.КПС = СоответствиеКПС.НовыйКПС;
				ИначеЕсли Строка.КПС = СоответствиеКПС.НовыйКПС
					И Объект.ДатаУтверждения < СоответствиеКПС.ДатаЗамены Тогда
					Строка.КПС = СоответствиеКПС.СтарыйКПС;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСоответствиеКПСПриПереносеОстатков()
	
	СоответствиеКПСПриПереносеОстатков.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РешениеОКомандированииФинансовоеОбеспечение.КПС КАК КПС
	|ПОМЕСТИТЬ ВТ_КПС
	|ИЗ
	|	Документ.РешениеОКомандировании.ФинансовоеОбеспечение КАК РешениеОКомандированииФинансовоеОбеспечение
	|ГДЕ
	|	РешениеОКомандированииФинансовоеОбеспечение.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоответствиеКПСПриПереносеОстатков.СтарыйКПС КАК СтарыйКПС,
	|	СоответствиеКПСПриПереносеОстатков.НовыйКПС КАК НовыйКПС,
	|	СоответствиеКПСПриПереносеОстатков.ДатаЗамены КАК ДатаЗамены
	|ИЗ
	|	РегистрСведений.СоответствиеКПСПриПереносеОстатков КАК СоответствиеКПСПриПереносеОстатков
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КПС КАК ВТ_КПС
	|		ПО СоответствиеКПСПриПереносеОстатков.СтарыйКПС = ВТ_КПС.КПС
	|ГДЕ
	|	СоответствиеКПСПриПереносеОстатков.ДатаЗамены <= &ТекущаяДата";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ДокументОснование);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СоответствиеКПСПриПереносеОстатков.Добавить(), Выборка);
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьИзменениеРеквизитовСтрок(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("Суточные");
	МассивТЧ.Добавить("УсловияПроезда");
	МассивТЧ.Добавить("УсловияПроживания");
	МассивТЧ.Добавить("ПрочиеРасходы");
	
	Для Каждого Идентификатор Из Элементы.КлассификацияРасходов.ВыделенныеСтроки Цикл
		ТекущаяСтрока = КлассификацияРасходов.НайтиПоИдентификатору(Идентификатор);
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Результат);
		Для Каждого ТЧ Из МассивТЧ Цикл
			Для Каждого СтрокаТЧ Из Объект[ТЧ] Цикл
				Если СтрокаТЧ.ИдентификаторСтроки = ТекущаяСтрока.ИдентификаторСтроки Тогда
					ЗаполнитьЗначенияСвойств(СтрокаТЧ, ТекущаяСтрока);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ОбновитьТаблицуФинансовоеОбеспечение();
	
КонецПроцедуры

