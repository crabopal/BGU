			 ДопСтрока.СтранаПрибытия         = СтрокаПроезд.СтранаОтправления;  
			 ДопСтрока.ДатаПрибытия           = СтрокаПроезд.ДатаПрибытияОбратно;       
			 
			 ДопСтрока.ДатаПересеченияГраницы = ДопСтрока.ДатаПересеченияГраницыОбратно; 
			 
			 ДопСтрока.СуммаФактическая       = 0;
			 ДопСтрока.Сумма                  = 0;
			 
		КонецЕсли;	
	КонецЦикла;	 
	
	Запрос = Новый Запрос; 
