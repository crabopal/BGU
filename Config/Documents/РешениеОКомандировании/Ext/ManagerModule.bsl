					ОбластьЗадолженность.Параметры.Сумма = СтрокиЗадолженность.СуммаРуб;
					ТабличныйДокумент.Вывести(ОбластьЗадолженность);
				ИначеЕсли НомерОбхода = 2 И СтрокиЗадолженность.СуммаНаПроверкеРуб <> 0 Тогда
					ОбластьЗадолженность = ?(СтрокиЗадолженность.НомерСтроки = 1, ОбластьСтрокаЗадолженностьНаПроверкеПервая, ОбластьСтрокаЗадолженностьНаПроверке);
					ОбластьЗадолженность.Параметры.ВалютаКод = СтрокиЗадолженность.ВалютаКод;
					Если СтрокиЗадолженность.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
						ОбластьЗадолженность.Параметры.СуммаВал = 0;
					Иначе
						ОбластьЗадолженность.Параметры.СуммаВал = СтрокиЗадолженность.СуммаНаПроверке;
					КонецЕсли;
					ОбластьЗадолженность.Параметры.Сумма = СтрокиЗадолженность.СуммаНаПроверкеРуб;
					ТабличныйДокумент.Вывести(ОбластьЗадолженность);
				ИначеЕсли НомерОбхода = 3 И СтрокиЗадолженность.СуммаПросроченнаяРуб <> 0 Тогда
					ОбластьЗадолженность = ?(СтрокиЗадолженность.НомерСтроки = 1, ОбластьСтрокаЗадолженностьПросроченнаяПервая, ОбластьСтрокаЗадолженностьПросроченная);
					ОбластьЗадолженность.Параметры.ВалютаКод = СтрокиЗадолженность.ВалютаКод;
					Если СтрокиЗадолженность.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
						ОбластьЗадолженность.Параметры.СуммаВал = 0;
					Иначе
						ОбластьЗадолженность.Параметры.СуммаВал = СтрокиЗадолженность.СуммаПросроченная;
					КонецЕсли;
					ОбластьЗадолженность.Параметры.Сумма = СтрокиЗадолженность.СуммаПросроченнаяРуб;
					ТабличныйДокумент.Вывести(ОбластьЗадолженность);
				КонецЕсли;
			КонецЦикла;
			СтрокиЗадолженность.Сбросить();
		КонецЦикла;
		//если не все строки СПРАВОЧНО было выведены ранее
		Если ТабличныйДокумент.Области.Найти("СтрокаЗадолженностьНаПроверкеПервая") = Неопределено Тогда
			 ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьНаПроверкеПервая);
		КонецЕсли;     
		Если ТабличныйДокумент.Области.Найти("СтрокаЗадолженностьПросроченнаяПервая") = Неопределено Тогда
			 ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженностьПросроченнаяПервая);
	    КонецЕсли; 
		
		ОбластьПодвалЗадолженность = ОбластиМакетов[Префикс + "ПодвалЗадолженность"];
		ОбластьПодвалЗадолженность.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьПодвалЗадолженность);
		
		ОбластьШапкаФинансовоеОбеспечение = ОбластиМакетов[Префикс + "ШапкаФинансовоеОбеспечение"];
		ОбластьШапкаФинансовоеОбеспечение.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьШапкаФинансовоеОбеспечение);
		
		Если ЭтоИзменение Тогда
			ОбластьШапкаФинансовоеОбеспечениеИзменение = ОбластиМакетов[Префикс + "ШапкаФинансовоеОбеспечениеИзменение"];
			ОбластьШапка = ОбластьШапкаФинансовоеОбеспечениеИзменение;
			ОбластьСтрокаФинансовоеОбеспечениеИзменение = ОбластиМакетов[Префикс + "СтрокаФинансовоеОбеспечениеИзменение"];
			ОбластьСтрока = ОбластьСтрокаФинансовоеОбеспечениеИзменение;
		Иначе
			ОбластьШапкаФинансовоеОбеспечениеРешение = ОбластиМакетов[Префикс + "ШапкаФинансовоеОбеспечениеРешение"];
			ОбластьШапка = ОбластьШапкаФинансовоеОбеспечениеРешение;
			ОбластьСтрокаФинансовоеОбеспечениеРешение = ОбластиМакетов[Префикс + "СтрокаФинансовоеОбеспечениеРешение"];
			ОбластьСтрока = ОбластьСтрокаФинансовоеОбеспечениеРешение;
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		СтрокиФинансовоеОбеспечение = СтруктураДанных.ФинансовоеОбеспечение.Выбрать();
		Пока СтрокиФинансовоеОбеспечение.Следующий() Цикл
			ОбластьСтрока.Параметры.Заполнить(СтрокиФинансовоеОбеспечение);
			ТабличныйДокумент.Вывести(ОбластьСтрока);
		КонецЦикла;
		
		ОбластьПодвалФинансовоеОбеспечение = ОбластиМакетов[Префикс + "ПодвалФинансовоеОбеспечение"];
		ОбластьПодвалФинансовоеОбеспечение.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьПодвалФинансовоеОбеспечение);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция СуммаВРублевомЭквиваленте(Сумма, Валюта, КурсыВалют) Экспорт
	
	Если Не ЗначениеЗаполнено(Валюта)
		ИЛИ Валюта = ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета() Тогда
		Возврат Сумма;
	КонецЕсли;
	
	Для Каждого СтрокаСКурсом Из КурсыВалют Цикл
		Если СтрокаСКурсом.Валюта = Валюта Тогда
			Возврат Окр(Сумма * СтрокаСКурсом.Курс / ?(СтрокаСКурсом.Кратность = 0, 1, СтрокаСКурсом.Кратность), 2);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Сумма;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Заполнение реквизита "СуммаДокумента" шапки
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РешениеОКомандированииФинансовоеОбеспечение.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РешениеОКомандировании.ФинансовоеОбеспечение КАК РешениеОКомандированииФинансовоеОбеспечение
	|
	|СГРУППИРОВАТЬ ПО
	|	РешениеОКомандированииФинансовоеОбеспечение.Ссылка
	|
	|ИМЕЮЩИЕ
	|	СУММА(РешениеОКомандированииФинансовоеОбеспечение.Сумма) <> РешениеОКомандированииФинансовоеОбеспечение.Ссылка.СуммаДокумента";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Документ.РешениеОКомандировании";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			// Объект не удается заблокировать - попробуем обработать его на следующей итерации.
			// Отдельно обрабатывать ошибку не требуется, т.к. в худшем случае обработчик зациклится
			// и прервется автоматически.
			ЗафиксироватьТранзакцию();
			Продолжить;
		КонецПопытки;
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Выборка.Ссылка) Тогда
			// Вероятно был удален раньше, чем обработчик дошел до него
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		
		Объект.СуммаДокумента = Объект.ФинансовоеОбеспечение.Итог("Сумма");
		
		Если Не Объект.Модифицированность() Тогда
			
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
			
		КонецЕсли;
		
		Попытка
		
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.РешениеОКомандировании,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

Функция РеквизитыПервичногоРешения(ДокументПоследователь)
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПоследователь, "Дата, Номер, ТипРешения, ДокументОснование");
	
	Если РеквизитыДокумента.ТипРешения = ПредопределенноеЗначение("Перечисление.ТипыРешенийОКомандировании.Первичное")
		ИЛИ НЕ ЗначениеЗаполнено(РеквизитыДокумента.ТипРешения) Тогда
		Возврат Новый Структура("РешениеДата, РешениеНомер", РеквизитыДокумента.Дата, РеквизитыДокумента.Номер);
	Иначе
		Возврат РеквизитыПервичногоРешения(РеквизитыДокумента.ДокументОснование);
	КонецЕсли;
	
КонецФункции

Процедура ДобавитьОбластьВКоллекцию(Макет, Коллекция, Заголовок, Префикс = "")
	Коллекция.Вставить(Префикс + Заголовок, Макет.ПолучитьОбласть(Заголовок));
КонецПроцедуры

Процедура НайтиДокументыОснованияРекурсивно(Документ, ДокументыОснования)
	
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыОснования.Добавить(Документ);
	
	НайтиДокументыОснованияРекурсивно(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "ДокументОснование"), ДокументыОснования);
	
КонецПроцедуры

Функция СуточныеПоНормативу(Отбор) Экспорт
	
	Норматив = Новый Структура;
	Норматив.Вставить("Сумма");
	Норматив.Вставить("КФО");
	Норматив.Вставить("Валюта");
	Норматив.Вставить("ОплачиваютсяОднодневныеКомандировки");
	
	ПроцентНадбавки = 0;
	ПроцентИзменения = 100;
	
	Запрос = Новый Запрос;
	
	Если Отбор.Страна <> ПредопределенноеЗначение("Справочник.СтраныМира.Россия") 
		И ЗначениеЗаполнено(Отбор.ОсобыйСтатус) Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	НадбавкиКСуточнымВЗагранкомандировках.ПроцентНадбавки КАК ПроцентНадбавки
		|ИЗ
		|	РегистрСведений.НадбавкиКСуточнымВЗагранкомандировках КАК НадбавкиКСуточнымВЗагранкомандировках
		|ГДЕ
		|	НадбавкиКСуточнымВЗагранкомандировках.ОсобыйСтатус = &ОсобыйСтатус";
		Запрос.УстановитьПараметр("ОсобыйСтатус", Отбор.ОсобыйСтатус);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПроцентНадбавки = Выборка.ПроцентНадбавки;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор.ДополнительноеУсловие) Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоправкиКНормативамСуточных.ПроцентИзменения КАК ПроцентИзменения
		|ИЗ
		|	РегистрСведений.ПоправкиКНормативамСуточных КАК ПоправкиКНормативамСуточных
		|ГДЕ
		|	ПоправкиКНормативамСуточных.ДополнительноеУсловие = &ДополнительноеУсловие";
		Запрос.УстановитьПараметр("ДополнительноеУсловие", Отбор.ДополнительноеУсловие);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПроцентИзменения = Выборка.ПроцентИзменения;
		КонецЕсли;
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НормативыСуточныхСрезПоследних.Сумма КАК Сумма,
	|	НормативыСуточныхСрезПоследних.Валюта КАК Валюта,
	|	НормативыСуточныхСрезПоследних.КФО КАК КФО,
	|	НормативыСуточныхСрезПоследних.ОплачиваютсяОднодневныеКомандировки КАК ОплачиваютсяОднодневныеКомандировки,
	|	1 КАК Приоритет
	|ПОМЕСТИТЬ НормативыСПриоритетами
	|ИЗ
	|	РегистрСведений.НормативыСуточных.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И Страна = &Страна
	|				И Территория = &Территория) КАК НормативыСуточныхСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НормативыСуточныхСрезПоследних.Сумма,
	|	НормативыСуточныхСрезПоследних.Валюта,
	|	НормативыСуточныхСрезПоследних.КФО КАК КФО,
	|	НормативыСуточныхСрезПоследних.ОплачиваютсяОднодневныеКомандировки,
	|	2
	|ИЗ
	|	РегистрСведений.НормативыСуточных.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И Страна = &Страна
	|				И Территория = ЗНАЧЕНИЕ(Справочник.ТерриторииСОтдельнымиНормативами.ПустаяСсылка)) КАК НормативыСуточныхСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НормативыСуточныхСрезПоследних.Сумма,
	|	НормативыСуточныхСрезПоследних.Валюта,
	|	НормативыСуточныхСрезПоследних.КФО КАК КФО,
	|	НормативыСуточныхСрезПоследних.ОплачиваютсяОднодневныеКомандировки,
	|	3
	|ИЗ
	|	РегистрСведений.НормативыСуточных.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И Страна = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	|				И Территория = ЗНАЧЕНИЕ(Справочник.ТерриторииСОтдельнымиНормативами.ПустаяСсылка)) КАК НормативыСуточныхСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НормативыСПриоритетами.Сумма КАК Сумма,
	|	НормативыСПриоритетами.Валюта КАК Валюта,
	|	НормативыСПриоритетами.КФО КАК КФО,
	|	НормативыСПриоритетами.ОплачиваютсяОднодневныеКомандировки
	|ИЗ
	|	НормативыСПриоритетами КАК НормативыСПриоритетами
	|
	|УПОРЯДОЧИТЬ ПО
	|	НормативыСПриоритетами.Приоритет";
	
	Запрос.УстановитьПараметр("Период",      Отбор.Период);
	Запрос.УстановитьПараметр("Организация", Отбор.Организация);
	Запрос.УстановитьПараметр("Страна",      Отбор.Страна);
	Запрос.УстановитьПараметр("Территория",  Отбор.Территория);
	
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Если Выборка.Следующий() Тогда
		Норматив.Вставить("Сумма",									Выборка.Сумма * (1 + ПроцентНадбавки / 100) * (ПроцентИзменения / 100));
		Норматив.Вставить("КФО",									Выборка.КФО);
		Норматив.Вставить("Валюта",									Выборка.Валюта);
		Норматив.Вставить("ОплачиваютсяОднодневныеКомандировки",	Выборка.ОплачиваютсяОднодневныеКомандировки);
	КонецЕсли;
	
	Возврат Норматив;
	
КонецФункции

Функция ТаблицаОтборовСуточных() Экспорт

	ТаблицаОтборовСуточных = Новый ТаблицаЗначений;
	ТаблицаОтборовСуточных.Колонки.Добавить("Страна", Новый ОписаниеТипов("СправочникСсылка.СтраныМира"));
	ТаблицаОтборовСуточных.Колонки.Добавить("Территория", 
									Новый ОписаниеТипов("СправочникСсылка.ТерриторииСОтдельнымиНормативами"));
	ТаблицаОтборовСуточных.Колонки.Добавить("ДополнительноеУсловие", 
												Новый ОписаниеТипов("СправочникСсылка.ДополнительныеУсловияКомандирования"));
	
	Возврат ТаблицаОтборовСуточных;
	
КонецФункции 

Функция СуточныеПоНормативуСтранИТерриторий(ОсновныеРеквизиты, Данные) Экспорт
	
