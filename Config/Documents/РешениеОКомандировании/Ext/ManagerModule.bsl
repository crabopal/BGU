#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("Дата");
	Поля.Добавить("Номер");
	Поля.Добавить("ТипРешения");
	Поля.Добавить("КомандировкаЗаГраницу");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(Данные.ТипРешения)
		И НЕ Данные.ТипРешения = ПредопределенноеЗначение("Перечисление.ТипыРешенийОКомандировании.Первичное") Тогда
		Представление = НСтр("ru = 'Изменение Решения о командировании'");
	Иначе
		Представление = НСтр("ru = 'Решение о командировании'");
	КонецЕсли;
	
	Если Данные.КомандировкаЗаГраницу Тогда
		Представление = Представление + НСтр("ru = ' на территорию иностранного государства'") ;
	Иначе
		Представление = Представление + НСтр("ru = ' на территории Российской Федерации'") ;
	КонецЕсли;
	
	Представление = Представление + " "+СокрЛП(Данные.Номер)+" от "+Данные.Дата;;
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция ЭтоПоследнийДействующийДокумент(ПроверяемыйДокумент) Экспорт
	
	Если Не ЗначениеЗаполнено(ПроверяемыйДокумент) Тогда
		Возврат Истина;
	КонецЕсли;
	
	// Документ считается последним, если на его основании еще не введено ни одного документа
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	Документ.РешениеОКомандировании КАК РешениеОКомандировании
	|ГДЕ
	|	РешениеОКомандировании.ДокументОснование = &ДокументОснование
	|	И РешениеОКомандировании.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ДокументОснование", ПроверяемыйДокумент);
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ТаблицаОбязательствПоСвязаннымРешениям(ПоследнийДокумент) Экспорт
	
	ДокументыОснования = Новый Массив;
	НайтиДокументыОснованияРекурсивно(ПоследнийДокумент, ДокументыОснования);
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДокументыОснования", ДокументыОснования);
	Запрос.УстановитьПараметр("ВалютаРегУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	Запрос.УстановитьПараметр("Счет50211", БухгалтерскийУчет.СписокСчетов("502.11, 502.21"));
	Запрос.УстановитьПараметр("Счет50212", БухгалтерскийУчет.СписокСчетов("502.12, 502.22"));
	
