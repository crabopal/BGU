			СтруктураДанных.Вставить("РуководительФЭПИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(СтруктрураФИО, Истина));
			СтруктураДанных.Вставить("РуководительФЭПДолжность", ДанныеСотрудника.ДолжностьНаименование);
