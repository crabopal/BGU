			СтруктураДанных.Вставить("ОтветственныйИсполнительКадрыИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(СтруктрураФИО, Истина));
			СтруктураДанных.Вставить("ОтветственныйИсполнительКадрыДолжность", ДанныеСотрудника.ДолжностьНаименование);
		КонецЕсли;
		
		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(СтруктураДанных.Дата);
		СтруктураДанных.Вставить("ЧислоДаты", 	СтруктураДаты.Число);
		СтруктураДанных.Вставить("МесяцДаты", 	СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДаты", 	СтруктураДаты.Год);
		
		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(СтруктураДанных.ДатаУтверждения);
		СтруктураДанных.Вставить("ЧислоДатыУтв",СтруктураДаты.Число);
		СтруктураДанных.Вставить("МесяцДатыУтв",СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДатыУтв", 	СтруктураДаты.Год);
		
		СтруктураДанных.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(СтруктураДанных.Ссылка, СтруктураДанных.Номер);
		СтруктураДанных.РешениеНомер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(СтруктураДанных.Ссылка, СтруктураДанных.РешениеНомер);
		
		СтруктураПоискаТЧ = Новый Структура("Ссылка", Выборка.Ссылка);
		
		Префикс = ?(СтруктураДанных.КомандировкаЗаГраницу, "ИГ", "");
		
		ЭтоИзменение = ЗначениеЗаполнено(СтруктураДанных.ДокументОснование);
		
		Если НЕ СтруктураДанных.КомандировкаЗаГраницу Тогда
			Если НЕ ЭтоИзменение Тогда
				СтруктураДанных.Вставить("КодФормы", "0504512");
			Иначе
				СтруктураДанных.Вставить("КодФормы", "0504513");
			КонецЕсли;
		Иначе
			Если НЕ ЭтоИзменение Тогда
				СтруктураДанных.Вставить("КодФормы", "0504515");
			Иначе
				СтруктураДанных.Вставить("КодФормы", "0504516");
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоИзменение Тогда
            ОбластьПриложение2 = ОбластиМакетов[Префикс + "Приложение2"]; 
			ТабличныйДокумент.Вывести(ОбластьПриложение2);
		Иначе
			ОбластьПриложение1 = ОбластиМакетов[Префикс + "Приложение1"]; 
			ТабличныйДокумент.Вывести(ОбластьПриложение1);
        КонецЕсли;
		
		ОбластьЗаголовок1 = ОбластиМакетов[Префикс + "Заголовок1"];
		ОбластьЗаголовок1.Параметры.Заполнить(СтруктураДанных);
		Если СтруктураДанных.Организация = СтруктураДанных.ОрганизацияОсуществляющаяОбеспечение Тогда
			ОбластьЗаголовок1.Параметры.НаименованиеОрганизацииПБС = "";
			ОбластьЗаголовок1.Параметры.РуководительОрганизацииПБСИнициалыФамилия = "";
			ОбластьЗаголовок1.Параметры.РуководительОрганизацииПБСДолжность = "";
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьЗаголовок1);
		
		Если ЭтоИзменение Тогда
			ОбластьЗаголовок1Изменение = ОбластиМакетов[Префикс + "Заголовок1Изменение"];
			ОбластьЗаголовок1Изменение.Параметры.Заполнить(СтруктураДанных);
			ТабличныйДокумент.Вывести(ОбластьЗаголовок1Изменение);
		Иначе
			ОбластьЗаголовок1Решение = ОбластиМакетов[Префикс + "Заголовок1Решение"];
			ОбластьЗаголовок1Решение.Параметры.Заполнить(СтруктураДанных);
			ТабличныйДокумент.Вывести(ОбластьЗаголовок1Решение);
		КонецЕсли;
		
		ОбластьЗаголовок2 = ОбластиМакетов[Префикс + "Заголовок2"];
		ОбластьЗаголовок2.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьЗаголовок2);
		
		Если ЭтоИзменение Тогда
			ОбластьЗаголовок2Изменение = ОбластиМакетов[Префикс + "Заголовок2Изменение"];
			ОбластьЗаголовок2Изменение.Параметры.Заполнить(СтруктураДанных);
			ТабличныйДокумент.Вывести(ОбластьЗаголовок2Изменение);
		КонецЕсли;
		
		ОбластьЗаголовок3 = ОбластиМакетов[Префикс + "Заголовок3"];
		ОбластьЗаголовок3.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьЗаголовок3);
		
		Если ЭтоИзменение Тогда
			
			ОбластьЗаголовок3Изменение = ОбластиМакетов[Префикс + "Заголовок3Изменение"];
			
			Если СтруктураДанных.ТипДокументаОснования = ПредопределенноеЗначение("Перечисление.ТипыРешенийОКомандировании.Первичное")
				ИЛИ НЕ ЗначениеЗаполнено(СтруктураДанных.ТипДокументаОснования) Тогда
				ОбластьЗаголовок3Изменение.Параметры.Заполнить(СтруктураДанных);
			Иначе
				ОбластьЗаголовок3Изменение.Параметры.Заполнить(РеквизитыПервичногоРешения(СтруктураДанных.ОснованиеДокументаОснования));
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьЗаголовок3Изменение);
			
		КонецЕсли;
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ОбластьШапкаМестоИСроки = ОбластиМакетов[Префикс + "ШапкаМестоИСроки"];
		ОбластьШапкаМестоИСроки.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьШапкаМестоИСроки);  
		
		Если Префикс <> "ИГ" Тогда
			ОбластьМестоИСроки = ОбластиМакетов[?(ЭтоИзменение, Префикс + "МестоИСроки_изм", Префикс + "МестоИСроки")];
			ТабличныйДокумент.Вывести(ОбластьМестоИСроки);
		КонецЕсли;	
		
		СтрокиМестоИСроки = СтруктураДанных.МестоИСроки.Выгрузить();
		СтрокиМестоИСроки.Сортировать("ДатаНачала, НомерСтроки");
		
		// поиск крайних дат в местах и сроках и условиях проезда
		ДеньВыезда = Дата(2999,1,1);
		ДеньПриезда = Дата(1,1,1);
		
		Для Каждого СтрокаМестоИСроки Из СтрокиМестоИСроки Цикл
			ДеньВыезда = Мин(ДеньВыезда, СтрокаМестоИСроки.ДатаНачала);
			ДеньПриезда = Макс(ДеньПриезда, СтрокаМестоИСроки.ДатаОкончания);
		КонецЦикла;
		
		СтрокиУсловияПроезда.Сбросить();
		Пока СтрокиУсловияПроезда.НайтиСледующий(СтруктураПоискаТЧ) Цикл
			Если ЗначениеЗаполнено(СтрокиУсловияПроезда.ДатаОтправления) Тогда
				ДеньВыезда = Мин(ДеньВыезда, СтрокиУсловияПроезда.ДатаОтправления);
			КонецЕсли;
			ДеньПриезда = Макс(ДеньПриезда, СтрокиУсловияПроезда.ДатаПрибытия);
			Если СтруктураДанных.КомандировкаЗаГраницу И ЗначениеЗаполнено(СтрокиУсловияПроезда.ДатаПересеченияГраницы) Тогда
				ДеньВыезда = Мин(ДеньВыезда, СтрокиУсловияПроезда.ДатаПересеченияГраницы);
				ДеньПриезда = Макс(ДеньПриезда, СтрокиУсловияПроезда.ДатаПересеченияГраницы);
			КонецЕсли;
		КонецЦикла;
		
		ОбластьСтрокаМестоИСроки = ОбластиМакетов[Префикс + "СтрокаМестоИСроки"];
		
		Для Каждого СтрокаМестоИСроки Из СтрокиМестоИСроки Цикл
			
			ОбластьСтрокаМестоИСроки.Параметры.Заполнить(СтрокаМестоИСроки);
			ОбластьСтрокаМестоИСроки.Параметры.Продолжительность = (СтрокаМестоИСроки.ДатаОкончания - СтрокаМестоИСроки.ДатаНачала)/86400 + 1;
			
			Если НЕ СтруктураДанных.КомандировкаЗаГраницу Тогда
				ОбластьСтрокаМестоИСроки.Параметры.ДеньВыезда = "Х";
				ОбластьСтрокаМестоИСроки.Параметры.ДеньПриезда = "Х";
				ОбластьСтрокаМестоИСроки.Параметры.ПродолжительностьСУчетомДнейВПути = "Х";
			КонецЕсли;
			
			Если СтрокиМестоИСроки.Индекс(СтрокаМестоИСроки) = 0 Тогда
				Если НЕ СтруктураДанных.КомандировкаЗаГраницу Тогда
					ОбластьСтрокаМестоИСроки.Параметры.ДеньВыезда = ДеньВыезда;
				Иначе
					ОбластьСтрокаМестоИСроки.Параметры.ДатаНачала = ДеньВыезда;
				КонецЕсли;
			КонецЕсли;
			Если СтрокиМестоИСроки.Индекс(СтрокаМестоИСроки) = СтрокиМестоИСроки.Количество() - 1 Тогда
				Если НЕ СтруктураДанных.КомандировкаЗаГраницу Тогда
					ОбластьСтрокаМестоИСроки.Параметры.ДеньПриезда = ДеньПриезда;
				Иначе
					ОбластьСтрокаМестоИСроки.Параметры.ДатаОкончания = ДеньПриезда;
				КонецЕсли;
				ОбластьСтрокаМестоИСроки.Параметры.ПродолжительностьСУчетомДнейВПути = (ДеньПриезда - ДеньВыезда)/86400 + 1;
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьСтрокаМестоИСроки);
			
		КонецЦикла;
		
		ОбластьПодвалМестоИСроки = ОбластиМакетов[Префикс + "ПодвалМестоИСроки"];
		ОбластьПодвалМестоИСроки.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьПодвалМестоИСроки);
		
		ОбластьШапкаУсловияПроезда = ОбластиМакетов[Префикс + "ШапкаУсловияПроезда"];
		ОбластьШапкаУсловияПроезда.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьШапкаУсловияПроезда);
		
		ОбластьСтрокаУсловияПроезда = ОбластиМакетов[Префикс + "СтрокаУсловияПроезда"];
		
		СтрокиУсловияПроезда.Сбросить();
		Пока СтрокиУсловияПроезда.НайтиСледующий(СтруктураПоискаТЧ) Цикл
			ОбластьСтрокаУсловияПроезда.Параметры.Заполнить(СтрокиУсловияПроезда);
			ТабличныйДокумент.Вывести(ОбластьСтрокаУсловияПроезда);
		КонецЦикла;
		
		ОбластьШапкаУсловияПроживания = ОбластиМакетов[Префикс + "ШапкаУсловияПроживания"];
		ОбластьШапкаУсловияПроживания.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(ОбластьШапкаУсловияПроживания);
		
		ОбластьСтрокаУсловияПроживания = ОбластиМакетов[Префикс + "СтрокаУсловияПроживания"];
		
		СтрокиУсловияПроживания.Сбросить();
		Пока СтрокиУсловияПроживания.НайтиСледующий(СтруктураПоискаТЧ) Цикл
			ОбластьСтрокаУсловияПроживания.Параметры.Заполнить(СтрокиУсловияПроживания);
			ТабличныйДокумент.Вывести(ОбластьСтрокаУсловияПроживания);
		КонецЦикла;
		
		Если СтруктураДанных.КомандировкаЗаГраницу Тогда
			
			ОбластьПодвалУсловияПроживания = ОбластиМакетов[Префикс + "ПодвалУсловияПроживания"];
			ТабличныйДокумент.Вывести(ОбластьПодвалУсловияПроживания);
			
			ОбластьСтрокаКурсыВалют = ОбластиМакетов[Префикс + "СтрокаКурсыВалют"];
			
			КурсыВалют = СтруктураДанных.КурсыВалют.Выгрузить();
			
			Если КурсыВалют.Количество() = 0 Тогда  
				ОбластьСтрокаКурсыВалют.Параметры.ВалютаКод = "643";
				ОбластьСтрокаКурсыВалют.Параметры.ВалютаНаименование = "RUB";
				ОбластьСтрокаКурсыВалют.Параметры.Курс = "1";
				
				ТабличныйДокумент.Вывести(ОбластьСтрокаКурсыВалют);
			КонецЕсли;	
			
			Для Каждого КурсВалюты Из КурсыВалют Цикл
				ОбластьСтрокаКурсыВалют.Параметры.Заполнить(КурсВалюты);
				ТабличныйДокумент.Вывести(ОбластьСтрокаКурсыВалют);
			КонецЦикла;
			
		КонецЕсли;
		
		ОбластьШапкаРасчетОбязательств = ОбластиМакетов[Префикс + "ШапкаРасчетОбязательств"];
		ТабличныйДокумент.Вывести(ОбластьШапкаРасчетОбязательств);
		
		ТаблицаПоСпособамОбеспечения = Новый ТаблицаЗначений;
		ТаблицаПоСпособамОбеспечения.Колонки.Добавить("Сумма", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15,2));
		ТаблицаПоСпособамОбеспечения.Колонки.Добавить("СуммаВал", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15,2));
		ТаблицаПоСпособамОбеспечения.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
		ТаблицаПоСпособамОбеспечения.Колонки.Добавить("ВалютаКод", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(3));
		ТаблицаПоСпособамОбеспечения.Колонки.Добавить("СпособОбеспечения", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыОбеспеченияКомандировки"));
		
		НомерСтроки = 1;
		ИтогоСумма = 0;
		
		ОбластьСтрокаРасчетОбязательств = ОбластиМакетов[Префикс + "СтрокаРасчетОбязательств"];
		
		СтрокиСуточные = СтруктураДанных.Суточные.Выбрать();
		Пока СтрокиСуточные.Следующий() Цикл
			
			ОбластьСтрокаРасчетОбязательств.Параметры.НомерСтроки = НомерСтроки;
			ОбластьСтрокаРасчетОбязательств.Параметры.НаименованиеРасхода = СтрокиСуточные.НаименованиеРасхода;
			ОбластьСтрокаРасчетОбязательств.Параметры.Количество = СтрокиСуточные.КоличествоДней;
			ОбластьСтрокаРасчетОбязательств.Параметры.Цена = ?(СтрокиСуточные.КоличествоДней = 0,
				СтрокиСуточные.Сумма, СтрокиСуточные.Сумма / СтрокиСуточные.КоличествоДней);
			ОбластьСтрокаРасчетОбязательств.Параметры.СпособОбеспечения = СтрокиСуточные.СпособОбеспечения;
			
			Если СтруктураДанных.КомандировкаЗаГраницу Тогда
				СуммаВРублях = СуммаВРублевомЭквиваленте(СтрокиСуточные.Сумма, СтрокиСуточные.Валюта, КурсыВалют);
				ОбластьСтрокаРасчетОбязательств.Параметры.ВалютаКод = СтрокиСуточные.ВалютаКод;
				ОбластьСтрокаРасчетОбязательств.Параметры.Сумма = СуммаВРублях;
				Если СтрокиСуточные.Валюта = ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета() Тогда
					ОбластьСтрокаРасчетОбязательств.Параметры.СуммаВал = "Х";
				Иначе
					ОбластьСтрокаРасчетОбязательств.Параметры.СуммаВал = СтрокиСуточные.Сумма;
				КонецЕсли;
			Иначе
				СуммаВРублях = СтрокиСуточные.Сумма;
				ОбластьСтрокаРасчетОбязательств.Параметры.Сумма = СуммаВРублях;
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьСтрокаРасчетОбязательств);
			
			НомерСтроки = НомерСтроки + 1;
			ИтогоСумма = ИтогоСумма + СуммаВРублях;
			
			НоваяСтрокаПоСпособамОбеспечения = ТаблицаПоСпособамОбеспечения.Добавить();
			НоваяСтрокаПоСпособамОбеспечения.Сумма = СуммаВРублях;
			НоваяСтрокаПоСпособамОбеспечения.СуммаВал = СтрокиСуточные.Сумма;
			НоваяСтрокаПоСпособамОбеспечения.Валюта = СтрокиСуточные.Валюта;
			НоваяСтрокаПоСпособамОбеспечения.ВалютаКод = СтрокиСуточные.ВалютаКод;
			НоваяСтрокаПоСпособамОбеспечения.СпособОбеспечения = СтрокиСуточные.СпособОбеспечения;
			
		КонецЦикла;
		
		СтрокиУсловияПроезда.Сбросить();
		Пока СтрокиУсловияПроезда.НайтиСледующий(СтруктураПоискаТЧ) Цикл
			
			Если СтрокиУсловияПроезда.Сумма = 0 Тогда
				Продолжить;
			КонецЕсли;	
			
			ОбластьСтрокаРасчетОбязательств.Параметры.НомерСтроки = НомерСтроки;
			ОбластьСтрокаРасчетОбязательств.Параметры.НаименованиеРасхода = СтрокиУсловияПроезда.НаименованиеРасхода;
			ОбластьСтрокаРасчетОбязательств.Параметры.Количество = 1;
			ОбластьСтрокаРасчетОбязательств.Параметры.Цена  = СтрокиУсловияПроезда.Сумма;
			ОбластьСтрокаРасчетОбязательств.Параметры.Сумма = СтрокиУсловияПроезда.Сумма;
			ОбластьСтрокаРасчетОбязательств.Параметры.СпособОбеспечения = СтрокиУсловияПроезда.СпособОбеспечения;
			
			Если СтруктураДанных.КомандировкаЗаГраницу Тогда
				СуммаВРублях = СуммаВРублевомЭквиваленте(СтрокиУсловияПроезда.Сумма, СтрокиУсловияПроезда.Валюта, КурсыВалют);
				ОбластьСтрокаРасчетОбязательств.Параметры.ВалютаКод = СтрокиУсловияПроезда.ВалютаКод;
				ОбластьСтрокаРасчетОбязательств.Параметры.Сумма = СуммаВРублях;
				Если СтрокиУсловияПроезда.Валюта = ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета() Тогда
					ОбластьСтрокаРасчетОбязательств.Параметры.СуммаВал = "Х";
				Иначе
					ОбластьСтрокаРасчетОбязательств.Параметры.СуммаВал = СтрокиУсловияПроезда.Сумма;
				КонецЕсли;
			Иначе
				СуммаВРублях = СтрокиУсловияПроезда.Сумма;
				ОбластьСтрокаРасчетОбязательств.Параметры.Сумма = СуммаВРублях;
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОбластьСтрокаРасчетОбязательств);
			
			НомерСтроки = НомерСтроки + 1;
			ИтогоСумма  = ИтогоСумма + СуммаВРублях;
			
			НоваяСтрокаПоСпособамОбеспечения                   = ТаблицаПоСпособамОбеспечения.Добавить();
			НоваяСтрокаПоСпособамОбеспечения.Сумма             = СуммаВРублях;
			НоваяСтрокаПоСпособамОбеспечения.СуммаВал          = СтрокиУсловияПроезда.Сумма;
			НоваяСтрокаПоСпособамОбеспечения.Валюта            = СтрокиУсловияПроезда.Валюта;
			НоваяСтрокаПоСпособамОбеспечения.ВалютаКод         = СтрокиУсловияПроезда.ВалютаКод;
			НоваяСтрокаПоСпособамОбеспечения.СпособОбеспечения = СтрокиУсловияПроезда.СпособОбеспечения;
			
		КонецЦикла;
		
		СтрокиУсловияПроживания.Сбросить();
