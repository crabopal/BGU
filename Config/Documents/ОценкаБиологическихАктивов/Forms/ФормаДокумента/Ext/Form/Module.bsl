&НаСервере
Процедура ЗаполнитьСпискиСчетов()
		
	УправлениеМатериальнымиЗапасами.ЗаполнитьСчетаУчетаМЗ105(ЭтотОбъект);
	ПараметрыЗаполненияСчета = УправлениеМатериальнымиЗапасами.ПараметрыЗаполненияДанныхСчетовУчетаМЗВФорме();
	ПараметрыЗаполненияСчета.Организация = Объект.Организация;
	ПараметрыЗаполненияСчета.ДатаСчета = Объект.Дата;
	ПараметрыЗаполненияСчета.Включать113 = Истина;
	ПараметрыЗаполненияСчета.Включать106 = Ложь;
	ПараметрыЗаполненияСчета.СписокВыбора = Новый СписокЗначений;
	УправлениеМатериальнымиЗапасамиФормы.ЗаполнитьДанныеСчетовУчетаМЗВФорме(ЭтотОбъект, ПараметрыЗаполненияСчета);
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет113", БухгалтерскийУчет.СчетПоКоду("113.00",
		?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ОбщегоНазначения.ТекущаяДатаПользователя()),
		Объект.Организация));
	
КонецПроцедуры

