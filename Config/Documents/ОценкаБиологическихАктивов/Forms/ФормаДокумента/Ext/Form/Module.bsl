&НаСервере
Процедура ЗаполнитьДанныеСтроки(ТекущиеДанные, ИзмененнаяКолонка)
	ОстаткиБА = РассчитатьОстатки(ТекущиеДанные.Номенклатура);
	Если ИзмененнаяКолонка = "Количество" Тогда
		Отбор = ОтборДляОстатковМЗ();
		ЗаполнитьЗначенияСвойств(Отбор, ТекущиеДанные);
		СтрокиБА = ОстаткиБА.НайтиСтроки(Отбор);
		Если СтрокиБА.Количество() > 0 Тогда
			ЗаполнитьСуммыИзСтрокиОстатков(ТекущиеДанные, СтрокиБА[0], Ложь);	
		КонецЕсли;
	ИначеЕсли ИзмененнаяКолонка = "Номенклатура" Тогда
		Если ОстаткиБА.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(ТекущиеДанные, ОстаткиБА[0], "СчетУчета, КПС, КФО");
			ЗаполнитьСуммыИзСтрокиОстатков(ТекущиеДанные, ОстаткиБА[0], Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСуммыИзСтрокиОстатков(ТекущиеДанные, СтрокаОстатков, ВыбиратьВсеКоличество)
	Если СтрокаОстатков = Неопределено Тогда
		ТекущиеДанные.СуммаДоИзменения = 0;
		Если ВыбиратьВсеКоличество Тогда
			ТекущиеДанные.Количество = 0;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если ВыбиратьВсеКоличество Тогда
		ТекущиеДанные.Количество = СтрокаОстатков.Количество;
	КонецЕсли;
	Если ТекущиеДанные.Количество = СтрокаОстатков.Количество Тогда
		ТекущиеДанные.СуммаДоИзменения = СтрокаОстатков.Сумма;
	ИначеЕсли СтрокаОстатков.Количество <> 0 Тогда
		ТекущиеДанные.СуммаДоИзменения = ТекущиеДанные.Количество * СтрокаОстатков.Сумма / СтрокаОстатков.Количество;
	КонецЕсли;
КонецПроцедуры 

&НаСервере
Функция ОтборДляОстатковМЗ()
	Отбор = Новый Структура("СчетУчета, КПС, КФО");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
			И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("113.00").УчетПоПодразделениям Тогда
		Отбор.Вставить("Подразделение", Объект.Подразделение);
	КонецЕсли;
	Возврат Отбор;
КонецФункции

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение);
	
	ТаблицаПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	
	Если ТаблицаПодбора.Количество() Тогда
		
		ВыбраннаяНоменклатура = ТаблицаПодбора.ВыгрузитьКолонку("Номенклатура");
		ОстаткиБА = РассчитатьОстатки(ВыбраннаяНоменклатура);
		Отбор = ОтборДляОстатковМЗ();
		
		ВтМатериалы = Объект.Материалы.Выгрузить();
		УправлениеМатериальнымиЗапасами.ЗаполнитьТаблицуИзПодбораМатериалов(ВтМатериалы, ТаблицаПодбора, "Сумма");
		
		Для Каждого СтрокаМатериалы Из ВтМатериалы Цикл
			Если СтрокаМатериалы.НоваяСтрока Тогда
				ЗаполнитьДанныеСчетаВСтроке(ЭтотОбъект, СтрокаМатериалы, Ложь);
				Если Отбор.Свойство("Подразделение") Тогда
					ЗаполнитьЗначенияСвойств(Отбор, СтрокаМатериалы, ,"Подразделение");
				Иначе
					ЗаполнитьЗначенияСвойств(Отбор, СтрокаМатериалы);
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(Отбор, СтрокаМатериалы);
				СтрокиОстатков = ОстаткиБА.НайтиСтроки(Отбор);
				Если СтрокиОстатков.Количество() > 0 Тогда
					ЗаполнитьСуммыИзСтрокиОстатков(СтрокаМатериалы, СтрокиОстатков[0], Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Объект.Материалы.Загрузить(ВтМатериалы);
		УстановитьВидимостьЭлементов(ЭтотОбъект);
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция РассчитатьОстатки(Знач ВыбраннаяНоменклатура)
	
	Если ТипЗнч(ВыбраннаяНоменклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		ВыбраннаяНоменклатура = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыбраннаяНоменклатура);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет В (&СчетаУчета)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Счет
	|			ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|		КОНЕЦ) КАК СчетУчета,
	|	Подстрока(ЖурналПроводокЕПСБУОстатки.Счет.Код, 6, 1) КАК АналитическийКод,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И ЖурналПроводокЕПСБУОстатки.Счет.УчетПоПодразделениям
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	СУММА(ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет В (&СчетаУчета)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.СуммаОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК Сумма,
	|	СУММА(ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет В (&СчетаУчета)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.КоличествоОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК Количество,
	|	СУММА(ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет В (&СчетаУчета)
	|			ТОГДА 0
	|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт
	|	КОНЕЦ) КАК СуммаОбесцененияДоИзменения
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период,
	|			Счет В (&СчетаДляЗапроса),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|			И &УсловиеИФО	
	|			И Субконто1 В (&Номенклатура)) КАК ЖурналПроводокЕПСБУОстатки
	|СГРУППИРОВАТЬ ПО
	|	Подстрока(ЖурналПроводокЕПСБУОстатки.Счет.Код, 6, 1),
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура),
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И ЖурналПроводокЕПСБУОстатки.Счет.УчетПоПодразделениям
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ
	|";
	Если Объект.Ссылка.Пустая() Тогда
		ПериодЗапроса = Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая);
	Иначе
		ПериодЗапроса = Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период", ПериодЗапроса);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Номенклатура", ВыбраннаяНоменклатура);
	Запрос.УстановитьПараметр("ВидыСубконто",
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура));
	Запрос.УстановитьПараметр("СчетаДляЗапроса", БухгалтерскийУчет.СписокСчетов("113.00, 114.00", Объект.Дата, ,
		Объект.Организация));
	Запрос.УстановитьПараметр("СчетаУчета", БухгалтерскийУчет.СписокСчетов("113.00", Объект.Дата, , Объект.Организация));
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	ТаблицаБА = Запрос.Выполнить().Выгрузить();
	Возврат ТаблицаБА;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеСчетаВСтроке(Форма, Строка, ЗаполнятьСчет)
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Форма, Строка);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет", ЗаполнятьСчет);
	ПараметрыОбработки.Вставить("ДтКт", "Дт");
	ПараметрыОбработки.Включать106 = Ложь;
	ПараметрыОбработки.Включать113 = Истина;
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(Строка, ПараметрыОбработки);
	
КонецПроцедуры

