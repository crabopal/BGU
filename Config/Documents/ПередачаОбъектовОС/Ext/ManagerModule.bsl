// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0510458_157н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная0510458_157н",
			УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(НСтр("ru = 'Накладная на отпуск материальных ценностей на сторону'"), "0510458", "61н", "157н"),
			УправлениеПечатьюБГУ.НапечататьНакладнуюНаОтпускМЗ0510458(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПечатьИнвКарточек61н") Тогда
		
		ДанныеДляПечати = УправлениеОсновнымиСредствами.ОбъектыДляГрупповойПечатиКарточек(МассивОбъектов);
		ИменаФайловПечати = Новый Соответствие;
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПечатьИнвКарточек61н","Инвентарные карточки объектов",
			Справочники.ОсновныеСредства.ПечатьИнвентарнойКарточки61н(
			ДанныеДляПечати, ПараметрыПечати, ОбъектыПечати, ИменаФайловПечати),,, ИменаФайловПечати);
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПечатьКарточекКапвложений") Тогда
		
		ДанныеДляПечати = 
			УправлениеОсновнымиСредствами.ОбъектыДляГрупповойПечатиКарточек(МассивОбъектов, "КарточкаКапвложений");

		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
		"ПечатьКарточекКапвложений", НСтр("ru = 'Карточки капвложений (ф.0509211)'"), 
		Справочники.КарточкиКапвложений.Печать0509211(ДанныеДляПечати, ОбъектыПечати, ПараметрыПечати));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПечатьИнвКарточек") Тогда
		
		ДанныеДляПечати = 
			УправлениеОсновнымиСредствами.ОбъектыДляГрупповойПечатиКарточек(МассивОбъектов);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПечатьИнвКарточек","Инвентарные карточки объектов",
			Справочники.ОсновныеСредства.ПечатьИнвентарнойКарточки(ДанныеДляПечати, ОбъектыПечати, "103н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504205_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная0504205_103н",
			"Накладная на отпуск материалов на сторону (ф.0504205) (в ред.103н)",
			ПечатьНакладной0504205(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Накладная0504205_103н"));
		
	КонецЕсли;
		
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504205_52н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Накладная0504205_52н",
			"Накладная на отпуск материалов на сторону (ф.0504205)",
			ПечатьНакладной0504205(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Накладная0504205"));
		
	КонецЕсли;
	
КонецПроцедуры

