	|			ТОГДА ДокТЧ.СтавкаНДС
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|	КОНЕЦ КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА ДокТЧ.Ссылка.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОС),
	|			ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет),
	|			ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106))
	|			ТОГДА ДокТЧ.СуммаНДС
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ДокТЧ.Ссылка.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОС),
	|			ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет),
	|			ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106))
	|			ТОГДА ДокТЧ.Всего
	|		ИНАЧЕ ДокТЧ.Сумма
	|	КОНЕЦ КАК Всего,
	|	ДокТЧ.КПС КАК КПС,
	|	ДокТЧ.СчетУчета КАК СчетУчета,
	|	НЕОПРЕДЕЛЕНО КАК ДополнительнаяАналитикаСчета,
	|	ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) КАК КЭК,
	|	ДокТЧ.Ссылка.КФО КАК КФО,
	|	ДокТЧ.НомерСтроки КАК НомерСтроки,
	|	НЕОПРЕДЕЛЕНО КАК ТипНоменклатуры,
	|	НЕОПРЕДЕЛЕНО КАК ЗабалансовыйСчетУчета,
	|	НЕОПРЕДЕЛЕНО КАК ЗабалансовыйКПС,
	|	НЕОПРЕДЕЛЕНО КАК ЗабалансовыйКЭК,
	|	НЕОПРЕДЕЛЕНО КАК ЗабалансовыйДополнительнаяАналитикаСчета,
	|	ДокТЧ.ОсновноеСредство.Сведения КАК НФАХарактеристики
	|ИЗ
	|	Документ.ПередачаОбъектовОС.ОсновныеСредства КАК ДокТЧ
	|ГДЕ
	|	ДокТЧ.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|ИТОГИ
	|ПО
	|	Ссылка";
	
	Возврат ТекстЗапроса;
КонецФункции	

Функция ТекстЗапросаОСДляТТН(ОбщийИтог, ИмяОбъекта) Экспорт

   ТекстЗапроса = "ВЫБРАТЬ
	|	Шапка.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА Шапка.Грузоотправитель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Шапка.Организация
	|		ИНАЧЕ Шапка.Грузоотправитель
	|	КОНЕЦ КАК Грузоотправитель,
	|	ВЫБОР
	|		КОГДА Шапка.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Шапка.Контрагент
	|		ИНАЧЕ Шапка.Грузополучатель
	|	КОНЕЦ КАК Грузополучатель,
	|	ВЫБОР
	|		КОГДА Шапка.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА Шапка.Договор.СчетКонтрагента = ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка)
	|						ТОГДА Шапка.РасчетныйСчетКонтрагента
	|					ИНАЧЕ Шапка.Договор.СчетКонтрагента
	|				КОНЕЦ
	|		ИНАЧЕ Шапка.РасчетныйСчетГрузополучателя
	|	КОНЕЦ КАК РасчетныйСчетГрузополучателя,
	|	Шапка.Перевозчик КАК Перевозчик,
	|	Шапка.Организация КАК Организация
	|ИЗ
	|	&ИмяОбъектаШапка КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.ОсновноеСредство КАК Номенклатура,
	|	Таблица.ОсновноеСредство.Код КАК ТоварКод,
	|	Таблица.ИнвентарныйНомер КАК ТоварАртикул,
	|	Таблица.ОсновноеСредство.Наименование КАК ТоварНаименование,
	|	""шт"" КАК БазоваяЕдиницаНаименование,
	|	СУММА(Таблица.Количество) КАК Количество,
	|	СУММА(Таблица.Количество) КАК КоличествоМест,
	|	ВЫБОР
	|		КОГДА НЕ Таблица.Ссылка.ВидОперации В (&ВидыОперацийССуммойПродажи)
	|			ТОГДА Таблица.СтоимостьЕдиницы
	|		КОГДА НЕ Таблица.Ссылка.СуммаВключаетНДС
	|			ТОГДА ВЫБОР
	|					КОГДА Таблица.Количество = 0
	|						ТОГДА 0
	|					ИНАЧЕ Таблица.Всего / Таблица.Количество
	|				КОНЕЦ
	|		ИНАЧЕ Таблица.ЦенаПродажи
	|	КОНЕЦ КАК Цена,
	|	СУММА(ВЫБОР
	|			КОГДА НЕ Таблица.Ссылка.ВидОперации В (&ВидыОперацийССуммойПродажи)
	|				ТОГДА Таблица.Сумма
	|			ИНАЧЕ Таблица.Всего
	|		КОНЕЦ) КАК СуммаСНДС,
	|	"""" КАК НомерПрейскуранта,
	|	"""" КАК ВидУпаковки,
	|	"""" КАК Масса,
	|	"""" КАК НомерЗаписиВКартотеке
	|ИЗ
	|	&ИмяОбъектаОС КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Таблица.ОсновноеСредство,
	|	Таблица.ОсновноеСредство.Код,
	|	Таблица.ИнвентарныйНомер,
	|	Таблица.ОсновноеСредство.Наименование,
	|	ВЫБОР
	|		КОГДА НЕ Таблица.Ссылка.ВидОперации В (&ВидыОперацийССуммойПродажи)
	|			ТОГДА Таблица.СтоимостьЕдиницы
	|		КОГДА НЕ Таблица.Ссылка.СуммаВключаетНДС
	|			ТОГДА ВЫБОР
	|					КОГДА Таблица.Количество = 0
	|						ТОГДА 0
	|					ИНАЧЕ Таблица.Всего / Таблица.Количество
	|				КОНЕЦ
	|		ИНАЧЕ Таблица.ЦенаПродажи
	|	КОНЕЦ
	|";
	
	Если ОбщийИтог  Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ИТОГИ ПО
		|	ОБЩИЕ";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ИмяОбъектаШапка",ИмяОбъекта);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ИмяОбъектаОС",ИмяОбъекта+".ОсновныеСредства");
	
	Возврат ТекстЗапроса;

КонецФункции	
	
Функция ДанныеДляТТН(Ссылка, ОбщийИтог = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	
	ВидыОперацийССуммойПродажи = Новый Массив;
	ВидыОперацийССуммойПродажи.Добавить(
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106"));
	ВидыОперацийССуммойПродажи.Добавить(
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОС"));
	ВидыОперацийССуммойПродажи.Добавить(
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет"));
	ВидыОперацийССуммойПродажи.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Реализация"));
	Запрос.УстановитьПараметр("ВидыОперацийССуммойПродажи", ВидыОперацийССуммойПродажи);
	
	Запрос.Текст = ТекстЗапросаОСДляТТН(ОбщийИтог,"Документ.ПередачаОбъектовОС");
		
	Возврат Запрос.ВыполнитьПакет();
	
КонецФункции

#КонецОбласти

