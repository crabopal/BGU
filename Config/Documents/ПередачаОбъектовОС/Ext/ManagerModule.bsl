#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ПодготовкаДанныхЭДО

Функция ПодготовитьДанныеДляЭД(ДокументСсылка) Экспорт
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	Руководитель = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ДокументСсылка.Организация, 
																				Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
																				ДокументСсылка.Дата);
	ГлБухгалтер	 = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ДокументСсылка.Организация, 
																				Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер,
																				ДокументСсылка.Дата);
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ВалютаДокумента) Тогда
		КурсВзаиморасчетов = 1;
		КратностьВзаиморасчетов = 1;
	Иначе
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокументСсылка.ВалютаДокумента, ДокументСсылка.Дата);
		КурсВзаиморасчетов = КурсКратность.Курс;
		КратностьВзаиморасчетов = КурсКратность.Кратность;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПередачаОбъектовОС.Номер КАК Номер,
	               |	ПередачаОбъектовОС.Дата КАК Дата,
	               |	ПередачаОбъектовОС.Организация КАК Организация,
	               |	ПередачаОбъектовОС.Контрагент КАК Контрагент,
	               |	ПередачаОбъектовОС.РасчетныйСчетКонтрагента КАК СчетПлательщика,
	               |	ПередачаОбъектовОС.Грузоотправитель КАК Грузоотправитель,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовОС.РасчетныйСчетГрузоотправителя <> ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка)
	               |			ТОГДА ПередачаОбъектовОС.РасчетныйСчетГрузоотправителя
	               |	КОНЕЦ КАК СчетГрузоотправителя,
	               |	ПередачаОбъектовОС.Грузополучатель КАК Грузополучатель,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовОС.РасчетныйСчетГрузополучателя <> ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка)
	               |			ТОГДА ПередачаОбъектовОС.РасчетныйСчетГрузополучателя
	               |		КОГДА ПередачаОбъектовОС.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |			ТОГДА ПередачаОбъектовОС.РасчетныйСчетКонтрагента
	               |	КОНЕЦ КАК СчетГрузополучателя,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовОС.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).Владелец КАК ЛицевойСчет,
	               |	ПередачаОбъектовОС.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	               |	&Руководитель КАК Руководитель,
	               |	&ГлБухгалтер КАК ГлавныйБухгалтер,
	               |	ЗНАЧЕНИЕ(Документ.ПередачаОбъектовОС.ПустаяСсылка) КАК ДокументОснование,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовОС.Договор КАК Справочник.Договоры) КАК Договор,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовОС.Договор КАК Справочник.Договоры).НомерДоговора КАК ДокументОснованиеНомер,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовОС.Договор КАК Справочник.Договоры).ДатаДоговора КАК ДокументОснованиеДата,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовОС.Договор КАК Справочник.Договоры).ВидОбязательства КАК ДокументОснованиеНаименование,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовОС.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ВЫРАЗИТЬ(ПередачаОбъектовОС.ВалютаДокумента КАК Справочник.Валюты).Код
	               |		ИНАЧЕ ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).Код
	               |	КОНЕЦ КАК ВалютаКод,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовОС.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ВЫРАЗИТЬ(ПередачаОбъектовОС.ВалютаДокумента КАК Справочник.Валюты).НаименованиеПолное
	               |		ИНАЧЕ ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).НаименованиеПолное
	               |	КОНЕЦ КАК ВалютаНаименование,
	               |	&КурсВзаиморасчетов КАК Курс,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовОС.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ПередачаОбъектовОС.ВалютаДокумента
	               |		ИНАЧЕ &РегламентированнаяВалюта
	               |	КОНЕЦ КАК Валюта,
	               |	ПередачаОбъектовОС.Контрагент.ОбособленноеПодразделение КАК КонтрагентОбособленноеПодразделение,
	               |	ПередачаОбъектовОС.Контрагент.ГоловнаяОрганизация КАК КонтрагентГоловнаяОрганизация,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовОС.Контрагент.ОбособленноеПодразделение = ИСТИНА
	               |			ТОГДА ВЫБОР
	               |					КОГДА ПередачаОбъектовОС.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |						ТОГДА """"
	               |					КОГДА НЕ ПередачаОбъектовОС.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное = """"
	               |						ТОГДА ПередачаОбъектовОС.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное
	               |					КОГДА ПередачаОбъектовОС.Контрагент.ГоловнаяОрганизация.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	               |							И НЕ ПередачаОбъектовОС.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	               |						ТОГДА ВЫРАЗИТЬ(ПередачаОбъектовОС.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное КАК СТРОКА(1000))
	               |					ИНАЧЕ ПередачаОбъектовОС.Контрагент.ГоловнаяОрганизация.Наименование
	               |				КОНЕЦ
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК КонтрагентГоловнаяОрганизацияПредставление,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовОС.Контрагент.ОбособленноеПодразделение = ИСТИНА
	               |			ТОГДА ВЫБОР
	               |					КОГДА ПередачаОбъектовОС.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |						ТОГДА """"
	               |					ИНАЧЕ ПередачаОбъектовОС.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.ИНН
	               |				КОНЕЦ
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК КонтрагентГоловнаяОрганизацияИНН,
	               |	ПередачаОбъектовОС.СведенияОВыбытииМаркированныхТоваров КАК СведенияОВыбытииМаркированныхТоваров,
	               |	ПередачаОбъектовОС.Ссылка КАК Ссылка,
	               |	ПередачаОбъектовОС.ОтветственныйПередалТРУВид КАК ОтветственныйПередалТРУВид,
	               |	ПередачаОбъектовОС.ОтветственныйПередалТРУДолжность КАК ОтветственныйПередалТРУДолжность,
	               |	ПередачаОбъектовОС.ОтветственныйПередалТРУИныеСведения КАК ОтветственныйПередалТРУИныеСведения,
	               |	ПередачаОбъектовОС.ОтветственныйПередалТРУ КАК ОтветственныйПередалТРУ,
	               |	ПередачаОбъектовОС.ОтветственныйПередалТРУДоверенность КАК ОтветственныйПередалТРУДоверенность,
	               |	ПередачаОбъектовОС.ОтветственныйПередалТРУОснованиеПолномочий КАК ОтветственныйПередалТРУОснованиеПолномочий,
	               |	ПередачаОбъектовОС.ОтветственныйПередалТРУКонтрагент КАК ОтветственныйПередалТРУКонтрагент,
	               |	ПередачаОбъектовОС.ДатаПередачиТРУ КАК ДатаПередачиТРУ,
	               |	ПередачаОбъектовОС.ТРУПереданы КАК ТРУПереданы
	               |ИЗ
	               |	Документ.ПередачаОбъектовОС КАК ПередачаОбъектовОС
	               |ГДЕ
	               |	ПередачаОбъектовОС.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПередачаОбъектовОСОсновныеСредства.НомерСтроки КАК НомерСтроки,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).НаименованиеПолное = """"
	               |			ТОГДА ВЫРАЗИТЬ(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).Представление
	               |		ИНАЧЕ ВЫРАЗИТЬ(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).НаименованиеПолное
	               |	КОНЕЦ КАК НаименованиеНоменклатуры,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).НаименованиеПолное = """"
	               |			ТОГДА ВЫРАЗИТЬ(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).Представление
	               |		ИНАЧЕ ВЫРАЗИТЬ(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).НаименованиеПолное
	               |	КОНЕЦ КАК ТоварНаименование,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).НоменклатурныйНомер = """"
	               |			ТОГДА ВЫРАЗИТЬ(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).Код
	               |		ИНАЧЕ ВЫРАЗИТЬ(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).НоменклатурныйНомер
	               |	КОНЕЦ КАК КодТовара,
	               |	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(&ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Наименование) КАК ЕдиницаИзмерения,
	               |	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(&ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Код) КАК БазоваяЕдиницаКод,
	               |	ПередачаОбъектовОСОсновныеСредства.Количество КАК МассаНетто,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА НЕ ПередачаОбъектовОСОсновныеСредства.Ссылка.СуммаВключаетНДС
	               |				ТОГДА ПередачаОбъектовОСОсновныеСредства.СтоимостьЕдиницы
	               |			КОГДА ПередачаОбъектовОСОсновныеСредства.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И ПередачаОбъектовОСОсновныеСредства.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА (ПередачаОбъектовОСОсновныеСредства.Всего - ПередачаОбъектовОСОсновныеСредства.СуммаНДС) * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА ПередачаОбъектовОСОсновныеСредства.Количество = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ ПередачаОбъектовОСОсновныеСредства.Количество
	               |					КОНЕЦ
	               |			КОГДА ПередачаОбъектовОСОсновныеСредства.СуммаНДС = 0 И ПередачаОбъектовОСОсновныеСредства.СтоимостьЕдиницы <> 0
	               |				ТОГДА ПередачаОбъектовОСОсновныеСредства.СтоимостьЕдиницы
	               |			ИНАЧЕ ВЫБОР
	               |					КОГДА ПередачаОбъектовОСОсновныеСредства.Всего = 0
	               |						ТОГДА ПередачаОбъектовОСОсновныеСредства.Сумма
	               |					ИНАЧЕ ПередачаОбъектовОСОсновныеСредства.Всего - ПередачаОбъектовОСОсновныеСредства.СуммаНДС
	               |				КОНЕЦ / ВЫБОР
	               |					КОГДА ПередачаОбъектовОСОсновныеСредства.Количество = 0
	               |						ТОГДА 1
	               |					ИНАЧЕ ПередачаОбъектовОСОсновныеСредства.Количество
	               |				КОНЕЦ
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК Цена,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА ПередачаОбъектовОСОсновныеСредства.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И ПередачаОбъектовОСОсновныеСредства.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА ВЫБОР
	               |						КОГДА ПередачаОбъектовОСОсновныеСредства.Всего = 0
	               |							ТОГДА ПередачаОбъектовОСОсновныеСредства.Сумма
	               |						ИНАЧЕ ПередачаОбъектовОСОсновныеСредства.Всего - ПередачаОбъектовОСОсновныеСредства.СуммаНДС
	               |					КОНЕЦ * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ
	               |			ИНАЧЕ ВЫБОР
	               |					КОГДА ПередачаОбъектовОСОсновныеСредства.Всего = 0
	               |						ТОГДА ПередачаОбъектовОСОсновныеСредства.Сумма
	               |					ИНАЧЕ ПередачаОбъектовОСОсновныеСредства.Всего - ПередачаОбъектовОСОсновныеСредства.СуммаНДС
	               |				КОНЕЦ
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК СуммаБезНДС,
	               |	ВЫБОР
	               |		КОГДА ПередачаОбъектовОСОсновныеСредства.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	               |		ИНАЧЕ ПередачаОбъектовОСОсновныеСредства.СтавкаНДС
	               |	КОНЕЦ КАК СтавкаНДС,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА ПередачаОбъектовОСОсновныеСредства.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И ПередачаОбъектовОСОсновныеСредства.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА ПередачаОбъектовОСОсновныеСредства.СуммаНДС * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ
	               |			ИНАЧЕ ПередачаОбъектовОСОсновныеСредства.СуммаНДС
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК СуммаНДС,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА ПередачаОбъектовОСОсновныеСредства.Ссылка.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |					И ПередачаОбъектовОСОсновныеСредства.Ссылка.ВалютаДокумента <> &РегламентированнаяВалюта
	               |				ТОГДА ВЫБОР
	               |						КОГДА ПередачаОбъектовОСОсновныеСредства.Всего = 0
	               |							ТОГДА ПередачаОбъектовОСОсновныеСредства.Сумма
	               |						ИНАЧЕ ПередачаОбъектовОСОсновныеСредства.Всего
	               |					КОНЕЦ * ВЫБОР
	               |						КОГДА &КурсВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КурсВзаиморасчетов
	               |					КОНЕЦ / ВЫБОР
	               |						КОГДА &КратностьВзаиморасчетов = 0
	               |							ТОГДА 1
	               |						ИНАЧЕ &КратностьВзаиморасчетов
	               |					КОНЕЦ
	               |			ИНАЧЕ ВЫБОР
	               |					КОГДА ПередачаОбъектовОСОсновныеСредства.Всего = 0
	               |						ТОГДА ПередачаОбъектовОСОсновныеСредства.Сумма
	               |					ИНАЧЕ ПередачаОбъектовОСОсновныеСредства.Всего
	               |				КОНЕЦ
	               |		КОНЕЦ КАК ЧИСЛО(14, 2)) КАК СуммаСНДС,
	               |	ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Номенклатура,
	               |	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).СтранаПроисхождения.Код) КАК КодСтраныПроисхождения,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).СтранаПроисхождения.Наименование КАК НаименованиеСтраныПроисхождения,
	               |	ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка) КАК НомерГТД,
	               |	""1"" КАК Признак,
	               |	ПередачаОбъектовОСОсновныеСредства.Количество КАК Количество,
	               |	"""" КАК ПризнакДополнительнаяИнформация,
	               |	ВЫРАЗИТЬ(&ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Наименование КАК ЕдиницаИзмеренияНаименование,
	               |	ПередачаОбъектовОСОсновныеСредства.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).КодКаталога КАК КодКаталога,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).КодПоКТРУ КАК КодПоКТРУ,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства).КодТНВЭД КАК КодТНВЭД,
	               |	"""" КАК СведенияОбъемноСортовогоУчетаМаркированныхТоваров
	               |ИЗ
	               |	Документ.ПередачаОбъектовОС.ОсновныеСредства КАК ПередачаОбъектовОСОсновныеСредства
	               |ГДЕ
	               |	ПередачаОбъектовОСОсновныеСредства.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПередачаОбъектовОСКодыУпаковокМаркируемойПродукции.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ПередачаОбъектовОСКодыУпаковокМаркируемойПродукции.НомерУпаковки КАК НомерУпаковки,
	               |	ПередачаОбъектовОСКодыУпаковокМаркируемойПродукции.ТипУпаковки КАК ТипУпаковки
	               |ИЗ
	               |	Документ.ПередачаОбъектовОС.КодыУпаковокМаркируемойПродукции КАК ПередачаОбъектовОСКодыУпаковокМаркируемойПродукции
	               |ГДЕ
	               |	ПередачаОбъектовОСКодыУпаковокМаркируемойПродукции.Ссылка = &Ссылка
