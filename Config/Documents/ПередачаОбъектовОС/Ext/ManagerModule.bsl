// Формирует данные табличной части (ТЧ) документа для проверки остатков в функции ПолучитьОстаткиОСЗабаланс
// общего модуля БухгалтерскиеОперацииПовтИсп
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ПередачаОбъектовОС - документ, для которого собираем данные ТЧ
//
// Возвращаемое значение:
//  - ТаблицаЗначений - таблица, содержащая данные ТЧ 
Функция ДанныеТЧдляПроверкиОстатковЗабалансомВТО(ДокументСсылка) Экспорт
	ДоговорВТабличнойЧасти = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ДоговорВТабличнойЧасти");
	
	Если ДоговорВТабличнойЧасти Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.Количество КАК Количество,
		|	ОсновныеСредства.Всего КАК Сумма,
		|	ОсновныеСредства.СчетУчета КАК СчетУчета,
		|	ОсновныеСредства.Ссылка.Контрагент КАК Контрагент,
		|	ОсновныеСредства.Договор КАК Договор
		|ПОМЕСТИТЬ ТабЧасть
		|ИЗ
		|	Документ.ПередачаОбъектовОС.ОсновныеСредства КАК ОсновныеСредства
		|ГДЕ
		|	ОсновныеСредства.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕПСБУВидыСубконто.Ссылка,
		|	МАКСИМУМ(выбор
		|		когда ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
		|			тогда ИСТИНА
		|		иначе ЛОЖЬ
		|	конец) КАК ЕстьДоговоры,		
		|	МАКСИМУМ(выбор
		|		когда ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
		|			тогда ИСТИНА
		|		иначе ЛОЖЬ
		|	конец) КАК ЕстьКонтрагенты
		|ПОМЕСТИТЬ Счета
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|ГДЕ
		|	ЕПСБУВидыСубконто.Ссылка В
		|		(ВЫБРАТЬ
		|			Таб.СчетУчета
		|		ИЗ
		|			ТабЧасть КАК Таб)
		|	И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
		|	ИЛИ ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты))
		|СГРУППИРОВАТЬ ПО
		|	ЕПСБУВидыСубконто.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабЧасть.НомерСтроки КАК НомерСтроки,
		|	ТабЧасть.ОсновноеСредство КАК ОсновноеСредство,
		|	ТабЧасть.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТабЧасть.КПС КАК КПС,
		|	ТабЧасть.Количество КАК Количество,
		|	ТабЧасть.Сумма КАК Сумма,
		|	ТабЧасть.СчетУчета КАК СчетУчета,
		|	ВЫБОР
		|		КОГДА НЕ Счета.ЕстьКонтрагенты
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|		ИНАЧЕ ТабЧасть.Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА НЕ Счета.ЕстьДоговоры
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		|		ИНАЧЕ ТабЧасть.Договор
		|	КОНЕЦ КАК Договор
		|ИЗ
		|	ТабЧасть КАК ТабЧасть
		|		ЛЕВОЕ СОЕДИНЕНИЕ Счета КАК Счета
		|		ПО Счета.Ссылка = ТабЧасть.СчетУчета
		|";
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.Количество КАК Количество,
		|	ОсновныеСредства.Всего КАК Сумма,
		|	ОсновныеСредства.СчетУчета КАК СчетУчета
		|ИЗ
		|	Документ.ПередачаОбъектовОС.ОсновныеСредства КАК ОсновныеСредства
		|ГДЕ
		|	ОсновныеСредства.Ссылка = &Ссылка";
	КонецЕсли;	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции	

// Подготовить таблицу расчетов по документу.
// 
// Параметры:
//  Документ - ДокументОбъект.ПередачаОбъектовОС
//  Параметры - Структура - Параметры
//  Отказ - Булево
// 
// Возвращаемое значение:
//  см. УчетРасчетов.ПустаяТаблицаРасчетовПоДокументу
Функция ПодготовитьТаблицуРасчетовПоДокументу(Документ, Параметры, Отказ) Экспорт
	ТаблицаРасчетов = УчетРасчетов.ПустаяТаблицаРасчетовПоДокументу();
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.Код КАК Код
	|ПОМЕСТИТЬ Счета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код В (""205.71"", ""205.72"", ""205.73"")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЛОЖЬ КАК ЭтоПоступление,
	|	ОсновныеСредства.Ссылка.ИФО КАК ИФО,
	|	ОсновныеСредства.Ссылка.КФО КАК КФО,
	|	&КПСДоходов КАК КПС,
	|	ОсновныеСредства.Ссылка.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ОсновноеСредство.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.НПА)
	|			ТОГДА ""205.73""
	|		КОГДА ОсновныеСредства.ОсновноеСредство.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.НМА)
	|			ТОГДА ""205.72""
	|		ИНАЧЕ ""205.71""
	|	КОНЕЦ КАК КодСчета,
	|	ОсновныеСредства.Ссылка.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.Ссылка.ДоговорВТабличнойЧасти
	|			ТОГДА ОсновныеСредства.Договор
	|		ИНАЧЕ ОсновныеСредства.Ссылка.Договор
	|	КОНЕЦ КАК Договор,
	|	&Валюта КАК Валюта,
	|	ОсновныеСредства.Всего КАК Сумма,
	|	ОсновныеСредства.СуммаНДС КАК СуммаНДС
	|ПОМЕСТИТЬ ТЧ
	|ИЗ
	|	&ВидДокумента КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &ДокументСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧ.ЭтоПоступление КАК ЭтоПоступление,
	|	ТЧ.ИФО КАК ИФО,
	|	ТЧ.КФО КАК КФО,
	|	ТЧ.КПС КАК КПС,
	|	ТЧ.Подразделение КАК Подразделение,
	|	ЕСТЬNULL(Счета.Ссылка, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетРасчетов,
	|	ЕСТЬNULL(Счет_КЭК.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭК,
	|	ТЧ.Контрагент КАК Контрагент,
	|	ТЧ.Договор КАК Договор,
	|	ТЧ.Валюта КАК Валюта,
	|	ТЧ.Сумма КАК СуммаРасчетов,
	|	ТЧ.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	ТЧ КАК ТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Счета КАК Счета
	|		ПО ТЧ.КодСчета = Счета.Код
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СоответствияСчетКЭК.Счет КАК Счет,
	|			СоответствияСчетКЭК.КЭК КАК КЭК
	|		ИЗ
	|			РегистрСведений.СоответствияАналитическихСчетовКЭК КАК СоответствияСчетКЭК) КАК Счет_КЭК
	|		ПО Счета.Ссылка = Счет_КЭК.Счет";
	
	ВидДокумента = "Документ." + Документ.Метаданные().Имя + ".ОсновныеСредства";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидДокумента", ВидДокумента); 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументСсылка", Документ.Ссылка);
	Запрос.УстановитьПараметр("Валюта", Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("КПСДоходов", Параметры.КПС);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаРасчетов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
//		НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(НоваяСтрока.СчетРасчетов);
	КонецЦикла;	
	
	ТаблицаРасчетов.Свернуть(
		"ЭтоПоступление, ИФО, КФО, КПС, Подразделение, КЭК, СчетРасчетов, Контрагент, Договор, Валюта",
		"СуммаНДС, СуммаРасчетов");
	
	Возврат ТаблицаРасчетов;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	//При выбытии ОС с прослеживаемыми товарами таблицы движений готовятся раньше
	Если СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПередачаОбъектовОС.Ссылка КАК Ссылка,
	|	ПередачаОбъектовОС.КФО КАК КФО,
	|	ПередачаОбъектовОС.ВидОперации КАК ВидОперации,
	|	ПередачаОбъектовОС.ВидИмущества КАК ВидИмущества,
	|	ПередачаОбъектовОС.Дата КАК Дата,
	|	ПередачаОбъектовОС.Номер КАК Номер,
	|	ПередачаОбъектовОС.Организация КАК Организация,
	|	ПередачаОбъектовОС.Договор КАК Договор,
	|	ПередачаОбъектовОС.Контрагент КАК Контрагент,
	|	ПередачаОбъектовОС.ПередачаЧастейОбъектов КАК ПередачаЧастейОбъектов,
	|	ПередачаОбъектовОС.ДоговорВТабличнойЧасти КАК ДоговорВТабличнойЧасти,
	|	ПередачаОбъектовОС.Резервировать КАК Резервировать
	|ИЗ
	|	Документ.ПередачаОбъектовОС КАК ПередачаОбъектовОС
	|ГДЕ
	|	ПередачаОбъектовОС.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДатыПроведенияДокументов.ДатаПроведения КАК ДатаПроведения
	|ИЗ
	|	РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|ГДЕ
	|	ДатыПроведенияДокументов.Документ = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Результат = Запрос.ВыполнитьПакет();
	
	РеквизитыДокумента = Новый Структура();
	ДанныеДокумента = Результат[0].Выгрузить();
	Если ДанныеДокумента.Количество() > 0 Тогда
		Для каждого ТекКолонка из ДанныеДокумента.Колонки Цикл
			РеквизитыДокумента.Вставить(ТекКолонка.Имя, ДанныеДокумента[0][ТекКолонка.Имя]);
		КонецЦикла;	
	КонецЕсли;	
	
	Если РеквизитыДокумента.Резервировать Тогда
		Возврат;
	КонецЕсли;	
	
	// Если задана дата проведения, будем использовать ее в запросах
	ВыборкаДатаПроведения = Результат[1].Выбрать();
	Если ВыборкаДатаПроведения.Следующий() И ЗначениеЗаполнено(ВыборкаДатаПроведения.ДатаПроведения) Тогда
		РеквизитыДокумента.Вставить("Дата", ВыборкаДатаПроведения.ДатаПроведения);
	КонецЕсли;	
	
	ПараметрыСписания = УправлениеОсновнымиСредствами.ПараметрыСписанияОСПоРегистрамНакопления(РеквизитыДокумента.ВидОперации);
	ПараметрыСписания.ПередачаЧастейОбъектов = РеквизитыДокумента.ПередачаЧастейОбъектов;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"			, ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента"	, НСтр("ru = 'Акт о приеме-передаче объектов НФА'"));
	Запрос.УстановитьПараметр("НомерДокумента"	, ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, РеквизитыДокумента.Номер));
	
	ЭтоПередачаВПользование = УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(РеквизитыДокумента.ВидОперации);
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ТаблицаОсновныеСредства", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Ссылка.Номер КАК Номер,
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|		ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК ДатаСписанияСБухУчета,
	|	ТаблицаОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.Ссылка.Подразделение КАК Подразделение,
	|	ТаблицаОсновныеСредства.Ссылка.ПодразделениеПолучатель КАК ПодразделениеПолучатель,
	|	ТаблицаОсновныеСредства.Ссылка.ЦМО КАК ЦМО,
	|	ТаблицаОсновныеСредства.Ссылка.ЦМОПолучатель КАК ЦМОПолучатель,
	|	ТаблицаОсновныеСредства.Ссылка.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА
	|			ТаблицаОсновныеСредства.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование)
	|		ИЛИ ТаблицаОсновныеСредства.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении)
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.Договор
	|		ИНАЧЕ &ПустойДоговор_ПодЗамену
	|	КОНЕЦ КАК Договор,
	|	ТаблицаОсновныеСредства.Ссылка.ВидОперации КАК ВидОперации,
	|	ЕСТЬNULL(ТаблицаОсновныеСредства.Ссылка.ПервичныйДокумент.ВидПервичногоДокумента, &ИмяДокумента) КАК
	|		НазваниеДокумента,
	|	&НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.Ссылка.Дата КАК ДатаДокумента,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.Количество КАК Количество,
	|	ТаблицаОсновныеСредства.Сумма КАК Сумма,
	|	ТаблицаОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ТаблицаОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения,
	|	ТаблицаОсновныеСредства.СуммаАмортизацииЗаТекущийМесяц КАК СуммаАмортизацииЗаТекущийМесяц,
	|	ТаблицаОсновныеСредства.ПричинаСписания КАК ПричинаСписания,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|		ИЛИ НЕ ТаблицаОсновныеСредства.ОсновноеСредство.ГрупповойУчет
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПообъектныйУчет,
	|	ТаблицаОсновныеСредства.СчетУчета КАК СчетУчета,
	|	ТаблицаОсновныеСредства.Ссылка.ПередачаЧастейОбъектов КАК ПередачаЧастейОбъектов
	|ПОМЕСТИТЬ ТаблицаОсновныеСредства
	|ИЗ
	|	Документ.ПередачаОбъектовОС.ОсновныеСредства КАК ТаблицаОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ТаблицаОсновныеСредства.Ссылка)
	|ГДЕ
	|	ТаблицаОсновныеСредства.Ссылка = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер";
	
	Если РеквизитыДокумента.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС") 
		И РеквизитыДокумента.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ПраваПользованияНМА") Тогда
		УправлениеОсновнымиСредствами.ДополнитьТекстЗапросаДоговоромИзРНСтоимостьОС(Запрос, РеквизитыДокумента);
		
	ИначеЕсли ЗначениеЗаполнено(ПараметрыСписания.ВидРаспоряженияУКонтрагента) Тогда
		
		Если ЭтоПередачаВПользование Тогда
			УправлениеОсновнымиСредствами.ДополнитьТекстЗапросаДоговоромИзРНСтоимостьОС(Запрос, РеквизитыДокумента);
		ИначеЕсли РеквизитыДокумента.ДоговорВТабличнойЧасти Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПустойДоговор_ПодЗамену", "ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаОсновныеСредства.Ссылка.Контрагент", 
			"ВЫБОР
			|		КОГДА НЕ ОстаткиПоКонтрагентам.Контрагент ЕСТЬ NULL
			|			ТОГДА ОстаткиПоКонтрагентам.Контрагент
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
			|	КОНЕЦ");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаОсновныеСредства.Ссылка.Договор", 
			"ВЫБОР
			|		КОГДА НЕ ОстаткиПоКонтрагентам.Договор ЕСТЬ NULL
			|			ТОГДА ОстаткиПоКонтрагентам.Договор
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
			|	КОНЕЦ");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ", "
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
			|				&Период,
			|				Организация = &Организация
			|					И ОсновноеСредство В 
			|						(ВЫБРАТЬ 
			|							ВТ.ОсновноеСредство 
			|						ИЗ Документ.ПередачаОбъектовОС.ОсновныеСредства КАК ВТ 
			|						ГДЕ ВТ.Ссылка = &Ссылка)
			|					И ВидРаспоряжения = &ВидРаспКонтр
			|                   И Контрагент = &Контрагент
			|					) КАК ОстаткиПоКонтрагентам
			|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = ОстаткиПоКонтрагентам.ОсновноеСредство
			|			И ТаблицаОсновныеСредства.ИнвентарныйНомер = ОстаткиПоКонтрагентам.ИнвентарныйНомер
			|			И ТаблицаОсновныеСредства.Ссылка.Контрагент = ОстаткиПоКонтрагентам.Контрагент
			|			И ТаблицаОсновныеСредства.Договор = ОстаткиПоКонтрагентам.Договор
			|ГДЕ");
			
			Запрос.УстановитьПараметр("Контрагент", РеквизитыДокумента.Контрагент);
			
			Запрос.УстановитьПараметр("Период"			, РеквизитыДокумента.Дата);
			Запрос.УстановитьПараметр("Организация"		, РеквизитыДокумента.Организация);
			Запрос.УстановитьПараметр("ВидРаспКонтр"	, ПараметрыСписания.ВидРаспоряженияУКонтрагента);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПустойДоговор_ПодЗамену", "ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаОсновныеСредства.Ссылка.Контрагент", "ОстаткиПоКонтрагентам.Контрагент");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаОсновныеСредства.Ссылка.Договор", "ОстаткиПоКонтрагентам.Договор");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ", "
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
			|				&Период,
			|				Организация = &Организация
			|					И ОсновноеСредство В (ВЫБРАТЬ ВТ.ОсновноеСредство ИЗ Документ.ПередачаОбъектовОС.ОсновныеСредства КАК ВТ ГДЕ ВТ.Ссылка = &Ссылка)
			|					И ВидРаспоряжения = &ВидРаспКонтр
			|                   И Контрагент = &Контрагент
			|                   И Договор = &Договор
			|					) КАК ОстаткиПоКонтрагентам
			|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = ОстаткиПоКонтрагентам.ОсновноеСредство
			|			И ТаблицаОсновныеСредства.ИнвентарныйНомер = ОстаткиПоКонтрагентам.ИнвентарныйНомер
			|ГДЕ");
			
			Запрос.УстановитьПараметр("Контрагент", РеквизитыДокумента.Контрагент);
			Запрос.УстановитьПараметр("Договор", РеквизитыДокумента.Договор);
			
			Запрос.УстановитьПараметр("Период"			, РеквизитыДокумента.Дата);
			Запрос.УстановитьПараметр("Организация"		, РеквизитыДокумента.Организация);
			Запрос.УстановитьПараметр("ВидРаспКонтр"	, ПараметрыСписания.ВидРаспоряженияУКонтрагента);
		КонецЕсли;  
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПустойДоговор_ПодЗамену", "ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)");
	КонецЕсли;
	
	НомераТаблиц.Вставить("СобытияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК Период,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание) КАК Событие,
	|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК ДатаСобытия,
	|	ТаблицаОсновныеСредства.ПричинаСписания КАК ПричинаСписания,
	|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.ПообъектныйУчет
	|	И (ТаблицаОсновныеСредства.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС)
	|	ИЛИ ТаблицаОсновныеСредства.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОС)
	|	ИЛИ (ТаблицаОсновныеСредства.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении)
	|	И ТаблицаОсновныеСредства.СчетУчета = &СчетНеАктивов))";
	
	Запрос.УстановитьПараметр("СчетНеАктивов", 
		БухгалтерскийУчет.СчетПоКоду("02.3", РеквизитыДокумента.Дата, РеквизитыДокумента.Организация));
	
	// Движения по регистрам СтоимостьОбъектовОС и АмортизацияОбъектовОС.
	УправлениеОсновнымиСредствами.ДобавитьТаблицыСписанияОСПоРегистрамНакопления(Запрос, НомераТаблиц,
		ДокументСсылка, ПараметрыСписания);
	
	#Область УчетДрагМатериалов
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц);
	#КонецОбласти
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
	
	Если ЭтоПередачаВПользование Тогда
		Для Каждого СтрокаТаблицы Из СтруктураДополнительныеСвойства.ТаблицыДляДвижений["СтоимостьОбъектовОСПоКонтрагентам"] Цикл
			СтрокаТаблицы.Договор = Справочники.Договоры.ПустаяСсылка();
		КонецЦикла;
	КонецЕсли;
	
	УчетНДСРаздельный.ДобавитьДвиженияНеоблагаемыеНДСОперации(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("НаличиеДрагМатериаловВОбъектахНФА", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ПередачаОбъектовОСДрагоценныеМатериалы.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	ПередачаОбъектовОСДрагоценныеМатериалы.Ссылка КАК Регистратор,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ПередачаОбъектовОСДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	|	ПередачаОбъектовОСДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(ПередачаОбъектовОСДрагоценныеМатериалы.Ссылка КАК Документ.ПередачаОбъектовОС).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений)
	|				ИЛИ ВЫРАЗИТЬ(ПередачаОбъектовОСДрагоценныеМатериалы.Ссылка КАК Документ.ПередачаОбъектовОС).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106)
	|			ТОГДА ПередачаОбъектовОСДрагоценныеМатериалы.ОбъектМЦ
	|		ИНАЧЕ ПередачаОбъектовОСДрагоценныеМатериалы.ОбъектНФА
	|	КОНЕЦ КАК ОбъектНФА,
	|	ВЫБОР
