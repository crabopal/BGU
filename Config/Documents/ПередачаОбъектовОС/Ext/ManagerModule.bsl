КонецПроцедуры

#КонецОбласти

#Область ВводНаОсновании

// Формирует таблицу разделителей для формирования нескольких документов "Передача объектов ОС" на основании одного документа
// "Принятие к учету ОС, НМА, НПА"                  
// 
// Параметры:
//  - ДокОснование - ДокументСсылка - документ-основание
//
// Возвращаемое значение:
// 	Структура
//  * Разделители - ТаблицаЗначений
//  * ЗаголовкиКолонок - Структура
Функция ТаблицаРазделителейДокументов_ПринятиеКУчетуОС(ДокОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДокОснование, "ВидПоступления, ВидИмуществаВТабличнойЧасти");
	
	СтруктураРазделителей = Новый Структура("Разделители, ЗаголовкиКолонок");
	Если РеквизитыДокумента.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАЗабаланс Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТЧОсновныеСредства.ВидИмущества КАК ВидИмущества,
		|	ТЧОсновныеСредства.СчетУчета КАК СчетУчета,
		|	СУММА(ТЧОсновныеСредства.Количество) КАК Количество
		|ПОМЕСТИТЬ ОС_УжеПереданные
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|		ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|		ТЧОсновныеСредства.Ссылка.ВидИмущества КАК ВидИмущества,
		|		ВЫБОР
		|			КОГДА ТЧОсновныеСредства.СчетУчета В ИЕРАРХИИ (&Счет01)
		|				ТОГДА &Счет01
		|			ИНАЧЕ &Счет02
		|		КОНЕЦ КАК СчетУчета,
		|		ТЧОсновныеСредства.Количество КАК Количество
		|	ИЗ
		|		Документ.ПередачаОбъектовОС.ОсновныеСредства КАК ТЧОсновныеСредства
		|	ГДЕ
		|		ТЧОсновныеСредства.Ссылка.ДокументОснование = &Ссылка
		|		И НЕ ТЧОсновныеСредства.Ссылка.ПометкаУдаления
		|		И (&НетСсылкиЦелевогоДокумента 
		|			ИЛИ ТЧОсновныеСредства.Ссылка <> &СсылкаЦелевогоДокумента)) КАК ТЧОсновныеСредства
		|СГРУППИРОВАТЬ ПО		
		|	ТЧОсновныеСредства.ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер,
		|	ТЧОсновныеСредства.ВидИмущества,
		|	ТЧОсновныеСредства.СчетУчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТЧОсновныеСредства.ВидИмущества КАК ВидИмущества,
		|	ВЫБОР
		|		КОГДА ТЧОсновныеСредства.СчетУчетаОС В ИЕРАРХИИ (&Счет01)
		|			ТОГДА &Счет01
		|		ИНАЧЕ &Счет02
		|	КОНЕЦ КАК СчетУчета,
		|	ТЧОсновныеСредства.Количество КАК Количество
		|ПОМЕСТИТЬ ОС_НужноПередать
		|ИЗ
		|	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ТЧОсновныеСредства
		|ГДЕ
		|	ТЧОсновныеСредства.Ссылка = &Ссылка
		|	И ТЧОсновныеСредства.Ссылка.ВидИмуществаВТабличнойЧасти
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТЧОсновныеСредства.Ссылка.ВидИмущества КАК ВидИмущества,
		|	ВЫБОР
		|		КОГДА ТЧОсновныеСредства.СчетУчетаОС В ИЕРАРХИИ (&Счет01)
		|			ТОГДА &Счет01
		|		ИНАЧЕ &Счет02
		|	КОНЕЦ КАК СчетУчета,
		|	ТЧОсновныеСредства.Количество КАК Количество
		|ИЗ
		|	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ТЧОсновныеСредства
		|ГДЕ
		|	ТЧОсновныеСредства.Ссылка = &Ссылка
		|	И НЕ ТЧОсновныеСредства.Ссылка.ВидИмуществаВТабличнойЧасти
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОС_НужноПередать.ОсновноеСредство КАК ОсновноеСредство,
		|	ОС_НужноПередать.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОС_НужноПередать.ВидИмущества КАК ВидИмущества,
		|	ОС_НужноПередать.СчетУчета КАК СчетУчета,
		|	СУММА(ОС_НужноПередать.Количество - ЕСТЬNULL(ОС_УжеПереданные.Количество, 0)) КАК Количество
		|ПОМЕСТИТЬ ТЧОсновныеСредства
		|ИЗ
		|	ОС_НужноПередать КАК ОС_НужноПередать
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОС_УжеПереданные КАК ОС_УжеПереданные
		|		ПО ОС_НужноПередать.ОсновноеСредство = ОС_УжеПереданные.ОсновноеСредство
		|		И ОС_НужноПередать.ИнвентарныйНомер = ОС_УжеПереданные.ИнвентарныйНомер
		|		И ОС_НужноПередать.ВидИмущества = ОС_УжеПереданные.ВидИмущества
		|		И ОС_НужноПередать.СчетУчета = ОС_УжеПереданные.СчетУчета
		|СГРУППИРОВАТЬ ПО
		|	ОС_НужноПередать.ОсновноеСредство,
		|	ОС_НужноПередать.ИнвентарныйНомер,
		|	ОС_НужноПередать.ВидИмущества,
		|	ОС_НужноПередать.СчетУчета
		|ИМЕЮЩИЕ
		|	СУММА(ОС_НужноПередать.Количество - ЕСТЬNULL(ОС_УжеПереданные.Количество, 0)) > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЧОсновныеСредства.ВидИмущества КАК ВидИмущества,
		|	ТЧОсновныеСредства.СчетУчета КАК СчетУчета
		|ИЗ
		|	ТЧОсновныеСредства КАК ТЧОсновныеСредства
		|СГРУППИРОВАТЬ ПО
		|	ТЧОсновныеСредства.ВидИмущества,
		|	ТЧОсновныеСредства.СчетУчета";
		
		СтруктураРазделителей.Вставить("ЗаголовкиКолонок", 
			Новый Структура("ВидИмущества, СчетУчета", "Вид имущества", "Счет учета"));
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТЧОсновныеСредства.Ссылка.ВидИмущества КАК ВидИмущества,
		|	СУММА(ТЧОсновныеСредства.Количество) КАК Количество
		|ПОМЕСТИТЬ ОС_УжеПереданные
		|ИЗ
		|	Документ.ПередачаОбъектовОС.ОсновныеСредства КАК ТЧОсновныеСредства
		|ГДЕ
		|	ТЧОсновныеСредства.Ссылка.ДокументОснование = &Ссылка
		|	И НЕ ТЧОсновныеСредства.Ссылка.ПометкаУдаления
		|	И (&НетСсылкиЦелевогоДокумента 
		|			ИЛИ ТЧОсновныеСредства.Ссылка <> &СсылкаЦелевогоДокумента)
		|СГРУППИРОВАТЬ ПО	
		|	ТЧОсновныеСредства.ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер,
		|	ТЧОсновныеСредства.Ссылка.ВидИмущества
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ВЫБОР
		|		КОГДА ТЧОсновныеСредства.Ссылка.ВидИмуществаВТабличнойЧасти
		|			ТОГДА ТЧОсновныеСредства.ВидИмущества
		|		ИНАЧЕ ТЧОсновныеСредства.Ссылка.ВидИмущества
		|	КОНЕЦ КАК ВидИмущества,
		|	СУММА(ТЧОсновныеСредства.Количество - ЕСТЬNULL(ОС_УжеПереданные.Количество, 0)) КАК Количество
		|ПОМЕСТИТЬ ОС_МожноПередать
		|ИЗ
		|	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ТЧОсновныеСредства
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОС_УжеПереданные КАК ОС_УжеПереданные
		|		ПО ТЧОсновныеСредства.ОсновноеСредство = ОС_УжеПереданные.ОсновноеСредство
		|		И ТЧОсновныеСредства.ИнвентарныйНомер = ОС_УжеПереданные.ИнвентарныйНомер
		|		И ТЧОсновныеСредства.ВидИмущества = ОС_УжеПереданные.ВидИмущества
		|ГДЕ
		|	ТЧОсновныеСредства.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ТЧОсновныеСредства.ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер,
		|	ВЫБОР
		|		КОГДА ТЧОсновныеСредства.Ссылка.ВидИмуществаВТабличнойЧасти
		|			ТОГДА ТЧОсновныеСредства.ВидИмущества
		|		ИНАЧЕ ТЧОсновныеСредства.Ссылка.ВидИмущества
		|	КОНЕЦ
		|ИМЕЮЩИЕ
		|	СУММА(ТЧОсновныеСредства.Количество - ЕСТЬNULL(ОС_УжеПереданные.Количество, 0)) > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОС_МожноПередать.ВидИмущества КАК ВидИмущества
		|ИЗ
		|	ОС_МожноПередать КАК ОС_МожноПередать
		|СГРУППИРОВАТЬ ПО
		|	ОС_МожноПередать.ВидИмущества";
		
		СтруктураРазделителей.Вставить("ЗаголовкиКолонок", Новый Структура("ВидИмущества", "Вид имущества"));
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	Запрос.УстановитьПараметр("Счет01", БухгалтерскийУчет.СчетПоКоду("01"));
	Запрос.УстановитьПараметр("Счет02", БухгалтерскийУчет.СчетПоКоду("02"));
	Запрос.УстановитьПараметр("СсылкаЦелевогоДокумента", СсылкаЦелевогоДокумента);
	Запрос.УстановитьПараметр("НетСсылкиЦелевогоДокумента", НЕ ЗначениеЗаполнено(СсылкаЦелевогоДокумента));
	
	ТаблицаРазделителей = Запрос.Выполнить().Выгрузить(); 
	СтруктураРазделителей.Вставить("Разделители", ТаблицаРазделителей);
	
	Возврат СтруктураРазделителей;
КонецФункции	

// Формирует таблицу разделителей для формирования нескольких документов "Передача объектов ОС" на основании одного документа
// "Поступление ОС"                  
// 
// Параметры:
//  - ДокОснование - ДокументСсылка - документ-основание
//
// Возвращает таблицу значений с полями:
//  * КФО - ПеречислениеСсылка.КФО
//  * ВидИмущества - ПеречислениеСсылка.ВидыИмущества
Функция ТаблицаРазделителейДокументов_ПоступлениеОС(ДокОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	СвойстваОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОснование, "Дата, Организация");
	Счета_НедвижимоеИмущество = БухгалтерскийУчет.СписокСчетов(
		"106.10", СвойстваОбъекта.Дата,, СвойстваОбъекта.Организация);
	Счета_ДвижимоеОсобоЦенное = БухгалтерскийУчет.СписокСчетов(
		"106.20", СвойстваОбъекта.Дата,, СвойстваОбъекта.Организация);
	Счета_ИноеДвижимое = БухгалтерскийУчет.СписокСчетов(
		"106.30", СвойстваОбъекта.Дата,, СвойстваОбъекта.Организация);
	Счета_ВКонцессии = БухгалтерскийУчет.СписокСчетов(
		"106.90", СвойстваОбъекта.Дата,, СвойстваОбъекта.Организация);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТЧОсновныеСредства.КФО КАК КФО,
	|	ВЫБОР
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_НедвижимоеИмущество)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.НедвижимоеИмущество)
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_ДвижимоеОсобоЦенное)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное)
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_ИноеДвижимое)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ИноеДвижимое)
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_ВКонцессии)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ВКонцессии)
	|	КОНЕЦ КАК ВидИмущества
	|ИЗ
	|	Документ.ПоступлениеОС.КапВложения КАК ТЧОсновныеСредства
	|ГДЕ
	|	ТЧОсновныеСредства.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧОсновныеСредства.КФО,
	|	ВЫБОР
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_НедвижимоеИмущество)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.НедвижимоеИмущество)
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_ДвижимоеОсобоЦенное)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное)
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_ИноеДвижимое)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ИноеДвижимое)
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_ВКонцессии)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ВКонцессии)
	|	КОНЕЦ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	Запрос.УстановитьПараметр("Счета_НедвижимоеИмущество", Счета_НедвижимоеИмущество);
	Запрос.УстановитьПараметр("Счета_ДвижимоеОсобоЦенное", Счета_ДвижимоеОсобоЦенное);
	Запрос.УстановитьПараметр("Счета_ИноеДвижимое", Счета_ИноеДвижимое);
	Запрос.УстановитьПараметр("Счета_ВКонцессии", Счета_ВКонцессии);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

