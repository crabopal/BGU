#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

// Возвращает таблицу значений по данным табличной части документа для формирования режерва
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу()
Функция ТаблицаСписанияОСПоДокументу() Экспорт
	Возврат ТаблицаСписанияОС();
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НеПроверяемыеРеквизиты = Новый Массив;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(ВидОперации) Тогда
		
		ТаблицаОС = ОсновныеСредства.Выгрузить(, "НомерСтроки,ОсновноеСредство,ИнвентарныйНомер,Сумма,Количество");
		ДанныеПроверки = Новый Структура("Ссылка,Дата,Организация,ВидОперации,ТаблицаОС",
			Ссылка, Дата, Организация, ВидОперации, ТаблицаОС);
		
		Отказ = Не УправлениеОсновнымиСредствами.МожноПровестиПередачуОбъектовОС(ДанныеПроверки);
		
		Если Отказ Тогда
			ПроверяемыеРеквизиты.Очистить();
			Возврат;
		КонецЕсли;
		
		Если ПередачаЧастейОбъектов Тогда
			НеПроверяемыеРеквизиты.Добавить("ЦМОПолучатель");
			НеПроверяемыеРеквизиты.Добавить("ПодразделениеПолучатель");
		КонецЕсли;	
		
	Иначе
		
		НеПроверяемыеРеквизиты.Добавить("ЦМОПолучатель");
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеПолучатель");
		
	КонецЕсли;
	
	Если ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОС
		Или ВидОперации = Перечисления.ВидыОперацийПередачиОС.РеализацияСобственныхОС Тогда
		НеПроверяемыеРеквизиты.Добавить("Контрагент");
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет
		Или ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетВУправление
		Или ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда
		Или ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование
		Или ВидОперации = Перечисления.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет Тогда
		НеПроверяемыеРеквизиты.Добавить("Контрагент");
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаКапвложений Тогда
		НеПроверяемыеРеквизиты.Добавить("ЦМО");
		НеПроверяемыеРеквизиты.Добавить("Контрагент");
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106 Тогда
		НеПроверяемыеРеквизиты.Добавить("ЦМО");
		НеПроверяемыеРеквизиты.Добавить("ОсновныеСредства.СтоимостьЕдиницы");
	КонецЕсли;
	
	Если ВидОперации <> Перечисления.ВидыОперацийПередачиОС.РеализацияСобственныхОС
		И ВидОперации <> Перечисления.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет Тогда
		НеПроверяемыеРеквизиты.Добавить("ВалютаДокумента");
	КонецЕсли;
	
	СписокСчетов = ОсновныеСредства.ВыгрузитьКолонку("СчетУчета");
	СвойстваСчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СписокСчетов, "УчетПоКПС");
	УчетПоКПС = Ложь;
	Для Каждого ДанныеСчета Из СвойстваСчетов Цикл
		Если ДанныеСчета.Значение Тогда
			УчетПоКПС = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не УчетПоКПС Тогда
		НеПроверяемыеРеквизиты.Добавить("ОсновныеСредства.КПС");
	КонецЕсли;
	Если Не БухгалтерскийУчет.ПодразделениеОбязательно(СписокСчетов) Тогда
		НеПроверяемыеРеквизиты.Добавить("Подразделение");
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеПолучатель");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
	
	Если НЕ ПередачаЧастейОбъектов Тогда
		УправлениеОсновнымиСредствами.ПроверитьДублиИнвентарныхНомеровВТабЧасти(ЭтотОбъект, "ОсновныеСредства", Отказ);
	КонецЕсли;	
	
	Для каждого СтрокаТаблицы Из ОсновныеСредства Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомер) и СтрокаТаблицы.Количество>1 Тогда
			ТекстПредупреждения = НСтр("ru='Для объектов с присвоенным инвентарным номером количество должно быть равно 1.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстПредупреждения,,
				"Объект.ОсновныеСредства["+(СтрокаТаблицы.НомерСтроки-1)+"].Количество",,Отказ);
		КонецЕсли;
		
		Если ОбслуживаниеКарточекКапвложений.ЭтоСчетКапвложений(СтрокаТаблицы.СчетУчета) 
			И СтрокаТаблицы.ОтразитьВКарточкеКапвложений И НЕ ЗначениеЗаполнено(СтрокаТаблицы.КарточкаКапвложений) Тогда
			ТекстПредупреждения = НСтр("ru='Если в колонке ""Отразить в карточке капвложений"" включен флажок,
				|должна быть заполнена карточка капвложений.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстПредупреждения,,
				"Объект.ОсновныеСредства[" + (СтрокаТаблицы.НомерСтроки - 1) + "].КарточкаКапвложений",,Отказ);
		КонецЕсли;
	
	КонецЦикла;
	
	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СписаниеОбъектовОС") Тогда
		ЗаполнитьПо_СписаниеОбъектовОС(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("ВводНаОсновании") И ДанныеЗаполнения.ВводНаОсновании Тогда
			Если ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ПоступлениеОС") Тогда
				ЗаполнитьПо_ПоступлениеОС(ДанныеЗаполнения);
			ИначеЕсли ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС") Тогда
				ЗаполнитьПо_ПринятиеКУчетуОС(ДанныеЗаполнения);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Для Каждого ТекСтрока Из ОсновныеСредства Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ИдентификаторСтроки) Тогда
			ТекСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;	
	КонецЦикла;	
	
	СуммаДокумента = ОсновныеСредства.Итог("Сумма");
	СуммаПродажиВсего = ОсновныеСредства.Итог("Всего");
	
	КонтрольИсполненияДоговоров.ОчиститьДвиженияРегистровПодсистемы(ЭтотОбъект);
	ПрослеживаемостьБГУ.УдалитьНеиспользуемыеСтрокиСведенийПрослеживаемости(ЭтотОбъект, "ОсновныеСредства");
	ПрослеживаемостьБГУ.СписаниеОСПриЗаписи(ЭтотОбъект, Отказ, РежимЗаписи);
	
	Если Не ЗначениеЗаполнено(Комиссия) Тогда
		Председатель = Справочники.Сотрудники.ПустаяСсылка();
		Для Каждого СтрокаКомиссии Из СоставКомиссии Цикл
			СтрокаКомиссии.Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
			СтрокаКомиссии.Отсутствует = Ложь;
		КонецЦикла;
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения И НЕ ПометкаУдаления Тогда 
		ЕстьОшибки = ЕстьПроблемыСписания();
		Если ЕстьОшибки Тогда
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;		
	Если НЕ ЕстьОшибки Тогда
		УправлениеОсновнымиСредствами.ДокументПередЗаписью(ЭтотОбъект, РежимЗаписи, Отказ);
	КонецЕсли;		
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	Если НЕ Резервировать Тогда
		ПрослеживаемостьБГУ.ОбработкаПроведения(ЭтотОбъект);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	
	ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА, ИнвНомер");
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ИнвНомер");
	ОбъектыДМ.Свернуть("ОбъектНФА, ИнвНомер");
	
	ЭтоПередачаКапвложений = 
		ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаКапвложений
		ИЛИ ВидОперации = Перечисления.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106;
		
	ВедетсяУчетДрагМатериаловВМЦКапвложений = ЭтоПередачаКапвложений И
		(ДрагоценныеМатериалы.Количество() > 0 ИЛИ УчетДрагМатериалов.ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений());
	
	ТаблицаВсехОбъектов = ОсновныеСредства.Выгрузить(,"СчетУчета, ОсновноеСредство, ИнвентарныйНомер");
	
	ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
	ТаблицаОбъектовНФА.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовНФА.Колонки.Добавить("ИнвентарныйНомер",Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	
	Если ЭтоПередачаКапвложений Тогда
		МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляКапвложенийСМЦ();
	Иначе
		МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляОС();
	КонецЕсли;
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовОС.Найти(ТекСтрока.СчетУчета)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		ОбъектНФА = ТекСтрока.ОбъектНФА;
		ИнвНомер = ТекСтрока.ИнвНомер;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОсновноеСредство", ОбъектНФА);
		ПараметрыОтбора.Вставить("ИнвентарныйНомер", ИнвНомер);
		НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);   
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			ПараметрыОтбораОбъекта = Новый Структура;
			ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
			ПараметрыОтбораОбъекта.Вставить("ИнвНомер", ИнвНомер);
			СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
			Если СтрокиСпискаДМ.Количество()=1 Тогда
				ТекстСтрокиДМ = "В строке ";
			Иначе
				ТекстСтрокиДМ = "В строках ";
			КонецЕсли;
			Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
				ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
			КонецЦикла;
			
			ТекстОшибки = НСтр("ru='"+Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2)+" списка ""Содержание драг. материалов"" указана информация по объекту ОС, которого нет в списке ""Основные средства"": %1'")+?(ЗначениеЗаполнено(ИнвНомер),НСтр("ru=' (инв.№: %2)'"),НСтр("ru='%2'"));
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОбъектНФА,
				ИнвНомер);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			
		КонецЕсли;
	КонецЦикла;
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	Для каждого ТекСтрока Из ОбъектыДМ Цикл
		//заполнение количества драг. камней
		Если НЕ (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
	
	//контроль содержания учетных драг. материалов в списываемых НФА
	Запрос = Новый Запрос;
	Запрос.Текст = УчетДрагМатериалов.ТекстЗапросаПроверкиЗаполненияСодержанияДрагМатериаловКапвложений(ВедетсяУчетДрагМатериаловВМЦКапвложений);
	
	Если ВедетсяУчетДрагМатериаловВМЦКапвложений Тогда 
			
		ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ОбъектМЦ, МассаДМ, КоличествоДМ");   
		
		Капвложения = ОсновныеСредства.Выгрузить(,"ОсновноеСредство, Количество");
		Капвложения.Колонки.ОсновноеСредство.Имя = "ОбъектНФА";
		
		ТаблицаОбъектовНФА = УчетДрагМатериалов.ЗаполнитьДМДляСписанияКапвложений(Организация,Капвложения, Новый Граница(Ссылка.Дата, ВидГраницы.Включая));

	Иначе
		ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ИнвНомер, МассаДМ, КоличествоДМ");  
		
		ТаблицаОбъектовНФА = ОсновныеСредства.Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер");
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДрагМатериалыДокумента", ОбъектыДМ);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОбъектыДокумента", ТаблицаОбъектовНФА);
	Запрос.УстановитьПараметр("ДатаСведений", Новый Граница(Ссылка.Дата, ВидГраницы.Включая));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстОшибки = НСтр("ru='Для объекта ""%1"" (Инв. № %2) из списка ""Основные cредства"" в учете присутствуют остатки драгоценных материалов. Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'");
		Если ЭтоПередачаКапвложений Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru='Для объекта  вложений ""%1"" из списка ""Основные cредства"" в учете присутствуют остатки драгоценных материалов по материальной ценности ""%2"". Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'"),
				Выборка.ОбъектНФА, Выборка.ОбъектМЦ);
		Иначе
			ТекстОшибки = СтрШаблон(НСтр("ru='Для объекта ""%1"" (Инв. № %2) из списка ""Основные cредства"" в учете присутствуют остатки драгоценных материалов. Следует заполнить данные списка ""Содержание драг. материалов"" на закладке ""Драгоценные материалы"" и провести документ.'"),
				Выборка.ОбъектНФА, Выборка.ИнвНомер);
		КонецЕсли;
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект");
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПо_СписаниеОбъектовОС(ДанныеЗаполнения)
	Если ДанныеЗаполнения.ВосстановитьНаБалансе Тогда
		
		пЦМО = ?(ДанныеЗаполнения.ОсновныеСредства.Количество() > 0,
			ДанныеЗаполнения.ОсновныеСредства[0].ЦМОВосстановление,
			Справочники.ЦМО.ПустаяСсылка());
		
		ВидОперации		= Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОС;
		ВидИмущества	= ДанныеЗаполнения.ВидИмущества;
		Организация		= ДанныеЗаполнения.Организация;
		ИФО				= ДанныеЗаполнения.ИФО;
		КФО				= ДанныеЗаполнения.КФО;
		ЦМО				= пЦМО;
		Подразделение	= ДанныеЗаполнения.Подразделение;
		Дата			= ДанныеЗаполнения.Дата;
		
		Для Каждого СтрокаТаблицы Из ДанныеЗаполнения.ОсновныеСредства Цикл
			
			НоваяСтрока = ОсновныеСредства.Добавить();
			НоваяСтрока.ОсновноеСредство	= СтрокаТаблицы.ОсновноеСредство;
			НоваяСтрока.ИнвентарныйНомер	= СтрокаТаблицы.ИнвентарныйНомер;
			НоваяСтрока.КПС					= СтрокаТаблицы.КПСВосстановление;
			НоваяСтрока.Количество			= СтрокаТаблицы.Количество;
			НоваяСтрока.Сумма				= СтрокаТаблицы.СуммаВосстановление;
			НоваяСтрока.СтоимостьЕдиницы	= СтрокаТаблицы.Сумма / СтрокаТаблицы.Количество;
			НоваяСтрока.СуммаАмортизации	= СтрокаТаблицы.СуммаАмортизации;
			НоваяСтрока.СчетУчета			= СтрокаТаблицы.СчетУчетаВосстановление;
			НоваяСтрока.СуммаОбесценения	= СтрокаТаблицы.СуммаОбесценения;
			
		КонецЦикла;
		
		СписокОС = ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
		ТаблицыАмортизации = УправлениеОсновнымиСредствами.РасчетАмортизацииОСиНМА(СписокОС, ЭтотОбъект, Ложь, Ложь, Ложь);
		
		Для Каждого СтрокаТаблицы Из ОсновныеСредства Цикл
			СтрокаАмортизации = ТаблицыАмортизации.ТаблицаНачисленияАмортизацииБУ.Найти(СтрокаТаблицы.ОсновноеСредство, "ОсновноеСредство");
			Если СтрокаАмортизации <> Неопределено Тогда
				СтрокаТаблицы.СуммаАмортизацииЗаТекущийМесяц = СтрокаАмортизации.СуммаАмортизацииБУ;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
КонецПроцедуры	

Процедура ЗаполнитьПо_ПоступлениеОС(ДанныеЗаполнения)
	ОсновныеСредства.Очистить();
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступлениеОС.Организация КАК Организация,
	|	ПоступлениеОС.ИФО КАК ИФО,
	|	ПоступлениеОС.Подразделение КАК Подразделение,
	|	ПоступлениеОС.ЦМО КАК ЦМО,
	|	ПоступлениеОС.Контрагент КАК Контрагент,
	|	ПоступлениеОС.Договор КАК Договор,
	|	ПоступлениеОС.СуммаВключаетНДС КАК СуммаВключаетНДС
	|ИЗ
	|	Документ.ПоступлениеОС КАК ПоступлениеОС
	|ГДЕ
	|	ПоступлениеОС.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеОСКапВложения.ВнеоборотныйАктив КАК ОсновноеСредство,
	|	ПоступлениеОСКапВложения.КПС КАК КПС,
	|	ПоступлениеОСКапВложения.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ПоступлениеОСКапВложения.Количество = 0
	|			ТОГДА ПоступлениеОСКапВложения.Сумма
	|		ИНАЧЕ ПоступлениеОСКапВложения.Сумма / ПоступлениеОСКапВложения.Количество
	|	КОНЕЦ КАК ЦенаПродажи,
	|	ВЫБОР
	|		КОГДА ПоступлениеОСКапВложения.Количество = 0
	|			ТОГДА ПоступлениеОСКапВложения.Сумма
	|		ИНАЧЕ ПоступлениеОСКапВложения.Сумма / ПоступлениеОСКапВложения.Количество
	|	КОНЕЦ КАК СтоимостьЕдиницы,
	|	ПоступлениеОСКапВложения.Сумма КАК Сумма,
	|	ПоступлениеОСКапВложения.СтавкаНДС КАК СтавкаНДС,
	|	ПоступлениеОСКапВложения.СуммаНДС КАК СуммаНДС,
	|	ПоступлениеОСКапВложения.Сумма КАК СуммаПродажи,
	|	ПоступлениеОСКапВложения.Всего КАК Всего,
	|	ПоступлениеОСКапВложения.СчетУчета КАК СчетУчета,
	|	ПоступлениеОСКапВложения.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ПоступлениеОСКапВложения.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПоступлениеОСКапВложения.ОтразитьВКарточкеКапвложений КАК ОтразитьВКарточкеКапвложений,
	|	ПоступлениеОСКапВложения.КарточкаКапвложений КАК КарточкаКапвложений,
	|	ПоступлениеОСКапВложения.НДСКРаспределению КАК НДСКРаспределению,
	|	ПоступлениеОСКапВложения.Ссылка.ПринятьНДСКВычету КАК ПринятьНДСКВычету
	|ИЗ
	|	Документ.ПоступлениеОС.КапВложения КАК ПоступлениеОСКапВложения
	|ГДЕ
	|	ПоступлениеОСКапВложения.Ссылка = &Ссылка
	|	И ПоступлениеОСКапВложения.КФО = &КФО
	|	И ПоступлениеОСКапВложения.СчетУчета В(&СчетаУчета)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения.ДокументОснование);
	Запрос.УстановитьПараметр("КФО", ДанныеЗаполнения.Разделитель.КФО);

	ДокументОснование = ДанныеЗаполнения.ДокументОснование;    
	ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106");
	КФО = ДанныеЗаполнения.Разделитель.КФО;
	ВидИмущества = ДанныеЗаполнения.Разделитель.ВидИмущества;
	
	ДанныеОснования   = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Дата, Организация");
	Дата1 = ?(ЗначениеЗаполнено(Дата), Дата, ДанныеОснования.Дата);
	Организация1 = ?(ЗначениеЗаполнено(Организация), Организация, ДанныеОснования.Организация);
	СчетаУчета = Перечисления.ВидыИмущества.СчетаКапвложенйПоВидуИмущества(
		ДанныеЗаполнения.Разделитель.ВидИмущества, Дата1, Организация1);
	Запрос.УстановитьПараметр("СчетаУчета", СчетаУчета);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаШапка = Результат[0].Выбрать();
	Если ВыборкаШапка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШапка);
	КонецЕсли;	
	
	ВыборкаТЧ = Результат[1].Выбрать();
	Пока ВыборкаТЧ.Следующий() Цикл
		НоваяСтрока = ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаТЧ);
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ЗаполнитьПо_ПринятиеКУчетуОС(ДанныеЗаполнения)
	ОсновныеСредства.Очистить();
	
	ДокументОснование = ДанныеЗаполнения.ДокументОснование;
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДокументОснование, "ВидПоступления");
	
	ВО_ПоступленияНаБалансовыйСчет = Новый Массив;
	ВО_ПоступленияНаБалансовыйСчет.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение);
	ВО_ПоступленияНаБалансовыйСчет.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление);
	ВО_ПоступленияНаБалансовыйСчет.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс);
	ВО_ПоступленияНаБалансовыйСчет.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ВозвратИзАренды);
	ВО_ПоступленияНаБалансовыйСчет.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользования);
	ВО_ПоступленияНаБалансовыйСчет.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ВозвратИзУправления);

	ВО_ПоступлениеНФАЗабаланс = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАЗабаланс;

	ВО_ПоступленияНаСчет21 = Новый Массив;
	ВО_ПоступленияНаСчет21.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21);
	ВО_ПоступленияНаСчет21.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ВозвратИзАрендыОперУчет);
	ВО_ПоступленияНаСчет21.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользованияОперУчет);
	ВО_ПоступленияНаСчет21.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ВозвратИзУправленияОперУчет);

	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Организация КАК Организация,
	|	Док.ИФО КАК ИФО,
	|	Док.КФО КАК КФО,
	|	Док.Подразделение КАК Подразделение,
	|	Док.ЦМО КАК ЦМО,
	|	Док.ВидПоступления КАК ВидПоступления,
	|	Док.ВидИмущества КАК ВидИмущества,
	|	Док.ВидИмуществаВТабличнойЧасти КАК ВидИмуществаВТабличнойЧасти,
	|	Док.Контрагент КАК Контрагент,
	|	Док.Договор КАК Договор
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС КАК Док
	|ГДЕ
	|	Док.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабЧасть.ОсновноеСредство КАК ОсновноеСредство,
	|	ТабЧасть.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТабЧасть.КПС КАК КПС,
	|	ТабЧасть.СчетУчета КАК СчетУчета,
	|	СУММА(ТабЧасть.Количество) КАК Количество,
	|	СУММА(ТабЧасть.Сумма) КАК Сумма,
	|	СУММА(ТабЧасть.СуммаАмортизации) КАК СуммаАмортизации,
	|	СУММА(ТабЧасть.СуммаОбесценения) КАК СуммаОбесценения
	|ПОМЕСТИТЬ ОС_УжеПередано
	|ИЗ
	|	Документ.ПередачаОбъектовОС.ОсновныеСредства КАК ТабЧасть
	|ГДЕ
	|	ТабЧасть.Ссылка.ДокументОснование = &Ссылка
	|	И ТабЧасть.Ссылка.ВидИмущества = &ВидИмущества
	|	И НЕ ТабЧасть.Ссылка.ПометкаУдаления
	|	И (&НетСсылкиЦелевогоДокумента ИЛИ ТабЧасть.Ссылка <> &СсылкаЦелевогоДокумента)
	|СГРУППИРОВАТЬ ПО	
	|	ТабЧасть.ОсновноеСредство,
	|	ТабЧасть.ИнвентарныйНомер,
	|	ТабЧасть.КПС,
	|	ТабЧасть.СчетУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабЧасть.ОсновноеСредство КАК ОсновноеСредство,
	|	ТабЧасть.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТабЧасть.КПС КАК КПС,
	|	ТабЧасть.ВидИмущества КАК ВидИмущества,
	|	ТабЧасть.Количество - ЕСТЬNULL(ОС_УжеПередано.Количество, 0) КАК Количество,
	|	ВЫБОР
	|		КОГДА ТабЧасть.Количество = 0
	|			ТОГДА ТабЧасть.Сумма
	|		ИНАЧЕ ТабЧасть.Сумма / ТабЧасть.Количество
	|	КОНЕЦ КАК СтоимостьЕдиницы,
	|	ТабЧасть.Сумма - ЕСТЬNULL(ОС_УжеПередано.Сумма, 0) КАК Сумма,
	|	ТабЧасть.СуммаАмортизации - ЕСТЬNULL(ОС_УжеПередано.СуммаАмортизации, 0) КАК СуммаАмортизации,
	|	ТабЧасть.СуммаОбесценения - ЕСТЬNULL(ОС_УжеПередано.СуммаОбесценения, 0) КАК СуммаОбесценения,
	|	ТабЧасть.СчетУчетаОС КАК СчетУчета,
	|	ТабЧасть.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ТабЧасть.СтранаПроисхождения КАК СтранаПроисхождения
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ТабЧасть
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОС_УжеПередано КАК ОС_УжеПередано
	|		ПО ТабЧасть.ОсновноеСредство = ОС_УжеПередано.ОсновноеСредство
	|		И ТабЧасть.ИнвентарныйНомер = ОС_УжеПередано.ИнвентарныйНомер
	|		И ТабЧасть.КПС = ОС_УжеПередано.КПС
	|		И ТабЧасть.СчетУчетаОС = ОС_УжеПередано.СчетУчета
	|ГДЕ
	|	ТабЧасть.Ссылка = &Ссылка
	|	И (НЕ ТабЧасть.Ссылка.ВидИмуществаВТабличнойЧасти
	|	ИЛИ ТабЧасть.ВидИмущества = &ВидИмущества)
	|	И (НЕ ТабЧасть.Ссылка.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАЗабаланс)
	|	ИЛИ ТабЧасть.СчетУчетаОС В ИЕРАРХИИ (&СчетУчета))
	|	И (ТабЧасть.Количество - ЕСТЬNULL(ОС_УжеПередано.Количество, 0) > 0 
	|		ИЛИ ТабЧасть.Сумма - ЕСТЬNULL(ОС_УжеПередано.Сумма, 0) > 0)
	|	";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения.ДокументОснование);
	Запрос.УстановитьПараметр("ВидИмущества", ДанныеЗаполнения.Разделитель.ВидИмущества);
	
	Если РеквизитыДокумента.ВидПоступления = ВО_ПоступлениеНФАЗабаланс Тогда
		Запрос.УстановитьПараметр("СчетУчета", ДанныеЗаполнения.Разделитель.СчетУчета);
	Иначе
		Запрос.УстановитьПараметр("СчетУчета", Неопределено);
	КонецЕсли;		
	Запрос.УстановитьПараметр("СсылкаЦелевогоДокумента", Ссылка);
	Запрос.УстановитьПараметр("НетСсылкиЦелевогоДокумента", НЕ ЗначениеЗаполнено(Ссылка));

	Результат = Запрос.ВыполнитьПакет();
	ВыборкаШапка = Результат[0].Выбрать();
	ВыборкаТЧ = Результат[2].Выбрать();
	
	Если ВыборкаТЧ.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'По документу ""%1"" все объекты, вероятно, уже переданы'"); 
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ТекстСообщения, ДанныеЗаполнения.ДокументОснование));
		Возврат;
	КонецЕсли;	
	
	Если ВыборкаШапка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШапка,, "ВидИмущества, Контрагент, Договор");
		ВидИмущества = ДанныеЗаполнения.Разделитель.ВидИмущества;
		Если РеквизитыДокумента.ВидПоступления = ВО_ПоступлениеНФАЗабаланс Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШапка, "Контрагент, Договор");
			Если ДанныеЗаполнения.Разделитель.СчетУчета = БухгалтерскийУчет.СчетПоКоду("01") Тогда
				ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование;
			Иначе	
				ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСнаХранении;
			КонецЕсли;
		ИначеЕсли ВО_ПоступленияНаСчет21.Найти(РеквизитыДокумента.ВидПоступления) <> Неопределено Тогда
			ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет;
		Иначе	
			ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОС;
		КонецЕсли;	
	КонецЕсли;	

	Пока ВыборкаТЧ.Следующий() Цикл
		НоваяСтрока = ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаТЧ);
		Если РеквизитыДокумента.ВидПоступления = ВО_ПоступлениеНФАЗабаланс Тогда
			НоваяСтрока.Договор = ВыборкаШапка.Договор;
		КонецЕсли;	
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;	
	
КонецПроцедуры	

#КонецОбласти

Функция ТаблицаСписанияОС()
	ТаблицаДока = УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу();	
	
	ТабСчетов = УправлениеОсновнымиСредствами.СвойстваСчетовДляКонтроляСписанияОС(
		ОсновныеСредства.ВыгрузитьКолонку("СчетУчета"));
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	СубконтоДоговоры = ПланыВидовХарактеристик.ВидыСубконто.Договоры;
	СубконтоКонтрагенты = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты;
	
	ЕстьДоговорВТЧ = Документы.ПередачаОбъектовОС.ЕстьДоговорВТабЧасти(ДоговорВТабличнойЧасти, ВидОперации, ВидИмущества);
	
	ЭтоВозврат01_02 = (ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСнаХранении
	ИЛИ ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование);
	
	Для каждого СтрокаТЧ из ОсновныеСредства Цикл
		НоваяСтрока = ТаблицаДока.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ, 
			"ОсновноеСредство, ИнвентарныйНомер, СчетУчета, Количество, Сумма, НомерСтроки");
		
		СтрокаСчета = ТабСчетов.Найти(СтрокаТЧ.СчетУчета, "Счет");
		Если СтрокаСчета.УчетПоЦМО Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтотОбъект, "Организация, КФО, ЦМО, ПередачаЧастейОбъектов");
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтотОбъект, "Организация, КФО, ПередачаЧастейОбъектов");
		КонецЕсли;	
		
		СтрокаСчета = ТабСчетов.Найти(СтрокаТЧ.СчетУчета, "Счет");
		
		Если ЭтоВозврат01_02 Тогда
			Если СтрокаСчета.ВидДопАналитики = СубконтоДоговоры Тогда
				Если ЕстьДоговорВТЧ Тогда
					Если ЗначениеЗаполнено(СтрокаТЧ.Договор) Тогда
						НоваяСтрока.ДопАналитика = СтрокаТЧ.Договор;
					КонецЕсли;	
				Иначе	
					Если ЗначениеЗаполнено(Договор) Тогда
						НоваяСтрока.ДопАналитика = Договор;
					КонецЕсли;	
				КонецЕсли;	
			ИначеЕсли СтрокаСчета.ВидДопАналитики = СубконтоКонтрагенты И ЗначениеЗаполнено(Контрагент) Тогда
				НоваяСтрока.ДопАналитика = Контрагент;
			КонецЕсли;	
		КонецЕсли;	
		
		Если СтрокаСчета.УчетПоКПС Тогда
			НоваяСтрока.КПС = СтрокаТЧ.КПС;
		КонецЕсли;	
		Если СтрокаСчета.УчетПоПодразделениям И УчетПоПодразделениям Тогда
			НоваяСтрока.Подразделение = Подразделение;
		КонецЕсли;	
		Если УчетПоИФО Тогда
			НоваяСтрока.ИФО = ИФО;
		КонецЕсли;	
	КонецЦикла;
		
	// Теперь нужно заполнить ДопАналитику по остаткам, если она есть на счетах. Например, если передача идет
	// по счетам 111.60, то там может быть договор	
	УправлениеОсновнымиСредствами.ЗаполнитьДопАналитикуВТаблицеСписанияОС(ТабСчетов, ТаблицаДока, ЭтотОбъект);
	
	Возврат ТаблицаДока;	
КонецФункции	

Функция ЕстьПроблемыСписания()
	ЕстьОшибки = Ложь;
	
	ТаблицаДока = ТаблицаСписанияОС();

	МассивВОсКонтролемОбременений = Новый Массив;
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОС);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийПередачиОС.РеализацияСобственныхОС);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийПередачиОС.ПередачаОСАренда);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийПередачиОС.ПередачаОСвПользование);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийПередачиОС.ПередачаОСвУправление);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование);
	МассивВОсКонтролемОбременений.Добавить(Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетВУправление);
	ЕстьОшибки = УправлениеОсновнымиСредствами.ЕстьПроблемыСписания_ОстаткиРезервыОбременения(ТаблицаДока, ЭтотОбъект, 
		МассивВОсКонтролемОбременений.Найти(ВидОперации) <> Неопределено);
	
	Возврат ЕстьОшибки;
КонецФункции		
	
#КонецОбласти

#КонецЕсли
