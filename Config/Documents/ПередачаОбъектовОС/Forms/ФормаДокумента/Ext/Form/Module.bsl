&НаКлиенте
Процедура ЗаполнитьПоКонтракту(Команда)
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоКонтрактуПослеВопроса", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			НСтр("ru='Перед заполнением табличная часть будет очищена. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет, ,
			КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьПоКонтрактуПослеВопроса(КодВозвратаДиалога.Да, Неопределено);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
КонецПроцедуры

