&НаСервере
Функция ПараметрыПолученияУчетныхДанных(ТаблицаОС)
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.ПараметрыДляРасчетаУчетныхДанных();
	ЗаполнитьЗначенияСвойств(ПараметрыПолученияОстатков, Объект);
	ПараметрыПолученияОстатков.ТаблицаОС = ТаблицаОС;
	Дата = НачалоДня(Объект.Дата);
	Счета = Новый Массив;
	Если Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда
		ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование
		ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетВУправление
		ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет
		ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет Тогда
		Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("21", Дата));
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСАренда 
		ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСвПользование
		ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСвУправление
		ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОС
		ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.РеализацияСобственныхОС Тогда
		Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("101.00", Дата));
		Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("102.00", Дата));
		Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("103.00", Дата));
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106
		ИЛИ Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаКапвложений Тогда
		Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("106.00", Дата));
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСнаХранении Тогда
		Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("02", Дата));
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование Тогда
		Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("01", Дата));
	КонецЕсли;	
	ПараметрыПолученияОстатков.Счета = Счета;
	
	Возврат ПараметрыПолученияОстатков;
КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокуТЧ(ТекСтрока, ТабОстатков)
	Если ЗначениеЗаполнено(ТекСтрока.ИнвентарныйНомер) Тогда
		СтруктураПоиска = Новый Структура("ОсновноеСредство, ИнвентарныйНомер");
	Иначе	
		СтруктураПоиска = Новый Структура("ОсновноеСредство");
	КонецЕсли;	
	ЗаполнитьЗначенияСвойств(СтруктураПоиска, ТекСтрока);
	СтрокиОстатков = ТабОстатков.НайтиСтроки(СтруктураПоиска);
	Если СтрокиОстатков.Количество() = 1 Тогда
		ДозаполнитьСтрокуТЧ(ТекСтрока, СтрокиОстатков[0]);
	ИначеЕсли СтрокиОстатков.Количество() > 1 И ЭтоВО_ВозвратС01_02(ЭтотОбъект) Тогда
		// Если получили несколько строк остатков, то возможно для этого ОС в остатках есть дополнительная аналитика
		// по контрагентам или договорам. Если это так и в шапке документа контрагент или договор заполнены, то поиск по
		// остаткам можно провести с доп. аналитикой. ЭТо верно, только для возвратов с 01 или 02 счетов. 
		// Во всех остальных случаях, Контрагент и Договор в шапке документа, это получатели, а не аналитика остатков.
		ЕстьДопАналитика = Ложь;
		Если ТипЗнч(СтрокиОстатков[0].ДопАналитика) = Тип("СправочникСсылка.Контрагенты") 
			И ЗначениеЗаполнено(Объект.Контрагент) Тогда
			СтруктураПоиска.Вставить("Контрагент", Объект.Контрагент);
			ЕстьДопАналитика = Истина;
		ИначеЕсли ТипЗнч(СтрокиОстатков[0].ДопАналитика) = Тип("СправочникСсылка.Договоры") 
			И НЕ Объект.ДоговорВТабличнойЧасти И ЗначениеЗаполнено(Объект.Договор) Тогда
			СтруктураПоиска.Вставить("Договор", Объект.Договор);
			ЕстьДопАналитика = Истина;
		КонецЕсли;
		Если ЕстьДопАналитика Тогда
			СтрокиОстатков = ТабОстатков.НайтиСтроки(СтруктураПоиска);
			Если СтрокиОстатков.Количество() = 1 Тогда
				ДозаполнитьСтрокуТЧ(ТекСтрока, СтрокиОстатков[0]);
			КонецЕсли;	
		КонецЕсли;		
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ДозаполнитьСтрокуТЧ(ТекСтрока, СтрокаОстатков)
	ЗаполнитьЗначенияСвойств(ТекСтрока, СтрокаОстатков,, "Количество, Сумма");
	
	Если ТипЗнч(СтрокаОстатков.ДопАналитика) = Тип("СправочникСсылка.Договоры") 
		И ЗначениеЗаполнено(СтрокаОстатков.ДопАналитика) Тогда
		ТекСтрока.Договор = СтрокаОстатков.ДопАналитика;
	КонецЕсли;		
	
	Если ТекСтрока.Количество = 0 ИЛИ ТекСтрока.Количество > СтрокаОстатков.Количество Тогда
		ТекСтрока.Количество = 1;
		ТекСтрока.Сумма = ТекСтрока.СтоимостьЕдиницы;
	Иначе
		ТекСтрока.Сумма = ТекСтрока.СтоимостьЕдиницы * ТекСтрока.Количество;
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти
