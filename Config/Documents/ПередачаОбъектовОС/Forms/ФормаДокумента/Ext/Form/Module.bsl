КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыТЧ(Команда)
	Реквизиты = Новый Структура;
	
	Реквизиты.Вставить("ПричинаСписания", Новый Структура);
	Реквизиты.ПричинаСписания.Вставить("ТипыДляВыбора", 
		Новый ОписаниеТипов("Строка, СправочникСсылка.ПричиныСписанияНФА"));
	Реквизиты.ПричинаСписания.Вставить("СинонимДляВыбора", НСтр("ru = 'Причина списания'")); 
	
	УправлениеНФАКлиент.ИзменитьРеквизитыСтрокТЧ(ЭтотОбъект, 
		"ПередачаОбъектовИК", "ОсновныеСредства", "ОсновныеСредства", Реквизиты);
КонецПроцедуры  

&НаКлиенте
Процедура ПодобратьСотрудников(Команда)
	
	ОбщегоНазначенияБГУКлиент.ОткрытьПодборКомиссии(Элементы.СоставКомиссии, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПредседателяКомиссии(Команда)
	
	ИменаРеквизитов = ОбщегоНазначенияБГУКлиент.СтруктураИменРеквизитовВыбораПредседателяКомиссии();
	ОбщегоНазначенияБГУКлиент.НачатьВыборПредседателяКомиссии(ЭтотОбъект, ИменаРеквизитов);
	
КонецПроцедуры

// КонтрольИсполненияДоговоров
&НаКлиенте
Процедура Подключаемый_КонтрольИсполненияДоговоровПоказатьСтатус(Команда)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ДокументСсылка", Объект.Ссылка);
	ДопПараметры.Вставить("ОтразитьВГрафикеИсполнения", Объект.ОтразитьВГрафикеИсполненияДоговора);
	ДопПараметры.Вставить("ВалютаДокумента", Объект.ВалютаДокумента);
	
	КонтрольИсполненияДоговоровКлиент.ПоказатьСтатусИсполнения(
		Объект.Организация, Объект.Контрагент, Объект.Договор, ДопПараметры, ЭтотОбъект, Объект.Ссылка);
	
КонецПроцедуры
