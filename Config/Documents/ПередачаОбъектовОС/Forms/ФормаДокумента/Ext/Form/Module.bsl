&НаКлиенте
Процедура ОчиститьРеквзитыТЧПриИзмененииВидаПередачи()
	МассивРеквизитов = Новый Массив;
	
	Если ВидОперацииИзменилсяПоСчетуУчета(ВидыОперацийРодственныеПоСчетамУчета, 
		ПредыдущийВидОперации, Объект.ВидОперации) Тогда
		МассивРеквизитов.Добавить("СчетУчета");
		МассивРеквизитов.Добавить("Количество");
	КонецЕсли;
		
	ЭтоПередачаВПользование =
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(Объект.ВидОперации);
		
	МассивРеквизитов.Добавить("Сумма");
	МассивРеквизитов.Добавить("СуммаАмортизации");
	МассивРеквизитов.Добавить("СуммаАмортизацииЗаТекущийМесяц");
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		Для каждого Реквизит из МассивРеквизитов Цикл
			Если ЗначениеЗаполнено(СтрокаТЧ[Реквизит]) Тогда
				СтрокаТЧ[Реквизит] = "";
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;	
КонецПроцедуры	

