	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(СписаниеЗапчастей) Или Объект.Проведен Тогда
		ОбщегоНазначенияБГУКлиент.ОткрытьФормуДокументаСписанияЗапчастей(СписаниеЗапчастей, ЭтаФорма);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Документ не проведён!'"));
	КонецЕсли;
	
