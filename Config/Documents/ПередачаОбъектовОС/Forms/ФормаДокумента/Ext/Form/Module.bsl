&НаКлиенте
Процедура Подключаемый_ДекорацияСостояниеОригиналаНажатие()
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументовКлиент.ОткрытьМенюВыбораСостояния(ЭтотОбъект,Элементы.ДекорацияСостояниеОригинала);
	//Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	ЕстьПрослеживаемыеТовары = ПрослеживаемостьБГУ.ЕстьПрослеживаемыеТовары(Объект.ОсновныеСредства);
	РеализацияВЕАЭС = Справочники.Контрагенты.КонтрагентРезидентТаможенногоСоюза(Объект.Контрагент);
	ТребуетсяНапоминаниеУведомленийОПеремещении = ТребуетсяНапоминаниеОбУведомленииОПеремещении(ЭтотОбъект);
    ЭтоПередачаВКапвложение = ЭтоВОсКапвложениями(Объект.ВидОперации);
	ВедетсяУчетДрагМатериаловВМЦКапвложений = УчетДрагМатериалов.ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений()
		ИЛИ (ЭтоПередачаВКапвложение И Объект.ДрагоценныеМатериалы.Количество() > 0);
	ПрослеживаемостьФормыБГУ.УстановитьПредставлениеНадписиУведомлениеОПеремещении(ЭтотОбъект);
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	УстановитьДопустимыеКодыОперацийПрослеживаемости(ЭтотОбъект);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТВоВсехСтроках(ЭтотОбъект, "ОсновныеСредства");
	УстановитьЗаголовокБаннераУведомленияОПеремещении();
	
	ЗаполнитьДополнительныеРеквизитыФормы();
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОС();
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	УстановитьОбязательностьЭлементовФормы(ЭтотОбъект);
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтотОбъект, Объект);
	УстановитьДоступностьДоговора(ЭтотОбъект, Объект);
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(ЭтотОбъект);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыДрагМатериаловДляМЦ();
	КонтрольИсполненияДоговоров.ОбновитьГруппуКонтрольИсполнения(ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	РезервированиеНФАКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Колонка "Количество" не редактируется для кап. вложений
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваКоличество");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ГрупповойУчет", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ВидОперации", ВидСравненияКомпоновкиДанных.НеВСписке, ВОсКапвложениями());
	//ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	//	"Объект.ВидОперации", ВидСравненияКомпоновкиДанных.НеРавно, Перечисления.ВидыОперацийПередачиОС.ПередачаКапвложений);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

	ВидыОперацийПоПередачеВложений = Новый Массив;
	ВидыОперацийПоПередачеВложений.Добавить(Перечисления.ВидыОперацийПередачиОС.ПередачаКапвложений);
	ВидыОперацийПоПередачеВложений.Добавить(Перечисления.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106);
	// Колонки "Сумма" и "Цена" при передаче вложений должны быть всегода доступны, т.к. передать можно только
	// часть вложений
	Если ВидыОперацийПоПередачеВложений.Найти(Объект.ВидОперации) = Неопределено Тогда
		// Колонки "Сумма" и "Цена" не редактурются, кроме библиотечного фонда и капитальных вложений
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваСтоимостьЕдиницы");
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваСумма");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			"Объект.ОсновныеСредства.ТипНФА", ВидСравненияКомпоновкиДанных.НеРавно, Перечисления.ТипыНФА.БиблиотечныйФонд);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			"Объект.ОсновныеСредства.ВидНФА", ВидСравненияКомпоновкиДанных.НеРавно, Перечисления.ВидыНФА.КапВложения);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			"Объект.ПередачаЧастейОбъектов", ВидСравненияКомпоновкиДанных.Равно, Ложь);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	КонецЕсли;	
	
	// Колонка "Инвентарный номер" для кап. вложения не редактируется
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваИнвентарныйНомер");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.ВидНФА", ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыНФА.КапВложения);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Колонка "КПС" отмечается незаполненной если ведется учет по КПС
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваКПС");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.УчетПоКПС", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.КПС", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	// Колонка "КПС" не редактируется если не ведется учет по КПС
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваКПС");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.УчетПоКПС", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "не используется");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваМаркируемыеУпаковки");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.МаркируемыеУпаковки", ВидСравненияКомпоновкиДанных.Равно, "");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.МаркируемыйТовар", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<...>");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОсновныеСредстваМаркируемыеУпаковки");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.МаркируемыеУпаковки", ВидСравненияКомпоновкиДанных.Равно, "");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ОсновныеСредства.МаркируемыйТовар", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "Не используется");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)
	
	СвязанныеРеквизиты = Новый Массив;
	СвязанныеРеквизиты.Добавить("Подразделение");
	СвязанныеРеквизиты.Добавить("ЦМО");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		СвязанныеРеквизиты, "Доступность", ЗначениеЗаполнено(Объект.Организация));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговора(Форма, Объект)
	
	ДоступностьДоговора = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Договор", "Доступность", ДоступностьДоговора);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ДоговорПолучатель", "Доступность", ДоступностьДоговора);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОбязательностьЭлементовФормы(Форма)
	
	Объект = Форма.Объект;
	ЦМООбязательно = НЕ ЭтоВОсКапвложениями(Объект.ВидОперации); 
	//ЦМООбязательно = Объект.ВидОперации <> 
	//	ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений");
	
	Если ЦМООбязательно Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЦМО",
			"АвтоотметкаНезаполненного", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЦМО",
			"ОтметкаНезаполненного", Не ЗначениеЗаполнено(Объект.ЦМО));
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЦМО",
			"АвтоотметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ЦМО",
			"ОтметкаНезаполненного", Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьДоговорВТабЧасти(ДоговорВТабличнойЧасти, ВидОперации, ВидИмущества)
	Возврат Документы.ПередачаОбъектовОС.ЕстьДоговорВТабЧасти(ДоговорВТабличнойЧасти, ВидОперации, ВидИмущества);
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект = Форма.Объект;
	ВидОперации = Объект.ВидОперации;
	Элементы = Форма.Элементы;
	
	ЭтоПередачаВКапвложение = 	
		     Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений");
	ЭтоПередачаВПользование =
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(ВидОперации);
	ЭтоВозвратС01_02 = ЭтоВО_ВозвратС01_02(Форма); 
		
	НевидимыеЭлементы = Новый Массив;
	НевидимыеЭлементы.Добавить("ЗаполнитьЦМОПолучатель");
	НевидимыеЭлементы.Добавить("ЗаполнитьПодразделениеПолучатель");
	НевидимыеЭлементы.Добавить("ЦМОПолучатель");
	НевидимыеЭлементы.Добавить("ПодразделениеПолучатель");
	НевидимыеЭлементы.Добавить("КонтрагентПолучатель");
	НевидимыеЭлементы.Добавить("ДоговорПолучатель");
	НевидимыеЭлементы.Добавить("Контрагент");
	НевидимыеЭлементы.Добавить("Договор");
	НевидимыеЭлементы.Добавить("ВалютаДокумента");
	НевидимыеЭлементы.Добавить("СуммаВключаетНДС");
	НевидимыеЭлементы.Добавить("ПередачаЧастейОбъектов");
	НевидимыеЭлементы.Добавить("ОсновныеСредстваКомандаРассчитатьСтоимостьОС");
	НевидимыеЭлементы.Добавить("ДоговорВТабличнойЧасти");
	НевидимыеЭлементы.Добавить("ОсновныеСредстваДоговор");
	НевидимыеЭлементы.Добавить("ОсновныеСредстваЗарегистрироватьОбременения");
	
	ВидимыеЭлементы = Новый Массив;
	Если ЭтоПередачаВПользование Тогда
		Если НЕ Объект.ПередачаЧастейОбъектов Тогда
			ВидимыеЭлементы.Добавить("ЗаполнитьЦМОПолучатель");
			ВидимыеЭлементы.Добавить("ЗаполнитьПодразделениеПолучатель");
			ВидимыеЭлементы.Добавить("ЦМОПолучатель");
			ВидимыеЭлементы.Добавить("ПодразделениеПолучатель");
			ВидимыеЭлементы.Добавить("ОсновныеСредстваКомандаРассчитатьСтоимостьОС");
		КонецЕсли;	
		ВидимыеЭлементы.Добавить("КонтрагентПолучатель");
		ВидимыеЭлементы.Добавить("ДоговорПолучатель");
		ВидимыеЭлементы.Добавить("ПередачаЧастейОбъектов");
		ВидимыеЭлементы.Добавить("ОсновныеСредстваЗарегистрироватьОбременения");
	Иначе
		Если ЭтоВозвратС01_02 Тогда
			ВидимыеЭлементы.Добавить("ДоговорВТабличнойЧасти");
		КонецЕсли;	
		
		ВидимыеЭлементы.Добавить("Контрагент");
		Если НЕ Объект.ДоговорВТабличнойЧасти Тогда
			ВидимыеЭлементы.Добавить("Договор");
		КонецЕсли;	
		Если ЕстьДоговорВТабЧасти(Объект.ДоговорВТабличнойЧасти, Объект.ВидОперации, Объект.ВидИмущества) Тогда
			// Если это передача капвложений в объекты концессии, то Договор в табличной части должен быть виден,
			// т.к. это субконто счетаов 106.90, с которых капвложения списываются. А Контрагент и Договор в шаке,
			// это получатель передачи, т.е. совсем другие сущниости.	
			ВидимыеЭлементы.Добавить("ОсновныеСредстваДоговор");
		КонецЕсли;	
		ВидимыеЭлементы.Добавить("ВалютаДокумента");
		ВидимыеЭлементы.Добавить("СуммаВключаетНДС");
		ВидимыеЭлементы.Добавить("ОсновныеСредстваКомандаРассчитатьСтоимостьОС");
	КонецЕсли;
	
	Для каждого Элемент Из ВидимыеЭлементы Цикл
		НевидимыеЭлементы.Удалить(НевидимыеЭлементы.Найти(Элемент));
	КонецЦикла;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, НевидимыеЭлементы,
		"Видимость", Ложь);
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ВидимыеЭлементы,
		"Видимость", Истина);
	
	ЭтоВозвратПоставщику =
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106");
	
	ЭтоРеализация =
			ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОС")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет");
	
	ЭлементыРеализации = Новый Массив;
	ЭлементыРеализации.Добавить("ГруппаПараметрыРеализации");
	ЭлементыРеализации.Добавить("ОсновныеСредстваНадписьЦенаПродажи");
	ЭлементыРеализации.Добавить("ОсновныеСредстваНадписьСуммаПродажи");
	ЭлементыРеализации.Добавить("ОсновныеСредстваЦенаПродажи");
	ЭлементыРеализации.Добавить("ОсновныеСредстваСуммаПродажи");
	ЭлементыРеализации.Добавить("ОсновныеСредстваСтавкаНДС");
	ЭлементыРеализации.Добавить("ОсновныеСредстваСуммаНДС");
	ЭлементыРеализации.Добавить("ОсновныеСредстваВсего");
	
	ЭлементыРеализации.Добавить("ВалютаДокумента");
   	ЭлементыРеализации.Добавить("ГруппаРасчетныеСчета");
	ЭлементыРеализации.Добавить("ГруппаГрузоотправитель");
	ЭлементыРеализации.Добавить("ГруппаГрузополучатель");
	ЭлементыРеализации.Добавить("КодыУпаковокМаркируемойПродукции");
	ЭлементыРеализации.Добавить("ГруппаРеализацияДляГосНужд");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыРеализации, "Видимость", ЭтоРеализация ИЛИ ЭтоВозвратПоставщику);
	
	ТекЭлементы = Новый Массив;
	ТекЭлементы.Добавить("ОсновныеСредстваГруппаБалансоваяСтоимость");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ТекЭлементы, "Видимость", НЕ ЭтоВозвратПоставщику);
	
	ТекЭлементы = Новый Массив;
	ТекЭлементы.Добавить("ОсновныеСредстваИнвентарныйНомер");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ТекЭлементы, "Видимость", НЕ ЭтоВозвратПоставщику И НЕ ЭтоПередачаВКапвложение);
	
	ВидимостьРеквизитовАмортизации =
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОС")
		Или ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС");
	
	ЭлементыАмортизации = Новый Массив;
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСуммаАмортизацииНакопленная");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСуммаОбесценения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыАмортизации, "Видимость", ВидимостьРеквизитовАмортизации ИЛИ ЭтоПередачаВПользование);
	
	ЭлементыАмортизации = Новый Массив;
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСуммаАмортизацииЗаТекущийМесяц");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыАмортизации, "Видимость", ВидимостьРеквизитовАмортизации);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИтогВалютаРубли", "Видимость",
		Форма.КэшПараметров.ИспользоватьВалютныйУчет);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДекорацияРуб", "Видимость", Форма.КэшПараметров.ИспользоватьВалютныйУчет);
	
	ВидимостьЭлементовКарточки = (ВОсКапвложениями().Найти(Объект.ВидОперации) <> Неопределено);
	ЭлементыКарточкаКапвложений = Новый Массив;
	ЭлементыКарточкаКапвложений.Добавить("ОсновныеСредстваГруппаКарточкаКапвложений");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыКарточкаКапвложений, "Видимость", ВидимостьЭлементовКарточки);
		
	Элементы.ВидБезвозмездногоПользования.Видимость =
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСвПользование")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование");
		
	Элементы.ОсновныеСредстваГруппаСуммаПродажи.Заголовок = 
		?(ЭтоВозвратПоставщику, НСтр("ru = 'Сумма возврата'"), НСтр("ru = 'Сумма продажи'"));

	ТекЭлементы = Новый Массив;
	ТекЭлементы.Добавить("ОсновныеСредстваКоличество");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ТекЭлементы, "Видимость", НЕ Объект.ПередачаЧастейОбъектов); 
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыГруппаМЦ", "Видимость", (ЭтоПередачаВКапвложение ИЛИ ЭтоВозвратПоставщику) И Форма.ВедетсяУчетДрагМатериаловВМЦКапвложений);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыИнвНомер", "Видимость", НЕ ((ЭтоПередачаВКапвложение ИЛИ ЭтоВозвратПоставщику) И Форма.ВедетсяУчетДрагМатериаловВМЦКапвложений));
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСчетаУчетаОС()
	
	КодыСчетов = "-";
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении") Тогда
		
		Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
			КодыСчетов = "02.10,02.3" + ",02.1";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
			КодыСчетов = "02.20,02.3" + ",02.1";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
			КодыСчетов = "02.30,02.3" + ",02.1";
		КонецЕсли;
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование") Тогда
		
		Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
			КодыСчетов = "01.10" + ",01.11,01.12";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
			КодыСчетов = "01.20" + ",01.21,01.22";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
			КодыСчетов = "01.30" + ",01.31,01.32";
		КонецЕсли;
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетВУправление") Тогда
		
		Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
			КодыСчетов = "21.20";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
			КодыСчетов = "21.30";
		КонецЕсли;
		
	//ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений") Тогда
	ИначеЕсли ЭтоВОсКапвложениями(Объект.ВидОперации) Тогда
		
		Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
			КодыСчетов = "106.10";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
			КодыСчетов = "106.20";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
			КодыСчетов = "106.30";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Лизинг") Тогда
			КодыСчетов = "106.40";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ПраваПользованияНМА") Тогда
			КодыСчетов = "106.60";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
			КодыСчетов = "106.90";
		КонецЕсли;
		
	Иначе
		
		Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
			КодыСчетов = "101.10,102.10,103.10";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
			КодыСчетов = "101.20,102.20,103.20";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
			КодыСчетов = "101.30,102.30,103.30";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Лизинг") Тогда
			КодыСчетов = "101.40,102.40,103.40";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ПраваПользованияНМА") Тогда
			КодыСчетов = "111.60";
		ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
			КодыСчетов = "101.90,102.90,103.90";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеРеквизитыФормы()
	
	МассивОбъектовОС = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	ДанныеОбъектовОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОбъектовОС, "ГрупповойУчет,ВидНФА,ТипНФА");
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		
		ДанныеОбъектаОС = ДанныеОбъектовОС.Получить(СтрокаТаблицы.ОсновноеСредство);
		Если ДанныеОбъектаОС <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеОбъектаОС, "ГрупповойУчет,ВидНФА,ТипНФА");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СчетУчета) Тогда
			СтрокаТаблицы.УчетПоКПС = Ложь;
		Иначе
			СтрокаТаблицы.УчетПоКПС = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетУчета).УчетПоКПС;
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыОС()
	
	Для Каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущаяСтрока)
	
	ТекущаяСтрока.НадписьСтоимостьЕдиницы = НСтр("ru = '1 ед.:'");
	ТекущаяСтрока.НадписьСумма = НСтр("ru = 'Всего:'");
	
	ТекущаяСтрока.НадписьЦенаПродажи = НСтр("ru = 'Цена:'");
	ТекущаяСтрока.НадписьСуммаПродажи = НСтр("ru = 'Сумма:'");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекстПроСчетФактуруКлиент(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения)
	
	Перем ЗначениеСвойства;
	
	ЭтотДокументЯвляетсяОснованием = (ТипЗнч(ПараметрОбработкиОповещения) = Тип("Структура")
		И ПараметрОбработкиОповещения.Свойство("ДокументыОснования", ЗначениеСвойства)
		И ЗначениеСвойства.Найти(Объект.Ссылка) <> Неопределено);
	
	Если ЭтотДокументЯвляетсяОснованием Тогда
		ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено)
	
	УчетНДС.ЗаполнитьТекстПроСчетФактуру(ЭтаФорма, ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКомиссиюВДокумент(Результат, ДопПараметры) Экспорт
	ОбщегоНазначенияБГУКлиент.УстановитьКомиссиюВДокумент(Результат, ДопПараметры, Объект);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКомиссии()
	
	ЕстьКомиссия = ЗначениеЗаполнено(Объект.Комиссия);
	
	Элементы.ГруппаПриказОНазначенииКомиссии.ТолькоПросмотр = ЕстьКомиссия;
	Элементы.ГруппаПредседательКомиссии.ТолькоПросмотр = ЕстьКомиссия;
	Элементы.Председатель.Видимость = ЕстьКомиссия;
	Элементы.ВыбратьПредседателяКомиссии.Видимость = Не ЕстьКомиссия;
	Элементы.СоставКомиссии.Видимость = Не ЕстьКомиссия;
	Элементы.СоставКомиссии1.Видимость = ЕстьКомиссия;
	
КонецПроцедуры

// Основные средства

&НаКлиенте
Процедура ОбнулитьСуммы()
	
	//Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений") Тогда
	Если ЭтоВОсКапвложениями(Объект.ВидОперации) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		СтрокаТаблицы.Сумма = 0;
		СтрокаТаблицы.СуммаАмортизации = 0;
		СтрокаТаблицы.СуммаАмортизацииЗаТекущийМесяц = 0;
		СтрокаТаблицы.СуммаОбесценения = 0;
		СтрокаТаблицы.СтоимостьЕдиницы = 0;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммы()
	
	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(
		СтруктураПроверяемыхРеквизитов(), Объект, Истина);
	
	Если Объект.Проведен Тогда
		ТекстСообщения = НСтр("ru = 'Расчет доступен только в непроведенном документе'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьСуммыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыНаСервере()
	ТаблицаОС = УправлениеОсновнымиСредствами.ПустаяТаблицаОС_ДляРасчетаУчетныхДанных();
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		НоваяСтрока = ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
	КонецЦикла;	
	
	ТабОстатков = УправлениеОсновнымиСредствами.ТаблицаУчетныхДанных(ПараметрыПолученияУчетныхДанных(ТаблицаОС));
	
	Для каждого СтрокаТЧ из Объект.ОсновныеСредства Цикл
		ЗаполнитьСтрокуТЧ(СтрокаТЧ, ТабОстатков);
	КонецЦикла;	
	
	РассчитатьСуммуАмортизацииЗаТекущийМесяц();
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ВидОперации");
	СтруктураРеквизитов.Вставить("ВидИмущества", "Вид имущества");
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("КФО");
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		СтруктураРеквизитов.Вставить("ИФО");
	КонецЕсли;
	//Если Объект.ВидОперации <> ПредопределенноеЗначение(
	//	"Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений") Тогда
	Если НЕ ЭтоВОсКапвложениями(Объект.ВидОперации) Тогда
		
		СтруктураРеквизитов.Вставить("ЦМО", "МОЛ/Место хранения");
		
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям Тогда
		Если Элементы.Подразделение.ОтметкаНезаполненного Тогда
			
			СтруктураРеквизитов.Вставить("Подразделение");
			
		КонецЕсли;
	КонецЕсли;
	Если Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхвПользование")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении") Тогда
		
		СтруктураРеквизитов.Вставить("Контрагент");
		
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("КФО"			, Объект.КФО);
	ПараметрыПодбора.Отбор.Вставить("Счет"			, КодыСчетов);
	
	//Если  Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений")
	Если НЕ ЭтоВОсКапвложениями(Объект.ВидОперации)
		Или Объект.Дата >= '20210101' Тогда
		ПараметрыПодбора.Отбор.Вставить("ЦМО", Объект.ЦМО);
		ПараметрыПодбора.Отбор.Вставить("Подразделение", Объект.Подразделение);
	КонецЕсли;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОС") Тогда
		ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе");
		ПараметрыПодбора.Вставить("НужнаАмортизация", Истина);
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСАренда")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСвПользование")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСвУправление") Тогда
		ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе");
		ПараметрыПодбора.Вставить("НужнаАмортизация", Истина);
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетВУправление")
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет") Тогда
		ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ОперативныйУчет");
	ИначеЕсли ЭтоВОсКапвложениями(Объект.ВидОперации) Тогда
		ВидРаспоряжения = "Вложения";
	ИначеЕсли 
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении") Тогда
		ВидРаспоряжения = 
			?(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении"),
			ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаХранении"),
			ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПолученоВПользование"));
		ПараметрыПодбора.Отбор.Вставить("Контрагент", Объект.Контрагент);
		Если НЕ Объект.ДоговорВТабличнойЧасти Тогда
			ПараметрыПодбора.Отбор.Вставить("Договор", Объект.Договор);
		КонецЕсли;	
	Иначе
		ВидРаспоряжения = Неопределено;
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения"	, ВидРаспоряжения);
	ПараметрыПодбора.Вставить("СкрытьКолонки"   , "Контрагент");
	ПараметрыПодбора.Вставить("КолонкиКорзины"	, Новый Структура("Цена", "СтоимостьЕдиницы"));
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	ПараметрыПодбора.Вставить("ДоговорВТабличнойЧасти", Объект.ДоговорВТабличнойЧасти);
	ПараметрыПодбора.Вставить("ДокументСРезервированиемОС", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработкаВыбораПодбораОсновныхСредствНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()
	
	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОсновныхСредствНаСервере(Знач ВыбранноеЗначение)
	
	ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(
		Объект.ОсновныеСредства, ВыбранноеЗначение, , "ОсновноеСредство,ИнвентарныйНомер");
	
	ЗаполнитьДополнительныеРеквизитыФормы();
	
	ЭтоВозвратОСПоставщику = (Объект.ВидОперации 
		= ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106"));

	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьУстановитьКоличествоОСВСтроке(СтрокаТаблицы);
		ОбновитьТекстЗаголовковВСтрокеТаблицыОС(СтрокаТаблицы);

		Если Объект.ПередачаЧастейОбъектов И СтрокаТаблицы.Количество <> 0 Тогда
			СтрокаТаблицы.Количество = 0;
		КонецЕсли;	
		
		Если ЭтоВозвратОСПоставщику Тогда
			СтрокаТаблицы.ЦенаПродажи = СтрокаТаблицы.СтоимостьЕдиницы;
			СтрокаТаблицы.СуммаПродажи = СтрокаТаблицы.Сумма;
			ПересчитатьСуммыРеализации(ЭтотОбъект, СтрокаТаблицы, "ЦенаПродажи");
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторСтроки) Тогда
			СтрокаТаблицы.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;	
	КонецЦикла;
	
	Если ЭтоВОсКапвложениями(Объект.ВидОперации) Тогда
		Для каждого СтрокаТаблицы из ДобавленныеСтроки Цикл
			Если НЕ СтрокаТаблицы.ОтразитьВКарточкеКапвложений Тогда
				СтрокаТаблицы.ОтразитьВКарточкеКапвложений = Истина;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	
	//РассчитатьСуммыНаСервере();
	РассчитатьСуммуАмортизацииЗаТекущийМесяц();
	
	Если ВедетсяУчетПрослеживаемыхТоваров Тогда
		ПрослеживаемостьБГУ.ПослеПодбораОС(Объект, ДобавленныеСтроки);
		ЕстьПрослеживаемыеТовары = ЕстьПрослеживаемыеТовары Или ПрослеживаемостьБГУ.ЕстьПрослеживаемыеТовары(Объект.ОсновныеСредства);
		УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
		Если ЕстьПрослеживаемыеТовары И ВидимостьБаннераУведомленияОПеремещении(ЭтотОбъект) Тогда
			УстановитьЗаголовокБаннераУведомленияОПеремещении();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыРеализации(Форма, ТекущиеДанные, Знач ИмяКолонки)
	
	Объект = Форма.Объект;
	Если Объект.ВидОперации
		<> ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОС")
		И Объект.ВидОперации
		<> ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет")
		И Объект.ВидОперации
		<> ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106") Тогда
		
		Возврат;
	КонецЕсли;
	
	Если ИмяКолонки = "СуммаПродажи" Тогда
		ТекущиеДанные.ЦенаПродажи = ТекущиеДанные.СуммаПродажи / 
			?(ТекущиеДанные.Количество = 0, 1, ТекущиеДанные.Количество);
	КонецЕсли;
	
	Если ИмяКолонки = "Количество" ИЛИ ИмяКолонки = "ЦенаПродажи" Тогда
		ТекущиеДанные.СуммаПродажи = ?(ТекущиеДанные.Количество = 0, 1, 
			ТекущиеДанные.Количество) * ТекущиеДанные.ЦенаПродажи;
		ИмяКолонки = "СуммаПродажи";
	КонецЕсли;
	
	Если ИмяКолонки = "СуммаПродажи" Тогда
		Если Объект.СуммаВключаетНДС Тогда
			ТекущиеДанные.Всего = ТекущиеДанные.СуммаПродажи;
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяКолонки = "СтавкаНДС" ИЛИ ИмяКолонки = "СуммаПродажи" Тогда
		ТекущиеДанные.СуммаНДС = ТекущиеДанные.СуммаПродажи * УчетНДСКлиентСервер.ПолучитьМножительСтавки(
			ТекущиеДанные.СтавкаНДС, Объект.СуммаВключаетНДС);
		ИмяКолонки = "СуммаНДС";
	КонецЕсли;
	
	Если ИмяКолонки = "СуммаНДС" Тогда
		Если НЕ Объект.СуммаВключаетНДС Тогда
			ТекущиеДанные.Всего = ТекущиеДанные.СуммаПродажи + ТекущиеДанные.СуммаНДС;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#Область УчетДрагМатериалов

&НаСервере
Процедура ЗаполнитьСписокДМДляСписанияНаСервере()
	
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, ДатыПроведенияДокументов.ДатаПроведения);
	
	Если Не ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков)
	
	ТаблицаСписанияОбъектов = Объект.ОсновныеСредства.Выгрузить(, "ОсновноеСредство,ИнвентарныйНомер,Количество");
	ТаблицаСписанияОбъектов.Колонки.ОсновноеСредство.Имя = "ОбъектНФА";
	ТаблицаСписанияОбъектов.Колонки.ИнвентарныйНомер.Имя = "ИнвНомер";
	
	ЭтоПередачаКапвложений = ЭтоВОсКапвложениями(Объект.ВидОперации);
	
	Если ЭтоПередачаКапвложений И ВедетсяУчетДрагМатериаловВМЦКапвложений Тогда
		ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияКапвложений(Объект.Организация, ТаблицаСписанияОбъектов, ПериодОстатков);		
	Иначе			
		ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияОС(Объект.Организация, ТаблицаСписанияОбъектов, ПериодОстатков);
	КонецЕсли;
	
	Объект.ДрагоценныеМатериалы.Загрузить(ОстаткиДМ);
	
	Для Каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОбъектНФА", ТекСтрока.ОсновноеСредство);
		Если НЕ ЭтоПередачаКапвложений Тогда
			ПараметрыОтбора.Вставить("ИнвНомер", ТекСтрока.ИнвентарныйНомер);
		КонецЕсли;
		НайденныеСтроки = ОстаткиДМ.НайтиСтроки(ПараметрыОтбора);
		Если ТипЗнч(НайденныеСтроки) = Тип("Массив") Тогда
			Для Каждого ТекСтрокаМассива Из НайденныеСтроки Цикл
				ТекСтрока.КоличествоВсегоДМ = ?(ЭтоПередачаКапвложений,ТекСтрока.Количество, ТекСтрокаМассива.КоличествоВсего);
				Прервать;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	
	Для каждого ТекСтрока Из Объект.ДрагоценныеМатериалы Цикл
		ТекСтрока.КлючСтроки = УчетДрагМатериаловКлиент.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, ТекСтрока.ИнвНомер);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбъектыСДрагМатериалами()
	
	ТаблицаВсехОбъектов = Объект.ОсновныеСредства.Выгрузить(,"СчетУчета, ОсновноеСредство, ИнвентарныйНомер, Количество, КоличествоВсегоДМ");
	
	ТаблицаОбъектовОС = Новый ТаблицаЗначений;
	ТаблицаОбъектовОС.Колонки.Добавить("КлючСтроки",Новый ОписаниеТипов("Строка"));
	ТаблицаОбъектовОС.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовОС.Колонки.Добавить("ИнвентарныйНомер",Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаОбъектовОС.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
	ТаблицаОбъектовОС.Колонки.Добавить("КоличествоВсегоДМ",Новый ОписаниеТипов("Число"));
	
	Если ЭтоВОсКапвложениями(Объект.ВидОперации) И ВедетсяУчетДрагМатериаловВМЦКапвложений Тогда
		МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляКапвложенийСМЦ();
	Иначе 
		МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляОС();
	КонецЕсли; 
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовОС.Найти(ТекСтрока.СчетУчета)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовОС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.КлючСтроки = УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.ОсновноеСредство, ТекСтрока.ИнвентарныйНомер); 
		КонецЕсли;
	КонецЦикла;
	
	ОбъектыНФАСДрагМатериалами.Загрузить(ТаблицаОбъектовОС);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДанныхДрагМатериалов()
	
	Если ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Истина;
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
		
		Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные <> Неопределено Тогда
			ОтборДрагМатериаловДляОбъекта(Элементы.СписокНФАДокументаОснования.ТекущиеДанные.КлючСтроки);
		КонецЕсли;
	Иначе
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
		Элементы.ДрагоценныеМатериалы.ОтборСтрок = Неопределено;
	КонецЕсли;
	
	//Заголовки
	РеквизитыДрагМатериалы = Новый Массив;
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМЗаголовок");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоЗаголовок");
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМ");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличество");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(ЭтаФорма.Элементы,
		РеквизитыДрагМатериалы, "Видимость", Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОбъектовДрагМатериалов(ТекущаяСтрока)
	
	ТекущаяСтрока.КоличествоВсегоДМЗаголовок = НСтр("ru = 'Всего:'");
	ТекущаяСтрока.КоличествоЗаголовок = НСтр("ru = 'Списать:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(Форма)
	
	Для каждого ТекущаяСтрока Из Форма.ОбъектыНФАСДрагМатериалами Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОбъектовДрагМатериалов(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыДрагМатериалов(ТекущаяСтрока)

	ТекущаяСтрока.МатериальнаяЦенностьЗаголовок = НСтр("ru = 'Материальная ценность:'");
	ТекущаяСтрока.КоличествоМЦЗаголовок 		= НСтр("ru = 'Количество:'"); 
	
	ЕдиницаИзм = ПолучитьЕдиницуИзмеренияМатериальнойЦенности(ТекущаяСтрока.ОбъектМЦ);
	
	ТекущаяСтрока.ЕдиницаИзмерения = ЕдиницаИзм;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЕдиницуИзмеренияМатериальнойЦенности(Знач ОбъектМЦ)
	
	Если ТипЗнч(ОбъектМЦ) = Тип("СправочникСсылка.ОсновныеСредства") ИЛИ Не ЗначениеЗаполнено(ОбъектМЦ) Тогда 
		ЕдиницаИзм = УчетДрагМатериалов.Штуки();
	Иначе
		Если ЗначениеЗаполнено(ОбъектМЦ.ЕдиницаИзмерения) Тогда
			ЕдиницаИзм = ОбъектМЦ.ЕдиницаИзмерения; 
		Иначе
			ЕдиницаИзм = УчетДрагМатериалов.Штуки(); 
		КонецЕсли;
	КонецЕсли;
	Возврат ЕдиницаИзм;

КонецФункции 

&НаСервере
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыДрагМатериаловДляМЦ()
	
	Если НЕ (ЭтоВОсКапвложениями(Объект.ВидОперации)
					И ВедетсяУчетДрагМатериаловВМЦКапвложений) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекущаяСтрока Из Объект.ДрагоценныеМатериалы Цикл
	
		ОбновитьТекстЗаголовковВСтрокеТаблицыДрагМатериалов(ТекущаяСтрока);
	
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОтборДрагМатериаловДляОбъекта(КлючСтроки)
	
	Элементы.ДрагоценныеМатериалы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки",КлючСтроки));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючиСтрокДрагМатериалов()
	Если ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОДрагМатериалах(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Параметры.НайденныеСтроки Цикл
		Объект.ДрагоценныеМатериалы.Удалить(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьСтрокиТаблицыДрагМатериаловПриАктивизацииОбъектаНФА()
	Элемент = Элементы.СписокНФАДокументаОснования;
	ОтборДрагМатериаловДляОбъекта(Элемент.ТекущиеДанные.КлючСтроки);
КонецПроцедуры

#КонецОбласти

