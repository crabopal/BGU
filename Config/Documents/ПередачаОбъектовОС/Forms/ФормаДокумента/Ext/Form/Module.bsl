#Область ОбработчикиСобытийЭлементовТаблицыФормы_ДрагоценныеМатериалы

&НаКлиенте
Процедура ДрагоценныеМатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ЭтоПередачаКапвложений = 
				Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений");
				
	Если НоваяСтрока И НЕ Копирование И ЭтоПередачаКапвложений Тогда
		
		ТекущиеДанные = Элементы.ДрагоценныеМатериалы.ТекущиеДанные;
		
		ОбновитьТекстЗаголовковВСтрокеТаблицыДрагМатериалов(ТекущиеДанные);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДрагоценныеМатериалыОбъектМЦОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	
	Если НЕ Элемент.ТекстРедактирования = Строка(ВыбранноеЗначение) Тогда
		
		ТекущиеДанные = Элементы.ДрагоценныеМатериалы.ТекущиеДанные;
		ТекущиеДанные.ОбъектМЦ = ВыбранноеЗначение;
		
		ОбновитьТекстЗаголовковВСтрокеТаблицыДрагМатериалов(ТекущиеДанные);
	
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовТаблицыФормы_НоменклатураМаркируемыеУпаковки

&НаКлиенте
Процедура ОсновныеСредстваМаркируемыеУпаковкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекДанныеСтроки = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если ТекДанныеСтроки <> Неопределено Тогда
		
		ИдентификаторСтроки = ТекДанныеСтроки.ИдентификаторСтроки;
		Если НЕ ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
			ТекДанныеСтроки.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		
		Если НЕ ТекДанныеСтроки.МаркируемыйТовар Тогда
			ТекДанныеСтроки.МаркируемыйТовар = МаркируемыйТовар(ТекДанныеСтроки.ПолучитьИдентификатор());
		КонецЕсли;
		
		Если ТекДанныеСтроки.МаркируемыйТовар Тогда
			ЭлектронныеДокументыБГУКлиент.ВыбратьКодыМаркировки(ЭтотОбъект, СтандартнаяОбработка, "ОсновныеСредства");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СоставКомиссии

&НаКлиенте
Процедура КомиссияПриИзменении(Элемент)
	
	УстановитьДоступностьКомиссии();
	
	Если Не ЗначениеЗаполнено(Объект.Комиссия) Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры = ОбщегоНазначенияБГУКлиент.СтруктураПараметровВыбораКомисии(ЭтотОбъект);
	ОбщегоНазначенияБГУКлиент.УстановитьКомиссиюВДокумент(Объект.Комиссия, ДопПараметры, Объект);
	
КонецПроцедуры

