Функция ВОсКапвложениями()
	Результат = Новый Массив;
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106"));
	
	Возврат Результат;
