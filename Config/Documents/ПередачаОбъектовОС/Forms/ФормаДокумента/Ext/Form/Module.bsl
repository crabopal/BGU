&НаСервере
Процедура ЗаполнитьВидыОперацийРодственныеПоСчетамУчета()
	ВО_Счета101 = Новый СписокЗначений();
	ВО_Счета101.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС")); 
	ВО_Счета101.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСвУправление")); 
	ВО_Счета101.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСАренда")); 
	ВО_Счета101.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСвПользование")); 
	ВО_Счета101.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОС")); 

	ВО_Счета106 = Новый СписокЗначений();
	ВО_Счета106.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений")); 
	ВО_Счета106.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106")); 

	ВО_Счета21 = Новый СписокЗначений();
	ВО_Счета21.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет")); 
	ВО_Счета21.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетВУправление")); 
	ВО_Счета21.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда")); 
	ВО_Счета21.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование")); 
	ВО_Счета21.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет")); 

	ВО_Счета01 = Новый СписокЗначений();
	ВО_Счета01.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование")); 

	ВО_Счета02 = Новый СписокЗначений();
	ВО_Счета02.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении"));
	
	ВидыОперацийРодственныеПоСчетамУчета.Добавить(ВО_Счета101); 
	ВидыОперацийРодственныеПоСчетамУчета.Добавить(ВО_Счета106); 
	ВидыОперацийРодственныеПоСчетамУчета.Добавить(ВО_Счета21); 
	ВидыОперацийРодственныеПоСчетамУчета.Добавить(ВО_Счета01); 
	ВидыОперацийРодственныеПоСчетамУчета.Добавить(ВО_Счета02); 
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция ВидОперацииИзменилсяПоСчетуУчета(ВОРодственныеПоСчетамУчета, ПредВО, ТекВО)
	Результат = Истина;
	Для каждого ТекСписок из ВОРодственныеПоСчетамУчета Цикл
