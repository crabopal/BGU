Функция ЭтоВОсКапвложениями(ВидОперации)
	Возврат(ВОсКапвложениями().Найти(ВидОперации) <> Неопределено);
КонецФункции	

&НаКлиенте
Процедура ПриИзмененииВидаОперации()
	ЭтоПередачаВПользование =
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(Объект.ВидОперации);
	Если НЕ ЭтоПередачаВПользование И Объект.ПередачаЧастейОбъектов Тогда
		Объект.ПередачаЧастейОбъектов = Ложь;	
	КонецЕсли;		                    
	
	Если НЕ ЭтоВО_ВозвратС01_02(ЭтотОбъект) И Объект.ДоговорВТабличнойЧасти Тогда
		Объект.ДоговорВТабличнойЧасти = Ложь;
	ИначеЕсли ЭтоВО_ВозвратС01_02(ЭтотОбъект) И НЕ Объект.ДоговорВТабличнойЧасти Тогда
		Объект.ДоговорВТабличнойЧасти = Истина;
	КонецЕсли;	
	
	//ОчиститьРеквзитыТЧПриИзмененииВидаПередачи();
	УстановитьВидимостьЭлементов(ЭтаФорма);
	УстановитьОбязательностьЭлементовФормы(ЭтаФорма);
	УстановитьОтборСчетаУчетаОС();
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	ПриИзмененииВидаОперацииНаСервере();
КонецПроцедуры

