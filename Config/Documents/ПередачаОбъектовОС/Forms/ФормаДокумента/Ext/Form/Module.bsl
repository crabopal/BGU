// Прослеживаемые ОС

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_Прослеживаемость(Форма)
	
	Элементы = Форма.Элементы;
	
	ВидимостьОсновныхЭлементов = Форма.ВедетсяУчетПрослеживаемыхТоваров И Форма.ЕстьПрослеживаемыеТовары;
	ИменаЭлементовПрослеживаемости = Новый Массив;
	ИменаЭлементовПрослеживаемости.Добавить("ОсновныеСредстваСтранаПроисхождения");
	ИменаЭлементовПрослеживаемости.Добавить("ОсновныеСредстваПрослеживаемыйТовар");
	ИменаЭлементовПрослеживаемости.Добавить("ОсновныеСредстваРНПТ");
	ИменаЭлементовПрослеживаемости.Добавить("КодОперацииПрослеживаемости");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовПрослеживаемости,
		"Видимость", ВидимостьОсновныхЭлементов);
	
	//ВидимостьРНПТ = ВидимостьОсновныхЭлементов И НЕ Форма.РеализацияВЕАЭС;
	//ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОсновныеСредстваРНПТ",
	//	"Видимость", ВидимостьРНПТ);
	
	ВидимостьУведомленияОВвозе = ВидимостьОсновныхЭлементов И Форма.РеализацияВЕАЭС;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьУведомлениеОПеремещении",
		"Видимость", ВидимостьУведомленияОВвозе);
	
	ВидимостьБаннерУведомленийОПеремещении = ВидимостьУведомленияОВвозе 
							И НЕ ЗначениеЗаполнено(Форма.УведомлениеОПеремещении) 
							И НЕ Форма.ОтключитьБаннерУведомленийОПеремещении
							И НЕ Форма.Объект.ПометкаУдаления;
	ИменаЭлементовБаннера = Новый Массив;
	ИменаЭлементовБаннера.Добавить("КартинкаПрослеживаемость");
	ИменаЭлементовБаннера.Добавить("ДекорацияУведомление");
	ИменаЭлементовБаннера.Добавить("КартинкаЗакрытьБаннер");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовБаннера,
		"Видимость", ВидимостьБаннерУведомленийОПеремещении);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиРНПТ(Знач ИдентификаторСтроки)
	ПрослеживаемостьБГУ.УдалитьСтрокиРНПТ(Объект, ИдентификаторСтроки);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораРНПТННаКлиенте(ВыбранноеЗначение)
	
	СтрокаТабличнойЧасти = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
			СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		ОбработкаВыбораРНПТННаСервере(СтрокаТабличнойЧасти.ИдентификаторСтроки, ВыбранноеЗначение, СтрокаТабличнойЧасти.ПолучитьИдентификатор());
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораРНПТННаСервере(Знач ИдентификаторСтроки, Знач ВыбранноеЗначение, Знач ИдентификаторСтрокиВнутр)
	
	СтрокаТабличнойЧасти = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтрокиВнутр);
	ПрослеживаемостьФормыБГУ.ОбработкаВыбораРНПТН(ЭтотОбъект, ИдентификаторСтроки, ВыбранноеЗначение);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТ(ЭтаФорма, СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НапоминатьОбУведомленииОПеремещении()
	
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеНадписиУведомлениеОПеремещении()
	
	ПрослеживаемостьФормыБГУ.УстановитьПредставлениеНадписиУведомлениеОПеремещении(ЭтотОбъект);
	
КонецПроцедуры
 
&НаКлиентеНаСервереБезКонтекста
Функция ТребуетсяНапоминаниеОбУведомленииОПеремещении(Форма)
	
	Возврат Форма.ЕстьПрослеживаемыеТовары И Форма.РеализацияВЕАЭС;
	
КонецФункции

&НаСервере
Процедура УстановитьЗаголовокБаннераУведомленияОПеремещении()
	
	ПрослеживаемостьФормыБГУ.УстановитьТекстЗаголовкаБаннераУведомленияОПеремещении(ЭтотОбъект);	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьБаннераУведомленияОПеремещении(Форма)
	
	Возврат Форма.ВедетсяУчетПрослеживаемыхТоваров
		И Форма.ЕстьПрослеживаемыеТовары
		И Форма.РеализацияВЕАЭС
		И Форма.УведомлениеОПеремещении.Пустая()
		И Не Форма.ОтключитьБаннерУведомленийОПеремещении
		И Не Форма.Объект.ПометкаУдаления;
	
КонецФункции

&НаКлиенте
Процедура ПоместитьРНПТВХранилище(Адрес, ДополнительныеПараметры) Экспорт
	
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ПоместитьРНПТВХранилищеНаСервере(Адрес, ДополнительныеПараметры.ИдентификаторСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьРНПТВХранилищеНаСервере(Адрес, ИдентификаторСтроки)
	
	ТаблицаРНПТ = Объект.СведенияПрослеживаемости.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	ПоместитьВоВременноеХранилище(ТаблицаРНПТ, Адрес);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДопустимыеКодыОперацийПрослеживаемости(Форма)
	
	Если Не Форма.ВедетсяУчетПрослеживаемыхТоваров Тогда
		Возврат;
	КонецЕсли;
	
	ВидыОперацийПрослеживаемости = ПрослеживаемостьБГУКлиентСервер.ВидыОперацийПрослеживаемости();
	ВидыОперацийПрослеживаемости.Передача = Истина;
	ДанныеВыбора = ПрослеживаемостьБГУКлиентСервер.КодыОперацийПрослеживаемости(ВидыОперацийПрослеживаемости);
	Форма.Элементы.КодОперацииПрослеживаемости.СписокВыбора.ЗагрузитьЗначения(ДанныеВыбора);
	
КонецПроцедуры

#Область ЭДОСКонтрагентами

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДО(Форма, ВидимостьЭлементовЭДО, ВидимостьЭлементовМаркировки, ВидимостьДанныхПродавца = Ложь, ВидимостьЭлементовАктирования = Ложь)
	
	Объект = Форма.Объект;
	ВидОперации = Объект.ВидОперации;
	
	ВидимостьЭлементовРеализации =
			ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОС")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет");

	Если НЕ ВидимостьЭлементовРеализации Тогда
		ВидимостьЭлементовЭДО = Ложь;	
	КонецЕсли;		
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияСостояниеЭДО", "Видимость", ВидимостьЭлементовЭДО);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"КомандыЭДО", "Видимость", ВидимостьЭлементовЭДО);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОсновныеСредстваМаркируемыеУпаковки", "Видимость", ВидимостьЭлементовЭДО И ВидимостьЭлементовМаркировки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаДополнительныеСведенияОМаркированныхТоварах", "Видимость", ВидимостьЭлементовЭДО И ВидимостьЭлементовМаркировки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаРеализацияДляГосНужд", "Видимость", ВидимостьДанныхПродавца);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОсновныеСредстваПредставлениеДляАктированияЕИС", "Видимость", ВидимостьЭлементовАктирования);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОсновныеСредстваСтраныТовараЕИС", "Видимость", ВидимостьЭлементовАктирования);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ТоварыУслугиЗаполнитьПоКонтракту", "Видимость", ВидимостьЭлементовАктирования);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СостояниеЭТрН", "Видимость", Форма.МожноОформитьЭПД);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаСостояниеЭПД", "Видимость", Форма.НастроенОбменЭПД И Форма.ЕстьПравоСозданиеЭТрН);

	Если Форма.НастроенОбменЭПД И Форма.ЕстьПравоСозданиеЭТрН Тогда
		ЭлектронныеДокументыБГУКлиентСервер.ОбновитьТекстЭПД(Форма);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеЭДОПродавцаДляГосНужд(ВидимостьДанныхПродавца)
	
	Если ВидимостьДанныхПродавца Тогда 
		ДанныеЭДОДоговора = ЭлектронныеДокументыБГУ.ДанныеЭДОПродавцаДляГосНужд(Объект.Договор);
		Если Не ЗначениеЗаполнено(Объект.КПСПродавца) Тогда
			Объект.КПСПродавца = ДанныеЭДОДоговора.КПСПродавца;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.КодЦелиПродавца) Тогда
			Объект.КодЦелиПродавца = ДанныеЭДОДоговора.КодЦелиПродавца;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.РасчетныйСчетКонтрагента) Тогда
			Объект.РасчетныйСчетКонтрагента = ДанныеЭДОДоговора.СчетКонтрагента;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.РеквизитыЛицевогоСчета) Тогда
			Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.ЗаявкаНаВозврат", Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
			Объект.РеквизитыЛицевогоСчета = Умолчания.РеквизитыЛицевогоСчета;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

