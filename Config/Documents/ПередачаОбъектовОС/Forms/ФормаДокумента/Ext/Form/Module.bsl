&НаКлиенте
Процедура ОсновныеСредстваПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	ОбъектНаУдаление = ТекущиеДанные.ОсновноеСредство;
	ИнвНомерОбъектаНаУдаление = ТекущиеДанные.ИнвентарныйНомер;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ОбъектНаУдаление);
	ПараметрыОтбора.Вставить("ИнвНомер", ИнвНомерОбъектаНаУдаление);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()<>0 Тогда
		ПараметрыОповещения = Новый Структура("НайденныеСтроки", НайденныеСтроки);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДрагМатериалах", ЭтаФорма, ПараметрыОповещения);
		Шаблон = НСтр("ru = 'Удалить данные о содержании драгоценных материалов в удаленном объекте НФА ""%1"" на закладке ""Драгоценные материалы""?'");
		ПоказатьВопрос(Оповещение, СтрШаблон(Шаблон, СокрЛП(ОбъектНаУдаление)), РежимДиалогаВопрос.ДаНет, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанныеСтроки = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекДанныеСтроки <> Неопределено Тогда	
		ИдентификаторСтроки = ТекДанныеСтроки.ИдентификаторСтроки;
		Если НЕ ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
			ТекДанныеСтроки.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	
	Если Поле.Имя = "ОсновныеСредстваМаркируемыеУпаковки" Тогда
		Если ТекДанныеСтроки <> Неопределено Тогда
			Если ТекДанныеСтроки.МаркируемыйТовар Тогда
				СтандартнаяОбработка = Ложь;
				ЭлектронныеДокументыБГУКлиент.ВыбратьКодыМаркировки(ЭтотОбъект, СтандартнаяОбработка, "ОсновныеСредства");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПрослеживаемостьФормыБГУКлиент.ОсновныеСредстваВыбор(ЭтотОбъект, Поле, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПредставлениеДляАктированияЕИСПриИзменении(Элемент)

	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	СписокВыбора = Элемент.СписокВыбора;
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ЭлектронноеАктированиеЕИСКлиент.ПриИзмененииИдентификатораДляАктированияЕИС(
		СписокВыбора, "ОсновныеСредства", ТекущиеДанные);
	ДанныеСтроки = ЭлектронноеАктированиеЕИСВызовСервера.ДанныеСтрокиКонтрактаПоИдентификатору(
		Объект.Договор,
		ТекущиеДанные.ИдентификаторДляАктированияЕИС);
	ТекущиеДанные.ЦенаПродажи = ДанныеСтроки.Цена;
	ТекущиеДанные.Всего = ДанныеСтроки.Сумма;		
	РасчитатьСтроку(Элементы.ОсновныеСредства.ТекущиеДанные, Объект.СуммаВключаетНДС, "Всего");
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС

КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПредставлениеДляАктированияЕИСОткрытие(Элемент, СтандартнаяОбработка)

	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Контракт = ЭлектронноеАктированиеЕИСВызовСервера.ГосударственныйКонтрактДоговора(
		Объект.Договор);
	ЭлектронноеАктированиеЕИСКлиент.ОткрытьФормуСтрокиКонтракта(
		Контракт,
		ТекущиеДанные.ИдентификаторДляАктированияЕИС,
		ЭтотОбъект,
		Истина);
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС

КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПослеУдаления(Элемент)
	
	Если ВедетсяУчетПрослеживаемыхТоваров И ЕстьПрослеживаемыеТовары Тогда
		ОсновныеСредстваПослеУдаленияНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОсновныеСредстваПослеУдаленияНаСервере()
	
	ЕстьПрослеживаемыеТовары = ПрослеживаемостьБГУ.ЕстьПрослеживаемыеТовары(Объект.ОсновныеСредства);
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваРНПТНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ПараметрыПодбора = ПрослеживаемостьФормыБГУКлиент.ПараметрыОткрытияФормыПодбораРНПТ("ОсновныеСредства");
	ПараметрыПодбора.ЭтоПоступление = Ложь;
	ПараметрыПодбора.ТекущийДокумент = Объект.Ссылка;
	ПараметрыПодбора.Период = Объект.Дата;
	ПараметрыПодбора.ВнеоборотныйАктив = ТекущиеДанные.ОсновноеСредство;
	ПараметрыПодбора.Организация = Объект.Организация;
	ПараметрыПодбора.ИмяКолонкиНоменклатура = "ОсновноеСредство";
	ПараметрыПодбора.ПредставлениеКолонкиНоменклатура = НСтр("ru = 'Основное средство'");
	ПараметрыПодбора.ИмяФормыПодбора = "ФормаПодбораРНПТДляОС";
	ПрослеживаемостьФормыБГУКлиент.ОткрытьФормуПодбораРНПТ(ЭтотОбъект, ПараметрыПодбора);
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваРНПТОчистка(Элемент, СтандартнаяОбработка)
	
	СтрокаТабличнойЧасти = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаТабличнойЧасти.ПрослеживаемыйТовар Тогда
		УдалитьСтрокиРНПТ(СтрокаТабличнойЧасти.ИдентификаторСтроки);
	КонецЕсли;
	
	ПрослеживаемостьФормыБГУКлиентСервер.ОчиститьПредставлениеРНПТ(ЭтотОбъект, СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПричинаСписанияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	УправлениеОсновнымиСредствамиКлиент.ПричинаСписанияНачалоВыбора(
		Элемент, Элементы.ОсновныеСредства.ТекущиеДанные, СтандартнаяОбработка, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПричинаСписанияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	УправлениеОсновнымиСредствамиКлиент.ПричинаСписанияОбработкаВыбора(
		Элементы.ОсновныеСредства.ТекущиеДанные, ВыбранноеЗначение, Ложь);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СписокНФАДокументаОснования

&НаКлиенте
Процедура СписокНФАДокументаОснованияПриАктивизацииСтроки(Элемент)
	
	Если (Элемент.ТекущиеДанные <> Неопределено) И (ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА) Тогда
		ПодключитьОбработчикОжидания("ОтобратьСтрокиТаблицыДрагМатериаловПриАктивизацииОбъектаНФА", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

