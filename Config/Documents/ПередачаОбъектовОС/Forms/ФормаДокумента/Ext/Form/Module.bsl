&НаСервере
Процедура ВвестиНаОсновании(ДокументОснования, Разделитель)
	ТекОбъект = РеквизитФормыВЗначение("Объект", Тип("ДокументОбъект.ПередачаОбъектовОС"));
	ДанныеЗаполнения = Новый Структура("ДокументОснование, Разделитель, ВводНаОсновании, СсылкаЦелевогоДокумента",
		ДокументОснования, Разделитель, Истина, Неопределено);
	ТекОбъект.Заполнить(ДанныеЗаполнения);
	МассивОС = ТекОбъект.ОсновныеСредства.ВыгрузитьКолонку("ОсновноеСредство");
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство,
	|	ОсновныеСредства.ГрупповойУчет КАК ГрупповойУчет
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В (&МассивОС)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивОС", МассивОС);
	ТабОС = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ПриИзмененииСчетУчета(ТекущаяСтрока);
		ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущаяСтрока);
		
		НайденнаяСтрока = ТабОС.Найти(ТекущаяСтрока.ОсновноеСредство, "ОсновноеСредство");
		Если НайденнаяСтрока <> Неопределено Тогда
			ТекущаяСтрока.ГрупповойУчет = НайденнаяСтрока.ГрупповойУчет; 
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииСчетУчета(ТекущиеДанные)
	Если Не ЗначениеЗаполнено(ТекущиеДанные.СчетУчета) Тогда
		ТекущиеДанные.УчетПоКПС = Ложь;
	Иначе
		ТекущиеДанные.УчетПоКПС = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.СчетУчета).УчетПоКПС;
	КонецЕсли;
КонецПроцедуры	

