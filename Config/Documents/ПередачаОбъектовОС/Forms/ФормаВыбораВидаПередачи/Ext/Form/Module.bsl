#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для каждого ЗначениеПеречисления Из Метаданные.Перечисления.ВидыОперацийПередачиОС.ЗначенияПеречисления Цикл
	
		СписокВидовОпераций.Добавить(Перечисления.ВидыОперацийПередачиОС[ЗначениеПеречисления.Имя]);
	
	КонецЦикла;
	
	Если Параметры.Свойство("ЗначенияЗаполнения")
		И ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура") Тогда
		
		ПереданныеЗначенияЗаполнения = Новый ФиксированнаяСтруктура(Параметры.ЗначенияЗаполнения);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СписокВидовОперацийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	КлючеваяОперация ="СозданиеФормыПередачаОбъектовОС";
	ОценкаПроизводительностиКлиент.ЗамерВремени(КлючеваяОперация);
		
	ПараметрыДокумента = Новый Структура;
	Если ЗначениеЗаполнено(ПереданныеЗначенияЗаполнения) Тогда
		ПараметрыДокумента.Вставить("ЗначенияЗаполнения", Новый Структура(ПереданныеЗначенияЗаполнения));
	Иначе
		ПараметрыДокумента.Вставить("ЗначенияЗаполнения", Новый Структура);
	КонецЕсли;
	ПараметрыДокумента.ЗначенияЗаполнения.Вставить("ВидОперации", СписокВидовОпераций[ВыбраннаяСтрока].Значение);
	ОткрытьФорму("Документ.ПередачаОбъектовОС.ФормаОбъекта", ПараметрыДокумента);
	Закрыть();
	
КонецПроцедуры

#КонецОбласти
