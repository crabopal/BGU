#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьДанныеФормы();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДекорацияДоговорНажатие(Элемент)
	Если ЗначениеЗаполнено(Договор) Тогда
		ПараметрыФормы = Новый Структура("Ключ", Договор);
		ОткрытьФорму("Справочник.Договоры.Форма.ФормаЭлемента", ПараметрыФормы);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияКонтрагентНажатие(Элемент)
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ПараметрыФормы = Новый Структура("Ключ", Контрагент);
		ОткрытьФорму("Справочник.Контрагенты.Форма.ФормаЭлемента", ПараметрыФормы);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаОбременения

&НаКлиенте
Процедура ТаблицаОбремененияПередНачаломИзменения(Элемент, Отказ)
	Если Элемент.ТекущийЭлемент.Имя = "ТаблицаОбремененияКодОшибки" Тогда
		ПараметрыФормы = Новый Структура("Ключ, ОткрытьНаЗакладкеОбременения", 
			Элементы.ТаблицаОбременения.ТекущиеДанные.ИнвентарныйНомер, Истина);
		ОткрытьФорму("Справочник.ИнвентарныеНомераОС.Форма.ФормаЭлемента", ПараметрыФормы, Элемент);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОбремененияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ТаблицаОбремененияИнвентарныйНомер" Тогда
		СтандартнаяОбработка = Ложь;
		ТекСтрока = ТаблицаОбременения.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если ТекСтрока <> Неопределено Тогда
			ПараметрыФормы = Новый Структура("Ключ, ОткрытьНаЗакладкеОбременения", ТекСтрока.ИнвентарныйНомер, Истина);
			ОткрытьФорму("Справочник.ИнвентарныеНомераОС.Форма.ФормаЭлемента", ПараметрыФормы, Элемент);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗарегистрироватьОбременения(Команда)
	ОчиститьСообщения();
	
	ТекстСообщения = "";
	Если НЕ ЗарегистрироватьОбремененияНаСервере(ТекстСообщения) Тогда
		Если ЗначениеЗаполнено(ТекстСообщения) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
	Иначе
		ПоказатьОповещениеПользователя(Нстр("ru = 'Обременения успешно зарегистрированы'"));
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьСтроку(Команда)
	ТекДанные = Элементы.ТаблицаОбременения.ТекущиеДанные;
	НоваяСтрока = ТаблицаОбременения.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекДанные,, "КодОшибки");
	Элементы.ТаблицаОбременения.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтроку(Команда)
	ТаблицаОбременения.Удалить(ТаблицаОбременения.НайтиПоИдентификатору(Элементы.ТаблицаОбременения.ТекущаяСтрока));	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДанныеФормы()
	Контрагент = Параметры.Контрагент;
	Договор = Параметры.Договор;
	ВидОбременения = ВидОбремененияПоВидуОперации(Параметры.ВидОперации);

	ТаблицаОбременения.Очистить();
	Если ТипЗнч(Параметры.Объекты) = Тип("Массив") Тогда
		Для каждого СтрокаОбъекта из Параметры.Объекты Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаОбременения.Добавить(), СтрокаОбъекта);
		КонецЦикла;
	КонецЕсли;		
	
	ОбновитьНадписиНаФорме();
КонецПроцедуры

&НаСервере
Функция ВидОбремененияПоВидуОперации(ВидОперации)
	Результат = "";
	Если ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСАренда
		ИЛИ ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда 
		ИЛИ ВидОперации = Перечисления.ВидыОперацийИК.ПередачаАренда 
		ИЛИ ВидОперации = Перечисления.ВидыОперацийИК.ПередачаИКвФинансовуюАренду Тогда
		Результат = "Аренда"; 
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСвУправление
		ИЛИ ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетВУправление
		ИЛИ ВидОперации = Перечисления.ВидыОперацийИК.ПередачаУправление Тогда
		Результат = "Доверительное управление"; 
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСвПользование
		ИЛИ ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование 
		ИЛИ ВидОперации = Перечисления.ВидыОперацийИК.ПередачаБезмозмездноеПользование
		ИЛИ ВидОперации = Перечисления.ВидыОперацийИК.ПередачаЗемУчастковВПользование Тогда 
		Результат = "Безвозмездное пользование"; 
	КонецЕсли;	
		
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ОбновитьНадписиНаФорме()
	Элементы.ДекорацияКонтрагент.Заголовок = Строка(Контрагент); 
	Элементы.ДекорацияДоговор.Заголовок = Строка(Договор); 
	Элементы.ДекорацияВидОбременения.Заголовок = Строка(ВидОбременения); 
КонецПроцедуры	

&НаСервере
Функция ТекстЗапросаДляРегистрацииОбремененийСКонтролем()
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаОбременения.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОбременения.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОбременения.НаименованиеЧасти КАК НаименованиеЧасти,
	|	ТаблицаОбременения.РазмерЧасти КАК РазмерЧасти,
	|	ТаблицаОбременения.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаОбременения.ДатаНачала КАК ДатаНачала,
	|	ТаблицаОбременения.ДатаОкончания КАК ДатаОкончания,
	|	ТаблицаОбременения.ДокументРегистрацииДата КАК ДокументРегистрацииДата,
	|	ТаблицаОбременения.ДокументРегистрацииНомер КАК ДокументРегистрацииНомер,
	|	ТаблицаОбременения.Примечание КАК Примечание,
	|	&ВидОбременения КАК ВидОбременения,
	|	&ДокументОбремененияВид КАК ДокументОбремененияВид,
	|	&ДокументОбремененияДата КАК ДокументОбремененияДата,
	|	&ДокументОбремененияНомер КАК ДокументОбремененияНомер,
	|	&ДокументОбремененияНомерДляСвязи КАК ДокументОбремененияНомерДляСвязи,
	|	&Контрагент КАК Контрагент
	|ПОМЕСТИТЬ ОбремененияИзДокумента
	|ИЗ
	|	&ТаблицаОбременения КАК ТаблицаОбременения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИнвентарныеНомераОСОбременения.Ссылка КАК ИнвентарныйНомер,
	|	ИнвентарныеНомераОСОбременения.Контрагент КАК Контрагент,
	|	ИнвентарныеНомераОСОбременения.ДокументОбремененияНомер КАК ДокументОбремененияНомер,
	|	ВРЕГ(СОКРЛП(ИнвентарныеНомераОСОбременения.ДокументОбремененияНомер)) КАК ДокументОбремененияНомерДляСвязи,
	|	НАЧАЛОПЕРИОДА(ИнвентарныеНомераОСОбременения.ДокументОбремененияДата, День) КАК ДокументОбремененияДата
	|ПОМЕСТИТЬ ОбремененияИзСправочника1
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС.Обременения КАК ИнвентарныеНомераОСОбременения
	|ГДЕ
	|	ИнвентарныеНомераОСОбременения.Ссылка В
	|		(ВЫБРАТЬ
	|			Таб.ИнвентарныйНомер
	|		ИЗ
	|			ОбремененияИзДокумента КАК Таб)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбремененияИзСправочника.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ОбремененияИзСправочника
	|ИЗ
	|	ОбремененияИзСправочника1 КАК ОбремененияИзСправочника
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОбремененияИзДокумента КАК ОбремененияИзДокумента
	|		ПО ОбремененияИзСправочника.Контрагент = ОбремененияИзДокумента.Контрагент
	|		И ОбремененияИзСправочника.ДокументОбремененияДата = ОбремененияИзДокумента.ДокументОбремененияДата
	|		И
	|			ОбремененияИзСправочника.ДокументОбремененияНомерДляСвязи = ОбремененияИзДокумента.ДокументОбремененияНомерДляСвязи
	|		И ОбремененияИзСправочника.ДокументОбремененияДата = ОбремененияИзДокумента.ДокументОбремененияДата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбремененияИзДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ОбремененияИзДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОбремененияИзДокумента.НаименованиеЧасти КАК НаименованиеЧасти,
	|	ОбремененияИзДокумента.РазмерЧасти КАК РазмерЧасти,
	|	ОбремененияИзДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ОбремененияИзДокумента.ДатаНачала КАК ДатаНачала,
	|	ОбремененияИзДокумента.ДатаОкончания КАК ДатаОкончания,
	|	ОбремененияИзДокумента.ДокументРегистрацииДата КАК ДокументРегистрацииДата,
	|	ОбремененияИзДокумента.ДокументРегистрацииНомер КАК ДокументРегистрацииНомер,
	|	ОбремененияИзДокумента.Примечание КАК Примечание,
	|	ОбремененияИзДокумента.ВидОбременения КАК ВидОбременения,
	|	ОбремененияИзДокумента.ДокументОбремененияВид КАК ДокументОбремененияВид,
	|	ОбремененияИзДокумента.ДокументОбремененияДата КАК ДокументОбремененияДата,
	|	ОбремененияИзДокумента.ДокументОбремененияНомер КАК ДокументОбремененияНомер,
	|	ОбремененияИзДокумента.Контрагент КАК Контрагент
	|ИЗ
	|	ОбремененияИзДокумента КАК ОбремененияИзДокумента
	|ГДЕ
	|	НЕ ОбремененияИзДокумента.ИнвентарныйНомер В
	|		(ВЫБРАТЬ
	|			Таб.ИнвентарныйНомер
	|		ИЗ
	|			ОбремененияИзСправочника КАК Таб)
	|ИТОГИ
	|ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбремененияИзСправочника.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	1 КАК КодОшибки
	|ИЗ
	|	ОбремененияИзСправочника КАК ОбремененияИзСправочника";
	
	Возврат ТекстЗапроса;
КонецФункции	

&НаСервере
Функция ТекстЗапросаДляРегистрацииОбремененийБезКонтроля()
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаОбременения.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОбременения.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОбременения.НаименованиеЧасти КАК НаименованиеЧасти,
	|	ТаблицаОбременения.РазмерЧасти КАК РазмерЧасти,
	|	ТаблицаОбременения.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаОбременения.ДатаНачала КАК ДатаНачала,
	|	ТаблицаОбременения.ДатаОкончания КАК ДатаОкончания,
	|	ТаблицаОбременения.ДокументРегистрацииДата КАК ДокументРегистрацииДата,
	|	ТаблицаОбременения.ДокументРегистрацииНомер КАК ДокументРегистрацииНомер,
	|	ТаблицаОбременения.Примечание КАК Примечание,
	|	&ВидОбременения КАК ВидОбременения,
	|	&ДокументОбремененияВид КАК ДокументОбремененияВид,
	|	&ДокументОбремененияДата КАК ДокументОбремененияДата,
	|	&ДокументОбремененияНомер КАК ДокументОбремененияНомер,
	|	&ДокументОбремененияНомерДляСвязи КАК ДокументОбремененияНомерДляСвязи,
	|	&Контрагент КАК Контрагент
	|ПОМЕСТИТЬ ОбремененияИзДокумента
	|ИЗ
	|	&ТаблицаОбременения КАК ТаблицаОбременения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбремененияИзДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ОбремененияИзДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОбремененияИзДокумента.НаименованиеЧасти КАК НаименованиеЧасти,
	|	ОбремененияИзДокумента.РазмерЧасти КАК РазмерЧасти,
	|	ОбремененияИзДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ОбремененияИзДокумента.ДатаНачала КАК ДатаНачала,
	|	ОбремененияИзДокумента.ДатаОкончания КАК ДатаОкончания,
	|	ОбремененияИзДокумента.ДокументРегистрацииДата КАК ДокументРегистрацииДата,
	|	ОбремененияИзДокумента.ДокументРегистрацииНомер КАК ДокументРегистрацииНомер,
	|	ОбремененияИзДокумента.Примечание КАК Примечание,
	|	ОбремененияИзДокумента.ВидОбременения КАК ВидОбременения,
	|	ОбремененияИзДокумента.ДокументОбремененияВид КАК ДокументОбремененияВид,
	|	ОбремененияИзДокумента.ДокументОбремененияДата КАК ДокументОбремененияДата,
	|	ОбремененияИзДокумента.ДокументОбремененияНомер КАК ДокументОбремененияНомер,
	|	ОбремененияИзДокумента.ДокументОбремененияНомерДляСвязи КАК ДокументОбремененияНомерДляСвязи,
	|	ОбремененияИзДокумента.Контрагент КАК Контрагент
	|ИЗ
	|	ОбремененияИзДокумента КАК ОбремененияИзДокумента
	|ИТОГИ
	|ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер";
	
	Возврат ТекстЗапроса;
КонецФункции	

&НаСервере
Функция ЗарегистрироватьОбремененияНаСервере(ТекстСообщения = "")
	Если ТаблицаОбременения.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнена таблица обременений.'");
		Возврат Ложь;
	КонецЕсли;	
	
	Если НеКонтролироватьДубли Тогда
		ТекстЗапроса = ТекстЗапросаДляРегистрацииОбремененийБезКонтроля();
	Иначе
		ТекстЗапроса = ТекстЗапросаДляРегистрацииОбремененийСКонтролем();
	КонецЕсли;	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ВидОбременения", ВидОбременения);
	Если ЗначениеЗаполнено(Договор) Тогда
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, 
			"ВидОбязательства, ДатаДоговора, НомерДоговора");
		Запрос.УстановитьПараметр("ДокументОбремененияВид", РеквизитыДоговора.ВидОбязательства);
		Запрос.УстановитьПараметр("ДокументОбремененияНомер", РеквизитыДоговора.НомерДоговора);
		Запрос.УстановитьПараметр("ДокументОбремененияНомерДляСвязи", СокрЛП(ВРЕГ(РеквизитыДоговора.НомерДоговора)));
		Запрос.УстановитьПараметр("ДокументОбремененияДата", НачалоДня(РеквизитыДоговора.ДатаДоговора));
	Иначе
		Запрос.УстановитьПараметр("ДокументОбремененияВид", "");
		Запрос.УстановитьПараметр("ДокументОбремененияНомер", "");
		Запрос.УстановитьПараметр("ДокументОбремененияНомерДляСвязи", "");
		Запрос.УстановитьПараметр("ДокументОбремененияДата", '00010101');
	КонецЕсли;		
	
	Запрос.УстановитьПараметр("ТаблицаОбременения", ТаблицаОбременения.Выгрузить());
	Результат = Запрос.ВыполнитьПакет();
	
	Текст = НСтр("ru = 'Обременения по выделенным строкам не были зарегистрированы, т.к. обременения по такому документу-основания (договору) уже зарегистрированы ранее.
	|Кликните на пиктограмму или инвентарный номер в строке, чтобы открыть закладку ""Обременения"" инвентарного номера.'");
	Если НеКонтролироватьДубли Тогда
		ВыборкаРегистрируемых = Результат[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

		НезарегистрированныеОбременения = Новый ТаблицаЗначений();
		НезарегистрированныеОбременения.Колонки.Добавить(
			"ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
		НезарегистрированныеОбременения.Колонки.Добавить("КодОшибки", Новый ОписаниеТипов("Число")); // КодОшибки:
		// 0 - ошибки нет
		// 1 - уже есть такое обременение (дублирование)
		// 2 - не удалось заблокировать инвентарный номер
	Иначе	
		ВыборкаРегистрируемых = Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		НезарегистрированныеОбременения = Результат[4].Выгрузить();
	КонецЕсли;	
		
	Если ВыборкаРегистрируемых.Количество() = 0 Тогда
		ТекстСообщения = Текст;
		ЗаполнитьКодОшибкиВТаблице(НезарегистрированныеОбременения);
		Возврат(Ложь);
	КонецЕсли;
	
	Пока ВыборкаРегистрируемых.Следующий() Цикл
		// выборка по ОС
		ВыборкаПоИнвНомерам = ВыборкаРегистрируемых.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		Пока ВыборкаПоИнвНомерам.Следующий() Цикл
			// выборка по инвентарным номерам
			Попытка
				ИнвОбъект = ВыборкаПоИнвНомерам.ИнвентарныйНомер.ПолучитьОбъект();
				ВыборкаДетальная = ВыборкаПоИнвНомерам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаДетальная.Следующий() Цикл
					// выборка по обременениям инвентарного номера	
					НоваяСтрока = ИнвОбъект.Обременения.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальная);
				КонецЦикла;
				ИнвОбъект.ОбменДанными.Загрузка = Истина;
				ИнвОбъект.Записать();
			Исключение
				Если НезарегистрированныеОбременения.Найти(ВыборкаПоИнвНомерам.ИнвентарныйНомер, 
					"ИнвентарныйНомер") = Неопределено Тогда
					НоваяСтрока = НезарегистрированныеОбременения.Добавить();
					НоваяСтрока.ИнвентарныйНомер = ВыборкаПоИнвНомерам.ИнвентарныйНомер;				
					НоваяСтрока.КодОшибки = 2;				
				КонецЕсли;	
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
			
	Если НезарегистрированныеОбременения.Количество() <> 0 Тогда
		ТекстСообщения = Текст;
	КонецЕсли;
	
	ЗаполнитьКодОшибкиВТаблице(НезарегистрированныеОбременения);
	Возврат(НезарегистрированныеОбременения.Количество() = 0);
КонецФункции

&НаСервере
Процедура ЗаполнитьКодОшибкиВТаблице(НезарегистрированныеОбременения)
	Для каждого ТекСтрока из ТаблицаОбременения Цикл
		СтрокаОшибки = НезарегистрированныеОбременения.Найти(ТекСтрока.ИнвентарныйНомер, "ИнвентарныйНомер"); 
		Если СтрокаОшибки = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		ТекСтрока.КодОшибки = СтрокаОшибки.КодОшибки; 
	КонецЦикла;	
КонецПроцедуры	

#КонецОбласти
