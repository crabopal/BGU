#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу разделителей для формирования нескольких документов "Обесценение ОС" на основании одного документа
// 
// Параметры:
//  - ДокументОснование - ДокументСсылка.ИнвентаризационнаяОписьНФА  - документ-основание
//  - СсылкаЦелевогоДокумента - ДокументСсылка.ОбесценениеОС - ссылка на текущий документ.
//						Следует передавать, только, если ссылка не пустая. Если передан, то данные этого 
//                      документа не учитываются, как отработанные. Передается, если документ заполняется
//                      из формы самого документа (при выборе документа-основания)
//
// Возвращаемое значение:
// 	- Структура с ключами:
//    * Разделители, значение - ТаблицаЗначений - таблица разделителей документов с полями, 
//    	соответствующими составу разделителя: 
//    * ЗаголовкиКолонок, значение - Структура - структкра содержит в качестве ключей имена колонок
//        таблицы "Разделители", а в качестве значений заголовки этих колонок
Функция ТаблицаРазделителейДокументов(ДокументОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт  
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		Возврат ТаблицаРазделителейДокументов_ИнвентаризационнаяОписьНФА(ДокументОснование, СсылкаЦелевогоДокумента);
	КонецЕсли;	
КонецФункции	

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК ДокументОтклонения,
	|	ОсновныеСредства.Ссылка.ДокументОснование КАК ДокументИнвентаризации,
	|	ОсновныеСредства.ОсновноеСредство КАК НФА,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Обесценение) КАК ВидОтклонения,
	|	ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка) КАК МестоИнвентаризации,
	|	1 КАК Количество
	|ИЗ
	|	Документ.ОбесценениеОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка.ДокументОснование В(&ДокументыИнвентаризации)
	|	И НЕ ОсновныеСредства.Ссылка = &ОбесценениеОССсылка
	|	И НЕ ОсновныеСредства.Ссылка.ПометкаУдаления";
	
	Возврат ТекстЗапроса;
КонецФункции	

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ПериодДокумента = ДокументСсылка.МоментВремени();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("Период", ПериодДокумента);
	
	ТаблицыЗапроса = Новый Массив;
	ТаблицыЗапроса.Добавить("ТаблицаДокумента");
	ТаблицыЗапроса.Добавить("АмортизацияОбъектовОС");
	ТаблицыЗапроса.Добавить("ВТ_РасчетАмортизацииОССрезПоследних");
	ТаблицыЗапроса.Добавить("РасчетАмортизацииОС");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка.Дата КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.Сумма КАК Сумма,
	|	ОсновныеСредства.СрокПолезногоИспользованияНовый КАК СрокПолезногоИспользования,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.СрокПолезногоИспользованияНовый <= ОсновныеСредства.СрокЭксплуатацииФакт
	|			ТОГДА 1
	|		ИНАЧЕ ОсновныеСредства.СрокПолезногоИспользованияНовый - ОсновныеСредства.СрокЭксплуатацииФакт
	|	КОНЕЦ КАК ОстаточныйСрокПолезногоИспользования,
	|	ОсновныеСредства.БалансоваяСтоимость - ОсновныеСредства.СуммаАмортизации - ОсновныеСредства.СуммаОбесценения - ОсновныеСредства.Сумма КАК ОстаточнаяСтоимость
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	Документ.ОбесценениеОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И ОсновныеСредства.Сумма <> 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Сумма > 0
	|			ТОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	КОНЕЦ КАК ВидДвижения,
	|	ТаблицаДокумента.Период КАК Период,
	|	ТаблицаДокумента.Организация КАК Организация,
	|	ТаблицаДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	0 КАК СуммаАмортизации,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Сумма > 0
	|			ТОГДА ТаблицаДокумента.Сумма
	|		ИНАЧЕ -ТаблицаДокумента.Сумма
	|	КОНЕЦ КАК СуммаОбесценения,
	|	ЛОЖЬ КАК ЭтоСписание
	|ИЗ
	|	ТаблицаДокумента КАК ТаблицаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетАмортизацииОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	РасчетАмортизацииОССрезПоследних.КоэффициентУскорения КАК КоэффициентУскорения,
	|	РасчетАмортизацииОССрезПоследних.ПараметрВыработки КАК ПараметрВыработки,
	|	РасчетАмортизацииОССрезПоследних.ПредполагаемыйОбъемВыработки КАК ПредполагаемыйОбъемВыработки
	|ПОМЕСТИТЬ ВТ_РасчетАмортизацииОССрезПоследних
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	|			&Период,
	|			ОсновноеСредство В
	|				(ВЫБРАТЬ
	|					ТаблицаДокумента.ОсновноеСредство
	|				ИЗ
	|					ТаблицаДокумента КАК ТаблицаДокумента)) КАК РасчетАмортизацииОССрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаДокумента.Период КАК Период,
	|	ТаблицаДокумента.Организация КАК Организация,
	|	ТаблицаДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаДокумента.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
	|	ТаблицаДокумента.ОстаточныйСрокПолезногоИспользования КАК СрокИспользованияДляВычисленияАмортизации,
	|	ТаблицаДокумента.ОстаточнаяСтоимость КАК СтоимостьДляВычисленияАмортизации,
	|	ВТ_РасчетАмортизацииОССрезПоследних.КоэффициентУскорения КАК КоэффициентУскорения,
	|	ВТ_РасчетАмортизацииОССрезПоследних.ПараметрВыработки КАК ПараметрВыработки,
	|	ВТ_РасчетАмортизацииОССрезПоследних.ПредполагаемыйОбъемВыработки КАК ПредполагаемыйОбъемВыработки
	|ИЗ
	|	ТаблицаДокумента КАК ТаблицаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РасчетАмортизацииОССрезПоследних КАК ВТ_РасчетАмортизацииОССрезПоследних
	|		ПО ТаблицаДокумента.ОсновноеСредство = ВТ_РасчетАмортизацииОССрезПоследних.ОсновноеСредство";
	
	Результат = Запрос.ВыполнитьПакет();
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
	
КонецПроцедуры

#КонецОбласти

