	Возврат Новый Структура("Счет, Субконто1, Субконто2, Субконто3, КПС, КЭК, Подразделение",
		"Объект.ОсновныеСредства.СчетДоходовРасходов",
		"Объект.ОсновныеСредства.СубконтоДоходовРасходов1",
		"Объект.ОсновныеСредства.СубконтоДоходовРасходов2",
		"Объект.ОсновныеСредства.СубконтоДоходовРасходов3",
		"Объект.ОсновныеСредства.КПСДоходовРасходов",
		"Объект.ОсновныеСредства.КЭКДоходовРасходов",
		"Объект.ОсновныеСредства.ПодразделениеДоходовРасходов");

