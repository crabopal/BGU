#Область ОбработчикиСобытийЭлементовТаблицыФормы_ОсновныеСредства

&НаКлиенте
Процедура ОсновныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда
		ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
		ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтроке(ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	ПараметрыЗапроса = Новый Структура("Дата, Организация, ИФО");
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Объект);
	ПараметрыЗапроса.Вставить("ИспользоватьУчетПоИФО",
		ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО);
	ПараметрыЗапроса.Вставить("ИспользоватьУчетПоПодразделениям",
		ЭтотОбъект.КэшПараметров.Локальные.ВедетсяУчетОСПоПодразделениям);
		
	ОС = ТекущиеДанные.ОсновноеСредство;
	ДанныеОС = ПолучитьДанныеОС(ПараметрыЗапроса, ОС);
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеОС);
	ТекущиеДанные.ОсновноеСредство = ОС;
	
	ОсновныеСредстваРассчитатьСтроку(ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСправедливаяСтоимостьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ОсновныеСредстваРассчитатьСтроку(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваЗатратыНаВыбытиеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ОсновныеСредстваРассчитатьСтроку(ТекущиеДанные);
	
КонецПроцедуры

&НаСервере
Процедура ОсновныеСредстваОбработкаВыбораПодбораНаСервере(Знач ВыбранноеЗначение)
	
	ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище); 
	
	ИсходныеДанные = Объект.ОсновныеСредства.Выгрузить();
	ИсходныеДанные.Индексы.Добавить("ОсновноеСредство, ИнвентарныйНомер");
	
	СтруктураПоиска = Новый Структура("ОсновноеСредство, ИнвентарныйНомер");
	
	Объект.ОсновныеСредства.Очистить();
	
	Для Каждого СтрокаТаблицыОС Из ТаблицаОС Цикл
		
		НоваяСтрока = Объект.ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыОС);
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТаблицыОС);
		
		СтрокиИсходныхДанных = ИсходныеДанные.НайтиСтроки(СтруктураПоиска);
		Если СтрокиИсходныхДанных.Количество() > 0 Тогда
			СправедливаяСтоимость			= СтрокиИсходныхДанных[0].СправедливаяСтоимость;
			СрокПолезногоИспользования		= СтрокиИсходныхДанных[0].СрокПолезногоИспользования;
			СрокПолезногоИспользованияНовый	= СтрокиИсходныхДанных[0].СрокПолезногоИспользованияНовый;
			СрокЭксплуатацииФакт			= СтрокиИсходныхДанных[0].СрокЭксплуатацииФакт;
			
		Иначе
			СправедливаяСтоимость			= НоваяСтрока.БалансоваяСтоимость - НоваяСтрока.СуммаАмортизации - НоваяСтрока.СуммаОбесценения;
			СрокПолезногоИспользования		= СрокПолезногоИспользованияОС(НоваяСтрока.ОсновноеСредство, Объект.Дата);
			СрокПолезногоИспользованияНовый	= СрокПолезногоИспользования;
			СрокЭксплуатацииФакт			= СрокФактическогоИспользованияОС(Объект.Организация,
				НоваяСтрока.ОсновноеСредство, НоваяСтрока.ИнвентарныйНомер, Объект.Дата);
		КонецЕсли;
		
		НоваяСтрока.СправедливаяСтоимость			= СправедливаяСтоимость;
		НоваяСтрока.СрокПолезногоИспользования		= СрокПолезногоИспользования;
		НоваяСтрока.СрокПолезногоИспользованияНовый	= СрокПолезногоИспользованияНовый;
		НоваяСтрока.СрокЭксплуатацииФакт			= СрокЭксплуатацииФакт;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

