&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВедетсяУчетОСПоПодразделениям",
		УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям());
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОсновныеСредстваПодразделение", "Видимость", ЭтотОбъект.КэшПараметров.Локальные.ВедетсяУчетОСПоПодразделениям);
	
	ОсновныеСредстваЗаполнитьДобавленныеКолонкиВсехСтрок();
	ФинансовыйРезультатЗаполнитьДобавленныеКолонки(ЭтотОбъект);
	
	АналитикаПоДокументу = ЗаполнитьСчетаДоходовРасходов(ЭтаФорма);
	
	УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект, Объект, "СчетДоходов");
	УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект, Объект, "СчетРасходов");	
		
	Элементы.СтраницыСчетФинРез.ТекущаяСтраница = ?(АналитикаПоДокументу,
		Элементы.СтраницаПоДокументу, Элементы.СтраницаПоОбъектам);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполнитьСчетаДоходовРасходов(Форма)
	
	СтрокаСчетРасходов = Неопределено;
	СтрокаСчетДоходов = Неопределено;
	ПоДокументу = Истина;
	
	Для Каждого СтрокаТаблицы Из Форма.Объект.ОсновныеСредства Цикл
		
		Если СтрокаТаблицы.Сумма >= 0 Тогда // Счет расхода
			
			Если СтрокаСчетРасходов = Неопределено Тогда
				СтрокаСчетРасходов = СтрокаТаблицы;
			Иначе
				Если СтрокаТаблицы.СчетДоходовРасходов <> СтрокаСчетРасходов.СчетДоходовРасходов
					Или СтрокаТаблицы.КПСДоходовРасходов <> СтрокаСчетРасходов.КПСДоходовРасходов
					Или СтрокаТаблицы.КЭКДоходовРасходов <> СтрокаСчетРасходов.КЭКДоходовРасходов
					Или СтрокаТаблицы.ПодразделениеДоходовРасходов <> СтрокаСчетРасходов.ПодразделениеДоходовРасходов
					Или СтрокаТаблицы.СубконтоДоходовРасходов1 <> СтрокаСчетРасходов.СубконтоДоходовРасходов1
					Или СтрокаТаблицы.СубконтоДоходовРасходов2 <> СтрокаСчетРасходов.СубконтоДоходовРасходов2
					Или СтрокаТаблицы.СубконтоДоходовРасходов3 <> СтрокаСчетРасходов.СубконтоДоходовРасходов3 Тогда
					ПоДокументу = Ложь;
				КонецЕсли;				
			КонецЕсли;
			
		Иначе // Счет дохода
			
			Если СтрокаСчетДоходов = Неопределено Тогда
				СтрокаСчетДоходов = СтрокаТаблицы;
			Иначе
				Если СтрокаТаблицы.СчетДоходовРасходов <> СтрокаСчетДоходов.СчетДоходовРасходов
					Или СтрокаТаблицы.КПСДоходовРасходов <> СтрокаСчетДоходов.КПСДоходовРасходов
					Или СтрокаТаблицы.КЭКДоходовРасходов <> СтрокаСчетДоходов.КЭКДоходовРасходов
					Или СтрокаТаблицы.ПодразделениеДоходовРасходов <> СтрокаСчетДоходов.ПодразделениеДоходовРасходов
					Или СтрокаТаблицы.СубконтоДоходовРасходов1 <> СтрокаСчетДоходов.СубконтоДоходовРасходов1
					Или СтрокаТаблицы.СубконтоДоходовРасходов2 <> СтрокаСчетДоходов.СубконтоДоходовРасходов2
					Или СтрокаТаблицы.СубконтоДоходовРасходов3 <> СтрокаСчетДоходов.СубконтоДоходовРасходов3 Тогда
					ПоДокументу = Ложь;
				КонецЕсли;				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтрокаСчетДоходов <> Неопределено Тогда
		
		Форма.СчетДоходов			= СтрокаСчетДоходов.СчетДоходовРасходов;
		Форма.КПСДоходов			= СтрокаСчетДоходов.КПСДоходовРасходов;
		Форма.КЭКДоходов			= СтрокаСчетДоходов.КЭКДоходовРасходов;
		Форма.ПодразделениеДоходов	= СтрокаСчетДоходов.ПодразделениеДоходовРасходов;
		Форма.СубконтоДоходов1		= СтрокаСчетДоходов.СубконтоДоходовРасходов1;
		Форма.СубконтоДоходов2		= СтрокаСчетДоходов.СубконтоДоходовРасходов2;
		Форма.СубконтоДоходов3		= СтрокаСчетДоходов.СубконтоДоходовРасходов3;
		
	КонецЕсли;
	
	Если СтрокаСчетРасходов <> Неопределено Тогда
		
		Форма.СчетРасходов			= СтрокаСчетРасходов.СчетДоходовРасходов;
		Форма.КПСРасходов			= СтрокаСчетРасходов.КПСДоходовРасходов;
		Форма.КЭКРасходов			= СтрокаСчетРасходов.КЭКДоходовРасходов;
		Форма.ПодразделениеРасходов	= СтрокаСчетРасходов.ПодразделениеДоходовРасходов;
		Форма.СубконтоРасходов1		= СтрокаСчетРасходов.СубконтоДоходовРасходов1;
		Форма.СубконтоРасходов2		= СтрокаСчетРасходов.СубконтоДоходовРасходов2;
		Форма.СубконтоРасходов3		= СтрокаСчетРасходов.СубконтоДоходовРасходов3;
		
	КонецЕсли;
	
	Возврат ПоДокументу;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСчетДоходовРасходов(Направление)
	
	Если Направление = "ПоОбъектам" Тогда
		
		Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
			
			Если СтрокаТаблицы.Сумма >= 0 Тогда
				СтрокаТаблицы.СчетДоходовРасходов			= СчетРасходов;
				СтрокаТаблицы.КПСДоходовРасходов			= КПСРасходов;
				СтрокаТаблицы.КЭКДоходовРасходов			= КЭКРасходов;
				СтрокаТаблицы.ПодразделениеДоходовРасходов	= ПодразделениеРасходов;
				СтрокаТаблицы.СубконтоДоходовРасходов1		= СубконтоРасходов1;
				СтрокаТаблицы.СубконтоДоходовРасходов2		= СубконтоРасходов2;
				СтрокаТаблицы.СубконтоДоходовРасходов3		= СубконтоРасходов3;
			Иначе
				СтрокаТаблицы.СчетДоходовРасходов			= СчетДоходов;
				СтрокаТаблицы.КПСДоходовРасходов			= КПСДоходов;
				СтрокаТаблицы.КЭКДоходовРасходов			= КЭКДоходов;
				СтрокаТаблицы.ПодразделениеДоходовРасходов	= ПодразделениеДоходов;
				СтрокаТаблицы.СубконтоДоходовРасходов1		= СубконтоДоходов1;
				СтрокаТаблицы.СубконтоДоходовРасходов2		= СубконтоДоходов2;
				СтрокаТаблицы.СубконтоДоходовРасходов3		= СубконтоДоходов3;
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли Направление = "ПоДокументу" Тогда
		
		ЗаполнитьСчетаДоходовРасходов(ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИДоступностьСубконто(Форма, Объект, ИмяРеквизитаСчет)

	МассивПолей = Новый Массив;
	
	Если ИмяРеквизитаСчет = "СчетРасходов" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Подразделение", "ПодразделениеРасходов", "ПодразделениеРасходов", Истина, "ПодразделениеРасходов", Ложь, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоРасходов1", "СубконтоРасходов1", Истина, "СубконтоРасходов1", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоРасходов2", "СубконтоРасходов2", Истина, "СубконтоРасходов2", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоРасходов3", "СубконтоРасходов3", Истина, "СубконтоРасходов3", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Форма.СчетРасходов, Форма, Форма, МассивПолей);
		
	ИначеЕсли ИмяРеквизитаСчет = "СчетДоходов" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Подразделение", "ПодразделениеДоходов", "ПодразделениеДоходов", Истина, "ПодразделениеДоходов", Ложь, Истина, Истина);		
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоДоходов1", "СубконтоДоходов1", Истина, "СубконтоДоходов1", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоДоходов2", "СубконтоДоходов2", Истина, "СубконтоДоходов2", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоДоходов3", "СубконтоДоходов3", Истина, "СубконтоДоходов3", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Форма.СчетДоходов, Форма, Форма, МассивПолей);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОсновныеСредстваЗаполнитьДобавленныеКолонкиВсехСтрок()
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтроке(СтрокаТаблицы);
		ОсновныеСредстваРассчитатьКолонкиВСтроке(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваРассчитатьВсеСтроки()
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтроке(СтрокаТаблицы);
		ОсновныеСредстваРассчитатьСтроку(СтрокаТаблицы);		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ФинансовыйРезультатЗаполнитьДобавленныеКолонки(Форма)
	
	Если Форма.АналитикаПоДокументу Тогда
		Возврат;
	КонецЕсли;
	
	Объект = Форма.Объект;
	
	Для Каждого СтрокаТаблицы Из Объект.ОсновныеСредства Цикл
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаТаблицы, СтрокаТаблицы.СчетДоходовРасходов, ПараметрыАналитикиСчетаДоходовРасходов());
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтроке(ТекущаяСтрока)
	
	ТекущаяСтрока.ЗаголовокСправедливаяСтоимость			= НСтр("ru = 'справедливая стоимость:'");
	ТекущаяСтрока.ЗаголовокЗатраты							= НСтр("ru = 'затраты на выбытие:'");
	ТекущаяСтрока.ЗаголовокСуммаОбесценения					= НСтр("ru = 'признать убыток:'");
	ТекущаяСтрока.ЗаголовокСуммаВосстановления				= НСтр("ru = 'восстановить убыток:'");
	
	ТекущаяСтрока.ЗаголовокБалансоваяСтоимость				= НСтр("ru = 'балансовая стоимость:'");
	ТекущаяСтрока.ЗаголовокАмортизация						= НСтр("ru = 'накопленная амортизация:'");
	ТекущаяСтрока.ЗаголовокОбесценение						= НСтр("ru = 'накопленное обесценение:'");
	ТекущаяСтрока.ЗаголовокОстаточнаяСтоимость				= НСтр("ru = 'остаточная стоимость:'");
	
	ТекущаяСтрока.ЗаголовокСрокИспользованияДоИзменения		= НСтр("ru = 'до изменения:'");
	ТекущаяСтрока.ЗаголовокСрокИспользованияПослеИзменения	= НСтр("ru = 'после изменения:'");
	ТекущаяСтрока.ЗаголовокСрокИспользованияФактический		= НСтр("ru = 'фактический:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОсновныеСредстваРассчитатьКолонкиВСтроке(ТекущаяСтрока)
	
	ТекущаяСтрока.СуммаУбыткаПризнаваемая		= Макс(+ТекущаяСтрока.Сумма, 0);
	ТекущаяСтрока.СуммаУбыткаВосстанавливаемая	= Макс(-ТекущаяСтрока.Сумма, 0);
	ТекущаяСтрока.СуммаОбесцененияПосле			= ТекущаяСтрока.СуммаОбесценения + ТекущаяСтрока.Сумма;
	ТекущаяСтрока.ОстаточнаяСтоимостьДо			= ТекущаяСтрока.БалансоваяСтоимость - ТекущаяСтрока.СуммаАмортизации - ТекущаяСтрока.СуммаОбесценения; 
	ТекущаяСтрока.ОстаточнаяСтоимостьПосле		= ТекущаяСтрока.БалансоваяСтоимость - ТекущаяСтрока.СуммаАмортизации - ТекущаяСтрока.СуммаОбесцененияПосле;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОсновныеСредстваРассчитатьСтроку(СтрокаТаблицы)
	
	ОстаточнаяСтоимость = СтрокаТаблицы.БалансоваяСтоимость - СтрокаТаблицы.СуммаАмортизации - СтрокаТаблицы.СуммаОбесценения;
	
	СтрокаТаблицы.Сумма = ОстаточнаяСтоимость - (СтрокаТаблицы.СправедливаяСтоимость - СтрокаТаблицы.ЗатратыНаВыбытие);
		
	Если СтрокаТаблицы.Сумма > 0 Тогда
		СтрокаТаблицы.Сумма = Мин(ОстаточнаяСтоимость, СтрокаТаблицы.Сумма);
	ИначеЕсли СтрокаТаблицы.Сумма < 0 Тогда
		СтрокаТаблицы.Сумма = - Мин(СтрокаТаблицы.СуммаОбесценения, - СтрокаТаблицы.Сумма);
	КонецЕсли;
	
	ОсновныеСредстваРассчитатьКолонкиВСтроке(СтрокаТаблицы);
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Дата");
	СтруктураРеквизитов.Вставить("Организация");
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		СтруктураРеквизитов.Вставить("ИФО");
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения"		, ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе"));
	ПараметрыПодбора.Вставить("НужнаАмортизация"	, Истина);
	ПараметрыПодбора.Вставить("КолонкиКорзины"		, Новый Структура("Сумма", "БалансоваяСтоимость"));
	ПараметрыПодбора.Вставить("СкрытьКолонки"		, "ЦМО,Цена");
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, Параметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОсновныеСредстваОбработкаВыбораПодбораНаСервере(Результат);
		ОсновныеСредстваРассчитатьВсеСтроки();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()

	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить(,
		"ОсновноеСредство,ИнвентарныйНомер,СчетУчета,КФО,КПС,БалансоваяСтоимость,СуммаАмортизации");
	ТаблицаОС.Колонки.Добавить("Количество");
	ТаблицаОС.ЗаполнитьЗначения(1, "Количество");
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеОС(ПараметрыЗапроса, ОтборОС)
	
	Запрос = Новый Запрос;
	ПараметрыЗапроса.Вставить("Период"			, Новый Граница(ПараметрыЗапроса.Дата, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетУчета"		, БухгалтерскийУчет.СписокСчетов("101.00,102.00,103.00,111.60"));
	Запрос.УстановитьПараметр("СчетОбесценения"	, БухгалтерскийУчет.СписокСчетов("114.00"));
	Запрос.УстановитьПараметр("ОС"				, ОтборОС);
	
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЕПСБУОстатки.Счет КАК Счет,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.КПС КАК КПС
	|ПОМЕСТИТЬ ВТ_Учет
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетУчета),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И Субконто1 В (&ОС)) КАК ЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение,
	|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК БалансоваяСтоимость
	|ПОМЕСТИТЬ ВТ_Стоимость
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&ОС)) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АмортизацияОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	АмортизацияОбъектовОСОстатки.СуммаАмортизацииОстаток КАК СуммаАмортизации,
	|	АмортизацияОбъектовОСОстатки.СуммаОбесцененияОстаток КАК СуммаОбесценения
	|ПОМЕСТИТЬ ВТ_Амортизация
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&ОС)) КАК АмортизацияОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетАмортизацииОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	РасчетАмортизацииОССрезПоследних.СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|ПОМЕСТИТЬ ВТ_РасчетАмортизацииОС
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&ОС)) КАК РасчетАмортизацииОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Стоимость.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Стоимость.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Стоимость.БалансоваяСтоимость КАК БалансоваяСтоимость,
	|	ЕСТЬNULL(ВТ_Амортизация.СуммаАмортизации, 0) КАК СуммаАмортизации,
	|	ЕСТЬNULL(ВТ_Амортизация.СуммаОбесценения, 0) КАК СуммаОбесценения,
	|	ВТ_Учет.Счет КАК СчетУчета,
	|	ВТ_Учет.КФО КАК КФО,
	|	ВТ_Учет.КПС КАК КПС,
	|	ВТ_Стоимость.Подразделение КАК Подразделение,
	|	ВТ_РасчетАмортизацииОС.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
	|	ВТ_РасчетАмортизацииОС.СрокПолезногоИспользования КАК СрокПолезногоИспользованияНовый,
	|	ВТ_Стоимость.БалансоваяСтоимость - ЕСТЬNULL(ВТ_Амортизация.СуммаАмортизации, 0) - ЕСТЬNULL(ВТ_Амортизация.СуммаОбесценения, 0) КАК СправедливаяСтоимость,
	|	0 КАК ЗатратыНаВыбытие
	|ИЗ
	|	ВТ_Стоимость КАК ВТ_Стоимость
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Учет КАК ВТ_Учет
	|		ПО ВТ_Стоимость.ОсновноеСредство = ВТ_Учет.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Амортизация КАК ВТ_Амортизация
	|		ПО ВТ_Стоимость.ОсновноеСредство = ВТ_Амортизация.ОсновноеСредство
	|			И ВТ_Стоимость.ИнвентарныйНомер = ВТ_Амортизация.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РасчетАмортизацииОС КАК ВТ_РасчетАмортизацииОС
	|		ПО ВТ_Стоимость.ОсновноеСредство = ВТ_РасчетАмортизацииОС.ОсновноеСредство";
	
	Если Не ПараметрыЗапроса.ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
	КонецЕсли;
	Если Не ПараметрыЗапроса.ИспользоватьУчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СтоимостьОбъектовОСОстатки.Подразделение",
			"ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	ДанныеОС = Запрос.Выполнить().Выгрузить();
	
	// Добавим в таблицу даннные о фактическом сроке использования
	ДанныеОС.Колонки.Добавить("СрокЭксплуатацииФакт",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,0, ДопустимыйЗнак.Неотрицательный)));
	Для Каждого СтрокаОС Из ДанныеОС Цикл
		СтрокаОС.СрокЭксплуатацииФакт = СрокФактическогоИспользованияОС(
			ПараметрыЗапроса.Организация, СтрокаОС.ОсновноеСредство,
			СтрокаОС.ИнвентарныйНомер, ПараметрыЗапроса.Дата);
	КонецЦикла;
	
	Если ТипЗнч(ОтборОС) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		// Вернем структуру свойств для конкретного объекта ОС.
		СтрокаОС = ?(ДанныеОС.Количество() = 0, ДанныеОС.Добавить(), ДанныеОС[0]);
		Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаОС);
	Иначе
		Возврат ДанныеОС;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОстаткиОС()
	
	ПараметрыЗапроса = Новый Структура("Дата, Организация, ИФО");
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Объект);
	ПараметрыЗапроса.Вставить("ИспользоватьУчетПоИФО",
		ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО);
	ПараметрыЗапроса.Вставить("ИспользоватьУчетПоПодразделениям",
		ЭтотОбъект.КэшПараметров.Локальные.ВедетсяУчетОСПоПодразделениям);
	
	ДанныеОС = ПолучитьДанныеОС(ПараметрыЗапроса,
		Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство"));
	
	Для Каждого СтрокаТаблицыОС Из Объект.ОсновныеСредства Цикл
		
		Отбор = Новый Структура("ОсновноеСредство, ИнвентарныйНомер",
			СтрокаТаблицыОС.ОсновноеСредство, СтрокаТаблицыОС.ИнвентарныйНомер);
		СтрокиДанных = ДанныеОС.НайтиСтроки(Отбор);
		
		Если СтрокиДанных.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыОС, СтрокиДанных[0],
				"СчетУчета, КФО, КПС, Подразделение, СрокПолезногоИспользования, СрокЭксплуатацииФакт, БалансоваяСтоимость, СуммаАмортизации, СуммаОбесценения");
		КонецЕсли;
		
		ОсновныеСредстваРассчитатьКолонкиВСтроке(СтрокаТаблицыОС);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СрокПолезногоИспользованияОС(ОсновноеСредство, Дата)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"	, Дата);
	Запрос.УстановитьПараметр("ОС"		, ОсновноеСредство);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РасчетАмортизацииОССрезПоследних.СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(&Период, ОсновноеСредство = &ОС) КАК РасчетАмортизацииОССрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.СрокПолезногоИспользования;
	Иначе
		Результат = 0;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция СрокФактическогоИспользованияОС(Организация, ОсновноеСредство, ИнвентарныйНомер, Дата)
	
	СрокЭксплуатации = УправлениеОсновнымиСредствами.ФактическийСрокЭксплуатации(
		ОсновноеСредство, ИнвентарныйНомер, Организация, Дата);
	
	Возврат СрокЭксплуатации;
	
КонецФункции

&НаКлиенте
Процедура ДокументОснованиеПриИзменении_Завершение(Результат, Параметры) Экспорт                     
	СсылкаЦелевогоДокумента = Неопределено;
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("СсылкаЦелевогоДокумента") Тогда
		СсылкаЦелевогоДокумента = Параметры.СсылкаЦелевогоДокумента;
	КонецЕсли;	
	ВвестиНаОсновании(Объект.ДокументОснование, Результат, СсылкаЦелевогоДокумента);
КонецПроцедуры	

&НаСервере
Процедура ВвестиНаОсновании(ДокументОснования, Разделитель, СсылкаЦелевогоДокумента)
	ТекОбъект = РеквизитФормыВЗначение("Объект", Тип("ДокументОбъект.ОбесценениеОС"));
	ДанныеЗаполнения = Новый Структура("ДокументОснование, Разделитель, ВводНаОсновании, СсылкаЦелевогоДокумента", 
		ДокументОснования, Разделитель, Истина, СсылкаЦелевогоДокумента);
	
	ТекОбъект.Заполнить(ДанныеЗаполнения);
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	ЗаполнитьДанныеУчетаВТЧ(ЭтотОбъект);
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура ЗаполнитьДанныеУчетаВТЧ(Форма)
	Объект = Форма.Объект;
	ПараметрыЗапроса = Новый Структура("Дата, Организация, ИФО");
	ЗаполнитьЗначенияСвойств(ПараметрыЗапроса, Объект);
	ПараметрыЗапроса.Вставить("ИспользоватьУчетПоИФО", Форма.КэшПараметров.ИспользоватьУчетПоИФО);
	ПараметрыЗапроса.Вставить("ИспользоватьУчетПоПодразделениям", 
		Форма.КэшПараметров.Локальные.ВедетсяУчетОСПоПодразделениям);
	ДанныеОС = ПолучитьДанныеОС(ПараметрыЗапроса, Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство"));

	СтруктураПоиска = Новый Структура("ОсновноеСредство, ИнвентарныйНомер");
	Для каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, ТекСтрока);
		НайденныеСтроки = ДанныеОС.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТекСтрока, НайденныеСтроки[0],, "ОсновноеСредство, ИнвентарныйНомер");
		ОсновныеСредстваРассчитатьСтроку(ТекСтрока);
		ОсновныеСредстваЗаполнитьДобавленныеКолонкиВСтроке(ТекСтрока);
	КонецЦикла;
КонецПроцедуры	

