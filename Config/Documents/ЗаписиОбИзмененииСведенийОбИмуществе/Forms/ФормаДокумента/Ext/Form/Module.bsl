#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	Отказ = Ложь;
		
	Если Не ЗначениеЗаполнено(Объект.ДокументИсточник) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Поле ""Текущая версия документа"" не заполнено'"),, "Объект.ДокументИсточник",, Отказ); 
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Поле ""Предыдущая версия документа"" не заполнено'"),, "Объект.ДокументОснование",, Отказ); 
	КонецЕсли;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборДокументов(Команда)
	
	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе, Отбор", Ложь, Новый Структура("Владелец", ОбъектДокумент));
	ОткрытьФорму("Справочник.ОбъектыРеестраИмущества.ФормаВыбора", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

