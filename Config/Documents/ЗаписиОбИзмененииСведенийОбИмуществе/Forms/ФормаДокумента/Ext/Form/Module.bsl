#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление() Экспорт
	
	УсловноеОформление.Элементы.Очистить();
	
	// Раскрас содержания изменений
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("СодержаниеИзменений");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ЗаписьОбИсключении");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементовФормы()
	
	Элементы.СодержаниеИзменений.Доступность = Не Объект.ЗаписьОбИсключении;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	

	Если Не Объект.ЗаписьОбИсключении Тогда
	
		Запрос = Новый Запрос;					   
		Запрос.Текст = "ВЫБРАТЬ
		               |	РеквизитыСведенийОбИмуществе.Ссылка КАК Реквизит
		               |ПОМЕСТИТЬ ВТ_Реквизиты
		               |ИЗ
		               |	Справочник.РеквизитыСведенийОбИмуществе КАК РеквизитыСведенийОбИмуществе
		               |ГДЕ
		               |	РеквизитыСведенийОбИмуществе.Владелец = &ВидКарты
		               |	И НЕ РеквизитыСведенийОбИмуществе.ПометкаУдаления
		               |	И НЕ РеквизитыСведенийОбИмуществе.ЭтоГруппа
		               |	И РеквизитыСведенийОбИмуществе.ВидРеквизита <> ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.ДекорацияНадпись)
		               |	И НЕ РеквизитыСведенийОбИмуществе.Ссылка В ИЕРАРХИИ
		               |				(ВЫБРАТЬ
		               |					Р.Ссылка
		               |				ИЗ
		               |					Справочник.РеквизитыСведенийОбИмуществе КАК Р
		               |				ГДЕ
		               |					Р.ЭтоГруппа
		               |					И Р.ПометкаУдаления
		               |					И Р.Владелец = &ВидКарты)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	РегистрацияСведенийОбИмуществеЗначенияРеквизитов.РеквизитСведений,
		               |	РегистрацияСведенийОбИмуществеЗначенияРеквизитов.Значение
		               |ПОМЕСТИТЬ ВТ_Источник
		               |ИЗ
		               |	Документ.РегистрацияСведенийОбИмуществе.ЗначенияРеквизитов КАК РегистрацияСведенийОбИмуществеЗначенияРеквизитов
		               |ГДЕ
		               |	РегистрацияСведенийОбИмуществеЗначенияРеквизитов.Ссылка = &ДокументИсточник
		               |	И РегистрацияСведенийОбИмуществеЗначенияРеквизитов.РеквизитСведений В
		               |			(ВЫБРАТЬ
		               |				ВТ_Реквизиты.Реквизит
		               |			ИЗ
		               |				ВТ_Реквизиты)
		               |	И РегистрацияСведенийОбИмуществеЗначенияРеквизитов.ИдентификаторСтрокиТабличнойЧасти = """"
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	РегистрацияСведенийОбИмуществеЗначенияРеквизитов.РеквизитСведений,
		               |	РегистрацияСведенийОбИмуществеЗначенияРеквизитов.Значение
		               |ПОМЕСТИТЬ ВТ_Основание
		               |ИЗ
		               |	Документ.РегистрацияСведенийОбИмуществе.ЗначенияРеквизитов КАК РегистрацияСведенийОбИмуществеЗначенияРеквизитов
		               |ГДЕ
		               |	РегистрацияСведенийОбИмуществеЗначенияРеквизитов.Ссылка = &ДокументОснование
		               |	И РегистрацияСведенийОбИмуществеЗначенияРеквизитов.РеквизитСведений В
		               |			(ВЫБРАТЬ
		               |				ВТ_Реквизиты.Реквизит
		               |			ИЗ
		               |				ВТ_Реквизиты)
		               |	И РегистрацияСведенийОбИмуществеЗначенияРеквизитов.ИдентификаторСтрокиТабличнойЧасти = """"
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ЕСТЬNULL(ВТ_Источник.РеквизитСведений, ВТ_Основание.РеквизитСведений) КАК Реквизит,
		               |	ЕСТЬNULL(ВТ_Источник.Значение, НЕОПРЕДЕЛЕНО) КАК ЗначениеИсточник,
		               |	ЕСТЬNULL(ВТ_Основание.Значение, НЕОПРЕДЕЛЕНО) КАК ЗначениеОснование
		               |ПОМЕСТИТЬ ВТ_Результат
		               |ИЗ
		               |	ВТ_Источник КАК ВТ_Источник
		               |		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Основание КАК ВТ_Основание
		               |		ПО ВТ_Источник.РеквизитСведений = ВТ_Основание.РеквизитСведений
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТ_Результат.Реквизит.Наименование КАК Реквизит,
		               |	ЕСТЬNULL(ПредставлениеЗначений.Представление, ПРЕДСТАВЛЕНИЕ(ВТ_Результат.ЗначениеИсточник)) КАК Значение
		               |ИЗ
		               |	ВТ_Результат КАК ВТ_Результат
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РеквизитыСведенийОбИмуществе.СписокВыбора КАК ПредставлениеЗначений
		               |		ПО ВТ_Результат.Реквизит = ПредставлениеЗначений.Ссылка
		               |			И ВТ_Результат.ЗначениеИсточник = ПредставлениеЗначений.Значение
		               |ГДЕ
		               |	ВТ_Результат.ЗначениеИсточник <> ВТ_Результат.ЗначениеОснование";	
					   
		Запрос.УстановитьПараметр("ВидКарты", Объект.ДокументИсточник.ОбъектУчетаИмущества.ВидКарты); // Считаем что вид карты в обоих документов один и тот же
		Запрос.УстановитьПараметр("ДокументИсточник", Объект.ДокументИсточник);
		Запрос.УстановитьПараметр("ДокументОснование", Объект.ДокументОснование);			   
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Изменения = Новый Массив;
						
		Пока Выборка.Следующий() Цикл
			
			Если Не ЗначениеЗаполнено(Выборка.Значение) Тогда
				Значение = "<Удалено>";
			ИначеЕсли Найти(Выборка.Значение, "<КонтактнаяИнформация") = 1 Тогда  // Это адрес
				Значение = РеестрИмуществаСервер.ПредставлениеАдреса(Выборка.Значение);
			Иначе
				Значение = Выборка.Значение;
			КонецЕсли;
			
			Изменения.Добавить(Выборка.Реквизит + " - " + Значение);
			
		КонецЦикла;
		
		Результат = "";
		Если Изменения.Количество() > 0 Тогда
			Результат = СтрСоединить(Изменения, ";" + Символы.ПС) + "."; 
		КонецЕсли;

		Объект.СодержаниеИзменений = Результат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеквизитыДокументаОснование.Значение КАК Документ
	               |ПОМЕСТИТЬ ДокументыОснования
	               |ИЗ
	               |	Документ.РегистрацияСведенийОбИмуществе.ЗначенияРеквизитов КАК РеквизитыДокументаОснование
	               |ГДЕ
	               |	РеквизитыДокументаОснование.Ссылка = &ДокументОснование
	               |	И ВЫРАЗИТЬ(РеквизитыДокументаОснование.Значение КАК Справочник.ОбъектыРеестраИмущества).Владелец = &Документы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РеквизитыДокументаИсточника.Значение КАК ДокументОснование
	               |ИЗ
	               |	Документ.РегистрацияСведенийОбИмуществе.ЗначенияРеквизитов КАК РеквизитыДокументаИсточника
	               |ГДЕ
	               |	РеквизитыДокументаИсточника.Ссылка = &ДокументИсточник
	               |	И ВЫРАЗИТЬ(РеквизитыДокументаИсточника.Значение КАК Справочник.ОбъектыРеестраИмущества).Владелец = &Документы
	               |	И НЕ РеквизитыДокументаИсточника.Значение В
	               |				(ВЫБРАТЬ
	               |					ДокументыОснования.Документ
	               |				ИЗ
	               |					ДокументыОснования КАК ДокументыОснования)";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.ДокументОснование);
	Запрос.УстановитьПараметр("ДокументИсточник", Объект.ДокументИсточник);
	Запрос.УстановитьПараметр("Документы", ОбъектДокумент);
	
	Результат = Запрос.Выполнить().Выгрузить();

	Объект.ДокументыОснования.Загрузить(Результат);
		
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОрганизацияПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ВидОтветственногоЛица = Перечисления.ОтветственныеЛицаОрганизаций.Руководитель;
	ОтветственноеЛицо = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(ВидОтветственногоЛица, Объект.Организация, Объект.Дата);
	Объект.Руководитель = ОтветственноеЛицо.ОтветственноеЛицоСсылка;
	
КонецПроцедуры

