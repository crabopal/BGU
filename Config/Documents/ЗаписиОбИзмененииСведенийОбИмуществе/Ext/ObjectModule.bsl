#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	
	ДокументРегистрации = Неопределено;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ДанныеЗаполнения.Свойство("ДокументИсточник", ДокументРегистрации);
	КонецЕсли;
		
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РегистрацияСведенийОбИмуществе") Тогда
		ДокументРегистрации = ДанныеЗаполнения;
	КонецЕсли;
	
	Если ДокументРегистрации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Организация				= ДокументРегистрации.Организация;
	ОбъектУчетаИмущества	= ДокументРегистрации.ОбъектУчетаИмущества;
	ДокументИсточник		= ДокументРегистрации.Ссылка;
	ДокументОснование		= ДокументРегистрации.ДокументОснование;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
