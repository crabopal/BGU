&НаКлиенте
Процедура УстановитьСчетДт(Команда)
	
	ТекущиеДанные = Элементы.ЗатратыСводно.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Сумма = 0 Тогда
		ПоказатьПредупреждение(,НСтр("ru= 'Установка счета и субконто списания (Дт) недоступна для затрат НУ.'"));
		Возврат;
	КонецЕсли;
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	СтруктураТекущиеЗначения = Новый Структура("Организация,Дата,ИФО,КФО,ПроизвольнаяАналитикаКПС,"
		+"СчетДт, КПСДт, КЭКДт, ПодразделениеДт, СубконтоДт1, СубконтоДт2, СубконтоДт3",
		Объект.Организация, Объект.Дата, Объект.ИФО, Объект.КФО);
		
	Если ТекущиеДанные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(СтруктураТекущиеЗначения, ТекущиеДанные);
	КонецЕсли;
	СтруктураТекущиеЗначения.ПроизвольнаяАналитикаКПС = ПроизвольнаяАналитикаКПС;
	
	Оповещение = Новый ОписаниеОповещения(
		"ЗакрытиеФормыВводаСчетаДебетаЗавершение",
		ЭтотОбъект);
	
	ПараметрыФормы = Новый Структура("ТекущиеЗначения", СтруктураТекущиеЗначения);
	ОткрытьФорму("Документ.СписаниеЗатратПоУслугам.Форма.ФормаВводаСчетаДебета",
		ПараметрыФормы, ЭтотОбъект,,,, Оповещение);
	
КонецПроцедуры

