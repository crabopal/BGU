КонецПроцедуры

&НаКлиенте
Асинх Функция ПолучитьПодтверждениеЗаполнения()
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат КодВозвратаДиалога.Нет;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КФО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'КФО'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.КФО");
		Возврат КодВозвратаДиалога.Нет;
	КонецЕсли;

	ЕстьДанныеВДокументе = ЕстьДанныеВДокументе();

	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено, а данные будут очищены. Заполнить?'");
	ИначеЕсли Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено. Заполнить?'");
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут очищены. Заполнить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Возврат ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		Возврат КодВозвратаДиалога.Да;
	КонецЕсли;
	
КонецФункции 

&НаСервере
Процедура ЗаполнитьРаспределениеОбщихЗатратНаСервере()
	Документы.ЗакрытиеСчетовБиотрансформации.ЗаполнитьРаспределениеОбщихЗатрат(Объект);
	ЗаполнитьТаблицуОбщиеЗатраты();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуОбщиеЗатраты()

	ОбщиеЗатраты.Очистить();
	
	ТаблицаОбщихЗатрат = Объект.РаспределениеОбщихЗатрат.Выгрузить();
	ТаблицаОбщихЗатрат.Свернуть(
		"ИФО,КФО,КПС,СчетУчета,КЭК,ВидЗатрат,НаправлениеДеятельности,Подразделение,БазаРаспределения",
		"Сумма,СуммаЕНВД,СуммаНеУчитываетсяНУ,СуммаБазы,СуммаБазыЕНВД,СуммаБазыНеУчитываетсяНУ,КорСчет");
	ТаблицаОбщихЗатрат.Колонки.Добавить("Обработано", Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрокаТаблицы Из ТаблицаОбщихЗатрат Цикл
		
		Если СтрокаТаблицы.Обработано Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеСчетаТекущейСтроки = ДанныеСчетов.Получить(СтрокаТаблицы.СчетУчета);
		Если ДанныеСчетаТекущейСтроки = Неопределено Тогда
			ЕстьНД				= Ложь;
			ЕстьПодразделение	= Ложь;
		Иначе
			ЕстьНД 				= ДанныеСчетаТекущейСтроки.ЕстьНаправлениеДеятельности = Истина;
			ЕстьПодразделение	= ДанныеСчетаТекущейСтроки.ЕстьПодразделение = Истина;
		КонецЕсли;
		Отбор = Новый Структура("ИФО,КФО,КПС,СчетУчета,КЭК,ВидЗатрат,БазаРаспределения");
		Если ЕстьНД Тогда
			Отбор.Вставить("НаправлениеДеятельности");
		КонецЕсли;
		Если ЕстьПодразделение Тогда
			Отбор.Вставить("Подразделение");
		КонецЕсли;
		
		ИдСтроки = Новый УникальныйИдентификатор;
		СтрокаОбщиеЗатраты = ОбщиеЗатраты.Добавить();
		СтрокаОбщиеЗатраты.ИдСтроки = ИдСтроки;
		ЗаполнитьЗначенияСвойств(СтрокаОбщиеЗатраты, СтрокаТаблицы,
			"ИФО,КФО,КПС,СчетУчета,КЭК,ВидЗатрат,НаправлениеДеятельности,Подразделение,БазаРаспределения");
		ЗаполнитьЗначенияСвойств(СтрокаОбщиеЗатраты, СтрокаТаблицы,
			"Сумма,СуммаЕНВД,СуммаНеУчитываетсяНУ,СуммаБазы,СуммаБазыЕНВД,СуммаБазыНеУчитываетсяНУ");
		
		ЗаполнитьПоясненияКСуммамВСтрокеОбщиеЗатраты(СтрокаОбщиеЗатраты, СтрокаОбщиеЗатраты.СчетУчета);
		
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаОбщиеЗатраты);
		Если ДанныеСчетаТекущейСтроки <> Неопределено Тогда
			СтрокаОбщиеЗатраты.ВидДопСубконто = ДанныеСчетаТекущейСтроки.ВидДопСубконто;
		КонецЕсли;
		
		НайденныеСтроки = Объект.РаспределениеОбщихЗатрат.НайтиСтроки(Отбор);
		Для каждого СтрокаРаспределениеОбщихЗатрат Из НайденныеСтроки Цикл
			СтрокаРаспределениеОбщихЗатрат.ИдСтроки = ИдСтроки;
			ЗаполнитьКоэффициентыВСтрокеТаблицыРаспределениеОбщихЗатрат(СтрокаРаспределениеОбщихЗатрат, СтрокаТаблицы);
		КонецЦикла;
		
		ОбработанныеСтроки = ТаблицаОбщихЗатрат.НайтиСтроки(Отбор);
		Для каждого ОбработаннаяСтрока Из ОбработанныеСтроки Цикл
			ОбработаннаяСтрока.Обработано = Истина;
		КонецЦикла;
	
	КонецЦикла;

	Для Каждого Строка Из Объект.РаспределениеОбщихЗатрат Цикл
		ДанныеСчетаТекущейСтроки = ДанныеСчетов.Получить(Строка.СчетУчета);
		Если ДанныеСчетаТекущейСтроки <> Неопределено Тогда
			Строка.ВидДопСубконто = ДанныеСчетаТекущейСтроки.ВидДопСубконто;
		КонецЕсли;
		Строка.КодыДопустимыхКорСчетов.Очистить();
		Если ЗначениеЗаполнено(Строка.СчетУчета)
				И (Счета10970.НайтиПоЗначению(Строка.СчетУчета) = Неопределено
				И Счета10980.НайтиПоЗначению(Строка.СчетУчета) = Неопределено) Тогда
			Строка.КодыДопустимыхКорСчетов.Добавить("Н20.11");
		Иначе
			Строка.КодыДопустимыхКорСчетов.Добавить("110.60");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьКоэффициентыВСтрокеТаблицыРаспределениеОбщихЗатрат(СтрокаРаспределениеОбщихЗатрат, СтрокаОбщиеЗатраты)
	
	Коэффициент = ?(СтрокаОбщиеЗатраты.Сумма = 0, 0,
		СтрокаРаспределениеОбщихЗатрат.Сумма / СтрокаОбщиеЗатраты.Сумма);
	КоэффициентЕНВД = ?(СтрокаОбщиеЗатраты.СуммаЕНВД = 0, 0,
		СтрокаРаспределениеОбщихЗатрат.СуммаЕНВД / СтрокаОбщиеЗатраты.СуммаЕНВД);
	КоэффициентНеУчитываетсяНУ = ?(СтрокаОбщиеЗатраты.СуммаНеУчитываетсяНУ = 0, 0,
		СтрокаРаспределениеОбщихЗатрат.СуммаНеУчитываетсяНУ / СтрокаОбщиеЗатраты.СуммаНеУчитываетсяНУ);
	
	СтрокаРаспределениеОбщихЗатрат.Коэффициент                = Формат(Коэффициент*100, "ЧЦ=5; ЧДЦ=2; ЧН=0") + "%";
	СтрокаРаспределениеОбщихЗатрат.КоэффициентЕНВД            = Формат(КоэффициентЕНВД*100, "ЧЦ=5; ЧДЦ=2; ЧН=0") + "%";
	СтрокаРаспределениеОбщихЗатрат.КоэффициентНеУчитываетсяНУ = Формат(КоэффициентНеУчитываетсяНУ*100, "ЧЦ=5; ЧДЦ=2; ЧН=0") + "%";
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьПоясненияКСуммамВСтрокеОбщиеЗатраты(СтрокаТаблицы, СчетУчета)
	
	СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СчетУчета);
	ЭтоСчетНУ = ЗначениеЗаполнено(СвойстваСчета)
		И СвойстваСчета.ТипСчета = ПредопределенноеЗначение("Перечисление.ТипыСчетов.Налоговый");
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗаголовкиКолонокПояснение(ЭтоСчетНУ));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовкиКолонокПояснение(ЭтоНУ = Ложь)
	ЗаголовкиКолонок = Новый Структура;
	Если ЭтоНУ Тогда
		ЗаголовкиКолонок.Вставить("НадписьСумма", НСтр("ru = 'Сумма (НУ):'"));
		ЗаголовкиКолонок.Вставить("НадписьСуммаНеУчитываетсяНУ", НСтр("ru = 'Не уч. (НУ):'"));
		ЗаголовкиКолонок.Вставить("НадписьСуммаЕНВД", НСтр("ru = 'ЕНВД (НУ):'"));
	Иначе
		ЗаголовкиКолонок.Вставить("НадписьСумма", НСтр("ru = 'Сумма:'"));
	КонецЕсли;
	Возврат ЗаголовкиКолонок;
КонецФункции

&НаСервере
Процедура ЗаполнитьДокументНаСервере()

	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	Документы.ЗакрытиеСчетовБиотрансформации.ЗаполнитьДокумент(Объект);
	
	ЗаполнитьТаблицуОбщиеЗатраты();
	ЗаполнитьТаблицыНаФормеПоТабличнымЧастям();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписаниеРасходовБУНаСервере()

	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	Иначе
		ЗаписатьОбщиеЗатратыВДокумент(Объект);
	КонецЕсли;

	Документы.ЗакрытиеСчетовБиотрансформации.ЗаполнитьДокументПоОстаткам(Объект);
	
	ЗаполнитьТаблицыНаФормеПоТабличнымЧастям();
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ТипКПСПоУчетнойПолитике = БухгалтерскийУчетПовтИсп.ТипКПСПоУчетнойПолитике(
		Объект.Организация, Объект.ИФО, Объект.КФО, ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ДатаПоследнегоИзменения);
	ПроизвольнаяАналитикаКПС = (ТипКПСПоУчетнойПолитике = ПредопределенноеЗначение("Перечисление.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация"));
	
	ТекущийРежимОтображения = Объект.РежимОтображения;
	
	ЗаполнитьДанныеСчетов();
	УстановитьПараметрыСчетовУчета();
	ОбщиеЗатратыЗаполнитьДобавленныеКолонки();
	РаспределениеОбщихЗатратЗаполнитьДобавленныеКолонки();
	
	ЗаполнитьТаблицуОбщиеЗатраты();
	ЗаполнитьТаблицыНаФормеПоТабличнымЧастям();
	
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСчетов()

	ВидыДопСубконто = Новый Соответствие;
	Счета10960.Очистить();
	Счета10970.Очистить();
	Счета10980.Очистить();
	СчетаОЗ.Очистить();
	СчетаНУ.Очистить();
	ЕстьДопСубконтоБУ = Ложь;
	ЕстьДопСубконтоНУ = Ложь;
	ДатаЗаполнения = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ОбщегоНазначения.ТекущаяДатаПользователя());
	Обработка = Обработки.ЗакрытиеСчетовПроизводственныхЗатрат.ИнициализироватьОбработку(ДатаЗаполнения,
		Объект.Организация, Объект.ИФО, Объект.КФО, Ложь, Истина);
		
	ДанныеИспользуемыхСчетов = Новый Соответствие;
	Для Каждого Строка Из Обработка.СчетаПрямыхЗатрат Цикл
		Если Строка.ВидУчета = "БУ" Тогда
			ДанныеСчета = Новый Структура("ЕстьПодразделение, ЕстьНаправлениеДеятельности, ВидДопСубконто",
										  Строка.ЕстьПодразделение,
										  Строка.ЕстьДопСубконто,
										  Строка.ВидДопСубконто);
			ДанныеИспользуемыхСчетов.Вставить(Строка.СчетПрямыхЗатрат, ДанныеСчета);
			Счета10960.Добавить(Строка.СчетПрямыхЗатрат);
			ЕстьДопСубконтоБУ = ЕстьДопСубконтоБУ Или Строка.ЕстьДопСубконто;
			Если Строка.ЕстьДопСубконто Тогда
				ВидыДопСубконто.Вставить(Строка.ВидДопСубконто, Истина);
			КонецЕсли;
		Иначе
			ЕстьДопСубконтоНУ = ЕстьДопСубконтоНУ Или Строка.ЕстьДопСубконто;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из Обработка.СчетаОбщихЗатрат Цикл
		Если Строка.ВидУчета = "БУ" Тогда
			ДанныеСчета = Новый Структура("ЕстьПодразделение, ЕстьНаправлениеДеятельности, ВидДопСубконто",
										  Строка.ЕстьПодразделение,
										  Строка.ЕстьДопСубконто,
										  Строка.ВидДопСубконто);
			ДанныеИспользуемыхСчетов.Вставить(Строка.СчетОбщихЗатрат, ДанныеСчета);
			Если Строка.ВидОбщихЗатрат = Перечисления.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты Тогда
				Счета10970.Добавить(Строка.СчетОбщихЗатрат);
			Иначе
				Счета10970.Добавить(Строка.СчетОбщихЗатрат);
			КонецЕсли;
			СчетаОЗ.Добавить(Строка.СчетОбщихЗатрат);
			ЕстьДопСубконтоБУ = ЕстьДопСубконтоБУ Или Строка.ЕстьДопСубконто;
			Если Строка.ЕстьДопСубконто Тогда
				ВидыДопСубконто.Вставить(Строка.ВидДопСубконто, Истина);
			КонецЕсли;
		Иначе
			ЕстьДопСубконтоНУ = ЕстьДопСубконтоНУ Или Строка.ЕстьДопСубконто;
			СчетаНУ.Добавить(Строка.СчетОбщихЗатрат);
		КонецЕсли;
	КонецЦикла;
	
	Если ВидыДопСубконто.Количество() = 1 Тогда
		Для Каждого СтрокаВидаСубконто Из ВидыДопСубконто Цикл
			ВидДопСубконто = СтрокаВидаСубконто.Ключ;
		КонецЦикла;
	Иначе
		ВидДопСубконто = ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
	КонецЕсли;
	
	ДанныеСчетов = Новый ФиксированноеСоответствие(ДанныеИспользуемыхСчетов);
	
	Счета40120.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("401.20", ДатаЗаполнения, Истина, Объект.Организация));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицыНаФормеПоТабличнымЧастям()
	
	// Заполним таблицы значений на форме по табличным частям документа.
	СтруктураТаблиц = Документы.ЗакрытиеСчетовБиотрансформации.ПолучитьСводнуюИДетальныеТаблицыЗатратПоТабЧастям(Объект);
	ЗатратыСводно.Загрузить(СтруктураТаблиц.ЗатратыСводно);
	ЗатратыДетально.Загрузить(СтруктураТаблиц.ЗатратыДетально);
	ЗатратыДетальноНУ.Загрузить(СтруктураТаблиц.ЗатратыДетальноНУ);
	
	ЗатратыСводноЗаполнитьДобавленныеКолонки();
	ЗатратыДетальноЗаполнитьДобавленныеКолонки();
	ЗатратыДетальноНУЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличныеЧастиПоТаблицамНаФорме()
	
	Объект.ЗатратыПрямые.Очистить();
	Объект.ЗатратыОбщие.Очистить();
	Объект.ЗатратыНУ.Очистить();
	
	Если НЕ Объект.ОтражатьВНалоговомУчете Тогда
		ЗатратыДетальноНУ.Очистить();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗатратыСводно",     ЗатратыСводно.Выгрузить());
	Запрос.УстановитьПараметр("ЗатратыДетально",   ЗатратыДетально.Выгрузить());
	Запрос.УстановитьПараметр("ЗатратыДетальноНУ", ЗатратыДетальноНУ.Выгрузить());
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗатратыСводно.КлючСтроки КАК КлючСтроки,
	|	ЗатратыСводно.ТипЗатрат,
	|	ЗатратыСводно.Номенклатура,
	|	ЗатратыСводно.СчетДт,
	|	ЗатратыСводно.КПСДт,
	|	ЗатратыСводно.КЭКДт,
	|	ЗатратыСводно.ПодразделениеДт,
	|	ЗатратыСводно.СубконтоДт1,
	|	ЗатратыСводно.СубконтоДт2,
	|	ЗатратыСводно.СубконтоДт3
	|ПОМЕСТИТЬ ЗатратыСводно
	|ИЗ
	|	&ЗатратыСводно КАК ЗатратыСводно
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗатратыДетально.КлючСтроки КАК КлючСтроки,
	|	ЗатратыДетально.ВидЗатрат,
	|	ЗатратыДетально.СчетКт,
	|	ЗатратыДетально.КПСКт,
	|	ЗатратыДетально.КЭККт,
	|	ЗатратыДетально.ПодразделениеКт,
	|	ЗатратыДетально.ДопСубконто,
	|	ЗатратыДетально.Сумма
	|ПОМЕСТИТЬ ЗатратыДетально
	|ИЗ
	|	&ЗатратыДетально КАК ЗатратыДетально
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗатратыДетальноНУ.КлючСтроки КАК КлючСтроки,
	|	ЗатратыДетальноНУ.ВидЗатрат,
	|	ЗатратыДетальноНУ.СчетКт,
	|	ЗатратыДетальноНУ.ПодразделениеКт,
	|	ЗатратыДетальноНУ.ДопСубконто,
	|	ЗатратыДетальноНУ.Сумма,
	|	ЗатратыДетальноНУ.СуммаЕНВД,
	|	ЗатратыДетальноНУ.СуммаНеУчитываетсяНУ
	|ПОМЕСТИТЬ ЗатратыДетальноНУ
	|ИЗ
	|	&ЗатратыДетальноНУ КАК ЗатратыДетальноНУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗатратыДетально.ВидЗатрат,
	|	ЗатратыДетально.СчетКт,
	|	ЗатратыДетально.КПСКт,
	|	ЗатратыДетально.КЭККт,
	|	ЗатратыДетально.ПодразделениеКт,
	|	ЗатратыДетально.ДопСубконто,
	|	ЗатратыДетально.Сумма,
	|	ЗатратыСводно.ТипЗатрат,
	|	ЗатратыСводно.Номенклатура,
	|	ЗатратыСводно.СчетДт,
	|	ЗатратыСводно.КПСДт,
	|	ЗатратыСводно.КЭКДт,
	|	ЗатратыСводно.ПодразделениеДт,
	|	ЗатратыСводно.СубконтоДт1,
	|	ЗатратыСводно.СубконтоДт2,
	|	ЗатратыСводно.СубконтоДт3
	|ИЗ
	|	ЗатратыДетально КАК ЗатратыДетально
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗатратыСводно КАК ЗатратыСводно
	|		ПО ЗатратыДетально.КлючСтроки = ЗатратыСводно.КлючСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗатратыДетальноНУ.ВидЗатрат,
	|	ЗатратыДетальноНУ.СчетКт,
	|	ЗатратыДетальноНУ.ПодразделениеКт,
	|	ЗатратыДетальноНУ.ДопСубконто,
	|	ЗатратыДетальноНУ.Сумма,
	|	ЗатратыДетальноНУ.СуммаЕНВД,
	|	ЗатратыДетальноНУ.СуммаНеУчитываетсяНУ,
	|	ЗатратыСводно.ТипЗатрат,
	|	ЗатратыСводно.Номенклатура,
	|	ЗатратыСводно.СчетДт,
	|	ЗатратыСводно.КПСДт,
	|	ЗатратыСводно.КЭКДт,
	|	ЗатратыСводно.ПодразделениеДт,
	|	ЗатратыСводно.СубконтоДт1,
	|	ЗатратыСводно.СубконтоДт2,
	|	ЗатратыСводно.СубконтоДт3
	|ИЗ
	|	ЗатратыДетальноНУ КАК ЗатратыДетальноНУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗатратыСводно КАК ЗатратыСводно
	|		ПО ЗатратыДетальноНУ.КлючСтроки = ЗатратыСводно.КлючСтроки";
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("ЗатратыСводно",     НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ЗатратыДетально",   НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ЗатратыДетальноНУ", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаЗатратБУ",   НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаЗатратНУ",   НомераТаблиц.Количество());
	
	Результат = Запрос.ВыполнитьПакет();
	
	// Заполняем табличные части документа
	
	ТаблицаЗатратБУ = Результат[НомераТаблиц.ТаблицаЗатратБУ].Выгрузить();
	Для Каждого СтрокаЗатрат из ТаблицаЗатратБУ Цикл
		
		Если СтрокаЗатрат.ТипЗатрат = УчетПроизводстваКлиентСервер.ТипЗатратСебестоимость() Тогда
			НоваяСтрока = Объект.ЗатратыПрямые.Добавить();
		Иначе
			НоваяСтрока = Объект.ЗатратыОбщие.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗатрат);
		
		// Заполним значение доп. субконто
		СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
		Если СтрокаЗатрат.ТипЗатрат = УчетПроизводстваКлиентСервер.ТипЗатратСебестоимость() Тогда
			Если СвойстваСчетаКт.ВидСубконто3 = ВидДопСубконто Тогда
				НоваяСтрока.СубконтоКт3 = СтрокаЗатрат.ДопСубконто;
			КонецЕсли;
		Иначе
			Если СвойстваСчетаКт.ВидСубконто2 = ВидДопСубконто Тогда
				НоваяСтрока.СубконтоКт2 = СтрокаЗатрат.ДопСубконто;
			ИначеЕсли СвойстваСчетаКт.ВидСубконто3 = ВидДопСубконто Тогда
				НоваяСтрока.СубконтоКт3 = СтрокаЗатрат.ДопСубконто;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Объект.ОтражатьВНалоговомУчете Тогда
		
		ТаблицаЗатратНУ = Результат[НомераТаблиц.ТаблицаЗатратНУ].Выгрузить();
		Для Каждого СтрокаЗатрат из ТаблицаЗатратНУ Цикл
			
			НоваяСтрока = Объект.ЗатратыНУ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗатрат);
			
			// Заполним значение доп. субконто
			СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
			Если СвойстваСчетаКт.ВидСубконто2 = ВидДопСубконто Тогда
				НоваяСтрока.СубконтоКт2 = СтрокаЗатрат.ДопСубконто;
			ИначеЕсли СвойстваСчетаКт.ВидСубконто3 = ВидДопСубконто Тогда
				НоваяСтрока.СубконтоКт3 = СтрокаЗатрат.ДопСубконто;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()

	ДоступностьЭлементов = ЗначениеЗаполнено(Объект.Организация);
	Элементы.КФО.Доступность = ДоступностьЭлементов;

КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыСчетовУчета()

	ОбщиеПараметрыУчетаРасходов = Документы.СписаниеЗатратПоУслугам.ПолучитьОбщиеПараметрыУчетаРасходов();
	
	// Доступность элементов таблицы ЗатратыСводно
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗатратыСводноПодразделениеДт",
		"Видимость", ОбщиеПараметрыУчетаРасходов.ФинРезультатЕстьУчетПоПодразделениям);
	
	// Доступность элементов таблиц ЗатратыДетально и ЗатратыДетальноНУ
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗатратыДетальноДопСубконто",
		"Видимость", ЕстьДопСубконтоБУ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗатратыДетальноНУДопСубконто",
		"Видимость", ЕстьДопСубконтоНУ);
	
	Если ЗначениеЗаполнено(ВидДопСубконто) Тогда
		ЗаголовокСубконто = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидДопСубконто, "Наименование");
	Иначе
		ЗаголовокСубконто = НСтр("ru = 'Дополнительная аналитика'");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗатратыДетальноДопСубконто",
		"Заголовок", ЗаголовокСубконто);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗатратыДетальноНУДопСубконто",
		"Заголовок", ЗаголовокСубконто);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма)
	
	СуммыНУ = Новый Массив;
	СуммыНУ.Добавить("ЗатратыСводноСуммаНУ");
	СуммыНУ.Добавить("ЗатратыСводноСуммаНеУчитываетсяНУ");
	СуммыНУ.Добавить("ЗатратыСводноСуммаЕНВД");
	СуммыНУ.Добавить("ЗатратыСводноЗаголовокСуммаНУ");
	СуммыНУ.Добавить("ЗатратыСводноЗаголовокСуммаНеУчитываетсяНУ");
	СуммыНУ.Добавить("ЗатратыСводноЗаголовокСуммаЕНВД");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		СуммыНУ, "Видимость", Форма.Объект.ОтражатьВНалоговомУчете);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СтраницаНалоговыйУчет", "Видимость", Форма.Объект.ОтражатьВНалоговомУчете);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекущуюСтраницуТаблицыЗатратыДетально()
	
	Если Объект.ОтражатьВНалоговомУчете Тогда
		
		Если Объект.РежимОтображения > 0 Тогда
			ТекущиеДанные = Элементы.ЗатратыСводно.ТекущиеДанные;
			ЭтоСтрокаЗатратНУ = (ТекущиеДанные <> Неопределено И ТекущиеДанные.Сумма <> 0);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ЗатратыДетальноСтраницыБУиНУ", "ТекущаяСтраница",
					?(ЭтоСтрокаЗатратНУ, Элементы.СтраницаБухгалтерскийУчет, Элементы.СтраницаНалоговыйУчет));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьДанныеВДокументе()
	
	Возврат (Объект.ЗатратыПрямые.Количество() > 0)
		ИЛИ (Объект.ЗатратыОбщие.Количество() > 0)
		ИЛИ (Объект.ЗатратыНУ.Количество() > 0);
	
КонецФункции

&НаСервере
Функция РассчитатьИтоговуюСуммуПоСтрокам(ИмяТаблицы, ИмяКолонки="Сумма")

	ОтборСтрок  = ОбщегоНазначенияБГУКлиентСервер.СтруктураИзФиксированнойСтруктуры(Элементы[ИмяТаблицы].ОтборСтрок);
	МассивСтрок = ЭтотОбъект[ИмяТаблицы].НайтиСтроки(ОтборСтрок);
	
	ИтоговаяСумма = 0;
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ИтоговаяСумма = ИтоговаяСумма + СтрокаТаблицы[ИмяКолонки];
	КонецЦикла;
	
	Возврат ИтоговаяСумма;

КонецФункции

