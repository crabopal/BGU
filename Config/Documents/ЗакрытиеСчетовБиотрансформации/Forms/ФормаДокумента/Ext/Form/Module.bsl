&НаКлиенте
Процедура РассчитатьСуммыПриИзмененииБазыРаспределения(СтрокаОбщиеЗатраты)
	
	Отбор = Новый Структура("ИдСтроки", СтрокаОбщиеЗатраты.ИдСтроки);
	НайденныеСтроки = Объект.РаспределениеОбщихЗатрат.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивКоэффициентов = Новый Массив;
	МассивКоэффициентовЕНВД = Новый Массив;
	МассивКоэффициентовНеУчитываетсяНУ = Новый Массив;
	Для Каждого СтрокаРаспределениеОбщихЗатрат Из НайденныеСтроки Цикл
		МассивКоэффициентов.Добавить(СтрокаРаспределениеОбщихЗатрат.СуммаБазы);
		МассивКоэффициентовЕНВД.Добавить(СтрокаРаспределениеОбщихЗатрат.СуммаБазыЕНВД);
		МассивКоэффициентовНеУчитываетсяНУ.Добавить(СтрокаРаспределениеОбщихЗатрат.СуммаБазыНеУчитываетсяНУ);
	КонецЦикла;
	
	МассивСумм = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
		СтрокаОбщиеЗатраты.Сумма, МассивКоэффициентов);
	МассивСуммЕНВД = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
		СтрокаОбщиеЗатраты.СуммаЕНВД, МассивКоэффициентовЕНВД);
	МассивСуммНеУчитываетсяНУ = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
		СтрокаОбщиеЗатраты.СуммаНеУчитываетсяНУ, МассивКоэффициентовНеУчитываетсяНУ);
	
	Для Инд = 0 По НайденныеСтроки.Количество() - 1 Цикл
		
		СтрокаРаспределениеОбщихЗатрат = НайденныеСтроки[Инд];
		
		СтрокаРаспределениеОбщихЗатрат.Сумма =
			?(МассивСумм = Неопределено, 0, МассивСумм[Инд]);
		СтрокаРаспределениеОбщихЗатрат.СуммаЕНВД =
			?(МассивСуммЕНВД = Неопределено, 0, МассивСуммЕНВД[Инд]);
		СтрокаРаспределениеОбщихЗатрат.СуммаНеУчитываетсяНУ =
			?(МассивСуммНеУчитываетсяНУ = Неопределено, 0, МассивСуммНеУчитываетсяНУ[Инд]);
		
		ЗаполнитьКоэффициентыВСтрокеТаблицыРаспределениеОбщихЗатрат(СтрокаРаспределениеОбщихЗатрат, СтрокаОбщиеЗатраты);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбщиеЗатратыЗаполнитьДобавленныеКолонки()
	
	БухгалтерскийУчет.УстановитьДоступностьПолейАналитикиСчетаВТаблице(
		ОбщиеЗатраты, "СчетУчета",
		ОбщиеЗатратыПоляАналитикиСчетаУчета());
	ЗаполнитьПоясненияКСуммамОбщиеЗатраты();
	УстановитьПризнакНаправленияДеятельностиПодразделенияВТаблице(ОбщиеЗатраты);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоясненияКСуммамОбщиеЗатраты()
	СчетаУчетаОбщихЗатрат = ОбщиеЗатраты.Выгрузить(, "СчетУчета");
	СчетаУчетаОбщихЗатрат.Свернуть("СчетУчета");
	ДанныеСчетовОбщихЗатрат = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из СчетаУчетаОбщихЗатрат Цикл
		ТипСчетаТаблицы = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетУчета).ТипСчета;
		ДанныеСчетовОбщихЗатрат.Вставить(СтрокаТаблицы.СчетУчета,
			ТипСчетаТаблицы = ПредопределенноеЗначение("Перечисление.ТипыСчетов.Налоговый"));
	КонецЦикла;
	ЗаголовкиКолонокБУ = ЗаголовкиКолонокПояснение();
	ЗаголовкиКолонокНУ = ЗаголовкиКолонокПояснение(Истина);
	Для Каждого СтрокаТаблицы Из ОбщиеЗатраты Цикл
		Если ДанныеСчетовОбщихЗатрат[СтрокаТаблицы.СчетУчета] = Истина Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗаголовкиКолонокНУ);
		Иначе
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗаголовкиКолонокБУ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОбщиеЗатратыВДокумент(ТекущийОбъект)

	ОбработанныеСтроки = Новый Массив;
	Для Каждого СтрокаОбщиеЗатраты Из ОбщиеЗатраты Цикл
	
		Отбор = Новый Структура("ИдСтроки", СтрокаОбщиеЗатраты.ИдСтроки);
		НайденныеСтроки = Объект.РаспределениеОбщихЗатрат.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			
			// Добавили строку общих затрат, но нет ни одной строки прямых затрат.
			// Добавим новую строку прямых затрат и сохраним всю информацию из строки общих затрат.
			НоваяСтрока = Объект.РаспределениеОбщихЗатрат.Добавить();
			
			Если Счета10960.Количество() = 1 Тогда
				НоваяСтрока.СчетУчета = Счета10960[0].Значение;
				УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(НоваяСтрока, ДанныеСчетов);
			КонецЕсли;
			
			ЗаполнитьРеквизитыПоСтрокеОбщихЗатрат(НоваяСтрока, СтрокаОбщиеЗатраты);
			ОбработанныеСтроки.Добавить(НоваяСтрока);
			
		Иначе
			Для Каждого СтрокаРаспределениеОбщихЗатрат Из НайденныеСтроки Цикл
				ЗаполнитьРеквизитыПоСтрокеОбщихЗатрат(СтрокаРаспределениеОбщихЗатрат, СтрокаОбщиеЗатраты);
				ОбработанныеСтроки.Добавить(СтрокаРаспределениеОбщихЗатрат);
			КонецЦикла;
		КонецЕсли;
	
	КонецЦикла;
	
	// Удаляем строки прямых затрат, для которых нет соответствующей строки общих затрат.
	СтрокиКУдалению = Новый Массив;
	Для Каждого ТекСтрока Из Объект.РаспределениеОбщихЗатрат Цикл
		Если ОбработанныеСтроки.Найти(ТекСтрока) = Неопределено Тогда
			СтрокиКУдалению.Добавить(ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	Если СтрокиКУдалению.Количество() > 0 Тогда
		Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			Объект.РаспределениеОбщихЗатрат.Удалить(СтрокаКУдалению);
		КонецЦикла;
	КонецЕсли;
	
	ТекущийОбъект.РаспределениеОбщихЗатрат.Загрузить(Объект.РаспределениеОбщихЗатрат.Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПризнакНаправленияДеятельностиПодразделенияВТаблице(Таблица)
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(СтрокаТаблицы, ДанныеСчетов);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(ТекСтрока, ДанныеСчетов)

	ДанныеСчета = ДанныеСчетов.Получить(ТекСтрока.СчетУчета);
	Если ДанныеСчета = Неопределено Тогда
		ТекСтрока.ЕстьНаправлениеДеятельности	= Ложь;
		ТекСтрока.ЕстьПодразделение				= Ложь;
		ТекСтрока.ВидДопСубконто = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка");
	Иначе
		ТекСтрока.ЕстьНаправлениеДеятельности	= ДанныеСчета.ЕстьНаправлениеДеятельности;
		ТекСтрока.ЕстьПодразделение				= ДанныеСчета.ЕстьПодразделение;
		ТекСтрока.ВидДопСубконто = ДанныеСчета.ВидДопСубконто;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыВСтрокеОбщиеЗатраты(СтрокаОбщиеЗатраты)
	
	СтрокаОбщиеЗатраты.Сумма                    = 0;
	СтрокаОбщиеЗатраты.СуммаЕНВД                = 0;
	СтрокаОбщиеЗатраты.СуммаНеУчитываетсяНУ     = 0;
	
	Отбор = Новый Структура("ИдСтроки", СтрокаОбщиеЗатраты.ИдСтроки);
	НайденныеСтроки = Объект.РаспределениеОбщихЗатрат.НайтиСтроки(Отбор);
	Для Каждого СтрокаРаспределениеОбщихЗатрат Из НайденныеСтроки Цикл
		
		СтрокаОбщиеЗатраты.Сумма = СтрокаОбщиеЗатраты.Сумма
			+ СтрокаРаспределениеОбщихЗатрат.Сумма;
		СтрокаОбщиеЗатраты.СуммаЕНВД = СтрокаОбщиеЗатраты.СуммаЕНВД
			+ СтрокаРаспределениеОбщихЗатрат.СуммаЕНВД;
		СтрокаОбщиеЗатраты.СуммаНеУчитываетсяНУ = СтрокаОбщиеЗатраты.СуммаНеУчитываетсяНУ
			+ СтрокаРаспределениеОбщихЗатрат.СуммаНеУчитываетсяНУ;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыБазыВСтрокеОбщиеЗатраты(СтрокаОбщиеЗатраты)
	
	СтрокаОбщиеЗатраты.СуммаБазы                = 0;
	СтрокаОбщиеЗатраты.СуммаБазыЕНВД            = 0;
	СтрокаОбщиеЗатраты.СуммаБазыНеУчитываетсяНУ = 0;
	
	Отбор = Новый Структура("ИдСтроки", СтрокаОбщиеЗатраты.ИдСтроки);
	НайденныеСтроки = Объект.РаспределениеОбщихЗатрат.НайтиСтроки(Отбор);
	Для Каждого СтрокаРаспределениеОбщихЗатрат Из НайденныеСтроки Цикл
		
		СтрокаОбщиеЗатраты.СуммаБазы = СтрокаОбщиеЗатраты.СуммаБазы
			+ СтрокаРаспределениеОбщихЗатрат.СуммаБазы;
		СтрокаОбщиеЗатраты.СуммаБазыЕНВД = СтрокаОбщиеЗатраты.СуммаБазыЕНВД
			+ СтрокаРаспределениеОбщихЗатрат.СуммаБазыЕНВД;
		СтрокаОбщиеЗатраты.СуммаБазыНеУчитываетсяНУ = СтрокаОбщиеЗатраты.СуммаБазыНеУчитываетсяНУ
			+ СтрокаРаспределениеОбщихЗатрат.СуммаБазыНеУчитываетсяНУ;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОбщиеЗатратыПоляАналитикиСчетаУчета()

	// Пути к данным полей аналитики счета, выбираемого в таблице формы.
	Возврат Новый Структура("Счет, КПС, КЭК, Подразделение",
		"ОбщиеЗатраты.СчетУчета",
		"ОбщиеЗатраты.КПС",
		"ОбщиеЗатраты.КЭК",
		"ОбщиеЗатраты.Подразделение");

КонецФункции

&НаКлиенте
Процедура УстановитьОтборДетальныхСтрок()
	
	ТекущиеДанные  = Элементы.ЗатратыСводно.ТекущиеДанные;
	СтруктураОтбор = Новый Структура("КлючСтроки", ?(ТекущиеДанные=Неопределено, "", ТекущиеДанные.КлючСтроки));
	Если НЕ ЗначениеЗаполнено(СтруктураОтбор.КлючСтроки) Тогда
		СтруктураОтбор.Вставить("КлючСтроки", "{НеПоказыватьДетальныеСтроки}");
	КонецЕсли;
	
	Элементы.ЗатратыДетально.ОтборСтрок   = Новый ФиксированнаяСтруктура(СтруктураОтбор);
	Элементы.ЗатратыДетальноНУ.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбор);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокиДетализации(ОтборСтрок)
	
	МассивСтрок = ЭтотОбъект["ЗатратыДетально"].НайтиСтроки(ОтборСтрок);
	Для каждого Строка Из МассивСтрок Цикл
		ЗатратыДетально.Удалить(Строка);
	КонецЦикла; 
	
	МассивСтрокНУ = ЭтотОбъект["ЗатратыДетальноНУ"].НайтиСтроки(ОтборСтрок);
	Для каждого Строка Из МассивСтрокНУ Цикл
		ЗатратыДетальноНУ.Удалить(Строка);
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗатратыСводноПоляАналитикиСчетаСписания()

	// Пути к данным полей аналитики счета, выбираемого в таблице формы.
	Возврат Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
		"ЗатратыСводно.СчетДт",
		"ЗатратыСводно.СубконтоДт1",
		"ЗатратыСводно.СубконтоДт2",
		"ЗатратыСводно.СубконтоДт3");
	// Здесь только поля, управление которыми осуществляется стандартным образом.
	// Поля КПСДт, КЭКДт, ПодразделениеДт обрабатываются особым образом,
	// т.к. для них доступны "особые" настройки "Взять из Кт".

КонецФункции

&НаСервере
Процедура ЗатратыСводноЗаполнитьДобавленныеКолонки()
	
	БухгалтерскийУчет.УстановитьДоступностьПолейАналитикиСчетаВТаблице(
			ЗатратыСводно, "СчетДт", ЗатратыСводноПоляАналитикиСчетаСписания());
	УстановитьДоступностьПодразделенияВТаблице(ЗатратыСводно, "СчетДт",
		"ПодразделениеДтДоступность", "ПодразделениеДтОбязательно");
	Для Каждого СтрокаТаблицы Из ЗатратыСводно Цикл
		ЗатратыСводноОбновитьТекстЗаголовковВСтрокеТаблицы(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьПодразделенияВТаблице(Таблица, ИмяКолонкиСчет, ИмяКолонкиДоступность, ИмяКолонкиОбязательность)
	
	ТаблицаВсеСчета = Таблица.Выгрузить(, ИмяКолонкиСчет);
	ТаблицаВсеСчета.Свернуть(ИмяКолонкиСчет);
	
	СвойстваСчетов = Новый Соответствие;
	Для Каждого СтрокаСчета Из ТаблицаВсеСчета Цикл
		Если ЗначениеЗаполнено(СтрокаСчета[ИмяКолонкиСчет]) Тогда
			СвойстваСчетов.Вставить(СтрокаСчета[ИмяКолонкиСчет],
				БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаСчета[ИмяКолонкиСчет]));
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ДанныеСчета = СвойстваСчетов.Получить(СтрокаТаблицы[ИмяКолонкиСчет]);
		Если ДанныеСчета <> Неопределено Тогда
			УстановитьСвойстваПодразделенияВСтроке(СтрокаТаблицы, ДанныеСчета,
				ИмяКолонкиДоступность, ИмяКолонкиОбязательность);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗатратыСводноУстановитьДоступностьПодразделенияДт(СтрокаСводно)

	СвойстваСчетаДт = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СтрокаСводно.СчетДт);
	УстановитьСвойстваПодразделенияВСтроке(СтрокаСводно, СвойстваСчетаДт,
		"ПодразделениеДтДоступность", "ПодразделениеДтОбязательно");

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвойстваПодразделенияВСтроке(Строка, СвойстваСчета, ИмяКолонкиДоступность, ИмяКолонкиОбязательность)
	Строка[ИмяКолонкиДоступность] = СвойстваСчета.УчетПоПодразделениям;
	Строка[ИмяКолонкиОбязательность] = НЕ СвойстваСчета.РазрешитьНеУказыватьПодразделение;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗатратыСводноОбновитьТекстЗаголовковВСтрокеТаблицы(СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокСуммаНУ              = НСтр("ru = 'Сумма (НУ):'");
	СтрокаТаблицы.ЗаголовокСуммаНеУчитываетсяНУ = НСтр("ru = 'Не уч. (НУ):'");
	СтрокаТаблицы.ЗаголовокСуммаЕНВД            = НСтр("ru = 'ЕНВД (НУ):'");
	
КонецПроцедуры

