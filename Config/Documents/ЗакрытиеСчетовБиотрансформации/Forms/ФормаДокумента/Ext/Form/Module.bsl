Процедура ЗатратыДетальноЗаполнитьДобавленныеКолонки()
	
	БухгалтерскийУчет.УстановитьДоступностьПолейАналитикиСчетаВТаблице(ЗатратыДетально, "СчетКт",
		ЗатратыДетальноПоляАналитикиСчетаЗатрат());
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьДопСубконто(ТекущиеДанные)
	
	СвойстваСчетаКт = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.СчетКт);
	
	ЕстьДопСубконтоНаСчетеКт = Ложь;
	Для НомерСубконто=1 По СвойстваСчетаКт.КоличествоСубконто Цикл
		Если СвойстваСчетаКт["ВидСубконто"+НомерСубконто] = ВидДопСубконто Тогда
			ЕстьДопСубконтоНаСчетеКт = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ТекущиеДанные.ДопСубконтоДоступность = ЕстьДопСубконтоНаСчетеКт;
	
	Если НЕ ЕстьДопСубконтоНаСчетеКт Тогда
		ТекущиеДанные.ДопСубконто = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗатратыДетальноНУПоляАналитикиСчетаЗатрат()

	// Пути к данным полей аналитики счета, выбираемого в таблице формы.
	Возврат Новый Структура("Счет, Подразделение",
		"ЗатратыДетальноНУ.СчетКт",
		"ЗатратыДетальноНУ.ПодразделениеКт");

КонецФункции

&НаСервере
Процедура ЗатратыДетальноНУЗаполнитьДобавленныеКолонки()
	
	Для Каждого СтрокаТаблицы Из ЗатратыДетальноНУ Цикл
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаТаблицы, СтрокаТаблицы.СчетКт, ЗатратыДетальноНУПоляАналитикиСчетаЗатрат());
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗакрытиеФормыВводаСчетаДебетаЗавершение(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		ВыделенныеСтроки = Элементы.ЗатратыСводно.ВыделенныеСтроки;
		Если ЗатратыСводно.Количество() > 1 И ВыделенныеСтроки.Количество() = 1 Тогда
			
			ТекстВопроса = НСтр("ru='Выделена только одна строка таблицы.
				|Установить счет и аналитику списания во всех строках таблицы?'");
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да,  НСтр("ru='Во всех строках'"));
			Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='В выделенной строке'"));
			
			Ответ = Ждать ВопросАсинх(ТекстВопроса, Кнопки, 15, КодВозвратаДиалога.Да, "Установить значения");
			Если Ответ = КодВозвратаДиалога.Нет Тогда // В выделенной строке
				ВыделенныеСтроки = Элементы.ЗатратыСводно.ВыделенныеСтроки;
				УстановитьСчетаСписания(Результат, ВыделенныеСтроки);
			Иначе // Во всех строках
				УстановитьСчетаСписания(Результат);
			КонецЕсли;
			
		Иначе
			УстановитьСчетаСписания(Результат, ВыделенныеСтроки);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСчетаСписания(ВыбранныеЗначения, ВыделенныеСтроки = Неопределено)

	МассивСчетов40120 = БухгалтерскийУчет.СписокСчетов("401.20");
	Для каждого СтрокаСводно Из ЗатратыСводно Цикл
	
		Если ЗначениеЗаполнено(ВыделенныеСтроки) И ВыделенныеСтроки.Количество() > 0 Тогда
			Если ВыделенныеСтроки.Найти(СтрокаСводно.ПолучитьИдентификатор()) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаСводно.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаСводно, ВыбранныеЗначения);
		
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаСводно, СтрокаСводно.СчетДт, ЗатратыСводноПоляАналитикиСчетаСписания());
		БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
			ЭтотОбъект, СтрокаСводно.СчетДт, ЗатратыСводноПоляАналитикиСчетаСписания());
		
		ЗатратыСводноУстановитьДоступностьПодразделенияДт(СтрокаСводно);
		СтрокаСводно.СчетДт40120 = (МассивСчетов40120.Найти(СтрокаСводно.СчетДт) <> Неопределено);
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
