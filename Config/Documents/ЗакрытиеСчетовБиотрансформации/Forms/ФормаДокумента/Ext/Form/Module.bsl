&НаКлиенте
Процедура ЗатратыДетальноСчетКтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ЗатратыДетально.ТекущиеДанные;
	
	НайденныеСтроки = ЗатратыСводно.НайтиСтроки(Новый Структура("КлючСтроки", ТекущиеДанные.КлючСтроки));
	Если НайденныеСтроки.Количество()>0 Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыСчета = Новый Структура();
		Если НайденныеСтроки[0].ТипЗатрат = УчетПроизводстваКлиентСервер.ТипЗатратСебестоимость() Тогда
			ПараметрыСчета.Вставить("ОграниченияСписокСчетов", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("110.60"));
		ИначеЕсли НайденныеСтроки[0].ТипЗатрат = УчетПроизводстваКлиентСервер.ТипЗатратНакладныеРасходы() Тогда
			ПараметрыСчета.Вставить("ОграниченияСписокСчетов", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("110.70"));
		ИначеЕсли НайденныеСтроки[0].ТипЗатрат = УчетПроизводстваКлиентСервер.ТипЗатратОбщехозяйственныеРасходы() Тогда
			ПараметрыСчета.Вставить("ОграниченияСписокСчетов", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("110.80"));
		ИначеЕсли НайденныеСтроки[0].ТипЗатрат = УчетПроизводстваКлиентСервер.ТипЗатратИздержкиОбращения() Тогда
			ПараметрыСчета.Вставить("ОграниченияСписокСчетов", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("109.90"));
		КонецЕсли;
		ПараметрыСчета.Вставить("Отбор", Новый Структура("ЭлементГруппа", Ложь));
		ПараметрыСчета.Вставить("НаДата", Объект.Дата);
		ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыСчета, Элемент);
		
	КонецЕсли;
	
