&НаКлиенте
Функция СписокСчетовОбщихЗатрат()

	Список = Новый СписокЗначений;
	МассивСчетов = Новый Массив;
	
	// Бухгалтерский учет
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСчетов, Счета10970.ВыгрузитьЗначения());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСчетов, Счета10980.ВыгрузитьЗначения());
	
	// Налоговый учет
	Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль И Объект.ОтражатьВНалоговомУчете Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСчетов, СчетаНУ.ВыгрузитьЗначения());
//		Список.Добавить(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н25.11"));
//		Список.Добавить(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н26.11"));
	КонецЕсли;
	
	Список.ЗагрузитьЗначения(МассивСчетов);
	Возврат Список;

КонецФункции

