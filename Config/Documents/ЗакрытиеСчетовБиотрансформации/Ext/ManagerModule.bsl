#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ПолучитьОбщиеПараметрыУчетаРасходов() Экспорт
	
	ОбщиеПараметрыУчетаРасходов = Новый Структура(
		"ФинРезультатЕстьУчетПоПодразделениям,
		|ЗатратыЕстьУчетПоПодразделениям,ЗатратыЕстьДопСубконтоБУ,ЗатратыЕстьДопСубконтоНУ,ЗатратыВидДопСубконто");
	
	НомераТаблиц = Новый Структура;
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ВложенныйЗапрос.УчетПоПодразделениям), ЛОЖЬ) КАК ЕстьУчетПоПодразделениям
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕПСБУ.УчетПоПодразделениям КАК УчетПоПодразделениям
	|	ИЗ
	|		ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|	ГДЕ
	|		ЕПСБУ.Ссылка В(&СчетаФинРезультата)) КАК ВложенныйЗапрос";
	НомераТаблиц.Вставить("ФинРезультатУчетПоПодразделениям", НомераТаблиц.Количество());
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ВложенныйЗапрос.УчетПоПодразделениям), ЛОЖЬ) КАК ЕстьУчетПоПодразделениям
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕПСБУ.УчетПоПодразделениям КАК УчетПоПодразделениям
	|	ИЗ
	|		ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|	ГДЕ
	|		ЕПСБУ.Ссылка В (&СчетаРасходовБУ, &СчетаРасходовНУ)) КАК ВложенныйЗапрос";
	НомераТаблиц.Вставить("РасходыБУУчетПоПодразделениям", НомераТаблиц.Количество());
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕПСБУВидыСубконто.ВидСубконто КАК ВидДопСубконтоБУ
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка В(&СчетаРасходовБУ)
	|	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕПСБУВидыСубконто.Ссылка";
	НомераТаблиц.Вставить("РасходыБУДопСубконто", НомераТаблиц.Количество());
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕПСБУВидыСубконто.ВидСубконто КАК ВидДопСубконтоНУ
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка В(&СчетаРасходовНУ)
	|	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕПСБУВидыСубконто.Ссылка";
	НомераТаблиц.Вставить("РасходыНУДопСубконто", НомераТаблиц.Количество());
	
	Запрос.УстановитьПараметр("СчетаРасходовБУ",    БухгалтерскийУчет.СписокСчетов("109.00"));
	Запрос.УстановитьПараметр("СчетаРасходовНУ",    БухгалтерскийУчет.СписокСчетов("Н20.11,Н20.21,Н25.11,Н25.21,Н26.11,Н26.12,Н44"));
	Запрос.УстановитьПараметр("СчетаФинРезультата", БухгалтерскийУчет.СписокСчетов("401.10,401.20"));
	
	Результат = Запрос.ВыполнитьПакет();
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	// Проверим наличие учета по подразделениям на счетах 401.10, 401.20.
	ВыборкаФинРезультат = Результат[НомераТаблиц.ФинРезультатУчетПоПодразделениям].Выбрать();
	Если ВыборкаФинРезультат.Следующий() Тогда
		ОбщиеПараметрыУчетаРасходов.ФинРезультатЕстьУчетПоПодразделениям =
			ИспользоватьУчетПоПодразделениям И ВыборкаФинРезультат.ЕстьУчетПоПодразделениям;
	Иначе
		ОбщиеПараметрыУчетаРасходов.ФинРезультатЕстьУчетПоПодразделениям = Ложь;
	КонецЕсли;
	
	// Проверим наличие учета по подразделениям на счетах расходов 109.ХХ.
	ВыборкаУчетПоПодразделениямБУ = Результат[НомераТаблиц.РасходыБУУчетПоПодразделениям].Выбрать();
	Если ВыборкаУчетПоПодразделениямБУ.Следующий() Тогда
		ОбщиеПараметрыУчетаРасходов.ЗатратыЕстьУчетПоПодразделениям =
			ИспользоватьУчетПоПодразделениям И ВыборкаУчетПоПодразделениямБУ.ЕстьУчетПоПодразделениям;
	Иначе
		ОбщиеПараметрыУчетаРасходов.ЗатратыЕстьУчетПоПодразделениям = Ложь;
	КонецЕсли;
	
	// Проверим наличие доп. субконто в БУ и НУ
	ВыборкаДопАналитикаБУ = Результат[НомераТаблиц.РасходыБУДопСубконто].Выбрать();
	ОбщиеПараметрыУчетаРасходов.ЗатратыЕстьДопСубконтоБУ = ВыборкаДопАналитикаБУ.Следующий();
	
	ВыборкаДопАналитикаНУ = Результат[НомераТаблиц.РасходыНУДопСубконто].Выбрать();
	ОбщиеПараметрыУчетаРасходов.ЗатратыЕстьДопСубконтоНУ = ВыборкаДопАналитикаНУ.Следующий();
	
	// Пока поддерживаем только направления деятельности
	ВидДопСубконто = ПланыВидовХарактеристик.ВидыСубконто.НаправленияДеятельности;
	ОбщиеПараметрыУчетаРасходов.ЗатратыВидДопСубконто = ВидДопСубконто;
	
	Возврат ОбщиеПараметрыУчетаРасходов;
	
КонецФункции

// Возвращает остатки затрат по документам "Списание затрат по услугам" для печати ведомости и контроля остатков.
//
Функция ОстаткиЗатратПоДокументамСписания(ДокументыСписания) Экспорт
	
	Если ТипЗнч(ДокументыСписания) = Тип("Массив") Тогда
		МассивОбъектов = ДокументыСписания;
	ИначеЕсли ТипЗнч(ДокументыСписания) = Тип("ДокументСсылка.ЗакрытиеСчетовБиотрансформации") Тогда
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(ДокументыСписания);
	КонецЕсли;
	
	НомераТаблиц = Новый Структура;
	Запрос = Новый Запрос;
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ОбщиеПараметрыУчетаРасходов = ПолучитьОбщиеПараметрыУчетаРасходов();
	Запрос.УстановитьПараметр("ЗатратыЕстьУчетПоПодразделениям", ОбщиеПараметрыУчетаРасходов.ЗатратыЕстьУчетПоПодразделениям);
	Запрос.УстановитьПараметр("ЗатратыЕстьДопСубконтоБУ",        ОбщиеПараметрыУчетаРасходов.ЗатратыЕстьДопСубконтоБУ);
	Запрос.УстановитьПараметр("ЗатратыЕстьДопСубконтоНУ",        ОбщиеПараметрыУчетаРасходов.ЗатратыЕстьДопСубконтоНУ);
	Запрос.УстановитьПараметр("ЗатратыВидДопСубконто",           ОбщиеПараметрыУчетаРасходов.ЗатратыВидДопСубконто);
	
	Запрос.УстановитьПараметр("ВидСубконтоНоменклатура", ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	Запрос.УстановитьПараметр("ВидСубконтоВидыЗатрат",   ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат);
	
	Запрос.Текст = "";
	
	Для Сч=1 По МассивОбъектов.Количество() Цикл
		
		ДокументСписания = МассивОбъектов[Сч-1];
		
		// Остатки затрат будем рассчитывать на конец дня (включительно), поскольку:
		// 1) Заполнение документа производится по остаткам на конец дня.
		// 2) В последнее число месяца в 23:59:59 может попасть регл. операция закрытия счетов производственных затрат,
		//    которая при распределении общих расходов сформирует проводки по Дт 109.ХХ.
		//    Если взять остатки на момент документа, эти движения в ведомости будут отражены как перерасход.
		// Не поддерживается ввод двух и более документов списания одних и тех же затрат в один день, поскольку:
		// 1) Ведомость списания затрат формируется на конкретную дату.
		// 2) Две ведомости списания затрат от одной даты содержали бы разное сальдо по счетам 109.ХХ.
		Запрос.УстановитьПараметр("КонПериода"+Сч, Новый Граница(КонецДня(ДокументСписания.Дата), ВидГраницы.Включая));
		
		Запрос.УстановитьПараметр("Ссылка"+Сч,      ДокументСписания);
		Запрос.УстановитьПараметр("Организация"+Сч, ДокументСписания.Организация);
		Запрос.УстановитьПараметр("КФО"+Сч,         ДокументСписания.КФО);
		Запрос.УстановитьПараметр("ИФО"+Сч,         ДокументСписания.ИФО);
		
		ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(ДокументСписания.Организация, ДокументСписания.Дата, ДокументСписания.КФО);
		Запрос.УстановитьПараметр("ОтражатьВНалоговомУчете"+Сч, ОтражатьВНалоговомУчете);
		Если ОтражатьВНалоговомУчете Тогда
			Запрос.УстановитьПараметр("СчетаРасходов"+Сч,                        БухгалтерскийУчет.СписокСчетов("110.00,Н20.11,Н20.12,Н25.11,Н25.12,Н26.11,Н26.12,Н44"));
			Запрос.УстановитьПараметр("МассивСчетовСебестоимость"+Сч,            БухгалтерскийУчет.СписокСчетов("110.60,Н20.11,Н20.12"));
			Запрос.УстановитьПараметр("МассивСчетовНакладныеРасходы"+Сч,         БухгалтерскийУчет.СписокСчетов("110.70,Н25.11,Н25.12"));
			Запрос.УстановитьПараметр("МассивСчетовОбщехозяйственныеРасходы"+Сч, БухгалтерскийУчет.СписокСчетов("110.80,Н26.11,Н26.12"));
			Запрос.УстановитьПараметр("МассивСчетовИздержкиОбращения"+Сч,        БухгалтерскийУчет.СписокСчетов("Н44"));
		Иначе
			Запрос.УстановитьПараметр("СчетаРасходов"+Сч,                        БухгалтерскийУчет.СписокСчетов("110.00"));
			Запрос.УстановитьПараметр("МассивСчетовСебестоимость"+Сч,            БухгалтерскийУчет.СписокСчетов("110.60"));
			Запрос.УстановитьПараметр("МассивСчетовНакладныеРасходы"+Сч,         БухгалтерскийУчет.СписокСчетов("110.70"));
			Запрос.УстановитьПараметр("МассивСчетовОбщехозяйственныеРасходы"+Сч, БухгалтерскийУчет.СписокСчетов("110.80"));
			Запрос.УстановитьПараметр("МассивСчетовИздержкиОбращения"+Сч,        Неопределено);
		КонецЕсли;
		
		НомераТаблиц.Вставить("ОстаткиЗатратНаКонецДня"+Сч, НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + 
		"ВЫБРАТЬ
		|	ЕПСБУОстатки.Счет,
		|	ЕСТЬNULL(ЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
		|	ЕСТЬNULL(ЕПСБУОстатки.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭК,
		|	ВЫБОР
		|		КОГДА &ЗатратыЕстьУчетПоПодразделениям
		|				И ЕПСБУОстатки.Счет.УчетПоПодразделениям
		|			ТОГДА ЕПСБУОстатки.Подразделение
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ КАК Подразделение,
		|	ВЫБОР
		|		КОГДА ВидыСубконто1.ВидСубконто = &ВидСубконтоНоменклатура
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	КОНЕЦ КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА ВидыСубконто1.ВидСубконто = &ВидСубконтоВидыЗатрат
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ВидыЗатрат)
		|		КОГДА ВидыСубконто2.ВидСубконто = &ВидСубконтоВидыЗатрат
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка)
		|	КОНЕЦ КАК ВидЗатрат,
		|	ВЫБОР
		|		КОГДА ВидыСубконто2.ВидСубконто = &ЗатратыВидДопСубконто
		|			ТОГДА ЕПСБУОстатки.Субконто2
		|		КОГДА ВидыСубконто3.ВидСубконто = &ЗатратыВидДопСубконто
		|			ТОГДА ЕПСБУОстатки.Субконто3
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
		|	КОНЕЦ КАК ДопСубконто,
		|	ЕПСБУОстатки.СуммаОстатокДт КАК Сумма
		|ПОМЕСТИТЬ ОстаткиЗатратНаКонецДня_N
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&КонПериода_N,
		|			Счет В (&СчетаРасходов_N),
		|			,
		|			Организация = &Организация_N
		|				И &УсловиеИФО
		|				И КФО = &КФО_N) КАК ЕПСБУОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто1
		|		ПО ЕПСБУОстатки.Счет = ВидыСубконто1.Ссылка
		|			И (ВидыСубконто1.НомерСтроки = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто2
		|		ПО ЕПСБУОстатки.Счет = ВидыСубконто2.Ссылка
		|			И (ВидыСубконто2.НомерСтроки = 2)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто3
		|		ПО (ВидыСубконто3.НомерСтроки = 3)
		|			И ЕПСБУОстатки.Счет = ВидыСубконто3.Ссылка";
		
		НомераТаблиц.Вставить("СписаноЭтимДокументом"+Сч, НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ЕПСБУДвиженияССубконто.СчетКт КАК Счет,
		|	ЕСТЬNULL(ЕПСБУДвиженияССубконто.КПСКт, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
		|	ЕСТЬNULL(ЕПСБУДвиженияССубконто.КЭККт, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭК,
		|	ВЫБОР
		|		КОГДА &ЗатратыЕстьУчетПоПодразделениям
		|				И ЕПСБУДвиженияССубконто.СчетКт.УчетПоПодразделениям
		|			ТОГДА ЕПСБУДвиженияССубконто.ПодразделениеКт
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ КАК Подразделение,
		|	ВЫБОР
		|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоКт1 = &ВидСубконтоНоменклатура
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.Номенклатура)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	КОНЕЦ КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоКт1 = &ВидСубконтоВидыЗатрат
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.ВидыЗатрат)
		|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоКт2 = &ВидСубконтоВидыЗатрат
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.ВидыЗатрат)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка)
		|	КОНЕЦ КАК ВидЗатрат,
