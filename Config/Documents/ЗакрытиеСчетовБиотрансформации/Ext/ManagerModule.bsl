		|	ЗатратыКСписанию_N.КЭКДт КАК КЭКДт,
		|	ЗатратыКСписанию_N.ПодразделениеДт КАК ПодразделениеДт,
		|	ЗатратыКСписанию_N.СубконтоДт1 КАК СубконтоДт1,
		|	ЗатратыКСписанию_N.СубконтоДт2 КАК СубконтоДт2,
		|	ЗатратыКСписанию_N.СубконтоДт3 КАК СубконтоДт3,
		|	ЗатратыКСписанию_N.Сумма КАК СуммаКСписанию,
		|	ЗатратыКСписанию_N.СуммаНУ КАК СуммаКСписаниюНУ
		|ИЗ
		|	ЗатратыКСписанию_N КАК ЗатратыКСписанию_N
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидУчета,
		|	УслугаРасход,
		|	ЗатратыКСписанию_N.ВидЗатрат.Наименование";
		
		НомераТаблиц.Вставить("ЗатратыПоДаннымУчета"+Сч, НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ЗатратыКСписанию_N.Ссылка КАК Ссылка,
		|	ЗатратыКСписанию_N.ВидУчета КАК ВидУчета,
		|	ЗатратыКСписанию_N.ТипЗатрат КАК ТипЗатрат,
		|	ЗатратыКСписанию_N.УслугаРасход КАК УслугаРасход,
		|	ЗатратыКСписанию_N.Номенклатура КАК Номенклатура,
		|	ЗатратыКСписанию_N.ВидЗатрат КАК ВидЗатрат,
		|	ЗатратыКСписанию_N.ВидРасходовНУ КАК ВидРасходовНУ,
		|	ЗатратыКСписанию_N.ДопСубконто КАК ДопСубконто,
		|	ЗатратыКСписанию_N.СчетКт КАК СчетКт,
		|	ЗатратыКСписанию_N.КПСКт КАК КПСКт,
		|	ЗатратыКСписанию_N.КЭККт КАК КЭККт,
		|	ЗатратыКСписанию_N.ПодразделениеКт КАК ПодразделениеКт,
		|	ЗатратыКСписанию_N.Сумма КАК СуммаКСписанию,
		|	ЗатратыКСписанию_N.СуммаНУ КАК СуммаКСписаниюНУ,
		|	ЕСТЬNULL(ОстаткиЗатрат_N.Сумма, 0) КАК СуммаОстаток
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЗатратыКСписанию_N.Ссылка КАК Ссылка,
		|		ЗатратыКСписанию_N.ВидУчета КАК ВидУчета,
		|		ЗатратыКСписанию_N.ТипЗатрат КАК ТипЗатрат,
		|		ЗатратыКСписанию_N.УслугаРасход КАК УслугаРасход,
		|		ЗатратыКСписанию_N.Номенклатура КАК Номенклатура,
		|		ЗатратыКСписанию_N.ВидЗатрат КАК ВидЗатрат,
		|		ЗатратыКСписанию_N.НаименованиеВидаЗатрат КАК НаименованиеВидаЗатрат,
		|		ЗатратыКСписанию_N.ВидРасходовНУ КАК ВидРасходовНУ,
		|		ЗатратыКСписанию_N.ДопСубконто КАК ДопСубконто,
		|		ЗатратыКСписанию_N.СчетКт КАК СчетКт,
		|		ЗатратыКСписанию_N.КПСКт КАК КПСКт,
		|		ЗатратыКСписанию_N.КЭККт КАК КЭККт,
		|		ЗатратыКСписанию_N.ПодразделениеКт КАК ПодразделениеКт,
		|		СУММА(ЗатратыКСписанию_N.Сумма) КАК Сумма,
		|		СУММА(ЗатратыКСписанию_N.СуммаНУ) КАК СуммаНУ
		|	ИЗ
		|		ЗатратыКСписанию_N КАК ЗатратыКСписанию_N
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ЗатратыКСписанию_N.ДопСубконто,
		|		ЗатратыКСписанию_N.СчетКт,
		|		ЗатратыКСписанию_N.КЭККт,
		|		ЗатратыКСписанию_N.Ссылка,
		|		ЗатратыКСписанию_N.Номенклатура,
		|		ЗатратыКСписанию_N.ВидЗатрат,
		|		ЗатратыКСписанию_N.НаименованиеВидаЗатрат,
		|		ЗатратыКСписанию_N.ВидРасходовНУ,
		|		ЗатратыКСписанию_N.УслугаРасход,
		|		ЗатратыКСписанию_N.ВидУчета,
		|		ЗатратыКСписанию_N.КПСКт,
		|		ЗатратыКСписанию_N.ПодразделениеКт,
		|		ЗатратыКСписанию_N.ТипЗатрат) КАК ЗатратыКСписанию_N
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиЗатрат_N КАК ОстаткиЗатрат_N
		|		ПО ЗатратыКСписанию_N.СчетКт = ОстаткиЗатрат_N.Счет
		|			И ЗатратыКСписанию_N.КПСКт = ОстаткиЗатрат_N.КПС
		|			И ЗатратыКСписанию_N.КЭККт = ОстаткиЗатрат_N.КЭК
		|			И ЗатратыКСписанию_N.ПодразделениеКт = ОстаткиЗатрат_N.Подразделение
		|			И ЗатратыКСписанию_N.Номенклатура = ОстаткиЗатрат_N.Номенклатура
		|			И ЗатратыКСписанию_N.ВидЗатрат = ОстаткиЗатрат_N.ВидЗатрат
		|			И ЗатратыКСписанию_N.ДопСубконто = ОстаткиЗатрат_N.ДопСубконто
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидУчета,
		|	УслугаРасход,
		|	ЗатратыКСписанию_N.НаименованиеВидаЗатрат
		|ИТОГИ
		|	СУММА(СуммаКСписанию),
		|	СУММА(СуммаКСписаниюНУ),
		|	СУММА(СуммаОстаток)
		|ПО
		|	ВидУчета,
		|	ТипЗатрат,
		|	Номенклатура,
		|	УслугаРасход";
		
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", ?(ИспользоватьУчетПоИФО, "ИФО = &ИФО_N", "ИСТИНА"));
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "_N", Строка(Сч)); // проставим номер объекта в тексте запроса
		
	КонецЦикла;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОстаткиЗатрат = Новый Структура;
	Для Сч=1 По МассивОбъектов.Количество() Цикл
		
		ОстаткиЗатрат.Вставить("ЗатратыПоДокументуСписания"+Сч,
			Результат[НомераТаблиц["ЗатратыПоДокументуСписания"+Сч]] );
		
		ОстаткиЗатрат.Вставить("ЗатратыПоДаннымУчета"+Сч,
			Результат[НомераТаблиц["ЗатратыПоДаннымУчета"+Сч]] );
		
	КонецЦикла;
	
	Возврат ОстаткиЗатрат;
	
КонецФункции

// Возвращает таблицу остатков накопленных расходов на оказание услуг, выполнение работ
//
Функция ОстаткиЗатратНаОказаниеУслуг(Период, Организация, ИФО, КФО, МассивУслуг = Неопределено) Экспорт
	
	НомераТаблиц = Новый Структура;
	
	// Формируем запрос по остаткам затрат
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Счет КАК Счет,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ЕПСБУОстатки.КЭК КАК КЭК,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|				И ЕПСБУОстатки.Счет.УчетПоПодразделениям
	|			ТОГДА ЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ЕПСБУОстатки.Субконто1 КАК Субконто1,
	|	ЕПСБУОстатки.Субконто2 КАК Субконто2,
	|	ЕПСБУОстатки.Субконто3 КАК Субконто3,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
	|	ПРЕДСТАВЛЕНИЕ(ЕПСБУОстатки.Субконто1) КАК НоменклатураПредставление,
	|	ПРЕДСТАВЛЕНИЕ(ЕПСБУОстатки.Субконто2) КАК ВидЗатратПредставление,
	|	ЕПСБУОстатки.СуммаОстатокДт КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонПериода,
	|			Счет В (&СчетаРасходовБУ),
	|			,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И КФО = &КФО
	|				И &ОтборУслуг) КАК ЕПСБУОстатки";
	
	НомераТаблиц.Вставить("ТаблицаЗатратБУ", НомераТаблиц.Количество());
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, Период, КФО);
	Если ОтражатьВНалоговомУчете Тогда
		
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ЕПСБУОстатки.Счет КАК Счет,
		|	ЕПСБУОстатки.Субконто1 КАК Субконто1,
		|	ЕПСБУОстатки.Субконто2 КАК Субконто2,
		|	ЕПСБУОстатки.Субконто3 КАК Субконто3,
		|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
		|	ПРЕДСТАВЛЕНИЕ(ЕПСБУОстатки.Субконто1) КАК НоменклатураПредставление,
		|	ПРЕДСТАВЛЕНИЕ(ЕПСБУОстатки.Субконто2) КАК ВидЗатратПредставление,
		|	ЕПСБУОстатки.СуммаОстатокДт КАК Сумма,
		|	ЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СуммаЕНВД,
		|	ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУ
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&КонПериода,
		|			Счет В (&СчетаРасходовНУ),
		|			,
		|			Организация = &Организация
		|				И &УсловиеИФО
		|				И КФО = &КФО
		|				И &ОтборУслуг) КАК ЕПСБУОстатки";
		
		НомераТаблиц.Вставить("ТаблицаЗатратНУ", НомераТаблиц.Количество());
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("КонПериода",           Период);
	Запрос.УстановитьПараметр("Организация",          Организация);
	Запрос.УстановитьПараметр("КФО",                  КФО);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО, "ИФО = &ИФО", "ИСТИНА"));
	Запрос.УстановитьПараметр("ИФО", ИФО);
	
	Если МассивУслуг = Неопределено Тогда
		
		УслугиРаботы = Новый Массив;
		УслугиРаботы.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
		УслугиРаботы.Добавить(Перечисления.ТипыНоменклатуры.Работа);
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборУслуг", "ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).ТипНоменклатуры В (&УслугиРаботы)");
		Запрос.УстановитьПараметр("УслугиРаботы", УслугиРаботы);
		
	Иначе
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборУслуг", "Субконто1 В (&МассивУслуг)");
		Запрос.УстановитьПараметр("МассивУслуг", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(МассивУслуг));
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СчетаРасходовБУ", БухгалтерскийУчет.СписокСчетов("109.60"));
	Запрос.УстановитьПараметр("СчетаРасходовНУ", БухгалтерскийУчет.СписокСчетов("Н20.11,Н20.21"));
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаЗатратБУ = Результат[НомераТаблиц.ТаблицаЗатратБУ].Выгрузить();
	ТаблицаЗатратБУ.Сортировать("Счет,НоменклатураПредставление,ВидЗатратПредставление");
	
	Если ОтражатьВНалоговомУчете Тогда
		ТаблицаЗатратНУ = Результат[НомераТаблиц.ТаблицаЗатратНУ].Выгрузить();
		ТаблицаЗатратНУ.Сортировать("Счет,НоменклатураПредставление,ВидЗатратПредставление");
	Иначе
		ТаблицаЗатратНУ = Новый ТаблицаЗначений;
	КонецЕсли;
	
	ОстаткиЗатрат = Новый Структура("ТаблицаЗатратБУ, ТаблицаЗатратНУ", ТаблицаЗатратБУ, ТаблицаЗатратНУ);
	
	Возврат ОстаткиЗатрат;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("РаспределениеОбщихЗатрат", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РаспределениеОбщихЗатрат.Ссылка.Дата КАК ПериодРасчета,
	|	РаспределениеОбщихЗатрат.Ссылка.Организация,
	|	РаспределениеОбщихЗатрат.ИФО,
	|	РаспределениеОбщихЗатрат.КФО,
	|	РаспределениеОбщихЗатрат.Подразделение,
	|	ВЫБОР
	|		КОГДА РаспределениеОбщихЗатрат.СчетУчета В (&СчетаОбщепроизводственныхЗатрат)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты)
	|		КОГДА РаспределениеОбщихЗатрат.СчетУчета В (&СчетаОбщехозяйственныхЗатрат)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщехозяйственныеЗатраты)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыОбщихЗатратНаПроизводство.ПустаяСсылка)
	|	КОНЕЦ КАК ВидОбщихЗатрат,
	|	РаспределениеОбщихЗатрат.ВидЗатрат,
	|	РаспределениеОбщихЗатрат.КЭК,
	|	РаспределениеОбщихЗатрат.СчетУчета,
	|	РаспределениеОбщихЗатрат.КПС,
	|	РаспределениеОбщихЗатрат.НаправлениеДеятельности,
	|	РаспределениеОбщихЗатрат.КорСчет,
	|	РаспределениеОбщихЗатрат.КорКПС,
	|	РаспределениеОбщихЗатрат.КорНоменклатурнаяГруппа,
	|	РаспределениеОбщихЗатрат.КорПодразделение,
	|	РаспределениеОбщихЗатрат.КорНаправлениеДеятельности,
	|	РаспределениеОбщихЗатрат.Сумма,
	|	РаспределениеОбщихЗатрат.СуммаЕНВД,
	|	РаспределениеОбщихЗатрат.СуммаНеУчитываетсяНУ,
	|	РаспределениеОбщихЗатрат.СуммаБазы,
	|	РаспределениеОбщихЗатрат.СуммаБазыЕНВД,
	|	РаспределениеОбщихЗатрат.СуммаБазыНеУчитываетсяНУ,
	|	РаспределениеОбщихЗатрат.БазаРаспределения
	|ИЗ
	|	Документ.ЗакрытиеСчетовБиотрансформации.РаспределениеОбщихЗатрат КАК РаспределениеОбщихЗатрат
	|ГДЕ
	|	РаспределениеОбщихЗатрат.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	РаспределениеОбщихЗатрат.НомерСтроки";
	
	Запрос.УстановитьПараметр("СчетаОбщепроизводственныхЗатрат",
		БухгалтерскийУчет.СписокСчетов("110.70,Н25"));
	Запрос.УстановитьПараметр("СчетаОбщехозяйственныхЗатрат",
		БухгалтерскийУчет.СписокСчетов("110.80,Н26")); 
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаРаспределениеОбщихЗатрат         = Результат[НомераТаблиц["РаспределениеОбщихЗатрат"]].Выгрузить();
	
	ТаблицаРаспределениеОбщихЗатрат.Свернуть("ПериодРасчета,Организация,ИФО,КФО,Подразделение,
		|ВидОбщихЗатрат,ВидЗатрат,КЭК,СчетУчета,КПС,НаправлениеДеятельности,
		|КорСчет,КорКПС,КорНоменклатурнаяГруппа,КорПодразделение,КорНаправлениеДеятельности,БазаРаспределения",
		"Сумма,СуммаЕНВД,СуммаНеУчитываетсяНУ,СуммаБазы,СуммаБазыЕНВД,СуммаБазыНеУчитываетсяНУ");
	
	ТаблицыДляДвижений.Вставить("РасчетРаспределенияОбщихЗатрат", ТаблицаРаспределениеОбщихЗатрат);
	
КонецПроцедуры

// Структура таблицы источника данных "Фактическая стоимость выпущенной продукции".
//
Функция ПустаяТаблицаФактическаяСтоимостьПродукции() Экспорт

	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	// Счет и аналитика учета себестоимости готовой продукции (затраты).
	ПустаяТаблица.Колонки.Добавить("СчетСебестоимости",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КПССебестоимости",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("ПодразделениеСебестоимости", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ПустаяТаблица.Колонки.Добавить("НоменклатурнаяГруппа",       Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("НаправлениеДеятельности",    Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"));
	ПустаяТаблица.Колонки.Добавить("ВидЗатрат",                  Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ПустаяТаблица.Колонки.Добавить("КЭК",                        Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	// Счет и аналитика учета готовой продукции (материальные запасы).
	ПустаяТаблица.Колонки.Добавить("СчетГотовойПродукции",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КПСГотовойПродукции",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭКГотовойПродукции",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("ПодразделениеГотовойПродукции", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ПустаяТаблица.Колонки.Добавить("Номенклатура",                  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	// Количество и сумма поступивших единиц.
	ПустаяТаблица.Колонки.Добавить("Количество",           ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("ФактическаяСтоимость", ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполнить документ - рассчитать все необходимые таблицы.
// 
// Параметры:
//  Документ - ДокументОбъект.ЗакрытиеСчетовБиотрансформации
//           - ДанныеФормыСтруктура
Процедура ЗаполнитьДокумент(Документ) Экспорт
	
	Обработка = Обработки.ЗакрытиеСчетовПроизводственныхЗатрат.ИнициализироватьОбработку(Документ.Дата,
		Документ.Организация, Документ.ИФО, Документ.КФО, Ложь, Истина);
	Обработка.ОтражатьВБухгалтерскомУчете = Документ.ОтражатьВБухгалтерскомУчете;
	Обработка.ОтражатьВНалоговомУчете = Документ.ОтражатьВНалоговомУчете;
	
	// Выполнить полный расчет
	Обработка.ЗаполнитьДокумент();
	
	// Перенести все заполненные данные из обработки в документ
	Обработки.ЗакрытиеСчетовПроизводственныхЗатрат.ПеренестиТабличнуюЧастьИзОбработкиВДокумент(Обработка, Документ, 
		"РаспределениеОбщихЗатрат");
	Обработки.ЗакрытиеСчетовПроизводственныхЗатрат.ПеренестиТабличнуюЧастьИзОбработкиВДокумент(Обработка, Документ, 
		"ЗатратыПрямые");
	Обработки.ЗакрытиеСчетовПроизводственныхЗатрат.ПеренестиТабличнуюЧастьИзОбработкиВДокумент(Обработка, Документ, 
		"ЗатратыОбщие");
	Обработки.ЗакрытиеСчетовПроизводственныхЗатрат.ПеренестиТабличнуюЧастьИзОбработкиВДокумент(Обработка, Документ, 
		"ЗатратыНУ");
	
КонецПроцедуры


// Заполнить распределение общих затрат.
// 
// Параметры:
//  Документ - ДокументОбъект.ЗакрытиеСчетовБиотрансформации
//           - ДанныеФормыСтруктура
Процедура ЗаполнитьРаспределениеОбщихЗатрат(Документ) Экспорт
	
	Обработка = Обработки.ЗакрытиеСчетовПроизводственныхЗатрат.ИнициализироватьОбработку(Документ.Дата,
		Документ.Организация, Документ.ИФО, Документ.КФО, Ложь, Истина);
	Обработка.ОтражатьВБухгалтерскомУчете = Документ.ОтражатьВБухгалтерскомУчете;
	Обработка.ОтражатьВНалоговомУчете = Документ.ОтражатьВНалоговомУчете;
	Обработка.РаспределитьОбщиеЗатраты();
	
	// Перенести результат заполнения в документ
	Документ.РаспределениеОбщихЗатрат.Очистить();
	Для Каждого СтрокаОбработки Из Обработка.РаспределениеОбщихЗатрат Цикл
		ЗаполнитьЗначенияСвойств(Документ.РаспределениеОбщихЗатрат.Добавить(), СтрокаОбработки);
	КонецЦикла;
	
КонецПроцедуры


// Заполняет документ остатками затрат по счетам учета затрат
// 
// Параметры:
//  Документ - ДокументОбъект.ЗакрытиеСчетовБиотрансформации
//           - ДанныеФормыСтруктура
Процедура ЗаполнитьДокументПоОстаткам(Документ) Экспорт

	Обработка = Обработки.ЗакрытиеСчетовПроизводственныхЗатрат.ИнициализироватьОбработку(Документ.Дата,
		Документ.Организация, Документ.ИФО, Документ.КФО, Ложь, Истина);
	Обработка.ОтражатьВБухгалтерскомУчете = Документ.ОтражатьВБухгалтерскомУчете;
	Обработка.ОтражатьВНалоговомУчете = Документ.ОтражатьВНалоговомУчете;
	Обработка.ЗаполнитьОбщиеЗатраты(Документ.РаспределениеОбщихЗатрат);

	МеткаВремениНачалоЗаполнения = ОценкаПроизводительности.НачатьЗамерВремени();
	
	Обработка.ЗаполнитьСписаниеПрямыхЗатрат();
	
	ОценкаПроизводительности.ЗакончитьЗамерВремени("ЗаполнениеДокументаЗакрытиеСчетовБиотрансформации", МеткаВремениНачалоЗаполнения);
	
	Документ.ЗатратыПрямые.Загрузить(Обработка.СписаниеПрямыхЗатрат.Выгрузить());
	Документ.ЗатратыОбщие.Загрузить(Обработка.СписаниеОбщихЗатрат.Выгрузить());
	Документ.ЗатратыНУ.Загрузить(Обработка.СписаниеЗатратНУ.Выгрузить());
	
КонецПроцедуры

// Формирует сводную и детальные (отдельно для БУ и НУ) таблицы затрат по табличным частям документа
// 
// Параметры:
// 	Документ - ДанныеФормыСтруктура
// 			 - ДокументОбъект.ЗакрытиеСчетовБиотрансформации
//
Функция ПолучитьСводнуюИДетальныеТаблицыЗатратПоТабЧастям(Документ) Экспорт
	
	ОписаниеТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ЗатратыСводно = Новый ТаблицаЗначений;
	ЗатратыСводно.Колонки.Добавить("КлючСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ЗатратыСводно.Колонки.Добавить("ТипЗатрат",    ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ЗатратыСводно.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ЗатратыСводно.Колонки.Добавить("УслугаРасход", Новый ОписаниеТипов("Строка"));
	Если Документ.РежимОтображения = 1 Тогда // По разделам/подразделам КПС затрат.
		ЗатратыСводно.Колонки.Добавить("КПСКт",    ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(4));
	ИначеЕсли Документ.РежимОтображения = 2 Тогда // По КПС затрат.
		ЗатратыСводно.Колонки.Добавить("КПСКт",    Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	КонецЕсли;
	ЗатратыСводно.Колонки.Добавить("СчетДт",                     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ЗатратыСводно.Колонки.Добавить("КПСДт",                      Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ЗатратыСводно.Колонки.Добавить("КЭКДт",                      Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ЗатратыСводно.Колонки.Добавить("ПодразделениеДт",            Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ЗатратыСводно.Колонки.Добавить("СубконтоДт1",                ОписаниеТиповСубконто);
	ЗатратыСводно.Колонки.Добавить("СубконтоДт2",                ОписаниеТиповСубконто);
	ЗатратыСводно.Колонки.Добавить("СубконтоДт3",                ОписаниеТиповСубконто);
	ЗатратыСводно.Колонки.Добавить("СубконтоДт1Доступность",     Новый ОписаниеТипов("Булево"));
	ЗатратыСводно.Колонки.Добавить("СубконтоДт2Доступность",     Новый ОписаниеТипов("Булево"));
	ЗатратыСводно.Колонки.Добавить("СубконтоДт3Доступность",     Новый ОписаниеТипов("Булево"));
	ЗатратыСводно.Колонки.Добавить("ПодразделениеДтДоступность", Новый ОписаниеТипов("Булево"));
	ЗатратыСводно.Колонки.Добавить("ПодразделениеДтОбязательно", Новый ОписаниеТипов("Булево"));
	ЗатратыСводно.Колонки.Добавить("СчетДт40120",                Новый ОписаниеТипов("Булево"));
	ЗатратыСводно.Колонки.Добавить("ПодразделениеКтНеЗаполнено", Новый ОписаниеТипов("Булево"));
	ЗатратыСводно.Колонки.Добавить("Сумма",                      ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	ЗатратыСводно.Колонки.Добавить("СуммаНУ",                    ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	ЗатратыСводно.Колонки.Добавить("СуммаЕНВД",                  ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	ЗатратыСводно.Колонки.Добавить("СуммаНеУчитываетсяНУ",       ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	
	ЗатратыДетально = Новый ТаблицаЗначений;
	ЗатратыДетально.Колонки.Добавить("КлючСтроки",                 ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
