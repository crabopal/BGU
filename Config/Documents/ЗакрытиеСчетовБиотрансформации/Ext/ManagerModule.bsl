	ЗатратыДетально.Колонки.Добавить("ДопСубконто",                ОписаниеТиповСубконто);
	ЗатратыДетально.Колонки.Добавить("ДопСубконтоДоступность",     Новый ОписаниеТипов("Булево"));
	ЗатратыДетально.Колонки.Добавить("СчетКт",                     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ЗатратыДетально.Колонки.Добавить("КПСКт",                      Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ЗатратыДетально.Колонки.Добавить("КЭККт",                      Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ЗатратыДетально.Колонки.Добавить("ПодразделениеКт",            Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ЗатратыДетально.Колонки.Добавить("ПодразделениеКтДоступность", Новый ОписаниеТипов("Булево"));
	ЗатратыДетально.Колонки.Добавить("Сумма",                      ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	
	ЗатратыДетальноНУ = Новый ТаблицаЗначений;
	ЗатратыДетальноНУ.Колонки.Добавить("КлючСтроки",                 ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ЗатратыДетальноНУ.Колонки.Добавить("ВидЗатрат",                  Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ЗатратыДетальноНУ.Колонки.Добавить("ДопСубконто",                ОписаниеТиповСубконто);
	ЗатратыДетальноНУ.Колонки.Добавить("ДопСубконтоДоступность",     Новый ОписаниеТипов("Булево"));
	ЗатратыДетальноНУ.Колонки.Добавить("СчетКт",                     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ЗатратыДетальноНУ.Колонки.Добавить("ПодразделениеКт",            Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ЗатратыДетальноНУ.Колонки.Добавить("ПодразделениеКтДоступность", Новый ОписаниеТипов("Булево"));
	ЗатратыДетальноНУ.Колонки.Добавить("Сумма",                      ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	ЗатратыДетальноНУ.Колонки.Добавить("СуммаЕНВД",                  ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	ЗатратыДетальноНУ.Колонки.Добавить("СуммаНеУчитываетсяНУ",       ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	
	МассивСчетовСебестоимость            = БухгалтерскийУчет.СписокСчетов("110.60,Н20", Документ.Дата, Ложь, Документ.Организация);
	МассивСчетовНакладныеРасходы         = БухгалтерскийУчет.СписокСчетов("110.70,Н25", Документ.Дата, Ложь, Документ.Организация);
	МассивСчетовОбщехозяйственныеРасходы = БухгалтерскийУчет.СписокСчетов("110.80,Н26", Документ.Дата, Ложь, Документ.Организация);
	МассивСчетовИздержкиОбращения        = БухгалтерскийУчет.СписокСчетов("109.90,Н44", Документ.Дата, Ложь, Документ.Организация);
	МассивСчетов40120                    = БухгалтерскийУчет.СписокСчетов("401.20", Документ.Дата, Ложь, Документ.Организация);
	
	ШаблонСтроки = "%1, %2";
	ВсеСчета = ОбщегоНазначения.СкопироватьРекурсивно(МассивСчетовСебестоимость);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСчета, МассивСчетовНакладныеРасходы);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСчета, МассивСчетовОбщехозяйственныеРасходы);
	КодыСчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ВсеСчета, "Код"); 

	СвойстваСчетов = СвойстваСчетов(Документ);	
	
	ОтражатьВНалоговомУчете = Документ.ОтражатьВНалоговомУчете;
	
	ТабЧастиДляЗаполнения = Новый Массив;
	ТабЧастиДляЗаполнения.Добавить("ЗатратыПрямые");
	ТабЧастиДляЗаполнения.Добавить("ЗатратыОбщие");
	Если ОтражатьВНалоговомУчете Тогда
		ТабЧастиДляЗаполнения.Добавить("ЗатратыНУ");
		ВидыРасходовНУ = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(
			Документ.ЗатратыНУ.Выгрузить( ,"ВидЗатрат").ВыгрузитьКолонку("ВидЗатрат"), "ВидРасходовНУ");
	КонецЕсли;
	
	Для Каждого ТабЧасть Из ТабЧастиДляЗаполнения Цикл
		
		Для Каждого СтрокаТабЧасти Из Документ[ТабЧасть] Цикл
		
			Если ТабЧасть <> "ЗатратыНУ" Тогда
				СтрокаДетально = ЗатратыДетально.Добавить();
			Иначе
				СтрокаДетально = ЗатратыДетальноНУ.Добавить();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтрокаДетально, СтрокаТабЧасти);
			
			СтруктураПоиска = Новый Структура(
				"СчетДт, КПСДт, КЭКДт, ПодразделениеДт,СубконтоДт1, СубконтоДт2, СубконтоДт3");
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТабЧасти);
			
			УслугаРасход = "";
			ТипЗатрат    = "";
			Если ТабЧасть <> "ЗатратыОбщие" И МассивСчетовСебестоимость.Найти(СтрокаТабЧасти.СчетКт) <> Неопределено Тогда
				УслугаРасход = СтрШаблон(ШаблонСтроки,
					КодыСчетов.Получить(СтрокаТабЧасти.СчетКт), СтрокаТабЧасти.Номенклатура);
				ТипЗатрат    = УчетПроизводстваКлиентСервер.ТипЗатратСебестоимость();
			ИначеЕсли МассивСчетовНакладныеРасходы.Найти(СтрокаТабЧасти.СчетКт) <> Неопределено Тогда
				УслугаРасход = СтрШаблон(ШаблонСтроки,
					КодыСчетов.Получить(СтрокаТабЧасти.СчетКт), НСтр("ru = 'Накладные расходы'"));
				ТипЗатрат    = УчетПроизводстваКлиентСервер.ТипЗатратНакладныеРасходы();
			ИначеЕсли МассивСчетовОбщехозяйственныеРасходы.Найти(СтрокаТабЧасти.СчетКт) <> Неопределено Тогда
				УслугаРасход = СтрШаблон(ШаблонСтроки,
					КодыСчетов.Получить(СтрокаТабЧасти.СчетКт), НСтр("ru = 'Общехозяйственные расходы'"));
				ТипЗатрат    = УчетПроизводстваКлиентСервер.ТипЗатратОбщехозяйственныеРасходы();
			КонецЕсли;
			
			Если Документ.РежимОтображения <> 0 Тогда
				Если ТабЧасть <> "ЗатратыНУ" Тогда
					Если Документ.РежимОтображения = 1 Тогда // По разделам/подразделам КПС затрат.
						СтруктураПоиска.Вставить("КПСКт", Лев(СтрокаТабЧасти.КПСКт, 4));
					ИначеЕсли Документ.РежимОтображения = 2 Тогда // По КПС затрат.
						СтруктураПоиска.Вставить("КПСКт", СтрокаТабЧасти.КПСКт);
					КонецЕсли;
					УслугаРасход = УслугаРасход + ", " + СтруктураПоиска.КПСКт;
				Иначе
					// В режимах 1 "По разделам, подразделам" и 2 "По КПС затрат" строки НУ в сводной таблице располагаются отдельно.
					// Для них особым образом формируем описание и заполняем счет дебета.
					Если МассивСчетовСебестоимость.Найти(СтрокаТабЧасти.СчетКт) <> Неопределено Тогда
						УслугаРасход = Строка(СтрокаТабЧасти.СчетКт) + ", "+ СтрокаТабЧасти.Номенклатура;
					ИначеЕсли МассивСчетовНакладныеРасходы.Найти(СтрокаТабЧасти.СчетКт) <> Неопределено Тогда
						УслугаРасход = Строка(СтрокаТабЧасти.СчетКт) + ", Накладные расходы (НУ)";
					ИначеЕсли МассивСчетовОбщехозяйственныеРасходы.Найти(СтрокаТабЧасти.СчетКт) <> Неопределено Тогда
						УслугаРасход = Строка(СтрокаТабЧасти.СчетКт) + ", Общехозяйственные расходы (НУ)";
					ИначеЕсли МассивСчетовИздержкиОбращения.Найти(СтрокаТабЧасти.СчетКт) <> Неопределено Тогда
						УслугаРасход = Строка(СтрокаТабЧасти.СчетКт) + ", Издержки обращения (НУ)";
					КонецЕсли;
					СтруктураПоиска.СчетДт = УчетПроизводстваКлиентСервер.СчетСписанияПроизводственныхРасходовНУ(
						СтрокаДетально.СчетКт, ВидыРасходовНУ[СтрокаДетально.ВидЗатрат]);
				КонецЕсли;
			ИначеЕсли ТабЧасть = "ЗатратыНУ" Тогда
				СтруктураПоиска.СчетДт = УчетПроизводстваКлиентСервер.СчетСписанияПроизводственныхРасходовНУ(
					СтрокаДетально.СчетКт, ВидыРасходовНУ[СтрокаДетально.ВидЗатрат]);
			КонецЕсли;
			
			СтруктураПоиска.Вставить("ТипЗатрат",    ТипЗатрат);
			СтруктураПоиска.Вставить("УслугаРасход", УслугаРасход);
			Если ТипЗатрат = УчетПроизводстваКлиентСервер.ТипЗатратСебестоимость() Тогда
				СтруктураПоиска.Вставить("Номенклатура", СтрокаТабЧасти.Номенклатура);
			КонецЕсли;
			
			НайденныеСтроки = ЗатратыСводно.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() = 0 Тогда
				
				// Заполняем строку таблицы ЗатратыСводно
				СтрокаСводно = ЗатратыСводно.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаСводно, СтруктураПоиска);
				
				СтрокаСводно.КлючСтроки   = Строка(Новый УникальныйИдентификатор);
				СтрокаСводно.Номенклатура = ?(ТипЗатрат = УчетПроизводстваКлиентСервер.ТипЗатратСебестоимость(),
					СтрокаТабЧасти.Номенклатура,
					Справочники.Номенклатура.ПустаяСсылка());
				
				СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаСводно.СчетДт);
				СтрокаСводно.СубконтоДт1Доступность     = СвойстваСчетаДт.КоличествоСубконто>0;
				СтрокаСводно.СубконтоДт2Доступность     = СвойстваСчетаДт.КоличествоСубконто>1;
				СтрокаСводно.СубконтоДт3Доступность     = СвойстваСчетаДт.КоличествоСубконто>2;
				СтрокаСводно.ПодразделениеДтДоступность = СвойстваСчетаДт.УчетПоПодразделениям;
				СтрокаСводно.ПодразделениеДтОбязательно = НЕ СвойстваСчетаДт.РазрешитьНеУказыватьПодразделение;
				СтрокаСводно.СчетДт40120                = (МассивСчетов40120.Найти(СтрокаСводно.СчетДт) <> Неопределено);
				
			Иначе
				СтрокаСводно = НайденныеСтроки[0];
			КонецЕсли;
			
			СтрокаДетально.КлючСтроки = СтрокаСводно.КлючСтроки;
			
			// Заполним значение доп. субконто.
			СвойстваСчетаКт = СвойстваСчетов.Получить(СтрокаДетально.СчетКт);
			Если ТабЧасть = "ЗатратыПрямые" Тогда
				Если СвойстваСчетаКт <> Неопределено
						И СвойстваСчетаКт.ЕстьДопСубконто
						И СвойстваСчетаКт.НомерДопСубконто = 3 Тогда
					СтрокаДетально.ДопСубконто = СтрокаТабЧасти.СубконтоКт3;
					СтрокаДетально.ДопСубконтоДоступность = Истина;
				КонецЕсли;
			Иначе
				Если СвойстваСчетаКт <> Неопределено И СвойстваСчетаКт.ЕстьДопСубконто Тогда
					Если СвойстваСчетаКт.НомерДопСубконто = 2 Тогда
						СтрокаДетально.ДопСубконто = СтрокаТабЧасти.СубконтоКт2;
						СтрокаДетально.ДопСубконтоДоступность = Истина;
					ИначеЕсли СвойстваСчетаКТ.НомерДопСубконто = 3 Тогда
						СтрокаДетально.ДопСубконто = СтрокаТабЧасти.СубконтоКт3;
						СтрокаДетально.ДопСубконтоДоступность = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			// Подразделение Кт.
			СтрокаДетально.ПодразделениеКтДоступность = СвойстваСчетаКт <> Неопределено
				И СвойстваСчетаКт.ЕстьПодразделение;
			СтрокаСводно.ПодразделениеКтНеЗаполнено = СтрокаСводно.ПодразделениеКтНеЗаполнено
				ИЛИ НЕ ?(СвойстваСчетаКт <> Неопределено И СвойстваСчетаКт.ЕстьПодразделение,
					ЗначениеЗаполнено(СтрокаДетально.ПодразделениеКт), Истина);
			
			Если ТабЧасть <> "ЗатратыНУ" Тогда
				СтрокаСводно.Сумма = СтрокаСводно.Сумма + СтрокаДетально.Сумма;
			Иначе
				СтрокаСводно.СуммаНУ              = СтрокаСводно.СуммаНУ              + СтрокаДетально.Сумма;
				СтрокаСводно.СуммаЕНВД            = СтрокаСводно.СуммаЕНВД            + СтрокаДетально.СуммаЕНВД;
				СтрокаСводно.СуммаНеУчитываетсяНУ = СтрокаСводно.СуммаНеУчитываетсяНУ + СтрокаДетально.СуммаНеУчитываетсяНУ;
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;
	
	ЗатратыСводно.Сортировать("УслугаРасход");
	
	Возврат Новый Структура("ЗатратыСводно,ЗатратыДетально,ЗатратыДетальноНУ",
		ЗатратыСводно, ЗатратыДетально, ЗатратыДетальноНУ);
	
КонецФункции

Функция СвойстваСчетов(Документ)
	Обработка = Обработки.ЗакрытиеСчетовПроизводственныхЗатрат.ИнициализироватьОбработку(Документ.Дата,
		Документ.Организация, Документ.ИФО, Документ.КФО, Ложь, Истина);
	Счета = Новый Соответствие;
	Для Каждого Строка Из Обработка.СчетаПрямыхЗатрат Цикл
		Счета.Вставить(Строка.СчетПрямыхЗатрат,
			Новый Структура("ЕстьПодразделение, ЕстьДопСубконто, ВидДопСубконто, НомерДопСубконто",
				Строка.ЕстьПодразделение, Строка.ЕстьДопСубконто, Строка.ВидДопСубконто, Строка.НомерДопСубконто));
	КонецЦикла;
	Для Каждого Строка Из Обработка.СчетаОбщихЗатрат Цикл
		Счета.Вставить(Строка.СчетОбщихЗатрат,
			Новый Структура("ЕстьПодразделение, ЕстьДопСубконто, ВидДопСубконто, НомерДопСубконто",
				Строка.ЕстьПодразделение, Строка.ЕстьДопСубконто, Строка.ВидДопСубконто, Строка.НомерДопСубконто));
	КонецЦикла;
	Возврат Счета;
КонецФункции

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор		= "ВедомостьСписанияЗатрат";
	КомандаПечати.Представление		= НСтр("ru = 'Ведомость списания затрат'");
	КомандаПечати.Порядок			= 1;

КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ВедомостьСписанияЗатрат") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															 "ВедомостьСписанияЗатрат",
															 "Ведомость списания затрат", 
															 ПодготовитьВедомость(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

Функция ПодготовитьВедомость(МассивОбъектов, ОбъектыПечати)
	
	// Получим данные о затратах из документов списания и со счетов БУ и НУ.
	ОстаткиЗатрат = ОстаткиЗатратПоДокументамСписания(МассивОбъектов);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗакрытиеСчетовБиотрансформации.ПФ_MXL_ВедомостьСписанияЗатрат");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка     = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапкаНУ   = Макет.ПолучитьОбласть("ШапкаНУ");
	ОбластьУслуга    = Макет.ПолучитьОбласть("Услуга");
	ОбластьСтрока    = Макет.ПолучитьОбласть("Строка");
	ОбластьВсего     = Макет.ПолучитьОбласть("Всего");
	
	Для Сч=1 По МассивОбъектов.Количество() Цикл
		
		ДокументСписания = МассивОбъектов[Сч-1];
		
		ПервыйДокумент = (Сч=1);
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ТаблицаДокумента = ОстаткиЗатрат["ЗатратыПоДокументуСписания"+Сч].Выгрузить();
		
		ВыборкаВидУчета = ОстаткиЗатрат["ЗатратыПоДаннымУчета"+Сч].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаВидУчета.Следующий() Цикл
			
			ОбластьЗаголовок.Параметры.Заполнить(ДокументСписания);
			СтруктураЗаполнения = Новый Структура();
			Если ВыборкаВидУчета.ВидУчета = "БУ" Тогда
				СтруктураЗаполнения.Вставить("ЗаголовокРаздела", НСтр("ru = 'Ведомость списания затрат в бухгалтерском учете'"));
			Иначе // НУ
				СтруктураЗаполнения.Вставить("ЗаголовокРаздела", НСтр("ru = 'Ведомость списания затрат в налоговом учете'"));
			КонецЕсли;
			СтруктураЗаполнения.Вставить("ДатаДокумента", Формат(ДокументСписания.Дата, "ДЛФ=D"));
			СтруктураЗаполнения.Вставить("НаименованиеОрганизации", ДокументСписания.Организация);
			ОбластьЗаголовок.Параметры.Заполнить(СтруктураЗаполнения);
			ТабличныйДокумент.Вывести(ОбластьЗаголовок);
			
			Если ВыборкаВидУчета.ВидУчета = "БУ" Тогда
				ТабличныйДокумент.Вывести(ОбластьШапка);
			Иначе // НУ
				ТабличныйДокумент.Вывести(ОбластьШапкаНУ);
			КонецЕсли;
			
			ВыборкаТипЗатрат = ВыборкаВидУчета.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаТипЗатрат.Следующий() Цикл
			ВыборкаНоменклатура = ВыборкаТипЗатрат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаНоменклатура.Следующий() Цикл
			ВыборкаУслугаРасход = ВыборкаНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаУслугаРасход.Следующий() Цикл
				
				СтруктураЗаполнения = Новый Структура("Номенклатура", ВыборкаУслугаРасход.УслугаРасход);
				
				// Итоги по группировке "Услуга (расход)"
				Если ВыборкаУслугаРасход.ВидУчета = "БУ" Тогда
					СтруктураЗаполнения.Вставить("Сумма",   ВыборкаУслугаРасход.СуммаКСписанию);
					СтруктураЗаполнения.Вставить("Сальдо",  ВыборкаУслугаРасход.СуммаОстаток);
					СтруктураЗаполнения.Вставить("Остаток", ВыборкаУслугаРасход.СуммаОстаток - ВыборкаУслугаРасход.СуммаКСписанию);
				Иначе // НУ
					СтруктураЗаполнения.Вставить("Сумма",   ВыборкаУслугаРасход.СуммаКСписаниюНУ);
					СтруктураЗаполнения.Вставить("Сальдо",  ВыборкаУслугаРасход.СуммаОстаток);
					СтруктураЗаполнения.Вставить("Остаток", ВыборкаУслугаРасход.СуммаОстаток - ВыборкаУслугаРасход.СуммаКСписаниюНУ);
				КонецЕсли;
				ОбластьУслуга.Параметры.Заполнить(СтруктураЗаполнения);
				ТабличныйДокумент.Вывести(ОбластьУслуга);
				
				ТабличныйДокумент.НачатьГруппуСтрок();
				
				Выборка = ВыборкаУслугаРасход.Выбрать();
				Пока Выборка.Следующий() Цикл
					
					СтруктураПоиска = Новый Структура("ВидУчета,ТипЗатрат,УслугаРасход,Номенклатура,ВидЗатрат,ДопСубконто,СчетКт,КПСКт,КЭККт");
					ЗаполнитьЗначенияСвойств(СтруктураПоиска, Выборка);
					СтрокиДокумента = ТаблицаДокумента.НайтиСтроки(СтруктураПоиска);
					
					ЗатратыСписаныНаРазныеСчетаДт = СтрокиДокумента.Количество()>1;
					Если ЗатратыСписаныНаРазныеСчетаДт Тогда
						
						// Выводим отдельно итоги по остаткам
						СтруктураЗаполнения = ЗаполнитьСтрокуВедомости(Выборка, Неопределено, Ложь, Истина, ДокументСписания);
						ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
						ОбластьСтрока.Параметры.Заполнить(СтруктураЗаполнения);
						ТабличныйДокумент.Вывести(ОбластьСтрока);
						
						// Выводим отдельно строки списания из документа
						ТабличныйДокумент.НачатьГруппуСтрок();
						Для Каждого СтрокаДокумента Из СтрокиДокумента Цикл
							СтруктураЗаполнения = ЗаполнитьСтрокуВедомости(Выборка, СтрокаДокумента, Истина, Ложь, ДокументСписания);
							ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаДетализации");
							ОбластьСтрока.Параметры.Заполнить(СтруктураЗаполнения);
							ТабличныйДокумент.Вывести(ОбластьСтрока);
						КонецЦикла;
						ТабличныйДокумент.ЗакончитьГруппуСтрок();
						
					Иначе
						
						// Выводим всю информацию в одной строке
						СтруктураЗаполнения = ЗаполнитьСтрокуВедомости(Выборка, СтрокиДокумента[0], Истина, Истина, ДокументСписания);
						ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
						ОбластьСтрока.Параметры.Заполнить(СтруктураЗаполнения);
						ТабличныйДокумент.Вывести(ОбластьСтрока);
						
					КонецЕсли;
					
				КонецЦикла;
				
				ТабличныйДокумент.ЗакончитьГруппуСтрок();
				
			КонецЦикла;
			КонецЦикла;
			КонецЦикла;
			
			// Общий итог
			Если ВыборкаВидУчета.ВидУчета = "БУ" Тогда
				СтруктураЗаполнения.Вставить("Сумма",   ВыборкаВидУчета.СуммаКСписанию);
				СтруктураЗаполнения.Вставить("Сальдо",  ВыборкаВидУчета.СуммаОстаток);
				СтруктураЗаполнения.Вставить("Остаток", ВыборкаВидУчета.СуммаОстаток - ВыборкаВидУчета.СуммаКСписанию);
			Иначе // НУ
				СтруктураЗаполнения.Вставить("Сумма",   ВыборкаВидУчета.СуммаКСписаниюНУ);
				СтруктураЗаполнения.Вставить("Сальдо",  ВыборкаВидУчета.СуммаОстаток);
				СтруктураЗаполнения.Вставить("Остаток", ВыборкаВидУчета.СуммаОстаток - ВыборкаВидУчета.СуммаКСписаниюНУ);
			КонецЕсли;
			ОбластьВсего.Параметры.Заполнить(СтруктураЗаполнения);
			ТабличныйДокумент.Вывести(ОбластьВсего);
			
		КонецЦикла;
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДокументСписания);
	
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ЗаполнитьСтрокуВедомости(Выборка, СтрокаДокумента, ЗаполнятьДт, ЗаполнятьКт, ДокументСписания)
	
	СтруктураЗаполнения = Новый Структура();

	ИспользуетсяПроизвольныйТипКПС = БухгалтерскиеОперации.ИспользуетсяПроизвольныйТипКПС(
		ДокументСписания.Организация, ДокументСписания.ИФО, ДокументСписания.КФО, ДокументСписания.Дата);
	МассивСчетов40120 = БухгалтерскийУчет.СписокСчетов("401.20");
	
	Если Выборка.ВидУчета = "БУ" Тогда
		
		СтруктураЗаполнения.Вставить("Сумма", ?(СтрокаДокумента=Неопределено, Выборка.СуммаКСписанию, СтрокаДокумента.СуммаКСписанию));
		
		Если ЗаполнятьДт Тогда
			
			Если НЕ ЗначениеЗаполнено(СтрокаДокумента.КПСДт) И
				(МассивСчетов40120.Найти(СтрокаДокумента.СчетДт) <> Неопределено ИЛИ ИспользуетсяПроизвольныйТипКПС) Тогда
				КПСДт = СтрокаДокумента.КПСКт; // КПС Дт заполняется из Кт
			Иначе
				КПСДт = СтрокаДокумента.КПСДт;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаДокумента.КЭКДт) И
				(МассивСчетов40120.Найти(СтрокаДокумента.СчетДт) <> Неопределено) Тогда
				КЭКДт = СтрокаДокумента.КЭККт; // КЭК Дт заполняется из Кт
			Иначе
				КЭКДт = СтрокаДокумента.КЭКДт;
			КонецЕсли;
			
			СтруктураЗаполнения.Вставить("СчетДебета", Строка(КПСДт)
											+ "." + Строка(ДокументСписания.КФО)
											+ "." + Строка(СтрокаДокумента.СчетДт)
											+ "." + Строка(КЭКДт));
			СтруктураЗаполнения.Вставить("СубконтоСчетДебета",
				?(ЗначениеЗаполнено(СтрокаДокумента.СубконтоДт1), Строка(СтрокаДокумента.СубконтоДт1), "") +
				?(ЗначениеЗаполнено(СтрокаДокумента.СубконтоДт2), ", "+СтрокаДокумента.СубконтоДт2, "") +
				?(ЗначениеЗаполнено(СтрокаДокумента.СубконтоДт3), ", "+СтрокаДокумента.СубконтоДт3, ""));
			
		КонецЕсли;
		
		Если ЗаполнятьКт Тогда
			
			СтруктураЗаполнения.Вставить("ВидЗатрат", Выборка.ВидЗатрат);
			СтруктураЗаполнения.Вставить("СчетЗатрат", Строка(Выборка.КПСКт)
											+ "." + Строка(ДокументСписания.КФО)
											+ "." + Строка(Выборка.СчетКт)
											+ "." + Строка(Выборка.КЭККт));
			СтруктураЗаполнения.Вставить("ДопСубконто", Выборка.ДопСубконто);
			
			СтруктураЗаполнения.Вставить("Сальдо",  Выборка.СуммаОстаток);
			СтруктураЗаполнения.Вставить("Остаток", Выборка.СуммаОстаток - Выборка.СуммаКСписанию);
			
		КонецЕсли;
		
	Иначе // НУ
		
		СтруктураЗаполнения.Вставить("Сумма", ?(СтрокаДокумента=Неопределено, Выборка.СуммаКСписаниюНУ, СтрокаДокумента.СуммаКСписаниюНУ));
		
		Если ЗаполнятьДт Тогда
			
			СтруктураЗаполнения.Вставить("СчетДебета",
				УчетПроизводстваКлиентСервер.СчетСписанияПроизводственныхРасходовНУ(Выборка.СчетКт, Выборка.ВидРасходовНУ));
			СтруктураЗаполнения.Вставить("СубконтоСчетДебета",
				?(ЗначениеЗаполнено(СтрокаДокумента.СубконтоДт1), Строка(СтрокаДокумента.СубконтоДт1), "") +
				?(ЗначениеЗаполнено(СтрокаДокумента.СубконтоДт2), ", "+СтрокаДокумента.СубконтоДт2, "") +
				?(ЗначениеЗаполнено(СтрокаДокумента.СубконтоДт3), ", "+СтрокаДокумента.СубконтоДт3, ""));
			
		КонецЕсли;
		
		Если ЗаполнятьКт Тогда
			
			СтруктураЗаполнения.Вставить("ВидЗатрат", Выборка.ВидЗатрат);
			СтруктураЗаполнения.Вставить("СчетЗатрат", Строка(Выборка.СчетКт));
			СтруктураЗаполнения.Вставить("ДопСубконто", Выборка.ДопСубконто);
			
			СтруктураЗаполнения.Вставить("Сальдо",  Выборка.СуммаОстаток);
			СтруктураЗаполнения.Вставить("Остаток", Выборка.СуммаОстаток - Выборка.СуммаКСписаниюНУ);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураЗаполнения;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
