#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = ЗатратыПрямые.Итог("Сумма") + ЗатратыОбщие.Итог("Сумма");
	
	Если НЕ ЭтоНовый() И РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		// очистить движения, чтобы не влияли на расчет остатков при проведении
		Для каждого ТекДвижение Из ЭтотОбъект.Движения Цикл
		
			ТекДвижение.Очистить();
			ТекДвижение.Записать();
		
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.АктОбОказанииУслуг") 
		Или ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗавершениеРабот") Тогда
		ЗаполнитьДокументНаОсновании(ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не УчетПроизводства.ПроверитьВозможностьЗакрытияСчетовЗатрат(Организация, Дата, Отказ) Тогда
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
	ИспользуетсяПроизвольныйТипКПС   = БухгалтерскиеОперации.ИспользуетсяПроизвольныйТипКПС(Организация, ИФО, КФО, Дата);
	ВидДопСубконто                   = ПланыВидовХарактеристик.ВидыСубконто.НаправленияДеятельности;
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	СтруктураТаблиц = Документы.ЗакрытиеСчетовБиотрансформации.ПолучитьСводнуюИДетальныеТаблицыЗатратПоТабЧастям(ЭтотОбъект);
	
	// Таблица ЗатратыСводно
	ШаблонТекстаСообщения =  НСтр("ru='В строке затрат ""%1"" не заполнена колонка ""%2""'");
	
	Для НомерСтроки=1 По СтруктураТаблиц.ЗатратыСводно.Количество() Цикл
	
		СтрокаСводно = СтруктураТаблиц.ЗатратыСводно[НомерСтроки-1];
		
		ЭтоСтрокаЗатратНУ = (СтрокаСводно.Сумма = 0);
		
		// СчетДт
		Если НЕ ЗначениеЗаполнено(СтрокаСводно.СчетДт) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонТекстаСообщения, СтрокаСводно.УслугаРасход, НСтр("ru = 'Счет списания'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ЗатратыСводно["+(НомерСтроки-1)+"].СчетДт", , Отказ);
			Продолжить;
		КонецЕсли;
	
		ЭтоСчет40120 = БухгалтерскийУчет.СчетВИерархии(СтрокаСводно.СчетДт, "401.20");
		
		// КПСДт
		Если НЕ ЗначениеЗаполнено(СтрокаСводно.КПСДт)
		   И НЕ ЭтоСтрокаЗатратНУ // Не проверяем для строк НУ.
		   И НЕ ЭтоСчет40120 И НЕ ИспользуетсяПроизвольныйТипКПС Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонТекстаСообщения, СтрокаСводно.УслугаРасход, НСтр("ru = 'КПС Дт'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ЗатратыСводно["+(НомерСтроки-1)+"].КПСДт", , Отказ);
		КонецЕсли;
		
		// КЭКДт
		Если НЕ ЗначениеЗаполнено(СтрокаСводно.КЭКДт)
		   И НЕ ЭтоСтрокаЗатратНУ // Не проверяем для строк НУ.
		   И НЕ ЭтоСчет40120 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонТекстаСообщения, СтрокаСводно.УслугаРасход, НСтр("ru = 'КЭК Дт'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ЗатратыСводно["+(НомерСтроки-1)+"].КЭКДт", , Отказ);
		КонецЕсли;
		
		СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаСводно.СчетДт);
		
		// ПодразделениеДт
		Если НЕ ЗначениеЗаполнено(СтрокаСводно.ПодразделениеДт)
		   И ИспользоватьУчетПоПодразделениям
		   И СтрокаСводно.ПодразделениеДтДоступность
		   И СтрокаСводно.ПодразделениеДтОбязательно
		   И СтрокаСводно.ПодразделениеКтНеЗаполнено Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонТекстаСообщения, СтрокаСводно.УслугаРасход, НСтр("ru = 'Подразделение Дт'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ЗатратыСводно["+(НомерСтроки-1)+"].ПодразделениеДт", , Отказ);
		КонецЕсли;
		
		// СубконтоДт
		Для НомерСубконто=1 По СвойстваСчетаДт.КоличествоСубконто Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаСводно["СубконтоДт"+НомерСубконто])
			   И СвойстваСчетаДт["ВидСубконто" + НомерСубконто + "Обязательный"] Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ШаблонТекстаСообщения, СтрокаСводно.УслугаРасход, НСтр("ru = 'Субконто '") + Строка(НомерСубконто));
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ЗатратыСводно["+(НомерСтроки-1)+"].СубконтоДт"+НомерСубконто, , Отказ);
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЦикла;
	
	// Таблица ЗатратыДетально
	ШаблонТекстаСообщения =  НСтр("ru='В строке затрат ""%1"" по виду затрат ""%2"" не заполнена колонка ""%3""'");
	
	Для НомерСтроки=1 По СтруктураТаблиц.ЗатратыДетально.Количество() Цикл
	
		СтрокаДетально = СтруктураТаблиц.ЗатратыДетально[НомерСтроки-1];
		СтрокаСводно   = СтруктураТаблиц.ЗатратыСводно.Найти(СтрокаДетально.КлючСтроки, "КлючСтроки");
		УслугаРасход   = ?(СтрокаСводно<>Неопределено, СтрокаСводно.УслугаРасход, "");
		
		// СчетКт
		Если НЕ ЗначениеЗаполнено(СтрокаДетально.СчетКт) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонТекстаСообщения, УслугаРасход, СтрокаДетально.ВидЗатрат, НСтр("ru = 'Счет затрат'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ЗатратыДетально["+(НомерСтроки-1)+"].СчетКт", , Отказ);
			Продолжить;
		КонецЕсли;
	
		// КПСКт
		Если НЕ ЗначениеЗаполнено(СтрокаДетально.КПСКт) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонТекстаСообщения, УслугаРасход, СтрокаДетально.ВидЗатрат, НСтр("ru = 'КПС Кт'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ЗатратыДетально["+(НомерСтроки-1)+"].КПСКт", , Отказ);
		КонецЕсли;
		
		// КЭКДт
		Если НЕ ЗначениеЗаполнено(СтрокаДетально.КЭККт) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонТекстаСообщения, УслугаРасход, СтрокаДетально.ВидЗатрат, НСтр("ru = 'КЭК Кт'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ЗатратыДетально["+(НомерСтроки-1)+"].КЭККт", , Отказ);
		КонецЕсли;
		
		СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаДетально.СчетКт);
		
		// ПодразделениеКт
		Если НЕ ЗначениеЗаполнено(СтрокаДетально.ПодразделениеКт)
		   И ИспользоватьУчетПоПодразделениям
		   И СвойстваСчетаКт.УчетПоПодразделениям
		   И НЕ СвойстваСчетаКт.РазрешитьНеУказыватьПодразделение Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонТекстаСообщения, УслугаРасход, СтрокаДетально.ВидЗатрат, НСтр("ru = 'Подразделение Кт'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ЗатратыДетально["+(НомерСтроки-1)+"].ПодразделениеКт", , Отказ);
		КонецЕсли;
		
		// Направление деятельности
		ОбязательностьНаправленияДеятельности =
			   (СвойстваСчетаКт.ВидСубконто2 = ВидДопСубконто И СвойстваСчетаКт.ВидСубконто2Обязательный
			ИЛИ СвойстваСчетаКт.ВидСубконто3 = ВидДопСубконто И СвойстваСчетаКт.ВидСубконто3Обязательный);
		Если ОбязательностьНаправленияДеятельности И НЕ ЗначениеЗаполнено(СтрокаДетально.ДопСубконто) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонТекстаСообщения, УслугаРасход, СтрокаДетально.ВидЗатрат, НСтр("ru = 'Направление деятельности'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ЗатратыДетально["+(НомерСтроки-1)+"].ДопСубконто", , Отказ);
		КонецЕсли;

	КонецЦикла;
	
	// Таблица ЗатратыДетальноНУ
	ШаблонТекстаСообщения =  НСтр("ru='НУ: В строке затрат ""%1"" по виду затрат ""%2"" не заполнена колонка ""%3""'");
	
	Для НомерСтроки=1 По СтруктураТаблиц.ЗатратыДетальноНУ.Количество() Цикл
	
		СтрокаДетально = СтруктураТаблиц.ЗатратыДетальноНУ[НомерСтроки-1];
		СтрокаСводно   = СтруктураТаблиц.ЗатратыСводно.Найти(СтрокаДетально.КлючСтроки, "КлючСтроки");
		УслугаРасход   = ?(СтрокаСводно<>Неопределено, СтрокаСводно.УслугаРасход, "");
		
		// СчетКт
		Если НЕ ЗначениеЗаполнено(СтрокаДетально.СчетКт) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонТекстаСообщения, УслугаРасход, СтрокаДетально.ВидЗатрат, НСтр("ru = 'Счет затрат'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ЗатратыДетальноНУ["+(НомерСтроки-1)+"].СчетКт", , Отказ);
			Продолжить;
		КонецЕсли;
	
		СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаДетально.СчетКт);
		
		// ПодразделениеКт
		Если НЕ ЗначениеЗаполнено(СтрокаДетально.ПодразделениеКт)
		   И ИспользоватьУчетПоПодразделениям
		   И СвойстваСчетаКт.УчетПоПодразделениям
		   И НЕ СвойстваСчетаКт.РазрешитьНеУказыватьПодразделение Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонТекстаСообщения, УслугаРасход, СтрокаДетально.ВидЗатрат, НСтр("ru = 'Подразделение Кт'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ЗатратыДетальноНУ["+(НомерСтроки-1)+"].ПодразделениеКт", , Отказ);
		КонецЕсли;
		
		// Направление деятельности
		ОбязательностьНаправленияДеятельности =
			   (СвойстваСчетаКт.ВидСубконто2 = ВидДопСубконто И СвойстваСчетаКт.ВидСубконто2Обязательный
			ИЛИ СвойстваСчетаКт.ВидСубконто3 = ВидДопСубконто И СвойстваСчетаКт.ВидСубконто3Обязательный);
		Если ОбязательностьНаправленияДеятельности И НЕ ЗначениеЗаполнено(СтрокаДетально.ДопСубконто) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонТекстаСообщения, УслугаРасход, СтрокаДетально.ВидЗатрат, НСтр("ru = 'Направление деятельности'"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ЗатратыДетальноНУ["+(НомерСтроки-1)+"].ДопСубконто", , Отказ);
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

// Заполняет документ затратами по услугам, указанным в документе-основании
// 
Процедура ЗаполнитьДокументНаОсновании(ДокументОснование)
	
	// Заполняем реквизиты шапки
	Организация = ДокументОснование.Организация;
	ИФО         = ДокументОснование.ИФО;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		МассивУслуг = ДокументОснование.УслугиОказанные.ВыгрузитьКолонку("Номенклатура");
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗавершениеРабот") Тогда
		МассивУслуг = Документы.ЗавершениеРабот.НоменклатураВыполненныхРабот(ДокументОснование);
	Иначе
		МассивУслуг = Неопределено;
	КонецЕсли;
	
	РеквизитыПроводкиПоВыручкеБУ = БухгалтерскийУчет.ПроводкиДокументов(ДокументОснование, "401.10", "Кт", , 1).Выбрать();
	Если НЕ РеквизитыПроводкиПоВыручкеБУ.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	КФО = РеквизитыПроводкиПоВыручкеБУ.КФО;
	
	ОстаткиЗатрат = Документы.СписаниеЗатратПоУслугам.ОстаткиЗатратНаОказаниеУслуг(
		Новый Граница(КонецДня(Дата), ВидГраницы.Включая), Организация, ИФО, КФО, МассивУслуг);
	
	// Заполняем табличные части документа
	
	Для Каждого ОстаткиЗатратБУ Из ОстаткиЗатрат.ТаблицаЗатратБУ Цикл
		
		Если ОстаткиЗатратБУ.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ЗатратыПрямые.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстаткиЗатратБУ);
		
		НоваяСтрока.СчетКт          = ОстаткиЗатратБУ.Счет;
		НоваяСтрока.КПСКт           = ОстаткиЗатратБУ.КПС;
		НоваяСтрока.КЭККт           = ОстаткиЗатратБУ.КЭК;
		НоваяСтрока.ПодразделениеКт = ОстаткиЗатратБУ.Подразделение;
		НоваяСтрока.СубконтоКт3     = ОстаткиЗатратБУ.Субконто3;
		
		// По умолчанию подставим счет и аналитику списания из кредита документа оказания услуг
		НоваяСтрока.СчетДт          = РеквизитыПроводкиПоВыручкеБУ.СчетКт;
		НоваяСтрока.КПСДт           = РеквизитыПроводкиПоВыручкеБУ.КПСКт;
		НоваяСтрока.КЭКДт           = РеквизитыПроводкиПоВыручкеБУ.КЭККт;
		НоваяСтрока.ПодразделениеДт = РеквизитыПроводкиПоВыручкеБУ.ПодразделениеКт;
		НоваяСтрока.СубконтоДт1     = РеквизитыПроводкиПоВыручкеБУ.СубконтоКт1;
		НоваяСтрока.СубконтоДт2     = РеквизитыПроводкиПоВыручкеБУ.СубконтоКт2;
		НоваяСтрока.СубконтоДт3     = РеквизитыПроводкиПоВыручкеБУ.СубконтоКт3;
		
	КонецЦикла;

	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, Дата, КФО);
	Если ОтражатьВНалоговомУчете Тогда
		
		Для Каждого ОстаткиЗатратНУ Из ОстаткиЗатрат.ТаблицаЗатратНУ Цикл
			
			Если ОстаткиЗатратНУ.Сумма <= 0
			   И ОстаткиЗатратНУ.СуммаЕНВД <= 0
			   И ОстаткиЗатратНУ.СуммаНеУчитываетсяНУ <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ЗатратыНУ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстаткиЗатратНУ);
			
			НоваяСтрока.СчетКт          = ОстаткиЗатратНУ.Счет;
			НоваяСтрока.ПодразделениеКт = ОстаткиЗатратНУ.Подразделение;
			НоваяСтрока.СубконтоКт3     = ОстаткиЗатратНУ.Субконто3;
			
			// По умолчанию подставим счет и аналитику списания из кредита документа оказания услуг
			НоваяСтрока.СчетДт          = РеквизитыПроводкиПоВыручкеБУ.СчетКт;
			НоваяСтрока.КПСДт           = РеквизитыПроводкиПоВыручкеБУ.КПСКт;
			НоваяСтрока.КЭКДт           = РеквизитыПроводкиПоВыручкеБУ.КЭККт;
			НоваяСтрока.ПодразделениеДт = РеквизитыПроводкиПоВыручкеБУ.ПодразделениеКт;
			НоваяСтрока.СубконтоДт1     = РеквизитыПроводкиПоВыручкеБУ.СубконтоКт1;
			НоваяСтрока.СубконтоДт2     = РеквизитыПроводкиПоВыручкеБУ.СубконтоКт2;
			НоваяСтрока.СубконтоДт3     = РеквизитыПроводкиПоВыручкеБУ.СубконтоКт3;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет документ остатками затрат по счетам учета затрат
//
Процедура ЗаполнитьДокументПоОстаткам() Экспорт

	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	МеткаВремениНачалоЗаполнения = ОценкаПроизводительности.НачатьЗамерВремени();
	
	НомераТаблиц = Новый Структура;
	
	// Формируем запрос по остаткам затрат
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Счет,
	|	ЕПСБУОстатки.КПС,
	|	ЕПСБУОстатки.КЭК,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|				И ЕПСБУОстатки.Счет.УчетПоПодразделениям
	|			ТОГДА ЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ЕПСБУОстатки.Субконто1,
	|	ЕПСБУОстатки.Субконто2,
	|	ЕПСБУОстатки.Субконто3,
	|	ВЫБОР
	|		КОГДА ЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Номенклатура
	|			ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	КОНЕЦ КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ВидыЗатрат
	|			ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ВидыЗатрат)
	|		КОГДА ЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ВидыЗатрат
	|			ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка)
	|	КОНЕЦ КАК ВидЗатрат,
	|	ВЫБОР
	|		КОГДА ЕПСБУОстатки.Счет В (&СчетаПрямыхРасходовБУ)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПрямыеЗатраты,
	|	ЕПСБУОстатки.СуммаОстатокДт КАК Сумма
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонПериода,
	|			Счет В (&СчетаРасходовБУ),
	|			,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И КФО = &КФО) КАК ЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Счет КАК СчетКт,
	|	Остатки.КПС КАК КПСКт,
	|	Остатки.КЭК КАК КЭККт,
	|	Остатки.Подразделение КАК ПодразделениеКт,
	|	Остатки.Счет.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	Остатки.Субконто1 КАК СубконтоКт1,
	|	Остатки.Субконто2 КАК СубконтоКт2,
	|	Остатки.Субконто3 КАК СубконтоКт3,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.ВидЗатрат КАК ВидЗатрат,
	|	ПРЕДСТАВЛЕНИЕ(Остатки.Номенклатура) КАК НоменклатураПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Остатки.ВидЗатрат) КАК ВидЗатратПредставление,
	|	Остатки.ПрямыеЗатраты КАК ПрямыеЗатраты,
	|	СУММА(Остатки.Сумма) КАК Сумма
	|ИЗ
	|	Остатки КАК Остатки
	|ГДЕ
	|	ВЫБОР
	|			КОГДА Остатки.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Остатки.Номенклатура.ТипНоменклатуры В (&Услуги)
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Счет,
	|	Остатки.КПС,
	|	Остатки.КЭК,
	|	Остатки.Подразделение,
	|	Остатки.Счет.УчетПоПодразделениям,
	|	Остатки.Субконто1,
	|	Остатки.Субконто2,
	|	Остатки.Субконто3,
	|	Остатки.Номенклатура,
	|	Остатки.ВидЗатрат,
	|	Остатки.ПрямыеЗатраты";
	
	НомераТаблиц.Вставить("Остатки", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаЗатратБУ", НомераТаблиц.Количество());
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, Дата, КФО);
	Если ОтражатьВНалоговомУчете Тогда
		
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ЕПСБУОстатки.Счет,
		|	ВЫБОР
		|		КОГДА &УчетПоПодразделениям
		|				И ЕПСБУОстатки.Счет.УчетПоПодразделениям
		|			ТОГДА ЕПСБУОстатки.Подразделение
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ КАК Подразделение,
		|	ЕПСБУОстатки.Субконто1,
		|	ЕПСБУОстатки.Субконто2,
		|	ЕПСБУОстатки.Субконто3,
		|	ВЫБОР
		|		КОГДА ЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Номенклатура
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	КОНЕЦ КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА ЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ВидыЗатрат
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ВидыЗатрат)
		|		КОГДА ЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ВидыЗатрат
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка)
		|	КОНЕЦ КАК ВидЗатрат,
		|	ЕПСБУОстатки.СуммаОстатокДт КАК Сумма,
		|	ЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СуммаЕНВД,
		|	ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУ
		|ПОМЕСТИТЬ ОстаткиНУ
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&КонПериода,
		|			Счет В (&СчетаРасходовНУ),
		|			,
		|			Организация = &Организация
		|				И &УсловиеИФО
		|				И КФО = &КФО) КАК ЕПСБУОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиНУ.Счет КАК СчетКт,
		|	ОстаткиНУ.Подразделение КАК ПодразделениеКт,
		|	ОстаткиНУ.Счет.УчетПоПодразделениям КАК УчетПоПодразделениям,
		|	ОстаткиНУ.Субконто1 КАК СубконтоКт1,
		|	ОстаткиНУ.Субконто2 КАК СубконтоКт2,
		|	ОстаткиНУ.Субконто3 КАК СубконтоКт3,
		|	ОстаткиНУ.Номенклатура КАК Номенклатура,
		|	ОстаткиНУ.ВидЗатрат КАК ВидЗатрат,
		|	ПРЕДСТАВЛЕНИЕ(ОстаткиНУ.Номенклатура) КАК НоменклатураПредставление,
		|	ПРЕДСТАВЛЕНИЕ(ОстаткиНУ.ВидЗатрат) КАК ВидЗатратПредставление,
		|	СУММА(ОстаткиНУ.Сумма) КАК Сумма,
		|	СУММА(ОстаткиНУ.СуммаЕНВД) КАК СуммаЕНВД,
		|	СУММА(ОстаткиНУ.СуммаНеУчитываетсяНУ) КАК СуммаНеУчитываетсяНУ
		|ИЗ
		|	ОстаткиНУ КАК ОстаткиНУ
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ОстаткиНУ.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ОстаткиНУ.Номенклатура.ТипНоменклатуры В (&Услуги)
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиНУ.Счет,
		|	ОстаткиНУ.Подразделение,
		|	ОстаткиНУ.Счет.УчетПоПодразделениям,
		|	ОстаткиНУ.Субконто1,
		|	ОстаткиНУ.Субконто2,
		|	ОстаткиНУ.Субконто3,
		|	ОстаткиНУ.Номенклатура,
		|	ОстаткиНУ.ВидЗатрат";
		
		НомераТаблиц.Вставить("ОстаткиНУ", НомераТаблиц.Количество());
		НомераТаблиц.Вставить("ТаблицаЗатратНУ", НомераТаблиц.Количество());
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("КонПериода",           Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",          Организация);
	Запрос.УстановитьПараметр("КФО",                  КФО);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО, "ИФО = &ИФО", "ИСТИНА"));
	Запрос.УстановитьПараметр("ИФО", ИФО);
	
	Запрос.УстановитьПараметр("СчетаПрямыхРасходовБУ", БухгалтерскийУчет.СписокСчетов("110.60", Дата, Ложь, Организация));
	Запрос.УстановитьПараметр("СчетаРасходовБУ",       БухгалтерскийУчет.СписокСчетов("110.00", Дата, Ложь, Организация));
	Запрос.УстановитьПараметр("СчетаРасходовНУ",       БухгалтерскийУчет.СписокСчетов("Н20.11,Н20.21,Н25.11,Н25.12,Н26.11,Н26.12,Н44", Дата, Ложь, Организация));
	
	ТипыНоменклатурыУслуги = Новый Массив;
	ТипыНоменклатурыУслуги.Добавить(Перечисления.ТипыНоменклатуры.БиологическиеАктивы);
	Запрос.УстановитьПараметр("Услуги", ТипыНоменклатурыУслуги);
	
	Результат = Запрос.ВыполнитьПакет();
	
	// Заполняем табличные части документа
	
	ТаблицаЗатратБУ = Результат[НомераТаблиц.ТаблицаЗатратБУ].Выгрузить();
	ТаблицаЗатратБУ.Сортировать("СчетКт,НоменклатураПредставление,ВидЗатратПредставление");
	Для Каждого ОстаткиЗатратБУ Из ТаблицаЗатратБУ Цикл
		
		Если ОстаткиЗатратБУ.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОстаткиЗатратБУ.ПрямыеЗатраты Тогда
			НоваяСтрока = ЗатратыПрямые.Добавить();
		Иначе
			НоваяСтрока = ЗатратыОбщие.Добавить();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстаткиЗатратБУ);
		
	КонецЦикла;

	Если ОтражатьВНалоговомУчете Тогда
		
		ТаблицаЗатратНУ = Результат[НомераТаблиц.ТаблицаЗатратНУ].Выгрузить();
		ТаблицаЗатратНУ.Сортировать("СчетКт,НоменклатураПредставление,ВидЗатратПредставление");
		Для Каждого ОстаткиЗатратНУ Из ТаблицаЗатратНУ Цикл
			
			Если ОстаткиЗатратНУ.Сумма = 0
			   И ОстаткиЗатратНУ.СуммаЕНВД = 0
			   И ОстаткиЗатратНУ.СуммаНеУчитываетсяНУ = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ЗатратыНУ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстаткиЗатратНУ);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОценкаПроизводительности.ЗакончитьЗамерВремени("ЗаполнениеДокументаСписаниеЗатратПоУслугам", МеткаВремениНачалоЗаполнения);
	
КонецПроцедуры

// Формирует сводную и детальные (отдельно для БУ и НУ) таблицы затрат по табличным частям документа
//
Функция ПолучитьСводнуюИДетальныеТаблицыЗатратПоТабЧастям(РежимОтображения = 0) Экспорт
	
	ОписаниеТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ЗатратыСводно = Новый ТаблицаЗначений;
	ЗатратыСводно.Колонки.Добавить("КлючСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ЗатратыСводно.Колонки.Добавить("ТипЗатрат",    ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ЗатратыСводно.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ЗатратыСводно.Колонки.Добавить("УслугаРасход", Новый ОписаниеТипов("Строка"));
	Если РежимОтображения = 1 Тогда // По разделам/подразделам КПС затрат.
		ЗатратыСводно.Колонки.Добавить("КПСКт",    ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(4));
	ИначеЕсли РежимОтображения = 2 Тогда // По КПС затрат.
		ЗатратыСводно.Колонки.Добавить("КПСКт",    Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	КонецЕсли;
	ЗатратыСводно.Колонки.Добавить("СчетДт",                     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ЗатратыСводно.Колонки.Добавить("КПСДт",                      Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ЗатратыСводно.Колонки.Добавить("КЭКДт",                      Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ЗатратыСводно.Колонки.Добавить("ПодразделениеДт",            Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ЗатратыСводно.Колонки.Добавить("СубконтоДт1",                ОписаниеТиповСубконто);
	ЗатратыСводно.Колонки.Добавить("СубконтоДт2",                ОписаниеТиповСубконто);
	ЗатратыСводно.Колонки.Добавить("СубконтоДт3",                ОписаниеТиповСубконто);
	ЗатратыСводно.Колонки.Добавить("СубконтоДт1Доступность",     Новый ОписаниеТипов("Булево"));
	ЗатратыСводно.Колонки.Добавить("СубконтоДт2Доступность",     Новый ОписаниеТипов("Булево"));
	ЗатратыСводно.Колонки.Добавить("СубконтоДт3Доступность",     Новый ОписаниеТипов("Булево"));
	ЗатратыСводно.Колонки.Добавить("ПодразделениеДтДоступность", Новый ОписаниеТипов("Булево"));
	ЗатратыСводно.Колонки.Добавить("ПодразделениеДтОбязательно", Новый ОписаниеТипов("Булево"));
	ЗатратыСводно.Колонки.Добавить("СчетДт40120",                Новый ОписаниеТипов("Булево"));
	ЗатратыСводно.Колонки.Добавить("ПодразделениеКтНеЗаполнено", Новый ОписаниеТипов("Булево"));
	ЗатратыСводно.Колонки.Добавить("Сумма",                      ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	ЗатратыСводно.Колонки.Добавить("СуммаНУ",                    ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	ЗатратыСводно.Колонки.Добавить("СуммаЕНВД",                  ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	ЗатратыСводно.Колонки.Добавить("СуммаНеУчитываетсяНУ",       ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	
	ЗатратыДетально = Новый ТаблицаЗначений;
	ЗатратыДетально.Колонки.Добавить("КлючСтроки",                 ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ЗатратыДетально.Колонки.Добавить("ВидЗатрат",                  Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ЗатратыДетально.Колонки.Добавить("ДопСубконто",                ОписаниеТиповСубконто);
	ЗатратыДетально.Колонки.Добавить("ДопСубконтоДоступность",     Новый ОписаниеТипов("Булево"));
	ЗатратыДетально.Колонки.Добавить("СчетКт",                     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ЗатратыДетально.Колонки.Добавить("КПСКт",                      Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ЗатратыДетально.Колонки.Добавить("КЭККт",                      Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ЗатратыДетально.Колонки.Добавить("ПодразделениеКт",            Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ЗатратыДетально.Колонки.Добавить("ПодразделениеКтДоступность", Новый ОписаниеТипов("Булево"));
	ЗатратыДетально.Колонки.Добавить("Сумма",                      ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	
	ЗатратыДетальноНУ = Новый ТаблицаЗначений;
	ЗатратыДетальноНУ.Колонки.Добавить("КлючСтроки",                 ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ЗатратыДетальноНУ.Колонки.Добавить("ВидЗатрат",                  Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ЗатратыДетальноНУ.Колонки.Добавить("ДопСубконто",                ОписаниеТиповСубконто);
	ЗатратыДетальноНУ.Колонки.Добавить("ДопСубконтоДоступность",     Новый ОписаниеТипов("Булево"));
	ЗатратыДетальноНУ.Колонки.Добавить("СчетКт",                     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ЗатратыДетальноНУ.Колонки.Добавить("ПодразделениеКт",            Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ЗатратыДетальноНУ.Колонки.Добавить("ПодразделениеКтДоступность", Новый ОписаниеТипов("Булево"));
	ЗатратыДетальноНУ.Колонки.Добавить("Сумма",                      ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	ЗатратыДетальноНУ.Колонки.Добавить("СуммаЕНВД",                  ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	ЗатратыДетальноНУ.Колонки.Добавить("СуммаНеУчитываетсяНУ",       ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
	
	МассивСчетовСебестоимость            = БухгалтерскийУчет.СписокСчетов("110.60,Н20.11,Н20.12", Дата, Ложь, Организация);
	МассивСчетовНакладныеРасходы         = БухгалтерскийУчет.СписокСчетов("110.70,Н25.11,Н25.12", Дата, Ложь, Организация);
	МассивСчетовОбщехозяйственныеРасходы = БухгалтерскийУчет.СписокСчетов("110.80,Н26.11,Н26.12", Дата, Ложь, Организация);
	МассивСчетовИздержкиОбращения        = БухгалтерскийУчет.СписокСчетов("109.90,Н44", Дата, Ложь, Организация);
	МассивСчетов40120                    = БухгалтерскийУчет.СписокСчетов("401.20", Дата, Ложь, Организация);
	
	ШаблонСтроки = "%1, %2";
	ВсеСчета = ОбщегоНазначения.СкопироватьРекурсивно(МассивСчетовСебестоимость);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСчета, МассивСчетовНакладныеРасходы);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеСчета, МассивСчетовОбщехозяйственныеРасходы);
	КодыСчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ВсеСчета, "Код"); 
	
	ВидДопСубконто = ПланыВидовХарактеристик.ВидыСубконто.НаправленияДеятельности;
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, Дата, КФО);
	
	ТабЧастиДляЗаполнения = Новый Массив;
	ТабЧастиДляЗаполнения.Добавить("ЗатратыПрямые");
	ТабЧастиДляЗаполнения.Добавить("ЗатратыОбщие");
	Если ОтражатьВНалоговомУчете Тогда
		ТабЧастиДляЗаполнения.Добавить("ЗатратыНУ");
		ВидыРасходовНУ = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(
			ЗатратыНУ.ВыгрузитьКолонку("ВидЗатрат"), "ВидРасходовНУ");
	КонецЕсли;
	
	Для Каждого ТабЧасть Из ТабЧастиДляЗаполнения Цикл
		
		Для Каждого СтрокаТабЧасти Из ЭтотОбъект[ТабЧасть] Цикл
		
			Если ТабЧасть <> "ЗатратыНУ" Тогда
				СтрокаДетально = ЗатратыДетально.Добавить();
			Иначе
				СтрокаДетально = ЗатратыДетальноНУ.Добавить();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтрокаДетально, СтрокаТабЧасти);
			
			СтруктураПоиска = Новый Структура(
				"СчетДт, КПСДт, КЭКДт, ПодразделениеДт,СубконтоДт1, СубконтоДт2, СубконтоДт3");
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТабЧасти);
			
			УслугаРасход = "";
			ТипЗатрат    = "";
			Если ТабЧасть <> "ЗатратыОбщие" И МассивСчетовСебестоимость.Найти(СтрокаТабЧасти.СчетКт) <> Неопределено Тогда
				УслугаРасход = СтрШаблон(ШаблонСтроки,
					КодыСчетов.Получить(СтрокаТабЧасти.СчетКт), СтрокаТабЧасти.Номенклатура);
				ТипЗатрат    = УчетПроизводстваКлиентСервер.ТипЗатратСебестоимость();
			ИначеЕсли МассивСчетовНакладныеРасходы.Найти(СтрокаТабЧасти.СчетКт) <> Неопределено Тогда
				УслугаРасход = СтрШаблон(ШаблонСтроки,
					КодыСчетов.Получить(СтрокаТабЧасти.СчетКт), НСтр("ru = 'Накладные расходы'"));
				ТипЗатрат    = УчетПроизводстваКлиентСервер.ТипЗатратНакладныеРасходы();
			ИначеЕсли МассивСчетовОбщехозяйственныеРасходы.Найти(СтрокаТабЧасти.СчетКт) <> Неопределено Тогда
				УслугаРасход = СтрШаблон(ШаблонСтроки,
					КодыСчетов.Получить(СтрокаТабЧасти.СчетКт), НСтр("ru = 'Общехозяйственные расходы'"));
				ТипЗатрат    = УчетПроизводстваКлиентСервер.ТипЗатратОбщехозяйственныеРасходы();
			КонецЕсли;
			
			Если РежимОтображения <> 0 Тогда
				Если ТабЧасть <> "ЗатратыНУ" Тогда
					Если РежимОтображения = 1 Тогда // По разделам/подразделам КПС затрат.
						СтруктураПоиска.Вставить("КПСКт", Лев(СтрокаТабЧасти.КПСКт, 4));
					ИначеЕсли РежимОтображения = 2 Тогда // По КПС затрат.
						СтруктураПоиска.Вставить("КПСКт", СтрокаТабЧасти.КПСКт);
					КонецЕсли;
					УслугаРасход = УслугаРасход + ", " + СтруктураПоиска.КПСКт;
				Иначе
					// В режимах 1 "По разделам, подразделам" и 2 "По КПС затрат" строки НУ в сводной таблице располагаются отдельно.
					// Для них особым образом формируем описание и заполняем счет дебета.
					Если МассивСчетовСебестоимость.Найти(СтрокаТабЧасти.СчетКт) <> Неопределено Тогда
						УслугаРасход = Строка(СтрокаТабЧасти.СчетКт) + ", "+ СтрокаТабЧасти.Номенклатура;
					ИначеЕсли МассивСчетовНакладныеРасходы.Найти(СтрокаТабЧасти.СчетКт) <> Неопределено Тогда
						УслугаРасход = Строка(СтрокаТабЧасти.СчетКт) + ", Накладные расходы (НУ)";
					ИначеЕсли МассивСчетовОбщехозяйственныеРасходы.Найти(СтрокаТабЧасти.СчетКт) <> Неопределено Тогда
						УслугаРасход = Строка(СтрокаТабЧасти.СчетКт) + ", Общехозяйственные расходы (НУ)";
					ИначеЕсли МассивСчетовИздержкиОбращения.Найти(СтрокаТабЧасти.СчетКт) <> Неопределено Тогда
						УслугаРасход = Строка(СтрокаТабЧасти.СчетКт) + ", Издержки обращения (НУ)";
					КонецЕсли;
					СтруктураПоиска.СчетДт = УчетПроизводстваКлиентСервер.СчетСписанияПроизводственныхРасходовНУ(
						СтрокаДетально.СчетКт, ВидыРасходовНУ[СтрокаДетально.ВидЗатрат]);
				КонецЕсли;
			КонецЕсли;
			
			СтруктураПоиска.Вставить("ТипЗатрат",    ТипЗатрат);
			СтруктураПоиска.Вставить("УслугаРасход", УслугаРасход);
			Если ТипЗатрат = УчетПроизводстваКлиентСервер.ТипЗатратСебестоимость() Тогда
				СтруктураПоиска.Вставить("Номенклатура", СтрокаТабЧасти.Номенклатура);
			КонецЕсли;
			
			НайденныеСтроки = ЗатратыСводно.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() = 0 Тогда
				
				// Заполняем строку таблицы ЗатратыСводно
				СтрокаСводно = ЗатратыСводно.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаСводно, СтруктураПоиска);
				
				СтрокаСводно.КлючСтроки   = Строка(Новый УникальныйИдентификатор);
				СтрокаСводно.Номенклатура = ?(ТипЗатрат = УчетПроизводстваКлиентСервер.ТипЗатратСебестоимость(),
					СтрокаТабЧасти.Номенклатура,
					Справочники.Номенклатура.ПустаяСсылка());
				
				СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаСводно.СчетДт);
				СтрокаСводно.СубконтоДт1Доступность     = СвойстваСчетаДт.КоличествоСубконто>0;
				СтрокаСводно.СубконтоДт2Доступность     = СвойстваСчетаДт.КоличествоСубконто>1;
				СтрокаСводно.СубконтоДт3Доступность     = СвойстваСчетаДт.КоличествоСубконто>2;
				СтрокаСводно.ПодразделениеДтДоступность = СвойстваСчетаДт.УчетПоПодразделениям;
				СтрокаСводно.ПодразделениеДтОбязательно = НЕ СвойстваСчетаДт.РазрешитьНеУказыватьПодразделение;
				СтрокаСводно.СчетДт40120                = (МассивСчетов40120.Найти(СтрокаСводно.СчетДт) <> Неопределено);
				
			Иначе
				СтрокаСводно = НайденныеСтроки[0];
			КонецЕсли;
			
			СтрокаДетально.КлючСтроки = СтрокаСводно.КлючСтроки;
			
			// Заполним значение доп. субконто.
			СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаДетально.СчетКт);
			Если ТабЧасть = "ЗатратыПрямые" Тогда
				Если СвойстваСчетаКт.ВидСубконто3 = ВидДопСубконто Тогда
					СтрокаДетально.ДопСубконто = СтрокаТабЧасти.СубконтоКт3;
					СтрокаДетально.ДопСубконтоДоступность = Истина;
				КонецЕсли;
			Иначе
				Если СвойстваСчетаКт.ВидСубконто2 = ВидДопСубконто Тогда
					СтрокаДетально.ДопСубконто = СтрокаТабЧасти.СубконтоКт2;
					СтрокаДетально.ДопСубконтоДоступность = Истина;
				ИначеЕсли СвойстваСчетаКт.ВидСубконто3 = ВидДопСубконто Тогда
					СтрокаДетально.ДопСубконто = СтрокаТабЧасти.СубконтоКт3;
					СтрокаДетально.ДопСубконтоДоступность = Истина;
				КонецЕсли;
			КонецЕсли;
			
			// Подразделение Кт.
			СтрокаДетально.ПодразделениеКтДоступность = СвойстваСчетаКт.УчетПоПодразделениям;
			СтрокаСводно.ПодразделениеКтНеЗаполнено = СтрокаСводно.ПодразделениеКтНеЗаполнено
				ИЛИ НЕ ?(СвойстваСчетаКт.УчетПоПодразделениям, ЗначениеЗаполнено(СтрокаДетально.ПодразделениеКт), Истина);
			
			Если ТабЧасть <> "ЗатратыНУ" Тогда
				СтрокаСводно.Сумма = СтрокаСводно.Сумма + СтрокаДетально.Сумма;
			Иначе
				СтрокаСводно.СуммаНУ              = СтрокаСводно.СуммаНУ              + СтрокаДетально.Сумма;
				СтрокаСводно.СуммаЕНВД            = СтрокаСводно.СуммаЕНВД            + СтрокаДетально.СуммаЕНВД;
				СтрокаСводно.СуммаНеУчитываетсяНУ = СтрокаСводно.СуммаНеУчитываетсяНУ + СтрокаДетально.СуммаНеУчитываетсяНУ;
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;
	
	ЗатратыСводно.Сортировать("УслугаРасход");
	
	Возврат Новый Структура("ЗатратыСводно,ЗатратыДетально,ЗатратыДетальноНУ",
		ЗатратыСводно, ЗатратыДетально, ЗатратыДетальноНУ);
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
