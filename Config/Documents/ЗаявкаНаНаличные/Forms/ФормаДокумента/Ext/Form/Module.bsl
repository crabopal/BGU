	Объект.ОрганКазначейства		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
   	ПриИзмененииЛицевогоСчета();

КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьПлатежныеРеквизитыОрганизации(Знач ПараметрыОбъекта, ДопустимыеИсточникиСредств, СвойстваЛицевогоСчета)

	РеквизитыПлательщика = Новый Структура("ИННПлательщика, КПППлательщика, ТекстПлательщика, НомерСчетаПлательщика, НаименованиеБанкаПлательщика, БикБанкаПлательщика, СчетБанкаПлательщика", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ПараметрыОбъекта.ЛицевойСчет, ПараметрыОбъекта.РеквизитыЛицевогоСчета, РеквизитыПлательщика);
	
	ДопустимыеИсточникиСредств 	= ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(ПараметрыОбъекта.ЛицевойСчет);
   	СвойстваЛицевогоСчета 		= ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(ПараметрыОбъекта.ЛицевойСчет, ПараметрыОбъекта.Дата); 	

	
	
	Возврат РеквизитыПлательщика;

КонецФункции

&НаСервере
Процедура ПриИзмененииЛицевогоСчета()
	
	Перем ДопустимыеИсточникиСредств;
	
	ПараметрыОбъекта = Новый Структура("ЛицевойСчет, Дата, РеквизитыЛицевогоСчета");
	ЗаполнитьЗначенияСвойств(ПараметрыОбъекта, Объект);
	
	РеквизитыПлательщика = ПолучитьПлатежныеРеквизитыОрганизации(ПараметрыОбъекта, ДопустимыеИсточникиСредств, СвойстваЛицевогоСчета);
	
	Если ЗначениеЗаполнено(Объект.ЛицевойСчет) тогда
		Объект.ПерваяПодпись				 	= СвойстваЛицевогоСчета.ПерваяПодпись;
		Объект.ВтораяПодпись 					= СвойстваЛицевогоСчета.ВтораяПодпись;
		Объект.ВтораяПодписьПечататьДолжность 	= СвойстваЛицевогоСчета.ВтораяПодписьПечататьДолжность;
		Объект.ПерваяПодписьПечататьДолжность 	= СвойстваЛицевогоСчета.ПерваяПодписьПечататьДолжность;
		Объект.ПерваяПодписьДолжность         	= СвойстваЛицевогоСчета.ПерваяПодписьДолжность;
		Объект.ВтораяПодписьДолжность		  	= СвойстваЛицевогоСчета.ВтораяПодписьДолжность;
		
		Если НЕ СвойстваЛицевогоСчета.НеЗаполнятьПредельнуюДатуИсполнения Тогда
			Объект.ПредельнаяДатаИсполнения = КонецДня(?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса())) + СвойстваЛицевогоСчета.ПредельныйСрокИсполненияЗаявок;
		КонецЕсли;	
		
	Иначе
		Объект.ВтораяПодписьПечататьДолжность 	= Ложь;
		Объект.ПерваяПодписьПечататьДолжность 	= Ложь;
		Объект.ПерваяПодписьДолжность         	= "";
		Объект.ВтораяПодписьДолжность		  	= "";
		Объект.ОрганКазначейства				= "";
	КонецЕсли;	
	
	Элементы.РасшифровкаПлатежаИсточникСредств.СписокВыбора.ЗагрузитьЗначения(ДопустимыеИсточникиСредств);
	
	ПлатежноРасчетныеДокументы.ЗаполнитьДопустимыеКФОиИсточникиСредств(Объект.ЛицевойСчет,СписокДопустимыхКФО,СписокИсточниковСредствПоКФО);
	
	Для Каждого Стр Из Объект.РасшифровкаПлатежа Цикл
		
		Если СписокДопустимыхКФО.НайтиПоЗначению(Стр.КФО) = Неопределено Тогда
			Стр.КФО = "";
			Если СписокДопустимыхКФО.Количество() > 0 Тогда
				Стр.КФО = СписокДопустимыхКФО[0].Значение;
			КонецЕсли;
		КонецЕсли;
		
		ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет,Стр.КФО);
		Если ДопустимыеИсточникиСредств.Найти(Стр.ИсточникСредств) = Неопределено Тогда
			Стр.ИсточникСредств = "";
			Если ДопустимыеИсточникиСредств.Количество() > 0 Тогда
				Стр.ИсточникСредств = ДопустимыеИсточникиСредств[0];
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УстановитьДолжность(Знач Подпись, ПодписьПечататьДолжность, Дата)
	Возврат ПлатежноРасчетныеДокументыПовтИсп.ПолучитьДолжностьСотрудника(Подпись, ПодписьПечататьДолжность, Дата);
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеРаботника(Знач Работник,Дата)
	Возврат ПлатежноРасчетныеДокументыПовтИсп.ПолучитьДанныеСотрудника(Работник,Дата);
КонецФункции	

&НаКлиенте
ПРоцедура ПриИзмененииРаботника()
	Объект.РаботникФИО				= "";
	Объект.РаботникДолжность		= "";
	Объект.ДокументВид 				= "";
	Объект.ДокументДатаВыдачи 		= "";
	Объект.ДокументКемВыдан			= "";
	Объект.ДокументКодПодразделения = "";
	Объект.ДокументНомер			= "";
	Объект.ДокументСерия			= "";
	
	Если ЗначениеЗаполнено(Объект.Работник) тогда
		ДанныеРаботника = ПолучитьДанныеРаботника(Объект.Работник,Объект.Дата);
		
		Объект.РаботникДолжность = ДанныеРаботника.Должность;
		Объект.РаботникФИО	= ?(ЗначениеЗаполнено(ДанныеРаботника.ВыдатьКому),ДанныеРаботника.ВыдатьКому,НСтр("ru = '"+ДанныеРаботника.Фамилия+" "+ДанныеРаботника.Имя+" "+ДанныеРаботника.Отчество+"'"));
		Объект.ДокументВид 				= ДанныеРаботника.ВидДокумента;
		Объект.ДокументДатаВыдачи 		= ДанныеРаботника.ДатаВыдачи;
		Объект.ДокументКемВыдан			= ДанныеРаботника.КемВыдан;
		Объект.ДокументКодПодразделения = ДанныеРаботника.КодПодразделения;
		Объект.ДокументНомер			= ДанныеРаботника.Номер;
		Объект.ДокументСерия			= ДанныеРаботника.Серия;
	КонецЕсли;
	
КонецПРоцедуры	

&НаКлиенте
Процедура УстановитьДоступностьРеквизитовОрганизации()

	ДоступностьРеквизитов = ЗначениеЗаполнено(Объект.Организация);
	Элементы.ЛицевойСчет.Доступность = ДоступностьРеквизитов;
	Элементы.Подразделение.Доступность = ДоступностьРеквизитов;
	Элементы.ПерваяПодпись.Доступность = ДоступностьРеквизитов;
	Элементы.ВтораяПодпись.Доступность = ДоступностьРеквизитов;
	Элементы.Работник.Доступность = ДоступностьРеквизитов;

КонецПроцедуры // УстановитьДоступностьРеквизитовОрганизации()

&НаСервере
Функция КонтрольДокументаПоОбязательствамСервер(Адрес)
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	
	БухгалтерскиеОперацииСервер.ПередЗаписью(Ложь, ТекущийОбъект, Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись), ЭтаФорма);
	
	КонтрольРасходов.Контроль(ТекущийОбъект, Ложь,, Истина, Адрес);
	
	Если ЗначениеЗаполнено(Адрес) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ИзменитьСтатусДокумента()
	
	ПлатежноРасчетныеДокументыКлиент.ОткрытьФормуИзмененияСтатусаДокумента(ЭтаФорма);
	
КонецПроцедуры	

