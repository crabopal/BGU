&НаСервере
Процедура ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию()
	
	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.ЗаявкаНаНаличные", Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
	
	Объект.ЛицевойСчет 				= Умолчания.ЛицевойСчет;
	Объект.РеквизитыЛицевогоСчета 	= Умолчания.РеквизитыЛицевогоСчета;
	Объект.ОрганКазначейства		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
	ПриИзмененииЛицевогоСчета();
	
КонецПроцедуры	

