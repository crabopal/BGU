&НаКлиенте
Процедура РасшифровкаПлатежаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока Тогда
		Возврат
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.КФО) Тогда
		Если Элемент.ТекущиеДанные.НомерСтроки > 1 Тогда
			Элемент.ТекущиеДанные.КФО = Объект.РасшифровкаПлатежа[Элемент.ТекущиеДанные.НомерСтроки-2].КФО;
		Иначе
			Если СписокДопустимыхКФО.Количество() > 0 Тогда
				Элемент.ТекущиеДанные.КФО = СписокДопустимыхКФО[0].Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.ИсточникСредств) Тогда
		Если Элемент.ТекущиеДанные.НомерСтроки > 1 Тогда
			Элемент.ТекущиеДанные.ИсточникСредств = Объект.РасшифровкаПлатежа[Элемент.ТекущиеДанные.НомерСтроки-2].ИсточникСредств;
		Иначе
			ИсточникиСредствПоКФО = СписокИсточниковСредствПоКФО.НайтиСтроки(Новый Структура("КФО",Элемент.ТекущиеДанные.КФО));
			Если ИсточникиСредствПоКФО.Количество() > 0 Тогда
				СписокИСпоКФО = ИсточникиСредствПоКФО[0].СписокИсточников;
				Если СписокИСпоКФО.Количество() > 0 Тогда
					Элемент.ТекущиеДанные.ИсточникСредств = СписокИСпоКФО[0].Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СуммаДокумента) Тогда
		Элемент.ТекущиеДанные.Сумма = Объект.СуммаДокумента - (Объект.РасшифровкаПлатежа.Итог("Сумма") - Элемент.ТекущиеДанные.Сумма);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	РазницаИтогаТЧ = Объект.РасшифровкаПлатежа.Итог("Сумма") - Объект.СуммаДокумента;

КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПослеУдаления(Элемент)
	
	РазницаИтогаТЧ = Объект.РасшифровкаПлатежа.Итог("Сумма") - Объект.СуммаДокумента;

