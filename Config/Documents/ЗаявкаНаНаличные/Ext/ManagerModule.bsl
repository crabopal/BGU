// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции     

// Возвращает массив структур, содержащих значения реквизитов документа для выгрузки
//
// Параметры:
// МассивОбъектов               - Массив объектов данного вида
// ИспользоватьДопКл            - Признак применения доп. классификации и указании ее значений в структурах реквизитов документов
// ИспользоватьКодМероприятия   - Признак применения кодов мероприятий
// ИспользоватьКЭК              - Признак использования КЭК
// ИспользоватьАналитическийКод - Признак использования аналитического кода
// ИспользоватьКФО              - Признак применения КФО и указания значений КФО в структурах реквизитов документа
// ИспользоватьКОСГУПолучателя  - Признак использования КОСГУПолучателя
Функция ЗначенияРеквизитовДокумента(МассивОбъектов, ИспользоватьДопКл = Ложь, ИспользоватьКодМероприятия = Ложь, ИспользоватьКЭК = Ложь, ИспользоватьАналитическийКод = Ложь, ИспользоватьКФО = Ложь, ИспользоватьКОСГУПолучателя = Ложь) Экспорт  
	
	Возврат ПлатежноРасчетныеДокументы.ЗначенияРеквизитовЗаявкаНаНаличные(МассивОбъектов, ИспользоватьДопКл, ИспользоватьКодМероприятия, ИспользоватьКЭК, ИспользоватьАналитическийКод, ИспользоватьКФО, ИспользоватьКОСГУПолучателя);
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает сведения о записи в регистре сведенеий "СостояниеПлатежноРасчетныхДокументов"
//    Входящие параметры: Ссылка - тип ссылка на документ "Уведомление об уточнении операции клиента"
//    Исходящие параметры: 
Функция ПолучитьСостояниеДокумента(Ссылка) экспорт
	СтруктураРеквизитов = Новый Структура;
	ПоляВыборки = "";
	//  Струкутра реквизитов динамическая, т.к. со временем может понадобится новый ресурс в регистр
	//  что-бы его не забыть будем каждый раз перебирать ресурсы регистра
	Для каждого Ресурс из Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Ресурсы цикл
		СтруктураРеквизитов.Вставить(Ресурс.Имя);
		ПоляВыборки = ПоляВыборки + "
		|	Состояние." + Ресурс.Имя + " КАК " + Ресурс.Имя + ", "
	КонецЦикла;	
	//  Добавка ввиде реквизита "ПервичныйОбразИРеквизиты"
	СтруктураРеквизитов.Вставить("ПервичныйОбразИРеквизиты");		
	ПоляВыборки = ПоляВыборки + "
	|	Состояние.ПервичныйОбразИРеквизиты КАК ПервичныйОбразИРеквизиты ";
	
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.ЗаявкаНаНаличные") тогда
		Возврат СтруктураРеквизитов;
	КонецЕсли;	
		
	ТекстЗапроса = "ВЫБРАТЬ " + ПоляВыборки + "
					|ИЗ	
					|	РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК Состояние
					|ГДЕ 
					|	Состояние.ПлатежноРасчетныйДокумент = &Ссылка";
						
	Запрос = Новый Запрос(ТекстЗапроса);				
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
		
	Для каждого КлючЗначение из СтруктураРеквизитов Цикл
		ТекРеквизит = КлючЗначение.Ключ;
		СтруктураРеквизитов[ТекРеквизит] = Выборка[ТекРеквизит];
	КонецЦикла;	
		
	Возврат СтруктураРеквизитов;
КонецФункции	

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗаявкаНаНаличные";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0531802_21н";
	КомандаПечати.Представление		= НСтр("ru = 'Заявка на наличные'");
	КомандаПечати.Порядок			= 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗаявкаНаНаличные";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0531802_16н";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Заявка на наличные (пр. 16н)'");
	КомандаПечати.Порядок			= 100;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗаявкаНаНаличные";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0531802";
	КомандаПечати.Представление		= НСтр("ru = '(устарел) Заявка на наличные (пр. 8н)'");
	КомандаПечати.Порядок			= 200;
	
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531802") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПФ_MXL_Форма0531802",
		"Заявка на наличные",
		Печать0531802(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531802_16н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПФ_MXL_Форма0531802_16н",
		"Заявка на наличные (в ред. приказа 16н)",
		Печать0531802_16н(МассивОбъектов, ОбъектыПечати, "_16н"));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531802_21н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПФ_MXL_Форма0531802_21н",
		"Заявка на наличные (в ред. приказа 21н)",
		Печать0531802_16н(МассивОбъектов, ОбъектыПечати, "_21н"));
	КонецЕсли;

КонецПроцедуры

// Функция формирует табличный документ Заявка на наличные (ф 0531802)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция Печать0531802(МассивОбъектов, ОбъектыПечати)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы 					= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб 						= Истина; 
	ТабДокумент.ВерхнийКолонтитул.Выводить 			= Истина;
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница = 2; 
	ТабДокумент.НижнийКолонтитул.Выводить 			= Истина;
	ТабДокумент.ПолеСверху 							= 10;
	ТабДокумент.ПолеСнизу 							= 12;
	ТабДокумент.РазмерКолонтитулаСверху 			= 10;
	ТабДокумент.РазмерКолонтитулаСнизу 				= 12;
	ТабДокумент.ИмяПараметровПечати 				= "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаявкаНаНаличные_ЗаявкаНаНаличные";
	
	Макет 			= УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявкаНаНаличные.ПФ_MXL_Форма0531802");
	
	ДанныеДляПечатиМассив = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовЗаявкаНаНаличные(МассивОбъектов);
	
	ПервыйДокумент = Истина;

	Для Каждого ДанныеДляПечати Из ДанныеДляПечатиМассив Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ОбластьВывода = Макет.ПолучитьОбласть("Заголовок");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		
		// дальше надо смотреть, умещается ли на страницу
		
		// Раздел 1
		ШапкаРаздела = Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "1");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_1", Новый Структура, ДанныеДляПечати);  
		Для Каждого СтрВыборка Из ДанныеДляПечати.КассовыеСимволы Цикл 
			ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_1_Строка", СтрВыборка, ДанныеДляПечати, "Раздел_1_Шапка", ШапкаРаздела);  
		КонецЦикла;
		ИтогКП = Новый Структура ("СуммаДокумента", ДанныеДляПечати.КассовыеСимволы.Итог("СуммаДокумента"));
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_1_Итог", ИтогКП, ДанныеДляПечати, "Раздел_1_Шапка", ШапкаРаздела);  
		
		// Раздел 2
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ШапкаРаздела = Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "2");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		
		ТабДокумент.Вывести(ШапкаРаздела);
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_2", Новый Структура, ДанныеДляПечати, ,ШапкаРаздела);  
		Для Каждого СтрВыборка Из ДанныеДляПечати.РасшифровкаПлатежа Цикл 
			ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_2_Строка", СтрВыборка, ДанныеДляПечати, "Раздел_2_Шапка", ШапкаРаздела);  
		КонецЦикла;
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Разделитель"));
		
		// Подвал
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Работник", ДанныеДляПечати, ДанныеДляПечати, ,ШапкаРаздела);  
		
		// последняя подпись ответственного исполнителя 
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("ОтметкаФК"));
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДляПечати.Ссылка);
		
	КонецЦикла;	
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция формирует табличный документ Заявка на наличные (ф 0531802)(в ред. приказа 16н)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция Печать0531802_16н(МассивОбъектов, ОбъектыПечати, Постфикс)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы 					= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб 						= Истина; 
	ТабДокумент.ВерхнийКолонтитул.Выводить 			= Истина;
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница = 2; 
	ТабДокумент.НижнийКолонтитул.Выводить 			= Истина;
	ТабДокумент.ПолеСверху 							= 10;
	ТабДокумент.ПолеСнизу 							= 12;
	ТабДокумент.РазмерКолонтитулаСверху 			= 10;
	ТабДокумент.РазмерКолонтитулаСнизу 				= 12;
	ТабДокумент.ИмяПараметровПечати 				= "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаявкаНаНаличные_ЗаявкаНаНаличные";
	
	Макет 			      = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявкаНаНаличные.ПФ_MXL_Форма0531802" + Постфикс);
	
	ДанныеДляПечатиМассив = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовЗаявкаНаНаличные(МассивОбъектов);
	
	ПервыйДокумент        = Истина;
	
	Для Каждого ДанныеДляПечати Из ДанныеДляПечатиМассив Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ОбластьВывода = Макет.ПолучитьОбласть("Заголовок");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		
		// дальше надо смотреть, умещается ли на страницу
		
		// Раздел 1
		ШапкаРаздела = Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "1");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_1", Новый Структура, ДанныеДляПечати);  
		Для Каждого СтрВыборка Из ДанныеДляПечати.КассовыеСимволы Цикл 
			ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_1_Строка", СтрВыборка, ДанныеДляПечати, "Раздел_1_Шапка", ШапкаРаздела);  
		КонецЦикла;
		ИтогКП = Новый Структура ("СуммаДокумента", ДанныеДляПечати.КассовыеСимволы.Итог("СуммаДокумента"));
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_1_Итог", ИтогКП, ДанныеДляПечати, "Раздел_1_Шапка", ШапкаРаздела);  
		
		// Раздел 2
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ШапкаРаздела = Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "2");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		
		ТабДокумент.Вывести(ШапкаРаздела);
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_2", Новый Структура, ДанныеДляПечати, ,ШапкаРаздела);  
		Для Каждого СтрВыборка Из ДанныеДляПечати.РасшифровкаПлатежа Цикл 
			ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_2_Строка", СтрВыборка, ДанныеДляПечати, "Раздел_2_Шапка", ШапкаРаздела);  
		КонецЦикла;
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Разделитель"));
		
		// Подвал
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Работник", ДанныеДляПечати, ДанныеДляПечати, ,ШапкаРаздела);  
		
		// последняя подпись ответственного исполнителя 
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("ОтметкаФК"));
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДляПечати.Ссылка);
		
	КонецЦикла;	
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, Область, ИсточникПараметров, ПоляПодвала, Шапка = Неопределено, ШапкаРаздела = Неопределено)  
		
	ВыводимыеОбласти = Новый Массив();
	ВыводимыеОбласти.Добавить(Макет.ПолучитьОбласть(Область));
    ВыводимыеОбласти.Добавить(Макет.ПолучитьОбласть("Подвал"));
	ВыводимыеОбласти[0].Параметры.Заполнить(ИсточникПараметров);
	ВыводимыеОбласти[1].Параметры.Заполнить(ПоляПодвала);
	
	Попытка 
		Если НЕ ТабДокумент.ПроверитьВывод(ВыводимыеОбласти) Тогда
			ТабДокумент.Вывести(ВыводимыеОбласти[1]);
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			Если НЕ ШапкаРаздела = Неопределено Тогда
				ТабДокумент.Вывести(ШапкаРаздела);	
			КонецЕсли;	
			Если НЕ Шапка = Неопределено Тогда
				ТабДокумент.Вывести(Макет.ПолучитьОбласть(Шапка));	
			КонецЕсли;	
		КонецЕсли;
		ТабДокумент.Вывести(ВыводимыеОбласти[0]);
	Исключение
		Сообщить("В системе не установлено ни одного принтера.");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли

