Функция ПолучитьДанныеДляПечати0510466(МассивОбъектов)
	
	Перем СерииДокументовДляПечати;
	
	// СерииДокументов
	ИнвентаризацияСервер.ПрочитатьСерииДокументовДляПечати(МассивОбъектов, СерииДокументовДляПечати);
	// Конец СерииДокументов
	
	ЗапросПоиск = Новый Запрос();
	
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", СерииДокументовДляПечати.ДополненныйМассивОбъектов);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаПечать0510466();
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	Данные = Новый Структура();
	Данные.Вставить("Выборки", Новый Структура());
	
	Данные.Выборки.Вставить("Шапки",				РезультатыЗапроса[1].Выбрать());
	Данные.Выборки.Вставить("Раздел1",				РезультатыЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел21",				РезультатыЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел22",				РезультатыЗапроса[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел3",				РезультатыЗапроса[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел4",				РезультатыЗапроса[6].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	Данные.Вставить("ДополнительныеПараметры", ПолучитьДополнительныеПараметрыПечати0510466(МассивОбъектов, РезультатыЗапроса));
	
	Данные.Вставить("СоставКомиссииРаздел2", ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(СерииДокументовДляПечати.ДополненныйМассивОбъектов, "СоставКомиссииРаздел2"));
	Данные.Вставить("СоставКомиссииРаздел4", ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(СерииДокументовДляПечати.ДополненныйМассивОбъектов, "СоставКомиссииРаздел4"));
	
	Данные.Вставить("СведенияУчреждений", УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(СерииДокументовДляПечати.ДополненныйМассивОбъектов));
	
	// СерииДокументов
	Данные.Выборки.Вставить("ШапкиПоискаЗаголовочныхДокументов", РезультатыЗапроса[1].Выбрать());
	Данные.Вставить("СерииДокументовДляПечати", СерииДокументовДляПечати);
	// Конец СерииДокументов
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьТекстЗапросаПечать0510466()
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Все различные НФА и их номера из документов
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЧ.Ссылка														КАК Ссылка,
	|	ТЧ.НФА															КАК НФА,
	|	ТЧ.ИнвентарныйНомер												КАК ИнвентарныйНомер,
	|	(ТЧ.НФА ССЫЛКА Справочник.ОсновныеСредства)						КАК ТипНфаОС,
	|	ВЫБОР
	|		КОГДА ТЧ.НФА ССЫЛКА Справочник.ОсновныеСредства ТОГДА
	|			ЕСТЬNULL(ВЫБОР
	|				КОГДА СправочникОсновныеСредства.НаименованиеПолное <> """" ТОГДА
	|					СправочникОсновныеСредства.НаименованиеПолное
	|				ИНАЧЕ
	|					СправочникОсновныеСредства.Наименование
	|			КОНЕЦ, """")
	|		ИНАЧЕ
	|			ЕСТЬNULL(ВЫБОР
	|				КОГДА СправочникНоменклатура.НаименованиеПолное <> """" ТОГДА
	|					СправочникНоменклатура.НаименованиеПолное
	|				ИНАЧЕ
	|					СправочникНоменклатура.Наименование
	|			КОНЕЦ, """")
	|	КОНЕЦ															КАК НаименованиеОбъекта,
	|	
	|	ЕСТЬNULL(СправочникНоменклатура.Код, """")						КАК НоменклатураКод,
	|	ЕСТЬNULL(СправочникНоменклатура.НоменклатурныйНомер, """")		КАК НоменклатураНоменклатурныйНомер,
	|	
	|	ЕСТЬNULL(СправочникОсновныеСредства.Код, """")					КАК ОсновноеСредствоКод,
	|	ЕСТЬNULL(СправочникОсновныеСредства.НоменклатурныйНомер, """")	КАК ОсновноеСредствоНоменклатурныйНомер,
	|	ЕСТЬNULL(СправочникОсновныеСредства.ИмуществоКазны, ЛОЖЬ)		КАК ОсновноеСредствоИмуществоКазны,
	|	ЕСТЬNULL(СправочникОсновныеСредства.ВидНФА,
	|		ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ПустаяСсылка))				КАК ОсновноеСредствоВидНФА,
	|	
	|	ЕСТЬNULL(СправочникИнвентарныеНомераОС.Код, """")					КАК ИнвентарныйНомерКод,
	|	ВЫРАЗИТЬ(
	|		ЕСТЬNULL(СправочникИнвентарныеНомераОС.ЗаводскойНомер, """")
	|		КАК СТРОКА(1000))											КАК ИнвентарныйНомерЗаводскойНомер,
	|	ЕСТЬNULL(СправочникИнвентарныеНомераОС.РеестровыйНомер, """")		КАК ИнвентарныйНомерРеестровыйНомер,
	|	ЕСТЬNULL(СправочникИнвентарныеНомераОС.ИнойНомер, """")			КАК ИнвентарныйНомерИнойНомер
	|ИЗ
	|	(ВЫБРАТЬ
	|		Ссылка				КАК Ссылка,
	|		НФА					КАК НФА,
	|		ИнвентарныйНомер	КАК ИнвентарныйНомер
	|	ИЗ
	|		Документ.ИнвентаризационнаяОписьНФА.Раздел1
	|	ГДЕ
	|		Ссылка В(&МассивСсылок)
	|	
	|	ОБЪЕДИНИТЬ
	|	
	|	ВЫБРАТЬ
	|		Ссылка				КАК Ссылка,
	|		НФА					КАК НФА,
	|		ИнвентарныйНомер	КАК ИнвентарныйНомер
	|	ИЗ
	|		Документ.ИнвентаризационнаяОписьНФА.Раздел21
	|	ГДЕ
	|		Ссылка В(&МассивСсылок)
	|	) КАК ТЧ
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК СправочникОсновныеСредства
	|		ПО ТЧ.НФА = СправочникОсновныеСредства.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК СправочникИнвентарныеНомераОС
	|		ПО ТЧ.ИнвентарныйНомер = СправочникИнвентарныеНомераОС.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО ТЧ.НФА = СправочникНоменклатура.Ссылка
	|ГДЕ
	|	ТЧ.Ссылка В(&МассивСсылок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные шапок
	|//
	|ВЫБРАТЬ
	|	Ссылка											КАК Ссылка,
	|	Номер											КАК Номер,
	|	Дата											КАК Дата,
	|	Организация										КАК Организация,
	|	Подразделение									КАК Подразделение,
	|	ИФО												КАК ИФО,
	|	ДатаНачала										КАК ДатаНачала,
	|	ДатаОкончания									КАК ДатаОкончания,
	|	ДатаИнвентаризации								КАК ДатаИнвентаризации,
	|	МОЛ												КАК МОЛ,
	|	Ответственный									КАК Ответственный,
	|	ОтветственныйИсполнитель						КАК ОтветственныйИсполнитель,
	|	ОтветственныйИсполнительБухгалтерскойСлужбы		КАК ОтветственныйИсполнительБухгалтерскойСлужбы,
	|	Комментарий										КАК Комментарий,
	|	РешениеОПроведенииИнвентаризации				КАК РешениеОПроведенииИнвентаризации,
	|	РешениеОПроведенииИнвентаризации.Номер			КАК НомерРешенияОПроведенииИнвентаризации,
	|	РешениеОПроведенииИнвентаризации.Дата			КАК ДатаРешенияОПроведенииИнвентаризации,
	|	Комиссия										КАК Комиссия,
