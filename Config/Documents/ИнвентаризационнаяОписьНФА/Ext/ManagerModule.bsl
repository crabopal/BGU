Функция ПолучитьКоличествоПоУмолчанию()
	
	Возврат 1;
	
КонецФункции

// Применяется для замены нулевого количества по данным учета
Функция ПолучитьУсловнуюЕдиницуИзмерения()
	
	УслЕдИзм = Справочники.КлассификаторЕдиницИзмерения.ЕдиницаИзмеренияПоКоду("876");
	
	Если Не ЗначениеЗаполнено(УслЕдИзм) Тогда
		
		ВызватьИсключение НСтр("ru='В справочнике ""Классификатор единиц измерения"" не найден элемент ""Условная единица"", код 876.
			|Этот элемент требуется для дальнейшего заполнения документа инвентаризации.
			|Необходимо добавить в справочник элемент ""Условная единица"", код 876, и повторить заполнение документа инвентаризации.'")
		
	КонецЕсли;
	
	Возврат УслЕдИзм;
	
КонецФункции

Процедура УстановитьКоличествоПоУмолчанию(ТаблицаРаздела1)
	
	Поиск = Новый Структура("ЭтоСчетУстановкиКоличестваПоУмолчанию,Количество", Истина, 0);
	
	МассивСтрок = ТаблицаРаздела1.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоПоУмолчанию = ПолучитьКоличествоПоУмолчанию();
	
	УслЕдИзм = ПолучитьУсловнуюЕдиницуИзмерения();
	
	ЗаполняющаяСтруктура = Новый Структура("ЕдИзм", УслЕдИзм); // Заполнение количества отключено, в отличие от формы 0504087.
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗаполняющаяСтруктура);
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьЕдИзмШт(ТаблицаРаздела1, ПараметрыПоиска)
	
	Поиск = Новый Структура("ЕдИзм", Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
	
	МассивСтрок = ТаблицаРаздела1.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СтрокаТаблицы.ЕдИзм = ПараметрыПоиска.ЕдИзмШт;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРаздела21

Процедура ЗаполнитьПримечаниеРаздела21(ТаблицаРаздела21, ПараметрыФункции)
	
	Если Не (ПараметрыФункции.Свойство("Раздел1") И ПараметрыФункции.Свойство("ДополнениеРаздела1")) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаРаздела21.Колонки.Добавить("Примечание", Новый ОписаниеТипов(Метаданные.Документы.ИнвентаризационнаяОписьНФА.ТабличныеЧасти.Раздел21.Реквизиты.Примечание.Тип));
	
	ТаблицаРаздел1				= ПараметрыФункции.Раздел1;
	ТаблицаДополнениеРаздела1	= ПараметрыФункции.ДополнениеРаздела1;
	
	ТаблицаИдентификаторов = ПолучитьТаблицуИдентификаторовСтрокРаздела1(ТаблицаРаздел1, ТаблицаДополнениеРаздела1);
	
	Если ТаблицаИдентификаторов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоляГруппировкаТаблицаИдентификаторов = "НФА,ИнвентарныйНомер,МестоИнвентаризации";
	
	ТаблицаРаздела21.Индексы.Добавить(ПоляГруппировкаТаблицаИдентификаторов);
	
	ТаблицаДополнениеРаздела1.Индексы.Добавить("ИдентификаторСтроки");
	
	ПоискГруппировкаМестоИнвентаризации = Новый Структура(ПоляГруппировкаТаблицаИдентификаторов);
	
	Для Каждого СтрокаТаблицаИдентификаторов Из ТаблицаИдентификаторов Цикл
		ЗаполнитьЗначенияСвойств(ПоискГруппировкаМестоИнвентаризации, СтрокаТаблицаИдентификаторов);
		
		МассивСтрок = ТаблицаРаздела21.НайтиСтроки(ПоискГруппировкаМестоИнвентаризации);
		
		Для Каждого СтрокаТаблицаРаздел21 Из МассивСтрок Цикл
			ЗаполнитьПримечаниеВСтрокеРаздела21(СтрокаТаблицаРаздел21, ТаблицаДополнениеРаздела1, СтрокаТаблицаИдентификаторов);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьЦенуРаздела21(ТаблицаРаздела21)
	
	ТаблицаРаздела21.Колонки.Добавить("Цена", Новый ОписаниеТипов(Метаданные.Документы.ИнвентаризационнаяОписьНФА.ТабличныеЧасти.Раздел21.Реквизиты.Цена.Тип));
	
	Для Каждого СтрокаТаблицы Из ТаблицаРаздела21 Цикл
		СтрокаТаблицы.Цена = ?(СтрокаТаблицы.Количество <> 0,
			СтрокаТаблицы.Сумма / СтрокаТаблицы.Количество,
			0);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТаблицуИдентификаторовСтрокРаздела1(ТаблицаРаздел1, ТаблицаДополнениеРаздела1)
	
	ТаблицаИдентификаторов = Новый ТаблицаЗначений();
	ТаблицаИдентификаторов.Колонки.Добавить("НФА",							Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства,СправочникСсылка.Номенклатура"));
	ТаблицаИдентификаторов.Колонки.Добавить("ИнвентарныйНомер",			Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаИдентификаторов.Колонки.Добавить("МестоИнвентаризации");
	ТаблицаИдентификаторов.Колонки.Добавить("КоличествоИдентификаторов",	ОбщегоНазначения.ОписаниеТипаЧисло(3,0,ДопустимыйЗнак.Неотрицательный));
	ТаблицаИдентификаторов.Колонки.Добавить("МассивИдентификаторов",		Новый ОписаниеТипов("Массив"));
	
	ПоляГруппировкаТаблицаИдентификаторов = "НФА,ИнвентарныйНомер,МестоИнвентаризации";
	
	ТаблицаРаздел1.Индексы.Добавить("ИдентификаторСтроки");
	ТаблицаРаздел1.Индексы.Добавить(ПоляГруппировкаТаблицаИдентификаторов);
	
	ПоискИдентификаторСтроки = Новый Структура("ИдентификаторСтроки");
	
	ПоискГруппировкаМестоИнвентаризации = Новый Структура(ПоляГруппировкаТаблицаИдентификаторов);
	
	Для Каждого СтрокаТаблицыДополнения Из ТаблицаДополнениеРаздела1 Цикл
		ЗаполнитьЗначенияСвойств(ПоискИдентификаторСтроки, СтрокаТаблицыДополнения);
		
		МассивСтрокРаздел1 = ТаблицаРаздел1.НайтиСтроки(ПоискИдентификаторСтроки);
		
		Для Каждого СтрокаРаздела1 Из МассивСтрокРаздел1 Цикл
			ЗаполнитьЗначенияСвойств(ПоискГруппировкаМестоИнвентаризации, СтрокаРаздела1);
			
			МассивСтрокТаблицаИдентификаторов = ТаблицаИдентификаторов.НайтиСтроки(ПоискГруппировкаМестоИнвентаризации);
			
			Если МассивСтрокТаблицаИдентификаторов.Количество() = 0 Тогда
				СтрокаТаблицаИдентификаторов = ТаблицаИдентификаторов.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаТаблицаИдентификаторов, ПоискГруппировкаМестоИнвентаризации);
				
				СтрокаТаблицаИдентификаторов.МассивИдентификаторов = Новый Массив();
			Иначе
				СтрокаТаблицаИдентификаторов = МассивСтрокТаблицаИдентификаторов[0];
			КонецЕсли;
			
			ИдентификаторСтроки = СтрокаРаздела1.ИдентификаторСтроки;
			
			Если СтрокаТаблицаИдентификаторов.МассивИдентификаторов.Найти(ИдентификаторСтроки) = Неопределено Тогда
				СтрокаТаблицаИдентификаторов.МассивИдентификаторов.Добавить(ИдентификаторСтроки);
				
				СтрокаТаблицаИдентификаторов.КоличествоИдентификаторов = СтрокаТаблицаИдентификаторов.КоличествоИдентификаторов + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаИдентификаторов;
	
КонецФункции

Процедура ЗаполнитьПримечаниеВСтрокеРаздела21(СтрокаТаблицаРаздел21, ТаблицаДополнениеРаздела1, СтрокаТаблицаИдентификаторов)
	
	МассивТекстов = Новый Массив();
	
	Для Каждого ИдентификаторСтроки Из СтрокаТаблицаИдентификаторов.МассивИдентификаторов Цикл
		МассивТекстов.Добавить(ПолучитьТекстСообщенияОстаткиЗабаланс(ТаблицаДополнениеРаздела1, ИдентификаторСтроки));
	КонецЦикла;
	
	СтрокаТаблицаРаздел21.Примечание = СтрСоединить(МассивТекстов, "; ");
	
КонецПроцедуры

Функция ПолучитьТекстСообщенияОстаткиЗабаланс(ТаблицаДополнениеРаздела1, ИдентификаторСтроки, ДляФормыДокумента = Ложь) Экспорт
	
	Поиск = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	
	МассивСтрок = ТаблицаДополнениеРаздела1.НайтиСтроки(Поиск);
	
	КоличествоСтрок = МассивСтрок.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		ТекстСообщения = ?(ДляФормыДокумента,
			НСтр("ru='Не удалось найти ранее обнаруженные сведения об остатках этого основного средства на забалансовых счетах'"),
			"");
		
	Иначе
		ТекстСообщенияШаблон = ?(ДляФормыДокумента,
			НСтр("ru='Также обнаружены остатки по этому основному средству на забалансовом счете.
				|%1'"),
			НСтр("ru='%1'"));
		
		ТекстШаблонСДоговором = НСтр("ru='%1, %2, договор ""%3""'");
		ТекстШаблонБезДоговора = НСтр("ru='%1, %2'");
		
		ТекстШаблонСНомеромСтроки = НСтр("ru='%1. %2'");
		
		СимволПереносСтроки = "
			|";
		
		МассивТекстов = Новый Массив();
		
		НПП = 0;
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			НПП = НПП + 1;
			
			Если ЗначениеЗаполнено(Строка(СтрокаТаблицы.Договор)) Тогда
				Текст = СтрШаблон(ТекстШаблонСДоговором,
					Строка(СтрокаТаблицы.ВидРаспоряжения),
					Строка(СтрокаТаблицы.Контрагент),
					Строка(СтрокаТаблицы.Договор));
			Иначе
				Текст = СтрШаблон(ТекстШаблонБезДоговора,
					Строка(СтрокаТаблицы.ВидРаспоряжения),
					Строка(СтрокаТаблицы.Контрагент));
			КонецЕсли;
			
			Если КоличествоСтрок > 1 Тогда
				Текст = СтрШаблон(ТекстШаблонСНомеромСтроки, НПП, Текст);
			КонецЕсли;
			
			МассивТекстов.Добавить(Текст);
		КонецЦикла;
		
		ТекстСообщения = СтрШаблон(ТекстСообщенияШаблон, СтрСоединить(МассивТекстов, СимволПереносСтроки));
	КонецЕсли;
	
	Возврат ТекстСообщения;
	
КонецФункции

#КонецОбласти

#Область РазбивкаСтрокиРаздела2

Функция ПолучитьПустуюСтруктуруСтрокиРаздела2()
	
	Возврат Новый Структура("
		// Колонки табличной части
		|НомерСтроки,
		|ДобавленоВручную,
		|НФА,
		|ИнвентарныйНомер,
		|ТипНфаОС,
		|ЕдИзм,
		|МестоИнвентаризации,
		|Количество,
		|СтатусОбъекта,
		|ЦелеваяФункцияАктива,
		|Примечание,
		|Цена,
		|ИдентификаторСтроки");
		
КонецФункции

Функция ПолучитьФрагментыРазбитойСтроки(ТаблицаРаздела, ТекДанные)
	
	Поиск = Новый Структура("ИдентификаторСтроки", ТекДанные.ИдентификаторСтроки);
	
	ФрагментыСтроки = ТаблицаРаздела.Выгрузить(Поиск);
	
	ФрагментыСтроки.Сортировать("НомерСтроки");
	
	Возврат ФрагментыСтроки;
	
КонецФункции

Функция СобратьИсходнуюСтрокуРаздела2ПоФрагментам(ФрагментыСтроки)
	
	СтруктураИсходнойСтроки = ПолучитьПустуюСтруктуруСтрокиРаздела2();
	
	ЗаполнитьЗначенияСвойств(СтруктураИсходнойСтроки, ФрагментыСтроки[0]);
	
	СтруктураИсходнойСтроки.Количество = ФрагментыСтроки.Итог("Количество");
	
	Возврат СтруктураИсходнойСтроки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеКолонки

Процедура ЗаполнитьСлужебныеКолонкиСпискаНФА(ТаблЧасть)
	
	ТипОС = Тип("СправочникСсылка.ОсновныеСредства");
	
	ТипНоменклатура = Тип("СправочникСсылка.Номенклатура");
	
	Для Каждого СтрокаТаблицы Из ТаблЧасть Цикл
		СтрокаТаблицы.ТипНфаОС = (ТипЗнч(СтрокаТаблицы.НФА) = ТипОС);
		
		СтрокаТаблицы.ТипНфаНоменклатура = (ТипЗнч(СтрокаТаблицы.НФА) = ТипНоменклатура);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСлужебныеКолонкиРаздела1(ТаблЧасть, РезультатыДиагностикиРаздела)
	
	ТипОС = Тип("СправочникСсылка.ОсновныеСредства");
	
	ТипНоменклатура = Тип("СправочникСсылка.Номенклатура");
	
	ЕстьОшибкиУчета = Ложь;
	ЕстьПустыеМестаИнвентаризации = Ложь;
	ЕстьДопСведения = Ложь;
	ЕстьМестаИнвентаризацииЗаполненныеВручную = Ложь;
	
	Для Каждого СтрокаТаблицы Из ТаблЧасть Цикл
		СтрокаТаблицы.ТипНфаОС = (ТипЗнч(СтрокаТаблицы.НФА) = ТипОС);
		
		СтрокаТаблицы.ТипНфаНоменклатура = (ТипЗнч(СтрокаТаблицы.НФА) = ТипНоменклатура);
		
		СтрокаТаблицы.ЕстьДопСведения = ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторСтроки);
		
		СтрокаТаблицы.ОшибкаУчета = СтрокаТаблицы.Количество < 0 Или СтрокаТаблицы.Сумма < 0;
		
		Если СтрокаТаблицы.ОшибкаУчета Тогда
			ЕстьОшибкиУчета = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.МестоИнвентаризации) Тогда
			ЕстьПустыеМестаИнвентаризации = Истина;
		КонецЕсли;
		
		Если СтрокаТаблицы.ЕстьДопСведения Тогда
			ЕстьДопСведения = Истина;
		КонецЕсли;
		
		Если СтрокаТаблицы.МестоИнвентаризацииЗаполненоВручную Тогда
			ЕстьМестаИнвентаризацииЗаполненныеВручную = Истина;
		КонецЕсли;
	КонецЦикла;
	
	РезультатыДиагностикиРаздела.Вставить("ЕстьОшибкиУчета",							ЕстьОшибкиУчета);
	РезультатыДиагностикиРаздела.Вставить("ЕстьПустыеМестаИнвентаризации",				ЕстьПустыеМестаИнвентаризации);
	РезультатыДиагностикиРаздела.Вставить("ЕстьДопСведения",							ЕстьДопСведения);
	РезультатыДиагностикиРаздела.Вставить("ЕстьМестаИнвентаризацииЗаполненныеВручную",	ЕстьМестаИнвентаризацииЗаполненныеВручную);
	
КонецПроцедуры

