Процедура ЗаполнитьОбластьСтрокаТаблицы0510466_Раздел1(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("НомерСчета", ИнвентаризацияКлиентСервер.ПолучитьПолныйНомерСчета(
		Выборка.КПС, Выборка.КФО, Выборка.Счет,,, Выборка.СчетУчетПоКПС, Выборка.СчетУчетПоКЭК));
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	ЗаполнитьНаименованиеИНомерОбъекта(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры);
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей, "Раздел1");
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы0510466_Раздел2(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗаполнитьНаименованиеИНомерОбъекта(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.НомерПодразделаСтрокой = "1" Тогда
		Наименование = ?(ЗначениеЗаполнено(Выборка.СтатусОбъектаНаименованиеПолное),
			Выборка.СтатусОбъектаНаименованиеПолное,
			Выборка.СтатусОбъектаНаименование);
			
		ДополнительныеПараметры.СтруктураЗаполненияСтатусОбъекта.СтатусОбъекта =
			Справочники.СтатусыОбъектовДляИнвентаризации.ПолучитьПредставлениеЭлемента(
				Выборка.СтатусОбъектаКодДляОтчетности,
				Наименование);
				
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаТаблицы.Параметры, ДополнительныеПараметры.СтруктураЗаполненияСтатусОбъекта);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей, "Раздел21");
		
	ИначеЕсли ДополнительныеПараметры.НомерПодразделаСтрокой = "2" Тогда
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей, "Раздел22");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы0510466_Раздел3(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗаполнитьНаименованиеИНомерОбъекта(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.НаборКолонокСтрокой = "1" Тогда
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей, "Раздел3_НаборКолонок1");
		
	ИначеЕсли ДополнительныеПараметры.НаборКолонокСтрокой = "2" Тогда
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей, "Раздел3_НаборКолонок2");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы0510466_Раздел4(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	Если Не ДополнительныеПараметры.ВыявленыОтклонения Тогда
		ЗаполнитьНулямиСтрокуРаздела4(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры);
		
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаименованиеИНомерОбъекта(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры);
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей, "Раздел4");
	
КонецПроцедуры

Процедура ЗаполнитьНаименованиеИНомерОбъекта(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры)
	
	ЗаполнитьЗначенияСвойств(ДополнительныеПараметры.ПоискСвойствНФА, Выборка);
	
	МассивСтрок = ДополнительныеПараметры.ТаблицаСвойствНФА.НайтиСтроки(ДополнительныеПараметры.ПоискСвойствНФА);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СвойстваНФА = МассивСтрок[0];
	
	ДополнительныеПараметры.НаименованиеНомерОбъекта.НаименованиеОбъекта = СвойстваНФА.НаименованиеОбъекта;
	
	ДополнительныеПараметры.НаименованиеНомерОбъекта.НомерОбъекта = ПолучитьНомерОбъектаНФА(СвойстваНФА, Выборка, ДополнительныеПараметры);
	
	ЗаполнитьЗначенияСвойств(ОбластьСтрокаТаблицы.Параметры, ДополнительныеПараметры.НаименованиеНомерОбъекта);
	
КонецПроцедуры

Процедура ЗаполнитьНулямиСтрокуРаздела4(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры)
	
	ОчищающаяСтруктура = Новый Структура();
	ОчищающаяСтруктура.Вставить("КодСтроки",							"0");
	ОчищающаяСтруктура.Вставить("НаименованиеОбъекта",					"0");
	ОчищающаяСтруктура.Вставить("НомерОбъекта",							"0");
	ОчищающаяСтруктура.Вставить("МестоИнвентаризации",					"0");
	ОчищающаяСтруктура.Вставить("СтатусОбъяснения",						"0");
	ОчищающаяСтруктура.Вставить("НаименованиеЕдИзм",					"0");
	ОчищающаяСтруктура.Вставить("КодЕдИзм",								"0");
	ОчищающаяСтруктура.Вставить("КоличествоНедостачаНеПодтверждено",	"0");
	ОчищающаяСтруктура.Вставить("СуммаНедостачаНеПодтверждено",			"0");
