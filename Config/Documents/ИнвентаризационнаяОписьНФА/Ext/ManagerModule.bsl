#Область ПрограммныйИнтерфейс

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	ЕстьОшибки = Ложь;
	
	// К содержательным документам расписка не оформляется.
	// В содержательных документах серии не указывается состав комиссии.
	Если Не ИнвентаризацияКлиентСервер.ЭтоСодержательныйДокументСерииДокументовОписи(ДокументОбъект) Тогда
		ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ДокументОбъект, ЕстьОшибки);
		
		ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ДокументОбъект, ЕстьОшибки, "СоставКомиссииРаздел2", НСтр("ru='Состав комиссии для раздела 2'"));
		ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ДокументОбъект, ЕстьОшибки, "СоставКомиссииРаздел4", НСтр("ru='Состав комиссии для раздела 4'"));
		
		ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ДокументОбъект, ЕстьОшибки, "ОтветственныйИсполнитель", "СоставКомиссииРаздел2");
	КонецЕсли;
	
	// В заголовочных документах серии не заполняются разделы описи.
	Если Не ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(ДокументОбъект) Тогда
		Если ДокументОбъект.Раздел1.Количество() > 0 Тогда
			ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел21", ЕстьОшибки);
		КонецЕсли;
		
		ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел4", ЕстьОшибки);
	КонецЕсли;
	
	ПроверитьЗаполнениеРаздела21(ДокументОбъект, ЕстьОшибки);
	
	ПроверитьЗаполнениеРаздела22(ДокументОбъект, ЕстьОшибки);
	
	ПроверитьЗаполнениеРаздела3(ДокументОбъект, ЕстьОшибки);
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, ЕстьОшибки);
	
	Возврат ЕстьОшибки;
	
КонецФункции

Процедура ЗаполнитьСлужебныеКолонки(ФормаДокумента, Знач ИменаТабличныхЧастейСтрокой, РезультатыДиагностики = Неопределено) Экспорт
	
	МассивИменТЧ = СтрРазделить(ИменаТабличныхЧастейСтрокой, ", ", Ложь);
	
	РезультатыДиагностики = Новый Структура();
	
	Для Каждого ИмяТЧ Из МассивИменТЧ Цикл
		РезультатыДиагностики.Вставить(ИмяТЧ, Новый Структура());
	КонецЦикла;
	
	ДокументОбъект = ФормаДокумента.Объект;
	
	ИмяТЧ = "СписокНФА";
	Если МассивИменТЧ.Найти(ИмяТЧ) <> Неопределено Тогда
		ЗаполнитьСлужебныеКолонкиСпискаНФА(ДокументОбъект[ИмяТЧ]);
	КонецЕсли;
	
	ИмяТЧ = "Раздел1";
	Если МассивИменТЧ.Найти(ИмяТЧ) <> Неопределено Тогда
		ЗаполнитьСлужебныеКолонкиРаздела1(ДокументОбъект[ИмяТЧ], РезультатыДиагностики[ИмяТЧ]);
	КонецЕсли;
	
	ИмяТЧ = "Раздел21";
	Если МассивИменТЧ.Найти(ИмяТЧ) <> Неопределено Тогда
		ЗаполнитьСлужебныеКолонкиРаздела21(ДокументОбъект[ИмяТЧ], РезультатыДиагностики[ИмяТЧ]);
	КонецЕсли;
	
	ИмяТЧ = "Раздел22";
	Если МассивИменТЧ.Найти(ИмяТЧ) <> Неопределено Тогда
		ЗаполнитьСлужебныеКолонкиРаздела22(ДокументОбъект[ИмяТЧ], РезультатыДиагностики[ИмяТЧ]);
	КонецЕсли;
	
	ИмяТЧ = "Раздел3";
	Если МассивИменТЧ.Найти(ИмяТЧ) <> Неопределено Тогда
		ЗаполнитьСлужебныеКолонкиРаздела3(ДокументОбъект[ИмяТЧ]);
	КонецЕсли;
	
	ИмяТЧ = "Раздел4";
	Если МассивИменТЧ.Найти(ИмяТЧ) <> Неопределено Тогда
		ЗаполнитьСлужебныеКолонкиРаздела4(ДокументОбъект[ИмяТЧ]);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДанныеДляРаздела1(Знач ПараметрыФункции) Экспорт
	
	Данные = ПолучитьДанныеБухУчета(ПараметрыФункции);
	
	РасчетСерииДокументов = ИнвентаризацияСервер.РассчитатьСериюДокументов(Данные, ПараметрыФункции);
	
	Если РасчетСерииДокументов = Неопределено Тогда
		Возврат Данные;
	Иначе
		ИнвентаризацияСервер.СоздатьСериюДокументов(РасчетСерииДокументов, Данные, ПараметрыФункции);
		
		Возврат РасчетСерииДокументов;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанныеДляРаздела21(Знач ПараметрыФункции) Экспорт
	
	ПрочитатьПараметрыФункцииПоСсылке_ДанныеДляРаздела21(ПараметрыФункции);
	
	ТаблицаРаздела21 = ПараметрыФункции.СвернутаяТаблицаРаздел1;
	
	ЗаполнитьЦенуРаздела21(ТаблицаРаздела21);
	
	Если Не ПараметрыФункции.СКоличеством Тогда
		ТаблицаРаздела21.ЗаполнитьЗначения(0, "Количество");
	КонецЕсли;
	
	ЗаполнитьПримечаниеРаздела21(ТаблицаРаздела21, ПараметрыФункции);
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаРаздела21", ТаблицаРаздела21);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеДляРаздела22(Знач ПараметрыФункции) Экспорт
	
	ПрочитатьПараметрыФункцииПоСсылке_ДанныеДляРаздела22(ПараметрыФункции);
	
	ТаблицаРаздела22 = РассчитатьОтклоненияРазделов1и21(
		ПараметрыФункции.СвернутаяТаблицаРаздел1,
		ПараметрыФункции.СвернутаяТаблицаРаздел21);
		
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаРаздела22", ТаблицаРаздела22);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеДляРаздела3(Знач ПараметрыФункции) Экспорт
	
	ПрочитатьПараметрыФункцииПоСсылке_ДанныеДляРаздела3(ПараметрыФункции);
	
	ТаблицаРаздела3 = ПараметрыФункции.ТаблицаРаздела3;
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаРаздела3", ТаблицаРаздела3);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеДляРаздела4(Знач ПараметрыФункции) Экспорт
	
	ПрочитатьПараметрыФункцииПоСсылке_ДанныеДляРаздела4(ПараметрыФункции);
	
	ТаблицаРаздела4 = ПараметрыФункции.ТаблицаРаздела4;
	
	ИнвентаризацияСервер.ДобавитьКолонкиДоПолногоСоставаТабличнойЧасти(ТаблицаРаздела4,
		Метаданные.Документы.ИнвентаризационнаяОписьНФА.ТабличныеЧасти.Раздел4);
	
	ИнвентаризацияСервер.ЗаполнитьСтатусОбъясненияНеТребуется(ТаблицаРаздела4, ПараметрыФункции.Ссылка);
	
	ВыявленыОтклонения = (ТаблицаРаздела4.Количество() > 0);
	
	Если Не ВыявленыОтклонения Тогда
		// В случае если по итогам инвентаризации не выявлены недостачи (излишки) объектов инвентаризации,
		// а также инвентаризационной комиссией не установлены объекты инвентаризации,
		// имеющие признаки несоответствия условиям актива или обесценения,
		// общий результат инвентаризации нефинансовых активов отражается в Разделе 4 в одной строке,
		// в которой по графам 1 - 14 проставляются нули, в графе 15 отражается заключение инвентаризационной комиссии "Отклонения не выявлены"
		
		ТаблицаРаздела4 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(Метаданные.Документы.ИнвентаризационнаяОписьНФА.ТабличныеЧасти.Раздел4);
		
		НоваяСтрока = ТаблицаРаздела4.Добавить();
		
		НоваяСтрока.ЗаключениеКомиссии = ИнвентаризацияСервер.ПолучитьТекстЗаключенияКомиссииОтклоненияНеВыявлены(ПараметрыФункции.Ссылка);
		НоваяСтрока.СтатусОбъяснения = Перечисления.СтатусыОбъясненияОтветственногоЛица.НеТребуется;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаРаздела4", ТаблицаРаздела4);
	Результат.Вставить("ВыявленыОтклонения", ВыявленыОтклонения);
	
	Возврат Результат;
	
КонецФункции

Функция ДополнитьПараметрыФормыПодбораОстатковОС(ПараметрыФормы, ДокументОбъект) Экспорт
	
	НаДату = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(ДокументОбъект.ДатаИнвентаризации);
	
	// Стандартные параметры формы, ожидаемые формой подбора.
	
	ПараметрыФормы.Вставить("ВидРаспоряжения", "ИнвентаризационнаяОписьНФА");
	ПараметрыФормы.Вставить("Период", НаДату);
	
	// Специальные параметры формы конкретно для описи НФА.
	
	СпискиОтбора = ПолучитьСпискиОтбораДляФормыПодбораОстатковНФА(ДокументОбъект, "ОсновныеСредства");
	
	СписокСчетов	= СпискиОтбора.МассивДетальныхСчетов;
	СписокКФО		= СпискиОтбора.МассивКФО;
	СписокЦМО		= СпискиОтбора.МассивЦМО;
	
	Если СписокСчетов.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru='Подбор основных средств отменен.
			|В документе описи отсутствуют счета учета основных средств.'");
	КонецЕсли;
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	СписокПодразделений = Новый Массив();
	СписокПодразделений.Добавить(ДокументОбъект.Подразделение);
	
	СписокИФО = Новый Массив();
	СписокИФО.Добавить(ДокументОбъект.ИФО);
	
	ВидыСубконтоОсновныеСредстваЦМО = Новый Массив();
	ВидыСубконтоОсновныеСредстваЦМО.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконтоОсновныеСредстваЦМО.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	ТаблицаВидыРаспоряженияОС = ПолучитьТаблицуВидовРаспоряженияОССсылкиСчетовДляФормыПодбораОС(НаДату, СписокСчетов);
	
	ОписаниеВременнойТаблицыВидовРаспоряженияОС = ПолучитьОписаниеВременнойТаблицыДляДинамическогоСписка(ТаблицаВидыРаспоряженияОС, "ТаблицаВидыРаспоряженияОС");
	
	Счета10600 = ПолучитьСчета10600(НаДату);
	
	ПараметрыФормы.Вставить("Счета10600",									Счета10600);
	ПараметрыФормы.Вставить("ОписаниеВременнойТаблицыВидовРаспоряженияОС",	ОписаниеВременнойТаблицыВидовРаспоряженияОС);
	ПараметрыФормы.Вставить("ВидыСубконтоОсновныеСредстваЦМО",				ВидыСубконтоОсновныеСредстваЦМО);
	ПараметрыФормы.Вставить("ВидыРаспоряженияОСПереданныеОбъекты",			ПолучитьВидыРаспоряженияОСПереданныеОбъекты());
	ПараметрыФормы.Вставить("ВидыРаспоряженияОСРегистрСтоимостьОбъектовОС",	ПолучитьВидыРаспоряженияОСРегистрСтоимостьОбъектовОС());
	
	ПараметрыФормы.Отбор.Вставить("СписокСчетов",			СписокСчетов);
	ПараметрыФормы.Отбор.Вставить("МассивСчетовОписи",		СпискиОтбора.МассивСчетовОписи);
	ПараметрыФормы.Отбор.Вставить("СписокКФО",				СписокКФО);
	ПараметрыФормы.Отбор.Вставить("СписокЦМО",				СписокЦМО);
	ПараметрыФормы.Отбор.Вставить("СписокИФО",				СписокИФО);
	ПараметрыФормы.Отбор.Вставить("СписокПодразделений",	СписокПодразделений);
	
	ПараметрыФормы.Вставить("ИспользоватьОтборПоКФО",				СписокКФО.Количество() > 0);
	ПараметрыФормы.Вставить("ИспользоватьУчетПоИФО",				ИспользоватьУчетПоИФО);
	ПараметрыФормы.Вставить("ИспользоватьОтборПоИФО",				ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ДокументОбъект.ИФО));
	ПараметрыФормы.Вставить("ИспользоватьУчетПоПодразделениям",		ИспользоватьУчетПоПодразделениям);
	ПараметрыФормы.Вставить("ИспользоватьОтборПоПодразделению",		ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(ДокументОбъект.Подразделение));
	
	Если ДокументОбъект.СписокНФА.Количество() > 0 Тогда
		// Предзаполнение корзины временно отключено.
		//ПараметрыФормы.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецФункции

Функция ДополнитьПараметрыФормыПодбораОстатковМЗ(ПараметрыФормы, ДокументОбъект) Экспорт
	
	// Обработка.ПодборНоменклатуры.Форма.ФормаПодбора
	
	// Здесь передаем дату иначе, потому что на форме подбора МЗ
	// дата остатков определяется как НачалоДня(ДатаРасчетов)
	ПараметрыФормы.Вставить("ДатаРасчетов", ДокументОбъект.ДатаИнвентаризации);
	
	СпискиОтбора = ПолучитьСпискиОтбораДляФормыПодбораОстатковНФА(ДокументОбъект, "Номенклатура");
	
	МассивСчетов	= СпискиОтбора.МассивСчетовОписи;
	МассивКФО		= СпискиОтбора.МассивКФО;
	МассивЦМО		= СпискиОтбора.МассивЦМО;
	
	Если МассивСчетов.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru='Подбор номенклатуры отменен.
			|В документе описи отсутствуют счета учета номенклатуры.'");
	КонецЕсли;
	
	СписокСчетов = Новый СписокЗначений();
	СписокСчетов.ЗагрузитьЗначения(МассивСчетов);
	
	СписокКФО = Новый СписокЗначений();
	СписокКФО.ЗагрузитьЗначения(МассивКФО);
	
	СписокЦМО = Новый СписокЗначений();
	СписокЦМО.ЗагрузитьЗначения(МассивЦМО);
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	ПараметрыФормы.Вставить("СчетУчета", СписокСчетов);
	
	ПараметрыФормы.Вставить("ЦМО", СписокЦМО);
	
	Если СписокКФО.Количество() > 0 Тогда
		ПараметрыФормы.Вставить("КФО", СписокКФО);
	КонецЕсли;
	
	Если ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		ПараметрыФормы.Вставить("ИФО", ДокументОбъект.ИФО);
	КонецЕсли;
	
	Если ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(ДокументОбъект.Подразделение) Тогда
		ПараметрыФормы.Вставить("Подразделение", ДокументОбъект.Подразделение);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ПоказыватьОстатки",	Истина);
	ПараметрыФормы.Вставить("ПоказыватьСчетУчета",	Истина);
	ПараметрыФормы.Вставить("ИмяТаблицы",			"Раздел1"); // для определения в форме подбора наличия колонок КФО, КПС
	
	ДобавитьТипыНоменклатурыДляПодбораОстатковМЗ(ПараметрыФормы);
	
КонецФункции

Процедура ПроверитьПередЗаполнениемРаздела1(Знач ДокументОбъект, Отказ) Экспорт
	
	Отказ = Ложь;
	
	ИменаРеквизитов = Новый Массив();
	ИменаРеквизитов.Добавить("РешениеОПроведенииИнвентаризации");
	ИменаРеквизитов.Добавить("Организация");
	ИменаРеквизитов.Добавить("ДатаНачала");
	ИменаРеквизитов.Добавить("ДатаОкончания");
	ИменаРеквизитов.Добавить("ДатаИнвентаризации");
	ИменаРеквизитов.Добавить("МОЛ");
	ИменаРеквизитов.Добавить("Комиссия");
	ИменаРеквизитов.Добавить("ОтветственныйИсполнительБухгалтерскойСлужбы");
	ИменаРеквизитов.Добавить("ОтветственныйИсполнитель");
	
	ИнвентаризацияСервер.ПроверитьЗаполненностьРеквизитовШапки(ДокументОбъект, ИменаРеквизитов, Отказ);
	
	ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "СписокСчетов", Отказ);
	ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "МестаИнвентаризации", Отказ);
	
	Если ДокументОбъект.ЭтоВыборочнаяИнвентаризация Тогда
		ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "СписокНФА", Отказ,
			НСтр("ru='При выборочной инвентаризации должен быть указан список НФА'"));
		
		Если Не ПроверитьОтсутствиеДублейСтрок(ДокументОбъект, "СписокНФА") Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ДокументОбъект, Отказ);
	
	ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ДокументОбъект, Отказ, "ОтветственныйИсполнитель", "СоставКомиссииРаздел2");
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, Отказ);
	
КонецПроцедуры

Процедура ПроверитьПередЗаполнениемРаздела21(Знач ДокументОбъект, Отказ) Экспорт
	
	Отказ = Ложь;
	
	Если Не ПроверитьЗаполнениеМестаИнвентаризации(ДокументОбъект, "Раздел1") Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПередЗаполнениемРаздела22(Знач ДокументОбъект, Отказ) Экспорт
	
	Отказ = Ложь;
	
	Если ДокументОбъект.Раздел1.Количество() > 0 Тогда
		ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел21", Отказ);
	КонецЕсли;
	
	ИмяТЧ = "Раздел21";
	
	СинонимТЧ = Метаданные.Документы.ИнвентаризационнаяОписьНФА.ТабличныеЧасти[ИмяТЧ].Синоним;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТЧ] Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НФА) Тогда
			Отказ = Истина;
			
			ОбщегоНазначения.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение", НСтр("ru='НФА'"), СтрокаТаблицы.НомерСтроки, СинонимТЧ),
				ДокументОбъект.Ссылка,
				"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧ, СтрокаТаблицы.НомерСтроки, "НФА"));
				
			Возврат;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.МестоИнвентаризации) Тогда
			Отказ = Истина;
			
			ОбщегоНазначения.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение", НСтр("ru='Место инвентаризации'"), СтрокаТаблицы.НомерСтроки, СинонимТЧ),
				ДокументОбъект.Ссылка,
				"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧ, СтрокаТаблицы.НомерСтроки, "МестоИнвентаризации"));
				
			Возврат;
		КонецЕсли;
		
		Если СтрокаТаблицы.ДобавленоВручную И Не ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			Отказ = Истина;
			
			ОбщегоНазначения.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение", НСтр("ru='Количество'"), СтрокаТаблицы.НомерСтроки, СинонимТЧ),
				ДокументОбъект.Ссылка,
				"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧ, СтрокаТаблицы.НомерСтроки, "Количество"));
				
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПроверитьОтсутствиеДублейСтрок(ДокументОбъект, "Раздел21") Тогда
		Отказ = Истина;
		
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПередЗаполнениемРаздела4(Знач ДокументОбъект, Отказ) Экспорт
	
	Если ДокументОбъект.Раздел1.Количество() > 0 Тогда
		ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел21", Отказ);
	КонецЕсли;
	
	ПроверитьЗаполнениеРаздела21(ДокументОбъект, Отказ, Истина);
	
	ПроверитьЗаполнениеРаздела22(ДокументОбъект, Отказ);
	
	ПроверитьЗаполнениеРаздела3(ДокументОбъект, Отказ, Истина);
	
КонецПроцедуры

Функция ПолучитьПараметрыФормыРазбивкиСтрокиРаздела2(ДокументОбъект, ИмяТЧ, ТекДанные) Экспорт
	
	Если ЗначениеЗаполнено(ТекДанные.ИдентификаторСтроки) Тогда
		ФрагментыСтроки = ПолучитьФрагментыРазбитойСтроки(ДокументОбъект[ИмяТЧ], ТекДанные);
		
		ИсходнаяСтрока = СобратьИсходнуюСтрокуРаздела2ПоФрагментам(ФрагментыСтроки);
		
		ФрагментыСтроки = ОбщегоНазначения.ТаблицаЗначенийВМассив(ФрагментыСтроки);
	Иначе
		ФрагментыСтроки = Неопределено;
		
		ИсходнаяСтрока = ПолучитьПустуюСтруктуруСтрокиРаздела2();
		
		ЗаполнитьЗначенияСвойств(ИсходнаяСтрока, ТекДанные);
	КонецЕсли;
	
	ПараметрыФормыРазбивки = Новый Структура();
	ПараметрыФормыРазбивки.Вставить("ОписьСсылка", ДокументОбъект.Ссылка);
	ПараметрыФормыРазбивки.Вставить("ИсходнаяСтрока", ИсходнаяСтрока);
	ПараметрыФормыРазбивки.Вставить("ФрагментыСтроки", ФрагментыСтроки);
	
	Возврат ПараметрыФормыРазбивки;
	
КонецФункции

Функция ПолучитьСведенияДляВыгрузкиВТСД(Знач ФормаДокумента, ЕстьОСБезШтрихкода, ДляСозданияШтрихкодов = Ложь) Экспорт
	
	ТаблицаСведений = ПрочитатьСведенияДляВыгрузкиВТСД(ФормаДокумента.Объект);
	
	Если ДляСозданияШтрихкодов Тогда
		ТаблицаСведений.Колонки.НФА.Имя = "ОсновноеСредство";
		
		Возврат ПоместитьВоВременноеХранилище(ТаблицаСведений, ФормаДокумента.УникальныйИдентификатор);
	КонецЕсли;
	
	МассивТСД = Новый Массив();
	
	ОСБезШтрихкода = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСведений Цикл
		
		Если ПустаяСтрока(СтрокаТаблицы.Штрихкод) Тогда
			
			ОСБезШтрихкода.Добавить(Новый Структура("Объект, ИнвентарныйНомер", 
													СтрокаТаблицы.НФАНаименование, 
													СтрокаТаблицы.ИнвентарныйНомерКод));
			
		Иначе
			
			НоваяСтрока = Новый Структура("Штрихкод, Номенклатура", 
										  СтрокаТаблицы.Штрихкод, 
										  СокрЛП(СтрокаТаблицы.НФАНаименование) + 
										  ?(ПустаяСтрока(СтрокаТаблицы.ИнвентарныйНомерКод), 
										  	"", 
											" инв:" + СокрЛП(СтрокаТаблицы.ИнвентарныйНомерКод)));
			МассивТСД.Добавить(НоваяСтрока);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЕстьОСБезШтрихкода = (ОСБезШтрихкода.Количество() > 0);
	
	Возврат ПоместитьВоВременноеХранилище(МассивТСД, ФормаДокумента.УникальныйИдентификатор);
	
КонецФункции

Процедура ЗагрузитьДанныеИзТСД(ДокументОбъект, Знач МассивТСД) Экспорт
	
	ТаблицаТСД = ПреобразоватьВТаблицуТСД(МассивТСД);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ТаблицаТСД", ТаблицаТСД);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	ТаблицаТСД.Штрихкод		КАК Штрихкод,
	|	ТаблицаТСД.Количество	КАК Количество
	|ПОМЕСТИТЬ
	|	ТаблицаТСД
	|ИЗ
	|	&ТаблицаТСД КАК ТаблицаТСД
	|ИНДЕКСИРОВАТЬ ПО
	|	Штрихкод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ШтрихКоды.Объект, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка))				КАК НФА,
	|	ЕСТЬNULL(ШтрихКоды.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))	КАК ИнвентарныйНомер,
	|	СУММА(ТаблицаТСД.Количество)																КАК Количество
	|ИЗ
	|	ТаблицаТСД КАК ТаблицаТСД
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК ШтрихКоды
	|		ПО ТаблицаТСД.Штрихкод = ШтрихКоды.Штрихкод
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТСД.Штрихкод,
	|	ЕСТЬNULL(ШтрихКоды.Объект, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)),
	|	ЕСТЬNULL(ШтрихКоды.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))";
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаНФА = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	СтруктураЗаполнения = Новый Структура();
	СтруктураЗаполнения.Вставить("ДобавленоВручную",	Истина);
	СтруктураЗаполнения.Вставить("ТипНфаОС",			Истина);
	СтруктураЗаполнения.Вставить("ТипНфаНоменклатура",	Ложь);
	СтруктураЗаполнения.Вставить("ЕдИзм",				Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	
	Если ДокументОбъект.МестаИнвентаризации.Количество() = 1 Тогда
		СтруктураЗаполнения.Вставить("МестоИнвентаризации", ДокументОбъект.МестаИнвентаризации[0].МестоИнвентаризации);
	КонецЕсли;
	
	Поиск = Новый Структура("НФА,ИнвентарныйНомер");
	
	Раздел21 = ДокументОбъект.Раздел21;
	
	Для Каждого СтрокаТаблицыНФА Из ТаблицаНФА Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицыНФА);
		
		МассивСтрок = Раздел21.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			НоваяСтрока = Раздел21.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Поиск);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураЗаполнения);
			
			НоваяСтрока.Количество = СтрокаТаблицыНФА.Количество;
		Иначе
			Счетчик = 1;
			
			Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
				Если Счетчик = 1 Тогда
					СтрокаТаблицы.Количество = СтрокаТаблицыНФА.Количество;
				Иначе
					СтрокаТаблицы.Количество = 0;
				КонецЕсли;
				
				Счетчик = Счетчик + 1;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДополнениеРаздела1СодержательногоДокумента(СодержательныйДокумент, Данные) Экспорт
	
	ОбщееДополнениеРаздела1 = Данные.ДополнениеРаздела1;
	ОбщееДополнениеРаздела1.Индексы.Добавить("ИдентификаторСтроки");
	
	ВремТаблица = СодержательныйДокумент.Раздел1.Выгрузить(, "ИдентификаторСтроки");
	ВремТаблица.Свернуть("ИдентификаторСтроки");
	
	Поиск = Новый Структура("ИдентификаторСтроки");
	
	ДополнениеРаздела1 = ОбщееДополнениеРаздела1.СкопироватьКолонки();
	
	Для Каждого СтрокаТаблицыИдентификаторов Из ВремТаблица Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицыИдентификаторов);
		
		МассивСтрок = ОбщееДополнениеРаздела1.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			НоваяСтрока = ДополнениеРаздела1.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		КонецЦикла;
	КонецЦикла;
	
	СодержательныйДокумент.ДополнениеРаздела1.Загрузить(ДополнениеРаздела1);
	
КонецПроцедуры

Процедура УдалитьНесопоставленныеСтрокиТаблицыДополненияРаздела1(ТаблицаДополнения) Экспорт
	
	Поиск = Новый Структура("ИдентификаторСтроки", "");
	
	МассивСтрокДополнения = ТаблицаДополнения.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицыДополнения Из МассивСтрокДополнения Цикл
		ТаблицаДополнения.Удалить(СтрокаТаблицыДополнения);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИсключаемыеТипыНоменклатуры() Экспорт
	
	ИсключаемыеТипыНоменклатуры = Новый Массив();
	// Разрешено включение БСО в опись 0510466 до появления возможности их отражения в описи 0510465.
	//ИсключаемыеТипыНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.БСО);
	
	Возврат ИсключаемыеТипыНоменклатуры;
	
КонецФункции

Функция КлассифицироватьНФАДляОпределенияКодаОбъекта(МассивОбъектов) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок",	МассивОбъектов);
	ЗапросПоиск.УстановитьПараметр("Счета11160",	БухгалтерскийУчет.СписокСчетов("111.60"));
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Классификация НФА по счетам остатков
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка	КАК Ссылка,
	|	НФА		КАК НФА
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьНФА.Раздел1
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|	И Счет В(&Счета11160)";
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаКлассификацииНФА = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаКлассификацииНФА.Индексы.Добавить("Ссылка,НФА");
	
	Возврат ТаблицаКлассификацииНФА;
	
КонецФункции

Функция ПолучитьКадастровыеНомераОС(Знач ТаблицаСвойствНФА, Знач ТаблицаШапок) Экспорт
	
	ТаблицаОтбора = ПолучитьТаблицуОтбораДляПоискаКадастровыхНомеровОС(ТаблицаСвойствНФА, ТаблицаШапок);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ТаблицаОтбора", ТаблицаОтбора);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Таблица отбора
	|//
	|ВЫБРАТЬ
	|	ТЗ.Организация			КАК Организация,
	|	ТЗ.ДатаИнвентаризации	КАК ДатаИнвентаризации,
	|	ТЗ.НФА					КАК НФА
	|ПОМЕСТИТЬ
	|	ТаблицаОтбора
	|ИЗ
	|	&ТаблицаОтбора КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Кадастровые номера ОС
	|//
	|ВЫБРАТЬ
	|	ТаблицаОтбора.Организация									КАК Организация,
	|	ТаблицаОтбора.ДатаИнвентаризации							КАК ДатаИнвентаризации,
	|	СведенияКадастровогоУчета.ОсновноеСредство					КАК ОсновноеСредство,
	|	СведенияКадастровогоУчета.ИнвентарныйНомер					КАК ИнвентарныйНомер,
	|	СведенияКадастровогоУчета.КадастровыйНомер					КАК КадастровыйНомер,
	|	СведенияКадастровогоУчета.КадастровыйНомерЗемлиНедвижимости	КАК КадастровыйНомерЗемлиНедвижимости,
	|	СведенияКадастровогоУчета.КадастровыйНомерЗдания			КАК КадастровыйНомерЗдания,
	|	СведенияКадастровогоУчета.УсловныйНомер						КАК УсловныйНомер
	|ИЗ                          
	|	ТаблицаОтбора
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СведенияКадастровогоУчета КАК СведенияКадастровогоУчета
	|		ПО	ТаблицаОтбора.Организация = СведенияКадастровогоУчета.Организация
	|		И	СведенияКадастровогоУчета.Период В
	|			(ВЫБРАТЬ
	|				МАКСИМУМ(Период)
	|			ИЗ
	|				РегистрСведений.СведенияКадастровогоУчета КАК ВыборПериода
	|			ГДЕ
	|				ВыборПериода.Организация = ТаблицаОтбора.Организация
	|				И ВыборПериода.ОсновноеСредство = ТаблицаОтбора.НФА
	|				И ВыборПериода.Период <= ТаблицаОтбора.ДатаИнвентаризации)";
	
	УстановитьПривилегированныйРежим(Истина);
	КадастровыеНомераОС = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	КадастровыеНомераОС.Индексы.Добавить("Организация,ДатаИнвентаризации,ОсновноеСредство");
	КадастровыеНомераОС.Индексы.Добавить("Организация,ДатаИнвентаризации,ОсновноеСредство,ИнвентарныйНомер");
	
	Возврат КадастровыеНомераОС;
	
КонецФункции

Функция ПолучитьНомерОбъектаНФА(СвойстваНФА, Выборка, ДополнительныеПараметры) Экспорт
	
	Если СвойстваНФА.ТипНфаОС Тогда
		// Основное средство
		
		ЗаполнитьЗначенияСвойств(ДополнительныеПараметры.ПоискКлассификацииНФАДляОпределенияКодаОбъекта, Выборка, "Ссылка,НФА");
		
		МассивСтрок = ДополнительныеПараметры.ТаблицаКлассификацииНФАДляОпределенияКодаОбъекта.НайтиСтроки(ДополнительныеПараметры.ПоискКлассификацииНФАДляОпределенияКодаОбъекта);
		
		Если МассивСтрок.Количество() > 0 Тогда
			// Для объектов права пользования нематериальными активами, учтенных на счете
			// 011160000 "Права пользования нематериальными активами" в графе 3 отражается
			// инвентарный номер объекта и номер лицензии, указываемые через разделитель "//".
			
			Возврат СтрШаблон("%1//%2", СокрЛП(СвойстваНФА.ИнвентарныйНомерКод), СокрЛП(СвойстваНФА.ИнвентарныйНомерЗаводскойНомер));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СвойстваНФА.ИнвентарныйНомерКод) Тогда
			Возврат СокрЛП(СвойстваНФА.ИнвентарныйНомерКод);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СвойстваНФА.ОсновноеСредствоНоменклатурныйНомер) Тогда
			Возврат СокрЛП(СвойстваНФА.ОсновноеСредствоНоменклатурныйНомер);
		КонецЕсли;
		
		КадастровыйНомерОС = ПолучитьКадастровыйНомерОС(СвойстваНФА, Выборка, ДополнительныеПараметры);
		
		Если ЗначениеЗаполнено(КадастровыйНомерОС) Тогда
			Возврат КадастровыйНомерОС;
			
		ИначеЕсли ЗначениеЗаполнено(СвойстваНФА.ИнвентарныйНомерРеестровыйНомер) Тогда
			Возврат СокрЛП(СвойстваНФА.ИнвентарныйНомерРеестровыйНомер);
			
		ИначеЕсли ЗначениеЗаполнено(СвойстваНФА.ИнвентарныйНомерИнойНомер) Тогда
			Возврат СокрЛП(СвойстваНФА.ИнвентарныйНомерИнойНомер);
			
		ИначеЕсли ЗначениеЗаполнено(СвойстваНФА.ОсновноеСредствоКод) Тогда
			Возврат СокрЛП(СвойстваНФА.ОсновноеСредствоКод);
		КонецЕсли;
		
	Иначе
		// Номенклатура
		Если ЗначениеЗаполнено(СвойстваНФА.НоменклатураНоменклатурныйНомер) Тогда
			Возврат СокрЛП(СвойстваНФА.НоменклатураНоменклатурныйНомер);
			
		ИначеЕсли ЗначениеЗаполнено(СвойстваНФА.НоменклатураКод) Тогда
			Возврат СокрЛП(СвойстваНФА.НоменклатураКод);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#Область ПроверкаНаличияОтклоненийПередДобавлениемВРаздел22

// Рассчитывает отклонения по выделенным строкам раздела 2.1 и соответствующим им строкам раздела 1
// за исключением уже имеющихся отклонений в разделе 2.2 по такой же аналитике.
//
// Параметры:
//	ДокументОбъект - ДанныеФормыСтруктура - объект описи из формы документа.
//	ВыделенныеСтрокиРаздела21 - Массив - выделенные строки раздела 2.1 на форме документа описи.
//
// Возвращаемое значение:
//	Структура - см. функцию НовыйРезультатПоискаНеучтенныхОтклоненийРазделов1и21ПоСпискуНФА().
Функция НайтиНеучтенныеОтклоненияРазделов1и21ПоСпискуНФА(ДокументОбъект, ВыделенныеСтрокиРаздела21) Экспорт
	
	Перем КоличествоРазличныхКодовСтрок;
	
	Таблицы = ПолучитьТаблицыДляРасчетаОтклоненийПоСпискуНФА(ДокументОбъект, ВыделенныеСтрокиРаздела21);
	
	ТаблицаОтклонений = РассчитатьОтклоненияРазделов1и21(
		Таблицы.СвернутаяТаблицаРаздел1,
		Таблицы.СвернутаяТаблицаРаздел21);
		
	УдалитьУчтенныеОтклоненияПоСпискуНФА(ТаблицаОтклонений, ДокументОбъект);
	
	РезультатПоиска = НовыйРезультатПоискаНеучтенныхОтклоненийРазделов1и21ПоСпискуНФА();
	РезультатПоиска.ЕстьНеучтенныеОтклонения		= (ТаблицаОтклонений.Количество() > 0);
	РезультатПоиска.КоличествоСтрок					= ТаблицаОтклонений.Количество();
	РезультатПоиска.КодыСтрокСтрокой				= ПолучитьКодыСтрокСтрокойНеучтенныеОтклоненияПоСпискуНФА(
		ТаблицаОтклонений,, КоличествоРазличныхКодовСтрок);
	РезультатПоиска.КоличествоРазличныхКодовСтрок	= КоличествоРазличныхКодовСтрок;
	
	Возврат РезультатПоиска;
	
КонецФункции

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Действия обработчика обновления:
	// Заменить пустой статус объяснения на значение "0" в подходящих строках раздела 4.
	
	Запрос = Новый Запрос();
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьНФА.Раздел4 КАК ТЧРаздел4
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИнвентаризационнаяОписьНФА КАК Док
	|		ПО ТЧРаздел4.Ссылка = Док.Ссылка
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|	И ТЧРаздел4.СтатусОбъяснения = ЗНАЧЕНИЕ(Перечисление.СтатусыОбъясненияОтветственногоЛица.ПустаяСсылка)
	|	// Текущие условия применения статуса ""0"" из релиза на момент обновления.
	|	// Отличаются от условий в обновлении.
	|	И ТЧРаздел4.КоличествоНедостачаНеПодтверждено = 0 И ТЧРаздел4.КоличествоИзлишкиНеПодтверждено = 0";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Параллельный отложенный обработчик обновления
	
	// Действия обработчика обновления:
	// Заменить пустой статус объяснения на значение "0" в подходящих строках раздела 4.
	
	МетаданныеОбъекта = Метаданные.Документы.ИнвентаризационнаяОписьНФА;
	
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта, МенеджерВременныхТаблиц, ДополнительныеПараметры);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 500
	|	ВТДляОбработки.Ссылка КАК Ссылка
	|ИЗ
	|	ВТДляОбработки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Если Выборка.Количество() = 0 Тогда
		Параметры.ОбработкаЗавершена = Истина;
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Обработчик обновления завершил обработку объектов %1'"),
			ПолноеИмяОбъекта);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
			
		Возврат;
	КонецЕсли;
	
	ПроблемныхОбъектов = 0;
	ОбъектовОбработано = 0;
	ПлохиеДанные = Новый Соответствие;
	
	СтатусОбъяснениеНеТребуется = Перечисления.СтатусыОбъясненияОтветственногоЛица.НеТребуется;
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			ДокументСсылка = Выборка.Ссылка;
			
			Блокировка = Новый БлокировкаДанных();
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ДокументСсылка);
			Блокировка.Заблокировать();
			
			ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
			
			Для Каждого СтрокаТаблицы Из ДокументОбъект.Раздел4 Цикл
				Если Не ЗначениеЗаполнено(СтрокаТаблицы.СтатусОбъяснения)
					// Текущие условия применения статуса "0" из релиза на момент обновления.
					// Отличаются от условий в обновлении.
					И СтрокаТаблицы.КоличествоНедостачаНеПодтверждено = 0 И СтрокаТаблицы.КоличествоИзлишкиНеПодтверждено = 0 Тогда
					
					СтрокаТаблицы.СтатусОбъяснения = СтатусОбъяснениеНеТребуется;
				КонецЕсли;
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			
			ОбъектовОбработано = ОбъектовОбработано + 1;
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Не удалось установить наименование объекта %1 по причине %2'"),
				ПолноеИмяОбъекта,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеОбъекта,
				ДокументСсылка,
				ТекстСообщения);
		КонецПопытки;
	
	КонецЦикла;
	
	Для Каждого НеобработанныйОбъект Из ПлохиеДанные Цикл
		ОбновлениеИнформационнойБазы.ЗарегистрироватьПроблемуСДанными(НеобработанныйОбъект.Ключ, НеобработанныйОбъект.Значение);
	КонецЦикла;
	
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Не удалось обработать всю очередную порцию объектов %1 (пропущены): %2 шт.'"),
			ПолноеИмяОбъекта,
			ПроблемныхОбъектов);
			
		ВызватьИсключение ТекстСообщения;
	Иначе
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Обработана очередная порция объектов %1: %2 шт.'"),
			ПолноеИмяОбъекта,
			ОбъектовОбработано);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
	КонецЕсли;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеУчетныхДокументовПоОтклонениям

// Выполняет запрос на получение данных из документов "Инвентаризационная опись НФА" ф.0510466,
// для цели ввода учетных документов по отклонениям. Данные получаются с учетом уже отработанных отклонений.
// Данные можно получать по массиву документов инвентаризации.
// Запрос формирует временную таблицу "ДанныеДокументаИнвентаризации" в менеджере временных таблиц
// Запрос выполняется в привилегированном режиме
//
// Параметры:
//  Запрос - Запрос - объект запрос
//  Инвентаризация - ДокументСсылка.ИнвентаризационнаяОписьНФА ИЛИ Массив - документ или документы инвентаризации,
//                   из которых собираются данные                                          
//  УчетныйДокументСсылка - ДокументСсылка ИЛИ Неопределено - документ, данные по которому не нужно учитывать, 
//                  как отработанные. Передается, если заполнение учетного документа производится из формы самого 
//					документа. В этом случае, данные этого документа не учитываются, как отработанные.
Процедура ЗапросДанныхДокументаИнвентаризации(Запрос, Инвентаризация, УчетныйДокументСсылка = Неопределено) Экспорт
	УчетныеДокументы = Новый Массив;
	УчетныеДокументы.Добавить("РешениеОПрекращенииПризнанияАктивом");
	УчетныеДокументы.Добавить("СписаниеОбъектовОС");
	УчетныеДокументы.Добавить("СписаниеТранспорта");
	УчетныеДокументы.Добавить("СписаниеЛитературы");
	УчетныеДокументы.Добавить("ПринятиеКУчетуОбъектовОС");
	УчетныеДокументы.Добавить("ПринятиеКУчетуОбъектовИК");
	УчетныеДокументы.Добавить("СписаниеОбъектовИК");
	УчетныеДокументы.Добавить("СписаниеТранспортаИК");
	УчетныеДокументы.Добавить("РешениеОПрекращенииПризнанияАктивомИК");
	УчетныеДокументы.Добавить("ОбесценениеОС");
	УчетныеДокументы.Добавить("ПереоценкаОС");
	УчетныеДокументы.Добавить("ПоступлениеМЗ");
	УчетныеДокументы.Добавить("ПоступлениеИК");
	УчетныеДокументы.Добавить("АктСписанияМЗ");
	УчетныеДокументы.Добавить("АктСписанияИК");
	УчетныеДокументы.Добавить("РешениеОПрекращенииПризнанияАктивомМЗ");
	УчетныеДокументы.Добавить("РешениеОПрекращенииПризнанияАктивомМЗИК");
	УправлениеНФА.ДобавитьВПараметрыЗапросаИнвентаризацииУчетныеДокументы(
		Запрос, УчетныеДокументы, УчетныйДокументСсылка);
	
	ТекстЗапроса = УправлениеНФА.ТекстЗапросаУчетныеДокументыВводОтклоненийПоИнвентаризации(УчетныеДокументы)
	+ ОбщегоНазначения.РазделительПакетаЗапросов() + 
	"ВЫБРАТЬ
	|	НФАУчетныхДокументов1.ДокументИнвентаризации КАК ДокументИнвентаризации,
	|	НФАУчетныхДокументов1.НФА КАК НФА,
	|	НФАУчетныхДокументов1.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	НФАУчетныхДокументов1.ВидОтклонения КАК ВидОтклонения,
	|	НФАУчетныхДокументов1.МестоИнвентаризации КАК МестоИнвентаризации,
	|	СУММА(НФАУчетныхДокументов1.Количество) КАК Количество
	|ПОМЕСТИТЬ НФАУчетныхДокументов
	|ИЗ
	|	НФАУчетныхДокументов1 КАК НФАУчетныхДокументов1
	|	левое соединение (ВЫБРАТЬ                                                                                        
	|						Сторно.ДокументОснование КАК ДокументОснование
	|					ИЗ Документ.Сторно КАК Сторно
	|					ГДЕ
	|						Сторно.ДокументОснование в (ВЫБРАТЬ Таб.ДокументОтклонения ИЗ НФАУчетныхДокументов1 КАК Таб)
