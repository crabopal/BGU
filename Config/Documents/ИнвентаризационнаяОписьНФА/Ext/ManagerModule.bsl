#Область ПроверкаЗаполнения

Процедура ПроверитьЗаполнениеРаздела21(Знач ДокументОбъект, Отказ, ПроверитьОбязательныеРеквизиты = Ложь)
	
	ИмяТЧ = "Раздел21";
	
	Если ПроверитьОбязательныеРеквизиты Тогда
		ПроверитьЗаполнениеКолонокТабличнойЧасти(ДокументОбъект, "Раздел21", "НФА,МестоИнвентаризации", Отказ);
	КонецЕсли;
	
	ПредставлениеТЧ = Метаданные.Документы.ИнвентаризационнаяОписьНФА.ТабличныеЧасти[ИмяТЧ].Синоним;
	
	Поиск = Новый Структура("ДобавленоВручную", Истина);
	
	МассивСтрок = ДокументОбъект[ИмяТЧ].НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			Отказ = Истина;
			
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				НСтр("ru='Количество'"), СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ,
				НСтр("ru='В добавленной вручную строке излишка поле количество обязательное к заполнению.'"));
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект." + ИмяТЧ, СтрокаТаблицы.НомерСтроки, "Количество"));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеРаздела22(Знач ДокументОбъект, Отказ)
	
	ИмяТЧ = "Раздел22";
	
	ПредставлениеТЧ = Метаданные.Документы.ИнвентаризационнаяОписьНФА.ТабличныеЧасти[ИмяТЧ].Синоним;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТЧ] Цикл
		ДопустимоУказаниеКоличестваКачХар = (СтрокаТаблицы.КоличествоИзРаздела21 <> 0);
		
		ОбязательноУказаниеКачХар = (СтрокаТаблицы.КоличествоНедостача = 0
			И СтрокаТаблицы.СуммаНедостача = 0
			И СтрокаТаблицы.КоличествоИзлишки = 0);
			
		Если ОбязательноУказаниеКачХар И СтрокаТаблицы.КоличествоНеСоответствует = 0 И СтрокаТаблицы.КоличествоОбесценение = 0
			И СтрокаТаблицы.СуммаНеСоответствует = 0 И СтрокаТаблицы.СуммаОбесценение = 0 Тогда
			
			Если ДопустимоУказаниеКоличестваКачХар Тогда
				ПредставлениеПоля = НСтр("ru='Количество'");
				ТекстСообщения = НСтр("ru='При отсутствии недостачи и излишков необходимо заполнить одно из полей количества (не соответствует условиям актива или признаки обесценения).'");
				ИмяПоля = "КоличествоНеСоответствует";
			Иначе
				ПредставлениеПоля = НСтр("ru='Сумма'");
				ТекстСообщения = НСтр("ru='При отсутствии недостачи и излишков необходимо заполнить одно из полей суммы (не соответствует условиям актива или признаки обесценения).'");
				ИмяПоля = "СуммаНеСоответствует";
			КонецЕсли;
			
			ТекстОшибкиЗаполнения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				ПредставлениеПоля, СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ, ТекстСообщения);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибкиЗаполнения,
				ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект." + ИмяТЧ, СтрокаТаблицы.НомерСтроки, ИмяПоля),,
				Отказ);
		КонецЕсли;
		
		Если ДопустимоУказаниеКоличестваКачХар И СтрокаТаблицы.КоличествоНеСоответствует = 0 И СтрокаТаблицы.СуммаНеСоответствует <> 0 Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru='Количество не соответствует условиям актива'"), СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект." + ИмяТЧ, СтрокаТаблицы.НомерСтроки, "КоличествоНеСоответствует"),,
				Отказ);
		КонецЕсли;
		
		Если СтрокаТаблицы.КоличествоНеСоответствует <> 0 И СтрокаТаблицы.СуммаНеСоответствует = 0 Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru='Сумма не соответствует условиям актива'"), СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект." + ИмяТЧ, СтрокаТаблицы.НомерСтроки, "СуммаНеСоответствует"),,
				Отказ);
		КонецЕсли;
		
		Если ДопустимоУказаниеКоличестваКачХар И СтрокаТаблицы.КоличествоОбесценение = 0 И СтрокаТаблицы.СуммаОбесценение <> 0 Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru='Количество признаки обесценения'"), СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект." + ИмяТЧ, СтрокаТаблицы.НомерСтроки, "КоличествоОбесценение"),,
				Отказ);
		КонецЕсли;
		
		Если СтрокаТаблицы.КоличествоОбесценение <> 0 И СтрокаТаблицы.СуммаОбесценение = 0 Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru='Сумма признаки обесценения'"), СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект." + ИмяТЧ, СтрокаТаблицы.НомерСтроки, "СуммаОбесценение"),,
				Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеРаздела3(Знач ДокументОбъект, Отказ, ПроверитьОбязательныеРеквизиты = Ложь)
	
	ИмяТЧ = "Раздел3";
	
	ПредставлениеТЧ = Метаданные.Документы.ИнвентаризационнаяОписьНФА.ТабличныеЧасти[ИмяТЧ].Синоним;
	
	Если ПроверитьОбязательныеРеквизиты Тогда
		ПроверитьЗаполнениеКолонокТабличнойЧасти(ДокументОбъект, "Раздел3", "ОбъяснениеПричинРасхождений", Отказ);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТЧ] Цикл
		ОбязательноУказаниеДокумента = ЗначениеЗаполнено(СтрокаТаблицы.СуммаИзлишкиПодтверждено)
			Или ЗначениеЗаполнено(СтрокаТаблицы.КоличествоИзлишкиПодтверждено)
			Или ЗначениеЗаполнено(СтрокаТаблицы.Цена)
			Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаНедостачаПодтверждено)
			Или ЗначениеЗаполнено(СтрокаТаблицы.КоличествоНедостачаПодтверждено);
			
		Если ОбязательноУказаниеДокумента И Не ЗначениеЗаполнено(СтрокаТаблицы.НаименованиеДокумента) Тогда
			Отказ = Истина;
			
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru='Наименование документа'"), СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект." + ИмяТЧ, СтрокаТаблицы.НомерСтроки, "НаименованиеДокумента"));
		КонецЕсли;
		
		Если ОбязательноУказаниеДокумента И Не ЗначениеЗаполнено(СтрокаТаблицы.НомерДокумента) Тогда
			Отказ = Истина;
			
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru='Номер документа'"), СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект." + ИмяТЧ, СтрокаТаблицы.НомерСтроки, "НомерДокумента"));
		КонецЕсли;
		
		Если ОбязательноУказаниеДокумента И Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаДокумента) Тогда
			Отказ = Истина;
			
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru='Дата документа'"), СтрокаТаблицы.НомерСтроки, ПредставлениеТЧ);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объект." + ИмяТЧ, СтрокаТаблицы.НомерСтроки, "ДатаДокумента"));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверитьЗаполнениеМестаИнвентаризации(Знач ДокументОбъект, Знач ИмяТЧ)
	
	СинонимТЧ = Метаданные.Документы.ИнвентаризационнаяОписьНФА.ТабличныеЧасти[ИмяТЧ].Синоним;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТЧ] Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.МестоИнвентаризации) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение", НСтр("ru='Место инвентаризации'"), СтрокаТаблицы.НомерСтроки, СинонимТЧ),
				ДокументОбъект.Ссылка,
				"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧ, СтрокаТаблицы.НомерСтроки, "МестоИнвентаризации"));
				
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПроверитьОтсутствиеДублейСтрок(Знач ДокументОбъект, Знач ИмяТЧ)
	
	Если ИмяТЧ = "СписокНФА" Тогда
		КоллекцияИменКолонок = "НФА,ИнвентарныйНомер";
		
	ИначеЕсли ИмяТЧ = "Раздел21" Тогда
		КоллекцияИменКолонок = "НФА,ИнвентарныйНомер,ЕдИзм,МестоИнвентаризации,СтатусОбъекта,ЦелеваяФункцияАктива,Примечание";
		
	Иначе
		Возврат Истина;
	КонецЕсли;
	
	ТаблицаДублиСтрок = ОбщегоНазначенияБГУ.НайтиДублиСтрок(ДокументОбъект[ИмяТЧ], КоллекцияИменКолонок, Истина);
	
	Если ТаблицаДублиСтрок.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПредставлениеТЧ = Метаданные.Документы.ИнвентаризационнаяОписьНФА.ТабличныеЧасти[ИмяТЧ].Синоним;
	
	ПараметрыВывода = ОбщегоНазначенияБГУ.ПараметрыВыводаСообщенийОДубляхСтрок();
	ПараметрыВывода.ТаблицаИмя					= ИмяТЧ;
	ПараметрыВывода.ТаблицаПредставление		= ПредставлениеТЧ;
	ПараметрыВывода.ОбъектСсылка				= ДокументОбъект.Ссылка;
	ПараметрыВывода.ШаблонСтроки				= НСтр("ru='Обнаружены дубли строк НФА (Таблица ""[ТаблицаПредставление]"", строки [НомераСтрок])'");
	ПараметрыВывода.ИмяПоляДляВыводаСообщений	= "НФА";
	
	ОбщегоНазначенияБГУ.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	
	Возврат Ложь;
	
КонецФункции

Процедура ПроверитьЗаполнениеКолонокТабличнойЧасти(Знач ДокументОбъект, Знач ИмяТЧ, Знач ИменаКолонок, Отказ)
	
	ТЧ = ДокументОбъект[ИмяТЧ];
	
	Если ТЧ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеТЧ = ДокументОбъект.Ссылка.Метаданные().ТабличныеЧасти[ИмяТЧ];
	
	МассивИмен = СтрРазделить(ИменаКолонок, ", ", Ложь);
	
	СинонимыКолонок = Новый Соответствие();
	
	Для Каждого ИмяКолонки Из МассивИмен Цикл
		СинонимыКолонок.Вставить(ИмяКолонки, МетаданныеТЧ.Реквизиты[ИмяКолонки].Синоним);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ТЧ Цикл
		Для Каждого ИмяКолонки Из МассивИмен Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы[ИмяКолонки]) Тогда
				Продолжить;
			КонецЕсли;
			
			ОбщегоНазначения.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение", СинонимыКолонок.Получить(ИмяКолонки),
					СтрокаТаблицы.НомерСтроки, МетаданныеТЧ.Синоним),
				ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧ, СтрокаТаблицы.НомерСтроки, ИмяКолонки),
				"Объект", Отказ);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

