КонецФункции

Функция ПолучитьКодыСтрокСтрокойНеучтенныеОтклоненияПоСпискуНФА(Знач ТаблицаОтклонений, Знач МаксимальнаяДлинаПредставления = 20, КоличествоРазличныхКодовСтрок)
	
	Если ТаблицаОтклонений.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ВремТаблица = ТаблицаОтклонений.Скопировать(, "КодСтроки");
	ВремТаблица.Свернуть("КодСтроки");
	
	Список = ВремТаблица.ВыгрузитьКолонку("КодСтроки");
	
	КоличествоРазличныхКодовСтрок = Список.Количество();
	
	Если КоличествоРазличныхКодовСтрок > МаксимальнаяДлинаПредставления Тогда
		Для Счетчик = МаксимальнаяДлинаПредставления По КоличествоРазличныхКодовСтрок - 1 Цикл
			Список.Удалить(Список.ВГраница());
		КонецЦикла;
	КонецЕсли;
	
	СписокСтрокой = СтрСоединить(Список, ",");
	
	Возврат ИнвентаризацияКлиентСервер.СократитьСтроку(СписокСтрокой, МаксимальнаяДлинаПредставления);
	
КонецФункции

Функция РассчитатьОтклоненияРазделов1и21(СвернутаяТаблицаРаздел1, СвернутаяТаблицаРаздел21)
	
	ТаблицаРаздела22 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(Метаданные.Документы.ИнвентаризационнаяОписьНФА.ТабличныеЧасти.Раздел22);
	
	ПараметрыРасчета = ИнвентаризацияСервер.ПолучитьПараметрыРасчетаИзлишковНедостачи();
	
	ПараметрыРасчета.КолонкиКодСтроки.ИмяКолонкиТаблицыИзлишкиНедостача	= "КодСтроки";
	ПараметрыРасчета.КолонкиКодСтроки.ИмяКолонкиТаблицыФакт				= "МинимальныйНомерСтроки";
	ПараметрыРасчета.КолонкиКодСтроки.ИмяКолонкиТаблицыУчет				= "МинимальныйНомерСтроки";
	
	ПараметрыРасчета.ЭтоОписьНФА = Истина;
	
	ИнвентаризацияСервер.РассчитатьИзлишкиНедостачу(
		СвернутаяТаблицаРаздел1,
		СвернутаяТаблицаРаздел21,
		ТаблицаРаздела22,
		"НФА,ИнвентарныйНомер,ЕдИзм,МестоИнвентаризации",
		"Количество",
		ПараметрыРасчета);
	
	ТаблицаРаздела22.Сортировать("КодСтроки");
	
	Возврат ТаблицаРаздела22;
	
КонецФункции

Процедура УдалитьУчтенныеОтклоненияПоСпискуНФА(ТаблицаОтклонений, ДокументОбъект)
	
	ТЧРаздел22 = ДокументОбъект.Раздел22;
	
	КолонкиГруппировки = ПолучитьКолонкиГруппировкиДляРасчетаОтклоненийПоСпискуНФА();
	
	Поиск = Новый Структура(КолонкиГруппировки);
	
	УдаляемыеСтрокиОтклонений = Новый Массив();
	
	Для Каждого СтрокаОтклонений Из ТаблицаОтклонений Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаОтклонений);
		
		МассивСтрок = ТЧРаздел22.НайтиСтроки(Поиск);
		
		ОтклоненияЗаполнены = Ложь;
		
		Для Каждого СтрокаРаздела22 Из МассивСтрок Цикл
			ОтклоненияЗаполнены = СтрокаРаздела22.КоличествоНедостача <> 0
				Или СтрокаРаздела22.СуммаНедостача <> 0
				Или СтрокаРаздела22.КоличествоИзлишки <> 0;
				
			Если ОтклоненияЗаполнены Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ОтклоненияЗаполнены Тогда
			УдаляемыеСтрокиОтклонений.Добавить(СтрокаОтклонений);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтрокиОтклонений Цикл
		ТаблицаОтклонений.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

// Формирует свернутые таблицы разделов 1 и 2.1 как в процедуре ПрочитатьПараметрыФункцииПоСсылке_ДанныеДляРаздела22().
Функция ПолучитьТаблицыДляРасчетаОтклоненийПоСпискуНФА(ДокументОбъект, ВыделенныеСтрокиРаздела21)
	
	ТаблицаРаздела21 = ПолучитьВыделенныеСтрокиРаздела21(ДокументОбъект.Раздел21, ВыделенныеСтрокиРаздела21);
	
	СоответствующаяТаблицаРаздела1 = ПолучитьСоответствующуюТаблицуРаздела1ДляРасчетаОтклоненийПоСпискуНФА(ДокументОбъект.Раздел1, ТаблицаРаздела21);
	
	ТаблицыДляРасчета = Новый Структура();
	
	ТаблицыДляРасчета.Вставить("СвернутаяТаблицаРаздел1",
		ПолучитьСвернутуюТаблицуРазделаДляРасчетаОтклоненийПоСпискуНФА(
			СоответствующаяТаблицаРаздела1,
			"Количество,Сумма", Истина, Ложь));
	
	ТаблицыДляРасчета.Вставить("СвернутаяТаблицаРаздел21",
		ПолучитьСвернутуюТаблицуРазделаДляРасчетаОтклоненийПоСпискуНФА(
			ТаблицаРаздела21,
			"Количество", Ложь, Истина));
		
	Возврат ТаблицыДляРасчета;
	
КонецФункции

Функция ПолучитьВыделенныеСтрокиРаздела21(ТЧРаздел21, ВыделенныеСтрокиРаздела21)
	
	// Если среди выбранных строк есть строка-фрагмент, то выбираем все строки-фрагменты.
	// Это нужно для корректного расчета отклонений для выделенных строк.
	
	ТаблицаРаздела21 = НовыйТаблицаРаздела21ДляРасчетаОтклоненийПоСпискуНФА();
	
	ПоискИдентификатора = Новый Структура("ИдентификаторСтроки");
	
	Для Каждого ИдСтроки Из ВыделенныеСтрокиРаздела21 Цикл
		СтрокаТЧ = ТЧРаздел21.НайтиПоИдентификатору(ИдСтроки);
		
		Если ЗначениеЗаполнено(СтрокаТЧ.ИдентификаторСтроки) Тогда
			ЗаполнитьЗначенияСвойств(ПоискИдентификатора, СтрокаТЧ);
			
			МассивСтрок = ТаблицаРаздела21.НайтиСтроки(ПоискИдентификатора);
			
			Если МассивСтрок.Количество() <> 0 Тогда
				Продолжить;
			КонецЕсли;
			
			МассивСтрок = ТЧРаздел21.НайтиСтроки(ПоискИдентификатора);
			
			Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
				НоваяСтрока = ТаблицаРаздела21.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			КонецЦикла;
			
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаРаздела21.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
	КонецЦикла;
	
	Возврат ТаблицаРаздела21;
	
КонецФункции

Функция ПолучитьСоответствующуюТаблицуРаздела1ДляРасчетаОтклоненийПоСпискуНФА(ТЧРаздел1, ТаблицаРаздела21)
	
	КолонкиГруппировки = ПолучитьКолонкиГруппировкиДляРасчетаОтклоненийПоСпискуНФА();
	
	ТаблицаРаздела1 = НовыйТаблицаРаздела1ДляРасчетаОтклоненийПоСпискуНФА();
	
	СвернутаяТаблица21 = ТаблицаРаздела21.Скопировать(, КолонкиГруппировки);
	СвернутаяТаблица21.Свернуть(КолонкиГруппировки);
	
	Поиск = Новый Структура(КолонкиГруппировки);
	
	Для Каждого СтрокаСвернутойТаблицы21 Из СвернутаяТаблица21 Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаСвернутойТаблицы21);
		
		МассивСтрок = ТЧРаздел1.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаРаздела1 Из МассивСтрок Цикл
			НоваяСтрока = ТаблицаРаздела1.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаздела1);
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаРаздела1;
	
КонецФункции

Функция НовыйТаблицаРаздела1ДляРасчетаОтклоненийПоСпискуНФА()
	
	Таблица = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(
		Метаданные.Документы.ИнвентаризационнаяОписьНФА.ТабличныеЧасти.Раздел1);
		
	Таблица = Таблица.СкопироватьКолонки("НФА,ИнвентарныйНомер,ЕдИзм,МестоИнвентаризации,Количество,Сумма");
	
	Таблица.Колонки.Добавить("НомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный));
	
	Возврат Таблица;
	
КонецФункции

Функция НовыйТаблицаРаздела21ДляРасчетаОтклоненийПоСпискуНФА()
	
	Таблица = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(
		Метаданные.Документы.ИнвентаризационнаяОписьНФА.ТабличныеЧасти.Раздел21);
		
	Таблица = Таблица.СкопироватьКолонки("ИдентификаторСтроки,НФА,ИнвентарныйНомер,ЕдИзм,МестоИнвентаризации,Количество,Цена");
	
	Таблица.Колонки.Добавить("НомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный));
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьСвернутуюТаблицуРазделаДляРасчетаОтклоненийПоСпискуНФА(ТаблицаРаздела, КолонкиСуммирования, УдалитьСНулевымКоличеством, РассчитатьСреднююЦену)
	
	КолонкиГруппировки = ПолучитьКолонкиГруппировкиДляРасчетаОтклоненийПоСпискуНФА();
	
	СвернутаяТаблицаРаздела = ТаблицаРаздела.Скопировать();
	СвернутаяТаблицаРаздела.Свернуть(КолонкиГруппировки, КолонкиСуммирования);
	
	ЗаполнитьМинимальныйНомерСтроки(СвернутаяТаблицаРаздела, ТаблицаРаздела, КолонкиГруппировки, РассчитатьСреднююЦену);
	
	УдалитьСтрокиСОтрицательнымКоличеством(СвернутаяТаблицаРаздела, УдалитьСНулевымКоличеством);
	
	СвернутаяТаблицаРаздела.Сортировать("МинимальныйНомерСтроки");
	
	Возврат СвернутаяТаблицаРаздела;
	
КонецФункции

Процедура ЗаполнитьМинимальныйНомерСтроки(СвернутаяТаблицаРаздела, ТаблицаРаздела, КолонкиГруппировки, РассчитатьСреднююЦену)
	
	// Строки в ТаблицаРаздела упорядочены по возрастанию номера строки.
	
	СвернутаяТаблицаРаздела.Колонки.Добавить("МинимальныйНомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный));
	
	Если РассчитатьСреднююЦену Тогда
		СвернутаяТаблицаРаздела.Колонки.Добавить("Цена", Новый ОписаниеТипов(ТаблицаРаздела.Колонки.Цена.ТипЗначения));
	КонецЕсли;
	
	Поиск = Новый Структура(КолонкиГруппировки);
	
	Для Каждого СтрокаСвернутойТаблицы Из СвернутаяТаблицаРаздела Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаСвернутойТаблицы);
		
		МассивСтрок = ТаблицаРаздела.НайтиСтроки(Поиск);
		
		СтрокаСвернутойТаблицы.МинимальныйНомерСтроки = МассивСтрок[0].НомерСтроки;
		
		Если РассчитатьСреднююЦену Тогда
			РассчитатьСреднююЦенуВСтрокеСвернутойТаблицыРаздела(СтрокаСвернутойТаблицы, МассивСтрок);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьСтрокиСОтрицательнымКоличеством(СвернутаяТаблицаРаздела, УдалитьСНулевымКоличеством)
	
	УдаляемыеСтроки = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из СвернутаяТаблицаРаздела Цикл
		Если СтрокаТаблицы.Количество < 0 Или (СтрокаТаблицы.Количество = 0 И УдалитьСНулевымКоличеством) Тогда
			УдаляемыеСтроки.Добавить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		СвернутаяТаблицаРаздела.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

Процедура РассчитатьСреднююЦенуВСтрокеСвернутойТаблицыРаздела(СтрокаСвернутойТаблицы, МассивСтрок)
	
	СуммаЦен = 0;
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СуммаЦен = СуммаЦен + СтрокаТаблицы.Цена;
	КонецЦикла;
	
	СтрокаСвернутойТаблицы.Цена = СуммаЦен / МассивСтрок.Количество();
	
КонецПроцедуры

#КонецОбласти

#Область ПодборОстатковНФА

Функция ПолучитьСпискиОтбораДляФормыПодбораОстатковНФА(ДокументОбъект, ИмяВидаСубконто)
	
	СпискиОтбора = ПолучитьСпискиОтбораСчетовИКФОДляФормыПодбораОстатковНФА(ДокументОбъект, ИмяВидаСубконто);
	
	ДиагностикаМестИнвентаризации = ДиагностироватьМестаИнвентаризации(ДокументОбъект.МестаИнвентаризации.Выгрузить());
	
	СпискиМОЛ = ПолучитьСпискиМОЛ(ДокументОбъект.МОЛ, ДиагностикаМестИнвентаризации);
	
	МассивЦМО = СпискиМОЛ.СписокЦМО;
	
	СпискиОтбора.Вставить("МассивЦМО", МассивЦМО);
	
	Возврат СпискиОтбора;
	
КонецФункции

Функция ПолучитьСпискиОтбораСчетовИКФОДляФормыПодбораОстатковНФА(ДокументОбъект, ИмяВидаСубконто)
	
	// При КФО 0 отбор по КФО не накладывается.
	// В список отбора КФО 0 не добавляется.
	
#Область Комментарий
	//	Таблица счетов описи	|	Результаты расчета
	//	(ТЧ СписокСчетов)		|
	//	------------------------+---------------------------------------
	//	N	КФО	Счет			|	Детальные	ОС	МЗ	Применяемое КФО
	//							|	счета
	//	1	0	101.00			|	101.00		+		0 (указано явно)
	//							|	101.30			+	0
	//	2	2	101.10			|	101.10		+		2 (указано явно)
	//							|	101.11			+	2
	//							|	101.12			+	2
	//							|	...					2
	//	3	4	101.20			|	101.20		+		4 (указано явно)
	//							|	101.22			+	4
	//							|	101.24			+	4
	//							|	...
	//	4	0	105.00			|	105.00			+	0 (указано явно)
	//							|	...				+	0
	//	5	2	105.21			|	105.21			+	2 (указано явно)
	//	6	4	105.31			|	105.31			+	4 (указано явно)
#КонецОбласти

	ТаблицаСчетовОписи = ДокументОбъект.СписокСчетов.Выгрузить();
	
	ТаблицаСчетовОписи.Индексы.Добавить("Счет");
	
	ДатаОстатков = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(ДокументОбъект.ДатаИнвентаризации);
	
	ДетальныеСчетаИНаличиеСубконто = ПолучитьДетальныеСчетаИНаличиеСубконто(ТаблицаСчетовОписи.ВыгрузитьКолонку("Счет"), ДатаОстатков);
	
	ДополнитьТаблицуСчетовОписиПризнакамиНаличияСубконто(ТаблицаСчетовОписи, ДетальныеСчетаИНаличиеСубконто);
	
	ОставитьСтрокиПоВидуСубконто(ДетальныеСчетаИНаличиеСубконто, ИмяВидаСубконто);
	ОставитьСтрокиПоВидуСубконто(ТаблицаСчетовОписи, ИмяВидаСубконто);
	
	// Таблица счетов описи (ТЧ СписокСчетов)
	
	ВремТаблица = ТаблицаСчетовОписи.Скопировать(, "Счет");
	ВремТаблица.Свернуть("Счет");
	МассивСчетовОписи = ВремТаблица.ВыгрузитьКолонку("Счет");
	
	ВремТаблица = ТаблицаСчетовОписи.Скопировать(, "КФО");
	ВремТаблица.Свернуть("КФО");
	МассивКФО = ВремТаблица.ВыгрузитьКолонку("КФО");
	
	Если МассивКФО.Найти(Перечисления.КВД.ПустаяСсылка()) <> Неопределено Тогда
		МассивКФО.Очистить();
	КонецЕсли;
	
	// Детальные счета
	
	МассивДетальныхСчетов = ДетальныеСчетаИНаличиеСубконто.ВыгрузитьКолонку("Ссылка");
	
	СпискиОтбора = Новый Структура();
	СпискиОтбора.Вставить("МассивКФО",				МассивКФО);
	СпискиОтбора.Вставить("МассивСчетовОписи",		МассивСчетовОписи);
	СпискиОтбора.Вставить("МассивДетальныхСчетов",	МассивДетальныхСчетов);
	
	Возврат СпискиОтбора;
	
КонецФункции

Процедура ОставитьСтрокиПоВидуСубконто(Таблица, Знач ИмяВидаСубконто)
	
	Поиск = Новый Структура("ЕстьСубконто" + ИмяВидаСубконто, Истина);
	
	Таблица = Таблица.Скопировать(Поиск);
	
КонецПроцедуры

Процедура ДополнитьТаблицуСчетовОписиПризнакамиНаличияСубконто(ТаблицаСчетовОписи, Знач ДетальныеСчетаИНаличиеСубконто)
	
	ТаблицаСчетовОписи.Колонки.Добавить("ЕстьСубконтоОсновныеСредства",	Новый ОписаниеТипов("Булево"));
	ТаблицаСчетовОписи.Колонки.Добавить("ЕстьСубконтоНоменклатура",		Новый ОписаниеТипов("Булево"));
	
	ИменаПолей = Новый Массив();
	ИменаПолей.Добавить("Ссылка");
	ИменаПолей.Добавить("Родитель1");
	ИменаПолей.Добавить("Родитель2");
	ИменаПолей.Добавить("Родитель3");
	ИменаПолей.Добавить("Родитель4");
	
	Поиск = Новый Структура("Счет");
	
	Для Каждого ДетальнаяСтрока Из ДетальныеСчетаИНаличиеСубконто Цикл
		
		Если Не ДетальнаяСтрока.ЕстьСубконтоОсновныеСредства
			И Не ДетальнаяСтрока.ЕстьСубконтоНоменклатура Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			Поиск.Счет = ДетальнаяСтрока[ИмяПоля];
			
			МассивСтрок = ТаблицаСчетовОписи.НайтиСтроки(Поиск);
			
			Если ДетальнаяСтрока.ЕстьСубконтоОсновныеСредства Тогда
				Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
					СтрокаТаблицы.ЕстьСубконтоОсновныеСредства = Истина;
				КонецЦикла;
			КонецЕсли;
			
			Если ДетальнаяСтрока.ЕстьСубконтоНоменклатура Тогда
				Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
					СтрокаТаблицы.ЕстьСубконтоНоменклатура = Истина;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДетальныеСчетаИНаличиеСубконто(СписокСчетов, НаДату)
	
	ВидСубконтоОсновныеСредства = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства;
	ВидСубконтоНоменклатура = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура;
	
	ВидыСубконтоОсновныеСредстваНоменклатура = Новый Массив();
	ВидыСубконтоОсновныеСредстваНоменклатура.Добавить(ВидСубконтоОсновныеСредства);
	ВидыСубконтоОсновныеСредстваНоменклатура.Добавить(ВидСубконтоНоменклатура);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокСчетов",								СписокСчетов);
	ЗапросПоиск.УстановитьПараметр("ВидСубконтоОсновныеСредства",				ВидСубконтоОсновныеСредства);
	ЗапросПоиск.УстановитьПараметр("ВидСубконтоНоменклатура",					ВидСубконтоНоменклатура);
	ЗапросПоиск.УстановитьПараметр("ВидыСубконтоОсновныеСредстваНоменклатура",	ВидыСубконтоОсновныеСредстваНоменклатура);
	ЗапросПоиск.УстановитьПараметр("НаДату",									НаДату);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка																						КАК Ссылка,
	|	ЕСТЬNULL(ЕПСБУ.Ссылка.Родитель, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))							КАК Родитель1,
	|	ЕСТЬNULL(ЕПСБУ.Ссылка.Родитель.Родитель, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))					КАК Родитель2,
	|	ЕСТЬNULL(ЕПСБУ.Ссылка.Родитель.Родитель.Родитель, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))			КАК Родитель3,
	|	ЕСТЬNULL(ЕПСБУ.Ссылка.Родитель.Родитель.Родитель.Родитель, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))	КАК Родитель4,
	|	МАКСИМУМ(ЕПСБУВидыСубконто.ВидСубконто = &ВидСубконтоОсновныеСредства)								КАК ЕстьСубконтоОсновныеСредства,
	|	МАКСИМУМ(ЕПСБУВидыСубконто.ВидСубконто = &ВидСубконтоНоменклатура)									КАК ЕстьСубконтоНоменклатура
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ЕПСБУ.Ссылка В ИЕРАРХИИ(&СписокСчетов)
	|		И ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|		И ЕПСБУ.ДатаНачалаДействия <= &НаДату
	|		И (ЕПСБУ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1,1,1) ИЛИ ЕПСБУ.ДатаОкончанияДействия >= &НаДату)
	|ГДЕ
	|	ЕПСБУВидыСубконто.ВидСубконто В(&ВидыСубконтоОсновныеСредстваНоменклатура)
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУ.Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	ЕПСБУ.Порядок";
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаСчетов = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТаблицаСчетов;
	
КонецФункции

Функция ПолучитьТаблицуВидовРаспоряженияОССсылкиСчетовДляФормыПодбораОС(НаДату, СписокСчетов)
	
	ТаблицаВидыРаспоряженияОС = ПолучитьТаблицуВидовРаспоряженияОССсылкиСчетов(НаДату);
	
	НоваяТаблица = ТаблицаВидыРаспоряженияОС.СкопироватьКолонки();
	
	Поиск = Новый Структура("Счет");
	
	Для Каждого Счет Из СписокСчетов Цикл
		Поиск.Счет = Счет;
		
		МассивСтрок = ТаблицаВидыРаспоряженияОС.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			НоваяСтрока = НоваяТаблица.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, МассивСтрок[0]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат НоваяТаблица;
	
КонецФункции

Функция ПолучитьОписаниеВременнойТаблицыДляДинамическогоСписка(Таблица, ИмяВременнойТаблицы)
	
	Результат = Новый Структура("Текст, Параметры", "", Новый Структура());
	
	ИменаПолей = Новый Массив();
	
	ИменаТиповПолей = Новый Структура();
	
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ИмяПоля = Колонка.Имя;
		
		ИменаПолей.Добавить(ИмяПоля);
		
		Если Колонка.ТипЗначения.Типы().Количество() = 1 Тогда
			ТипКолонки = Колонка.ТипЗначения.Типы()[0];
			
			МетаданныеПоТипуКолонки = Метаданные.НайтиПоТипу(ТипКолонки);
			
			Если МетаданныеПоТипуКолонки <> Неопределено Тогда
				ИменаТиповПолей.Вставить(ИмяПоля, МетаданныеПоТипуКолонки.ПолноеИмя());
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ШаблонИмяПараметра = "Параметр_%1";
	
	ШаблонВыборПолейТекущейСтроки = "ВЫБРАТЬ
		|		%1";
	ШаблонВыборПараметраСВыразить = "ВЫРАЗИТЬ(&%1 КАК %2) КАК %3";
	ШаблонВыборПараметраБезВыразить = "&%1 КАК %2";
	
	ТекстыВсехСтрок = Новый Массив();
	
	НомерПараметра = 1;
	
	ТаблицаПустая = (Таблица.Количество() = 0);
	
	Если ТаблицаПустая Тогда
		ВыгружаемаяТаблица = Таблица.СкопироватьКолонки();
		
		ПустаяСтрока = ВыгружаемаяТаблица.Добавить();
	Иначе
		ВыгружаемаяТаблица = Таблица;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ВыгружаемаяТаблица Цикл
		
		ТекстыТекущейСтроки = Новый Массив();
		
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			ЗначениеПоля = СтрокаТаблицы[ИмяПоля];
			
			ИмяПараметра = СтрШаблон(ШаблонИмяПараметра, Формат(НомерПараметра, "ЧН=0; ЧГ="));
			
			// Текст запроса выбора параметра.
			
			ПолноеИмяТипа = Неопределено;
			
			Если Не ИменаТиповПолей.Свойство(ИмяПоля, ПолноеИмяТипа) Тогда
				МетаданныеПоТипуЗначенияПоля = Метаданные.НайтиПоТипу(ТипЗнч(ЗначениеПоля));
				
				Если МетаданныеПоТипуЗначенияПоля <> Неопределено Тогда
					ПолноеИмяТипа = МетаданныеПоТипуЗначенияПоля.ПолноеИмя();
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ПолноеИмяТипа) Тогда
				ТекстыТекущейСтроки.Добавить(СтрШаблон(ШаблонВыборПараметраСВыразить,
					ИмяПараметра,
					ПолноеИмяТипа,
					ИмяПоля));
			Иначе
				ТекстыТекущейСтроки.Добавить(СтрШаблон(ШаблонВыборПараметраБезВыразить,
					ИмяПараметра,
					ИмяПоля));
			КонецЕсли;
			
			// Значение параметра.
			Результат.Параметры.Вставить(ИмяПараметра, СтрокаТаблицы[ИмяПоля]);
			
			НомерПараметра = НомерПараметра + 1;
		КонецЦикла;
		
		ТекстТекущейСтроки = СтрШаблон(ШаблонВыборПолейТекущейСтроки, СтрСоединить(ТекстыТекущейСтроки, ",
		|		"));
		
		ТекстыВсехСтрок.Добавить(ТекстТекущейСтроки);
    КонецЦикла;
	
	ТекстОбъединитьВсе = "
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	";
	
    Результат.Текст = СтрШаблон("ВЫБРАТЬ
	    |	%1
	    |ПОМЕСТИТЬ
		|	%2
	    |ИЗ
	    |	(%3) КАК %2
		|ГДЕ
		|	%4",
		СтрСоединить(ИменаПолей, ", "),
		ИмяВременнойТаблицы,
		СтрСоединить(ТекстыВсехСтрок, ТекстОбъединитьВсе),
		?(ТаблицаПустая, "ЛОЖЬ", "ИСТИНА"));
	
    Возврат Результат;
	
КонецФункции

Процедура ДобавитьТипыНоменклатурыДляПодбораОстатковМЗ(ПараметрыФормы)
	
	ИсключаемыеТипыНоменклатуры = ПолучитьИсключаемыеТипыНоменклатуры();
	
	ТипыНоменклатуры = Новый СписокЗначений();
	ТипыНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.ПустаяСсылка());
	
	Для Каждого ТипНоменклатуры Из Перечисления.ТипыНоменклатуры Цикл
		Если ИсключаемыеТипыНоменклатуры.Найти(ТипНоменклатуры) = Неопределено Тогда
			ТипыНоменклатуры.Добавить(ТипНоменклатуры);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы.Вставить("ТипыНоменклатуры", ТипыНоменклатуры);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРаздела1

Функция ПолучитьДанныеБухУчета(ПараметрыФункции)
	
	ПрочитатьПараметрыФункцииПоСсылке_ДанныеДляРаздела1(ПараметрыФункции);
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаОстатков(ПараметрыФункции);
	
	ДанныеОС = ПолучитьДанныеБухУчетаОС(ПараметрыПоиска, ПараметрыФункции);
	
	// За основу берем таблицу остатков ОС.
	
	ТаблицаРаздела1 = ДанныеОС.ТаблицаРаздела1;
	
	ТаблицаРаздела1.Колонки.Добавить("НФА", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства,СправочникСсылка.Номенклатура"));
	
	МассивОС = ТаблицаРаздела1.ВыгрузитьКолонку("ОсновноеСредство");
	
	ТаблицаРаздела1.ЗагрузитьКолонку(МассивОС, "НФА");
	
	ТаблицаРаздела1.Колонки.Найти("НаименованиеОсновногоСредства").Имя	= "НаименованиеНФА";
	ТаблицаРаздела1.Колонки.Найти("КоличествоОстаток").Имя				= "Количество";
	ТаблицаРаздела1.Колонки.Найти("СуммаОстаток").Имя					= "Сумма";
	
	ДанныеМЗ = ПолучитьДанныеБухУчетаМЗ(ПараметрыПоиска);
	
	ТаблицаМЗ = ДанныеМЗ.ТаблицаРаздела1;
	ТаблицаМЗ.Колонки.Найти("Номенклатура").Имя				= "НФА";
	ТаблицаМЗ.Колонки.Найти("НаименованиеНоменклатуры").Имя	= "НаименованиеНФА";
	ТаблицаМЗ.Колонки.Найти("КоличествоОстаток").Имя		= "Количество";
	ТаблицаМЗ.Колонки.Найти("СуммаОстаток").Имя				= "Сумма";
	
	Для Каждого СтрокаТаблицы Из ТаблицаМЗ Цикл
		НоваяСтрока = ТаблицаРаздела1.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	УстановитьКоличествоПоУмолчанию(ТаблицаРаздела1);
	
	УстановитьЕдИзмШт(ТаблицаРаздела1, ПараметрыПоиска);
	
	ЗаполнитьМестаИнвентаризации(ТаблицаРаздела1, ПараметрыПоиска);
	
	ТаблицаРаздела1.Сортировать("НаименованиеНФА,КодИнвентарногоНомера,ЦМО,ПорядокСчета,КФО");
	
	Результат = Новый Структура();
	Результат.Вставить("Раздел1",				ТаблицаРаздела1);
	Результат.Вставить("ДополнениеРаздела1",	ДанныеОС.ТаблицаДополнениеРаздела1);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеБухУчетаОС(ПараметрыПоиска, ПараметрыФункции)
	
	ЗапросПоиск = Новый Запрос();
	
	ЗапросПоиск.УстановитьПараметр("ДатаОстатков",						ПараметрыПоиска.ДатаОстатков);
	ЗапросПоиск.УстановитьПараметр("Организация",						ПараметрыПоиска.Организация);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоИФО",				ПараметрыПоиска.ИспользоватьУчетПоИФО);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоИФО",			ПараметрыПоиска.ИспользоватьОтборПоИФО);
	ЗапросПоиск.УстановитьПараметр("ИФО",								ПараметрыПоиска.ИФО);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	ПараметрыПоиска.ИспользоватьОтборПоПодразделению);
	ЗапросПоиск.УстановитьПараметр("СписокПодразделений",				ПараметрыПоиска.СписокПодразделений);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоКФО",			ПараметрыПоиска.ИспользоватьОтборПоКФО);
	ЗапросПоиск.УстановитьПараметр("СписокКФО",							ПараметрыПоиска.СписокКФО);
	ЗапросПоиск.УстановитьПараметр("СписокСчетов",						ПараметрыПоиска.СписокСчетов);
	ЗапросПоиск.УстановитьПараметр("ТаблицаИсключаемыхСчетов",			ПараметрыПоиска.ТаблицаИсключаемыхСчетов);

	ЗапросПоиск.УстановитьПараметр("ЕдИзмШт",							ПараметрыПоиска.ЕдИзмШт);
	ЗапросПоиск.УстановитьПараметр("ПустаяЕдИзм",						ПараметрыПоиска.ПустаяЕдИзм);
	
	ЗапросПоиск.УстановитьПараметр("СчетаИсточникСуммРегистрБухгалтерии",			ПараметрыПоиска.СчетаИсточникСуммРегистрБухгалтерии);
	ЗапросПоиск.УстановитьПараметр("СчетаУстановкиКоличестваПоУмолчанию",			ПараметрыПоиска.СчетаУстановкиКоличестваПоУмолчанию);
	
	ЗапросПоиск.УстановитьПараметр("СписокЦМО",										ПараметрыПоиска.СписокЦМО);
	ЗапросПоиск.УстановитьПараметр("СписокКонтрагентов",							Новый Массив()); // отбор по контрагенту не устанавливаем, выбираем по всем контрагентам
	
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборОС",							ПараметрыПоиска.ИспользоватьОтборОС);
	ЗапросПоиск.УстановитьПараметр("СписокОС",										ПараметрыПоиска.СписокОС);
	
	ЗапросПоиск.УстановитьПараметр("ВидыРаспоряженияОСПереданныеОбъекты",			ПараметрыПоиска.ВидыРаспоряженияОСПереданныеОбъекты);
	ЗапросПоиск.УстановитьПараметр("ВидыРаспоряженияОСРегистрСтоимостьОбъектовОС",	ПараметрыПоиска.ВидыРаспоряженияОСРегистрСтоимостьОбъектовОС);
	ЗапросПоиск.УстановитьПараметр("ВидыРаспоряженияОСРегистрСтоимостьОбъектовОСПоКонтрагентамСОтборомПоЦМО",	ПараметрыПоиска.ВидыРаспоряженияОСРегистрСтоимостьОбъектовОСПоКонтрагентамСОтборомПоЦМО);
	ЗапросПоиск.УстановитьПараметр("ВидыРаспоряженияОСРегистрСтоимостьОбъектовОСПоКонтрагентамБезОтбораПоЦМО",	ПараметрыПоиска.ВидыРаспоряженияОСРегистрСтоимостьОбъектовОСПоКонтрагентамБезОтбораПоЦМО);
	
	ЗапросПоиск.УстановитьПараметр("ТаблицаВидыРаспоряженияОС",						ПараметрыПоиска.ТаблицаВидыРаспоряженияОС);
	ЗапросПоиск.УстановитьПараметр("СписокСчетовДляВыбораКонтрагента",				ПараметрыПоиска.СписокСчетовДляВыбораКонтрагента);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаОстаткиОС();
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапросов = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	// [4]. Применяемые остатки в разрезе инв.номеров
	ТаблицаРаздела1 = РезультатыЗапросов[4].Выгрузить();
	
	// [5]. Остатки по переданным объектам ОС, которые должны быть отражены в соответствующих балансовых остатках по счетам 101.00, 103.00
	ТаблицаДополнения = РезультатыЗапросов[5].Выгрузить();
	
	Если ПараметрыФункции.ЭтоВыборочнаяИнвентаризация Тогда
		УдалитьОстаткиНеподходящихИнвНомеровОС(ТаблицаРаздела1, ТаблицаДополнения, ПараметрыФункции);
	КонецЕсли;
	
	СопоставитьСтрокиТаблицРаздела1(ТаблицаРаздела1, ТаблицаДополнения, ПараметрыПоиска);
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаРаздела1", ТаблицаРаздела1);
	Результат.Вставить("ТаблицаДополнениеРаздела1", ТаблицаДополнения);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеБухУчетаМЗ(ПараметрыПоиска)
	
	ЗапросПоиск = Новый Запрос();
	
	ЗапросПоиск.УстановитьПараметр("ДатаОстатков",						ПараметрыПоиска.ДатаОстатков);
	ЗапросПоиск.УстановитьПараметр("Организация",						ПараметрыПоиска.Организация);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоИФО",				ПараметрыПоиска.ИспользоватьУчетПоИФО);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоИФО",			ПараметрыПоиска.ИспользоватьОтборПоИФО);
	ЗапросПоиск.УстановитьПараметр("ИФО",								ПараметрыПоиска.ИФО);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	ПараметрыПоиска.ИспользоватьОтборПоПодразделению);
	ЗапросПоиск.УстановитьПараметр("СписокПодразделений",				ПараметрыПоиска.СписокПодразделений);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоКФО",			ПараметрыПоиска.ИспользоватьОтборПоКФО);
	ЗапросПоиск.УстановитьПараметр("СписокКФО",							ПараметрыПоиска.СписокКФО);
	ЗапросПоиск.УстановитьПараметр("СписокСчетов",						ПараметрыПоиска.СписокСчетов);
	ЗапросПоиск.УстановитьПараметр("ТаблицаИсключаемыхСчетов",			ПараметрыПоиска.ТаблицаИсключаемыхСчетов);
	
	ЗапросПоиск.УстановитьПараметр("СчетаУстановкиКоличестваПоУмолчанию",	ПараметрыПоиска.СчетаУстановкиКоличестваПоУмолчанию);
	
	ЗапросПоиск.УстановитьПараметр("СписокЦМО",								ПараметрыПоиска.СписокЦМО);
	ЗапросПоиск.УстановитьПараметр("СписокКонтрагентов",					ПараметрыПоиска.СписокКонтрагентов);
	
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборНоменклатуры",			ПараметрыПоиска.ИспользоватьОтборНоменклатуры);
	ЗапросПоиск.УстановитьПараметр("СписокНоменклатуры",					ПараметрыПоиска.СписокНоменклатуры);
	ЗапросПоиск.УстановитьПараметр("ПустаяНоменклатура",					ПараметрыПоиска.ПустаяНоменклатура);
	ЗапросПоиск.УстановитьПараметр("ВидыСубконтоНоменклатураЦМО",			ПараметрыПоиска.ВидыСубконтоНоменклатураЦМО);
	ЗапросПоиск.УстановитьПараметр("ВидыСубконтоНоменклатураКонтрагенты",	ПараметрыПоиска.ВидыСубконтоНоменклатураКонтрагенты);
	ЗапросПоиск.УстановитьПараметр("ВидыСубконтоНоменклатура",				ПараметрыПоиска.ВидыСубконтоНоменклатура);
	
	ЗапросПоиск.УстановитьПараметр("ИсключаемыеТипыНоменклатуры",		ПараметрыПоиска.ИсключаемыеТипыНоменклатуры);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаОстаткиМЗ();
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаРаздела1 = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаРаздела1", ТаблицаРаздела1);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТекстЗапросаОстаткиОС()
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исключаемые счета
	|//
	|ВЫБРАТЬ
	|	ТЗ.КФО	КАК КФО,
	|	ТЗ.Счет	КАК Счет
	|ПОМЕСТИТЬ
	|	ТаблицаИсключаемыхСчетов
	|ИЗ
	|	&ТаблицаИсключаемыхСчетов КАК ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	КФО,
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Соответствие счета и вида распоряжения
	|//
	|ВЫБРАТЬ
	|	ТЗ.Счет				КАК Счет,
	|	ТЗ.ВидРаспоряжения	КАК ВидРаспоряжения
	|ПОМЕСТИТЬ
	|	ТаблицаВидыРаспоряженияОС
	|ИЗ
	|	&ТаблицаВидыРаспоряженияОС КАК ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Остатки без инв.номеров из регистра бухгалтерии
	|//
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Субконто1 ССЫЛКА Справочник.ОсновныеСредства ТОГДА
	|			ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства)
	|		КОГДА Субконто2 ССЫЛКА Справочник.ОсновныеСредства ТОГДА
	|			ВЫРАЗИТЬ(Субконто2 КАК Справочник.ОсновныеСредства)
	|		КОГДА Субконто3 ССЫЛКА Справочник.ОсновныеСредства ТОГДА
	|			ВЫРАЗИТЬ(Субконто3 КАК Справочник.ОсновныеСредства)
	|	КОНЕЦ											КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА Субконто1 ССЫЛКА Справочник.ЦМО ТОГДА
	|			ВЫРАЗИТЬ(Субконто1 КАК Справочник.ЦМО)
	|		КОГДА Субконто2 ССЫЛКА Справочник.ЦМО ТОГДА
	|			ВЫРАЗИТЬ(Субконто2 КАК Справочник.ЦМО)
	|		КОГДА Субконто3 ССЫЛКА Справочник.ЦМО ТОГДА
	|			ВЫРАЗИТЬ(Субконто3 КАК Справочник.ЦМО)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	|	КОНЕЦ											КАК ЦМО,
	|	ВЫБОР
	|		КОГДА Счет В(&СписокСчетовДляВыбораКонтрагента) ТОГДА
	|			ВЫБОР
	|				КОГДА Субконто1 ССЫЛКА Справочник.Контрагенты ТОГДА
	|					ВЫРАЗИТЬ(Субконто1 КАК Справочник.Контрагенты)
	|				КОГДА Субконто2 ССЫЛКА Справочник.Контрагенты ТОГДА
	|					ВЫРАЗИТЬ(Субконто2 КАК Справочник.Контрагенты)
	|				КОГДА Субконто3 ССЫЛКА Справочник.Контрагенты ТОГДА
	|					ВЫРАЗИТЬ(Субконто3 КАК Справочник.Контрагенты)
	|					
	|				КОГДА Субконто1 ССЫЛКА Справочник.Договоры ТОГДА
	|					ЕСТЬNULL(ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|				КОГДА Субконто2 ССЫЛКА Справочник.Договоры ТОГДА
	|					ЕСТЬNULL(ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|				КОГДА Субконто3 ССЫЛКА Справочник.Договоры ТОГДА
	|					ЕСТЬNULL(ВЫРАЗИТЬ(Субконто3 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|					
	|				ИНАЧЕ
	|					ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			КОНЕЦ
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ											КАК Контрагент,
	|	Счет											КАК Счет,
	|	КПС												КАК КПС,
	|	КФО												КАК КФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ЕСТЬNULL(ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ											КАК ИФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			ЕСТЬNULL(Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ											КАК Подразделение,
	|	СУММА(СуммаОстатокДт)							КАК СуммаОстаток,
	|	СУММА(КоличествоОстатокДт)						КАК КоличествоОстаток
	|ПОМЕСТИТЬ
	|	ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ДатаОстатков,				// 1. дата
	|		Счет В (&СписокСчетов),		// 2. счет
	|		,							// 3. виды субконто
	|		Организация = &Организация	// 4. условия
	|		И ВЫБОР
	|			КОГДА Субконто1 ССЫЛКА Справочник.ОсновныеСредства ТОГДА
	|				Субконто1 В(&СписокОС) ИЛИ НЕ &ИспользоватьОтборОС
	|			КОГДА Субконто2 ССЫЛКА Справочник.ОсновныеСредства ТОГДА
	|				Субконто2 В(&СписокОС) ИЛИ НЕ &ИспользоватьОтборОС
	|			КОГДА Субконто3 ССЫЛКА Справочник.ОсновныеСредства ТОГДА
	|				Субконто3 В(&СписокОС) ИЛИ НЕ &ИспользоватьОтборОС
	|			ИНАЧЕ
	|				// Обязательно наличие субконто ОсновныеСредства
	|				ЛОЖЬ
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА Субконто1 ССЫЛКА Справочник.ЦМО ТОГДА
	|				ВЫРАЗИТЬ(Субконто1 КАК Справочник.ЦМО) В(&СписокЦМО)
	|			КОГДА Субконто2 ССЫЛКА Справочник.ЦМО ТОГДА
	|				ВЫРАЗИТЬ(Субконто2 КАК Справочник.ЦМО) В(&СписокЦМО)
	|			КОГДА Субконто3 ССЫЛКА Справочник.ЦМО ТОГДА
	|				ВЫРАЗИТЬ(Субконто3 КАК Справочник.ЦМО) В(&СписокЦМО)
	|			
	|			КОГДА Субконто1 ССЫЛКА Справочник.Контрагенты ТОГДА
	|				ВЫРАЗИТЬ(Субконто1 КАК Справочник.Контрагенты) В(&СписокКонтрагентов)
	|			КОГДА Субконто2 ССЫЛКА Справочник.Контрагенты ТОГДА
	|				ВЫРАЗИТЬ(Субконто2 КАК Справочник.Контрагенты) В(&СписокКонтрагентов)
	|			КОГДА Субконто3 ССЫЛКА Справочник.Контрагенты ТОГДА
	|				ВЫРАЗИТЬ(Субконто3 КАК Справочник.Контрагенты) В(&СписокКонтрагентов)
	|				
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР 
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО В(&СписокКФО)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|	)
	|ГДЕ
	|	ВЫБОР
	|		КОГДА &ИспользоватьОтборПоПодразделению И Счет.УчетПоПодразделениям ТОГДА
	|			Подразделение В(&СписокПодразделений)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И НЕ (КФО, Счет) В (ВЫБРАТЬ КФО, Счет ИЗ ТаблицаИсключаемыхСчетов)
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА Субконто1 ССЫЛКА Справочник.ОсновныеСредства ТОГДА
	|			ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства)
	|		КОГДА Субконто2 ССЫЛКА Справочник.ОсновныеСредства ТОГДА
	|			ВЫРАЗИТЬ(Субконто2 КАК Справочник.ОсновныеСредства)
	|		КОГДА Субконто3 ССЫЛКА Справочник.ОсновныеСредства ТОГДА
	|			ВЫРАЗИТЬ(Субконто3 КАК Справочник.ОсновныеСредства)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Субконто1 ССЫЛКА Справочник.ЦМО ТОГДА
	|			ВЫРАЗИТЬ(Субконто1 КАК Справочник.ЦМО)
