Функция ПолучитьДополнительныеПараметрыПечати0510466(МассивОбъектов, РезультатыЗапроса)
	
	ТаблицаСвойствНФА = РезультатыЗапроса[0].Выгрузить();
	ТаблицаСвойствНФА.Индексы.Добавить("Ссылка,НФА,ИнвентарныйНомер");
	
	ТаблицаШапок = РезультатыЗапроса[1].Выгрузить();
	ТаблицаШапок.Индексы.Добавить("Ссылка");
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТаблицаСвойствНФА",			ТаблицаСвойствНФА);
	ДополнительныеПараметры.Вставить("ПоискСвойствНФА",				Новый Структура("Ссылка,НФА,ИнвентарныйНомер"));
	ДополнительныеПараметры.Вставить("НаименованиеНомерОбъекта",	Новый Структура("НаименованиеОбъекта,НомерОбъекта"));
	
	ДополнительныеПараметры.Вставить("ТаблицаКлассификацииНФАДляОпределенияКодаОбъекта", КлассифицироватьНФАДляОпределенияКодаОбъекта(МассивОбъектов));
	ДополнительныеПараметры.Вставить("ПоискКлассификацииНФАДляОпределенияКодаОбъекта", Новый Структура("Ссылка,НФА"));
	
	ДополнительныеПараметры.Вставить("КадастровыеНомераОС",										ПолучитьКадастровыеНомераОС(ТаблицаСвойствНФА, ТаблицаШапок));
	ДополнительныеПараметры.Вставить("ПоискКадастровогоНомераОсновноеСредство",					Новый Структура("Организация,ДатаИнвентаризации,ОсновноеСредство"));
	ДополнительныеПараметры.Вставить("ПоискКадастровогоНомераОсновноеСредствоИнвентарныйНомер",	Новый Структура("Организация,ДатаИнвентаризации,ОсновноеСредство,ИнвентарныйНомер"));
	
	ДополнительныеПараметры.Вставить("РазмерыРазделов",	Новый Структура());
	
	ДополнительныеПараметры.Вставить("ПрочеркиПустыхПолей", ПолучитьНастройкиПрочерковПустыхПолей());
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

Функция ПолучитьНастройкиПрочерковПустыхПолей()
	
	Разделитель = ", ";
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("Раздел1", СтрРазделить("НаименованиеЕдИзм,КодЕдИзм", Разделитель));
	ИменаПолей.Вставить("Раздел21", СтрРазделить("НаименованиеЕдИзм,КодЕдИзм,СтатусОбъекта,ЦелеваяФункцияАктива,Примечание", Разделитель));
	ИменаПолей.Вставить("Раздел22", СтрРазделить("НаименованиеЕдИзм,КодЕдИзм", Разделитель));
	ИменаПолей.Вставить("Раздел3_НаборКолонок1", СтрРазделить("НаименованиеЕдИзм,КодЕдИзм,НаименованиеДокумента,НомерДокумента,ДатаДокумента", Разделитель));
	ИменаПолей.Вставить("Раздел3_НаборКолонок2", СтрРазделить("ОбъяснениеПричинРасхождений", Разделитель));
	ИменаПолей.Вставить("Раздел4", СтрРазделить("СтатусОбъяснения,НаименованиеЕдИзм,КодЕдИзм,ЗаключениеКомиссии", Разделитель));
	
	Возврат ИнвентаризацияСервер.ПолучитьНастройкиПрочерковПустыхПолей(ИменаПолей);
	
КонецФункции

Функция ПолучитьТаблицуОтбораДляПоискаКадастровыхНомеровОС(ТаблицаСвойствНФА, ТаблицаШапок)
	
	ТаблицаОтбора = Новый ТаблицаЗначений();
	ТаблицаОтбора.Колонки.Добавить("Организация",			Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаОтбора.Колонки.Добавить("ДатаИнвентаризации",	ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаОтбора.Колонки.Добавить("НФА",					Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	
	ПоискОС = Новый Структура("ТипНфаОС", Истина);
	
	ТаблицаСвойствОС = ТаблицаСвойствНФА.Скопировать(ПоискОС, "Ссылка,НФА");
	
	ПоискОписи = Новый Структура("Ссылка");
	
	Для Каждого СтрокаТаблицы Из ТаблицаСвойствОС Цикл
		ПоискОписи.Ссылка = СтрокаТаблицы.Ссылка;
		
		МассивСтрок = ТаблицаШапок.НайтиСтроки(ПоискОписи);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаОтбора.Добавить();
		НоваяСтрока.Организация			= МассивСтрок[0].Организация;
		НоваяСтрока.ДатаИнвентаризации	= МассивСтрок[0].ДатаИнвентаризации;
		НоваяСтрока.НФА					= СтрокаТаблицы.НФА;
	КонецЦикла;
	
	ТаблицаОтбора.Свернуть("Организация,ДатаИнвентаризации,НФА");
	
	Возврат ТаблицаОтбора;
	
КонецФункции

Функция ПолучитьКадастровыйНомерОС(СтрокаТаблицыСвойствНФА, Выборка, ДополнительныеПараметры)
	
	Поиск = ДополнительныеПараметры.ПоискКадастровогоНомераОсновноеСредствоИнвентарныйНомер;
	
	ЗаполнитьЗначенияСвойств(Поиск, ДополнительныеПараметры.СтрокаШапки, "Организация,ДатаИнвентаризации");
	
	Поиск.ОсновноеСредство = Выборка.НФА;
	Поиск.ИнвентарныйНомер = Выборка.ИнвентарныйНомер;

	МассивСтрок = ДополнительныеПараметры.КадастровыеНомераОС.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МассивСтрок[0].КадастровыйНомер;
	
КонецФункции


Функция СформироватьПечатнуюФорму0510466(Данные, СтрокаШапки, ОбластиМакета, ТиповыеПараметры)
	
	Перем ОписаниеСерииДокументов, СтрокаШапкиДокументаСРаспиской;
	
	КлючПараметровПечати = "ПечатьФормы0510466";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ИнвентаризацияСервер.ЗаполнитьРазмерыРазделов(Данные, "Раздел1,Раздел21,Раздел22,Раздел3,Раздел4", СтрокаШапки.Ссылка);
	
	// СерииДокументов
	ЭтоЗаголовочныйДокумент = ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(СтрокаШапки);
	ЭтоСодержательныйДокумент = ИнвентаризацияКлиентСервер.ЭтоСодержательныйДокументСерииДокументовОписи(СтрокаШапки);
	
	Если ЭтоЗаголовочныйДокумент Или ЭтоСодержательныйДокумент Тогда
		СтрокаШапкиДокументаСРаспиской = ИнвентаризацияСервер.ПолучитьСтрокуШапкиЗаголовочногоДокумента(Данные, СтрокаШапки, ОписаниеСерииДокументов);
	Иначе
		СтрокаШапкиДокументаСРаспиской = СтрокаШапки;
	КонецЕсли;
	// Конец СерииДокументов
	
	// ЗАГОЛОВОК
	
	ЗначенияПараметров = Новый Структура();
	
	УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, СтрокаШапкиДокументаСРаспиской.Ссылка, Данные.СведенияУчреждений);
	
	ИнвентаризацияСервер.ЗаполнитьДатуНомерДокументаДляПечатиСерииДокументов(ЗначенияПараметров, СтрокаШапкиДокументаСРаспиской, СтрокаШапки);
	
	НомерРешенияОПроведенииИнвентаризации = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапкиДокументаСРаспиской.РешениеОПроведенииИнвентаризации,
		СтрокаШапкиДокументаСРаспиской.НомерРешенияОПроведенииИнвентаризации);
	
	ЗначенияПараметров.Вставить("НомерРешения",		НомерРешенияОПроведенииИнвентаризации);
	ЗначенияПараметров.Вставить("ДатаРешения",		СтрокаШапкиДокументаСРаспиской.ДатаРешенияОПроведенииИнвентаризации);
	ЗначенияПараметров.Вставить("НомерКомиссии",	ИнвентаризацияКлиентСервер.ФорматироватьПолныйНомерКомиссии(СтрокаШапкиДокументаСРаспиской.НомерКомиссии, СтрокаШапкиДокументаСРаспиской.НомерРабочейКомиссии, Истина));
	
	СведенияМОЛ = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.МОЛ, СтрокаШапки.Дата);
	
	СведенияМОЛ.Вставить("ОтветственноеЛицо", СтрШаблон("%1 %2", СведенияМОЛ.ДолжностьНаименование, СведенияМОЛ.ФИОПолное));
	
	// СерииДокументов
	ИнвентаризацияСервер.ЗаполнитьБлокСведенийСерииДокументов(ЗначенияПараметров, СтрокаШапки);
	// Конец СерииДокументов
	
	Область = ОбластиМакета.Заголовок;
	Область.Параметры.Заполнить(СтрокаШапкиДокументаСРаспиской);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапкиДокументаСРаспиской.Дата, Истина));
	Область.Параметры.Заполнить(СведенияМОЛ);
	
	// СерииДокументов
	Если ЭтоЗаголовочныйДокумент Или ЭтоСодержательныйДокумент Тогда
		ИнвентаризацияСервер.ОбвестиЗаголовокСерииДокументов(Область);
	КонецЕсли;
	// Конец СерииДокументов
	
	ТабДокумент.Вывести(Область);
	
	// СерииДокументов
	ИнвентаризацияСервер.ОбвестиЗаголовокСерииДокументов(Область, Истина);
	// Конец СерииДокументов
	
	// РАЗДЕЛ 1
	
	ВывестиРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапки.ОтветственныйИсполнительБухгалтерскойСлужбы, СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель бухгалтерской службы'"));
	
	Область = ОбластиМакета.ОтветственныйИсполнительБезТелефона;
	Область.Параметры.Заполнить(СтрокаШапки);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	
	Если Не ТабДокумент.ПроверитьВывод(Область) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 2
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ВывестиРаздел2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	// КОМИССИЯ РАЗДЕЛА 2
	
	ПараметрыВывода = УправлениеПечатьюБГУ.ПараметрыВыводаСоставаКомиссииПриПечати();
	ПараметрыВывода.ЗаголовокПредседателя			= НСтр("ru='Председатель комиссии'");
	ПараметрыВывода.ЗаголовокПервогоРядовогоЧлена	= НСтр("ru='Члены комиссии:'");
	ПараметрыВывода.ПризнакРабочейКомиссии			= ЗначениеЗаполнено(СтрокаШапкиДокументаСРаспиской.НомерРабочейКомиссии);
	ПараметрыВывода.ВыводитьДополнительныеСведения = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьПричинуОтсутствия = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьЗамещающегоСотрудника = Истина;
	
	УправлениеПечатьюБГУ.ВывестиСоставКомиссииПриПечати(ТабДокумент, СтрокаШапкиДокументаСРаспиской.Ссылка, ОбластиМакета.ЧленКомиссии, Данные.СоставКомиссииРаздел2, ПараметрыВывода);
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапкиДокументаСРаспиской.ОтветственныйИсполнитель, СтрокаШапкиДокументаСРаспиской.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель'"));
	
	Область = ОбластиМакета.ОтветственныйИсполнительСТелефоном;
	Область.Параметры.Заполнить(СтрокаШапкиДокументаСРаспиской);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 3
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	// ЗАГОЛОВОК
	КоличествоСтрок = Данные.ДополнительныеПараметры.РазмерыРазделов.Раздел21.КодСтроки;
	
	НачальныйНомер	= ?(КоличествоСтрок = 0, 0, 1);
	КонечныйНомер	= КоличествоСтрок;
	
	ФорматнаяСтрокаНомеров = "ЧН=-;ЧГ=-";
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("НачальныйНомер", Формат(НачальныйНомер, ФорматнаяСтрокаНомеров));
	ЗначенияПараметров.Вставить("КонечныйНомер", Формат(КонечныйНомер, ФорматнаяСтрокаНомеров));
	
	Область = ОбластиМакета.Раздел3Заголовок;
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	// В случае отсутствия недостачи и (или) излишков табличная часть Раздела 3 и перечень приложений к нему
	// не формируются и в копии электронной Инвентаризационной описи НФА (ф. 0510466) на бумажном носителе не отображается.
	Если Данные.ДополнительныеПараметры.РазмерыРазделов.Раздел3.НомерСтроки > 0 Тогда
		// ТАБЛИЦА
		ВывестиРаздел3(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
		
		// ПРИЛОЖЕНИЯ
		УправлениеПечатьюБГУ.ВывестиПриложенияПриПечати(ТабДокумент, СтрокаШапки.Ссылка, ОбластиМакета.Приложение);
	КонецЕсли;
	
	Область = ОбластиМакета.ОтветственныйИсполнительБезТелефона;
	СведенияМОЛ.Вставить("Заголовок", НСтр("ru='Ответственное лицо (ответственное лицо группы лиц)'"));
	Область.Параметры.Заполнить(СведенияМОЛ);
	ТабДокумент.Вывести(Область);
	
	// РАЗДЕЛ 4
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ВывестиРаздел4(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	// КОМИССИЯ РАЗДЕЛА 4
	
	ПараметрыВывода = УправлениеПечатьюБГУ.ПараметрыВыводаСоставаКомиссииПриПечати();
	ПараметрыВывода.ЗаголовокПредседателя			= НСтр("ru='Председатель комиссии'");
	ПараметрыВывода.ЗаголовокПервогоРядовогоЧлена	= НСтр("ru='Члены комиссии:'");
	ПараметрыВывода.ПризнакРабочейКомиссии			= ЗначениеЗаполнено(СтрокаШапкиДокументаСРаспиской.НомерРабочейКомиссии);
	ПараметрыВывода.ВыводитьДополнительныеСведения = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьПричинуОтсутствия = Истина;
	ПараметрыВывода.НастройкиДополнительныхСведений.ВыводитьЗамещающегоСотрудника = Истина;
	
	УправлениеПечатьюБГУ.ВывестиСоставКомиссииПриПечати(ТабДокумент, СтрокаШапкиДокументаСРаспиской.Ссылка, ОбластиМакета.ЧленКомиссии, Данные.СоставКомиссииРаздел4, ПараметрыВывода);
	
	ЗначенияПараметров = ИнвентаризацияСервер.ПолучитьСведенияОтветственногоИсполнителяДляПечати(СтрокаШапкиДокументаСРаспиской.ОтветственныйИсполнитель, СтрокаШапкиДокументаСРаспиской.Дата);
	ЗначенияПараметров.Вставить("Заголовок", НСтр("ru='Ответственный исполнитель'"));
	
	Область = ОбластиМакета.ОтветственныйИсполнительСТелефоном;
	Область.Параметры.Заполнить(СтрокаШапкиДокументаСРаспиской);
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборка = Данные.Выборки.Раздел1;
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
	
	ПараметрыВыводаТаблицы.Области.Заголовок				= ОбластиМакета.Раздел1Заголовок;
