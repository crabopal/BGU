	|	ДанныеИнвентаризации.СуммаОбесценение КАК СуммаОбесценение
	|ПОМЕСТИТЬ ДанныеДокументаИнвентаризации
	|ИЗ
	|	ДанныеДокументаИнвентаризации1 КАК ДанныеИнвентаризации,
	|	УчетПоЦМО_ИК КАК УчетПоЦМО_ИК";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Если ТипЗнч(Инвентаризация) = Тип("Массив") Тогда
		ДокументыИнвентаризации = Инвентаризация;
	Иначе	
		ДокументыИнвентаризации = Новый Массив;
		ДокументыИнвентаризации.Добавить(Инвентаризация);
	КонецЕсли;	
	Запрос.УстановитьПараметр("ДокументыИнвентаризации", ДокументыИнвентаризации);
	Запрос.УстановитьПараметр("СчетаИКМЗ", БухгалтерскийУчет.СписокСчетов("108.00, 02.6, 02.53"));
	Запрос.УстановитьПараметр("ВидСубконтоЦМО", ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	Запрос.УстановитьПараметр("СчетЗемли", БухгалтерскийУчет.СчетПоКоду("103.11"));
	УстановитьПривилегированныйРежим(Истина);
	Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

#КонецОбласти

#Область РеестрДокументовКПроводимойИнвентаризации

Функция ПрочитатьДанныеОписиДляРеестраДокументовКПроводимойИнвентаризации(ДокументСсылка) Экспорт
	
	ДанныеОписи = Отчеты.РеестрДокументовКПроводимойИнвентаризации.НовыйОбщиеДанныеОписи();
	ДанныеОписи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, ДанныеОписи);
	
	ПараметрыФункции = Новый Структура();
	ПараметрыФункции.Вставить("Ссылка", ДокументСсылка);
	ПрочитатьПараметрыФункцииПоСсылке_ДанныеДляРаздела1(ПараметрыФункции);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДанныеОписи, ПараметрыФункции, Истина);
	
	Возврат ДанныеОписи;
	
КонецФункции

Процедура ПроверитьДанныеОписиДляРеестраДокументовКПроводимойИнвентаризации(Знач ДанныеОписи, Отказ) Экспорт
	
	Отчеты.РеестрДокументовКПроводимойИнвентаризации.ПроверитьОбщиеДанныеОписи(ДанныеОписи, Отказ);
	
	ШаблонСообщения = Отчеты.РеестрДокументовКПроводимойИнвентаризации.ПолучитьШаблонСообщенияПроверкиПередФормированиемРеестра();
	
	Если Не ЗначениеЗаполнено(ДанныеОписи.МОЛ) Тогда
		ТекстСообщения = СтрШаблон(ШаблонСообщения,
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru='Ответственное лицо'")));
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДанныеОписи.Ссылка, "МОЛ", "Объект", Отказ);
	КонецЕсли;
	
	Если ДанныеОписи.СписокСчетов.Количество() = 0 Тогда
		ТекстСообщения = СтрШаблон(ШаблонСообщения,
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Список", "Заполнение",,, НСтр("ru='Список счетов'")));
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДанныеОписи.Ссылка, "СписокСчетов", "Объект", Отказ);
	КонецЕсли;
	
	Если ДанныеОписи.МестаИнвентаризации.Количество() = 0 Тогда
		ТекстСообщения = СтрШаблон(ШаблонСообщения,
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Список", "Заполнение",,, НСтр("ru='Места инвентаризации'")));
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДанныеОписи.Ссылка, "МестаИнвентаризации", "Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиДокументыДляРеестраДокументовКПроводимойИнвентаризации(ДанныеОписи, ПериодФормирования) Экспорт
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаОстатков(ДанныеОписи);
	
	НаДату = ПериодФормирования.Дата1;
	
	СписокБалансовыхСчетовДляПоискаПереданныхОбъектов = ПолучитьБалансовыеСчетаПереданныхОбъектовОС(НаДату);
	СписокЗабалансовыхСчетовДляПоискаПереданныхОбъектовПоСпискуОС = ПолучитьЗабалансовыеСчетаПереданныхОбъектовОС(НаДату);
	
	ЗапросДокументы = Новый Запрос();
	
	ЗапросДокументы.УстановитьПараметр("ДатаНачала",						НачалоДня(ПериодФормирования.Дата1));
	ЗапросДокументы.УстановитьПараметр("ДатаОкончания",						КонецДня(ПериодФормирования.Дата2));
	ЗапросДокументы.УстановитьПараметр("Организация",						ПараметрыПоиска.Организация);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьУчетПоИФО",				ПараметрыПоиска.ИспользоватьУчетПоИФО);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоИФО",			ПараметрыПоиска.ИспользоватьОтборПоИФО);
	ЗапросДокументы.УстановитьПараметр("ИФО",								ПараметрыПоиска.ИФО);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	ПараметрыПоиска.ИспользоватьОтборПоПодразделению);
	ЗапросДокументы.УстановитьПараметр("СписокПодразделений",				ПараметрыПоиска.СписокПодразделений);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоКФО",			ПараметрыПоиска.ИспользоватьОтборПоКФО);
	ЗапросДокументы.УстановитьПараметр("СписокКФО",							ПараметрыПоиска.СписокКФО);
	ЗапросДокументы.УстановитьПараметр("СписокСчетов",						ПараметрыПоиска.СписокСчетов);
	ЗапросДокументы.УстановитьПараметр("ТаблицаИсключаемыхСчетов",			ПараметрыПоиска.ТаблицаИсключаемыхСчетов);
	ЗапросДокументы.УстановитьПараметр("СписокЦМО",							ПараметрыПоиска.СписокЦМО);
	ЗапросДокументы.УстановитьПараметр("СписокКонтрагентов",				ПараметрыПоиска.СписокКонтрагентов);
	
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборОС",				ПараметрыПоиска.ИспользоватьОтборОС);
	ЗапросДокументы.УстановитьПараметр("СписокОС",							ПараметрыПоиска.СписокОС);
	
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборНоменклатуры",		ПараметрыПоиска.ИспользоватьОтборНоменклатуры);
	ЗапросДокументы.УстановитьПараметр("СписокНоменклатуры",				ПараметрыПоиска.СписокНоменклатуры);
	
	// Поиск переданных объектов ОС.
	ЗапросДокументы.УстановитьПараметр("ОписьСсылка",													ДанныеОписи.Ссылка);
	ЗапросДокументы.УстановитьПараметр("СписокБалансовыхСчетовДляПоискаПереданныхОбъектов",				СписокБалансовыхСчетовДляПоискаПереданныхОбъектов);
	ЗапросДокументы.УстановитьПараметр("СписокЗабалансовыхСчетовДляПоискаПереданныхОбъектовПоСпискуОС",	СписокЗабалансовыхСчетовДляПоискаПереданныхОбъектовПоСпискуОС);
	
	ЗапросДокументы.Текст = ПолучитьТекстЗапросаДокументыДвиженияНФА();
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаДокументов = ЗапросДокументы.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТаблицаДокументов;
	
КонецФункции

#КонецОбласти

