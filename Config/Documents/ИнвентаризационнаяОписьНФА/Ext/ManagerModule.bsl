	|			ВЫРАЗИТЬ(Субконто3 КАК Справочник.ЦМО)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Счет В(&СписокСчетовДляВыбораКонтрагента) ТОГДА
	|			ВЫБОР
	|				КОГДА Субконто1 ССЫЛКА Справочник.Контрагенты ТОГДА
	|					ВЫРАЗИТЬ(Субконто1 КАК Справочник.Контрагенты)
	|				КОГДА Субконто2 ССЫЛКА Справочник.Контрагенты ТОГДА
	|					ВЫРАЗИТЬ(Субконто2 КАК Справочник.Контрагенты)
	|				КОГДА Субконто3 ССЫЛКА Справочник.Контрагенты ТОГДА
	|					ВЫРАЗИТЬ(Субконто3 КАК Справочник.Контрагенты)
	|					
	|				КОГДА Субконто1 ССЫЛКА Справочник.Договоры ТОГДА
	|					ЕСТЬNULL(ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|				КОГДА Субконто2 ССЫЛКА Справочник.Договоры ТОГДА
	|					ЕСТЬNULL(ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|				КОГДА Субконто3 ССЫЛКА Справочник.Договоры ТОГДА
	|					ЕСТЬNULL(ВЫРАЗИТЬ(Субконто3 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|					
	|				ИНАЧЕ
	|					ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			КОНЕЦ
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ,
	|	Счет,
	|	КПС,
	|	КФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ЕСТЬNULL(ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			ЕСТЬNULL(Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	Счет,
	|	Подразделение,
	|	ЦМО,
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Остатки для инв.номеров из регистров накопления
	|//
	|ВЫБРАТЬ
	|	ОсновноеСредство			КАК ОсновноеСредство,
	|	ИнвентарныйНомер			КАК ИнвентарныйНомер,
	|	ЦМО							КАК ЦМО,
	|	Контрагент					КАК Контрагент,
	|	Договор						КАК Договор,
	|	Подразделение				КАК Подразделение,
	|	ВидРаспоряжения				КАК ВидРаспоряжения,
	|	СУММА(СтоимостьОстаток)		КАК СтоимостьОстаток,
	|	СУММА(КоличествоОстаток)	КАК КоличествоОстаток
	|ПОМЕСТИТЬ
	|	ОстаткиИнвНомера
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОсновноеСредство								КАК ОсновноеСредство,
	|		ИнвентарныйНомер								КАК ИнвентарныйНомер,
	|		ЦМО												КАК ЦМО,
	|		ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)	КАК Контрагент,
	|		Договор											КАК Договор,
	|		ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|				Подразделение
	|			ИНАЧЕ
	|				ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОНЕЦ											КАК Подразделение,
	|		ВидРаспоряжения									КАК ВидРаспоряжения,
	|		СтоимостьОстаток								КАК СтоимостьОстаток,
	|		КоличествоОстаток								КАК КоличествоОстаток
	|	ИЗ
	|		РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&ДатаОстатков,
	|			Организация = &Организация
	|			И ВидРаспоряжения В(&ВидыРаспоряженияОСРегистрСтоимостьОбъектовОС)
	|			И ОсновноеСредство В (ВЫБРАТЬ ОсновноеСредство ИЗ ОстаткиБУ)
	|			И ЦМО В(&СписокЦМО)
	|		)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ОсновноеСредство		КАК ОсновноеСредство,
	|		ИнвентарныйНомер		КАК ИнвентарныйНомер,
	|		ЦМО						КАК ЦМО,
	|		Контрагент				КАК Контрагент,
	|		Договор					КАК Договор,
	|		ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|				Подразделение
	|			ИНАЧЕ
	|				ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОНЕЦ					КАК Подразделение,
	|		ВидРаспоряжения			КАК ВидРаспоряжения,
	|		СтоимостьОстаток		КАК СтоимостьОстаток,
	|		КоличествоОстаток		КАК КоличествоОстаток
	|	ИЗ
	|		РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
	|			&ДатаОстатков,
	|			Организация = &Организация
	|			И ВидРаспоряжения В(&ВидыРаспоряженияОСРегистрСтоимостьОбъектовОСПоКонтрагентамСОтборомПоЦМО)
	|			И ОсновноеСредство В (ВЫБРАТЬ ОсновноеСредство ИЗ ОстаткиБУ)
	|			И ЦМО В(&СписокЦМО)
	|		)
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ОсновноеСредство		КАК ОсновноеСредство,
	|		ИнвентарныйНомер		КАК ИнвентарныйНомер,
	|		ЦМО						КАК ЦМО,
	|		Контрагент				КАК Контрагент,
	|		Договор					КАК Договор,
	|		ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|				Подразделение
	|			ИНАЧЕ
	|				ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОНЕЦ					КАК Подразделение,
	|		ВидРаспоряжения			КАК ВидРаспоряжения,
	|		СтоимостьОстаток		КАК СтоимостьОстаток,
	|		КоличествоОстаток		КАК КоличествоОстаток
	|	ИЗ
	|		РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
	|			&ДатаОстатков,
	|			Организация = &Организация
	|			И ВидРаспоряжения В(&ВидыРаспоряженияОСРегистрСтоимостьОбъектовОСПоКонтрагентамБезОтбораПоЦМО)
	|			И ОсновноеСредство В (ВЫБРАТЬ ОсновноеСредство ИЗ ОстаткиБУ)
	|		)
	|	) КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер,
	|	ЦМО,
	|	Контрагент,
	|	Договор,
	|	Подразделение,
	|	ВидРаспоряжения
	|ИМЕЮЩИЕ
	|	НЕ (СУММА(СтоимостьОстаток) = 0 И СУММА(КоличествоОстаток) = 0)
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	Подразделение,
	|	ЦМО,
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Применяемые остатки в разрезе инв.номеров
	|//
	|ВЫБРАТЬ
	|	ВТ.ОсновноеСредство										КАК ОсновноеСредство,
	|	ВТ.ОсновноеСредство.Наименование						КАК НаименованиеОсновногоСредства,
	|	ВТ.ИнвентарныйНомер										КАК ИнвентарныйНомер,
	|	ЕСТЬNULL(ВТ.ИнвентарныйНомер.Код, """")					КАК КодИнвентарногоНомера,
	|	ВТ.ЦМО													КАК ЦМО,
	|	ЕСТЬNULL(СправочникЦМО.МестоХранения,
	|		ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка))	КАК МестоХранения,
	|	ВТ.Контрагент											КАК Контрагент,
	|	ВТ.Счет													КАК Счет,
	|	ВТ.Счет.Порядок											КАК ПорядокСчета,
	|	ВЫБОР
	|		КОГДА (ВТ.Счет В (&СчетаУстановкиКоличестваПоУмолчанию)) ТОГДА
	|			&ПустаяЕдИзм
	|		ИНАЧЕ
	|			&ЕдИзмШт
	|	КОНЕЦ													КАК ЕдИзм,
	|	(ВТ.Счет В (&СчетаУстановкиКоличестваПоУмолчанию))		КАК ЭтоСчетУстановкиКоличестваПоУмолчанию,
	|	ВТ.КПС													КАК КПС,
	|	ВТ.КФО													КАК КФО,
	|	ВТ.ИФО													КАК ИФО,
	|	ВТ.Подразделение										КАК Подразделение,
	|	ВТ.ВидРаспоряжения										КАК ВидРаспоряжения,
	|	СУММА(ВТ.СуммаОстаток)									КАК СуммаОстаток,
	|	СУММА(ВТ.КоличествоОстаток)								КАК КоличествоОстаток
	|ИЗ
	|	(// Соединение по полям ЦМО и Контрагент
	|	ВЫБРАТЬ
	|		ОстаткиБУ.ОсновноеСредство									КАК ОсновноеСредство,
	|		ЕСТЬNULL(
	|			ОстаткиИнвНомера.ИнвентарныйНомер,
	|			ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))	КАК ИнвентарныйНомер,
	|		ОстаткиБУ.ЦМО												КАК ЦМО,
	|		ОстаткиБУ.Контрагент										КАК Контрагент,
	|		ОстаткиБУ.Счет												КАК Счет,
	|		ОстаткиБУ.КПС												КАК КПС,
	|		ОстаткиБУ.КФО												КАК КФО,
	|		ОстаткиБУ.ИФО												КАК ИФО,
	|		ОстаткиБУ.Подразделение										КАК Подразделение,
	|		ЕСТЬNULL(
	|			ОстаткиИнвНомера.ВидРаспоряжения,
	|			ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПустаяСсылка))	КАК ВидРаспоряжения,
	|		ВЫБОР
	|			КОГДА ОстаткиБУ.Счет В(&СчетаИсточникСуммРегистрБухгалтерии) ТОГДА
	|				ЕСТЬNULL(ОстаткиБУ.СуммаОстаток, 0)
	|			ИНАЧЕ
	|				ЕСТЬNULL(ОстаткиИнвНомера.СтоимостьОстаток, ОстаткиБУ.СуммаОстаток)
	|		КОНЕЦ														КАК СуммаОстаток,
	|		ВЫБОР
	|			КОГДА ОстаткиБУ.Счет В(&СчетаИсточникСуммРегистрБухгалтерии) ТОГДА
	|				ЕСТЬNULL(ОстаткиБУ.КоличествоОстаток, 0)
	|			ИНАЧЕ
	|				ЕСТЬNULL(ОстаткиИнвНомера.КоличествоОстаток, ОстаткиБУ.КоличествоОстаток)
	|		КОНЕЦ														КАК КоличествоОстаток
	|	ИЗ
	|		ОстаткиБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаВидыРаспоряженияОС
	|			ПО	ОстаткиБУ.Счет = ТаблицаВидыРаспоряженияОС.Счет
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиИнвНомера
	|			ПО	ОстаткиБУ.ОсновноеСредство	= ОстаткиИнвНомера.ОсновноеСредство
	|			И	ОстаткиБУ.ЦМО				= ОстаткиИнвНомера.ЦМО
	|			И	ОстаткиБУ.Контрагент		= ОстаткиИнвНомера.Контрагент
	|			И	ОстаткиБУ.Подразделение		= ОстаткиИнвНомера.Подразделение
	|			И	ЕСТЬNULL(ТаблицаВидыРаспоряженияОС.ВидРаспоряжения,
	|					ВЫБОР
	|						КОГДА ОстаткиБУ.Счет.Забалансовый ТОГДА
	|							ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПустаяСсылка)
	|						ИНАЧЕ
	|							ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|					КОНЕЦ) = ОстаткиИнвНомера.ВидРаспоряжения
	|	ГДЕ
	|		ОстаткиБУ.ЦМО <> ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	|		И НЕ ЕСТЬNULL(
	|			ТаблицаВидыРаспоряженияОС.ВидРаспоряжения,
	|			ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПустаяСсылка))	В(&ВидыРаспоряженияОСПереданныеОбъекты)
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	// Соединение по полю Контрагент
	|	ВЫБРАТЬ
	|		ОстаткиБУ.ОсновноеСредство									КАК ОсновноеСредство,
	|		ЕСТЬNULL(
	|			ОстаткиИнвНомера.ИнвентарныйНомер,
	|			ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))	КАК ИнвентарныйНомер,
	|		ОстаткиБУ.ЦМО												КАК ЦМО,
	|		ОстаткиБУ.Контрагент										КАК Контрагент,
	|		ОстаткиБУ.Счет												КАК Счет,
	|		ОстаткиБУ.КПС												КАК КПС,
	|		ОстаткиБУ.КФО												КАК КФО,
	|		ОстаткиБУ.ИФО												КАК ИФО,
	|		ОстаткиБУ.Подразделение										КАК Подразделение,
	|		ЕСТЬNULL(
	|			ОстаткиИнвНомера.ВидРаспоряжения,
	|			ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПустаяСсылка))	КАК ВидРаспоряжения,
	|		ВЫБОР
	|			КОГДА ОстаткиБУ.Счет В(&СчетаИсточникСуммРегистрБухгалтерии) ТОГДА
	|				ЕСТЬNULL(ОстаткиБУ.СуммаОстаток, 0)
	|			ИНАЧЕ
	|				ЕСТЬNULL(ОстаткиИнвНомера.СтоимостьОстаток, ОстаткиБУ.СуммаОстаток)
	|		КОНЕЦ														КАК СуммаОстаток,
	|		ВЫБОР
	|			КОГДА ОстаткиБУ.Счет В(&СчетаИсточникСуммРегистрБухгалтерии) ТОГДА
	|				ЕСТЬNULL(ОстаткиБУ.КоличествоОстаток, 0)
	|			ИНАЧЕ
	|				ЕСТЬNULL(ОстаткиИнвНомера.КоличествоОстаток, ОстаткиБУ.КоличествоОстаток)
	|		КОНЕЦ														КАК КоличествоОстаток
	|	ИЗ
	|		ОстаткиБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаВидыРаспоряженияОС
	|			ПО	ОстаткиБУ.Счет = ТаблицаВидыРаспоряженияОС.Счет
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиИнвНомера
	|			ПО	ОстаткиБУ.ОсновноеСредство	= ОстаткиИнвНомера.ОсновноеСредство
	|			И	ОстаткиБУ.Контрагент		= ОстаткиИнвНомера.Контрагент
	|			И	ОстаткиБУ.Подразделение		= ОстаткиИнвНомера.Подразделение
	|			И	ЕСТЬNULL(ТаблицаВидыРаспоряженияОС.ВидРаспоряжения,
	|					ВЫБОР
	|						КОГДА ОстаткиБУ.Счет.Забалансовый ТОГДА
	|							ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПустаяСсылка)
	|						ИНАЧЕ
	|							ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|					КОНЕЦ) = ОстаткиИнвНомера.ВидРаспоряжения
	|	ГДЕ
	|		ОстаткиБУ.ЦМО = ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	|		И НЕ ЕСТЬNULL(
	|			ТаблицаВидыРаспоряженияОС.ВидРаспоряжения,
	|			ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПустаяСсылка))	В(&ВидыРаспоряженияОСПереданныеОбъекты)
	|	) КАК ВТ
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ВТ.ЦМО = СправочникЦМО.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ВТ.ОсновноеСредство,
	|	ВТ.ОсновноеСредство.Наименование,
	|	ВТ.ИнвентарныйНомер,
	|	ЕСТЬNULL(ВТ.ИнвентарныйНомер.Код, """"),
	|	ВТ.ЦМО,
	|	ЕСТЬNULL(СправочникЦМО.МестоХранения,
	|		ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)),
	|	ВТ.Контрагент,
	|	ВТ.Счет,
	|	ВТ.Счет.Порядок,
	|	ВЫБОР
	|		КОГДА (ВТ.Счет В (&СчетаУстановкиКоличестваПоУмолчанию)) ТОГДА
	|			&ПустаяЕдИзм
	|		ИНАЧЕ
	|			&ЕдИзмШт
	|	КОНЕЦ,
	|	(ВТ.Счет В (&СчетаУстановкиКоличестваПоУмолчанию)),
	|	ВТ.КПС,
	|	ВТ.КФО,
	|	ВТ.ИФО,
	|	ВТ.Подразделение,
	|	ВТ.ВидРаспоряжения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Остатки по переданным объектам ОС, которые должны быть отражены
	|//		в соответствующих балансовых остатках по счетам 101.00, 103.00
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОстаткиИнвНомера.ОсновноеСредство						КАК ОсновноеСредство,
	|	ОстаткиИнвНомера.ИнвентарныйНомер						КАК ИнвентарныйНомер,
	|	ОстаткиИнвНомера.ЦМО									КАК ЦМО,
	|	ЕСТЬNULL(СправочникЦМО.МестоХранения,
	|		ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка))	КАК МестоХранения,
	|	ОстаткиИнвНомера.Контрагент								КАК Контрагент,
	|	ОстаткиИнвНомера.Договор								КАК Договор,
	|	ОстаткиИнвНомера.Подразделение							КАК Подразделение,
	|	ОстаткиИнвНомера.ВидРаспоряжения						КАК ВидРаспоряжения
	|ИЗ
	|	ОстаткиИнвНомера
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО ОстаткиИнвНомера.ЦМО = СправочникЦМО.Ссылка
	|ГДЕ
	|	ОстаткиИнвНомера.ВидРаспоряжения В(&ВидыРаспоряженияОСПереданныеОбъекты)";
	
КонецФункции

Функция ПолучитьТекстЗапросаОстаткиМЗ()
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исключаемые счета
	|//
	|ВЫБРАТЬ
	|	ТЗ.КФО	КАК КФО,
	|	ТЗ.Счет	КАК Счет
	|ПОМЕСТИТЬ
	|	ТаблицаИсключаемыхСчетов
	|ИЗ
	|	&ТаблицаИсключаемыхСчетов КАК ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	КФО,
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Все остатки по полным счетам, с отбором по МОЛ.
	|//		Т.к. применяется отбор по МОЛ, то могут быть остатки с нулевыми суммами
	|//		(если на соответствующих счетах не ведется суммовой учет по субконто для МОЛ)
	|//
	|ВЫБРАТЬ
	|	Счет						КАК Счет,
	|	КПС							КАК КПС,
	|	КФО							КАК КФО,
	|	ИФО							КАК ИФО,
	|	Подразделение				КАК Подразделение,
	|	ЦМО 						КАК ЦМО,
	|	Контрагент					КАК Контрагент,
	|	Номенклатура				КАК Номенклатура,
	|	СУММА(КоличествоОстаток)	КАК КоличествоОстаток,
	|	СУММА(СуммаОстаток)			КАК СуммаОстаток
	|ПОМЕСТИТЬ
	|	ОстаткиСОтборомПоМОЛ
	|ИЗ
	|	(// МОЛ определяется из субконто ЦМО
	|	ВЫБРАТЬ
	|		Остатки.Счет																			КАК Счет,
	|		ЕСТЬNULL(Остатки.КПС,ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка))	КАК КПС,
	|		Остатки.КФО																				КАК КФО,
	|		ВЫБОР
	|			КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|				Остатки.ИФО
	|			ИНАЧЕ
	|				ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|		КОНЕЦ																					КАК ИФО,
	|		ЕСТЬNULL(Остатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))		КАК Подразделение,
	|		Остатки.Субконто1																		КАК Номенклатура,
	|		Остатки.Субконто2 																		КАК ЦМО,
	|		ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)											КАК Контрагент,
	|		Остатки.КоличествоОстатокДт - Остатки.КоличествоОстатокКт								КАК КоличествоОстаток,
	|		Остатки.СуммаОстатокДт - Остатки.СуммаОстатокКт											КАК СуммаОстаток
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаОстатков,					// 1 Период
	|			Счет В (&СписокСчетов),			// 2 Условие счета
	|			&ВидыСубконтоНоменклатураЦМО,	// 3 Виды субконто
	|			Организация = &Организация		// 4 Условие
	|			И ВЫБОР 
	|				КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|					ИФО = &ИФО
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ
	|			И ВЫБОР 
	|				КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|					КФО В(&СписокКФО)
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ
	|			И ВЫБОР 
	|				КОГДА &ИспользоватьОтборПоПодразделению ТОГДА
	|					Подразделение В(&СписокПодразделений)
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ
	|			// Отбор по МОЛ
	|			И Субконто2 В (&СписокЦМО)
	|		) КАК Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|			ПО Остатки.Субконто1 = СправочникНоменклатура.Ссылка
	|	ГДЕ
	|		НЕ (Остатки.КФО, Остатки.Счет) В (ВЫБРАТЬ КФО, Счет ИЗ ТаблицаИсключаемыхСчетов)
	|		И НЕ СправочникНоменклатура.ТипНоменклатуры В(&ИсключаемыеТипыНоменклатуры)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	// МОЛ определяется из субконто Контрагенты
	|	ВЫБРАТЬ
	|		Остатки.Счет																			КАК Счет,
	|		ЕСТЬNULL(Остатки.КПС,ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка))	КАК КПС,
	|		Остатки.КФО																				КАК КФО,
	|		ВЫБОР
	|			КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|				Остатки.ИФО
	|			ИНАЧЕ
	|				ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|		КОНЕЦ																					КАК ИФО,
	|		ЕСТЬNULL(Остатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))		КАК Подразделение,
	|		Остатки.Субконто1																		КАК Номенклатура,
	|		ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)													КАК ЦМО,
	|		Остатки.Субконто2 																		КАК Контрагент,
	|		Остатки.КоличествоОстатокДт - Остатки.КоличествоОстатокКт								КАК КоличествоОстаток,
	|		Остатки.СуммаОстатокДт - Остатки.СуммаОстатокКт											КАК СуммаОстаток
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаОстатков,							// 1 Период
	|			Счет В (&СписокСчетов),					// 2 Условие счета
	|			&ВидыСубконтоНоменклатураКонтрагенты,	// 3 Виды субконто
	|			Организация = &Организация				// 4 Условие
	|			И ВЫБОР 
	|				КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|					ИФО = &ИФО
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ
	|			И ВЫБОР 
	|				КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|					КФО В(&СписокКФО)
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ
	|			И ВЫБОР 
	|				КОГДА &ИспользоватьОтборПоПодразделению ТОГДА
	|					Подразделение В(&СписокПодразделений)
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ
	|			// Отбор по МОЛ
	|			И Субконто2 В (&СписокКонтрагентов)
	|		) КАК Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|			ПО Остатки.Субконто1 = СправочникНоменклатура.Ссылка
	|	ГДЕ
	|		НЕ (Остатки.КФО, Остатки.Счет) В (ВЫБРАТЬ КФО, Счет ИЗ ТаблицаИсключаемыхСчетов)
	|		И НЕ СправочникНоменклатура.ТипНоменклатуры В(&ИсключаемыеТипыНоменклатуры)
	|	) КАК Остатки
	|СГРУППИРОВАТЬ ПО
	|	Счет,
	|	КПС,
	|	КФО,
	|	ИФО,
	|	Подразделение,
	|	ЦМО,
	|	Контрагент,
	|	Номенклатура
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет,
	|	КПС,
	|	КФО,
	|	ИФО,
	|	Подразделение,
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Все остатки по полным счетам, без отбора по МОЛ.
	|//		Т.к. отбор по МОЛ не применяется, то в остатках будет заполнена сумма,
	|//		вне зависимости от ведения суммового учета по субконто ЦМО или Контрагенты
	|//
	|ВЫБРАТЬ
	|	Счет																			КАК Счет,
	|	ЕСТЬNULL(КПС,ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка))	КАК КПС,
	|	КФО																				КАК КФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ИФО
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ																			КАК ИФО,
	|	ЕСТЬNULL(Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))		КАК Подразделение,
	|	Субконто1																		КАК Номенклатура,
	|	СУММА(КоличествоОстатокДт - КоличествоОстатокКт)								КАК КоличествоОстаток,
	|	СУММА(СуммаОстатокДт - СуммаОстатокКт)											КАК СуммаОстаток
	|ПОМЕСТИТЬ
	|	ОстаткиБезОтбораПоМОЛ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ДатаОстатков,				// 1 Период
	|		Счет В (&СписокСчетов),		// 2 Условие счета
	|		&ВидыСубконтоНоменклатура,	// 3 Виды субконто
	|		Организация = &Организация	// 4 Условие
	|		И Субконто1 В(ВЫБРАТЬ Номенклатура ИЗ ОстаткиСОтборомПоМОЛ)
	|		И ВЫБОР 
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР 
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО В(&СписокКФО)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР 
	|			КОГДА &ИспользоватьОтборПоПодразделению ТОГДА
	|				Подразделение В(&СписокПодразделений)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		// Только заполненная номенклатура
	|		И Субконто1 <> &ПустаяНоменклатура
	|		// Отбор по номенклатуре
	|		И (Субконто1 В (&СписокНоменклатуры) ИЛИ НЕ &ИспользоватьОтборНоменклатуры)
	|	)	КАК Остатки
	|	ГДЕ
	|		НЕ (КФО, Счет) В (ВЫБРАТЬ КФО, Счет ИЗ ТаблицаИсключаемыхСчетов)
	|СГРУППИРОВАТЬ ПО
	|	Счет,
	|	ЕСТЬNULL(КПС,ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)),
	|	КФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ИФО
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ЕСТЬNULL(Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)),
	|	Субконто1
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет,
	|	КПС,
	|	КФО,
	|	ИФО,
	|	Подразделение,
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Определена балансовая стоимость из остатков по МОЛ
	|//
	|ВЫБРАТЬ
	|	ОстаткиСОтборомПоМОЛ.Счет								КАК Счет,
	|	ОстаткиСОтборомПоМОЛ.Счет.Порядок						КАК ПорядокСчета,
	|	ОстаткиСОтборомПоМОЛ.КПС								КАК КПС,
	|	ОстаткиСОтборомПоМОЛ.КФО								КАК КФО,
	|	ОстаткиСОтборомПоМОЛ.ИФО								КАК ИФО,
	|	ОстаткиСОтборомПоМОЛ.Подразделение						КАК Подразделение,
	|	ОстаткиСОтборомПоМОЛ.ЦМО								КАК ЦМО,
	|	ЕСТЬNULL(СправочникЦМО.МестоХранения,
	|		ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка))	КАК МестоХранения,
	|	ОстаткиСОтборомПоМОЛ.Контрагент							КАК Контрагент,
	|	ОстаткиСОтборомПоМОЛ.Номенклатура						КАК Номенклатура,
	|	СправочникНоменклатура.Наименование						КАК НаименованиеНоменклатуры,
	|	СправочникНоменклатура.ЕдиницаИзмерения					КАК ЕдИзм,
	|	(ОстаткиСОтборомПоМОЛ.Счет В(&СчетаУстановкиКоличестваПоУмолчанию))	КАК ЭтоСчетУстановкиКоличестваПоУмолчанию,
	|	СУММА(ОстаткиСОтборомПоМОЛ.КоличествоОстаток)			КАК КоличествоОстаток,
	|	
	|	// Балансовая стоимость
	|	СУММА(ВЫБОР
	|		КОГДА ОстаткиСОтборомПоМОЛ.СуммаОстаток <> 0 ТОГДА
	|			ОстаткиСОтборомПоМОЛ.СуммаОстаток
	|		КОГДА ОстаткиБезОтбораПоМОЛ.КоличествоОстаток = 0 ТОГДА
	|			0
	|		ИНАЧЕ
	|			ВЫРАЗИТЬ(ОстаткиБезОтбораПоМОЛ.СуммаОстаток * ОстаткиСОтборомПоМОЛ.КоличествоОстаток
	|				/ ОстаткиБезОтбораПоМОЛ.КоличествоОстаток КАК ЧИСЛО(18,2))
	|	КОНЕЦ)											КАК СуммаОстаток
	|ИЗ
	|	ОстаткиБезОтбораПоМОЛ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиСОтборомПоМОЛ
	|		ПО	ОстаткиБезОтбораПоМОЛ.Счет			= ОстаткиСОтборомПоМОЛ.Счет
	|		И	ОстаткиБезОтбораПоМОЛ.КПС			= ОстаткиСОтборомПоМОЛ.КПС
	|		И	ОстаткиБезОтбораПоМОЛ.КФО			= ОстаткиСОтборомПоМОЛ.КФО
	|		И	ОстаткиБезОтбораПоМОЛ.ИФО			= ОстаткиСОтборомПоМОЛ.ИФО
	|		И	ОстаткиБезОтбораПоМОЛ.Подразделение	= ОстаткиСОтборомПоМОЛ.Подразделение
	|		И	ОстаткиБезОтбораПоМОЛ.Номенклатура	= ОстаткиСОтборомПоМОЛ.Номенклатура
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО	ОстаткиСОтборомПоМОЛ.Номенклатура = СправочникНоменклатура.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЦМО КАК СправочникЦМО
	|		ПО	ОстаткиСОтборомПоМОЛ.ЦМО = СправочникЦМО.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиСОтборомПоМОЛ.Счет,
	|	ОстаткиСОтборомПоМОЛ.КПС,
	|	ОстаткиСОтборомПоМОЛ.КФО,
	|	ОстаткиСОтборомПоМОЛ.ИФО,
	|	ОстаткиСОтборомПоМОЛ.Подразделение,
	|	ОстаткиСОтборомПоМОЛ.ЦМО,
	|	ЕСТЬNULL(СправочникЦМО.МестоХранения,
	|		ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)),
	|	ОстаткиСОтборомПоМОЛ.Контрагент,
	|	ОстаткиСОтборомПоМОЛ.Номенклатура,
	|	СправочникНоменклатура.Наименование,
	|	СправочникНоменклатура.ЕдиницаИзмерения,
	|	(ОстаткиСОтборомПоМОЛ.Счет В(&СчетаУстановкиКоличестваПоУмолчанию))";
	
КонецФункции

Функция ПолучитьПараметрыПоискаОстатков(Знач ПараметрыФункции)
	
	ИспользоватьУчетПоИФО				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	ДобавитьЗабалансовыеСчетаОС(ПараметрыФункции);
	
	НастройкиОтбораСчетовИКФО = ИнвентаризацияСервер.ПолучитьНастройкиОтбораСчетовИКФО(ПараметрыФункции.СписокСчетов, ПараметрыФункции.ДатаИнвентаризации);
	
	ИсключитьСчетаНеСоответствующиеНастройкамЗаполненияОписиПоРешению(НастройкиОтбораСчетовИКФО.СписокСчетов, ПараметрыФункции);
	
	ДатаОстатков = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков(ПараметрыФункции.ДатаИнвентаризации);
	
	Счета10600 = ПолучитьСчета10600(ДатаОстатков);
	
	СписокПодразделений = Новый Массив();
	СписокПодразделений.Добавить(ПараметрыФункции.Подразделение);
	
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("ДатаОстатков",						ДатаОстатков);
	ПараметрыПоиска.Вставить("Организация",							ПараметрыФункции.Организация);
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоИФО",				ИспользоватьУчетПоИФО);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоИФО",				ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ПараметрыФункции.ИФО));
	ПараметрыПоиска.Вставить("ИФО",									ПараметрыФункции.ИФО);
	ПараметрыПоиска.Вставить("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоПодразделению",	ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(ПараметрыФункции.Подразделение));
	ПараметрыПоиска.Вставить("СписокПодразделений",					СписокПодразделений);
	
	ПараметрыПоиска.Вставить("ИспользоватьОтборПоКФО",				НастройкиОтбораСчетовИКФО.ИспользоватьОтборПоКФО);
	ПараметрыПоиска.Вставить("СписокКФО",							НастройкиОтбораСчетовИКФО.СписокКФО);
	ПараметрыПоиска.Вставить("СписокСчетов",						НастройкиОтбораСчетовИКФО.СписокСчетов);
	ПараметрыПоиска.Вставить("ТаблицаИсключаемыхСчетов",			НастройкиОтбораСчетовИКФО.ДетальнаяТаблицаИсключаемыеСчета);
	
	ПараметрыПоиска.Вставить("ЕдИзмШт",		Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	ПараметрыПоиска.Вставить("ПустаяЕдИзм",	Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
	
	// Места инвентаризации
	
	ДиагностикаМестИнвентаризации = ДиагностироватьМестаИнвентаризации(ПараметрыФункции.МестаИнвентаризации);
	
	ПараметрыПоиска.Вставить("ДиагностикаМестИнвентаризации",	ДиагностикаМестИнвентаризации);
	
	// Отбор МОЛ
	
	СпискиМОЛ = ПолучитьСпискиМОЛ(ПараметрыФункции.МОЛ, ДиагностикаМестИнвентаризации);
	
	ПараметрыПоиска.Вставить("СписокЦМО",			СпискиМОЛ.СписокЦМО);
	ПараметрыПоиска.Вставить("СписокКонтрагентов",	СпискиМОЛ.СписокКонтрагентов);
	
	// Отбор по списку НФА
	
	ИспользоватьОтборПоНФА = (ПараметрыФункции.ЭтоВыборочнаяИнвентаризация И ПараметрыФункции.СписокНФА.Количество() > 0);
	
	Если ИспользоватьОтборПоНФА Тогда
		Поиск = Новый Структура("ТипНфаОС", Истина);
		
		ВремТаблица = ПараметрыФункции.СписокНФА.Скопировать(Поиск);
		ВремТаблица.Свернуть("НФА");
		
		СписокОС = ВремТаблица.ВыгрузитьКолонку("НФА");
		
		ИспользоватьОтборОС = Истина;
		
		Поиск = Новый Структура("ТипНфаНоменклатура", Истина);
		
		ВремТаблица = ПараметрыФункции.СписокНФА.Скопировать(Поиск);
		ВремТаблица.Свернуть("НФА");
		
		СписокНоменклатуры = ВремТаблица.ВыгрузитьКолонку("НФА");
		
		ИспользоватьОтборНоменклатуры = Истина;
	Иначе
		СписокОС = Новый Массив();
		
		ИспользоватьОтборОС = Ложь;
		
		СписокНоменклатуры = Новый Массив();
		
		ИспользоватьОтборНоменклатуры = Ложь;
	КонецЕсли;
	
	// Поиск ОС
	
	ПараметрыПоиска.Вставить("ВидыРаспоряженияОСПереданныеОбъекты",				ПолучитьВидыРаспоряженияОСПереданныеОбъекты());
	ПараметрыПоиска.Вставить("ВидыРаспоряженияОСРегистрСтоимостьОбъектовОС",	ПолучитьВидыРаспоряженияОСРегистрСтоимостьОбъектовОС());
	ПараметрыПоиска.Вставить("ВидыРаспоряженияОСРегистрСтоимостьОбъектовОСПоКонтрагентамСОтборомПоЦМО",		ПолучитьВидыРаспоряженияОСРегистрСтоимостьОбъектовОСПоКонтрагентамСОтборомПоЦМО());
	ПараметрыПоиска.Вставить("ВидыРаспоряженияОСРегистрСтоимостьОбъектовОСПоКонтрагентамБезОтбораПоЦМО",	ПолучитьВидыРаспоряженияОСРегистрСтоимостьОбъектовОСПоКонтрагентамБезОтбораПоЦМО());
	
	ПараметрыПоиска.Вставить("СчетаИсточникСуммРегистрБухгалтерии", Счета10600);
	ПараметрыПоиска.Вставить("СчетаУстановкиКоличестваПоУмолчанию", Счета10600);
	
	ПараметрыПоиска.Вставить("ТаблицаВидыРаспоряженияОС", ПолучитьТаблицуВидовРаспоряженияОССсылкиСчетов(ДатаОстатков));
	
	ПараметрыПоиска.Вставить("ИспользоватьОтборОС",	ИспользоватьОтборОС);
	ПараметрыПоиска.Вставить("СписокОС",			СписокОС);
	
	ПараметрыПоиска.Вставить("СписокСчетовДляДополненияРаздела1", ПолучитьБалансовыеСчетаПереданныхОбъектовОС(ДатаОстатков));
	ПараметрыПоиска.Вставить("СписокСчетовДляВыбораКонтрагента", БухгалтерскийУчет.СписокСчетов("01,02,24,25,26,27", ДатаОстатков));
	
	// Поиск номенклатуры
	
	ВидыСубконтоНоменклатураЦМО = Новый Массив();
	ВидыСубконтоНоменклатураЦМО.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ВидыСубконтоНоменклатураЦМО.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	ВидыСубконтоНоменклатураКонтрагенты = Новый Массив();
	ВидыСубконтоНоменклатураКонтрагенты.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ВидыСубконтоНоменклатураКонтрагенты.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	
	ВидыСубконтоНоменклатура = Новый Массив();
	ВидыСубконтоНоменклатура.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	
	ПараметрыПоиска.Вставить("ВидыСубконтоНоменклатураЦМО",			ВидыСубконтоНоменклатураЦМО);
	ПараметрыПоиска.Вставить("ВидыСубконтоНоменклатураКонтрагенты",	ВидыСубконтоНоменклатураКонтрагенты);
	ПараметрыПоиска.Вставить("ВидыСубконтоНоменклатура",			ВидыСубконтоНоменклатура);
	
	ПараметрыПоиска.Вставить("ИспользоватьОтборНоменклатуры",	ИспользоватьОтборНоменклатуры);
	ПараметрыПоиска.Вставить("СписокНоменклатуры",				СписокНоменклатуры);
	ПараметрыПоиска.Вставить("ПустаяНоменклатура",				Справочники.Номенклатура.ПустаяСсылка());
	
	ПараметрыПоиска.Вставить("ИсключаемыеТипыНоменклатуры", ПолучитьИсключаемыеТипыНоменклатуры());
	
	Возврат ПараметрыПоиска;
	
КонецФункции

Процедура ИсключитьСчетаНеСоответствующиеНастройкамЗаполненияОписиПоРешению(СписокСчетовОтбора, Знач ПараметрыФункции)
	
	Опись				= ПараметрыФункции.Ссылка;
	ДатаИнвентаризации	= ПараметрыФункции.ДатаИнвентаризации;
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(ТипЗнч(Опись));
	
	Если ТаблицаНастроек.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КодыСчетовКПроверке = "111.00"; // Описи 0510466 предписывается заполнение лишь по счетам 111.60, а в Решении 0510439 может быть указан счет 111.00.
	
	СчетаКПроверке = БухгалтерскийУчет.СписокСчетов(КодыСчетовКПроверке, ДатаИнвентаризации);
	
	КодыСчетовИзНастроек = ТаблицаНастроек[0].ТаблицаКодовСчетов.ВыгрузитьКолонку("КодыСчетовСтрокой");
	
	СсылкиСчетовИзНастроек = БухгалтерскийУчет.СписокСчетов(КодыСчетовИзНастроек, ДатаИнвентаризации);
	
	УдаляемыеСчета = Новый Массив();
	
	Для Каждого СчетОтбора Из СписокСчетовОтбора Цикл
		Если СчетаКПроверке.Найти(СчетОтбора) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если СсылкиСчетовИзНастроек.Найти(СчетОтбора) = Неопределено Тогда
			УдаляемыеСчета.Добавить(СчетОтбора);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Счет Из УдаляемыеСчета Цикл
		СписокСчетовОтбора.Удалить(СписокСчетовОтбора.Найти(Счет));
	КонецЦикла;
	
КонецПроцедуры


Процедура СопоставитьСтрокиТаблицРаздела1(ТаблицаРаздела1, ТаблицаДополнения, Знач ПараметрыПоиска)
	
	// Сопоставление двух таблиц выполняется только для счетов из фиксированного списка.
	// Несопоставленные строки таблицы дополнения удаляются как неподходящие.
	// Сопоставление выполняется по полям связи таблиц.
	
	ПоляСвязиТаблиц = "ОсновноеСредство,ИнвентарныйНомер,Подразделение";
	
	ТипИдентификаторСтроки = ОбщегоНазначения.ОписаниеТипаСтрока(36);
	
	ТаблицаРаздела1.Колонки.Добавить("ИдентификаторСтроки", ТипИдентификаторСтроки);
	ТаблицаДополнения.Колонки.Добавить("ИдентификаторСтроки", ТипИдентификаторСтроки);
	
	ТаблицаДополненияСвернутая = ТаблицаДополнения.Скопировать();
	ТаблицаДополненияСвернутая.Свернуть(ПоляСвязиТаблиц);
	
	ТаблицаВидыРаспоряженияОС = ПолучитьТаблицуВидовРаспоряженияОСКодыСчетов();
	
	ПоляПоиска = ПоляСвязиТаблиц + ",ВидРаспоряжения";
	
	ТаблицаРаздела1.Индексы.Добавить(ПоляПоиска);
	ТаблицаДополнения.Индексы.Добавить(ПоляПоиска);
	
	ПоискВТаблицеРаздела1 = Новый Структура(ПоляПоиска);
	ПоискВТаблицеРаздела1.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаБалансе;
	
	ПоискиВТаблицеДополнения = Новый Структура();
	ПоискиВТаблицеДополнения.Вставить("Счета24", Новый Структура(ПоляПоиска));
	ПоискиВТаблицеДополнения.Вставить("Счета25", Новый Структура(ПоляПоиска));
	ПоискиВТаблицеДополнения.Вставить("Счета26", Новый Структура(ПоляПоиска));
	ПоискиВТаблицеДополнения.Вставить("Счета27", Новый Структура(ПоляПоиска));
	
	ПоискиВТаблицеДополнения.Счета24.ВидРаспоряжения = ПолучитьВидРаспоряженияОСДляЗабалансовогоСчета("24", ТаблицаВидыРаспоряженияОС);
	ПоискиВТаблицеДополнения.Счета25.ВидРаспоряжения = ПолучитьВидРаспоряженияОСДляЗабалансовогоСчета("25", ТаблицаВидыРаспоряженияОС);
	ПоискиВТаблицеДополнения.Счета26.ВидРаспоряжения = ПолучитьВидРаспоряженияОСДляЗабалансовогоСчета("26", ТаблицаВидыРаспоряженияОС);
	ПоискиВТаблицеДополнения.Счета27.ВидРаспоряжения = ПолучитьВидРаспоряженияОСДляЗабалансовогоСчета("27", ТаблицаВидыРаспоряженияОС);
	
	Для Каждого СтрокаСвернутая Из ТаблицаДополненияСвернутая Цикл
		ЗаполнитьЗначенияСвойств(ПоискВТаблицеРаздела1, СтрокаСвернутая);
		
		МассивСтрокРаздела1 = ТаблицаРаздела1.НайтиСтроки(ПоискВТаблицеРаздела1);
		
		Если МассивСтрокРаздела1.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
		
		ИдентификаторИспользован = Ложь;
		
		// Устанавливаем ИдентификаторСтроки в таблице раздела 1.
		Для Каждого СтрокаТаблицыРаздела1 Из МассивСтрокРаздела1 Цикл
			// Сопоставление выполняется только для счетов из фиксированного списка.
			Если ПараметрыПоиска.СписокСчетовДляДополненияРаздела1.Найти(СтрокаТаблицыРаздела1.Счет) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		
			СтрокаТаблицыРаздела1.ИдентификаторСтроки = ИдентификаторСтроки;
			
			ИдентификаторИспользован = Истина;
		КонецЦикла;
		
		Если Не ИдентификаторИспользован Тогда
			Продолжить;
		КонецЕсли;
		
		// Устанавливаем ИдентификаторСтроки в таблице дополнения.
		Для Каждого ЭлементПоиска Из ПоискиВТаблицеДополнения Цикл
			Поиск = ЭлементПоиска.Значение;
			
			ЗаполнитьЗначенияСвойств(Поиск, СтрокаСвернутая);
			
			МассивСтрокТаблицыДополнения = ТаблицаДополнения.НайтиСтроки(Поиск);
			
			Для Каждого СтрокаТаблицыДополнения Из МассивСтрокТаблицыДополнения Цикл
				СтрокаТаблицыДополнения.ИдентификаторСтроки = ИдентификаторСтроки;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаДополнения.Свернуть("ИдентификаторСтроки,Контрагент,Договор,ВидРаспоряжения");
	
	УдалитьНесопоставленныеСтрокиТаблицыДополненияРаздела1(ТаблицаДополнения);
	
КонецПроцедуры

Функция ПолучитьТаблицуВидовРаспоряженияОССсылкиСчетов(Знач НаДату)
	
	Если ТипЗнч(НаДату) = Тип("Граница") Тогда
		НаДату = НаДату.Значение;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ТаблицаКодыСчетов", ПолучитьТаблицуВидовРаспоряженияОСКодыСчетов());
	ЗапросПоиск.УстановитьПараметр("НаДату", НаДату);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Коды счетов-групп
	|//
	|ВЫБРАТЬ
	|	ТЗ.КодСчета			КАК КодСчета,
	|	ТЗ.ВидРаспоряжения	КАК ВидРаспоряжения
	|ПОМЕСТИТЬ
	|	ТаблицаКодыСчетов
	|ИЗ
	|	&ТаблицаКодыСчетов КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Ссылка счетов-групп
	|//
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка						КАК Ссылка,
	|	ТаблицаКодыСчетов.ВидРаспоряжения	КАК ВидРаспоряжения
	|ПОМЕСТИТЬ
	|	ТаблицаВидыРаспоряжения
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКодыСчетов
	|		ПО ЕПСБУ.Код = ТаблицаКодыСчетов.КодСчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Все счета, и детальные, и группы
	|//
	|ВЫБРАТЬ
	|	Ссылка																							КАК Ссылка,
	|	ЕСТЬNULL(Ссылка.Родитель, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))								КАК Родитель1,
	|	ЕСТЬNULL(Ссылка.Родитель.Родитель, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))						КАК Родитель2,
	|	ЕСТЬNULL(Ссылка.Родитель.Родитель.Родитель, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))			КАК Родитель3,
	|	ЕСТЬNULL(Ссылка.Родитель.Родитель.Родитель.Родитель, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))	КАК Родитель4
	|ПОМЕСТИТЬ
	|	РодителиСчетов
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В ИЕРАРХИИ(ВЫБРАТЬ Ссылка ИЗ ТаблицаВидыРаспоряжения)
	|	И ДатаНачалаДействия <= &НаДату
	|	И (ДатаОкончанияДействия = ДАТАВРЕМЯ(1,1,1) ИЛИ ДатаОкончанияДействия >= &НаДату)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Виды распоряжения для каждого счета, и детального, и группы
	|//
	|ВЫБРАТЬ
	|	РодителиСчетов.Ссылка	КАК Счет,
	|	ВЫБОР
	|		КОГДА НЕ ТаблицаВидыРаспоряженияСсылка.ВидРаспоряжения ЕСТЬ NULL ТОГДА
	|			ТаблицаВидыРаспоряженияСсылка.ВидРаспоряжения
	|			
	|		КОГДА НЕ ТаблицаВидыРаспоряженияРодитель1.ВидРаспоряжения ЕСТЬ NULL ТОГДА
	|			ТаблицаВидыРаспоряженияРодитель1.ВидРаспоряжения
	|			
	|		КОГДА НЕ ТаблицаВидыРаспоряженияРодитель2.ВидРаспоряжения ЕСТЬ NULL ТОГДА
	|			ТаблицаВидыРаспоряженияРодитель2.ВидРаспоряжения
	|			
	|		КОГДА НЕ ТаблицаВидыРаспоряженияРодитель3.ВидРаспоряжения ЕСТЬ NULL ТОГДА
	|			ТаблицаВидыРаспоряженияРодитель3.ВидРаспоряжения
	|			
	|		КОГДА НЕ ТаблицаВидыРаспоряженияРодитель4.ВидРаспоряжения ЕСТЬ NULL ТОГДА
	|			ТаблицаВидыРаспоряженияРодитель4.ВидРаспоряжения
	|			
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПустаяСсылка)
	|	КОНЕЦ					КАК ВидРаспоряжения
	|ИЗ
	|	РодителиСчетов
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаВидыРаспоряжения КАК ТаблицаВидыРаспоряженияСсылка
	|		ПО РодителиСчетов.Ссылка = ТаблицаВидыРаспоряженияСсылка.Ссылка
	|		
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаВидыРаспоряжения КАК ТаблицаВидыРаспоряженияРодитель1
	|		ПО РодителиСчетов.Родитель1 = ТаблицаВидыРаспоряженияРодитель1.Ссылка
	|		
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаВидыРаспоряжения КАК ТаблицаВидыРаспоряженияРодитель2
	|		ПО РодителиСчетов.Родитель2 = ТаблицаВидыРаспоряженияРодитель2.Ссылка
	|		
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаВидыРаспоряжения КАК ТаблицаВидыРаспоряженияРодитель3
	|		ПО РодителиСчетов.Родитель3 = ТаблицаВидыРаспоряженияРодитель3.Ссылка
	|		
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаВидыРаспоряжения КАК ТаблицаВидыРаспоряженияРодитель4
	|		ПО РодителиСчетов.Родитель4 = ТаблицаВидыРаспоряженияРодитель4.Ссылка";
	
	ТаблицаСсылкиСчетов = ЗапросПоиск.Выполнить().Выгрузить();
	ТаблицаСсылкиСчетов.Индексы.Добавить("Счет");
	
	Возврат ТаблицаСсылкиСчетов;
	
КонецФункции

Функция ПолучитьТаблицуВидовРаспоряженияОСКодыСчетов()
	
	// Для всех балансовых счетов автоматически применяется вид распоряжения НаБалансе.
	// В эту таблицу строки для балансовых счетов не добавляются для уменьшения размера таблицы.
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("КодСчета",		ОбщегоНазначения.ОписаниеТипаСтрока(6));
	Таблица.Колонки.Добавить("ВидРаспоряжения",	Новый ОписаниеТипов("ПеречислениеСсылка.ВидыРаспоряженияОС"));
	
	// 1. ОперативныйУчет
	ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ОперативныйУчет;
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.КодСчета = "21";
	НоваяСтрока.ВидРаспоряжения = ВидРаспоряжения;
	
	// 2. НаХранении
	ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаХранении;
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.КодСчета = "02";
	НоваяСтрока.ВидРаспоряжения = ВидРаспоряжения;
	
	// 3. ПолученоВПользование
	ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПолученоВПользование;
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.КодСчета = "01";
	НоваяСтрока.ВидРаспоряжения = ВидРаспоряжения;
	
	// 4. ПереданоВУправление
	ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВУправление;
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.КодСчета = "24";
	НоваяСтрока.ВидРаспоряжения = ВидРаспоряжения;
	
	// 5. ПереданоВАренду
	ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВАренду;
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.КодСчета = "25";
	НоваяСтрока.ВидРаспоряжения = ВидРаспоряжения;
	
	// 6. ПереданоВПользование
	ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВПользование;
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.КодСчета = "26";
	НоваяСтрока.ВидРаспоряжения = ВидРаспоряжения;
	
	// 7. ПереданоВЛичноеПользование
	ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВЛичноеПользование;
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.КодСчета = "27";
	НоваяСтрока.ВидРаспоряжения = ВидРаспоряжения;
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьВидРаспоряженияОСДляЗабалансовогоСчета(КодСчета, ТаблицаВидыРаспоряженияОС)
	
	Поиск = Новый Структура("КодСчета", КодСчета);
	
	МассивСтрок = ТаблицаВидыРаспоряженияОС.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МассивСтрок[0].ВидРаспоряжения;
	
КонецФункции

Процедура ДобавитьЗабалансовыеСчетаОС(ПараметрыФункции)
	
	СписокСчетов = ПараметрыФункции.СписокСчетов;
	
	СписокКФО = Новый Массив();
	
	ОсновныеСчета = ПолучитьБалансовыеСчетаПереданныхОбъектовОС(ПараметрыФункции.ДатаИнвентаризации);
	
	НайденОсновнойСчет = Ложь;
	
	Для Каждого СтрокаТаблицы Из СписокСчетов Цикл
		Если ОсновныеСчета.Найти(СтрокаТаблицы.Счет) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НайденОсновнойСчет = Истина;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.КФО) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СписокКФО.Найти(СтрокаТаблицы.КФО) = Неопределено Тогда
			СписокКФО.Добавить(СтрокаТаблицы.КФО);
		КонецЕсли;
	КонецЦикла;
	
	Если Не НайденОсновнойСчет Тогда
		Возврат;
	КонецЕсли;
	
	ЗабалансовыеСчетаОС = ПолучитьЗабалансовыеСчетаПереданныхОбъектовОС(ПараметрыФункции.ДатаИнвентаризации);
	
	// При пустом списке КФО добавляем счета с пустым КФО
	
	КФО0 = Перечисления.КВД.ПустаяСсылка();
	
	Поиск = Новый Структура("КФО,Счет");
	
	Для Каждого Счет Из ЗабалансовыеСчетаОС Цикл
		Поиск.Счет = Счет;
		
		Если СписокКФО.Количество() = 0 Тогда
			Поиск.КФО = КФО0;
			
			МассивСтрок = СписокСчетов.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() = 0 Тогда
				НоваяСтрока = СписокСчетов.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Поиск);
			КонецЕсли;
			
		Иначе
			Для Каждого КФО Из СписокКФО Цикл
				Поиск.КФО = КФО;
				
				МассивСтрок = СписокСчетов.НайтиСтроки(Поиск);
				
				Если МассивСтрок.Количество() = 0 Тогда
					НоваяСтрока = СписокСчетов.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Поиск);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьБалансовыеСчетаПереданныхОбъектовОС(НаДату)
	
	Возврат БухгалтерскийУчет.СписокСчетов("101.00,103.00", НаДату);
	
КонецФункции

Функция ПолучитьЗабалансовыеСчетаПереданныхОбъектовОС(НаДату)
	
	КодыСчетов = Новый Массив();
	КодыСчетов.Добавить("24");
	КодыСчетов.Добавить("25");
	КодыСчетов.Добавить("26");
	КодыСчетов.Добавить("27");
	
	ВидСубконтоОС = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("КодыСчетов",	КодыСчетов);
	ЗапросПоиск.УстановитьПараметр("НаДату",		НаДату);
	ЗапросПоиск.УстановитьПараметр("ВидСубконтоОС",	ВидСубконтоОС);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Ссылки указанных счетов-групп
	|//
	|ВЫБРАТЬ
	|	Ссылка
	|ПОМЕСТИТЬ
	|	СсылкиСчетов
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	Код В (&КодыСчетов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Ссылки детальных счетов и счетов-групп с наличием субконто ОсновныеСредства
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕПСБУ.Ссылка	КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ЕПСБУ.Ссылка В ИЕРАРХИИ(ВЫБРАТЬ Ссылка ИЗ СсылкиСчетов)
	|		И ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|		И ЕПСБУВидыСубконто.ВидСубконто = &ВидСубконтоОС
	|ГДЕ
	|	ЕПСБУ.ДатаНачалаДействия <= &НаДату
	|	И (ЕПСБУ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1,1,1) ИЛИ ЕПСБУ.ДатаОкончанияДействия >= &НаДату)";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Процедура УдалитьОстаткиНеподходящихИнвНомеровОС(ТаблицаРаздела1, ТаблицаДополнения, ПараметрыФункции)
	
	// Если в табличной части СписокНФА для ОС указан инв.номер, то для такого ОС
	// берем остатки только по указанному инв.номеру.
	//
	// Если для ОС инв.номер не указан, то для такого ОС берем остатки по всем инв.номерам,
	// в т.ч. даже при отсутствии инв.номера.
	
	СписокНФА = ПараметрыФункции.СписокНФА;
	
	СписокНФА.Колонки.Найти("НФА").Имя = "ОсновноеСредство";
	
	СписокНФА.Индексы.Добавить("ОсновноеСредство,ИнвентарныйНомер");
	
	ПоискБезИнвНомера = Новый Структура("ТипНфаОС,ИнвентарныйНомер", Истина, Справочники.ИнвентарныеНомераОС.ПустаяСсылка());
	
	ОСБезИнвНомеров = СписокНФА.Скопировать(ПоискБезИнвНомера, "ОсновноеСредство").ВыгрузитьКолонку("ОсновноеСредство");
	
	
	УдалитьОстаткиНеподходящихИнвНомеровВТаблице(ТаблицаРаздела1, ОСБезИнвНомеров, СписокНФА);
	УдалитьОстаткиНеподходящихИнвНомеровВТаблице(ТаблицаДополнения, ОСБезИнвНомеров, СписокНФА);
	
	СписокНФА.Колонки.Найти("ОсновноеСредство").Имя = "НФА";
	
КонецПроцедуры

Процедура УдалитьОстаткиНеподходящихИнвНомеровВТаблице(Таблица, ОСБезИнвНомеров, СписокНФА)
	
	УдаляемыеСтроки = Новый Массив();
	
	Поиск = Новый Структура("ОсновноеСредство,ИнвентарныйНомер");
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если ОСБезИнвНомеров.Найти(СтрокаТаблицы.ОсновноеСредство) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		
		МассивСтрок = СписокНФА.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		УдаляемыеСтроки.Добавить(СтрокаТаблицы);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из УдаляемыеСтроки Цикл
		Таблица.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСпискиМОЛ(МОЛ, ДиагностикаМестИнвентаризации)
	
	МассивМестИнвентаризации		= ДиагностикаМестИнвентаризации.МассивМестИнвентаризации;
	МассивМестХранения				= ДиагностикаМестИнвентаризации.МассивМестХранения;
	ЕдинственноеЗначениеТекстовое	= ДиагностикаМестИнвентаризации.ЕдинственноеЗначениеТекстовое;
	ЕстьТекстовые					= ДиагностикаМестИнвентаризации.ЕстьТекстовые;
	ЕстьСсылочные					= ДиагностикаМестИнвентаризации.ЕстьСсылочные;
	
	СписокСотрудников = Новый Массив();
	СписокСотрудников.Добавить(МОЛ);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокСотрудников", СписокСотрудников);
	ЗапросПоиск.УстановитьПараметр("СписокМестХранения", МассивМестХранения);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Список всех ЦМО сотрудника
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	Справочник.ЦМО
	|ГДЕ
	|	Сотрудник В(&СписокСотрудников)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Список ЦМО сотрудника с указанными местами хранения
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СправочникЦМО.Ссылка	КАК Ссылка
	|ИЗ
	|	Справочник.ЦМО КАК СправочникЦМО
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.МестаХранения КАК СправочникМестаХранения
	|		ПО СправочникЦМО.МестоХранения = СправочникМестаХранения.Ссылка
	|		И СправочникМестаХранения.Ссылка В(&СписокМестХранения)
	|		И СправочникЦМО.Сотрудник В(&СписокСотрудников)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Список всех контрагентов сотрудника
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Контрагент	КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники
	|ГДЕ
	|	Ссылка В(&СписокСотрудников)
	|	И Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)";
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ЕстьТекстовые Тогда
		// По всем ЦМО и всем местам хранения сотрудника.
		// Этот список включает в себя любые явно заданные места хранения.
		
		// [0]. Список всех ЦМО сотрудника
		СписокЦМО = РезультатыЗапроса[0].Выгрузить().ВыгрузитьКолонку("Ссылка");;
	Иначе
		// Только по явно указанным местам хранения сотрудника
		
		// [1]. Список ЦМО сотрудника с указанными местами хранения
		СписокЦМО = РезультатыЗапроса[1].Выгрузить().ВыгрузитьКолонку("Ссылка");;
	КонецЕсли;
	
	// [2]. Список всех контрагентов сотрудника
	СписокКонтрагентов	= РезультатыЗапроса[2].Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Результат = Новый Структура();
	Результат.Вставить("СписокЦМО",				СписокЦМО);
	Результат.Вставить("СписокКонтрагентов",	СписокКонтрагентов);
	
	Возврат Результат;
	
КонецФункции

Функция ДиагностироватьМестаИнвентаризации(ТаблицаМестаИнвентаризации)
	
	МассивМестИнвентаризации = ТаблицаМестаИнвентаризации.ВыгрузитьКолонку("МестоИнвентаризации");
	
	МассивМестХранения = Новый Массив();
	
	КоличествоТекстовых = 0;
	КоличествоСсылочных = 0;
	КоличествоВообще = МассивМестИнвентаризации.Количество();
	
	ЕдинственноеЗначениеТекстовое = Неопределено;
	ЕдинственноеЗначениеСсылочное = Неопределено;
	ЕдинственноеЗначениеВообще = ?(КоличествоВообще = 1, МассивМестИнвентаризации[0], Неопределено);
	
	Для Каждого МестоИнвентаризации Из МассивМестИнвентаризации Цикл
		
		Если ТипЗнч(МестоИнвентаризации) = Тип("Строка") Тогда
			КоличествоТекстовых = КоличествоТекстовых + 1;
			
			ЕдинственноеЗначениеТекстовое = МестоИнвентаризации;
			
			Продолжить;
		КонецЕсли;
		
		КоличествоСсылочных = КоличествоСсылочных + 1;
		
		ЕдинственноеЗначениеСсылочное = МестоИнвентаризации;
		
		Если ТипЗнч(МестоИнвентаризации) = Тип("СправочникСсылка.МестаХранения") Тогда
			МассивМестХранения.Добавить(МестоИнвентаризации);
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоТекстовых <> 1 Тогда
		ЕдинственноеЗначениеТекстовое = Неопределено;
	КонецЕсли;
	
	Если КоличествоСсылочных <> 1 Тогда
		ЕдинственноеЗначениеСсылочное = Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("МассивМестИнвентаризации", МассивМестИнвентаризации);
	Результат.Вставить("МассивМестХранения", МассивМестХранения);
	Результат.Вставить("ЕстьТекстовые", (КоличествоТекстовых > 0));
	Результат.Вставить("ЕстьСсылочные", (КоличествоСсылочных > 0));
	Результат.Вставить("ЕдинственноеЗначениеТекстовое", ЕдинственноеЗначениеТекстовое);
	Результат.Вставить("ЕдинственноеЗначениеСсылочное", ЕдинственноеЗначениеСсылочное);
	Результат.Вставить("ЕдинственноеЗначениеВообще",	ЕдинственноеЗначениеВообще);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьМестаИнвентаризации(ТаблицаРаздела1, ПараметрыПоиска)
	
	ТаблицаРаздела1.Колонки.Добавить("МестоИнвентаризации", Новый ОписаниеТипов("Строка,СправочникСсылка.МестаХранения"));
	
	ДиагностикаМестИнвентаризации = ПараметрыПоиска.ДиагностикаМестИнвентаризации;
	
	МассивМестИнвентаризации		= ДиагностикаМестИнвентаризации.МассивМестИнвентаризации;
	ЕдинственноеЗначениеВообще		= ДиагностикаМестИнвентаризации.ЕдинственноеЗначениеВообще;
	
	Для Каждого СтрокаТаблицы Из ТаблицаРаздела1 Цикл
		
		Если МассивМестИнвентаризации.Найти(СтрокаТаблицы.МестоХранения) <> Неопределено Тогда
			Значение = СтрокаТаблицы.МестоХранения;
			
		ИначеЕсли ЗначениеЗаполнено(ЕдинственноеЗначениеВообще) Тогда
			Значение = ЕдинственноеЗначениеВообще;
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.МестоИнвентаризации = Значение;
	КонецЦикла;
	
КонецПроцедуры


Функция ПрочитатьСведенияДляВыгрузкиВТСД(ДокументОбъект)
	
	Поиск = Новый Структура("ТипНфаОС", Истина);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ТаблицаРаздел1",	ДокументОбъект.Раздел1.Выгрузить(Поиск, "НФА,ИнвентарныйНомер"));
	ЗапросПоиск.УстановитьПараметр("ТаблицаСписокНФА",	ДокументОбъект.СписокНФА.Выгрузить(Поиск, "НФА,ИнвентарныйНомер"));
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Т.НФА,
	|	Т.ИнвентарныйНомер
	|ПОМЕСТИТЬ
	|	ТаблицаРаздел1
	|ИЗ
	|	&ТаблицаРаздел1 КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.НФА,
	|	Т.ИнвентарныйНомер
	|ПОМЕСТИТЬ
	|	ТаблицаСписокНФА
	|ИЗ
	|	&ТаблицаСписокНФА КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокНФА.НФА					КАК НФА,
	|	СписокНФА.НФА.Наименование		КАК НФАНаименование,
	|	СписокНФА.ИнвентарныйНомер		КАК ИнвентарныйНомер,
	|	СписокНФА.ИнвентарныйНомер.Код	КАК ИнвентарныйНомерКод,
	|	ШтрихКоды.Штрихкод				КАК Штрихкод
	|ИЗ
	|	(ВЫБРАТЬ
	|		НФА,
	|		ИнвентарныйНомер
	|	ИЗ
	|		ТаблицаРаздел1
	|	
	|	ОБЪЕДИНИТЬ
	|	
	|	ВЫБРАТЬ
	|		НФА,
	|		ИнвентарныйНомер
	|	ИЗ
	|		ТаблицаСписокНФА) КАК СписокНФА
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихКоды КАК ШтрихКоды
	|		ПО СписокНФА.НФА = ШтрихКоды.Объект
	|		И СписокНФА.ИнвентарныйНомер = ШтрихКоды.ИнвентарныйНомер";
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаСведений = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТаблицаСведений;
	
КонецФункции

Функция ПреобразоватьВТаблицуТСД(МассивТСД)
	
	ТаблицаТСД = Новый ТаблицаЗначений;
	ТаблицаТСД.Колонки.Добавить("Штрихкод",		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(13, ДопустимаяДлина.Фиксированная)));
	ТаблицаТСД.Колонки.Добавить("Количество",	Новый ОписаниеТипов("Число"));
	
	Для Каждого Элемент Из МассивТСД Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаТСД.Добавить(), Элемент);
	КонецЦикла;
	
	Возврат ТаблицаТСД;
	
КонецФункции

