Процедура ПрочитатьПараметрыФункцииПоСсылке_ДанныеДляРаздела1(ПараметрыФункции)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументСсылка", ПараметрыФункции.Ссылка);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	ЭтоВыборочнаяИнвентаризация,
	|	ДатаИнвентаризации,
	|	Организация,
	|	ИФО,
	|	Подразделение,
	|	МОЛ,
	|	СписокСчетов,
	|	МестаИнвентаризации,
	|	СписокНФА.(
	|		НФА										КАК НФА,
	|		НФА ССЫЛКА Справочник.Номенклатура		КАК ТипНфаНоменклатура,
	|		НФА ССЫЛКА Справочник.ОсновныеСредства	КАК ТипНфаОС,
	|		ИнвентарныйНомер						КАК ИнвентарныйНомер)
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьНФА
	|ГДЕ
	|	Ссылка = &ДокументСсылка";
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока Выборка.Следующий() Цикл
		// Реквизиты шапки
		ПараметрыФункции.Вставить("ЭтоВыборочнаяИнвентаризация");
		ПараметрыФункции.Вставить("ДатаИнвентаризации");
		ПараметрыФункции.Вставить("Организация");
		ПараметрыФункции.Вставить("ИФО");
		ПараметрыФункции.Вставить("Подразделение");
		ПараметрыФункции.Вставить("МОЛ");
		
		ЗаполнитьЗначенияСвойств(ПараметрыФункции, Выборка);
		
		// Табличные части
		ПараметрыФункции.Вставить("СписокСчетов",			Выборка.СписокСчетов.Выгрузить());
		ПараметрыФункции.Вставить("МестаИнвентаризации",	Выборка.МестаИнвентаризации.Выгрузить());
		ПараметрыФункции.Вставить("СписокНФА",				Выборка.СписокНФА.Выгрузить());
		
		Прервать;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьПараметрыФункцииПоСсылке_ДанныеДляРаздела21(ПараметрыФункции)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументСсылка", ПараметрыФункции.Ссылка);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Табличные части документа для заполнения примечания (доп.сведений на забалансе)
	|//
	|ВЫБРАТЬ
	|	Раздел1.(
	|		НомерСтроки,
	|		НФА,
	|		ИнвентарныйНомер,
	|		ЕдИзм,
	|		МестоИнвентаризации,
	|		ИдентификаторСтроки),
	|	ДополнениеРаздела1
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьНФА
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|	И Раздел1.ИдентификаторСтроки <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Свернутая табличная часть Раздел1
	|//
	|ВЫБРАТЬ
	|	НФА,
	|	ИнвентарныйНомер,
	|	ЕдИзм,
	|	МестоИнвентаризации,
	|	СУММА(Количество),
	|	СУММА(Сумма),
	|	МИНИМУМ(НомерСтроки) КАК МинимальныйНомерСтроки
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьНФА.Раздел1
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|СГРУППИРОВАТЬ ПО
	|	НФА,
	|	ИнвентарныйНомер,
	|	ЕдИзм,
	|	МестоИнвентаризации
	|УПОРЯДОЧИТЬ ПО
	|	МИНИМУМ(НомерСтроки)";
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапросов = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	// [0]. Табличные части документа
	Выборка = РезультатыЗапросов[0].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		// Реквизиты шапки
		ПараметрыФункции.Вставить("ЭтоВыборочнаяИнвентаризация");
		
		ЗаполнитьЗначенияСвойств(ПараметрыФункции, Выборка);
		
		// Табличные части
		ПараметрыФункции.Вставить("Раздел1",			Выборка.Раздел1.Выгрузить());
		ПараметрыФункции.Вставить("ДополнениеРаздела1",	Выборка.ДополнениеРаздела1.Выгрузить());
		
		Прервать;
	КонецЦикла;
	
	// [1]. Свернутая табличная часть Раздел1
	ПараметрыФункции.Вставить("СвернутаяТаблицаРаздел1", РезультатыЗапросов[1].Выгрузить());
	
КонецПроцедуры

