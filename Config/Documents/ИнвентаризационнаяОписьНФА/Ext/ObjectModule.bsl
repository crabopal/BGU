#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Документы.ИнвентаризационнаяОписьНФА.УдалитьНесопоставленныеСтрокиТаблицыДополненияРаздела1(ЭтотОбъект.ДополнениеРаздела1);
	
	// СерииДокументов
	ИнвентаризацияСервер.ОбновитьРеквизитыСерииЗаголовочногоДокументаСерии(ЭтотОбъект);
	// Конец СерииДокументов
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// СерииДокументов
	ИнвентаризацияСервер.ОбновитьРеквизитыСерииСодержательныхДокументовСерии(ЭтотОбъект);
	// Конец СерииДокументов
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ОчищающаяСтруктура = Новый Структура("ДокументРасписки,ЭтоЗаголовочныйДокумент,ИдентификаторСерииДокументов");
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ОчищающаяСтруктура);
	
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	// СерииДокументов
	ИнвентаризацияСервер.НастроитьПрефиксДокументаСерииДокументов(ЭтотОбъект, Префикс);
	// Конец СерииДокументов
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УдалитьНепроверяемыеРеквизиты(ПроверяемыеРеквизиты);
	
	Если Документы.ИнвентаризационнаяОписьНФА.ЕстьОшибкиЗаполнения(ЭтотОбъект) Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УдалитьНепроверяемыеРеквизиты(ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив();
	
	НепроверяемыеРеквизиты.Добавить("СоставКомиссииРаздел2.ПричинаОтсутствия");
	НепроверяемыеРеквизиты.Добавить("СоставКомиссииРаздел4.ПричинаОтсутствия");
	
	НепроверяемыеРеквизиты.Добавить("ДополнениеРаздела1.ИдентификаторСтроки");
	
	НепроверяемыеРеквизиты.Добавить("Раздел21");
	НепроверяемыеРеквизиты.Добавить("Раздел21.Количество");
	
	НепроверяемыеРеквизиты.Добавить("Раздел22.КоличествоНеСоответствует");
	НепроверяемыеРеквизиты.Добавить("Раздел22.СуммаНеСоответствует");
	НепроверяемыеРеквизиты.Добавить("Раздел22.КоличествоОбесценение");
	НепроверяемыеРеквизиты.Добавить("Раздел22.СуммаОбесценение");
	
	НепроверяемыеРеквизиты.Добавить("Раздел3.НаименованиеДокумента");
	НепроверяемыеРеквизиты.Добавить("Раздел3.НомерДокумента");
	НепроверяемыеРеквизиты.Добавить("Раздел3.ДатаДокумента");
	
	НепроверяемыеРеквизиты.Добавить("Раздел4");
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли