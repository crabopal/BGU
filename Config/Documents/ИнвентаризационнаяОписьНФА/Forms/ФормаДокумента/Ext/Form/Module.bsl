		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Раздел4" + ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

