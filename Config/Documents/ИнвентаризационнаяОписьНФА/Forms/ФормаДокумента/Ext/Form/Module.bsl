#Область КонтрольПоследовательностиЗаполненияРазделов

&НаКлиентеНаСервереБезКонтекста
Функция ОпределитьДопустимостьЗаполненияРазделов(Форма)
	
	Объект = Форма.Объект;
	
	КонтролироватьПоследовательностьЗаполненияРазделов = Форма.КонтролироватьПоследовательностьЗаполненияРазделов;
	
	Форма.ПричинаНедоступностиРаздела1 = "";
	Форма.ПричинаНедоступностиРаздела21 = "";
	Форма.ПричинаНедоступностиРаздела22 = "";
	Форма.ПричинаНедоступностиРаздела3 = "";
	Форма.ПричинаНедоступностиРаздела4 = "";
	
	ДопустимостьЗаполненияРазделов = Новый Структура();
	ДопустимостьЗаполненияРазделов.Вставить("КонтролироватьПоследовательностьЗаполненияРазделов",
		КонтролироватьПоследовательностьЗаполненияРазделов);
	
	СовместноЗаполненыРазделы1и21 = ?(Объект.Раздел1.Количество() > 0,
		Объект.Раздел21.Количество() > 0,
		Истина);
	
	ДопустимостьЗаполненияРазделов.Вставить("Раздел1",
		Объект.Раздел21.Количество() = 0
		И Объект.Раздел22.Количество() = 0
		И Объект.Раздел3.Количество() = 0
		И Объект.Раздел4.Количество() = 0
		Или Не КонтролироватьПоследовательностьЗаполненияРазделов);
		
	Если Не ДопустимостьЗаполненияРазделов.Раздел1 Тогда
		Форма.ПричинаНедоступностиРаздела1 = НСтр("ru='Заполнен один из последующих разделов.'");
	КонецЕсли;
		
	ДопустимостьЗаполненияРазделов.Вставить("Раздел21",
		Объект.Раздел22.Количество() = 0
		И Объект.Раздел3.Количество() = 0
		И Объект.Раздел4.Количество() = 0
		Или Не КонтролироватьПоследовательностьЗаполненияРазделов);
		
	Если Не ДопустимостьЗаполненияРазделов.Раздел21 Тогда
		Форма.ПричинаНедоступностиРаздела21 = НСтр("ru='Заполнен один из последующих разделов.'");
	КонецЕсли;
	
	ДопустимостьЗаполненияРазделов.Вставить("Раздел22",
		СовместноЗаполненыРазделы1и21
		И Объект.Раздел3.Количество() = 0
		И Объект.Раздел4.Количество() = 0
		Или Не КонтролироватьПоследовательностьЗаполненияРазделов);
		
	Если Не СовместноЗаполненыРазделы1и21 Тогда
		Форма.ПричинаНедоступностиРаздела22 = НСтр("ru='Не заполнены предыдущие разделы 1 и 2.1.'");
	ИначеЕсли Не ДопустимостьЗаполненияРазделов.Раздел22 Тогда
		Форма.ПричинаНедоступностиРаздела22 = НСтр("ru='Заполнен один из последующих разделов.'");
	КонецЕсли;
	
	ДопустимостьЗаполненияРазделов.Вставить("Раздел3",
		СовместноЗаполненыРазделы1и21
		И Объект.Раздел4.Количество() = 0
		Или Не КонтролироватьПоследовательностьЗаполненияРазделов);
		
	Если Не СовместноЗаполненыРазделы1и21 Тогда
		Форма.ПричинаНедоступностиРаздела3 = НСтр("ru='Не заполнены предыдущие разделы 1 и 2.1.'");
	ИначеЕсли Не ДопустимостьЗаполненияРазделов.Раздел3 Тогда
		Форма.ПричинаНедоступностиРаздела3 = НСтр("ru='Заполнен последующий раздел 4.'");
	КонецЕсли;
	
	ДопустимостьЗаполненияРазделов.Вставить("Раздел4",
		СовместноЗаполненыРазделы1и21
		И Не Объект.Проведен
		Или Не КонтролироватьПоследовательностьЗаполненияРазделов);
		
	Если Объект.Проведен Тогда
		Форма.ПричинаНедоступностиРаздела4 = НСтр("ru='Документ описи проведен.'");
	ИначеЕсли Не СовместноЗаполненыРазделы1и21 Тогда
		Форма.ПричинаНедоступностиРаздела4 = НСтр("ru='Не заполнены предыдущие разделы 1 и 2.1.'");
	КонецЕсли;
	
	Возврат ДопустимостьЗаполненияРазделов;
	
КонецФункции

&НаКлиенте
Процедура НастроитьФорму_ДопустимостьЗаполненияРазделов_Клиент()
	
	ДопустимостьЗаполненияРазделов = ОпределитьДопустимостьЗаполненияРазделов(ЭтотОбъект);
	
	ИменаРазделов = ОпределитьИзменияДопустимостиРедактированияРазделов(ЭтотОбъект,
		ДопустимостьЗаполненияРазделов,
		ДопустимостьЗаполненияРазделовПрежнееЗначение);
		
	Если ИменаРазделов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НастроитьФорму_ДопустимостьЗаполненияРазделов_Сервер(ДопустимостьЗаполненияРазделов, ИменаРазделов);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму_ДопустимостьЗаполненияРазделов_Сервер(ДопустимостьЗаполненияРазделов = Неопределено, ИменаРазделов = Неопределено)
	
	Если ДопустимостьЗаполненияРазделов = Неопределено Тогда
		ДопустимостьЗаполненияРазделов = ОпределитьДопустимостьЗаполненияРазделов(ЭтотОбъект);
	КонецЕсли;
	
	ДопустимостьЗаполненияРазделовПрежнееЗначение = Новый ФиксированнаяСтруктура(ДопустимостьЗаполненияРазделов);
	
	НастроитьПометкуКнопкиКонтролироватьПоследовательностьЗаполненияРазделов(ЭтотОбъект);
	
	Если ИменаРазделов = Неопределено Или ИменаРазделов.Найти("Раздел1") <> Неопределено Тогда
		НастроитьФорму_ДопустимостьЗаполненияРазделов_Раздел1(ДопустимостьЗаполненияРазделов);
	КонецЕсли;
	
	Если ИменаРазделов = Неопределено Или ИменаРазделов.Найти("Раздел21") <> Неопределено Тогда
		НастроитьФорму_ДопустимостьЗаполненияРазделов_Раздел21(ДопустимостьЗаполненияРазделов);
	КонецЕсли;
	
	Если ИменаРазделов = Неопределено Или ИменаРазделов.Найти("Раздел22") <> Неопределено Тогда
		НастроитьФорму_ДопустимостьЗаполненияРазделов_Раздел22(ДопустимостьЗаполненияРазделов);
	КонецЕсли;
	
	Если ИменаРазделов = Неопределено Или ИменаРазделов.Найти("Раздел3") <> Неопределено Тогда
		НастроитьФорму_ДопустимостьЗаполненияРазделов_Раздел3(ДопустимостьЗаполненияРазделов);
	КонецЕсли;
	
	Если ИменаРазделов = Неопределено Или ИменаРазделов.Найти("Раздел4") <> Неопределено Тогда
		НастроитьФорму_ДопустимостьЗаполненияРазделов_Раздел4(ДопустимостьЗаполненияРазделов);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму_ДопустимостьЗаполненияРазделов_Раздел1(ДопустимостьЗаполненияРазделов)
	
	ДопустимоРедактирование = ДопустимостьЗаполненияРазделов.Раздел1;
	
	Элементы.Раздел1ПоказатьПричинуНедоступностиРаздела1.Видимость = Не ДопустимоРедактирование;
	
	Элементы.Раздел1.ИзменятьПорядокСтрок = ДопустимоРедактирование;
	
	НедоступныеКолонки = Новый Массив();
	НедоступныеКолонки.Добавить("Раздел1МестоИнвентаризации");
	
	Если ДопустимоРедактирование Тогда
		ИнвентаризацияСервер.ОтключитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтотОбъект, НедоступныеКолонки, НедоступныеКолонки);
	Иначе
		ИнвентаризацияСервер.НастроитьНедоступностьИзмененияКолонокНаФормеОписи(ЭтотОбъект, НедоступныеКолонки,, НедоступныеКолонки);
	КонецЕсли;
	
	// Команды заполнения.
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("Раздел1ЗаполнитьРаздел1");
	ИменаЭлементов.Добавить("Раздел1ГрупповоеЗаполнениеСтрокРаздела1");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементов,
		"Доступность",
		ДопустимоРедактирование);
		
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("Раздел1ВыгрузитьДанныеВТСД");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементов,
		"Доступность",
		ДопустимоРедактирование И ДопустимостьЗаполненияРазделов.Раздел21);
	
КонецПроцедуры

