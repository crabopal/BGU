&НаСервере
Процедура ОбработкаВыбораПодбораОССервер(Знач ВыбранноеЗначение)
	
	ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
	
	// Предзаполнение корзины временно отключено.
	//ПоискОС = Новый Структура("ТипНфаОС", Истина);
	//
	//МассивСтрок = Объект.СписокНФА.НайтиСтроки(ПоискОС);
	//
	//Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
	//	ИндексСтроки = Объект.СписокНФА.Индекс(СтрокаТаблицы);
	//	
	//	Объект.СписокНФА.Удалить(ИндексСтроки);
	//КонецЦикла;
	
	СлужебныеКолонки = Новый Структура("ТипНфаНоменклатура,ТипНфаОС", Ложь, Истина);
	
	Поиск = Новый Структура("НФА,ИнвентарныйНомер");
	
	Для Каждого СтрокаТаблицыОС Из ТаблицаОС Цикл
		Поиск.НФА = СтрокаТаблицыОС.ОсновноеСредство;
		Поиск.ИнвентарныйНомер = СтрокаТаблицыОС.ИнвентарныйНомер;
		
		МассивСтрок = Объект.СписокНФА.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.СписокНФА.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Поиск);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СлужебныеКолонки);
	КонецЦикла;
	
КонецПроцедуры

