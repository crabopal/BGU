КонецПроцедуры

&НаСервере
Процедура НастроитьФормуПоВидуИнвентаризации()
	
	ЭтоВыборочнаяИнвентаризация = Объект.ЭтоВыборочнаяИнвентаризация;
	
	Элементы.ГруппаСписокНФА.Видимость = ЭтоВыборочнаяИнвентаризация;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьЕдиницуИзмеренияНоменклатуры(Ссылка)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ЕдиницаИзмерения");
	
КонецФункции

&НаКлиенте
Процедура ОтменитьНедопустимоеИзменениеМестаИнвентаризацииВСтрокеРаздела1(СтандартнаяОбработка)
	
	Если Не ДопустимоИзменитьМестоИнвентаризацииВСтрокеРаздела1(Элементы.Раздел1.ТекущиеДанные) Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ДопустимоИзменитьМестоИнвентаризацииВСтрокеРаздела1(ТекДанные)
	
	Возврат Не ЗначениеЗаполнено(ТекДанные.МестоИнвентаризации)
		Или ТекДанные.МестоИнвентаризацииЗаполненоВручную;
	
КонецФункции

&НаКлиенте
Процедура ОтменитьДобавлениеСтрокиРаздела21(Отказ)
	
	Если Объект.Раздел1.Количество() > 0 И Объект.Раздел21.Количество() = 0 Тогда
		Отказ = Истина;
		
		ПоказатьПредупреждение(, НСтр("ru='Добавление строки в раздел 2.1 отменено.
			|Необходимо предварительно заполнить раздел 2.1 по данным раздела 1.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьАвтоматическиДобавленнаяСтрокаРаздела21()
	
	Для Каждого ИдСтроки Из Элементы.Раздел21.ВыделенныеСтроки Цикл
		ТекДанные = Объект.Раздел21.НайтиПоИдентификатору(ИдСтроки);
		
		Если Не ТекДанные.ДобавленоВручную Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьПоказателиСтрокиРаздела22(Элемент)
	
	ТекДанные = Элементы.Раздел22.ТекущиеДанные;
	
	ИмяПоля = СтрЗаменить(Элемент.Имя, "Раздел22", "");
	
	Если ТекДанные.ТипНфаОС Тогда
		Если ИмяПоля = "КоличествоНеСоответствует" Тогда
			ТекДанные.КоличествоНеСоответствует = Окр(ТекДанные.КоличествоНеСоответствует, 0);
		КонецЕсли;
		
		Если ИмяПоля = "КоличествоОбесценение" Тогда
			ТекДанные.КоличествоОбесценение = Окр(ТекДанные.КоличествоОбесценение, 0);
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяПоля = "КоличествоНеСоответствует" Тогда
		Если ТекДанные.КоличествоНеСоответствует > ТекДанные.КоличествоИзРаздела21 Тогда
			ТекДанные.КоличествоНеСоответствует = ТекДанные.КоличествоИзРаздела21;
		КонецЕсли;
		
		ТекДанные.СуммаНеСоответствует = ТекДанные.КоличествоНеСоответствует * ТекДанные.Цена;
		
	ИначеЕсли ИмяПоля = "КоличествоОбесценение" Тогда
		Если ТекДанные.КоличествоОбесценение > ТекДанные.КоличествоИзРаздела21 Тогда
			ТекДанные.КоличествоОбесценение = ТекДанные.КоличествоИзРаздела21;
		КонецЕсли;
		
		ТекДанные.СуммаОбесценение = ТекДанные.КоличествоОбесценение * ТекДанные.Цена;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьПоказателиСтрокиРаздела3(Элемент)
	
	ТекДанные = Элементы.Раздел3.ТекущиеДанные;
	
	ИмяПоля = СтрЗаменить(Элемент.Имя, "Раздел3", "");
	
	//	КоличествоНедостачаПодтверждено
	//	СуммаНедостачаПодтверждено
	//	Цена
	//	КоличествоИзлишкиПодтверждено
	//	СуммаИзлишкиПодтверждено
	//	КоличествоНедостачаНеПодтверждено
	//	СуммаНедостачаНеПодтверждено
	//КоличествоИзлишкиНеПодтверждено	
	
	Если ТекДанные.ТипНфаОС Тогда
		Если ИмяПоля = "КоличествоНедостачаПодтверждено" Тогда
			ТекДанные.КоличествоНедостачаПодтверждено = Окр(ТекДанные.КоличествоНедостачаПодтверждено, 0);
		КонецЕсли;
		
		Если ИмяПоля = "КоличествоИзлишкиПодтверждено" Тогда
			ТекДанные.КоличествоИзлишкиПодтверждено = Окр(ТекДанные.КоличествоИзлишкиПодтверждено, 0);
		КонецЕсли;
		
		Если ИмяПоля = "КоличествоНедостачаНеПодтверждено" Тогда
			ТекДанные.КоличествоНедостачаНеПодтверждено = Окр(ТекДанные.КоличествоНедостачаНеПодтверждено, 0);
		КонецЕсли;
		
		Если ИмяПоля = "КоличествоИзлишкиНеПодтверждено" Тогда
			ТекДанные.КоличествоИзлишкиНеПодтверждено = Окр(ТекДанные.КоличествоИзлишкиНеПодтверждено, 0);
		КонецЕсли;
	КонецЕсли;
	
	ЦенаНедостачи = ?(ТекДанные.КоличествоНедостача <> 0,
		ТекДанные.СуммаНедостача / ТекДанные.КоличествоНедостача,
		0);
	
	Если ИмяПоля = "КоличествоНедостачаПодтверждено" Тогда
		// Подтверждено
		Если ТекДанные.КоличествоНедостачаПодтверждено > ТекДанные.КоличествоНедостача Тогда
			ТекДанные.КоличествоНедостачаПодтверждено = ТекДанные.КоличествоНедостача;
		КонецЕсли;
		
		Если ТекДанные.КоличествоНедостачаПодтверждено = ТекДанные.КоличествоНедостача Тогда
			ТекДанные.СуммаНедостачаПодтверждено = ТекДанные.СуммаНедостача;
		Иначе
			ТекДанные.СуммаНедостачаПодтверждено = ТекДанные.КоличествоНедостачаПодтверждено * ЦенаНедостачи;
		КонецЕсли;
		
		Если ТекДанные.СуммаНедостачаПодтверждено > ТекДанные.СуммаНедостача Тогда
			ТекДанные.СуммаНедостачаПодтверждено = ТекДанные.СуммаНедостача;
		КонецЕсли;
		
		// Не подтверждено
		ТекДанные.КоличествоНедостачаНеПодтверждено	= ТекДанные.КоличествоНедостача - ТекДанные.КоличествоНедостачаПодтверждено;
		ТекДанные.СуммаНедостачаНеПодтверждено		= ТекДанные.СуммаНедостача - ТекДанные.СуммаНедостачаПодтверждено;
		
	ИначеЕсли ИмяПоля = "СуммаНедостачаПодтверждено" Тогда
		// Подтверждено
		Если ТекДанные.СуммаНедостачаПодтверждено > ТекДанные.СуммаНедостача Тогда
			ТекДанные.СуммаНедостачаПодтверждено = ТекДанные.СуммаНедостача;
		КонецЕсли;
		
		// Не подтверждено
		ТекДанные.СуммаНедостачаНеПодтверждено = ТекДанные.СуммаНедостача - ТекДанные.СуммаНедостачаПодтверждено;
		
	ИначеЕсли ИмяПоля = "Цена" Тогда
		ТекДанные.СуммаИзлишкиПодтверждено = ТекДанные.КоличествоИзлишкиПодтверждено * ТекДанные.Цена;
		
		
	ИначеЕсли ИмяПоля = "КоличествоИзлишкиПодтверждено" Тогда
		// Подтверждено
		Если ТекДанные.КоличествоИзлишкиПодтверждено > ТекДанные.КоличествоИзлишки Тогда
			ТекДанные.КоличествоИзлишкиПодтверждено = ТекДанные.КоличествоИзлишки;
		КонецЕсли;
		
		ТекДанные.СуммаИзлишкиПодтверждено = ТекДанные.КоличествоИзлишкиПодтверждено * ТекДанные.Цена;
		
		// Не подтверждено
		ТекДанные.КоличествоИзлишкиНеПодтверждено = ТекДанные.КоличествоИзлишки - ТекДанные.КоличествоИзлишкиПодтверждено;
		
		
	ИначеЕсли ИмяПоля = "КоличествоНедостачаНеПодтверждено" Тогда
		// Не подтверждено
		Если ТекДанные.КоличествоНедостачаНеПодтверждено > ТекДанные.КоличествоНедостача Тогда
			ТекДанные.КоличествоНедостачаНеПодтверждено = ТекДанные.КоличествоНедостача;
		КонецЕсли;
		
		Если ТекДанные.КоличествоНедостачаНеПодтверждено = ТекДанные.КоличествоНедостача Тогда
			ТекДанные.СуммаНедостачаНеПодтверждено = ТекДанные.СуммаНедостача;
		Иначе
			ТекДанные.СуммаНедостачаНеПодтверждено = ТекДанные.КоличествоНедостачаНеПодтверждено * ЦенаНедостачи;
		КонецЕсли;
		
		Если ТекДанные.СуммаНедостачаНеПодтверждено > ТекДанные.СуммаНедостача Тогда
			ТекДанные.СуммаНедостачаНеПодтверждено = ТекДанные.СуммаНедостача;
		КонецЕсли;
		
		// Подтверждено
		ТекДанные.КоличествоНедостачаПодтверждено	= ТекДанные.КоличествоНедостача - ТекДанные.КоличествоНедостачаНеПодтверждено;
		ТекДанные.СуммаНедостачаПодтверждено		= ТекДанные.СуммаНедостача - ТекДанные.СуммаНедостачаНеПодтверждено;
		
	ИначеЕсли ИмяПоля = "СуммаНедостачаНеПодтверждено" Тогда
		// Подтверждено
		Если ТекДанные.СуммаНедостачаНеПодтверждено > ТекДанные.СуммаНедостача Тогда
			ТекДанные.СуммаНедостачаНеПодтверждено = ТекДанные.СуммаНедостача;
		КонецЕсли;
		
		// Не подтверждено
		ТекДанные.СуммаНедостачаПодтверждено = ТекДанные.СуммаНедостача - ТекДанные.СуммаНедостачаНеПодтверждено;
		
		
	ИначеЕсли ИмяПоля = "КоличествоИзлишкиНеПодтверждено" Тогда
		// Не подтверждено
		Если ТекДанные.КоличествоИзлишкиНеПодтверждено > ТекДанные.КоличествоИзлишки Тогда
			ТекДанные.КоличествоИзлишкиНеПодтверждено = ТекДанные.КоличествоИзлишки;
		КонецЕсли;
		
		// Подтверждено
		ТекДанные.КоличествоИзлишкиПодтверждено = ТекДанные.КоличествоИзлишки - ТекДанные.КоличествоИзлишкиНеПодтверждено;
		ТекДанные.СуммаИзлишкиПодтверждено = ТекДанные.КоличествоИзлишкиПодтверждено * ТекДанные.Цена;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРеквизитыДокументаПриОтсутствииПодтвержденияВСтрокеРаздела3()
	
	ТекДанные = Элементы.раздел3.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекДанные.КоличествоНедостачаПодтверждено)
		И Не ЗначениеЗаполнено(ТекДанные.СуммаНедостачаПодтверждено)
		И Не ЗначениеЗаполнено(ТекДанные.КоличествоИзлишкиПодтверждено)
		И Не ЗначениеЗаполнено(ТекДанные.СуммаИзлишкиПодтверждено) Тогда
		
		ОчищающаяСтруктура = Новый Структура("НаименованиеДокумента,НомерДокумента,ДатаДокумента");
		
		ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьНадписиМестаИнвентаризации()
	
	ЕстьТекстовоеЗначение = Ложь;
	
	Для Каждого СтрокаТаблицы Из Объект.МестаИнвентаризации Цикл
		Если ТипЗнч(СтрокаТаблицы.МестоИнвентаризации) = Тип("Строка") Тогда
			ЕстьТекстовоеЗначение = Истина;
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ШапкаПоказатьСообщениеМестоИнвентаризации.Видимость = ЕстьТекстовоеЗначение;
	Элементы.МестаИнвентаризацииПоказатьСообщениеМестоИнвентаризации.Видимость = ЕстьТекстовоеЗначение;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьДоступностьСпискаНФА()
	
	// Поле СписокНФА подключен к подсистеме СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов.
	// Для таблицы формы этой подсистемой устанавливается признак ТолькоПросмотр для блокировки реквизита.
	// Для других полей формы сбрасывается признак Доступность для блокировки реквизита.
	
	Если Не Объект.ЭтоВыборочнаяИнвентаризация Или ИнвентаризацияКлиентСервер.ЭтоСодержательныйДокументСерииДокументовОписи(Объект) Тогда
		// Список НФА не показывается и не используется.
		Возврат;
	КонецЕсли;
	
	НоваяДоступность = Истина;
	
	Если ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка) И ДанныеПанелиРасписки.РаспискаПроведена Тогда
		НоваяДоступность = Ложь;
	КонецЕсли;
	
	// Список элементов формы см. в модуле менеджера, Функция ПолучитьБлокируемыеРеквизитыОбъекта()
	ИменаЗависимыхЭлементовФормы = СтрРазделить("СписокНФАГруппаПодобрать,СписокНФАПодборМЗ,СписокНФАПодборОС", ", ", Ложь);
	
	Элементы.СписокНФА.ТолькоПросмотр = Не НоваяДоступность;
	
	Для Каждого ИмяЭлемента Из ИменаЗависимыхЭлементовФормы Цикл
		Элементы[ИмяЭлемента].Доступность = НоваяДоступность;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НужноЗаблокироватьРеквизиты()
	
	Возврат ИнвентаризацияКлиентСервер.ЭтоСодержательныйДокументСерииДокументовОписи(Объект)
		Или ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка);
	
КонецФункции

