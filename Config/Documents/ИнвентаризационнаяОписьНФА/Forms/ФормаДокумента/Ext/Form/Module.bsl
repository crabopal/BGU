КонецПроцедуры

&НаКлиенте
Процедура ОтменитьДействиеДляАвтоСтрокиРаздела21(СтандартнаяОбработка)
	
	ТекДанные = Элементы.Раздел21.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТекДанные.ДобавленоВручную Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьСписокВыбораМестоИнвентаризации()
	
	СодержимоеСписка = Объект.МестаИнвентаризации.Выгрузить().ВыгрузитьКолонку("МестоИнвентаризации");
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("Раздел1МестоИнвентаризации");
	ИменаЭлементов.Добавить("Раздел21МестоИнвентаризации");
	
	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		СписокВыбора = Элементы[ИмяЭлемента].СписокВыбора;
		
		СписокВыбора.Очистить();
		
		СписокВыбора.ЗагрузитьЗначения(СодержимоеСписка);
	КонецЦикла;
	
КонецПроцедуры

