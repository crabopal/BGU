&НаСервере
Процедура ИнициализироватьФорму()
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ИнициализироватьФормуДокументаЗамещениеЧленаКомиссии(ЭтотОбъект,, "СоставКомиссииРаздел2,СоставКомиссииРаздел4");
	// Конец ЗамещениеЧленаКомиссии
	
	ЕдИзмШт = Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию();
	
	ИнвентаризацияСервер.ЗаполнитьСписокВыбораЭлементаСтатусОбъяснения(Элементы.Раздел4СтатусОбъяснения);
	
	УстановитьУсловноеОформление();
	
	КонтролироватьПоследовательностьЗаполненияРазделов = Истина;
	
	ИнициализацияФормыВыполнена = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	Перем РезультатыДиагностики;
	
	// ПанельРасписки
	НастроитьФормуПоРасписке();
	// Конец ПанельРасписки
	
	// СерииДокументов
	НастроитьФормуПоСерииДокументов();
	// Конец СерииДокументов
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриЧтенииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ЗаполнитьСлужебныеКолонкиЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	ЗаполнитьСписокВыбораМестоИнвентаризации();
	
	НастроитьФормуПоВидуИнвентаризации();
	
	НастроитьВидимостьНадписиМестаИнвентаризации();
	
	УстановитьПредставленияРеквизитовШапки();
	
	НастроитьНедоступностьИзмененияКолонок();
	
	Документы.ИнвентаризационнаяОписьНФА.ЗаполнитьСлужебныеКолонки(ЭтаФорма, "СписокНФА,Раздел1,Раздел21,Раздел22,Раздел3,Раздел4", РезультатыДиагностики);
	
	НастроитьФорму_ДопустимостьЗаполненияРазделов_Сервер();
	
	ОбновитьКнопкиПоказать("Раздел1,Раздел21,Раздел22", РезультатыДиагностики);
	
	НастроитьОтборПоПодразделению();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставленияРеквизитовШапки()
	
	ИнвентаризацияСервер.УстановитьПредставлениеСпискаСчетовНаФормеОписи(ЭтаФорма);
	
	ИнвентаризацияСервер.УстановитьПредставлениеНомераКомиссииНаФормеОписи(ЭтаФорма);
	
	ИнвентаризацияСервер.УстановитьПредставлениеСпискаМестИнвентаризацииНаФормеОписи(ЭтаФорма);
	
КонецПроцедуры

