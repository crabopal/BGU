&НаКлиентеНаСервереБезКонтекста
Функция ОпределитьИзменияДопустимостиРедактированияРазделов(Форма, ТекущееЗначение, ПрежнееЗначение)
	
	ИзменияДопустимости = Новый Массив();
	
	Для Каждого Элемент Из ТекущееЗначение Цикл
		ИмяТЧРаздела = Элемент.Ключ;
		
		Если Элемент.Значение <> ПрежнееЗначение[ИмяТЧРаздела] Тогда
			ИзменияДопустимости.Добавить(ИмяТЧРаздела);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИзменияДопустимости;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьПометкуКнопкиКонтролироватьПоследовательностьЗаполненияРазделов(Форма)
	
	Форма.Элементы.ФормаКомандаКонтролироватьПоследовательностьЗаполненияРазделов.Пометка =
		Форма.КонтролироватьПоследовательностьЗаполненияРазделов;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНастройкуКонтроляПоследовательностиЗаполненияРазделов()
	
	КонтролироватьПоследовательностьЗаполненияРазделов = Не КонтролироватьПоследовательностьЗаполненияРазделов;
	
	НастроитьПометкуКнопкиКонтролироватьПоследовательностьЗаполненияРазделов(ЭтотОбъект);
	
	НастроитьФорму_ДопустимостьЗаполненияРазделов_Клиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьОтключениеКонтроляПоследовательностиЗаполненияРазделов()

	ТекстВопроса = НСтр("ru='Не рекомендуется отключать контроль последовательности заполнения разделов описи.
		|
		|Отключение контроля позволит заполнить разделы описи
		|в неожиданном сочетании и в порядке, отличном от предписываемого приказом Минфина от 15.04.2021 N 61н.
		|
		|Продолжить и отключить контроль последовательности заполнения разделов описи?'");
	
	Оповещение = Новый ОписаниеОповещения("ПодтвержденоОтключениеКонтроляПоследовательностиЗаполненияРазделов", ЭтотОбъект);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвержденоОтключениеКонтроляПоследовательностиЗаполненияРазделов(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ИзменитьНастройкуКонтроляПоследовательностиЗаполненияРазделов();
	КонецЕсли;
	
КонецПроцедуры

