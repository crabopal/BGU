Процедура ДобавитьУсловноеОформление_НеПрименяетсяИнвНомер(ИмяТЧ, ОтключитьПриВыявленныхОтклоненияхВРазделе4 = Ложь)
	
	//---
	// надпись "не применяется" для инвентарного номера
	//---
	ПредставлениеШаблон = НСтр("ru='Надпись ""не применяется"" колонки Инвентарный номер для номенклатуры (%1)'");
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблон, ИмяТЧ);

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТЧ + ".ТипНфаОС");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	Если ОтключитьПриВыявленныхОтклоненияхВРазделе4 Тогда
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
