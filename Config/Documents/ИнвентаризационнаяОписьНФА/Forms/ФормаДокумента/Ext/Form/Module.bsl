Процедура НастроитьПанельСерииДокументовСервер()
	
	ИнвентаризацияСервер.НастроитьПанельСерииДокументовНаФормеОписи(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеКолонкиСпискаДокументовСерии()
	
	ИнвентаризацияСервер.ЗаполнитьСлужебныеКолонкиСпискаДокументовСерии(ЭтаФорма);
	
	ИтогКоличествоСтрокРаздел1 = Объект.СписокДокументовСерии.Итог("КоличествоСтрокРаздел1");
	ИтогКоличествоСтрокРаздел21 = Объект.СписокДокументовСерии.Итог("КоличествоСтрокРаздел21");
	ИтогКоличествоСтрокРаздел22 = Объект.СписокДокументовСерии.Итог("КоличествоСтрокРаздел22");
	ИтогКоличествоСтрокРаздел3 = Объект.СписокДокументовСерии.Итог("КоличествоСтрокРаздел3");
	ИтогКоличествоСтрокРаздел4 = Объект.СписокДокументовСерии.Итог("КоличествоСтрокРаздел4");
	
КонецПроцедуры

