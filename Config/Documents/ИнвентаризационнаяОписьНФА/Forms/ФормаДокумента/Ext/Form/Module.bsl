Процедура ВвестиДокументыПоОтклонениям(Команда)
	Текст = "";
	Если ЭтотОбъект.Модифицированность Тогда
		Текст = НСтр("ru = 'Документ модифицирован. Его следует записать и провести'");
	ИначеЕсли НЕ Объект.Проведен Тогда
		Текст = НСтр("ru = 'Ввод документов по отклонениям возможен только после проведения документа'");
	КонецЕсли;
	Если ЗначениеЗаполнено(Текст) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Текст);
		Возврат;
	КонецЕсли;	

	ПараметрыФормы = Новый Структура("ДокументИнвентаризации", Объект.Ссылка);
	ОткрытьФорму("ОбщаяФорма.ПомощникВводаДокументовОтклоненияИнвентаризацииНФА", ПараметрыФормы, ЭтотОбъект);
