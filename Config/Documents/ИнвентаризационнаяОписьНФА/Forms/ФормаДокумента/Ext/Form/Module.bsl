&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение)
	
	ТаблицаМЗ = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	ТаблицаМЗ.Колонки.Номенклатура.Имя = "НФА";
	
	СлужебныеКолонки = Новый Структура("ТипНфаНоменклатура,ТипНфаОС", Истина, Ложь);
	
	Поиск = Новый Структура("НФА");
	
	Для Каждого СтрокаТаблицыМЗ Из ТаблицаМЗ Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицыМЗ);
		
		МассивСтрок = Объект.СписокНФА.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.СписокНФА.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыМЗ);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СлужебныеКолонки);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредустановленныйОтборПодборОстатковМЗ()
	
	СписокСсылок = Документы.ИнвентаризационнаяОписьНФА.ПолучитьИсключаемыеТипыНоменклатуры();
	
	НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных();
	
	НовыйЭлемент = НастройкиКомпоновки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТипНоменклатуры");
	НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
	НовыйЭлемент.ПравоеЗначение = Новый ФиксированныйМассив(СписокСсылок);
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(НастройкиКомпоновки);
	
КонецФункции

&НаКлиенте
Процедура УстановитьПараметрыВыбораОстатковНФА(ВыбранныйТип)
	
	МассивПараметров = Новый Массив();
	
	Если ВыбранныйТип = Тип("СправочникСсылка.Номенклатура") Тогда
		НовыйПараметр = Новый ПараметрВыбора("ПредустановленныйОтбор", ПредустановленныйОтборПодборОстатковМЗ);
		МассивПараметров.Добавить(НовыйПараметр);
	КонецЕсли;
	
	Элементы.СписокНФАНФА.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	
КонецПроцедуры

