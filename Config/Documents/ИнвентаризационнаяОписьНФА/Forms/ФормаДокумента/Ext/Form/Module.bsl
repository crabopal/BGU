#Область ГрупповоеЗаполнениеСтрок

&НаКлиенте
Процедура ОткрытьФормуГрупповогоЗаполненияСтрок(ИмяТабличнойЧасти)
	
	КоличествоСтрок = Элементы[ИмяТабличнойЧасти].ВыделенныеСтроки.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		ТекстСообщения = НСтр("ru='Выделите несколько строк для выполнения группового заполнения'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	Если ИмяТабличнойЧасти = "Раздел1" И ОтменитьВызовГрупповогоЗаполненияСтрокРаздела1() Тогда
		Возврат;
	КонецЕсли;
	
	СвязиПараметровВыбора = Новый Структура();
	СвязиПараметровВыбора.Вставить("МассивМестИнвентаризации", ПолучитьМассивМестИнвентаризации());
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
	
	ОповещениеВыбор = Новый ОписаниеОповещения("ЗакрытаФормаГрупповогоЗаполненияСтрок", ЭтаФорма, ДополнительныеПараметры);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("КоличествоСтрок",			КоличествоСтрок);
	ПараметрыФормы.Вставить("СвязиПараметровВыбора",	СвязиПараметровВыбора);
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",		Новый Структура());
	ПараметрыФормы.Вставить("ОписьСсылка",				Объект.Ссылка);
	ПараметрыФормы.Вставить("ИмяТабличнойЧасти",		ИмяТабличнойЧасти);
	
	НеиспользуемыеПоля = "";
	
	Если ИмяТабличнойЧасти = "Раздел1" Тогда
		НеиспользуемыеПоля = "СтатусОбъекта,ЦелеваяФункцияАктива,Примечание,ЗаключениеКомиссии,СтатусОбъяснения,ОбъяснениеПричинРасхождений";
		
	ИначеЕсли ИмяТабличнойЧасти = "Раздел21" Тогда
		НеиспользуемыеПоля = "ЗаключениеКомиссии,СтатусОбъяснения,ОбъяснениеПричинРасхождений";
		
		Если ЕстьАвтоматическиДобавленнаяСтрокаРаздела21() Тогда
			НеиспользуемыеПоля = НеиспользуемыеПоля + ",МестоИнвентаризации";
		КонецЕсли;
		
	ИначеЕсли ИмяТабличнойЧасти = "Раздел3" Тогда
		НеиспользуемыеПоля = "МестоИнвентаризации,Примечание,СтатусОбъекта,СтатусОбъяснения,ЦелеваяФункцияАктива,ЗаключениеКомиссии";
		
	ИначеЕсли ИмяТабличнойЧасти = "Раздел4" Тогда
		НеиспользуемыеПоля = "СтатусОбъекта,ЦелеваяФункцияАктива,Примечание,МестоИнвентаризации,ОбъяснениеПричинРасхождений";
		
		Если Не Объект.ВыявленыОтклонения Тогда
			НеиспользуемыеПоля = НеиспользуемыеПоля + ",СтатусОбъяснения";
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыФормы.Вставить("НеиспользуемыеПоля", НеиспользуемыеПоля);
	
	ОткрытьФорму("Документ.ИнвентаризационнаяОписьНФА.Форма.ГрупповоеЗаполнениеСтрок", ПараметрыФормы,,,,, ОповещениеВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытаФормаГрупповогоЗаполненияСтрок(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТабличнойЧасти = ПараметрыОповещения["ИмяТабличнойЧасти"];
	
	ВыделенныеСтроки = Элементы[ИмяТабличнойЧасти].ВыделенныеСтроки;
	
	СтруктураЗаполнения = Новый Структура();
	
	Если ИмяТабличнойЧасти = "Раздел1" Тогда
		СтруктураЗаполнения.Вставить("МестоИнвентаризацииЗаполненоВручную", Истина);
	КонецЕсли;
	
	Если ВыделенныеСтроки.Количество() < 100 Тогда
		ЗаполнитьВыделенныеСтрокиКлиент(ИмяТабличнойЧасти, ВыделенныеСтроки, РезультатВыбора, СтруктураЗаполнения);
	Иначе
		ЗаполнитьВыделенныеСтрокиСервер(ИмяТабличнойЧасти, ВыделенныеСтроки, РезультатВыбора, СтруктураЗаполнения);
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВыделенныеСтрокиКлиент(ИмяТабличнойЧасти, ВыделенныеСтроки, РезультатВыбора, СтруктураЗаполнения)
	
	ЗаполнитьВыделенныеСтроки(Объект[ИмяТабличнойЧасти], ВыделенныеСтроки, РезультатВыбора, СтруктураЗаполнения);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВыделенныеСтрокиСервер(ИмяТабличнойЧасти, ВыделенныеСтроки, РезультатВыбора, СтруктураЗаполнения)
	
	ЗаполнитьВыделенныеСтроки(Объект[ИмяТабличнойЧасти], ВыделенныеСтроки, РезультатВыбора, СтруктураЗаполнения);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьВыделенныеСтроки(ТабличнаяЧасть, ВыделенныеСтроки, РезультатВыбора, СтруктураЗаполнения)
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = ТабличнаяЧасть.НайтиПоИдентификатору(ИдСтроки);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, РезультатВыбора);
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтруктураЗаполнения);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьМассивМестИнвентаризации()
	
	Результат = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из Объект.МестаИнвентаризации Цикл
		Результат.Добавить(СтрокаТаблицы.МестоИнвентаризации);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ТСД

// Выгрузка в ТСД

&НаКлиенте
Процедура ПроверитьИВыгрузитьДанныеВТСДКлиент()
	
	Перем ЕстьОСБезШтрихкода;
	
	#Если ВебКлиент Тогда
	ПоказатьПредупреждение(,НСтр("ru = 'Работа с торговым оборудованием не поддерживается в режиме веб-клиента.
					|Для использования терминала сбора данных запустите программу в режиме тонкого клиента.'"), 15);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Объекты не выгружены'"));
	Возврат;
	#КонецЕсли

	АдресХранилищаСведений = ПолучитьСведенияДляВыгрузкиВТСД(ЕстьОСБезШтрихкода);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("АдресХранилищаСведений", АдресХранилищаСведений);
	
	Если ЕстьОСБезШтрихкода > 0 Тогда
		
		ТекстВопроса = НСтр("ru = 'Обнаружены объекты без штрихкода.
									|Объекты без штрихкода не будут выгружены в ТСД.
									|Открыть форму формирования штрихкода для данных объектов?'");
		Кнопки = Новый СписокЗначений();									
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Открыть форму формирования штрихкода'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Выгрузить в ТСД объекты со штрихкодом'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
		Оповещение = Новый ОписаниеОповещения("ПроверитьИВыгрузитьДанныеВТСДКлиент_ОтветФормированиеШтрихкода", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, 15);
		
	Иначе
		ВыгрузитьДанныеВТСДКлиент(Неопределено, ДополнительныеПараметры);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьСведенияДляВыгрузкиВТСД(ЕстьОСБезШтрихкода = Неопределено, ДляСозданияШтрихкодов = Ложь)
	
	Возврат Документы.ИнвентаризационнаяОписьНФА.ПолучитьСведенияДляВыгрузкиВТСД(ЭтаФорма, ЕстьОСБезШтрихкода, ДляСозданияШтрихкодов);
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИВыгрузитьДанныеВТСДКлиент_ОтветФормированиеШтрихкода(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		// Открыть форму ввода штрихкода и после закрытия перезаполнить таблицу ТСД
		ПараметрыФормы = Новый Структура("МассивОбъектов", ПолучитьСведенияДляВыгрузкиВТСД(, Истина));
		
		Оповещение = Новый ОписаниеОповещения("ВыгрузитьДанныеВТСДКлиент", ЭтотОбъект);
		
		ОткрытьФорму("РегистрСведений.ШтрихКоды.Форма.ФормаСозданияШтрихкодовОС", ПараметрыФормы, ЭтотОбъект,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		Возврат;
		
	ИначеЕсли Результат <> КодВозвратаДиалога.Нет Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Объекты не выгружены'"));
		
		Возврат;
		
	Иначе
		ВыгрузитьДанныеВТСДКлиент(Неопределено, ДополнительныеПараметры);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДанныеВТСДКлиент(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	МассивТСД = ПрочитатьСведенияДляВыгрузкиВТСД(ДополнительныеПараметры);
	
	Если МассивТСД.Количество() = 0 Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Нет объектов для выгрузки в ТСД'"), 15);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Объекты не выгружены'"));
		Возврат;
	КонецЕсли;
	
	УправлениеОсновнымиСредствамиКлиент.ВыгрузитьДанныеВТСД(ЭтотОбъект, МассивТСД);
	
КонецПроцедуры

&НаСервере
Функция ПрочитатьСведенияДляВыгрузкиВТСД(ДополнительныеПараметры)
	
	Если ДополнительныеПараметры <> Неопределено Тогда
		АдресХранилищаСведений = ДополнительныеПараметры.АдресХранилищаСведений;
	Иначе
		// Перезаполнить таблицу ТСД после закрытия формы штрихкода
		АдресХранилищаСведений = ПолучитьСведенияДляВыгрузкиВТСД();
	КонецЕсли;
	
	Возврат ПолучитьИзВременногоХранилища(АдресХранилищаСведений);
	
КонецФункции

// Загрузка из ТСД

&НаКлиенте
Процедура ПроверитьИЗагрузитьДанныеИзТСДКлиент()
	
	#Если ВебКлиент Тогда
	ПоказатьПредупреждение(,НСтр("ru = 'Работа с торговым оборудованием не поддерживается в режиме веб-клиента.
					|Для использования терминала сбора данных запустите программу в режиме тонкого клиента.'"), 15);
	Возврат;
	#КонецЕсли
	
	Отказ = Ложь;
	
	ОтменитьДобавлениеСтрокиРаздела21(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Доступность = Ложь; // Блокируем интерфейс пользователя.
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьДанныеИзТСДКлиент_Завершение", ЭтотОбъект);
	
	ОборудованиеТерминалыСбораДанныхКлиент.НачатьЗагрузкуДанныеИзТСД(Оповещение, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеИзТСДКлиент_Завершение(Результат, ДополнительныеПараметры) Экспорт

	ЭтаФорма.Доступность = Истина; // Разблокировка интерфейса пользователя.
	
	Если Результат.Результат Тогда
		МассивТСД = Результат.ТаблицаТоваров;
		
		ЗагрузитьДанныеИзТСДСервер(МассивТСД);
		
		ПоказатьПредупреждение(,Нстр("ru = 'Данные загружены'"));
	Иначе
		ТекстСообщения = НСтр("ru = 'При выполнении операции произошла ошибка:""%1"".'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Результат.ОписаниеОшибки);
		
		Сообщить(ТекстСообщения);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеИзТСДСервер(МассивТСД)
	
	Документы.ИнвентаризационнаяОписьНФА.ЗагрузитьДанныеИзТСД(Объект, МассивТСД);
	
	Модифицированность = Истина;
	
КонецПроцедуры


&НаСервере
Процедура ДобавитьОСПоШтрихкоду(Штрихкод)
	
	РезультатПоискаШК = РегистрыСведений.Штрихкоды.НайтиОбъектПоШтрихкоду(Штрихкод);
	
	Если Не ЗначениеЗаполнено(РезультатПоискаШК.ОсновноеСредство) Тогда
		Возврат;
	КонецЕсли;
	
	ПоискСтроки = Новый Структура();
	ПоискСтроки.Вставить("НФА",				РезультатПоискаШК.ОсновноеСредство);
	ПоискСтроки.Вставить("ИнвентарныйНомер",РезультатПоискаШК.ИнвентарныйНомер);
	
	МассивСтрок = Объект.Раздел21.НайтиСтроки(ПоискСтроки);
	
	Если МассивСтрок.Количество() = 0 Тогда
		СтруктураЗаполнения = Новый Структура();
		СтруктураЗаполнения.Вставить("ДобавленоВручную",	Истина);
		СтруктураЗаполнения.Вставить("ТипНфаОС",			Истина);
		СтруктураЗаполнения.Вставить("ТипНфаНоменклатура",	Ложь);
		СтруктураЗаполнения.Вставить("ЕдИзм",				ЕдИзмШт);
		
		Если Объект.МестаИнвентаризации.Количество() = 1 Тогда
			СтруктураЗаполнения.Вставить("МестоИнвентаризации", Объект.МестаИнвентаризации[0].МестоИнвентаризации);
		КонецЕсли;
		
		СтрокаТаблицы = Объект.Раздел21.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ПоискСтроки);
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтруктураЗаполнения);
	Иначе
		СтрокаТаблицы = МассивСтрок[0];
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомер) Тогда
		СтрокаТаблицы.Количество = 1;
	Иначе
		СтрокаТаблицы.Количество = СтрокаТаблицы.Количество + 1;
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ПанельРасписки

&НаСервере
Процедура НастроитьФормуПоРасписке()
	
	НастроитьПанельРаспискиИнвентаризацииСервер();
	
	НастроитьОбщуюДоступностьРазделов();
	
	Если НужноЗаблокироватьРеквизиты() Тогда
		// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
		ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
		НастроитьДоступностьСпискаНФА();
		// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПанельРаспискиИнвентаризацииСервер()
	
	ИнвентаризацияСервер.НастроитьПанельРаспискиНаФормеОписи(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОбщуюДоступностьРазделов()
	
	ЭтоОбычныйДокумент			= ИнвентаризацияКлиентСервер.ЭтоОбычныйДокументОписи(Объект);
	ЭтоЗаголовочныйДокумент		= ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(Объект);
	ЭтоСодержательныйДокумент	= ИнвентаризацияКлиентСервер.ЭтоСодержательныйДокументСерииДокументовОписи(Объект);
	
	Если ЭтоОбычныйДокумент Или ЭтоЗаголовочныйДокумент Тогда
		РаспискаПроведена = ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка) И ДанныеПанелиРасписки.РаспискаПроведена;
	Иначе
		РаспискаПроведена = Ложь;
	КонецЕсли;
	
	// Видимость закладок
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("ГруппаРаздел1");
	ИменаЭлементов.Добавить("ГруппаРаздел21");
	ИменаЭлементов.Добавить("ГруппаРаздел22");
	ИменаЭлементов.Добавить("ГруппаРаздел3");
	ИменаЭлементов.Добавить("ГруппаРаздел4");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементов,
		"Видимость",
		ЭтоОбычныйДокумент Или ЭтоСодержательныйДокумент);
		
	Элементы.ГруппаСписокДокументовСерии.Видимость	= ЭтоЗаголовочныйДокумент;
	Элементы.ГруппаКомиссия.Видимость				= ЭтоОбычныйДокумент Или ЭтоЗаголовочныйДокумент;
	
	// Общая доступность разделов.
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("ГруппаРаздел1Заголовок");
	ИменаЭлементов.Добавить("ГруппаРаздел21Заголовок");
	ИменаЭлементов.Добавить("ГруппаРаздел22Заголовок");
	ИменаЭлементов.Добавить("ГруппаРаздел3Заголовок");
	ИменаЭлементов.Добавить("ГруппаРаздел4Заголовок");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементов,
		"Доступность",
		РаспискаПроведена Или ЭтоСодержательныйДокумент);
	
	// СерииДокументов
	Если ЭтоСодержательныйДокумент Тогда
		// Только просмотр реквизитов шапки для содержательных документов
		ИменаЭлементов = Новый Массив();
		ИменаЭлементов.Добавить("Организация");
		ИменаЭлементов.Добавить("Подразделение");
		ИменаЭлементов.Добавить("ИФО");
		ИменаЭлементов.Добавить("РешениеОПроведенииИнвентаризации");
		ИменаЭлементов.Добавить("ОтветственныйИсполнитель");
		ИменаЭлементов.Добавить("ОтветственныйИсполнительБухгалтерскойСлужбы");
		
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
			ИменаЭлементов,
			"ТолькоПросмотр",
			Истина);
	КонецЕсли;
	// Конец СерииДокументов
	
	Если ЭтоЗаголовочныйДокумент Тогда
		// В заголовочном документе разделы не видны и не редактируются.
		Элементы.ФормаКомандаКонтролироватьПоследовательностьЗаполненияРазделов.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРаздела1

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1Клиент(Команда)
	
	ИнвентаризацияКлиент.ПроверитьЗаписьДокумента(ЭтаФорма,
		НСтр("ru = 'Заполнить по данным бух.учета'"),
		"ПроверитьИЗаполнитьРаздел1ПослеПроверкиЗаписиДокумента");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1ПослеПроверкиЗаписиДокумента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Объект.Раздел1.Количество() > 0 Тогда 
		ТекстВопроса = НСтр("ru='Перед заполнением табличные части документа будут очищены.
			|
			|Продолжить и заполнить раздел 1?'");
		Оповещение = Новый ОписаниеОповещения("ПроверитьИЗаполнитьРаздел1КлиентЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1КлиентЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовКлиент()
	
	Перем Отказ;
	
	ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовСервер(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел1Клиент();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовСервер(Отказ)
	
	Документы.ИнвентаризационнаяОписьНФА.ПроверитьПередЗаполнениемРаздела1(Объект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел1Клиент()
	
	Объект.Раздел1.Очистить();
	Объект.Раздел21.Очистить();
	Объект.Раздел22.Очистить();
	Объект.Раздел3.Очистить();
	Объект.Раздел4.Очистить();
	Объект.ВыявленыОтклонения = Ложь;
	
	Объект.СписокДокументовСерии.Очистить();
	
	РезультатЗадания = ЗаполнитьРаздел1Сервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияРаздел1Клиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРаздел1Сервер()
	
	ПараметрыФункции = Новый Структура("Ссылка");
	
	ЗаполнитьЗначенияСвойств(ПараметрыФункции, Объект);
	
	// СерииДокументов
	ИнвентаризацияСервер.ДобавитьПараметрыРасчетаСерииДокументов(ПараметрыФункции, Объект);
	// Конец СерииДокументов
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение раздела 1 инвентаризационной описи 0510466'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Документы.ИнвентаризационнаяОписьНФА.ПолучитьДанныеДляРаздела1",
		ПараметрыФункции)
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияРаздел1Клиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗавершениеЗаполненияРаздел1Сервер(Результат.АдресРезультата);
		
		Если ИнвентаризацияКлиентСервер.ЭтоОбычныйДокументОписи(Объект) Тогда
			Если Объект.Раздел1.Количество() = 0 Тогда
				ТекстСообщения = НСтр("ru='После заполнения раздел 1 оказался пустым'");
				
				ПоказатьПредупреждение(, ТекстСообщения);
			КонецЕсли;
			
		ИначеЕсли ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(Объект) Тогда
			ИнвентаризацияКлиент.СообщитьОСозданииСерииДокументов(Объект.СписокДокументовСерии.Количество(), "1, 2, 3, 4");
		КонецЕсли;
		
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='При заполнении раздела 1 возникла ошибка'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияРаздел1Сервер(АдресРезультата)
	
	Перем РезультатыДиагностики;
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Если Результат.Свойство("Раздел1") И Результат.Свойство("ДополнениеРаздела1") Тогда
		Объект.Раздел1.Загрузить(Результат.Раздел1);
		Объект.ДополнениеРаздела1.Загрузить(Результат.ДополнениеРаздела1);
		
		Объект.ИдентификаторСерииДокументов = "";
		Объект.ЭтоЗаголовочныйДокумент = Ложь;
		
		Модифицированность = Истина;
	Иначе
		ЭтаФорма.Прочитать();
	КонецЕсли;
	
	// СерииДокументов
	НастроитьФормуПоСерииДокументов();
	// Конец СерииДокументов
	
	Документы.ИнвентаризационнаяОписьНФА.ЗаполнитьСлужебныеКолонки(ЭтаФорма, "Раздел1", РезультатыДиагностики);
	
	НастроитьФорму_ДопустимостьЗаполненияРазделов_Сервер();
	
	ОбновитьКнопкиПоказать("Раздел1,Раздел21,Раздел22", РезультатыДиагностики);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРаздела21

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел21Клиент(Команда, СКоличеством)
	
	ДополнительныеПараметры = Новый Структура("СКоличеством", СКоличеством);
	
	ИнвентаризацияКлиент.ПроверитьЗаписьДокумента(ЭтаФорма,
		НСтр("ru = 'Заполнить по данным раздела 1'"),
		"ПроверитьИЗаполнитьРаздел21ПослеПроверкиЗаписиДокумента",
		ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел21ПослеПроверкиЗаписиДокумента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Объект.Раздел21.Количество() > 0 Тогда 
		ТекстВопроса = НСтр("ru='Перед заполнением табличные части документа будут очищены.
			|
			|Продолжить и заполнить раздел 2.1?'");
		Оповещение = Новый ОписаниеОповещения("ПроверитьИЗаполнитьРаздел21КлиентЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ПроверитьИЗаполнитьРаздел21КорректностьЗаполненияПредыдущихРазделовКлиент(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел21КлиентЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьИЗаполнитьРаздел21КорректностьЗаполненияПредыдущихРазделовКлиент(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел21КорректностьЗаполненияПредыдущихРазделовКлиент(ДополнительныеПараметры)
	
	Перем Отказ;
	
	ПроверитьИЗаполнитьРаздел21КорректностьЗаполненияПредыдущихРазделовСервер(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел21Клиент(ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИЗаполнитьРаздел21КорректностьЗаполненияПредыдущихРазделовСервер(Отказ)
	
	Документы.ИнвентаризационнаяОписьНФА.ПроверитьПередЗаполнениемРаздела21(Объект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел21Клиент(ДополнительныеПараметры)
	
	Объект.Раздел21.Очистить();
	Объект.Раздел22.Очистить();
	Объект.Раздел3.Очистить();
	Объект.Раздел4.Очистить();
	Объект.ВыявленыОтклонения = Ложь;
	
	Объект.СписокДокументовСерии.Очистить();
	
	РезультатЗадания = ЗаполнитьРаздел21Сервер(ДополнительныеПараметры);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияРаздел21Клиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРаздел21Сервер(ДополнительныеПараметры)
	
	ПараметрыФункции = Новый Структура("Ссылка");
	ПараметрыФункции.Вставить("СКоличеством", ДополнительныеПараметры.СКоличеством);
	
	ЗаполнитьЗначенияСвойств(ПараметрыФункции, Объект);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение раздела 2.1 инвентаризационной описи 0510466'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Документы.ИнвентаризационнаяОписьНФА.ПолучитьДанныеДляРаздела21",
		ПараметрыФункции)
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияРаздел21Клиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗавершениеЗаполненияРаздел21Сервер(Результат.АдресРезультата);
		
		Если Объект.Раздел21.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru='После заполнения раздел 2.1 оказался пустым'");
			
			ПоказатьПредупреждение(, ТекстСообщения);
		КонецЕсли;
		
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='При заполнении раздела 2.1 возникла ошибка'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияРаздел21Сервер(АдресРезультата)
	
	Перем РезультатыДиагностики;
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Объект.Раздел21.Загрузить(Результат.ТаблицаРаздела21);
	
	Модифицированность = Истина;
	
	Документы.ИнвентаризационнаяОписьНФА.ЗаполнитьСлужебныеКолонки(ЭтаФорма, "Раздел21", РезультатыДиагностики);
	
	НастроитьФорму_ДопустимостьЗаполненияРазделов_Сервер();
	
	ОбновитьКнопкиПоказать("Раздел21,Раздел22", РезультатыДиагностики);
	
КонецПроцедуры

#КонецОбласти

#Область РазбивкаСтрокиРаздела21

&НаКлиенте
Процедура ОткрытьФормуРазбивкиСтрокиРаздела2(ИмяТЧ)
	
	ТекДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите разбиваемую строку'"));
		
		Возврат;
	КонецЕсли;
	
	Если Элементы[ИмяТЧ].ВыделенныеСтроки.Количество() > 1 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите одну строку для разбивки,
			|сейчас выбрано несколько строк'"));
		
		Возврат;
	КонецЕсли;
	
	ПараметрыФормыРазбивки = ПолучитьПараметрыФормыРазбивкиСтрокиРаздела2(ИмяТЧ, ТекДанные.ПолучитьИдентификатор());
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяТЧ",			ИмяТЧ);
	ДополнительныеПараметры.Вставить("ИсходнаяСтрока",	ПараметрыФормыРазбивки.ИсходнаяСтрока);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакрытаФормаРазбивкиСтрокиРаздела2", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.ИнвентаризационнаяОписьНФА.Форма.РазбивкаСтрокиРаздела21", ПараметрыФормыРазбивки,,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыФормыРазбивкиСтрокиРаздела2(ИмяТЧ, ИдСтроки)
	
	ТекДанные = Объект[ИмяТЧ].НайтиПоИдентификатору(ИдСтроки);
	
	Возврат Документы.ИнвентаризационнаяОписьНФА.ПолучитьПараметрыФормыРазбивкиСтрокиРаздела2(Объект, ИмяТЧ, ТекДанные);
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаРазбивкиСтрокиРаздела2(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТЧ = ДополнительныеПараметры.ИмяТЧ;
	
	// НомераСтрокФрагментов упорядочены по возрастанию.
	НомераСтрокФрагментов	= РезультатВыбора.НомераСтрокФрагментов;
	ФрагментыСтроки			= РезультатВыбора.ФрагментыСтроки;
	
	КоличествоПрежнихФрагментов = НомераСтрокФрагментов.Количество();
	КоличествоНовыхФрагментов = ФрагментыСтроки.Количество();
	
	// Удаляем прежние фрагменты, начиная с последнего.
	Для Счетчик = 1 По КоличествоПрежнихФрагментов Цикл
		Индекс = КоличествоПрежнихФрагментов - Счетчик;
		
		Объект[ИмяТЧ].Удалить(НомераСтрокФрагментов[Индекс] - 1);
	КонецЦикла;
	
	// Вставляем новые фрагменты на место первой строки прежних фрагментов, начиная с последнего.
	ИндексВставки = НомераСтрокФрагментов[0] - 1;
	
	СлужебныеКолонки = Новый Структура();
	СлужебныеКолонки.Вставить("ТипНфаОС", ТипЗнч(ДополнительныеПараметры.ИсходнаяСтрока.НФА) = Тип("СправочникСсылка.ОсновныеСредства"));
	
	Для Счетчик = 1 По КоличествоНовыхФрагментов Цикл
		Индекс = КоличествоНовыхФрагментов - Счетчик;
		
		СтруктураСтроки = ФрагментыСтроки[Индекс];
		
		НоваяСтрока = Объект[ИмяТЧ].Вставить(ИндексВставки);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДополнительныеПараметры.ИсходнаяСтрока);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СлужебныеКолонки);
		
		НоваяСтрока.ПризнакФрагментаСтроки = Истина;
	КонецЦикла;
	
	Если КоличествоНовыхФрагментов = 1 Тогда
		НоваяСтрока.ИдентификаторСтроки = Неопределено;
		НоваяСтрока.ПризнакФрагментаСтроки = Ложь;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Элементы[ИмяТЧ].ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПриНеобходимостиФормуРазбивкиСтрокиРаздела2(ИмяТЧ, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если Не ТекДанные.ПризнакФрагментаСтроки Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоля = СтрЗаменить(Поле.Имя, ИмяТЧ, "");
	
	// Эти поля разрешаем редактировать обычным способом в табличной части
	Если ИмяПоля = "Примечание"
		Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуРазбивкиСтрокиРаздела2(ИмяТЧ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьУдалениеФрагментаСтроки(ИмяТЧ, Отказ)
	
	Перем НомерСтроки;
	
	ВыделенныеСтроки = Элементы[ИмяТЧ].ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() < 100 Тогда
		ОтменитьУдалениеФрагментаСтрокиКлиент(ИмяТЧ, Отказ, ВыделенныеСтроки, НомерСтроки);
	Иначе
		ОтменитьУдалениеФрагментаСтрокиСервер(ИмяТЧ, Отказ, ВыделенныеСтроки, НомерСтроки);
	КонецЕсли;
	
	Если Отказ Тогда
		ТекстСообшения = СтрШаблон(НСтр("ru = 'Среди выбранных строк есть фрагмент разбитой строки (N %1).
			|Удаление и редактирование всех фрагментов разбитой строки выполняется сообща в форме разбивки строки.
			|
			|Воспользуйтесь формой разбивки строки для редактирования фрагментов разбитой строки.'"), НомерСтроки);
		
		ПоказатьПредупреждение(, ТекстСообшения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьУдалениеФрагментаСтрокиКлиент(ИмяТЧ, Отказ, ВыделенныеСтроки, НомерСтроки);
	
	Если ИнвентаризацияКлиентСервер.ЕстьПризнакФрагментаСтрок(Объект[ИмяТЧ], ВыделенныеСтроки, НомерСтроки) Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьУдалениеФрагментаСтрокиСервер(ИмяТЧ, Отказ, ВыделенныеСтроки, НомерСтроки);
	
	Если ИнвентаризацияКлиентСервер.ЕстьПризнакФрагментаСтрок(Объект[ИмяТЧ], ВыделенныеСтроки, НомерСтроки) Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ДобавлениеСтрокиВРаздел22

&НаКлиенте
Процедура ПроверитьИДобавитьВРаздел22()
	
	КоличествоСтрок = Элементы.Раздел21.ВыделенныеСтроки.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		ТекстСообщения = НСтр("ru='Выберите строки для добавления в раздел 2.2'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	Текст1 = НСтр("ru='Добавить выбранные строки в раздел 2.2 для указания информации об объектах НФА, '");
	Текст2 = НСтр("ru='имеющих признаки несоответствия условиям актива или признаки обесценения, '");
	Текст3 = НСтр("ru='или объектах НФА, имеющих суммовую недостачу, у которых не ведется количественный учет '");
	Текст4 = НСтр("ru='(например, библиотечный фонд стоимостью до 100 тыс. рублей включительно)?'");
	
	ТекстВопроса = Текст1 + Текст2 + Текст3 + Текст4;
	
	Оповещение = Новый ОписаниеОповещения("ПроверитьИДобавитьВРаздел22Завершение", ЭтотОбъект);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИДобавитьВРаздел22Завершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Перем РезультатДобавления;
	
	Если РезультатВыбора <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.Раздел21.ВыделенныеСтроки;
	
	КоличествоСтрок = ВыделенныеСтроки.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		ТекстСообщения = НСтр("ru='Не выбраны строки для добавления в раздел 2.2'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	РезультатДобавления = ДобавитьВРаздел22Сервер(ВыделенныеСтроки);
	
	РезультатПоискаНеучтенныхОтклонений = РезультатДобавления.РезультатПоискаНеучтенныхОтклоненийРазделов1и21ПоСпискуНФА;
	
	Если РезультатПоискаНеучтенныхОтклонений.ЕстьНеучтенныеОтклонения Тогда
		Если РезультатПоискаНеучтенныхОтклонений.КоличествоРазличныхКодовСтрок = 1 Тогда
			ШаблонСтрокиПереченьКодовСтрок = НСтр("ru='код строки %1'");
		Иначе
			ШаблонСтрокиПереченьКодовСтрок = НСтр("ru='коды строк %1'");
		КонецЕсли;
		
		ПереченьКодовСтрок = СтрШаблон(ШаблонСтрокиПереченьКодовСтрок, РезультатПоискаНеучтенныхОтклонений.КодыСтрокСтрокой);
		
		ТекстШаблон = НСтр("ru='Добавление строк в раздел 2.2 отменено.
			|Среди выбранных строк раздела 2.1 выявлено наличие отклонений от раздела 1, которые пока не отражены в разделе 2.2.
			|См. %1.
			|
			|Необходимо заполнить раздел 2.2 по команде ""Заполнить недостачу и излишки"" и указать сведения о несоответствии условиям актива или обесценении непосредственно в разделе 2.2.'");
		
		ПоказатьПредупреждение(, СтрШаблон(ТекстШаблон, ПереченьКодовСтрок));
		
		Возврат;
	КонецЕсли;
	
	ДобавленоСтрок							= РезультатДобавления.ДобавленоСтрок;
	ПропущеноПоПричинеНаличияСтрок			= РезультатДобавления.ПропущеноПоПричинеНаличияСтрок;
	ПропущеноПоПричинеНулевогоКоличества	= РезультатДобавления.ПропущеноПоПричинеНулевогоКоличества;
	
	МассивТекстов = Новый Массив();
	
	Если ДобавленоСтрок > 0 Тогда
		// Категории для русского языка:
		//	Ноль	(-);
		//	Один	(1 шт);
		//	Два		(-);
		//	Немного	(2 шт);
		//	Много	(5 шт);
		//	Другое	(-)
		ТекстДобавленоСтрок = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru=';добавлена %1 строка;;добавлено %1 строки;добавлено %1 строк;'"),
			ДобавленоСтрок);
			
		МассивТекстов.Добавить(СтрШаблон(НСтр("ru='В раздел 2.2 успешно %1.'"), ТекстДобавленоСтрок));
		
		НастроитьФорму_ДопустимостьЗаполненияРазделов_Клиент();
	КонецЕсли;
	
	Если ПропущеноПоПричинеНаличияСтрок > 0 Тогда
		МассивТекстов.Добавить(СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru=';%1 строка не была добавлена, потому что уже присутствует в разделе 2.2.;;%1 строки не были добавлены, потому что уже присутствуют в разделе 2.2.;%1 строк не были добавлены, потому что уже присутствуют в разделе 2.2.;'"),
			ПропущеноПоПричинеНаличияСтрок));
	КонецЕсли;
	
	Если ПропущеноПоПричинеНулевогоКоличества > 0 Тогда
		ТекстПропущеноСтрок = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru=';%1 строка не была добавлена;;%1 строки не были добавлены;%1 строк не были добавлены;'"),
			ПропущеноПоПричинеНулевогоКоличества);
		
		МассивТекстов.Добавить(СтрШаблон(НСтр("ru='%1, потому что поле Количество нулевое.'"), ТекстПропущеноСтрок));
	КонецЕсли;
	
	Если МассивТекстов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьПредупреждение(, СтрСоединить(МассивТекстов, "
		|
		|"));
	
КонецПроцедуры

&НаСервере
Функция ДобавитьВРаздел22Сервер(Знач ВыделенныеСтроки, ДобавлятьСНулевымКоличеством = Истина)
	
	РезультатПоискаНеучтенныхОтклонений = Документы.ИнвентаризационнаяОписьНФА.НайтиНеучтенныеОтклоненияРазделов1и21ПоСпискуНФА(Объект, ВыделенныеСтроки);
	
	РезультатДобавления = НовыйРезультатДобавленияВРаздел22();
	РезультатДобавления.РезультатПоискаНеучтенныхОтклоненийРазделов1и21ПоСпискуНФА = РезультатПоискаНеучтенныхОтклонений;
	
	Если РезультатПоискаНеучтенныхОтклонений.ЕстьНеучтенныеОтклонения Тогда
		Возврат РезультатДобавления;
	КонецЕсли;
	
	Поиск = Новый Структура("КодСтроки");
	
	ДобавленныеСтроки = Новый Массив();
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = Объект.Раздел21.НайтиПоИдентификатору(ИдСтроки);
		
		Если СтрокаТаблицы.Количество = 0 И Не ДобавлятьСНулевымКоличеством Тогда
			РезультатДобавления.ПропущеноПоПричинеНулевогоКоличества = РезультатДобавления.ПропущеноПоПричинеНулевогоКоличества + 1;
			
			Продолжить;
		КонецЕсли;
		
		Поиск.КодСтроки = СтрокаТаблицы.НомерСтроки;
		
		МассивСтрок = Объект.Раздел22.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			РезультатДобавления.ПропущеноПоПричинеНаличияСтрок = РезультатДобавления.ПропущеноПоПричинеНаличияСтрок + 1;
			
			Продолжить;
		КонецЕсли;
			
		НоваяСтрока = Объект.Раздел22.Добавить();
		НоваяСтрока.ДобавленоВручную = Истина;
		НоваяСтрока.КодСтроки = СтрокаТаблицы.НомерСтроки;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "НФА,ИнвентарныйНомер,ЕдИзм,МестоИнвентаризации,ТипНфаНоменклатура,ТипНфаОС");
		
		НоваяСтрока.КоличествоИзРаздела21	= СтрокаТаблицы.Количество;
		НоваяСтрока.Цена					= СтрокаТаблицы.Цена;
		
		ДобавленныеСтроки.Добавить(НоваяСтрока);
		
		РезультатДобавления.ДобавленоСтрок = РезультатДобавления.ДобавленоСтрок + 1;
	КонецЦикла;
	
	Если РезультатДобавления.ДобавленоСтрок > 0 Тогда
		Объект.Раздел22.Сортировать("КодСтроки");
		
		Модифицированность = Истина;
	КонецЕсли;
	
	Возврат РезультатДобавления;
	
КонецФункции

&НаСервере
Функция НовыйРезультатДобавленияВРаздел22()
	
	РезультатДобавления = Новый Структура();
	РезультатДобавления.Вставить("ДобавленоСтрок", 0);
	РезультатДобавления.Вставить("ПропущеноПоПричинеНаличияСтрок", 0);
	РезультатДобавления.Вставить("ПропущеноПоПричинеНулевогоКоличества", 0);
	РезультатДобавления.Вставить("РезультатПоискаНеучтенныхОтклоненийРазделов1и21ПоСпискуНФА", Новый Структура());
	
	Возврат РезультатДобавления;
	
