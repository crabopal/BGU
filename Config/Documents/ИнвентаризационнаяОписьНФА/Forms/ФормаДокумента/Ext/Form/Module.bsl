	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Объект.Раздел22.Загрузить(Результат.ТаблицаРаздела22);
	
	Модифицированность = Истина;
	
	Документы.ИнвентаризационнаяОписьНФА.ЗаполнитьСлужебныеКолонки(ЭтаФорма, "Раздел22", РезультатыДиагностики);
	
	НастроитьФорму_ДопустимостьЗаполненияРазделов_Сервер();
	
	ОбновитьКнопкиПоказать("Раздел22", РезультатыДиагностики);
	
