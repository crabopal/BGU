	НедоступныеКолонки.Добавить("СписокСчетовСчет");
	
	НедоступныеКолонки.Добавить("МестаИнвентаризацииМестоИнвентаризации");
	
	НедоступныеКолонки.Добавить("Раздел1ИнвентарныйНомер");
	НедоступныеКолонки.Добавить("Раздел1ЕдИзм");
	НедоступныеКолонки.Добавить("Раздел1НФА");
	НедоступныеКолонки.Добавить("Раздел1Счет");
	НедоступныеКолонки.Добавить("Раздел1КПС");
	НедоступныеКолонки.Добавить("Раздел1КФО");
	НедоступныеКолонки.Добавить("Раздел1ИФО");
	НедоступныеКолонки.Добавить("Раздел1ЦМО");
	НедоступныеКолонки.Добавить("Раздел1Подразделение");
	НедоступныеКолонки.Добавить("Раздел1Количество");
	НедоступныеКолонки.Добавить("Раздел1Сумма");
	
	НедоступныеКолонки.Добавить("Раздел22НФА");
	НедоступныеКолонки.Добавить("Раздел22ИнвентарныйНомер");
	НедоступныеКолонки.Добавить("Раздел22ЕдИзм");
	НедоступныеКолонки.Добавить("Раздел22МестоИнвентаризации");
	НедоступныеКолонки.Добавить("Раздел22КоличествоНедостача");
	НедоступныеКолонки.Добавить("Раздел22КоличествоИзлишки");
	
	НедоступныеКолонки.Добавить("Раздел3НФА");
	НедоступныеКолонки.Добавить("Раздел3ИнвентарныйНомер");
	НедоступныеКолонки.Добавить("Раздел3ЕдИзм");
	НедоступныеКолонки.Добавить("Раздел3МестоИнвентаризации");
	НедоступныеКолонки.Добавить("Раздел3КоличествоНедостача");
	НедоступныеКолонки.Добавить("Раздел3СуммаНедостача");
	НедоступныеКолонки.Добавить("Раздел3КоличествоИзлишки");
	
	НедоступныеКолонки.Добавить("Раздел4НФА");
	НедоступныеКолонки.Добавить("Раздел4ИнвентарныйНомер");
	НедоступныеКолонки.Добавить("Раздел4ЕдИзм");
	НедоступныеКолонки.Добавить("Раздел4МестоИнвентаризации");
	НедоступныеКолонки.Добавить("Раздел4КоличествоНеСоответствует");
