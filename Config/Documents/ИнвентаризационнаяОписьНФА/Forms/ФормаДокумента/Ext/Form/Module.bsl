&НаКлиенте
Процедура Раздел21ПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.Раздел21.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтменитьУдалениеАвтоСтрокРаздела21(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ОтменитьУдалениеФрагментаСтроки("Раздел21", Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел21ПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока  Тогда
		ТекДанные = Элементы.Раздел21.ТекущиеДанные;
		
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		СтруктураЗаполнения = Новый Структура();
		СтруктураЗаполнения.Вставить("ДобавленоВручную",		Истина);
		СтруктураЗаполнения.Вставить("ИдентификаторСтроки",		"");
		СтруктураЗаполнения.Вставить("ПризнакФрагментаСтроки",	Ложь);
		
		Если Не Копирование И Объект.МестаИнвентаризации.Количество() = 1 Тогда
			СтруктураЗаполнения.Вставить("МестоИнвентаризации",	Объект.МестаИнвентаризации.Получить(0).МестоИнвентаризации);
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ТекДанные, СтруктураЗаполнения);
		
		НастроитьФорму_ДопустимостьЗаполненияРазделов_Клиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел21ПослеУдаления(Элемент)
	
	НастроитьФорму_ДопустимостьЗаполненияРазделов_Клиент();
	
КонецПроцедуры

&НаКлиенте
Процедура Раздел21НФАПриИзменении(Элемент)
	
	ТекДанные = Элементы.Раздел21.ТекущиеДанные;
	
	ТипНфаОС			= (ТипЗнч(ТекДанные.НФА) = Тип("СправочникСсылка.ОсновныеСредства"));
	ТипНфаНоменклатура	= (ТипЗнч(ТекДанные.НФА) = Тип("СправочникСсылка.Номенклатура"));
	
	Если ЗначениеЗаполнено(ТекДанные.НФА) И ТипНфаОС Тогда
		ЕдИзм = ЕдИзмШт;
		
	ИначеЕсли ЗначениеЗаполнено(ТекДанные.НФА) И ТипНфаНоменклатура Тогда
		ЕдИзм = ПрочитатьЕдиницуИзмеренияНоменклатуры(ТекДанные.НФА);
		
	Иначе
		ЕдИзм = Неопределено;
	КонецЕсли;
	
	СтруктураЗаполнения = Новый Структура("
		|ЕдИзм,
		|СтатусОбъекта,
		|ЦелеваяФункцияАктива,
		|Примечание,
		|ИдентификаторСтроки,
		|Количество,
		|ТипНфаОС,
		|ТипНфаНоменклатура");
	
	СтруктураЗаполнения.ЕдИзм				= ЕдИзм;
	СтруктураЗаполнения.ТипНфаОС			= ТипНфаОС;
	СтруктураЗаполнения.ТипНфаНоменклатура	= ТипНфаНоменклатура;
	
	ЗаполнитьЗначенияСвойств(Элементы.Раздел21.ТекущиеДанные, СтруктураЗаполнения);
	
КонецПроцедуры

