		Новый Структура("МестоИнвентаризации", Неопределено),
		"ЕстьПустыеМестаИнвентаризации");
		
	ДобавитьОписаниеКнопкиПоказатьРаздела(НастройкиКнопок,
		"Раздел1ПоказатьТолькоДопСведения",
		Новый Структура("ЕстьДопСведения", Истина),
		"ЕстьДопСведения");
		
	ДобавитьОписаниеКнопкиПоказатьРаздела(НастройкиКнопок,
		"Раздел1ПоказатьТолькоМестаИнвентаризацииЗаполненныеВручную",
		Новый Структура("МестоИнвентаризацииЗаполненоВручную", Истина),
		"ЕстьМестаИнвентаризацииЗаполненныеВручную");
		
	Возврат НастройкиКнопок;
	
КонецФункции

