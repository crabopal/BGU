// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Акт0510456") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Акт0510456", "ф. 0510456",
			УправлениеПечатьюБГУ.Напечатать0510456(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ф0504105") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ф0504105", "ф.0504105",
			УправлениеПечатьюБГУ.Напечатать0504105(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ф0504105_103н") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ф0504105_103н", "ф.0504105",
			УправлениеПечатьюБГУ.Напечатать0504105(МассивОбъектов, ОбъектыПечати, "103н"));
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ПечатьИнвКарточек61н") Тогда
		
		ДанныеДляПечати = ДанныеДляПечатиИнвКарточек(МассивОбъектов);
		ИменаФайловПечати = Новый Соответствие;
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПечатьИнвКарточек61н","Инвентарные карточки объектов",
			Справочники.ОсновныеСредства.ПечатьИнвентарнойКарточки61н(
			ДанныеДляПечати, ПараметрыПечати, ОбъектыПечати, ИменаФайловПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеДляПечатиИнвКарточек(МассивОбъектов)
	
	ШаблонТекста  =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Док.ОсновноеСредство КАК ОсновноеСредство
	|ИЗ
	|	&ИмяДокумента КАК Док
	|ГДЕ
	|	Док.Ссылка В (&МассивОбъектов)";
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "";
	Для Каждого Документ Из ОбщегоНазначенияБГУ.ДокументыПоТипам(МассивОбъектов) Цикл
		ИмяДокумента = Метаданные.НайтиПоТипу(Документ.Ключ).Имя;
		
		ТекШаблон = ШаблонТекста;
		Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
			ТекШаблон = СтрЗаменить(ШаблонТекста, "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ", "ВЫБРАТЬ");
		КонецЕсли;	                                                                          
		ТекШаблон = СтрЗаменить(ТекШаблон, "&ИмяДокумента", "Документ." + ИмяДокумента);
		ТекШаблон = СтрЗаменить(ТекШаблон, "&МассивОбъектов", "&МассивОбъектов" + ИмяДокумента);
		Запрос.УстановитьПараметр("МассивОбъектов" + ИмяДокумента, Документ.Значение);
		
		Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|ОБЪЕДИНИТЬ ВСЕ
			|";
		КонецЕсли;	
		ТекстЗапроса = ТекстЗапроса + ТекШаблон;
		
	КонецЦикла;   
	Запрос.Текст = ТекстЗапроса;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
КонецФункции

#КонецОбласти

Функция ТаблицаРазделителейДокументов_РешениеОПрекращенииПризнанияАктивом(ДокументОснование)
	СвойстваОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Дата, Организация");
	Счета_21 = БухгалтерскийУчет.СписокСчетов("21", СвойстваОбъекта.Дата,, СвойстваОбъекта.Организация);
	Счета_106 = БухгалтерскийУчет.СписокСчетов("106.00", СвойстваОбъекта.Дата,, СвойстваОбъекта.Организация);
	Счета_01 = БухгалтерскийУчет.СписокСчетов("01", СвойстваОбъекта.Дата,, СвойстваОбъекта.Организация);
	Счета_02 = БухгалтерскийУчет.СписокСчетов("02", СвойстваОбъекта.Дата,, СвойстваОбъекта.Организация);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_21)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет)
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_01)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписанияОС.СписаниеОСПолученныхВПользование)
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_02)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписанияОС.СписаниеОСнаХранении)
	|		КОГДА ТЧОсновныеСредства.СчетУчета В (&Счета_106)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений)
	|		Иначе ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписанияОС.СписаниеСобственныхОС)
	|	КОНЕЦ КАК ВидОперации,
	|	ТЧОсновныеСредства.ОсновноеСредство,
	|	ТЧОсновныеСредства.ИнвентарныйНомер,
	|	ТЧОсновныеСредства.КФО,
	|	ТЧОсновныеСредства.КПС,
	|	ТЧОсновныеСредства.СчетУчета
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивом.ОсновныеСредства КАК ТЧОсновныеСредства
	|ГДЕ
	|	ТЧОсновныеСредства.Ссылка = &Ссылка
	|	И ТЧОсновныеСредства.ОсновноеСредство.ТипНФА = &ТипНФА";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Запрос.УстановитьПараметр("ТипНФА", Перечисления.ТипыНФА.Транспорт);
	Запрос.УстановитьПараметр("Счета_21", Счета_21);
	Запрос.УстановитьПараметр("Счета_01", Счета_01);
	Запрос.УстановитьПараметр("Счета_02", Счета_02);
	Запрос.УстановитьПараметр("Счета_106", Счета_106);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ТаблицаРазделителейДокументов_ИнвентаризационнаяОписьНФА(ДокументОснование, СсылкаЦелевогоДокумента)
	Запрос = Новый Запрос;
	КодыСчетовГрупп = КодыСчетовГрупп();
	
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокументОснование, СсылкаЦелевогоДокумента);
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СчетаГруппы
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код В (&КодыСчетовГрупп)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеИнвентаризации.ИФО КАК ИФО,
	|	ДанныеИнвентаризации.НФА КАК ТранспортноеСредство,
	|	ДанныеИнвентаризации.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеИнвентаризации.Счет.Забалансовый
	|			ТОГДА ВЫБОР
	|				КОГДА ПОДСТРОКА(ДанныеИнвентаризации.Счет.Код, 1, 3) В (""106"")
	|					ТОГДА &Вложение
	|				ИНАЧЕ &НаБалансе
	|			КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|			КОГДА ПОДСТРОКА(ДанныеИнвентаризации.Счет.Код, 1, 2) = ""01""
	|				ТОГДА &ВПользовании
	|			КОГДА ПОДСТРОКА(ДанныеИнвентаризации.Счет.Код, 1, 2) = ""02""
	|				ТОГДА &НаХранении
	|			ИНАЧЕ &ВОперУчете
	|		КОНЕЦ
	|	КОНЕЦ КАК ВидУчета
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта = 3
	|	И ДанныеИнвентаризации.Счет В ИЕРАРХИИ
	|		(ВЫБРАТЬ
	|			СчетаГруппы.Ссылка
	|		ИЗ
	|			СчетаГруппы)
	|	И (ДанныеИнвентаризации.КоличествоНедостачаНеПодтверждено <> 0
	|	ИЛИ ДанныеИнвентаризации.СуммаНедостачаНеПодтверждено <> 0)
	|СГРУППИРОВАТЬ ПО
	|	ДанныеИнвентаризации.ИФО,
	|	ДанныеИнвентаризации.НФА,
	|	ДанныеИнвентаризации.ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеИнвентаризации.Счет.Забалансовый
	|			ТОГДА ВЫБОР
	|				КОГДА ПОДСТРОКА(ДанныеИнвентаризации.Счет.Код, 1, 3) В (""106"")
	|					ТОГДА &Вложение
	|				ИНАЧЕ &НаБалансе
	|			КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|			КОГДА ПОДСТРОКА(ДанныеИнвентаризации.Счет.Код, 1, 2) = ""01""
	|				ТОГДА &ВПользовании
	|			КОГДА ПОДСТРОКА(ДанныеИнвентаризации.Счет.Код, 1, 2) = ""02""
	|				ТОГДА &НаХранении
	|			ИНАЧЕ &ВОперУчете
	|		КОНЕЦ
	|	КОНЕЦ";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Запрос.УстановитьПараметр("КодыСчетовГрупп", КодыСчетовГрупп);
	Запрос.УстановитьПараметр("Вложение", ПредставлениеВидаУчетаПоИмениПараметра("Вложение"));
	Запрос.УстановитьПараметр("НаБалансе", ПредставлениеВидаУчетаПоИмениПараметра("НаБалансе"));
	Запрос.УстановитьПараметр("ВПользовании", ПредставлениеВидаУчетаПоИмениПараметра("ВПользовании"));
	Запрос.УстановитьПараметр("НаХранении", ПредставлениеВидаУчетаПоИмениПараметра("НаХранении"));
	Запрос.УстановитьПараметр("ВОперУчете", ПредставлениеВидаУчетаПоИмениПараметра("ВОперУчете"));
	
	ТаблицаРазделителей = Запрос.Выполнить().Выгрузить();
	СтруктураРазделителей = Новый Структура("Разделители, ЗаголовкиКолонок");
	СтруктураРазделителей.Вставить("Разделители", ТаблицаРазделителей);
	СтруктураРазделителей.Вставить("ЗаголовкиКолонок", Новый Структура("ТранспортноеСредство, ИнвентарныйНомер, ВидУчета"));
	СтруктураРазделителей.ЗаголовкиКолонок.ТранспортноеСредство = "Транспортное средство";
	СтруктураРазделителей.ЗаголовкиКолонок.ИнвентарныйНомер = "Инвентарный номер";
	СтруктураРазделителей.ЗаголовкиКолонок.ВидУчета = "Вид учета";
	
	Возврат(СтруктураРазделителей);
КонецФункции	

