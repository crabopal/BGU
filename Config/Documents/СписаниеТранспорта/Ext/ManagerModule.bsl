	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА СписаниеТранспортаДрагоценныеМатериалы.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	СписаниеТранспортаДрагоценныеМатериалы.Ссылка КАК Регистратор,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	СписаниеТранспортаДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	|	СписаниеТранспортаДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	|	СписаниеТранспортаДрагоценныеМатериалы.Ссылка.НоменклатураЛома КАК ОбъектНФА,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ЛомДМ) КАК ВидОбъекта,
	|	СписаниеТранспортаДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	|	СписаниеТранспортаДрагоценныеМатериалы.МассаДМ КАК ЧистаяМасса,
	|	СписаниеТранспортаДрагоценныеМатериалы.ЛигатурнаяМассаЛома КАК ЛигатурнаяМасса,
	|	&ИмяДокумента КАК Основание,
	|	&НомерДокумента КАК НомерОснования,
	|	СписаниеТранспортаДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	|	СписаниеТранспортаДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	|	СписаниеТранспортаДрагоценныеМатериалы.ИсточникОбразования КАК ИсточникОбразования
	|ИЗ
	|	Документ.СписаниеТранспорта.ДрагоценныеМатериалы КАК СписаниеТранспортаДрагоценныеМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = СписаниеТранспортаДрагоценныеМатериалы.Ссылка)
	|ГДЕ
	|	СписаниеТранспортаДрагоценныеМатериалы.Ссылка = &Ссылка
	|	И СписаниеТранспортаДрагоценныеМатериалы.МассаДМ > 0
	|	И НЕ СписаниеТранспортаДрагоценныеМатериалы.Ссылка.НоменклатураЛома = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
КонецПроцедуры

Процедура ПроверитьНаличиеДокументаПоСписаниюЗапчастей(ДокументОснование) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АктСписанияМЗ.Ссылка КАК Ссылка,
	|	АктСписанияМЗ.Ссылка.Представление КАК Представление
	|ИЗ
	|	Документ.АктСписанияМЗ КАК АктСписанияМЗ
	|ГДЕ
	|	АктСписанияМЗ.ДокументОснование = &ДокументОснование
	|	И АктСписанияМЗ.Проведен";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Шаблон = НСтр("ru='На основании документа ""%1"" сформирован документ списания запчастей. Следует отменить проведение данного документа.'");
	
	Пока Выборка.Следующий() Цикл
		
		ТекстСообщения = СтрШаблон(Шаблон, Выборка.Представление);	
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Выборка.Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

