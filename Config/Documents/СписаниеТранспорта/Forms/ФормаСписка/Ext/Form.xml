			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументСписаниеТранспорта.Ссылка КАК Ссылка,
	ДокументСписаниеТранспорта.ВерсияДанных КАК ВерсияДанных,
	ДокументСписаниеТранспорта.ПометкаУдаления КАК ПометкаУдаления,
	ДокументСписаниеТранспорта.Номер КАК Номер,
	ДокументСписаниеТранспорта.Дата КАК Дата,
	ВЫБОР
		КОГДА ДокументСписаниеТранспорта.Проведен
			ТОГДА ВЫБОР
					КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
							ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
						ТОГДА ДокументСписаниеТранспорта.Дата
					ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
				КОНЕЦ
		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	КОНЕЦ КАК ДатаПроведения,
	ДокументСписаниеТранспорта.Проведен КАК Проведен,
	ДокументСписаниеТранспорта.Организация КАК Организация,
	ДокументСписаниеТранспорта.ИФО КАК ИФО,
	ДокументСписаниеТранспорта.Подразделение КАК Подразделение,
	ДокументСписаниеТранспорта.ЦМО КАК ЦМО,
	ДокументСписаниеТранспорта.ОсновноеСредство КАК ОсновноеСредство,
	ДокументСписаниеТранспорта.Сумма КАК Сумма,
	ДокументСписаниеТранспорта.Комментарий КАК Комментарий,
	ДокументСписаниеТранспорта.ОснованиеДляАкта КАК ОснованиеДляАкта,
	ДокументСписаниеТранспорта.НомерОснованияДляАкта КАК НомерОснованияДляАкта,
	ДокументСписаниеТранспорта.ДатаОснованияДляАкта КАК ДатаОснованияДляАкта,
	ДокументСписаниеТранспорта.КФО КАК КФО,
	ДокументСписаниеТранспорта.КПС КАК КПС,
	ДокументСписаниеТранспорта.ДолжностьПредседателяКомиссии КАК ДолжностьПредседателяКомиссии,
	ДокументСписаниеТранспорта.ФамилияПредседателяКомиссии КАК ФамилияПредседателяКомиссии,
	ДокументСписаниеТранспорта.ИмяПредседателяКомиссии КАК ИмяПредседателяКомиссии,
	ДокументСписаниеТранспорта.ОтчествоПредседателяКомиссии КАК ОтчествоПредседателяКомиссии,
	ДокументСписаниеТранспорта.СуммаАмортизации КАК СуммаАмортизации,
	ДокументСписаниеТранспорта.Приложение КАК Приложение,
	ДокументСписаниеТранспорта.ИнвентарныйНомер КАК ИнвентарныйНомер,
	ДокументСписаниеТранспорта.ПричинаСписания КАК ПричинаСписания,
	ДокументСписаниеТранспорта.ВидОперации КАК ВидОперации,
	ОперацииДокументов.Операция КАК Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
	ДокументСписаниеТранспорта.Ответственный КАК Ответственный,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	СостоянияЭД.ПредставлениеСостояния КАК СостояниеЭДО,
	NULL КАК СостояниеОригиналаПервичногоДокумента,
	ИСТИНА КАК ОбщееСостояние,
	0 КАК СостояниеОригиналПолучен
ИЗ
	Документ.СписаниеТранспорта КАК ДокументСписаниеТранспорта
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияЭД
		ПО (СостоянияЭД.СсылкаНаОбъект = ДокументСписаниеТранспорта.Ссылка)}
