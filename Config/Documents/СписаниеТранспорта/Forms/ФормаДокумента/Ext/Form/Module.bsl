Процедура ПослеВопросаОбУдаленииРНПТ(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		УдалитьСтрокиРНПТ();
		РНПТ = ТекстПредставленияРНПТНеВведены();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстПредставленияРНПТ()
	Если Объект.СведенияПрослеживаемости.Количество() = 0 Тогда
		РНПТ = ТекстПредставленияРНПТНеВведены();
	Иначе
		РНПТ = ПрослеживаемостьФормыБГУКлиентСервер.ТекстПредставлениярРНПТ(Объект.СведенияПрослеживаемости);
	КонецЕсли
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстПредставленияРНПТНеВведены()
	Возврат НСтр("ru = 'Не введены'");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДопустимыеКодыОперацийПрослеживаемости(Форма)
	
	Если НЕ Форма.ВедетсяУчетПрослеживаемыхТоваров Тогда
		Возврат;
	КонецЕсли;
	
	ВидыОперацийПрослеживаемости = ПрослеживаемостьБГУКлиентСервер.ВидыОперацийПрослеживаемости();
	ВидыОперацийПрослеживаемости.Списание = Истина;
	ВидыОперацийПрослеживаемости.Утилизация = Истина;
	ДанныеВыбора = ПрослеживаемостьБГУКлиентСервер.КодыОперацийПрослеживаемости(ВидыОперацийПрослеживаемости);
	Форма.Элементы.КодОперацииПрослеживаемости.СписокВыбора.ЗагрузитьЗначения(ДанныеВыбора);
	
КонецПроцедуры

