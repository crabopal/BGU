&НаСервере
Процедура ВосстановлениеЗаполнитьСервер()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"			, Объект.Дата);
	Запрос.УстановитьПараметр("Организация"		, Объект.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", Объект.ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвНомер"		, Объект.ИнвентарныйНомер);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчетаВосстановление,
	|	УчетныеДанныеОбъектаОССрезПоследних.КПС КАК КПСВосстановление
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.НаБалансе)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОС.ЦМО КАК ЦМОВосстановление,
	|	ВЫБОР
	|		КОГДА СУММА(СтоимостьОбъектовОС.Количество) = 0
	|			ТОГДА СУММА(СтоимостьОбъектовОС.Стоимость)
	|		ИНАЧЕ СУММА(СтоимостьОбъектовОС.Стоимость) / СУММА(СтоимостьОбъектовОС.Количество)
	|	КОНЕЦ КАК СуммаВосстановление
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС КАК СтоимостьОбъектовОС
	|ГДЕ
	|	СтоимостьОбъектовОС.Организация = &Организация
	|	И СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|	И СтоимостьОбъектовОС.Активность
	|	И СтоимостьОбъектовОС.Период < &Период
	|	И СтоимостьОбъектовОС.ОсновноеСредство = &ОсновноеСредство
	|	И СтоимостьОбъектовОС.ИнвентарныйНомер = &ИнвНомер
	|
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОбъектовОС.ЦМО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(АмортизацияОбъектовОС.СуммаАмортизации) КАК СуммаАмортизации,
	|	СУММА(АмортизацияОбъектовОС.СуммаОбесценения) КАК СуммаОбесценения
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС КАК АмортизацияОбъектовОС
	|ГДЕ
	|	АмортизацияОбъектовОС.Организация = &Организация
	|	И АмортизацияОбъектовОС.ЭтоСписание
	|	И АмортизацияОбъектовОС.Активность
	|	И АмортизацияОбъектовОС.Период < &Период
	|	И АмортизацияОбъектовОС.ОсновноеСредство = &ОсновноеСредство
	|	И АмортизацияОбъектовОС.ИнвентарныйНомер = &ИнвНомер";
	
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого Данные Из Результат Цикл
		Выборка = Данные.Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(Объект, Выборка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

