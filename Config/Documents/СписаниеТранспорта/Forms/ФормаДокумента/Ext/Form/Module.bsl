// Прослеживаемые ОС

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_Прослеживаемость(Форма)
	
	Элементы = Форма.Элементы;
	
	ВидимостьОсновныхЭлементов = Форма.ВедетсяУчетПрослеживаемыхТоваров И Форма.ЕстьПрослеживаемыеТовары;
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("РНПТ");
	ИменаЭлементов.Добавить("УдалитьРНПТ");
	ИменаЭлементов.Добавить("КодОперацииПрослеживаемости");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Видимость", ВидимостьОсновныхЭлементов);
	
КонецПроцедуры

