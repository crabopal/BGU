&НаКлиенте
Процедура РНПТНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Организация",     Объект.Организация);
	СтруктураПараметров.Вставить("Номенклатура",    Объект.ОсновноеСредство);
	СтруктураПараметров.Вставить("Период",          Объект.Дата);
	СтруктураПараметров.Вставить("ВнеоборотныйАктив", Объект.ОсновноеСредство);
	СтруктураПараметров.Вставить("ВыборПоОстаткам", Истина);
	СтруктураПараметров.Вставить("Количество",          1);
	СтруктураПараметров.Вставить("СтранаПроисхождения", Объект.СтранаПроисхождения);
	СтруктураПараметров.Вставить("ЭтоВозвратПоставщику", ложь);
	СтруктураПараметров.Вставить("ДатаТекущегоДокумента", '00010101');
	СтруктураПараметров.Вставить("ДокументРеализации", Неопределено);
	СтруктураПараметров.Вставить("ЭтоВозвратПоставщику", Ложь);
	СтруктураПараметров.Вставить("ТекущийДокумент",               Объект.Ссылка);
	
	АдресТаблицыРНПТВХранилище = ПоместитьРНПТВХранилищеНаСервере();
	
	СтруктураПараметров.Вставить("АдресТаблицыРНПТВХранилище", АдресТаблицыРНПТВХранилище);
	СтруктураПараметров.Вставить("ЭтоПоступление", Ложь);
	
	ОткрытьФорму("Справочник.НомераГТД.Форма.ФормаПодбораРНПТДляОС", СтруктураПараметров, ЭтотОбъект);
КонецПроцедуры

