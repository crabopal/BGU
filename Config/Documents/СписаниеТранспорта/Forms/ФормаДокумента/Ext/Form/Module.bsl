Процедура ПодготовитьФормуНаСервере()
	
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	ЕстьПрослеживаемыеТовары = ПрослеживаемостьБГУ.ПрослеживаемоеОсновноеСредство(Объект.ОсновноеСредство, Объект);
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	УстановитьТекстПредставленияРНПТ();
	УстановитьДопустимыеКодыОперацийПрослеживаемости(ЭтотОбъект);
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	РезервированиеНФАКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект, Объект);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбязательностьЭлементовФормы()
	
	СписаниеБаланс		= (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеСобственныхОС"));
	СписаниеКапВложений	= (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений"));
	СписаниеОперУчет	= (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет"));
	СписаниеЗабаланс	= (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеОСнаХранении")
							Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеОСПолученныхВПользование"));
	
	Элементы.ИнвентарныйНомер.Видимость	= Не СписаниеКапВложений;
	Элементы.Контрагент.Видимость		= СписаниеЗабаланс;
	Элементы.Договор.Видимость			= СписаниеЗабаланс;
	Элементы.КПС.Видимость				= СписаниеБаланс Или СписаниеКапВложений;
	
	Элементы.СуммаАмортизации.Видимость					= СписаниеБаланс;
	Элементы.СуммаАмортизацииЗаТекущийМесяц.Видимость	= СписаниеБаланс;
	Элементы.СуммаОбесценения.Видимость					= СписаниеБаланс;
	
	Элементы.ГруппаПолучатель.Видимость = СписаниеБаланс Или СписаниеОперУчет;
	
	ВидимостьРеквизитовВосстановления = СписаниеОперУчет
		Или Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеОСнаХранении");
	Элементы.ВосстановитьНаБалансе.Видимость = ВидимостьРеквизитовВосстановления;
	Элементы.ГруппаВосстановление.Видимость = ВидимостьРеквизитовВосстановления И Объект.ВосстановитьНаБалансе;
	
КонецПроцедуры

