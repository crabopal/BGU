#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоОперацияКапвложения(ТекОперация)
	МассивОперацийКапвложений = Новый Массив;
	МассивОперацийКапвложений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений"));
	Возврат (МассивОперацийКапвложений.Найти(ТекОперация) <> Неопределено);
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы_КарточкаКапвложений(Форма)
	ВидимостьГруппы = ЭтоОперацияКапвложения(Форма.Объект.ВидОперации); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаКартокаКВ",
		"Видимость", ВидимостьГруппы);

	Если ВидимостьГруппы Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "КарточкаКапвложений",
			"Видимость", Форма.Объект.ОтразитьВКарточкеКапвложений);
	КонецЕсли;		
КонецПроцедуры	

&НаКлиенте
Процедура РешениеПриИзменении_Завершение(Результат, Параметры) Экспорт
	СсылкаЦелевогоДокумента = Неопределено;
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("СсылкаЦелевогоДокумента") Тогда
		СсылкаЦелевогоДокумента = Параметры.СсылкаЦелевогоДокумента;
	КонецЕсли;	
	ВвестиНаОснованииРешения(Объект.Решение, Результат, СсылкаЦелевогоДокумента);
	ПриИзмененииВидаОперации();
КонецПроцедуры	

&НаСервере
Процедура ВвестиНаОснованииРешения(ДокументОснования, Разделитель, СсылкаЦелевогоДокумента)
	ТекОбъект = РеквизитФормыВЗначение("Объект", Тип("ДокументОбъект.СписаниеТранспорта"));
	ДанныеЗаполнения = Новый Структура("ДокументОснование, Разделитель, ВводНаОсновании, СсылкаЦелевогоДокумента", 
		ДокументОснования, Разделитель, Истина, СсылкаЦелевогоДокумента);

	ТекОбъект.Заполнить(ДанныеЗаполнения);
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
КонецПроцедуры	

&НаКлиенте
Процедура ПриИзмененииВидаОперации()
	УстановитьОбязательностьЭлементовФормы();
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
	ЭтоКапвложение = ЭтоОперацияКапвложения(Объект.ВидОперации);
	Если НЕ ЭтоКапвложение И Объект.ОтразитьВКарточкеКапвложений Тогда
		Объект.ОтразитьВКарточкеКапвложений = Ложь;
	ИначеЕсли ЭтоКапвложение И НЕ Объект.ОтразитьВКарточкеКапвложений Тогда
		Объект.ОтразитьВКарточкеКапвложений = Истина;
	КонецЕсли;	
	УстановитьВидимостьЭлементовФормы_КарточкаКапвложений(ЭтотОбъект);
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЕстьРешениеОПрекращенииПризнанияАктивом(Форма)
	Объект = Форма.Объект;
	ЕстьРешение = ЗначениеЗаполнено(Объект.Решение) 
		И ТипЗнч(Объект.Решение) = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивом");
	Если Объект.ЕстьРешениеОПрекращенииПризнанияАктивом <> ЕстьРешение Тогда
		 Объект.ЕстьРешениеОПрекращенииПризнанияАктивом = ЕстьРешение;
	КонецЕсли;		
КонецПроцедуры	

