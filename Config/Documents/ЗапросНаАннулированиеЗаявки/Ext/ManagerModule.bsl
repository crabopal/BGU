#Область ПрограммныйИнтерфейс

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗапросНаАннулированиеЗаявки";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0531807";
	КомандаПечати.Представление		= НСтр("ru = 'Запрос на аннулирование заявки'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0531807") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_Форма0531807",
			"Запрос на аннулирование заявки",
			ПечатьЗапросаНаАннулирование(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;

КонецПроцедуры

Функция УстановитьДатуРегистрацииИПримечание(Ссылка, Дата, ВводНаОсновании = Ложь) Экспорт
	
	Структура = Новый Структура("ДатаРегистрации,Примечание,ДатаПроведения, Оплачена, Статус","","",Дата("00010101"),Ложь,"");
	
	Структура.Примечание   	 	= СформирватьПримечание(Ссылка);
	РеквизитыРегистрации	 	= ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Ссылка);
	Структура.ДатаПроведения 	= РеквизитыРегистрации.ДатаПроведения;
	Структура.Статус			= РеквизитыРегистрации.Статус;
	
	Если (РеквизитыРегистрации.Количество() > 0) и (РеквизитыРегистрации.ДатаПроведения = Дата("00010101")) тогда
		
		СвойстваЛицевогоСчета	= ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(Ссылка.ЛицевойСчет, Дата); 	
		
		Структура.Вставить("ПерваяПодпись",		 			 СвойстваЛицевогоСчета.ПерваяПодпись);
		Структура.Вставить("ВтораяПодпись", 				 СвойстваЛицевогоСчета.ВтораяПодпись);
		Структура.Вставить("ВтораяПодписьПечататьДолжность", СвойстваЛицевогоСчета.ВтораяПодписьПечататьДолжность);
		Структура.Вставить("ПерваяПодписьПечататьДолжность", СвойстваЛицевогоСчета.ПерваяПодписьПечататьДолжность);
		Структура.Вставить("ПерваяПодписьДолжность",         СвойстваЛицевогоСчета.ПерваяПодписьДолжность);
		Структура.Вставить("ВтораяПодписьДолжность",		 СвойстваЛицевогоСчета.ВтораяПодписьДолжность);
		
		Структура.ДатаПроведения  = РеквизитыРегистрации.ДатаПроведения;
		Структура.ДатаРегистрации = РеквизитыРегистрации.ДатаРегистрации;
		Возврат Структура;
		
	ИначеЕсли РеквизитыРегистрации.Количество() > 0 тогда
		
		Структура.Оплачена = Истина;
		ТекстОшибки = НСтр("ru = 'Заявка уже оплачена'");
		
	Иначе
		
		ТекстОшибки = НСтр("ru = 'Заявка еще не зарегестрирована'");
		
	КонецЕсли;
	
	Если Не ВводНаОсновании тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
	КонецЕсли;	
	
	Возврат Структура;
	
КонецФункции

Функция СформирватьПримечание(Знач Основание) экспорт
	
	// Заполнение поля "Примечание" выдержка из форматов обмена Альбом 8.0
	//По строке "Примечание" в скобках указывается наименование аннулируемого документа (
	//Заявка на кассовый расход, 
	//Сокращенная заявка на кассовый расход, 
	//Сводная заявка, 
	//Заявка на возврат, 
	//Заявка на получение наличных денег, 
	//Заявка на получение наличных денег (код формы по КФД 0531844), 
	//Консолидированная заявка), 
	//далее указывается причина аннулирования ранее представленной заявки.
	
	// форматы альбома 32.0
	//	В скобках указывается тип аннулируемого документа. 
	//Возможные значения (без учета регистра и пробелов): 
	//- Заявка на получение денежных средств, перечисляемых на карту;
	//- ЗКР;
	//- ЗКР (сокращенная);
	//- Сводная заявка на кассовый расход (для уплаты налогов);
	//- Заявка на возврат;
	//- ЗНД;
	//- Консолидированная заявка;
	//- Платежное поручение;
	//- Расшифровка сумм неиспользованных (внесенных через банкомат или пункт выдачи наличных денежных средств) средств;
	//- Распоряжение о перечислении;
	//- Уведомление клиента;
	//- Уведомление о зачете;
	//- Уведомление об уточнении;
	//- Уведомление о региональном зачете.
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход") Тогда
		мПримечание = "(ЗКР)";
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная") Тогда
		мПримечание = "(ЗКР (сокращенная))";
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаНаличные") Тогда
		мПримечание = "(ЗНД)";
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаНаличныеБанковскаяКарта") Тогда
		мПримечание = "(Заявка на получение денежных средств, перечисляемых на карту)";
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.СводнаяЗаявкаНаКассовыйРасход") Тогда
		мПримечание = "(Сводная заявка на кассовый расход (для уплаты налогов))";
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаВозврат") Тогда
		мПримечание = "(Заявка на возврат)";
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ПлатежноеПоручение") Тогда
		мПримечание = "(Платежное поручение)";
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.РаспоряжениеОПеречисленииНаКартыМир") Тогда
		мПримечание = "(Распоряжение о перечислении)";
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.РасшифровкаВнесенныхЧерезБанкоматСредств") Тогда
		мПримечание = "(Расшифровка сумм неиспользованных (внесенных через банкомат или пункт выдачи наличных денежных средств) средств)";
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.УведомлениеОбУточненииВидаИПринадлежностиПлатежа") Тогда
		мПримечание = "(Уведомление об уточнении)";
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.УведомлениеОбУточненииОперацийКлиента") Тогда
		мПримечание = "(Уведомление клиента)";
	Иначе
		мПримечание = "";
	КонецЕсли;
	
	Возврат мПримечание;
	
КонецФункции

Функция ЗаполнитьНаОсновании(Знач Основание, Объект, ОписаниеОшибки = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен документ основания.'");
		Возврат Ложь;
	КонецЕсли;	
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаВозврат") Или
		 ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход") Или 
		 ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная") Или
		 ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаНаличные")	Или
		 ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаНаличныеБанковскаяКарта") Или
		 ТипЗнч(Основание) = Тип("ДокументСсылка.СводнаяЗаявкаНаКассовыйРасход") Или
		 ТипЗнч(Основание) = Тип("ДокументСсылка.ПлатежноеПоручение") Или 	
		 ТипЗнч(Основание) = Тип("ДокументСсылка.РаспоряжениеОПеречисленииНаКартыМир") Или
		 ТипЗнч(Основание) = Тип("ДокументСсылка.РасшифровкаВнесенныхЧерезБанкоматСредств") Или
		 ТипЗнч(Основание) = Тип("ДокументСсылка.УведомлениеОбУточненииВидаИПринадлежностиПлатежа") Или
		 ТипЗнч(Основание) = Тип("ДокументСсылка.УведомлениеОбУточненииОперацийКлиента")
		 Тогда
		Объект.ДокументОснование = Основание.Ссылка;
		Объект.организация 		 = Основание.Организация;
	Иначе
		ОписаниеОшибки = НСтр("ru='Выбранный документ не может служить основанием.'");
		Возврат Ложь;
	КонецЕсли;	
	
	Объект.Примечание = СформирватьПримечание(Основание);
	
	Структура = УстановитьДатуРегистрацииИПримечание(Основание, Основание.Дата, Истина);
	
	Объект.Примечание = Структура.Примечание;
	
	Если Структура.Свойство("ПерваяПодпись") тогда
		Объект.ПерваяПодпись				 	= Структура.ПерваяПодпись;
		Объект.ВтораяПодпись 					= Структура.ВтораяПодпись;
		Объект.ВтораяПодписьПечататьДолжность 	= Структура.ВтораяПодписьПечататьДолжность;
		Объект.ПерваяПодписьПечататьДолжность 	= Структура.ПерваяПодписьПечататьДолжность;
		Объект.ПерваяПодписьДолжность         	= Структура.ПерваяПодписьДолжность;
		Объект.ВтораяПодписьДолжность		  	= Структура.ВтораяПодписьДолжность;
	КонецЕсли;	
	
	
	Если Структура.Статус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении тогда
		Объект.ДатаРегистрацииОснования = Структура.ДатаРегистрации;
	ИначеЕсли Структура.Статус = Перечисления.СтатусыИсполненияДокумента.Исполнен тогда
		ОписаниеОшибки = НСтр("ru = 'Заявка уже оплачена'");
		Возврат Ложь;
	Иначе
		ОписаниеОшибки = НСтр("ru = 'Заявка еще не зарегестрирована'");
		Возврат Ложь;
	КонецЕсли;	
	
	Возврат Истина;
	
КонецФункции

