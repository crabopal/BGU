#Область ПрограммныйИнтерфейс
	
// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти
	
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если ЗначениеЗаполнено(ДокументОснование) тогда
		РеквизитыРегистрацииОФК = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ДокументОснование.Ссылка);
		РеквизитыРегистрацииОФК.Вставить("ПлатежноРасчетныйДокумент",ДокументОснование.Ссылка);
		РеквизитыРегистрацииОФК.Статус = Перечисления.СтатусыИсполненияДокумента.Аннулирован;
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(РеквизитыРегистрацииОФК);
    КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	Если ЗначениеЗаполнено(ДокументОснование) тогда
		РеквизитыРегистрацииОФК = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ДокументОснование.Ссылка);
		РеквизитыРегистрацииОФК.Вставить("ПлатежноРасчетныйДокумент",ДокументОснование.Ссылка);
		РеквизитыРегистрацииОФК.Статус = Перечисления.СтатусыИсполненияДокумента.ВРаботе;
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(РеквизитыРегистрацииОФК);
    КонецЕсли;
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Если ДанныеЗаполнения <> Неопределено и ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") тогда
		ТекстСообщения = "";
		Если не Документы.ЗапросНаАннулированиеЗаявки.ЗаполнитьНаОсновании(ДанныеЗаполнения, ЭтотОбъект, ТекстСообщения) тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			ВызватьИсключение "На основании выбранного документа нельзя ввести ""Запрос на аннулирование заявки"""; 
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#КонецЕсли