#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ВыполнитьПроведение(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ) Экспорт
	
	ТаблицаПроводок = Неопределено;
	
	Если НЕ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЗакрытиеГодаТехнологическое") Тогда
		Возврат РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	КонецЕсли;	
	
	Движения = ДокументОбъект.Движения.ЖурналПроводокЕПСБУ;
	Движения.Очистить();
	Движения.Записать(Истина);
	
	Если ДокументОбъект.ДополнительныеСвойства.Свойство("ТаблицаПроводок",ТаблицаПроводок) Тогда
		Возврат ТаблицаПроводок;
	КонецЕсли;
	
	Счет000 = ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.Вспомогательный");
	КЭК000 = БухгалтерскийУчетПовтИсп.КЭК0();

	
	УточнениеПериода = БухгалтерскийУчет.ЗначениеУточненияПериода(ДокументОбъект.ВидМежотчетногоПериода);
	Если ЗначениеЗаполнено(УточнениеПериода) Тогда
		ПериодЗапроса = Новый Граница(Новый МоментВремениСУточнениемПериода(
			КонецДня(ДокументОбъект.ФинансовыйГод), УточнениеПериода), ВидГраницы.Исключая);
	Иначе
		ПериодЗапроса = Новый Граница(КонецДня(ДокументОбъект.ФинансовыйГод), ВидГраницы.Включая);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВсеСчета", 		ПланыСчетов.ЕПСБУ.СчетаСОборотнымКЭК());
	Запрос.УстановитьПараметр("Период", 		ПериодЗапроса);
	Запрос.УстановитьПараметр("Организация",	ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("КЭК000",			КЭК000);
	Запрос.УстановитьПараметр("Счет000",		ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.Вспомогательный"));
	Запрос.УстановитьПараметр("Счет00",			ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ВспомогательныйЗабалансовый"));
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	ЕПСБУ.КОСГУДт,
	|	ЕПСБУ.КОСГУКт,
	|	ЕПСБУ.Вид,
	|	ЕПСБУВидыСубконто1.ВидСубконто КАК ВидСубконто1,
	|	ЕПСБУВидыСубконто2.ВидСубконто КАК ВидСубконто2,
	|	ЕПСБУВидыСубконто3.ВидСубконто КАК ВидСубконто3,
	|	ВЫБОР
	|		КОГДА ЕПСБУ.Забалансовый
	|			ТОГДА &Счет00
	|		ИНАЧЕ &Счет000
	|	КОНЕЦ КАК КорСчет
	|ПОМЕСТИТЬ ВсеСчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто1
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто1.Ссылка
	|			И (ЕПСБУВидыСубконто1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто2
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто2.Ссылка
	|			И (ЕПСБУВидыСубконто2.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто3
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто3.Ссылка
	|			И (ЕПСБУВидыСубконто3.НомерСтроки = 3)
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&ВсеСчета)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто1, НЕОПРЕДЕЛЕНО) КАК Субконто1,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто2, НЕОПРЕДЕЛЕНО) КАК Субконто2,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто3, НЕОПРЕДЕЛЕНО) КАК Субконто3,
	|	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК Валюта,
	|	ЖурналПроводокЕПСБУОстатки.ЖурналОпераций КАК ЖурналОпераций,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокКт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокКт,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт <> 0
	|				ИЛИ ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт, 0) <> 0
	|				ИЛИ ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт, 0) <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ДтКт
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ВсеСчета.Ссылка
	|				ИЗ
	|					ВсеСчета),
	|			,
	|			Организация = &Организация
	|				И НЕ КЭК = &КЭК000) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Счет КАК Счет,
	|	Остатки.КФО,
	|	Остатки.КПС,
	|	Остатки.Субконто1,
	|	Остатки.Субконто2,
	|	Остатки.Субконто3,
	|	Остатки.КЭК КАК КЭК,
	|	Остатки.Валюта,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.СуммаОстатокДт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.СуммаОстатокКт < 0
	|				ТОГДА -Остатки.СуммаОстатокКт
	|			ИНАЧЕ Остатки.СуммаОстатокДт
	|		КОНЕЦ) КАК СуммаОстатокДт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.СуммаОстатокКт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.СуммаОстатокДт < 0
	|				ТОГДА -Остатки.СуммаОстатокДт
	|			ИНАЧЕ Остатки.СуммаОстатокКт
	|		КОНЕЦ) КАК СуммаОстатокКт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.ВалютнаяСуммаОстатокДт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.ВалютнаяСуммаОстатокКт < 0
	|				ТОГДА -Остатки.ВалютнаяСуммаОстатокКт
	|			ИНАЧЕ Остатки.ВалютнаяСуммаОстатокДт
	|		КОНЕЦ) КАК ВалютнаяСуммаОстатокДт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.ВалютнаяСуммаОстатокКт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.ВалютнаяСуммаОстатокДт < 0
	|				ТОГДА -Остатки.ВалютнаяСуммаОстатокДт
	|			ИНАЧЕ Остатки.ВалютнаяСуммаОстатокКт
	|		КОНЕЦ) КАК ВалютнаяСуммаОстатокКт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.КоличествоОстатокДт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.КоличествоОстатокКт < 0
	|				ТОГДА -Остатки.КоличествоОстатокКт
	|			ИНАЧЕ Остатки.КоличествоОстатокДт
	|		КОНЕЦ) КАК КоличествоОстатокДт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.КоличествоОстатокКт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.КоличествоОстатокДт < 0
	|				ТОГДА -Остатки.КоличествоОстатокДт
	|			ИНАЧЕ Остатки.КоличествоОстатокКт
	|		КОНЕЦ) КАК КоличествоОстатокКт,
	|	ВЫБОР
	|		КОГДА ВЫБОР
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|							И Остатки.СуммаОстатокДт < 0
	|						ТОГДА 0
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|							И Остатки.СуммаОстатокКт < 0
	|						ТОГДА -Остатки.СуммаОстатокКт
	|					ИНАЧЕ Остатки.СуммаОстатокДт
	|				КОНЕЦ <> 0
	|				ИЛИ ВЫБОР
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|							И Остатки.ВалютнаяСуммаОстатокДт < 0
	|						ТОГДА 0
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|							И Остатки.ВалютнаяСуммаОстатокКт < 0
	|						ТОГДА -Остатки.ВалютнаяСуммаОстатокКт
	|					ИНАЧЕ Остатки.ВалютнаяСуммаОстатокДт
	|				КОНЕЦ <> 0
	|				ИЛИ ВЫБОР
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|							И Остатки.КоличествоОстатокДт < 0
	|						ТОГДА 0
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|							И Остатки.КоличествоОстатокКт < 0
	|						ТОГДА -Остатки.КоличествоОстатокКт
	|					ИНАЧЕ Остатки.КоличествоОстатокДт
	|				КОНЕЦ <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ДтКт,
	|	Остатки.ИФО,
	|	Остатки.ЖурналОпераций,
	|	Остатки.Подразделение
	|ИЗ
	|	Остатки КАК Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВсеСчета КАК ВсеСчета
	|		ПО Остатки.Счет = ВсеСчета.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Счет,
	|	Остатки.КФО,
	|	Остатки.КПС,
	|	Остатки.Субконто1,
	|	Остатки.Субконто2,
	|	Остатки.Субконто3,
	|	Остатки.КЭК,
	|	Остатки.Валюта,
	|	Остатки.ИФО,
	|	Остатки.ЖурналОпераций,
	|	Остатки.Подразделение,
	|	ВЫБОР
	|		КОГДА ВЫБОР
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|							И Остатки.СуммаОстатокДт < 0
	|						ТОГДА 0
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|							И Остатки.СуммаОстатокКт < 0
	|						ТОГДА -Остатки.СуммаОстатокКт
	|					ИНАЧЕ Остатки.СуммаОстатокДт
	|				КОНЕЦ <> 0
	|				ИЛИ ВЫБОР
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|							И Остатки.ВалютнаяСуммаОстатокДт < 0
	|						ТОГДА 0
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|							И Остатки.ВалютнаяСуммаОстатокКт < 0
	|						ТОГДА -Остатки.ВалютнаяСуммаОстатокКт
	|					ИНАЧЕ Остатки.ВалютнаяСуммаОстатокДт
	|				КОНЕЦ <> 0
	|				ИЛИ ВЫБОР
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|							И Остатки.КоличествоОстатокДт < 0
	|						ТОГДА 0
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|							И Остатки.КоличествоОстатокКт < 0
	|						ТОГДА -Остатки.КоличествоОстатокКт
	|					ИНАЧЕ Остатки.КоличествоОстатокДт
	|				КОНЕЦ <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Счет,
	|	КЭК";
	
				   
	Выборка = Запрос.Выполнить().Выбрать();				   
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	ДатаПроводки = КонецДня(ДокументОбъект.ФинансовыйГод);
	
	Пока Выборка.Следующий() Цикл
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Выборка.Счет);
		
		Если Выборка.СуммаОстатокДт <> 0
			ИЛИ Выборка.ВалютнаяСуммаОстатокДт <> 0
			ИЛИ Выборка.КоличествоОстатокДт <> 0 Тогда
			
			НовПроводка = ТаблицаПроводок.Добавить();
			
			НовПроводка.Активность             = Истина;
			НовПроводка.Период                 = ДатаПроводки;
			НовПроводка.УточнениеПериода       = УточнениеПериода;
			НовПроводка.ВидМежотчетногоПериода = ДокументОбъект.ВидМежотчетногоПериода;
			НовПроводка.Организация            = ДокументОбъект.Организация;
			НовПроводка.Сумма                  = Выборка.СуммаОстатокДт;

			
			НовПроводка.Содержание 				= НСтр("ru = 'Закрытие остатков по оборотным КЭК'");
			НовПроводка.ВидПервичногоДокумента 	= "Закрытие оборотных КЭК";
			НовПроводка.ДатаПервичногоДокумента = ДокументОбъект.Дата;
			НовПроводка.ВидПервичногоДокумента 	= ДокументОбъект.Номер;
			                                                                                               
			НовПроводка.КФО = Выборка.КФО;
			НовПроводка.ИФО = Выборка.ИФО;
			НовПроводка.ЖурналОпераций = Выборка.ЖурналОпераций; 
			
			НовПроводка.СчетКт			= Выборка.Счет;
			НовПроводка.КПСКт			= Выборка.КПС;
			НовПроводка.КЭККт			= Выборка.КЭК;
			НовПроводка.ПодразделениеКт = Выборка.Подразделение;
			
			Если ЗначениеЗаполнено(СвойстваСчета.ВидСубконто1) Тогда
				НовПроводка["СубконтоКт1"] 		= Выборка.Субконто1;
				НовПроводка["ВидСубконтоКт1"]	= СвойстваСчета.ВидСубконто1;
			КонецЕсли;
			Если ЗначениеЗаполнено(СвойстваСчета.ВидСубконто2) Тогда
				НовПроводка["СубконтоКт2"] 		= Выборка.Субконто2;
				НовПроводка["ВидСубконтоКт2"]	= СвойстваСчета.ВидСубконто2;
			КонецЕсли;
			Если ЗначениеЗаполнено(СвойстваСчета.ВидСубконто3) Тогда
				НовПроводка["СубконтоКт3"] 		= Выборка.Субконто3;
				НовПроводка["ВидСубконтоКт3"]	= СвойстваСчета.ВидСубконто3;
			КонецЕсли;
			
			НовПроводка.СчетДт = Счет000;
				   
			Если Выборка.КоличествоОстатокДт <> 0 Тогда
				НовПроводка["КоличествоКт"] 	= Выборка.КоличествоОстатокДт;
			КонецЕсли;
			Если Выборка.ВалютнаяСуммаОстатокДт <> 0 Тогда
				НовПроводка["ВалютнаяСуммаКт"] 	= Выборка.ВалютнаяСуммаОстатокДт;
				НовПроводка["ВалютаКт"] 		= Выборка.Валюта;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Выборка.СуммаОстатокКт <> 0
			ИЛИ Выборка.ВалютнаяСуммаОстатокКт <> 0
			ИЛИ Выборка.КоличествоОстатокКт <> 0 Тогда
			
			НовПроводка = ТаблицаПроводок.Добавить();
			НовПроводка.Активность             = Истина;
			НовПроводка.Период                 = ДатаПроводки;
			НовПроводка.УточнениеПериода       = УточнениеПериода;
			НовПроводка.ВидМежотчетногоПериода = ДокументОбъект.ВидМежотчетногоПериода;
			НовПроводка.Организация            = ДокументОбъект.Организация;
			НовПроводка.Сумма                  = Выборка.СуммаОстатокКт;
			
			НовПроводка.Содержание 				= НСтр("ru = 'Закрытие остатков по оборотным КЭК'");
			НовПроводка.ВидПервичногоДокумента 	= "Закрытие оборотных КЭК";
			НовПроводка.ДатаПервичногоДокумента = ДокументОбъект.Дата;
			НовПроводка.ВидПервичногоДокумента 	= ДокументОбъект.Номер;
			
			НовПроводка.КФО 			= Выборка.КФО;
			НовПроводка.ИФО 			= Выборка.ИФО;
			НовПроводка.ЖурналОпераций 	= Выборка.ЖурналОпераций; 

			НовПроводка.СчетДт			= Выборка.Счет;
			НовПроводка.КПСДт			= Выборка.КПС;
			НовПроводка.КЭКДт			= Выборка.КЭК;
			НовПроводка.ПодразделениеДт = Выборка.Подразделение;
						
			Если ЗначениеЗаполнено(СвойстваСчета.ВидСубконто1)  Тогда
				НовПроводка["СубконтоДт1"] 		= Выборка.Субконто1;
				НовПроводка["ВидСубконтоДт1"]	= СвойстваСчета.ВидСубконто1;
			КонецЕсли;
			Если ЗначениеЗаполнено(СвойстваСчета.ВидСубконто2)  Тогда
				НовПроводка["СубконтоДт2"] 		= Выборка.Субконто2;
				НовПроводка["ВидСубконтоДт2"]	= СвойстваСчета.ВидСубконто2;
			КонецЕсли;
			Если ЗначениеЗаполнено(СвойстваСчета.ВидСубконто3)  Тогда
				НовПроводка["СубконтоДт3"] 		= Выборка.Субконто3;
				НовПроводка["ВидСубконтоДт3"]	= СвойстваСчета.ВидСубконто3;
			КонецЕсли;
			
			НовПроводка.СчетКт = Счет000;
				   
			Если Выборка.КоличествоОстатокКт <> 0 Тогда
				НовПроводка["КоличествоДт"] 	= Выборка.КоличествоОстатокКт;
			КонецЕсли;
			Если Выборка.ВалютнаяСуммаОстатокКт <> 0 Тогда
				НовПроводка["ВалютнаяСуммаДт"] 	= Выборка.ВалютнаяСуммаОстатокКт;
				НовПроводка["ВалютаДт"] 		= Выборка.Валюта;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Выборка.СуммаОстатокДт > Выборка.СуммаОстатокКт
			ИЛИ Выборка.ВалютнаяСуммаОстатокДт > Выборка.ВалютнаяСуммаОстатокКт
			ИЛИ Выборка.КоличествоОстатокДт > Выборка.КоличествоОстатокКт Тогда
			
			СуммаПроводки 		= Выборка.СуммаОстатокДт - Выборка.СуммаОстатокКт;
			СуммаПроводкиВал 	= Выборка.ВалютнаяСуммаОстатокДт - Выборка.ВалютнаяСуммаОстатокКт;
			КоличествоПроводки 	= Выборка.КоличествоОстатокДт - Выборка.КоличествоОстатокКт;
			
			СторонаПроводки 	= "Дт";
			СторонаПроводки0 	= "Кт";
			
		Иначе
			
			СуммаПроводки 		= Выборка.СуммаОстатокКт - Выборка.СуммаОстатокДт;
			СуммаПроводкиВал 	= Выборка.ВалютнаяСуммаОстатокКт - Выборка.ВалютнаяСуммаОстатокДт;
			КоличествоПроводки 	= Выборка.КоличествоОстатокКт - Выборка.КоличествоОстатокДт;
			
			СторонаПроводки 	= "Кт";
			СторонаПроводки0 	= "Дт";
			
		КонецЕсли;
		
		Если СуммаПроводки<>0
			ИЛИ СуммаПроводкиВал<>0
			ИЛИ КоличествоПроводки<>0 Тогда
			
			НовПроводка                        = ТаблицаПроводок.Добавить();
			НовПроводка.Активность             = Истина;
			НовПроводка.Период                 = ДатаПроводки;
			НовПроводка.УточнениеПериода       = УточнениеПериода;
			НовПроводка.ВидМежотчетногоПериода = ДокументОбъект.ВидМежотчетногоПериода;
			НовПроводка.Организация            = ДокументОбъект.Организация;
			
			НовПроводка.Содержание 				= НСтр("ru = 'Закрытие остатков по оборотным КЭК'");
			НовПроводка.ВидПервичногоДокумента 	= "Закрытие оборотных КЭК";
			НовПроводка.ДатаПервичногоДокумента = ДокументОбъект.Дата;
			НовПроводка.ВидПервичногоДокумента 	= ДокументОбъект.Номер;
			
			НовПроводка.КФО = Выборка.КФО;
			НовПроводка.ИФО = Выборка.ИФО;
			
			НовПроводка["Счет" 			+ СторонаПроводки]	= Выборка.Счет;
			НовПроводка["КПС" 			+ СторонаПроводки]	= Выборка.КПС;
			НовПроводка["КЭК" 			+ СторонаПроводки]	= КЭК000;
			НовПроводка["Подразделение" + СторонаПроводки]	= Выборка.Подразделение;
			
			//журнал тут не нужен 
			//НовПроводка.ЖурналОпераций = Выборка.ЖурналОпераций;
			
			Если ЗначениеЗаполнено(СвойстваСчета.ВидСубконто1)  Тогда
				НовПроводка["Субконто"+СторонаПроводки+"1"] 	= Выборка.Субконто1;
				НовПроводка["ВидСубконто"+СторонаПроводки+"1"]	= СвойстваСчета.ВидСубконто1;
			КонецЕсли;
			Если ЗначениеЗаполнено(СвойстваСчета.ВидСубконто2)  Тогда
				НовПроводка["Субконто"+СторонаПроводки+"2"] 	= Выборка.Субконто2;
				НовПроводка["ВидСубконто"+СторонаПроводки+"2"]	= СвойстваСчета.ВидСубконто2;
			КонецЕсли;
			Если ЗначениеЗаполнено(СвойстваСчета.ВидСубконто3)  Тогда
				НовПроводка["Субконто"+СторонаПроводки+"3"] 	= Выборка.Субконто3;
				НовПроводка["ВидСубконто"+СторонаПроводки+"3"]	= СвойстваСчета.ВидСубконто3;
			КонецЕсли;
			
			НовПроводка["Счет" + СторонаПроводки0] = Счет000;
				   
			НовПроводка.Сумма = СуммаПроводки;
			Если КоличествоПроводки <> 0 Тогда
				НовПроводка["Количество"+СторонаПроводки] = КоличествоПроводки;
			КонецЕсли;
			Если СуммаПроводкиВал <> 0 Тогда
				НовПроводка["ВалютнаяСумма"+СторонаПроводки] 	= СуммаПроводкиВал;
				НовПроводка["Валюта"+СторонаПроводки] 			= Выборка.Валюта;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаПроводок;
		
КонецФункции

