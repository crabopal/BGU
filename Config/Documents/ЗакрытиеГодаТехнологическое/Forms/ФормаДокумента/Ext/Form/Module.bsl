#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура БухгалтерскиеПроводки(Команда)
	
	Если НЕ Объект.Проведен Тогда
		Возврат;
	КонецЕсли;
	
	СписокДокументов.Очистить();
	Стр =  СписокДокументов.Добавить();
	Стр.ДокСсылка = Объект.Ссылка;
	
	СписокПараметров = Новый Структура;
	СписокПараметров.Вставить("Регистраторы", СписокДокументов);
	СписокПараметров.Вставить("Документ", Объект.Ссылка);
	
	ОткрытьФорму("Документ.ЗакрытиеГодаТехнологическоеГрупповое.Форма.ФормаБухгалтерскойОперации", СписокПараметров, ЭтотОбъект);
	
КонецПроцедуры

