// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка.Организация КАК Организация,
	                      |	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка.КассовыйОрган КАК КассовыйОрган,
	                      |	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка.ВидОбмена КАК ТипФормата,
	                      |	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Объект КАК Объект,
	                      |	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.ИмяФайлаВыгрузки КАК ИмяФайла,
	                      |	ЗНАЧЕНИЕ(Перечисление.НаправлениеОбменаБанкиКС.Экспорт) КАК НаправлениеОбмена,
	                      |	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка.Дата КАК Дата
	                      |ПОМЕСТИТЬ Врем_Док
	                      |ИЗ
	                      |	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена КАК ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена
	                      |ГДЕ
	                      |	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка = &Ссылка
	                      |	И НЕ ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Объект ССЫЛКА Документ.ЗапросУНИФО
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	КС_ИсторияОбмена.Объект КАК Объект
	                      |ПОМЕСТИТЬ Врем_Кроме
	                      |ИЗ
	                      |	РегистрСведений.ИсторияОбменаБанкиКС КАК КС_ИсторияОбмена
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Врем_Док КАК Врем_Док
	                      |		ПО КС_ИсторияОбмена.Объект = Врем_Док.Объект
	                      |			И КС_ИсторияОбмена.Организация = Врем_Док.Организация
	                      |			И КС_ИсторияОбмена.КассовыйОрган = Врем_Док.КассовыйОрган
	                      |			И КС_ИсторияОбмена.ТипФормата = Врем_Док.ТипФормата
	                      |ГДЕ
	                      |	КС_ИсторияОбмена.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.НаправлениеОбменаБанкиКС.Экспорт)
	                      |	И (КС_ИсторияОбмена.Объект ССЫЛКА Документ.КвитанцияНаОплатуГосуслуг
	                      |			ИЛИ КС_ИсторияОбмена.Объект ССЫЛКА Документ.НачислениеОтПодведомственного)
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Врем_Док.Организация,
	                      |	Врем_Док.КассовыйОрган,
	                      |	Врем_Док.ТипФормата,
	                      |	Врем_Док.Объект,
	                      |	Врем_Док.ИмяФайла,
	                      |	Врем_Док.НаправлениеОбмена,
	                      |	Врем_Док.Дата
	                      |ИЗ
	                      |	Врем_Док КАК Врем_Док
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Врем_Кроме КАК Врем_Кроме
	                      |		ПО Врем_Док.Объект = Врем_Кроме.Объект
	                      |ГДЕ
	                      |	Врем_Кроме.Объект ЕСТЬ NULL ");
						  
	Запрос.УстановитьПараметр("Ссылка",  ДокументСсылка);	
	Результат = Запрос.ВыполнитьПакет();
	ИсторияОбменаДвижения = Результат[2].Выгрузить();
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("ИсторияОбменаБанкиКС",  ИсторияОбменаДвижения);
		
КонецПроцедуры // ИнициализироватьДанныеДокумента()

Процедура СформироватьФайлыЭкспорта(ЗаданиеНаЭкспорт) Экспорт
	
	//ЗаданиеНаЭкспорт = РеквизитФормыВЗначение("Объект");
	
	Если ЗаданиеНаЭкспорт.Ссылка.Пустая() Тогда
		Попытка
			ЗаданиеНаЭкспорт.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось записать документ'"));
			Возврат;
		КонецПопытки;	
	КонецЕсли;	
	
	
	ЗаданиеНаЭкспорт.УдалитьВсеПодчиненныйФайлы();

	ОбработкаОбмена = Справочники.ТипыОбменаБанкиКС.ПолучитьОбработку(ЗаданиеНаЭкспорт.ВидОбмена);
	Если ОбработкаОбмена = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//-------------------------------------------------
	//преобразование сведений об ошибках  
	
	ОбработкаОбмена.СформироватьФайлы(ЗаданиеНаЭкспорт);
		
	Для каждого СтрокаВыгрузки Из ЗаданиеНаЭкспорт.ОбъектыОбмена Цикл
		
		Если ЗначениеЗаполнено(СтрокаВыгрузки.ОписаниеОшибки) Тогда
			 СтрокаВыгрузки.Описание 	= "Подробно...";			 
		Иначе
			 СтрокаВыгрузки.Описание = "";
		КонецЕсли; 
		 
	КонецЦикла;
	Попытка
		ЗаданиеНаЭкспорт.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось записать документ'"));
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьПараметрыНастройкиОбмена(МассивПараметров,НастройкаОбмена) Экспорт
	
	Если МассивПараметров = Неопределено Тогда
		МассивПараметров = Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиОбменаБанкиКСПараметры.Имя,
		|	НастройкиОбменаБанкиКСПараметры.Значение
		|ИЗ
		|	Справочник.НастройкиОбменаБанкиКС.Параметры КАК НастройкиОбменаБанкиКСПараметры
		|ГДЕ
		|	НастройкиОбменаБанкиКСПараметры.Ссылка = &Ссылка
		|	И ВЫБОР
		|			КОГДА &ЕстьМассивПараметров
		|				ТОГДА НастройкиОбменаБанкиКСПараметры.Имя В (&МассивПараметров)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";

	Запрос.УстановитьПараметр("Ссылка", НастройкаОбмена);
    Запрос.УстановитьПараметр("МассивПараметров", МассивПараметров);
	Запрос.УстановитьПараметр("ЕстьМассивПараметров",МассивПараметров.Количество()>0);
	
	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    СоответствиеДанных = Новый Соответствие;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Попытка
			СоответствиеДанных.Вставить(ВыборкаДетальныеЗаписи.Имя,ВыборкаДетальныеЗаписи.Значение);
		Исключение
		КонецПопытки
	КонецЦикла;

	Возврат СоответствиеДанных;
	
КонецФункции 

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Результат        = Новый ТабличныйДокумент;
	Формат           = ПараметрыПечати.Формат;
	ИмяФайла         = ПараметрыПечати.ИмяФайла;
	СсылкаНаЗадание  = ПараметрыПечати.Ссылка;
	ОписаниеОшибки   = "";
	
	ОбъектыПечати.Добавить(Формат, Формат.Наименование);
	
	Если ОткрытьДокументФайла(Формат,	ИмяФайла,	СсылкаНаЗадание, Результат, ОписаниеОшибки) Тогда     
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "МакетФормата", "Печатная форма документа из файла :"+ ИмяФайла, Результат);			
	Иначе
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры   

Функция ОткрытьДокументФайла(Формат, ИмяФайлаЗагрузки, СсылкаНаЗадание, Результат, ОписаниеОшибки) Экспорт
	
	ОбработкаОбмена = Справочники.ТипыОбменаБанкиКС.ПолучитьОбработку(Формат.Владелец); 
	
	Если ОбработкаОбмена = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Возврат ОбработкаОбмена.ОткрытьДокументФайла(Формат, ИмяФайлаЗагрузки, СсылкаНаЗадание, Результат, ОписаниеОшибки);	
	
КонецФункции	



#КонецОбласти

#КонецЕсли
