#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Перем СписокТиповОбъектов;

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Процедура УдалитьВсеПодчиненныйФайлы() Экспорт 

	ВладелецФайла 	= ЭтотОбъект.Ссылка;
	МассивФайлов 	= Новый Массив;
	РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ВладелецФайла, МассивФайлов); 
	УстановитьПривилегированныйРежим(Истина);
	Для каждого ПрисоединенныйФайл Из МассивФайлов Цикл
		
		Если ВидОбмена.ПредставлениеВНомереВерсии = "UFBS" И ОбъектыОбмена.Найти(ПрисоединенныйФайл, "Файл") <> Неопределено Тогда
			 Продолжить;
		КонецЕсли;	
		
		ПрисоединенныйФайл.ПолучитьОбъект().Удалить();
			
	КонецЦикла; 
	
КонецПроцедуры

Процедура ПолучитьСписокОбъектовИзНастройки(СписокТипов = Неопределено) Экспорт
	
	СписокТипов = Новый Массив;
	СоответствиеТиповОбъектовФорматам = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НастройкаФорматов", НастройкаФорматов);
	Запрос.Текст = "ВЫБРАТЬ Различные
	               |	КС_СписокФорматовНастройки.Формат.ИдентификаторОбъекта.ПолноеИмя КАК ТипОбъекта
	               |ИЗ
	               |	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК КС_СписокФорматовНастройки
	               |ГДЕ
	               |	КС_СписокФорматовНастройки.НастройкаФормата = &НастройкаФорматов";
				   
	ПолныйСписокТипов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ТипОбъекта");
	 
	Для Каждого ЭлементСписка Из ПолныйСписокТипов Цикл
		Если ЗначениеЗаполнено(ЭлементСписка) Тогда
			СписокТипов.Добавить(ЭлементСписка);
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧастьФайлыОбмена() Экспорт  
	
	ОбъектыОбмена.Очистить();
	
	МассивФайлов 	        = Новый Массив;
	РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ЭтотОбъект.Ссылка, МассивФайлов);    
	
	Если МассивФайлов.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;	
	
	ФорматВыгрузки          = "";
	
	Запрос                  = Новый Запрос;
	Запрос.УстановитьПараметр("ТипФормата", ВидОбмена);
	Запрос.УстановитьПараметр("ИмяОбъекта", "ЗаданиеНаЭкспортДанныхВБанкиКС");
	Запрос.Текст            = "
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 
		|	ФорматыОбменаБанкиКС.Ссылка КАК Ссылка
	 	|ИЗ
	 	|	Справочник.ФорматыОбменаБанкиКС КАК ФорматыОбменаБанкиКС   
		|ГДЕ  
		|	(ФорматыОбменаБанкиКС.Владелец = &ТипФормата) И (ФорматыОбменаБанкиКС.ИдентификаторОбъекта.ИМЯ = &ИмяОбъекта) 
		|   И (ФорматыОбменаБанкиКС.ФорматСлужебногоКонверта = Ложь)
		|";  
	
	Результат = Запрос.Выполнить().Выбрать();
		
	Если Результат.Следующий() Тогда
		ФорматВыгрузки = Результат.Ссылка;
	КонецЕсли;     
	
	ФорматКонверта          = "";
	
	Запрос                  = Новый Запрос;
	Запрос.УстановитьПараметр("ТипФормата", ВидОбмена);
	Запрос.УстановитьПараметр("ИмяОбъекта", "ЗаданиеНаЭкспортДанныхВБанкиКС");
	Запрос.Текст            = "
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 
		|	ФорматыОбменаБанкиКС.Ссылка КАК Ссылка
	 	|ИЗ
	 	|	Справочник.ФорматыОбменаБанкиКС КАК ФорматыОбменаБанкиКС   
		|ГДЕ  
		|	(ФорматыОбменаБанкиКС.Владелец = &ТипФормата) И (ФорматыОбменаБанкиКС.ИдентификаторОбъекта.ИМЯ = &ИмяОбъекта) 
		|   И (ФорматыОбменаБанкиКС.ФорматСлужебногоКонверта = Истина)
		|";  
	
	Результат = Запрос.Выполнить().Выбрать();
		
	Если Результат.Следующий() Тогда
		ФорматКонверта = Результат.Ссылка;
    КонецЕсли;
	
	Если ФорматВыгрузки = "" И ФорматКонверта = "" Тогда
		Возврат;
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Истина);   	
	КодировкаТекстаФайла    = ВидОбмена.КодировкаТекстаФайла;   
	
	Для каждого ПрисоединенныйФайл Из МассивФайлов Цикл
		
		ИнформацияОФайле = РаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл);		
		ДвоичныеДанные   = ПолучитьИзВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла);
				
		Если ЭтоАдресВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла) Тогда  
			
			ВременныйКаталог   = КаталогВременныхФайлов();
	        ВременныйКаталог   = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ВременныйКаталог);
			
			ИмяВременногоФайла = ВременныйКаталог + ПрисоединенныйФайл.Наименование + "." + ПрисоединенныйФайл.Расширение;
			ПолучитьИзВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла).Записать(ИмяВременногоФайла);
			
			ТекстовыйФайл = Новый ЧтениеТекста(ИмяВременногоФайла, КодировкаТекстаФайла);
			СодержимоеФайла = ТекстовыйФайл.Прочитать();
			ТекстовыйФайл.Закрыть();
			УдалитьФайлы(ИмяВременногоФайла);  
			
		КонецЕсли;    
		
		Если (Найти(СодержимоеФайла, "SigValue") > 0) Тогда
			Продолжить;
		КонецЕсли;
		
		Если (Найти(СодержимоеФайла, "MACValue") > 0) И ЗначениеЗаполнено(ФорматКонверта) Тогда     
			
			НоваяСтрока        = ОбъектыОбмена.Добавить();	   
			НоваяСтрока.Файл   = ПрисоединенныйФайл; 
			НоваяСтрока.Объект = ЭтотОбъект.Ссылка;
			НоваяСтрока.Формат = ФорматКонверта;

		ИначеЕсли ЗначениеЗаполнено(ФорматВыгрузки) И Нрег(ПрисоединенныйФайл.Расширение = "txt") Тогда
			
		    НоваяСтрока        = ОбъектыОбмена.Добавить();	   
			НоваяСтрока.Файл   = ПрисоединенныйФайл; 
			НоваяСтрока.Объект = ЭтотОбъект.Ссылка;
			НоваяСтрока.Формат = ФорматВыгрузки;
			
		КонецЕсли;	
		
    КонецЦикла; 
	
КонецПроцедуры	

Процедура ЗаполнитьТабличнуюЧастьОбъектыОбмена(ТаблицаДопНастроек = Неопределено) Экспорт

	ПолучитьСписокОбъектовИзНастройки(СписокТиповОбъектов);
	
	Если НЕ СписокТиповОбъектов.Количество() Тогда
		ОбъектыОбмена.Очистить();
		Возврат;
	КонецЕсли;	
	
	Запрос       = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаОт",     		НачалоДня(ДатаНач));
	Запрос.УстановитьПараметр("ДатаДо",     		КонецДня(ДатаКон));
	Запрос.УстановитьПараметр("ПустаяДата",			Дата('00010101'));
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ТипФормата",			ВидОбмена);
	Запрос.УстановитьПараметр("НастройкаФорматов",	НастройкаФорматов);
	Запрос.УстановитьПараметр("КассовыйОрган",		КассовыйОрган);
	Запрос.УстановитьПараметр("ГотовыйСтатус",		Перечисления.СтатусыИсполненияДокумента.Подготовлен);

	
	Запрос.Текст = "";
	ТекстОбъединить = "";
	
	Для Каждого ТипОбъекта Из СписокТиповОбъектов Цикл
				
		Если Не ЗначениеЗаполнено(Запрос.Текст) Тогда
			ТекстВыбрать = "
	                       |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ";
		Иначе	
			ТекстВыбрать = "
		                   |ВЫБРАТЬ"
		КонецЕсли;

        
		Запрос.Текст = Запрос.Текст + ТекстОбъединить + ТекстВыбрать + " 
		|	ОбъектОбмена.Ссылка      КАК Объект,
		|   NULL 					 КАК  ИмяФайлаВыгрузки, 
		|	КС_СписокФорматовНастройки.Формат КАК Формат,
		|   NULL 					 КАК  ОписаниеОшибки,
		|   ЕСТЬNULL(СостояниеПлатежноРасчетныхДокументов.Статус, ""Статус неопределен"") КАК Статус
		|ИЗ
		|	" + ТипОбъекта + "       КАК ОбъектОбмена
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК КС_СписокФорматовНастройки
		|		ПО (КС_СписокФорматовНастройки.Формат.ИдентификаторОбъекта.ПолноеИмя = """ + ТипОбъекта + """)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
		|		ПО ОбъектОбмена.Ссылка = СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент
		|ГДЕ (ОбъектОбмена.ПометкаУдаления                = ЛОЖЬ) 
		|И   (КС_СписокФорматовНастройки.Формат.Владелец  = &ТипФормата)
		|И   (КС_СписокФорматовНастройки.НастройкаФормата = &НастройкаФорматов)";
		
		Если Найти(Нрег(ТипОбъекта), "документ.") Тогда

			Запрос.Текст = Запрос.Текст + "
			|	И ОбъектОбмена.Дата МЕЖДУ &ДатаОт И &ДатаДо           
			|	И (ОбъектОбмена.Проведен = ЛОЖЬ ИЛИ КС_СписокФорматовНастройки.Формат.ЭкспортПроведенныхДокументов)";
			
			Если Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Измерения.ПлатежноРасчетныйДокумент.Тип.СодержитТип(Тип("ДокументСсылка" + Сред(ТипОбъекта, Найти(ТипОбъекта, ".")))) Тогда
			    Запрос.Текст = Запрос.Текст + "
				|	И СостояниеПлатежноРасчетныхДокументов.Статус = &ГотовыйСтатус";	
			КонецЕсли;
			
			Если ВРЕГ(ТипОбъекта) = ВРЕГ("Документ.УниверсальныйРегламентированныйОтчет") тогда
				Запрос.УстановитьПараметр("ВидОтчета",		Справочники.ВидыОтчетов.НайтиПоКоду("ЦелевыеСубсидии"));
				Запрос.УстановитьПараметр("ВидОтчета14",	Справочники.ВидыОтчетов.НайтиПоКоду("ЦелевыеСубсидии_2014"));
				Запрос.УстановитьПараметр("ВидОтчета16",	Справочники.ВидыОтчетов.НайтиПоКоду("ЦелевыеСубсидии_2016"));
				Запрос.УстановитьПараметр("ВидОтчета18",	Справочники.ВидыОтчетов.НайтиПоКоду("ЦелевыеСубсидии_2018"));
				Запрос.УстановитьПараметр("ВидОтчета0501015_24",	Справочники.ВидыОтчетов.НайтиПоКоду("ЦелевыеСубсидии_0501015_2024"));
				Запрос.Текст = Запрос.Текст + "
					|	И ОбъектОбмена.ВидОтчета В (&ВидОтчета, &ВидОтчета14, &ВидОтчета16, &ВидОтчета18, &ВидОтчета0501015_24)
					|	И ОбъектОбмена.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияОтчетов.Утвержден)";

			КонецЕсли;
			
			ОтборОрганизацияУстановлен 		= Ложь;
			ОтборКассовыйОрганУстановлен 	= Ложь;
				
			Если ВРЕГ(ТипОбъекта) = ВРЕГ("Документ.РасходноеРасписание") Тогда
				Запрос.Текст = Запрос.Текст + "
				|	И (ОбъектОбмена.ОрганКазначейства =	&КассовыйОрган ИЛИ ОбъектОбмена.ОрганКазначействаКуда =	&КассовыйОрган)
				|   И (ОбъектОбмена.Организация =	&Организация ИЛИ ОбъектОбмена.Распорядитель =	&Организация)";
				
				ОтборОрганизацияУстановлен 		= Истина;
				ОтборКассовыйОрганУстановлен 	= Истина;
				
			КонецЕсли;
				
			Если ВРЕГ(ТипОбъекта) = ВРЕГ("Документ.РегистрацияОбязательствИСведенийПоДоговорам") Тогда
				Запрос.Текст = Запрос.Текст + "
				|	И (ОбъектОбмена.ОрганКазначейства =	&КассовыйОрган ИЛИ ОбъектОбмена.ОрганКазначействаУФК =	&КассовыйОрган)
				|   И (ОбъектОбмена.Организация = &Организация)";
				
				ОтборОрганизацияУстановлен 		= Истина;
				ОтборКассовыйОрганУстановлен 	= Истина;
				
			КонецЕсли;   
			
			Если ВРЕГ(ТипОбъекта) = ВРЕГ("Документ.ЗаявкаНаСдачуПолучениеНаличных") Тогда
				Запрос.Текст = Запрос.Текст + "
				|	И (ОбъектОбмена.РеквизитыБанковскогоСчета.КассовыйОрган = &КассовыйОрган) 
				|   И (ОбъектОбмена.Организация = &Организация)";
				
				ОтборОрганизацияУстановлен 		= Истина;
				ОтборКассовыйОрганУстановлен 	= Истина;
				
			КонецЕсли; 
			
			Если НЕ (ОтборОрганизацияУстановлен И ОтборКассовыйОрганУстановлен) Тогда
				
				МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ТипОбъекта);
				
				КоллекцияРеквизитов = МетаданныеОбъекта.Реквизиты;
				
				Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", МетаданныеОбъекта) 
					И НЕ ОтборОрганизацияУстановлен Тогда
					
					Запрос.Текст = Запрос.Текст + "
					|   И (ОбъектОбмена.Организация = &Организация)";
					
					ОтборОрганизацияУстановлен 		= Истина;
					
				КонецЕсли;
				
				Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ОрганКазначейства", МетаданныеОбъекта) 
					И НЕ ОтборКассовыйОрганУстановлен Тогда
					
					Запрос.Текст = Запрос.Текст + "
					|   И (ОбъектОбмена.ОрганКазначейства = &КассовыйОрган)";
					
					ОтборКассовыйОрганУстановлен    = Истина;
					
				КонецЕсли;

				Для Каждого Реквизит Из КоллекцияРеквизитов Цикл
					
					Если НЕ ОтборОрганизацияУстановлен И Реквизит.Тип.СодержитТип(Тип("СправочникСсылка.Организации")) Тогда
						
						Запрос.Текст = Запрос.Текст + "
						|	И ОбъектОбмена." + Реквизит.Имя + " =	&Организация";
						
						ОтборОрганизацияУстановлен 	= Истина;
						
					ИначеЕсли НЕ ОтборКассовыйОрганУстановлен 
						И (Реквизит.Тип.СодержитТип(Тип("СправочникСсылка.Казначейства")) ИЛИ Реквизит.Тип.СодержитТип(Тип("СправочникСсылка.Банки")))  Тогда
						
						Запрос.Текст = Запрос.Текст + "
						|	И ОбъектОбмена." + Реквизит.Имя + " =	&КассовыйОрган";
						
						ОтборКассовыйОрганУстановлен 	= Истина;
						
					КонецЕсли;
					
					Если ОтборОрганизацияУстановлен И ОтборКассовыйОрганУстановлен Тогда
						Прервать;
					КонецЕсли;	
						
					Если Реквизит.Тип.СодержитТип(Тип("СправочникСсылка.РеквизитыЛицевыхСчетов")) Тогда
						
						Если НЕ ОтборОрганизацияУстановлен Тогда
						Запрос.Текст = Запрос.Текст + "
							|	И ОбъектОбмена." + Реквизит.Имя + ".Владелец.Владелец =	&Организация";
						ОтборОрганизацияУстановлен 	= Истина;
						КонецЕсли;	
	
						Если НЕ ОтборКассовыйОрганУстановлен Тогда
						Запрос.Текст = Запрос.Текст + "
						|	И ОбъектОбмена." + Реквизит.Имя + ".КассовыйОрган =	&КассовыйОрган";
						ОтборКассовыйОрганУстановлен = Истина;
						КонецЕсли;	
						
					ИначеЕсли Реквизит.Тип.СодержитТип(Тип("СправочникСсылка.ЛицевыеСчета")) И НЕ (Реквизит.Имя = "ЛицевойСчетПБС")
						И НЕ ОтборОрганизацияУстановлен Тогда
						
						Запрос.Текст = Запрос.Текст + "
						|	И ОбъектОбмена." + Реквизит.Имя + ".Владелец =	&Организация";
						
						ОтборОрганизацияУстановлен 	= Истина;

						
					КонецЕсли;
					
					Если ОтборОрганизацияУстановлен И ОтборКассовыйОрганУстановлен Тогда
						Прервать;
					КонецЕсли;	
					
				КонецЦикла;
				
			КонецЕсли;
			
			Если ТаблицаДопНастроек <> Неопределено Тогда
				ОбъектОтбора = Сред(ТипОбъекта,Найти(ТипОбъекта,".")+1);
				СтрокиОтбора = ТаблицаДопНастроек.НайтиСтроки(Новый Структура("ОбъектОтбора",ОбъектОтбора));
				Инд = 1;
				Для Каждого СтрокаОтбора Из СтрокиОтбора Цикл
					ИмяПараметра = ОбъектОтбора+"_"+Инд;
					Инд = Инд+1;
					Запрос.Текст = Запрос.Текст + "
					|	И ОбъектОбмена." + СтрокаОтбора.ИмяРеквизита +" "+СтрокаОтбора.ВидСравнения+" &"+ИмяПараметра; 
					Значение = ?(СтрокаОтбора.ВидСравнения = "Подобно","%"+СтрокаОтбора.Значение+"%",СтрокаОтбора.Значение);
					Запрос.УстановитьПараметр(ИмяПараметра,Значение);			
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли; 
		
	Запрос.Текст = Запрос.Текст + "		
	|И НЕ ОбъектОбмена.Ссылка В
	|	(ВЫБРАТЬ
	|	Регистр.Объект
	|ИЗ
	|	РегистрСведений.ИсторияОбменаБанкиКС КАК Регистр
	|ГДЕ
	|	Регистр.Организация = &Организация
	|	И Регистр.КассовыйОрган = &КассовыйОрган
	|	И Регистр.ТипФормата = &ТипФормата
	|	И Регистр.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.НаправлениеОбменаБанкиКС.Экспорт)
	|	И ВЫБОР
	|			КОГДА Регистр.Объект ССЫЛКА Документ.КвитанцияНаОплатуГосуслуг
	|				ТОГДА Регистр.Объект.ВидКвитанции <= 1
	|			КОГДА Регистр.Объект ССЫЛКА Документ.НачислениеОтПодведомственного
	|				ТОГДА Регистр.Объект.ВидКвитанции <= 1
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ)";	
		
			
	ТекстОбъединить = "
		|ОБЪЕДИНИТЬ ВСЕ";	
		
	КонецЦикла;	
		
	ТаблицаОбъектовИФорматов = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("ОбъектыИФорматы",ТаблицаОбъектовИФорматов);
						   
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОбъектыИФорматы.Объект,
		|	ОбъектыИФорматы.Формат
		|ПОМЕСТИТЬ ТабДок
		|ИЗ
		|	&ОбъектыИФорматы КАК ОбъектыИФорматы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабДок.Объект,
		|	ТабДок.Формат,
		|	NULL КАК ИмяФайлаВыгрузки,                   
		|	NULL КАК ОписаниеОшибки
		|
		|ИЗ
		|	ТабДок КАК ТабДок
		|";
	
    СтрокаДопУсловия = " ГДЕ Выбор ";
	Инд = 0;
	
	Для Каждого Строка Из ТаблицаОбъектовИФорматов Цикл
	    Инд = Инд + 1;
		Если НЕ(ЗначениеЗаполнено(СокрЛП(Строка.Формат.УсловиеИспользованияФормата))) Тогда

			Продолжить;
		
		КонецЕсли;
		
		Объект = Строка.Объект;
			
		СтрокаДопУсловия = СтрокаДопУсловия + " КОГДА ТабДок.Объект = &Объект"+Инд+" И ТабДок.Формат=&Формат"+Инд+" Тогда " + СтрЗаменить(Строка.Формат.УсловиеИспользованияФормата,"Объект.","ТабДок.Объект.");
		Запрос.УстановитьПараметр("Объект"+Инд,Объект);
		Запрос.УстановитьПараметр("Формат"+Инд,Строка.Формат); 
					
	КонецЦикла; 
	
	Если СтрокаДопУсловия<>" ГДЕ Выбор " Тогда
		СтрокаДопУсловия = СтрокаДопУсловия + " Иначе Истина Конец ";
		Запрос.Текст = Запрос.Текст+СтрокаДопУсловия;
	КонецЕсли;
		
	ОбъектыОбмена.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

