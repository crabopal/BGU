
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПередаваемыеСведения = ЗначениеИзСтрокиВнутр(ЭтаФорма.Параметры.СведенияОбОшибках);
	
	Если ТипЗнч(ПередаваемыеСведения) <> Тип("ТаблицаЗначений") Тогда
		Отказ = Истина;	
	КонецЕсли; 
	
	ЭтаФорма.СведенияОбОшибках.Загрузить(ПередаваемыеСведения);

КонецПроцедуры
