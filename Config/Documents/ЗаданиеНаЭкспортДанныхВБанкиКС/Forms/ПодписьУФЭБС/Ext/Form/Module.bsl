

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Заголовок = "Подписание файлов УФЭБС " + Строка(ЭтаФорма.Параметры.НомерЭтапа) + "-го этапа";	
	ПодобратьФайлыДляПодписания(ЭтаФорма.Параметры.НомерЭтапа, ЭтаФорма.Параметры.ВидОбмена, ЭтаФорма.Параметры.Задание);  
	
	Задание            = ЭтаФорма.Параметры.Задание; 
	НомерЭтапа         = ЭтаФорма.Параметры.НомерЭтапа;
	
	Если ЭтаФорма.ТаблицаФайлов.Количество() = 0 Тогда
		 ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для %1 -го этапа не обнаружены файлы на подписание'"),
					Строка(ЭтаФорма.Параметры.НомерЭтапа)));
		 Отказ = Истина;
	КонецЕсли;	
	
КонецПроцедуры    

&НаСервере
Функция ОпределитьФормат(ИмяФайла) 
	
	Формат          = "";
	СтрокиСФорматом = Задание.ОбъектыОбмена.Найти(ИмяФайла, "ИмяФайлаВыгрузки"); 
	
	Если СтрокиСФорматом <> Неопределено  Тогда     		
		Формат = СтрокиСФорматом.Формат;    					
	КонецЕсли;   	
	
	Возврат Формат;
	
КонецФункции

&НаКлиенте
Процедура ТаблицаФайловИмяФайлаНаПодписаниеОткрытие(Элемент, СтандартнаяОбработка) 
	
	СтандартнаяОбработка = Ложь;
	ИмяФайла             = Элемент.ТекстРедактирования;
	Формат               = ОпределитьФормат(ИмяФайла);  
	
	Попытка
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(	"Документ.ЗаданиеНаЭкспортДанныхВБанкиКС",
													"МакетФормата", 
													ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Задание),
													ЭтотОбъект,
													Новый Структура(	"Формат, ИмяФайла, Ссылка",
																		Формат,
																		ИмяФайла,
																		Задание));
	Исключение
		// Исключение не отрабатываем, т.к. в команде печати уже сделаны все необходимые сообщения пользователю
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбщиеВнутренниеДанные = Новый Соответствие;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СнятьПометки(Команда)
	УстановитьСнятьФлажки(ТаблицаФайлов,Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	УстановитьСнятьФлажки(ТаблицаФайлов,Истина);
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции    

&НаСервере
Процедура ПодобратьФайлыДляПодписания(НомерЭтапа, ВидОбмена, Задание)   
	
	ТаблицаФайловНаПодписание = Новый ТаблицаЗначений; 
	ТаблицаФайловНаПодписание.Колонки.Добавить("Использовать",         Новый ОписаниеТипов("Булево")); 
	ТаблицаФайловНаПодписание.Колонки.Добавить("ИмяФайлаНаПодписание", Новый ОписаниеТипов("Строка"));
	ТаблицаФайловНаПодписание.Колонки.Добавить("ИмяФайлаСПодписью",    Новый ОписаниеТипов("Строка"));   
	ТаблицаФайловНаПодписание.Колонки.Добавить("СодержимоеФайла",      Новый ОписаниеТипов("Строка")); 
	ТаблицаФайловНаПодписание.Колонки.Добавить("Маркер",               Новый ОписаниеТипов("Строка"));
	
	МассивДопустимыхМаркеровДляШифрования = Новый Массив;
	МассивДопустимыхМаркеровДляШифрования.Добавить("ED101");  
	МассивДопустимыхМаркеровДляШифрования.Добавить("ED462");    
	МассивДопустимыхМаркеровДляШифрования.Добавить("ED391");	
	
	Если НомерЭтапа = 1 Тогда
		Попытка
			КодировкаТекстаФайла	= КодировкаТекста[ВидОбмена.КодировкаТекстаФайла]
		Исключение
			КодировкаТекстаФайла    = ВидОбмена.КодировкаТекстаФайла;
		КонецПопытки;    
	Иначе
		КодировкаТекстаФайла = "windows-1251";
	КонецЕсли;
	
	СодержимоеФайла = "";
	
	ВладелецФайла 	= Задание;
	
	МассивФайлов 	= Новый Массив;
	РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ВладелецФайла, МассивФайлов);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для каждого ПрисоединенныйФайл Из МассивФайлов Цикл
		
		ИнформацияОФайле = РаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл);
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла);
		
		Если ЭтоАдресВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла) Тогда  
			
			ВременныйКаталог   = КаталогВременныхФайлов();
	        ВременныйКаталог   = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ВременныйКаталог);
			
			ИмяВременногоФайла = ВременныйКаталог + ПрисоединенныйФайл.Наименование + "." + ПрисоединенныйФайл.Расширение;
			ПолучитьИзВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла).Записать(ИмяВременногоФайла);
			
			ТекстовыйФайл = Новый ЧтениеТекста(ИмяВременногоФайла, КодировкаТекстаФайла);
			СодержимоеФайла = ТекстовыйФайл.Прочитать();
			ТекстовыйФайл.Закрыть();
			УдалитьФайлы(ИмяВременногоФайла);
		КонецЕсли;   
		
		МаркерТекущегоФайла = "";
		
		Для каждого ДопустимыйМаркер Из МассивДопустимыхМаркеровДляШифрования Цикл  
			
			Если Найти(СодержимоеФайла, ДопустимыйМаркер)> 0 Тогда 
				МаркерТекущегоФайла = ДопустимыйМаркер;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;	
		
		Если (НомерЭтапа = 1) И ЗначениеЗаполнено(МаркерТекущегоФайла) И  Найти(СодержимоеФайла, "SigValue") = 0 Тогда
			
			СтрокаТаблицыФайлов                      = ТаблицаФайловНаПодписание.Добавить();  
			СтрокаТаблицыФайлов.Использовать         = Истина;
			СтрокаТаблицыФайлов.ИмяФайлаНаПодписание = ИнформацияОФайле.ИмяФайла;
			СтрокаТаблицыФайлов.СодержимоеФайла      = СодержимоеФайла; 
			СтрокаТаблицыФайлов.Маркер               = МаркерТекущегоФайла;
			
		КонецЕсли;   
		
		Если (НомерЭтапа = 2) И ЗначениеЗаполнено(МаркерТекущегоФайла) И  Найти(СодержимоеФайла, "SigValue") > 0 Тогда
			
			СтрокаТаблицыФайлов                      = ТаблицаФайловНаПодписание.Добавить();  
			СтрокаТаблицыФайлов.Использовать         = Истина;
			СтрокаТаблицыФайлов.ИмяФайлаНаПодписание = ИнформацияОФайле.ИмяФайла;
			СтрокаТаблицыФайлов.СодержимоеФайла      = СодержимоеФайла;  
			СтрокаТаблицыФайлов.Маркер               = МаркерТекущегоФайла;
			
		КонецЕсли;
		
	КонецЦикла;  
		
	ЭтаФорма.ТаблицаФайлов.Загрузить(ТаблицаФайловНаПодписание);
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьСнятьФлажки(Таблица, ЗначениеФлажка)
	
	Для Каждого СтрТаб Из Таблица Цикл
		СтрТаб.Использовать = ЗначениеФлажка;
	КонецЦикла;   
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура Подписать(Команда)
	
	Отказ = Ложь;

	СтрокиИстина = ТаблицаФайлов.НайтиСтроки(Новый Структура("Использовать", Истина));  
	
	Если СтрокиИстина.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не выбран ни один файл для подписания'"),,"Объект.ТаблицаФайлов",, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	 
	
	МассивУчастковНаПодписание =  Новый Массив;
	
	Попытка
		МассивУчастковНаПодписание = Ждать ВыделитьОбластиДляПодписания();
	Исключение
		ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Если МассивУчастковНаПодписание.Количество() = 0 Тогда
		 ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не найдены элементы для подписания'"),,,, Отказ);
	КонецЕсли; 
	 
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	 
	
	Данные = Новый Структура;
	Данные.Вставить("МассивУчастковНаПодписание",  МассивУчастковНаПодписание);
	
	Контекст = Новый Структура;
	Контекст.Вставить("Данные", Данные);
	
	ЭлектроннаяПодписьКлиент.УстановитьРасширение(Истина,
			Новый ОписаниеОповещения("ПодписатьПослеПодключенияРасширенияРаботыСКриптографией", ЭтотОбъект, Контекст));
	
КонецПроцедуры 		
		
&НаКлиенте
Процедура ПодписатьПослеПодключенияРасширенияРаботыСКриптографией(Подключено, Контекст) Экспорт
	
	Если Не Подключено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Пользователь отказался от установки расширения для работы с криптографией'"));
		Возврат;
	КонецЕсли;
	
	ОписаниеДанных = Новый Структура;
	ОписаниеДанных.Вставить("Операция",           НСтр("ru = 'Запрос пароля'"));
	ОписаниеДанных.Вставить("ЗаголовокДанных",    НСтр("ru = 'Запрос пароля'"));
	ОписаниеДанных.Вставить("Данные",             Контекст.Данные);	
	ОписаниеДанных.Вставить("ВыполнятьНаСервере", Ложь); 
	
	
	Форма = ОткрытьФорму( "Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.Форма.ВыборСертификатаДляПодписания",
			,,,,, Новый ОписаниеОповещения("ПодписатьНаКлиентеПослеВыбораСертификата", ЭтотОбъект, Контекст));  
	
		
КонецПроцедуры  
				
&НаКлиенте
Процедура ПодписатьНаКлиентеПослеВыбораСертификата(РезультатВыбора, Контекст) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Результат = Новый Структура("Успех, ОписаниеОшибки", Ложь, "");
	Иначе   
		
		СвойстваСертификата = ПолучитьСвойстваСертификата(РезультатВыбора.Сертификат);
		
	    Контекст.Вставить("Программа", СвойстваСертификата.Программа);
		
		ДанныеСертификата = ПолучитьДанныеСертификата(РезультатВыбора.Сертификат);
		Контекст.Вставить("АлгоритмПодписи",
		ЭлектроннаяПодписьСлужебныйКлиентСервер.АлгоритмПодписиСертификата(ДанныеСертификата));  
		Контекст.Вставить("ДанныеСертификата", ДанныеСертификата);
	
					
		ПараметрыСоздания = ЭлектроннаяПодписьСлужебныйКлиент.ПараметрыСозданияМенеджераКриптографии();
		ПараметрыСоздания.ПоказатьОшибку = Ложь;
		ПараметрыСоздания.АлгоритмПодписи = Контекст.АлгоритмПодписи;
		
		СертификатКриптографии = Новый СертификатКриптографии;
		СертификатКриптографии.НачатьИнициализацию(Новый ОписаниеОповещения(
			"ПроверитьНаСторонеКлиентаПослеИнициализацииСертификата", ЭтотОбъект, Контекст,
			"ПроверитьНаСторонеКлиентаПослеОшибкиИнициализацииСертификата", ЭтотОбъект),
		Контекст.ДанныеСертификата);			
		
	КонецЕсли;
	
КонецПроцедуры	  

&НаКлиенте
Процедура ПроверитьНаСторонеКлиентаПослеОшибкиИнициализацииСертификата(ИнформацияОбОшибке, СтандартнаяОбработка, Контекст) Экспорт
	
	СтандартнаяОбработка = Ложь;
		
КонецПроцедуры


&НаКлиенте
Процедура ПроверитьНаСторонеКлиентаПослеИнициализацииСертификата(СертификатКриптографии, Контекст) Экспорт     
	
	Контекст.Вставить("СертификатКриптографии", СертификатКриптографии);
    ЭлектроннаяПодписьСлужебныйКлиент.ПолучитьСертификатПоОтпечатку(Новый ОписаниеОповещения(
				"ПроверитьНаСторонеКлиентаПослеПоискаСертификата", ЭтотОбъект, Контекст),
				Base64Строка(Контекст.СертификатКриптографии.Отпечаток), Истина, Неопределено);
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьДанныеСертификата(Сертификат) 
	
	Возврат Сертификат.ПолучитьОбъект().ДанныеСертификата.Получить(); 
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьСвойстваСертификата(Сертификат) 
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сертификат,
		"ДанныеСертификата, Программа"); 
	
КонецФункции	
			
&НаКлиенте
Процедура ПроверитьНаСторонеКлиентаПослеПоискаСертификата(Результат, Контекст) Экспорт
	
	
	ПараметрыСоздания = ЭлектроннаяПодписьСлужебныйКлиент.ПараметрыСозданияМенеджераКриптографии();
	ПараметрыСоздания.АлгоритмПодписи = Контекст.АлгоритмПодписи;
	ПараметрыСоздания.ПоказатьОшибку = Ложь;
	
	// Проверка данных сертификата.
	ЭлектроннаяПодписьСлужебныйКлиент.СоздатьМенеджерКриптографии(Новый ОписаниеОповещения(
		"ПроверитьНаСторонеКлиентаПослеСозданияЛюбогоМенеджераКриптографии", ЭтотОбъект, Контекст),
		"ПроверкаСертификата", ПараметрыСоздания);
	
КонецПроцедуры     

&НаКлиенте
Процедура ПроверитьНаСторонеКлиентаПослеСозданияЛюбогоМенеджераКриптографии(Результат, Контекст) Экспорт
	
	Если ТипЗнч(Результат) = Тип("МенеджерКриптографии") Тогда
		ДополнительныеПараметрыПроверок = ЭлектроннаяПодписьСлужебныйКлиент.ДополнительныеПараметрыПроверкиСертификата();
		ДополнительныеПараметрыПроверок.ВыполнятьПроверкуУдостоверяющегоЦентра = ЭлектроннаяПодписьСлужебныйКлиентСервер.НеПроверятьСертификат();
		ДополнительныеПараметрыПроверок.ОбъединитьОшибкиДанныхСертификата = Ложь;
		ДополнительныеПараметрыПроверок.ПроверитьВСервисеПослеОшибки = Ложь;
		ЭлектроннаяПодписьСлужебныйКлиент.ПроверитьСертификат(Новый ОписаниеОповещения(
				"ПроверитьНаСторонеКлиентаПослеПроверкиСертификата", ЭтотОбъект, Контекст),
			Контекст.СертификатКриптографии, Результат,,ДополнительныеПараметрыПроверок);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Асинх Процедура ПроверитьНаСторонеКлиентаПослеПроверкиСертификата(Результат, Контекст) Экспорт	
			
	ПараметрыСоздания = ЭлектроннаяПодписьСлужебныйКлиент.ПараметрыСозданияМенеджераКриптографии();
	ПараметрыСоздания.Программа = Контекст.Программа;
	ПараметрыСоздания.ПоказатьОшибку = Ложь;
	ПараметрыСоздания.ИнтерактивныйРежим = Истина;
	
	ЭлектроннаяПодписьСлужебныйКлиент.СоздатьМенеджерКриптографии(Новый ОписаниеОповещения(
			"ПроверитьНаСторонеКлиентаПослеСозданияМенеджераКриптографии", ЭтотОбъект, Контекст),
		"ПроверкаСертификата", ПараметрыСоздания);

	
КонецПроцедуры   

&НаКлиенте
Асинх Процедура ПроверитьНаСторонеКлиентаПослеСозданияМенеджераКриптографии(Результат, Контекст) Экспорт
	
	Контекст.Вставить("МенеджерКриптографии", Неопределено);
	
	Если ТипЗнч(Результат) = Тип("МенеджерКриптографии") Тогда
		Контекст.МенеджерКриптографии = Результат;
		ОписаниеОшибки = "";
	Иначе
		ОписаниеОшибки = Результат + Символы.ПС + Символы.ПС
			+ НСтр("ru = 'Подписание не может быть выполнено.'");
	КонецЕсли;
		
	// Подписание.
	
	Контекст.МенеджерКриптографии.ВключениеСертификатовВПодпись = РежимВключенияСертификатовКриптографии.НеВключать;
	Кодировка  = "windows-1251"; //КодировкаИзЗадания(Задание);   
	
	Для каждого СтрокаДляПодписания Из Контекст.Данные.МассивУчастковНаПодписание Цикл
		
		Попытка
			
			ВременныйКаталог = КаталогВременныхФайлов();
	        ВременныйКаталог = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ВременныйКаталог);
			
			ИмяТекФайла      = ВременныйКаталог + СтрокаДляПодписания.Файл;
			ЗаписьДанных     = Новый ЗаписьДанных(ИмяТекФайла);  
			
			ЗаписьДанных.ЗаписатьСимволы(СтрокаДляПодписания.ТекстНаПодписание, ?(НомерЭтапа = 1, КодировкаТекста.UTF8, Кодировка));	
			ЗаписьДанных.Закрыть();
			
			ДанныеПодписи = Ждать Контекст.МенеджерКриптографии.ПодписатьАсинх(ИмяТекФайла, Контекст.СертификатКриптографии, ТипПодписиКриптографии.CMS);
			Если НЕ ЭлектроннаяПодписьСлужебныйКлиентСервер.ПустыеДанныеПодписи(ДанныеПодписи, ОписаниеОшибки) Тогда  
				 СтрокаДляПодписания.Подпись = Base64Строка(ДанныеПодписи);
			КонецЕсли;	
			
			УдалитьФайлы(ИмяТекФайла);
						 
		Исключение
			ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;    
		
	КонецЦикла;	
	
	Результат = Истина;
	
	Попытка 
		Если НомерЭтапа = 1 Тогда
			Результат = Ждать СформироватьДокументыПервогоЭтапа(Контекст.Данные.МассивУчастковНаПодписание);  
		ИначеЕсли НомерЭтапа = 2 Тогда
			Результат = Ждать СформироватьДокументыВторогоЭтапа(Контекст.Данные.МассивУчастковНаПодписание);	
		КонецЕсли;	
	Исключение
		ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат      = Ложь ;
	КонецПопытки;	
	
	Если Результат Тогда 
		Если НомерЭтапа = 1 Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Файлы успешно подписаны.'"));  
		ИначеЕсли НомерЭтапа = 2 Тогда
			ОписаниеОповещения = Новый ОписаниеОповещения("ПереместитьФайлыЗавершение", ЭтотОбъект);
			
	        ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Файлы успешно подписаны. 
	                                                      |  Отправить файлы?'"), РежимДиалогаВопрос.ДаНет);  
		КонецЕсли;	
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось подписать файлы.'"));
	КонецЕсли;
		
КонецПроцедуры	 

&НаКлиенте
Процедура ПереместитьФайлыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
        
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
        ТекстОшибки = "";
	
		ДополнительныеПараметры = Новый Структура; 
		ДополнительныеПараметры.Вставить("МассивФайлов", ПолучитьМассивФайлов(НомерЭтапа));
		
		ЭкспортФайловКлиент.ЭкспортФайловЗаданияНаЭкспорт(Задание, НастройкаОбменаИзЗадания(Задание), КаталогВыгрузкиИзЗадания(Задание), ТекстОшибки, УникальныйИдентификатор, ДополнительныеПараметры);
		
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
    КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПоместитьФайлВПрисоединенные(АдресФайлаВоВременномХранилище, ИмяФайлаПередачи, АдресТекстаВоВременномХранилище = "")  
	
	РаботаСФайлами.ДобавитьФайл(
	Новый Структура("ВладелецФайлов, ИмяБезРасширения, РасширениеБезТочки, Автор, ВремяИзмененияУниверсальное",  
	Задание.Ссылка, 
	Лев(ИмяФайлаПередачи, Найти(ИмяФайлаПередачи, ".") - 1),
	Сред(ИмяФайлаПередачи, Найти(ИмяФайлаПередачи, ".") + 1), 
	ПользователиКлиентСервер.ТекущийПользователь(),
	УниверсальноеВремя(ТекущаяДатаСеанса())),     
	АдресФайлаВоВременномХранилище, 
	АдресТекстаВоВременномХранилище);	

КонецПроцедуры	

&НаСервере
Процедура УдалитьФайлыЭтапа(МассивФайлов)
	
	УстановитьПривилегированныйРежим(Истина);
	Для каждого ПрисоединенныйФайл Из МассивФайлов Цикл
		
		ПрисоединенныйФайл.ПолучитьОбъект().Удалить();			
			
	КонецЦикла; 
	
КонецПроцедуры	  

&НаСервере
Функция ПолучитьМассивФайлов(НомерЭтапа) 
	
	ВладелецФайла 	    = Задание.Ссылка;
	МассивФайлов 	    = Новый Массив;
	РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ВладелецФайла, МассивФайлов);
	НовыйМассивФайлов 	= Новый Массив;      
	
	МассивДопустимыхМаркеровДляШифрования = Новый Массив;
	МассивДопустимыхМаркеровДляШифрования.Добавить("ED101");  
	МассивДопустимыхМаркеровДляШифрования.Добавить("ED462"); 
	МассивДопустимыхМаркеровДляШифрования.Добавить("ED391");
	
	Если НомерЭтапа = 1 Тогда
		Попытка
			КодировкаТекстаФайла	= КодировкаТекста[Задание.ВидОбмена.КодировкаТекстаФайла]
		Исключение
			КодировкаТекстаФайла    = Задание.ВидОбмена.КодировкаТекстаФайла;
		КонецПопытки; 
	Иначе
		КодировкаТекстаФайла = "windows-1251";
	КонецЕсли;
	
	Для каждого ПрисоединенныйФайл Из МассивФайлов Цикл   
		
		ИнформацияОФайле = РаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл);
		
		ДвоичныеДанные   = ПолучитьИзВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла);
		
		Если ЭтоАдресВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла) Тогда
			
			ВременныйКаталог = КаталогВременныхФайлов();
	        ВременныйКаталог = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ВременныйКаталог);
			
			ИмяВременногоФайла = ВременныйКаталог + ИнформацияОФайле.ИмяФайла;
			ПолучитьИзВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла).Записать(ИмяВременногоФайла);
			
			ТекстовыйФайл = Новый ЧтениеТекста(ИмяВременногоФайла, КодировкаТекстаФайла);
			СодержимоеФайла = ТекстовыйФайл.Прочитать();
			ТекстовыйФайл.Закрыть();
			УдалитьФайлы(ИмяВременногоФайла);
		КонецЕсли;   
		
		МаркерТекущегоФайла = "";
		
		Для каждого ДопустимыйМаркер Из МассивДопустимыхМаркеровДляШифрования Цикл  
			
			Если Найти(СодержимоеФайла, ДопустимыйМаркер)> 0 Тогда 
				МаркерТекущегоФайла = ДопустимыйМаркер;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;	
		
		Если (НомерЭтапа = 1) И ЗначениеЗаполнено(МаркерТекущегоФайла) И  Найти(СодержимоеФайла, "SigValue") > 0 Тогда
			НовыйМассивФайлов.Добавить(ПрисоединенныйФайл)
		КонецЕсли;  
		
		Если (НомерЭтапа = 2) И  Найти(СодержимоеФайла, "MACValue") > 0 Тогда
        	НовыйМассивФайлов.Добавить(ПрисоединенныйФайл)
		КонецЕсли; 
		
	КонецЦикла;	
	
	Возврат НовыйМассивФайлов;
	
КонецФункции

&НаКлиенте
Асинх Функция СформироватьДокументыВторогоЭтапа(МассивУчастковНаПодписание)
	
	ФайлыНаОбработку  = ТаблицаФайлов.НайтиСтроки(Новый Структура("Использовать", Истина)); 
	Кодировка         = "windows-1251"; //КодировкаИзЗадания(Задание); 
		
	ЧтениеXML         = Новый ЧтениеXML; 
	ПостроительDOM    = Новый ПостроительDOM;  
	
	Результат         = Истина;   
	
	Текст             = "<?xml version=""1.0"" encoding=""windows-1251""?>
						|<sen:SigEnvelope xmlns:sen=""urn:cbr-ru:dsig:env:v1.1"">
						|  <sen:SigContainer>
						|    <dsig:MACValue xmlns:dsig=""urn:cbr-ru:dsig:v1.1""></dsig:MACValue>
						|  </sen:SigContainer>
						|  <sen:Object></sen:Object>
						|</sen:SigEnvelope>"; 
	
	УдалитьФайлыЭтапа(ПолучитьМассивФайлов(НомерЭтапа));
	
	Для Каждого ОбрабатываемыйФайл Из ФайлыНаОбработку Цикл
		 
		ЧтениеXML.УстановитьСтроку(Текст);
			
		ДокументDOM                        = ПостроительDOM.Прочитать(ЧтениеXML);  		
		ЭлементПодписи                     = ДокументDOM.ПолучитьЭлементыПоИмени("MACValue")[0];   
			
		Подпись                            = "";	  
						
		Для каждого СтрокаМассива Из МассивУчастковНаПодписание Цикл
			Если (СтрокаМассива.Файл = ОбрабатываемыйФайл.ИмяФайлаНаПодписание) И (СтрокаМассива.НомерВхождения = 1) Тогда
				Подпись = СтрокаМассива.Подпись;    
				Прервать;
			КонецЕсли;
		КонецЦикла;		
			
		Если ЗначениеЗаполнено(Подпись) Тогда	   
			
			Подпись                            = СтрЗаменить(Подпись, Символы.ВК, "");
			Подпись                            = СтрЗаменить(Подпись, Символы.ПС, "");
		
			ЭлементПодписи.ТекстовоеСодержимое = Подпись;  
						
		КонецЕсли;	
		
		ЭлементОбъекта                         = ДокументDOM.ПолучитьЭлементыПоИмени("Object")[0];  
		
		СодержимоеОбъекта                      = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(ОбрабатываемыйФайл.СодержимоеФайла, Кодировка));
		СодержимоеОбъекта                      = СтрЗаменить(СодержимоеОбъекта, Символы.ВК, "");
		СодержимоеОбъекта                      = СтрЗаменить(СодержимоеОбъекта, Символы.ПС, "");

		ЭлементОбъекта.ТекстовоеСодержимое     = СодержимоеОбъекта;
		
		ЗаписьХМЛ        = Новый ЗаписьXML; 
		ЗаписьХМЛ.Отступ = Истина;  
		
		ВременныйКаталог = КаталогВременныхФайлов();
	    ВременныйКаталог = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ВременныйКаталог);
		
        ИмяТекФайла      = ВременныйКаталог + ОбрабатываемыйФайл.ИмяФайлаНаПодписание;
		ЗаписьХМЛ.ОткрытьФайл(ИмяТекФайла, Кодировка);
		
		ЗаписьDOM        = Новый ЗаписьDOM();
		ЗаписьDOM.Записать(ДокументDOM, ЗаписьХМЛ);
		
		ЗаписьХМЛ.Закрыть();  
		
		ДвоичныеДанные 					       = Новый ДвоичныеДанные(ИмяТекФайла);
		АдресФайлаВоВременномХранилище 	       = ПоместитьВоВременноеХранилище(ДвоичныеДанные);    
		АдресТекстаВоВременномХранилище        = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		
		ПоместитьФайлВПрисоединенные(АдресФайлаВоВременномХранилище, ОбрабатываемыйФайл.ИмяФайлаНаПодписание, АдресТекстаВоВременномХранилище);  
		ОбрабатываемыйФайл.ИмяФайлаСПодписью   = ОбрабатываемыйФайл.ИмяФайлаНаПодписание;
				
		УдалитьФайлы(ИмяТекФайла);   
					 	
	КонецЦикла;   
		
	Возврат Результат;
	
КонецФункции	

&НаКлиенте
Асинх Функция СформироватьДокументыПервогоЭтапа(МассивУчастковНаПодписание)
	
	ФайлыНаОбработку  = ТаблицаФайлов.НайтиСтроки(Новый Структура("Использовать", Истина)); 
	Кодировка         = "windows-1251"; //КодировкаИзЗадания(Задание);
	
	ЧтениеXML         = Новый ЧтениеXML; 
	ПостроительDOM    = Новый ПостроительDOM;  
	
	Результат         = Истина; 
	
	УдалитьФайлыЭтапа(ПолучитьМассивФайлов(НомерЭтапа));
		
	Для Каждого ОбрабатываемыйФайл Из ФайлыНаОбработку Цикл
		
		ЧтениеXML.УстановитьСтроку(ОбрабатываемыйФайл.СодержимоеФайла);	 
		ДокументDOM                        = ПостроительDOM.Прочитать(ЧтениеXML);  
		
		ДокументDOM.ПервыйДочерний.Префикс = "ed";
		
		СписокЭлементов                    = ДокументDOM.ПолучитьЭлементыПоИмени(ОбрабатываемыйФайл.Маркер);     
		НомерВхождения                     = 0;
		
		Для каждого Элемент Из СписокЭлементов Цикл  
			
			НомерВхождения  = НомерВхождения + 1;
			
			Элемент.Префикс = "ed";
			ПереименоватьДочерниеУзлы(Элемент, "ed");  
			
		    Подпись = "";	  
						
			Для каждого СтрокаМассива Из МассивУчастковНаПодписание Цикл
				Если (СтрокаМассива.Файл = ОбрабатываемыйФайл.ИмяФайлаНаПодписание) И (СтрокаМассива.НомерВхождения = НомерВхождения) Тогда
					Подпись = СтрокаМассива.Подпись;    
					Прервать;
				КонецЕсли;
			КонецЦикла;		
			
			Если ЗначениеЗаполнено(Подпись) Тогда	   
				
				Подпись                            = СтрЗаменить(Подпись, Символы.ВК, "");
				Подпись                            = СтрЗаменить(Подпись, Символы.ПС, "");
			
				ЭлементПодписи                     = ДокументDOM.СоздатьЭлемент("dsig:SigValue");  
		
				ЭлементПодписи.УстановитьСоответствиеПространстваИмен("dsig", "urn:cbr-ru:dsig:v1.1");  
				ЭлементПодписи.ТекстовоеСодержимое = Подпись;  
								
				Элемент.ВставитьПеред(ЭлементПодписи, Элемент.ПервыйДочерний);
							
			КонецЕсли;	
									
		КонецЦикла;
		
		ЗаписьХМЛ        = Новый ЗаписьXML; 
		ЗаписьХМЛ.Отступ = Ложь; 
		
		ВременныйКаталог = КаталогВременныхФайлов();
	    ВременныйКаталог = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ВременныйКаталог);
		
        ИмяТекФайла      = ВременныйКаталог + ОбрабатываемыйФайл.ИмяФайлаНаПодписание;
		ЗаписьХМЛ.ОткрытьФайл(ИмяТекФайла, Кодировка);
		
		ЗаписьDOM        = Новый ЗаписьDOM();
		ЗаписьDOM.Записать(ДокументDOM, ЗаписьХМЛ);
		
		ЗаписьХМЛ.Закрыть();  
		
		ДвоичныеДанные 					            = Новый ДвоичныеДанные(ИмяТекФайла);
		АдресФайлаВоВременномХранилище 	            = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		
		ПоместитьФайлВПрисоединенные(АдресФайлаВоВременномХранилище, ОбрабатываемыйФайл.ИмяФайлаНаПодписание); 
		ОбрабатываемыйФайл.ИмяФайлаСПодписью        = ОбрабатываемыйФайл.ИмяФайлаНаПодписание;
				
		УдалитьФайлы(ИмяТекФайла);   
					 	
	КонецЦикла;   
		
	Возврат Результат;
	
КонецФункции	

&НаКлиенте
Процедура ПереименоватьДочерниеУзлы(Элемент, Префикс)
		
	Для Каждого ДочернийЭлемент Из Элемент.ДочерниеУзлы Цикл  
		#Если ВебКлиент Тогда
		#Иначе	
		Если ДочернийЭлемент.ТипУзла = ТипУзлаDOM.Элемент Тогда
			ДочернийЭлемент.Префикс = Префикс;  
		КонецЕсли;
		#КонецЕсли
		ПереименоватьДочерниеУзлы(ДочернийЭлемент, Префикс);
	КонецЦикла;  
			
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура НастроитьКомпоненту(ОбъектКомпоненты)
	
	Попытка
		ОбъектКомпоненты.СоответствиеOID =
			ЭлектроннаяПодписьСлужебныйКлиентСервер.ИдентификаторыАлгоритмовХешированияИОткрытогоКлюча();
	Исключение
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось установить свойство %1 компоненты %2 по причине:
				|%3'"), "СоответствиеOID", "ExtraCryptoAPI", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьПутьККриптопровайдеру(ОбъектКомпоненты)
	
	Попытка
		
		//Если подписывать нужно на сервере с ОС Linux, нужно установить путь к модулю криптографии.
		Если ОбщегоНазначения.ЭтоLinuxСервер() Тогда
			//из документации БСП - глава 5, электронные подписи - Установка приложений электронной подписи в клиент-серверном варианте работы
			//Для Linux:
	        //	/opt/cprocsp/lib/amd64/libcapilite.so:/opt/cprocsp/lib/amd64/libcapi10.so:/opt/cprocsp/lib/amd64/libcapi20.so
	        //Для MacOS:
			//	/opt/cprocsp/lib/libcapi10.dylib:/opt/cprocsp/lib/libcapi20.dylib:/opt/cprocsp/lib/libcapi10.4.dylib:/opt/cprocsp/lib/libcapi20.4.dylib
			ПутиПоУмолчанию = "/opt/cprocsp/lib/amd64/libcapilite.so:/opt/cprocsp/lib/amd64/libcapi10.so:/opt/cprocsp/lib/amd64/libcapi20.so";
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux.Программа КАК Программа,
				|	ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux.ПутьКПрограмме КАК ПутьКПрограмме
				|ИЗ
				|	РегистрСведений.ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux КАК ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux
				|ГДЕ
				|	ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux.ИмяКомпьютера = &ИмяКомпьютера";
			
			Запрос.УстановитьПараметр("ИмяКомпьютера", ИмяКомпьютера());
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				МенеджерКриптографии = ЭлектроннаяПодпись.МенеджерКриптографии("",Ложь,"",ВыборкаДетальныеЗаписи.Программа);
				Если МенеджерКриптографии <> Неопределено Тогда
					ОбъектКомпоненты.ПутьККриптопровайдеру = ВыборкаДетальныеЗаписи.ПутьКПрограмме;
					Прервать;
				КонецЕсли;
				МенеджерКриптографии = Неопределено;
			КонецЦикла;
			//если не получилось заполнить по регистру, заполним по умолчанию
			Если Не ЗначениеЗаполнено(ОбъектКомпоненты.ПутиПоУмолчанию) Тогда 
				ОбъектКомпоненты.ПутьККриптопровайдеру = ПутиПоУмолчанию;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось установить свойство %1 компоненты %2 по причине:
				|%3'"), "ПутьККриптопровайдеру", "ExtraCryptoAPI", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстОшибки;	
	КонецПопытки;
	
КонецПроцедуры    


&НаСервереБезКонтекста
Функция КодировкаИзЗадания(ЗаданиеСсылка) 
	
	Возврат ЗаданиеСсылка.ВидОбмена.КодировкаТекстаФайла;
	
КонецФункции  

&НаСервереБезКонтекста
Функция НастройкаОбменаИзЗадания(ЗаданиеСсылка) 
	
	Возврат ЗаданиеСсылка.НастройкаОбмена;
	
КонецФункции   

&НаСервереБезКонтекста
Функция КаталогВыгрузкиИзЗадания(ЗаданиеСсылка) 
	
	Возврат ЗаданиеСсылка.КаталогВыгрузки;
	
КонецФункции 


&НаСервереБезКонтекста
Функция C14N(ОбъектКомпоненты, КонвертXML, XPath)
	
	Попытка
		КанонизированныйТекстXML = ОбъектКомпоненты.C14N(КонвертXML, XPath);
	Исключение
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("C14N",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	Если КанонизированныйТекстXML = Неопределено Тогда
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("C14N",
			ОбъектКомпоненты.ПолучитьОшибку());
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат КанонизированныйТекстXML;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОбъектВнешнейКомпонентыExtraCryptoAPI()
	
	ОписаниеКомпоненты = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОписаниеКомпоненты();
	ОбъектКомпоненты = ОбщегоНазначения.ПодключитьКомпонентуИзМакета(ОписаниеКомпоненты.ИмяОбъекта,
		ОписаниеКомпоненты.ПолноеИмяМакета);
	
	Если ОбъектКомпоненты = Неопределено Тогда
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось подключить внешнюю компоненту %1.'"), ОписаниеКомпоненты.ИмяОбъекта);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	НастроитьКомпоненту(ОбъектКомпоненты);
	
	УстановитьПутьККриптопровайдеру(ОбъектКомпоненты);
	
	Возврат ОбъектКомпоненты;
	
КонецФункции


&НаСервереБезКонтекста
Функция ПреобразованиеC14N1(Текст, ИмяУзлаПодписи)
	
	КомпонентаПодписиБСП = ОбъектВнешнейКомпонентыExtraCryptoAPI();
	XPath_ИмяУзлаПодписи = "(//. | //@* | //namespace::*)[ancestor-or-self::*[local-name()='" + ИмяУзлаПодписи + "']]";
	
	Возврат C14N(КомпонентаПодписиБСП, Текст, XPath_ИмяУзлаПодписи);    
	
КонецФункции	

&НаКлиенте
Асинх Функция ВыделитьОбластиДляПодписания()
	
	МассивУчастковНаПодписание =  Новый Массив;
	ФайлыНаОбработку           = ТаблицаФайлов.НайтиСтроки(Новый Структура("Использовать", Истина)); 
	Кодировка                  = КодировкаИзЗадания(Задание);
	
	ЧтениеXML                  = Новый ЧтениеXML; 
	ПостроительDOM             = Новый ПостроительDOM;
	
	Для Каждого ОбрабатываемыйФайл Из ФайлыНаОбработку Цикл
		
		Если НомерЭтапа = 1 Тогда
		
			ЧтениеXML.УстановитьСтроку(ОбрабатываемыйФайл.СодержимоеФайла);	 
			ДокументDOM    = ПостроительDOM.Прочитать(ЧтениеXML);  
			
			СписокЭлементов = ДокументDOM.ПолучитьЭлементыПоИмени(ОбрабатываемыйФайл.Маркер);     
			НомерВхождения  = 0;
			
			Для каждого Элемент Из СписокЭлементов Цикл  
				
				НомерВхождения  = НомерВхождения + 1;
				
				Элемент.Префикс = "n1";
				ПереименоватьДочерниеУзлы(Элемент, "n1");  
				Элемент.Нормализовать();
							
				ЗаписьХМЛ        = Новый ЗаписьXML; 
				ЗаписьХМЛ.Отступ = Ложь;   
				
				ВременныйКаталог = КаталогВременныхФайлов();
	            ВременныйКаталог = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ВременныйКаталог);
				
	            ИмяТекФайла      = ВременныйКаталог + ОбрабатываемыйФайл.ИмяФайлаНаПодписание;
				ЗаписьХМЛ.ОткрытьФайл(ИмяТекФайла, Кодировка);
				
				ЗаписьDOM        = Новый ЗаписьDOM();
				ЗаписьDOM.Записать(Элемент, ЗаписьХМЛ);
				
				ЗаписьХМЛ.Закрыть();
				
				Чтение           = Новый ЧтениеТекста(ИмяТекФайла, Кодировка);
				Текст            = Чтение.Прочитать();
				Чтение.Закрыть();
				УдалитьФайлы(ИмяТекФайла);   
							 
				Текст            = ПреобразованиеC14N1(Текст, ОбрабатываемыйФайл.Маркер);
				
				МассивУчастковНаПодписание.Добавить(Новый Структура("Файл, ТекстНаПодписание, НомерВхождения, Подпись", 
				      ОбрабатываемыйФайл.ИмяФайлаНаПодписание, Текст, НомерВхождения, ""));
				
			КонецЦикла; 
				  
		ИначеЕсли НомерЭтапа = 2 Тогда 
			
			МассивУчастковНаПодписание.Добавить(Новый Структура("Файл, ТекстНаПодписание, НомерВхождения, Подпись", 
				      ОбрабатываемыйФайл.ИмяФайлаНаПодписание, ОбрабатываемыйФайл.СодержимоеФайла, 1, ""));
			
		КонецЕсли;	
		
	КонецЦикла;   
	
	Возврат МассивУчастковНаПодписание;
	
КонецФункции	

#КонецОбласти

