		ДопПараметры.ТекДанные.Значение = ВыбЗнач;

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗапрещенныеПоля()
	Массив = Новый Массив;
	Массив.Добавить("Организация");
	Массив.Добавить("ИДИсточника");
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Массив.Добавить("ИФО");	
	КонецЕсли;
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Массив.Добавить("Подразделение");	
	КонецЕсли;

	Возврат Массив;
КонецФункции
 
&НаСервере
Функция ПолучитьПересечениеМассивов(МассивМассивов)
	
	Если МассивМассивов.Количество() = 0 Тогда
		МассивРезультат = Новый Массив;
		Возврат МассивРезультат;
	КонецЕсли;	
	
	МассивТ   = Новый Массив;
	ОписаниеТ = Новый ОписаниеТипов("Строка",Новый КвалификаторыСтроки(150));
	Таб = Новый Массив;
	Для Каждого МассивМассива Из МассивМассивов Цикл
		ТабЗ = Новый ТаблицаЗначений;
		ТабЗ.Колонки.Добавить("К1", ОписаниеТ);
		Для каждого Зн из МассивМассива Цикл
			СтрокаТаб = ТабЗ.Добавить();
			СтрокаТаб.К1 = Зн;
		КонецЦикла;	
		Таб.Добавить(ТабЗ);
	КонецЦикла;
		
	МВТ = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;

	ТекстЗапроса = "";
	ОкончаниеТекстаЗапроса = "Т1" + Символы.ПС;

	Для Инд = 1 По Таб.Количество() Цикл
		
		Запрос.УстановитьПараметр("Таб"+Инд, Таб[Инд-1]);
		
		ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ
					|	К1
					|ПОМЕСТИТЬ Т"+Инд+"
					|ИЗ
					|	&Таб"+Инд+" КАК Таб"+Инд+";
					|/////////////////////////" + Символы.ПС;
		
		Если Инд<>1 Тогда			
			
			ОкончаниеТекстаЗапроса = ОкончаниеТекстаЗапроса + "ВНУТРЕННЕЕ СОЕДИНЕНИЕ
					|	Т"+Инд+" ПО Т1.К1 = Т"+Инд+".К1" + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	*
					|ИЗ
					|" + ОкончаниеТекстаЗапроса;

	
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = ТекстЗапроса;
	ТабР = Запрос.Выполнить().Выгрузить();				
	МассивРезультат = ТабР.ВыгрузитьКолонку("К1");
	
	Возврат МассивРезультат;
	
КонецФункции	

&НаКлиенте
Процедура УстановитьСнятьФлажки(Таблица,ЗначениеФлажка,ЭтоТаблица=Истина)
	
	Для Каждого СтрТаб Из Таблица Цикл
		Если ЭтоТаблица Тогда
			СтрТаб.Использовать = ЗначениеФлажка;
		Иначе
			 Для Каждого СтрРек Из СтрТаб.ПолучитьЭлементы() Цикл
				СтрРек.Использовать = ЗначениеФлажка;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СформироватьТаблицуОтборов()
	ТаблицаОбщ = РеквизитФормыВЗначение("ТаблицаОбщегоОтбора");
	МассивОбщРек = Новый Массив;
	Для Каждого СтрОбщ Из ТаблицаОбщ Цикл
		Если СтрОбщ.Использовать Тогда
			МассивОбщРек.Добавить(СтрОбщ.ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	ДеревоИнд = РеквизитФормыВЗначение("ТаблицаИндивидуальногоОтбора");
	ТаблицаИнд = Новый ТаблицаЗначений;
	ТаблицаИнд.Колонки.Добавить("ИмяРеквизита");
	ТаблицаИнд.Колонки.Добавить("ВидСравнения");
	ТаблицаИнд.Колонки.Добавить("Значение");
	ТаблицаИнд.Колонки.Добавить("ОбъектОтбора");
	Для Каждого СтрД Из ДеревоИнд.Строки Цикл
		Для Каждого СтрР Из СтрД.Строки Цикл
			Если СтрР.Использовать Тогда
				НовСтр = ТаблицаИнд.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,СтрР);
				НовСтр.ОбъектОтбора = СтрД.ИмяНастройки;
			ИначеЕсли МассивОбщРек.Найти(СтрР.ИмяРеквизита)<>Неопределено Тогда
				СтрокаОбщ = ТаблицаОбщ.Найти(СтрР.ИмяРеквизита,"ИмяРеквизита");
				Если СтрокаОбщ<>Неопределено Тогда
					НовСтр = ТаблицаИнд.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтр,СтрокаОбщ);	
					НовСтр.ОбъектОтбора = СтрД.ИмяНастройки;
				КонецЕсли;			
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат ПоместитьВоВременноеХранилище(ТаблицаИнд,УИД);
КонецФункции

