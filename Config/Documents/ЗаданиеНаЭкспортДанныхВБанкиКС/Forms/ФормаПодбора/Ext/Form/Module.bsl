
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Перем ТаблицаДопОтбора;
	
	Период 	= Параметры.Период;
    УИД 	= Параметры.УИД;
	
	Если ЭтоАдресВременногоХранилища(Параметры.АдресТаблицыОтбора) Тогда
		ТаблицаДопОтбора = ПолучитьИзВременногоХранилища(Параметры.АдресТаблицыОтбора);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НастройкаФорматов", Параметры.НастройкаФорматов);
	Запрос.Текст = "ВЫБРАТЬ Различные
		           |	КС_СписокФорматовНастройки.Формат.ИдентификаторОбъекта.ПолноеИмя КАК ТипОбъекта,
		           |	КС_СписокФорматовНастройки.Формат.ИдентификаторОбъекта.Имя КАК ИмяОбъекта
		           |ИЗ
		           |	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК КС_СписокФорматовНастройки
		           |ГДЕ
		           |	КС_СписокФорматовНастройки.НастройкаФормата = &НастройкаФорматов";
					   
	ТаблицаТипов = Запрос.Выполнить().Выгрузить();
	
	МассивДокументов = Новый Массив;
	
	ДеревоИО = РеквизитФормыВЗначение("ТаблицаИндивидуальногоОтбора");
	
	ТаблицаРеквизитов = Новый ТаблицаЗначений;
	ТаблицаРеквизитов.Колонки.Добавить("ОбъектОтбора");
	ТаблицаРеквизитов.Колонки.Добавить("ИмяРеквизита");
	ТаблицаРеквизитов.Колонки.Добавить("ТипРеквизита");
	
	ЗапрещенныеПоля = ПолучитьЗапрещенныеПоля();
	
	Для Каждого ТипСписка Из ТаблицаТипов Цикл
		
		Если Найти(Нрег(ТипСписка.ТипОбъекта), "документ.") Тогда
			КоллекцияРеквизитов = Метаданные.Документы[ТипСписка.ИмяОбъекта].Реквизиты;
		Иначе
			Продолжить;
		КонецЕсли;
		
		СтрокаДерева = ДеревоИО.Строки.Добавить();
		СтрокаДерева.ИмяНастройки = ТипСписка.ИмяОбъекта;
		
		МассивДокумента = Новый Массив;
		
		Для Каждого РеквизитКоллекции Из КоллекцияРеквизитов Цикл
			
			Если (РеквизитКоллекции.Тип.СодержитТип(Тип("СправочникСсылка.Казначейства")) И НЕ (РеквизитКоллекции.Имя = "ОрганКазначействаКуда"))
				ИЛИ РеквизитКоллекции.Тип.СодержитТип(Тип("СправочникСсылка.Банки"))
				ИЛИ ЗапрещенныеПоля.Найти(РеквизитКоллекции.Имя)<>Неопределено Тогда
				Продолжить;
			КонецЕсли;

			НовСтрока = СтрокаДерева.Строки.Добавить();
			ИмяНастройки = ?(ЗначениеЗаполнено(РеквизитКоллекции.Комментарий),РеквизитКоллекции.Комментарий,РеквизитКоллекции.Синоним);
			НовСтрока.ИмяНастройки = РеквизитКоллекции.Синоним;
			НовСтрока.ИмяРеквизита = РеквизитКоллекции.Имя; 
			НовСтрока.ВидСравнения = "=";
			ОписаниеТипа = Новый ОписаниеТипов(РеквизитКоллекции.Тип);
			НовСтрока.Значение = ОписаниеТипа.ПривестиЗначение(НовСтрока.Значение);
			НовСтрока.ТипЗначения = ОписаниеТипа;
			
			Если ТаблицаДопОтбора<>Неопределено Тогда
				СтруктураПоиска = Новый Структура("ОбъектОтбора,ИмяРеквизита",ТипСписка.ИмяОбъекта,РеквизитКоллекции.Имя);
				НайденныеСтроки = ТаблицаДопОтбора.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтроки.Количество()>0 Тогда
					ЗаполнитьЗначенияСвойств(НовСтрока,НайденныеСтроки[0]);
					НовСтрока.Использовать = Истина;
				КонецЕсли;
			КонецЕсли;
			
			МассивДокумента.Добавить(РеквизитКоллекции.Имя);	
			
		КонецЦикла; 
		
		НовСтрока = СтрокаДерева.Строки.Добавить();
        НовСтрока.ИмяНастройки = "Дата документа";
		НовСтрока.ИмяРеквизита = "Дата"; 
		НовСтрока.ВидСравнения = "=";
		ОписаниеТипа = Новый ОписаниеТипов("Дата",Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
		НовСтрока.Значение = ОписаниеТипа.ПривестиЗначение(НовСтрока.Значение);
		НовСтрока.ТипЗначения = ОписаниеТипа;
		
		Если ТаблицаДопОтбора<>Неопределено Тогда
			СтруктураПоиска = Новый Структура("ОбъектОтбора,ИмяРеквизита",ТипСписка.ИмяОбъекта,"Дата");
			НайденныеСтроки = ТаблицаДопОтбора.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество()>0 Тогда
				ЗаполнитьЗначенияСвойств(НовСтрока,НайденныеСтроки[0]);
				НовСтрока.Использовать = Истина;
			КонецЕсли;
		КонецЕсли;

        НовСтрока = СтрокаДерева.Строки.Добавить();		
        НовСтрока.ИмяНастройки = "Номер документа";
		НовСтрока.ИмяРеквизита = "Номер"; 
		НовСтрока.ВидСравнения = "=";
		ОписаниеТипа = Новый ОписаниеТипов("Строка",Новый КвалификаторыСтроки(11));
		НовСтрока.Значение = ОписаниеТипа.ПривестиЗначение(НовСтрока.Значение);
		НовСтрока.ТипЗначения = ОписаниеТипа;
		
		Если ТаблицаДопОтбора<>Неопределено Тогда
			СтруктураПоиска = Новый Структура("ОбъектОтбора,ИмяРеквизита",ТипСписка.ИмяОбъекта,"Номер");
			НайденныеСтроки = ТаблицаДопОтбора.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество()>0 Тогда
				ЗаполнитьЗначенияСвойств(НовСтрока,НайденныеСтроки[0]);
				НовСтрока.Использовать = Истина;
			КонецЕсли;
		КонецЕсли;
		
		МассивДокументов.Добавить(МассивДокумента);
		
	КонецЦикла;
	
	Если МассивДокументов.Количество()>=2 Тогда 
		
		ИтоговыйМассив = ПолучитьПересечениеМассивов(МассивДокументов);		
		
		Если ДеревоИО.Строки.Количество()>0 Тогда
			ТаблицаОО = РеквизитФормыВЗначение("ТаблицаОбщегоОтбора");
			
			СтрокиРеквизитов = ДеревоИО.Строки[0].Строки;
			Для Каждого СтрокаРеквизитов Из СтрокиРеквизитов Цикл
				Если ИтоговыйМассив.Найти(СтрокаРеквизитов.ИмяРеквизита)<>Неопределено 
					И СтрокаРеквизитов.ИмяРеквизита <> "Комментарий" Тогда
					НовСтр = ТаблицаОО.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтр,СтрокаРеквизитов,"ТипЗначения,ИмяНастройки,ИмяРеквизита");
					НовСтр.ВидСравнения = "=";
					НовСтрока.Значение = НовСтрока.ТипЗначения.ПривестиЗначение(Неопределено);					
				КонецЕсли;		
			КонецЦикла;					
			ТаблицаОО.Сортировать("ИмяНастройки");
			ЗначениеВРеквизитФормы(ТаблицаОО,"ТаблицаОбщегоОтбора");
		КонецЕсли;
		
	КонецЕсли;	
	
	ДеревоИО.Строки.Сортировать("ИмяНастройки",Истина);
	ЗначениеВРеквизитФормы(ДеревоИО,"ТаблицаИндивидуальногоОтбора");
	
	Если ТаблицаОбщегоОтбора.Количество() = 0 Тогда
		Элементы.Отбор.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		Элементы.Отбор.ТекущаяСтраница = Элементы.ИндивидуальныйОтбор;
	КонецЕсли;
	
	Организация = Параметры.Организация;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыТаблицаОбщегоОтбора

&НаКлиенте
Процедура ТаблицаОтбораЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВыбранныйТип = Неопределено;
	
	ТекстЗаголовка = Элементы.ТаблицаОтбора.ТекущиеДанные.ИмяНастройки; 
	
	ТипЗначения = Элементы.ТаблицаОтбора.ТекущиеДанные.ТипЗначения;
	
	НачЗначение = Элементы.ТаблицаОтбора.ТекущиеДанные.Значение;
	
	ТекДанные = Элементы.ТаблицаОтбора.ТекущиеДанные; 
	
	ДопПараметры = Новый Структура("ВыбранныйТип, ТипЗначения, НачЗначение, ТекстЗаголовка, ТекДанные, Элемент", ВыбранныйТип, ТипЗначения, НачЗначение, ТекстЗаголовка, ТекДанные, Элемент);
	
	Если ТипЗначения.Типы().Количество() > 1 Тогда
		
		СписокТипов = Новый СписокЗначений;
		СписокТипов.ЗагрузитьЗначения(ТипЗначения.Типы());
		
		Оповещение = Новый ОписаниеОповещения("ЗначениеНачалоВыбора",  ЭтотОбъект, ДопПараметры);
		
		ПоказатьВыборИзСписка(Оповещение, СписокТипов, Элемент); 
				
	КонецЕсли;
	
	ОткрытьФормуВыбора(Элемент, ДопПараметры);

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОтбораПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТипЗначения = Элементы.ТаблицаОтбора.ТекущиеДанные.ТипЗначения;
	Элемент.ПодчиненныеЭлементы.ТаблицаОтбораЗначение.ОграничениеТипа = ТипЗначения;
	ЭлементПодобно = Элемент.ПодчиненныеЭлементы.ТаблицаОтбораВидСравнения.СписокВыбора.НайтиПоЗначению("Подобно");
	
	Если НЕ ТипЗначения.СодержитТип(Тип("Строка")) Тогда
		Если ЭлементПодобно<>Неопределено Тогда
			Элемент.ПодчиненныеЭлементы.ТаблицаОтбораВидСравнения.СписокВыбора.Удалить(ЭлементПодобно);
		КонецЕсли;
	Иначе
		Если ЭлементПодобно=Неопределено Тогда
			Элемент.ПодчиненныеЭлементы.ТаблицаОтбораВидСравнения.СписокВыбора.Добавить("Подобно","Содержит");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОтбораЗначениеПриИзменении(Элемент)
	ТекДанные = Элементы.ТаблицаОтбора.ТекущиеДанные;
	ТекДанные.Использовать = ЗначениеЗаполнено(ТекДанные.Значение); 
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыТаблицаИндивидуальногоОтбора

&НаКлиенте
Процедура ТаблицаИндивидуальногоОтбораЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВыбранныйТип = Неопределено;
	
	ТекстЗаголовка = Элементы.ТаблицаИндивидуальногоОтбора.ТекущиеДанные.ИмяНастройки; 
	
	ТипЗначения = Элементы.ТаблицаИндивидуальногоОтбора.ТекущиеДанные.ТипЗначения;
	
	НачЗначение = Элементы.ТаблицаИндивидуальногоОтбора.ТекущиеДанные.Значение;
	
	ТекДанные = Элементы.ТаблицаИндивидуальногоОтбора.ТекущиеДанные; 
	
	ДопПараметры = Новый Структура("ВыбранныйТип, ТипЗначения, НачЗначение, ТекстЗаголовка, ТекДанные, Элемент", ВыбранныйТип, ТипЗначения, НачЗначение, ТекстЗаголовка, ТекДанные, Элемент);
	
	Если ТипЗначения.Типы().Количество() > 1 Тогда
		
		СписокТипов = Новый СписокЗначений;
		СписокТипов.ЗагрузитьЗначения(ТипЗначения.Типы());
		
		Оповещение = Новый ОписаниеОповещения("ЗначениеНачалоВыбора",  ЭтотОбъект, ДопПараметры);
		
		ПоказатьВыборИзСписка(Оповещение, СписокТипов, Элемент); 
				
	КонецЕсли;
	
	ОткрытьФормуВыбора(Элемент, ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИндивидуальногоОтбораПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТипЗначения = Элементы.ТаблицаИндивидуальногоОтбора.ТекущиеДанные.ТипЗначения;
	Элемент.ПодчиненныеЭлементы.ТаблицаИндивидуальногоОтбораЗначение.ОграничениеТипа = ТипЗначения;
	ЭлементПодобно = Элемент.ПодчиненныеЭлементы.ТаблицаИндивидуальногоОтбораЗначение.СписокВыбора.НайтиПоЗначению("Подобно");
	
	Если НЕ ТипЗначения.СодержитТип(Тип("Строка")) Тогда
		Если ЭлементПодобно<>Неопределено Тогда
			Элемент.ПодчиненныеЭлементы.ТаблицаИндивидуальногоОтбораЗначение.СписокВыбора.Удалить(ЭлементПодобно);
		КонецЕсли;
	Иначе
		Если ЭлементПодобно=Неопределено Тогда
			Элемент.ПодчиненныеЭлементы.ТаблицаИндивидуальногоОтбораЗначение.СписокВыбора.Добавить("Подобно","Содержит");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИндивидуальногоОтбораЗначениеПриИзменении(Элемент)
	ТекДанные = Элементы.ТаблицаИндивидуальногоОтбора.ТекущиеДанные;
	ТекДанные.Использовать = ЗначениеЗаполнено(ТекДанные.Значение);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СнятьПометкиОО(Команда)
	УстановитьСнятьФлажки(ТаблицаОбщегоОтбора,Ложь);
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометкиИО(Команда)
	УстановитьСнятьФлажки(ТаблицаИндивидуальногоОтбора.ПолучитьЭлементы(),Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкиОО(Команда)
	УстановитьСнятьФлажки(ТаблицаОбщегоОтбора,Истина);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкиИО(Команда)
	УстановитьСнятьФлажки(ТаблицаИндивидуальногоОтбора.ПолучитьЭлементы(),Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	ПараметрыЗакрытияФормы = Новый Структура("ДатаНачала, ДатаОкончания, АдресТаблицыОтбора", 
	Период.ДатаНачала, Период.ДатаОкончания, СформироватьТаблицуОтборов());
	
	Закрыть(ПараметрыЗакрытияФормы);

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗначениеНачалоВыбора(ВыбранныйЭлемент, ДопПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда  
		Возврат;
	КонецЕсли;	
	
	ДопПараметры.ВыбранныйТип = ВыбранныйЭлемент.Значение;
	
	ОткрытьФормуВыбора(ДопПараметры.Элемент, ДопПараметры);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОткрытьФормуВыбора(Элемент, ДопПараметры)
	
	ТипЗначения 	= ДопПараметры.ТипЗначения;
	ВыбранныйТип 	= ДопПараметры.ВыбранныйТип;
	НачЗначение 	= ДопПараметры.НачЗначение;
	ТекстЗаголовка 	= ДопПараметры.ТекстЗаголовка;
		
	Если ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЛицевыеСчета"))
		И (Тип("СправочникСсылка.ЛицевыеСчета") = ВыбранныйТип ИЛИ ВыбранныйТип = Неопределено) Тогда
		ПараметрыФормы = Новый Структура("Отбор",Новый Структура("Владелец",Организация));
		
		ОткрытьФорму("Справочник.ЛицевыеСчета.ФормаВыбора",ПараметрыФормы,Элемент);
		
	ИначеЕсли ТипЗначения.СодержитТип(Тип("СправочникСсылка.Сотрудники")) 
		И (Тип("СправочникСсылка.Сотрудники") = ВыбранныйТип ИЛИ ВыбранныйТип = Неопределено) Тогда
		ПараметрыФормы = Новый Структура("Отбор",Новый Структура("Владелец",Организация));
		
		ОткрытьФорму("Справочник.Сотрудники.ФормаВыбора",ПараметрыФормы,Элемент);
		
	ИначеЕсли ТипЗначения.СодержитТип(Тип("СправочникСсылка.РеквизитыЛицевыхСчетов"))
