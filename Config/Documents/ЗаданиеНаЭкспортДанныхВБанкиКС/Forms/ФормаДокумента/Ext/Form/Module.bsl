&НаСервере
Процедура ЗаполнениеТабличнойЧастиСервер()
	
	Если ЭтоАдресВременногоХранилища(АдресНастроекОтбора) Тогда
		ТаблицаДопНастроек = ПолучитьИзВременногоХранилища(АдресНастроекОтбора);
	Иначе
		ТаблицаДопНастроек = Неопределено;
    КонецЕсли;
		
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьТабличнуюЧастьОбъектыОбмена(ТаблицаДопНастроек);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьПроведение()

	ЗаданиеНаЭкспорт = РеквизитФормыВЗначение("Объект");	
	Попытка
		ЗаданиеНаЭкспорт.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось отменить проведение документа'"));
		Возврат;
	КонецПопытки;
	ЗначениеВРеквизитФормы(ЗаданиеНаЭкспорт, "Объект");	

КонецПроцедуры

&НаСервере
Процедура ФормированиеФайловЭкспорта()
	
	ЗаданиеНаЭкспорт = РеквизитФормыВЗначение("Объект");
	Если Элементы.ПараметрыИмениФайла.ПодчиненныеЭлементы.Количество()>0 Тогда
		Для Каждого СтрокаТЧ Из ЗаданиеНаЭкспорт.ПроизвольныеПараметры Цикл
			Значение = "";
			Попытка 
				Значение = ЭтаФорма["ПолеТЧ"+СтрокаТЧ.НомерСтроки];
			Исключение
				Значение = "";
			КонецПопытки;
			СтрокаТЧ.Значение = Значение;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗаданиеНаЭкспорт.Ссылка.Пустая() Тогда
		Попытка
			ЗаданиеНаЭкспорт.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось записать документ'"));
			Возврат;
		КонецПопытки;	
	КонецЕсли;	
	
	
	ЗаданиеНаЭкспорт.УдалитьВсеПодчиненныйФайлы();
	//-------------------------------------------------
	

	ОбработкаОбмена = Справочники.ТипыОбменаБанкиКС.ПолучитьОбработку(ЗаданиеНаЭкспорт.ВидОбмена);
	Если ОбработкаОбмена = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	
	//-------------------------------------------------
	//преобразование сведений об ошибках  
	
	ОбработкаОбмена.СформироватьФайлы(ЗаданиеНаЭкспорт);
		
	Для каждого СтрокаВыгрузки Из ЗаданиеНаЭкспорт.ОбъектыОбмена Цикл
		
		Если ЗначениеЗаполнено(СтрокаВыгрузки.ОписаниеОшибки) Тогда
			 СтрокаВыгрузки.Описание 	= "Подробно...";			 
		Иначе
			 СтрокаВыгрузки.Описание = "";
		КонецЕсли; 
		 
	КонецЦикла;
	Попытка
		ЗаданиеНаЭкспорт.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось записать документ'"));
		Возврат;
	КонецПопытки;
	ЗначениеВРеквизитФормы(ЗаданиеНаЭкспорт, "Объект");
КонецПроцедуры

