&НаСервере
Процедура ПоходНаСерверДляПерерисовкиФормы()
	//Для Вебклиента	
КонецПроцедуры 

&НаСервере
Функция ПредставлениеВНомереВерссии()
	
	Если ЗначениеЗаполнено(Объект.ВидОбмена) Тогда
		Возврат Объект.ВидОбмена.ПредставлениеВНомереВерсии;
	КонецЕсли; 
	
	Возврат "";   
	
КонецФункции	

&НаКлиенте
Процедура ОпределитьВидимостьКоманд()
	
	Если Объект.ОбъектыОбмена.Количество() > 0 Тогда
		
	    Элементы.СформироватьФайлы.Доступность    = Истина И НЕ ЭтаФорма.ТолькоПросмотр;
		 
		МассивФайлов 	= ЭкспортФайлов.ПолучитьПрикрепленныеФайлыЗаданияНаЭкспорт(Объект.Ссылка);
		Если МассивФайлов.Количество() > 0 Тогда	
			 Элементы.ОтправитьФайлы.Доступность  = Истина И НЕ ЭтаФорма.ТолькоПросмотр;
			 Элементы.ЗагрузитьОтвет.Доступность  = Истина И НЕ ЭтаФорма.ТолькоПросмотр;
		Иначе
			 Элементы.ОтправитьФайлы.Доступность  = Ложь;
			 Элементы.ЗагрузитьОтвет.Доступность  = Ложь;
		КонецЕсли; 
		 
	Иначе	
	     Элементы.СформироватьФайлы.Доступность   = Ложь;
		 Элементы.ОтправитьФайлы.Доступность      = Ложь;
		 Элементы.ЗагрузитьОтвет.Доступность  	  = Ложь;
	КонецЕсли;  
	 
	#Если ВебКлиент Тогда
	//выгрузка файлов нужна только для уфэбс и без веба
	Элементы.Подписать.Видимость            = Ложь;
	Элементы.Подписать.Доступность          = Ложь;	 
	
	Элементы.ЗаполнитьФайлами.Видимость     = Ложь;  
	Элементы.ЗаполнитьФайлами.Доступность   = Ложь; 
	
	//настройка видимости элементов табличной части
	Элементы.ОбъектыОбменаОбъект.Видимость   = Истина;
	Элементы.ОбъектыОбменаОбъект.Доступность = Истина;
	
	Элементы.ОбъектыОбменаФайл.Видимость     = Ложь;
	Элементы.ОбъектыОбменаФайл.Доступность   = Ложь;
	
	#Иначе
	ТекНомерВерсии = ПредставлениеВНомереВерссии();
	Элементы.Подписать.Видимость             = ?(ТекНомерВерсии = "UFBS", Истина, Ложь);
	Элементы.Подписать.Доступность           = ?(ТекНомерВерсии = "UFBS", Истина, Ложь);  
	
	Элементы.ЗаполнитьФайлами.Видимость      = ?(ТекНомерВерсии = "UFBS", Истина, Ложь);  
	Элементы.ЗаполнитьФайлами.Доступность    = ?(ТекНомерВерсии = "UFBS", Истина, Ложь); 
	
	ВидимостьФайла                           = Ложь;
	
	Если ТекНомерВерсии = "UFBS" И Объект.ОбъектыОбмена.Количество()>0 Тогда
		Если ЗначениеЗаполнено(Объект.ОбъектыОбмена[0].Файл) Тогда    
			 ВидимостьФайла                  = Истина;
		КонецЕсли;	
	КонецЕсли; 
	
	//настройка видимости элементов табличной части
	Элементы.ОбъектыОбменаОбъект.Видимость   = НЕ ВидимостьФайла;
	Элементы.ОбъектыОбменаОбъект.Доступность = НЕ ВидимостьФайла;
	
	Элементы.ОбъектыОбменаФайл.Видимость     = ВидимостьФайла;
	Элементы.ОбъектыОбменаФайл.Доступность   = ВидимостьФайла;
	
	#КонецЕсли
		
КонецПроцедуры           
 
