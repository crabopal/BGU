// Переменные, необходимые для использования внешней обработки

&НаКлиенте
Перем ПараметрыОбработчика;

&НаКлиенте
Перем ВыполняемаяКоманда;

&НаКлиенте
Перем ПутьКПрограмме;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ОбщегоНазначенияБГУ.УстановитьНедоступныеЭлементыФормы(Элементы, Объект, "СформироватьФайлы"
																			+",ОтправитьФайлы"
																			+",ЗагрузитьОтвет"
																			+",Заполнить"
																			+",УстановитьПериод");	 
	
	Если Параметры.Ключ.Пустая() Тогда //Новый документ
		Если Параметры.ЗначениеКопирования.Пустая() Тогда
			ЗаполнитьЗначенияСвойств(Объект, ПолучитьНастройкиОбменаПоУмолчанию(Объект.Организация));
			Если Объект.НастройкаОбмена.СпособОбмена = Перечисления.СпособыВыгрузкиФайловПередачи.Каталог Тогда 
				Объект.КаталогВыгрузки = Объект.НастройкаОбмена.ПутьВыгрузкиПоУмолчанию;
			КонецЕсли;
		КонецЕсли;
		Объект.ДатаНач 	= НачалоДня(ТекущаяДатаСеанса());
		Объект.ДатаКон 	= КонецДня(ТекущаяДатаСеанса());
		Объект.Дата 	= ТекущаяДатаСеанса();
	КонецЕсли;	
		
	Команда 			= ЭтаФорма.Команды.Добавить("ПерейтиКФормеФайла");
	Команда.Действие 	= "Подключаемый_ПерейтиКФормеФайла";
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Файлы, "ВладелецФайла", Объект.Ссылка);
	
	ЦветПоясняющейНадписи = ЦветаСтиля.ПоясняющийТекст;
	ЦветОшибки = ЦветаСтиля.ПоясняющийОшибкуТекст;
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
		
	Если Параметры.Ключ.Пустая() И Параметры.ЗначениеКопирования.Пустая() Тогда //Новый документ
		ВыполнитьДействияНаСервере(Истина);
	Иначе
		ВыполнитьДействияНаСервере(Ложь);
	КонецЕсли;
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом   
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьНадписи();	
	ОпределитьВидимостьКоманд();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = ЭтаФорма Тогда
		Если ИмяСобытия = "ВыбранаНастройкаОбменаБанкиКС" Тогда
			ЗаполнитьЗначенияСвойств(Объект, Параметр);
			ОбновитьНадписи();
			ПроверитьОбъектыОбмена();
			
			ВыполнитьДействияНаСервере(Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// СтандартныеПодсистемы.ДатыЗапретаИзменения   
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Для Каждого СтрокаТЧ Из ТекущийОбъект.ПроизвольныеПараметры Цикл
		Значение = "";
		Если ПараметрыЗаписи.Свойство("ПолеТЧ"+СтрокаТЧ.НомерСтроки,Значение) Тогда
			СтрокаТЧ.Значение = Значение;
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Для Каждого ДопЭлемент Из Элементы.ПараметрыИмениФайла.ПодчиненныеЭлементы Цикл
		ПараметрыЗаписи.Вставить(Сред(ДопЭлемент.Имя,5),ЭтаФорма[Сред(ДопЭлемент.Имя,5)]);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)       
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	Оповестить("Запись_ЗаданиеНаЭкспортДанныхВБанкиКС", ПараметрыЗаписи, Объект.Ссылка);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидОбменаПриИзменении(Элемент)
	
	Массив = Новый Массив;
	
	Если ЗначениеЗаполнено(Объект.ВидОбмена) Тогда
		ТипКО = ТипКассовогоОрганаВидаОбмена(Объект.ВидОбмена);
	Иначе
		ТипКО = "";
		Объект.КассовыйОрган = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипКО) Тогда
		Массив.Добавить(Тип(ТипКО));
	Иначе
		Массив.Добавить(Тип("СправочникСсылка.Банки"));
		Массив.Добавить(Тип("СправочникСсылка.Казначейства"));
	КонецЕсли;
	
	ОписаниеТипов  	               = Новый ОписаниеТипов(Массив);
	Объект.КассовыйОрган           = ОписаниеТипов.ПривестиЗначение(Объект.КассовыйОрган);
	
	Элементы.КассовыйОрган.ДоступныеТипы   = ОписаниеТипов;
	Элементы.КассовыйОрган.ОграничениеТипа = ОписаниеТипов; 
	
	#Если ВебКлиент Тогда
	//выгрузка файлов нужна только для уфэбс и без веба
	Элементы.Подписать.Видимость            = Ложь;
	Элементы.Подписать.Доступность          = Ложь;	 
	
	Элементы.ЗаполнитьФайлами.Видимость     = Ложь;  
	Элементы.ЗаполнитьФайлами.Доступность   = Ложь; 
	
	//настройка видимости элементов табличной части
	Элементы.ОбъектыОбменаОбъект.Видимость   = Истина;
	Элементы.ОбъектыОбменаОбъект.Доступность = Истина;
	
	Элементы.ОбъектыОбменаФайл.Видимость     = Ложь;
	Элементы.ОбъектыОбменаФайл.Доступность   = Ложь;
	
	#Иначе
	ТекНомерВерсии = ПредставлениеВНомереВерссии();
	Элементы.Подписать.Видимость             = ?(ТекНомерВерсии = "UFBS", Истина, Ложь);
	Элементы.Подписать.Доступность           = ?(ТекНомерВерсии = "UFBS", Истина, Ложь);  
	
	Элементы.ЗаполнитьФайлами.Видимость      = ?(ТекНомерВерсии = "UFBS", Истина, Ложь);  
	Элементы.ЗаполнитьФайлами.Доступность    = ?(ТекНомерВерсии = "UFBS", Истина, Ложь); 
	
	ВидимостьФайла                           = Ложь;
	
	Если ТекНомерВерсии = "UFBS" И Объект.ОбъектыОбмена.Количество()>0 Тогда
		Если ЗначениеЗаполнено(Объект.ОбъектыОбмена[0].Файл) Тогда    
			 ВидимостьФайла                  = Истина;
		КонецЕсли;	
	КонецЕсли; 
	
	//настройка видимости элементов табличной части
	Элементы.ОбъектыОбменаОбъект.Видимость   = НЕ ВидимостьФайла;
	Элементы.ОбъектыОбменаОбъект.Доступность = НЕ ВидимостьФайла;
	
	Элементы.ОбъектыОбменаФайл.Видимость     = ВидимостьФайла;
	Элементы.ОбъектыОбменаФайл.Доступность   = ВидимостьФайла;
	
	#КонецЕсли

	Объект.ОбъектыОбмена.Очистить();
	
	ВыполнитьДействияНаСервере(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОбменаПриИзменении(Элемент)
	
	ВыполнитьДействияНаСервере(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУстановкеРасширенияРаботыСФайлами", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьВопросОбУстановкеРасширенияРаботыСФайлами(Оповещение,, Истина);
	
	//Если ОбщегоНазначенияКлиент.ПредложитьУстановкуРасширенияРаботыСФайлами() = "Подключено" Тогда				
	//	СтандартнаяОбработка = Ложь;
	//	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	//	ДиалогВыбора.Каталог = Объект.КаталогВыгрузки;
	//	Если ДиалогВыбора.Выбрать() Тогда
	//		Объект.КаталогВыгрузки = ДиалогВыбора.Каталог;
	//		ЭтаФорма.Модифицированность = Истина;
	//	КонецЕсли;	
	//КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбУстановкеРасширенияРаботыСФайлами(РасширениеПодключено, ДополнительныеПараметры) Экспорт
	
	Если РасширениеПодключено Тогда
		СтандартнаяОбработка = Ложь;
		ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
		ДиалогВыбора.Каталог = Объект.КаталогВыгрузки;
		ДиалогВыбора.Показать(Новый ОписаниеОповещения("ПослеВопросаОбУстановкеРасширенияРаботыСФайламиЗавершение", ЭтотОбъект, Новый Структура("ДиалогВыбора", ДиалогВыбора)));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбУстановкеРасширенияРаботыСФайламиЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если (ВыбранныеФайлы <> Неопределено) Тогда
		ДиалогВыбора = ДополнительныеПараметры.ДиалогВыбора;
		Объект.КаталогВыгрузки = ДиалогВыбора.Каталог;
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ВыполнитьДействияПриИзмененииОрганизации();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Объект.Организация <> ВыбранноеЗначение И Объект.ОбъектыОбмена.Количество() > 0 Тогда 
		
		СтандартнаяОбработка = Ложь;

		ПоказатьВопрос(Новый ОписаниеОповещения("ОрганизацияОбработкаВыбораЗавершение", ЭтотОбъект, Новый Структура("ВыбранноеЗначение", ВыбранноеЗначение)),
			НСтр("ru='При изменении организации список объектов обмена будет очищен.
			|Продолжить с очисткой списка объектов?'"), РежимДиалогаВопрос.ДаНет, 5, КодВозвратаДиалога.Нет, ,КодВозвратаДиалога.Нет);
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияОбработкаВыбораЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		Объект.Организация = ДополнительныеПараметры.ВыбранноеЗначение;
		Модифицированность = Истина;
		ВыполнитьДействияПриИзмененииОрганизации();
		Объект.ОбъектыОбмена.Очистить();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействияПриИзмененииОрганизации()

	ЗаполнитьЗначенияСвойств(Объект, ПолучитьНастройкиОбменаПоУмолчанию(Объект.Организация, Объект.КассовыйОрган));
	ОпределитьВидимостьКоманд();

КонецПроцедуры // ВыполнитьДействияПриИзмененииОрганизации()
 
&НаКлиенте
Процедура КассовыйОрганОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Тип") И Объект.КассовыйОрган <> ВыбранноеЗначение И Объект.ОбъектыОбмена.Количество() > 0 Тогда
		
		СтандартнаяОбработка = Ложь;
	
		ПараметрыВопроса = Новый Структура("ВыбранноеЗначение", ВыбранноеЗначение);	      	
	    Оповещение = Новый ОписаниеОповещения("КассовыйОрганОбработкаВыбора_ПослеЗакрытия", ЭтаФорма, ПараметрыВопроса);
		ТекстВопроса = НСтр("ru='При изменении кассового органа список объектов обмена будет очищен.
								|Продолжить с очисткой списка объектов?'");	  
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет); 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектыОбменаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "Информация" Тогда
		СтандартнаяОбработка = Ложь;
		
		Если ЗначениеЗаполнено(Элементы.ОбъектыОбмена.ТекущиеДанные.Описание) 
			И Элементы.ОбъектыОбмена.ТекущиеДанные.Описание <> "Операция успешна!" Тогда
		
			ПараметрыФормыОшибок = Новый Структура("СведенияОбОшибках", Элементы.ОбъектыОбмена.ТекущиеДанные.ОписаниеОшибки);
			ОткрытьФорму("Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.Форма.Ошибки", ПараметрыФормыОшибок, ЭтаФорма,,,, Неопределено, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

