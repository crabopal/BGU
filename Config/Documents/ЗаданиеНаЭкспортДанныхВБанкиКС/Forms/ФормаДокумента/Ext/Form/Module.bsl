	Элементы.ОбъектыОбмена.КоманднаяПанель.ПодчиненныеЭлементы.Заполнить.Заголовок = "Заполнить объектами за период: с " + Формат(Объект.ДатаНач, "ДФ=dd.MM.yy") + 
															" по " + Формат(Объект.ДатаКон, "ДФ=dd.MM.yy");
	#Если ВебКлиент Тогда
		//Нужно пойти на сервер для перересовки формы
		ПоходНаСерверДляПерерисовкиФормы();
	#КонецЕсли	
