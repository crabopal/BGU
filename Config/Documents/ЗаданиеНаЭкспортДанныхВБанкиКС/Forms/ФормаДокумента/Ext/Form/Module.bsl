&НаКлиенте
Процедура ОтменитьПроведениеИСформироватьФайлыЭкспорта(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Команда = ДополнительныеПараметры.Команда;
    
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
        ОтменитьПроведение();
    Иначе
        Возврат;		
    КонецЕсли;
    
    СформироватьФайлыЭкспортаФрагмент(Команда);

КонецПроцедуры

&НаКлиенте
Процедура СформироватьФайлыЭкспортаФрагмент(Знач Команда)
    
    Перем ИзменятьСтатус, ТекстСообщения;
    
    Если Объект.ОбъектыОбмена.Количество() = 0 Тогда       
        
        ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не указан ни один объект экспорта'"),, "Заполнить", "Элементы.ОбъектыОбмена.КоманднаяПанель");
        Возврат;
        
    КонецЕсли; 
    
    ФормированиеФайловЭкспорта(); 
    ОповеститьОбИзменении(Тип("СправочникСсылка.ЗаданиеНаЭкспортДанныхВБанкиКСПрисоединенныеФайлы"));
    ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Файлы, "ВладелецФайла", Объект.Ссылка);
    
    ИзменятьСтатус = Истина;
    ТребуетсяПодготовка = Ложь;
	
	Если ПредставлениеВНомереВерсииВидаОбмена(Объект.ВидОбмена)= "GY" Тогда
		// подготовка по формату 1.16.1
		
		Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() Тогда
			ДопПараметры = Новый Структура("Команда",Команда);
						
			Оповещение = Новый ОписаниеОповещения("ПослеПодключенияКомпоненты_Xades2AddIn", ЭтотОбъект,ДопПараметры);
		    ПараметрыПодключения = ОбщегоНазначенияКлиент.ПараметрыПодключенияКомпоненты();
		    ПараметрыПодключения.ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
		                                        |внешняя компонента Xades2AddIn.'");
						
		    ОбщегоНазначенияКлиент.ПодключитьКомпонентуИзМакета(Оповещение, "Xades2AddIn","ОбщийМакет.Компонента_xades", ПараметрыПодключения);
			
			Возврат;
		Иначе
			
			ТребуетсяПодготовка = Истина;
			
			ПерейтиКПодготовкеФайлов(Неопределено, Команда);
			
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ИмяОбщегоМодуляОбработки) Тогда 
		 
		Если ВРег(ИмяОбщегоМодуляОбработки) = ВРег("Госуслуги") Тогда
			КонтекстВыполнения = Новый Структура;
			КонтекстВыполнения.Вставить("Результат",Истина);
			КонтекстВыполнения.Вставить("ЗаданиеНаЭкспортСсылка",Объект.Ссылка);
			КонтекстВыполнения.Вставить("ПродолжитьПослеПодготовки",Новый ОписаниеОповещения("ПослеФормированияФайлов", ЭтотОбъект, Команда,"ПослеФормированияФайловОшибка",ЭтотОбъект)); //Оповещение
			
			
			ТребуетсяПодготовка = Истина;
			
			ГосУслугиКлиент.НачатьПодготовкуКОтправке(КонтекстВыполнения);
			
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ТребуетсяПодготовка Тогда
    	ПослеФормированияФайлов(Истина,Команда);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияКомпоненты_Xades2AddIn(Результат, ДопПараметры) Экспорт
	
	КомпонентаПодписи = Неопределено;
    Если Результат.Подключено Тогда 
        КомпонентаПодписи = Результат.ПодключаемыйМодуль;    
	Иначе
		
		ТекстОшибки = Результат.ОписаниеОшибки;
        ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		
		ПослеФормированияФайлов(Ложь,ДопПараметры.Команда);
		
		Возврат;
		
	КонецЕсли;
	
	Если КомпонентаПодписи = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не удалось создать компоненту для формирования электронной подписи.'");			
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		ПослеФормированияФайлов(Ложь,ДопПараметры.Команда);
		
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЭтоLinuxКлиент() Тогда
		Если ЗначениеЗаполнено(ПутьКПрограмме) Тогда
			КомпонентаПодписи.Криптопровайдер = ПутьКПрограмме;
		Иначе
			ПерсональныеНастройки = ЭлектроннаяПодписьКлиент.ПерсональныеНастройки();
			
			ДополнительныеПараметры = Новый Структура("СоответствиеПутей",ПерсональныеНастройки.ПутиКПрограммамЭлектроннойПодписиИШифрования);
			ДополнительныеПараметры.Вставить("Команда",ДопПараметры.Команда);
			ДополнительныеПараметры.Вставить("КомпонентаПодписи",КомпонентаПодписи);
			
			ПослеСозданияМК(Неопределено,ДополнительныеПараметры);
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	
	ПерейтиКПодготовкеФайлов(КомпонентаПодписи,ДопПараметры.Команда);
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияМК(Результат,ДопПараметры)Экспорт
	Если Результат = Неопределено Тогда
		Если ДопПараметры.Свойство("ТекущаяПрограмма") Тогда
			ДопПараметры.СоответствиеПутей.Удалить(ДопПараметры.ТекущаяПрограмма);
		КонецЕсли;
		Для Каждого КлючИЗначение Из ДопПараметры.СоответствиеПутей Цикл
			ДопПараметры.Вставить("ТекущаяПрограмма",КлючИЗначение.Ключ);
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСозданияМК",ЭтотОбъект,ДопПараметры);
			ЭлектроннаяПодписьКлиент.СоздатьМенеджерКриптографии(ОписаниеОповещения,"",Ложь,КлючИЗначение.Ключ);
			Возврат;
		КонецЦикла;
	Иначе
		Результат = Неопределено;
		ПутьКПрограмме = ДопПараметры.СоответствиеПутей[ДопПараметры.ТекущаяПрограмма];
		ДопПараметры.КомпонентаПодписи.Криптопровайдер = ПутьКПрограмме;
	КонецЕсли;
	
	ПерейтиКПодготовкеФайлов(ДопПараметры.КомпонентаПодписи,ДопПараметры.Команда);
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКПодготовкеФайлов(КомпонентаПодписи,Знач Команда)
	
	КонтекстВыполнения = Новый Структура;
	КонтекстВыполнения.Вставить("Результат",Истина);
	КонтекстВыполнения.Вставить("ЗаданиеНаЭкспортСсылка",Объект.Ссылка);
	КонтекстВыполнения.Вставить("ПродолжитьПослеПодготовки", Новый ОписаниеОповещения("ПослеФормированияФайлов", ЭтотОбъект, Команда,"ПослеФормированияФайловОшибка",ЭтотОбъект)); //Оповещение
	КонтекстВыполнения.Вставить("Версия",1.16); // если не задана, то устанавливается 1.15
	КонтекстВыполнения.Вставить("КомпонентаПодписи",КомпонентаПодписи);
	
	ГосУслугиКлиент.НачатьПодготовкуКОтправке(КонтекстВыполнения);
			
КонецПроцедуры


&НаКлиенте
Процедура ПослеФормированияФайлов(Результат,Команда) Экспорт
	
	ЭтаФорма.Прочитать();
	ИзменятьСтатус = Результат;
	
	Если НЕ ИзменятьСтатус Тогда
        УдалитьПодчиненныеФайлы();
        ТекстСообщения = НСтр("ru='Не удалось подготовить файлы к отправке!'");
        ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);	
	КонецЕсли;
	
	Оповестить("Запись_ЗаданиеНаЭкспортДанныхВБанкиКС", , Объект.Ссылка);
    
    ОпределитьВидимостьКоманд();
    
    Если Элементы.ОтправитьФайлы.Доступность  = Истина И НЕ ЭтаФорма.ТолькоПросмотр Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("СформироватьФайлыЭкспортаЗавершение", ЭтотОбъект, Новый Структура("Команда", Команда));
		
        ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'В ходе выгрузки были сформированы файлы передачи. 
        |               Отправить файлы?'"), РежимДиалогаВопрос.ДаНет);
        
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеФормированияФайловОшибка(ИнформацияОбОшибке,СтандартнаяОбработка,ДопПараметр) Экспорт
	
	ЭтаФорма.Прочитать();
	СтандартнаяОбработка = Ложь;
	
	ТекстСообщения = НСтр("ru='"+ИнформацияОбОшибке.Описание+"'");
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	
	УдалитьПодчиненныеФайлы();
    ТекстСообщения = НСтр("ru='Не удалось подготовить файлы к отправке!'");
    ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	
	ОпределитьВидимостьКоманд();
КонецПроцедуры

&НаКлиенте
Процедура СформироватьФайлыЭкспортаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Команда = ДополнительныеПараметры.Команда;
    
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
        ОтправитьФайлы(Команда);
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СформироватьИПодготовитьФайлы(РезультатОтвета,ДопольнительныеПараметры) Экспорт
	Если РезультатОтвета<> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ГосУслугиКлиент.ПолучитьСледующуюПорциюДанных(Объект.Ссылка,Объект.НастройкаОбмена,ЭтотОбъект.УникальныйИдентификатор);
	ЭтаФорма.Прочитать();	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьОтветСервер()
	Возврат Документы.ЗаданиеНаИмпортДанныхБанкиКС.СформироватьЗаданиеНаИмпорт(Объект.Ссылка,ЭтаФорма.УникальныйИдентификатор);
КонецФункции

&НаСервере
Процедура УдалитьПодчиненныеФайлы()
	Задание = РеквизитФормыВЗначение("Объект");
	Задание.УдалитьВсеПодчиненныйФайлы();
	ЗначениеВРеквизитФормы(Задание,"Объект");
КонецПроцедуры

&НаСервере
Функция ПолучитьТекстовыйДокументСОтветом(ИндексСтроки)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ОтветИзСервиса = ТекОбъект.ОбъектыОбмена[ИндексСтроки].ОтветWebСервиса.Получить();
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ОтветИзСервиса);
	Возврат ТекстовыйДокумент;
		
КонецФункции

&НаСервере
Функция ПолучитьТекстПротокола(ИндексСтроки)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	СтрокаТЧ = ТекОбъект.ОбъектыОбмена[ИндексСтроки];
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Файлы.Ссылка КАК ФайлЗапроса,
				   |	Файлы.Наименование + ""."" + Файлы.Расширение КАК ИмяФайла
	               |ИЗ
	               |	Справочник.ЗаданиеНаЭкспортДанныхВБанкиКСПрисоединенныеФайлы КАК Файлы
	               |ГДЕ
	               |	Файлы.ВладелецФайла = &Ссылка
	               |	И Файлы.Наименование + ""."" + Файлы.Расширение = &ИмяФайлаВыгрузки";
	Запрос.УстановитьПараметр("Ссылка", ТекОбъект.Ссылка);
	Запрос.УстановитьПараметр("ИмяФайлаВыгрузки", СтрокаТЧ.ИмяФайлаВыгрузки);
	
	Выборка = Запрос.Выполнить().Выбрать();			   
	
	Если Выборка.Следующий() Тогда
		
		ОтветИзСервиса = СтрокаТЧ.ОтветWebСервиса.Получить();
		Возврат СформироватьТекстПротокола(Выборка,ОтветИзСервиса);
						
	Иначе
		
		ОтветИзСервиса = ЭкспортФайлов.РазобратьОтветИзСервиса(СтрокаТЧ.ОтветWebСервиса);			

	    Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
           |	Файлы.Ссылка КАК ФайлЗапроса,
		   |	Файлы.Наименование + ""."" + Файлы.Расширение КАК ИмяФайла
           |ИЗ
           |	Справочник.ЗаданиеНаЭкспортДанныхВБанкиКСПрисоединенныеФайлы КАК Файлы
           |ГДЕ
           |	Файлы.ВладелецФайла = &Ссылка
           |	И Файлы.Наименование + ""."" + Файлы.Расширение В (&МассивИменФайлов)";
				   
		Запрос.УстановитьПараметр("Ссылка", ТекОбъект.Ссылка);
		МассивИменФайлов = ОтветИзСервиса.ВыгрузитьКолонку("ИмяФайла");
		Запрос.УстановитьПараметр("МассивИменФайлов", МассивИменФайлов);
	
		Выборка = Запрос.Выполнить().Выбрать();
		Результат = "";
		Для Каждого СтрТЧ Из ОтветИзСервиса Цикл
			Если ЗначениеЗаполнено(СтрТЧ.ИмяФайла) Тогда
				Выборка.Сбросить();
				Если Выборка.НайтиСледующий(Новый Структура("ИмяФайла",СтрТЧ.ИмяФайла)) Тогда
					Результат = Результат + СформироватьТекстПротокола(Выборка,СтрТЧ.Ответ);
					Результат = Результат + "
					|
					|////////////////////////////////////////////////////////////////////////////////
					|"
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Возврат Результат;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СформироватьТекстПротокола(СтрокаВыборки,Ответ)
	
	Если ЗначениеЗаполнено(СтрокаВыборки.ФайлЗапроса) Тогда
		ДвочныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(СтрокаВыборки.ФайлЗапроса);
		ВременныйФайл = ПолучитьИмяВременногоФайла();
		ДвочныеДанные.Записать(ВременныйФайл);
		ДвочныеДанные = Неопределено;
		
		ЧтениеТекста = Новый ЧтениеТекста(ВременныйФайл);
		ТекстЗапроса = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();		
		ЧтениеТекста = Неопределено;
		
		УдалитьФайлы(ВременныйФайл);
	Иначе
		ТекстЗапроса = "";
	КонецЕсли;
	
	Результат = "
				|Файл: " + СтрокаВыборки.ИмяФайла + "
				|
				|" + ТекстЗапроса + "
				|
				|////////////////////////////////////////////////////////////////////////////////
				|
				|Ответ web-сервиса:
				|
				|" + Ответ;
	
	Возврат Результат;
	
КонецФункции

