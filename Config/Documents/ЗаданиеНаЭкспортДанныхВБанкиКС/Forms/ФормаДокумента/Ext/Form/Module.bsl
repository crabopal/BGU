Функция ПолучитьНастройкиОбменаПоУмолчанию(Организация, КассовыйОрган = Неопределено)
	
	Возврат РегистрыСведений.НастройкиОбменаБанкиКСПоУмолчанию.ПолучитьОсновнуюНастройкуОбменаОрганизации(Организация, КассовыйОрган);
	
КонецФункции	

&НаСервере
Процедура УстановитьВидимостьЕдиногоФайла()
	ЗначениеЕФ = Ложь;
	
	Для Каждого СтрТЧ ИЗ Объект.ВидОбмена.ИмяФайлаПередачи Цикл
		Если Найти(НРег(СтрТЧ.Значение),НРег("ИмяЕдиногоФайла"))>0 Тогда
			ЗначениеЕФ = Истина;
			Прервать;
		КонецЕсли;		
	КонецЦикла;
	
	Элементы.ИмяЕдиногоФайла.Видимость = ЗначениеЕФ;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЗагрузитьОтвет()
	
	ВыгрузкаЧерезWebСервис = Объект.НастройкаОбмена.СпособОбмена = Перечисления.СпособыВыгрузкиФайловПередачи.WebСервис;
	Элементы.ЗагрузитьОтвет.Видимость = ВыгрузкаЧерезWebСервис;
	Массив = Новый Массив;
	Массив.Добавить("ИмяОбщегоМодуляОбработки");
	ДанныеПараметров = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(Массив,Объект.НастройкаОбмена);
	ИмяОбщегоМодуляОбработки = ДанныеПараметров.Получить("ИмяОбщегоМодуляОбработки");

КонецПроцедуры

&НаСервере
Процедура ВыполнитьДействияНаСервере(ПерезаполнятьПроизвольныеПараметры = Ложь)
	
	ЭтоКаталог = (Объект.НастройкаОбмена.СпособОбмена = Перечисления.СпособыВыгрузкиФайловПередачи.Каталог);
	
	Элементы.КаталогВыгрузки.Видимость = ЭтоКаталог;
	Если ЭтоКаталог И ПерезаполнятьПроизвольныеПараметры Тогда
		Объект.КаталогВыгрузки = Объект.НастройкаОбмена.ПутьВыгрузкиПоУмолчанию;
	КонецЕсли;
	
	УстановитьВидимостьЕдиногоФайла();
	Если ПерезаполнятьПроизвольныеПараметры Тогда
		Объект.ПроизвольныеПараметры.Очистить();
		Если ЗначениеЗаполнено(Объект.ВидОбмена) Тогда
			Для Каждого ДопПараметр Из Объект.ВидОбмена.ИмяФайлаПередачи Цикл
						
				Если (Найти(Нрег(ДопПараметр.Значение), "задает")   > 0) И
					 (Найти(Нрег(ДопПараметр.Значение), "пользоват") > 0) И
					 (Найти(Нрег(ДопПараметр.Значение), "все")       > 0) Тогда
					
					Строка       = Объект.ПроизвольныеПараметры.Добавить();
					Строка.Имя   = ДопПараметр.ИмяПараметра;
					Строка.Длина = ДопПараметр.ДлинаПараметра;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	СформироватьДополнительныеРеквизиты();
	УстановитьВидимостьЗагрузитьОтвет();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОбъектыОбмена()
	
	Если Объект.ОбъектыОбмена.Количество() > 0 Тогда
		
		Если ЗначениеЗаполнено(Объект.ВидОбмена) Тогда
			
			Если ПолучитьВидОбменаИзТабличнойЧасти(Объект.ОбъектыОбмена[0].Формат) <> Объект.ВидОбмена Тогда		
				Объект.ОбъектыОбмена.Очистить();		
			КонецЕсли; 
			
		Иначе		
			Объект.ОбъектыОбмена.Очистить();		
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДополнительныеРеквизиты()
	
	ДобавляемыеРеквизиты = Новый Массив;
	УдаляемыеРеквизиты = Новый Массив;
	Для Каждого ДопЭлемент Из Элементы.ПараметрыИмениФайла.ПодчиненныеЭлементы Цикл
		УдаляемыеРеквизиты.Добавить(ДопЭлемент.ПутьКДанным);	
	КонецЦикла;
	Результат = Новый ДеревоЗначений;
	
	// общие для группы и элемента
	
	Результат.Колонки.Добавить("ИмяДляФормулы");  
	Результат.Колонки.Добавить("Заголовок");
	Результат.Колонки.Добавить("РастягиватьПоГоризонтали");
	Результат.Колонки.Добавить("ТипЭлемента");
	Результат.Колонки.Добавить("ВидЭлемента");
	
	// реквизиты элемента
	Результат.Колонки.Добавить("ТипЗначения");
	Результат.Колонки.Добавить("Реквизит");
	Результат.Колонки.Добавить("ПоложениеЗаголовка");
	Результат.Колонки.Добавить("ШиринаЭлемента");				

	ОписаниеБулевого = Новый ОписаниеТипов("Булево");
	Для Каждого СтрокаТЧ Из Объект.ПроизвольныеПараметры Цикл
		СтрокаДерева = Результат.Строки.Добавить();
	
		СтрокаДерева.ИмяДляФормулы = "ПолеТЧ"+СтрокаТЧ.НомерСтроки;
		СтрокаДерева.Заголовок   = СтрокаТЧ.Имя;
		СтрокаДерева.ТипЭлемента = Тип("ПолеФормы");
		СтрокаДерева.РастягиватьПоГоризонтали =	Ложь;
		СтрокаДерева.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
		СтрокаДерева.ВидЭлемента = ВидПоляФормы.ПолеВвода;
		СтрокаДерева.ШиринаЭлемента = 0;
										 
		СтрокаДерева.ТипЗначения = Тип("Строка");
		СтрокаДерева.Реквизит =	"ПолеТЧ"+СтрокаТЧ.НомерСтроки;
		СтрокаДерева.ПоложениеЗаголовка =	ПоложениеЗаголовкаЭлементаФормы.Авто;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПолеТЧ"+СтрокаТЧ.НомерСтроки,
														Новый ОписаниеТипов("Строка",Новый КвалификаторыСтроки(СтрокаТЧ.Длина)),
													    "",
													  СтрокаТЧ.Имя,
													  Ложь));

	КонецЦикла;	
	
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты,УдаляемыеРеквизиты);
	
	ДобавитьЭлементыНаФорму(Результат.Строки);
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыНаФорму(ДеревоРеквизитов)
	ПолеДляРеквизитов = Элементы.ПараметрыИмениФайла;
    ПрефиксЭлементовОперации = "Доп_";
    Для каждого НовыйРеквизит Из ДеревоРеквизитов Цикл
    	НовЭлемент = ЭтаФорма.Элементы.Найти(ПрефиксЭлементовОперации+НовыйРеквизит.ИмяДляФормулы);
    	Если НовЭлемент = Неопределено Тогда
    		НовЭлемент = ЭтаФорма.Элементы.Добавить(ПрефиксЭлементовОперации+НовыйРеквизит.ИмяДляФормулы,
    											 Тип("ПолеФормы"),
    											 ПолеДляРеквизитов);
    		НовЭлемент.ПутьКДанным = ""+НовыйРеквизит.ИмяДляФормулы;
    	КонецЕсли;
    	
		НовЭлемент.Заголовок = НовыйРеквизит.Заголовок;
		НовЭлемент.Вид = НовыйРеквизит.ВидЭлемента;
		НовЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
		НовЭлемент.ЦветФона = Новый Цвет(225,225,225);
		//НовЭлемент.УстановитьДействие("ПриИзменении","Подключаемый_ПриИзмененииДопРеквизита");
		Если НовыйРеквизит.ВидЭлемента = ВидПоляФормы.ПолеВвода Тогда

			НовЭлемент.РастягиватьПоГоризонтали = НовыйРеквизит.РастягиватьПоГоризонтали;
			НовЭлемент.Ширина	= НовыйРеквизит.ШиринаЭлемента;
		КонецЕсли;
    	НовЭлемент.ТолькоПросмотр = Ложь;
	КонецЦикла;
	Для Каждого СтрокаТЧ Из Объект.ПроизвольныеПараметры Цикл
		ЭтаФорма["ПолеТЧ"+СтрокаТЧ.НомерСтроки] = СтрокаТЧ.Значение;	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КассовыйОрганОбработкаВыбора_ПослеЗакрытия(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ОбъектыОбмена.Очистить();
	
	Объект.КассовыйОрган = Параметры.ВыбранноеЗначение;
	ЗаполнитьЗначенияСвойств(Объект, ПолучитьНастройкиОбменаПоУмолчанию(Объект.Организация, Объект.КассовыйОрган));
	ОпределитьВидимостьКоманд();
	ВыполнитьДействияНаСервере(Истина);
	
КонецПроцедуры

&НаКлиенте
Функция РеквизитыЗаполненыКорректно()
	
	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.ВидОбмена) Тогда	
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить поле <<Вид обмена>>'"),, "ВидОбмена",, Отказ);	
	КонецЕсли; 
			
	Если Не ЗначениеЗаполнено(Объект.НастройкаФорматов) Тогда	
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить поле <<Настройка форматов>>'"),, "НастройкаФорматов",, Отказ);
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Объект.НастройкаОбмена) Тогда	
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить поле <<Настройка обмена>>'"),, "НастройкаОбмена",, Отказ);	
	КонецЕсли;

	Возврат Не Отказ;
	
КонецФункции

&НаСервере
Процедура ЗаписатьНастройкиПоУмолчанию()
	
	НастройкиПоУмолчанию = РегистрыСведений.НастройкиОбменаБанкиКСПоУмолчанию.СоздатьМенеджерЗаписи();
	
	ЗаполнитьЗначенияСвойств(НастройкиПоУмолчанию, Объект, "Организация,ВидОбмена,КассовыйОрган");	// заполняем ключ записи
	НастройкиПоУмолчанию.Прочитать();	                                                            // читаем запись чтобы получить реквизит "Основная"
	Если НастройкиПоУмолчанию.Выбран() = Ложь Тогда
		 ЗаполнитьЗначенияСвойств(НастройкиПоУмолчанию, Объект, "Организация,ВидОбмена,КассовыйОрган"); 
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(НастройкиПоУмолчанию, Объект, "НастройкаФорматов,НастройкаОбмена");	// заполняем ресурсы записи	 
		
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		НастройкиПоУмолчанию.Записать();
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ошибка записи настроек. ""%1""'"), ОписаниеОшибки());			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
			
КонецПроцедуры

