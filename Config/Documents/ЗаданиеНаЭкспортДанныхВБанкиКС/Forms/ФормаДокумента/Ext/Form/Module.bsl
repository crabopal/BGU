#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьНастройки(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", 			Истина);
	ПараметрыФормы.Вставить("Организация", 			Объект.Организация);
	ПараметрыФормы.Вставить("Отбор", 				Новый Структура("Организация", Объект.Организация));
	ПараметрыФормы.Вставить("КассовыйОрган",		Объект.КассовыйОрган);
	ПараметрыФормы.Вставить("ВидОбмена", 			Объект.ВидОбмена);
	ПараметрыФормы.Вставить("НастройкаОбмена", 		Объект.НастройкаОбмена);
	ПараметрыФормы.Вставить("НастройкаФорматов",	Объект.НастройкаФорматов);
	
	ОткрытьФорму("РегистрСведений.НастройкиОбменаБанкиКСПоУмолчанию.ФормаСписка", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОтвет(Команда)
	
	Если Модифицированность Тогда
		Попытка
			ЭтаФорма.Записать();
		Исключение
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не удалось записать документ'"));
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	ВыполнитьЗагрузкуВнешнейОбработкой = РеквизитЗагружатьОтветВнешнейОбработкой(Объект.НастройкаОбмена);
	
	Если ВыполнитьЗагрузкуВнешнейОбработкой Тогда
	
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Объект.Ссылка);
		
		ПараметрыВыполненияКоманды = Новый Структура("Источник,Окно,Уникальность",ЭтаФорма,Неопределено,Ложь);
		
		ДополнительныеОтчетыИОбработкиКлиент.ОткрытьФормуКомандДополнительныхОтчетовИОбработок(
			МассивОбъектов,
			ПараметрыВыполненияКоманды,
			ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиСозданиеСвязанныхОбъектов()
		);

	Иначе
	
		ЗаданиеНаИмпорт = ЗагрузитьОтветСервер();
		ПараметрыФормы = Новый Структура("Ключ",ЗаданиеНаИмпорт);
		ОткрытьФорму("Документ.ЗаданиеНаИмпортДанныхБанкиКС.Форма.ФормаДокумента",ПараметрыФормы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	ОчиститьСообщения();
	
	// подготовка к заполнению объектов экспорта
	ЕстьОшибкиВЗаполненииНастроек = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ЕстьОшибкиВЗаполненииНастроек = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить поле <<Организация>> в настройках обмена'"),, "Объект.Организация");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.НастройкаФорматов) Тогда
		ЕстьОшибкиВЗаполненииНастроек = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить поле <<Настройка форматов>> в настройках обмена'"),, "Объект.НастройкаФорматов");
	КонецЕсли;

	Если ЕстьОшибкиВЗаполненииНастроек Тогда
		Возврат;
	КонецЕсли;	
		
	Если Объект.ОбъектыОбмена.Количество() > 0 Тогда
		Ответ = Неопределено;

		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект), НСтр("ru = 'Существующие строки документа будут удалены. 
		|Продолжить?'"), РежимДиалогаВопрос.ДаНет);
        Возврат;
	КонецЕсли;  
	
	//настройка видимости элементов табличной части
	Элементы.ОбъектыОбменаОбъект.Видимость   = Истина;
	Элементы.ОбъектыОбменаОбъект.Доступность = Истина;
	
	Элементы.ОбъектыОбменаФайл.Видимость     = Ложь;
	Элементы.ОбъектыОбменаФайл.Доступность   = Ложь;
    //----------------------------------------------
	
	ЗаполнитьФрагмент();
	
КонецПроцедуры    

&НаКлиенте
Процедура ЗаполнитьФайлами(Команда)  
	
	ОчиститьСообщения();
	
	Если Объект.ОбъектыОбмена.Количество() > 0 Тогда
		Ответ = Неопределено;

		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьФайламиЗавершение", ЭтотОбъект), НСтр("ru = 'Существующие строки документа будут удалены. 
		|Продолжить?'"), РежимДиалогаВопрос.ДаНет);
        Возврат;
	КонецЕсли;  
	
	//настройка видимости элементов табличной части
	Элементы.ОбъектыОбменаОбъект.Видимость   = Ложь;
	Элементы.ОбъектыОбменаОбъект.Доступность = Ложь;
	
	Элементы.ОбъектыОбменаФайл.Видимость     = Истина;
	Элементы.ОбъектыОбменаФайл.Доступность   = Истина;
    //----------------------------------------------
	
	ЗаполнитьФрагментФайлы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьФайлы(Команда)
	
	ЭтаФорма.Записать();
	ТекстОшибки = "";
	
	ДополнительныеПараметры = Новый Структура;
	ЭкспортФайловКлиент.ЭкспортФайловЗаданияНаЭкспорт(Объект.Ссылка, Объект.НастройкаОбмена, Объект.КаталогВыгрузки, ТекстОшибки, УникальныйИдентификатор,ДополнительныеПараметры);
	
	ЭтаФорма.Прочитать();
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
	ТребуетсяСледующаяИтерация = Ложь;	
	Если ДополнительныеПараметры.Свойство("ТребуетсяСледующаяИтерация",ТребуетсяСледующаяИтерация) Тогда
		Если ТребуетсяСледующаяИтерация = Истина Тогда
			 ТекстВопроса = Нстр("ru='Из сервиса получены не все данные. Получить следующие порции?'");
			 ОписаниеОповещения = Новый ОписаниеОповещения("СформироватьИПодготовитьФайлы",ЭтотОбъект);
			 ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса,РежимДиалогаВопрос.ОКОтмена);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПосмотретьОтветИзСервиса(Команда)
	ТекДанные = Элементы.ОбъектыОбмена.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Если Модифицированность Тогда
			ЭтаФорма.Записать();
		КонецЕсли;
		ТекИдентификатор = ТекДанные.НомерСтроки-1;
		ТекстовыйДокумент = ПолучитьТекстовыйДокументСОтветом(ТекИдентификатор);
		ТекстовыйДокумент.Показать(НСтр("ru='Ответ из web-сервиса, полученный при отправке файла """+ТекДанные.ИмяФайлаВыгрузки+"""'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПосмотретьПротоколОбмена(Команда)
	ТекДанные = Элементы.ОбъектыОбмена.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Если Модифицированность Тогда
			ЭтаФорма.Записать();
		КонецЕсли;
		ТекИдентификатор = ТекДанные.НомерСтроки-1;
		ТекстПротокола = ПолучитьТекстПротокола(ТекИдентификатор);

		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(ТекстПротокола);
		ТекстовыйДокумент.Показать("Протокол");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)
	
	Если РеквизитыЗаполненыКорректно() Тогда
		ЗаписатьНастройкиПоУмолчанию();		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьФайлыЭкспорта(Команда)
	
	ОчиститьСообщения();	
	
	Если Объект.Проведен Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ОтменитьПроведениеИСформироватьФайлыЭкспорта", ЭтотОбъект, Новый Структура("Команда", Команда)), НСтр("ru = 'Нельзя формировать файлы для проведенного документа!
		                  |         Отменить проведение документа?'"), РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет);
        Возврат;
	
    КонецЕсли;
	
	СформироватьФайлыЭкспортаФрагмент(Команда);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Период",Новый СтандартныйПериод(Объект.ДатаНач, Объект.ДатаКон));
	ПараметрыФормы.Вставить("Организация",Объект.Организация);
	ПараметрыФормы.Вставить("НастройкаФорматов",Объект.НастройкаФорматов);
	ПараметрыФормы.Вставить("УИД",УникальныйИдентификатор);
	ПараметрыФормы.Вставить("АдресТаблицыОтбора",АдресНастроекОтбора);
	
	РезультатВыбора = Неопределено;

	
	ОткрытьФорму("Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.Форма.ФормаПодбора", ПараметрыФормы, ЭтаФорма,,,, Новый ОписаниеОповещения("УстановитьПериодЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

