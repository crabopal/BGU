
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.МассивФайл_Хеш.Количество() = 0 Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	РасширениеРаботыСФайламиПодключено = Истина;
	
	Для каждого ТекФайл из Параметры.МассивФайл_Хеш Цикл
		НоваяСтрока = ТаблицаФайл_Хеш.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекФайл);
	КонецЦикла;	
	
	ЭтоВебКлиент = ОбщегоНазначенияКлиентСервер.ЭтоВебКлиент();
	
	Элементы.ГруппаПроверка.ТекущаяСтраница = Элементы.ГруппаПроверкаПоКнопке;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ОбщегоНазначенияКлиентСервер.ЭтоВебКлиент() Тогда
		ПодключитьОбработчикОжидания("Подключаемый_ПодключитьРасширениеРаботыСФайлами", 0.1, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Не ЗавершениеРаботы Тогда
		ТекИндекс = ИндексТекущегоНеудаленногоФайла();
		Если ТекИндекс <> Неопределено Тогда
			Отказ = Истина;
			УдалитьФайлыПередЗакрытием(ТекИндекс);
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Проверить(Команда)
	
	Если РасширениеРаботыСФайламиПодключено Тогда
		Если ТаблицаФайл_Хеш.Количество() > 0 Тогда
			ПроверитьФайлНаКлиенте(0);
		КонецЕсли;	
	Иначе
		ИмяФайла = ТаблицаФайл_Хеш[0].ИмяФайла;
		ОповещениеПомещениеФайла = Новый ОписаниеОповещения("ПомещениеФайлаЗавершение", ЭтотОбъект);
		НачатьПомещениеФайла(ОповещениеПомещениеФайла, , ИмяФайла, Истина, ЭтотОбъект.УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Пропустить(Команда)
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Подключаемый_ПодключитьРасширениеРаботыСФайлами() Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПодключитьРасширениеРаботыСФайламиЗавершение", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьВопросОбУстановкеРасширенияРаботыСФайлами(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьРасширениеРаботыСФайламиЗавершение(ПодключеноРасширениеРаботыСФайлами, ДополнительныеПараметры) Экспорт
	
	// Если нет расширения работы с файлами и количество файлов для передачи больше 1, то проверять не будем.
	// Иначе придется определять расположение каждого файла интерактивно, что некрасиво, да и не нужно,
	// т.к. несколько файлов может быть только при передаче в казначейство.
	Если НЕ ПодключеноРасширениеРаботыСФайлами И ТаблицаФайл_Хеш.Количество() > 1 Тогда
		Закрыть();
	КонецЕсли;	
	
	РасширениеРаботыСФайламиПодключено = ПодключеноРасширениеРаботыСФайлами;
	
КонецПроцедуры

&НаКлиенте
Процедура ПомещениеФайлаЗавершение(Результат, АдресФайлаПомещенный, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	Если Результат = Ложь ИЛИ АдресФайлаПомещенный = "" Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРезультатСравнения(0, АдресФайлаПомещенный);
	ПоказатьРезультатПроверки();
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьСтраницы(РезультатПроверки)
	Если РезультатПроверки = "ПроверкаВыполненаУспешно" Тогда
		// Проверка выполнена успешно
		Элементы.ГруппаПроверка.ТекущаяСтраница = Элементы.ГруппаПроверкаУспешна;
	ИначеЕсли РезультатПроверки = "ФайлИзменен" Тогда
		// Файл изменен
		Элементы.ГруппаПроверка.ТекущаяСтраница = Элементы.ГруппаФайлИзменен;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФайлНаКлиенте(ТекущийИндекс)
	МаксИндекс = ТаблицаФайл_Хеш.Количество() - 1;
	Если ТекущийИндекс > МаксИндекс Тогда
		ПоказатьРезультатПроверки();
		Возврат;
	КонецЕсли;	
	
	ДопПараметры   = Новый Структура("ТекущийИндекс", ТекущийИндекс);
	СтрокаФайла = ТаблицаФайл_Хеш[ТекущийИндекс];
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьНаКлиентеСуществованиеФайла", ЭтотОбъект, ДопПараметры);
	Файл = Новый Файл();
	Файл.НачатьИнициализацию(ОписаниеОповещения, СтрокаФайла.Каталог + СтрокаФайла.ИмяФайла);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаКлиентеСуществованиеФайла(Файл, ДопПараметры) Экспорт
	ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьНаКлиентеСуществованиеФайлаЗавершение", ЭтотОбъект, ДопПараметры);
	Файл.НачатьПроверкуСуществования(ОписаниеОповещения);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаКлиентеСуществованиеФайлаЗавершение(Существует, ДопПараметры) Экспорт
	Если Существует Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьСодержимоеФайлаНаКлиенте", ЭтотОбъект, ДопПараметры);
		
		ПомещаемыеФайлы = Новый Массив;
		ПомещаемыйФайл = Новый ОписаниеПередаваемогоФайла;
		ПомещаемыйФайл.Имя = ТаблицаФайл_Хеш[ДопПараметры.ТекущийИндекс].Каталог
							+ ТаблицаФайл_Хеш[ДопПараметры.ТекущийИндекс].ИмяФайла;
		ПомещаемыеФайлы.Добавить(ПомещаемыйФайл);					
		
		НачатьПомещениеФайлов(ОписаниеОповещения, ПомещаемыеФайлы,, Ложь);
	Иначе
		ТаблицаФайл_Хеш[ДопПараметры.ТекущийИндекс].КатегорияПроблемы = 1;
		ПроверитьФайлНаКлиенте(ДопПараметры.ТекущийИндекс + 1);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСодержимоеФайлаНаКлиенте(ПолученныеФайлы, ДопПараметры) Экспорт
	ЗаполнитьРезультатСравнения(ДопПараметры.ТекущийИндекс, ПолученныеФайлы[0].Хранение);
	ПроверитьФайлНаКлиенте(ДопПараметры.ТекущийИндекс + 1);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьФайлыПередЗакрытием(ТекущийИндекс)
	
	ДопПараметры = Новый Структура("ТекущийИндекс", ТекущийИндекс);
	СтрокаФайла = ТаблицаФайл_Хеш[ТекущийИндекс];
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УдалитьФайлПередЗакрытиемЗавершение", ЭтотОбъект, ДопПараметры);
	НачатьУдалениеФайлов(ОписаниеОповещения, СтрокаФайла.Каталог, СтрокаФайла.ИмяФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьФайлПередЗакрытиемЗавершение(ДопПараметры) Экспорт
	ТаблицаФайл_Хеш[ДопПараметры.ТекущийИндекс].Удален = Истина;
	ТекИндекс = ИндексТекущегоНеудаленногоФайла();
	Если ТекИндекс = Неопределено Тогда
		Закрыть();
	Иначе	
		УдалитьФайлыПередЗакрытием(ТекИндекс);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Функция ИндексТекущегоНеудаленногоФайла()
	ТекИндекс = Неопределено;
	Для каждого ТекСтрока из ТаблицаФайл_Хеш Цикл
		Если ТекСтрока.Удален Тогда
			Продолжить;
		КонецЕсли;	
		
		ТекИндекс = ТаблицаФайл_Хеш.Индекс(ТекСтрока);
		Прервать;
	КонецЦикла;	
	
	Возврат ТекИндекс;
КонецФункции	

&НаСервере
Процедура ВывестиСекцию(ТабДок, Шапка, Строка, Строка1, КатегорияПроблемы)
	Шапка.Параметры.ТипПроблемы = ?(КатегорияПроблемы = 2, "Измененные файлы", "Удаленные файлы");
	ТабДок.Вывести(Шапка);
	
	Переключатель = 0;
	Для каждого ТекСтрока из ТаблицаФайл_Хеш Цикл
		Если ТекСтрока.КатегорияПроблемы <> КатегорияПроблемы Тогда
			Продолжить;
		КонецЕсли;	
		
		Строка.Параметры.ПутьКФайлу = ТекСтрока.ИмяФайла;
		Если Переключатель = 0 Тогда
			ТабДок.Вывести(Строка);
		Иначе	
			ТабДок.Вывести(Строка1);
		КонецЕсли;	
		Переключатель = ?(Переключатель = 0, 1, 0);
	КонецЦикла;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьПротоколПроблем()
	Макет  = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьМакет("ПротоколПроверки");
	ОблЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Шапка        = Макет.ПолучитьОбласть("Шапка");
	Строка       = Макет.ПолучитьОбласть("Строка");
	Строка1      = Макет.ПолучитьОбласть("Строка1");
	ПустаяСтрока = Макет.ПолучитьОбласть("ПустаяСтрока");
	
	ТабДок = ПротоколПроверки;
	
	ЗаголовокВыведен = Ложь;
	
	Отбор = Новый Структура("КатегорияПроблемы", 2);
	ЕстьИзмененные = (ТаблицаФайл_Хеш.НайтиСтроки(Отбор).Количество() <> 0);
	Если ЕстьИзмененные Тогда
		Если НЕ ЗаголовокВыведен Тогда 
			ОблЗаголовок.Параметры.КаталогФайлов = ТаблицаФайл_Хеш[0].Каталог;
			ТабДок.Вывести(ОблЗаголовок);
			ЗаголовокВыведен = Истина;
		КонецЕсли;	
		
		ВывестиСекцию(ТабДок, Шапка, Строка, Строка1, 2);
	КонецЕсли;	
	
	Отбор = Новый Структура("КатегорияПроблемы", 1);
	ЕстьУдаление = (ТаблицаФайл_Хеш.НайтиСтроки(Отбор).Количество() <> 0);
	Если ЕстьУдаление Тогда
		Если НЕ ЗаголовокВыведен Тогда 
			ОблЗаголовок.Параметры.КаталогФайлов = ТаблицаФайл_Хеш[0].Каталог;
			ТабДок.Вывести(ОблЗаголовок);
			ЗаголовокВыведен = Истина;
		КонецЕсли;	

		Если ЕстьИзмененные Тогда
			Для к = 1 по 2 Цикл
				ТабДок.Вывести(ПустаяСтрока);
			КонецЦикла;	
		КонецЕсли;	
		
		ВывестиСекцию(ТабДок, Шапка, Строка, Строка1, 1);
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ПоказатьВОтдельномОкне(Команда)
	ТабДок = Новый ТабличныйДокумент;
	ЗаполнитьОтдельноеОкно(ТабДок, ПротоколПроверки);
	ТабДок.Показать();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьОтдельноеОкно(ТабДок, ПротоколПроверки)
	ТабДок.Вывести(ПротоколПроверки.ПолучитьОбласть());
	ТабДок.ОтображатьСетку     = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьРезультатСравнения(ТекИндекс, АдресДанных)
	ТекХешСумма = ЭкспортФайлов.ХешСуммаДанных_МД5(АдресДанных);
	
	Если ТаблицаФайл_Хеш[ТекИндекс].ХешДанных <> ТекХешСумма Тогда
		ТаблицаФайл_Хеш[ТекИндекс].КатегорияПроблемы = 2;
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ПоказатьРезультатПроверки()
	ЕстьПроблемы = Ложь;
	Для каждого ТекСтрока из ТаблицаФайл_Хеш Цикл
		Если ТекСтрока.КатегорияПроблемы <> 1 И ТекСтрока.КатегорияПроблемы <> 2 Тогда
			Продолжить;
		КонецЕсли;	
		
		ЕстьПроблемы = Истина;
		Прервать;
	КонецЦикла;
	
	Если ЕстьПроблемы Тогда
		ЗаполнитьПротоколПроблем();
		ПереключитьСтраницы("ФайлИзменен");
	Иначе
		ПереключитьСтраницы("ПроверкаВыполненаУспешно");
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти
