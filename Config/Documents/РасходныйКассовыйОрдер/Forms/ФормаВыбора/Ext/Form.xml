			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументРасходныйКассовыйОрдер.Ссылка,
	ДокументРасходныйКассовыйОрдер.ВерсияДанных,
	ДокументРасходныйКассовыйОрдер.ПометкаУдаления,
	ДокументРасходныйКассовыйОрдер.Номер,
	ДокументРасходныйКассовыйОрдер.Дата,
	ДокументРасходныйКассовыйОрдер.Проведен,
	ДокументРасходныйКассовыйОрдер.Организация,
	ДокументРасходныйКассовыйОрдер.Подразделение,
	ДокументРасходныйКассовыйОрдер.СуммаДокумента,
	ДокументРасходныйКассовыйОрдер.ПодразделениеКор,
	ДокументРасходныйКассовыйОрдер.Счет,
	ДокументРасходныйКассовыйОрдер.КорСчет,
	ДокументРасходныйКассовыйОрдер.КодАналитическогоУчета,
	ДокументРасходныйКассовыйОрдер.КодЦелевогоНазначения,
	ДокументРасходныйКассовыйОрдер.ВалютаДокумента,
	ДокументРасходныйКассовыйОрдер.ИФО,
	ДокументРасходныйКассовыйОрдер.Выдать,
	ДокументРасходныйКассовыйОрдер.Контрагент,
	ДокументРасходныйКассовыйОрдер.Основание,
	ДокументРасходныйКассовыйОрдер.Договор,
	ДокументРасходныйКассовыйОрдер.Приложение,
	ДокументРасходныйКассовыйОрдер.Руководитель,
	ДокументРасходныйКассовыйОрдер.ГлБухгалтер,
	ДокументРасходныйКассовыйОрдер.Кассир,
	ДокументРасходныйКассовыйОрдер.ПоДокументу,
	ДокументРасходныйКассовыйОрдер.Оплачено,
	ДокументРасходныйКассовыйОрдер.Комментарий,
	ДокументРасходныйКассовыйОрдер.ДокументОснование,
	ДокументРасходныйКассовыйОрдер.РасшифровкаПлатежа.(
		Ссылка,
		НомерСтроки,
		КФО,
		КПС,
		КЭК,
		Сумма,
		КодЦели,
		КодМероприятия,
		ДопКлассификация
	),
	ДокументРасходныйКассовыйОрдер.МоментВремени,
	ОперацииДокументов.Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
ДокументРасходныйКассовыйОрдер.Ответственный
ИЗ
	Документ.РасходныйКассовыйОрдер КАК ДокументРасходныйКассовыйОрдер
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		ПО ДокументРасходныйКассовыйОрдер.Ссылка = ОперацииДокументов.Документ}</QueryText>
