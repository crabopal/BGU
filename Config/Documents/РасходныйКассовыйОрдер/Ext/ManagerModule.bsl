	|			ТОГДА ПлатежнаяВедомость.Организация.НаименованиеСокращенное
	|		ИНАЧЕ ПлатежнаяВедомость.Организация.НаименованиеПолное
	|	КОНЕЦ,
	|	ПлатежнаяВедомость.Организация.НаименованиеСокращенное,
	|	ВЫБОР
	|		КОГДА ПлатежнаяВедомость.Подразделение.НаименованиеПолное = """"
	|			ТОГДА ПлатежнаяВедомость.Подразделение.Наименование
	|		ИНАЧЕ ПлатежнаяВедомость.Подразделение.НаименованиеПолное
	|	КОНЕЦ,
	|	ПлатежнаяВедомость.Организация.Префикс,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.КоличествоКФО = 1
	|			ТОГДА ВложенныйЗапрос.КФО
	|		ИНАЧЕ ""0""
	|	КОНЕЦ,
	|	ПлатежнаяВедомость.Организация.КодОКПО,
	|	ЛОЖЬ,
	|	ПлатежнаяВедомость.Организация.НаименованиеПолное
	|ИЗ
	|	Документ.ПлатежнаяВедомость КАК ПлатежнаяВедомость
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ПлатежнаяВедомостьРасшифровкаПлатежа.Ссылка КАК Ссылка,
	|			МАКСИМУМ(ПлатежнаяВедомостьРасшифровкаПлатежа.КФО) КАК КФО,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПлатежнаяВедомостьРасшифровкаПлатежа.КФО) КАК КоличествоКФО,
	|			СУММА(ПлатежнаяВедомостьРасшифровкаПлатежа.Сумма) КАК Сумма
	|		ИЗ
	|			Документ.ПлатежнаяВедомость.РасшифровкаПлатежа КАК ПлатежнаяВедомостьРасшифровкаПлатежа
	|		ГДЕ
	|			ПлатежнаяВедомостьРасшифровкаПлатежа.Ссылка В(&МассивОбъектов)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ПлатежнаяВедомостьРасшифровкаПлатежа.Ссылка) КАК ВложенныйЗапрос
	|		ПО ПлатежнаяВедомость.Ссылка = ВложенныйЗапрос.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПлатежнаяВедомость.РасшифровкаПлатежа КАК ПлатежнаяВедомостьРасшифровкаПлатежа
	|		ПО ПлатежнаяВедомость.Ссылка = ПлатежнаяВедомостьРасшифровкаПлатежа.Ссылка
	|			И (ПлатежнаяВедомостьРасшифровкаПлатежа.НомерСтроки = 1)
	|ГДЕ
	|	ПлатежнаяВедомость.Ссылка В(&МассивОбъектов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РасходныйОрдерФондовый.Ссылка,
	|	РасходныйОрдерФондовый.Номер,
	|	РасходныйОрдерФондовый.Дата,
	|	РасходныйОрдерФондовый.Организация,
	|	РасходныйОрдерФондовый.Подразделение,
	|	ЕСТЬNULL(РасходныйОрдерФондовый.ПодразделениеКор.Код, """"),
	|	РасходныйОрдерФондовый.СуммаДокумента,
	|	РасходныйОрдерФондовый.ПодразделениеКор,
	|	РасходныйОрдерФондовый.Счет,
	|	РасходныйОрдерФондовый.КорСчет,
	|	РасходныйОрдерФондовый.КодАналитическогоУчета,
	|	РасходныйОрдерФондовый.КодЦелевогоНазначения.Код,
	|	ВалютаРегламентированногоУчета.Значение,
	|	РасходныйОрдерФондовый.Выдать,
	|	РасходныйОрдерФондовый.Основание,
	|	РасходныйОрдерФондовый.Приложение,
	|	РасходныйОрдерФондовый.Руководитель,
	|	РасходныйОрдерФондовый.ГлБухгалтер,
	|	РасходныйОрдерФондовый.Кассир,
	|	РасходныйОрдерФондовый.ПоДокументу,
	|	ВЫБОР
	|		КОГДА РасходныйОрдерФондовый.Организация.ИспользоватьВПлатежныхДокументахСокращенноеНаименование = ИСТИНА
	|			ТОГДА РасходныйОрдерФондовый.Организация.НаименованиеСокращенное
	|		ИНАЧЕ РасходныйОрдерФондовый.Организация.НаименованиеПолное
	|	КОНЕЦ,
	|	РасходныйОрдерФондовый.Организация.НаименованиеСокращенное,
	|	ВЫБОР
	|		КОГДА РасходныйОрдерФондовый.Подразделение.НаименованиеПолное = """"
	|			ТОГДА РасходныйОрдерФондовый.Подразделение.Наименование
	|		ИНАЧЕ РасходныйОрдерФондовый.Подразделение.НаименованиеПолное
	|	КОНЕЦ,
	|	РасходныйОрдерФондовый.Организация.Префикс,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.КоличествоКФО = 1
	|			ТОГДА ВложенныйЗапрос.КФО
	|		ИНАЧЕ ""0""
	|	КОНЕЦ,
	|	РасходныйОрдерФондовый.Организация.КодОКПО,
	|	ИСТИНА,
	|	РасходныйОрдерФондовый.Организация.НаименованиеПолное
	|ИЗ
	|	Документ.РасходныйОрдерФондовый КАК РасходныйОрдерФондовый
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			РасходныйОрдерФондовыйРасшифровка.Ссылка КАК Ссылка,
	|			МАКСИМУМ(РасходныйОрдерФондовыйРасшифровка.КФО) КАК КФО,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РасходныйОрдерФондовыйРасшифровка.КФО) КАК КоличествоКФО
	|		ИЗ
	|			Документ.РасходныйОрдерФондовый.Расшифровка КАК РасходныйОрдерФондовыйРасшифровка
	|		ГДЕ
	|			РасходныйОрдерФондовыйРасшифровка.Ссылка В(&МассивОбъектов)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			РасходныйОрдерФондовыйРасшифровка.Ссылка) КАК ВложенныйЗапрос
	|		ПО РасходныйОрдерФондовый.Ссылка = ВложенныйЗапрос.Ссылка,
	|	Константа.ВалютаРегламентированногоУчета КАК ВалютаРегламентированногоУчета
	|ГДЕ
	|	РасходныйОрдерФондовый.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер";
	Запрос.УстановитьПараметр("МассивОбъектов",МассивОбъектов);
	Шапка = Запрос.Выполнить().Выбрать();
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ПервыйДокумент = Истина;

	Пока Шапка.Следующий() Цикл

		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		
		ОбластьШапка.Параметры.Заполнить(Шапка);
		СтруктураОбластьШапка = Новый Структура;
		СтруктураОбластьШапка.Вставить("НомерДокумента",ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Шапка.Ссылка,Шапка.Номер));
		СтруктураОбластьШапка.Вставить("Сумма",Формат(Шапка.СуммаДокумента, "ЧЦ=15; ЧДЦ=2; ЧРД=-; ЧГ=0"));
		СтруктураОбластьШапка.Вставить("СуммаСНазваниемВалюты", Формат(Шапка.СуммаДокумента, "ЧЦ=15; ЧДЦ=2; ЧРД=-; ЧГ=0") + ?(Шапка.ВалютаДокумента = ВалютаРегламентированногоУчета, "", " " + Шапка.ВалютаДокумента));
		СтруктураОбластьШапка.Вставить("СуммаПрописью",ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(Шапка.СуммаДокумента, Шапка.ВалютаДокумента));
		СтруктураОбластьШапка.Вставить("ПредставлениеОрганизации",Шапка.ПредставлениеОрганизации);
		СтруктураОбластьШапка.Вставить("СокращенноеНаименованиеОрганизации",Шапка.СокращенноеНаименованиеОрганизации);
		СтруктураОбластьШапка.Вставить("ПолноеНаименованиеОрганизации",Шапка.ПолноеНаименованиеОрганизации);
		СтруктураОбластьШапка.Вставить("ПредставлениеПодразделения",Шапка.НаименованиеПодразделения);
		СтруктураОбластьШапка.Вставить("ДебетСубСчет",БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(Шапка.КорСчет, , Шапка.КФО));
		СтруктураОбластьШапка.Вставить("КредитСубСчет",БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(Шапка.Счет, , Шапка.КФО));
		СтруктураОбластьШапка.Вставить("КодЦелевогоНазначения", СокрЛП(Шапка.КодЦелевогоНазначения));
				
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", Шапка.Руководитель, Шапка.ДатаДокумента);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураОбластьШапка.Вставить("ДолжностьРуководителя", ДанныеСотрудника.Должность);
		СтруктураОбластьШапка.Вставить("ФИОРуководителя", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		СтруктураОбластьШапка.Вставить("ФИОГлавногоБухгалтера", Справочники.Контрагенты.ФамилияИО(Шапка.ГлБухгалтер, Истина, Шапка.ДатаДокумента));
		СтруктураОбластьШапка.Вставить("ФИОКассира", Справочники.Контрагенты.ФамилияИО(Шапка.Кассир, Истина, Шапка.ДатаДокумента));
		
		
		//Получил прописью
		Рубли = Цел(Шапка.СуммаДокумента);
		
		СтруктураОбластьШапка.Вставить("СуммаКоп", Шапка.СуммаДокумента - Рубли);
		
		РублиПрописью = СокрЛП(ЧислоПрописью(Цел(Шапка.СуммаДокумента),,",,, м,,,,, 0"));
		
		РублиПрописьюПродолжение = "";
		Если СтрДлина(РублиПрописью) > 75 Тогда
			н = 75;
			Пока н > 0 И Сред(РублиПрописью, н, 1) <> " " Цикл
				н = н-1;
			КонецЦикла;
			
			РублиПрописьюПродолжение = Сред(РублиПрописью, н + 1);
			РублиПрописью = Лев(РублиПрописью, н);
		КонецЕсли;
		
		СтруктураОбластьШапка.Вставить("СуммаПрописьюРуб", РублиПрописью);
		СтруктураОбластьШапка.Вставить("СуммаПрописьюРубПродолжение", РублиПрописьюПродолжение);

		
		ОбластьШапка.Параметры.Заполнить(СтруктураОбластьШапка);
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		Если Шапка.Фондовый Тогда
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Объединить();
			Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Обвести(Линия, Линия, Линия, Линия);
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Текст                   = "Ф О Н Д О В Ы Й";
			ЦветПечати                                              = Новый Цвет(83,114,187); 
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ЦветТекста              = ЦветПечати;
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ЦветРамки               = ЦветПечати;
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
			ЖирныйШрифт                                             = Новый Шрифт(ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Шрифт,, 11, Истина);
			ТабличныйДокумент.Область(2+НомерСтрокиНачало-1, 2, 2+НомерСтрокиНачало-1, 4).Шрифт                   = ЖирныйШрифт;
		КонецЕсли;			
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокумента

Функция ЗаполнитьНаОсновании(Знач Основание, Объект, ОписаниеОшибки = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен документ-основание'");
		Возврат Ложь;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ТипДанныхЗаполнения = ТипЗнч(Основание);
	
	Если ТипДанныхЗаполнения = Тип("ДокументСсылка.АвансовыйОтчет") Тогда
		ЗаполнитьДокументНаОснованииАвансовогоОтчета(Основание, Объект);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.РешениеОКомандировании") Тогда
		ЗаполнитьДокументНаОснованииРешенияОКомандировании(Основание, Объект);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.РешениеОКомпенсацииРасходовДляКрайнегоСевера") Тогда
		ЗаполнитьДокументНаОснованииРешенияОКомпенсации(Основание, Объект);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъема")
		ИЛИ ТипДанныхЗаполнения = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо") Тогда
		ЗаполнитьДокументНаОснованииЗаявкиОбоснованияЗакупкиМалогоОбъема(Основание, Объект, Отказ, ОписаниеОшибки);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ОтчетОРасходахПодотчетногоЛица") Тогда
		ЗаполнитьДокументНаОснованииОтчетаОРасходахПодотчетногоЛица(Основание, Объект);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ВедомостьНаВыдачуПодотчетнымЛицам") Тогда
		ЗаполнитьДокументНаОснованииВедомостиНаВыдачуПодотчетнымЛицам(Основание, Объект);
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ПлатежнаяВедомость0504403") Тогда
		ЗаполнитьДокументНаОснованииПлатежнойВедомости(Основание, Объект);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
		Объект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Заполняет документ данными Заявлений на выдачу аванса
//
// Параметры
//   Объект - ДокументОбъект.РасходныйКассовыйОрдер, ДанныеФормыСтруктура
//   МассивЗаявлений  - Массив    - Массив ссылок на документы ЗаявлениеНаВыдачуАванса
//   Валюта - СправочникСсылка.Валюты
//   Организация - СправочникСсылка.Организации
//
Процедура ЗаполнитьПоЗаявлениямНаВыдачуАванса(Объект, МассивЗаявлений, Валюта, Организация) Экспорт
	
	Объект.ВалютаДокумента 	= Валюта;
	Объект.Организация 		= Организация;
	
	Объект.РасшифровкаПлатежа.Очистить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.НомерСтроки) КАК КоличествоСтрок
	|ПОМЕСТИТЬ Строки
	|ИЗ
	|	Документ.ЗаявлениеНаВыдачуАванса.РасчетРазмераАванса КАК ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса
	|ГДЕ
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Ссылка В(&МассивСсылок)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаявлениеНаВыдачуАвансаРасчетРазмераАванса.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаявлениеНаВыдачуАванса.Ссылка КАК ДокументОснование,
	|	ЗаявлениеНаВыдачуАванса.Подразделение КАК ПодразделениеКор,
	|	&Счет208 КАК КорСчет,
	|	ЗаявлениеНаВыдачуАванса.Сотрудник.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ЗаявлениеНаВыдачуАванса.Сотрудник.Контрагент.НаименованиеДП ЕСТЬ NULL
	|			ТОГДА ЗаявлениеНаВыдачуАванса.Сотрудник.Контрагент.Наименование
	|		ИНАЧЕ ЗаявлениеНаВыдачуАванса.Сотрудник.Контрагент.НаименованиеДП
	|	КОНЕЦ КАК Выдать,
	|	ЗаявлениеНаВыдачуАванса.ОснованиеПринятияОбязательства КАК Договор,
	|	""Выдача денег из кассы подотчетным лицам"" КАК Основание,
	|	ЗаявлениеНаВыдачуАванса.Представление КАК Приложение,
	|	ВЫБОР
	|		КОГДА &Валютный
	|			ТОГДА ЗаявлениеНаВыдачуАванса.СуммаДокументаВВалюте
	|		ИНАЧЕ ЗаявлениеНаВыдачуАванса.СуммаДокумента
	|	КОНЕЦ КАК СуммаДокумента,
	|	ЗаявлениеНаВыдачуАванса.РасчетРазмераАванса.(
	|		КФО КАК КФО,
	|		КПС КАК КПС,
	|		КЭК КАК КЭК,
	|		СУММА(ВЫБОР
	|				КОГДА &Валютный
	|					ТОГДА ЗаявлениеНаВыдачуАванса.РасчетРазмераАванса.СуммаВВалюте
	|				ИНАЧЕ ЗаявлениеНаВыдачуАванса.РасчетРазмераАванса.Сумма
	|			КОНЕЦ) КАК Сумма,
	|		КОЛИЧЕСТВО(НомерСтроки) КАК НомерСтроки
	|	) КАК РасчетРазмераАванса,
	|	Строки.КоличествоСтрок КАК КоличествоСтрок
	|ИЗ
	|	Документ.ЗаявлениеНаВыдачуАванса КАК ЗаявлениеНаВыдачуАванса
	|		ЛЕВОЕ СОЕДИНЕНИЕ Строки КАК Строки
	|		ПО (Строки.Ссылка = ЗаявлениеНаВыдачуАванса.Ссылка)
	|ГДЕ
	|	ЗаявлениеНаВыдачуАванса.Ссылка В(&МассивСсылок)
	|	И (&Валютный
	|				И ЗаявлениеНаВыдачуАванса.РасчетРазмераАванса.СуммаВВалюте > 0
	|			ИЛИ НЕ &Валютный
	|				И ЗаявлениеНаВыдачуАванса.РасчетРазмераАванса.Сумма > 0
	|			ИЛИ ЗаявлениеНаВыдачуАванса.РасчетРазмераАванса.СуммаВВалюте = 0
	|				И ЗаявлениеНаВыдачуАванса.РасчетРазмераАванса.Сумма = 0
	|			ИЛИ Строки.КоличествоСтрок ЕСТЬ NULL)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаявлениеНаВыдачуАванса.РасчетРазмераАванса.(КФО,
	|	КПС,
	|	КЭК)");
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивЗаявлений);
	Запрос.УстановитьПараметр("Валютный", ЗначениеЗаполнено(Валюта) И НЕ Валюта = Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("Счет208", БухгалтерскийУчет.СчетПоКоду("208.00", ТекущаяДатаСеанса()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(Объект, Выборка);
		
		ЗаполнитьДанныеКонтрагента(Объект.Контрагент, Объект.Выдать, Объект.ПоДокументу);
		
		СтрокиДок = Выборка.РасчетРазмераАванса.Выбрать();
		
		Пока СтрокиДок.Следующий() Цикл
			
			НоваяСтр = Объект.РасшифровкаПлатежа.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтр, СтрокиДок);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДокументНаОснованииАвансовогоОтчета(ДокументОснование, Объект)
	
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование.Сотрудник, "Контрагент");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("пСчет", 							БухгалтерскийУчет.СписокСчетов("208.00")); 
	Запрос.УстановитьПараметр("Организация", 					ДокументОснование.Организация);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	Запрос.УстановитьПараметр("Субконто1", 						Контрагент);
	Запрос.УстановитьПараметр("АвансовыйОчетСсылка",			ДокументОснование);
	Запрос.УстановитьПараметр("ДокументыАвансов", 				ДокументОснование.Получено.ВыгрузитьКолонку("ДокументАванса"));
	Запрос.УстановитьПараметр("ДокументыИзрасходовано", 		ДокументОснование.Израсходовано.ВыгрузитьКолонку("ПриходныйДокумент"));
	Запрос.УстановитьПараметр("ДокументыПерерасхода", 			ДокументОснование.ОстатокПерерасход.ВыгрузитьКолонку("ДокументПерерасхода"));
	Запрос.УстановитьПараметр("ДокументыОстатка", 				ДокументОснование.ОстатокПерерасход.ВыгрузитьКолонку("ДокументОстатка"));
	
	Запрос.УстановитьПараметр("МоментВремени", РасчетыСПодотчетнымиЛицами.МоментВремениДокументаНачальногоОстатка(ДокументОснование));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЕСТЬNULL(Валюты.Ссылка, &ВалютаРегламентированногоУчета) КАК Валюта,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Валюты.Ссылка ЕСТЬ NULL
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт
	|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт
	|	КОНЕЦ КАК ПредыдущийАвансОстаток,
	|	ВЫБОР
	|		КОГДА Валюты.Ссылка ЕСТЬ NULL
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт
	|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокКт
	|	КОНЕЦ КАК ПредыдущийАвансПерерасход,
	|	0 КАК Получено,
	|	0 КАК Израсходовано,
	|	0 КАК ВозвращенОстаток,
	|	0 КАК ВыданПерерасход
	|ПОМЕСТИТЬ ДетальныеДанные
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&МоментВремени,
	|			Счет В (&пСчет),
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &Субконто1) КАК ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ЖурналПроводокЕПСБУОстатки.Валюта = Валюты.Ссылка
	|			И (Валюты.Ссылка <> &ВалютаРегламентированногоУчета)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОбороты.Счет,
	|	ЖурналПроводокЕПСБУОбороты.КПС,
	|	ЖурналПроводокЕПСБУОбороты.КФО,
	|	ЕСТЬNULL(Валюты.Ссылка, &ВалютаРегламентированногоУчета),
	|	ЖурналПроводокЕПСБУОбороты.Субконто1,
	|	0,
	|	0,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыАвансов)
	|			ТОГДА ВЫБОР
	|					КОГДА Валюты.Ссылка ЕСТЬ NULL
	|						ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотДт - ЖурналПроводокЕПСБУОбороты.СуммаОборотКт
	|					ИНАЧЕ ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотДт - ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотКт
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыИзрасходовано)
	|				ИЛИ ЖурналПроводокЕПСБУОбороты.Регистратор = &АвансовыйОчетСсылка
	|			ТОГДА ВЫБОР
	|					КОГДА Валюты.Ссылка ЕСТЬ NULL
	|						ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотКт - ЖурналПроводокЕПСБУОбороты.СуммаОборотДт
	|					ИНАЧЕ ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотКт - ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотДт
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыОстатка)
	|			ТОГДА ВЫБОР
	|					КОГДА Валюты.Ссылка ЕСТЬ NULL
	|						ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотКт - ЖурналПроводокЕПСБУОбороты.СуммаОборотДт
	|					ИНАЧЕ ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотКт - ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотДт
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыПерерасхода)
	|			ТОГДА ВЫБОР
	|					КОГДА Валюты.Ссылка ЕСТЬ NULL
	|						ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотДт - ЖурналПроводокЕПСБУОбороты.СуммаОборотКт
	|					ИНАЧЕ ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотДт - ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотКт
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&МоментВремени,
	|			,
	|			Регистратор,
	|			Счет В (&пСчет),
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &Субконто1,
	|			,
	|			) КАК ЖурналПроводокЕПСБУОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ЖурналПроводокЕПСБУОбороты.Валюта = Валюты.Ссылка
	|			И (Валюты.Ссылка <> &ВалютаРегламентированногоУчета)
	|ГДЕ
	|	(ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыАвансов)
	|			ИЛИ ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыИзрасходовано)
	|			ИЛИ ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыОстатка)
	|			ИЛИ ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыПерерасхода)
	|			ИЛИ ЖурналПроводокЕПСБУОбороты.Регистратор = &АвансовыйОчетСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДетальныеДанные.Счет КАК Счет,
	|	МАКСИМУМ(СоответствияАналитическихСчетовКЭК.КЭК) КАК КЭК
	|ПОМЕСТИТЬ СчетКЭК
	|ИЗ
	|	ДетальныеДанные КАК ДетальныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияАналитическихСчетовКЭК КАК СоответствияАналитическихСчетовКЭК
	|		ПО ДетальныеДанные.Счет = СоответствияАналитическихСчетовКЭК.Счет
	|СГРУППИРОВАТЬ ПО
	|	ДетальныеДанные.Счет
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СоответствияАналитическихСчетовКЭК.КЭК) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДетальныеДанные.Счет КАК КорСчет,
	|	ДетальныеДанные.КПС КАК КПС,
	|	ДетальныеДанные.КФО КАК КФО,
	|	ДетальныеДанные.Валюта КАК ВалютаДокумента,
	|	ДетальныеДанные.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА СУММА(ДетальныеДанные.ПредыдущийАвансОстаток) - СУММА(ДетальныеДанные.ПредыдущийАвансПерерасход) + СУММА(ДетальныеДанные.Получено) - СУММА(ДетальныеДанные.Израсходовано) - СУММА(ДетальныеДанные.ВозвращенОстаток) + СУММА(ДетальныеДанные.ВыданПерерасход) < 0
	|			ТОГДА -СУММА(ДетальныеДанные.ПредыдущийАвансОстаток) + СУММА(ДетальныеДанные.ПредыдущийАвансПерерасход) - СУММА(ДетальныеДанные.Получено) + СУММА(ДетальныеДанные.Израсходовано) + СУММА(ДетальныеДанные.ВозвращенОстаток) - СУММА(ДетальныеДанные.ВыданПерерасход)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Сумма,
	|	АвансовыйОтчет.Организация КАК Организация,
	|	АвансовыйОтчет.ИФО КАК ИФО,
	|	АвансовыйОтчет.Подразделение КАК Подразделение,
	|	АвансовыйОтчет.Подразделение КАК ПодразделениеКор,
	|	АвансовыйОтчет.ОснованиеПринятияОбязательства КАК Договор,
	|	ЕСТЬNULL(СчетКЭК.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭК
	|ИЗ
	|	ДетальныеДанные КАК ДетальныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетКЭК КАК СчетКЭК
	|		ПО ДетальныеДанные.Счет = СчетКЭК.Счет,
	|	Документ.АвансовыйОтчет КАК АвансовыйОтчет
	|ГДЕ
	|	АвансовыйОтчет.Ссылка = &АвансовыйОчетСсылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ДетальныеДанные.Счет,
	|	ДетальныеДанные.КПС,
	|	ДетальныеДанные.КФО,
	|	ДетальныеДанные.Валюта,
	|	ДетальныеДанные.Контрагент,
	|	АвансовыйОтчет.Организация,
	|	АвансовыйОтчет.ИФО,
	|	АвансовыйОтчет.Подразделение,
	|	АвансовыйОтчет.ОснованиеПринятияОбязательства,
	|	СчетКЭК.КЭК,
	|	АвансовыйОтчет.Подразделение
	|
	|ИМЕЮЩИЕ
	|	СУММА(ДетальныеДанные.ПредыдущийАвансОстаток) - СУММА(ДетальныеДанные.ПредыдущийАвансПерерасход) + СУММА(ДетальныеДанные.Получено) - СУММА(ДетальныеДанные.Израсходовано) - СУММА(ДетальныеДанные.ВозвращенОстаток) + СУММА(ДетальныеДанные.ВыданПерерасход) < 0
	|ИТОГИ
	|	МАКСИМУМ(Контрагент),
	|	СУММА(Сумма),
	|	МАКСИМУМ(Организация),
	|	МАКСИМУМ(ИФО),
	|	МАКСИМУМ(Подразделение),
	|	МАКСИМУМ(ПодразделениеКор),
	|	МАКСИМУМ(Договор)
	|ПО
	|	ВалютаДокумента";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(Объект, ДокументОснование,"Организация,ИФО,Подразделение,ВалютаДокумента");
	
	Объект.СуммаДокумента 	= Выборка.Сумма;
	
	Объект.КорСчет 			= БухгалтерскийУчет.СчетПоКоду("208.00", ТекущаяДатаСеанса());
	Объект.Счет 			= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("201.34");
	Объект.ПодразделениеКор = ДокументОснование.Подразделение;
	Объект.Контрагент 		= Контрагент;
	Объект.Договор 			= ДокументОснование.ОснованиеПринятияОбязательства;
	
	ЗаполнитьДанныеКонтрагента(Объект.Контрагент, Объект.Выдать, Объект.ПоДокументу);
	
	РасшифровкаПлатежа = Выборка.Выбрать();
	Пока РасшифровкаПлатежа.Следующий() Цикл
		
		НовСтрока = Объект.РасшифровкаПлатежа.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, РасшифровкаПлатежа);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДокументНаОснованииРешенияОКомандировании(ДокументОснование, Объект)
	
	Объект.ДокументОснование = ДокументОснование;
	
	ЭтоИзменение = ЗначениеЗаполнено(ДокументОснование.ДокументОснование);
	
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование.Сотрудник, "Контрагент");
	
	ЗаполнитьЗначенияСвойств(Объект, ДокументОснование,"Организация, ИФО, Подразделение");
	
	Объект.КорСчет 			= БухгалтерскийУчет.СчетПоКоду("208.00", ТекущаяДатаСеанса());
	Объект.Счет 			= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("201.34");
	Объект.ПодразделениеКор = ДокументОснование.Подразделение;
	Объект.Контрагент 		= Контрагент;
	Объект.Договор 			= ДокументОснование.ОснованиеПринятияОбязательства;
	
	ЗаполнитьДанныеКонтрагента(Объект.Контрагент, Объект.Выдать, Объект.ПоДокументу);
	
	ТаблицаДляЗаполнения = ДокументОснование.ФинансовоеОбеспечение.Выгрузить(,"КФО, КПС, КЭК, СуммаАванса, ИзменениеАванса");
	
	Если ЭтоИзменение Тогда
		ТаблицаДляЗаполнения.Свернуть("КФО, КПС, КЭК","ИзменениеАванса");
		ТаблицаДляЗаполнения.Колонки["ИзменениеАванса"].Имя = "Сумма";
	Иначе
		ТаблицаДляЗаполнения.Свернуть("КФО, КПС, КЭК","СуммаАванса");
		ТаблицаДляЗаполнения.Колонки["СуммаАванса"].Имя = "Сумма";
	Конецесли;
	
	ТаблицаДляЗаполнения.Сортировать("КФО, КПС, КЭК");
		
	Для Каждого СтрокаОснования Из ТаблицаДляЗаполнения Цикл
		
		Если СтрокаОснования.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Объект.РасшифровкаПлатежа.Добавить(), СтрокаОснования);
		
	КонецЦикла;
	
	Объект.СуммаДокумента = Объект.РасшифровкаПлатежа.Итог("Сумма");
	
КонецПроцедуры

