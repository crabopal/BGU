#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"ПрисоединитьДополнительныеТаблицы
	|ЭтотСписок КАК ЭтотСписок
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|	ПО ЭтотСписок.Контрагент.ЮридическоеФизическоеЛицо = Пользователи.ФизическоеЛицо
	|
	|;
	|РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)
	|	И ЗначениеРазрешено(Пользователи.Ссылка, NULL КАК ИСТИНА)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

// Инициализирует таблицы значений, содержащие данные табличных частей документа.
// Таблицы значений сохраняет в свойствах структуры "ДополнительныеСвойства".
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	                      |	ДанныеДокумента.Ссылка.Организация КАК Организация,
	                      |	ВЫБОР
	                      |		КОГДА ДанныеДокумента.Ссылка.Подразделение.ВедетсяКассоваяКнига
	                      |			ТОГДА ДанныеДокумента.Ссылка.Подразделение
	                      |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.Пустаяссылка)
	                      |	КОНЕЦ КАК Подразделение,
	                      |	ДанныеДокумента.Ссылка.ВалютаДокумента КАК Валюта,
	                      |	ДанныеДокумента.Ссылка.Дата КАК Период,
	                      |	ДанныеДокумента.КФО КАК КФО,
	                      |	СУММА(ДанныеДокумента.Сумма) КАК Сумма
	                      |ИЗ
	                      |	Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК ДанныеДокумента
	                      |ГДЕ
	                      |	ДанныеДокумента.Ссылка = &Ссылка
	                      |	И ДанныеДокумента.Ссылка.Оплачено = ИСТИНА
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ДанныеДокумента.КФО,
	                      |	ДанныеДокумента.Ссылка.Дата,
	                      |	ДанныеДокумента.Ссылка.Организация,
	                      |	ДанныеДокумента.Ссылка.ВалютаДокумента,
	                      |	ВЫБОР
	                      |		КОГДА ДанныеДокумента.Ссылка.Подразделение.ВедетсяКассоваяКнига
	                      |			ТОГДА ДанныеДокумента.Ссылка.Подразделение
	                      |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.Пустаяссылка)
	                      |	КОНЕЦ");	
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	НаличныеДенежныеСредстваДвижения = Запрос.Выполнить().Выгрузить();
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("НаличныеДенежныеСредства",  НаличныеДенежныеСредстваДвижения);
		
КонецПроцедуры // ИнициализироватьДанныеДокумента()

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.РасходныйКассовыйОрдер";
	КомандаПечати.Идентификатор		= "КО2";
	КомандаПечати.Представление		= НСтр("ru = 'Расходный кассовый ордер'");
	КомандаПечати.Порядок			= 1;
	
	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "РасчетныйДокументБезККТ", 5);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"КО2") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"КО2","РКО",ПечатьКО2(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
		
КонецПроцедуры // Печать()

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьКО2(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_КО2";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_КО2");
	
	Запрос = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	РасходныйКассовыйОрдер.Ссылка КАК Ссылка,
	|	РасходныйКассовыйОрдер.Номер КАК Номер,
	|	РасходныйКассовыйОрдер.Дата КАК ДатаДокумента,
	|	РасходныйКассовыйОрдер.Организация КАК Организация,
	|	РасходныйКассовыйОрдер.Подразделение КАК Подразделение,
	|	ЕСТЬNULL(РасходныйКассовыйОрдер.ПодразделениеКор.Код, """") КАК КодПодразделения,
	|	РасходныйКассовыйОрдер.СуммаДокумента КАК СуммаДокумента,
	|	РасходныйКассовыйОрдер.ПодразделениеКор КАК ПодразделениеКор,
	|	РасходныйКассовыйОрдер.Счет КАК Счет,
	|	РасходныйКассовыйОрдер.КорСчет КАК КорСчет,
	|	РасходныйКассовыйОрдер.КодАналитическогоУчета КАК КодАналитическогоУчета,
	|	РасходныйКассовыйОрдер.КодЦелевогоНазначения.Код КАК КодЦелевогоНазначения,
	|	РасходныйКассовыйОрдер.ВалютаДокумента КАК ВалютаДокумента,
	|	РасходныйКассовыйОрдер.Выдать КАК ФИОПолучателя,
	|	РасходныйКассовыйОрдер.Основание КАК Основание,
	|	РасходныйКассовыйОрдер.Приложение КАК Приложение,
	|	РасходныйКассовыйОрдер.Руководитель КАК Руководитель,
	|	РасходныйКассовыйОрдер.ГлБухгалтер КАК ГлБухгалтер,
	|	РасходныйКассовыйОрдер.Кассир КАК Кассир,
	|	РасходныйКассовыйОрдер.ПоДокументу КАК РеквизитыДокументаУдостоверяющегоЛичность,
	|	ВЫБОР
	|		КОГДА РасходныйКассовыйОрдер.Организация.ИспользоватьВПлатежныхДокументахСокращенноеНаименование = ИСТИНА
	|			ТОГДА РасходныйКассовыйОрдер.Организация.НаименованиеСокращенное
	|		ИНАЧЕ РасходныйКассовыйОрдер.Организация.НаименованиеПолное
	|	КОНЕЦ КАК ПредставлениеОрганизации,
	|	РасходныйКассовыйОрдер.Организация.НаименованиеСокращенное КАК СокращенноеНаименованиеОрганизации,
	|	ВЫБОР
	|		КОГДА РасходныйКассовыйОрдер.Подразделение.НаименованиеПолное = """"
	|			ТОГДА РасходныйКассовыйОрдер.Подразделение.Наименование
	|		ИНАЧЕ РасходныйКассовыйОрдер.Подразделение.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеПодразделения,
	|	РасходныйКассовыйОрдер.Организация.Префикс КАК ПрефиксОрганизации,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.КоличествоКФО = 1
	|			ТОГДА ВложенныйЗапрос.КФО
	|		ИНАЧЕ ""0""
	|	КОНЕЦ КАК КФО,
	|	РасходныйКассовыйОрдер.Организация.КодОКПО КАК ОрганизацияПоОКПО,
	|	ЛОЖЬ КАК Фондовый,
	|	РасходныйКассовыйОрдер.Организация.НаименованиеПолное КАК ПолноеНаименованиеОрганизации
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка КАК Ссылка,
	|			МАКСИМУМ(РасходныйКассовыйОрдерРасшифровкаПлатежа.КФО) КАК КФО,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РасходныйКассовыйОрдерРасшифровкаПлатежа.КФО) КАК КоличествоКФО
	|		ИЗ
	|			Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК РасходныйКассовыйОрдерРасшифровкаПлатежа
	|		ГДЕ
	|			РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка В(&МассивОбъектов)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка) КАК ВложенныйЗапрос
	|		ПО РасходныйКассовыйОрдер.Ссылка = ВложенныйЗапрос.Ссылка
	|ГДЕ
	|	РасходныйКассовыйОрдер.Ссылка В(&МассивОбъектов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВедомостьНаВыдачуДенегИзКассы.Ссылка,
	|	ВедомостьНаВыдачуДенегИзКассы.Номер,
	|	ВедомостьНаВыдачуДенегИзКассы.Дата,
	|	ВедомостьНаВыдачуДенегИзКассы.Организация,
	|	ВедомостьНаВыдачуДенегИзКассы.Подразделение,
	|	ЕСТЬNULL(ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.ПодразделениеКор.Код, """"),
	|	ВедомостьНаВыдачуДенегИзКассы.СуммаВыплачено,
	|	NULL,
	|	ВедомостьНаВыдачуДенегИзКассы.Счет,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.КоличествоКорСчетов = 1
	|			ТОГДА ВложенныйЗапрос.КорСчет
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ВложенныйЗапрос.КоличествоКорСчетРодитель = 1
	|					ТОГДА ВложенныйЗапрос.КорСчетРодитель
	|				ИНАЧЕ ВложенныйЗапрос.КорСчетРодительРодитель
	|			КОНЕЦ
	|	КОНЕЦ,
	|	ВедомостьНаВыдачуДенегИзКассы.КодАналитическогоУчета,
	|	ВедомостьНаВыдачуДенегИзКассы.КодЦелевогоНазначения.Код,
	|	ВедомостьНаВыдачуДенегИзКассы.ВалютаДокумента,
	|	NULL,
	|	ВедомостьНаВыдачуДенегИзКассы.Основание,
	|	ВедомостьНаВыдачуДенегИзКассы.Приложение,
	|	ВедомостьНаВыдачуДенегИзКассы.Руководитель,
	|	ВедомостьНаВыдачуДенегИзКассы.ГлБухгалтер,
	|	ВедомостьНаВыдачуДенегИзКассы.Кассир,
	|	NULL,
	|	ВЫБОР
	|		КОГДА ВедомостьНаВыдачуДенегИзКассы.Организация.ИспользоватьВПлатежныхДокументахСокращенноеНаименование = ИСТИНА
	|			ТОГДА ВедомостьНаВыдачуДенегИзКассы.Организация.НаименованиеСокращенное
	|		ИНАЧЕ ВедомостьНаВыдачуДенегИзКассы.Организация.НаименованиеПолное
	|	КОНЕЦ,
	|	ВедомостьНаВыдачуДенегИзКассы.Организация.НаименованиеСокращенное,
	|	ВЫБОР
	|		КОГДА ВедомостьНаВыдачуДенегИзКассы.Подразделение.НаименованиеПолное = """"
	|			ТОГДА ВедомостьНаВыдачуДенегИзКассы.Подразделение.Наименование
	|		ИНАЧЕ ВедомостьНаВыдачуДенегИзКассы.Подразделение.НаименованиеПолное
	|	КОНЕЦ,
	|	ВедомостьНаВыдачуДенегИзКассы.Организация.Префикс,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.КоличествоКФО = 1
	|			ТОГДА ВложенныйЗапрос.КФО
	|		ИНАЧЕ ""0""
	|	КОНЕЦ,
	|	ВедомостьНаВыдачуДенегИзКассы.Организация.КодОКПО,
	|	ЛОЖЬ,
	|	ВедомостьНаВыдачуДенегИзКассы.Организация.НаименованиеПолное
	|ИЗ
	|	Документ.ВедомостьНаВыдачуДенегИзКассы КАК ВедомостьНаВыдачуДенегИзКассы
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка КАК Ссылка,
	|			МАКСИМУМ(ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КФО) КАК КФО,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КФО) КАК КоличествоКФО,
	|			СУММА(ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Сумма) КАК Сумма,
	|			МАКСИМУМ(ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КорСчет) КАК КорСчет,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КорСчет) КАК КоличествоКорСчетов,
	|			МАКСИМУМ(ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КорСчет.Родитель) КАК КорСчетРодитель,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КорСчет.Родитель) КАК КоличествоКорСчетРодитель,
	|			МАКСИМУМ(ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КорСчет.Родитель.Родитель) КАК КорСчетРодительРодитель,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.КорСчет.Родитель.Родитель) КАК КоличествоКорСчетРодительРодитель
	|		ИЗ
	|			Документ.ВедомостьНаВыдачуДенегИзКассы.РасшифровкаПлатежа КАК ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа
	|		ГДЕ
	|			ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка В(&МассивОбъектов)
	|			И ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Выплачено
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка) КАК ВложенныйЗапрос
	|		ПО ВедомостьНаВыдачуДенегИзКассы.Ссылка = ВложенныйЗапрос.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВедомостьНаВыдачуДенегИзКассы.РасшифровкаПлатежа КАК ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа
	|		ПО ВедомостьНаВыдачуДенегИзКассы.Ссылка = ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.Ссылка
	|			И (ВедомостьНаВыдачуДенегИзКассыРасшифровкаПлатежа.НомерСтроки = 1)
	|ГДЕ
	|	ВедомостьНаВыдачуДенегИзКассы.Ссылка В(&МассивОбъектов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПлатежнаяВедомость.Ссылка,
	|	ПлатежнаяВедомость.Номер,
	|	ПлатежнаяВедомость.Дата,
	|	ПлатежнаяВедомость.Организация,
	|	ПлатежнаяВедомость.Подразделение,
	|	ПлатежнаяВедомость.ПодразделениеКор.Код,
	|	ПлатежнаяВедомость.СуммаВыплачено,
