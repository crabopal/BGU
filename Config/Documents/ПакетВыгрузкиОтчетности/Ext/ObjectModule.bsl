#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИсторияСостоянийПакетаОтчетов.ПакетОтчетов
	|ИЗ
	|	РегистрСведений.ИсторияСостоянийПакетаОтчетов КАК ИсторияСостоянийПакетаОтчетов
	|ГДЕ
	|	ИсторияСостоянийПакетаОтчетов.ПакетОтчетов = &Ссылка";
	
	Если Запрос.Выполнить().Пустой() Тогда 
		
		МенеджерЗаписи = РегистрыСведений.ИсторияСостоянийПакетаОтчетов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = Дата;
		МенеджерЗаписи.ПакетОтчетов = Ссылка;
		МенеджерЗаписи.Состояние = Перечисления.СостоянияПакетаОтчетов.Сформирован;
		МенеджерЗаписи.Записать();
		
	КонецЕсли;	
	
КонецПроцедуры


// ОБРАБОТЧИКИ СОБЫТИЙ
////////////////////////////////////////////////////////////////////////////////
// Заполнение

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	УстановитьПривилегированныйРежим(Истина);
	ТипЗначения = ТипЗнч(ДанныеЗаполнения);
	Если ТипЗначения = Тип("Структура") И ДанныеЗаполнения.Свойство("СпособЗаполнения") Тогда 
		Если ДанныеЗаполнения.СпособЗаполнения = "ЗаполнениеПоДаннымОбработкиВыгрузки" Тогда 
			СтандартнаяОбработка = Ложь;
			ЗаполнитьПоДаннымОбработкиВыгрузки(ДанныеЗаполнения);
			
		Иначе 
			ВызватьИсключение "Неизвестный способ заполнения";
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Дата) Тогда 
		Дата = ТекущаяДата();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПоДаннымОбработкиВыгрузки(ДанныеЗаполнения)
	
	// Ожидаемая структура данных
	// ДанныеЗаполнения.СпособЗаполнения
	// ДанныеЗаполнения.Организация
	// ДанныеЗаполнения.Период
	// ДанныеЗаполнения.УИДОбработкиФормата
	// ДанныеЗаполнения.ДанныеОбработки //структура
	// ДанныеЗаполнения.ДанныеОбработки.ФорматВыгрузки
	// ДанныеЗаполнения.ДанныеОбработки.СпособВыгрузки
	// ДанныеЗаполнения.ДанныеОбработки.ДополнительныеНастройкиФормата
	// ДанныеЗаполнения.ДанныеОбработки.Зависимости //таблица
	// ДанныеЗаполнения.ДанныеОбработки.Зависимости.ИсходныйОтчет
	// ДанныеЗаполнения.ДанныеОбработки.Зависимости.ОтчетнаяФорма
	// ДанныеЗаполнения.ДанныеОбработки.Зависимости.ВыбранныйОтчет
	// ДанныеЗаполнения.ДанныеОбработки.ПутьВыгрузки
	// ДанныеЗаполнения.ДанныеОбработки.НастройкаЭкспорта
	
	// ДанныеЗаполнения.Отчеты //таблица
	// ДанныеЗаполнения.Отчеты.Отчет 
	// ДанныеЗаполнения.Отчеты.Группа
	// ДанныеЗаполнения.Отчеты.КодОтчетнойФормы.
	
	// ДанныеЗаполнения.ФайлыОтчетов //таблица
	// ДанныеЗаполнения.ФайлыОтчетов.Группа
	// ДанныеЗаполнения.ФайлыОтчетов.ДанныеФайлов.
	
	// ДанныеЗаполнения.Протокол //таблица
	// ДанныеЗаполнения.Протокол.Отчет 
	// ДанныеЗаполнения.Протокол.ТекстСообщения
	// ДанныеЗаполнения.Протокол.Важность
	
	// ДанныеЗаполнения.ДопДанныеГрупп //таблица
	// ДанныеЗаполнения.ДопДанныеГрупп.Группа 
	// ДанныеЗаполнения.ДопДанныеГрупп.ВидОтправляемогоДокумента
	// ДанныеЗаполнения.ДопДанныеГрупп.КодИФНС
	// ДанныеЗаполнения.ДопДанныеГрупп.НомерКорректировки
	
	// ДанныеЗаполнения.ПрисоединенныеФайлыДляВыгрузки // Таблица
	// ДанныеЗаполнения.ПрисоединенныеФайлыДляВыгрузки.Отчет
	// ДанныеЗаполнения.ПрисоединенныеФайлыДляВыгрузки.СсылкаНаПрисоединенныйФайл
	
	
	РеквизитыФормата.Очистить();
	ОтчетыПакета.Очистить();
	Протокол.Очистить();
	ФайлыОтчетов.Очистить();
	Зависимости.Очистить();
	ДопДанныеГрупп.Очистить();
	ЭлектронныеЦифровыеПодписи.Очистить();
	ПрисоединенныеФайлыОтчетов.Очистить();
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,ДанныеЗаполнения,"Организация,Период,УИДОбработкиФормата");
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,ДанныеЗаполнения.ДанныеОбработки,"ФорматВыгрузки,СпособВыгрузки,ПутьВыгрузки,НастройкаЭкспорта");
	
	
	Для Каждого СтрокаДопНастроек Из ДанныеЗаполнения.ДанныеОбработки.ДополнительныеНастройкиФормата Цикл 
		
		НоваяСтрока = РеквизитыФормата.Добавить();
		НоваяСтрока.ИмяРеквизита = СтрокаДопНастроек.Имя;
		НоваяСтрока.Представление = СтрокаДопНастроек.Заголовок; 
		НоваяСтрока.Значение = СтрокаДопНастроек.ЗначениеХранилище;
		НоваяСтрока.ПредставлениеЗначения = СтрокаДопНастроек.ПредставлениеЗначения;
		
	КонецЦикла;
	
	
	Для Каждого СтрокаОтчета Из ДанныеЗаполнения.Отчеты Цикл 
		
		НоваяСтрока = ОтчетыПакета.Добавить();
		НоваяСтрока.ОтчетСсылка = СтрокаОтчета.Отчет;
		НоваяСтрока.Группа 		= СтрокаОтчета.Группа;
		НоваяСтрока.КодОтчетнойФормы = СтрокаОтчета.КодОтчетнойФормы;
		
	КонецЦикла;
	
	Для Каждого СтрокаОтчета Из ОтчетыПакета Цикл 
		
		НайденныеСтроки = ДанныеЗаполнения.ДанныеОбработки.Зависимости.НайтиСтроки(Новый Структура("ИсходныйОтчет",СтрокаОтчета.ОтчетСсылка));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НоваяСтрока = Зависимости.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,НайденнаяСтрока);
			
		КонецЦикла;
	КонецЦикла;	
	
	
	Для Каждого СтрокаОтчета Из ОтчетыПакета Цикл 
		
		НайденныеСтроки = ДанныеЗаполнения.Протокол.НайтиСтроки(Новый Структура("Отчет",СтрокаОтчета.ОтчетСсылка));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл  
			НоваяСтрока = Протокол.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,НайденнаяСтрока);
			
		КонецЦикла;	
	КонецЦикла;	
	
	ГруппыОтчетов = ОтчетыПакета.Выгрузить(,"Группа");
	ГруппыОтчетов.Свернуть("Группа");
	
	Для Каждого ГруппаОтчетов Из ГруппыОтчетов Цикл
		
		НайденныеСтроки = ДанныеЗаполнения.ФайлыОтчетов.НайтиСтроки(Новый Структура("Группа",ГруппаОтчетов.Группа));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
			НоваяСтрока = ФайлыОтчетов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,НайденнаяСтрока);
			НоваяСтрока.ДанныеФайлов = Новый ХранилищеЗначения(НайденнаяСтрока.ДанныеФайлов);
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого ГруппаОтчетов Из ГруппыОтчетов Цикл
		
		НайденныеСтроки = ДанныеЗаполнения.ДопДанныеГрупп.НайтиСтроки(Новый Структура("Группа",ГруппаОтчетов.Группа));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
			НоваяСтрока = ДопДанныеГрупп.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,НайденнаяСтрока);
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого СтрФайлов Из ДанныеЗаполнения.ПрисоединенныеФайлыДляВыгрузки Цикл 
		
		НоваяСтрока = ПрисоединенныеФайлыОтчетов.Добавить();  
		НоваяСтрока.ОтчетСсылка = СтрФайлов.Отчет;
		НоваяСтрока.ФайлСсылка = СтрФайлов.СсылкаНаПрисоединенныйФайл; 
		
	КонецЦикла;
	
КонецПроцедуры

// Заполнение
////////////////////////////////////////////////////////////////////////////////
// ЭЦП
// Подготовка к формированию

Процедура ЗаполнитьОписаниеФайловДляФормированияПодписей(ОсновнаяСтруктураДанных) Экспорт
	Если ОсновнаяСтруктураДанных.Отказ Тогда 
		Возврат;
	КонецЕсли;	
	
	СтруктураДанных = СформироватьСтруктуруДанныхЗаполненияОписаний(ОсновнаяСтруктураДанных);
	
	ЗаполнитьИнформациюОСформированныхПодписях(СтруктураДанных);
	
	Для Каждого ДанныеТекущейГруппы Из ЭтотОбъект.ФайлыОтчетов Цикл 
		
		СтруктураДанных.ДанныеТекущейГруппы = ДанныеТекущейГруппы;
		
		ПодготовитьВременныеФайлы(СтруктураДанных);
		ПрочитатьДанныеГруппы(СтруктураДанных);
		УдалитьВременныеФалы(СтруктураДанных);
		
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьСтруктуруДанныхЗаполненияОписаний(ОсновнаяСтруктураДанных)
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВременныйКаталог","");
	СтруктураДанных.Вставить("ИмяВременногоФайлаАрхиваДляЧтения","");
	СтруктураДанных.Вставить("ИмяВременногоФайлаАрхиваДляЗаписи",""); // Не используется нужно для общих процедур.
	СтруктураДанных.Вставить("ЧтениеZip");
	СтруктураДанных.Вставить("ДанныеТекущейГруппы");
	

	СтруктураДанных.Вставить("МассивСтрокДляЧтенияПодписей"); // Не используется нужно для общих процедур.
	СтруктураДанных.Вставить("ТаблицаСформированныхПодписей",Новый ТаблицаЗначений);
	СтруктураДанных.ТаблицаСформированныхПодписей.Колонки.Добавить("Группа",Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
	СтруктураДанных.ТаблицаСформированныхПодписей.Колонки.Добавить("ОтносительныйПутьФайлаПодписи",Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	
	СтруктураДанных.Вставить("ОсновнаяСтруктура",ОсновнаяСтруктураДанных);
	
	Возврат СтруктураДанных;
	
КонецФункции

Процедура ПрочитатьДанныеГруппы(СтруктураДанных)
	
	РаспаковатьАрхив(СтруктураДанных);
	
	Для Каждого ФайлВАрхиве Из СтруктураДанных.ЧтениеZip.Элементы Цикл 
		
		НайденныеСтроки = СтруктураДанных.ТаблицаСформированныхПодписей.НайтиСтроки(Новый Структура("Группа,ОтносительныйПутьФайлаПодписи", СтруктураДанных.ДанныеТекущейГруппы.Группа, ФайлВАрхиве.ПолноеИмя));
		Если ЗначениеЗаполнено(НайденныеСтроки) Тогда 
			Продолжить; // Это файл другой подписи его мы подписывать не будем.
		КонецЕсли;
		
		СтруктураОписанияФайла = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСервер.ПолучитьПустуюСтруктуруПараметров("ФайлыДляСозданияПодписей");
		СтруктураДанных.ОсновнаяСтруктура.ФайлыДляСозданияПодписей.Добавить(СтруктураОписанияФайла);
		
		СтруктураОписанияФайла.Группа = СтруктураДанных.ДанныеТекущейГруппы.Группа;
		ЗаполнитьЗначенияСвойств(СтруктураОписанияФайла,ФайлВАрхиве,"Имя,Путь,ПолноеИмя,ИмяБезРасширения");
		СтруктураОписанияФайла.ДанныеФайла = Новый ДвоичныеДанные(СтруктураДанных.ВременныйКаталог+ФайлВАрхиве.ПолноеИмя);
		
	КонецЦикла;
	
	
	
КонецПроцедуры

// Подготовка к формированию
////////////////////////////////////////////////////////////////////////////////
// Запись данных сформированных подписей.

Процедура ДобавитьНовыеПодписи(ОсновнаяСтруктураДанных) Экспорт 
	Если ОсновнаяСтруктураДанных.Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	СтруктураДанных = СформироватьСтруктуруДанныхДобавленияПодписей(ОсновнаяСтруктураДанных);
	
	Для Каждого ДанныеТекущейГруппы Из ЭтотОбъект.ФайлыОтчетов Цикл
		СтруктураДанных.ДанныеТекущейГруппы = ДанныеТекущейГруппы; 
		ПодготовитьВременныеФайлы(СтруктураДанных);
		
		НайтиФалыТекущейГруппы(СтруктураДанных);
		ДобавитьФайлыКАрхиву(СтруктураДанных);
		
		
		УдалитьВременныеФалы(СтруктураДанных);
	КонецЦикла;
	
	Для Каждого СтрокаОписанияСертификата Из СтруктураДанных.ОсновнаяСтруктура.МассивОписанийСертификатов Цикл
		
		НоваяСтрока =ЭтотОбъект.ЭлектронныеЦифровыеПодписи.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаОписанияСертификата,"КомуВыданСертификат,Отпечаток,ДатаПодписи,Комментарий,УстановившийПодпись");
		
		Если ЗначениеЗаполнено(СтрокаОписанияСертификата.СертификатСсылка) Тогда 	
			НоваяСтрока.СертификатСсылка = СтрокаОписанияСертификата.СертификатСсылка;
		Иначе 
			НоваяСтрока.Сертификат =  БюджетнаяОтчетностьКлиентСервер.ЗаписатьЗначениеВXML(СтрокаОписанияСертификата.Сертификат); //для совместимости
		КонецЕсли;	

		НоваяСтрока.ПутиПодписей = БюджетнаяОтчетностьКлиентСервер.ЗаписатьЗначениеВXML(СтрокаОписанияСертификата.ПутиПодписей);
		
	КонецЦикла;	
	
	
КонецПроцедуры

Функция СформироватьСтруктуруДанныхДобавленияПодписей(ОсновнаяСтруктураДанных)
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВременныйКаталог","");
	СтруктураДанных.Вставить("ИмяВременногоФайлаАрхиваДляЧтения","");
	СтруктураДанных.Вставить("ИмяВременногоФайлаАрхиваДляЗаписи","");
	СтруктураДанных.Вставить("ЧтениеZip");
	СтруктураДанных.Вставить("ДанныеТекущейГруппы");
	СтруктураДанных.Вставить("ДанныеТекущегоИсходногоФайла");
	СтруктураДанных.Вставить("ДанныеТекущейПодписи");
	
	СтруктураДанных.Вставить("МассивФайловТекущейГруппы",Новый Массив);
	
	СтруктураДанных.Вставить("ОсновнаяСтруктура",ОсновнаяСтруктураДанных);
	
	Возврат СтруктураДанных;
	
КонецФункции	

Процедура НайтиФалыТекущейГруппы(СтруктураДанных)
	СтруктураДанных.МассивФайловТекущейГруппы = Новый Массив;
	
	Для Каждого СтрокаФайлаДляСозданияПодписи Из СтруктураДанных.ОсновнаяСтруктура.ФайлыДляСозданияПодписей Цикл 
		Если СтрокаФайлаДляСозданияПодписи.Группа <> СтруктураДанных.ДанныеТекущейГруппы.Группа Тогда 
			Продолжить;
		КонецЕсли;
		
		СтруктураДанных.МассивФайловТекущейГруппы.Добавить(СтрокаФайлаДляСозданияПодписи);
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура ДобавитьФайлыКАрхиву(СтруктураДанных)
	
	РаспаковатьАрхив(СтруктураДанных);
	Для Каждого ДанныеТекущегоИсходногоФайла Из СтруктураДанных.МассивФайловТекущейГруппы Цикл 
		СтруктураДанных.ДанныеТекущегоИсходногоФайла = ДанныеТекущегоИсходногоФайла;
		
		Для Каждого ДанныеТекущейПодписи Из ДанныеТекущегоИсходногоФайла.МассивСформированныхПодписей Цикл
			СтруктураДанных.ДанныеТекущейПодписи = ДанныеТекущейПодписи;
			
			ПодготовитьИмяФайлаПодписи(СтруктураДанных);
			ЗаписатьФайлПодписи(СтруктураДанных);
			ДобавитьИнформациюОПодписиВСтрокуСертификата(СтруктураДанных);
			
			
		КонецЦикла;
	КонецЦикла;
	СоздатьНовыйАрхив(СтруктураДанных);
	
КонецПроцедуры

Процедура ПодготовитьИмяФайлаПодписи(СтруктураДанных)
	
	
	ОбщийШаблон = "%1-%2%3.%4";
	// %1 - исходное имя файла
	// %2 - Владелец сертификата
	// %3 - Место для подстановки номера файла с одинаковым именем. должно быть заменено на %1 в ходе формирования шаблона
	// %4 - расширения
	//ИмяИсходного-Владелец(1).p7s
	
	ИсходноеИмяФайла = СтруктураДанных.ДанныеТекущегоИсходногоФайла.ИмяБезРасширения;
	ВладелецСертификата =  СтруктураДанных.ДанныеТекущейПодписи.ОписаниеСертификата.КомуВыданСертификат;
	
	ЗапрещенныеСимволы = "/\|:*?""<>";
	Колво = СтрДлина(ЗапрещенныеСимволы);
	Для Инд = 1 По Колво Цикл
		ВладелецСертификата = СтрЗаменить(ВладелецСертификата,Сред(ЗапрещенныеСимволы,Инд,1),"");
	КонецЦикла;
	ВладелецСертификата = СокрЛП(ВладелецСертификата);
	ВладелецСертификата = Лев(ВладелецСертификата,30);
	
	Расширение = СтруктураДанных.ОсновнаяСтруктура.ПерсональныеНастройкиРаботыСЭЦП.РасширениеДляФайловПодписи;
	
	ШаблонИмениФайлаПодписи = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОбщийШаблон,ИсходноеИмяФайла, ВладелецСертификата, "%1", Расширение);
	
	ШаблонПутиПроверяемогоФайла = СтруктураДанных.ВременныйКаталог + СтруктураДанных.ДанныеТекущегоИсходногоФайла.Путь + ШаблонИмениФайлаПодписи;
	
	ПутьУникальногоФайла = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСервер.ПолучитьУникальноеИмяФайла(ШаблонПутиПроверяемогоФайла);
	
	СтруктураИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ПутьУникальногоФайла);
	
	СтруктураДанных.ДанныеТекущейПодписи.ИмяФайлаПодписи = СтруктураИмениФайла.Имя;
	СтруктураДанных.ДанныеТекущейПодписи.ПолныйПутьФайлаПодписи = СтруктураИмениФайла.ПолноеИмя;
	СтруктураДанных.ДанныеТекущейПодписи.ОтносительныйПутьФайлаПодписи = СтрЗаменить(СтруктураИмениФайла.ПолноеИмя, СтруктураДанных.ВременныйКаталог, "");
	
КонецПроцедуры	

Процедура ЗаписатьФайлПодписи(СтруктураДанных)
	
	ДвоичныеДанныеПодписи = СтруктураДанных.ДанныеТекущейПодписи.НоваяПодписьДвоичныеДанные;
	ДвоичныеДанныеПодписи.Записать(СтруктураДанных.ДанныеТекущейПодписи.ПолныйПутьФайлаПодписи);
	
КонецПроцедуры	

Процедура ДобавитьИнформациюОПодписиВСтрокуСертификата(СтруктураДанных)
	
	Для Каждого СтрокаОписанияСертификата Из СтруктураДанных.ОсновнаяСтруктура.МассивОписанийСертификатов Цикл 
		Если СтрокаОписанияСертификата.Отпечаток <> СтруктураДанных.ДанныеТекущейПодписи.ОписаниеСертификата.Отпечаток Тогда 
			Продолжить;
		КонецЕсли;
		
		СтрокаПутиПодписи = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСервер.ПолучитьПустуюСтруктуруПараметров("ПутиПодписей");
		СтрокаПутиПодписи.ОтносительныйПутьФайлаПодписи = СтруктураДанных.ДанныеТекущейПодписи.ОтносительныйПутьФайлаПодписи;
		СтрокаПутиПодписи.Группа = СтруктураДанных.ДанныеТекущегоИсходногоФайла.Группа;
		
		СтрокаОписанияСертификата.ПутиПодписей.Добавить(СтрокаПутиПодписи);
		
		Возврат;
	КонецЦикла;
	
	ВызватьИсключение "Не найден сертификат по которому сформирована подпись.";
КонецПроцедуры


// Запись данных сформированных подписей.
////////////////////////////////////////////////////////////////////////////////
// удаление подписей

Процедура УдалитьСтрокиЭЦП(МассивСтрокДляУдаления) Экспорт
	Если Не ЗначениеЗаполнено(МассивСтрокДляУдаления) Тогда 
		Возврат;
	КонецЕсли;
	
	СтруктураДанных = СформироватьСтруктуруДанныхУдаленияПодписей(); 
	СтруктураДанных.МассивСтрокДляЧтенияПодписей = МассивСтрокДляУдаления; 
	ЗаполнитьИнформациюОСформированныхПодписях(СтруктураДанных);
	
	Для Каждого ДанныеТекущейГруппы Из ЭтотОбъект.ФайлыОтчетов Цикл 
		СтруктураДанных.ДанныеТекущейГруппы = ДанныеТекущейГруппы;
		
		ПодготовитьВременныеФайлы(СтруктураДанных);
		РаспаковатьАрхив(СтруктураДанных);
		
		УдалитьФайлыПодписей(СтруктураДанных);
		
		СоздатьНовыйАрхив(СтруктураДанных);
		УдалитьВременныеФалы(СтруктураДанных);
	КонецЦикла;
	
	Для Каждого СтрокаДляУдаления Из СтруктураДанных.МассивСтрокДляЧтенияПодписей Цикл 
		
		ЭтотОбъект.ЭлектронныеЦифровыеПодписи.Удалить(СтрокаДляУдаления);
		
	КонецЦикла;	
КонецПроцедуры	

Функция СформироватьСтруктуруДанныхУдаленияПодписей()
	СтруктураДанных = Новый Структура();
	
	СтруктураДанных.Вставить("ВременныйКаталог","");
	СтруктураДанных.Вставить("ИмяВременногоФайлаАрхиваДляЧтения","");
	СтруктураДанных.Вставить("ИмяВременногоФайлаАрхиваДляЗаписи","");
	СтруктураДанных.Вставить("ЧтениеZip");
	СтруктураДанных.Вставить("ДанныеТекущейГруппы");
	
	
	СтруктураДанных.Вставить("МассивСтрокДляЧтенияПодписей",Новый Массив);
	СтруктураДанных.Вставить("ТаблицаСформированныхПодписей",Новый ТаблицаЗначений);
	СтруктураДанных.ТаблицаСформированныхПодписей.Колонки.Добавить("Группа",Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
	СтруктураДанных.ТаблицаСформированныхПодписей.Колонки.Добавить("ОтносительныйПутьФайлаПодписи",Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	
	Возврат СтруктураДанных;
	
КонецФункции	

Процедура УдалитьФайлыПодписей(СтруктураДанных)
	
	ПодписиВЭтойГруппе = СтруктураДанных.ТаблицаСформированныхПодписей.НайтиСтроки(Новый Структура("Группа",СтруктураДанных.ДанныеТекущейГруппы.Группа));
	
	Для Каждого ПодписьДляУдаления Из ПодписиВЭтойГруппе Цикл 
		
		УдалитьФайлы(СтруктураДанных.ВременныйКаталог + ПодписьДляУдаления.ОтносительныйПутьФайлаПодписи); 
		
	КонецЦикла;
	
	
КонецПроцедуры	

// удаление подписей 
////////////////////////////////////////////////////////////////////////////////
// Общие

Процедура ПодготовитьВременныеФайлы(СтруктураДанных)
	
	СтруктураДанных.ИмяВременногоФайлаАрхиваДляЧтения = ПолучитьИмяВременногоФайла("ZIP");
	СтруктураДанных.ИмяВременногоФайлаАрхиваДляЗаписи = ПолучитьИмяВременногоФайла("ZIP");
	
	СтруктураДанных.ВременныйКаталог  = ПолучитьИмяВременногоФайла()+ПолучитьРазделительПути();
	СоздатьКаталог(СтруктураДанных.ВременныйКаталог);
	
	
КонецПроцедуры

Процедура УдалитьВременныеФалы(СтруктураДанных)
	
	Попытка 
		УдалитьФайлы(СтруктураДанных.ИмяВременногоФайлаАрхиваДляЧтения);
	Исключение
	КонецПопытки;
	
	Попытка
		УдалитьФайлы(СтруктураДанных.ИмяВременногоФайлаАрхиваДляЗаписи);	
	Исключение
	КонецПопытки;
	
	Попытка
		УдалитьФайлы(СтруктураДанных.ВременныйКаталог); 
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Процедура РаспаковатьАрхив(СтруктураДанных)
	
	ДвоичныеДанныеАрхива = СтруктураДанных.ДанныеТекущейГруппы.ДанныеФайлов.Получить();
	ДвоичныеДанныеАрхива.Записать(СтруктураДанных.ИмяВременногоФайлаАрхиваДляЧтения);
	
	ЧтениеZip = Новый ЧтениеZipФайла(СтруктураДанных.ИмяВременногоФайлаАрхиваДляЧтения);
	ЧтениеZip.ИзвлечьВсе(СтруктураДанных.ВременныйКаталог);
	
	СтруктураДанных.ЧтениеZip = ЧтениеZip;
КонецПроцедуры	

Процедура СоздатьНовыйАрхив(СтруктураДанных)
	
	ЗаписьZip = Новый ЗаписьZipФайла(СтруктураДанных.ИмяВременногоФайлаАрхиваДляЗаписи);
	ЗаписьZip.Добавить(СтруктураДанных.ВременныйКаталог + "*", РежимСохраненияПутейZIP.СохранятьОтносительныеПути, РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
	ЗаписьZip.Записать();
	
	ДвоичныеДанныеНовогоАрхива = Новый ДвоичныеДанные(СтруктураДанных.ИмяВременногоФайлаАрхиваДляЗаписи);
	СтруктураДанных.ДанныеТекущейГруппы.ДанныеФайлов = Новый ХранилищеЗначения(ДвоичныеДанныеНовогоАрхива);
	
	
КонецПроцедуры	

Процедура ЗаполнитьИнформациюОСформированныхПодписях(СтруктураДанных)
	
	Для Каждого СтрокаЭЦП Из ЭтотОбъект.ЭлектронныеЦифровыеПодписи Цикл 
		Если Не ЗначениеЗаполнено(СтрокаЭЦП.ПутиПодписей) Тогда 
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураДанных.МассивСтрокДляЧтенияПодписей) И СтруктураДанных.МассивСтрокДляЧтенияПодписей.Найти(СтрокаЭЦП) = Неопределено Тогда 
			Продолжить;
		КонецЕсли;	
		
		МассивСформированныхПодписей = БюджетнаяОтчетностьКлиентСервер.ПрочитатьЗначениеИзXML(СтрокаЭЦП.ПутиПодписей,Тип("Массив"));
		
		Для Каждого СтруктураОписанияПодписи Из МассивСформированныхПодписей Цикл 
			
			НоваяСтрока = СтруктураДанных.ТаблицаСформированныхПодписей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтруктураОписанияПодписи);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры	

