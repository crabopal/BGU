// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// Печать

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	// Устанавливаем признак доступности печати покомплектно.
	ПараметрыВывода.ДоступнаПечатьПоКомплектно = Ложь;
	
	// Проверяем, нужно ли для макета СчетЗаказа формировать табличный документ.
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПротоколВыгрузки") Тогда
		
		ИмяМакета = "ПротоколВыгрузки";
		СинонимМакета = НСтр("ru = 'Протокол выгрузки отчетов'");
		ТабличныйДокумент = СформироватьПротоколФормирования(МассивОбъектов);

		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ТабличныйДокумент);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура формирует протокол выгрузки отчетов.
//
Функция СформироватьПротоколФормирования(МассивОбъектов)

	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПакетВыгрузкиОтчетности.ПФ_MXL_ПротоколВыгрузки");


	ДокументПротокол = Новый ТабличныйДокумент;
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьЗаголовок.Параметры.ДатаВыгрузки = ТекущаяДатаСеанса();
	ОбластьЗаголовок.Параметры.Пользователь = Пользователи.АвторизованныйПользователь();
	
	ДокументПротокол.Вывести(ОбластьЗаголовок);
	
	
	// Сбор данных для вывода
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПакетыОтчетов", МассивОбъектов);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПакетВыгрузкиОтчетности.Ссылка КАК ДокументПакет,
	|	ПакетВыгрузкиОтчетности.Представление КАК ДокументПакетПредставление,
	|	ЕСТЬNULL(ИсторияСостоянийПакетаОтчетовСрезПоследних.Состояние, ЗНАЧЕНИЕ(Перечисление.СостоянияПакетаОтчетов.Сформирован)) КАК СтатусПакета
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности КАК ПакетВыгрузкиОтчетности
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияСостоянийПакетаОтчетов.СрезПоследних(, ПакетОтчетов В (&ПакетыОтчетов)) КАК ИсторияСостоянийПакетаОтчетовСрезПоследних
	|		ПО ИсторияСостоянийПакетаОтчетовСрезПоследних.ПакетОтчетов = ПакетВыгрузкиОтчетности.Ссылка
	|ГДЕ
	|	ПакетВыгрузкиОтчетности.Ссылка В(&ПакетыОтчетов)";
	ДанныеПакетов  = Запрос.Выполнить().Выгрузить();
	

	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПакетВыгрузкиОтчетностиОтчетыПакета.ОтчетСсылка КАК ОтчетСсылка,
	|	ПакетВыгрузкиОтчетностиОтчетыПакета.ОтчетСсылка.Номер КАК Номер,
	|	ПакетВыгрузкиОтчетностиОтчетыПакета.ОтчетСсылка.Дата КАК Дата,
	|	ПакетВыгрузкиОтчетностиОтчетыПакета.ОтчетСсылка.ВидОтчета.Представление КАК ВидОтчетаПредставление,
	|	ПакетВыгрузкиОтчетностиОтчетыПакета.ОтчетСсылка.Организация.Представление КАК ОрганизацияПредставление,
	|	ПакетВыгрузкиОтчетностиОтчетыПакета.ОтчетСсылка.ПериодОтчета.Представление КАК ПериодОтчетаПредставление
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности.ОтчетыПакета КАК ПакетВыгрузкиОтчетностиОтчетыПакета
	|ГДЕ
	|	ПакетВыгрузкиОтчетностиОтчетыПакета.Ссылка В(&ПакетыОтчетов)";
	СписокДокументов = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПакетВыгрузкиОтчетностиПротокол.Отчет,
	|	ПакетВыгрузкиОтчетностиПротокол.ТекстСообщения,
	|	ПакетВыгрузкиОтчетностиПротокол.Важность
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности.Протокол КАК ПакетВыгрузкиОтчетностиПротокол
	|ГДЕ
	|	ПакетВыгрузкиОтчетностиПротокол.Ссылка В(&ПакетыОтчетов)";
	
	ДанныеПротоколов = Запрос.Выполнить().Выгрузить();
	
	// Вывод списка отчетов и сообщений выгрузки.
	
	ОбластьШапкаОтчетов = Макет.ПолучитьОбласть("ШапкаОтчеты");
	ДокументПротокол.Вывести(ОбластьШапкаОтчетов);
	ДокументПротокол.НачатьГруппуСтрок();
	
	Для Каждого ДанныеДокумента Из СписокДокументов Цикл
		
		ОбластьСтрокаОтчета = Макет.ПолучитьОбласть("СтрокаОтчет");
		ОбластьСтрокаОтчета.Параметры.Заполнить(ДанныеДокумента);

		// Доп. информация по отчету
		СтрокиПротокола = ДанныеПротоколов.Скопировать(Новый Структура("Отчет",ДанныеДокумента.ОтчетСсылка));
		СтрокиПротокола.Свернуть("Важность,ТекстСообщения");
		СообщенияИзПротокола = Новый Массив;
		ВажностьТекста = 0;
		Для Каждого СтрокаПротокола из СтрокиПротокола Цикл 
			
			СообщенияИзПротокола.Добавить(СтрокаПротокола.ТекстСообщения);
			
			Если СтрокаПротокола.Важность = "Важное" Тогда 
				ВажностьСообщения = 2;
			ИначеЕсли СтрокаПротокола.Важность = "Информация" Тогда
				ВажностьСообщения = 1;
			Иначе
				ВажностьСообщения = 0;
			КонецЕсли;
			
			ВажностьТекста = Макс(ВажностьТекста,ВажностьСообщения);
			
		КонецЦикла;
		
		ОбластьПиктограмма = ОбластьСтрокаОтчета.Области.Пиктограмма;
		Если ВажностьТекста = 2 Тогда 
			ОбластьПиктограмма.Текст = "i";
			ОбластьПиктограмма.ЦветТекста = WebЦвета.Красный;
			
		ИначеЕсли ВажностьТекста = 1 Тогда
			ОбластьПиктограмма.Текст = "i";
			ОбластьПиктограмма.ЦветТекста = WebЦвета.ТемноЗеленый;
			
		ИначеЕсли ВажностьТекста = 0 Тогда
			ОбластьПиктограмма.Текст = "";
			ОбластьПиктограмма.ЦветТекста = Новый Цвет;
			
		КонецЕсли;
		
		ОбластьСтрокаОтчета.Параметры.ТекстСообщения = СтрСоединить(СообщенияИзПротокола, Символы.ПС);
		
		ДокументПротокол.Вывести(ОбластьСтрокаОтчета);
		
	КонецЦикла;
	
	ДокументПротокол.ЗакончитьГруппуСтрок();
	
	// Вывод перечня сформированных пакетов.
	
	ОбластьШапкаПакетов = Макет.ПолучитьОбласть("ШапкаПакеты");
	ДокументПротокол.Вывести(ОбластьШапкаПакетов);
	ДокументПротокол.НачатьГруппуСтрок();
	
	Для Каждого ДанныеПакета Из ДанныеПакетов Цикл 
		ОбластьСтрокаПакета = Макет.ПолучитьОбласть("СтрокаПакет");
		ОбластьСтрокаПакета.Параметры.Заполнить(ДанныеПакета);
		ДокументПротокол.Вывести(ОбластьСтрокаПакета);
	КонецЦикла;
	
	ДокументПротокол.ЗакончитьГруппуСтрок();
	
	ДокументПротокол.ОтображатьСетку 	 = Ложь;
	ДокументПротокол.ОтображатьЗаголовки = Ложь;
	ДокументПротокол.ТолькоПросмотр		 = Истина;
	
	Возврат ДокументПротокол;
	
КонецФункции 

