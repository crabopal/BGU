#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВыгруженныеОтчеты

&НаКлиенте
Процедура ВыгруженныеОтчетыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные  = Объект.ОтчетыПакета.НайтиПоИдентификатору(ВыбраннаяСтрока);
	ПараметрыФормы = Новый Структура("Ключ", ТекущиеДанные.ОтчетСсылка);
	
	ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгруженныеОтчетыПриАктивизацииСтроки(Элемент)
	ОтчетСсылка = Неопределено;
	ТекДанные = Элементы.ВыгруженныеОтчеты.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда
		ОтчетСсылка = ТекДанные.ОтчетСсылка;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПрисоединенныеФайлыОтчетов

&НаКлиенте
Процедура ПрисоединенныеФайлыОтчетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.ПрисоединенныеФайлыОтчетов.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПоказатьЗначение(,ТекДанные.ФайлСсылка);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодписатьОтчетыЭЦП(Команда)
	
	СтруктураДанных = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент.СформироватьСтруктуруДанныхДляУстановкиПодписей();
	СтруктураДанных.ОписаниеПодписываемогоОбъекта = Объект.Ссылка; 
	СтруктураДанных.УидФормы = УникальныйИдентификатор;


	СтруктураДанных.РежимПредварительногоВыбораСертификатов = Ложь;

	
	ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент.ВыбратьСертификатыДляПодписи(СтруктураДанных);
	
	ЗаполнитьОписаниеФайловДляФормированияПодписейНаКлиенте(СтруктураДанных);
	
	ОбработкаЗаписи = Новый ОписаниеОповещения("ЗаписатьНовыеПодписиВОбъектНаКлиенте", ЭтаФорма, СтруктураДанных);	
	ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент.СоздатьПодписи(СтруктураДанных, ОбработкаЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСертификат(Команда)
	ТекДанные = Элементы.ЭлектронныеЦифровыеПодписи.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда

	ЭлектроннаяПодписьКлиент.ОткрытьСертификат(ТекДанные.СертификатСсылка);	

	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЭЦП(Команда)
	
	ТекущиеДанные = Элементы.ЭлектронныеЦифровыеПодписи.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	УдалитьЭЦПНаСервере(ТекущиеДанные.ИсходныйНомерСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСостояние(Команда)
	Если не ЗначениеЗаполнено(ДатаНовогоСостояния) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не указана дата нового состояния.'"),Объект.Ссылка,"ДатаНовогоСостояния");
		Возврат;
	КонецЕсли;
	Если не ЗначениеЗаполнено(НовоеСостояние) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не указано состояние.'"),Объект.Ссылка,"НовоеСостояние");
		Возврат;
	КонецЕсли;
	
	ДобавитьСостояниеНаСервере(ДатаНовогоСостояния, НовоеСостояние, Объект.Ссылка);
	
	ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.ИсторияСостоянийПакетаОтчетов"));
	ОповеститьОбИзменении(Объект.Ссылка);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом(Команда)
	ОбменСАрхивомКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Объект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Процедура ДобавитьСостояниеНаСервере(Дата,Состояние,Ссылка)
	
	МенеджерЗаписи = РегистрыСведений.ИсторияСостоянийПакетаОтчетов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = Дата;
	МенеджерЗаписи.ПакетОтчетов = Ссылка;
	МенеджерЗаписи.Состояние = Состояние;
	МенеджерЗаписи.Записать();	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТеряемыеДанные()
	
	Если ЗначениеЗаполнено(АдресТеряемыхНаКлиентеДанных) Тогда 
		Возврат ПолучитьИзВременногоХранилища(АдресТеряемыхНаКлиентеДанных);
	КонецЕсли;
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	
	СтруктураТеряемыхДанных = Новый Структура;
	СтруктураТеряемыхДанных.Вставить("ФайлыОтчетов");
	
	АдресТеряемыхНаКлиентеДанных = ПоместитьВоВременноеХранилище(СтруктураТеряемыхДанных,УникальныйИдентификатор);
	
	ОбновитьТеряемыеДанные(ТекущийОбъект,"ФайлыОтчетов");
	
	Возврат СтруктураТеряемыхДанных; 
	
КонецФункции

&НаСервере
Процедура ОбновитьТеряемыеДанные(ТекущийОбъект,ЭлементыДляОбновления)
	
	СтруктураТеряемыхДанных = ПолучитьТеряемыеДанные();
	
	МассивЭлементовДляОбновления = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ЭлементыДляОбновления,,Истина);
	
	Для Каждого ЭлементДляОбновления Из МассивЭлементовДляОбновления Цикл 
		Если ЭлементДляОбновления = "ФайлыОтчетов" Тогда 
			СтруктураТеряемыхДанных[ЭлементДляОбновления] = ТекущийОбъект[ЭлементДляОбновления].Выгрузить();
		КонецЕсли;
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(СтруктураТеряемыхДанных,АдресТеряемыхНаКлиентеДанных);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьТеряемыеДанныеВОбъект(ТекущийОбъект)
	
	СтруктураТеряемыхДанных = ПолучитьТеряемыеДанные();	
	
	ТекущийОбъект.ФайлыОтчетов.Загрузить(СтруктураТеряемыхДанных.ФайлыОтчетов); 
	
КонецПроцедуры	

&НаСервере
Процедура УправлениеСтраницамиПараметровВыгрузки()
	
	ИмяТранспорта = ПолучитьПолноеИмяПредопределенногоЗначения(Объект.СпособВыгрузки);
	
	Если ИмяТранспорта = "Перечисление.СпособыВыгрузкиФайлов.Каталог" Тогда 
		НужнаяСтаница = Элементы.ВыгрузкаВКаталог;
		
	ИначеЕсли ИмяТранспорта = "Перечисление.СпособыВыгрузкиФайлов.FTP" Тогда 
		НужнаяСтаница = Элементы.ВыгрузкаFTP;
		
	ИначеЕсли ИмяТранспорта = "Перечисление.СпособыВыгрузкиФайлов.ЭлектроннаяПочта" Тогда 
		НужнаяСтаница = Элементы.ВыгрузкаЧерезEmail;

		
	ИначеЕсли ИмяТранспорта = "Перечисление.СпособыВыгрузкиФайлов.ОбменСФНС" Тогда 
		НужнаяСтаница = Элементы.ВыгрузкаВФНС;
		
	ИначеЕсли ИмяТранспорта = "Перечисление.СпособыВыгрузкиФайлов.WebСервис" Тогда 
		НужнаяСтаница = Элементы.ВыгрузкаЧерезWebСервис;
	
	Иначе
		НужнаяСтаница = Элементы.ВыгрузкаВКаталог;

	КонецЕсли;	
	
	НужнаяСтаница.Видимость = Истина;
	Элементы.СтраницыПараметровВыгрузки.ТекущаяСтраница = НужнаяСтаница;
	
	Для Каждого СтраницаПараметровВыгрузки Из Элементы.СтраницыПараметровВыгрузки.ПодчиненныеЭлементы Цикл 
		Если СтраницаПараметровВыгрузки = НужнаяСтаница Тогда 
			Продолжить;
		КонецЕсли;	
		СтраницаПараметровВыгрузки.Видимость = Ложь;
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура УправлениеВидимостьюСтраницыЭЦП()
	
	Элементы.ГруппаСтраницаЭЦП.Видимость = ВыгрузкаРегламентированнойБухгалтерскойОтчетности.ПоказыватьСтраницуЭЦП(Объект.СпособВыгрузки);
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьОписаниеФайловДляФормированияПодписейНаКлиенте(СтруктураДанных)
	Если СтруктураДанных.Отказ Тогда 
		Возврат;  
	КонецЕсли;	
	
	ЗаполнитьОписаниеФайловДляФормированияПодписейНаСервере(СтруктураДанных);
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьОписаниеФайловДляФормированияПодписейНаСервере(СтруктураДанных)
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	ЗаписатьТеряемыеДанныеВОбъект(ТекущийОбъект);
	
	ТекущийОбъект.ЗаполнитьОписаниеФайловДляФормированияПодписей(СтруктураДанных);
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаписатьНовыеПодписиВОбъектНаКлиенте(Результат ,СтруктураДанных) Экспорт 
	Если СтруктураДанных.Отказ Тогда 
		Возврат;  
	КонецЕсли;
	
	ЗаписатьНовыеПодписиВОбъектНаСервере(СтруктураДанных);	
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНовыеПодписиВОбъектНаСервере(СтруктураДанных)
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	ЗаписатьТеряемыеДанныеВОбъект(ТекущийОбъект);

	
	ТекущийОбъект.ДобавитьНовыеПодписи(СтруктураДанных);
	
	ОбновитьТеряемыеДанные(ТекущийОбъект,"ФайлыОтчетов");
	ЗначениеВДанныеФормы(ТекущийОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьЭЦПНаСервере(НомерСтроки)
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	ЗаписатьТеряемыеДанныеВОбъект(ТекущийОбъект);
	
	СтрокаДляУдаления = ТекущийОбъект.ЭлектронныеЦифровыеПодписи.Найти(НомерСтроки,"НомерСтроки");
	
	МассивСтрокДляУдаления = Новый Массив;
	МассивСтрокДляУдаления.Добавить(СтрокаДляУдаления);
	
	ТекущийОбъект.УдалитьСтрокиЭЦП(МассивСтрокДляУдаления);
	
	
	ОбновитьТеряемыеДанные(ТекущийОбъект,"ФайлыОтчетов");
	ЗначениеВДанныеФормы(ТекущийОбъект, Объект);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивомНаСервере(Знач Параметры) Экспорт
	ОбменСАрхивом.ВыполнитьПодключаемуюКоманду(ЭтотОбъект, Параметры);
