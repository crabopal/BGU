
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Ссылка",ПолучитьПакетыПоОтчету(ПараметрКоманды));
	ПараметрыФормы = Новый Структура("Отбор",СтруктураОтбора);
	ОткрытьФорму("Документ.ПакетВыгрузкиОтчетности.ФормаСписка", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно);
КонецПроцедуры

&НаСервере
Функция ПолучитьПакетыПоОтчету(Отчет)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Отчет",Отчет);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПакетВыгрузкиОтчетностиОтчетыПакета.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности.ОтчетыПакета КАК ПакетВыгрузкиОтчетностиОтчетыПакета
	|ГДЕ
	|	ПакетВыгрузкиОтчетностиОтчетыПакета.ОтчетСсылка = &Отчет";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка")
КонецФункции	
