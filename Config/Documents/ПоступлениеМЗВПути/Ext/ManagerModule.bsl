// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Параметры заполнения КЭК в табличных частях документа:
//  - Имена табличных частей, содержащих КЭК.
//  - сторона проводки - Дт или Кт.
// 
// Возвращаемое значение:
//  Структура:
//   * ДтКт - Строка - "Дт" или "Кт"
//   * ИменаТабличныхЧастей - Массив из Строка - Имена табличных частей содержащих КЭК
Функция ПараметрыЗаполненияКЭК() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ДтКт", "Дт");
	ИменаТабличныхЧастей = Новый Массив;
	ИменаТабличныхЧастей.Добавить("Материалы");
	ИменаТабличныхЧастей.Добавить("ВозвратнаяТара");
	Результат.Вставить("ИменаТабличныхЧастей", ИменаТабличныхЧастей);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Заполняет указанный документ по договору, по которому указан предмет договора.
// 
// Параметры:
// 	Документ - ДокументОбъект.ПоступлениеМЗВПути - заполняемый документ.
// 			- ДанныеФормыСтруктураСКоллекцией - реквизит формы документа "Объект"
// 	ДоговорОснование - СправочникСсылка.Договоры - договор
// 	ЗаполнитьШапку - Булево - Признак необходимости заполнения шапки документа.
Процедура ЗаполнитьПоДоговору(Документ, ДоговорОснование, ЗаполнитьШапку = Ложь) Экспорт
	
	ТипыНоменклатуры = УправлениеМатериальнымиЗапасами.ТипыНоменклатурыМатериальныеЗапасы();
	
	ПараметрыЗаполнения = РаботаСОбязательствами.ПараметрыПолученияОстатковНФАПоДоговору(Документ);
	ПараметрыЗаполнения.ПолучитьДанныеДоговора = ЗаполнитьШапку;
	ПараметрыЗаполнения.ДоговорОснование       = ДоговорОснование;
	ПараметрыЗаполнения.ТипыНоменклатуры       = ТипыНоменклатуры;
	
	ОстаткиНФАПоДоговору = РаботаСОбязательствами.ОстатокМЗУслугПоДоговору(ПараметрыЗаполнения);
	
	Если ОстаткиНФАПоДоговору = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗаполнитьШапку Тогда
		
		ЗаполнитьЗначенияСвойств(Документ, ОстаткиНФАПоДоговору.ДанныеДоговора);
		
		Документ.Договор            = ДоговорОснование;
		Документ.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
		Документ.СуммаВключаетНДС   = ИСТИНА;
		
	КонецЕсли;
	
	КЭК340 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("340");
	ПараметрыОбработкиСтроки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Документ);
	ПараметрыОбработкиСтроки.ДтКт          = "Дт";
	ПараметрыОбработкиСтроки.ЗаполнятьСчет = Ложь;

	ПараметрыРасчетаНДС = Новый Структура;
	ПараметрыРасчетаНДС.Вставить("СуммаВключаетНДС", Документ.СуммаВключаетНДС);
	
	Для Каждого ОстатокТМЦ Из ОстаткиНФАПоДоговору.ОстаткиНФА Цикл
		
		НоваяСтрока = Документ.Материалы.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстатокТМЦ);
		НоваяСтрока.СчетУчета = УправлениеМатериальнымиЗапасамиПовтИсп.СчетВПутиПоСчетуУчетаМЗ(ОстатокТМЦ.СчетУчетаКод);
		Если Не ЗначениеЗаполнено(НоваяСтрока.КЭК) ИЛИ НоваяСтрока.КЭК = КЭК340 Тогда
			ПараметрыОбработкиСтроки.Счет          = НоваяСтрока.СчетУчета;
			ПараметрыОбработкиСтроки.Номенклатура  = НоваяСтрока.Номенклатура;
			УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(НоваяСтрока,
				ПараметрыОбработкиСтроки);
		КонецЕсли;
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(НоваяСтрока, "Сумма", ПараметрыРасчетаНДС);
		
	КонецЦикла;
	
	Документ.ВсегоПоДокументу = Документ.Материалы.Итог("Всего") + Документ.ВозвратнаяТара.Итог("Сумма");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента", "Приходный ордер / Требование-накладная");
	Запрос.УстановитьПараметр("НомерДокумента", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка.Ссылка,ДокументСсылка.Номер));
	
	НомераТаблиц = Новый Структура;
	
	ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц);

	Результат = Запрос.ВыполнитьПакет();                                     
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("ОтражениеЭДВУчете", НомераТаблиц.Количество());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтражениеЭДВУчете.Ссылка КАК Регистратор,
	|	ОтражениеЭДВУчете.Дата КАК Период,
	|	ОтражениеЭДВУчете.Организация КАК Организация,
	|	ОтражениеЭДВУчете.ДокументОснование КАК ДокументЭД,
	|	ОтражениеЭДВУчете.Ссылка КАК ДокументОтраженияВУчете,
	|	ОтражениеЭДВУчете.ВсегоПоДокументу КАК Сумма
	|ИЗ
	|	Документ.ПоступлениеМЗВПути КАК ОтражениеЭДВУчете
	|ГДЕ
	|	ОтражениеЭДВУчете.Ссылка = &Ссылка
	|	И ОтражениеЭДВУчете.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	|	И(НЕ ОтражениеЭДВУчете.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка))";
	
КонецПроцедуры

