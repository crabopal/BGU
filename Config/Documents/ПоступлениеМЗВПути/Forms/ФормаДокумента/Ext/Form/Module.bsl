	ПараметрыНоменклатуры = ПараметрыЗаполненияДанныхНоменклатуры(Объект, Строка);
	Строка.КЭК = ПолучитьКЭКНоменклатуры(ПараметрыНоменклатуры, Строка.СчетУчета, Строка.ТипНоменклатуры);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеНоменклатурыВСтроке(Строка, Объект, ЗаполнятьСчет)

	ПараметрыНоменклатуры = ПараметрыЗаполненияДанныхНоменклатуры(Объект, Строка);
	ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(ПараметрыНоменклатуры);
	
	Если ЗаполнятьСчет Тогда
		ЗаполнитьЗначенияСвойств(Строка, ДанныеНоменклатуры);
	Иначе
		ЗаполнитьЗначенияСвойств(Строка, ДанныеНоменклатуры,,"СчетУчета");
	КонецЕсли;
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьТипНоменклатурыВСтрокеДляБиологическихАктивов(Строка, ДанныеНоменклатуры.ТипНоменклатуры);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыЗаполненияДанныхНоменклатуры(Объект, Строка)
	ПараметрыНоменклатуры = Новый Структура("Номенклатура, Организация, ИФО, КФО, Дата");
	ПараметрыНоменклатуры.Организация  = Объект.Организация;
	ПараметрыНоменклатуры.ИФО          = Объект.ИФО;
	ПараметрыНоменклатуры.КФО          = Строка.КФО;
	ПараметрыНоменклатуры.Дата         = Объект.Дата;
	ПараметрыНоменклатуры.Номенклатура = Строка.Номенклатура;
	Возврат ПараметрыНоменклатуры;
КонецФункции

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение,ИмяТЧ);
	
	СписокПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	
	КоличествоСтрок = Объект.Материалы.Количество();
	Если КоличествоСтрок > 1 Тогда
		ПредыдущаяСтрока = Объект.Материалы[КоличествоСтрок-1];
		ТекСтавкаНДС = ПредыдущаяСтрока.СтавкаНДС;
	Иначе
		ТекСтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	КонецЕсли;

	Для Каждого ЭлементПодбора Из СписокПодбора Цикл
		Если ИмяТЧ = "Материалы" Тогда
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементПодбора);
			НоваяСтрока.Коэффициент = 1;
			НоваяСтрока.КоличествоМест = 1;
			НоваяСтрока.СтавкаНДС = ТекСтавкаНДС;
			УправлениеНФАКлиентСервер.УстановитьСпособУчетаНДСПоУмолчаниюВСтроке(Объект, НоваяСтрока);
			
			РасчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "Сумма");

		Иначе
			НоваяСтрока = Объект.ВозвратнаяТара.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементПодбора);
		КонецЕсли;
		ЗаполнитьДанныеНоменклатурыВСтроке(НоваяСтрока, Объект, НЕ ЗначениеЗаполнено(НоваяСтрока.СчетУчета));
		
	КонецЦикла;
	
	РассчитатьСуммуДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекстПроСчетФактуруКлиент(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения)
	
	Перем ЗначениеСвойства;
	
	ЭтотДокументЯвляетсяОснованием = (ТипЗнч(ПараметрОбработкиОповещения) = Тип("Структура")
		И ПараметрОбработкиОповещения.Свойство("ДокументыОснования", ЗначениеСвойства)
		И ЗначениеСвойства.Найти(Объект.Ссылка) <> Неопределено);
	
	Если ЭтотДокументЯвляетсяОснованием Тогда
		ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстПроСчетФактуруСервер(ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено)
	
	УчетНДС.ЗаполнитьТекстПроСчетФактуру(ЭтотОбъект, ПараметрОбработкиОповещения, ИсточникОбработкиОповещения);
	
КонецПроцедуры
 
&НаСервере
Процедура ЗаполнитьАвансыНаСервере()
	
	Отказ = Ложь;
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ПоВсемКФО", Истина);
	
	Если Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		ПараметрыЗаполнения.Вставить("ПериодОстатков",
			Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая) );
	Иначе
		ПараметрыЗаполнения.Вставить("ПериодОстатков",
			Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая) );
	КонецЕсли;
	
	ДокументОбъект.ЗаполнитьПоОстаткамАвансов(ПараметрыЗаполнения, Отказ);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	Если НЕ Отказ Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОтменитьПроведениеПередЗаполнениемДО(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДОНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДОНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	Если Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		ПериодОстатков = Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	ТаблицаОбязательств = УчетРасчетов.ДенежныеОбязательстваПоПоступлениюТРУ(ДокументОбъект, ПериодОстатков);
	
	Объект.ДенежныеОбязательства.Загрузить(ТаблицаОбязательств);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыВыбораСчетаУчета()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Счет107", БухгалтерскийУчет.СписокСчетов("107.00"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&Счет107)
	|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	|	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)";
	
	МассивСчетов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(Новый ПараметрВыбора("ОграниченияСписокСчетов", Новый ФиксированныйМассив(МассивСчетов)));
	МассивПараметров.Добавить(Новый ПараметрВыбора("ВидСравненияВСписке", Истина));
	Элементы.МатериалыСчетУчета.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	Элементы.ВозвратнаяТараСчетУчета.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);

КонецПроцедуры // ЗаполнитьПараметрыВыбораСчетаУчета()

&НаСервере
Процедура ПересчитатьТабличнуюЧасть()
	Для Каждого СтрокаТЧ из Объект.Материалы Цикл
		РасчитатьСтроку(СтрокаТЧ, Объект.СуммаВключаетНДС, "Сумма");
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СуммаВключаетНДСПриИзмененииНаСервере()
	
	ПересчитатьТабличнуюЧасть();
	РассчитатьСуммуДокумента();

КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуДокумента()
	
	Объект.ВсегоПоДокументу = Объект.Материалы.Итог("Всего") + Объект.ВозвратнаяТара.Итог("Сумма");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РасчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)

	Объект = Форма.Объект;
	ПараметрыПредставления = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта_Параметры();
	ПараметрыПредставления.ВалютаДокумента = Объект.ВалютаДокумента;
	ПараметрыПредставления.ПринятьНДСКВычету = Объект.ПринятьНДСКВычету;
	ПараметрыПредставления.СуммаВключаетНДС = Объект.СуммаВключаетНДС;
	ПараметрыПредставления.ПринятьНДСКВычетуУказываетсяВСтроках = Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
	ПараметрыПредставления.ПоказыватьНДС = Истина;
	ПараметрыПредставления.УчитыватьНДС = ПараметрыПредставления.ПоказыватьНДС;
	ПараметрыПредставления.ПоказыватьВалюту = Форма.КэшПараметров.ИспользоватьВалютныйУчет;
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;

	ПринятьНДСКВычетуУказываетсяВСтроках = Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
	ПринятьНДСКВычетуУказываетсяВШапке = Не Объект.ПринятьНДСКВычетуУказываетсяВСтроках;

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "МатериалыСпособУчетаНДС",
		"Видимость", ПринятьНДСКВычетуУказываетсяВСтроках);
	ЭлементыНДСКРаспределению = Новый Массив;
	ЭлементыНДСКРаспределению.Добавить("МатериалыНДСКРаспределению");
	ЭлементыНДСКРаспределению.Добавить("МатериалыТекстНДСКРаспределению");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыНДСКРаспределению,
		"Видимость", ПринятьНДСКВычетуУказываетсяВШапке);
	
	Элементы.ФормаПринятьНДСКВычетуУказываетсяВСтроках.Пометка = Объект.ПринятьНДСКВычетуУказываетсяВСтроках;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДО(Форма, ВидимостьЭлементовЭДО, ВидимостьЭлементовЭДОДляЭДПоставщика)
	
	Если ВидимостьЭлементовЭДОДляЭДПоставщика Тогда
		ВидимостьЭлементовЭДО = Истина;
		Форма.Элементы.ДекорацияСостояниеЭДО.Заголовок = НСтр("ru='Отражение ЭД в учете'");
	Конецесли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияСостояниеЭДО", "Видимость", ВидимостьЭлементовЭДО);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьЭлементовЭДОДляДокумента(Объект)
	Результат = Ложь;
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

