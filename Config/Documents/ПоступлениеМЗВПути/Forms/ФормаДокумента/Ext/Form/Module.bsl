		ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
		ТекущиеДанные.Коэффициент = 1;
		ТекущиеДанные.КоличествоМест = 1;
		КоличествоСтрок = Объект.Материалы.Количество();
		Если КоличествоСтрок > 1 Тогда
			ПредыдущаяСтрока = Объект.Материалы[КоличествоСтрок-2];
			ТекущиеДанные.СтавкаНДС = ПредыдущаяСтрока.СтавкаНДС;
			ТекущиеДанные.КПС       = ПредыдущаяСтрока.КПС;
			ТекущиеДанные.КФО       = ПредыдущаяСтрока.КФО;
		Иначе
			ТекущиеДанные.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
		КонецЕсли;
		УправлениеНФАКлиентСервер.УстановитьСпособУчетаНДСПоУмолчаниюВСтроке(Объект, Элементы.Материалы.ТекущиеДанные);
