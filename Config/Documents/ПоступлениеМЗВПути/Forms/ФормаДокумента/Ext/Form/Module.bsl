&НаСервере
Процедура ЗаполнитьПоДокументуОснованию(ДокументОснование)
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда 
		Если (Объект.Материалы.Количество() > 0) Тогда
			Возврат;
		КонецЕсли;	
		
		ДокументОбъект = РеквизитФормыВЗначение("Объект");
		ДокументОбъект.ЗаполнитьПоЭлектронномуДокументуПоставщика(ДокументОснование);
		ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	КонецЕсли;
КонецПроцедуры // ЗаполнитьПоДокументуОснованию()

