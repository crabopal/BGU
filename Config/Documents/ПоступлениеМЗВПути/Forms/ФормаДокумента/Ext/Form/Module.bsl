&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатуры(Знач Параметры)
	
	ДанныеНоменклатуры = Новый Структура("ЕдиницаИзмерения, СчетУчета, КЭК, ТипНоменклатуры");
	
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.Номенклатура, "ЕдиницаИзмерения, СчетУчета, ТипНоменклатуры");
	ДанныеНоменклатуры.ЕдиницаИзмерения = СтруктураДанных.ЕдиницаИзмерения;
	ДанныеНоменклатуры.СчетУчета = УправлениеМатериальнымиЗапасамиПовтИсп.СчетВПутиПоСчетуУчетаМЗ(СтруктураДанных.СчетУчета);
	ДанныеНоменклатуры.ТипНоменклатуры = СтруктураДанных.ТипНоменклатуры;
	
	ДанныеНоменклатуры.КЭК = ПолучитьКЭКНоменклатуры(Параметры, ДанныеНоменклатуры.СчетУчета, СтруктураДанных.ТипНоменклатуры);
	
	Возврат ДанныеНоменклатуры;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКЭКНоменклатуры(Знач Параметры, Знач СчетУчета, Знач ТипНоменклатуры)
	Возврат БухгалтерскийУчет.КЭКНоменклатуры(Параметры.Организация, Параметры.ИФО, Параметры.КФО,
		Параметры.Дата, СчетУчета, ТипНоменклатуры, "Дт");
КонецФункции

&НаКлиенте
